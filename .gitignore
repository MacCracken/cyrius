# Build artifacts
/build/*
# Committed binaries per the v6.0.x transition policy:
# - cc3 stays as the v5.0.0-era prior-prior seed anchor (retired
#   for fresh bootstraps but kept in tree as historical reference;
#   drops at the v7.0.0 cycle-open per CLAUDE.md "Project Structure").
# - cycc (Cyrius Computer Compiler) — current-major, v6.0.0 rename
#   of cc5. Tracked so CI / install bootstrap have a starting point.
# - cycc-native-aarch64 — the cycc binary built natively on aarch64,
#   kept for ARM hardware self-host.
!/build/cc3
!/build/cycc
!/build/cycc-native-aarch64
# Ad-hoc cross-compiled outputs at repo root (regenerated on demand;
# see src/main_aarch64_macho.cyr header and scripts/mac-selfhost.sh).
/cycc_macho
/cycc_macho_b
/cycc_macho_b_unsigned
/cycc_macho_c

# Temporary files
/tmp/

# Core dumps
*.core

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/

# Environment / secrets
.env
.env.*
*.pem
*.key

# Coverage / profiling
/coverage/
*.profraw
*.profdata
