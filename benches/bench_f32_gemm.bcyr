# bench_f32_gemm.bcyr — dense f32 GEMM, the SIMD Phase 2 (v6.4.5) acceptance
# bench. Computes C[MxN] = A[MxK] · B[KxN] with B pre-transposed to Bt[NxK] so
# both operands of every dot are contiguous, then C[i][j] = f32v_dot(A_row_i,
# Bt_row_j, K) — the horizontal-dot matmul formulation. Compares the packed-
# single SIMD path against a scalar f32 baseline (which routes each multiply-add
# through f64, since f32 scalar arithmetic has no native ops). x86-only (aarch64
# f32v_dot is a Phase-5 stub). K is a multiple of 4 (the f32v_dot lane stride).

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/simd.cyr"

var M = 48; var K = 48; var N = 48;
var _A = 0; var _Bt = 0; var _C = 0;

# SIMD GEMM: one f32v_dot per output cell (mulps+addps accumulate, haddps reduce).
fn work_gemm_simd() {
    var i = 0;
    while (i < M) {
        var j = 0;
        while (j < N) {
            store32(_C + (i * N + j) * 4, f32v_dot(_A + i * K * 4, _Bt + j * K * 4, K));
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Scalar baseline: the same GEMM, one f32 multiply-add at a time via f64.
fn work_gemm_scalar() {
    var i = 0;
    while (i < M) {
        var j = 0;
        while (j < N) {
            var acc = 0;   # f32 bits of 0.0
            var k = 0;
            while (k < K) {
                var av = load32(_A + (i * K + k) * 4);
                var bv = load32(_Bt + (j * K + k) * 4);
                var prod = f64_mul(f32_to(av), f32_to(bv));
                acc = f32_from(f64_add(f32_to(acc), prod));
                k = k + 1;
            }
            store32(_C + (i * N + j) * 4, acc);
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    _A  = alloc(M * K * 4);
    _Bt = alloc(N * K * 4);
    _C  = alloc(M * N * 4);
    # Fill A and Bt with 1.0f so every C[i][j] == K (48.0f = 0x42400000).
    var p = 0;
    while (p < M * K) { store32(_A + p * 4, 0x3F800000); p = p + 1; }
    p = 0;
    while (p < N * K) { store32(_Bt + p * 4, 0x3F800000); p = p + 1; }

    # Correctness self-check (exit non-zero if the GEMM is wrong — makes the
    # bench double as an array-scale regression guard in bench-history runs).
    work_gemm_simd();
    if (load32(_C) != 0x42400000) { syscall(60, 7); }
    work_gemm_scalar();
    if (load32(_C) != 0x42400000) { syscall(60, 8); }

    var all = vec_new();
    var b1 = bench_new("simd/f32_gemm_48_simd");
    bench_run(b1, &work_gemm_simd, 200);
    vec_push(all, b1);
    var b2 = bench_new("simd/f32_gemm_48_scalar");
    bench_run(b2, &work_gemm_scalar, 200);
    vec_push(all, b2);
    bench_report_all(all);
    return 0;
}
var exit_code = main();
syscall(60, exit_code);
