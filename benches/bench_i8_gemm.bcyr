# bench_i8_gemm.bcyr — dense int8 GEMM, the SIMD Phase 3b (v6.4.7) b1.58 acceptance
# bench. C[MxN] (i32) = A[MxK] (u8 activations) · B[KxN] (i8 weights), with B pre-
# transposed to Bt[NxK] so each cell is C[i][j] = iv_dp8(A_row_i, Bt_row_j, K) — the
# widening int8 dot (pmaddubsw → pmaddwd → paddd accumulate → i32). This is the
# BitNet/b1.58 quantized-matmul inner loop; ternary weights {-1,0,1} are just i8. The
# SIMD path is compared to a scalar int8 baseline. x86-only (aarch64 sdot → Phase 5).
# K is a multiple of 16 (the iv_dp8 lane stride).

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/simd.cyr"

var M = 64; var K = 64; var N = 64;
var _A = 0; var _Bt = 0; var _C = 0;

# SIMD GEMM: one iv_dp8 (int8 widening dot) per output cell.
fn work_gemm_simd() {
    var i = 0;
    while (i < M) {
        var j = 0;
        while (j < N) {
            store32(_C + (i * N + j) * 4, iv_dp8(_A + i * K, _Bt + j * K, K));
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Scalar baseline: the same GEMM, one u8×i8 multiply-add at a time.
fn work_gemm_scalar() {
    var i = 0;
    while (i < M) {
        var j = 0;
        while (j < N) {
            var acc = 0;
            var k = 0;
            while (k < K) {
                var av = load8(_A + i * K + k);       # u8 (0..255)
                var bv = load8(_Bt + j * K + k);       # i8 — load8 zero-extends; sign it
                if (bv >= 128) { bv = bv - 256; }
                acc = acc + av * bv;
                k = k + 1;
            }
            store32(_C + (i * N + j) * 4, acc);
            j = j + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();
    _A  = alloc(M * K);
    _Bt = alloc(N * K);
    _C  = alloc(M * N * 4);
    # Fill A (u8) and Bt (i8) with 1 so every C[i][j] == K (64).
    var p = 0;
    while (p < M * K) { store8(_A + p, 1); p = p + 1; }
    p = 0;
    while (p < N * K) { store8(_Bt + p, 1); p = p + 1; }

    # Correctness self-check (exit non-zero if the GEMM is wrong).
    work_gemm_simd();
    if (load32(_C) != 64) { syscall(60, 7); }
    work_gemm_scalar();
    if (load32(_C) != 64) { syscall(60, 8); }

    var all = vec_new();
    var b1 = bench_new("simd/i8_gemm_64_simd");
    bench_run(b1, &work_gemm_simd, 200);
    vec_push(all, b1);
    var b2 = bench_new("simd/i8_gemm_64_scalar");
    bench_run(b2, &work_gemm_scalar, 200);
    vec_push(all, b2);
    bench_report_all(all);
    return 0;
}
var exit_code = main();
syscall(60, exit_code);
