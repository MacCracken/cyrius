# ================================================================
# cybs — Cyrius Bootstrap Compiler
# ================================================================
#
# The bootstrap compiler. Reads Cyrius source from stdin, emits an
# x86_64 ELF binary to stdout. Written in assembly, assembled by the
# 29KB seed binary (bootstrap/asm). First real compiler in the chain:
# seed → cybs → bridge → cc3.
#
# Language: fn/return, var, arrays, assignment, if/else, while,
#           arithmetic, bitwise ops, comparisons, syscall(),
#           load8(), store8(), &var, strings, # comments.
#
# History: stage1a → 1b → 1c → 1d → 1e → 1f → cybs (renamed v3.9.5)
#
# Usage: echo 'var x = 0xFF & 42;' | ./cybs > prog && chmod +x prog && ./prog
#
# Register conventions (compiler registers):
#   r15 = heap base (from brk, never clobbered)
#   r12 = input length
#   r11 = parser cursor (token index)
#   r10 = token count
#   r13 = code_pos (current position in codebuf)
#   r14 = variable count
#
# Generated code register conventions:
#   rax = expression accumulator
#   rcx = second operand / address register
#   rdx = clobbered by mul/div/mod
#   rdi, rsi, rdx, r10, r8, r9 = syscall arguments
#   stack = intermediate values in nested expressions
#
# Memory layout (offsets from r15):
#   0x00000  input_buf        [65536 bytes, 64KB]
#   0x10000  tok_types        [131072 bytes, 16384 slots * 8]
#   0x30000  tok_values       [131072 bytes, 16384 slots * 8]
#   0x50000  tok_names        [32768 bytes, packed strings]
#   0x58000  var_noffs        [2048 bytes, 256 slots * 8]
#   0x58800  var_sizes        [2048 bytes, 256 slots * 8]
#   0x59000  codebuf          [65536 bytes, 64KB]
#   0x69000  string_data      [4096 bytes]
#   0x6A000  string_pos       [8 bytes]
#   0x6A008  data_size        [8 bytes]
#   0x70000  output_buf       [131072 bytes, 128KB]
#   0x90000  fixup_table      [8192 bytes, 512 entries * 16]
#   0x92000  fixup_count      [8 bytes]
#   0x92008  last_var_idx     [8 bytes]
#   0x92010  fn_names         [1024 bytes, 128 slots * 8]
#   0x92810  fn_offsets       [1024 bytes, 128 slots * 8]
#   0x93010  fn_params        [1024 bytes, 128 slots * 8]
#   0x93810  fn_count         [8 bytes]
#   0x93818  in_function      [8 bytes]
#   0x93820  fn_local_count   [8 bytes]
#   0x93828  saved_var_count  [8 bytes]
#   0x93830  return_patches   [512 bytes, 64 slots * 8]
#   0x93A30  return_patch_count [8 bytes]
#   0x93A38  main_jmp_patch   [8 bytes]
#   0x93A40  fn_local_names   [512 bytes, 64 slots * 8]
#   0x93C40  fn_local_sizes   [512 bytes, 64 slots * 8]
#   0x93E40  scratch          [256 bytes]
#
# Token types:
#   1=NUM  2=IDENT  3=VAR  4=EQ  5=SEMI
#   6=PLUS 7=MINUS  8=STAR 9=SLASH
#   10=LPAREN 11=RPAREN 12=EOF
#   13=LBRACE 14=RBRACE 15=IF 16=WHILE
#   17=EQEQ 18=NEQ 19=LT 20=GT 21=LTE 22=GTE 23=ELSE
#   24=SYSCALL 25=LOAD8 26=STORE8 27=AMPERSAND
#   28=LBRACKET 29=RBRACKET 30=STRING 31=COMMA
#   32=FN 33=RETURN
#   34=PERCENT 35=PIPE 36=CARET 37=TILDE 38=SHL 39=SHR

# ================================================================
# ENTRY POINT
# ================================================================

_start:
    call sys_init
    call read_input
    call lexer
    call parser
    call fixup_vars
    call emit_elf
    call write_output
    call sys_exit_ok

# ================================================================
# SYSCALL WRAPPERS
# ================================================================

sys_init:
    # brk(0) — get current break
    mov rax, 12
    xor rdi, rdi
    syscall
    mov r15, rax
    # brk(r15 + 0xA1000) — extend by 448KB
    mov rdi, r15
    add rdi, 0xA1000
    mov rax, 12
    syscall
    xor r14, r14
    xor r13, r13         # code_pos = 0
    # zero fixup_count
    mov rsi, r15
    add rsi, 0x92000
    xor rax, rax
    mov [rsi], rax
    # zero string_pos
    mov rsi, r15
    add rsi, 0x6A000
    mov [rsi], rax
    # zero fn_count
    mov rsi, r15
    add rsi, 0x93810
    mov [rsi], rax
    # zero in_function
    add rsi, 8
    mov [rsi], rax
    # zero fn_local_count
    add rsi, 8
    mov [rsi], rax
    # zero return_patch_count
    mov rsi, r15
    add rsi, 0x93A30
    mov [rsi], rax
    ret

read_input:
    xor r12, r12          # r12 = total bytes read
read_input_loop:
    mov rax, 0
    xor rdi, rdi
    mov rsi, r15
    add rsi, r12          # offset into input_buf
    mov rdx, 0x10000      # 64KB max
    sub rdx, r12          # remaining space
    cmp rdx, 0
    jle read_input_done
    syscall
    cmp rax, 0
    jle read_input_done   # EOF or error
    add r12, rax
    jmp read_input_loop
read_input_done:
    ret

write_output:
    # r13 = output size (set by emit_elf)
    mov rax, 1
    mov rdi, 1
    mov rsi, r15
    add rsi, 0x70000
    mov rdx, r13
    syscall
    ret

sys_exit_ok:
    mov rax, 60
    xor rdi, rdi
    syscall

sys_exit_err:
    mov rax, 60
    mov rdi, 1
    syscall

# ================================================================
# CODE EMISSION HELPERS
# ================================================================
# These write bytes to codebuf at r15+0x59000+r13, advance r13.

# emit_2bytes: write 2-byte value in rax to codebuf
emit_2bytes:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret

# emit_8bytes: write 8-byte value in rax to codebuf
emit_8bytes:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov [rsi], rax
    add r13, 8
    pop rsi
    ret

# emit_mov_rax_imm64: emit "mov rax, <value>" where value is in rax
# 48 B8 <imm64> = 10 bytes
emit_mov_rax_imm64:
    push rbx
    mov rbx, rax         # save value
    mov rax, 0xB848       # 48 B8
    call emit_2bytes
    mov rax, rbx
    call emit_8bytes
    pop rbx
    ret

# emit_mov_rcx_imm64: emit "mov rcx, <value>" where value is in rax
# 48 B9 <imm64> = 10 bytes
emit_mov_rcx_imm64:
    push rbx
    mov rbx, rax
    mov rax, 0xB948       # 48 B9
    call emit_2bytes
    mov rax, rbx
    call emit_8bytes
    pop rbx
    ret

# emit_push_rax: emit "push rax" = 50
emit_push_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x50
    mov [rsi], rax
    inc r13
    pop rsi
    ret

# emit_pop_rcx: emit "pop rcx" = 59
emit_pop_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x59
    mov [rsi], rax
    inc r13
    pop rsi
    ret

# emit_mov_rcx_rax: emit "mov rcx, rax" = 48 89 C1
emit_mov_rcx_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xC18948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_pop_rax: emit "pop rax" = 58
emit_pop_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x58
    mov [rsi], rax
    inc r13
    pop rsi
    ret

# emit_add_rax_rcx: emit "add rax, rcx" = 48 01 C8
emit_add_rax_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xC80148
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_sub_rax_rcx: emit "sub rax, rcx" = 48 29 C8
emit_sub_rax_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xC82948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_imul_rcx: emit "imul rcx" = 48 F7 E9
emit_imul_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE9F748
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_cqo: emit "cqo" = 48 99 (sign-extend RAX into RDX:RAX)
emit_cqo:
    mov rax, 0x9948
    call emit_2bytes
    ret

# emit_idiv_rcx: emit "idiv rcx" = 48 F7 F9
emit_idiv_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xF9F748
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_mov_rax_mem_rcx: emit "mov rax, [rcx]" = 48 8B 01
emit_mov_rax_mem_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x018B48
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_mov_mem_rcx_rax: emit "mov [rcx], rax" = 48 89 01
emit_mov_mem_rcx_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x018948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_cmp_rax_rcx: emit "cmp rax, rcx" = 48 39 C8
emit_cmp_rax_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xC83948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_mov_rdi_rax: emit "mov rdi, rax" = 48 89 C7
emit_mov_rdi_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xC78948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_syscall: emit "syscall" = 0F 05
emit_syscall:
    mov rax, 0x050F
    call emit_2bytes
    ret

# emit_jcc: emit conditional jump with placeholder rel32.
# rax = condition byte (0x84=je, 0x85=jne, 0x8C=jl, 0x8F=jg, 0x8E=jle, 0x8D=jge)
# Returns patch offset (where the rel32 starts) in rax.
emit_jcc:
    push rbx
    push rsi
    mov rbx, rax         # save condition byte
    # emit 0F
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x0F
    mov [rsi], rax
    inc r13
    # emit condition byte
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov [rsi], rbx
    inc r13
    # save patch offset (where rel32 goes)
    mov rbx, r13
    # emit placeholder rel32 = 0
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    # return patch offset
    mov rax, rbx
    pop rsi
    pop rbx
    ret

# emit_jmp: emit unconditional jmp with rel32.
# rax = target code_pos
# Computes rel32 = target - (current + 5)
emit_jmp_to:
    push rbx
    push rsi
    mov rbx, rax         # target
    # emit E9
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    # compute rel32 = target - (r13 + 4)
    mov rax, rbx
    mov rcx, r13
    add rcx, 4
    sub rax, rcx          # rax = target - (r13+4)
    and rax, 0xFFFFFFFF   # mask to 4 bytes
    # read-modify-write rel32
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rcx, [rsi]        # existing qword
    shr rcx, 32
    shl rcx, 32
    or rax, rcx
    mov [rsi], rax
    add r13, 4
    pop rsi
    pop rbx
    ret

# patch_rel32: patch a previously emitted jcc at codebuf offset.
# rax = codebuf offset where rel32 starts
# Patches rel32 = r13 - (offset + 4)
patch_rel32:
    push rbx
    push rsi
    push rcx
    mov rbx, rax         # offset
    mov rax, r13
    sub rax, rbx
    sub rax, 4            # rel32 = code_pos - (offset + 4)
    # Read-modify-write: load existing qword, replace low 4 bytes, write back
    mov rsi, r15
    add rsi, 0x59000
    add rsi, rbx
    mov rcx, [rsi]       # existing qword
    # clear low 4 bytes of rcx
    shr rcx, 32
    shl rcx, 32
    # mask rel32 to 4 bytes
    and rax, 0xFFFFFFFF
    or rax, rcx           # combine
    mov [rsi], rax
    pop rcx
    pop rsi
    pop rbx
    ret

# emit_var_load: emit "mov rcx, <placeholder>; mov rax, [rcx]"
# rax = variable index. Records fixup.
emit_var_load:
    push rbx
    mov rbx, rax         # var index
    # emit mov rcx, <placeholder> — record fixup at r13+2
    mov rax, 0xB948       # 48 B9
    call emit_2bytes
    # record fixup: (codebuf_offset=r13, var_index=rbx)
    call record_fixup_rbx
    # emit placeholder imm64
    xor rax, rax
    call emit_8bytes
    # emit mov rax, [rcx] = 48 8B 01
    call emit_mov_rax_mem_rcx
    pop rbx
    ret

# emit_var_store: emit "mov rcx, <placeholder>; mov [rcx], rax"
# rax = variable index. Records fixup.
emit_var_store:
    push rbx
    mov rbx, rax
    mov rax, 0xB948       # 48 B9
    call emit_2bytes
    call record_fixup_rbx
    xor rax, rax
    call emit_8bytes
    call emit_mov_mem_rcx_rax
    pop rbx
    ret

# record_fixup_rbx: record fixup (r13, rbx) in fixup table
record_fixup_rbx:
    push rsi
    push rcx
    push rax
    # load fixup_count
    mov rsi, r15
    add rsi, 0x92000
    mov rax, [rsi]
    mov rcx, rax         # rcx = count
    # fixup_table[count*2] = r13 (codebuf offset of imm64)
    shl rax, 4           # *16 (each entry is 2 qwords)
    mov rsi, r15
    add rsi, 0x90000
    add rsi, rax
    mov [rsi], r13       # store codebuf offset
    # fixup_table[count*2 + 1] = rbx (var index)
    add rsi, 8
    mov [rsi], rbx
    # increment fixup count
    inc rcx
    mov rsi, r15
    add rsi, 0x92000
    mov [rsi], rcx
    pop rax
    pop rcx
    pop rsi
    ret

# emit_exit_epilogue: emit "mov rdi, rax; mov rax, 60; syscall"
emit_exit_epilogue:
    call emit_mov_rdi_rax
    mov rax, 60
    call emit_mov_rax_imm64
    call emit_syscall
    ret

# emit_movzx_rax_byte_rax: emit "movzx rax, byte [rax]" = 48 0F B6 00
emit_load8:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    # 48 0F B6 00 = 4 bytes
    mov rax, 0x00B60F48
    mov [rsi], rax
    add r13, 4
    pop rsi
    ret

# emit_movb_mem_rcx_al: emit "mov byte [rcx], al" = 88 01
emit_store8_op:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x0188
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret

# ── load/store 16/32/64 brick ──
emit_load64:             # mov rax, [rax] = 48 8B 00
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x008B48
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_load32:             # mov eax, [rax] = 8B 00  (zero-extends to rax)
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x008B
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_load16:             # movzx rax, word [rax] = 48 0F B7 00
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x00B70F48
    mov [rsi], rax
    add r13, 4
    pop rsi
    ret
emit_store64:            # mov [rcx], rax = 48 89 01
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x018948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_store32:            # mov [rcx], eax = 89 01
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x0189
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_store16:            # mov [rcx], ax = 66 89 01
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x018966
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_xor_rax_rax: emit "xor rax, rax" = 48 31 C0
emit_xor_rax_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xC03148
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# ================================================================
# BITWISE / SHIFT / MODULO EMISSION HELPERS
# ================================================================

