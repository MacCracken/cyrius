# emit_not_rax: emit "not rax" = 48 F7 D0
emit_not_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xD0F748
    mov [rsi], rax
    add r13, 3
