# emit_shl_rax_cl: emit "shl rax, cl" = 48 D3 E0
emit_shl_rax_cl:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE0D348
    mov [rsi], rax
    add r13, 3
    pop rsi
