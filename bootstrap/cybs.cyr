# ================================================================
# VARIABLE ADDRESS / FIXUP HELPERS
# ================================================================

# emit_var_addr: emit "mov rax, <placeholder>" with fixup for variable address.
# rax = variable index. Records type-0 fixup.
emit_var_addr:
    push rbx
    mov rbx, rax         # var index
    # emit mov rax, imm64 — record fixup at r13+2
    mov rax, 0xB848       # 48 B8
    call emit_2bytes
    # record fixup: type=0 (variable), index=rbx
    call record_fixup_rbx
    # emit placeholder imm64
    xor rax, rax
    call emit_8bytes
    pop rbx
    ret

# emit_string_addr: emit "mov rax, <placeholder>" with string fixup.
# rbx = offset into string_data. Records type-1 fixup.
emit_string_addr:
    push rbx
    # emit mov rax, imm64
    mov rax, 0xB848
    call emit_2bytes
    # record fixup with type=1: store (1 << 56) | offset in rbx
    push rax
    mov rax, 1
    shl rax, 56
    or rbx, rax           # rbx = (1 << 56) | string_offset
    pop rax
    call record_fixup_rbx
    # emit placeholder imm64
    xor rax, rax
    call emit_8bytes
    pop rbx
    ret

# emit_pop_rdi: emit "pop rdi" = 5F
emit_pop_rdi:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x5F
    mov [rsi], rax
    inc r13
    pop rsi
    ret

# emit_pop_rsi: emit "pop rsi" = 5E
emit_pop_rsi:
    push rsi
    push rbx
    mov rbx, r15
    add rbx, 0x59000
    add rbx, r13
    mov rax, 0x5E
    mov [rbx], rax
    inc r13
    pop rbx
    pop rsi
    ret

# emit_pop_rdx: emit "pop rdx" = 5A
emit_pop_rdx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x5A
    mov [rsi], rax
    inc r13
    pop rsi
    ret

# emit_pop_r10: emit "pop r10" = 41 5A
emit_pop_r10:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x5A41
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret

# emit_pop_r8: emit "pop r8" = 41 58
emit_pop_r8:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x5841
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret

# emit_pop_r9: emit "pop r9" = 41 59
emit_pop_r9:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x5941
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret

# ================================================================
# FUNCTION CODEGEN HELPERS
# ================================================================

# emit_push_rbp: emit "push rbp" = 55
emit_push_rbp:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x55
    mov [rsi], rax
    inc r13
    pop rsi
    ret

# emit_mov_rbp_rsp: emit "mov rbp, rsp" = 48 89 E5
emit_mov_rbp_rsp:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE58948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret

# emit_sub_rsp_imm32: emit "sub rsp, <imm32>" = 48 81 EC <imm32>
# rax = frame size. Returns patch offset (where imm32 starts) in rax.
emit_sub_rsp_imm32:
    push rsi
    push rbx
    mov rbx, rax         # save frame size
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xEC8148
    mov [rsi], rax
    add r13, 3
    # save patch offset
    push r13
    # write imm32
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    # read-modify-write for 4-byte value
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rbx, 0xFFFFFFFF
    or rax, rbx
    mov [rsi], rax
    add r13, 4
    pop rax               # return patch offset
    pop rbx
    pop rsi
    ret

# emit_leave_ret: emit "leave; ret" = C9 C3
emit_leave_ret:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xC3C9
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret

# emit_fn_var_load: emit "mov rax, [rbp - offset]" = 48 8B 85 <disp32>
# rax = local var index. offset = (index + 1) * 8, negated.
emit_fn_var_load:
    push rsi
    push rbx
    inc rax
    shl rax, 3
    neg rax               # disp32 = -(index+1)*8
    mov rbx, rax
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x858B48
    mov [rsi], rax
    add r13, 3
    # write disp32 (read-modify-write)
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rbx, 0xFFFFFFFF
    or rax, rbx
    mov [rsi], rax
    add r13, 4
    pop rbx
    pop rsi
    ret

# emit_fn_var_store: emit "mov [rbp - offset], rax" = 48 89 85 <disp32>
# rax = local var index
emit_fn_var_store:
    push rsi
    push rbx
    inc rax
    shl rax, 3
    neg rax
    mov rbx, rax
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x858948
    mov [rsi], rax
    add r13, 3
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rbx, 0xFFFFFFFF
    or rax, rbx
    mov [rsi], rax
    add r13, 4
    pop rbx
    pop rsi
    ret

# emit_fn_var_addr: emit "lea rax, [rbp - offset]" = 48 8D 85 <disp32>
# rax = local var index
emit_fn_var_addr:
    push rsi
    push rbx
    inc rax
    shl rax, 3
    neg rax
    mov rbx, rax
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x858D48
    mov [rsi], rax
    add r13, 3
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rbx, 0xFFFFFFFF
    or rax, rbx
    mov [rsi], rax
    add r13, 4
    pop rbx
    pop rsi
    ret

# emit_store_param: store parameter register to [rbp - offset]
# rax = param index (0-5), rbx = local var index for offset
# Emits mov [rbp+disp32], <reg> where reg depends on param index
emit_store_param:
    push rsi
    push rcx
    push rdx
    # compute disp32 = -(rbx+1)*8
    push rbx
    inc rbx
    shl rbx, 3
    neg rbx
    mov rdx, rbx          # rdx = disp32
    pop rbx
    # determine opcode bytes based on param index (rax)
    cmp rax, 0
    je emit_sp_rdi
    cmp rax, 1
    je emit_sp_rsi
    cmp rax, 2
    je emit_sp_rdx
    cmp rax, 3
    je emit_sp_rcx
    cmp rax, 4
    je emit_sp_r8
    cmp rax, 5
    je emit_sp_r9
    jmp emit_sp_done

emit_sp_rdi:
    mov rax, 0xBD8948     # 48 89 BD = mov [rbp+d32], rdi
    jmp emit_sp_write
emit_sp_rsi:
    mov rax, 0xB58948     # 48 89 B5 = mov [rbp+d32], rsi
    jmp emit_sp_write
emit_sp_rdx:
    mov rax, 0x958948     # 48 89 95 = mov [rbp+d32], rdx
    jmp emit_sp_write
emit_sp_rcx:
    mov rax, 0x8D8948     # 48 89 8D = mov [rbp+d32], rcx
    jmp emit_sp_write
emit_sp_r8:
    mov rax, 0x85894C     # 4C 89 85 = mov [rbp+d32], r8
    jmp emit_sp_write
emit_sp_r9:
    mov rax, 0x8D894C     # 4C 89 8D = mov [rbp+d32], r9
    jmp emit_sp_write

emit_sp_write:
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov [rsi], rax
    add r13, 3
    # write disp32
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rdx, 0xFFFFFFFF
    or rax, rdx
    mov [rsi], rax
    add r13, 4
emit_sp_done:
    pop rdx
    pop rcx
    pop rsi
    ret

# emit_call_placeholder: emit "call <placeholder_rel32>" = E8 00000000
# Returns patch offset (where rel32 starts) in rax.
emit_call_placeholder:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE8
    mov [rsi], rax
    inc r13
    mov rax, r13          # patch offset = where rel32 starts
    push rax
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    pop rax
    pop rsi
    ret

# emit_call_to: emit "call <rel32>" with computed offset
# rax = target codebuf position
emit_call_to:
    push rsi
    push rbx
    mov rbx, rax         # target
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE8
    mov [rsi], rax
    inc r13
    # rel32 = target - (r13 + 4)
    mov rax, rbx
    mov rcx, r13
    add rcx, 4
    sub rax, rcx
    and rax, 0xFFFFFFFF
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rcx, [rsi]
    shr rcx, 32
    shl rcx, 32
    or rax, rcx
    mov [rsi], rax
    add r13, 4
    pop rbx
    pop rsi
    ret

# emit_fn_call_pops: pop args into System V registers (rdi, rsi, rdx, rcx, r8, r9)
# rax = arg count (0-6)
emit_fn_call_pops:
    cmp rax, 0
    je emit_fcp_0
    cmp rax, 1
    je emit_fcp_1
    cmp rax, 2
    je emit_fcp_2
    cmp rax, 3
    je emit_fcp_3
    cmp rax, 4
    je emit_fcp_4
    cmp rax, 5
    je emit_fcp_5
    cmp rax, 6
    je emit_fcp_6
    jmp parse_err
emit_fcp_0:
    ret
emit_fcp_1:
    call emit_pop_rdi
    ret
emit_fcp_2:
    call emit_pop_rsi
    call emit_pop_rdi
    ret
emit_fcp_3:
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    ret
emit_fcp_4:
    call emit_pop_rcx
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    ret
emit_fcp_5:
    call emit_pop_r8
    call emit_pop_rcx
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    ret
emit_fcp_6:
    call emit_pop_r9
    call emit_pop_r8
    call emit_pop_rcx
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    ret

# ================================================================
# FUNCTION TABLE MANAGEMENT
# ================================================================

# register_fn: register a new function. rax = name offset. Returns fn index in rax.
register_fn:
    push rsi
    push rcx
    # load fn_count
    mov rsi, r15
    add rsi, 0x93810
    mov rcx, [rsi]
    # store name at fn_names[count]
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x92010
    add rsi, rcx
    mov [rsi], rax
    # set fn_offsets[count] = -1 (not yet defined)
    mov rsi, r15
    add rsi, 0x92810
    add rsi, rcx
    mov rax, -1
    mov [rsi], rax
    # set fn_params[count] = 0
    mov rsi, r15
    add rsi, 0x93010
    add rsi, rcx
    xor rax, rax
    mov [rsi], rax
    pop rcx               # rcx = index
    # increment fn_count
    mov rax, rcx
    inc rax
    push rcx
    mov rsi, r15
    add rsi, 0x93810
    mov [rsi], rax
    pop rax               # return index
    pop rcx
    pop rsi
    ret

# find_fn_index: find function by name. rax = name offset in tok_names.
# Returns index in rax, or -1 if not found.
find_fn_index:
    push r8
    push r9
    push rcx
    mov r8, rax           # name to find
    # load fn_count
    mov rsi, r15
    add rsi, 0x93810
    mov r9, [rsi]
    xor rcx, rcx
find_fn_loop:
    cmp rcx, r9
    jge find_fn_notfound
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x92010
    add rsi, rcx
    mov rax, [rsi]
    pop rcx
    # compare names
    push r8
    push r9
    push rcx
    mov rdi, r15
    add rdi, 0x50000
    add rdi, rax
    mov rsi, r15
    add rsi, 0x50000
    add rsi, r8
    call strcmp
    pop rcx
    pop r9
    pop r8
    cmp rax, 0
    je find_fn_found
    inc rcx
    jmp find_fn_loop
find_fn_found:
    mov rax, rcx
    pop rcx
    pop r9
    pop r8
    ret
find_fn_notfound:
    mov rax, -1
    pop rcx
    pop r9
    pop r8
    ret

# find_fn_local_index: find local variable by name.
# rax = name offset in tok_names. Returns index in rax.
find_fn_local_index:
    push r8
    push r9
    push rcx
    mov r8, rax
    mov rsi, r15
    add rsi, 0x93820
    mov r9, [rsi]         # fn_local_count
    xor rcx, rcx
find_fnl_loop:
    cmp rcx, r9
    jge find_fnl_undef
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x93A40
    add rsi, rcx
    mov rax, [rsi]
    pop rcx
    push r8
    push r9
    push rcx
    mov rdi, r15
    add rdi, 0x50000
    add rdi, rax
    mov rsi, r15
    add rsi, 0x50000
    add rsi, r8
    call strcmp
    pop rcx
    pop r9
    pop r8
    cmp rax, 0
    je find_fnl_found
    inc rcx
    jmp find_fnl_loop
find_fnl_found:
    mov rax, rcx
    pop rcx
    pop r9
    pop r8
    ret
find_fnl_undef:
    # undefined local variable
    mov rax, 1
    mov rdi, 2
    mov rsi, err_undef
    mov rdx, 19
    syscall
    pop rcx
    pop r9
    pop r8
    jmp sys_exit_err

# record_fixup_at: record fixup with explicit codebuf offset.
# rax = codebuf offset, rbx = type_and_index.
record_fixup_at:
    push rsi
    push rcx
    push rdx
    mov rdx, rax
    mov rsi, r15
    add rsi, 0x92000
    mov rax, [rsi]
    mov rcx, rax
    shl rax, 4
    mov rsi, r15
    add rsi, 0x90000
    add rsi, rax
    mov [rsi], rdx
    add rsi, 8
    mov [rsi], rbx
    inc rcx
    mov rsi, r15
    add rsi, 0x92000
    mov [rsi], rcx
    pop rdx
    pop rcx
    pop rsi
    ret

# ================================================================
# LEXER
# ================================================================

lexer:
    push r8
    push r9
    push rcx
    push rbx
    xor r8, r8
    xor r10, r10
    xor r9, r9

lexer_loop:
    cmp r8, r12
    jge lexer_eof
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF

    # whitespace
    cmp rax, 32
    je lexer_skip
    cmp rax, 9
    je lexer_skip
    cmp rax, 10
    je lexer_skip
    cmp rax, 13
    je lexer_skip

    # digit
    cmp rax, 48
    jl lexer_not_digit
    cmp rax, 57
    jg lexer_not_digit
    jmp lexer_number

lexer_not_digit:
    # lowercase letter a-z
    cmp rax, 97
    jl lexer_not_lower
    cmp rax, 122
    jle lexer_ident
lexer_not_lower:
    # uppercase letter A-Z
    cmp rax, 65
    jl lexer_not_letter
    cmp rax, 90
    jle lexer_ident

lexer_not_letter:
    # two-char operators: == != <= >=
    cmp rax, 61
    je lexer_eq_or_eqeq
    cmp rax, 33
    je lexer_bang
    cmp rax, 60
    je lexer_lt_or_lte
    cmp rax, 62
    je lexer_gt_or_gte

    # single-char tokens
    cmp rax, 59
    je lexer_semi
    cmp rax, 43
    je lexer_plus
    cmp rax, 45
    je lexer_minus
    cmp rax, 42
    je lexer_star
    cmp rax, 47
    je lexer_slash
    cmp rax, 40
    je lexer_lparen
    cmp rax, 41
    je lexer_rparen
    cmp rax, 123
    je lexer_lbrace
    cmp rax, 125
    je lexer_rbrace
    cmp rax, 38
    je lexer_ampersand
    cmp rax, 91
    je lexer_lbracket
    cmp rax, 93
    je lexer_rbracket
    cmp rax, 44
    je lexer_comma
    cmp rax, 58          # ':' COLON (typed-return / typed-var brick)
    je lexer_colon
    cmp rax, 34
    je lexer_string

    # Bitwise / modulo operators
    cmp rax, 37           # '%'
    je lexer_percent
    cmp rax, 124          # '|'
    je lexer_pipe
    cmp rax, 94           # '^'
    je lexer_caret
    cmp rax, 126          # '~'
    je lexer_tilde
    cmp rax, 35           # '#' comment
    je lexer_comment

    jmp lexer_skip

# ── Two-char operator handlers ──

lexer_eq_or_eqeq:
    # peek next char
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_eq_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 61          # '='
    je lexer_eqeq
lexer_eq_single:
    mov rax, 4
    call lexer_emit_simple
    jmp lexer_skip

lexer_eqeq:
    mov rax, 17
    call lexer_emit_simple
    inc r8               # skip second '='
    jmp lexer_skip

lexer_bang:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_skip       # lone '!' — skip
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 61
    jne lexer_skip       # '!' without '=' — skip
    mov rax, 18          # NEQ
    call lexer_emit_simple
    inc r8
    jmp lexer_skip

lexer_lt_or_lte:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_lt_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 61
    je lexer_lte
    cmp rax, 60           # '<' — check for <<
    je lexer_shl
lexer_lt_single:
    mov rax, 19          # LT
    call lexer_emit_simple
    jmp lexer_skip

lexer_lte:
    mov rax, 21          # LTE
    call lexer_emit_simple
    inc r8
    jmp lexer_skip

lexer_shl:
    mov rax, 38          # SHL
    call lexer_emit_simple
    inc r8
    jmp lexer_skip

lexer_gt_or_gte:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_gt_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 61
    je lexer_gte
    cmp rax, 62           # '>' — check for >>
    je lexer_shr
lexer_gt_single:
    mov rax, 20          # GT
    call lexer_emit_simple
    jmp lexer_skip

lexer_gte:
    mov rax, 22          # GTE
    call lexer_emit_simple
    inc r8
    jmp lexer_skip

lexer_shr:
    mov rax, 39          # SHR
    call lexer_emit_simple
    inc r8
    jmp lexer_skip

# ── Single-char tokens ──

lexer_semi:
    mov rax, 5
    call lexer_emit_simple
    jmp lexer_skip

lexer_plus:
    mov rax, 6
    call lexer_emit_simple
    jmp lexer_skip

lexer_minus:
    mov rax, 7
    call lexer_emit_simple
    jmp lexer_skip

lexer_star:
    mov rax, 8
    call lexer_emit_simple
    jmp lexer_skip

lexer_slash:
    mov rax, 9
    call lexer_emit_simple
    jmp lexer_skip

lexer_lparen:
    mov rax, 10
    call lexer_emit_simple
    jmp lexer_skip

lexer_rparen:
    mov rax, 11
    call lexer_emit_simple
    jmp lexer_skip

lexer_lbrace:
    mov rax, 13
    call lexer_emit_simple
    jmp lexer_skip

lexer_rbrace:
    mov rax, 14
    call lexer_emit_simple
    jmp lexer_skip

lexer_ampersand:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_amp_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 38          # second '&' -> &&
    je lexer_andand
lexer_amp_single:
    mov rax, 27          # AMPERSAND
    call lexer_emit_simple
    jmp lexer_skip
lexer_andand:
    mov rax, 51          # ANDAND (&& brick)
    call lexer_emit_simple
    inc r8               # skip second '&'
    jmp lexer_skip

lexer_lbracket:
    mov rax, 28
    call lexer_emit_simple
    jmp lexer_skip

lexer_rbracket:
    mov rax, 29
    call lexer_emit_simple
    jmp lexer_skip

lexer_comma:
    mov rax, 31
    call lexer_emit_simple
    jmp lexer_skip

lexer_colon:
    mov rax, 50          # COLON (typed-return / typed-var brick)
    call lexer_emit_simple
    jmp lexer_skip

# ── Bitwise / modulo tokens ��─

lexer_percent:
    mov rax, 34          # PERCENT
    call lexer_emit_simple
    jmp lexer_skip

lexer_pipe:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_pipe_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 124         # second '|' -> ||
    je lexer_oror
lexer_pipe_single:
    mov rax, 35          # PIPE
    call lexer_emit_simple
    jmp lexer_skip
lexer_oror:
    mov rax, 52          # OROR (|| brick)
    call lexer_emit_simple
    inc r8               # skip second '|'
    jmp lexer_skip

lexer_caret:
    mov rax, 36          # CARET
    call lexer_emit_simple
    jmp lexer_skip

lexer_tilde:
    mov rax, 37          # TILDE
    call lexer_emit_simple
    jmp lexer_skip

lexer_comment:
    # skip from # to end of line
    inc r8
lexer_comment_loop:
    cmp r8, r12
    jge lexer_loop        # hit EOF
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 10           # newline
    je lexer_skip         # skip the newline too
    inc r8
    jmp lexer_comment_loop

# ── String literal ──
lexer_string:
    inc r8               # skip opening "
    # save start offset in string_data
    push rbx
    mov rsi, r15
    add rsi, 0x6A000
    mov rbx, [rsi]       # rbx = current string_pos
    push rcx
    mov rcx, rbx          # rcx = start offset

lexer_str_loop:
    cmp r8, r12
    jge lexer_str_done    # unterminated string — just stop
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF

    cmp rax, 34           # closing "
    je lexer_str_end

    cmp rax, 92           # backslash
    je lexer_str_escape

    # regular character: copy to string_data
    mov rsi, r15
    add rsi, 0x69000
    add rsi, rbx
    movb [rsi], rax
    inc rbx
    inc r8
    jmp lexer_str_loop

lexer_str_escape:
    inc r8               # skip backslash
    cmp r8, r12
    jge lexer_str_done
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 110          # 'n'
    je lexer_esc_n
    cmp rax, 116          # 't'
    je lexer_esc_t
    cmp rax, 92           # '\'
    je lexer_esc_bs
    cmp rax, 34           # '"'
    je lexer_esc_q
    cmp rax, 48           # '0'
    je lexer_esc_0
    jmp lexer_str_store   # unknown escape — store as-is

lexer_esc_n:
    mov rax, 10
    jmp lexer_str_store
lexer_esc_t:
    mov rax, 9
    jmp lexer_str_store
lexer_esc_bs:
    mov rax, 92
    jmp lexer_str_store
lexer_esc_q:
    mov rax, 34
    jmp lexer_str_store
lexer_esc_0:
    xor rax, rax

lexer_str_store:
    mov rsi, r15
    add rsi, 0x69000
    add rsi, rbx
    movb [rsi], rax
    inc rbx
    inc r8
    jmp lexer_str_loop

lexer_str_end:
    inc r8               # skip closing "

lexer_str_done:
    # compute length = rbx - rcx
    mov rax, rbx
    sub rax, rcx          # rax = length
    # token value = (start_offset << 16) | length
    push rdx
    mov rdx, rcx
    shl rdx, 16
    or rax, rdx
    pop rdx
    # emit STRING token (type=30)
    push rax              # save packed value
    mov rax, 30
    push rax
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x10000
    add rsi, rcx
    pop rax
    mov [rsi], rax        # tok_types[r10] = 30
    pop rax               # packed value
    mov rsi, r15
    add rsi, 0x30000
    add rsi, rcx
    mov [rsi], rax        # tok_values[r10] = (offset << 16) | length
    inc r10
    # update string_pos
    mov rsi, r15
    add rsi, 0x6A000
    mov [rsi], rbx
    pop rcx
    pop rbx
    jmp lexer_loop

lexer_emit_simple:
    push rax
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x10000
    add rsi, rcx
    pop rax
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x30000
    add rsi, rcx
    xor rax, rax
    mov [rsi], rax
    inc r10
    ret

lexer_skip:
    inc r8
    jmp lexer_loop

# ── Number literal (decimal or 0x hex) ──
lexer_number:
    # check for 0x prefix
    cmp rax, 48           # '0'
    jne lexer_decimal
    # peek next char
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_decimal     # just '0' at EOF
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 120          # 'x'
    je lexer_hex
    cmp rax, 88           # 'X'
    je lexer_hex
    # not hex prefix — parse as decimal starting from 0
    mov rax, 48           # restore '0'
lexer_decimal:
    sub rax, 48
    mov rbx, rax
lexer_num_loop:
    inc r8
    cmp r8, r12
    jge lexer_num_done
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 48
    jl lexer_num_done
    cmp rax, 57
    jg lexer_num_done
    sub rax, 48
    mov rcx, rbx
    shl rbx, 3
    add rbx, rcx
    add rbx, rcx
    add rbx, rax
    jmp lexer_num_loop

lexer_hex:
    # skip past '0x'
    add r8, 2             # skip '0' and 'x'
    xor rbx, rbx
lexer_hex_loop:
    cmp r8, r12
    jge lexer_num_done
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    # check digit 0-9
    cmp rax, 48
    jl lexer_num_done
    cmp rax, 57
    jg lexer_hex_alpha
    sub rax, 48
    jmp lexer_hex_accum
lexer_hex_alpha:
    # check a-f
    cmp rax, 97
    jl lexer_hex_upper
    cmp rax, 102
    jg lexer_num_done
    sub rax, 87           # 'a'=97 → 10
    jmp lexer_hex_accum
lexer_hex_upper:
    # check A-F
    cmp rax, 65
    jl lexer_num_done
    cmp rax, 70
    jg lexer_num_done
    sub rax, 55           # 'A'=65 → 10
lexer_hex_accum:
    shl rbx, 4
    add rbx, rax
    inc r8
    jmp lexer_hex_loop

lexer_num_done:
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x10000
    add rsi, rcx
    mov rax, 1
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x30000
    add rsi, rcx
    mov [rsi], rbx
    inc r10
    jmp lexer_loop

# ── Identifier / keyword ──
lexer_ident:
    mov rbx, r9
lexer_id_loop:
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 97
    jl lexer_id_check2
    cmp rax, 122
    jle lexer_id_copy
lexer_id_check2:
    cmp rax, 48
    jl lexer_id_check3
    cmp rax, 57
    jle lexer_id_copy
lexer_id_check3:
    cmp rax, 95           # '_'
    je lexer_id_copy
    cmp rax, 65           # 'A'
    jl lexer_id_end
    cmp rax, 90           # 'Z'
    jle lexer_id_copy
    jmp lexer_id_end
lexer_id_copy:
    mov rsi, r15
    add rsi, 0x50000
    add rsi, r9
    mov [rsi], rax
    inc r9
    inc r8
    cmp r8, r12
    jl lexer_id_loop
lexer_id_end:
    # null-terminate
    mov rsi, r15
    add rsi, 0x50000
    add rsi, r9
    xor rax, rax
    mov [rsi], rax
    inc r9

    # check keywords: "var", "if", "while"
    mov rsi, r15
    add rsi, 0x50000
    add rsi, rbx
    mov rax, [rsi]

    # "var\0" = 0x00726176
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFF
    push rbx
    mov rbx, 0x00726176
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_var

    # "if\0" = 0x006669
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFF
    push rbx
    mov rbx, 0x006669
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_if

    # "while\0" = check 6 bytes
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00656C696877
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_while

    # "else\0" = 0x00_65_73_6C_65
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFF
    push rbx
    mov rbx, 0x0065736C65
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_else

    # "syscall\0" = 0x006C6C6163737973 (full 8-byte qword compare)
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x006C6C6163737973
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_syscall

    # "load8\0" = 0x000038_6461_6F6C (6 bytes)
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00003864616F6C
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_load8

    # "store8\0" = 0x003865726F7473 (7 bytes)
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x003865726F7473
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_store8

    # "fn\0" = 0x006E66 (3 bytes)
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFF
    push rbx
    mov rbx, 0x006E66
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_fn

    # "return\0" = 0x006E7275746572 (7 bytes)
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x006E7275746572
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_return

    # "enum\0" = 0x006D756E65 (5 bytes) — v6.2.x cybs-grow brick 1 (enum const namespace)
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFF
    push rbx
    mov rbx, 0x006D756E65
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_enum

    # for (brick)
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFF
    push rbx
    mov rbx, 0x00726F66    # for
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_for

    # break / continue (brick)
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFF
    push rbx
    mov rbx, 0x006B61657262   # break
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_break
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x65756E69746E6F63  # continue (full 8 bytes)
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_continue

    # load/store 16/32/64 (brick)
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00363164616F6C   # load16
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_load16
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00323364616F6C   # load32
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_load32
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00343664616F6C   # load64
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_load64
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x00363165726F7473  # store16
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_store16
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x00323365726F7473  # store32
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_store32
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x00343665726F7473  # store64
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_store64

    # regular identifier
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x10000
    add rsi, rcx
    mov rax, 2
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x30000
    add rsi, rcx
    mov [rsi], rbx
    inc r10
    jmp lexer_loop

lexer_id_is_var:
    mov rax, 3
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_if:
    mov rax, 15
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_while:
    mov rax, 16
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_else:
    mov rax, 23
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_syscall:
    mov rax, 24
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_load8:
    mov rax, 25
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_store8:
    mov rax, 26
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_load16:
    mov rax, 60
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_load32:
    mov rax, 61
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_load64:
    mov rax, 62
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_store16:
    mov rax, 63
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_store32:
    mov rax, 64
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_store64:
    mov rax, 65
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_for:
    mov rax, 53
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_break:
    mov rax, 54
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_continue:
    mov rax, 55
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_fn:
    mov rax, 32
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_return:
    mov rax, 33
    call lexer_emit_kw
    jmp lexer_loop

lexer_id_is_enum:
    mov rax, 40          # ENUM keyword token (v6.2.x cybs-grow brick 1)
    call lexer_emit_kw
    jmp lexer_loop

lexer_emit_kw:
    push rax
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x10000
    add rsi, rcx
    pop rax
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x30000
    add rsi, rcx
    xor rax, rax
    mov [rsi], rax
    inc r10
    ret

lexer_eof:
    mov rax, 12
    call lexer_emit_simple
    pop rbx
    pop rcx
    pop r9
    pop r8
    ret

# ================================================================
# PARSER — runtime code emission
# ================================================================

parser:
    xor r11, r11
    # store last_var_idx = -1
    mov rsi, r15
    add rsi, 0x92008
    mov rax, -1
    mov [rsi], rax

    # Emit jmp placeholder over function bodies
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    # save patch offset at main_jmp_patch
    mov rax, r13
    mov rsi, r15
    add rsi, 0x93A38
    mov [rsi], rax
    # emit placeholder rel32
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    pop rsi

    # Parse all fn definitions
parse_fn_defs:
    call peek_tok_type
    cmp rax, 32          # FN
    je parse_fn_defs_fn
    cmp rax, 40          # ENUM (v6.2.x cybs-grow brick 1) — top-level enum decl
    je parse_fn_defs_enum
    jmp parse_fn_defs_done
parse_fn_defs_fn:
    call parse_fn_def
    jmp parse_fn_defs
parse_fn_defs_enum:
    call parse_enum_def
    jmp parse_fn_defs
parse_fn_defs_done:

    # Patch the initial jmp to land here (start of main code)
    mov rsi, r15
    add rsi, 0x93A38
    mov rax, [rsi]
    call patch_rel32

    # Parse main code (top-level statements)
    call parse_program

    # Exit epilogue
    mov rsi, r15
    add rsi, 0x92008
    mov rax, [rsi]
    cmp rax, -1
    je parser_no_vars
    call emit_var_load
parser_no_vars:
    call emit_exit_epilogue
    ret

parse_program:
parse_prog_loop:
    call peek_tok_type
    cmp rax, 12          # EOF
    je parse_prog_done
    cmp rax, 14          # RBRACE — return to caller (if/while body)
    je parse_prog_done
    call parse_statement
    jmp parse_prog_loop
parse_prog_done:
    ret

# ── fn name(params) { body } ──
parse_fn_def:
    push r8
    push r9
    push rbx
    inc r11              # consume FN

    # get function name
    call peek_tok_type
    cmp rax, 2           # IDENT
    jne parse_err
    call peek_tok_value
    mov r8, rax          # r8 = name offset
    inc r11

    # register or find function
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    jne parse_fn_def_exists
    # new function
    mov rax, r8
    call register_fn
parse_fn_def_exists:
    mov r9, rax          # r9 = fn index

    # set fn_offsets[r9] = r13 (current code position = entry point)
    push rcx
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x92810
    add rsi, rcx
    mov [rsi], r13
    pop rcx

    # save compiler state
    mov rsi, r15
    add rsi, 0x93828
    mov [rsi], r14       # saved_var_count = r14
    # save last_var_idx
    push rsi
    mov rsi, r15
    add rsi, 0x92008
    mov rbx, [rsi]       # save current last_var_idx
    pop rsi
    # set in_function = 1
    mov rsi, r15
    add rsi, 0x93818
    mov rax, 1
    mov [rsi], rax
    # zero fn_local_count
    mov rsi, r15
    add rsi, 0x93820
    xor rax, rax
    mov [rsi], rax
    # zero return_patch_count
    mov rsi, r15
    add rsi, 0x93A30
    mov [rsi], rax

    # emit prologue: push rbp; mov rbp, rsp; sub rsp, <placeholder>
    call emit_push_rbp
    call emit_mov_rbp_rsp
    xor rax, rax         # placeholder frame size = 0
    call emit_sub_rsp_imm32
    # save frame_size_patch offset at 0x93E40 (scratch)
    push rsi
    mov rsi, r15
    add rsi, 0x93E40
    mov [rsi], rax
    pop rsi

    # parse parameter list
    call peek_tok_type
    cmp rax, 10          # LPAREN
    jne parse_err
    inc r11

    # use heap scratch at 0x93E48 for param_count to avoid stack issues
    mov rsi, r15
    add rsi, 0x93E48
    xor rax, rax
    mov [rsi], rax        # param_count = 0

    call peek_tok_type
    cmp rax, 11          # RPAREN (no params)
    je parse_fn_params_done

parse_fn_param:
    call peek_tok_type
    cmp rax, 2           # IDENT
    jne parse_err
    call peek_tok_value
    mov rcx, rax          # rcx = name offset
    inc r11

    # get fn_local_count
    mov rsi, r15
    add rsi, 0x93820
    mov rax, [rsi]        # rax = fn_local_count (= local var index)

    # store name in fn_local_names[fn_local_count]
    push rax
    shl rax, 3
    mov rsi, r15
    add rsi, 0x93A40
    add rsi, rax
    mov [rsi], rcx        # fn_local_names[count] = name offset
    pop rax               # rax = local index (unshifted)

    # emit: store param register to stack slot
    push rax              # save local index
    mov rbx, rax          # rbx = local var index for offset computation
    mov rsi, r15
    add rsi, 0x93E48
    mov rax, [rsi]        # rax = param index
    call emit_store_param
    pop rax               # restore local index

    # increment param_count
    mov rsi, r15
    add rsi, 0x93E48
    mov rcx, [rsi]
    inc rcx
    mov [rsi], rcx

    # increment fn_local_count
    mov rsi, r15
    add rsi, 0x93820
    mov rax, [rsi]
    inc rax
    mov [rsi], rax

    inc rdx               # param count++

    call peek_tok_type
    cmp rax, 31          # COMMA
    je parse_fn_param_next
    cmp rax, 11          # RPAREN
    je parse_fn_params_done
    jmp parse_err

parse_fn_param_next:
    inc r11              # consume comma
    jmp parse_fn_param

parse_fn_params_done:
    inc r11              # consume RPAREN

    # store param count in fn_params[r9]
    push rcx
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x93010
    add rsi, rcx
    # load param_count from scratch
    push rsi
    mov rsi, r15
    add rsi, 0x93E48
    mov rax, [rsi]
    pop rsi
    mov [rsi], rax       # fn_params[r9] = param_count
    pop rcx

    # optional return type:  : TYPE  (typed-return brick — consume + ignore)
    call peek_tok_type
    cmp rax, 50          # COLON
    jne parse_fn_no_rettype
    inc r11              # consume COLON
    call peek_tok_type
    cmp rax, 2           # IDENT (return type name)
    jne parse_err
    inc r11              # consume type IDENT
parse_fn_no_rettype:

    # expect LBRACE
    call peek_tok_type
    cmp rax, 13
    jne parse_err
    inc r11

    # parse body
    call parse_program

    # expect RBRACE
    call peek_tok_type
    cmp rax, 14
    jne parse_err
    inc r11

    # patch all return jumps to land here (epilogue)
    push rcx
    mov rsi, r15
    add rsi, 0x93A30
    mov rcx, [rsi]       # return_patch_count
    xor rax, rax
parse_fn_patch_returns:
    cmp rax, rcx
    jge parse_fn_patch_done
    push rax
    push rcx
    shl rax, 3
    mov rsi, r15
    add rsi, 0x93830
    add rsi, rax
    mov rax, [rsi]       # return_patches[i]
    call patch_rel32
    pop rcx
    pop rax
    inc rax
    jmp parse_fn_patch_returns
parse_fn_patch_done:
    pop rcx

    # emit epilogue: leave; ret
    call emit_leave_ret

    # patch frame size
    push rsi
    mov rsi, r15
    add rsi, 0x93E40
    mov rax, [rsi]       # frame_size_patch offset
    pop rsi
    push rsi
    # compute frame size = fn_local_count * 8, aligned to 16
    mov rsi, r15
    add rsi, 0x93820
    mov rcx, [rsi]
    shl rcx, 3            # local_count * 8
    add rcx, 15
    and rcx, -16          # align to 16
    # patch the imm32 at frame_size_patch
    mov rsi, r15
    add rsi, 0x59000
    add rsi, rax
    push rax
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rcx, 0xFFFFFFFF
    or rax, rcx
    mov [rsi], rax
    pop rax
    pop rsi

    # restore compiler state
    mov rsi, r15
    add rsi, 0x93828
    mov r14, [rsi]       # restore var count
    # restore last_var_idx
    mov rsi, r15
    add rsi, 0x92008
    mov [rsi], rbx       # rbx was saved earlier
    # set in_function = 0
    mov rsi, r15
    add rsi, 0x93818
    xor rax, rax
    mov [rsi], rax

    pop rbx
    pop r9
    pop r8
    ret

parse_statement:
    call peek_tok_type

    cmp rax, 3           # VAR
    je parse_var_stmt
    cmp rax, 2           # IDENT (reassignment or fn call)
    je parse_assign_stmt
    cmp rax, 15          # IF
    je parse_if_stmt
    cmp rax, 16          # WHILE
    je parse_while_stmt
    cmp rax, 53          # FOR
    je parse_for_stmt
    cmp rax, 33          # RETURN
    je parse_return_stmt
    cmp rax, 54          # BREAK
    je parse_break_stmt
    cmp rax, 55          # CONTINUE
    je parse_continue_stmt

    # expression statement: syscall(...); store8(...); etc.
    cmp rax, 24          # SYSCALL
    je parse_expr_stmt
    cmp rax, 26          # STORE8
    je parse_expr_stmt
    cmp rax, 25          # LOAD8
    je parse_expr_stmt
    cmp rax, 60          # LOAD16
    je parse_expr_stmt
    cmp rax, 61          # LOAD32
    je parse_expr_stmt
    cmp rax, 62          # LOAD64
    je parse_expr_stmt
    cmp rax, 63          # STORE16
    je parse_expr_stmt
    cmp rax, 64          # STORE32
    je parse_expr_stmt
    cmp rax, 65          # STORE64
    je parse_expr_stmt

    jmp parse_err

parse_return_stmt:
    inc r11              # consume RETURN
    call parse_expr      # result in rax at runtime
    # expect SEMI
    call peek_tok_type
    cmp rax, 5
    jne parse_err
    inc r11
    # emit jmp to epilogue (forward, patch later)
    push rsi
    push rbx
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    mov rbx, r13         # patch offset
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    # record in return_patches
    mov rsi, r15
    add rsi, 0x93A30
    mov rax, [rsi]       # return_patch_count
    mov rcx, rax
    shl rax, 3
    mov rsi, r15
    add rsi, 0x93830
    add rsi, rax
    mov [rsi], rbx       # return_patches[count] = patch offset
    inc rcx
    mov rsi, r15
    add rsi, 0x93A30
    mov [rsi], rcx
    pop rbx
    pop rsi
    ret

parse_expr_stmt:
    call parse_expr
    # expect SEMI
    call peek_tok_type
    cmp rax, 5
    jne parse_err
    inc r11
    ret

# ── var IDENT = expr ; | var IDENT[NUM] ; ──
parse_var_stmt:
    push r8
    push r9
    inc r11              # consume VAR

    # expect IDENT
    call peek_tok_type
    cmp rax, 2
    jne parse_err
    call peek_tok_value
    mov r8, rax          # r8 = name offset
    inc r11

    # check: = (regular var) or [ (array)
    call peek_tok_type
    cmp rax, 28          # LBRACKET
    je parse_array_decl
    cmp rax, 4           # EQ
    jne parse_err
    inc r11

    # parse expression — emits code, result in rax at runtime
    call parse_expr

    # check if inside a function
    push rax
    mov rsi, r15
    add rsi, 0x93818
    mov rax, [rsi]
    cmp rax, 1
    pop rax
    je parse_var_stmt_local

    # ── global variable ──
    mov rcx, r14
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x58000
    add rsi, rcx
    mov [rsi], r8

    mov rsi, r15
    add rsi, 0x58800
    add rsi, rcx
    mov rax, 8
    mov [rsi], rax

    mov rax, r14
    call emit_var_store

    push rsi
    mov rsi, r15
    add rsi, 0x92008
    mov rax, r14
    mov [rsi], rax
    pop rsi

    inc r14
    jmp parse_var_stmt_semi

parse_var_stmt_local:
    # ── function local variable ──
    # store name in fn_local_names
    push rcx
    mov rsi, r15
    add rsi, 0x93820
    mov rcx, [rsi]       # fn_local_count
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x93A40
    add rsi, rcx
    mov [rsi], r8        # fn_local_names[count] = name offset
    pop rcx              # unshifted count = local index
    # emit store to stack
    mov rax, rcx
    call emit_fn_var_store
    # increment fn_local_count
    mov rsi, r15
    add rsi, 0x93820
    mov rax, [rsi]
    inc rax
    mov [rsi], rax
    pop rcx

parse_var_stmt_semi:
    # expect SEMI
    call peek_tok_type
    cmp rax, 5
    jne parse_err
    inc r11

    pop r9
    pop r8
    ret

# ── var IDENT[NUM] ; — array declaration ──
parse_array_decl:
    inc r11              # consume [
    # expect NUM
    call peek_tok_type
    cmp rax, 1
    jne parse_err
    call peek_tok_value
    mov r9, rax          # r9 = array size in bytes
    inc r11
    # expect ]
    call peek_tok_type
    cmp rax, 29          # RBRACKET
    jne parse_err
    inc r11
    # expect ;
    call peek_tok_type
    cmp rax, 5           # SEMI
    jne parse_err
    inc r11

    # store name in var_noffs
    mov rcx, r14
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x58000
    add rsi, rcx
    mov [rsi], r8

    # align size up to 8 and store in var_sizes
    mov rax, r9
    add rax, 7
    and rax, -8
    mov rsi, r15
    add rsi, 0x58800
    add rsi, rcx
    mov [rsi], rax

    inc r14

    pop r9
    pop r8
    ret

# ── IDENT = expr ; ──
parse_assign_stmt:
    push r8
    push r9

    # get identifier name offset
    call peek_tok_value
    mov r8, rax
    inc r11

    # check: is this a function call (IDENT followed by LPAREN)?
    call peek_tok_type
    cmp rax, 10          # LPAREN
    je parse_assign_is_fn_call

    # expect EQ
    cmp rax, 4
    jne parse_err
    inc r11

    # parse expression
    call parse_expr

    # check if inside function
    push rax
    mov rsi, r15
    add rsi, 0x93818
    mov rax, [rsi]
    cmp rax, 1
    pop rax
    je parse_assign_local

    # global assignment
    push rax
    mov rax, r8
    call find_var_index
    mov r9, rax
    pop rax
    mov rax, r9
    call emit_var_store
    push rsi
    mov rsi, r15
    add rsi, 0x92008
    mov [rsi], r9
    pop rsi
    jmp parse_assign_semi

parse_assign_local:
    # local assignment
    push rax
    mov rax, r8
    call find_fn_local_index
    mov r9, rax
    pop rax
    mov rax, r9
    call emit_fn_var_store
    jmp parse_assign_semi

parse_assign_is_fn_call:
    # function call as statement: name(args...);
    # r8 = name offset, LPAREN is next token (not consumed)
    # We'll handle this inline
    inc r11              # consume LPAREN
    push rdx
    xor r9, r9           # r9 = arg count
    call peek_tok_type
    cmp rax, 11          # RPAREN (no args)
    je parse_assign_fn_call_done

parse_assign_fn_call_arg:
    call parse_expr
    call emit_push_rax
    inc r9
    call peek_tok_type
    cmp rax, 31          # COMMA
    je parse_assign_fn_call_next
    cmp rax, 11          # RPAREN
    je parse_assign_fn_call_done
    jmp parse_err

parse_assign_fn_call_next:
    inc r11
    jmp parse_assign_fn_call_arg

parse_assign_fn_call_done:
    inc r11              # consume RPAREN
    # pop args into registers
    mov rax, r9
    call emit_fn_call_pops
    pop rdx
    # look up function
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    je parse_assign_fn_new
    mov r9, rax
    jmp parse_assign_fn_emit
parse_assign_fn_new:
    mov rax, r8
    call register_fn
    mov r9, rax
parse_assign_fn_emit:
    # check if fn offset is known
    push rcx
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x92810
    add rsi, rcx
    mov rax, [rsi]
    pop rcx
    cmp rax, -1
    je parse_assign_fn_fixup
    # known: emit call with computed rel32
    call emit_call_to
    jmp parse_assign_semi
parse_assign_fn_fixup:
    # unknown: emit placeholder, record type-2 fixup
    call emit_call_placeholder
    # rax = patch offset
    push rbx
    mov rbx, 2
    shl rbx, 56
    or rbx, r9           # type-2 | fn_index
    call record_fixup_at
    pop rbx

parse_assign_semi:
    # expect SEMI
    call peek_tok_type
    cmp rax, 5
    jne parse_err
    inc r11

    pop r9
    pop r8
    ret

# ── if (expr OP expr) { stmts } [else { stmts }] ──
parse_if_stmt:
    push r8
    push r9
    push rbx
    inc r11              # consume IF

    # save last_var_idx
    mov rsi, r15
    add rsi, 0x92008
    mov r9, [rsi]

    # expect LPAREN
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11

    # emit condition
    call emit_condition  # returns patch offset in rax

    mov r8, rax          # r8 = condition-false patch offset

    # expect RPAREN
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11

    # expect LBRACE
    call peek_tok_type
    cmp rax, 13
    jne parse_err
    inc r11

    # parse if-body
    call parse_program

    # expect RBRACE
    call peek_tok_type
    cmp rax, 14
    jne parse_err
    inc r11

    # check for else
    call peek_tok_type
    cmp rax, 23          # ELSE?
    je parse_if_else

    # no else: patch condition-false jump to here
    mov rax, r8
    call patch_rel32
    jmp parse_if_done

parse_if_else:
    inc r11              # consume ELSE

    # emit jmp to skip else body (from end of if-body)
    # Use a dummy target 0 — we'll patch it after the else body
    # emit_jmp_placeholder: emit E9 + 4-byte placeholder
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    mov rbx, r13         # rbx = patch offset for skip-else jmp
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    pop rsi

    # patch condition-false jump to here (start of else body)
    mov rax, r8
    call patch_rel32

    # expect LBRACE
    call peek_tok_type
    cmp rax, 13
    jne parse_err
    inc r11

    # parse else-body
    call parse_program

    # expect RBRACE
    call peek_tok_type
    cmp rax, 14
    jne parse_err
    inc r11

    # patch skip-else jump to here (after else body)
    mov rax, rbx
    call patch_rel32

parse_if_done:
    # restore last_var_idx
    mov rsi, r15
    add rsi, 0x92008
    mov [rsi], r9

    pop rbx
    pop r9
    pop r8
    ret

# ── while (expr OP expr) { stmts } ──
parse_while_stmt:
    push r8
    push r9
    push rbx
    inc r11              # consume WHILE

    # save last_var_idx
    mov rsi, r15
    add rsi, 0x92008
    mov rbx, [rsi]

    # save loop top position
    mov r9, r13          # r9 = loop_top

    # expect LPAREN
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11

    # emit condition
    call emit_condition
    mov r8, rax          # r8 = patch offset for exit jump

    # expect RPAREN
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11

    # expect LBRACE
    call peek_tok_type
    cmp rax, 13
    jne parse_err
    inc r11

    # loop_push: continue -> loop_top (re-check cond)
    mov rax, r9
    call loop_push

    # parse body
    call parse_program

    # expect RBRACE
    call peek_tok_type
    cmp rax, 14
    jne parse_err
    inc r11

    # emit backward jump to loop_top
    mov rax, r9
    call emit_jmp_to

    # patch forward exit jump
    mov rax, r8
    call patch_rel32

    # loop_pop: patch breaks -> here (loop exit)
    call loop_pop

    # restore last_var_idx
    mov rsi, r15
    add rsi, 0x92008
    mov [rsi], rbx

    pop rbx
    pop r9
    pop r8
    ret

# ── for/break/continue brick: loop-context stack ──
# Loop stack @ 0x94000 (zero-init by brk): loop_sp · 0x94008 cont_tgt[16]
#   · 0x94088 brk_base[16] · 0x94108 brk_cnt · 0x94110 brk_patches[512]
# emit_jmp0: emit "jmp rel32" placeholder, return patch offset in rax.
emit_jmp0:
    push rsi
    push rbx
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    mov rbx, r13
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    mov rax, rbx
    pop rbx
    pop rsi
    ret

# loop_push: rax = continue target. Push a loop frame.
loop_push:
    push rcx
    push rdx
    push rsi
    mov rsi, r15
    add rsi, 0x94000
    mov rcx, [rsi]       # sp
    mov rdx, rcx
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x94008
    add rsi, rdx
    mov [rsi], rax       # cont_tgt[sp] = target
    mov rsi, r15
    add rsi, 0x94108
    mov rax, [rsi]       # brk_cnt
    mov rsi, r15
    add rsi, 0x94088
    add rsi, rdx
    mov [rsi], rax       # brk_base[sp] = brk_cnt
    inc rcx
    mov rsi, r15
    add rsi, 0x94000
    mov [rsi], rcx       # sp++
    pop rsi
    pop rdx
    pop rcx
    ret

# loop_pop: patch all break jumps of innermost loop to here, pop frame.
loop_pop:
    push rax
    push rcx
    push rdx
    push rsi
    push r8
    mov rsi, r15
    add rsi, 0x94000
    mov rcx, [rsi]
    sub rcx, 1           # rcx = sp (innermost frame)
    mov rdx, rcx
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x94088
    add rsi, rdx
    mov r8, [rsi]        # r8 = base (counter)
    mov rsi, r15
    add rsi, 0x94108
    mov rdx, [rsi]       # rdx = cnt
loop_pop_patch:
    cmp r8, rdx
    jge loop_pop_done
    push rdx
    mov rdx, r8
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x94110
    add rsi, rdx
    mov rax, [rsi]       # brk_patches[i]
    pop rdx
    push rdx
    push r8
    call patch_rel32
    pop r8
    pop rdx
    inc r8
    jmp loop_pop_patch
loop_pop_done:
    mov rdx, rcx
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x94088
    add rsi, rdx
    mov rax, [rsi]       # base
    mov rsi, r15
    add rsi, 0x94108
    mov [rsi], rax       # brk_cnt = base
    mov rsi, r15
    add rsi, 0x94000
    mov [rsi], rcx       # loop_sp = sp
    pop r8
    pop rsi
    pop rdx
    pop rcx
    pop rax
    ret

# emit_break: emit jmp placeholder, record in brk_patches.
emit_break:
    push rcx
    push rdx
    push rsi
    call emit_jmp0       # rax = patch
    mov rsi, r15
    add rsi, 0x94108
    mov rcx, [rsi]       # cnt
    mov rdx, rcx
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x94110
    add rsi, rdx
    mov [rsi], rax       # brk_patches[cnt] = patch
    inc rcx
    mov rsi, r15
    add rsi, 0x94108
    mov [rsi], rcx       # brk_cnt++
    pop rsi
    pop rdx
    pop rcx
    ret

# emit_continue: emit jmp to innermost loop's continue target.
emit_continue:
    push rax
    push rcx
    push rsi
    mov rsi, r15
    add rsi, 0x94000
    mov rcx, [rsi]
    sub rcx, 1
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x94008
    add rsi, rcx
    mov rax, [rsi]       # cont_tgt[sp]
    call emit_jmp_to
    pop rsi
    pop rcx
    pop rax
    ret

# break; / continue; statement handlers
parse_break_stmt:
    inc r11              # consume BREAK
    call emit_break
    call peek_tok_type
    cmp rax, 5           # SEMI
    jne parse_err
    inc r11
    ret
parse_continue_stmt:
    inc r11              # consume CONTINUE
    call emit_continue
    call peek_tok_type
    cmp rax, 5           # SEMI
    jne parse_err
    inc r11
    ret

# for-loop step: IDENT = EXPR  (assignment, no trailing ;)
parse_for_step:
    push r8
    push r9
    call peek_tok_value
    mov r8, rax
    inc r11              # consume IDENT
    call peek_tok_type
    cmp rax, 4           # EQ
    jne parse_err
    inc r11
    call parse_expr      # value -> rax
    push rax
    mov rsi, r15
    add rsi, 0x93818     # in_function
    mov rax, [rsi]
    cmp rax, 1
    pop rax
    je parse_for_step_local
    push rax
    mov rax, r8
    call find_var_index
    mov r9, rax
    pop rax
    mov rax, r9
    call emit_var_store
    push rsi
    mov rsi, r15
    add rsi, 0x92008
    mov [rsi], r9
    pop rsi
    pop r9
    pop r8
    ret
parse_for_step_local:
    push rax
    mov rax, r8
    call find_fn_local_index
    mov r9, rax
    pop rax
    mov rax, r9
    call emit_fn_var_store
    pop r9
    pop r8
    ret

# for (INIT; COND; STEP) { BODY } — no-token-replay lowering.
# Temps @ 0x94B10 cp_cond · 0x94B18 body_skip · 0x94B20 cp_step (live only across
# the non-nested STEP region; the body re-reads cp_step from the loop stack).
parse_for_stmt:
    push r8              # r8 = exit_patch (survives body via nested push)
    push r9
    push rbx            # rbx = saved last_var_idx
    inc r11              # consume FOR
    mov rsi, r15
    add rsi, 0x92008
    mov rbx, [rsi]
    call peek_tok_type
    cmp rax, 10          # (
    jne parse_err
    inc r11
    call parse_statement # INIT (consumes its own ;)
    mov rsi, r15
    add rsi, 0x94B10
    mov [rsi], r13       # cp_cond = r13
    call parse_or_value  # COND -> 0/1
    call emit_cmp_rax_0
    mov rax, 0x84        # je exit
    call emit_jcc
    mov r8, rax          # exit_patch
    call peek_tok_type
    cmp rax, 5           # ;
    jne parse_err
    inc r11
    call emit_jmp0       # body_skip
    mov rsi, r15
    add rsi, 0x94B18
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x94B20
    mov [rsi], r13       # cp_step = r13
    call parse_for_step  # STEP (no ;)
    call peek_tok_type
    cmp rax, 11          # )
    jne parse_err
    inc r11
    mov rsi, r15
    add rsi, 0x94B10
    mov rax, [rsi]
    call emit_jmp_to     # jmp cp_cond
    mov rsi, r15
    add rsi, 0x94B18
    mov rax, [rsi]
    call patch_rel32     # body starts here
    call peek_tok_type
    cmp rax, 13          # {
    jne parse_err
    inc r11
    mov rsi, r15
    add rsi, 0x94B20
    mov rax, [rsi]
    call loop_push       # continue -> cp_step
    call parse_program   # BODY
    call peek_tok_type
    cmp rax, 14          # }
    jne parse_err
    inc r11
    call emit_continue   # after body, jmp cp_step (from loop stack)
    mov rax, r8
    call patch_rel32     # patch exit
    call loop_pop        # breaks -> here
    mov rsi, r15
    add rsi, 0x92008
    mov [rsi], rbx
    pop rbx
    pop r9
    pop r8
    ret

# ── &&/|| brick: comparisons-as-values (setcc) + short-circuit booleans ──
# emit_cmp_rax_0: emit "cmp rax, 0" = 48 83 F8 00
emit_cmp_rax_0:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0x00F88348
    mov [rsi], rax
    add r13, 4
    pop rsi
    ret

# emit_setcc_al: emit "setcc al; movzx rax, al". rax = 3-byte setcc-al literal.
emit_setcc_al:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov [rsi], rax       # setcc al (3 bytes)
    add r13, 3
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xC0B60F48  # movzx rax, al
    mov [rsi], rax
    add r13, 4
    pop rsi
    ret

# parse_cmp_value: parse_expr [ (== != < > <= >=) parse_expr -> setcc 0/1 ]
# Leaves a boolean (0/1) or the raw value in rax (via generated code).
parse_cmp_value:
    push r8
    call parse_expr
    call emit_push_rax
    call peek_tok_type
    mov r8, rax
    cmp r8, 17
    je pcv_iscmp
    cmp r8, 18
    je pcv_iscmp
    cmp r8, 19
    je pcv_iscmp
    cmp r8, 20
    je pcv_iscmp
    cmp r8, 21
    je pcv_iscmp
    cmp r8, 22
    je pcv_iscmp
    jmp pcv_noop
pcv_iscmp:
    inc r11
    call parse_expr
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_cmp_rax_rcx
    cmp r8, 17
    je pcv_eq
    cmp r8, 18
    je pcv_ne
    cmp r8, 19
    je pcv_lt
    cmp r8, 20
    je pcv_gt
    cmp r8, 21
    je pcv_le
    jmp pcv_ge
pcv_eq:
    mov rax, 0x00C0940F  # sete al
    jmp pcv_setcc
pcv_ne:
    mov rax, 0x00C0950F  # setne al
    jmp pcv_setcc
pcv_lt:
    mov rax, 0x00C09C0F  # setl al
    jmp pcv_setcc
pcv_gt:
    mov rax, 0x00C09F0F  # setg al
    jmp pcv_setcc
pcv_le:
    mov rax, 0x00C09E0F  # setle al
    jmp pcv_setcc
pcv_ge:
    mov rax, 0x00C09D0F  # setge al
pcv_setcc:
    call emit_setcc_al
    pop r8
    ret
pcv_noop:
    call emit_pop_rax    # restore left value (push/pop balanced)
    pop r8
    ret

# parse_and_value: parse_cmp_value ( && parse_cmp_value )*  — short-circuit
parse_and_value:
    call parse_cmp_value
parse_and_loop:
    call peek_tok_type
    cmp rax, 51          # ANDAND
    jne parse_and_done
    inc r11
    call emit_cmp_rax_0  # if current is 0, skip rest (stays 0)
    mov rax, 0x84        # je
    call emit_jcc
    push rax
    call parse_cmp_value
    pop rax
    call patch_rel32
    jmp parse_and_loop
parse_and_done:
    ret

# parse_or_value: parse_and_value ( || parse_and_value )*  — short-circuit
parse_or_value:
    call parse_and_value
parse_or_loop:
    call peek_tok_type
    cmp rax, 52          # OROR
    jne parse_or_done
    inc r11
    call emit_cmp_rax_0  # if current is nonzero, skip rest (stays truthy)
    mov rax, 0x85        # jne
    call emit_jcc
    push rax
    call parse_and_value
    pop rax
    call patch_rel32
    jmp parse_or_loop
parse_or_done:
    ret

# emit_condition: parse "expr OP expr", emit comparison + inverted jcc
# Returns patch offset in rax.
emit_condition:
    push r8
    push r9
    push r10
    # scan ahead: does this condition contain && or || before the matching RPAREN?
    mov r9, r11          # scan cursor
    mov r10, 0           # paren depth
emit_cond_scan:
    push rsi
    mov rsi, r15
    add rsi, 0x10000     # tok_types base
    mov rax, r9
    shl rax, 3
    add rsi, rax
    mov rax, [rsi]       # tok_types[r9]
    pop rsi
    cmp rax, 12          # EOF
    je emit_cond_simple
    cmp rax, 51          # ANDAND
    je emit_cond_bool
    cmp rax, 52          # OROR
    je emit_cond_bool
    cmp rax, 10          # LPAREN
    je emit_cond_scan_lp
    cmp rax, 11          # RPAREN
    je emit_cond_scan_rp
    inc r9
    jmp emit_cond_scan
emit_cond_scan_lp:
    inc r10
    inc r9
    jmp emit_cond_scan
emit_cond_scan_rp:
    cmp r10, 0
    je emit_cond_simple  # matching RPAREN at depth 0 — no &&/|| in this condition
    sub r10, 1
    inc r9
    jmp emit_cond_scan
emit_cond_bool:
    pop r10
    pop r9
    call parse_or_value  # materialize 0/1 (or truthy) in rax
    call emit_cmp_rax_0
    mov rax, 0x84        # je (jump if condition false)
    call emit_jcc        # returns patch offset
    pop r8
    ret
emit_cond_simple:
    pop r10
    pop r9

    # parse left expression
    call parse_expr
    call emit_push_rax

    # read comparison operator
    call peek_tok_type
    mov r8, rax          # r8 = op token type
    inc r11

    # parse right expression
    call parse_expr

    # emit: mov rcx, rax; pop rax; cmp rax, rcx
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_cmp_rax_rcx

    # emit inverted conditional jump
    # == (17) → jne (0x85)
    # != (18) → je  (0x84)
    # <  (19) → jge (0x8D)
    # >  (20) → jle (0x8E)
    # <= (21) → jg  (0x8F)
    # >= (22) → jl  (0x8C)
    cmp r8, 17
    je emit_cond_eqeq
    cmp r8, 18
    je emit_cond_neq
    cmp r8, 19
    je emit_cond_lt
    cmp r8, 20
    je emit_cond_gt
    cmp r8, 21
    je emit_cond_lte
    cmp r8, 22
    je emit_cond_gte
    jmp parse_err

emit_cond_eqeq:
    mov rax, 0x85
    jmp emit_cond_jcc
emit_cond_neq:
    mov rax, 0x84
    jmp emit_cond_jcc
emit_cond_lt:
    mov rax, 0x8D
    jmp emit_cond_jcc
emit_cond_gt:
    mov rax, 0x8E
    jmp emit_cond_jcc
emit_cond_lte:
    mov rax, 0x8F
    jmp emit_cond_jcc
emit_cond_gte:
    mov rax, 0x8C
    jmp emit_cond_jcc

emit_cond_jcc:
    call emit_jcc        # returns patch offset in rax
    pop r8
    ret

# ── Expression: term ((+|-) term)* ──
parse_expr:
    call parse_term

parse_expr_loop:
    call peek_tok_type
    cmp rax, 6           # PLUS
    je parse_expr_add
    cmp rax, 7           # MINUS
    je parse_expr_sub
    cmp rax, 27          # AMPERSAND — binary AND
    je parse_expr_band
    cmp rax, 35          # PIPE — binary OR
    je parse_expr_bor
    cmp rax, 36          # CARET — binary XOR
    je parse_expr_bxor
    ret

parse_expr_add:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_add_rax_rcx
    jmp parse_expr_loop

parse_expr_sub:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_sub_rax_rcx
    jmp parse_expr_loop

parse_expr_band:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_and_rax_rcx
    jmp parse_expr_loop

parse_expr_bor:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_or_rax_rcx
    jmp parse_expr_loop

parse_expr_bxor:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_xor_rax_rcx_op
    jmp parse_expr_loop

# ── Term: factor ((*|/) factor)* ──
parse_term:
    call parse_factor

parse_term_loop:
    call peek_tok_type
    cmp rax, 8           # STAR
    je parse_term_mul
    cmp rax, 9           # SLASH
    je parse_term_div
    cmp rax, 34          # PERCENT — modulo
    je parse_term_mod
    cmp rax, 38          # SHL — left shift
    je parse_term_shl
    cmp rax, 39          # SHR — right shift
    je parse_term_shr
    ret

parse_term_mul:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_imul_rcx
    jmp parse_term_loop

parse_term_div:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_cqo
    call emit_idiv_rcx
    jmp parse_term_loop

parse_term_mod:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_cqo
    call emit_idiv_rcx
    call emit_mov_rax_rdx   # remainder is in rdx
    jmp parse_term_loop

parse_term_shl:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax   # shift count in rcx (cl)
    call emit_pop_rax        # value to shift
    call emit_shl_rax_cl
    jmp parse_term_loop

parse_term_shr:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_shr_rax_cl
    jmp parse_term_loop

# ── Factor: NUMBER | IDENT | ( expr ) ──
# ── enum NAME { ID = INT; ... }  (v6.2.x cybs-grow brick 1) ──
# Registers each ID as an integer constant (name->value). const table:
#   0x94000 const_noffs [name offsets into tok_names]; 0x94800 const_values;
#   0x95000 const_count. (heap is zeroed by brk, so const_count starts 0.)
parse_enum_def:
    push r8
    push r9
    inc r11              # consume ENUM
    call peek_tok_type
    cmp rax, 2           # IDENT (enum name) — consumed + ignored
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 13          # LBRACE
    jne parse_err
    inc r11
parse_enum_member:
    call peek_tok_type
    cmp rax, 14          # RBRACE -> done
    je parse_enum_done
    cmp rax, 2           # IDENT (member name)
    jne parse_err
    call peek_tok_value
    mov r8, rax          # r8 = member name offset
    inc r11
    call peek_tok_type
    cmp rax, 4           # EQ
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 1           # NUM
    jne parse_err
    call peek_tok_value
    mov r9, rax          # r9 = value
    inc r11
    call peek_tok_type
    cmp rax, 5           # SEMI
    jne parse_err
    inc r11
    # register: const_noffs[count]=r8, const_values[count]=r9, count++
    push rcx
    mov rsi, r15
    add rsi, 0x95000
    mov rcx, [rsi]       # const_count
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x94000
    add rsi, rcx
    mov [rsi], r8
    pop rcx
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x94800
    add rsi, rcx
    mov [rsi], r9
    pop rcx
    inc rcx
    mov rsi, r15
    add rsi, 0x95000
    mov [rsi], rcx       # const_count++
    pop rcx
    jmp parse_enum_member
parse_enum_done:
    inc r11              # consume RBRACE
    pop r9
    pop r8
    ret

# find_const_index: rax = lookup name offset -> rax = index, or -1 if not a const.
# Mirrors find_var_index but over the const table (count at 0x95000).
find_const_index:
    push r8
    push r9
    push rcx
    mov r8, rax
    xor r9, r9
find_const_loop:
    mov rsi, r15
    add rsi, 0x95000
    mov rax, [rsi]       # const_count
    cmp r9, rax
    jge find_const_undef
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x94000
    add rsi, rcx
    mov rax, [rsi]       # const_noffs[r9]
    push r8
    push r9
    mov rdi, r15
    add rdi, 0x50000
    add rdi, rax
    mov rsi, r15
    add rsi, 0x50000
    add rsi, r8
    call strcmp
    pop r9
    pop r8
    cmp rax, 0
    je find_const_found
    inc r9
    jmp find_const_loop
find_const_found:
    mov rax, r9
    pop rcx
    pop r9
    pop r8
    ret
find_const_undef:
    mov rax, -1
    pop rcx
    pop r9
    pop r8
    ret

parse_factor:
    call peek_tok_type

    cmp rax, 1           # NUM
    je parse_factor_num
    cmp rax, 2           # IDENT
    je parse_factor_ident
    cmp rax, 10          # LPAREN
    je parse_factor_paren
    cmp rax, 27          # AMPERSAND (&var)
    je parse_factor_addr
    cmp rax, 30          # STRING
    je parse_factor_string
    cmp rax, 24          # SYSCALL
    je parse_factor_syscall
    cmp rax, 25          # LOAD8
    je parse_factor_load8
    cmp rax, 26          # STORE8
    je parse_factor_store8
    cmp rax, 60          # LOAD16
    je parse_factor_load16
    cmp rax, 61          # LOAD32
    je parse_factor_load32
    cmp rax, 62          # LOAD64
    je parse_factor_load64
    cmp rax, 63          # STORE16
    je parse_factor_store16
    cmp rax, 64          # STORE32
    je parse_factor_store32
    cmp rax, 65          # STORE64
    je parse_factor_store64
    cmp rax, 37          # TILDE (~)
    je parse_factor_bnot

    jmp parse_err

parse_factor_num:
    call peek_tok_value  # rax = number
    inc r11
    # emit: mov rax, <value>
    call emit_mov_rax_imm64
    ret

parse_factor_ident:
    push r8
    push r9
    call peek_tok_value
    mov r8, rax
    inc r11

    # check if this is a function call
    call peek_tok_type
    cmp rax, 10          # LPAREN
    je parse_factor_fn_call

    # enum const? (v6.2.x brick 1) — resolve to immediate before var-load.
    # const_count is 0 unless an enum was parsed, so this is a no-op (-> var
    # load) for existing programs (e.g. asm.cyr), keeping the seed closure intact.
    mov rax, r8
    call find_const_index
    cmp rax, -1
    je parse_factor_ident_notconst
    mov rcx, rax
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x94800     # const_values[idx]
    add rsi, rcx
    mov rax, [rsi]
    call emit_mov_rax_imm64
    pop r9
    pop r8
    ret
parse_factor_ident_notconst:

    # variable load — check in_function
    mov rsi, r15
    add rsi, 0x93818
    mov rax, [rsi]
    cmp rax, 1
    je parse_factor_ident_local

    # global variable load
    mov rax, r8
    call find_var_index
    call emit_var_load
    pop r9
    pop r8
    ret

parse_factor_ident_local:
    mov rax, r8
    call find_fn_local_index
    call emit_fn_var_load
    pop r9
    pop r8
    ret

parse_factor_fn_call:
    # function call as expression
    inc r11              # consume LPAREN
    xor r9, r9           # arg count

    call peek_tok_type
    cmp rax, 11          # RPAREN (no args)
    je parse_factor_fn_done

parse_factor_fn_arg:
    call parse_expr
    call emit_push_rax
    inc r9
    call peek_tok_type
    cmp rax, 31          # COMMA
    je parse_factor_fn_next
    cmp rax, 11          # RPAREN
    je parse_factor_fn_done
    jmp parse_err

parse_factor_fn_next:
    inc r11
    jmp parse_factor_fn_arg

parse_factor_fn_done:
    inc r11              # consume RPAREN
    mov rax, r9
    call emit_fn_call_pops
    # look up function
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    je parse_factor_fn_new
    mov r9, rax
    jmp parse_factor_fn_emit
parse_factor_fn_new:
    mov rax, r8
    call register_fn
    mov r9, rax
parse_factor_fn_emit:
    push rcx
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x92810
    add rsi, rcx
    mov rax, [rsi]
    pop rcx
    cmp rax, -1
    je parse_factor_fn_fixup
    call emit_call_to
    pop r9
    pop r8
    ret
parse_factor_fn_fixup:
    call emit_call_placeholder
    push rbx
    mov rbx, 2
    shl rbx, 56
    or rbx, r9
    call record_fixup_at
    pop rbx
    pop r9
    pop r8
    ret

parse_factor_paren:
    inc r11              # consume LPAREN
    call parse_expr
    call peek_tok_type
    cmp rax, 11          # RPAREN
    jne parse_err
    inc r11
    ret

# ── ~expr — bitwise NOT ──
parse_factor_bnot:
    inc r11              # consume ~
    call parse_factor    # operand in rax
    call emit_not_rax    # emit: not rax
    ret

# ── &var — address of variable ──
parse_factor_addr:
    push r8
    inc r11              # consume &
    call peek_tok_type
    cmp rax, 2           # IDENT
    jne parse_err
    call peek_tok_value
    mov r8, rax
    inc r11
    # check in_function
    mov rsi, r15
    add rsi, 0x93818
    mov rax, [rsi]
    cmp rax, 1
    je parse_factor_addr_local
    # global: emit absolute address via fixup
    mov rax, r8
    call find_var_index
    call emit_var_addr
    pop r8
    ret
parse_factor_addr_local:
    # local: emit lea rax, [rbp - offset]
    mov rax, r8
    call find_fn_local_index
    call emit_fn_var_addr
    pop r8
    ret

# ── String literal ──
parse_factor_string:
    push rbx
    call peek_tok_value  # rax = (offset << 16) | length
    inc r11
    # extract offset
    mov rbx, rax
    shr rbx, 16          # rbx = string_data offset
    call emit_string_addr # emit mov rax, <placeholder> with type-1 fixup
    pop rbx
    ret

# ── syscall(expr, expr, ...) ──
parse_factor_syscall:
    push r8
    inc r11              # consume SYSCALL
    # expect (
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11

    xor r8, r8           # r8 = argument count

parse_syscall_arg:
    call parse_expr
    call emit_push_rax
    inc r8

    call peek_tok_type
    cmp rax, 31          # COMMA
    je parse_syscall_next
    cmp rax, 11          # RPAREN
    je parse_syscall_done
    jmp parse_err

parse_syscall_next:
    inc r11              # consume comma
    jmp parse_syscall_arg

parse_syscall_done:
    inc r11              # consume )
    # emit pops + syscall based on arg count in r8
    mov rax, r8
    call emit_syscall_pops
    pop r8
    ret

# emit_syscall_pops: dispatch on rax (arg count), emit pop sequence + syscall
emit_syscall_pops:
    cmp rax, 1
    je emit_sc_1
    cmp rax, 2
    je emit_sc_2
    cmp rax, 3
    je emit_sc_3
    cmp rax, 4
    je emit_sc_4
    cmp rax, 5
    je emit_sc_5
    cmp rax, 6
    je emit_sc_6
    cmp rax, 7
    je emit_sc_7
    jmp parse_err

emit_sc_1:
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_2:
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_3:
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_4:
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_5:
    call emit_pop_r10
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_6:
    call emit_pop_r8
    call emit_pop_r10
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_7:
    call emit_pop_r9
    call emit_pop_r8
    call emit_pop_r10
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret

# ── load8(expr) — zero-extend byte load ──
parse_factor_load8:
    inc r11              # consume LOAD8
    call peek_tok_type
    cmp rax, 10          # LPAREN
    jne parse_err
    inc r11
    call parse_expr      # address in rax at runtime
    call peek_tok_type
    cmp rax, 11          # RPAREN
    jne parse_err
    inc r11
    call emit_load8      # emit: movzx rax, byte [rax]
    ret

# ── store8(addr, val) — byte store, returns 0 ──
parse_factor_store8:
    inc r11              # consume STORE8
    call peek_tok_type
    cmp rax, 10          # LPAREN
    jne parse_err
    inc r11
    call parse_expr      # address in rax
    call emit_push_rax   # save address
    call peek_tok_type
    cmp rax, 31          # COMMA
    jne parse_err
    inc r11
    call parse_expr      # value in rax
    # now: rax = value, stack = address
    call emit_pop_rcx    # rcx = address (from stack)
    # emit: xchg — we need address in rcx, value in al
    # Actually: pop gave us address in rcx, rax has value
    # But we need al stored via [rcx]. emit: mov byte [rcx], al
    call emit_store8_op  # emit: 88 01 (mov byte [rcx], al)
    call emit_xor_rax_rax # return 0
    call peek_tok_type
    cmp rax, 11          # RPAREN
    jne parse_err
    inc r11
    ret

# ── load/store 16/32/64 parse handlers (brick) ──
parse_factor_load64:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    call emit_load64
    ret
parse_factor_load32:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    call emit_load32
    ret
parse_factor_load16:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    call emit_load16
    ret
parse_factor_store64:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call emit_push_rax
    call peek_tok_type
    cmp rax, 31
    jne parse_err
    inc r11
    call parse_expr
    call emit_pop_rcx
    call emit_store64
    call emit_xor_rax_rax
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    ret
parse_factor_store32:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call emit_push_rax
    call peek_tok_type
    cmp rax, 31
    jne parse_err
    inc r11
    call parse_expr
    call emit_pop_rcx
    call emit_store32
    call emit_xor_rax_rax
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    ret
parse_factor_store16:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call emit_push_rax
    call peek_tok_type
    cmp rax, 31
    jne parse_err
    inc r11
    call parse_expr
    call emit_pop_rcx
    call emit_store16
    call emit_xor_rax_rax
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    ret

# ── Variable lookup ──

# find_var_index: rax = name offset in tok_names, returns var index in rax
find_var_index:
    push r8
    push r9
    push rcx
    mov r8, rax          # r8 = lookup name offset
    xor r9, r9
find_var_loop:
    cmp r9, r14
    jge find_var_undef
    # get var_noffs[r9]
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x58000
    add rsi, rcx
    mov rax, [rsi]
    # compare strings
    push r8
    push r9
    mov rdi, r15
    add rdi, 0x50000
    add rdi, rax
    mov rsi, r15
    add rsi, 0x50000
    add rsi, r8
    call strcmp
    pop r9
    pop r8
    cmp rax, 0
    je find_var_found
    inc r9
    jmp find_var_loop
find_var_found:
    mov rax, r9
    pop rcx
    pop r9
    pop r8
    ret
find_var_undef:
    mov rax, 1
    mov rdi, 2
    mov rsi, err_undef
    mov rdx, 19
    syscall
    pop rcx
    pop r9
    pop r8
    jmp sys_exit_err

parse_err:
    mov rax, 1
    mov rdi, 2
    mov rsi, err_syntax
    mov rdx, 13
    syscall
    jmp sys_exit_err

# ── Token peek helpers ──

peek_tok_type:
    push rcx
    push rsi
    mov rcx, r11
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x10000
    add rsi, rcx
    mov rax, [rsi]
    pop rsi
    pop rcx
    ret

peek_tok_value:
    push rcx
    push rsi
    mov rcx, r11
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x30000
    add rsi, rcx
    mov rax, [rsi]
    pop rsi
    pop rcx
    ret

# ================================================================
# FIXUP — patch variable addresses after codegen
# ================================================================

fixup_vars:
    push r8
    push r9
    push rcx
    push rsi
    push rbx
    push rdx
    push rdi

    # Align code size to 8
    mov rax, r13
    add rax, 7
    and rax, -8
    mov r8, rax          # r8 = aligned code size

    # data_base = 0x400078 + aligned code size
    mov r9, 0x400078
    add r9, r8           # r9 = data_base_addr

    # Compute total_var_bytes by summing var_sizes[0..r14]
    xor rdi, rdi         # rdi = total_var_bytes
    xor rcx, rcx
fixup_sum_sizes:
    cmp rcx, r14
    jge fixup_sum_done
    mov rax, rcx
    shl rax, 3
    mov rsi, r15
    add rsi, 0x58800
    add rsi, rax
    mov rax, [rsi]
    add rdi, rax
    inc rcx
    jmp fixup_sum_sizes
fixup_sum_done:
    # rdi = total_var_bytes

    # Walk fixup table
    mov rsi, r15
    add rsi, 0x92000
    mov rcx, [rsi]       # rcx = fixup count
    xor rbx, rbx         # rbx = fixup index

fixup_loop:
    cmp rbx, rcx
    jge fixup_done

    # load fixup entry: (codebuf_offset, type_and_index)
    mov rax, rbx
    shl rax, 4           # *16
    mov rsi, r15
    add rsi, 0x90000
    add rsi, rax
    push rcx
    mov rcx, [rsi]       # rcx = codebuf offset
    add rsi, 8
    mov rax, [rsi]       # rax = type_and_index

    # check type: bits 56-57
    push rdx
    mov rdx, rax
    shr rdx, 56
    cmp rdx, 1
    je fixup_string_pop
    cmp rdx, 2
    je fixup_fn_call_pop
    pop rdx
    jmp fixup_type0

fixup_string_pop:
    pop rdx
    jmp fixup_string
fixup_fn_call_pop:
    pop rdx
    jmp fixup_fn_call

fixup_type0:

    # type 0: variable address
    # Need to compute cumulative offset for var_sizes[0..index]
    push rcx
    push rbx
    mov rbx, rax         # rbx = var index
    xor rax, rax         # rax = cumulative offset
    xor rcx, rcx
fixup_var_offset:
    cmp rcx, rbx
    jge fixup_var_patch
    push rsi
    mov rsi, rcx
    shl rsi, 3
    add rsi, r15
    add rsi, 0x58800
    push rax
    mov rax, [rsi]
    mov rdx, rax
    pop rax
    add rax, rdx
    pop rsi
    inc rcx
    jmp fixup_var_offset

fixup_var_patch:
    # rax = cumulative offset to this var
    add rax, r9          # rax = data_base + var_offset = runtime address
    pop rbx
    pop rcx
    jmp fixup_write

fixup_string:
    # type 1: string address
    # index = low 56 bits = string_data offset
    push rbx
    mov rbx, rax
    mov rax, 1
    shl rax, 56
    not rax              # mask = 0x00FFFFFFFFFFFFFF
    and rbx, rax         # rbx = string offset
    # address = data_base + total_var_bytes + string_offset
    mov rax, r9
    add rax, rdi         # + total_var_bytes
    add rax, rbx         # + string_offset
    pop rbx
    jmp fixup_write

fixup_fn_call:
    # type 2: function call — patch CALL rel32
    # Extract fn_index from low bits
    push rbx
    mov rbx, rax
    mov rax, 0xFF
    shl rax, 56
    not rax              # mask low 56 bits
    and rbx, rax
    # look up fn_offsets[fn_index]
    push rcx
    mov rax, rbx
    shl rax, 3
    mov rsi, r15
    add rsi, 0x92810
    add rsi, rax
    mov rax, [rsi]       # rax = fn entry codebuf offset
    pop rcx
    pop rbx
    # compute rel32 = target - (patch_pos + 4)
    push rdx
    mov rdx, rcx
    add rdx, 4
    sub rax, rdx          # rel32
    pop rdx
    # write 4-byte rel32 (read-modify-write)
    mov rsi, r15
    add rsi, 0x59000
    add rsi, rcx
    push rdx
    mov rdx, [rsi]
    shr rdx, 32
    shl rdx, 32
    and rax, 0xFFFFFFFF
    or rax, rdx
    mov [rsi], rax
    pop rdx
    pop rcx
    inc rbx
    jmp fixup_loop

fixup_write:
    # patch codebuf at offset rcx with address in rax
    mov rsi, r15
    add rsi, 0x59000
    add rsi, rcx
    mov [rsi], rax

    pop rcx
    inc rbx
    jmp fixup_loop

fixup_done:
    # update r13 to aligned code size
    mov r13, r8
    # store total_var_bytes in rdi for emit_elf
    # Save it at a known location: 0x6A008 (data_size)
    mov rsi, r15
    add rsi, 0x6A008
    mov [rsi], rdi
    pop rdi
    pop rdx
    pop rbx
    pop rsi
    pop rcx
    pop r9
    pop r8
    ret

# ================================================================
# ELF EMITTER
# ================================================================

emit_elf:
    push rcx
    push rsi
    push rdi
    push rdx
    push rbx

    # Load total_var_bytes from data_size (set by fixup_vars)
    mov rsi, r15
    add rsi, 0x6A008
    mov rdi, [rsi]       # rdi = total_var_bytes

    # Load string_pos (total string bytes)
    mov rsi, r15
    add rsi, 0x6A000
    mov rcx, [rsi]       # rcx = string_pos

    # total file size = 120 (headers) + code_size + total_var_bytes + string_bytes
    mov rax, r13          # aligned code size
    add rax, rdi          # + var bytes
    add rax, rcx          # + string bytes
    add rax, 120
    # align total up to 8
    add rax, 7
    and rax, -8
    mov rbx, rax          # rbx = total file size

    # copy ELF template to output_buf
    push rdi
    push rcx
    mov rdi, r15
    add rdi, 0x70000
    mov rsi, elf_template
    mov rdx, 15
    call memcpy_qwords
    pop rcx
    pop rdi

    # patch p_flags to RWX
    mov rsi, r15
    add rsi, 0x70000
    add rsi, 64
    mov rax, 0x0000000700000001
    mov [rsi], rax

    # patch p_filesz
    mov rsi, r15
    add rsi, 0x70000
    add rsi, 96
    mov [rsi], rbx

    # patch p_memsz (filesz + extra page)
    mov rsi, r15
    add rsi, 0x70000
    add rsi, 104
    mov rax, rbx
    add rax, 4096
    mov [rsi], rax

    # copy codebuf to output_buf+120
    push rdi
    push rcx
    mov rdi, r15
    add rdi, 0x70000
    add rdi, 120
    mov rsi, r15
    add rsi, 0x59000
    mov rdx, r13
    add rdx, 7
    shr rdx, 3
    call memcpy_qwords
    pop rcx
    pop rdi

    # zero-fill data section (var bytes + string area) after code
    push rdi
    push rcx
    mov rsi, r15
    add rsi, 0x70000
    add rsi, 120
    add rsi, r13          # past code
    # zero total_var_bytes + string_bytes, rounded up to qwords
    mov rax, rdi
    add rax, rcx
    add rax, 7
    shr rax, 3            # qword count
    mov rcx, rax
    xor rax, rax
emit_zero_data:
    cmp rcx, 0
    je emit_zero_done
    mov [rsi], rax
    add rsi, 8
    dec rcx
    jmp emit_zero_data
emit_zero_done:
    pop rcx
    pop rdi

    # copy string_data into the generated binary's data section
    # destination = output_buf + 120 + code_size + total_var_bytes
    push rcx
    push rdi
    mov rdi, r15
    add rdi, 0x70000
    add rdi, 120
    add rdi, r13          # past code
    # rdi needs total_var_bytes added
    pop rax               # rax = rdi (total_var_bytes) — wait, stack
    push rax
    # Get total_var_bytes from saved location
    mov rsi, r15
    add rsi, 0x6A008
    mov rax, [rsi]
    add rdi, rax          # past vars

    # source = string_data at r15+0x69000
    mov rsi, r15
    add rsi, 0x69000
    # count = string_pos
    mov rsi, r15
    add rsi, 0x6A000
    mov rdx, [rsi]        # rdx = string_pos (byte count)
    # copy bytes (use qword copy, rounded up)
    mov rsi, r15
    add rsi, 0x69000
    add rdx, 7
    shr rdx, 3            # qword count
    call memcpy_qwords
    pop rdi
    pop rcx

    # set output size
    mov r13, rbx

    pop rbx
    pop rdx
    pop rdi
    pop rsi
    pop rcx
    ret

# ================================================================
# UTILITIES
# ================================================================

memcpy_qwords:
    push rcx
    push r8
    push r9
    xor rcx, rcx
memcpy_qw_loop:
    cmp rcx, rdx
    je memcpy_qw_done
    mov r8, rcx
    shl r8, 3
    mov r9, rsi
    add r9, r8
    mov rax, [r9]
    mov r9, rdi
    add r9, r8
    mov [r9], rax
    inc rcx
    jmp memcpy_qw_loop
memcpy_qw_done:
    pop r9
    pop r8
    pop rcx
    ret

strcmp:
    push rcx
    push r8
    push r9
    xor rcx, rcx
strcmp_loop:
    mov r8, rdi
    add r8, rcx
    mov rax, [r8]
    and rax, 0xFF
    mov r9, rsi
    add r9, rcx
    mov r8, [r9]
    and r8, 0xFF
    cmp rax, r8
    jne strcmp_neq
    cmp rax, 0
    je strcmp_eq
    inc rcx
    jmp strcmp_loop
strcmp_eq:
    xor rax, rax
    pop r9
    pop r8
    pop rcx
    ret
strcmp_neq:
    mov rax, 1
    pop r9
    pop r8
    pop rcx
    ret

# ================================================================
# CONSTANT DATA
# ================================================================

elf_template:
    dq 0x00010102464C457F
    dq 0x0000000000000000
    dq 0x00000001003E0002
    dq 0x0000000000400078
    dq 0x0000000000000040
    dq 0x0000000000000000
    dq 0x0038004000000000
    dq 0x0000000000400001
    dq 0x0000000500000001
    dq 0x0000000000000000
    dq 0x0000000000400000
    dq 0x0000000000400000
    dq 0x0000000000000090
    dq 0x0000000000000090
    dq 0x0000000000001000

err_syntax:
    db "syntax error\n"

err_undef:
    db "undefined variable\n"
