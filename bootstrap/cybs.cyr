    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 120          # 'x'
    je lexer_hex
    cmp rax, 88           # 'X'
    je lexer_hex
    mov rax, 48           # restore '0'
lexer_decimal:
    sub rax, 48
    mov rbx, rax
lexer_num_loop:
    inc r8
    cmp r8, r12
    jge lexer_num_done
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 48
    jl lexer_num_done
    cmp rax, 57
    jg lexer_num_done
    sub rax, 48
    mov rcx, rbx
    shl rbx, 3
    add rbx, rcx
    add rbx, rcx
    add rbx, rax
    jmp lexer_num_loop
lexer_hex:
    add r8, 2             # skip '0' and 'x'
    xor rbx, rbx
lexer_hex_loop:
    cmp r8, r12
    jge lexer_num_done
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 48
    jl lexer_num_done
    cmp rax, 57
    jg lexer_hex_alpha
    sub rax, 48
    jmp lexer_hex_accum
lexer_hex_alpha:
    cmp rax, 97
    jl lexer_hex_upper
    cmp rax, 102
    jg lexer_num_done
    sub rax, 87           # 'a'=97 → 10
    jmp lexer_hex_accum
lexer_hex_upper:
    cmp rax, 65
    jl lexer_num_done
    cmp rax, 70
    jg lexer_num_done
    sub rax, 55           # 'A'=65 → 10
lexer_hex_accum:
    shl rbx, 4
    add rbx, rax
    inc r8
    jmp lexer_hex_loop
lexer_num_done:
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1400000
    add rsi, rcx
    mov rax, 1
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x2400000
    add rsi, rcx
    mov [rsi], rbx
    inc r10
    jmp lexer_loop
lexer_ident:
    mov rbx, r9
lexer_id_loop:
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 97
    jl lexer_id_check2
    cmp rax, 122
    jle lexer_id_copy
lexer_id_check2:
    cmp rax, 48
    jl lexer_id_check3
    cmp rax, 57
    jle lexer_id_copy
lexer_id_check3:
    cmp rax, 95           # '_'
    je lexer_id_copy
    cmp rax, 65           # 'A'
    jl lexer_id_end
    cmp rax, 90           # 'Z'
    jle lexer_id_copy
    jmp lexer_id_end
lexer_id_copy:
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, r9
    mov [rsi], rax
    inc r9
    inc r8
    cmp r8, r12
    jl lexer_id_loop
lexer_id_end:
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, r9
    xor rax, rax
    mov [rsi], rax
    inc r9
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, rbx
    mov rax, [rsi]
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFF
    push rbx
    mov rbx, 0x00726176
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_var
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFF
    push rbx
    mov rbx, 0x006669
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_if
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00656C696877
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_while
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFF
    push rbx
    mov rbx, 0x0065736C65
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_else
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x006C6C6163737973
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_syscall
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00003864616F6C
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_load8
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x003865726F7473
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_store8
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFF
    push rbx
    mov rbx, 0x006E66
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_fn
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x006E7275746572
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_return
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFF
    push rbx
    mov rbx, 0x006D756E65
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_enum
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFF
    push rbx
    mov rbx, 0x000066696C65    # elif
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_elif
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFF
    push rbx
    mov rbx, 0x006D7361    # asm
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_asm
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFF
    push rbx
    mov rbx, 0x00726F66    # for
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_for
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFF
    push rbx
    mov rbx, 0x006B61657262   # break
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_break
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x65756E69746E6F63  # continue (full 8 bytes)
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_continue
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00363164616F6C   # load16
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_load16
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00323364616F6C   # load32
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_load32
    push rcx
    mov rcx, rax
    and rcx, 0xFFFFFFFFFFFFFF
    push rbx
    mov rbx, 0x00343664616F6C   # load64
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_load64
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x00363165726F7473  # store16
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_store16
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x00323365726F7473  # store32
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_store32
    push rcx
    mov rcx, rax
    push rbx
    mov rbx, 0x00343665726F7473  # store64
    cmp rcx, rbx
    pop rbx
    pop rcx
    je lexer_id_is_store64
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1400000
    add rsi, rcx
    mov rax, 2
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x2400000
    add rsi, rcx
    mov [rsi], rbx
    inc r10
    jmp lexer_loop
lexer_id_is_var:
    mov rax, 3
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_if:
    mov rax, 15
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_while:
    mov rax, 16
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_else:
    mov rax, 23
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_syscall:
    mov rax, 24
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_load8:
    mov rax, 25
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_store8:
    mov rax, 26
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_load16:
    mov rax, 60
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_load32:
    mov rax, 61
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_load64:
    mov rax, 62
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_store16:
    mov rax, 63
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_store32:
    mov rax, 64
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_store64:
    mov rax, 65
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_elif:
    mov rax, 56
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_asm:
    mov rax, 57
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_for:
    mov rax, 53
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_break:
    mov rax, 54
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_continue:
    mov rax, 55
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_fn:
    mov rax, 32
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_return:
    mov rax, 33
    call lexer_emit_kw
    jmp lexer_loop
lexer_id_is_enum:
    mov rax, 40          # ENUM keyword token (v6.2.x cybs-grow brick 1)
    call lexer_emit_kw
    jmp lexer_loop
lexer_emit_kw:
    push rax
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1400000
    add rsi, rcx
    pop rax
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x2400000
    add rsi, rcx
    xor rax, rax
    mov [rsi], rax
    inc r10
    ret
lexer_eof:
    mov rax, 12
    call lexer_emit_simple
    pop rbx
    pop rcx
    pop r9
    pop r8
    ret
skip_one_item:
    push rbx
    xor rbx, rbx         # brace depth
skip_item_loop:
    call peek_tok_type
    cmp rax, 12          # EOF
    je skip_item_done
    inc r11              # consume token
    cmp rax, 13          # LBRACE
    je skip_item_lb
    cmp rax, 14          # RBRACE
    je skip_item_rb
    cmp rax, 5           # SEMI
    je skip_item_semi
    jmp skip_item_loop
skip_item_lb:
    add rbx, 1
    jmp skip_item_loop
skip_item_rb:
    sub rbx, 1
    cmp rbx, 0
    jne skip_item_loop
    call peek_tok_type
    cmp rax, 23          # ELSE -> continue skipping its block
    je skip_item_cont
    cmp rax, 56          # ELIF
    je skip_item_cont
    jmp skip_item_done
skip_item_cont:
    inc r11
    jmp skip_item_loop
skip_item_semi:
    cmp rbx, 0
    je skip_item_done
    jmp skip_item_loop
skip_item_done:
    pop rbx
    ret
find_var_or_neg:
    push r8
    push r9
    push rcx
    push rsi
    push rdi
    mov r8, rax
    xor r9, r9
fvn_loop:
    cmp r9, r14
    jge fvn_no
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x6000000   # var_noffs
    add rsi, rcx
    mov rax, [rsi]       # var_noffs[i]
    push r8
    push r9
    push rcx
    mov rdi, r15
    add rdi, 0x3400000   # tok_names
    add rdi, r8
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, rax
    call strcmp
    pop rcx
    pop r9
    pop r8
    cmp rax, 0
    je fvn_yes
    add r9, 1
    jmp fvn_loop
fvn_yes:
    mov rax, r9
    pop rdi
    pop rsi
    pop rcx
    pop r9
    pop r8
    ret
fvn_no:
    mov rax, -1
    pop rdi
    pop rsi
    pop rcx
    pop r9
    pop r8
    ret
shallow_fn:
    push r8
    inc r11              # consume FN
    call peek_tok_value
    mov r8, rax          # name
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    jne shallow_fn_skip
    mov rax, r8
    call register_fn
shallow_fn_skip:
    inc r11              # consume IDENT
    call skip_one_item   # skip ( ) [: T] { body }
    pop r8
    ret
shallow_global:
    push r8
    push r9
    inc r11              # consume VAR
    call peek_tok_value
    mov r8, rax          # name
    inc r11              # consume IDENT
    call peek_tok_type
    cmp rax, 28          # LBRACKET (bare array)
    je shallow_g_brk
    cmp rax, 50          # COLON (typed)
    je shallow_g_col
    mov r9, 8            # scalar
    jmp shallow_g_reg
shallow_g_brk:
    inc r11              # consume [
    call peek_tok_value
    mov r9, rax          # N bytes
    jmp shallow_g_reg
shallow_g_col:
    inc r11              # consume :
    inc r11              # consume type IDENT
    call peek_tok_type
    cmp rax, 28          # typed array [N]
    je shallow_g_colarr
    mov r9, 8
    jmp shallow_g_reg
shallow_g_colarr:
    inc r11              # consume [
    call peek_tok_value
    shl rax, 3           # *8 (i64)
    mov r9, rax
shallow_g_reg:
    mov rax, r8
    call find_var_or_neg
    cmp rax, -1
    jne shallow_g_done   # already registered
    push rcx
    mov rcx, r14
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x6000000
    add rsi, rcx
    mov [rsi], r8        # var_noffs[r14] = name
    mov rax, r9
    add rax, 7
    and rax, -8
    mov rsi, r15
    add rsi, 0x6100000
    add rsi, rcx
    mov [rsi], rax       # var_sizes[r14] = aligned size
    pop rcx
    inc r14
shallow_g_done:
    call skip_one_item   # consume rest of decl to ;
    pop r9
    pop r8
    ret
parser:
    xor r11, r11
pass0_loop:
    call peek_tok_type
    cmp rax, 12          # EOF
    je pass0_done
    cmp rax, 32          # FN
    je pass0_fn
    cmp rax, 40          # ENUM
    je pass0_enum
    cmp rax, 3           # VAR
    je pass0_var
    call skip_one_item   # top-level statement -> skip (emitted in pass 2)
    jmp pass0_loop
pass0_fn:
    call shallow_fn
    jmp pass0_loop
pass0_enum:
    call parse_enum_def
    jmp pass0_loop
pass0_var:
    call shallow_global
    jmp pass0_loop
pass0_done:
    xor r11, r11
    mov rsi, r15
    add rsi, 0x7600018
    mov rax, -1
    mov [rsi], rax
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    mov rax, r13
    mov rsi, r15
    add rsi, 0x7600048
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    pop rsi
parse_fn_defs:
    call peek_tok_type
    cmp rax, 12          # EOF
    je parse_fn_defs_done
    cmp rax, 32          # FN
    je parse_fn_defs_fn
    call skip_one_item   # ENUM/VAR/statement -> skip (pass 0 registered; pass 2 emits)
    jmp parse_fn_defs
parse_fn_defs_fn:
    call parse_fn_def
    jmp parse_fn_defs
parse_fn_defs_done:
    mov rsi, r15
    add rsi, 0x7600048
    mov rax, [rsi]
    call patch_rel32
    xor r11, r11
pass2_loop:
    call peek_tok_type
    cmp rax, 12          # EOF
    je pass2_done
    cmp rax, 32          # FN
    je pass2_skip
    cmp rax, 40          # ENUM
    je pass2_skip
    call parse_statement
    jmp pass2_loop
pass2_skip:
    call skip_one_item
    jmp pass2_loop
pass2_done:
    mov rsi, r15
    add rsi, 0x7600018
    mov rax, [rsi]
    cmp rax, -1
    je parser_no_vars
    call emit_var_load
parser_no_vars:
    call emit_exit_epilogue
    ret
parse_program:
parse_prog_loop:
    call peek_tok_type
    cmp rax, 12          # EOF
    je parse_prog_done
    cmp rax, 14          # RBRACE — return to caller (if/while body)
    je parse_prog_done
    call parse_statement
    jmp parse_prog_loop
parse_prog_done:
    ret
parse_fn_def:
    push r8
    push r9
    push rbx
    inc r11              # consume FN
    call peek_tok_type
    cmp rax, 2           # IDENT
    jne parse_err
    call peek_tok_value
    mov r8, rax          # r8 = name offset
    inc r11
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    jne parse_fn_def_exists
    mov rax, r8
    call register_fn
parse_fn_def_exists:
    mov r9, rax          # r9 = fn index
    push rcx
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x7300000
    add rsi, rcx
    mov [rsi], r13
    pop rcx
    mov rsi, r15
    add rsi, 0x7600038
    mov [rsi], r14       # saved_var_count = r14
    push rsi
    mov rsi, r15
    add rsi, 0x7600018
    mov rbx, [rsi]       # save current last_var_idx
    pop rsi
    mov rsi, r15
    add rsi, 0x7600028
    mov rax, 1
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x7600030
    xor rax, rax
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x7600040
    mov [rsi], rax
    call emit_push_rbp
    call emit_mov_rbp_rsp
    xor rax, rax         # placeholder frame size = 0
    call emit_sub_rsp_imm32
    push rsi
    mov rsi, r15
    add rsi, 0x7600050
    mov [rsi], rax
    pop rsi
    call peek_tok_type
    cmp rax, 10          # LPAREN
    jne parse_err
    inc r11
    mov rsi, r15
    add rsi, 0x7600058
    xor rax, rax
    mov [rsi], rax        # param_count = 0
    call peek_tok_type
    cmp rax, 11          # RPAREN (no params)
    je parse_fn_params_done
parse_fn_param:
    call peek_tok_type
    cmp rax, 2           # IDENT
    jne parse_err
    call peek_tok_value
    mov rcx, rax          # rcx = name offset
    inc r11
    mov rsi, r15
    add rsi, 0x7600030
    mov rax, [rsi]        # rax = fn_local_count (= local var index)
    push rax
    shl rax, 3
    mov rsi, r15
    add rsi, 0x1000000
    add rsi, rax
    mov [rsi], rcx        # fn_local_names[count] = name offset
    pop rax               # rax = local index (unshifted)
    push rax              # save local index
    mov rbx, rax          # rbx = local var index for offset computation
    mov rsi, r15
    add rsi, 0x7600058
    mov rax, [rsi]        # rax = param index
    call emit_store_param
    pop rax               # restore local index
    mov rsi, r15
    add rsi, 0x7600058
    mov rcx, [rsi]
    inc rcx
    mov [rsi], rcx
    mov rsi, r15
    add rsi, 0x7600030
    mov rax, [rsi]
    inc rax
    mov [rsi], rax
    inc rdx               # param count++
    call peek_tok_type
    cmp rax, 31          # COMMA
    je parse_fn_param_next
    cmp rax, 11          # RPAREN
    je parse_fn_params_done
    jmp parse_err
parse_fn_param_next:
    inc r11              # consume comma
    jmp parse_fn_param
parse_fn_params_done:
    inc r11              # consume RPAREN
    push rcx
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x7400000
    add rsi, rcx
    push rsi
    mov rsi, r15
    add rsi, 0x7600058
    mov rax, [rsi]
    pop rsi
    mov [rsi], rax       # fn_params[r9] = param_count
    pop rcx
    call peek_tok_type
    cmp rax, 50          # COLON
    jne parse_fn_no_rettype
    inc r11              # consume COLON
    call peek_tok_type
    cmp rax, 2           # IDENT (return type name)
    jne parse_err
    inc r11              # consume type IDENT
parse_fn_no_rettype:
    call peek_tok_type
    cmp rax, 13
    jne parse_err
    inc r11
    call parse_program
    call peek_tok_type
    cmp rax, 14
    jne parse_err
    inc r11
    push rcx
    mov rsi, r15
    add rsi, 0x7600040
    mov rcx, [rsi]       # return_patch_count
    xor rax, rax
parse_fn_patch_returns:
    cmp rax, rcx
    jge parse_fn_patch_done
    push rax
    push rcx
    shl rax, 3
    mov rsi, r15
    add rsi, 0x7500000
    add rsi, rax
    mov rax, [rsi]       # return_patches[i]
    call patch_rel32
    pop rcx
    pop rax
    inc rax
    jmp parse_fn_patch_returns
parse_fn_patch_done:
    pop rcx
    call emit_leave_ret
    push rsi
    mov rsi, r15
    add rsi, 0x7600050
    mov rax, [rsi]       # frame_size_patch offset
    pop rsi
    push rsi
    mov rsi, r15
    add rsi, 0x7600030
    mov rcx, [rsi]
    shl rcx, 3            # local_count * 8
    add rcx, 15
    and rcx, -16          # align to 16
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, rax
    push rax
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rcx, 0xFFFFFFFF
    or rax, rcx
    mov [rsi], rax
    pop rax
    pop rsi
    mov rsi, r15
    add rsi, 0x7600038
    mov r14, [rsi]       # restore var count
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], rbx       # rbx was saved earlier
    mov rsi, r15
    add rsi, 0x7600028
    xor rax, rax
    mov [rsi], rax
    pop rbx
    pop r9
    pop r8
    ret
parse_statement:
    call peek_tok_type
    cmp rax, 3           # VAR
    je parse_var_stmt
    cmp rax, 2           # IDENT (reassignment or fn call)
    je parse_assign_stmt
    cmp rax, 15          # IF
    je parse_if_stmt
    cmp rax, 16          # WHILE
    je parse_while_stmt
    cmp rax, 53          # FOR
    je parse_for_stmt
    cmp rax, 57          # ASM
    je parse_asm_block
    cmp rax, 33          # RETURN
    je parse_return_stmt
    cmp rax, 54          # BREAK
    je parse_break_stmt
    cmp rax, 55          # CONTINUE
    je parse_continue_stmt
    cmp rax, 24          # SYSCALL
    je parse_expr_stmt
    cmp rax, 26          # STORE8
    je parse_expr_stmt
    cmp rax, 25          # LOAD8
    je parse_expr_stmt
    cmp rax, 60          # LOAD16
    je parse_expr_stmt
    cmp rax, 61          # LOAD32
    je parse_expr_stmt
    cmp rax, 62          # LOAD64
    je parse_expr_stmt
    cmp rax, 63          # STORE16
    je parse_expr_stmt
    cmp rax, 64          # STORE32
    je parse_expr_stmt
    cmp rax, 65          # STORE64
    je parse_expr_stmt
    jmp parse_err
parse_return_stmt:
    inc r11              # consume RETURN
    call parse_expr      # result in rax at runtime
    call peek_tok_type
    cmp rax, 5
    jne parse_err
    inc r11
    push rsi
    push rbx
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    mov rbx, r13         # patch offset
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    mov rsi, r15
    add rsi, 0x7600040
    mov rax, [rsi]       # return_patch_count
    mov rcx, rax
    shl rax, 3
    mov rsi, r15
    add rsi, 0x7500000
    add rsi, rax
    mov [rsi], rbx       # return_patches[count] = patch offset
    inc rcx
    mov rsi, r15
    add rsi, 0x7600040
    mov [rsi], rcx
    pop rbx
    pop rsi
    ret
parse_expr_stmt:
    call parse_expr
    call peek_tok_type
    cmp rax, 5
    jne parse_err
    inc r11
    ret
parse_var_stmt:
    push r8
    push r9
    inc r11              # consume VAR
    call peek_tok_type
    cmp rax, 2
    jne parse_err
    call peek_tok_value
    mov r8, rax          # r8 = name offset
    inc r11
    call peek_tok_type
    cmp rax, 50          # COLON (typed var/array — brick)
    je parse_var_typed
    cmp rax, 28          # LBRACKET (bare array)
    je parse_var_bare_array
    cmp rax, 4           # EQ
    jne parse_err
parse_var_eq:
    inc r11
    call parse_expr
parse_var_after_expr:
    push rax
    mov rsi, r15
    add rsi, 0x7600028
    mov rax, [rsi]
    cmp rax, 1
    pop rax
    je parse_var_stmt_local
    mov rax, r8
    call find_var_or_neg
    cmp rax, -1
    jne pvs_g_emit
    mov rcx, r14
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x6000000
    add rsi, rcx
    mov [rsi], r8
    mov rsi, r15
    add rsi, 0x6100000
    add rsi, rcx
    mov rax, 8
    mov [rsi], rax
    mov rax, r14
    inc r14
pvs_g_emit:
    push rax
    call emit_var_store
    pop rax
    push rsi
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], rax       # last_var_idx = slot
    pop rsi
    jmp parse_var_stmt_semi
parse_var_stmt_local:
    push rcx
    mov rax, r8
    call find_fn_local_index
    cmp rax, -1
    jne pvsl_store       # name already a local in this fn -> reuse its slot (rax = index)
    mov rsi, r15
    add rsi, 0x7600030
    mov rcx, [rsi]       # fn_local_count
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1000000
    add rsi, rcx
    mov [rsi], r8        # fn_local_names[count] = name offset
    mov rsi, r15
    add rsi, 0x7600030
    mov rcx, [rsi]
    inc rcx
    mov [rsi], rcx       # fn_local_count++
    pop rax              # rax = old count = new index
pvsl_store:
    call emit_fn_var_store
    pop rcx
parse_var_stmt_semi:
    call peek_tok_type
    cmp rax, 5
    jne parse_err
    inc r11
    pop r9
    pop r8
    ret
parse_array_decl:
    inc r11              # consume [
    call peek_tok_type
    cmp rax, 1
    jne parse_err
    call peek_tok_value
    mov r9, rax          # r9 = array size in bytes
    inc r11
    call peek_tok_type
    cmp rax, 29          # RBRACKET
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 5           # SEMI
    jne parse_err
    inc r11
    mov rcx, r14
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x6000000
    add rsi, rcx
    mov [rsi], r8
    mov rax, r9
    add rax, 7
    and rax, -8
    mov rsi, r15
    add rsi, 0x6100000
    add rsi, rcx
    mov [rsi], rax
    inc r14
    pop r9
    pop r8
    ret
parse_var_bare_array:
    mov r9, 0            # scale 0 = bare (N bytes)
    jmp parse_array_common
parse_var_typed:
    inc r11              # consume COLON
    call peek_tok_type
    cmp rax, 2           # type IDENT
    jne parse_err
    inc r11              # consume type name (ignored — cybs is untyped internally)
    call peek_tok_type
    cmp rax, 28          # [ -> typed array
    je parse_var_typed_array
    cmp rax, 4           # = -> typed scalar init
    je parse_var_eq
    cmp rax, 5           # ; -> typed scalar no-init
    je parse_var_typed_noinit
    jmp parse_err
parse_var_typed_array:
    mov r9, 1            # scale 1 = typed (N*8 bytes, i64-sized; over-alloc safe)
    jmp parse_array_common
parse_var_typed_noinit:
    call emit_xor_rax_rax   # value 0
    jmp parse_var_after_expr
parse_array_common:
    inc r11              # consume [
    call peek_tok_type
    cmp rax, 1           # NUM
    jne parse_err
    call peek_tok_value
    mov rbx, rax         # rbx = N
    inc r11
    call peek_tok_type
    cmp rax, 29          # ]
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 5           # ;
    jne parse_err
    inc r11
    cmp r9, 1
    jne parse_array_common_size
    shl rbx, 3           # typed: size = N*8
parse_array_common_size:
    mov rsi, r15
    add rsi, 0x7600028     # in_function
    mov rax, [rsi]
    cmp rax, 1
    je parse_array_common_local
    mov rcx, r14
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x6000000
    add rsi, rcx
    mov [rsi], r8
    mov rax, rbx
    add rax, 7
    and rax, -8
    mov rsi, r15
    add rsi, 0x6100000
    add rsi, rcx
    mov [rsi], rax
    inc r14
    pop r9
    pop r8
    ret
parse_array_common_local:
    call reg_local_array
    pop r9
    pop r8
    ret
reg_local_array:
    push rax
    push rcx
    push rdx
    push rsi
    push r9
    push r10
    mov rax, rbx
    add rax, 7
    shr rax, 3
    mov r10, rax         # r10 = slots
    mov rsi, r15
    add rsi, 0x7600030
    mov r9, [rsi]        # r9 = li (base local index)
    mov rcx, 0
reg_la_strlen:
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, r8
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 0
    je reg_la_strlen_done
    inc rcx
    jmp reg_la_strlen
reg_la_strlen_done:
    mov rdx, r8
    add rdx, rcx         # rdx = filler offset (name's NUL -> "")
    mov rcx, r9
    mov rax, r9
    add rax, r10
    sub rax, 1           # rax = highest index (array-name slot)
reg_la_fill:
    cmp rcx, rax
    jge reg_la_fill_done
    push rax
    mov rax, rcx
    shl rax, 3
    mov rsi, r15
    add rsi, 0x1000000
    add rsi, rax
    mov [rsi], rdx
    pop rax
    inc rcx
    jmp reg_la_fill
reg_la_fill_done:
    mov rax, r9
    add rax, r10
    sub rax, 1
    shl rax, 3
    mov rsi, r15
    add rsi, 0x1000000
    add rsi, rax
    mov [rsi], r8        # name at highest index
    mov rax, r9
    add rax, r10
    mov rsi, r15
    add rsi, 0x7600030
    mov [rsi], rax       # fn_local_count += slots
    pop r10
    pop r9
    pop rsi
    pop rdx
    pop rcx
    pop rax
    ret
parse_assign_stmt:
    push r8
    push r9
    call peek_tok_value
    mov r8, rax
    inc r11
    call peek_tok_type
    cmp rax, 10          # LPAREN
    je parse_assign_is_fn_call
    cmp rax, 4           # EQ -> plain assign
    je parse_assign_eq
    cmp rax, 6           # + -> maybe +=
    je pas_cmaybe
    cmp rax, 7           # -
    je pas_cmaybe
    cmp rax, 8           # *
    je pas_cmaybe
    cmp rax, 27          # &
    je pas_cmaybe
    cmp rax, 35          # |
    je pas_cmaybe
    cmp rax, 36          # ^
    je pas_cmaybe
    jmp parse_err
pas_cmaybe:
    mov r9, rax          # candidate op
    mov rsi, r15
    add rsi, 0x1400000   # tok_types
    mov rax, r11
    inc rax
    shl rax, 3
    add rsi, rax
    mov rax, [rsi]       # tok_types[r11+1]
    cmp rax, 4           # EQ?  (op '=' -> compound assign)
    jne parse_err
    inc r11              # consume op
    inc r11              # consume =
    # load current value of x (local-or-global)
    mov rsi, r15
    add rsi, 0x7600028
    mov rax, [rsi]
    cmp rax, 1
    je pas_cload_l
    mov rax, r8
    call find_var_index
    call emit_var_load
    jmp pas_cloaded
pas_cload_l:
    mov rax, r8
    call find_fn_local_index
    cmp rax, -1
    je pas_cload_g
    call emit_fn_var_load
    jmp pas_cloaded
pas_cload_g:
    mov rax, r8
    call find_var_index
    call emit_var_load
pas_cloaded:
    push r9              # save op across parse_expr (clobbers r9)
    call emit_push_rax   # push x
    call parse_expr      # e -> rax
    call emit_mov_rcx_rax
    call emit_pop_rax    # rax = x
    pop r9
    cmp r9, 6
    je pas_cadd
    cmp r9, 7
    je pas_csub
    cmp r9, 8
    je pas_cmul
    cmp r9, 27
    je pas_cand
    cmp r9, 35
    je pas_cor
    call emit_xor_rax_rcx_op
    jmp parse_assign_store
pas_cadd:
    call emit_add_rax_rcx
    jmp parse_assign_store
pas_csub:
    call emit_sub_rax_rcx
    jmp parse_assign_store
pas_cmul:
    call emit_imul_rcx
    jmp parse_assign_store
pas_cand:
    call emit_and_rax_rcx
    jmp parse_assign_store
pas_cor:
    call emit_or_rax_rcx
    jmp parse_assign_store
parse_assign_eq:
    inc r11
    call parse_expr
parse_assign_store:
    push rax
    mov rsi, r15
    add rsi, 0x7600028
    mov rax, [rsi]
    cmp rax, 1
    pop rax
    je parse_assign_local
    push rax
    mov rax, r8
    call find_var_index
    mov r9, rax
    pop rax
    mov rax, r9
    call emit_var_store
    push rsi
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], r9
    pop rsi
    jmp parse_assign_semi
parse_assign_local:
    push rax
    mov rax, r8
    call find_fn_local_index
    cmp rax, -1
    je pal_global
    mov r9, rax
    pop rax
    mov rax, r9
    call emit_fn_var_store
    jmp parse_assign_semi
pal_global:
    pop rax
    mov rax, r8
    call find_var_index
    mov r9, rax
    mov rax, r9
    call emit_var_store
    push rsi
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], r9
    pop rsi
    jmp parse_assign_semi
parse_assign_is_fn_call:
    inc r11              # consume LPAREN
    push rdx
    xor r9, r9           # r9 = arg count
    call peek_tok_type
    cmp rax, 11          # RPAREN (no args)
    je parse_assign_fn_call_done
parse_assign_fn_call_arg:
    call parse_expr
    call emit_push_rax
    inc r9
    call peek_tok_type
    cmp rax, 31          # COMMA
    je parse_assign_fn_call_next
    cmp rax, 11          # RPAREN
    je parse_assign_fn_call_done
    jmp parse_err
parse_assign_fn_call_next:
    inc r11
    jmp parse_assign_fn_call_arg
parse_assign_fn_call_done:
    inc r11              # consume RPAREN
    mov rax, r9
    call emit_fn_call_pops
    pop rdx
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    je parse_assign_fn_new
    mov r9, rax
    jmp parse_assign_fn_emit
parse_assign_fn_new:
    mov rax, r8
    call register_fn
    mov r9, rax
parse_assign_fn_emit:
    push rcx
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x7300000
    add rsi, rcx
    mov rax, [rsi]
    pop rcx
    cmp rax, -1
    je parse_assign_fn_fixup
    call emit_call_to
    jmp parse_assign_semi
parse_assign_fn_fixup:
    call emit_call_placeholder
    push rbx
    mov rbx, 2
    shl rbx, 56
    or rbx, r9           # type-2 | fn_index
    call record_fixup_at
    pop rbx
parse_assign_semi:
    call peek_tok_type
    cmp rax, 5
    jne parse_err
    inc r11
    pop r9
    pop r8
    ret
parse_if_stmt:
    inc r11              # consume IF
parse_if_clause:         # parse ( cond ) { body } [elif/else]; keyword consumed
    push r8
    push r9
    push rbx
    mov rsi, r15
    add rsi, 0x7600018
    mov r9, [rsi]
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call emit_condition  # returns patch offset in rax
    mov r8, rax          # r8 = condition-false patch offset
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 13
    jne parse_err
    inc r11
    call parse_program
    call peek_tok_type
    cmp rax, 14
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 56          # ELIF?
    je parse_if_elif
    cmp rax, 23          # ELSE?
    je parse_if_else
    mov rax, r8
    call patch_rel32
    jmp parse_if_done
parse_if_elif:
    call emit_jmp0
    mov rbx, rax         # rbx = skip-jmp patch
    mov rax, r8
    call patch_rel32     # cond-false -> start of elif clause
    inc r11              # consume ELIF
    call parse_if_clause # recurse: elif's ( cond ) { body } [elif/else]
    mov rax, rbx
    call patch_rel32     # skip-jmp -> end of whole chain
    jmp parse_if_done
parse_if_else:
    inc r11              # consume ELSE
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    mov rbx, r13         # rbx = patch offset for skip-else jmp
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    pop rsi
    mov rax, r8
    call patch_rel32
    call peek_tok_type
    cmp rax, 13
    jne parse_err
    inc r11
    call parse_program
    call peek_tok_type
    cmp rax, 14
    jne parse_err
    inc r11
    mov rax, rbx
    call patch_rel32
parse_if_done:
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], r9
    pop rbx
    pop r9
    pop r8
    ret
parse_while_stmt:
    push r8
    push r9
    push rbx
    inc r11              # consume WHILE
    mov rsi, r15
    add rsi, 0x7600018
    mov rbx, [rsi]
    mov r9, r13          # r9 = loop_top
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call emit_condition
    mov r8, rax          # r8 = patch offset for exit jump
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 13
    jne parse_err
    inc r11
    mov rax, r9
    call loop_push
    call parse_program
    call peek_tok_type
    cmp rax, 14
    jne parse_err
    inc r11
    mov rax, r9
    call emit_jmp_to
    mov rax, r8
    call patch_rel32
    call loop_pop
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], rbx
    pop rbx
    pop r9
    pop r8
    ret
emit_jmp0:
    push rsi
    push rbx
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    mov rbx, r13
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    mov rax, rbx
    pop rbx
    pop rsi
    ret
loop_push:
    push rcx
    push rdx
    push rsi
    mov rsi, r15
    add rsi, 0x1100000
    mov rcx, [rsi]       # sp
    mov rdx, rcx
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x1100008
    add rsi, rdx
    mov [rsi], rax       # cont_tgt[sp] = target
    mov rsi, r15
    add rsi, 0x1100108
    mov rax, [rsi]       # brk_cnt
    mov rsi, r15
    add rsi, 0x1100088
    add rsi, rdx
    mov [rsi], rax       # brk_base[sp] = brk_cnt
    inc rcx
    mov rsi, r15
    add rsi, 0x1100000
    mov [rsi], rcx       # sp++
    pop rsi
    pop rdx
    pop rcx
    ret
loop_pop:
    push rax
    push rcx
    push rdx
    push rsi
    push r8
    mov rsi, r15
    add rsi, 0x1100000
    mov rcx, [rsi]
    sub rcx, 1           # rcx = sp (innermost frame)
    mov rdx, rcx
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x1100088
    add rsi, rdx
    mov r8, [rsi]        # r8 = base (counter)
    mov rsi, r15
    add rsi, 0x1100108
    mov rdx, [rsi]       # rdx = cnt
loop_pop_patch:
    cmp r8, rdx
    jge loop_pop_done
    push rdx
    mov rdx, r8
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x1100110
    add rsi, rdx
    mov rax, [rsi]       # brk_patches[i]
    pop rdx
    push rdx
    push r8
    call patch_rel32
    pop r8
    pop rdx
    inc r8
    jmp loop_pop_patch
loop_pop_done:
    mov rdx, rcx
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x1100088
    add rsi, rdx
    mov rax, [rsi]       # base
    mov rsi, r15
    add rsi, 0x1100108
    mov [rsi], rax       # brk_cnt = base
    mov rsi, r15
    add rsi, 0x1100000
    mov [rsi], rcx       # loop_sp = sp
    pop r8
    pop rsi
    pop rdx
    pop rcx
    pop rax
    ret
emit_break:
    push rcx
    push rdx
    push rsi
    call emit_jmp0       # rax = patch
    mov rsi, r15
    add rsi, 0x1100108
    mov rcx, [rsi]       # cnt
    mov rdx, rcx
    shl rdx, 3
    mov rsi, r15
    add rsi, 0x1100110
    add rsi, rdx
    mov [rsi], rax       # brk_patches[cnt] = patch
    inc rcx
    mov rsi, r15
    add rsi, 0x1100108
    mov [rsi], rcx       # brk_cnt++
    pop rsi
    pop rdx
    pop rcx
    ret
emit_continue:
    push rax
    push rcx
    push rsi
    mov rsi, r15
    add rsi, 0x1100000
    mov rcx, [rsi]
    sub rcx, 1
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1100008
    add rsi, rcx
    mov rax, [rsi]       # cont_tgt[sp]
    call emit_jmp_to
    pop rsi
    pop rcx
    pop rax
    ret
parse_break_stmt:
    inc r11              # consume BREAK
    call emit_break
    call peek_tok_type
    cmp rax, 5           # SEMI
    jne parse_err
    inc r11
    ret
parse_continue_stmt:
    inc r11              # consume CONTINUE
    call emit_continue
    call peek_tok_type
    cmp rax, 5           # SEMI
    jne parse_err
    inc r11
    ret
asm_reg_modrm:
    push rsi
    mov rsi, r15
    add rsi, 0x3400000   # tok_names
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFFFFFF    # first 3 chars
    cmp rax, 0x786172    # rax
    je arm_rax
    cmp rax, 0x786372    # rcx
    je arm_rcx
    cmp rax, 0x786472    # rdx
    je arm_rdx
    cmp rax, 0x697372    # rsi
    je arm_rsi
    cmp rax, 0x696472    # rdi
    je arm_rdi
    jmp parse_err        # unsupported reg in asm param_load
arm_rax:
    mov rax, 0x85
    jmp arm_done
arm_rcx:
    mov rax, 0x8D
    jmp arm_done
arm_rdx:
    mov rax, 0x95
    jmp arm_done
arm_rsi:
    mov rax, 0xB5
    jmp arm_done
arm_rdi:
    mov rax, 0xBD
arm_done:
    pop rsi
    ret
parse_asm_block:
    push r8
    push r9
    inc r11              # consume ASM
    call peek_tok_type
    cmp rax, 13          # {
    jne parse_err
    inc r11
asm_blk_loop:
    call peek_tok_type
    cmp rax, 14          # }
    je asm_blk_done
    cmp rax, 1           # NUM -> raw byte
    je asm_blk_raw
    cmp rax, 2           # IDENT -> param_load(...)
    je asm_blk_pload
    jmp parse_err
asm_blk_raw:
    call peek_tok_value
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000   # codebuf
    add rsi, r13
    mov [rsi], rax
    inc r13
    pop rsi
    inc r11              # consume NUM
    call peek_tok_type
    cmp rax, 5           # ;
    jne parse_err
    inc r11
    jmp asm_blk_loop
asm_blk_pload:
    inc r11              # consume IDENT (param_load)
    call peek_tok_type
    cmp rax, 10          # (
    jne parse_err
    inc r11
    call peek_tok_value
    mov r8, rax          # reg name offset
    inc r11              # consume reg IDENT
    call peek_tok_type
    cmp rax, 31          # ,
    jne parse_err
    inc r11
    call peek_tok_value
    mov r9, rax          # idx
    inc r11              # consume NUM
    call peek_tok_type
    cmp rax, 11          # )
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 5           # ;
    jne parse_err
    inc r11
    call asm_reg_modrm   # rax = modrm (from r8)
    push rbx
    mov rbx, rax
    shl rbx, 16
    mov rax, 0x8B48
    or rax, rbx          # 0x48, 0x8B, modrm
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov [rsi], rax
    add r13, 3
    pop rsi
    pop rbx
    mov rax, r9
    add rax, 1
    shl rax, 3
    neg rax
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov [rsi], rax
    add r13, 4
    pop rsi
    jmp asm_blk_loop
asm_blk_done:
    inc r11              # consume }
    pop r9
    pop r8
    ret
parse_for_step:
    push r8
    push r9
    call peek_tok_value
    mov r8, rax
    inc r11              # consume IDENT
    call peek_tok_type
    cmp rax, 4           # EQ
    jne parse_err
    inc r11
    call parse_expr      # value -> rax
    push rax
    mov rsi, r15
    add rsi, 0x7600028     # in_function
    mov rax, [rsi]
    cmp rax, 1
    pop rax
    je parse_for_step_local
    push rax
    mov rax, r8
    call find_var_index
    mov r9, rax
    pop rax
    mov rax, r9
    call emit_var_store
    push rsi
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], r9
    pop rsi
    pop r9
    pop r8
    ret
parse_for_step_local:
    push rax
    mov rax, r8
    call find_fn_local_index
    cmp rax, -1
    je pfsl_global
    mov r9, rax
    pop rax
    mov rax, r9
    call emit_fn_var_store
    pop r9
    pop r8
    ret
pfsl_global:
    pop rax
    mov rax, r8
    call find_var_index
    mov r9, rax
    mov rax, r9
    call emit_var_store
    push rsi
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], r9
    pop rsi
    pop r9
    pop r8
    ret
parse_for_stmt:
    push r8              # r8 = exit_patch (survives body via nested push)
    push r9
    push rbx            # rbx = saved last_var_idx
    inc r11              # consume FOR
    mov rsi, r15
    add rsi, 0x7600018
    mov rbx, [rsi]
    call peek_tok_type
    cmp rax, 10          # (
    jne parse_err
    inc r11
    call parse_statement # INIT (consumes its own ;)
    mov rsi, r15
    add rsi, 0x1100B10
    mov [rsi], r13       # cp_cond = r13
    call parse_or_value  # COND -> 0/1
    call emit_cmp_rax_0
    mov rax, 0x84        # je exit
    call emit_jcc
    mov r8, rax          # exit_patch
    call peek_tok_type
    cmp rax, 5           # ;
    jne parse_err
    inc r11
    call emit_jmp0       # body_skip
    mov rsi, r15
    add rsi, 0x1100B18
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x1100B20
    mov [rsi], r13       # cp_step = r13
    call parse_for_step  # STEP (no ;)
    call peek_tok_type
    cmp rax, 11          # )
    jne parse_err
    inc r11
    mov rsi, r15
    add rsi, 0x1100B10
    mov rax, [rsi]
    call emit_jmp_to     # jmp cp_cond
    mov rsi, r15
    add rsi, 0x1100B18
    mov rax, [rsi]
    call patch_rel32     # body starts here
    call peek_tok_type
    cmp rax, 13          # {
    jne parse_err
    inc r11
    mov rsi, r15
    add rsi, 0x1100B20
    mov rax, [rsi]
    call loop_push       # continue -> cp_step
    call parse_program   # BODY
    call peek_tok_type
    cmp rax, 14          # }
    jne parse_err
    inc r11
    call emit_continue   # after body, jmp cp_step (from loop stack)
    mov rax, r8
    call patch_rel32     # patch exit
    call loop_pop        # breaks -> here
    mov rsi, r15
    add rsi, 0x7600018
    mov [rsi], rbx
    pop rbx
    pop r9
    pop r8
    ret
emit_cmp_rax_0:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x00F88348
    mov [rsi], rax
    add r13, 4
    pop rsi
    ret
emit_setcc_al:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov [rsi], rax       # setcc al (3 bytes)
    add r13, 3
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC0B60F48  # movzx rax, al
    mov [rsi], rax
    add r13, 4
    pop rsi
    ret
parse_cmp_value:
    push r8
    call parse_arith
    call peek_tok_type
    mov r8, rax
    cmp r8, 17
    je pcv_iscmp
    cmp r8, 18
    je pcv_iscmp
    cmp r8, 19
    je pcv_iscmp
    cmp r8, 20
    je pcv_iscmp
    cmp r8, 21
    je pcv_iscmp
    cmp r8, 22
    je pcv_iscmp
    jmp pcv_noop
pcv_iscmp:
    call emit_push_rax
    inc r11
    call parse_arith
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_cmp_rax_rcx
    cmp r8, 17
    je pcv_eq
    cmp r8, 18
    je pcv_ne
    cmp r8, 19
    je pcv_lt
    cmp r8, 20
    je pcv_gt
    cmp r8, 21
    je pcv_le
    jmp pcv_ge
pcv_eq:
    mov rax, 0x00C0940F  # sete al
    jmp pcv_setcc
pcv_ne:
    mov rax, 0x00C0950F  # setne al
    jmp pcv_setcc
pcv_lt:
    mov rax, 0x00C09C0F  # setl al
    jmp pcv_setcc
pcv_gt:
    mov rax, 0x00C09F0F  # setg al
    jmp pcv_setcc
pcv_le:
    mov rax, 0x00C09E0F  # setle al
    jmp pcv_setcc
pcv_ge:
    mov rax, 0x00C09D0F  # setge al
pcv_setcc:
    call emit_setcc_al
    pop r8
    ret
pcv_noop:
    pop r8
    ret
parse_and_value:
    call parse_cmp_value
parse_and_loop:
    call peek_tok_type
    cmp rax, 51          # ANDAND
    jne parse_and_done
    inc r11
    call emit_cmp_rax_0  # if current is 0, skip rest (stays 0)
    mov rax, 0x84        # je
    call emit_jcc
    push rax
    call parse_cmp_value
    pop rax
    call patch_rel32
    jmp parse_and_loop
parse_and_done:
    ret
parse_expr:
    jmp parse_or_value
parse_or_value:
    call parse_and_value
parse_or_loop:
    call peek_tok_type
    cmp rax, 52          # OROR
    jne parse_or_done
    inc r11
    call emit_cmp_rax_0  # if current is nonzero, skip rest (stays truthy)
    mov rax, 0x85        # jne
    call emit_jcc
    push rax
    call parse_and_value
    pop rax
    call patch_rel32
    jmp parse_or_loop
parse_or_done:
    ret
emit_condition:
    push r8
    push r9
    push r10
    mov r9, r11          # scan cursor
    mov r10, 0           # paren depth
emit_cond_scan:
    push rsi
    mov rsi, r15
    add rsi, 0x1400000     # tok_types base
    mov rax, r9
    shl rax, 3
    add rsi, rax
    mov rax, [rsi]       # tok_types[r9]
    pop rsi
    cmp rax, 12          # EOF
    je emit_cond_simple
    cmp rax, 51          # ANDAND
    je emit_cond_bool
    cmp rax, 52          # OROR
    je emit_cond_bool
    cmp rax, 10          # LPAREN
    je emit_cond_scan_lp
    cmp rax, 11          # RPAREN
    je emit_cond_scan_rp
    inc r9
    jmp emit_cond_scan
emit_cond_scan_lp:
    inc r10
    inc r9
    jmp emit_cond_scan
emit_cond_scan_rp:
    cmp r10, 0
    je emit_cond_simple  # matching RPAREN at depth 0 — no &&/|| in this condition
    sub r10, 1
    inc r9
    jmp emit_cond_scan
emit_cond_bool:
    pop r10
    pop r9
    call parse_or_value  # materialize 0/1 (or truthy) in rax
    call emit_cmp_rax_0
    mov rax, 0x84        # je (jump if condition false)
    call emit_jcc        # returns patch offset
    pop r8
    ret
emit_cond_simple:
    pop r10
    pop r9
    call parse_arith
    call peek_tok_type
    mov r8, rax          # r8 = op token type
    cmp r8, 17
    jl emit_cond_truthy  # no comparison op -> bare truthy condition
    cmp r8, 22
    jg emit_cond_truthy
    call emit_push_rax
    inc r11
    call parse_arith
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_cmp_rax_rcx
    cmp r8, 17
    je emit_cond_eqeq
    cmp r8, 18
    je emit_cond_neq
    cmp r8, 19
    je emit_cond_lt
    cmp r8, 20
    je emit_cond_gt
    cmp r8, 21
    je emit_cond_lte
    cmp r8, 22
    je emit_cond_gte
    jmp parse_err
emit_cond_truthy:
    call emit_cmp_rax_0
    mov rax, 0x84        # je (jump if condition false / zero)
    call emit_jcc
    pop r8
    ret
emit_cond_eqeq:
    mov rax, 0x85
    jmp emit_cond_jcc
emit_cond_neq:
    mov rax, 0x84
    jmp emit_cond_jcc
emit_cond_lt:
    mov rax, 0x8D
    jmp emit_cond_jcc
emit_cond_gt:
    mov rax, 0x8E
    jmp emit_cond_jcc
emit_cond_lte:
    mov rax, 0x8F
    jmp emit_cond_jcc
emit_cond_gte:
    mov rax, 0x8C
    jmp emit_cond_jcc
emit_cond_jcc:
    call emit_jcc        # returns patch offset in rax
    pop r8
    ret
parse_arith:
    call parse_term
parse_expr_loop:
    call peek_tok_type
    cmp rax, 6           # PLUS
    je parse_expr_add
    cmp rax, 7           # MINUS
    je parse_expr_sub
    cmp rax, 27          # AMPERSAND — binary AND
    je parse_expr_band
    cmp rax, 35          # PIPE — binary OR
    je parse_expr_bor
    cmp rax, 36          # CARET — binary XOR
    je parse_expr_bxor
    ret
parse_expr_add:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_add_rax_rcx
    jmp parse_expr_loop
parse_expr_sub:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_sub_rax_rcx
    jmp parse_expr_loop
parse_expr_band:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_and_rax_rcx
    jmp parse_expr_loop
parse_expr_bor:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_or_rax_rcx
    jmp parse_expr_loop
parse_expr_bxor:
    inc r11
    call emit_push_rax
    call parse_term
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_xor_rax_rcx_op
    jmp parse_expr_loop
parse_term:
    call parse_factor
parse_term_loop:
    call peek_tok_type
    cmp rax, 8           # STAR
    je parse_term_mul
    cmp rax, 9           # SLASH
    je parse_term_div
    cmp rax, 34          # PERCENT — modulo
    je parse_term_mod
    cmp rax, 38          # SHL — left shift
    je parse_term_shl
    cmp rax, 39          # SHR — right shift
    je parse_term_shr
    ret
parse_term_mul:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_imul_rcx
    jmp parse_term_loop
parse_term_div:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_cqo
    call emit_idiv_rcx
    jmp parse_term_loop
parse_term_mod:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_cqo
    call emit_idiv_rcx
    call emit_mov_rax_rdx   # remainder is in rdx
    jmp parse_term_loop
parse_term_shl:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax   # shift count in rcx (cl)
    call emit_pop_rax        # value to shift
    call emit_shl_rax_cl
    jmp parse_term_loop
parse_term_shr:
    inc r11
    call emit_push_rax
    call parse_factor
    call emit_mov_rcx_rax
    call emit_pop_rax
    call emit_shr_rax_cl
    jmp parse_term_loop
parse_enum_def:
    push r8
    push r9
    inc r11              # consume ENUM
    call peek_tok_type
    cmp rax, 2           # IDENT (enum name) — consumed + ignored
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 13          # LBRACE
    jne parse_err
    inc r11
parse_enum_member:
    call peek_tok_type
    cmp rax, 14          # RBRACE -> done
    je parse_enum_done
    cmp rax, 2           # IDENT (member name)
    jne parse_err
    call peek_tok_value
    mov r8, rax          # r8 = member name offset
    inc r11
    call peek_tok_type
    cmp rax, 4           # EQ
    jne parse_err
    inc r11
    call peek_tok_type
    cmp rax, 1           # NUM
    jne parse_err
    call peek_tok_value
    mov r9, rax          # r9 = value
    inc r11
    call peek_tok_type
    cmp rax, 5           # SEMI
    jne parse_err
    inc r11
    push rcx
    mov rsi, r15
    add rsi, 0x1201000
    mov rcx, [rsi]       # const_count
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1200000
    add rsi, rcx
    mov [rsi], r8
    pop rcx
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1200800
    add rsi, rcx
    mov [rsi], r9
    pop rcx
    inc rcx
    mov rsi, r15
    add rsi, 0x1201000
    mov [rsi], rcx       # const_count++
    pop rcx
    jmp parse_enum_member
parse_enum_done:
    inc r11              # consume RBRACE
    pop r9
    pop r8
    ret
find_const_index:
    push r8
    push r9
    push rcx
    mov r8, rax
    xor r9, r9
find_const_loop:
    mov rsi, r15
    add rsi, 0x1201000
    mov rax, [rsi]       # const_count
    cmp r9, rax
    jge find_const_undef
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1200000
    add rsi, rcx
    mov rax, [rsi]       # const_noffs[r9]
    push r8
    push r9
    mov rdi, r15
    add rdi, 0x3400000
    add rdi, rax
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, r8
    call strcmp
    pop r9
    pop r8
    cmp rax, 0
    je find_const_found
    inc r9
    jmp find_const_loop
find_const_found:
    mov rax, r9
    pop rcx
    pop r9
    pop r8
    ret
find_const_undef:
    mov rax, -1
    pop rcx
    pop r9
    pop r8
    ret
parse_factor:
    call peek_tok_type
    cmp rax, 1           # NUM
    je parse_factor_num
    cmp rax, 2           # IDENT
    je parse_factor_ident
    cmp rax, 10          # LPAREN
    je parse_factor_paren
    cmp rax, 27          # AMPERSAND (&var)
    je parse_factor_addr
    cmp rax, 30          # STRING
    je parse_factor_string
    cmp rax, 24          # SYSCALL
    je parse_factor_syscall
    cmp rax, 25          # LOAD8
    je parse_factor_load8
    cmp rax, 26          # STORE8
    je parse_factor_store8
    cmp rax, 60          # LOAD16
    je parse_factor_load16
    cmp rax, 61          # LOAD32
    je parse_factor_load32
    cmp rax, 62          # LOAD64
    je parse_factor_load64
    cmp rax, 63          # STORE16
    je parse_factor_store16
    cmp rax, 64          # STORE32
    je parse_factor_store32
    cmp rax, 65          # STORE64
    je parse_factor_store64
    cmp rax, 37          # TILDE (~)
    je parse_factor_bnot
    jmp parse_err
parse_factor_num:
    call peek_tok_value  # rax = number
    inc r11
    call emit_mov_rax_imm64
    ret
parse_factor_ident:
    push r8
    push r9
    call peek_tok_value
    mov r8, rax
    inc r11
    call peek_tok_type
    cmp rax, 10          # LPAREN
    je parse_factor_fn_call
    mov rax, r8
    call find_const_index
    cmp rax, -1
    je parse_factor_ident_notconst
    mov rcx, rax
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1200800     # const_values[idx]
    add rsi, rcx
    mov rax, [rsi]
    call emit_mov_rax_imm64
    pop r9
    pop r8
    ret
parse_factor_ident_notconst:
    mov rsi, r15
    add rsi, 0x7600028
    mov rax, [rsi]
    cmp rax, 1
    je parse_factor_ident_local
    mov rax, r8
    call find_var_index
    call emit_var_load
    pop r9
    pop r8
    ret
parse_factor_ident_local:
    mov rax, r8
    call find_fn_local_index
    cmp rax, -1
    je pfil_global
    call emit_fn_var_load
    pop r9
    pop r8
    ret
pfil_global:
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    je pfil_var
    call emit_fn_addr
    pop r9
    pop r8
    ret
pfil_var:
    mov rax, r8
    call find_var_index
    call emit_var_load
    pop r9
    pop r8
    ret
parse_factor_fn_call:
    inc r11              # consume LPAREN
    xor r9, r9           # arg count
    call peek_tok_type
    cmp rax, 11          # RPAREN (no args)
    je parse_factor_fn_done
parse_factor_fn_arg:
    call parse_expr
    call emit_push_rax
    inc r9
    call peek_tok_type
    cmp rax, 31          # COMMA
    je parse_factor_fn_next
    cmp rax, 11          # RPAREN
    je parse_factor_fn_done
    jmp parse_err
parse_factor_fn_next:
    inc r11
    jmp parse_factor_fn_arg
parse_factor_fn_done:
    inc r11              # consume RPAREN
    mov rax, r9
    call emit_fn_call_pops
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    je parse_factor_fn_new
    mov r9, rax
    jmp parse_factor_fn_emit
parse_factor_fn_new:
    # not a registered fn -> r8 is a fn-pointer variable; load it + call rax.
    # (3-pass registers every real fn in pass 0, so a miss here is a variable.)
    mov rsi, r15
    add rsi, 0x7600028   # in_function
    mov rax, [rsi]
    cmp rax, 1
    je pffn_local
    mov rax, r8
    call find_var_index
    call emit_var_load
    jmp pffn_callrax
pffn_local:
    mov rax, r8
    call find_fn_local_index
    cmp rax, -1
    je pffn_local_g
    call emit_fn_var_load
    jmp pffn_callrax
pffn_local_g:
    mov rax, r8
    call find_var_index
    call emit_var_load
pffn_callrax:
    call emit_call_rax
    pop r9
    pop r8
    ret
parse_factor_fn_emit:
    push rcx
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x7300000
    add rsi, rcx
    mov rax, [rsi]
    pop rcx
    cmp rax, -1
    je parse_factor_fn_fixup
    call emit_call_to
    pop r9
    pop r8
    ret
parse_factor_fn_fixup:
    call emit_call_placeholder
    push rbx
    mov rbx, 2
    shl rbx, 56
    or rbx, r9
    call record_fixup_at
    pop rbx
    pop r9
    pop r8
    ret
parse_factor_paren:
    inc r11              # consume LPAREN
    call parse_or_value  # full boolean/comparison expr (handles (a>=b), (x&&y))
    call peek_tok_type
    cmp rax, 11          # RPAREN
    jne parse_err
    inc r11
    ret
parse_factor_bnot:
    inc r11              # consume ~
    call parse_factor    # operand in rax
    call emit_not_rax    # emit: not rax
    ret
parse_factor_addr:
    push r8
    inc r11              # consume &
    call peek_tok_type
    cmp rax, 2           # IDENT
    jne parse_err
    call peek_tok_value
    mov r8, rax
    inc r11
    mov rsi, r15
    add rsi, 0x7600028
    mov rax, [rsi]
    cmp rax, 1
    je parse_factor_addr_local
    mov rax, r8
    call find_var_index
    call emit_var_addr
    pop r8
    ret
parse_factor_addr_local:
    mov rax, r8
    call find_fn_local_index
    cmp rax, -1
    je pfal_global
    call emit_fn_var_addr
    pop r8
    ret
pfal_global:
    mov rax, r8
    call find_fn_index
    cmp rax, -1
    je pfal_var
    call emit_fn_addr
    pop r8
    ret
pfal_var:
    mov rax, r8
    call find_var_index
    call emit_var_addr
    pop r8
    ret
parse_factor_string:
    push rbx
    call peek_tok_value  # rax = (offset << 16) | length
    inc r11
    mov rbx, rax
    shr rbx, 16          # rbx = string_data offset
    call emit_string_addr # emit mov rax, <placeholder> with type-1 fixup
    pop rbx
    ret
parse_factor_syscall:
    push r8
    inc r11              # consume SYSCALL
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    xor r8, r8           # r8 = argument count
parse_syscall_arg:
    call parse_expr
    call emit_push_rax
    inc r8
    call peek_tok_type
    cmp rax, 31          # COMMA
    je parse_syscall_next
    cmp rax, 11          # RPAREN
    je parse_syscall_done
    jmp parse_err
parse_syscall_next:
    inc r11              # consume comma
    jmp parse_syscall_arg
parse_syscall_done:
    inc r11              # consume )
    mov rax, r8
    call emit_syscall_pops
    pop r8
    ret
emit_syscall_pops:
    cmp rax, 1
    je emit_sc_1
    cmp rax, 2
    je emit_sc_2
    cmp rax, 3
    je emit_sc_3
    cmp rax, 4
    je emit_sc_4
    cmp rax, 5
    je emit_sc_5
    cmp rax, 6
    je emit_sc_6
    cmp rax, 7
    je emit_sc_7
    jmp parse_err
emit_sc_1:
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_2:
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_3:
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_4:
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_5:
    call emit_pop_r10
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_6:
    call emit_pop_r8
    call emit_pop_r10
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
emit_sc_7:
    call emit_pop_r9
    call emit_pop_r8
    call emit_pop_r10
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    call emit_pop_rax
    call emit_syscall
    ret
parse_factor_load8:
    inc r11              # consume LOAD8
    call peek_tok_type
    cmp rax, 10          # LPAREN
    jne parse_err
    inc r11
    call parse_expr      # address in rax at runtime
    call peek_tok_type
    cmp rax, 11          # RPAREN
    jne parse_err
    inc r11
    call emit_load8      # emit: movzx rax, byte [rax]
    ret
parse_factor_store8:
    inc r11              # consume STORE8
    call peek_tok_type
    cmp rax, 10          # LPAREN
    jne parse_err
    inc r11
    call parse_expr      # address in rax
    call emit_push_rax   # save address
    call peek_tok_type
    cmp rax, 31          # COMMA
    jne parse_err
    inc r11
    call parse_expr      # value in rax
    call emit_pop_rcx    # rcx = address (from stack)
    call emit_store8_op  # emit: 88 01 (mov byte [rcx], al)
    call emit_xor_rax_rax # return 0
    call peek_tok_type
    cmp rax, 11          # RPAREN
    jne parse_err
    inc r11
    ret
parse_factor_load64:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    call emit_load64
    ret
parse_factor_load32:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    call emit_load32
    ret
parse_factor_load16:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    call emit_load16
    ret
parse_factor_store64:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call emit_push_rax
    call peek_tok_type
    cmp rax, 31
    jne parse_err
    inc r11
    call parse_expr
    call emit_pop_rcx
    call emit_store64
    call emit_xor_rax_rax
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    ret
parse_factor_store32:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call emit_push_rax
    call peek_tok_type
    cmp rax, 31
    jne parse_err
    inc r11
    call parse_expr
    call emit_pop_rcx
    call emit_store32
    call emit_xor_rax_rax
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    ret
parse_factor_store16:
    inc r11
    call peek_tok_type
    cmp rax, 10
    jne parse_err
    inc r11
    call parse_expr
    call emit_push_rax
    call peek_tok_type
    cmp rax, 31
    jne parse_err
    inc r11
    call parse_expr
    call emit_pop_rcx
    call emit_store16
    call emit_xor_rax_rax
    call peek_tok_type
    cmp rax, 11
    jne parse_err
    inc r11
    ret
find_var_index:
    push r8
    push r9
    push rcx
    mov r8, rax          # r8 = lookup name offset
    xor r9, r9
find_var_loop:
    cmp r9, r14
    jge find_var_undef
    mov rcx, r9
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x6000000
    add rsi, rcx
    mov rax, [rsi]
    push r8
    push r9
    mov rdi, r15
    add rdi, 0x3400000
    add rdi, rax
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, r8
    call strcmp
    pop r9
    pop r8
    cmp rax, 0
    je find_var_found
    inc r9
    jmp find_var_loop
find_var_found:
    mov rax, r9
    pop rcx
    pop r9
    pop r8
    ret
find_var_undef:
    mov rdi, r15
    add rdi, 0x3400000
    add rdi, r8
    call dbg_write_str
    mov rax, 1
    mov rdi, 2
    mov rsi, err_undef
    mov rdx, 19
    syscall
    pop rcx
    pop r9
    pop r8
    jmp sys_exit_err
parse_err:
    push r8
    push r9
    mov r9, r11
    sub r9, 40
    cmp r9, 0
    jge perr_dbg_loop
    xor r9, r9
perr_dbg_loop:
    cmp r9, r11
    jg perr_dbg_done
    mov rsi, r15
    add rsi, 0x1400000   # tok_types
    mov rax, r9
    shl rax, 3
    add rsi, rax
    mov rax, [rsi]
    cmp rax, 2           # IDENT
    je perr_dbg_name
    cmp rax, 30          # STRING
    je perr_dbg_name
    jmp perr_dbg_next
perr_dbg_name:
    mov rsi, r15
    add rsi, 0x2400000   # tok_values
    mov rax, r9
    shl rax, 3
    add rsi, rax
    mov r8, [rsi]        # name offset
    mov rdi, r15
    add rdi, 0x3400000
    add rdi, r8
    call dbg_write_str
perr_dbg_next:
    inc r9
    jmp perr_dbg_loop
perr_dbg_done:
    pop r9
    pop r8
    mov rax, r11
    call dbg_raw8        # cursor r11
    mov rsi, r15
    add rsi, 0x1400000
    mov rax, r11
    shl rax, 3
    add rsi, rax
    mov rax, [rsi]
    call dbg_raw8        # tok_types[r11]
    mov rax, r12
    call dbg_raw8        # input length r12
    mov rax, r10
    call dbg_raw8        # token count r10
    mov rax, 1
    mov rdi, 2
    mov rsi, err_syntax
    mov rdx, 13
    syscall
    jmp sys_exit_err
dbg_raw8:
    push rsi
    push rdi
    push rdx
    push rcx
    push r11
    mov rsi, r15
    add rsi, 0x7700020
    mov [rsi], rax
    mov rax, 1
    mov rdi, 2
    mov rdx, 8
    syscall
    pop r11
    pop rcx
    pop rdx
    pop rdi
    pop rsi
    ret

dbg_write_str:
    push rax
    push rdi
    push rsi
    push rdx
    push rcx
    push r11
    xor rdx, rdx
dws_len:
    mov rsi, rdi
    add rsi, rdx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 0
    je dws_write
    add rdx, 1
    jmp dws_len
dws_write:
    mov rsi, rdi
    mov rax, 1
    mov rdi, 2
    syscall
    mov rax, 1
    mov rdi, 2
    mov rsi, dbg_space
    mov rdx, 1
    syscall
    pop r11
    pop rcx
    pop rdx
    pop rsi
    pop rdi
    pop rax
    ret
peek_tok_type:
    push rcx
    push rsi
    mov rcx, r11
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1400000
    add rsi, rcx
    mov rax, [rsi]
    pop rsi
    pop rcx
    ret
peek_tok_value:
    push rcx
    push rsi
    mov rcx, r11
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x2400000
    add rsi, rcx
    mov rax, [rsi]
    pop rsi
    pop rcx
    ret
fixup_vars:
    push r8
    push r9
    push rcx
    push rsi
    push rbx
    push rdx
    push rdi
    mov rax, r13
    add rax, 7
    and rax, -8
    mov r8, rax          # r8 = aligned code size
    mov r9, 0x400078
    add r9, r8           # r9 = data_base_addr
    xor rdi, rdi         # rdi = total_var_bytes
    xor rcx, rcx
fixup_sum_sizes:
    cmp rcx, r14
    jge fixup_sum_done
    mov rax, rcx
    shl rax, 3
    mov rsi, r15
    add rsi, 0x6100000
    add rsi, rax
    mov rax, [rsi]
    add rdi, rax
    inc rcx
    jmp fixup_sum_sizes
fixup_sum_done:
    mov rsi, r15
    add rsi, 0x7600010
    mov rcx, [rsi]       # rcx = fixup count
    xor rbx, rbx         # rbx = fixup index
fixup_loop:
    cmp rbx, rcx
    jge fixup_done
    mov rax, rbx
    shl rax, 4           # *16
    mov rsi, r15
    add rsi, 0x6200000
    add rsi, rax
    push rcx
    mov rcx, [rsi]       # rcx = codebuf offset
    add rsi, 8
    mov rax, [rsi]       # rax = type_and_index
    push rdx
    mov rdx, rax
    shr rdx, 56
    cmp rdx, 1
    je fixup_string_pop
    cmp rdx, 2
    je fixup_fn_call_pop
    cmp rdx, 3
    je fixup_fn_addr_pop
    pop rdx
    jmp fixup_type0
fixup_string_pop:
    pop rdx
    jmp fixup_string
fixup_fn_call_pop:
    pop rdx
    jmp fixup_fn_call
fixup_fn_addr_pop:
    pop rdx
    jmp fixup_fn_addr
fixup_type0:
    push rcx
    push rbx
    mov rbx, rax         # rbx = var index
    xor rax, rax         # rax = cumulative offset
    xor rcx, rcx
fixup_var_offset:
    cmp rcx, rbx
    jge fixup_var_patch
    push rsi
    mov rsi, rcx
    shl rsi, 3
    add rsi, r15
    add rsi, 0x6100000
    push rax
    mov rax, [rsi]
    mov rdx, rax
    pop rax
    add rax, rdx
    pop rsi
    inc rcx
    jmp fixup_var_offset
fixup_var_patch:
    add rax, r9          # rax = data_base + var_offset = runtime address
    pop rbx
    pop rcx
    jmp fixup_write
fixup_string:
    push rbx
    mov rbx, rax
    mov rax, 1
    shl rax, 56
    not rax              # mask = 0x00FFFFFFFFFFFFFF
    and rbx, rax         # rbx = string offset
    mov rax, r9
    add rax, rdi         # + total_var_bytes
    add rax, rbx         # + string_offset
    pop rbx
    jmp fixup_write
fixup_fn_call:
    push rbx
    mov rbx, rax
    mov rax, 0xFF
    shl rax, 56
    not rax              # mask low 56 bits
    and rbx, rax
    push rcx
    mov rax, rbx
    shl rax, 3
    mov rsi, r15
    add rsi, 0x7300000
    add rsi, rax
    mov rax, [rsi]       # rax = fn entry codebuf offset
    pop rcx
    pop rbx
    push rdx
    mov rdx, rcx
    add rdx, 4
    sub rax, rdx          # rel32
    pop rdx
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, rcx
    push rdx
    mov rdx, [rsi]
    shr rdx, 32
    shl rdx, 32
    and rax, 0xFFFFFFFF
    or rax, rdx
    mov [rsi], rax
    pop rdx
    pop rcx
    inc rbx
    jmp fixup_loop
fixup_fn_addr:
    push rbx
    mov rbx, rax
    mov rax, 0xFF
    shl rax, 56
    not rax
    and rbx, rax         # rbx = fn index
    mov rax, rbx
    shl rax, 3
    mov rsi, r15
    add rsi, 0x7300000   # fn_offsets
    add rsi, rax
    mov rax, [rsi]       # fn entry codebuf offset
    add rax, 0x400078    # + code base vaddr -> absolute fn address
    pop rbx
    jmp fixup_write
fixup_write:
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, rcx
    mov [rsi], rax
    pop rcx
    inc rbx
    jmp fixup_loop
fixup_done:
    mov r13, r8
    mov rsi, r15
    add rsi, 0x7600008
    mov [rsi], rdi
    pop rdi
    pop rdx
    pop rbx
    pop rsi
    pop rcx
    pop r9
    pop r8
    ret
emit_elf:
    push rcx
    push rsi
    push rdi
    push rdx
    push rbx
    mov rsi, r15
    add rsi, 0x7600008
    mov rdi, [rsi]       # rdi = total_var_bytes
    mov rsi, r15
    add rsi, 0x7600000
    mov rcx, [rsi]       # rcx = string_pos
    mov rax, r13          # aligned code size
    add rax, rdi          # + var bytes
    add rax, rcx          # + string bytes
    add rax, 120
    add rax, 7
    and rax, -8
    mov rbx, rax          # rbx = total file size
    push rdi
    push rcx
    mov rdi, r15
    add rdi, 0x4C00000
    mov rsi, elf_template
    mov rdx, 15
    call memcpy_qwords
    pop rcx
    pop rdi
    mov rsi, r15
    add rsi, 0x4C00000
    add rsi, 64
    mov rax, 0x0000000700000001
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x4C00000
    add rsi, 96
    mov [rsi], rbx
    mov rsi, r15
    add rsi, 0x4C00000
    add rsi, 104
    mov rax, rbx
    add rax, 4096
    mov [rsi], rax
    push rdi
    push rcx
    mov rdi, r15
    add rdi, 0x4C00000
    add rdi, 120
    mov rsi, r15
    add rsi, 0x3C00000
    mov rdx, r13
    add rdx, 7
    shr rdx, 3
    call memcpy_qwords
    pop rcx
    pop rdi
    push rdi
    push rcx
    mov rsi, r15
    add rsi, 0x4C00000
    add rsi, 120
    add rsi, r13          # past code
    mov rax, rdi
    add rax, rcx
    add rax, 7
    shr rax, 3            # qword count
    mov rcx, rax
    xor rax, rax
emit_zero_data:
    cmp rcx, 0
    je emit_zero_done
    mov [rsi], rax
    add rsi, 8
    dec rcx
    jmp emit_zero_data
emit_zero_done:
    pop rcx
    pop rdi
    push rcx
    push rdi
    mov rdi, r15
    add rdi, 0x4C00000
    add rdi, 120
    add rdi, r13          # past code
    pop rax               # rax = rdi (total_var_bytes) — wait, stack
    push rax
    mov rsi, r15
    add rsi, 0x7600008
    mov rax, [rsi]
    add rdi, rax          # past vars
    mov rsi, r15
    add rsi, 0x5C00000
    mov rsi, r15
    add rsi, 0x7600000
    mov rdx, [rsi]        # rdx = string_pos (byte count)
    mov rsi, r15
    add rsi, 0x5C00000
    add rdx, 7
    shr rdx, 3            # qword count
    call memcpy_qwords
    pop rdi
    pop rcx
    mov r13, rbx
    pop rbx
    pop rdx
    pop rdi
    pop rsi
    pop rcx
    ret
memcpy_qwords:
    push rcx
    push r8
    push r9
    xor rcx, rcx
memcpy_qw_loop:
    cmp rcx, rdx
    je memcpy_qw_done
    mov r8, rcx
    shl r8, 3
    mov r9, rsi
    add r9, r8
    mov rax, [r9]
    mov r9, rdi
    add r9, r8
    mov [r9], rax
    inc rcx
    jmp memcpy_qw_loop
memcpy_qw_done:
    pop r9
    pop r8
    pop rcx
    ret
strcmp:
    push rcx
    push r8
    push r9
    xor rcx, rcx
strcmp_loop:
    mov r8, rdi
    add r8, rcx
    mov rax, [r8]
    and rax, 0xFF
    mov r9, rsi
    add r9, rcx
    mov r8, [r9]
    and r8, 0xFF
    cmp rax, r8
    jne strcmp_neq
    cmp rax, 0
    je strcmp_eq
    inc rcx
    jmp strcmp_loop
strcmp_eq:
    xor rax, rax
    pop r9
    pop r8
    pop rcx
    ret
strcmp_neq:
    mov rax, 1
    pop r9
    pop r8
    pop rcx
    ret
pp_match:
    push rdi
    push rsi
    push rdx
    push rbx
pp_match_loop:
    cmp rdx, 0
    je pp_match_yes
    mov rax, [rdi]
    and rax, 0xFF
    mov rbx, [rsi]
    and rbx, 0xFF
    cmp rax, rbx
    jne pp_match_no
    add rdi, 1
    add rsi, 1
    sub rdx, 1
    jmp pp_match_loop
pp_match_yes:
    mov rax, 1
    jmp pp_match_end
pp_match_no:
    xor rax, rax
pp_match_end:
    pop rbx
    pop rdx
    pop rsi
    pop rdi
    ret
pp_defined:
    push rsi
    mov rsi, rdi
    add rsi, 7
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 65          # 'A' -> CYRIUS_ARCH_...
    je pp_def_arch
    cmp rax, 84          # 'T' -> CYRIUS_TARGET_...
    je pp_def_target
    xor rax, rax
    pop rsi
    ret
pp_def_arch:
    mov rsi, rdi
    add rsi, 12
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 88          # 'X' -> ARCH_X86
    je pp_def_yes
    xor rax, rax
    pop rsi
    ret
pp_def_target:
    mov rsi, rdi
    add rsi, 14
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 76          # 'L' -> TARGET_LINUX
    je pp_def_yes
    xor rax, rax
    pop rsi
    ret
pp_def_yes:
    mov rax, 1
    pop rsi
    ret
pp_cond_push:
    push rsi
    push rbx
    push rdx
    mov rsi, r15
    add rsi, 0x7700010
    mov rbx, [rsi]       # sp = cond_depth
    mov rsi, r15
    add rsi, 0x7700018
    mov rdx, [rsi]       # emit
    mov rsi, r15
    add rsi, 0x7740000
    mov rax, rbx
    shl rax, 3
    add rsi, rax
    mov [rsi], rdx       # saved[sp] = emit
    mov rsi, r15
    add rsi, 0x7748000
    mov rax, rbx
    shl rax, 3
    add rsi, rax
    mov [rsi], rdi       # cond[sp] = cond
    cmp rdi, 0
    jne pp_cpush_skip
    mov rsi, r15
    add rsi, 0x7700018
    xor rax, rax
    mov [rsi], rax       # emit = 0
pp_cpush_skip:
    mov rsi, r15
    add rsi, 0x7700010
    add rbx, 1
    mov [rsi], rbx       # cond_depth = sp+1
    pop rdx
    pop rbx
    pop rsi
    ret
pp_cond_else:
    push rsi
    push rbx
    push rdx
    push rcx
    mov rsi, r15
    add rsi, 0x7700010
    mov rbx, [rsi]
    sub rbx, 1           # sp
    mov rsi, r15
    add rsi, 0x7740000
    mov rax, rbx
    shl rax, 3
    add rsi, rax
    mov rdx, [rsi]       # saved
    mov rsi, r15
    add rsi, 0x7748000
    mov rax, rbx
    shl rax, 3
    add rsi, rax
    mov rcx, [rsi]       # cond
    xor rax, rax         # emit default 0
    cmp rdx, 1
    jne pp_celse_set
    cmp rcx, 0
    jne pp_celse_set
    mov rax, 1
pp_celse_set:
    mov rsi, r15
    add rsi, 0x7700018
    mov [rsi], rax
    pop rcx
    pop rdx
    pop rbx
    pop rsi
    ret
pp_cond_pop:
    push rsi
    push rbx
    mov rsi, r15
    add rsi, 0x7700010
    mov rbx, [rsi]
    sub rbx, 1
    mov rsi, r15
    add rsi, 0x7740000
    mov rax, rbx
    shl rax, 3
    add rsi, rax
    mov rax, [rsi]
    mov rsi, r15
    add rsi, 0x7700018
    mov [rsi], rax       # emit = saved[sp]
    mov rsi, r15
    add rsi, 0x7700010
    mov [rsi], rbx       # cond_depth = sp
    pop rbx
    pop rsi
    ret
pp_seen:
    push rcx
    push rdx
    push rsi
    push rdi
    mov rsi, r15
    add rsi, 0x7700008
    mov rcx, [rsi]       # once_count
    xor rdx, rdx
pp_seen_loop:
    cmp rdx, rcx
    jge pp_seen_no
    mov rsi, r15
    add rsi, 0x7710000
    mov rax, rdx
    shl rax, 8           # *256
    add rsi, rax         # entry addr
    push rcx
    push rdx
    push rdi
    push rsi
    call strcmp          # rdi=fname, rsi=entry -> rax 0 if equal
    pop rsi
    pop rdi
    pop rdx
    pop rcx
    cmp rax, 0
    je pp_seen_yes
    add rdx, 1
    jmp pp_seen_loop
pp_seen_no:
    xor rax, rax
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    ret
pp_seen_yes:
    mov rax, 1
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    ret
pp_mark:
    push rcx
    push rdx
    push rsi
    push rdi
    push r8
    mov rsi, r15
    add rsi, 0x7700008
    mov rcx, [rsi]       # once_count
    mov rsi, r15
    add rsi, 0x7710000
    mov rax, rcx
    shl rax, 8
    add rsi, rax         # dest entry
    xor rdx, rdx         # i
pp_mark_loop:
    mov r8, rdi
    add r8, rdx
    mov rax, [r8]
    and rax, 0xFF
    cmp rax, 0
    je pp_mark_done
    mov r8, rsi
    add r8, rdx
    mov [r8], rax
    add rdx, 1
    jmp pp_mark_loop
pp_mark_done:
    mov r8, rsi
    add r8, rdx
    xor rax, rax
    mov [r8], rax        # NUL
    add rcx, 1
    mov rsi, r15
    add rsi, 0x7700008
    mov [rsi], rcx       # once_count++
    pop r8
    pop rdi
    pop rsi
    pop rdx
    pop rcx
    ret
pp_readfile:
    push rbx
    push r8
    push r9
    push rsi
    mov rax, 2           # SYS_OPEN
    mov rsi, 0           # O_RDONLY
    mov rdx, 0
    syscall
    pop rsi
    cmp rax, 0
    jl pp_rf_fail
    mov rbx, rax         # fd
    mov r8, rsi          # dest
    xor r9, r9           # total
pp_rf_loop:
    mov rax, 0           # SYS_READ
    mov rdi, rbx
    mov rsi, r8
    add rsi, r9
    mov rdx, 0x100000
    syscall
    cmp rax, 0
    jle pp_rf_eof
    add r9, rax
    jmp pp_rf_loop
pp_rf_eof:
    mov rax, 3           # SYS_CLOSE
    mov rdi, rbx
    syscall
    mov rax, r9
    pop r9
    pop r8
    pop rbx
    ret
pp_rf_fail:
    mov rax, -1
    pop r9
    pop r8
    pop rbx
    ret
pp_do_include:
    push rcx
    push rdx
    push rdi
    push rsi
    push r8
    push r9
    push r10
    push rbx
    mov rdi, r15
    add rdi, 0x7720000
    mov rax, rbx
    shl rax, 12
    add rdi, rax         # rdi = name buf
    mov rdx, r10
    add rdx, 8           # pos = dip+8 (expect '"')
    mov rsi, r8
    add rsi, rdx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 34
    jne pp_doinc_ret
    add rdx, 1           # first fname char
    xor rcx, rcx         # fi
pp_doinc_fl:
    cmp rdx, r9
    jge pp_doinc_fld
    mov rsi, r8
    add rsi, rdx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 34
    je pp_doinc_fld
    mov rsi, rdi
    add rsi, rcx
    mov [rsi], rax
    add rcx, 1
    add rdx, 1
    jmp pp_doinc_fl
pp_doinc_fld:
    mov rsi, rdi
    add rsi, rcx
    xor rax, rax
    mov [rsi], rax       # NUL-term name
    call pp_seen         # rdi=name
    cmp rax, 1
    je pp_doinc_ret
    mov rdi, r15
    add rdi, 0x7720000
    mov rax, rbx
    shl rax, 12
    add rdi, rax
    call pp_mark
    mov rsi, r15
    add rsi, 0x9000000
    mov rax, rbx
    shl rax, 21          # *0x200000
    add rsi, rax         # dest scratch
    mov rdi, r15
    add rdi, 0x7720000
    mov rax, rbx
    shl rax, 12
    add rdi, rax         # path
    push rsi
    call pp_readfile     # rax = bytes
    pop rsi              # dest
    cmp rax, 0
    jle pp_doinc_ret
    mov r8, rsi          # child src
    mov r9, rax          # child len
    add rbx, 1           # child depth
    call pp_expand
pp_doinc_ret:
    pop rbx
    pop r10
    pop r9
    pop r8
    pop rsi
    pop rdi
    pop rdx
    pop rcx
    ret
pp_expand:
    push rcx
    push rdx
    push rdi
    push rsi
    push r10
    xor rcx, rcx         # ip
pp_exp_loop:
    cmp rcx, r9
    jge pp_exp_done
    cmp rcx, 0
    je pp_exp_linestart
    mov rsi, r8
    add rsi, rcx
    sub rsi, 1
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 10
    jne pp_exp_emit
pp_exp_linestart:
    mov r10, rcx         # dip (skipws)
pp_exp_sw:
    cmp r10, r9
    jge pp_exp_dipdone
    mov rsi, r8
    add rsi, r10
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 32
    je pp_exp_sw_adv
    cmp rax, 9
    je pp_exp_sw_adv
    jmp pp_exp_dipdone
pp_exp_sw_adv:
    add r10, 1
    jmp pp_exp_sw
pp_exp_dipdone:
    mov rsi, r8
    add rsi, r10
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 35          # '#'
    jne pp_exp_try_include
    mov rdi, r8
    add rdi, r10
    add rdi, 1
    mov rsi, pp_pat_ifdef
    mov rdx, 6
    call pp_match
    cmp rax, 1
    je pp_exp_ifdef
    mov rdi, r8
    add rdi, r10
    add rdi, 1
    mov rsi, pp_pat_ifndef
    mov rdx, 7
    call pp_match
    cmp rax, 1
    je pp_exp_ifndef
    mov rdi, r8
    add rdi, r10
    add rdi, 1
    mov rsi, pp_pat_else
    mov rdx, 4
    call pp_match
    cmp rax, 1
    je pp_exp_else
    mov rdi, r8
    add rdi, r10
    add rdi, 1
    mov rsi, pp_pat_endif
    mov rdx, 5
    call pp_match
    cmp rax, 1
    je pp_exp_endif
    jmp pp_exp_emit      # '#' but not a directive -> emit (comment)
pp_exp_ifdef:
    mov rdi, r8
    add rdi, r10
    add rdi, 7
    call pp_defined
    mov rdi, rax
    call pp_cond_push
    jmp pp_exp_skipline
pp_exp_ifndef:
    mov rdi, r8
    add rdi, r10
    add rdi, 8
    call pp_defined
    mov rdi, 1
    sub rdi, rax
    call pp_cond_push
    jmp pp_exp_skipline
pp_exp_else:
    call pp_cond_else
    jmp pp_exp_skipline
pp_exp_endif:
    call pp_cond_pop
    jmp pp_exp_skipline
pp_exp_try_include:
    mov rdi, r8
    add rdi, r10
    mov rsi, pp_pat_include
    mov rdx, 8
    call pp_match
    cmp rax, 1
    jne pp_exp_emit
    mov rsi, r15
    add rsi, 0x7700018
    mov rax, [rsi]
    cmp rax, 1
    jne pp_exp_skipline  # emit off -> skip line
    call pp_do_include
    jmp pp_exp_skipline
pp_exp_skipline:
    cmp rcx, r9
    jge pp_exp_loop
    mov rsi, r8
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    add rcx, 1
    cmp rax, 10
    jne pp_exp_skipline
    jmp pp_exp_loop
pp_exp_emit:
    mov rsi, r15
    add rsi, 0x7700018
    mov rax, [rsi]
    cmp rax, 1
    jne pp_exp_emit_adv
    mov rsi, r15
    add rsi, 0x7700000
    mov rdx, [rsi]       # out_cursor
    mov rsi, r8
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    mov rsi, r15
    add rsi, 0x8000000
    add rsi, rdx
    mov [rsi], rax       # expand_buf[out] = src[ip]
    add rdx, 1
    mov rsi, r15
    add rsi, 0x7700000
    mov [rsi], rdx       # out_cursor++
pp_exp_emit_adv:
    add rcx, 1
    jmp pp_exp_loop
pp_exp_done:
    pop r10
    pop rsi
    pop rdi
    pop rdx
    pop rcx
    ret
preprocess:
    mov rsi, r15
    add rsi, 0x7700000
    xor rax, rax
    mov [rsi], rax       # out_cursor = 0
    mov rsi, r15
    add rsi, 0x7700008
    mov [rsi], rax       # once_count = 0
    mov rsi, r15
    add rsi, 0x7700010
    mov [rsi], rax       # cond_depth = 0
    mov rsi, r15
    add rsi, 0x7700018
    mov rax, 1
    mov [rsi], rax       # emit = 1
    mov r8, r15          # src = input_buf (r15+0)
    mov r9, r12          # srclen = input length
    xor rbx, rbx         # depth = 0
    call pp_expand
    mov rsi, r15
    add rsi, 0x7700000
    mov r9, [rsi]        # new length = out_cursor
    xor rcx, rcx
pp_pre_copy:
    cmp rcx, r9
    jge pp_pre_done
    mov rsi, r15
    add rsi, 0x8000000
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    mov rsi, r15
    add rsi, rcx
    mov [rsi], rax       # input_buf[i] = expand_buf[i]
    add rcx, 1
    jmp pp_pre_copy
pp_pre_done:
    mov r12, r9          # input length = expanded length
    ret
elf_template:
    dq 0x00010102464C457F
    dq 0x0000000000000000
    dq 0x00000001003E0002
    dq 0x0000000000400078
    dq 0x0000000000000040
    dq 0x0000000000000000
    dq 0x0038004000000000
    dq 0x0000000000400001
    dq 0x0000000500000001
    dq 0x0000000000000000
    dq 0x0000000000400000
    dq 0x0000000000400000
    dq 0x0000000000000090
    dq 0x0000000000000090
    dq 0x0000000000001000
err_syntax:
    db "syntax error\n"
err_undef:
    db "undefined variable\n"
dbg_space:
    db " "
pp_pat_include:
    db "include "
pp_pat_ifdef:
    db "ifdef "
pp_pat_ifndef:
    db "ifndef "
pp_pat_else:
    db "else"
pp_pat_endif:
    db "endif"
