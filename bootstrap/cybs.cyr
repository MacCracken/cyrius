# emit_mov_rax_rdx: emit "mov rax, rdx" = 48 89 D0
emit_mov_rax_rdx:
    push rsi
    mov rsi, r15
    add rsi, 0x59000
    add rsi, r13
    mov rax, 0xD08948
    mov [rsi], rax
