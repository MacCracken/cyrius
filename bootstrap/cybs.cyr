_start:
    call sys_init
    call read_input
    call preprocess
    call lexer
    call parser
    call fixup_vars
    call emit_elf
    call write_output
    call sys_exit_ok
sys_init:
    mov rax, 12
    xor rdi, rdi
    syscall
    mov r15, rax
    mov rdi, r15
    add rdi, 0x10000000
    mov rax, 12
    syscall
    xor r14, r14
    xor r13, r13         # code_pos = 0
    mov rsi, r15
    add rsi, 0x7600010
    xor rax, rax
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x7600000
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x7600020
    mov [rsi], rax
    add rsi, 8
    mov [rsi], rax
    add rsi, 8
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x7600040
    mov [rsi], rax
    ret
read_input:
    xor r12, r12          # r12 = total bytes read
read_input_loop:
    mov rax, 0
    xor rdi, rdi
    mov rsi, r15
    add rsi, r12          # offset into input_buf
    mov rdx, 0xF00000     # 15MB max (input_buf is the 16MB region 0x0..0x1000000)
    sub rdx, r12          # remaining space
    cmp rdx, 0
    jle read_input_done
    syscall
    cmp rax, 0
    jle read_input_done   # EOF or error
    add r12, rax
    jmp read_input_loop
read_input_done:
    ret
write_output:
    mov rax, 1
    mov rdi, 1
    mov rsi, r15
    add rsi, 0x4C00000
    mov rdx, r13
    syscall
    ret
sys_exit_ok:
    mov rax, 60
    xor rdi, rdi
    syscall
sys_exit_err:
    mov rax, 60
    mov rdi, 1
    syscall
emit_2bytes:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_8bytes:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov [rsi], rax
    add r13, 8
    pop rsi
    ret
emit_mov_rax_imm64:
    push rbx
    mov rbx, rax         # save value
    mov rax, 0xB848       # 48 B8
    call emit_2bytes
    mov rax, rbx
    call emit_8bytes
    pop rbx
    ret
emit_mov_rcx_imm64:
    push rbx
    mov rbx, rax
    mov rax, 0xB948       # 48 B9
    call emit_2bytes
    mov rax, rbx
    call emit_8bytes
    pop rbx
    ret
emit_push_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x50
    mov [rsi], rax
    inc r13
    pop rsi
    ret
emit_pop_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x59
    mov [rsi], rax
    inc r13
    pop rsi
    ret
emit_mov_rcx_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC18948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_pop_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x58
    mov [rsi], rax
    inc r13
    pop rsi
    ret
emit_add_rax_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC80148
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_sub_rax_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC82948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_imul_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE9F748
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_cqo:
    mov rax, 0x9948
    call emit_2bytes
    ret
emit_idiv_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xF9F748
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_mov_rax_mem_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x018B48
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_mov_mem_rcx_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x018948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_cmp_rax_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC83948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_mov_rdi_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC78948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_syscall:
    mov rax, 0x050F
    call emit_2bytes
    ret
emit_jcc:
    push rbx
    push rsi
    mov rbx, rax         # save condition byte
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x0F
    mov [rsi], rax
    inc r13
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov [rsi], rbx
    inc r13
    mov rbx, r13
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    mov rax, rbx
    pop rsi
    pop rbx
    ret
emit_jmp_to:
    push rbx
    push rsi
    mov rbx, rax         # target
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE9
    mov [rsi], rax
    inc r13
    mov rax, rbx
    mov rcx, r13
    add rcx, 4
    sub rax, rcx          # rax = target - (r13+4)
    and rax, 0xFFFFFFFF   # mask to 4 bytes
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rcx, [rsi]        # existing qword
    shr rcx, 32
    shl rcx, 32
    or rax, rcx
    mov [rsi], rax
    add r13, 4
    pop rsi
    pop rbx
    ret
patch_rel32:
    push rbx
    push rsi
    push rcx
    mov rbx, rax         # offset
    mov rax, r13
    sub rax, rbx
    sub rax, 4            # rel32 = code_pos - (offset + 4)
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, rbx
    mov rcx, [rsi]       # existing qword
    shr rcx, 32
    shl rcx, 32
    and rax, 0xFFFFFFFF
    or rax, rcx           # combine
    mov [rsi], rax
    pop rcx
    pop rsi
    pop rbx
    ret
emit_var_load:
    push rbx
    mov rbx, rax         # var index
    mov rax, 0xB948       # 48 B9
    call emit_2bytes
    call record_fixup_rbx
    xor rax, rax
    call emit_8bytes
    call emit_mov_rax_mem_rcx
    pop rbx
    ret
emit_var_store:
    push rbx
    mov rbx, rax
    mov rax, 0xB948       # 48 B9
    call emit_2bytes
    call record_fixup_rbx
    xor rax, rax
    call emit_8bytes
    call emit_mov_mem_rcx_rax
    pop rbx
    ret
record_fixup_rbx:
    push rsi
    push rcx
    push rax
    mov rsi, r15
    add rsi, 0x7600010
    mov rax, [rsi]
    mov rcx, rax         # rcx = count
    shl rax, 4           # *16 (each entry is 2 qwords)
    mov rsi, r15
    add rsi, 0x6200000
    add rsi, rax
    mov [rsi], r13       # store codebuf offset
    add rsi, 8
    mov [rsi], rbx
    inc rcx
    mov rsi, r15
    add rsi, 0x7600010
    mov [rsi], rcx
    pop rax
    pop rcx
    pop rsi
    ret
emit_exit_epilogue:
    call emit_mov_rdi_rax
    mov rax, 60
    call emit_mov_rax_imm64
    call emit_syscall
    ret
emit_load8:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x00B60F48
    mov [rsi], rax
    add r13, 4
    pop rsi
    ret
emit_store8_op:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x0188
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_load64:             # mov rax, [rax] = 48 8B 00
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x008B48
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_load32:             # mov eax, [rax] = 8B 00  (zero-extends to rax)
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x008B
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_load16:             # movzx rax, word [rax] = 48 0F B7 00
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x00B70F48
    mov [rsi], rax
    add r13, 4
    pop rsi
    ret
emit_store64:            # mov [rcx], rax = 48 89 01
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x018948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_store32:            # mov [rcx], eax = 89 01
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x0189
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_store16:            # mov [rcx], ax = 66 89 01
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x018966
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_xor_rax_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC03148
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_and_rax_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC82148
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_or_rax_rcx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC80948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_xor_rax_rcx_op:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC83148
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_shl_rax_cl:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE0D348
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_shr_rax_cl:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE8D348
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_not_rax:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xD0F748
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_mov_rax_rdx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xD08948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_var_addr:
    push rbx
    mov rbx, rax         # var index
    mov rax, 0xB848       # 48 B8
    call emit_2bytes
    call record_fixup_rbx
    xor rax, rax
    call emit_8bytes
    pop rbx
    ret
emit_fn_addr:
    push rbx
    mov rbx, rax         # fn index
    mov rax, 3
    shl rax, 56
    or rbx, rax          # rbx = (3 << 56) | fn_index
    mov rax, 0xB848      # 48 B8  mov rax, imm64
    call emit_2bytes
    call record_fixup_rbx
    xor rax, rax
    call emit_8bytes
    pop rbx
    ret
emit_call_rax:
    mov rax, 0xD0FF      # FF D0  call rax
    call emit_2bytes
    ret
emit_string_addr:
    push rbx
    mov rax, 0xB848
    call emit_2bytes
    push rax
    mov rax, 1
    shl rax, 56
    or rbx, rax           # rbx = (1 << 56) | string_offset
    pop rax
    call record_fixup_rbx
    xor rax, rax
    call emit_8bytes
    pop rbx
    ret
emit_pop_rdi:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x5F
    mov [rsi], rax
    inc r13
    pop rsi
    ret
emit_pop_rsi:
    push rsi
    push rbx
    mov rbx, r15
    add rbx, 0x3C00000
    add rbx, r13
    mov rax, 0x5E
    mov [rbx], rax
    inc r13
    pop rbx
    pop rsi
    ret
emit_pop_rdx:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x5A
    mov [rsi], rax
    inc r13
    pop rsi
    ret
emit_pop_r10:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x5A41
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_pop_r8:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x5841
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_pop_r9:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x5941
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_push_rbp:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x55
    mov [rsi], rax
    inc r13
    pop rsi
    ret
emit_mov_rbp_rsp:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE58948
    mov [rsi], rax
    add r13, 3
    pop rsi
    ret
emit_sub_rsp_imm32:
    push rsi
    push rbx
    mov rbx, rax         # save frame size
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xEC8148
    mov [rsi], rax
    add r13, 3
    push r13
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rbx, 0xFFFFFFFF
    or rax, rbx
    mov [rsi], rax
    add r13, 4
    pop rax               # return patch offset
    pop rbx
    pop rsi
    ret
emit_leave_ret:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xC3C9
    mov [rsi], rax
    add r13, 2
    pop rsi
    ret
emit_fn_var_load:
    push rsi
    push rbx
    inc rax
    shl rax, 3
    neg rax               # disp32 = -(index+1)*8
    mov rbx, rax
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x858B48
    mov [rsi], rax
    add r13, 3
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rbx, 0xFFFFFFFF
    or rax, rbx
    mov [rsi], rax
    add r13, 4
    pop rbx
    pop rsi
    ret
emit_fn_var_store:
    push rsi
    push rbx
    inc rax
    shl rax, 3
    neg rax
    mov rbx, rax
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x858948
    mov [rsi], rax
    add r13, 3
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rbx, 0xFFFFFFFF
    or rax, rbx
    mov [rsi], rax
    add r13, 4
    pop rbx
    pop rsi
    ret
emit_fn_var_addr:
    push rsi
    push rbx
    inc rax
    shl rax, 3
    neg rax
    mov rbx, rax
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0x858D48
    mov [rsi], rax
    add r13, 3
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rbx, 0xFFFFFFFF
    or rax, rbx
    mov [rsi], rax
    add r13, 4
    pop rbx
    pop rsi
    ret
emit_store_param:
    push rsi
    push rcx
    push rdx
    push rbx
    inc rbx
    shl rbx, 3
    neg rbx
    mov rdx, rbx          # rdx = disp32
    pop rbx
    cmp rax, 0
    je emit_sp_rdi
    cmp rax, 1
    je emit_sp_rsi
    cmp rax, 2
    je emit_sp_rdx
    cmp rax, 3
    je emit_sp_rcx
    cmp rax, 4
    je emit_sp_r8
    cmp rax, 5
    je emit_sp_r9
    jmp emit_sp_done
emit_sp_rdi:
    mov rax, 0xBD8948     # 48 89 BD = mov [rbp+d32], rdi
    jmp emit_sp_write
emit_sp_rsi:
    mov rax, 0xB58948     # 48 89 B5 = mov [rbp+d32], rsi
    jmp emit_sp_write
emit_sp_rdx:
    mov rax, 0x958948     # 48 89 95 = mov [rbp+d32], rdx
    jmp emit_sp_write
emit_sp_rcx:
    mov rax, 0x8D8948     # 48 89 8D = mov [rbp+d32], rcx
    jmp emit_sp_write
emit_sp_r8:
    mov rax, 0x85894C     # 4C 89 85 = mov [rbp+d32], r8
    jmp emit_sp_write
emit_sp_r9:
    mov rax, 0x8D894C     # 4C 89 8D = mov [rbp+d32], r9
    jmp emit_sp_write
emit_sp_write:
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov [rsi], rax
    add r13, 3
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, [rsi]
    shr rax, 32
    shl rax, 32
    and rdx, 0xFFFFFFFF
    or rax, rdx
    mov [rsi], rax
    add r13, 4
emit_sp_done:
    pop rdx
    pop rcx
    pop rsi
    ret
emit_call_placeholder:
    push rsi
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE8
    mov [rsi], rax
    inc r13
    mov rax, r13          # patch offset = where rel32 starts
    push rax
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    xor rax, rax
    mov [rsi], rax
    add r13, 4
    pop rax
    pop rsi
    ret
emit_call_to:
    push rsi
    push rbx
    mov rbx, rax         # target
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rax, 0xE8
    mov [rsi], rax
    inc r13
    mov rax, rbx
    mov rcx, r13
    add rcx, 4
    sub rax, rcx
    and rax, 0xFFFFFFFF
    mov rsi, r15
    add rsi, 0x3C00000
    add rsi, r13
    mov rcx, [rsi]
    shr rcx, 32
    shl rcx, 32
    or rax, rcx
    mov [rsi], rax
    add r13, 4
    pop rbx
    pop rsi
    ret
emit_fn_call_pops:
    cmp rax, 0
    je emit_fcp_0
    cmp rax, 1
    je emit_fcp_1
    cmp rax, 2
    je emit_fcp_2
    cmp rax, 3
    je emit_fcp_3
    cmp rax, 4
    je emit_fcp_4
    cmp rax, 5
    je emit_fcp_5
    cmp rax, 6
    je emit_fcp_6
    jmp parse_err
emit_fcp_0:
    ret
emit_fcp_1:
    call emit_pop_rdi
    ret
emit_fcp_2:
    call emit_pop_rsi
    call emit_pop_rdi
    ret
emit_fcp_3:
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    ret
emit_fcp_4:
    call emit_pop_rcx
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    ret
emit_fcp_5:
    call emit_pop_r8
    call emit_pop_rcx
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    ret
emit_fcp_6:
    call emit_pop_r9
    call emit_pop_r8
    call emit_pop_rcx
    call emit_pop_rdx
    call emit_pop_rsi
    call emit_pop_rdi
    ret
register_fn:
    push rsi
    push rcx
    mov rsi, r15
    add rsi, 0x7600020
    mov rcx, [rsi]
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x7200000
    add rsi, rcx
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x7300000
    add rsi, rcx
    mov rax, -1
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x7400000
    add rsi, rcx
    xor rax, rax
    mov [rsi], rax
    pop rcx               # rcx = index
    mov rax, rcx
    inc rax
    push rcx
    mov rsi, r15
    add rsi, 0x7600020
    mov [rsi], rax
    pop rax               # return index
    pop rcx
    pop rsi
    ret
find_fn_index:
    push r8
    push r9
    push rcx
    mov r8, rax           # name to find
    mov rsi, r15
    add rsi, 0x7600020
    mov r9, [rsi]
    xor rcx, rcx
find_fn_loop:
    cmp rcx, r9
    jge find_fn_notfound
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x7200000
    add rsi, rcx
    mov rax, [rsi]
    pop rcx
    push r8
    push r9
    push rcx
    mov rdi, r15
    add rdi, 0x3400000
    add rdi, rax
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, r8
    call strcmp
    pop rcx
    pop r9
    pop r8
    cmp rax, 0
    je find_fn_found
    inc rcx
    jmp find_fn_loop
find_fn_found:
    mov rax, rcx
    pop rcx
    pop r9
    pop r8
    ret
find_fn_notfound:
    mov rax, -1
    pop rcx
    pop r9
    pop r8
    ret
find_fn_local_index:
    push r8
    push r9
    push rcx
    mov r8, rax
    mov rsi, r15
    add rsi, 0x7600030
    mov r9, [rsi]         # fn_local_count
    xor rcx, rcx
find_fnl_loop:
    cmp rcx, r9
    jge find_fnl_undef
    push rcx
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1000000
    add rsi, rcx
    mov rax, [rsi]
    pop rcx
    push r8
    push r9
    push rcx
    mov rdi, r15
    add rdi, 0x3400000
    add rdi, rax
    mov rsi, r15
    add rsi, 0x3400000
    add rsi, r8
    call strcmp
    pop rcx
    pop r9
    pop r8
    cmp rax, 0
    je find_fnl_found
    inc rcx
    jmp find_fnl_loop
find_fnl_found:
    mov rax, rcx
    pop rcx
    pop r9
    pop r8
    ret
find_fnl_undef:
    pop rcx
    pop r9
    pop r8
    mov rax, -1
    ret
record_fixup_at:
    push rsi
    push rcx
    push rdx
    mov rdx, rax
    mov rsi, r15
    add rsi, 0x7600010
    mov rax, [rsi]
    mov rcx, rax
    shl rax, 4
    mov rsi, r15
    add rsi, 0x6200000
    add rsi, rax
    mov [rsi], rdx
    add rsi, 8
    mov [rsi], rbx
    inc rcx
    mov rsi, r15
    add rsi, 0x7600010
    mov [rsi], rcx
    pop rdx
    pop rcx
    pop rsi
    ret
lexer:
    push r8
    push r9
    push rcx
    push rbx
    xor r8, r8
    xor r10, r10
    xor r9, r9
lexer_loop:
    cmp r8, r12
    jge lexer_eof
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 32
    je lexer_skip
    cmp rax, 9
    je lexer_skip
    cmp rax, 10
    je lexer_skip
    cmp rax, 13
    je lexer_skip
    cmp rax, 48
    jl lexer_not_digit
    cmp rax, 57
    jg lexer_not_digit
    jmp lexer_number
lexer_not_digit:
    cmp rax, 97
    jl lexer_not_lower
    cmp rax, 122
    jle lexer_ident
lexer_not_lower:
    cmp rax, 65
    jl lexer_not_letter
    cmp rax, 90
    jle lexer_ident
lexer_not_letter:
    cmp rax, 61
    je lexer_eq_or_eqeq
    cmp rax, 33
    je lexer_bang
    cmp rax, 60
    je lexer_lt_or_lte
    cmp rax, 62
    je lexer_gt_or_gte
    cmp rax, 59
    je lexer_semi
    cmp rax, 43
    je lexer_plus
    cmp rax, 45
    je lexer_minus
    cmp rax, 42
    je lexer_star
    cmp rax, 47
    je lexer_slash
    cmp rax, 40
    je lexer_lparen
    cmp rax, 41
    je lexer_rparen
    cmp rax, 123
    je lexer_lbrace
    cmp rax, 125
    je lexer_rbrace
    cmp rax, 38
    je lexer_ampersand
    cmp rax, 91
    je lexer_lbracket
    cmp rax, 93
    je lexer_rbracket
    cmp rax, 44
    je lexer_comma
    cmp rax, 58          # ':' COLON (typed-return / typed-var brick)
    je lexer_colon
    cmp rax, 34
    je lexer_string
    cmp rax, 37           # '%'
    je lexer_percent
    cmp rax, 124          # '|'
    je lexer_pipe
    cmp rax, 94           # '^'
    je lexer_caret
    cmp rax, 126          # '~'
    je lexer_tilde
    cmp rax, 35           # '#' comment
    je lexer_comment
    jmp lexer_skip
lexer_eq_or_eqeq:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_eq_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 61          # '='
    je lexer_eqeq
lexer_eq_single:
    mov rax, 4
    call lexer_emit_simple
    jmp lexer_skip
lexer_eqeq:
    mov rax, 17
    call lexer_emit_simple
    inc r8               # skip second '='
    jmp lexer_skip
lexer_bang:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_skip       # lone '!' — skip
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 61
    jne lexer_skip       # '!' without '=' — skip
    mov rax, 18          # NEQ
    call lexer_emit_simple
    inc r8
    jmp lexer_skip
lexer_lt_or_lte:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_lt_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 61
    je lexer_lte
    cmp rax, 60           # '<' — check for <<
    je lexer_shl
lexer_lt_single:
    mov rax, 19          # LT
    call lexer_emit_simple
    jmp lexer_skip
lexer_lte:
    mov rax, 21          # LTE
    call lexer_emit_simple
    inc r8
    jmp lexer_skip
lexer_shl:
    mov rax, 38          # SHL
    call lexer_emit_simple
    inc r8
    jmp lexer_skip
lexer_gt_or_gte:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_gt_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 61
    je lexer_gte
    cmp rax, 62           # '>' — check for >>
    je lexer_shr
lexer_gt_single:
    mov rax, 20          # GT
    call lexer_emit_simple
    jmp lexer_skip
lexer_gte:
    mov rax, 22          # GTE
    call lexer_emit_simple
    inc r8
    jmp lexer_skip
lexer_shr:
    mov rax, 39          # SHR
    call lexer_emit_simple
    inc r8
    jmp lexer_skip
lexer_semi:
    mov rax, 5
    call lexer_emit_simple
    jmp lexer_skip
lexer_plus:
    mov rax, 6
    call lexer_emit_simple
    jmp lexer_skip
lexer_minus:
    mov rax, 7
    call lexer_emit_simple
    jmp lexer_skip
lexer_star:
    mov rax, 8
    call lexer_emit_simple
    jmp lexer_skip
lexer_slash:
    mov rax, 9
    call lexer_emit_simple
    jmp lexer_skip
lexer_lparen:
    mov rax, 10
    call lexer_emit_simple
    jmp lexer_skip
lexer_rparen:
    mov rax, 11
    call lexer_emit_simple
    jmp lexer_skip
lexer_lbrace:
    mov rax, 13
    call lexer_emit_simple
    jmp lexer_skip
lexer_rbrace:
    mov rax, 14
    call lexer_emit_simple
    jmp lexer_skip
lexer_ampersand:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_amp_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 38          # second '&' -> &&
    je lexer_andand
lexer_amp_single:
    mov rax, 27          # AMPERSAND
    call lexer_emit_simple
    jmp lexer_skip
lexer_andand:
    mov rax, 51          # ANDAND (&& brick)
    call lexer_emit_simple
    inc r8               # skip second '&'
    jmp lexer_skip
lexer_lbracket:
    mov rax, 28
    call lexer_emit_simple
    jmp lexer_skip
lexer_rbracket:
    mov rax, 29
    call lexer_emit_simple
    jmp lexer_skip
lexer_comma:
    mov rax, 31
    call lexer_emit_simple
    jmp lexer_skip
lexer_colon:
    mov rax, 50          # COLON (typed-return / typed-var brick)
    call lexer_emit_simple
    jmp lexer_skip
lexer_percent:
    mov rax, 34          # PERCENT
    call lexer_emit_simple
    jmp lexer_skip
lexer_pipe:
    mov rcx, r8
    inc rcx
    cmp rcx, r12
    jge lexer_pipe_single
    mov rsi, r15
    add rsi, rcx
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 124         # second '|' -> ||
    je lexer_oror
lexer_pipe_single:
    mov rax, 35          # PIPE
    call lexer_emit_simple
    jmp lexer_skip
lexer_oror:
    mov rax, 52          # OROR (|| brick)
    call lexer_emit_simple
    inc r8               # skip second '|'
    jmp lexer_skip
lexer_caret:
    mov rax, 36          # CARET
    call lexer_emit_simple
    jmp lexer_skip
lexer_tilde:
    mov rax, 37          # TILDE
    call lexer_emit_simple
    jmp lexer_skip
lexer_comment:
    inc r8
lexer_comment_loop:
    cmp r8, r12
    jge lexer_loop        # hit EOF
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 10           # newline
    je lexer_skip         # skip the newline too
    inc r8
    jmp lexer_comment_loop
lexer_string:
    inc r8               # skip opening "
    push rbx
    mov rsi, r15
    add rsi, 0x7600000
    mov rbx, [rsi]       # rbx = current string_pos
    push rcx
    mov rcx, rbx          # rcx = start offset
lexer_str_loop:
    cmp r8, r12
    jge lexer_str_done    # unterminated string — just stop
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 34           # closing "
    je lexer_str_end
    cmp rax, 92           # backslash
    je lexer_str_escape
    mov rsi, r15
    add rsi, 0x5C00000
    add rsi, rbx
    movb [rsi], rax
    inc rbx
    inc r8
    jmp lexer_str_loop
lexer_str_escape:
    inc r8               # skip backslash
    cmp r8, r12
    jge lexer_str_done
    mov rsi, r15
    add rsi, r8
    mov rax, [rsi]
    and rax, 0xFF
    cmp rax, 110          # 'n'
    je lexer_esc_n
    cmp rax, 116          # 't'
    je lexer_esc_t
    cmp rax, 92           # '\'
    je lexer_esc_bs
    cmp rax, 34           # '"'
    je lexer_esc_q
    cmp rax, 48           # '0'
    je lexer_esc_0
    jmp lexer_str_store   # unknown escape — store as-is
lexer_esc_n:
    mov rax, 10
    jmp lexer_str_store
lexer_esc_t:
    mov rax, 9
    jmp lexer_str_store
lexer_esc_bs:
    mov rax, 92
    jmp lexer_str_store
lexer_esc_q:
    mov rax, 34
    jmp lexer_str_store
lexer_esc_0:
    xor rax, rax
lexer_str_store:
    mov rsi, r15
    add rsi, 0x5C00000
    add rsi, rbx
    movb [rsi], rax
    inc rbx
    inc r8
    jmp lexer_str_loop
lexer_str_end:
    inc r8               # skip closing "
lexer_str_done:
    mov rax, rbx
    sub rax, rcx          # rax = length
    push rdx
    mov rdx, rcx
    shl rdx, 16
    or rax, rdx
    pop rdx
    push rax              # save packed value
    mov rax, 30
    push rax
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1400000
    add rsi, rcx
    pop rax
    mov [rsi], rax        # tok_types[r10] = 30
    pop rax               # packed value
    mov rsi, r15
    add rsi, 0x2400000
    add rsi, rcx
    mov [rsi], rax        # tok_values[r10] = (offset << 16) | length
    inc r10
    mov rsi, r15
    add rsi, 0x7600000
    mov [rsi], rbx
    pop rcx
    pop rbx
    jmp lexer_loop
lexer_emit_simple:
    push rax
    mov rcx, r10
    shl rcx, 3
    mov rsi, r15
    add rsi, 0x1400000
    add rsi, rcx
    pop rax
    mov [rsi], rax
    mov rsi, r15
    add rsi, 0x2400000
    add rsi, rcx
    xor rax, rax
    mov [rsi], rax
    inc r10
    ret
lexer_skip:
    inc r8
    jmp lexer_loop
lexer_number:
    cmp rax, 48           # '0'
    jne lexer_decimal
    mov rcx, r8
    inc rcx
    cmp rcx, r12
