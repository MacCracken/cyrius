# ================================================================
# Core operations
# ================================================================

# v6.1.12: `cyrius build --target=js <source.tsx> <output.js>` — surface cycc's
# `--emit-js` (v6.1.11 TS/TSX → browser-JS emitter) through the CLI. Distinct
# from the native compile path: cycc reads the source as a PATH arg and writes
# JS to stdout (no stdin pipe, no dep/define prepend — JS emit doesn't take
# cyrius includes). We fork cycc with [cc, "--emit-js", source, 0] and dup2 the
# output file onto stdout. x86-Linux-only (the TS frontend is). See CHANGELOG [6.1.12].
fn _emit_js(source, output): i64 {
    var cc = current_cc();
    if (cc == 0) {
        _err("cycc not found. Install Cyrius or set CYRIUS_HOME.");
        return 1;
    }
    if (file_exists(cc) == 0) {
        _err_ctx("compiler not found", cc);
        return 1;
    }
    # Atomic-output: emit to a temp then rename on success, so a failed emit
    # never leaves a truncated .js over a previously-good one (mirrors compile()).
    var tmp_pid = syscall(39);
    var tmp_out_sb = str_builder_new();
    str_builder_add_cstr(tmp_out_sb, output);
    str_builder_add_cstr(tmp_out_sb, ".tmp.");
    str_builder_add_int(tmp_out_sb, tmp_pid);
    var tmp_out = str_data(str_builder_build(tmp_out_sb));
    sys_unlink(tmp_out);
    var pid = sys_fork();
    if (pid == 0) {
        var ofd = sys_open(tmp_out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);
        # argv: cc, "--emit-js", <source path>, NUL. emit-js reads the path arg,
        # writes JS to stdout (now the output file). No envp injection needed.
        var argv[32];
        store64(&argv, cc);
        store64(&argv + 8, "--emit-js");
        store64(&argv + 16, source);
        store64(&argv + 24, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            sys_unlink(output);
            syscall(82, tmp_out, output);   # SYS_RENAME on Linux x86_64
            sys_chmod(output, 0x1A4);        # 0644 — JS is data, not executable
            return 0;
        }
    }
    sys_unlink(tmp_out);
    return 1;
}

# cx arc: ensure the cx bytecode compiler (cycc_cx) exists, JIT-building it from
# src/main_cx.cyr with the host cycc if absent (the cross_bins "rebuilt on demand"
# model — install.sh also builds it, but this covers in-repo / first-use). Sets
# _cc_cx to a runnable path. Returns 0 on success, 1 on failure.
fn _ensure_cc_cx(): i64 {
    if (_cc_cx != 0) { if (file_exists(_cc_cx) == 1) { return 0; } }
    var cc = current_cc();
    if (cc == 0) { _err("cycc not found — cannot build the cx compiler"); return 1; }
    if (file_exists(cc) == 0) { _err_ctx("compiler not found", cc); return 1; }
    if (file_exists("src/main_cx.cyr") == 0) {
        _err_ctx("cx compiler source missing (need src/main_cx.cyr)", "src/main_cx.cyr");
        return 1;
    }
    sys_mkdir("build", 0x1ED);
    var out = "./build/cycc_cx";
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open("src/main_cx.cyr", O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);
        var ofd = sys_open(out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);
        var argv[8];
        store64(&argv, cc);
        store64(&argv + 8, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            sys_chmod(out, 0x1ED);
            _cc_cx = out;
            return 0;
        }
    }
    _err("failed to build the cx compiler (cycc_cx) from src/main_cx.cyr");
    return 1;
}

# cx arc: compile <source>.cyr → <output>.cyx via cycc_cx. Unlike _emit_js (which
# passes the source as a path arg), the cx fork reads .cyr from STDIN and writes
# .cyx to STDOUT — so the child dup2's BOTH the source onto fd 0 and the temp
# output onto fd 1. Atomic tmp-then-rename, like _emit_js / compile().
fn _emit_cx(source, output): i64 {
    if (_ensure_cc_cx() != 0) { return 1; }
    var cc = _cc_cx;
    var tmp_pid = syscall(39);
    var tmp_out_sb = str_builder_new();
    str_builder_add_cstr(tmp_out_sb, output);
    str_builder_add_cstr(tmp_out_sb, ".tmp.");
    str_builder_add_int(tmp_out_sb, tmp_pid);
    var tmp_out = str_data(str_builder_build(tmp_out_sb));
    sys_unlink(tmp_out);
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open(source, O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);
        var ofd = sys_open(tmp_out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);
        var argv[8];
        store64(&argv, cc);
        store64(&argv + 8, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            sys_unlink(output);
            syscall(82, tmp_out, output);   # SYS_RENAME on Linux x86_64
            sys_chmod(output, 0x1A4);        # 0644 — .cyx is data, not executable
            return 0;
        }
    }
    sys_unlink(tmp_out);
    return 1;
}

# cx arc: ensure the cx VM (cxvm) exists, JIT-building it from programs/cxvm.cyr
# with the host cycc if absent (install.sh also ships it via [release].bins).
fn _ensure_cxvm(): i64 {
    if (_cxvm != 0) { if (file_exists(_cxvm) == 1) { return 0; } }
    var cc = current_cc();
    if (cc == 0) { _err("cycc not found — cannot build cxvm"); return 1; }
    if (file_exists(cc) == 0) { _err_ctx("compiler not found", cc); return 1; }
    if (file_exists("programs/cxvm.cyr") == 0) {
        _err_ctx("cxvm source missing (need programs/cxvm.cyr)", "programs/cxvm.cyr");
        return 1;
    }
    sys_mkdir("build", 0x1ED);
    var out = "./build/cxvm";
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open("programs/cxvm.cyr", O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);
        var ofd = sys_open(out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);
        var argv[8];
        store64(&argv, cc);
        store64(&argv + 8, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            sys_chmod(out, 0x1ED);
            _cxvm = out;
            return 0;
        }
    }
    _err("failed to build cxvm from programs/cxvm.cyr");
    return 1;
}

# cx arc: run a .cyx bytecode file via cxvm. cxvm reads the .cyx from STDIN and
# exits with the guest program's exit code — so the child dup2's the .cyx onto
# fd 0, then execs cxvm. Mirrors run_binary's fork/waitpid/exit-status shape.
fn run_cx(cyx_path): i64 {
    if (_ensure_cxvm() != 0) { return 1; }
    var vm = _cxvm;
    var pid = sys_fork();
    if (pid == 0) {
        var fd = sys_open(cyx_path, O_RDONLY, 0);
        if (fd < 0) { sys_exit(1); }
        sys_dup2(fd, 0);
        sys_close(fd);
        var argv[8];
        store64(&argv, vm);
        store64(&argv + 8, 0);
        sys_execve(vm, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
    return 1;
}

# v6.3.3 #5: parse `[sections] base = "0x.."` from the cwd's cyrius.cyml and build
# a "CYRIUS_KERNEL_BASE=0x.." env string (alloc'd) for the cycc spawn, or 0 if the
# block / key is absent. Same line-scan idiom as _pulsar_release_array; cbt is
# cycc-compiled (no cybs limits). Only consulted on bare-metal builds. The `[sections]`
# block is bare-metal section-placement control (deliverable #5); today it exposes the
# image load base — the one knob a freestanding kernel/firmware consumer needs.
fn _sections_base_env(): i64 {
    if (file_exists("cyrius.cyml") == 0) { return 0; }
    var buf = alloc(32768);
    var n = file_read_all("cyrius.cyml", buf, 32767);
    if (n <= 0) { return 0; }
    var pos = 0;
    while (pos < n) {
        if (memeq(buf + pos, "[sections]", 10) == 1) { break; }
        pos = pos + 1;
    }
    if (pos >= n) { return 0; }
    pos = pos + 10;
    while (pos < n) {
        while (pos < n && (load8(buf + pos) == 10 || load8(buf + pos) == 32 || load8(buf + pos) == 9)) { pos = pos + 1; }
        if (pos >= n) { return 0; }
        if (load8(buf + pos) == 91) { return 0; }   # '[' — next section ends the block
        if (memeq(buf + pos, "base", 4) == 1) {
            var after = pos + 4;
            while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) { after = after + 1; }
            if (after < n && load8(buf + after) == 61) {   # '='
                after = after + 1;
                while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) { after = after + 1; }
                if (after < n && load8(buf + after) == 34) {   # '"'
                    after = after + 1;
                    var out = alloc(64);
                    var pfx = "CYRIUS_KERNEL_BASE=";
                    var pi = 0;
                    while (load8(pfx + pi) != 0) { store8(out + pi, load8(pfx + pi)); pi = pi + 1; }
                    var vi = 0;
                    while (after < n && load8(buf + after) != 34 && load8(buf + after) != 10 && vi < 40) {
                        store8(out + pi + vi, load8(buf + after));
                        vi = vi + 1; after = after + 1;
                    }
                    store8(out + pi + vi, 0);
                    # Parse the numeric base from the copied "0x.." value (for the D6 report).
                    _section_base_val = 0;
                    if (load8(out + pi) == 48 && (load8(out + pi + 1) == 120 || load8(out + pi + 1) == 88)) {
                        var hp = pi + 2;
                        var acc = 0;
                        var hc = load8(out + hp);
                        while (hc != 0) {
                            var dd = 0 - 1;
                            if (hc >= 48 && hc <= 57) { dd = hc - 48; }
                            elif (hc >= 97 && hc <= 102) { dd = hc - 97 + 10; }
                            elif (hc >= 65 && hc <= 70) { dd = hc - 65 + 10; }
                            if (dd < 0) { break; }
                            acc = acc * 16 + dd;
                            hp = hp + 1; hc = load8(out + hp);
                        }
                        _section_base_val = acc;
                    }
                    return out;
                }
                return 0;
            }
        }
        while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
    }
    return 0;
}

# v6.4.73 — the manifest auto-prepend, factored out of compile() so it has exactly
# ONE implementation. `cyrius capacity` forks cycc directly (it needs CYRIUS_STATS=1
# in the child env) instead of going through compile(), so pre-.73 it fed cycc the
# RAW source with no dep includes at all — every stdlib fn came back undefined, the
# compile aborted before the stats block, and `--check` then read ZERO stats lines
# and cheerfully printed "ok (all caps under 85%)". Duplicating the prepend into
# cmd_capacity would just set up the two copies to drift, so both call this.
#
# Returns the path to actually hand the compiler: `source` itself when there is
# nothing to prepend, else a /tmp temp holding [dep includes][defines][build
# modules][source]. Honors _skip_deps exactly as before. CHANGELOG [6.4.73].
# v6.5.7: the directory component of `source`, or 0 if there is nothing useful to
# say. cycc compiles from STDIN and so cannot know where its input lives; this is
# the value that rides in-band as `#@incdir` so an `include` can find a file
# sitting next to the source. See common/util.cyr for the full why.
#
# Returns 0 — meaning "emit no marker", which leaves today's behaviour exactly as
# it is — for anything cycc would refuse anyway:
#   - no directory component (already CWD-relative; the marker would be a no-op)
#   - an ABSOLUTE path. ⛔ Deliberate, and the one real limit of this feature.
#     The marker is in-band, so a hostile .cyr can write one; honouring an absolute
#     directory would rebuild the read-anything primitive CVE-16 removed, and cycc
#     rejects it for that reason. Relativising against CWD instead would need a
#     `getcwd` wrapper that does not exist on the PE/Mach-O targets cbt/cyrius.cyr
#     cross-compiles to. So `cyrius build /abs/dir/x.cyr` keeps resolving includes
#     against CWD, as it does today — no regression, and no hole bought with reach.
#   - a `..` component, for the CVE-02 half of the same argument.
fn _source_incdir(source): i64 {
    var n = strlen(source);
    if (n == 0) { return 0; }
    if (load8(source) == 47) { return 0; }
    if (load8(source) == 92) { return 0; }
    if (n > 1) { if (load8(source + 1) == 58) { return 0; } }
    var cut = 0 - 1;
    var i = 0;
    while (i < n) {
        var c = load8(source + i);
        if (c == 47) { cut = i; }
        if (c == 92) { cut = i; }
        i = i + 1;
    }
    if (cut <= 0) { return 0; }
    var j = 0;
    while (j < cut) {
        if (load8(source + j) == 46) {
            if (load8(source + j + 1) == 46) {
                if (j == 0) { return 0; }
                if (load8(source + j - 1) == 47) { return 0; }
                if (load8(source + j - 1) == 92) { return 0; }
            }
        }
        j = j + 1;
    }
    var sb = str_builder_new();
    var k = 0;
    while (k < cut) { str_builder_add_byte(sb, load8(source + k)); k = k + 1; }
    return str_data(str_builder_build(sb));
}

# v6.5.7: the directory component of any path, or 0 when there is none. Unlike
# `_source_incdir` this has NO security constraints to honour — it feeds an error
# message, not a file open — so absolute paths and `..` are reported as-is.
fn _parent_dir(path): i64 {
    var n = strlen(path);
    var cut = 0 - 1;
    var i = 0;
    while (i < n) {
        var c = load8(path + i);
        if (c == 47) { cut = i; }
        if (c == 92) { cut = i; }
        i = i + 1;
    }
    if (cut < 0) { return 0; }
    if (cut == 0) { return "/"; }
    var sb = str_builder_new();
    var k = 0;
    while (k < cut) { str_builder_add_byte(sb, load8(path + k)); k = k + 1; }
    return str_data(str_builder_build(sb));
}

fn _materialize_source(source): i64 {
    # Build temp file if we have dep includes or defines to prepend.
    # v5.7.8: _skip_deps suppresses the manifest auto-prepend; defines
    # and build-modules still apply.
    var actual_source = source;
    var need_tmp = 0;
    # v6.5.7: a source in a subdirectory needs the temp file even with nothing to
    # prepend, because the `#@incdir` marker is the thing being prepended.
    var incdir = _source_incdir(source);
    if (incdir != 0) { need_tmp = 1; }
    if (_skip_deps == 0) {
        if (_dep_includes != 0) { if (vec_len(_dep_includes) > 0) { need_tmp = 1; } }
    }
    if (_defines != 0) { if (vec_len(_defines) > 0) { need_tmp = 1; } }
    if (_build_modules != 0) { if (vec_len(_build_modules) > 0) { need_tmp = 1; } }
    if (need_tmp == 1) {
        # Atomic temp file: O_EXCL rejects if path already exists (TOCTOU safe)
        var pid = syscall(39);
        var tmp_sb = str_builder_new();
        str_builder_add_cstr(tmp_sb, _cbt_tmpfile("cpp_"));
        str_builder_add_int(tmp_sb, pid);
        var tmp = str_data(str_builder_build(tmp_sb));
        # Unlink first so O_EXCL succeeds on re-runs with same PID
        sys_unlink(tmp);
        var tfd = sys_open(tmp, O_WRONLY | O_CREAT | O_EXCL, 0x180);
        if (tfd >= 0) {
            # v6.5.7: `#@incdir` FIRST — cycc honours the marker only at byte 0, so
            # that the CLI's value is the one it reads and a marker further down the
            # file (what a hostile include would write) stays an ordinary comment.
            # Nothing may be emitted above this line.
            if (incdir != 0) {
                sys_write(tfd, "#@incdir ", 9);
                sys_write(tfd, incdir, strlen(incdir));
                sys_write(tfd, "\n", 1);
            }
            # Prepend dep includes (v5.7.8: skipped under _skip_deps)
            if (_skip_deps == 0) {
                if (_dep_includes != 0) {
                    var ii = 0;
                    while (ii < vec_len(_dep_includes)) {
                        var inc = vec_get(_dep_includes, ii);
                        sys_write(tfd, "include \"", 9);
                        sys_write(tfd, inc, strlen(inc));
                        sys_write(tfd, "\"\n", 2);
                        ii = ii + 1;
                    }
                }
            }
            # Prepend defines
            if (_defines != 0) {
                var di = 0;
                while (di < vec_len(_defines)) {
                    var def = vec_get(_defines, di);
                    sys_write(tfd, "#define ", 8);
                    sys_write(tfd, def, strlen(def));
                    sys_write(tfd, "\n", 1);
                    di = di + 1;
                }
            }
            # Append build modules (concatenated before entry point)
            if (_build_modules != 0) {
                var mi = 0;
                while (mi < vec_len(_build_modules)) {
                    var mpath = vec_get(_build_modules, mi);
                    var mfd = sys_open(mpath, O_RDONLY, 0);
                    if (mfd >= 0) {
                        var mbuf = alloc(32768);
                        var mn = 1;
                        while (mn > 0) {
                            mn = syscall(0, mfd, mbuf, 32768);
                            if (mn > 0) { syscall(1, tfd, mbuf, mn); }
                        }
                        sys_close(mfd);
                        sys_write(tfd, "\n", 1);
                    }
                    mi = mi + 1;
                }
            }
            # Append source file (stream copy for large files)
            var sfd2 = sys_open(source, O_RDONLY, 0);
            if (sfd2 >= 0) {
                var cbuf = alloc(32768);
                var cn = 1;
                while (cn > 0) {
                    cn = syscall(0, sfd2, cbuf, 32768);
                    if (cn > 0) { syscall(1, tfd, cbuf, cn); }
                }
                sys_close(sfd2);
            }
            sys_close(tfd);
            actual_source = tmp;
        }
    }
    return actual_source;
}

# Compile source.cyr to output using current compiler.
# If _defines vec is set, prepend #define lines to a temp file first.
# ---------------------------------------------------------------------------
# Private per-invocation temp directory (v6.4.81 — CVE-35 / CVE-36)
# ---------------------------------------------------------------------------
# The CLI used 23 FIXED /tmp literals. Two classes of problem, both needing a
# shared or multi-user box (or shared CI) to matter:
#
#   CVE-35 — the DEPENDENCY-INTEGRITY controls read their result out of one:
#     `_sha256sum_file` (the digests that go into cyrius.lock) captured through
#     "/tmp/cyrius_sha_out" and `_git_head_sha` (the force-pushed-tag refusal)
#     through "/tmp/cyrius_githead_out", both O_CREAT|O_TRUNC with no O_EXCL and
#     no O_NOFOLLOW. An attacker who holds the name supplies the digest, so
#     `cyrius deps --verify` passes on a tampered dependency. The security
#     control itself is what gets subverted.
#
#   CVE-36 — `cyrius run/test/fuzz/bench/soak` compiled to a fixed name and then
#     EXECUTED it. (Narrowly: `compile()` writes <out>.tmp.<pid> and renames, and
#     rename(2) REPLACES a planted symlink rather than following it, so the naive
#     pre-plant does not work — but the final name is still predictable and the
#     window before execve is still there.)
#
# One private directory removes the shared namespace for both. mkdir is
# exclusive, so this FAILS CLOSED: if the directory cannot be created we stop
# rather than quietly falling back to a shared name.
#
# PID-only (no uid) deliberately: /tmp is sticky, `syscall(39)` is what the
# pre-existing O_EXCL temp at compile() already uses, and `sys_getuid` is a
# Linux-common wrapper that would not survive this file cross-compiling to
# PE/Mach-O (CLAUDE.md: guard Linux-syscall use in cbt/).
var _cbt_tmpdir_p = 0;

fn _cbt_tmpdir(): i64 {
    if (_cbt_tmpdir_p != 0) { return _cbt_tmpdir_p; }
    # mkdir is EXCLUSIVE, so every attempt below fails closed: we never reuse a
    # directory somebody else created. The suffix loop exists only so our OWN
    # leftovers (PID reuse on a long-lived box) self-heal instead of bricking the
    # CLI. Deliberately no rmdir-and-retry: `sys_rmdir` does not exist on the
    # Windows peer and this file cross-compiles to PE — CLAUDE.md's rule about
    # Linux-syscall use in cbt/, which the first cut of this helper broke and the
    # PE cross-compile gate caught.
    var attempt = 0;
    while (attempt < 16) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "/tmp/cyrius-");
        str_builder_add_int(sb, syscall(39));
        if (attempt > 0) {
            str_builder_add_cstr(sb, "-");
            str_builder_add_int(sb, attempt);
        }
        var d = str_data(str_builder_build(sb));
        if (sys_mkdir(d, 448) == 0) {       # 0700
            _cbt_tmpdir_p = d;
            return d;
        }
        attempt = attempt + 1;
    }
    println("error: cannot create a private temp directory under /tmp (fail-closed)");
    println("  16 candidates were taken; remove stale /tmp/cyrius-* dirs and retry.");
    println("  cyrius will NOT fall back to a shared /tmp name (CVE-35/CVE-36).");
    sys_exit(1);
    return 0;
}

# "<private dir>/<name>" — the replacement for every fixed "/tmp/cyrius_*".
fn _cbt_tmpfile(name): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, _cbt_tmpdir());
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, name);
    return str_data(str_builder_build(sb));
}

fn compile(source, output): i64 {
    var cc = current_cc();
    # v6.2.27: --target=aarch64-bare-metal-elf routes to the aarch64
    # cross-compiler (the same env knobs apply — kernel_mode + ELF64 kernel).
    # HARD-ERROR if cycc_aarch64 is absent (review P1) — never silently fall
    # through to the x86 cycc and build an x86 kernel for an aarch64 target.
    if (_baremetal_aa == 1) {
        if (file_exists(_cc_arm) == 1) { cc = _cc_arm; }
        else {
            _err_ctx("aarch64-bare-metal-elf requested but cycc_aarch64 not found; build it via `cyrius pulsar` (or CI/install)", _cc_arm);
            return 1;
        }
    }
    if (cc == 0) {
        _err("cycc not found. Install Cyrius or set CYRIUS_HOME.");
        return 1;
    }
    if (file_exists(cc) == 0) {
        _err_ctx("compiler not found", cc);
        return 1;
    }
    # v6.5.7: guard the SOURCE the same way the compiler is guarded, two lines up.
    # Without this, `cyrius build <path-that-does-not-exist>.cyr out` printed OK,
    # exited 0 and wrote a ~15 MB do-nothing binary: the stdlib is auto-prepended
    # BEFORE the entry file is read, so a path that matched nothing still yields a
    # valid translation unit containing the whole stdlib and no `main`. It presents
    # as a RUNTIME bug — a program that printed five lines a moment ago goes silent
    # and exits 0 — so the debugging goes into the library, not the build.
    # `is_dir` is required as a SECOND test: file_exists is open-then-close and
    # returns 1 for a directory. One site covers build / run / test / check / soak /
    # smoke, which all route through compile().
    if (file_exists(source) == 0) {
        _err_ctx("no such file", source);
        return 1;
    }
    if (is_dir(str_from(source)) == 1) {
        _err_ctx("not a file", source);
        return 1;
    }
    if (_verbose == 1) {
        sys_write(STDERR_FD, "[verbose] compiler: ", 20);
        sys_write(STDERR_FD, cc, strlen(cc));
        sys_write(STDERR_FD, "\n", 1);
        sys_write(STDERR_FD, "[verbose] source: ", 18);
        sys_write(STDERR_FD, source, strlen(source));
        sys_write(STDERR_FD, "\n", 1);
        sys_write(STDERR_FD, "[verbose] output: ", 18);
        sys_write(STDERR_FD, output, strlen(output));
        sys_write(STDERR_FD, "\n", 1);
    }
    var actual_source = _materialize_source(source);
    # v6.0.85 — Windows path. Win32 has no fork/dup2/execve, and SYS_RENAME(82)
    # + getpid(39) are not PE reroutes, so the POSIX fork+atomic-rename block
    # below can't run here. Spawn `cc < actual_source > output` via cmd.exe
    # (CreateProcessW) and write directly to `output`. Dep/define prepends still
    # apply above (actual_source); a dep build needs a writable temp the Windows
    # path doesn't yet have — tracked for follow-up. See CHANGELOG [6.0.85].
    #ifdef CYRIUS_TARGET_WIN
    var wrc = _win_compile_spawn(cc, actual_source, output);
    if (wrc != 0) { sys_unlink(output); return 1; }
    return 0;
    #endif
    # Atomic-output bug fix: write to a temp output then rename on
    # success. Pre-fix, `output` was opened with O_TRUNC before the
    # compile ran, so any non-zero exit from cycc left an empty
    # file on disk — destroying any previously-working binary.
    var tmp_pid = syscall(39);
    var tmp_out_sb = str_builder_new();
    str_builder_add_cstr(tmp_out_sb, output);
    str_builder_add_cstr(tmp_out_sb, ".tmp.");
    str_builder_add_int(tmp_out_sb, tmp_pid);
    var tmp_out = str_data(str_builder_build(tmp_out_sb));
    sys_unlink(tmp_out);
    # v6.3.3 #5: resolve `[sections] base` from the manifest before fork (parent does
    # the file I/O; the child just appends the result to envp). Bare-metal only.
    # v6.5.7: prove the output is writable BEFORE forking. The child opens `tmp_out`
    # and, on failure, could only `sys_exit(1)` — it has already dup2'd its stdout
    # away and has no channel back — so `cyrius build x.cyr build/nope/deeper/out`
    # printed a bare `FAIL` with no `error:` line and no hint that a directory was
    # missing. Doing the open here costs one syscall on the success path, tells the
    # user which directory is absent, and catches the other reasons (permissions,
    # read-only fs) with an honest message instead of the same silent 1.
    var probe_fd = sys_open(tmp_out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
    if (probe_fd < 0) {
        var odir = _parent_dir(output);
        if (odir != 0) {
            if (is_dir(str_from(odir)) == 0) {
                _err_ctx("output directory does not exist", odir);
                return 1;
            }
        }
        _err_ctx("cannot write output", output);
        return 1;
    }
    sys_close(probe_fd);
    if (_baremetal_target == 1) { _section_base_env_ptr = _sections_base_env(); }
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open(actual_source, O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);

        var ofd = sys_open(tmp_out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);

        # v5.11.63: pass --strict in argv when the wrapper flag was
        # set. cycc/cycc_aarch64 read /proc/self/cmdline at startup
        # (since v5.4.19 / v5.11.63 respectively) — a single
        # `--strict` token anywhere past argv[0] sets _strict_mode,
        # which fixup.cyr's strict-exit reads after the patch loop.
        # argv[24] = 3 × 8 B (cc + optional "--strict" + NUL).
        var argv[24];
        store64(&argv, cc);
        var ax = 1;
        if (_strict == 1) {
            store64(&argv + ax * 8, "--strict");
            ax = ax + 1;
        }
        store64(&argv + ax * 8, 0);
        # v5.11.58: when --strict-pin is set, augment envp with
        # CYRIUS_STRICT_PIN=1 so cycc's pin-drift check (added
        # v5.11.57) exits non-zero on mismatch. CI gating path.
        # v6.0.49: clone _envp + append per-flag vars (--strict-pin →
        # CYRIUS_STRICT_PIN=1; --agnos → CYRIUS_TARGET_AGNOS=1). v6.0.52: --win →
        # CYRIUS_TARGET_WIN=1 (cross-emit a Windows PE32+). Any combination can be
        # set; --win and --agnos are distinct emit targets (don't combine).
        var sp_extra = 0;
        if (_strict_pin == 1) { sp_extra = sp_extra + 1; }
        if (_agnos_target == 1) { sp_extra = sp_extra + 1; }
        if (_win_target == 1) { sp_extra = sp_extra + 1; }
        if (_baremetal_target == 1) { sp_extra = sp_extra + 2; }   # CYRIUS_KERNEL + CYRIUS_ELF64_KERNEL
        if (_baremetal_target == 1 && _section_base_env_ptr != 0) { sp_extra = sp_extra + 1; }   # v6.3.3 #5 CYRIUS_KERNEL_BASE
        if (sp_extra > 0) {
            var sp_count = 0;
            while (load64(_envp + sp_count * 8) != 0) { sp_count = sp_count + 1; }
            var sp_envp = alloc((sp_count + sp_extra + 1) * 8);
            var sp_ej = 0;
            while (sp_ej < sp_count) {
                store64(sp_envp + sp_ej * 8, load64(_envp + sp_ej * 8));
                sp_ej = sp_ej + 1;
            }
            var sp_ni = sp_count;
            if (_strict_pin == 1) { store64(sp_envp + sp_ni * 8, "CYRIUS_STRICT_PIN=1"); sp_ni = sp_ni + 1; }
            if (_agnos_target == 1) { store64(sp_envp + sp_ni * 8, "CYRIUS_TARGET_AGNOS=1"); sp_ni = sp_ni + 1; }
            if (_win_target == 1) { store64(sp_envp + sp_ni * 8, "CYRIUS_TARGET_WIN=1"); sp_ni = sp_ni + 1; }
            if (_baremetal_target == 1) {
                store64(sp_envp + sp_ni * 8, "CYRIUS_KERNEL=1"); sp_ni = sp_ni + 1;
                store64(sp_envp + sp_ni * 8, "CYRIUS_ELF64_KERNEL=1"); sp_ni = sp_ni + 1;
                if (_section_base_env_ptr != 0) { store64(sp_envp + sp_ni * 8, _section_base_env_ptr); sp_ni = sp_ni + 1; }   # v6.3.3 #5
            }
            store64(sp_envp + sp_ni * 8, 0);
            sys_execve(cc, &argv, sp_envp);
        } else {
            sys_execve(cc, &argv, _envp);
        }
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            # Atomic rename: tmp_out → output. Old `output` (if any)
            # is replaced atomically; on rename failure, neither is
            # touched. Both files live on the same FS so rename is
            # POSIX-atomic.
            sys_unlink(output);
            syscall(82, tmp_out, output);   # SYS_RENAME on Linux x86_64
            sys_chmod(output, 0x1ED);
            if (_verbose == 1) {
                # Report binary size
                var stat_buf[144];
                var sr = syscall(4, output, &stat_buf);
                if (sr == 0) {
                    var fsize = load64(&stat_buf + 48);
                    sys_write(STDERR_FD, "[verbose] binary: ", 18);
                    var szbuf[24];
                    var szlen = fmt_int_buf(fsize, &szbuf);
                    sys_write(STDERR_FD, &szbuf, szlen);
                    sys_write(STDERR_FD, " bytes\n", 7);
                }
            }
            return 0;
        }
    }
    # Compile failed: unlink the partial tmp output. The original
    # `output` (if any) is preserved untouched.
    sys_unlink(tmp_out);
    if (_verbose == 1) {
        sys_write(STDERR_FD, "[verbose] compile failed (exit ", 30);
        var ebuf[24];
        var elen = fmt_int_buf(WEXITSTATUS(status), &ebuf);
        sys_write(STDERR_FD, &ebuf, elen);
        sys_write(STDERR_FD, ")\n", 2);
    }
    return 1;
}

# Run a binary — directly for x86, via qemu for aarch64
# Run a shell command via /bin/sh -c. Returns exit code.
fn sys_system(cmd): i64 {
    var argv[40];   # N BYTES per CLAUDE.md buffer contract: 4 ptrs need 32 B
    var pid = sys_fork();
    if (pid == 0) {
        store64(&argv, "/bin/sh");
        store64(&argv + 8, "-c");
        store64(&argv + 16, cmd);
        store64(&argv + 24, 0);
        sys_execve("/bin/sh", &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 1;
}

# Ad-hoc codesign a freshly-compiled Mach-O binary so Apple-Silicon AMFI doesn't
# SIGKILL it (exit 137). No-op off macOS (the #ifdef strips it); harmless on
# x86-macOS (codesign -s - rejects but 2>/dev/null swallows it, and the unsigned
# binary runs there anyway). Hoisted from cmd_build's inline v6.0.38 codesign so
# every run path signs. See CHANGELOG [6.0.66].
fn _macho_codesign(path): i64 {
    #ifdef CYRIUS_TARGET_MACOS
    var cs = str_builder_new();
    str_builder_add_cstr(cs, "codesign -s - -f ");
    str_builder_add_cstr(cs, path);
    str_builder_add_cstr(cs, " 2>/dev/null");
    sys_system(str_data(str_builder_build(cs)));
    #endif
    return 0;
}

fn run_binary(path): i64 {
    var argv[40];   # N BYTES per CLAUDE.md buffer contract: cmd + arg + NUL ≤ 24 B
    # Bug 2 (v6.0.66): cmd_test/run/bench/fuzz/doctest compile to /tmp and run via
    # run_binary without signing — only cmd_build signed (6.0.38). On arm64 macOS an
    # unsigned binary is AMFI-SIGKILL'd (128+9=137). Sign here so EVERY run path works.
    _macho_codesign(path);
    var pid = sys_fork();
    if (pid == 0) {
        # Bug 1 (v6.0.66): qemu-aarch64 is the x86-Linux-host cross-run path for an
        # aarch64 TARGET. A native Mach-O host (Apple Silicon) has NO qemu-aarch64 and
        # runs its own arch directly; find_tools() forces _arch=AARCH64 on arm64-macOS,
        # so this branch execve-failed → exit 127 with zero test output (the yantra
        # Apple-Silicon `cyrius test` failure). Gate it OUT on macOS — exec directly.
        #ifndef CYRIUS_TARGET_MACOS
        if (_arch == ARCH_AARCH64) {
            store64(&argv, "/usr/bin/qemu-aarch64");
            store64(&argv + 8, path);
            store64(&argv + 16, 0);
            sys_execve("/usr/bin/qemu-aarch64", &argv, _envp);
            sys_exit(127);
        }
        #endif
        store64(&argv, path);
        store64(&argv + 8, 0);
        sys_execve(path, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
    return 1;
}

# Run an external tool by path, passing through args
fn run_tool(tool, arg1, arg2, arg3): i64 {
    if (file_exists(tool) == 0) {
        _err_ctx("tool not found", tool);
        return 1;
    }
    var pid = sys_fork();
    if (pid == 0) {
        var argv[48];   # N BYTES per CLAUDE.md buffer contract: tool + ≤3 args + NUL = 40 B
        store64(&argv, tool);
        var ai = 1;
        if (arg1 != 0) { store64(&argv + ai * 8, arg1); ai = ai + 1; }
        if (arg2 != 0) { store64(&argv + ai * 8, arg2); ai = ai + 1; }
        if (arg3 != 0) { store64(&argv + ai * 8, arg3); ai = ai + 1; }
        store64(&argv + ai * 8, 0);
        sys_execve(tool, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 1;
}

# Like run_tool but forwards the CLI's own argv tail (argv[from_idx..])
# verbatim, optionally prepending `sentinel`. Used by the native
# scaffolder dispatch (cmd_init / cmd_port) so the full flag matrix
# reaches programs/cyrius-init.cyr intact — run_tool caps at 3 args,
# which silently dropped flags like `cyrius init --lib --description=x name`.
# Inherits the real environment (_envp, populated by load_environ) so the
# scaffolder's getenv (HOME / CYRIUS_HOME / XDG_CONFIG_HOME / CYRIUS_VER /
# PWD) resolves. v6.2.40 (init/port native-port slot).
fn run_tool_argvtail(tool, from_idx, sentinel): i64 {
    if (file_exists(tool) == 0) {
        _err_ctx("tool not found", tool);
        return 1;
    }
    var pid = sys_fork();
    if (pid == 0) {
        var n = argc();
        var extra = 1;                       # tool slot
        if (sentinel != 0) { extra = 2; }    # tool + sentinel
        var av = alloc((n - from_idx + extra + 1) * 8);
        var ai = 0;
        store64(av + ai * 8, tool); ai = ai + 1;
        if (sentinel != 0) { store64(av + ai * 8, sentinel); ai = ai + 1; }
        var i = from_idx;
        while (i < n) {
            store64(av + ai * 8, argv(i));
            ai = ai + 1;
            i = i + 1;
        }
        store64(av + ai * 8, 0);
        sys_execve(tool, av, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 1;
}

# Run a shell script
# v5.10.48 defensive guard: surface a clean error when the script
# doesn't exist rather than silently invoking `/bin/sh <missing>`
# which exits 2 with no context. Surfaced via `cyrius audit`
# invoking `~/.cyrius/bin/check.sh` outside the cyrius repo (the
# script ships in `scripts/check.sh` but isn't installed via
# `cyrius pulsar`). Held from v5.9.4; one-line guard applies to
# every script caller (cyrius audit, cyrius capacity --script,
# etc.). The full design call (clean error vs polymorphic
# project-level audit) stays held until user picks semantics; the
# defensive guard ships now.
fn run_script(script, arg1, arg2): i64 {
    if (file_exists(script) == 0) {
        _err_ctx("script not found", script);
        return 127;
    }
    return run_tool("/bin/sh", script, arg1, arg2);
}

# ── Cross-OS self-host gate support (v6.0.33) ──
# The default _envp (cbt/core.cyr) is empty, so an execve'd `ssh` would
# lack HOME / SSH_AUTH_SOCK and fail to reach the verification hosts.
# Reconstruct the real environment from /proc/self/environ so ssh/scp
# behave exactly as they would in the user's shell.
var _co_env_buf[32768];     # 32 KB of NUL-separated NAME=VALUE pairs
var _co_env_ptrs[8192];     # 1024 char* slots (8 bytes each)

# Build a NULL-terminated char** of the current environment. Returns
# &_co_env_ptrs, or 0 on failure (then callers fall back to _envp).
fn _co_build_envp(): i64 {
    var fd = sys_open("/proc/self/environ", 0, 0);
    if (fd < 0) { return 0; }
    var n = sys_read(fd, &_co_env_buf, 32767);
    sys_close(fd);
    if (n <= 0) { return 0; }
    store8(&_co_env_buf + n, 0);
    var pc = 0;
    store64(&_co_env_ptrs, &_co_env_buf);   # first entry starts at byte 0
    pc = 1;
    var i = 0;
    while (i < n) {
        if (load8(&_co_env_buf + i) == 0) {
            if (i + 1 < n) {
                if (pc < 1023) {
                    store64(&_co_env_ptrs + pc * 8, &_co_env_buf + i + 1);
                    pc = pc + 1;
                }
            }
        }
        i = i + 1;
    }
    store64(&_co_env_ptrs + pc * 8, 0);      # NULL-terminate the vector
    return &_co_env_ptrs;
}

# Run `/bin/sh -c <cmd>` with the real environment. Returns the shell
# exit status (0 = success). Used by the cross-OS self-host gate so the
# proven ssh/scp self-host sequence runs with full env.
fn _co_run_sh(cmd): i64 {
    var envp = _co_build_envp();
    if (envp == 0) { envp = _envp; }
    var pid = sys_fork();
    if (pid == 0) {
        var argv[32];                         # 4 char* slots
        store64(&argv, "/bin/sh");
        store64(&argv + 8, "-c");
        store64(&argv + 16, cmd);
        store64(&argv + 24, 0);
        sys_execve("/bin/sh", &argv, envp);
        sys_exit(127);
    }
    var st[8];
    sys_waitpid(pid, &st, 0);
    var status = load32(&st);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 1;
}

