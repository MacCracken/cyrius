# ================================================================
# Core operations
# ================================================================

# v6.1.12: `cyrius build --target=js <source.tsx> <output.js>` — surface cycc's
# `--emit-js` (v6.1.11 TS/TSX → browser-JS emitter) through the CLI. Distinct
# from the native compile path: cycc reads the source as a PATH arg and writes
# JS to stdout (no stdin pipe, no dep/define prepend — JS emit doesn't take
# cyrius includes). We fork cycc with [cc, "--emit-js", source, 0] and dup2 the
# output file onto stdout. x86-Linux-only (the TS frontend is). See CHANGELOG [6.1.12].
fn _emit_js(source, output): i64 {
    # v6.6.6 — PE arm. The fork below is a -1 stub on Windows and the wait that follows
    # it decodes an uninitialised status slot, so this used to report a plausible result
    # for a compiler that never ran. It cannot work there at all: see
    # `_win_emit_js_refuse`. CHANGELOG [6.6.6].
    #ifdef CYRIUS_TARGET_WIN
    return _win_emit_js_refuse();
    #endif
    var cc = current_cc();
    if (cc == 0) {
        _err("cycc not found. Install Cyrius or set CYRIUS_HOME.");
        return 1;
    }
    if (file_exists(cc) == 0) {
        _err_ctx("compiler not found", cc);
        return 1;
    }
    # Atomic-output: emit to a temp then rename on success, so a failed emit
    # never leaves a truncated .js over a previously-good one (mirrors compile()).
    var tmp_pid = sys_getpid();
    var tmp_out_sb = str_builder_new();
    str_builder_add_cstr(tmp_out_sb, output);
    str_builder_add_cstr(tmp_out_sb, ".tmp.");
    str_builder_add_int(tmp_out_sb, tmp_pid);
    var tmp_out = str_data(str_builder_build(tmp_out_sb));
    sys_unlink(tmp_out);
    var pid = sys_fork();
    if (pid == 0) {
        var ofd = sys_open(tmp_out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);
        # argv: cc, "--emit-js", <source path>, NUL. emit-js reads the path arg,
        # writes JS to stdout (now the output file). No envp injection needed.
        var argv[32];
        store64(&argv, cc);
        store64(&argv + 8, "--emit-js");
        store64(&argv + 16, source);
        store64(&argv + 24, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            sys_unlink(output);
            syscall(82, tmp_out, output);   # SYS_RENAME on Linux x86_64
            sys_chmod(output, 0x1A4);        # 0644 — JS is data, not executable
            return 0;
        }
    }
    sys_unlink(tmp_out);
    return 1;
}

# cx arc: ensure the cx bytecode compiler (cycc_cx) exists, JIT-building it from
# src/main_cx.cyr with the host cycc if absent (the cross_bins "rebuilt on demand"
# model — install.sh also builds it, but this covers in-repo / first-use). Sets
# _cc_cx to a runnable path. Returns 0 on success, 1 on failure.
fn _ensure_cc_cx(): i64 {
    if (_cc_cx != 0) { if (file_exists(_cc_cx) == 1) { return 0; } }
    var cc = current_cc();
    if (cc == 0) { _err("cycc not found — cannot build the cx compiler"); return 1; }
    if (file_exists(cc) == 0) { _err_ctx("compiler not found", cc); return 1; }
    if (file_exists("src/main_cx.cyr") == 0) {
        _err_ctx("cx compiler source missing (need src/main_cx.cyr)", "src/main_cx.cyr");
        return 1;
    }
    sys_mkdir("build", 0x1ED);
    var out = "./build/cycc_cx";
    # v6.6.6 — PE arm. `.exe` is not cosmetic: `_emit_cx` SPAWNS this binary, and
    # CreateProcessW with no application name appends `.exe` to an extensionless program
    # name, so `./build/cycc_cx` would be looked up as `./build/cycc_cx.exe` and never
    # found. Same rule `_cbt_tmpexe` exists for. CHANGELOG [6.6.6].
    #ifdef CYRIUS_TARGET_WIN
    out = "./build/cycc_cx.exe";
    if (_win_compile_spawn(cc, "src/main_cx.cyr", out) == 0) {
        _cc_cx = out;
        return 0;
    }
    xunlink(out);
    _err("failed to build the cx compiler (cycc_cx) from src/main_cx.cyr");
    return 1;
    #endif
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open("src/main_cx.cyr", O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);
        var ofd = sys_open(out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);
        var argv[16];   # N BYTES: cc + NUL = 2 slots. Was [8] = ONE slot, NUL overflowed (CHANGELOG [6.6.5])
        store64(&argv, cc);
        store64(&argv + 8, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            sys_chmod(out, 0x1ED);
            _cc_cx = out;
            return 0;
        }
    }
    _err("failed to build the cx compiler (cycc_cx) from src/main_cx.cyr");
    return 1;
}

# cx arc: compile <source>.cyr → <output>.cyx via cycc_cx. Unlike _emit_js (which
# passes the source as a path arg), the cx fork reads .cyr from STDIN and writes
# .cyx to STDOUT — so the child dup2's BOTH the source onto fd 0 and the temp
# output onto fd 1. Atomic tmp-then-rename, like _emit_js / compile().
fn _emit_cx(source, output): i64 {
    if (_ensure_cc_cx() != 0) { return 1; }
    var cc = _cc_cx;
    var tmp_pid = sys_getpid();
    var tmp_out_sb = str_builder_new();
    str_builder_add_cstr(tmp_out_sb, output);
    str_builder_add_cstr(tmp_out_sb, ".tmp.");
    str_builder_add_int(tmp_out_sb, tmp_pid);
    var tmp_out = str_data(str_builder_build(tmp_out_sb));
    sys_unlink(tmp_out);
    # v6.6.6 — PE arm. Keeps the tmp-then-rename: `file_rename` (lib/io.cyr) IS routed
    # on PE as MoveFileExW/0xF034, so a failed cx emit cannot leave a truncated .cyx over
    # a previously-good one on Windows either. CHANGELOG [6.6.6].
    #ifdef CYRIUS_TARGET_WIN
    if (_win_compile_spawn(cc, source, tmp_out) == 0) {
        if (file_rename(tmp_out, output) == 0) { return 0; }
        _err_ctx("cx emit: could not rename the temp output onto", output);
    }
    xunlink(tmp_out);
    return 1;
    #endif
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open(source, O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);
        var ofd = sys_open(tmp_out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);
        var argv[16];   # N BYTES: cc + NUL = 2 slots. Was [8] = ONE slot, NUL overflowed (CHANGELOG [6.6.5])
        store64(&argv, cc);
        store64(&argv + 8, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            sys_unlink(output);
            syscall(82, tmp_out, output);   # SYS_RENAME on Linux x86_64
            sys_chmod(output, 0x1A4);        # 0644 — .cyx is data, not executable
            return 0;
        }
    }
    sys_unlink(tmp_out);
    return 1;
}

# cx arc: ensure the cx VM (cxvm) exists, JIT-building it from programs/cxvm.cyr
# with the host cycc if absent (install.sh also ships it via [release].bins).
fn _ensure_cxvm(): i64 {
    if (_cxvm != 0) { if (file_exists(_cxvm) == 1) { return 0; } }
    var cc = current_cc();
    if (cc == 0) { _err("cycc not found — cannot build cxvm"); return 1; }
    if (file_exists(cc) == 0) { _err_ctx("compiler not found", cc); return 1; }
    if (file_exists("programs/cxvm.cyr") == 0) {
        _err_ctx("cxvm source missing (need programs/cxvm.cyr)", "programs/cxvm.cyr");
        return 1;
    }
    sys_mkdir("build", 0x1ED);
    var out = "./build/cxvm";
    # v6.6.6 — PE arm; `.exe` for the same CreateProcessW lookup rule as cycc_cx above
    # (`_win_run_cx` spawns this one). CHANGELOG [6.6.6].
    #ifdef CYRIUS_TARGET_WIN
    out = "./build/cxvm.exe";
    if (_win_compile_spawn(cc, "programs/cxvm.cyr", out) == 0) {
        _cxvm = out;
        return 0;
    }
    xunlink(out);
    _err("failed to build cxvm from programs/cxvm.cyr");
    return 1;
    #endif
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open("programs/cxvm.cyr", O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);
        var ofd = sys_open(out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);
        var argv[16];   # N BYTES: cc + NUL = 2 slots. Was [8] = ONE slot, NUL overflowed (CHANGELOG [6.6.5])
        store64(&argv, cc);
        store64(&argv + 8, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            sys_chmod(out, 0x1ED);
            _cxvm = out;
            return 0;
        }
    }
    _err("failed to build cxvm from programs/cxvm.cyr");
    return 1;
}

# v6.6.5 — build the child's argv: [path, args..., NUL], or with qemu-aarch64
# prepended when we are cross-running an aarch64 binary on an x86 host. `args` is a
# vec of cstr (the program's own arguments, go-run style) or 0. A heap array, not a
# fixed `var argv[40]`: the old one held 5 slots and had nowhere to put them.
fn _run_argv(path, args, qemu): i64 {
    var n = 0;
    if (args != 0) { n = vec_len(args); }
    var base = 1;
    if (qemu != 0) { base = 2; }
    var av = alloc((n + base + 1) * 8);
    var o = 0;
    if (qemu != 0) { store64(av, qemu); o = 1; }
    store64(av + o * 8, path);
    o = o + 1;
    var i = 0;
    while (i < n) {
        store64(av + (o + i) * 8, vec_get(args, i));
        i = i + 1;
    }
    store64(av + (o + n) * 8, 0);
    return av;
}

# cx arc: run a .cyx bytecode file via cxvm. cxvm reads the .cyx from STDIN and
# exits with the guest program's exit code — so the child dup2's the .cyx onto
# fd 0, then execs cxvm. Mirrors run_binary's fork/waitpid/exit-status shape.
fn run_cx(cyx_path): i64 {
    if (_ensure_cxvm() != 0) { return 1; }
    var vm = _cxvm;
    #ifdef CYRIUS_TARGET_WIN
    return _win_run_cx(vm, cyx_path);
    #endif
    var pid = sys_fork();
    if (pid == 0) {
        var fd = sys_open(cyx_path, O_RDONLY, 0);
        if (fd < 0) { sys_exit(1); }
        sys_dup2(fd, 0);
        sys_close(fd);
        # v6.6.5 — `var argv[8]` is 8 BYTES, i.e. ONE slot, so the NUL terminator at
        # +8 landed on the next local's stack slot (a probe measured &argv+8 == &fd).
        # It worked by luck. _run_argv heap-allocates. NO program arguments: cxvm has no
        # guest argv ABI, so cmd_run refuses them for a .cyx rather than hand cxvm
        # arguments it would silently ignore (round-2 review; CHANGELOG [6.6.5]).
        var av = _run_argv(vm, 0, 0);
        sys_execve(vm, av, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
    return 1;
}

# v6.3.3 #5: parse `[sections] base = "0x.."` from the cwd's cyrius.cyml and build
# a "CYRIUS_KERNEL_BASE=0x.." env string (alloc'd) for the cycc spawn, or 0 if the
# block / key is absent. Same line-scan idiom as `_parse_toml_str_array` in cbt/deps.cyr; cbt is
# cycc-compiled (no cybs limits). Only consulted on bare-metal builds. The `[sections]`
# block is bare-metal section-placement control (deliverable #5); today it exposes the
# image load base — the one knob a freestanding kernel/firmware consumer needs.
fn _sections_base_env(): i64 {
    if (file_exists("cyrius.cyml") == 0) { return 0; }
    var buf = alloc(32768);
    var n = file_read_all("cyrius.cyml", buf, 32767);
    if (n <= 0) { return 0; }
    var pos = 0;
    while (pos < n) {
        if (memeq(buf + pos, "[sections]", 10) == 1 && _toml_section_at(buf, n, pos) == 1) { break; }
        pos = pos + 1;
    }
    if (pos >= n) { return 0; }
    pos = pos + 10;
    while (pos < n) {
        while (pos < n && (load8(buf + pos) == 10 || load8(buf + pos) == 32 || load8(buf + pos) == 9)) { pos = pos + 1; }
        if (pos >= n) { return 0; }
        if (load8(buf + pos) == 91) { return 0; }   # '[' — next section ends the block
        if (memeq(buf + pos, "base", 4) == 1) {
            var after = pos + 4;
            while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) { after = after + 1; }
            if (after < n && load8(buf + after) == 61) {   # '='
                after = after + 1;
                while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) { after = after + 1; }
                if (after < n && load8(buf + after) == 34) {   # '"'
                    after = after + 1;
                    var out = alloc(64);
                    var pfx = "CYRIUS_KERNEL_BASE=";
                    var pi = 0;
                    while (load8(pfx + pi) != 0) { store8(out + pi, load8(pfx + pi)); pi = pi + 1; }
                    var vi = 0;
                    while (after < n && load8(buf + after) != 34 && load8(buf + after) != 10 && vi < 40) {
                        store8(out + pi + vi, load8(buf + after));
                        vi = vi + 1; after = after + 1;
                    }
                    store8(out + pi + vi, 0);
                    # Parse the numeric base from the copied "0x.." value (for the D6 report).
                    _section_base_val = 0;
                    if (load8(out + pi) == 48 && (load8(out + pi + 1) == 120 || load8(out + pi + 1) == 88)) {
                        var hp = pi + 2;
                        var acc = 0;
                        var hc = load8(out + hp);
                        while (hc != 0) {
                            var dd = 0 - 1;
                            if (hc >= 48 && hc <= 57) { dd = hc - 48; }
                            elif (hc >= 97 && hc <= 102) { dd = hc - 97 + 10; }
                            elif (hc >= 65 && hc <= 70) { dd = hc - 65 + 10; }
                            if (dd < 0) { break; }
                            acc = acc * 16 + dd;
                            hp = hp + 1; hc = load8(out + hp);
                        }
                        _section_base_val = acc;
                    }
                    return out;
                }
                return 0;
            }
        }
        while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
    }
    return 0;
}

# v6.4.73 — the manifest auto-prepend, factored out of compile() so it has exactly
# ONE implementation. `cyrius capacity` forks cycc directly (it needs CYRIUS_STATS=1
# in the child env) instead of going through compile(), so pre-.73 it fed cycc the
# RAW source with no dep includes at all — every stdlib fn came back undefined, the
# compile aborted before the stats block, and `--check` then read ZERO stats lines
# and cheerfully printed "ok (all caps under 85%)". Duplicating the prepend into
# cmd_capacity would just set up the two copies to drift, so both call this.
#
# Returns the path to actually hand the compiler: `source` itself when there is
# nothing to prepend, else a /tmp temp holding [dep includes][defines][build
# modules][source]. Honors _skip_deps exactly as before. CHANGELOG [6.4.73].
# v6.5.7: the directory component of `source`, or 0 if there is nothing useful to
# say. cycc compiles from STDIN and so cannot know where its input lives; this is
# the value that rides in-band as `#@incdir` so an `include` can find a file
# sitting next to the source. See common/util.cyr for the full why.
#
# Returns 0 — meaning "emit no marker", which leaves today's behaviour exactly as
# it is — for anything cycc would refuse anyway:
#   - no directory component (already CWD-relative; the marker would be a no-op)
#   - an ABSOLUTE path. ⛔ Deliberate, and the one real limit of this feature.
#     The marker is in-band, so a hostile .cyr can write one; honouring an absolute
#     directory would rebuild the read-anything primitive CVE-16 removed, and cycc
#     rejects it for that reason. Relativising against CWD instead would need a
#     `getcwd` wrapper that does not exist on the PE/Mach-O targets cbt/cyrius.cyr
#     cross-compiles to. So `cyrius build /abs/dir/x.cyr` keeps resolving includes
#     against CWD, as it does today — no regression, and no hole bought with reach.
#   - a `..` component, for the CVE-02 half of the same argument.
fn _source_incdir(source): i64 {
    var n = strlen(source);
    if (n == 0) { return 0; }
    if (load8(source) == 47) { return 0; }
    if (load8(source) == 92) { return 0; }
    if (n > 1) { if (load8(source + 1) == 58) { return 0; } }
    var cut = 0 - 1;
    var i = 0;
    while (i < n) {
        var c = load8(source + i);
        if (c == 47) { cut = i; }
        if (c == 92) { cut = i; }
        i = i + 1;
    }
    if (cut <= 0) { return 0; }
    var j = 0;
    while (j < cut) {
        if (load8(source + j) == 46) {
            if (load8(source + j + 1) == 46) {
                if (j == 0) { return 0; }
                if (load8(source + j - 1) == 47) { return 0; }
                if (load8(source + j - 1) == 92) { return 0; }
            }
        }
        j = j + 1;
    }
    var sb = str_builder_new();
    var k = 0;
    while (k < cut) { str_builder_add_byte(sb, load8(source + k)); k = k + 1; }
    return str_data(str_builder_build(sb));
}

# v6.5.7: the directory component of any path, or 0 when there is none. Unlike
# `_source_incdir` this has NO security constraints to honour — it feeds an error
# message, not a file open — so absolute paths and `..` are reported as-is.
fn _parent_dir(path): i64 {
    var n = strlen(path);
    var cut = 0 - 1;
    var i = 0;
    while (i < n) {
        var c = load8(path + i);
        if (c == 47) { cut = i; }
        if (c == 92) { cut = i; }
        i = i + 1;
    }
    if (cut < 0) { return 0; }
    if (cut == 0) { return "/"; }
    var sb = str_builder_new();
    var k = 0;
    while (k < cut) { str_builder_add_byte(sb, load8(path + k)); k = k + 1; }
    return str_data(str_builder_build(sb));
}

fn _materialize_source(source): i64 {
    # Build temp file if we have dep includes or defines to prepend.
    # v5.7.8: _skip_deps suppresses the manifest auto-prepend; defines
    # and build-modules still apply.
    var actual_source = source;
    var need_tmp = 0;
    # v6.5.7: a source in a subdirectory needs the temp file even with nothing to
    # prepend, because the `#@incdir` marker is the thing being prepended.
    var incdir = _source_incdir(source);
    if (incdir != 0) { need_tmp = 1; }
    if (_skip_deps == 0) {
        if (_dep_includes != 0) { if (vec_len(_dep_includes) > 0) { need_tmp = 1; } }
    }
    if (_defines != 0) { if (vec_len(_defines) > 0) { need_tmp = 1; } }
    if (_build_modules != 0) { if (vec_len(_build_modules) > 0) { need_tmp = 1; } }
    if (need_tmp == 1) {
        # Atomic temp file: O_EXCL rejects if path already exists (TOCTOU safe)
        var pid = sys_getpid();
        var tmp_sb = str_builder_new();
        str_builder_add_cstr(tmp_sb, _cbt_tmpfile("cpp_"));
        str_builder_add_int(tmp_sb, pid);
        var tmp = str_data(str_builder_build(tmp_sb));
        # Unlink first so O_EXCL succeeds on re-runs with same PID
        sys_unlink(tmp);
        var tfd = sys_open(tmp, O_WRONLY | O_CREAT | O_EXCL, 0x180);
        if (tfd >= 0) {
            # v6.5.7: `#@incdir` FIRST — cycc honours the marker only at byte 0, so
            # that the CLI's value is the one it reads and a marker further down the
            # file (what a hostile include would write) stays an ordinary comment.
            # Nothing may be emitted above this line.
            if (incdir != 0) {
                sys_write(tfd, "#@incdir ", 9);
                sys_write(tfd, incdir, strlen(incdir));
                sys_write(tfd, "\n", 1);
            }
            # v6.5.21 — `#@pkgver <version>` directly after `#@incdir`, surfacing
            # `[package].version` to source as `CYRIUS_PKG_VERSION`. cycc REPLACES
            # this line with the declaration and emits no newline for it, so unlike
            # every other prepend below it does not shift `<source>` line numbers.
            # Emitted only when the manifest actually resolves a version — no
            # marker beats a wrong one.
            var _pkgver = _dep_read_cyml_package_version();
            if (_pkgver != 0) {
                sys_write(tfd, "#@pkgver ", 9);
                sys_write(tfd, _pkgver, strlen(_pkgver));
                sys_write(tfd, "\n", 1);
            }
            # Prepend dep includes (v5.7.8: skipped under _skip_deps)
            if (_skip_deps == 0) {
                if (_dep_includes != 0) {
                    var ii = 0;
                    while (ii < vec_len(_dep_includes)) {
                        var inc = vec_get(_dep_includes, ii);
                        sys_write(tfd, "include \"", 9);
                        sys_write(tfd, inc, strlen(inc));
                        sys_write(tfd, "\"\n", 2);
                        ii = ii + 1;
                    }
                }
            }
            # Prepend defines
            if (_defines != 0) {
                var di = 0;
                while (di < vec_len(_defines)) {
                    var def = vec_get(_defines, di);
                    sys_write(tfd, "#define ", 8);
                    sys_write(tfd, def, strlen(def));
                    sys_write(tfd, "\n", 1);
                    di = di + 1;
                }
            }
            # Append build modules (concatenated before entry point)
            if (_build_modules != 0) {
                var mi = 0;
                while (mi < vec_len(_build_modules)) {
                    var mpath = vec_get(_build_modules, mi);
                    var mfd = sys_open(mpath, O_RDONLY, 0);
                    if (mfd >= 0) {
                        var mbuf = alloc(32768);
                        var mn = 1;
                        while (mn > 0) {
                            mn = syscall(0, mfd, mbuf, 32768);
                            if (mn > 0) { syscall(1, tfd, mbuf, mn); }
                        }
                        sys_close(mfd);
                        sys_write(tfd, "\n", 1);
                    }
                    mi = mi + 1;
                }
            }
            # v6.5.24 — `#@srcline` marks where the ENTRY FILE's own line 1 begins, so
            # every prepend above stops shifting `<source>` diagnostics. MUST be the last
            # thing written before the source itself.
            #
            # Until now only `#@incdir` was compensated, so a diagnostic was reported one
            # line late per prepended line: abaco's 18-module `[deps].stdlib` shifted every
            # diagnostic by +17 and pointed PAST EOF on a 23-line file, which reads as a
            # compiler fault rather than a source defect
            # (2026-08-13-source-diag-line-shift-scales-with-deps-stdlib).
            #
            # ⭐ Deliberately carries NO COUNT. cycc derives the bias from the marker's own
            # line position, so nothing here has to know how many lines were prepended —
            # which is the only workable design once `[build].modules` is in play, since
            # those splice in whole files of unknown length. A hand-maintained count would
            # be exactly the self-drifting-value shape that bit three separate places this
            # cycle.
            sys_write(tfd, "#@srcline\n", 10);
            # Append source file (stream copy for large files)
            var sfd2 = sys_open(source, O_RDONLY, 0);
            if (sfd2 >= 0) {
                var cbuf = alloc(32768);
                var cn = 1;
                while (cn > 0) {
                    cn = syscall(0, sfd2, cbuf, 32768);
                    if (cn > 0) { syscall(1, tfd, cbuf, cn); }
                }
                sys_close(sfd2);
            }
            sys_close(tfd);
            actual_source = tmp;
        }
    }
    return actual_source;
}

# Compile source.cyr to output using current compiler.
# If _defines vec is set, prepend #define lines to a temp file first.
# ---------------------------------------------------------------------------
# Private per-invocation temp directory (v6.4.81 — CVE-35 / CVE-36)
# ---------------------------------------------------------------------------
# The CLI used 23 FIXED /tmp literals. Two classes of problem, both needing a
# shared or multi-user box (or shared CI) to matter:
#
#   CVE-35 — the DEPENDENCY-INTEGRITY controls read their result out of one:
#     `_sha256sum_file` (the digests that go into cyrius.lock) captured through
#     "/tmp/cyrius_sha_out" and `_git_head_sha` (the force-pushed-tag refusal)
#     through "/tmp/cyrius_githead_out", both O_CREAT|O_TRUNC with no O_EXCL and
#     no O_NOFOLLOW. An attacker who holds the name supplies the digest, so
#     `cyrius deps --verify` passes on a tampered dependency. The security
#     control itself is what gets subverted.
#
#   CVE-36 — `cyrius run/test/fuzz/bench/soak` compiled to a fixed name and then
#     EXECUTED it. (Narrowly: `compile()` writes <out>.tmp.<pid> and renames, and
#     rename(2) REPLACES a planted symlink rather than following it, so the naive
#     pre-plant does not work — but the final name is still predictable and the
#     window before execve is still there.)
#
# One private directory removes the shared namespace for both. mkdir is
# exclusive, so this FAILS CLOSED: if the directory cannot be created we stop
# rather than quietly falling back to a shared name.
#
# PID-only (no uid) deliberately: /tmp is sticky, and `sys_getuid` is a
# Linux-common wrapper that would not survive this file cross-compiling to
# PE/Mach-O (CLAUDE.md: guard Linux-syscall use in cbt/).
#
# ⛔ v6.6.5 (round-3 review) — THE PID WAS A RAW `syscall(39)` AND THE BASE WAS A
# LITERAL "/tmp", and neither exists on Windows. 39 is not a PE reroute, so it returned
# -38 on EVERY run and every PE invocation raced for the same `/tmp/cyrius--38[-N]`
# names; under wine 16 runs used up all 16 candidates and `cyrius lint` then failed
# CLOSED ("16 candidates were taken") on the shipped Windows layout — cycc.exe present,
# so the syntax pre-pass needs a temp. On real Windows "/tmp" is `<drive>:\tmp`, which a
# stock install does not have, so it failed closed on the FIRST run. Now: `sys_getpid()`
# (GetCurrentProcessId on PE, SYS_GETPID elsewhere), the per-user %TEMP% (then %TMP%)
# as the base on Windows, and a FILETIME nonce in the Windows name. The nonce was added
# at 6.6.5 because there was no RemoveDirectoryW reroute, so our own empty dirs were
# never removed while Windows recycles PIDs quickly — a PID-only name would run out of
# the 16 suffixes on a busy box and brick the CLI. ⚠ 6.6.6 WIRED THAT REROUTE (0xF03A)
# and the directory is now removed at exit on PE too, so the nonce is no longer
# load-bearing — it is kept because a SIGKILLed run still leaves one and the cost is a
# few characters of path. CHANGELOG [6.6.5], [6.6.6].
var _cbt_tmpdir_p = 0;

#ifdef CYRIUS_TARGET_WIN
var _cbt_tmpbase_buf[64];    # 512 bytes (a top-level array is N x 8)
#endif

fn _cbt_tmpbase(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var t = _win_getenv_into("TEMP", &_cbt_tmpbase_buf);
    if (t == 0) { t = _win_getenv_into("TMP", &_cbt_tmpbase_buf); }
    return t;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    return "/tmp";
    #endif
}

# Windows only: milliseconds from GetSystemTimeAsFileTime (0xF01B), mod 1e9. -1
# elsewhere (the POSIX name stays `cyrius-<pid>[-N]`, which the leak gates key on).
fn _cbt_tmp_nonce(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var ft[16];
    store64(&ft, 0);
    syscall(0xF01B, &ft);
    return (load64(&ft) / 10000) % 1000000000;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    return 0 - 1;
    #endif
}

fn _cbt_tmpdir(): i64 {
    if (_cbt_tmpdir_p != 0) { return _cbt_tmpdir_p; }
    # mkdir is EXCLUSIVE, so every attempt below fails closed: we never reuse a
    # directory somebody else created. The suffix loop exists only so our OWN
    # leftovers (PID reuse on a long-lived box) self-heal instead of bricking the
    # CLI. Deliberately no rmdir-and-retry: reusing a name we did not just create is
    # the CVE-35/CVE-36 shape, and `xrmdir` (lib/io.cyr, the portable wrapper — never
    # the raw `sys_rmdir`, which does not exist on the Windows peer and whose agnos
    # arity differs) is for OUR directory at exit, not for clearing somebody's.
    var base = _cbt_tmpbase();
    if (base == 0) {
        println("error: cannot create a private temp directory: neither %TEMP% nor %TMP% is set (fail-closed)");
        sys_exit(1);
    }
    var nonce = _cbt_tmp_nonce();
    var attempt = 0;
    while (attempt < 16) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, base);
        str_builder_add_cstr(sb, "/cyrius-");
        str_builder_add_int(sb, sys_getpid());
        if (nonce >= 0) {
            str_builder_add_cstr(sb, "-t");
            str_builder_add_int(sb, nonce);
        }
        if (attempt > 0) {
            str_builder_add_cstr(sb, "-");
            str_builder_add_int(sb, attempt);
        }
        var d = str_data(str_builder_build(sb));
        if (sys_mkdir(d, 448) == 0) {       # 0700
            _cbt_tmpdir_p = d;
            return d;
        }
        attempt = attempt + 1;
    }
    sys_write(STDOUT_FD, "error: cannot create a private temp directory under ", 52);
    sys_write(STDOUT_FD, base, strlen(base));
    println(" (fail-closed)");
    println("  16 candidates were taken; remove stale cyrius-* dirs there and retry.");
    println("  cyrius will NOT fall back to a shared temp name (CVE-35/CVE-36).");
    sys_exit(1);
    return 0;
}

# "<private dir>/<name>" — the replacement for every fixed "/tmp/cyrius_*".
fn _cbt_tmpfile(name): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, _cbt_tmpdir());
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, name);
    return str_data(str_builder_build(sb));
}

# A temp path for a BINARY the CLI is about to execute. On Windows it ends ".exe":
# CreateProcessW with no application name appends ".exe" to an extensionless program
# name, so `<tmp>/run` is looked up as `<tmp>/run.exe` and never found. POSIX names
# are unchanged (test_runner_bounded.sh finds live children by `/cyrius-<pid>/test_bin`).
# CHANGELOG [6.6.5].
fn _cbt_tmpexe(name): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var sb = str_builder_new();
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, ".exe");
    return _cbt_tmpfile(str_data(str_builder_build(sb)));
    #endif
    #ifndef CYRIUS_TARGET_WIN
    return _cbt_tmpfile(name);
    #endif
}

# v6.6.6 — remove the private temp directory on the way out.
#
# THE DEFECT. `_cbt_tmpdir()` creates `<base>/cyrius-<pid>` on first use (v6.4.81,
# CVE-35/CVE-36) and NOTHING has ever removed it, so every `cyrius run` / `lint` /
# `test` / `deps` / `lsp` left one EMPTY directory behind for good. Measured on the
# maintainer's box at 6.6.5: 5,005 `/tmp/cyrius-<pid>` directories, 398 of the 400
# newest of them empty.
#
# ⚠ rmdir ONLY — deliberately NOT a recursive sweep. rmdir fails on a non-empty
# directory, and that is the correct outcome: `cyrius lsp` with no CYRIUS_HOME prints
# this path and tells the user to copy the binary out of it, and a SIGKILLed
# `cyrius test` leaves its `test_bin` for a post-mortem. Deleting either would turn a
# cleanup into data loss. The 2 non-empty leftovers in that sample are exactly those.
#
# ⚠ WINDOWS IS COVERED TOO, and that took a compiler change. `xrmdir` (lib/io.cyr) used
# to degrade to -1 on PE because no RemoveDirectoryW reroute was wired, so this helper
# could not do anything there and the first cut of this bite shipped saying so. A `-1`
# degrade is only honest while nothing depends on the call succeeding; something now
# does, so 6.6.6 wired `syscall(0xF03A)` → kernel32!RemoveDirectoryW (EREMOVEDIRW_PE,
# src/backend/x86/emit.cyr) rather than leave the leak open on one target.
# CHANGELOG [6.6.6].
fn _cbt_tmpdir_cleanup(): i64 {
    if (_cbt_tmpdir_p == 0) { return 0; }
    var d = _cbt_tmpdir_p;
    _cbt_tmpdir_p = 0;
    return xrmdir(d);
}

# Exit the CLI, sweeping the private temp dir first. Every PARENT-side `sys_exit` in cbt/
# goes through here; main's own return value is swept at the bottom of cbt/cyrius.cyr,
# and THAT is the path doing the work today.
#
# ⚠ THE FOUR ROUTED SITES ARE DEFENSIVE, NOT LOAD-BEARING — this comment used to claim
# they were "the paths that can run after a temp directory exists", which was overstated.
# Three of them are in `_try_redirect_to_pinned`, which `main()` calls before anything
# allocates a temp dir; the fourth (`_dep_find_stdlib_dir`'s uninstalled-pin exit) is
# reached only from `cyrius deps`, which allocates none of its own. What makes the routing
# worth having is the NEXT early exit somebody writes — so the rule, not those four sites,
# is what is gated: `tests/gates/toolchain/cli_temp_dir_no_leak.sh` axis 5 derives every
# `sys_exit(` in cbt/ and requires each to be inside a forked child or inside
# `_cbt_tmpdir` / `_cbt_exit`. A new parent-side `sys_exit` anywhere else turns it RED.
# (The `sys_exit`s inside forked children never reach this — they are a different process,
# and the parent's temp dir is not theirs to remove — and the two in `_cbt_tmpdir` itself
# run before any directory exists.) CHANGELOG [6.6.6].
fn _cbt_exit(code): i64 {
    _cbt_tmpdir_cleanup();
    sys_exit(code);
    return code;
}

# v6.5.19 — when non-zero, compile() sends the COMPILER's stderr to this path instead
# of inheriting ours. Opt-in and reset by the caller; every existing call site leaves
# it 0 and is unaffected. `cyrius lint`'s syntax pre-pass is the only user: it has to
# READ cycc's diagnostics to tell a syntax error (report it) from a resolution error
# (stay quiet and lint anyway), and it must not spray either onto the user's terminal.
var _cc_stderr_to = 0;

# The Windows twin of the child-side dup2 below. lib/process_win.cyr's
# `_win_compile_spawn` builds `cmd /s /c ""cc" < "src" > "out""` and leaves stderr on
# the console; this adds the `2> "err"` leg. Kept HERE rather than in lib/ so the
# capture lands with its only caller — fold it back into `_win_compile_spawn` as a
# 4th parameter when that file is next touched. CHANGELOG [6.5.19].
#ifdef CYRIUS_TARGET_WIN
fn _win_compile_spawn_err(cc, source, output, errfile): i64 {
    # v6.6.6 — sized from the four paths, not a fixed 16 KiB; `_w_cmdbuf` refuses by
    # name past Windows' 32,767-character command line. See lib/process_win.cyr.
    var wbuf = _w_cmdbuf(strlen(cc) + strlen(source) + strlen(output) + strlen(errfile));
    if (wbuf == 0) { _err_ctx("compiler spawn", cc); return 1; }
    var o = 0;
    o = _w_append_cstr(wbuf, o, "cmd /s /c \"\"");
    o = _w_append_cstr(wbuf, o, cc);
    o = _w_append_cstr(wbuf, o, "\" < \"");
    o = _w_append_cstr(wbuf, o, source);
    o = _w_append_cstr(wbuf, o, "\" > \"");
    o = _w_append_cstr(wbuf, o, output);
    o = _w_append_cstr(wbuf, o, "\" 2> \"");
    o = _w_append_cstr(wbuf, o, errfile);
    o = _w_append_cstr(wbuf, o, "\"\"");
    _w_terminate(wbuf, o);
    var pi[24];
    if (_win_create_process(wbuf, 0, 0, &pi) == 0) { return 1; }
    return _win_wait_close(&pi);
}
#endif

# v6.5.50 — size of a just-written build artifact, for the build log. open+lseek(END)
# rather than stat: `xopen`/`xlseek` are already portable across the four targets the CLI
# cross-compiles to, whereas the stat struct offset (STAT_SIZE) differs per arch and would
# need a fork-specific branch here. Returns -1 if the file cannot be opened, so the caller
# can simply omit the size rather than print a wrong one.
fn _artifact_size(path): i64 {
    var fd = xopen(path, 0);
    if (fd < 0) { return 0 - 1; }
    var n = xlseek(fd, 0, 2);
    file_close(fd);
    if (n < 0) { return 0 - 1; }
    return n;
}

fn compile(source, output): i64 {
    var cc = current_cc();
    # v6.2.27: --target=aarch64-bare-metal-elf routes to the aarch64
    # cross-compiler (the same env knobs apply — kernel_mode + ELF64 kernel).
    # HARD-ERROR if cycc_aarch64 is absent (review P1) — never silently fall
    # through to the x86 cycc and build an x86 kernel for an aarch64 target.
    if (_baremetal_aa == 1) {
        if (file_exists(_cc_arm) == 1) { cc = _cc_arm; }
        else {
            _err_ctx("aarch64-bare-metal-elf requested but cycc_aarch64 not found; build it via `cyrius pulsar` (or CI/install)", _cc_arm);
            return 1;
        }
    }
    if (cc == 0) {
        _err("cycc not found. Install Cyrius or set CYRIUS_HOME.");
        return 1;
    }
    if (file_exists(cc) == 0) {
        _err_ctx("compiler not found", cc);
        return 1;
    }
    # v6.5.7: guard the SOURCE the same way the compiler is guarded, two lines up.
    # Without this, `cyrius build <path-that-does-not-exist>.cyr out` printed OK,
    # exited 0 and wrote a ~15 MB do-nothing binary: the stdlib is auto-prepended
    # BEFORE the entry file is read, so a path that matched nothing still yields a
    # valid translation unit containing the whole stdlib and no `main`. It presents
    # as a RUNTIME bug — a program that printed five lines a moment ago goes silent
    # and exits 0 — so the debugging goes into the library, not the build.
    # `is_dir` is required as a SECOND test: file_exists is open-then-close and
    # returns 1 for a directory. One site covers build / run / test / check / soak /
    # smoke, which all route through compile().
    if (file_exists(source) == 0) {
        _err_ctx("no such file", source);
        return 1;
    }
    if (is_dir(str_from(source)) == 1) {
        _err_ctx("not a file", source);
        return 1;
    }
    if (_verbose == 1) {
        sys_write(STDERR_FD, "[verbose] compiler: ", 20);
        sys_write(STDERR_FD, cc, strlen(cc));
        sys_write(STDERR_FD, "\n", 1);
        sys_write(STDERR_FD, "[verbose] source: ", 18);
        sys_write(STDERR_FD, source, strlen(source));
        sys_write(STDERR_FD, "\n", 1);
        sys_write(STDERR_FD, "[verbose] output: ", 18);
        sys_write(STDERR_FD, output, strlen(output));
        sys_write(STDERR_FD, "\n", 1);
    }
    var actual_source = _materialize_source(source);
    # v6.5.19 — the preprocessed source is a TEMP, and nothing ever deleted it.
    # `_materialize_source` returns `source` unchanged when no prepend was needed and
    # a fresh `<tmpdir>/cpp_<pid>` when it was, so the pointer inequality below is the
    # exact "we created it" test. Measured on the maintainer's box before this line
    # existed: 21,289 leftover /tmp/cyrius-* directories holding 2.8 GB, one per
    # compiling CLI invocation ever run. `test_bin` was always unlinked by the
    # callers; the preprocessed source never was.
    # ⚠ THERE ARE THREE EXITS, NOT TWO. This comment used to say "on BOTH the success
    # and failure paths — see the two sites below", counting only the split after
    # `sys_waitpid`. The Windows branch is a third (it unlinks before its own returns),
    # and the pre-fork output-probe bail-out is a fourth that was leaking: it returns
    # above the fork, so the post-waitpid unlink is unreachable from it. When adding an
    # early return anywhere after this point, add the unlink with it — the sites are
    # the `#ifdef CYRIUS_TARGET_WIN` block, the `probe_fd < 0` block, and the one above
    # the success/failure split.
    # (The directory itself is left to `_cbt_tmpdir_cleanup` at exit — one place, all
    # targets, PE included since 6.6.6's RemoveDirectoryW reroute. An empty 0700
    # directory costs an inode; the 2.8 GB was the files.)
    var tmp_src = 0;
    if (actual_source != source) { tmp_src = actual_source; }
    # v6.0.85 — Windows path. Win32 has no fork/dup2/execve, and SYS_RENAME(82)
    # + getpid(39) are not PE reroutes, so the POSIX fork+atomic-rename block
    # below can't run here. Spawn `cc < actual_source > output` via cmd.exe
    # (CreateProcessW) and write directly to `output`. Dep/define prepends still
    # apply above (actual_source); a dep build needs a writable temp the Windows
    # path doesn't yet have — tracked for follow-up. See CHANGELOG [6.0.85].
    #ifdef CYRIUS_TARGET_WIN
    var wrc = 0;
    if (_cc_stderr_to != 0) { wrc = _win_compile_spawn_err(cc, actual_source, output, _cc_stderr_to); }
    else { wrc = _win_compile_spawn(cc, actual_source, output); }
    if (tmp_src != 0) { sys_unlink(tmp_src); }
    if (wrc != 0) { sys_unlink(output); return 1; }
    return 0;
    #endif
    # Atomic-output bug fix: write to a temp output then rename on
    # success. Pre-fix, `output` was opened with O_TRUNC before the
    # compile ran, so any non-zero exit from cycc left an empty
    # file on disk — destroying any previously-working binary.
    var tmp_pid = sys_getpid();
    var tmp_out_sb = str_builder_new();
    str_builder_add_cstr(tmp_out_sb, output);
    str_builder_add_cstr(tmp_out_sb, ".tmp.");
    str_builder_add_int(tmp_out_sb, tmp_pid);
    var tmp_out = str_data(str_builder_build(tmp_out_sb));
    sys_unlink(tmp_out);
    # v6.3.3 #5: resolve `[sections] base` from the manifest before fork (parent does
    # the file I/O; the child just appends the result to envp). Bare-metal only.
    # v6.5.7: prove the output is writable BEFORE forking. The child opens `tmp_out`
    # and, on failure, could only `sys_exit(1)` — it has already dup2'd its stdout
    # away and has no channel back — so `cyrius build x.cyr build/nope/deeper/out`
    # printed a bare `FAIL` with no `error:` line and no hint that a directory was
    # missing. Doing the open here costs one syscall on the success path, tells the
    # user which directory is absent, and catches the other reasons (permissions,
    # read-only fs) with an honest message instead of the same silent 1.
    var probe_fd = sys_open(tmp_out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
    if (probe_fd < 0) {
        # v6.5.19: the preprocessed temp has to go on THIS path too. The unlink added
        # further down sits after `sys_waitpid`, deliberately above the success/failure
        # split — but this bail-out returns BEFORE the fork ever happens, so it never
        # reached that line. Two `return 1;`s below (missing output directory, and
        # unwritable output) both leaked one `<tmpdir>/cpp_<pid>` per invocation, which
        # is the same leak the fork path was fixed for. One unlink here covers both
        # because neither return can be taken without passing through it.
        # `tmp_out` needs no cleanup: `probe_fd < 0` means the open FAILED, so there is
        # no partial file, and it was already unlinked before the probe.
        if (tmp_src != 0) { sys_unlink(tmp_src); }
        var odir = _parent_dir(output);
        if (odir != 0) {
            if (is_dir(str_from(odir)) == 0) {
                _err_ctx("output directory does not exist", odir);
                return 1;
            }
        }
        _err_ctx("cannot write output", output);
        return 1;
    }
    sys_close(probe_fd);
    if (_baremetal_target == 1) { _section_base_env_ptr = _sections_base_env(); }
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open(actual_source, O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);

        var ofd = sys_open(tmp_out, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(1); }
        sys_dup2(ofd, 1);
        sys_close(ofd);

        # v6.5.19 — opt-in stderr capture (see _cc_stderr_to). Fails OPEN: if the file
        # cannot be created the child keeps our stderr, exactly as before, rather than
        # losing the diagnostic entirely.
        if (_cc_stderr_to != 0) {
            var efd = sys_open(_cc_stderr_to, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
            if (efd >= 0) { sys_dup2(efd, 2); sys_close(efd); }
        }

        # v5.11.63: pass --strict in argv when the wrapper flag was
        # set. cycc/cycc_aarch64 read /proc/self/cmdline at startup
        # (since v5.4.19 / v5.11.63 respectively) — a single
        # `--strict` token anywhere past argv[0] sets _strict_mode,
        # which fixup.cyr's strict-exit reads after the patch loop.
        # argv[32] = 4 × 8 B (cc + optional "--strict" + optional
        # "--allow-undef" + NUL). v6.5.14 widened this from 24 for the
        # distlib self-check; keep it in step with the flags below.
        var argv[32];
        store64(&argv, cc);
        var ax = 1;
        if (_strict == 1) {
            store64(&argv + ax * 8, "--strict");
            ax = ax + 1;
        }
        if (_cc_allow_undef == 1) {
            store64(&argv + ax * 8, "--allow-undef");
            ax = ax + 1;
        }
        # v6.5.19: `cyrius lint`'s pre-pass only. Makes cycc answer "does this PARSE?"
        # without resolution, so a missing include cannot hide the file's syntax
        # errors. THE OUTPUT IS GARBAGE UNDER THIS FLAG — the only caller compiles to
        # a temp and unlinks it. See _cc_syntax_only / _syntax_only.
        if (_cc_syntax_only == 1) {
            store64(&argv + ax * 8, "--syntax-only");
            ax = ax + 1;
        }
        store64(&argv + ax * 8, 0);
        # v5.11.58: when --strict-pin is set, augment envp with
        # CYRIUS_STRICT_PIN=1 so cycc's pin-drift check (added
        # v5.11.57) exits non-zero on mismatch. CI gating path.
        # v6.0.49: clone _envp + append per-flag vars (--strict-pin →
        # CYRIUS_STRICT_PIN=1; --agnos → CYRIUS_TARGET_AGNOS=1). v6.0.52: --win →
        # CYRIUS_TARGET_WIN=1 (cross-emit a Windows PE32+). Any combination can be
        # set; --win and --agnos are distinct emit targets (don't combine).
        var sp_extra = 0;
        if (_strict_pin == 1) { sp_extra = sp_extra + 1; }
        if (_agnos_target == 1) { sp_extra = sp_extra + 1; }
        if (_win_target == 1) { sp_extra = sp_extra + 1; }
        if (_poison_mode == 1) { sp_extra = sp_extra + 1; }
        # v6.6.5 — `--pie` is real now. The guide's PIE section (6.6.4 line 2724) had
        # documented `cyrius build --pie src dst` for months while the build loop had no --pie arm,
        # so the flag hit "unknown flag" and the documented recipe could never have run.
        # cycc reads PIE from its own cmdline or from CYRIUS_PIE=1; the env is the form
        # available here.
        if (_pie_target == 1) { sp_extra = sp_extra + 1; }
        if (_baremetal_target == 1) { sp_extra = sp_extra + 2; }   # CYRIUS_KERNEL + CYRIUS_ELF64_KERNEL
        if (_baremetal_target == 1 && _section_base_env_ptr != 0) { sp_extra = sp_extra + 1; }   # v6.3.3 #5 CYRIUS_KERNEL_BASE
        if (sp_extra > 0) {
            var sp_count = 0;
            while (load64(_envp + sp_count * 8) != 0) { sp_count = sp_count + 1; }
            var sp_envp = alloc((sp_count + sp_extra + 1) * 8);
            var sp_ej = 0;
            while (sp_ej < sp_count) {
                store64(sp_envp + sp_ej * 8, load64(_envp + sp_ej * 8));
                sp_ej = sp_ej + 1;
            }
            var sp_ni = sp_count;
            if (_strict_pin == 1) { store64(sp_envp + sp_ni * 8, "CYRIUS_STRICT_PIN=1"); sp_ni = sp_ni + 1; }
            if (_agnos_target == 1) { store64(sp_envp + sp_ni * 8, "CYRIUS_TARGET_AGNOS=1"); sp_ni = sp_ni + 1; }
            if (_win_target == 1) { store64(sp_envp + sp_ni * 8, "CYRIUS_TARGET_WIN=1"); sp_ni = sp_ni + 1; }
            if (_poison_mode == 1) { store64(sp_envp + sp_ni * 8, "CYRIUS_POISON=1"); sp_ni = sp_ni + 1; }
            if (_pie_target == 1) { store64(sp_envp + sp_ni * 8, "CYRIUS_PIE=1"); sp_ni = sp_ni + 1; }
            if (_baremetal_target == 1) {
                store64(sp_envp + sp_ni * 8, "CYRIUS_KERNEL=1"); sp_ni = sp_ni + 1;
                store64(sp_envp + sp_ni * 8, "CYRIUS_ELF64_KERNEL=1"); sp_ni = sp_ni + 1;
                if (_section_base_env_ptr != 0) { store64(sp_envp + sp_ni * 8, _section_base_env_ptr); sp_ni = sp_ni + 1; }   # v6.3.3 #5
            }
            store64(sp_envp + sp_ni * 8, 0);
            sys_execve(cc, &argv, sp_envp);
        } else {
            sys_execve(cc, &argv, _envp);
        }
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    # The compiler child has been reaped, so it is done with the preprocessed source.
    # Unlink here, ABOVE the success/failure split, so neither return path can skip it.
    if (tmp_src != 0) { sys_unlink(tmp_src); }
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) {
            # Atomic rename: tmp_out → output. Old `output` (if any)
            # is replaced atomically; on rename failure, neither is
            # touched. Both files live on the same FS so rename is
            # POSIX-atomic.
            sys_unlink(output);
            syscall(82, tmp_out, output);   # SYS_RENAME on Linux x86_64
            sys_chmod(output, 0x1ED);
            if (_verbose == 1) {
                # Report binary size
                var stat_buf[144];
                var sr = syscall(4, output, &stat_buf);
                if (sr == 0) {
                    var fsize = load64(&stat_buf + 48);
                    sys_write(STDERR_FD, "[verbose] binary: ", 18);
                    var szbuf[24];
                    var szlen = fmt_int_buf(fsize, &szbuf);
                    sys_write(STDERR_FD, &szbuf, szlen);
                    sys_write(STDERR_FD, " bytes\n", 7);
                }
            }
            return 0;
        }
    }
    # Compile failed: unlink the partial tmp output. The original
    # `output` (if any) is preserved untouched.
    sys_unlink(tmp_out);
    if (_verbose == 1) {
        sys_write(STDERR_FD, "[verbose] compile failed (exit ", 31);
        var ebuf[24];
        var elen = fmt_int_buf(WEXITSTATUS(status), &ebuf);
        sys_write(STDERR_FD, &ebuf, elen);
        sys_write(STDERR_FD, ")\n", 2);
    }
    return 1;
}

# Run a binary — directly for x86, via qemu for aarch64
# Run a shell command via /bin/sh -c. Returns exit code.
fn sys_system(cmd): i64 {
    # v6.6.6 — PE arm. There is no `/bin/sh` on Windows and the fork was a -1 stub, so
    # every caller (the pin/tag probes in cbt/cyrius.cyr, `cyrius hooks install`, the
    # release tag check) read a decoded uninitialised status. CHANGELOG [6.6.6].
    #ifdef CYRIUS_TARGET_WIN
    return _win_system(cmd);
    #endif
    var argv[40];   # N BYTES per CLAUDE.md buffer contract: 4 ptrs need 32 B
    var pid = sys_fork();
    if (pid == 0) {
        store64(&argv, "/bin/sh");
        store64(&argv + 8, "-c");
        store64(&argv + 16, cmd);
        store64(&argv + 24, 0);
        sys_execve("/bin/sh", &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 1;
}

# Ad-hoc codesign a freshly-compiled Mach-O binary so Apple-Silicon AMFI doesn't
# SIGKILL it (exit 137). No-op off macOS (the #ifdef strips it); harmless on
# x86-macOS (codesign -s - rejects but 2>/dev/null swallows it, and the unsigned
# binary runs there anyway). Hoisted from cmd_build's inline v6.0.38 codesign so
# every run path signs. See CHANGELOG [6.0.66].
fn _macho_codesign(path): i64 {
    #ifdef CYRIUS_TARGET_MACOS
    var cs = str_builder_new();
    str_builder_add_cstr(cs, "codesign -s - -f ");
    str_builder_add_cstr(cs, path);
    str_builder_add_cstr(cs, " 2>/dev/null");
    sys_system(str_data(str_builder_build(cs)));
    #endif
    return 0;
}

# ── Bounded child execution (v6.5.19) ────────────────────────────────────────
#
# THE INCIDENT. `run_binary` was fork + execve + BLOCKING waitpid with no deadline
# and nothing tying the child's lifetime to ours. Two consequences, and the second
# one poisoned this very release:
#
#   1. A test that hangs hangs the whole suite. There was no timeout at all, so
#      `cyrius test` on a spinning fixture waits forever and the only way out is to
#      kill the runner.
#   2. Killing the runner ORPHANS the child. It is reparented to PID 1 and keeps
#      running at full CPU indefinitely. The v6.5.19 non-regression verifier found
#      19 of them, the oldest at 1h42m, together eating ~13 of 16 cores (load
#      20.66) — and they turned the release gate's `alloc_via_no_plumbing` 14 ns
#      tripwire RED. Two separate implementers wrote that off as "environmental
#      load" without anyone asking what the environment was doing. A release gate
#      whose perf tripwires can be flipped by its own leaked children is not a gate.
#
# THE TWO HALVES, AND WHY BOTH ARE NEEDED:
#
#   * TIMEOUT (`timeout_ms > 0`) — poll `waitpid(WNOHANG)` on a widening interval
#     (1 ms while a fast test is still plausible, then 10 ms, then 50 ms) and SIGKILL
#     on the deadline. The widening keeps the cost off the common path: the corpus is
#     269 files and each one costs a compile of ~100 ms, so a first-millisecond poll
#     is noise. Returns 0-2 on timeout, which the callers report as a FAIL.
#   * PR_SET_PDEATHSIG (Linux) — the timeout alone does NOT fix (2). A parent that is
#     SIGKILLed runs no cleanup, ever, so nothing the parent does at exit can help;
#     the kernel has to do it. PDEATHSIG makes the kernel SIGKILL the child the moment
#     the forking thread dies. The getppid() re-check closes the race where the parent
#     dies between fork and prctl (the signal would already have been delivered, so
#     the child must notice for itself and exit).
#
# `timeout_ms = 0` means "no deadline" and is what `cyrius run` uses — a user running
# a server through the CLI must not be shot at 5 minutes. PDEATHSIG applies to every
# path including `cyrius run`; if the CLI dies the program it launched should die too.
#
# Deliberately NOT setpgid + kill(-pgid): setpgid needs a syscall number this file
# does not have on all four targets (109 x86-Linux / 154 aarch64 / 82 BSD, and none
# of them routed on PE), and it would not survive the SIGKILL case anyway. PDEATHSIG
# reuses SYS_PRCTL, which is already in the x86-Linux and aarch64 tables.
# CHANGELOG [6.5.19].
var _RUN_TIMEOUT_KILLED = 0 - 2;

# Default deadline for the batch verbs (test/tests/bench/fuzz/soak/smoke/doctest).
# 5 minutes: the same figure tests/gates/**.sh already uses for `timeout`, and ~2
# orders of magnitude above the slowest .tcyr in the corpus. `CYRIUS_TEST_TIMEOUT`
# (seconds; 0 disables) overrides it for a genuinely long-running harness.
fn _run_timeout_ms(): i64 {
    var v = _cbt_env_int("CYRIUS_TEST_TIMEOUT", 0 - 1);
    if (v >= 0) { return v * 1000; }
    return 300000;
}

# Portable ms sleep. Same per-target bodies as lib/chrono.cyr's `sleep_ms`, inlined
# here because cbt/ must not pull a Linux-syscall lib include (CLAUDE.md) and chrono
# is not in the wrapper's include set. poll(NULL, 0, ms) is the portable form: raw
# nanosleep(35) is NOT a Darwin BSD syscall and was never routed on PE.
fn _run_sleep_ms(ms): i64 {
    #ifdef CYRIUS_TARGET_WIN
    syscall(0xF00F, ms);            # kernel32 Sleep(ms)
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    syscall(7, 0, 0, ms);           # poll(NULL, 0, ms) — 7→230 on Darwin
    return 0;
    #endif
}

fn run_binary_timed(path, timeout_ms, args): i64 {
    #ifdef CYRIUS_TARGET_WIN
    return _win_run_timed(path, timeout_ms, args);
    #endif
    # Bug 2 (v6.0.66): cmd_test/run/bench/fuzz/doctest compile to /tmp and run via
    # run_binary without signing — only cmd_build signed (6.0.38). On arm64 macOS an
    # unsigned binary is AMFI-SIGKILL'd (128+9=137). Sign here so EVERY run path works.
    _macho_codesign(path);
    var ppid_before = 0;
    #ifdef CYRIUS_TARGET_LINUX
    ppid_before = sys_getpid();      # our pid == the child's ppid after fork
    #endif
    var pid = sys_fork();
    if (pid == 0) {
        # Die with the parent. PR_SET_PDEATHSIG = 1, SIGKILL = 9. It survives execve
        # (the binary is not setuid), so the exec'd test inherits it. Linux only —
        # prctl is not a BSD/Darwin syscall and is not routed on PE; SYS_PRCTL is in
        # the x86-Linux and aarch64-Linux tables only.
        #ifdef CYRIUS_TARGET_LINUX
        sys_prctl(1, 9, 0, 0, 0);
        # The race: if the parent died between fork and the prctl above, the death
        # signal has already been delivered to nobody and will never fire. Notice it.
        # v6.6.4: SYS_GETPPID (110 on x86_64, 173 on aarch64), not the raw 110 — on native
        # aarch64-Linux 110 is timer_settime, which returned -EINVAL != ppid, so EVERY
        # `cyrius run/test/tests/bench/fuzz` child exited 1 before execve from 6.5.19 to 6.6.3. The
        # CLI's aarch64 build had printed the raw-syscall warning for this line the whole
        # time; the pi release-gate leg never built or ran the CLI.
        if (syscall(SYS_GETPPID) != ppid_before) { sys_exit(1); }
        #endif
        # Bug 1 (v6.0.66): qemu-aarch64 is the x86-Linux-host cross-run path for an
        # aarch64 TARGET. A native Mach-O host (Apple Silicon) has NO qemu-aarch64 and
        # runs its own arch directly; find_tools() forces _arch=AARCH64 on arm64-macOS,
        # so this branch execve-failed → exit 127 with zero test output (the yantra
        # Apple-Silicon `cyrius test` failure). Gate it OUT on macOS — exec directly.
        #ifndef CYRIUS_TARGET_MACOS
        if (_arch == ARCH_AARCH64) {
            var qav = _run_argv(path, args, "/usr/bin/qemu-aarch64");
            sys_execve("/usr/bin/qemu-aarch64", qav, _envp);
            sys_exit(127);
        }
        #endif
        var nav = _run_argv(path, args, 0);
        sys_execve(path, nav, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    if (timeout_ms <= 0) {
        sys_waitpid(pid, &status_buf, 0);
        var status0 = load32(&status_buf);
        if (WIFEXITED(status0) == 1) { return WEXITSTATUS(status0); }
        if (WIFSIGNALED(status0) == 1) { return 128 + WTERMSIG(status0); }
        return 1;
    }
    var waited = 0;
    var slice = 1;
    while (waited < timeout_ms) {
        var w = sys_waitpid(pid, &status_buf, WNOHANG);
        if (w == pid) {
            var status = load32(&status_buf);
            if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
            if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
            return 1;
        }
        # v6.5.51 — KILL BEFORE RETURNING. This used to be a bare `return 1;`, which is an
        # ABANDONMENT PATH: any transient waitpid failure (EINTR is the likely one, and it
        # gets likelier the more loaded the box is) left the child RUNNING and let the suite
        # move on to the next test — the precise defect the deadline exists to prevent, and
        # the one `tests/gates/toolchain/test_runner_bounded.sh` axis 1b is built around.
        # ⚠ This is the real cause of that gate's "intermittent" red, and v6.5.50 mis-modelled
        # it as a sampling artifact of the post-SIGKILL teardown window. It is not: the gate
        # measured TWO children alive across 18 CONSECUTIVE samples (4.5 s), which is
        # abandonment, not teardown. Reproduces only under load, which is why it looked flaky.
        if (w < 0) {
            sys_kill(pid, 9);
            sys_waitpid(pid, &status_buf, 0);
            return 1;
        }
        _run_sleep_ms(slice);
        waited = waited + slice;
        if (waited >= 50)   { slice = 10; }
        if (waited >= 2000) { slice = 50; }
    }
    # Deadline. SIGKILL (not SIGTERM): the child may be spinning in a tight loop with
    # no handler, and a TERM it ignores leaves exactly the orphan this exists to stop.
    sys_kill(pid, 9);
    sys_waitpid(pid, &status_buf, 0);
    return _RUN_TIMEOUT_KILLED;
}

fn run_binary(path): i64 {
    return run_binary_timed(path, 0, 0);
}

# v6.6.5 — run a just-built program with its OWN arguments forwarded (go-run style).
# `cyrius run prog.cyr a b c` used to hand the program an argv of length 1.
fn run_binary_args(path, args): i64 {
    return run_binary_timed(path, 0, args);
}

# v6.6.6 — THE COMPILER SOURCE A SELF-HOST LOOP MUST COMPILE ON *THIS* TARGET.
#
# `src/main.cyr` is the x86-64 LINUX fork. Handing a PE `cycc.exe` that fork compiles
# fine — it is valid cyrius — and produces a PE built from LINUX syscall numbers, which
# page-faults the moment the second step tries to RUN it ("Unhandled page fault on write
# access ... at 0000000140001060", measured under wine). So a Windows self-host loop that
# names `src/main.cyr` can never pass, and it blames the SELF-HOST ("output differs")
# for a source-selection bug — the same false verdict, one layer along, as the "git clone
# failed" message this release removed. `cyrius self` (`_win_cmd_self`) and `cyrius soak`
# both self-host, so both ask here rather than each hard-coding a path.
# CHANGELOG [6.6.6].
fn _self_host_src(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    return "src/main_win.cyr";
    #endif
    #ifndef CYRIUS_TARGET_WIN
    return "src/main.cyr";
    #endif
}

# v6.6.5 — Windows spawn for run_tool_vec. run_tool/run_tool_argvtail both use
# sys_fork/sys_waitpid, which are -1 STUBS on PE (lib/syscalls_windows.cyr): the fork
# "succeeds" with -1, the parent waits on nothing and returns 1, so `cyrius lint` /
# `fmt` / `doc` / `vet` / `deny` / `api-surface` never ran their tool on Windows at
# all. Each argument is quoted, because a PE cmdline is one string and a path with a
# space would otherwise split into two arguments. See _win_compile_spawn_err (:578)
# for the same pattern on the compiler spawn. CHANGELOG [6.6.5].
#ifdef CYRIUS_TARGET_WIN
fn _w_put(wbuf, o, c): i64 {
    store8(wbuf + o, c);
    store8(wbuf + o + 1, 0);
    return o + 2;
}

# Append ONE argument, quoted by the MSVCRT / CommandLineToArgvW rules, so the child
# receives exactly the bytes we hold: backslashes are literal EXCEPT in a run that ends
# at a `"` (doubled, plus one to escape the quote) or at the closing quote (doubled).
# v6.6.5 (round-3 review) — the first cut wrapped each argument in bare quotes, so a
# forwarded `cyrius run p.cyr "a\"b"` or a directory argument ending in `\` reached the
# program as a different argv. CHANGELOG [6.6.5].
fn _w_append_arg(wbuf, o, s): i64 {
    o = _w_put(wbuf, o, 34);
    var i = 0;
    var go = 1;
    while (go == 1) {
        var nb = 0;
        while (load8(s + i) == 92) { nb = nb + 1; i = i + 1; }
        var c = load8(s + i);
        var reps = nb;
        if (c == 0 || c == 34) { reps = nb * 2; }
        var k = 0;
        while (k < reps) { o = _w_put(wbuf, o, 92); k = k + 1; }
        if (c == 0) { go = 0; }
        else {
            if (c == 34) { o = _w_put(wbuf, o, 92); }
            o = _w_put(wbuf, o, c);
            i = i + 1;
        }
    }
    return _w_put(wbuf, o, 34);
}

# The UTF-16LE command line `"prog" "arg"...`, or 0 after a NAMED error.
# v6.6.5 (round-2 review) — SIZED FROM THE ARGUMENTS, not a fixed 32768: this is the
# one spawn in the CLI that can be handed an arbitrary-length list (`cyrius lint <130
# files>`, a forwarded `cyrius run` tail), so a fixed buffer is a heap overwrite
# waiting for a large enough project. Worst case per argument is every byte doubled
# (all backslashes before a quote) + 2 quotes + 1 space, 2 bytes per wide char.
fn _win_cmdline(prog, args): i64 {
    var need = (strlen(prog) + 3) * 2 + 8;
    var n = 0;
    if (args != 0) { n = vec_len(args); }
    var _wi = 0;
    while (_wi < n) {
        need = need + (strlen(vec_get(args, _wi)) * 2 + 3) * 2;
        _wi = _wi + 1;
    }
    # Windows' own command line maxes at 32,767 characters; past that CreateProcessW
    # fails anyway, so refuse with a NAMED error rather than building a buffer that
    # cannot be spawned.
    if (need > 65536) {
        _err_ctx("command line exceeds the Windows 32767-character limit", prog);
        return 0;
    }
    var wbuf = alloc(need);
    var o = 0;
    o = _w_put(wbuf, o, 34);
    o = _w_append_cstr(wbuf, o, prog);
    o = _w_put(wbuf, o, 34);
    var i = 0;
    while (i < n) {
        o = _w_put(wbuf, o, 32);
        o = _w_append_arg(wbuf, o, vec_get(args, i));
        i = i + 1;
    }
    _w_terminate(wbuf, o);
    return wbuf;
}

# v6.6.5 — Windows spawn for run_tool_vec. run_tool/run_tool_argvtail both used
# sys_fork/sys_waitpid, which are -1 STUBS on PE (lib/syscalls_windows.cyr): the fork
# "succeeds" with -1, the parent waits on nothing and returns 1, so `cyrius lint` /
# `fmt` / `doc` / `vet` / `deny` / `api-surface` never ran their tool on Windows at
# all. See _win_compile_spawn_err for the same pattern on the compiler spawn.
fn _win_spawn_vec(tool, args): i64 {
    var wbuf = _win_cmdline(tool, args);
    if (wbuf == 0) { return 1; }
    var pi[24];
    if (_win_create_process(wbuf, 0, 0, &pi) == 0) {
        _err_ctx("failed to spawn tool", tool);
        return 1;
    }
    return _win_wait_close(&pi);
}

# v6.6.5 (round-3 review) — the Windows arm of run_cx: the fork/dup2 body is dead on PE
# (sys_fork is a -1 stub), so an installed cxvm.exe was never started. cxvm reads the
# program from STDIN, and Win32 has no dup2, so the redirect goes through cmd.exe exactly
# as _win_compile_spawn does it (`/s` strips only the outer quote pair).
fn _win_run_cx(vm, cyx): i64 {
    var wbuf = alloc((strlen(vm) + strlen(cyx) + 32) * 2);
    var o = 0;
    o = _w_append_cstr(wbuf, o, "cmd /s /c \"\"");
    o = _w_append_cstr(wbuf, o, vm);
    o = _w_append_cstr(wbuf, o, "\" < \"");
    o = _w_append_cstr(wbuf, o, cyx);
    o = _w_append_cstr(wbuf, o, "\"\"");
    _w_terminate(wbuf, o);
    var pi[24];
    if (_win_create_process(wbuf, 0, 0, &pi) == 0) {
        _err_ctx("failed to start", vm);
        return 127;
    }
    return _win_wait_close(&pi);
}

# v6.6.5 (round-3 review) — the Windows arm of run_binary_timed. The POSIX body is
# fork/execve/waitpid, and on PE `sys_fork` is a -1 stub, so `cyrius run/test/tests/
# bench/fuzz/soak/smoke/doctest` NEVER RAN THE PROGRAM on Windows: the parent
# "waited" on pid -1 and decoded an UNINITIALISED status slot (measured under wine:
# `run argc.cyr a b c` exited 111, `test t.tcyr` 199; 6.6.4 gave 48). A garbage code
# that happened to decode as 0 would have reported a test that never ran as PASSED.
# CreateProcessW + the WaitForSingleObject deadline (_win_wait_timeout, 0xF001/0xF01D)
# give the same contract: the child's own exit code, or _RUN_TIMEOUT_KILLED.
fn _win_run_timed(path, timeout_ms, args): i64 {
    var wbuf = _win_cmdline(path, args);
    if (wbuf == 0) { return 1; }
    var pi[24];
    if (_win_create_process(wbuf, 0, 0, &pi) == 0) {
        _err_ctx("failed to start", path);
        return 127;
    }
    if (timeout_ms <= 0) { return _win_wait_close(&pi); }
    var killed = 0;
    var ec = _win_wait_timeout(&pi, timeout_ms, &killed);
    if (killed == 1) { return _RUN_TIMEOUT_KILLED; }
    return ec;
}

# ── v6.6.6 — the REST of the fork sites (bite 9b) ───────────────────────────────────
#
# 6.6.5 gave a PE arm to the compile spawn, the tool spawn, the program run and the cx
# run. It did NOT cover the other ten `sys_fork` call sites in cbt/, and `sys_fork` is
# `return 0 - 1` on PE (lib/syscalls_windows.cyr) with `sys_waitpid` the same — so the
# parent took the pid != 0 branch, "waited" on -1 and decoded an UNINITIALISED status
# slot. `cyrius build --target=cx`, `--target=js`, `capacity`, `soak`, `self` and the
# git-dep clone were therefore broken or SILENTLY WRONG on Windows: a garbage status
# that happened to decode as WIFEXITED/0 reported success for a child that never ran.
# Each one below either gets the CreateProcessW spawn the fixed paths use, or refuses
# BY NAME — never a silent nothing. CHANGELOG [6.6.6].

# `cyrius build --target=js` cannot work on Windows and the reason is structural, not a
# missing spawn: the TypeScript front end and the JS emitter are included by
# `src/main.cyr` ALONE (`src/frontend/ts/*`, `src/backend/js/emit.cyr`), so `cycc.exe`
# — built from `src/main_win.cyr` — has no `--emit-js` flag to spawn with. Say that,
# rather than fork a compiler that would reject the flag.
fn _win_emit_js_refuse(): i64 {
    _err("build --target=js is not available on Windows");
    var m1 = "  cycc.exe is built from src/main_win.cyr, which does not include the\n";
    var m2 = "  TypeScript front end or the JS emitter (src/main.cyr only), so it has\n";
    var m3 = "  no --emit-js. Emit the JS on an x86-64 Linux host.\n";
    sys_write(STDERR_FD, m1, strlen(m1));
    sys_write(STDERR_FD, m2, strlen(m2));
    sys_write(STDERR_FD, m3, strlen(m3));
    return 1;
}

# The cross-OS self-host driver (`cyrius audit --internal=platform-check`) reconstructs
# the environment from /proc/self/environ and drives ssh/scp to ecb/ach/cass/pi. It is a
# LINUX-HOST tool by construction; cass is one of the hosts it talks TO.
fn _win_co_run_refuse(cmd): i64 {
    _err_ctx("the cross-OS self-host driver only runs on a Linux host", cmd);
    return 1;
}

# `/bin/sh -c <cmd>` has no Windows equivalent; `cmd /s /c` is the shell that exists.
# `exec_cmd` (lib/process_win.cyr) already builds exactly that command line, and it
# returns -1 when the spawn itself fails — which must not be handed back as an exit
# code, because -1 is not one. A POSIX-only command string (`cp x y && chmod +x y`)
# still fails here, but it fails with cmd.exe's own status and its own message on the
# terminal, instead of a decoded uninitialised stack slot.
fn _win_system(cmd): i64 {
    var rc = exec_cmd(cmd);
    if (rc < 0) {
        _err_ctx("could not start cmd.exe for", cmd);
        return 1;
    }
    return rc;
}

# Byte-compare two files without reading either whole into memory (PE-only helper).
# Used by the Windows
# arm of `cyrius self`, where the two candidates are ~1.2 MB compilers.
# ⚠ `_file_size` is a raw `syscall(4)` (stat), which is NOT a PE reroute and answers
# -38 for BOTH paths — so the size pre-check is inert on Windows by design and the
# streaming compare below is what actually decides. Stated because a size check that
# silently always passes is exactly the kind of green placebo this release is about.
#
# ⚠ TWO EMPTY FILES ARE NOT A MATCH, and a READ ERROR is not end-of-file. Both callers
# compare COMPILERS, so "0 bytes == 0 bytes" is never the answer they want — and cass is
# precisely the host that produces zero-byte outputs (Defender quarantines an unsigned
# .exe mid-write; a spawn that never started leaves the redirect target empty). The first
# cut fell into `na <= 0` with na == nb == 0 and returned 1, so `cyrius self` printed
# "PASS: cycc==cycc byte-identical" over two empty files and `cyrius soak` scored the
# iteration — the same green placebo this bite exists to remove. `cmd_pulsar`'s POSIX
# comparison already carries this floor (`if (sz_a == sz_b) { if (sz_a > 0) ...`).
# CHANGELOG [6.6.6].
fn _win_files_equal(a, b): i64 {
    var fa = sys_open(a, O_RDONLY, 0);
    if (fa < 0) { return 0; }
    var fb = sys_open(b, O_RDONLY, 0);
    if (fb < 0) { sys_close(fa); return 0; }
    var ba = alloc(65536);
    var bb = alloc(65536);
    var same = 1;
    var go = 1;
    var seen = 0;
    while (go == 1) {
        var na = sys_read(fa, ba, 65536);
        var nb = sys_read(fb, bb, 65536);
        if (na != nb) { same = 0; go = 0; }
        elif (na < 0) { same = 0; go = 0; }
        elif (na == 0) { go = 0; }
        elif (memeq(ba, bb, na) == 0) { same = 0; go = 0; }
        else { seen = seen + na; }
    }
    sys_close(fa);
    sys_close(fb);
    if (seen <= 0) { return 0; }
    return same;
}

# The Windows arm of `cyrius self`. The POSIX body hands a `/bin/sh` script the whole
# two-step (`cat src/main.cyr | cc > a && chmod +x a && cat src/main.cyr | a > b &&
# cmp -s a b`); none of `cat`, `chmod` or `cmp` is a Windows command, and the fork that
# would have run them is a stub. The same contract is reproduced natively: two
# `_win_compile_spawn` redirects and a byte compare. ⚠ Both temps go through
# `_cbt_tmpexe`, because the SECOND spawn EXECUTES the first one's output and
# CreateProcessW appends `.exe` to an extensionless program name.
fn _win_cmd_self(): i64 {
    # ⚠ src/main_win.cyr, NOT src/main.cyr — THE PER-TARGET SOURCE; `_self_host_src()`
    # (:1268) answers, and `cmd_soak` asks the same question there. The POSIX script
    # below names src/main.cyr because on x86-64 Linux that IS the right fork. Handing a
    # PE cycc.exe the Linux fork compiles fine and produces a PE built from Linux syscall
    # numbers, which page-faults the moment the second step tries to RUN it (measured
    # under wine: "Unhandled page fault on write access ... at 0000000140001060"). Same
    # rule the cross-OS legs already follow (cbt/commands.cyr's ecb sequence uses
    # src/main_aarch64_macho.cyr). CHANGELOG [6.6.6].
    var self_src = _self_host_src();
    if (file_exists(self_src) == 0) {
        _err_ctx("self-host: the Windows compiler source is missing", self_src);
        return 1;
    }
    var t1 = _cbt_tmpexe("self_a");
    var t2 = _cbt_tmpexe("self_b");
    if (_win_compile_spawn(_cc, self_src, t1) != 0) {
        _err_ctx("self-host: the installed compiler could not compile", self_src);
        xunlink(t1);
        return 1;
    }
    if (_win_compile_spawn(t1, self_src, t2) != 0) {
        _err_ctx("self-host: the freshly built compiler could not compile", self_src);
        xunlink(t1);
        xunlink(t2);
        return 1;
    }
    var same = _win_files_equal(t1, t2);
    xunlink(t1);
    xunlink(t2);
    if (same == 1) {
        println("  PASS: cycc==cycc byte-identical");
        return 0;
    }
    println("  FAIL: cycc!=cycc");
    return 1;
}

# The Windows arm of `cyrius capacity`. The POSIX body forks `/bin/sh -c
# "CYRIUS_STATS=1 <cc>"` with stdin on the materialised source, stdout on /dev/null and
# stderr on a temp file. `cmd /s /c` does all four: `set` before an `&` sets the
# variable in the same shell the child inherits, and `nul` is Windows' /dev/null.
# ⚠ NO SPACE before the `&`: `set X=1 & prog` sets X to "1 " (trailing space included),
# which would be passed to cycc as the stats flag and silently not match.
fn _win_capacity_spawn(cc, source, errfile): i64 {
    # v6.6.6 — sized from the three paths, not a fixed 16 KiB; `_w_cmdbuf` refuses by
    # name past Windows' 32,767-character command line. See lib/process_win.cyr.
    var wbuf = _w_cmdbuf(strlen(cc) + strlen(source) + strlen(errfile));
    if (wbuf == 0) { _err_ctx("capacity spawn", cc); return 0 - 1; }
    var o = 0;
    o = _w_append_cstr(wbuf, o, "cmd /s /c \"set CYRIUS_STATS=1& \"");
    o = _w_append_cstr(wbuf, o, cc);
    o = _w_append_cstr(wbuf, o, "\" < \"");
    o = _w_append_cstr(wbuf, o, source);
    o = _w_append_cstr(wbuf, o, "\" > nul 2> \"");
    o = _w_append_cstr(wbuf, o, errfile);
    o = _w_append_cstr(wbuf, o, "\"\"");
    _w_terminate(wbuf, o);
    var pi[24];
    if (_win_create_process(wbuf, 0, 0, &pi) == 0) {
        _err_ctx("failed to spawn the compiler for capacity stats", cc);
        return 0 - 1;
    }
    return _win_wait_close(&pi);
}
#endif

# v6.6.5 — run a tool with an ARBITRARY number of arguments. run_tool caps at 3,
# which is why cmd_lint could only ever forward `--strict` plus the file: --strict
# --strict-deferrals --exit-with-count <file> is four. A cap that silently shapes the
# caller is the same class of defect as a cap that silently drops (lib/flags.cyr's
# 128 positionals). `args` is a vec of cstr; the tool path is prepended here.
fn run_tool_vec(tool, args): i64 {
    if (file_exists(tool) == 0) {
        _err_ctx("tool not found", tool);
        return 1;
    }
    #ifdef CYRIUS_TARGET_WIN
    return _win_spawn_vec(tool, args);
    #endif
    #ifndef CYRIUS_TARGET_WIN
    var pid = sys_fork();
    if (pid == 0) {
        var n = vec_len(args);
        var av = alloc((n + 2) * 8);
        store64(av, tool);
        var i = 0;
        while (i < n) {
            store64(av + (i + 1) * 8, vec_get(args, i));
            i = i + 1;
        }
        store64(av + (n + 1) * 8, 0);
        sys_execve(tool, av, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
    return 1;
    #endif
}

# Run an external tool by path, passing through up to 3 args.
# v6.6.5 — a thin wrapper over run_tool_vec so every tool spawn in the CLI takes the
# SAME path, including the Windows CreateProcessW one. It used to fork/execve
# directly, and fork/waitpid are -1 stubs on PE, so `cyrius fmt/vet/deny/doc` never
# ran their tool on Windows.
fn run_tool(tool, arg1, arg2, arg3): i64 {
    var av = vec_new();
    if (arg1 != 0) { vec_push(av, arg1); }
    if (arg2 != 0) { vec_push(av, arg2); }
    if (arg3 != 0) { vec_push(av, arg3); }
    return run_tool_vec(tool, av);
}

# Like run_tool but forwards the CLI's own argv tail (argv[from_idx..])
# verbatim, optionally prepending `sentinel`. Used by the native
# scaffolder dispatch (cmd_init / cmd_port) so the full flag matrix
# reaches programs/cyrius-init.cyr intact — run_tool caps at 3 args,
# which silently dropped flags like `cyrius init --lib --description=x name`.
# Inherits the real environment (_envp, populated by load_environ) so the
# scaffolder's getenv (HOME / CYRIUS_HOME / XDG_CONFIG_HOME / CYRIUS_VER /
# PWD) resolves. v6.2.40 (init/port native-port slot).
fn run_tool_argvtail(tool, from_idx, sentinel): i64 {
    # v6.6.5 — via run_tool_vec, so the Windows spawn path applies here too.
    var av = vec_new();
    if (sentinel != 0) { vec_push(av, sentinel); }
    var i = from_idx;
    while (i < argc()) {
        vec_push(av, argv(i));
        i = i + 1;
    }
    return run_tool_vec(tool, av);
}

# Run a shell script
# v5.10.48 defensive guard: surface a clean error when the script
# doesn't exist rather than silently invoking `/bin/sh <missing>`
# which exits 2 with no context. Surfaced via `cyrius audit`
# invoking `~/.cyrius/bin/check.sh` outside the cyrius repo (the
# script ships in `scripts/check.sh` but isn't installed via
# `cyrius pulsar`). Held from v5.9.4; one-line guard applies to
# every script caller (cyrius audit, cyrius capacity --script,
# etc.). The full design call (clean error vs polymorphic
# project-level audit) stays held until user picks semantics; the
# defensive guard ships now.
fn run_script(script, arg1, arg2): i64 {
    if (file_exists(script) == 0) {
        _err_ctx("script not found", script);
        return 127;
    }
    return run_tool("/bin/sh", script, arg1, arg2);
}

# ── Cross-OS self-host gate support (v6.0.33) ──
# The default _envp (cbt/core.cyr) is empty, so an execve'd `ssh` would
# lack HOME / SSH_AUTH_SOCK and fail to reach the verification hosts.
# Reconstruct the real environment from /proc/self/environ so ssh/scp
# behave exactly as they would in the user's shell.
var _co_env_buf[32768];     # 32 KB of NUL-separated NAME=VALUE pairs
var _co_env_ptrs[8192];     # 1024 char* slots (8 bytes each)

# Build a NULL-terminated char** of the current environment. Returns
# &_co_env_ptrs, or 0 on failure (then callers fall back to _envp).
fn _co_build_envp(): i64 {
    var fd = sys_open("/proc/self/environ", 0, 0);
    if (fd < 0) { return 0; }
    var n = sys_read(fd, &_co_env_buf, 32767);
    sys_close(fd);
    if (n <= 0) { return 0; }
    store8(&_co_env_buf + n, 0);
    var pc = 0;
    store64(&_co_env_ptrs, &_co_env_buf);   # first entry starts at byte 0
    pc = 1;
    var i = 0;
    while (i < n) {
        if (load8(&_co_env_buf + i) == 0) {
            if (i + 1 < n) {
                if (pc < 1023) {
                    store64(&_co_env_ptrs + pc * 8, &_co_env_buf + i + 1);
                    pc = pc + 1;
                }
            }
        }
        i = i + 1;
    }
    store64(&_co_env_ptrs + pc * 8, 0);      # NULL-terminate the vector
    return &_co_env_ptrs;
}

# Run `/bin/sh -c <cmd>` with the real environment. Returns the shell
# exit status (0 = success). Used by the cross-OS self-host gate so the
# proven ssh/scp self-host sequence runs with full env.
fn _co_run_sh(cmd): i64 {
    # v6.6.6 — PE arm: refuse by name. This driver reads /proc/self/environ and shells
    # out to ssh/scp; cass is one of the hosts it connects TO. CHANGELOG [6.6.6].
    #ifdef CYRIUS_TARGET_WIN
    return _win_co_run_refuse(cmd);
    #endif
    var envp = _co_build_envp();
    if (envp == 0) { envp = _envp; }
    var pid = sys_fork();
    if (pid == 0) {
        var argv[32];                         # 4 char* slots
        store64(&argv, "/bin/sh");
        store64(&argv + 8, "-c");
        store64(&argv + 16, cmd);
        store64(&argv + 24, 0);
        sys_execve("/bin/sh", &argv, envp);
        sys_exit(127);
    }
    var st[8];
    sys_waitpid(pid, &st, 0);
    var status = load32(&st);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 1;
}

