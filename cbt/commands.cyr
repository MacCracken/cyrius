# ================================================================
# Subcommands
# ================================================================

fn cmd_build(source, output): i64 {
    # Refuse to write the build output over a `.cyr` file. A compiled
    # binary never has a `.cyr` name, so a `.cyr` output is almost always
    # a misparsed CLI that would silently clobber a source (issue
    # 2026-04-26). Hard error before any write. See CHANGELOG [6.0.36].
    var _olen = strlen(output);
    if (_olen >= 4 && memeq(output + _olen - 4, ".cyr", 4) == 1) {
        sys_write(STDERR_FD, "error: refusing to write build output over a .cyr source file: ", 63);
        sys_write(STDERR_FD, output, _olen);
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    # Ensure output directory exists
    var oi = 0;
    var last_slash = 0 - 1;
    while (load8(output + oi) != 0) {
        if (load8(output + oi) == 47) { last_slash = oi; }
        oi = oi + 1;
    }
    if (last_slash > 0) {
        var dir = alloc(last_slash + 1);
        memcpy(dir, output, last_slash);
        store8(dir + last_slash, 0);
        sys_mkdir(dir, 0x1ED);
    }
    # v6.1.12: --target=js routes to cycc's TS/TSX → JS emitter (path-arg in,
    # JS to stdout) rather than the native-binary compile path below.
    if (_js_target == 1) {
        if (_dry_run == 1) {
            sys_write(STDOUT_FD, "dry-run: emit-js ", 17);
            sys_write(STDOUT_FD, source, strlen(source));
            sys_write(STDOUT_FD, " -> ", 4);
            sys_write(STDOUT_FD, output, strlen(output));
            sys_write(STDOUT_FD, "\n", 1);
            return 0;
        }
        sys_write(STDOUT_FD, "emit-js ", 8);
        sys_write(STDOUT_FD, source, strlen(source));
        sys_write(STDOUT_FD, " -> ", 4);
        sys_write(STDOUT_FD, output, strlen(output));
        sys_write(STDOUT_FD, " [js] ", 6);
        var jr = _emit_js(source, output);
        if (jr == 0) { println("OK"); } else { println("FAIL"); }
        return jr;
    }
    # cx arc: --target=cx routes to the cx bytecode compiler (cycc_cx), producing
    # a .cyx portable-bytecode file (run with `cyrius run <out>.cyx` via cxvm).
    if (_cx_target == 1) {
        if (_dry_run == 1) {
            sys_write(STDOUT_FD, "dry-run: emit-cx ", 17);
            sys_write(STDOUT_FD, source, strlen(source));
            sys_write(STDOUT_FD, " -> ", 4);
            sys_write(STDOUT_FD, output, strlen(output));
            sys_write(STDOUT_FD, "\n", 1);
            return 0;
        }
        sys_write(STDOUT_FD, "emit-cx ", 8);
        sys_write(STDOUT_FD, source, strlen(source));
        sys_write(STDOUT_FD, " -> ", 4);
        sys_write(STDOUT_FD, output, strlen(output));
        sys_write(STDOUT_FD, " [cx] ", 6);
        var xr = _emit_cx(source, output);
        if (xr == 0) { println("OK"); } else { println("FAIL"); }
        return xr;
    }
    if (_dry_run == 1) {
        sys_write(STDOUT_FD, "dry-run: compile ", 17);
        sys_write(STDOUT_FD, source, strlen(source));
        sys_write(STDOUT_FD, " -> ", 4);
        sys_write(STDOUT_FD, output, strlen(output));
        sys_write(STDOUT_FD, "\n", 1);
        return 0;
    }
    sys_write(STDOUT_FD, "compile ", 8);
    sys_write(STDOUT_FD, source, strlen(source));
    sys_write(STDOUT_FD, " -> ", 4);
    sys_write(STDOUT_FD, output, strlen(output));
    sys_write(STDOUT_FD, " [", 2);
    var an = arch_name();
    sys_write(STDOUT_FD, an, strlen(an));
    sys_write(STDOUT_FD, "] ", 2);
    var r = compile(source, output);
    if (r == 0) {
        # Apple Silicon AMFI-SIGKILLs an unsigned arm64 binary, so a fresh
        # `cyrius build` output won't run until it carries an ad-hoc signature
        # (CHANGELOG [6.0.38]). v6.0.66: hoisted into the shared _macho_codesign
        # helper (also used by run_binary for test/run/bench/fuzz/doctest).
        _macho_codesign(output);
        println("OK");
        # v6.2.28 D6: expose the kernel entry/load-base VA via the triple. A
        # freestanding kernel's loader/linker contract is the ELF e_entry the
        # emitter writes; surface it so a consumer (agnos's boot, a GRUB cfg, a
        # linker script) knows where the kernel lands without reverse-engineering
        # _entry_base. The qemu-boot-gate asserts the x86 value (0x1000a8), so a
        # drift between this line and the real e_entry fails D7. A non-canonical
        # load base (env-settable) is deferred — 1 MiB / 0x40000000 are the
        # canonical multiboot/AArch64 bases and no consumer needs another yet.
        # v6.3.3 #5: the base may be overridden by `[sections] base` — print the REAL
        # entry/base (canonical literal when unset) so the D6 report never drifts from
        # the emitted e_entry. entry = base + 0xA8 (x86 ELF64) / base + 0x78 (aarch64).
        if (_baremetal_target == 1) {
            if (_baremetal_aa == 1) {
                var ab = _section_base_val;
                if (ab == 0) { ab = 0x40000000; }
                sys_write(STDOUT_FD, "  kernel: entry ", 16);
                fmt_hex0x(ab + 0x78);
                sys_write(STDOUT_FD, ", load base ", 12);
                fmt_hex0x(ab);
                sys_write(STDOUT_FD, " (aarch64 ELF64)\n", 17);
            } else {
                var xb = _section_base_val;
                if (xb == 0) { xb = 0x100000; }
                sys_write(STDOUT_FD, "  kernel: entry ", 16);
                fmt_hex0x(xb + 0xA8);
                sys_write(STDOUT_FD, ", load base ", 12);
                fmt_hex0x(xb);
                sys_write(STDOUT_FD, " (x86_64 ELF64 multiboot2)\n", 27);
            }
        }
    } else {
        println("FAIL");
    }
    return r;
}

fn cmd_run(source): i64 {
    # cx arc: a .cyx is already-compiled portable bytecode — run it directly via
    # cxvm (no compile step). Detect by extension; everything else is the native
    # compile+exec path below. (A `.cyr` → cx compile-and-run in one shot could be
    # an additive `--cx` flag later; keeping run <foo>.cyr the native path.)
    if (str_ends_with(str_from(source), str_from(".cyx")) == 1) {
        if (_dry_run == 1) {
            sys_write(STDOUT_FD, "dry-run: run-cx ", 16);
            sys_write(STDOUT_FD, source, strlen(source));
            sys_write(STDOUT_FD, "\n", 1);
            return 0;
        }
        return run_cx(source);
    }
    if (_dry_run == 1) {
        sys_write(STDOUT_FD, "dry-run: compile + run ", 23);
        sys_write(STDOUT_FD, source, strlen(source));
        sys_write(STDOUT_FD, "\n", 1);
        return 0;
    }
    var tmpbin = _cbt_tmpfile("run");
    var r = compile(source, tmpbin);
    if (r != 0) {
        _err("compile failed");
        sys_unlink(tmpbin);
        return 1;
    }
    var exit_code = run_binary(tmpbin);
    sys_unlink(tmpbin);
    return exit_code;
}

fn cmd_test(source): i64 {
    _total = _total + 1;
    var tmpbin = _cbt_tmpfile("test_bin");
    var r = compile(source, tmpbin);
    if (r != 0) {
        sys_write(STDERR_FD, "  FAIL: ", 8);
        sys_write(STDERR_FD, source, strlen(source));
        sys_write(STDERR_FD, " (compile error)\n", 17);
        _fail = _fail + 1;
        sys_unlink(tmpbin);
        return 1;
    }
    # v6.5.19: BOUNDED. A .tcyr that spins used to hang the whole suite with no
    # deadline of any kind, and the only way out was to kill the runner — which
    # orphaned the child to PID 1, where it kept burning a core indefinitely (19 of
    # them were found during this release, and they turned a release-gate perf
    # tripwire red). See `run_binary_timed` in cbt/build.cyr for both halves of the
    # fix. Report the timeout BY NAME: a bare nonzero code here would read as an
    # ordinary assertion failure and send the reader into the test's logic.
    var exit_code = run_binary_timed(tmpbin, _run_timeout_ms());
    sys_unlink(tmpbin);
    if (exit_code == 0) {
        _pass = _pass + 1;
        return 0;
    }
    if (exit_code == _RUN_TIMEOUT_KILLED) {
        sys_write(STDERR_FD, "  FAIL: ", 8);
        sys_write(STDERR_FD, source, strlen(source));
        sys_write(STDERR_FD, " (timed out after ", 18);
        var tbuf[24];
        var tlen = fmt_int_buf(_run_timeout_ms() / 1000, &tbuf);
        sys_write(STDERR_FD, &tbuf, tlen);
        # strlen, not a hand-counted literal: the first cut of this line counted 61
        # for a 63-byte string (the em-dash is 3 bytes) and truncated its own hint
        # mid-word. There is no reason to count bytes by hand when strlen is in scope.
        var tmsg = "s — killed; set CYRIUS_TEST_TIMEOUT=<seconds>, 0 to disable)\n";
        sys_write(STDERR_FD, tmsg, strlen(tmsg));
    }
    _fail = _fail + 1;
    return exit_code;
}

# v6.0.62: `cyrius tests [dir]` — the plural verb, a RECURSIVE folder/suite
# runner (vs `cyrius test <file>` single-file + bare `cyrius test` shallow
# auto-discover, both unchanged). Walks `dir` (default "tests") for *.tcyr at
# any depth, runs each via cmd_test, aggregates _pass/_fail. Mirrors the
# proven shallow-discover pattern (dir_list + make_path → NUL-terminated cstr
# for cmd_test's strlen; dir_list already skips . / ..) rather than find_files,
# whose path_join Strs are not guaranteed NUL-terminated.
# v6.5.12: depth-bounded. `is_dir` follows symlinks (lib/fs.cyr, plain O_RDONLY), so a
# link to an ancestor made this re-descend until PATH_MAX — measured as **41 passed** for
# a tree holding ONE .tcyr. An inflated pass count reads as coverage, which is the worst
# possible failure for a test runner.
fn _tests_walk_d(dir, depth): i64 {
    if (depth > 64) {
        sys_write(STDERR_FD, "warning: test walk depth cap (64) hit — symlink loop? subtree skipped: ", 73);
        sys_write(STDERR_FD, dir, strlen(dir));
        sys_write(STDERR_FD, "\n", 1);
        return 0;
    }
    var entries = dir_list(str_from(dir));
    var ei = 0;
    while (ei < vec_len(entries)) {
        var name = vec_get(entries, ei);
        var full = make_path(dir, str_data(name));
        # v6.5.12: never DESCEND a symlink (lib/fs.cyr:is_symlink). A link to an
        # ancestor previously re-entered the same subtree, inflating the pass count.
        if (is_dir(str_from(full)) == 1) {
            # Descend only a REAL directory. A symlinked dir is skipped (loop guard);
            # a symlinked FILE falls through to the .tcyr arm below and still runs.
            if (is_symlink(str_from(full)) == 0) { _tests_walk_d(full, depth + 1); }
        }
        elif (str_ends_with(name, str_from(".tcyr")) == 1) {
            _tests_found = 1;
            cmd_test(full);
        }
        ei = ei + 1;
    }
    return 0;
}

fn _tests_walk(dir): i64 { return _tests_walk_d(dir, 0); }

fn cmd_tests(dir): i64 {
    _pass = 0; _fail = 0; _tests_found = 0;
    if (is_dir(str_from(dir)) == 0) {
        sys_write(STDERR_FD, "cyrius tests: not a directory: ", 31);
        sys_write(STDERR_FD, dir, strlen(dir));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    _tests_walk(dir);
    if (_tests_found == 0) {
        sys_write(STDOUT_FD, "No .tcyr files found under ", 27);
        sys_write(STDOUT_FD, dir, strlen(dir));
        sys_write(STDOUT_FD, "\n", 1);
        return 1;
    }
    sys_write(STDOUT_FD, "\n", 1);
    fmt_int(_pass);
    sys_write(STDOUT_FD, " passed, ", 9);
    fmt_int(_fail);
    println(" failed");
    if (_fail > 0) { return 1; }
    return 0;
}

# Walk `dir` for `*.fcyr` harnesses, compile and run each.
# Updates *passcnt / *failcnt / *found via caller-owned i64 storage.
# Returns the number of harnesses attempted.
# Compile + run one .fcyr harness, updating the caller-owned counters.
# Factored out of _fuzz_walk_dir at v6.5.7 so an explicit file argument runs
# through exactly the same path as a discovered one.
fn _fuzz_run_one(path, passcnt_ptr, failcnt_ptr, found_ptr): i64 {
    store64(found_ptr, 1);
    var tmpbin = _cbt_tmpfile("fuzz");
    var pl = strlen(path);
    sys_write(STDOUT_FD, "  ", 2);
    sys_write(STDOUT_FD, path, pl);
    var pad = 26 - pl;
    while (pad > 0) { sys_write(STDOUT_FD, " ", 1); pad = pad - 1; }
    if (compile(path, tmpbin) == 0) {
        var ec = run_binary_timed(tmpbin, _run_timeout_ms());
        sys_unlink(tmpbin);
        if (ec == 0) {
            println("PASS");
            store64(passcnt_ptr, load64(passcnt_ptr) + 1);
            return 0;
        }
        println("FAIL");
        store64(failcnt_ptr, load64(failcnt_ptr) + 1);
        return 1;
    }
    println("COMPILE FAIL");
    store64(failcnt_ptr, load64(failcnt_ptr) + 1);
    sys_unlink(tmpbin);
    return 1;
}

# v6.5.7: RECURSIVE, matching `_tests_walk` — see the note on _bench_walk_dir.
# v6.5.12: depth-bounded — see _tests_walk_d.
fn _fuzz_walk_dir_d(dir, passcnt_ptr, failcnt_ptr, found_ptr, depth): i64 {
    if (depth > 64) {
        sys_write(STDERR_FD, "warning: fuzz walk depth cap (64) hit — symlink loop? subtree skipped\n", 72);
        return 0;
    }
    if (file_exists(dir) == 0) { return 0; }
    var entries = dir_list(str_from(dir));
    var fi = 0;
    var n = 0;
    while (fi < vec_len(entries)) {
        var name = vec_get(entries, fi);
        var nd = str_data(name);
        var nl = str_len(name);
        var sub = make_path(dir, nd);
        if (is_dir(str_from(sub)) == 1) {
            if (is_symlink(str_from(sub)) == 0) {
                n = n + _fuzz_walk_dir_d(sub, passcnt_ptr, failcnt_ptr, found_ptr, depth + 1);
            }
        }
        # v6.5.12: `elif`, NOT a second `if`. A DIRECTORY named `x.fcyr` satisfied BOTH
        # arms — recursed into, then handed to compile() as a file — giving
        # `error: not a file` + COMPILE FAIL + a non-zero exit over a healthy tree.
        # `_tests_walk` (:199) already used `elif`; these two were the divergent siblings.
        elif (nl > 5) {
            if (memeq(nd + nl - 5, ".fcyr", 5) == 1) {
                n = n + 1;
                _fuzz_run_one(make_path(dir, nd), passcnt_ptr, failcnt_ptr, found_ptr);
            }
        }
        fi = fi + 1;
    }
    return n;
}

fn _fuzz_walk_dir(dir, passcnt_ptr, failcnt_ptr, found_ptr): i64 {
    return _fuzz_walk_dir_d(dir, passcnt_ptr, failcnt_ptr, found_ptr, 0);
}

fn cmd_fuzz(source): i64 {
    # Discover *.fcyr harnesses, compile and run each
    _status("=== cyrius fuzz ===");
    var pass_store[1];
    var fail_store[1];
    var found_store[1];
    store64(&pass_store, 0);
    store64(&fail_store, 0);
    store64(&found_store, 0);
    # v6.5.7: an explicit file or SUBFOLDER argument, symmetric with bench/tests.
    if (source != 0) {
        if (file_exists(source) == 0) {
            _err_ctx("no such file or directory", source);
            return 1;
        }
        if (is_dir(str_from(source)) == 1) {
            _fuzz_walk_dir(source, &pass_store, &fail_store, &found_store);
        } else {
            _fuzz_run_one(source, &pass_store, &fail_store, &found_store);
        }
        if (load64(&found_store) == 0) {
            _err_ctx("no fuzz harnesses found under", source);
            return 1;
        }
        return _bench_summary(load64(&pass_store), load64(&fail_store));
    }
    _fuzz_walk_dir("fuzz", &pass_store, &fail_store, &found_store);
    # v6.5.6 — also walk `tests/`. `cyrius init` scaffolds its fuzz harness to
    # `tests/<proj>.fcyr` (`_tests_rel` hardcodes "tests/" for ALL THREE extensions
    # and no fuzz/ dir is created), so every scaffolded project reported
    # "No fuzz harnesses found" against a harness the scaffolder had just written.
    # Exactly the gap v6.4.72 closed for the TEST corpus and v6.4.78 for BENCH —
    # fuzz was the third sibling that never got the same treatment. No double-count:
    # dir_list is non-recursive, so "fuzz" and "tests" are disjoint.
    _fuzz_walk_dir("tests", &pass_store, &fail_store, &found_store);
    var fuzz_pass = load64(&pass_store);
    var fuzz_fail = load64(&fail_store);
    if (load64(&found_store) == 0) {
        println("  No fuzz harnesses found (looked in fuzz/ and tests/).");
        println("  Create `fuzz/*.fcyr` files to test library functions.");
        return 0;
    }
    sys_write(STDOUT_FD, "\n=== ", 5);
    fmt_int(fuzz_pass);
    sys_write(STDOUT_FD, " passed, ", 9);
    fmt_int(fuzz_fail);
    println(" failed ===");
    if (fuzz_fail > 0) { return 1; }
    return 0;
}

# Print the `=== N passed, M failed ===` tail. Factored out at v6.5.7 so EVERY
# form that runs a harness prints it — it used to live inline in the no-arg path
# only, which made the single-file form unscriptable.
fn _bench_summary(passed, failed): i64 {
    sys_write(STDOUT_FD, "\n=== ", 5);
    fmt_int(passed);
    sys_write(STDOUT_FD, " passed, ", 9);
    fmt_int(failed);
    println(" failed ===");
    if (failed > 0) { return 1; }
    return 0;
}

# Run one .bcyr file: compile, execute, propagate exit code.
# Returns 0 on success, 1 on compile error, or the binary's exit code.
fn _bench_run_one(path): i64 {
    var tmpbin = _cbt_tmpfile("bench");
    var r = compile(path, tmpbin);
    if (r != 0) {
        sys_write(STDERR_FD, "FAIL: compile error\n", 20);
        sys_unlink(tmpbin);
        return 1;
    }
    var ec = run_binary_timed(tmpbin, _run_timeout_ms());
    sys_unlink(tmpbin);
    return ec;
}

# Walk `dir` for `*.bcyr` files and run each via _bench_run_one.
# Updates *passcnt / *failcnt / *found via caller-owned i64 storage.
# Returns the number of benches attempted.
# v6.5.7: RECURSIVE, matching `_tests_walk`. It was `dir_list`-flat, so a
# benchmark in a subfolder was invisible — `benches/perf/core.bcyr` simply never
# ran, and the command reported success over it. A subfolder callout has always
# been intended to work; the plural `cyrius tests <dir>` verb has recursed since
# v6.0.62 and bench/fuzz were never brought along.
# v6.5.12: depth-bounded — see _tests_walk_d.
fn _bench_walk_dir_d(dir, passcnt_ptr, failcnt_ptr, found_ptr, depth): i64 {
    if (depth > 64) {
        sys_write(STDERR_FD, "warning: bench walk depth cap (64) hit — symlink loop? subtree skipped\n", 73);
        return 0;
    }
    if (file_exists(dir) == 0) { return 0; }
    var entries = dir_list(str_from(dir));
    var fi = 0;
    var n = 0;
    while (fi < vec_len(entries)) {
        var name = vec_get(entries, fi);
        var nd = str_data(name);
        var nl = str_len(name);
        var sub = make_path(dir, nd);
        if (is_dir(str_from(sub)) == 1) {
            if (is_symlink(str_from(sub)) == 0) {
                n = n + _bench_walk_dir_d(sub, passcnt_ptr, failcnt_ptr, found_ptr, depth + 1);
            }
        }
        # v6.5.12: `elif` — see the note in _fuzz_walk_dir. Same divergence.
        elif (nl > 5) {
            if (memeq(nd + nl - 5, ".bcyr", 5) == 1) {
                store64(found_ptr, 1);
                var path = make_path(dir, nd);
                sys_write(STDOUT_FD, "  ", 2);
                sys_write(STDOUT_FD, path, strlen(path));
                sys_write(STDOUT_FD, "\n", 1);
                var ec = _bench_run_one(path);
                if (ec == 0) {
                    store64(passcnt_ptr, load64(passcnt_ptr) + 1);
                } else {
                    store64(failcnt_ptr, load64(failcnt_ptr) + 1);
                }
                n = n + 1;
            }
        }
        fi = fi + 1;
    }
    return n;
}

fn _bench_walk_dir(dir, passcnt_ptr, failcnt_ptr, found_ptr): i64 {
    return _bench_walk_dir_d(dir, passcnt_ptr, failcnt_ptr, found_ptr, 0);
}

fn cmd_bench(source): i64 {
    # v6.5.7: a DIRECTORY argument is now honoured — `cyrius bench benches/perf`
    # walks that subtree, symmetric with `cyrius tests <dir>`. It previously ran
    # nothing, printed nothing and exited 0, so a gate written that way passed
    # over zero benchmarks. A path that does not exist is refused rather than
    # silently building the auto-prepended stdlib into a do-nothing program.
    if (source != 0) {
        if (file_exists(source) == 0) {
            _err_ctx("no such file or directory", source);
            return 1;
        }
        if (is_dir(str_from(source)) == 1) {
            _status("=== cyrius bench ===");
            var dpass[1];
            var dfail[1];
            var dfound[1];
            store64(&dpass, 0);
            store64(&dfail, 0);
            store64(&dfound, 0);
            _bench_walk_dir(source, &dpass, &dfail, &dfound);
            if (load64(&dfound) == 0) {
                _err_ctx("no benchmarks found under", source);
                return 1;
            }
            return _bench_summary(load64(&dpass), load64(&dfail));
        }
        var ec = _bench_run_one(source);
        # Print the summary for the single-file form too — only the no-arg form
        # used to, so a script grepping for it found nothing on a run that worked.
        if (ec == 0) { return _bench_summary(1, 0); }
        _bench_summary(0, 1);
        return ec;
    }
    # No-arg mode: discover and run every `*.bcyr` in `benches/`
    # and `tests/bcyr/`. Mirrors `cmd_fuzz` / `cmd_test` shape so
    # downstream projects (takumi, majra, mabda, …) get the
    # obvious behavior instead of the cyrius-repo-specific
    # `bench-history.sh` shell script they never asked for. (The
    # cyrius repo's own CI invokes that script directly via
    # `sh scripts/bench-history.sh`.) (v5.5.27)
    _status("=== cyrius bench ===");
    var pass_store[1];
    store64(&pass_store, 0);
    var fail_store[1];
    store64(&fail_store, 0);
    var found_store[1];
    store64(&found_store, 0);
    # v6.4.78 added `tests/` alongside `benches/` + `tests/bcyr/` because a bench
    # at `tests/<name>.bcyr` was invisible (stiva's layout). v6.5.7 made the walk
    # RECURSIVE, which subsumes `tests/bcyr` under `tests` — so the explicit
    # `tests/bcyr` walk is DROPPED here. Keeping it would double-count every
    # bench under it, which the v6.4.78 comment's "no double-count: the walk is
    # non-recursive" reasoning explicitly depended on and which is now false.
    # `benches/` and `tests/` remain disjoint roots.
    _bench_walk_dir("benches", &pass_store, &fail_store, &found_store);
    _bench_walk_dir("tests", &pass_store, &fail_store, &found_store);
    if (load64(&found_store) == 0) {
        println("  No benchmarks found (looked in benches/, tests/ and tests/bcyr/, recursively).");
        println("  Create `benches/*.bcyr` files, or pass an explicit path:");
        println("    cyrius bench path/to/my_bench.bcyr");
        println("    cyrius bench path/to/subfolder");
        return 0;
    }
    return _bench_summary(load64(&pass_store), load64(&fail_store));
}

fn cmd_check(source, with_deps): i64 {
    # v5.7.8: default skip_deps=1 (parse the file standalone — syntax-
    # checking should not drag the manifest dep graph into the parse).
    # Pass --with-deps to opt back into the legacy auto-prepend
    # behavior, useful when checking a file that depends on stdlib
    # modules pulled in by the manifest.
    var actual = source;
    if (with_deps == 1) {
        # Legacy module-redirect: if FILE has no include directives,
        # try the project entry point so transitive symbols resolve.
        var check_buf = alloc(4096);
        var cn = file_read_all(source, check_buf, 4095);
        if (cn > 0) {
            store8(check_buf + cn, 0);
            # Build needle at runtime so cybs vet does not detect the
            # literal as an include directive in this source.
            var needle = alloc(9);
            store8(needle, 105); store8(needle + 1, 110); store8(needle + 2, 99);
            store8(needle + 3, 108); store8(needle + 4, 117); store8(needle + 5, 100);
            store8(needle + 6, 101); store8(needle + 7, 32); store8(needle + 8, 0);
            var has_inc = 0;
            var ci = 0;
            while (ci < cn - 8) {
                if (memeq(check_buf + ci, needle, 8) == 1) { has_inc = 1; break; }
                ci = ci + 1;
            }
            if (has_inc == 0) {
                if (file_exists("src/main.cyr") == 1) {
                    actual = "src/main.cyr";
                }
            }
        }
        # Only print the redirect line when actual != source — the
        # pre-v5.7.8 message fired even when source IS the entry,
        # producing the confusing "src/main.cyr is a module" tautology.
        if (streq(actual, source) == 0) {
            sys_write(STDOUT_FD, "check via ", 10);
            sys_write(STDOUT_FD, actual, strlen(actual));
            sys_write(STDOUT_FD, " (", 2);
            sys_write(STDOUT_FD, source, strlen(source));
            sys_write(STDOUT_FD, " is a module)\n", 14);
        }
    } else {
        # Default: parse standalone — skip the manifest auto-prepend.
        _skip_deps = 1;
    }
    # v5.7.8: PID-suffixed tmp path under /tmp. The pre-v5.7.8 path
    # `/dev/null` triggered a silent fork failure: compile() builds an
    # intermediate `<output>.tmp.<pid>` for atomic-rename, but
    # `/dev/null.tmp.<pid>` cannot be created (/dev/ is not writable),
    # so the fork sys_open(ofd) failed and sys_exit(1) ran with no
    # error message. cycc never actually ran in that path.
    var ck_pid = syscall(39);
    var ck_sb = str_builder_new();
    str_builder_add_cstr(ck_sb, _cbt_tmpfile("check_"));
    str_builder_add_int(ck_sb, ck_pid);
    var ck_out = str_data(str_builder_build(ck_sb));
    var r = compile(actual, ck_out);
    sys_unlink(ck_out);
    _skip_deps = 0;
    if (r == 0) {
        sys_write(STDOUT_FD, "ok: ", 4);
        println(source);
    } else {
        sys_write(STDERR_FD, "error: ", 7);
        println(source);
    }
    return r;
}

fn cmd_self(): i64 {
    # Delegate to inline self-hosting check script
    # (keeps fixup table small — full inline version needs too many relocations)
    _status("=== Self-Hosting Check ===");
    var pid = sys_fork();
    if (pid == 0) {
        var argv[40];   # N BYTES per CLAUDE.md buffer contract: 4 ptrs need 32 B
        store64(&argv, "/bin/sh");
        store64(&argv + 8, "-c");
        var script = alloc(512);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "cycc=/tmp/cyr_cc5_$$;cc4=/tmp/cyr_cc4_$$;");
        str_builder_add_cstr(sb, "cat src/main.cyr|");
        str_builder_add_cstr(sb, _cc);
        str_builder_add_cstr(sb, ">$cycc&&chmod +x $cycc&&cat src/main.cyr|$cycc>$cc4&&");
        str_builder_add_cstr(sb, "cmp -s $cycc $cc4&&echo '  PASS: cycc==cycc byte-identical'||");
        str_builder_add_cstr(sb, "(echo '  FAIL: cycc!=cycc';exit 1)");
        var cmd = str_builder_build(sb);
        store64(&argv + 16, str_data(cmd));
        store64(&argv + 24, 0);
        sys_execve("/bin/sh", &argv, _envp);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 1;
}

# v6.2.40: parse `[deps].stdlib = [...]` from the cwd's cyrius.cyml,
# returning a vec of declared module-name cstrings (or 0 if absent).
# Key-boundary-aware (mirrors cmd_deps' Phase-1 search) so a comment
# mentioning "stdlib" or a `[lib] modules = [...]` array isn't matched.
# Reuses _parse_toml_str_array (cbt/deps.cyr).
fn _libsync_declared_mods(): i64 {
    if (file_exists("cyrius.cyml") == 0) { return 0; }
    var buf = alloc(32768);
    var n = file_read_all("cyrius.cyml", buf, 32767);
    if (n <= 0) { return 0; }
    # v6.5.30 — route through the SHARED `_toml_key_at` (cbt/deps.cyr) instead of a
    # hand-rolled guard pair. The inline version checked the identifier boundary and the
    # comment line but NOT whether the match sits inside a QUOTED VALUE, so a
    # `description = "... foldable into stdlib per sandhi pattern"` matched as the key.
    # `_toml_key_at` counts unescaped quotes from line start and rejects an odd count.
    # ⛔ Third copy of one scan; `cmd_deps` was fixed at v6.5.17/.29 and these two were not.
    var si = 0;
    while (si < n) {
        if (memeq(buf + si, "stdlib", 6) == 1) {
            if (_toml_key_at(buf, n, si, 6) == 1) {
                # Keep scanning when the key yields nothing: `_parse_toml_str_array` is
                # positional and returns empty if it lands on a section header, so
                # committing to the first match can silently disable the whole result.
                var mods = _parse_toml_str_array(buf, n, si);
                if (vec_len(mods) > 0) { return mods; }
            }
        }
        si = si + 1;
    }
    return 0;
}

# v6.2.40: is snapshot file `name` (e.g. "sync_macos.cyr") wanted given
# the declared module set? Matches the declared stem exactly OR as a
# per-OS peer (`<decl>_*.cyr`) — e.g. declared "sync" pulls sync.cyr +
# sync_macos.cyr + sync_windows.cyr; "syscalls" pulls
# syscalls_x86_64_linux.cyr etc. (the "40 declared → 56 files" expansion
# the thoth filing documents). No transitive include-following — that's
# `cyrius deps`' job; `lib sync` vendors exactly the declared set.
fn _libsync_wanted(name, declared): i64 {
    var nlen = strlen(name);
    if (nlen <= 4) { return 0; }
    if (memeq(name + nlen - 4, ".cyr", 4) == 0) { return 0; }
    var stem = nlen - 4;
    var di = 0;
    while (di < vec_len(declared)) {
        var d = vec_get(declared, di);
        var dl = strlen(d);
        if (dl == stem && memeq(name, d, dl) == 1) { return 1; }
        if (dl < stem && memeq(name, d, dl) == 1 && load8(name + dl) == 95) { return 1; }
        di = di + 1;
    }
    return 0;
}

# v6.5.12: EXACT match of a snapshot entry against the declared list, with no
# ".cyr" requirement — the package-DIRECTORY counterpart of `_libsync_wanted`,
# which returns 0 for any name lacking the suffix (`:631`) and so could never see
# `lib/unicode/`. Returns the declared INDEX (>= 0) so the caller can mark it
# satisfied, or -1.
fn _libsync_declared_idx(name, declared): i64 {
    var nlen = strlen(name);
    var di = 0;
    while (di < vec_len(declared)) {
        var d = vec_get(declared, di);
        var dl = strlen(d);
        if (dl == nlen) {
            if (memeq(name, d, dl) == 1) { return di; }
        }
        di = di + 1;
    }
    return 0 - 1;
}

# v6.5.12: copy a stdlib PACKAGE DIRECTORY (`<snapshot>/lib/<name>/*.cyr`).
#
# ⛔ WHY THIS EXISTS. `cyrius deps` learned about package directories at v6.1.x —
# `deps.cyr:_dep_copy_stdlib_recursive` has the expansion and its comment names the
# exact consumer bug ("declaring bare `unicode` in [deps].stdlib … dropped the whole
# family"). `cyrius lib sync` was the UN-UPDATED TWIN and kept a flat, `.cyr`-only
# scan, so a consumer declaring `unicode` got a SUCCESS message and no unicode:
# reproduced at 6.5.11 as `copied 12 .cyr files` with `lib/unicode/` absent.
#
# This is the second time this pair has diverged — v6.4.77 found `cmd_lib_sync` was
# likewise the unguarded twin of `_check_lib_freshness`'s source-repo carve-out.
# When you change one, check the other.
#
# Returns the number of files copied.
fn _libsync_copy_pkg(src_dir, name): i64 {
    var s_sb = str_builder_new();
    str_builder_add_cstr(s_sb, src_dir);
    str_builder_add_cstr(s_sb, "/");
    str_builder_add_cstr(s_sb, name);
    var pkg_src = str_builder_build(s_sb);          # Str — dir_list takes a Str
    var entries = dir_list(pkg_src);
    if (entries == 0) { return 0; }
    var pkg_src_c = str_data(pkg_src);
    var dst_dir = make_path("lib", name);
    if (is_dir(str_from(dst_dir)) == 0) { sys_mkdir(dst_dir, 0x1ED); }
    var n = 0;
    var i = 0;
    while (i < vec_len(entries)) {
        var e = vec_get(entries, i);
        var ed = str_data(e);
        var el = str_len(e);
        if (el > 4) {
            if (memeq(ed + el - 4, ".cyr", 4) == 1) {
                var sp = make_path(pkg_src_c, ed);
                var dp = make_path(dst_dir, ed);
                if (_dry_run == 1) {
                    sys_write(STDOUT_FD, "  would sync: ", 14);
                    println(dp);
                } else {
                    _dep_copy_file(sp, dp);
                }
                n = n + 1;
            }
        }
        i = i + 1;
    }
    return n;
}

# ================================================================
# v6.4.63 — version-aware lib-freshness check (yeo-cy-test filing
# 2026-07-14-shadow-lib-silent-version-skew).
#
# WHY THIS EXISTS. A stale project-local ./lib/ shadows the version-pinned
# snapshot. cycc's `_check_shadow_lib` (src/frontend/lex.cyr) already emits a
# note, but it (a) byte-SIZE-compares ONE hardcoded sentinel (lib/alloc.cyr) and
# (b) names nothing when it fires — so a consumer cannot tell whether ./lib/ is
# byte-identical to the snapshot or three minor versions behind it. yeo-cy-test
# hit the latter, in CRYPTO: their lib/sigil.cyr was 3.9.8, predating sigil
# 3.9.9's `_SIGIL_CBANK_SLOT` 0->8 fix — a fix that exists BECAUSE OF that same
# consumer — while their patra declared TLS slot 0, the documented corruption
# condition. The toolchain let them ship a known-bad crypto configuration and
# said only "a shadow exists", which is true of every project using lib/ and so
# reads as routine noise.
#
# WHY HERE AND NOT IN cycc. The wrapper already has cross-platform dir_list
# (lib/fs.cyr) + file_read_all (lib/io.cyr) with the per-OS #ifdefs inside the
# lib files, and audit_walk.cyr's bundle markers — so the check costs no new
# syscall surface and works on Linux/macOS/Windows. cycc's frontend would need
# hand-rolled per-OS enumeration, and its check is Linux-HOST-only today (the
# #ifdef keys on host, not emit target), which is precisely the gap. `cyrius
# build` is also the only sanctioned consumer entry point (CLAUDE.md: never raw
# `cat | cycc` for projects), so this is where a consumer will see it.
#
# `lib sync`'s _libsync_wanted() scoping is deliberately NOT reused: sigil et al.
# are FOLDED (vendored into lib/ and removed from [deps]), so they are absent
# from [deps].stdlib and a wanted-filtered walk would skip the exact files that
# matter. We walk every ./lib/*.cyr and let the version header be the filter.
# ================================================================

# The two shipped bundle-header formats. Kept local (not reusing audit_walk's
# _AW_MARKER_*) because those answer "is this vendored?" while these answer
# "what version?" — different prefixes, and only 12 of 99 libs carry either:
#   1. `cyrius distlib`    -> `# Version: 3.11.1`                     (11 libs)
#   2. `scripts/bundle.sh` -> `# Bundled distribution of sakshi v2.4.6` (sakshi
#      only — predates cyrius distlib; a `# Version: ` parser silently skips it,
#      and sakshi is the base logger, so that omission would itself be rot.)
# The other 87 are hand-written stdlib with no version — nothing to compare.
var _LIBFRESH_MARK_VER = "# Version: ";
var _LIBFRESH_MARK_BUNDLE = "# Bundled distribution of ";

# Copy the version token at `p` (up to `max` bytes) into a fresh cstr, stopping
# at whitespace/EOL. Returns 0 for an empty token.
fn _libfresh_take(p, max): i64 {
    var len = 0;
    while (len < max) {
        var c = load8(p + len);
        if (c == 10 || c == 13 || c == 32 || c == 9 || c == 0) { break; }
        len = len + 1;
    }
    if (len == 0) { return 0; }
    var out = alloc(len + 1);
    var k = 0;
    while (k < len) {
        store8(out + k, load8(p + k));
        k = k + 1;
    }
    store8(out + len, 0);
    return out;
}

# Parse the bundled-lib version from the head of `path` (cstr). Returns an
# alloc'd version cstr, or 0 when the file carries neither header format.
# Scans line starts only, over the first 512 bytes — `# Profile:` is optional
# and shifts the "Generated by" line, so fixed line numbers are not safe.
fn _libfresh_version(path): i64 {
    var buf = alloc(513);
    var n = file_read_all(path, buf, 512);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    var vlen = strlen(_LIBFRESH_MARK_VER);
    var blen = strlen(_LIBFRESH_MARK_BUNDLE);
    var i = 0;
    while (i < n) {
        # `i` is at a line start.
        if (str_starts_with_buf(buf + i, n - i, _LIBFRESH_MARK_VER) == 1) {
            return _libfresh_take(buf + i + vlen, n - i - vlen);
        }
        if (str_starts_with_buf(buf + i, n - i, _LIBFRESH_MARK_BUNDLE) == 1) {
            # `# Bundled distribution of <name> v2.4.6` — take the token after
            # the " v" that precedes the version, bounded to this line.
            var j = i + blen;
            while (j < n) {
                if (load8(buf + j) == 10) { break; }
                if (load8(buf + j) == 32) {
                    if (load8(buf + j + 1) == 118) {   # ' ' then 'v'
                        return _libfresh_take(buf + j + 2, n - j - 2);
                    }
                }
                j = j + 1;
            }
        }
        # Advance past this line.
        while (i < n) {
            if (load8(buf + i) == 10) { i = i + 1; break; }
            i = i + 1;
        }
    }
    return 0;
}

# Compare every versioned ./lib/*.cyr against the version-pinned snapshot and
# name the drift. Returns the number of skewed bundles (0 = fresh/not
# applicable). `strict` = 1 makes any drift an error (exit 1) instead of a
# warning — used by `cyrius build --check-lib-sync` for CI.
fn _check_lib_freshness(strict): i64 {
    # The cyrius source repo IS the stdlib — ./lib is canonical here, never a
    # shadow. Use the NAME-based signal (`[package] name = "cyrius"`), NOT
    # _dep_find_stdlib_dir's priority-(a) `file_exists("src/main.cyr")`: downstream
    # repos (gnoboot, kybernet, yeo-cy-test) ALSO build from src/main.cyr and have
    # a ./lib of resolved deps, so that conflation would silently disable this
    # check for exactly the consumers it exists to protect. Same conflation was
    # the v6.0.1 mkdir bug — see deps.cyr:_dep_is_cyrius_source_repo.
    if (_dep_is_cyrius_source_repo() == 1) { return 0; }
    # Only a ./lib/ that actually shadows stdlib is in scope (an empty lib/, or
    # one holding unrelated project-local modules, is not — the v5.11.57 lesson).
    if (_dep_dir_has_stdlib("lib") == 0) { return 0; }
    if (strict == 0) {
        if (_cbt_env_is_1("CYRIUS_NO_WARN_SHADOW_LIB") == 1) { return 0; }
    }
    var ver = _dep_read_cyml_cyrius_field();
    if (ver == 0) { ver = _VERSION_TOOLCHAIN; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, _home);
    str_builder_add_cstr(sb, "/versions/");
    str_builder_add_cstr(sb, ver);
    str_builder_add_cstr(sb, "/lib");
    var snap = str_data(str_builder_build(sb));
    # No snapshot for this pin -> silent. `cyrius lib sync` already reports that
    # case properly; a build-time check must not become noise. Probe via
    # _dep_dir_has_stdlib, NOT is_dir — is_dir false-negatives on Darwin
    # (CHANGELOG [6.0.40]).
    if (_dep_dir_has_stdlib(snap) == 0) { return 0; }
    var entries = dir_list(str_from("lib"));
    if (entries == 0) { return 0; }
    var list_sb = str_builder_new();
    var drift = 0;
    var li = 0;
    while (li < vec_len(entries)) {
        var name = str_data(vec_get(entries, li));
        li = li + 1;
        var nlen = strlen(name);
        if (nlen <= 4) { continue; }
        if (memeq(name + nlen - 4, ".cyr", 4) == 0) { continue; }
        var lv = _libfresh_version(make_path("lib", name));
        if (lv == 0) { continue; }                    # unversioned stdlib module
        var sv = _libfresh_version(make_path(snap, name));
        if (sv == 0) { continue; }                    # absent/unversioned in the pin
        if (streq(lv, sv) == 1) { continue; }
        if (drift > 0) { str_builder_add_cstr(list_sb, ", "); }
        var stem = alloc(nlen - 3);
        var si = 0;
        while (si < nlen - 4) {
            store8(stem + si, load8(name + si));
            si = si + 1;
        }
        store8(stem + nlen - 4, 0);
        str_builder_add_cstr(list_sb, stem);
        str_builder_add_cstr(list_sb, " ");
        str_builder_add_cstr(list_sb, lv);
        str_builder_add_cstr(list_sb, " (pinned: ");
        str_builder_add_cstr(list_sb, sv);
        str_builder_add_cstr(list_sb, ")");
        drift = drift + 1;
    }
    if (drift == 0) { return 0; }
    var listed = str_data(str_builder_build(list_sb));
    if (strict == 1) {
        sys_write(STDERR_FD, "error: ./lib/ is stale vs version-pinned ", 41);
    } else {
        sys_write(STDERR_FD, "warning: ./lib/ shadows version-pinned ", 39);
    }
    sys_write(STDERR_FD, snap, strlen(snap));
    sys_write(STDERR_FD, " — ", 5);
    fmt_int_fd(STDERR_FD, drift);
    sys_write(STDERR_FD, " bundled lib(s) differ:\n      ", 30);
    sys_write(STDERR_FD, listed, strlen(listed));
    sys_write(STDERR_FD, "\n  run `cyrius lib sync --full` to re-sync", 42);
    if (strict == 1) {
        sys_write(STDERR_FD, " (--check-lib-sync)\n", 20);
        return drift;
    }
    sys_write(STDERR_FD, ", or set CYRIUS_NO_WARN_SHADOW_LIB=1 to silence\n", 48);
    return drift;
}

# v5.11.58: `cyrius lib sync` — vendor the pin snapshot's stdlib into
# ./lib/. Closes the third-remediation gap from the iron-boot papercut
# filing Item 4 (alternatives were destructive "delete ./lib/" or the
# silencing CYRIUS_NO_WARN_SHADOW_LIB=1). Overwrites local copies with
# the snapshot for pin-faithful builds.
#
# v6.2.40 (thoth filing 2026-06-11): scope to the project's declared
# `[deps].stdlib` (+ per-OS peers) by default, so a curated committed
# ./lib/ isn't blown up to the full ~88-module snapshot on every sync.
# `--full` keeps the whole-snapshot behavior; a project with no
# `[deps].stdlib` declaration also falls back to full (so it never ends
# up with an empty lib/).
#
# Source version: cyrius.cyml [package].cyrius pin if present,
# else the wrapper's own _VERSION_TOOLCHAIN. Snapshot must
# exist at ~/.cyrius/versions/<v>/lib/ or we error out.
fn cmd_lib_sync(): i64 {
    # v6.4.77 — REFUSE inside the cyrius source repo. `lib sync` copies
    # ~/.cyrius/versions/<pin>/lib OVER ./lib, which is correct for a consumer
    # (whose ./lib is a resolved-dep cache) and catastrophic here: in THIS repo
    # ./lib IS the canonical source of every folded stdlib (the sandhi pattern —
    # sandhi/sigil/patra/mabda/… are tracked byte-snapshots of upstream dists, not
    # resolved deps). A sync would silently revert every fold to whatever the
    # snapshot holds, and because the snapshot is refreshed FROM ./lib by
    # install.sh --refresh-only, the damage can look like a no-op until a fold that
    # landed after the last bump quietly disappears.
    # `_check_lib_freshness` (:651) already carves this repo out for exactly this
    # reason; this fn was the unguarded twin. Erroring rather than returning 0
    # silently — the user typed the command, so say why it is refused.
    # See CLAUDE.md "Downstream repo setup" + deps.cyr:_dep_is_cyrius_source_repo.
    if (_dep_is_cyrius_source_repo() == 1) {
        sys_write(STDERR_FD, "error: `lib sync` refused in the cyrius source repo\n", 52);
        sys_write(STDERR_FD, "  ./lib/ here is the CANONICAL source of the folded stdlib (sandhi pattern),\n", 77);
        sys_write(STDERR_FD, "  not a resolved-dep cache — syncing would revert every fold.\n", 64);
        sys_write(STDERR_FD, "  To refresh a folded dep: cp <upstream>/dist/<name>.cyr lib/<name>.cyr\n", 72);
        return 1;
    }
    var sync_ver = _dep_read_cyml_cyrius_field();
    if (sync_ver == 0) { sync_ver = _VERSION_TOOLCHAIN; }
    var src_sb = str_builder_new();
    str_builder_add_cstr(src_sb, _home);
    str_builder_add_cstr(src_sb, "/versions/");
    str_builder_add_cstr(src_sb, sync_ver);
    str_builder_add_cstr(src_sb, "/lib");
    var src_dir = str_data(str_builder_build(src_sb));
    if (is_dir(str_from(src_dir)) == 0) {
        sys_write(STDERR_FD, "error: snapshot lib not found at ", 33);
        sys_write(STDERR_FD, src_dir, strlen(src_dir));
        sys_write(STDERR_FD, "\n  run: cyrius install ", 23);
        sys_write(STDERR_FD, sync_ver, strlen(sync_ver));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    if (is_dir(str_from("lib")) == 0) {
        sys_mkdir("lib", 0x1ED);
    }
    # Scope to declared [deps].stdlib (+ per-OS peers) unless --full.
    # No declaration → full copy (a curated empty lib/ is never the intent).
    var declared = 0;
    if (_lib_sync_full == 0) {
        declared = _libsync_declared_mods();
        if (declared != 0) { if (vec_len(declared) == 0) { declared = 0; } }
    }
    var entries = dir_list(str_from(src_dir));
    var li = 0;
    var copied = 0;
    # v6.5.12: per-declared-module SATISFIED flags. Without this, a declared module
    # the scan cannot see is dropped and the command still prints a success line —
    # which is exactly how `unicode` went unnoticed. Same shape as the v6.5.10
    # distlib-sidecar defect: an under-reporting producer silently disabling the
    # check that exists to catch it.
    var nd = 0;
    if (declared != 0) { nd = vec_len(declared); }
    var sat = 0;
    if (nd > 0) {
        sat = alloc(nd * 8);
        var zi = 0;
        while (zi < nd) { store64(sat + zi * 8, 0); zi = zi + 1; }
    }
    while (li < vec_len(entries)) {
        var name_str = vec_get(entries, li);
        var name = str_data(name_str);
        var nlen = strlen(name);
        var is_cyr = 0;
        if (nlen > 4) {
            if (load8(name + nlen - 4) == 46) {
                if (load8(name + nlen - 3) == 99) {
                    if (load8(name + nlen - 2) == 121) {
                        if (load8(name + nlen - 1) == 114) {
                            is_cyr = 1;
                        }
                    }
                }
            }
        }
        if (is_cyr == 1) {
            var want = 1;
            if (declared != 0) { want = _libsync_wanted(name, declared); }
            if (want == 1) {
                var src_path = make_path(src_dir, name);
                var dst_path = make_path("lib", name);
                if (_dry_run == 1) {
                    sys_write(STDOUT_FD, "  would sync: ", 14);
                    println(dst_path);
                } else {
                    _dep_copy_file(src_path, dst_path);
                }
                # v6.2.40: count in BOTH modes — pre-fix the dry-run
                # summary always printed 0 (counter lived in the else).
                copied = copied + 1;
                # Mark the declared entry this file satisfied. The stem may be a
                # per-OS peer (`syscalls_macos.cyr` ← `syscalls`), so re-use the
                # same prefix rule `_libsync_wanted` matched on.
                if (nd > 0) {
                    var mi = 0;
                    while (mi < nd) {
                        var dm = vec_get(declared, mi);
                        var dml = strlen(dm);
                        if (dml < nlen) {
                            if (memeq(name, dm, dml) == 1) { store64(sat + mi * 8, 1); }
                        }
                        mi = mi + 1;
                    }
                }
            }
        } else {
            # v6.5.12: PACKAGE DIRECTORY (`lib/<name>/*.cyr`, e.g. unicode). The
            # `.cyr` filter above can never match one, and neither can
            # `_libsync_wanted` — hence the dedicated path.
            var pidx = 0 - 1;
            if (declared != 0) { pidx = _libsync_declared_idx(name, declared); }
            var pkg_want = 0;
            if (declared == 0) { pkg_want = 1; }
            if (pidx >= 0) { pkg_want = 1; }
            if (pkg_want == 1) {
                var pkg_path = make_path(src_dir, name);
                if (is_dir(str_from(pkg_path)) == 1) {
                    var got = _libsync_copy_pkg(src_dir, name);
                    if (got > 0) {
                        copied = copied + got;
                        if (pidx >= 0) { store64(sat + pidx * 8, 1); }
                    }
                }
            }
        }
        li = li + 1;
    }
    # ⛔ v6.5.12: FAIL LOUD on a declared module the scan never satisfied. Reporting
    # a copy count while silently dropping a declared dependency is the failure this
    # whole change exists to end — the consumer then hits unresolved symbols with no
    # link back to `lib sync`.
    if (nd > 0) {
        var missing = 0;
        var ci = 0;
        while (ci < nd) {
            if (load64(sat + ci * 8) == 0) {
                if (missing == 0) {
                    sys_write(STDERR_FD, "error: declared [deps].stdlib module(s) not found in the snapshot:\n", 67);
                }
                sys_write(STDERR_FD, "  - ", 4);
                var mn = vec_get(declared, ci);
                sys_write(STDERR_FD, mn, strlen(mn));
                sys_write(STDERR_FD, "\n", 1);
                missing = missing + 1;
            }
            ci = ci + 1;
        }
        if (missing > 0) {
            sys_write(STDERR_FD, "  snapshot: ", 12);
            sys_write(STDERR_FD, src_dir, strlen(src_dir));
            # 68, not 66: the em-dash is THREE UTF-8 bytes. A short count here
            # silently truncates the tail of the message (this one lost ".\n" on
            # first write) — the `ERR_MSG` hardcoded-length class.
            sys_write(STDERR_FD, "\n  nothing was dropped silently — fix the declaration or the pin.\n", 68);
            return 1;
        }
    }
    if (_dry_run == 1) {
        sys_write(STDOUT_FD, "dry-run: would sync ", 20);
    } else {
        sys_write(STDOUT_FD, "synced from ", 12);
        sys_write(STDOUT_FD, src_dir, strlen(src_dir));
        sys_write(STDOUT_FD, " — copied ", 12);
    }
    fmt_int(copied);
    if (declared != 0) {
        println(" .cyr files (declared [deps].stdlib subset; --full for whole snapshot)");
    } else {
        println(" .cyr files (full snapshot)");
    }
    return 0;
}

fn cmd_clean(): i64 {
    # Remove build/ contents except cycc, cybs, asm
    if (is_dir(str_from("build")) == 0) {
        println("nothing to clean");
        return 0;
    }
    var entries = dir_list(str_from("build"));
    var ci = 0;
    var cleaned = 0;
    while (ci < vec_len(entries)) {
        var name = vec_get(entries, ci);
        var skip = 0;
        if (str_eq(name, str_from("cc")) == 1) { skip = 1; }
        if (str_eq(name, str_from("cycc")) == 1) { skip = 1; }
        if (str_eq(name, str_from("cybs")) == 1) { skip = 1; }
        if (str_eq(name, str_from("asm")) == 1) { skip = 1; }
        if (str_eq(name, str_from("cycc_aarch64")) == 1) { skip = 1; }
        if (str_eq(name, str_from("cyrius")) == 1) { skip = 1; }
        if (skip == 0) {
            var full = make_path("build", str_data(name));
            if (_dry_run == 1) {
                sys_write(STDOUT_FD, "  would remove: ", 16);
                println(full);
            } else {
                sys_unlink(full);
            }
            cleaned = cleaned + 1;
        }
        ci = ci + 1;
    }
    if (_dry_run == 1) {
        sys_write(STDOUT_FD, "dry-run: would remove ", 22);
    } else {
        sys_write(STDOUT_FD, "cleaned build/ (preserved cycc, cybs, asm, cyrius) — removed ", 63);
    }
    fmt_int(cleaned);
    println(" files");
    return 0;
}

# ================================================================
# Quality commands — delegate to companion tools
# ================================================================

# v6.5.28 — `mode`: 0 = WRITE IN PLACE (the new default), 1 = --check, 2 = --dry
# (report what would change, touch nothing), 3 = --verbose (write in place AND echo to stdout).
#
# ⚠ BREAKING CLI CHANGE, taken deliberately (maintainer 2026-08-18). `cyrius fmt <file>` used
# to print to stdout and never touch the file, so `--check` could flag a file the tool gave
# you no in-place way to fix — the state rupa hit and worked around by un-wrapping every call.
# Scripts that relied on the old stdout-only behaviour move to `--dry` (report) or
# `--verbose` (write + echo).
fn cmd_fmt(file, check_mode): i64 {
    var cyrfmt = make_path(_tools_dir, "cyrfmt");
    if (check_mode == 2) {
        # --dry: run the CHECK (which never writes) and translate its verdict, so "would
        # change" and "is not canonical" cannot drift apart — they are the same question.
        var drc = run_tool(cyrfmt, "--check", file, 0);
        if (drc == 0) { println("cyrius fmt --dry: already canonically formatted"); return 0; }
        println("cyrius fmt --dry: WOULD reformat (see the diagnostic above); file left unchanged");
        return drc;
    }
    if (check_mode == 3) {
        # --verbose: write in place, then echo the canonical result to stdout.
        var vrc = run_tool(cyrfmt, "--write", file, 0);
        if (vrc != 0) { return vrc; }
        return run_tool(cyrfmt, file, 0, 0);
    }
    if (check_mode == 1) {
        # v5.8.42: cyrfmt main parses `--check` ONLY at argv(1).
        # Pre-fix this arg order was reversed (file, "--check"),
        # so cyrfmt saw the file at argv(1), set _check_mode=0,
        # and silently dumped the formatted output to stdout
        # — drift never detected, exit 0 regardless. Mabda A2
        # surfaced via CI gate that depended on `cyrius fmt
        # --check` returning non-zero on drift; it never did.
        # Now matches Rust/Go behavior: silent on no-drift,
        # exit non-zero on drift.
        return run_tool(cyrfmt, "--check", file, 0);
    }
    # DEFAULT: rewrite in place (was: print to stdout and leave the file alone).
    return run_tool(cyrfmt, "--write", file, 0);
}

# cyrius hooks install — copy the repo's build-artifact pre-commit hook
# into .git/hooks/ so commits can't ship a contaminated build/cycc.
# See scripts/hooks/pre-commit + CHANGELOG [6.0.36]. install.sh also
# installs it on --refresh-only; this verb is the explicit/manual path.
fn cmd_hooks(action): i64 {
    if (streq(action, "install") == 0) {
        println("Usage: cyrius hooks install");
        return 1;
    }
    if (file_exists(".git") == 0) {
        println("error: not a git repository (.git not found)");
        return 1;
    }
    if (file_exists("scripts/hooks/pre-commit") == 0) {
        println("error: scripts/hooks/pre-commit not found (run from the cyrius repo root)");
        return 1;
    }
    var r = sys_system("cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit");
    if (r == 0) {
        println("installed build-artifact pre-commit hook (.git/hooks/pre-commit)");
    } else {
        println("error: failed to install hook");
    }
    return r;
}

# ================================================================
# lint — syntax pre-pass (v6.5.19)
# ================================================================
# THE FILED DEFECT (hisab, the residual half of the dead-fn-body filing).
# `cyrius lint` reported `0 warnings`, exit 0, on a file `cyrius build` rejects with
# `unexpected ';'`. `programs/cyrlint.cyr` is a LINE-BASED SCANNER — 929 lines of
# `memeq` at raw byte offsets, one `brace_depth` counter, no token stream and no AST —
# so "does this file parse?" is not a question it can ask. `0 warnings` was an honest
# report about its own nine rules and a false one about the file.
#
# THE FORK, AND WHY (a). The filing named three options and left the choice open:
#   (a) run a compiler syntax pre-pass  <- CHOSEN
#   (b) give cyrlint a real front end
#   (c) just reword the summary
# (b) is a SECOND PARSER for one language, forever, in the repo whose thesis is one
# toolchain: src/frontend/ is 17,703 lines carrying ~1,040 `E*(S, ...)` emitter call
# sites and threads `S` (the compiler heap base) through every function — the parser IS
# the emitter, so there is no parse-only slice to lift. This tree already has the
# receipt for what a divergent copy costs: the v6.5.17 dead-fn-body bug was fork-
# divergent across the 7 `main*` forks and shipped green for months. (c) leaves the
# linter still unable to answer the question. (a) reuses the component that is already
# correct and stays entirely inside cbt/.
#
# ⭐ THE TRAP, AND THE RULE THAT AVOIDS IT: **classify on the MESSAGE, never on the
# exit code.** 38 of the 191 files `cyrius audit` lints in this very repo exit non-zero
# standalone, 27 of them with `undefined variable 'X' (missing include or enum?)` —
# emitted through the SAME `_err_head` as `unexpected ';'`, identical shape, identical
# exit 1. Gating on the exit code would make lint REFUSE 20 % of the stdlib, which is
# the "linter that refuses to lint" the filing explicitly warned against; a lint of ONE
# file in isolation, with no manifest and no lib/, is the whole point of the verb.
# So: `_skip_deps = 1` (never drag the dep graph into a lint), `--allow-undef`, and a
# POSITIVE allow-list of syntax-class message prefixes.
#
# ⭐ THE ALLOW-LIST IS ONLY AS HONEST AS THE COMPILER'S MESSAGE CLASSES, AND AT 6.5.19
# IT WAS NOT. This block used to claim the failure direction was the safe one —
# "never a false accusation against a file that merely lacks context" — and cited
# "0 false positives across all 191 files". **Both halves were an artefact of
# measuring only IN-REPO.** Six struct-field sites in `src/frontend/parse_decl.cyr`
# reported resolution failures through `ERR(S)`, the SYNTAX emitter, so
# `total = total + e.size;` — with `Entry` declared in a SIBLING file, the ordinary
# shape for any project whose manifest concatenates modules — came back
# `unexpected ';'` and was condemned. In-repo exposure really is zero (cyrius' own
# modules include their struct definitions), which is exactly why 191/191 looked
# clean; the sweep that found it ran 472 files across NINE repos and hit 3, all in
# stiva — the repo that filed this issue. Fixed at the ROOT (v6.5.19: `ERR_IDENT`
# in src/common/util.cyr; those six sites now emit `no struct type in scope for
# 'e'` / `unknown field 'x' on struct 'Y'`), NOT by weakening the predicate here —
# the filed repro is literally `unexpected ';'`, so dropping that prefix would have
# gutted the detection the issue asked for.
# RE-MEASURED at 6.5.19: 0 refusals across all 472 files, 6/6 detection on broken
# shapes. Gate axis 6 in tests/gates/frontend/lint_reports_unparseable.sh pins the
# cross-file shape so the hole cannot reopen silently.
#
# COST: ~89 ms per lint against ~6 ms for cyrlint alone. It does NOT touch
# `cyrius audit`: `audit_lint_walk` (lib/audit_walk.cyr) execs the cyrlint BINARY
# directly and never routes through this function.

fn _lint_pfx(p, n, s): i64 {
    var sl = strlen(s);
    if (n < sl) { return 0; }
    return memeq(p, s, sl);
}

# The allow-list. Every entry is a message a SYNTAX error produces; nothing here can be
# produced by name resolution, type checking or capacity. Grep `src/frontend/` for
# `syscall(SYS_WRITE, 2, ": ` to see the full message table this is drawn from.
fn _lint_msg_is_syntax(p, n): i64 {
    if (_lint_pfx(p, n, "unexpected ") == 1) { return 1; }
    if (_lint_pfx(p, n, "expected ") == 1) { return 1; }
    if (_lint_pfx(p, n, "unterminated ") == 1) { return 1; }
    if (_lint_pfx(p, n, "unknown char escape") == 1) { return 1; }
    if (_lint_pfx(p, n, "non-ASCII byte ") == 1) { return 1; }
    if (_lint_pfx(p, n, "multi-byte char literal") == 1) { return 1; }
    if (_lint_pfx(p, n, "\\x escape") == 1) { return 1; }
    if (_lint_pfx(p, n, "\\u escape") == 1) { return 1; }
    if (_lint_pfx(p, n, "\\u{...}") == 1) { return 1; }
    if (_lint_pfx(p, n, "nested @unsafe") == 1) { return 1; }
    return 0;
}

# Does the captured stderr carry a syntax-class error? Diagnostics are
# `error:<file>:<line>:<col>: <message>`; the location can never contain a COLON
# FOLLOWED BY A SPACE (line and column are digits), so the first `": "` ends it — the
# message itself may well contain more, e.g. `expected ';', got ...`.
fn _lint_capture_has_syntax(buf, n): i64 {
    var p = 0;
    while (p < n) {
        var ls = p;
        while (p < n) { if (load8(buf + p) == 10) { break; } p = p + 1; }
        var le = p;
        if (p < n) { p = p + 1; }
        if (le - ls > 6) {
            if (memeq(buf + ls, "error:", 6) == 1) {
                var q = ls + 6;
                var mstart = 0;
                while (q + 1 < le && mstart == 0) {
                    if (load8(buf + q) == 58) { if (load8(buf + q + 1) == 32) { mstart = q + 2; } }
                    q = q + 1;
                }
                if (mstart > 0) {
                    if (_lint_msg_is_syntax(buf + mstart, le - mstart) == 1) { return 1; }
                }
            }
        }
    }
    return 0;
}

# Forward the compiler's OWN diagnostic rather than inventing a new one: the `error:`
# lines plus their indented source excerpt / caret / hint continuations.
fn _lint_forward_diag(buf, n): i64 {
    var p = 0;
    while (p < n) {
        var ls = p;
        while (p < n) { if (load8(buf + p) == 10) { break; } p = p + 1; }
        var le = p;
        if (p < n) { p = p + 1; }
        var ll = le - ls;
        var emit = 0;
        if (ll >= 6) { if (memeq(buf + ls, "error:", 6) == 1) { emit = 1; } }
        if (ll >= 1) { if (load8(buf + ls) == 32) { emit = 1; } }
        if (emit == 1) {
            sys_write(STDERR_FD, buf + ls, ll);
            sys_write(STDERR_FD, "\n", 1);
        }
    }
    return 0;
}

# 0 = parses (or we could not tell) -> run the line checks exactly as before.
# 1 = a syntax error was reported -> the caller must not pretend to have linted.
fn _lint_syntax_prepass(file): i64 {
    if (file_exists(file) == 0) { return 0; }        # let cyrlint report the missing file
    var cc = current_cc();
    if (cc == 0) { return 0; }                       # no compiler -> lint as before
    if (file_exists(cc) == 0) { return 0; }
    var errf = _cbt_tmpfile("lint_err");
    var outf = _cbt_tmpfile("lint_out");
    var sv_skip = _skip_deps;
    var sv_undef = _cc_allow_undef;
    var sv_syn = _cc_syntax_only;
    _skip_deps = 1;          # ⭐ lint ONE file in isolation — never resolve the dep graph
    _cc_allow_undef = 1;     # undefined FNS are expected with no stdlib in scope
    # v6.5.19: undefined VARIABLES are expected too, and unlike undefined fns they
    # were a PARSE-TIME abort that --allow-undef cannot reach. Without this the
    # compiler stopped at the first missing include and never reached the file's
    # syntax errors, so lint printed `0 warnings` on a file that does not parse —
    # verbatim the filed defect. See _syntax_only (src/common/util.cyr).
    _cc_syntax_only = 1;
    _cc_stderr_to = errf;
    var cr = compile(file, outf);
    _cc_stderr_to = 0;
    _cc_syntax_only = sv_syn;
    _cc_allow_undef = sv_undef;
    _skip_deps = sv_skip;
    sys_unlink(outf);
    if (cr == 0) { sys_unlink(errf); return 0; }
    var buf = alloc(65536);
    var n = file_read_all(errf, buf, 65535);
    sys_unlink(errf);
    if (n <= 0) { return 0; }                        # no capture (or none possible) -> lint
    store8(buf + n, 0);
    if (_lint_capture_has_syntax(buf, n) == 0) { return 0; }   # resolution error -> lint
    _err_ctx("does not parse, so lint checks were NOT run", file);
    _info("  cyrlint is a line-based scanner with no parser, so its \"0 warnings\" would");
    _info("  describe its own rules rather than the file. The compiler reports:");
    _lint_forward_diag(buf, n);
    return 1;
}

fn cmd_lint(file, strict): i64 {
    # v6.5.19: syntax pre-pass BEFORE the line checks. See the block above for why the
    # verdict keys on the message class and not on the exit code.
    if (_lint_syntax_prepass(file) != 0) { return 1; }
    var cyrlint = make_path(_tools_dir, "cyrlint");
    # --strict makes cyrlint exit 2 when warnings are present (default is
    # a conventional 0/1 rc — see programs/cyrlint.cyr). CHANGELOG [6.0.36].
    if (strict == 1) { return run_tool(cyrlint, "--strict", file, 0); }
    return run_tool(cyrlint, file, 0, 0);
}

# v5.7.33: snapshot-based public API surface diff. Pattern from
# agnosys/scripts/check-api-surface.sh; cyrius-native impl in
# programs/cyrius_api_surface.cyr ($_tools_dir/cyrius_api_surface).
# v5.9.14: source renamed from `api_surface.cyr` after the release
# tarball at 5.9.13 shipped without `cyrius_api_surface` — both
# `release.yml` and `install.sh --refresh-only` look up
# `programs/${bin}.cyr` keyed off cyrius.cyml [release].bins, and
# the old name silently failed the lookup. Local installs masked
# this because `build/cyrius_api_surface` was already present from
# manual builds; the CI runner has no such fallback.
# v5.9.12: `scope_project` flag forward (v5.9.11 agnosys filing
# §4 — exclude lib/ entries from the scan so downstream
# consumers don't pick up cyrius stdlib that churns across
# releases). Pre-v5.9.12 this dispatcher dropped the flag.
# v5.9.13: `snapshot_arg` (`--snapshot=PATH`) forward — same
# shape; pinned as follow-up at v5.9.12 ship.
fn cmd_api_surface(update_flag, scope_project, snapshot_arg): i64 {
    var tool = make_path(_tools_dir, "cyrius_api_surface");
    var u = 0;
    var s = 0;
    if (update_flag != 0)   { u = "--update"; }
    if (scope_project != 0) { s = "--scope=project"; }
    return run_tool(tool, u, s, snapshot_arg);
}

# v6.5.8: validate the target BEFORE delegating. `cyrius doc <missing-file>` printed
# NOTHING and exited 0 — the worst shape in the fail-open family, because empty output
# from a doc generator is indistinguishable from "this file has no documentation", so a
# mistyped path reads as a finding about the code. The file argument is whichever of
# arg1/arg2 is not a flag.
fn _cmd_target_ok(a1, a2, verb): i64 {
    var t = 0;
    if (a1 != 0) { if (load8(a1) != 45) { t = a1; } }
    if (t == 0) { if (a2 != 0) { if (load8(a2) != 45) { t = a2; } } }
    if (t == 0) { return 1; }                      # no positional: the tool's own usage applies
    if (file_exists(t) == 1) { return 1; }
    _err_ctx(verb, t);
    return 0;
}

fn cmd_doc(arg1, arg2): i64 {
    if (_cmd_target_ok(arg1, arg2, "doc: cannot read") == 0) { return 1; }
    var cyrdoc = make_path(_tools_dir, "cyrdoc");
    return run_tool(cyrdoc, arg1, arg2, 0);
}

# vet / deny are dependency-audit passes implemented by the `cyaudit`
# tool (programs/cyaudit.cyr) — NOT the compiler. These were mis-wired to
# `cybs` (the asm bootstrap compiler), which has no vet/deny mode: it
# ignored the argv, read stdin, and emitted a stray ELF to stdout. Route
# to cyaudit. See CHANGELOG [6.1.25].
fn cmd_vet(file): i64 {
    # v6.5.8: `cyrius vet <missing>` reported "no dependencies" and exited 0 — a clean
    # bill of health for a file that was never opened.
    if (_cmd_target_ok(file, 0, "vet: cannot read") == 0) { return 1; }
    var cyaudit = make_path(_tools_dir, "cyaudit");
    return run_tool(cyaudit, "vet", file, 0);
}

fn cmd_deny(file): i64 {
    if (_cmd_target_ok(file, 0, "deny: cannot read") == 0) { return 1; }
    var cyaudit = make_path(_tools_dir, "cyaudit");
    return run_tool(cyaudit, "deny", file, 0);
}

# Cross-OS self-host gate (v6.0.33; all-4-hosts v6.0.45). The x86_64-Linux
# self-host is covered by check.sh; this verifies cycc reproduces itself
# BYTE-IDENTICAL on EVERY target it claims to support, on REAL hardware —
# the gap that let the macOS/Windows/aarch64 ports rot behind green
# hello-world CI jobs. Four hosts, each FAIL-LOUD (an unreachable host, a
# compile failure, or a non-identical fixpoint is a FAILURE — "not
# available" is never an excuse, that placebo IS the rot):
#   ecb  macOS arm64 (Apple Silicon)   — self-hosts
#   ach  macOS x86_64 (Intel)          — self-hosts
#   pi   Linux aarch64 (real ARM)      — native self-host (NOT cross-compiler)
#   cass Windows x86_64 (PE32+)        — PE self-host
# Each per-host sequence lives in scripts/cross-os-selfhost.sh and runs via
# _co_run_sh (real environment so ssh/scp have HOME + agent). The ecb arm
# below + the ecb install-path arm stay inline (proven, packaging gate).
fn _cross_os_selfhost(): i64 {
    var fails = 0;
    println("");
    println("── Cross-OS self-host (REAL hardware — fail-loud, no skip) ──");

    # ecb (macOS, Apple Silicon)
    var ecb_seq = "set -e; cat src/main.cyr | build/cycc > /tmp/_co_l && chmod +x /tmp/_co_l; cat src/main_aarch64.cyr | /tmp/_co_l > /tmp/_co_x && chmod +x /tmp/_co_x; cat src/main_aarch64_macho.cyr | CYRIUS_MACHO_ARM=1 /tmp/_co_x > /tmp/_co_m; tar czf /tmp/_co.tgz src lib VERSION; ssh -o ConnectTimeout=15 -o BatchMode=yes ecb 'rm -rf ~/_cyaud && mkdir ~/_cyaud'; scp -q /tmp/_co.tgz /tmp/_co_m ecb:~/_cyaud/; ssh ecb 'cd ~/_cyaud && tar xzf _co.tgz && chmod +x _co_m && codesign -s - -f _co_m && cat src/main_aarch64_macho.cyr | CYRIUS_MACHO_ARM=1 ./_co_m > r1 && cp r1 r1r && chmod +x r1r && codesign -s - -f r1r && cat src/main_aarch64_macho.cyr | CYRIUS_MACHO_ARM=1 ./r1r > r2 && cmp r1 r2 && printf '\\''fn main() { return 42; }'\\'' > _ec.cyr && cat _ec.cyr | CYRIUS_MACHO_ARM=1 ./r1r > _ec && chmod +x _ec && codesign -s - -f _ec && (_rc=0; ./_ec || _rc=$?; [ $_rc -eq 42 ])'";
    # The trailing exit-code assertion (v6.0.37) guards the rot-class
    # where `main()` is never called and the program exits with argc:
    # a `var x = 42;`-only smoke would pass it. `fn main(){return 42;}`
    # must exit 42. See issue 2026-06-02-macho-main-return-exit-propagation.
    var ecb_rc = _co_run_sh(ecb_seq);
    if (ecb_rc == 0) {
        println("  PASS: ecb (macOS arm64) cycc self-host byte-identical + exit-code propagation");
    } else {
        println("  FAIL: ecb (macOS arm64) cross-OS self-host — unreachable or NOT byte-identical");
        fails = fails + 1;
    }

    # Install-path verification (v6.0.38). The self-host check above proves
    # the COMPILER works — but the rot that shipped EMPTY macOS installs for
    # 9 minors was in PACKAGING (the release tarball had no bin/), which a
    # self-host check by construction can't catch. This builds the real
    # macOS tarball via the same scripts/build-macos-arm64-tarball.sh the
    # release uses, runs the REAL install.sh on ecb, then `cyrius build`s
    # `fn main(){return 42}` and asserts exit 42 — catching a missing
    # compiler, a broken installer, an unsigned toolchain, OR a build output
    # that isn't ad-hoc-signed/runnable. This is the gate that would have
    # caught "installed on a Mac and got no cyrius".
    var ecb_install = "set -e; sh scripts/build-macos-arm64-tarball.sh /tmp/_co_dist >/dev/null 2>&1; V=$(tr -d '[:space:]' < VERSION); printf 'fn main() { return 42; }' > /tmp/_co_t.cyr; ssh -o ConnectTimeout=15 -o BatchMode=yes ecb 'rm -rf ~/_coih ~/_co_t.out'; scp -q scripts/install.sh /tmp/_co_t.cyr /tmp/_co_dist/cyrius-$V-aarch64-macos.tar.gz ecb:~/; ssh ecb 'CYRIUS_VERSION='$V' CYRIUS_HOME=$HOME/_coih CYRIUS_INSTALL_TARBALL=$HOME/cyrius-'$V'-aarch64-macos.tar.gz sh $HOME/install.sh >/dev/null 2>&1 && CYRIUS_HOME=$HOME/_coih $HOME/_coih/bin/cyrius build $HOME/_co_t.cyr $HOME/_co_t.out >/dev/null 2>&1 && (r=0; $HOME/_co_t.out || r=$?; [ $r -eq 42 ])'";
    var ecb_inst_rc = _co_run_sh(ecb_install);
    if (ecb_inst_rc == 0) {
        println("  PASS: ecb (macOS arm64) REAL install -> cyrius build -> exit 42");
    } else {
        println("  FAIL: ecb (macOS arm64) real-install path — tarball missing the toolchain, installer broken, or build output not runnable");
        fails = fails + 1;
    }

    # ach (macOS x86_64, Intel) — added v6.0.45. The x86 Mach-O cycc
    # self-hosts byte-identical; the v6.0.44 "x86-macOS doesn't self-host"
    # retraction was a codesign-comparison artifact (codesign mutates the
    # binary with LC_CODE_SIGNATURE). The gate runs UNSIGNED — see
    # scripts/cross-os-selfhost.sh.
    # v6.4.59: pass the cross-host selector so ach also runs the platform libtest
    # (the fs/thread/sync/alloc/args/process/syscalls tcyr on native x86-macho),
    # matching ecb/cass/pi — the x86-macho stdlib is now gated on real Intel, not
    # just the bare compiler self-host. The ach recipe also carries the exit-42
    # rot-guard (scripts/cross-os-selfhost.sh).
    # v6.5.11: the selector is the SUBDIR tests/tcyr/crossos, not the "vr01_" prefix.
    var ach_rc = _co_run_sh("sh scripts/cross-os-selfhost.sh ach crossos");
    if (ach_rc == 0) {
        println("  PASS: ach (macOS x86_64) cycc self-host byte-identical + crossos libtest");
    } elif (ach_rc == 3) {
        println("  FAIL: ach (macOS x86_64) UNREACHABLE — host down/unresolvable, cannot verify (publish blocked)");
        fails = fails + 1;
    } else {
        println("  FAIL: ach (macOS x86_64) self-host / VR-01 libtest FAILED");
        fails = fails + 1;
    }

    # ach install pillar (v6.4.59) — the Intel-Mac analog of the ecb install gate.
    # Self-host proves the COMPILER; this proves the USABLE TOOLCHAIN + PACKAGING:
    # the real install.sh yields a `cyrius` wrapper that resolves argv/env/arch via
    # the r15 park (v6.4.59) and `cyrius build`s fn main(){return 42} to a runnable
    # Mach-O exiting 42. Catches a tarball missing cycc/wrapper (the found-by-ports
    # hole this arc closed), a broken installer, or a wrapper that can't find cycc.
    var ach_install = "set -e; sh scripts/build-macos-x86-tarball.sh /tmp/_co_dist_x86 >/dev/null 2>&1; V=$(tr -d '[:space:]' < VERSION); printf 'fn main() { return 42; }' > /tmp/_co_tx.cyr; ssh -o ConnectTimeout=15 -o BatchMode=yes ach 'rm -rf ~/_coih_x86 ~/_co_tx.out'; scp -q scripts/install.sh /tmp/_co_tx.cyr /tmp/_co_dist_x86/cyrius-$V-x86_64-macos.tar.gz ach:~/; ssh ach 'CYRIUS_VERSION='$V' CYRIUS_HOME=$HOME/_coih_x86 CYRIUS_INSTALL_TARBALL=$HOME/cyrius-'$V'-x86_64-macos.tar.gz sh $HOME/install.sh >/dev/null 2>&1 && CYRIUS_HOME=$HOME/_coih_x86 $HOME/_coih_x86/bin/cyrius build $HOME/_co_tx.cyr $HOME/_co_tx.out >/dev/null 2>&1 && (r=0; $HOME/_co_tx.out || r=$?; [ $r -eq 42 ])'";
    var ach_inst_rc = _co_run_sh(ach_install);
    if (ach_inst_rc == 0) {
        println("  PASS: ach (macOS x86_64/Intel) REAL install -> cyrius build -> exit 42");
    } else {
        println("  FAIL: ach (macOS x86_64/Intel) real-install path — tarball missing the toolchain, installer broken, or wrapper can't find cycc");
        fails = fails + 1;
    }

    # pi (Linux aarch64, REAL ARM hardware) — added v6.0.45. NATIVE self-host,
    # not the cross-compiler. release.yml's "subtle QEMU codegen difference"
    # excuse hid a real bug on real silicon (the native aarch64 cycc drops the
    # _TARGET_MACHO global during its own compile). Gated for real now.
    var pi_rc = _co_run_sh("sh scripts/cross-os-selfhost.sh pi");
    if (pi_rc == 0) {
        println("  PASS: pi (Linux aarch64) native cycc self-host byte-identical");
    } elif (pi_rc == 3) {
        println("  FAIL: pi (Linux aarch64) UNREACHABLE — host down/unresolvable, cannot verify (publish blocked)");
        fails = fails + 1;
    } else {
        println("  FAIL: pi (Linux aarch64) native self-host NOT byte-identical");
        fails = fails + 1;
    }

    # cass (Windows x86_64, PE32+) — added v6.0.45, replacing the v6.0.34
    # TODO no-op print (a silent skip is exactly the rot vector). Self-host
    # via cmd.exe (the default ssh shell is PowerShell, which lacks `<`).
    var cass_rc = _co_run_sh("sh scripts/cross-os-selfhost.sh cass");
    if (cass_rc == 0) {
        println("  PASS: cass (Windows x86_64) cycc self-host byte-identical");
    } elif (cass_rc == 3) {
        println("  FAIL: cass (Windows x86_64) UNREACHABLE — host down/unresolvable, cannot verify (publish blocked)");
        fails = fails + 1;
    } else {
        println("  FAIL: cass (Windows x86_64) PE self-host NOT byte-identical");
        fails = fails + 1;
    }

    # cass install pillar (v6.0.85) — the Windows analog of the ecb install gate
    # above. Self-host proves the COMPILER; this proves PACKAGING: the real
    # install.ps1 yields a cyrius that `cyrius build`s fn main(){return 42} to a
    # runnable PE exiting 42. Catches a tarball missing cyrius.exe, a broken
    # installer, or a non-runnable build — the macOS-rot class, one platform over.
    var cass_inst_rc = _co_run_sh("sh scripts/cass-install-gate.sh");
    if (cass_inst_rc == 0) {
        println("  PASS: cass (Windows x86_64) REAL install -> cyrius build -> exit 42");
    } elif (cass_inst_rc == 3) {
        println("  FAIL: cass (Windows x86_64) install gate UNREACHABLE — cannot verify (publish blocked)");
        fails = fails + 1;
    } else {
        println("  FAIL: cass (Windows x86_64) real-install path — tarball missing cyrius.exe, installer broken, or build output not runnable");
        fails = fails + 1;
    }

    if (fails > 0) { return 1; }
    return 0;
}

# v6.2.12: split. `cyrius audit` (default) runs the LOCAL item suite — check.sh's
# fmt/lint walk + format + the full .tcyr suite + every gate ("all items like
# fmt/lint/doc/…"). The cross-OS REAL-hardware self-host (ecb/ach/pi/cass +
# install gates) is the heavier maintainer/release verification — it needs the
# wired SSH verification hosts — so it now lives behind
# `cyrius audit --internal=platform-check`, which is the full gate this command
# used to be (local suite + platform self-host). See issue/CHANGELOG [6.2.12].
# v6.2.25: the PROJECT quality sweep — `cyrius audit` (default). Composes the
# CLI's own tools (cyrfmt/cyrlint/cyrdoc via the audit_walk walkers + cmd_tests +
# cmd_bench) over the current project, so it works in ANY cyrius project without
# scripts/check.sh. Returns non-zero if fmt/lint/docs/tests fail (bench is a
# non-fatal perf measurement). This is what `cyrius audit` was always meant to be;
# the cyrius-internal full gate is `audit --internal` → check.sh.
fn _audit_sweep(): i64 {
    var rc = 0;
    # Source dirs to fmt/lint/doc-walk — dirs the PROJECT AUTHORS, which is not the
    # same as dirs that exist on disk.
    #
    # v6.4.78 — `lib/` is now walked ONLY in the cyrius source repo. The old comment
    # here said "whichever exist in this project" and pushed `lib` unconditionally,
    # conflating *exists* with *belongs to*. In THIS repo lib/ is the authored stdlib
    # (106 tracked files); in every CONSUMER it is dependency code that `cyrius deps`
    # vendors from the manifest and that .gitignore excludes precisely because it is
    # reproducible rather than authored (stiva and sandhi each have 0 tracked files
    # under lib/). So the sweep fmt-checked other people's bundles and blamed the
    # consumer: stiva got a permanent `FAIL: files need reformatting` with all 41 of
    # its own tracked files already clean, and the printed remedy was actively
    # harmful — `cyrius fmt -w` would rewrite vendored files that the next
    # `cyrius deps` overwrites, and in stiva's case break `deps --verify` lockfile
    # hashes. This is the shape that hides best: correct in the cyrius repo, wrong in
    # every project that consumes it.
    #
    # `_dep_is_cyrius_source_repo()` is the sanctioned predicate (cbt/deps.cyr) — it
    # reads `[package] name` from cyrius.cyml, and is already what `_check_lib_freshness`
    # and (v6.4.77) `cmd_lib_sync` use for exactly this authored-vs-vendored question.
    # Do NOT substitute `file_exists("src/main.cyr")` (the v6.0.1 conflation bug) and do
    # NOT test for a `[deps]` section — cyrius.cyml HAS one, so that would wrongly drop
    # lib/ here. Verified: predicate == 1 in this repo, 0 in stiva, 0 in /tmp.
    # (issues/2026-07-24-audit-sweep-fmt-lint-walks-vendored-lib.md)
    var _in_cyrius_repo = _dep_is_cyrius_source_repo();
    var dirs = vec_new();
    if (_in_cyrius_repo == 1) {
        if (is_dir(str_from("lib")) == 1) { vec_push(dirs, str_from("lib")); }
    }
    if (is_dir(str_from("src")) == 1) { vec_push(dirs, str_from("src")); }
    if (is_dir(str_from("programs")) == 1) { vec_push(dirs, str_from("programs")); }
    if (vec_len(dirs) == 0) { vec_push(dirs, str_from(".")); }
    # Say what was walked. A stage that reports a verdict without its scope reads as
    # authoritative when it is not — the same defect as the release gate's silent
    # `vr01_` subset (issues/2026-07-14-release-gate-cross-os-runs-only-vr01-glob.md).
    sys_write(STDOUT_FD, "  scope:", 8);
    var _sd = 0;
    while (_sd < vec_len(dirs)) {
        sys_write(STDOUT_FD, " ", 1);
        var _sdn = vec_get(dirs, _sd);
        sys_write(STDOUT_FD, str_data(_sdn), str_len(_sdn));
        _sd = _sd + 1;
    }
    if (_in_cyrius_repo == 0) {
        if (is_dir(str_from("lib")) == 1) {
            sys_write(STDOUT_FD, "  (lib/ excluded — vendored deps, not project source)", 55);
        }
    }
    println("");

    var cyrfmt = make_path(_tools_dir, "cyrfmt");
    var cyrlint = make_path(_tools_dir, "cyrlint");
    var cyrdoc = make_path(_tools_dir, "cyrdoc");

    _status("── fmt ──");
    if (file_exists(cyrfmt) == 1) {
        audit_fmt_walk(cyrfmt, dirs);
        if (AW_FMT_FAIL > 0) {
            println("  FAIL: files need reformatting (cyrius fmt -w)");
            # v6.4.78 — NAME them. `audit_fmt_walk` has populated AW_FMT_FAIL_FILES
            # since it was written, and NO caller ever printed it: the list was
            # collected and thrown away, so the verdict was indistinguishable from a
            # real failure and could not be triaged without re-deriving the walk by
            # hand. That is precisely why this sat unexamined long enough for a
            # consumer to file it. Capped so a large project cannot bury the rest of
            # the sweep.
            if (AW_FMT_FAIL_FILES != 0) {
                var _ff = 0;
                var _fn_tot = vec_len(AW_FMT_FAIL_FILES);
                while (_ff < _fn_tot) {
                    if (_ff >= 20) {
                        sys_write(STDOUT_FD, "    … and ", 12);
                        print_num(_fn_tot - 20);
                        println(" more");
                        _ff = _fn_tot;
                    } else {
                        var _fnm = vec_get(AW_FMT_FAIL_FILES, _ff);
                        sys_write(STDOUT_FD, "    ", 4);
                        sys_write(STDOUT_FD, str_data(_fnm), str_len(_fnm));
                        println("");
                        _ff = _ff + 1;
                    }
                }
            }
            rc = 1;
        }
        else { println("  ok: format clean"); }
    } else { println("  skip: cyrfmt not built"); }

    _status("── lint ──");
    if (file_exists(cyrlint) == 1) {
        audit_lint_walk(cyrlint, dirs);
        if (AW_LINT_TOTAL > 0) { sys_write(STDOUT_FD, "  ", 2); print_num(AW_LINT_TOTAL); println(" lint warnings"); rc = 1; }
        else { println("  ok: lint clean"); }
    } else { println("  skip: cyrlint not built"); }

    _status("── docs ──");
    if (file_exists(cyrdoc) == 1) {
        audit_doc_walk(cyrdoc, dirs);
        if (AW_DOC_TOTAL > 0) { sys_write(STDOUT_FD, "  ", 2); print_num(AW_DOC_TOTAL); println(" undocumented public fns"); rc = 1; }
        else { println("  ok: docs complete"); }
    } else { println("  skip: cyrdoc not built"); }

    _status("── tests ──");
    var tdir = "tests/tcyr";
    if (is_dir(str_from(tdir)) == 0) { tdir = "tests"; }
    if (is_dir(str_from(tdir)) == 1) {
        if (cmd_tests(tdir) != 0) { rc = 1; }
    } else { println("  skip: no tests/ directory"); }

    _status("── bench ──");
    cmd_bench(0);   # perf measurement — non-fatal

    return rc;
}

# `cyrius audit` dispatcher. mode: 0 = project sweep (default), 1 = the
# cyrius-internal scripts/check.sh, 2 = check.sh + cross-OS platform self-host.
fn cmd_audit(mode): i64 {
    if (mode == 0) { return _audit_sweep(); }
    var script = make_path(_scripts_dir, "check.sh");
    var check_rc = run_script(script, 0, 0);
    if (mode == 1) { return check_rc; }
    var cross_rc = _cross_os_selfhost();
    if (check_rc != 0) { return check_rc; }
    return cross_rc;
}


# ================================================================
# Capacity — compiler table utilization report
# ================================================================
# Compiles source under CYRIUS_STATS=1, parses stats from stderr.
# --check: exit 1 if any table >= 85%. --json: machine-readable output.

fn cmd_capacity(source, check_mode, json_mode): i64 {
    var cc = current_cc();
    if (cc == 0) { _err("cycc not found"); return 1; }
    if (source == 0) {
        _err("no file given");
        sys_write(STDERR_FD, "usage: cyrius capacity [--check] [--json] [file.cyr]\n", 53);
        return 1;
    }
    if (file_exists(source) == 0) { _err_ctx("file not found", source); return 1; }
    # v6.5.7: capacity does NOT route through compile() — it calls
    # _materialize_source and forks cycc itself — so it does not inherit that
    # function's guard and needs its own. file_exists returns 1 for a directory
    # (open-then-close), so `cyrius capacity benches` printed a full, plausible
    # stats block (var_table / fixup_table / code_size, all measuring the
    # auto-prepended stdlib) and exited 0 — a green placebo of exactly the kind
    # the v6.4.73 note below exists to prevent.
    if (is_dir(str_from(source)) == 1) { _err_ctx("not a file", source); return 1; }

    # Compile with CYRIUS_STATS=1, capture stderr.
    # v6.4.73: feed the compiler the MATERIALIZED source (manifest dep includes +
    # defines prepended), not the raw file. Pre-.73 this forked cycc on `source`
    # directly, so on any real project every stdlib fn was undefined, the compile
    # aborted BEFORE the stats block, and the --check path below then found zero
    # stats lines and printed "ok (all caps under 85%)". See the placebo guard at
    # the bottom of this fn. CHANGELOG [6.4.73].
    var cap_source = _materialize_source(source);
    var tmpout = _cbt_tmpfile("cap_out");
    var tmperr = _cbt_tmpfile("cap_err");
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open(cap_source, O_RDONLY, 0);
        if (sfd < 0) { sys_exit(1); }
        sys_dup2(sfd, 0);
        sys_close(sfd);
        var ofd = sys_open("/dev/null", O_WRONLY, 0);
        sys_dup2(ofd, 1);
        sys_close(ofd);
        var efd = sys_open(tmperr, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
        sys_dup2(efd, 2);
        sys_close(efd);
        # Set CYRIUS_STATS=1 in environment — simpler: use env command
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv, cc);
        store64(&argv + 8, 0);
        # Modify environ to add CYRIUS_STATS=1
        # Simplest: exec via env
        var sh_argv[40];   # N BYTES per CLAUDE.md buffer contract: 4 ptrs need 32 B
        store64(&sh_argv, "/bin/sh");
        store64(&sh_argv + 8, "-c");
        # Build command string
        var cmd_sb = str_builder_new();
        str_builder_add_cstr(cmd_sb, "CYRIUS_STATS=1 ");
        str_builder_add_cstr(cmd_sb, cc);
        var cmd_str = str_data(str_builder_build(cmd_sb));
        store64(&sh_argv + 16, cmd_str);
        store64(&sh_argv + 24, 0);
        sys_execve("/bin/sh", &sh_argv, _envp);
        sys_exit(127);
    }
    var status_buf[8];
    sys_waitpid(pid, &status_buf, 0);
    # v6.5.19: the second _materialize_source caller, same leak as compile()'s —
    # the preprocessed temp was never removed. Same "we made it" test (the fn returns
    # `source` itself when no prepend was needed).
    if (cap_source != source) { sys_unlink(cap_source); }
    var cap_status = load32(&status_buf);
    var cap_failed = 1;
    if (WIFEXITED(cap_status) == 1) { if (WEXITSTATUS(cap_status) == 0) { cap_failed = 0; } }

    # Read stderr output.
    # v6.4.73: 1 MiB, was 8 KiB. The stats block is printed at the END of the
    # compile, so on any project whose warnings exceed the buffer the stats lines
    # were the FIRST thing truncated away — stiva 3.0.6 emits ~20 KB of
    # duplicate-fn warnings before them. An 8 KiB read there captured warnings
    # only, and the caller read that as "no tables near their cap".
    var errbuf = alloc(1048576);
    var errlen = file_read_all(tmperr, errbuf, 1048575);
    sys_unlink(tmperr);
    if (errlen <= 0) { _err("no stats output from compiler"); return 1; }
    store8(errbuf + errlen, 0);
    # The compile itself must have SUCCEEDED before any utilization number means
    # anything. A failed compile produces no stats lines, and every consumer below
    # treats "no lines" as "nothing over the threshold" — which is how `cyrius
    # capacity --check` reported `ok (all caps under 85%)` for a project sitting at
    # fn_table 90% / identifiers 92%. Fail loud instead.
    if (cap_failed == 1) {
        sys_write(STDERR_FD, errbuf, errlen);
        _err_ctx("compile failed — no capacity numbers to report", source);
        return 1;
    }

    if (json_mode == 1) {
        # Parse "  name:    used / cap" lines into JSON
        println("{");
        var first = 1;
        var pos = 0;
        while (pos < errlen) {
            # Skip to "  " at line start
            if (pos + 4 < errlen && load8(errbuf + pos) == 32 && load8(errbuf + pos + 1) == 32) {
                var ns = pos + 2;
                var ne = ns;
                while (ne < errlen && load8(errbuf + ne) != 58) { ne = ne + 1; }
                if (ne < errlen) {
                    var name_len = ne - ns;
                    # Skip to first digit
                    var di = ne + 1;
                    while (di < errlen && (load8(errbuf + di) < 48 || load8(errbuf + di) > 57)) { di = di + 1; }
                    # Parse used
                    var used = 0;
                    while (di < errlen && load8(errbuf + di) >= 48 && load8(errbuf + di) <= 57) {
                        used = used * 10 + load8(errbuf + di) - 48;
                        di = di + 1;
                    }
                    # Skip to next digit (cap)
                    while (di < errlen && (load8(errbuf + di) < 48 || load8(errbuf + di) > 57)) { di = di + 1; }
                    var cap = 0;
                    while (di < errlen && load8(errbuf + di) >= 48 && load8(errbuf + di) <= 57) {
                        cap = cap * 10 + load8(errbuf + di) - 48;
                        di = di + 1;
                    }
                    if (cap > 0) {
                        var pct = used * 100 / cap;
                        if (first == 0) { println(","); }
                        sys_write(STDOUT_FD, "  \"", 3);
                        sys_write(STDOUT_FD, errbuf + ns, name_len);
                        sys_write(STDOUT_FD, "\": {\"used\": ", 12);
                        fmt_int(used);
                        sys_write(STDOUT_FD, ", \"cap\": ", 9);
                        fmt_int(cap);
                        sys_write(STDOUT_FD, ", \"pct\": ", 9);
                        fmt_int(pct);
                        sys_write(STDOUT_FD, "}", 1);
                        first = 0;
                    }
                }
            }
            # Skip to next line
            while (pos < errlen && load8(errbuf + pos) != 10) { pos = pos + 1; }
            pos = pos + 1;
        }
        println("");
        println("}");
    } elif (check_mode == 1) {
        # Print stats to stderr
        sys_write(STDERR_FD, errbuf, errlen);
        # Parse "  name:    used / cap" lines, check if any >= 85%
        var hits = 0;
        var seen = 0;   # v6.4.73: stats lines actually parsed (0 = no certification possible)
        var pos = 0;
        while (pos < errlen) {
            # Look for lines with " / " (stats format)
            if (pos + 4 < errlen && load8(errbuf + pos) == 32 && load8(errbuf + pos + 1) == 32) {
                # Find the / separator
                var sl = pos;
                var has_slash = 0;
                var slash_pos = 0;
                while (sl < errlen && load8(errbuf + sl) != 10) {
                    if (load8(errbuf + sl) == 47) {
                        if (sl > 0 && load8(errbuf + sl - 1) == 32 && sl + 1 < errlen && load8(errbuf + sl + 1) == 32) {
                            has_slash = 1;
                            slash_pos = sl;
                        }
                    }
                    sl = sl + 1;
                }
                if (has_slash == 1) {
                    # Parse used (digits before " / ")
                    var ui = slash_pos - 2;
                    while (ui > pos && load8(errbuf + ui) >= 48 && load8(errbuf + ui) <= 57) { ui = ui - 1; }
                    ui = ui + 1;
                    var used = 0;
                    while (ui < slash_pos && load8(errbuf + ui) >= 48 && load8(errbuf + ui) <= 57) {
                        used = used * 10 + load8(errbuf + ui) - 48;
                        ui = ui + 1;
                    }
                    # Parse cap (digits after " / ")
                    var ci2 = slash_pos + 2;
                    var cap = 0;
                    while (ci2 < errlen && load8(errbuf + ci2) >= 48 && load8(errbuf + ci2) <= 57) {
                        cap = cap * 10 + load8(errbuf + ci2) - 48;
                        ci2 = ci2 + 1;
                    }
                    if (cap > 0) {
                        var pct = used * 100 / cap;
                        seen = seen + 1;
                        if (pct >= 85) { hits = hits + 1; }
                    }
                }
            }
            while (pos < errlen && load8(errbuf + pos) != 10) { pos = pos + 1; }
            pos = pos + 1;
        }
        # v6.4.73 placebo guard: parsing ZERO stats lines is not a pass. It means
        # the stats block never arrived (compile aborted, buffer truncated, or the
        # emitter's format drifted from this parser) — none of which is evidence
        # that the tables are under 85%. Reporting "ok" here is precisely the
        # vacuous green CLAUDE.md warns about, so treat it as a hard failure.
        if (seen == 0) {
            sys_write(STDERR_FD, errbuf, errlen);
            _err("no capacity lines parsed from compiler output — cannot certify caps");
            return 1;
        }
        if (hits > 0) {
            sys_write(STDERR_FD, "cyrius capacity --check: ", 25);
            fmt_int_fd(STDERR_FD, hits);
            sys_write(STDERR_FD, " table(s) at >=85% -- failing\n", 30);
            return 1;
        }
        println("cyrius capacity --check: ok (all caps under 85%)");
    } else {
        # Default: just print stats
        sys_write(STDERR_FD, errbuf, errlen);
    }
    return 0;
}

# ================================================================
# Soak — extended test loop
# ================================================================

fn cmd_soak(iters): i64 {
    if (iters <= 0) { iters = 100; }
    _status("=== cyrius soak test ===");
    sys_write(STDOUT_FD, "  iterations: ", 14);
    fmt_int(iters);
    sys_write(STDOUT_FD, "\n", 1);

    # v5.7.38: built-in self-host loop must NOT auto-prepend manifest
    # deps (sigil/sakshi/patra/yukti/mabda/sankoch in cyrius's own
    # manifest). The 6 dep bundles + src/main.cyr's 7,400 LOC blow
    # past the compiler's 2 MB expanded-source cap. _skip_deps is the
    # v5.7.8 mechanism for suppressing the auto-prepend; save/restore
    # so the .scyr walker below still gets auto-prepend (consumer
    # parity with cmd_test/cmd_bench/cmd_fuzz).
    var saved_skip_deps = _skip_deps;
    _skip_deps = 1;

    var soak_pass = 0;
    var soak_fail = 0;
    var si = 0;
    while (si < iters) {
        si = si + 1;
        sys_write(STDOUT_FD, "[", 1);
        fmt_int(si);
        sys_write(STDOUT_FD, "/", 1);
        fmt_int(iters);
        sys_write(STDOUT_FD, "] ", 2);

        var iter_ok = 1;

        # 1. Self-hosting check
        var cc5_t = _cbt_tmpfile("soak_a");
        var cc4_t = _cbt_tmpfile("soak_b");
        if (compile("src/main.cyr", cc5_t) != 0) { iter_ok = 0; }
        if (iter_ok == 1) {
            # Run cc5_t to compile itself
            var pid2 = sys_fork();
            if (pid2 == 0) {
                var sfd = sys_open("src/main.cyr", O_RDONLY, 0);
                sys_dup2(sfd, 0); sys_close(sfd);
                var ofd = sys_open(cc4_t, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
                sys_dup2(ofd, 1); sys_close(ofd);
                var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
                store64(&argv, cc5_t);
                store64(&argv + 8, 0);
                sys_execve(cc5_t, &argv, _envp);
                sys_exit(127);
            }
            var sb2[1];
            sys_waitpid(pid2, &sb2, 0);

            # Compare
            var sz1 = _file_size(cc5_t);
            var sz2 = _file_size(cc4_t);
            if (sz1 != sz2) {
                sys_write(STDOUT_FD, "FAIL: self-host size mismatch\n", 30);
                iter_ok = 0;
            }
        }
        sys_unlink(cc5_t);
        sys_unlink(cc4_t);

        # 2. Test suite
        # v6.5.11: RECURSIVE. Was a flat dir_list over tests/tcyr, so a subfoldered
        # test was invisible to EVERY soak iteration while the run still reported
        # success — soak was never brought along by the v6.5.7 bench/fuzz pass.
        # find_files returns full paths (path_join → str_builder_build, NUL-terminated).
        if (iter_ok == 1) {
            var tent = find_files(str_from("tests/tcyr"), str_from(".tcyr"));
            var ti = 0;
            while (ti < vec_len(tent)) {
                var tpath = vec_get(tent, ti);
                var tn = str_data(tpath);
                var tl = str_len(tpath);
                var tmpbin = _cbt_tmpfile("soak_t");
                if (compile(tn, tmpbin) == 0) {
                    var ec = run_binary_timed(tmpbin, _run_timeout_ms());
                    sys_unlink(tmpbin);
                    if (ec != 0) {
                        sys_write(STDOUT_FD, "FAIL: ", 6);
                        sys_write(STDOUT_FD, tn, tl);
                        sys_write(STDOUT_FD, "\n", 1);
                        iter_ok = 0;
                        break;
                    }
                } else {
                    sys_unlink(tmpbin);
                    iter_ok = 0;
                    break;
                }
                ti = ti + 1;
            }
        }

        if (iter_ok == 1) {
            soak_pass = soak_pass + 1;
            println("ok");
        } else {
            soak_fail = soak_fail + 1;
        }
    }
    println("");
    sys_write(STDOUT_FD, "=== soak complete: ", 19);
    fmt_int(soak_pass);
    sys_write(STDOUT_FD, "/", 1);
    fmt_int(iters);
    sys_write(STDOUT_FD, " passed, ", 9);
    fmt_int(soak_fail);
    println(" failed ===");

    # Restore auto-prepend before the .scyr walker — harness code
    # benefits from manifest dep auto-prepend the same as .tcyr/.bcyr/
    # .fcyr (per the v5.7.21 fuzz parity slot).
    _skip_deps = saved_skip_deps;

    # v5.7.38: discover and run user-authored *.scyr soak harnesses in
    # `tests/scyr/` + `soak/`. Mirrors the *.tcyr / *.bcyr / *.fcyr
    # discovery shape. Each .scyr is a complete cyrius program that
    # manages its own iteration count internally; the runner just
    # compiles + runs each once. Skip silently when neither dir exists
    # or both are empty.
    var scyr_pass = 0;
    var scyr_fail = 0;
    var scyr_found = 0;
    var sd = 0;
    var sdirs = vec_new();
    vec_push(sdirs, "tests/scyr");
    vec_push(sdirs, "soak");
    while (sd < vec_len(sdirs)) {
        var sdir = vec_get(sdirs, sd);
        if (file_exists(sdir) == 1) {
            # v6.5.11: RECURSIVE. Was a depth-1 dir_list, so tests/scyr/<sub>/x.scyr
            # never ran and cmd_soak still reported success — the same defect the
            # v6.5.7 pass fixed for bench/fuzz without bringing scyr/smcyr along.
            var sentries = find_files(str_from(sdir), str_from(".scyr"));
            var sei = 0;
            while (sei < vec_len(sentries)) {
                var spath_s = vec_get(sentries, sei);
                var snd = str_data(spath_s);
                var snl = str_len(spath_s);
                if (scyr_found == 0) {
                    println("");
                    println("=== cyrius soak harnesses ===");
                }
                scyr_found = 1;
                var stmpbin = _cbt_tmpfile("scyr");
                sys_write(STDOUT_FD, "  ", 2);
                sys_write(STDOUT_FD, snd, snl);
                var spad = 44 - snl;
                while (spad > 0) { sys_write(STDOUT_FD, " ", 1); spad = spad - 1; }
                if (compile(snd, stmpbin) == 0) {
                    var sec = run_binary_timed(stmpbin, _run_timeout_ms());
                    sys_unlink(stmpbin);
                    if (sec == 0) {
                        println("PASS");
                        scyr_pass = scyr_pass + 1;
                    } else {
                        println("FAIL");
                        scyr_fail = scyr_fail + 1;
                    }
                } else {
                    println("COMPILE FAIL");
                    scyr_fail = scyr_fail + 1;
                    sys_unlink(stmpbin);
                }
                sei = sei + 1;
            }
        }
        sd = sd + 1;
    }
    if (scyr_found == 1) {
        sys_write(STDOUT_FD, "=== ", 4);
        fmt_int(scyr_pass);
        sys_write(STDOUT_FD, " passed, ", 9);
        fmt_int(scyr_fail);
        println(" failed ===");
    }

    if (soak_fail > 0 || scyr_fail > 0) { return 1; }
    return 0;
}

# v5.7.38: cyrius smoke — discover + run *.smcyr smoke harnesses in
# `tests/smcyr/` + `smoke/`. A smoke test answers "did this start at
# all?" — small, fast, exits non-zero on first sign of trouble. Same
# walker shape as cmd_fuzz; auto-prepend wired in cbt/cyrius.cyr's
# _auto_deps gate so harnesses can `include "lib/string.cyr"` etc.
# without manifest churn.
fn cmd_smoke(): i64 {
    _status("=== cyrius smoke ===");
    var smoke_pass = 0;
    var smoke_fail = 0;
    var found = 0;
    var sd = 0;
    var sdirs = vec_new();
    vec_push(sdirs, "tests/smcyr");
    vec_push(sdirs, "smoke");
    while (sd < vec_len(sdirs)) {
        var sdir = vec_get(sdirs, sd);
        if (file_exists(sdir) == 1) {
            # v6.5.11: RECURSIVE — see the matching note in cmd_soak. The printed
            # path is now dir-relative rather than a bare basename; the smoke gate
            # (programs/checks/services.cyr) matches on a SUBSTRING, so the
            # basename it looks for is still present.
            var entries = find_files(str_from(sdir), str_from(".smcyr"));
            var ei = 0;
            while (ei < vec_len(entries)) {
                var name = vec_get(entries, ei);
                var nd = str_data(name);
                var nl = str_len(name);
                found = 1;
                var tmpbin = _cbt_tmpfile("smoke");
                sys_write(STDOUT_FD, "  ", 2);
                sys_write(STDOUT_FD, nd, nl);
                var pad = 44 - nl;
                while (pad > 0) { sys_write(STDOUT_FD, " ", 1); pad = pad - 1; }
                if (compile(nd, tmpbin) == 0) {
                    var ec = run_binary_timed(tmpbin, _run_timeout_ms());
                    sys_unlink(tmpbin);
                    if (ec == 0) {
                        println("PASS");
                        smoke_pass = smoke_pass + 1;
                    } else {
                        println("FAIL");
                        smoke_fail = smoke_fail + 1;
                        # Smoke tests exit non-zero on first sign
                        # of trouble. Bail out — don't run the
                        # remainder; the canonical pattern is
                        # "fail fast, surface the first issue."
                        sys_write(STDOUT_FD, "\n=== smoke aborted: ", 20);
                        fmt_int(smoke_pass);
                        sys_write(STDOUT_FD, " passed before fail ===\n", 24);
                        return 1;
                    }
                } else {
                    println("COMPILE FAIL");
                    smoke_fail = smoke_fail + 1;
                    sys_unlink(tmpbin);
                    return 1;
                }
                ei = ei + 1;
            }
        }
        sd = sd + 1;
    }
    if (found == 0) {
        println("  No smoke harnesses found in tests/smcyr/ or smoke/");
        println("  Create *.smcyr files to define quick-validation programs.");
        return 0;
    }
    sys_write(STDOUT_FD, "\n=== ", 5);
    fmt_int(smoke_pass);
    sys_write(STDOUT_FD, " passed, ", 9);
    fmt_int(smoke_fail);
    println(" failed ===");
    if (smoke_fail > 0) { return 1; }
    return 0;
}

# ================================================================
# distlib — bundle src/ modules into dist/{name}.cyr
# ================================================================
# With no profile: reads [build] modules or [lib] modules, writes
# dist/{name}.cyr.
# With profile=X: reads [lib.X] modules, writes dist/{name}-X.cyr.
# Lets downstream libs (e.g. yukti) ship a kernel-safe core bundle
# alongside the full userland bundle without duplicating the build
# tool.
# Profile names are restricted to [a-zA-Z0-9_-]+, max 32 chars
# (output path safety — no "/", no "..", no shell metachars).

# Validate a profile name. Returns 1 if safe, 0 if not.
fn _distlib_valid_profile(p): i64 {
    if (p == 0) { return 1; }
    var len = strlen(p);
    if (len == 0) { return 0; }
    if (len > 32) { return 0; }
    var i = 0;
    while (i < len) {
        var c = load8(p + i);
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }     # 0-9
        if (c >= 65 && c <= 90) { ok = 1; }     # A-Z
        if (c >= 97 && c <= 122) { ok = 1; }    # a-z
        if (c == 45) { ok = 1; }                # '-'
        if (c == 95) { ok = 1; }                # '_'
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# v6.2.47 (deps lever 1, Phase A producer side): parse a stripped
# `include "lib/<leaf>.cyr"` directive → `<leaf>`, dedup, append to
# `leaves`. Only `lib/` stdlib includes are captured (the fold's
# requirements); `src/` self-refs are internal to the fold and skipped.
# `line` points at `fbuf+ls`; `ll` is the line length (NOT NUL-terminated).
fn _distlib_capture_lib_leaf(leaves, line, ll): i64 {
    if (ll < 14) { return 0; }                  # `include "lib/X` minimum
    if (load8(line + 8) != 34) { return 0; }    # expect opening quote at [8]
    if (memeq(line + 9, "lib/", 4) != 1) { return 0; }
    var ns = 13;                                # past `include "lib/`
    var ne = ns;
    while (ne < ll && load8(line + ne) != 34) { ne = ne + 1; }
    var nl = ne - ns;
    if (nl > 4 && memeq(line + ne - 4, ".cyr", 4) == 1) { nl = nl - 4; }
    if (nl <= 0) { return 0; }
    var leaf = alloc(nl + 1);
    memcpy(leaf, line + ns, nl);
    store8(leaf + nl, 0);
    var i = 0;
    while (i < vec_len(leaves)) {
        var ex = vec_get(leaves, i);
        if (strlen(ex) == nl) { if (memeq(ex, leaf, nl) == 1) { return 0; } }
        i = i + 1;
    }
    vec_push(leaves, leaf);
    return 0;
}

# v6.2.48 (deps lever 1): scan an umbrella include-hub `path` for `lib/`
# includes and capture them into `leaves`. Folds often keep their stdlib
# `lib/` requirements in the umbrella (sigil → src/lib.cyr, libro →
# src/main.cyr) rather than in the individual folded modules, so scanning
# only the folded modules yields an INCOMPLETE sidecar. No-op if absent.
fn _distlib_scan_umbrella(leaves, path): i64 {
    if (file_exists(path) == 0) { return 0; }
    var usz = _file_size(path);
    if (usz <= 0) { return 0; }
    var ubuf = alloc(usz + 1);
    var un = file_read_all(path, ubuf, usz);
    if (un <= 0) { return 0; }
    store8(ubuf + un, 0);
    var upos = 0;
    while (upos < un) {
        var uls = upos;
        while (upos < un && load8(ubuf + upos) != 10) { upos = upos + 1; }
        var ule = upos;
        if (upos < un) { upos = upos + 1; }
        var ulp = uls;
        while (ulp < ule) {
            var uc = load8(ubuf + ulp);
            if (uc != 32 && uc != 9) { break; }
            ulp = ulp + 1;
        }
        if (ulp < ule && load8(ubuf + ulp) != 35) {
            var ull = ule - ulp;
            if (ull >= 8 && memeq(ubuf + ulp, "include ", 8) == 1) {
                _distlib_capture_lib_leaf(leaves, ubuf + ulp, ull);
            }
        }
    }
    return 0;
}

var _distlib_modular = 0;   # v6.2.50 Phase C: `--modular` → per-module dist + index
# v6.5.8: `--check` regenerates into a sibling temp and byte-compares instead of writing.
var _distlib_check = 0;
var _distlib_drift = 0;     # names of bundles that differed, for the final report

# v6.5.8: enumerate every `[lib.<name>]` profile declared in the manifest.
#
# WHY THIS DID NOT EXIST AND WHY IT MATTERS. `cyrius distlib` regenerates exactly ONE
# bundle per invocation, and nothing could ask the manifest which profiles exist — so
# every multi-profile repo ran an N+1 ritual maintained by hand in its release script.
# That is how sankoch 2.7.6's silent-data-corruption gzip fix nearly shipped with all NINE
# sub-bundles still carrying the buggy encoder under a fresh version string: the main
# bundle was regenerated, the profiles were not, and nothing compared them.
#
# ⚠ LINE-ANCHORED ON PURPOSE. The neighbouring `_distlib_named_deps` scans unanchored,
# which would match `[lib.x]` inside a comment or a string. Skip leading whitespace,
# skip `#` comment lines, then require the line to START with `[lib.`. Bare `[lib]`
# correctly does not match, since the base bundle is not a profile.
#
# Writes NUL-terminated names into `out` (a caller-owned buffer of `outcap` bytes) and
# returns the count, or -1 if the buffer would overflow.
fn _distlib_enum_profiles(mbuf, mlen, out, outcap): i64 {
    var count = 0;
    var w = 0;
    var p = 0;
    while (p < mlen) {
        var ls = p;
        while (p < mlen && load8(mbuf + p) != 10) { p = p + 1; }
        var le = p;
        if (p < mlen) { p = p + 1; }
        var lp = ls;
        while (lp < le) {
            var c = load8(mbuf + lp);
            if (c != 32 && c != 9) { break; }
            lp = lp + 1;
        }
        if (lp >= le) { continue; }
        if (load8(mbuf + lp) == 35) { continue; }              # comment
        if (le - lp < 6) { continue; }                          # shortest is `[lib.x]`
        if (memeq(mbuf + lp, "[lib.", 5) == 0) { continue; }
        var ns = lp + 5;
        var ne = ns;
        while (ne < le && load8(mbuf + ne) != 93) { ne = ne + 1; }   # `]`
        if (ne >= le) { continue; }                             # unterminated header
        var nlen = ne - ns;
        if (nlen <= 0) { continue; }
        # Dedup against what we already captured.
        var dup = 0;
        var q = 0;
        var seen = 0;
        while (seen < count) {
            var slen = strlen(out + q);
            if (slen == nlen) { if (memeq(out + q, mbuf + ns, nlen) == 1) { dup = 1; } }
            q = q + slen + 1;
            seen = seen + 1;
        }
        if (dup == 1) { continue; }
        if (w + nlen + 1 > outcap) { return 0 - 1; }
        memcpy(out + w, mbuf + ns, nlen);
        store8(out + w + nlen, 0);
        # Reuse the existing name-safety rule rather than a second copy of it.
        if (_distlib_valid_profile(out + w) == 0) { continue; }
        w = w + nlen + 1;
        count = count + 1;
    }
    return count;
}

# v6.5.8: byte-compare two files. Returns 1 if identical, 0 otherwise (including when
# either cannot be read). No such helper existed — and it is the load-bearing half of
# `--check`: comparing VERSION STRINGS is exactly what let sankoch's stale profiles look
# fresh. Content is the only thing that answers "was this bundle regenerated".
fn _distlib_files_same(a, b): i64 {
    var abuf = alloc(1048576);
    var bbuf = alloc(1048576);
    var an = file_read_all(a, abuf, 1048575);
    var bn = file_read_all(b, bbuf, 1048575);
    if (an < 0 || bn < 0) { return 0; }
    if (an != bn) { return 0; }
    return memeq(abuf, bbuf, an);
}

# v6.5.8: regenerate (or verify) the base bundle AND every declared profile.
#
# `check` = 0 writes them; `check` = 1 regenerates into a sibling temp, byte-compares, and
# reports every bundle that DIFFERS — the CI shape, so a release cannot ship a stale
# profile the way sankoch 2.7.6 nearly did. Exits non-zero on drift, naming each offender.
fn cmd_distlib_all(check): i64 {
    var mf = "cyrius.cyml";
    if (file_exists(mf) == 0) { mf = "cyrius.toml"; }
    if (file_exists(mf) == 0) {
        _err("no cyrius.cyml or cyrius.toml found");
        return 1;
    }
    var mbuf = alloc(32768);
    var mlen = file_read_all(mf, mbuf, 32767);
    if (mlen <= 0) { _err("cannot read manifest"); return 1; }
    store8(mbuf + mlen, 0);

    var names = alloc(4096);
    var n = _distlib_enum_profiles(mbuf, mlen, names, 4096);
    if (n < 0) { _err("too many [lib.*] profiles for the 4 KB name buffer"); return 1; }

    _distlib_check = check;
    _distlib_drift = 0;
    var failures = 0;

    # The base bundle first — it is the one every consumer resolves by default.
    if (cmd_distlib(0) != 0) { failures = failures + 1; }

    var i = 0;
    var off = 0;
    while (i < n) {
        var nm = names + off;
        if (cmd_distlib(nm) != 0) { failures = failures + 1; }
        off = off + strlen(nm) + 1;
        i = i + 1;
    }
    _distlib_check = 0;

    sys_write(STDOUT_FD, "  ", 2);
    fmt_int(n + 1);
    if (check == 1) { println(" bundle(s) checked (base + profiles)"); }
    else { println(" bundle(s) regenerated (base + profiles)"); }

    if (_distlib_drift > 0) {
        _err("distlib --check: bundle(s) are STALE — regenerate with `cyrius distlib --all`");
        return 1;
    }
    if (failures > 0) { return 1; }
    return 0;
}

# v6.2.51 (closeout refactor): the named-dep exclude set — a captured `lib/X`
# matching a `[deps.X]` block is a fold (resolved transitively), not a stdlib
# leaf. Shared by the sidecar emit + the `--modular` index emit (was duplicated).
fn _distlib_named_deps(mbuf, mlen): i64 {
    var named_deps = vec_new();
    var ndi = 0;
    # v6.5.28 — ANCHOR THE SCAN TO A SECTION HEADER. This matched "[deps." ANYWHERE in the
    # manifest, so a `[deps.X]` written in COMMENT PROSE registered X as a named dep. Filed
    # from patra, where a comment explaining the layout silently deleted a real dep from the
    # generated sidecar — the bundle stayed correct, so nothing failed; the packaging just
    # quietly lost an entry.
    # A real section header is at the START of a line (TOML allows leading whitespace) and is
    # never inside a `#` comment. `bol` tracks line starts; `in_cmt` suppresses the rest of a
    # comment line. Both are needed: anchoring alone still matches a comment that BEGINS with
    # `[deps.x]`, which is exactly how documentation examples are usually written.
    var bol = 1;
    var in_cmt = 0;
    while (ndi < mlen) {
        var ndc = load8(mbuf + ndi);
        if (ndc == 10) { bol = 1; in_cmt = 0; ndi = ndi + 1; }
        elif (in_cmt == 1) { ndi = ndi + 1; }
        elif (ndc == 35) { in_cmt = 1; ndi = ndi + 1; }        # '#' opens a comment
        elif (bol == 1 && (ndc == 32 || ndc == 9)) { ndi = ndi + 1; }   # leading indent keeps bol
        elif (bol == 1 && ndi + 6 <= mlen && memeq(mbuf + ndi, "[deps.", 6) == 1) {
            var nns = ndi + 6;
            var nne = nns;
            while (nne < mlen && load8(mbuf + nne) != 93) { nne = nne + 1; }
            var nnl = nne - nns;
            if (nnl > 0) {
                var nd = alloc(nnl + 1);
                memcpy(nd, mbuf + nns, nnl);
                store8(nd + nnl, 0);
                vec_push(named_deps, nd);
            }
            ndi = nne;
            bol = 0;
        } else { bol = 0; ndi = ndi + 1; }
    }
    return named_deps;
}

# v6.2.50 (deps lever 1 / Phase C — module-granular extraction): emit each
# `[lib].modules` entry as its own `dist/<pkg>/<module>.cyr` (src/ self-refs
# stripped → recorded as sibling deps in the index; lib/ kept inline) plus
# `dist/<pkg>/index.cyml` — a `[modular]` map `<module> = [siblings…, "lib:<leaf>"…]`
# giving the resolver each sub-unit's transitive deps in topological order. So a
# consumer (or a v6.3.x lever-2 profile) can pull EXACT sub-modules instead of the
# whole monolith. The flat single-file `cyrius distlib` is unchanged (default).
fn _distlib_modular_emit(pkg_name, modules, mbuf, mlen): i64 {
    if (_dep_reject_unsafe_name(pkg_name) == 1) { return 1; }   # CVE-32: producer-side pkg name (no `/`/`..` in dist/<pkg>)
    sys_mkdir("dist", 0x1ED);
    var dir_sb = str_builder_new();
    str_builder_add_cstr(dir_sb, "dist/");
    str_builder_add_cstr(dir_sb, pkg_name);
    var moddir = str_data(str_builder_build(dir_sb));
    sys_mkdir(moddir, 0x1ED);

    var named_deps = _distlib_named_deps(mbuf, mlen);

    var idx = str_builder_new();
    str_builder_add_cstr(idx, "# cyrius distlib --modular index (v6.2.50 Phase C)\n");
    str_builder_add_cstr(idx, "# <module> = [sibling-modules, \"lib:<leaf>\"...] — topological resolve order.\n");
    str_builder_add_cstr(idx, "[modular]\n");

    var count = 0;
    var seen_bases = vec_new();   # v6.2.52: per-pkg basename collision guard
    var mi = 0;
    while (mi < vec_len(modules)) {
        var mod_path = vec_get(modules, mi);
        if (file_exists(mod_path) == 0) {
            # v6.2.52 (user: make it fail-loud): a missing module is a HARD ERROR,
            # not a warning — a partial dist silently drops a sub-unit + its index entry.
            _err_ctx("distlib --modular: module not found", mod_path);
            return 1;
        }
        # basename (last path component, strip `.cyr`)
        var bn = mod_path;
        var bi = 0;
        while (load8(mod_path + bi) != 0) {
            if (load8(mod_path + bi) == 47) { bn = mod_path + bi + 1; }
            bi = bi + 1;
        }
        var bnl = strlen(bn);
        if (bnl > 4 && memeq(bn + bnl - 4, ".cyr", 4) == 1) { bnl = bnl - 4; }
        var base = alloc(bnl + 1);
        memcpy(base, bn, bnl);
        store8(base + bnl, 0);
        # v6.2.52 (closeout-deferred): two `[lib].modules` with the same basename in
        # different src/ dirs would overwrite each other's dist/<pkg>/<base>.cyr +
        # emit duplicate index keys (resolver is first-match-wins → silently lost
        # transitive deps). Fail loud instead.
        if (_dep_list_has(seen_bases, base) == 1) {
            _err_ctx("distlib --modular: duplicate module basename collides in dist/", base);
            return 1;
        }
        vec_push(seen_bases, base);

        var of_sb = str_builder_new();
        str_builder_add_cstr(of_sb, moddir);
        str_builder_add_cstr(of_sb, "/");
        str_builder_add_cstr(of_sb, base);
        str_builder_add_cstr(of_sb, ".cyr");
        var mfd = sys_open(str_data(str_builder_build(of_sb)), O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
        if (mfd < 0) { mi = mi + 1; continue; }
        sys_write(mfd, "# ", 2);
        sys_write(mfd, base, strlen(base));
        sys_write(mfd, " (cyrius distlib --modular)\n\n", 29);

        # v6.4.10: per-module read buffer raised 256KB → 1MB to match cycc's own
        # input_buf[1048576] — distlib was rejecting modules the compiler compiles fine
        # (shabdakosh's 283KB generated CMUdict). See distlib-per-module-read-cap proposal.
        var fbuf = alloc(1048576);
        var flen = file_read_all(mod_path, fbuf, 1048575);
        if (flen <= 0) { sys_close(mfd); mi = mi + 1; continue; }
        # v6.2.51 (closeout): fail loud on a >1MB module — a silent truncation
        # would drop trailing `include`s from the index leaf list → missing-dep SIGILL.
        if (flen >= 1048575 && _file_size(mod_path) > 1048575) {
            _err_ctx("distlib --modular: module exceeds 1024KB read cap (truncated)", mod_path);
            sys_close(mfd);
            return 1;
        }
        store8(fbuf + flen, 0);

        str_builder_add_cstr(idx, base);
        str_builder_add_cstr(idx, " = [");
        var first = 1;

        var pos = 0;
        while (pos < flen) {
            var ls = pos;
            while (pos < flen && load8(fbuf + pos) != 10) { pos = pos + 1; }
            var le = pos;
            if (pos < flen) { pos = pos + 1; }
            var ll = le - ls;
            if (ll >= 8 && memeq(fbuf + ls, "include ", 8) == 1) {
                # src/ sibling-module include → record as a dep + strip
                if (ll >= 13 && memeq(fbuf + ls, "include \"src/", 13) == 1) {
                    var ss = ls + 13;
                    var se = ss;
                    while (se < le && load8(fbuf + se) != 34) { se = se + 1; }
                    var xb = ss;
                    var xi = ss;
                    while (xi < se) { if (load8(fbuf + xi) == 47) { xb = xi + 1; } xi = xi + 1; }
                    var xl = se - xb;
                    if (xl > 4 && memeq(fbuf + se - 4, ".cyr", 4) == 1) { xl = xl - 4; }
                    if (xl > 0) {
                        if (first == 0) { str_builder_add_cstr(idx, ", "); }
                        var xs = alloc(xl + 1); memcpy(xs, fbuf + xb, xl); store8(xs + xl, 0);
                        str_builder_add_cstr(idx, "\"");
                        str_builder_add_cstr(idx, xs);
                        str_builder_add_cstr(idx, "\"");
                        first = 0;
                    }
                    continue;
                }
                # lib/ leaf include → record (unless a named-dep) + KEEP the line
                if (ll >= 13 && memeq(fbuf + ls, "include \"lib/", 13) == 1) {
                    var ks = ls + 13;
                    var ke = ks;
                    while (ke < le && load8(fbuf + ke) != 34) { ke = ke + 1; }
                    var kl = ke - ks;
                    if (kl > 4 && memeq(fbuf + ke - 4, ".cyr", 4) == 1) { kl = kl - 4; }
                    if (kl > 0) {
                        var leaf = alloc(kl + 1); memcpy(leaf, fbuf + ks, kl); store8(leaf + kl, 0);
                        var is_nd = 0;
                        var ci = 0;
                        while (ci < vec_len(named_deps)) {
                            var ndn = vec_get(named_deps, ci);
                            if (strlen(ndn) == kl) { if (memeq(ndn, leaf, kl) == 1) { is_nd = 1; } }
                            ci = ci + 1;
                        }
                        if (is_nd == 0) {
                            if (first == 0) { str_builder_add_cstr(idx, ", "); }
                            str_builder_add_cstr(idx, "\"lib:");
                            str_builder_add_cstr(idx, leaf);
                            str_builder_add_cstr(idx, "\"");
                            first = 0;
                        }
                    }
                }
            }
            sys_write(mfd, fbuf + ls, ll);
            sys_write(mfd, "\n", 1);
        }
        sys_close(mfd);
        str_builder_add_cstr(idx, "]\n");
        count = count + 1;
        mi = mi + 1;
    }

    var idx_sb = str_builder_new();
    str_builder_add_cstr(idx_sb, moddir);
    str_builder_add_cstr(idx_sb, "/index.cyml");
    var ifd = sys_open(str_data(str_builder_build(idx_sb)), O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (ifd >= 0) {
        var idx_str = str_data(str_builder_build(idx));
        sys_write(ifd, idx_str, strlen(idx_str));
        sys_close(ifd);
    }

    sys_write(STDOUT_FD, moddir, strlen(moddir));
    sys_write(STDOUT_FD, "/: ", 3);
    fmt_int(count);
    println(" modules + index.cyml");
    return 0;
}

# v6.4.48 — per-profile `.deps` pruning. The umbrella scan (src/lib.cyr) captures
# the WHOLE fold's stdlib leaves, which is right for the full bundle but wrong for a
# `[lib.<profile>]` subset: a `sha`-only profile was getting the entire crypto suite's
# deps (bayan / keccak / mldsa-adjacent / thread / process …). Prune req_leaves to
# only the leaves the profile's bundle actually references. (Full-bundle path unchanged.)
fn _distlib_ident_char(c): i64 {
    if (c >= 97 && c <= 122) { return 1; }   # a-z
    if (c >= 65 && c <= 90)  { return 1; }   # A-Z
    if (c >= 48 && c <= 57)  { return 1; }   # 0-9
    if (c == 95) { return 1; }               # _
    return 0;
}

# Does `bundle` reference the token `name` (nlen) as a whole identifier?
fn _distlib_bundle_refs(bundle, blen, name, nlen): i64 {
    if (nlen <= 0) { return 0; }
    var i = 0;
    while (i + nlen <= blen) {
        if (memeq(bundle + i, name, nlen) == 1) {
            var lok = 0;
            if (i == 0) { lok = 1; } elif (_distlib_ident_char(load8(bundle + i - 1)) == 0) { lok = 1; }
            if (lok == 1 && _distlib_ident_char(load8(bundle + i + nlen)) == 0) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Return 1 if `bundle` references any symbol DEFINED in leaf lib/<leaf>.cyr —
# a top-level `fn NAME(` or a `var NAME`. Conservative: on any read failure or
# a leaf we can't inspect, keep it (return 1) so we never drop a real dep.
fn _distlib_leaf_referenced(leaf, bundle, blen): i64 {
    return _distlib_leaf_referenced_d(leaf, bundle, blen, 0);
}

fn _distlib_leaf_referenced_d(leaf, bundle, blen, depth): i64 {
    # Resolve the leaf: repo-vendored lib/<leaf>.cyr first, else the global
    # stdlib snapshot <CYRIUS_HOME>/lib/<leaf>.cyr (a package vendors only its
    # declared deps, but the umbrella can name others that live only globally).
    var psb = str_builder_new();
    str_builder_add_cstr(psb, "lib/");
    str_builder_add_cstr(psb, leaf);
    str_builder_add_cstr(psb, ".cyr");
    var path = str_data(str_builder_build(psb));
    if (file_exists(path) == 0) {
        if (_home == 0) { return 1; }
        var gsb = str_builder_new();
        str_builder_add_cstr(gsb, _home);
        str_builder_add_cstr(gsb, "/lib/");
        str_builder_add_cstr(gsb, leaf);
        str_builder_add_cstr(gsb, ".cyr");
        path = str_data(str_builder_build(gsb));
        if (file_exists(path) == 0) { return 1; }
    }
    var lbuf = alloc(1048576);
    var llen = file_read_all(path, lbuf, 1048575);
    if (llen <= 0) { return 1; }
    store8(lbuf + llen, 0);
    # v6.5.29 — a leaf that is a DISPATCHER defines almost nothing itself. `lib/syscalls.cyr`
    # is 8 KB of `#ifdef` + `include` with TWO top-level definitions; every `sys_*` wrapper
    # lives in a per-arch peer it includes. Scanning only this file therefore found no
    # referenced symbol and the leaf was pruned away — dropping exactly the leaf a consumer
    # cannot build without. Recurse one level into the leaf's own `include "lib/X.cyr"` lines
    # so a dispatcher is judged by what it BRINGS, not by what it literally spells.
    # Depth 1 is enough for every dispatcher in the tree and cannot loop.
    if (depth < 1) {
        var leaflen = strlen(leaf);
        var ip = 0;
        while (ip < llen) {
            var ibol = 0;
            if (ip == 0) { ibol = 1; } elif (load8(lbuf + ip - 1) == 10) { ibol = 1; }
            if (ibol == 1 && ip + 13 < llen && memeq(lbuf + ip, "include \"lib/", 13) == 1) {
                var ns2 = ip + 13;
                var ne2 = ns2;
                while (ne2 < llen && load8(lbuf + ne2) != 34) { ne2 = ne2 + 1; }
                # Strip the trailing ".cyr" so the peer is named the way a leaf is named.
                if (ne2 - ns2 > 4 && memeq(lbuf + ne2 - 4, ".cyr", 4) == 1) { ne2 = ne2 - 4; }
                # ⛔ ONLY recurse into a leaf's PRIVATE peers — those whose name starts with
                # the leaf's own name. That is the convention throughout the tree
                # (`syscalls` → `syscalls_x86_64_linux`, `tls_native` → `tls_native_hs13`) and
                # the guard is load-bearing, not decoration: a dispatcher like `tls_native`
                # ALSO includes common leaves (`alloc`, `string`, `io`, `sigil`, …), so an
                # unguarded recursion keeps `tls_native` alive merely because the bundle
                # references `io`. Measured: without this, sit's `read` profile — which exists
                # precisely to drop the TLS stack — retained `tls_native` while none of its 27
                # top-level symbols appeared anywhere in the bundle.
                var plen2 = ne2 - ns2;
                var isown = 0;
                if (plen2 > leaflen) {
                    if (memeq(lbuf + ns2, leaf, leaflen) == 1) { isown = 1; }
                }
                if (isown == 1 && plen2 > 0) {
                    var peer = alloc(plen2 + 1);
                    memcpy(peer, lbuf + ns2, plen2);
                    store8(peer + plen2, 0);
                    if (_distlib_leaf_referenced_d(peer, bundle, blen, depth + 1) == 1) { return 1; }
                }
            }
            while (ip < llen && load8(lbuf + ip) != 10) { ip = ip + 1; }
            ip = ip + 1;
        }
    }
    var p = 0;
    while (p < llen) {
        var bol = 0;
        if (p == 0) { bol = 1; } elif (load8(lbuf + p - 1) == 10) { bol = 1; }
        if (bol == 1) {
            var kw = 0;   # 3 = "fn ", 4 = "var "
            if (p + 3 < llen && memeq(lbuf + p, "fn ", 3) == 1) { kw = 3; }
            elif (p + 4 < llen && memeq(lbuf + p, "var ", 4) == 1) { kw = 4; }
            if (kw > 0) {
                var ns = p + kw;
                while (ns < llen && load8(lbuf + ns) == 32) { ns = ns + 1; }
                var ne = ns;
                while (ne < llen && _distlib_ident_char(load8(lbuf + ne)) == 1) { ne = ne + 1; }
                if (ne > ns) {
                    if (_distlib_bundle_refs(bundle, blen, lbuf + ns, ne - ns) == 1) { return 1; }
                }
            }
        }
        while (p < llen && load8(lbuf + p) != 10) { p = p + 1; }
        p = p + 1;
    }
    return 0;
}

# Prune `leaves` to those a profile bundle at `bundle_path` actually references.
# v6.5.10: union the manifest's DECLARED `[deps] stdlib` into the sidecar's leaf set.
#
# THE FILED DEFECT (setu 0.8.2, 2026-08-07). `dist/<lib>.deps` says it lists "stdlib
# leaves this fold requires in scope", but it was built ONLY by scanning the bundled
# module sources for literal `include "lib/X.cyr"` lines — so it captured what a module
# INCLUDES, never what it REFERENCES through the declaration. setu emitted 8 leaves
# against a declared 12; the four missing (`result`, `net`, `chrono`, `args`) are all
# referenced at top level in `src/client.cyr`.
#
# Three hypotheses were measured and falsified by the filer before it was filed: it is
# not the declaration (deleting `assert` from `[deps] stdlib` left it in the sidecar), it
# is not an inline-comment parse bug (adding a comment to `vec` left it present), and it
# is not a direct-symbol scan either. It was simply a different, smaller thing than its
# own header claimed.
#
# ⭐ AND A WRONG SIDECAR SWITCHES OFF cyrius's OWN CONSUMER CHECK. `cyrius deps` validates
# a consumer's `[deps] stdlib` against the dep's sidecar — correctly and loudly. Measured:
# with a corrected 12-leaf sidecar an under-declaring consumer got a hard error naming
# `chrono` and `args`; with the raw 8-leaf one the same consumer built **OK**, silently,
# on agnos. So this did not merely mislead a human reader — it disabled the machine check
# that exists to catch exactly this mistake.
#
# UNION, not replace: the inferred include-scan can legitimately catch a leaf the author
# forgot to declare, so taking both can never under-report relative to either source.
fn _distlib_union_declared_stdlib(leaves, mbuf, mlen): i64 {
    # v6.5.30 — the comment above USED to say "same key-boundary rules cmd_deps uses". It
    # was not the same: cmd_deps moved to the shared `_toml_key_at` helper, which also
    # rejects a match sitting inside a QUOTED VALUE, and this hand-rolled copy never did.
    #
    # ⛔ THE FILED CONSEQUENCE. niyama's `[package] description` reads "...foldable into
    # stdlib per sandhi pattern" ELEVEN LINES above the real `[deps] stdlib` key. The
    # identifier-boundary guard passes (preceded by a space), the comment guard passes (not a
    # `#` line), so the scan locked onto the description, `_parse_toml_str_array` walked
    # forward to the next `[` — a SECTION HEADER — and returned empty. Zero leaves meant
    # `vec_len(req_leaves) > 0` was false and `cyrius distlib` wrote **no sidecar at all**,
    # silently, on a bundle that was otherwise correct.
    #
    # ⚠ THIS IS THE SAME BUG, THE SAME PHRASE AND THE SAME FILE-SHAPE AS THE bayan DEFECT
    # FIXED AT v6.5.17 — bayan's description says "foldable into stdlib per the sandhi
    # pattern" too. That fix corrected `cmd_deps` and introduced `_toml_key_at`; it did not
    # sweep the other two copies of the scan, so the identical defect sat here for thirteen
    # releases and re-surfaced through a different consumer. GREP THE SHAPE, NOT THE SITE.
    var found = 0 - 1;
    var si = 0;
    while (si < mlen) {
        if (memeq(mbuf + si, "stdlib", 6) == 1) {
            if (_toml_key_at(mbuf, mlen, si, 6) == 1) {
                # Defence-in-depth, mirroring cmd_deps: a key that yields ZERO leaves is not
                # the `stdlib` key. Keep scanning instead of committing to the first match.
                if (vec_len(_parse_toml_str_array(mbuf, mlen, si)) > 0) { found = si; si = mlen; }
            }
        }
        si = si + 1;
    }
    if (found < 0) { return 0; }
    # Expand `[groups]` refs so a declared group name lands as its LEAVES, not as a
    # bogus leaf named after the group.
    _dep_parse_groups(mbuf, mlen);
    _dep_register_default_std_group();
    var mods = _dep_expand_groups(_parse_toml_str_array(mbuf, mlen, found));
    var added = 0;
    var i = 0;
    while (i < vec_len(mods)) {
        var nm = vec_get(mods, i);
        var dup = 0;
        var j = 0;
        while (j < vec_len(leaves)) {
            if (streq(vec_get(leaves, j), nm) == 1) { dup = 1; }
            j = j + 1;
        }
        if (dup == 0) { vec_push(leaves, nm); added = added + 1; }
        i = i + 1;
    }
    return added;
}

fn _distlib_prune_profile_leaves(leaves, bundle_path): i64 {
    if (file_exists(bundle_path) == 0) { return leaves; }
    var bb = alloc(4194304);
    var bl = file_read_all(bundle_path, bb, 4194303);
    if (bl <= 0) { return leaves; }
    var kept = vec_new();
    var i = 0;
    while (i < vec_len(leaves)) {
        var lf = vec_get(leaves, i);
        if (_distlib_leaf_referenced(lf, bb, bl) == 1) { vec_push(kept, lf); }
        i = i + 1;
    }
    return kept;
}

fn cmd_distlib(profile): i64 {
    if (_distlib_valid_profile(profile) == 0) {
        _err("invalid profile name (allowed: [a-zA-Z0-9_-]{1,32})");
        return 1;
    }
    # Read manifest
    var mf = "cyrius.cyml";
    if (file_exists(mf) == 0) { mf = "cyrius.toml"; }
    if (file_exists(mf) == 0) {
        _err("no cyrius.cyml or cyrius.toml found");
        return 1;
    }
    var mbuf = alloc(32768);
    var mlen = file_read_all(mf, mbuf, 32767);
    if (mlen <= 0) { _err("cannot read manifest"); return 1; }
    store8(mbuf + mlen, 0);

    # Extract package name
    var pkg_name = 0;
    var pi = 0;
    while (pi < mlen) {
        if (pi + 4 <= mlen && memeq(mbuf + pi, "name", 4) == 1) {   # v6.2.52: bound the tail read
            if (pi + 4 < mlen && (load8(mbuf + pi + 4) == 32 || load8(mbuf + pi + 4) == 61)) {
                var qi = pi + 4;
                while (qi < mlen && load8(mbuf + qi) != 34) { qi = qi + 1; }
                qi = qi + 1;
                var qs = qi;
                while (qi < mlen && load8(mbuf + qi) != 34) { qi = qi + 1; }
                pkg_name = alloc(qi - qs + 1);
                memcpy(pkg_name, mbuf + qs, qi - qs);
                store8(pkg_name + qi - qs, 0);
                break;
            }
        }
        pi = pi + 1;
    }
    if (pkg_name == 0) { pkg_name = "lib"; }

    # Extract version via cyml_expand_value
    var pkg_ver = _version;

    # Find modules list. With a profile, we look for [lib.PROFILE] only;
    # otherwise the existing [build] / [lib] fallback applies.
    var modules = 0;
    var profile_hdr = 0;
    var profile_hdr_len = 0;
    if (profile != 0) {
        # Build "[lib.PROFILE]" header once for section matching.
        var plen = strlen(profile);
        profile_hdr = alloc(plen + 8);
        memcpy(profile_hdr, "[lib.", 5);
        memcpy(profile_hdr + 5, profile, plen);
        store8(profile_hdr + 5 + plen, 93);    # ']'
        store8(profile_hdr + 6 + plen, 0);
        profile_hdr_len = 6 + plen;
    }
    var si = 0;
    while (si < mlen) {
        var matched = 0;
        var header_len = 0;
        if (profile != 0) {
            if (memeq(mbuf + si, profile_hdr, profile_hdr_len) == 1) {
                matched = 1;
                header_len = profile_hdr_len;
            }
        } else {
            if (memeq(mbuf + si, "[build]", 7) == 1) {
                matched = 1;
                header_len = 7;
            }
            elif (memeq(mbuf + si, "[lib]", 5) == 1) {
                matched = 1;
                header_len = 5;
            }
        }
        if (matched == 1) {
            var bi = si + header_len;
            while (bi < mlen) {
                if (load8(mbuf + bi) == 91 && load8(mbuf + bi + 1) != 91) { break; }
                # First non-space token; skip comments; require a key
                # boundary after `modules` (space/tab/`=`). Boundary/
                # comment-aware + indented-key capable — see CHANGELOG [6.0.36].
                var ls = bi;
                while (ls < mlen && (load8(mbuf + ls) == 32 || load8(mbuf + ls) == 9)) {
                    ls = ls + 1;
                }
                if (ls < mlen && load8(mbuf + ls) != 35 && memeq(mbuf + ls, "modules", 7) == 1) {
                    var after = load8(mbuf + ls + 7);
                    if (after == 32 || after == 9 || after == 61) {
                        modules = _parse_toml_str_array(mbuf, mlen, ls);
                        break;
                    }
                }
                while (bi < mlen && load8(mbuf + bi) != 10) { bi = bi + 1; }
                bi = bi + 1;
            }
            if (modules != 0) { break; }
        }
        si = si + 1;
    }

    if (modules == 0 || vec_len(modules) == 0) {
        if (profile != 0) {
            _err_ctx("no modules found for profile", profile);
            println("  Add modules = [...] under the matching [lib.PROFILE] section.");
        } else {
            _err("no [build] modules or [lib] modules found in manifest");
            println("  Add modules = [\"src/types.cyr\", \"src/lib.cyr\", ...] to your manifest.");
        }
        return 1;
    }

    # v6.2.50 Phase C: --modular → per-module `dist/<pkg>/<mod>.cyr` + index.cyml
    # (the flat single-file path below is unchanged for default `cyrius distlib`).
    if (_distlib_modular == 1) {
        return _distlib_modular_emit(pkg_name, modules, mbuf, mlen);
    }

    # Create dist/ directory
    sys_mkdir("dist", 0x1ED);

    # Build output path: dist/{name}.cyr or dist/{name}-{profile}.cyr
    var out_sb = str_builder_new();
    str_builder_add_cstr(out_sb, "dist/");
    str_builder_add_cstr(out_sb, pkg_name);
    if (profile != 0) {
        str_builder_add_cstr(out_sb, "-");
        str_builder_add_cstr(out_sb, profile);
    }
    str_builder_add_cstr(out_sb, ".cyr");
    var out_path = str_data(str_builder_build(out_sb));

    # v6.5.8 `--check`: regenerate into a SIBLING temp and byte-compare, so a CI job can
    # ask "is every committed bundle current?" without dirtying the tree.
    # ⚠ The temp lives inside dist/, not /tmp: cbt/cyrius.cyr cross-compiles to PE and both
    # Mach-O flavours, and a hardcoded /tmp is wrong on Windows. A sibling path sidesteps
    # the platform temp-dir question entirely and keeps the rename-free compare local.
    var real_path = out_path;
    if (_distlib_check == 1) {
        var chk_sb = str_builder_new();
        str_builder_add_cstr(chk_sb, "dist/.check-");
        str_builder_add_cstr(chk_sb, pkg_name);
        if (profile != 0) {
            str_builder_add_cstr(chk_sb, "-");
            str_builder_add_cstr(chk_sb, profile);
        }
        str_builder_add_cstr(chk_sb, ".cyr");
        out_path = str_data(str_builder_build(chk_sb));
    }

    var ofd = sys_open(out_path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (ofd < 0) {
        _err_ctx("cannot create", out_path);
        return 1;
    }

    # Write header
    sys_write(ofd, "# ", 2);
    sys_write(ofd, pkg_name, strlen(pkg_name));
    sys_write(ofd, ".cyr -- bundled distribution\n", 29);
    sys_write(ofd, "# Version: ", 11);
    sys_write(ofd, pkg_ver, strlen(pkg_ver));
    sys_write(ofd, "\n", 1);
    if (profile != 0) {
        sys_write(ofd, "# Profile: ", 11);
        sys_write(ofd, profile, strlen(profile));
        sys_write(ofd, "\n", 1);
    }
    sys_write(ofd, "# Generated by: cyrius distlib\n", 31);
    sys_write(ofd, "# Do not edit -- rebuild with: cyrius distlib\n", 46);
    # v6.0.9 — no trailing blank after the header. The per-module
    # loop below opens each module with `\n# --- <name> ---\n\n`,
    # so the single blank between header and first module marker
    # comes for free. Writing an extra blank here produced the
    # bundle-line-6 cyrlint double-blank warning (see
    # issues/2026-05-27-cyrius-distlib-blank-lines.md, cause 1).

    # v6.0.9 — track previous-line-blank to collapse runs of ≥2
    # consecutive blanks. The include-strip step drops `include`
    # lines silently, which leaves adjacent blanks (cause 2 in the
    # filed issue). prev_blank starts at 0 (the header's last write
    # was a content line, "# Do not edit ..."), so the per-module
    # opener writes its single leading blank as the separator.
    var prev_blank = 0;

    # Concatenate each module
    var mi = 0;
    var total_lines = 0;
    var req_leaves = vec_new();   # v6.2.47: stripped lib/ leaf requirements → dist/<pkg>.deps sidecar
    while (mi < vec_len(modules)) {
        var mod_path = vec_get(modules, mi);
        if (file_exists(mod_path) == 0) {
            # v6.2.52 (user: make it fail-loud): a missing module is a HARD ERROR,
            # not a warning — a partial bundle silently drops a module.
            _err_ctx("distlib: module not found", mod_path);
            sys_close(ofd);
            return 1;
        }

        # Module separator. The leading \n is the single blank
        # before the module header; the trailing \n\n is "end the
        # header line + one blank after". prev_blank=1 afterwards.
        if (prev_blank == 0) { sys_write(ofd, "\n", 1); }
        sys_write(ofd, "# --- ", 6);
        # Extract basename
        var bn = mod_path;
        var bni = 0;
        while (load8(mod_path + bni) != 0) {
            if (load8(mod_path + bni) == 47) { bn = mod_path + bni + 1; }
            bni = bni + 1;
        }
        sys_write(ofd, bn, strlen(bn));
        sys_write(ofd, " ---\n\n", 6);
        prev_blank = 1;

        # Read module and write line by line, stripping include
        # directives (both `lib/...` stdlib refs and `src/...`
        # self-refs). The consumer is expected to include any
        # required stdlib before this bundle — cyrius's deps phase
        # handles the include order, now with stdlib-before-deps
        # (v5.5.26 flip in cbt/build.cyr).
        # v5.7.36: per-module read buffer 64KB → 256KB (mabda hit the 64KB wall).
        # v6.4.10: 256KB → 1MB (1048576) to match cycc's own input_buf[1048576] —
        # distlib was refusing modules the compiler compiles fine (shabdakosh's 283KB
        # generated CMUdict forced a manual shard). One-shot alloc in the short-lived
        # cbt process; the fail-loud guard is preserved at the new 1MB ceiling. A
        # dynamic (_file_size-based) buffer is the eventual fix if a module nears 1MB.
        var fbuf = alloc(1048576);
        var flen = file_read_all(mod_path, fbuf, 1048575);
        if (flen <= 0) { mi = mi + 1; continue; }
        # v6.2.51 (closeout): fail loud on a >1MB module rather than silently
        # truncating the bundle + dropping its trailing include/leaf lines.
        if (flen >= 1048575 && _file_size(mod_path) > 1048575) {
            _err_ctx("distlib: module exceeds 1024KB read cap (truncated)", mod_path);
            sys_close(ofd);
            return 1;
        }
        store8(fbuf + flen, 0);

        var pos = 0;
        while (pos < flen) {
            var ls = pos;
            while (pos < flen && load8(fbuf + pos) != 10) { pos = pos + 1; }
            var le = pos;
            if (pos < flen) { pos = pos + 1; }

            var ll = le - ls;
            if (ll >= 8 && memeq(fbuf + ls, "include ", 8) == 1) {
                # v6.2.47: capture the `lib/` requirement for the sidecar.
                _distlib_capture_lib_leaf(req_leaves, fbuf + ls, ll);
                # v6.2.48: strip `src/` self-refs (those files are absent at the
                # consumer) but KEEP `lib/` includes so the bundle stays
                # self-contained for RAW-include consumers (e.g. a test that does
                # `include "dist/pkg.cyr"` directly — sigil's tcyr suite). A
                # cyrius-deps consumer dedupes the redundant include against the
                # sidecar prepend via include-once. This makes cyrius distlib a
                # superset of the bash regen-dist.sh it replaces (which kept lib/,
                # stripped src/) — moving sigil back to distlib was breaking its
                # tcyr suite precisely because distlib used to strip lib/ too.
                if (ll >= 13 && memeq(fbuf + ls, "include \"src/", 13) == 1) {
                    continue;
                }
            }
            # v6.0.9 — collapse consecutive blanks. A line is blank
            # iff ll == 0. Skip a blank if the previous emitted line
            # was also blank; otherwise track the new state.
            if (ll == 0) {
                if (prev_blank == 1) { continue; }
                prev_blank = 1;
            } else {
                prev_blank = 0;
            }
            sys_write(ofd, fbuf + ls, ll);
            sys_write(ofd, "\n", 1);
            total_lines = total_lines + 1;
        }

        mi = mi + 1;
    }

    sys_close(ofd);

    # v6.2.48 (deps lever 1): a fold's modules often rely on an umbrella
    # include-hub for their stdlib `lib/` deps rather than `include`-ing them
    # directly (sigil's crypto modules USE ct/keccak but it's `src/lib.cyr`
    # that carries the includes; libro uses `src/main.cyr`). Scan the umbrella
    # convention(s) so the sidecar captures the fold's FULL `lib/` requirement
    # set, not just what the folded modules directly include.
    _distlib_scan_umbrella(req_leaves, "src/lib.cyr");
    _distlib_scan_umbrella(req_leaves, "src/main.cyr");

    # v6.2.48: a captured `lib/X` that matches a `[deps.X]` named dep is NOT a
    # stdlib leaf — it resolves as a fold via the consumer's transitive
    # resolution. Listing it in the sidecar would double-include `lib/X.cyr`
    # (once transitively, once as a bogus stdlib pull) → duplicate-fn errors.
    # Collect the named-dep names so they're EXCLUDED from the sidecar below.
    var named_deps = _distlib_named_deps(mbuf, mlen);   # v6.2.51 closeout: shared helper (was duplicated here + in _distlib_modular_emit)

    # v6.5.10: fold the DECLARED `[deps] stdlib` into the sidecar's leaf set.
    #
    # v6.5.29 — THIS NOW RUNS FOR PROFILES TOO, and the ORDER is the fix. It used to be
    # base-only, with the stated reason that a profile is a narrow subset so unioning the
    # whole declaration would over-report. That reasoning was sound about over-reporting and
    # wrong about the remedy: it left profiles on include-scan inference ALONE, and the
    # toolchain's own documented convention (`cyrius-guide.md`: "includes are auto-prepended —
    # source files only need project includes") means a conforming project has NO stdlib
    # include lines to scan. Two individually-reasonable rules that jointly guarantee an
    # EMPTY profile sidecar for anyone who follows the guide. Filed twice — ranga (M5,
    # header-only sidecars for `[lib.spectral]`/`[lib.hwaccel]`) and sit (v1.4.0, no sidecar
    # file at all for `[lib.read]`) — and they are ONE defect, not two.
    #
    # ⛔ The union must come BEFORE the prune, not instead of it. Over-reporting is prevented
    # by the prune NARROWING the union to what the profile bundle actually references — a
    # positive filter — rather than by withholding the leaves entirely, which under-reports to
    # zero. Same intent, achieved by construction.
    var _decl_added = _distlib_union_declared_stdlib(req_leaves, mbuf, mlen);
    if (_verbose == 1 && _decl_added > 0) {
        sys_write(STDOUT_FD, "  sidecar: +", 12);
        fmt_int(_decl_added);
        println(" leaf/leaves from the declared [deps] stdlib");
    }

    # v6.4.48 — for a `[lib.<profile>]` subset, prune the leaf set to only those the profile
    # bundle actually references. Without this a `sha` profile's sidecar carried the whole
    # crypto suite's stdlib chain. Full-bundle path (profile == 0) keeps the complete set.
    if (profile != 0) {
        var _pre_prune = vec_len(req_leaves);
        req_leaves = _distlib_prune_profile_leaves(req_leaves, out_path);
        if (_verbose == 1) {
            sys_write(STDOUT_FD, "  sidecar: profile prune ", 25);
            fmt_int(_pre_prune);
            sys_write(STDOUT_FD, " -> ", 4);
            fmt_int(vec_len(req_leaves));
            println(" leaf/leaves");
        }
    }

    # v6.2.47 (deps lever 1, Phase A producer side): emit the dep sidecar
    # `dist/<pkg>.deps` — one stdlib leaf per line — capturing the
    # `include "lib/X"` requirements stripped above. Lets `cyrius deps`
    # auto-resolve a fold's stdlib leaves for a consumer that declares just
    # `[deps.<pkg>]` (no hand-authored `requires`). Folds destroy their
    # includes at fold time, so this index is the only record.
    # v6.5.29 — a PROFILE always emits its sidecar, even when the pruned set is empty.
    # The `> 0` guard meant an empty result wrote no file at all, so `dist/<pkg>-<prof>.deps`
    # simply never appeared and a consumer following the sidecar silently fell back to the
    # BASE sidecar — the superset the profile exists to avoid. An empty profile sidecar is a
    # true and useful statement ("this profile needs no stdlib leaves"); a missing one is an
    # invitation to inherit the wrong answer. The base path keeps the `> 0` guard so a
    # package with genuinely no leaves does not gain a stray file.
    if (vec_len(req_leaves) > 0 || profile != 0) {
        var dep_sb = str_builder_new();
        var opl = strlen(out_path);
        if (opl > 4 && memeq(out_path + opl - 4, ".cyr", 4) == 1) {
            var stem = alloc(opl - 3);
            memcpy(stem, out_path, opl - 4);
            store8(stem + opl - 4, 0);
            str_builder_add_cstr(dep_sb, stem);
        } else {
            str_builder_add_cstr(dep_sb, out_path);
        }
        str_builder_add_cstr(dep_sb, ".deps");
        var sidecar_path = str_data(str_builder_build(dep_sb));
        var dfd = sys_open(sidecar_path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
        if (dfd >= 0) {
            sys_write(dfd, "# cyrius dep sidecar - stdlib leaves this fold requires in scope.\n", 66);
            sys_write(dfd, "# Auto-generated by `cyrius distlib`; consumed by `cyrius deps`.\n", 65);
            var li = 0;
            var written = 0;
            while (li < vec_len(req_leaves)) {
                var lf = vec_get(req_leaves, li);
                var lfl = strlen(lf);
                # Skip named-dep folds (resolved transitively, not as leaves).
                var is_nd = 0;
                var ci = 0;
                while (ci < vec_len(named_deps)) {
                    var ndn = vec_get(named_deps, ci);
                    if (strlen(ndn) == lfl) { if (memeq(ndn, lf, lfl) == 1) { is_nd = 1; } }
                    ci = ci + 1;
                }
                if (is_nd == 0) {
                    sys_write(dfd, lf, lfl);
                    sys_write(dfd, "\n", 1);
                    written = written + 1;
                }
                li = li + 1;
            }
            sys_close(dfd);
            sys_write(STDOUT_FD, sidecar_path, strlen(sidecar_path));
            sys_write(STDOUT_FD, ": ", 2);
            fmt_int(written);
            println(" stdlib leaf requirements");
        }
    }

    # Standalone compile-check is informational only (v5.5.27).
    # A bundle like `dist/patra.cyr` is DESIGNED to be concatenated
    # into a consumer's compile unit that already has the stdlib in
    # scope (via the consumer's own `include "lib/syscalls.cyr"` or
    # via cyrius's own `[deps] stdlib = [...]` resolution). The
    # bundle's include directives are stripped during concatenation,
    # so references like `SYS_LSEEK` are intentionally unresolved
    # until the consumer includes them. A non-zero compile result
    # is therefore NOT a bundle defect; it's expected for bundles
    # whose stdlib deps are declared in cyrius.cyml rather than
    # re-included per module. Emit an info note instead of failing
    # the command.
    #
    # Prior behavior exited 1 here, which broke patra 1.5.5's
    # release CI (the release workflow runs `cyrius distlib` as a
    # step; every consumer-bundle shape tripped the same check).
    # v6.5.8: in --check mode compare against the committed bundle and clean up. Skipped
    # for the informational compile below — it would be N spurious compiles (14 for sigil)
    # of a temp we are about to delete.
    if (_distlib_check == 1) {
        var same = _distlib_files_same(out_path, real_path);
        var dp_sb = str_builder_new();
        var dopl = strlen(out_path);
        if (dopl > 4) {
            var dstem = alloc(dopl - 3);
            memcpy(dstem, out_path, dopl - 4);
            store8(dstem + dopl - 4, 0);
            str_builder_add_cstr(dp_sb, dstem);
        }
        str_builder_add_cstr(dp_sb, ".deps");
        var chk_deps = str_data(str_builder_build(dp_sb));
        # The .deps sidecar counts too — sigil's CI already diff-checks dist/sigil.deps,
        # and a stale sidecar mis-resolves a consumer's stdlib leaves.
        if (file_exists(chk_deps) == 1) {
            var rd_sb = str_builder_new();
            var ropl = strlen(real_path);
            if (ropl > 4) {
                var rstem = alloc(ropl - 3);
                memcpy(rstem, real_path, ropl - 4);
                store8(rstem + ropl - 4, 0);
                str_builder_add_cstr(rd_sb, rstem);
            }
            str_builder_add_cstr(rd_sb, ".deps");
            if (_distlib_files_same(chk_deps, str_data(str_builder_build(rd_sb))) == 0) { same = 0; }
            xunlink(chk_deps);
        }
        xunlink(out_path);
        if (same == 0) {
            _distlib_drift = _distlib_drift + 1;
            sys_write(STDERR_FD, "  STALE: ", 9);
            sys_write(STDERR_FD, real_path, strlen(real_path));
            sys_write(STDERR_FD, "\n", 1);
            return 0;
        }
        sys_write(STDOUT_FD, "  current: ", 11);
        sys_write(STDOUT_FD, real_path, strlen(real_path));
        sys_write(STDOUT_FD, "\n", 1);
        return 0;
    }

    # v6.5.14: this compiled to `/dev/null` and therefore NEVER RAN. compile()
    # writes an intermediate `<output>.tmp.<pid>` for the atomic rename, and
    # `/dev/null.tmp.<pid>` cannot be created (/dev/ is not writable), so the
    # call failed on the WRITE every time — before cycc ever saw the bundle.
    # The note below then attributed that failure to unresolved symbols, so a
    # syntactically broken bundle and a perfect one printed the same reassuring
    # line. This is the identical defect v5.7.8 fixed for `cyrius check`
    # (~line 566 of this file); distlib never got the same treatment.
    # ...and it is checked the way a CONSUMER actually uses it: through a
    # generated one-line entry that `include`s the bundle. Piping the bundle
    # itself down stdin (what this used to do) also hits cycc's 1 MB input_buf
    # — sigil's main bundle passed 1 MB and reported `input exceeds 1MB buffer`
    # — whereas `include` is resolved by cycc from DISK and has no such cap. So
    # the stdin form was doubly wrong: it never ran, and had it run it would
    # have failed the largest bundles for a reason no consumer ever meets.
    # The entry lands NEXT TO the bundle so the v6.5.7 `#@incdir` marker
    # resolves the include relative to the entry's own directory.
    var dl_pid = syscall(39);
    var dl_ob = str_builder_new();
    str_builder_add_cstr(dl_ob, _cbt_tmpfile("distchk_"));
    str_builder_add_int(dl_ob, dl_pid);
    var dl_out = str_data(str_builder_build(dl_ob));

    var dl_base = out_path;
    var dl_bi = strlen(out_path);
    while (dl_bi > 0) {
        if (load8(out_path + dl_bi - 1) == 47) { dl_base = out_path + dl_bi; dl_bi = 0; }
        else { dl_bi = dl_bi - 1; }
    }
    # v6.5.17: the entry lives in the PROJECT ROOT, not beside the bundle, and
    # includes the bundle by its full relative path. v6.5.14 put it in dist/ so
    # the #@incdir marker would resolve the bundle's own name — but that also
    # rooted the manifest's auto-prepended `lib/<leaf>.cyr` lines at dist/lib/,
    # which does not exist, so the stdlib silently failed to prepend. bayan is
    # the case that exposed it: its bundle compiles clean when the same leaves
    # are included by hand, and `cyrius check --with-deps` fails identically —
    # i.e. the bundle was always correct and only the check's CWD was wrong.
    var dl_eb = str_builder_new();
    str_builder_add_cstr(dl_eb, ".distchk");
    str_builder_add_int(dl_eb, dl_pid);
    str_builder_add_cstr(dl_eb, ".cyr");
    var dl_entry = str_data(str_builder_build(dl_eb));

    var dl_sb = str_builder_new();
    str_builder_add_cstr(dl_sb, "include \"");
    str_builder_add_cstr(dl_sb, out_path);
    str_builder_add_cstr(dl_sb, "\"\n");
    var dl_src = str_data(str_builder_build(dl_sb));
    # Undefined fns are the ONE expected failure (a bundle ships no stdlib), so
    # downgrade exactly that and let everything else stay fatal. Previously any
    # non-zero result printed the reassuring "unresolved symbols (expected)"
    # note and distlib still exited 0 — so a bundle that did not parse shipped
    # looking identical to a good one.
    # v6.5.17: compile the entry WITH the manifest's [deps] stdlib in scope.
    # 6.5.14's repaired check compiled the bundle ALONE and downgraded undefined
    # FNS with --allow-undef. But a bundle ships no stdlib GLOBALS either, and an
    # undefined variable is a PARSE-TIME abort (parse_expr.cyr:589) that
    # --allow-undef cannot reach — it only gates the fixup stage. So any bundle
    # reading a stdlib `var` or enum constant was reported as defective and
    # distlib exited 1: hisab's `F64_ONE` (the ordinary way to write 1.0 in a
    # language with no float literals), and 44 of 69 [lib] repos on the filer's
    # machine. The bundle was correct; the check was asking the wrong question.
    # Prepending deps asks the RIGHT one — "does this compile the way a consumer
    # will use it" — and makes the check STRONGER, not weaker.
    var dl_saved_skip = _skip_deps;
    _skip_deps = 0;
    var check_r = 0 - 1;
    var dl_wrote = 0;
    if (file_write_all(dl_entry, dl_src, strlen(dl_src)) >= 0) {
        dl_wrote = 1;
        _cc_allow_undef = 1;
        check_r = compile(dl_entry, dl_out);
        _cc_allow_undef = 0;
        xunlink(dl_entry);
    }
    _skip_deps = dl_saved_skip;
    sys_unlink(dl_out);
    if (dl_wrote == 0) {
        _err_ctx("distlib: cannot write the bundle self-check entry", dl_entry);
        return 1;
    }
    if (check_r != 0) {
        _err_ctx("distlib: the generated bundle does not compile", out_path);
        _info("      (undefined fns are already downgraded — this is a REAL defect");
        _info("       in the bundle, not the consumer's missing stdlib).");
        return 1;
    }

    # Report
    sys_write(STDOUT_FD, out_path, strlen(out_path));
    sys_write(STDOUT_FD, ": ", 2);
    fmt_int(total_lines);
    sys_write(STDOUT_FD, " lines (v", 9);
    sys_write(STDOUT_FD, pkg_ver, strlen(pkg_ver));
    println(")");
    return 0;
}

# ================================================================
# publish — tag, distlib, and create release
# ================================================================

fn cmd_publish(): i64 {
    var ver = read_file_str("VERSION");
    if (ver == 0) { _err("no VERSION file"); return 1; }

    _status("=== cyrius publish ===");
    sys_write(STDOUT_FD, "  version: ", 11);
    println(ver);

    # Step 1: distlib if manifest has modules
    var mf = "cyrius.cyml";
    if (file_exists(mf) == 0) { mf = "cyrius.toml"; }
    if (file_exists(mf) == 1) {
        var mbuf = alloc(4096);
        var mn = file_read_all(mf, mbuf, 4095);
        if (mn > 0) {
            store8(mbuf + mn, 0);
            var has_modules = 0;
            var mi = 0;
            while (mi < mn) {
                if (memeq(mbuf + mi, "modules", 7) == 1) { has_modules = 1; break; }
                mi = mi + 1;
            }
            if (has_modules == 1) {
                _status("  distlib...");
                # v6.5.19: was a bare `cmd_distlib(0);`. distlib's return value is
                # its bundle self-check verdict (commands.cyr, "the generated
                # bundle does not compile"), and dropping it meant publish printed
                # that error, then went on to `git tag` the release and exit 0.
                # A defective bundle must not get tagged. CHANGELOG [6.5.19].
                var pub_dr = cmd_distlib(0);
                if (pub_dr != 0) {
                    _err("publish: distlib failed — not tagging");
                    return pub_dr;
                }
            }
        }
    }

    # Step 2: lock deps
    _status("  locking deps...");
    cmd_deps_lock();

    # Step 3: git tag
    sys_write(STDOUT_FD, "  tag: v", 8);
    println(ver);

    var tag_sb = str_builder_new();
    str_builder_add_cstr(tag_sb, "git tag -a v");
    str_builder_add_cstr(tag_sb, ver);
    str_builder_add_cstr(tag_sb, " -m 'Release v");
    str_builder_add_cstr(tag_sb, ver);
    str_builder_add_cstr(tag_sb, "'");
    var tag_cmd = str_data(str_builder_build(tag_sb));
    var tr = sys_system(tag_cmd);
    if (tr != 0) {
        _warn("git tag failed (may already exist)");
    }

    # Step 4: push tag
    var push_sb = str_builder_new();
    str_builder_add_cstr(push_sb, "git push origin v");
    str_builder_add_cstr(push_sb, ver);
    var push_cmd = str_data(str_builder_build(push_sb));

    println("");
    println("  Next steps:");
    sys_write(STDOUT_FD, "    git push origin v", 21);
    println(ver);
    println("    # or if CI creates releases automatically, just push the tag");
    println("");
    println("  To create release manually:");
    sys_write(STDOUT_FD, "    gh release create v", 23);
    sys_write(STDOUT_FD, ver, strlen(ver));
    println(" --generate-notes dist/* cyrius.lock");

    return 0;
}
