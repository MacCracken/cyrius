# CLI — commands / distlib: [embed] name collisions.
# ================================================================
# Split from cbt/commands.cyr at 6.7.18, unchanged; cbt/cyrius.cyr includes the pieces in order. CHANGELOG [6.7.18]

# ── [embed] NAME collisions (6.6.19) ───────────────────────────────────────────────────────────
# An [embed] NAME (or NAME_len) that another top-level declaration in scope already owns is
# REFUSED, never left to "last definition wins": in the producer's build the prelude comes FIRST, so
# the stdlib / project definition wins and NAME() silently returns ITS result; in a consumer that
# includes a bundle carrying the embed, the bundle comes AFTER the stdlib, so the embed silently
# REPLACES the stdlib fn (measured: `[embed] vec_new` in a bundle -> `vec: alloc failed`, exit 1,
# and only a `duplicate fn` warning; the distlib self-check passed). Owners checked: every leaf of
# the pinned stdlib snapshot (the D1 index, _distlib_snap_cache) but the project's own fold (6.7.6),
# and the project's own sources —
# `[build] entry`, `[build] modules`, every .cyr under src/ and lib/ (dist/ is the output, never
# an owner). Called once from _embed_load; returns the number refused (each named).
var _emb_hit = 0;

fn _embed_owner_refuse(e, nm, where): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, nm);
    str_builder_add_cstr(sb, " is already declared by ");
    str_builder_add_cstr(sb, where);
    str_builder_add_cstr(sb, "; the generated ");
    str_builder_add_cstr(sb, nm);
    str_builder_add_cstr(sb, "() would silently replace it or be replaced by it (the last definition wins) — in this build and in every consumer of a bundle that carries it; choose another name");
    _embed_refuse(_embed_e_name(e), 0, str_data(str_builder_build(sb)));
    vec_push(_emb_hit, e);
    return 1;
}

# Refuse every entry not yet refused whose NAME / NAME_len is in `set` (a _src_ids set).
fn _embed_owner_check(set, ents, where): i64 {
    var n = 0;
    var i = 0;
    while (i < vec_len(ents)) {
        var e = vec_get(ents, i);
        i = i + 1;
        var seen = 0;
        var k = 0;
        while (k < vec_len(_emb_hit)) { if (vec_get(_emb_hit, k) == e) { seen = 1; } k = k + 1; }
        if (seen == 1) { continue; }
        var nm = _embed_e_name(e);
        var nl = strlen(nm);
        if (_src_ids_has(set, nm, nl) == 1) { n = n + _embed_owner_refuse(e, nm, where); continue; }
        var sb = str_builder_new();
        str_builder_add_cstr(sb, nm);
        str_builder_add_cstr(sb, "_len");
        var ln = str_data(str_builder_build(sb));
        if (_src_ids_has(set, ln, nl + 4) == 1) { n = n + _embed_owner_refuse(e, ln, where); }
    }
    return n;
}

fn _embed_owner_file(path, ents): i64 {
    var got = 0;
    var fb = file_read_whole(path, &got);
    if (fb == 0 || got <= 0) { return 0; }   # unreadable: the compile that includes it names it
    _src_blank_noncode(fb, got);
    var offs = vec_new();
    var lens = vec_new();
    var kinds = vec_new();
    _src_decls(fb, got, offs, lens, kinds);
    var set = _src_ids_new(vec_len(offs) * 8 + 8);
    if (set == 0) { return 0; }
    var k = 0;
    while (k < vec_len(offs)) {
        _src_ids_add(set, fb + vec_get(offs, k), vec_get(lens, k));
        k = k + 1;
    }
    return _embed_owner_check(set, ents, path);
}

# Every .cyr under `dir` (links are not followed; depth-capped like dir_walk).
fn _embed_owner_dir(dir, ents, depth): i64 {
    if (depth > 16 || is_dir(str_from(dir)) != 1) { return 0; }
    var v = vec_new();
    if (dir_list_checked(str_from(dir), v) < 0) { return 0; }
    var n = 0;
    var i = 0;
    while (i < vec_len(v)) {
        var ed = str_data(vec_get(v, i));
        i = i + 1;
        var el = strlen(ed);
        if (el == 0 || load8(ed) == 46) { continue; }
        var fp = _distlib_join(dir, ed);
        if (is_symlink(str_from(fp)) == 1) { continue; }
        if (is_dir(str_from(fp)) == 1) { n = n + _embed_owner_dir(fp, ents, depth + 1); continue; }
        if (el > 4 && memeq(ed + el - 4, ".cyr", 4) == 1) { n = n + _embed_owner_file(fp, ents); }
    }
    return n;
}

fn _embed_collisions(ents): i64 {
    _emb_hit = vec_new();
    var n = 0;
    var root = _distlib_stdlib_root();
    if (root != 0) {
        if (_distlib_snap_cache(root) != 0) { return 1; }
        # ⛔ The leaf named for THIS project ([package] name) is its own fold: a snapshot of these
        # sources plus the modules generated from this very [embed], never in the build's scope
        # beside them — so a NAME it declares is not a collision (sankoch 2.8.3's
        # _brotli_dict_bin, refused by its own fold the release cyrius re-vendored it). Every
        # other leaf still is; src/, [build] and lib/ below still are. CHANGELOG [6.7.6]
        var own = _mf_str("package", "name");
        var i = 0;
        while (i < vec_len(_dl_snap_names)) {
            var lname = vec_get(_dl_snap_names, i);
            var lset = vec_get(_dl_snap_sets, i);
            i = i + 1;
            if (own != 0 && streq(lname, own) == 1) { continue; }
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "the stdlib leaf ");
            str_builder_add_cstr(sb, lname);
            str_builder_add_cstr(sb, " (");
            str_builder_add_cstr(sb, root);
            str_builder_add_cstr(sb, ")");
            n = n + _embed_owner_check(lset, ents, str_data(str_builder_build(sb)));
        }
    }
    var ent = _mf_key_str("build", "entry");
    if (ent != 0) { n = n + _embed_owner_file(ent, ents); }
    var bm = _mf_strs("build", "modules");
    if (bm != 0) {
        var j = 0;
        while (j < vec_len(bm)) { n = n + _embed_owner_file(vec_get(bm, j), ents); j = j + 1; }
    }
    n = n + _embed_owner_dir("src", ents, 0);
    n = n + _embed_owner_dir("lib", ents, 0);
    # 6.7.6: a local-mode resolve vendored into build/local-deps/lib (a --locked one with no vendored
    # lib/, build/locked-deps/lib), which the compile reads first — the overlay this run set
    if (_dep_overlay != 0) { n = n + _embed_owner_dir(_dep_overlay, ents, 0); }
    return n;
}
