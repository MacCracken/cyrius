# CLI — commands / distlib: the named-dep exclude set, `--modular` emission, the requires block.
# ================================================================
# Split from cbt/commands.cyr at 6.7.18, unchanged; cbt/cyrius.cyr includes the pieces in order. CHANGELOG [6.7.18]

# v6.2.51 (closeout refactor): the named-dep exclude set — a captured `lib/X`
# matching a `[deps.X]` block is a fold (resolved transitively), not a stdlib
# leaf. Shared by the sidecar emit + the `--modular` index emit (was duplicated).
fn _distlib_named_deps(mbuf, mlen): i64 {
    # v6.5.28 anchored this to a section header (a `[deps.X]` in comment PROSE registered X —
    # filed from patra, where it silently dropped a real dep from the sidecar). 6.6.20: the
    # resolver's own header pass (`_dep_hdr_name`, cbt/deps/keys.cyr), so a `[deps.X]` inside a `"""`
    # value is not a header either, and `[ deps.X ]` is one — the set `cyrius deps` resolves.
    var named_deps = vec_new();
    var info[32];
    var p = 0;
    while (p < mlen) {
        p = _toml_line(mbuf, mlen, p, &info);
        var hc = 0;
        var nd = _dep_hdr_name(mbuf, mlen, &info, &hc);
        if (nd != 0 && strlen(nd) > 0) { vec_push(named_deps, nd); }
    }
    return named_deps;
}

# v6.2.50 (deps lever 1 / Phase C — module-granular extraction): emit each
# `[lib].modules` entry as its own `dist/<pkg>/<module>.cyr` (src/ self-refs
# stripped → recorded as sibling deps in the index; lib/ kept inline) plus
# `dist/<pkg>/index.cyml` — a `[modular]` map `<module> = [siblings…, "lib:<leaf>"…]`
# giving the resolver each sub-unit's transitive deps in topological order. So a
# consumer (or a v6.3.x lever-2 profile) can pull EXACT sub-modules instead of the
# whole monolith. The flat single-file `cyrius distlib` is unchanged (default).
fn _dl_identch(c): i64 {
    if (c == 95 || (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return 1; }
    return 0;
}

# 1 when buf[0..n) holds the identifier `name` or `name_len` as a whole word.
fn _distlib_mentions(buf, n, name): i64 {
    var nl = strlen(name);
    var i = 0;
    while (i + nl <= n) {
        if (memeq(buf + i, name, nl) == 1) {
            var pre = 0;
            if (i > 0) { pre = _dl_identch(load8(buf + i - 1)); }
            var e = i + nl;
            if (e + 4 <= n && memeq(buf + e, "_len", 4) == 1) {
                if (e + 4 == n || _dl_identch(load8(buf + e + 4)) == 0) { e = e + 4; }
            }
            var post = 0;
            if (e < n) { post = _dl_identch(load8(buf + e)); }
            if (pre == 0 && post == 0) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn _distlib_modular_emit(pkg_name, modules, mbuf, mlen): i64 {
    # the include filename-capture overflow bug: producer-side pkg name (dist/<pkg>/)
    if (_distlib_bad_pkg_name(pkg_name) == 1) { return 1; }
    sys_mkdir("dist", 0x1ED);
    var dir_sb = str_builder_new();
    str_builder_add_cstr(dir_sb, "dist/");
    str_builder_add_cstr(dir_sb, pkg_name);
    var moddir = str_data(str_builder_build(dir_sb));
    sys_mkdir(moddir, 0x1ED);

    var named_deps = _distlib_named_deps(mbuf, mlen);

    var idx = str_builder_new();
    str_builder_add_cstr(idx, "# cyrius distlib --modular index (v6.2.50 Phase C)\n");
    str_builder_add_cstr(idx, "# <module> = [sibling-modules, \"lib:<leaf>\"...] — topological resolve order.\n");
    str_builder_add_cstr(idx, "[modular]\n");

    var count = 0;
    var seen_bases = vec_new();   # v6.2.52: per-pkg basename collision guard
    var mi = 0;
    # 6.6.19 (E3) — each carried [embed] entry is its own sub-module `embed_<NAME>`, with no
    # siblings and no leaves; through seen_bases, so a module file named embed_<NAME>.cyr collides
    # by name instead of overwriting it.
    var ei = 0;
    while (_dl_embed_sel != 0 && ei < vec_len(_dl_embed_sel)) {
        var ee = vec_get(_dl_embed_sel, ei);
        ei = ei + 1;
        var eb_sb = str_builder_new();
        str_builder_add_cstr(eb_sb, "embed_");
        str_builder_add_cstr(eb_sb, _embed_e_name(ee));
        var ebase = str_data(str_builder_build(eb_sb));
        vec_push(seen_bases, ebase);
        var eo_sb = str_builder_new();
        str_builder_add_cstr(eo_sb, moddir);
        str_builder_add_cstr(eo_sb, "/");
        str_builder_add_cstr(eo_sb, ebase);
        str_builder_add_cstr(eo_sb, ".cyr");
        var e_out = str_data(str_builder_build(eo_sb));
        var efd = _aw_open(e_out);
        if (efd == 0) { _err_ctx("distlib --modular: cannot write", e_out); return 1; }
        _aw_write(efd, "# ", 2);
        _aw_write(efd, ebase, strlen(ebase));
        _aw_write(efd, " (cyrius distlib --modular)\n\n", 29);
        var one = vec_new();
        vec_push(one, ee);
        var etn = 0;
        var etx = _embed_render(one, &etn);
        _aw_write(efd, etx, etn);
        if (_aw_commit(efd) != 0) { _err_ctx("distlib --modular: write failed (left as it was)", e_out); return 1; }
        str_builder_add_cstr(idx, ebase);
        str_builder_add_cstr(idx, " = []\n");
        count = count + 1;
    }
    while (mi < vec_len(modules)) {
        var mod_path = vec_get(modules, mi);
        if (file_exists(mod_path) == 0) {
            # v6.2.52 (user: make it fail-loud): a missing module is a HARD ERROR,
            # not a warning — a partial dist silently drops a sub-unit + its index entry.
            _err_ctx("distlib --modular: module not found", _shown(mod_path));   # 6.6.20: shown escaped
            return 1;
        }
        # basename (last path component, strip `.cyr`)
        var bn = mod_path;
        var bi = 0;
        while (load8(mod_path + bi) != 0) {
            if (load8(mod_path + bi) == 47) { bn = mod_path + bi + 1; }
            bi = bi + 1;
        }
        var bnl = strlen(bn);
        if (bnl > 4 && memeq(bn + bnl - 4, ".cyr", 4) == 1) { bnl = bnl - 4; }
        var base = alloc(bnl + 1);
        memcpy(base, bn, bnl);
        store8(base + bnl, 0);
        # v6.2.52 (closeout-deferred): two `[lib].modules` with the same basename in
        # different src/ dirs would overwrite each other's dist/<pkg>/<base>.cyr +
        # emit duplicate index keys (resolver is first-match-wins → silently lost
        # transitive deps). Fail loud instead.
        if (_dep_list_has(seen_bases, base) == 1) {
            _err_ctx("distlib --modular: duplicate module basename collides in dist/", _shown(base));
            return 1;
        }
        vec_push(seen_bases, base);

        var of_sb = str_builder_new();
        str_builder_add_cstr(of_sb, moddir);
        str_builder_add_cstr(of_sb, "/");
        str_builder_add_cstr(of_sb, base);
        str_builder_add_cstr(of_sb, ".cyr");
        # v6.6.6: each module file is written crash-safe and checked — an unwritable one used
        # to be skipped silently, and a short write truncated it, both with exit 0.
        var mod_out = str_data(str_builder_build(of_sb));
        var mfd = _aw_open(mod_out);
        if (mfd == 0) { _err_ctx("distlib --modular: cannot write", _shown(mod_out)); return 1; }
        _aw_write(mfd, "# ", 2);
        _aw_write(mfd, base, strlen(base));
        _aw_write(mfd, " (cyrius distlib --modular)\n\n", 29);

        # v6.4.10: per-module read buffer raised 256KB → 1MB, cycc's input_buf then (it is
        # 24 MB since) — distlib was rejecting modules the compiler compiles fine
        # (shabdakosh's 283KB generated CMUdict). See distlib-per-module-read-cap proposal.
        var fbuf = alloc(1048576);
        var flen = file_read_all(mod_path, fbuf, 1048575);
        if (flen <= 0) { _aw_abort(mfd); mi = mi + 1; continue; }
        # v6.2.51 (closeout): fail loud on a >1MB module — a silent truncation
        # would drop trailing `include`s from the index leaf list → missing-dep SIGILL.
        if (flen >= 1048575 && _file_size(mod_path) > 1048575) {
            _err_ctx("distlib --modular: module exceeds 1024KB read cap (truncated)", _shown(mod_path));
            _aw_abort(mfd);
            return 1;
        }
        store8(fbuf + flen, 0);

        str_builder_add_cstr(idx, base);
        str_builder_add_cstr(idx, " = [");
        var first = 1;

        var pos = 0;
        while (pos < flen) {
            var ls = pos;
            while (pos < flen && load8(fbuf + pos) != 10) { pos = pos + 1; }
            var le = pos;
            if (pos < flen) { pos = pos + 1; }
            var ll = le - ls;
            if (ll >= 8 && memeq(fbuf + ls, "include ", 8) == 1) {
                # src/ sibling-module include → record as a dep + strip
                if (ll >= 13 && memeq(fbuf + ls, "include \"src/", 13) == 1) {
                    var ss = ls + 13;
                    var se = ss;
                    while (se < le && load8(fbuf + se) != 34) { se = se + 1; }
                    var xb = ss;
                    var xi = ss;
                    while (xi < se) { if (load8(fbuf + xi) == 47) { xb = xi + 1; } xi = xi + 1; }
                    var xl = se - xb;
                    if (xl > 4 && memeq(fbuf + se - 4, ".cyr", 4) == 1) { xl = xl - 4; }
                    if (xl > 0) {
                        if (first == 0) { str_builder_add_cstr(idx, ", "); }
                        var xs = alloc(xl + 1); memcpy(xs, fbuf + xb, xl); store8(xs + xl, 0);
                        str_builder_add_cstr(idx, "\"");
                        str_builder_add_cstr(idx, xs);
                        str_builder_add_cstr(idx, "\"");
                        first = 0;
                    }
                    continue;
                }
                # lib/ leaf include → record (unless a named-dep) + KEEP the line
                if (ll >= 13 && memeq(fbuf + ls, "include \"lib/", 13) == 1) {
                    var ks = ls + 13;
                    var ke = ks;
                    while (ke < le && load8(fbuf + ke) != 34) { ke = ke + 1; }
                    var kl = ke - ks;
                    if (kl > 4 && memeq(fbuf + ke - 4, ".cyr", 4) == 1) { kl = kl - 4; }
                    if (kl > 0) {
                        var leaf = alloc(kl + 1); memcpy(leaf, fbuf + ks, kl); store8(leaf + kl, 0);
                        # 6.6.20: the index row is a consumer's `lib:<leaf>`, so it obeys the ONE
                        # leaf rule (_dep_leaf_ok) — this wrote any text between the quotes. Refused
                        # before the index; earlier sub-module files are already committed by here.
                        if (_dep_leaf_ok(leaf) == 0) {
                            var bad_why = "distlib --modular: an include names a stdlib leaf that is not a safe name";
                            _err_ctx(bad_why, _cat2(_shown(leaf), " (allowed: [A-Za-z0-9_/-]) — no index written"));
                            _aw_abort(mfd);
                            return 1;
                        }
                        var is_nd = 0;
                        var ci = 0;
                        while (ci < vec_len(named_deps)) {
                            var ndn = vec_get(named_deps, ci);
                            if (strlen(ndn) == kl) { if (memeq(ndn, leaf, kl) == 1) { is_nd = 1; } }
                            ci = ci + 1;
                        }
                        if (is_nd == 0) {
                            if (first == 0) { str_builder_add_cstr(idx, ", "); }
                            str_builder_add_cstr(idx, "\"lib:");
                            str_builder_add_cstr(idx, leaf);
                            str_builder_add_cstr(idx, "\"");
                            first = 0;
                        }
                    }
                }
            }
            _aw_write(mfd, fbuf + ls, ll);
            _aw_write(mfd, "\n", 1);
        }
        if (_aw_commit(mfd) != 0) {
            _err_ctx("distlib --modular: write failed (left as it was)", _shown(mod_out));
            return 1;
        }
        # 6.6.19 (E3): a module that names a carried embed's accessor lists its sub-module as a
        # sibling, so resolving the module brings the bytes (a comment mention only over-pulls).
        var ej = 0;
        while (_dl_embed_sel != 0 && ej < vec_len(_dl_embed_sel)) {
            var enm = _embed_e_name(vec_get(_dl_embed_sel, ej));
            ej = ej + 1;
            if (_distlib_mentions(fbuf, flen, enm) == 1) {
                if (first == 0) { str_builder_add_cstr(idx, ", "); }
                str_builder_add_cstr(idx, "\"embed_");
                str_builder_add_cstr(idx, enm);
                str_builder_add_cstr(idx, "\"");
                first = 0;
            }
        }
        str_builder_add_cstr(idx, "]\n");
        count = count + 1;
        mi = mi + 1;
    }

    var idx_sb = str_builder_new();
    str_builder_add_cstr(idx_sb, moddir);
    str_builder_add_cstr(idx_sb, "/index.cyml");
    var idx_path = str_data(str_builder_build(idx_sb));
    var idx_str = str_data(str_builder_build(idx));
    if (file_write_atomic(idx_path, idx_str, strlen(idx_str)) != 0) {
        _err_ctx("distlib --modular: write failed (left as it was)", idx_path);
        return 1;
    }

    sys_write(STDOUT_FD, moddir, strlen(moddir));
    sys_write(STDOUT_FD, "/: ", 3);
    fmt_int(count);
    println(" modules + index.cyml");
    return 0;
}

# ⭐ 6.6.18 (D5) — EVERY BUNDLE CARRIES A COMPILE-VERIFIED REQUIRES BLOCK, so a bundle is
# raw-includable: `include "dist/<pkg>.cyr"` and nothing else compiles. Most folds' modules
# include nothing (they rely on `[deps] stdlib` auto-prepend or an umbrella), so nothing
# survived into the bundle: 10 of the 12 vendored folds left 3-207 names undefined included
# alone, and lib/log.cyr / ws.cyr / ws_server.cyr could not include theirs. The block is the
# sidecar as include lines — same leaves, same order (the final verify unit's, so a compiling
# order is reproduced), families expanded by `_distlib_unit_leaf` — written between the
# header lines (which lib_freshness.sh and the fold detector parse) and the first module.
# Named deps are NOT emitted (the consumer decides that path; a profile lands as
# lib/<name>-<prof>.cyr). No leaves, no block. A `cyrius deps` consumer is unaffected:
# include-once is keyed on the literal path, the same lines it auto-prepends.
# The header line that ends the bundle header; the block goes right after it.
var _DL_HDR_END = "# Do not edit -- rebuild with: cyrius distlib\n";
var _DL_REQ_MARK = "# Requires (compile-verified; the leaves of ";

# Rewrite bundle `out_path` with the requires block for `leaves` (named deps skipped). The
# block names `deps_path` (the committed sidecar's path, also under --check). 0, or 1 named.
fn _distlib_write_requires(out_path, deps_path, leaves, named_deps): i64 {
    var root = _distlib_stdlib_root();
    if (root == 0) { _err_ctx("distlib: no stdlib snapshot to expand the requires block — bundle NOT rewritten", out_path); return 1; }
    var blk = str_builder_new();
    var nl = 0;
    var i = 0;
    while (i < vec_len(leaves)) {
        var lf = vec_get(leaves, i);
        i = i + 1;
        if (_distlib_vec_has(named_deps, lf) == 1) { continue; }
        if (_dep_leaf_ok(lf) == 0) {
            var why_lf = "distlib: a sidecar leaf is not a safe include path (allowed: [A-Za-z0-9_/-]) — bundle NOT rewritten";
            _err_ctx(why_lf, _shown(lf));
            return 1;
        }
        # 6.6.18 review: a leaf the snapshot does not have would leave the block SHORT of its
        # sidecar while looking complete — the block == sidecar invariant fails by name instead.
        if (_distlib_unit_leaf(blk, root, lf) == 0) {
            _err_ctx("distlib: a sidecar leaf is not in the stdlib snapshot, so the requires block cannot name it — bundle NOT rewritten", lf);
            return 1;
        }
        nl = nl + 1;
    }
    if (nl == 0) { return 0; }
    var n = 0;
    var b = file_read_whole(out_path, &n);
    if (b == 0 || n <= 0) { _err_ctx("distlib: cannot read the bundle back to add its requires block", out_path); return 1; }
    var hl = strlen(_DL_HDR_END);
    var at = 0 - 1;
    var q = 0;
    while (at < 0 && q + hl <= n) {
        if (memeq(b + q, _DL_HDR_END, hl) == 1) { at = q + hl; }
        q = q + 1;
    }
    if (at < 0) { _err_ctx("distlib: the bundle has no header to place its requires block after", out_path); return 1; }
    var fd = _aw_open(out_path);
    if (fd == 0) { _err_ctx("cannot create", out_path); return 1; }
    _aw_write(fd, b, at);
    _aw_write(fd, "\n", 1);
    _aw_write(fd, _DL_REQ_MARK, strlen(_DL_REQ_MARK));
    _aw_write(fd, deps_path, strlen(deps_path));
    _aw_write(fd, "):\n", 3);
    var bs = str_data(str_builder_build(blk));
    _aw_write(fd, bs, strlen(bs));
    _aw_write(fd, b + at, n - at);
    if (_aw_commit(fd) != 0) {
        _err_ctx("distlib: write failed (previous bundle left as it was)", out_path);
        return 1;
    }
    return 0;
}

# 1 when bundle `path` carries a requires block (a 6.6.18+ bundle with leaves).
fn _distlib_has_requires(path): i64 {
    var n = 0;
    var b = file_read_whole(path, &n);
    if (b == 0 || n <= 0) { return 0; }
    var ml = strlen(_DL_REQ_MARK);
    var q = 0;
    while (q + ml <= n && q < 65536) {
        if (memeq(b + q, _DL_REQ_MARK, ml) == 1) { return 1; }
        q = q + 1;
    }
    return 0;
}
