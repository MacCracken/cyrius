# CLI — commands / distlib: a private peer's dispatcher and the snapshot's declared-name cache.
# ================================================================
# Split from cbt/commands.cyr at 6.7.18, unchanged; cbt/cyrius.cyr includes the pieces in order. CHANGELOG [6.7.18]

# ⛔ A PRIVATE PEER IS NOT THE ANSWER — ITS DISPATCHER IS. `SYS_MMAP` is defined in
# `syscalls_x86_64_linux.cyr`, `syscalls_windows.cyr`, `syscalls_macos.cyr` and
# `syscalls_x86_64_agnos.cyr`, never in `syscalls.cyr` — which is 8 KB of `#ifdef` +
# `include` that selects one of them. So a naive "which file defines this symbol?" answers
# with a per-arch peer, and adding THAT to a sidecar puts Windows syscalls in a Linux build.
# Measured on sigil's `sha` profile: the first cut re-added `syscalls_windows`,
# `syscalls_macos` and `syscalls_x86_64_agnos` and still not `syscalls`.
#
# The convention throughout the tree is that a peer is named `<dispatcher>_<something>`
# (`syscalls` -> `syscalls_x86_64_linux`, `tls_native` -> `tls_native_hs13`) and the
# dispatcher includes it — the same convention the verify's own-identifier set (`_distlib_own_peers`)
# already relies on. Walk the underscore-separated prefixes and return the shortest one that
# is a real leaf AND actually includes this peer; requiring the include is what stops a
# coincidental name prefix from hijacking the answer.
# ⭐ 6.6.11 — AND A PEER OF A PEER. `syscalls_linux_common.cyr` is included by the x86_64-Linux,
# aarch64-Linux and macOS syscalls peers, never by `syscalls.cyr`, so the walk above answered
# `syscalls_linux_common` itself for `AT_EMPTY_PATH` — and once the verify took the per-target
# union (a PE-only undefined symbol is attributed across every declarer) that private helper
# landed in agnodrm's, dhancha's, dhvani's and agnosai's sidecars, putting Linux wrappers in a
# consumer's Windows build. The dispatcher also owns a file one of ITS peers (`<pre>_…`)
# includes. CHANGELOG [6.6.11]

# 1 when the snapshot file root/<file>.cyr contains `include "lib/<leaf>.cyr"`.
fn _distlib_file_includes(root, file, leaf): i64 {
    var fsb = str_builder_new();
    str_builder_add_cstr(fsb, root);
    str_builder_add_cstr(fsb, "/");
    str_builder_add_cstr(fsb, file);
    str_builder_add_cstr(fsb, ".cyr");
    var fp = str_data(str_builder_build(fsb));
    if (file_exists(fp) == 0) { return 0; }
    var n = 0;
    var b = file_read_whole(fp, &n);      # 6.6.9: whole, not _file_size-sized
    if (b == 0 || n <= 0) { return 0; }
    var want = str_builder_new();
    str_builder_add_cstr(want, "include \"lib/");
    str_builder_add_cstr(want, leaf);
    str_builder_add_cstr(want, ".cyr\"");
    var w = str_data(str_builder_build(want));
    var wl = strlen(w);
    var q = 0;
    while (q + wl <= n) {
        if (memeq(b + q, w, wl) == 1) { return 1; }
        q = q + 1;
    }
    return 0;
}

# ⚠ ONLY A PRIVATE ONE. `thread_local.cyr` is also `thread_`-prefixed and included by a
# `thread` peer (thread_macos), but it is a leaf in its own right — patra and tls_native
# include it too — and crediting its symbols to `thread` dropped it from majra's, prakash's,
# szal's and sigil's sidecars. A peer of a peer belongs to the dispatcher only when nothing
# outside that dispatcher's peers includes it. Answers are memoized: this reads the snapshot,
# and the allocator never frees (the v6.6.3 OOM). CHANGELOG [6.6.11]
var _dl_pp_keys = 0;
var _dl_pp_vals = 0;

# 1 when no snapshot file includes root/<leaf>.cyr except `leaf` itself and the `<pre>_…` files.
fn _distlib_only_peers_include(root, pre, leaf): i64 {
    if (_dl_pp_keys == 0) { _dl_pp_keys = vec_new(); _dl_pp_vals = vec_new(); }
    var ksb = str_builder_new();
    str_builder_add_cstr(ksb, pre);
    str_builder_add_cstr(ksb, ":");
    str_builder_add_cstr(ksb, leaf);
    var key = str_data(str_builder_build(ksb));
    var k = 0;
    while (k < vec_len(_dl_pp_keys)) {
        if (streq(vec_get(_dl_pp_keys, k), key) == 1) { return vec_get(_dl_pp_vals, k); }
        k = k + 1;
    }
    var ans = 1;
    var pl = strlen(pre);
    var i = 0;
    while (ans == 1 && _dl_snap_names != 0 && i < vec_len(_dl_snap_names)) {
        var base = vec_get(_dl_snap_names, i);
        i = i + 1;
        var bl = strlen(base);
        if (streq(base, leaf) == 1) { continue; }
        if (bl > pl && memeq(base, pre, pl) == 1 && load8(base + pl) == 95) { continue; }
        if (_distlib_file_includes(root, base, leaf) == 1) { ans = 0; }
    }
    vec_push(_dl_pp_keys, key);
    vec_push(_dl_pp_vals, ans);
    return ans;
}

# 1 when some peer `<pre>_…` that root/<pre>.cyr includes itself includes `leaf`, and nothing
# but those peers does (see above).
fn _distlib_peer_includes(root, pre, leaf): i64 {
    var dsb = str_builder_new();
    str_builder_add_cstr(dsb, root);
    str_builder_add_cstr(dsb, "/");
    str_builder_add_cstr(dsb, pre);
    str_builder_add_cstr(dsb, ".cyr");
    var n = 0;
    var b = file_read_whole(str_data(str_builder_build(dsb)), &n);
    if (b == 0 || n <= 0) { return 0; }
    var pl = strlen(pre);
    var p = 0;
    while (p + 13 + pl < n) {
        if (memeq(b + p, "include \"lib/", 13) == 1 && memeq(b + p + 13, pre, pl) == 1 && load8(b + p + 13 + pl) == 95) {
            var ne = p + 13;
            while (ne < n && load8(b + ne) != 34) { ne = ne + 1; }
            if (ne - (p + 13) > 4 && memeq(b + ne - 4, ".cyr", 4) == 1) {
                var nl = ne - 4 - (p + 13);
                var peer = alloc(nl + 1);
                memcpy(peer, b + p + 13, nl);
                store8(peer + nl, 0);
                if (streq(peer, leaf) == 0) {
                    if (_distlib_file_includes(root, peer, leaf) == 1) {
                        return _distlib_only_peers_include(root, pre, leaf);
                    }
                }
            }
            p = ne;
        }
        p = p + 1;
    }
    return 0;
}

fn _distlib_resolve_dispatcher(root, leaf): i64 {
    # 6.6.18 (D1): a family directory is its own owner — never a `<pre>_…` peer of a flat file.
    if (is_dir(str_from(_distlib_join(root, leaf))) == 1) { return leaf; }
    var ll = strlen(leaf);
    var i = 1;
    while (i < ll) {
        if (load8(leaf + i) == 95) {          # '_'
            var pre = alloc(i + 1);
            memcpy(pre, leaf, i);
            store8(pre + i, 0);
            var dsb = str_builder_new();
            str_builder_add_cstr(dsb, root);
            str_builder_add_cstr(dsb, "/");
            str_builder_add_cstr(dsb, pre);
            str_builder_add_cstr(dsb, ".cyr");
            var dpath = str_data(str_builder_build(dsb));
            if (file_exists(dpath) == 1) {
                var dg = 0;
                var db = file_read_whole(dpath, &dg);   # 6.6.9: whole, not _file_size-sized
                if (db != 0) {
                    if (dg > 0) {
                        var want = str_builder_new();
                        str_builder_add_cstr(want, "include \"lib/");
                        str_builder_add_cstr(want, leaf);
                        str_builder_add_cstr(want, ".cyr\"");
                        var w = str_data(str_builder_build(want));
                        var wl = strlen(w);
                        var q = 0;
                        while (q + wl <= dg) {
                            if (memeq(db + q, w, wl) == 1) { return pre; }
                            q = q + 1;
                        }
                    }
                }
                if (_distlib_peer_includes(root, pre, leaf) == 1) { return pre; }
            }
        }
        i = i + 1;
    }
    return leaf;
}

# Which stdlib leaves DECLARE a name at top level — a fn, a var or an enum member, in any
# spelling the compiler accepts? The index the owner rule (_distlib_symbol_owner) walks.
# v6.6.3 — SNAPSHOT CACHE. The owner lookup used to `dir_list` the whole stdlib
# snapshot and `alloc` + read EVERY `.cyr` file on EVERY call, and the verify loop calls it
# ONCE PER UNDEFINED SYMBOL. cyrius's allocator is an arena that never frees, so the cost
# was O(symbols x snapshot bytes) in RETAINED memory:
#
#     110 files / 7 MB snapshot  x  ~2,900 undefined symbols  =  ~20 GB
#
# Measured on bote 3.3.8's full profile at 6.6.2: peak RSS 20,320 MB under a 20 GB cap
# (rc=139), and 31,214 MB uncapped on a 59 GB box. A standard GitHub runner has ~7 GB, so
# the kernel OOM-killer takes the RUNNER down mid-step — reported as
# `Error: The operation was canceled`, which reads as an infrastructure hiccup rather than
# a toolchain defect, two steps before any assertion runs. It cost a release cut to find.
#
# ⭐ This is why the blow-up tracked the LEAF GRAPH and not module count — the thing that
# scales is the number of symbols left UNDEFINED, not the number of modules. kavach (44
# modules), sankhya (36) and hisab (35) all complete; bote's 30-module full profile dies,
# and its own `core` profile — the same repo, fewer leaves — finishes inside 2 GB.
#
# The cache reads each file ONCE per root, in BYTE ORDER of the entry names (`_dep_name_cmp`, the
# order `cyrius deps` expands a family in). ⛔ NEVER `dir_list` order: every rule that takes
# the first match (the owner rule's in-unit / scope hits, a refusal's candidate list, an
# [embed] collision's named leaf) then answered by the
# FILESYSTEM — tmpfs lists newest-first, ext4 by a per-filesystem name hash — so one producer's
# sidecar differed by host and by TMPDIR. CHANGELOG [6.7.7]
#
# ⛔ 6.6.10 — THE DECLARATION READER IS cbt/srcscan.cyr's `_src_decls`. This matched
# column-0 `fn ` / `var ` / `pub fn ` / … lines, so `#inline fn attrleaf_do`, an indented
# top-level fn and `fn<TAB>name` were invisible: the verify loop classified the symbol as "not
# stdlib" and wrote a profile sidecar WITHOUT its leaf at rc 0 (measured: "0 stdlib leaf
# requirements" for a profile that needs one). Its `private fn` / `private var` arms were dead
# — cycc refuses per-item `private`. Each file's declared names now go into a set once
# (O(1) per symbol), and a file whose braces do not balance — the one way the depth-0 reader
# can lose declarations — contributes its loose `fn X` / `var X` names to
# `_dl_snap_lost`, so such a symbol is a hard error instead of a silent miss.
var _dl_snap_root = 0;
var _dl_snap_names = 0;   # vec of cstr: the LEAF each entry answers for (`alloc`, `unicode`), byte order
var _dl_snap_sets = 0;    # vec of i64: each leaf's _src_ids set of declared names
var _dl_snap_own = 0;     # vec of cstr: each leaf's dispatcher, 0 until asked (_distlib_snap_owner)
var _dl_snap_fold = 0;    # vec of i64: 1 a fold bundle, 0 not, -1 until asked (_distlib_snap_fold)
var _dl_snap_lost = 0;    # _src_ids set: `fn X` / `var X` names in files whose braces do not balance
var _dl_snap_lostf = 0;   # vec of cstr: those files, for the error
var _dl_snap_lostb = 0;   # vec of i64: their (blanked) buffers
var _dl_snap_lostn = 0;   # vec of i64: their lengths

# 0, or -1 after naming why the snapshot could not be read (an unlistable directory or an
# unreadable file: attributing against a partial snapshot would miss symbols in silence).
fn _distlib_snap_cache(root): i64 {
    # Both are C strings. This compared two fresh Str HEADERS as C strings — the data pointers'
    # bytes — so it hit only for the identical pointer and re-read the tree for an equal path.
    # 6.6.13's Str -> cstring diagnostic (I11) named it. CHANGELOG [6.6.13]
    if (_dl_snap_root != 0) { if (streq(_dl_snap_root, root) == 1) { return 0; } }
    var ents = _cbt_list_dir(root, "the sidecar verify cannot attribute symbols");
    if (ents == 0) { return 0 - 1; }
    vec_sort_by(ents, &_dep_name_cmp);
    _dl_snap_names = vec_new();
    _dl_snap_sets = vec_new();
    _dl_snap_own = vec_new();
    _dl_snap_fold = vec_new();
    _dl_snap_lost = _src_ids_new(4096);
    _dl_snap_lostf = vec_new();
    _dl_snap_lostb = vec_new();
    _dl_snap_lostn = vec_new();
    if (_dl_snap_lost == 0) { _err("distlib: out of memory"); return 0 - 1; }
    var i = 0;
    while (i < vec_len(ents)) {
        var e = vec_get(ents, i);
        i = i + 1;
        var ed = str_data(e);
        var el = strlen(ed);
        if (el == 0 || load8(ed) == 46) { continue; }          # '.', '..', dotfiles
        var fp = _distlib_join(root, ed);
        if (el <= 4 || memeq(ed + el - 4, ".cyr", 4) != 1) {
            # ⛔ 6.6.18 (D1) — A FAMILY DIRECTORY (`lib/unicode/`) IS A LEAF TOO. This loop read
            # depth-0 files only, so every family symbol read "not a stdlib symbol" and the
            # verify `continue`d past it: a producer calling unicode_category() without
            # declaring `unicode` published its sidecar SHORT, at rc 0 (niyama's, once the
            # [deps] union stopped hiding it). The owner is the FAMILY name — the spelling a
            # producer declares and `cyrius deps` expands — never a member file: members read
            # their `_*_data` siblings, so a per-file owner would not compile. CHANGELOG [6.6.18]
            if (is_dir(str_from(fp)) == 1) {
                var fset = _distlib_snap_family(fp);
                if (fset < 0) { return 0 - 1; }
                if (fset > 0) {
                    vec_push(_dl_snap_names, ed);
                    vec_push(_dl_snap_sets, fset);
                    vec_push(_dl_snap_own, 0);
                    vec_push(_dl_snap_fold, 0 - 1);
                }
            }
            continue;
        }
        # 6.6.9: read WHOLE. Sized by `_file_size`, every file read as empty on the Windows
        # CLI (-38), so no symbol had an owner and the verify loop was inert there.
        # 6.6.10: an unreadable file is an error by name — it was skipped in silence.
        var got = 0;
        var fb = file_read_whole(fp, &got);
        if (fb == 0) { _err_ctx("distlib: cannot read stdlib file", fp); return 0 - 1; }
        if (got <= 0) { continue; }
        var set = _distlib_snap_index(fb, got, fp, 0);
        if (set == 0) { _err("distlib: out of memory"); return 0 - 1; }
        var lname = alloc(el - 3);
        memcpy(lname, ed, el - 4);
        store8(lname + el - 4, 0);
        vec_push(_dl_snap_names, lname);
        vec_push(_dl_snap_sets, set);
        vec_push(_dl_snap_own, 0);
        vec_push(_dl_snap_fold, 0 - 1);
    }
    _dl_snap_root = root;
    return 0;
}

# One declared-name set for every `.cyr` of family directory `dir` (6.6.18, D1): the union, in
# `_dep_name_cmp` order — the order `cyrius deps` and the verify unit expand it in. Answers the
# set, 0 for a directory with no `.cyr` (not a leaf), or -1 after naming why it was unreadable.
fn _distlib_snap_family(dir): i64 {
    var fents = _cbt_list_dir(dir, "the sidecar verify cannot attribute that family's symbols");
    if (fents == 0) { return 0 - 1; }
    vec_sort_by(fents, &_dep_name_cmp);
    var set = 0;
    var fi = 0;
    while (fi < vec_len(fents)) {
        var fe = str_data(vec_get(fents, fi));
        fi = fi + 1;
        var fel = strlen(fe);
        if (fel <= 4 || memeq(fe + fel - 4, ".cyr", 4) != 1) { continue; }
        var mp = _distlib_join(dir, fe);
        var got = 0;
        var fb = file_read_whole(mp, &got);
        if (fb == 0) { _err_ctx("distlib: cannot read stdlib file", mp); return 0 - 1; }
        if (set == 0) {
            set = _src_ids_new(4096);
            if (set == 0) { _err("distlib: out of memory"); return 0 - 1; }
        }
        if (got <= 0) { continue; }
        if (_distlib_snap_index(fb, got, mp, set) == 0) { _err("distlib: out of memory"); return 0 - 1; }
    }
    return set;
}

# The declared-name set of one snapshot file (buffer fb[0, n), blanked here in place — the
# cache owns it), added to `into` (a family's shared set) or to a fresh set when `into` is 0.
# Adds the file to the "lost" index when its braces do not balance. 0 on OOM.
fn _distlib_snap_index(fb, n, fp, into): i64 {
    _src_blank_noncode(fb, n);
    var offs = vec_new();
    var lens = vec_new();
    var kinds = vec_new();
    var bal = _src_decls(fb, n, offs, lens, kinds);
    var set = into;
    if (set == 0) { set = _src_ids_new(vec_len(offs) * 8); }
    if (set == 0) { return 0; }
    var k = 0;
    while (k < vec_len(offs)) {
        var kd = vec_get(kinds, k);
        if (kd == SRC_DECL_FN || kd == SRC_DECL_VAR || kd == SRC_DECL_MEMBER) {
            if (_src_ids_add(set, fb + vec_get(offs, k), vec_get(lens, k)) != 0) { return 0; }
        }
        k = k + 1;
    }
    if (bal != 0) {
        if (_src_ids_add_decl_tokens(_dl_snap_lost, fb, n) != 0) { return 0; }
        vec_push(_dl_snap_lostf, fp);
        vec_push(_dl_snap_lostb, fb);
        vec_push(_dl_snap_lostn, n);
    }
    return set;
}

# The unbalanced snapshot file that spells `fn <name>` / `var <name>` somewhere, or 0.
fn _distlib_snap_lost_decl(name): i64 {
    if (_dl_snap_lost == 0) { return 0; }
    var nl = strlen(name);
    if (_src_ids_has(_dl_snap_lost, name, nl) == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_dl_snap_lostf)) {
        var one = _src_ids_new(1024);
        if (one == 0) { return vec_get(_dl_snap_lostf, i); }
        _src_ids_add_decl_tokens(one, vec_get(_dl_snap_lostb, i), vec_get(_dl_snap_lostn, i));
        if (_src_ids_has(one, name, nl) == 1) { return vec_get(_dl_snap_lostf, i); }
        i = i + 1;
    }
    return 0;
}
