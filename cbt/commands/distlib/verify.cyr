# CLI — commands / distlib: an undefined symbol's owner, the verify's fixpoint rounds, the leaf hints.
# ================================================================
# Split from cbt/commands.cyr at 6.7.18, unchanged; cbt/cyrius.cyr includes the pieces in order. CHANGELOG [6.7.18]

# ⚖️ THE OWNER OF AN UNDEFINED SYMBOL — ONE RULE, whether every target or only some left it
# undefined. Crediting the first snapshot file that declares it (what a host-only verify did) is
# wrong once the union is taken: mihi's EINTR is undefined on PE only (syscalls_windows lacks
# it), and `sigil.cyr` sorts before every syscalls peer, so the first declarer would put the sigil
# monolith in mihi's sidecar on EVERY host. ⛔ The every-target path kept "the first non-fold
# declarer in byte order" until 6.7.11: a tie between two leaves was settled by their names, and
# an in-unit declarer first in byte order added nothing (the name fell to D2's warning). It asks
# this helper too now (user, 2026-10-13). So, over every declarer, each mapped to its dispatcher:
#   - one ALREADY IN THIS ROUND'S UNIT (a leaf it was built from, the scope it was built with,
#     or a named dep) is SKIPPED: the target still left the name undefined, so that declarer
#     demonstrably does not define it there. ⛔ 6.6.18 (D3): this answered "the target's own
#     gap, nothing to add" — mabda includes lib/syscalls.cyr, whose peers declare O_RDWR, but
#     on agnos only lib/io.cyr's agnos arm defines it, so `io` was never found;
#   - one recorded THIS round (not compiled yet) => next round's unit decides: answers 1 with
#     `_dl_own_raw` = 0; one put in the unit-only scope this round is returned as the owner, so
#     the caller's scope rule still applies to it;
#   - else, among the out-of-unit declarers, FOLD BUNDLES (a distlib header) drop out whenever
#     any NON-fold file declares the name, in the unit or not — the 6.6.11 mihi rule: EINTR is
#     undefined on PE, its only out-of-unit declarer is the sigil fold, and a fold's copy is
#     never the answer when the name has a real home — and the declarers that are a
#     dispatcher's PEER name that target's canonical definer: exactly one dispatcher => it;
#   - else exactly one non-peer declarer => it;
#   - else (two or more candidates either way) it is a named refusal: answers -1, and the
#     sidecar is not written. CHANGELOG [6.7.11]
# Answers 0 when no out-of-unit declarer exists (the name is then reported by D2's warning),
# 1 with `_dl_own_raw` / `_dl_own_owner` set otherwise. `mask` / `all_mask`: the targets that
# left it undefined, and every target this round compiled (the refusal names which). `unit_n` /
# `scope0`: the leaves and the scope this round's unit was built from (leaves only ever grow, so
# its first `unit_n`).
var _dl_own_raw = 0;
var _dl_own_owner = 0;

# 1 when snapshot leaf root/<raw>.cyr is a fold BUNDLE (a `cyrius distlib` / bundle.sh header in
# its first 2 KB). Read through a stack buffer: this runs per candidate, and a whole-file read
# of a 1 MB fold would be retained by the arena for every call.
fn _distlib_is_fold(root, raw): i64 {
    var fsb = str_builder_new();
    str_builder_add_cstr(fsb, _distlib_join(root, raw));
    str_builder_add_cstr(fsb, ".cyr");
    var fd = sys_open(str_data(str_builder_build(fsb)), O_RDONLY, 0);
    if (fd < 0) { return 0; }
    var hb[2048];
    var n = sys_read(fd, &hb, 2048);
    sys_close(fd);
    var q = 0;
    while (q + 28 <= n) {
        if (memeq(&hb + q, "Generated by: cyrius distlib", 28) == 1) { return 1; }
        if (memeq(&hb + q, "Bundled distribution of", 23) == 1) { return 1; }
        q = q + 1;
    }
    return 0;
}

# Drop the fold-bundle entries of the parallel vecs (`flags` 1 = fold) when `nonfold` (a
# non-fold declarer exists); answers how many remain.
fn _distlib_drop_folds(a, b, flags, nonfold): i64 {
    if (nonfold == 0) { return vec_len(a); }
    var w = 0;
    var i = 0;
    while (i < vec_len(flags)) {
        if (vec_get(flags, i) == 0) {
            vec_set(a, w, vec_get(a, i));
            if (b != 0) { vec_set(b, w, vec_get(b, i)); }
            w = w + 1;
        }
        i = i + 1;
    }
    while (vec_len(a) > w) { vec_pop(a); }
    if (b != 0) { while (vec_len(b) > w) { vec_pop(b); } }
    return w;
}

# The dispatcher snapshot leaf `i` resolves to, and whether it is a fold bundle — each read once
# per snapshot: every undefined name asks this for every declarer, and the allocator never
# frees (the v6.6.3 OOM: resolving reads dispatcher files whole).
fn _distlib_snap_owner(root, i): i64 {
    var o = vec_get(_dl_snap_own, i);
    if (o == 0) {
        o = _distlib_resolve_dispatcher(root, vec_get(_dl_snap_names, i));
        vec_set(_dl_snap_own, i, o);
    }
    return o;
}

fn _distlib_snap_fold(root, i): i64 {
    var f = vec_get(_dl_snap_fold, i);
    if (f < 0) {
        f = _distlib_is_fold(root, vec_get(_dl_snap_names, i));
        vec_set(_dl_snap_fold, i, f);
    }
    return f;
}

fn _distlib_symbol_owner(root, nm, mask, all_mask, leaves, named_deps, scope, unit_n, scope0): i64 {
    _dl_own_raw = 0;
    _dl_own_owner = 0;
    var nlen = strlen(nm);
    var peer_raw = vec_new();
    var peer_own = vec_new();
    var peer_fold = vec_new();
    var solo = vec_new();
    var solo_fold = vec_new();
    var nonfold = 0;
    var i = 0;
    while (i < vec_len(_dl_snap_names)) {
        var set = vec_get(_dl_snap_sets, i);
        var raw = vec_get(_dl_snap_names, i);
        var si = i;
        i = i + 1;
        if (_src_ids_has(set, nm, nlen) == 0) { continue; }
        var fold = _distlib_snap_fold(root, si);
        if (fold == 0) { nonfold = 1; }
        var owner = _distlib_snap_owner(root, si);
        # In this round's unit already, and the name is still undefined there: not its definer.
        if (_distlib_vec_has(named_deps, owner) == 1) { continue; }
        if (_distlib_vec_has_n(leaves, unit_n, owner) == 1 || _distlib_vec_has_n(leaves, unit_n, raw) == 1) { continue; }
        if (_distlib_vec_has(scope0, owner) == 1 || _distlib_vec_has(scope0, raw) == 1) { continue; }
        # Recorded this round, not compiled yet: the next round's unit answers.
        if (_distlib_vec_has(leaves, owner) == 1 || _distlib_vec_has(leaves, raw) == 1) { return 1; }
        # In the unit-only scope this round: the caller's scope rule decides (it never outranks "ours").
        if (_distlib_vec_has(scope, owner) == 1 || _distlib_vec_has(scope, raw) == 1) {
            _dl_own_raw = raw;
            _dl_own_owner = owner;
            return 1;
        }
        if (streq(owner, raw) == 0) {
            if (_distlib_vec_has(peer_own, owner) == 0) { vec_push(peer_own, owner); vec_push(peer_raw, raw); vec_push(peer_fold, fold); }
        } elif (_distlib_vec_has(solo, raw) == 0) { vec_push(solo, raw); vec_push(solo_fold, fold); }
    }
    _distlib_drop_folds(peer_own, peer_raw, peer_fold, nonfold);
    _distlib_drop_folds(solo, 0, solo_fold, nonfold);
    if (vec_len(peer_own) == 1) {
        _dl_own_raw = vec_get(peer_raw, 0);
        _dl_own_owner = vec_get(peer_own, 0);
        return 1;
    }
    var cands = peer_own;
    if (vec_len(peer_own) == 0) {
        if (vec_len(solo) == 0) { return 0; }
        if (vec_len(solo) == 1) {
            _dl_own_raw = vec_get(solo, 0);
            _dl_own_owner = _dl_own_raw;
            return 1;
        }
        cands = solo;
    }
    var rsb = str_builder_new();
    str_builder_add_cstr(rsb, "distlib: sidecar verify: '");
    str_builder_add_cstr(rsb, nm);
    if (mask == all_mask) {
        str_builder_add_cstr(rsb, "' is undefined on every target, and more than one stdlib leaf could own it (");
    } else {
        str_builder_add_cstr(rsb, "' is undefined only on ");
        _distlib_add_targets(rsb, mask);
        str_builder_add_cstr(rsb, ", and more than one stdlib leaf could own it there (");
    }
    var k = 0;
    while (k < vec_len(cands)) {
        if (k > 0) { str_builder_add_cstr(rsb, ", "); }
        str_builder_add_cstr(rsb, vec_get(cands, k));
        k = k + 1;
    }
    str_builder_add_cstr(rsb, ") — include the right leaf from a bundled module. Sidecar NOT written");
    _err(str_data(str_builder_build(rsb)));
    return 0 - 1;
}

fn _distlib_verify_rounds(leaves, out_path, named_deps, root, m): i64 {
    var added_total = 0;
    var scope = vec_new();                # in the unit, not recorded (see below)
    var round = 0;
    while (round < 6) {                   # a fixpoint in practice converges in 1-2
        round = round + 1;
        # ⛔ NEVER AN ABSOLUTE `include`. An entry built from `include "<abs path>"` is
        # rejected outright — "absolute include path rejected ... set
        # CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 to permit" — which is the absolute-include path bug hardening and
        # must not be weakened for a convenience check. Measured: the first cut of this loop
        # captured 227 bytes of stderr that were entirely those rejections, so it saw zero
        # undefined symbols and silently re-added nothing while looking like it worked. The
        # includes below are RELATIVE: the mirror (the lib/ overlay — the pinned snapshot minus what
        # ./lib holds) and ./lib answer them (_distlib_mirror_make). Which lines a leaf adds is read
        # from the snapshot itself.
        var esb = str_builder_new();
        var unit_n = vec_len(leaves);         # D3: what THIS round's unit is built from
        var scope0 = vec_new();
        var s0 = 0;
        while (s0 < vec_len(scope)) { vec_push(scope0, vec_get(scope, s0)); s0 = s0 + 1; }
        var li = 0;
        while (li < vec_len(leaves)) {
            var lf = vec_get(leaves, li);
            li = li + 1;
            # A leaf that is a NAMED DEP is the consumer's pinned module, included below.
            if (_distlib_vec_has(named_deps, lf) == 1) { continue; }
            _distlib_unit_leaf(esb, root, lf);
        }
        # Leaves taken in only because a named dep's own leaf list brings them (see the
        # classification below): in the unit, never recorded.
        var si = 0;
        while (si < vec_len(scope)) {
            _distlib_unit_leaf(esb, root, vec_get(scope, si));
            si = si + 1;
        }
        if (_dep_nd_modules != 0) {
            var mi = 0;
            while (mi < vec_len(_dep_nd_modules)) {
                str_builder_add_cstr(esb, "include \"");
                str_builder_add_cstr(esb, vec_get(_dep_nd_modules, mi));
                str_builder_add_cstr(esb, "\"\n");
                mi = mi + 1;
            }
        }
        if (_distlib_splice_file(esb, out_path) != 0) {
            return _distlib_verify_fail("distlib: sidecar verify cannot read the bundle", out_path);
        }
        var entry = _distlib_join(m, "entry.cyr");
        var esrc = str_data(str_builder_build(esb));
        # In the mirror's root, so the kill handler unlinks it before it removes the mirror (a
        # name; the tree walk only knows the snapshot copy). CHANGELOG [6.7.13]
        _cbt_scratch_track(entry);
        if (file_write_all(entry, esrc, strlen(esrc)) < 0) {
            xunlink(entry);
            _cbt_scratch_untrack(entry);
            return _distlib_verify_fail("distlib: sidecar verify cannot write its compile unit", entry);
        }
        # One compile per target; `masks[i]` says which targets left `names[i]` undefined.
        var names = vec_new();
        var masks = vec_new();
        var vt = _distlib_verify_targets(entry, out_path, names, masks);
        xunlink(entry);
        _cbt_scratch_untrack(entry);
        if (vt != 0) { return 0 - 1; }
        if (vec_len(names) == 0) { return added_total; }
        var all_mask = (1 << _DL_TGT_N) - 1;
        # D3: an agnos compile that failed without a symbol reported nothing, so "every
        # target" means the five that did — else every name would read as partial.
        if (_dl_agnos_skip == 1) { all_mask = all_mask - (1 << _DL_TGT_AGNOS); }
        var own = 0;
        var added_here = 0;
        var recorded_here = 0;
        # 6.6.10: a snapshot that cannot be read in full cannot attribute anything — every
        # symbol would read "not stdlib" and the sidecar would be written short, at rc 0.
        if (_distlib_snap_cache(root) != 0) {
            var snm = "distlib: sidecar verify cannot read the stdlib snapshot — sidecar NOT written";
            return _distlib_verify_fail(snm, root);
        }
        var ni = 0;
        while (ni < vec_len(names)) {
            var nm = vec_get(names, ni);
            var nmask = vec_get(masks, ni);
            ni = ni + 1;
            # On every target or only some: one owner rule (_distlib_symbol_owner).
            var po = _distlib_symbol_owner(root, nm, nmask, all_mask, leaves, named_deps, scope, unit_n, scope0);
            if (po < 0) { return 0 - 1; }
            if (po == 1 && _dl_own_raw == 0) { continue; }   # already in the unit
            var raw = _dl_own_raw;
            var owner = _dl_own_owner;
            if (raw == 0) {
                # Not a stdlib symbol — the consumer's problem — UNLESS the snapshot does declare
                # it somewhere the depth-0 reader could not place (6.6.10). That used to be this
                # same silent `continue`: the leaf was never recorded and the sidecar was
                # written, wrong, at rc 0. A hard error now, naming the file.
                var lost = _distlib_snap_lost_decl(nm);
                if (lost != 0) {
                    var lsb = str_builder_new();
                    str_builder_add_cstr(lsb, "distlib: sidecar verify: '");
                    str_builder_add_cstr(lsb, nm);
                    str_builder_add_cstr(lsb, "' is declared in a stdlib file whose braces do not balance,");
                    str_builder_add_cstr(lsb, " so its top-level declarations cannot be read reliably");
                    str_builder_add_cstr(lsb, " — sidecar NOT written");
                    return _distlib_verify_fail(str_data(str_builder_build(lsb)), lost);
                }
                continue;
            }
            # Never a named dep: its symbols belong to the consumer's pinned module.
            if (_distlib_vec_has(named_deps, owner) == 1) { continue; }
            if (_distlib_vec_has(leaves, owner) == 1) { continue; }
            # A named dep's leaf list may name the PEER itself (`hd_impl`), not the
            # dispatcher the owner resolves to (`hd`): either one counts. So does a leaf one of
            # those leaves brings by its OWN include (6.7.12: `tagged` → `boxed`), as `cyrius deps`
            # vendors it for that dep — it was recorded as the bundle's, so a pure module's
            # sidecar read `boxed`. The bundle's own use is still recorded (below), as for a
            # listed leaf. CHANGELOG [6.7.12]
            var brought = 0;
            if (_distlib_vec_has(_dep_nd_leaves, owner) == 1) { brought = owner; }
            elif (_distlib_vec_has(_dep_nd_leaves, raw) == 1) { brought = raw; }
            elif (_distlib_vec_has(_distlib_nd_closure(root), owner) == 1) { brought = owner; }
            elif (_distlib_vec_has(_distlib_nd_closure(root), raw) == 1) { brought = raw; }
            var scoped = _distlib_vec_has(scope, owner);
            if (scoped == 0 && brought != 0) { scoped = _distlib_vec_has(scope, brought); }
            if (scoped == 1 || brought != 0) {
                if (own == 0) {
                    own = _distlib_own_ids(leaves, named_deps, out_path, root);
                    if (own == 0) {
                        var oim = "distlib: sidecar verify cannot index the bundle — sidecar NOT written";
                        return _distlib_verify_fail(oim, out_path);
                    }
                }
                if (_src_ids_has(own, nm, strlen(nm)) == 0) {
                    if (scoped == 0) {
                        vec_push(scope, brought);
                        added_here = added_here + 1;
                        if (_verbose == 1) { _distlib_verify_trace(round, "in scope (a named dep's)", nm, nmask, brought); }
                    }
                    continue;
                }
            }
            if (_verbose == 1) { _distlib_verify_trace(round, "recorded", nm, nmask, owner); }
            vec_push(leaves, owner);
            added_here = added_here + 1;
            recorded_here = recorded_here + 1;
            added_total = added_total + 1;
        }
        if (added_here == 0) {                           # fixpoint: nothing new to add
            if (_distlib_embed_unlisted(out_path, names) > 0) { return 0 - 1; }
            _distlib_report_unowned(out_path, names, masks);
            return added_total;
        }
        if (recorded_here > 0) { scope = vec_new(); }   # (2) above
    }
    # ⛔ THE CAP IS NOT A FIXPOINT. Falling out of the loop means the last round ADDED leaves that
    # were never compiled, so the set is unverified. This returned `added_total`, the same answer
    # as real convergence, and an 8-leaf chain published 6 leaves as "compile-verified" at rc 0.
    # A bigger cap would only move the failure one leaf further out. CHANGELOG [6.6.11]
    return _distlib_verify_fail("distlib: sidecar verify did not converge in 6 rounds — sidecar NOT written", out_path);
}

# 6.7.12 — the transitive include closure, in the snapshot `root`, of the stdlib leaves `cyrius
# deps` pulled for named deps (`_dep_nd_leaves`): each leaf, every leaf its file includes (the
# resolver's own rule, `_dep_stdlib_inc_names`, cbt/deps.cyr — so it is the set the resolve
# vendored for those deps), and so on; a family directory's members are walked and the family
# name itself is in the set. Built once per snapshot (the verify asks for every name it
# classifies). CHANGELOG [6.7.12]
var _dl_ndc = 0;
var _dl_ndc_root = 0;

fn _distlib_nd_closure(root): i64 {
    if (_dl_ndc != 0 && streq(_dl_ndc_root, root) == 1) { return _dl_ndc; }
    var out = vec_new();
    var q = vec_new();
    if (_dep_nd_leaves != 0) {
        var i = 0;
        while (i < vec_len(_dep_nd_leaves)) { vec_push(q, vec_get(_dep_nd_leaves, i)); i = i + 1; }
    }
    var qi = 0;
    while (qi < vec_len(q)) {
        var nm = vec_get(q, qi);
        qi = qi + 1;
        if (_distlib_vec_has(out, nm) == 1) { continue; }
        vec_push(out, nm);
        _distlib_nd_closure_step(root, nm, q);
    }
    _dl_ndc = out;
    _dl_ndc_root = root;
    return out;
}

# Queue onto `q` what leaf `nm` brings: the includes of root/<nm>.cyr that the snapshot holds, or
# each member of the family directory root/<nm>/; and a family member's family.
fn _distlib_nd_closure_step(root, nm, q): i64 {
    var sl = 0;
    while (load8(nm + sl) != 0 && load8(nm + sl) != 47) { sl = sl + 1; }
    if (load8(nm + sl) == 47) {
        var fam = alloc(sl + 1);
        memcpy(fam, nm, sl);
        store8(fam + sl, 0);
        vec_push(q, fam);
    }
    var fp = _cat2(_distlib_join(root, nm), ".cyr");
    if (file_exists(fp) == 1) {
        var n = 0;
        var b = file_read_whole(fp, &n);
        if (b == 0 || n <= 0) { return 0; }
        var incs = _dep_stdlib_inc_names(b, n);
        var k = 0;
        while (k < vec_len(incs)) {
            var inc = vec_get(incs, k);
            k = k + 1;
            if (file_exists(_cat2(_distlib_join(root, inc), ".cyr")) == 1) { vec_push(q, inc); }
        }
        return 0;
    }
    var dp = _distlib_join(root, nm);
    if (is_dir(str_from(dp)) == 0) { return 0; }
    var ents = dir_list(dp);
    var e = 0;
    while (e < vec_len(ents)) {
        var ed = str_data(vec_get(ents, e));
        e = e + 1;
        var el = strlen(ed);
        if (el > 4 && memeq(ed + el - 4, ".cyr", 4) == 1) {
            var stem = alloc(el - 3);
            memcpy(stem, ed, el - 4);
            store8(stem + el - 4, 0);
            vec_push(q, _distlib_join(nm, stem));
        }
    }
    return 0;
}

# ⚠ 6.6.18 (D2) — NAME WHAT THE CONVERGED VERIFY COULD NOT OWN. A name no stdlib leaf, named
# dep or bundled module defines was a silent `continue` above ("the consumer's problem"), so a
# short sidecar and a bundle that calls a consumer-supplied hook looked the same: niyama's
# family symbols and mabda's agnos-only O_RDWR both published at rc 0 with nothing said. Every
# name still undefined in the final round is listed with the targets it fails on. A WARNING:
# the exit status is unchanged, because a bundle may deliberately call a consumer's hook.
# CHANGELOG [6.6.18]
fn _distlib_report_unowned(out_path, names, masks): i64 {
    var n = vec_len(names);
    if (n == 0 || _quiet == 1) { return 0; }
    var all_mask = (1 << _DL_TGT_N) - 1;
    if (_dl_agnos_skip == 1) { all_mask = all_mask - (1 << _DL_TGT_AGNOS); }   # as the rounds do
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "warn: distlib: ");
    str_builder_add_cstr(sb, out_path);
    str_builder_add_cstr(sb, ": ");
    str_builder_add_int(sb, n);
    str_builder_add_cstr(sb, " name(s) still undefined after the sidecar verify converged — the bundle, its leaves and its named deps' modules use them, and no stdlib leaf defines them there (a consumer must supply them, or something is short):\n");
    var i = 0;
    while (i < n && i < 40) {
        str_builder_add_cstr(sb, "  ");
        str_builder_add_cstr(sb, vec_get(names, i));
        str_builder_add_cstr(sb, " (");
        var mk = vec_get(masks, i);
        if (mk == all_mask) { str_builder_add_cstr(sb, "every target"); }
        else { _distlib_add_targets(sb, mk); }
        str_builder_add_cstr(sb, ")\n");
        i = i + 1;
    }
    if (n > 40) {
        str_builder_add_cstr(sb, "  ... and ");
        str_builder_add_int(sb, n - 40);
        str_builder_add_cstr(sb, " more\n");
    }
    var msg = str_data(str_builder_build(sb));
    sys_write(STDERR_FD, msg, strlen(msg));
    return 0;
}

# 6.6.18 — for each undefined name in a failed compile's captured stderr, name the stdlib leaf
# that defines it (see _cc_own_err_begin, cbt/build.cyr). Uses the distlib snapshot index (D1:
# families included), the dispatcher rule (a peer's symbol is its dispatcher's) and the fold
# rule (a fold bundle is named only when nothing else declares the name). Silent when there is
# no snapshot, no undefined name, or no stdlib declarer.
fn _cc_undef_hints(path): i64 {
    var n = 0;
    var b = file_read_whole(path, &n);
    if (b == 0 || n <= 0) { return 0; }
    var names = vec_new();
    _distlib_collect_undefined(b, n, names);
    if (vec_len(names) == 0) { return 0; }
    var root = _distlib_stdlib_root();
    if (root == 0) { return 0; }
    if (_distlib_snap_cache(root) != 0) { return 0; }
    var i = 0;
    var shown = 0;
    while (i < vec_len(names) && shown < 12) {
        var nm = vec_get(names, i);
        i = i + 1;
        var own = _cc_hint_owner(root, nm);
        if (own == 0) { continue; }
        # Already auto-prepended: the leaf is in scope and does not define it HERE (an #ifdef
        # arm) — "add it" would be wrong advice.
        if (_cc_hint_in_scope(own) == 1) { continue; }
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "hint: '");
        str_builder_add_cstr(sb, nm);
        str_builder_add_cstr(sb, "' is defined by stdlib leaf '");
        str_builder_add_cstr(sb, own);
        str_builder_add_cstr(sb, "' — add it to [deps] stdlib in cyrius.cyml\n");
        var m = str_data(str_builder_build(sb));
        sys_write(STDERR_FD, m, strlen(m));
        shown = shown + 1;
    }
    return 0;
}

# 1 when `lib/<leaf>.cyr` (or a member of `lib/<leaf>/`) is already in the auto-prepend list.
fn _cc_hint_in_scope(leaf): i64 {
    if (_dep_includes == 0) { return 0; }
    var ll = strlen(leaf);
    var i = 0;
    while (i < vec_len(_dep_includes)) {
        var inc = vec_get(_dep_includes, i);
        i = i + 1;
        var il = strlen(inc);
        if (il >= ll + 5 && memeq(inc, "lib/", 4) == 1 && memeq(inc + 4, leaf, ll) == 1) {
            var c = load8(inc + 4 + ll);
            if (c == 47) { return 1; }
            if (c == 46 && il == ll + 8) { return 1; }
        }
    }
    return 0;
}

# The stdlib leaf that defines `nm` for a hint, or 0: the declarers mapped to their dispatchers,
# folds dropped while a non-fold declares it, then — if several remain — the one `nm` is
# prefixed with (`sakshi_span_enter` -> sakshi), else the candidates joined "a' or 'b".
fn _cc_hint_owner(root, nm): i64 {
    var nlen = strlen(nm);
    var cands = vec_new();
    var folds = vec_new();
    var nonfold = 0;
    var i = 0;
    while (i < vec_len(_dl_snap_names)) {
        var raw = vec_get(_dl_snap_names, i);
        var set = vec_get(_dl_snap_sets, i);
        i = i + 1;
        if (_src_ids_has(set, nm, nlen) == 0) { continue; }
        var owner = _distlib_resolve_dispatcher(root, raw);
        if (_distlib_vec_has(cands, owner) == 1) { continue; }
        var f = _distlib_is_fold(root, raw);
        if (f == 0) { nonfold = 1; }
        vec_push(cands, owner);
        vec_push(folds, f);
    }
    _distlib_drop_folds(cands, 0, folds, nonfold);
    if (vec_len(cands) == 0) { return 0; }
    if (vec_len(cands) == 1) { return vec_get(cands, 0); }
    var k = 0;
    while (k < vec_len(cands)) {
        var c = vec_get(cands, k);
        var cl = strlen(c);
        if (cl < nlen && memeq(nm, c, cl) == 1 && load8(nm + cl) == 95) { return c; }
        k = k + 1;
    }
    var sb = str_builder_new();
    k = 0;
    while (k < vec_len(cands) && k < 3) {
        if (k > 0) { str_builder_add_cstr(sb, "' or '"); }
        str_builder_add_cstr(sb, vec_get(cands, k));
        k = k + 1;
    }
    return str_data(str_builder_build(sb));
}

fn _distlib_stdlib_root(): i64 {
    if (_home == 0) { return 0; }
    var pin = _dep_read_cyml_cyrius_field();
    if (pin != 0) {
        var psb = str_builder_new();
        str_builder_add_cstr(psb, _home);
        str_builder_add_cstr(psb, "/versions/");
        str_builder_add_cstr(psb, pin);
        str_builder_add_cstr(psb, "/lib");
        var pr = str_data(str_builder_build(psb));
        if (is_dir(str_from(pr)) == 1) { return pr; }
    }
    var gsb = str_builder_new();
    str_builder_add_cstr(gsb, _home);
    str_builder_add_cstr(gsb, "/lib");
    var gr = str_data(str_builder_build(gsb));
    if (is_dir(str_from(gr)) == 1) { return gr; }
    return 0;
}
