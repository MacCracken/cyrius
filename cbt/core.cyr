
# ================================================================
# Global state
# ================================================================

var _cc = 0;
var _cc_arm = 0;
var _arch = 0;
var _defines = 0;
var _pass = 0;
var _fail = 0;
var _total = 0;
var _tests_found = 0;   # v6.0.62: `cyrius tests` recursive-walk found-a-.tcyr flag
var _tools_dir = 0;
var _scripts_dir = 0;
var _repo_root = 0;
var _version = 0;
var _home = 0;
var _envp = 0;
# v5.11.25: per-repo isolation Part 2. Set to 1 if CYRIUS_RESOLVED=1
# is in the environment (= we already re-exec'd into the pinned
# toolchain; loop guard for `_try_redirect_to_pinned`).
var _cyrius_resolved = 0;
var _verbose = 0;
var _quiet = 0;
# v6.5.50 — how many of `cyrius build`'s two paths came from [build] in ./cyrius.cyml
# rather than the command line (0 = both explicit, 1 = output only, 2 = both). v6.5.49 let
# them be omitted, which meant the build line named paths the user never typed with no way
# to tell where they came from; the log now says so.
var _build_paths_from_manifest = 0;
var _dry_run = 0;
var _lib_sync_full = 0;   # v6.2.40: `cyrius lib sync --full` opt-in (whole snapshot)
var _check_lib_sync = 0;  # v6.4.63: `--check-lib-sync` — stale ./lib/ is an ERROR (CI gate)
var _dep_includes = 0;
# 6.6.9: vec<cstr> of the NAMED-DEP module files `cyrius deps` placed in lib/ (a subset of
# _dep_includes — the stdlib-leaf pushes are not in it). `cyrius distlib`'s verify splices them,
# so a symbol the bundle takes from a named dep is defined, as it is in a consumer's build.
var _dep_nd_modules = 0;
# 6.6.9: vec<cstr> of the stdlib leaves `cyrius deps` pulled ON BEHALF OF named deps (their
# `.deps` sidecars, `requires` keys and modular `lib:` entries). In a consumer's build they are in
# scope through the named dep, so distlib's verify splices them WITHOUT recording them — else a
# named dep's own needs are written into the bundle's sidecar.
var _dep_nd_leaves = 0;
# v5.7.14: transitive dep resolution state.
# _dep_visited: vec<cstr> of dep names already resolved (closest-wins skip).
# _dep_queue:   vec<cstr> of absolute manifest dirs whose own [deps.X]
#               sections still need to be walked. BFS drain in cmd_deps.
var _dep_visited = 0;
var _dep_queue = 0;
# 6.6.13 (I10b): count of [deps.X] blocks that declare no `modules` / `modular` and whose
# tag or path ships no `dist/<X>.cyr` — each is warned by name and counted in the
# `deps resolved` summary (`, N vendored nothing`). Reset per cmd_deps.
var _dep_inert = 0;
# the release-integrity hardening item (v6.2.30): vec<cstr> of resolved git-dep commit pins accumulated
# during cmd_deps. Each entry: "commit\t<40hex>\t<name>\t<git>\t<tag>".
# cmd_deps_lock appends them to cyrius.lock (after the per-file hash lines);
# resolution verifies a TAGGED dep's freshly-resolved HEAD against the prior
# lock to detect a force-pushed/repointed tag or a poisoned cached clone.
var _dep_commit_lines = 0;
# 6.7.6 (lane C) — GIT FIRST, LOCAL DEVELOPMENT BY AN EXPLICIT SWITCH. A `[deps.X] path` beside
# `git` / `tag` is a DEV OVERRIDE, read only in LOCAL MODE: `--local[=a,b]` > `--no-local` >
# CYRIUS_LOCAL (1, 0 or a name list) > off — the manifest never switches it on. With no switch every
# machine builds the tag. cbt/deps.cyr "local mode" has the whole rule; these are the run's state.
var _dep_local_on = 0;       # the switch is on (and not forced off by --locked or a release verb)
var _dep_local_names = 0;    # 0 = every declared override; else a vec of the selected names
var _dep_local_active = 0;   # an override IS in use: this resolve vendors into build/local-deps/lib
var _dep_vroot = "lib";      # where this resolve WRITES vendored files (include strings stay lib/…)
var _dep_locked = 0;         # --locked / CYRIUS_LOCKED=1: resolve, compare, write nothing
var _build_modules = 0;
# 6.6.19: the [embed] entries every compile carries (cbt/manifest.cyr _embed_load; 0 = none).
# _materialize_source renders them before `#@srcline`. A bundle verify clears it so the bundle
# is checked ALONE (cbt/commands.cyr).
var _embeds = 0;
# v5.7.8: when set, compile() skips the manifest-dep auto-prepend.
# Used by `cyrius check` (default-on) and `cyrius build --no-deps`.
var _skip_deps = 0;
# v5.7.8 P5: lockfile is written by default after every successful
# `cyrius deps`. _no_lock = 1 suppresses the write for that run.
var _no_lock = 0;
# v6.6.4: `cyrius deps --relock` — explicitly ACCEPT a stdlib leaf whose bytes in the
# pinned snapshot moved while `[package].cyrius` did not. Without it the resolver refuses
# to vendor or re-lock that leaf (see _dep_lock_guard_stdlib_leaf in cbt/deps.cyr).
var _dep_relock = 0;
# v6.6.4: cyrius.lock as it stood at cmd_deps ENTRY — read once, before any copy, so the
# guard compares against the lock this run inherited, not the one it is about to write.
var _dep_lock_buf = 0;
var _dep_lock_len = 0;
var _dep_lock_pin_same = 0;   # 1 iff the lock's `cyrius\t<pin>` line equals this run's pin
var _dep_lock_refused = 0;    # leaves the guard refused this run; folded into `errors`
var _dep_lock_has_trailer = 0;   # 1 iff the loaded lock carried a `cyrius\t<pin>` line (else it is re-written once to gain one)
# 6.6.9 bite 9: 1 iff this resolve vendored a lib/ file the loaded lock has NO line for — a
# newly declared stdlib leaf, or any leaf when there is no lock yet (a stdlib-only project's
# FIRST lock). Either way the lock would not cover lib/, so it is written. Only set outside
# the cyrius source repo (`_dep_lock_active`), which never writes a lock.
var _dep_lock_new_leaf = 0;
var _dep_lock_active = 0;
# 6.6.9: 1 while cmd_deps writes a lock ONLY because of `_dep_lock_new_leaf`. A lock that cannot
# be HASHED then is a named warning, not a failed resolve: before 6.6.9 no lock was attempted
# at all in that case, and a host with no working hasher (wine has no certutil) must not
# lose every stdlib-only build to it. `deps --verify` still names each uncovered file.
var _dep_lock_soft = 0;
# 6.6.17 — when non-zero, the vec of lib/ paths `cyrius lib sync` wrote: cmd_deps_lock then
# re-hashes only those and keeps every other file's loaded row byte for byte.
var _dep_lock_only = 0;
# The verb the stdlib-leaf guard's refusal names in its `--relock` advice.
var _dep_lock_guard_verb = "deps";
# v5.11.58: --strict-pin flag — when 1, compile() augments the
# child's envp with CYRIUS_STRICT_PIN=1 so cycc's pin-drift check
# (added v5.11.57) exits non-zero on mismatch instead of warning.
# CI path for pin-faithful builds.
var _strict_pin = 0;
# v5.11.63: --strict flag — when 1, compile() passes --strict to
# cycc/cycc_aarch64 in argv. NO EFFECT since 6.3.2: a reachable
# undefined fn is an error by default (`--allow-undef` downgrades it)
# and no compiler fork reads the flag; it is passed through so old CI
# lines keep working. `cyrius build --help` says the same.
var _strict = 0;
# v6.5.14: internal-only — makes compile() pass cycc `--allow-undef`. Set by the
# `distlib` bundle self-check, which EXPECTS undefined fns (a bundle deliberately
# omits the stdlib; the consumer supplies it) and needs every OTHER failure to
# stay a failure. Not user-facing: no CLI flag sets it.
var _cc_allow_undef = 0;
# v6.5.19: internal-only — makes compile() pass cycc `--syntax-only`. Set by
# `cmd_lint`'s pre-pass and by nothing else; the binary it produces is deliberately
# wrong and is unlinked immediately. See _syntax_only in src/common/util.cyr.
var _cc_syntax_only = 0;
# v6.0.49: `cyrius build --agnos` → inject CYRIUS_TARGET_AGNOS=1 into cycc's
# envp so it emits an AGNOS ring-3 binary (the flag is not in the user's
# environment, so the env var must be added explicitly — same mechanism as --strict-pin).
var _agnos_target = 0;
# v6.5.29: `cyrius fuzz --poison` → inject CYRIUS_POISON=1 into cycc's envp so the harness is
# compiled with lib/freelist.cyr's poison mode ON — fl_alloc/fl_free blocks ONLY (fill +
# redzone + quarantine-on-free; alloc(), arenas and allocator seams are not instrumented, and a
# redzone overwrite is counted by fl_poison_violations(), not trapped). Same env-inject
# mechanism as --agnos/--win. ⛔ The mode has to arrive at COMPILE time, not run time:
# `lib/freelist.cyr` depends on syscalls + mmap + atomic only and must not read the environment,
# so `#ifdef CYRIUS_POISON` is how it learns. Filed by sit — `cyrius fuzz` could not observe
# an out-of-bounds READ at all, because a read into mapped memory raises nothing.
var _poison_mode = 0;
# 6.6.18 (poison-8): `cyrius fuzz --poison=ab` — every harness is compiled and run TWICE, fill
# 0xA5 then 0x5A (the B leg gets `#define CYRIUS_POISON_B`, which lib/poison.cyr reads), and must
# exit 0 both times with byte-identical stdout. A read of a redzone or of freed memory prints the
# fill, so the legs diverge: an OVERREAD becomes visible without the harness asserting anything.
var _poison_ab = 0;
# v6.0.52: `cyrius build --win` → inject CYRIUS_TARGET_WIN=1 so cycc cross-emits
# a Windows PE32+ (win_amd64) from Linux/macOS — same env-inject mechanism as
# --agnos. Fills the Linux→Windows cross-build gap (cycc_win runs only ON Windows;
# wheels.yml's win job built native-only). x86_64 target (no set_arch change).
var _win_target = 0;
# v6.1.12: `cyrius build --target=js` → route to cycc's `--emit-js` (the v6.1.11
# TS/TSX → browser-JS emitter) instead of the native-binary compile path. This is
# a different invocation model (path-arg in, JS to stdout — see _emit_js in
# build.cyr), not an env-injected emit target like --agnos/--win. x86-Linux-only
# (the TS frontend is x86-Linux-only). See CHANGELOG [6.1.12].
var _js_target = 0;
# v6.4.x cx arc: `cyrius build --target=cx` → route to the cx bytecode compiler
# fork (cycc_cx, built from src/main_cx.cyr) instead of the native compile path.
# Like the aarch64 cross-compiler this is a SEPARATE binary (not an --emit flag on
# cycc): cycc_cx reads .cyr from stdin, writes .cyx to stdout. Resolved into _cc_cx
# (tools dir / ./build / JIT-built on demand — the cross_bins "rebuilt on demand"
# model). Portable bytecode target; the runtime is cxvm. See CHANGELOG [cx arc].
var _cx_target = 0;
var _cc_cx = 0;
var _cxvm = 0;   # the cx bytecode VM (built from programs/cxvm.cyr); runs .cyx files
# v6.2.27: `cyrius build --target=<arch>-bare-metal-elf` — the first-class
# bare-metal triple. A NAMED front-end over the existing kmode (`kernel;`) +
# CYRIUS_ELF64_KERNEL env knobs: build.cyr injects CYRIUS_KERNEL=1 (forces
# kernel_mode so no source `kernel;` is needed) + CYRIUS_ELF64_KERNEL=1. The
# `_aa` variant routes to the aarch64 cross-compiler. See roadmap .27 (D1).
var _baremetal_target = 0;
var _baremetal_aa = 0;
# v6.3.3 #5: a `[sections] base = "0x.."` key in cyrius.cyml sets the kernel ELF
# load/link base. compile() parses it (bare-metal builds only) into this env-string
# pointer ("CYRIUS_KERNEL_BASE=0x..", or 0 when absent) and appends it to the cycc
# env alongside CYRIUS_KERNEL — cycc's _parse_hex_env folds it into _kernel_load_base.
# Absent block -> 0 -> built-in base -> byte-identical. The manifest surface of
# issues/archived/2026-06-19-kernel-load-base-settable.md.
var _section_base_env_ptr = 0;
# v6.3.3 #5: the numeric kernel base parsed from `[sections] base` (0 = default /
# absent). Drives the D6 build-report line so an overridden build prints its REAL
# entry/base instead of the canonical literal — the whole point of the D6 report
# (surface the true e_entry, no drift).
var _section_base_val = 0;
# v6.3.1 (dependency-model arc, lever 2 — required vs optional deps):
# `cyrius build --features a,b` populates _cli_features (vec<cstr> of requested
# feature names); `--no-default-features` sets _cli_no_default. The dep resolver
# (cbt/deps.cyr) reads these to decide which `optional = true` deps to fetch and
# whether to apply the `[features]` `default = [...]` set. Parsed by a pre-scan in
# cyrius.cyr BEFORE _auto_deps runs — the resolver fires ahead of each subcommand's
# own flag loop. 0/0 = today's behavior (no optional dep activated unless named).
var _cli_features = 0;
var _cli_no_default = 0;

# ================================================================
# Output helpers — consistent error/warn/info/status
# ================================================================

# v6.6.6 (bite 24d) — IS THERE AN UNTERMINATED PROGRESS LINE ON STDOUT?
# `cmd_build` deliberately leaves `compile a.cyr -> out [x86_64] ` open so the `OK` lands
# on the same line. When the verb then failed with a NAMED error, the error was spliced
# into that line — `... [x86_64] error: could not rename ...` — which reads as one
# corrupted line rather than a diagnostic, and the `FAILED` that follows then looks like
# it belongs to the error text. The line is the caller's to close, so the caller marks it
# open and `_err`/`_err_ctx` close it before writing. Deliberately STDOUT: that is where
# the open line is; closing it on stderr would leave it open. CHANGELOG [6.6.6].
var _progress_open = 0;

fn _progress_close(): i64 {
    if (_progress_open == 0) { return 0; }
    _progress_open = 0;
    sys_write(STDOUT_FD, "\n", 1);
    return 0;
}

# v6.6.6 (bite 24 review) — HOW MANY NAMED DIAGNOSTICS THE CLI HAS PRINTED ITSELF.
# A caller samples it around a fallible step and compares afterwards, so a failure cbt
# already NAMED is not then attributed to something else. `cmd_build` is the first user:
# bite 24a's rename refusal made it print `FAILED (compiler exit 1)` and "the compiler's
# diagnostics are above" for a compiler that had exited 0 and written nothing. Monotonic
# and never reset, so nested users cannot clobber each other. CHANGELOG [6.6.6].
var _err_count = 0;

# Error: always prints to stderr
fn _err(msg): i64 {
    _progress_close();
    _err_count = _err_count + 1;
    sys_write(STDERR_FD, "error: ", 7);
    sys_write(STDERR_FD, msg, strlen(msg));
    sys_write(STDERR_FD, "\n", 1);
    return 0;
}

# Error with context: "error: msg: ctx"
fn _err_ctx(msg, ctx): i64 {
    _progress_close();
    _err_count = _err_count + 1;
    sys_write(STDERR_FD, "error: ", 7);
    sys_write(STDERR_FD, msg, strlen(msg));
    sys_write(STDERR_FD, ": ", 2);
    sys_write(STDERR_FD, ctx, strlen(ctx));
    sys_write(STDERR_FD, "\n", 1);
    return 0;
}

# List directory `dir` (a cstr) for a caller whose RESULT depends on seeing all of it — a
# test run, an audit, a coverage count, a lock, a copy. Returns the vec of entry names, or 0
# after naming the failure: "error: cannot list directory: <dir> (error N) — <what>". It
# counts in _err_count, so a verb can sample that around a walk and fail on it.
# ⛔ 6.6.10 — `dir_list` answers an EMPTY vec for a directory it cannot read, so every walker
# here passed over an unreadable subtree in silence: `chmod 000 tests/bad` made `cyrius test`
# report "1 passed, 0 failed", `cyrius audit` "ok: lint clean", `cyrius coverage` 100 % for a
# 50 % tree. `what` says what the failure cost ("its tests were NOT run"). CHANGELOG [6.6.10]
fn _cbt_list_dir(dir, what): i64 {
    var v = vec_new();
    var r = dir_list_checked(str_from(dir), v);
    if (r >= 0) { return v; }
    _progress_close();
    _err_count = _err_count + 1;
    sys_write(STDERR_FD, "error: cannot list directory: ", 30);
    sys_write(STDERR_FD, dir, strlen(dir));
    sys_write(STDERR_FD, " (error ", 8);
    fmt_int_fd(STDERR_FD, 0 - r);
    sys_write(STDERR_FD, ") — ", 6);
    sys_write(STDERR_FD, what, strlen(what));
    sys_write(STDERR_FD, "\n", 1);
    return 0;
}

# `find_files_checked` for a walker whose verdict depends on seeing every file: the matching
# paths, with every directory the walk could not list named as _cbt_list_dir names one (and
# counted in _err_count — sample it around the call). CHANGELOG [6.6.10]
fn _cbt_find_files(dir, ext, what): i64 {
    var failed = vec_new();
    var m = find_files_checked(str_from(dir), str_from(ext), failed);
    var i = 0;
    while (i < vec_len(failed)) {
        var d = vec_get(failed, i);
        _progress_close();
        _err_count = _err_count + 1;
        sys_write(STDERR_FD, "error: cannot list directory: ", 30);
        sys_write(STDERR_FD, str_data(d), str_len(d));
        sys_write(STDERR_FD, " — ", 5);
        sys_write(STDERR_FD, what, strlen(what));
        sys_write(STDERR_FD, "\n", 1);
        i = i + 1;
    }
    return m;
}

# Warning: prints to stderr unless --quiet
fn _warn(msg): i64 {
    if (_quiet == 1) { return 0; }
    sys_write(STDERR_FD, "warn: ", 6);
    sys_write(STDERR_FD, msg, strlen(msg));
    sys_write(STDERR_FD, "\n", 1);
    return 0;
}

# Info: prints to stderr unless --quiet. Lower-severity than
# `_warn`; use for diagnostics that aren't actionable (e.g.
# informational notes attached to a successful command).
fn _info(msg): i64 {
    if (_quiet == 1) { return 0; }
    sys_write(STDERR_FD, msg, strlen(msg));
    sys_write(STDERR_FD, "\n", 1);
    return 0;
}

# Status: prints to stdout unless --quiet
fn _status(msg): i64 {
    if (_quiet == 1) { return 0; }
    sys_write(STDOUT_FD, msg, strlen(msg));
    sys_write(STDOUT_FD, "\n", 1);
    return 0;
}

# ================================================================
# Crash-safe streamed replace of a file the user or the tree owns
# ================================================================
# `_aw_open(path)` opens a unique sibling temp (lib/io.cyr's `_io_tmp_name`); `_aw_write`
# loops every write to completion and makes any failure STICKY; `_aw_commit` fsyncs, closes
# and renames the temp over `path` only if every write landed — otherwise it unlinks the temp
# and `path` is left exactly as it was. A short write is an ERROR, never a truncated file.
# ⛔ v6.6.6: cyrius.lock, the vendored lib/<dep>.cyr copy, and every `cyrius distlib` output
# were written `open(O_TRUNC)` + unchecked `sys_write`s — on a full disk the user's file was
# truncated and the verb still exited 0. CHANGELOG [6.6.6]
# Handle layout (32 B): +0 fd, +8 temp path, +16 target path, +24 sticky error.
fn _aw_open(path): i64 {
    # 6.6.20: created EXCLUSIVELY (lib/io.cyr `_io_tmp_open`) — the plain O_TRUNC open here
    # followed a symlink planted at the predictable temp name. CHANGELOG [6.6.20]
    var fd = 0;
    var tmp = _io_tmp_open(path, &fd);
    if (tmp == 0) {
        if (fd == 0 - 17) {
            _err_ctx("every temp name beside it is taken (a file or link sits there), refusing to write via one", path);
        }
        return 0;
    }
    _io_keep_mode(fd, path);   # an existing file keeps its permission bits (lib/io.cyr)
    var h = alloc(32);
    store64(h, fd);
    store64(h + 8, tmp);
    store64(h + 16, path);
    store64(h + 24, 0);
    return h;
}

fn _aw_write(h, buf, len): i64 {
    if (load64(h + 24) != 0) { return 0 - 1; }
    var off = 0;
    while (off < len) {
        var w = file_write(load64(h), buf + off, len - off);
        if (w <= 0) { store64(h + 24, 1); return 0 - 1; }
        off = off + w;
    }
    return 0;
}

# `_aw_open` for a file the USER owns (cyrius.lock): a symlink there is written THROUGH — the
# file it names is replaced and the link stays — as the open(O_TRUNC) this replaced did. The
# vendored lib/<dep>.cyr copy must NOT use this: a symlinked vendored file is the v6.5.37
# corruption (a write through it lands in the shared stdlib), so it keeps plain `_aw_open`,
# which replaces the link. CHANGELOG [6.6.6]
# ⛔ 6.6.20 (the committed-symlink write bug): `path` is a file of the PROJECT (the cwd), so its link is followed only to
# a file inside it (lib/io.cyr _io_replace_target_in) — a committed `cyrius.lock -> ~/.profile`
# made every auto-deps verb replace ~/.profile. A refusal is printed here, by name, and is 0.
fn _aw_open_replace(path): i64 {
    var real = _io_replace_target_in(".", path);
    if (real < 0) {
        _io_contain_refusal("error");
        return 0;
    }
    return _aw_open(real);
}

# Give up: nothing is replaced, the temp is removed.
fn _aw_abort(h): i64 { store64(h + 24, 1); return _aw_commit(h); }

# 0 = `path` now holds every byte written; < 0 = nothing replaced, temp removed.
fn _aw_commit(h): i64 {
    var fd = load64(h);
    var tmp = load64(h + 8);
    if (load64(h + 24) != 0) { file_close(fd); xunlink(tmp); return 0 - 1; }
    xfsync(fd);
    if (file_close(fd) < 0) { xunlink(tmp); return 0 - 1; }
    if (file_rename(tmp, load64(h + 16)) < 0) { xunlink(tmp); return 0 - 1; }
    return 0;
}

var ARCH_X86 = 0;
var ARCH_AARCH64 = 1;

# ================================================================
# Path helpers
# ================================================================

# Build a path: dir + "/" + name (C strings)
# ⭐ v6.5.42 — THE DIRECTORY THIS WRAPPER BINARY ITSELF LIVES IN, or 0 if argv(0) carries no
# path (invoked bare off $PATH, where there is nothing to be relative to).
#
# THE DEFECT THIS EXISTS FOR. `find_tools()` derived `cycc` from `$CYRIUS_HOME`/`$HOME` and
# NOTHING else, so `~/.cyrius/versions/6.5.32/bin/cyrius` resolved `~/.cyrius/bin/cycc` — the
# CURRENT compiler — while its own sibling `versions/6.5.32/bin/cycc` sat right there. A
# versioned toolchain therefore compiled with whatever cycc happened to be installed, and a
# manifest pin was not binding on the compiler at all. Proven semantically, not cosmetically:
# a program built through the 6.5.32 wrapper produced output byte-identical to cycc 6.5.39's
# and exercised 6.5.39 semantics on a discriminator built from the v6.5.36 enum Critical.
#
# ⚠ v6.5.37 made this STRICTLY WORSE rather than adjacent: it fixed `_try_redirect_to_pinned`
# so the pin redirect now fires for essentially every consumer, which means consumers reliably
# got the pinned WRAPPER and the CURRENT COMPILER — the mismatch became the default path.
#
# ⛔ WINDOWS: THE EXE'S OWN PATH, NOT argv(0), AND BOTH SEPARATORS. argv(0) there is whatever
# the parent wrote — `C:\cyrius\bin\cyrius.exe`, or `Z:\…\bin\cyrius.exe` under wine, or a bare
# `cyrius` found on PATH — and the scan below looked for '/' only, so on every Windows spelling
# this answered 0: the wrapper never saw its own bin/ and fell through to `%CYRIUS_HOME%\bin`
# (measured under wine: `bin/cyrius.exe audit` printed "skip: cyrlint not built" with
# cyrlint.exe beside it). GetModuleFileNameW is always the absolute path of this .exe; it is
# normalised to '/' (Win32 accepts it, and make_path joins with '/'). CHANGELOG [6.6.9]
fn _wrapper_dir(): i64 {
    var a0 = argv(0);
    #ifdef CYRIUS_TARGET_WIN
    a0 = _wrapper_exe_win(a0);
    #endif
    if (a0 == 0) { return 0; }
    var last = 0 - 1;
    var i = 0;
    while (load8(a0 + i) != 0) {
        if (load8(a0 + i) == 47) { last = i; }
        i = i + 1;
    }
    # No '/' at all means we were found on $PATH by bare name. There is no sibling to prefer,
    # and guessing one from the CWD would be worse than falling through to the installed path.
    if (last < 1) { return 0; }
    var sb = str_builder_new();
    var j = 0;
    while (j < last) {
        str_builder_putc(sb, load8(a0 + j));
        j = j + 1;
    }
    return str_data(str_builder_build(sb));
}

# The NUL-terminated UTF-16 string `wbuf` of `wn` code units as a fresh UTF-8 cstr, or 0.
# ⚠ SIZED FROM `wn`, NOT A FIXED BUFFER: `_args_w2u8` silently DROPS any code point that does
# not fit, and one UTF-16 unit is up to 3 UTF-8 bytes (a surrogate pair's 4 span 2 units), so
# a fixed 4096 truncated a long non-ASCII path — 2000 CJK units need 6000 bytes — and no
# length check can see it afterwards. `+ 6`: w2u8 writes a code point only while 5 bytes
# remain. Host-testable; exercised by tests/gates/toolchain/cli_pe_file_size_and_sibling_tools.sh.
# CHANGELOG [6.6.9]
fn _wrapper_w2u8(wbuf, wn): i64 {
    if (wn <= 0) { return 0; }
    var cap = wn * 3 + 6;
    var ubuf = alloc(cap);
    var b = _args_w2u8(wbuf, ubuf, cap);
    if (b <= 1) { return 0; }
    return ubuf;
}

#ifdef CYRIUS_TARGET_WIN
# This .exe's absolute path with '\' rewritten to '/', from GetModuleFileNameW; `a0` (argv(0),
# likewise normalised) when that fails. 0 only when both are absent. A full buffer is a
# failure, not a length (GetModuleFileNameW truncates silently — see cyrius-init's
# `_self_path_win`). CHANGELOG [6.6.9]
fn _wrapper_exe_win(a0): i64 {
    var p = 0;
    var wbuf = alloc(8192);
    var wn = sys_self_exe_w(wbuf, 4096);
    if (wn > 0 && wn < 4096) {
        store8(wbuf + wn * 2, 0);
        store8(wbuf + wn * 2 + 1, 0);
        p = _wrapper_w2u8(wbuf, wn);
    }
    if (p == 0) {
        if (a0 == 0) { return 0; }
        var al = strlen(a0);
        p = alloc(al + 1);
        memcpy(p, a0, al + 1);
    }
    var i = 0;
    while (load8(p + i) != 0) {
        if (load8(p + i) == 92) { store8(p + i, 47); }
        i = i + 1;
    }
    return p;
}
#endif

fn make_path(dir, name): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, name);
    var result = str_builder_build(sb);
    return str_data(result);
}

# v6.6.5 — resolve a SIBLING TOOL by name, with the Windows `.exe` arm.
#
# ⛔ THE DEFECT: every tool the CLI spawns resolved as `make_path(_tools_dir, "cyrlint")`
# — no suffix — while `scripts/build-windows-tarball.sh` ships `bin/cyrlint.exe`, and
# `run_tool_vec` refuses on `file_exists(tool) == 0` BEFORE it ever reaches
# CreateProcess. So on the shipped Windows layout `cyrius lint` could only ever print
# `error: tool not found: …\bin\cyrlint`. `_ccname`/`_sn` above already carry exactly
# this arm for `cycc` alone (v6.0.85) — the pattern existed and was applied to one
# binary out of nine. Measured under wine at 6.6.5.
#
# Probe-then-fall-back rather than a hard suffix: a Windows DEV tree builds
# `build/cyrlint` with no extension (the name is just where the shell redirected), and
# the tarball ships `.exe`. Both must resolve. Non-Windows is byte-identical to the old
# `make_path` call it replaces. CHANGELOG [6.6.5].
fn _tool_path(dir, name): i64 {
    var plain = make_path(dir, name);
    #ifdef CYRIUS_TARGET_WIN
    var sb = str_builder_new();
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, ".exe");
    var exe = make_path(dir, str_data(str_builder_build(sb)));
    if (file_exists(exe) == 1) { return exe; }
    #endif
    return plain;
}

# Read file contents into allocated buffer, null-terminate, return ptr
# Returns 0 on failure
fn read_file_str(path): i64 {
    var buf = alloc(4096);
    var n = file_read_all(path, buf, 4095);
    if (n <= 0) { return 0; }
    # Trim trailing whitespace
    while (n > 0) {
        var c = load8(buf + n - 1);
        if (c == 10) { n = n - 1; }
        elif (c == 13) { n = n - 1; }
        elif (c == 32) { n = n - 1; }
        else { break; }
    }
    store8(buf + n, 0);
    return buf;
}

# ================================================================
# Environment passthrough
# ================================================================

# `_envp` is the envp every POSIX `sys_execve` in the CLI passes (cycc, test binaries,
# git, the hasher, /bin/sh, ssh). It must be the WHOLE environment: a variable it drops is
# silently absent in every child. 6.6.11 (J4/J6): this read /proc/self/environ into a fixed
# 8,192-byte buffer, so on Linux every variable past 8 KB was dropped and the one straddling
# the cut truncated; and on macOS, which has no /proc, the open failed and `_envp` was an
# EMPTY vector — children ran with no PATH, HOME, TMPDIR or CYRIUS_*. Now Linux reads to EOF
# into a growing buffer, and macOS takes the kernel's own entry-stack envp (`_macho_envp`),
# NULL-terminated and live for the whole process, with no copy and no cap. CHANGELOG [6.6.11]
fn load_environ(): i64 {
    #ifdef CYRIUS_TARGET_MACOS
    _envp = _macho_envp();
    if (_envp != 0) { return 0; }
    #endif
    var cap = 16384;
    var buf = alloc(cap);
    var n = 0;
    var fd = file_open("/proc/self/environ", 0, 0);
    if (fd >= 0) {
        var more = 1;
        while (more == 1) {
            if (n == cap - 1) {
                var nb = alloc(cap * 2);
                memcpy(nb, buf, n);
                buf = nb;
                cap = cap * 2;
            }
            var r = file_read(fd, buf + n, cap - 1 - n);
            if (r <= 0) { more = 0; } else { n = n + r; }
        }
        file_close(fd);
    }
    if (n <= 0) {
        _envp = alloc(8);
        store64(_envp, 0);
        return 0;
    }
    store8(buf + n, 0);
    var count = 0;
    var i = 0;
    while (i < n) {
        count = count + 1;
        while (i < n) {
            if (load8(buf + i) == 0) { i = i + 1; break; }
            i = i + 1;
        }
    }
    _envp = alloc((count + 1) * 8);
    var ei = 0;
    i = 0;
    while (i < n) {
        store64(_envp + ei * 8, buf + i);
        ei = ei + 1;
        while (i < n) {
            if (load8(buf + i) == 0) { i = i + 1; break; }
            i = i + 1;
        }
    }
    store64(_envp + ei * 8, 0);
    return 0;
}

# ================================================================
# Tool discovery
# ================================================================

#ifdef CYRIUS_TARGET_MACOS
# macOS has no /proc/self/environ. The kernel's envp array follows argv on the
# entry stack (base parked in x28 / r15 by the Mach-O entry prologue, read via
# args_macos._macho_argv_base). Returns that NULL-terminated char**, or 0.
# Factored out of `_macho_fill_environ` at 6.6.11 so `load_environ` can hand it to
# children as `_envp` directly. CHANGELOG [6.6.11]
fn _macho_envp(): i64 {
    #ifdef CYRIUS_ARCH_AARCH64
    # arm64: argv is a char** parked at [x28+8]; envp follows argv+NULL.
    var base = _macho_argv_base();
    if (base == 0) { return 0; }
    var m_argc = load64(base);
    var m_argvp = load64(base + 8);
    return m_argvp + (m_argc + 1) * 8;
    #else
    # x86: the LC_UNIXTHREAD init stack is inline — [rsp]=argc, argv[i] at
    # rsp+8+i*8, then a NULL, then envp. So envp = init_rsp + 8 + (argc+1)*8.
    # v6.4.59: read the init rsp from _macho_argv_base() (r15, reserved from
    # regalloc since v6.1.30) — the SAME source argc()/argv() use. Previously this
    # read the _macho_init_rsp global, which was set only by the (now-retired)
    # _macho_capture_args path that ran AFTER the gvar-init that already called
    # main() → 0, so env-read returned 0, HOME was never found, _home defaulted to
    # /root, and cycc-finding failed on Intel (found on ach:
    # `/root/.cyrius/bin/cycc_aarch64` not found).
    var ir = _macho_argv_base();
    if (ir == 0) { return 0; }
    var m_argc = load64(ir);
    return ir + 8 + (m_argc + 1) * 8;
    #endif
}

# Flatten the entry-stack envp into buf as NUL-separated NAME=VALUE so
# find_tools' scan works unchanged. Returns total bytes written. v6.0.34.
#
# ⛔ Returns at most cap - 1, and every entry in buf is WHOLE: the callers write their own
# terminator at `buf + returned`, so that byte must be inside the buffer. An entry that
# does not fit with its NUL is dropped (pos rewinds to its start) and the scan goes on, so
# a truncated "HOME=/Us" is never matched and a smaller HOME after one huge variable still
# is. Through 6.6.11 only the payload bytes were bounded: each entry's NUL was stored
# unconditionally, so a >32 KB environment returned pos > cap and every caller's
# `store8(eb + en, 0)` landed past its allocation. CHANGELOG [6.6.12]
fn _macho_fill_environ(buf, cap): i64 {
    var envp = _macho_envp();
    if (envp == 0) { return 0; }
    if (cap < 1) { return 0; }
    var pos = 0;
    var i = 0;
    var e = load64(envp);
    while (e != 0) {
        var start = pos;
        var k = 0;
        while (load8(e + k) != 0 && pos < cap - 1) {
            store8(buf + pos, load8(e + k));
            pos = pos + 1;
            k = k + 1;
        }
        if (load8(e + k) != 0 || pos >= cap - 1) {
            pos = start;                     # no room for all of it plus its NUL: drop it
        } else {
            store8(buf + pos, 0);
            pos = pos + 1;
        }
        i = i + 1;
        e = load64(envp + i * 8);
    }
    return pos;
}
#endif

# v6.0.85 — Windows env-read. There is no /proc/self/environ on Windows, so
# resolve CYRIUS_HOME / USERPROFILE via kernel32!GetEnvironmentVariableA (the
# 0xF015 PE reroute). Without this the wrapper defaulted _home=/root and
# `cyrius build` could never find cycc.exe on Windows. `dst` holds 512 B or more.
#ifdef CYRIUS_TARGET_WIN
fn _win_getenv_into(name, dst): i64 {
    var n = syscall(0xF015, name, dst, 512);   # GetEnvironmentVariableA
    if (n == 0) { return 0; }                  # unset / empty
    if (n >= 512) { return 0; }                # too long: the buffer was NOT written (6.6.17)
    return dst;                                # NUL-terminated by the API
}

# The value of `name` in a buffer sized to it, or 0 when unset or empty. A first call with no
# buffer returns the size it needs (with its NUL). For the home, where a 512-B buffer turned a
# longer value into "". CHANGELOG [6.6.17]
fn _win_getenv_alloc(name): i64 {
    var need = syscall(0xF015, name, 0, 0);
    if (need <= 1) { return 0; }
    var buf = alloc(need + 1);
    var n = syscall(0xF015, name, buf, need + 1);
    if (n == 0 || n > need) { return 0; }
    store8(buf + n, 0);
    return buf;
}
#endif

# v6.4.63 — portable "is env var NAME set to exactly 1?" for the wrapper.
# find_tools() below already reaches the environment on all three hosts (Linux
# /proc/self/environ · macOS entry-stack envp · Windows GetEnvironmentVariableA)
# but inlines that read for HOME/CYRIUS_HOME only. The lib-freshness check needs
# the same reach for its CYRIUS_NO_WARN_SHADOW_LIB opt-out. lib/io.cyr's getenv()
# is NOT a substitute: it opens /proc/self/environ unconditionally off-agnos, so
# on macOS/Windows it silently returns 0 — i.e. the opt-out would be unhonorable
# on exactly the hosts the check was extended to. See CHANGELOG [6.4.63].
#ifdef CYRIUS_TARGET_WIN
var _cbt_env1_buf[512];
#endif
fn _cbt_env_is_1(name): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var wv = _win_getenv_into(name, &_cbt_env1_buf);
    if (wv == 0) { return 0; }
    if (load8(wv) == 49) { if (load8(wv + 1) == 0) { return 1; } }
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    var eb = alloc(32768);
    var en = file_read_all("/proc/self/environ", eb, 32767);
    #ifdef CYRIUS_TARGET_MACOS
    en = _macho_fill_environ(eb, 32768);
    #endif
    if (en <= 0) { return 0; }
    store8(eb + en, 0);
    var nl = strlen(name);
    var ei = 0;
    while (ei < en) {
        if (memeq(eb + ei, name, nl) == 1) {
            if (load8(eb + ei + nl) == 61) {           # '='
                if (load8(eb + ei + nl + 1) == 49) {   # '1'
                    if (load8(eb + ei + nl + 2) == 0) { return 1; }
                }
            }
        }
        while (ei < en) {
            if (load8(eb + ei) == 0) { ei = ei + 1; break; }
            ei = ei + 1;
        }
    }
    return 0;
    #endif
}

# v6.5.19 — the same portable reach, returning an INTEGER value instead of a
# yes/no. `run_binary_timed`'s CYRIUS_TEST_TIMEOUT override needs a number, and
# `_cbt_env_is_1` above can only answer "is it exactly 1". Returns `dflt` when the
# variable is unset, empty, or not a run of ASCII digits — a malformed value must
# not silently become 0 (which would mean "no deadline", i.e. the very bug this
# was added to fix). Digits only: no sign, no whitespace, no units.
#ifdef CYRIUS_TARGET_WIN
var _cbt_envi_buf[512];
#endif
fn _cbt_env_int(name, dflt): i64 {
    var v = 0;
    #ifdef CYRIUS_TARGET_WIN
    v = _win_getenv_into(name, &_cbt_envi_buf);
    #endif
    #ifndef CYRIUS_TARGET_WIN
    var eb = alloc(32768);
    var en = file_read_all("/proc/self/environ", eb, 32767);
    #ifdef CYRIUS_TARGET_MACOS
    en = _macho_fill_environ(eb, 32768);
    #endif
    if (en <= 0) { return dflt; }
    store8(eb + en, 0);
    var nl = strlen(name);
    var ei = 0;
    while (ei < en) {
        if (memeq(eb + ei, name, nl) == 1) {
            if (load8(eb + ei + nl) == 61) { v = eb + ei + nl + 1; ei = en; }
        }
        while (ei < en) {
            if (load8(eb + ei) == 0) { ei = ei + 1; break; }
            ei = ei + 1;
        }
    }
    #endif
    if (v == 0) { return dflt; }
    var acc = 0;
    var di = 0;
    while (load8(v + di) != 0) {
        var c = load8(v + di);
        if (c < 48) { return dflt; }
        if (c > 57) { return dflt; }
        acc = acc * 10 + (c - 48);
        di = di + 1;
    }
    if (di == 0) { return dflt; }
    return acc;
}

# 6.6.9 — the portable reach once more, returning the STRING value (a fresh copy) or 0 when
# NAME is unset or empty. POSIX only (Linux /proc/self/environ, macOS entry-stack envp);
# the Windows callers read their variables through `_win_getenv_into`. `_cbt_tmpbase`
# needs it for $TMPDIR. CHANGELOG [6.6.9]
fn _cbt_env_str(name): i64 {
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    var eb = alloc(65536);
    var en = file_read_all("/proc/self/environ", eb, 65535);
    #ifdef CYRIUS_TARGET_MACOS
    en = _macho_fill_environ(eb, 65536);
    #endif
    if (en <= 0) { return 0; }
    store8(eb + en, 0);
    var nl = strlen(name);
    var ei = 0;
    while (ei < en) {
        if (memeq(eb + ei, name, nl) == 1 && load8(eb + ei + nl) == 61) {
            var v = eb + ei + nl + 1;
            if (load8(v) == 0) { return 0; }
            var vl = strlen(v);
            var out = alloc(vl + 1);
            memcpy(out, v, vl + 1);
            return out;
        }
        while (ei < en) {
            if (load8(eb + ei) == 0) { ei = ei + 1; break; }
            ei = ei + 1;
        }
    }
    return 0;
    #endif
}

# ── The home: ONE rule with cycc's `lib/` include fallback ──────────────────────────────
# CYRIUS_HOME when set and non-empty, else HOME/.cyrius — the rule of `_init_cyrius_lib`
# (src/frontend/lex.cyr, C10 at 6.6.16): the FIRST occurrence of a name wins (as getenv and
# cycc), an EMPTY value is unset, and the WHOLE environment is read. Until 6.6.17 the CLI took
# the LAST duplicate, kept an empty CYRIUS_HOME as the home "" (root-anchored paths), and read
# only the first 32 KB of the environment, so a CYRIUS_HOME past it was invisible to the CLI
# and still honoured by cycc: two stdlibs. On Windows a value of 512+ B came back as an
# unwritten buffer, the home "". Not shared code: cycc's scanner is a Linux-only raw-syscall
# reader with fixed 2 KB buffers kept small for the seed's bootstrap compiler; this one also
# covers the macOS entry-stack envp and Windows. Two differences stay, both where cycc has NO
# fallback and the CLI still needs a home, so neither makes the two read different stdlibs:
# a home over 1,984 B (cycc's buffer, the long-HOME overflow bug's bound) the CLI uses as given, and with no
# usable CYRIUS_HOME or HOME at all the CLI uses /root/.cyrius. Neither tool ever falls through
# from a set CYRIUS_HOME to HOME. CHANGELOG [6.6.17]

# The value of the FIRST `name` entry (`name` includes its `=`, `nl` bytes) in the
# NUL-separated block eb[0..en), or 0 when there is none or it is empty — a later duplicate
# never replaces the first, empty or not.
fn _cbt_env_first(eb, en, name, nl): i64 {
    var ei = 0;
    while (ei < en) {
        if (en - ei > nl && memeq(eb + ei, name, nl) == 1) {
            if (load8(eb + ei + nl) == 0) { return 0; }
            return eb + ei + nl;
        }
        while (ei < en && load8(eb + ei) != 0) { ei = ei + 1; }
        ei = ei + 1;
    }
    return 0;
}

# The whole POSIX environment as one NUL-separated block with a NUL past its end; its length
# is stored at `lenp`. Linux: /proc/self/environ read to EOF (procfs reports size 0, so the
# buffer grows); macOS: the entry-stack envp, sized before it is copied.
fn _cbt_environ(lenp): i64 {
    #ifdef CYRIUS_TARGET_MACOS
    var envp = _macho_envp();
    var tot = 2;
    if (envp != 0) {
        var mi = 0;
        while (load64(envp + mi * 8) != 0) { tot = tot + strlen(load64(envp + mi * 8)) + 1; mi = mi + 1; }
    }
    var mb = alloc(tot);
    var mn = _macho_fill_environ(mb, tot);
    store8(mb + mn, 0);
    store64(lenp, mn);
    return mb;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    var cap = 65536;
    var buf = alloc(cap);
    var n = 0;
    var fd = file_open("/proc/self/environ", 0, 0);
    if (fd >= 0) {
        var r = 1;
        while (r > 0) {
            if (n + 1 >= cap) {
                var nb = alloc(cap * 2);
                memcpy(nb, buf, n);
                buf = nb;
                cap = cap * 2;
            }
            r = file_read(fd, buf + n, cap - 1 - n);
            if (r > 0) { n = n + r; }
        }
        file_close(fd);
    }
    store8(buf + n, 0);
    store64(lenp, n);
    return buf;
    #endif
}

fn find_tools(): i64 {
    # v6.0.34/6.0.58: on arm64-macОS default to aarch64 so current_cc() picks
    # cycc_aarch64 (the native macho cycc); on x86-macОS keep the X86 default
    # (_arch=0) so it picks the x86 `cycc`. Guard on CYRIUS_ARCH_AARCH64 (NOT
    # CYRIUS_ARCH_X86 — the x86 cross-compiler predefines X86 even when building
    # the arm64 wrapper; see args_macos.cyr [6.0.42]). Linux-aarch64 untouched.
    #ifdef CYRIUS_TARGET_MACOS
    #ifdef CYRIUS_ARCH_AARCH64
    _arch = ARCH_AARCH64;
    #endif
    #endif
    # The home: one rule with cycc's include fallback — see _cbt_env_first / _cbt_environ.
    # CHANGELOG [6.6.17]
    var proc_home = 0;
    var cyrius_home = 0;
    #ifndef CYRIUS_TARGET_WIN
    var env_lp[8];
    var env_buf = _cbt_environ(&env_lp);
    var env_n = load64(&env_lp);
    proc_home = _cbt_env_first(env_buf, env_n, "HOME=", 5);
    cyrius_home = _cbt_env_first(env_buf, env_n, "CYRIUS_HOME=", 12);
    var env_rv = _cbt_env_first(env_buf, env_n, "CYRIUS_RESOLVED=", 16);
    if (env_rv != 0) { if (load8(env_rv) == 49) { _cyrius_resolved = 1; } }
    #endif
    # Windows: no environ block to scan — GetEnvironmentVariableA, sized to the value.
    #ifdef CYRIUS_TARGET_WIN
    proc_home = _win_getenv_alloc("USERPROFILE");
    cyrius_home = _win_getenv_alloc("CYRIUS_HOME");
    # 6.6.11 (I3): the loop guard too. The scan above is the only place `_cyrius_resolved`
    # was set, and it reads nothing on PE — so `CYRIUS_RESOLVED=1`, the documented escape
    # from a pin, was ignored by cyrius.exe. CHANGELOG [6.6.11]
    if (_cbt_env_is_1("CYRIUS_RESOLVED") == 1) { _cyrius_resolved = 1; }
    #endif
    if (proc_home == 0) { proc_home = "/root"; }
    # CYRIUS_HOME overrides default ~/.cyrius
    if (cyrius_home != 0) {
        _home = cyrius_home;
    } else {
        _home = make_path(proc_home, ".cyrius");
    }

    # Compiler binary is `cycc` (the v6.0.0 rename of cc5 is permanent;
    # the v6.0.x back-compat cc5 fallback was DROPPED at v6.1.0 — and
    # build/cc5 is now the tracked PRIOR-major v5.x compiler, which must
    # NOT be picked up to build v6.x source). Windows ships bin/cycc.exe,
    # so the wrapper looks for that name on PE (v6.0.85).
    var _ccname = "bin/cycc";
    #ifdef CYRIUS_TARGET_WIN
    _ccname = "bin/cycc.exe";
    #endif
    var installed_cc = make_path(_home, _ccname);
    # ⛔ v6.5.37 — IN THE CYRIUS SOURCE REPO, ./build/cycc WINS. Everywhere else the
    # installed toolchain still wins, unchanged.
    #
    # The installed binary used to win unconditionally, with ./build/cycc reachable only
    # when nothing was installed at all. In a consumer that is right — a project should
    # build with its pinned toolchain. IN THIS REPO IT IS BACKWARDS: it means `cyrius test`,
    # `cyrius build` and every wrapper-driven gate compile the corpus with the LAST RELEASED
    # compiler rather than the one just built, so a compiler change cannot be tested through
    # the wrapper at all until it is installed — and `scripts/check.sh` uses
    # `$ROOT/build/cycc` directly, so the two halves of the same suite silently disagreed
    # about which compiler was under test.
    #
    # MEASURED at v6.5.37: the `#derive(Serialize)` null-guard fix landed in build/cycc and
    # `tests/tcyr/derive/derive_from_json_str_guards.tcyr` still died of SIGSEGV under the
    # wrapper, because the wrapper compiled it with the installed 6.5.36. check.sh went
    # 207/1 on a fix that was correct.
    #
    # ⚠ THIS IS THE THIRD SHAPE OF ONE PROBLEM IN A SINGLE RELEASE — "which binary is
    # actually running is not obvious from the command you typed". The other two:
    # `_try_redirect_to_pinned` re-execing `versions/<pin>/bin/cyrius` (so a fixture pinning
    # another version tests an old binary), and a distlib run in a 6.3.35-pinned repo
    # delegating to a months-old binary. Each cost a wrong diagnosis before it was spotted.
    #
    # `_dep_is_cyrius_source_repo()` matches `[package].name` exactly, so `cyrius-x` and every
    # consumer are unaffected — never a filename probe, for the reason the v6.5.37 pin fix
    # documents at length. Safe to call here: `alloc_init()` runs before `find_tools()`.
    # v6.5.42 — a wrapper invoked by PATH prefers the cycc SITTING BESIDE IT. Ordered
    # deliberately: AFTER the in-repo branch above, so v6.5.37's fix is not re-broken (in the
    # cyrius source repo ./build/cycc must still win), and BEFORE `installed_cc`, which is the
    # branch that was silently answering for every versioned wrapper.
    # ⚠ Sets `_tools_dir` to the same sibling directory, so `cycc_aarch64` / `cycc_cx` and the
    # rest of the toolchain resolve from the same install rather than being split across two.
    var _sib_dir = _wrapper_dir();
    var _sib_cc = 0;
    if (_sib_dir != 0) {
        var _sn = "cycc";
        #ifdef CYRIUS_TARGET_WIN
        _sn = "cycc.exe";
        #endif
        var _cand = make_path(_sib_dir, _sn);
        if (file_exists(_cand) == 1) { _sib_cc = _cand; }
    }
    if (file_exists("./build/cycc") == 1 && _dep_is_cyrius_source_repo() == 1) {
        _cc = "./build/cycc";
        _tools_dir = "./build";
    } elif (_sib_cc != 0) {
        _cc = _sib_cc;
        _tools_dir = _sib_dir;
    } elif (file_exists(installed_cc) == 1) {
        _cc = installed_cc;
        _tools_dir = make_path(_home, "bin");
    } else {
        # Dev mode: ./build/cycc
        if (file_exists("./build/cycc") == 1) {
            _cc = "./build/cycc";
            _tools_dir = "./build";
        } else {
            # not found — ok for deps/clean/init/version/help, fatal for build/run/test
            _cc = 0;
            _tools_dir = make_path(_home, "bin");
        }
    }
    # Search for aarch64 cross-compiler: tools dir, then ./build/.
    _cc_arm = _tool_path(_tools_dir, "cycc_aarch64");
    if (file_exists(_cc_arm) == 0) {
        if (file_exists("./build/cycc_aarch64") == 1) {
            _cc_arm = "./build/cycc_aarch64";
        }
    }

    # cx bytecode compiler: tools dir, then ./build/. Absent → JIT-built on first
    # use (see _ensure_cc_cx in build.cyr), matching the cross_bins on-demand model.
    _cc_cx = _tool_path(_tools_dir, "cycc_cx");
    if (file_exists(_cc_cx) == 0) {
        if (file_exists("./build/cycc_cx") == 1) {
            _cc_cx = "./build/cycc_cx";
        }
    }

    # cx bytecode VM (runs .cyx): installed bin, then ./build/. Absent → JIT-built
    # on first `cyrius run <file>.cyx` (see _ensure_cxvm in build.cyr).
    _cxvm = _tool_path(_tools_dir, "cxvm");
    if (file_exists(_cxvm) == 0) {
        if (file_exists("./build/cxvm") == 1) {
            _cxvm = "./build/cxvm";
        }
    }

    # Scripts dir: relative to repo
    if (file_exists("./scripts/cyrius") == 1) {
        _scripts_dir = "./scripts";
        _repo_root = ".";
    } else {
        _scripts_dir = make_path(_home, "bin");
        _repo_root = ".";
    }

    # Read version
    _version = read_file_str("VERSION");
    if (_version == 0) {
        var vpath = make_path(_repo_root, "VERSION");
        _version = read_file_str(vpath);
    }
    if (_version == 0) { _version = "unknown"; }
    return 0;
}

# The project's PACKAGE version, for anything that stamps one into an artifact: the manifest's
# `[package] version` (`${file:PATH}` expanded — the reader CYRIUS_PKG_VERSION / `#@pkgver` uses),
# else the cwd VERSION file, else "unknown"; 0 after NAMING a refusal. 6.6.20 (REFACTOR-11): `cyrius
# distlib` stamped `_version` alone, so a project declaring `version = "0.1.0"` with no VERSION
# file shipped `# Version: unknown` while its own build's `#@pkgver` said 0.1.0. 6.6.20 (SEC-04):
# the ./VERSION fallback goes through the same checked reader (`_dep_read_version_file`) — read raw
# (`_version`), a `VERSION -> ~/.ssh/x` link stamped the file into the bundle header, and a second
# line of it landed BELOW the `# Version:` comment, as bundle source. CHANGELOG [6.6.20]
fn _project_version(): i64 {
    var v = _dep_read_cyml_package_version();
    if (v < 0) { return 0; }
    if (v != 0) {
        if (load8(v) != 0) { return v; }
    }
    var f = _dep_read_version_file();
    if (f < 0) { return 0; }
    if (f != 0) { return f; }
    return "unknown";
}

fn set_arch(arch): i64 {
    _arch = arch;
    return 0;
}

fn current_cc(): i64 {
    if (_arch == ARCH_AARCH64) { return _cc_arm; }
    return _cc;
}

fn arch_name(): i64 {
    if (_arch == ARCH_AARCH64) { return "aarch64"; }
    return "x86_64";
}

# ================================================================
# Source scanning shared by the reference tools (coverage, header, distlib, and — since
# 6.6.10 — cyrius-lsp): cbt/srcscan.cyr. It is its own file so programs/cyrius-lsp.cyr can
# include the SAME reader instead of carrying a sixth hand-rolled one. CHANGELOG [6.6.10]
# ================================================================
include "cbt/srcscan.cyr"
