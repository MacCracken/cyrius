# cyrius — Cyrius Build Tool
# Written in Cyrius. Modular — see sibling .cyr files.
#
# Build:     build, run, test, bench, check, self, clean
# Project:   init, package, publish, install, update, port
# Quality:   audit, fmt, lint, doc, vet, deny, coverage, doctest, header
# Interactive: repl
# Info:      version, which, help

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"
include "lib/fs.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"
include "lib/syscalls.cyr"
include "lib/audit_walk.cyr"   # v6.2.25: fmt/lint/doc walkers for `cyrius audit` sweep

include "src/version_str.cyr"

include "cbt/core.cyr"
include "cbt/build.cyr"
include "cbt/commands.cyr"
include "cbt/project.cyr"
include "cbt/quality.cyr"
include "cbt/deps.cyr"
include "cbt/pulsar.cyr"

# ================================================================
# Usage / help
# ================================================================

fn usage(): i64 {
    println("Cyrius Build Tool");
    println("");
    println("");
    println("Usage: cyrius <command> [options]");
    println("");
    println("Build:");
    println("  build [--aarch64|--win|--agnos] [--no-deps] [--strict] [--features <list>] <src> <out>   compile a program");
    println("  run [--aarch64] <source.cyr>    compile + run");
    println("  test [--aarch64] <test.cyr>     compile + run, check exit 0");
    println("  tests [--aarch64] [dir]         recursively run all .tcyr under dir (default tests/)");
    println("  bench <bench.cyr>               compile + run benchmarks");
    println("  check [--with-deps] <src.cyr>  syntax check (default: standalone)");
    println("  sign-efi <pe> <key.der> <cert.der> <out>   Authenticode-sign a PE for UEFI Secure Boot (via cyrsign-efi)");
    println("  distlib [--all|--check] [--modular] [profile]   bundle src/ into dist/ (--all = base + every [lib.X]; --check = verify, don't write)");
    println("  self                            self-hosting check (cycc==cycc)");
    println("  clean                           remove build/ contents");
    println("  lib sync [--dry-run] [--full]   vendor declared [deps].stdlib from pin (--full = whole snapshot)");
    println("");
    println("Project:");
    println("  init [--lib|--agent|--cmtools|--dry-run] <name | .>   scaffold a new project");
    println("  deps [--no-lock|--verify]       resolve [deps.NAME] from cyrius.cyml into lib/");
    println("  update                          re-resolve all deps to latest tags");
    println("  package                         create .ark distributable");
    println("  port [--dry-run] <rust-project> scaffold from a Rust project (→ rust-old/)");
    println("");
    println("Quality:");
    println("  audit                           project sweep: fmt/lint/docs/tests/bench");
    println("  audit --internal                cyrius-internal full gate (scripts/check.sh)");
    println("  audit --internal=platform-check   + cross-OS real-hardware self-host");
    println("    --internal=platform-check     + cross-OS self-host on REAL hw (ecb/ach/pi/cass)");
    println("  fuzz                            run fuzz/*.fcyr harnesses");
    println("  fmt <file.cyr> [--check]        format code");
    println("  lint <file.cyr>                 static analysis");
    println("  doc [--check] <file.cyr>        generate/check documentation");
    println("  vet <source.cyr>                audit include dependencies");
    println("  deny <source.cyr>               enforce project policies");
    println("");
    println("Testing:");
    println("  coverage [--full] [--min <pct>]  reference coverage of project src/ (--full=vendored lib/; --min gates CI)");
    println("  doctest <file.cyr>              run doc examples");
    println("  soak [N]                        N-iter self-host loop + tests/scyr/*.scyr harnesses");
    println("  smoke                           run tests/smcyr/*.smcyr quick-validation programs");
    println("");
    println("Interactive:");
    println("  repl                            expression evaluator");
    println("");
    println("Tools:");
    println("  lsp                             build + install cyrius-lsp");
    println("");
    println("Info:");
    println("  version                         show cyrius toolchain version");
    println("  version --project               show project version (from VERSION)");
    println("  which                           show path to cycc");
    println("  hooks install                   install the build-artifact pre-commit hook");
    println("  help                            show this help");
    return 0;
}

# ================================================================
# Per-repo version-resolved dispatch (v5.11.25 — Part 2 of the
# per-repo isolation arc; Part 1 shipped at v5.11.17 in cbt/deps.cyr).
# ================================================================
#
# Runs BEFORE the command dispatch. If `cyrius.cyml`'s
# `[package].cyrius = "X.Y.Z"` field pins a different version than
# this binary represents, re-exec the pinned binary so the consumer
# always gets the toolchain version their cyml field names.
#
# Loop guard: `CYRIUS_RESOLVED=1` env var. Set by us before execve;
# detected on re-entry by `find_tools()` (sets `_cyrius_resolved`).
# Second-pass binary skips this fn and runs the command directly.
#
# Hard error if the pinned version isn't installed at
# `~/.cyrius/versions/<v>/bin/cyrius`. Never silently slides to
# `latest` — matches v5.11.17 deps stdlib_dir policy.
# Does `pin` name a release carrying a known Critical? Exact string matches only — a numeric
# range comparison would silently swallow future versions into a band they are not in.
fn _pin_has_known_critical(pin): i64 {
    # v6.5.36: enum constants >= 2^62 read back as -1 (an in-band tag needing a 65th bit).
    if (streq(pin, "6.5.31") == 1) { return 1; }
    if (streq(pin, "6.5.32") == 1) { return 1; }
    if (streq(pin, "6.5.33") == 1) { return 1; }
    if (streq(pin, "6.5.34") == 1) { return 1; }
    if (streq(pin, "6.5.35") == 1) { return 1; }
    return 0;
}

fn _try_redirect_to_pinned(): i64 {
    if (_cyrius_resolved == 1) { return 0; }

    # ⛔ v6.5.37 — THE THIRD OCCURRENCE OF THE `src/main.cyr` ≠ cyrius-repo CONFLATION.
    #
    # This used to read `file_exists("src/main.cyr")`, meaning "am I the cyrius source
    # repo?". It is true for essentially EVERY cyrius project: `src/main.cyr` is the entry
    # point `cyrius init` generates. So the pin redirect below was skipped for almost every
    # consumer, and the manifest's `cyrius = "X.Y.Z"` was silently ignored.
    #
    # Measured on 6.5.36, same repo, one file's difference:
    #     pinned 6.3.35, no src/main.cyr  -> `cyrius --version` reports 6.3.35   (honoured)
    #     pinned 6.3.35, + src/main.cyr   -> reports 6.5.36
    #                                        "manifest-pin: 6.3.35 (drift — wrapper is 6.5.36)"
    # The tool PRINTED the pin it was ignoring, which is why this survived: every symptom
    # said "drift", and drift reads like a stale manifest rather than a defect here.
    #
    # ⚠ THE COMMENT THIS REPLACES CITED ITS OWN BUG AS PRECEDENT — "the deps stdlib_dir
    # Part 1 (v5.11.17) already gates on this signal — match for consistency". That gate was
    # itself the same defect, and v6.5.25 fixed it (bote/agnosai/majra: the probe matched the
    # consumer's own half-populated ./lib and returned it AS the stdlib). Its fix note said:
    # "`_dep_is_cyrius_source_repo()` exists precisely for this ... When a 'am I the cyrius
    # repo?' test is needed, use that helper; never a filename probe." It was written for the
    # `cyrius audit` fix (v6.0.1, again v6.4.63), applied to stdlib_dir at v6.5.25, and never
    # applied here. Three sites, one shape, fixed one at a time — GREP THE SHAPE, NOT THE SITE.
    #
    # `_dep_is_cyrius_source_repo()` matches `[package].name` exactly, so `cyrius-x` does not
    # qualify. Blast radius measured across ~180 sibling repos before landing: 94 begin
    # honouring a pin they had been ignoring, and ALL 94 have that version installed — zero
    # would hit the "pinned version is not installed" error below.
    #
    # ⭐ This cuts the same way as the symlinked-lib guard added above: honouring pins means
    # MORE delegation to old binaries, so that guard had to exist first. It does.
    if (_dep_is_cyrius_source_repo() == 1) { return 0; }

    var pin = _dep_read_cyml_cyrius_field();
    if (pin == 0) { return 0; }

    # Compare with self version (compile-time embed via version_str.cyr).
    if (streq(pin, _VERSION_TOOLCHAIN) == 1) { return 0; }

    # ⛔ v6.5.37 — DO NOT DELEGATE A VENDOR WRITE INTO A SYMLINKED lib/.
    #
    # THE INCIDENT (2026-09-01) AND WHY THE GUARD IN _dep_copy_file IS NOT ENOUGH.
    # `nous/lib` was a directory symlink to `~/.cyrius/lib` -> `versions/6.5.36/lib`, the
    # LIVE stdlib snapshot. nous pins cyrius 6.3.35, so control never reached this binary's
    # resolver at all: THIS FUNCTION execve'd into `~/.cyrius/versions/6.3.35/bin/cyrius`
    # — a binary built months earlier that has no guard and never will — and THAT process
    # wrote 6.3.35-era stdlib straight through the symlink into the 6.5.36 snapshot. 27
    # files were replaced; `lib/alloc.cyr` lost `fn _alloc_zero`, the memory-reuse
    # information-leak fix from v6.4.1 (daimon VULN-007). Because `~/.cyrius/lib` is the
    # global default source, every other repo then READ the corruption back out — shabda
    # ingested it 12 seconds later.
    #
    # ⭐ So the check has to live HERE, before the execve, in the only binary guaranteed to
    # be current: `~/.cyrius/bin/cyrius` always points at the newest install. A guard that
    # exists only in the resolver protects repos pinned at >= 6.5.37 and NOTHING else —
    # and the repos most likely to carry a stale lib/ are exactly the old-pinned ones.
    #
    # Scoped to the verbs that vendor into lib/ so read-only commands still work in an
    # affected tree; the first non-flag argv entry is the verb (mirrors the cmd_idx loop
    # in main). ⚠ `is_symlink` returns 0 on Windows — no PE readlink wrapper — so this
    # does not fire on PE. Stated, not hidden.
    var _vi = 1;
    var _verb = 0;
    while (_vi < argc()) {
        if (load8(argv(_vi)) != 45) { _verb = argv(_vi); break; }   # 45 = '-'
        _vi = _vi + 1;
    }
    if (_verb != 0) {
        var _writes = 0;
        if (streq(_verb, "deps") == 1) { _writes = 1; }
        if (streq(_verb, "lib") == 1) { _writes = 1; }
        if (streq(_verb, "install") == 1) { _writes = 1; }
        if (streq(_verb, "update") == 1) { _writes = 1; }
        if (_writes == 1 && is_symlink(str_from("lib")) == 1) {
            _dep_refuse_symlinked_dest("lib");
            sys_exit(1);
        }
    }

    # ⚠ Ordered BEFORE the "is the pinned version installed?" check below: a symlinked
    # lib/ is wrong regardless of whether the pin resolves, and refusing first makes the
    # refusal reachable without depending on which versions happen to be installed —
    # which is what lets tests/gates/toolchain/deps_symlinked_lib_refused.sh pin a
    # deliberately absent version and still exercise this path deterministically.
    # ⛔ v6.5.47 — WARN WHEN THE PIN LANDS ON A RELEASE WITH A KNOWN CRITICAL.
    # v6.5.36 fixed a Critical that shipped live in 6.5.31 through 6.5.35: an enum constant
    # >= 2^62 read back as -1, because the tag occupied a 65th bit of a 64-bit slot. Measured at
    # v6.5.47: **50** manifests under ~/Repos pin into that band.
    # ⚠ THEY ARE CURRENTLY PROTECTED BY A SECOND DEFECT, WHICH IS NOT A REASON TO STAY QUIET.
    # A pinned wrapper older than 6.5.44 does not resolve its own sibling `cycc`, so those repos
    # silently build with the CURRENT compiler and never meet the Critical. The moment that pin
    # is honoured — reinstalling the version, or the wrapper being rebuilt — 50 repos start
    # binding a compiler with a known miscompile. A warning is the only thing that survives
    # either outcome.
    # ⚠ ONE BAND, ONE REASON, LISTED EXPLICITLY. This is a hand-maintained fact, which this cycle
    # has repeatedly found going stale — so it is deliberately NOT a range check that would
    # silently widen: adding a future band means adding a row here and saying why.
    if (_pin_has_known_critical(pin) == 1) {
        sys_write(STDERR_FD, "warning: cyrius.cyml pins ", 26);
        sys_write(STDERR_FD, pin, strlen(pin));
        sys_write(STDERR_FD, ", which carries the v6.5.36 enum Critical (constants >= 2^62 read back as -1).\n         Re-pin to 6.5.36 or later.\n", 115);
    }

    # Build pinned binary path: ~/.cyrius/versions/<pin>/bin/cyrius.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, _home);
    str_builder_add_cstr(sb, "/versions/");
    str_builder_add_cstr(sb, pin);
    str_builder_add_cstr(sb, "/bin/cyrius");
    var pinned_bin = str_data(str_builder_build(sb));

    if (file_exists(pinned_bin) == 0) {
        sys_write(STDERR_FD, "error: cyrius.cyml pins version ", 32);
        sys_write(STDERR_FD, pin, strlen(pin));
        sys_write(STDERR_FD, " but cyrius binary is not installed at ", 39);
        sys_write(STDERR_FD, pinned_bin, strlen(pinned_bin));
        sys_write(STDERR_FD, "\n  run: cyrius install ", 23);
        sys_write(STDERR_FD, pin, strlen(pin));
        sys_write(STDERR_FD, "\n", 1);
        sys_exit(1);
    }

    # Build new argv: [pinned_bin, original argv[1..]].
    var ac = argc();
    var nargv = alloc((ac + 1) * 8);
    store64(nargv, pinned_bin);
    var i = 1;
    while (i < ac) {
        store64(nargv + i * 8, argv(i));
        i = i + 1;
    }
    store64(nargv + ac * 8, 0);

    # Build new envp: existing _envp + "CYRIUS_RESOLVED=1" + NUL.
    var ev_count = 0;
    while (load64(_envp + ev_count * 8) != 0) { ev_count = ev_count + 1; }
    var nenvp = alloc((ev_count + 2) * 8);
    var ej = 0;
    while (ej < ev_count) {
        store64(nenvp + ej * 8, load64(_envp + ej * 8));
        ej = ej + 1;
    }
    store64(nenvp + ev_count * 8, "CYRIUS_RESOLVED=1");
    store64(nenvp + (ev_count + 1) * 8, 0);

    sys_execve(pinned_bin, nargv, nenvp);
    # execve only returns on failure.
    sys_write(STDERR_FD, "error: cyrius execve to pinned version failed\n", 46);
    sys_exit(1);
    return 0;
}

# ================================================================
# Main dispatch
# ================================================================

fn main(): i64 {
    alloc_init();
    args_init();
    load_environ();
    find_tools();
    set_arch(ARCH_X86);
    # v6.0.34: an arm64 (Apple Silicon) Mach-O wrapper defaults to aarch64 so
    # current_cc() picks the native macho cycc_aarch64. v6.4.59: gate this on the
    # WRAPPER's OWN arch (CYRIUS_ARCH_AARCH64) — an Intel-Mac (x86-macho) wrapper
    # must KEEP the ARCH_X86 default above, else it picks [aarch64]/cycc_aarch64
    # and "compiler not found" on real Intel hardware (found on ach). Mirrors the
    # find_tools() guard in cbt/core.cyr. An explicit --aarch64 is handled below.
    # macho-only; Linux/Windows unchanged.
    #ifdef CYRIUS_TARGET_MACOS
    #ifdef CYRIUS_ARCH_AARCH64
    set_arch(ARCH_AARCH64);
    #endif
    #endif

    # v5.11.25: per-repo isolation Part 2.
    # If cyrius.cyml pins a different version, re-exec the pinned
    # binary. Skipped when CYRIUS_RESOLVED=1 (already re-exec'd) or
    # when running from the cyrius source repo (src/main.cyr present).
    _try_redirect_to_pinned();

    if (argc() < 2) {
        usage();
        return 0;
    }

    # Parse global flags before subcommand
    var cmd_idx = 1;
    while (cmd_idx < argc()) {
        if (streq(argv(cmd_idx), "-q") == 1 || streq(argv(cmd_idx), "--quiet") == 1) {
            _quiet = 1;
            cmd_idx = cmd_idx + 1;
        }
        elif (streq(argv(cmd_idx), "-v") == 1 || streq(argv(cmd_idx), "--verbose") == 1) {
            _verbose = 1;
            cmd_idx = cmd_idx + 1;
        }
        else { break; }
    }
    if (cmd_idx >= argc()) { usage(); return 0; }
    var cmd = argv(cmd_idx);

    # v6.3.1 (dependency-model arc, lever 2 — required vs optional deps): the dep
    # resolver (_auto_deps, below) fires BEFORE each subcommand's own flag loop, so
    # every flag that changes WHICH deps resolve must be read here first.
    # --features / --no-default-features select `optional = true` deps via the
    # [features] table; the target flags (--aarch64 / --win / --agnos /
    # --target=*-bare-metal-elf) set the build target a dep's `target = "..."` key
    # matches against. Re-reading these in the subcommand loop is idempotent
    # (set_arch / flag=1 twice is harmless), so this pre-scan changes NO
    # non-lever-2 build's behavior — it just makes the resolver-affecting state
    # available before resolution instead of only after.
    var pf = cmd_idx + 1;
    while (pf < argc()) {
        var pfa = argv(pf);
        if (streq(pfa, "--features") == 1) {
            pf = pf + 1;
            if (pf < argc()) { _cli_features = _split_csv(argv(pf)); }
        }
        elif (streq(pfa, "--no-default-features") == 1) {
            _cli_no_default = 1;
        }
        elif (streq(pfa, "--aarch64") == 1) {
            set_arch(ARCH_AARCH64);
        }
        elif (streq(pfa, "--win") == 1) {
            _win_target = 1;
        }
        elif (streq(pfa, "--agnos") == 1) {
            _agnos_target = 1;
        }
        elif (streq(pfa, "--target=x86_64-bare-metal-elf") == 1) {
            _baremetal_target = 1;
        }
        elif (streq(pfa, "--target=aarch64-bare-metal-elf") == 1) {
            set_arch(ARCH_AARCH64);
            _baremetal_target = 1;
            _baremetal_aa = 1;
        }
        # v6.4.63: read here (not in the subcommand loop) because the freshness
        # check fires alongside _auto_deps, before that loop runs.
        elif (streq(pfa, "--check-lib-sync") == 1) {
            _check_lib_sync = 1;
        }
        pf = pf + 1;
    }

    # Auto-resolve deps before build/run/test/bench/fuzz/check.
    # v5.7.21: `fuzz` joins the gate. cmd_fuzz already calls compile()
    # which reads _dep_includes for auto-prepend, but pre-v5.7.21 the
    # gate skipped fuzz so _auto_deps never populated _dep_includes;
    # downstream fuzz harnesses had to declare every stdlib include
    # by hand or fail with `undefined function`. cmd_test / cmd_bench
    # had this from day one — gate now has parity.
    # v5.7.38: `soak` and `smoke` join the gate — same parity reasoning
    # as v5.7.21's fuzz fix. cmd_soak now walks `tests/scyr/*.scyr`
    # harnesses and cmd_smoke walks `tests/smcyr/*.smcyr` files; both
    # rely on compile() reading _dep_includes for stdlib auto-prepend.
    # v6.4.73: `audit` and `capacity` join the gate — the THIRD instance of
    # this exact bug class, and the worst, because both are the tools you
    # reach for to find out whether a project is healthy. `_audit_sweep`
    # calls cmd_tests + cmd_bench internally, but `audit` was never in this
    # list, so _dep_includes stayed empty and every stdlib fn came back
    # `undefined function 'alloc'` — stiva 3.0.6 reported `0 passed, 5
    # failed` under `cyrius audit` while `cyrius test` on the same tree
    # reported `202 passed, 0 failed`. It stayed invisible in-repo for a
    # year because 250 of cyrius's own 251 .tcyr files self-declare their
    # includes and never needed the auto-prepend — a textbook "found by
    # ports" gap. `capacity` needs it for the same reason (see
    # _materialize_source). CHANGELOG [6.4.73].
    # v6.5.17: `distlib` joins the gate — the FOURTH instance, filed by hisab.
    # v6.5.14 repaired distlib's bundle self-check (it had compiled to /dev/null
    # and never once run). The repaired check compiles the bundle through a
    # generated entry and downgrades undefined FNS with --allow-undef. But a
    # bundle ships no stdlib GLOBALS either, and an undefined variable is a
    # PARSE-TIME abort (src/frontend/parse_expr.cyr:589) that --allow-undef
    # cannot reach — it only gates the fixup stage. So the check needed the
    # manifest auto-prepend, and distlib was never in this list, so
    # _dep_includes was empty and no prepend was possible. Any bundle reading a
    # stdlib `var` or enum constant was reported as a DEFECTIVE BUNDLE and
    # distlib exited 1 — hisab's `F64_ONE` (the ordinary way to write 1.0 in a
    # language with no float literals), 44 of 69 [lib] repos on the filer s
    # machine. The bundle was correct; the check asked the wrong question.
    # ⚠ Setting _skip_deps = 0 is NOT sufficient on its own — _materialize_source
    # (cbt/build.cyr:378) also requires _dep_includes to be non-empty, and only
    # _auto_deps() fills it. Both halves are needed; a first attempt at this fix
    # set the flag alone and changed nothing.
    # v6.5.19: `doctest` (filed by agnosai) is the FIFTH instance, and auditing the
    # WHOLE verb set for it found two more already live — `publish` and `package`.
    # `publish` was created BY the v6.5.17 patch: cmd_publish calls cmd_distlib()
    # one call frame away, so adding the `distlib` STRING left the identical defect
    # (and the identical misleading "the generated bundle does not compile" text)
    # reachable through a different verb. That is the whole lesson of five patches:
    # **the requirement is a property of the CALL GRAPH, not of the verb string.**
    # Adding one more name to this list is not what stops the sixth instance —
    # tests/gates/toolchain/auto_deps_verb_gate.sh is. It enumerates every verb
    # main() dispatches, computes which ones transitively reach compile() /
    # _materialize_source() across all of cbt/, and FAILS if any of them is absent
    # from the list below. Exemptions live in that gate's allow-list, one reason
    # each — `pulsar` is the load-bearing one (auto-prepend makes it build a
    # 434,360-byte-larger cycc that is NOT the self-host fixpoint binary).
    #
    # ⚠ THE LIST IS NOT A FREE ADD. `lsp` was added here earlier in this same
    # release and taken straight back out: `cyrius lsp` compiles
    # programs/cyrius-lsp.cyr, which self-declares its 11 includes and only exists
    # inside this repo (the dispatcher hard-codes the path), so it never had the
    # missing-prepend bug — and it INSTALLS what it builds into CYRIUS_HOME/bin.
    # Gating it unioned the whole [deps].stdlib into a binary that already had
    # everything it needed: 119,584 B -> 507,144 B (4.24x, 516 unreachable fns),
    # measured at 6.5.19. That is precisely the `pulsar` condition, so `lsp` now
    # sits in the gate's EXEMPT_LIST with that reason. A verb belongs on the line
    # below when auto-prepend is REQUIRED for it to compile, not merely harmless.
    # The BEGIN/END markers are the gate's parse anchors: keep the verbs between
    # them and keep every OTHER streq(cmd, ...) a real dispatch site.
    # CHANGELOG [6.5.19].
    # AUTO_DEPS_VERBS BEGIN
    if (streq(cmd, "build") == 1 || streq(cmd, "run") == 1 || streq(cmd, "test") == 1 || streq(cmd, "tests") == 1 || streq(cmd, "bench") == 1 || streq(cmd, "fuzz") == 1 || streq(cmd, "soak") == 1 || streq(cmd, "smoke") == 1 || streq(cmd, "check") == 1 || streq(cmd, "audit") == 1 || streq(cmd, "capacity") == 1 || streq(cmd, "distlib") == 1 || streq(cmd, "doctest") == 1 || streq(cmd, "publish") == 1 || streq(cmd, "package") == 1) {
        # AUTO_DEPS_VERBS END
        var dr = _auto_deps();
        # v6.5.37 (A1) — clamp here too: _auto_deps propagates the same raw count, so a
        # 256-error resolve made `cyrius build` exit 0 as well.
        if (dr > 0) { return 1; }
        # v6.4.63: name any version skew between ./lib/ and the version-pinned
        # snapshot (yeo-cy-test filing). Sits OUTSIDE _auto_deps deliberately —
        # _auto_deps early-returns when cyrius.cyml has no [deps]/[deps.*]
        # section, and a FOLDED lib (sigil et al., vendored into lib/ and removed
        # from [deps]) is exactly that case: the one we most need to catch, since
        # a silent multi-version skew in the crypto bundle can withhold a security
        # fix. Warning by default; --check-lib-sync makes it fail the build.
        var lf = _check_lib_freshness(_check_lib_sync);
        if (_check_lib_sync == 1 && lf > 0) { return 1; }
    }

    # --- sign-efi: UEFI Authenticode PE signing ---
    # Dispatches to the separate `cyrsign-efi` helper binary (sigil's RSA bignum
    # scratch is ~13 MB of reachable static data — folding it into `cyrius` would
    # bloat the CLI 24x). execve replaces this process, so the helper's exit code
    # is ours. On non-Linux the sys_execve stub returns -1 → the error path fires.
    # CHANGELOG [6.4.47] (arc #3 bite 1).
    if (streq(cmd, "sign-efi") == 1) {
        find_tools();
        var _se_tool = make_path(_tools_dir, "cyrsign-efi");
        var _se_argv: i64[16];
        store64(&_se_argv, _se_tool);
        var _se_ai = cmd_idx + 1;
        var _se_ni = 1;
        while (_se_ai < argc()) {
            if (_se_ni < 15) { store64(&_se_argv + _se_ni * 8, argv(_se_ai)); _se_ni = _se_ni + 1; }
            _se_ai = _se_ai + 1;
        }
        store64(&_se_argv + _se_ni * 8, 0);
        sys_execve(_se_tool, &_se_argv, _envp);
        _err("sign-efi: cyrsign-efi helper not found (Linux-only; build it with `cyrius build programs/cyrsign_efi.cyr build/cyrsign-efi`)");
        return 127;
    }

    # --- Build commands ---
    if (streq(cmd, "distlib") == 1) {
        # v6.2.50 Phase C: scan args for `--modular` (per-module dist + index);
        # the first non-flag arg is the profile.
        _distlib_modular = 0;
        var dprof = 0;
        var dall = 0;
        var dchk = 0;
        var _di = cmd_idx + 1;
        while (_di < argc()) {
            var _a = argv(_di);
            if (streq(_a, "--modular") == 1) { _distlib_modular = 1; }
            # v6.5.8: `--all` regenerates the base bundle AND every [lib.<name>] profile;
            # `--check` verifies them instead of writing. Before this, BOTH were silently
            # swallowed by the `load8(_a) != 45` guard below and ran the base-bundle-only
            # path — so `cyrius distlib --all` already "succeeded" while doing the wrong
            # thing, which is the worst possible shape for the command the issue tells
            # people to reach for.
            elif (streq(_a, "--all") == 1) { dall = 1; }
            elif (streq(_a, "--check") == 1) { dall = 1; dchk = 1; }
            elif (load8(_a) == 45) {
                _err_ctx("distlib: unknown option", _a);
                return 1;
            }
            elif (dprof == 0) { dprof = _a; }
            else {
                _err_ctx("distlib: unexpected extra argument", _a);
                return 1;
            }
            _di = _di + 1;
        }
        if (dall == 1) {
            if (dprof != 0) {
                _err("distlib: --all/--check cover every profile; do not also name one");
                return 1;
            }
            return cmd_distlib_all(dchk);
        }
        return cmd_distlib(dprof);
    }

    if (streq(cmd, "build") == 1) {
        var ai = 2;
        var defs = vec_new();
        while (argc() > ai) {
            if (streq(argv(ai), "--aarch64") == 1) {
                set_arch(ARCH_AARCH64);
                ai = ai + 1;
            }
            elif (streq(argv(ai), "-v") == 1) {
                _verbose = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--dry-run") == 1) {
                _dry_run = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "-q") == 1) {
                _quiet = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--quiet") == 1) {
                _quiet = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "-D") == 1) {
                ai = ai + 1;
                if (argc() > ai) { vec_push(defs, argv(ai)); ai = ai + 1; }
            }
            elif (streq(argv(ai), "--no-deps") == 1) {
                _skip_deps = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--strict-pin") == 1) {
                _strict_pin = 1;
                ai = ai + 1;
            }
            # v6.4.64: the flag's EFFECT is applied earlier (the freshness check runs
            # beside _auto_deps, before this loop), and the pre-scan already set
            # _check_lib_sync — but this loop must still CONSUME it or it falls through
            # to the unknown-flag error below. v6.4.63 shipped it advertised-but-rejected:
            # the only path that appeared to work was a project WITH drift, where the
            # check exits non-zero before reaching this loop. sandhi 1.9.0 hit it on a
            # clean lib/ and filed it. (issue build-check-lib-sync-flag-advertised-but-rejected.)
            elif (streq(argv(ai), "--check-lib-sync") == 1) {
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--strict") == 1) {
                _strict = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--agnos") == 1) {
                _agnos_target = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--win") == 1) {
                _win_target = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--target=js") == 1) {
                # v6.1.12: route to cycc's TS/TSX → browser-JS emitter (v6.1.11)
                # instead of the native compile path. x86-Linux-only.
                _js_target = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--target=cx") == 1) {
                # cx arc: route to the cx bytecode compiler (cycc_cx) → a .cyx
                # portable-bytecode file. Run with `cyrius run <out>.cyx` (cxvm).
                _cx_target = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--target=x86_64-bare-metal-elf") == 1) {
                # v6.2.27: first-class bare-metal triple. build.cyr injects
                # CYRIUS_KERNEL=1 (forces kernel_mode) + CYRIUS_ELF64_KERNEL=1.
                # _skip_deps: a freestanding kernel must NOT auto-prepend the
                # userland stdlib (io.cyr/sys_* assume syscalls that don't exist
                # on bare metal) — the kernel source includes freestanding libs
                # explicitly. (D4 no-runtime-assumptions.)
                _baremetal_target = 1;
                _skip_deps = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--target=aarch64-bare-metal-elf") == 1) {
                # v6.2.27: aarch64 bare-metal triple → routes to the aarch64
                # cross-compiler (cc_arm) with the same kernel-mode env knobs.
                # set_arch so current_cc()/arch_name() agree with the target —
                # else (review P1) a missing cycc_aarch64 silently falls through
                # to the x86 cycc and builds an x86 kernel labelled [x86_64].
                set_arch(ARCH_AARCH64);
                _baremetal_target = 1;
                _baremetal_aa = 1;
                _skip_deps = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--features") == 1) {
                # v6.3.1 lever 2: value already parsed by the pre-_auto_deps scan;
                # consume both tokens here so <source>/<output> indexing stays right.
                ai = ai + 1;
                if (argc() > ai) { ai = ai + 1; }
            }
            elif (streq(argv(ai), "--no-default-features") == 1) {
                ai = ai + 1;
            }
            else {
                # An unrecognized token that LOOKS like a flag (`-…`) must
                # NOT fall through into positional parsing — that shifts
                # <source>/<output> by one and silently writes the build
                # output over a source file (data loss; issue 2026-04-26).
                # A bare positional (no leading `-`) is the source → stop.
                if (load8(argv(ai)) == 45) {
                    sys_write(STDERR_FD, "error: unknown flag '", 21);
                    sys_write(STDERR_FD, argv(ai), strlen(argv(ai)));
                    sys_write(STDERR_FD, "'\n", 2);
                    return 1;
                }
                break;
            }
        }
        if (vec_len(defs) > 0) { _defines = defs; }
        # v6.5.49 — fall back to `[build] src` / `[build] output` in ./cyrius.cyml.
        # A project that already declares both paths should not repeat them on every
        # invocation. Command-line arguments always WIN, so the override ladder is:
        #   cyrius build                 → manifest src + manifest output
        #   cyrius build <src>           → that src   + manifest output
        #   cyrius build <src> <out>     → both explicit (unchanged behaviour)
        # ⚠ The manifest is consulted only for the arguments NOT given. Reading it when both
        # are present would let a stale manifest key override an explicit command line, which
        # is the opposite of what a flag is for.
        var b_src = 0;
        var b_out = 0;
        if (argc() < ai + 2) {
            b_src = _manifest_build_key("src", 3);
            b_out = _manifest_build_key("output", 6);
        }
        if (argc() >= ai + 1) { b_src = argv(ai); }
        if (argc() >= ai + 2) { b_out = argv(ai + 1); }
        if (b_src == 0 || b_out == 0) {
            println("Usage: cyrius build [--aarch64|--win|--agnos|--target=js] [-v] [-q] [--no-deps] [--strict] [--strict-pin] [--check-lib-sync] [--features <list>] [--no-default-features] [-D NAME]... [<source> [<output>]]");
            println("  --check-lib-sync   fail the build if ./lib/ is a stale version vs the pinned snapshot (CI)");
            println("  <source>/<output> may be omitted when ./cyrius.cyml declares [build] src / output.");
            return 1;
        }
        return cmd_build(b_src, b_out);
    }

    if (streq(cmd, "run") == 1) {
        var ai = 2;
        while (argc() > ai) {
            if (streq(argv(ai), "--aarch64") == 1) {
                set_arch(ARCH_AARCH64);
                ai = ai + 1;
            }
            elif (streq(argv(ai), "-v") == 1) {
                _verbose = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--dry-run") == 1) {
                _dry_run = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--features") == 1) {
                ai = ai + 1;                       # v6.3.1 lever 2: value parsed in pre-scan
                if (argc() > ai) { ai = ai + 1; }
            }
            elif (streq(argv(ai), "--no-default-features") == 1) {
                ai = ai + 1;
            }
            else { break; }
        }
        if (argc() <= ai) {
            println("Usage: cyrius run [--aarch64] [--dry-run] [--features <list>] [--no-default-features] <source.cyr>");
            return 1;
        }
        return cmd_run(argv(ai));
    }

    if (streq(cmd, "test") == 1) {
        var ai = 2;
        while (argc() > ai) {
            if (streq(argv(ai), "--aarch64") == 1) {
                set_arch(ARCH_AARCH64);
                ai = ai + 1;
            }
            elif (streq(argv(ai), "-v") == 1) {
                _verbose = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--dry-run") == 1) {
                _dry_run = 1;
                ai = ai + 1;
            }
            elif (streq(argv(ai), "--features") == 1) {
                ai = ai + 1;                       # v6.3.1 lever 2: value parsed in pre-scan
                if (argc() > ai) { ai = ai + 1; }
            }
            elif (streq(argv(ai), "--no-default-features") == 1) {
                ai = ai + 1;
            }
            else { break; }
        }
        if (argc() > ai) {
            return cmd_test(argv(ai));
        }
        # No args: auto-discover every .tcyr under tests/, at ANY depth.
        #
        # v6.5.11: RECURSIVE, via the same `_tests_walk` the plural `cyrius tests`
        # verb has used since v6.0.62. This was two depth-1 `dir_list` scans
        # (tests/tcyr, then tests), so a test in a subfolder silently never ran
        # while the verb still exited 0 — the same defect the v6.5.7 pass fixed for
        # bench/fuzz and never brought this verb along with. See axis 4 of
        # tests/gates/toolchain/scaffold_verb_discovery.sh: top-level-only is a
        # defect, not a design choice.
        #
        # ONE root, deliberately: tests/tcyr lives UNDER tests/, so walking both
        # recursively would visit every file in it TWICE (axis 7's double-count).
        _pass = 0; _fail = 0;
        _tests_found = 0;
        if (is_dir(str_from("tests")) == 1) {
            _tests_walk("tests");
        }
        if (_tests_found == 0) {
            println("No .tcyr files found under tests/");
            return 1;
        }
        sys_write(STDOUT_FD, "\n", 1);
        fmt_int(_pass);
        sys_write(STDOUT_FD, " passed, ", 9);
        fmt_int(_fail);
        println(" failed");
        if (_fail > 0) { return 1; }
        return 0;
    }

    # v6.0.62: plural verb — recursive folder/suite runner. `cyrius tests`
    # walks tests/ at any depth; `cyrius tests <dir>` scopes to a subtree.
    # Distinct from `cyrius test <file>` (single) + bare `cyrius test`
    # (shallow auto-discover), both unchanged.
    if (streq(cmd, "tests") == 1) {
        var ti = 2;
        while (argc() > ti) {
            if (streq(argv(ti), "--aarch64") == 1) {
                set_arch(ARCH_AARCH64);
                ti = ti + 1;
            }
            elif (streq(argv(ti), "-v") == 1) {
                _verbose = 1;
                ti = ti + 1;
            }
            elif (streq(argv(ti), "--dry-run") == 1) {
                _dry_run = 1;
                ti = ti + 1;
            }
            elif (streq(argv(ti), "--features") == 1) {
                ti = ti + 1;                       # v6.3.1 lever 2: value parsed in pre-scan
                if (argc() > ti) { ti = ti + 1; }
            }
            elif (streq(argv(ti), "--no-default-features") == 1) {
                ti = ti + 1;
            }
            else { break; }
        }
        if (argc() > ti) {
            return cmd_tests(argv(ti));
        }
        return cmd_tests("tests");
    }

    if (streq(cmd, "bench") == 1) {
        if (argc() > 2) { return cmd_bench(argv(2)); }
        return cmd_bench(0);
    }

    if (streq(cmd, "check") == 1) {
        if (argc() < cmd_idx + 2) {
            println("Usage: cyrius check [--with-deps] <source.cyr>");
            return 1;
        }
        # Walk the args after `check` looking for --with-deps + source.
        # Default skip_deps unless --with-deps given. Source is the
        # first non-flag arg after `check`.
        var ck_with_deps = 0;
        var ck_src = 0;
        var ck_i = cmd_idx + 1;
        while (ck_i < argc()) {
            if (streq(argv(ck_i), "--with-deps") == 1) { ck_with_deps = 1; }
            elif (streq(argv(ck_i), "--help") == 1) {
                println("Usage: cyrius check [--with-deps] <source.cyr>");
                println("");
                println("  Default: parse <source> standalone (no manifest dep auto-prepend).");
                println("  --with-deps   prepend manifest [deps] entries (legacy behavior).");
                return 0;
            }
            else { if (ck_src == 0) { ck_src = argv(ck_i); } }
            ck_i = ck_i + 1;
        }
        if (ck_src == 0) {
            println("Usage: cyrius check [--with-deps] <source.cyr>");
            return 1;
        }
        return cmd_check(ck_src, ck_with_deps);
    }

    if (streq(cmd, "self") == 1) {
        return cmd_self();
    }

    if (streq(cmd, "clean") == 1) {
        if (argc() > 2 && streq(argv(2), "--dry-run") == 1) { _dry_run = 1; }
        return cmd_clean();
    }

    # v5.11.58: `cyrius lib sync` — overwrite cwd ./lib/*.cyr with
    # snapshot at ~/.cyrius/versions/<X>/lib/, where <X> is the
    # cyrius.cyml pin (or wrapper version if no pin). Third
    # remediation for the shadow-lib warning (Item 4) besides
    # `delete ./lib/` and `CYRIUS_NO_WARN_SHADOW_LIB=1`.
    if (streq(cmd, "lib") == 1) {
        if (argc() > cmd_idx + 1) {
            if (streq(argv(cmd_idx + 1), "sync") == 1) {
                var li = cmd_idx + 2;
                while (li < argc()) {
                    if (streq(argv(li), "--dry-run") == 1) { _dry_run = 1; }
                    elif (streq(argv(li), "--full") == 1) { _lib_sync_full = 1; }
                    li = li + 1;
                }
                return cmd_lib_sync();
            }
        }
        println("Usage: cyrius lib sync [--dry-run] [--full]");
        return 1;
    }

    if (streq(cmd, "capacity") == 1) {
        var cap_check = 0;
        var cap_json = 0;
        var cap_src = 0;
        var ci = cmd_idx + 1;
        while (ci < argc()) {
            if (streq(argv(ci), "--check") == 1) { cap_check = 1; ci = ci + 1; }
            elif (streq(argv(ci), "--json") == 1) { cap_json = 1; ci = ci + 1; }
            else { cap_src = argv(ci); ci = ci + 1; }
        }
        if (cap_src == 0) {
            if (file_exists("src/main.cyr") == 1) { cap_src = "src/main.cyr"; }
            elif (file_exists("src/lib.cyr") == 1) { cap_src = "src/lib.cyr"; }
        }
        return cmd_capacity(cap_src, cap_check, cap_json);
    }

    if (streq(cmd, "soak") == 1) {
        var soak_n = 100;
        if (argc() > cmd_idx + 1) { soak_n = atoi(argv(cmd_idx + 1)); }
        return cmd_soak(soak_n);
    }

    if (streq(cmd, "smoke") == 1) {
        return cmd_smoke();
    }

    if (streq(cmd, "pulsar") == 1) { return cmd_pulsar(); }

    # --- Project commands ---
    if (streq(cmd, "init") == 1) {
        # Forward the full flag tail to the native scaffolder
        # (programs/cyrius-init.cyr). No bash fallback. The binary
        # prints its own usage on no/invalid args.
        return cmd_init(cmd_idx + 1);
    }

    if (streq(cmd, "deps") == 1) {
        if (argc() > cmd_idx + 1) {
            if (streq(argv(cmd_idx + 1), "--verify") == 1) { return cmd_deps_verify(); }
            if (streq(argv(cmd_idx + 1), "--lock") == 1) { return cmd_deps_lock(); }
            if (streq(argv(cmd_idx + 1), "--no-lock") == 1) { _no_lock = 1; }
            elif (streq(argv(cmd_idx + 1), "--help") == 1 || streq(argv(cmd_idx + 1), "-h") == 1) {
                println("Usage: cyrius deps [--verify | --lock | --no-lock | --help]");
                println("");
                println("Resolve [deps.NAME] entries from cyrius.cyml into lib/.");
                println("Each dep is git-cloned into ~/.cyrius/deps/<name>/<tag>/");
                println("(or $CYRIUS_HOME/deps/...) and symlinked into lib/.");
                println("");
                println("Default behavior:");
                println("  - Resolves all [deps] entries.");
                println("  - Writes cyrius.lock with sha256 of every resolved file.");
                println("    (v5.7.8: lockfile is on by default; pre-v5.7.8 was opt-in.)");
                println("");
                println("Flags:");
                println("  --verify    verify cyrius.lock matches the working lib/.");
                println("  --lock      explicit lockfile write (default-on; redundant).");
                println("  --no-lock   suppress cyrius.lock write for this run.");
                println("  --help, -h  print this message.");
                println("");
                println("Related: cyrius update    re-resolve to latest tags.");
                return 0;
            }
        }
        return cmd_deps();
    }

    if (streq(cmd, "publish") == 1) { return cmd_publish(); }

    if (streq(cmd, "package") == 1) {
        return cmd_package();
    }

    if (streq(cmd, "install") == 1) {
        println("Package registry not yet available.");
        println("Install from source: git clone <repo> && cyrius build");
        return 0;
    }

    if (streq(cmd, "update") == 1) {
        return cmd_update();
    }

    if (streq(cmd, "port") == 1) {
        # Forward the full flag tail to the native scaffolder in port
        # mode (--__mode=port sentinel prepended). No bash fallback.
        return cmd_port(cmd_idx + 1);
    }

    if (streq(cmd, "header") == 1) {
        if (argc() < 3) {
            println("Usage: cyrius header <source.cyr>");
            return 1;
        }
        return cmd_header(argv(2));
    }

    # --- Quality commands ---
    if (streq(cmd, "fmt") == 1) {
        if (argc() < 3) {
            println("Usage: cyrius fmt <file.cyr> [--check | --dry | --verbose]");
            println("  (no flag)   rewrite the file in place");
            println("  --check     exit 1 if not canonically formatted, and say where");
            println("  --dry       report what would change; leave the file alone");
            println("  --verbose   rewrite in place AND echo the result to stdout");
            return 1;
        }
        # v6.5.28 — flags scanned across ALL args, not just argv(3), so
        # `cyrius fmt --dry f.cyr` works as well as `cyrius fmt f.cyr --dry`.
        var check = 0;
        var ffile = 0;
        var fi = 2;
        while (fi < argc()) {
            var fa = argv(fi);
            if (streq(fa, "--check") == 1) { check = 1; }
            elif (streq(fa, "--dry") == 1) { check = 2; }
            elif (streq(fa, "--verbose") == 1) { check = 3; }
            elif (ffile == 0) { ffile = fa; }
            fi = fi + 1;
        }
        if (ffile == 0) {
            println("Usage: cyrius fmt <file.cyr> [--check | --dry | --verbose]");
            return 1;
        }
        return cmd_fmt(ffile, check);
    }

    if (streq(cmd, "lint") == 1) {
        if (argc() < 3) {
            println("Usage: cyrius lint [--strict] <file.cyr>");
            return 1;
        }
        # File = first non-flag arg after the subcommand; --strict opt-in.
        var lstrict = 0;
        var lfile = 0;
        var li = 2;
        while (li < argc()) {
            var la = argv(li);
            if (streq(la, "--strict") == 1) { lstrict = 1; }
            elif (lfile == 0) { lfile = la; }
            li = li + 1;
        }
        if (lfile == 0) {
            println("Usage: cyrius lint [--strict] <file.cyr>");
            return 1;
        }
        return cmd_lint(lfile, lstrict);
    }

    if (streq(cmd, "doc") == 1) {
        if (argc() < 3) {
            println("Usage: cyrius doc [--check] <file.cyr>");
            return 1;
        }
        if (argc() > 3) {
            return cmd_doc(argv(2), argv(3));
        }
        return cmd_doc(argv(2), 0);
    }

    if (streq(cmd, "vet") == 1) {
        if (argc() < 3) {
            println("Usage: cyrius vet <source.cyr>");
            return 1;
        }
        return cmd_vet(argv(2));
    }

    if (streq(cmd, "deny") == 1) {
        if (argc() < 3) {
            println("Usage: cyrius deny <source.cyr>");
            return 1;
        }
        return cmd_deny(argv(2));
    }

    # v5.7.33: api-surface — snapshot-based public API diff.
    # v5.9.12: forward `--scope=project` (v5.9.11 agnosys flag) too —
    # the v5.7.33 dispatcher only parsed `--update`, so the scope
    # flag was dropped before reaching `cyrius_api_surface`.
    # Reported by user 2026-05-06: "5.9.11 --scope= NO OPS".
    # v5.9.13: forward `--snapshot=PATH` too (same shape; pinned as
    # follow-up at v5.9.12 ship).
    if (streq(cmd, "api-surface") == 1) {
        var update_flag = 0;
        var scope_project = 0;
        var snapshot_arg = 0;
        var ai = 2;
        while (ai < argc()) {
            var fa = argv(ai);
            if (streq(fa, "--update") == 1) { update_flag = 1; }
            if (streq(fa, "--scope=project") == 1) { scope_project = 1; }
            if (strlen(fa) > 11) {
                if (memeq(fa, "--snapshot=", 11) == 1) { snapshot_arg = fa; }
            }
            ai = ai + 1;
        }
        return cmd_api_surface(update_flag, scope_project, snapshot_arg);
    }

    if (streq(cmd, "audit") == 1) {
        # v6.2.25 (the chosen semantics, finally wired): default `cyrius audit` is
        # the PROJECT sweep (fmt / lint / docs / tests / bench) over the current
        # project — works in any repo, needs no scripts/check.sh. `--internal`
        # runs the cyrius-internal check.sh; `--internal=platform-check` adds the
        # cross-OS real-hardware self-host. mode: 0=sweep, 1=check.sh, 2=+cross-OS.
        var _amode = 0;
        var _aai = cmd_idx + 1;
        while (_aai < argc()) {
            if (streq(argv(_aai), "--internal") == 1) { _amode = 1; }
            elif (streq(argv(_aai), "--internal=platform-check") == 1) { _amode = 2; }
            else {
                # v6.5.8: `audit` used to absorb ANY extra argument silently and sweep the
                # whole project anyway, so a mistyped flag or a stray path produced a
                # full-looking PASS for something nobody asked for.
                _err_ctx("audit: unknown argument", argv(_aai));
                return 1;
            }
            _aai = _aai + 1;
        }
        return cmd_audit(_amode);
    }

    if (streq(cmd, "fuzz") == 1) {
        # v6.5.7: accept an explicit file or subfolder, like bench/tests.
        # v6.5.29: `--poison` turns on the allocator poison mode for every harness compiled
        # in this run — redzones, poison fill and quarantine-on-free — so an out-of-bounds
        # READ or a use-after-free becomes observable. Scanned across ALL args (not just
        # argv(2)) so `cyrius fuzz fuzz/x.fcyr --poison` and `cyrius fuzz --poison` both work,
        # and the flag is not mistaken for the path argument.
        var _fzi = 2;
        var _fzpath = 0;
        while (_fzi < argc()) {
            var _fza = argv(_fzi);
            if (streq(_fza, "--poison") == 1) { _poison_mode = 1; }
            elif (_fzpath == 0) { _fzpath = _fza; }
            _fzi = _fzi + 1;
        }
        if (_poison_mode == 1) { println("poison mode: redzones + fill + quarantine-on-free ACTIVE"); }
        return cmd_fuzz(_fzpath);
    }

    # --- Testing commands ---
    if (streq(cmd, "coverage") == 1) {
        return cmd_coverage();
    }

    if (streq(cmd, "doctest") == 1) {
        if (argc() < 3) {
            println("Usage: cyrius doctest <file.cyr>");
            return 1;
        }
        return cmd_doctest(argv(2));
    }

    # --- Interactive ---
    if (streq(cmd, "repl") == 1) {
        return cmd_repl();
    }

    # --- LSP ---
    if (streq(cmd, "lsp") == 1) {
        # Build and install cyrius-lsp
        println("Building cyrius-lsp...");
        var lsp_src = "programs/cyrius-lsp.cyr";
        if (file_exists(lsp_src) == 0) {
            _err("programs/cyrius-lsp.cyr not found");
            return 1;
        }
        var lsp_out = _cbt_tmpfile("lsp");
        var cr = compile(lsp_src, lsp_out);
        if (cr != 0) {
            _err("failed to build cyrius-lsp");
            return 1;
        }
        # Install to CYRIUS_HOME/bin/
        if (_home != 0) {
            var dest = make_path(_home, "bin/cyrius-lsp");
            # v6.5.37 (A0) — CHECK THE COPY. This ignored `_dep_copy_file`'s return and
            # printed "Installed: <path>" unconditionally, so any failed write reported
            # success. That is not hypothetical: the first cut of the symlinked-destination
            # guard (earlier this release) was ungated, and `~/.cyrius/bin` IS a symlink into
            # `versions/<v>/bin` on a normal install — so the copy was refused and this still
            # said Installed. The guard is now vendor-gated so it cannot fire here, but a
            # write that reports success it did not achieve is its own defect: ENOSPC, a
            # read-only /home, a bad `lsp_out` all took the same silent path.
            var lcr = _dep_copy_file(lsp_out, dest);
            if (lcr == 1) {
                _err("failed to install cyrius-lsp");
                return 1;
            }
            sys_chmod(dest, 493);
            sys_write(STDOUT_FD, "Installed: ", 11);
            println(dest);
        } else {
            println("Compiled: /tmp/cyrius-lsp");
            println("Copy to your PATH manually.");
        }
        return 0;
    }

    # --- Info commands ---
    var is_ver = streq(cmd, "version");
    if (is_ver == 0) { is_ver = streq(cmd, "--version"); }
    if (is_ver == 0) { is_ver = streq(cmd, "-v"); }
    if (is_ver == 1) {
        # cyrius version --project → project version (from ./VERSION)
        if (argc() > 2) {
            if (streq(argv(2), "--project") == 1) {
                sys_write(STDOUT_FD, _version, strlen(_version));
                sys_write(STDOUT_FD, "\n", 1);
                return 0;
            }
        }
        # cyrius version → THIS binary's compile-time version
        # (v5.11.26 fix: pre-fix this read ~/.cyrius/current, which is
        # the global default — not the binary's own version. With the
        # v5.11.25 per-repo dispatcher re-execing into pinned binaries,
        # reporting the global was misleading: a re-exec'd 5.11.18
        # binary would still print 5.11.24 because that's what
        # `current` said. _VERSION_TOOLCHAIN is the compile-time
        # embedded version of THIS binary specifically.)
        sys_write(STDOUT_FD, "cyrius ", 7);
        sys_write(STDOUT_FD, _VERSION_TOOLCHAIN, strlen(_VERSION_TOOLCHAIN));
        sys_write(STDOUT_FD, "\n", 1);
        # v5.11.58: when run inside a project tree (cwd has
        # cyrius.cyml with [package].cyrius = "X.Y.Z"), append
        # a `manifest-pin:` line so consumers spot toolchain
        # drift the moment they check what wrapper they're
        # running. Iron-boot papercut filing Item 1 (wrapper-
        # side surface; cycc-side detection landed at v5.11.57).
        var _ver_pin = _dep_read_cyml_cyrius_field();
        if (_ver_pin != 0) {
            sys_write(STDOUT_FD, "manifest-pin: ", 14);
            sys_write(STDOUT_FD, _ver_pin, strlen(_ver_pin));
            if (streq(_ver_pin, _VERSION_TOOLCHAIN) != 1) {
                sys_write(STDOUT_FD, " (drift — wrapper is ", 23);
                sys_write(STDOUT_FD, _VERSION_TOOLCHAIN, strlen(_VERSION_TOOLCHAIN));
                sys_write(STDOUT_FD, ")", 1);
            }
            sys_write(STDOUT_FD, "\n", 1);
        }
        return 0;
    }

    if (streq(cmd, "which") == 1) {
        println(_cc);
        return 0;
    }

    if (streq(cmd, "hooks") == 1) {
        var haction = "install";
        if (argc() > cmd_idx + 1) { haction = argv(cmd_idx + 1); }
        return cmd_hooks(haction);
    }

    var is_help = streq(cmd, "help");
    if (is_help == 0) { is_help = streq(cmd, "--help"); }
    if (is_help == 0) { is_help = streq(cmd, "-h"); }
    if (is_help == 1) {
        usage();
        return 0;
    }

    # Unknown command
    sys_write(STDERR_FD, "Unknown command: ", 17);
    println(cmd);
    println("Run 'cyrius help' for usage.");
    return 1;
}

var exit_code = main();
# v6.0.9 — use SYS_EXIT constant (60 on x86_64, 93 on aarch64) so
# the wrapper exits correctly on both arches. Raw syscall(60, ...)
# called clock_gettime on aarch64 instead of exit, dropping the
# exit code on the floor.
syscall(SYS_EXIT, exit_code);
