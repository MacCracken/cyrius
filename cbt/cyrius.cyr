# cyrius — Cyrius Build Tool
# Written in Cyrius. Modular — see sibling .cyr files.
#
# Build:     build, run, test, bench, check, self, clean
# Project:   init, package, publish, install, update, port
# Quality:   audit, fmt, lint, doc, vet, deny, coverage, doctest, header
# Interactive: repl
# Info:      version, which, help

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"
include "lib/fs.cyr"
include "lib/tagged.cyr"
include "lib/process.cyr"
include "lib/syscalls.cyr"
include "lib/audit_walk.cyr"   # v6.2.25: fmt/lint/doc walkers for `cyrius audit` sweep

include "src/version_str.cyr"

include "cbt/core.cyr"
# v6.6.5: THE ONE ARGUMENT RULE — after core (it reads core's globals), before build
# (compile() reads _pie_target).
include "cbt/cli_args.cyr"
include "cbt/build.cyr"
include "cbt/commands.cyr"
include "cbt/project.cyr"
include "cbt/quality.cyr"
include "cbt/deps.cyr"
include "cbt/pulsar.cyr"

# ================================================================
# Usage / help
# ================================================================

fn usage(): i64 {
    println("Cyrius Build Tool");
    println("");
    println("");
    println("Usage: cyrius [-q|-v] <command> [options] [operands]");
    println("");
    println("  Flags may appear in any position. A '-'-prefixed token a command does");
    println("  not declare is an error naming the token, never a file name, and an");
    println("  operand is never dropped. `cyrius <command> --help` lists that");
    println("  command's flags (printed from the same table the parser reads).");
    println("");
    println("Build:");
    println("  build [--aarch64|--win|--agnos] [--no-deps] [--strict] [--pie] [--features <list>] [-D NAME]... <src> <out>");
    println("  run [--aarch64] <source.cyr> [args...]   compile + run (args go to the program)");
    println("  test [--aarch64] <test.tcyr>...  compile + run each, check exit 0");
    println("  tests [--aarch64] [dir]         recursively run all .tcyr under dir (default tests/)");
    println("  bench <bench.cyr>               compile + run benchmarks");
    println("  check [--with-deps] <src.cyr>...  syntax check (default: standalone)");
    println("  sign-efi <pe> <key.der> <cert.der> <out>   Authenticode-sign a PE for UEFI Secure Boot (via cyrsign-efi)");
    println("  distlib [--all|--check] [--modular] [profile]   bundle src/ into dist/ (--all = base + every [lib.X]; --check = verify, don't write)");
    println("  self                            self-hosting check (cycc==cycc)");
    println("  clean                           remove build/ contents");
    println("  lib sync [--dry-run] [--full]   vendor declared [deps].stdlib from pin (--full = whole snapshot)");
    println("");
    println("Project:");
    println("  init [--lib|--agent|--cmtools|--dry-run] <name | .>   scaffold a new project");
    println("  deps [--no-lock|--verify]       resolve [deps.NAME] from cyrius.cyml into lib/");
    println("  update                          re-resolve all deps to latest tags");
    println("  package                         create .ark distributable");
    println("  port [--dry-run] <rust-project> scaffold from a Rust project (→ rust-old/)");
    println("");
    println("Quality:");
    println("  audit                           project sweep: fmt/lint/docs/tests/bench");
    println("  audit --internal                cyrius-internal full gate (scripts/check.sh)");
    println("  audit --internal=platform-check   + cross-OS real-hardware self-host");
    println("    --internal=platform-check     + cross-OS self-host on REAL hw (ecb/ach/pi/cass)");
    println("  fuzz                            run fuzz/*.fcyr harnesses");
    println("  fmt [--check|--dry|--verbose|--write] <file.cyr>...   format code");
    println("  lint [--strict] [--strict-deferrals] [--exit-with-count] <file.cyr>...");
    println("  doc [--check] <file.cyr>...     generate/check documentation");
    println("  vet <source.cyr>                audit include dependencies");
    println("  deny <source.cyr>               enforce project policies");
    println("");
    println("Testing:");
    println("  coverage [--full] [--min <pct>]  reference coverage of project src/ (--full=vendored lib/; --min gates CI)");
    println("  doctest <file.cyr>              run doc examples");
    println("  soak [N]                        N-iter self-host loop + tests/scyr/*.scyr harnesses");
    println("  smoke                           run tests/smcyr/*.smcyr quick-validation programs");
    println("");
    println("Interactive:");
    println("  repl                            expression evaluator");
    println("");
    println("Tools:");
    println("  lsp                             build + install cyrius-lsp");
    println("");
    println("Info:");
    println("  version                         show cyrius toolchain version");
    println("  version --project               show project version (from VERSION)");
    println("  which                           show path to cycc");
    println("  hooks install                   install the build-artifact pre-commit hook");
    println("  help                            show this help");
    return 0;
}

# ================================================================
# Per-repo version-resolved dispatch (v5.11.25 — Part 2 of the
# per-repo isolation arc; Part 1 shipped at v5.11.17 in cbt/deps.cyr).
# ================================================================
#
# Runs BEFORE the command dispatch. If `cyrius.cyml`'s
# `[package].cyrius = "X.Y.Z"` field pins a different version than
# this binary represents, re-exec the pinned binary so the consumer
# always gets the toolchain version their cyml field names.
#
# Loop guard: `CYRIUS_RESOLVED=1` env var. Set by us before execve;
# detected on re-entry by `find_tools()` (sets `_cyrius_resolved`).
# Second-pass binary skips this fn and runs the command directly.
#
# Hard error if the pinned version isn't installed at
# `~/.cyrius/versions/<v>/bin/cyrius`. Never silently slides to
# `latest` — matches v5.11.17 deps stdlib_dir policy.
# Does `pin` name a release carrying a known Critical? Exact string matches only — a numeric
# range comparison would silently swallow future versions into a band they are not in.
fn _pin_has_known_critical(pin): i64 {
    # v6.5.36: enum constants >= 2^62 read back as -1 (an in-band tag needing a 65th bit).
    if (streq(pin, "6.5.31") == 1) { return 1; }
    if (streq(pin, "6.5.32") == 1) { return 1; }
    if (streq(pin, "6.5.33") == 1) { return 1; }
    if (streq(pin, "6.5.34") == 1) { return 1; }
    if (streq(pin, "6.5.35") == 1) { return 1; }
    return 0;
}

fn _try_redirect_to_pinned(): i64 {
    # ⛔ v6.5.37 — DO NOT DELEGATE A VENDOR WRITE INTO A SYMLINKED lib/.
    #
    # THE INCIDENT (2026-09-01) AND WHY THE GUARD IN _dep_copy_file IS NOT ENOUGH.
    # `nous/lib` was a directory symlink to `~/.cyrius/lib` -> `versions/6.5.36/lib`, the
    # LIVE stdlib snapshot. nous pins cyrius 6.3.35, so control never reached this binary's
    # resolver at all: THIS FUNCTION execve'd into `~/.cyrius/versions/6.3.35/bin/cyrius`
    # — a binary built months earlier that has no guard and never will — and THAT process
    # wrote 6.3.35-era stdlib straight through the symlink into the 6.5.36 snapshot. 27
    # files were replaced; `lib/alloc.cyr` lost `fn _alloc_zero`, the memory-reuse
    # information-leak fix from v6.4.1 (daimon VULN-007). Because `~/.cyrius/lib` is the
    # global default source, every other repo then READ the corruption back out — shabda
    # ingested it 12 seconds later.
    #
    # ⭐ So the check has to live HERE, before the execve, in the only binary guaranteed to
    # be current: `~/.cyrius/bin/cyrius` always points at the newest install. A guard that
    # exists only in the resolver protects repos pinned at >= 6.5.37 and NOTHING else —
    # and the repos most likely to carry a stale lib/ are exactly the old-pinned ones.
    #
    # Scoped to the verbs that vendor into lib/ so read-only commands still work in an
    # affected tree; the first non-flag argv entry is the verb (mirrors the cmd_idx loop
    # in main). ⚠ `is_symlink` returns 0 on Windows — no PE readlink wrapper — so this
    # does not fire on PE. Stated, not hidden.
    #
    # ⛔ v6.6.2 — THE SYMLINKED-lib/ GUARD RUNS BEFORE EVERY EARLY RETURN, INCLUDING
    # `_cyrius_resolved`. It used to sit ~80 lines below, after both the resolved-pass
    # early return and the cyrius-source-repo one, so `CYRIUS_RESOLVED=1` in the
    # environment DISARMED IT — the second-pass binary skipped the whole function, and
    # with it the only guard that runs before an old delegated binary gets to vendor.
    # The v6.5.37 note above explains why this check has to live in the wrapper rather
    # than the resolver: the resolver guard (`_dep_dest_is_linked`) exists only in
    # binaries >= 6.5.37, and the repos most likely to carry a stale lib/ are exactly the
    # old-pinned ones. An env var must not be able to switch that off.
    # ⚠ It stays ordered ahead of the "is the pinned version installed?" check: a symlinked
    # lib/ is wrong regardless of whether the pin resolves, and refusing first makes the
    # refusal reachable without depending on which versions happen to be installed — which
    # is what lets tests/gates/toolchain/deps_symlinked_lib_refused.sh pin a deliberately
    # absent version and still exercise this path deterministically.
    # ⚠ Safe above the source-repo return: this repo's ./lib is a real directory, so
    # `is_symlink` is 0 and the guard is inert here.
    # ⚠ `is_symlink` returns 0 on Windows (no PE readlink wrapper) — stated, not hidden.
    var _vi = 1;
    var _verb = 0;
    while (_vi < argc()) {
        if (load8(argv(_vi)) != 45) { _verb = argv(_vi); break; }   # 45 = '-'
        _vi = _vi + 1;
    }
    if (_verb != 0) {
        var _writes = 0;
        if (streq(_verb, "deps") == 1) { _writes = 1; }
        if (streq(_verb, "lib") == 1) { _writes = 1; }
        if (streq(_verb, "install") == 1) { _writes = 1; }
        if (streq(_verb, "update") == 1) { _writes = 1; }
        if (_writes == 1 && is_symlink(str_from("lib")) == 1) {
            _dep_refuse_symlinked_dest("lib");
            _cbt_exit(1);   # sweeps the private temp dir — CHANGELOG [6.6.6]
        }
    }

    if (_cyrius_resolved == 1) { return 0; }

    # ⛔ v6.5.37 — THE THIRD OCCURRENCE OF THE `src/main.cyr` ≠ cyrius-repo CONFLATION.
    #
    # This used to read `file_exists("src/main.cyr")`, meaning "am I the cyrius source
    # repo?". It is true for essentially EVERY cyrius project: `src/main.cyr` is the entry
    # point `cyrius init` generates. So the pin redirect below was skipped for almost every
    # consumer, and the manifest's `cyrius = "X.Y.Z"` was silently ignored.
    #
    # Measured on 6.5.36, same repo, one file's difference:
    #     pinned 6.3.35, no src/main.cyr  -> `cyrius --version` reports 6.3.35   (honoured)
    #     pinned 6.3.35, + src/main.cyr   -> reports 6.5.36
    #                                        "manifest-pin: 6.3.35 (drift — wrapper is 6.5.36)"
    # The tool PRINTED the pin it was ignoring, which is why this survived: every symptom
    # said "drift", and drift reads like a stale manifest rather than a defect here.
    #
    # ⚠ THE COMMENT THIS REPLACES CITED ITS OWN BUG AS PRECEDENT — "the deps stdlib_dir
    # Part 1 (v5.11.17) already gates on this signal — match for consistency". That gate was
    # itself the same defect, and v6.5.25 fixed it (bote/agnosai/majra: the probe matched the
    # consumer's own half-populated ./lib and returned it AS the stdlib). Its fix note said:
    # "`_dep_is_cyrius_source_repo()` exists precisely for this ... When a 'am I the cyrius
    # repo?' test is needed, use that helper; never a filename probe." It was written for the
    # `cyrius audit` fix (v6.0.1, again v6.4.63), applied to stdlib_dir at v6.5.25, and never
    # applied here. Three sites, one shape, fixed one at a time — GREP THE SHAPE, NOT THE SITE.
    #
    # `_dep_is_cyrius_source_repo()` matches `[package].name` exactly, so `cyrius-x` does not
    # qualify. Blast radius measured across ~180 sibling repos before landing: 94 begin
    # honouring a pin they had been ignoring, and ALL 94 have that version installed — zero
    # would hit the "pinned version is not installed" error below.
    #
    # ⭐ This cuts the same way as the symlinked-lib guard added above: honouring pins means
    # MORE delegation to old binaries, so that guard had to exist first. It does.
    if (_dep_is_cyrius_source_repo() == 1) { return 0; }

    var pin = _dep_read_cyml_cyrius_field();
    if (pin == 0) { return 0; }

    # Compare with self version (compile-time embed via version_str.cyr).
    if (streq(pin, _VERSION_TOOLCHAIN) == 1) { return 0; }

    # ⛔ The symlinked-lib/ vendor guard that used to live HERE was hoisted to the top of
    # this function at v6.6.2 — it has to run before the `_cyrius_resolved` early return,
    # or `CYRIUS_RESOLVED=1` switches it off. Full incident note is at the hoisted site.
    # ⛔ v6.5.47 — WARN WHEN THE PIN LANDS ON A RELEASE WITH A KNOWN CRITICAL.
    # v6.5.36 fixed a Critical that shipped live in 6.5.31 through 6.5.35: an enum constant
    # >= 2^62 read back as -1, because the tag occupied a 65th bit of a 64-bit slot. Measured at
    # v6.5.47: **50** manifests under ~/Repos pin into that band.
    # ⚠ THEY ARE CURRENTLY PROTECTED BY A SECOND DEFECT, WHICH IS NOT A REASON TO STAY QUIET.
    # A pinned wrapper older than 6.5.44 does not resolve its own sibling `cycc`, so those repos
    # silently build with the CURRENT compiler and never meet the Critical. The moment that pin
    # is honoured — reinstalling the version, or the wrapper being rebuilt — 50 repos start
    # binding a compiler with a known miscompile. A warning is the only thing that survives
    # either outcome.
    # ⚠ ONE BAND, ONE REASON, LISTED EXPLICITLY. This is a hand-maintained fact, which this cycle
    # has repeatedly found going stale — so it is deliberately NOT a range check that would
    # silently widen: adding a future band means adding a row here and saying why.
    if (_pin_has_known_critical(pin) == 1) {
        sys_write(STDERR_FD, "warning: cyrius.cyml pins ", 26);
        sys_write(STDERR_FD, pin, strlen(pin));
        sys_write(STDERR_FD, ", which carries the v6.5.36 enum Critical (constants >= 2^62 read back as -1).\n         Re-pin to 6.5.36 or later.\n", 115);
    }

    # Build pinned binary path: ~/.cyrius/versions/<pin>/bin/cyrius.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, _home);
    str_builder_add_cstr(sb, "/versions/");
    str_builder_add_cstr(sb, pin);
    str_builder_add_cstr(sb, "/bin/cyrius");
    var pinned_bin = str_data(str_builder_build(sb));

    if (file_exists(pinned_bin) == 0) {
        sys_write(STDERR_FD, "error: cyrius.cyml pins version ", 32);
        sys_write(STDERR_FD, pin, strlen(pin));
        sys_write(STDERR_FD, " but cyrius binary is not installed at ", 39);
        sys_write(STDERR_FD, pinned_bin, strlen(pinned_bin));
        sys_write(STDERR_FD, "\n  run: cyrius install ", 23);
        sys_write(STDERR_FD, pin, strlen(pin));
        sys_write(STDERR_FD, "\n", 1);
        _cbt_exit(1);   # sweeps the private temp dir — CHANGELOG [6.6.6]
    }

    # Build new argv: [pinned_bin, original argv[1..]].
    var ac = argc();
    var nargv = alloc((ac + 1) * 8);
    store64(nargv, pinned_bin);
    var i = 1;
    while (i < ac) {
        store64(nargv + i * 8, argv(i));
        i = i + 1;
    }
    store64(nargv + ac * 8, 0);

    # Build new envp: existing _envp + "CYRIUS_RESOLVED=1" + NUL.
    var ev_count = 0;
    while (load64(_envp + ev_count * 8) != 0) { ev_count = ev_count + 1; }
    var nenvp = alloc((ev_count + 2) * 8);
    var ej = 0;
    while (ej < ev_count) {
        store64(nenvp + ej * 8, load64(_envp + ej * 8));
        ej = ej + 1;
    }
    store64(nenvp + ev_count * 8, "CYRIUS_RESOLVED=1");
    store64(nenvp + (ev_count + 1) * 8, 0);

    sys_execve(pinned_bin, nargv, nenvp);
    # execve only returns on failure.
    sys_write(STDERR_FD, "error: cyrius execve to pinned version failed\n", 46);
    _cbt_exit(1);   # sweeps the private temp dir — CHANGELOG [6.6.6]
    return 0;
}

# ================================================================
# Main dispatch
# ================================================================

# ── v6.6.4: released-slot guard for the CLI's own writers into the store ──────────────
# The store contract (scripts/install.sh, `--refresh-only`): `versions/<v>` is what a pin
# MEANS, and once <v> is tagged the slot must equal the tag. `cyrius pulsar` now installs
# through install.sh (which carries the guard); `cyrius lsp` writes `_home/bin/cyrius-lsp`
# — a symlink into `versions/<current>/bin` — so it checks the same predicate for
# <current>: tag exists AND the tree has moved past it AND the destination is live.
# CYRIUS_REFRESH_RELEASED=1 forces it, exactly as for install.sh.
fn _released_slot_guard_current(): i64 {
    if (_cbt_env_is_1("CYRIUS_REFRESH_RELEASED") == 1) { return 0; }
    # the version whose bin/ we are about to write: `current`, else the bin symlink's target
    var cur_buf = alloc(256);
    var cn = file_read_all(make_path(_home, "current"), cur_buf, 63);
    if (cn <= 0) {
        # no `current`: derive the version from the bin/ symlink target (POSIX stores only —
        # the Windows peer has no readlink and its bin/ is a copy, not a link into a slot)
        #ifdef CYRIUS_TARGET_WIN
        return 0;
        #endif
        #ifndef CYRIUS_TARGET_WIN
        var lb = alloc(1024);
        var ln = sys_readlink(make_path(_home, "bin"), lb, 1023);
        if (ln <= 0) { return 0; }              # no active version and bin/ is not a link: nothing released to protect
        store8(lb + ln, 0);
        # .../versions/<v>/bin → <v>
        var vi = 0; var vstart = 0 - 1;
        while (vi + 10 <= ln) {
            if (memeq(lb + vi, "/versions/", 10) == 1) { vstart = vi + 10; }
            vi = vi + 1;
        }
        if (vstart < 0) { return 0; }
        cn = 0;
        while (load8(lb + vstart + cn) != 0) {
            if (load8(lb + vstart + cn) == 47) { break; }
            store8(cur_buf + cn, load8(lb + vstart + cn)); cn = cn + 1;
            if (cn >= 63) { break; }
        }
        if (cn == 0) { return 0; }
        #endif
    }
    while (cn > 0) { if (load8(cur_buf + cn - 1) > 32) { break; } cn = cn - 1; }
    store8(cur_buf + cn, 0);
    # the version string is interpolated into a shell command below: allow [0-9A-Za-z._-] only
    var ci = 0;
    while (ci < cn) {
        var ch = load8(cur_buf + ci);
        var okc = 0;
        if (ch >= 48) { if (ch <= 57) { okc = 1; } }
        if (ch >= 65) { if (ch <= 90) { okc = 1; } }
        if (ch >= 97) { if (ch <= 122) { okc = 1; } }
        if (ch == 46) { okc = 1; }
        if (ch == 95) { okc = 1; }
        if (ch == 45) { okc = 1; }
        if (okc == 0) {
            sys_write(STDERR_FD, "error: refusing to write into the store: the active version name is not a plain version string\n", 95);
            return 1;
        }
        ci = ci + 1;
    }
    # same predicate as install.sh `_released_slot_guard`: tag exists ∧ inputs drifted ∧ live
    var tag_sb = str_builder_new();
    str_builder_add_cstr(tag_sb, "git rev-parse -q --verify refs/tags/");
    str_builder_add_cstr(tag_sb, cur_buf);
    str_builder_add_cstr(tag_sb, " >/dev/null 2>&1");
    if (sys_system(str_data(str_builder_build(tag_sb))) != 0) { return 0; }   # untagged (or no git): in flight
    var diff_sb = str_builder_new();
    str_builder_add_cstr(diff_sb, "git diff --quiet refs/tags/");
    str_builder_add_cstr(diff_sb, cur_buf);
    str_builder_add_cstr(diff_sb, " -- lib src cbt programs scripts bootstrap cyrius.cyml build 2>/dev/null && [ -z \"$(git ls-files --others --exclude-standard lib 2>/dev/null)\" ]");
    if (sys_system(str_data(str_builder_build(diff_sb))) == 0) { return 0; }   # tree == tag: idempotent
    var live = 0;
    var slot_sb = str_builder_new();
    str_builder_add_cstr(slot_sb, _home);
    str_builder_add_cstr(slot_sb, "/versions/");
    str_builder_add_cstr(slot_sb, cur_buf);
    if (file_exists(str_data(str_builder_build(slot_sb))) == 1) { live = 1; }
    # ... or the home IS the user's store (resolved through `pwd -P` so a symlinked $HOME or a
    # trailing slash cannot dodge it — the same compare install.sh makes)
    var home_sb = str_builder_new();
    str_builder_add_cstr(home_sb, "[ \"$(cd \"$CYRIUS_HOME\" 2>/dev/null && pwd -P)\" = \"$(cd \"$HOME/.cyrius\" 2>/dev/null && pwd -P)\" ]");
    if (sys_system(str_data(str_builder_build(home_sb))) == 0) { live = 1; }
    if (live == 0) { return 0; }                                                # a throwaway home
    sys_write(STDERR_FD, "error: refusing to write ", 25);
    sys_write(STDERR_FD, _home, strlen(_home));
    sys_write(STDERR_FD, "/bin/cyrius-lsp: the active version ", 36);
    sys_write(STDERR_FD, cur_buf, strlen(cur_buf));
    sys_write(STDERR_FD, " is a CUT RELEASE (its tag exists) and the tree has moved past it;\n", 67);
    sys_write(STDERR_FD, "       bin/ is a symlink into versions/", 39);
    sys_write(STDERR_FD, cur_buf, strlen(cur_buf));
    sys_write(STDERR_FD, "/bin, which every consumer pinning it resolves. Bump first (scripts/version-bump.sh <next>),\n", 93);
    sys_write(STDERR_FD, "       commit + re-tag (git tag -f <v> HEAD) if re-cutting, use a throwaway CYRIUS_HOME, or CYRIUS_REFRESH_RELEASED=1 to force.\n", 128);
    return 1;
}

fn main(): i64 {
    alloc_init();
    args_init();
    load_environ();
    find_tools();
    set_arch(ARCH_X86);
    # v6.0.34: an arm64 (Apple Silicon) Mach-O wrapper defaults to aarch64 so
    # current_cc() picks the native macho cycc_aarch64. v6.4.59: gate this on the
    # WRAPPER's OWN arch (CYRIUS_ARCH_AARCH64) — an Intel-Mac (x86-macho) wrapper
    # must KEEP the ARCH_X86 default above, else it picks [aarch64]/cycc_aarch64
    # and "compiler not found" on real Intel hardware (found on ach). Mirrors the
    # find_tools() guard in cbt/core.cyr. An explicit --aarch64 is handled below.
    # macho-only; Linux/Windows unchanged.
    #ifdef CYRIUS_TARGET_MACOS
    #ifdef CYRIUS_ARCH_AARCH64
    set_arch(ARCH_AARCH64);
    #endif
    #endif

    # v5.11.25: per-repo isolation Part 2.
    # If cyrius.cyml pins a different version, re-exec the pinned
    # binary. Skipped when CYRIUS_RESOLVED=1 (already re-exec'd) or
    # when running from the cyrius source repo (src/main.cyr present).
    _try_redirect_to_pinned();

    if (argc() < 2) {
        usage();
        return 0;
    }

    # Parse global flags before subcommand
    var cmd_idx = 1;
    while (cmd_idx < argc()) {
        if (streq(argv(cmd_idx), "-q") == 1 || streq(argv(cmd_idx), "--quiet") == 1) {
            _quiet = 1;
            cmd_idx = cmd_idx + 1;
        }
        elif (streq(argv(cmd_idx), "-v") == 1 || streq(argv(cmd_idx), "--verbose") == 1) {
            _verbose = 1;
            cmd_idx = cmd_idx + 1;
        }
        else { break; }
    }
    if (cmd_idx >= argc()) { usage(); return 0; }
    var cmd = argv(cmd_idx);

    # v6.6.5 — THE ONE ARGUMENT RULE (cbt/cli_args.cyr). ONE classifier for every
    # verb, run HERE: before _auto_deps, before any verb branch, before anything
    # writes. Flags in any position; a '-'-prefixed token the verb does not declare
    # is an error that NAMES it; operand counts enforced; indices from cmd_idx+1.
    #
    # It replaces the ~35 per-verb argument loops AND the v6.3.1 lever-2 pre-scan that
    # used to sit here purely so --features/--target were read before the resolver.
    # Every flag is now read before the resolver, which is also what finally makes
    # `--dry-run` mean "write nothing": it used to be set inside the build loop, i.e.
    # AFTER _auto_deps had already created lib/, and the deps branch never set it at
    # all, which is why cbt/deps.cyr's dry-run early return had never once run.
    # CHANGELOG [6.6.5].
    if (_cli_raw_tail(cmd) == 0) {
        if (_cli_known_verb(cmd) == 0) {
            sys_write(STDERR_FD, "Unknown command: ", 17);
            sys_write(STDERR_FD, cmd, strlen(cmd));
            sys_write(STDERR_FD, "\n", 1);
            println("Run 'cyrius help' for usage.");
            return 1;
        }
        if (_cli_parse(cmd, cmd_idx + 1) != 0) { return 1; }
        if (_cli_wants_help() == 1) {
            _cli_usage(cmd);
            _cli_help_extra(cmd);
            return 0;
        }
        if (_cli_apply(cmd) != 0) { return 1; }
    }

    # Auto-resolve deps before build/run/test/bench/fuzz/check.
    # v5.7.21: `fuzz` joins the gate. cmd_fuzz already calls compile()
    # which reads _dep_includes for auto-prepend, but pre-v5.7.21 the
    # gate skipped fuzz so _auto_deps never populated _dep_includes;
    # downstream fuzz harnesses had to declare every stdlib include
    # by hand or fail with `undefined function`. cmd_test / cmd_bench
    # had this from day one — gate now has parity.
    # v5.7.38: `soak` and `smoke` join the gate — same parity reasoning
    # as v5.7.21's fuzz fix. cmd_soak now walks `tests/scyr/*.scyr`
    # harnesses and cmd_smoke walks `tests/smcyr/*.smcyr` files; both
    # rely on compile() reading _dep_includes for stdlib auto-prepend.
    # v6.4.73: `audit` and `capacity` join the gate — the THIRD instance of
    # this exact bug class, and the worst, because both are the tools you
    # reach for to find out whether a project is healthy. `_audit_sweep`
    # calls cmd_tests + cmd_bench internally, but `audit` was never in this
    # list, so _dep_includes stayed empty and every stdlib fn came back
    # `undefined function 'alloc'` — stiva 3.0.6 reported `0 passed, 5
    # failed` under `cyrius audit` while `cyrius test` on the same tree
    # reported `202 passed, 0 failed`. It stayed invisible in-repo for a
    # year because 250 of cyrius's own 251 .tcyr files self-declare their
    # includes and never needed the auto-prepend — a textbook "found by
    # ports" gap. `capacity` needs it for the same reason (see
    # _materialize_source). CHANGELOG [6.4.73].
    # v6.5.17: `distlib` joins the gate — the FOURTH instance, filed by hisab.
    # v6.5.14 repaired distlib's bundle self-check (it had compiled to /dev/null
    # and never once run). The repaired check compiles the bundle through a
    # generated entry and downgrades undefined FNS with --allow-undef. But a
    # bundle ships no stdlib GLOBALS either, and an undefined variable is a
    # PARSE-TIME abort (src/frontend/parse_expr.cyr:589) that --allow-undef
    # cannot reach — it only gates the fixup stage. So the check needed the
    # manifest auto-prepend, and distlib was never in this list, so
    # _dep_includes was empty and no prepend was possible. Any bundle reading a
    # stdlib `var` or enum constant was reported as a DEFECTIVE BUNDLE and
    # distlib exited 1 — hisab's `F64_ONE` (the ordinary way to write 1.0 in a
    # language with no float literals), 44 of 69 [lib] repos on the filer s
    # machine. The bundle was correct; the check asked the wrong question.
    # ⚠ Setting _skip_deps = 0 is NOT sufficient on its own — _materialize_source
    # (cbt/build.cyr:378) also requires _dep_includes to be non-empty, and only
    # _auto_deps() fills it. Both halves are needed; a first attempt at this fix
    # set the flag alone and changed nothing.
    # v6.5.19: `doctest` (filed by agnosai) is the FIFTH instance, and auditing the
    # WHOLE verb set for it found two more already live — `publish` and `package`.
    # `publish` was created BY the v6.5.17 patch: cmd_publish calls cmd_distlib()
    # one call frame away, so adding the `distlib` STRING left the identical defect
    # (and the identical misleading "the generated bundle does not compile" text)
    # reachable through a different verb. That is the whole lesson of five patches:
    # **the requirement is a property of the CALL GRAPH, not of the verb string.**
    # Adding one more name to this list is not what stops the sixth instance —
    # tests/gates/toolchain/auto_deps_verb_gate.sh is. It enumerates every verb
    # main() dispatches, computes which ones transitively reach compile() /
    # _materialize_source() across all of cbt/, and FAILS if any of them is absent
    # from the list below. Exemptions live in that gate's allow-list, one reason
    # each — `pulsar` is the load-bearing one (auto-prepend makes it build a
    # 434,360-byte-larger cycc that is NOT the self-host fixpoint binary).
    #
    # ⚠ THE LIST IS NOT A FREE ADD. `lsp` was added here earlier in this same
    # release and taken straight back out: `cyrius lsp` compiles
    # programs/cyrius-lsp.cyr, which self-declares its 11 includes and only exists
    # inside this repo (the dispatcher hard-codes the path), so it never had the
    # missing-prepend bug — and it INSTALLS what it builds into CYRIUS_HOME/bin.
    # Gating it unioned the whole [deps].stdlib into a binary that already had
    # everything it needed: 119,584 B -> 507,144 B (4.24x, 516 unreachable fns),
    # measured at 6.5.19. That is precisely the `pulsar` condition, so `lsp` now
    # sits in the gate's EXEMPT_LIST with that reason. A verb belongs on the line
    # below when auto-prepend is REQUIRED for it to compile, not merely harmless.
    # The BEGIN/END markers are the gate's parse anchors: keep the verbs between
    # them and keep every OTHER streq(cmd, ...) a real dispatch site.
    # CHANGELOG [6.5.19].
    # AUTO_DEPS_VERBS BEGIN
    if (streq(cmd, "build") == 1 || streq(cmd, "run") == 1 || streq(cmd, "test") == 1 || streq(cmd, "tests") == 1 || streq(cmd, "bench") == 1 || streq(cmd, "fuzz") == 1 || streq(cmd, "soak") == 1 || streq(cmd, "smoke") == 1 || streq(cmd, "check") == 1 || streq(cmd, "audit") == 1 || streq(cmd, "capacity") == 1 || streq(cmd, "distlib") == 1 || streq(cmd, "doctest") == 1 || streq(cmd, "publish") == 1 || streq(cmd, "package") == 1) {
        # AUTO_DEPS_VERBS END
        var dr = _auto_deps();
        # v6.5.37 (A1) — clamp here too: _auto_deps propagates the same raw count, so a
        # 256-error resolve made `cyrius build` exit 0 as well.
        if (dr > 0) { return 1; }
        # v6.4.63: name any version skew between ./lib/ and the version-pinned
        # snapshot (yeo-cy-test filing). Sits OUTSIDE _auto_deps deliberately —
        # _auto_deps early-returns when cyrius.cyml has no [deps]/[deps.*]
        # section, and a FOLDED lib (sigil et al., vendored into lib/ and removed
        # from [deps]) is exactly that case: the one we most need to catch, since
        # a silent multi-version skew in the crypto bundle can withhold a security
        # fix. Warning by default; --check-lib-sync makes it fail the build.
        var lf = _check_lib_freshness(_check_lib_sync);
        if (_check_lib_sync == 1 && lf > 0) { return 1; }
    }

    # --- sign-efi: UEFI Authenticode PE signing ---
    # Dispatches to the separate `cyrsign-efi` helper binary (sigil's RSA bignum
    # scratch is ~13 MB of reachable static data — folding it into `cyrius` would
    # bloat the CLI 24x). execve replaces this process, so the helper's exit code
    # is ours. On non-Linux the sys_execve stub returns -1 → the error path fires.
    # CHANGELOG [6.4.47] (arc #3 bite 1).
    if (streq(cmd, "sign-efi") == 1) {
        find_tools();
        var _se_tool = _tool_path(_tools_dir, "cyrsign-efi");
        # v6.6.5 (round-2 review) — the argv is built on the HEAP from argc(), sized
        # to the tail it is actually given. It used to be `var _se_argv: i64[16]`
        # filled under `if (_se_ni < 15)`, i.e. arguments past the 15th were dropped
        # IN SILENCE — the last surviving member of the family this whole bite exists
        # to remove (run_tool's 3-arg cap was its sibling). sign-efi is a
        # `_cli_raw_tail` verb, so the classifier deliberately does not touch its
        # arguments; that is a reason to size the array from argc(), not to cap it.
        var _se_n = argc() - (cmd_idx + 1);
        if (_se_n < 0) { _se_n = 0; }
        var _se_argv = alloc((_se_n + 2) * 8);
        store64(_se_argv, _se_tool);
        var _se_ai = cmd_idx + 1;
        var _se_ni = 1;
        while (_se_ai < argc()) {
            store64(_se_argv + _se_ni * 8, argv(_se_ai));
            _se_ni = _se_ni + 1;
            _se_ai = _se_ai + 1;
        }
        store64(_se_argv + _se_ni * 8, 0);
        sys_execve(_se_tool, _se_argv, _envp);
        _err("sign-efi: cyrsign-efi helper not found (Linux-only; build it with `cyrius build programs/cyrsign_efi.cyr build/cyrsign-efi`)");
        return 127;
    }

    # --- Build commands ---
    # Every branch below reads its flags and operands from the v6.6.5 classifier
    # (cbt/cli_args.cyr), never from a literal argv index. The parse already rejected
    # any undeclared '-' token and any operand past the count this verb enforces, so a
    # positional here can never be a flag and can never have been silently dropped.
    if (streq(cmd, "distlib") == 1) {
        if (_cli_operands_ok("distlib", 0, 1) == 0) { return 1; }
        _distlib_modular = _cli_has("--modular");
        var dall = 0;
        var dchk = 0;
        if (_cli_has("--all") == 1) { dall = 1; }
        # v6.5.8: `--all` regenerates the base bundle AND every [lib.<name>] profile;
        # `--check` verifies them instead of writing.
        if (_cli_has("--check") == 1) { dall = 1; dchk = 1; }
        var dprof = _cli_pos_at(0);
        if (dall == 1) {
            if (dprof != 0) {
                _err("distlib: --all/--check cover every profile; do not also name one");
                return 1;
            }
            return cmd_distlib_all(dchk);
        }
        return cmd_distlib(dprof);
    }

    if (streq(cmd, "build") == 1) {
        # 0..2 operands. `cyrius build s --strict` used to write the binary to a FILE
        # NAMED "--strict"; `cyrius build s o -DCUDA` used to drop the define; a third
        # operand was ignored. All three are errors or honoured now.
        if (_cli_operands_ok("build", 0, 2) == 0) { return 1; }
        var b_src = _cli_pos_at(0);
        var b_out = _cli_pos_at(1);
        _build_paths_from_manifest = 0;
        # v6.5.49/.51 — fall back to `[build] entry` (legacy synonym `src`) and
        # `[build] output` in ./cyrius.cyml for whichever argument was NOT given.
        # The command line always WINS; the manifest is consulted only for the gaps.
        if (b_src == 0) {
            b_src = _manifest_build_key("entry", 5);
            if (b_src == 0) { b_src = _manifest_build_key("src", 3); }
            _build_paths_from_manifest = 2;
        }
        if (b_out == 0) {
            b_out = _manifest_build_key("output", 6);
            if (_build_paths_from_manifest == 0) { _build_paths_from_manifest = 1; }
        }
        if (b_src == 0 || b_out == 0) {
            _cli_usage("build");
            _cli_help_extra("build");
            return 1;
        }
        return cmd_build(b_src, b_out);
    }

    if (streq(cmd, "run") == 1) {
        # go-run style: operand 0 is the source, everything after it is the PROGRAM's
        # argv. `cyrius run probe.cyr host 443` used to give the program argc()==1 —
        # sandhi's dns-probe/http-probe document that exact spelling and had been
        # silently falling back to their default host ever since.
        if (_cli_operands_ok("run", 1, 1) == 0) { return 1; }
        return cmd_run(_cli_pos_at(0), _cli_tail_vec());
    }

    if (streq(cmd, "test") == 1) {
        # 0..N files. `cyrius test a.tcyr b.tcyr` used to run ONLY a and report its
        # verdict for the pair.
        if (_cli_npos() > 0) {
            _pass = 0; _fail = 0;
            if (_cli_npos() == 1) { return cmd_test(_cli_pos_at(0)); }
            var tri = 0;
            while (tri < _cli_npos()) {
                cmd_test(_cli_pos_at(tri));
                tri = tri + 1;
            }
            if (_dry_run == 0) {
                sys_write(STDOUT_FD, "\n", 1);
                fmt_int(_pass);
                sys_write(STDOUT_FD, " passed, ", 9);
                fmt_int(_fail);
                println(" failed");
            }
            if (_fail > 0) { return 1; }
            return 0;
        }
        # No args: auto-discover every .tcyr under tests/, at ANY depth.
        #
        # v6.5.11: RECURSIVE, via the same `_tests_walk` the plural `cyrius tests`
        # verb has used since v6.0.62. This was two depth-1 `dir_list` scans
        # (tests/tcyr, then tests), so a test in a subfolder silently never ran
        # while the verb still exited 0 — the same defect the v6.5.7 pass fixed for
        # bench/fuzz and never brought this verb along with. See axis 4 of
        # tests/gates/toolchain/scaffold_verb_discovery.sh: top-level-only is a
        # defect, not a design choice.
        #
        # ONE root, deliberately: tests/tcyr lives UNDER tests/, so walking both
        # recursively would visit every file in it TWICE (axis 7's double-count).
        _pass = 0; _fail = 0;
        _tests_found = 0;
        if (is_dir(str_from("tests")) == 1) {
            _tests_walk("tests");
        }
        if (_tests_found == 0) {
            println("No .tcyr files found under tests/");
            return 1;
        }
        if (_dry_run == 1) { return 0; }
        sys_write(STDOUT_FD, "\n", 1);
        fmt_int(_pass);
        sys_write(STDOUT_FD, " passed, ", 9);
        fmt_int(_fail);
        println(" failed");
        if (_fail > 0) { return 1; }
        return 0;
    }

    # v6.0.62: plural verb — recursive folder/suite runner. `cyrius tests`
    # walks tests/ at any depth; `cyrius tests <dir>` scopes to a subtree.
    # Distinct from `cyrius test <file>` (single) + bare `cyrius test`
    # (auto-discover), both unchanged.
    if (streq(cmd, "tests") == 1) {
        if (_cli_operands_ok("tests", 0, 1) == 0) { return 1; }
        if (_cli_npos() > 0) { return cmd_tests(_cli_pos_at(0)); }
        return cmd_tests("tests");
    }

    if (streq(cmd, "bench") == 1) {
        if (_cli_operands_ok("bench", 0, 1) == 0) { return 1; }
        return cmd_bench(_cli_pos_at(0));
    }

    if (streq(cmd, "check") == 1) {
        # 1..N sources, each parsed. Default is standalone (no manifest prepend);
        # --with-deps restores the legacy behaviour.
        if (_cli_operands_ok("check", 1, 0 - 1) == 0) { return 1; }
        var ck_with_deps = _cli_has("--with-deps");
        var ck_rc = 0;
        var ck_i = 0;
        while (ck_i < _cli_npos()) {
            if (cmd_check(_cli_pos_at(ck_i), ck_with_deps) != 0) { ck_rc = 1; }
            ck_i = ck_i + 1;
        }
        return ck_rc;
    }

    if (streq(cmd, "self") == 1) {
        if (_cli_operands_ok("self", 0, 0) == 0) { return 1; }
        return cmd_self();
    }

    if (streq(cmd, "clean") == 1) {
        # `clean --dryrun` (typo) and `cyrius -q clean --dry-run` both DELETED build/
        # on 6.6.4: the first because an unknown flag was ignored, the second because
        # this branch compared argv(2), which the global -q had shifted to "clean".
        if (_cli_operands_ok("clean", 0, 0) == 0) { return 1; }
        return cmd_clean();
    }

    # v5.11.58: `cyrius lib sync` — overwrite cwd ./lib/*.cyr with the
    # snapshot at ~/.cyrius/versions/<X>/lib/, where <X> is the cyrius.cyml
    # pin (or the wrapper version if no pin).
    if (streq(cmd, "lib") == 1) {
        if (_cli_operands_ok("lib", 1, 1) == 0) { return 1; }
        if (streq(_cli_pos_at(0), "sync") == 0) {
            _err_ctx("lib: unknown subcommand", _cli_pos_at(0));
            _cli_usage("lib");
            return 1;
        }
        return cmd_lib_sync();
    }

    if (streq(cmd, "capacity") == 1) {
        if (_cli_operands_ok("capacity", 0, 1) == 0) { return 1; }
        var cap_src = _cli_pos_at(0);
        if (cap_src == 0) {
            # v6.6.6 (bite 24b) — THE HOST'S OWN FORK FIRST. This default was the bare
            # literal `src/main.cyr`, which is the x86-64 LINUX fork: inside a cyrius
            # checkout on ARM or macOS a bare `cyrius capacity` metered a compiler that
            # host does not build and cannot run, and reported its table caps as if they
            # were the local compiler's. Same class as bite 23a's `cyrius self` / `soak`,
            # and it asks the same owner — `_self_host_src()` (cbt/build.cyr) — rather
            # than growing a second copy of the per-target mapping. The two literals stay
            # as FALLBACKS: a non-cyrius project has no per-target fork, so on ARM the
            # first test simply misses and `src/main.cyr` / `src/lib.cyr` answer as before.
            # CHANGELOG [6.6.6].
            var cap_self = _self_host_src();
            if (file_exists(cap_self) == 1) { cap_src = cap_self; }
            elif (file_exists("src/main.cyr") == 1) { cap_src = "src/main.cyr"; }
            elif (file_exists("src/lib.cyr") == 1) { cap_src = "src/lib.cyr"; }
        }
        return cmd_capacity(cap_src, _cli_has("--check"), _cli_has("--json"));
    }

    if (streq(cmd, "soak") == 1) {
        if (_cli_operands_ok("soak", 0, 1) == 0) { return 1; }
        var soak_n = 100;
        if (_cli_npos() > 0) {
            # `cyrius soak abc` used to run 100 iterations: atoi returns 0 for a
            # non-number and cmd_soak clamps 0 back up to the default.
            soak_n = _cli_int(_cli_pos_at(0));
            if (_cli_int_ok == 0 || soak_n <= 0) {
                _err_ctx("soak: iterations must be a positive integer", _cli_pos_at(0));
                return 1;
            }
        }
        return cmd_soak(soak_n);
    }

    if (streq(cmd, "smoke") == 1) {
        if (_cli_operands_ok("smoke", 0, 0) == 0) { return 1; }
        return cmd_smoke();
    }

    if (streq(cmd, "pulsar") == 1) {
        # `pulsar --dry-run` used to be ignored and the REAL rebuild+install ran.
        if (_cli_operands_ok("pulsar", 0, 0) == 0) { return 1; }
        return cmd_pulsar();
    }

    # --- Project commands ---
    if (streq(cmd, "init") == 1) {
        # Forward the full flag tail to the native scaffolder
        # (programs/cyrius-init.cyr). It prints its own usage and rejects its own
        # unknown flags, so the classifier deliberately does not touch this tail.
        return cmd_init(cmd_idx + 1);
    }

    if (streq(cmd, "deps") == 1) {
        if (_cli_operands_ok("deps", 0, 0) == 0) { return 1; }
        # --verify and --lock are terminal and mutually exclusive; the 6.6.4 branch
        # examined only argv(cmd_idx+1), so `deps --no-lock --verify` ran a normal
        # resolve and reported success for a verification it never performed.
        if (_cli_has("--verify") == 1 && _cli_has("--lock") == 1) {
            _err("deps: --verify and --lock are mutually exclusive");
            return 1;
        }
        if (_cli_has("--verify") == 1) { return cmd_deps_verify(); }
        if (_cli_has("--lock") == 1) { return cmd_deps_lock(); }
        return cmd_deps();
    }

    if (streq(cmd, "publish") == 1) {
        if (_cli_operands_ok("publish", 0, 0) == 0) { return 1; }
        return cmd_publish();
    }

    if (streq(cmd, "package") == 1) {
        if (_cli_operands_ok("package", 0, 0) == 0) { return 1; }
        return cmd_package();
    }

    if (streq(cmd, "install") == 1) {
        if (_cli_operands_ok("install", 0, 0) == 0) { return 1; }
        println("Package registry not yet available.");
        println("Install from source: git clone <repo> && cyrius build");
        return 0;
    }

    if (streq(cmd, "update") == 1) {
        if (_cli_operands_ok("update", 0, 0) == 0) { return 1; }
        return cmd_update();
    }

    if (streq(cmd, "port") == 1) {
        # Forward the full flag tail to the native scaffolder in port mode
        # (--__mode=port sentinel prepended). Parsed by that binary, not here.
        return cmd_port(cmd_idx + 1);
    }

    if (streq(cmd, "header") == 1) {
        if (_cli_operands_ok("header", 1, 1) == 0) { return 1; }
        return cmd_header(_cli_pos_at(0));
    }

    # --- Quality commands ---
    if (streq(cmd, "fmt") == 1) {
        # 1..N files. The four modes are EXCLUSIVE: `fmt --check --verbose f` used to
        # take the last one and REWRITE the file while the caller believed it had
        # asked a question. `fmt f --chekc` rewrote it too, because an unknown flag
        # was ignored — both are errors now.
        if (_cli_operands_ok("fmt", 1, 0 - 1) == 0) { return 1; }
        var fmode = 0;
        var fmodes = 0;
        if (_cli_has("--write") == 1) { fmode = 0; fmodes = fmodes + 1; }
        if (_cli_has("--check") == 1) { fmode = 1; fmodes = fmodes + 1; }
        if (_cli_has("--dry") == 1) { fmode = 2; fmodes = fmodes + 1; }
        if (_cli_has("--verbose") == 1) { fmode = 3; fmodes = fmodes + 1; }
        if (_cli_has("-v") == 1) { fmode = 3; fmodes = fmodes + 1; }
        if (fmodes > 1) {
            _err("fmt: --write, --check, --dry and --verbose are mutually exclusive");
            _cli_usage("fmt");
            return 1;
        }
        return cmd_fmt(_cli_pos_vec(), fmode);
    }

    if (streq(cmd, "lint") == 1) {
        # THE FILED DEFECT (2026-09-16, mabda 4.1.3). `cyrius lint --strict-deferrals
        # f.cyr` gave cyrlint's usage and exit 1 because the flag was taken as the
        # FILE; `cyrius lint f.cyr --strict-deferrals` DROPPED the flag and exited 0
        # with the gate off, which a CI step reads as a pass. Both spellings now
        # forward every flag, in any position, over 1..N files.
        if (_cli_operands_ok("lint", 1, 0 - 1) == 0) { return 1; }
        var lflags = vec_new();
        if (_cli_has("--strict") == 1) { vec_push(lflags, "--strict"); }
        if (_cli_has("--strict-deferrals") == 1) { vec_push(lflags, "--strict-deferrals"); }
        if (_cli_has("--exit-with-count") == 1) { vec_push(lflags, "--exit-with-count"); }
        return cmd_lint(_cli_pos_vec(), lflags);
    }

    if (streq(cmd, "doc") == 1) {
        # `cyrius doc f.cyr --check` used to drop --check and write markdown, exit 0 —
        # and ark/CLAUDE.md prescribes exactly that spelling.
        if (_cli_operands_ok("doc", 1, 0 - 1) == 0) { return 1; }
        return cmd_doc(_cli_pos_vec(), _cli_has("--check"));
    }

    if (streq(cmd, "vet") == 1) {
        if (_cli_operands_ok("vet", 1, 1) == 0) { return 1; }
        return cmd_vet(_cli_pos_at(0));
    }

    if (streq(cmd, "deny") == 1) {
        if (_cli_operands_ok("deny", 1, 1) == 0) { return 1; }
        return cmd_deny(_cli_pos_at(0));
    }

    # v5.7.33: api-surface — snapshot-based public API diff.
    # v6.6.5: `--updat`, a stray positional and the `--snapshot PATH` space form were
    # all silently ignored, so the tool diffed against the DEFAULT snapshot and
    # reported a clean surface for a question nobody asked.
    if (streq(cmd, "api-surface") == 1) {
        if (_cli_operands_ok("api-surface", 0, 0) == 0) { return 1; }
        var as_scope = _cli_val("--scope");
        if (as_scope != 0) {
            if (streq(as_scope, "project") == 0) {
                _err_ctx("api-surface: unknown --scope (only 'project')", as_scope);
                return 1;
            }
        }
        return cmd_api_surface(_cli_has("--update"), _cli_has("--scope"), _cli_val("--snapshot"));
    }

    if (streq(cmd, "audit") == 1) {
        # v6.2.25: default `cyrius audit` is the PROJECT sweep (fmt / lint / docs /
        # tests / bench). `--internal` runs the cyrius-internal check.sh;
        # `--internal=platform-check` adds the cross-OS real-hardware self-host.
        # mode: 0=sweep, 1=check.sh, 2=+cross-OS.
        if (_cli_operands_ok("audit", 0, 0) == 0) { return 1; }
        var _amode = 0;
        if (_cli_has("--internal") == 1) {
            _amode = 1;
            var aval = _cli_val("--internal");
            if (aval != 0) {
                if (streq(aval, "platform-check") == 1) { _amode = 2; }
                else {
                    _err_ctx("audit: unknown --internal mode (only 'platform-check')", aval);
                    return 1;
                }
            }
        }
        return cmd_audit(_amode);
    }

    if (streq(cmd, "fuzz") == 1) {
        # v6.5.7: accept an explicit file or subfolder, like bench/tests.
        # v6.5.29: `--poison` turns on the allocator poison mode for every harness in
        # this run. `cyrius fuzz f --poisn` used to run with poison SILENTLY OFF.
        if (_cli_operands_ok("fuzz", 0, 1) == 0) { return 1; }
        if (_poison_mode == 1) { println("poison mode: redzones + fill + quarantine-on-free ACTIVE"); }
        return cmd_fuzz(_cli_pos_at(0));
    }

    # --- Testing commands ---
    if (streq(cmd, "coverage") == 1) {
        if (_cli_operands_ok("coverage", 0, 1) == 0) { return 1; }
        var cov_min = 0 - 1;
        if (_cli_has("--min") == 1) {
            cov_min = _cli_int(_cli_val("--min"));
            # 0..100 only. v6.6.5 (round-3 review): a negative value is the "no gate"
            # sentinel inside cmd_coverage, so `--min -1` (or a typo'd `--min -5`)
            # switched the gate OFF and exited 0 — the typo-passes-a-gate class
            # _cli_int was added to close. 6.6.4's atoi behaved the same.
            if (_cli_int_ok == 0 || cov_min < 0 || cov_min > 100) {
                _err_ctx("coverage: --min needs a percentage from 0 to 100", _cli_val("--min"));
                return 1;
            }
        }
        return cmd_coverage(_cli_has("--full"), cov_min, _cli_pos_at(0));
    }

    if (streq(cmd, "doctest") == 1) {
        if (_cli_operands_ok("doctest", 1, 1) == 0) { return 1; }
        return cmd_doctest(_cli_pos_at(0));
    }

    # --- Interactive ---
    if (streq(cmd, "repl") == 1) {
        if (_cli_operands_ok("repl", 0, 0) == 0) { return 1; }
        return cmd_repl();
    }

    # --- LSP ---
    if (streq(cmd, "lsp") == 1) {
        # Build and install cyrius-lsp.
        if (_cli_operands_ok("lsp", 0, 0) == 0) { return 1; }
        # v6.6.4: the released-slot guard runs BEFORE the build — a refused write should not
        # cost a compile, and a gate can then exercise the refusal in a mini-repo.
        if (_home != 0) { if (_released_slot_guard_current() != 0) { return 1; } }
        println("Building cyrius-lsp...");
        var lsp_src = "programs/cyrius-lsp.cyr";
        if (file_exists(lsp_src) == 0) {
            _err("programs/cyrius-lsp.cyr not found");
            return 1;
        }
        var lsp_out = _cbt_tmpfile("lsp");
        var cr = compile(lsp_src, lsp_out);
        if (cr != 0) {
            _err("failed to build cyrius-lsp");
            return 1;
        }
        # Install to CYRIUS_HOME/bin/
        if (_home != 0) {
            # v6.6.4: `_home/bin` is a symlink INTO versions/<current>/bin on every normal
            # install, and <current> is the RELEASED version between a tag and the next bump
            # — the same released-slot write install.sh --refresh-only refuses (checked above,
            # before the compile).
            var dest = make_path(_home, "bin/cyrius-lsp");
            # v6.5.37 (A0) — CHECK THE COPY. This ignored `_dep_copy_file`'s return and
            # printed "Installed: <path>" unconditionally, so any failed write reported
            # success.
            var lcr = _dep_copy_file(lsp_out, dest);
            if (lcr == 1) {
                _err("failed to install cyrius-lsp");
                return 1;
            }
            sys_chmod(dest, 493);
            # The build product was copied, never removed: every `cyrius lsp` left a ~100 KB
            # `<tmpdir>/lsp` behind (found in 6.6.5 bite 8, round 3, among the private temp
            # dirs the gates leave).
            sys_unlink(lsp_out);
            sys_write(STDOUT_FD, "Installed: ", 11);
            println(dest);
        } else {
            # It printed "/tmp/cyrius-lsp" — a path this build has not written since the
            # private temp dir replaced the fixed /tmp names (v6.4.81, CVE-35/36).
            sys_write(STDOUT_FD, "Compiled: ", 10);
            println(lsp_out);
            println("Copy to your PATH manually.");
        }
        return 0;
    }

    # --- Info commands ---
    var is_ver = streq(cmd, "version");
    if (is_ver == 0) { is_ver = streq(cmd, "--version"); }
    if (is_ver == 1) {
        if (_cli_operands_ok(cmd, 0, 0) == 0) { return 1; }
        # cyrius version --project → project version (from ./VERSION).
        # v6.6.5: this read argv(2), so `cyrius -q version --project` printed the
        # TOOLCHAIN version instead — a CI step comparing it against ./VERSION would
        # have compared the wrong two numbers.
        if (_cli_has("--project") == 1) {
            sys_write(STDOUT_FD, _version, strlen(_version));
            sys_write(STDOUT_FD, "\n", 1);
            return 0;
        }
        # cyrius version → THIS binary's compile-time version (v5.11.26: not
        # ~/.cyrius/current, which is the global default, not this binary).
        sys_write(STDOUT_FD, "cyrius ", 7);
        sys_write(STDOUT_FD, _VERSION_TOOLCHAIN, strlen(_VERSION_TOOLCHAIN));
        sys_write(STDOUT_FD, "\n", 1);
        # v5.11.58: inside a project tree, append a `manifest-pin:` line so consumers
        # spot toolchain drift the moment they check what wrapper they are running.
        var _ver_pin = _dep_read_cyml_cyrius_field();
        if (_ver_pin != 0) {
            sys_write(STDOUT_FD, "manifest-pin: ", 14);
            sys_write(STDOUT_FD, _ver_pin, strlen(_ver_pin));
            if (streq(_ver_pin, _VERSION_TOOLCHAIN) != 1) {
                sys_write(STDOUT_FD, " (drift — wrapper is ", 23);
                sys_write(STDOUT_FD, _VERSION_TOOLCHAIN, strlen(_VERSION_TOOLCHAIN));
                sys_write(STDOUT_FD, ")", 1);
            }
            sys_write(STDOUT_FD, "\n", 1);
        }
        return 0;
    }

    if (streq(cmd, "which") == 1) {
        if (_cli_operands_ok("which", 0, 0) == 0) { return 1; }
        println(_cc);
        return 0;
    }

    if (streq(cmd, "hooks") == 1) {
        if (_cli_operands_ok("hooks", 0, 1) == 0) { return 1; }
        var haction = "install";
        if (_cli_npos() > 0) { haction = _cli_pos_at(0); }
        return cmd_hooks(haction);
    }

    var is_help = streq(cmd, "help");
    if (is_help == 0) { is_help = streq(cmd, "--help"); }
    if (is_help == 0) { is_help = streq(cmd, "-h"); }
    if (is_help == 1) {
        usage();
        return 0;
    }

    # Unknown command. Unreachable for a '-'-free token (the classifier above rejects
    # an unknown verb before parsing), kept as the backstop for the raw-tail verbs.
    sys_write(STDERR_FD, "Unknown command: ", 17);
    println(cmd);
    println("Run 'cyrius help' for usage.");
    return 1;
}

var exit_code = main();
# v6.6.6 — the CLI's ONE normal exit path, and where the private temp directory
# `_cbt_tmpdir()` created is removed. Every `main()` return flows through here; the
# handful of parent-side `sys_exit`s that can run after a temp dir exists go through
# `_cbt_exit` instead. Before this, every run that touched a temp left an empty
# `/tmp/cyrius-<pid>` behind for ever (5,005 of them measured at 6.6.5).
# CHANGELOG [6.6.6].
_cbt_tmpdir_cleanup();
# v6.0.9 — use SYS_EXIT constant (60 on x86_64, 93 on aarch64) so
# the wrapper exits correctly on both arches. Raw syscall(60, ...)
# called clock_gettime on aarch64 instead of exit, dropping the
# exit code on the floor.
syscall(SYS_EXIT, exit_code);
