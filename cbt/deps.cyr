                                if (_dep_stdlib_seen == 0) { _dep_stdlib_seen_init(); }
                                var _sc_dir = _dep_find_stdlib_dir();
                                if (_sc_dir != 0) {
                                    errors = errors + _dep_pull_leaves(_sc_dir, dep_name, _sc_leaves);
                                }
                            }
                        }
                    }
                    var base = mod_path;
                    var bi = 0;
                    while (load8(mod_path + bi) != 0) {
                        if (load8(mod_path + bi) == 47) { base = mod_path + bi + 1; }
                        bi = bi + 1;
                    }
                    var sb3 = str_builder_new();
                    str_builder_add_cstr(sb3, "lib/");
                    var _dnl = strlen(dep_name);
                    var _bsd = 1;
                    var _ck = 0;
                    while (_ck < _dnl) {
                        if (load8(base + _ck) != load8(dep_name + _ck)) { _bsd = 0; break; }
                        _ck = _ck + 1;
                    }
                    if (_bsd == 1) {
                        str_builder_add_cstr(sb3, base);
                    } else {
                        str_builder_add_cstr(sb3, dep_name);
                        str_builder_add_cstr(sb3, "_");
                        str_builder_add_cstr(sb3, base);
                    }
                    var dst = str_data(str_builder_build(sb3));
                    # v5.11.8: file-copy instead of symlink (was
                    # syscall(88, sym_src, dst) symlink-then-fallback-
                    # to-copy). Symlinks fired install.sh's `cp -L`
                    # same-file collision and let snapshot-ping-pong
                    # silently overwrite project lib/ files. Always
                    # copy → distinct inodes at every layer. See
                    # CHANGELOG [5.11.8], roadmap v5.10.37/v5.11.8 pin.
                    if (_dep_vendor_mode == 1) {
                        var _l2 = _dep_dest_is_linked(dst);
                        if (_l2 != 0) { return _dep_refuse_symlinked_dest(_l2); }
                    }
                    # v6.5.39 — refuse BEFORE the unlink, same discipline as the v6.5.37
                    # symlink guard above: a delete-then-refuse would leave the tree worse
                    # than either outcome, and here the file being deleted IS the snapshot
                    # copy we are defending.
                    # 6.6.11 (S2): a thin profile of a package that is a stdlib leaf here.
                    var _kf = _dep_keep_fold_over_profile(dep_name, dst, mod_path);
                    if (_kf < 0) { return 1; }
                    if (_kf == 1) {
                        dep_had_success = 1;
                        mi = mi + 1;
                        continue;
                    }
                    var _cl_stem = _dep_lib_dst_stem(dst);
                    if (_cl_stem != 0) {
                        if (_dep_stdlib_seen_has(_cl_stem) == 1) {
                            _dep_refuse_stdlib_clobber(_cl_stem, src, dst);
                            # The DEP resolved fine — only this one module is skipped — so
                            # `dep_had_success` stays set and the dep is still marked visited
                            # and queued for the transitive walk below.
                            # ⚠ Deliberately NO `vec_push(_dep_includes, dst)`: Phase 1
                            # already pushed this exact path when it copied the snapshot, and
                            # a second push would emit the include twice.
                            # 6.6.9: it IS this dep's module in scope, so distlib's verify
                            # splices it (the leaf of the same name is then skipped there).
                            vec_push(_dep_nd_modules, dst);
                            dep_had_success = 1;
                            mi = mi + 1;
                            continue;
                        }
                    }
                    sys_unlink(dst);
                    var cr2 = _dep_copy_file(src, dst);
                    if (cr2 == 0 || cr2 == 2) {
                        vec_push(_dep_includes, dst);
                        vec_push(_dep_nd_modules, dst);   # 6.6.9: a named dep's module (distlib verify)
                        dep_had_success = 1;
                        if (cr2 == 0) {
                            if (_verbose == 1) {
                                sys_write(STDERR_FD, "  ", 2);
                                _ew_shown(dep_name);
                                sys_write(STDERR_FD, ": ", 2);
                                _ew_shown(base);
                                sys_write(STDERR_FD, "\n", 1);
                            }
                        }
                    } elif (cr2 == 1) { errors = errors + 1; }
                    mi = mi + 1;
                }
            }
            # v5.7.14: on success, mark visited + queue for transitive walk.
            if (dep_had_success == 1) {
                vec_push(_dep_visited, dep_name);
                if (dep_path != 0) {
                    vec_push(_dep_queue, _abs_path(dep_path));
                }
            }
        }
    }
    # ⛔ v6.5.37 (A1) — CLAMP. This returned the raw error COUNT, which becomes the process
    # exit status, and a wait status carries only the low 8 bits. Measured at 6.5.36:
    #     1 bad leaf -> exit 1     255 -> exit 255     256 -> exit 0     512 -> exit 0
    # So a manifest broken badly enough reported SUCCESS, and every count that is a
    # multiple of 256 was a silent green. This is why a defective sidecar could pass CI
    # at all — the more wrong it was, the likelier it looked clean. Exit status is a
    # boolean channel; the count belongs in the message, which it already is.
    if (errors > 0) { return 1; }
    return 0;
}

# `deps --dry-run`: name every `[deps.NAME]` table the manifest header declares, and
# write nothing. A listing, not a resolution — no clone, no cache read, no lib/ write.
fn _deps_dry_list(manifest, buf, n): i64 {
    sys_write(STDOUT_FD, "dry-run: would resolve deps from ", 33);
    sys_write(STDOUT_FD, manifest, strlen(manifest));
    println(" into lib/ (nothing written):");
    var cnt = 0;
    var refused = 0;
    var info[32];
    var p = 0;
    while (p < n) {
        # 6.6.20: the resolver's own header pass (_dep_hdr_name), so the listing is exactly what
        # the real run resolves — this matched `[deps.` at column 0 only, missed `[deps.]`, and
        # listed a header inside a `"""` value; a refused name is refused by the same line, rc 1.
        p = _toml_line(buf, n, p, &info);
        var hc = 0;
        var nm = _dep_hdr_name(buf, n, &info, &hc);
        if (nm != 0) {
            if (hc == 0) {
                _dep_refuse_unclosed(nm);
                refused = refused + 1;
            } elif (_dep_name_unsafe(nm) == 1) {
                _dep_refuse_name(nm);
                refused = refused + 1;
            } else {
                var sn = _shown(nm);
                sys_write(STDOUT_FD, "  ", 2);
                sys_write(STDOUT_FD, sn, strlen(sn));
                sys_write(STDOUT_FD, "\n", 1);
                cnt = cnt + 1;
            }
        }
    }
    if (cnt == 0 && refused == 0) {
        println("  (no [deps.NAME] entries; stdlib = [...] modules resolve from the toolchain)");
    }
    if (refused > 0) { return 1; }
    return 0;
}

fn cmd_deps(): i64 {
    _dep_vendor_mode = 1;   # v6.5.37 (A0): vendoring — symlinked destinations are refused
    # Try cyrius.cyml first, fall back to cyrius.toml
    var _manifest = "cyrius.cyml";
    if (file_exists(_manifest) == 0) { _manifest = "cyrius.toml"; }
    if (file_exists(_manifest) == 0) {
        _err("no cyrius.cyml or cyrius.toml found");
        return 1;
    }
    # v6.0.1: removed unconditional `sys_mkdir("lib", 0x1ED)` here.
    # Pre-fix the upfront mkdir created `./lib` before
    # `_dep_find_stdlib_dir` ran, tripping its priority-(a) check
    # `file_exists("src/main.cyr") && is_dir("./lib")` for ANY
    # downstream repo with a `src/main.cyr` entry point + non-empty
    # `stdlib = [...]` (gnoboot exposed this 2026-05-19 when
    # adopting `stdlib = ["fnptr"]`). Priority (a) is supposed to
    # identify the cyrius source repo only — it returned "./lib"
    # for downstream repos and the stdlib copy failed because the
    # src path resolved into the empty just-mkdir'd `./lib/`. The
    # `_dep_copy_file` prefix-walk at line ~85 already mkdir's
    # intermediate dirs lazily, so the upfront mkdir was redundant
    # AND wrong. See CHANGELOG [6.0.1].
    # 6.6.17: the WHOLE manifest through the one reader (cbt/manifest.cyr) — this read 32,767
    # bytes, so a `[deps]` past the cut was silently invisible. The CYML body is already cut.
    if (_mf_load() != 1) { _err("cannot read manifest"); return 1; }
    var buf = _mf_buf;
    var n = _mf_len;
    # v6.6.5 — reachable for the first time (no CLI path used to set _dry_run for
    # `deps`). It returned BEFORE the manifest check, so `cyrius deps --dry-run` in an
    # empty directory said "would resolve deps from cyrius.cyml" and exited 0 while
    # plain `cyrius deps` exited 1 (round-3 review). Now it fails exactly where the real
    # run fails, and reports what it read instead of a canned line.
    if (_dry_run == 1) { return _deps_dry_list(_manifest, buf, n); }
    var copied = 0;
    var errors = 0;
    _dep_includes = vec_new();
    _dep_nd_modules = vec_new();     # 6.6.9: named-dep modules, for distlib's verify unit
    _dep_nd_leaves = vec_new();      # 6.6.9: stdlib leaves pulled for named deps (same)
    # v5.7.14: per-cmd_deps state. visited names = closest-wins de-dup.
    # queue = abs dirs of resolved deps whose own cyrius.cyml needs walking.
    _dep_visited = vec_new();
    _dep_queue = vec_new();
    _dep_inert = 0;                  # 6.6.13 (I10b): modules-less deps that vendored nothing
    _dep_commit_lines = vec_new();   # CVE-21 (v6.2.30): git-dep commit pins
    _dep_lock_load();                # v6.6.4: the inherited lock, read BEFORE any copy (stdlib-leaf guard)
    _dep_parse_groups(buf, n);       # v6.2.49 Phase B: [groups] (buf is the TOML header, CYML body already stripped)
    _dep_register_default_std_group();  # v6.3.32 Phase D: built-in `std` default group (after parse so a manifest's own `std` wins)
    _dep_parse_features(buf, n);     # v6.3.1 lever 2: [features] table (populates _dep_feature_names/_deps; gating happens in _process_named_deps)

    # === Phase 1: stdlib deps ===
    # `[deps] stdlib = ["string", "fmt", ...]`, read by the one reader (_dep_declared_stdlib):
    # this was a raw byte scan for `stdlib` anywhere in the file, guarded piecemeal against the
    # decoys it kept finding (a comment, a quoted value, a `dev-stdlib` key) and still taking a
    # `"""` description holding `stdlib = ["math"]` for the key. CHANGELOG [6.6.20].
    var mods = _dep_declared_stdlib(buf, n);
    if (mods != 0) {
        var stdlib_dir = _dep_find_stdlib_dir();
        if (stdlib_dir == 0) {
            println("  error: cannot find cyrius stdlib");
            errors = errors + 1;
        } else {
            # v5.10.19: per-cmd_deps invocation visited-set
            # for the include-chain follower below.
            _dep_stdlib_seen_init();
            mods = _dep_expand_groups(mods);   # v6.2.49 Phase B: expand [groups] refs → leaves
            var mi = 0;
            while (mi < vec_len(mods)) {
                var mod_name = vec_get(mods, mi);
                if (_dep_leaf_ok(mod_name) == 0) {   # 6.6.20: the one leaf rule
                    _dep_refuse_leaf("[deps] stdlib", 0, mod_name);
                    errors = errors + 1;
                    mi = mi + 1;
                    continue;
                }
                # v5.10.19: the recursive fetcher. For 95%+ of stdlib modules
                # (leaf files) only the top-level file gets copied; for the arch-
                # dispatcher modules (syscalls, alloc) it follows their
                # `include "lib/X.cyr"` chains. is_top=1 — push onto `_dep_includes`
                # so `compile()` prepends `include "lib/<mod>.cyr"`.
                var rr = _dep_copy_stdlib_recursive(stdlib_dir, mod_name, 1);
                if (rr == 1) { errors = errors + 1; }
                if (_verbose == 1 && rr == 0) {
                    sys_write(STDERR_FD, "  stdlib: ", 10);
                    sys_write(STDERR_FD, mod_name, strlen(mod_name));
                    sys_write(STDERR_FD, "\n", 1);
                }
                mi = mi + 1;
            }
        }
    }

    # === Phase 2: named deps (consumer's manifest) ===
    # v5.7.14: extracted to _process_named_deps. Consumer's manifest_dir
    # is abs(cwd). After this returns, _dep_queue holds the resolved
    # dirs of every direct dep — Phase 3 drains them.
    var _consumer_dir = _abs_path(".");
    errors = errors + _process_named_deps(buf, n, _consumer_dir);

    # === Phase 3: transitive deps (BFS drain of _dep_queue) ===
    # v5.7.14. For each resolved dep dir, read its cyrius.cyml and
    # process its [deps.X] sections. New deps push more dirs into
    # _dep_queue; closest-wins skip prevents re-resolution. Cycles
    # terminate naturally because re-encountered names are skipped.
    var _qi = 0;
    while (_qi < vec_len(_dep_queue)) {
        var _trans_dir = vec_get(_dep_queue, _qi);
        _qi = _qi + 1;
        var _tm_sb = str_builder_new();
        str_builder_add_cstr(_tm_sb, _trans_dir);
        str_builder_add_cstr(_tm_sb, "/cyrius.cyml");
        var _tm = str_data(str_builder_build(_tm_sb));
        if (file_exists(_tm) == 0) {
            var _tm_sb2 = str_builder_new();
            str_builder_add_cstr(_tm_sb2, _trans_dir);
            str_builder_add_cstr(_tm_sb2, "/cyrius.toml");
            _tm = str_data(str_builder_build(_tm_sb2));
        }
        if (file_exists(_tm) == 0) { continue; }
        # 6.6.17: read WHOLE (this was a 32,767-byte read — a transitive `[deps.X]` past the cut
        # was invisible) and an unreadable manifest is named, not skipped.
        var _tn = 0;
        var _tbuf = file_read_whole_max(_tm, _MF_MAX, &_tn);
        if (_tbuf == 0) {
            _err_ctx("cannot read a dependency's manifest (or it is past 16 MiB)", _tm);
            errors = errors + 1;
            continue;
        }
        var _tbom = _mf_bom_len(_tbuf, _tn);   # 6.6.20: a leading BOM hid a first-line [deps.X]
        _tbuf = _tbuf + _tbom;
        _tn = _tn - _tbom;
        _tn = _mf_header_len(_tbuf, _tn);   # only the header is TOML
        store8(_tbuf + _tn, 0);
        errors = errors + _process_named_deps(_tbuf, _tn, _trans_dir);
    }

    # v5.7.14: `copied` is the count of distinct deps resolved (direct +
    # transitive). _dep_visited grows once per resolved dep across both
    # phases.
    copied = vec_len(_dep_visited);
    # v6.6.4: leaves the lock guard refused are errors — no lock write, non-zero exit.
    errors = errors + _dep_lock_refused;

    # Summary (only print if something was copied, errored, or — 6.6.13 I10b — a
    # modules-less dep vendored nothing: that count is printed even at 0 resolved).
    if (copied > 0 || errors > 0 || _dep_inert > 0) {
        var nb[24];
        var nl = fmt_int_buf(copied, &nb);
        sys_write(STDOUT_FD, &nb, nl);
        sys_write(STDOUT_FD, " deps resolved", 14);
        if (_dep_inert > 0) {
            sys_write(STDOUT_FD, ", ", 2);
            nl = fmt_int_buf(_dep_inert, &nb);
            sys_write(STDOUT_FD, &nb, nl);
            sys_write(STDOUT_FD, " vendored nothing", 17);
        }
        if (errors > 0) {
            sys_write(STDOUT_FD, ", ", 2);
            nl = fmt_int_buf(errors, &nb);
            sys_write(STDOUT_FD, &nb, nl);
            sys_write(STDOUT_FD, " errors", 7);
        }
        sys_write(STDOUT_FD, "\n", 1);
    }
    # v5.7.8 P5: write cyrius.lock by default after every successful
    # resolve (was opt-in via `cyrius deps --lock` pre-v5.7.8). The
    # lockfile is the only thing making "pinned deps" reproducible
    # across machines — making it opt-in defeats the purpose for new
    # projects whose authors do not know the flag exists. Suppressed
    # by --no-lock.
    if (errors == 0) {
        if (_no_lock == 0) {
            # v6.6.4: `--relock` means RE-LOCK — write even when no git dep was resolved
            # (`copied == 0`, the stdlib-only shape), or the accepted leaf lands in lib/
            # with the lock still holding the old hash and `deps --verify` fails.
            # v6.6.4: ...and a lock that predates the trailer (every lock written before 6.6.4)
            # is re-written ONCE so it carries the pin line from now on — otherwise a
            # stdlib-only consumer (copied == 0) would never be stamped and never guarded.
            # ...and likewise a lock whose trailer names a DIFFERENT pin: after a pin bump on a
            # stdlib-only consumer nothing else triggers the write, so the lock kept the old
            # pin + old hashes, `--verify` failed on the leaf just vendored, and the guard sat
            # OFF under the new pin (bite-5 review).
            var _stamp_legacy = 0;
            if (_dep_lock_buf != 0) {
                if (_dep_lock_has_trailer == 0) { _stamp_legacy = 1; }
                if (_dep_lock_pin_same == 0) { _stamp_legacy = 1; }
            }
            # ...and (6.6.9) a vendored leaf the lock does not cover: a stdlib leaf newly
            # declared under an unchanged pin, or the FIRST lock of a stdlib-only project.
            # Both used to be left out — the leaf sat in lib/ unlocked and `--verify` passed
            # over it even tampered — restoring the v5.7.8 intent stated above.
            var _must = 0;
            if (copied > 0 || _dep_relock == 1 || _stamp_legacy == 1) { _must = 1; }
            if (_must == 1 || _dep_lock_new_leaf == 1) {
                # v6.6.6: a lock that could not be written is an error, not a dropped rc —
                # except (6.6.9) a hash failure on a write owed ONLY to a new leaf, which is a
                # named warning (_dep_lock_soft; cmd_deps_lock returns 2 for it).
                _dep_lock_soft = 1 - _must;
                var _lr = cmd_deps_lock();
                _dep_lock_soft = 0;
                if (_lr == 1 || (_lr != 0 && _must == 1)) { errors = errors + 1; }
            }
        }
    }
    # ⛔ v6.5.37 (A1) — CLAMP. This returned the raw error COUNT, which becomes the process
    # exit status, and a wait status carries only the low 8 bits. Measured at 6.5.36:
    #     1 bad leaf -> exit 1     255 -> exit 255     256 -> exit 0     512 -> exit 0
    # So a manifest broken badly enough reported SUCCESS, and every count that is a
    # multiple of 256 was a silent green. This is why a defective sidecar could pass CI
    # at all — the more wrong it was, the likelier it looked clean. Exit status is a
    # boolean channel; the count belongs in the message, which it already is.
    if (errors > 0) { return 1; }
    return 0;
}

# Auto-resolve deps if manifest has [deps] section.
# Called before build/run/test to ensure lib/ is populated.
fn _auto_deps(): i64 {
    # 6.6.17: the WHOLE manifest, through the one reader (cbt/manifest.cyr). This read a fixed
    # 65,535 bytes (4,095 before v6.5.28): a `[deps]` past the cut was invisible, and the "larger
    # than 65535 bytes" line it printed was an error that did not stop the build. A manifest that
    # cannot be read (or is past 16 MiB) now fails the verb by name.
    var ml = _mf_load();
    if (ml < 0) { return 1; }
    if (ml == 0) { return 0; }
    var has_deps = 0;
    var info[32];
    var p = 0;
    while (p < _mf_len) {
        p = _toml_line(_mf_buf, _mf_len, p, &info);
        if (load64(&info) == 1) {
            var hs = _mf_buf + load64(&info + 8);
            var hl = load64(&info + 16);
            if (hl == 4 && memeq(hs, "deps", 4) == 1) { has_deps = 1; }
            # 6.6.20: a dep table is what the resolver's ONE header rule says (`_dep_hdr_name`) —
            # this kept its own (`hl > 5`), so a manifest whose only dep table was `[deps.]` made
            # build / run / test skip the resolve silently while `cyrius deps` refused it by name.
            var hc = 0;
            if (_dep_hdr_name(_mf_buf, _mf_len, &info, &hc) != 0) { has_deps = 1; }
        }
    }
    # `[build].modules` is read BEFORE the `[deps]` early return: a manifest with modules and
    # no `[deps]` section had them silently ignored, and the build failed with "undefined
    # function" pointing nowhere near the manifest (the v6.4.63 shape of _check_lib_freshness).
    # The modules are prepended before the entry point. CHANGELOG [6.6.9].
    _build_modules = _mf_strs("build", "modules");
    if (_toml_bad == 1) {
        _err("cyrius.cyml [build] modules must be a string or an array of strings");
        return 1;
    }
    # 6.6.19: `[embed]` beside it, for the same reason (before the `[deps]` early return): every
    # entry validated and each file read once, here, so a refused one fails the verb by name.
    # 6.6.20: with [deps] to resolve, its collision check runs AFTER cmd_deps has vendored lib/
    # (the validation stays here, ahead of any clone). CHANGELOG [6.6.20].
    _embed_coll_later = has_deps;
    var ee = _embed_load();
    _embed_coll_later = 0;
    if (ee < 0) { return 1; }
    _embeds = 0;
    if (vec_len(ee) > 0) { _embeds = ee; }
    if (has_deps == 0) { return 0; }
    var dr = cmd_deps();
    if (dr != 0) { return dr; }
    return _embed_collide_vendored();
}

fn cmd_package(): i64 {
    # Read manifest if present
    var name = "unknown";
    var ver = _version;
    var entry = "src/main.cyr";
    var output_name = "main";

    # 6.6.17: `[build] entry` / `output` through the one reader (cbt/manifest.cyr). This read the
    # manifest into a 65,535-byte buffer and then used NOTHING from it, so every project packaged
    # src/main.cyr into build/main whatever it declared.
    if (_mf_load() < 0) { return 1; }
    var mentry = _mf_key_str("build", "entry");
    if (mentry != 0) { entry = mentry; }
    var mout = _mf_str("build", "output");
    if (file_exists("VERSION") == 1) {
        ver = read_file_str("VERSION");
        # Use directory name as package name
    }

    _status("=== cyrius package ===");
    sys_write(STDOUT_FD, "  version: ", 11);
    println(ver);

    # Compile if entry exists
    sys_mkdir("build", 0x1ED);
    var out = make_path("build", output_name);
    if (mout != 0) { out = mout; }
    if (file_exists(entry) == 1) {
        println("  compiling...");
        # v6.5.19: was a bare `compile(entry, out);`. On a failed compile package
        # printed "package ready in build/" and exited 0 with no artifact — the
        # same green-placebo shape as the v6.4.73 `capacity` bug.
        # CHANGELOG [6.5.19].
        var pkg_cr = compile(entry, out);
        if (pkg_cr != 0) {
            _err_ctx("package: entry does not compile", entry);
            return 1;
        }
    }
    sys_write(STDOUT_FD, "  package ready: ", 17);
    sys_write(STDOUT_FD, out, strlen(out));
    sys_write(STDOUT_FD, "\n", 1);
    return 0;
}

# v5.8.49: recursive directory walker for cmd_update.
# Walks `src_dir` (e.g. ~/.cyrius/versions/<v>/lib) and copies every
# `.cyr` file to the corresponding `lib/<rel>` path in the consumer's
# cwd, preserving subdir structure. `rel_prefix == 0` at the root call;
# recursion appends "<dirname>" / "<rel_prefix>/<dirname>" as we descend.
# Returns total file count copied.
# 6.6.10: an unlistable directory is named (_cbt_list_dir) and counted in _err_count, which
# cmd_update checks — it copied a partial stdlib and reported success.
fn _update_walk(src_dir, rel_prefix): i64 {
    var copied = 0;
    var entries = _cbt_list_dir(src_dir, "its modules were NOT copied");
    if (entries == 0) { return 0; }
    var ei = 0;
    while (ei < vec_len(entries)) {
        var name = vec_get(entries, ei);
        var nd = str_data(name);
        var nl = str_len(name);
        ei = ei + 1;
        # Skip "." and ".."
        if (nl == 1 && load8(nd) == 46) { continue; }
        if (nl == 2 && load8(nd) == 46 && load8(nd + 1) == 46) { continue; }
        var from = make_path(src_dir, nd);
        if (is_dir(str_from(from)) == 1) {
            # Recurse — extend rel_prefix.
            var sub_sb = str_builder_new();
            if (rel_prefix != 0) {
                str_builder_add_cstr(sub_sb, rel_prefix);
                str_builder_add_cstr(sub_sb, "/");
            }
            str_builder_add_cstr(sub_sb, nd);
            var sub_rel = str_data(str_builder_build(sub_sb));
            copied = copied + _update_walk(from, sub_rel);
            continue;
        }
        # File: only handle *.cyr.
        if (nl <= 4) { continue; }
        if (load8(nd + nl - 4) != 46) { continue; }
        if (load8(nd + nl - 3) != 99) { continue; }
        if (load8(nd + nl - 2) != 121) { continue; }
        if (load8(nd + nl - 1) != 114) { continue; }
        var to_sb = str_builder_new();
        str_builder_add_cstr(to_sb, "lib/");
        if (rel_prefix != 0) {
            str_builder_add_cstr(to_sb, rel_prefix);
            str_builder_add_cstr(to_sb, "/");
        }
        str_builder_add_cstr(to_sb, nd);
        var to = str_data(str_builder_build(to_sb));
        # _dep_copy_file streams in 32KB chunks (no size cap) and mkdir-p's
        # intermediate dst dirs. Returns 0 on copy, 2 on already-resolved.
        var cr = _dep_copy_file(from, to);
        if (cr == 0 || cr == 2) {
            copied = copied + 1;
        }
    }
    return copied;
}

fn cmd_update(): i64 {
    _dep_vendor_mode = 1;   # v6.5.37 (A0): vendoring — symlinked destinations are refused
    _status("=== cyrius update ===");
    # Find installed stdlib
    var cur = read_file_str(make_path(_home, "current"));
    var src_lib = 0;
    if (cur != 0) {
        var ver_dir = make_path(_home, "versions");
        ver_dir = make_path(ver_dir, cur);
        src_lib = make_path(ver_dir, "lib");
    }
    if (src_lib == 0) {
        # Fallback: try ../cyrius/lib
        if (is_dir(str_from("../cyrius/lib")) == 1) {
            src_lib = "../cyrius/lib";
        }
    }
    if (src_lib == 0) {
        _err("cannot find Cyrius stdlib");
        println("  expected: ~/.cyrius/versions/<ver>/lib/ or ../cyrius/lib/");
        return 1;
    }
    # Ensure lib/ exists
    sys_mkdir("lib", 0x1ED);
    # v5.8.49: recursive walk so subdir-nested stdlib (e.g.
    # `lib/unicode/*.cyr`) reaches the consumer. Pre-fix, the flat
    # dir_list + extension-filter skipped directory entries entirely
    # and used a 32KB read buffer that would have silently truncated
    # files like `lib/unicode/_categories_data.cyr` (~59KB) even if
    # they had been seen. Helper `_update_walk` defers file copying
    # to `_dep_copy_file` which handles streaming reads of any size
    # plus mkdir-p of intermediate destination dirs.
    var _upd_e0 = _err_count;
    var copied = _update_walk(src_lib, 0);
    if (_err_count > _upd_e0) {
        _err_ctx("update: lib/ is INCOMPLETE — a directory above could not be listed", src_lib);
        return 1;
    }
    sys_write(STDOUT_FD, "  updated lib/ from ", 20);
    sys_write(STDOUT_FD, src_lib, strlen(src_lib));
    sys_write(STDOUT_FD, " (", 2);
    fmt_int(copied);
    println(" files)");

    # Update .cyrius-toolchain to match installed version
    if (cur != 0 && file_exists(".cyrius-toolchain") == 1) {
        var tc_sb = str_builder_new();
        str_builder_add_cstr(tc_sb, cur);
        str_builder_add_cstr(tc_sb, "\n");
        var tc_str = str_data(str_builder_build(tc_sb));
        # v6.6.6: crash-safe and checked — was file_write_all with the result dropped.
        if (file_replace_atomic(".cyrius-toolchain", tc_str, strlen(tc_str)) != 0) {
            _err("write failed: .cyrius-toolchain (left as it was)");
            return 1;
        }
        sys_write(STDOUT_FD, "  .cyrius-toolchain -> ", 23);
        println(cur);
    }

    # Migrate cyrius.toml → cyrius.cyml if toml exists and cyml doesn't
    if (file_exists("cyrius.toml") == 1 && file_exists("cyrius.cyml") == 0) {
        # v6.6.6: the WHOLE toml (was `alloc(32768)` + a 32767-byte read). The migration WRITES
        # THE BUFFER BACK as cyrius.cyml and then DELETES cyrius.toml, so a manifest past the cap
        # was silently truncated and the only untruncated copy removed. CHANGELOG [6.6.6]
        var toml_n = 0;
        var toml_buf = file_read_whole("cyrius.toml", &toml_n);
        if (toml_buf != 0 && toml_n > 0) {
            # Write cyrius.cyml: TOML content + separator + empty body
            var cyml_sb = str_builder_new();
            var ti = 0;
            while (ti < toml_n) {
                str_builder_add_byte(cyml_sb, load8(toml_buf + ti));
                ti = ti + 1;
            }
            # Ensure trailing newline before separator
            if (toml_n > 0 && load8(toml_buf + toml_n - 1) != 10) {
                str_builder_add_cstr(cyml_sb, "\n");
            }
            str_builder_add_cstr(cyml_sb, "---\n");
            var cyml_str = str_data(str_builder_build(cyml_sb));
            # v6.6.6: the toml is deleted ONLY once the cyml is fully on disk — the unchecked
            # file_write_all here could leave a truncated cyml AND delete the only good copy.
            if (file_replace_atomic("cyrius.cyml", cyml_str, strlen(cyml_str)) != 0) {
                _err("write failed: cyrius.cyml (cyrius.toml kept)");
                return 1;
            }
            sys_unlink("cyrius.toml");
            println("  migrated cyrius.toml -> cyrius.cyml");
        }
    }

    return 0;
}


# ================================================================
# Dep integrity — lockfile generation and verification
# ================================================================
# cyrius.lock format: one line per dep file
#   sha256hex  lib/name.cyr
# Generated by cyrius deps, verified by cyrius deps --verify

# ⛔ 6.6.9 bite 9 — WHY a hash failed, because the callers used to guess. The child used to
# open its capture itself and, when that open failed (EDQUOT, ENOSPC, no inodes), ran the
# hasher with the PARENT's stdout: the digest went to the terminal, the capture read back
# empty, and the caller printed "sha256sum missing?" — a false diagnosis of a full temp dir.
# The capture is now opened by the PARENT before the fork; a failure there never runs the
# tool and is reported as what it is. CHANGELOG [6.6.9].
var _sha_tool = 0;    # 0 not probed · 1 sha256sum · 2 shasum -a 256 -b · -1 neither on PATH
var _sha_fail = 0;    # why the last _sha256sum_file returned 0 (see _sha_fail_why)
var _sha_errno = 0;   # the errno behind _sha_fail 3 / 4
var _sha_rc = 0;      # the hasher's exit status behind _sha_fail 2

fn _sha256sum_file(path): i64 {
    # v6.0.85 — Windows has no /bin/sh or sha256sum; certutil is the built-in.
    # `certutil -hashfile <path> SHA256` prints 3 lines: a header, the 64-char
    # lowercase hex digest, then a "completed" line. Capture via CreateProcessW
    # (process_win exec_capture) and parse line 2. Makes `cyrius deps --lock`
    # round-trip on native Windows (no WSL/git-bash).
    #ifdef CYRIUS_TARGET_WIN
    var cargs = vec_new();
    vec_push(cargs, "certutil");
    vec_push(cargs, "-hashfile");
    vec_push(cargs, path);
    vec_push(cargs, "SHA256");
    var cbuf = alloc(512);
    var cn = exec_capture(cargs, cbuf, 511);
    _sha_fail = 2;
    _sha_rc = 0;
    if (cn <= 0) { return 0; }
    store8(cbuf + cn, 0);
    # Skip the header line (to the first newline), then any \r/space.
    var cp = 0;
    while (cp < cn) { if (load8(cbuf + cp) == 10) { cp = cp + 1; break; } cp = cp + 1; }
    while (cp < cn) {
        var wc = load8(cbuf + cp);
        if (wc == 13) { cp = cp + 1; } elif (wc == 32) { cp = cp + 1; } elif (wc == 10) { cp = cp + 1; }
        else { break; }
    }
    if (cp + 64 > cn) { return 0; }
    _sha_fail = 0;
    var whash = alloc(65);
    var wk = 0;
    while (wk < 64) { store8(whash + wk, load8(cbuf + cp + wk)); wk = wk + 1; }
    store8(whash + 64, 0);
    return whash;
    #endif
    # CVE-14 (v6.1.33): exec the hasher via ARGV — `path` is a DISTINCT argv element, never
    # concatenated into a `/bin/sh -c` string, so a lockfile path or a resolved-dep filename
    # containing shell metacharacters can't run commands. `/usr/bin/env` does the PATH lookup.
    var tmpf = _cbt_tmpfile("sha_out");
    if (_sha_tool == 0) {
        # First call: sha256sum, else shasum (macOS 13 has no sha256sum — measured on ach;
        # it has /usr/bin/shasum). Memoised, so the probe runs once per process.
        # A probe that never RAN the tool (pr < 0: no capture, no fork) proves nothing about
        # which tool exists — un-memoise it, or a transient full temp dir on the first hash
        # pins sha256sum for the whole process and every later hash on macOS 13 reads 127 as
        # "neither on PATH". CHANGELOG [6.6.9]
        _sha_tool = 1;
        var pr = _sha_run(tmpf, path);
        if (pr == 127) { _sha_tool = 2; pr = _sha_run(tmpf, path); }
        if (pr == 127) { _sha_tool = 0 - 1; }
        if (pr < 0) { _sha_tool = 0; }
        return _sha_finish(tmpf, pr);
    }
    if (_sha_tool < 0) { _sha_fail = 1; return 0; }
    return _sha_finish(tmpf, _sha_run(tmpf, path));
}

# Run the chosen hasher on `path` with stdout in `tmpf`. Returns its exit status (127 = not
# on PATH), -2 when the capture cannot be created (errno in _sha_errno; nothing is run), or
# -3 (-1 on PE, which has no fork) when the child could not be started or was killed.
fn _sha_run(tmpf, path): i64 {
    # PE: unreachable (`_sha256sum_file`'s certutil arm returns first), and `sys_fork` is a -1
    # stub there — refuse at the source as "could not be started", never a silent nothing.
    #ifdef CYRIUS_TARGET_WIN
    return 0 - 1;
    #endif
    var cfd = sys_open(tmpf, O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    if (cfd < 0) { _sha_errno = 0 - cfd; return 0 - 2; }
    var tool = _sha_tool;
    var pid = sys_fork();
    if (pid < 0) { sys_close(cfd); _sha_errno = 0 - pid; return 0 - 3; }
    if (pid == 0) {
        sys_dup2(cfd, 1);
        sys_close(cfd);
        # stderr quiet: a missing tool is probed, and the caller names the file itself
        var nfd = sys_open("/dev/null", O_WRONLY, 0);
        if (nfd >= 0) { sys_dup2(nfd, 2); sys_close(nfd); }
        var argv[64];   # N BYTES: up to 6 ptrs + NUL
        store64(&argv, "env");
        if (tool == 2) {
            store64(&argv + 8, "shasum");
            store64(&argv + 16, "-a");
            store64(&argv + 24, "256");
            store64(&argv + 32, "-b");
            store64(&argv + 40, path);
            store64(&argv + 48, 0);
        } else {
            store64(&argv + 8, "sha256sum");
            store64(&argv + 16, path);
            store64(&argv + 24, 0);
        }
        sys_execve("/usr/bin/env", &argv, _envp);
        sys_exit(127);
    }
    sys_close(cfd);
    var wst[8];
    store64(&wst, 0);
    if (sys_waitpid(pid, &wst, 0) < 0) { return 0 - 3; }
    var st = load64(&wst);
    if ((st & 127) != 0) { return 0 - 3; }
    return (st >> 8) & 255;
}

# The digest from a `_sha_run` result, or 0 with `_sha_fail` saying why.
fn _sha_finish(tmpf, rc): i64 {
    _sha_fail = 0;
    if (rc == 0 - 2) { _sha_fail = 3; return 0; }
    if (rc < 0) { sys_unlink(tmpf); _sha_fail = 4; return 0; }   # -3 / -1: not started
    var buf = alloc(128);
    var n = file_read_all(tmpf, buf, 127);
    # No digest: ask the temp dir while the capture still holds its space. A hasher whose
    # WRITE to the capture failed (EDQUOT on a usrquota tmpfs, ENOSPC) exits 1 exactly like
    # one that could not read its input, and "could not read it" blamed the dependency file.
    # CHANGELOG [6.6.9]
    if (rc != 127 && (rc != 0 || n < 64)) {
        var pe = _cbt_tmp_probe();
        if (pe != 0) { sys_unlink(tmpf); _sha_errno = pe; _sha_fail = 3; return 0; }
    }
    sys_unlink(tmpf);
    if (rc == 127) { _sha_fail = 1; return 0; }
    if (rc != 0) { _sha_rc = rc; _sha_fail = 2; return 0; }
    if (n < 64) { _sha_rc = 0; _sha_fail = 2; return 0; }
    var k = 0;
    while (k < 64) {
        var c = load8(buf + k);
        if ((c < 48 || c > 57) && (c < 97 || c > 102)) { _sha_rc = 0; _sha_fail = 2; return 0; }
        k = k + 1;
    }
    var hash = alloc(65);
    memcpy(hash, buf, 64);
    store8(hash + 64, 0);
    return hash;
}

# Print why the last `_sha256sum_file` returned 0, to stderr, no newline.
fn _sha_fail_why(): i64 {
    if (_sha_fail == 3) {
        _ew("could not write the hash capture under ");
        _ew(_cbt_tmpdir());
        _ew(" (errno ");
        fmt_int_fd(STDERR_FD, _sha_errno);
        _ew(") — the temp dir is full or unwritable; no digest was captured. Set TMPDIR to an absolute path elsewhere to route around it");
        return 0;
    }
    if (_sha_fail == 1) { _ew("neither sha256sum nor shasum is on PATH"); return 0; }
    if (_sha_fail == 4) { _ew("the hasher could not be started"); return 0; }
    _ew("the hasher could not read it");
    if (_sha_rc != 0) { _ew(" (exit "); fmt_int_fd(STDERR_FD, _sha_rc); _ew(")"); }
    return 0;
}

# CVE-21 (v6.2.30) — cstr equality (length-checked memeq).
fn _cstr_eq(a, b): i64 {
    var la = strlen(a);
    if (la != strlen(b)) { return 0; }
    return memeq(a, b, la);
}

# ── dep-cache git plumbing — CVE-21 (v6.2.30), rebuilt for CVE-43 (v6.6.5) ────────────
#
# WHY this is not a plain `git diff-index --quiet HEAD` any more (CHANGELOG [6.6.5]):
# that command judges the working tree from the SHARED cache's own .git/index and config,
# and it never refreshes the index's stat cache. Both halves were wrong.
#   * A metadata-only change (touch, `cp -a`, a uid-mapped namespace) made every stat
#     entry mismatch, so an untouched checkout was refused as "tampered" — the filed
#     defect, which broke every project on the box resolving that dep+tag.
#   * The same trust in that mutable index and config ACCEPTED real tampering: an
#     in-place same-second edit with mtime restored, assume-unchanged / skip-worktree
#     bits, a local commit with no lock, a missing .git, refs/replace, and a
#     core.fsmonitor hook. Untracked files are invisible to diff-index entirely.
# So: every git call goes through `_git_run`, which strips the repository-LOCATION
# variables git exports into hooks and linked worktrees, pins the work tree, ignores replace
# refs, and denies the cache's own config the vote; and the tree is hashed into a PRIVATE
# throwaway index built from HEAD. The config knobs that CANNOT be overridden on the command
# line (a filter driver whose name the attacker chooses, an include that hides one, eol
# conversion) are refused instead — `_git_cfg_bad_key`. Nothing is ever written inside the
# shared cache — check.sh aliases the
# LIVE ~/.cyrius/deps into its staged home, so a fix that wrote the real index would
# corrupt the maintainer's cache. POSIX-only (mirrors the dep clone).

# Write a NUL-terminated string to stderr. The refusals below are long and carry
# em-dashes; a hand-written byte count beside a literal is its own defect class
# (tests/gates/frontend/write_literal_lengths.sh), so they measure the literal.
fn _ew(s): i64 {
    sys_write(STDERR_FD, s, strlen(s));
    return 0;
}

fn _ga(argv, i, s): i64 {
    store64(argv + i * 8, s);
    return i + 1;
}

fn _cat2(a, b): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}

# `git rev-parse --local-env-vars` plus GIT_NAMESPACE: every variable that RELOCATES the
# repository. Git exports GIT_INDEX_FILE (absolute, .git/index.lock) into hooks and adds
# GIT_DIR in a linked worktree, so a `cyrius deps` run from a pre-commit hook used to
# make `git clone` REWRITE THE USER'S IN-PROGRESS COMMIT INDEX — their `git commit` then
# failed with "invalid object … Error building trees" and the cache was left with no
# index. GIT_CONFIG* is deliberately KEPT: CI injects credentials that way and a
# command-line `-c` outranks it (measured, git 2.55).
fn _git_env_argv(argv, i): i64 {
    i = _ga(argv, i, "env");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_DIR");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_WORK_TREE");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_INDEX_FILE");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_OBJECT_DIRECTORY");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_ALTERNATE_OBJECT_DIRECTORIES");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_COMMON_DIR");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_IMPLICIT_WORK_TREE");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_GRAFT_FILE");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_NO_REPLACE_OBJECTS");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_REPLACE_REF_BASE");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_PREFIX");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_SHALLOW_FILE");
    i = _ga(argv, i, "-u"); i = _ga(argv, i, "GIT_NAMESPACE");
    return i;
}

# `git fsck` exits 1 on POLICY complaints that say nothing about integrity: a commit whose
# author line carries no email, a bad or zero-padded date, a `.gitmodules` url git would
# refuse to clone from. Measured on git 2.55 — missingEmail, missingSpaceBeforeEmail,
# missingSpaceBeforeDate, badDate, zeroPaddedDate, missingNameBeforeEmail and missingAuthor
# all exit 1 on an otherwise perfect repository. Reading that as "object-store damage" makes
# a legitimate dep with one old commit PERMANENTLY unresolvable — the refusal names the
# object store, and the `rm -rf <cache>` it advertises re-clones the same objects and
# refuses again, forever. Each of these is therefore downgraded to a warning. Nothing that
# bears on whether an object hashes to the name it is stored under is touched: the forged
# subtree still exits non-zero (gate axes R17/R20). CHANGELOG [6.6.5].
# ⚠ `fsck.missingName` is NOT here: git 2.55 answers `fatal: Unhandled message id` and
# exits 128 for an id it does not know, which would brick EVERY resolve on that git. The
# caller falls back to a policy-free fsck on 128 for exactly that reason.
fn _git_fsck_policy_argv(argv, i): i64 {
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.missingEmail=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.badEmail=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.missingSpaceBeforeEmail=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.missingSpaceBeforeDate=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.missingNameBeforeEmail=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.badDate=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.badDateOverflow=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.badTimezone=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.zeroPaddedDate=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.missingAuthor=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.missingCommitter=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.missingTaggerEntry=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.badTagName=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.gitmodulesUrl=warn");
    i = _ga(argv, i, "-c"); i = _ga(argv, i, "fsck.gitmodulesPath=warn");
    return i;
}

# 0 = not probed yet, 1 = this filesystem stores the exec bit, 2 = it does not,
# 3 = it could not be probed here (see `_git_fmode_arg`). `_git_fmode_dir` is the
# directory the memo was taken IN: the memo is per-parent, not per-process, because
# two deps can sit on two filesystems (a bind-mounted cache home) and the first dep
# resolved must not decide the answer for the rest. CHANGELOG [6.6.5].
var _git_fmode_cap = 0;
var _git_fmode_dir = 0;

# Can the filesystem under `par` represent the exec bit at all? CHANGELOG [6.6.5].
# `core.fileMode=true` used to be forced unconditionally, which OVERRIDES the value
# git-clone writes from its own probe: on vfat / exfat / NTFS-3g / 9p (a WSL `/mnt/c`, a
# USB stick, a VM share) every 755 entry in the tag then reads as mode-changed, so the dep
# refuses for ever and the advertised recovery cannot fix it — `reset --hard` cannot set a
# bit the filesystem has no room for. 104 of the 138 live checkouts here carry a 755 file.
# So probe instead of assume: write a 0600 file beside the cache, chmod it 0700, and ask
# access(2) both times. Forcing the PROBED value (rather than trusting the cache's config)
# keeps the security half: on a capable filesystem an attacker's `core.fileMode=false` is
# still overridden (gate axis R3).
# ⚠ `xstat` + `STAT_MODE`, never a hand-written offset: st_mode is at byte 24 on
# x86-Linux, **16** on aarch64-Linux and **4** on macOS-arm64's stat64, and reading the
# wrong one returns st_uid — a quiet wrong answer on exactly the targets the host suite
# cannot see. `lib/io.cyr`'s `is_dir` carries the same warning after that bug shipped once.
# (`_file_size` above needs no stat offset at all since 6.6.9: open + lseek(SEEK_END).)
# On Windows `xstat` is -1, so the probe declines — as it should:
# the git flow is POSIX-only there anyway.
fn _file_mode(path): i64 {
    var st[144];
    if (xstat(path, &st) != 0) { return 0 - 1; }
    return load32(&st + STAT_MODE);
}

fn _git_probe_exec_bit(par): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, par);
    str_builder_add_cstr(sb, "/.cyrius-fsprobe-");
    str_builder_add_int(sb, sys_getpid());
    var p = str_data(str_builder_build(sb));
    sys_unlink(p);
    var fd = sys_open(p, O_WRONLY | O_CREAT | O_EXCL, 0x180);   # 0600
    # UNKNOWN, not "no": a directory we cannot write says nothing about what the
    # filesystem can STORE. Answering 2 here turned a read-only parent into a silent
    # `core.fileMode=false` for the whole process — a fail-open needing no attacker
    # control of the cache at all (measured: a chmod -x tamper accepted at rc 0).
    # CHANGELOG [6.6.5].
    if (fd < 0) { return 3; }
    sys_close(fd);
    # Deliberately the SAME question git's own probe asks (write a file, chmod +x, stat it),
    # so the forced value can never disagree with what git-clone detected — `access(2)`
    # would have answered differently on a `noexec` mount, where the bit IS stored.
    var m0 = _file_mode(p);
    sys_chmod(p, 0x1C0);                                        # 0700
    var m1 = _file_mode(p);
    sys_unlink(p);
    if (m0 < 0) { return 3; }
    if (m1 < 0) { return 3; }
    if ((m0 & 0x40) != 0) { return 2; }   # a 0600 file reads +x → the modes are synthetic
    if ((m1 & 0x40) == 0) { return 2; }   # +x did not stick → the bit cannot be stored
    return 1;
}

# The probe file lands BESIDE the checkout (in `<home>/deps/<name>`), never inside it, and
# is unlinked either way. It is deliberately NOT retried a directory further up: that is a
# different filesystem whenever it matters (a cache tree mounted from vfat under an ext4
# home), and the fallback below — git's own clone-time probe, recorded in the cache's
# config — is a measurement of the right filesystem.
#
# Memoised per PARENT DIRECTORY (see the vars above). The value is FORCED when it is known
# — so on a capable filesystem an attacker's `core.fileMode=false` is overridden (R3), and
# on one that cannot store the bit the answer is `false` deterministically, so a cache's own
# `core.fileMode=true` cannot manufacture a permanent refusal out of a mode it controls.
# ⚠ The trade when it is false: a mode-only difference stops being detected. The module
# copy carries BYTES only (no mode), so a mode flip in the cache cannot reach the
# consumer's `lib/` — and on such a filesystem git itself cannot tell the two apart.
# UNKNOWN (nothing writable to probe in) returns 0 and forces NOTHING: git then uses the
# value its own clone-time probe wrote into the cache config. That is weaker than a forced
# value and no weaker than 6.6.4 — the alternative, guessing `false`, is the fail-open this
# release exists to remove, and guessing `true` refuses a read-only vfat cache for ever.
fn _git_fmode_arg(par): i64 {
    var fresh = 0;
    if (_git_fmode_cap == 0) { fresh = 1; }
    elif (_cstr_eq(_git_fmode_dir, par) == 0) { fresh = 1; }
    if (fresh == 1) {
        _git_fmode_cap = _git_probe_exec_bit(par);
        _git_fmode_dir = par;
    }
    if (_git_fmode_cap == 1) { return "core.fileMode=true"; }
    if (_git_fmode_cap == 2) { return "core.fileMode=false"; }
    return 0;
}

# Can git be run at ALL on this platform? `lib/syscalls_windows.cyr` defines
# `fn sys_fork(): i64 { return 0 - 1; }`, so on PE every `_git_run` returns -1 and every
# verdict would be "git said no" when the truth is "git never ran". The whole git-dep flow
# (the clone included) has always been POSIX-only there; this is the check ASKING, instead
# of reading a fork failure as evidence about the cache. CHANGELOG [6.6.5].
fn _git_exec_available(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    return 1;
}

# When non-zero, the next `_git_run` child reads stdin from this file (see `_git_raw_check`).
var _git_in_path = 0;

# Per-process capture of the last git child's stderr, so a refusal can quote git's own
# hint (the dubious-ownership / safe.directory paragraph is the one users need).
var _git_err_path = 0;
# ⛔ 6.6.9 bite 9 — "the check could not write its temp files" is its OWN verdict (reason 10).
# `_git_run`'s child used to open the stdout capture itself and, when that failed (EDQUOT,
# ENOSPC, no inodes), ran git with the PARENT's stdout: the answer went to the terminal (the
# bare sha aethersafha saw), the capture read back empty, and `_git_rev` returned 0 —
# identical to "the tag does not resolve" — so a healthy cache was refused as TAMPERED with
# `rm -rf` advice, for every dep at once, for as long as the quota lasted. The capture is now
# opened by the PARENT; a failure records its errno here and git is never run uncaptured.
# CHANGELOG [6.6.9]
var _git_cap_errno = 0;
var _git_cap_want = 0;   # bytes the judge's probe must fit (see _git_cache_verify)

fn _git_errfile(): i64 {
    if (_git_err_path == 0) { _git_err_path = _cbt_tmpfile("git_err"); }
    return _git_err_path;
}

# Remove the capture file. Called on every path that is done with it, so the CLI's private
# temp dir is left as it was found (there is no exit hook here to sweep it later).
fn _git_err_clear(): i64 {
    if (_git_err_path != 0) { sys_unlink(_git_err_path); }
    return 0;
}

# First line of that capture (trimmed, bounded), or 0 when there is nothing to quote.
fn _git_err_first_line(): i64 {
    if (_git_err_path == 0) { return 0; }
    var buf = alloc(256);
    var n = file_read_all(_git_err_path, buf, 255);
    if (n <= 0) { return 0; }
    var i = 0;
    while (i < n && load8(buf + i) != 10) { i = i + 1; }
    while (i > 0 && load8(buf + i - 1) == 13) { i = i - 1; }
    if (i == 0) { return 0; }
    store8(buf + i, 0);
    return buf;
}

# Run one git command against a dep cache. `idx` (when non-zero) is the THROWAWAY index
# the command must use; `outf` (when non-zero) captures stdout. Returns git's exit
# status, or -1 when the child could not be run or was killed — every caller treats
# non-zero as failure, so a fork failure can no longer read as "clean" (it did: the old
# `_git_worktree_clean` left its wait-status buffer uninitialised and returned clean).
#
# Discovery stays ON so git's safe.directory ownership check still applies — an explicit
# `--git-dir` SKIPS that check (measured) — but GIT_CEILING_DIRECTORIES stops it at the
# cache's parent, so a cache with no .git can never resolve to the ENCLOSING repo (a
# CYRIUS_HOME inside a git workspace used to pin that repo's HEAD as the dep commit).
# GIT_WORK_TREE is SET (not just scrubbed): the cache's own `core.worktree` otherwise names
# the directory every content command reads, and a pristine copy parked beside a tampered
# cache compared clean at exit 0 (measured). `pol` adds the fsck message-id policy above.
fn _git_run(clone_dir, idx, a1, a2, a3, a4, outf, pol): i64 {
    # v6.6.6 — PE arm, defence in depth. `_git_exec_available()` already gates every
    # CALLER (6.6.5 for the verify half, 6.6.6 for the clone), but the fork here is a -1
    # stub on Windows and a future caller that forgot the gate would read `-1` as "git
    # said no". Refuse at the source so the answer is the same either way. CHANGELOG [6.6.6]
    #ifdef CYRIUS_TARGET_WIN
    return 0 - 1;
    #endif
    var cl = strlen(clone_dir);
    var pe = cl;
    while (pe > 0 && load8(clone_dir + pe - 1) != 47) { pe = pe - 1; }
    if (pe > 1) { pe = pe - 1; }
    var par = alloc(pe + 1);
    memcpy(par, clone_dir, pe);
    store8(par + pe, 0);
    # git IGNORES a non-absolute ceiling entry, and CYRIUS_HOME may be relative.
    var ceil = _cat2("GIT_CEILING_DIRECTORIES=", _abs_path(par));
    var wte = _cat2("GIT_WORK_TREE=", _abs_path(clone_dir));
    # Probed in the PARENT: the memo has to survive the fork to be a per-process memo.
    var fmode = _git_fmode_arg(par);
    var ixe = 0;
    if (idx != 0) { ixe = _cat2("GIT_INDEX_FILE=", idx); }
    var errf = _git_errfile();
    # The stdout capture is opened HERE, before the fork: a capture that cannot be created
    # returns -2 with the errno recorded, and git is not run. CHANGELOG [6.6.9]
    var cfd = 0 - 1;
    if (outf != 0) {
        cfd = sys_open(outf, O_WRONLY | O_CREAT | O_TRUNC, 0x180);
        if (cfd < 0) { _git_cap_errno = 0 - cfd; return 0 - 2; }
    }
    var pid = sys_fork();
    if (pid < 0) { if (cfd >= 0) { sys_close(cfd); } return 0 - 1; }
    if (pid == 0) {
        # `--stdin-paths` is the only reader (see `_git_raw_check`); a global rather than a
        # 9th parameter because every other call site would have to carry a 0 for it, and
        # the one user sets and clears it around a single call. CHANGELOG [6.6.5].
        if (_git_in_path != 0) {
            var ifd = sys_open(_git_in_path, O_RDONLY, 0);
            if (ifd >= 0) { sys_dup2(ifd, 0); sys_close(ifd); }
            else { sys_exit(127); }
        }
        var ofd = cfd;
        if (outf == 0) { ofd = sys_open("/dev/null", O_WRONLY, 0); }
        if (ofd >= 0) { sys_dup2(ofd, 1); sys_close(ofd); }
        var efd = sys_open(errf, O_WRONLY | O_CREAT | O_TRUNC, 0x180);
        if (efd < 0) { efd = sys_open("/dev/null", O_WRONLY, 0); }
        if (efd >= 0) { sys_dup2(efd, 2); sys_close(efd); }
        var argv[1024];   # N BYTES: <= 128 ptrs; the fsck policy alone is 30 of them
        var i = _git_env_argv(&argv, 0);
        i = _ga(&argv, i, ceil);
        i = _ga(&argv, i, wte);
        if (ixe != 0) { i = _ga(&argv, i, ixe); }
        i = _ga(&argv, i, "git");
        i = _ga(&argv, i, "--no-replace-objects");
        i = _ga(&argv, i, "-C"); i = _ga(&argv, i, clone_dir);
        i = _ga(&argv, i, "-c"); i = _ga(&argv, i, "core.fsmonitor=false");
        i = _ga(&argv, i, "-c"); i = _ga(&argv, i, "core.hooksPath=/dev/null");
        if (fmode != 0) { i = _ga(&argv, i, "-c"); i = _ga(&argv, i, fmode); }
        i = _ga(&argv, i, "-c"); i = _ga(&argv, i, "core.symlinks=true");
        i = _ga(&argv, i, "-c"); i = _ga(&argv, i, "core.untrackedCache=false");
        # The USER's global attributes file must not decide a dep's verdict either; the
        # cache's own `.git/info/attributes` is refused outright (reason 7).
        i = _ga(&argv, i, "-c"); i = _ga(&argv, i, "core.attributesFile=/dev/null");
        if (pol == 1) { i = _git_fsck_policy_argv(&argv, i); }
        if (a1 != 0) { i = _ga(&argv, i, a1); }
        if (a2 != 0) { i = _ga(&argv, i, a2); }
        if (a3 != 0) { i = _ga(&argv, i, a3); }
        if (a4 != 0) { i = _ga(&argv, i, a4); }
        store64(&argv + i * 8, 0);
        sys_execve("/usr/bin/env", &argv, _envp);
        sys_exit(127);
    }
    if (cfd >= 0) { sys_close(cfd); }
    var wst[8];
    store64(&wst, 0);
    if (sys_waitpid(pid, &wst, 0) < 0) { return 0 - 1; }
    var st = load64(&wst);
    if ((st & 127) != 0) { return 0 - 1; }      # killed by a signal → distrust
    return (st >> 8) & 255;
}

# `rev-parse --verify -q <rev>` → a validated NUL-terminated hex name, or 0.
fn _git_rev(clone_dir, rev): i64 {
    var tmpf = _cbt_tmpfile("git_rev_out");
    if (_git_run(clone_dir, 0, "rev-parse", "--verify", "-q", rev, tmpf, 0) != 0) {
        sys_unlink(tmpf);
        return 0;
    }
    var buf = alloc(128);
    var nn = file_read_all(tmpf, buf, 127);
    sys_unlink(tmpf);
    if (nn < 40) { return 0; }
    var hl = 0;
    while (hl < nn) {
        var hc = load8(buf + hl);
        var ishex = 0;
        if (hc >= 48 && hc <= 57) { ishex = 1; }
        if (hc >= 97 && hc <= 102) { ishex = 1; }
        if (ishex == 0) { break; }
        hl = hl + 1;
    }
    # 40 = sha1, 64 = sha256. The pin line carries whatever this returns, and a repo
    # never changes object format under a tag, so both compare like for like.
    if (hl != 40 && hl != 64) { return 0; }
    store8(buf + hl, 0);
    return buf;
}

# CVE-21 (v6.2.30) — the commit HEAD resolves to in the cached checkout, or 0.
# `HEAD^{commit}` rather than bare HEAD so a tag object or a symref cannot be pinned.
fn _git_head_sha(clone_dir): i64 {
    return _git_rev(clone_dir, "HEAD^{commit}");
}

# The cache must carry its OWN repository: a real .git directory, never a symlink (which
# could point at another repo's .git) and never a gitfile (a linked worktree). Checked
# BEFORE any git runs, so a hand-staged directory never reaches git discovery at all.
fn _git_has_repo(clone_dir): i64 {
    var gds = str_from(_cat2(clone_dir, "/.git"));
    if (is_symlink(gds) == 1) { return 0; }
    if (is_dir(gds) == 0) { return 0; }
    return 1;
}

fn _git_verify_cleanup(idx, outf): i64 {
    sys_unlink(idx);
    sys_unlink(_cat2(idx, ".lock"));
    sys_unlink(outf);
    return 0;
}

# The populated submodule directory that tripped reason 6, for the refusal message.
var _git_bad_gitlink = 0;

# The offending config key / path (reason 7) or the cache's own origin url (reason 8).
var _git_bad_cfg = 0;
# What the manifest declared, for the reason-8 message.
var _git_want_url = 0;

# Keys the cache's LOCAL config must not carry. A `git clone` writes exactly six — measured
# across all 138 live checkouts here: core.repositoryformatversion, core.filemode, core.bare,
# core.logallrefupdates, remote.origin.url, remote.origin.fetch — so none of these appears by
# accident, and 0 of the 138 carry one. CHANGELOG [6.6.5]. Why each is a REFUSAL rather than
# something `-c` overrides on the command line:
#   filter.* / diff.*  a clean / textconv driver is a PROGRAM git runs over the working tree
#                      while hashing it, and it rewrites the bytes it feeds the comparison.
#                      Measured: `filter.x.clean` printing the honest content made an edited
#                      file compare EQUAL — exit 0, tampered bytes vendored — and the
#                      cache-named program ran twice per resolve. `-c` cannot neutralise it:
#                      the driver NAME is attacker-chosen, so there is nothing fixed to set.
#   include.* /        git FOLLOWS these when it reads the config, but `config --local
#   includeIf.*        --name-only --list` does NOT print what they pull in (measured: the
#                      included filter laundered the edit and the listing showed only
#                      `include.path`). The include itself is therefore the refusable thing.
#   core.autocrlf /    end-of-line conversion is applied while hashing, so it launders a
#   core.eol           CRLF/LF-only edit. These cannot be forced off either: a user whose
#                      GLOBAL autocrlf is on has a legitimately CRLF working tree and forcing
#                      `false` would refuse it (gate axis B9).
#   core.worktree      names the directory the content commands read. GIT_WORK_TREE in
#                      `_git_run` already overrides it, but a cache carrying one was pointed
#                      somewhere by someone, so it is named rather than silently corrected.
#   extensions.        turns on a SECOND config file, `.git/config.worktree`, whose keys
#   worktreeConfig     `config --local --list` does NOT print (measured) — so a filter, an
#                      autocrlf or a core.worktree hidden there is invisible to this scan.
#                      One key closes the whole scope; a clone never enables it.
# ⚠ git lowercases the section and variable halves of a key in `--name-only --list` output
# (measured: `core.workTree` prints as `core.worktree`, `FILTER.MiXeD.clean` as
# `filter.MiXeD.clean`), so matching lowercase prefixes here is exact. Only the SUBSECTION
# keeps its case, and no rule below looks at one.
# An ALLOWLIST was the other option and is rejected on purpose: git writes platform-dependent
# extras at clone time (core.ignorecase, core.precomposeunicode, core.symlinks on Windows),
# so an allowlist derived on Linux would false-refuse on ecb/cass — and a false refusal of an
# untouched cache is the defect this release exists to fix.
fn _git_cfg_bad_key(k): i64 {
    var n = strlen(k);
    if (n > 7) { if (memeq(k, "filter.", 7) == 1) { return 1; } }
    if (n > 5) { if (memeq(k, "diff.", 5) == 1) { return 1; } }
    if (n > 8) { if (memeq(k, "include.", 8) == 1) { return 1; } }
    if (n > 10) { if (memeq(k, "includeif.", 10) == 1) { return 1; } }
    if (_cstr_eq(k, "core.autocrlf") == 1) { return 1; }
    if (_cstr_eq(k, "core.eol") == 1) { return 1; }
    if (_cstr_eq(k, "core.worktree") == 1) { return 1; }
    if (_cstr_eq(k, "extensions.worktreeconfig") == 1) { return 1; }
    return 0;
}

# Reason 7 when the cache's own git configuration can rewrite what the comparison sees,
# else 0 (3 when git itself failed). Runs BEFORE any command that touches the working tree,
# because by the time a filter has laundered the bytes it has also already RUN.
fn _git_cfg_hazard(clone_dir, outf): i64 {
    # `.git/info/attributes` assigns filters and eol conversion to paths and is NOT carried
    # by the tag (a tracked `.gitattributes` is, and is verified like any other file). A
    # clone never writes it; 0 of the 138 live checkouts have one.
    var ap = _cat2(clone_dir, "/.git/info/attributes");
    if (file_exists(ap) == 1) { _git_bad_cfg = ap; return 7; }
    # 1 = nothing listed; anything else non-zero is git failing, not "clean" — including a
    # NEGATIVE status (not run, or a capture that could not be created): since 6.6.9 the
    # capture is created by the parent before the fork, so an empty one no longer means git
    # ran. `> 1` let those through to the size check. CHANGELOG [6.6.9]
    var lr = _git_run(clone_dir, 0, "config", "--local", "--name-only", "--list", outf, 0);
    if (lr != 0 && lr != 1) { return 3; }
    var sz = _file_size(outf);
    if (sz < 0) { return 3; }
    if (sz == 0) { return 0; }
    var b = alloc(sz + 1);
    if (file_read_all(outf, b, sz) != sz) { return 3; }
    store8(b + sz, 0);
    # A config key name cannot contain a newline (the section header and the key live on one
    # line each), so splitting on 0x0A is exact.
    var p = 0;
    while (p < sz) {
        var s = p;
        while (p < sz && load8(b + p) != 10) { p = p + 1; }
        store8(b + p, 0);
        if (_git_cfg_bad_key(b + s) == 1) { _git_bad_cfg = b + s; return 7; }
        p = p + 1;
    }
    return 0;
}

# A forge serves `…/name`, `…/name.git` and `…/name/` as ONE repository, so those spellings
# are one url and comparing the strings byte-for-byte is a FALSE REFUSAL — the very defect
# class this release exists to fix. Measured over the 126 `cyrius.cyml` manifests on this
# box against the 138 live caches: 19 declarations in 11 repos differ from their cache by
# exactly that suffix (tyche 1.0.1 alone is declared both ways by 8 consumers), and an exact
# compare refuses them with NO fixed point — removing the cache as the message says makes
# the next consumer refuse instead, for ever. Compare the comparable length: one trailing
# `/`, then one trailing `.git`. CHANGELOG [6.6.5].
fn _git_url_cmp_len(u): i64 {
    var n = strlen(u);
    if (n > 1 && load8(u + n - 1) == 47) { n = n - 1; }
    if (n > 4 && memeq(u + n - 4, ".git", 4) == 1) { n = n - 4; }
    return n;
}

fn _git_url_same(a, b): i64 {
    var la = _git_url_cmp_len(a);
    if (la != _git_url_cmp_len(b)) { return 0; }
    if (la == 0) { return 0; }
    return memeq(a, b, la);
}

# Same question for a url that is not NUL-terminated (a field inside cyrius.lock).
fn _git_url_same_n(p, n, want): i64 {
    return _git_url_same(_git_cstr_copy(p, n), want);
}

# The cache must CLAIM to come from the url the manifest declares. The clone directory is
# keyed on dep NAME and TAG only, so without this a second dep called `foo` at tag `1.0.0` —
# or a hand-staged `--depth 1` clone of any repo that carries that tag — is reused as this
# one: measured at exit 0 with the foreign bytes vendored and the foreign commit written
# into cyrius.lock. CHANGELOG [6.6.5].
# ⚠ This is a staging / collision check, NOT a proof of origin. An attacker who can write
# the cache's config can write this url too, and nothing offline can tell a locally-built
# commit with the tag moved onto it from the real one — that bound is the `cyrius.lock`
# commit pin (trust-on-first-use) and the remote itself.
fn _git_origin_mismatch(clone_dir, want_url, outf): i64 {
    if (want_url == 0) { return 0; }
    if (_git_run(clone_dir, 0, "config", "--local", "--get", "remote.origin.url", outf, 0) != 0) {
        _git_bad_cfg = "(none)";
        _git_want_url = want_url;
        return 8;
    }
    var sz = _file_size(outf);
    if (sz <= 0) { _git_bad_cfg = "(none)"; _git_want_url = want_url; return 8; }
    var b = alloc(sz + 1);
    if (file_read_all(outf, b, sz) != sz) { return 3; }
    store8(b + sz, 0);
    while (sz > 0) {
        var lc = load8(b + sz - 1);
        if (lc != 10) { if (lc != 13) { break; } }
        sz = sz - 1;
        store8(b + sz, 0);
    }
    if (_git_url_same(b, want_url) == 0) {
        _git_bad_cfg = b;
        _git_want_url = want_url;
        return 8;
    }
    return 0;
}

# `ls-files -s -z` rows: a mode-160000 (gitlink) entry is a directory the resolver never
# populates, and NOTHING else looks inside one — diff-files, ls-files -o and status all
# skip it, so a planted file there is invisible. Real caches carry gitlinks (shravan
# 2.8.0/2.8.1 have a stray one with no .gitmodules), which is why they are checked
# rather than refused. Returns 0 (all empty), 4 (a gitlink dir is missing) or 6.
fn _git_gitlink_scan(clone_dir, lb, sz): i64 {
    var p = 0;
    while (p < sz) {
        var rs = p;
        while (p < sz && load8(lb + p) != 0) { p = p + 1; }
        if (p - rs > 7 && memeq(lb + rs, "160000 ", 7) == 1) {
            var q = rs;
            while (q < p && load8(lb + q) != 9) { q = q + 1; }
            if (q < p) {
                var gp = _cat2(_cat2(clone_dir, "/"), lb + q + 1);
                var gl = str_from(gp);
                if (is_dir(gl) == 0) { return 4; }
                # 6.6.10: CHECKED. An unlistable gitlink directory read as EMPTY and passed —
                # the tamper check failed OPEN on exactly the directory it could not see.
                var glents = vec_new();
                if (dir_list_checked(gl, glents) < 0) { _git_bad_gitlink = gp; return 6; }
                if (vec_len(glents) != 0) { _git_bad_gitlink = gp; return 6; }
            }
        }
        p = p + 1;
    }
    return 0;
}

# ── the raw-byte half ────────────────────────────────────────────────────────────────────
# `diff-files` compares clean(working tree) with the blob, and `clean` is whatever the
# ATTRIBUTES say — so a `.gitattributes` CARRIED BY THE TAG decides the comparison. With
# `* text=auto` tracked at the tag, a CRLF-only rewrite of a cached module hashes back to
# the same blob and the tamper is accepted at exit 0 with the changed bytes vendored
# (measured; 6.6.4 refused it only because its stat check fired first). This is the same
# laundering class as `core.autocrlf` (R26) and `.git/info/attributes` (R27), which ARE
# refused — the difference is that a tracked `.gitattributes` is legitimate, so it cannot
# simply be rejected. `_git_cache_verify`'s comment used to say a tracked `.gitattributes`
# "is verified like any other file": true of the FILE, not of its EFFECT. CHANGELOG [6.6.5].
#
# So compare the raw bytes too: `hash-object --no-filters` (git's own words: "ignoring any
# input filter … including the end-of-line conversion") over every tracked regular file,
# against the sha the tag records. A difference is then EXPLAINED or refused — `cat-file
# --filters` re-materialises what git would check out for that path, and if the working
# tree equals that, the conversion is honest (a user with `core.autocrlf=true` in their
# global config has a legitimately CRLF working tree, and refusing it would be exactly the
# false refusal this release exists to remove). Cost: zero extra git processes when nothing
# is converted, which is every one of the 138 live caches.
var _git_bad_path = 0;

fn _git_row_shalen(lb, rs, re): i64 {
    var q = rs + 7;
    while (q < re && load8(lb + q) != 32) { q = q + 1; }
    if (q >= re) { return 0; }
    return q - rs - 7;
}

fn _git_row_path(lb, rs, re): i64 {
    var q = rs;
    while (q < re && load8(lb + q) != 9) { q = q + 1; }
    if (q >= re) { return 0; }
    return lb + q + 1;
}

# A row worth hashing: a regular file (100644/100755 — a symlink's blob is its TARGET, and
# hashing the path would follow it; a gitlink has no blob here), whose path can be written
# to `--stdin-paths`, which is LF-separated. A path containing an LF can only come from the
# TAG — an attacker who can write the cache cannot ADD a tracked path (an extra file is
# reason 5, a changed one is reason 4) — so skipping it is not a hole.
fn _git_row_hashable(lb, rs, re): i64 {
    if (re - rs < 50) { return 0; }
    var okm = 0;
    if (memeq(lb + rs, "100644 ", 7) == 1) { okm = 1; }
    if (memeq(lb + rs, "100755 ", 7) == 1) { okm = 1; }
    if (okm == 0) { return 0; }
    var pp = _git_row_path(lb, rs, re);
    if (pp == 0) { return 0; }
    var i = 0;
    while (load8(pp + i) != 0) {
        if (load8(pp + i) == 10) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _git_cstr_copy(p, n): i64 {
    var b = alloc(n + 1);
    memcpy(b, p, n);
    store8(b + n, 0);
    return b;
}

# Does the conversion git would APPLY to the tag's blob produce exactly these working-tree
# bytes? 1 = yes (honest), 0 = no (or the question could not be asked).
# ⚠ `--filters` runs the SMUDGE side, so ask what it can run: a `filter.*` driver in the
# cache's own config is already refused (reason 7, before this point), `core.attributesFile`
# is pinned to /dev/null, and a tracked `.gitattributes` can only NAME a driver — the program
# itself has to come from a config this check has either refused or does not read. So the
# attacker picks the attribute, never the binary. Do not relax reason 7 without revisiting
# this. CHANGELOG [6.6.5].
fn _git_conv_explains(clone_dir, idx, path, blobsha, rawsha, outf): i64 {
    var cf = _cbt_tmpfile("dep_verify_conv");
    if (_git_run(clone_dir, idx, "cat-file", "--filters", _cat2("--path=", path), blobsha, cf, 0) != 0) {
        sys_unlink(cf);
        return 0;
    }
    var hr = _git_run(clone_dir, idx, "hash-object", "--no-filters", cf, 0, outf, 0);
    sys_unlink(cf);
    if (hr != 0) { return 0; }
    var n = _file_size(outf);
    if (n <= 0) { return 0; }
    var b = alloc(n + 1);
    if (file_read_all(outf, b, n) != n) { return 0; }
    store8(b + n, 0);
    while (n > 0) {
        var lc = load8(b + n - 1);
        if (lc != 10) { if (lc != 13) { break; } }
        n = n - 1;
        store8(b + n, 0);
    }
    return _cstr_eq(b, rawsha);
}

# 0 = every tracked file's raw bytes are the tag's (or a declared conversion explains the
# difference), 9 = laundered, 3 = git failed / the output did not line up.
fn _git_raw_check(clone_dir, idx, lb, sz, outf): i64 {
    var sb = str_builder_new();
    var n = 0;
    var p = 0;
    while (p < sz) {
        var rs = p;
        while (p < sz && load8(lb + p) != 0) { p = p + 1; }
        if (_git_row_hashable(lb, rs, p) == 1) {
            str_builder_add_cstr(sb, _git_row_path(lb, rs, p));
            str_builder_add_cstr(sb, "\n");
            n = n + 1;
        }
        p = p + 1;
    }
    if (n == 0) { return 0; }
    var pl = _cbt_tmpfile("dep_verify_paths");
    var ps = str_builder_build(sb);
    var pn = str_len(ps);
    var pw = file_write_all(pl, str_data(ps), pn);
    if (pw != pn) {
        sys_unlink(pl);
        _git_cap_errno = 28;                      # a short write reads as ENOSPC
        if (pw < 0) { _git_cap_errno = 0 - pw; }
        return 3;
    }
    _git_in_path = pl;
    var hr = _git_run(clone_dir, idx, "hash-object", "--no-filters", "--stdin-paths", 0, outf, 0);
    _git_in_path = 0;
    sys_unlink(pl);
    if (hr != 0) { return 3; }
    var hsz = _file_size(outf);
    if (hsz <= 0) { return 3; }
    var hb = alloc(hsz + 1);
    if (file_read_all(outf, hb, hsz) != hsz) { return 3; }
    store8(hb + hsz, 0);
    # git prints one hash per input path, in the order given, so the second walk pairs them.
    var hp = 0;
    p = 0;
    while (p < sz) {
        var rs2 = p;
        while (p < sz && load8(lb + p) != 0) { p = p + 1; }
        if (_git_row_hashable(lb, rs2, p) == 1) {
            var he = hp;
            while (he < hsz && load8(hb + he) != 10) { he = he + 1; }
            var sl = _git_row_shalen(lb, rs2, p);
            if (sl == 0) { return 3; }
            if (he - hp != sl) { return 3; }
            if (memeq(hb + hp, lb + rs2 + 7, sl) == 0) {
                var pth = _git_row_path(lb, rs2, p);
                var bsha = _git_cstr_copy(lb + rs2 + 7, sl);
                var rsha = _git_cstr_copy(hb + hp, sl);
                var ex = _git_conv_explains(clone_dir, idx, pth, bsha, rsha, outf);
                if (ex == 0) { _git_bad_path = pth; return 9; }
            }
            hp = he + 1;
        }
        p = p + 1;
    }
    return 0;
}

# The cached checkout must be internally consistent with the tag it claims: HEAD ==
# refs/tags/<tag>, every object reachable from HEAD hash-consistent, and the working tree
# hashing back to HEAD's tree with no extra files — computed in a PRIVATE throwaway index
# built from HEAD, so neither the cache's stat cache (the filed FALSE refusal) nor its
# assume-unchanged / skip-worktree bits (a silent ACCEPT) take part. `tag_or_0` is 0 for an
# untagged dep: the pin step is skipped, the content steps are not. `want_url` (0 to skip)
# is the url the manifest declares. Returns 0 on a match, else a reason code.
# ⚠ WHAT THIS DOES NOT PROVE. It is not a proof that the objects came from `want_url`.
# Everything it reads lives inside the cache, so an attacker who can write `.git` can build
# a self-consistent repository — commit the tamper locally and `git tag -f` onto it, and
# nothing here can tell that from the real tag (measured). What catches THAT is the
# `cyrius.lock` commit pin, which is trust-on-first-use: honest on the first resolve, held
# against every later one. Offline, that is the bound. CHANGELOG [6.6.5].
# The verify's temps (idx, outf) are created and removed HERE, and the verdict is judged
# while they still exist: the raw check returns without cleaning up, so a temp dir that was
# nearly full when git needed it is still nearly full when `_git_cap_judge` asks.
# CHANGELOG [6.6.9]
fn _git_cache_verify(clone_dir, tag_or_0, head, want_url): i64 {
    _git_cap_errno = 0;
    var idx = _cbt_tmpfile("dep_verify_index");
    var outf = _cbt_tmpfile("dep_verify_out");
    _git_verify_cleanup(idx, outf);
    # The probe must be as big as what git was writing: the private index (and its
    # index.lock) is the size of the cache's own — a 400-file dep's is ~40 KB, and a probe
    # smaller than that passed while read-tree / update-index had failed. CHANGELOG [6.6.9]
    _git_cap_want = _git_index_size(clone_dir) + 4096;
    var r = _git_cap_judge(_git_cache_verify_raw(clone_dir, tag_or_0, head, want_url, idx, outf));
    _git_cap_want = 0;
    _git_verify_cleanup(idx, outf);
    return r;
}

# Size of the cache's own `.git/index`, or 0 when unknown — never following a symlink and
# never blocking on a FIFO (the cache is untrusted). It only sizes the judge's probe; git
# itself never reads this file (every verify runs on a private GIT_INDEX_FILE). CHANGELOG [6.6.9]
fn _git_index_size(clone_dir): i64 {
    #ifdef CYRIUS_TARGET_WIN
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    var ip = _cat2(clone_dir, "/.git/index");
    if (is_symlink(str_from(ip)) == 1) { return 0; }
    var fd = sys_open(ip, O_RDONLY | O_NONBLOCK, 0);
    if (fd < 0) { return 0; }
    var n = xlseek(fd, 0, 2);
    sys_close(fd);
    if (n < 0) { return 0; }
    return n;
    #endif
}

# Record the temp dir's errno (if it refuses a fresh file now) unless one is already known.
fn _git_cap_note(): i64 {
    if (_git_cap_errno == 0) { _git_cap_errno = _cbt_tmp_probe_n(_git_cap_want); }
    return 0;
}

# A refusal `r` stands only when every capture it read was really written. When one could
# not be (recorded by `_git_run`), or the private temp dir refuses a fresh file now (probed
# with the check's own temps still in place), the verdict is reason 10 — still a refusal
# (fail closed), but named as what it is, with no tamper accusation and no `rm -rf` advice.
# Asked only on a refusal, so a clean resolve pays nothing. CHANGELOG [6.6.9]
fn _git_cap_judge(r): i64 {
    if (r == 0) { return 0; }
    _git_cap_note();
    if (_git_cap_errno != 0) { return 10; }
    return r;
}

# Every return leaves idx/outf in place for the caller's judge + cleanup.
fn _git_cache_verify_raw(clone_dir, tag_or_0, head, want_url, idx, outf): i64 {
    if (_git_has_repo(clone_dir) == 0) { return 1; }
    # FIRST, before anything reads the working tree: a filter driver declared in the cache's
    # own config would already have run by then, and would have decided the answer.
    var cfr = _git_cfg_hazard(clone_dir, outf);
    if (cfr != 0) { return cfr; }
    var our = _git_origin_mismatch(clone_dir, want_url, outf);
    if (our != 0) { return our; }
    if (tag_or_0 != 0) {
        var tr = _cat2(_cat2("refs/tags/", tag_or_0), "^{commit}");
        var tc = _git_rev(clone_dir, tr);
        if (tc == 0) {
            tc = _git_rev(clone_dir, _cat2(_cat2("refs/remotes/origin/", tag_or_0), "^{commit}"));
        }
        if (tc == 0) { return 2; }
        if (_cstr_eq(tc, head) == 0) { return 2; }
    }
    # fsck FIRST: read-tree does NOT verify that an object hashes to the name it is
    # stored under, so a forged subtree spliced in under the original tree's name is
    # read back whole and diff-files then agrees with the planted working-tree bytes.
    # ⚠ `--connectivity-only` does NOT catch that — measured: it exits 0 on the forged
    # repo once the cache's own index (whose cache-tree happened to name the mangled
    # object) is out of the way. Only a FULL fsck hashes the objects. Cost measured on
    # the corpus: 11 ms on a typical dep, 70 ms on the largest (dhvani 2.2.4, 392
    # objects). CHANGELOG [6.6.5].
    var fr = _git_run(clone_dir, idx, "fsck", "--no-dangling", "--no-progress", 0, 0, 1);
    # A git that does not know one of the policy ids answers `fatal: Unhandled message id`
    # and exits 128 — that must never brick every resolve on that git, so fall back to the
    # unmodified fsck (which only restores the old, stricter behaviour).
    if (fr == 128) { fr = _git_run(clone_dir, idx, "fsck", "--no-dangling", "--no-progress", 0, 0, 0); }
    if (fr != 0) { return 3; }
    if (_git_run(clone_dir, idx, "read-tree", "HEAD", 0, 0, 0, 0) != 0) { return 3; }
    # A fresh index holds no stat data, so this HASHES every file rather than trusting a
    # cached mtime. 0 or 1 only mean "something may differ", which diff-files reports
    # precisely. ANYTHING ELSE is git failing — 128 is "cannot create index.lock" in a full
    # temp dir — and must not fall through: diff-files on an index with no stat data then
    # exits 1 and a healthy cache read as reason 4, tampered. CHANGELOG [6.6.9]
    var urr = _git_run(clone_dir, idx, "update-index", "-q", "--refresh", 0, 0, 0);
    if (urr != 0 && urr != 1) { return 3; }
    var dfr = _git_run(clone_dir, idx, "diff-files", "--quiet", 0, 0, 0, 0);
    if (dfr != 0) {
        # 1 = a real difference; anything else (or -1) is git failing, not the tree differing.
        if (dfr == 1) { return 4; }
        return 3;
    }
    # No --exclude-standard: a file the tag does not carry is a refusal even when
    # .gitignore or .git/info/exclude hides it. A module planted at a declared-but-absent
    # path, or at the lib/<basename> fallback, was vendored through exactly this gap.
    if (_git_run(clone_dir, idx, "ls-files", "-o", "-z", 0, outf, 0) != 0) { return 3; }
    var osz = _file_size(outf);
    if (osz < 0) { return 3; }   # no capture = git failed, not "clean"
    if (osz != 0) { return 5; }
    if (_git_run(clone_dir, idx, "ls-files", "-s", "-z", 0, outf, 0) != 0) { return 3; }
    var sz = _file_size(outf);
    if (sz < 0) { return 3; }
    var lb = alloc(sz + 1);
    var ln = file_read_all(outf, lb, sz);
    if (ln != sz) { return 3; }
    store8(lb + sz, 0);
    var gl = _git_gitlink_scan(clone_dir, lb, sz);
    if (gl != 0) { return gl; }
    # LAST, and on the same `ls-files -s` rows: diff-files has already agreed, so anything
    # this finds is a difference an attribute conversion was hiding. CHANGELOG [6.6.5].
    var rr = _git_raw_check(clone_dir, idx, lb, sz, outf);
    if (rr == 0) { _git_err_clear(); }
    return rr;
}

fn _git_cache_reason(r): i64 {
    if (r == 1) { return "its .git is missing, is not a real directory, or git cannot read it"; }
    if (r == 2) { return "HEAD is not the tag's commit (a local commit, a checkout, or a moved tag)"; }
    if (r == 3) { return "git could not verify it (object-store damage or a git failure)"; }
    if (r == 4) { return "a tracked file's content, mode or type differs from the tag"; }
    if (r == 5) { return "it holds files the tag does not (untracked or ignored)"; }
    if (r == 6) { return "a submodule directory is populated (the resolver never populates submodules)"; }
    if (r == 7) { return "its .git carries configuration that rewrites or redirects what git compares"; }
    if (r == 8) { return "its origin remote is not the URL this dep declares (a different repo's checkout)"; }
    if (r == 9) { return "a tracked file's bytes are not the tag's, and a content conversion was hiding it"; }
    if (r == 10) { return "the check could not write its temp files, so the cache was NOT judged"; }
    return "it is not readable as a git checkout";
}

# One refusal for every reason, naming the dep, the tag, the CACHE PATH and a recovery
# that works OFFLINE. Through 6.6.4 the only message named no path and advised deleting
# the clone — which forces a network re-clone, so an offline box could not recover.
fn _git_cache_refuse(dep_name, tag_or_0, clone_dir, r): i64 {
    if (r == 10) { return _git_cache_unjudged(dep_name, tag_or_0, clone_dir); }
    var rev = "HEAD";
    if (tag_or_0 != 0) { rev = _cat2("refs/tags/", tag_or_0); }
    _ew("error: cached checkout for dep '");
    _ew_shown(dep_name);
    _ew("' tag '");
    if (tag_or_0 != 0) { _ew_shown(tag_or_0); } else { _ew("(untagged)"); }
    _ew("' does not match its source — refusing tampered cache: ");
    _ew(_git_cache_reason(r));
    _ew(".\n  cache: ");
    _ew(clone_dir);
    # Reason 3 quotes it too (added 6.6.5): it is the ONE refusal that cannot say what git
    # objected to, so "object-store damage" was the diagnosis a user got for a commit with
    # a malformed author line as well as for a forged object.
    if (r == 1 || r == 3) {
        var el = _git_err_first_line();
        if (el != 0) { _ew("\n  git: "); _ew(el); }
    }
    if (r == 9) {
        if (_git_bad_path != 0) {
            _ew("\n  file: ");
            _ew_shown(_git_bad_path);   # 6.6.20: a path from the dep's tree, shown escaped
            _ew("  (its bytes hash to something the tag does not carry; only the");
            _ew("\n        conversion declared by .gitattributes / core.autocrlf made it compare equal)");
        }
    }
    if (r == 6) {
        if (_git_bad_gitlink != 0) { _ew("\n  populated submodule: "); _ew_shown(_git_bad_gitlink); }
        _ew("\n  fix: remove that directory's contents, then re-resolve.");
    } elif (r == 7) {
        if (_git_bad_cfg != 0) { _ew("\n  offending setting: "); _ew_shown(_git_bad_cfg); }
        _ew("\n  a clone never writes this, and it decides what the comparison sees — so the");
        _ew("\n  cache is not one to trust. The offline repair is to REMOVE THAT SETTING —");
        _ew("\n  `git -C ");
        _ew(clone_dir);
        _ew(" config --unset-all <key>`, or delete the");
        _ew("\n  .git/info/attributes named above — and re-resolve; a reset/clean does not");
        _ew("\n  touch it.");
    } elif (r == 8) {
        # 6.6.20: both URLs are manifest strings (the declared one may be a TRANSITIVE dep's, and
        # the clone path's unsafe-character check never ran — the cache was reused), so escaped.
        if (_git_bad_cfg != 0) { _ew("\n  cache origin: "); _ew_shown(_git_bad_cfg); }
        if (_git_want_url != 0) { _ew("\n  declared:     "); _ew_shown(_git_want_url); }
        _ew("\n  this cache is a checkout of a different repository; remove it and re-resolve.");
    } elif (r == 1 || r == 3) {
        # No offline recipe here, honestly: with no readable .git (1) or a damaged
        # object store (3) there is nothing local left to restore FROM. Measured:
        # `reset --hard` cannot repair a spliced object.
        _ew("\n  this one cannot be repaired locally — the object store is what is wrong.");
    } else {
        _ew("\n  offline restore: rm -f ");
        _ew(clone_dir);
        _ew("/.git/index && git --no-replace-objects -C ");
        _ew(clone_dir);
        _ew(" -c core.fsmonitor=false -c core.hooksPath=/dev/null reset -q --hard ");
        _ew(rev);
        _ew(" && git -C ");
        _ew(clone_dir);
        _ew(" clean -qffdx");
    }
    _ew("\n  or: rm -rf ");
    _ew(clone_dir);
    _ew("   (re-clones from the remote on the next resolve).\n");
    _git_err_clear();
    return 0;
}

# Reason 10: the verify could not write its temp files. Refused all the same (nothing is
# vendored from a cache nobody checked), but it names the temp dir and its errno and says
# the cache was not judged — no tamper accusation, no restore recipe, no `rm -rf`: the
# cache is most likely healthy and deleting it forces a network re-clone. CHANGELOG [6.6.9]
fn _git_cache_unjudged(dep_name, tag_or_0, clone_dir): i64 {
    _ew("error: cached checkout for dep '");
    _ew_shown(dep_name);
    _ew("' tag '");
    if (tag_or_0 != 0) { _ew_shown(tag_or_0); } else { _ew("(untagged)"); }
    _ew("' could NOT be verified — refusing to vendor it unchecked: ");
    _ew(_git_cache_reason(10));
    _ew(".\n  temp dir: ");
    _ew(_cbt_tmpdir());
    _ew(" (errno ");
    fmt_int_fd(STDERR_FD, _git_cap_errno);
    _ew(" — full, at quota, or out of inodes)\n  cache: ");
    _ew(clone_dir);
    _ew("  (not judged; do NOT delete it)\n");
    _ew("  fix: free space under that temp dir, or set TMPDIR to an absolute path elsewhere, and re-run.\n");
    _git_err_clear();
    return 0;
}

# CVE-21 (v6.2.30) — look up the previously-locked commit SHA for a dep,
# keyed on (name, git, tag) so a deliberate tag bump in cyrius.cyml does not
# false-trip (different tag → no match → re-pin). Returns a NUL-terminated SHA
# pointer, 0 if the lock has no matching commit line, or -1 if a commit line
# FOR THIS dep name is present but malformed/truncated (fewer than the 4
# tab-delimited fields) — the caller fails closed instead of silently TOFU-
# re-pinning a corrupted pin.
fn _lock_commit_lookup(name, git, tag): i64 {
    if (file_exists("cyrius.lock") == 0) { return 0; }
    var cap = 65536;
    var lbuf = alloc(cap);
    var ln = file_read_all("cyrius.lock", lbuf, cap - 1);
    if (ln <= 0) { return 0; }
    store8(lbuf + ln, 0);
    var pos = 0;
    while (pos < ln) {
        var le = pos;
        while (le < ln && load8(lbuf + le) != 10) { le = le + 1; }
        # Commit line marker: "commit" + TAB (0x09).
        if (le - pos > 7 && memeq(lbuf + pos, "commit", 6) == 1 && load8(lbuf + pos + 6) == 9) {
            var p = pos + 7;
            # `well` stays 1 only if each of the 3 internal field separators
            # (sha|name, name|git, git|tag) is actually a tab — a truncated line
            # leaves it 0 and is treated as corruption when the name matches.
            var well = 1;
            var sha_s = p;
            while (p < le && load8(lbuf + p) != 9) { p = p + 1; }
            var sha_e = p;
            if (p < le) { p = p + 1; } else { well = 0; }
            var name_s = p;
            while (p < le && load8(lbuf + p) != 9) { p = p + 1; }
            var name_e = p;
            if (p < le) { p = p + 1; } else { well = 0; }
            var git_s = p;
            while (p < le && load8(lbuf + p) != 9) { p = p + 1; }
            var git_e = p;
            if (p < le) { p = p + 1; } else { well = 0; }
            var tag_s = p;
            var tag_e = le;
            var nm_ok = 0;
            if (name_e - name_s == strlen(name) && memeq(lbuf + name_s, name, name_e - name_s) == 1) { nm_ok = 1; }
            if (nm_ok == 1 && well == 0) { return -1; }   # corrupt pin for this dep → fail closed
            var gt_ok = 0;
            # Suffix-normalised, like the origin comparison: the lock's url field and the
            # manifest's are two spellings of ONE repository as often as the cache's origin is
            # (`…/x` vs `…/x.git`). An exact compare here does not REFUSE, it silently
            # TOFU-RE-PINS — the moved-tag check this pin exists for is skipped for that
            # resolve, which is the CVE-21 hole one spelling away. CHANGELOG [6.6.5].
            if (_git_url_same_n(lbuf + git_s, git_e - git_s, git) == 1) { gt_ok = 1; }
            var tg_ok = 0;
            if (tag_e - tag_s == strlen(tag) && memeq(lbuf + tag_s, tag, tag_e - tag_s) == 1) { tg_ok = 1; }
            if (nm_ok == 1 && gt_ok == 1 && tg_ok == 1) {
                var slen = sha_e - sha_s;
                var out = alloc(slen + 1);
                memcpy(out, lbuf + sha_s, slen);
                store8(out + slen, 0);
                return out;
            }
        }
        pos = le + 1;
    }
    return 0;
}

# v6.6.4 — the stdlib pin this resolve vendors from, as recorded in cyrius.lock.
# `[package].cyrius` when the manifest pins one, else the wrapper's own version (the
# unpinned fallback resolves from `~/.cyrius/lib`, i.e. the current install) — the same
# choice `_check_lib_freshness` makes.
fn _dep_lock_pin_value(): i64 {
    var pin = _dep_read_cyml_cyrius_field();
    if (pin == 0) { return _VERSION_TOOLCHAIN; }
    return pin;
}

# v6.6.4 — read cyrius.lock ONCE at cmd_deps entry (the WHOLE file — the pin line is the
# trailer, so a 64 KB window would drop it on a large lock) and decide whether its recorded pin equals this
# run's. A lock with no `cyrius\t<pin>` line (every lock written before 6.6.4) cannot
# prove the pin unchanged, so the guard stays off for that one resolve and the lock it
# writes carries the line from then on. Inert in the cyrius source repo, where
# cmd_deps_lock never writes a lock at all.
fn _dep_lock_load(): i64 {
    _dep_lock_buf = 0;
    _dep_lock_len = 0;
    _dep_lock_pin_same = 0;
    _dep_lock_refused = 0;
    _dep_lock_has_trailer = 0;
    _dep_lock_new_leaf = 0;
    _dep_lock_active = 0;
    if (_dep_is_cyrius_source_repo() == 1) { return 0; }
    _dep_lock_active = 1;
    if (file_exists("cyrius.lock") == 0) { return 0; }
    var cap = _file_size("cyrius.lock") + 1;   # whole file: the pin trailer is the LAST line
    if (cap <= 1) { return 0; }
    var lbuf = alloc(cap);
    var ln = file_read_all("cyrius.lock", lbuf, cap - 1);
    if (ln <= 0) { return 0; }
    store8(lbuf + ln, 0);
    _dep_lock_buf = lbuf;
    _dep_lock_len = ln;
    var want = _dep_lock_pin_value();
    var pos = 0;
    while (pos < ln) {
        var le = pos;
        while (le < ln && load8(lbuf + le) != 10) { le = le + 1; }
        var lw = le;   # v6.6.4: tolerate a CRLF checkout — a `\r` must not turn the guard OFF
        if (lw > pos && load8(lbuf + lw - 1) == 13) { lw = lw - 1; }
        if (lw - pos > 7 && memeq(lbuf + pos, "cyrius", 6) == 1 && load8(lbuf + pos + 6) == 9) {
            var vs = pos + 7;
            if (lw - vs == strlen(want) && memeq(lbuf + vs, want, lw - vs) == 1) { _dep_lock_pin_same = 1; }
            _dep_lock_has_trailer = 1;
            return 0;
        }
        pos = le + 1;
    }
    return 0;
}

# v6.6.4 — the sha256 cyrius.lock (as loaded above) records for `path`, or 0 if the lock
# has no `<64hex>  <path>` line for it. Exact path match; returns a pointer INTO the
# loaded buffer (64 bytes, not NUL-terminated).
fn _lock_file_hash_lookup(path): i64 {
    if (_dep_lock_buf == 0) { return 0; }
    return _lock_buf_hash_lookup(_dep_lock_buf, _dep_lock_len, path);
}

# The same lookup over any lock text (`deps --verify` reads its own copy). CHANGELOG [6.6.9]
fn _lock_buf_hash_lookup(lbuf, ln, path): i64 {
    var plen = strlen(path);
    var pos = 0;
    while (pos < ln) {
        var le = pos;
        while (le < ln && load8(lbuf + le) != 10) { le = le + 1; }
        var lw = le;
        if (lw > pos && load8(lbuf + lw - 1) == 13) { lw = lw - 1; }   # CRLF-tolerant (v6.6.4)
        if (lw - pos == 66 + plen && load8(lbuf + pos + 64) == 32 && load8(lbuf + pos + 65) == 32) {
            if (memeq(lbuf + pos + 66, path, plen) == 1) { return lbuf + pos; }
        }
        pos = le + 1;
    }
    return 0;
}

# ⭐ v6.6.4 — REFUSE to vendor a stdlib leaf whose SNAPSHOT bytes moved under an UNCHANGED pin.
#
# THE DEFECT (filed by hisab 2026-09-13, its 3.0.1 bump). A `cyrius build` with the manifest
# pin unchanged and nothing edited printed the same two lines a no-op prints, rewrote the
# tracked lib/ganita.cyr (1.2.4 -> 1.2.5) and moved its cyrius.lock hash. Only `git status`
# noticed. The resolver copied Phase 1 from `versions/<pin>/lib` unconditionally and
# cmd_deps_lock then re-hashed whatever was on disk with O_TRUNC — the lock was UPDATED TO
# AGREE with the mutation, so `deps --verify` passed on it. The one situation a lock is for
# was the one it could not see. The git-dep half has had this check since CVE-21 (v6.2.30):
# a tagged dep's resolved HEAD is compared against the lock's `commit\t` line and a mismatch
# refuses. This is the stdlib half of the same rule, keyed on the pin instead of the tag.
#
# Fires only when ALL hold: the lock (as it stood at entry) records this pin; it carries a
# hash for `dst`; the snapshot file's hash differs from it; `--relock` was not given. A pin
# bump or a new entry re-locks silently, as a dependency-spec change should. Compared
# against the SNAPSHOT, not the consumer's lib/ — the consumer's copy may be absent (fresh
# CI checkout) and the question is whether a clean install of the pin reproduces the lock.
# Counts into `_dep_lock_refused` (folded into cmd_deps' `errors`, so no lock is written and
# `cyrius build` aborts); the caller keeps walking so every moved leaf is named in one run.
fn _dep_lock_guard_stdlib_leaf(src, dst): i64 {
    if (_dep_relock == 1) { return 0; }
    if (_dep_lock_pin_same == 0) { return 0; }
    var locked = _lock_file_hash_lookup(dst);
    if (locked == 0) { return 0; }
    var snap = _sha256sum_file(src);
    if (snap == 0) {
        # the hasher is missing: fail CLOSED, exactly as `--verify` does (`cannot hash`). A
        # guard that goes silent when its tool is absent shares its defect with the thing it
        # checks (bite-5 review: no sha256sum on PATH → the moved leaf was vendored and the
        # lock rewritten with ZERO hash lines, exit 0).
        # 6.6.9: the reason is the hasher's own (_sha_fail_why), not a guess — a full temp
        # dir used to read as "sha256sum missing?". CHANGELOG [6.6.9]
        sys_write(STDERR_FD, "error: ", 7);
        sys_write(STDERR_FD, dst, strlen(dst));
        _ew(": cannot hash the pinned snapshot (");
        _sha_fail_why();
        _ew(") — refusing to vendor or re-lock this leaf\n");
        _dep_lock_refused = _dep_lock_refused + 1;
        return 3;
    }
    if (memeq(snap, locked, 64) == 1) { return 0; }
    var pin = _dep_lock_pin_value();
    sys_write(STDERR_FD, "error: ", 7);
    sys_write(STDERR_FD, dst, strlen(dst));
    # worded as what is OBSERVED — the lock and the snapshot disagree — not as a cause: the
    # same shape appears when the LOCK moved (`cyrius update` + `--lock`) and the snapshot
    # did not; the `source:` line lets the reader tell which side moved
    var m1 = ": cyrius.lock and the pinned stdlib snapshot DISAGREE under an unchanged pin ";
    # 6.6.17: `lib sync` cannot tell an unchanged pin from one `deps` just re-stamped; its own
    # summary (_libsync_guard) says which advice fits which case.
    if (streq(_dep_lock_guard_verb, "deps") == 0) { m1 = ": cyrius.lock and the pinned stdlib snapshot DISAGREE under the pin the lock records, "; }
    sys_write(STDERR_FD, m1, strlen(m1));
    _ew_shown(pin);   # 6.6.20: the lock's recorded pin, shown escaped
    var m2 = "\n  cyrius.lock records  ";
    sys_write(STDERR_FD, m2, strlen(m2));
    sys_write(STDERR_FD, locked, 64);
    var m3 = "\n  snapshot hashes      ";
    sys_write(STDERR_FD, m3, strlen(m3));
    sys_write(STDERR_FD, snap, 64);
    var m4 = "\n  source: ";
    sys_write(STDERR_FD, m4, strlen(m4));
    sys_write(STDERR_FD, src, strlen(src));
    if (streq(_dep_lock_guard_verb, "deps") == 0) {
        _ew("\n  refusing to vendor or re-lock this leaf.\n");
        _dep_lock_refused = _dep_lock_refused + 1;
        return 3;
    }
    var m5 = "\n  refusing to vendor or re-lock this leaf. Either change the pin ([package].cyrius; an unpinned manifest follows the installed toolchain), or run";
    sys_write(STDERR_FD, m5, strlen(m5));
    var m6 = " `cyrius deps --relock` to accept the new content explicitly.\n";
    sys_write(STDERR_FD, m6, strlen(m6));
    _dep_lock_refused = _dep_lock_refused + 1;
    return 3;
}

# v6.0.2 — is this invocation running inside the cyrius source repo
# itself? Signal: `[package] name = "cyrius"` in cwd's cyrius.cyml.
# Used to skip lock generation here — cyrius authors its own `lib/`
# stdlib (folded sandhi-pattern deps + in-tree modules), so a lock of
# that lib/ is self-referential AND churns the tracked `cyrius.lock`
# on every `check.sh` `cyrius deps` run. cyrius's real external deps
# (mabda) are pinned by tag in `cyrius.cyml`, not by lib-file hash.
#
# Why name-based, not the `src/main.cyr` priority-(a) signal: downstream
# repos (gnoboot, kybernet) ALSO build from `src/main.cyr` + have a
# `./lib` of resolved deps — that conflation was the v6.0.1 mkdir bug.
# `[package] name` is unique to the cyrius project manifest.
fn _dep_is_cyrius_source_repo(): i64 {
    # 6.6.17: `[package] name` through the one reader — an exact match, so `cyrius-x` is not it.
    var nm = _mf_str("package", "name");
    if (nm == 0) { return 0; }
    return streq(nm, "cyrius");
}

# ⛔ v6.6.6: a `.cyr` under lib/ that cannot be HASHED FAILS the lock — it is not dropped from
# it. `if (hash != 0)` skipped the write and skipped the count, so `chmod 000 lib/m2.cyr` then
# `cyrius deps --lock` printed "cyrius.lock: 2 deps locked" and exited 0 over a 3-file lib/,
# with m2.cyr simply absent from cyrius.lock — and `deps --verify` then passes, because a file
# with no line in the lock is a file with nothing to check. The lock is an INTEGRITY record:
# "this file could not be read" is the one thing it must never record as "this file is fine".
# The count is carried in globals because _deps_lock_dir recurses, and the abort is in
# cmd_deps_lock so the old cyrius.lock is left exactly as it was. CHANGELOG [6.6.6]
var _dep_lock_unhashable = 0;         # how many .cyr files _sha256sum_file could not hash
var _dep_lock_unhashable_first = 0;   # the first such path, for the error
var _dep_lock_unhashable_why = 0;     # its _sha_fail/_sha_errno/_sha_rc, restored for the error (6.6.9)

# Report the unhashable files and why the lock was not written.
fn _dep_lock_unhashable_err(): i64 {
    if (_dep_lock_soft == 1) { _ew("warning: cyrius.lock NOT written — "); }
    else { _ew("error: "); }
    sys_write(STDERR_FD, "cannot hash ", 12);
    sys_write(STDERR_FD, _dep_lock_unhashable_first, strlen(_dep_lock_unhashable_first));
    if (_dep_lock_unhashable > 1) {
        sys_write(STDERR_FD, " (and ", 6);
        fmt_int_fd(STDERR_FD, _dep_lock_unhashable - 1);
        sys_write(STDERR_FD, " more)", 6);
    }
    # 6.6.9: say WHY (the first failure's reason) — a full temp dir is not an unreadable file.
    if (_dep_lock_unhashable_why != 0) {
        _sha_fail = load64(_dep_lock_unhashable_why);
        _sha_errno = load64(_dep_lock_unhashable_why + 8);
        _sha_rc = load64(_dep_lock_unhashable_why + 16);
        _ew(": ");
        _sha_fail_why();
    }
    if (_dep_lock_soft == 1) {
        _ew(".\n  The lock is left as it was; `cyrius deps --verify` reports the files it does not cover.\n");
        _ew("  Run `cyrius deps --relock` once the hasher works.\n");
        return 2;
    }
    sys_write(STDERR_FD, " — cyrius.lock would not cover it; left as it was\n", 52);
    return 1;
}

# 1 iff the NUL-terminated `path` is in the vec of C strings `v`.
fn _dep_path_in(v, path): i64 {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), path) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# v6.0.2 — recursively hash every `.cyr` under `dir`, writing
# `<sha256hex>  <path>\n` per file to the `_aw_open` handle `lock_h`. Returns the count.
# Recurses into subdirs (e.g. `lib/unicode/`) so nested stdlib modules
# resolved by `cyrius deps` (v5.8.49 subdir-nested paths) are locked
# too — a flat scan silently omitted them. Replaces the pre-v6.0.2
# symlink-only filter, which was stale since v5.11.8 switched dep
# resolution from symlink to file-copy (`_dep_copy_file`): every
# resolved dep became a real file, `readlink` returned -EINVAL on all
# of them, and the lock came out empty ecosystem-wide.
fn _deps_lock_dir(dir, lock_h): i64 {
    var count = 0;
    # 6.6.9: the file list comes from `_deps_lock_files`, the ONE walker `deps --verify` also
    # uses to find lib/ files the lock does not cover — so the writer and the checker cannot
    # disagree about what "every .cyr under lib/" means. CHANGELOG [6.6.9]
    var files = _deps_lock_files(dir);
    var li = 0;
    while (li < vec_len(files)) {
        var path = vec_get(files, li);
        li = li + 1;
        # 6.6.17: `lib sync` re-locks only what it wrote; any other file keeps its row as
        # loaded (none, if it had none). CHANGELOG [6.6.17]
        if (_dep_lock_only != 0 && _dep_path_in(_dep_lock_only, path) == 0) {
            var kept = _lock_file_hash_lookup(path);
            if (kept != 0) {
                _aw_write(lock_h, kept, 64);
                _aw_write(lock_h, "  ", 2);
                _aw_write(lock_h, path, strlen(path));
                _aw_write(lock_h, "\n", 1);
                count = count + 1;
            }
            continue;
        }
        var hash = _sha256sum_file(path);
        if (hash == 0) {
            # v6.6.6: RECORDED, not skipped — cmd_deps_lock aborts on it. CHANGELOG [6.6.6]
            _dep_lock_unhashable = _dep_lock_unhashable + 1;
            if (_dep_lock_unhashable_first == 0) {
                _dep_lock_unhashable_first = path;
                _dep_lock_unhashable_why = alloc(24);
                store64(_dep_lock_unhashable_why, _sha_fail);
                store64(_dep_lock_unhashable_why + 8, _sha_errno);
                store64(_dep_lock_unhashable_why + 16, _sha_rc);
            }
            continue;
        }
        _aw_write(lock_h, hash, 64);
        _aw_write(lock_h, "  ", 2);
        _aw_write(lock_h, path, strlen(path));
        _aw_write(lock_h, "\n", 1);
        count = count + 1;
    }
    return count;
}

# Every `.cyr` under `dir`, recursively, as "dir/…/name.cyr" paths in a vec — the set
# cyrius.lock must cover. Recurses into subdirs (e.g. `lib/unicode/`) so nested stdlib
# modules resolved by `cyrius deps` (v5.8.49 subdir-nested paths) are locked too — a flat
# scan silently omitted them. Dotfiles are skipped.
#
# v6.6.3 — SORTED. `dir_list` returns readdir order, which is stable on one machine and
# DIFFERENT on another, so the lock came out as the same hashes in a different SEQUENCE and
# every consumer CI that gates the lock byte-for-byte (`git diff --exit-code -- cyrius.lock`)
# failed for any lock committed elsewhere (agnostic 2026-09-12: "98 insertions(+), 98
# deletions(-)" over identical hashes). See issues/archived/2026-09-12-cyrius-lock-unstable-order.md.
# The commit-pin lines need no sort: they are appended in manifest declaration order.
#
# ⛔ 6.6.10 — an unlistable directory under lib/ is named and COUNTED in _deps_lock_unlisted:
# it read as empty, so `cyrius deps --lock` wrote a lock that silently did not cover its files
# and `deps --verify` (same walker) reported every covered file verified — an integrity check
# failing OPEN on the files it could not see. Both callers fail on the count.
var _deps_lock_unlisted = 0;

fn _deps_lock_files(dir): i64 {
    var out = vec_new();
    _deps_lock_unlisted = 0;
    # An ABSENT root is an empty lock, as it always was (a project with no deps has no lib/);
    # only an existing directory the walk cannot list counts. is_dir asks stat, so a mode-000
    # lib/ is still 1 and still fails. CHANGELOG [6.6.10]
    if (is_dir(str_from(dir)) == 0) { return out; }
    _deps_lock_files_into(dir, out);
    return out;
}

fn _deps_lock_files_into(dir, out): i64 {
    var entries = _cbt_list_dir(dir, "cyrius.lock cannot cover its files");
    if (entries == 0) { _deps_lock_unlisted = _deps_lock_unlisted + 1; return 0; }
    vec_sort_by(entries, &_dep_name_cmp);
    var li = 0;
    while (li < vec_len(entries)) {
        var name = str_data(vec_get(entries, li));
        var nlen = str_len(vec_get(entries, li));
        li = li + 1;
        if (nlen == 0) { continue; }
        if (load8(name) == 46) { continue; }   # skip ".", "..", dotfiles
        var path = make_path(dir, name);
        if (is_dir(str_from(path)) == 1) {
            _deps_lock_files_into(path, out);
            continue;
        }
        if (nlen < 5) { continue; }
        if (memeq(name + nlen - 4, ".cyr", 4) == 0) { continue; }
        vec_push(out, path);
    }
    return 0;
}

fn cmd_deps_lock(): i64 {
    # v6.0.2: cyrius's own repo authors its lib/ — skip (self-referential
    # + would churn the tracked cyrius.lock on every check.sh). See
    # _dep_is_cyrius_source_repo above + CHANGELOG [6.0.2].
    if (_dep_is_cyrius_source_repo() == 1) {
        println("cyrius.lock: skipped (source repo — lib/ is authored stdlib, not resolved deps)");
        return 0;
    }
    # v6.6.4: read the inherited lock BEFORE the lock is rewritten below — the bare `--lock` verb has no
    # resolve behind it and needs the old lock's `commit\t` pins (carried forward below).
    if (_dep_lock_buf == 0) { _dep_lock_load(); }
    # Generate cyrius.lock by hashing every resolved .cyr under lib/
    # (recursively). See _deps_lock_dir for the v5.11.8-era root cause.
    # Crash-safe: the lock is built in a sibling temp and renamed over cyrius.lock only once
    # every line landed — a short write used to leave a truncated lock and exit 0 (CHANGELOG [6.6.6]).
    var lock_h = _aw_open_replace("cyrius.lock");
    if (lock_h == 0) { _err("cannot create cyrius.lock"); return 1; }
    # CVE-21 (v6.2.30): write the resolved git-dep commit pins FIRST (one
    # "commit\t<sha>\t<name>\t<git>\t<tag>" line each), BEFORE the per-file
    # content hashes, so they always fall inside _lock_commit_lookup's 64 KB
    # read window even when a large project's hash section grows past it.
    # cmd_deps_verify skips these lines; resolution checks them.
    var _cc = 0;
    if (_dep_commit_lines != 0) {
        var _ci = 0;
        while (_ci < vec_len(_dep_commit_lines)) {
            var _line = vec_get(_dep_commit_lines, _ci);
            _aw_write(lock_h, _line, strlen(_line));
            _aw_write(lock_h, "\n", 1);
            _ci = _ci + 1;
            _cc = _cc + 1;
        }
    } else {
        # ⛔ v6.6.4: the bare `cyrius deps --lock` verb reaches here with NO resolve behind it,
        # so `_dep_commit_lines` is 0 and every CVE-21 `commit\t` pin the old lock carried was
        # silently DROPPED (measured: "1 commit-pinned" → "0"; the next `cyrius deps` then
        # TOFU-re-pinned a repointed tag it would otherwise have refused). Carry the inherited
        # lock's commit lines forward — a re-hash of lib/ must never lose the pins.
        if (_dep_lock_buf != 0) {
            var _lp = 0;
            while (_lp < _dep_lock_len) {
                var _le = _lp;
                while (_le < _dep_lock_len && load8(_dep_lock_buf + _le) != 10) { _le = _le + 1; }
                if (_le - _lp > 7 && memeq(_dep_lock_buf + _lp, "commit", 6) == 1 && load8(_dep_lock_buf + _lp + 6) == 9) {
                    var _lw = _le;
                    if (_lw > _lp && load8(_dep_lock_buf + _lw - 1) == 13) { _lw = _lw - 1; }
                    _aw_write(lock_h, _dep_lock_buf + _lp, _lw - _lp);
                    _aw_write(lock_h, "\n", 1);
                    _cc = _cc + 1;
                }
                _lp = _le + 1;
            }
        }
    }
    var count = _deps_lock_dir("lib", lock_h);
    if (_deps_lock_unlisted != 0) {
        _aw_abort(lock_h);
        _err("cyrius.lock: a directory under lib/ could not be listed (named above) — left as it was");
        return 1;
    }
    if (_dep_lock_unhashable != 0) {
        _aw_abort(lock_h);
        return _dep_lock_unhashable_err();
    }
    # v6.6.4: record the stdlib pin LAST — `cyrius\t<pin>` — so the next resolve can tell
    # "the pin changed" (re-lock silently) from "the snapshot changed under the same pin"
    # (refuse; see _dep_lock_guard_stdlib_leaf). Tab-delimited like the commit lines.
    # LAST, not first, deliberately: a pre-6.6.4 `deps --verify` (reachable via a pin
    # downgrade) parses every line as `<64hex>  <path>` and stops at `pos + 66 >= n`, so a
    # 13-byte trailer is skipped by an old reader; at the head it would be misread as a
    # hash line and fail one entry. _dep_lock_load reads the WHOLE file, so the trailer is
    # never outside its window. cmd_deps_verify ALSO skips it by name — that only matters
    # for a hand-merged lock where the trailer is not last (the last-line placement is what
    # protects old readers; the explicit skip protects this reader).
    var _pv = _dep_lock_pin_value();
    _aw_write(lock_h, "cyrius\t", 7);
    _aw_write(lock_h, _pv, strlen(_pv));
    _aw_write(lock_h, "\n", 1);
    if (_aw_commit(lock_h) != 0) { _err("write failed: cyrius.lock (left as it was)"); return 1; }
    sys_write(STDOUT_FD, "cyrius.lock: ", 13);
    fmt_int(count);
    sys_write(STDOUT_FD, " deps locked", 12);
    if (_cc > 0) {
        sys_write(STDOUT_FD, ", ", 2);
        fmt_int(_cc);
        sys_write(STDOUT_FD, " commit-pinned", 14);
    }
    println("");
    return 0;
}

fn cmd_deps_verify(): i64 {
    # CVE-21 (v6.2.30): 64 KB read window (was 8 KB). The old 8 KB cap silently
    # stopped verifying file-hash lines past the cutoff for any lock >8 KB
    # (real downstream locks already exceed it) — and the commit-pin lines now
    # prepended by cmd_deps_lock ate into that budget. Match _lock_commit_lookup.
    # v6.6.4: the WHOLE file — a lock past 64 KB silently stopped verifying at the cut, and
    # the `cyrius\t<pin>` trailer is the last line.
    # 6.6.9: the cyrius source repo writes no lock (cmd_deps_lock skips it; its tracked
    # cyrius.lock is empty), so there is nothing here for the lib/ walk below to hold its
    # authored stdlib against — say so instead of failing every file.
    if (_dep_is_cyrius_source_repo() == 1) {
        _err("cyrius.lock is not kept in the cyrius source repo (lib/ is authored stdlib, not resolved deps) — nothing to verify");
        return 1;
    }
    var _vcap = _file_size("cyrius.lock") + 1;
    if (_vcap < 65536) { _vcap = 65536; }
    var buf = alloc(_vcap);
    var n = file_read_all("cyrius.lock", buf, _vcap - 1);
    if (n < 0 || file_exists("cyrius.lock") == 0) {
        _err("no cyrius.lock found — run cyrius deps first");
        return 1;
    }
    # 6.6.9: an EMPTY lock is present-but-empty (cyrius-bb tracks a 0-byte one over 53 lib/
    # files), not "missing" — it verifies nothing, and the lib/ walk below names every file
    # it leaves uncovered. CHANGELOG [6.6.9]
    if (n == 0) { println("cyrius.lock is empty — it records no file"); }
    store8(buf + n, 0);

    var pass = 0;
    var fail = 0;
    var pos = 0;
    while (pos < n) {
        # CVE-21 (v6.2.30): skip commit-pin lines ("commit\t<sha>\t...") — those
        # are verified during resolution, not by this file-content-hash check.
        if (pos + 7 <= n && memeq(buf + pos, "commit", 6) == 1 && load8(buf + pos + 6) == 9) {
            while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
            pos = pos + 1;
            continue;
        }
        # v6.6.4: skip the `cyrius\t<pin>` trailer line — the pin is checked at resolve time.
        if (pos + 7 <= n && memeq(buf + pos, "cyrius", 6) == 1 && load8(buf + pos + 6) == 9) {
            while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
            pos = pos + 1;
            continue;
        }
        # Parse line: 64-char hash, 2 spaces, path, newline
        if (pos + 66 >= n) { break; }
        var expected_hash = buf + pos;
        var path_start = pos + 66;
        var path_end = path_start;
        while (path_end < n && load8(buf + path_end) != 10) { path_end = path_end + 1; }

        var plen = path_end - path_start;
        var path = alloc(plen + 1);
        memcpy(path, buf + path_start, plen);
        store8(path + plen, 0);

        var actual_hash = _sha256sum_file(path);
        if (actual_hash == 0) {
            sys_write(STDERR_FD, "  FAIL: ", 8);
            sys_write(STDERR_FD, path, plen);
            _ew(" (cannot hash: ");
            _sha_fail_why();
            _ew(")\n");
            fail = fail + 1;
        } elif (memeq(actual_hash, expected_hash, 64) == 1) {
            pass = pass + 1;
        } else {
            sys_write(STDERR_FD, "  FAIL: ", 8);
            sys_write(STDERR_FD, path, plen);
            sys_write(STDERR_FD, " (hash mismatch)\n", 17);
            fail = fail + 1;
        }

        pos = path_end + 1;
    }

    # ⛔ 6.6.9 bite 9 — AND every .cyr under lib/ must HAVE a line. The loop above checks
    # the lines the lock contains, so a file with no line had nothing to fail: patra's two
    # newly declared leaves verified "29 verified, 0 failed" over 31 files — tampered, too.
    # Walked with `_deps_lock_files`, the SAME walker cmd_deps_lock writes from, so the
    # checker cannot drift from the writer (a check that shares its subject's blind spot
    # reads green). CHANGELOG [6.6.9]
    var files = _deps_lock_files("lib");
    fail = fail + _deps_lock_unlisted;       # 6.6.10: an unlistable directory is not verified
    var fi = 0;
    while (fi < vec_len(files)) {
        var fp = vec_get(files, fi);
        fi = fi + 1;
        if (_lock_buf_hash_lookup(buf, n, fp) != 0) { continue; }
        sys_write(STDERR_FD, "  FAIL: ", 8);
        sys_write(STDERR_FD, fp, strlen(fp));
        _ew(" (not in cyrius.lock — run cyrius deps --relock to lock it)\n");
        fail = fail + 1;
    }

    fmt_int(pass);
    sys_write(STDOUT_FD, " verified, ", 11);
    fmt_int(fail);
    println(" failed");
    if (fail > 0) { return 1; }
    return 0;
}
