# ================================================================
# Dependency resolution: cyrius deps
# ================================================================
# Reads cyrius.cyml (or cyrius.toml fallback), resolves:
#   [deps] stdlib = ["string", "fmt", ...] → copy from cyrius stdlib
#   [deps.name] path = "../repo" modules = ["src/foo.cyr"] → copy from sibling
# All deps land in lib/ (created if needed).

# ⛔ v6.5.37 — a vendor destination that is a SYMLINK is refused, never followed.
# Declared here, above every use: a global declared BELOW its use is NOT visible in
# cyrius (that false claim, written down in an issue file, cost two whole fix attempts
# at 6.5.33/.34 — do not move this below _dep_copy_file).
var _dep_linkdest_reported = 0;

# ⛔ v6.5.37 (A0) — VENDOR MODE. The symlink refusal below must fire for VENDORING (cyrius
# deps / update / lib sync writing into a project's lib/) and must NOT fire for TOOLCHAIN
# INSTALLS, because `~/.cyrius/bin` is itself a symlink into `versions/<v>/bin` on a normal
# install — so an ungated guard refuses `cyrius lsp install` and every sibling that writes
# there. The first cut of this guard (earlier in v6.5.37) WAS ungated and did exactly that,
# and it failed in the worst available way: `cbt/cyrius.cyr` ignored `_dep_copy_file`'s
# return and printed "Installed: <path>" over a copy that never happened. Set to 1 at the
# top of the vendoring commands only.
var _dep_vendor_mode = 0;

# Print the refusal ONCE (the copy loop calls this ~100x per resolve) and return 1,
# the same error code the CVE-04 traversal guard uses. Full incident writeup lives at
# the call site in _dep_copy_file.
fn _dep_refuse_symlinked_dest(path): i64 {
    if (_dep_linkdest_reported == 1) { return 1; }
    _dep_linkdest_reported = 1;
    var m1 = "error: refusing to vendor into a SYMLINKED directory: ";
    sys_write(STDERR_FD, m1, strlen(m1));
    _ew_shown(path);
    var m2 = "\n  Writing through it overwrites whatever it points at. If that is the shared\n  stdlib under ~/.cyrius, it corrupts every project on this machine: a stale lib/\n  replaces the installed one, and the next `cyrius deps` in any OTHER repo reads\n  the corruption back out.\n  A project's lib/ must be a REAL directory populated by `cyrius deps`.\n  Fix:  rm ";
    sys_write(STDERR_FD, m2, strlen(m2));
    _ew_shown(path);
    var m3 = "     # the LINK only - never `rm -rf`, that follows it\n        cyrius deps\n";
    sys_write(STDERR_FD, m3, strlen(m3));
    return 1;
}

# ⛔ v6.5.37 (A0) — is ANY component of `dst` a symlink? Returns the offending path, or 0.
#
# ⚠ THE FINAL COMPONENT IS THE HALF THE FIRST CUT MISSED, and it is the shape the ecosystem
# actually has. The first guard walked directory PREFIXES only, so it caught
# `lib -> <snapshot>` (the nous shape) and sailed straight past
# `lib/alloc.cyr -> <snapshot>/alloc.cyr` — a real directory holding a symlinked FILE. That
# second shape is not exotic: CLAUDE.md calls single-file `lib/<dep>.cyr` symlinks
# "legitimate `cyrius deps` output", and three live instances sit under
# `~/.cyrius/deps/sigil/*/lib/sakshi.cyr` today. Measured against the prefix-only guard:
# `cyrius deps` exit 0, the symlink target overwritten, silent.
#
# So a gate written only around the directory shape ships GREEN over the file shape. That is
# the v6.5.36 lesson verbatim — a gate that pins the mechanism rather than the property
# passes while the mechanism is wrong — which is why the companion gate asserts BOTH.
#
# Windows too: `is_symlink`'s PE arm (GetFileAttributesW's REPARSE_POINT bit, then
# FindFirstFileW's name-surrogate tag — lib/fs.cyr) sees symlinks and junctions.
# CHANGELOG [6.6.9]
fn _dep_dest_is_linked(dst): i64 {
    var n = strlen(dst);
    var buf = alloc(n + 1);
    var i = 0;
    while (i < n) {
        if (load8(dst + i) == 47) {   # '/'
            memcpy(buf, dst, i);
            store8(buf + i, 0);
            if (is_symlink(str_from(buf)) == 1) { return buf; }
        }
        i = i + 1;
    }
    if (is_symlink(str_from(dst)) == 1) { return dst; }
    return 0;
}

# Byte size of the regular file at `path`, or -1 when it cannot be opened or read.
#
# ⛔ open + lseek(SEEK_END), NEVER stat. This was a raw `syscall(4, …)` (x86-Linux stat) with a
# per-target st_size offset (48 on Linux, 72 in Darwin's legacy struct — CHANGELOG [6.0.41]).
# Syscall 4 has no PE reroute, so on the Windows CLI every one of its call sites got -38 — among
# them `cyrius distlib`'s verify loop, which sized every file it splices with it and therefore
# compiled an EMPTY entry and reported "nothing undefined" over every sidecar. SYS_LSEEK is routed
# on every target (SetFilePointerEx on PE), and `file_open` carries the agnos bridge, so one body
# serves all of them and no stat struct offset can be wrong. Same shape as build.cyr's
# `_artifact_size`.
# ⚠ A DIRECTORY opens and seeks on Linux (ext4 answers its hash EOF, not a byte count), so a
# positive size is confirmed by reading one byte: a directory's read fails (EISDIR) and answers
# -1, which is what every caller — "size it, then read that many bytes" — needs.
# CHANGELOG [6.6.9]
fn _file_size(path): i64 {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var n = xlseek(fd, 0, 2);
    if (n > 0) {
        var probe[8];
        if (xlseek(fd, 0, 0) != 0) { n = 0 - 1; }
        elif (file_read(fd, &probe, 1) != 1) { n = 0 - 1; }
    }
    file_close(fd);
    if (n < 0) { return 0 - 1; }
    return n;
}

# Resolve a (possibly relative) path to absolute using getcwd(2).
# Needed for symlink creation: a relative symlink target is resolved
# relative to the SYMLINK's parent directory, not the caller's CWD.
# When we write `lib/{dep}.cyr -> ../sigil/dist/sigil.cyr`, that resolves
# to `{proj}/sigil/dist/sigil.cyr` (wrong) instead of `{sibling}/sigil/...`.
# Fix: make every symlink target absolute. Absolute paths are unambiguous.
# Returns src unchanged if already absolute, else allocates an absolute copy.
fn _abs_path(src): i64 {
    if (load8(src) == 47) { return src; }
    var cwd[4096];
    var cwd_len = 0;
    #ifdef CYRIUS_TARGET_MACOS
    # Darwin has NO getcwd syscall (slot 326 is unused → SIGSYS). Derive
    # the cwd from the "." fd via fcntl(F_GETPATH): open(".") then
    # fcntl(fd, F_GETPATH=50, buf) writes the absolute path, returns 0/-errno.
    # See CHANGELOG [6.0.41]; v6.6.8 spells it through the stdlib wrappers
    # instead of raw 2/72/3.
    var fd = sys_open(".", 0, 0);
    if (fd < 0) { return src; }
    var fr = sys_fcntl(fd, 50, &cwd);
    sys_close(fd);
    if (fr != 0) { return src; }
    while (load8(&cwd + cwd_len) != 0) { cwd_len = cwd_len + 1; }
    #else
    # syscall 79 = getcwd(buf, size); returns length incl. nul, or -errno.
    # (aarch64-Linux: ESYSXLAT renumbers x86 79 → aarch64 getcwd 17.)
    var n = syscall(79, &cwd, 4096);
    if (n <= 0) { return src; }
    # Strip trailing nul from length
    cwd_len = n - 1;
    #endif
    var src_len = 0;
    while (load8(src + src_len) != 0) { src_len = src_len + 1; }
    var out = alloc(cwd_len + 1 + src_len + 1);
    var oi = 0;
    var ci = 0;
    while (ci < cwd_len) {
        store8(out + oi, load8(&cwd + ci));
        oi = oi + 1;
        ci = ci + 1;
    }
    store8(out + oi, 47);  # '/'
    oi = oi + 1;
    var si = 0;
    while (si < src_len) {
        store8(out + oi, load8(src + si));
        oi = oi + 1;
        si = si + 1;
    }
    store8(out + oi, 0);
    return out;
}

# Byte-compare two files. Returns 1 if identical, 0 otherwise (including if either
# cannot be opened). Short-circuits on the first differing byte. Added v6.5.7 for
# _dep_copy_file's staleness predicate — see the note there for why this is a byte
# compare and not a hash. Uses only sys_open / syscall(0) / sys_close, all of which
# _dep_copy_file already issues unguarded, so this adds no PE cross-compile risk.
fn _files_identical(a, b): i64 {
    var fa = sys_open(a, O_RDONLY, 0);
    if (fa < 0) { return 0; }
    var fb = sys_open(b, O_RDONLY, 0);
    if (fb < 0) { sys_close(fa); return 0; }
    var ba = alloc(32768);
    var bb = alloc(32768);
    var same = 1;
    var go = 1;
    while (go == 1) {
        var na = syscall(0, fa, ba, 32768);
        var nb = syscall(0, fb, bb, 32768);
        if (na != nb) { same = 0; go = 0; }
        if (go == 1) {
            if (na <= 0) { go = 0; }
            else {
                if (memeq(ba, bb, na) == 0) { same = 0; go = 0; }
            }
        }
    }
    sys_close(fa);
    sys_close(fb);
    return same;
}

fn _dep_copy_file(src, dst): i64 {
    # Skip only if the destination is byte-identical. v6.5.7: this was SIZE-ONLY,
    # so any change that preserves file length was never vendored while `lib sync`
    # printed "copied 99 .cyr files" and exited 0. The most common size-neutral
    # change is the one that happens on EVERY patch release — a version stamp in a
    # header comment (`# Version: 1.1.2` -> `# Version: 1.1.3` is the same byte
    # count), which is exactly how a consumer's lib/vani.cyr sat a release behind
    # with every command reporting success. `cyrius deps --verify` cannot catch it
    # and structurally never could: cyrius.lock is written FROM lib/ on disk, so a
    # stale file simply gets its stale hash recorded.
    #
    # Size stays as a NEGATIVE fast path only (different size => definitely copy);
    # equal size falls through to a content compare. Deliberately a byte compare
    # rather than _sha256sum_file: that helper forks /usr/bin/env sha256sum (and
    # certutil on PE), which would cost ~99 process spawns per sync and make a core
    # correctness predicate depend on an external binary.
    var src_sz = _file_size(src);
    var dst_sz = _file_size(dst);
    if (src_sz > 0 && src_sz == dst_sz) {
        if (_files_identical(src, dst) == 1) { return 2; }
    }
    # CVE-04: reject dep writes outside lib/ (path traversal)
    var di = 0;
    while (load8(dst + di) != 0) {
        if (load8(dst + di) == 46 && load8(dst + di + 1) == 46) {
            sys_write(STDERR_FD, "  error: path traversal in dep destination: ", 44);
            _ew_shown(dst);
            sys_write(STDERR_FD, "\n", 1);
            return 1;
        }
        di += 1;
    }
    # v5.8.49: mkdir-p any intermediate directories in dst so subdir-
    # nested stdlib modules (e.g. `lib/unicode/categories.cyr`) can be
    # written. Before this fix, sys_open with O_CREAT failed with ENOENT
    # when the parent dir did not exist, silently dropping subdir-stdlib
    # files at consumer-side `cyrius deps` resolution. Loop walks dst
    # char-by-char; whenever we hit `/`, mkdir the prefix up to that
    # slash (0o755). sys_mkdir returns -EEXIST harmlessly on already-
    # present dirs — same idiom used by sys_mkdir("lib", ...) callers
    # above and below.
    # ⛔ v6.5.37 — REFUSE TO WRITE THROUGH A SYMLINKED DESTINATION DIRECTORY.
    #
    # THE INCIDENT (2026-09-01). `nous/lib` was a directory-level symlink to `~/.cyrius/lib`,
    # itself a symlink to `~/.cyrius/versions/6.5.36/lib` — the LIVE stdlib snapshot. nous pins
    # cyrius 6.3.35, so `_dep_find_stdlib_dir()` correctly resolved the SOURCE to
    # `versions/6.3.35/lib`; the resolver then wrote each leaf to `lib/<mod>.cyr`, straight
    # through the symlink and INTO the 6.5.36 snapshot. 27 files of 6.3.35-era stdlib replaced
    # the shipped ones — `lib/alloc.cyr` lost `fn _alloc_zero`, the memory-reuse
    # information-leak fix from v6.4.1 (daimon VULN-007). `~/.cyrius/lib` is the global default
    # source, so every other repo then READ the corruption: shabda ingested it 12 seconds later.
    #
    # ⚠ CLAUDE.md has forbidden the directory-level `lib` symlink since the v5.5.30–v5.5.33
    # sakshi corruption and even ships `find` commands to detect it — but the remedy was always
    # a human noticing. THE TOOL NEVER REFUSED. v5.11.8 switched dep resolution from symlink to
    # file-copy to stop the snapshot overwriting a project's `lib/`; that guarded ONE direction
    # and left the reverse — a project's `lib/` overwriting the snapshot — wide open.
    #
    # Checked per destination-directory PREFIX in the same walk the mkdir-p below already does,
    # so `lib` and `lib/unicode` are both covered, and checked BEFORE any mkdir so a refusal
    # creates nothing. Sibling of the CVE-04 traversal guard above: same choke point, same
    # `return 1`, so every write path (stdlib leaves, `requires`, `.deps` sidecar, modules,
    # submodules) inherits it without a per-caller edit.
    #
    # It fires on every target, PE included: `is_symlink` has a Windows arm since 6.6.9
    # (GetFileAttributesW + FindFirstFileW's reparse tag, lib/fs.cyr). CHANGELOG [6.6.9]
    if (_dep_vendor_mode == 1) {
        var linked = _dep_dest_is_linked(dst);
        if (linked != 0) { return _dep_refuse_symlinked_dest(linked); }
    }
    var dst_len = strlen(dst);
    var prefix_buf = alloc(dst_len + 1);
    var pi = 0;
    while (pi < dst_len) {
        if (load8(dst + pi) == 47) {   # '/'
            memcpy(prefix_buf, dst, pi);
            store8(prefix_buf + pi, 0);
            sys_mkdir(prefix_buf, 0x1ED);
        }
        pi = pi + 1;
    }
    var sfd = sys_open(src, O_RDONLY, 0);
    if (sfd < 0) {
        sys_write(STDERR_FD, "  error: cannot read ", 21);
        _ew_shown(src);
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    # Crash-safe: the vendored copy is replaced only once every byte landed (CHANGELOG [6.6.6]).
    var dh = _aw_open(dst);
    if (dh == 0) {
        sys_close(sfd);
        sys_write(STDERR_FD, "  error: cannot write ", 22);
        _ew_shown(dst);
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    # Stream copy in 32KB chunks — handles files of any size
    var buf = alloc(32768);
    var total = 0;
    var go = 1;
    var rerr = 0;
    while (go == 1) {
        var n = syscall(0, sfd, buf, 32768);
        if (n < 0) { rerr = 1; }
        if (n <= 0) { go = 0; }
        else { _aw_write(dh, buf, n); total = total + n; }
    }
    sys_close(sfd);
    if (total == 0 || rerr != 0) { _aw_abort(dh); return 1; }
    if (_aw_commit(dh) != 0) {
        sys_write(STDERR_FD, "  error: write failed: ", 23);
        _ew_shown(dst);
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    return 0;
}

# Read `[package].cyrius = "X.Y.Z"` from cwd's cyrius.cyml.
# Returns a NUL-terminated cstr of the version, or 0 if the field
# is absent (the field is optional — only set in downstream repos
# that pin a specific toolchain version).
#
# See CHANGELOG [5.11.17]; 6.6.17 reads it through the one manifest reader.
#
# ⛔ CVE-TBD (6.6.20) — THE PIN IS A PATH COMPONENT, AND AT THE REDIRECT IT IS EXECUTED.
# Every caller joins it into `<home>/versions/<pin>/...`, and `_try_redirect_to_pinned`
# execve's `<home>/versions/<pin>/bin/cyrius` before any verb runs. The value was never
# checked, so a cloned repo's `cyrius = "../../(...)/proc/self/cwd/payload"` ran the repo's
# own `payload/bin/cyrius` on `cyrius version` / fmt / lint / build (a backslash spelling did
# the same on Windows). The shape is checked HERE, at the one reader, so the redirect, the
# stdlib resolver, lib sync, the freshness check, both distlib resolvers, the cyrius.lock
# trailer and the `manifest-pin:` line all get it — including under CYRIUS_RESOLVED=1, which
# skips the redirect. A malformed pin is REFUSED (exit 1), never read as "no pin": that would
# silently swap in this wrapper's own toolchain. Returns 0 only when the key is absent.
fn _dep_read_cyml_cyrius_field(): i64 {
    var pin = _mf_str("package", "cyrius");   # 6.6.17: the one reader (cbt/manifest.cyr)
    if (pin == 0) {
        if (_toml_bad == 0) { return 0; }   # absent: the field is optional
        _ew("error: cyrius.cyml [package] cyrius must be a quoted version string (e.g. cyrius = \"");
        _ew(_VERSION_TOOLCHAIN);
        _ew("\") — refusing to run with an unreadable toolchain pin\n");
        _cbt_exit(1);
    }
    if (_dep_pin_shape_ok(pin) == 0) {
        _ew("error: cyrius.cyml [package] cyrius = '");
        _ew_shown(pin);
        _ew("' is not a version\n");
        _ew("  a pin names a directory under <home>/versions: a leading digit, then only [0-9A-Za-z._-], no '..' (e.g. ");
        _ew(_VERSION_TOOLCHAIN);
        _ew(")\n  refusing to resolve a toolchain from it\n");
        _cbt_exit(1);
    }
    return pin;
}

# 1 when `pin` has a version's shape — a leading digit, then only [0-9A-Za-z._-], no `..` — so
# it is exactly one path component that cannot leave `<home>/versions` (`/`, `\` and `:` are
# outside the set). scripts/version-bump.sh's charset plus `_` — which
# `_released_slot_guard_current` (cbt/cyrius.cyr) already allows in a store version name — and a
# `..` ban (version-bump.sh has none).
fn _dep_pin_shape_ok(pin): i64 {
    var c = load8(pin);
    if (c < 48 || c > 57) { return 0; }   # leading digit (also refuses the empty string)
    var i = 0;
    while (c != 0) {
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c >= 65 && c <= 90) { ok = 1; }
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c == 46 || c == 95 || c == 45) { ok = 1; }   # . _ -
        if (ok == 0) { return 0; }
        if (c == 46 && load8(pin + i + 1) == 46) { return 0; }   # '..'
        i = i + 1;
        c = load8(pin + i);
    }
    return 1;
}

# v6.5.21 — read `[package].version` and resolve it to a literal, for the
# `#@pkgver` marker that surfaces `CYRIUS_PKG_VERSION` to source.
#
# ⚠ NOTHING in the toolchain resolved `[package].version` before this. The only
# `${file:VERSION}` expander in the tree (`bayan_cyml_expand_value`,
# lib/bayan.cyr) has ZERO callers, bayan is not in cbt's include set, and
# `cyrius package` printed "unknown" for a manifest that plainly declares a
# version. The roadmap's "which already resolves `${file:VERSION}`" described no
# live code path — the expander had to be written, not merely plumbed.
#
# Handles the one interpolation the manifests actually use: `${file:PATH}` reads
# PATH (relative to cwd) and trims surrounding whitespace. Returns 0 when the
# field is absent or the referenced file is unreadable, so the caller emits NO
# marker and the constant is simply ABSENT — a use site then fails honestly with
# `undefined variable`. A silently WRONG version banner is the exact failure the
# sit consumer filed; absent beats wrong.
fn _dep_read_cyml_package_version(): i64 {
    var raw = _mf_str("package", "version");   # 6.6.17: the one reader (cbt/manifest.cyr)
    if (raw == 0) { return 0; }
    return _dep_expand_file_interp(raw, strlen(raw));
}

# `${file:PATH}` → the trimmed contents of PATH. Anything else passes through
# unchanged, so a plain `version = "1.2.3"` works with no special case.
fn _dep_expand_file_interp(raw, rlen): i64 {
    if (rlen < 8) { return raw; }
    if (memeq(raw, "${file:", 7) == 0) { return raw; }
    if (load8(raw + rlen - 1) != 125) { return raw; }      # '}'
    var plen = rlen - 8;
    if (plen <= 0) { return 0; }
    var path = alloc(plen + 1);
    var i = 0;
    while (i < plen) { store8(path + i, load8(raw + 7 + i)); i = i + 1; }
    store8(path + plen, 0);
    if (file_exists(path) == 0) { return 0; }
    var fb = alloc(512);
    var fn_read = file_read_all(path, fb, 511);
    if (fn_read <= 0) { return 0; }
    store8(fb + fn_read, 0);
    var s = 0;
    while (s < fn_read && (load8(fb + s) == 32 || load8(fb + s) == 10 || load8(fb + s) == 13 || load8(fb + s) == 9)) { s = s + 1; }
    var e = fn_read;
    while (e > s && (load8(fb + e - 1) == 32 || load8(fb + e - 1) == 10 || load8(fb + e - 1) == 13 || load8(fb + e - 1) == 9)) { e = e - 1; }
    var olen = e - s;
    if (olen <= 0) { return 0; }
    var out = alloc(olen + 1);
    var k = 0;
    while (k < olen) { store8(out + k, load8(fb + s + k)); k = k + 1; }
    store8(out + olen, 0);
    return out;
}

# v5.11.17 — stdlib_dir resolution order (Part 1 of per-repo
# isolation arc; Parts 2-3 at v5.11.23/24). Closes the snapshot-
# ping-pong wipe wedge that landed multiple times in the v5.11.x
# cycle (notably v5.11.3, v5.11.13). See CHANGELOG [5.11.17].
#
# Resolution priority:
#   (a) `./lib` when running inside the cyrius source repo
#       (signal: src/main.cyr present). Closes the cyrius-repo
#       ping-pong — the repo reads its own in-tree stdlib instead
#       of the mutable `~/.cyrius/lib` global symlink, so a
#       sibling agent's `cyriusly use <other>` can't wipe edits.
#   (b) `~/.cyrius/versions/<cyml-cyrius-field>/lib/` when the
#       consumer's cyrius.cyml pins `[package].cyrius = "X.Y.Z"`
#       AND that version is installed. Isolates downstream repos
#       from the global pointer.
#   (c) `~/.cyrius/lib` legacy fallback for consumers without a
#       cyrius pin (existing behavior, unchanged).
# Hard-error (not silent fallback) when cyml pins a version that
# is NOT installed.
# Cross-platform "does this dir hold the stdlib" check. `is_dir`
# (lib/fs.cyr) probes via getdents64 (Linux syscall 217), which Darwin
# does NOT provide (it uses getdirentries with a different ABI; .34's
# ESYSXLAT doesn't cover 217) — so on arm64 macOS `is_dir` false-negatives
# a directory that demonstrably exists. That made the pinned-version
# install-probe below reject a valid snapshot, so every consumer manifest
# with a `cyrius =` pin AND `[deps] stdlib` failed to build on Darwin
# (ai-hwaccel 2.3.6 blocked; issue 2026-06-02-macos-arm64-deps-stdlib-pin-check).
# `file_exists` is open()-based and works on Darwin; checking for a
# canonical always-present stdlib file confirms the dir exists AND holds
# the stdlib. See CHANGELOG [6.0.40].
fn _dep_dir_has_stdlib(dir_cstr): i64 {
    return file_exists(make_path(dir_cstr, "syscalls.cyr"));
}

fn _dep_find_stdlib_dir(): i64 {
    # (a) cyrius source-repo dev mode: `./lib` if we're in the cyrius repo ITSELF.
    #
    # ⛔ v6.5.25 — THIS WAS THE ROOT CAUSE OF THE bote/agnosai/majra FILING, and it was a
    # functional resolution failure, not the diagnostic problem it was filed as. The test
    # used to be `file_exists("src/main.cyr")`, which is TRUE for essentially every cyrius
    # project — `src/main.cyr` is the default entry the init templates generate. So for
    # bote, agnosai and majra this branch fired, found the consumer's OWN partially-
    # populated `./lib` (the `[deps].stdlib` phase has already copied into it by this
    # point), and returned it AS "the stdlib". Branch (b), the version-pinned snapshot
    # this was all supposed to read from, was never reached.
    #
    # Everything downstream followed from that: a sidecar leaf not yet in `./lib` looked
    # ABSENT, so `cyrius deps` reported `dep libro requires 'bench' but it is not in the
    # cyrius stdlib` about a module that ships in the stdlib, and pointed maintainers at
    # deleting a correct `[deps].stdlib` declaration. Reproduced verbatim on the real bote
    # tree: 3 errors on `bench`/`test` (libro) and `patra` (majra). With the identity test
    # corrected, those leaves are copied out of the pinned snapshot and the resolve
    # SUCCEEDS — the message was a symptom, the wrong directory was the bug.
    #
    # ⚠ This is the SAME `file_exists("src/main.cyr")` ≠ cyrius-repo conflation fixed in
    # `cyrius audit` at v6.4.63 (and originally at v6.0.1). `_dep_is_cyrius_source_repo()`
    # exists precisely for this and matches `[package].name` exactly (so `cyrius-x` does
    # not qualify) — it was written for the audit fix and never applied here. When a
    # "am I the cyrius repo?" test is needed, use that helper; never a filename probe.
    if (_dep_is_cyrius_source_repo() == 1) {
        if (_dep_dir_has_stdlib("./lib") == 1) { return "./lib"; }
    }

    # (b) cyrius.cyml-pinned version → per-repo isolation
    var pin = _dep_read_cyml_cyrius_field();
    if (pin != 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, _home);
        str_builder_add_cstr(sb, "/versions/");
        str_builder_add_cstr(sb, pin);
        str_builder_add_cstr(sb, "/lib");
        var pinned_lib = str_data(str_builder_build(sb));
        if (_dep_dir_has_stdlib(pinned_lib) == 1) { return pinned_lib; }
        # Pinned version not installed → hard error per acceptance bar
        # 6.6.20: the pin is a manifest string (and the path carries it), so both shown escaped.
        sys_write(STDERR_FD, "error: cyrius.cyml pins version ", 32);
        _ew_shown(pin);
        sys_write(STDERR_FD, " but it is not installed at ", 28);
        _ew_shown(pinned_lib);
        sys_write(STDERR_FD, "\n  run: cyrius install ", 23);
        _ew_shown(pin);
        sys_write(STDERR_FD, "\n", 1);
        _cbt_exit(1);   # sweeps the private temp dir — CHANGELOG [6.6.6]
    }

    # (c) legacy fallback — `~/.cyrius/lib` global symlink
    var installed = make_path(_home, "lib");
    if (_dep_dir_has_stdlib(installed) == 1) { return installed; }
    # Dev mode without a cyrius repo signal (rare): `./lib`
    if (_dep_dir_has_stdlib("./lib") == 1) { return "./lib"; }
    return 0;
}

# v5.10.19 — transitive include resolution for stdlib modules.
#
# Pre-fix, `cyrius deps` copied only the directly-named stdlib
# files (`stdlib = ["syscalls", "process", ...]`) and ignored
# the `include "lib/X.cyr"` directives INSIDE those files. Most
# stdlib modules are leaf files, so this worked — except for
# a handful of arch-dispatcher modules:
#
#   lib/syscalls.cyr → includes lib/syscalls_x86_64_linux.cyr
#                              + lib/syscalls_aarch64_linux.cyr
#                              + lib/syscalls_windows.cyr
#   lib/alloc.cyr    → includes lib/alloc_macos.cyr
#                              + lib/alloc_windows.cyr
#
# A consumer that listed `"syscalls"` in `[deps] stdlib`
# received `lib/syscalls.cyr` only; cyrius's source compile
# then failed at `include "lib/syscalls_x86_64_linux.cyr"` —
# missing file → SYS_* / O_* / fn names defined in the peer
# went undefined → cascading "unexpected unknown" /
# "undefined variable 'SYS_CLOSE'" diagnostics.
#
# In-tree consumers (cyrius's own `programs/checks/`)
# dodged because the dev-mode `./lib` path resolves the
# whole repo lib/ tree at once. agnosys 1.1.13 surfaced the
# gap on CI which uses the installed `~/.cyrius/lib` snapshot.
#
# Fix: scan each copied file for `include "lib/X.cyr"` (or
# `include "lib/sub/X.cyr"`) and recursively copy referenced
# files — same path-relative shape, same `_dep_copy_file`
# call, but breadcrumbed via `_dep_stdlib_seen` so cycles
# (none today, but the dispatcher pattern courts them) and
# repeat-copies are skipped. Visited set is per-`cmd_deps`
# invocation; reset at every call.
var _dep_stdlib_seen = 0;
var _dep_group_names = 0;     # v6.2.49 Phase B: [groups] names (parallel to members)
var _dep_group_members = 0;   # v6.2.49 Phase B: [groups] member lists
var _dep_feature_names = 0;   # v6.3.1 lever 2: [features] feature names (parallel to deps)
var _dep_feature_deps = 0;    # v6.3.1 lever 2: per-feature member lists (deps and/or features)

fn _dep_stdlib_seen_init(): i64 {
    _dep_stdlib_seen = vec_new();
    return 0;
}

fn _dep_stdlib_seen_has(name): i64 {
    if (_dep_stdlib_seen == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (i < vec_len(_dep_stdlib_seen)) {
        var v = vec_get(_dep_stdlib_seen, i);
        if (strlen(v) == nl) { if (memeq(v, name, nl) == 1) { return 1; } }
        i = i + 1;
    }
    return 0;
}

fn _dep_stdlib_seen_add(name): i64 {
    var nl = strlen(name);
    var dup = alloc(nl + 1);
    memcpy(dup, name, nl);
    store8(dup + nl, 0);
    vec_push(_dep_stdlib_seen, dup);
    return 0;
}

# Copy stdlib module `mod_name` (e.g. "syscalls" or
# "syscalls_x86_64_linux"), then scan its content for
# `include "lib/X.cyr"` directives and recursively copy
# those too. Uses `_dep_stdlib_seen` to short-circuit
# repeats.
#
# `is_top` flag: 1 for the consumer-named module
# (gets pushed onto `_dep_includes` so `compile()`
# prepends an explicit `include "lib/<mod>.cyr"`), 0
# for transitive includes. Critical: pre-fix, every
# transitively-copied file was pushed onto
# `_dep_includes`. `compile()` then prepended each as
# an explicit `include`, which OVERRIDES the
# `#ifdef CYRIUS_TARGET_*` arch-dispatcher logic —
# both `lib/syscalls_x86_64_linux.cyr` AND
# `lib/syscalls_aarch64_linux.cyr` parsed
# simultaneously, fns defined twice, "duplicate fn"
# warnings cascading + binaries running with the
# wrong arch's syscall numbers. Top-level-only push
# preserves the dispatcher pattern.
# v6.5.28 — push `include "lib/<mod>.cyr"` onto `_dep_includes` unless it is already there.
# Needed because the seen-guard below now has to service a TOP-LEVEL request for a module that
# a transitive pull already copied; without the once-check that would double-prepend.
fn _dep_push_include_once(mod_name): i64 {
    var pib = str_builder_new();
    str_builder_add_cstr(pib, make_path("lib", mod_name));
    str_builder_add_cstr(pib, ".cyr");
    var want = str_data(str_builder_build(pib));
    var pi = 0;
    while (pi < vec_len(_dep_includes)) {
        if (streq(vec_get(_dep_includes, pi), want) == 1) { return 0; }
        pi = pi + 1;
    }
    vec_push(_dep_includes, want);
    return 0;
}

# v6.5.39 — the stem of a "lib/<stem>.cyr" destination, or 0 if `dst` is not that shape.
# Used to ask "would this copy land on a stdlib leaf?" without re-deriving the name from the
# dep/module pair, which the caller has already combined three different ways.
fn _dep_lib_dst_stem(dst): i64 {
    var n = strlen(dst);
    if (n < 9) { return 0; }                        # shortest possible is "lib/x.cyr"
    if (load8(dst) != 108) { return 0; }            # 'l'
    if (load8(dst + 1) != 105) { return 0; }        # 'i'
    if (load8(dst + 2) != 98) { return 0; }         # 'b'
    if (load8(dst + 3) != 47) { return 0; }         # '/'
    if (load8(dst + n - 4) != 46) { return 0; }     # '.'
    if (load8(dst + n - 3) != 99) { return 0; }     # 'c'
    if (load8(dst + n - 2) != 121) { return 0; }    # 'y'
    if (load8(dst + n - 1) != 114) { return 0; }    # 'r'
    var sb = str_builder_new();
    var i = 4;
    while (i < n - 4) {
        str_builder_putc(sb, load8(dst + i));
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# ⭐ v6.5.39 — REFUSE a dep artifact that would overwrite a stdlib leaf Phase 1 already wrote.
#
# THE DEFECT (filed 2026-09-01, confirmed in two consumer repos). A named dep whose NAME
# collides with a declared `[deps] stdlib` leaf lands its own resolved artifact on
# `lib/<leaf>.cyr` and wins, because the resolver's phase order guarantees it: Phase 1 copies
# the stdlib from the pinned snapshot, Phase 2 does named deps, Phase 3 the transitive BFS —
# and Phase 3 is structurally LAST. Measured: `lib sync` writes sakshi 2.4.12 and the very
# next `cyrius deps` reverts it to the dep's version, exit 0, no diagnostic.
#
# ⚠ THE FILING'S NAMED MECHANISM IS WRONG and fixing what it points at would change nothing.
# It concluded "from the named dep's own lib/" from a byte-identity, but three files share
# those bytes; a marker probe (a transitive tag that exists ONLY in the git cache) shows the
# real source is the dep's RESOLVED ARTIFACT — `~/.cyrius/deps/<name>/<tag>/dist/<name>.cyr`.
# The filing's second-ranked candidate, the fallback at `_dep_pull_module`, is not on this path.
# It also reads as though the consumer's direct dep is the culprit; in the filed chain sakshi is
# THREE hops down and appears in no manifest the consumer authored, so the consumer cannot fix
# it by editing their own file. That is why this must be enforced HERE, in the resolver.
#
# ⚠ THE DISCRIMINATOR IS `_dep_stdlib_seen`, NOT "does the file exist in the stdlib dir".
# Every one of the ~101 stdlib modules exists in the snapshot, so an existence test would also
# refuse a project that legitimately depends on a package of that name WITHOUT declaring it as
# a stdlib leaf — leaving it with no `lib/<name>.cyr` at all. The seen-set holds exactly what
# Phase 1 actually copied, and Phase 1 completes before Phase 3 begins, so by here it is
# fully populated and order-insensitive for this purpose.
#
# ⚠ NAMES PATHS, NOT VERSIONS, and that is deliberate. The filing's own ⚠ records that the
# obvious version grep (`v?[0-9]+\.[0-9]+\.[0-9]+`) matches an earlier unrelated string in
# these bundles. Two exact paths cannot be misparsed and say strictly more.
fn _dep_refuse_stdlib_clobber(stem, src, dst): i64 {
    sys_write(STDERR_FD, "warning: refusing to overwrite stdlib leaf '", 44);
    sys_write(STDERR_FD, stem, strlen(stem));
    sys_write(STDERR_FD, "' -- a dependency resolves a package of the same name.\n", 55);
    sys_write(STDERR_FD, "  kept (stdlib snapshot): ", 26);
    sys_write(STDERR_FD, dst, strlen(dst));
    sys_write(STDERR_FD, "\n  skipped (dep artifact): ", 27);
    _ew_shown(src);   # 6.6.20: it carries the manifest's `modules` entry
    sys_write(STDERR_FD, "\n  declare it in [deps] stdlib OR depend on the package, not both.\n", 67);
    return 0;
}

# ⭐ 6.6.11 (S2) — THE FOLD WINS OVER A THIN PROFILE OF THE SAME PACKAGE, TOO.
# `_dep_refuse_stdlib_clobber` only ever caught a dep artifact whose stem EQUALS a declared
# stdlib leaf. A named dep whose NAME is a stdlib leaf ships more than that: libro's `[deps.sigil]`
# is the thin `dist/sigil-mldsa.cyr` plus `src/{sha_ni,sha256,hex}.cyr`, vendored as
# `lib/sigil-mldsa.cyr` and `lib/sigil_*.cyr`. bote declares the stdlib leaf `sigil` (the
# MONOLITH fold) and depends on libro, so both copies of sigil landed in one unit: 233
# `duplicate fn` warnings while the two versions matched, and at the 6.6.10 pin (fold 3.13.4,
# libro's thin 3.12.18) five arity errors and a failed build — correctness hung on libro's sigil
# tag moving in lockstep with every cyrius fold. Now a module of a named dep `<leaf>` whose file is
# `<leaf>-<profile>` or `<leaf>_<x>` is NOT vendored and NOT auto-included when `<leaf>` is a
# stdlib leaf this resolution already copied: the fold is the package. (Dropped from BOTH lists:
# vendored-but-not-included would still be hashed and locked, included-but-not-vendored is a
# missing include.) A copy an earlier resolution vendored there is removed. CHANGELOG [6.6.11]
fn _dep_is_leaf_profile(stem, leaf): i64 {
    var ll = strlen(leaf);
    if (strlen(stem) <= ll + 1) { return 0; }
    if (memeq(stem, leaf, ll) == 0) { return 0; }
    var c = load8(stem + ll);
    if (c == 45 || c == 95) { return 1; }            # '-' or '_'
    return 0;
}

# 1 when `dst` (lib/<stem>.cyr) is a thin profile module of the named dep `dep`, and `dep` is a
# stdlib leaf already copied — the caller then skips it (see above). Removes a stale vendored
# copy, through the symlink guard; -1 when that guard refuses.
fn _dep_keep_fold_over_profile(dep, dst, mod_path): i64 {
    var stem = _dep_lib_dst_stem(dst);
    if (stem == 0) { return 0; }
    if (_dep_stdlib_seen_has(dep) == 0) { return 0; }
    if (_dep_is_leaf_profile(stem, dep) == 0) { return 0; }
    if (file_exists(dst) == 1) {
        if (_dep_vendor_mode == 1) {
            var lk = _dep_dest_is_linked(dst);
            if (lk != 0) { _dep_refuse_symlinked_dest(lk); return 0 - 1; }
        }
        sys_unlink(dst);
    }
    _ew("note: [deps.");
    _ew_shown(dep);
    _ew("] ");
    _ew_shown(mod_path);
    _ew(" not vendored — '");
    _ew_shown(dep);
    _ew("' is a stdlib leaf here, and its fold lib/");
    _ew_shown(dep);
    _ew(".cyr is the package\n");
    return 1;
}

fn _dep_copy_stdlib_recursive(stdlib_dir, mod_name, is_top): i64 {
    if (_dep_stdlib_seen_has(mod_name) == 1) {
        # ⛔ v6.5.28 — THE SEEN-GUARD USED TO `return 0` UNCONDITIONALLY, which conflated two
        # different jobs this fn does: COPY the file, and PUSH its top-level include. Once a
        # module had been pulled TRANSITIVELY (is_top=0) it was marked seen, so when the
        # resolver later reached that module's own `[deps].stdlib` entry it short-circuited
        # here and never pushed the include. `lib/X.cyr` was on disk, `cyrius deps` reported
        # success, the lockfile listed it — and every symbol in X was an undefined function,
        # with nothing in the output naming X.
        #
        # ⚠ Purely an ORDERING artifact: the SAME declared module set builds or fails on which
        # entry comes first, which is what made it expensive to diagnose — the manifest looks
        # correct because it IS correct. Filed from kavach 3.11.14, whose whole tree stopped
        # building on a 6.5.21 -> 6.5.27 pin move.
        # ⛔ Not confined to `[deps].stdlib`: `_dep_pull_leaves` calls this with is_top=1 for
        # the `requires` key and the `dist/<pkg>.deps` sidecar, so a bundle whose sidecar lists
        # leaves in an unlucky order handed the identical failure to EVERY consumer.
        #
        # The copy is genuinely already done, so only the push is owed. Top-level-only push is
        # preserved deliberately — prepending TRANSITIVE includes overrides the
        # `#ifdef CYRIUS_TARGET_*` arch dispatchers and was itself a prior bug (see the header
        # comment above this fn).
        # ⛔ v6.5.31 — DIRECTORY FAMILIES MUST NOT GET A FLAT INCLUDE HERE.
        #
        # `unicode` is the one stdlib module that is a package DIRECTORY (`lib/unicode/*.cyr`)
        # with no `lib/unicode.cyr`. The expansion below handles that — but only on the FIRST
        # arrival, because this seen-guard returns before reaching it. So when `unicode` came
        # in via BOTH a dep's `.deps` sidecar AND the consumer's own `[deps].stdlib`, the first
        # route expanded the family correctly and the second route landed here and pushed a
        # flat `include "lib/unicode.cyr"` — a file that legitimately does not exist. The build
        # died with `cannot open include file: lib/unicode.cyr` while `lib/unicode/` sat there
        # fully populated, sending the reader after a missing stdlib module instead of a
        # double declaration. Filed from agnostic 2.0.1 consuming agnosai 2.0.2.
        #
        # ⚠ INTRODUCED AT v6.5.28, not v6.2.47 as the filing reasonably guessed: this push is
        # what the transitive-include fix added, and it was written for flat leaves only.
        # Either declaration alone worked; only the combination reached it.
        #
        # The family members were already pushed by whichever route arrived first, so the
        # correct action here is to push NOTHING — guarded by the same file_exists test the
        # expansion itself keys on, so the two cannot disagree about what a family is.
        if (is_top == 1) {
            var gsb = str_builder_new();
            str_builder_add_cstr(gsb, stdlib_dir);
            str_builder_add_cstr(gsb, "/");
            str_builder_add_cstr(gsb, mod_name);
            str_builder_add_cstr(gsb, ".cyr");
            if (file_exists(str_data(str_builder_build(gsb))) == 1) {
                _dep_push_include_once(mod_name);
            }
        }
        return 0;
    }
    _dep_stdlib_seen_add(mod_name);

    var sb = str_builder_new();
    str_builder_add_cstr(sb, stdlib_dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, mod_name);
    str_builder_add_cstr(sb, ".cyr");
    var src = str_data(str_builder_build(sb));

    # Directory-family expansion (v6.1.x): a bare family name like "unicode" is a
    # DIRECTORY (lib/unicode/*.cyr), not a single lib/unicode.cyr. When the
    # <name>.cyr source is absent but <stdlib_dir>/<name>/ is a directory, resolve
    # every .cyr inside it. Each accessor self-includes its data file, so the
    # transitive scan below still fixes ordering. Fixes downstream consumers
    # (e.g. niyama) declaring bare "unicode" in [deps].stdlib — previously this
    # errored "cannot read lib/unicode.cyr" and dropped the whole family.
    if (file_exists(src) == 0) {
        var dsb = str_builder_new();
        str_builder_add_cstr(dsb, stdlib_dir);
        str_builder_add_cstr(dsb, "/");
        str_builder_add_cstr(dsb, mod_name);
        var dir_path = str_builder_build(dsb);
        # 6.6.10: a family directory that EXISTS but cannot be listed is named (it read as an
        # empty family, and the error below then blamed a missing `<name>.cyr`).
        var entries = 0;
        if (is_dir(dir_path) == 1) {
            entries = _cbt_list_dir(str_data(dir_path), "its modules were NOT resolved");
            if (entries == 0) { return 1; }
        }
        if (entries != 0) { vec_sort_by(entries, &_dep_name_cmp); }   # v6.5.37 (A8): readdir order is not deterministic
        if (entries != 0) {
            var n = vec_len(entries);
            var ei = 0;
            var expanded = 0;
            while (ei < n) {
                var es = vec_get(entries, ei);
                ei = ei + 1;
                var ed = str_data(es);
                var el = str_len(es);
                if (el >= 5) {
                    if (memeq(ed + el - 4, ".cyr", 4) == 1) {
                        var stem = el - 4;
                        var subbuf = str_builder_new();
                        str_builder_add_cstr(subbuf, mod_name);
                        str_builder_add_cstr(subbuf, "/");
                        var stemc = alloc(stem + 1);
                        memcpy(stemc, ed, stem);
                        store8(stemc + stem, 0);
                        str_builder_add_cstr(subbuf, stemc);
                        var sub_name = str_data(str_builder_build(subbuf));
                        _dep_copy_stdlib_recursive(stdlib_dir, sub_name, is_top);
                        expanded = 1;
                    }
                }
            }
            if (expanded == 1) { return 0; }
        }
    }

    var dst = make_path("lib", mod_name);
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, dst);
    str_builder_add_cstr(sb2, ".cyr");
    var dst_full = str_data(str_builder_build(sb2));

    # v6.6.4 — lock guard BEFORE the write: a snapshot leaf whose bytes moved under an
    # unchanged pin is refused here (named on stderr, counted into `errors`), so neither
    # lib/<leaf> nor cyrius.lock changes. The include push + transitive scan still run so
    # every moved leaf is reported in one pass; the resolve fails as a whole afterwards.
    var cr = 0;
    if (_dep_lock_guard_stdlib_leaf(src, dst_full) == 0) {
        cr = _dep_copy_file(src, dst_full);
        # 6.6.9: a vendored leaf the lock has no line for — a new leaf, or no lock at all —
        # makes cmd_deps write the lock. A new leaf has no locked hash to disagree with, so
        # the 6.6.4 moved-snapshot refusal above is not in play. CHANGELOG [6.6.9]
        if (cr != 1 && _dep_lock_active == 1 && _lock_file_hash_lookup(dst_full) == 0) {
            _dep_lock_new_leaf = 1;
        }
    }
    if (cr == 1) { return 1; }
    if (is_top == 1) { vec_push(_dep_includes, dst_full); }

    # Scan the just-copied source for `include "lib/X.cyr"`
    # directives. Open the SOURCE (not destination — same
    # bytes; src guaranteed readable since copy succeeded).
    var sfd = sys_open(src, O_RDONLY, 0);
    if (sfd < 0) { return 0; }
    var sz = _file_size(src);
    if (sz <= 0) { sys_close(sfd); return 0; }
    var fbuf = alloc(sz + 1);
    var nread = syscall(0, sfd, fbuf, sz);
    sys_close(sfd);
    if (nread <= 0) { return 0; }
    store8(fbuf + nread, 0);

    # Walk for `include "lib/`. Tolerate any leading whitespace
    # but skip lines starting with `#` (commented-out includes
    # in retro/historical comments shouldn't drag deps in).
    var pos = 0;
    while (pos < nread) {
        var ls = pos;
        # End-of-line
        var le = pos;
        while (le < nread && load8(fbuf + le) != 10) { le = le + 1; }
        # Trim leading whitespace
        var lp = ls;
        while (lp < le) {
            var lc = load8(fbuf + lp);
            if (lc != 32 && lc != 9) { break; }
            lp = lp + 1;
        }
        # Comment line — skip
        if (lp < le && load8(fbuf + lp) != 35) {
            # Match `include "lib/`
            if (le - lp >= 13) {
                if (memeq(fbuf + lp, "include \"lib/", 13) == 1) {
                    var name_start = lp + 13;
                    var name_end = name_start;
                    while (name_end < le && load8(fbuf + name_end) != 34) {
                        name_end = name_end + 1;
                    }
                    if (name_end < le) {
                        var inc_len = name_end - name_start;
                        # Strip ".cyr" suffix (4 bytes) if present.
                        if (inc_len > 4) {
                            if (memeq(fbuf + name_end - 4, ".cyr", 4) == 1) {
                                inc_len = inc_len - 4;
                            }
                        }
                        var inc_name = alloc(inc_len + 1);
                        memcpy(inc_name, fbuf + name_start, inc_len);
                        store8(inc_name + inc_len, 0);
                        # Recursive fetch (transitive). Only if the
                        # source file actually exists in stdlib_dir —
                        # silently skip non-stdlib includes (consumer
                        # might `include "src/foo.cyr"` in stdlib if
                        # someone got creative; not our concern).
                        var probe_sb = str_builder_new();
                        str_builder_add_cstr(probe_sb, stdlib_dir);
                        str_builder_add_cstr(probe_sb, "/");
                        str_builder_add_cstr(probe_sb, inc_name);
                        str_builder_add_cstr(probe_sb, ".cyr");
                        var probe_path = str_data(str_builder_build(probe_sb));
                        if (file_exists(probe_path) == 1) {
                            # Transitive — is_top=0 so we copy the
                            # file but DON'T push to `_dep_includes`.
                            # The top-level dispatcher (`lib/syscalls.cyr`,
                            # `lib/alloc.cyr`) follows its own
                            # `include "lib/X.cyr"` chain at parse time
                            # gated by `#ifdef`.
                            _dep_copy_stdlib_recursive(stdlib_dir, inc_name, 0);
                        }
                    }
                }
            }
        }
        pos = le + 1;
    }
    return 0;
}

# ⛔ v6.5.37 (A8) — DETERMINISTIC FAMILY EXPANSION. `dir_list` returns readdir order, which
# is filesystem-dependent, not sorted. Measured on `lib/unicode` at 6.5.36:
#   _casefold_data.cyr  casefold.cyr  _normalize_data.cyr  normalize.cyr  _decode.cyr ...
# — not lexicographic. So the one stdlib module that is a package DIRECTORY expanded into a
# consumer's `lib/` in whatever order that machine's filesystem happened to hand back, and
# the resulting include list differed between machines for identical inputs.
#
# ⚠ WHY IT MATTERS HERE MORE THAN IT WOULD ELSEWHERE: this is a self-hosting toolchain whose
# central promise is byte-identical reproduction. A dependency resolution whose output order
# depends on directory layout is a reproducibility hole even when every ordering happens to
# compile — and "happens to compile" is doing real work, because cyrius requires globals to
# be declared before use, so a family member ordered ahead of the data file it reads is a
# compile error rather than a subtle difference.
#
# Sorting at the expansion sites rather than inside `dir_list` itself: the walkers in
# commands.cyr use it for test/bench discovery where readdir order is harmless, and changing
# a shared primitive to fix two callers is the wider blast radius.
fn _dep_name_cmp(a, b): i64 {
    var pa = str_data(a);
    var pb = str_data(b);
    var i = 0;
    while (1 == 1) {
        var ca = load8(pa + i);
        var cb = load8(pb + i);
        if (ca != cb) { return ca - cb; }
        if (ca == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

# The value of the key at (or ending at) buf[pos] — a TOML array of strings, or a single string —
# as a vec of cstrs. 6.6.17 (m6): elements are TOML strings (`'…'` literal, `"…"` with escapes;
# a `'…'` element used to be DROPPED), a `#` comment inside the array is skipped (a `"…"` in it was
# read as an element), and the search for the value stops at the end of the key's own line (it
# used to skip to the next `[` wherever that was — a section header, when the value was not an
# array). Empty vec when the line holds no string / array value.
fn _parse_toml_str_array(buf, len, pos): i64 {
    var result = vec_new();
    while (pos < len) {
        var k = load8(buf + pos);
        if (k == 61 || k == 91 || k == 10) { break; }
        pos = pos + 1;
    }
    if (pos < len && load8(buf + pos) == 61) { pos = _toml_skip_ws(buf, len, pos + 1); }
    var e = 0;
    if (pos < len && (load8(buf + pos) == 34 || load8(buf + pos) == 39)) {
        var one = _toml_str_at(buf, len, pos, &e);
        if (one != 0) { vec_push(result, one); }
        return result;
    }
    if (pos >= len || load8(buf + pos) != 91) { return result; }
    pos = pos + 1;
    while (pos < len) {
        var c = load8(buf + pos);
        if (c == 93) { break; }
        if (c == 35) {
            while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
            continue;
        }
        if (c == 34 || c == 39) {
            var s = _toml_str_at(buf, len, pos, &e);
            if (s != 0) {
                vec_push(result, s);
                pos = e;
                continue;
            }
        }
        pos = pos + 1;
    }
    return result;
}

# v6.3.1 (dependency-model arc, lever 2): split a comma-separated CLI value
# ("gpu,win-shell") into a vec<cstr> of feature names. Empty segments are
# dropped, so a trailing/leading comma is tolerated. Used by the cyrius.cyr
# pre-scan to parse `--features <list>` ahead of the dep resolver.
fn _split_csv(s): i64 {
    var out = vec_new();
    var sl = strlen(s);
    var i = 0;
    var start = 0;
    while (i <= sl) {
        if (i == sl || load8(s + i) == 44) {
            var seg = i - start;
            if (seg > 0) {
                var d = alloc(seg + 1);
                memcpy(d, s + start, seg);
                store8(d + seg, 0);
                vec_push(out, d);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

# v6.2.46/.47 (deps lever 1, Phase A): pull a vec of stdlib-leaf names into
# scope via the recursive stdlib resolver (is_top=1 → each leaf's
# `include "lib/<leaf>"` is pushed onto `_dep_includes`), deduped by
# `_dep_stdlib_seen`. FAIL-LOUD: a leaf that doesn't resolve returns the error
# count. Shared by the `requires` key (.46) and the `.deps` sidecar (.47).
# Caller must have inited `_dep_stdlib_seen` + resolved a non-0 `stdlib_dir`.
# Record a stdlib leaf pulled on behalf of a named dep (see _dep_nd_leaves), once.
fn _dep_note_nd_leaf(leaf): i64 {
    if (_dep_nd_leaves == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_dep_nd_leaves)) {
        if (streq(vec_get(_dep_nd_leaves, i), leaf) == 1) { return 0; }
        i = i + 1;
    }
    vec_push(_dep_nd_leaves, leaf);
    return 0;
}

fn _dep_pull_leaves(stdlib_dir, dep_name, leaves): i64 {
    var errs = 0;
    var i = 0;
    while (i < vec_len(leaves)) {
        var leaf = vec_get(leaves, i);
        # 6.6.20: a `requires` entry or a sidecar line is a LEAF name, checked by the one leaf rule
        # before it becomes a path — a sidecar's `../../x` used to reach `_dep_copy_file`'s
        # destination guard and then this fn's "it IS in the stdlib (<a path outside it>)".
        if (_dep_leaf_ok(leaf) == 0) {
            _dep_refuse_leaf("dep ", dep_name, leaf);
            errs = errs + 1;
            i = i + 1;
            continue;
        }
        _dep_note_nd_leaf(leaf);
        var r = _dep_copy_stdlib_recursive(stdlib_dir, leaf, 1);
        if (r == 1) {
            # v6.5.24 — SAY WHICH CONDITION ACTUALLY HELD. This printed
            # "but it is not in the cyrius stdlib" for every failure, which was FALSE
            # for the ones consumers actually hit: `bench`, `test`, `patra`, `random`,
            # `chrono`, `slice` and `ct` are all present in the stdlib, and the real
            # condition was an unpopulated resolution dir. The line above it already
            # said `cannot read <path>` — but this one is phrased as a CONCLUSION, so
            # it wins, and it pointed maintainers at deleting a correct
            # `[deps].stdlib` declaration. Filed from bote CI (also agnosai, majra).
            # Probe the SOURCE dir: if the module is there, the stdlib is fine and the
            # copy is what failed — a different problem with a different fix.
            var _lp_sb = str_builder_new();
            str_builder_add_cstr(_lp_sb, stdlib_dir);
            str_builder_add_cstr(_lp_sb, "/");
            str_builder_add_cstr(_lp_sb, leaf);
            str_builder_add_cstr(_lp_sb, ".cyr");
            var _lp_src = str_data(str_builder_build(_lp_sb));
            sys_write(STDERR_FD, "error: dep ", 11);
            _ew_shown(dep_name);
            sys_write(STDERR_FD, " requires '", 11);
            sys_write(STDERR_FD, leaf, strlen(leaf));
            # ⚠ BOTH declared lengths here were off by one and BOTH truncated visibly —
            # measured on the real bote tree at v6.5.24, which printed `(looked in./lib)`
            # with the trailing space eaten. The em-dash in the first string is 3 UTF-8
            # BYTES, so its literal is 27 bytes, not the 26 characters it looks like.
            # This is the same hardcoded-length class the v6.5.24 `ERR_MSG` audit found 49
            # of 104 wrong — and it slipped through because that gate scans
            # `ERR_MSG(S, "...", N)` under `src/` only, so `sys_write(STDERR_FD, "...", N)`
            # under `cbt/` is invisible to it. Gate widened at v6.5.25.
            if (file_exists(_lp_src) == 1) {
                sys_write(STDERR_FD, "' — it IS in the stdlib (", 27);
                sys_write(STDERR_FD, _lp_src, strlen(_lp_src));
                sys_write(STDERR_FD, ") but could not be brought into ./lib. Run `cyrius lib sync --full`; do NOT remove the declaration.\n", 100);
            } else {
                sys_write(STDERR_FD, "' but it is not in the cyrius stdlib (looked in ", 48);
                sys_write(STDERR_FD, stdlib_dir, strlen(stdlib_dir));
                sys_write(STDERR_FD, ")\n", 2);
            }
            errs = errs + 1;
        }
        i = i + 1;
    }
    return errs;
}

# v6.2.47 (deps lever 1, Phase A producer-side consumed): read a `cyrius
# distlib` sidecar (`dist/<pkg>.deps`) — one stdlib leaf per line, `#` comments
# + blank lines ignored, trailing CR/space trimmed — into a vec of leaf cstrs.
# Returns 0 (not a vec) when the file is absent/empty. Lets a consumer that
# declares just `[deps.<pkg>]` auto-pull the fold's leaves with no hand-authored
# `requires` key.
fn _dep_read_sidecar(path): i64 {
    if (file_exists(path) == 0) { return 0; }
    var sz = _file_size(path);
    if (sz <= 0) { return 0; }
    var buf = alloc(sz + 1);
    var n = file_read_all(path, buf, sz);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    var leaves = vec_new();
    var pos = 0;
    while (pos < n) {
        var ls = pos;
        while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
        var le = pos;
        if (pos < n) { pos = pos + 1; }
        var lp = ls;
        while (lp < le) {
            var c = load8(buf + lp);
            if (c != 32 && c != 9) { break; }
            lp = lp + 1;
        }
        if (lp < le && load8(buf + lp) != 35) {
            var ep = le;
            while (ep > lp) {
                var c2 = load8(buf + ep - 1);
                if (c2 != 32 && c2 != 9 && c2 != 13) { break; }
                ep = ep - 1;
            }
            var nl = ep - lp;
            if (nl > 0) {
                var leaf = alloc(nl + 1);
                memcpy(leaf, buf + lp, nl);
                store8(leaf + nl, 0);
                vec_push(leaves, leaf);
            }
        }
    }
    return leaves;
}

# v6.2.49 (deps lever 1 / Phase B — named module groupings): generic membership.
fn _dep_list_has(list, name): i64 {
    if (list == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (i < vec_len(list)) {
        var v = vec_get(list, i);
        if (strlen(v) == nl) { if (memeq(v, name, nl) == 1) { return 1; } }
        i = i + 1;
    }
    return 0;
}

# v6.2.49 Phase B: look up a `[groups]` name → its member vec, or 0 if not a group.
fn _dep_group_lookup(name): i64 {
    if (_dep_group_names == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (i < vec_len(_dep_group_names)) {
        var gn = vec_get(_dep_group_names, i);
        if (strlen(gn) == nl) { if (memeq(gn, name, nl) == 1) { return vec_get(_dep_group_members, i); } }
        i = i + 1;
    }
    return 0;
}

# v6.2.49 Phase B: expand one name into `out`. If it names a `[groups]` group,
# recurse over its members (groups may reference groups); else append the bare
# name (deduped). A self/mutual cycle is skipped via the `seen` guard.
fn _dep_expand_one(out, name, seen): i64 {
    var members = _dep_group_lookup(name);
    if (members == 0) {
        if (_dep_list_has(out, name) == 0) { vec_push(out, name); }
        return 0;
    }
    if (_dep_list_has(seen, name) == 1) { return 0; }   # cycle — skip
    vec_push(seen, name);
    var j = 0;
    while (j < vec_len(members)) {
        _dep_expand_one(out, vec_get(members, j), seen);
        j = j + 1;
    }
    return 0;
}

# v6.2.49 Phase B: expand any `[groups]` references in a name list (`[deps].stdlib`
# or a `[deps.NAME] requires`) into a flat, deduped list of leaf/dep names.
# Passthrough (returns the SAME vec) when no groups are defined, so non-`[groups]`
# manifests resolve byte-identical to before.
fn _dep_expand_groups(names): i64 {
    if (_dep_group_names == 0) { return names; }
    if (vec_len(_dep_group_names) == 0) { return names; }
    var out = vec_new();
    var seen = vec_new();
    var i = 0;
    while (i < vec_len(names)) {
        _dep_expand_one(out, vec_get(names, i), seen);
        i = i + 1;
    }
    return out;
}

# v6.2.49 Phase B: parse a `[groups]` section into `_dep_group_names` /
# `_dep_group_members` (parallel vecs). Each `name = ["a", "b", ...]` line defines
# a group that expands at resolve time wherever it's named in `[deps].stdlib` or a
# `[deps.NAME] requires` list. Members are whole stdlib-leaf / dep names (the
# `pkg:submodule` sub-unit form awaits Phase C).
fn _dep_parse_groups(buf, n): i64 {
    _dep_group_names = vec_new();
    _dep_group_members = vec_new();
    _dep_parse_name_lists(buf, n, "groups", _dep_group_names, _dep_group_members);   # 6.6.20: the one reader
    return 0;
}

# v6.3.32 Phase D (modularity arc, lever-1 COMPLETION — dissolve the "stdlib"
# category): register the built-in `std` DEFAULT GROUP — the universal core stdlib
# leaves every real program pulls (matches the `cyrius init` template core). This
# makes `stdlib`/`requires` list a group like any other (`stdlib = ["std", <extras>]`)
# instead of hand-ordering the whole leaf set: `std` expands at resolve time via the
# Phase B `_dep_expand_groups` path (already applied to the stdlib list + `requires`).
# Registered AFTER `_dep_parse_groups` so a manifest that defines its OWN `std` group
# wins (override, not clobber). Member ORDER matches the init-template core so a
# `["std", …]` list resolves the SAME leaves in the SAME order as the explicit form
# → byte-identical. A manifest that never names `std` is unaffected (the expansion of
# a std-free list is dedup-in-order = identity).
fn _dep_register_default_std_group(): i64 {
    if (_dep_group_names == 0) { return 0; }              # parse_groups not run yet
    if (_dep_group_lookup("std") != 0) { return 0; }      # manifest defined its own `std`
    var m = vec_new();
    vec_push(m, "string");
    vec_push(m, "fmt");
    vec_push(m, "alloc");
    vec_push(m, "io");
    vec_push(m, "vec");
    vec_push(m, "str");
    vec_push(m, "syscalls");
    vec_push(_dep_group_names, "std");
    vec_push(_dep_group_members, m);
    return 0;
}

# v6.3.1 (dependency-model arc, lever 2 — required vs optional deps): parse a
# `[features]` table into `_dep_feature_names` / `_dep_feature_deps` (parallel
# vecs), read like `_dep_parse_groups`. Each `name = ["dep", ...]`
# line declares a feature whose members are optional-dep names and/or other
# feature names (recursively expanded by `_dep_feature_expand` at resolve time).
# The reserved `default = [...]` line is the set activated unless
# `--no-default-features` is passed.
# Absent `[features]` → empty vecs → no optional dep is ever activated (every
# pre-existing manifest resolves byte-identical). Parse-only here; the active-set
# computation + the skip gate live with the resolver (`_dep_feature_active`).
fn _dep_parse_features(buf, n): i64 {
    _dep_feature_names = vec_new();
    _dep_feature_deps = vec_new();
    _dep_parse_name_lists(buf, n, "features", _dep_feature_names, _dep_feature_deps);   # 6.6.20: the one reader
    return 0;
}

# v6.3.1 lever 2: look up a `[features]` name → its member vec, or 0 if `name`
# is not a declared feature (then it's treated as a bare dep name by the caller).
fn _dep_feature_lookup(name): i64 {
    if (_dep_feature_names == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (i < vec_len(_dep_feature_names)) {
        var fnm = vec_get(_dep_feature_names, i);
        if (strlen(fnm) == nl) { if (memeq(fnm, name, nl) == 1) { return vec_get(_dep_feature_deps, i); } }
        i = i + 1;
    }
    return 0;
}

# v6.3.1 lever 2: expand `name` into the active-dep set `out`. If `name` is a
# declared feature, recurse over its members (features may name other features);
# otherwise it's a dep name → append (deduped). Self/mutual cycles skip via the
# `seen` guard. Mirrors `_dep_expand_one` (the [groups] analog).
fn _dep_feature_expand(out, name, seen): i64 {
    var members = _dep_feature_lookup(name);
    if (members == 0) {
        if (_dep_list_has(out, name) == 0) { vec_push(out, name); }
        return 0;
    }
    if (_dep_list_has(seen, name) == 1) { return 0; }   # cycle — skip
    vec_push(seen, name);
    var j = 0;
    while (j < vec_len(members)) {
        _dep_feature_expand(out, vec_get(members, j), seen);
        j = j + 1;
    }
    return 0;
}

# v6.3.1 lever 2: is the optional dep `dep_name` activated by the current feature
# selection? Active set = the `[features]` `default = [...]` list (unless
# `--no-default-features`) ∪ the `--features` request list, each fully expanded.
# A `--features wgpu` naming an optional dep directly (no `[features]` entry)
# activates it too (Cargo-style implicit feature). With no `[features]` table and
# no `--features`, an optional dep is INACTIVE — it never resolves unless named.
fn _dep_feature_active(dep_name): i64 {
    var active = vec_new();
    var seen = vec_new();
    if (_cli_no_default == 0) {
        var defs = _dep_feature_lookup("default");
        if (defs != 0) {
            var i = 0;
            while (i < vec_len(defs)) {
                _dep_feature_expand(active, vec_get(defs, i), seen);
                i = i + 1;
            }
        }
    }
    if (_cli_features != 0) {
        var k = 0;
        while (k < vec_len(_cli_features)) {
            _dep_feature_expand(active, vec_get(_cli_features, k), seen);
            k = k + 1;
        }
    }
    return _dep_list_has(active, dep_name);
}

# v6.3.1 lever 2: does a dep's `target = "<arch|os>"` key match the current build
# target? Arch axis reads `_arch` (0=x86_64, 1=aarch64); OS axis reads the
# `_win_target` / `_agnos_target` / `_baremetal_target` flags the cyrius.cyr
# pre-scan set before resolution. "linux" means a native userland build (not
# windows/agnos/bare-metal) — note it also matches a native macOS host today
# (no separate macOS target flag yet; a follow-up if a consumer needs it). An
# unrecognized target string never matches (a typo skips the dep, doesn't pull it
# everywhere). Callers only invoke this when dep_target != 0.
fn _dep_target_matches(t): i64 {
    var tl = strlen(t);
    if (tl == 7 && memeq(t, "aarch64", 7) == 1) { if (_arch == 1) { return 1; } return 0; }
    if (tl == 5 && memeq(t, "arm64", 5) == 1) { if (_arch == 1) { return 1; } return 0; }
    if (tl == 6 && memeq(t, "x86_64", 6) == 1) { if (_arch == 0) { return 1; } return 0; }
    if (tl == 3 && memeq(t, "x86", 3) == 1) { if (_arch == 0) { return 1; } return 0; }
    if (tl == 7 && memeq(t, "windows", 7) == 1) { if (_win_target == 1) { return 1; } return 0; }
    if (tl == 5 && memeq(t, "agnos", 5) == 1) { if (_agnos_target == 1) { return 1; } return 0; }
    if (tl == 10 && memeq(t, "bare-metal", 10) == 1) { if (_baremetal_target == 1) { return 1; } return 0; }
    if (tl == 5 && memeq(t, "linux", 5) == 1) {
        if (_win_target == 0 && _agnos_target == 0 && _baremetal_target == 0) { return 1; }
        return 0;
    }
    return 0;
}

# The NAME rule — a `[deps.NAME]` header (CVE-62) and a modular sub-module (CVE-32), silent:
# 1 when `name` cannot be one path component — empty, `.`-led (`.` and `..` alias the parent:
# `[deps..]` cloned into `<home>/deps/./<tag>`, i.e. ANOTHER dep's cache root), or holding `/`,
# `\` (a Windows separator), `..` or a control byte (a header name is echoed in errors, and the
# old scan ran across newlines). The same set the tag rule refuses (_dep_reject_unsafe_tag),
# less the `/` a tag may hold. CHANGELOG [6.6.20] (CVE-TBD).
fn _dep_name_unsafe(name): i64 {
    if (load8(name) == 0 || load8(name) == 46) { return 1; }   # empty, '.'-led
    var i = 0;
    var c = load8(name);
    while (c != 0) {
        if (c == 47 || c == 92 || c < 32 || c == 127) { return 1; }   # '/', '\', control
        if (c == 46 && load8(name + i + 1) == 46) { return 1; }      # '..'
        i = i + 1;
        c = load8(name + i);
    }
    return 0;
}

# 1 when a stdlib LEAF name may become a path under lib/ and an include line: non-empty,
# [A-Za-z0-9_/-] only (so no `..`, no quote, no newline), no leading, trailing or doubled `/`.
# A `/` stays legal: `unicode/categories` is a leaf. The ONE leaf rule (6.6.20): distlib's
# requires block and `--modular` index (the producers), a `lib:` index entry, a `requires` key,
# a `dist/<pkg>.deps` sidecar line and `[deps] stdlib` (the consumers). It was three rules — the
# producer allowed `/`, the index emit checked nothing, and the consumer's `lib:` check was the
# dep-NAME rule, which refused `/`, so `distlib --modular` wrote `lib:unicode/categories` and
# every consumer refused it as path traversal; sidecar leaves had no check at all.
fn _dep_leaf_ok(lf): i64 {
    var n = strlen(lf);
    if (n == 0 || load8(lf) == 47 || load8(lf + n - 1) == 47) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(lf + i);
        var ok = 0;
        if (c >= 97 && c <= 122) { ok = 1; }
        elif (c >= 65 && c <= 90) { ok = 1; }
        elif (c >= 48 && c <= 57) { ok = 1; }
        elif (c == 95 || c == 45) { ok = 1; }
        elif (c == 47 && load8(lf + i + 1) != 47) { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# "error: <who> names '<leaf>', which is not a stdlib leaf name …" — `who` is a fixed phrase,
# `ctx` (0 or a manifest string) is shown escaped after it.
fn _dep_refuse_leaf(who, ctx, leaf): i64 {
    _ew("error: ");
    _ew(who);
    if (ctx != 0) { _ew_shown(ctx); }
    _ew(" names '");
    _ew_shown(leaf);
    _ew("', which is not a stdlib leaf name ([A-Za-z0-9_/-], no leading, trailing or doubled /) — refused\n");
    return 1;
}

# The refusal of a `[deps.NAME]` header whose NAME fails _dep_name_unsafe, shown escaped —
# one line, shared by the resolver and `deps --dry-run`.
fn _dep_refuse_name(name): i64 {
    _ew("error: [deps.");
    _ew_shown(name);
    _ew("] is not a usable dep name (empty, `.`-led, or holding `/`, `\\`, `..` or a control byte,");
    _ew(" it would make a path) — section refused\n");
    return 1;
}

# CVE-76 (6.6.16): a `[deps.X] tag` is joined into the clone dir
# `<home>/deps/<name>/<tag>`, so it must name a place INSIDE that dir — CVE-62's class
# on the TAG field (CVE-62 guarded the header name only). `../../../esc/sub` made git
# mkdir the leading components OUTSIDE the cache before it rejected the ref, and a tag
# naming an existing dir (`../../..`) skipped the clone and printed `rm -rf <that dir>`
# advice. Refused: empty, `..` anywhere, a leading `/` or `-`, any component starting
# with `.`, `\` (a Windows separator), control bytes. A `/` inside stays legal
# (`release/1.0` is a valid git tag and stays under `<home>/deps/<name>/`); git refnames
# can never hold `..`, a leading `-` or a `.`-led component, so no real tag is lost.
# Returns 1 = unsafe (refuse). Called only when a `tag` key is present.
fn _dep_reject_unsafe_tag(tag): i64 {
    if (load8(tag) == 0) { return 1; }
    if (load8(tag) == 47 || load8(tag) == 45) { return 1; }   # leading '/' or '-'
    var i = 0;
    var c = load8(tag);
    while (c != 0) {
        if (c < 32 || c == 127 || c == 92) { return 1; }       # control bytes, backslash
        if (c == 46 && load8(tag + i + 1) == 46) { return 1; }  # '..'
        if (c == 46 && (i == 0 || load8(tag + i - 1) == 47)) { return 1; }   # '.'-led component
        i = i + 1;
        c = load8(tag + i);
    }
    return 0;
}

# 1 when a `[deps.X] modules` entry could name a file outside the dep's tree: a leading `/` or
# `\`, or a `..` component (split on `/` and on `\`, a separator on Windows). `./dist/x.cyr` and
# `x..y.cyr` stay legal. An absolute path was never read (it is joined as `<dep>//abs`).
fn _dep_mod_path_unsafe(m): i64 {
    var c = load8(m);
    if (c == 47 || c == 92) { return 1; }
    var s = 0;
    var i = 0;
    while (1 == 1) {
        c = load8(m + i);
        if (c == 0 || c == 47 || c == 92) {
            if (i - s == 2 && load8(m + s) == 46 && load8(m + s + 1) == 46) { return 1; }
            if (c == 0) { return 0; }
            s = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# Name every unsafe entry of a `[deps.X] modules` list (_dep_mod_path_unsafe); the count.
fn _dep_modules_refused(dep_name, mods): i64 {
    var bad = 0;
    var i = 0;
    while (i < vec_len(mods)) {
        var m = vec_get(mods, i);
        i = i + 1;
        if (_dep_mod_path_unsafe(m) == 1) {
            _ew("error: [deps.");
            _ew_shown(dep_name);
            _ew("] modules entry \"");
            _ew_shown(m);
            _ew("\" is not a path inside the dep (absolute, or a `..` component) — section refused\n");
            bad = bad + 1;
        }
    }
    return bad;
}

# The first prefix of `full` BELOW its dep root (the first `rootlen` bytes) that is a symlink, as
# a fresh cstr; 0 when none is. A dep's files — a module, the dist/<name>.cyr default, a modular
# sub-module, its index.cyml, a .deps sidecar — are read only from inside the dep's own tree: the
# copy opens with sys_open, which follows links, so a tag COMMITTING `dist/x.cyr -> /abs/secret`
# (or `dist -> /dir`) vendored the target into lib/ with a verified commit pin and exit 0. The
# CVE-43 cache verify cannot see it — the link IS the tag's content. Every component is checked,
# as [embed] does (_embed_path_bad); the root itself is the operator's. CHANGELOG [6.6.20] (CVE-TBD)
fn _dep_src_link(full, rootlen): i64 {
    var n = strlen(full);
    var j = rootlen;
    while (j <= n) {
        if (j > rootlen && (j == n || load8(full + j) == 47)) {
            var pre = alloc(j + 1);
            memcpy(pre, full, j);
            store8(pre + j, 0);
            if (is_symlink(str_from(pre)) == 1) { return pre; }
        }
        j = j + 1;
    }
    return 0;
}

# "error: [deps.<dep>] <rel> passes through a symlink (<link>) — …" — both shown escaped; 1.
fn _dep_refuse_src_link(dep, rel, link): i64 {
    _ew("error: [deps.");
    _ew_shown(dep);
    _ew("] ");
    _ew_shown(rel);
    _ew(" passes through a symlink (");
    _ew_shown(link);
    _ew(") — a dependency's files are read only from inside its own tree; refused\n");
    return 1;
}

# 6.6.17 — the git-dep cache key: `<base>/<name>/<tag>`, and `<base>/<name>/.untagged` for an
# untagged dep (the remote's default branch). The untagged clone used to live at
# `<name>/main`, the very dir a `tag = "main"` dep resolves to, so whichever ran first served
# the other: the branch's bytes vendored for an untagged dep, or the default-branch clone
# refused as a "tampered cache" for the tagged one. A `.`-led component is one
# `_dep_reject_unsafe_tag` refuses in every tag, so no tag can name the untagged key. <base>
# is `<home>/deps`, else the run's private temp dir (whose flat `<name>_<tag>` had the same
# collision: `[deps.a_b]` untagged against `[deps.a] tag = "b"`); both levels are created here.
fn _dep_clone_dir(name, tag): i64 {
    var base = 0;
    if (_home != 0) { base = _cat2(_home, "/deps"); } else { base = _cbt_tmpfile("deps"); }
    sys_mkdir(base, 0x1ED);
    var nd = _cat2(_cat2(base, "/"), name);
    sys_mkdir(nd, 0x1ED);
    var key = tag;
    if (key == 0) { key = ".untagged"; }
    return _cat2(_cat2(nd, "/"), key);
}

# A manifest string as it may be shown: `s` itself when every byte prints, else a fresh copy
# with each non-printing byte (below 32, 127 and up) as `\xNN`, so an error line cannot carry a
# terminal escape sequence (or a forged line) out of a hostile manifest. The ONE escaping rule
# for manifest strings echoed in errors (CVE-76's tag printer, generalised at 6.6.20).
fn _shown(s): i64 {
    var i = 0;
    var c = load8(s);
    while (c != 0) {
        if (c < 32 || c >= 127) { break; }
        i = i + 1;
        c = load8(s + i);
    }
    if (c == 0) { return s; }
    var hx = "0123456789abcdef";
    var sb = str_builder_new();
    i = 0;
    c = load8(s);
    while (c != 0) {
        if (c < 32 || c >= 127) {
            str_builder_add_cstr(sb, "\\x");
            str_builder_add_byte(sb, load8(hx + (c >> 4)));
            str_builder_add_byte(sb, load8(hx + (c & 15)));
        } else {
            str_builder_add_byte(sb, c);
        }
        i = i + 1;
        c = load8(s + i);
    }
    return str_data(str_builder_build(sb));
}

# _shown, written to stderr.
fn _ew_shown(s): i64 {
    _ew(_shown(s));
    return 0;
}

# v6.2.50 (deps lever 1 / Phase C — module-granular extraction): read a module's
# dep line `<mod> = [...]` from a `dist/<pkg>/index.cyml`, returning the dep vec
# (sibling-module names + `lib:<leaf>` entries) or 0 if absent.
fn _dep_read_index_deps(index_path, submod): i64 {
    if (file_exists(index_path) == 0) { return 0; }
    var sz = _file_size(index_path);
    if (sz <= 0) { return 0; }
    var buf = alloc(sz + 1);
    var nn = file_read_all(index_path, buf, sz);
    if (nn <= 0) { return 0; }
    store8(buf + nn, 0);
    var ml = strlen(submod);
    var i = 0;
    while (i < nn) {
        var ls = i;
        while (ls < nn && (load8(buf + ls) == 32 || load8(buf + ls) == 9)) { ls = ls + 1; }
        if (ls + ml < nn && memeq(buf + ls, submod, ml) == 1) {
            var c = load8(buf + ls + ml);
            if (c == 32 || c == 61) {   # key boundary: `<mod> ` or `<mod>=`
                return _parse_toml_str_array(buf, nn, ls + ml);
            }
        }
        while (i < nn && load8(buf + i) != 10) { i = i + 1; }
        if (i < nn) { i = i + 1; }
    }
    return 0;
}

# v6.2.50 Phase C: pull ONE modular sub-module `<dep_src>/dist/<pkg>/<mod>.cyr` +
# its transitive deps (from the index) into the consumer's lib/, in topological
# order. `lib:<leaf>` index entries resolve as stdlib leaves; bare names are
# sibling sub-modules (recursed). `seen` dedups + breaks cycles. Deps are pulled
# BEFORE the module so its `include` lands after theirs in `_dep_includes`.
fn _dep_pull_submodule(dep_src, pkg, submod, stdlib_dir, seen): i64 {
    # CVE-32: traversal guard, BEFORE any fs op — a sub-module name becomes `dist/<pkg>/<mod>.cyr`
    # and `lib/<pkg>_<mod>.cyr`, so it takes the dep-NAME rule (no `/` at all), named here.
    if (_dep_name_unsafe(submod) == 1) {
        _ew("error: [deps.");
        _ew_shown(pkg);
        _ew("] modular sub-module '");
        _ew_shown(submod);
        _ew("' is not a usable name (empty, `.`-led, or holding `/`, `\\`, `..` or a control byte) — refused\n");
        return 1;
    }
    if (_dep_list_has(seen, submod) == 1) { return 0; }
    vec_push(seen, submod);
    var errs = 0;
    var ip_sb = str_builder_new();
    str_builder_add_cstr(ip_sb, dep_src);
    str_builder_add_cstr(ip_sb, "/dist/");
    str_builder_add_cstr(ip_sb, pkg);
    str_builder_add_cstr(ip_sb, "/index.cyml");
    var ip = str_data(str_builder_build(ip_sb));
    var dsl = strlen(dep_src);
    var ilk = _dep_src_link(ip, dsl);   # 6.6.20 (CVE-TBD): read only from inside the dep's tree
    if (ilk != 0) { return _dep_refuse_src_link(pkg, ip + dsl + 1, ilk); }
    var deps = _dep_read_index_deps(ip, submod);
    if (deps != 0) {
        var di = 0;
        while (di < vec_len(deps)) {
            var d = vec_get(deps, di);
            if (strlen(d) > 4 && memeq(d, "lib:", 4) == 1) {
                # CVE-32: an index-controlled leaf name. 6.6.20: by the LEAF rule — this used the
                # dep-name rule, which refuses `/`, so `lib:unicode/categories` (what distlib
                # --modular writes) was refused as path traversal.
                if (_dep_leaf_ok(d + 4) == 0) {
                    _dep_refuse_leaf("the modular index of ", pkg, d + 4);
                    errs = errs + 1;
                } elif (stdlib_dir != 0) {
                    _dep_note_nd_leaf(d + 4);
                    if (_dep_copy_stdlib_recursive(stdlib_dir, d + 4, 1) == 1) { errs = errs + 1; }
                }
            } else {
                errs = errs + _dep_pull_submodule(dep_src, pkg, d, stdlib_dir, seen);
            }
            di = di + 1;
        }
    }
    # copy `<dep_src>/dist/<pkg>/<mod>.cyr` → `lib/<pkg>_<mod>.cyr`
    var src_sb = str_builder_new();
    str_builder_add_cstr(src_sb, dep_src);
    str_builder_add_cstr(src_sb, "/dist/");
    str_builder_add_cstr(src_sb, pkg);
    str_builder_add_cstr(src_sb, "/");
    str_builder_add_cstr(src_sb, submod);
    str_builder_add_cstr(src_sb, ".cyr");
    var src = str_data(str_builder_build(src_sb));
    var df_sb = str_builder_new();
    str_builder_add_cstr(df_sb, "lib/");
    str_builder_add_cstr(df_sb, pkg);
    str_builder_add_cstr(df_sb, "_");
    str_builder_add_cstr(df_sb, submod);
    str_builder_add_cstr(df_sb, ".cyr");
    var dst_full = str_data(str_builder_build(df_sb));
    # 6.6.11 (S2): a modular sub-module of a package that is a stdlib leaf here.
    var _kf = _dep_keep_fold_over_profile(pkg, dst_full, submod);
    if (_kf < 0) { return errs + 1; }
    if (_kf == 1) { return errs; }
    # v6.5.37 (A0) — refuse BEFORE the unlink. A symlinked destination must not be
    # deleted either: unlink on a link removes the link, but the guard exists so a
    # vendoring run cannot touch a shared target at all, and a delete-then-refuse
    # leaves the tree worse than either outcome alone.
    if (_dep_vendor_mode == 1) {
        var _l1 = _dep_dest_is_linked(dst_full);
        if (_l1 != 0) { return _dep_refuse_symlinked_dest(_l1); }
    }
    var slk = _dep_src_link(src, dsl);   # 6.6.20 (CVE-TBD): checked before the unlink
    if (slk != 0) { return errs + _dep_refuse_src_link(pkg, src + dsl + 1, slk); }
    sys_unlink(dst_full);
    var cr = _dep_copy_file(src, dst_full);
    if (cr == 0 || cr == 2) {
        vec_push(_dep_includes, dst_full);
        vec_push(_dep_nd_modules, dst_full);   # 6.6.9: a named dep's module (distlib verify)
    } elif (cr == 1) {
        sys_write(STDERR_FD, "error: modular sub-module ", 26);
        _ew_shown(pkg);
        sys_write(STDERR_FD, ":", 1);
        _ew_shown(submod);
        sys_write(STDERR_FD, " not found in dist/\n", 20);
        errs = errs + 1;
    }
    return errs;
}

# v5.7.14: returns 1 if `name` is already in _dep_visited, else 0.
fn _dep_name_visited(name): i64 {
    if (_dep_visited == 0) { return 0; }
    var i = 0;
    var nl = strlen(name);
    while (i < vec_len(_dep_visited)) {
        var v = vec_get(_dep_visited, i);
        if (strlen(v) == nl) {
            if (memeq(v, name, nl) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# v5.7.14: join a manifest-relative `path = "..."` to the manifest's
# directory. Returns `rel` unchanged if absolute.
fn _dep_join_path(manifest_dir, rel): i64 {
    if (load8(rel) == 47) { return rel; }
    var ml = strlen(manifest_dir);
    var rl = strlen(rel);
    var out = alloc(ml + 1 + rl + 1);
    memcpy(out, manifest_dir, ml);
    store8(out + ml, 47);
    memcpy(out + ml + 1, rel, rl);
    store8(out + ml + 1 + rl, 0);
    return out;
}

# The NAME of the `[deps.NAME]` table header `_toml_line` parsed into `info`, as a fresh cstr
# (`[ deps.x ]` and `[deps.x ]` read as `x`); 0 for any other line. *closedp = 0 when the header
# has no `]` on its line. The ONE header rule: the resolver, `deps --dry-run` and distlib's
# named-dep set all read headers through it, so they cannot disagree about which tables exist.
fn _dep_hdr_name(buf, n, info, closedp): i64 {
    if (load64(info) != 1) { return 0; }
    var hs = load64(info + 8);
    var hl = load64(info + 16);
    if (hl < 5 || memeq(buf + hs, "deps.", 5) == 0) { return 0; }
    var p = hs + hl;
    while (p < n && (load8(buf + p) == 32 || load8(buf + p) == 9)) { p = p + 1; }
    store64(closedp, 0);
    if (p < n && load8(buf + p) == 93) { store64(closedp, 1); }
    var nl = hl - 5;
    var nm = alloc(nl + 1);
    memcpy(nm, buf + hs + 5, nl);
    store8(nm + nl, 0);
    return nm;
}

fn _dep_refuse_unclosed(name): i64 {
    _ew("error: [deps.");
    _ew_shown(name);
    _ew(" has no closing `]` on its line — not a table header; section refused\n");
    return 1;
}

# 1 when the key buf[ks..ks+kl) is exactly `key`.
fn _dep_key_is(buf, ks, kl, key): i64 {
    if (kl != strlen(key)) { return 0; }
    return memeq(buf + ks, key, kl);
}

# The bareword at buf[p]: 1 for `true`, 0 for `false`, -1 for anything else.
fn _dep_bareword_bool(buf, n, p): i64 {
    if (p + 4 <= n && memeq(buf + p, "true", 4) == 1 && _toml_tok_end(buf, n, p + 4) == 1) { return 1; }
    if (p + 5 <= n && memeq(buf + p, "false", 5) == 1 && _toml_tok_end(buf, n, p + 5) == 1) { return 0; }
    return 0 - 1;
}

# The string list whose VALUE starts at buf[v] (a `_toml_find` / `_toml_line` value offset): an
# array of strings, or one string as a one-element list (both as `_parse_toml_str_array` reads
# them from a key).
fn _dep_strs_at(buf, n, v): i64 {
    if (v < n && (load8(buf + v) == 34 || load8(buf + v) == 39)) {
        var one = vec_new();
        var e = 0;
        var s = _toml_str_at(buf, n, v, &e);
        if (s != 0) { vec_push(one, s); }
        return one;
    }
    return _parse_toml_str_array(buf, n, v);
}

# `[deps] stdlib` as a vec of leaf names, or 0 when the key is absent. Through the one reader, so
# a `stdlib` in prose, in a quoted or multi-line value, or in another table is never the key —
# the byte scan this replaced (cmd_deps, `lib sync`) took a `"""` description holding
# `stdlib = ["math"]` for the real key. CHANGELOG [6.6.20].
fn _dep_declared_stdlib(buf, n): i64 {
    var v = _toml_find(buf, n, "deps", "stdlib");
    if (v < 0) { return 0; }
    return _dep_strs_at(buf, n, v);
}

# `[<section>]`'s `name = ["a", …]` entries into parallel vecs (`names`, `lists`), through the one
# reader — `[groups]` and `[features]`. A value that is not an array is not an entry.
fn _dep_parse_name_lists(buf, n, section, names, lists): i64 {
    var keys = _toml_section_keys(buf, n, section);
    var i = 0;
    while (i < vec_len(keys)) {
        var k = vec_get(keys, i);
        i = i + 1;
        var v = _toml_find(buf, n, section, k);
        if (v >= 0 && v < n && load8(buf + v) == 91) {
            vec_push(names, k);
            vec_push(lists, _parse_toml_str_array(buf, n, v));
        }
    }
    return 0;
}

# v5.7.14: process [deps.X] sections in `buf` (manifest content of
# length `n`). `manifest_dir` is the absolute directory containing
# the manifest; relative `path = "..."` entries resolve against it.
# Successfully-resolved deps' names go into _dep_visited (closest-
# wins de-dup), and their resolved dirs go into _dep_queue for the
# transitive walk in cmd_deps. Returns errors count for this manifest.
fn _process_named_deps(buf, n, manifest_dir): i64 {
    var errors = 0;
    var info[32];
    var si = 0;
    while (si < n) {
        # 6.6.20: the section walk is on the one reader (`_toml_line`, cbt/manifest.cyr) — headers
        # and keys whole, indented or not, never inside a multi-line value. This was a private
        # column-0 scan: an indented `tag` was dropped (unpinned HEAD vendored), `[ deps.x ]`
        # ignored, a `[deps.x]` inside a `"""` description resolved, and a later `[docs]` /
        # `[[bin]]` key read as the dep's own.
        si = _toml_line(buf, n, si, &info);
        var hclosed = 0;
        var dep_name = _dep_hdr_name(buf, n, &info, &hclosed);
        if (dep_name != 0) {
            # A header with no `]` on its line: the old scan ran its NAME across the newline.
            if (hclosed == 0) {
                _dep_refuse_unclosed(dep_name);
                errors = errors + 1;
                continue;
            }
            # CVE-62 (6.6.13): the header NAME becomes a path — the clone dir
            # `<home>/deps/<name>/<tag>` (mkdir + git clone), the `lib/<name>_<base>`
            # destination, and the `dist/<name>.cyr` default. CVE-32 (v6.2.51) guarded
            # the sub-module / index / package names and never this one, so a manifest
            # — the consumer's or any TRANSITIVE dep's — naming `[deps.../../x]` made
            # `cyrius deps` mkdir and clone OUTSIDE `<home>/deps`. Refused before any
            # path is derived; the rest of the section is skipped by the outer scan.
            # 6.6.20 (CVE-TBD): `[deps.]` / `[deps..]` / `[deps..x]`, `\` and control bytes too
            # (_dep_name_unsafe) — the empty and dot names aliased ANOTHER dep's cache root.
            if (_dep_name_unsafe(dep_name) == 1) {
                _dep_refuse_name(dep_name);
                errors = errors + 1;
                continue;
            }
            # v5.7.14: closest-wins skip — the outer walk steps over the section's keys.
            if (_dep_name_visited(dep_name) == 1) { continue; }
            var dep_path = 0;
            var dep_git = 0;
            var dep_tag = 0;
            var dep_modules = 0;
            var dep_requires = 0;
            var dep_modular = 0;   # v6.2.50 Phase C: sub-modules from dist/<name>/
            var dep_optional = 0;  # v6.3.1 lever 2: resolve only when an active feature names this dep
            var dep_target = 0;    # v6.3.1 lever 2: resolve only on a matching build target
            var dep_bad = 0;       # 6.6.17 (m6): the key whose value is not a TOML string
            # CVE-21 (v6.2.30): cleared if a tagged dep's resolved commit
            # disagrees with the lock — gates the module copy so poisoned
            # content never lands in lib/.
            var dep_pin_ok = 1;
            # The section's `key = value` lines, up to the next table header of either kind,
            # dispatched on the WHOLE key. path / git / tag / target are TOML strings (6.6.17,
            # m6: a value that is not one refuses the section by name, `dep_bad`); modules /
            # requires / modular are string arrays; optional is the bareword `true` or `false`.
            while (si < n) {
                var nx = _toml_line(buf, n, si, &info);
                var kind = load64(&info);
                if (kind == 1 || kind == 2) { break; }
                si = nx;
                if (kind == 3) {
                    var ks = load64(&info + 8);
                    var kl = load64(&info + 16);
                    var kv = load64(&info + 24);
                    var ke = 0;
                    if (_dep_key_is(buf, ks, kl, "path") == 1) {
                        dep_path = _toml_str_at(buf, n, kv, &ke);
                        if (dep_path == 0) { dep_bad = "path"; }
                        # v5.7.14: resolve relative `path = "..."` against
                        # the manifest's directory, not the consumer's cwd.
                        else { dep_path = _dep_join_path(manifest_dir, dep_path); }
                    } elif (_dep_key_is(buf, ks, kl, "git") == 1) {
                        dep_git = _toml_str_at(buf, n, kv, &ke);
                        if (dep_git == 0) { dep_bad = "git"; }
                    } elif (_dep_key_is(buf, ks, kl, "tag") == 1) {
                        dep_tag = _toml_str_at(buf, n, kv, &ke);
                        if (dep_tag == 0) { dep_bad = "tag"; }
                    } elif (_dep_key_is(buf, ks, kl, "target") == 1) {
                        # v6.3.1 lever 2: resolve this dep only on a matching build target
                        # (see `_dep_target_matches`).
                        dep_target = _toml_str_at(buf, n, kv, &ke);
                        if (dep_target == 0) { dep_bad = "target"; }
                    } elif (_dep_key_is(buf, ks, kl, "modules") == 1) {
                        dep_modules = _parse_toml_str_array(buf, n, ks + kl);
                    } elif (_dep_key_is(buf, ks, kl, "requires") == 1) {
                        # v6.2.46 (lever 1 / Phase A): the stdlib leaves a fold needs in scope,
                        # pulled below ahead of this dep's modules.
                        dep_requires = _parse_toml_str_array(buf, n, ks + kl);
                        dep_requires = _dep_expand_groups(dep_requires);   # v6.2.49 Phase B: expand [groups] refs
                    } elif (_dep_key_is(buf, ks, kl, "modular") == 1) {
                        # v6.2.50 Phase C: individual sub-modules from the dep's `dist/<name>/`
                        # (each + its transitive index deps + lib leaves) instead of `modules`.
                        dep_modular = _parse_toml_str_array(buf, n, ks + kl);
                    } elif (_dep_key_is(buf, ks, kl, "optional") == 1) {
                        # v6.3.1 lever 2: resolve only when an active `[features]` set names
                        # this dep (`_dep_feature_active`). The whole bareword: this read the
                        # first byte, so `tru` (or `t-anything`) meant true.
                        dep_optional = _dep_bareword_bool(buf, n, kv);
