# ================================================================
# Dependency resolution: cyrius deps
# ================================================================
# Reads cyrius.cyml (or cyrius.toml fallback), resolves:
#   [deps] stdlib = ["string", "fmt", ...] → copy from cyrius stdlib
#   [deps.name] path = "../repo" modules = ["src/foo.cyr"] → copy from sibling
# All deps land in lib/ (created if needed).

fn _file_size(path): i64 {
    var stat_buf[144];
    var r = syscall(4, path, &stat_buf);
    if (r != 0) { return 0 - 1; }
    # st_size offset differs by platform. Linux struct stat puts it at
    # byte 48. The raw Darwin stat syscall (SYS_stat 188) fills the LEGACY
    # 32-bit-inode struct stat — st_size lands at byte 72 (NOT the SDK
    # INODE64 layout's 96; the libc wrapper, not the raw syscall, produces
    # that). Reading the wrong offset on Darwin returned garbage / 0, which
    # truncated the stdlib include-scan read → transitive deps silently
    # dropped on macOS (io copied without its syscalls/result chain).
    # Verified by dumping the struct on ecb (size@72). See CHANGELOG [6.0.41].
    #ifdef CYRIUS_TARGET_MACOS
    return load64(&stat_buf + 72);
    #else
    return load64(&stat_buf + 48);
    #endif
}

# Resolve a (possibly relative) path to absolute using getcwd(2).
# Needed for symlink creation: a relative symlink target is resolved
# relative to the SYMLINK's parent directory, not the caller's CWD.
# When we write `lib/{dep}.cyr -> ../sigil/dist/sigil.cyr`, that resolves
# to `{proj}/sigil/dist/sigil.cyr` (wrong) instead of `{sibling}/sigil/...`.
# Fix: make every symlink target absolute. Absolute paths are unambiguous.
# Returns src unchanged if already absolute, else allocates an absolute copy.
fn _abs_path(src): i64 {
    if (load8(src) == 47) { return src; }
    var cwd[4096];
    var cwd_len = 0;
    #ifdef CYRIUS_TARGET_MACOS
    # Darwin has NO getcwd syscall (slot 326 is unused → SIGSYS). Derive
    # the cwd from the "." fd via fcntl(F_GETPATH): open(".") then
    # fcntl(fd, F_GETPATH=50, buf) writes the absolute path, returns 0/-1.
    # x86 syscall nums (ESYSXLAT renumbers): open 2→5, fcntl 72→92,
    # close 3→6. See CHANGELOG [6.0.41].
    var fd = syscall(2, ".", 0, 0);
    if (fd < 0) { return src; }
    var fr = syscall(72, fd, 50, &cwd);
    syscall(3, fd);
    if (fr != 0) { return src; }
    while (load8(&cwd + cwd_len) != 0) { cwd_len = cwd_len + 1; }
    #else
    # syscall 79 = getcwd(buf, size); returns length incl. nul, or -errno.
    # (aarch64-Linux: ESYSXLAT renumbers x86 79 → aarch64 getcwd 17.)
    var n = syscall(79, &cwd, 4096);
    if (n <= 0) { return src; }
    # Strip trailing nul from length
    cwd_len = n - 1;
    #endif
    var src_len = 0;
    while (load8(src + src_len) != 0) { src_len = src_len + 1; }
    var out = alloc(cwd_len + 1 + src_len + 1);
    var oi = 0;
    var ci = 0;
    while (ci < cwd_len) {
        store8(out + oi, load8(&cwd + ci));
        oi = oi + 1;
        ci = ci + 1;
    }
    store8(out + oi, 47);  # '/'
    oi = oi + 1;
    var si = 0;
    while (si < src_len) {
        store8(out + oi, load8(src + si));
        oi = oi + 1;
        si = si + 1;
    }
    store8(out + oi, 0);
    return out;
}

fn _dep_copy_file(src, dst): i64 {
    # Skip if destination exists and same size (already resolved)
    var src_sz = _file_size(src);
    var dst_sz = _file_size(dst);
    if (src_sz > 0 && src_sz == dst_sz) { return 2; }
    # CVE-04: reject dep writes outside lib/ (path traversal)
    var di = 0;
    while (load8(dst + di) != 0) {
        if (load8(dst + di) == 46 && load8(dst + di + 1) == 46) {
            sys_write(STDERR_FD, "  error: path traversal in dep destination: ", 44);
            sys_write(STDERR_FD, dst, strlen(dst));
            sys_write(STDERR_FD, "\n", 1);
            return 1;
        }
        di += 1;
    }
    # v5.8.49: mkdir-p any intermediate directories in dst so subdir-
    # nested stdlib modules (e.g. `lib/unicode/categories.cyr`) can be
    # written. Before this fix, sys_open with O_CREAT failed with ENOENT
    # when the parent dir did not exist, silently dropping subdir-stdlib
    # files at consumer-side `cyrius deps` resolution. Loop walks dst
    # char-by-char; whenever we hit `/`, mkdir the prefix up to that
    # slash (0o755). sys_mkdir returns -EEXIST harmlessly on already-
    # present dirs — same idiom used by sys_mkdir("lib", ...) callers
    # above and below.
    var dst_len = strlen(dst);
    var prefix_buf = alloc(dst_len + 1);
    var pi = 0;
    while (pi < dst_len) {
        if (load8(dst + pi) == 47) {   # '/'
            memcpy(prefix_buf, dst, pi);
            store8(prefix_buf + pi, 0);
            sys_mkdir(prefix_buf, 0x1ED);
        }
        pi = pi + 1;
    }
    var sfd = sys_open(src, O_RDONLY, 0);
    if (sfd < 0) {
        sys_write(STDERR_FD, "  error: cannot read ", 21);
        sys_write(STDERR_FD, src, strlen(src));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    var dfd = sys_open(dst, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (dfd < 0) {
        sys_close(sfd);
        sys_write(STDERR_FD, "  error: cannot write ", 22);
        sys_write(STDERR_FD, dst, strlen(dst));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    # Stream copy in 32KB chunks — handles files of any size
    var buf = alloc(32768);
    var total = 0;
    var go = 1;
    while (go == 1) {
        var n = syscall(0, sfd, buf, 32768);
        if (n <= 0) { go = 0; }
        else { syscall(1, dfd, buf, n); total = total + n; }
    }
    sys_close(sfd);
    sys_close(dfd);
    if (total == 0) { return 1; }
    return 0;
}

# Read `[package].cyrius = "X.Y.Z"` from cwd's cyrius.cyml.
# Returns a NUL-terminated cstr of the version, or 0 if the field
# is absent (the field is optional — only set in downstream repos
# that pin a specific toolchain version).
#
# Parser is intentionally minimal: scan to `[package]`, then walk
# lines until either `cyrius = "..."` is found or the next section
# header. Mirrors the pattern in cbt/pulsar.cyr::_pulsar_release_array
# for arrays; this variant returns a scalar string. See CHANGELOG
# [5.11.17].
fn _dep_read_cyml_cyrius_field(): i64 {
    if (file_exists("cyrius.cyml") == 0) { return 0; }
    var buf = alloc(32768);
    var n = file_read_all("cyrius.cyml", buf, 32767);
    if (n <= 0) { return 0; }
    # Locate [package] header
    var pos = 0;
    while (pos < n) {
        if (memeq(buf + pos, "[package]", 9) == 1) { break; }
        pos = pos + 1;
    }
    if (pos >= n) { return 0; }
    pos = pos + 9;
    # Walk lines until next section header
    while (pos < n) {
        while (pos < n && (load8(buf + pos) == 10 || load8(buf + pos) == 32 || load8(buf + pos) == 9)) {
            pos = pos + 1;
        }
        if (pos >= n) { return 0; }
        if (load8(buf + pos) == 91) { return 0; }  # `[` → next section
        if (memeq(buf + pos, "cyrius", 6) == 1) {
            var after = pos + 6;
            while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) {
                after = after + 1;
            }
            if (after < n && load8(buf + after) == 61) {
                after = after + 1;
                while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) {
                    after = after + 1;
                }
                if (after < n && load8(buf + after) == 34) {
                    after = after + 1;
                    var start = after;
                    while (after < n && load8(buf + after) != 34) { after = after + 1; }
                    var vlen = after - start;
                    var out = alloc(vlen + 1);
                    var i = 0;
                    while (i < vlen) { store8(out + i, load8(buf + start + i)); i = i + 1; }
                    store8(out + vlen, 0);
                    return out;
                }
            }
        }
        while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
    }
    return 0;
}

# v5.11.17 — stdlib_dir resolution order (Part 1 of per-repo
# isolation arc; Parts 2-3 at v5.11.23/24). Closes the snapshot-
# ping-pong wipe wedge that landed multiple times in the v5.11.x
# cycle (notably v5.11.3, v5.11.13). See CHANGELOG [5.11.17].
#
# Resolution priority:
#   (a) `./lib` when running inside the cyrius source repo
#       (signal: src/main.cyr present). Closes the cyrius-repo
#       ping-pong — the repo reads its own in-tree stdlib instead
#       of the mutable `~/.cyrius/lib` global symlink, so a
#       sibling agent's `cyriusly use <other>` can't wipe edits.
#   (b) `~/.cyrius/versions/<cyml-cyrius-field>/lib/` when the
#       consumer's cyrius.cyml pins `[package].cyrius = "X.Y.Z"`
#       AND that version is installed. Isolates downstream repos
#       from the global pointer.
#   (c) `~/.cyrius/lib` legacy fallback for consumers without a
#       cyrius pin (existing behavior, unchanged).
# Hard-error (not silent fallback) when cyml pins a version that
# is NOT installed.
# Cross-platform "does this dir hold the stdlib" check. `is_dir`
# (lib/fs.cyr) probes via getdents64 (Linux syscall 217), which Darwin
# does NOT provide (it uses getdirentries with a different ABI; .34's
# ESYSXLAT doesn't cover 217) — so on arm64 macOS `is_dir` false-negatives
# a directory that demonstrably exists. That made the pinned-version
# install-probe below reject a valid snapshot, so every consumer manifest
# with a `cyrius =` pin AND `[deps] stdlib` failed to build on Darwin
# (ai-hwaccel 2.3.6 blocked; issue 2026-06-02-macos-arm64-deps-stdlib-pin-check).
# `file_exists` is open()-based and works on Darwin; checking for a
# canonical always-present stdlib file confirms the dir exists AND holds
# the stdlib. See CHANGELOG [6.0.40].
fn _dep_dir_has_stdlib(dir_cstr): i64 {
    return file_exists(make_path(dir_cstr, "syscalls.cyr"));
}

fn _dep_find_stdlib_dir(): i64 {
    # (a) cyrius source-repo dev mode: `./lib` if we're in the
    # cyrius repo itself (signaled by src/main.cyr existing). The
    # `./lib` check has to come AFTER the src/main.cyr check —
    # downstream repos sometimes have a `./lib` directory of
    # resolved deps but no src/main.cyr.
    if (file_exists("src/main.cyr") == 1) {
        if (_dep_dir_has_stdlib("./lib") == 1) { return "./lib"; }
    }

    # (b) cyrius.cyml-pinned version → per-repo isolation
    var pin = _dep_read_cyml_cyrius_field();
    if (pin != 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, _home);
        str_builder_add_cstr(sb, "/versions/");
        str_builder_add_cstr(sb, pin);
        str_builder_add_cstr(sb, "/lib");
        var pinned_lib = str_data(str_builder_build(sb));
        if (_dep_dir_has_stdlib(pinned_lib) == 1) { return pinned_lib; }
        # Pinned version not installed → hard error per acceptance bar
        sys_write(STDERR_FD, "error: cyrius.cyml pins version ", 32);
        sys_write(STDERR_FD, pin, strlen(pin));
        sys_write(STDERR_FD, " but it is not installed at ", 28);
        sys_write(STDERR_FD, pinned_lib, strlen(pinned_lib));
        sys_write(STDERR_FD, "\n  run: cyrius install ", 23);
        sys_write(STDERR_FD, pin, strlen(pin));
        sys_write(STDERR_FD, "\n", 1);
        sys_exit(1);
    }

    # (c) legacy fallback — `~/.cyrius/lib` global symlink
    var installed = make_path(_home, "lib");
    if (_dep_dir_has_stdlib(installed) == 1) { return installed; }
    # Dev mode without a cyrius repo signal (rare): `./lib`
    if (_dep_dir_has_stdlib("./lib") == 1) { return "./lib"; }
    return 0;
}

# v5.10.19 — transitive include resolution for stdlib modules.
#
# Pre-fix, `cyrius deps` copied only the directly-named stdlib
# files (`stdlib = ["syscalls", "process", ...]`) and ignored
# the `include "lib/X.cyr"` directives INSIDE those files. Most
# stdlib modules are leaf files, so this worked — except for
# a handful of arch-dispatcher modules:
#
#   lib/syscalls.cyr → includes lib/syscalls_x86_64_linux.cyr
#                              + lib/syscalls_aarch64_linux.cyr
#                              + lib/syscalls_windows.cyr
#   lib/alloc.cyr    → includes lib/alloc_macos.cyr
#                              + lib/alloc_windows.cyr
#
# A consumer that listed `"syscalls"` in `[deps] stdlib`
# received `lib/syscalls.cyr` only; cyrius's source compile
# then failed at `include "lib/syscalls_x86_64_linux.cyr"` —
# missing file → SYS_* / O_* / fn names defined in the peer
# went undefined → cascading "unexpected unknown" /
# "undefined variable 'SYS_CLOSE'" diagnostics.
#
# In-tree consumers (cyrius's own `programs/checks/`)
# dodged because the dev-mode `./lib` path resolves the
# whole repo lib/ tree at once. agnosys 1.1.13 surfaced the
# gap on CI which uses the installed `~/.cyrius/lib` snapshot.
#
# Fix: scan each copied file for `include "lib/X.cyr"` (or
# `include "lib/sub/X.cyr"`) and recursively copy referenced
# files — same path-relative shape, same `_dep_copy_file`
# call, but breadcrumbed via `_dep_stdlib_seen` so cycles
# (none today, but the dispatcher pattern courts them) and
# repeat-copies are skipped. Visited set is per-`cmd_deps`
# invocation; reset at every call.
var _dep_stdlib_seen = 0;
var _dep_group_names = 0;     # v6.2.49 Phase B: [groups] names (parallel to members)
var _dep_group_members = 0;   # v6.2.49 Phase B: [groups] member lists
var _dep_feature_names = 0;   # v6.3.1 lever 2: [features] feature names (parallel to deps)
var _dep_feature_deps = 0;    # v6.3.1 lever 2: per-feature member lists (deps and/or features)

fn _dep_stdlib_seen_init(): i64 {
    _dep_stdlib_seen = vec_new();
    return 0;
}

fn _dep_stdlib_seen_has(name): i64 {
    if (_dep_stdlib_seen == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (i < vec_len(_dep_stdlib_seen)) {
        var v = vec_get(_dep_stdlib_seen, i);
        if (strlen(v) == nl) { if (memeq(v, name, nl) == 1) { return 1; } }
        i = i + 1;
    }
    return 0;
}

fn _dep_stdlib_seen_add(name): i64 {
    var nl = strlen(name);
    var dup = alloc(nl + 1);
    memcpy(dup, name, nl);
    store8(dup + nl, 0);
    vec_push(_dep_stdlib_seen, dup);
    return 0;
}

# Copy stdlib module `mod_name` (e.g. "syscalls" or
# "syscalls_x86_64_linux"), then scan its content for
# `include "lib/X.cyr"` directives and recursively copy
# those too. Uses `_dep_stdlib_seen` to short-circuit
# repeats.
#
# `is_top` flag: 1 for the consumer-named module
# (gets pushed onto `_dep_includes` so `compile()`
# prepends an explicit `include "lib/<mod>.cyr"`), 0
# for transitive includes. Critical: pre-fix, every
# transitively-copied file was pushed onto
# `_dep_includes`. `compile()` then prepended each as
# an explicit `include`, which OVERRIDES the
# `#ifdef CYRIUS_TARGET_*` arch-dispatcher logic —
# both `lib/syscalls_x86_64_linux.cyr` AND
# `lib/syscalls_aarch64_linux.cyr` parsed
# simultaneously, fns defined twice, "duplicate fn"
# warnings cascading + binaries running with the
# wrong arch's syscall numbers. Top-level-only push
# preserves the dispatcher pattern.
fn _dep_copy_stdlib_recursive(stdlib_dir, mod_name, is_top): i64 {
    if (_dep_stdlib_seen_has(mod_name) == 1) { return 0; }
    _dep_stdlib_seen_add(mod_name);

    var sb = str_builder_new();
    str_builder_add_cstr(sb, stdlib_dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, mod_name);
    str_builder_add_cstr(sb, ".cyr");
    var src = str_data(str_builder_build(sb));

    # Directory-family expansion (v6.1.x): a bare family name like "unicode" is a
    # DIRECTORY (lib/unicode/*.cyr), not a single lib/unicode.cyr. When the
    # <name>.cyr source is absent but <stdlib_dir>/<name>/ is a directory, resolve
    # every .cyr inside it. Each accessor self-includes its data file, so the
    # transitive scan below still fixes ordering. Fixes downstream consumers
    # (e.g. niyama) declaring bare "unicode" in [deps].stdlib — previously this
    # errored "cannot read lib/unicode.cyr" and dropped the whole family.
    if (file_exists(src) == 0) {
        var dsb = str_builder_new();
        str_builder_add_cstr(dsb, stdlib_dir);
        str_builder_add_cstr(dsb, "/");
        str_builder_add_cstr(dsb, mod_name);
        var dir_path = str_builder_build(dsb);   # dir_list takes a Str, not a cstr
        var entries = dir_list(dir_path);
        if (entries != 0) {
            var n = vec_len(entries);
            var ei = 0;
            var expanded = 0;
            while (ei < n) {
                var es = vec_get(entries, ei);
                ei = ei + 1;
                var ed = str_data(es);
                var el = str_len(es);
                if (el >= 5) {
                    if (memeq(ed + el - 4, ".cyr", 4) == 1) {
                        var stem = el - 4;
                        var subbuf = str_builder_new();
                        str_builder_add_cstr(subbuf, mod_name);
                        str_builder_add_cstr(subbuf, "/");
                        var stemc = alloc(stem + 1);
                        memcpy(stemc, ed, stem);
                        store8(stemc + stem, 0);
                        str_builder_add_cstr(subbuf, stemc);
                        var sub_name = str_data(str_builder_build(subbuf));
                        _dep_copy_stdlib_recursive(stdlib_dir, sub_name, is_top);
                        expanded = 1;
                    }
                }
            }
            if (expanded == 1) { return 0; }
        }
    }

    var dst = make_path("lib", mod_name);
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, dst);
    str_builder_add_cstr(sb2, ".cyr");
    var dst_full = str_data(str_builder_build(sb2));

    var cr = _dep_copy_file(src, dst_full);
    if (cr == 1) { return 1; }
    if (is_top == 1) { vec_push(_dep_includes, dst_full); }

    # Scan the just-copied source for `include "lib/X.cyr"`
    # directives. Open the SOURCE (not destination — same
    # bytes; src guaranteed readable since copy succeeded).
    var sfd = sys_open(src, O_RDONLY, 0);
    if (sfd < 0) { return 0; }
    var sz = _file_size(src);
    if (sz <= 0) { sys_close(sfd); return 0; }
    var fbuf = alloc(sz + 1);
    var nread = syscall(0, sfd, fbuf, sz);
    sys_close(sfd);
    if (nread <= 0) { return 0; }
    store8(fbuf + nread, 0);

    # Walk for `include "lib/`. Tolerate any leading whitespace
    # but skip lines starting with `#` (commented-out includes
    # in retro/historical comments shouldn't drag deps in).
    var pos = 0;
    while (pos < nread) {
        var ls = pos;
        # End-of-line
        var le = pos;
        while (le < nread && load8(fbuf + le) != 10) { le = le + 1; }
        # Trim leading whitespace
        var lp = ls;
        while (lp < le) {
            var lc = load8(fbuf + lp);
            if (lc != 32 && lc != 9) { break; }
            lp = lp + 1;
        }
        # Comment line — skip
        if (lp < le && load8(fbuf + lp) != 35) {
            # Match `include "lib/`
            if (le - lp >= 13) {
                if (memeq(fbuf + lp, "include \"lib/", 13) == 1) {
                    var name_start = lp + 13;
                    var name_end = name_start;
                    while (name_end < le && load8(fbuf + name_end) != 34) {
                        name_end = name_end + 1;
                    }
                    if (name_end < le) {
                        var inc_len = name_end - name_start;
                        # Strip ".cyr" suffix (4 bytes) if present.
                        if (inc_len > 4) {
                            if (memeq(fbuf + name_end - 4, ".cyr", 4) == 1) {
                                inc_len = inc_len - 4;
                            }
                        }
                        var inc_name = alloc(inc_len + 1);
                        memcpy(inc_name, fbuf + name_start, inc_len);
                        store8(inc_name + inc_len, 0);
                        # Recursive fetch (transitive). Only if the
                        # source file actually exists in stdlib_dir —
                        # silently skip non-stdlib includes (consumer
                        # might `include "src/foo.cyr"` in stdlib if
                        # someone got creative; not our concern).
                        var probe_sb = str_builder_new();
                        str_builder_add_cstr(probe_sb, stdlib_dir);
                        str_builder_add_cstr(probe_sb, "/");
                        str_builder_add_cstr(probe_sb, inc_name);
                        str_builder_add_cstr(probe_sb, ".cyr");
                        var probe_path = str_data(str_builder_build(probe_sb));
                        if (file_exists(probe_path) == 1) {
                            # Transitive — is_top=0 so we copy the
                            # file but DON'T push to `_dep_includes`.
                            # The top-level dispatcher (`lib/syscalls.cyr`,
                            # `lib/alloc.cyr`) follows its own
                            # `include "lib/X.cyr"` chain at parse time
                            # gated by `#ifdef`.
                            _dep_copy_stdlib_recursive(stdlib_dir, inc_name, 0);
                        }
                    }
                }
            }
        }
        pos = le + 1;
    }
    return 0;
}

# Parse a TOML array of strings: ["a", "b", "c"] starting at buf[pos]
# Returns a vec of cstrings. Advances pos past the closing ].
fn _parse_toml_str_array(buf, len, pos): i64 {
    var result = vec_new();
    # Skip to [
    while (pos < len && load8(buf + pos) != 91) { pos = pos + 1; }
    pos = pos + 1;
    while (pos < len) {
        var c = load8(buf + pos);
        if (c == 93) { break; }
        if (c == 34) {
            pos = pos + 1;
            var start = pos;
            while (pos < len && load8(buf + pos) != 34) { pos = pos + 1; }
            var slen = pos - start;
            var s = alloc(slen + 1);
            memcpy(s, buf + start, slen);
            store8(s + slen, 0);
            vec_push(result, s);
            pos = pos + 1;
        } else {
            pos = pos + 1;
        }
    }
    return result;
}

# v6.3.1 (dependency-model arc, lever 2): split a comma-separated CLI value
# ("gpu,win-shell") into a vec<cstr> of feature names. Empty segments are
# dropped, so a trailing/leading comma is tolerated. Used by the cyrius.cyr
# pre-scan to parse `--features <list>` ahead of the dep resolver.
fn _split_csv(s): i64 {
    var out = vec_new();
    var sl = strlen(s);
    var i = 0;
    var start = 0;
    while (i <= sl) {
        if (i == sl || load8(s + i) == 44) {
            var seg = i - start;
            if (seg > 0) {
                var d = alloc(seg + 1);
                memcpy(d, s + start, seg);
                store8(d + seg, 0);
                vec_push(out, d);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

# v6.2.46/.47 (deps lever 1, Phase A): pull a vec of stdlib-leaf names into
# scope via the recursive stdlib resolver (is_top=1 → each leaf's
# `include "lib/<leaf>"` is pushed onto `_dep_includes`), deduped by
# `_dep_stdlib_seen`. FAIL-LOUD: a leaf that doesn't resolve returns the error
# count. Shared by the `requires` key (.46) and the `.deps` sidecar (.47).
# Caller must have inited `_dep_stdlib_seen` + resolved a non-0 `stdlib_dir`.
fn _dep_pull_leaves(stdlib_dir, dep_name, leaves): i64 {
    var errs = 0;
    var i = 0;
    while (i < vec_len(leaves)) {
        var leaf = vec_get(leaves, i);
        var r = _dep_copy_stdlib_recursive(stdlib_dir, leaf, 1);
        if (r == 1) {
            sys_write(STDERR_FD, "error: dep ", 11);
            sys_write(STDERR_FD, dep_name, strlen(dep_name));
            sys_write(STDERR_FD, " requires '", 11);
            sys_write(STDERR_FD, leaf, strlen(leaf));
            sys_write(STDERR_FD, "' but it is not in the cyrius stdlib\n", 37);
            errs = errs + 1;
        }
        i = i + 1;
    }
    return errs;
}

# v6.2.47 (deps lever 1, Phase A producer-side consumed): read a `cyrius
# distlib` sidecar (`dist/<pkg>.deps`) — one stdlib leaf per line, `#` comments
# + blank lines ignored, trailing CR/space trimmed — into a vec of leaf cstrs.
# Returns 0 (not a vec) when the file is absent/empty. Lets a consumer that
# declares just `[deps.<pkg>]` auto-pull the fold's leaves with no hand-authored
# `requires` key.
fn _dep_read_sidecar(path): i64 {
    if (file_exists(path) == 0) { return 0; }
    var sz = _file_size(path);
    if (sz <= 0) { return 0; }
    var buf = alloc(sz + 1);
    var n = file_read_all(path, buf, sz);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    var leaves = vec_new();
    var pos = 0;
    while (pos < n) {
        var ls = pos;
        while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
        var le = pos;
        if (pos < n) { pos = pos + 1; }
        var lp = ls;
        while (lp < le) {
            var c = load8(buf + lp);
            if (c != 32 && c != 9) { break; }
            lp = lp + 1;
        }
        if (lp < le && load8(buf + lp) != 35) {
            var ep = le;
            while (ep > lp) {
                var c2 = load8(buf + ep - 1);
                if (c2 != 32 && c2 != 9 && c2 != 13) { break; }
                ep = ep - 1;
            }
            var nl = ep - lp;
            if (nl > 0) {
                var leaf = alloc(nl + 1);
                memcpy(leaf, buf + lp, nl);
                store8(leaf + nl, 0);
                vec_push(leaves, leaf);
            }
        }
    }
    return leaves;
}

# v6.2.49 (deps lever 1 / Phase B — named module groupings): generic membership.
fn _dep_list_has(list, name): i64 {
    if (list == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (i < vec_len(list)) {
        var v = vec_get(list, i);
        if (strlen(v) == nl) { if (memeq(v, name, nl) == 1) { return 1; } }
        i = i + 1;
    }
    return 0;
}

# v6.2.49 Phase B: look up a `[groups]` name → its member vec, or 0 if not a group.
fn _dep_group_lookup(name): i64 {
    if (_dep_group_names == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (i < vec_len(_dep_group_names)) {
        var gn = vec_get(_dep_group_names, i);
        if (strlen(gn) == nl) { if (memeq(gn, name, nl) == 1) { return vec_get(_dep_group_members, i); } }
        i = i + 1;
    }
    return 0;
}

# v6.2.49 Phase B: expand one name into `out`. If it names a `[groups]` group,
# recurse over its members (groups may reference groups); else append the bare
# name (deduped). A self/mutual cycle is skipped via the `seen` guard.
fn _dep_expand_one(out, name, seen): i64 {
    var members = _dep_group_lookup(name);
    if (members == 0) {
        if (_dep_list_has(out, name) == 0) { vec_push(out, name); }
        return 0;
    }
    if (_dep_list_has(seen, name) == 1) { return 0; }   # cycle — skip
    vec_push(seen, name);
    var j = 0;
    while (j < vec_len(members)) {
        _dep_expand_one(out, vec_get(members, j), seen);
        j = j + 1;
    }
    return 0;
}

# v6.2.49 Phase B: expand any `[groups]` references in a name list (`[deps].stdlib`
# or a `[deps.NAME] requires`) into a flat, deduped list of leaf/dep names.
# Passthrough (returns the SAME vec) when no groups are defined, so non-`[groups]`
# manifests resolve byte-identical to before.
fn _dep_expand_groups(names): i64 {
    if (_dep_group_names == 0) { return names; }
    if (vec_len(_dep_group_names) == 0) { return names; }
    var out = vec_new();
    var seen = vec_new();
    var i = 0;
    while (i < vec_len(names)) {
        _dep_expand_one(out, vec_get(names, i), seen);
        i = i + 1;
    }
    return out;
}

# v6.2.49 Phase B: parse a `[groups]` section into `_dep_group_names` /
# `_dep_group_members` (parallel vecs). Each `name = ["a", "b", ...]` line defines
# a group that expands at resolve time wherever it's named in `[deps].stdlib` or a
# `[deps.NAME] requires` list. Members are whole stdlib-leaf / dep names (the
# `pkg:submodule` sub-unit form awaits Phase C). The section ends at the next
# `[...]` header. Multi-line arrays are handled — continuation lines carry no `[`
# so they're skipped; `_parse_toml_str_array` already consumed the whole array.
fn _dep_parse_groups(buf, n): i64 {
    _dep_group_names = vec_new();
    _dep_group_members = vec_new();
    var i = 0;
    var in_groups = 0;
    while (i < n) {
        var ls = i;
        while (ls < n && (load8(buf + ls) == 32 || load8(buf + ls) == 9)) { ls = ls + 1; }
        if (ls < n && load8(buf + ls) == 91) {   # '[' section header
            in_groups = 0;
            if (memeq(buf + ls, "[groups]", 8) == 1) { in_groups = 1; }
        } elif (in_groups == 1 && ls < n && load8(buf + ls) != 35 && load8(buf + ls) != 10) {
            var ne = ls;
            while (ne < n && load8(buf + ne) != 32 && load8(buf + ne) != 9 && load8(buf + ne) != 61 && load8(buf + ne) != 10) { ne = ne + 1; }
            var nl = ne - ls;
            if (nl > 0) {
                var bi = ne;
                while (bi < n && load8(buf + bi) != 91 && load8(buf + bi) != 10) { bi = bi + 1; }
                if (bi < n && load8(buf + bi) == 91) {
                    var gname = alloc(nl + 1);
                    memcpy(gname, buf + ls, nl);
                    store8(gname + nl, 0);
                    var gmembers = _parse_toml_str_array(buf, n, ne);
                    vec_push(_dep_group_names, gname);
                    vec_push(_dep_group_members, gmembers);
                }
            }
        }
        while (i < n && load8(buf + i) != 10) { i = i + 1; }
        if (i < n) { i = i + 1; }
    }
    return 0;
}

# v6.3.32 Phase D (modularity arc, lever-1 COMPLETION — dissolve the "stdlib"
# category): register the built-in `std` DEFAULT GROUP — the universal core stdlib
# leaves every real program pulls (matches the `cyrius init` template core). This
# makes `stdlib`/`requires` list a group like any other (`stdlib = ["std", <extras>]`)
# instead of hand-ordering the whole leaf set: `std` expands at resolve time via the
# Phase B `_dep_expand_groups` path (already applied to the stdlib list + `requires`).
# Registered AFTER `_dep_parse_groups` so a manifest that defines its OWN `std` group
# wins (override, not clobber). Member ORDER matches the init-template core so a
# `["std", …]` list resolves the SAME leaves in the SAME order as the explicit form
# → byte-identical. A manifest that never names `std` is unaffected (the expansion of
# a std-free list is dedup-in-order = identity).
fn _dep_register_default_std_group(): i64 {
    if (_dep_group_names == 0) { return 0; }              # parse_groups not run yet
    if (_dep_group_lookup("std") != 0) { return 0; }      # manifest defined its own `std`
    var m = vec_new();
    vec_push(m, "string");
    vec_push(m, "fmt");
    vec_push(m, "alloc");
    vec_push(m, "io");
    vec_push(m, "vec");
    vec_push(m, "str");
    vec_push(m, "syscalls");
    vec_push(_dep_group_names, "std");
    vec_push(_dep_group_members, m);
    return 0;
}

# v6.3.1 (dependency-model arc, lever 2 — required vs optional deps): parse a
# `[features]` table into `_dep_feature_names` / `_dep_feature_deps` (parallel
# vecs), structurally identical to `_dep_parse_groups`. Each `name = ["dep", ...]`
# line declares a feature whose members are optional-dep names and/or other
# feature names (recursively expanded by `_dep_feature_expand` at resolve time).
# The reserved `default = [...]` line is the set activated unless
# `--no-default-features` is passed. Section ends at the next `[...]` header.
# Absent `[features]` → empty vecs → no optional dep is ever activated (every
# pre-existing manifest resolves byte-identical). Parse-only here; the active-set
# computation + the skip gate live with the resolver (`_dep_feature_active`).
fn _dep_parse_features(buf, n): i64 {
    _dep_feature_names = vec_new();
    _dep_feature_deps = vec_new();
    var i = 0;
    var in_features = 0;
    while (i < n) {
        var ls = i;
        while (ls < n && (load8(buf + ls) == 32 || load8(buf + ls) == 9)) { ls = ls + 1; }
        if (ls < n && load8(buf + ls) == 91) {   # '[' section header
            in_features = 0;
            if (memeq(buf + ls, "[features]", 10) == 1) { in_features = 1; }
        } elif (in_features == 1 && ls < n && load8(buf + ls) != 35 && load8(buf + ls) != 10) {
            var ne = ls;
            while (ne < n && load8(buf + ne) != 32 && load8(buf + ne) != 9 && load8(buf + ne) != 61 && load8(buf + ne) != 10) { ne = ne + 1; }
            var nl = ne - ls;
            if (nl > 0) {
                var bi = ne;
                while (bi < n && load8(buf + bi) != 91 && load8(buf + bi) != 10) { bi = bi + 1; }
                if (bi < n && load8(buf + bi) == 91) {
                    var fname = alloc(nl + 1);
                    memcpy(fname, buf + ls, nl);
                    store8(fname + nl, 0);
                    var fmembers = _parse_toml_str_array(buf, n, ne);
                    vec_push(_dep_feature_names, fname);
                    vec_push(_dep_feature_deps, fmembers);
                }
            }
        }
        while (i < n && load8(buf + i) != 10) { i = i + 1; }
        if (i < n) { i = i + 1; }
    }
    return 0;
}

# v6.3.1 lever 2: look up a `[features]` name → its member vec, or 0 if `name`
# is not a declared feature (then it's treated as a bare dep name by the caller).
fn _dep_feature_lookup(name): i64 {
    if (_dep_feature_names == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (i < vec_len(_dep_feature_names)) {
        var fnm = vec_get(_dep_feature_names, i);
        if (strlen(fnm) == nl) { if (memeq(fnm, name, nl) == 1) { return vec_get(_dep_feature_deps, i); } }
        i = i + 1;
    }
    return 0;
}

# v6.3.1 lever 2: expand `name` into the active-dep set `out`. If `name` is a
# declared feature, recurse over its members (features may name other features);
# otherwise it's a dep name → append (deduped). Self/mutual cycles skip via the
# `seen` guard. Mirrors `_dep_expand_one` (the [groups] analog).
fn _dep_feature_expand(out, name, seen): i64 {
    var members = _dep_feature_lookup(name);
    if (members == 0) {
        if (_dep_list_has(out, name) == 0) { vec_push(out, name); }
        return 0;
    }
    if (_dep_list_has(seen, name) == 1) { return 0; }   # cycle — skip
    vec_push(seen, name);
    var j = 0;
    while (j < vec_len(members)) {
        _dep_feature_expand(out, vec_get(members, j), seen);
        j = j + 1;
    }
    return 0;
}

# v6.3.1 lever 2: is the optional dep `dep_name` activated by the current feature
# selection? Active set = the `[features]` `default = [...]` list (unless
# `--no-default-features`) ∪ the `--features` request list, each fully expanded.
# A `--features wgpu` naming an optional dep directly (no `[features]` entry)
# activates it too (Cargo-style implicit feature). With no `[features]` table and
# no `--features`, an optional dep is INACTIVE — it never resolves unless named.
fn _dep_feature_active(dep_name): i64 {
    var active = vec_new();
    var seen = vec_new();
    if (_cli_no_default == 0) {
        var defs = _dep_feature_lookup("default");
        if (defs != 0) {
            var i = 0;
            while (i < vec_len(defs)) {
                _dep_feature_expand(active, vec_get(defs, i), seen);
                i = i + 1;
            }
        }
    }
    if (_cli_features != 0) {
        var k = 0;
        while (k < vec_len(_cli_features)) {
            _dep_feature_expand(active, vec_get(_cli_features, k), seen);
            k = k + 1;
        }
    }
    return _dep_list_has(active, dep_name);
}

# v6.3.1 lever 2: does a dep's `target = "<arch|os>"` key match the current build
# target? Arch axis reads `_arch` (0=x86_64, 1=aarch64); OS axis reads the
# `_win_target` / `_agnos_target` / `_baremetal_target` flags the cyrius.cyr
# pre-scan set before resolution. "linux" means a native userland build (not
# windows/agnos/bare-metal) — note it also matches a native macOS host today
# (no separate macOS target flag yet; a follow-up if a consumer needs it). An
# unrecognized target string never matches (a typo skips the dep, doesn't pull it
# everywhere). Callers only invoke this when dep_target != 0.
fn _dep_target_matches(t): i64 {
    var tl = strlen(t);
    if (tl == 7 && memeq(t, "aarch64", 7) == 1) { if (_arch == 1) { return 1; } return 0; }
    if (tl == 5 && memeq(t, "arm64", 5) == 1) { if (_arch == 1) { return 1; } return 0; }
    if (tl == 6 && memeq(t, "x86_64", 6) == 1) { if (_arch == 0) { return 1; } return 0; }
    if (tl == 3 && memeq(t, "x86", 3) == 1) { if (_arch == 0) { return 1; } return 0; }
    if (tl == 7 && memeq(t, "windows", 7) == 1) { if (_win_target == 1) { return 1; } return 0; }
    if (tl == 5 && memeq(t, "agnos", 5) == 1) { if (_agnos_target == 1) { return 1; } return 0; }
    if (tl == 10 && memeq(t, "bare-metal", 10) == 1) { if (_baremetal_target == 1) { return 1; } return 0; }
    if (tl == 5 && memeq(t, "linux", 5) == 1) {
        if (_win_target == 0 && _agnos_target == 0 && _baremetal_target == 0) { return 1; }
        return 0;
    }
    return 0;
}

# v6.2.51 (closeout — CVE-32, path-traversal hardening of the Phase C modular
# resolver): reject a dep-/index-controlled sub-module / leaf name that could
# escape lib/ (any `/` or `..` component). The .50 `_dep_pull_submodule` ran
# `sys_unlink` on `lib/<pkg>_<submod>.cyr` BEFORE `_dep_copy_file`'s CVE-04 guard,
# so a malicious `dist/<pkg>/index.cyml` sibling like `../../../x` could delete an
# arbitrary `.cyr` during automatic `cyrius deps`. Returns 1 = unsafe (reject).
fn _dep_reject_unsafe_name(name): i64 {
    var i = 0;
    var c = load8(name);
    while (c != 0) {
        if (c == 47 || (c == 46 && load8(name + i + 1) == 46)) {   # '/' or '..'
            sys_write(STDERR_FD, "  error: unsafe dep name (path traversal rejected): ", 52);
            sys_write(STDERR_FD, name, strlen(name));
            sys_write(STDERR_FD, "\n", 1);
            return 1;
        }
        i = i + 1;
        c = load8(name + i);
    }
    return 0;
}

# v6.2.50 (deps lever 1 / Phase C — module-granular extraction): read a module's
# dep line `<mod> = [...]` from a `dist/<pkg>/index.cyml`, returning the dep vec
# (sibling-module names + `lib:<leaf>` entries) or 0 if absent.
fn _dep_read_index_deps(index_path, submod): i64 {
    if (file_exists(index_path) == 0) { return 0; }
    var sz = _file_size(index_path);
    if (sz <= 0) { return 0; }
    var buf = alloc(sz + 1);
    var nn = file_read_all(index_path, buf, sz);
    if (nn <= 0) { return 0; }
    store8(buf + nn, 0);
    var ml = strlen(submod);
    var i = 0;
    while (i < nn) {
        var ls = i;
        while (ls < nn && (load8(buf + ls) == 32 || load8(buf + ls) == 9)) { ls = ls + 1; }
        if (ls + ml < nn && memeq(buf + ls, submod, ml) == 1) {
            var c = load8(buf + ls + ml);
            if (c == 32 || c == 61) {   # key boundary: `<mod> ` or `<mod>=`
                return _parse_toml_str_array(buf, nn, ls + ml);
            }
        }
        while (i < nn && load8(buf + i) != 10) { i = i + 1; }
        if (i < nn) { i = i + 1; }
    }
    return 0;
}

# v6.2.50 Phase C: pull ONE modular sub-module `<dep_src>/dist/<pkg>/<mod>.cyr` +
# its transitive deps (from the index) into the consumer's lib/, in topological
# order. `lib:<leaf>` index entries resolve as stdlib leaves; bare names are
# sibling sub-modules (recursed). `seen` dedups + breaks cycles. Deps are pulled
# BEFORE the module so its `include` lands after theirs in `_dep_includes`.
fn _dep_pull_submodule(dep_src, pkg, submod, stdlib_dir, seen): i64 {
    if (_dep_reject_unsafe_name(submod) == 1) { return 1; }   # CVE-32: traversal guard, BEFORE any fs op
    if (_dep_list_has(seen, submod) == 1) { return 0; }
    vec_push(seen, submod);
    var errs = 0;
    var ip_sb = str_builder_new();
    str_builder_add_cstr(ip_sb, dep_src);
    str_builder_add_cstr(ip_sb, "/dist/");
    str_builder_add_cstr(ip_sb, pkg);
    str_builder_add_cstr(ip_sb, "/index.cyml");
    var deps = _dep_read_index_deps(str_data(str_builder_build(ip_sb)), submod);
    if (deps != 0) {
        var di = 0;
        while (di < vec_len(deps)) {
            var d = vec_get(deps, di);
            if (strlen(d) > 4 && memeq(d, "lib:", 4) == 1) {
                if (_dep_reject_unsafe_name(d + 4) == 1) {   # CVE-32: index-controlled leaf name
                    errs = errs + 1;
                } elif (stdlib_dir != 0) {
                    if (_dep_copy_stdlib_recursive(stdlib_dir, d + 4, 1) == 1) { errs = errs + 1; }
                }
            } else {
                errs = errs + _dep_pull_submodule(dep_src, pkg, d, stdlib_dir, seen);
            }
            di = di + 1;
        }
    }
    # copy `<dep_src>/dist/<pkg>/<mod>.cyr` → `lib/<pkg>_<mod>.cyr`
    var src_sb = str_builder_new();
    str_builder_add_cstr(src_sb, dep_src);
    str_builder_add_cstr(src_sb, "/dist/");
    str_builder_add_cstr(src_sb, pkg);
    str_builder_add_cstr(src_sb, "/");
    str_builder_add_cstr(src_sb, submod);
    str_builder_add_cstr(src_sb, ".cyr");
    var src = str_data(str_builder_build(src_sb));
    var df_sb = str_builder_new();
    str_builder_add_cstr(df_sb, "lib/");
    str_builder_add_cstr(df_sb, pkg);
    str_builder_add_cstr(df_sb, "_");
    str_builder_add_cstr(df_sb, submod);
    str_builder_add_cstr(df_sb, ".cyr");
    var dst_full = str_data(str_builder_build(df_sb));
    sys_unlink(dst_full);
    var cr = _dep_copy_file(src, dst_full);
    if (cr == 0 || cr == 2) {
        vec_push(_dep_includes, dst_full);
    } elif (cr == 1) {
        sys_write(STDERR_FD, "error: modular sub-module ", 26);
        sys_write(STDERR_FD, pkg, strlen(pkg));
        sys_write(STDERR_FD, ":", 1);
        sys_write(STDERR_FD, submod, strlen(submod));
        sys_write(STDERR_FD, " not found in dist/\n", 20);
        errs = errs + 1;
    }
    return errs;
}

# v5.7.14: returns 1 if `name` is already in _dep_visited, else 0.
fn _dep_name_visited(name): i64 {
    if (_dep_visited == 0) { return 0; }
    var i = 0;
    var nl = strlen(name);
    while (i < vec_len(_dep_visited)) {
        var v = vec_get(_dep_visited, i);
        if (strlen(v) == nl) {
            if (memeq(v, name, nl) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# v5.7.14: join a manifest-relative `path = "..."` to the manifest's
# directory. Returns `rel` unchanged if absolute.
fn _dep_join_path(manifest_dir, rel): i64 {
    if (load8(rel) == 47) { return rel; }
    var ml = strlen(manifest_dir);
    var rl = strlen(rel);
    var out = alloc(ml + 1 + rl + 1);
    memcpy(out, manifest_dir, ml);
    store8(out + ml, 47);
    memcpy(out + ml + 1, rel, rl);
    store8(out + ml + 1 + rl, 0);
    return out;
}

# v5.7.14: process [deps.X] sections in `buf` (manifest content of
# length `n`). `manifest_dir` is the absolute directory containing
# the manifest; relative `path = "..."` entries resolve against it.
# Successfully-resolved deps' names go into _dep_visited (closest-
# wins de-dup), and their resolved dirs go into _dep_queue for the
# transitive walk in cmd_deps. Returns errors count for this manifest.
fn _process_named_deps(buf, n, manifest_dir): i64 {
    var errors = 0;
    var si = 0;
    while (si < n) {
        if (memeq(buf + si, "[deps.", 6) == 1) {
            var name_start = si + 6;
            var name_end = name_start;
            while (name_end < n && load8(buf + name_end) != 93) { name_end = name_end + 1; }
            var dep_name_len = name_end - name_start;
            var dep_name = alloc(dep_name_len + 1);
            memcpy(dep_name, buf + name_start, dep_name_len);
            store8(dep_name + dep_name_len, 0);
            si = name_end + 1;
            # v5.7.14: closest-wins skip. Walk si past this section without
            # re-resolving.
            if (_dep_name_visited(dep_name) == 1) {
                while (si < n) {
                    if (load8(buf + si) == 91 && load8(buf + si + 1) != 91) { break; }
                    while (si < n && load8(buf + si) != 10) { si = si + 1; }
                    if (si < n) { si = si + 1; }
                }
                continue;
            }
            var dep_path = 0;
            var dep_git = 0;
            var dep_tag = 0;
            var dep_modules = 0;
            var dep_requires = 0;
            var dep_modular = 0;   # v6.2.50 Phase C: sub-modules from dist/<name>/
            var dep_optional = 0;  # v6.3.1 lever 2: resolve only when an active feature names this dep
            var dep_target = 0;    # v6.3.1 lever 2: resolve only on a matching build target
            # CVE-21 (v6.2.30): cleared if a tagged dep's resolved commit
            # disagrees with the lock — gates the module copy so poisoned
            # content never lands in lib/.
            var dep_pin_ok = 1;
            while (si < n) {
                if (load8(buf + si) == 91 && load8(buf + si + 1) != 91) {
                    if (memeq(buf + si, "[deps.", 6) != 1 && memeq(buf + si, "[build", 6) != 1 && memeq(buf + si, "[package", 8) != 1) {
                    }
                    if (load8(buf + si + 1) != 91) {
                        if (memeq(buf + si, "[deps.", 6) == 1) { break; }
                        if (memeq(buf + si, "[deps]", 6) == 1) { break; }
                        if (load8(buf + si + 1) != 100) { break; }
                    }
                }
                if (memeq(buf + si, "path", 4) == 1 && load8(buf + si + 4) != 0 && (load8(buf + si + 4) == 32 || load8(buf + si + 4) == 61)) {
                    var pi = si + 4;
                    while (pi < n && load8(buf + pi) != 34) { pi = pi + 1; }
                    pi = pi + 1;
                    var ps = pi;
                    while (pi < n && load8(buf + pi) != 34) { pi = pi + 1; }
                    var plen = pi - ps;
                    dep_path = alloc(plen + 1);
                    memcpy(dep_path, buf + ps, plen);
                    store8(dep_path + plen, 0);
                    # v5.7.14: resolve relative `path = "..."` against
                    # the manifest's directory, not the consumer's cwd.
                    dep_path = _dep_join_path(manifest_dir, dep_path);
                }
                if (memeq(buf + si, "git", 3) == 1 && (load8(buf + si + 3) == 32 || load8(buf + si + 3) == 61)) {
                    var gi = si + 3;
                    while (gi < n && load8(buf + gi) != 34) { gi = gi + 1; }
                    gi = gi + 1;
                    var gs = gi;
                    while (gi < n && load8(buf + gi) != 34) { gi = gi + 1; }
                    var glen = gi - gs;
                    dep_git = alloc(glen + 1);
                    memcpy(dep_git, buf + gs, glen);
                    store8(dep_git + glen, 0);
                }
                if (memeq(buf + si, "tag", 3) == 1 && (load8(buf + si + 3) == 32 || load8(buf + si + 3) == 61)) {
                    var ti = si + 3;
                    while (ti < n && load8(buf + ti) != 34) { ti = ti + 1; }
                    ti = ti + 1;
                    var ts = ti;
                    while (ti < n && load8(buf + ti) != 34) { ti = ti + 1; }
                    var tlen = ti - ts;
                    dep_tag = alloc(tlen + 1);
                    memcpy(dep_tag, buf + ts, tlen);
                    store8(dep_tag + tlen, 0);
                }
                # Key-boundary check (space/`=` after `modules`) — matches
                # the path/git/tag siblings above. Without it `modules` was
                # the one key here that bare-substring-matched, e.g. inside a
                # comment or a longer token. See CHANGELOG [6.0.36].
                if (memeq(buf + si, "modules", 7) == 1 && (load8(buf + si + 7) == 32 || load8(buf + si + 7) == 61)) {
                    dep_modules = _parse_toml_str_array(buf, n, si);
                }
                # v6.2.46 (dependency-model arc, lever 1 / Phase A): a fold/dep
                # may declare the stdlib leaves it needs in scope, e.g.
                # `requires = ["ct", "keccak", "thread_local"]`. Parsed like
                # `modules` (key-boundary checked: space/`=` after `requires`);
                # pulled below, after the key loop, ahead of this dep's modules.
                if (memeq(buf + si, "requires", 8) == 1 && (load8(buf + si + 8) == 32 || load8(buf + si + 8) == 61)) {
                    dep_requires = _parse_toml_str_array(buf, n, si);
                    dep_requires = _dep_expand_groups(dep_requires);   # v6.2.49 Phase B: expand [groups] refs
                }
                # v6.2.50 Phase C: `modular = ["ed25519", ...]` pulls individual
                # sub-modules from the dep's `dist/<name>/` (each + its transitive
                # index deps + lib leaves) instead of the whole-fold `modules`.
                # Bare sub-module names (the dep IS the pkg). Key-boundary checked.
                if (memeq(buf + si, "modular", 7) == 1 && (load8(buf + si + 7) == 32 || load8(buf + si + 7) == 61)) {
                    dep_modular = _parse_toml_str_array(buf, n, si);
                }
                # v6.3.1 (dependency-model arc, lever 2 — required vs optional deps):
                # `optional = true` marks a dep that resolves only when an active
                # `[features]` set names it (see `_dep_feature_active`). Bareword
                # value, so read the first non-space char after `=` (`t` of `true`).
                # Key-boundary checked (space/`=` after `optional`) like the siblings.
                if (memeq(buf + si, "optional", 8) == 1 && (load8(buf + si + 8) == 32 || load8(buf + si + 8) == 61)) {
                    var oi = si + 8;
                    while (oi < n && load8(buf + oi) != 61) { oi = oi + 1; }
                    oi = oi + 1;
                    while (oi < n && (load8(buf + oi) == 32 || load8(buf + oi) == 9)) { oi = oi + 1; }
                    if (oi < n && load8(buf + oi) == 116) { dep_optional = 1; }
                }
                # v6.3.1 lever 2: `target = "<arch|os>"` resolves this dep only when
                # the current build target matches (see `_dep_target_matches`).
                # Scalar string, parsed like `tag`. Key-boundary checked.
                if (memeq(buf + si, "target", 6) == 1 && (load8(buf + si + 6) == 32 || load8(buf + si + 6) == 61)) {
                    var tgi = si + 6;
                    while (tgi < n && load8(buf + tgi) != 34) { tgi = tgi + 1; }
                    tgi = tgi + 1;
                    var tgs = tgi;
                    while (tgi < n && load8(buf + tgi) != 34) { tgi = tgi + 1; }
                    var tglen = tgi - tgs;
                    dep_target = alloc(tglen + 1);
                    memcpy(dep_target, buf + tgs, tglen);
                    store8(dep_target + tglen, 0);
                }
                while (si < n && load8(buf + si) != 10) { si = si + 1; }
                si = si + 1;
            }
            # v6.3.1 (dependency-model arc, lever 2 — required vs optional deps):
            # gate this dep on the active feature set and the build target. An
            # `optional = true` dep resolves only when an active feature names it;
            # a `target = "..."` dep resolves only on a matching build target. The
            # axes COMBINE — a miss on EITHER skips the dep entirely (no requires
            # pull, no clone, no module copy, no `_dep_includes` push). Absent keys
            # → dep_optional 0 / dep_target 0 → never gated, so every pre-existing
            # manifest resolves the identical include set + order (byte-identical).
            # A skipped dep is NOT marked visited, so a later (transitive)
            # *required* reference can still resolve it. `continue` re-enters the
            # outer scan at the next section header the key loop left `si` on.
            if (dep_optional == 1 && _dep_feature_active(dep_name) == 0) {
                if (_verbose == 1) {
                    sys_write(STDERR_FD, "  skip optional dep (no active feature): ", 41);
                    sys_write(STDERR_FD, dep_name, strlen(dep_name));
                    sys_write(STDERR_FD, "\n", 1);
                }
                continue;
            }
            if (dep_target != 0 && _dep_target_matches(dep_target) == 0) {
                if (_verbose == 1) {
                    sys_write(STDERR_FD, "  skip dep (target mismatch): ", 30);
                    sys_write(STDERR_FD, dep_name, strlen(dep_name));
                    sys_write(STDERR_FD, "\n", 1);
                }
                continue;
            }
            # v6.2.46 (dependency-model arc, lever 1 / Phase A): resolve this
            # dep's declared `requires` stdlib leaves BEFORE its own modules,
            # so each leaf's `include "lib/<leaf>"` lands ahead of this dep's
            # include in `_dep_includes` — topological emit falls out of
            # resolution order, no separate sort. Reuses the recursive stdlib
            # resolver + its `_dep_stdlib_seen` dedup, so a leaf already pulled
            # (by `[deps].stdlib` or another fold's `requires`) is not
            # re-included. Converts the hand-ordered "ct/keccak MUST precede
            # the sigil include" consumer chain — and its omit-one → runtime
            # `ud2`/SIGILL trap — into a declared, fail-loud, resolve-time-
            # ordered requirement. Init the seen-set if the `[deps].stdlib`
            # phase didn't (a requires-only consumer) so `_dep_stdlib_seen_add`
            # doesn't vec_push into a null set.
            if (dep_requires != 0) {
                if (_dep_stdlib_seen == 0) { _dep_stdlib_seen_init(); }
                var rq_dir = _dep_find_stdlib_dir();
                if (rq_dir == 0) {
                    sys_write(STDERR_FD, "error: dep ", 11);
                    sys_write(STDERR_FD, dep_name, strlen(dep_name));
                    sys_write(STDERR_FD, " declares requires but the cyrius stdlib was not found\n", 55);
                    errors += 1;
                } else {
                    errors = errors + _dep_pull_leaves(rq_dir, dep_name, dep_requires);
                }
            }
            var need_clone = 0;
            if (dep_git != 0 && dep_modules != 0) {
                if (dep_path == 0) {
                    need_clone = 1;
                } elif (is_dir(str_from(dep_path)) == 0) {
                    need_clone = 1;
                }
            }
            # CVE-21 (v6.2.30) NOTE: a dep that supplies BOTH git/tag AND an
            # existing `path =` override resolves from the local path with no
            # clone, so the commit-pin verify below (which lives in the
            # need_clone branch) is intentionally bypassed — a local path
            # override is operator-controlled and has no remote tag to pin.
            # The git/tag fields are inert in that case.
            if (need_clone == 1) {
                var clone_sb = str_builder_new();
                if (_home != 0) {
                    str_builder_add_cstr(clone_sb, _home);
                    str_builder_add_cstr(clone_sb, "/deps/");
                    str_builder_add_cstr(clone_sb, dep_name);
                    str_builder_add_cstr(clone_sb, "/");
                    if (dep_tag != 0) {
                        str_builder_add_cstr(clone_sb, dep_tag);
                    } else {
                        str_builder_add_cstr(clone_sb, "main");
                    }
                } else {
                    str_builder_add_cstr(clone_sb, _cbt_tmpfile("deps"));
                    str_builder_add_cstr(clone_sb, "/");
                    str_builder_add_cstr(clone_sb, dep_name);
                    if (dep_tag != 0) {
                        str_builder_add_cstr(clone_sb, "_");
                        str_builder_add_cstr(clone_sb, dep_tag);
                    }
                }
                var clone_dir = str_data(str_builder_build(clone_sb));
                if (_home != 0) {
                    var pdir_sb = str_builder_new();
                    str_builder_add_cstr(pdir_sb, _home);
                    str_builder_add_cstr(pdir_sb, "/deps");
                    sys_mkdir(str_data(str_builder_build(pdir_sb)), 0x1ED);
                    var pdir2_sb = str_builder_new();
                    str_builder_add_cstr(pdir2_sb, _home);
                    str_builder_add_cstr(pdir2_sb, "/deps/");
                    str_builder_add_cstr(pdir2_sb, dep_name);
                    sys_mkdir(str_data(str_builder_build(pdir2_sb)), 0x1ED);
                } else {
                    sys_mkdir(_cbt_tmpfile("deps"), 0x1ED);
                }
                if (is_dir(str_from(clone_dir)) == 0) {
                    var git_ok = 1;
                    var gi2 = 0;
                    while (load8(dep_git + gi2) != 0) {
                        var gc = load8(dep_git + gi2);
                        if (gc == 59 || gc == 124 || gc == 96 || gc == 36 || gc == 38 || gc == 40 || gc == 41) {
                            git_ok = 0;
                        }
                        gi2 += 1;
                    }
                    if (dep_tag != 0) {
                        var ti2 = 0;
                        while (load8(dep_tag + ti2) != 0) {
                            var tc2 = load8(dep_tag + ti2);
                            if (tc2 == 59 || tc2 == 124 || tc2 == 96 || tc2 == 36 || tc2 == 38) {
                                git_ok = 0;
                            }
                            ti2 += 1;
                        }
                    }
                    if (git_ok == 0) {
                        sys_write(STDERR_FD, "error: unsafe characters in git URL or tag — skipping ", 54);
                        sys_write(STDERR_FD, dep_name, strlen(dep_name));
                        sys_write(STDERR_FD, "\n", 1);
                        errors += 1;
                    }
                    if (git_ok == 1) {
                        # CVE-15 (v6.1.33): clone via ARGV — no /bin/sh string, no
                        # sys_system. Each field is a distinct argv element AND a
                        # `--` separates options from the url/dir positionals, so a
                        # url/tag beginning with `-` can't be read as a git flag
                        # (the `-c …ext::sh` / `--upload-pack=…` arg-injection class
                        # the metachar denylist above misses — space + leading `-`
                        # aren't blocked). `/usr/bin/env` resolves git via PATH.
                        var gargv[128];   # N BYTES: up to ~12 ptrs (96 B) + slack
                        var gai = 0;
                        store64(&gargv + gai * 8, "env");       gai = gai + 1;
                        store64(&gargv + gai * 8, "git");       gai = gai + 1;
                        store64(&gargv + gai * 8, "clone");     gai = gai + 1;
                        store64(&gargv + gai * 8, "--depth");   gai = gai + 1;
                        store64(&gargv + gai * 8, "1");         gai = gai + 1;
                        store64(&gargv + gai * 8, "-q");        gai = gai + 1;
                        if (dep_tag != 0) {
                            store64(&gargv + gai * 8, "-b");    gai = gai + 1;
                            store64(&gargv + gai * 8, dep_tag); gai = gai + 1;
                        }
                        store64(&gargv + gai * 8, "--");        gai = gai + 1;
                        store64(&gargv + gai * 8, dep_git);     gai = gai + 1;
                        store64(&gargv + gai * 8, clone_dir);   gai = gai + 1;
                        store64(&gargv + gai * 8, 0);
                        if (_verbose == 1) {
                            sys_write(STDERR_FD, "  git clone: ", 13);
                            sys_write(STDERR_FD, dep_git, strlen(dep_git));
                            sys_write(STDERR_FD, "\n", 1);
                        }
                        var gpid = sys_fork();
                        if (gpid == 0) {
                            sys_execve("/usr/bin/env", &gargv, _envp);
                            sys_exit(127);
                        }
                        var gsb[1];
                        sys_waitpid(gpid, &gsb, 0);
                    }
                }
                dep_path = clone_dir;
                # CVE-21 (v6.2.30): pin the resolved commit for a TAGGED dep.
                # The tag is meant to be immutable, so on every resolve (fresh
                # clone OR reused cache) we enforce THREE things against the lock
                # and the checkout, gating the module copy via dep_pin_ok:
                #   1. a corrupt/truncated pin line for this dep → fail closed
                #      (don't silently TOFU-re-pin over corruption);
                #   2. HEAD must equal the locked commit → catches a force-pushed
                #      / repointed tag (the core CVE-21 threat);
                #   3. the working tree must match HEAD → catches an in-place
                #      edit of a cached checkout (snapshot-ping-pong write-through
                #      / local tamper) that leaves HEAD on the pinned SHA.
                # No-tag deps intentionally float (track a branch HEAD) so they
                # are not pinned. POSIX-only (mirrors the clone).
                if (dep_tag != 0) {
                    var _head = _git_head_sha(clone_dir);
                    if (_head != 0) {
                        var _exp = _lock_commit_lookup(dep_name, dep_git, dep_tag);
                        if (_exp == -1) {
                            sys_write(STDERR_FD, "error: corrupt commit-pin line for dep '", 40);
                            sys_write(STDERR_FD, dep_name, strlen(dep_name));
                            sys_write(STDERR_FD, "' in cyrius.lock — refusing (delete cyrius.lock to re-pin intentionally).\n", 73);
                            dep_pin_ok = 0;
                            errors = errors + 1;
                        } elif (_exp != 0 && _cstr_eq(_exp, _head) == 0) {
                            sys_write(STDERR_FD, "error: commit-pin mismatch for dep '", 36);
                            sys_write(STDERR_FD, dep_name, strlen(dep_name));
                            sys_write(STDERR_FD, "' tag '", 7);
                            sys_write(STDERR_FD, dep_tag, strlen(dep_tag));
                            sys_write(STDERR_FD, "': cyrius.lock pins ", 20);
                            sys_write(STDERR_FD, _exp, strlen(_exp));
                            sys_write(STDERR_FD, " but the tag now resolves to ", 29);
                            sys_write(STDERR_FD, _head, strlen(_head));
                            sys_write(STDERR_FD, " (force-pushed/repointed tag) — refusing. Delete cyrius.lock to re-pin intentionally.\n", 85);
                            dep_pin_ok = 0;
                            errors = errors + 1;
                        } elif (_git_worktree_clean(clone_dir) == 0) {
                            sys_write(STDERR_FD, "error: cached checkout for dep '", 31);
                            sys_write(STDERR_FD, dep_name, strlen(dep_name));
                            sys_write(STDERR_FD, "' has local modifications (working tree != HEAD ", 48);
                            sys_write(STDERR_FD, _head, strlen(_head));
                            sys_write(STDERR_FD, ") — refusing tampered cache. Remove the cached clone and re-resolve.\n", 68);
                            dep_pin_ok = 0;
                            errors = errors + 1;
                        } else {
                            var _cl = str_builder_new();
                            str_builder_add_cstr(_cl, "commit\t");
                            str_builder_add_cstr(_cl, _head);
                            str_builder_add_cstr(_cl, "\t");
                            str_builder_add_cstr(_cl, dep_name);
                            str_builder_add_cstr(_cl, "\t");
                            str_builder_add_cstr(_cl, dep_git);
                            str_builder_add_cstr(_cl, "\t");
                            str_builder_add_cstr(_cl, dep_tag);
                            if (_dep_commit_lines != 0) {
                                vec_push(_dep_commit_lines, str_data(str_builder_build(_cl)));
                            }
                        }
                    }
                }
            }
            # v6.2.50 Phase C: pull declared modular sub-modules from the dep's
            # `dist/<name>/` (each + its transitive index deps + lib leaves, in
            # topological order). A per-dep `seen` set dedups + breaks cycles.
            if (dep_modular != 0 && dep_path != 0 && dep_pin_ok == 1) {
                if (_dep_stdlib_seen == 0) { _dep_stdlib_seen_init(); }
                var sm_dir = _dep_find_stdlib_dir();
                var sm_seen = vec_new();
                var smi = 0;
                while (smi < vec_len(dep_modular)) {
                    errors = errors + _dep_pull_submodule(dep_path, dep_name, vec_get(dep_modular, smi), sm_dir, sm_seen);
                    smi = smi + 1;
                }
            }
            var dep_had_success = 0;
            if (dep_path != 0 && dep_modules != 0 && dep_pin_ok == 1) {
                var mi = 0;
                while (mi < vec_len(dep_modules)) {
                    var mod_path = vec_get(dep_modules, mi);
                    var sb = str_builder_new();
                    str_builder_add_cstr(sb, dep_path);
                    str_builder_add_cstr(sb, "/");
                    str_builder_add_cstr(sb, mod_path);
                    var src = str_data(str_builder_build(sb));
                    if (file_exists(src) == 0) {
                        var fb = mod_path;
                        var fbi = 0;
                        while (load8(mod_path + fbi) != 0) {
                            if (load8(mod_path + fbi) == 47) { fb = mod_path + fbi + 1; }
                            fbi = fbi + 1;
                        }
                        if (fb != mod_path) {
                            var sb_fb = str_builder_new();
                            str_builder_add_cstr(sb_fb, dep_path);
                            str_builder_add_cstr(sb_fb, "/lib/");
                            str_builder_add_cstr(sb_fb, fb);
                            var alt = str_data(str_builder_build(sb_fb));
                            if (file_exists(alt) == 1) { src = alt; }
                        }
                    }
                    if (file_exists(src) == 0) {
                        sys_write(STDERR_FD, "error: [deps.", 13);
                        sys_write(STDERR_FD, dep_name, strlen(dep_name));
                        sys_write(STDERR_FD, "] modules entry \"", 17);
                        sys_write(STDERR_FD, mod_path, strlen(mod_path));
                        sys_write(STDERR_FD, "\" not found at tag in ", 22);
                        sys_write(STDERR_FD, dep_path, strlen(dep_path));
                        sys_write(STDERR_FD, "\n", 1);
                        errors = errors + 1;
                        mi = mi + 1;
                        continue;
                    }
                    # v6.2.47 (deps lever 1, Phase A producer-side consumed):
                    # if the dep ships a `.deps` sidecar next to this module
                    # (emitted by `cyrius distlib`), auto-resolve the fold's
                    # declared stdlib leaves BEFORE the fold's own include is
                    # pushed — same topological-by-resolution-order placement as
                    # a hand-authored `requires` key, but the consumer needn't
                    # author it. Shared resolver + `_dep_stdlib_seen` dedup (a leaf
                    # also in `[deps].stdlib`/`requires` won't repeat).
                    var _src_l = strlen(src);
                    if (_src_l > 4 && memeq(src + _src_l - 4, ".cyr", 4) == 1) {
                        var _sc_sb = str_builder_new();
                        var _sc_stem = alloc(_src_l - 3);
                        memcpy(_sc_stem, src, _src_l - 4);
                        store8(_sc_stem + _src_l - 4, 0);
                        str_builder_add_cstr(_sc_sb, _sc_stem);
                        str_builder_add_cstr(_sc_sb, ".deps");
                        var _sc_leaves = _dep_read_sidecar(str_data(str_builder_build(_sc_sb)));
                        if (_sc_leaves != 0) {
                            if (vec_len(_sc_leaves) > 0) {
                                if (_dep_stdlib_seen == 0) { _dep_stdlib_seen_init(); }
                                var _sc_dir = _dep_find_stdlib_dir();
                                if (_sc_dir != 0) {
                                    errors = errors + _dep_pull_leaves(_sc_dir, dep_name, _sc_leaves);
                                }
                            }
                        }
                    }
                    var base = mod_path;
                    var bi = 0;
                    while (load8(mod_path + bi) != 0) {
                        if (load8(mod_path + bi) == 47) { base = mod_path + bi + 1; }
                        bi = bi + 1;
                    }
                    var sb3 = str_builder_new();
                    str_builder_add_cstr(sb3, "lib/");
                    var _dnl = strlen(dep_name);
                    var _bsd = 1;
                    var _ck = 0;
                    while (_ck < _dnl) {
                        if (load8(base + _ck) != load8(dep_name + _ck)) { _bsd = 0; break; }
                        _ck = _ck + 1;
                    }
                    if (_bsd == 1) {
                        str_builder_add_cstr(sb3, base);
                    } else {
                        str_builder_add_cstr(sb3, dep_name);
                        str_builder_add_cstr(sb3, "_");
                        str_builder_add_cstr(sb3, base);
                    }
                    var dst = str_data(str_builder_build(sb3));
                    # v5.11.8: file-copy instead of symlink (was
                    # syscall(88, sym_src, dst) symlink-then-fallback-
                    # to-copy). Symlinks fired install.sh's `cp -L`
                    # same-file collision and let snapshot-ping-pong
                    # silently overwrite project lib/ files. Always
                    # copy → distinct inodes at every layer. See
                    # CHANGELOG [5.11.8], roadmap v5.10.37/v5.11.8 pin.
                    sys_unlink(dst);
                    var cr2 = _dep_copy_file(src, dst);
                    if (cr2 == 0 || cr2 == 2) {
                        vec_push(_dep_includes, dst);
                        dep_had_success = 1;
                        if (cr2 == 0) {
                            if (_verbose == 1) {
                                sys_write(STDERR_FD, "  ", 2);
                                sys_write(STDERR_FD, dep_name, strlen(dep_name));
                                sys_write(STDERR_FD, ": ", 2);
                                sys_write(STDERR_FD, base, strlen(base));
                                sys_write(STDERR_FD, "\n", 1);
                            }
                        }
                    } elif (cr2 == 1) { errors = errors + 1; }
                    mi = mi + 1;
                }
            }
            # v5.7.14: on success, mark visited + queue for transitive walk.
            if (dep_had_success == 1) {
                vec_push(_dep_visited, dep_name);
                if (dep_path != 0) {
                    vec_push(_dep_queue, _abs_path(dep_path));
                }
            }
        } else {
            si = si + 1;
        }
    }
    return errors;
}

fn cmd_deps(): i64 {
    if (_dry_run == 1) {
        println("dry-run: would resolve deps from cyrius.cyml into lib/");
        return 0;
    }
    # Try cyrius.cyml first, fall back to cyrius.toml
    var _manifest = "cyrius.cyml";
    if (file_exists(_manifest) == 0) { _manifest = "cyrius.toml"; }
    if (file_exists(_manifest) == 0) {
        _err("no cyrius.cyml or cyrius.toml found");
        return 1;
    }
    # v6.0.1: removed unconditional `sys_mkdir("lib", 0x1ED)` here.
    # Pre-fix the upfront mkdir created `./lib` before
    # `_dep_find_stdlib_dir` ran, tripping its priority-(a) check
    # `file_exists("src/main.cyr") && is_dir("./lib")` for ANY
    # downstream repo with a `src/main.cyr` entry point + non-empty
    # `stdlib = [...]` (gnoboot exposed this 2026-05-19 when
    # adopting `stdlib = ["fnptr"]`). Priority (a) is supposed to
    # identify the cyrius source repo only — it returned "./lib"
    # for downstream repos and the stdlib copy failed because the
    # src path resolved into the empty just-mkdir'd `./lib/`. The
    # `_dep_copy_file` prefix-walk at line ~85 already mkdir's
    # intermediate dirs lazily, so the upfront mkdir was redundant
    # AND wrong. See CHANGELOG [6.0.1].
    var buf = alloc(32768);
    var n = file_read_all(_manifest, buf, 32767);
    if (n <= 0) { _err("cannot read manifest"); return 1; }
    # If CYML: strip body (everything after ---) — only parse TOML header
    var hdr_end = n;
    var si_sep = 0;
    while (si_sep + 3 < n) {
        if (load8(buf + si_sep) == 10 && load8(buf + si_sep + 1) == 45 && load8(buf + si_sep + 2) == 45 && load8(buf + si_sep + 3) == 45) {
            hdr_end = si_sep;
            si_sep = n;  # break
        }
        si_sep = si_sep + 1;
    }
    n = hdr_end;
    store8(buf + n, 0);
    var copied = 0;
    var errors = 0;
    _dep_includes = vec_new();
    # v5.7.14: per-cmd_deps state. visited names = closest-wins de-dup.
    # queue = abs dirs of resolved deps whose own cyrius.cyml needs walking.
    _dep_visited = vec_new();
    _dep_queue = vec_new();
    _dep_commit_lines = vec_new();   # CVE-21 (v6.2.30): git-dep commit pins
    _dep_parse_groups(buf, n);       # v6.2.49 Phase B: [groups] (buf is the TOML header, CYML body already stripped)
    _dep_register_default_std_group();  # v6.3.32 Phase D: built-in `std` default group (after parse so a manifest's own `std` wins)
    _dep_parse_features(buf, n);     # v6.3.1 lever 2: [features] table (populates _dep_feature_names/_deps; gating happens in _process_named_deps)

    # === Phase 1: stdlib deps ===
    # Find: stdlib = ["string", "fmt", ...]
    # Key-boundary-aware: "stdlib" must be preceded by start-of-file,
    # newline, or whitespace (i.e. not `a-zA-Z0-9_`), and followed
    # by ` ` or `=`. Prevents false-positive on comment substrings
    # like "bundles the stdlib prerequisites" which previously matched
    # and caused `_parse_toml_str_array` to grab the next array in the
    # file (e.g. patra's `[lib] modules = ["src/file.cyr", ...]`),
    # surfacing in v5.5.26 when patra added a `[lib]` section above
    # a comment that mentioned "stdlib".
    var si = 0;
    while (si < n) {
        if (memeq(buf + si, "stdlib", 6) == 1) {
            var pre_ok = 1;
            if (si > 0) {
                var pc = load8(buf + si - 1);
                # alnum/underscore = continuation of a longer identifier,
                # so "stdlib" is a substring, not a key.
                if (pc >= 48 && pc <= 57)   { pre_ok = 0; }   # 0-9
                if (pc >= 65 && pc <= 90)   { pre_ok = 0; }   # A-Z
                if (pc >= 97 && pc <= 122)  { pre_ok = 0; }   # a-z
                if (pc == 95)               { pre_ok = 0; }   # _
                # Line must not be a comment. Scan back to line start
                # and check if the first non-space is `#`.
                if (pre_ok == 1) {
                    var ls = si;
                    while (ls > 0) {
                        var lc = load8(buf + ls - 1);
                        if (lc == 10) { break; }
                        ls = ls - 1;
                    }
                    while (ls < si) {
                        var wc = load8(buf + ls);
                        if (wc == 35) { pre_ok = 0; break; }  # '#'
                        if (wc != 32 && wc != 9) { break; }
                        ls = ls + 1;
                    }
                }
            }
            if (pre_ok == 1 && si + 6 < n && (load8(buf + si + 6) == 32 || load8(buf + si + 6) == 61)) {
                var stdlib_dir = _dep_find_stdlib_dir();
                if (stdlib_dir == 0) {
                    println("  error: cannot find cyrius stdlib");
                    errors = errors + 1;
                } else {
                    # v5.10.19: per-cmd_deps invocation visited-set
                    # for the include-chain follower below.
                    _dep_stdlib_seen_init();
                    var mods = _parse_toml_str_array(buf, n, si);
                    mods = _dep_expand_groups(mods);   # v6.2.49 Phase B: expand [groups] refs → leaves
                    var mi = 0;
                    while (mi < vec_len(mods)) {
                        var mod_name = vec_get(mods, mi);
                        # v5.10.19: replaces the inline copy with the
                        # recursive fetcher. For 95%+ of stdlib modules
                        # (leaf files) this is functionally identical
                        # — the include scan finds zero matches, only
                        # the top-level file gets copied. For the arch-
                        # dispatcher modules (syscalls, alloc) it
                        # follows their `include "lib/X.cyr"` chains.
                        # is_top=1 — push onto `_dep_includes` so
                        # `compile()` prepends `include "lib/<mod>.cyr"`.
                        var rr = _dep_copy_stdlib_recursive(stdlib_dir, mod_name, 1);
                        if (rr == 1) { errors = errors + 1; }
                        if (_verbose == 1 && rr == 0) {
                            sys_write(STDERR_FD, "  stdlib: ", 10);
                            sys_write(STDERR_FD, mod_name, strlen(mod_name));
                            sys_write(STDERR_FD, "\n", 1);
                        }
                        mi = mi + 1;
                    }
                }
                break;
            }
        }
        si = si + 1;
    }

    # === Phase 2: named deps (consumer's manifest) ===
    # v5.7.14: extracted to _process_named_deps. Consumer's manifest_dir
    # is abs(cwd). After this returns, _dep_queue holds the resolved
    # dirs of every direct dep — Phase 3 drains them.
    var _consumer_dir = _abs_path(".");
    errors = errors + _process_named_deps(buf, n, _consumer_dir);

    # === Phase 3: transitive deps (BFS drain of _dep_queue) ===
    # v5.7.14. For each resolved dep dir, read its cyrius.cyml and
    # process its [deps.X] sections. New deps push more dirs into
    # _dep_queue; closest-wins skip prevents re-resolution. Cycles
    # terminate naturally because re-encountered names are skipped.
    var _qi = 0;
    while (_qi < vec_len(_dep_queue)) {
        var _trans_dir = vec_get(_dep_queue, _qi);
        _qi = _qi + 1;
        var _tm_sb = str_builder_new();
        str_builder_add_cstr(_tm_sb, _trans_dir);
        str_builder_add_cstr(_tm_sb, "/cyrius.cyml");
        var _tm = str_data(str_builder_build(_tm_sb));
        if (file_exists(_tm) == 0) {
            var _tm_sb2 = str_builder_new();
            str_builder_add_cstr(_tm_sb2, _trans_dir);
            str_builder_add_cstr(_tm_sb2, "/cyrius.toml");
            _tm = str_data(str_builder_build(_tm_sb2));
        }
        if (file_exists(_tm) == 0) { continue; }
        var _tbuf = alloc(32768);
        var _tn = file_read_all(_tm, _tbuf, 32767);
        if (_tn <= 0) { continue; }
        # Strip CYML body (everything after `\n---`); only header is TOML.
        var _thdr = _tn;
        var _ts = 0;
        while (_ts + 3 < _tn) {
            if (load8(_tbuf + _ts) == 10 && load8(_tbuf + _ts + 1) == 45 && load8(_tbuf + _ts + 2) == 45 && load8(_tbuf + _ts + 3) == 45) {
                _thdr = _ts;
                _ts = _tn;
            }
            _ts = _ts + 1;
        }
        _tn = _thdr;
        store8(_tbuf + _tn, 0);
        errors = errors + _process_named_deps(_tbuf, _tn, _trans_dir);
    }

    # v5.7.14: `copied` is the count of distinct deps resolved (direct +
    # transitive). _dep_visited grows once per resolved dep across both
    # phases.
    copied = vec_len(_dep_visited);

    # Summary (only print if something was copied or errored)
    if (copied > 0 || errors > 0) {
        var nb[24];
        var nl = fmt_int_buf(copied, &nb);
        sys_write(STDOUT_FD, &nb, nl);
        sys_write(STDOUT_FD, " deps resolved", 14);
        if (errors > 0) {
            sys_write(STDOUT_FD, ", ", 2);
            nl = fmt_int_buf(errors, &nb);
            sys_write(STDOUT_FD, &nb, nl);
            sys_write(STDOUT_FD, " errors", 7);
        }
        sys_write(STDOUT_FD, "\n", 1);
    }
    # v5.7.8 P5: write cyrius.lock by default after every successful
    # resolve (was opt-in via `cyrius deps --lock` pre-v5.7.8). The
    # lockfile is the only thing making "pinned deps" reproducible
    # across machines — making it opt-in defeats the purpose for new
    # projects whose authors do not know the flag exists. Suppressed
    # by --no-lock.
    if (errors == 0) {
        if (_no_lock == 0) {
            if (copied > 0) {
                cmd_deps_lock();
            }
        }
    }
    return errors;
}

# Auto-resolve deps if manifest has [deps] section.
# Called before build/run/test to ensure lib/ is populated.
fn _auto_deps(): i64 {
    var _ad_manifest = "cyrius.cyml";
    if (file_exists(_ad_manifest) == 0) { _ad_manifest = "cyrius.toml"; }
    if (file_exists(_ad_manifest) == 0) { return 0; }
    var buf = alloc(4096);
    var n = file_read_all(_ad_manifest, buf, 4095);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    # Check if [deps] section exists
    var has_deps = 0;
    var i = 0;
    while (i < n) {
        if (memeq(buf + i, "[deps]", 6) == 1) { has_deps = 1; break; }
        if (memeq(buf + i, "[deps.", 6) == 1) { has_deps = 1; break; }
        i = i + 1;
    }
    if (has_deps == 0) { return 0; }
    var dr = cmd_deps();

    # Also read [build] modules if present — for multi-module projects
    # that declare concatenation order in the manifest instead of using
    # include directives. The modules are prepended before the entry point.
    i = 0;
    while (i < n) {
        if (memeq(buf + i, "[build]", 7) == 1) {
            # Scan within [build] section for the `modules` key. Key-
            # boundary + comment aware (mirrors the `stdlib` guard above,
            # v5.5.26): match `modules` only as the first non-space token
            # on a non-comment line and only when followed by space/tab/`=`.
            # The old raw line-start `memeq` both false-matched `modules`
            # inside `[build]` comments (auto-prepending every `[lib]`
            # module → input_buf overflow, blaming the wrong file) and
            # missed indented `  modules = [...]` keys. See CHANGELOG [6.0.36].
            var bi = i + 7;
            while (bi < n) {
                if (load8(buf + bi) == 91 && load8(buf + bi + 1) != 91) {
                    # Hit next section
                    break;
                }
                # First non-space char on this line.
                var ls = bi;
                while (ls < n && (load8(buf + ls) == 32 || load8(buf + ls) == 9)) {
                    ls = ls + 1;
                }
                # Skip comment lines; require the `modules` key followed by
                # a key separator (space / tab / `=`).
                if (ls < n && load8(buf + ls) != 35 && memeq(buf + ls, "modules", 7) == 1) {
                    var after = load8(buf + ls + 7);
                    if (after == 32 || after == 9 || after == 61) {
                        _build_modules = _parse_toml_str_array(buf, n, ls);
                        break;
                    }
                }
                while (bi < n && load8(buf + bi) != 10) { bi = bi + 1; }
                bi = bi + 1;
            }
            break;
        }
        i = i + 1;
    }

    return dr;
}

fn cmd_package(): i64 {
    # Read manifest if present
    var name = "unknown";
    var ver = _version;
    var entry = "src/main.cyr";
    var output_name = "main";

    var _pkg_manifest = "cyrius.cyml";
    if (file_exists(_pkg_manifest) == 0) { _pkg_manifest = "cyrius.toml"; }
    if (file_exists(_pkg_manifest) == 1) {
        var buf = alloc(4096);
        var n = file_read_all(_pkg_manifest, buf, 4095);
        store8(buf + n, 0);
    }
    if (file_exists("VERSION") == 1) {
        ver = read_file_str("VERSION");
        # Use directory name as package name
    }

    _status("=== cyrius package ===");
    sys_write(STDOUT_FD, "  version: ", 11);
    println(ver);

    # Compile if entry exists
    sys_mkdir("build", 0x1ED);
    if (file_exists(entry) == 1) {
        println("  compiling...");
        var out = make_path("build", output_name);
        compile(entry, out);
    }
    println("  package ready in build/");
    return 0;
}

# v5.8.49: recursive directory walker for cmd_update.
# Walks `src_dir` (e.g. ~/.cyrius/versions/<v>/lib) and copies every
# `.cyr` file to the corresponding `lib/<rel>` path in the consumer's
# cwd, preserving subdir structure. `rel_prefix == 0` at the root call;
# recursion appends "<dirname>" / "<rel_prefix>/<dirname>" as we descend.
# Returns total file count copied.
fn _update_walk(src_dir, rel_prefix): i64 {
    var copied = 0;
    var entries = dir_list(str_from(src_dir));
    var ei = 0;
    while (ei < vec_len(entries)) {
        var name = vec_get(entries, ei);
        var nd = str_data(name);
        var nl = str_len(name);
        ei = ei + 1;
        # Skip "." and ".."
        if (nl == 1 && load8(nd) == 46) { continue; }
        if (nl == 2 && load8(nd) == 46 && load8(nd + 1) == 46) { continue; }
        var from = make_path(src_dir, nd);
        if (is_dir(str_from(from)) == 1) {
            # Recurse — extend rel_prefix.
            var sub_sb = str_builder_new();
            if (rel_prefix != 0) {
                str_builder_add_cstr(sub_sb, rel_prefix);
                str_builder_add_cstr(sub_sb, "/");
            }
            str_builder_add_cstr(sub_sb, nd);
            var sub_rel = str_data(str_builder_build(sub_sb));
            copied = copied + _update_walk(from, sub_rel);
            continue;
        }
        # File: only handle *.cyr.
        if (nl <= 4) { continue; }
        if (load8(nd + nl - 4) != 46) { continue; }
        if (load8(nd + nl - 3) != 99) { continue; }
        if (load8(nd + nl - 2) != 121) { continue; }
        if (load8(nd + nl - 1) != 114) { continue; }
        var to_sb = str_builder_new();
        str_builder_add_cstr(to_sb, "lib/");
        if (rel_prefix != 0) {
            str_builder_add_cstr(to_sb, rel_prefix);
            str_builder_add_cstr(to_sb, "/");
        }
        str_builder_add_cstr(to_sb, nd);
        var to = str_data(str_builder_build(to_sb));
        # _dep_copy_file streams in 32KB chunks (no size cap) and mkdir-p's
        # intermediate dst dirs. Returns 0 on copy, 2 on already-resolved.
        var cr = _dep_copy_file(from, to);
        if (cr == 0 || cr == 2) {
            copied = copied + 1;
        }
    }
    return copied;
}

fn cmd_update(): i64 {
    _status("=== cyrius update ===");
    # Find installed stdlib
    var cur = read_file_str(make_path(_home, "current"));
    var src_lib = 0;
    if (cur != 0) {
        var ver_dir = make_path(_home, "versions");
        ver_dir = make_path(ver_dir, cur);
        src_lib = make_path(ver_dir, "lib");
    }
    if (src_lib == 0) {
        # Fallback: try ../cyrius/lib
        if (is_dir(str_from("../cyrius/lib")) == 1) {
            src_lib = "../cyrius/lib";
        }
    }
    if (src_lib == 0) {
        _err("cannot find Cyrius stdlib");
        println("  expected: ~/.cyrius/versions/<ver>/lib/ or ../cyrius/lib/");
        return 1;
    }
    # Ensure lib/ exists
    sys_mkdir("lib", 0x1ED);
    # v5.8.49: recursive walk so subdir-nested stdlib (e.g.
    # `lib/unicode/*.cyr`) reaches the consumer. Pre-fix, the flat
    # dir_list + extension-filter skipped directory entries entirely
    # and used a 32KB read buffer that would have silently truncated
    # files like `lib/unicode/_categories_data.cyr` (~59KB) even if
    # they had been seen. Helper `_update_walk` defers file copying
    # to `_dep_copy_file` which handles streaming reads of any size
    # plus mkdir-p of intermediate destination dirs.
    var copied = _update_walk(src_lib, 0);
    sys_write(STDOUT_FD, "  updated lib/ from ", 20);
    sys_write(STDOUT_FD, src_lib, strlen(src_lib));
    sys_write(STDOUT_FD, " (", 2);
    fmt_int(copied);
    println(" files)");

    # Update .cyrius-toolchain to match installed version
    if (cur != 0 && file_exists(".cyrius-toolchain") == 1) {
        var tc_sb = str_builder_new();
        str_builder_add_cstr(tc_sb, cur);
        str_builder_add_cstr(tc_sb, "\n");
        var tc_str = str_data(str_builder_build(tc_sb));
        file_write_all(".cyrius-toolchain", tc_str, strlen(tc_str));
        sys_write(STDOUT_FD, "  .cyrius-toolchain -> ", 23);
        println(cur);
    }

    # Migrate cyrius.toml → cyrius.cyml if toml exists and cyml doesn't
    if (file_exists("cyrius.toml") == 1 && file_exists("cyrius.cyml") == 0) {
        var toml_buf = alloc(32768);
        var toml_n = file_read_all("cyrius.toml", toml_buf, 32767);
        if (toml_n > 0) {
            # Write cyrius.cyml: TOML content + separator + empty body
            var cyml_sb = str_builder_new();
            var ti = 0;
            while (ti < toml_n) {
                str_builder_add_byte(cyml_sb, load8(toml_buf + ti));
                ti = ti + 1;
            }
            # Ensure trailing newline before separator
            if (toml_n > 0 && load8(toml_buf + toml_n - 1) != 10) {
                str_builder_add_cstr(cyml_sb, "\n");
            }
            str_builder_add_cstr(cyml_sb, "---\n");
            var cyml_str = str_data(str_builder_build(cyml_sb));
            file_write_all("cyrius.cyml", cyml_str, strlen(cyml_str));
            sys_unlink("cyrius.toml");
            println("  migrated cyrius.toml -> cyrius.cyml");
        }
    }

    return 0;
}


# ================================================================
# Dep integrity — lockfile generation and verification
# ================================================================
# cyrius.lock format: one line per dep file
#   sha256hex  lib/name.cyr
# Generated by cyrius deps, verified by cyrius deps --verify

fn _sha256sum_file(path): i64 {
    # v6.0.85 — Windows has no /bin/sh or sha256sum; certutil is the built-in.
    # `certutil -hashfile <path> SHA256` prints 3 lines: a header, the 64-char
    # lowercase hex digest, then a "completed" line. Capture via CreateProcessW
    # (process_win exec_capture) and parse line 2. Makes `cyrius deps --lock`
    # round-trip on native Windows (no WSL/git-bash).
    #ifdef CYRIUS_TARGET_WIN
    var cargs = vec_new();
    vec_push(cargs, "certutil");
    vec_push(cargs, "-hashfile");
    vec_push(cargs, path);
    vec_push(cargs, "SHA256");
    var cbuf = alloc(512);
    var cn = exec_capture(cargs, cbuf, 511);
    if (cn <= 0) { return 0; }
    store8(cbuf + cn, 0);
    # Skip the header line (to the first newline), then any \r/space.
    var cp = 0;
    while (cp < cn) { if (load8(cbuf + cp) == 10) { cp = cp + 1; break; } cp = cp + 1; }
    while (cp < cn) {
        var wc = load8(cbuf + cp);
        if (wc == 13) { cp = cp + 1; } elif (wc == 32) { cp = cp + 1; } elif (wc == 10) { cp = cp + 1; }
        else { break; }
    }
    if (cp + 64 > cn) { return 0; }
    var whash = alloc(65);
    var wk = 0;
    while (wk < 64) { store8(whash + wk, load8(cbuf + cp + wk)); wk = wk + 1; }
    store8(whash + 64, 0);
    return whash;
    #endif
    # CVE-14 (v6.1.33): exec sha256sum via ARGV — `path` is a DISTINCT argv
    # element, never concatenated into a `/bin/sh -c` string, so a lockfile path
    # or a resolved-dep filename containing shell metacharacters can't run
    # commands. This sink is reached by `cmd_deps_lock`, which auto-runs on every
    # `cyrius deps`/`build` (it hashes `dir_list` filenames), so the prior shell
    # string was the broad CVE-01-class hole the deep-dive flagged. `/usr/bin/env`
    # does the PATH lookup for sha256sum with the real environ. (Windows already
    # uses the safe `exec_capture` argv path above.)
    var tmpf = _cbt_tmpfile("sha_out");
    var pid = sys_fork();
    if (pid == 0) {
        var ofd = sys_open(tmpf, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
        sys_dup2(ofd, 1);
        sys_close(ofd);
        var argv[40];   # N BYTES per CLAUDE.md buffer contract: 4 ptrs need 32 B
        store64(&argv, "env");
        store64(&argv + 8, "sha256sum");
        store64(&argv + 16, path);
        store64(&argv + 24, 0);
        sys_execve("/usr/bin/env", &argv, _envp);
        sys_exit(127);
    }
    var sb[1];
    sys_waitpid(pid, &sb, 0);
    var buf = alloc(128);
    var n = file_read_all(tmpf, buf, 127);
    sys_unlink(tmpf);
    if (n <= 0) { return 0; }
    # Extract just the hex hash (first 64 chars)
    if (n < 64) { return 0; }
    var hash = alloc(65);
    memcpy(hash, buf, 64);
    store8(hash + 64, 0);
    return hash;
}

# CVE-21 (v6.2.30) — cstr equality (length-checked memeq).
fn _cstr_eq(a, b): i64 {
    var la = strlen(a);
    if (la != strlen(b)) { return 0; }
    return memeq(a, b, la);
}

# CVE-21 (v6.2.30) — capture the commit `git -C <clone_dir> rev-parse HEAD`
# resolves to. Returns a pointer to a NUL-terminated 40-char lowercase-hex
# string, or 0 on failure / not-a-repo. POSIX-only (mirrors the dep clone,
# which already uses fork/execve); the git-dep flow does not run on native
# Windows. Mirrors `_sha256sum_file`'s capture-via-tmpfile pattern.
fn _git_head_sha(clone_dir): i64 {
    var tmpf = _cbt_tmpfile("githead_out");
    var pid = sys_fork();
    if (pid == 0) {
        var ofd = sys_open(tmpf, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
        sys_dup2(ofd, 1);
        sys_close(ofd);
        # Silence stderr so a non-repo dir doesn't pollute the user's output.
        var efd = sys_open("/dev/null", O_WRONLY, 0);
        if (efd >= 0) { sys_dup2(efd, 2); sys_close(efd); }
        var argv[64];   # N BYTES: 7 ptrs need 56 B
        store64(&argv, "env");
        store64(&argv + 8, "git");
        store64(&argv + 16, "-C");
        store64(&argv + 24, clone_dir);
        store64(&argv + 32, "rev-parse");
        store64(&argv + 40, "HEAD");
        store64(&argv + 48, 0);
        sys_execve("/usr/bin/env", &argv, _envp);
        sys_exit(127);
    }
    var sb[1];
    sys_waitpid(pid, &sb, 0);
    var buf = alloc(128);
    var nn = file_read_all(tmpf, buf, 127);
    sys_unlink(tmpf);
    if (nn < 40) { return 0; }
    var sha = alloc(41);
    memcpy(sha, buf, 40);
    store8(sha + 40, 0);
    # Sanity: all 40 chars must be hex (0-9a-fA-F), else not a valid SHA.
    var hi = 0;
    while (hi < 40) {
        var hc = load8(sha + hi);
        var ishex = 0;
        if (hc >= 48 && hc <= 57) { ishex = 1; }
        if (hc >= 97 && hc <= 102) { ishex = 1; }
        if (hc >= 65 && hc <= 70) { ishex = 1; }
        if (ishex == 0) { return 0; }
        hi = hi + 1;
    }
    return sha;
}

# CVE-21 (v6.2.30) — returns 1 iff `git -C <dir> diff-index --quiet HEAD`
# exits 0 (the working tree matches HEAD), else 0 (dirty, signalled, or git
# error). Closes the in-place-tamper / snapshot-ping-pong write-through gap a
# bare `rev-parse HEAD` pin misses: an edit to a tracked .cyr that never touches
# .git leaves HEAD on the pinned SHA, so the SHA check alone would pass. A fresh
# clone's tree is always clean, so this is a no-op cost on the happy path.
# POSIX-only (mirrors the dep clone).
fn _git_worktree_clean(clone_dir): i64 {
    var pid = sys_fork();
    if (pid == 0) {
        var nfd = sys_open("/dev/null", O_WRONLY, 0);
        if (nfd >= 0) { sys_dup2(nfd, 1); sys_dup2(nfd, 2); sys_close(nfd); }
        var argv[64];   # N BYTES: 8 ptrs need 64 B
        store64(&argv, "env");
        store64(&argv + 8, "git");
        store64(&argv + 16, "-C");
        store64(&argv + 24, clone_dir);
        store64(&argv + 32, "diff-index");
        store64(&argv + 40, "--quiet");
        store64(&argv + 48, "HEAD");
        store64(&argv + 56, 0);
        sys_execve("/usr/bin/env", &argv, _envp);
        sys_exit(127);
    }
    var wst[8];
    sys_waitpid(pid, &wst, 0);
    var st = load64(&wst);
    if ((st & 127) != 0) { return 0; }          # killed by signal → distrust
    if (((st >> 8) & 255) != 0) { return 0; }   # non-zero exit → dirty / error
    return 1;
}

# CVE-21 (v6.2.30) — look up the previously-locked commit SHA for a dep,
# keyed on (name, git, tag) so a deliberate tag bump in cyrius.cyml does not
# false-trip (different tag → no match → re-pin). Returns a NUL-terminated SHA
# pointer, 0 if the lock has no matching commit line, or -1 if a commit line
# FOR THIS dep name is present but malformed/truncated (fewer than the 4
# tab-delimited fields) — the caller fails closed instead of silently TOFU-
# re-pinning a corrupted pin.
fn _lock_commit_lookup(name, git, tag): i64 {
    if (file_exists("cyrius.lock") == 0) { return 0; }
    var cap = 65536;
    var lbuf = alloc(cap);
    var ln = file_read_all("cyrius.lock", lbuf, cap - 1);
    if (ln <= 0) { return 0; }
    store8(lbuf + ln, 0);
    var pos = 0;
    while (pos < ln) {
        var le = pos;
        while (le < ln && load8(lbuf + le) != 10) { le = le + 1; }
        # Commit line marker: "commit" + TAB (0x09).
        if (le - pos > 7 && memeq(lbuf + pos, "commit", 6) == 1 && load8(lbuf + pos + 6) == 9) {
            var p = pos + 7;
            # `well` stays 1 only if each of the 3 internal field separators
            # (sha|name, name|git, git|tag) is actually a tab — a truncated line
            # leaves it 0 and is treated as corruption when the name matches.
            var well = 1;
            var sha_s = p;
            while (p < le && load8(lbuf + p) != 9) { p = p + 1; }
            var sha_e = p;
            if (p < le) { p = p + 1; } else { well = 0; }
            var name_s = p;
            while (p < le && load8(lbuf + p) != 9) { p = p + 1; }
            var name_e = p;
            if (p < le) { p = p + 1; } else { well = 0; }
            var git_s = p;
            while (p < le && load8(lbuf + p) != 9) { p = p + 1; }
            var git_e = p;
            if (p < le) { p = p + 1; } else { well = 0; }
            var tag_s = p;
            var tag_e = le;
            var nm_ok = 0;
            if (name_e - name_s == strlen(name) && memeq(lbuf + name_s, name, name_e - name_s) == 1) { nm_ok = 1; }
            if (nm_ok == 1 && well == 0) { return -1; }   # corrupt pin for this dep → fail closed
            var gt_ok = 0;
            if (git_e - git_s == strlen(git) && memeq(lbuf + git_s, git, git_e - git_s) == 1) { gt_ok = 1; }
            var tg_ok = 0;
            if (tag_e - tag_s == strlen(tag) && memeq(lbuf + tag_s, tag, tag_e - tag_s) == 1) { tg_ok = 1; }
            if (nm_ok == 1 && gt_ok == 1 && tg_ok == 1) {
                var slen = sha_e - sha_s;
                var out = alloc(slen + 1);
                memcpy(out, lbuf + sha_s, slen);
                store8(out + slen, 0);
                return out;
            }
        }
        pos = le + 1;
    }
    return 0;
}

# v6.0.2 — is this invocation running inside the cyrius source repo
# itself? Signal: `[package] name = "cyrius"` in cwd's cyrius.cyml.
# Used to skip lock generation here — cyrius authors its own `lib/`
# stdlib (folded sandhi-pattern deps + in-tree modules), so a lock of
# that lib/ is self-referential AND churns the tracked `cyrius.lock`
# on every `check.sh` `cyrius deps` run. cyrius's real external deps
# (mabda) are pinned by tag in `cyrius.cyml`, not by lib-file hash.
#
# Why name-based, not the `src/main.cyr` priority-(a) signal: downstream
# repos (gnoboot, kybernet) ALSO build from `src/main.cyr` + have a
# `./lib` of resolved deps — that conflation was the v6.0.1 mkdir bug.
# `[package] name` is unique to the cyrius project manifest.
fn _dep_is_cyrius_source_repo(): i64 {
    if (file_exists("cyrius.cyml") == 0) { return 0; }
    var buf = alloc(32768);
    var n = file_read_all("cyrius.cyml", buf, 32767);
    if (n <= 0) { return 0; }
    var pos = 0;
    while (pos < n) {
        if (memeq(buf + pos, "[package]", 9) == 1) { break; }
        pos = pos + 1;
    }
    if (pos >= n) { return 0; }
    pos = pos + 9;
    while (pos < n) {
        while (pos < n && (load8(buf + pos) == 10 || load8(buf + pos) == 32 || load8(buf + pos) == 9)) {
            pos = pos + 1;
        }
        if (pos >= n) { return 0; }
        if (load8(buf + pos) == 91) { return 0; }  # `[` → next section
        if (memeq(buf + pos, "name", 4) == 1) {
            var after = pos + 4;
            while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) {
                after = after + 1;
            }
            if (after < n && load8(buf + after) == 61) {   # `=`
                after = after + 1;
                while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) {
                    after = after + 1;
                }
                if (after < n && load8(buf + after) == 34) {   # `"`
                    after = after + 1;
                    # exact match: `name = "cyrius"` (not "cyrius-x")
                    if (memeq(buf + after, "cyrius", 6) == 1 && load8(buf + after + 6) == 34) {
                        return 1;
                    }
                    return 0;
                }
            }
        }
        while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
    }
    return 0;
}

# v6.0.2 — recursively hash every `.cyr` under `dir`, writing
# `<sha256hex>  <path>\n` per file to `lock_fd`. Returns the count.
# Recurses into subdirs (e.g. `lib/unicode/`) so nested stdlib modules
# resolved by `cyrius deps` (v5.8.49 subdir-nested paths) are locked
# too — a flat scan silently omitted them. Replaces the pre-v6.0.2
# symlink-only filter, which was stale since v5.11.8 switched dep
# resolution from symlink to file-copy (`_dep_copy_file`): every
# resolved dep became a real file, `readlink` returned -EINVAL on all
# of them, and the lock came out empty ecosystem-wide.
fn _deps_lock_dir(dir, lock_fd): i64 {
    var count = 0;
    var entries = dir_list(str_from(dir));
    var li = 0;
    while (li < vec_len(entries)) {
        var name = str_data(vec_get(entries, li));
        var nlen = str_len(vec_get(entries, li));
        li = li + 1;
        if (nlen == 0) { continue; }
        if (load8(name) == 46) { continue; }   # skip ".", "..", dotfiles
        var path = make_path(dir, name);
        if (is_dir(str_from(path)) == 1) {
            count = count + _deps_lock_dir(path, lock_fd);
            continue;
        }
        if (nlen < 5) { continue; }
        if (memeq(name + nlen - 4, ".cyr", 4) == 0) { continue; }
        var hash = _sha256sum_file(path);
        if (hash != 0) {
            sys_write(lock_fd, hash, 64);
            sys_write(lock_fd, "  ", 2);
            sys_write(lock_fd, path, strlen(path));
            sys_write(lock_fd, "\n", 1);
            count = count + 1;
        }
    }
    return count;
}

fn cmd_deps_lock(): i64 {
    # v6.0.2: cyrius's own repo authors its lib/ — skip (self-referential
    # + would churn the tracked cyrius.lock on every check.sh). See
    # _dep_is_cyrius_source_repo above + CHANGELOG [6.0.2].
    if (_dep_is_cyrius_source_repo() == 1) {
        println("cyrius.lock: skipped (source repo — lib/ is authored stdlib, not resolved deps)");
        return 0;
    }
    # Generate cyrius.lock by hashing every resolved .cyr under lib/
    # (recursively). See _deps_lock_dir for the v5.11.8-era root cause.
    var lock_fd = sys_open("cyrius.lock", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (lock_fd < 0) { _err("cannot create cyrius.lock"); return 1; }
    # CVE-21 (v6.2.30): write the resolved git-dep commit pins FIRST (one
    # "commit\t<sha>\t<name>\t<git>\t<tag>" line each), BEFORE the per-file
    # content hashes, so they always fall inside _lock_commit_lookup's 64 KB
    # read window even when a large project's hash section grows past it.
    # cmd_deps_verify skips these lines; resolution checks them.
    var _cc = 0;
    if (_dep_commit_lines != 0) {
        var _ci = 0;
        while (_ci < vec_len(_dep_commit_lines)) {
            var _line = vec_get(_dep_commit_lines, _ci);
            sys_write(lock_fd, _line, strlen(_line));
            sys_write(lock_fd, "\n", 1);
            _ci = _ci + 1;
            _cc = _cc + 1;
        }
    }
    var count = _deps_lock_dir("lib", lock_fd);
    sys_close(lock_fd);
    sys_write(STDOUT_FD, "cyrius.lock: ", 13);
    fmt_int(count);
    sys_write(STDOUT_FD, " deps locked", 12);
    if (_cc > 0) {
        sys_write(STDOUT_FD, ", ", 2);
        fmt_int(_cc);
        sys_write(STDOUT_FD, " commit-pinned", 14);
    }
    println("");
    return 0;
}

fn cmd_deps_verify(): i64 {
    # CVE-21 (v6.2.30): 64 KB read window (was 8 KB). The old 8 KB cap silently
    # stopped verifying file-hash lines past the cutoff for any lock >8 KB
    # (real downstream locks already exceed it) — and the commit-pin lines now
    # prepended by cmd_deps_lock ate into that budget. Match _lock_commit_lookup.
    var buf = alloc(65536);
    var n = file_read_all("cyrius.lock", buf, 65535);
    if (n <= 0) {
        _err("no cyrius.lock found — run cyrius deps first");
        return 1;
    }
    store8(buf + n, 0);

    var pass = 0;
    var fail = 0;
    var pos = 0;
    while (pos < n) {
        # CVE-21 (v6.2.30): skip commit-pin lines ("commit\t<sha>\t...") — those
        # are verified during resolution, not by this file-content-hash check.
        if (pos + 7 <= n && memeq(buf + pos, "commit", 6) == 1 && load8(buf + pos + 6) == 9) {
            while (pos < n && load8(buf + pos) != 10) { pos = pos + 1; }
            pos = pos + 1;
            continue;
        }
        # Parse line: 64-char hash, 2 spaces, path, newline
        if (pos + 66 >= n) { break; }
        var expected_hash = buf + pos;
        var path_start = pos + 66;
        var path_end = path_start;
        while (path_end < n && load8(buf + path_end) != 10) { path_end = path_end + 1; }

        var plen = path_end - path_start;
        var path = alloc(plen + 1);
        memcpy(path, buf + path_start, plen);
        store8(path + plen, 0);

        var actual_hash = _sha256sum_file(path);
        if (actual_hash == 0) {
            sys_write(STDERR_FD, "  FAIL: ", 8);
            sys_write(STDERR_FD, path, plen);
            sys_write(STDERR_FD, " (cannot hash)\n", 15);
            fail = fail + 1;
        } elif (memeq(actual_hash, expected_hash, 64) == 1) {
            pass = pass + 1;
        } else {
            sys_write(STDERR_FD, "  FAIL: ", 8);
            sys_write(STDERR_FD, path, plen);
            sys_write(STDERR_FD, " (hash mismatch)\n", 17);
            fail = fail + 1;
        }

        pos = path_end + 1;
    }

    fmt_int(pass);
    sys_write(STDOUT_FD, " verified, ", 11);
    fmt_int(fail);
    println(" failed");
    if (fail > 0) { return 1; }
    return 0;
}
