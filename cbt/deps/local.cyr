# CLI — deps: LOCAL MODE — the [deps.NAME] record, the switch, git working-tree queries, the source decision.
# ================================================================
# Split from cbt/deps.cyr at 6.7.18, unchanged; cbt/cyrius.cyr includes the pieces in order. CHANGELOG [6.7.18]

# ================================================================
# LOCAL MODE — git first, local development by an explicit switch (6.7.6, lane C)
# ================================================================
# THE RULE (user, 2026-10-08). The committed manifest means the TAGS: every `[deps.X]` with a git
# source resolves its tag, its commit pin checked — on a dev box exactly as in CI. A `path` beside
# `git` / `tag` is a DEV OVERRIDE, read only in local mode, and only the CLI switches that on:
#     --local / --local=a,b   > --no-local >   CYRIUS_LOCAL=1 / CYRIUS_LOCAL=a,b   > off
# (`--locked`, `publish`, `package`, `distlib` and `update` resolve what a release ships: the switch
# is off there, and `--local` is refused by name). Until 6.7.6 a path beside git/tag won whenever
# the directory existed — silently, with no clone and no commit pin — so a dev box and CI built
# different code from one manifest, and the ecosystem toggled path lines in and out by hand (166
# commits in 47 repos; 9 repos ran their own CI guards against a committed path).
#
# Per root `[deps.X]` (`_dep_pick`):
#   path + git, selected, a directory  -> the working tree, no clone; one `local:` line
#   path + git, otherwise              -> the tag; a checkout that exists is named in ONE hint line
#   path only (no git)                 -> local-only: the path, in both modes (no tag to prefer)
# A dependency's OWN manifest (`_dep_ctx_kind` != 0):
#   resolved from a clone   -> its `path` beside a remote git is dropped (its developers' business,
#                              never its published meaning); a path-only or local-git entry is
#                              REFUSED by name (it resolves on its author's box and nowhere else)
#   a local checkout        -> its overrides are followed for the selected names; its path-only
#                              entries need the name selected unless it is itself local-only
#   either                  -> an absolute path / absolute local git is refused (not portable)
# LOCAL MODE WRITES NO TRACKED FILE. When an override is actually in use (`_dep_local_prescan`) the
# whole resolution is vendored into build/local-deps/lib/ and cyrius.lock is not written, so lib/
# and the lock stay what the tag resolution wrote and switching modes churns nothing. Every include
# string stays `lib/<file>`; the compiler reads lib/ through CYRIUS_LIB_OVERLAY=build/local-deps/lib
# (src/frontend/lex/lex.cyr `_rf_ov_open`), which is what makes a source's own `include "lib/sigil.cyr"`
# read the override instead of compiling the tag copy beside it. CHANGELOG [6.7.6]

# A [deps.NAME] section's keys, from the line at buf[si] up to the next table header of either
# kind, into the `_DS_*` slots of `rec` (`_DS_SIZE` bytes). Returns where that header starts.
# path / git / tag / target are TOML strings (6.6.17, m6: another type sets `_DS_BAD`); modules /
# requires / modular are string arrays; optional is the bareword `true` or `false`. A key nothing
# reads is listed in `_DS_UNKNOWN`.
fn _dep_sec_read(buf, n, si, manifest_dir, rec): i64 {
    var z = 0;
    while (z < _DS_SIZE) { store64(rec + z, 0); z = z + 8; }
    store64(rec + _DS_UNKNOWN, vec_new());
    var info[32];
    while (si < n) {
        var nx = _toml_line(buf, n, si, &info);
        var kind = load64(&info);
        if (kind == 1 || kind == 2) { break; }
        si = nx;
        if (kind == 3) {
            var ks = load64(&info + 8);
            var kl = load64(&info + 16);
            var kv = load64(&info + 24);
            var ke = 0;
            if (_dep_key_is(buf, ks, kl, "path") == 1) {
                var p = _toml_str_at(buf, n, kv, &ke);
                if (p == 0) { store64(rec + _DS_BAD, "path"); }
                else {
                    store64(rec + _DS_RAW, p);
                    # v5.7.14: relative to the manifest's directory, not the consumer's cwd
                    store64(rec + _DS_PATH, _dep_join_path(manifest_dir, p));
                }
            } elif (_dep_key_is(buf, ks, kl, "git") == 1) {
                var g = _toml_str_at(buf, n, kv, &ke);
                if (g == 0) { store64(rec + _DS_BAD, "git"); } else { store64(rec + _DS_GIT, g); }
            } elif (_dep_key_is(buf, ks, kl, "tag") == 1) {
                var t = _toml_str_at(buf, n, kv, &ke);
                if (t == 0) { store64(rec + _DS_BAD, "tag"); } else { store64(rec + _DS_TAG, t); }
            } elif (_dep_key_is(buf, ks, kl, "target") == 1) {
                # v6.3.1 lever 2: resolve this dep only on a matching build target
                var tg = _toml_str_at(buf, n, kv, &ke);
                if (tg == 0) { store64(rec + _DS_BAD, "target"); } else { store64(rec + _DS_TARGET, tg); }
            } elif (_dep_key_is(buf, ks, kl, "modules") == 1) {
                store64(rec + _DS_MODULES, _parse_toml_str_array(buf, n, ks + kl));
            } elif (_dep_key_is(buf, ks, kl, "requires") == 1) {
                # v6.2.46 (lever 1 / Phase A): the stdlib leaves a fold needs in scope; v6.2.49
                # Phase B expands [groups] references
                store64(rec + _DS_REQUIRES, _dep_expand_groups(_parse_toml_str_array(buf, n, ks + kl)));
            } elif (_dep_key_is(buf, ks, kl, "modular") == 1) {
                # v6.2.50 Phase C: individual sub-modules from the dep's `dist/<name>/`
                store64(rec + _DS_MODULAR, _parse_toml_str_array(buf, n, ks + kl));
            } elif (_dep_key_is(buf, ks, kl, "scope") == 1) {
                # 6.7.6 (part T): `scope = "test"` — resolved by every resolve, prepended to test /
                # bench / fuzz compiles only; the one scope there is
                var sc = _toml_str_at(buf, n, kv, &ke);
                if (sc == 0) { store64(rec + _DS_BAD, "scope"); }
                else {
                    store64(rec + _DS_SCOPEV, sc);
                    if (streq(sc, "test") == 1) { store64(rec + _DS_SCOPE, 1); }
                    else { store64(rec + _DS_SCOPE, 0 - 1); }
                }
            } elif (_dep_key_is(buf, ks, kl, "optional") == 1) {
                # v6.3.1 lever 2. The whole bareword: this read the first byte, so `tru` meant true.
                var ob = _dep_bareword_bool(buf, n, kv);
                store64(rec + _DS_OPTIONAL, ob);
                if (ob < 0) { store64(rec + _DS_BAD, "optional"); }
            } else {
                var uk = alloc(kl + 1);
                memcpy(uk, buf + ks, kl);
                store8(uk + kl, 0);
                vec_push(load64(rec + _DS_UNKNOWN), uk);
            }
        }
    }
    return si;
}

# 1 when the git value names a REMOTE repository: `scheme://…` (file:// included) or scp-like
# `[user@]host:path`. Anything else — `../repo`, `/abs/repo`, `C:\repo`, a bare name — is a LOCAL
# repository, which resolves on its author's box and nowhere else.
fn _dep_git_remote(g): i64 {
    var i = 0;
    while (load8(g + i) != 0) {
        var c = load8(g + i);
        if (c == 47 || c == 92) { return 0; }            # a '/' or '\' before any ':' — a path
        if (c == 58) {                                   # ':'
            if (load8(g + i + 1) == 47 && load8(g + i + 2) == 47) { return 1; }   # scheme://
            if (i >= 2) { return 1; }                    # host:path (a one-letter "host" is a drive)
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# 1 for an absolute path: `/…`, `\…` or a drive `X:`.
fn _dep_path_abs(p): i64 {
    var c = load8(p);
    if (c == 47 || c == 92) { return 1; }
    if (c != 0 && load8(p + 1) == 58) { return 1; }
    return 0;
}

# 1 when local mode selects `name` (every override, or one named in the switch).
fn _dep_selected(name): i64 {
    if (_dep_local_on == 0) { return 0; }
    if (_dep_local_names == 0) { return 1; }
    return _dep_list_has(_dep_local_names, name);
}

# 1 when lib/ holds no vendored file — absent, or no `.cyr` under it: what a fresh checkout of a
# project that ignores lib/ has. --locked then holds the resolve to cyrius.lock alone.
fn _dep_lib_unvendored(): i64 {
    if (is_dir(str_from("lib")) == 0) { return 1; }
    return 1 - _dep_dir_holds_cyr("lib", 0);
}

# 1 when `dir` holds a `.cyr` file at any depth (dotfiles skipped, as the lock's walk skips them),
# or cannot be listed — a lib/ that is there but unreadable is compared, and the compare names it.
fn _dep_dir_holds_cyr(dir, depth): i64 {
    if (depth > 32) { return 1; }
    var ents = vec_new();
    if (dir_list_checked(str_from(dir), ents) < 0) { return 1; }
    var i = 0;
    while (i < vec_len(ents)) {
        var en = vec_get(ents, i);
        i = i + 1;
        var ed = str_data(en);
        var el = str_len(en);
        if (el == 0 || load8(ed) == 46) { continue; }
        var nm = alloc(el + 1);
        memcpy(nm, ed, el);
        store8(nm + el, 0);
        var p = make_path(dir, nm);
        if (is_dir(str_from(p)) == 1) {
            if (_dep_dir_holds_cyr(p, depth + 1) == 1) { return 1; }
            continue;
        }
        if (el > 4 && memeq(nm + el - 4, ".cyr", 4) == 1) { return 1; }
    }
    return 0;
}

# 1 when the verb this --locked resolve serves compiles afterwards (every resolving verb but `deps`),
# so a resolve proved against cyrius.lock with no lib/ to compile from is kept for the compile.
fn _dep_locked_compiles(): i64 {
    if (_dep_switch_verb == 0) { return 0; }
    if (streq(_dep_switch_verb, "deps") == 1) { return 0; }
    return 1;
}

# 1 when this run writes lib/ and cyrius.lock (no override in use, not --locked).
fn _dep_writes_lib(): i64 {
    if (_dep_local_active == 1) { return 0; }
    if (_dep_locked == 1) { return 0; }
    return 1;
}

# Where vendored file `rel` (e.g. "sigil.cyr", "unicode/x.cyr") is WRITTEN this run, and the
# include string every compile names it by. The second is always lib/<rel>: local mode's compiles
# read lib/ through CYRIUS_LIB_OVERLAY, and --locked compiles from lib/ only once it is proved to
# equal what the tags resolve (with no vendored lib/, from build/locked-deps/lib through the overlay).
fn _dep_wpath(rel): i64 { return _cat2(_cat2(_dep_vroot, "/"), rel); }
fn _dep_ipath(rel): i64 { return _cat2("lib/", rel); }

# 6.7.6 — the switch for this run, from the arguments and the environment (see the rule above).
# `verb` decides whether this verb resolves what a release ships. 0, or 1 after naming a refusal.
fn _dep_switch_setup(verb): i64 {
    _dep_switch_verb = verb;
    _dep_local_on = 0;
    _dep_local_names = 0;
    _dep_local_from = 0;
    _dep_local_ign = 0;
    _dep_locked = 0;
    if (_cli_has("--locked") == 1) { _dep_locked = 1; }
    else {
        var le = _dep_locked_env();
        if (le < 0) { return 1; }
        _dep_locked = le;
    }
    # `update` refreshes lib/ and re-resolves into it: the whole verb is a write
    if (_dep_locked == 1 && streq(verb, "update") == 1) { return _dep_locked_refuse("cyrius update", "lib/ and cyrius.lock"); }
    var rel = _dep_verb_rel(verb);
    var argl = _cli_has("--local");
    var argn = _cli_has("--no-local");
    if (argl == 1 && argn == 1) { _err("--local and --no-local contradict each other"); return 1; }
    if (argl == 1) {
        if (_dep_locked == 1) {
            _err("--local and --locked contradict each other: --locked resolves the tags CI builds, --local the sibling checkouts");
            return 1;
        }
        if (rel == 1) {
            _ew("error: cyrius ");
            _ew(verb);
            _ew(" resolves what a release ships, the tags — --local is refused\n");
            return 1;
        }
        _dep_local_on = 1;
        _dep_local_from = "--local";
        var v = _cli_val("--local");
        if (v != 0) {
            _dep_local_names = _split_csv(v);
            if (vec_len(_dep_local_names) == 0) {
                _err("--local= names no dependency (--local alone selects every override)");
                return 1;
            }
        }
        return _dep_names_ok("--local");
    }
    if (argn == 1) { return 0; }
    var e = _cfg_env("CYRIUS_LOCAL");
    if (e == 0) { return 0; }
    if (streq(e, "0") == 1) { return 0; }
    if (_dep_locked == 1) { _dep_local_ign = "--locked resolves the tags"; return 0; }
    if (rel == 1) { _dep_local_ign = _cat2(_cat2("cyrius ", verb), " resolves the tags"); return 0; }
    _dep_local_on = 1;
    _dep_local_from = "CYRIUS_LOCAL";
    if (streq(e, "1") == 0) {
        _dep_local_names = _split_csv(e);
        if (vec_len(_dep_local_names) == 0) { _dep_local_on = 0; return 0; }
    }
    return _dep_names_ok("CYRIUS_LOCAL");
}

# 1 for a verb that resolves what a release ships — the tags, whatever the local switch says.
fn _dep_verb_rel(verb): i64 {
    if (streq(verb, "publish") == 1 || streq(verb, "package") == 1) { return 1; }
    if (streq(verb, "distlib") == 1 || streq(verb, "update") == 1) { return 1; }
    return 0;
}

# 1 when this run honours the local switch: not --locked and not a release verb. The hint line
# tells the developer the switch builds an unused checkout, so it is said only where it would —
# `cyrius package` printed it, CYRIUS_LOCAL set or not, beside "CYRIUS_LOCAL is ignored here".
fn _dep_switch_honoured(): i64 {
    if (_dep_locked == 1) { return 0; }
    if (_dep_switch_verb == 0) { return 1; }
    return 1 - _dep_verb_rel(_dep_switch_verb);
}

# CYRIUS_LOCKED as --locked reads it: 1, 0 (unset or "0"), or -1 after naming any other value.
fn _dep_locked_env(): i64 {
    var le = _cfg_env("CYRIUS_LOCKED");
    if (le == 0) { return 0; }
    if (streq(le, "1") == 1) { return 1; }
    if (streq(le, "0") == 1) { return 0; }
    _err_ctx("CYRIUS_LOCKED must be 0 or 1 (or unset)", _shown(le));
    return 0 - 1;
}

# 6.7.6 — LOCKED MEANS NOTHING IS WRITTEN, in every verb. A verb whose whole job is a write
# (`update`, `deps --lock` / `--relock`, `lib sync`) is refused by name under CYRIUS_LOCKED=1 /
# --locked rather than run: `update` wrote ~100 files into lib/ and then reported "nothing was
# written", and `deps --lock` rewrote the lock (6.7.6 review). Always 1.
fn _dep_locked_refuse(what, writes): i64 {
    _ew("error: ");
    _ew(what);
    _ew(" writes ");
    _ew(writes);
    if (_cli_has("--locked") == 1) { _ew(", and --locked means nothing is written — refused\n"); }
    else { _ew(", and CYRIUS_LOCKED=1 means nothing is written — refused (unset it, or CYRIUS_LOCKED=0, to run it)\n"); }
    return 1;
}

# Each selected name must be one a [deps.NAME] header could carry (the header rule).
fn _dep_names_ok(from): i64 {
    if (_dep_local_names == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_dep_local_names)) {
        var nm = vec_get(_dep_local_names, i);
        if (_dep_name_unsafe(nm) == 1) {
            _ew("error: ");
            _ew(from);
            _ew(" names '");
            _ew_shown(nm);
            _ew("', which is not a dependency name\n");
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# `cyrius build --print-config`: the dependency switch, as the resolve would read it.
fn _dep_print_switch(): i64 {
    _cfg_out("  deps.local = ");
    if (_dep_local_on == 0) {
        _cfg_out("off  (");
        if (_dep_local_ign != 0) { _cfg_out("CYRIUS_LOCAL ignored: "); _cfg_out(_dep_local_ign); }
        else { _cfg_out("default: every [deps.X] path beside git/tag is ignored; the tags resolve"); }
        _cfg_out(")\n");
    } else {
        if (_dep_local_names == 0) { _cfg_out("on, every override"); }
        else {
            _cfg_out("on: ");
            var i = 0;
            while (i < vec_len(_dep_local_names)) {
                if (i > 0) { _cfg_out(", "); }
                _cfg_out(_shown(vec_get(_dep_local_names, i)));
                i = i + 1;
            }
        }
        _cfg_out("  (");
        _cfg_out(_dep_local_from);
        _cfg_out(")\n");
    }
    _cfg_out("  deps.locked = ");
    if (_dep_locked == 1) {
        _cfg_out("true  (");
        if (_cli_has("--locked") == 1) { _cfg_out("argument: --locked"); } else { _cfg_out("environment: CYRIUS_LOCKED"); }
        _cfg_out(")\n");
    } else { _cfg_out("false  (default)\n"); }
    return 0;
}

# Remove `p` and everything under it, never following a link (a link is unlinked, not entered).
# For directories this CLI owns: build/local-deps/lib, the --locked scratch, an untagged clone.
fn _dep_rm_tree(p): i64 {
    var ps = str_from(p);
    if (is_symlink(ps) == 1) { return sys_unlink(p); }
    if (is_dir(ps) == 0) {
        if (file_exists(p) == 1) { return sys_unlink(p); }
        return 0;
    }
    var ents = dir_list(ps);
    var i = 0;
    while (i < vec_len(ents)) {
        var en = vec_get(ents, i);
        i = i + 1;
        var ed = str_data(en);
        var el = str_len(en);
        if (el == 1 && load8(ed) == 46) { continue; }
        if (el == 2 && load8(ed) == 46 && load8(ed + 1) == 46) { continue; }
        var nm = alloc(el + 1);
        memcpy(nm, ed, el);
        store8(nm + el, 0);
        _dep_rm_tree(make_path(p, nm));
    }
    return xrmdir(p);
}

# The parent directory of absolute path `p` (trailing `/` dropped first; `/` for a top-level entry).
fn _dep_parent_dir(p): i64 {
    var pe = strlen(p);
    while (pe > 0 && load8(p + pe - 1) == 47) { pe = pe - 1; }
    while (pe > 0 && load8(p + pe - 1) != 47) { pe = pe - 1; }
    if (pe > 1) { pe = pe - 1; }
    var par = alloc(pe + 1);
    memcpy(par, p, pe);
    store8(par + pe, 0);
    return par;
}

# IN A GIT CHILD ONLY (it changes the working directory, right before the exec): chdir to `dir`
# and read the cwd back — the PHYSICAL path, every symlink resolved — or 0 when the chdir fails
# (nothing changed), "." when the cwd then cannot be read (the child is in `dir`). CHANGELOG [6.7.12]
fn _dep_child_phys(dir): i64 {
    if (sys_chdir(dir) != 0) { return 0; }
    var b = alloc(4096);
    if (_cwd_read(b, 4096) < 0) { return "."; }
    return b;
}

# Run `git [-C dir] -c … a1 a2 a3 a4` for a READ-ONLY question about a working tree, a cache or a
# remote (`rev-parse`, `rev-list`, `status`, `check-ignore`, `ls-remote`). stdout goes to `outf`
# (0 = discarded), stderr to a capture whose first line is kept in `_dep_wt_why` before it is removed
# (6.7.10: it was kept for the process's life, and the CLI's private temp dir — rmdir'd, never swept —
# was left behind holding it after every local-mode resolve). With `dir`, discovery stops
# at its parent (GIT_CEILING_DIRECTORIES), so a directory that is not a checkout never answers for
# an enclosing repository; `--no-optional-locks` keeps `status` from rewriting the sibling's index.
# Returns git's exit status, or -1 when git could not be run (no fork on this platform included).
fn _dep_wt_run(dir, a1, a2, a3, a4, outf): i64 {
    _dep_wt_why = 0;
    if (_git_exec_available() == 0) { return 0 - 1; }
    var ceil = 0;
    if (dir != 0) { ceil = _cat2("GIT_CEILING_DIRECTORIES=", _dep_parent_dir(_abs_path(dir))); }
    var errf = _cbt_tmpfile("wt_err");
    var cfd = 0 - 1;
    if (outf != 0) {
        # The stdout capture is the caller's scratch: registered before it exists, so a kill while
        # git runs unlinks it; the caller drops it. CHANGELOG [6.7.13]
        _cbt_scratch_track(outf);
        cfd = sys_open(outf, O_WRONLY | O_CREAT | O_TRUNC, 0x180);
        if (cfd < 0) { _cbt_scratch_untrack(outf); return 0 - 1; }
    }
    # The kill handler unlinks `wt_err` (the child creates it) and stops git, as for compile()'s
    # compiler; both are dropped once git is reaped and its first line read. CHANGELOG [6.7.13]
    _cbt_scratch_track(errf);
    var pid = _cbt_fork_tracked(0);
    if (pid < 0) { if (cfd >= 0) { sys_close(cfd); } _cbt_scratch_untrack(errf); return 0 - 1; }
    if (pid == 0) {
        # The capture opened in the PARENT: one started with fd 0 closed put it AT 0, and the
        # stdin redirect below overwrote it before the stdout redirect read it. CHANGELOG [6.7.16]
        var lfd = _cbt_lift_fd(cfd);
        var nfd = sys_open("/dev/null", O_RDONLY, 0);
        if (nfd >= 0) { _cbt_redirect(nfd, 0); }
        var ofd = lfd;
        if (outf == 0) { ofd = sys_open("/dev/null", O_WRONLY, 0); }
        if (ofd >= 0) { _cbt_redirect(ofd, 1); }
        var efd = sys_open(errf, O_WRONLY | O_CREAT | O_TRUNC, 0x180);
        if (efd < 0) { efd = sys_open("/dev/null", O_WRONLY, 0); }
        if (efd >= 0) { _cbt_redirect(efd, 2); }
        # The ceiling is the parent of the PHYSICAL directory, where git starts its discovery: a
        # dep reached through a symlink (`links/foo -> ../mono/libs/foo`) got the LINK's parent,
        # and git walked up from the target into the enclosing repository. CHANGELOG [6.7.12]
        var cdir = dir;
        if (dir != 0) {
            cdir = _dep_child_phys(dir);
            if (cdir == 0) { cdir = dir; }
            elif (load8(cdir) == 47) { ceil = _cat2("GIT_CEILING_DIRECTORIES=", _dep_parent_dir(cdir)); }
        }
        var argv[512];   # N BYTES: <= 64 ptrs
        var i = _git_env_argv(&argv, 0);
        if (ceil != 0) { i = _ga(&argv, i, ceil); }
        i = _ga(&argv, i, "git");
        i = _ga(&argv, i, "--no-optional-locks");
        i = _git_no_plaintext(&argv, i);   # ls-remote fetches (6.7.18)
        if (dir != 0) { i = _ga(&argv, i, "-C"); i = _ga(&argv, i, cdir); }
        i = _ga(&argv, i, "-c"); i = _ga(&argv, i, "core.fsmonitor=false");
        i = _ga(&argv, i, "-c"); i = _ga(&argv, i, "core.hooksPath=/dev/null");
        if (a1 != 0) { i = _ga(&argv, i, a1); }
        if (a2 != 0) { i = _ga(&argv, i, a2); }
        if (a3 != 0) { i = _ga(&argv, i, a3); }
        if (a4 != 0) { i = _ga(&argv, i, a4); }
        store64(&argv + i * 8, 0);
        sys_execve("/usr/bin/env", &argv, _envp);
        sys_exit(127);
    }
    if (cfd >= 0) { sys_close(cfd); }
    var wst[8];
    store64(&wst, 0);
    var wr = sys_waitpid(pid, &wst, 0);
    _cbt_child_untrack(pid);
    _dep_wt_why = _git_first_line_of(errf);
    _cbt_scratch_drop(errf);
    if (wr < 0) { return 0 - 1; }
    var st = load64(&wst);
    if ((st & 127) != 0) { return 0 - 1; }
    return (st >> 8) & 255;
}

# The first line of `git … a1 a2 a3 a4`'s output (trimmed), or 0 when git failed. "" when it
# succeeded and printed nothing.
fn _dep_wt_out(dir, a1, a2, a3, a4): i64 {
    var tf = _cbt_tmpfile("wt_out");
    var rc = _dep_wt_run(dir, a1, a2, a3, a4, tf);
    if (rc != 0) { _cbt_scratch_drop(tf); return 0; }
    var nn = 0;
    var buf = file_read_whole(tf, &nn);
    _cbt_scratch_drop(tf);
    if (buf == 0 || nn < 0) { return ""; }
    var i = 0;
    while (i < nn && load8(buf + i) != 10 && load8(buf + i) != 13) { i = i + 1; }
    store8(buf + i, 0);
    return buf;
}

# Where a local checkout stands against `tag`: " @1a2b3c4, 3 commits past 3.9.9, dirty" — or
# " (not a git checkout)". `tag` 0 for an untagged dep.
fn _dep_local_state(path, tag): i64 {
    if (_git_exec_available() == 0) { return " (git cannot be run on this platform: no checkout state)"; }
    var sha = _dep_wt_out(path, "rev-parse", "--short=7", "HEAD", 0);
    if (sha == 0) { return " (not a git checkout)"; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, " @");
    str_builder_add_cstr(sb, sha);
    if (tag != 0) {
        var ahead = _dep_wt_out(path, "rev-list", "--count", _cat2(tag, "..HEAD"), 0);
        if (ahead == 0) {
            str_builder_add_cstr(sb, ", tag ");
            str_builder_add_cstr(sb, _shown(tag));
            str_builder_add_cstr(sb, " is not in this checkout");
        } else {
            var behind = _dep_wt_out(path, "rev-list", "--count", _cat2("HEAD..", tag), 0);
            if (streq(ahead, "0") == 1 && behind != 0 && streq(behind, "0") == 1) {
                str_builder_add_cstr(sb, ", at ");
                str_builder_add_cstr(sb, _shown(tag));
            } else {
                str_builder_add_cstr(sb, ", ");
                str_builder_add_cstr(sb, ahead);
                if (streq(ahead, "1") == 1) { str_builder_add_cstr(sb, " commit past "); }
                else { str_builder_add_cstr(sb, " commits past "); }
                str_builder_add_cstr(sb, _shown(tag));
                if (behind != 0 && streq(behind, "0") == 0) {
                    str_builder_add_cstr(sb, ", ");
                    str_builder_add_cstr(sb, behind);
                    str_builder_add_cstr(sb, " behind it");
                }
            }
        }
    }
    var dirty = _dep_wt_out(path, "status", "--porcelain", 0, 0);
    if (dirty != 0 && strlen(dirty) > 0) { str_builder_add_cstr(sb, ", dirty"); }
    return str_data(str_builder_build(sb));
}

# What CI builds for a dep, for the `local:` line: "3.9.9", or "the default branch of <url>".
fn _dep_ci_builds(git, tag): i64 {
    if (tag != 0) { return _shown(tag); }
    if (git != 0) { return _cat2("the default branch of ", _shown(git)); }
    return "nothing (no git)";
}

# The `local:` line for an override in use, and its `deps -v` description.
#     local: sigil <- ../sigil @1a2b3c4, 118 commits past 3.9.9, dirty — CI builds 3.9.9
fn _dep_say_local(name, rec, owner): i64 {
    var raw = load64(rec + _DS_RAW);
    var st = _dep_local_state(load64(rec + _DS_PATH), load64(rec + _DS_TAG));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "local ");
    str_builder_add_cstr(sb, _shown(raw));
    str_builder_add_cstr(sb, st);
    var desc = str_data(str_builder_build(sb));
    _ew("local: ");
    _ew_shown(name);
    _ew(" <- ");
    _ew_shown(raw);
    if (owner != 0) { _ew(" (via "); _ew_shown(owner); _ew(")"); }
    _ew(st);
    _ew(" — CI builds ");
    _ew(_dep_ci_builds(load64(rec + _DS_GIT), load64(rec + _DS_TAG)));
    _ew("\n");
    return desc;
}

# Named refusal of an entry in a dependency's own manifest. `what` finishes the sentence.
fn _dep_refuse_entry(owner, name, key, val, what): i64 {
    _ew("error: ");
    if (owner != 0) { _ew_shown(owner); _ew("'s manifest names [deps."); }
    else { _ew("cyrius.cyml [deps."); }
    _ew_shown(name);
    _ew("] ");
    _ew(key);
    _ew(" = \"");
    _ew_shown(val);
    _ew("\"");
    _ew(what);
    _ew("\n");
    return 0 - 1;
}

# Remember that a walked manifest gave `name` a `path` (for the unused-selection warning).
fn _dep_note_seen(name): i64 {
    if (_dep_local_seen == 0) { _dep_local_seen = vec_new(); }
    if (_dep_list_has(_dep_local_seen, name) == 0) { vec_push(_dep_local_seen, name); }
    return 0;
}

# The scheme of a PLAINTEXT git URL — "git", "http" or "ftp" (`<scheme>://…`, or a remote
# helper's `<scheme>::…`, any case) — else 0. https://, ssh://, scp-like `[user@]host:path`,
# file:// and local paths are not plaintext over a network. CHANGELOG [6.7.18]
fn _dep_git_plaintext(g): i64 {
    var i = 0;
    while (i < 8 && load8(g + i) != 0 && load8(g + i) != 58) { i = i + 1; }
    if (load8(g + i) != 58) { return 0; }
    if (load8(g + i + 1) != 47 || load8(g + i + 2) != 47) {
        if (load8(g + i + 1) != 58) { return 0; }   # neither `://` nor `::`
    }
    var lo = alloc(i + 1);
    var k = 0;
    while (k < i) {
        var c = load8(g + k);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(lo + k, c);
        k = k + 1;
    }
    store8(lo + i, 0);
    if (streq(lo, "git") == 1) { return "git"; }
    if (streq(lo, "http") == 1) { return "http"; }
    if (streq(lo, "ftp") == 1) { return "ftp"; }
    return 0;
}

# THE SOURCE DECISION for one [deps.NAME] entry of the manifest being walked (`kind`, `owner`):
# 1 = its `path` (a working tree), 0 = its git (a clone; nothing when it has no git), -1 = refused
# by name. `mode` 0 = the local-mode prescan (silent), 1 = the resolve, 2 = the dry run.
# ⛔ A git source over a PLAINTEXT transport (git://, http://, ftp://) is refused by name (the
# user, 2026-10-22): an on-path attacker substituted the dependency on its first fetch, and the
# lock then commit-pinned whatever arrived (Finding 26 of the 2026-10-22 audit). CHANGELOG [6.7.18]
fn _dep_pick(name, rec, kind, owner, mode): i64 {
    var r = _dep_pick_src(name, rec, kind, owner, mode);
    if (r != 0) { return r; }
    var git = load64(rec + _DS_GIT);
    if (git == 0) { return 0; }
    var pl = _dep_git_plaintext(git);
    if (pl == 0) { return 0; }
    if (mode == 0) { return 0 - 1; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ", a plaintext ");
    str_builder_add_cstr(sb, pl);
    str_builder_add_cstr(sb, " URL — anyone on the network path can substitute the dependency (and the commit cyrius.lock pins); use https:// or ssh://; refused");
    return _dep_refuse_entry(owner, name, "git", git, str_data(str_builder_build(sb)));
}

fn _dep_pick_src(name, rec, kind, owner, mode): i64 {
    var raw = load64(rec + _DS_RAW);
    var path = load64(rec + _DS_PATH);
    var git = load64(rec + _DS_GIT);
    var remote = 0;
    if (git != 0) { remote = _dep_git_remote(git); }
    var sel = _dep_selected(name);
    if (raw != 0) { _dep_note_seen(name); }
    var pdir = 0;
    if (path != 0) { pdir = is_dir(str_from(path)); }
    if (kind == 0) {
        if (raw != 0 && git != 0) {
            if (sel == 1 && pdir == 1) { return 1; }
            if (sel == 1 && mode != 0) {
                _ew("local: ");
                _ew_shown(name);
                _ew(": ");
                _ew_shown(raw);
                _ew(" is not a directory — building ");
                _ew(_dep_ci_builds(git, load64(rec + _DS_TAG)));
                _ew(" from git\n");
            }
            if (sel == 0 && pdir == 1 && mode == 1 && _dep_local_on == 0 && _dep_switch_honoured() == 1) {
                if (_dep_hint == 0) { _dep_hint = vec_new(); }
                if (_dep_list_has(_dep_hint, name) == 0) { vec_push(_dep_hint, name); }
            }
            if (remote == 0 && _dep_locked == 1) {
                if (mode == 0) { return 0 - 1; }
                return _dep_refuse_entry(0, name, "git", git, " is a local repository — --locked resolves what a release can, a remote git + tag; refused");
            }
            return 0;
        }
        if (raw != 0) {
            if (_dep_locked == 1) {
                if (mode == 0) { return 0 - 1; }
                return _dep_refuse_entry(0, name, "path", raw, " has no git / tag — --locked resolves what a release can, and a release cannot resolve a path; refused");
            }
            return 1;
        }
        if (git != 0 && remote == 0 && _dep_locked == 1) {
            if (mode == 0) { return 0 - 1; }
            return _dep_refuse_entry(0, name, "git", git, " is a local repository — --locked resolves what a release can, a remote git + tag; refused");
        }
        return 0;
    }
    # a dependency's own manifest
    if (raw != 0 && _dep_path_abs(raw) == 1) {
        if (mode == 0) { return 0 - 1; }
        return _dep_refuse_entry(owner, name, "path", raw, ", an absolute path — a dependency's manifest must be portable; refused");
    }
    if (git != 0 && remote == 0 && _dep_path_abs(git) == 1) {
        if (mode == 0) { return 0 - 1; }
        return _dep_refuse_entry(owner, name, "git", git, ", an absolute local repository — a dependency's manifest must be portable; refused");
    }
    if (kind == 1) {
        # resolved from a clone: a `path` beside a remote git is dropped — its developers' override
        if (git != 0 && remote == 1) {
            if (raw != 0 && mode == 1 && _verbose == 1) {
                _ew("  ");
                _ew_shown(owner);
                _ew(": its [deps.");
                _ew_shown(name);
                _ew("] path is its own dev override — ignored, the tag resolves\n");
            }
            return 0;
        }
        if (mode == 0) { return 0 - 1; }
        if (git != 0) {
            return _dep_refuse_entry(owner, name, "git", git, ", a local repository — a published dependency must name a remote git + tag; refused (it resolves on its author's box and nowhere else)");
        }
        if (raw != 0) {
            return _dep_refuse_entry(owner, name, "path", raw, " with no git / tag — a published dependency must name git + tag; refused (it resolves on its author's box and nowhere else)");
        }
        return 0;
    }
    # kind 2 (a local override) or 3 (a local-only dep): its own overrides, for selected names
    if (raw != 0 && git != 0) {
        if (sel == 1 && pdir == 1) { return 1; }
        if (remote == 1) { return 0; }
        if (kind == 3 || sel == 1) { return 0; }
    } elif (raw != 0) {
        if (kind == 3 || sel == 1) { return 1; }
    } elif (git != 0 && remote == 0) {
        if (kind == 3 || sel == 1) { return 0; }
    } else {
        return 0;
    }
    if (mode == 0) { return 0 - 1; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, " has no remote source, and ");
    str_builder_add_cstr(sb, _shown(name));
    str_builder_add_cstr(sb, " is not selected — CYRIUS_LOCAL=1 (or --local=");
    str_builder_add_cstr(sb, _shown(owner));
    str_builder_add_cstr(sb, ",");
    str_builder_add_cstr(sb, _shown(name));
    str_builder_add_cstr(sb, ") builds it from that checkout; refused");
    var what = str_data(str_builder_build(sb));
    if (raw != 0) { return _dep_refuse_entry(owner, name, "path", raw, what); }
    return _dep_refuse_entry(owner, name, "git", git, what);
}

# 1 when the [deps.NAME] entry in `rec` is gated out of this run (optional without an active
# feature, or another target) — the same two gates the resolve applies.
fn _dep_gated(name, rec): i64 {
    if (load64(rec + _DS_OPTIONAL) == 1 && _dep_feature_active(name) == 0) { return 1; }
    var t = load64(rec + _DS_TARGET);
    if (t != 0 && _dep_target_matches(t) == 0) { return 1; }
    return 0;
}

# Is an override actually IN USE? Walks the root manifest and, below it, only manifests of local
# checkouts (a clone's own overrides are never followed), with the resolve's own decision
# (`_dep_pick`, silent). 1 when some entry with a git resolves from its path. `seen` holds the
# directories already walked (cycles, and a depth bound for a pathological tree).
fn _dep_local_prescan(buf, n, dir, kind, owner, seen): i64 {
    if (vec_len(seen) > 64) { return 0; }
    vec_push(seen, dir);
    var rec = alloc(_DS_SIZE);
    var info[32];
    var si = 0;
    while (si < n) {
        si = _toml_line(buf, n, si, &info);
        var hc = 0;
        var nm = _dep_hdr_name(buf, n, &info, &hc);
        if (nm == 0) { continue; }
        if (hc == 0 || _dep_name_unsafe(nm) == 1) { continue; }
        si = _dep_sec_read(buf, n, si, dir, rec);
        if (load64(rec + _DS_BAD) != 0) { continue; }
        if (kind != 0 && load64(rec + _DS_SCOPE) == 1) { continue; }   # 6.7.6: never walked
        if (_dep_gated(nm, rec) == 1) { continue; }
        var pk = _dep_pick(nm, rec, kind, owner, 0);
        if (pk != 1) { continue; }
        if (load64(rec + _DS_GIT) != 0) { return 1; }
        # a local-only dep: its own manifest may select an override further down
        var sub = _abs_path(load64(rec + _DS_PATH));
        if (_dep_list_has(seen, sub) == 1) { continue; }
        var tm = _cat2(sub, "/cyrius.cyml");
        if (file_exists(tm) == 0) { tm = _cat2(sub, "/cyrius.toml"); }
        if (file_exists(tm) == 0) { continue; }
        var tn = 0;
        var tb = file_read_whole_max(tm, _MF_MAX, &tn);
        if (tb == 0) { continue; }
        var bom = _mf_bom_len(tb, tn);
        tb = tb + bom;
        tn = _mf_header_len(tb, tn - bom);
        store8(tb + tn, 0);
        var ck = 3;
        if (load64(rec + _DS_GIT) != 0) { ck = 2; }
        if (_dep_local_prescan(tb, tn, sub, ck, nm, seen) == 1) { return 1; }
    }
    return 0;
}

# Local mode is on and an override is in use: vendor into build/local-deps/lib, fresh each run
# (a dependency dropped from the manifest must not linger there and shadow lib/), and point the
# compiler's lib/ overlay at it. 0, or 1 after naming a refusal.
fn _dep_local_begin(): i64 {
    var root = "build/local-deps/lib";
    var lk = _dep_dest_is_linked(_cat2(root, "/x"));
    if (lk != 0) { return _dep_refuse_symlinked_dest(lk); }
    _dep_rm_tree(root);
    if (is_dir(str_from(root)) == 1 || file_exists(root) == 1) {
        _err_ctx("local mode: cannot clear the previous local resolve", root);
        return 1;
    }
    _dep_vroot = root;
    _dep_overlay_env(root);
    # build/ is where every project's binaries go and 115 of 126 manifested repos ignore it; a
    # project that does not would see this resolve in `git status`, so say so.
    if (_dep_wt_run(0, "check-ignore", "-q", root, 0, 0) == 1) {
        _warn("build/local-deps/ is not ignored by git — add `build/` to .gitignore (local mode vendors there)");
    }
    return 0;
}

# The compiler's lib/ overlay (src/frontend/lex/lex.cyr `_rf_ov_open`): set to `dir` — build/local-deps/lib
# for a local-mode resolve, build/locked-deps/lib for a --locked one in a checkout with no vendored
# lib/ — or, with `dir` 0, REMOVED from what every child inherits: an overlay is this CLI's to set,
# never one left in a shell. POSIX rebuilds `_envp`; Windows sets this process's own environment,
# which its children inherit.
fn _dep_overlay_env(dir): i64 {
    _dep_overlay = dir;
    #ifdef CYRIUS_TARGET_WIN
    _win_setenv("CYRIUS_LIB_OVERLAY", dir);
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    if (_envp == 0) { return 0; }
    var n = 0;
    while (load64(_envp + n * 8) != 0) { n = n + 1; }
    var out = alloc((n + 2) * 8);
    var o = 0;
    if (dir != 0) { store64(out, _cat2("CYRIUS_LIB_OVERLAY=", dir)); o = 1; }
    var i = 0;
    while (i < n) {
        var e = load64(_envp + i * 8);
        i = i + 1;
        if (memeq(e, "CYRIUS_LIB_OVERLAY=", 19) == 1) { continue; }
        store64(out + o * 8, e);
        o = o + 1;
    }
    store64(out + o * 8, 0);
    _envp = out;
    return 0;
    #endif
}

# The one hint line of a default-mode resolve that left local checkouts unused.
#     hint: 2 deps have local checkouts not in use (sigil, libro); CYRIUS_LOCAL=1 builds them
fn _dep_say_hint(): i64 {
    if (_dep_hint == 0) { return 0; }
    var k = vec_len(_dep_hint);
    if (k == 0 || _quiet == 1) { return 0; }
    _ew("hint: ");
    fmt_int_fd(STDERR_FD, k);
    if (k == 1) { _ew(" dep has a local checkout not in use ("); }
    else { _ew(" deps have local checkouts not in use ("); }
    var i = 0;
    while (i < k) {
        if (i > 0) { _ew(", "); }
        _ew_shown(vec_get(_dep_hint, i));
        i = i + 1;
    }
    if (k == 1) { _ew("); CYRIUS_LOCAL=1 builds it (this run built the tag)\n"); }
    else { _ew("); CYRIUS_LOCAL=1 builds them (this run built the tags)\n"); }
    return 0;
}

# A selected name no walked manifest gave a `path`: a typo must not read as "no override".
fn _dep_say_unused_selection(): i64 {
    if (_dep_local_on == 0 || _dep_local_names == 0) { return 0; }
    var i = 0;
    while (i < vec_len(_dep_local_names)) {
        var nm = vec_get(_dep_local_names, i);
        i = i + 1;
        if (_dep_local_seen != 0) { if (_dep_list_has(_dep_local_seen, nm) == 1) { continue; } }
        _ew("warning: ");
        _ew(_dep_local_from);
        _ew(" selects '");
        _ew_shown(nm);
        _ew("', but no [deps.");
        _ew_shown(nm);
        _ew("] in this resolve declares a path\n");
    }
    return 0;
}

# Record a resolved dep for closest-wins, the diamond notice and `deps -v`.
fn _dep_vis_push(name, tag, git, path, by, desc): i64 {
    vec_push(_dep_visited, name);
    vec_push(_dep_vis_tag, tag);
    vec_push(_dep_vis_git, git);
    vec_push(_dep_vis_path, path);
    vec_push(_dep_vis_by, by);
    vec_push(_dep_vis_desc, desc);
    return 0;
}

fn _dep_vis_index(name): i64 {
    var i = 0;
    while (i < vec_len(_dep_visited)) {
        if (streq(vec_get(_dep_visited, i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# "2.0", "the default branch of <url>", or a path — one side of a diamond, as it was asked for.
fn _dep_want_str(tag, git, path): i64 {
    if (path != 0) { return _shown(path); }
    if (tag != 0) { return _shown(tag); }
    if (git != 0) { return _cat2("the default branch of ", _shown(git)); }
    return "(no source)";
}

# R7 — a diamond: `name` is already resolved, and the manifest being walked asks for it at another
# tag (or from another repository, or from a path). Closest-wins still decides; this says so.
#     note: leaf 2.0 (wanted by p2) not used; 1.0 (p1) resolved first
fn _dep_diamond(name, rec): i64 {
    var vi = _dep_vis_index(name);
    if (vi < 0) { return 0; }
    var vt = vec_get(_dep_vis_tag, vi);
    var vg = vec_get(_dep_vis_git, vi);
    var vp = vec_get(_dep_vis_path, vi);
    var wt = load64(rec + _DS_TAG);
    var wg = load64(rec + _DS_GIT);
    var wp = 0;
    if (wg == 0) { wp = load64(rec + _DS_RAW); }   # a path-only want
    var same = 1;
    if (vp != 0) {
        if (wg != 0) { same = 0; }                  # resolved from a working tree, wanted at a tag
        elif (wp != 0) { if (streq(_abs_path(load64(rec + _DS_PATH)), vp) == 0) { same = 0; } }
    } else {
        if (wp != 0) { same = 0; }
        elif (wg != 0) {
            if (vg == 0 || _git_url_same(vg, wg) == 0) { same = 0; }
            if (vt == 0 && wt != 0) { same = 0; }
            if (vt != 0 && wt == 0) { same = 0; }
            if (vt != 0 && wt != 0) { if (streq(vt, wt) == 0) { same = 0; } }
        }
    }
    if (same == 1 || _quiet == 1) { return 0; }
    var vb = vec_get(_dep_vis_by, vi);
    var wsame_repo = 1;
    if (vg != 0 && wg != 0) { if (_git_url_same(vg, wg) == 0) { wsame_repo = 0; } }
    _ew("note: ");
    _ew_shown(name);
    _ew(" ");
    _ew(_dep_want_str(wt, wg, wp));
    if (wsame_repo == 0) { _ew(" from "); _ew_shown(wg); }
    _ew(" (wanted by ");
    if (_dep_ctx_owner == 0) { _ew("the root"); } else { _ew_shown(_dep_ctx_owner); }
    _ew(") not used; ");
    _ew(_dep_want_str(vt, vg, vp));
    if (wsame_repo == 0) { _ew(" from "); _ew_shown(vg); }
    _ew(" (");
    if (vb == 0) { _ew("the root"); } else { _ew_shown(vb); }
    _ew(") resolved first\n");
    return 0;
}

# `deps -v`: where each resolved dependency came from.
#     sigil   tag 3.9.9 @1a2b3c4 (cache)
#     leaf    tag 1.0 @9f8e7d6 (fetched) via mid
fn _dep_say_sources(): i64 {
    if (_dep_visited == 0 || vec_len(_dep_visited) == 0) { return 0; }
    println("dependency sources:");
    var w = 0;
    var i = 0;
    while (i < vec_len(_dep_visited)) {
        var l = strlen(_shown(vec_get(_dep_visited, i)));
        if (l > w) { w = l; }
        i = i + 1;
    }
    i = 0;
    while (i < vec_len(_dep_visited)) {
        var nm = _shown(vec_get(_dep_visited, i));
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, nm, strlen(nm));
        var p = strlen(nm);
        while (p < w + 2) { sys_write(STDOUT_FD, " ", 1); p = p + 1; }
        var d = vec_get(_dep_vis_desc, i);
        sys_write(STDOUT_FD, d, strlen(d));
        var by = vec_get(_dep_vis_by, i);
        if (by != 0) {
            var bs = _shown(by);
            sys_write(STDOUT_FD, " via ", 5);
            sys_write(STDOUT_FD, bs, strlen(bs));
        }
        sys_write(STDOUT_FD, "\n", 1);
        i = i + 1;
    }
    return 0;
}
