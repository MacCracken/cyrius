# CLI — deps: cmd_deps — the resolve's passes, the pin-move refusal, out-of-closure files, _auto_deps.
# ================================================================
# Split from cbt/deps.cyr at 6.7.18, unchanged; cbt/cyrius.cyr includes the pieces in order. CHANGELOG [6.7.18]

fn cmd_deps(): i64 {
    _dep_vendor_mode = 1;   # v6.5.37 (A0): vendoring — symlinked destinations are refused
    # Try cyrius.cyml first, fall back to cyrius.toml
    var _manifest = "cyrius.cyml";
    if (file_exists(_manifest) == 0) { _manifest = "cyrius.toml"; }
    if (file_exists(_manifest) == 0) {
        _err("no cyrius.cyml or cyrius.toml found");
        return 1;
    }
    # v6.0.1: removed unconditional `sys_mkdir("lib", 0x1ED)` here.
    # Pre-fix the upfront mkdir created `./lib` before
    # `_dep_find_stdlib_dir` ran, tripping its priority-(a) check
    # `file_exists("src/main.cyr") && is_dir("./lib")` for ANY
    # downstream repo with a `src/main.cyr` entry point + non-empty
    # `stdlib = [...]` (gnoboot exposed this 2026-05-19 when
    # adopting `stdlib = ["fnptr"]`). Priority (a) is supposed to
    # identify the cyrius source repo only — it returned "./lib"
    # for downstream repos and the stdlib copy failed because the
    # src path resolved into the empty just-mkdir'd `./lib/`. The
    # `_dep_copy_file` prefix-walk at line ~85 already mkdir's
    # intermediate dirs lazily, so the upfront mkdir was redundant
    # AND wrong. See CHANGELOG [6.0.1].
    # 6.6.17: the WHOLE manifest through the one reader (cbt/manifest.cyr) — this read 32,767
    # bytes, so a `[deps]` past the cut was silently invisible. The CYML body is already cut.
    if (_mf_load() != 1) { _err("cannot read manifest"); return 1; }
    var buf = _mf_buf;
    var n = _mf_len;
    _dep_warn_manifest();            # 6.7.6 (R11): unknown sections / [deps] keys, named once
    _dep_parse_groups(buf, n);       # v6.2.49 Phase B: [groups] (buf is the TOML header, CYML body already stripped)
    _dep_register_default_std_group();  # v6.3.32 Phase D: built-in `std` default group (after parse so a manifest's own `std` wins)
    _dep_parse_features(buf, n);     # v6.3.1 lever 2: [features] table (populates _dep_feature_names/_deps; gating happens in _process_named_deps)
    # v6.6.5 — reachable for the first time (no CLI path used to set _dry_run for
    # `deps`). It returned BEFORE the manifest check, so `cyrius deps --dry-run` in an
    # empty directory said "would resolve deps from cyrius.cyml" and exited 0 while
    # plain `cyrius deps` exited 1 (round-3 review). Now it fails exactly where the real
    # run fails, and reports what it read instead of a canned line. (6.7.6: after the
    # [groups] / [features] parse, so it reports the gates the real run applies.)
    if (_dry_run == 1) { return _deps_dry_list(_manifest, buf, n); }
    var copied = 0;
    var errors = 0;
    _deps_pass_reset();              # what one resolve accumulates (the pin-move dry pass runs one more)
    _dep_dry_fetched = 0;
    _dep_hint = 0;
    _dep_local_seen = 0;
    _dep_locked_diff = 0;
    _dep_lock_load();                # v6.6.4: the inherited lock, read BEFORE any copy (stdlib-leaf guard)
    var _consumer_dir = _abs_path(".");
    # 6.7.6 (lane C) — where this resolve WRITES. Default: lib/ + cyrius.lock (the tag resolution).
    # Local mode with an override in use: build/local-deps/lib, no lock. --locked: a private
    # scratch, compared with lib/ and the lock afterwards, nothing written.
    _dep_vroot = "lib";
    _dep_local_active = 0;
    _dep_locked_nolib = 0;
    if (_dep_local_ign != 0 && _quiet == 0) {
        _ew("note: CYRIUS_LOCAL is ignored here — ");
        _ew(_dep_local_ign);
        _ew("\n");
    }
    var locked_root = 0;
    if (_dep_locked == 1) {
        if (_dep_lock_active == 0) {
            _err("--locked: cyrius.lock is not kept in the cyrius source repo (lib/ is authored stdlib) — nothing to check");
            return 1;
        }
        if (file_exists("cyrius.lock") == 0) {
            _err("--locked: there is no cyrius.lock to hold this resolve to — run `cyrius deps` and commit cyrius.lock");
            return 1;
        }
        # No vendored lib/ — a fresh checkout of a project that ignores lib/ (68 of 126 consumers:
        # there the lock is the committed artifact and lib/ a build output): the resolve is held to
        # cyrius.lock alone, and a compiling verb reads it from build/locked-deps/lib through the
        # overlay, as local mode reads build/local-deps/lib. lib/ and the lock stay unwritten.
        _dep_locked_nolib = _dep_lib_unvendored();
        if (_dep_locked_nolib == 1 && _quiet == 0) {
            _ew("note: --locked: no vendored lib/ here — the resolve is checked against cyrius.lock alone\n");
        }
        if (_dep_locked_nolib == 1 && _dep_locked_compiles() == 1) {
            locked_root = "build/locked-deps";
            var lk = _dep_dest_is_linked("build/locked-deps/lib/x");
            if (lk != 0) { return _dep_refuse_symlinked_dest(lk); }
            _dep_rm_tree(locked_root);
            if (is_dir(str_from(locked_root)) == 1 || file_exists(locked_root) == 1) {
                _err_ctx("--locked: cannot clear the previous resolve", locked_root);
                return 1;
            }
            _dep_vroot = "build/locked-deps/lib";
        } else {
            locked_root = _cbt_tmpfile("locked-deps");
            _dep_rm_tree(locked_root);
            _dep_vroot = _cat2(locked_root, "/lib");
            _dep_vendor_mode = 0;        # a private scratch under this run's own temp dir
            _dep_scr_begin(locked_root); # 6.7.14: a kill removes it (_deps_finish ends it)
        }
    } elif (_dep_local_on == 1) {
        _dep_local_active = _dep_local_prescan(buf, n, _consumer_dir, 0, 0, vec_new());
        if (_dep_local_active == 1) {
            if (_dep_local_begin() != 0) { return 1; }
        }
    }
    # ⛔ 6.7.13 (D41): at a moved pin, refused BEFORE Phase 1 writes (_deps_pin_move_dry)
    if (locked_root == 0 && _dep_local_active == 0) {
        if (_deps_pin_move_dry(buf, n, _consumer_dir) != 0) { return 1; }
    }
    errors = _deps_resolve(buf, n, _consumer_dir);

    # v5.7.14: `copied` is the count of distinct deps resolved (direct +
    # transitive). _dep_visited grows once per resolved dep across both
    # phases.
    copied = vec_len(_dep_visited);
    # v6.6.4: leaves the lock guard refused are errors — no lock write, non-zero exit.
    errors = errors + _dep_lock_refused;
    _dep_say_hint();                 # 6.7.6: the checkouts a default run did not use, one line
    _dep_say_unused_selection();     # 6.7.6: a selected name nothing declares
    if (_verbose == 1) { _dep_say_sources(); }   # 6.7.6 (part L): `deps -v`
    return _deps_finish(errors, copied, locked_root);
}

# The resolve proper — phases 1 to 4 into `_dep_vroot` — from the state `_deps_pass_reset` left.
# Returns the error count. cmd_deps runs it once; at a moved pin `_deps_pin_move_dry` runs it
# first into a private scratch. CHANGELOG [6.7.13]
fn _deps_resolve(buf, n, cdir): i64 {
    var errors = 0;
    _dep_ctx_kind = 0;               # the root manifest
    _dep_ctx_owner = 0;

    # === Phase 1: stdlib deps ===
    # `[deps] stdlib = ["string", "fmt", ...]`, read by the one reader (_dep_declared_stdlib):
    # this was a raw byte scan for `stdlib` anywhere in the file, guarded piecemeal against the
    # decoys it kept finding (a comment, a quoted value, a `dev-stdlib` key) and still taking a
    # `"""` description holding `stdlib = ["math"]` for the key. CHANGELOG [6.6.20].
    var mods = _dep_declared_stdlib(buf, n);
    if (mods != 0) {
        var stdlib_dir = _dep_find_stdlib_dir();
        if (stdlib_dir == 0) {
            println("  error: cannot find cyrius stdlib");
            errors = errors + 1;
        } else {
            # v5.10.19: per-cmd_deps invocation visited-set
            # for the include-chain follower below.
            _dep_stdlib_seen_init();
            mods = _dep_expand_groups(mods);   # v6.2.49 Phase B: expand [groups] refs → leaves
            var mi = 0;
            while (mi < vec_len(mods)) {
                var mod_name = vec_get(mods, mi);
                if (_dep_leaf_ok(mod_name) == 0) {   # 6.6.20: the one leaf rule
                    _dep_refuse_leaf("[deps] stdlib", 0, mod_name);
                    errors = errors + 1;
                    mi = mi + 1;
                    continue;
                }
                # v5.10.19: the recursive fetcher. For 95%+ of stdlib modules
                # (leaf files) only the top-level file gets copied; for the arch-
                # dispatcher modules (syscalls, alloc) it follows their
                # `include "lib/X.cyr"` chains. is_top=1 — push onto `_dep_includes`
                # so `compile()` prepends `include "lib/<mod>.cyr"`.
                var rr = _dep_copy_stdlib_recursive(stdlib_dir, mod_name, 1);
                if (rr == 1) { errors = errors + 1; }
                if (_verbose == 1 && rr == 0) {
                    sys_write(STDERR_FD, "  stdlib: ", 10);
                    sys_write(STDERR_FD, mod_name, strlen(mod_name));
                    sys_write(STDERR_FD, "\n", 1);
                }
                mi = mi + 1;
            }
        }
    }

    # === Phase 2: named deps (consumer's manifest) ===
    # v5.7.14: extracted to _process_named_deps. Consumer's manifest_dir
    # is abs(cwd). After this returns, _dep_queue holds the resolved
    # dirs of every direct dep — Phase 3 drains them.
    errors = errors + _process_named_deps(buf, n, cdir);

    # === Phase 3: transitive deps (BFS drain of _dep_queue) ===
    # v5.7.14. For each resolved dep dir, read its cyrius.cyml and
    # process its [deps.X] sections. New deps push more dirs into
    # _dep_queue; closest-wins skip prevents re-resolution. Cycles
    # terminate naturally because re-encountered names are skipped.
    _dep_qi = 0;
    errors = errors + _deps_drain();

    # === Phase 4 (6.7.6, part T): the TEST SCOPE ===
    # After every production dependency, so a leaf or a dep both sides name is the production one.
    errors = errors + _deps_test_scope(buf, n, cdir);
    return errors;
}

# What one resolve accumulates, emptied before it runs: the include / closure / named-dep lists,
# the visited set and its records, the queue, the commit pins, the stdlib leaves already copied.
# cmd_deps calls it before its resolve, and `_deps_pin_move_dry` after the dry one, so the real
# resolve starts from the state the dry one found (a leaf left "already copied" would not be
# copied at all). CHANGELOG [6.7.13]
fn _deps_pass_reset(): i64 {
    _dep_includes = vec_new();
    _dep_nd_modules = vec_new();     # 6.6.9: named-dep modules, for distlib's verify unit
    _dep_nd_leaves = vec_new();      # 6.6.9: stdlib leaves pulled for named deps (same)
    _dep_closure = vec_new();        # 6.7.12: every path this resolve vendors (_dep_copy_file)
    _dep_decl_all = vec_new();       # 6.7.12 (D25): every tagged declaration a manifest read holds
    _dep_decl_root = vec_new();      # ... and the root manifest's own
    # v5.7.14: per-cmd_deps state. visited names = closest-wins de-dup.
    # queue = abs dirs of resolved deps whose own cyrius.cyml needs walking.
    _dep_visited = vec_new();
    _dep_queue = vec_new();
    # 6.7.6: the visited set's parallel records and the queue's kinds (see "LOCAL MODE")
    _dep_vis_tag = vec_new();
    _dep_vis_git = vec_new();
    _dep_vis_path = vec_new();
    _dep_vis_by = vec_new();
    _dep_vis_desc = vec_new();
    _dep_queue_kind = vec_new();
    _dep_queue_owner = vec_new();
    _dep_inert = 0;                  # 6.6.13 (I10b): modules-less deps that vendored nothing
    _dep_commit_lines = vec_new();   # the release-integrity hardening item (v6.2.30): git-dep commit pins
    _dep_stdlib_seen = 0;            # 6.7.13: Phase 1 re-inits it only when [deps] stdlib is declared
    return 0;
}

# ⛔ 6.7.13 (D41, the user, 2026-10-15) — A RESOLVE REFUSED AT A PIN MOVE WRITES NOTHING.
# D19 (`_dep_pin_move_refused`) needs the resolve's closure, so it ran after Phase 1 had already
# re-vendored every closure file at the new pin: the refusal said "cyrius.lock is unchanged" while
# lib/ held the new pin's string.cyr, and `deps --verify` failed on a file it never named. Now, at a
# pin move only (the inherited trailer names another pin, the lock is written: not --no-lock,
# --locked, local mode or the source repo) and only when some lib/ file differs from the new
# snapshot at all, the resolve runs ONCE MORE first, into a private scratch, with stdout and stderr
# muted (`_cbt_mute`): its closure (plus the stale thin-profile copies Phase 2 would delete, from
# `_dep_dry_drop`) is D19's scope, and a non-empty stale set is refused with D19's text — lib/ AND
# cyrius.lock byte-unchanged, `--verify` still green. A dry pass with errors decides nothing (the
# real resolve reports them; D19 after it stays the backstop). The cost: one extra resolve at such
# a move (named deps come from the clone cache). `_dep_find_stdlib_dir` runs before the mute, so
# its exits — the only ones a resolve reaches — print. 0 = go on, 1 = refused. CHANGELOG [6.7.13]
fn _deps_pin_move_dry(buf, n, cdir): i64 {
    if (_no_lock == 1 || _dep_lock_active == 0) { return 0; }
    if (_dep_lock_has_trailer == 0 || _dep_lock_pin_same == 1) { return 0; }
    if (vec_len(_dep_pin_move_stale(vec_new())) == 0) { return 0; }
    _dep_find_stdlib_dir();
    var root = _cbt_tmpfile("pin-move-deps");
    _dep_rm_tree(root);
    _dep_vroot = _cat2(root, "/lib");
    _dep_vendor_mode = 0;            # a private scratch under this run's own temp dir
    _dep_scr_begin(root);            # 6.7.14: a kill removes it
    _dep_dry_drop = vec_new();
    _dep_dry_fetched = vec_new();
    var po = _progress_open;
    var ec = _err_count;
    _cbt_mute(1);
    var errs = _deps_resolve(buf, n, cdir) + _dep_lock_refused;
    var scope = _dep_closure_lib();
    _cbt_mute(0);
    _progress_open = po;
    _err_count = ec;
    var k = 0;
    while (k < vec_len(_dep_dry_drop)) {
        vec_push(scope, vec_get(_dep_dry_drop, k));
        k = k + 1;
    }
    _dep_dry_drop = 0;
    _dep_rm_tree(root);
    _dep_scr_end();
    _dep_vroot = "lib";
    _dep_vendor_mode = 1;
    _deps_pass_reset();
    _dep_hint = 0;
    _dep_lock_load();                # its per-resolve flags (the guard's refusals, a new leaf)
    if (errs != 0) { return 0; }
    var stale = _dep_pin_move_stale(scope);
    if (vec_len(stale) == 0) { return 0; }
    _dep_pin_move_say(stale, 0);
    return 1;
}

# The BFS drain of `_dep_queue` from `_dep_qi` (phase 3, and phase 4's for the test scope's own
# dependencies). Returns the error count. CHANGELOG [6.7.6]
var _dep_qi = 0;

fn _deps_drain(): i64 {
    var errors = 0;
    var _qi = _dep_qi;
    while (_qi < vec_len(_dep_queue)) {
        var _trans_dir = vec_get(_dep_queue, _qi);
        _qi = _qi + 1;
        _dep_qi = _qi;
        var _tm_sb = str_builder_new();
        str_builder_add_cstr(_tm_sb, _trans_dir);
        str_builder_add_cstr(_tm_sb, "/cyrius.cyml");
        var _tm = str_data(str_builder_build(_tm_sb));
        if (file_exists(_tm) == 0) {
            var _tm_sb2 = str_builder_new();
            str_builder_add_cstr(_tm_sb2, _trans_dir);
            str_builder_add_cstr(_tm_sb2, "/cyrius.toml");
            _tm = str_data(str_builder_build(_tm_sb2));
        }
        if (file_exists(_tm) == 0) { continue; }
        # 6.6.17: read WHOLE (this was a 32,767-byte read — a transitive `[deps.X]` past the cut
        # was invisible) and an unreadable manifest is named, not skipped.
        var _tn = 0;
        var _tbuf = file_read_whole_max(_tm, _MF_MAX, &_tn);
        if (_tbuf == 0) {
            _err_ctx("cannot read a dependency's manifest (or it is past 16 MiB)", _tm);
            errors = errors + 1;
            continue;
        }
        var _tbom = _mf_bom_len(_tbuf, _tn);   # 6.6.20: a leading BOM hid a first-line [deps.X]
        _tbuf = _tbuf + _tbom;
        _tn = _tn - _tbom;
        _tn = _mf_header_len(_tbuf, _tn);   # only the header is TOML
        store8(_tbuf + _tn, 0);
        # 6.7.6: the walked manifest's kind — a clone's own overrides are never followed
        _dep_ctx_kind = vec_get(_dep_queue_kind, _qi - 1);
        _dep_ctx_owner = vec_get(_dep_queue_owner, _qi - 1);
        errors = errors + _process_named_deps(_tbuf, _tn, _trans_dir);
        _qi = _dep_qi;
    }
    _dep_ctx_kind = 0;
    _dep_ctx_owner = 0;
    return errors;
}

# cmd_deps after the resolve: the summary, --locked's comparison, local mode's note, the lock.
fn _deps_finish(errors, copied, locked_root): i64 {
    # Summary (only print if something was copied, errored, or — 6.6.13 I10b — a
    # modules-less dep vendored nothing: that count is printed even at 0 resolved).
    if (copied > 0 || errors > 0 || _dep_inert > 0) {
        var nb[24];
        var nl = fmt_int_buf(copied, &nb);
        sys_write(STDOUT_FD, &nb, nl);
        sys_write(STDOUT_FD, " deps resolved", 14);
        if (_dep_inert > 0) {
            sys_write(STDOUT_FD, ", ", 2);
            nl = fmt_int_buf(_dep_inert, &nb);
            sys_write(STDOUT_FD, &nb, nl);
            sys_write(STDOUT_FD, " vendored nothing", 17);
        }
        if (errors > 0) {
            sys_write(STDOUT_FD, ", ", 2);
            nl = fmt_int_buf(errors, &nb);
            sys_write(STDOUT_FD, &nb, nl);
            sys_write(STDOUT_FD, " errors", 7);
        }
        sys_write(STDOUT_FD, "\n", 1);
    }
    # 6.7.6 (part L): --locked — the resolve above went to a private scratch; compare it with
    # lib/ and cyrius.lock, name every difference, write nothing.
    if (locked_root != 0) {
        var ld = _dep_locked_diff;
        if (errors == 0) { ld = ld + _deps_locked_compare(_dep_vroot); }
        # 6.7.13: at a moved pin, the files D19 refuses to re-lock over (read before the scratch
        # goes: the closure is the scratch's paths), so the remedy is one that works.
        var pstale = 0;
        if (ld > 0 && _dep_lock_has_trailer == 1 && _dep_lock_pin_same == 0) {
            pstale = _dep_pin_move_stale(_dep_closure_lib());
            if (vec_len(pstale) == 0) { pstale = 0; }
        }
        # With no vendored lib/, a compiling verb keeps the proven resolution (build/locked-deps/lib)
        # and reads it through the overlay; anything else is removed.
        var keep = 0;
        if (_dep_locked_nolib == 1 && _dep_locked_compiles() == 1 && errors == 0 && ld == 0) { keep = 1; }
        if (keep == 1) { _dep_overlay_env(_dep_vroot); }
        else {
            _dep_rm_tree(locked_root);
            _dep_scr_end();          # 6.7.14: the private scratch's record, once it is gone
            _dep_vroot = "lib";
        }
        _dep_vendor_mode = 1;
        if (errors > 0) { return 1; }
        if (ld > 0) {
            _ew("error: --locked: ");
            fmt_int_fd(STDERR_FD, ld);
            if (_dep_locked_nolib == 1) {
                _ew(" difference(s) between what the tags resolve and the committed cyrius.lock (named above); nothing was written — run `cyrius deps` and commit cyrius.lock\n");
            } elif (_dep_locked_crlf == ld) {
                # 6.7.12 (D10): every difference is a CRLF checkout — re-locking is not the remedy
                _ew(" difference(s) between what the tags resolve and the committed lib/ + cyrius.lock");
                _ew(" (named above); nothing was written — CRLF checkout: add `lib/** -text` to .gitattributes\n");
            } elif (pstale != 0) {
                # 6.7.13: `cyrius deps` would refuse (D19), so it is not the remedy — D19's ways are
                _deps_locked_pin_move_remedy(pstale);
            } else {
                _ew(" difference(s) between what the tags resolve and the committed lib/ + cyrius.lock (named above); nothing was written — run `cyrius deps` and commit the result\n");
            }
            if (_dep_locked_crlf > 0) { _deps_say_crlf(_dep_locked_crlf); }
            return 1;
        }
        if (_dep_locked_nolib == 1) { _status("--locked: cyrius.lock is exactly what the tags resolve (no vendored lib/ to compare)"); }
        else { _status("--locked: lib/ and cyrius.lock are exactly what the tags resolve"); }
        return 0;
    }
    # 6.7.6: local mode with an override in use writes NO tracked file — the tag resolution's
    # lib/ and cyrius.lock stay as they are, so switching modes churns nothing.
    if (_dep_local_active == 1) {
        if (_quiet == 0) {
            _ew("local mode: this resolve is in build/local-deps/lib/; lib/ and cyrius.lock untouched (--no-local resolves the tags)\n");
        }
        if (errors > 0) { return 1; }
        return 0;
    }
    # v5.7.8 P5: write cyrius.lock by default after every successful
    # resolve (was opt-in via `cyrius deps --lock` pre-v5.7.8). The
    # lockfile is the only thing making "pinned deps" reproducible
    # across machines — making it opt-in defeats the purpose for new
    # projects whose authors do not know the flag exists. Suppressed
    # by --no-lock.
    if (errors == 0) {
        if (_no_lock == 0) {
            # v6.6.4: `--relock` means RE-LOCK — write even when no git dep was resolved
            # (`copied == 0`, the stdlib-only shape), or the accepted leaf lands in lib/
            # with the lock still holding the old hash and `deps --verify` fails.
            # v6.6.4: ...and a lock that predates the trailer (every lock written before 6.6.4)
            # is re-written ONCE so it carries the pin line from now on — otherwise a
            # stdlib-only consumer (copied == 0) would never be stamped and never guarded.
            # ...and likewise a lock whose trailer names a DIFFERENT pin: after a pin bump on a
            # stdlib-only consumer nothing else triggers the write, so the lock kept the old
            # pin + old hashes, `--verify` failed on the leaf just vendored, and the guard sat
            # OFF under the new pin (bite-5 review).
            var _stamp_legacy = 0;
            if (_dep_lock_buf != 0) {
                if (_dep_lock_has_trailer == 0) { _stamp_legacy = 1; }
                if (_dep_lock_pin_same == 0) { _stamp_legacy = 1; }
            }
            # ...and (6.6.9) a vendored leaf the lock does not cover: a stdlib leaf newly
            # declared under an unchanged pin, or the FIRST lock of a stdlib-only project.
            # Both used to be left out — the leaf sat in lib/ unlocked and `--verify` passed
            # over it even tampered — restoring the v5.7.8 intent stated above.
            var _must = 0;
            if (copied > 0 || _dep_relock == 1 || _stamp_legacy == 1) { _must = 1; }
            # ...and (6.7.13) the opposite of a new leaf: a lock row for a file neither lib/ nor
            # this resolve holds — `rm lib/<f> && cyrius deps` left it, so `--verify` and
            # `--locked` stayed red after doing what --locked says. Soft, like the new leaf.
            var _stale = 0;
            if (_must == 0 && _dep_lock_new_leaf == 0) { _stale = _dep_lock_stale_row(); }
            if (_must == 1 || _dep_lock_new_leaf == 1 || _stale == 1) {
                # v6.6.6: a lock that could not be written is an error, not a dropped rc —
                # except (6.6.9) a hash failure on a write owed ONLY to a new leaf, which is a
                # named warning (_dep_lock_soft; cmd_deps_lock returns 2 for it).
                _dep_lock_soft = 1 - _must;
                var _lr = cmd_deps_lock();
                _dep_lock_soft = 0;
                if (_lr == 1 || (_lr != 0 && _must == 1)) { errors = errors + 1; }
            }
        }
    }
    if (errors == 0) { _dep_say_out_of_closure(); }   # 6.7.12: lib/ files no resolve vendors
    # ⛔ v6.5.37 (A1) — CLAMP. This returned the raw error COUNT, which becomes the process
    # exit status, and a wait status carries only the low 8 bits. Measured at 6.5.36:
    #     1 bad leaf -> exit 1     255 -> exit 255     256 -> exit 0     512 -> exit 0
    # So a manifest broken badly enough reported SUCCESS, and every count that is a
    # multiple of 256 was a silent green. This is why a defective sidecar could pass CI
    # at all — the more wrong it was, the likelier it looked clean. Exit status is a
    # boolean channel; the count belongs in the message, which it already is.
    if (errors > 0) { return 1; }
    return 0;
}

# 6.7.13 — --locked's remedy at a moved pin when lib/ holds files outside the closure that the new
# snapshot ships with other bytes (`stale`): `cyrius deps` refuses there (D19), so the line names
# those files and D19's two ways instead of "run `cyrius deps`". Follows the count on the line.
fn _deps_locked_pin_move_remedy(stale): i64 {
    var pin = _dep_lock_pin_value();
    var k = vec_len(stale);
    _ew(" difference(s) between what the tags resolve and the committed lib/ + cyrius.lock (named above);");
    _ew(" nothing was written — [package].cyrius moved from ");
    _ew_shown(_dep_lock_pin_rec);
    _ew(" to ");
    _ew_shown(pin);
    _ew(", and lib/ holds ");
    fmt_int_fd(STDERR_FD, k);
    if (k == 1) { _ew(" file"); } else { _ew(" files"); }
    _ew(" the resolve does not vendor that the ");
    _ew_shown(pin);
    _ew(" snapshot ships with other bytes, so `cyrius deps` will not re-lock:\n");
    _dep_pin_move_list(stale);
    _ew("  Either, then commit the result:\n");
    _dep_pin_move_ways(pin);
    return 0;
}

# 6.7.13 — 1 when lib/'s lock walk (`_deps_lock_files`, the writer's own walker) lists `path`.
fn _dep_lib_entry(path): i64 {
    return _dep_path_in(_deps_lock_files("lib"), path);
}

# 6.7.13 — 1 when the lock loaded at entry has a hash row for a path that is neither on disk (it
# cannot be opened and lib/'s walk has no such entry) nor vendored by this resolve
# (`_dep_closure`): a file removed from lib/. A stdlib-only resolve wrote
# the lock only for `_must` or a new leaf, so such a row survived every `cyrius deps`. One scan of
# the loaded lock, `file_exists` per row. CHANGELOG [6.7.13]
fn _dep_lock_stale_row(): i64 {
    if (_dep_lock_buf == 0) { return 0; }
    var lb = _dep_lock_buf;
    var ln = _dep_lock_len;
    var pos = 0;
    while (pos < ln) {
        var le = pos;
        while (le < ln && load8(lb + le) != 10) { le = le + 1; }
        var lw = le;
        if (lw > pos && load8(lb + lw - 1) == 13) { lw = lw - 1; }   # CRLF-tolerant, as the lookup
        if (lw - pos > 66 && load8(lb + pos + 64) == 32 && load8(lb + pos + 65) == 32) {
            var pl = lw - pos - 66;
            var p = alloc(pl + 1);
            memcpy(p, lb + pos + 66, pl);
            store8(p + pl, 0);
            if (file_exists(p) == 0 && _dep_lib_entry(p) == 0) {
                if (_dep_closure == 0) { return 1; }
                if (_dep_path_in(_dep_closure, p) == 0) { return 1; }
            }
        }
        pos = le + 1;
    }
    return 0;
}

# 6.7.12 — lib/'s `.cyr` files (the lock walker's list, sorted) that THIS resolve did not vendor:
# outside `_dep_closure`, the footprint the manifest declares. CHANGELOG [6.7.12]
fn _dep_out_of_closure(): i64 {
    return _dep_out_of_scope(_dep_closure);
}

# lib/'s `.cyr` files outside `scope` (a vec of lib/ paths), sorted. CHANGELOG [6.7.13]
fn _dep_out_of_scope(scope): i64 {
    var out = vec_new();
    var files = _deps_lock_files("lib");
    var i = 0;
    while (i < vec_len(files)) {
        var f = vec_get(files, i);
        i = i + 1;
        if (_dep_path_in(scope, f) == 0) { vec_push(out, f); }
    }
    return out;
}

# ⭐ 6.7.13 — D19's set, shared by the refusal and --locked's remedy: the lib/ files outside
# `scope` (the resolve's closure, as lib/ paths) that the pinned snapshot ships with other bytes —
# what a re-lock at a moved pin would stamp the new pin over. Read-only. A vec, empty when there
# is no snapshot. CHANGELOG [6.7.13]
fn _dep_pin_move_stale(scope): i64 {
    return _dep_pin_move_stale_in(_dep_snapshot_dir(), scope);
}

# `_dep_pin_move_stale` against snapshot `snap` (0 = none): `lib sync` names the tree it copies
# from itself. CHANGELOG [6.7.13]
fn _dep_pin_move_stale_in(snap, scope): i64 {
    var stale = vec_new();
    if (snap == 0) { return stale; }
    var off = _dep_out_of_scope(scope);
    var i = 0;
    while (i < vec_len(off)) {
        var f = vec_get(off, i);
        i = i + 1;
        var sf = _cat2(snap, f + 3);              # lib/<rel> -> <snapshot>/<rel>
        if (file_exists(sf) == 0) { continue; }
        if (_files_identical(sf, f) == 1) { continue; }
        vec_push(stale, f);
    }
    return stale;
}

# 6.7.13 — `_dep_closure` as lib/ paths: a --locked resolve vendors into its scratch root
# (`_dep_vroot`), a default one into lib/ itself. CHANGELOG [6.7.13]
fn _dep_closure_lib(): i64 {
    var out = vec_new();
    if (_dep_closure == 0) { return out; }
    var pre = _cat2(_dep_vroot, "/");
    var pl = strlen(pre);
    var i = 0;
    while (i < vec_len(_dep_closure)) {
        var e = vec_get(_dep_closure, i);
        i = i + 1;
        if (strlen(e) > pl && memeq(e, pre, pl) == 1) { vec_push(out, _cat2("lib/", e + pl)); }
        else { vec_push(out, e); }
    }
    return out;
}

# 6.7.13 — D19's files, one per line (the refusal and --locked's remedy alike).
fn _dep_pin_move_list(stale): i64 {
    var i = 0;
    while (i < vec_len(stale)) {
        _ew("  ");
        _ew_shown(vec_get(stale, i));
        _ew("\n");
        i = i + 1;
    }
    return 0;
}

# 6.7.13 — D19's two ways on, to pin `pin` (the refusal and --locked's remedy alike).
fn _dep_pin_move_ways(pin): i64 {
    _ew("    cyrius lib sync --full     moves them to ");
    _ew_shown(pin);
    _ew(" and re-locks (a project that vendors the whole snapshot)\n");
    _ew("    rm <file> && cyrius deps   drops them from lib/ and the lock\n");
    return 0;
}

# 6.7.12 — the stdlib snapshot this resolve reads (`_dep_find_stdlib_dir`'s pinned, else installed,
# tree), or 0 when there is none. Never its exit on an uninstalled pin: a project whose deps are
# all named resolves without one. Never `./lib`: that is the tree being compared. CHANGELOG [6.7.12]
fn _dep_snapshot_dir(): i64 {
    var pin = _dep_read_cyml_cyrius_field();
    var d = make_path(_home, "lib");
    if (pin != 0) { d = _cat2(_cat2(_home, "/versions/"), _cat2(pin, "/lib")); }
    if (_dep_dir_has_stdlib(d) == 1) { return d; }
    return 0;
}

# 6.7.12 — 1 when lib/ holds every `.cyr` of snapshot `snap` at its own path: a project that
# vendors the whole snapshot (`lib sync --full`), and so holds files outside its closure on
# purpose. CHANGELOG [6.7.12]
fn _dep_lib_holds_snapshot(snap): i64 {
    var sf = _deps_lock_files(snap);
    if (vec_len(sf) == 0) { return 0; }
    var sl = strlen(snap);
    var i = 0;
    while (i < vec_len(sf)) {
        if (file_exists(_cat2("lib", vec_get(sf, i) + sl)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ⭐ 6.7.12 — NAME the lib/ files this resolve did not vendor. A resolve copies the declared
# closure into lib/ and the lock covers ALL of lib/, but nothing ever removes a file: a leaf
# dropped from `[deps] stdlib` (or a named dep dropped from the manifest) stayed vendored and
# locked, `deps --verify` agreed, and nothing said so — the tree and the lock overstated the
# footprint until `rm -rf lib/ && cyrius deps`. Each such file is now named on stderr after a
# successful default resolve, with the way to drop it. Nothing is written or deleted. Silent when
# lib/ holds the whole pinned snapshot (a `lib sync --full` project vendors those on purpose), in
# the cyrius source repo (lib/ is authored) and under `-q`. CHANGELOG [6.7.12]
fn _dep_say_out_of_closure(): i64 {
    if (_dep_closure == 0 || _quiet == 1 || _dep_lock_active == 0) { return 0; }
    if (_dep_writes_lib() == 0) { return 0; }
    var off = _dep_out_of_closure();
    var k = vec_len(off);
    if (k == 0) { return 0; }
    var snap = _dep_snapshot_dir();
    if (snap != 0 && _dep_lib_holds_snapshot(snap) == 1) { return 0; }
    if (k == 1) {
        _ew("note: 1 file in lib/ is outside the declared footprint");
        _ew(" — this resolve did not vendor it, and lib/ and cyrius.lock keep it:\n");
    } else {
        _ew("note: ");
        fmt_int_fd(STDERR_FD, k);
        _ew(" files in lib/ are outside the declared footprint");
        _ew(" — this resolve did not vendor them, and lib/ and cyrius.lock keep them:\n");
    }
    var i = 0;
    while (i < k) {
        _ew("  ");
        _ew_shown(vec_get(off, i));
        _ew("\n");
        i = i + 1;
    }
    _ew("  `rm <file> && cyrius deps --lock` drops one from lib/ and cyrius.lock\n");
    return 0;
}

# 6.7.6 (part T) — the test scope's dependencies, vendored by EVERY resolve, into the same write
# root and under the same lock as the rest: `[test] stdlib` leaves (copied as a transitive pull —
# never pushed onto `_dep_includes`, so `cyrius build` does not prepend them; the test scope
# prepends them, cbt/manifest.cyr `_tc_incs_for`). lib/ and cyrius.lock are then one function of
# the manifest whichever verb resolved — a build and a test never take turns rewriting the lock.
# Returns the error count.
fn _deps_test_scope(buf, n, dir0): i64 {
    var errs = 0;
    var leaves = _tc_resolve_leaves();
    if (leaves < 0) { return 1; }
    if (leaves != 0) {
        if (_dep_stdlib_seen == 0) { _dep_stdlib_seen_init(); }
        var dir = _dep_find_stdlib_dir();
        if (dir == 0) {
            _ew("error: cannot find cyrius stdlib (for [test] stdlib)\n");
            return 1;
        }
        var i = 0;
        while (i < vec_len(leaves)) {
            var lf = vec_get(leaves, i);
            if (_dep_copy_stdlib_recursive(dir, lf, 0) == 1) { errs = errs + 1; }
            elif (_verbose == 1) { _ew("  stdlib (test): "); _ew_shown(lf); _ew("\n"); }
            i = i + 1;
        }
    }
    # The project's `scope = "test"` deps and their own dependencies: their includes go to
    # `_dep_test_includes` (the test scope prepends them, `_tc_incs_for`), and none of them is a
    # named dep of a published bundle (`_dep_nd_*`, distlib's verify unit).
    var sv_inc = _dep_includes;
    var sv_ndm = _dep_nd_modules;
    var sv_ndl = _dep_nd_leaves;
    _dep_test_includes = vec_new();
    _dep_includes = _dep_test_includes;
    _dep_nd_modules = vec_new();
    _dep_nd_leaves = vec_new();
    _dep_test_pass = 1;
    _dep_ctx_kind = 0;
    _dep_ctx_owner = 0;
    errs = errs + _process_named_deps(buf, n, dir0);
    errs = errs + _deps_drain();
    _dep_test_pass = 0;
    _dep_includes = sv_inc;
    _dep_nd_modules = sv_ndm;
    _dep_nd_leaves = sv_ndl;
    return errs;
}

# Auto-resolve deps if manifest has [deps] section.
# Called before build/run/test to ensure lib/ is populated.
fn _auto_deps(): i64 {
    # 6.6.17: the WHOLE manifest, through the one reader (cbt/manifest.cyr). This read a fixed
    # 65,535 bytes (4,095 before v6.5.28): a `[deps]` past the cut was invisible, and the "larger
    # than 65535 bytes" line it printed was an error that did not stop the build. A manifest that
    # cannot be read (or is past 16 MiB) now fails the verb by name.
    var ml = _mf_load();
    if (ml < 0) { return 1; }
    if (ml == 0) { return 0; }
    _dep_warn_manifest();   # 6.7.6 (R11): a table / [deps] key nothing reads is named, once
    var has_deps = 0;
    var info[32];
    var p = 0;
    while (p < _mf_len) {
        p = _toml_line(_mf_buf, _mf_len, p, &info);
        if (load64(&info) == 1) {
            var hs = _mf_buf + load64(&info + 8);
            var hl = load64(&info + 16);
            if (hl == 4 && memeq(hs, "deps", 4) == 1) { has_deps = 1; }
            # 6.6.20: a dep table is what the resolver's ONE header rule says (`_dep_hdr_name`) —
            # this kept its own (`hl > 5`), so a manifest whose only dep table was `[deps.]` made
            # build / run / test skip the resolve silently while `cyrius deps` refused it by name.
            var hc = 0;
            if (_dep_hdr_name(_mf_buf, _mf_len, &info, &hc) != 0) { has_deps = 1; }
        }
    }
    # `[build].modules` is read BEFORE the `[deps]` early return: a manifest with modules and
    # no `[deps]` section had them silently ignored, and the build failed with "undefined
    # function" pointing nowhere near the manifest (the v6.4.63 shape of _check_lib_freshness).
    # The modules are prepended before the entry point. CHANGELOG [6.6.9].
    _build_modules = _mf_strs("build", "modules");
    if (_toml_bad == 1) {
        _err("cyrius.cyml [build] modules must be a string or an array of strings");
        return 1;
    }
    # 6.6.19: `[embed]` beside it, for the same reason (before the `[deps]` early return): every
    # entry validated and each file read once, here, so a refused one fails the verb by name.
    # 6.6.20: with [deps] to resolve, its collision check runs AFTER cmd_deps has vendored lib/
    # (the validation stays here, ahead of any clone). CHANGELOG [6.6.20].
    _embed_coll_later = has_deps;
    var ee = _embed_load();
    _embed_coll_later = 0;
    if (ee < 0) { return 1; }
    # 6.6.20 (SEC-04): `[package] version` beside it — a `${file:PATH}` checked by the [embed]
    # rules, a value holding a control byte refused — so a verb that compiles fails by name here,
    # before a compile writes it after `#@pkgver`. CHANGELOG [6.6.20] (the file-include manifest read bug)
    if (_dep_read_cyml_package_version() < 0) { return 1; }
    _embeds = 0;
    if (vec_len(ee) > 0) { _embeds = ee; }
    # 6.7.6 (part T): a manifest whose only dependency is a test leaf still resolves
    if (has_deps == 0) {
        var tl = _tc_resolve_leaves();
        if (tl < 0) { return 1; }
        if (tl != 0) { has_deps = 1; }
    }
    if (has_deps == 0) { return 0; }
    var dr = cmd_deps();
    if (dr != 0) { return dr; }
    return _embed_collide_vendored();
}
