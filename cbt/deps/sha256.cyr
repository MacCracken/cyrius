# CLI — deps: the lock's in-process SHA-256 (FIPS 180-4).
# ================================================================
# Split from cbt/deps.cyr at 6.7.18, unchanged; cbt/cyrius.cyr includes the pieces in order. CHANGELOG [6.7.18]

# ================================================================
# Dep integrity — lockfile generation and verification
# ================================================================
# cyrius.lock format: one line per dep file
#   sha256hex  lib/name.cyr
# Generated by cyrius deps, verified by cyrius deps --verify

# ⛔ 6.7.12 — THE LOCK'S DIGESTS ARE COMPUTED IN PROCESS (FIPS 180-4 SHA-256, below). Until 6.7.12
# `_sha256sum_file` spawned `sha256sum` (else `shasum -a 256`) through /usr/bin/env, and on PE
# System32 `certutil.exe`: an external binary sat in cyrius.lock's trust path, every hash cost a
# process, a full temp dir lost the capture, and where none of the three runs — wine has no
# certutil — no lock was written at all (`warning: cyrius.lock NOT written — cannot hash
# lib/alloc.cyr (and 15 more)`). The digest is byte-for-byte what sha256sum prints (lowercase hex),
# so no existing cyrius.lock churns; tests/gates/toolchain/cli_path_reporting_leftovers.sh compares
# it with sha256sum over the whole lib/ corpus and the padding edge sizes. CHANGELOG [6.7.12]
var _sha_fail = 0;    # why the last _sha256sum_file returned 0: 2 = the file could not be read
var _sha_errno = 0;   # the errno behind it (0 when the read failed without one)
var _lk_K = 0;        # the 64 round constants, filled on first use

fn _lk_k0(k): i64 {
    store64(k + 0, 0x428a2f98);
    store64(k + 8, 0x71374491);
    store64(k + 16, 0xb5c0fbcf);
    store64(k + 24, 0xe9b5dba5);
    store64(k + 32, 0x3956c25b);
    store64(k + 40, 0x59f111f1);
    store64(k + 48, 0x923f82a4);
    store64(k + 56, 0xab1c5ed5);
    store64(k + 64, 0xd807aa98);
    store64(k + 72, 0x12835b01);
    store64(k + 80, 0x243185be);
    store64(k + 88, 0x550c7dc3);
    store64(k + 96, 0x72be5d74);
    store64(k + 104, 0x80deb1fe);
    store64(k + 112, 0x9bdc06a7);
    store64(k + 120, 0xc19bf174);
    return 0;
}

fn _lk_k1(k): i64 {
    store64(k + 128, 0xe49b69c1);
    store64(k + 136, 0xefbe4786);
    store64(k + 144, 0x0fc19dc6);
    store64(k + 152, 0x240ca1cc);
    store64(k + 160, 0x2de92c6f);
    store64(k + 168, 0x4a7484aa);
    store64(k + 176, 0x5cb0a9dc);
    store64(k + 184, 0x76f988da);
    store64(k + 192, 0x983e5152);
    store64(k + 200, 0xa831c66d);
    store64(k + 208, 0xb00327c8);
    store64(k + 216, 0xbf597fc7);
    store64(k + 224, 0xc6e00bf3);
    store64(k + 232, 0xd5a79147);
    store64(k + 240, 0x06ca6351);
    store64(k + 248, 0x14292967);
    return 0;
}

fn _lk_k2(k): i64 {
    store64(k + 256, 0x27b70a85);
    store64(k + 264, 0x2e1b2138);
    store64(k + 272, 0x4d2c6dfc);
    store64(k + 280, 0x53380d13);
    store64(k + 288, 0x650a7354);
    store64(k + 296, 0x766a0abb);
    store64(k + 304, 0x81c2c92e);
    store64(k + 312, 0x92722c85);
    store64(k + 320, 0xa2bfe8a1);
    store64(k + 328, 0xa81a664b);
    store64(k + 336, 0xc24b8b70);
    store64(k + 344, 0xc76c51a3);
    store64(k + 352, 0xd192e819);
    store64(k + 360, 0xd6990624);
    store64(k + 368, 0xf40e3585);
    store64(k + 376, 0x106aa070);
    return 0;
}

fn _lk_k3(k): i64 {
    store64(k + 384, 0x19a4c116);
    store64(k + 392, 0x1e376c08);
    store64(k + 400, 0x2748774c);
    store64(k + 408, 0x34b0bcb5);
    store64(k + 416, 0x391c0cb3);
    store64(k + 424, 0x4ed8aa4a);
    store64(k + 432, 0x5b9cca4f);
    store64(k + 440, 0x682e6ff3);
    store64(k + 448, 0x748f82ee);
    store64(k + 456, 0x78a5636f);
    store64(k + 464, 0x84c87814);
    store64(k + 472, 0x8cc70208);
    store64(k + 480, 0x90befffa);
    store64(k + 488, 0xa4506ceb);
    store64(k + 496, 0xbef9a3f7);
    store64(k + 504, 0xc67178f2);
    return 0;
}

# The round constants K[0..63] (FIPS 180-4 §4.2.2), allocated and filled once.
fn _lk_consts(): i64 {
    if (_lk_K != 0) { return _lk_K; }
    var k = alloc(512);
    _lk_k0(k);
    _lk_k1(k);
    _lk_k2(k);
    _lk_k3(k);
    _lk_K = k;
    return k;
}

# The message schedule W[0..63] of the 64-byte block at `p` into `w` (64 words).
fn _lk_schedule(p, w): i64 {
    var i = 0;
    while (i < 16) {
        var o = p + i * 4;
        var hi = ((load8(o) & 255) << 24) | ((load8(o + 1) & 255) << 16);
        store64(w + i * 8, hi | ((load8(o + 2) & 255) << 8) | (load8(o + 3) & 255));
        i = i + 1;
    }
    while (i < 64) {
        var x = load64(w + (i - 15) * 8);
        var y = load64(w + (i - 2) * 8);
        # the rotations are written out (a call per rotation tripled the time); every value is
        # below 2^32, so the bits a left shift carries past 31 are masked off at the end
        var s0 = ((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3);
        var s1 = ((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10);
        var sum = load64(w + (i - 16) * 8) + (s0 & 0xFFFFFFFF) + load64(w + (i - 7) * 8) + (s1 & 0xFFFFFFFF);
        store64(w + i * 8, sum & 0xFFFFFFFF);
        i = i + 1;
    }
    return 0;
}

# Compress one 64-byte block at `p` into the state `h` (8 words); `w` is 64 words of scratch.
fn _lk_block(h, p, w): i64 {
    _lk_schedule(p, w);
    var k = _lk_consts();
    var a = load64(h);
    var b = load64(h + 8);
    var c = load64(h + 16);
    var d = load64(h + 24);
    var e = load64(h + 32);
    var f = load64(h + 40);
    var g = load64(h + 48);
    var hh = load64(h + 56);
    var i = 0;
    while (i < 64) {
        var s1 = (((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))) & 0xFFFFFFFF;
        var ch = (e & f) ^ ((e ^ 0xFFFFFFFF) & g);
        var t1 = (hh + s1 + ch + load64(k + i * 8) + load64(w + i * 8)) & 0xFFFFFFFF;
        var s0 = (((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))) & 0xFFFFFFFF;
        var mj = (a & b) ^ (a & c) ^ (b & c);
        var t2 = (s0 + mj) & 0xFFFFFFFF;
        hh = g;
        g = f;
        f = e;
        e = (d + t1) & 0xFFFFFFFF;
        d = c;
        c = b;
        b = a;
        a = (t1 + t2) & 0xFFFFFFFF;
        i = i + 1;
    }
    store64(h, (load64(h) + a) & 0xFFFFFFFF);
    store64(h + 8, (load64(h + 8) + b) & 0xFFFFFFFF);
    store64(h + 16, (load64(h + 16) + c) & 0xFFFFFFFF);
    store64(h + 24, (load64(h + 24) + d) & 0xFFFFFFFF);
    store64(h + 32, (load64(h + 32) + e) & 0xFFFFFFFF);
    store64(h + 40, (load64(h + 40) + f) & 0xFFFFFFFF);
    store64(h + 48, (load64(h + 48) + g) & 0xFFFFFFFF);
    store64(h + 56, (load64(h + 56) + hh) & 0xFFFFFFFF);
    return 0;
}

# The initial hash value H(0) (FIPS 180-4 §5.3.3) into `h`.
fn _lk_init(h): i64 {
    store64(h, 0x6a09e667);
    store64(h + 8, 0xbb67ae85);
    store64(h + 16, 0x3c6ef372);
    store64(h + 24, 0xa54ff53a);
    store64(h + 32, 0x510e527f);
    store64(h + 40, 0x9b05688c);
    store64(h + 48, 0x1f83d9ab);
    store64(h + 56, 0x5be0cd19);
    return 0;
}

# The last block(s): the `tl` (< 64) tail bytes at `tail`, 0x80, zeros, and the message length
# `total` in bits, big-endian (FIPS 180-4 §5.1.1); then the state `h` as 64 lowercase hex digits.
fn _lk_finish(h, tail, tl, total, w): i64 {
    var blk = alloc(128);
    memset(blk, 0, 128);
    memcpy(blk, tail, tl);
    store8(blk + tl, 0x80);
    var nb = 64;
    if (tl >= 56) { nb = 128; }
    var bits = total * 8;
    var j = 0;
    while (j < 8) {
        store8(blk + nb - 1 - j, (bits >> (j * 8)) & 255);
        j = j + 1;
    }
    _lk_block(h, blk, w);
    if (nb == 128) { _lk_block(h, blk + 64, w); }
    var hx = "0123456789abcdef";
    var out = alloc(65);
    var i = 0;
    while (i < 32) {
        var bv = (load64(h + (i / 4) * 8) >> ((3 - (i % 4)) * 8)) & 255;
        store8(out + i * 2, load8(hx + (bv >> 4)));
        store8(out + i * 2 + 1, load8(hx + (bv & 15)));
        i = i + 1;
    }
    store8(out + 64, 0);
    return out;
}

# The SHA-256 of the file at `path` as 64 lowercase hex digits (what `sha256sum` prints), or 0
# with `_sha_fail` = 2 when it cannot be opened or read. Read 32 KiB at a time; every whole block
# is compressed where it lies, the tail carried to the next read.
fn _sha256sum_file(path): i64 {
    _sha_fail = 0;
    _sha_errno = 0;
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd < 0) { _sha_fail = 2; _sha_errno = 0 - fd; return 0; }
    var buf = alloc(32768 + 64);
    var h = alloc(64);
    var w = alloc(512);
    _lk_init(h);
    var have = 0;     # bytes at buf still to be compressed (< 64 between reads)
    var total = 0;
    var go = 1;
    while (go == 1) {
        var n = syscall(0, fd, buf + have, 32768);
        if (n < 0) { sys_close(fd); _sha_fail = 2; _sha_errno = 0 - n; return 0; }
        if (n == 0) { go = 0; }
        else {
            total = total + n;
            have = have + n;
            var off = 0;
            while (have - off >= 64) {
                _lk_block(h, buf + off, w);
                off = off + 64;
            }
            if (off > 0) {
                memcpy(buf, buf + off, have - off);
                have = have - off;
            }
        }
    }
    sys_close(fd);
    return _lk_finish(h, buf, have, total, w);
}

# The SHA-256 of the file at `path` READ WITH EVERY CRLF AS LF (a lone CR kept), as
# `_sha256sum_file` prints it, or 0 with `_sha_fail` set. A DIAGNOSTIC only: cyrius.lock proves
# the exact bytes, so this never makes a file verify — when a file that fails its locked hash
# matches it this way, the failure is named as a CRLF checkout (git's core.autocrlf rewrote lib/
# on checkout) with the `.gitattributes` remedy instead of a bare mismatch. CHANGELOG [6.7.12]
fn _sha256sum_file_lf(path): i64 {
    _sha_fail = 0;
    _sha_errno = 0;
    var fd = sys_open(path, O_RDONLY, 0);
    if (fd < 0) { _sha_fail = 2; _sha_errno = 0 - fd; return 0; }
    var raw = alloc(32768);
    var buf = alloc(32768 + 128);
    var h = alloc(64);
    var w = alloc(512);
    _lk_init(h);
    var have = 0;     # folded bytes at buf still to be compressed (< 64 between reads)
    var total = 0;    # folded bytes in all
    var cr = 0;       # 1 when the last byte read was a CR not yet written (a CRLF may span reads)
    var go = 1;
    while (go == 1) {
        var n = syscall(0, fd, raw, 32768);
        if (n < 0) { sys_close(fd); _sha_fail = 2; _sha_errno = 0 - n; return 0; }
        var emit = 0;
        if (n == 0) {
            go = 0;
            if (cr == 1) { store8(buf + have, 13); emit = 1; cr = 0; }
        } else {
            var i = 0;
            while (i < n) {
                var b = load8(raw + i) & 255;
                i = i + 1;
                if (cr == 1) {
                    cr = 0;
                    if (b != 10) { store8(buf + have + emit, 13); emit = emit + 1; }
                }
                if (b == 13) { cr = 1; }
                else { store8(buf + have + emit, b); emit = emit + 1; }
            }
        }
        total = total + emit;
        have = have + emit;
        var off = 0;
        while (have - off >= 64) {
            _lk_block(h, buf + off, w);
            off = off + 64;
        }
        if (off > 0) {
            memcpy(buf, buf + off, have - off);
            have = have - off;
        }
    }
    sys_close(fd);
    return _lk_finish(h, buf, have, total, w);
}

# 1 when `path`, read with CRLF as LF, hashes to the 64 hex digits at `want` (a CRLF checkout of
# those bytes), else 0 — also when it cannot be read. CHANGELOG [6.7.12]
fn _sha_is_crlf_of(path, want): i64 {
    if (want == 0) { return 0; }
    var fh = _sha256sum_file_lf(path);
    if (fh == 0) { return 0; }
    return memeq(fh, want, 64);
}

# Print why the last `_sha256sum_file` returned 0, to stderr, no newline.
fn _sha_fail_why(): i64 {
    _ew("the hasher could not read it");
    if (_sha_errno > 0) { _ew(" (errno "); fmt_int_fd(STDERR_FD, _sha_errno); _ew(")"); }
    return 0;
}

# the release-integrity hardening item (v6.2.30) — cstr equality (length-checked memeq).
fn _cstr_eq(a, b): i64 {
    var la = strlen(a);
    if (la != strlen(b)) { return 0; }
    return memeq(a, b, la);
}
