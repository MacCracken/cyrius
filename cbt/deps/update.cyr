# CLI — deps: `cyrius update` and the newer-tag report.
# ================================================================
# Split from cbt/deps.cyr at 6.7.18, unchanged; cbt/cyrius.cyr includes the pieces in order. CHANGELOG [6.7.18]

fn cmd_update(): i64 {
    _dep_vendor_mode = 1;   # v6.5.37 (A0): vendoring — symlinked destinations are refused
    _status("=== cyrius update ===");
    # 6.7.12 (D18, the user, 2026-10-15) — lib/ IS REFRESHED THE WAY `cyrius lib sync` REFRESHES
    # IT: the declared `[deps] stdlib` set (its per-OS peers and the test scope's leaves) from the
    # snapshot of the manifest's `[package].cyrius` pin, `--full` for the whole snapshot — the same
    # plan, lock guard, re-lock and source-repo refusal, through the same function. Until 6.7.12
    # update walked `versions/<$CYRIUS_HOME/current>/lib` and copied all of it (113 files for
    # stdlib = ["string", "alloc"]), whatever the manifest declared or pinned, and left cyrius.lock
    # holding the rows of the files it overwrote. CHANGELOG [6.7.12]
    if (cmd_lib_sync() != 0) { return 1; }
    var cur = _dep_read_cyml_cyrius_field();
    if (cur == 0) { cur = _VERSION_TOOLCHAIN; }

    # .cyrius-toolchain names the version lib/ was just refreshed from
    if (file_exists(".cyrius-toolchain") == 1) {
        var tc_sb = str_builder_new();
        str_builder_add_cstr(tc_sb, cur);
        str_builder_add_cstr(tc_sb, "\n");
        var tc_str = str_data(str_builder_build(tc_sb));
        # v6.6.6: crash-safe and checked — was file_write_all with the result dropped.
        # 6.6.20 (the committed-symlink write bug): a link here is followed only inside the project — a checkout's
        # `.cyrius-toolchain -> ~/.profile` was overwritten with the version string.
        if (_io_replace_atomic_in(".", ".cyrius-toolchain", tc_str, strlen(tc_str)) != 0) {
            if (_io_contain_link != 0) { _io_contain_refusal("error"); return 1; }
            _err("write failed: .cyrius-toolchain (left as it was)");
            return 1;
        }
        sys_write(STDOUT_FD, "  .cyrius-toolchain -> ", 23);
        println(cur);
    }

    # Migrate cyrius.toml → cyrius.cyml if toml exists and cyml doesn't
    if (file_exists("cyrius.toml") == 1 && file_exists("cyrius.cyml") == 0) {
        # v6.6.6: the WHOLE toml (was `alloc(32768)` + a 32767-byte read). The migration WRITES
        # THE BUFFER BACK as cyrius.cyml and then DELETES cyrius.toml, so a manifest past the cap
        # was silently truncated and the only untruncated copy removed. CHANGELOG [6.6.6]
        var toml_n = 0;
        var toml_buf = file_read_whole("cyrius.toml", &toml_n);
        if (toml_buf != 0 && toml_n > 0) {
            # Write cyrius.cyml: TOML content + separator + empty body
            var cyml_sb = str_builder_new();
            var ti = 0;
            while (ti < toml_n) {
                str_builder_add_byte(cyml_sb, load8(toml_buf + ti));
                ti = ti + 1;
            }
            # Ensure trailing newline before separator
            if (toml_n > 0 && load8(toml_buf + toml_n - 1) != 10) {
                str_builder_add_cstr(cyml_sb, "\n");
            }
            str_builder_add_cstr(cyml_sb, "---\n");
            var cyml_str = str_data(str_builder_build(cyml_sb));
            # v6.6.6: the toml is deleted ONLY once the cyml is fully on disk — the unchecked
            # file_write_all here could leave a truncated cyml AND delete the only good copy.
            # 6.6.20 (the committed-symlink write bug): `file_exists` is 0 for a DANGLING link, so a checkout's
            # `cyrius.cyml -> ~/.ssh/authorized_keys` reached here and CREATED that file from its
            # own cyrius.toml. A link is followed only inside the project; the toml is kept.
            if (_io_replace_atomic_in(".", "cyrius.cyml", cyml_str, strlen(cyml_str)) != 0) {
                if (_io_contain_link != 0) {
                    _io_contain_refusal("error");
                    _err("cyrius.toml kept, not migrated");
                    return 1;
                }
                _err("write failed: cyrius.cyml (cyrius.toml kept)");
                return 1;
            }
            sys_unlink("cyrius.toml");
            println("  migrated cyrius.toml -> cyrius.cyml");
        }
    }

    # 6.7.6 (R8) — THE DEPENDENCIES, which `update` always promised ("re-resolve all deps to latest
    # tags") and never touched. An UNTAGGED dep's clone is re-fetched — it floats by design, and the
    # cache froze it at its first fetch (`_dep_update_mode`, in the resolver); then the manifest
    # re-resolves (lib/ + cyrius.lock); then each root dep's NEWER tags are listed. cyrius.cyml is
    # never edited: moving a dependency to another tag is its author's decision, made in the file.
    if (_mf_load() == 1 && _dep_has_named(_mf_buf, _mf_len) == 1) {
        println("  dependencies:");
        _dep_update_mode = 1;
        var dr = cmd_deps();
        _dep_update_mode = 0;
        if (dr != 0) { return 1; }
        _dep_report_newer_tags(_mf_buf, _mf_len);
    }
    return 0;
}

# 1 when the manifest header declares a [deps.NAME] table.
fn _dep_has_named(buf, n): i64 {
    var info[32];
    var p = 0;
    while (p < n) {
        p = _toml_line(buf, n, p, &info);
        var hc = 0;
        if (_dep_hdr_name(buf, n, &info, &hc) != 0) { return 1; }
    }
    return 0;
}

# A version-shaped tag — `[v]N(.N)*` — as its numeric parts (a vec), or 0 for any other shape (a
# pre-release, a named tag), which `update` does not order.
fn _dep_ver_parts(t): i64 {
    var i = 0;
    if (load8(t) == 118 || load8(t) == 86) { i = 1; }   # v / V
    var out = vec_new();
    var have = 0;
    var cur = 0;
    while (load8(t + i) != 0) {
        var c = load8(t + i);
        if (c >= 48 && c <= 57) {
            if (cur > 99999999) { return 0; }
            cur = cur * 10 + (c - 48);
            have = 1;
        } elif (c == 46 && have == 1) {
            vec_push(out, cur);
            cur = 0;
            have = 0;
        } else { return 0; }
        i = i + 1;
    }
    if (have == 0) { return 0; }
    vec_push(out, cur);
    return out;
}

# <0, 0, >0 as version a orders before, equal to, after version b (both from _dep_ver_parts).
fn _dep_ver_cmp(a, b): i64 {
    var i = 0;
    while (i < vec_len(a) || i < vec_len(b)) {
        var x = 0;
        var y = 0;
        if (i < vec_len(a)) { x = vec_get(a, i); }
        if (i < vec_len(b)) { y = vec_get(b, i); }
        if (x != y) { return x - y; }
        i = i + 1;
    }
    return 0;
}

# `cyrius update`: for each root [deps.NAME] with a remote git and a version-shaped tag, the
# remote's tags that order after it (`git ls-remote --tags`), newest first.
#     sigil: 3.9.9 pinned; newer tags: 3.10.0, 3.9.10 (cyrius.cyml is not edited)
fn _dep_report_newer_tags(buf, n): i64 {
    var info[32];
    var rec = alloc(_DS_SIZE);
    var p = 0;
    while (p < n) {
        p = _toml_line(buf, n, p, &info);
        var hc = 0;
        var nm = _dep_hdr_name(buf, n, &info, &hc);
        if (nm == 0 || hc == 0 || _dep_name_unsafe(nm) == 1) { continue; }
        p = _dep_sec_read(buf, n, p, ".", rec);
        var git = load64(rec + _DS_GIT);
        var tag = load64(rec + _DS_TAG);
        if (git == 0 || tag == 0 || _dep_git_remote(git) == 0) { continue; }
        if (_dep_git_plaintext(git) != 0) {   # never asked over the clear (6.7.18)
            sys_write(STDOUT_FD, "    ", 4);
            var pn = _shown(nm);
            sys_write(STDOUT_FD, pn, strlen(pn));
            println(": not listed — its git is a plaintext URL (refused; use https:// or ssh://)");
            continue;
        }
        var mine = _dep_ver_parts(tag);
        sys_write(STDOUT_FD, "    ", 4);
        var sn = _shown(nm);
        sys_write(STDOUT_FD, sn, strlen(sn));
        sys_write(STDOUT_FD, ": ", 2);
        var st = _shown(tag);
        sys_write(STDOUT_FD, st, strlen(st));
        if (mine == 0) { println(" pinned (not a version number: newer tags are not compared)"); continue; }
        var tf = _cbt_tmpfile("ls_remote");
        var rc = _dep_wt_run(0, "ls-remote", "--tags", "--", git, tf);
        if (rc != 0) {
            _cbt_scratch_drop(tf);
            sys_write(STDOUT_FD, " pinned; the remote's tags could not be listed", 46);
            var why = _dep_wt_why;
            if (why != 0) { sys_write(STDOUT_FD, " (", 2); var sw = _shown(why); sys_write(STDOUT_FD, sw, strlen(sw)); sys_write(STDOUT_FD, ")", 1); }
            sys_write(STDOUT_FD, "\n", 1);
            continue;
        }
        var newer = _dep_newer_tags(tf, mine);
        _cbt_scratch_drop(tf);
        if (vec_len(newer) == 0) { println(" pinned; it is the newest version tag"); continue; }
        sys_write(STDOUT_FD, " pinned; newer tags: ", 21);
        var k = 0;
        while (k < vec_len(newer) && k < 6) {
            if (k > 0) { sys_write(STDOUT_FD, ", ", 2); }
            var ns = _shown(vec_get(newer, k));
            sys_write(STDOUT_FD, ns, strlen(ns));
            k = k + 1;
        }
        if (vec_len(newer) > 6) {
            sys_write(STDOUT_FD, " (and ", 6);
            fmt_int(vec_len(newer) - 6);
            sys_write(STDOUT_FD, " more)", 6);
        }
        println(" (cyrius.cyml is not edited)");
    }
    return 0;
}

# The first line of the file at `path` (bounded), or 0.
fn _git_first_line_of(path): i64 {
    var buf = alloc(256);
    var nn = file_read_all(path, buf, 255);
    if (nn <= 0) { return 0; }
    var i = 0;
    while (i < nn && load8(buf + i) != 10 && load8(buf + i) != 13) { i = i + 1; }
    if (i == 0) { return 0; }
    store8(buf + i, 0);
    return buf;
}

# The `refs/tags/<t>` names in an `ls-remote --tags` capture whose version orders after `mine`,
# newest first (peeled `^{}` lines skipped, each tag once).
fn _dep_newer_tags(tf, mine): i64 {
    var out = vec_new();
    var vers = vec_new();
    var nn = 0;
    var b = file_read_whole(tf, &nn);
    if (b == 0 || nn <= 0) { return out; }
    var pos = 0;
    while (pos < nn) {
        var le = pos;
        while (le < nn && load8(b + le) != 10) { le = le + 1; }
        var t = pos;
        while (t < le && load8(b + t) != 9) { t = t + 1; }
        if (t + 11 < le && memeq(b + t + 1, "refs/tags/", 10) == 1) {
            var s = t + 11;
            var e = le;
            if (e > s && load8(b + e - 1) == 13) { e = e - 1; }
            var peeled = 0;
            if (e - s > 3 && memeq(b + e - 3, "^{}", 3) == 1) { peeled = 1; }
            if (peeled == 0) {
                var tg = _git_cstr_copy(b + s, e - s);
                var tv = _dep_ver_parts(tg);
                if (tv != 0 && _dep_ver_cmp(tv, mine) > 0 && _dep_list_has(out, tg) == 0) {
                    # insertion, newest first
                    var at = 0;
                    while (at < vec_len(out) && _dep_ver_cmp(vec_get(vers, at), tv) > 0) { at = at + 1; }
                    vec_push(out, tg);
                    vec_push(vers, tv);
                    var j = vec_len(out) - 1;
                    while (j > at) {
                        vec_set(out, j, vec_get(out, j - 1));
                        vec_set(vers, j, vec_get(vers, j - 1));
                        j = j - 1;
                    }
                    vec_set(out, at, tg);
                    vec_set(vers, at, tv);
                }
            }
        }
        pos = le + 1;
    }
    return out;
}
