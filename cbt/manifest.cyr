# ================================================================
# cbt/manifest.cyr — cyrius.cyml as the build tool's CONFIGURATION (6.6.17, P1)
# ================================================================
#
# WHY THIS FILE EXISTS. The manifest was read partially and inconsistently: some keys were
# load-bearing, some decorative, and nothing distinguished them. `[build] test` was declared by
# 41 manifests and read by nothing (kashi's 393 assertions never ran in CI); `[build] defines`
# was declared by 3 and read by nothing; and v6.5.49's `[build]` fallback shipped INERT because
# it read `src` while 120 of 125 manifests wrote `entry`. An inert key cannot be observed to be
# wrong. So every key the docs, the `cyrius init` templates or the ecosystem use is declared
# ONCE, below, with what reads it — and `cyrius help manifest` prints that table, the guide's
# table mirrors it, and tests/gates/toolchain/manifest_key_inventory.sh checks the two against
# each other and against what consumers actually write. CHANGELOG [6.6.17].

# ── THE DECLARED KEY VOCABULARY ───────────────────────────────────
# One row per key: "section|key|status|synonyms|environment|argument|read by".
#   status   read    — something in the toolchain reads it
#            held    — recognised, deliberately NOT read yet; a present key is warned by name
#            dropped — never read; a present key is warned by name
#            info    — metadata for people and package recipes; never changes a build
#   section  `deps.*` / `lib.*` stand for every `[deps.NAME]` / `[lib.PROFILE]`; key `*` for any
#            name (a `[features]` feature, a `[groups]` group).
#   synonyms resolved HERE and nowhere else (`entry` first, then `src`).
# Precedence for every key: argument > environment > manifest > default. A `-` channel means the
# key has no such rung.
fn _mf_vocab_a(i): i64 {
    if (i == 0) { return "package|name|read|-|-|-|bundle name (cyrius distlib); the cyrius-source-repo check"; }
    if (i == 1) { return "package|version|read|-|-|-|CYRIUS_PKG_VERSION (${file:PATH} expands)"; }
    if (i == 2) { return "package|cyrius|read|-|-|-|the toolchain pin: re-exec into versions/<v>, its stdlib"; }
    if (i == 3) { return "package|description|info|-|-|-|people and package recipes"; }
    if (i == 4) { return "package|license|info|-|-|-|people and package recipes"; }
    if (i == 5) { return "package|language|info|-|-|-|people and package recipes"; }
    if (i == 6) { return "package|repository|info|-|-|-|people and package recipes"; }
    if (i == 7) { return "build|entry|read|src|-|<source>|cyrius build, cyrius package: the source"; }
    if (i == 8) { return "build|output|read|-|-|<output>|cyrius build, cyrius package: the output (a default)"; }
    if (i == 9) { return "build|test|read|-|-|<file>...|bare cyrius test: these (file / dir / list), then tests/"; }
    if (i == 10) { return "build|modules|read|-|-|-|every compile: these files prepended before the entry"; }
    if (i == 11) { return "build|dce|read|-|CYRIUS_DCE|--dce|cyrius build: dead-code elimination (bool)"; }
    if (i == 12) { return "build|strict|held|-|-|--strict|has had no effect since 6.3.2: a reachable undefined function is an error by default; --allow-undef downgrades it"; }
    if (i == 13) { return "build|defines|read|-|CYRIUS_DEFINES|-D|cyrius build: one #define per name"; }
    if (i == 14) { return "build|target|held|-|-|-|pass --target / --aarch64 / --win / --agnos on the command line"; }
    if (i == 15) { return "build|features|dropped|-|-|-|features are [features] + --features"; }
    if (i == 16) { return "coverage|programs|read|-|-|--programs|cyrius coverage: RUN programs in the corpus (globs)"; }
    if (i == 17) { return "sections|base|read|-|-|-|bare-metal builds: the image load base"; }
    return 0;
}

fn _mf_vocab_b(i): i64 {
    if (i == 18) { return "deps|stdlib|read|-|-|-|cyrius deps: stdlib leaves vendored into lib/ and auto-prepended"; }
    if (i == 19) { return "deps.*|git|read|-|-|-|cyrius deps: the repository to clone"; }
    if (i == 20) { return "deps.*|tag|read|-|-|-|cyrius deps: the tag to check out"; }
    if (i == 21) { return "deps.*|path|read|-|-|-|cyrius deps: a local checkout instead of git"; }
    if (i == 22) { return "deps.*|modules|read|-|-|-|cyrius deps: the files to vendor"; }
    if (i == 23) { return "deps.*|modular|read|-|-|-|cyrius deps: sub-modules from dist/<name>/"; }
    if (i == 24) { return "deps.*|requires|read|-|-|-|cyrius deps: stdlib leaves the dep needs in scope"; }
    if (i == 25) { return "deps.*|optional|read|-|-|--features|cyrius deps: resolve only when a feature names it"; }
    if (i == 26) { return "deps.*|target|read|-|-|--target|cyrius deps: resolve only for a matching target"; }
    if (i == 27) { return "lib|modules|read|-|-|-|cyrius distlib: the base bundle"; }
    if (i == 28) { return "lib.*|modules|read|-|-|<profile>|cyrius distlib <profile>"; }
    if (i == 29) { return "lib|embed|read|-|-|-|cyrius distlib: the [embed] entries the base bundle carries"; }
    if (i == 30) { return "lib.*|embed|read|-|-|<profile>|cyrius distlib <profile>: the [embed] entries this bundle carries"; }
    if (i == 31) { return "features|default|read|-|-|--no-default-features|cyrius deps: features on by default"; }
    if (i == 32) { return "features|*|read|-|-|--features|cyrius deps: a feature and the optional deps it turns on"; }
    if (i == 33) { return "groups|*|read|-|-|-|cyrius deps: a named group of stdlib leaves"; }
    if (i == 34) { return "release|bins|read|-|-|-|release.yml, install.sh, cyrius pulsar"; }
    if (i == 35) { return "release|cross_bins|read|-|-|-|release.yml, install.sh, cyrius pulsar"; }
    if (i == 36) { return "release|scripts|read|-|-|-|release.yml, install.sh"; }
    if (i == 37) { return "embed|*|read|-|-|-|every compile: the file's bytes as NAME() / NAME_len(), prepended before the entry"; }
    return 0;
}

fn _mf_vocab(i): i64 {
    if (i < 18) { return _mf_vocab_a(i); }
    return _mf_vocab_b(i);
}

# Field `f` (0-based) of vocabulary row `row`, as a fresh cstr.
fn _mf_vocab_field(row, f): i64 {
    var i = 0;
    var k = 0;
    while (k < f) {
        while (load8(row + i) != 0 && load8(row + i) != 124) { i = i + 1; }
        if (load8(row + i) == 0) { return ""; }
        i = i + 1;
        k = k + 1;
    }
    var s = i;
    while (load8(row + i) != 0 && load8(row + i) != 124) { i = i + 1; }
    var out = alloc(i - s + 1);
    memcpy(out, row + s, i - s);
    store8(out + i - s, 0);
    return out;
}

# 1 when `key` is one of the comma-separated names in `syns` (a vocabulary synonyms field).
fn _mf_syn_has(syns, key): i64 {
    var kl = strlen(key);
    var i = 0;
    while (load8(syns + i) != 0) {
        var s = i;
        while (load8(syns + i) != 0 && load8(syns + i) != 44) { i = i + 1; }
        if (i - s == kl && memeq(syns + s, key, kl) == 1) { return 1; }
        if (load8(syns + i) == 44) { i = i + 1; }
    }
    return 0;
}

# The vocabulary row for `key` in `section`, or 0 when the key is not declared. A declared
# SYNONYM finds its key's row (`[build] src` is `entry`'s — the first cut warned that `src` "is
# not a known key" while reading it). A `[deps.NAME]` section looks up `deps.*`, a
# `[lib.PROFILE]` one `lib.*`; a `*` key matches any name.
fn _mf_vocab_row(section, key): i64 {
    var sec = section;
    if (strlen(section) > 5 && memeq(section, "deps.", 5) == 1) { sec = "deps.*"; }
    if (strlen(section) > 4 && memeq(section, "lib.", 4) == 1) { sec = "lib.*"; }
    var wild = 0;
    var i = 0;
    var row = _mf_vocab(0);
    while (row != 0) {
        if (streq(_mf_vocab_field(row, 0), sec) == 1) {
            var k = _mf_vocab_field(row, 1);
            if (streq(k, key) == 1) { return row; }
            if (_mf_syn_has(_mf_vocab_field(row, 3), key) == 1) { return row; }
            if (streq(k, "*") == 1) { wild = row; }
        }
        i = i + 1;
        row = _mf_vocab(i);
    }
    return wild;
}

fn _mf_pad(s, w): i64 {
    var l = strlen(s);
    sys_write(STDOUT_FD, s, l);
    while (l < w) { sys_write(STDOUT_FD, " ", 1); l = l + 1; }
    sys_write(STDOUT_FD, " ", 1);
    return 0;
}

# `cyrius help manifest` — the vocabulary, one key per line.
fn _mf_vocab_print(): i64 {
    println("cyrius.cyml keys. status: read = something reads it; held = recognised, not read yet");
    println("(warned when present); dropped = never read (warned when present); info = metadata for");
    println("people and package recipes, never changes a build.");
    println("Every key resolves argument > environment > manifest > default; `-` = no such channel.");
    println("`cyrius build --print-config` shows the value each key resolved to and where it came from.");
    println("");
    sys_write(STDOUT_FD, "  ", 2);
    _mf_pad("section", 12); _mf_pad("key", 12); _mf_pad("status", 8); _mf_pad("synonyms", 8);
    _mf_pad("environment", 15); _mf_pad("argument", 22);
    println("read by");
    var i = 0;
    var row = _mf_vocab(0);
    while (row != 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "[");
        str_builder_add_cstr(sb, _mf_vocab_field(row, 0));
        str_builder_add_cstr(sb, "]");
        sys_write(STDOUT_FD, "  ", 2);
        _mf_pad(str_data(str_builder_build(sb)), 12);
        _mf_pad(_mf_vocab_field(row, 1), 12);
        _mf_pad(_mf_vocab_field(row, 2), 8);
        _mf_pad(_mf_vocab_field(row, 3), 8);
        _mf_pad(_mf_vocab_field(row, 4), 15);
        _mf_pad(_mf_vocab_field(row, 5), 22);
        var rb = _mf_vocab_field(row, 6);
        sys_write(STDOUT_FD, rb, strlen(rb));
        sys_write(STDOUT_FD, "\n", 1);
        i = i + 1;
        row = _mf_vocab(i);
    }
    return 0;
}

# ================================================================
# THE READER — one function family for every manifest read in the CLI.
# ================================================================
# ⛔ WHY ONE. The CLI carried a separate hand-rolled scanner per key family — `[build]` (32,767-byte
# cap), `[package] cyrius` / `version` / `name` (32,767 each, three copies), `[sections] base`
# (32,767), `_auto_deps` (65,535) and `distlib` / `publish` (32,767 and 4,095) — none of which could
# see a key past its cap: measured, a `[build]` starting at byte 44,000 made `cyrius build` print
# its usage and exit 1 although the keys were there. Each also had its own value rule: a
# single-quoted value (`entry = 'src/main.cyr'`) read as absent, and the line walkers had no
# notion of a multi-line array, so a line inside one that began with `[` read as a section
# header. Now the manifest is read WHOLE (grown to fit, refused by name past 16 MiB) and parsed by
# one line walker that steps over every value it is not reading. CHANGELOG [6.6.17].

var _MF_MAX = 16777216;   # a manifest past 16 MiB is refused by name, not read
var _mf_buf = 0;          # the manifest's TOML header (a CYML body after a `---` line is cut)
var _mf_len = 0;
var _mf_state = 0;        # 0 = not read yet, 1 = loaded, 2 = no manifest, 3 = refused
var _mf_path = 0;
var _toml_bad = 0;        # set by a getter: the key is PRESENT but its value is malformed / mistyped
var _toml_unclosed = 0;   # set by a skip that ran off the end: a `"""` / `'''` string, array or inline table

fn _toml_eol(buf, n, p): i64 {
    while (p < n && load8(buf + p) != 10) { p = p + 1; }
    if (p < n) { return p + 1; }
    return n;
}

fn _toml_skip_ws(buf, n, p): i64 {
    while (p < n) {
        var c = load8(buf + p);
        if (c != 32 && c != 9 && c != 13) { return p; }
        p = p + 1;
    }
    return p;
}

# A bare-key byte: A-Z a-z 0-9 _ - (TOML), plus `.` so a dotted key reads as ONE token and never
# as its last segment.
fn _toml_keych(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 95 || c == 45 || c == 46) { return 1; }
    return 0;
}

fn _toml_hex(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    if (c >= 65 && c <= 70) { return c - 55; }
    return 0 - 1;
}

# Append code point `cp` to `out` at `o` as UTF-8; returns the new offset.
fn _toml_put_cp(out, o, cp): i64 {
    if (cp < 128) { store8(out + o, cp); return o + 1; }
    if (cp < 2048) {
        store8(out + o, 192 | (cp >> 6));
        store8(out + o + 1, 128 | (cp & 63));
        return o + 2;
    }
    if (cp < 65536) {
        store8(out + o, 224 | (cp >> 12));
        store8(out + o + 1, 128 | ((cp >> 6) & 63));
        store8(out + o + 2, 128 | (cp & 63));
        return o + 3;
    }
    store8(out + o, 240 | (cp >> 18));
    store8(out + o + 1, 128 | ((cp >> 12) & 63));
    store8(out + o + 2, 128 | ((cp >> 6) & 63));
    store8(out + o + 3, 128 | (cp & 63));
    return o + 4;
}

# Offset just past the string that opens at buf[p] (`"`, `'`, `"""` or `'''`). An unterminated
# single-line string stops at its line end.
fn _toml_skip_string(buf, n, p): i64 {
    var q = load8(buf + p);
    if (p + 2 < n && load8(buf + p + 1) == q && load8(buf + p + 2) == q) {
        var i = p + 3;
        while (i + 2 < n) {
            var c = load8(buf + i);
            if (q == 34 && c == 92) { i = i + 2; continue; }
            if (c == q && load8(buf + i + 1) == q && load8(buf + i + 2) == q) {
                i = i + 3;
                if (i < n && load8(buf + i) == q) { i = i + 1; }     # `""""` / `"""""` close
                if (i < n && load8(buf + i) == q) { i = i + 1; }
                return i;
            }
            i = i + 1;
        }
        _toml_unclosed = 1;
        return n;
    }
    var j = p + 1;
    while (j < n) {
        var d = load8(buf + j);
        if (d == 10) { return j; }
        if (d == q) { return j + 1; }
        if (q == 34 && d == 92) { j = j + 1; }
        j = j + 1;
    }
    return n;
}

# Offset just past the value at buf[p]: a string, an array or inline table (nested, multi-line,
# with strings and comments inside), or — for a bare token — p itself (the line walker then steps
# to the end of the line).
fn _toml_skip_value(buf, n, p): i64 {
    if (p >= n) { return n; }
    var c = load8(buf + p);
    if (c == 34 || c == 39) { return _toml_skip_string(buf, n, p); }
    if (c != 91 && c != 123) { return p; }
    var depth = 0;
    while (p < n) {
        c = load8(buf + p);
        if (c == 34 || c == 39) { p = _toml_skip_string(buf, n, p); continue; }
        if (c == 35) {
            while (p < n && load8(buf + p) != 10) { p = p + 1; }
            continue;
        }
        if (c == 91 || c == 123) { depth = depth + 1; }
        if (c == 93 || c == 125) {
            depth = depth - 1;
            if (depth == 0) { return p + 1; }
        }
        p = p + 1;
    }
    _toml_unclosed = 1;
    return n;
}

# Parse the line at `p` into `info` (4 x 8 B): kind (0 = blank / comment / not a key line,
# 1 = `[table]`, 2 = `[[array]]`, 3 = `key = value`), name offset, name length, value offset.
# Returns where the NEXT line starts — past a multi-line value, so no line inside one is ever
# taken for a header or a key.
fn _toml_line(buf, n, p, info): i64 {
    store64(info, 0);
    p = _toml_skip_ws(buf, n, p);
    if (p >= n) { return n; }
    var c = load8(buf + p);
    if (c == 91) {
        var k = 1;
        var s = p + 1;
        if (s < n && load8(buf + s) == 91) { k = 2; s = s + 1; }
        s = _toml_skip_ws(buf, n, s);
        var e = s;
        while (e < n && load8(buf + e) != 93 && load8(buf + e) != 10) { e = e + 1; }
        var t = e;
        while (t > s && (load8(buf + t - 1) == 32 || load8(buf + t - 1) == 9)) { t = t - 1; }
        store64(info, k);
        store64(info + 8, s);
        store64(info + 16, t - s);
        return _toml_eol(buf, n, e);
    }
    var ks = p;
    var ke = p;
    if (c == 34 || c == 39) {
        var qe = _toml_skip_string(buf, n, p);
        ks = p + 1;
        ke = qe - 1;
        p = qe;
    } else {
        while (p < n && _toml_keych(load8(buf + p)) == 1) { p = p + 1; }
        ke = p;
    }
    if (ke <= ks) { return _toml_eol(buf, n, p); }
    p = _toml_skip_ws(buf, n, p);
    if (p >= n || load8(buf + p) != 61) { return _toml_eol(buf, n, p); }
    p = _toml_skip_ws(buf, n, p + 1);
    store64(info, 3);
    store64(info + 8, ks);
    store64(info + 16, ke - ks);
    store64(info + 24, p);
    return _toml_eol(buf, n, _toml_skip_value(buf, n, p));
}

# Offset of the value of `key` in `[section]`, or -1. Names compare WHOLE: `test` is not
# `test-only`, `name` is not `display-name`, and `[build]` is not `[build.debug]`. The first
# occurrence wins.
fn _toml_find(buf, n, section, key): i64 {
    var info[32];
    var sl = strlen(section);
    var kl = strlen(key);
    var insec = 0;
    var p = 0;
    while (p < n) {
        p = _toml_line(buf, n, p, &info);
        var kind = load64(&info);
        if (kind == 1 || kind == 2) {
            insec = 0;
            if (kind == 1 && load64(&info + 16) == sl) {
                if (memeq(buf + load64(&info + 8), section, sl) == 1) { insec = 1; }
            }
        } elif (kind == 3 && insec == 1) {
            if (load64(&info + 16) == kl) {
                if (memeq(buf + load64(&info + 8), key, kl) == 1) { return load64(&info + 24); }
            }
        }
    }
    return 0 - 1;
}

# The keys present in `[section]`, in file order, as a vec of fresh cstrs (empty when the section
# is absent).
fn _toml_section_keys(buf, n, section): i64 {
    var out = vec_new();
    var info[32];
    var sl = strlen(section);
    var insec = 0;
    var p = 0;
    while (p < n) {
        p = _toml_line(buf, n, p, &info);
        var kind = load64(&info);
        if (kind == 1 || kind == 2) {
            insec = 0;
            if (kind == 1 && load64(&info + 16) == sl) {
                if (memeq(buf + load64(&info + 8), section, sl) == 1) { insec = 1; }
            }
        } elif (kind == 3 && insec == 1) {
            var kl = load64(&info + 16);
            var k = alloc(kl + 1);
            memcpy(k, buf + load64(&info + 8), kl);
            store8(k + kl, 0);
            vec_push(out, k);
        }
    }
    return out;
}

# The single-line string at buf[p] — basic `"…"` (escapes decoded) or literal `'…'` (verbatim:
# TOML literal strings have NO escapes) — as a fresh cstr, with the offset past its closing quote
# stored in *endp. 0 when buf[p] is not a quote; 0 with _toml_bad set when the string is
# unterminated on its line, carries an invalid escape, or is a multi-line `"""` / `'''` string.
fn _toml_str_at(buf, n, p, endp): i64 {
    if (p >= n) { return 0; }
    var q = load8(buf + p);
    if (q != 34 && q != 39) { return 0; }
    if (p + 2 < n && load8(buf + p + 1) == q && load8(buf + p + 2) == q) { _toml_bad = 1; return 0; }
    var e = p + 1;
    while (e < n) {
        var c = load8(buf + e);
        if (c == 10) { _toml_bad = 1; return 0; }
        if (c == q) { break; }
        if (q == 34 && c == 92) { e = e + 1; }
        e = e + 1;
    }
    if (e >= n) { _toml_bad = 1; return 0; }
    var out = alloc(e - p + 1);
    var o = 0;
    var i = p + 1;
    while (i < e) {
        var b = load8(buf + i);
        if (q == 34 && b == 92) {
            var x = load8(buf + i + 1);
            i = i + 2;
            if (x == 110) { store8(out + o, 10); o = o + 1; }
            elif (x == 116) { store8(out + o, 9); o = o + 1; }
            elif (x == 114) { store8(out + o, 13); o = o + 1; }
            elif (x == 98) { store8(out + o, 8); o = o + 1; }
            elif (x == 102) { store8(out + o, 12); o = o + 1; }
            elif (x == 34 || x == 92) { store8(out + o, x); o = o + 1; }
            elif (x == 117 || x == 85) {
                var nd = 4;
                if (x == 85) { nd = 8; }
                var cp = 0;
                var k = 0;
                while (k < nd) {
                    if (i + k >= e) { _toml_bad = 1; return 0; }
                    var h = _toml_hex(load8(buf + i + k));
                    if (h < 0) { _toml_bad = 1; return 0; }
                    cp = cp * 16 + h;
                    k = k + 1;
                }
                if (cp > 1114111) { _toml_bad = 1; return 0; }
                i = i + nd;
                o = _toml_put_cp(out, o, cp);
            } else { _toml_bad = 1; return 0; }
        } else {
            store8(out + o, b);
            o = o + 1;
            i = i + 1;
        }
    }
    store8(out + o, 0);
    store64(endp, e + 1);
    return out;
}

# A string, or an array of strings, at buf[p] as a vec of cstrs — `key = "x"` reads as ["x"].
# 0 with _toml_bad set for any other value, or an array holding a non-string.
fn _toml_strs_at(buf, n, p): i64 {
    var out = vec_new();
    var e = 0;
    if (p < n && (load8(buf + p) == 34 || load8(buf + p) == 39)) {
        var s = _toml_str_at(buf, n, p, &e);
        if (s == 0) { _toml_bad = 1; return 0; }
        vec_push(out, s);
        return out;
    }
    if (p >= n || load8(buf + p) != 91) { _toml_bad = 1; return 0; }
    p = p + 1;
    while (p < n) {
        var c = load8(buf + p);
        if (c == 32 || c == 9 || c == 13 || c == 10 || c == 44) { p = p + 1; continue; }
        if (c == 35) {
            while (p < n && load8(buf + p) != 10) { p = p + 1; }
            continue;
        }
        if (c == 93) { return out; }
        if (c != 34 && c != 39) { _toml_bad = 1; return 0; }
        var s2 = _toml_str_at(buf, n, p, &e);
        if (s2 == 0) { _toml_bad = 1; return 0; }
        vec_push(out, s2);
        p = e;
    }
    _toml_bad = 1;
    return 0;
}

# The STRING value of the `key = value` whose key name ends at buf[p] — for the per-key line
# scanners in cbt/deps.cyr (`[deps.X] path / git / tag / target`). 0 with _toml_bad set when the
# value is not a single-line TOML string. Those scanners used to skip to the next `"` in the FILE,
# so `tag = 'v1'` read whatever double-quoted string came next. CHANGELOG [6.6.17].
fn _toml_value_str_after_key(buf, n, p): i64 {
    _toml_bad = 0;
    p = _toml_skip_ws(buf, n, p);
    if (p >= n || load8(buf + p) != 61) {
        _toml_bad = 1;
        return 0;
    }
    p = _toml_skip_ws(buf, n, p + 1);
    var e = 0;
    var s = _toml_str_at(buf, n, p, &e);
    if (s == 0) { _toml_bad = 1; }
    return s;
}

# 1 when the bytes at p end a bare token (space, `#`, `,`, a closing bracket or the line end).
fn _toml_tok_end(buf, n, p): i64 {
    if (p >= n) { return 1; }
    var c = load8(buf + p);
    if (c == 32 || c == 9 || c == 13 || c == 10 || c == 35 || c == 44 || c == 93 || c == 125) { return 1; }
    return 0;
}

# ── the manifest ──────────────────────────────────────────────────────────────────────────
# The CYML header ends at a line that starts `---`; everything after it is prose.
fn _mf_header_len(b, n): i64 {
    var i = 0;
    while (i + 3 < n) {
        if (load8(b + i) == 10 && memeq(b + i + 1, "---", 3) == 1) { return i; }
        i = i + 1;
    }
    return n;
}

# A value that never closes — an array, an inline table or a `"""` / `'''` string with no end —
# runs to the end of the header, and the line walker steps past EVERY later table with it: one
# missing `]` or quote (`keywords = ["a, "b"]`) made [build], [deps] and [embed] read as absent
# without a word — a build that silently dropped its `defines` — while `cyrius deps` (a byte
# scanner) still vendored the [deps] the build could not see. Refused by name: the key and the
# line its value opens on. A single-line string stops at its line end and swallows nothing, so it
# is not this check's. 0, or 1 after naming it. CHANGELOG [6.6.20].
fn _mf_unclosed(): i64 {
    var info[32];
    var hk = 0;
    var hs = 0;
    var hl = 0;
    var p = 0;
    _toml_unclosed = 0;
    while (p < _mf_len) {
        var at = p;
        p = _toml_line(_mf_buf, _mf_len, p, &info);
        var kind = load64(&info);
        if (kind == 1 || kind == 2) {
            hk = kind;
            hs = _mf_buf + load64(&info + 8);
            hl = load64(&info + 16);
        }
        if (_toml_unclosed == 1) {
            if (kind == 3) { at = load64(&info + 24); }
            var ln = 1;
            var i = 0;
            while (i < at) { if (load8(_mf_buf + i) == 10) { ln = ln + 1; } i = i + 1; }
            var sb = str_builder_new();
            str_builder_add_cstr(sb, _mf_path);
            str_builder_add_cstr(sb, ":");
            str_builder_add_int(sb, ln);
            str_builder_add_cstr(sb, ": ");
            if (kind == 3) {
                if (hk == 2) { str_builder_add_cstr(sb, "["); }
                if (hk != 0) {
                    str_builder_add_cstr(sb, "[");
                    str_builder_add(sb, str_new(hs, hl));
                    str_builder_add_cstr(sb, "]");
                }
                if (hk == 2) { str_builder_add_cstr(sb, "]"); }
                if (hk != 0) { str_builder_add_cstr(sb, " "); }
                str_builder_add(sb, str_new(_mf_buf + load64(&info + 8), load64(&info + 16)));
                str_builder_add_cstr(sb, " opens a value that never closes");
            } else {
                str_builder_add_cstr(sb, "a quoted key opens a string that never closes");
            }
            str_builder_add_cstr(sb, " (an array, inline table or \"\"\"/''' string with no end): every line after it would be read as part of it; close it");
            _err(str_data(str_builder_build(sb)));
            return 1;
        }
    }
    return 0;
}

# Load ./cyrius.cyml (legacy: ./cyrius.toml) WHOLE, once per process (nothing in the CLI changes
# directory, and the one in-process manifest write — `cyrius update`'s toml migration — writes the
# same TOML). Returns 1 when loaded, 0 when there is no manifest, -1 when it exists and could not
# be read, is larger than 16 MiB or holds a value that never closes (named once).
fn _mf_load(): i64 {
    if (_mf_state == 1) { return 1; }
    if (_mf_state == 2) { return 0; }
    if (_mf_state == 3) { return 0 - 1; }
    var path = "cyrius.cyml";
    if (file_exists(path) == 0) { path = "cyrius.toml"; }
    if (file_exists(path) == 0) {
        _mf_state = 2;
        return 0;
    }
    _mf_path = path;
    var n = 0;
    var b = file_read_whole_max(path, _MF_MAX, &n);
    if (b == 0) {
        _mf_state = 3;
        if (n == 0 - 27) { _err_ctx("the manifest is larger than 16 MiB; refusing to read it", path); }
        else { _err_ctx("cannot read the manifest", path); }
        return 0 - 1;
    }
    _mf_len = _mf_header_len(b, n);
    store8(b + _mf_len, 0);
    _mf_buf = b;
    if (_mf_unclosed() != 0) {
        _mf_state = 3;
        return 0 - 1;
    }
    _mf_state = 1;
    return 1;
}

# `[section] key` as a fresh cstr, or 0 when absent (or no manifest). A present key whose value is
# not a string also answers 0, with _toml_bad set — the caller decides whether that is an error.
fn _mf_str(section, key): i64 {
    _toml_bad = 0;
    if (_mf_load() != 1) { return 0; }
    var v = _toml_find(_mf_buf, _mf_len, section, key);
    if (v < 0) { return 0; }
    var e = 0;
    var s = _toml_str_at(_mf_buf, _mf_len, v, &e);
    if (s == 0) { _toml_bad = 1; }
    return s;
}

# `[section] key` as 1 / 0; -1 when absent, -2 when present but not `true` / `false`.
fn _mf_bool(section, key): i64 {
    _toml_bad = 0;
    if (_mf_load() != 1) { return 0 - 1; }
    var v = _toml_find(_mf_buf, _mf_len, section, key);
    if (v < 0) { return 0 - 1; }
    if (v + 4 <= _mf_len && memeq(_mf_buf + v, "true", 4) == 1) {
        if (_toml_tok_end(_mf_buf, _mf_len, v + 4) == 1) { return 1; }
    }
    if (v + 5 <= _mf_len && memeq(_mf_buf + v, "false", 5) == 1) {
        if (_toml_tok_end(_mf_buf, _mf_len, v + 5) == 1) { return 0; }
    }
    _toml_bad = 1;
    return 0 - 2;
}

# `[section] key` — a string or an array of strings — as a vec of cstrs; 0 when absent, 0 with
# _toml_bad set when present with another type.
fn _mf_strs(section, key): i64 {
    _toml_bad = 0;
    if (_mf_load() != 1) { return 0; }
    var v = _toml_find(_mf_buf, _mf_len, section, key);
    if (v < 0) { return 0; }
    return _toml_strs_at(_mf_buf, _mf_len, v);
}

fn _mf_has(section, key): i64 {
    if (_mf_load() != 1) { return 0; }
    if (_toml_find(_mf_buf, _mf_len, section, key) < 0) { return 0; }
    return 1;
}

# The key `[section] key` was actually read under — `key` itself or, when that is absent, the
# first synonym the vocabulary declares for it (`[build] src` for `entry`) — or 0 when neither is
# present. The ONE place synonyms resolve.
fn _mf_key_used(section, key): i64 {
    if (_mf_has(section, key) == 1) { return key; }
    var row = _mf_vocab_row(section, key);
    if (row == 0) { return 0; }
    var syn = _mf_vocab_field(row, 3);
    if (streq(syn, "-") == 1) { return 0; }
    if (_mf_has(section, syn) == 1) { return syn; }
    return 0;
}

# `_mf_str` through the synonym rule.
fn _mf_key_str(section, key): i64 {
    var k = _mf_key_used(section, key);
    if (k == 0) {
        _toml_bad = 0;
        return 0;
    }
    return _mf_str(section, k);
}

# ================================================================
# [embed] — a data file's bytes as source (6.6.19, P2)
# ================================================================
# `[embed] NAME = "path"` makes every compile carry the file's bytes as `NAME()` (a pointer to
# them, NUL-terminated) and `NAME_len()` (their count) — cbt/build.cyr `_embed_render` writes
# the module. It is the one manifest key that copies a file VERBATIM INTO A BUILT ARTIFACT, so
# what it may read is narrow, and every refusal names `cyrius.cyml [embed] NAME`:
#   · NAME is an identifier, and not a reserved word: the module is `fn NAME()`, and an error in
#     that prelude is blamed on the ENTRY file (`<source>:N`), so cbt has to catch it first.
#   · the path is relative, with no `..`, no `\`, no `:`, no control byte, no 8.3 short-name
#     component (`~` + digit), no code point HFS+ ignores, and no `.git` component (actions/checkout
#     leaves the job token in .git/config, which passes every other rule); the file has one link; and no SYMLINK anywhere on it — an untrusted checkout must not ship out-of-project
#     bytes inside a release binary, and "inside the project" cannot be read off the path text
#     once a link is involved (dir_walk follows links since 6.5.12; this deliberately does not).
#   · a regular file, opened ONCE and read from that fd here: the bytes the build embeds are the
#     bytes that were checked, and every unit of a `cyrius test` run sees the same. On Linux and
#     x86 macOS the open WALKS the path — openat(dirfd, component, O_DIRECTORY | O_NOFOLLOW) from a
#     handle on the project root, the leaf O_NOFOLLOW — so no component can be swapped for a link
#     between the per-prefix check and the open (_embed_open).
#     ⚠ RESIDUAL, stated: on Windows and on macOS arm64 the open is the whole path with O_NOFOLLOW,
#     which covers the LAST component only, so a directory swapped for a link/junction between the
#     per-prefix check and the open is not caught. PE needs a GetFinalPathNameByHandleW
#     containment check (a new PE reroute); macOS arm64 has no dirfd openat (its stdlib's SYS_OPENAT
#     56 is rerouted to BSD open(5), dropping the dirfd). Both are backlog items; the window needs
#     concurrent write access to the checkout during the build.
#   · it fits cycc's string pool (below), alone and together.
# One path string per entry: the proposal's {dir, glob, prefix} set form is refused by name.
# CHANGELOG [6.6.19].
#
# cycc's string pool `str_data` is 2,097,152 bytes (heap map 0x21A000, src/main.cyr), and LEX
# (src/frontend/lex.cyr) refuses a literal once `spos + 1 >= 2097152` after its NUL: the pool
# holds 2,097,151 bytes, NULs included, so one literal is at most 2,097,150. It is SHARED with
# the program's own literals (the pkgver, the stdlib, the entry), so real embeds stay well under.
var _EMBED_POOL = 2097151;
var _embed_state = 0;      # 0 = not read, 1 = read (_embed_all), 2 = refused (already named)
var _embed_all = 0;        # vec of 32-byte entries { name, path, bytes, len }, in file order
var _embed_coll_later = 0; # 1 while _auto_deps loads [embed] ahead of a [deps] resolve (CBTB-04)

fn _embed_e_name(e): i64 { return load64(e); }
fn _embed_e_path(e): i64 { return load64(e + 8); }
fn _embed_e_bytes(e): i64 { return load64(e + 16); }
fn _embed_e_len(e): i64 { return load64(e + 24); }

# The names a module `fn NAME()` cannot take. DERIVED (tests/gates/toolchain/
# embed_manifest_refusals.sh checks this list against the compiler): every TOKNAME_BUILTIN name
# and every IS_KEYWORD_TOK statement keyword (src/common/util.cyr), plus the identifier-spelled
# intrinsics PARSE_FACTOR lowers inline — `sizeof` / `mulh64` (_is_ident_intrinsic,
# src/frontend/parse.cyr) and `fncall0`..`fncall8` (_IS_FNCALL_NAME) — which sit in neither
# table: `fn sizeof()` declares, and its call is a parse error.
fn _embed_reserved_list(): i64 {
    return " syscall load8 store8 load16 load32 load64 store16 store32 store64 f64_add f64_sub f64_mul f64_div f64_from f64_to f64_eq f64_lt f64_gt f64_neg f64_abs f64_floor f64_ceil f64_sin f64_cos f64_exp f64_ln f64_log2 f64_exp2 f64v_add f64v_sub f64v_mul f64_round f64v_div f64v_sqrt f64v_abs f64v_fmadd ret2 rethi f64_atan union bitget bitset bitclr u128 defer secret f64v_dot f64v_scale f64v_axpy f32_from f32_to async await f32v_add f32v_sub f32v_mul f32v_fmadd f32v_dot iv_add iv_sub iv_mul iv_dp8 f32v8_add f32v8_sub f32v8_mul f32v8_fma f32v8_dot f64v256_add f64v256_sub f64v256_mul f64v256_div f64v256_fmadd f64v256_dot f64v256_scale f64v256_abs f64v256_sqrt f64_le f64_ge f64_trunc private var if while else fn return struct asm elif break continue for switch case default enum mod pub public use match in impl shared object stack f64_sqrt callptr sizeof mulh64 fncall0 fncall1 fncall2 fncall3 fncall4 fncall5 fncall6 fncall7 fncall8 ";
}

fn _embed_reserved(name): i64 {
    var l = _embed_reserved_list();
    var ll = strlen(l);
    var nl = strlen(name);
    var i = 0;
    while (i + nl + 1 < ll) {
        if (load8(l + i) == 32 && load8(l + i + nl + 1) == 32) {
            if (memeq(l + i + 1, name, nl) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# 0 when `name` can be an [embed] NAME, else why not.
fn _embed_name_bad(name): i64 {
    var n = strlen(name);
    var ok = 1;
    if (n == 0 || n > 64) { ok = 0; }
    var i = 0;
    while (i < n) {
        var c = load8(name + i);
        var w = 0;
        if (c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { w = 1; }
        if (i > 0 && c >= 48 && c <= 57) { w = 1; }
        if (w == 0) { ok = 0; }
        i = i + 1;
    }
    if (ok == 0) { return "is not a valid name: it becomes the functions NAME() and NAME_len(), so it must be an identifier ([A-Za-z_][A-Za-z0-9_]*, at most 64 characters)"; }
    if (_embed_reserved(name) == 1) { return "is a reserved word in cyrius (a keyword or a builtin), so fn NAME() cannot be declared; choose another name"; }
    return 0;
}

# 1 when path component buf[s..e) is `.git` as a case-insensitive filesystem or Windows sees
# it: any case, trailing dots / spaces dropped (Win32 strips them), or the 8.3 alias GIT~1.
fn _embed_is_dotgit(buf, s, e): i64 {
    while (e > s && (load8(buf + e - 1) == 46 || load8(buf + e - 1) == 32)) { e = e - 1; }
    var n = e - s;
    var want = ".git";
    if (n == 5) { want = "git~1"; }
    elif (n != 4) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(buf + s + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        if (c != load8(want + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# 1 when the UTF-8 at path[i] is a code point HFS+ ignores in names (git's protectHFS list:
# U+200C-200F, U+202A-202E, U+206A-206F, U+FEFF) — `.g<U+200C>it` IS `.git` on HFS+.
fn _embed_hfs_ignorable(path, i, n): i64 {
    if (i + 2 >= n) { return 0; }
    var a = load8(path + i);
    var b = load8(path + i + 1);
    var c = load8(path + i + 2);
    if (a == 0xE2 && b == 0x80 && ((c >= 0x8C && c <= 0x8F) || (c >= 0xAA && c <= 0xAE))) { return 1; }
    if (a == 0xE2 && b == 0x81 && c >= 0xAA && c <= 0xAF) { return 1; }
    if (a == 0xEF && b == 0xBB && c == 0xBF) { return 1; }
    return 0;
}

# 1 when component buf[s..e) holds `~` followed by a digit — an NTFS 8.3 short name (`GIT~1`,
# `PROGRA~2`) that can alias a different long name, `.git` included.
fn _embed_has_short83(buf, s, e): i64 {
    var i = s;
    while (i + 1 < e) {
        if (load8(buf + i) == 126) {
            var d = load8(buf + i + 1);
            if (d >= 48 && d <= 57) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# 0 when `path` is a relative, in-project, link-free path, else why not.
fn _embed_path_bad(path): i64 {
    var n = strlen(path);
    if (n == 0) { return "the path is empty"; }
    if (load8(path) == 47) { return "the path is absolute; an [embed] path is relative to the project"; }
    var i = 0;
    while (i < n) {
        var c = load8(path + i);
        # A `:` ANYWHERE, not only `X:`: on NTFS `name:stream` opens an alternate data stream, and
        # `.git::$INDEX_ALLOCATION/config` (or `.git:$I30:$INDEX_ALLOCATION/config`) names the
        # .git DIRECTORY itself while its component text is not `.git` (git's CVE-2019-1352 class;
        # read through CreateFile on cass). A drive (`C:x`) is the same byte.
        if (c == 58) { return "the path holds a ':' (a drive, or an NTFS stream like .git::$INDEX_ALLOCATION); an [embed] path is a plain relative path"; }
        if (c == 92) { return "the path holds a backslash; write [embed] paths with / (a \\ is a separator on Windows and would step past these checks)"; }
        if (c < 32 || c == 127) { return "the path holds a control character"; }
        if (_embed_hfs_ignorable(path, i, n) == 1) { return "the path holds a code point HFS+ ignores (U+200C-U+200F, U+202A-U+202E, U+206A-U+206F, U+FEFF: git's protectHFS list), so it can name .git"; }
        i = i + 1;
    }
    var s = 0;
    i = 0;
    while (i <= n) {
        if (i == n || load8(path + i) == 47) {
            if (i - s == 2 && load8(path + s) == 46 && load8(path + s + 1) == 46) {
                return "the path climbs out with ..; an [embed] path stays inside the project";
            }
            if (_embed_has_short83(path, s, i) == 1) {
                return "the path has an 8.3 short-name component (~ and a digit, like GIT~1); on Windows it can alias another name, .git included";
            }
            if (_embed_is_dotgit(path, s, i) == 1) {
                return "the path reaches into .git; an [embed] never reads the repository's own metadata (actions/checkout keeps the job token in .git/config)";
            }
            if (i > s) {
                var pre = alloc(i + 1);
                memcpy(pre, path, i);
                store8(pre + i, 0);
                if (is_symlink(str_from(pre)) == 1) {
                    var sb = str_builder_new();
                    str_builder_add_cstr(sb, "the path passes through a symlink (");
                    str_builder_add_cstr(sb, pre);
                    str_builder_add_cstr(sb, "); [embed] refuses links: an untrusted checkout must not ship bytes from outside the project inside a binary");
                    return str_data(str_builder_build(sb));
                }
            }
            s = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# The file at `path` read through ONE fd: the bytes (NUL-terminated) with their count at *lenp,
# or 0 with the reason at *whyp.
fn _embed_e_dir(): i64 { return "is a directory; an [embed] names one regular file"; }
# Open `path` (already checked by _embed_path_bad) for reading. POSIX targets with a real dirfd
# openat WALK it: a handle on the project root, then openat(dirfd, component, O_DIRECTORY |
# O_NOFOLLOW) per directory and O_NOFOLLOW on the leaf, so a component swapped for a link after
# the per-prefix check fails the open. The fd, or a negative errno.
fn _embed_open(path): i64 {
    var fl = O_RDONLY | O_NOFOLLOW;
    #ifndef CYRIUS_TARGET_WIN
    fl = fl | O_NONBLOCK;   # a FIFO must not hang the build; its lseek in _embed_read refuses it
    var walk = 1;
    #ifdef CYRIUS_TARGET_MACOS
    #ifdef CYRIUS_ARCH_AARCH64
    walk = 0;               # no dirfd openat there (see the header): the whole-path open below
    #endif
    #endif
    if (walk == 1) {
        var dfd = file_open(".", O_RDONLY | O_DIRECTORY, 0);
        if (dfd < 0) { return dfd; }
        var n = strlen(path);
        var comp = alloc(n + 1);
        var s = 0;
        var i = 0;
        while (i <= n) {
            if (i == n || load8(path + i) == 47) {
                if (i > s) {
                    memcpy(comp, path + s, i - s);
                    store8(comp + i - s, 0);
                    if (i == n) {
                        var lf = sys_openat(dfd, comp, fl, 0);
                        file_close(dfd);
                        return lf;
                    }
                    var nd = sys_openat(dfd, comp, O_RDONLY | O_DIRECTORY | O_NOFOLLOW, 0);
                    file_close(dfd);
                    if (nd < 0) { return nd; }
                    dfd = nd;
                }
                s = i + 1;
            }
            i = i + 1;
        }
        file_close(dfd);
        return 0 - 21;      # the path ends in `/`: a directory
    }
    #endif
    return file_open(path, fl, 0);
}

fn _embed_read(path, lenp, whyp): i64 {
    if (is_dir(str_from(path)) == 1) { store64(whyp, _embed_e_dir()); return 0; }
    var fd = _embed_open(path);
    if (fd < 0) {
        if (file_exists(path) == 0) { store64(whyp, "the file does not exist"); }
        else { store64(whyp, "the file cannot be opened through a link-free path (a component is a link, or it changed while it was checked)"); }
        return 0;
    }
    var size = xlseek(fd, 0, 2);
    var probe[8];
    if (size < 0 || xlseek(fd, 0, 0) != 0) {
        file_close(fd);
        store64(whyp, "is not a regular file");
        return 0;
    }
    # A cheap hard-link guard: a file with another name may be one outside the project. fstat on
    # the fd that is read (nlink is u16 on macOS; the low 16 bits elsewhere). No fstat on PE.
    #ifndef CYRIUS_TARGET_WIN
    var st[256];
    if (sys_fstat(fd, &st) == 0) {
        if (load16(&st + STAT_NLINK) > 1) {
            file_close(fd);
            store64(whyp, "has more than one hard link; another name for the file may lie outside the project");
            return 0;
        }
    }
    #endif
    if (size > _EMBED_POOL - 1) {
        var dr = file_read(fd, &probe, 1);
        file_close(fd);
        if (dr < 0) { store64(whyp, _embed_e_dir()); return 0; }
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "is ");
        str_builder_add_int(sb, size);
        str_builder_add_cstr(sb, " bytes; one embed holds at most 2097150 (cycc's 2 MiB string pool, less the literal's NUL, and the pool is shared with the program's own strings)");
        store64(whyp, str_data(str_builder_build(sb)));
        return 0;
    }
    var buf = alloc(size + 1);
    var off = 0;
    var r = 1;
    while (off < size && r > 0) {
        r = file_read(fd, buf + off, size - off);
        if (r > 0) { off = off + r; }
    }
    var more = 0;
    if (r >= 0) { more = file_read(fd, &probe, 1); }
    file_close(fd);
    if (r < 0 || more < 0) {
        if (r == 0 - 21 || more == 0 - 21) { store64(whyp, _embed_e_dir()); }
        else { store64(whyp, "the file cannot be read"); }
        return 0;
    }
    if (off != size || more > 0) { store64(whyp, "the file changed while it was being read"); return 0; }
    store8(buf + size, 0);
    store64(lenp, size);
    return buf;
}

# "cyrius.cyml [embed] NAME = "path": why" (the path part only when there is one).
fn _embed_refuse(disp, path, why): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "cyrius.cyml [embed] ");
    str_builder_add_cstr(sb, disp);
    if (path != 0) {
        str_builder_add_cstr(sb, " = \"");
        str_builder_add_cstr(sb, path);
        str_builder_add_cstr(sb, "\"");
    }
    str_builder_add_cstr(sb, ": ");
    str_builder_add_cstr(sb, why);
    _err(str_data(str_builder_build(sb)));
    return 1;
}

# 1 when `a` is `b` + "_len".
fn _embed_is_len_of(a, b): i64 {
    var bl = strlen(b);
    if (strlen(a) != bl + 4) { return 0; }
    if (memeq(a, b, bl) == 0) { return 0; }
    return memeq(a + bl, "_len", 4);
}

# One `NAME = value` line of [embed] (the value at _mf_buf[vp]): validated, read and pushed onto
# `out`; 0, or 1 after naming what is wrong. `seen` holds every NAME so far, valid or not.
fn _embed_entry(out, seen, name, disp, vp): i64 {
    var why = _embed_name_bad(name);
    if (why != 0) { return _embed_refuse(disp, 0, why); }
    var k = 0;
    while (k < vec_len(seen)) {
        var o = vec_get(seen, k);
        k = k + 1;
        var clash = 0;
        if (streq(o, name) == 1) { why = "is declared twice"; clash = 1; }
        elif (_embed_is_len_of(name, o) == 1 || _embed_is_len_of(o, name) == 1) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "collides with [embed] ");
            str_builder_add_cstr(sb, o);
            str_builder_add_cstr(sb, " (NAME_len() is the length accessor of NAME)");
            why = str_data(str_builder_build(sb));
            clash = 1;
        }
        if (clash == 1) {
            vec_push(seen, name);
            return _embed_refuse(disp, 0, why);
        }
    }
    vec_push(seen, name);
    var c = 0;
    if (vp < _mf_len) { c = load8(_mf_buf + vp); }
    if (c == 123) { return _embed_refuse(disp, 0, "is an inline table; [embed] takes one path string per entry (the {dir, glob, prefix} set form is not supported: list each file)"); }
    if (c == 91) { return _embed_refuse(disp, 0, "is an array; [embed] takes one path string per entry"); }
    if (c != 34 && c != 39) { return _embed_refuse(disp, 0, "must be a path string"); }
    _toml_bad = 0;
    var e = 0;
    var path = _toml_str_at(_mf_buf, _mf_len, vp, &e);
    if (path == 0) { return _embed_refuse(disp, 0, "is not a single-line TOML string (a multi-line string, or an invalid escape: write a literal 'path')"); }
    _toml_bad = 0;
    why = _embed_path_bad(path);
    if (why != 0) { return _embed_refuse(disp, path, why); }
    var len = 0;
    var bytes = _embed_read(path, &len, &why);
    if (bytes == 0) { return _embed_refuse(disp, path, why); }
    var ent = alloc(32);
    store64(ent, name);
    store64(ent + 8, path);
    store64(ent + 16, bytes);
    store64(ent + 24, len);
    vec_push(out, ent);
    return 0;
}

# The [embed] entries — validated, each file read once — as a vec (empty when there is no
# manifest or no [embed]), or -1 after naming every refusal. Read once per process.
fn _embed_load(): i64 {
    if (_embed_state == 1) { return _embed_all; }
    if (_embed_state == 2) { return 0 - 1; }
    var ml = _mf_load();
    if (ml < 0) { return 0 - 1; }
    var out = vec_new();
    var seen = vec_new();
    var bad = 0;
    var info[32];
    var insec = 0;
    var p = 0;
    while (ml == 1 && p < _mf_len) {
        p = _toml_line(_mf_buf, _mf_len, p, &info);
        var kind = load64(&info);
        if (kind == 1 || kind == 2) {
            insec = 0;
            var hs = _mf_buf + load64(&info + 8);
            var hl = load64(&info + 16);
            var is_e = 0;
            if (hl == 5 && memeq(hs, "embed", 5) == 1) { is_e = 1; }
            if (hl > 6 && memeq(hs, "embed.", 6) == 1) { is_e = 2; }
            if (is_e == 1 && kind == 1) { insec = 1; }
            elif (is_e != 0) {
                _err("cyrius.cyml: [embed] is one table of NAME = \"path\" entries; a [embed.X] / [[embed]] section is not read (the {dir, glob, prefix} set form is not supported: list each file)");
                bad = bad + 1;
            }
        } elif (kind == 3 && insec == 1) {
            var ks = load64(&info + 8);
            var kl = load64(&info + 16);
            var name = alloc(kl + 1);
            memcpy(name, _mf_buf + ks, kl);
            store8(name + kl, 0);
            var disp = name;
            if (ks > 0) {
                var q = load8(_mf_buf + ks - 1);
                if (q == 34 || q == 39) {
                    disp = alloc(kl + 3);
                    store8(disp, q);
                    memcpy(disp + 1, name, kl);
                    store8(disp + kl + 1, q);
                    store8(disp + kl + 2, 0);
                }
            }
            bad = bad + _embed_entry(out, seen, name, disp, load64(&info + 24));
        }
    }
    if (bad == 0 && vec_len(out) > 0) {
        var total = 0;
        var i = 0;
        while (i < vec_len(out)) {
            total = total + _embed_e_len(vec_get(out, i)) + 1;
            i = i + 1;
        }
        if (total > _EMBED_POOL) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "cyrius.cyml [embed]: together the embeds need ");
            str_builder_add_int(sb, total);
            str_builder_add_cstr(sb, " bytes of cycc's string pool (each file plus its NUL), more than the 2097151 it holds, before the program's own strings:");
            i = 0;
            while (i < vec_len(out)) {
                var en = vec_get(out, i);
                str_builder_add_cstr(sb, "\n    [embed] ");
                str_builder_add_cstr(sb, _embed_e_name(en));
                str_builder_add_cstr(sb, " = \"");
                str_builder_add_cstr(sb, _embed_e_path(en));
                str_builder_add_cstr(sb, "\": ");
                str_builder_add_int(sb, _embed_e_len(en));
                str_builder_add_cstr(sb, " bytes");
                i = i + 1;
            }
            _err(str_data(str_builder_build(sb)));
            bad = 1;
        }
    }
    # A NAME / NAME_len another declaration in scope owns (the stdlib snapshot, the project's own
    # sources) is refused, never left to "last definition wins" (cbt/commands.cyr). Ahead of a
    # [deps] resolve that check waits for lib/ to be vendored (_embed_collide_vendored).
    if (bad == 0 && vec_len(out) > 0 && _embed_coll_later == 0) { bad = _embed_collisions(out); }
    if (bad > 0) {
        _embed_state = 2;
        return 0 - 1;
    }
    _embed_all = out;
    _embed_state = 1;
    return out;
}

# The collision half of _embed_load for a verb that resolves [deps], run once cmd_deps has vendored
# lib/. Run before it, the check saw lib/ as it stood: on a fresh checkout (or after a dep bump that
# adds the name) a dep module declaring NAME or NAME_len was not there yet, the build exited 0 with
# a `duplicate fn` warning and the dep's definition won; the NEXT build refused. 0, or 1 after naming
# every collision; a refusal is the memoized verdict distlib / publish reuse. CHANGELOG [6.6.20].
fn _embed_collide_vendored(): i64 {
    if (_embed_state != 1 || _embed_all == 0) { return 0; }
    if (vec_len(_embed_all) == 0) { return 0; }
    if (_embed_collisions(_embed_all) == 0) { return 0; }
    _embed_state = 2;
    _embed_all = 0;
    _embeds = 0;
    return 1;
}

# ================================================================
# THE RESOLVED CONFIGURATION — one precedence for every key
# ================================================================
# argument > environment > manifest > default, the same for every key (no per-key exceptions; a
# key with no argument or environment channel simply has no such rung). Resolution writes the
# lowest rung first and lets each higher one overwrite it, so the order IS the code.
# `cyrius build --print-config` prints every value with the rung it came from. CHANGELOG [6.6.17].
var _CFG_DEFAULT = 0;
var _CFG_MANIFEST = 1;
var _CFG_ENV = 2;
var _CFG_ARG = 3;
var _CFG_N = 13;
var _CK_ENTRY = 0;
var _CK_OUTPUT = 1;
var _CK_DCE = 2;
var _CK_STRICT = 3;
var _CK_DEFINES = 4;
var _CK_TEST = 5;
var _CK_MODULES = 6;
var _CK_PROGRAMS = 7;
var _CK_PKG_NAME = 8;
var _CK_PKG_VERSION = 9;
var _CK_PKG_CYRIUS = 10;
var _CK_SECTIONS_BASE = 11;
var _CK_EMBED = 12;        # 6.6.19: the [embed] entries, as "NAME=path" (manifest > default only)
# 1 when the resolved `dce` is on and did NOT come from the environment: compile() then hands cycc
# CYRIUS_DCE=1, replacing any inherited value (an argument beats CYRIUS_DCE=0).
var _cfg_dce_inject = 0;
var _cfg_warned = 0;
var _cfg_v[16];   # the value: a cstr (0 = unset), a bool, or a vec of cstrs (0 = empty)
var _cfg_o[16];   # the origin rung
var _cfg_w[16];   # where on that rung: "[build] src", "CYRIUS_DCE", "--dce", "<source>"

fn _cfg_name(i): i64 {
    if (i == _CK_ENTRY) { return "build.entry"; }
    if (i == _CK_OUTPUT) { return "build.output"; }
    if (i == _CK_DCE) { return "build.dce"; }
    if (i == _CK_STRICT) { return "build.strict"; }
    if (i == _CK_DEFINES) { return "build.defines"; }
    if (i == _CK_TEST) { return "build.test"; }
    if (i == _CK_MODULES) { return "build.modules"; }
    if (i == _CK_PROGRAMS) { return "coverage.programs"; }
    if (i == _CK_PKG_NAME) { return "package.name"; }
    if (i == _CK_PKG_VERSION) { return "package.version"; }
    if (i == _CK_PKG_CYRIUS) { return "package.cyrius"; }
    if (i == _CK_SECTIONS_BASE) { return "sections.base"; }
    return "embed";
}

# 0 = string, 1 = bool, 2 = list
fn _cfg_kind(i): i64 {
    if (i == _CK_DCE || i == _CK_STRICT) { return 1; }
    if (i == _CK_DEFINES || i == _CK_TEST || i == _CK_MODULES || i == _CK_PROGRAMS || i == _CK_EMBED) { return 2; }
    return 0;
}

fn _cfg_put(i, v, o, w): i64 {
    store64(&_cfg_v + i * 8, v);
    store64(&_cfg_o + i * 8, o);
    store64(&_cfg_w + i * 8, w);
    return 0;
}
fn _cfg_val(i): i64 { return load64(&_cfg_v + i * 8); }
fn _cfg_org(i): i64 { return load64(&_cfg_o + i * 8); }

fn _cfg_reset(): i64 {
    var i = 0;
    while (i < _CFG_N) {
        _cfg_put(i, 0, _CFG_DEFAULT, 0);
        i = i + 1;
    }
    return 0;
}

# "[section] key" — where a manifest value came from.
fn _cfg_where(section, key): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    str_builder_add_cstr(sb, section);
    str_builder_add_cstr(sb, "] ");
    str_builder_add_cstr(sb, key);
    return str_data(str_builder_build(sb));
}

fn _cfg_bad(section, key, want): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "cyrius.cyml ");
    str_builder_add_cstr(sb, _cfg_where(section, key));
    str_builder_add_cstr(sb, " must be ");
    str_builder_add_cstr(sb, want);
    _err(str_data(str_builder_build(sb)));
    return 1;
}

# Manifest rungs. Each returns 0, or 1 after naming a value of the wrong type.
fn _cfg_mf_str(i, section, key): i64 {
    var k = _mf_key_used(section, key);
    if (k == 0) { return 0; }
    var v = _mf_str(section, k);
    if (v == 0) { return _cfg_bad(section, k, "a string"); }
    _cfg_put(i, v, _CFG_MANIFEST, _cfg_where(section, k));
    return 0;
}

fn _cfg_mf_bool(i, section, key): i64 {
    var b = _mf_bool(section, key);
    if (b == 0 - 1) { return 0; }
    if (b < 0) { return _cfg_bad(section, key, "true or false"); }
    _cfg_put(i, b, _CFG_MANIFEST, _cfg_where(section, key));
    return 0;
}

fn _cfg_mf_strs(i, section, key): i64 {
    var v = _mf_strs(section, key);
    if (_toml_bad == 1) { return _cfg_bad(section, key, "a string or an array of strings"); }
    if (v == 0) { return 0; }
    _cfg_put(i, v, _CFG_MANIFEST, _cfg_where(section, key));
    return 0;
}

# The environment value of `name`, or 0 when it is unset or empty. POSIX reads the CLI's own envp
# (`_envp` — the one every child inherits, so this is what cycc would see); Windows asks
# GetEnvironmentVariableA.
fn _cfg_env(name): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var wb = alloc(512);
    var wv = _win_getenv_into(name, wb);
    if (wv == 0) { return 0; }
    if (load8(wv) == 0) { return 0; }
    return wv;
    #endif
    #ifndef CYRIUS_TARGET_WIN
    if (_envp == 0) { return 0; }
    var nl = strlen(name);
    var i = 0;
    while (load64(_envp + i * 8) != 0) {
        var e = load64(_envp + i * 8);
        if (memeq(e, name, nl) == 1 && load8(e + nl) == 61) {
            if (load8(e + nl + 1) == 0) { return 0; }
            return e + nl + 1;
        }
        i = i + 1;
    }
    return 0;
    #endif
}

# Environment rungs. A bool variable takes `1` (on) or `0` (an explicit OFF that beats the
# manifest); unset or EMPTY is no rung at all (a CI matrix exporting `CYRIUS_DCE=$dce` with an
# empty $dce); anything else is refused by name rather than silently read as off — cycc itself
# treats every value but "1" as off, so `CYRIUS_DCE=true` was a silent no. Returns 0, or 1 after
# naming the value.
fn _cfg_env_bool(i, name): i64 {
    var e = _cfg_env(name);
    if (e == 0) { return 0; }
    var b = 0 - 1;
    if (streq(e, "1") == 1) { b = 1; }
    if (streq(e, "0") == 1) { b = 0; }
    if (b < 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, name);
        str_builder_add_cstr(sb, " must be 0 or 1 (or unset)");
        _err_ctx(str_data(str_builder_build(sb)), e);
        return 1;
    }
    _cfg_put(i, b, _CFG_ENV, name);
    return 0;
}

fn _cfg_env_csv(i, name): i64 {
    var e = _cfg_env(name);
    if (e == 0) { return 0; }
    var v = _split_csv(e);
    if (vec_len(v) == 0) { return 0; }
    _cfg_put(i, v, _CFG_ENV, name);
    return 0;
}

# A define reaches the compile as one `#define NAME` line, so a name that is empty or carries a
# control byte (a newline would START A NEW SOURCE LINE in the materialized unit) is refused.
fn _cfg_defines_ok(v, where): i64 {
    if (v == 0) { return 0; }
    var i = 0;
    while (i < vec_len(v)) {
        var d = vec_get(v, i);
        var bad = 0;
        if (load8(d) == 0) { bad = 1; }
        var j = 0;
        while (load8(d + j) != 0) {
            if (load8(d + j) < 32 || load8(d + j) == 127) { bad = 1; }
            j = j + 1;
        }
        if (bad == 1) {
            _err_ctx("a define is empty or holds a control character", where);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

# Warn, once, about every key present in `[section]` that nothing reads: a HELD or DROPPED key by
# name with what to do instead, and a key the vocabulary does not declare at all (a typo reads as
# silence otherwise — an inert key cannot be observed to be wrong).
fn _cfg_warn_section(section): i64 {
    if (_mf_state != 1) { return 0; }
    var keys = _toml_section_keys(_mf_buf, _mf_len, section);
    var i = 0;
    while (i < vec_len(keys)) {
        var k = vec_get(keys, i);
        i = i + 1;
        var row = _mf_vocab_row(section, k);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "cyrius.cyml ");
        str_builder_add_cstr(sb, _cfg_where(section, k));
        if (row == 0) {
            str_builder_add_cstr(sb, " is not a known key and nothing reads it (cyrius help manifest lists them)");
        } else {
            var st = _mf_vocab_field(row, 2);
            if (streq(st, "held") == 1) { str_builder_add_cstr(sb, " is HELD and not read: "); }
            elif (streq(st, "dropped") == 1) { str_builder_add_cstr(sb, " is DROPPED and ignored: "); }
            else { continue; }
            str_builder_add_cstr(sb, _mf_vocab_field(row, 6));
        }
        _warn(str_data(str_builder_build(sb)));
    }
    return 0;
}

# The [embed] rung: every entry validated and read (the refusals are named by _embed_load), shown
# as "NAME=path". It has no argument or environment channel.
fn _cfg_mf_embed(): i64 {
    var ev = _embed_load();
    if (ev < 0) { return 1; }
    if (vec_len(ev) == 0) { return 0; }
    var v = vec_new();
    var i = 0;
    while (i < vec_len(ev)) {
        var e = vec_get(ev, i);
        var sb = str_builder_new();
        str_builder_add_cstr(sb, _embed_e_name(e));
        str_builder_add_cstr(sb, "=");
        str_builder_add_cstr(sb, _embed_e_path(e));
        vec_push(v, str_data(str_builder_build(sb)));
        i = i + 1;
    }
    _cfg_put(_CK_EMBED, v, _CFG_MANIFEST, "[embed]");
    return 0;
}

# Resolve the configuration `cyrius build` acts on. `src_arg` / `out_arg` are its operands (0 when
# not given). Returns 0, or 1 after naming what is wrong.
fn _cfg_resolve_build(src_arg, out_arg): i64 {
    _cfg_reset();
    if (_mf_load() < 0) { return 1; }
    if (_cfg_warned == 0) {
        _cfg_warned = 1;
        _cfg_warn_section("build");
    }
    if (_cfg_mf_str(_CK_ENTRY, "build", "entry") != 0) { return 1; }
    if (_cfg_mf_str(_CK_OUTPUT, "build", "output") != 0) { return 1; }
    if (_cfg_mf_bool(_CK_DCE, "build", "dce") != 0) { return 1; }
    if (_cfg_mf_strs(_CK_DEFINES, "build", "defines") != 0) { return 1; }
    if (_cfg_defines_ok(_cfg_val(_CK_DEFINES), "cyrius.cyml [build] defines") != 0) { return 1; }
    if (_cfg_mf_strs(_CK_TEST, "build", "test") != 0) { return 1; }
    if (_cfg_mf_strs(_CK_MODULES, "build", "modules") != 0) { return 1; }
    if (_cfg_mf_strs(_CK_PROGRAMS, "coverage", "programs") != 0) { return 1; }
    if (_cfg_mf_str(_CK_PKG_NAME, "package", "name") != 0) { return 1; }
    if (_cfg_mf_str(_CK_PKG_VERSION, "package", "version") != 0) { return 1; }
    # package.version is printed as the BUILD sees it: `${file:PATH}` expanded, and unset (no
    # CYRIUS_PKG_VERSION at all) when the file it names cannot be read — not the raw template.
    var pv = _cfg_val(_CK_PKG_VERSION);
    if (pv != 0) {
        var pe = _dep_expand_file_interp(pv, strlen(pv));
        store64(&_cfg_v + _CK_PKG_VERSION * 8, pe);
        if (pe == 0) {
            var vsb = str_builder_new();
            str_builder_add_cstr(vsb, "[package] version ");
            str_builder_add_cstr(vsb, pv);
            str_builder_add_cstr(vsb, " does not resolve; the build gets no CYRIUS_PKG_VERSION");
            store64(&_cfg_w + _CK_PKG_VERSION * 8, str_data(str_builder_build(vsb)));
        }
    }
    if (_cfg_mf_str(_CK_PKG_CYRIUS, "package", "cyrius") != 0) { return 1; }
    if (_cfg_mf_str(_CK_SECTIONS_BASE, "sections", "base") != 0) { return 1; }
    if (_cfg_mf_embed() != 0) { return 1; }
    if (_cfg_env_bool(_CK_DCE, "CYRIUS_DCE") != 0) { return 1; }
    _cfg_env_csv(_CK_DEFINES, "CYRIUS_DEFINES");
    if (_cfg_org(_CK_DEFINES) == _CFG_ENV) {
        if (_cfg_defines_ok(_cfg_val(_CK_DEFINES), "CYRIUS_DEFINES") != 0) { return 1; }
    }
    if (src_arg != 0) { _cfg_put(_CK_ENTRY, src_arg, _CFG_ARG, "<source>"); }
    if (_cli_has("--dce") == 1) { _cfg_put(_CK_DCE, 1, _CFG_ARG, "--dce"); }
    if (out_arg != 0) { _cfg_put(_CK_OUTPUT, out_arg, _CFG_ARG, "<output>"); }
    # `strict` is HELD (cycc --strict has had no effect since 6.3.2); the argument is still
    # accepted and passed through, the manifest key is warned and not read, and there is no
    # environment channel — an inert key must not look like a setting.
    if (_cli_has("--strict") == 1) { _cfg_put(_CK_STRICT, 1, _CFG_ARG, "--strict"); }
    var defs = _cli_values("-D");
    if (vec_len(defs) > 0) { _cfg_put(_CK_DEFINES, defs, _CFG_ARG, "-D"); }
    return 0;
}

# `[build] test` for a bare `cyrius test` (its argument rung is the operand list, which takes the
# other path entirely). Returns the declared targets (a vec) or 0, and -1 after naming a value of
# the wrong type.
fn _cfg_resolve_test(): i64 {
    if (_mf_load() < 0) { return 0 - 1; }
    var v = _mf_strs("build", "test");
    if (_toml_bad == 1) {
        _cfg_bad("build", "test", "a path or an array of paths");
        return 0 - 1;
    }
    return v;
}

# 6.6.18 — `[build] defines` for a verb that is not `cyrius build` (P1: defines apply to every
# build; `cyrius fuzz` harnesses never got them — only `-D` reached them). The same precedence
# as `cyrius build`: -D > CYRIUS_DEFINES > [build] defines. Sets `_defines`; 0, or 1 named.
fn _cfg_apply_defines(): i64 {
    _cfg_reset();
    if (_mf_load() < 0) { return 1; }
    if (_cfg_mf_strs(_CK_DEFINES, "build", "defines") != 0) { return 1; }
    if (_cfg_defines_ok(_cfg_val(_CK_DEFINES), "cyrius.cyml [build] defines") != 0) { return 1; }
    _cfg_env_csv(_CK_DEFINES, "CYRIUS_DEFINES");
    if (_cfg_org(_CK_DEFINES) == _CFG_ENV) {
        if (_cfg_defines_ok(_cfg_val(_CK_DEFINES), "CYRIUS_DEFINES") != 0) { return 1; }
    }
    var defs = _cli_values("-D");
    if (vec_len(defs) > 0) { _cfg_put(_CK_DEFINES, defs, _CFG_ARG, "-D"); }
    _defines = 0;
    var d = _cfg_val(_CK_DEFINES);
    if (d != 0) { if (vec_len(d) > 0) { _defines = d; } }
    return 0;
}

# Hand the resolved values to the compile.
fn _cfg_apply_build(): i64 {
    _strict = _cfg_val(_CK_STRICT);
    _cfg_dce_inject = 0;
    if (_cfg_val(_CK_DCE) == 1 && _cfg_org(_CK_DCE) != _CFG_ENV) { _cfg_dce_inject = 1; }
    _defines = 0;
    var d = _cfg_val(_CK_DEFINES);
    if (d != 0) { if (vec_len(d) > 0) { _defines = d; } }
    return 0;
}

fn _cfg_out(s): i64 {
    sys_write(STDOUT_FD, s, strlen(s));
    return 0;
}

fn _cfg_print_value(i): i64 {
    var v = _cfg_val(i);
    var k = _cfg_kind(i);
    if (k == 1) {
        if (v == 1) { return _cfg_out("true"); }
        return _cfg_out("false");
    }
    if (k == 2) {
        _cfg_out("[");
        if (v != 0) {
            var j = 0;
            while (j < vec_len(v)) {
                if (j > 0) { _cfg_out(", "); }
                _cfg_out("\"");
                _cfg_out(vec_get(v, j));
                _cfg_out("\"");
                j = j + 1;
            }
        }
        return _cfg_out("]");
    }
    if (v == 0) { return _cfg_out("(unset)"); }
    _cfg_out("\"");
    _cfg_out(v);
    return _cfg_out("\"");
}

fn _cfg_print_row(i): i64 {
    _cfg_out("  ");
    _cfg_out(_cfg_name(i));
    _cfg_out(" = ");
    _cfg_print_value(i);
    _cfg_out("  (");
    var o = _cfg_org(i);
    if (o == _CFG_DEFAULT) { _cfg_out("default"); }
    if (o == _CFG_MANIFEST) { _cfg_out("manifest"); }
    if (o == _CFG_ENV) { _cfg_out("environment"); }
    if (o == _CFG_ARG) { _cfg_out("argument"); }
    var w = load64(&_cfg_w + i * 8);
    if (w != 0) {
        _cfg_out(": ");
        _cfg_out(w);
    }
    _cfg_out(")");
    if (i == _CK_STRICT) { _cfg_out("  [held: no effect since 6.3.2]"); }
    _cfg_out("\n");
    return 0;
}

# `cyrius build --print-config [<source> [<output>]]` — resolve, print every value with its origin,
# exit 0 WITHOUT building (and without resolving deps: it runs ahead of the dep resolver).
fn _cfg_print_config(src_arg, out_arg): i64 {
    if (_cfg_resolve_build(src_arg, out_arg) != 0) { return 1; }
    _cfg_out("cyrius build configuration (argument > environment > manifest > default)\n");
    _cfg_out("  manifest: ");
    if (_mf_state == 1) { _cfg_out(_mf_path); } else { _cfg_out("(none)"); }
    _cfg_out("\n");
    var i = 0;
    while (i < _CFG_N) {
        _cfg_print_row(i);
        i = i + 1;
    }
    return 0;
}

# Windows: set NAME=VALUE on this process, so the cmd.exe that runs the compiler inherits it
# (there is no envp to hand CreateProcessW here). kernel32!SetEnvironmentVariableA by
# GetProcAddress — no PE reroute exists for it — as `_win_redirect_to_pinned` does. 0 = set.
#ifdef CYRIUS_TARGET_WIN
fn _win_setenv(name, val): i64 {
    var k32 = syscall(0xF013, "kernel32.dll");                    # GetModuleHandleA
    var set_env = 0;
    if (k32 != 0) { set_env = syscall(0xF014, k32, "SetEnvironmentVariableA"); }   # GetProcAddress
    if (set_env == 0) { return 1; }
    if ((callptr(set_env, name, val) & 4294967295) == 0) { return 1; }
    return 0;
}
#endif
