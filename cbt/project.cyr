# ================================================================
# Project commands — native scaffolder dispatch
# ================================================================
#
# v6.2.40: the bash shims (scripts/shims/cyrius-init.sh,
# cyrius-port.sh) are DELETED. `cyrius init` and `cyrius port` are
# now served ENTIRELY by the native scaffolder binary
# programs/cyrius-init.cyr (built as build/cyrius-init →
# ~/.cyrius/bin/cyrius-init). There is no fallback path. Port mode is
# selected by prepending the internal `--__mode=port` sentinel; both
# modes share the same binary + template tree. The full flag tail is
# forwarded verbatim via run_tool_argvtail (run_tool's 3-arg cap used
# to silently drop flags). See programs/cyrius-init.cyr.

# Resolve the scaffolder as a sibling of cycc/the other tools.
# _tools_dir (set by find_tools) is ./build in dev or ~/.cyrius/bin in
# an install — so this resolves correctly from any working directory,
# not just the repo. Fall back to the explicit dev/install paths.
fn _scaffolder_path(): i64 {
    var bin = make_path(_tools_dir, "cyrius-init");
    if (file_exists(bin) == 1) { return bin; }
    bin = "./build/cyrius-init";
    if (file_exists(bin) == 1) { return bin; }
    return make_path(_home, "bin/cyrius-init");
}

# `cyrius init <args...>` — forward argv[start..] to the scaffolder.
fn cmd_init(start): i64 {
    var bin = _scaffolder_path();
    if (file_exists(bin) == 0) {
        _err_ctx("cyrius-init scaffolder not found — run `cyrius pulsar` or reinstall", bin);
        return 1;
    }
    return run_tool_argvtail(bin, start, 0);
}

# `cyrius port <args...>` — same binary, port mode (sentinel prepended).
fn cmd_port(start): i64 {
    var bin = _scaffolder_path();
    if (file_exists(bin) == 0) {
        _err_ctx("cyrius-init scaffolder not found — run `cyrius pulsar` or reinstall", bin);
        return 1;
    }
    return run_tool_argvtail(bin, start, "--__mode=port");
}
