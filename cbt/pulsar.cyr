# pulsar.cyr — rebuild cycc + tools from source, install, purge old versions

# v6.6.4: `_pulsar_release_array` (the [release] bins / cross_bins / scripts reader) is
# gone with the install step it served — `scripts/install.sh --refresh-only` reads the
# same table (`_parse_release_array`) and is the ONE writer of a version slot now.

# v6.6.4: a RAW compile — `cc < src > out` via fork/execve, no `#@incdir`/`#@pkgver`
# prepend, no wrapper — the recipe the tag build, install.sh and the release gate use. The
# output is written to a sibling temp and renamed in (never in place: `build/cycc_aarch64`
# may be the compiler a sibling gate is executing). Returns the child's exit status.
fn _pulsar_raw_compile(cc, src, out): i64 {
    var tmp_sb = str_builder_new();
    str_builder_add_cstr(tmp_sb, out);
    str_builder_add_cstr(tmp_sb, ".pulsar.new");
    var tmp = str_data(str_builder_build(tmp_sb));
    var pid = sys_fork();
    if (pid == 0) {
        var sfd = sys_open(src, O_RDONLY, 0);
        if (sfd < 0) { sys_exit(126); }
        sys_dup2(sfd, 0); sys_close(sfd);
        var ofd = sys_open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
        if (ofd < 0) { sys_exit(126); }
        sys_dup2(ofd, 1); sys_close(ofd);
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv, cc);
        store64(&argv + 8, 0);
        sys_execve(cc, &argv, _envp);
        sys_exit(127);
    }
    var sb[1];
    sys_waitpid(pid, &sb, 0);
    var st = load32(&sb);
    var rc = 1;
    if (WIFEXITED(st) == 1) { rc = WEXITSTATUS(st); }
    if (rc != 0) { sys_unlink(tmp); return rc; }
    if (_file_size(tmp) <= 0) { sys_unlink(tmp); return 1; }
    sys_chmod(tmp, 0x1ED);
    if (file_rename(tmp, out) != 0) { sys_unlink(tmp); return 1; }
    return 0;
}

# v6.6.4: replace a tracked binary by temp + RENAME (never `cp` in place — ETXTBSY if any
# process is executing it, and a half-written file if the copy dies). Same-filesystem
# only: the temp is created beside the destination.
fn _pulsar_install_bin(src, dst): i64 {
    var tmp_sb = str_builder_new();
    str_builder_add_cstr(tmp_sb, dst);
    str_builder_add_cstr(tmp_sb, ".pulsar.new");
    var tmp = str_data(str_builder_build(tmp_sb));
    if (_dep_copy_file(src, tmp) == 1) { _err("could not stage the rebuilt binary"); return 1; }
    sys_chmod(tmp, 0x1ED);
    if (file_rename(tmp, dst) != 0) { sys_unlink(tmp); _err("could not replace the tracked binary"); return 1; }
    return 0;
}

fn cmd_pulsar(): i64 {
    _status("pulsar: rebuilding from source...");
    if (file_exists("src/main.cyr") == 0) {
        _err("not in a cyrius repo (no src/main.cyr)");
        return 1;
    }
    var ver = read_file_str("VERSION");
    if (ver == 0) { ver = "unknown"; }

    # Step 1: rebuild cycc — RAW builds (`cc < src/main.cyr`), exactly the tag / install.sh /
    # release-gate recipe. v6.6.4: stage 1 used to go through cbt `compile()`, which PREPENDS
    # `#@incdir src` + `#@pkgver <v>` to the source, so stage 1 and the raw stage 2 were never
    # built from the same input; the old SIZE-only compare then accepted them as equal and
    # installed stage 1 — a compiler that differed from the fixpoint in 38,927 bytes at the
    # same length (measured at 6.6.3) — over the tracked build/cycc. Byte-exact now, and both
    # stages are raw, so stage 1 == stage 2 IS the fixpoint proof.
    _status("  cycc...");
    var cc5_a = _cbt_tmpfile("pulsar_a");
    var cc5_b = _cbt_tmpfile("pulsar_b");
    if (_pulsar_raw_compile("build/cycc", "src/main.cyr", cc5_a) != 0) {
        _err("cycc compile failed");
        return 1;
    }
    if (_pulsar_raw_compile(cc5_a, "src/main.cyr", cc5_b) != 0) {
        _err("cycc stage-2 compile failed");
        sys_unlink(cc5_a);
        return 1;
    }
    var sz_a = _file_size(cc5_a);
    var sz_b = _file_size(cc5_b);
    var ab_same = 0;
    if (sz_a == sz_b) { if (sz_a > 0) { ab_same = _files_identical(cc5_a, cc5_b); } }
    if (ab_same == 0) {
        # Try three-step (a heap/brk LAYOUT change needs the two-step bootstrap: b != a but c == b)
        var cc5_c = _cbt_tmpfile("pulsar_c");
        if (_pulsar_raw_compile(cc5_b, "src/main.cyr", cc5_c) != 0) {
            _err("cycc stage-3 compile failed");
            sys_unlink(cc5_a); sys_unlink(cc5_b);
            return 1;
        }
        var sz_c = _file_size(cc5_c);
        var bc_same = 0;
        if (sz_b == sz_c) { if (sz_b > 0) { bc_same = _files_identical(cc5_b, cc5_c); } }
        if (bc_same == 0) {
            _err("self-hosting diverges after 3 steps");
            sys_unlink(cc5_a); sys_unlink(cc5_b); sys_unlink(cc5_c);
            return 1;
        }
        # cc5_b == cc5_c, use cc5_c (the fixpoint)
        if (_pulsar_install_bin(cc5_c, "build/cycc") != 0) { return 1; }
        sys_unlink(cc5_c);
    } else {
        # cc5_a == cc5_b: stage 2 is the fixpoint (and byte-identical to stage 1)
        if (_pulsar_install_bin(cc5_b, "build/cycc") != 0) { return 1; }
    }
    sys_unlink(cc5_a); sys_unlink(cc5_b);

    sys_write(STDOUT_FD, "  cycc: ", 8);
    fmt_int(_file_size("build/cycc"));
    println(" bytes (self-host OK)");

    # Step 2: rebuild aarch64 compilers — raw, like install.sh (`cat src/main_aarch64.cyr |
    # ./build/cycc`), so pulsar's cross-bins are byte-identical to the release recipe's.
    if (file_exists("src/main_aarch64.cyr") == 1) {
        _status("  cycc_aarch64 (cross)...");
        if (_pulsar_raw_compile("build/cycc", "src/main_aarch64.cyr", "build/cycc_aarch64") != 0) { _err("cycc_aarch64 compile failed"); return 1; }
        sys_write(STDOUT_FD, "  cycc_aarch64: ", 16);
        fmt_int(_file_size("build/cycc_aarch64"));
        println(" bytes");
    }
    # v6.0.7: Native aarch64 self-host binary (runs on aarch64 hardware,
    # not the x86 host). Built via the cross-compiler we just produced:
    # x86 cycc emits build/cycc_aarch64 (x86-host, aarch64-target), then
    # build/cycc_aarch64 emits build/cycc-native-aarch64 (aarch64-host).
    # v6.6.4: a RAW pipe through build/cycc_aarch64 (no `#@pkgver` prepend),
    # the recipe the pi release-gate leg and the tag build use. The binary
    # is tracked (per .gitignore whitelist) so ARM consumers don't need a
    # cross-build toolchain to bootstrap.
    if (file_exists("src/main_aarch64_native.cyr") == 1) {
        if (file_exists("build/cycc_aarch64") == 1) {
            _status("  cycc-native-aarch64 (via cross)...");
            if (_pulsar_raw_compile("build/cycc_aarch64", "src/main_aarch64_native.cyr", "build/cycc-native-aarch64") != 0) { _err("cycc-native-aarch64 compile failed"); return 1; }
            sys_write(STDOUT_FD, "  cycc-native-aarch64: ", 23);
            fmt_int(_file_size("build/cycc-native-aarch64"));
            println(" bytes");
        }
    }

    # Step 3: rebuild tools
    _status("  tools...");
    var tools[6];
    store64(&tools, "cyrfmt");
    store64(&tools + 8, "cyrlint");
    store64(&tools + 16, "cyrdoc");
    store64(&tools + 24, "cybs");
    store64(&tools + 32, "ark");
    store64(&tools + 40, 0);
    var ti = 0;
    while (load64(&tools + ti * 8) != 0) {
        var tool = load64(&tools + ti * 8);
        var src_sb = str_builder_new();
        str_builder_add_cstr(src_sb, "programs/");
        str_builder_add_cstr(src_sb, tool);
        str_builder_add_cstr(src_sb, ".cyr");
        var src_path = str_data(str_builder_build(src_sb));
        if (file_exists(src_path) == 1) {
            var dst_sb = str_builder_new();
            str_builder_add_cstr(dst_sb, "build/");
            str_builder_add_cstr(dst_sb, tool);
            compile(src_path, str_data(str_builder_build(dst_sb)));
        }
        ti = ti + 1;
    }
    # Build cyrius tool from cbt/
    if (file_exists("cbt/cyrius.cyr") == 1) {
        compile("cbt/cyrius.cyr", "build/cyrius");
    }

    # Step 4: install — v6.6.4: through `scripts/install.sh --refresh-only`, ONE writer.
    # This fn used to carry its own copy of the install (top-level lib/*.cyr only — no
    # lib/unicode/, so a pulsar-populated slot had 103 files where install.sh writes 110;
    # in-place `_dep_copy_file` over binaries a process may be executing — the ETXTBSY
    # shape v6.6.1 fixed in install.sh; and no notion of a RELEASED slot, so a mid-slot
    # `cyrius pulsar` wrote the drifted tree into `versions/<released>`). install.sh has the
    # recursive copy, the atomic replace, the released-slot guard and the SOURCE_COMMIT
    # stamp; CYRIUS_HOME / CYRIUS_REFRESH_RELEASED pass through the environment.
    sys_write(STDOUT_FD, "  install ", 10);
    sys_write(STDOUT_FD, ver, strlen(ver));
    println("...");
    if (file_exists("scripts/install.sh") == 0) {
        _err("scripts/install.sh missing — cannot install (pulsar no longer carries its own copy of the install step)");
        return 1;
    }
    var ir = sys_system("sh scripts/install.sh --refresh-only");
    if (ir != 0) {
        _err("install refused or failed (see above) — build/ was rebuilt, the store was NOT touched");
        return 1;
    }

    # Verify
    sys_write(STDOUT_FD, "pulsar: ", 8);
    sys_write(STDOUT_FD, ver, strlen(ver));
    println(" installed.");
    return 0;
}
