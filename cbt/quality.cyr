# ================================================================
# Native coverage — REFERENCE coverage: for each public `fn` in the scanned
# source tree, is its name referenced anywhere in the tests/tcyr corpus? This is
# a floor against UNWATCHED code, not a line/branch-coverage or correctness proof
# (a mirror-style suite that re-implements rather than calls still "references"
# the symbol — that is intentional: reference coverage is meaningful for both
# linked and mirror suites, which is why it does not need the linked-vs-mirror
# line-coverage distinction).
#
# v6.4.72 (issue 2026-07-23-hoosh-coverage-reports-stdlib-not-local-repo):
#   cyrius coverage           -> the PROJECT's OWN sources (src/, recursive) — the
#                                new default. Was `lib/` (the VENDORED stdlib), so
#                                a downstream project got a number about the stdlib,
#                                not itself ("Functions: 0/1097", permanently ~0).
#   cyrius coverage --full    -> the vendored stdlib in lib/ (today's behaviour;
#                                legitimate when working ON cyrius itself).
#   cyrius coverage --min N   -> exit non-zero if coverage% < N (a CI gate).
# The mode is stated in the summary so a stdlib figure can't be mistaken for a
# project figure. `--min` and `--full` compose.
# v6.6.5 — the flags arrive already parsed (cbt/cli_args.cyr). This used to run its
# own `ai = 2` loop, so `cyrius -q coverage` took the VERB NAME as the directory
# ("not a directory: coverage"), and `--min abc` went through `atoi` to 0 and printed
# "gate OK: 0% >= --min 0%" with exit 0 — a CI gate that passes on a typo. `min_pct`
# is -1 when no gate was asked for; the caller has already validated the integer.
# v6.5.8: a SUBFOLDER CALLOUT — `cyrius coverage src/sub` scans that directory (it
# used to be dropped on the floor and the scan ran against ./ anyway).
# 6.6.8: what counts, on both sides. The DENOMINATOR is the public surface as the
# compiler defines it — every declaration spelling (indented, attributed, `pub`/`public`,
# `fn` + any whitespace) and the file-scope `private` rule — read from whole files under
# the whole root. The NUMERATOR is a whole-identifier reference in the CODE of a test
# (comments, strings and char literals blanked). Unreferenced names are listed under -v
# and whenever --min fails. Residual, inherent to NAME-based coverage: a test local or
# parameter that shares a fn's name still counts. CHANGELOG [6.6.8]
# 6.6.17 (P5-A): RUN PROGRAMS join the corpus — `programs` is a vec of globs (`--programs`, else
# `[coverage] programs`), each matched file read whole, blanked and counted exactly as a .tcyr is.
# This is TEXT coverage (the same reference count .tcyr corpora get), NOT execution coverage —
# that is P5-B, v6.7.x. A corpus program is a test, so it leaves the measured surface (the '.'
# fallback would otherwise count it and let it reference itself). `per_entry` adds the view of
# which corpus entry references which public fn. rekha, sadish, dhancha, setu and mishran test
# with programs/*_test.cyr and read ~0%. CHANGELOG [6.6.17]
fn cmd_coverage(full, min_pct, root_arg, programs, per_entry): i64 {

    # Scan root: an explicit callout wins, then lib/ for --full, else the project's own
    # src/ (recursive).
    var root = "src";
    if (full == 1) { root = "lib"; }
    if (root_arg != 0) {
        root = root_arg;
        if (is_dir(str_from(root)) != 1) {
            _err_ctx("not a directory", root);
            return 1;
        }
    }
    elif (is_dir(str_from(root)) != 1) {
        # No src/ (e.g. a flat project) — fall back to '.', still excluding lib/.
        root = ".";
    }

    _status("=== Coverage Report ===");
    if (full == 1) {
        println("  mode: --full (vendored stdlib in lib/); reference coverage");
    } else {
        sys_write(STDOUT_FD, "  mode: local repo sources (", 28);
        sys_write(STDOUT_FD, root, strlen(root));
        # 6.6.8: only the '.' fallback excludes anything, and only its top-level lib/ +
        # dist/ — this line claimed the exclusion for every root. CHANGELOG [6.6.8]
        if (streq(root, ".") == 1) { println("/, recursive; top-level lib/ + dist/ excluded); reference coverage"); }
        else { println("/, recursive); reference coverage"); }
    }
    # 6.6.17 (P5-A): expand the RUN-program globs first, so a glob that matches nothing fails
    # before anything is reported (measuring a corpus that is not there is not a pass).
    var prog_files = 0;
    if (programs != 0) {
        if (vec_len(programs) > 0) {
            prog_files = _cov_expand_programs(programs);
            if (prog_files == 0) { return 1; }
            sys_write(STDOUT_FD, "  corpus: tests/**/*.tcyr + ", 28);
            fmt_int(vec_len(prog_files));
            println(" RUN program(s), as text (references, not execution)");
        }
    }
    println("");
    var ent_path = vec_new();                 # corpus entries, for --per-entry
    var ent_off = vec_new();
    var ent_len = vec_new();

    # Collect all tests/tcyr content into one searchable corpus, via dir_walk +
    # an inline str_ends_with suffix test. (Written to sidestep find_files, which
    # appeared to "mis-drop every entry" — root-caused v6.4.72 to find_files' then-
    # untyped `ext` param NOT firing the compiler's literal->Str auto-coercion, so a
    # bare `".cyr"` arrived as a raw cstr pointer and str_ends_with read its length
    # from load64(ptr+8) = garbage. NOT an allocator / "heap regime" issue; fixed in
    # lib/fs.cyr by annotating `ext: Str`. The inline walk stays as the equivalent,
    # simplest form.)
    # ⛔ v6.5.8: GROW-AND-RETRY. This was a FIXED 1 MiB buffer, and the corpus silently
    # stopped growing once it filled: `file_read_all` returns exactly `maxlen` on
    # truncation and 0 once `avail` reaches 0, so `if (n > 0)` made truncation, a
    # whole-file drop and a failed open indistinguishable — and all three silent. Every
    # symbol whose only reference lived in the discarded tail then read as unreferenced,
    # so the reported percentage fell with no diagnostic and `--min` still exited 0.
    #
    # The failure is ANTI-CORRELATED with the signal, which is what makes it worse than a
    # plain cap: coverage degrades as the test suite GROWS, so it punishes the projects
    # testing most and reads as "someone deleted a test". It was mis-measuring THIS repo.
    #
    # Grow-and-retry rather than the filing's "sum file sizes first": there is no portable
    # file-size primitive in lib/ — the only candidate, `xlseek`, is a bare SYS_LSEEK that
    # is wrong on PE, and cbt/cyrius.cyr cross-compiles to PE and Mach-O. Doubling needs no
    # size call at all and uses only alloc + memcpy, both already available here.
    var corpus_cap = 1048576;
    var corpus = alloc(corpus_cap);
    if (corpus == 0) {
        _err("coverage: out of memory for the test corpus");
        return 1;
    }
    var corpus_len = 0;
    if (is_dir(str_from("tests")) == 1) {
        var tests = vec_new();
        # ⛔ 6.6.10: CHECKED. dir_walk dropped an unreadable tests/ subdirectory in silence, so
        # the fns only its tests reference read as unreferenced — or, for the SOURCE side
        # below, a whole unreadable src/ subtree left the denominator and the percentage ROSE
        # (50 % -> 100 %, passing --min 60). Every directory not listed is named and fails
        # the run. CHANGELOG [6.6.10]
        var tfail = vec_new();
        dir_walk_checked(str_from("tests"), tests, tfail);   # recursive: tests/tcyr/*.tcyr AND tests/*.tcyr
        if (_cov_unlisted(tfail, "its tests were NOT read") != 0) { return 1; }
        var ti = 0;
        while (ti < vec_len(tests)) {
            var tf = vec_get(tests, ti);
            if (str_ends_with(tf, ".tcyr") == 1) {
                var avail = corpus_cap - corpus_len - 1;
                var n = file_read_all(str_data(tf), corpus + corpus_len, avail);
                if (n >= avail) {
                    # Filled to the brim — the read may have been truncated, and we cannot
                    # tell from the return value alone. Grow and retry the SAME file
                    # rather than accept a possibly-partial read.
                    if (corpus_cap >= 268435456) {
                        _err_ctx("coverage corpus exceeded 256 MiB while reading", str_data(tf));
                        return 1;
                    }
                    var nb = alloc(corpus_cap * 2);
                    if (nb == 0) {
                        _err("coverage: out of memory growing the test corpus");
                        return 1;
                    }
                    memcpy(nb, corpus, corpus_len);
                    corpus = nb;
                    corpus_cap = corpus_cap * 2;
                    # Do NOT advance ti — re-read this file into the larger buffer.
                } elif (n < 0) {
                    # ⛔ 6.6.10: an unreadable test is an ERROR, by name. `if (n > 0)` below
                    # folded it into "empty", so the fns only it referenced read as misses and
                    # the percentage dropped with no diagnostic (50 % -> 25 %). CHANGELOG [6.6.10]
                    _err_ctx("coverage: cannot read test", str_data(tf));
                    return 1;
                } else {
                    # Only now is the read known COMPLETE, so only now is it blanked: its
                    # comments, strings and char literals become spaces in place (same
                    # length), and a name there no longer reads as a reference. Per file,
                    # so an unclosed string cannot run on into the next file. CHANGELOG [6.6.8]
                    if (n > 0) {
                        _src_blank_noncode(corpus + corpus_len, n);
                        vec_push(ent_path, str_data(tf));
                        vec_push(ent_off, corpus_len);
                        vec_push(ent_len, n);
                        corpus_len = corpus_len + n;
                    }
                    ti = ti + 1;
                }
            } else {
                ti = ti + 1;
            }
        }
    }
    # 6.6.17 (P5-A): each RUN program, whole, blanked like a test.
    var pfi = 0;
    while (prog_files != 0 && pfi < vec_len(prog_files)) {
        var pf = vec_get(prog_files, pfi);
        pfi = pfi + 1;
        var pn = 0;
        var pb = file_read_whole(pf, &pn);
        if (pb == 0) {
            _err_ctx("coverage: cannot read program", pf);
            return 1;
        }
        while (corpus_len + pn + 1 > corpus_cap) {
            if (corpus_cap >= 268435456) {
                _err_ctx("coverage corpus exceeded 256 MiB while reading", pf);
                return 1;
            }
            var gb = alloc(corpus_cap * 2);
            if (gb == 0) {
                _err("coverage: out of memory growing the test corpus");
                return 1;
            }
            memcpy(gb, corpus, corpus_len);
            corpus = gb;
            corpus_cap = corpus_cap * 2;
        }
        memcpy(corpus + corpus_len, pb, pn);
        _src_blank_noncode(corpus + corpus_len, pn);
        vec_push(ent_path, pf);
        vec_push(ent_off, corpus_len);
        vec_push(ent_len, pn);
        corpus_len = corpus_len + pn;
    }
    store8(corpus + corpus_len, 0);
    # 6.6.10: ONE pass over the corpus. Every identifier goes into a set once, and each public
    # fn below is one lookup — it was one memeq scan of the whole corpus PER FN (78 s on this
    # repo's --full). The same whole-identifier rule; see cbt/srcscan.cyr `_src_ids_*`.
    var refs = _src_ids_new(corpus_len);
    if (refs == 0 || _src_ids_add_text(refs, corpus, corpus_len) != 0) {
        _err("coverage: out of memory indexing the test corpus");
        return 1;
    }

    # The sources to measure. ⛔ 6.6.8: the vendored-tree prune is applied at the TOP LEVEL
    # of the '.' fallback only. It used to be a by-NAME prune at every depth, so a project
    # keeping its code under src/lib/ (nein, hoosh, kriya, kybernet) had that whole tree
    # silently dropped — nein read `main.cyr 1/1 (100%)` and passed `--min 80` while 259 of
    # its 393 fns were never measured. The comment here claimed the prune was "inert for the
    # src/ root". CHANGELOG [6.6.8]
    var srcs = _cov_sources(root);
    if (srcs == 0) { return 1; }             # 6.6.10: a directory could not be listed (named)
    if (prog_files != 0) { srcs = _cov_drop_corpus(srcs, prog_files); }
    var all_path = vec_new();                 # every public fn, for --per-entry
    var all_name = vec_new();

    var total_files = 0;
    var covered_files = 0;
    var total_fns = 0;
    var covered_fns = 0;
    var miss_path = vec_new();                # unreferenced public fns, for the report
    var miss_name = vec_new();
    # ⛔ 6.6.8: WHOLE-FILE READS. Each source went into a fixed 256 KiB buffer with no
    # truncation check, so every fn past the cut was never counted — bayan's pdf.cyr
    # (399,907 B) showed 114 of its 152 fns. `file_read_whole_into` grows the buffer (it
    # needs no file-size call, which is wrong on PE) and REUSES it across files; a read
    # error is an error by name, not a skipped file. CHANGELOG [6.6.8]
    var rb[16];
    store64(&rb, 0);
    store64(&rb + 8, 0);
    var li = 0;
    while (li < vec_len(srcs)) {
        var spath = str_data(vec_get(srcs, li));
        li = li + 1;
        var ln = file_read_whole_into(&rb, spath, ALLOC_MAX - 1);
        if (ln < 0) {
            _err_ctx("coverage: cannot read source", spath);
            return 1;
        }
        if (ln == 0) { continue; }
        var lbuf = load64(&rb);
        # Declarations are read from CODE only: a fn in a comment or a multi-line string is
        # not a fn. And a `private` file exports only its `pub` / `public` fns — counting its
        # bare fns measured exactly the wrong set (hisab's whole 643-fn `public fn` API was
        # invisible and the tool reported 1/1 = 100%). CHANGELOG [6.6.8]
        _src_blank_noncode(lbuf, ln);
        var fpriv = _src_file_private(lbuf, ln);

        var pub_fns = 0;
        var called = 0;
        var pos = 0;
        var depth = 0;                        # brace depth: only depth-0 fns are top-level
        while (pos < ln) {
            var le = pos;
            while (le < ln) { if (load8(lbuf + le) == 10) { break; } le = le + 1; }
            var ns = 0 - 1;
            if (depth == 0) { ns = _src_public_fn_at(lbuf, pos, le, fpriv); }
            depth = depth + _src_brace_delta(lbuf, pos, le);
            if (depth < 0) { depth = 0; }
            var fname_len = 0;
            if (ns >= 0) { fname_len = _src_ident_end(lbuf, ns, le) - ns; }
            # ⛔ 6.6.11: a depth-0 `main` is the ENTRY POINT (_src_is_entry_fn) — no test can name
            # it, so counting it held ganita at 139/141 and bayan at 501/503 with nothing else
            # missing. An `if`, NOT a `continue`: `pos = le + 1` below is the loop's only advance.
            if (ns >= 0 && _src_is_entry_fn(lbuf, ns, fname_len) == 1) { ns = 0 - 1; }
            if (ns >= 0) {
                pub_fns = pub_fns + 1;
                total_fns = total_fns + 1;
                if (per_entry == 1) {
                    vec_push(all_path, spath);
                    vec_push(all_name, str_from_buf(lbuf + ns, fname_len));
                }
                # ⛔ 6.6.8: a WHOLE-IDENTIFIER match over a corpus whose comments, strings and
                # char literals are blanked. A raw substring match counted `check_due` as
                # referenced by every `check_due_at(` and `str_lt` by a comment naming it, so
                # samay's `--min 100` passed with functions no test referenced. (6.6.10: a
                # token ending at the corpus's last byte is a token — axis 2's v6.5.8 case.)
                if (_src_ids_has(refs, lbuf + ns, fname_len) == 1) {
                    called = called + 1;
                    covered_fns = covered_fns + 1;
                } else {
                    vec_push(miss_path, spath);
                    vec_push(miss_name, str_from_buf(lbuf + ns, fname_len));
                }
            }
            pos = le + 1;
        }

        if (pub_fns == 0) { continue; }        # no public surface — omit from the per-file list
        total_files = total_files + 1;
        if (called > 0) { covered_files = covered_files + 1; }

        # Per-file line — pad the name column to a fixed width, guarding long names
        # (the old `22 - llen` went negative for e.g. `syscalls_linux_common.cyr`,
        # so the count ran into the name).
        var disp = str_data(path_basename(str_from(spath)));
        var dlen = strlen(disp);
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, disp, dlen);
        var pad = 34 - dlen;
        if (pad < 1) { pad = 1; }
        while (pad > 0) { sys_write(STDOUT_FD, " ", 1); pad = pad - 1; }
        fmt_int(called);
        sys_write(STDOUT_FD, "/", 1);
        fmt_int(pub_fns);
        sys_write(STDOUT_FD, " fns\n", 5);
    }

    var pct = 0;
    if (total_fns > 0) { pct = (covered_fns * 100) / total_fns; }
    println("");
    println("-- Summary --");
    if (full == 1) { sys_write(STDOUT_FD, "  Modules referenced: ", 22); }
    else           { sys_write(STDOUT_FD, "  Files referenced:   ", 22); }
    fmt_int(covered_files);
    sys_write(STDOUT_FD, "/", 1);
    fmt_int(total_files);
    println("");
    sys_write(STDOUT_FD, "  Functions referenced: ", 24);
    fmt_int(covered_fns);
    sys_write(STDOUT_FD, "/", 1);
    fmt_int(total_fns);
    sys_write(STDOUT_FD, " (", 2);
    fmt_int(pct);
    println("%)  [reference coverage — a floor, not a correctness proof]");

    # ⛔ v6.5.8: MEASURING NOTHING IS NOT PASSING. This printed a `note:` and returned 0,
    # so `cyrius coverage --min 80` in a directory with no sources — a mistyped path, a CI
    # job with the wrong working directory — reported a percentage computed from an empty
    # set and exited GREEN. Same green-placebo shape as `capacity` at v6.4.73. An empty
    # measurement is a failed measurement, with or without --min.
    if (total_fns == 0) {
        _err_ctx("no public functions found — nothing was measured, so this is not a pass; check the path", root);
        return 1;
    }
    var gate_fail = 0;
    if (min_pct >= 0) { if (pct < min_pct) { gate_fail = 1; } }
    # Name the misses under -v and whenever the gate fails: a failed gate with only a
    # percentage tells a project nothing about WHAT to cover. CHANGELOG [6.6.8]
    if (_verbose == 1 || gate_fail == 1) { _cov_print_misses(miss_path, miss_name); }
    if (per_entry == 1) {
        if (_cov_print_per_entry(corpus, ent_path, ent_off, ent_len, all_path, all_name) != 0) { return 1; }
    }
    if (min_pct >= 0) {
        if (gate_fail == 1) {
            sys_write(STDERR_FD, "coverage gate FAILED: ", 22);
            fmt_int_fd(2, pct); sys_write(STDERR_FD, "% < --min ", 10); fmt_int_fd(2, min_pct);
            sys_write(STDERR_FD, "%\n", 2);
            return 1;
        }
        sys_write(STDOUT_FD, "  gate OK: ", 11);
        fmt_int(pct); sys_write(STDOUT_FD, "% >= --min ", 11); fmt_int(min_pct); println("%");
    }
    return 0;
}

# The `.cyr` files cmd_coverage measures under `root`. A named root (src/, lib/, a callout)
# is walked WHOLE. Only the '.' fallback (a flat project with no src/) skips the vendored
# stdlib and generated bundles — and only its own TOP-LEVEL ./lib and ./dist; a lib/ deeper
# down is the project's code. CHANGELOG [6.6.8]
# 6.6.10: 0 (after naming it) when any directory under the root could not be listed — an
# unreadable subtree left the DENOMINATOR, which raised the percentage. CHANGELOG [6.6.10]
fn _cov_sources(root): i64 {
    var walked = vec_new();
    var failed = vec_new();
    if (streq(root, ".") == 1) {
        var ents = _cbt_list_dir(".", "coverage cannot measure it");
        if (ents == 0) { return 0; }
        var ei = 0;
        while (ei < vec_len(ents)) {
            var en = vec_get(ents, ei);
            ei = ei + 1;
            if (str_eq_cstr(en, "lib") == 1 || str_eq_cstr(en, "dist") == 1) { continue; }
            var full = path_join(str_from("."), en);
            if (is_dir(full) == 1 && is_symlink(full) == 0) { dir_walk_checked(full, walked, failed); }
            else { vec_push(walked, full); }
        }
    } else {
        dir_walk_checked(str_from(root), walked, failed);
    }
    if (_cov_unlisted(failed, "its sources were NOT measured") != 0) { return 0; }
    var srcs = vec_new();
    var wi = 0;
    while (wi < vec_len(walked)) {
        var wf = vec_get(walked, wi);
        if (str_ends_with(wf, ".cyr") == 1) { vec_push(srcs, wf); }
        wi = wi + 1;
    }
    return srcs;
}

# Name every directory in `failed` (a vec of Str) — "error: coverage: cannot list directory
# (<what>): <dir>" — and answer 1 when there was any, else 0. CHANGELOG [6.6.10]
fn _cov_unlisted(failed, what): i64 {
    var i = 0;
    while (i < vec_len(failed)) {
        var d = vec_get(failed, i);
        _progress_close();
        _err_count = _err_count + 1;
        sys_write(STDERR_FD, "error: coverage: cannot list directory: ", 40);
        sys_write(STDERR_FD, str_data(d), str_len(d));
        sys_write(STDERR_FD, " — ", 5);
        sys_write(STDERR_FD, what, strlen(what));
        sys_write(STDERR_FD, "\n", 1);
        i = i + 1;
    }
    if (vec_len(failed) > 0) { return 1; }
    return 0;
}

# The unreferenced public fns, one `  <source path>: <name>` per line.
fn _cov_print_misses(miss_path, miss_name): i64 {
    var nm = vec_len(miss_name);
    println("");
    sys_write(STDOUT_FD, "-- Unreferenced (", 17);
    fmt_int(nm);
    println(") --");
    var mi = 0;
    while (mi < nm) {
        var mp = vec_get(miss_path, mi);
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, mp, strlen(mp));
        sys_write(STDOUT_FD, ": ", 2);
        var mn = vec_get(miss_name, mi);
        sys_write(STDOUT_FD, str_data(mn), str_len(mn));
        println("");
        mi = mi + 1;
    }
    return 0;
}

# 6.6.17 (P5-A) — `--per-entry`: for each corpus entry (a .tcyr or a RUN program), the public fns
# it references — whole identifiers in its CODE, the rule the totals use, read from the entry's
# own slice of the blanked corpus.
fn _cov_print_per_entry(corpus, ent_path, ent_off, ent_len, all_path, all_name): i64 {
    println("");
    println("-- References by corpus entry --");
    var ei = 0;
    while (ei < vec_len(ent_path)) {
        var off = vec_get(ent_off, ei);
        var len = vec_get(ent_len, ei);
        var set = _src_ids_new(len);
        if (set == 0 || _src_ids_add_text(set, corpus + off, len) != 0) {
            _err("coverage: out of memory indexing a corpus entry");
            return 1;
        }
        var hit = vec_new();
        var fi = 0;
        while (fi < vec_len(all_name)) {
            var nm = vec_get(all_name, fi);
            if (_src_ids_has(set, str_data(nm), str_len(nm)) == 1) { vec_push(hit, fi); }
            fi = fi + 1;
        }
        var ep = vec_get(ent_path, ei);
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, ep, strlen(ep));
        sys_write(STDOUT_FD, ": ", 2);
        fmt_int(vec_len(hit));
        sys_write(STDOUT_FD, " of ", 4);
        fmt_int(vec_len(all_name));
        println(" public fns");
        var hi = 0;
        while (hi < vec_len(hit)) {
            var k = vec_get(hit, hi);
            var sp = vec_get(all_path, k);
            var sn = vec_get(all_name, k);
            sys_write(STDOUT_FD, "      ", 6);
            sys_write(STDOUT_FD, sp, strlen(sp));
            sys_write(STDOUT_FD, ": ", 2);
            sys_write(STDOUT_FD, str_data(sn), str_len(sn));
            println("");
            hi = hi + 1;
        }
        ei = ei + 1;
    }
    return 0;
}

# A corpus program is a TEST, not measured surface: drop every source path (a vec of Str) that
# names one of `progs` (normalized cstrs).
fn _cov_drop_corpus(srcs, progs): i64 {
    var out = vec_new();
    var i = 0;
    while (i < vec_len(srcs)) {
        var sp = vec_get(srcs, i);
        i = i + 1;
        var np = _test_norm(str_data(sp));
        var keep = 1;
        var j = 0;
        while (j < vec_len(progs)) {
            if (streq(vec_get(progs, j), np) == 1) { keep = 0; }
            j = j + 1;
        }
        if (keep == 1) { vec_push(out, sp); }
    }
    return out;
}

fn _cov_has_wild(p): i64 {
    var i = 0;
    while (load8(p + i) != 0) {
        if (load8(p + i) == 42 || load8(p + i) == 63) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Shell-glob match of cstr `s` against `pat`: `*` is any run and `?` any one byte, NEITHER crossing
# a `/` (so `programs/*_test.cyr` does not reach programs/sub/). 1 or 0.
fn _cov_glob(pat, s): i64 {
    var pi = 0;
    var si = 0;
    var sp = 0 - 1;
    var ss = 0 - 1;
    while (load8(s + si) != 0) {
        var pc = load8(pat + pi);
        var sc = load8(s + si);
        if (pc == 42) {
            sp = pi;
            ss = si;
            pi = pi + 1;
            continue;
        }
        if (pc != 0 && (pc == sc || (pc == 63 && sc != 47))) {
            pi = pi + 1;
            si = si + 1;
            continue;
        }
        if (sp >= 0 && load8(s + ss) != 47) {
            ss = ss + 1;
            si = ss;
            pi = sp + 1;
            continue;
        }
        return 0;
    }
    while (load8(pat + pi) == 42) { pi = pi + 1; }
    if (load8(pat + pi) == 0) { return 1; }
    return 0;
}

fn _cov_cstr_cmp(a, b): i64 {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return ca - cb; }
        if (ca == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

fn _cov_push_unique(v, p): i64 {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), p) == 1) { return 0; }
        i = i + 1;
    }
    vec_push(v, p);
    return 1;
}

# Files under `dir` matching `pat`, descending at most `depth` more directory levels (a `*` never
# crosses a `/`, so the pattern's own `/` count bounds the walk). 0, or 1 after naming a directory
# that could not be listed.
fn _cov_glob_walk(dir, depth, pat, out): i64 {
    var ents = _cbt_list_dir(dir, "its programs were NOT read");
    if (ents == 0) { return 1; }
    var i = 0;
    while (i < vec_len(ents)) {
        var nm = str_data(vec_get(ents, i));
        i = i + 1;
        var full = nm;
        if (streq(dir, ".") == 0) { full = make_path(dir, nm); }
        if (is_dir(str_from(full)) == 1) {
            if (depth > 0 && is_symlink(str_from(full)) == 0) {
                if (_cov_glob_walk(full, depth - 1, pat, out) != 0) { return 1; }
            }
        } elif (_cov_glob(pat, full) == 1) {
            _cov_push_unique(out, full);
        }
    }
    return 0;
}

# 6.6.17 (P5-A): the RUN programs a list of globs names, sorted and de-duplicated. A literal path
# must be a file; a glob must match at least one — either miss is a named failure (0), because a
# typo'd glob would otherwise drop the whole programs corpus and the percentage with it.
fn _cov_expand_programs(pats): i64 {
    var out = vec_new();
    var i = 0;
    while (i < vec_len(pats)) {
        var pat = _test_norm(vec_get(pats, i));
        i = i + 1;
        if (_cov_has_wild(pat) == 0) {
            if (file_exists(pat) == 0 || is_dir(str_from(pat)) == 1) {
                _err_ctx("coverage: no such program (--programs / [coverage] programs)", pat);
                return 0;
            }
            _cov_push_unique(out, pat);
            continue;
        }
        # the literal directory before the first wildcard, and how many `/` follow it
        var w = 0;
        while (load8(pat + w) != 42 && load8(pat + w) != 63) { w = w + 1; }
        var cut = 0 - 1;
        var k = 0;
        while (k < w) {
            if (load8(pat + k) == 47) { cut = k; }
            k = k + 1;
        }
        var dir = ".";
        if (cut > 0) {
            dir = alloc(cut + 1);
            memcpy(dir, pat, cut);
            store8(dir + cut, 0);
        }
        var depth = 0;
        k = cut + 1;
        while (load8(pat + k) != 0) {
            if (load8(pat + k) == 47) { depth = depth + 1; }
            k = k + 1;
        }
        var m = vec_new();
        if (is_dir(str_from(dir)) == 1) {
            if (_cov_glob_walk(dir, depth, pat, m) != 0) { return 0; }
        }
        if (vec_len(m) == 0) {
            _err_ctx("coverage: this programs glob matches no file", pat);
            return 0;
        }
        var mi = 0;
        while (mi < vec_len(m)) {
            _cov_push_unique(out, vec_get(m, mi));
            mi = mi + 1;
        }
    }
    vec_sort_by(out, &_cov_cstr_cmp);
    return out;
}

# ================================================================
# Native doctest: extract # >>> / # === patterns, compile, run
# ================================================================
# v6.6.6 (bite 26b) — write a doc example to its temp source, to completion. 0 = every
# byte landed, -1 = it did not. See the call site for what a short write used to score.
fn _dt_write_all(fd, buf, len): i64 {
    var off = 0;
    while (off < len) {
        var w = syscall(1, fd, buf + off, len - off);
        if (w <= 0) { return 0 - 1; }
        off = off + w;
    }
    return 0;
}

fn cmd_doctest(arg): i64 {
    if (arg == 0) {
        println("Usage: cyrius doctest <file.cyr>");
        return 1;
    }
    # ⛔ 6.6.8: the WHOLE file. This read into a fixed 64 KiB buffer and never checked for
    # truncation, so every example past the cut silently did not exist — neither run nor
    # counted — and the verdict was over the head of the file only. CHANGELOG [6.6.8]
    var fn_read = 0;
    var fbuf = file_read_whole(arg, &fn_read);
    if (fbuf == 0) {
        sys_write(STDERR_FD, "error: cannot read ", 19);
        sys_write(STDERR_FD, arg, strlen(arg));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }

    var dt_pass = 0;
    var dt_fail = 0;
    var dt_total = 0;
    # v6.5.19 — `_DT_CODE_CAP` and the two guards below. Both memcpys into `code` were
    # unbounded: a doc example longer than the buffer wrote past the end of an 8 KB heap
    # region from ordinary (if unusual) source. Same class as the three unbounded copies
    # the 2026-07-27 audit found, and noticed while fixing the auto-prepend in this
    # function. Overflowing an example is reported as a failed doc test rather than
    # silently truncated, so the count stays honest.
    var _DT_CODE_CAP = 8192;
    var code = alloc(_DT_CODE_CAP);
    var code_len = 0;
    var in_example = 0;
    var line_num = 0;
    var dt_over = 0;

    var pos = 0;
    while (pos < fn_read) {
        # Read one line
        var ls = pos;
        while (pos < fn_read) {
            if (load8(fbuf + pos) == 10) { pos = pos + 1; break; }
            pos = pos + 1;
        }
        var le = pos;
        if (le > ls) { if (load8(fbuf + le - 1) == 10) { le = le - 1; } }
        line_num = line_num + 1;
        var ll = le - ls;

        if (ll >= 6) {
            if (memeq(fbuf + ls, "# >>> ", 6) == 1) {
                # New or continuation example line
                var snippet = fbuf + ls + 6;
                var slen = ll - 6;
                if (in_example == 0) { code_len = 0; dt_over = 0; }
                if (code_len + slen + 2 > _DT_CODE_CAP) { dt_over = 1; in_example = 1; continue; }
                memcpy(code + code_len, snippet, slen);
                code_len = code_len + slen;
                store8(code + code_len, 10);
                code_len = code_len + 1;
                in_example = 1;
                continue;
            }
        }
        if (ll >= 6) {
            if (memeq(fbuf + ls, "# === ", 6) == 1) {
                if (in_example == 1 && dt_over == 1) {
                    dt_total = dt_total + 1;
                    dt_fail = dt_fail + 1;
                    sys_write(STDERR_FD, "  FAIL: ", 8);
                    sys_write(STDERR_FD, arg, strlen(arg));
                    sys_write(STDERR_FD, ":", 1);
                    fmt_int_fd(STDERR_FD, line_num);
                    sys_write(STDERR_FD, " (doc example exceeds the ", 26);
                    fmt_int_fd(STDERR_FD, _DT_CODE_CAP);
                    sys_write(STDERR_FD, "-byte example buffer)\n", 22);
                    code_len = 0;
                    in_example = 0;
                    dt_over = 0;
                    continue;
                }
                if (in_example == 1) {
                    # Parse expected exit code
                    var exp_str = fbuf + ls + 6;
                    var expected = atoi(exp_str);
                    store8(code + code_len, 0);
                    dt_total = dt_total + 1;

                    # Write code to temp file, compile, run
                    var tmpf = _cbt_tmpfile("dt_src");
                    var fd = syscall(2, tmpf, 0x241, 0x1A4);
                    # ⛔ v6.6.6 (bite 26b) — the same unchecked-temp-source shape as
                    # `_materialize_source`, one verb over. `fd < 0` fell through with NO
                    # else, so a doctest whose temp could not be created was counted in
                    # `dt_total` and in neither `dt_pass` nor `dt_fail` — and the verdict
                    # is `dt_fail > 0`, so `cyrius doctest` exited 0 with the example never
                    # run. A short write was worse: the example was TRUNCATED and whatever
                    # the prefix happened to compile to was scored against the expected
                    # exit code. Both are failures now, by name. CHANGELOG [6.6.6].
                    var dt_wrote = 0 - 1;
                    if (fd >= 0) {
                        dt_wrote = _dt_write_all(fd, code, code_len);
                        syscall(3, fd);
                        if (dt_wrote != 0) {
                            _err_ctx("doctest: could not write the example's temp source", tmpf);
                            dt_fail = dt_fail + 1;
                            sys_unlink(tmpf);
                        }
                    } else {
                        _err_ctx("doctest: cannot create the example's temp source", tmpf);
                        dt_fail = dt_fail + 1;
                    }
                    if (dt_wrote == 0) {
                        var tmpbin = _cbt_tmpexe("dt_bin");
                        if (compile(tmpf, tmpbin) == 0) {
                            var ec = run_binary_timed(tmpbin, _run_timeout_ms(), 0);
                            if (ec == expected) {
                                dt_pass = dt_pass + 1;
                            } else {
                                sys_write(STDERR_FD, "  FAIL: ", 8);
                                sys_write(STDERR_FD, arg, strlen(arg));
                                sys_write(STDERR_FD, ":", 1);
                                fmt_int_fd(STDERR_FD, line_num);
                                sys_write(STDERR_FD, " (expected ", 11);
                                fmt_int_fd(STDERR_FD, expected);
                                sys_write(STDERR_FD, ", got ", 6);
                                fmt_int_fd(STDERR_FD, ec);
                                sys_write(STDERR_FD, ")\n", 2);
                                dt_fail = dt_fail + 1;
                            }
                            sys_unlink(tmpbin);
                        } else {
                            sys_write(STDERR_FD, "  FAIL: ", 8);
                            sys_write(STDERR_FD, arg, strlen(arg));
                            sys_write(STDERR_FD, ":", 1);
                            fmt_int_fd(STDERR_FD, line_num);
                            sys_write(STDERR_FD, " (compile error)\n", 17);
                            dt_fail = dt_fail + 1;
                        }
                        sys_unlink(tmpf);
                    }
                }
                code_len = 0;
                in_example = 0;
                continue;
            }
        }
        # Non-matching line ends example
        if (in_example == 1) {
            if (ll >= 2) {
                if (memeq(fbuf + ls, "# ", 2) == 1) {
                    # Continuation comment line
                    var snippet = fbuf + ls + 2;
                    var slen = ll - 2;
                    if (code_len + slen + 2 > _DT_CODE_CAP) { dt_over = 1; continue; }
                    memcpy(code + code_len, snippet, slen);
                    code_len = code_len + slen;
                    store8(code + code_len, 10);
                    code_len = code_len + 1;
                    continue;
                }
            }
            code_len = 0;
            in_example = 0;
        }
    }

    println("");
    fmt_int(dt_pass);
    sys_write(STDOUT_FD, " passed, ", 9);
    fmt_int(dt_fail);
    sys_write(STDOUT_FD, " failed (", 9);
    fmt_int(dt_total);
    println(" total doc tests)");
    if (dt_fail > 0) { return 1; }
    return 0;
}

# ================================================================
# Native header: scan the public fn declarations, emit C prototypes
# ================================================================
# 6.6.8: the PUBLIC SURFACE, the same rule cmd_coverage counts (_src_public_fn_at): every
# declaration spelling at brace depth 0, the file-scope `private` rule, `_`-prefixed names
# and the `main` entry point excluded. This
# matched only a column-0 `pub fn ` — its own comment said "pub fn or fn" — so a bare `fn`
# (public in an ordinary file) and `public fn` (the same token as `pub`) never got a
# prototype. And it read a fixed 64 KiB: an 81,752-byte file lost every fn past the cut
# with rc=0. It had no gate; tests/gates/toolchain/header_spellings_and_size.sh is it.
# CHANGELOG [6.6.8]
fn cmd_header(arg): i64 {
    if (arg == 0) {
        println("Usage: cyrius header <file.cyr>");
        return 1;
    }
    var hn = 0;
    var hbuf = file_read_whole(arg, &hn);
    if (hbuf == 0) {
        sys_write(STDERR_FD, "error: cannot read ", 19);
        sys_write(STDERR_FD, arg, strlen(arg));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    # Declarations come from CODE only — a fn named in a comment or string is not one.
    _src_blank_noncode(hbuf, hn);
    var fpriv = _src_file_private(hbuf, hn);

    println("/* Auto-generated by cyrius header -- do not edit */");
    println("#ifndef CYRIUS_FFI_H");
    println("#define CYRIUS_FFI_H");
    println("");
    println("#include <stdint.h>");
    println("");
    println("/* All Cyrius values are 64-bit integers */");
    println("typedef int64_t cyr_val;");
    println("");

    var pos = 0;
    var depth = 0;                            # brace depth: an `impl` method is not FFI surface
    while (pos < hn) {
        var ls = pos;
        while (pos < hn) {
            if (load8(hbuf + pos) == 10) { pos = pos + 1; break; }
            pos = pos + 1;
        }
        var le = pos;
        if (le > ls) { if (load8(hbuf + le - 1) == 10) { le = le - 1; } }

        var d0 = depth;
        depth = depth + _src_brace_delta(hbuf, ls, le);
        if (depth < 0) { depth = 0; }
        if (d0 != 0) { continue; }
        var fname_start = _src_public_fn_at(hbuf, ls, le, fpriv);
        if (fname_start < 0) { continue; }

        # Extract function name; its `(` must follow on the same line
        var fname_len = _src_ident_end(hbuf, fname_start, le) - fname_start;
        # A program's `fn main` is its entry point, not FFI surface — its prototype would
        # collide with the C host's own `int main`. CHANGELOG [6.6.8]
        if (_src_is_entry_fn(hbuf, fname_start, fname_len) == 1) { continue; }
        var ne = _src_skip_ws(hbuf, fname_start + fname_len, le);
        if (ne >= le) { continue; }
        if (load8(hbuf + ne) != 40) { continue; }

        # Extract params between ( and ) — the `)` that closes the list, at paren depth 0. A tuple
        # parameter's type nests one (`t: (i64, i64)`); the first `)` cut the list inside it and
        # printed the element type as a parameter (`cyr_val i64`). CHANGELOG [6.7.7]
        var ps = ne + 1;
        var pe = ps;
        var pdep = 0;
        while (pe < le) {
            var bc = load8(hbuf + pe);
            if (bc == 41) {
                if (pdep == 0) { break; }
                pdep = pdep - 1;
            }
            if (bc == 40) { pdep = pdep + 1; }
            pe = pe + 1;
        }

        sys_write(STDOUT_FD, "cyr_val ", 8);
        sys_write(STDOUT_FD, hbuf + fname_start, fname_len);
        sys_write(STDOUT_FD, "(", 1);
        if (pe == ps) {
            sys_write(STDOUT_FD, "void", 4);
        } else {
            # Count and emit params
            var pi = ps;
            var first = 1;
            while (pi < pe) {
                # Skip whitespace
                while (pi < pe) {
                    if (load8(hbuf + pi) != 32) { break; }
                    pi = pi + 1;
                }
                var pns = pi;
                while (pi < pe) {
                    var pc = load8(hbuf + pi);
                    if (pc == 44 || pc == 58 || pc == 41) { break; }
                    pi = pi + 1;
                }
                var pne = pi;
                # Trim trailing space
                while (pne > pns) {
                    if (load8(hbuf + pne - 1) != 32) { break; }
                    pne = pne - 1;
                }
                # Skip the rest of the parameter — its type annotation — to the `,` at paren
                # depth 0: a tuple type's own commas are inside it, and a tuple parameter is one
                # `cyr_val` (it travels as an address). Every byte up to that `,` is stepped, so a
                # `)` the name scan stopped at inside the list (malformed source) cannot stall the
                # walk now that the list runs past the first `)`. CHANGELOG [6.7.7]
                var tdep = 0;
                while (pi < pe) {
                    var tc = load8(hbuf + pi);
                    if (tc == 44 && tdep <= 0) { break; }
                    if (tc == 40) { tdep = tdep + 1; }
                    if (tc == 41) { tdep = tdep - 1; }
                    pi = pi + 1;
                }
                if (pne > pns) {
                    if (first == 0) { sys_write(STDOUT_FD, ", ", 2); }
                    sys_write(STDOUT_FD, "cyr_val ", 8);
                    sys_write(STDOUT_FD, hbuf + pns, pne - pns);
                    first = 0;
                }
                # Skip comma
                if (pi < pe) { if (load8(hbuf + pi) == 44) { pi = pi + 1; } }
            }
        }
        println(");");
    }

    println("");
    println("#endif /* CYRIUS_FFI_H */");
    return 0;
}

fn cmd_repl(): i64 {
    var script = make_path(_scripts_dir, "shims/cyrius-repl.sh");
    if (file_exists(script) == 0) {
        script = make_path(_scripts_dir, "cyrius-repl.sh");
    }
    return run_script(script, _cc, 0);
}

