# ================================================================
# Native coverage — REFERENCE coverage: for each public `fn` in the scanned
# source tree, is its name referenced anywhere in the tests/tcyr corpus? This is
# a floor against UNWATCHED code, not a line/branch-coverage or correctness proof
# (a mirror-style suite that re-implements rather than calls still "references"
# the symbol — that is intentional: reference coverage is meaningful for both
# linked and mirror suites, which is why it does not need the linked-vs-mirror
# line-coverage distinction).
#
# v6.4.72 (issue 2026-07-23-hoosh-coverage-reports-stdlib-not-local-repo):
#   cyrius coverage           -> the PROJECT's OWN sources (src/, recursive) — the
#                                new default. Was `lib/` (the VENDORED stdlib), so
#                                a downstream project got a number about the stdlib,
#                                not itself ("Functions: 0/1097", permanently ~0).
#   cyrius coverage --full    -> the vendored stdlib in lib/ (today's behaviour;
#                                legitimate when working ON cyrius itself).
#   cyrius coverage --min N   -> exit non-zero if coverage% < N (a CI gate).
# The mode is stated in the summary so a stdlib figure can't be mistaken for a
# project figure. `--min` and `--full` compose.
# v6.6.5 — the flags arrive already parsed (cbt/cli_args.cyr). This used to run its
# own `ai = 2` loop, so `cyrius -q coverage` took the VERB NAME as the directory
# ("not a directory: coverage"), and `--min abc` went through `atoi` to 0 and printed
# "gate OK: 0% >= --min 0%" with exit 0 — a CI gate that passes on a typo. `min_pct`
# is -1 when no gate was asked for; the caller has already validated the integer.
# v6.5.8: a SUBFOLDER CALLOUT — `cyrius coverage src/sub` scans that directory (it
# used to be dropped on the floor and the scan ran against ./ anyway).
# 6.6.8: what counts, on both sides. The DENOMINATOR is the public surface as the
# compiler defines it — every declaration spelling (indented, attributed, `pub`/`public`,
# `fn` + any whitespace) and the file-scope `private` rule — read from whole files under
# the whole root. The NUMERATOR is a whole-identifier reference in the CODE of a test
# (comments, strings and char literals blanked). Unreferenced names are listed under -v
# and whenever --min fails. Residual, inherent to NAME-based coverage: a test local or
# parameter that shares a fn's name still counts. CHANGELOG [6.6.8]
# 6.6.17 (P5-A): RUN PROGRAMS join the corpus — `programs` is a vec of globs (`--programs`, else
# `[coverage] programs`), each matched file read whole, blanked and counted exactly as a .tcyr is.
# This is TEXT coverage (the same reference count .tcyr corpora get), NOT execution coverage —
# that is `--exec` (6.7.10, below). A corpus program is a test, so it leaves the measured surface (the '.'
# fallback would otherwise count it and let it reference itself). `per_entry` adds the view of
# which corpus entry references which public fn. rekha, sadish, dhancha, setu and mishran test
# with programs/*_test.cyr and read ~0%. CHANGELOG [6.6.17]
# 6.7.10 (P5-B): EXECUTION coverage beside it — `xprogs` (0 = text mode, untouched) is the vec of
# `--exec=<glob>` / `[coverage] exec` globs (possibly empty). Every tests/**/*.tcyr and every
# program those globs name is built instrumented and run (`_covx_run`); a public fn counts as
# executed once a run's dump records entering it (`_covx_read`, the NAME model the reference count
# uses). The reference figures print exactly as in text mode; the executed ones are added, and
# `--min` gates the executed %. A failed run (a nonzero exit, a signal, a timeout, no coverage
# record) is named as it happens and fails the run after the report. CHANGELOG [6.7.10]
fn cmd_coverage(full, min_pct, root_arg, programs, per_entry, xprogs): i64 {

    # Scan root: an explicit callout wins, then lib/ for --full, else the project's own
    # src/ (recursive).
    var root = "src";
    if (full == 1) { root = "lib"; }
    if (root_arg != 0) {
        root = root_arg;
        if (is_dir(str_from(root)) != 1) {
            _err_ctx("not a directory", root);
            return 1;
        }
    }
    elif (is_dir(str_from(root)) != 1) {
        # No src/ (e.g. a flat project) — fall back to '.', still excluding lib/.
        root = ".";
    }

    _status("=== Coverage Report ===");
    if (full == 1) {
        println("  mode: --full (vendored stdlib in lib/); reference coverage");
    } else {
        sys_write(STDOUT_FD, "  mode: local repo sources (", 28);
        sys_write(STDOUT_FD, root, strlen(root));
        # 6.6.8: only the '.' fallback excludes anything, and only its top-level lib/ +
        # dist/ — this line claimed the exclusion for every root. CHANGELOG [6.6.8]
        if (streq(root, ".") == 1) { println("/, recursive; top-level lib/ + dist/ excluded); reference coverage"); }
        else { println("/, recursive); reference coverage"); }
    }
    # 6.6.17 (P5-A): expand the RUN-program globs first, so a glob that matches nothing fails
    # before anything is reported (measuring a corpus that is not there is not a pass).
    var prog_files = 0;
    if (programs != 0) {
        if (vec_len(programs) > 0) {
            prog_files = _cov_expand_programs(programs, "programs");
            if (prog_files == 0) { return 1; }
            sys_write(STDOUT_FD, "  corpus: tests/**/*.tcyr + ", 28);
            fmt_int(vec_len(prog_files));
            println(" RUN program(s), as text (references, not execution)");
        }
    }
    # 6.7.10 (P5-B): the exec programs, expanded the same way (a glob that matches nothing fails)
    var xprog_files = vec_new();
    if (xprogs != 0) {
        if (vec_len(xprogs) > 0) {
            xprog_files = _cov_expand_programs(xprogs, "exec");
            if (xprog_files == 0) { return 1; }
        }
        sys_write(STDOUT_FD, "  exec: tests/**/*.tcyr + ", 26);
        fmt_int(vec_len(xprog_files));
        println(" RUN program(s), built instrumented and run (execution coverage)");
    }
    println("");
    var xtests = vec_new();                   # 6.7.10: the .tcyr the exec run builds and runs
    var ent_path = vec_new();                 # corpus entries, for --per-entry
    var ent_off = vec_new();
    var ent_len = vec_new();

    # Collect all tests/tcyr content into one searchable corpus, via dir_walk +
    # an inline str_ends_with suffix test. (Written to sidestep find_files, which
    # appeared to "mis-drop every entry" — root-caused v6.4.72 to find_files' then-
    # untyped `ext` param NOT firing the compiler's literal->Str auto-coercion, so a
    # bare `".cyr"` arrived as a raw cstr pointer and str_ends_with read its length
    # from load64(ptr+8) = garbage. NOT an allocator / "heap regime" issue; fixed in
    # lib/fs.cyr by annotating `ext: Str`. The inline walk stays as the equivalent,
    # simplest form.)
    # ⛔ v6.5.8: GROW-AND-RETRY. This was a FIXED 1 MiB buffer, and the corpus silently
    # stopped growing once it filled: `file_read_all` returns exactly `maxlen` on
    # truncation and 0 once `avail` reaches 0, so `if (n > 0)` made truncation, a
    # whole-file drop and a failed open indistinguishable — and all three silent. Every
    # symbol whose only reference lived in the discarded tail then read as unreferenced,
    # so the reported percentage fell with no diagnostic and `--min` still exited 0.
    #
    # The failure is ANTI-CORRELATED with the signal, which is what makes it worse than a
    # plain cap: coverage degrades as the test suite GROWS, so it punishes the projects
    # testing most and reads as "someone deleted a test". It was mis-measuring THIS repo.
    #
    # Grow-and-retry rather than the filing's "sum file sizes first": there is no portable
    # file-size primitive in lib/ — the only candidate, `xlseek`, is a bare SYS_LSEEK that
    # is wrong on PE, and cbt/cyrius.cyr cross-compiles to PE and Mach-O. Doubling needs no
    # size call at all and uses only alloc + memcpy, both already available here.
    var corpus_cap = 1048576;
    var corpus = alloc(corpus_cap);
    if (corpus == 0) {
        _err("coverage: out of memory for the test corpus");
        return 1;
    }
    var corpus_len = 0;
    if (is_dir(str_from("tests")) == 1) {
        var tests = vec_new();
        # ⛔ 6.6.10: CHECKED. dir_walk dropped an unreadable tests/ subdirectory in silence, so
        # the fns only its tests reference read as unreferenced — or, for the SOURCE side
        # below, a whole unreadable src/ subtree left the denominator and the percentage ROSE
        # (50 % -> 100 %, passing --min 60). Every directory not listed is named and fails
        # the run. CHANGELOG [6.6.10]
        var tfail = vec_new();
        dir_walk_checked(str_from("tests"), tests, tfail);   # recursive: tests/tcyr/*.tcyr AND tests/*.tcyr
        if (_cov_unlisted(tfail, "its tests were NOT read") != 0) { return 1; }
        var ti = 0;
        while (ti < vec_len(tests)) {
            var tf = vec_get(tests, ti);
            if (str_ends_with(tf, ".tcyr") == 1) {
                var avail = corpus_cap - corpus_len - 1;
                var n = file_read_all(str_data(tf), corpus + corpus_len, avail);
                if (n >= avail) {
                    # Filled to the brim — the read may have been truncated, and we cannot
                    # tell from the return value alone. Grow and retry the SAME file
                    # rather than accept a possibly-partial read.
                    if (corpus_cap >= 268435456) {
                        _err_ctx("coverage corpus exceeded 256 MiB while reading", str_data(tf));
                        return 1;
                    }
                    var nb = alloc(corpus_cap * 2);
                    if (nb == 0) {
                        _err("coverage: out of memory growing the test corpus");
                        return 1;
                    }
                    memcpy(nb, corpus, corpus_len);
                    corpus = nb;
                    corpus_cap = corpus_cap * 2;
                    # Do NOT advance ti — re-read this file into the larger buffer.
                } elif (n < 0) {
                    # ⛔ 6.6.10: an unreadable test is an ERROR, by name. `if (n > 0)` below
                    # folded it into "empty", so the fns only it referenced read as misses and
                    # the percentage dropped with no diagnostic (50 % -> 25 %). CHANGELOG [6.6.10]
                    _err_ctx("coverage: cannot read test", str_data(tf));
                    return 1;
                } else {
                    # Only now is the read known COMPLETE, so only now is it blanked: its
                    # comments, strings and char literals become spaces in place (same
                    # length), and a name there no longer reads as a reference. Per file,
                    # so an unclosed string cannot run on into the next file. CHANGELOG [6.6.8]
                    if (n > 0) {
                        _src_blank_noncode(corpus + corpus_len, n);
                        vec_push(ent_path, str_data(tf));
                        vec_push(ent_off, corpus_len);
                        vec_push(ent_len, n);
                        corpus_len = corpus_len + n;
                    }
                    vec_push(xtests, str_data(tf));
                    ti = ti + 1;
                }
            } else {
                ti = ti + 1;
            }
        }
    }
    # 6.6.17 (P5-A): each RUN program, whole, blanked like a test.
    var pfi = 0;
    while (prog_files != 0 && pfi < vec_len(prog_files)) {
        var pf = vec_get(prog_files, pfi);
        pfi = pfi + 1;
        var pn = 0;
        var pb = file_read_whole(pf, &pn);
        if (pb == 0) {
            _err_ctx("coverage: cannot read program", pf);
            return 1;
        }
        while (corpus_len + pn + 1 > corpus_cap) {
            if (corpus_cap >= 268435456) {
                _err_ctx("coverage corpus exceeded 256 MiB while reading", pf);
                return 1;
            }
            var gb = alloc(corpus_cap * 2);
            if (gb == 0) {
                _err("coverage: out of memory growing the test corpus");
                return 1;
            }
            memcpy(gb, corpus, corpus_len);
            corpus = gb;
            corpus_cap = corpus_cap * 2;
        }
        memcpy(corpus + corpus_len, pb, pn);
        _src_blank_noncode(corpus + corpus_len, pn);
        vec_push(ent_path, pf);
        vec_push(ent_off, corpus_len);
        vec_push(ent_len, pn);
        corpus_len = corpus_len + pn;
    }
    store8(corpus + corpus_len, 0);
    # 6.6.10: ONE pass over the corpus. Every identifier goes into a set once, and each public
    # fn below is one lookup — it was one memeq scan of the whole corpus PER FN (78 s on this
    # repo's --full). The same whole-identifier rule; see cbt/srcscan.cyr `_src_ids_*`.
    var refs = _src_ids_new(corpus_len);
    if (refs == 0 || _src_ids_add_text(refs, corpus, corpus_len) != 0) {
        _err("coverage: out of memory indexing the test corpus");
        return 1;
    }
    # 6.7.10 (P5-B): the exec run — every .tcyr, then every exec program, built instrumented and run.
    # `xids` holds the fns some run entered (names), `kids` the #naked ones it reported as not
    # instrumented; `xfailed` the runs that failed, each already named.
    var xids = 0;
    var kids = 0;
    var xfailed = 0;
    if (xprogs != 0) {
        xfailed = _covx_run(xtests, xprog_files);
        if (xfailed < 0) { return 1; }
        xids = _covx_ids(_covx_xsb);
        kids = _covx_ids(_covx_ksb);
        if (xids == 0 || kids == 0) {
            _err("coverage: out of memory indexing the executed fns");
            return 1;
        }
    }

    # The sources to measure. ⛔ 6.6.8: the vendored-tree prune is applied at the TOP LEVEL
    # of the '.' fallback only. It used to be a by-NAME prune at every depth, so a project
    # keeping its code under src/lib/ (nein, hoosh, kriya, kybernet) had that whole tree
    # silently dropped — nein read `main.cyr 1/1 (100%)` and passed `--min 80` while 259 of
    # its 393 fns were never measured. The comment here claimed the prune was "inert for the
    # src/ root". CHANGELOG [6.6.8]
    var srcs = _cov_sources(root);
    if (srcs == 0) { return 1; }             # 6.6.10: a directory could not be listed (named)
    if (prog_files != 0) { srcs = _cov_drop_corpus(srcs, prog_files); }
    if (vec_len(xprog_files) > 0) { srcs = _cov_drop_corpus(srcs, xprog_files); }
    var all_path = vec_new();                 # every public fn, for --per-entry
    var all_name = vec_new();

    var total_files = 0;
    var covered_files = 0;
    var total_fns = 0;
    var covered_fns = 0;
    var miss_path = vec_new();                # unreferenced public fns, for the report
    var miss_name = vec_new();
    var xcovered_fns = 0;                     # 6.7.10: executed public fns, and the rest
    var xmiss_path = vec_new();
    var xmiss_name = vec_new();
    # ⛔ 6.6.8: WHOLE-FILE READS. Each source went into a fixed 256 KiB buffer with no
    # truncation check, so every fn past the cut was never counted — bayan's pdf.cyr
    # (399,907 B) showed 114 of its 152 fns. `file_read_whole_into` grows the buffer (it
    # needs no file-size call, which is wrong on PE) and REUSES it across files; a read
    # error is an error by name, not a skipped file. CHANGELOG [6.6.8]
    var rb[16];
    store64(&rb, 0);
    store64(&rb + 8, 0);
    var li = 0;
    while (li < vec_len(srcs)) {
        var spath = str_data(vec_get(srcs, li));
        li = li + 1;
        var ln = file_read_whole_into(&rb, spath, ALLOC_MAX - 1);
        if (ln < 0) {
            _err_ctx("coverage: cannot read source", spath);
            return 1;
        }
        if (ln == 0) { continue; }
        var lbuf = load64(&rb);
        # Declarations are read from CODE only: a fn in a comment or a multi-line string is
        # not a fn. And a `private` file exports only its `pub` / `public` fns — counting its
        # bare fns measured exactly the wrong set (hisab's whole 643-fn `public fn` API was
        # invisible and the tool reported 1/1 = 100%). CHANGELOG [6.6.8]
        _src_blank_noncode(lbuf, ln);
        var fpriv = _src_file_private(lbuf, ln);

        var pub_fns = 0;
        var called = 0;
        var xcalled = 0;
        var pos = 0;
        var depth = 0;                        # brace depth: only depth-0 fns are top-level
        while (pos < ln) {
            var le = pos;
            while (le < ln) { if (load8(lbuf + le) == 10) { break; } le = le + 1; }
            var ns = 0 - 1;
            if (depth == 0) { ns = _src_public_fn_at(lbuf, pos, le, fpriv); }
            depth = depth + _src_brace_delta(lbuf, pos, le);
            if (depth < 0) { depth = 0; }
            var fname_len = 0;
            if (ns >= 0) { fname_len = _src_ident_end(lbuf, ns, le) - ns; }
            # ⛔ 6.6.11: a depth-0 `main` is the ENTRY POINT (_src_is_entry_fn) — no test can name
            # it, so counting it held ganita at 139/141 and bayan at 501/503 with nothing else
            # missing. An `if`, NOT a `continue`: `pos = le + 1` below is the loop's only advance.
            if (ns >= 0 && _src_is_entry_fn(lbuf, ns, fname_len) == 1) { ns = 0 - 1; }
            if (ns >= 0) {
                pub_fns = pub_fns + 1;
                total_fns = total_fns + 1;
                if (per_entry == 1) {
                    vec_push(all_path, spath);
                    vec_push(all_name, str_from_buf(lbuf + ns, fname_len));
                }
                # ⛔ 6.6.8: a WHOLE-IDENTIFIER match over a corpus whose comments, strings and
                # char literals are blanked. A raw substring match counted `check_due` as
                # referenced by every `check_due_at(` and `str_lt` by a comment naming it, so
                # samay's `--min 100` passed with functions no test referenced. (6.6.10: a
                # token ending at the corpus's last byte is a token — axis 2's v6.5.8 case.)
                if (_src_ids_has(refs, lbuf + ns, fname_len) == 1) {
                    called = called + 1;
                    covered_fns = covered_fns + 1;
                } else {
                    vec_push(miss_path, spath);
                    vec_push(miss_name, str_from_buf(lbuf + ns, fname_len));
                }
                if (xids != 0) {
                    if (_src_ids_has(xids, lbuf + ns, fname_len) == 1) {
                        xcalled = xcalled + 1;
                        xcovered_fns = xcovered_fns + 1;
                    } else {
                        vec_push(xmiss_path, spath);
                        vec_push(xmiss_name, str_from_buf(lbuf + ns, fname_len));
                    }
                }
            }
            pos = le + 1;
        }

        if (pub_fns == 0) { continue; }        # no public surface — omit from the per-file list
        total_files = total_files + 1;
        if (called > 0) { covered_files = covered_files + 1; }

        # Per-file line — pad the name column to a fixed width, guarding long names
        # (the old `22 - llen` went negative for e.g. `syscalls_linux_common.cyr`,
        # so the count ran into the name).
        var disp = str_data(path_basename(str_from(spath)));
        var dlen = strlen(disp);
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, disp, dlen);
        var pad = 34 - dlen;
        if (pad < 1) { pad = 1; }
        while (pad > 0) { sys_write(STDOUT_FD, " ", 1); pad = pad - 1; }
        fmt_int(called);
        sys_write(STDOUT_FD, "/", 1);
        fmt_int(pub_fns);
        if (xids == 0) { sys_write(STDOUT_FD, " fns\n", 5); }
        else {
            sys_write(STDOUT_FD, " fns, ", 6);
            fmt_int(xcalled);
            sys_write(STDOUT_FD, "/", 1);
            fmt_int(pub_fns);
            sys_write(STDOUT_FD, " executed\n", 10);
        }
    }

    var pct = 0;
    if (total_fns > 0) { pct = (covered_fns * 100) / total_fns; }
    println("");
    println("-- Summary --");
    if (full == 1) { sys_write(STDOUT_FD, "  Modules referenced: ", 22); }
    else           { sys_write(STDOUT_FD, "  Files referenced:   ", 22); }
    fmt_int(covered_files);
    sys_write(STDOUT_FD, "/", 1);
    fmt_int(total_files);
    println("");
    sys_write(STDOUT_FD, "  Functions referenced: ", 24);
    fmt_int(covered_fns);
    sys_write(STDOUT_FD, "/", 1);
    fmt_int(total_fns);
    sys_write(STDOUT_FD, " (", 2);
    fmt_int(pct);
    println("%)  [reference coverage — a floor, not a correctness proof]");
    # 6.7.10 (P5-B): the executed figure, and what the exec run did
    var xpct = 0;
    if (xids != 0) {
        if (total_fns > 0) { xpct = (xcovered_fns * 100) / total_fns; }
        sys_write(STDOUT_FD, "  Functions executed: ", 22);
        fmt_int(xcovered_fns);
        sys_write(STDOUT_FD, "/", 1);
        fmt_int(total_fns);
        sys_write(STDOUT_FD, " (", 2);
        fmt_int(xpct);
        println("%)  [execution coverage — entered at least once by a corpus run]");
        sys_write(STDOUT_FD, "  Corpus runs: ", 15);
        fmt_int(vec_len(xtests) + vec_len(xprog_files));
        sys_write(STDOUT_FD, " (", 2);
        fmt_int(vec_len(xtests));
        sys_write(STDOUT_FD, " .tcyr, ", 8);
        fmt_int(vec_len(xprog_files));
        sys_write(STDOUT_FD, " program(s)), ", 14);
        fmt_int(xfailed);
        println(" failed");
    }

    # ⛔ v6.5.8: MEASURING NOTHING IS NOT PASSING. This printed a `note:` and returned 0,
    # so `cyrius coverage --min 80` in a directory with no sources — a mistyped path, a CI
    # job with the wrong working directory — reported a percentage computed from an empty
    # set and exited GREEN. Same green-placebo shape as `capacity` at v6.4.73. An empty
    # measurement is a failed measurement, with or without --min.
    if (total_fns == 0) {
        _err_ctx("no public functions found — nothing was measured, so this is not a pass; check the path", root);
        return 1;
    }
    # 6.7.10 (P5-B): under --exec, --min gates the EXECUTED percentage — the number the mode exists for
    var gpct = pct;
    if (xids != 0) { gpct = xpct; }
    var gate_fail = 0;
    if (min_pct >= 0) { if (gpct < min_pct) { gate_fail = 1; } }
    # Name the misses under -v and whenever the gate fails: a failed gate with only a
    # percentage tells a project nothing about WHAT to cover. CHANGELOG [6.6.8]
    if (_verbose == 1 || (gate_fail == 1 && xids == 0)) { _cov_print_misses(miss_path, miss_name); }
    if (xids != 0 && (_verbose == 1 || gate_fail == 1)) { _covx_print_misses(xmiss_path, xmiss_name, kids); }
    if (per_entry == 1) {
        if (_cov_print_per_entry(corpus, ent_path, ent_off, ent_len, all_path, all_name) != 0) { return 1; }
    }
    var rc = 0;
    if (min_pct >= 0) {
        if (gate_fail == 1) {
            sys_write(STDERR_FD, "coverage gate FAILED: ", 22);
            fmt_int_fd(2, gpct);
            if (xids != 0) { sys_write(STDERR_FD, "% executed < --min ", 19); }
            else { sys_write(STDERR_FD, "% < --min ", 10); }
            fmt_int_fd(2, min_pct);
            sys_write(STDERR_FD, "%\n", 2);
            rc = 1;
        } else {
            sys_write(STDOUT_FD, "  gate OK: ", 11);
            fmt_int(gpct);
            if (xids != 0) { sys_write(STDOUT_FD, "% executed >= --min ", 20); }
            else { sys_write(STDOUT_FD, "% >= --min ", 11); }
            fmt_int(min_pct);
            println("%");
        }
    }
    # 6.7.10 (P5-B): a corpus run that failed fails the run — after the report, so every entry ran
    # and the figures are there to read
    if (xfailed > 0) {
        _progress_close();
        _err_count = _err_count + 1;
        sys_write(STDERR_FD, "error: coverage --exec: ", 24);
        fmt_int_fd(2, xfailed);
        sys_write(STDERR_FD, " of ", 4);
        fmt_int_fd(2, vec_len(xtests) + vec_len(xprog_files));
        var xfm = " corpus run(s) failed, each named above — the report is complete, the run is not a pass\n";
        sys_write(STDERR_FD, xfm, strlen(xfm));
        rc = 1;
    }
    return rc;
}

# The `.cyr` files cmd_coverage measures under `root`. A named root (src/, lib/, a callout)
# is walked WHOLE. Only the '.' fallback (a flat project with no src/) skips the vendored
# stdlib and generated bundles — and only its own TOP-LEVEL ./lib and ./dist; a lib/ deeper
# down is the project's code. CHANGELOG [6.6.8]
# 6.6.10: 0 (after naming it) when any directory under the root could not be listed — an
# unreadable subtree left the DENOMINATOR, which raised the percentage. CHANGELOG [6.6.10]
fn _cov_sources(root): i64 {
    var walked = vec_new();
    var failed = vec_new();
    if (streq(root, ".") == 1) {
        var ents = _cbt_list_dir(".", "coverage cannot measure it");
        if (ents == 0) { return 0; }
        var ei = 0;
        while (ei < vec_len(ents)) {
            var en = vec_get(ents, ei);
            ei = ei + 1;
            if (str_eq_cstr(en, "lib") == 1 || str_eq_cstr(en, "dist") == 1) { continue; }
            var full = path_join(str_from("."), en);
            if (is_dir(full) == 1 && is_symlink(full) == 0) { dir_walk_checked(full, walked, failed); }
            else { vec_push(walked, full); }
        }
    } else {
        dir_walk_checked(str_from(root), walked, failed);
    }
    if (_cov_unlisted(failed, "its sources were NOT measured") != 0) { return 0; }
    var srcs = vec_new();
    var wi = 0;
    while (wi < vec_len(walked)) {
        var wf = vec_get(walked, wi);
        if (str_ends_with(wf, ".cyr") == 1) { vec_push(srcs, wf); }
        wi = wi + 1;
    }
    return srcs;
}

# Name every directory in `failed` (a vec of Str) — "error: coverage: cannot list directory
# (<what>): <dir>" — and answer 1 when there was any, else 0. CHANGELOG [6.6.10]
fn _cov_unlisted(failed, what): i64 {
    var i = 0;
    while (i < vec_len(failed)) {
        var d = vec_get(failed, i);
        _progress_close();
        _err_count = _err_count + 1;
        sys_write(STDERR_FD, "error: coverage: cannot list directory: ", 40);
        sys_write(STDERR_FD, str_data(d), str_len(d));
        sys_write(STDERR_FD, " — ", 5);
        sys_write(STDERR_FD, what, strlen(what));
        sys_write(STDERR_FD, "\n", 1);
        i = i + 1;
    }
    if (vec_len(failed) > 0) { return 1; }
    return 0;
}

# The unreferenced public fns, one `  <source path>: <name>` per line.
fn _cov_print_misses(miss_path, miss_name): i64 {
    var nm = vec_len(miss_name);
    println("");
    sys_write(STDOUT_FD, "-- Unreferenced (", 17);
    fmt_int(nm);
    println(") --");
    var mi = 0;
    while (mi < nm) {
        var mp = vec_get(miss_path, mi);
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, mp, strlen(mp));
        sys_write(STDOUT_FD, ": ", 2);
        var mn = vec_get(miss_name, mi);
        sys_write(STDOUT_FD, str_data(mn), str_len(mn));
        println("");
        mi = mi + 1;
    }
    return 0;
}

# 6.6.17 (P5-A) — `--per-entry`: for each corpus entry (a .tcyr or a RUN program), the public fns
# it references — whole identifiers in its CODE, the rule the totals use, read from the entry's
# own slice of the blanked corpus.
fn _cov_print_per_entry(corpus, ent_path, ent_off, ent_len, all_path, all_name): i64 {
    println("");
    println("-- References by corpus entry --");
    var ei = 0;
    while (ei < vec_len(ent_path)) {
        var off = vec_get(ent_off, ei);
        var len = vec_get(ent_len, ei);
        var set = _src_ids_new(len);
        if (set == 0 || _src_ids_add_text(set, corpus + off, len) != 0) {
            _err("coverage: out of memory indexing a corpus entry");
            return 1;
        }
        var hit = vec_new();
        var fi = 0;
        while (fi < vec_len(all_name)) {
            var nm = vec_get(all_name, fi);
            if (_src_ids_has(set, str_data(nm), str_len(nm)) == 1) { vec_push(hit, fi); }
            fi = fi + 1;
        }
        var ep = vec_get(ent_path, ei);
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, ep, strlen(ep));
        sys_write(STDOUT_FD, ": ", 2);
        fmt_int(vec_len(hit));
        sys_write(STDOUT_FD, " of ", 4);
        fmt_int(vec_len(all_name));
        println(" public fns");
        var hi = 0;
        while (hi < vec_len(hit)) {
            var k = vec_get(hit, hi);
            var sp = vec_get(all_path, k);
            var sn = vec_get(all_name, k);
            sys_write(STDOUT_FD, "      ", 6);
            sys_write(STDOUT_FD, sp, strlen(sp));
            sys_write(STDOUT_FD, ": ", 2);
            sys_write(STDOUT_FD, str_data(sn), str_len(sn));
            println("");
            hi = hi + 1;
        }
        ei = ei + 1;
    }
    return 0;
}

# A corpus program is a TEST, not measured surface: drop every source path (a vec of Str) that
# names one of `progs` (normalized cstrs).
fn _cov_drop_corpus(srcs, progs): i64 {
    var out = vec_new();
    var i = 0;
    while (i < vec_len(srcs)) {
        var sp = vec_get(srcs, i);
        i = i + 1;
        var np = _test_norm(str_data(sp));
        var keep = 1;
        var j = 0;
        while (j < vec_len(progs)) {
            if (streq(vec_get(progs, j), np) == 1) { keep = 0; }
            j = j + 1;
        }
        if (keep == 1) { vec_push(out, sp); }
    }
    return out;
}

fn _cov_has_wild(p): i64 {
    var i = 0;
    while (load8(p + i) != 0) {
        if (load8(p + i) == 42 || load8(p + i) == 63) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Shell-glob match of cstr `s` against `pat`: `*` is any run and `?` any one byte, NEITHER crossing
# a `/` (so `programs/*_test.cyr` does not reach programs/sub/). 1 or 0.
fn _cov_glob(pat, s): i64 {
    var pi = 0;
    var si = 0;
    var sp = 0 - 1;
    var ss = 0 - 1;
    while (load8(s + si) != 0) {
        var pc = load8(pat + pi);
        var sc = load8(s + si);
        if (pc == 42) {
            sp = pi;
            ss = si;
            pi = pi + 1;
            continue;
        }
        if (pc != 0 && (pc == sc || (pc == 63 && sc != 47))) {
            pi = pi + 1;
            si = si + 1;
            continue;
        }
        if (sp >= 0 && load8(s + ss) != 47) {
            ss = ss + 1;
            si = ss;
            pi = sp + 1;
            continue;
        }
        return 0;
    }
    while (load8(pat + pi) == 42) { pi = pi + 1; }
    if (load8(pat + pi) == 0) { return 1; }
    return 0;
}

fn _cov_cstr_cmp(a, b): i64 {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return ca - cb; }
        if (ca == 0) { return 0; }
        i = i + 1;
    }
    return 0;
}

fn _cov_push_unique(v, p): i64 {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), p) == 1) { return 0; }
        i = i + 1;
    }
    vec_push(v, p);
    return 1;
}

# Files under `dir` matching `pat`, descending at most `depth` more directory levels (a `*` never
# crosses a `/`, so the pattern's own `/` count bounds the walk). 0, or 1 after naming a directory
# that could not be listed.
fn _cov_glob_walk(dir, depth, pat, out): i64 {
    var ents = _cbt_list_dir(dir, "its programs were NOT read");
    if (ents == 0) { return 1; }
    var i = 0;
    while (i < vec_len(ents)) {
        var nm = str_data(vec_get(ents, i));
        i = i + 1;
        var full = nm;
        if (streq(dir, ".") == 0) { full = make_path(dir, nm); }
        if (is_dir(str_from(full)) == 1) {
            if (depth > 0 && is_symlink(str_from(full)) == 0) {
                if (_cov_glob_walk(full, depth - 1, pat, out) != 0) { return 1; }
            }
        } elif (_cov_glob(pat, full) == 1) {
            _cov_push_unique(out, full);
        }
    }
    return 0;
}

# 6.6.17 (P5-A): the RUN programs a list of globs names, sorted and de-duplicated. A literal path
# must be a file; a glob must match at least one — either miss is a named failure (0), because a
# typo'd glob would otherwise drop the whole programs corpus and the percentage with it.
# `key` names the list in the messages: "programs" (text) or "exec" (6.7.10).
fn _cov_expand_programs(pats, key): i64 {
    var out = vec_new();
    var i = 0;
    while (i < vec_len(pats)) {
        var pat = _test_norm(vec_get(pats, i));
        i = i + 1;
        if (_cov_has_wild(pat) == 0) {
            if (file_exists(pat) == 0 || is_dir(str_from(pat)) == 1) {
                var nsp = _cat2(_cat2("coverage: no such program (--", key), " / [coverage] ");
                _err_ctx(_cat2(_cat2(nsp, key), ")"), pat);
                return 0;
            }
            _cov_push_unique(out, pat);
            continue;
        }
        # the literal directory before the first wildcard, and how many `/` follow it
        var w = 0;
        while (load8(pat + w) != 42 && load8(pat + w) != 63) { w = w + 1; }
        var cut = 0 - 1;
        var k = 0;
        while (k < w) {
            if (load8(pat + k) == 47) { cut = k; }
            k = k + 1;
        }
        var dir = ".";
        if (cut > 0) {
            dir = alloc(cut + 1);
            memcpy(dir, pat, cut);
            store8(dir + cut, 0);
        }
        var depth = 0;
        k = cut + 1;
        while (load8(pat + k) != 0) {
            if (load8(pat + k) == 47) { depth = depth + 1; }
            k = k + 1;
        }
        var m = vec_new();
        if (is_dir(str_from(dir)) == 1) {
            if (_cov_glob_walk(dir, depth, pat, m) != 0) { return 0; }
        }
        if (vec_len(m) == 0) {
            _err_ctx(_cat2(_cat2("coverage: this ", key), " glob matches no file"), pat);
            return 0;
        }
        var mi = 0;
        while (mi < vec_len(m)) {
            _cov_push_unique(out, vec_get(m, mi));
            mi = mi + 1;
        }
    }
    vec_sort_by(out, &_cov_cstr_cmp);
    return out;
}

# ================================================================
# 6.7.10 (P5-B) — EXECUTION COVERAGE: `cyrius coverage --exec[=<glob>]` / `[coverage] exec`
# ================================================================
# The compiler half is the CYRIUS_COVERAGE=1 mode (src/frontend/parse_cov.cyr): every fn body bumps
# its own counter, and the program appends `# cyrius-coverage 1` and one `<count> <file>:<line>
# <name>` per fn it entered (`- <file>:<line> <name>` for a #naked fn, which is not instrumented) to
# CYRIUS_COVERAGE_FILE when it leaves through the top level or an exit syscall with a constant
# number. This half builds each corpus entry in that mode with a dump file of its own, runs it, and
# reads the dump. A run can leave no record — an asm exit, a runtime-variable exit number, an exec,
# an open the program's own sandbox denies — and one that exits 0 with no record FAILS by name: a
# silent zero would read as unexecuted code (the fail-open class 6.6.10 closed). The dump records
# counts; only hit-ness is read (a forked child's block repeats its parent's counts).
var _covx_xsb = 0;    # the executed fns' names, one per line (a str_builder)
var _covx_ksb = 0;    # the #naked fns' names: reported "not instrumented", never counted

# 1 when this `cyrius coverage` runs in the exec mode: `--exec` (with or without a glob), or a
# non-empty `[coverage] exec`. Asked by the AUTO_DEPS chain (cbt/cyrius.cyr) so an exec run gets
# the [deps] prepend its builds need, and a text run resolves nothing, as before. A malformed
# manifest or `[coverage] exec` answers 0 here, naming nothing (`_mf_probe`); the coverage branch
# names either where it reads it, as 6.7.9 did.
fn _covx_wanted(): i64 {
    if (_cli_has("--exec") == 1) { return 1; }
    if (_mf_probe() != 1) { return 0; }
    var mx = _mf_strs("coverage", "exec");
    if (_toml_bad == 1) {
        _toml_bad = 0;
        return 0;
    }
    if (mx == 0) { return 0; }
    if (vec_len(mx) == 0) { return 0; }
    return 1;
}

# The exec mode's program globs: `--exec=<glob>` (repeatable) beats `[coverage] exec`, the one
# precedence every key follows. Answers 0 for the text mode (no `--exec`, no `[coverage] exec`), a
# vec (empty for a bare `--exec` with no manifest list: the .tcyr corpus alone), or -1 after naming
# a manifest that cannot be read or an `exec` that is not a glob or a list of globs.
# ⚠ With no `--exec`, a manifest that cannot be read is the TEXT mode, named nothing: the only way
# here without one is `--programs` (the coverage branch reads the manifest first otherwise, and
# names it), and 6.7.9 read no manifest there — `cyrius coverage --programs <glob>` printed its
# report on a broken cyrius.cyml, and the user's decision keeps the text mode as it was. The exec
# mode, which resolves [deps] from the manifest, still names it. CHANGELOG [6.7.10]
fn _covx_resolve(): i64 {
    var xv = _cli_values("--exec");
    if (vec_len(xv) > 0) { return xv; }
    if (_cli_has("--exec") == 0) {
        if (_mf_probe() < 0) { return 0; }
    }
    if (_mf_load() < 0) { return 0 - 1; }
    var mx = _mf_strs("coverage", "exec");
    if (_toml_bad == 1) {
        _cfg_bad("coverage", "exec", "a glob or an array of globs");
        return 0 - 1;
    }
    if (mx != 0) {
        if (vec_len(mx) > 0) { return mx; }
    }
    if (_cli_has("--exec") == 1) { return vec_new(); }
    return 0;
}

# `<tmp>/cov_<n>` — the dump file of the run's n-th entry.
fn _covx_dump_path(n): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "cov_");
    str_builder_add_int(sb, n);
    return _cbt_tmpfile(str_data(str_builder_build(sb)));
}

fn _covx_fail(path, why): i64 {
    sys_write(STDERR_FD, "  FAIL: ", 8);
    sys_write(STDERR_FD, path, strlen(path));
    sys_write(STDERR_FD, why, strlen(why));
    sys_write(STDERR_FD, "\n", 1);
    return 1;
}

# The exec run's two refusals before anything is built, for a run of `total` entries: nothing to
# run, and a dump path longer than the compiler reads (CYRIUS_COVERAGE_FILE goes through a 255-byte
# buffer, and a longer value is refused there; the longest path is the last entry's). Asked by
# `_covx_preflight`, ahead of the resolve, and by `_covx_run`. 0, or 1 after naming it.
fn _covx_total_ok(total): i64 {
    if (total == 0) {
        var nm = "coverage --exec: nothing to run — no tests/**/*.tcyr and no --exec / [coverage] exec program;";
        _err(_cat2(nm, " nothing was executed, so this is not a pass"));
        return 1;
    }
    var lp = _covx_dump_path(total);
    if (strlen(lp) > 255) {
        var lm = "coverage --exec: the coverage dump path is over 255 bytes, more than the compiler reads from";
        _err_ctx(_cat2(lm, " CYRIUS_COVERAGE_FILE; set TMPDIR to a shorter directory"), lp);
        return 1;
    }
    return 0;
}

# How many tests/**/*.tcyr the exec run will build: the files cmd_coverage's walk collects.
fn _covx_tcyr_count(): i64 {
    if (is_dir(str_from("tests")) != 1) { return 0; }
    var tests = vec_new();
    var tfail = vec_new();
    dir_walk_checked(str_from("tests"), tests, tfail);
    var n = 0;
    var i = 0;
    while (i < vec_len(tests)) {
        if (str_ends_with(vec_get(tests, i), ".tcyr") == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# ── the coverage verb's arguments ─────────────────────────────────────────────────────────────
# Read and checked ONCE, by whichever asks first: the coverage branch (cbt/cyrius.cyr), or, in the
# exec mode, `_covx_preflight` ahead of the resolve. So each refusal and each [coverage] warning
# is printed once, whichever path reached it. CHANGELOG [6.7.10]
var _cov_a_state = 0 - 1;   # -1 not read yet; else `_cov_args`' answer
var _cov_a_min = 0 - 1;     # --min's percentage; -1 = no gate
var _cov_a_progs = 0;       # the TEXT corpus's program globs (a vec), or 0
var _cov_a_x = 0;           # the exec mode's program globs (`_covx_resolve`); 0 = the text mode

# 0, or 1 after naming the refusal.
fn _cov_args(): i64 {
    if (_cov_a_state < 0) { _cov_a_state = _cov_args_read(); }
    return _cov_a_state;
}

fn _cov_args_read(): i64 {
    if (_cli_operands_ok("coverage", 0, 1) == 0) { return 1; }
    if (_cli_has("--min") == 1) {
        _cov_a_min = _cli_int(_cli_val("--min"));
        # 0..100 only. v6.6.5 (round-3 review): a negative value is the "no gate"
        # sentinel inside cmd_coverage, so `--min -1` (or a typo'd `--min -5`)
        # switched the gate OFF and exited 0 — the typo-passes-a-gate class
        # _cli_int was added to close. 6.6.4's atoi behaved the same.
        if (_cli_int_ok == 0 || _cov_a_min < 0 || _cov_a_min > 100) {
            _err_ctx("coverage: --min needs a percentage from 0 to 100", _cli_val("--min"));
            return 1;
        }
    }
    # 6.6.17 (P5-A): RUN programs join the corpus — `--programs <glob>` (repeatable) beats
    # `[coverage] programs` in ./cyrius.cyml, the one precedence every key follows.
    _cov_a_progs = _cli_values("--programs");
    if (vec_len(_cov_a_progs) == 0) {
        if (_mf_load() < 0) { return 1; }
        _cfg_warn_section("coverage");
        _cov_a_progs = _mf_strs("coverage", "programs");
        if (_toml_bad == 1) {
            _cfg_bad("coverage", "programs", "a glob or an array of globs");
            return 1;
        }
    }
    # 6.7.10 (P5-B): EXECUTION coverage — `--exec[=<glob>]` (repeatable) beats `[coverage] exec`;
    # 0 = the text mode, untouched. The exec mode builds the .tcyr in the test scope (cmd_test),
    # as `cyrius test` does; its programs build in the build scope (_covx_prog).
    _cov_a_x = _covx_resolve();
    if (_cov_a_x < 0) { return 1; }
    if (_cov_a_x != 0) {
        if (_tc_setup("test") != 0) { return 1; }
    }
    return 0;
}

# 6.7.10 — THE EXEC MODE'S REFUSALS COME BEFORE THE RESOLVE. In its exec mode `coverage` joins the
# AUTO_DEPS chain, so main() vendors lib/ and writes cyrius.lock before the coverage branch runs; a
# glob that matched nothing was named only after both were written (6.7.6's rule R closed that for
# run / build / test). `_cli_preflight` asks this first: the arguments (`_cov_args`: the operand
# count, --min, [coverage], [test]), then the operand (a directory), both program lists' globs,
# nothing to run and the dump path's length — every refusal cmd_coverage would name before its
# first build. Each answers the same when cmd_coverage repeats it, silently. 0, or 1 after naming.
fn _covx_preflight(): i64 {
    if (_cov_args() != 0) { return 1; }
    if (_cov_a_x == 0) { return 0; }
    var ra = _cli_pos_at(0);
    if (ra != 0) {
        if (is_dir(str_from(ra)) != 1) {
            _err_ctx("not a directory", ra);
            return 1;
        }
    }
    if (_cov_a_progs != 0) {
        if (vec_len(_cov_a_progs) > 0) {
            if (_cov_expand_programs(_cov_a_progs, "programs") == 0) { return 1; }
        }
    }
    var nx = 0;
    if (vec_len(_cov_a_x) > 0) {
        var xf = _cov_expand_programs(_cov_a_x, "exec");
        if (xf == 0) { return 1; }
        nx = vec_len(xf);
    }
    return _covx_total_ok(_covx_tcyr_count() + nx);
}

# Build and run every corpus entry instrumented — each .tcyr, then each exec program — and gather
# the fns their dumps record. Every entry runs whatever the others did. Answers the number of
# failed runs (each named as it happened), or -1 after naming why nothing could run.
fn _covx_run(tests, progs): i64 {
    _covx_xsb = str_builder_new();
    _covx_ksb = str_builder_new();
    if (_covx_total_ok(vec_len(tests) + vec_len(progs)) != 0) { return 0 - 1; }
    var failed = 0;
    var n = 0;
    var i = 0;
    while (i < vec_len(tests)) {
        n = n + 1;
        failed = failed + _covx_entry(vec_get(tests, i), 1, n);
        i = i + 1;
    }
    i = 0;
    while (i < vec_len(progs)) {
        n = n + 1;
        failed = failed + _covx_entry(vec_get(progs, i), 0, n);
        i = i + 1;
    }
    return failed;
}

# One corpus entry: its dump created fresh (0600, ours, `O_EXCL`: the program only appends to it),
# the entry built in the coverage mode and run — a .tcyr through `cmd_test` whole (the test scope,
# [test], the timeout, the assert-summary grade, the FAIL wording), a program through `_covx_prog`
# — then the dump read and removed. 0 when it passed and left a record, else 1 (named).
fn _covx_entry(path, is_test, n): i64 {
    var dp = _covx_dump_path(n);
    sys_unlink(dp);
    var fd = sys_open(dp, O_WRONLY | O_CREAT | O_EXCL, 0x180);
    if (fd < 0) {
        _err_ctx("coverage --exec cannot create the run's coverage dump", dp);
        return _covx_fail(path, " (not run)");
    }
    sys_close(fd);
    _covx_dump = dp;
    var rc = 0;
    if (is_test == 1) { rc = cmd_test(path); }
    else { rc = _covx_prog(path); }
    _covx_dump = 0;
    var hdr = _covx_read(dp);
    sys_unlink(dp);
    if (rc != 0) { return 1; }
    if (hdr == 1) { return 0; }
    var nr = " (exited 0 but left no coverage record: an asm exit, a runtime-variable exit number, an exec,";
    return _covx_fail(path, _cat2(nr, " or an open the program's sandbox denied)"));
}

# An exec program, in the BUILD scope (as `cyrius run`: no [test] modules / defines / stdlib), run
# with its stdout captured and shown only when it fails. 0 when it exited 0, else 1 (named in
# `cyrius test`'s words).
fn _covx_prog(path): i64 {
    var ts = _test_scope;
    _test_scope = 0;
    var r = _covx_prog_run(path);
    _test_scope = ts;
    return r;
}

fn _covx_prog_run(path): i64 {
    var bin = _cbt_tmpexe("covx_bin");
    var pre_err = _err_count;
    if (compile(path, bin) != 0) {
        sys_write(STDERR_FD, "  FAIL: ", 8);
        sys_write(STDERR_FD, path, strlen(path));
        if (_compile_fail_verdict(pre_err, STDERR_FD, ": compile error") == 1) {
            var nc = " (not compiled; see the error above)\n";
            sys_write(STDERR_FD, nc, strlen(nc));
        }
        sys_unlink(bin);
        return 1;
    }
    var cap = _cbt_tmpfile("covx_out");
    sys_unlink(cap);
    var cfd = sys_open(cap, O_WRONLY | O_CREAT | O_EXCL, 0x180);
    if (cfd < 0) {
        _err_ctx("coverage --exec cannot capture the program's output", cap);
        sys_unlink(bin);
        return _covx_fail(path, " (not run)");
    }
    sys_close(cfd);
    _run_stdout_to = cap;
    var ec = run_binary_timed(bin, _run_timeout_ms(), 0);
    _run_stdout_to = 0;
    sys_unlink(bin);
    var clen = 0;
    var cbuf = file_read_whole(cap, &clen);
    sys_unlink(cap);
    if (ec == 0) { return 0; }
    if (cbuf != 0 && clen > 0) { sys_write(STDOUT_FD, cbuf, clen); }
    _test_fail_exit(path, ec);
    return 1;
}

# Read one dump: every record after a `# cyrius-coverage 1` header joins the name sets
# (`_covx_record`). 1 when a header was there, else 0 (no file, an empty one, or no header).
fn _covx_read(path): i64 {
    var n = 0;
    var b = file_read_whole(path, &n);
    if (b == 0) { return 0; }
    var hdr = 0;
    var p = 0;
    while (p < n) {
        var e = p;
        while (e < n && load8(b + e) != 10) { e = e + 1; }
        if (e - p == 19 && memeq(b + p, "# cyrius-coverage 1", 19) == 1) { hdr = 1; }
        elif (hdr == 1) { _covx_record(b + p, e - p); }
        p = e + 1;
    }
    return hdr;
}

# One record r[0, n): `<count> <file>:<line> <name>` (a count >= 1) or `- <file>:<line> <name>`.
# ONLY the NAME field (the last one) joins a set: the whole line would add `src`, `shapes` and
# `cyr` from the path, and a fn named like a path component would read as executed. The entry's
# own fns (`<source>`) and the compiler's (`__cyrius_*`, closures `__cl*`) are not measured
# surface; a generic instance or an async body counts for its fn — the name is cut at its first
# `$` (`gen$f64` -> gen, `f$impl` -> f). 1 when a name was added, else 0.
fn _covx_record(r, n): i64 {
    var naked = 0;
    var f = 0;
    if (n > 0 && load8(r) == 45) {
        naked = 1;
        f = 1;
    } else {
        if (n == 0 || load8(r) < 49 || load8(r) > 57) { return 0; }
        while (f < n && load8(r + f) >= 48 && load8(r + f) <= 57) { f = f + 1; }
    }
    if (f >= n || load8(r + f) != 32) { return 0; }
    var fs = f + 1;
    if (n - fs >= 9 && memeq(r + fs, "<source>:", 9) == 1) { return 0; }
    var ls = n;
    while (ls > fs && load8(r + ls - 1) != 32) { ls = ls - 1; }
    if (ls <= fs) { return 0; }
    var nm = r + ls;
    var nl = n - ls;
    if (nl >= 9 && memeq(nm, "__cyrius_", 9) == 1) { return 0; }
    if (nl >= 4 && memeq(nm, "__cl", 4) == 1) { return 0; }
    var k = 0;
    while (k < nl && load8(nm + k) != 36) { k = k + 1; }
    if (k == 0) { return 0; }
    var sb = _covx_xsb;
    if (naked == 1) { sb = _covx_ksb; }
    str_builder_add(sb, str_new(nm, k));
    str_builder_add_cstr(sb, "\n");
    return 1;
}

# The name set of one builder's lines (the identifier set text coverage asks, `_src_ids_*`); each
# line is ONE name, added whole — never re-tokenised, so a name holding a byte outside an
# identifier cannot lend its parts to another fn. 0 when out of memory.
fn _covx_ids(sb): i64 {
    var s = str_builder_build(sb);
    if (s == 0) { return 0; }
    var b = str_data(s);
    var n = str_len(s);
    var set = _src_ids_new(n);
    if (set == 0) { return 0; }
    var p = 0;
    while (p < n) {
        var e = p;
        while (e < n && load8(b + e) != 10) { e = e + 1; }
        if (e > p) {
            if (_src_ids_add(set, b + p, e - p) != 0) { return 0; }
        }
        p = e + 1;
    }
    return set;
}

# The public fns no corpus run entered, one `  <source path>: <name>` per line; a #naked one (its
# body is not instrumented, so it can never read as entered) says so.
fn _covx_print_misses(miss_path, miss_name, kids): i64 {
    var nm = vec_len(miss_name);
    println("");
    sys_write(STDOUT_FD, "-- Unexecuted (", 15);
    fmt_int(nm);
    println(") --");
    var nk = "  (#naked: not instrumented)";
    var mi = 0;
    while (mi < nm) {
        var mp = vec_get(miss_path, mi);
        var mn = vec_get(miss_name, mi);
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, mp, strlen(mp));
        sys_write(STDOUT_FD, ": ", 2);
        sys_write(STDOUT_FD, str_data(mn), str_len(mn));
        if (_src_ids_has(kids, str_data(mn), str_len(mn)) == 1) { sys_write(STDOUT_FD, nk, strlen(nk)); }
        println("");
        mi = mi + 1;
    }
    return 0;
}

# ================================================================
# Native doctest: extract # >>> / # === patterns, compile, run
# ================================================================
# v6.6.6 (bite 26b) — write a doc example to its temp source, to completion. 0 = every
# byte landed, -1 = it did not. See the call site for what a short write used to score.
fn _dt_write_all(fd, buf, len): i64 {
    var off = 0;
    while (off < len) {
        var w = syscall(1, fd, buf + off, len - off);
        if (w <= 0) { return 0 - 1; }
        off = off + w;
    }
    return 0;
}

fn cmd_doctest(arg): i64 {
    if (arg == 0) {
        println("Usage: cyrius doctest <file.cyr>");
        return 1;
    }
    # ⛔ 6.6.8: the WHOLE file. This read into a fixed 64 KiB buffer and never checked for
    # truncation, so every example past the cut silently did not exist — neither run nor
    # counted — and the verdict was over the head of the file only. CHANGELOG [6.6.8]
    var fn_read = 0;
    var fbuf = file_read_whole(arg, &fn_read);
    if (fbuf == 0) {
        sys_write(STDERR_FD, "error: cannot read ", 19);
        sys_write(STDERR_FD, arg, strlen(arg));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }

    var dt_pass = 0;
    var dt_fail = 0;
    var dt_total = 0;
    # v6.5.19 — `_DT_CODE_CAP` and the two guards below. Both memcpys into `code` were
    # unbounded: a doc example longer than the buffer wrote past the end of an 8 KB heap
    # region from ordinary (if unusual) source. Same class as the three unbounded copies
    # the 2026-07-27 audit found, and noticed while fixing the auto-prepend in this
    # function. Overflowing an example is reported as a failed doc test rather than
    # silently truncated, so the count stays honest.
    var _DT_CODE_CAP = 8192;
    var code = alloc(_DT_CODE_CAP);
    var code_len = 0;
    var in_example = 0;
    var line_num = 0;
    var dt_over = 0;

    var pos = 0;
    while (pos < fn_read) {
        # Read one line
        var ls = pos;
        while (pos < fn_read) {
            if (load8(fbuf + pos) == 10) { pos = pos + 1; break; }
            pos = pos + 1;
        }
        var le = pos;
        if (le > ls) { if (load8(fbuf + le - 1) == 10) { le = le - 1; } }
        line_num = line_num + 1;
        var ll = le - ls;

        if (ll >= 6) {
            if (memeq(fbuf + ls, "# >>> ", 6) == 1) {
                # New or continuation example line
                var snippet = fbuf + ls + 6;
                var slen = ll - 6;
                if (in_example == 0) { code_len = 0; dt_over = 0; }
                if (code_len + slen + 2 > _DT_CODE_CAP) { dt_over = 1; in_example = 1; continue; }
                memcpy(code + code_len, snippet, slen);
                code_len = code_len + slen;
                store8(code + code_len, 10);
                code_len = code_len + 1;
                in_example = 1;
                continue;
            }
        }
        if (ll >= 6) {
            if (memeq(fbuf + ls, "# === ", 6) == 1) {
                if (in_example == 1 && dt_over == 1) {
                    dt_total = dt_total + 1;
                    dt_fail = dt_fail + 1;
                    sys_write(STDERR_FD, "  FAIL: ", 8);
                    sys_write(STDERR_FD, arg, strlen(arg));
                    sys_write(STDERR_FD, ":", 1);
                    fmt_int_fd(STDERR_FD, line_num);
                    sys_write(STDERR_FD, " (doc example exceeds the ", 26);
                    fmt_int_fd(STDERR_FD, _DT_CODE_CAP);
                    sys_write(STDERR_FD, "-byte example buffer)\n", 22);
                    code_len = 0;
                    in_example = 0;
                    dt_over = 0;
                    continue;
                }
                if (in_example == 1) {
                    # Parse expected exit code
                    var exp_str = fbuf + ls + 6;
                    var expected = atoi(exp_str);
                    store8(code + code_len, 0);
                    dt_total = dt_total + 1;

                    # Write code to temp file, compile, run
                    var tmpf = _cbt_tmpfile("dt_src");
                    var fd = syscall(2, tmpf, 0x241, 0x1A4);
                    # ⛔ v6.6.6 (bite 26b) — the same unchecked-temp-source shape as
                    # `_materialize_source`, one verb over. `fd < 0` fell through with NO
                    # else, so a doctest whose temp could not be created was counted in
                    # `dt_total` and in neither `dt_pass` nor `dt_fail` — and the verdict
                    # is `dt_fail > 0`, so `cyrius doctest` exited 0 with the example never
                    # run. A short write was worse: the example was TRUNCATED and whatever
                    # the prefix happened to compile to was scored against the expected
                    # exit code. Both are failures now, by name. CHANGELOG [6.6.6].
                    var dt_wrote = 0 - 1;
                    if (fd >= 0) {
                        dt_wrote = _dt_write_all(fd, code, code_len);
                        syscall(3, fd);
                        if (dt_wrote != 0) {
                            _err_ctx("doctest: could not write the example's temp source", tmpf);
                            dt_fail = dt_fail + 1;
                            sys_unlink(tmpf);
                        }
                    } else {
                        _err_ctx("doctest: cannot create the example's temp source", tmpf);
                        dt_fail = dt_fail + 1;
                    }
                    if (dt_wrote == 0) {
                        var tmpbin = _cbt_tmpexe("dt_bin");
                        if (compile(tmpf, tmpbin) == 0) {
                            var ec = run_binary_timed(tmpbin, _run_timeout_ms(), 0);
                            if (ec == expected) {
                                dt_pass = dt_pass + 1;
                            } else {
                                sys_write(STDERR_FD, "  FAIL: ", 8);
                                sys_write(STDERR_FD, arg, strlen(arg));
                                sys_write(STDERR_FD, ":", 1);
                                fmt_int_fd(STDERR_FD, line_num);
                                sys_write(STDERR_FD, " (expected ", 11);
                                fmt_int_fd(STDERR_FD, expected);
                                sys_write(STDERR_FD, ", got ", 6);
                                fmt_int_fd(STDERR_FD, ec);
                                sys_write(STDERR_FD, ")\n", 2);
                                dt_fail = dt_fail + 1;
                            }
                            sys_unlink(tmpbin);
                        } else {
                            sys_write(STDERR_FD, "  FAIL: ", 8);
                            sys_write(STDERR_FD, arg, strlen(arg));
                            sys_write(STDERR_FD, ":", 1);
                            fmt_int_fd(STDERR_FD, line_num);
                            sys_write(STDERR_FD, " (compile error)\n", 17);
                            dt_fail = dt_fail + 1;
                        }
                        sys_unlink(tmpf);
                    }
                }
                code_len = 0;
                in_example = 0;
                continue;
            }
        }
        # Non-matching line ends example
        if (in_example == 1) {
            if (ll >= 2) {
                if (memeq(fbuf + ls, "# ", 2) == 1) {
                    # Continuation comment line
                    var snippet = fbuf + ls + 2;
                    var slen = ll - 2;
                    if (code_len + slen + 2 > _DT_CODE_CAP) { dt_over = 1; continue; }
                    memcpy(code + code_len, snippet, slen);
                    code_len = code_len + slen;
                    store8(code + code_len, 10);
                    code_len = code_len + 1;
                    continue;
                }
            }
            code_len = 0;
            in_example = 0;
        }
    }

    println("");
    fmt_int(dt_pass);
    sys_write(STDOUT_FD, " passed, ", 9);
    fmt_int(dt_fail);
    sys_write(STDOUT_FD, " failed (", 9);
    fmt_int(dt_total);
    println(" total doc tests)");
    if (dt_fail > 0) { return 1; }
    return 0;
}

# ================================================================
# Native header: scan the public fn declarations, emit C prototypes
# ================================================================
# The offset of the first `)` at bracket depth 0 in b[p, lim) — with `comma` 1, of the first
# depth-0 `,` too — else lim; `( [ {` balance `) ] }`. cmd_header's parameter walk: since
# 6.7.7 a parameter may carry a default, and `fn f(a, b = g(1, 2))` cut at the first `)` / `,`
# lost parameters and printed `cyr_val b = 2` (not C). Strings are blanked by then, so
# `s = ",)"` is one parameter too. CHANGELOG [6.7.7]
# 6.7.11 — a parameter's TYPE balances `<` `>` too (`>>` / `>>>` close two / three, a byte
# each), as the compiler's _pl_next / _pl_tdepth do: `p: Pair<i64, i64>` was cut at its comma
# and printed `cyr_val i64>` (not C). After the parameter's depth-0 `=` (its default) `<` and
# `>` are operators again (`c = 1 < 2`), and a depth-0 `,` starts the next parameter's type.
# CHANGELOG [6.7.11]
fn _hdr_close(b, p, lim, comma): i64 {
    var d = 0;
    var indf = 0;    # 1 inside the current parameter's default (after its depth-0 `=`)
    while (p < lim) {
        var c = load8(b + p);
        if (c == 40 || c == 91 || c == 123) { d = d + 1; }
        elif (c == 41 || c == 93 || c == 125) {
            if (d == 0) { if (c == 41) { return p; } }
            else { d = d - 1; }
        }
        elif (c == 44) {
            if (d == 0) {
                if (comma == 1) { return p; }
                indf = 0;
            }
        }
        elif (c == 61) { if (d == 0) { indf = 1; } }
        elif (indf == 0) {
            if (c == 60) { d = d + 1; }
            elif (c == 62) { if (d > 0) { d = d - 1; } }
        }
        p = p + 1;
    }
    return lim;
}

# 1 iff b[s, e) is exactly `...` — a variadic tail's parameter name (cmd_header). CHANGELOG [6.7.11]
fn _hdr_is_ellipsis(b, s, e): i64 {
    if (e - s != 3) { return 0; }
    return memeq(b + s, "...", 3);
}

# 1 iff the parameter list b[s, e) is only `...` (blanks around it) — a fully variadic fn,
# whose C prototype is `(void)` (cmd_header). CHANGELOG [6.7.11]
fn _hdr_only_ellipsis(b, s, e): i64 {
    while (s < e) {
        var c = load8(b + s);
        if (c != 32 && c != 9) { break; }
        s = s + 1;
    }
    while (e > s) {
        var c2 = load8(b + e - 1);
        if (c2 != 32 && c2 != 9) { break; }
        e = e - 1;
    }
    return _hdr_is_ellipsis(b, s, e);
}

# ================================================================
# 6.7.11 — THE RETURN TYPE. cmd_header never read past the parameter list's `)`, so every
# prototype said `cyr_val f(..)` whatever the fn returned. cycc returns a value five ways
# (`_ret_agg_class`, src/frontend/parse_fn.cyr; the multi-value landing, `_mret_land`):
#   8 bytes or less; a 9-16 B `Str`        rax / x0: a word (a Str is a handle), `cyr_val`
#   9-16 bytes, and a `dyn Tr`             rax:rdx / x0:x1: `cyr_val2`, the two-int64-word struct
#                                          SysV and AAPCS64 C return in the same registers; Win64 C
#                                          returns it through a hidden pointer, so `#ifndef _WIN64`
#                                          (a named comment there, no prototype — user, 2026-10-13)
#   over 16 bytes                          the hidden result pointer, integer argument 0 (SysV rdi,
#                                          Win64 rcx) / AAPCS64 x8, left in rax / x0, N whole words
#                                          written: `cyr_valN` returned by value, as C does
#   two values `(T1, T2)`                  rax:rdx / aarch64 x0:x2 — C's pair only on x86_64 SysV:
#                                          `cyr_val2` under `__x86_64__ && !_WIN64`, else a comment
#   three values                           rax:rdx:r8 / x0:x2:x3 — no C return type: refused
# A type this scanner cannot size — another file's, a generic instance, a struct holding one, a
# struct declared twice or whose fields sit under a preprocessor conditional — is refused by name
# on stderr: no prototype, rc 1 (never guessed). Field widths are the compiler's (FIELDSZ /
# STRUCTSZ, src/frontend/parse_types.cyr): packed; i8/u8 1, i16/u16 2, i32/u32/f32 4, a tuple 8
# per element, a dyn 16, a nested struct its size, a union its widest field, every other field 8
# (a `Str` FIELD and a `Vec<T>` FIELD are their 8-byte handle; a bare `Vec` FIELD is the file's
# own `struct Vec` when one is declared above it, else the 8-byte handle).
# header_spellings_and_size.sh H8 holds them to `sizeof` compiled by cycc, H11 the x86_64
# registers to a linked C caller. CHANGELOG [6.7.11]
# ================================================================
# The file's depth-0 struct / union / enum names: a vec of records, `_HDR_REC` words each —
#   +0 name offset, +8 name length, +16 kind (1 struct, 2 union, 3 enum), +24 the body's `{` (-1
#   none), +32 1 = generic (`struct B<T>`), +40 the size memo (-1 unsized, -2 being sized, -3
#   unsizable), +48 how many times the name is declared, +56 why it is unsizable, +64 / +72 the
#   offending type text, +80 1 = an enum declared `: stack` (6.7.12).
var _HDR_REC = 88;
var _hdr_decls = 0;
var _hdr_why = 0;        # why the last sizing failed, and the type text it failed at
var _hdr_why_s = 0;
var _hdr_why_e = 0;
var _hdr_tend = 0;       # the end of the type just read by _hdr_type_size
var _hdr_rsz = 0;        # the size of the return just classified, and its type text
var _hdr_rts = 0;
var _hdr_rte = 0;
var _hdr_pair_done = 0;  # the cyr_val2 typedef is written
var _hdr_words_done = 0; # vec: each N whose cyr_valN typedef is written
var _hdr_raw = 0;        # the file before _src_blank_noncode: its `#ifdef` lines are still there

# First offset in [p, lim) that is not a space, tab, CR or newline.
fn _hdr_ws_nl(b, p, lim): i64 {
    while (p < lim) {
        var c = load8(b + p);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        p = p + 1;
    }
    return p;
}

# 1 iff buf[p, p+n) is the word `w` (wn bytes).
fn _hdr_is(b, p, n, w, wn): i64 {
    if (n != wn) { return 0; }
    return memeq(b + p, w, wn);
}

# Offset just past the `<..>` opening at buf[p] (each `<` / `>` byte one level, as `>>` is two).
fn _hdr_skip_targs(b, p, lim): i64 {
    var d = 0;
    while (p < lim) {
        var c = load8(b + p);
        if (c == 60) { d = d + 1; }
        elif (c == 62) { d = d - 1; if (d == 0) { return p + 1; } }
        elif (c == 59 || c == 123 || c == 125) { return p; }
        p = p + 1;
    }
    return lim;
}

# The number of elements of the tuple type whose `(` is at buf[p]; _hdr_tend = past its `)`.
fn _hdr_tuple_n(b, p, lim): i64 {
    var d = 0;
    var k = 1;
    while (p < lim) {
        var c = load8(b + p);
        if (c == 40 || c == 60 || c == 91) { d = d + 1; }
        elif (c == 41 || c == 62 || c == 93) {
            d = d - 1;
            if (d == 0) { _hdr_tend = p + 1; return k; }
        }
        elif (c == 44 && d == 1) { k = k + 1; }
        p = p + 1;
    }
    _hdr_tend = lim;
    return k;
}

# The record of the depth-0 struct / union / enum named buf[p, p+n), or 0.
fn _hdr_decl_find(b, p, n): i64 {
    var i = 0;
    while (i < vec_len(_hdr_decls)) {
        var r = vec_get(_hdr_decls, i);
        if (load64(r + 8) == n) { if (memeq(b + load64(r), b + p, n) == 1) { return r; } }
        i = i + 1;
    }
    return 0;
}

# Record the declaration on the depth-0 line buf[ls, le) of keyword `kw` (kind `kind`), if any.
fn _hdr_decl_line(b, len, ls, le, kw, klen, kind): i64 {
    var ns = _src_kw_decl_at(b, ls, le, kw, klen);
    if (ns < 0) { return 0; }
    var ne = _src_ident_end(b, ns, le);
    var old = _hdr_decl_find(b, ns, ne - ns);
    if (old != 0) { store64(old + 48, load64(old + 48) + 1); return 1; }
    var r = alloc(_HDR_REC);
    store64(r, ns);
    store64(r + 8, ne - ns);
    store64(r + 16, kind);
    store64(r + 24, 0 - 1);
    store64(r + 32, 0);
    store64(r + 40, 0 - 1);
    store64(r + 48, 1);
    store64(r + 56, 0);
    store64(r + 80, 0);
    var q = _hdr_ws_nl(b, ne, len);
    if (q < len && load8(b + q) == 60) {
        store64(r + 32, 1);
        q = _hdr_ws_nl(b, _hdr_skip_targs(b, q, len), len);
    }
    # 6.7.12 — `enum E: stack {` (the value form: a payload variant returns a (tag, payload) pair).
    if (kind == 3 && q < len && load8(b + q) == 58) {
        var sw = _hdr_ws_nl(b, q + 1, len);
        var se = _src_ident_end(b, sw, len);
        if (_hdr_is(b, sw, se - sw, "stack", 5) == 1) { store64(r + 80, 1); }
        q = _hdr_ws_nl(b, se, len);
    }
    if (q < len && load8(b + q) == 123) { store64(r + 24, q); }
    vec_push(_hdr_decls, r);
    return 1;
}

# Pre-scan: every struct, union and enum the (blanked) file declares at brace depth 0.
fn _hdr_scan_decls(b, len): i64 {
    _hdr_decls = vec_new();
    var pos = 0;
    var depth = 0;
    while (pos < len) {
        var le = pos;
        while (le < len) { if (load8(b + le) == 10) { break; } le = le + 1; }
        if (depth == 0) {
            if (_hdr_decl_line(b, len, pos, le, "struct", 6, 1) == 0) {
                if (_hdr_decl_line(b, len, pos, le, "union", 5, 2) == 0) {
                    _hdr_decl_line(b, len, pos, le, "enum", 4, 3);
                }
            }
        }
        depth = depth + _src_brace_delta(b, pos, le);
        if (depth < 0) { depth = 0; }
        pos = le + 1;
    }
    return 0;
}

# A sizing failure: `why` about the type text buf[s, e). Returns -1.
fn _hdr_fail(why, s, e): i64 {
    _hdr_why = why;
    _hdr_why_s = s;
    _hdr_why_e = e;
    return 0 - 1;
}
# ... recorded on the struct record `r` too, so a later ask answers the same. Returns -1.
fn _hdr_rec_fail(r): i64 {
    store64(r + 40, 0 - 3);
    store64(r + 56, _hdr_why);
    store64(r + 64, _hdr_why_s);
    store64(r + 72, _hdr_why_e);
    return 0 - 1;
}

# The width of the scalar / handle type name buf[p, p+n) as a FIELD (the compiler's
# `_tn_scalar` / `_field_name_kind`), or 0 when it is none of them.
fn _hdr_name_w(b, p, n): i64 {
    if (_hdr_is(b, p, n, "u8", 2) == 1) { return 1; }
    if (_hdr_is(b, p, n, "u16", 3) == 1) { return 2; }
    if (_hdr_is(b, p, n, "u32", 3) == 1) { return 4; }
    if (_hdr_is(b, p, n, "f32", 3) == 1) { return 4; }
    if (_hdr_is(b, p, n, "u64", 3) == 1) { return 8; }
    if (_hdr_is(b, p, n, "f64", 3) == 1) { return 8; }
    if (_hdr_is(b, p, n, "bool", 4) == 1) { return 8; }
    if (_hdr_is(b, p, n, "cstring", 7) == 1) { return 8; }
    if (_hdr_is(b, p, n, "Result", 6) == 1) { return 8; }
    if (_hdr_is(b, p, n, "Option", 6) == 1) { return 8; }
    if (_hdr_is(b, p, n, "Tagged", 6) == 1) { return 8; }
    return 0;
}
# 1 iff buf[p, p+n) is `Result`, `Option` or `Tagged`: as a RETURN, the stdlib's value form — a
# `: stack` enum's (tag, payload) pair (lib/result.cyr, lib/tagged.cyr; as a field each is its
# 8-byte word, _hdr_name_w). CHANGELOG [6.7.12]
fn _hdr_stack_name(b, p, n): i64 {
    if (_hdr_is(b, p, n, "Result", 6) == 1) { return 1; }
    if (_hdr_is(b, p, n, "Option", 6) == 1) { return 1; }
    if (_hdr_is(b, p, n, "Tagged", 6) == 1) { return 1; }
    return 0;
}

# i8 / i16 / i32 / i64, which the compiler reads before any struct of that name.
fn _hdr_int_w(b, p, n): i64 {
    if (_hdr_is(b, p, n, "i8", 2) == 1) { return 1; }
    if (_hdr_is(b, p, n, "i16", 3) == 1) { return 2; }
    if (_hdr_is(b, p, n, "i32", 3) == 1) { return 4; }
    if (_hdr_is(b, p, n, "i64", 3) == 1) { return 8; }
    return 0;
}

# 1 iff buf[p, p+n) names a SIMD vector type (the twelve: 128-bit and 256-bit). A vector return is
# refused by name (6.7.12, D24): no C11 return type carries one — a C vector type is a compiler
# extension or an intrinsics header, which the header's own -std=c11 -pedantic-errors rows refuse
# — and cycc's convention differs from C's by width and target (a PE result pointer; two registers
# for a 32-byte vector). It printed `cyr_val`, which C reads from rax / x0. CHANGELOG [6.7.12]
fn _hdr_vec_name(b, p, n): i64 {
    if (n != 5) { return 0; }
    var v = "f64v2f64v4f32v4f32v8i32v4u32v4i16v8u16v8i64v2u64v2i8v16u8v16";
    var i = 0;
    while (i < 60) {
        if (memeq(b + p, v + i, 5) == 1) { return 1; }
        i = i + 5;
    }
    return 0;
}

# The byte size of the field type at buf[p] (after its `:`), the compiler's FIELDSZ; -1 when this
# scanner cannot size it (_hdr_fail). _hdr_tend = the end of the type.
fn _hdr_type_size(b, len, p, depth): i64 {
    p = _hdr_ws_nl(b, p, len);
    _hdr_tend = p;
    if (p >= len) { return _hdr_fail("a field type this scanner cannot read", p, p); }
    var c = load8(b + p);
    if (c == 42) {                           # `*T`: a pointer, 8
        while (p < len && load8(b + p) == 42) { p = p + 1; }
        p = _src_ident_end(b, _hdr_ws_nl(b, p, len), len);
        var pq = _hdr_ws_nl(b, p, len);
        if (pq < len && load8(b + pq) == 60) { p = _hdr_skip_targs(b, pq, len); }
        _hdr_tend = p;
        return 8;
    }
    if (c == 40) { return _hdr_tuple_n(b, p, len) * 8; }   # a tuple: 8 per element
    var ie = _src_ident_end(b, p, len);
    if (ie == p) { return _hdr_fail("a field type this scanner cannot read", p, p + 1); }
    var n = ie - p;
    _hdr_tend = ie;
    if (_hdr_is(b, p, n, "dyn", 3) == 1) {   # a trait object: two words
        _hdr_tend = _src_ident_end(b, _hdr_ws_nl(b, ie, len), len);
        return 16;
    }
    var w = _hdr_int_w(b, p, n);
    if (w > 0) { return w; }
    var q = _hdr_ws_nl(b, ie, len);
    var targs = 0;
    if (q < len && load8(b + q) == 60) { targs = 1; _hdr_tend = _hdr_skip_targs(b, q, len); }
    # `Vec<T>` is its 8-byte handle; a bare `Vec` is the file's own `struct Vec` when one is declared
    # ABOVE the field (the compiler's FINDSTRUCT there), else the handle. CHANGELOG [6.7.11]
    # Declared BELOW the field, cycc refuses it (D10 (b)), so no size is guessed. CHANGELOG [6.7.13]
    if (_hdr_is(b, p, n, "Vec", 3) == 1) {
        if (targs == 1) { return 8; }
        var rv = _hdr_decl_find(b, p, n);
        if (rv == 0) { return 8; }
        if (load64(rv + 16) == 3) { return 8; }   # an enum `Vec`: cycc's field is the handle
        if (load64(rv) > p) { return _hdr_fail("the file's own struct Vec declared below its use, which cycc refuses", p, ie); }
    }
    if (_hdr_is(b, p, n, "Str", 3) == 1) { return 8; }   # a Str FIELD is its handle
    if (targs == 1) { return _hdr_fail("a generic struct instance, which this scanner cannot size", p, _hdr_tend); }
    var r = _hdr_decl_find(b, p, n);
    if (r != 0) {
        if (load64(r + 16) == 3) { return 8; }             # an enum
        var te = _hdr_tend;
        var sz = _hdr_rec_size(b, len, r, depth + 1);
        _hdr_tend = te;
        return sz;
    }
    w = _hdr_name_w(b, p, n);
    if (w > 0) { return w; }
    return _hdr_fail("a type not declared in this file, which this scanner cannot size", p, ie);
}

# 1 iff the raw line at _hdr_raw[p] (its first non-blank byte) is a conditional directive: `#if`,
# `#ifdef`, `#ifndef`, `#ifplat`, `#elif`, `#elseif`, `#else`, `#endif` or `#endplat`, a word.
fn _hdr_cond_line(p, lim): i64 {
    p = _src_skip_ws(_hdr_raw, p, lim);
    if (p >= lim || load8(_hdr_raw + p) != 35) { return 0; }
    var ws = p + 1;
    var we = _src_ident_end(_hdr_raw, ws, lim);
    var n = we - ws;
    var w = "if     ifdef  ifndef ifplat elif   elseif else   endif  endplat";
    var i = 0;
    while (i < 63) {
        var k = 0;
        while (k < 7 && load8(w + i + k) != 32) { k = k + 1; }
        if (k == n) { if (memeq(_hdr_raw + ws, w + i, n) == 1) { return 1; } }
        i = i + 7;
    }
    return 0;
}

# 1 iff a line inside the struct body whose `{` is at b[open] holds a conditional directive: the
# preprocessor keeps one arm, the scanner (reading comments blanked) would sum both.
fn _hdr_body_cond(b, len, open): i64 {
    var close = open;
    while (close < len && load8(b + close) != 125) { close = close + 1; }
    var p = open;
    while (p < close) {
        if (load8(_hdr_raw + p) == 10) {
            var le = p + 1;
            while (le < len && load8(_hdr_raw + le) != 10) { le = le + 1; }
            if (_hdr_cond_line(p + 1, le) == 1) { return 1; }
        }
        p = p + 1;
    }
    return 0;
}

# The packed size of the struct / union record `r`, or -1 (_hdr_fail; recorded on `r`).
fn _hdr_rec_size(b, len, r, depth): i64 {
    var memo = load64(r + 40);
    if (memo >= 0) { return memo; }
    if (memo == 0 - 3) {
        _hdr_fail(load64(r + 56), load64(r + 64), load64(r + 72));
        return 0 - 1;
    }
    var ns = load64(r);
    var ne = ns + load64(r + 8);
    if (memo == 0 - 2 || depth > 64) { _hdr_fail("a struct that contains itself", ns, ne); return _hdr_rec_fail(r); }
    if (load64(r + 48) > 1) {
        _hdr_fail("declared more than once in this file, which this scanner cannot size", ns, ne);
        return _hdr_rec_fail(r);
    }
    if (load64(r + 32) == 1) {
        _hdr_fail("a generic struct, which this scanner cannot size", ns, ne);
        return _hdr_rec_fail(r);
    }
    var p = load64(r + 24);
    if (p < 0) { _hdr_fail("a struct whose body this scanner cannot find", ns, ne); return _hdr_rec_fail(r); }
    if (_hdr_body_cond(b, len, p) == 1) {
        _hdr_fail("a struct whose fields sit under a preprocessor conditional, which this scanner cannot size", ns, ne);
        return _hdr_rec_fail(r);
    }
    store64(r + 40, 0 - 2);
    var uni = 0;
    if (load64(r + 16) == 2) { uni = 1; }
    var sz = 0;
    p = p + 1;
    while (1 == 1) {
        p = _hdr_ws_nl(b, p, len);
        if (p >= len) { _hdr_fail("a struct whose body does not close", ns, ne); return _hdr_rec_fail(r); }
        var c = load8(b + p);
        if (c == 125) { break; }
        if (c == 59) { p = p + 1; continue; }
        var fe = _src_ident_end(b, p, len);
        if (fe == p) { _hdr_fail("a struct whose fields this scanner cannot read", ns, ne); return _hdr_rec_fail(r); }
        p = _hdr_ws_nl(b, fe, len);
        var fsz = 8;                          # an untyped field
        if (p < len && load8(b + p) == 58) {
            fsz = _hdr_type_size(b, len, p + 1, depth);
            if (fsz < 0) { return _hdr_rec_fail(r); }
            p = _hdr_tend;
        }
        if (uni == 1) { if (fsz > sz) { sz = fsz; } }
        else { sz = sz + fsz; }
    }
    store64(r + 40, sz);
    return sz;
}

# The return class of the type at buf[p] (just past the return's `:`), as `_ret_agg_class`:
# 0 a word, 1 the rax:rdx / x0:x1 pair, 2 through the hidden pointer (`_hdr_rsz` its size), 3 two
# values (rax:rdx / x0:x2), 4 a `: stack` enum's (tag, payload) pair (rax:rdx / x0:x2 — 6.7.12),
# -1 refused (_hdr_why). Sets _hdr_rts / _hdr_rte to the type's text.
fn _hdr_ret_class(b, len, p): i64 {
    p = _hdr_ws_nl(b, p, len);
    _hdr_rts = p;
    _hdr_rte = p;
    _hdr_rsz = 8;
    if (p >= len) { return 0; }
    var c = load8(b + p);
    if (c == 42) { _hdr_rte = _src_ident_end(b, _hdr_ws_nl(b, p + 1, len), len); return 0; }   # `*T`
    if (c == 40) {                           # a multi-value return: each value a word
        var k = _hdr_tuple_n(b, p, len);
        _hdr_rte = _hdr_tend;
        _hdr_rsz = k * 8;
        if (k == 2) { return 3; }
        if (k == 3) {
            var w3 = "three values, returned in rax:rdx:r8 (aarch64 x0:x2:x3), which no C return type carries";
            return _hdr_fail(w3, p, _hdr_rte);
        }
        return _hdr_fail("a multi-value return of other than two values, which no C return type carries", p, _hdr_rte);
    }
    var ie = _src_ident_end(b, p, len);
    _hdr_rte = ie;
    if (ie == p) { return _hdr_fail("a return type this scanner cannot read", p, p + 1); }
    var n = ie - p;
    if (_hdr_is(b, p, n, "dyn", 3) == 1) {   # a trait object: {data, vtable}
        _hdr_rte = _src_ident_end(b, _hdr_ws_nl(b, ie, len), len);
        _hdr_rsz = 16;
        return 1;
    }
    var q = _hdr_ws_nl(b, ie, len);
    if (q < len && load8(b + q) == 60) {
        _hdr_rte = _hdr_skip_targs(b, q, len);
        return _hdr_fail("a generic struct instance, which this scanner cannot size", p, _hdr_rte);
    }
    var str = _hdr_is(b, p, n, "Str", 3);
    var r = _hdr_decl_find(b, p, n);
    if (r != 0) {
        if (load64(r + 16) == 3) {
            if (load64(r + 80) == 1) { _hdr_rsz = 16; return 4; }   # a `: stack` enum: the pair
            return 0;                                      # a plain enum: a word
        }
        var sz = _hdr_rec_size(b, len, r, 0);
        if (sz < 0) { return 0 - 1; }
        _hdr_rsz = sz;
        if (sz > 16) { return 2; }
        if (sz > 8 && str == 0) { return 1; }              # `Str` alone of 9-16 B is a word
        return 0;
    }
    if (str == 1) { return 0; }                            # lib/str.cyr's: a 16-byte handle, a word
    if (_hdr_int_w(b, p, n) > 0) { return 0; }
    if (_hdr_stack_name(b, p, n) == 1) { _hdr_rsz = 16; return 4; }   # 6.7.12: the stdlib's pair
    if (_hdr_name_w(b, p, n) > 0) { return 0; }
    if (_hdr_vec_name(b, p, n) == 1) {
        return _hdr_fail("a SIMD vector return, which no C11 return type carries", p, ie);
    }
    return _hdr_fail("a type not declared in this file, which this scanner cannot size", p, ie);
}

# The return class of the fn whose parameter list starts at buf[ps] (just past its `(`): the
# annotation after the list's own `)`, which may sit on a later line. 0 when there is none.
fn _hdr_ret_of(b, len, ps): i64 {
    var rc = _hdr_close(b, ps, len, 0);
    if (rc >= len) { return 0; }
    var q = _hdr_ws_nl(b, rc + 1, len);
    if (q >= len) { return 0; }
    if (load8(b + q) != 58) { return 0; }
    return _hdr_ret_class(b, len, q + 1);
}

# Name the refused fn on stderr: its return type and why. 1.
fn _hdr_refuse(b, ns, nl): i64 {
    sys_write(STDERR_FD, "error: cyrius header: '", 23);
    sys_write(STDERR_FD, b + ns, nl);
    sys_write(STDERR_FD, "' returns '", 11);
    sys_write(STDERR_FD, b + _hdr_rts, _hdr_rte - _hdr_rts);
    sys_write(STDERR_FD, "': ", 3);
    # A failure inside the struct (a field's type) names that type; the struct itself is the return.
    var rl = _hdr_rte - _hdr_rts;
    var same = 0;
    if (_hdr_why_e - _hdr_why_s == rl) { same = memeq(b + _hdr_why_s, b + _hdr_rts, rl); }
    if (same == 0) {
        sys_write(STDERR_FD, "its field type '", 16);
        sys_write(STDERR_FD, b + _hdr_why_s, _hdr_why_e - _hdr_why_s);
        sys_write(STDERR_FD, "' is ", 5);
    }
    sys_write(STDERR_FD, _hdr_why, strlen(_hdr_why));
    var t = "; no prototype written\n";
    sys_write(STDERR_FD, t, strlen(t));
    return 1;
}

# The cyr_val2 typedef, once, before its first use.
fn _hdr_pair_typedef(): i64 {
    if (_hdr_pair_done == 1) { return 0; }
    _hdr_pair_done = 1;
    println("#ifndef _WIN64");
    println("/* A struct of 9-16 bytes and a `dyn Tr` come back in TWO registers, rax:rdx (SysV) /");
    println("   x0:x1 (AAPCS64), as C returns a struct of two int64 words; Win64 C returns one through");
    println("   a hidden pointer, so those fns have no prototype there. A two-value return, and a");
    println("   `: stack` enum's (Result, Option) tag in w0 and payload in w1, are rax:rdx on x86_64");
    println("   but x0:x2 on aarch64: their prototypes are x86_64 SysV only. */");
    println("typedef struct { int64_t w0, w1; } cyr_val2;");
    println("#endif");
    return 0;
}

# The guard a two-register prototype sits under: the pair (rk 1) everywhere but Win64, two values
# (rk 3) and a `: stack` enum's pair (rk 4) on x86_64 SysV alone (aarch64 lands them in x0:x2).
fn _hdr_guard_open(rk): i64 {
    if (rk == 3 || rk == 4) { println("#if defined(__x86_64__) && !defined(_WIN64)"); }
    else { println("#ifndef _WIN64"); }
    return 0;
}

# The cyr_valN typedef (N words), once per N, before its first use.
fn _hdr_words_typedef(nw): i64 {
    if (_hdr_words_done == 0) {
        _hdr_words_done = vec_new();
        println("/* A struct over 16 bytes comes back through a hidden result pointer (SysV rdi,");
        println("   AAPCS64 x8, Win64 rcx), as C returns a struct of that size: cyr_valN is N words. */");
    }
    var i = 0;
    while (i < vec_len(_hdr_words_done)) {
        if (vec_get(_hdr_words_done, i) == nw) { return 0; }
        i = i + 1;
    }
    vec_push(_hdr_words_done, nw);
    sys_write(STDOUT_FD, "typedef struct { int64_t w[", 27);
    fmt_int(nw);
    sys_write(STDOUT_FD, "]; } cyr_val", 12);
    fmt_int(nw);
    sys_write(STDOUT_FD, ";\n", 2);
    return 0;
}

# The trailing comment of a pair / hidden-pointer prototype: `/* returns T, N B */` (a `: stack`
# enum's: `/* returns Result: the tag in w0, the payload in w1 */`).
fn _hdr_ret_note(b, rk): i64 {
    sys_write(STDOUT_FD, "   /* returns ", 14);
    sys_write(STDOUT_FD, b + _hdr_rts, _hdr_rte - _hdr_rts);
    if (rk == 4) {
        var tw = ": the tag in w0, the payload in w1 */";
        sys_write(STDOUT_FD, tw, strlen(tw));
        return 0;
    }
    sys_write(STDOUT_FD, ", ", 2);
    fmt_int(_hdr_rsz);
    sys_write(STDOUT_FD, " B", 2);
    if (rk == 2 && (_hdr_rsz & 7) != 0) {
        sys_write(STDOUT_FD, ", the callee writes ", 20);
        fmt_int((_hdr_rsz + 7) / 8);
        sys_write(STDOUT_FD, " words", 6);
    }
    sys_write(STDOUT_FD, " */", 3);
    return 0;
}

# The other arm of a two-register prototype's guard: a named comment, no prototype.
fn _hdr_guard_else(b, ns, nl, rk): i64 {
    println("#else");
    sys_write(STDOUT_FD, "/* ", 3);
    sys_write(STDOUT_FD, b + ns, nl);
    var t = ": no prototype on Win64 -- cycc returns its ";
    if (rk == 3 || rk == 4) { t = ": no prototype here -- cycc returns its "; }
    sys_write(STDOUT_FD, t, strlen(t));
    sys_write(STDOUT_FD, b + _hdr_rts, _hdr_rte - _hdr_rts);
    t = " in rax:rdx, where a Win64 C caller passes a hidden result pointer */";
    if (rk == 3) {
        t = " in x0:x2 on aarch64 (AAPCS64 C reads x0:x1), in rax:rdx on Win64 (C passes a hidden result pointer) */";
    }
    if (rk == 4) {
        var t4 = " (tag, payload) in x0:x2 on aarch64 (AAPCS64 C reads x0:x1),";
        sys_write(STDOUT_FD, t4, strlen(t4));
        t = " in rax:rdx on Win64 (C passes a hidden result pointer) */";
    }
    sys_write(STDOUT_FD, t, strlen(t));
    sys_write(STDOUT_FD, "\n", 1);
    println("#endif");
    return 0;
}

# ================================================================
# 6.7.12 — A `: stack` ENUM RETURN (D23, the user, 2026-10-15). A `: stack` enum's payload
# constructor (lib/result.cyr's Ok / Err, lib/tagged.cyr's Some / Left / Right, a file's own
# `enum E: stack { V(x); }`) returns a (tag, payload) PAIR — rax:rdx on x86_64, x0:x2 on aarch64
# (measured on pi and ecb: x1 is 0, x2 the payload), rax:rdx on Win64 — and so does every fn
# that returns one (`return Ok(x);`), or returns a call of such a fn (GFLG 256, the compiler's
# propagation, src/frontend/parse.cyr _pair_body_scan). An annotated `: Result` / `: Option` /
# `: Tagged` (or own stack enum) return is modelled as cyr_val2 (class 4, x86_64 SysV only);
# a fn whose signature says a word (none, or `: i64`) but whose body returns the pair is
# REFUSED by name — a source scanner cannot see a propagated pair from the signature, so it says
# so rather than print `cyr_val`. The propagation is a file-local fixpoint: the stack payload
# constructors (the stdlib's unless the file declares that name itself, the file's own), every
# fn classed 4, then each word-classed fn whose body has `return NAME(` / `return NAME<..>(` of
# one of them, to no change. A closure's body and a nested fn are skipped (their returns are
# their own). Not seen: a pair reached through another file's fn, or a method.
# 6.7.13 — the compiler's third route to GFLG 256: a `?` on a pair call (`v = parse(x)?;`) returns
# the callee's pair on its Err path, so the body also counts `NAME(..)?` / `NAME<..>(..)?` of one
# of them, in the same fixpoint (refused as `'parse(..)?'`). A closure's `?` is its own — a block
# or an expression body — and a method call's `?` is not seen, as a method return is not.
# CHANGELOG [6.7.13]
# ================================================================
var _hdr_pairs = 0;     # _src_ids set: the names whose call returns a stack enum's pair
# _hdr_fns: the file's depth-0 fns, _HDR_FN bytes each — +0 name off, +8 len, +16 body `{` (-1
# none), +24 its `}`, +32 return class, +40 / +48 the pair call that makes it pair-returning
# (len 0: none), +56 1 when that call is propagated by `?` (6.7.13).
var _hdr_fns = 0;
var _HDR_FN = 64;

# The offset of the matching `}` of the `{` at b[p] in the blanked buffer, or len.
fn _hdr_block_end(b, len, p): i64 {
    var d = 0;
    while (p < len) {
        var c = load8(b + p);
        if (c == 123) { d = d + 1; }
        elif (c == 125) {
            d = d - 1;
            if (d == 0) { return p; }
        }
        p = p + 1;
    }
    return len;
}

# The body `{` of the fn whose parameter list starts at b[ps]: the first `{` after the list's own
# `)` (the return type has none), or -1 when a `;` comes first (a declaration).
fn _hdr_body_open(b, len, ps): i64 {
    var p = _hdr_close(b, ps, len, 0);
    while (p < len) {
        var c = load8(b + p);
        if (c == 123) { return p; }
        if (c == 59) { return 0 - 1; }
        p = p + 1;
    }
    return 0 - 1;
}

# 1 iff the last non-blank byte before b[p] is a `|`: the `{` there opens a closure's body.
fn _hdr_after_pipe(b, p): i64 {
    var q = p - 1;
    while (q >= 0) {
        var c = load8(b + q);
        if (c != 32 && c != 9 && c != 10 && c != 13) { return c == 124; }
        q = q - 1;
    }
    return 0;
}

# The offset of the `)` matching the `(` at b[p] (`( [ {` balance `) ] }`; strings are blanked),
# or lim. A call's arguments: `<` / `>` are operators there, never brackets. CHANGELOG [6.7.13]
fn _hdr_paren_end(b, p, lim): i64 {
    var d = 0;
    while (p < lim) {
        var c = load8(b + p);
        if (c == 40 || c == 91 || c == 123) { d = d + 1; }
        elif (c == 41 || c == 93 || c == 125) {
            d = d - 1;
            if (d == 0) { return p; }
        }
        p = p + 1;
    }
    return lim;
}

# 1 iff the `|` at b[p] opens a closure's parameter list: the last non-blank byte before it starts
# an expression (`= ( , { } ; : [`), or ends the word `return`. A `|` after an operand is `|`,
# `||` or `|=`. CHANGELOG [6.7.13]
fn _hdr_closure_pipe(b, p): i64 {
    var q = p - 1;
    while (q >= 0) {
        var c = load8(b + q);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        q = q - 1;
    }
    if (q < 0) { return 1; }
    var pc = load8(b + q);
    if (pc == 61 || pc == 40 || pc == 44 || pc == 123 || pc == 125 || pc == 59 || pc == 58 || pc == 91) { return 1; }
    if (q >= 5 && memeq(b + q - 5, "return", 6) == 1) {
        if (q == 5) { return 1; }
        return 1 - _src_ident_char(load8(b + q - 6));
    }
    return 0;
}

# Past the closure whose parameter list opens at b[p]: a block body's `{` (the caller's
# `_hdr_after_pipe` steps over it), or the end of an expression body — its first depth-0 `;`, `,`
# or unmatched closer. CHANGELOG [6.7.13]
fn _hdr_closure_skip(b, p, close): i64 {
    var q = p + 1;
    while (q < close && load8(b + q) != 124) { q = q + 1; }
    q = _hdr_ws_nl(b, q + 1, close);
    if (q >= close || load8(b + q) == 123) { return q; }
    var d = 0;
    while (q < close) {
        var c = load8(b + q);
        if (c == 40 || c == 91 || c == 123) { d = d + 1; }
        elif (c == 41 || c == 93 || c == 125) {
            if (d == 0) { return q; }
            d = d - 1;
        }
        elif (d == 0 && (c == 59 || c == 44)) { return q; }
        q = q + 1;
    }
    return close;
}

# 1 when the pair call NAME at b[ns, ne) — `NAME(..)` / `NAME<..>(..)` — is followed by `?`: the
# `?` desugar returns the callee's pair on its Err path and marks the enclosing fn pair-returning
# (src/frontend/parse.cyr and parse_expr.cyr, the `?` lowering's SFLG 256). CHANGELOG [6.7.13]
fn _hdr_q_after(b, ne, close): i64 {
    var r = _hdr_ws_nl(b, ne, close);
    if (r < close && load8(b + r) == 60) { r = _hdr_ws_nl(b, _hdr_skip_targs(b, r, close), close); }
    if (r >= close || load8(b + r) != 40) { return 0; }
    var x = _hdr_ws_nl(b, _hdr_paren_end(b, r, close) + 1, close);
    if (x < close && load8(b + x) == 63) { return 1; }
    return 0;
}

# The pair call a fn body b(open, close) returns — `return NAME(` / `return NAME<..>(` with NAME
# in _hdr_pairs, or (6.7.13) `NAME(..)?` / `NAME<..>(..)?` anywhere in the body — as its name's
# offset (its length in _hdr_via_n; _hdr_via_q 1 for the `?` route), or -1. A closure's body
# (a block or an expression) and a nested fn are stepped over; a method call's `?` is not seen.
var _hdr_via_n = 0;
var _hdr_via_q = 0;
fn _hdr_body_pair(b, open, close): i64 {
    var p = open + 1;
    while (p < close) {
        var c = load8(b + p);
        if (c == 123 && _hdr_after_pipe(b, p) == 1) { p = _hdr_block_end(b, close, p) + 1; }
        elif (c == 124 && _hdr_closure_pipe(b, p) == 1) { p = _hdr_closure_skip(b, p, close); }
        elif (_src_ident_char(c) == 1 && (c < 48 || c > 57)) {
            var e = _src_ident_end(b, p, close);
            var lead = 1;
            if (p > 0) {
                var pc = load8(b + p - 1);
                if (_src_ident_char(pc) == 1 || pc == 46) { lead = 0; }
            }
            if (lead == 1 && _hdr_is(b, p, e - p, "fn", 2) == 1) {
                var q = e;
                while (q < close && load8(b + q) != 123 && load8(b + q) != 59) { q = q + 1; }
                if (q < close && load8(b + q) == 123) { e = _hdr_block_end(b, close, q) + 1; }
                else { e = q; }
            } elif (lead == 1 && _hdr_is(b, p, e - p, "return", 6) == 1) {
                var ns = _hdr_ws_nl(b, e, close);
                var ne = _src_ident_end(b, ns, close);
                if (ne > ns) {
                    var r = _hdr_ws_nl(b, ne, close);
                    if (r < close && load8(b + r) == 60) { r = _hdr_ws_nl(b, _hdr_skip_targs(b, r, close), close); }
                    if (r < close && load8(b + r) == 40) {
                        if (_src_ids_has(_hdr_pairs, b + ns, ne - ns) == 1) {
                            _hdr_via_n = ne - ns;
                            _hdr_via_q = 0;
                            return ns;
                        }
                    }
                }
            } elif (lead == 1 && _src_ids_has(_hdr_pairs, b + p, e - p) == 1) {
                if (_hdr_q_after(b, e, close) == 1) {
                    _hdr_via_n = e - p;
                    _hdr_via_q = 1;
                    return p;
                }
            }
            p = e;
        }
        else { p = p + 1; }
    }
    return 0 - 1;
}

# Add the payload variants of the `: stack` enum record `r` to _hdr_pairs (a member with a
# non-empty `(..)`; a nullary `None()` returns its tag alone), and every member of any enum to
# `own`, the names the file declares itself.
fn _hdr_enum_members(b, len, r, own): i64 {
    var p = load64(r + 24);
    if (p < 0) { return 0; }
    var close = _hdr_block_end(b, len, p);
    p = p + 1;
    var want = 1;
    while (p < close) {
        var c = load8(b + p);
        if (c == 59 || c == 44) { want = 1; p = p + 1; }
        elif (want == 1 && _src_ident_char(c) == 1 && (c < 48 || c > 57)) {
            var e = _src_ident_end(b, p, close);
            _src_ids_add(own, b + p, e - p);
            var q = _hdr_ws_nl(b, e, close);
            if (q < close && load8(b + q) == 40) {
                var qe = _hdr_close(b, q + 1, close, 0);
                var inner = _hdr_ws_nl(b, q + 1, qe);
                if (load64(r + 80) == 1 && inner < qe) { _src_ids_add(_hdr_pairs, b + p, e - p); }
                e = qe;
            }
            want = 0;
            p = e;
        }
        else {
            if (c != 32 && c != 9 && c != 10 && c != 13) { want = 0; }
            p = p + 1;
        }
    }
    return 0;
}

# The pre-pass: every depth-0 fn of the (blanked) file, its body and return class; the pair
# names; then the propagation to a fixpoint (each fn it reaches records the call it returns).
fn _hdr_pair_scan(b, len): i64 {
    _hdr_fns = vec_new();
    _hdr_pairs = _src_ids_new(len);
    var own = _src_ids_new(len);
    var pos = 0;
    var depth = 0;
    while (pos < len) {
        var le = pos;
        while (le < len) { if (load8(b + le) == 10) { break; } le = le + 1; }
        if (depth == 0) {
            var ns = _src_decl_at(b, pos, le);
            if (ns >= 0) {
                var nl = _src_ident_end(b, ns, le) - ns;
                var op = _src_skip_ws(b, ns + nl, le);
                # a generic fn gets no prototype, but a call of it is a pair like any other
                if (op < le && load8(b + op) == 60) { op = _src_skip_ws(b, _hdr_skip_targs(b, op, le), le); }
                if (op < le && load8(b + op) == 40) {
                    var f = alloc(_HDR_FN);
                    store64(f, ns);
                    store64(f + 8, nl);
                    var bo = _hdr_body_open(b, len, op + 1);
                    store64(f + 16, bo);
                    store64(f + 24, len);
                    if (bo >= 0) { store64(f + 24, _hdr_block_end(b, len, bo)); }
                    store64(f + 32, _hdr_ret_of(b, len, op + 1));
                    store64(f + 40, 0);
                    store64(f + 48, 0);
                    store64(f + 56, 0);
                    vec_push(_hdr_fns, f);
                    _src_ids_add(own, b + ns, nl);
                }
            }
        }
        depth = depth + _src_brace_delta(b, pos, le);
        if (depth < 0) { depth = 0; }
        pos = le + 1;
    }
    var i = 0;
    while (i < vec_len(_hdr_decls)) {
        var r = vec_get(_hdr_decls, i);
        if (load64(r + 16) == 3) { _hdr_enum_members(b, len, r, own); }
        i = i + 1;
    }
    var std = "Ok Err Some Left Right ";   # lib/result.cyr's, lib/tagged.cyr's payload constructors
    var sp = 0;
    while (load8(std + sp) != 0) {
        var se = sp;
        while (load8(std + se) != 32) { se = se + 1; }
        if (_src_ids_has(own, std + sp, se - sp) == 0) { _src_ids_add(_hdr_pairs, std + sp, se - sp); }
        sp = se + 1;
    }
    i = 0;
    while (i < vec_len(_hdr_fns)) {
        var f4 = vec_get(_hdr_fns, i);
        if (load64(f4 + 32) == 4) { _src_ids_add(_hdr_pairs, b + load64(f4), load64(f4 + 8)); }
        i = i + 1;
    }
    var changed = 1;
    while (changed == 1) {
        changed = 0;
        i = 0;
        while (i < vec_len(_hdr_fns)) {
            var g = vec_get(_hdr_fns, i);
            if (load64(g + 32) == 0 && load64(g + 48) == 0 && load64(g + 16) >= 0) {
                var via = _hdr_body_pair(b, load64(g + 16), load64(g + 24));
                if (via >= 0) {
                    store64(g + 40, via);
                    store64(g + 48, _hdr_via_n);
                    store64(g + 56, _hdr_via_q);
                    _src_ids_add(_hdr_pairs, b + load64(g), load64(g + 8));
                    changed = 1;
                }
            }
            i = i + 1;
        }
    }
    return 0;
}

# The depth-0 fn record named b[ns, ns+nl) that the propagation reached, or 0.
fn _hdr_prop_of(b, ns, nl): i64 {
    var i = 0;
    while (i < vec_len(_hdr_fns)) {
        var f = vec_get(_hdr_fns, i);
        if (load64(f) == ns && load64(f + 8) == nl) {
            if (load64(f + 48) > 0) { return f; }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# Name a refused propagated-pair fn on stderr: the call that makes it one. 1.
fn _hdr_refuse_prop(b, f): i64 {
    sys_write(STDERR_FD, "error: cyrius header: '", 23);
    sys_write(STDERR_FD, b + load64(f), load64(f + 8));
    var t = "' returns a `: stack` enum's (tag, payload) pair through '";
    sys_write(STDERR_FD, t, strlen(t));
    sys_write(STDERR_FD, b + load64(f + 40), load64(f + 48));
    t = "(..)', which its signature does not declare (cycc returns it in rax:rdx, aarch64 x0:x2); ";
    if (load64(f + 56) == 1) {
        t = "(..)?', which its signature does not declare (its `?` returns the Err pair, in rax:rdx, aarch64 x0:x2); ";
    }
    sys_write(STDERR_FD, t, strlen(t));
    t = "declare it `: Result`, `: Option` or `: Tagged`; no prototype written\n";
    sys_write(STDERR_FD, t, strlen(t));
    return 1;
}

# 6.7.13 — A SIMD VECTOR PARAMETER. cycc passes a vector by value in vector registers (xmm / v; a
# 32-byte vector in two, or by a PE convention of its own) while the prototype said `cyr_val v`,
# which a C caller passes in rdi / x0: the callee computed on whatever the vector register held.
# Refused by name as 6.7.12's D24 refuses a vector return (no C11 type carries one). A pointer (`*f64v2`)
# is a word and stays `cyr_val`. The parameter list b[ps, pe): 1 when a parameter's type is one of
# the twelve vector names (_hdr_vp_s / _hdr_vp_e its `name: type` text), else 0. CHANGELOG [6.7.13]
var _hdr_vp_s = 0;
var _hdr_vp_e = 0;
fn _hdr_vparam(b, ps, pe): i64 {
    var pi = ps;
    while (pi < pe) {
        pi = _hdr_ws_nl(b, pi, pe);
        var pend = _hdr_close(b, pi, pe, 1);
        var q = pi;
        while (q < pend && load8(b + q) != 58 && load8(b + q) != 61) { q = q + 1; }
        if (q < pend && load8(b + q) == 58) {
            var ts = _hdr_ws_nl(b, q + 1, pend);
            var te = _src_ident_end(b, ts, pend);
            if (te > ts && _hdr_vec_name(b, ts, te - ts) == 1) {
                _hdr_vp_s = pi;
                _hdr_vp_e = te;
                return 1;
            }
        }
        pi = pend + 1;
    }
    return 0;
}

# Name a fn refused for a vector parameter on stderr. 1.
fn _hdr_refuse_vparam(b, ns, nl): i64 {
    sys_write(STDERR_FD, "error: cyrius header: '", 23);
    sys_write(STDERR_FD, b + ns, nl);
    sys_write(STDERR_FD, "' takes '", 9);
    sys_write(STDERR_FD, b + _hdr_vp_s, _hdr_vp_e - _hdr_vp_s);
    var t = "': a SIMD vector parameter, which no C11 type carries; no prototype written\n";
    sys_write(STDERR_FD, t, strlen(t));
    return 1;
}

# 6.6.8: the PUBLIC SURFACE, the same rule cmd_coverage counts (_src_public_fn_at): every
# declaration spelling at brace depth 0, the file-scope `private` rule, `_`-prefixed names
# and the `main` entry point excluded. This
# matched only a column-0 `pub fn ` — its own comment said "pub fn or fn" — so a bare `fn`
# (public in an ordinary file) and `public fn` (the same token as `pub`) never got a
# prototype. And it read a fixed 64 KiB: an 81,752-byte file lost every fn past the cut
# with rc=0. It had no gate; tests/gates/toolchain/header_spellings_and_size.sh is it.
# CHANGELOG [6.6.8]
fn cmd_header(arg): i64 {
    if (arg == 0) {
        println("Usage: cyrius header <file.cyr>");
        return 1;
    }
    var hn = 0;
    var hbuf = file_read_whole(arg, &hn);
    if (hbuf == 0) {
        sys_write(STDERR_FD, "error: cannot read ", 19);
        sys_write(STDERR_FD, arg, strlen(arg));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    _hdr_raw = alloc(hn + 1);                # 6.7.11: a struct body's `#ifdef` lines (_hdr_body_cond)
    memcpy(_hdr_raw, hbuf, hn);
    # Declarations come from CODE only — a fn named in a comment or string is not one.
    _src_blank_noncode(hbuf, hn);
    var fpriv = _src_file_private(hbuf, hn);
    _hdr_scan_decls(hbuf, hn);               # 6.7.11: the structs a return type may name
    _hdr_pair_scan(hbuf, hn);                # 6.7.12: the fns that return a stack enum's pair
    _hdr_pair_done = 0;
    _hdr_words_done = 0;
    var refused = 0;

    println("/* Auto-generated by cyrius header -- do not edit */");
    println("#ifndef CYRIUS_FFI_H");
    println("#define CYRIUS_FFI_H");
    println("");
    println("#include <stdint.h>");
    println("");
    println("/* All Cyrius values are 64-bit integers */");
    println("typedef int64_t cyr_val;");
    println("");

    var pos = 0;
    var depth = 0;                            # brace depth: an `impl` method is not FFI surface
    while (pos < hn) {
        var ls = pos;
        while (pos < hn) {
            if (load8(hbuf + pos) == 10) { pos = pos + 1; break; }
            pos = pos + 1;
        }
        var le = pos;
        if (le > ls) { if (load8(hbuf + le - 1) == 10) { le = le - 1; } }

        var d0 = depth;
        depth = depth + _src_brace_delta(hbuf, ls, le);
        if (depth < 0) { depth = 0; }
        if (d0 != 0) { continue; }
        var fname_start = _src_public_fn_at(hbuf, ls, le, fpriv);
        if (fname_start < 0) { continue; }

        # Extract function name; its `(` must follow on the same line
        var fname_len = _src_ident_end(hbuf, fname_start, le) - fname_start;
        # A program's `fn main` is its entry point, not FFI surface — its prototype would
        # collide with the C host's own `int main`. CHANGELOG [6.6.8]
        if (_src_is_entry_fn(hbuf, fname_start, fname_len) == 1) { continue; }
        var ne = _src_skip_ws(hbuf, fname_start + fname_len, le);
        if (ne >= le) { continue; }
        if (load8(hbuf + ne) != 40) { continue; }

        # Extract params between ( and its own ) — a default holds parentheses (`b = f(1, 2)`), a
        # tuple parameter's type nests one (`t: (i64, i64)`). CHANGELOG [6.7.7]
        var ps = ne + 1;
        var pe = _hdr_close(hbuf, ps, le, 0);

        # 6.7.11 — the return type decides the prototype's (see _hdr_ret_class). CHANGELOG [6.7.11]
        var rk = _hdr_ret_of(hbuf, hn, ps);
        if (rk < 0) {
            refused = refused + _hdr_refuse(hbuf, fname_start, fname_len);
            continue;
        }
        # 6.7.12 (D23) — a word signature over a body that returns a stack enum's pair: refused.
        if (rk == 0) {
            var pf = _hdr_prop_of(hbuf, fname_start, fname_len);
            if (pf != 0) {
                refused = refused + _hdr_refuse_prop(hbuf, pf);
                continue;
            }
        }
        # 6.7.13 — a SIMD vector parameter: refused (see _hdr_vparam). CHANGELOG [6.7.13]
        if (_hdr_vparam(hbuf, ps, pe) == 1) {
            refused = refused + _hdr_refuse_vparam(hbuf, fname_start, fname_len);
            continue;
        }
        if (rk == 1 || rk == 3 || rk == 4) {
            _hdr_pair_typedef();
            _hdr_guard_open(rk);
            sys_write(STDOUT_FD, "cyr_val2 ", 9);
        } elif (rk == 2) {
            var nw = (_hdr_rsz + 7) / 8;
            _hdr_words_typedef(nw);
            sys_write(STDOUT_FD, "cyr_val", 7);
            fmt_int(nw);
            sys_write(STDOUT_FD, " ", 1);
        } else {
            sys_write(STDOUT_FD, "cyr_val ", 8);
        }
        sys_write(STDOUT_FD, hbuf + fname_start, fname_len);
        sys_write(STDOUT_FD, "(", 1);
        # 6.7.11 — a fully variadic `fn f(...)` is `(void)` in C: pre-C23 C refuses a bare
        # `(...)`, and the callee reads no argument (a cyrius variadic tail is never read:
        # tests/tcyr/lang/varargs.tcyr), so C passing none is the whole contract. CHANGELOG [6.7.11]
        var allva = _hdr_only_ellipsis(hbuf, ps, pe);
        if (pe == ps || allva == 1) {
            sys_write(STDOUT_FD, "void", 4);
        } else {
            # Count and emit params: the name, then its type and default skipped whole. A
            # defaulted parameter is still a parameter — C passes every argument.
            var pi = ps;
            var first = 1;
            while (pi < pe) {
                # Skip whitespace
                while (pi < pe) {
                    if (load8(hbuf + pi) != 32) { break; }
                    pi = pi + 1;
                }
                var pns = pi;
                while (pi < pe) {
                    var pc = load8(hbuf + pi);
                    if (pc == 44 || pc == 58 || pc == 61) { break; }
                    pi = pi + 1;
                }
                var pne = pi;
                # Trim trailing space
                while (pne > pns) {
                    if (load8(hbuf + pne - 1) != 32) { break; }
                    pne = pne - 1;
                }
                # Skip the type annotation and the default, to this parameter's own `,` — a tuple
                # type's commas are inside it, and a tuple parameter is one `cyr_val` (it travels as
                # an address). CHANGELOG [6.7.7]
                pi = _hdr_close(hbuf, pi, pe, 1);
                if (pne > pns) {
                    if (first == 0) { sys_write(STDOUT_FD, ", ", 2); }
                    # 6.7.11 — a variadic tail is C's `...` alone (it printed `cyr_val ...`, not
                    # C). The extras C passes are never read by the callee. CHANGELOG [6.7.11]
                    if (_hdr_is_ellipsis(hbuf, pns, pne) == 0) { sys_write(STDOUT_FD, "cyr_val ", 8); }
                    sys_write(STDOUT_FD, hbuf + pns, pne - pns);
                    first = 0;
                }
                # Skip comma
                if (pi < pe) { if (load8(hbuf + pi) == 44) { pi = pi + 1; } }
            }
        }
        if (allva == 1) { sys_write(STDOUT_FD, "); /* variadic in cyrius: it reads no argument */", 49); }
        else { sys_write(STDOUT_FD, ");", 2); }
        if (rk > 0) { _hdr_ret_note(hbuf, rk); }
        sys_write(STDOUT_FD, "\n", 1);
        if (rk == 1 || rk == 3 || rk == 4) { _hdr_guard_else(hbuf, fname_start, fname_len, rk); }
    }

    println("");
    println("#endif /* CYRIUS_FFI_H */");
    if (refused > 0) { return 1; }   # each one named on stderr above (6.7.11)
    return 0;
}

fn cmd_repl(): i64 {
    var script = make_path(_scripts_dir, "shims/cyrius-repl.sh");
    if (file_exists(script) == 0) {
        script = make_path(_scripts_dir, "cyrius-repl.sh");
    }
    return run_script(script, _cc, 0);
}

