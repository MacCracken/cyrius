# ================================================================
# Native coverage — REFERENCE coverage: for each public `fn` in the scanned
# source tree, is its name referenced anywhere in the tests/tcyr corpus? This is
# a floor against UNWATCHED code, not a line/branch-coverage or correctness proof
# (a mirror-style suite that re-implements rather than calls still "references"
# the symbol — that is intentional: reference coverage is meaningful for both
# linked and mirror suites, which is why it does not need the linked-vs-mirror
# line-coverage distinction).
#
# v6.4.72 (issue 2026-07-23-hoosh-coverage-reports-stdlib-not-local-repo):
#   cyrius coverage           -> the PROJECT's OWN sources (src/, recursive) — the
#                                new default. Was `lib/` (the VENDORED stdlib), so
#                                a downstream project got a number about the stdlib,
#                                not itself ("Functions: 0/1097", permanently ~0).
#   cyrius coverage --full    -> the vendored stdlib in lib/ (today's behaviour;
#                                legitimate when working ON cyrius itself).
#   cyrius coverage --min N   -> exit non-zero if coverage% < N (a CI gate).
# The mode is stated in the summary so a stdlib figure can't be mistaken for a
# project figure. `--min` and `--full` compose. argv(2..) carries the flags.
fn cmd_coverage(): i64 {
    var full = 0;
    var min_pct = 0 - 1;                      # -1 = no gate
    var ai = 2;
    while (argc() > ai) {
        var a = argv(ai);
        if (streq(a, "--full") == 1) { full = 1; }
        elif (streq(a, "--min") == 1) {
            if (argc() > ai + 1) { min_pct = atoi(argv(ai + 1)); ai = ai + 1; }
        }
        ai = ai + 1;
    }

    # Scan root: lib/ for --full, else the project's own src/ (recursive).
    var root = "src";
    if (full == 1) { root = "lib"; }
    if (is_dir(str_from(root)) != 1) {
        # No src/ (e.g. a flat project) — fall back to '.', still excluding lib/.
        root = ".";
    }

    _status("=== Coverage Report ===");
    if (full == 1) {
        println("  mode: --full (vendored stdlib in lib/); reference coverage");
    } else {
        sys_write(STDOUT_FD, "  mode: local repo sources (", 28);
        sys_write(STDOUT_FD, root, strlen(root));
        println("/, recursive; lib/ + dist/ excluded); reference coverage");
    }
    println("");

    # Collect all tests/tcyr content into one searchable corpus, via dir_walk +
    # an inline str_ends_with suffix test. (Written to sidestep find_files, which
    # appeared to "mis-drop every entry" — root-caused v6.4.72 to find_files' then-
    # untyped `ext` param NOT firing the compiler's literal->Str auto-coercion, so a
    # bare `".cyr"` arrived as a raw cstr pointer and str_ends_with read its length
    # from load64(ptr+8) = garbage. NOT an allocator / "heap regime" issue; fixed in
    # lib/fs.cyr by annotating `ext: Str`. The inline walk stays as the equivalent,
    # simplest form.)
    var corpus = alloc(1048576);
    var corpus_len = 0;
    if (is_dir(str_from("tests")) == 1) {
        var tests = vec_new();
        dir_walk(str_from("tests"), tests);      # recursive: tests/tcyr/*.tcyr AND tests/*.tcyr
        var ti = 0;
        while (ti < vec_len(tests)) {
            var tf = vec_get(tests, ti);
            if (str_ends_with(tf, ".tcyr") == 1) {
                var n = file_read_all(str_data(tf), corpus + corpus_len, 1048576 - corpus_len - 1);
                if (n > 0) { corpus_len = corpus_len + n; }
            }
            ti = ti + 1;
        }
    }
    store8(corpus + corpus_len, 0);

    # Recursively collect .cyr sources under `root`, pruning vendored trees
    # (the prunes are inert for the src/ and lib/ roots — their entries are never
    # named lib/dist — and matter only for the '.' flat-project fallback).
    var prunes = vec_new();
    vec_push(prunes, str_from("lib"));       # vendored stdlib (never "local")
    vec_push(prunes, str_from("dist"));      # generated bundles
    var walked = vec_new();
    dir_walk_with_prunes(str_from(root), walked, prunes);
    var srcs = vec_new();
    var wi = 0;
    while (wi < vec_len(walked)) {
        var wf = vec_get(walked, wi);
        if (str_ends_with(wf, ".cyr") == 1) { vec_push(srcs, wf); }
        wi = wi + 1;
    }

    var total_files = 0;
    var covered_files = 0;
    var total_fns = 0;
    var covered_fns = 0;
    var lbuf = alloc(262144);                 # one reusable file buffer (avoid per-file alloc)
    var li = 0;
    while (li < vec_len(srcs)) {
        var spath = str_data(vec_get(srcs, li));
        li = li + 1;
        var ln = file_read_all(spath, lbuf, 262143);
        if (ln <= 0) { continue; }
        store8(lbuf + ln, 0);

        var pub_fns = 0;
        var called = 0;
        var pos = 0;
        while (pos < ln) {
            if (pos == 0 || load8(lbuf + pos - 1) == 10) {
                if (memeq(lbuf + pos, "fn ", 3) == 1) {
                    var ns = pos + 3;
                    var ne = ns;
                    while (ne < ln) {
                        var nc = load8(lbuf + ne);
                        if (nc == 40 || nc == 32 || nc == 10) { break; }
                        ne = ne + 1;
                    }
                    var fname_len = ne - ns;
                    if (fname_len > 0) {
                        if (load8(lbuf + ns) != 95) {     # skip `_`-prefixed (private convention)
                            pub_fns = pub_fns + 1;
                            total_fns = total_fns + 1;
                            var found = 0;
                            var ci = 0;
                            while (ci < corpus_len - fname_len) {
                                if (memeq(corpus + ci, lbuf + ns, fname_len) == 1) { found = 1; break; }
                                ci = ci + 1;
                            }
                            if (found == 1) { called = called + 1; covered_fns = covered_fns + 1; }
                        }
                    }
                }
            }
            pos = pos + 1;
        }

        if (pub_fns == 0) { continue; }        # no public surface — omit from the per-file list
        total_files = total_files + 1;
        if (called > 0) { covered_files = covered_files + 1; }

        # Per-file line — pad the name column to a fixed width, guarding long names
        # (the old `22 - llen` went negative for e.g. `syscalls_linux_common.cyr`,
        # so the count ran into the name).
        var disp = str_data(path_basename(str_from(spath)));
        var dlen = strlen(disp);
        sys_write(STDOUT_FD, "  ", 2);
        sys_write(STDOUT_FD, disp, dlen);
        var pad = 34 - dlen;
        if (pad < 1) { pad = 1; }
        while (pad > 0) { sys_write(STDOUT_FD, " ", 1); pad = pad - 1; }
        fmt_int(called);
        sys_write(STDOUT_FD, "/", 1);
        fmt_int(pub_fns);
        sys_write(STDOUT_FD, " fns\n", 5);
    }

    var pct = 0;
    if (total_fns > 0) { pct = (covered_fns * 100) / total_fns; }
    println("");
    println("-- Summary --");
    if (full == 1) { sys_write(STDOUT_FD, "  Modules referenced: ", 22); }
    else           { sys_write(STDOUT_FD, "  Files referenced:   ", 22); }
    fmt_int(covered_files);
    sys_write(STDOUT_FD, "/", 1);
    fmt_int(total_files);
    println("");
    sys_write(STDOUT_FD, "  Functions referenced: ", 24);
    fmt_int(covered_fns);
    sys_write(STDOUT_FD, "/", 1);
    fmt_int(total_fns);
    sys_write(STDOUT_FD, " (", 2);
    fmt_int(pct);
    println("%)  [reference coverage — a floor, not a correctness proof]");

    if (total_fns == 0) {
        sys_write(STDERR_FD, "  note: no public functions found under ", 40);
        sys_write(STDERR_FD, root, strlen(root));
        sys_write(STDERR_FD, "/ — is this a project root?\n", 28);
    }
    if (min_pct >= 0) {
        if (pct < min_pct) {
            sys_write(STDERR_FD, "coverage gate FAILED: ", 22);
            fmt_int_fd(2, pct); sys_write(STDERR_FD, "% < --min ", 10); fmt_int_fd(2, min_pct);
            sys_write(STDERR_FD, "%\n", 2);
            return 1;
        }
        sys_write(STDOUT_FD, "  gate OK: ", 11);
        fmt_int(pct); sys_write(STDOUT_FD, "% >= --min ", 11); fmt_int(min_pct); println("%");
    }
    return 0;
}

# ================================================================
# Native doctest: extract # >>> / # === patterns, compile, run
# ================================================================
fn cmd_doctest(arg): i64 {
    if (arg == 0) {
        println("Usage: cyrius doctest <file.cyr>");
        return 1;
    }
    var fbuf = alloc(65536);
    var fn_read = file_read_all(arg, fbuf, 65535);
    if (fn_read <= 0) {
        sys_write(STDERR_FD, "error: cannot read ", 19);
        sys_write(STDERR_FD, arg, strlen(arg));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    store8(fbuf + fn_read, 0);

    var dt_pass = 0;
    var dt_fail = 0;
    var dt_total = 0;
    var code = alloc(8192);
    var code_len = 0;
    var in_example = 0;
    var line_num = 0;

    var pos = 0;
    while (pos < fn_read) {
        # Read one line
        var ls = pos;
        while (pos < fn_read) {
            if (load8(fbuf + pos) == 10) { pos = pos + 1; break; }
            pos = pos + 1;
        }
        var le = pos;
        if (le > ls) { if (load8(fbuf + le - 1) == 10) { le = le - 1; } }
        line_num = line_num + 1;
        var ll = le - ls;

        if (ll >= 6) {
            if (memeq(fbuf + ls, "# >>> ", 6) == 1) {
                # New or continuation example line
                var snippet = fbuf + ls + 6;
                var slen = ll - 6;
                if (in_example == 0) { code_len = 0; }
                memcpy(code + code_len, snippet, slen);
                code_len = code_len + slen;
                store8(code + code_len, 10);
                code_len = code_len + 1;
                in_example = 1;
                continue;
            }
        }
        if (ll >= 6) {
            if (memeq(fbuf + ls, "# === ", 6) == 1) {
                if (in_example == 1) {
                    # Parse expected exit code
                    var exp_str = fbuf + ls + 6;
                    var expected = atoi(exp_str);
                    store8(code + code_len, 0);
                    dt_total = dt_total + 1;

                    # Write code to temp file, compile, run
                    var tmpf = _cbt_tmpfile("dt_src");
                    var fd = syscall(2, tmpf, 0x241, 0x1A4);
                    if (fd >= 0) {
                        syscall(1, fd, code, code_len);
                        syscall(3, fd);
                        var tmpbin = _cbt_tmpfile("dt_bin");
                        if (compile(tmpf, tmpbin) == 0) {
                            var ec = run_binary(tmpbin);
                            if (ec == expected) {
                                dt_pass = dt_pass + 1;
                            } else {
                                sys_write(STDERR_FD, "  FAIL: ", 8);
                                sys_write(STDERR_FD, arg, strlen(arg));
                                sys_write(STDERR_FD, ":", 1);
                                fmt_int_fd(STDERR_FD, line_num);
                                sys_write(STDERR_FD, " (expected ", 11);
                                fmt_int_fd(STDERR_FD, expected);
                                sys_write(STDERR_FD, ", got ", 6);
                                fmt_int_fd(STDERR_FD, ec);
                                sys_write(STDERR_FD, ")\n", 2);
                                dt_fail = dt_fail + 1;
                            }
                            sys_unlink(tmpbin);
                        } else {
                            sys_write(STDERR_FD, "  FAIL: ", 8);
                            sys_write(STDERR_FD, arg, strlen(arg));
                            sys_write(STDERR_FD, ":", 1);
                            fmt_int_fd(STDERR_FD, line_num);
                            sys_write(STDERR_FD, " (compile error)\n", 17);
                            dt_fail = dt_fail + 1;
                        }
                        sys_unlink(tmpf);
                    }
                }
                code_len = 0;
                in_example = 0;
                continue;
            }
        }
        # Non-matching line ends example
        if (in_example == 1) {
            if (ll >= 2) {
                if (memeq(fbuf + ls, "# ", 2) == 1) {
                    # Continuation comment line
                    var snippet = fbuf + ls + 2;
                    var slen = ll - 2;
                    memcpy(code + code_len, snippet, slen);
                    code_len = code_len + slen;
                    store8(code + code_len, 10);
                    code_len = code_len + 1;
                    continue;
                }
            }
            code_len = 0;
            in_example = 0;
        }
    }

    println("");
    fmt_int(dt_pass);
    sys_write(STDOUT_FD, " passed, ", 9);
    fmt_int(dt_fail);
    sys_write(STDOUT_FD, " failed (", 9);
    fmt_int(dt_total);
    println(" total doc tests)");
    if (dt_fail > 0) { return 1; }
    return 0;
}

# ================================================================
# Native header: scan pub fn declarations, emit C prototypes
# ================================================================
fn cmd_header(arg): i64 {
    if (arg == 0) {
        println("Usage: cyrius header <file.cyr>");
        return 1;
    }
    var hbuf = alloc(65536);
    var hn = file_read_all(arg, hbuf, 65535);
    if (hn <= 0) {
        sys_write(STDERR_FD, "error: cannot read ", 19);
        sys_write(STDERR_FD, arg, strlen(arg));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    store8(hbuf + hn, 0);

    println("/* Auto-generated by cyrius header -- do not edit */");
    println("#ifndef CYRIUS_FFI_H");
    println("#define CYRIUS_FFI_H");
    println("");
    println("#include <stdint.h>");
    println("");
    println("/* All Cyrius values are 64-bit integers */");
    println("typedef int64_t cyr_val;");
    println("");

    var pos = 0;
    while (pos < hn) {
        var ls = pos;
        while (pos < hn) {
            if (load8(hbuf + pos) == 10) { pos = pos + 1; break; }
            pos = pos + 1;
        }
        var le = pos;
        if (le > ls) { if (load8(hbuf + le - 1) == 10) { le = le - 1; } }
        var ll = le - ls;

        # Match "pub fn " or "fn " at start of line
        var fname_start = 0;
        if (ll >= 7) {
            if (memeq(hbuf + ls, "pub fn ", 7) == 1) { fname_start = ls + 7; }
        }
        if (fname_start == 0) { continue; }

        # Extract function name
        var ne = fname_start;
        while (ne < le) {
            if (load8(hbuf + ne) == 40) { break; }
            ne = ne + 1;
        }
        if (ne >= le) { continue; }
        var fname_len = ne - fname_start;

        # Extract params between ( and )
        var ps = ne + 1;
        var pe = ps;
        while (pe < le) {
            if (load8(hbuf + pe) == 41) { break; }
            pe = pe + 1;
        }

        sys_write(STDOUT_FD, "cyr_val ", 8);
        sys_write(STDOUT_FD, hbuf + fname_start, fname_len);
        sys_write(STDOUT_FD, "(", 1);
        if (pe == ps) {
            sys_write(STDOUT_FD, "void", 4);
        } else {
            # Count and emit params
            var pi = ps;
            var first = 1;
            while (pi < pe) {
                # Skip whitespace
                while (pi < pe) {
                    if (load8(hbuf + pi) != 32) { break; }
                    pi = pi + 1;
                }
                var pns = pi;
                while (pi < pe) {
                    var pc = load8(hbuf + pi);
                    if (pc == 44 || pc == 58 || pc == 41) { break; }
                    pi = pi + 1;
                }
                var pne = pi;
                # Trim trailing space
                while (pne > pns) {
                    if (load8(hbuf + pne - 1) != 32) { break; }
                    pne = pne - 1;
                }
                # Skip type annotation if present
                if (pi < pe) { if (load8(hbuf + pi) == 58) {
                    while (pi < pe) {
                        if (load8(hbuf + pi) == 44) { break; }
                        pi = pi + 1;
                    }
                } }
                if (pne > pns) {
                    if (first == 0) { sys_write(STDOUT_FD, ", ", 2); }
                    sys_write(STDOUT_FD, "cyr_val ", 8);
                    sys_write(STDOUT_FD, hbuf + pns, pne - pns);
                    first = 0;
                }
                # Skip comma
                if (pi < pe) { if (load8(hbuf + pi) == 44) { pi = pi + 1; } }
            }
        }
        println(");");
    }

    println("");
    println("#endif /* CYRIUS_FFI_H */");
    return 0;
}

fn cmd_repl(): i64 {
    var script = make_path(_scripts_dir, "shims/cyrius-repl.sh");
    if (file_exists(script) == 0) {
        script = make_path(_scripts_dir, "cyrius-repl.sh");
    }
    return run_script(script, _cc, 0);
}

