[package]
name = "cyrius"
version = "${file:VERSION}"
description = "Sovereign, self-hosting systems language"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/cyrius"

[build]
src = "src/main.cyr"
output = "build/cc5"

# Release-scaffold manifest (v5.4.18). Single source of truth for the
# toolchain binary + helper-script lists that release.yml, install.sh,
# and cbt/pulsar.cyr all need to stay in sync on. Before v5.4.18 these
# were hardcoded in 6 places (release.yml ×2, install.sh ×3, pulsar ×1)
# and `cyrld` shipped months after CI built it because one of the
# hardcoded lists was never updated. Now: add a binary here, every
# consumer picks it up automatically.
[release]
bins = ["cc5", "cyrius", "cyrfmt", "cyrlint", "cyrdoc", "cyrc", "ark", "cyrld", "cyrius_api_surface", "cyrius-lsp", "cyriusly"]
cross_bins = ["cc5_aarch64", "cc5_win"]
# v5.11.10: scripts/cyriusly retired from release.scripts — replaced by
# programs/cyriusly.cyr in bins (cyrius binary handles all verbs; heavy
# verbs shell-out to OS tools via process.exec). scripts/cyriusly stays
# in tree as `sh scripts/cyriusly` backend for the `setup` / `cmdtools`
# verbs that still call into it transparently; v5.12.x or later may
# fully native-port those paths.
scripts = ["cyrius-init.sh", "cyrius-port.sh", "cyrius-repl.sh", "cyrius-watch.sh", "cyrius-prompt-info"]

# v5.7.50: stdlib auto-prepend list. Required so cyrius's own `cyrius
# bench` / `cyrius test` / `cyrius build` runs include the stdlib
# modules each dep distfile needs in scope. Pre-v5.7.50 this block
# was missing, so dep distfiles got bundled without lib/syscalls.cyr
# (et al.) in scope — patra's `syscall(SYS_LSEEK, ...)` references
# went unresolved at parse time. Surfaced 2026-05-01 in the pre-v5.8.0
# P(-1) audit (`docs/audit/2026-05-01-pre-5.8.0-audit.md`).
#
# Module set is the UNION of what all 6 [deps.*] consumers (sakshi,
# patra, sigil, yukti, mabda, sankoch) plus the agnosys transitive
# dep need in scope when their distfile parses. Computed as the
# union of each dep's own [deps].stdlib list at v5.7.49 pin time.
# Same convention every consumer uses; cyrius is just the last to
# adopt it (its own stdlib was always in scope when compiling itself).
[deps]
# v5.8.49: subdir-nested stdlib paths supported. Items containing `/`
# resolve as `<stdlib_dir>/<path>.cyr` (e.g. `unicode/categories` →
# `lib/unicode/categories.cyr`). `_dep_copy_file()` mkdir-p's any
# intermediate dst dirs. This unblocks Unicode 17.0 fold delivery
# to consumers — pre-fix, `lib/unicode/*.cyr` stayed in this repo
# but never propagated through `cyrius deps` to mabda / sigil / etc.
stdlib = [
    "syscalls", "string", "alloc", "str", "fmt", "vec",
    "hashmap", "io", "fs", "tagged", "process", "fnptr",
    "chrono", "args", "freelist", "assert", "bench", "bigint",
    "json",
    "unicode/_decode", "unicode/categories", "unicode/_categories_data",
    "unicode/casefold", "unicode/_casefold_data",
    "unicode/normalize", "unicode/_normalize_data",
]
# v5.8.65 stdlib foldin (sandhi-pattern, per the v5.7.0 precedent):
# sakshi 2.2.3, patra 1.9.3, sigil 3.1.0 (refolded v5.9.20 from sigil's
# version-label correction of the 3.0.2 ct_eq removal), vani 0.9.2,
# yukti 2.2.2, sankoch 2.2.4 are vendored byte-identical into `lib/<name>.cyr`
# from their patched dist files at the tags listed above. They are
# **NOT** added to the [deps].stdlib auto-prepend list — consumers
# pull them via explicit `include "lib/<name>.cyr"` (the sandhi
# pattern). Auto-prepend would force the ~28 KLOC of folded code
# into every consumer's preprocess_out buffer; preprocess_out is
# capped at 2 MB (v5.6.40) and we just hit it at v5.8.60 over the
# 445 KB compat-decomp blob. Better to keep dep code opt-in.
#
# Mabda + agnosys stay live as `[deps]` git resolutions (mabda is
# 3.0.0-rc.2, not GA; agnosys is transitive via mabda). Both fold
# once mabda 3.0.0 ships post-soak + the v5.9.x Class B FFI / wgpu
# fncall6 ABI work lands.

# v5.8.65 stdlib foldin: sakshi / patra / sigil / vani / yukti /
# sankoch were folded byte-identical into lib/ at their patched
# tags (2.2.3 / 1.9.3 / 3.1.0 / 0.9.2 / 2.2.2 / 2.2.4 respectively)
# and removed from [deps]. The dist files are now permanent stdlib
# entries via [deps].stdlib auto-prepend. Future dep updates fold
# at the next patched tag rather than git-resolve at consume time
# — same model as the v5.7.0 sandhi precedent.
#
# Mabda + agnosys stay live as git deps. Mabda is 3.0.0-rc.2 (not
# GA); agnosys is transitive via mabda. Both fold once mabda 3.0.0
# ships post-soak + the v5.9.x Class B FFI / wgpu fncall6 ABI work
# lands (per the long-term pin in roadmap).
[deps.mabda]
git = "https://github.com/MacCracken/mabda.git"
tag = "2.5.0"
modules = ["dist/mabda.cyr"]
