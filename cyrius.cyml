# cyrius — project manifest.
#
# Rationale, fold history and per-release narrative belong in CHANGELOG.md and
# docs/ecosystem.md, NOT here. Keep this file to the configuration and one line
# of intent per key.

[package]
cyrius = "6.6.0"
name = "cyrius"
version = "${file:VERSION}"
description = "Sovereign, self-hosting systems language"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/cyrius"

[build]
src = "src/main.cyr"
output = "build/cycc"

# Single source of truth for the binary + script lists release.yml, install.sh and
# cbt/pulsar.cyr all consume. Add a binary here and every consumer picks it up.
# ⚠ release.yml awk-parses these three arrays — keep them one-per-line and bracketed.
[release]
bins = ["cycc", "cyrius", "cyrfmt", "cyrlint", "cyrdoc", "cybs", "cyaudit", "ark", "cyrld", "cyrius_api_surface", "cyrius-lsp", "cyriusly", "ts_test_runner", "cyrsign", "cyrsign-efi", "cyrius-init", "cxvm"]
# Cross-target compilers: rebuilt on demand, gitignored, outside the seed trusted base.
cross_bins = ["cycc_aarch64", "cycc_win", "cycc-native-aarch64", "cycc_cx"]
scripts = ["cyrius-repl.sh", "cyrius-watch.sh", "cyrius-prompt-info"]

# Auto-prepended into every `cyrius build` / `test` / `bench` run here, so dep
# distfiles parse with the modules they reference in scope.
# Items containing `/` resolve as lib/<path>.cyr (e.g. unicode/categories).
# ⚠ Vendored folds (bayan, sigil, sakshi, patra, mabda, yukti, sankoch, vani, sandhi)
#   are deliberately ABSENT — they are opt-in via explicit `include "lib/<name>.cyr"`.
#   Auto-prepending them would push tens of KLOC into every consumer's preprocess
#   buffer. See docs/ecosystem.md for what is folded and at which version.
[deps]
stdlib = [
    "syscalls", "string", "alloc", "str", "fmt", "vec",
    "hashmap", "io", "fs", "tagged", "process", "fnptr",
    "chrono", "args", "freelist", "assert", "bench",
    "unicode/_decode", "unicode/categories", "unicode/_categories_data",
    "unicode/casefold", "unicode/_casefold_data",
    "unicode/normalize", "unicode/_normalize_data",
]
