# int3 COM-corruption diagnostic — REAL DXGI variant (v6.1.7).
#
# RUN UNDER cdb/windbg ONLY in a real-GPU desktop session (the 0xCC
# breakpoints crash a bare run; DXGI needs a GPU adapter). Pairs with
# 2026-06-08-com-int3-clean.cyr (DXGI short-circuited) — diff the register
# dumps at each break to isolate what the COM callptr leaves clobbered.
#
# Build:  cycc_win < this > diag_dxgi.exe   (or: CYRIUS_TARGET_WIN=1 cycc < this)
# Debug:  cdb diag_dxgi.exe
#           g   -> breaks at B1 (after the COM chain)
#           r   -> paste (full regs incl efl; DF shows as 'up'=clear / 'dn'=set)
#           g   -> B2 (after 1st append, which prints fine)
#           r   -> paste
#           g   -> B3 (after 2nd append, which is garbled)
#           r   -> paste
#           q
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/syscalls.cyr"
include "lib/dxgi.cyr"
fn run(): i64 {
    var v = dxgi_vram_bytes();              # GPU-verified COM chain
    asm { 0xCC; }                           # B1 — immediately after the COM chain returns
    var sb = str_builder_new();
    var a1 = str_builder_add_cstr(sb, "available=");
    asm { 0xCC; }                           # B2 — after the 1st append (comes out correct)
    var a2 = str_builder_add_cstr(sb, "true");
    asm { 0xCC; }                           # B3 — after the 2nd append (garbled)
    var s = str_builder_build(sb);
    syscall(1, 1, str_data(s), str_len(s));
    return v;
}
fn main(): i64 { alloc_init(); run(); return 0; }
