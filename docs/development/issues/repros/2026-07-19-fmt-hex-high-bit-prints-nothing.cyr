# Repro: fmt_hex / fmt_hex0x / fmt_hex_buf print NOTHING for any value with
# the high bit set (every negative i64 / every u64 >= 2^63).
#
# Build: cyrius build docs/development/issues/repros/2026-07-19-fmt-hex-high-bit-prints-nothing.cyr /tmp/hexbug
# Run:   /tmp/hexbug     (exit 0 = all printed digits; exit 1 = at least one printed nothing)

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"

var _fails = 0;

fn show(label, v) {
    syscall(1, 1, label, strlen(label));
    syscall(1, 1, " fmt_hex0x -> ", 14);
    fmt_hex0x(v);
    # fmt_hex_buf's return value is the digit count — 0 means it wrote nothing
    var b[32];
    var n = fmt_hex_buf(v, &b);
    syscall(1, 1, "   fmt_hex_buf len=", 19);
    print_num(n);
    if (n == 0) { _fails = _fails + 1; syscall(1, 1, "  <-- WROTE NOTHING", 19); }
    syscall(1, 1, "\n", 1);
    return 0;
}

fn main(): i64 {
    alloc_init();
    syscall(1, 1, "-- high bit clear (works) --\n", 29);
    show("1                 ", 1);
    show("0x7fffffffffffffff", 0x7FFFFFFFFFFFFFFF);
    show("0                 ", 0);

    syscall(1, 1, "\n-- high bit set (broken) --\n", 29);
    show("0x8000000000000000", 0x8000000000000000);
    show("-1                ", 0 - 1);
    show("0xfff0000000000000", 0xFFF0000000000000);

    syscall(1, 1, "\nempty-output count: ", 21);
    print_num(_fails);
    syscall(1, 1, "\n", 1);
    if (_fails == 0) { return 0; }
    return 1;
}

var ec = main();
syscall(60, ec);
