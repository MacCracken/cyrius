# Candidate fix for 2026-07-29-fmt-int-buf-i64-min.md, checked by running it.
#
#   cyrius build docs/development/issues/repros/2026-07-29-fmt-int-buf-i64-min-candidate-fix.cyr /tmp/fix
#   /tmp/fix; echo "exit=$?"
#
# Exits 0 when every case passes. `_fixed_int_buf` is the proposed replacement
# for lib/fmt.cyr's fmt_int_buf, copied verbatim from the issue's "Proposed fix"
# section so the two cannot drift.
#
# It extracts digits from the NEGATIVE side rather than negating up front, which
# is what removes the i64::MIN overflow. That relies on % and / truncating
# toward zero, which the first four lines of output confirm on this target:
#   (0-7) % 10 = -7     (0-7) / 10 = 0
#   (0-12) % 10 = -2    (0-12) / 10 = -1
# so `n % 10` is in -9..0 and negating that one digit is always in range.
#
# Verified on cycc 6.5.1, x86_64 Linux: 11/11 cases pass, including i64::MIN,
# i64::MAX, i64::MIN+1, 0, and single/multi-digit negatives.

fn _emit(s: Str): i64 {
    syscall(1, 1, str_data(s), str_len(s));
    syscall(1, 1, str_data(str_from("\n")), 1);
    return 0;
}
fn _pn(label, n): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, label);
    str_builder_add_cstr(sb, " = ");
    str_builder_add_int(sb, n);
    return _emit(str_builder_build(sb));
}

# The proposed replacement, verbatim from the issue's Proposed fix.
fn _fixed_int_buf(n, buf): i64 {
    var bi = 23;
    var neg: i64 = 0;
    if (n < 0) { neg = 1; }
    if (n == 0) { store8(buf + bi, 48); bi = bi - 1; }
    while (n != 0) {
        var d = n % 10;
        if (d < 0) { d = 0 - d; }
        store8(buf + bi, 48 + d);
        bi = bi - 1;
        n = n / 10;
    }
    if (neg == 1) { store8(buf + bi, 45); bi = bi - 1; }
    var len = 23 - bi;
    var src = bi + 1;
    for (var si = 0; si < len; si = si + 1) {
        store8(buf + si, load8(buf + src + si));
    }
    return len;
}

fn _check(n, want): i64 {
    var buf = alloc(32);
    var len = _fixed_int_buf(n, buf);
    var got = str_new(buf, len);
    var ok = str_eq(got, str_from(want));
    var tag = str_from("] OK");
    if (ok == 0) { tag = str_from("] MISMATCH  <<<<"); }
    var mid = str_cat(str_from("] want ["), str_from(want));
    _emit(str_cat(str_from("  ["), str_cat(got, str_cat(mid, tag))));
    return ok;
}

fn main(): i64 {
    alloc_init();
    # 1. truncation direction of % and / on negatives
    _pn("(0-7) % 10", (0 - 7) % 10);
    _pn("(0-7) / 10", (0 - 7) / 10);
    _pn("(0-12) % 10", (0 - 12) % 10);
    _pn("(0-12) / 10", (0 - 12) / 10);

    _emit(str_from("proposed fmt_int_buf replacement:"));
    var bad = 0;
    var imin = (0 - 9223372036854775807) - 1;
    if (_check(imin, "-9223372036854775808") == 0) { bad = 1; }
    if (_check(9223372036854775807, "9223372036854775807") == 0) { bad = 1; }
    if (_check(imin + 1, "-9223372036854775807") == 0) { bad = 1; }
    if (_check(0, "0") == 0) { bad = 1; }
    if (_check(0 - 1, "-1") == 0) { bad = 1; }
    if (_check(0 - 7, "-7") == 0) { bad = 1; }
    if (_check(0 - 10, "-10") == 0) { bad = 1; }
    if (_check(0 - 100, "-100") == 0) { bad = 1; }
    if (_check(1, "1") == 0) { bad = 1; }
    if (_check(42, "42") == 0) { bad = 1; }
    if (_check(1000000, "1000000") == 0) { bad = 1; }
    return bad;
}
var r = main();
syscall(60, r);
