# Repro: ESYSXLAT's ELF-aarch64 compat rows for x86 73 (flock) and 74 (fsync)
# also swallow the NATIVE aarch64 numbers 73 (ppoll) and 74 (signalfd4), which
# lib/syscalls_aarch64_linux.cyr emits directly. No consumer code is involved:
# every call below goes through a plain stdlib wrapper.
#
# cyrius.cyml needs only `[deps] stdlib = ["syscalls"]`.
#
#   cyrius build --aarch64 src/repro.cyr build/r-a64
#   qemu-aarch64 -strace build/r-a64
#
# EXPECTED (aarch64-Linux):
#   signalfd4(-1, ..., 8, 0x800800) = 3
#   ppoll(NULL, 0, NULL, NULL, 0)                 <- blocks forever
#
# ACTUAL on 6.5.35:
#   fsync(-1) = -1 errno=9 (Bad file descriptor)  <- was sys_signalfd
#   flock(0,0,0,0,0,0) = -1 errno=22 (EINVAL)     <- was sys_pause, RETURNS
#
# The x86_64 build of this same file is correct on both calls, so nothing here
# is arch-conditional consumer code.

fn main(): i64 {
    var set = sigset_new();
    sigset_add(set, SIGCHLD);
    sigset_add(set, SIGTERM);

    # lib/syscalls_linux_common.cyr:392 -> syscall(SYS_SIGNALFD4, ...)
    # SYS_SIGNALFD4 = 74 (native aarch64) in syscalls_aarch64_linux.cyr:184
    var sfd = sys_signalfd(0 - 1, set, 0);
    if (sfd >= 0) {
        sys_write(1, "signalfd: OK\n", 13);
        sys_close(sfd);
    } else {
        sys_write(1, "signalfd: FAILED (emitted fsync)\n", 33);
    }

    # Control: a wrapper whose native number does NOT collide with a compat row.
    var ep = sys_epoll_create();
    if (ep >= 0) { sys_write(1, "epoll_create: OK\n", 17); sys_close(ep); }
    else { sys_write(1, "epoll_create: FAILED\n", 21); }

    # lib/syscalls_aarch64_linux.cyr:688 -> syscall(SYS_PPOLL, 0,0,0,0,0)
    # SYS_PPOLL = 73 (native aarch64) at :111, commented "-> sys_pause".
    # A correct pause(2) BLOCKS. If the next line prints, it did not.
    sys_write(1, "pause: entering (must block)\n", 29);
    sys_pause();
    sys_write(1, "pause: RETURNED (emitted flock)\n", 32);
    return 0;
}
