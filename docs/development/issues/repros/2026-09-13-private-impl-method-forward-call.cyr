# Repro: a PRIVATE impl method is reachable from another file when the CALL is parsed
# BEFORE the impl block (a forward reference). Proves itself: exit 42 while the bug is
# present; the build is refused ('Q_seven' is private to its file) when fixed.
#
# ✅ FIXED in 6.6.5 (bite 3) — this file is now REFUSED, which is the pass condition above:
#     error:<source>:<the line `fn main` lands on>:57: 'Q_seven' is private to its file
# ⚠ The LINE is not quoted: it tracks the length of this header and an earlier version of this
#   note said `:7:57` long after the header had pushed `fn main` past line 30.
# Filing archived at
# docs/development/issues/archived/2026-09-13-private-impl-method-forward-call-fail-open.md;
# read its "Corrections to this filing" section. Kept as-is so it stays runnable. The regression
# coverage lives in tests/gates/frontend/private_forward_reference.sh (refusals, which no .tcyr
# can express) and tests/tcyr/crossos/forward_ref_abi_binding.tcyr (the ABI half, on real
# hardware). The note below about pass 1 skipping impl bodies describes the 6.6.4 compiler.
#
# Build as two files:
#   lib:  the `# --- lib_priv_impl.cyr ---` block below, saved as lib_priv_impl.cyr
#   main: this file (NOTE the include comes AFTER main — that is the shape)
#   ./build/cycc < this.cyr > r && ./r ; echo $?
#
# Control: move the include ABOVE fn main and the same call is refused — so the check
# exists; it fails OPEN because pass 1 skips impl bodies (src/main.cyr:~1495 and the six
# fork twins) and the mangled `Q_seven` has no fileid when the forward call resolves.
#
# --- lib_priv_impl.cyr ---
# private
#
# struct Q { a: i64; b: i64; }
# impl Tr for Q {
#     fn seven(self) { return 42; }
# }
# public fn api(v) { return v; }
# --- end lib_priv_impl.cyr ---
include "lib/syscalls.cyr"
struct Q { a: i64; b: i64; }
fn main() { var q: Q; q.a = 1; q.b = 2; return q.seven(); }
include "lib_priv_impl.cyr"
var rc = main();
sys_exit_group(rc);
