# Repro: on arm64 macOS a thread created inside a fork() child kills the child (SIGSEGV).
# Exit code = number of failing cases (0 when fixed; 2 on cyrius 6.6.12 arm64 macOS; 0 on Linux).
#
#   case 0 (control): the child only exits — fork itself works.
#   case 1: the child creates and joins one thread.
#   case 2: the PARENT creates and joins a thread first, then the child does.
#
# Build for arm64 macOS and run it there (ad-hoc sign first):
#   CYRIUS_MACHO_ARM=1 cyrius build --aarch64 <this file> fork_thread
#   codesign -s - -f fork_thread && ./fork_thread; echo "exit=$?"
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/thread.cyr"

var W = 0;
fn body(a): i64 { W = W + 1; return 0; }

# Fork; the child runs `which` and exits. Returns the child's exit code, or 100 + signal.
fn run_case(which): i64 {
    var pid = sys_fork();
    if (pid < 0) { return 99; }
    if (pid == 0) {
        if (which == 0) { sys_exit(7); }
        # Markers straight to fd 2: on 6.6.12 arm64 macOS "A" prints and "B" never does — the
        # child dies inside thread_create, before it returns, and the body never runs.
        syscall(SYS_WRITE, 2, "  A: child before thread_create\n", 32);
        var th = thread_create(&body, 0);
        syscall(SYS_WRITE, 2, "  B: thread_create returned\n", 28);
        if (th == 0) { sys_exit(5); }
        thread_join(th);
        sys_exit(0);
    }
    var st = 0;
    sys_waitpid(pid, &st, 0);
    var s = st & 0xFFFF;
    if ((s & 0x7F) != 0) { return 100 + (s & 0x7F); }
    return (s >> 8) & 0xFF;
}

fn main(): i64 {
    alloc_init();
    var fails = 0;
    var r0 = run_case(0);
    println("case 0 (child only exits; want 7):");
    fmt_int(r0); println("");
    if (r0 != 7) { fails = fails + 1; }
    var r1 = run_case(1);
    println("case 1 (child creates a thread; want 0, 111 = killed by SIGSEGV):");
    fmt_int(r1); println("");
    if (r1 != 0) { fails = fails + 1; }
    thread_join(thread_create(&body, 0));     # the parent runs a thread of its own first
    var r2 = run_case(2);
    println("case 2 (parent ran a thread first; want 0):");
    fmt_int(r2); println("");
    if (r2 != 0) { fails = fails + 1; }
    return fails;
}
var r = main();
syscall(SYS_EXIT, r);
