# repro: lib/tls.cyr native client accepts an IP-literal host through a dNSName.
# argv: <port> — a server (the .sh starts it) whose leaf's only SAN is the
# dNSName under test, issued by the CA in $CA (read via a connect hook).
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/net.cyr"
include "lib/args.cyr"
include "lib/tls.cyr"

var _ca = 0;
var _ca_len = 0;

fn _hook(ctx, handle) {
    if (tls_native_set_ca_bundle(handle, _ca, _ca_len, 0) != TLS_OK) { return 1; }
    return 0;
}

fn _atoi(s) {
    var v = 0;
    var i = 0;
    while (load8(s + i) >= 48 && load8(s + i) <= 57) { v = v * 10 + load8(s + i) - 48; i = i + 1; }
    return v;
}

fn main() {
    alloc_init();
    args_init();
    crypto_tls_main_init();
    ecdsa_p256_warm();
    _ca = alloc(8192);
    _ca_len = file_read_all(argv(2), _ca, 8192);
    var st, fd = tcp_socket();
    var ct, cv = sock_connect(fd, INADDR_LOOPBACK(), _atoi(argv(1)));
    if (is_err_result(ct) == 1) { println("connect failed"); return 2; }
    var tc = tls_connect_with_ctx_hook(fd, "127.0.0.1", &_hook, 0);
    if (tc == 0) { println("refused"); return 0; }
    println("accepted");
    tls_close(tc);
    return 1;
}
var r = main();
syscall(SYS_EXIT, r);
