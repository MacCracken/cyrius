# Under CYRIUS_POISON, a read that jumps a whole redzone lands in the next block's LIVE bytes
# and nothing notices: no trap, no report, and `--poison=ab` reads the same live byte under
# both fills, so the A/B differential cannot see it either. Guard pages are the one way to.
# Actual on 6.7.6: "a->b distance: 104  byte read through a: 66", exit 0.
#   cat docs/development/issues/repros/2026-10-08-poison-redzone-jumping-read.cyr \
#     | build/cycc > /tmp/pz && chmod +x /tmp/pz && /tmp/pz; echo $?
#define CYRIUS_POISON
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"

fn main(): i64 {
    alloc_init();
    var a = alloc(16);
    var b = alloc(16);
    store8(b, 66);                         # b's live byte
    var off = b - a;                       # 16 + trailing RZ 32 + next header 24 + leading RZ 32
    var got = load8(a + off);              # an overread of `a` that jumps every redzone
    syscall(1, 1, "a->b distance: ", 15); print_num(off);
    syscall(1, 1, "  byte read through a: ", 23); print_num(got);
    syscall(1, 1, "\n", 1);
    return 0;
}
var r = main();
syscall(60, r);
