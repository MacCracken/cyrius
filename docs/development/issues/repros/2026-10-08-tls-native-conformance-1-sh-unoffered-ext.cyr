# A TLS 1.3 ServerHello carrying an extension the client never offered (type 0x1234, empty) must be
# refused (RFC 8446 §4.2: unsupported_extension). Exit 0 = refused (correct); 1 = accepted (the bug).
include "lib/str.cyr"
include "lib/chrono.cyr"
include "lib/random.cyr"
include "lib/tls_native.cyr"
include "lib/net.cyr"
include "lib/assert.cyr"

var leaf_cert = hex_decode("", 826);
var ed_key = hex_decode("302e020100300506032b657004220420399843cd6b8ea5ba0309fe5b38fe4dd271ee65f20f39a48efc7d7503c0775f12", 96);

fn main(): i64 {
    var cl = tls_native_new_client("localhost", 9);
    var ch[512];
    var chn = tls_native_client_build_hello(cl, &ch, 512);
    var srv = tls_native_new_server(leaf_cert, 413, ed_key, 48);
    tls_native_server_load_creds(srv);
    var sh[320];
    var shn = tls_native_server_respond_hello(srv, &ch, chn, &sh, 256);
    if (shn <= 0) { println("setup: server did not answer"); return 2; }
    # Append extension { type 0x1234, length 0 } and fix the handshake and extensions lengths.
    var p = &sh;
    store8(p + shn, 0x12); store8(p + shn + 1, 0x34); store8(p + shn + 2, 0); store8(p + shn + 3, 0);
    var blen = shn - 4 + 4;
    store8(p + 1, (blen >> 16) & 0xFF); store8(p + 2, (blen >> 8) & 0xFF); store8(p + 3, blen & 0xFF);
    var eo = 4 + 2 + 32 + 1 + (load8(p + 4 + 34) & 0xFF) + 2 + 1;   # ext_total offset
    var et = ((load8(p + eo) & 0xFF) << 8) | (load8(p + eo + 1) & 0xFF);
    et = et + 4;
    store8(p + eo, (et >> 8) & 0xFF); store8(p + eo + 1, et & 0xFF);
    var rc = tls_native_client_parse_server_hello(cl, &sh, shn + 4);
    if (rc == TLS_OK) { println("ACCEPTED: ServerHello with unoffered extension 0x1234 parsed TLS_OK"); return 1; }
    println("refused (correct)");
    return 0;
}
var r = main();
syscall(SYS_EXIT, r);
