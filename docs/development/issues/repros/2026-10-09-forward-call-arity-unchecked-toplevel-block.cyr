# 2026-10-09 — the same gap for a fn defined inside a top-level block, called above it.
# Expected: error:<source>:6: 'g' expects 1 argument, got 2 (what the call gives below the block).
# Actual (6.7.6 @ e44470b7): rc 0, exit 6 — g ran with a = 5 and the 6 was dropped.
# (Pass 1 records this fn too — `_prescan_tail` → `_prescan_block_fn`, 6.6.17 — so its parameter
# count is known at the call.)
var r = g(5, 6);
if (1 == 1) {
    fn g(a): i64 { return a + 1; }
}
syscall(60, r);
