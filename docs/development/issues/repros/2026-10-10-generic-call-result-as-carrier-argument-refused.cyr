# 2026-10-10 — a generic call's own result as a generic struct carrier's argument is not inferred.
# Expected: compiles, exits 8 (T = Pt, as `gx(b)` with `var b: Box<Pt> = mk1(p);` infers).
# Actual: error:<source>:13:15: cannot pass 'mk1' to a parameter of a different struct type in a
#         call to 'gx'  (6.7.8; 6.7.7 refused it the same way)
# Controls: `gx<Pt>(mk1(p))` and `var b: Box<Pt> = mk1(p); gx(b)` exit 8.
include "lib/syscalls.cyr"
struct Pt { x; y; }
struct Box<T> { v: T; n; }
fn mk1<T>(x: T): Box<T> { var b: Box<T>; b.v = x; b.n = 8; return b; }
fn gx<T>(b: Box<T>): i64 { return b.n; }
fn go(): i64 {
    var p: Pt; p.x = 3; p.y = 4;
    return gx(mk1(p));
}
var rc = go();
syscall(60, rc);
