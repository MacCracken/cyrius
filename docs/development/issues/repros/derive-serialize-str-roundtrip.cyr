# Repro: #derive(Serialize) Str field — to_json works, from_json does NOT
# reconstruct Str fields (yields garbage pointer bytes on roundtrip).
# Build:  cyrius build docs/development/issues/repros/derive-serialize-str-roundtrip.cyr /tmp/str_rt
# Run:    /tmp/str_rt
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
include "lib/result.cyr"
include "lib/io.cyr"
include "lib/bayan.cyr"

#derive(Serialize)
struct Meta { title: Str; artist: Str; }

fn main() {
    alloc_init();

    var m = Meta { str_new("Song", 4), str_new("Band", 4) };
    var sb = str_builder_new();
    Meta_to_json(&m, sb);
    var js = str_builder_build(sb);
    syscall(1, 1, "to_json:   ", 11);
    syscall(1, 1, str_data(js), str_len(js));
    syscall(1, 1, "\n", 1);

    var rec = Meta_from_json(bayan_json_parse(js));
    var sb2 = str_builder_new();
    Meta_to_json(rec, sb2);
    var js2 = str_builder_build(sb2);
    syscall(1, 1, "roundtrip: ", 11);
    syscall(1, 1, str_data(js2), str_len(js2));
    syscall(1, 1, "\n", 1);

    # exit 0 if roundtrip matches (it does NOT on 6.3.x)
    if (str_eq(js, js2) == 1) { return 0; }
    return 1;
}

var ec = main(); syscall(60, ec);
