# fuzz_x509.fcyr — the X.509 / DER parsers on mutated certificates (3.13.14, 6.7.18's D1).
#
# x509_parse_into, the DER walker under it, the validity-time parser, the nameConstraints and
# subjectAltName readers (CYRIUS-2026-0042), the RSA SPKI reader (rsa_pubkey_from_der) and
# certpin's DER walker all read bytes a peer chose. Since 3.13.14 they read through fn-local slices bounded by the buffer they were
# handed, so an offset past the end aborts ("slice bounds violation", exit 134) in every build
# instead of reading on. This harness drives them with mutated certificates, each copied into
# a buffer sized EXACTLY to its bytes (under `cyrius fuzz --poison` the allocator's redzones
# flank it), and must finish with every parser answering 0 / 1 / -1: a crash, an abort or a
# poison hit is a failure.
#
# Seeds: the nameConstraints fixtures (sigil's tests/data/name_constraints/*.hex, inline below —
# root, constrained intermediates, leaves with dNSName / iPAddress / email / dirName names) and
# hand-made short shapes (the empty TBS of Finding 20, truncated TBS prefixes, a 2048-bit RSA SPKI
# and tiny PKCS#1 / SPKI keys). Deterministic xorshift64 PRNG: the same build reproduces the same
# run.
# 6.7.18: sigil 3.13.14's fuzz/fuzz_x509.fcyr (release commit 050ff1b), run against the vendored
# lib/sigil.cyr; its includes and its seed loading differ (sigil's own reads its src/ modules and
# the .hex fixtures from its tests/data/).
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/freelist.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/sigil.cyr"

var _rng_state = 0;

fn rng_seed(s): i64 { _rng_state = s; return 0; }
fn rng_next(): i64 {
    var x = _rng_state;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    _rng_state = x;
    return x;
}
# A value in 0 .. n-1.
fn rng_below(n): i64 {
    if (n <= 0) { return 0; }
    var r = rng_next() % n;
    if (r < 0) { r = 0 - r; }
    return r;
}

var _seeds = 0;      # vec of seed buffers
var _seed_lens = 0;  # vec of their lengths

fn _add_seed(buf, n): i64 {
    vec_push(_seeds, buf);
    vec_push(_seed_lens, n);
    return 0;
}

# One seed from its DER as hex.
fn _add_hex(hex): i64 {
    var hl = strlen(hex);
    _add_seed(hex_decode(hex, hl), hl / 2);
    return hl / 2;
}

# The seed certificates: sigil 3.13.14's tests/data/name_constraints/<name>.hex (release commit
# 050ff1b), inline, in the order sigil's harness loads them (index 1 is i_dns, 7 is l_in).
fn _add_fixtures(): i64 {
    _add_hex("");   # root
    _add_hex("");   # i_dns
    _add_hex("");   # i_dnsc
    _add_hex("");   # i_excl
    _add_hex("");   # i_ip
    _add_hex("");   # i_dir
    _add_hex("");   # i_mail
    _add_hex("");   # l_in
    _add_hex("");   # l_mixed
    _add_hex("");   # l_cnout
    _add_hex("");   # l_ipexcl
    _add_hex("");   # l_dirin
    _add_hex("");   # l_mailyes
    _add_hex("");   # l_xwild
    return 0;
}

# One mutation of src[0 .. n) into dst (capacity n + 16); returns the mutant's length.
fn _mutate(src, n, dst): i64 {
    memcpy(dst, src, n);
    var m = n;
    var kind = rng_below(8);
    var rounds = 1 + rng_below(4);
    var r = 0;
    while (r < rounds) {
        if (m == 0) { return 0; }
        var at = rng_below(m);
        if (kind == 0) { store8(dst + at, (load8(dst + at) & 0xFF) ^ (1 << rng_below(8))); }
        if (kind == 1) { store8(dst + at, rng_below(256)); }
        if (kind == 2) {
            # a "length-ish" byte: the long-form markers and the lengths around zero
            var pick = rng_below(8);
            var v = 0x80 + pick;
            if (pick == 5) { v = 0; }
            if (pick == 6) { v = 1; }
            if (pick == 7) { v = 0xFF; }
            store8(dst + at, v);
        }
        if (kind == 3) { m = at; }                                   # truncate
        if (kind == 4) {                                             # delete one byte
            if (at + 1 < m) { memcpy(dst + at, dst + at + 1, m - at - 1); }
            m = m - 1;
        }
        if (kind == 5) {                                             # insert one byte
            if (m < n + 15) {
                var k = m;
                while (k > at) {
                    store8(dst + k, load8(dst + k - 1) & 0xFF);
                    k = k - 1;
                }
                store8(dst + at, rng_below(256));
                m = m + 1;
            }
        }
        if (kind == 6) { store8(dst + at, 0x30); }                   # SEQUENCE tag
        if (kind == 7) { store8(dst + at, 0xA0 + rng_below(4)); }    # context tags
        r = r + 1;
    }
    return m;
}

var _parsed = 0;
var _refused = 0;
var _nc_checks = 0;

# Every parser on one exactly-sized buffer.
fn _drive(buf, n, ca, leaf, arena): i64 {
    # the X.509 parser, its nameConstraints / subjectAltName readers and the link check
    var c = x509_cert_alloc_into(arena);
    if (c == 0) { return 0; }
    if (x509_parse_into(buf, n, c, arena) == 1) {
        _parsed = _parsed + 1;
        var cnt = x509_nc_subtree_count(c);
        var out[32];
        var i = 0;
        while (i < cnt + 1) {
            x509_nc_subtree(c, i, &out);
            i = i + 1;
        }
        x509_name_constraints_check(c, leaf);       # the mutant as the constrained CA
        x509_name_constraints_check(ca, c);         # the mutant as the subordinate
        x509_name_constraints_check(c, c);
        _nc_checks = _nc_checks + 3;
    } else {
        _refused = _refused + 1;
    }
    # the DER walker and the time parser at arbitrary positions
    var cp = 0;
    var np = 0;
    var p = rng_below(n + 1);
    der_walk(buf, n, p, DER_TAG_SEQUENCE, &cp, &np);
    der_walk(buf, n, p, rng_below(256), &cp, &np);
    var ep = 0;
    _x509_parse_time(buf, n, p, &ep, &np);
    if (n >= 13) { _x509_parse_utctime(buf, n - 13, 13); }
    if (n >= 15) { _x509_parse_gentime(buf, n - 15, 15); }
    # the RSA public-key reader (an RSA SPKI reaches it from x509_parse_into)
    var rn[512];
    var re[16];
    var rel = 0;
    rsa_pubkey_from_der(buf, n, &rn, 512, &re, 16, &rel);
    # certpin's DER walker
    var cc = 0;
    _cp_der_tlv(buf, p, n, &cc);
    _cp_der_skip(buf, p, n, 0x30);
    return 0;
}

fn main(): i64 {
    alloc_init();
    rng_seed(0x9E3779B97F4A7C15);
    _seeds = vec_new();
    _seed_lens = vec_new();

    _add_fixtures();
    _add_seed(hex_decode("30023000", 8), 4);                       # Finding 20
    _add_seed(hex_decode("30073005a003020102", 18), 9);
    _add_seed(hex_decode("300c300aa0030201020201013000", 28), 14);
    _add_seed(hex_decode("3000", 4), 2);
    # RSA public keys: a 2048-bit SPKI (tests/tcyr/rsa.tcyr) and tiny PKCS#1 / SPKI shapes
    _add_seed(hex_decode("", 588), 294);
    _add_seed(hex_decode("3006020105020103", 16), 8);
    _add_seed(hex_decode("301a300d06092a864886f70d01010105000309003006020105020103", 56), 28);

    # a constrained CA and a leaf to pair the mutants with
    var ca = x509_cert_alloc();
    assert_eq(x509_parse(vec_get(_seeds, 1), vec_get(_seed_lens, 1), ca), 1, "i_dns parses");
    var leaf = x509_cert_alloc();
    assert_eq(x509_parse(vec_get(_seeds, 7), vec_get(_seed_lens, 7), leaf), 1, "l_in parses");

    var arena = arena_new(65536);
    var iters = 200000;
    var it = 0;
    var ns = vec_len(_seeds);
    while (it < iters) {
        var si = rng_below(ns);
        var src = vec_get(_seeds, si);
        var sn = vec_get(_seed_lens, si);
        var tmp = fl_alloc(sn + 16);
        var m = _mutate(src, sn, tmp);
        var buf = fl_alloc(m + (m == 0));           # exactly the mutant's bytes
        memcpy(buf, tmp, m);
        arena_reset(arena);
        _drive(buf, m, ca, leaf, arena);
        fl_free(buf);
        fl_free(tmp);
        it = it + 1;
    }
    # every seed unmutated, exactly sized, too
    var k = 0;
    while (k < ns) {
        var sn2 = vec_get(_seed_lens, k);
        var b2 = fl_alloc(sn2);
        memcpy(b2, vec_get(_seeds, k), sn2);
        arena_reset(arena);
        _drive(b2, sn2, ca, leaf, arena);
        fl_free(b2);
        k = k + 1;
    }
    assert(_parsed > 0, "some mutants still parse (the harness reaches the extension readers)");
    assert(_refused > 0, "some mutants are refused");
    assert(_nc_checks > 0, "the nameConstraints checks ran");
    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
