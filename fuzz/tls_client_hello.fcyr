# VR-02 (v6.3.22): mutation-fuzz the NETWORK-FACING TLS ClientHello parser
# (_tn_parse_client_hello, lib/tls_native_hs13.cyr) — a server parsing untrusted
# bytes off the wire. Feeds adversarial/random ClientHello bodies (large length
# fields, truncations, garbage) into a fresh server ctx each iteration; a parser
# bug = SIGSEGV (harness exit 139); a graceful TLS_ERR_* return is a PASS.
# Deterministic LCG so a crash reproduces. Assembled by scripts, cert/key reused
# from tests/tcyr/crypto/tls12_handshake.tcyr.
include "lib/tls_native.cyr"
include "lib/str.cyr"
include "lib/chrono.cyr"
include "lib/random.cyr"
include "lib/assert.cyr"

var _fz_seed = 305419896;
fn _fz_rnd(): i64 {
    _fz_seed = _fz_seed * 6364136223846793005 + 1442695040888963407;
    var r = _fz_seed >> 33;
    if (r < 0) { r = 0 - r; }
    return r;
}
var cert23 = hex_decode("", 770);
var key23 = hex_decode("308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420b19108bb3950b49995a9c770e12613b12d96dc2409a464fdc43c63a41b1d4668a144034200049167a2981f570fdbd8d94bf20fb4f5c89d77aa5b58cf4ed416bafa0256a2561a04f1e71d57537fc532fc87ca980eb8ba1f8f8704fc7f6a793ba6598b97bb3275", 276);

var _prefs: i64[2];
store64(&_prefs + 0, TLS_AES_128_GCM_SHA256);
store64(&_prefs + 8, TLS_CHACHA20_POLY1305_SHA256);

var _n = 0;
while (_n < 120) {
    var srv = tls_native_new_server(cert23, 385, key23, 138);
    if (srv == 0) { _n = 120; }
    else {
        tls_native_server_load_creds(srv);
        var blen = _fz_rnd() % 400;
        var buf = alloc(blen + 8);
        var bi = 0;
        while (bi < blen) { store8(buf + bi, _fz_rnd() % 256); bi = bi + 1; }
        if (blen >= 2) { store8(buf, 3); store8(buf + 1, 3); }   # looks like a CH
        if (blen > 34) { if (_fz_rnd() % 2 == 0) { store8(buf + 34, _fz_rnd() % 256); } }
        _tn_parse_client_hello(srv, buf, blen, &_prefs, 2);
        _n = _n + 1;
    }
}
println("fuzz_tls_client_hello: 120 adversarial ClientHello parses survived (no crash)");
syscall(60, 0);
