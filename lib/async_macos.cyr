# async_macos.cyr — macOS (Darwin) async runtime: serial / blocking fallback.
#
# ⛔ WHY THIS FILE EXISTS (v6.5.27). Before it, macOS fell through to `lib/async.cyr`'s
# EPOLL body — on a kernel that has no epoll. The result was not a clean failure: the epoll
# body referenced `sys_epoll_wait`, which has no Darwin wrapper, so any macOS program using
# async carried an undefined reference; and `lib/syscalls_macos.cyr` DECLARES
# SYS_EPOLL_WAIT=232 / SYS_EPOLL_CTL=233 / SYS_EPOLL_CREATE1=291 — LINUX numbers that the
# macho translators do NOT route — so code reaching them would issue raw Darwin syscalls
# 232/233/291. Dead-but-armed constants, the same class as the Linux SIGCHLD=17 that is
# Darwin's SIGSTOP (v6.5.15).
#
# ⚠ THIS IS A FALLBACK, NOT A REACTOR, AND THE DISTINCTION IS THE POINT. Darwin's readiness
# API is kqueue/kevent, which cyrius has no wrappers for at all (`grep -rn 'kqueue\|kevent'
# lib/` → nothing). A real macOS reactor is a kqueue backend and is NOT what this is. This
# gives macOS the same honest serial/blocking semantics agnos has had since v6.2.3: tasks run
# to completion in order, a park is a no-op because the subsequent blocking read IS the wait.
# Single-waiter-per-fd is therefore not a limitation here — there is no registry to be
# limited. Consumers written against the epoll backend LINK and RUN; they do not multiplex.
#
# Structure and contract mirror lib/async_agnos.cyr exactly (same serial model, same public
# surface) so the three backends stay comparable. Kept as its own file rather than reusing
# the agnos one because the reasons differ (agnos: server path unused on a client target;
# macOS: wrong readiness API) and a future kqueue reactor replaces THIS file only.

include "lib/fnptr.cyr"

# Task states (mirror lib/async.cyr).
var TASK_READY = 0;
var TASK_WAITING = 1;
var TASK_DONE = 2;

# Task struct: { fp, arg, state, next, wait_fd, result } = 48 bytes (mirror async.cyr).
# wait_fd is unused on agnos (no epoll parking; tasks run to completion inline);
# result (@40, v6.4.34 F2) carries the task fn's return so task_join hands it back.
# v6.5.27 — 48 -> 64 to match lib/async.cyr's task layout exactly: wait_fd@32, result@40,
# owned_fd@48, wait_ev@56. The kqueue reactor below needs wait_ev for the same reason the
# epoll one does — to know which DIRECTION a parked task is waiting on, so a read-waiter is
# not woken by a write-readiness event. Tasks are heap-allocated, so this is not a layout
# change in the heap-map sense.
var TASK_SIZE = 64;

# Darwin kevent struct (64-bit): { ident@0 u64, filter@8 i16, flags@10 u16, fflags@12 u32,
# data@16 i64, udata@24 ptr } = 32 bytes. EVFILT_READ = -1, EVFILT_WRITE = -2 (int16, so
# stored as 0xFFFF / 0xFFFE). EV_ADD = 1, EV_DELETE = 2.
var KEV_SIZE = 32;
# Filters beyond READ/WRITE, flags and wait bits (xnu bsd/sys/event.h): EVFILT_PROC -5 = 0xFFFB,
# EVFILT_TIMER -7 = 0xFFF9. CHANGELOG [6.6.10]
var _KEVF_READ = 65535;
var _KEVF_WRITE = 65534;
var _KEVF_PROC = 65531;
var _KEVF_TIMER = 65529;
# flags: EV_ADD 0x1, EV_DELETE 0x2, EV_ONESHOT 0x10. fflags: NOTE_EXIT 0x80000000 (EVFILT_PROC).
# EVFILT_TIMER's `data` is the period in milliseconds when no NOTE_*SECONDS unit flag is set.
var _EV_ADD = 1;
var _EV_DELETE = 2;
var _EV_ONESHOT = 16;
var _NOTE_EXIT = 0x80000000;
# wait_ev bits. 1 and 4 are the epoll backend's EPOLLIN / EPOLLOUT, so consumer code passes the
# same values on every target; the timer and proc bits are private to this file.
var _KEV_READ = 1;
var _KEV_WRITE = 4;
var _KEV_TIMER = 256;
var _KEV_PROC = 512;

# Runtime struct: { epfd, tasks, task_count, active, allocator, current } = 48
# bytes (mirror async.cyr F1). epfd is unused on agnos (no epoll for arbitrary
# fds) and stored as -1; current is unused (serial run-to-completion loop).
# ⚠ `sleep_ms` NOT `sys_sleep_ms`. The agnos original this file was derived from calls
# `sys_sleep_ms`, an AGNOS-ONLY syscall (SYS_SLEEP_MS) that does not exist on Darwin —
# copying the backend wholesale inherited a dependency that cannot resolve here.
# `lib/chrono.cyr`'s `sleep_ms` is the portable one and already handles Darwin correctly
# (`poll(NULL, 0, ms)`, 7→230; XNU has no plain `nanosleep` BSD syscall — chrono.cyr:141-152,
# CHANGELOG [6.0.65]). Included so this module is self-sufficient, per the stdlib rule that a
# lib file referencing something must include its definer.
include "lib/chrono.cyr"

var RT_SIZE = 48;

# Create a new async runtime backed by allocator `a`. No epoll instance is
# created (Darwin has no epoll at all; the cooperative loop below needs none —
# tasks run to completion inline). epfd slot holds -1.
fn async_new_in(a): i64 {
    var rt = alloc_via(a, RT_SIZE);
    if (rt == 0) { return 0; }
    store64(rt, sys_kqueue());   # v6.5.27: a REAL kqueue fd (was -1 / no reactor)
    store64(rt + 8, 0);
    store64(rt + 16, 0);
    store64(rt + 24, 0);
    store64(rt + 32, a);
    store64(rt + 40, 0);         # current: unused on agnos (mirror layout)
    return rt;
}

# Back-compat wrapper over the global bump allocator.
fn async_new(): i64 {
    return async_new_in(default_alloc());
}

# Spawn a task on the runtime (identical to the Linux path — pure memory ops).
fn async_spawn(rt, fp, arg): i64 {
    var t = alloc_via(load64(rt + 32), TASK_SIZE);
    if (t == 0) { return 0; }
    store64(t, fp);
    store64(t + 8, arg);
    store64(t + 16, TASK_READY);
    store64(t + 32, 0 - 1);          # wait_fd: not fd-waiting
    store64(t + 48, 0 - 1);          # owned_fd
    store64(t + 56, 0);              # wait_ev: not parked on any filter
    store64(t + 24, load64(rt + 8));
    store64(t + 32, 0 - 1);          # wait_fd: unused on agnos (mirror layout)
    store64(t + 40, 0);              # result: captured on done (F2)
    store64(rt + 8, t);
    store64(rt + 16, load64(rt + 16) + 1);
    store64(rt + 24, load64(rt + 24) + 1);
    return t;
}

# Issue ONE kevent change (register, modify or delete) and return kevent's result: 0, or < 0.
# A changelist-only call (nevents 0) never blocks, and an error in the change is RETURNED rather
# than reported as an EV_ERROR event, which is why every registration in this file goes through
# here instead of riding a waiting call.
fn _async_kev_change(kq, ident, filter, flags, fflags, data): i64 {
    var ch[32];
    store64(&ch, ident);
    store16(&ch + 8, filter);
    store16(&ch + 10, flags);
    store32(&ch + 12, fflags);
    store64(&ch + 16, data);
    store64(&ch + 24, 0);
    return sys_kevent(kq, &ch, 1, 0, 0, 0);
}

# The _KEV_* wait bit a delivered event's filter answers.
fn _async_kev_bit(filt): i64 {
    if (filt == _KEVF_READ) { return _KEV_READ; }
    if (filt == _KEVF_WRITE) { return _KEV_WRITE; }
    if (filt == _KEVF_TIMER) { return _KEV_TIMER; }
    if (filt == _KEVF_PROC) { return _KEV_PROC; }
    return 0;
}

# Park the CURRENT task on (ident, bits) without touching the kqueue — for a registration that is
# already armed (a periodic timer between ticks) or that the caller armed itself. Returns -1
# outside a running task.
fn _async_kev_park(rt, ident, bits): i64 {
    var cur = load64(rt + 40);
    if (cur == 0) { return 0 - 1; }
    store64(cur + 32, ident);
    store64(cur + 56, bits);
    store64(cur + 16, TASK_WAITING);
    return 0;
}

# Union of the _KEV_* bits every PARKED task waits on for `ident`. The registry IS the task list.
fn _async_kev_mask(rt, ident): i64 {
    var m = 0;
    var t = load64(rt + 8);
    while (t != 0) {
        if (load64(t + 16) == TASK_WAITING) {
            if (load64(t + 32) == ident) { m = m | load64(t + 56); }
        }
        t = load64(t + 24);
    }
    return m;
}

# Wake every parked task waiting on (ident, bit). Returns how many it woke.
fn _async_kev_wake(rt, ident, bit): i64 {
    var n = 0;
    var t = load64(rt + 8);
    while (t != 0) {
        if (load64(t + 16) == TASK_WAITING) {
            if (load64(t + 32) == ident) {
                if ((load64(t + 56) & bit) != 0) {
                    store64(t + 32, 0 - 1);
                    store64(t + 56, 0);
                    store64(t + 16, TASK_READY);
                    n = n + 1;
                }
            }
        }
        t = load64(t + 24);
    }
    return n;
}

# One reactor step (mirror of async.cyr _async_step). Runs every TASK_READY task, capturing its
# return into the result slot (@40); a task that parks stays TASK_WAITING. If nothing ran and
# tasks are parked, block in kevent() once and wake whoever fired: fd readiness, a timer (the
# async_with_timeout sentinel, an interval tick) or a child's exit. Returns the count of tasks
# still live (0 = idle).
fn _async_step(rt): i64 {
    var kq = load64(rt);
    var active = 0;
    var ran = 0;
    var t = load64(rt + 8);
    while (t != 0) {
        if (load64(t + 16) == TASK_READY) {
            store64(rt + 40, t);            # current task, for the park helpers
            var r = fncall1(load64(t), load64(t + 8));
            ran = 1;
            if (load64(t + 16) == TASK_READY) {
                store64(t + 40, r);
                store64(t + 16, TASK_DONE);
            }
        }
        if (load64(t + 16) != TASK_DONE) { active = active + 1; }
        t = load64(t + 24);
    }
    if (active > 0) {
        if (ran == 0) {
            # Every live task is parked. Block in kevent() and wake whoever fired. kqueue
            # reports ONE event per (ident, filter), so the directions of one fd, a timer and a
            # pid arrive as distinct events.
            var evb[256];                   # 8 events x 32 B
            var nr = sys_kevent(kq, 0, 0, &evb, 8, 0);
            var ei = 0;
            while (ei < nr) {
                var eo = ei * KEV_SIZE;
                _async_kev_wake(rt, load64(&evb + eo), _async_kev_bit(load16(&evb + eo + 8)));
                ei = ei + 1;
            }
        }
    }
    return active;
}

# Drive the serial loop until either watched handle is DONE, or — both 0 — until idle.
fn _async_pump(rt, until_a, until_b): i64 {
    while (1 == 1) {
        if (until_a != 0) { if (load64(until_a + 16) == TASK_DONE) { return 0; } }
        if (until_b != 0) { if (load64(until_b + 16) == TASK_DONE) { return 0; } }
        if (_async_step(rt) == 0) { return 0; }
    }
}

# Run all spawned tasks to completion. No epfd to close (epfd == -1, never opened).
fn async_run(rt): i64 {
    _async_pump(rt, 0, 0);
    return 0;
}

# Await a spawned task's result (JoinHandle, F2). On the serial model the pump runs
# the task inline; returns its captured return value. Mirror of async.cyr task_join.
fn task_join(rt, handle): i64 {
    if (handle == 0) { return 0; }
    if (load64(handle + 16) != TASK_DONE) { _async_pump(rt, handle, 0); }
    return load64(handle + 40);
}

# Await every handle in handles[0..n), collecting results (mirror async.cyr, serial).
# v6.4.37 (P3).
fn async_join_all(rt, handles, n, results): i64 {
    var i = 0;
    while (i < n) {
        store64(results + i * 8, task_join(rt, load64(handles + i * 8)));
        i = i + 1;
    }
    return n;
}

# Await the first handle to complete; returns its index, or -1 if idle with none done.
# v6.4.37 (P3, serial).
fn async_select(rt, handles, n): i64 {
    while (1 == 1) {
        var i = 0;
        while (i < n) {
            var hnd = load64(handles + i * 8);          # mirror async.cyr: null-guard
            if (hnd != 0) { if (load64(hnd + 16) == TASK_DONE) { return i; } }
            i = i + 1;
        }
        if (_async_step(rt) == 0) {
            # mirror async.cyr: the idling step may itself have completed a handle
            i = 0;
            while (i < n) {
                var hd = load64(handles + i * 8);
                if (hd != 0) { if (load64(hd + 16) == TASK_DONE) { return i; } }
                i = i + 1;
            }
            return 0 - 1;
        }
    }
}

# Retire a task that may still be parked (the loser of a timeout race): mark it DONE so the
# reactor never re-runs it, and take its registrations out of the kqueue. A read/write filter is
# deleted only when no OTHER parked task still waits on it (kqueue keys by (ident, filter), so
# deleting it would silently drop that waiter too); a timer the task armed is always deleted.
# ⚠ Leaving them armed is not harmless: a level-triggered fd registration nobody waits on makes
# every later kevent() return at once, so the reactor spins instead of sleeping. No-op on a DONE
# task.
fn _async_retire(rt, t): i64 {
    if (t == 0) { return 0; }
    if (load64(t + 16) == TASK_DONE) { return 0; }
    var kq = load64(rt);
    var ident = load64(t + 32);
    var bits = load64(t + 56);
    var own = load64(t + 48);
    store64(t + 16, TASK_DONE);
    store64(t + 32, 0 - 1);
    store64(t + 56, 0);
    store64(t + 48, 0 - 1);
    if (bits != 0) {
        var left = _async_kev_mask(rt, ident);
        if ((bits & _KEV_READ) != 0) {
            if ((left & _KEV_READ) == 0) { _async_kev_change(kq, ident, _KEVF_READ, _EV_DELETE, 0, 0); }
        }
        if ((bits & _KEV_WRITE) != 0) {
            if ((left & _KEV_WRITE) == 0) { _async_kev_change(kq, ident, _KEVF_WRITE, _EV_DELETE, 0, 0); }
        }
        if ((bits & _KEV_PROC) != 0) { _async_kev_change(kq, ident, _KEVF_PROC, _EV_DELETE, 0, 0); }
    }
    if (own >= 0) { _async_kev_change(kq, own, _KEVF_TIMER, _EV_DELETE, 0, 0); }
    return 0;
}

# Deadline sentinel for async_with_timeout: parks on the one-shot EVFILT_TIMER its caller armed
# (ident = this task's ctx) and completes (-> 1) when it fires. ctx = { step, rt }.
fn _async_timeout_sentinel(ctx): i64 {
    if (load64(ctx) == 0) {
        store64(ctx, 1);
        _async_kev_park(load64(ctx + 8), ctx, _KEV_TIMER);
        return 0;
    }
    return 1;
}

# Await `handle` (an async_spawn / async_spawn_future return) with a deadline of `ms`
# milliseconds. Returns 1 if the task completed in time (its result is then in the handle's
# result slot, or via task_join), 0 if the deadline fired first (the still-pending task is
# retired: it will not run again and its kqueue registrations are removed), or -1 if the deadline
# could not be armed (the handle is then left as it was). Races the task against a one-shot
# EVFILT_TIMER sentinel on the reactor — the kqueue analogue of the epoll backend's timerfd
# sentinel; does NOT close the runtime. `ms <= 0` is a deadline that has already passed: the
# handle still gets the tasks that are READY now, but nothing that parks. v6.4.35 (P1).
# ⛔ Until 6.6.10 this joined with NO deadline and always returned 1: on this reactor a handle
# parked on an fd that never became ready waited for ever. CHANGELOG [6.6.10]
fn async_with_timeout(rt, handle, ms): i64 {
    if (handle == 0) { return 0; }      # null handle -> 0, not 1 (mirror async.cyr)
    if (load64(handle + 16) == TASK_DONE) { return 1; }
    var d = ms;
    if (d < 0) { d = 0; }
    var sctx = alloc_via(load64(rt + 32), 16);      # rt's allocator (arena-reclaimable)
    if (sctx == 0) { return 0 - 1; }
    store64(sctx, 0);
    store64(sctx + 8, rt);
    if (_async_kev_change(load64(rt), sctx, _KEVF_TIMER, _EV_ADD | _EV_ONESHOT, 0, d) < 0) {
        return 0 - 1;
    }
    var sentinel = async_spawn(rt, &_async_timeout_sentinel, sctx);
    if (sentinel == 0) {
        _async_kev_change(load64(rt), sctx, _KEVF_TIMER, _EV_DELETE, 0, 0);
        return 0 - 1;
    }
    store64(sentinel + 48, sctx);                   # retire disarms the timer if it never fired
    _async_pump(rt, handle, sentinel);
    # snapshot the winner BEFORE retiring (retire marks the loser DONE)
    var completed = 0;
    if (load64(handle + 16) == TASK_DONE) { completed = 1; }
    _async_retire(rt, handle);
    _async_retire(rt, sentinel);
    return completed;
}

# async_interval (agnos): a repeating reactor timer is a server-path primitive with no
# equivalent on the serial single-core client model (no timerfd/epoll). Returns 0
# (unscheduled); present so consumers stay target-agnostic. v6.4.35.
fn async_interval(rt, fp, arg, ms, tok): i64 {
    return 0;
}

# async subprocess (agnos): AGNOS has no clone-fork, so a reactor-driven subprocess
# is unsupported on the serial client target. Returns 0 / -1 (unscheduled); present so
# consumers stay target-agnostic. Mirror of async.cyr's P2 surface. v6.4.36.
fn async_spawn_process(rt, path, argv, envp): i64 {
    return 0;
}
# spawn + wait + timeout (agnos): no clone-fork, so unsupported. Returns -1. v6.4.36.
fn async_run_process(rt, path, argv, envp, ms): i64 {
    return 0 - 1;
}

# Park until `fd` is WRITABLE (EVFILT_WRITE). Mirror of the epoll backend.
fn async_wait_writable(rt, fd): i64 {
    return _async_kev_register(rt, fd, 4);
}

# Async TCP connect (agnos): no reactor / BSD non-blocking connect on the serial client
# model — unsupported, returns 0 (no handle). Present so consumers stay target-agnostic.
# v6.4.38.
fn async_connect(rt, addr, port): i64 {
    return 0;
}

# Async accept (agnos): no reactor / no server-accept on the serial client model —
# unsupported, returns 0 (no handle). Present so consumers stay target-agnostic. v6.4.44 R3.
fn async_accept(rt, listen_fd): i64 {
    return 0;
}

# recv task (agnos): a plain blocking read inline — no epoll. v6.4.39.
fn _async_recv_task(ctx): i64 {
    return sys_read(load64(ctx + 8), load64(ctx + 16), load64(ctx + 24));
}
# Async single-shot recv (agnos): spawn a task that blocking-reads into buf; task_join
# yields the byte count. Mirror of async.cyr's reactor recv, degraded to serial. v6.4.39.
fn async_recv(rt, fd, buf, len): i64 {
    var ctx = alloc_via(load64(rt + 32), 40);       # rt's allocator (mirror async.cyr)
    store64(ctx, 0);
    store64(ctx + 8, fd);
    store64(ctx + 16, buf);
    store64(ctx + 24, len);
    store64(ctx + 32, rt);
    return async_spawn(rt, &_async_recv_task, ctx);
}
# send task (agnos): a plain blocking write inline — no epoll. v6.4.39.
fn _async_send_task(ctx): i64 {
    return sys_write(load64(ctx + 8), load64(ctx + 16), load64(ctx + 24));
}
# Async single-shot send (agnos): spawn a task that blocking-writes from buf; task_join
# yields the byte count. Mirror of async.cyr's reactor send, degraded to serial. v6.4.39.
fn async_send(rt, fd, buf, len): i64 {
    var ctx = alloc_via(load64(rt + 32), 40);       # rt's allocator (mirror async.cyr)
    store64(ctx, 0);
    store64(ctx + 8, fd);
    store64(ctx + 16, buf);
    store64(ctx + 24, len);
    store64(ctx + 32, rt);
    return async_spawn(rt, &_async_send_task, ctx);
}

# Async DNS resolve (agnos): no reactor UDP round-trip on the serial client model —
# unsupported, returns 0 (no handle). Present so consumers stay target-agnostic. v6.4.40.
fn async_resolve(rt, ns_addr, ns_port, host): i64 {
    return 0;
}

# Sleep for `ms` milliseconds. AGNOS has a real sleep primitive (#41,
# sys_sleep_ms — halts until the 100 Hz tick), so this is a faithful sleep,
# not a stub. Guard ms<=0 (sys_sleep_ms caps at 1 h on the kernel side).
fn async_sleep_ms(ms): i64 {
    if (ms <= 0) { return 0; }
    sleep_ms(ms);
    return 0;
}

# Non-blocking read on Linux; on agnos fds are blocking and there is no fcntl,
# so this is a plain blocking read (the cooperative loop tolerates blocking on
# the single-core model).
fn async_read(fd, buf, len): i64 {
    return sys_read(fd, buf, len);
}

# Wait for `fd` to become readable. AGNOS has no epoll for arbitrary fds and
# its reads block until data, so the subsequent read already blocks — this is a
# no-op that returns immediately.
fn async_await_readable(fd): i64 {
    return 0;
}

# v6.5.27 — kqueue registration: register (fd, filter) on the runtime's kqueue and park the
# current task on it. `events` uses the epoll backend's bits (1 = readable, 4 = writable) so
# consumer code is identical across targets; they become EVFILT_READ / EVFILT_WRITE here.
# ⭐ kqueue needs NO union mask and NO modify-on-conflict: it keys by (ident, filter), so read and
# write are independent registrations and repeated EV_ADD of the same pair is an idempotent
# update, not an error (the -EEXIST the epoll backend fixed at v6.5.26 cannot happen).
fn _async_kev_register(rt, fd, events): i64 {
    var cur = load64(rt + 40);
    if (cur == 0) { return 0 - 1; }
    var kq = load64(rt);
    var rc = 0;
    if ((events & _KEV_READ) != 0) { rc = _async_kev_change(kq, fd, _KEVF_READ, _EV_ADD, 0, 0); }
    if (rc >= 0) {
        if ((events & _KEV_WRITE) != 0) { rc = _async_kev_change(kq, fd, _KEVF_WRITE, _EV_ADD, 0, 0); }
    }
    if (rc < 0) { return 0 - 1; }   # not parked: a caller that sees -1 can fall back to blocking I/O
    return _async_kev_park(rt, fd, events);
}

# Park until `fd` is READABLE. Mirror of the epoll backend's async_wait_fd.
fn async_wait_fd(rt, fd): i64 {
    return _async_kev_register(rt, fd, 1);
}

# Park until `fd` is readable OR writable. On kqueue this is two independent filter
# registrations on one ident — no union mask, no -EEXIST, unlike epoll.
fn async_wait_rw(rt, fd): i64 {
    return _async_kev_register(rt, fd, 5);
}

# v6.5.26 — one direction of a byte relay (agnos). The blocking read IS the wait on this
# target, so this is the epoll body minus the park. Returns bytes WRITTEN, 0 on clean EOF.
fn async_relay_once(rt, rfd, wfd, buf, len): i64 {
    var n = sys_read(rfd, buf, len);
    if (n <= 0) { return n; }
    return sys_write(wfd, buf, n);
}

# Run `fp(arg)` with a timeout. AGNOS has no fork, so there is no second
# process to bound; run the body INLINE (serial — mirrors thread_agnos.cyr's
# inline-body model) and return its result. `ms` is advisory / ignored here.
fn async_timeout(fp, arg, ms): i64 {
    return fncall1(fp, arg);
}
