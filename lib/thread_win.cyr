# thread_win.cyr — Windows (PE) threading: REAL preemptive threads (v6.0.61).
# Usage: included by lib/thread.cyr under #ifdef CYRIUS_TARGET_WIN.
# Requires: alloc.cyr, fnptr.cyr.
#
# Win32 has no clone/futex; this maps the cyrius thread surface onto kernel32
# (the PE-internal 0xF00N reroutes — see backend/pe/emit.cyr + backend/x86/emit.cyr):
#   thread_create → CreateThread (0xF007). The cyrius thread-body fn is a valid
#     MS-x64 ThreadProc directly — PE arg0 == RCX == lpParameter — so NO trampoline.
#   thread_join   → WaitForSingleObject(INFINITE) (0xF001) + CloseHandle (syscall 3).
#   mutex_*       → SRWLOCK: InitializeSRWLock (0xF008) / AcquireSRWLockExclusive
#     (0xF009) / ReleaseSRWLockExclusive (0xF00A) — an 8-byte in-place lock cell.
#   chan_*        → a SRWLOCK-protected FIFO ring whose waiters block on an I/O
#     completion port (6.6.16): recv blocks while empty and send while full, as on
#     Linux (CHAN_BLOCKING = 1). See the channel section below.
# Supersedes the v6.0.53 serial fallback. See
# 2026-06-03-windows-threading-stdlib-gap.md + the Windows nuances issue.
# NOTE: the bump allocator (alloc.cyr) is not itself thread-safe, so thread
# bodies should avoid concurrent alloc() (same as the Linux thread.cyr model);
# pass pre-allocated buffers via the arg pointer.
#
# The public surface MUST match lib/thread.cyr's so consumers stay
# target-agnostic: thread_create / thread_join / gettid / mutex_new /
# mutex_lock / mutex_unlock / chan_new / chan_send / chan_recv /
# chan_close / chan_try_recv.
#
# >>> include "lib/fnptr.cyr"
include "lib/fnptr.cyr"

# v6.5.44 — THREADS_CONCURRENT: does thread_create actually produce a SECOND thread?
# 1 = the body runs concurrently with the caller; 0 = it runs INLINE at create (serial peer).
# ⛔ This exists because the concurrency corpus could not tell the two apart. Every test in it
# passed on macOS while bodies ran inline — a serial backend satisfies "the worker ran", "join
# returned 0" and "the count is exact". A test that DISCRIMINATES must be guarded by capability
# (never by target name, never by errno — the v6.5.36 lesson), and this is that capability.
var THREADS_CONCURRENT = 0;   # serial fallback (bodies run inline)

# Create a real OS thread: CreateThread(NULL, 0, fp, arg, 0, NULL). fp is the
# cyrius thread-body fn pointer (&body) — a single-i64-param fn returning i64,
# which compiled for PE is already a valid MS-x64 ThreadProc (lpParameter arrives
# in RCX = the cyrius arg0 register). Returns the OS thread HANDLE (0 on failure),
# matching thread.cyr's "pointer or 0" contract. The 6 CreateThread params are
# packed into a struct + passed by address (the 0xF007 reroute reads them).
fn thread_create(fp, arg): i64 {
    alloc_init();
    _threads_active = 1;   # v6.3.17 PF-02: arm the shared-heap lock before CreateThread
    var a = alloc(48);
    if (a == 0) { return 0; }
    store64(a,      0);    # lpThreadAttributes = NULL
    store64(a + 8,  0);    # dwStackSize = 0 (default)
    store64(a + 16, fp);   # lpStartAddress = the cyrius body
    store64(a + 24, arg);  # lpParameter
    store64(a + 32, 0);    # dwCreationFlags = 0 (run immediately)
    store64(a + 40, 0);    # lpThreadId = NULL
    return syscall(61447, a);   # CreateThread → HANDLE in rax
}

# Join: WaitForSingleObject(handle, INFINITE) then CloseHandle. Mirrors
# thread.cyr's returns (-1 on a null handle, 0 on success). INFINITE = 0xFFFFFFFF.
fn thread_join(t): i64 {
    if (t == 0) { return 0 - 1; }
    syscall(61441, t, 4294967295);   # WaitForSingleObject(t, INFINITE)
    syscall(3, t);                    # CloseHandle(t)
    return 0;
}

# v6.5.8: detached spawn. Windows needs no unmap trampoline — the OS owns the thread
# stack and reclaims it at thread exit — so detaching is just dropping our reference:
# CreateThread then CloseHandle immediately. The thread keeps running; only the HANDLE
# is released, which is what would otherwise leak (a never-closed HANDLE is a kernel
# object leak, the PE-side analogue of thread.cyr's stranded 2 MiB mapping).
# Returns 1 on success, 0 on failure — boolean, matching thread.cyr, because there is
# deliberately nothing left to join.
fn thread_create_detached(fp, arg): i64 {
    var h = thread_create(fp, arg);
    if (h == 0) { return 0; }
    syscall(3, h);          # CloseHandle — the thread runs on
    return 1;
}

# v6.5.8: non-blocking completion test. WaitForSingleObject with a 0 timeout returns
# WAIT_OBJECT_0 (0) if signalled, WAIT_TIMEOUT (0x102 = 258) if still running.
# ⛔ VALID ONLY BEFORE `thread_join`. Join CONSUMES the handle — on Windows it
# CloseHandle()s it, so a post-join query inspects a closed handle and reports "not
# done" (caught on real cass hardware, by a test that asserted the wrong contract).
# The intended use is the reaper shape: poll while running, then join once this
# returns 1. After joining, the thread is done by definition and there is nothing
# left to ask.
fn thread_is_done(t): i64 {
    if (t == 0) { return 0 - 1; }
    if (syscall(61441, t, 0) == 0) { return 1; }
    return 0;
}

# Current thread id — the real Win32 GetCurrentThreadId (0xF00B reroute).
fn gettid(): i64 { return syscall(61451); }

# Mutex (MUTEX_SIZE + mutex_new/lock/unlock) now comes from lib/sync.cyr →
# lib/sync_windows.cyr, which is this same in-place SRWLOCK cell (InitializeSRWLock
# 0xF008 / AcquireSRWLockExclusive 0xF009 / ReleaseSRWLockExclusive 0xF00A). Moved
# to the single owner in v6.3.44 (issue 2026-07-03-duplicate-mutex-fns-thread-vs-
# sync-stdlib); thread.cyr includes sync.cyr at its top before routing here. The
# channel below uses mutex_* unchanged.

# Channel — the same 56-byte header as lib/thread.cyr:
#   { buf@0, cap@8, head@16, tail@24, count@32, lock@40 (an inline SRWLOCK), closed@48 }
# A BLOCKING channel since 6.6.16, because threads here are real CreateThread threads:
# chan_recv blocks until a value arrives and returns 0 once the channel is closed and empty;
# chan_send blocks while the ring is full and returns -1 once the channel is closed. That is
# lib/thread.cyr's contract.
# ⛔ Through 6.6.15 the ring was locked but nothing ever waited: chan_recv answered 0 when
# empty and chan_send failed with -1 when full, so a pool of workers looping on chan_recv
# read the 0 as "closed" and exited at once. Issue
# 2026-10-04-sandhi-macos-chan-serial-under-real-threads measured that shape on macOS.
#
# HOW IT WAITS. No futex-style wait (WaitOnAddress) or condition variable is routed on PE, and
# this stays lib-only. So a waiter blocks in GetQueuedCompletionStatus on an I/O completion
# port used as a COUNTING SEMAPHORE: PostQueuedCompletionStatus adds a token, and
# GetQueuedCompletionStatus(INFINITE) takes one, blocking while there are none. These are the
# reroutes 0xF01F / 0xF020 / 0xF021 that lib/async_win.cyr already uses. `buf` holds the cap
# slots, then a 32-byte wait block { rport@0, sport@8, rwait@16, swait@24 }. Receivers wait
# on rport and senders on sport; rwait / swait count the waiters still owed a token.
#   - A waiter finds, UNDER THE LOCK, that it must wait. It registers (+1 on its count),
#     unlocks, and takes a token from its port.
#   - A waker changes the state UNDER THE LOCK. If a waiter of the other kind is registered, it
#     CLAIMS it (-1 on the count), and after unlocking posts one token to that port.
#     chan_close claims every registered waiter of both kinds and posts a token for each.
#   - A woken waiter re-tests under the lock. If another thread took the value first, it
#     registers again.
# No wake-up is lost, because a token persists: a token posted before its waiter blocks is in
# the port when the waiter gets there. Each registration is claimed once, so the tokens posted
# never fall short of the waiters blocked. A token taken by a different waiter of the same
# kind still wakes a thread that can use it, and the one it was meant for stays registered.
# Receivers and senders use different ports, so a token never wakes the wrong kind.
# A port is created LAZILY, under the lock, by the first thread that has to wait on it, so a
# channel that never blocks holds no kernel object. A registered waiter implies its port
# exists, because the waiter created it before registering. Channels are never freed, and so
# neither are their ports.
# The port's concurrency value is 0x7FFFFFFF, not 0. With 0 (one running thread per CPU) the
# port releases no further waiter while that many threads it released are still running, so a
# posted token could sit behind busy workers. A semaphore must not hold a token back.
# If a port cannot be created, the waiter sleeps 1 ms and re-tests without registering:
# degraded, but it neither spins nor loses a value.
# CHAN_BLOCKING lives here rather than beside THREADS_CONCURRENT: the line that declares
# THREADS_CONCURRENT is a separate 6.6.16 change. CHANGELOG [6.6.16]
var CHAN_BLOCKING = 1;

# The wait block sits after the ring's cap slots.
fn _chan_wb(ch): i64 { return load64(ch) + load64(ch + 8) * 8; }

# Under the lock: the port at wb + off, created on first use. 0 if it cannot be created.
fn _chan_port(wb, off): i64 {
    var p = load64(wb + off);
    if (p != 0) { return p; }
    # CreateIoCompletionPort(INVALID_HANDLE_VALUE, NULL, 0, concurrency): a fresh port.
    p = syscall(0xF01F, 0 - 1, 0, 0, 2147483647);
    store64(wb + off, p);
    return p;
}

# Under the lock: claim one waiter registered at wb + cntoff. Returns the port to post its
# token to, or 0 when nobody is registered (and no syscall follows).
fn _chan_claim(wb, portoff, cntoff): i64 {
    var n = load64(wb + cntoff);
    if (n == 0) { return 0; }
    store64(wb + cntoff, n - 1);
    return load64(wb + portoff);
}

# Post `n` tokens to `port`: PostQueuedCompletionStatus(port, 0, 0, NULL).
fn _chan_post(port, n): i64 {
    var i = 0;
    while (i < n) {
        syscall(0xF021, port, 0, 0, 0);
        i = i + 1;
    }
    return 0;
}

# Block until a token arrives on `port`: GetQueuedCompletionStatus(port, .., INFINITE).
# Its outputs are not needed; a token carries no data.
fn _chan_await(port): i64 {
    var bytes[8];
    var key[8];
    var ovl[8];
    store64(&bytes, 0);
    store64(&key, 0);
    store64(&ovl, 0);
    syscall(0xF020, port, &bytes, &key, &ovl, 0 - 1);
    return 0;
}

# Under the lock: append val. The caller checked count < cap.
fn _chan_put(ch, val): i64 {
    var cap = load64(ch + 8);
    var tail = load64(ch + 24);
    store64(load64(ch) + tail * 8, val);
    store64(ch + 24, (tail + 1) % cap);
    store64(ch + 32, load64(ch + 32) + 1);
    return 0;
}

# Under the lock: remove and return the oldest value. The caller checked count > 0.
fn _chan_take(ch): i64 {
    var cap = load64(ch + 8);
    var head = load64(ch + 16);
    var v = load64(load64(ch) + head * 8);
    store64(ch + 16, (head + 1) % cap);
    store64(ch + 32, load64(ch + 32) - 1);
    return v;
}

# Under the lock, with the ring full (send) or empty (recv): register on the port at
# wb + portoff, counted at wb + cntoff. Returns the port to wait on, or 0 when it cannot be
# created (the caller then sleeps and re-tests, unregistered).
fn _chan_enlist(wb, portoff, cntoff): i64 {
    var p = _chan_port(wb, portoff);
    if (p != 0) { store64(wb + cntoff, load64(wb + cntoff) + 1); }
    return p;
}

# After unlocking: wait for the token a registration is owed, or sleep 1 ms unregistered.
fn _chan_block(p): i64 {
    if (p != 0) { _chan_await(p); return 0; }
    syscall(0xF00F, 1);         # Sleep(1)
    return 0;
}

fn chan_new(cap): i64 {
    alloc_init();
    var ch = alloc(56);
    if (ch == 0) { return 0; }
    var buf = alloc(cap * 8 + 32);
    if (buf == 0) { return 0; }
    store64(ch, buf);          # buf
    store64(ch + 8, cap);      # cap
    store64(ch + 16, 0);       # head
    store64(ch + 24, 0);       # tail
    store64(ch + 32, 0);       # count
    store64(ch + 40, 0);       # lock (inline SRWLOCK)
    syscall(61448, ch + 40);   # InitializeSRWLock(&lock)
    store64(ch + 48, 0);       # closed
    var wb = buf + cap * 8;
    store64(wb, 0);            # rport (created on first wait)
    store64(wb + 8, 0);        # sport
    store64(wb + 16, 0);       # rwait
    store64(wb + 24, 0);       # swait
    return ch;
}
# Send val. Blocks while the ring is full. Returns 0, or -1 once the channel is closed:
# `closed` is tested first and again after every wait.
fn chan_send(ch, val): i64 {
    var wb = _chan_wb(ch);
    while (1 == 1) {
        syscall(61449, ch + 40);   # AcquireSRWLockExclusive
        if (load64(ch + 48) != 0) { syscall(61450, ch + 40); return 0 - 1; }
        if (load64(ch + 32) < load64(ch + 8)) {
            _chan_put(ch, val);
            var rp = _chan_claim(wb, 0, 16);    # a receiver owed a token?
            syscall(61450, ch + 40);           # ReleaseSRWLockExclusive
            if (rp != 0) { _chan_post(rp, 1); }
            return 0;
        }
        var sp = _chan_enlist(wb, 8, 24);      # full: register on sport / swait
        syscall(61450, ch + 40);
        _chan_block(sp);
    }
    return 0;
}
# Non-blocking send (v6.4.84). Contract is IDENTICAL on all three backends:
#    0 → enqueued · -1 → closed · -2 → full
# Until 6.6.16 this backend's `chan_send` did not block and returned -1 when FULL, which is why
# this fn was never an alias for it. It still is not one: `chan_send` now waits.
# See lib/thread.cyr's `chan_try_send` for the rationale.
fn chan_try_send(ch, val): i64 {
    var wb = _chan_wb(ch);
    syscall(61449, ch + 40);   # AcquireSRWLockExclusive
    if (load64(ch + 48) != 0) { syscall(61450, ch + 40); return 0 - 1; }
    if (load64(ch + 32) >= load64(ch + 8)) { syscall(61450, ch + 40); return 0 - 2; }
    _chan_put(ch, val);
    var rp = _chan_claim(wb, 0, 16);
    syscall(61450, ch + 40);   # ReleaseSRWLockExclusive
    if (rp != 0) { _chan_post(rp, 1); }
    return 0;
}
# Dequeue the oldest value (FIFO), or 0 if empty (never blocks).
fn chan_try_recv(ch): i64 {
    var wb = _chan_wb(ch);
    syscall(61449, ch + 40);
    if (load64(ch + 32) == 0) { syscall(61450, ch + 40); return 0; }
    var v = _chan_take(ch);
    var sp = _chan_claim(wb, 8, 24);           # a sender owed a token?
    syscall(61450, ch + 40);
    if (sp != 0) { _chan_post(sp, 1); }
    return v;
}
# Receive. Blocks while the ring is empty and open. Returns the oldest value, or 0 once the
# channel is closed AND empty: a closed channel still drains what was queued before close.
fn chan_recv(ch): i64 {
    var wb = _chan_wb(ch);
    while (1 == 1) {
        syscall(61449, ch + 40);
        if (load64(ch + 32) > 0) {
            var v = _chan_take(ch);
            var sp = _chan_claim(wb, 8, 24);
            syscall(61450, ch + 40);
            if (sp != 0) { _chan_post(sp, 1); }
            return v;
        }
        if (load64(ch + 48) != 0) { syscall(61450, ch + 40); return 0; }
        var rp = _chan_enlist(wb, 0, 16);      # empty and open: register on rport / rwait
        syscall(61450, ch + 40);
        _chan_block(rp);
    }
    return 0;
}
# Close the channel, and wake every waiting sender and receiver: each is claimed and gets a
# token, re-tests, and sees `closed`.
fn chan_close(ch): i64 {
    var wb = _chan_wb(ch);
    syscall(61449, ch + 40);
    store64(ch + 48, 1);
    var nr = load64(wb + 16);
    var ns = load64(wb + 24);
    store64(wb + 16, 0);
    store64(wb + 24, 0);
    var rp = load64(wb);
    var sp = load64(wb + 8);
    syscall(61450, ch + 40);
    if (nr > 0) { _chan_post(rp, nr); }
    if (ns > 0) { _chan_post(sp, ns); }
    return 0;
}
