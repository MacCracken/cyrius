    }

    var remote = "/tmp/cyrius_polyfill_aa_smoke";
    var scp_rc = _scp_to(target, bin, remote);
    sys_unlink(bin);
    if (scp_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": scp to ");
        _p(target);
        _p(" failed (rc=");
        print_num(scp_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var cmd_sb = str_builder_new();
    str_builder_add_cstr(cmd_sb, "chmod +x ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " && ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, "; rc=$?; rm -f ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, "; exit $rc");
    var cmd = str_data(str_builder_build(cmd_sb));
