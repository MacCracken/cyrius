# check.cyr — full project audit dispatcher.
#
# Cyrius port of scripts/check.sh shipped at v5.9.1 as the first
# slot of the v5.9.x sovereignty pass (bash-toolchain → cyrius
# conversion). scripts/check.sh becomes a 1-line shim that builds
# build/cyrius_check on demand and dispatches here.
#
# What we run:
#   1. Self-host two-step (cycc → cc5b byte-identical)
#   2. Heap-map audit (sh tests/heapmap.sh)
#   3. Test suite (every .tcyr file under tests/tcyr/)
#   4. ~50 regression gates (sh tests/regression-X.sh)
#   5. Format walk (cyrfmt across lib/)
#   6. Lint walk (cyrlint across lib/)
#
# Each gate emits PASS/FAIL with ANSI color and increments
# pass/fail/total counters. Exit code = number of failed gates;
# 0 = all green.
#
# Architectural notes:
# * The 50+ regression-X.sh gates remain bash for v5.9.1 — those
#   batch-convert in v5.9.2-v5.9.4 per the roadmap. This dispatcher
#   spawns each via lib/process.cyr's run() (sovereign cyrius fork+
#   execve+wait — not sh -c).
# * `set -e` is deliberately not part of the cyrius dispatcher
#   semantics. Every gate captures its exit code into a local and
#   reports PASS/FAIL via _check(); a single gate failure does not
#   abort the full audit (matches the bash version's v5.7.29 fix).
# * Self-host gate inlines the stdin-pipe fork+execve+dup2 dance
#   that bash expressed as `cat src/main.cyr | $CC > $cc_a` —
#   ~25 LOC of cyrius primitives instead of a sh -c invocation.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"
include "lib/fnptr.cyr"
include "lib/flags.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"
include "lib/bounds.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fs.cyr"
include "lib/process.cyr"
include "lib/audit_walk.cyr"
include "lib/net.cyr"
include "lib/regression.cyr"

# ANSI color escapes — match scripts/check.sh's printf "\033[3Xm".
var ANSI_GREEN = "\033[32m";
var ANSI_RED   = "\033[31m";
var ANSI_RESET = "\033[0m";

# Discovered tool paths (resolved at startup).
var ROOT_PATH    = 0;   # repo root absolute path (cstring)
var CC_PATH      = 0;   # build/cycc (cstring)
var CYRFMT_PATH  = 0;   # build/cyrfmt or PATH-resolved cyrfmt (cstring)
var CYRLINT_PATH = 0;   # build/cyrlint or PATH-resolved cyrlint (cstring)
var CYRDOC_PATH  = 0;   # build/cyrdoc or PATH-resolved cyrdoc (cstring)
var CC_AARCH64_PATH = 0; # build/cycc_aarch64 cross-compiler (cstring)

# Counters.
var G_PASS = 0;
var G_FAIL = 0;
var G_TOTAL = 0;

# Cached environment pointer-array, built once at startup from
# /proc/self/environ. Child processes inherit this env via execve.
var ENVP_BUF = 0;       # raw environ buffer (null-separated KEY=VAL)
var ENVP_LEN = 0;
var ENVP_ARR = 0;       # null-terminated array of pointers into ENVP_BUF
var ENVP_COUNT = 0;
# v5.9.42: shared empty-envp pointer for the pre-v5.9.42 helpers
# that always called execve with `var envp[1]; store64(&envp, 0)`.
# Used by the lib/regression.cyr wrappers in this file to keep
# original call semantics — execve gets an empty environment.
var EMPTY_ENVP = 0;

# Convenience: print null-terminated c-string to stdout (no newline).
fn _p(cstr): i64 {
    print(cstr, strlen(cstr));
    return 0;
}

# Print "PASS"/"FAIL" line with name.
fn _check(name, exit_code): i64 {
    G_TOTAL = G_TOTAL + 1;
    _p("  ");
    if (exit_code == 0) {
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        G_PASS = G_PASS + 1;
    } else {
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        G_FAIL = G_FAIL + 1;
    }
    _p(": ");
    println(name);
    return 0;
}

fn _section(label): i64 {
    _p("── ");
    _p(label);
    println(" ──");
    return 0;
}

# Build absolute path under ROOT_PATH from a relative tail. Returns
# a freshly allocated null-terminated c-string.
fn _root_path(tail): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ROOT_PATH);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, tail);
    var s = str_builder_build(sb);
    return str_data(s);
}

# Resolve an executable: prefer in-repo build/<name>; otherwise
# fall back to ~/.cyrius/bin/<name> (the cyriusly-installed path).
# We don't probe arbitrary PATH because that requires shell-level
# `command -v` with the parent's env; the two well-known locations
# cover both fresh-checkout and installed-toolchain workflows.
fn _resolve_tool(rel_build_path, name): i64 {
    var absp = _root_path(rel_build_path);
    if (file_exists(absp) == 1) { return absp; }
    var home = getenv("HOME");
    if (home == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, home);
    str_builder_add_cstr(sb, "/.cyrius/bin/");
    str_builder_add_cstr(sb, name);
    var s = str_builder_build(sb);
    var cand = str_data(s);
    if (file_exists(cand) == 1) { return cand; }
    return 0;
}

# Build envp pointer array from /proc/self/environ. Called once
# at startup. lib/process.cyr's run() ships an empty envp, which
# leaves child shells without HOME/PATH/TMPDIR — incorrect for the
# audit gates (regression scripts depend on HOME for ~/.cyrius
# paths and PATH for cyrius-toolchain binary discovery). We
# rebuild the parent's env into a properly-terminated pointer
# array and pass it explicitly via execve in _gate_run().
fn _load_environ(): i64 {
    var cap = 65536;
    ENVP_BUF = alloc(cap);
    var fd = file_open("/proc/self/environ", 0, 0);
    if (fd < 0) { return 0; }
    ENVP_LEN = file_read(fd, ENVP_BUF, cap);
    file_close(fd);
    if (ENVP_LEN <= 0) { return 0; }
    # Count entries (null-separated) and allocate pointer array.
    var count = 0;
    var i = 0;
    while (i < ENVP_LEN) {
        if (load8(ENVP_BUF + i) == 0) { count = count + 1; }
        i = i + 1;
    }
    ENVP_COUNT = count;
    ENVP_ARR = alloc((count + 1) * 8);
    var ai = 0;
    var start = 0;
    var j = 0;
    while (j < ENVP_LEN) {
        if (load8(ENVP_BUF + j) == 0) {
            store64(ENVP_ARR + ai * 8, ENVP_BUF + start);
            ai = ai + 1;
            start = j + 1;
        }
        j = j + 1;
    }
    store64(ENVP_ARR + count * 8, 0);
    # v5.9.42: build EMPTY_ENVP — a freshly-alloc'd 1-elem array of
    # 0. Used by the lib/regression.cyr wrappers below for the
    # helpers that originally execve'd with `var envp[1]; store64(&envp, 0)`.
    EMPTY_ENVP = alloc(8);
    store64(EMPTY_ENVP, 0);
    return count;
}

# Spawn `sh script_abs` with the parent's env and return exit code.
# Replaces lib/process.cyr's run() (which ships empty envp). The
# child inherits stdin/stdout/stderr from the dispatcher, so any
# regression-script diagnostic surfaces inline on FAIL — same shape
# as bash's `cat /tmp/audit_X_$$` post-fail dump.
fn _gate_run(script_abs): i64 {
    var pid = sys_fork();
    if (pid < 0) { return 1; }
    if (pid == 0) {
        var argv[3];
        store64(&argv,     "/bin/sh");
        store64(&argv + 8, script_abs);
        store64(&argv + 16, 0);
        sys_execve("/bin/sh", &argv, ENVP_ARR);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
    return 1;
}

# Run a `sh tests/<rel>` gate. Returns the gate's exit code.
# On non-zero, the diagnostic is already on stderr from the first
# run (we don't re-spawn — the v5.7.29 bash convention only re-cat'd
# the captured tmp file, but our child shares stderr directly with
# the dispatcher).
fn _gate(name, script_rel): i64 {
    var script_abs = _root_path(script_rel);
    var rc = _gate_run(script_abs);
    _check(name, rc);
    return rc;
}

# ── tcyr-runner relay gate (v5.9.2) ─────────────────────────────
# Replaces the strict-template `tests/regression-X.sh` shape:
#   compile $ROOT/tests/tcyr/<NAME>.tcyr via stdin pipe to cycc,
#   run binary, grep "0 failed" from stdout, on PASS extract the
#   "<N> passed" count and print "  PASS: <inner_label> (<N>
#   assertions)" — same line the deleted bash scripts emitted —
#   then dispatcher's _check() prints the gate-level PASS/FAIL.
#
# Two output lines on PASS (matching the bash original's
# two-process layout):
#   "  PASS: <inner_label> (<N> assertions)"   [the inner gate]
#   "  PASS: <gate_name>"                      [the dispatcher]
#
# Six v5.9.1-converted gates use this: fdlopen, atomics,
# thread-local, thread-safety, flags, shadow-pam. Slot map:
# v5.9.2.
fn _tcyr_relay_gate(gate_name, inner_label, tcyr_basename): i64 {
    var tcyr_abs = _root_path("");
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ROOT_PATH);
    str_builder_add_cstr(sb, "/tests/tcyr/");
    str_builder_add_cstr(sb, tcyr_basename);
    var tcyr_path = str_data(str_builder_build(sb));

    var bin_path = _tmp_path("audit_relay_");
    var rc1 = _self_host_pipe(tcyr_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — compile error");
        sys_unlink(bin_path);
        _check(gate_name, 1);
        return 1;
    }
    sys_chmod(bin_path, 493);

    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_clean(bin_path, out_buf, out_cap);
    sys_unlink(bin_path);

    var failed = _tcyr_parse_failed(out_buf, out_n);
    if (failed != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        println(inner_label);
        _check(gate_name, 1);
        return 1;
    }
    var passed = _tcyr_parse_passed(out_buf, out_n);
    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ");
    _p(inner_label);
    _p(" (");
    print_num(passed);
    println(" assertions)");
    _check(gate_name, 0);
    return 0;
}

# Find " passed" anchor in buffer; walk back to leading int.
fn _tcyr_parse_passed(buf, n): i64 {
    var needle = " passed";
    var nlen = strlen(needle);
    var i = 0;
    while (i + nlen <= n) {
        if (_buf_eq(buf + i, needle, nlen) == 1) {
            var end = i;
            var start = end;
            while (start > 0) {
                var c = load8(buf + start - 1);
                if (c < 48) { return _aw_parse_leading_int(buf + start, end - start); }
                if (c > 57) { return _aw_parse_leading_int(buf + start, end - start); }
                start = start - 1;
            }
            return _aw_parse_leading_int(buf + start, end - start);
        }
        i = i + 1;
    }
    return 0;
}

# ── expected-output relay gate (v5.9.2) ─────────────────────────
# Replaces the strict-template `tests/regression-X.sh` shape:
#   compile $ROOT/tests/fixtures/<NAME>.cyr via stdin pipe to cycc,
#   run binary, exact-byte compare stdout against
#   $ROOT/tests/fixtures/<NAME>.expected. PASS prints
#   "  PASS: <inner_label> (<N> bytes match)"; the dispatcher's
#   _check() then prints the gate-level PASS/FAIL line.
#
# Four v5.9.2-converted gates use this: json_pretty, json_stream,
# json_pointer, test_lib.
fn _expected_output_gate(gate_name, inner_label, fixture_basename): i64 {
    var sb_src = str_builder_new();
    str_builder_add_cstr(sb_src, ROOT_PATH);
    str_builder_add_cstr(sb_src, "/tests/fixtures/");
    str_builder_add_cstr(sb_src, fixture_basename);
    str_builder_add_cstr(sb_src, ".cyr");
    var fixture_path = str_data(str_builder_build(sb_src));

    var sb_exp = str_builder_new();
    str_builder_add_cstr(sb_exp, ROOT_PATH);
    str_builder_add_cstr(sb_exp, "/tests/fixtures/");
    str_builder_add_cstr(sb_exp, fixture_basename);
    str_builder_add_cstr(sb_exp, ".expected");
    var expected_path = str_data(str_builder_build(sb_exp));

    var bin_path = _tmp_path("audit_eo_");
    var rc1 = _self_host_pipe(fixture_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — compile error");
        sys_unlink(bin_path);
        _check(gate_name, 1);
        return 1;
    }
    sys_chmod(bin_path, 493);

    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_clean(bin_path, out_buf, out_cap);
    sys_unlink(bin_path);

    var exp_cap = 65536;
    var exp_buf = alloc(exp_cap);
    var exp_n = file_read_all(expected_path, exp_buf, exp_cap);
    if (exp_n < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — expected file missing");
        _check(gate_name, 1);
        return 1;
    }

    var ok = 0;
    if (out_n == exp_n) { ok = _buf_eq(out_buf, exp_buf, out_n); }
    if (ok != 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        _p(" — output drift (");
        print_num(out_n);
        _p(" got, ");
        print_num(exp_n);
        println(" expected)");
        _check(gate_name, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ");
    _p(inner_label);
    _p(" (");
    print_num(out_n);
    println(" bytes match)");
    _check(gate_name, 0);
    return 0;
}

# Run a built binary with stdin=/dev/null and stderr=/dev/null, capture
# stdout into buf (up to cap bytes), return bytes read.
#
# Why a temp file instead of a pipe: lib/process.cyr's exec_capture uses
# a pipe + read-until-EOF. When the test fixture forks a helper (e.g.
# shadow_pam.tcyr → unix_chkpwd, a setuid helper that may persist as an
# orphan reparented to init), the helper inherits the test binary's
# stdout — so the pipe stays open via the orphan even after waitpid()
# on the test binary returns, and the dispatcher's read() blocks. The
# .sh equivalents masked this by piping into `grep` (which exited on
# its own when the test binary's main output was consumed and grep saw
# the predicate match), but a direct read on the pipe hangs.
#
# Routing stdout to a temp file avoids the pipe-EOF wait entirely:
# waitpid() blocks only on the direct child, and after it returns we
# read whatever the test binary wrote to the file. Orphan grandchildren
# may still hold the file fd open; we don't care — we already have the
# bytes we need.
# v5.9.42: thin wrapper over lib/regression.cyr.
fn _exec_capture_clean(bin_path, buf, buflen): i64 {
    return regression_exec_capture(bin_path, buf, buflen, EMPTY_ENVP);
}

# Returns 1 if the file at path contains the c-string `substr`,
# 0 otherwise. Generic source-grep canary helper for v5.9.3
# bespoke gates. v5.9.42: thin wrapper over lib/regression.cyr.
fn _file_contains_substr(path, substr): i64 {
    return regression_file_contains_substr(path, substr);
}

# Fork+exec bin_path with all 3 fds to /dev/null. Wait, return
# WEXITSTATUS of the direct child, or -1 on fork failure /
# signal exit. Used by gates that care about exit code only,
# not stdout.
# v5.9.42: thin wrapper over lib/regression.cyr.
fn _exec_run_clean(bin_path): i64 {
    return regression_exec_run(bin_path, EMPTY_ENVP);
}

# Compile fixture .cyr at fixture_path via cycc, run resulting
# binary, return its exit code (or -1 on compile / fork issue).
fn _compile_run_get_exit(fixture_path): i64 {
    var bin = _tmp_path("audit_xrun_");
    var rc = _self_host_pipe(fixture_path, CC_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        return 0 - 1;
    }
    sys_chmod(bin, 493);
    var ec = _exec_run_clean(bin);
    sys_unlink(bin);
    return ec;
}

# Bespoke gate: cycc accepts source files between 512 KB and 1 MB.
# Pinned to v5.7.10 — pre-v5.7.10 cycc had a 524288-byte cap.
# Generates a synthetic source ~700 KB of `# pad-line` comments
# (comments are stripped at lex without consuming the tok_names
# 128 KB cap; identifier padding would hit that cap before
# input_buf), pipes to cycc, runs the binary, asserts exit 0.
fn _input_1mb_gate(): i64 {
    var src_path = _tmp_path("audit_1mb_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) {
        _check("cycc accepts >512 KB source (heap reshuffle, v5.7.10)", 1);
        return 1;
    }
    # Build the source in a single buffer to minimize syscalls.
    # Each pad line is ~78 chars × 9000 ≈ 702 KB. Comfortably above
    # the old 512 KB cap, comfortably below the new 1 MB cap.
    var sb = str_builder_new();
    var i = 0;
    while (i < 9000) {
        str_builder_add_cstr(sb, "# pad-line ");
        # 5-digit zero-padded index, awk's "%05d" equivalent.
        if (i < 10) { str_builder_add_cstr(sb, "0000"); }
        else { if (i < 100) { str_builder_add_cstr(sb, "000"); }
            else { if (i < 1000) { str_builder_add_cstr(sb, "00"); }
                else { if (i < 10000) { str_builder_add_cstr(sb, "0"); }
                    else { } } } }
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, ": this is a no-op comment line for input-buffer sizing\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "var pad_done = 1;\nsyscall(60, 0);\n");
    var src_str = str_builder_build(sb);
    var src_data = str_data(src_str);
    var src_len = str_len(src_str);
    sys_write(fd, src_data, src_len);
    sys_close(fd);

    # Sanity: must be > 524288 (old cap) and < 1048576 (new cap).
    if (src_len < 524288) {
        sys_unlink(src_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": synthetic source ");
        print_num(src_len);
        println(" B is under the old 512 KB cap; regression doesn't exercise the cap");
        _check("cycc accepts >512 KB source (heap reshuffle, v5.7.10)", 1);
        return 1;
    }
    if (src_len > 1048576) {
        sys_unlink(src_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": synthetic source ");
        print_num(src_len);
        println(" B is over the new 1 MB cap; regression should fit");
        _check("cycc accepts >512 KB source (heap reshuffle, v5.7.10)", 1);
        return 1;
    }

    var ec = _compile_run_get_exit(src_path);
    sys_unlink(src_path);
    if (ec != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cycc + run on a ");
        print_num(src_len);
        _p(" B source produced exit ");
        print_num(ec);
        println(" (expected 0)");
        _check("cycc accepts >512 KB source (heap reshuffle, v5.7.10)", 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": cycc compiles + runs a ");
    print_num(src_len);
    println(" B source (pre-v5.7.10 cap was 524288 B)");
    _check("cycc accepts >512 KB source (heap reshuffle, v5.7.10)", 0);
    return 0;
}

# Bespoke gate: `if (fn_call())` and `var r = fn_call(); if (r)`
# branch correctly when r != 0 (v5.6.21 fix). Two sub-cases —
# var-bound and direct-call — each compiles a fixture, runs it,
# checks exit code matches the expected sentinel (99 / 77).
# Pre-v5.6.21 the bare-truthy branch fired on stale flags from
# inside the callee and mis-branched on every PASS path.
fn _truthy_after_fncall_gate(): i64 {
    var fix1 = _root_path("tests/fixtures/truthy/var.cyr");
    var fix2 = _root_path("tests/fixtures/truthy/direct.cyr");
    var rc1 = _compile_run_get_exit(fix1);
    var rc2 = _compile_run_get_exit(fix2);
    var fail = 0;
    if (rc1 != 99) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": bare-truthy-after-fncall (var r): exit ");
        print_num(rc1);
        println(" (expected 99). v5.6.x _flags_reflect_rax stale-flag regression has returned.");
        fail = 1;
    }
    if (rc2 != 77) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": bare-truthy-direct-fncall: exit ");
        print_num(rc2);
        println(" (expected 77).");
        fail = 1;
    }
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": bare-truthy after fn-call returns correct branch");
    }
    _check("bare-truthy 'if (r)' after fn-call branches correctly (v5.6.21 fix)", fail);
    return fail;
}

# Bespoke gate: `object;` mode emits `_cyrius_init` with
# STB_GLOBAL (v3.4.14 → silently flipped to LOCAL at v4.6.0-alpha2
# → restored at v5.4.9 after mabda's GPU-integration build broke).
# Compiles a 2-line `object; fn x() { return 0; }` source via cycc,
# parses the resulting ELF object's symbol table directly (no
# external readelf), looks up `_cyrius_init`, asserts the binding
# (high nibble of st_info) is 1 = STB_GLOBAL.
fn _object_init_gate(): i64 {
    var src_path = _tmp_path("audit_oinit_src_");
    var src_fd = sys_open(src_path, 577, 420);
    if (src_fd < 0) {
        _check("_cyrius_init STB_GLOBAL in object; mode", 1);
        return 1;
    }
    var src_text = "object;\nfn x() { return 0; }\n";
    sys_write(src_fd, src_text, strlen(src_text));
    sys_close(src_fd);

    var obj_path = _tmp_path("audit_oinit_obj_");
    var rc = _self_host_pipe(src_path, CC_PATH, obj_path);
    sys_unlink(src_path);
    if (rc != 0) {
        sys_unlink(obj_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": object; fixture did not compile (rc=");
        print_num(rc);
        println(")");
        _check("_cyrius_init STB_GLOBAL in object; mode", 1);
        return 1;
    }

    var buf_cap = 1048576;
    var buf = alloc(buf_cap);
    var n = file_read_all(obj_path, buf, buf_cap);
    sys_unlink(obj_path);
    if (n <= 0) {
        _check("_cyrius_init STB_GLOBAL in object; mode", 1);
        return 1;
    }

    # ELF64 header (little-endian on x86_64): e_shoff @ 40 (u64),
    # e_shentsize @ 58 (u16), e_shnum @ 60 (u16). Walk section
    # headers to find SHT_SYMTAB (sh_type == 2). Each section
    # header is e_shentsize bytes; sh_type @ +4, sh_offset @ +24,
    # sh_size @ +32, sh_link @ +40.
    var e_shoff = load64(buf + 40);
    var e_shentsize = load16(buf + 58);
    var e_shnum = load16(buf + 60);

    var symtab_off = 0;
    var symtab_size = 0;
    var symtab_link = 0;
    var i = 0;
    while (i < e_shnum) {
        var sh = buf + e_shoff + i * e_shentsize;
        var sh_type = load32(sh + 4);
        if (sh_type == 2) {                 # SHT_SYMTAB
            symtab_off = load64(sh + 24);
            symtab_size = load64(sh + 32);
            symtab_link = load32(sh + 40);
        }
        i = i + 1;
    }

    if (symtab_off == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": no SHT_SYMTAB section in .o");
        _check("_cyrius_init STB_GLOBAL in object; mode", 1);
        return 1;
    }

    # The associated strtab is symtab_link's section header.
    var strtab_sh = buf + e_shoff + symtab_link * e_shentsize;
    var strtab_off = load64(strtab_sh + 24);

    # Walk symbol entries. Elf64_Sym is 24 bytes: st_name @ +0
    # (u32 — offset into strtab), st_info @ +4 (u8 — high nibble
    # is the bind, low nibble is the type).
    var entries = symtab_size / 24;
    var found_bind = 0 - 1;
    var j = 0;
    while (j < entries) {
        var sym = buf + symtab_off + j * 24;
        var st_name = load32(sym);
        var name_ptr = buf + strtab_off + st_name;
        if (streq(name_ptr, "_cyrius_init") == 1) {
            var st_info = load8(sym + 4);
            found_bind = st_info / 16;       # high nibble
            j = entries;
        } else {
            j = j + 1;
        }
    }

    if (found_bind == 0 - 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": _cyrius_init missing from .o symbol table");
        _check("_cyrius_init STB_GLOBAL in object; mode", 1);
        return 1;
    }

    if (found_bind != 1) {                   # STB_GLOBAL == 1
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": _cyrius_init bind=");
        print_num(found_bind);
        println(" (expected 1=STB_GLOBAL — see v5.4.9 regression)");
        _check("_cyrius_init STB_GLOBAL in object; mode", 1);
        return 1;
    }

    _check("_cyrius_init STB_GLOBAL in object; mode", 0);
    return 0;
}

# Bespoke gate: main_aarch64_macho.cyr cross-build smoke
# (v5.6.40 — pinned after the file silently broke when v5.6.12 O3a
# shipped IR_RAW_EMIT markers and main_aarch64_macho.cyr was
# missing `include "src/common/ir.cyr"`). Compiles the cross-
# scaffold via cycc, verifies output is >100 KB and starts with
# the ELF magic 7f 45 4c 46. No execution — host-side the binary
# is a Linux ELF that *emits* Mach-O.
fn _macho_cross_build_gate(): i64 {
    var src = _root_path("src/main_aarch64_macho.cyr");
    var out = _tmp_path("audit_macho_cross_");
    var rc = _self_host_pipe(src, CC_PATH, out);
    if (rc != 0) {
        sys_unlink(out);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": main_aarch64_macho.cyr did not compile (rc=");
        print_num(rc);
        println(")");
        _check("main_aarch64_macho.cyr compiles to ELF", 1);
        return 1;
    }
    var sz = _file_size(out);
    if (sz < 100000) {
        sys_unlink(out);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cc5_aarch64_macho_cross output too small (");
        print_num(sz);
        println(" B; expected >100KB)");
        _check("main_aarch64_macho.cyr compiles to ELF", 1);
        return 1;
    }
    # Read first 4 bytes; ELF magic is 0x7f 'E' 'L' 'F' = 7f 45 4c 46.
    var magic_buf[1];
    var fd = sys_open(out, 0, 0);
    if (fd >= 0) {
        sys_read(fd, &magic_buf, 4);
        sys_close(fd);
    }
    sys_unlink(out);
    var b0 = load8(&magic_buf);
    var b1 = load8(&magic_buf + 1);
    var b2 = load8(&magic_buf + 2);
    var b3 = load8(&magic_buf + 3);
    if (b0 != 127) { _check_macho_magic_fail(b0, b1, b2, b3); return 1; }
    if (b1 != 69)  { _check_macho_magic_fail(b0, b1, b2, b3); return 1; }
    if (b2 != 76)  { _check_macho_magic_fail(b0, b1, b2, b3); return 1; }
    if (b3 != 70)  { _check_macho_magic_fail(b0, b1, b2, b3); return 1; }
    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": cc5_aarch64_macho_cross built (");
    print_num(sz);
    println(" B, ELF)");
    _check("main_aarch64_macho.cyr compiles to ELF", 0);
    return 0;
}

fn _check_macho_magic_fail(b0, b1, b2, b3): i64 {
    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": output is not ELF (magic: ");
    print_num(b0);
    _p(" ");
    print_num(b1);
    _p(" ");
    print_num(b2);
    _p(" ");
    print_num(b3);
    println(")");
    _check("main_aarch64_macho.cyr compiles to ELF", 1);
    return 0;
}

# Source-grep canary: aarch64 EB codebuf cap (v5.7.34).
# Asserts src/backend/aarch64/emit.cyr has the v5.7.27 3 MB cap
# present AND does NOT have the pre-v5.7.27 512 KB cap (canary
# against accidental revert). No execution — pure grep.
fn _aarch64_codebuf_cap_gate(): i64 {
    var emit_path = _root_path("src/backend/aarch64/emit.cyr");
    if (file_exists(emit_path) != 1) {
        _p("  skip: ");
        _p(emit_path);
        println(" missing");
        _check("aarch64 EB codebuf cap matches v5.7.27 region size (3 MB; v5.7.34)", 0);
        return 0;
    }
    var has_3mb = _file_contains_substr(emit_path, "if (cp >= 3145728)");
    var has_512kb = _file_contains_substr(emit_path, "if (cp >= 524288)");
    var fail = 0;
    if (has_3mb != 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": aarch64 EB codebuf cap < 3 MB — re-grow to match v5.7.27");
        fail = 1;
    }
    if (has_512kb == 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": aarch64 EB still has the 512 KB cap (canary tripped)");
        fail = 1;
    }
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": aarch64 EB codebuf cap matches v5.7.27 region size (3 MB; v5.7.34)");
    }
    _check("aarch64 EB codebuf cap matches v5.7.27 region size (3 MB; v5.7.34)", fail);
    return fail;
}

# ── Self-host gate — inline pipe-fork-exec ──────────────────────
# bash:
#   cat $ROOT/src/main.cyr | $CC > $cc_a 2>/dev/null
# Reads source file, opens out_path for write, forks: child gets
# stdin from the pipe + stdout to out_path, then execve's compiler.
# Parent writes source bytes to write end, waits, returns child's
# exit status.
fn _self_host_pipe(src_path, compiler_path, out_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var out_fd = sys_open(out_path, 577, 420);   # O_WRONLY|O_CREAT|O_TRUNC | 0644
    if (out_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[3];
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[1];
        store64(&envp, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

# Sibling of _self_host_pipe: pipes src_path to compiler_path's
# stdin, redirects compiler's stdout to /dev/null and stderr to
# stderr_path. Returns child's wait-status. Used by gates that
# verify cycc's error/warning diagnostics.
fn _compile_capture_stderr(src_path, compiler_path, stderr_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var err_fd = sys_open(stderr_path, 577, 420);
    if (err_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(err_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(err_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(err_fd, 2);
        sys_close(err_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 1); sys_close(devnull); }
        var argv[3];
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[1];
        store64(&envp, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(err_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

# Sub-case helper for stderr-grep gates. Compiles src_str via cycc,
# captures stderr, checks for the expected substring presence.
# want_present == 1: stderr MUST contain expect_substr (warn fired).
# want_present == 0: stderr MUST NOT contain expect_substr (no
# false-positive). Returns 0 on PASS, 1 on FAIL. Per-case label
# is printed only on FAIL.
fn _stderr_match_subcase(case_label, src_str, expect_substr, want_present): i64 {
    var src_path = _tmp_path("audit_smc_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { return 1; }
    sys_write(fd, src_str, strlen(src_str));
    sys_close(fd);

    var err_path = _tmp_path("audit_smc_err_");
    _compile_capture_stderr(src_path, CC_PATH, err_path);
    sys_unlink(src_path);

    var got = _file_contains_substr(err_path, expect_substr);
    sys_unlink(err_path);

    if (want_present == 1) {
        if (got != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": ");
            _p(case_label);
            _p(" — stderr missing: ");
            println(expect_substr);
            return 1;
        }
    } else {
        if (got == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": ");
            _p(case_label);
            _p(" — stderr contains forbidden: ");
            println(expect_substr);
            return 1;
        }
    }
    return 0;
}

# Find first occurrence of needle bytes in buf[0..n]. Returns
# offset, or -1 if not found.
fn _find_bytes(buf, n, needle, nlen): i64 {
    if (nlen == 0) { return 0; }
    if (nlen > n) { return 0 - 1; }
    var i = 0;
    while (i <= n - nlen) {
        if (_buf_eq(buf + i, needle, nlen) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Bespoke gate: kmode emit order (v5.7.19; agnos boot regression).
# Compiles a minimal `kernel;` source with two recognizable byte
# markers — top-level asm 4× 0xF4 (HLT) and a single gvar init
# emitting REX.W `mov rcx, imm64` = 48 b9 ... — and asserts the
# asm marker's file offset is strictly less than the first 48 b9
# sequence. Pre-v5.7.19 cycc emitted gvar inits before top-level
# asm; in kmode the multiboot loader hands control in 32-bit
# protected mode, so a 64-bit `mov [rcx], rax` before the
# boot-shim long-mode transition triple-faulted on real hardware.
#
# v5.11.64 fixture update: the gvar RHS is `0xDEADBEE0 | 0xF`
# (arithmetic, not a bare INT literal). The .64 static-init pass
# routes `var X = INT_LITERAL ;` through the file-image bytes
# instead of a runtime store — so a bare-literal RHS no longer
# emits the 48 b9 marker the test relies on. Arithmetic RHS
# keeps the runtime-store path, preserving the v5.7.19 invariant
# this gate exists to enforce.
fn _kmode_emit_order_gate(): i64 {
    var src_path = _tmp_path("audit_kmode_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) {
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }
    var src = "kernel;\n\nvar marker_var = 0xDEADBEE0 | 0xF;\n\nasm { 0xF4; 0xF4; 0xF4; 0xF4; }\n";
    sys_write(fd, src, strlen(src));
    sys_close(fd);

    var bin_path = _tmp_path("audit_kmode_bin_");
    var rc = _self_host_pipe(src_path, CC_PATH, bin_path);
    sys_unlink(src_path);
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": kmode compile (rc=");
        print_num(rc);
        println(")");
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }

    var cap = 524288;
    var buf = alloc(cap);
    var n = file_read_all(bin_path, buf, cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }

    # Build the two needle byte sequences via store8 (cyrius string
    # literals can't carry raw 0xF4 / 0x48 bytes ergonomically).
    var asm_needle[1];
    store8(&asm_needle,     0xF4);
    store8(&asm_needle + 1, 0xF4);
    store8(&asm_needle + 2, 0xF4);
    store8(&asm_needle + 3, 0xF4);
    var gvar_needle[1];
    store8(&gvar_needle,     0x48);
    store8(&gvar_needle + 1, 0xB9);

    var asm_off = _find_bytes(buf, n, &asm_needle, 4);
    var gvar_off = _find_bytes(buf, n, &gvar_needle, 2);

    if (asm_off < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": asm marker (f4 f4 f4 f4) not found in kmode binary");
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }
    if (gvar_off < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": gvar-init marker (48 b9) not found in kmode binary");
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }
    if (asm_off >= gvar_off) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": asm marker at byte ");
        print_num(asm_off);
        _p(" not before gvar init at byte ");
        print_num(gvar_off);
        println("");
        println("    This is the v5.7.19 regression — kmode emit order broken;");
        println("    agnos kernel will triple-fault on multiboot entry.");
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": kmode emit order — asm (offset ");
    print_num(asm_off);
    _p(") before gvar init (offset ");
    print_num(gvar_off);
    println(")");
    _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 0);
    return 0;
}

# Sub-case helper: run cyrfmt against fixture_path, capture
# stdout, byte-compare against fixture (idempotency check).
# Returns 0 on PASS, 1 on FAIL. Per-case label printed only on
# FAIL, with a brief size diff for diagnostic.
fn _cyrfmt_idempotent_subcase(case_label, fixture_path): i64 {
    var args = vec_new();
    vec_push(args, CYRFMT_PATH);
    vec_push(args, fixture_path);
    var cap = 65536;
    var out_buf = alloc(cap);
    var out_n = exec_capture(args, out_buf, cap);

    var orig_buf = alloc(cap);
    var orig_n = file_read_all(fixture_path, orig_buf, cap);
    if (orig_n < 0) { orig_n = 0; }

    var ok = 0;
    if (out_n == orig_n) { ok = _buf_eq(out_buf, orig_buf, out_n); }
    if (ok != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(case_label);
        _p(" — cyrfmt output drifted (");
        print_num(out_n);
        _p(" got, ");
        print_num(orig_n);
        println(" original)");
        return 1;
    }
    return 0;
}

# Bespoke gate: cyrfmt skips `{` / `}` tracking inside `#`
# comments and `"..."` string literals (v5.7.22; agnos issue).
# Pre-v5.7.22 the brace-counter incremented on every `{` and `}`
# regardless of context; a doc comment quoting `asm { mov cr3,
# rax; }` re-indented the next comment line, surfacing as
# spurious `cyrfmt --check` NEEDS-FORMAT in agnos kernel CI.
# Four sub-cases: asm-in-doc-comment, string-with-braces,
# well-formed (regression coverage), mixed.
fn _cyrfmt_comment_braces_gate(): i64 {
    if (CYRFMT_PATH == 0) {
        _p("  skip: cyrfmt not built");
        println("");
        _check("cyrfmt skips {/} inside # comments + string literals (v5.7.22; agnos issue)", 0);
        return 0;
    }
    if (file_exists(CYRFMT_PATH) != 1) {
        _p("  skip: cyrfmt not built");
        println("");
        _check("cyrfmt skips {/} inside # comments + string literals (v5.7.22; agnos issue)", 0);
        return 0;
    }
    var fail = 0;
    fail = fail + _cyrfmt_idempotent_subcase("asm-in-doc-comment",
        _root_path("tests/fixtures/cyrfmt_braces/asm_in_doc.cyr"));
    fail = fail + _cyrfmt_idempotent_subcase("string-with-braces",
        _root_path("tests/fixtures/cyrfmt_braces/string_with_braces.cyr"));
    fail = fail + _cyrfmt_idempotent_subcase("well-formed",
        _root_path("tests/fixtures/cyrfmt_braces/well_formed.cyr"));
    fail = fail + _cyrfmt_idempotent_subcase("mixed",
        _root_path("tests/fixtures/cyrfmt_braces/mixed.cyr"));
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrfmt skips braces in comments/strings (4/4 cases)");
    }
    _check("cyrfmt skips {/} inside # comments + string literals (v5.7.22; agnos issue)", fail);
    return fail;
}

# v5.11.38 — drift-prevention static-analysis gate for the path-A
# parser-to-emit named-op refactor (.35-.37). After v5.11.37 ship
# the baseline is **zero direct emits in parse_*.cyr** — every
# `EB(S, 0x..)` / `E2(...)` / `E3(...)` / `EW(...)` / `E8(...)` was
# replaced with a named-op call. This gate scans the 6 parse_*.cyr
# files for those patterns and fails on any hit, preventing future
# drift (the v5.7.11 lesson: drift accumulates silently when no
# gate watches for it). Heuristic-only; relies on the simple
# observation that the patterns are unambiguous when present —
# they don't appear in comments / strings / identifiers anywhere
# in the current parse_*.cyr files. Reference:
# `docs/audit/2026-04-27-cx-direct-emit-inventory.md` § "Drift-
# prevention follow-up".

# Scan a single parse_*.cyr file for direct-emit patterns. Returns
# the hit count (0 = pass for that file).
fn _parse_drift_scan(path, buf, cap): i64 {
    var n = file_read_all(path, buf, cap);
    if (n < 0) { return 0; }     # missing file — not a failure
    var hits = 0;
    hits = hits + _count_substr_buf(buf, n, "EB(S, 0x");
    hits = hits + _count_substr_buf(buf, n, "E2(S, 0x");
    hits = hits + _count_substr_buf(buf, n, "E3(S, 0x");
    hits = hits + _count_substr_buf(buf, n, "EW(S, 0x");
    hits = hits + _count_substr_buf(buf, n, "E8(S, 0x");
    if (hits > 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(path);
        _p(" — direct-emit site(s) found (should be 0 after path-A v5.11.35-.37)\n");
    }
    return hits;
}

fn _parse_emit_drift_gate(): i64 {
    var cap = 262144;     # 256 KB — fits any parse_*.cyr
    var buf = alloc(cap);
    var fail = 0;
    # Scope: all 6 parse files. v5.11.38 covered the 5 audited
    # leaves; v5.11.39 added `ESWITCH_DISPATCH_PRE` +
    # `ESWITCH_DISPATCH_TABLE` named ops that closed parse.cyr's
    # switch-jump-table direct emits. parse.cyr now joins the gate.
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse.cyr"),       buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_ctrl.cyr"),  buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_decl.cyr"),  buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_expr.cyr"),  buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_fn.cyr"),    buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_types.cyr"), buf, cap);
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": no direct emits in all 6 parse_*.cyr files (path-A baseline at v5.11.39)\n");
    }
    _check("path-A drift gate: parse_*.cyr direct-emit zero baseline (v5.11.39)", fail);
    return fail;
}

# v5.11.45: build/cycc contamination gate. Scans the committed
# build/cycc binary for mabda/wgpu strings — symptoms of the slip
# at v5.11.28/.29 (silently fixed .30) and v5.11.43 (fixed .44)
# where some other binary got cp'd over build/cycc before commit.
# A legitimate cycc (compiled from src/) NEVER contains these
# strings; any hit = contamination. Fail-fast guard.
fn _cc5_contamination_gate(): i64 {
    var path = _root_path("build/cycc");
    var cap = 2097152;    # 2 MB — fits cycc (~821 KB) with headroom
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap);
    if (n < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": build/cycc not readable\n");
        _check("build/cycc contamination gate (v5.11.45)", 1);
        return 1;
    }
    var hits = 0;
    hits = hits + _count_substr_buf(buf, n, "mabda: gpu");
    hits = hits + _count_substr_buf(buf, n, "wgpuDevice");
    hits = hits + _count_substr_buf(buf, n, "compute_pipeline");
    if (hits > 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": build/cycc contains mabda/wgpu strings — likely contaminated (see CHANGELOG [5.11.44] postmortem)\n");
    }
    _check("build/cycc contamination gate (v5.11.45; no mabda/wgpu strings)", hits);
    return hits;
}

# Sibling of _self_host_pipe with CYRIUS_KERNEL=1 + CYRIUS_ELF64_KERNEL=1 in
# envp. Used by _elf64_kernel_entry_gate to compile a kernel source through
# the EMITELF64_KERNEL path. Returns the child's wait-status (load32-shape).
fn _self_host_pipe_elf64k(src_path, compiler_path, out_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[3];
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[4];
        store64(&envp,      "CYRIUS_KERNEL=1");
        store64(&envp + 8,  "CYRIUS_ELF64_KERNEL=1");
        store64(&envp + 16, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

# Locate the 8-byte little-endian encoding of `val` in [buf, buf+n).
# Returns the file offset on first match, or -1 if absent. Used by
# _elf64_kernel_entry_gate to detect baked absolute addresses.
fn _find_u64_le(buf, n, val): i64 {
    var i = 0;
    var limit = n - 8;
    while (i <= limit) {
        if (load64(buf + i) == val) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Gate: with CYRIUS_ELF64_KERNEL=1, FIXUP's `entry` value must match
# EMITELF64_KERNEL's header layout (0x100000 + 120 + 48 = 0x1000A8),
# not the legacy ELF32 + multiboot1 entry (0x100000 + 84 + 12 = 0x100060).
# If they disagree, every absolute fixup shifts by 0x48 = 72 bytes and
# string / global loads target the wrong VA — manifests as garbled
# serial output post GRUB-EFI handoff (the v5.11.43 → v5.11.45 agnos
# UEFI boot regression). See CHANGELOG [5.11.46].
#
# Test vehicle: programs/kernel_hello.cyr — a kernel sample with a
# known string literal ("Hello from Cyrius!"). After compile:
#   - header e_entry (file offset 24) must be 0x1000A8.
#   - the string lives at p_vaddr + file_offset; its true VA is the
#     8-byte LE value that should appear baked into the code section.
#   - the OLD-entry-shifted VA (true_va - 0x48) must NOT appear; that
#     value is the bug-signature of FIXUP using the wrong entry.
fn _elf64_kernel_entry_gate(): i64 {
    var label = "kmode==1 + CYRIUS_ELF64_KERNEL=1: FIXUP entry agrees with EMITELF64_KERNEL header (v5.11.46; agnos UEFI boot)";
    var src_path = _root_path("programs/kernel_hello.cyr");
    var bin_path = _tmp_path("audit_elf64k_bin_");
    var rc = _self_host_pipe_elf64k(src_path, CC_PATH, bin_path);
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": elf64-kernel compile (rc=");
        print_num(rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var cap = 524288;
    var buf = alloc(cap);
    var n = file_read_all(bin_path, buf, cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _check(label, 1);
        return 1;
    }

    # ELF64 magic + class + endian sanity. Identifies a malformed
    # output before we trust e_entry / p_vaddr.
    if (load64(buf) != 0x00010102464C457F) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": elf64-kernel output is not a valid ELF64 LSB binary");
        _check(label, 1);
        return 1;
    }

    var e_entry = load64(buf + 24);
    if (e_entry != 0x1000A8) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ELF64 e_entry = ");
        print_num(e_entry);
        println(" (expected 1048744 = 0x1000A8 = 0x100000 + 120 + 48)");
        _check(label, 1);
        return 1;
    }

    # Locate "Hello from Cyrius!" — kernel_hello.cyr's vga_print() arg.
    var sneedle = "Hello from Cyrius!";
    var s_off = _find_bytes(buf, n, sneedle, 18);
    if (s_off < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": kernel_hello marker string not present in compiled binary");
        _check(label, 1);
        return 1;
    }

    var true_va = 0x100000 + s_off;
    var old_va  = true_va - 0x48;
    var bad_at  = _find_u64_le(buf, n, old_va);
    if (bad_at >= 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": FIXUP regressed — OLD-entry-shifted address ");
        print_num(old_va);
        _p(" (true_va - 72) at file offset ");
        print_num(bad_at);
        _p("; true VA ");
        print_num(true_va);
        println("");
        println("    This is the v5.11.43 → v5.11.45 agnos UEFI boot bug. FIXUP's");
        println("    kmode==1 entry must gate on _TARGET_ELF64_KERNEL — see CHANGELOG [5.11.46].");
        _check(label, 1);
        return 1;
    }

    # Positive sanity — the true-VA pattern must appear at least once
    # (otherwise the test vehicle didn't actually exercise a string
    # fixup and the negative check above is vacuous).
    var good_at = _find_u64_le(buf, n, true_va);
    if (good_at < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": no fixup baked the string's true VA ");
        print_num(true_va);
        println(" (test vehicle didn't exercise a fixup — gate is vacuous)");
        _check(label, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ELF64 kernel entry agreement — e_entry=0x1000A8, fixup baked true VA ");
    print_num(true_va);
    println("");
    _check(label, 0);
    return 0;
}

# Sibling of _self_host_pipe with CYRIUS_TARGET_EFI=1 in envp. Used
# by _efi_emit_gate to compile programs/efi_probe.cyr through the
# PE32+ EFI Application emit path. Returns the child's wait-status.
fn _self_host_pipe_efi(src_path, compiler_path, out_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[3];
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[3];
        store64(&envp,     "CYRIUS_TARGET_EFI=1");
        store64(&envp + 8, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

# Read u16 little-endian from buf+off. Used by _efi_emit_gate to
# pull Subsystem / DllCharacteristics / COFF Characteristics out
# of the PE optional header.
fn _read_u16_le(buf, off): i64 {
    var lo = load8(buf + off);
    var hi = load8(buf + off + 1);
    return lo | (hi << 8);
}

# Read u32 little-endian from buf+off.
fn _read_u32_le(buf, off): i64 {
    var b0 = load8(buf + off);
    var b1 = load8(buf + off + 1);
    var b2 = load8(buf + off + 2);
    var b3 = load8(buf + off + 3);
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

# v5.11.55 refactor: shared "compile a .cyr source through cycc under
# CYRIUS_TARGET_EFI=1 and read the output bytes into buf" helper.
# Consolidates the boilerplate that _efi_emit_gate (.48) and
# _efi_trampoline_rex_gate (.53) each open-coded.
#
# Args: src_path cstr, out_buf, out_buf_cap, fail_label cstr.
# Returns bytes-read on success, -1 on failure (after printing the
# FAIL diagnostic). Callers check `<= 0` to wire the gate-level fail
# count.
fn _efi_compile_to_buf(src_path, out_buf, out_buf_cap, fail_label): i64 {
    var bin_path = _tmp_path("audit_efi_compile_bin_");
    var rc = _self_host_pipe_efi(src_path, CC_PATH, bin_path);
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": "); _p(fail_label); _p(" compile failed (rc=");
        print_num(rc); println(")");
        return 0 - 1;
    }
    var n = file_read_all(bin_path, out_buf, out_buf_cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": "); _p(fail_label); println(" — compiled but output unreadable");
        return 0 - 1;
    }
    return n;
}

# Gate: UEFI Application PE emit produces a structurally correct
# PE32+ image (v5.11.48, gnoboot arc P2).
#
# Compiles programs/efi_probe.cyr with CYRIUS_TARGET_EFI=1 and asserts:
#   - DOS header MZ magic + PE signature
#   - Optional header Magic = 0x020B (PE32+)
#   - Subsystem = 0x000A (IMAGE_SUBSYSTEM_EFI_APPLICATION)
#   - DllCharacteristics has NX_COMPAT (0x0100) — required by UEFI 2.0+
#   - Data Directory [1] Import zeroed — no kernel32 in UEFI
#   - Data Directory [12] IAT zeroed
#   - .text contains 0xC3 (ret) — EEXIT EFI variant in use
#
# Negative-test verified in slot: pre-fix cycc emits Subsystem=3
# (WINDOWS_CUI) → gate FAILs. Post-fix → gate PASSes.
fn _efi_emit_gate(): i64 {
    var label = "EFI Application PE emit produces correct PE32+ headers (v5.11.48; gnoboot MVP unblocker)";
    var cap = 262144;
    var buf = alloc(cap);
    var n = _efi_compile_to_buf(_root_path("programs/efi_probe.cyr"), buf, cap, "efi_probe");
    if (n <= 0) { _check(label, 1); return 1; }

    # DOS header: MZ at offset 0
    if (load8(buf) != 0x4D || load8(buf + 1) != 0x5A) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": efi_probe output missing MZ DOS header");
        _check(label, 1);
        return 1;
    }

    # PE signature offset at byte 60; signature = "PE\0\0"
    var pe_off = _read_u32_le(buf, 60);
    if (load8(buf + pe_off) != 0x50 || load8(buf + pe_off + 1) != 0x45) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": efi_probe PE signature not found at e_lfanew");
        _check(label, 1);
        return 1;
    }

    var opt_off = pe_off + 4 + 20;

    # Optional Header Magic must be PE32+ (0x020B)
    var magic = _read_u16_le(buf, opt_off);
    if (magic != 0x020B) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": Optional Header Magic ");
        print_num(magic);
        println(" != 0x020B (PE32+)");
        _check(label, 1);
        return 1;
    }

    # Subsystem at OptionalHeader + 68
    var subsys = _read_u16_le(buf, opt_off + 68);
    if (subsys != 10) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": Subsystem ");
        print_num(subsys);
        println(" != 10 (IMAGE_SUBSYSTEM_EFI_APPLICATION)");
        _check(label, 1);
        return 1;
    }

    # DllCharacteristics at OptionalHeader + 70; require NX_COMPAT (0x0100)
    var dllc = _read_u16_le(buf, opt_off + 70);
    if ((dllc & 0x0100) == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": DllCharacteristics ");
        print_num(dllc);
        println(" missing NX_COMPAT (0x0100) — UEFI 2.0+ requires it");
        _check(label, 1);
        return 1;
    }

    # Data directories at OptionalHeader + 112 (PE32+). Each entry = 8 bytes.
    var dd_base = opt_off + 112;

    # [1] Import directory — must be zeroed (no kernel32 in UEFI)
    var imp_rva  = _read_u32_le(buf, dd_base + 8);
    var imp_size = _read_u32_le(buf, dd_base + 12);
    if (imp_rva != 0 || imp_size != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": Data Dir [1] Import not zeroed (RVA=");
        print_num(imp_rva);
        _p(", Size=");
        print_num(imp_size);
        println(") — EFI mode should suppress kernel32 imports");
        _check(label, 1);
        return 1;
    }

    # [12] IAT — must be zeroed
    var iat_rva  = _read_u32_le(buf, dd_base + 96);
    var iat_size = _read_u32_le(buf, dd_base + 100);
    if (iat_rva != 0 || iat_size != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": Data Dir [12] IAT not zeroed (RVA=");
        print_num(iat_rva);
        _p(", Size=");
        print_num(iat_size);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Locate .text section to verify the EEXIT EFI variant (ret = 0xC3)
    # actually emitted. Section table starts at OptionalHeader + 240.
    var st_off = opt_off + 240;
    var found_text = 0;
    var ret_found = 0;
    var si = 0;
    while (si < 6) {
        var so = st_off + si * 40;
        # Name compare: ".text\0\0\0"
        if (load8(buf + so) == 0x2E
            && load8(buf + so + 1) == 0x74
            && load8(buf + so + 2) == 0x65
            && load8(buf + so + 3) == 0x78
            && load8(buf + so + 4) == 0x74
            && load8(buf + so + 5) == 0x00) {
            found_text = 1;
            var foff = _read_u32_le(buf, so + 20);
            var vsz  = _read_u32_le(buf, so + 8);
            # Scan .text for 0xC3 (ret) — EEXIT EFI variant
            var ti = 0;
            while (ti < vsz) {
                if (load8(buf + foff + ti) == 0xC3) {
                    ret_found = 1;
                    ti = vsz;
                } else {
                    ti = ti + 1;
                }
            }
            si = 6;
        } else {
            si = si + 1;
        }
    }
    if (found_text == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": .text section not found in efi_probe output");
        _check(label, 1);
        return 1;
    }
    if (ret_found == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": 0xC3 (ret) not found in .text — EEXIT EFI variant not emitting");
        _check(label, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": EFI Application emit — Subsystem=0xA, DllChar NX_COMPAT, Data Dirs [1]/[12] zeroed, .text has ret");
    println("");
    _check(label, 0);
    return 0;
}

# Gate: UEFI Application boots end-to-end under qemu + OVMF and writes
# "hello, uefi" to firmware's ConOut (v5.11.49, gnoboot arc KO).
#
# This is a RUNTIME smoke — it actually boots the cyrius-compiled EFI
# binary under qemu-system-x86_64 with OVMF firmware, captures serial
# output, and asserts the probe's "hello, uefi" message appears. Catches
# bugs that structural checks miss (entry-point convention regressions,
# COFF Characteristics misalignment, PE loader rejection, etc.).
#
# Tooling required (graceful SKIP if any missing): qemu-system-x86_64,
# parted, mformat/mcopy (mtools), OVMF_CODE.4m.fd + OVMF_VARS.4m.fd.
# On Arch Linux these come from `qemu-base`, `parted`, `mtools`, and
# `edk2-ovmf` packages.
#
# Negative-test verified in slot: with v5.11.48 cycc (RELOCS_STRIPPED
# still set on zero-fixup EFI binaries), OVMF BdsDxe reports
# "Not Found" and "hello, uefi" never appears. v5.11.49 cycc clears
# RELOCS_STRIPPED in EFI mode; boot succeeds.
fn _efi_ovmf_smoke_gate(): i64 {
    var label = "EFI Application boots under qemu+OVMF + writes hello via ConOut (v5.11.49; gnoboot arc KO)";

    # Probe for required tooling. Any missing → SKIP gracefully (don't
    # fail check.sh; the gate is opt-in via presence of the test
    # environment, same pattern as the macho cross-build gate which
    # skips when codesign is absent).
    if (file_exists("/usr/bin/qemu-system-x86_64") != 1) {
        _p("  "); _p(ANSI_RESET); _p("SKIP"); _p(ANSI_RESET);
        println(": qemu-system-x86_64 not installed — runtime smoke skipped");
        _check(label, 0);
        return 0;
    }
    if (file_exists("/usr/bin/parted") != 1) {
        _p("  SKIP: parted not installed — runtime smoke skipped\n");
        _check(label, 0);
        return 0;
    }
    if (file_exists("/usr/bin/mformat") != 1) {
        _p("  SKIP: mtools (mformat) not installed — runtime smoke skipped\n");
        _check(label, 0);
        return 0;
    }
    if (file_exists("/usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd") != 1) {
        _p("  SKIP: OVMF_CODE.4m.fd not at /usr/share/edk2-ovmf/x64/ — runtime smoke skipped\n");
        _check(label, 0);
        return 0;
    }
    if (file_exists("/usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd") != 1) {
        _p("  SKIP: OVMF_VARS.4m.fd not at /usr/share/edk2-ovmf/x64/ — runtime smoke skipped\n");
        _check(label, 0);
        return 0;
    }

    # Compile programs/efi_probe.cyr under CYRIUS_TARGET_EFI=1.
    var src_path = _root_path("programs/efi_probe.cyr");
    var efi_bin = _tmp_path("efi_smoke_probe_");
    var rc = _self_host_pipe_efi(src_path, CC_PATH, efi_bin);
    if (rc != 0) {
        sys_unlink(efi_bin);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": efi_probe compile failed (rc=");
        print_num(rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Runtime smoke pipeline. The orchestration is a /bin/sh -c
    # one-liner — test glue, not a separate shell-script deliverable
    # (cyrius owns the gate; sh is just stdlib-tool composition for
    # parted/mtools/qemu invocation, same shape as how cross-host
    # smoke uses ssh). The .efi path comes through as $1.
    var script = "set -e; D=$(mktemp -d -t efi-smoke.XXXXXX); trap 'rm -rf \"$D\"' EXIT; cd \"$D\"; dd if=/dev/zero of=disk.img bs=1M count=64 status=none; parted -s disk.img mklabel gpt mkpart ESP fat32 1MiB 100% set 1 esp on >/dev/null 2>&1; mformat -i disk.img@@1048576 -F; mmd -i disk.img@@1048576 ::EFI; mmd -i disk.img@@1048576 ::EFI/BOOT; mcopy -i disk.img@@1048576 \"$1\" ::EFI/BOOT/BOOTX64.EFI; cp /usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd vars.fd; chmod +w vars.fd; timeout 12 qemu-system-x86_64 -machine q35 -m 256M -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd -drive if=pflash,format=raw,file=vars.fd -drive file=disk.img,format=raw -serial stdio -display none -no-reboot 2>/dev/null | grep -q 'hello, uefi'";

    var args = vec_new();
    vec_push(args, str_from("/bin/sh"));
    vec_push(args, str_from("-c"));
    vec_push(args, str_from(script));
    vec_push(args, str_from("--"));
    vec_push(args, str_from(efi_bin));
    var rc2 = exec_vec_str(args);
    sys_unlink(efi_bin);

    if (rc2 == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": OVMF firmware loaded BOOTX64.EFI; \"hello, uefi\" captured on serial");
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": OVMF runtime smoke did not produce \"hello, uefi\" (sh rc=");
    print_num(rc2);
    println(")");
    _check(label, 1);
    return 1;
}

# Gate: efi_main trampoline byte encoding (v5.11.53).
# Locks the REX prefix on the entry save against the v5.11.52
# 0x4C-vs-0x49 regression that landed and shipped briefly:
# - SAVE direction (r14/r15 as DESTINATION → r/m field): needs
#   REX.B=1 → REX byte 0x49 → `49 89 CE` for mov r14, rcx.
# - RESTORE direction (r14/r15 as SOURCE → reg field): needs
#   REX.R=1 → REX byte 0x4C → `4C 89 F1` for mov rcx, r14.
# v5.11.52 ship had 0x4C in BOTH directions; restore happened to be
# correct (r14/r15 as source ARE reg-field-extended) but save was
# wrong (4C 89 CE decodes to `mov rsi, r9`, not `mov r14, rcx`).
# Filed: docs/development/issues/archived/2026-05-13-efi-main-trampoline-save-rex-wrong.md.
#
# The gate compiles a minimal `kernel; fn efi_main(h,s): i64 { return 0; }`
# source with CYRIUS_TARGET_EFI=1, looks for the save and restore
# byte patterns in the output, asserts both are present AND the wrong
# `4C 89 CE 4C 89 D7` pattern is absent.
fn _efi_trampoline_rex_gate(): i64 {
    var label = "efi_main trampoline REX prefix encoding (v5.11.53; save=49, restore=4C)";

    if (file_exists("/usr/bin/qemu-system-x86_64") != 1) {
        _p("  SKIP: qemu tooling not present (gate is paired with OVMF smoke ecosystem)\n");
        _check(label, 0);
        return 0;
    }

    # Compile minimal efi_main source via CYRIUS_TARGET_EFI=1 pipe.
    var src_path = _tmp_path("audit_efi_tramp_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { _check(label, 1); return 1; }
    var src = "kernel;\n\nfn efi_main(handle, st): i64 {\n    return 0;\n}\n";
    sys_write(fd, src, strlen(src));
    sys_close(fd);

    var cap = 262144;
    var buf = alloc(cap);
    var n = _efi_compile_to_buf(src_path, buf, cap, "efi_main minimal source");
    sys_unlink(src_path);
    if (n <= 0) { _check(label, 1); return 1; }

    # Build needles via store8 (string literals can't carry 0x49 / 0x4C
    # reliably and the bytes here are explicitly chosen for the test).
    var save_good[1];
    store8(&save_good + 0, 0x49); store8(&save_good + 1, 0x89); store8(&save_good + 2, 0xCE);
    store8(&save_good + 3, 0x49); store8(&save_good + 4, 0x89); store8(&save_good + 5, 0xD7);

    var save_bad[1];
    store8(&save_bad + 0, 0x4C); store8(&save_bad + 1, 0x89); store8(&save_bad + 2, 0xCE);
    store8(&save_bad + 3, 0x4C); store8(&save_bad + 4, 0x89); store8(&save_bad + 5, 0xD7);

    var restore_good[1];
    store8(&restore_good + 0, 0x4C); store8(&restore_good + 1, 0x89); store8(&restore_good + 2, 0xF1);
    store8(&restore_good + 3, 0x4C); store8(&restore_good + 4, 0x89); store8(&restore_good + 5, 0xFA);

    var save_at    = _find_bytes(buf, n, &save_good, 6);
    var save_bad_at = _find_bytes(buf, n, &save_bad, 6);
    var restore_at = _find_bytes(buf, n, &restore_good, 6);

    var fail = 0;
    if (save_at < 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": entry save bytes (49 89 CE 49 89 D7 = mov r14,rcx / mov r15,rdx) NOT found in output");
        fail = fail + 1;
    }
    if (save_bad_at >= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": v5.11.52 wrong-REX bytes (4C 89 CE 4C 89 D7 = mov rsi,r9 / mov rdi,r10) regressed at file offset ");
        print_num(save_bad_at);
        println("");
        fail = fail + 1;
    }
    if (restore_at < 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": restore bytes (4C 89 F1 4C 89 FA = mov rcx,r14 / mov rdx,r15) NOT found in output");
        fail = fail + 1;
    }

    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": efi_main trampoline encoding — save=49/89/CE+49/89/D7; restore=4C/89/F1+4C/89/FA");
    }
    _check(label, fail);
    return fail;
}

# Gate: stdlib fallback path resolves `include "lib/X.cyr"` from
# downstream consumers that have no vendored `./lib/` (v6.0.1;
# rename-skip regression).
#
# Reproduces the v6.0.0 bug shape: cycc's `_init_cyrius_lib` built
# `$HOME/.cyrius/versions/<v>/lib/` via skip-prefix on _VERSION_STR_CYCC.
# The v5.x prefix `"cc5 "` (4 chars) became `"cycc "` (5 chars) at
# v6.0.0 but the `vp = 4` constant was missed — yielding the path
# `$HOME/.cyrius/versions/ <v>/lib/` (leading space), which doesn't
# exist on the filesystem. Stdlib includes from consumers without a
# local `./lib/` then failed to resolve; fixup.cyr emitted the
# `0F 0B 0F 0B 90` (ud2/ud2/nop) sentinel at every fncallN call site;
# cycc returned 0 and shipped a silently-broken UEFI binary that
# #UD'd on entry into firmware.
#
# The gate stages a minimal fncall1-via-fnptr.cyr consumer in /tmp/,
# chdirs the child to /tmp/ before execve so `./lib` is NOT visible
# (forcing the version-pinned fallback path to be exercised), builds
# with CYRIUS_TARGET_EFI=1, and asserts the output has zero ud2 ud2
# nop sequences.
#
# Negative test verified in-slot: pre-fix cycc produces a PE32+ that
# contains 16 ud2/ud2/nop sentinels (one per fncallN site); fixed
# cycc produces a clean PE32+ with zero sentinels.
fn _efi_stdlib_fallback_gate(): i64 {
    var label = "stdlib fallback resolves lib/fnptr.cyr without vendored ./lib (v6.0.1; rename-skip regression)";

    var src_path = "/tmp/audit_efi_fallback_src.cyr";
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { _check(label, 1); return 1; }
    var src = "include \"lib/fnptr.cyr\"\nfn main(): i64 { var fp = 0; var r = fncall1(fp, 0); return r; }\n";
    sys_write(fd, src, strlen(src));
    sys_close(fd);

    var bin_path = "/tmp/audit_efi_fallback_bin";

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_unlink(src_path); _check(label, 1); return 1; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var out_fd = sys_open(bin_path, 577, 420);
    if (out_fd < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_unlink(src_path);
        _check(label, 1); return 1;
    }

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_close(out_fd);
        sys_unlink(src_path); _check(label, 1); return 1;
    }
    # Build augmented envp: parent's ENVP_ARR (carries HOME, needed
    # by cycc's `_init_cyrius_lib` to build the version-pinned
    # fallback path) + CYRIUS_TARGET_EFI=1 + NUL. _self_host_pipe_efi
    # passes only "CYRIUS_TARGET_EFI=1" but that suffices for the
    # inline-asm efi_probe.cyr — this gate needs HOME because the
    # whole point is to exercise the stdlib-include fallback.
    var aug_envp = alloc((ENVP_COUNT + 2) * 8);
    var ei = 0;
    while (ei < ENVP_COUNT) {
        store64(aug_envp + ei * 8, load64(ENVP_ARR + ei * 8));
        ei = ei + 1;
    }
    store64(aug_envp + ENVP_COUNT * 8, "CYRIUS_TARGET_EFI=1");
    store64(aug_envp + (ENVP_COUNT + 1) * 8, 0);

    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0); sys_close(read_fd);
        sys_dup2(out_fd, 1); sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var cd_rc = syscall(SYS_CHDIR, "/tmp");
        if (cd_rc < 0) { sys_exit(126); }
        var argv[3];
        store64(&argv,     CC_PATH);
        store64(&argv + 8, 0);
        sys_execve(CC_PATH, &argv, aug_envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);

    var src_cap = 4096;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; } else { written = written + w; }
    }
    sys_close(write_fd);

    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    sys_unlink(src_path);

    var status = load32(&status_buf);
    if (WIFEXITED(status) == 0 || WEXITSTATUS(status) != 0) {
        sys_unlink(bin_path);
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cycc exited non-zero (status="); print_num(status);
        println(") with CYRIUS_TARGET_EFI=1 + include \"lib/fnptr.cyr\"");
        _check(label, 1);
        return 1;
    }

    var cap = 262144;
    var buf = alloc(cap);
    var n = file_read_all(bin_path, buf, cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": compiled but output unreadable");
        _check(label, 1);
        return 1;
    }

    var ud2_needle[1];
    store8(&ud2_needle + 0, 0x0F);
    store8(&ud2_needle + 1, 0x0B);
    store8(&ud2_needle + 2, 0x0F);
    store8(&ud2_needle + 3, 0x0B);
    store8(&ud2_needle + 4, 0x90);
    var ud2_at = _find_bytes(buf, n, &ud2_needle, 5);

    var fail = 0;
    if (ud2_at >= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": found ud2/ud2/nop sentinel (0F 0B 0F 0B 90) at offset ");
        print_num(ud2_at);
        println(" — lib/fnptr.cyr did not resolve via version-pinned fallback");
        println("    (rename-skip regression — check src/frontend/lex.cyr `vp =` constant)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": fncall1 resolved via $HOME/.cyrius/versions/<v>/lib/fnptr.cyr (no ud2 sentinel)");
    }
    _check(label, fail);
    return fail;
}

# Gate: `cyrius deps` resolves stdlib pins for downstream repos that
# have a `src/main.cyr` entry point (v6.0.1; cmd_deps mkdir-before-find
# regression).
#
# Pre-fix, `cmd_deps` (cbt/deps.cyr) ran `sys_mkdir("lib", 0x1ED)`
# unconditionally before `_dep_find_stdlib_dir`. Priority (a) of
# `_dep_find_stdlib_dir` checks `file_exists("src/main.cyr") &&
# is_dir("./lib")` to identify "we're inside the cyrius source repo"
# — but the upfront mkdir created `./lib` first, tripping (a) for ANY
# downstream repo with a `src/main.cyr` entry point + non-empty
# `stdlib = [...]`. Priority (a) then returned "./lib" instead of
# the pinned/legacy fallback path; the copy from `./lib/<mod>.cyr`
# (which is empty) failed with "cannot read".
#
# Affected: gnoboot 0.2.0 the moment it adopted `stdlib = ["fnptr"]`
# (2026-05-19). Surfaced during v6.0.1 triage of the agnosticos UEFI
# fncall ud2 filing. Bug pre-dates v6.0.0 — would have hit any
# downstream-with-src/main.cyr consumer with a non-empty stdlib pin
# since v5.11.17 (when priority (a) landed).
#
# Fix: remove the upfront mkdir. The `_dep_copy_file` prefix-walk
# already mkdir's intermediate dirs lazily when the actual copy runs
# (cbt/deps.cyr:79-88), so the upfront mkdir was redundant AND
# wrong.
#
# Gate stages a fixture in /tmp/ that exactly matches the downstream-
# repo-with-src/main.cyr shape and asserts `cyrius deps` materializes
# `./lib/fnptr.cyr` in the fixture.
fn _deps_downstream_src_main_gate(): i64 {
    var label = "cyrius deps resolves stdlib pins for downstream repos with src/main.cyr (v6.0.1; mkdir-before-find regression)";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    var fixture_dir = _tmp_path("audit_deps_downstream_");
    sys_mkdir(fixture_dir, 0x1ED);

    var src_dir_sb = str_builder_new();
    str_builder_add_cstr(src_dir_sb, fixture_dir);
    str_builder_add_cstr(src_dir_sb, "/src");
    var src_dir = str_data(str_builder_build(src_dir_sb));
    sys_mkdir(src_dir, 0x1ED);

    var main_path_sb = str_builder_new();
    str_builder_add_cstr(main_path_sb, src_dir);
    str_builder_add_cstr(main_path_sb, "/main.cyr");
    var main_path = str_data(str_builder_build(main_path_sb));
    _write_file(main_path, "fn main(): i64 { return 0; }\n");

    var cyml_path_sb = str_builder_new();
    str_builder_add_cstr(cyml_path_sb, fixture_dir);
    str_builder_add_cstr(cyml_path_sb, "/cyrius.cyml");
    var cyml_path = str_data(str_builder_build(cyml_path_sb));
    _write_file(cyml_path,
        "[package]\nname = \"deps_gate_fixture\"\nversion = \"0.0.1\"\n\n[build]\nentry = \"src/main.cyr\"\n\n[deps]\nstdlib = [\"fnptr\"]\n");

    var out_path = _tmp_path("audit_deps_downstream_out_");
    var ec = _exec_in_dir(fixture_dir, cyrius_bin, "deps", out_path);

    var lib_fnptr_sb = str_builder_new();
    str_builder_add_cstr(lib_fnptr_sb, fixture_dir);
    str_builder_add_cstr(lib_fnptr_sb, "/lib/fnptr.cyr");
    var lib_fnptr = str_data(str_builder_build(lib_fnptr_sb));
    var resolved = file_exists(lib_fnptr);
    var sz = 0;
    if (resolved == 1) { sz = _file_size(lib_fnptr); }

    # Cleanup before reporting so a failed assertion still cleans up.
    sys_unlink(out_path);
    sys_unlink(lib_fnptr);
    sys_unlink(main_path);
    sys_unlink(cyml_path);
    var lib_dir_sb = str_builder_new();
    str_builder_add_cstr(lib_dir_sb, fixture_dir);
    str_builder_add_cstr(lib_dir_sb, "/lib");
    sys_rmdir(str_data(str_builder_build(lib_dir_sb)));
    sys_rmdir(src_dir);
    sys_rmdir(fixture_dir);

    var fail = 0;
    if (ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cyrius deps exited "); print_num(ec); println(" (expected 0)");
        fail = 1;
    } elif (resolved != 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": lib/fnptr.cyr not materialized in fixture (cmd_deps mkdir-before-find regression?)");
        fail = 1;
    } elif (sz <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": lib/fnptr.cyr exists but is empty (sz="); print_num(sz); println(")");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        _p(": cyrius deps materialized lib/fnptr.cyr (");
        print_num(sz); println(" bytes) in downstream-with-src/main.cyr fixture");
    }
    _check(label, fail);
    return fail;
}

# Helper: join `base` + `suffix` into a fresh cstr. Local to the
# v6.0.2 lock gate to keep its fixture path-building readable.
fn _lk_path(base, suffix): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, suffix);
    return str_data(str_builder_build(sb));
}

# v6.0.2 regression gate — `cyrius deps --lock` must write a NON-EMPTY
# lock that recurses into subdirs and round-trips through --verify.
# Guards the bug that survived ~60 patches undetected: v5.11.8 switched
# dep resolution from symlink to file-copy, but cmd_deps_lock kept
# filtering for symlinks (readlink), so every resolved dep was skipped
# and cyrius.lock came out empty ecosystem-wide (cyrius/kybernet/argonaut
# all 0 bytes). No gate covered it. Fixture is a downstream-style repo
# (name != "cyrius") with a hand-built lib/ incl. a unicode/ subdir.
fn _deps_lock_gate(): i64 {
    var label = "cyrius deps --lock writes a non-empty recursive lock + --verify round-trips (v6.0.2; empty-lock-since-v5.11.8 regression)";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    var fx = _tmp_path("audit_deps_lock_");
    sys_mkdir(fx, 0x1ED);
    sys_mkdir(_lk_path(fx, "/lib"), 0x1ED);
    sys_mkdir(_lk_path(fx, "/lib/unicode"), 0x1ED);
    _write_file(_lk_path(fx, "/lib/foo.cyr"), "fn foo() { return 1; }\n");
    _write_file(_lk_path(fx, "/lib/unicode/cats.cyr"), "fn cats() { return 2; }\n");
    _write_file(_lk_path(fx, "/cyrius.cyml"), "[package]\nname = \"lock_gate_fixture\"\n");

    var lout = _tmp_path("audit_deps_lock_out_");
    var lec = _exec_in_dir3(fx, cyrius_bin, "deps", "--lock", 0, lout);

    var lock_path = _lk_path(fx, "/cyrius.lock");
    var lock_sz = 0;
    if (file_exists(lock_path) == 1) { lock_sz = _file_size(lock_path); }

    var has_subdir = 0;
    if (lock_sz > 0) {
        var lb = alloc(8192);
        var ln = file_read_all(lock_path, lb, 8191);
        if (ln > 0) {
            store8(lb + ln, 0);
            if (_find_str_from(lb, ln, 0, "lib/unicode/cats.cyr", 20) >= 0) { has_subdir = 1; }
        }
    }

    var vec_ec = _exec_in_dir3(fx, cyrius_bin, "deps", "--verify", 0, lout);

    # Cleanup before reporting so a failed assertion still cleans up.
    sys_unlink(lout);
    sys_unlink(lock_path);
    sys_unlink(_lk_path(fx, "/lib/unicode/cats.cyr"));
    sys_unlink(_lk_path(fx, "/lib/foo.cyr"));
    sys_unlink(_lk_path(fx, "/cyrius.cyml"));
    sys_rmdir(_lk_path(fx, "/lib/unicode"));
    sys_rmdir(_lk_path(fx, "/lib"));
    sys_rmdir(fx);

    var fail = 0;
    if (lec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cyrius deps --lock exited "); print_num(lec); println(" (expected 0)");
        fail = 1;
    } elif (lock_sz <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": cyrius.lock empty after --lock (symlink-filter regression returned?)");
        fail = 1;
    } elif (has_subdir == 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": cyrius.lock missing lib/unicode/cats.cyr (subdir recursion broken)");
        fail = 1;
    } elif (vec_ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cyrius deps --verify exited "); print_num(vec_ec); println(" (expected 0)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        _p(": cyrius.lock non-empty ("); print_num(lock_sz);
        println(" bytes, incl. unicode/ subdir) + --verify round-trips");
    }
    _check(label, fail);
    return fail;
}

# v6.0.5: `cycc --parse-ts <file>` MUST read from the named file instead
# of stdin. yeo-cy-test papercut #3 (2026-05-27) reported that a scripted
# invocation hung 17 min holding a lock because cycc read stdin
# unconditionally and ignored the path arg. The discriminator: pipe
# invalid TS to stdin AND pass a valid file path. Fix working → cycc
# opens the file → exit 0. Fix regressed → cycc reads garbage from
# stdin → exit non-zero.
fn _ts_path_arg_gate(): i64 {
    var label = "cycc --parse-ts <file> reads from file not stdin (v6.0.5; yeo-cy-test papercut #3 invariant)";

    var fix = _root_path("tests/fixtures/ts_lex/sample.ts");
    if (file_exists(fix) != 1) {
        _p("  skip: sample.ts fixture missing\n");
        _check(label, 0);
        return 0;
    }

    var garbage_path = _tmp_path("audit_ts_path_arg_stdin_");
    _write_file(garbage_path, "this is not valid TS @#$%^&*\n");

    var pid = sys_fork();
    if (pid < 0) { sys_unlink(garbage_path); _check(label, 1); return 1; }
    if (pid == 0) {
        var gfd = sys_open(garbage_path, 0, 0);
        if (gfd >= 0) { sys_dup2(gfd, 0); sys_close(gfd); }
        var dn1 = sys_open("/dev/null", 1, 0);
        if (dn1 >= 0) { sys_dup2(dn1, 1); sys_close(dn1); }
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[4];
        store64(&argv,      CC_PATH);
        store64(&argv + 8,  "--parse-ts");
        store64(&argv + 16, fix);
        store64(&argv + 24, 0);
        var envp[1];
        store64(&envp, 0);
        sys_execve(CC_PATH, &argv, &envp);
        sys_exit(127);
    }
    var stbuf[1];
    sys_waitpid(pid, &stbuf, 0);
    sys_unlink(garbage_path);
    var status = load32(&stbuf);
    var ec = 0 - 1;
    if (WIFEXITED(status) == 1) { ec = WEXITSTATUS(status); }

    var fail = 0;
    if (ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cycc --parse-ts <path> exit "); print_num(ec);
        println(" (regression — reading stdin instead of the path arg?)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": cycc --parse-ts <path> reads from file, ignores piped garbage stdin");
    }
    _check(label, fail);
    return fail;
}

# v6.0.5: `cyrius build` MUST exit non-zero when the underlying cycc
# compile fails. The yeo-cy-test 2026-05-27 filing claimed an exit-0
# regression at v6.0.3 — premise-check at v6.0.4 debunked it (`cmd_build`
# returns `r` from compile() since 2026-04-16, main() propagates, and
# `syscall(60, exit_code)` does the right thing). This gate locks the
# invariant so a future refactor of cmd_build / compile() / the wrapper's
# exit path can't silently drop nonzero status without check.sh going red.
fn _build_exit_nonzero_gate(): i64 {
    var label = "cyrius build exits non-zero when cycc fails (v6.0.5; yeo-cy-test papercut #2 invariant)";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    var fx = _tmp_path("audit_build_exit_");
    sys_mkdir(fx, 0x1ED);
    # '//' triggers `error: <source>:1: unexpected '/'` in cycc (cyrius
    # comments are '#'); guaranteed parse failure with no dep surface.
    _write_file(_lk_path(fx, "/bad.cyr"), "//comment\n");
    _write_file(_lk_path(fx, "/cyrius.cyml"), "[package]\nname = \"build_exit_gate\"\n");

    var bout = _tmp_path("audit_build_exit_out_");
    var bec = _exec_in_dir3(fx, cyrius_bin, "build", "bad.cyr", "bad.out", bout);

    sys_unlink(bout);
    sys_unlink(_lk_path(fx, "/bad.out"));
    sys_unlink(_lk_path(fx, "/bad.cyr"));
    sys_unlink(_lk_path(fx, "/cyrius.cyml"));
    sys_rmdir(fx);

    var fail = 0;
    if (bec == 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": cyrius build returned 0 on broken source (yeo-cy-test papercut #2 regressed)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        _p(": cyrius build exited "); print_num(bec); println(" (non-zero) on broken source");
    }
    _check(label, fail);
    return fail;
}

# Helper: find first occurrence of `needle` in [buf, buf+n) starting
# at `from`. Returns offset on hit, -1 on miss. Used by the cap-drift
# and doc-size gates to scan for textual patterns inside loaded buffers.
fn _find_str_from(buf, n, from, needle, nlen): i64 {
    var i = from;
    var limit = n - nlen;
    while (i <= limit) {
        var j = 0;
        var ok = 1;
        while (j < nlen) {
            if (load8(buf + i + j) != load8(needle + j)) { ok = 0; j = nlen; }
            else { j = j + 1; }
        }
        if (ok == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Helper: parse a decimal integer starting at `buf + off`. Returns
# the integer value; updates `*end_out` to one-past-the-last digit.
# Returns -1 if no digit at offset (so callers can guard).
fn _parse_dec_at(buf, n, off, end_out): i64 {
    var i = off;
    var c = load8(buf + i);
    if (c < 48 || c > 57) { store64(end_out, off); return 0 - 1; }
    var v = 0;
    while (i < n) {
        c = load8(buf + i);
        if (c >= 48 && c <= 57) {
            v = v * 10 + (c - 48);
            i = i + 1;
        } else {
            i = n;
        }
    }
    # Walk back: last iteration set i = n when non-digit found, but i
    # may have been incremented past the non-digit. Re-find end by
    # rescanning forward from off.
    var k = off;
    while (k < n) {
        var c2 = load8(buf + k);
        if (c2 >= 48 && c2 <= 57) { k = k + 1; }
        else { store64(end_out, k); return v; }
    }
    store64(end_out, n);
    return v;
}

# Gate: cap-drift detector (v5.11.50). Verifies that the heap-map
# comments in src/main.cyr agree with the inline literal cap checks
# scattered across src/frontend/lex.cyr. Each entry below names a
# region, its canonical byte size, its human-readable label as it
# should appear in the heap-map comment, and an inline-literal cap
# that source code MUST use for that region.
#
# When you raise a cap, update ALL THREE sites: the heap-map [N]
# byte size, the human-readable label ("256KB"), AND the inline
# literal check. This gate catches the partial-update class that's
# bitten the cycle multiple times (see issue
# 2026-05-13-cap-drift-detector-gate.md).
# Cap-drift gate helpers (v5.11.55 refactor of the v5.11.50 hardcoded
# blocks). Two ≤6-arg helpers — adding the next cap is two short calls
# from `_cap_drift_gate` instead of a 20-LoC copy-paste.

# Verify a heap-map line's byte-literal + human-size-label.
# Args: buf, n, anchor cstr (e.g. "0x60000  tok_names"), expected
# byte literal (e.g. "[262144]"), expected human label (e.g. "256KB"),
# region name (diagnostic). Returns fail count (0 on success).
fn _verify_heap_map(buf, n, anchor, byte_lit, human, region): i64 {
    var fail = 0;
    var off = _find_str_from(buf, n, 0, anchor, strlen(anchor));
    if (off < 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cap-drift — heap-map line for "); _p(region); println(" not found");
        return 1;
    }
    var lb = _find_str_from(buf, n, off, byte_lit, strlen(byte_lit));
    if (lb < 0 || lb - off > 60) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cap-drift — "); _p(region); _p(" heap-map byte size != "); _p(byte_lit); println("");
        fail = fail + 1;
    }
    var hb = _find_str_from(buf, n, off, human, strlen(human));
    if (hb < 0 || hb - off > 80) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cap-drift — "); _p(region); _p(" heap-map human label != "); _p(human); println("");
        fail = fail + 1;
    }
    return fail;
}

# Verify a source file has an inline cap-check pattern.
# Args: buf, n, expected pattern (e.g. ">= 262144"), region name.
# Returns 0 on hit, 1 on miss.
fn _verify_inline(buf, n, pattern, region): i64 {
    var at = _find_str_from(buf, n, 0, pattern, strlen(pattern));
    if (at < 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cap-drift — "); _p(region); _p(" inline cap (");
        _p(pattern); println(") missing from lex.cyr");
        return 1;
    }
    return 0;
}

# CVE-05 tok_names mangle-path guard (v5.11.65). At v5.11.64 every
# mangle site (BUILD_METHOD_NAME / BUILD_OP_NAME / PARSE_FN_DEF
# module mangle / parse_types variant-ctor / 6× main_*.cyr use-alias)
# guarded its byte-copy loops with `NPOS_GUARD(S, 256)` — a magic
# pessimistic budget that an over-long source identifier could
# exceed silently, corrupting adjacent regions past tok_names @
# 0x60000+0x40000. v5.11.65 replaced each with a compute-length-
# then-NPOS_GUARD shape; this gate fails if any `NPOS_GUARD(S, 256)`
# reappears in the affected files. (Small NPOS_GUARD calls — 8, 16,
# flen+1 — are unaffected: they cover bounded literal writes, not
# source-identifier copies.) See CHANGELOG [5.11.65] and
# `docs/audit/2026-04-13-security-audit.md` § CVE-05.
fn _cve05_guard_gate(): i64 {
    var label = "CVE-05 tok_names mangle-path: no magic-256 NPOS_GUARD in any source-identifier copy site (v5.11.65)";
    var files[88];
    store64(&files + 0,  _root_path("src/frontend/parse_decl.cyr"));
    store64(&files + 8,  _root_path("src/frontend/parse_expr.cyr"));
    store64(&files + 16, _root_path("src/frontend/parse_fn.cyr"));
    store64(&files + 24, _root_path("src/frontend/parse_types.cyr"));
    store64(&files + 32, _root_path("src/main.cyr"));
    store64(&files + 40, _root_path("src/main_aarch64.cyr"));
    store64(&files + 48, _root_path("src/main_aarch64_macho.cyr"));
    store64(&files + 56, _root_path("src/main_aarch64_native.cyr"));
    store64(&files + 64, _root_path("src/main_cx.cyr"));
    store64(&files + 72, _root_path("src/main_win.cyr"));

    var fail = 0;
    var fi = 0;
    while (fi < 10) {
        var path = load64(&files + fi * 8);
        if (file_exists(path) == 1) {
            if (_file_contains_substr(path, "NPOS_GUARD(S, 256)") == 1) {
                _p("  ");
                _p(ANSI_RED);
                _p("FAIL");
                _p(ANSI_RESET);
                _p(": magic-256 NPOS_GUARD reappeared in ");
                println(path);
                fail = fail + 1;
            }
        }
        fi = fi + 1;
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": no `NPOS_GUARD(S, 256)` in any mangle-path source file (10 files scanned)");
    }
    _check(label, fail);
    return fail;
}

# Gate: aarch64 DCE pass fn-count accessor + live[] cap (v6.0.4).
# Guards the two v6.0.4 regressions:
#   (1) the aarch64 DCE pass must size its fn-table loops with GFNC
#       (fn count), NOT GFCNT (fixup count) — GFCNT overflowed the
#       8192-slot hash → uncapped probe loop spun forever (kybernet
#       aarch64 cross-build hang, issue 2026-05-20).
#   (2) the live[] reachability bitmap must be 1024 bytes (8192-fn
#       cap), not 512 (4096) — a >4096-fn unit OOB-wrote past live[]
#       on both arches.
# See CHANGELOG [6.0.4].
fn _dce_fn_count_gate(): i64 {
    var label = "aarch64 DCE uses GFNC (not GFCNT) + live[1024]/8192-fn cap both arches (v6.0.4)";
    var aa = _root_path("src/backend/aarch64/fixup.cyr");
    var x86 = _root_path("src/backend/x86/fixup.cyr");
    var fail = 0;
    if (_file_contains_substr(aa, "var fnc = GFCNT") == 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": aarch64 fixup.cyr DCE fn-count reverted to GFCNT (fixup count) — re-opens the kybernet hang");
        fail = fail + 1;
    }
    if (_file_contains_substr(aa, "var live[512]") == 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": aarch64 fixup.cyr live[] reverted to 512 (4096-fn cap) — OOB past 4096 fns");
        fail = fail + 1;
    }
    if (_file_contains_substr(x86, "var live[512]") == 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": x86 fixup.cyr live[] reverted to 512 (4096-fn cap) — OOB past 4096 fns");
        fail = fail + 1;
    }
    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": aarch64 DCE fn-count is GFNC; live[1024]/8192-fn cap on both x86+aarch64");
    }
    _check(label, fail);
    return fail;
}

# Cap-drift gate (v5.11.50; refactored to use _verify_* helpers at
# v5.11.55). Cross-checks heap-map comments at src/main.cyr:24+
# against inline literal caps in src/frontend/lex.cyr. Each cap is
# two short helper calls (one for heap-map agreement, one for inline
# match); adding the next cap is two more calls.
fn _cap_drift_gate(): i64 {
    var label = "cap-drift detector — heap-map comments and inline literal caps agree (v5.11.50)";

    var main_cap = 524288;
    var main_buf = alloc(main_cap);
    var main_n = file_read_all(_root_path("src/main.cyr"), main_buf, main_cap);
    if (main_n <= 0) { _check(label, 1); return 1; }
    var lex_cap = 524288;
    var lex_buf = alloc(lex_cap);
    var lex_n = file_read_all(_root_path("src/frontend/lex.cyr"), lex_buf, lex_cap);
    if (lex_n <= 0) { _check(label, 1); return 1; }

    var fail = 0;

    # Cap 1: input_buf (1 MB).
    fail = fail + _verify_heap_map(main_buf, main_n, "0x00000  input_buf", "[1048576]", "1MB", "input_buf");
    fail = fail + _verify_inline(lex_buf, lex_n, ">= 1048576", "input_buf");

    # Cap 2: tok_names / identifier buffer (256 KB). Inline check uses
    # 261872 = 262144 - 272 (LEXID slack for the inner-loop write
    # window — see lex.cyr's NPOS_GUARD).
    fail = fail + _verify_heap_map(main_buf, main_n, "0x60000  tok_names", "[262144]", "256KB", "tok_names");
    fail = fail + _verify_inline(lex_buf, lex_n, ">= 261872", "tok_names");

    # Cap 3: str_data (2 MB). Inline-only check — str_data's heap-map
    # line is structured differently; a _verify_heap_map call can be
    # added if a future refactor makes that line uniform.
    fail = fail + _verify_inline(lex_buf, lex_n, ">= 2097152", "str_data");

    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": cap-drift — input_buf (1MB) + tok_names (256KB) + str_data (2MB) all in sync");
    }
    _check(label, fail);
    return fail;
}

# Gate: doc-size currency (v5.11.50). Scans selected fresh-tier docs
# (size-comparisons.md, platform-status.md, faq.md, README.md) for
# cycc size references and verifies they match the current build/cycc
# size. Two pattern classes are checked:
#
#   - PRECISE: `cycc NNN,NNN B` (e.g. "cycc 823,112 B") — must match
#     build/cycc exactly. Versioned historical refs ("(v5.8.31)") are
#     skipped via context-sensitive matching.
#   - APPROXIMATE: `cycc ~NNN KB` (e.g. "cycc ~823 KB") — must be
#     within ±25 KB of build/cycc's actual KB.
#
# The gate is **strict** by design: stale doc-size claims propagate
# downstream consumer confusion. If a historical version must be
# referenced, anchor it with the version tag so the gate skips it
# (this is the convention already used by docs/audit/*.md).
fn _doc_size_currency_gate(): i64 {
    var label = "doc-size currency — fresh-tier docs cite current cycc size (v5.11.50)";

    var cc5_size = _file_size(_root_path("build/cycc"));
    if (cc5_size <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": doc-size — build/cycc not readable; cannot validate doc references");
        _check(label, 1);
        return 1;
    }
    # Display KB uses decimal (1000-based) per common doc convention —
    # 823,112 B is "~823 KB" in prose, not "~804 KiB". Tolerance is
    # ±50,000 bytes (~5%); covers minor compile-time-perf cycc churn
    # within a cycle without re-flagging every doc on each slot.
    var cc5_kb_display = (cc5_size + 500) / 1000;

    # Scan each doc for any line containing "cycc" that mentions a
    # specific size. Skip lines that include a version tag like
    # "(v5.X.Y)" — those are intentional historical references.
    var paths = vec_new();
    vec_push(paths, str_from(_root_path("docs/size-comparisons.md")));
    vec_push(paths, str_from(_root_path("docs/platform-status.md")));
    vec_push(paths, str_from(_root_path("docs/guides/faq.md")));
    vec_push(paths, str_from(_root_path("README.md")));

    var fail = 0;
    var pi = 0;
    while (pi < vec_len(paths)) {
        var path_str = vec_get(paths, pi);
        var path = str_data(path_str);
        var dcap = 524288;
        var dbuf = alloc(dcap);
        var dn = file_read_all(path, dbuf, dcap);
        if (dn <= 0) { pi = pi + 1; }
        else {
            # Walk line-by-line
            var ls = 0;
            var line_no = 1;
            while (ls < dn) {
                var le = ls;
                while (le < dn && load8(dbuf + le) != 10) { le = le + 1; }
                # [ls, le) is a single line. Look for "cycc"
                var cc5_at = _find_str_from(dbuf, le, ls, "cycc", 3);
                if (cc5_at >= 0 && cc5_at < le) {
                    # Skip lines tagged with a historical version
                    var ver_at = _find_str_from(dbuf, le, ls, "(v5.", 4);
                    if (ver_at >= 0 && ver_at < le) {
                        # Historical reference — skip
                    } else {
                        # Look for "cycc ~" or "cycc " followed by NN KB pattern
                        # Approximate form: "~NNN KB" or "NNNKB"
                        var tilde_at = _find_str_from(dbuf, le, cc5_at, "~", 1);
                        if (tilde_at >= 0 && tilde_at < le && tilde_at - cc5_at < 20) {
                            # Parse the digits after ~
                            var end_pos = alloc(8);
                            var claimed_kb = _parse_dec_at(dbuf, le, tilde_at + 1, end_pos);
                            if (claimed_kb > 0) {
                                # Check for "KB" suffix nearby
                                var kb_at = _find_str_from(dbuf, le, tilde_at, "KB", 2);
                                if (kb_at >= 0 && kb_at < le && kb_at - tilde_at < 8) {
                                    # Compare in decimal-KB units (claimed × 1000 vs actual bytes).
                                    var claimed_b = claimed_kb * 1000;
                                    var diff = claimed_b - cc5_size;
                                    if (diff < 0) { diff = 0 - diff; }
                                    if (diff > 50000) {
                                        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
                                        _p(": doc-size — ");
                                        _p(path);
                                        _p(" line ");
                                        print_num(line_no);
                                        _p(" claims cycc ~");
                                        print_num(claimed_kb);
                                        _p(" KB; actual ");
                                        print_num(cc5_kb_display);
                                        println(" KB");
                                        fail = fail + 1;
                                    }
                                }
                            }
                        }
                        # Precise form: "NNN,NNN B" with comma
                        # (skip — most precise refs in the corpus today
                        # carry version tags and the version-tag skip above
                        # handles them. Future enhancement: parse precise
                        # form when un-tagged.)
                    }
                }
                ls = le + 1;
                line_no = line_no + 1;
            }
            pi = pi + 1;
        }
    }

    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        _p(": doc-size — fresh-tier docs cite cycc within ±50 KB of actual (");
        print_num(cc5_kb_display);
        println(" KB)");
    }
    _check(label, fail);
    return fail;
}

# Fork+exec cyrld with output path + N input .o paths. Returns
# 0 on success (cyrld exit 0), non-zero otherwise. cyrld's stdout
# goes to /dev/null; stderr inherited from dispatcher (so a real
# link error is visible).
fn _link_objects_invoke(cyrld_path, out_path, obj_paths_vec): i64 {
    var nobjs = vec_len(obj_paths_vec);
    var argv = alloc((nobjs + 4) * 8);
    store64(argv,         cyrld_path);
    store64(argv + 8,     "-o");
    store64(argv + 16,    out_path);
    var i = 0;
    while (i < nobjs) {
        store64(argv + (i + 3) * 8, vec_get(obj_paths_vec, i));
        i = i + 1;
    }
    store64(argv + (nobjs + 3) * 8, 0);

    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        var dn = sys_open("/dev/null", 1, 0);
        if (dn >= 0) { sys_dup2(dn, 1); sys_close(dn); }
        var envp[1];
        store64(&envp, 0);
        sys_execve(cyrld_path, argv, &envp);
        sys_exit(127);
    }
    var stbuf[1];
    sys_waitpid(pid, &stbuf, 0);
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# Compile fixture .cyr → .o via cycc. Returns 0 on success.
fn _compile_to_obj(src_path, obj_path): i64 {
    return _self_host_pipe(src_path, CC_PATH, obj_path);
}

# Bespoke gate: cyrld cross-module linker. Two test cases:
# (1) cross-module fn call — c.cyr's call_greet() resolves to
#     a.cyr's greet(); link order [c, a]; expect exit 43.
# (2) cross-module data + init ordering — m.cyr reads counter
#     defined in d.cyr after two inc_counter() calls; link order
#     [m, d]; expect exit 44. Also exercises DCE on
#     `never_called` (must drop without breaking live dispatch).
fn _linker_gate(): i64 {
    var cyrld = _root_path("build/cyrld");
    if (file_exists(cyrld) != 1) {
        _p("  skip: build/cyrld not present");
        println("");
        _check("cyrld cross-module link", 0);
        return 0;
    }
    var fa = _root_path("tests/fixtures/linker/a.cyr");
    var fc = _root_path("tests/fixtures/linker/c.cyr");
    var fd = _root_path("tests/fixtures/linker/d.cyr");
    var fm = _root_path("tests/fixtures/linker/m.cyr");

    var oa = _tmp_path("audit_link_a_");
    var oc = _tmp_path("audit_link_c_");
    var od = _tmp_path("audit_link_d_");
    var om = _tmp_path("audit_link_m_");

    var rca = _compile_to_obj(fa, oa);
    var rcc = _compile_to_obj(fc, oc);
    var rcd = _compile_to_obj(fd, od);
    var rcm = _compile_to_obj(fm, om);
    if (rca != 0) { _linker_gate_cleanup(oa, oc, od, om); _check("cyrld cross-module link", 1); return 1; }
    if (rcc != 0) { _linker_gate_cleanup(oa, oc, od, om); _check("cyrld cross-module link", 1); return 1; }
    if (rcd != 0) { _linker_gate_cleanup(oa, oc, od, om); _check("cyrld cross-module link", 1); return 1; }
    if (rcm != 0) { _linker_gate_cleanup(oa, oc, od, om); _check("cyrld cross-module link", 1); return 1; }

    # Test 1: link [c, a] → exe1, run, expect exit 43.
    var exe1 = _tmp_path("audit_link_exe1_");
    var args1 = vec_new();
    vec_push(args1, oc);
    vec_push(args1, oa);
    var lrc1 = _link_objects_invoke(cyrld, exe1, args1);
    if (lrc1 != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cyrld test1 returned ");
        print_num(lrc1);
        println("");
        _linker_gate_cleanup(oa, oc, od, om);
        sys_unlink(exe1);
        _check("cyrld cross-module link", 1);
        return 1;
    }
    sys_chmod(exe1, 493);
    var ec1 = _exec_run_clean(exe1);
    sys_unlink(exe1);
    if (ec1 != 43) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cross-module call exit ");
        print_num(ec1);
        println(" (expected 43)");
        _linker_gate_cleanup(oa, oc, od, om);
        _check("cyrld cross-module link", 1);
        return 1;
    }

    # Test 2: link [m, d] → exe2, run, expect exit 44.
    var exe2 = _tmp_path("audit_link_exe2_");
    var args2 = vec_new();
    vec_push(args2, om);
    vec_push(args2, od);
    var lrc2 = _link_objects_invoke(cyrld, exe2, args2);
    _linker_gate_cleanup(oa, oc, od, om);
    if (lrc2 != 0) {
        sys_unlink(exe2);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cyrld test2 returned ");
        print_num(lrc2);
        println("");
        _check("cyrld cross-module link", 1);
        return 1;
    }
    sys_chmod(exe2, 493);
    var ec2 = _exec_run_clean(exe2);
    sys_unlink(exe2);
    if (ec2 != 44) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": data + init ordering exit ");
        print_num(ec2);
        println(" (expected 44)");
        _check("cyrld cross-module link", 1);
        return 1;
    }

    _check("cyrld cross-module link", 0);
    return 0;
}

fn _linker_gate_cleanup(a, b, c, d): i64 {
    sys_unlink(a);
    sys_unlink(b);
    sys_unlink(c);
    sys_unlink(d);
    return 0;
}

# Fork+exec bin_path with one positional argv arg, capture stdout
# to a temp file, return bytes read into buf. stdin + stderr go to
# /dev/null. Used by gates that need to verify behavior under a
# specific argv shape (e.g. args_init >4 KB cmdline regression).
# v5.9.42: thin wrapper over lib/regression.cyr.
fn _exec_with_arg_capture(bin_path, arg, buf, buflen): i64 {
    return regression_exec_with_arg_capture(bin_path, arg, buf, buflen, EMPTY_ENVP);
}

# Synthesize a cyrius source containing N empty `struct SK { x; }`
# decls plus a trailing `syscall(60, 0);`. Writes to `path`. Used by
# `_struct_cap_gate` for cap-stress sub-cases.
fn _gen_struct_decls_source(path, n): i64 {
    var fd = sys_open(path, 577, 420);
    if (fd < 0) { return 0 - 1; }
    var sb = str_builder_new();
    var i = 0;
    while (i < n) {
        str_builder_add_cstr(sb, "struct S");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, " { x; }\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "syscall(60, 0);\n");
    var s = str_builder_build(sb);
    sys_write(fd, str_data(s), str_len(s));
    sys_close(fd);
    return 0;
}

# Bespoke gate: struct cap raise 64 → 256 + overflow diagnostic
# (v5.7.17; kybernet repro). Three sub-cases:
# (1) 80 structs — pre-v5.7.17 would fail at #65; post-fix compiles
#     + runs + exits 0.
# (2) 200 structs — kybernet-class multi-dep workload; compiles
#     clean.
# (3) 257 structs — overflow; compile MUST fail with diagnostic
#     substrings: "note: 256 structs registered" (header),
#     "#0 S0" (first dumped struct), "#255 S255" (last dumped),
#     and "too many struct definitions (max 256)" (final error).
fn _struct_cap_gate(): i64 {
    var fail = 0;

    # Case 1: 80 structs compile + run + exit 0.
    var src1 = _tmp_path("audit_sc1_src_");
    _gen_struct_decls_source(src1, 80);
    var ec1 = _compile_run_get_exit(src1);
    sys_unlink(src1);
    if (ec1 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case1 — 80-struct binary exit ");
        print_num(ec1);
        println(" (expected 0; cap regressed below 80)");
        fail = fail + 1;
    }

    # Case 2: 200 structs must compile clean.
    var src2 = _tmp_path("audit_sc2_src_");
    _gen_struct_decls_source(src2, 200);
    var bin2 = _tmp_path("audit_sc2_bin_");
    var rc2 = _self_host_pipe(src2, CC_PATH, bin2);
    sys_unlink(src2);
    sys_unlink(bin2);
    if (rc2 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case2 — 200-struct compile failed (rc=");
        print_num(rc2);
        println("; cap regressed below 200)");
        fail = fail + 1;
    }

    # Case 3: 257 structs overflow — compile MUST fail with
    # specific diagnostic strings.
    var src3 = _tmp_path("audit_sc3_src_");
    _gen_struct_decls_source(src3, 257);
    var err3 = _tmp_path("audit_sc3_err_");
    var rc3 = _compile_capture_stderr(src3, CC_PATH, err3);
    sys_unlink(src3);

    # rc3 is the wait-status from cycc. WIFEXITED + non-zero exit
    # means compile aborted (expected). If exit was 0 the source
    # compiled past 256 structs — that's a cap-not-enforced bug.
    var compile_failed = 1;
    if (WIFEXITED(rc3) == 1) {
        if (WEXITSTATUS(rc3) == 0) { compile_failed = 0; }
    }
    if (compile_failed != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case3 — 257-struct compile unexpectedly succeeded (cap > 256?)");
        fail = fail + 1;
    } else {
        # Check the four expected diagnostic substrings.
        if (_file_contains_substr(err3, "note: 256 structs registered") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case3 — overflow note missing 'note: 256 structs registered'");
            fail = fail + 1;
        }
        if (_file_contains_substr(err3, "#0 S0") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case3 — name-dump missing '#0 S0'");
            fail = fail + 1;
        }
        if (_file_contains_substr(err3, "#255 S255") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case3 — name-dump missing '#255 S255'");
            fail = fail + 1;
        }
        if (_file_contains_substr(err3, "too many struct definitions (max 256)") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case3 — final error line not updated to 'max 256'");
            fail = fail + 1;
        }
    }
    sys_unlink(err3);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": struct cap 64→256 + diagnostic dump (3/3 cases)");
    }
    _check("200-struct compile clean; 257-struct overflow dumps registered names (v5.7.17; kybernet)", fail);
    return fail;
}

# Helper: cstring path join (parent + "/" + child). Mirrors the
# cyrius-init.cyr `_join` helper since path_join takes Str (not
# cstring) and most check.cyr ops route through cstrings.
fn _join(parent, child): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, parent);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, child);
    return str_data(str_builder_build(sb));
}

# Helper: assert file exists at <pdir>/<rel>; bump fail if missing.
fn _check_file_exists(pdir, rel, fail_label): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, pdir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, rel);
    var path = str_data(str_builder_build(sb));
    if (file_exists(path) != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(fail_label);
        _p(" missing ");
        println(rel);
        return 1;
    }
    return 0;
}

# Helper: assert grep -q <substr> <pdir>/<rel>; bump fail if not found.
# `expect_match` = 1 means substr SHOULD be present; 0 means it
# SHOULD NOT (the bash inverse-grep cases).
fn _check_file_grep(pdir, rel, substr, expect_match, fail_label): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, pdir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, rel);
    var path = str_data(str_builder_build(sb));
    var hit = _file_contains_substr(path, substr);
    if (hit != expect_match) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(fail_label);
        if (expect_match == 1) { _p(" missing '"); }
        else                   { _p(" unexpected '"); }
        _p(substr);
        _p("' in ");
        println(rel);
        return 1;
    }
    return 0;
}

# Helper: scaffold a project via scripts/cyrius-init.sh in scratch
# dir. Returns proj root path on success, 0 on failure (caller
# emits its own FAIL).
fn _scaffold_init(scratch_dir, init_script, flag, name): i64 {
    sys_mkdir(scratch_dir, 493);
    var out = _tmp_path("audit_init_out_");
    var ec = _exec_in_dir3(scratch_dir, "/bin/sh", init_script, flag, name, out);
    sys_unlink(out);
    if (ec != 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, scratch_dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, name);
    return str_data(str_builder_build(sb));
}

# Bespoke gate (v5.9.31; per the v5.9.x .sh-conversion arc):
# `cyrius init --lib`/`--bin`/bare scaffolding shape.
# Mechanical port of `tests/regression-init-lib-bin.sh` (v5.7.15
# pin) — same 4 cases, same assertions, exec scripts/cyrius-init.sh
# directly so the test still validates the bash impl until the
# v5.9.28/29-onward cyrius-init.cyr port grows full coverage.
fn _init_lib_bin_gate(): i64 {
    var label = "cyrius init --lib emits programs/smoke.cyr + [lib]; --bin/bare keep binary shape (v5.7.15)";
    var init_script = _root_path("scripts/cyrius-init.sh");
    if (file_exists(init_script) != 1) {
        _p("  skip: ");
        _p(init_script);
        println(" missing");
        _check(label, 0);
        return 0;
    }
    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_init_lb_");
    sys_mkdir(scratch, 493);
    var fail = 0;

    # Case 1: --lib emits library shape, builds smoke clean.
    var c1 = _join(scratch, "case1");
    var p1 = _scaffold_init(c1, init_script, "--lib", "mylib");
    if (p1 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case1 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(p1, "programs/smoke.cyr", "case1 (--lib)");
        var test_path = _join(p1, "src/test.cyr");
        if (file_exists(test_path) == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case1 src/test.cyr emitted in lib shape (should be omitted)");
            fail = fail + 1;
        }
        fail = fail + _check_file_grep(p1, "cyrius.cyml", "[lib]",                          1, "case1");
        fail = fail + _check_file_grep(p1, "cyrius.cyml", "\ntest ",                        0, "case1");
        fail = fail + _check_file_grep(p1, "cyrius.cyml", "entry = \"programs/smoke.cyr\"", 1, "case1");
        # Build smoke + run.
        var build_out = _tmp_path("audit_init_b_");
        var ec_b = _exec_in_dir3(p1, cyrius_bin, "build", "programs/smoke.cyr", "build/mylib-smoke", build_out);
        sys_unlink(build_out);
        if (ec_b != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": case1 cyrius build smoke exit ");
            print_num(ec_b);
            println("");
            fail = fail + 1;
        } else {
            var smoke_bin = _join(p1, "build/mylib-smoke");
            if (file_exists(smoke_bin) != 1) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": case1 build/mylib-smoke not produced");
                fail = fail + 1;
            } else {
                var ec_r = _exec_run_clean(smoke_bin);
                if (ec_r != 0) {
                    _p("    ");
                    _p(ANSI_RED);
                    _p("case-FAIL");
                    _p(ANSI_RESET);
                    _p(": case1 smoke run exit ");
                    print_num(ec_r);
                    println("");
                    fail = fail + 1;
                }
            }
        }
    }

    # Case 2: --bin emits binary shape (existing behavior preserved).
    var c2 = _join(scratch, "case2");
    var p2 = _scaffold_init(c2, init_script, "--bin", "foo");
    if (p2 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case2 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(p2, "src/main.cyr", "case2 (--bin)");
        fail = fail + _check_file_exists(p2, "src/test.cyr", "case2 (--bin)");
        var prog_dir = _join(p2, "programs");
        if (file_exists(prog_dir) == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case2 programs/ created for bin shape (should not exist)");
            fail = fail + 1;
        }
        fail = fail + _check_file_grep(p2, "cyrius.cyml", "entry = \"src/main.cyr\"", 1, "case2");
        var build_out = _tmp_path("audit_init_b_");
        var ec_b = _exec_in_dir3(p2, cyrius_bin, "build", "src/main.cyr", "build/foo", build_out);
        sys_unlink(build_out);
        if (ec_b != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": case2 cyrius build bin exit ");
            print_num(ec_b);
            println("");
            fail = fail + 1;
        } else {
            var bin_path = _join(p2, "build/foo");
            if (file_exists(bin_path) == 1) {
                var ec_r = _exec_run_clean(bin_path);
                if (ec_r != 0) {
                    _p("    ");
                    _p(ANSI_RED);
                    _p("case-FAIL");
                    _p(ANSI_RESET);
                    _p(": case2 bin run exit ");
                    print_num(ec_r);
                    println("");
                    fail = fail + 1;
                }
            }
        }
    }

    # Case 3: bare invocation defaults to bin.
    var c3 = _join(scratch, "case3");
    sys_mkdir(c3, 493);
    var c3_out = _tmp_path("audit_init_c3_");
    var ec_c3 = _exec_in_dir3(c3, "/bin/sh", init_script, "bareproj", 0, c3_out);
    sys_unlink(c3_out);
    if (ec_c3 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case3 bare init exit non-zero");
        fail = fail + 1;
    } else {
        var p3 = _join(c3, "bareproj");
        var p3_prog = _join(p3, "programs");
        if (file_exists(p3_prog) == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case3 bare init created programs/ (should default to --bin)");
            fail = fail + 1;
        }
        fail = fail + _check_file_grep(p3, "cyrius.cyml", "entry = \"src/main.cyr\"", 1, "case3");
    }

    # Case 4: --lib CI workflow build cmd targets programs/smoke.cyr.
    var c4 = _join(scratch, "case4");
    var p4 = _scaffold_init(c4, init_script, "--lib", "libci");
    if (p4 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case4 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_grep(p4, ".github/workflows/ci.yml", "cyrius build src/main.cyr",                  0, "case4");
        fail = fail + _check_file_grep(p4, ".github/workflows/ci.yml", "cyrius build programs/smoke.cyr build/",    1, "case4");
    }

    _exec_in_dir3("/tmp", "/bin/rm", "-rf", scratch, 0, 0);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius init --lib/--bin/bare (4/4 cases)");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate (v5.9.31): cyrius init / cyrius port doc-tree
# emission. Mechanical port of `tests/regression-init-doctree.sh`
# (v5.7.16 pin) — 5 cases over the 8-file doc tree (adr /
# architecture / guides / examples / development) + CLAUDE.md
# shape checks (no inlined volatile state, shape-aware build
# hint, state.md carries the toolchain pin).
fn _init_doctree_gate(): i64 {
    var label = "cyrius init/port emit adr/architecture/guides/examples/development + CLAUDE.md (v5.7.16)";
    var init_script = _root_path("scripts/cyrius-init.sh");
    var port_script = _root_path("scripts/cyrius-port.sh");
    if (file_exists(init_script) != 1) {
        _p("  skip: scripts/cyrius-init.sh missing");
        println("");
        _check(label, 0);
        return 0;
    }
    if (file_exists(port_script) != 1) {
        _p("  skip: scripts/cyrius-port.sh missing");
        println("");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_init_dt_");
    sys_mkdir(scratch, 493);
    var fail = 0;

    # Case 1: cyrius init --lib emits full doc-tree.
    var c1 = _join(scratch, "case1");
    var p1 = _scaffold_init(c1, init_script, "--lib", "mylib");
    if (p1 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case1 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(p1, "docs/adr/README.md",                "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/adr/template.md",              "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/architecture/README.md",       "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/guides/getting-started.md",    "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/examples/.gitkeep",            "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/development/state.md",         "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/development/roadmap.md",       "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "CLAUDE.md",                         "case1 (--lib)");
        fail = fail + _check_file_grep(p1, "docs/adr/template.md", "# NNNN ",            1, "case1 ADR template");
        # Bash original: `grep -E '^\*\*Version\*\*: \[?[0-9]'` —
        # detects an INLINED version number (digit or `[` after the
        # bold marker). The valid CLAUDE.md text is `**Version**:
        # VERSION at the project root is the source of truth` (no
        # number). Approximate via "do not inline the number" check.
        fail = fail + _check_file_grep(p1, "CLAUDE.md", "do not inline the number",       1, "case1 CLAUDE.md version-sync hint");
        fail = fail + _check_file_grep(p1, "CLAUDE.md", "docs/development/state.md",     1, "case1 CLAUDE.md → state.md link");
        fail = fail + _check_file_grep(p1, "CLAUDE.md", "cyrius build programs/smoke.cyr", 1, "case1 CLAUDE.md lib build hint");
    }

    # Case 2: cyrius init --bin doc-tree.
    var c2 = _join(scratch, "case2");
    var p2 = _scaffold_init(c2, init_script, "--bin", "foo");
    if (p2 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case2 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(p2, "docs/adr/README.md",                "case2 (--bin)");
        fail = fail + _check_file_exists(p2, "docs/development/state.md",         "case2 (--bin)");
        fail = fail + _check_file_exists(p2, "CLAUDE.md",                         "case2 (--bin)");
        fail = fail + _check_file_grep(p2, "CLAUDE.md", "cyrius build src/main.cyr", 1, "case2 CLAUDE.md bin build hint");
    }

    # Case 3: bare cyrius init defaults to bin + still gets doc-tree.
    var c3 = _join(scratch, "case3");
    sys_mkdir(c3, 493);
    var c3_out = _tmp_path("audit_init_dt_c3_");
    var ec_c3 = _exec_in_dir3(c3, "/bin/sh", init_script, "bareproj", 0, c3_out);
    sys_unlink(c3_out);
    if (ec_c3 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case3 bare init exit non-zero");
        fail = fail + 1;
    } else {
        var p3 = _join(c3, "bareproj");
        fail = fail + _check_file_exists(p3, "docs/adr/README.md",                "case3 (bare)");
        fail = fail + _check_file_exists(p3, "CLAUDE.md",                         "case3 (bare)");
    }

    # Case 4: cyrius port mirrors the same doc-tree.
    var c4 = _join(scratch, "case4/portproj");
    sys_mkdir(_join(scratch, "case4"), 493);
    sys_mkdir(c4, 493);
    sys_mkdir(_join(c4, "src"), 493);
    _write_file(_join(c4, "src/main.rs"), "fn main() {}\n");
    _write_file(_join(c4, "Cargo.toml"), "[package]\nname = \"portproj\"\nversion = \"0.1.0\"\nedition = \"2021\"\n");
    var c4_out = _tmp_path("audit_init_dt_c4_");
    var ec_c4 = _exec_in_dir3(_join(scratch, "case4"), "/bin/sh", port_script, c4, 0, c4_out);
    sys_unlink(c4_out);
    if (ec_c4 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case4 cyrius port exit ");
        print_num(ec_c4);
        println("");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(c4, "docs/adr/README.md",                "case4 (cyrius port)");
        fail = fail + _check_file_exists(c4, "CLAUDE.md",                         "case4 (cyrius port)");
        fail = fail + _check_file_grep(c4, "CLAUDE.md", "rust-old", 1, "case4 port CLAUDE.md");
    }

    # Case 5: state.md carries 'Cyrius pin'; CLAUDE.md does not.
    var c5 = _join(scratch, "case5");
    var p5 = _scaffold_init(c5, init_script, "--lib", "pinproj");
    if (p5 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case5 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_grep(p5, "docs/development/state.md", "Cyrius pin", 1, "case5 state.md pin line");
        fail = fail + _check_file_grep(p5, "CLAUDE.md",                  "\n- **Cyrius pin**", 0, "case5 CLAUDE.md no leaked pin");
    }

    _exec_in_dir3("/tmp", "/bin/rm", "-rf", scratch, 0, 0);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius init/port doc-tree (5/5 cases)");
    }
    _check(label, fail);
    return fail;
}

# Count occurrences of needle (cstring) in buf[0..n].
# v5.9.42: thin wrapper over lib/regression.cyr's
# `regression_count_substr`. Local `_buf_eq` callers
# preserved in this file for back-compat; the lib version uses
# `regression_buf_eq` internally — same byte logic.
fn _count_substr_buf(buf, n, needle): i64 {
    return regression_count_substr(buf, n, needle);
}

# Variant of _exec_with_arg_capture that captures BOTH stdout
# and stderr into the same temp file. Used when the target tool
# emits diagnostics to stderr (cyrlint warnings) but the gate
# wants to scan them.
# v5.9.42: thin wrapper over lib/regression.cyr.
fn _exec_with_arg_capture_both(bin_path, arg, buf, buflen): i64 {
    return regression_exec_with_arg_capture_both(bin_path, arg, buf, buflen, EMPTY_ENVP);
}

# Run `cyrlint <file_path>`, capture combined stdout+stderr,
# count occurrences of the marker substring. cyrlint emits its
# per-line warnings to stderr; the trailing "N warnings" summary
# line goes to stdout — both are captured. Used by
# `_lint_init_order_gate` (and any future cyrlint-output
# regression). Returns the count.
fn _cyrlint_count_marker(file_path, marker, buf, buflen): i64 {
    var n = _exec_with_arg_capture_both(CYRLINT_PATH, file_path, buf, buflen);
    return _count_substr_buf(buf, n, marker);
}

# v5.9.41 — TCP probe for "is this host:port reachable?". Replaces
# the bash `/dev/tcp` trick previously used in
# `tests/regression-tls-live.sh`. Non-blocking connect + poll-with-
# timeout + SO_ERROR readback so the call is bounded (a blackhole
# blocks vanilla connect() for ~75 s on Linux). Returns 1 on
# reachable, 0 otherwise.
#
# `addr_ipv4` is a network-byte-order packed uint32 (e.g.
# `1 | (1 << 8) | (1 << 16) | (1 << 24)` for 1.1.1.1; same shape
# `lib/net.cyr` uses).
#
# Raw syscalls (Linux x86_64; programs/check.cyr is host-only):
#   socket=41, connect=42, getsockopt=55, poll=7, fcntl=72,
#   close=3, F_GETFL=3, F_SETFL=4, O_NONBLOCK=2048, AF_INET=2,
#   SOCK_STREAM=1, POLLOUT=4, EINPROGRESS=115, SOL_SOCKET=1,
#   SO_ERROR=4.
# v5.9.42: thin wrapper over lib/regression.cyr.
fn _network_probe_check(addr_ipv4, port, timeout_ms): i64 {
    return regression_network_probe(addr_ipv4, port, timeout_ms);
}

# v5.9.41 — fork + exec a binary with a wall-clock timeout.
# Same shape as `_ssh_remote_exit` but bounded: polls
# waitpid(WNOHANG) every 100 ms; on timeout SIGKILLs the child
# and reaps. Replaces the bash `timeout 30 binary` pattern
# previously used by `tests/regression-tls-live.sh`.
#
# Returns:
#   0..127     normal exit code
#   128..192   128 + WTERMSIG (signal-killed by something else)
#   -1         fork / exec failure
#   -2         timeout (child SIGKILL'd)
# v5.9.42: thin wrapper over lib/regression.cyr.
fn _run_with_timeout(bin_path, timeout_ms): i64 {
    return regression_run_with_timeout(bin_path, timeout_ms, ENVP_ARR);
}

# Pipe `src_path`'s bytes to `bin_path`'s stdin, capture stdout
# to `out_path` (pass 0 for /dev/null), send stderr to /dev/null,
# return WEXITSTATUS (or 128 + signum on signal). Used by gates
# that need to inspect the bin's output bytes (cx-roundtrip
# byte-noise check) AND by gates that only care about exit status
# (cx-build).
# v5.9.42: thin wrappers over lib/regression.cyr.
fn _pipe_file_to_bin_capture(bin_path, src_path, out_path): i64 {
    return regression_pipe_to_bin_capture(bin_path, src_path, out_path, EMPTY_ENVP);
}

fn _pipe_file_to_bin(bin_path, src_path): i64 {
    return regression_pipe_to_bin(bin_path, src_path, EMPTY_ENVP);
}

# v5.9.11: hex-substring extractor used by source-grep parity
# gates. Find line containing `marker` substring in buf[0..n];
# read the FIRST `0x...` hex literal on that line (whether
# before or after the marker) into a fresh null-terminated
# cstring. Returns 0 on miss.
fn _extract_hex_in_line_with(buf, n, marker): i64 {
    var mlen = strlen(marker);
    var i = 0;
    while (i + mlen <= n) {
        if (_buf_eq(buf + i, marker, mlen) == 1) {
            # Walk back to line start.
            var ls = i;
            while (ls > 0) {
                if (load8(buf + ls - 1) == 10) { break; }
                ls = ls - 1;
            }
            # Walk forward to line end.
            var le = i + mlen;
            while (le < n) {
                if (load8(buf + le) == 10) { break; }
                le = le + 1;
            }
            # Within [ls, le), find the first "0x" + read hex digits.
            var p = ls;
            while (p + 1 < le) {
                if (load8(buf + p) == 48 && load8(buf + p + 1) == 120) {
                    var hex_start = p;
                    var hex_end = p + 2;
                    while (hex_end < le) {
                        var c = load8(buf + hex_end);
                        var is_hex = 0;
                        if (c >= 48 && c <= 57)  { is_hex = 1; }
                        if (c >= 65 && c <= 70)  { is_hex = 1; }
                        if (c >= 97 && c <= 102) { is_hex = 1; }
                        if (is_hex == 0) { break; }
                        hex_end = hex_end + 1;
                    }
                    var hl = hex_end - hex_start;
                    var copy = alloc(hl + 1);
                    var k = 0;
                    while (k < hl) {
                        store8(copy + k, load8(buf + hex_start + k));
                        k = k + 1;
                    }
                    store8(copy + hl, 0);
                    return copy;
                }
                p = p + 1;
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return 0;
}

# Read a source file into a freshly-alloc'd buffer; return the
# pointer (with null-terminator). Length is set in *len_out.
# Returns 0 on read failure.
fn _read_source_for_grep(path, len_out): i64 {
    var cap = 524288;
    var buf = alloc(cap + 1);
    var n = file_read_all(path, buf, cap);
    if (n <= 0) { store64(len_out, 0); return 0; }
    store8(buf + n, 0);
    store64(len_out, n);
    return buf;
}

# Bespoke gate: cross-backend token-offset parity (v5.7.28).
# Walks src/frontend/lex.cyr (canonical write offsets for typ /
# val), src/common/util.cyr (STLINE write + GTLINE read for
# line), and the three backend emit.cyr files (TOKTYP / TOKVAL
# read offsets). All backends must agree with the lex writes;
# any drift = silent miscompile (the v5.7.28 incident:
# cycc_cx silently broken on every input because src/backend/cx/
# emit.cyr was skipped during the v5.7.27 heap reshuffle).
fn _cx_token_offsets_gate(): i64 {
    var label = "lex token writes match every backend's TOKTYP / TOKVAL reads (v5.7.28)";
    var fail = 0;

    var lex_n[1];
    var lex_buf = _read_source_for_grep(_root_path("src/frontend/lex.cyr"), &lex_n);
    var util_n[1];
    var util_buf = _read_source_for_grep(_root_path("src/common/util.cyr"), &util_n);
    # v6.0.8 — TOKTYP / TOKVAL extracted from per-backend emit.cyr
    # files into src/backend/common/tokens.cyr (shared by x86 +
    # aarch64 + cx). One source of truth instead of three.
    var tok_n[1];
    var tok_buf = _read_source_for_grep(_root_path("src/backend/common/tokens.cyr"), &tok_n);

    if (lex_buf == 0 || util_buf == 0 || tok_buf == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": could not read lex / util / common/tokens source files");
        _check(label, 1);
        return 1;
    }

    var lex_typ  = _extract_hex_in_line_with(lex_buf,  load64(&lex_n),  "tc * 8, typ");
    var lex_val  = _extract_hex_in_line_with(lex_buf,  load64(&lex_n),  "tc * 8, val");
    var lex_line = _extract_hex_in_line_with(util_buf, load64(&util_n), "fn STLINE(");
    var gtline   = _extract_hex_in_line_with(util_buf, load64(&util_n), "fn GTLINE(");

    if (lex_typ == 0 || lex_val == 0 || lex_line == 0 || gtline == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": could not extract canonical lex/util write offsets");
        _check(label, 1);
        return 1;
    }

    if (gtline != lex_line) {
        if (streq(gtline, lex_line) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": GTLINE reads ");
            _p(gtline);
            _p(", STLINE writes at ");
            _p(lex_line);
            println(" — drift!");
            fail = fail + 1;
        }
    }

    # v6.0.8 — one canonical check against src/backend/common/tokens.cyr
    # (all backends share these defs). The per-backend cases were
    # collapsed at the same slot.
    fail = fail + _check_backend_token_offsets("common",
        tok_buf, load64(&tok_n), lex_typ, lex_val);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": lex tokens (typ=");
        _p(lex_typ);
        _p(", val=");
        _p(lex_val);
        _p(", line=");
        _p(lex_line);
        println(") — all backends in sync (v5.7.28)");
    }
    _check(label, fail);
    return fail;
}

# Helper for `_cx_token_offsets_gate`: extract a backend's
# TOKTYP + TOKVAL offsets, compare against the canonical lex
# writes. Returns 0 on PASS, count of mismatches on FAIL.
fn _check_backend_token_offsets(name, buf, n, lex_typ, lex_val): i64 {
    var typ = _extract_hex_in_line_with(buf, n, "fn TOKTYP(");
    var val = _extract_hex_in_line_with(buf, n, "fn TOKVAL(");
    var fails = 0;
    if (typ == 0 || val == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(name);
        println(" backend — missing TOKTYP / TOKVAL definitions");
        return 1;
    }
    if (streq(typ, lex_typ) != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(name);
        _p(" TOKTYP reads ");
        _p(typ);
        _p(", lex writes typ at ");
        _p(lex_typ);
        println(" — drift!");
        fails = fails + 1;
    }
    if (streq(val, lex_val) != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(name);
        _p(" TOKVAL reads ");
        _p(val);
        _p(", lex writes val at ");
        _p(lex_val);
        println(" — drift!");
        fails = fails + 1;
    }
    return fails;
}

# Helper for `_cx_syscall_literal_gate`: write `syscall(60, V);`
# to a temp source file, compile with cycc_cx (capturing bytecode
# to a temp file), feed bytecode to cxvm, return cxvm's exit
# code. Returns -1 on internal error. Cleans up both temp files.
fn _cx_syscall_run(cc_cx, cxvm, v): i64 {
    var src_path = _tmp_path("audit_cxsy_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { return 0 - 1; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "syscall(60, ");
    str_builder_add_int(sb, v);
    str_builder_add_cstr(sb, ");\n");
    var s = str_builder_build(sb);
    sys_write(fd, str_data(s), str_len(s));
    sys_close(fd);

    var bc_path = _tmp_path("audit_cxsy_bc_");
    var compile_ec = _pipe_file_to_bin_capture(cc_cx, src_path, bc_path);
    sys_unlink(src_path);
    if (compile_ec >= 128) { sys_unlink(bc_path); return 0 - 1; }

    var run_ec = _pipe_file_to_bin(cxvm, bc_path);
    sys_unlink(bc_path);
    return run_ec;
}

# Bespoke gate: cx codegen propagates literal syscall args
# (v5.7.23). Builds cycc_cx + cxvm; compiles `syscall(60, 42);`
# and inspects the bytecode for `01 00 3c 00` (MOVI r0, 60) and
# `01 00 2a 00` (MOVI r0, 42); runs the bytecode through cxvm
# and confirms exit 42; loops V in {0, 7, 99, 200} and confirms
# cxvm exit == V each time.
fn _cx_syscall_literal_gate(): i64 {
    var label = "cycc_cx propagates literal syscall args; cxvm exits with user code (v5.7.23)";
    var cc_cx = _tmp_path("audit_cxsy_cc_");
    var cxvm  = _tmp_path("audit_cxsy_vm_");
    var rc1 = _self_host_pipe(_root_path("src/main_cx.cyr"), CC_PATH, cc_cx);
    var rc2 = _self_host_pipe(_root_path("programs/cxvm.cyr"), CC_PATH, cxvm);
    if (WIFEXITED(rc1) != 1) { rc1 = 0 - 1; } else { rc1 = WEXITSTATUS(rc1); }
    if (WIFEXITED(rc2) != 1) { rc2 = 0 - 1; } else { rc2 = WEXITSTATUS(rc2); }
    if (rc1 != 0 || rc2 != 0) {
        sys_unlink(cc_cx); sys_unlink(cxvm);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cycc_cx / cxvm build failed");
        _check(label, 1);
        return 1;
    }
    sys_chmod(cc_cx, 493);
    sys_chmod(cxvm,  493);

    var fail = 0;

    # Sub-check 1+2: bytecode for `syscall(60, 42);` must contain
    # the two MOVI byte sequences. Compile to a buffer + scan.
    var lit_src = _tmp_path("audit_cxsy_litsrc_");
    var lf = sys_open(lit_src, 577, 420);
    var lit_text = "syscall(60, 42);\n";
    sys_write(lf, lit_text, strlen(lit_text));
    sys_close(lf);

    var lit_bc = _tmp_path("audit_cxsy_litbc_");
    _pipe_file_to_bin_capture(cc_cx, lit_src, lit_bc);
    sys_unlink(lit_src);

    var bc_size = _file_size(lit_bc);
    if (bc_size > 0) {
        var bc_buf = alloc(bc_size);
        file_read_all(lit_bc, bc_buf, bc_size);
        var movi60[1];
        store8(&movi60,     0x01);
        store8(&movi60 + 1, 0x00);
        store8(&movi60 + 2, 0x3c);
        store8(&movi60 + 3, 0x00);
        if (_find_bytes(bc_buf, bc_size, &movi60, 4) < 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": bytecode missing MOVI r0, 60 (01 00 3c 00) — literal not propagating");
            fail = fail + 1;
        }
        var movi42[1];
        store8(&movi42,     0x01);
        store8(&movi42 + 1, 0x00);
        store8(&movi42 + 2, 0x2a);
        store8(&movi42 + 3, 0x00);
        if (_find_bytes(bc_buf, bc_size, &movi42, 4) < 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": bytecode missing MOVI r0, 42 (01 00 2a 00) — literal not propagating");
            fail = fail + 1;
        }
    } else {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": cycc_cx produced empty bytecode");
        fail = fail + 1;
    }

    # Sub-check 3: cxvm executes lit_bc and exits 42.
    var ec_lit = _pipe_file_to_bin(cxvm, lit_bc);
    sys_unlink(lit_bc);
    if (ec_lit != 42) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": cxvm exit was ");
        print_num(ec_lit);
        println(" (expected 42)");
        fail = fail + 1;
    }

    # Sub-check 4: loop V ∈ {0, 7, 99, 200}, expect cxvm exit == V.
    var vals[5];
    store64(&vals,      0);
    store64(&vals + 8,  7);
    store64(&vals + 16, 99);
    store64(&vals + 24, 200);
    var i = 0;
    while (i < 4) {
        var v = load64(&vals + i * 8);
        var got = _cx_syscall_run(cc_cx, cxvm, v);
        if (got != v) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": cxvm exit was ");
            print_num(got);
            _p(" for syscall(60, ");
            print_num(v);
            _p(") (expected ");
            print_num(v);
            println(")");
            fail = fail + 1;
        }
        i = i + 1;
    }

    sys_unlink(cc_cx);
    sys_unlink(cxvm);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cx codegen propagates syscall literal args; cxvm exits with the user-supplied code");
    }
    _check(label, fail);
    return fail;
}

# v5.9.40 Phase 2c gates — three end-to-end fixtures exercising
# the three cx-pending sites that v5.9.40 closes:
#   _cx_struct_byval_gate       — `fn mkp(): S { ... return p; }`
#                                  + `var p: S = mkp(); p.x` round-trip
#                                  through the cxvm interpreter. Was the
#                                  parse_fn.cyr:371 `cx pending Phase 2c`
#                                  ERR_MSG site.
#   _cx_sub_byte_field_load_gate — i8/i16/i32/i64 mixed struct fields,
#                                  read each via dot-syntax, sum to known
#                                  exit code. Closes parse_decl.cyr:252.
#   _cx_seven_args_gate          — 7-param fn `add7` returning sum;
#                                  caller passes 7 literal args.
#                                  Validates cx ECALLPOPS popping into
#                                  r3..r9 and ESTOREPARM storing param 7
#                                  via the same r-to-frame shape.
#
# All three follow the `_cx_syscall_literal_gate` pattern: build cycc_cx
# + cxvm via cycc, write fixture src to a tmp path, pipe through cycc_cx,
# pipe the resulting .cyx through cxvm, exit code is the test signal
# (42 for byval/sub-byte; 28 for 7-args = 1+2+3+4+5+6+7).
#
# Shared helper `_cx_run_fixture` factors out the build/pipe/run shape
# so each gate body is just write-fixture → run → exit-check.
fn _cx_run_fixture(cc_cx, cxvm, src_text, src_tag, bc_tag): i64 {
    var src = _tmp_path(src_tag);
    _write_file(src, src_text);
    var bc = _tmp_path(bc_tag);
    _pipe_file_to_bin_capture(cc_cx, src, bc);
    sys_unlink(src);
    var ec = _pipe_file_to_bin(cxvm, bc);
    sys_unlink(bc);
    return ec;
}

fn _cx_phase2c_gate(): i64 {
    var label = "cx Phase 2c parity: struct-byval / sub-byte field load / 7-args (pin v5.9.40)";
    var cc_cx = _tmp_path("audit_cx2c_cc_");
    var cxvm  = _tmp_path("audit_cx2c_vm_");
    var rc1 = _self_host_pipe(_root_path("src/main_cx.cyr"), CC_PATH, cc_cx);
    var rc2 = _self_host_pipe(_root_path("programs/cxvm.cyr"), CC_PATH, cxvm);
    if (WIFEXITED(rc1) != 1) { rc1 = 0 - 1; } else { rc1 = WEXITSTATUS(rc1); }
    if (WIFEXITED(rc2) != 1) { rc2 = 0 - 1; } else { rc2 = WEXITSTATUS(rc2); }
    if (rc1 != 0 || rc2 != 0) {
        sys_unlink(cc_cx); sys_unlink(cxvm);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cycc_cx / cxvm build failed");
        _check(label, 1);
        return 1;
    }
    sys_chmod(cc_cx, 493);
    sys_chmod(cxvm,  493);

    var fail = 0;

    # --- Sub-check 1: struct-by-value return ---
    var byval_src = "struct S { x: i64; }\nfn mkp(): S {\n    var p: S;\n    p.x = 42;\n    return p;\n}\nfn main() {\n    var p: S = mkp();\n    syscall(60, p.x);\n}\nmain();\n";
    var byval_ec = _cx_run_fixture(cc_cx, cxvm, byval_src, "audit_cx2c_byval_src_", "audit_cx2c_byval_bc_");
    if (byval_ec != 42) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": struct-byval cxvm exit=");
        print_num(byval_ec);
        println(" (expected 42 — `var p: S = mkp(); p.x` round-trip)");
        fail = fail + 1;
    }

    # --- Sub-check 2: sub-byte struct field load ---
    var sb_src = "struct Sizes { a: i8; b: i16; c: i32; d: i64; }\nfn main() {\n    var s: Sizes;\n    s.a = 7;\n    s.b = 13;\n    s.c = 1;\n    s.d = 21;\n    var sum = s.a + s.b + s.c + s.d;\n    syscall(60, sum);\n}\nmain();\n";
    var sb_ec = _cx_run_fixture(cc_cx, cxvm, sb_src, "audit_cx2c_subbyte_src_", "audit_cx2c_subbyte_bc_");
    if (sb_ec != 42) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": sub-byte field load cxvm exit=");
        print_num(sb_ec);
        println(" (expected 42 = 7+13+1+21 across i8/i16/i32/i64 fields)");
        fail = fail + 1;
    }

    # --- Sub-check 3: 7-arg fn call ---
    var sa_src = "fn add7(a, b, c, d, e, f, g) { return a + b + c + d + e + f + g; }\nfn main() {\n    var s = add7(1, 2, 3, 4, 5, 6, 21);\n    syscall(60, s);\n}\nmain();\n";
    var sa_ec = _cx_run_fixture(cc_cx, cxvm, sa_src, "audit_cx2c_7args_src_", "audit_cx2c_7args_bc_");
    if (sa_ec != 42) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": 7-args cxvm exit=");
        print_num(sa_ec);
        println(" (expected 42 = 1+2+3+4+5+6+21 — exercises ECALLPOPS r3..r9)");
        fail = fail + 1;
    }

    sys_unlink(cc_cx);
    sys_unlink(cxvm);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cx Phase 2c parity (3/3 sub-checks)");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: cycc_cx output is well-formed CYX bytecode with
# no x86 instruction-byte pollution (v5.7.12 path B). Builds
# cycc_cx + cxvm via cycc; pipes empty input to cycc_cx and checks
# output ≥ 8 B + starts with "CYX"; pipes a one-fn program and
# checks output contains no `48 89 5d f8` (x86 callee-save) or
# `4c 8b 65 f0` (callee-restore) byte sequences; pipes the
# bytecode to cxvm and checks it doesn't SIGSEGV and doesn't
# emit "not a .cyx file".
fn _cx_roundtrip_gate(): i64 {
    var label = "cycc_cx output: well-formed CYX, no x86 noise; cxvm consumes (v5.7.12 path B)";
    var src_cx = _root_path("src/main_cx.cyr");
    var src_vm = _root_path("programs/cxvm.cyr");
    var cc_cx = _tmp_path("audit_cxrt_cc_");
    var cxvm  = _tmp_path("audit_cxrt_vm_");
    var rc1 = _self_host_pipe(src_cx, CC_PATH, cc_cx);
    var rc2 = _self_host_pipe(src_vm, CC_PATH, cxvm);
    if (WIFEXITED(rc1) != 1) { rc1 = 0 - 1; } else { rc1 = WEXITSTATUS(rc1); }
    if (WIFEXITED(rc2) != 1) { rc2 = 0 - 1; } else { rc2 = WEXITSTATUS(rc2); }
    if (rc1 != 0) {
        sys_unlink(cc_cx); sys_unlink(cxvm);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cycc build of main_cx.cyr failed");
        _check(label, 1);
        return 1;
    }
    if (rc2 != 0) {
        sys_unlink(cc_cx); sys_unlink(cxvm);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cycc build of programs/cxvm.cyr failed");
        _check(label, 1);
        return 1;
    }
    sys_chmod(cc_cx, 493);
    sys_chmod(cxvm,  493);

    var fail = 0;

    # Sub-check 1+2: empty input → ≥8 B output starting with "CYX".
    var empty_path = _tmp_path("audit_cxrt_empty_");
    var ef = sys_open(empty_path, 577, 420);
    sys_close(ef);
    var out1 = _tmp_path("audit_cxrt_out1_");
    _pipe_file_to_bin_capture(cc_cx, empty_path, out1);
    sys_unlink(empty_path);
    var size1 = _file_size(out1);
    if (size1 < 8) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": cycc_cx output for empty input is ");
        print_num(size1);
        println(" B (expected >= 8 for magic header)");
        fail = fail + 1;
    } else {
        var hdr_buf = alloc(8);
        var hdr_n = file_read_all(out1, hdr_buf, 8);
        # Magic is "CYX\0" (4 bytes). Check first 3 bytes.
        if (hdr_n < 3) { fail = fail + 1; }
        else {
            if (load8(hdr_buf) != 67) { fail = fail + 1; }       # 'C'
            else { if (load8(hdr_buf + 1) != 89) { fail = fail + 1; }   # 'Y'
                else { if (load8(hdr_buf + 2) != 88) {                  # 'X'
                        _p("    ");
                        _p(ANSI_RED);
                        _p("case-FAIL");
                        _p(ANSI_RESET);
                        println(": cycc_cx output magic is not 'CYX'");
                        fail = fail + 1;
                    } } }
        }
    }
    sys_unlink(out1);

    # Sub-check 3: no x86 callee-save / callee-restore byte sequences.
    var prog_path = _tmp_path("audit_cxrt_prog_");
    var pf = sys_open(prog_path, 577, 420);
    var prog = "fn main() { return 0; } syscall(60, main());\n";
    sys_write(pf, prog, strlen(prog));
    sys_close(pf);
    var out2 = _tmp_path("audit_cxrt_out2_");
    _pipe_file_to_bin_capture(cc_cx, prog_path, out2);
    sys_unlink(prog_path);

    var out2_size = _file_size(out2);
    if (out2_size > 0) {
        var out2_buf = alloc(out2_size);
        file_read_all(out2, out2_buf, out2_size);
        var save_needle[1];
        store8(&save_needle,     0x48);
        store8(&save_needle + 1, 0x89);
        store8(&save_needle + 2, 0x5d);
        store8(&save_needle + 3, 0xf8);
        if (_find_bytes(out2_buf, out2_size, &save_needle, 4) >= 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": cycc_cx output contains x86 callee-save bytes 48 89 5d f8 (regalloc save leak; v5.7.12 path-B regression)");
            fail = fail + 1;
        }
        var rest_needle[1];
        store8(&rest_needle,     0x4c);
        store8(&rest_needle + 1, 0x8b);
        store8(&rest_needle + 2, 0x65);
        store8(&rest_needle + 3, 0xf0);
        if (_find_bytes(out2_buf, out2_size, &rest_needle, 4) >= 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": cycc_cx output contains x86 callee-restore bytes 4c 8b 65 f0");
            fail = fail + 1;
        }
    }

    # Sub-check 4: cxvm consumes the bytecode without SIGSEGV.
    var ec_vm = _pipe_file_to_bin(cxvm, out2);
    sys_unlink(out2);
    if (ec_vm >= 128) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": cxvm died on signal ");
        print_num(ec_vm - 128);
        println(" running cycc_cx output");
        fail = fail + 1;
    }

    sys_unlink(cc_cx);
    sys_unlink(cxvm);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cycc_cx produces clean CYX bytecode (no x86 noise); cxvm consumes it without crash");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: cycc builds main_cx.cyr; cycc_cx starts clean on
# empty + trivial input (v5.7.11; bytecode correctness pinned
# v5.7.12). Three sub-checks:
# (1) `cycc < src/main_cx.cyr` exits 0 with > 100 KB output.
# (2) `cycc_cx < /dev/null` doesn't die on signal (exit < 128).
# (3) `cycc_cx < "syscall(60, 0);"` doesn't die on signal.
fn _cx_build_gate(): i64 {
    var label = "cycc builds main_cx.cyr; cycc_cx starts clean (v5.7.11; bytecode correctness pinned v5.7.12)";
    var src = _root_path("src/main_cx.cyr");
    var cc_cx = _tmp_path("audit_cc_cx_");
    var rc1 = _self_host_pipe(src, CC_PATH, cc_cx);
    if (WIFEXITED(rc1) != 1) {
        sys_unlink(cc_cx);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cycc < src/main_cx.cyr exited abnormally");
        _check(label, 1);
        return 1;
    }
    if (WEXITSTATUS(rc1) != 0) {
        sys_unlink(cc_cx);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cycc < src/main_cx.cyr exited ");
        print_num(WEXITSTATUS(rc1));
        println("");
        _check(label, 1);
        return 1;
    }
    var size = _file_size(cc_cx);
    if (size < 100000) {
        sys_unlink(cc_cx);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cycc_cx output is ");
        print_num(size);
        println(" B (suspiciously small; expected > 100 KB)");
        _check(label, 1);
        return 1;
    }
    sys_chmod(cc_cx, 493);

    # Sub-check 2: empty input. /dev/null doesn't need a write,
    # but _pipe_file_to_bin handles src_n=0 cleanly.
    var empty_path = _tmp_path("audit_cx_empty_");
    var ef = sys_open(empty_path, 577, 420);
    sys_close(ef);
    var ec_empty = _pipe_file_to_bin(cc_cx, empty_path);
    sys_unlink(empty_path);
    if (ec_empty >= 128) {
        sys_unlink(cc_cx);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cycc_cx died on signal ");
        print_num(ec_empty - 128);
        println(" on empty input (regression past v5.7.11 startup-clean bar)");
        _check(label, 1);
        return 1;
    }

    # Sub-check 3: trivial non-empty input.
    var triv_path = _tmp_path("audit_cx_triv_");
    var tf = sys_open(triv_path, 577, 420);
    var triv = "syscall(60, 0);\n";
    sys_write(tf, triv, strlen(triv));
    sys_close(tf);
    var ec_triv = _pipe_file_to_bin(cc_cx, triv_path);
    sys_unlink(triv_path);
    sys_unlink(cc_cx);
    if (ec_triv >= 128) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cycc_cx died on signal ");
        print_num(ec_triv - 128);
        println(" on trivial input");
        _check(label, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": cycc builds main_cx.cyr (");
    print_num(size);
    println(" B); cycc_cx starts clean on empty + trivial input");
    _check(label, 0);
    return 0;
}

# ── Working-dir-controlled exec (v5.9.14) ──────────────────────
# Fork+exec `bin_path` with one positional arg, in working
# directory `work_dir`. Optionally capture combined stdout +
# stderr to `out_path` (pass 0 for /dev/null on both). stdin
# always goes to /dev/null. Inherits the dispatcher's ENVP_ARR
# (so child inherits HOME/PATH for tool discovery). Returns
# WEXITSTATUS.
#
# stdout AND stderr both dup to the SAME fd — mirrors shell
# `cmd > out 2>&1`. Required for gates that grep diagnostic
# strings the tool prints to stderr (e.g. `cyrius smoke`'s
# "smoke aborted" failure marker).
#
# Used by the `cyrius` CLI subcommand regression gates that
# need to invoke `cyrius distlib` / `cyrius smoke` / `cyrius
# init` etc. in a scratch directory containing a fixture
# manifest + source layout.
fn _exec_in_dir(work_dir, bin_path, arg, out_path): i64 {
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        var cd_rc = syscall(SYS_CHDIR, work_dir);
        if (cd_rc < 0) { sys_exit(126); }
        var out_fd = 0 - 1;
        if (out_path == 0) {
            out_fd = sys_open("/dev/null", 1, 0);
        } else {
            out_fd = sys_open(out_path, 577, 420);
        }
        if (out_fd >= 0) {
            sys_dup2(out_fd, 1);
            sys_dup2(out_fd, 2);
            sys_close(out_fd);
        }
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        var argv[3];
        store64(&argv,     bin_path);
        if (arg != 0) {
            store64(&argv + 8,  arg);
            store64(&argv + 16, 0);
        } else {
            store64(&argv + 8, 0);
        }
        sys_execve(bin_path, &argv, ENVP_ARR);
        sys_exit(127);
    }
    var stbuf[1];
    sys_waitpid(pid, &stbuf, 0);
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# Augmented-envp sibling of _exec_in_dir3 (v5.9.23). Same fork +
# chdir + dup2 + waitpid scaffolding, but the child's envp is
# parent's ENVP_ARR contents PLUS the entries in `env_extras_vec`
# (each a `"KEY=VALUE"` cstring). Pass an empty vec for parent's
# env unchanged. Used by gates that need to set process-scoped
# env vars without leaking them into the dispatcher's own env
# (e.g., `CYRIUS_HOME=fake` for install-shim isolation).
fn _exec_in_dir3_env(work_dir, bin_path, arg1, arg2, arg3, env_extras_vec, out_path): i64 {
    var n_extras = vec_len(env_extras_vec);
    var aug_envp = alloc((ENVP_COUNT + n_extras + 1) * 8);
    var ei = 0;
    while (ei < ENVP_COUNT) {
        store64(aug_envp + ei * 8, load64(ENVP_ARR + ei * 8));
        ei = ei + 1;
    }
    var xj = 0;
    while (xj < n_extras) {
        store64(aug_envp + (ENVP_COUNT + xj) * 8, vec_get(env_extras_vec, xj));
        xj = xj + 1;
    }
    store64(aug_envp + (ENVP_COUNT + n_extras) * 8, 0);

    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        var cd_rc = syscall(SYS_CHDIR, work_dir);
        if (cd_rc < 0) { sys_exit(126); }
        var out_fd = 0 - 1;
        if (out_path == 0) {
            out_fd = sys_open("/dev/null", 1, 0);
        } else {
            out_fd = sys_open(out_path, 577, 420);
        }
        if (out_fd >= 0) {
            sys_dup2(out_fd, 1);
            sys_dup2(out_fd, 2);
            sys_close(out_fd);
        }
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        var argv[5];
        store64(&argv, bin_path);
        var off = 8;
        if (arg1 != 0) { store64(&argv + off, arg1); off = off + 8; }
        if (arg1 != 0) { if (arg2 != 0) { store64(&argv + off, arg2); off = off + 8; } }
        if (arg1 != 0) { if (arg2 != 0) { if (arg3 != 0) { store64(&argv + off, arg3); off = off + 8; } } }
        store64(&argv + off, 0);
        sys_execve(bin_path, &argv, aug_envp);
        sys_exit(127);
    }
    var stbuf[1];
    sys_waitpid(pid, &stbuf, 0);
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# Multi-arg sibling of _exec_in_dir. Up to 3 trailing argv entries;
# pass 0 for unused slots (argv truncated at first NULL slot).
# Same dup2 + chdir + waitpid scaffolding as _exec_in_dir.
fn _exec_in_dir3(work_dir, bin_path, arg1, arg2, arg3, out_path): i64 {
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        var cd_rc = syscall(SYS_CHDIR, work_dir);
        if (cd_rc < 0) { sys_exit(126); }
        var out_fd = 0 - 1;
        if (out_path == 0) {
            out_fd = sys_open("/dev/null", 1, 0);
        } else {
            out_fd = sys_open(out_path, 577, 420);
        }
        if (out_fd >= 0) {
            sys_dup2(out_fd, 1);
            sys_dup2(out_fd, 2);
            sys_close(out_fd);
        }
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        var argv[5];
        store64(&argv, bin_path);
        var off = 8;
        if (arg1 != 0) { store64(&argv + off, arg1); off = off + 8; }
        if (arg1 != 0) { if (arg2 != 0) { store64(&argv + off, arg2); off = off + 8; } }
        if (arg1 != 0) { if (arg2 != 0) { if (arg3 != 0) { store64(&argv + off, arg3); off = off + 8; } } }
        store64(&argv + off, 0);
        sys_execve(bin_path, &argv, ENVP_ARR);
        sys_exit(127);
    }
    var stbuf[1];
    sys_waitpid(pid, &stbuf, 0);
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# Write `text` (cstring) to `path`, creating/truncating. Returns
# bytes written on success, -1 on open failure.
fn _write_file(path, text): i64 {
    var fd = sys_open(path, 577, 420);
    if (fd < 0) { return 0 - 1; }
    var n = sys_write(fd, text, strlen(text));
    sys_close(fd);
    return n;
}

# Bespoke gate: `cyrius smoke` discovers .smcyr harnesses + bails
# fast on first FAIL (v5.7.38). Three sub-cases:
# (1) Live cyrius repo → exit 0 + output mentions
#     compile_minimal.smcyr.
# (2) Empty scratch dir → exit 0 + "No smoke harnesses found".
# (3) Synthetic /tmp project with a fails.smcyr (`syscall(60, 1)`)
#     → exit non-zero + output mentions both "fails.smcyr" and
#     "smoke aborted".
fn _smoke_discovery_gate(): i64 {
    var label = "cyrius smoke discovers .smcyr + fail-fast bailout (v5.7.38)";
    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built");
        println("");
        _check(label, 0);
        return 0;
    }
    var fail = 0;

    var out1 = _tmp_path("audit_smoke1_");
    var ec1 = _exec_in_dir(ROOT_PATH, cyrius_bin, "smoke", out1);
    if (ec1 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test1 'cyrius smoke' on live repo exited ");
        print_num(ec1);
        println(" (expected 0)");
        fail = fail + 1;
    } else { if (_file_contains_substr(out1, "compile_minimal.smcyr") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test1 output didn't list compile_minimal.smcyr");
            fail = fail + 1;
        } }
    sys_unlink(out1);

    var empty_dir = _tmp_path("audit_smoke_empty_");
    sys_mkdir(empty_dir, 493);
    var out2 = _tmp_path("audit_smoke2_");
    var ec2 = _exec_in_dir(empty_dir, cyrius_bin, "smoke", out2);
    if (ec2 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test2 empty-dir smoke exited ");
        print_num(ec2);
        println(" (expected 0)");
        fail = fail + 1;
    } else { if (_file_contains_substr(out2, "No smoke harnesses found") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test2 missing 'No smoke harnesses found' message");
            fail = fail + 1;
        } }
    sys_unlink(out2);
    sys_rmdir(empty_dir);

    var fail_dir = _tmp_path("audit_smoke_fail_");
    sys_mkdir(fail_dir, 493);
    var tests_sb = str_builder_new();
    str_builder_add_cstr(tests_sb, fail_dir);
    str_builder_add_cstr(tests_sb, "/tests");
    var tests_dir = str_data(str_builder_build(tests_sb));
    sys_mkdir(tests_dir, 493);
    var smcyr_sb = str_builder_new();
    str_builder_add_cstr(smcyr_sb, tests_dir);
    str_builder_add_cstr(smcyr_sb, "/smcyr");
    var smcyr_dir = str_data(str_builder_build(smcyr_sb));
    sys_mkdir(smcyr_dir, 493);
    var cyml_sb = str_builder_new();
    str_builder_add_cstr(cyml_sb, fail_dir);
    str_builder_add_cstr(cyml_sb, "/cyrius.cyml");
    _write_file(str_data(str_builder_build(cyml_sb)),
        "[package]\nname = \"smoke_failfast_gate\"\nversion = \"0.0.1\"\n\n[build]\nsrc = \"src/main.cyr\"\noutput = \"build/main\"\n");
    var smcyr_path_sb = str_builder_new();
    str_builder_add_cstr(smcyr_path_sb, smcyr_dir);
    str_builder_add_cstr(smcyr_path_sb, "/fails.smcyr");
    _write_file(str_data(str_builder_build(smcyr_path_sb)),
        "include \"lib/syscalls.cyr\"\nsyscall(60, 1);\n");

    var out3 = _tmp_path("audit_smoke3_");
    var ec3 = _exec_in_dir(fail_dir, cyrius_bin, "smoke", out3);
    if (ec3 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test3 failing harness should exit non-zero, got 0");
        fail = fail + 1;
    }
    if (_file_contains_substr(out3, "fails.smcyr") != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test3 output didn't mention fails.smcyr");
        fail = fail + 1;
    }
    if (_file_contains_substr(out3, "smoke aborted") != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test3 missing 'smoke aborted' message");
        fail = fail + 1;
    }
    sys_unlink(out3);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius smoke discovers .smcyr, exits 0 on pass, bails on first fail (v5.7.38)");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: cyrius distlib bundles modules > 64 KB without
# truncation (v5.7.36; mabda-surfaced). Synthesizes ~80 KB
# src/big.cyr in a scratch dir + minimal cyrius.cyml manifest;
# runs `cyrius distlib` in the scratch dir; asserts
# `dist/distlib_capgate.cyr` contains the sentinel marker
# (any truncation at the pre-v5.7.36 64 KB cap drops the tail
# of the module which contains the sentinel).
fn _distlib_large_module_gate(): i64 {
    var label = "cyrius distlib bundles >64KB modules without truncation (mabda-surfaced; v5.7.36)";
    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built");
        println("");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_distlib_");
    sys_mkdir(scratch, 493);
    var src_dir_sb = str_builder_new();
    str_builder_add_cstr(src_dir_sb, scratch);
    str_builder_add_cstr(src_dir_sb, "/src");
    var src_dir = str_data(str_builder_build(src_dir_sb));
    sys_mkdir(src_dir, 493);

    # Synthesize ~80 KB module: 4000 lines of `var f_NNNNN = NNNNN;`
    # plus a sentinel as the LAST line.
    var sb = str_builder_new();
    var i = 0;
    while (i < 4000) {
        str_builder_add_cstr(sb, "var f_");
        if (i < 10) { str_builder_add_cstr(sb, "0000"); }
        else { if (i < 100) { str_builder_add_cstr(sb, "000"); }
            else { if (i < 1000) { str_builder_add_cstr(sb, "00"); }
                else { if (i < 10000) { str_builder_add_cstr(sb, "0"); }
                    else { } } } }
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, " = ");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, ";\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "var DISTLIB_LARGE_MODULE_SENTINEL = 1;\n");
    var src_text = str_builder_build(sb);
    var src_path_sb = str_builder_new();
    str_builder_add_cstr(src_path_sb, src_dir);
    str_builder_add_cstr(src_path_sb, "/big.cyr");
    var src_path = str_data(str_builder_build(src_path_sb));
    var src_fd = sys_open(src_path, 577, 420);
    sys_write(src_fd, str_data(src_text), str_len(src_text));
    sys_close(src_fd);
    var src_size = str_len(src_text);

    if (src_size <= 65536) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": fixture only ");
        print_num(src_size);
        println(" bytes — must exceed 64KB to exercise the cap");
        _check(label, 1);
        return 1;
    }

    # Minimal manifest. [lib].modules drives distlib's no-profile
    # path (cmd_distlib's [build] / [lib] fallback).
    var cyml_path_sb = str_builder_new();
    str_builder_add_cstr(cyml_path_sb, scratch);
    str_builder_add_cstr(cyml_path_sb, "/cyrius.cyml");
    var cyml_path = str_data(str_builder_build(cyml_path_sb));
    _write_file(cyml_path, "[package]\nname = \"distlib_capgate\"\nversion = \"0.0.1\"\n\n[lib]\nmodules = [\"src/big.cyr\"]\n");

    # Run `cyrius distlib` in the scratch dir.
    var ec = _exec_in_dir(scratch, cyrius_bin, "distlib", 0);
    if (ec != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cyrius distlib exited ");
        print_num(ec);
        println("");
        _check(label, 1);
        return 1;
    }

    var bundle_path_sb = str_builder_new();
    str_builder_add_cstr(bundle_path_sb, scratch);
    str_builder_add_cstr(bundle_path_sb, "/dist/distlib_capgate.cyr");
    var bundle_path = str_data(str_builder_build(bundle_path_sb));
    if (file_exists(bundle_path) != 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": dist/distlib_capgate.cyr not produced");
        _check(label, 1);
        return 1;
    }

    if (_file_contains_substr(bundle_path, "DISTLIB_LARGE_MODULE_SENTINEL") != 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": bundle truncated — sentinel missing (input ");
        print_num(src_size);
        _p(" bytes, bundle ");
        print_num(_file_size(bundle_path));
        println(" bytes)");
        _check(label, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": cyrius distlib bundles a ");
    print_num(src_size);
    println("-byte module without truncation (v5.7.36)");
    _check(label, 0);
    return 0;
}

# ── Bidirectional IPC (v5.9.13) ────────────────────────────────
# Spawns `bin_path`, writes `req_buf[0..req_len]` to its stdin,
# reads child stdout to `out_buf[0..out_cap]`, waits, returns
# bytes captured. stderr → /dev/null. Closes stdin write end
# AFTER all bytes written, signaling EOF — child binaries that
# loop on stdin reads (LSP server, REPL, etc.) exit cleanly.
#
# Pipe-buffer sizing: total request bytes must fit in the
# pipe's kernel buffer (default 64 KB on Linux) since the child
# may not start reading until after parent finishes writing.
# For LSP-test traffic (5-15 small JSON-RPC messages, ~5-10 KB
# total) this is fine. For larger volumes, the helper would
# need a writer thread or a select-driven pump — out of scope.
fn _ipc_session(bin_path, req_buf, req_len, out_buf, out_cap): i64 {
    var p2c[16];
    var c2p[16];
    var pr1 = sys_pipe(&p2c);
    if (pr1 < 0) { return 0; }
    var pr2 = sys_pipe(&c2p);
    if (pr2 < 0) { return 0; }
    var p2c_r = load32(&p2c);
    var p2c_w = load32(&p2c + 4);
    var c2p_r = load32(&c2p);
    var c2p_w = load32(&c2p + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(p2c_r); sys_close(p2c_w);
        sys_close(c2p_r); sys_close(c2p_w);
        return 0;
    }
    if (pid == 0) {
        sys_close(p2c_w);
        sys_close(c2p_r);
        sys_dup2(p2c_r, 0);
        sys_close(p2c_r);
        sys_dup2(c2p_w, 1);
        sys_close(c2p_w);
        var dn = sys_open("/dev/null", 1, 0);
        if (dn >= 0) { sys_dup2(dn, 2); sys_close(dn); }
        var argv[2];
        store64(&argv,     bin_path);
        store64(&argv + 8, 0);
        var envp[1];
        store64(&envp, 0);
        sys_execve(bin_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(p2c_r);
    sys_close(c2p_w);

    var written = 0;
    while (written < req_len) {
        var w = sys_write(p2c_w, req_buf + written, req_len - written);
        if (w <= 0) { written = req_len; }
        else { written = written + w; }
    }
    sys_close(p2c_w);

    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(c2p_r, out_buf + total, out_cap - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= out_cap) { rgo = 0; }
        }
    }
    sys_close(c2p_r);
    var stbuf[1];
    sys_waitpid(pid, &stbuf, 0);
    return total;
}

# Build one LSP-framed request — `Content-Length: N\r\n\r\n<json>` —
# and append to `sb`.
fn _lsp_frame(sb, json_body): i64 {
    var jlen = strlen(json_body);
    str_builder_add_cstr(sb, "Content-Length: ");
    str_builder_add_int(sb, jlen);
    str_builder_add_cstr(sb, "\r\n\r\n");
    str_builder_add_cstr(sb, json_body);
    return 0;
}

# Bespoke gate: cyrius-lsp definitionProvider + documentSymbolProvider
# + referencesProvider + semanticTokensProvider/full + cross-file
# indexing (v5.7.39 + v5.9.10). Replaces
# `tests/regression-lsp-definition.sh` end-to-end. Three LSP
# sessions over `_ipc_session` (each spawns a fresh
# build/cyrius-lsp); 8 sub-cases mirror the .sh's tests 1-8.
fn _lsp_definition_gate(): i64 {
    var label = "cyrius-lsp definitionProvider + documentSymbol + cross-file indexing (v5.7.39)";
    var lsp_path = _root_path("build/cyrius-lsp");
    if (file_exists(lsp_path) != 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(lsp_path);
        println(" not built");
        _check(label, 1);
        return 1;
    }

    var fail = 0;
    var out_cap = 65536;

    # ─ Phase 1: decl-only fixture; initialize+didOpen+definition+
    #   documentSymbol+shutdown. Tests 1-4.
    var decl_path = _root_path("tests/fixtures/lsp/decl_only.cyr");
    var sb = str_builder_new();
    _lsp_frame(sb, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}");
    var open1_sb = str_builder_new();
    str_builder_add_cstr(open1_sb, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://");
    str_builder_add_cstr(open1_sb, decl_path);
    str_builder_add_cstr(open1_sb, "\",\"languageId\":\"cyrius\",\"version\":1,\"text\":\"\"}}}");
    _lsp_frame(sb, str_data(str_builder_build(open1_sb)));
    var def1_sb = str_builder_new();
    str_builder_add_cstr(def1_sb, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file://");
    str_builder_add_cstr(def1_sb, decl_path);
    str_builder_add_cstr(def1_sb, "\"},\"position\":{\"line\":0,\"character\":5}}}");
    _lsp_frame(sb, str_data(str_builder_build(def1_sb)));
    var sym1_sb = str_builder_new();
    str_builder_add_cstr(sym1_sb, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/documentSymbol\",\"params\":{\"textDocument\":{\"uri\":\"file://");
    str_builder_add_cstr(sym1_sb, decl_path);
    str_builder_add_cstr(sym1_sb, "\"}}}");
    _lsp_frame(sb, str_data(str_builder_build(sym1_sb)));
    _lsp_frame(sb, "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"shutdown\"}");
    var reqs1 = str_builder_build(sb);
    var out1 = alloc(out_cap);
    var n1 = _ipc_session(lsp_path, str_data(reqs1), str_len(reqs1), out1, out_cap);

    fail = fail + _lsp_check_substr(out1, n1, "\"definitionProvider\":true",
        "test1: initialize did not advertise definitionProvider");
    fail = fail + _lsp_check_substr(out1, n1, "\"documentSymbolProvider\":true",
        "test1b: initialize did not advertise documentSymbolProvider");
    var uri1_sb = str_builder_new();
    str_builder_add_cstr(uri1_sb, "\"uri\":\"file://");
    str_builder_add_cstr(uri1_sb, decl_path);
    fail = fail + _lsp_check_substr(out1, n1, str_data(str_builder_build(uri1_sb)),
        "test2: definition response missing fixture URI");
    fail = fail + _lsp_check_substr(out1, n1, "\"line\":0,\"character\":3",
        "test3: definition response missing expected position (line 0, char 3)");
    fail = fail + _lsp_check_substr(out1, n1, "\"name\":\"foo_bar\"",
        "test4: documentSymbol missing 'foo_bar' name");
    fail = fail + _lsp_check_substr(out1, n1, "\"kind\":12",
        "test4b: documentSymbol kind != 12 (Function)");

    # ─ Phase 2: cross-file include. Generate includer.cyr at
    #   /tmp with absolute path to fixtures/lsp/included.cyr;
    #   initialize+didOpen(includer)+definition(call site)+shutdown.
    #   Tests 5-5b.
    var inc_path = _root_path("tests/fixtures/lsp/included.cyr");
    # NOTE: the LSP's handle_did_open_or_save early-returns on
    # paths that don't end in `.cyr`. The temp filename must
    # carry the extension or didOpen silently no-ops and the
    # subsequent definition request returns null.
    var use_path_base = _tmp_path("audit_lsp_includer_");
    var use_path_sb = str_builder_new();
    str_builder_add_cstr(use_path_sb, use_path_base);
    str_builder_add_cstr(use_path_sb, ".cyr");
    var use_path = str_data(str_builder_build(use_path_sb));
    var use_sb = str_builder_new();
    str_builder_add_cstr(use_sb, "include \"");
    str_builder_add_cstr(use_sb, inc_path);
    str_builder_add_cstr(use_sb, "\"\nfn caller() {\n    return lib_helper();\n}\n");
    var use_text = str_builder_build(use_sb);
    var ufd = sys_open(use_path, 577, 420);
    sys_write(ufd, str_data(use_text), str_len(use_text));
    sys_close(ufd);

    var sb2 = str_builder_new();
    _lsp_frame(sb2, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}");
    var open2_sb = str_builder_new();
    str_builder_add_cstr(open2_sb, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://");
    str_builder_add_cstr(open2_sb, use_path);
    str_builder_add_cstr(open2_sb, "\",\"languageId\":\"cyrius\",\"version\":1,\"text\":\"\"}}}");
    _lsp_frame(sb2, str_data(str_builder_build(open2_sb)));
    var def2_sb = str_builder_new();
    str_builder_add_cstr(def2_sb, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/definition\",\"params\":{\"textDocument\":{\"uri\":\"file://");
    str_builder_add_cstr(def2_sb, use_path);
    str_builder_add_cstr(def2_sb, "\"},\"position\":{\"line\":2,\"character\":11}}}");
    _lsp_frame(sb2, str_data(str_builder_build(def2_sb)));
    _lsp_frame(sb2, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\"}");
    var reqs2 = str_builder_build(sb2);
    var out2 = alloc(out_cap);
    var n2 = _ipc_session(lsp_path, str_data(reqs2), str_len(reqs2), out2, out_cap);
    sys_unlink(use_path);

    var inc_uri_sb = str_builder_new();
    str_builder_add_cstr(inc_uri_sb, "\"uri\":\"file://");
    str_builder_add_cstr(inc_uri_sb, inc_path);
    fail = fail + _lsp_check_substr(out2, n2, str_data(str_builder_build(inc_uri_sb)),
        "test5: cross-file definition didn't resolve to included.cyr");
    fail = fail + _lsp_check_substr(out2, n2, "\"line\":0,\"character\":3",
        "test5b: cross-file definition position wrong (expected line 0 char 3)");

    # ─ Phase 3: v5.9.10 new providers. decl_and_use.cyr;
    #   initialize+didOpen+references+semanticTokens+shutdown.
    #   Tests 6-8.
    var newp_path = _root_path("tests/fixtures/lsp/decl_and_use.cyr");
    var sb3 = str_builder_new();
    _lsp_frame(sb3, "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"capabilities\":{}}}");
    var open3_sb = str_builder_new();
    str_builder_add_cstr(open3_sb, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":{\"textDocument\":{\"uri\":\"file://");
    str_builder_add_cstr(open3_sb, newp_path);
    str_builder_add_cstr(open3_sb, "\",\"languageId\":\"cyrius\",\"version\":1,\"text\":\"\"}}}");
    _lsp_frame(sb3, str_data(str_builder_build(open3_sb)));
    var ref3_sb = str_builder_new();
    str_builder_add_cstr(ref3_sb, "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/references\",\"params\":{\"textDocument\":{\"uri\":\"file://");
    str_builder_add_cstr(ref3_sb, newp_path);
    str_builder_add_cstr(ref3_sb, "\"},\"position\":{\"line\":0,\"character\":5},\"context\":{\"includeDeclaration\":true}}}");
    _lsp_frame(sb3, str_data(str_builder_build(ref3_sb)));
    var st3_sb = str_builder_new();
    str_builder_add_cstr(st3_sb, "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"textDocument/semanticTokens/full\",\"params\":{\"textDocument\":{\"uri\":\"file://");
    str_builder_add_cstr(st3_sb, newp_path);
    str_builder_add_cstr(st3_sb, "\"}}}");
    _lsp_frame(sb3, str_data(str_builder_build(st3_sb)));
    _lsp_frame(sb3, "{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"shutdown\"}");
    var reqs3 = str_builder_build(sb3);
    var out3 = alloc(out_cap);
    var n3 = _ipc_session(lsp_path, str_data(reqs3), str_len(reqs3), out3, out_cap);

    fail = fail + _lsp_check_substr(out3, n3, "\"referencesProvider\":true",
        "test6: initialize did not advertise referencesProvider");
    fail = fail + _lsp_check_substr(out3, n3, "\"semanticTokensProvider\":",
        "test6b: initialize did not advertise semanticTokensProvider");
    # v5.11.42: legend extended with `parameter` (index 6) so
    # locals + fn args get coverage. Test bumped to match.
    fail = fail + _lsp_check_substr(out3, n3,
        "\"tokenTypes\":[\"function\",\"variable\",\"struct\",\"enum\",\"enumMember\",\"keyword\",\"parameter\"]",
        "test6c: semanticTokensProvider legend missing or in wrong shape");
    var ref_uri_sb = str_builder_new();
    str_builder_add_cstr(ref_uri_sb, "\"uri\":\"file://");
    str_builder_add_cstr(ref_uri_sb, newp_path);
    var ref_uri_marker = str_data(str_builder_build(ref_uri_sb));
    var ref_count = _count_substr_buf(out3, n3, ref_uri_marker);
    if (ref_count < 2) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test7: /references returned ");
        print_num(ref_count);
        println(" Locations (expected 2)");
        fail = fail + 1;
    }
    fail = fail + _lsp_check_substr(out3, n3, "\"data\":[0,0,2,5,0",
        "test8: /semanticTokens data did not start with 'fn' keyword token tuple");

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius-lsp definitionProvider + documentSymbolProvider + referencesProvider + semanticTokensProvider/full + cross-file indexing (v5.7.39 + v5.9.10)");
    }
    _check(label, fail);
    return fail;
}

# Helper for `_lsp_definition_gate`: substring-presence check
# over a captured stdout buffer. Returns 0 on PASS (substring
# found), 1 on FAIL (with a per-case diagnostic).
fn _lsp_check_substr(out_buf, n, needle, fail_msg): i64 {
    if (_count_substr_buf(out_buf, n, needle) >= 1) { return 0; }
    _p("    ");
    _p(ANSI_RED);
    _p("case-FAIL");
    _p(ANSI_RESET);
    _p(": ");
    println(fail_msg);
    return 1;
}

# ── Cross-host SSH primitives (v5.9.8) ─────────────────────────
# Three small fork+exec wrappers used by the aarch64 / Mach-O /
# PE / sit / TLS gates that scp a binary to a verification host
# and run it remotely. Each gate decomposes to: skip-check →
# scp-to → ssh-remote-exit, with one decode of the captured
# remote exit code.

# Fork+exec `ssh -o BatchMode=yes -o ConnectTimeout=2 <target>
# true`. Returns 1 on reachable, 0 on unreachable. BatchMode
# disables interactive auth — gate skip is the right answer if
# the target needs a password or key prompt.
# v5.9.42: thin wrappers over lib/regression.cyr — pass ENVP_ARR
# so the SSH commands inherit the parent's env (PATH, etc.) like
# the bash regression scripts they replaced.
fn _ssh_skip_check(target): i64 {
    return regression_ssh_skip_check(target);
}

fn _scp_to(target, local_path, remote_path): i64 {
    return regression_scp_to(target, local_path, remote_path, ENVP_ARR);
}

fn _ssh_remote_exit(target, command): i64 {
    return regression_ssh_remote_exit(target, command, ENVP_ARR);
}

fn _ssh_remote_exec_capture(target, command, out_path): i64 {
    return regression_ssh_remote_exec_capture(target, command, out_path, ENVP_ARR);
}

fn _codesign_remote(target, remote_path): i64 {
    return regression_codesign_remote(target, remote_path, ENVP_ARR);
}

# v5.9.32: pipe a source file through `compiler_path` with one
# `KEY=VALUE` env var injected. Mirrors `_self_host_pipe` (line
# ~896) but with envp = parent's ENVP_ARR + the extra entry.
# Used for Mach-O cross-builds (`CYRIUS_MACHO_ARM=1` triggers
# the aarch64 backend's Mach-O emit at compile time).
fn _self_host_pipe_env(src_path, compiler_path, out_path, env_kv): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }
    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);
    # Augmented envp: parent's ENVP_ARR + env_kv + null.
    var aug_envp = alloc((ENVP_COUNT + 2) * 8);
    var ei = 0;
    while (ei < ENVP_COUNT) {
        store64(aug_envp + ei * 8, load64(ENVP_ARR + ei * 8));
        ei = ei + 1;
    }
    store64(aug_envp + ENVP_COUNT * 8, env_kv);
    store64(aug_envp + (ENVP_COUNT + 1) * 8, 0);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[3];
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        sys_execve(compiler_path, &argv, aug_envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

# Tar-pipe a tree to a remote host over ssh stdin. Equivalent to:
#   tar cf - -C <src_root> <member1> <member2> ... | \
#       ssh <target> 'rm -rf <remote_dir> && mkdir -p <remote_dir>
#                     && cd <remote_dir> && tar xf -'
# `members` is a single space-separated cstring of dir/file names
# relative to `src_root` (e.g. "src lib"). Returns 0 on success,
# non-zero on tar failure (-1) / ssh non-zero (remote rc) / fork
# failure (-2).
#
# Used by the v5.9.15 aarch64-native-selfhost gate to ship the
# repo's src/ + lib/ trees to the Pi runner before invoking
# `./cc5_native` on the remote.
fn _tar_pipe_ssh(target, src_root, members, remote_dir): i64 {
    # Build the remote shell command:
    #   "rm -rf <remote_dir> && mkdir -p <remote_dir>
    #    && cd <remote_dir> && tar xf -"
    var cmd_sb = str_builder_new();
    str_builder_add_cstr(cmd_sb, "rm -rf ");
    str_builder_add_cstr(cmd_sb, remote_dir);
    str_builder_add_cstr(cmd_sb, " && mkdir -p ");
    str_builder_add_cstr(cmd_sb, remote_dir);
    str_builder_add_cstr(cmd_sb, " && cd ");
    str_builder_add_cstr(cmd_sb, remote_dir);
    str_builder_add_cstr(cmd_sb, " && tar xf -");
    var remote_cmd = str_data(str_builder_build(cmd_sb));

    # Pipe between tar (parent of members in src_root) and ssh.
    var fds[16];
    var pipe_rc = sys_pipe(&fds);
    if (pipe_rc < 0) { return 0 - 2; }
    var rfd = load32(&fds);
    var wfd = load32(&fds + 4);

    # tar producer
    var tar_pid = sys_fork();
    if (tar_pid < 0) { sys_close(rfd); sys_close(wfd); return 0 - 2; }
    if (tar_pid == 0) {
        sys_dup2(wfd, 1);
        sys_close(rfd);
        sys_close(wfd);
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        # Exec: tar cf - -C <src_root> <member1> <member2> ...
        # `members` is space-separated; explode to argv. Cap at
        # 32 members which is plenty for src + lib + extras.
        var argv[40];
        store64(&argv,      "tar");
        store64(&argv + 8,  "cf");
        store64(&argv + 16, "-");
        store64(&argv + 24, "-C");
        store64(&argv + 32, src_root);
        # Walk `members` cstring, splitting on space, writing
        # each token's start pointer + null-terminating each
        # in a private mutable buffer.
        var mlen = strlen(members);
        var buf = alloc(mlen + 1);
        var b = 0;
        while (b < mlen) { store8(buf + b, load8(members + b)); b = b + 1; }
        store8(buf + mlen, 0);
        var idx = 5;   # next argv slot
        var s = 0;
        var i = 0;
        while (i <= mlen) {
            var c = load8(buf + i);
            if (c == 32) {
                store8(buf + i, 0);
                if (i > s) { store64(&argv + idx * 8, buf + s); idx = idx + 1; }
                s = i + 1;
            }
            if (c == 0) {
                if (i > s) { store64(&argv + idx * 8, buf + s); idx = idx + 1; }
            }
            i = i + 1;
        }
        store64(&argv + idx * 8, 0);
        sys_execve("/usr/bin/tar", &argv, ENVP_ARR);
        sys_execve("/bin/tar",     &argv, ENVP_ARR);
        sys_exit(127);
    }

    # ssh consumer
    var ssh_pid = sys_fork();
    if (ssh_pid < 0) { sys_close(rfd); sys_close(wfd); return 0 - 2; }
    if (ssh_pid == 0) {
        sys_dup2(rfd, 0);
        sys_close(rfd);
        sys_close(wfd);
        var dn1 = sys_open("/dev/null", 1, 0);
        if (dn1 >= 0) { sys_dup2(dn1, 1); sys_close(dn1); }
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[4];
        store64(&argv,      "ssh");
        store64(&argv + 8,  target);
        store64(&argv + 16, remote_cmd);
        store64(&argv + 24, 0);
        sys_execve("/usr/bin/ssh", &argv, ENVP_ARR);
        sys_execve("/bin/ssh",     &argv, ENVP_ARR);
        sys_exit(127);
    }

    # Parent closes both ends and waits.
    sys_close(rfd);
    sys_close(wfd);
    var s1[1];
    var s2[1];
    sys_waitpid(tar_pid, &s1, 0);
    sys_waitpid(ssh_pid, &s2, 0);
    var st1 = load32(&s1);
    var st2 = load32(&s2);
    if (WIFEXITED(st1) != 1) { return 0 - 1; }
    if (WIFEXITED(st2) != 1) { return 0 - 1; }
    if (WEXITSTATUS(st1) != 0) { return 0 - 1; }
    return WEXITSTATUS(st2);
}

# Resolve the SSH target for a given env-var (e.g. "SSH_TARGET",
# "SSH_TARGET_MACOS", "SSH_TARGET_WIN") with a default fallback.
# Returns a cstring pointer.
# v5.9.42: thin wrapper over lib/regression.cyr.
fn _ssh_target(env_name, default_name): i64 {
    return regression_ssh_target(env_name, default_name);
}

# Bespoke gate: aarch64 syscall stdlib + thread/atomic/
# thread_local/flags acceptance cluster (v5.4.11 .. v5.5.33;
# yukti + majra surfaced). Cross-builds the consolidated
# `tests/fixtures/aarch64_cluster/syscalls_combined.cyr`
# fixture with cycc_aarch64, scp's it to the configured SSH
# target (default `pi`), runs it, decodes the exit code:
#   99 — all 9 sub-tests PASS
#   <id*10 + sub> — sub-test `id` (1..9) failed at step `sub`
fn _aarch64_syscalls_gate(): i64 {
    var label = "aarch64 syscall stdlib + post-clone trampoline (via ssh pi)";
    if (file_exists(CC_AARCH64_PATH) != 1) {
        _p("  skip: ");
        _p(CC_AARCH64_PATH);
        println(" not built (cross-compiler required)");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET", "pi");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable via ssh");
        _check(label, 0);
        return 0;
    }

    var fix = _root_path("tests/fixtures/aarch64_cluster/syscalls_combined.cyr");
    var bin = _tmp_path("audit_aarch64_syscalls_");
    var rc = _self_host_pipe(fix, CC_AARCH64_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": aarch64 cross-build failed (rc=");
        print_num(rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var remote = "/tmp/cyr_aarch64_cluster_smoke";
    var scp_rc = _scp_to(target, bin, remote);
    sys_unlink(bin);
    if (scp_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": scp to ");
        _p(target);
        _p(" failed (rc=");
        print_num(scp_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var cmd_sb = str_builder_new();
    str_builder_add_cstr(cmd_sb, "chmod +x ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " && ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " >/dev/null; rc=$?; rm -f ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " /tmp/cyrius_regr_fs_probe.txt; exit $rc");
    var cmd = str_data(str_builder_build(cmd_sb));
    var ec = _ssh_remote_exit(target, cmd);

    if (ec == 99) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": aarch64 syscall stdlib + thread/atomic/thread_local/flags green on ");
        _p(target);
        println(" (9/9 sub-tests; v5.4.11 .. v5.5.33)");
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": aarch64 cluster sub-test failed (exit=");
    print_num(ec);
    if (ec == 11) { _p(" — t1 sys_open failed"); }
    if (ec == 12) { _p(" — t1 sys_read returned 0"); }
    if (ec == 21) { _p(" — t2 thread_create returned 0"); }
    if (ec == 22) { _p(" — t2 thread_join non-zero"); }
    if (ec == 31) { _p(" — t3 alloc returned 0 inside loop"); }
    if (ec == 32) { _p(" — t3 alloc tail mismatch"); }
    if (ec >= 41) { if (ec <= 45) { _p(" — t4 fs roundtrip failed"); } }
    if (ec == 51) { _p(" — t5 mt thread_create returned 0"); }
    if (ec == 52) { _p(" — t5 mt thread_join non-zero"); }
    if (ec >= 61) { if (ec <= 65) { _p(" — t6 thread_local TPIDR_EL0 path"); } }
    if (ec >= 71) { if (ec <= 77) { _p(" — t7 atomic LL-SC sequence"); } }
    if (ec >= 81) { if (ec <= 82) { _p(" — t8 mutex+hashmap contention"); } }
    if (ec >= 91) { if (ec <= 96) { _p(" — t9 lib/flags.cyr parse"); } }
    println(")");
    _check(label, 1);
    return 1;
}

# Bespoke gate (v5.9.26): aarch64 Phase 2b struct-by-value
# round-trip cross-test. Cross-builds
# `tests/fixtures/aarch64_cluster/struct_byval.cyr` with
# cycc_aarch64, scp's it to the configured SSH target, runs it.
# Exit-code map (from the fixture's `syscall(60, N)` calls):
#   0       — all field round-trips pass
#   1/2/3   — make_point().{x,y,z} mismatch
#   4/5/6   — shifted_point(5).{x,y,z} mismatch
# Locks the X8 indirect-result ABI + LDRB/STRB byte-copy + frame-
# disp ret_stash adjustment in `src/backend/aarch64/emit.cyr` against
# silent regression.
fn _aarch64_struct_byval_gate(): i64 {
    var label = "aarch64 struct-by-value round-trip (Phase 2b X8 / LDRB-STRB; via ssh pi)";
    if (file_exists(CC_AARCH64_PATH) != 1) {
        _p("  skip: ");
        _p(CC_AARCH64_PATH);
        println(" not built (cross-compiler required)");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET", "pi");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable via ssh");
        _check(label, 0);
        return 0;
    }

    var fix = _root_path("tests/fixtures/aarch64_cluster/struct_byval.cyr");
    var bin = _tmp_path("audit_aarch64_byval_");
    var rc = _self_host_pipe(fix, CC_AARCH64_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": aarch64 cross-build failed (rc=");
        print_num(rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var remote = "/tmp/cyr_aarch64_byval";
    var scp_rc = _scp_to(target, bin, remote);
    sys_unlink(bin);
    if (scp_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": scp to ");
        _p(target);
        _p(" failed (rc=");
        print_num(scp_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var cmd_sb = str_builder_new();
    str_builder_add_cstr(cmd_sb, "chmod +x ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " && ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " >/dev/null; rc=$?; rm -f ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, "; exit $rc");
    var cmd = str_data(str_builder_build(cmd_sb));
    var ec = _ssh_remote_exit(target, cmd);

    if (ec == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": Point{11,22,33} + shifted_point(5)={106,107,108} round-trip on ");
        println(target);
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": struct-by-value round-trip exit=");
    print_num(ec);
    if (ec == 1) { _p(" — make_point().x != 11"); }
    if (ec == 2) { _p(" — make_point().y != 22"); }
    if (ec == 3) { _p(" — make_point().z != 33"); }
    if (ec == 4) { _p(" — shifted_point(5).x != 106"); }
    if (ec == 5) { _p(" — shifted_point(5).y != 107"); }
    if (ec == 6) { _p(" — shifted_point(5).z != 108"); }
    if (ec == 139) { _p(" — SIGSEGV (frame-disp adjustment broken?)"); }
    println("");
    _check(label, 1);
    return 1;
}

# Bespoke gate (v5.9.27): aarch64 sub-byte struct field load
# cross-test (agnosys 1.1.9 filing). Cross-builds
# `tests/fixtures/aarch64_cluster/sub_byte_field_load.cyr`
# with cycc_aarch64 and runs on pi via SSH. Exercises ldrb /
# ldrh / ldr-w through pointer-to-struct dot syntax over a
# kernel-ABI-shape struct (i32 + i16 fields) and a
# mixed-widths struct (i8 + i16 + i32 in one body).
#
# Exit-code map:
#   0       — all 10 field-load round-trips pass
#   1/2/3/4 — nlmsghdr {len, type, flags, seq} mismatch
#   5..10   — mixed_widths {flag, pad8, word_a, word_b,
#              long_x, long_y} mismatch
#
# Locks the aarch64 EW(0x39400020) / EW(0x79400020) / EW(0xB9400020)
# emit at parse_decl.cyr's PARSE_FIELD_LOAD against silent
# regression. Field STORE codegen for sub-8-byte widths was
# already wired pre-v5.9.27 (per the agnosys filing — only LOAD
# was missing); this gate is load-only by design.
fn _aarch64_sub_byte_field_load_gate(): i64 {
    var label = "aarch64 sub-byte struct field load via dot syntax (v5.9.27; agnosys 1.1.9; via ssh pi)";
    if (file_exists(CC_AARCH64_PATH) != 1) {
        _p("  skip: ");
        _p(CC_AARCH64_PATH);
        println(" not built (cross-compiler required)");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET", "pi");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable via ssh");
        _check(label, 0);
        return 0;
    }

    var fix = _root_path("tests/fixtures/aarch64_cluster/sub_byte_field_load.cyr");
    var bin = _tmp_path("audit_aarch64_subbyte_");
    var rc = _self_host_pipe(fix, CC_AARCH64_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": aarch64 cross-build failed (rc=");
        print_num(rc);
        println(") — pre-v5.9.27 error:1610 regression?");
        _check(label, 1);
        return 1;
    }

    var remote = "/tmp/cyr_aarch64_subbyte";
    var scp_rc = _scp_to(target, bin, remote);
    sys_unlink(bin);
    if (scp_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": scp to ");
        _p(target);
        _p(" failed (rc=");
        print_num(scp_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var cmd_sb = str_builder_new();
    str_builder_add_cstr(cmd_sb, "chmod +x ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " && ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " >/dev/null; rc=$?; rm -f ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, "; exit $rc");
    var cmd = str_data(str_builder_build(cmd_sb));
    var ec = _ssh_remote_exit(target, cmd);

    if (ec == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": 10 sub-cases (i8 / i16 / i32 field loads via dot syntax) on ");
        println(target);
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": sub-byte field load round-trip exit=");
    print_num(ec);
    if (ec == 1)  { _p(" — nlmsghdr.nlmsg_len (i32) mismatch"); }
    if (ec == 2)  { _p(" — nlmsghdr.nlmsg_type (i16) mismatch"); }
    if (ec == 3)  { _p(" — nlmsghdr.nlmsg_flags (i16, offset>0) mismatch"); }
    if (ec == 4)  { _p(" — nlmsghdr.nlmsg_seq (i32, offset>0) mismatch"); }
    if (ec == 5)  { _p(" — mixed_widths.flag (i8) mismatch"); }
    if (ec == 6)  { _p(" — mixed_widths.pad8 (i8, offset 1) mismatch"); }
    if (ec == 7)  { _p(" — mixed_widths.word_a (i16) mismatch"); }
    if (ec == 8)  { _p(" — mixed_widths.word_b (i16) mismatch"); }
    if (ec == 9)  { _p(" — mixed_widths.long_x (i32) mismatch"); }
    if (ec == 10) { _p(" — mixed_widths.long_y (i32) mismatch"); }
    println("");
    _check(label, 1);
    return 1;
}

# Bespoke gate (v5.9.32): macOS arm64 Mach-O runtime gate. Cross-
# builds 3 fixtures via cycc_aarch64 with `CYRIUS_MACHO_ARM=1`
# env var injected (triggers the aarch64 backend's Mach-O emit
# path), scp's each to ecb (macOS arm64), codesigns + runs,
# verifies exit code (and stdout for the write fixture).
#   T1 — bare top-level `syscall(60, 42)` exits 42 via __got[0].
#   T2 — `syscall(1, 1, "hello\n", 6); syscall(60, 42)` writes
#        "hello" + exits 42 via __got[1] (write) + __got[0].
#   T3 — user fn + arithmetic — bl/ret + peephole on Mach-O.
fn _macho_exit_gate(): i64 {
    var label = "Mach-O arm64 syscall(60,42) → exit 42 on ecb (pin v5.6.33)";
    if (file_exists(CC_AARCH64_PATH) != 1) {
        _p("  skip: ");
        _p(CC_AARCH64_PATH);
        println(" not built (cross-compiler required)");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET_MACOS", "ecb");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable (no macOS arm64 runner available)");
        _check(label, 0);
        return 0;
    }

    var fail = 0;
    var env_kv = "CYRIUS_MACHO_ARM=1";

    # ---- T1: bare exit(42) ----
    var src1 = _tmp_path("audit_macho_t1_src_");
    var bin1 = _tmp_path("audit_macho_t1_bin_");
    _write_file(src1, "syscall(60, 42);\n");
    var rc1 = _self_host_pipe_env(src1, CC_AARCH64_PATH, bin1, env_kv);
    sys_unlink(src1);
    if (rc1 != 0) {
        sys_unlink(bin1);
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": T1 cross-build rc=");
        print_num(rc1);
        println("");
        fail = fail + 1;
    } else {
        var rem1 = "/tmp/cyr_macho_exit";
        if (_scp_to(target, bin1, rem1) != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T1 scp failed");
            fail = fail + 1;
        } else {
            _codesign_remote(target, rem1);
            var ec = _ssh_remote_exit(target, rem1);
            if (ec != 42) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                _p(": T1 (exit42 via __got[0]) got rc=");
                print_num(ec);
                println(" (expected 42)");
                fail = fail + 1;
            }
            _ssh_remote_exit(target, "rm -f /tmp/cyr_macho_exit");
        }
        sys_unlink(bin1);
    }

    # ---- T2: write "hello\n" then exit(42) ----
    var src2 = _tmp_path("audit_macho_t2_src_");
    var bin2 = _tmp_path("audit_macho_t2_bin_");
    _write_file(src2, "syscall(1, 1, \"hello\\n\", 6);\nsyscall(60, 42);\n");
    var rc2 = _self_host_pipe_env(src2, CC_AARCH64_PATH, bin2, env_kv);
    sys_unlink(src2);
    if (rc2 != 0) {
        sys_unlink(bin2);
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": T2 cross-build rc=");
        print_num(rc2);
        println("");
        fail = fail + 1;
    } else {
        var rem2 = "/tmp/cyr_macho_write";
        if (_scp_to(target, bin2, rem2) != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T2 scp failed");
            fail = fail + 1;
        } else {
            _codesign_remote(target, rem2);
            var out2 = _tmp_path("audit_macho_t2_out_");
            var ec = _ssh_remote_exec_capture(target, rem2, out2);
            if (ec != 42) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                _p(": T2 (write+exit) rc=");
                print_num(ec);
                println(" (expected 42)");
                fail = fail + 1;
            }
            if (_file_contains_substr(out2, "hello") != 1) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": T2 stdout missing 'hello'");
                fail = fail + 1;
            }
            sys_unlink(out2);
            _ssh_remote_exit(target, "rm -f /tmp/cyr_macho_write");
        }
        sys_unlink(bin2);
    }

    # ---- T3: user fn + arithmetic + peephole ----
    var src3 = _tmp_path("audit_macho_t3_src_");
    var bin3 = _tmp_path("audit_macho_t3_bin_");
    _write_file(src3, "fn add3(a, b, c) { return a + b + c; }\nsyscall(60, add3(10, 20, 12));\n");
    var rc3 = _self_host_pipe_env(src3, CC_AARCH64_PATH, bin3, env_kv);
    sys_unlink(src3);
    if (rc3 != 0) {
        sys_unlink(bin3);
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": T3 cross-build rc=");
        print_num(rc3);
        println("");
        fail = fail + 1;
    } else {
        var rem3 = "/tmp/cyr_macho_peep";
        if (_scp_to(target, bin3, rem3) != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T3 scp failed");
            fail = fail + 1;
        } else {
            _codesign_remote(target, rem3);
            var ec = _ssh_remote_exit(target, rem3);
            if (ec != 42) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                _p(": T3 (peephole add3) rc=");
                print_num(ec);
                println(" (expected 42)");
                fail = fail + 1;
            }
            _ssh_remote_exit(target, "rm -f /tmp/cyr_macho_peep");
        }
        sys_unlink(bin3);
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": Mach-O arm64 runtime (exit + write + peephole) on ");
        println(target);
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate (v5.9.39): Mach-O arm64 `#derive(Serialize)` end-
# to-end on ecb. Pins both halves of the v5.9.38/39 Mach-O bug
# cascade that surfaced from agnosys 1.1.12:
#   * v5.9.38 — `lib/fnptr.cyr` was missing `CYRIUS_TARGET_MACOS`
#     branches in fncall0..fncall8. fncallN returned 0 on Mach-O,
#     `alloc_via` returned NULL, str_builder_new SIGSEGVed at
#     load64(NULL+8). Fixed by adding the macOS asm branches.
#   * v5.9.39 — aarch64 fixup ftype==3 (`&fn_name` and closure-
#     literal addresses) emitted a static MOVZ/MOVK chain. Apple
#     Silicon enforces MH_PIE; dyld slides the image at load,
#     and absolute addresses survive the slide as garbage.
#     Fixed by branching to FIXUP_ADRP_ADD on Mach-O, mirroring
#     ftype==1 (string addr) and ftype==0 (var addr).
#
# The fixture defines `#derive(Serialize) struct point { x: i64;
# y: i64; }`, exercises `point_to_json(&p, sb)` (auto-generated
# JSON emitter — exercises ALL of: struct field load, fn dispatch
# through allocator vtable, str_builder_putc / str_builder_add /
# str_builder_add_int chain), and exits with the byte-count of
# the JSON written into the builder. Linux aarch64 returns 14
# for `{"x":7,"y":35}` (14 chars); Mach-O must match. Anything
# else — exit 139 (SIGSEGV from regressed Bug A or Bug B), exit
# 1 (str_builder_new returned NULL — Bug A regression alone),
# or exit ≠ 14 (codegen drift) — is a failure.
fn _macho_derive_serialize_gate(): i64 {
    var label = "Mach-O arm64 #derive(Serialize) end-to-end on ecb (pin v5.9.39)";
    if (file_exists(CC_AARCH64_PATH) != 1) {
        _p("  skip: ");
        _p(CC_AARCH64_PATH);
        println(" not built (cross-compiler required)");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET_MACOS", "ecb");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable (no macOS arm64 runner available)");
        _check(label, 0);
        return 0;
    }

    var fail = 0;
    var env_kv = "CYRIUS_MACHO_ARM=1";
    var src = _tmp_path("audit_macho_derive_src_");
    var bin = _tmp_path("audit_macho_derive_bin_");
    _write_file(src, "include \"lib/syscalls.cyr\"\ninclude \"lib/string.cyr\"\ninclude \"lib/str.cyr\"\ninclude \"lib/alloc.cyr\"\ninclude \"lib/fmt.cyr\"\n\n#derive(Serialize)\nstruct point { x: i64; y: i64; }\n\nfn main() {\n    var p = point { x: 7, y: 35 };\n    var sb = str_builder_new();\n    if (sb == 0) { syscall(60, 1); }\n    point_to_json(&p, sb);\n    var len = load64(sb + 8);\n    syscall(60, len);\n}\n");
    var rc = _self_host_pipe_env(src, CC_AARCH64_PATH, bin, env_kv);
    sys_unlink(src);
    if (rc != 0) {
        sys_unlink(bin);
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": cross-build rc=");
        print_num(rc);
        println("");
        fail = fail + 1;
    } else {
        var rem = "/tmp/cyr_macho_derive";
        if (_scp_to(target, bin, rem) != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": scp failed");
            fail = fail + 1;
        } else {
            _codesign_remote(target, rem);
            var ec = _ssh_remote_exit(target, rem);
            if (ec != 14) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                _p(": exit=");
                print_num(ec);
                println(" (expected 14 for `{\"x\":7,\"y\":35}` byte-count; 139=SIGSEGV→Bug A/B regression, 1=str_builder_new→NULL→Bug A, other=codegen drift)");
                fail = fail + 1;
            }
            _ssh_remote_exit(target, "rm -f /tmp/cyr_macho_derive");
        }
        sys_unlink(bin);
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": Mach-O arm64 #derive(Serialize) → exit 14 on ");
        println(target);
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate (v5.9.32): Windows 11 PE32+ runtime gate. Cross-
# builds 3 fixtures via build/cycc_win_cross (the Linux-host
# cyrius compiler that emits PE — built on demand from
# src/main_win.cyr if absent), scp's each + a .bat wrapper to
# cass (Windows 11), runs via `cmd /c`, parses `exit=N` from
# stdout (Windows ERRORLEVEL doesn't propagate cleanly through
# ssh, so the .bat echoes it for us to grep).
#   T1 — bare top-level `syscall(60, 42)` exits 42 via
#        kernel32!ExitProcess.
#   T2 — `syscall(1, 1, "hello\n", 6); syscall(60, 42)` writes
#        "hello" via kernel32!WriteFile + exits 42.
#   T3 — user fn + arithmetic + peephole.
fn _pe_exit_gate(): i64 {
    var label = "PE syscall(60,42) → exit 42 on cass (pin v5.6.36)";
    var cc_pe = _root_path("build/cycc_win_cross");
    if (file_exists(cc_pe) != 1) {
        # Build on demand from src/main_win.cyr.
        var main_win = _root_path("src/main_win.cyr");
        if (file_exists(main_win) == 1) {
            if (file_exists(CC_PATH) == 1) {
                _self_host_pipe(main_win, CC_PATH, cc_pe);
                sys_chmod(cc_pe, 493);
            }
        }
    }
    if (file_exists(cc_pe) != 1) {
        _p("  skip: ");
        _p(cc_pe);
        println(" not present (Linux→PE cross-compiler not built)");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET_WIN", "cass");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable (no Windows runner available)");
        _check(label, 0);
        return 0;
    }

    var fail = 0;

    # ---- T1: bare exit(42) ----
    var src1 = _tmp_path("audit_pe_t1_src_");
    var bin1 = _tmp_path("audit_pe_t1_bin_");
    _write_file(src1, "syscall(60, 42);\n");
    var rc1 = _self_host_pipe(src1, cc_pe, bin1);
    sys_unlink(src1);
    if (rc1 != 0) {
        sys_unlink(bin1);
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": T1 cross-build rc=");
        print_num(rc1);
        println("");
        fail = fail + 1;
    } else {
        # scp .exe + .bat. .bat echoes "exit=%ERRORLEVEL%" for
        # us to grep over ssh stdout (the bash version does the
        # same — Windows ERRORLEVEL doesn't propagate via ssh).
        var bat1 = _tmp_path("audit_pe_t1_bat_");
        _write_file(bat1, "@echo off\ncyr_pe_exit.exe\necho exit=%ERRORLEVEL%\n");
        var scp_a = _scp_to(target, bin1, "cyr_pe_exit.exe");
        var scp_b = _scp_to(target, bat1, "cyr_pe_runexit.bat");
        sys_unlink(bat1);
        if (scp_a != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T1 .exe scp failed");
            fail = fail + 1;
        } else { if (scp_b != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T1 .bat scp failed");
            fail = fail + 1;
        } else {
            var out1 = _tmp_path("audit_pe_t1_out_");
            _ssh_remote_exec_capture(target, "cmd /c cyr_pe_runexit.bat", out1);
            if (_file_contains_substr(out1, "exit=42") != 1) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": T1 (exit42 via kernel32 IAT) stdout missing 'exit=42'");
                fail = fail + 1;
            }
            sys_unlink(out1);
        } }
        sys_unlink(bin1);
        _ssh_remote_exit(target, "del /f /q cyr_pe_exit.exe cyr_pe_runexit.bat 2>NUL");
    }

    # ---- T2: write "hello\n" then exit(42) ----
    var src2 = _tmp_path("audit_pe_t2_src_");
    var bin2 = _tmp_path("audit_pe_t2_bin_");
    _write_file(src2, "syscall(1, 1, \"hello\\n\", 6);\nsyscall(60, 42);\n");
    var rc2 = _self_host_pipe(src2, cc_pe, bin2);
    sys_unlink(src2);
    if (rc2 != 0) {
        sys_unlink(bin2);
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": T2 cross-build rc=");
        print_num(rc2);
        println("");
        fail = fail + 1;
    } else {
        var bat2 = _tmp_path("audit_pe_t2_bat_");
        _write_file(bat2, "@echo off\ncyr_pe_write.exe\necho exit=%ERRORLEVEL%\n");
        var scp_a = _scp_to(target, bin2, "cyr_pe_write.exe");
        var scp_b = _scp_to(target, bat2, "cyr_pe_runwrite.bat");
        sys_unlink(bat2);
        if (scp_a == 0) { if (scp_b == 0) {
            var out2 = _tmp_path("audit_pe_t2_out_");
            _ssh_remote_exec_capture(target, "cmd /c cyr_pe_runwrite.bat", out2);
            if (_file_contains_substr(out2, "exit=42") != 1) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": T2 (write+exit) missing 'exit=42'");
                fail = fail + 1;
            }
            if (_file_contains_substr(out2, "hello") != 1) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": T2 stdout missing 'hello'");
                fail = fail + 1;
            }
            sys_unlink(out2);
        } else {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T2 .bat scp failed");
            fail = fail + 1;
        } } else {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T2 .exe scp failed");
            fail = fail + 1;
        }
        sys_unlink(bin2);
        _ssh_remote_exit(target, "del /f /q cyr_pe_write.exe cyr_pe_runwrite.bat 2>NUL");
    }

    # ---- T3: user fn + arithmetic + peephole ----
    var src3 = _tmp_path("audit_pe_t3_src_");
    var bin3 = _tmp_path("audit_pe_t3_bin_");
    _write_file(src3, "fn add3(a, b, c) { return a + b + c; }\nsyscall(60, add3(10, 20, 12));\n");
    var rc3 = _self_host_pipe(src3, cc_pe, bin3);
    sys_unlink(src3);
    if (rc3 != 0) {
        sys_unlink(bin3);
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": T3 cross-build rc=");
        print_num(rc3);
        println("");
        fail = fail + 1;
    } else {
        var bat3 = _tmp_path("audit_pe_t3_bat_");
        _write_file(bat3, "@echo off\ncyr_pe_peep.exe\necho exit=%ERRORLEVEL%\n");
        var scp_a = _scp_to(target, bin3, "cyr_pe_peep.exe");
        var scp_b = _scp_to(target, bat3, "cyr_pe_runpeep.bat");
        sys_unlink(bat3);
        if (scp_a == 0) { if (scp_b == 0) {
            var out3 = _tmp_path("audit_pe_t3_out_");
            _ssh_remote_exec_capture(target, "cmd /c cyr_pe_runpeep.bat", out3);
            if (_file_contains_substr(out3, "exit=42") != 1) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": T3 (peephole add3) missing 'exit=42'");
                fail = fail + 1;
            }
            sys_unlink(out3);
        } else {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T3 .bat scp failed");
            fail = fail + 1;
        } } else {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": T3 .exe scp failed");
            fail = fail + 1;
        }
        sys_unlink(bin3);
        _ssh_remote_exit(target, "del /f /q cyr_pe_peep.exe cyr_pe_runpeep.bat 2>NUL");
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": PE32+ Windows runtime (exit + write + peephole) on ");
        println(target);
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: PE32+ kernel32 path APIs (CreateFileW + mkdir +
# unlink) work on cass — v5.11.23 alignment-fix regression
# guard. Catches the bug class that v5.11.22 surfaced: EOPEN_PE
# (and the new mkdir/unlink routes) used frame 0x250 which left
# RSP misaligned by 8 at the kernel32 CALL. Wine 11.8 tolerates
# the misalignment; Win11 26200's ntdll detects it (at
# +0x41912) and access-violates. _pe_exit_gate only exercises
# exit42 + hello-world (whose frame sizes happened to align by
# coincidence given their syscall arities); never exercised a
# path API, masking the bug. THIS gate exercises all 3 path
# APIs in one compile and checks both exit code AND filesystem
# side-effects.
fn _pe_path_apis_gate(): i64 {
    var label = "PE kernel32 path APIs on cass (CreateFileW + mkdir + unlink; v5.11.23)";
    var cc_pe = _root_path("build/cycc_win_cross");
    if (file_exists(cc_pe) != 1) {
        var main_win = _root_path("src/main_win.cyr");
        if (file_exists(main_win) == 1) {
            if (file_exists(CC_PATH) == 1) {
                _self_host_pipe(main_win, CC_PATH, cc_pe);
                sys_chmod(cc_pe, 493);
            }
        }
    }
    if (file_exists(cc_pe) != 1) {
        _p("  skip: ");
        _p(cc_pe);
        println(" not present");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET_WIN", "cass");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable (no Windows runner available)");
        _check(label, 0);
        return 0;
    }

    var fail = 0;

    # Build a test that exercises all 3 path APIs.
    var src = _tmp_path("audit_pe_paths_src_");
    var bin = _tmp_path("audit_pe_paths_bin_");
    _write_file(src, "var fd = syscall(2, \"C:\\\\cyr_pe_paths_test.tmp\", 65, 384);\nsyscall(3, fd);\nsyscall(83, \"C:\\\\cyr_pe_paths_test_dir\", 493);\nsyscall(87, \"C:\\\\cyr_pe_paths_test.tmp\");\nsyscall(60, 99);\n");
    var rc_b = _self_host_pipe(src, cc_pe, bin);
    sys_unlink(src);
    if (rc_b != 0) {
        sys_unlink(bin);
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": cross-build rc=");
        print_num(rc_b);
        println("");
        _check(label, 1);
        return 1;
    }

    # Build a .bat that runs the binary + checks filesystem effects.
    # Cleans up beforehand so prior runs don't muddle the verdict.
    var bat = _tmp_path("audit_pe_paths_bat_");
    _write_file(bat, "@echo off\ndel /f /q C:\\cyr_pe_paths_test.tmp 2>nul\nrmdir /S /Q C:\\cyr_pe_paths_test_dir 2>nul\ncyr_pe_paths.exe\necho exit=%ERRORLEVEL%\nif exist C:\\cyr_pe_paths_test_dir (echo dir=YES) else (echo dir=NO)\nif exist C:\\cyr_pe_paths_test.tmp (echo file=YES) else (echo file=NO)\nrmdir /S /Q C:\\cyr_pe_paths_test_dir 2>nul\n");

    var scp_a = _scp_to(target, bin, "cyr_pe_paths.exe");
    var scp_b = _scp_to(target, bat, "cyr_pe_paths.bat");
    sys_unlink(bat);

    if (scp_a == 0) { if (scp_b == 0) {
        var out = _tmp_path("audit_pe_paths_out_");
        _ssh_remote_exec_capture(target, "cmd /c cyr_pe_paths.bat", out);

        if (_file_contains_substr(out, "exit=99") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": missing 'exit=99' — binary crashed before reaching ExitProcess (alignment regression?)");
            fail = fail + 1;
        }
        if (_file_contains_substr(out, "dir=YES") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": CreateDirectoryW did not create C:\\cyr_pe_paths_test_dir");
            fail = fail + 1;
        }
        if (_file_contains_substr(out, "file=NO") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": DeleteFileW did not remove C:\\cyr_pe_paths_test.tmp");
            fail = fail + 1;
        }
        sys_unlink(out);
    } else {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": .bat scp failed");
        fail = fail + 1;
    } } else {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": .exe scp failed");
        fail = fail + 1;
    }

    sys_unlink(bin);
    _ssh_remote_exit(target, "del /f /q cyr_pe_paths.exe cyr_pe_paths.bat 2>NUL");

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": PE kernel32 path APIs (CreateFileW + CreateDirectoryW + DeleteFileW) on ");
        println(target);
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: native aarch64 cycc self-hosts byte-identical on
# Pi (v5.6.32). Pipeline:
#   1. Cross-build aarch64-host cycc from src/main_aarch64_native.cyr
#      via the existing cycc_aarch64 cross-compiler.
#   2. scp the native binary to the configured SSH target.
#   3. tar-pipe `src lib` to /tmp/cyr_selfhost_tree on the remote.
#   4. On the remote, two-step compile:
#        cat src/main_aarch64_native.cyr | cc5_native > cc5_b
#        cat src/main_aarch64_native.cyr | cc5_b      > cc5_c
#   5. Assert `cmp cc5_b cc5_c` returns 0 (byte-identical).
fn _aarch64_native_selfhost_gate(): i64 {
    var label = "native cycc self-hosts byte-identical on Pi (pin v5.6.32)";
    if (file_exists(CC_PATH) != 1) {
        _p("  skip: ");
        _p(CC_PATH);
        println(" not present");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET", "pi");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable via ssh (no aarch64 runner available)");
        _check(label, 0);
        return 0;
    }

    # Step 1: cross-build aarch64-native cycc via the existing
    # cycc_aarch64 cross-compiler. (We can't reuse build/cycc_aarch64
    # directly — that's an x86 binary that runs the aarch64
    # backend; we need a binary that is itself aarch64 ELF and
    # ALSO emits aarch64 code.)
    var arch_cc_x86 = _root_path("build/cycc_aarch64");
    if (file_exists(arch_cc_x86) != 1) {
        _p("  skip: ");
        _p(arch_cc_x86);
        println(" not built (cross-compiler required)");
        _check(label, 0);
        return 0;
    }
    var native_src = _root_path("src/main_aarch64_native.cyr");
    var cc_native = _tmp_path("audit_cc_native_");
    var rc1 = _self_host_pipe(native_src, arch_cc_x86, cc_native);
    if (rc1 != 0) {
        sys_unlink(cc_native);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cc5_native cross-build failed (rc=");
        print_num(rc1);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Step 2: ship cc5_native to remote.
    var remote_cc = "/tmp/cyr_selfhost_cc5";
    var scp_rc = _scp_to(target, cc_native, remote_cc);
    sys_unlink(cc_native);
    if (scp_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": scp cc5_native to ");
        _p(target);
        _p(" failed (rc=");
        print_num(scp_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Step 3: tar-pipe src + lib to remote.
    var remote_tree = "/tmp/cyr_selfhost_tree";
    var tar_rc = _tar_pipe_ssh(target, ROOT_PATH, "src lib", remote_tree);
    if (tar_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": tar-pipe src+lib to ");
        _p(target);
        _p(" failed (rc=");
        print_num(tar_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Step 4: two-step compile on remote, then cmp.
    var cmd_sb = str_builder_new();
    str_builder_add_cstr(cmd_sb, "chmod +x ");
    str_builder_add_cstr(cmd_sb, remote_cc);
    str_builder_add_cstr(cmd_sb, " && cd ");
    str_builder_add_cstr(cmd_sb, remote_tree);
    str_builder_add_cstr(cmd_sb, " && cat src/main_aarch64_native.cyr | ");
    str_builder_add_cstr(cmd_sb, remote_cc);
    str_builder_add_cstr(cmd_sb, " > cc5_b 2>/dev/null && chmod +x cc5_b && ");
    str_builder_add_cstr(cmd_sb, "cat src/main_aarch64_native.cyr | ./cc5_b > cc5_c 2>/dev/null && ");
    str_builder_add_cstr(cmd_sb, "cmp cc5_b cc5_c >/dev/null; rc=$?; ");
    str_builder_add_cstr(cmd_sb, "rm -rf ");
    str_builder_add_cstr(cmd_sb, remote_cc);
    str_builder_add_cstr(cmd_sb, " ");
    str_builder_add_cstr(cmd_sb, remote_tree);
    str_builder_add_cstr(cmd_sb, "; exit $rc");
    var cmd = str_data(str_builder_build(cmd_sb));
    var ec = _ssh_remote_exit(target, cmd);

    if (ec == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": native aarch64 cycc self-hosts byte-identical on ");
        _p(target);
        println(" (v5.6.32)");
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": native self-host failed on ");
    _p(target);
    _p(" (rc=");
    print_num(ec);
    println(") — compile error or cc5_b != cc5_c");
    _check(label, 1);
    return 1;
}

# Bespoke gate: aarch64 f64 basic-op correctness (v5.7.30).
# Cross-builds an f64-op smoke fixture with cycc_aarch64, scp's
# the binary to the configured SSH target (default `pi`),
# ssh-runs it, decodes the exit code (1-11 = per-op failure,
# 99 = all PASS).
fn _aarch64_f64_basic_gate(): i64 {
    var label = "aarch64 f64 add/sub/mul/div/sqrt/neg/floor/ceil/round + int↔f64 bit-exact on Pi (v5.7.30)";
    if (file_exists(CC_AARCH64_PATH) != 1) {
        _p("  skip: ");
        _p(CC_AARCH64_PATH);
        println(" not built (cross-compiler required)");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET", "pi");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable via ssh");
        _check(label, 0);
        return 0;
    }

    var fix = _root_path("tests/fixtures/aarch64_f64/basic_ops.cyr");
    var bin = _tmp_path("audit_f64_basic_");
    var rc = _self_host_pipe(fix, CC_AARCH64_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": aarch64 cross-build failed (rc=");
        print_num(rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var remote = "/tmp/cyrius_f64_aa_smoke";
    var scp_rc = _scp_to(target, bin, remote);
    sys_unlink(bin);
    if (scp_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": scp to ");
        _p(target);
        _p(" failed (rc=");
        print_num(scp_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var cmd_sb = str_builder_new();
    str_builder_add_cstr(cmd_sb, "chmod +x ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, " && ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, "; rc=$?; rm -f ");
    str_builder_add_cstr(cmd_sb, remote);
    str_builder_add_cstr(cmd_sb, "; exit $rc");
    var cmd = str_data(str_builder_build(cmd_sb));
    var ec = _ssh_remote_exit(target, cmd);

    if (ec == 99) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": aarch64 f64 basic ops bit-exact on ");
        _p(target);
        println(" (v5.7.30)");
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": aarch64 f64 basic op failure (exit=");
    print_num(ec);
    if (ec == 1) { _p(" — f64_add(2.0, 3.0) != 5.0"); }
    if (ec == 2) { _p(" — f64_sub(3.0, 2.0) != 1.0"); }
    if (ec == 3) { _p(" — f64_mul(2.0, 3.0) != 6.0"); }
    if (ec == 4) { _p(" — f64_div(3.0, 2.0) != 1.5"); }
    if (ec == 5) { _p(" — f64_neg(2.0) != -2.0"); }
    if (ec == 6) { _p(" — f64_sqrt(4.0) != 2.0"); }
    if (ec == 7) { _p(" — f64_floor(2.5) != 2.0"); }
    if (ec == 8) { _p(" — f64_ceil(2.5) != 3.0"); }
    if (ec == 9) { _p(" — f64_round(2.5) != 2.0 (ties-to-even)"); }
    if (ec == 10) { _p(" — f64_to(f64_from(42)) != 42"); }
    if (ec == 11) { _p(" — f64_to(f64_from(-7)) != -7"); }
    println(")");
    _check(label, 1);
    return 1;
}

# Bespoke gate: aarch64 f64_exp / f64_ln / f64_log2 polyfill
# correctness (v5.7.31 + v5.8.4; phylax-unblock). Same shape as
# `_aarch64_f64_basic_gate` — cross-build via cycc_aarch64, scp,
# ssh-run, decode exit code (1-10 = per-shape failure within ulp
# budget; 99 = all PASS).
fn _aarch64_f64_polyfill_gate(): i64 {
