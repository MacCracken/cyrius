    println("");

    _section("Reserved-keyword diag");
    _gate("'var match/in/default/shared' → 'reserved keyword ... cannot be used as identifier'", "tests/regression-reserved-kw-diag.sh");
    println("");

    _section("Shadow + PAM");
    _tcyr_relay_gate("shadow_getspnam + unix_chkpwd auth paths", "shadow_pam", "shadow_pam.tcyr");
    println("");

    _section("fdlopen primitives");
    _tcyr_relay_gate("setjmp/longjmp + helper-path + state-buf API", "fdlopen primitives", "fdlopen.tcyr");
    println("");

    _section("thread-local slots");
    _tcyr_relay_gate("%fs / TPIDR_EL0 slots + CLONE_SETTLS worker isolation", "thread_local slot storage", "thread_local.tcyr");
    println("");

    _section("atomics + mutex race-free");
    _tcyr_relay_gate("atomic_cas/fetch_add/fence + 4-thread contention + mutex", "atomic primitives + mutex race-free", "atomics.tcyr");
    println("");

    _section("thread-safety pattern");
