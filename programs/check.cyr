fn main() {
    alloc_init();
    _load_environ();
    _setup_paths();

    println("=== Cyrius v2.0 Audit ===");
    println("");

    _self_host_gate();
    _heapmap_gate();
    _testsuite_gate();
    _run_regression_gates();
    _format_gate();
    _lint_gate();

    println("════════════════════════");
    print_num(G_PASS);
    _p(" passed, ");
    print_num(G_FAIL);
    _p(" failed (");
    print_num(G_TOTAL);
    println(" total)");

    return G_FAIL;
}

var r = main();
syscall(60, r);
