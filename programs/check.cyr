        _p(target);
        println(" (v5.7.31 + v5.8.4)");
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": polyfill failure (exit=");
    print_num(ec);
    if (ec == 1)  { _p(" — f64_exp(0) != 1.0 exactly"); }
    if (ec == 2)  { _p(" — f64_exp(1) deviates >1024 ulp from e"); }
    if (ec == 3)  { _p(" — f64_ln(1) deviates >1024 ulp from 0"); }
    if (ec == 4)  { _p(" — f64_ln(e) deviates >1024 ulp from 1.0"); }
    if (ec == 5)  { _p(" — exp(ln(2)) deviates >4096 ulp from 2.0 (round-trip)"); }
    if (ec == 6)  { _p(" — f64_exp(-1) deviates >1024 ulp from 1/e"); }
    if (ec == 7)  { _p(" — f64_log2(1) deviates >1024 ulp from 0"); }
    if (ec == 8)  { _p(" — f64_log2(8) deviates >8192 ulp from 3.0"); }
    if (ec == 9)  { _p(" — f64_log2(1024) deviates >8192 ulp from 10.0"); }
    if (ec == 10) { _p(" — f64_log2(0.5) deviates >8192 ulp from -1.0"); }
    println(")");
    _check(label, 1);
    return 1;
}

# Bespoke gate: cyrlint large-file false-positive regression
# floor (v5.8.41; mabda v3 Step 3d/3e). Generates a ~3500-line
# synthetic .cyr (700 _check_N fns × 5 lines each + includes +
# alloc_init + trailing syscall) past the historic ~3270-line
# trigger threshold; runs cyrlint; asserts zero "unclosed
# braces at end of file" and zero "trailing whitespace"
# warnings — both are the file-size false-positive shape
# resolved between v5.7.23 (filing) and v5.8.40 (premise check).
fn _cyrlint_large_file_gate() {
    if (CYRLINT_PATH == 0) {
        _p("  skip: cyrlint not built");
        println("");
        _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", 0);
        return 0;
    }
    if (file_exists(CYRLINT_PATH) != 1) {
        _p("  skip: cyrlint not built");
        println("");
        _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", 0);
        return 0;
    }

    var src_path = _tmp_path("audit_cyrlint_lf_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) {
        _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", 1);
        return 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "# v5.8.41 regression floor - cyrlint large-file false-positive.\n");
    str_builder_add_cstr(sb, "include \"lib/syscalls.cyr\"\n");
    str_builder_add_cstr(sb, "include \"lib/alloc.cyr\"\n");
    str_builder_add_cstr(sb, "include \"lib/assert.cyr\"\n\n");
    str_builder_add_cstr(sb, "alloc_init();\n\n");
    var i = 0;
    while (i < 700) {
        str_builder_add_cstr(sb, "fn _check_");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, "() {\n    test_group(\"group ");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, "\");\n    assert_eq(\n        ");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, ",\n        ");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, ",\n        \"self equality\"\n    );\n    return 0;\n}\n\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "syscall(60, 0);\n");
    var s = str_builder_build(sb);
    sys_write(fd, str_data(s), str_len(s));
    sys_close(fd);

    var line_count = _count_substr_buf(str_data(s), str_len(s), "\n");
    if (line_count < 3270) {
        sys_unlink(src_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": synthetic only ");
        print_num(line_count);
        println(" lines (need >=3270 to trigger the historic bug)");
        _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", 1);
        return 1;
    }

    var cap = 65536;
    var buf = alloc(cap);
    var unclosed = _cyrlint_count_marker(src_path, "unclosed braces at end of file", buf, cap);
    var trailing_ws = _cyrlint_count_marker(src_path, "trailing whitespace", buf, cap);
    sys_unlink(src_path);

    var fail = 0;
    if (unclosed != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        print_num(line_count);
        _p("-line file produced ");
        print_num(unclosed);
        println(" 'unclosed braces' warning(s) — historic bug regression");
        fail = fail + 1;
    }
    if (trailing_ws != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        print_num(line_count);
        _p("-line file produced ");
        print_num(trailing_ws);
        println(" 'trailing whitespace' warning(s) — likely v5.8.41 file-size false-positive regression");
        fail = fail + 1;
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": cyrlint clean on ");
        print_num(line_count);
        println("-line synthetic (mabda 2026-04-28 repro shape; floor for v5.8.41)");
    }
    _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", fail);
    return fail;
}

# Bespoke gate: cyrlint global-init-order forward-ref warning
# (v5.7.32 + v5.7.36 string-lit awareness; mabda-surfaced).
# Four sub-cases:
# (1) forward_refs.cyr fixture — ≥3 "global var init refs"
#     warnings (3 forward refs intentionally).
# (2) lib/math.cyr — exactly 0 (regression vs false positives).
# (3) lib/string.cyr — exactly 0.
# (4) string_literal_safe.cyr fixture — exactly 0 (v5.7.36 fix:
#     string-literal contents must NOT match IDENTs against the
#     forward-decl table).
fn _lint_init_order_gate() {
    if (CYRLINT_PATH == 0) {
        _p("  skip: cyrlint not built");
        println("");
        _check("cyrlint flags forward-ref var inits (v5.7.32; mabda-surfaced)", 0);
        return 0;
    }
    if (file_exists(CYRLINT_PATH) != 1) {
        _p("  skip: cyrlint not built");
        println("");
        _check("cyrlint flags forward-ref var inits (v5.7.32; mabda-surfaced)", 0);
        return 0;
    }
    var fail = 0;
    var cap = 65536;
    var buf = alloc(cap);
    var marker = "global var init refs";

    var bad_fixture = _root_path("tests/fixtures/lint_init_order/forward_refs.cyr");
    var bad_count = _cyrlint_count_marker(bad_fixture, marker, buf, cap);
    if (bad_count < 3) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": forward_refs fixture produced ");
        print_num(bad_count);
        println(" warnings (expected ≥3)");
        fail = fail + 1;
    }

    var math_path = _root_path("lib/math.cyr");
    var math_count = _cyrlint_count_marker(math_path, marker, buf, cap);
    if (math_count != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": lib/math.cyr produced ");
        print_num(math_count);
        println(" false-positive forward-ref warnings");
        fail = fail + 1;
    }

    var str_path = _root_path("lib/string.cyr");
    var str_count = _cyrlint_count_marker(str_path, marker, buf, cap);
    if (str_count != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": lib/string.cyr produced ");
        print_num(str_count);
        println(" false-positive forward-ref warnings");
        fail = fail + 1;
    }

    var strlit_fixture = _root_path("tests/fixtures/lint_init_order/string_literal_safe.cyr");
    var strlit_count = _cyrlint_count_marker(strlit_fixture, marker, buf, cap);
    if (strlit_count != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": string-literal fixture produced ");
        print_num(strlit_count);
        println(" false-positive forward-ref warnings (v5.7.36 string-lit awareness)");
        fail = fail + 1;
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": cyrlint flags forward-ref var inits (");
        print_num(bad_count);
        println(" on fixture; 0 false-positives on stdlib + string-literal scope; v5.7.32 + v5.7.36)");
    }
    _check("cyrlint flags forward-ref var inits (v5.7.32; mabda-surfaced)", fail);
    return fail;
}

# Open fixture as stdin, fork cc5 with one mode flag (e.g.
# `--parse-ts` / `--lex-ts`), return WEXITSTATUS (0 on success,
# non-zero on reject). stdout + stderr go to /dev/null. Used by
# `_parse_ts_dir_gate` and `_ts_lex_gate`.
fn _ts_mode_run(fixture_path, mode_flag) {
    var fd = sys_open(fixture_path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var pid = sys_fork();
    if (pid < 0) { sys_close(fd); return 0 - 1; }
    if (pid == 0) {
        sys_dup2(fd, 0);
        sys_close(fd);
        var dn1 = sys_open("/dev/null", 1, 0);
        if (dn1 >= 0) { sys_dup2(dn1, 1); sys_close(dn1); }
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[3];
        store64(&argv,     CC_PATH);
        store64(&argv + 8, mode_flag);
        store64(&argv + 16, 0);
        var envp[1];
        store64(&envp, 0);
        sys_execve(CC_PATH, &argv, &envp);
        sys_exit(127);
    }
    sys_close(fd);
    var stbuf[1];
    sys_waitpid(pid, &stbuf, 0);
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# Backward-compat wrapper.
fn _parse_ts_run(fixture_path) {
    return _ts_mode_run(fixture_path, "--parse-ts");
}

# Bespoke gate (v5.9.7): single-fixture `cc5 --lex-ts` on the
# synthetic TS sample at `tests/fixtures/ts_lex/sample.ts`. The
# fixture exercises every lex feature shipped in v5.7.2 P1.1-P1.6
# (shebang, JSDoc, identifiers, 30+ keywords, all numeric literal
# bases with separators, template literals + interpolation,
# regex/division disambiguation). Acceptance: exit 0.
fn _ts_lex_gate() {
    var fix = _root_path("tests/fixtures/ts_lex/sample.ts");
    var rc = _ts_mode_run(fix, "--lex-ts");
    if (rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cc5 --lex-ts on sample.ts exit ");
        print_num(rc);
        println("");
        _check("cc5 --lex-ts on synthetic TS sample (v5.7.2 P1.7 acceptance)", 1);
        return 1;
    }
    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    println(": TS lexer integration (P1.1-P1.6 features)");
    _check("cc5 --lex-ts on synthetic TS sample (v5.7.2 P1.7 acceptance)", 0);
    return 0;
}

# Bespoke gate (v5.9.17): SecureYeoman corpus acceptance gate.
# Walks `~/Repos/secureyeoman` (configurable via SY_CORPUS env)
# for every file with `ext`, pruning the standard JS/TS build-
# artifact dirs, runs `cc5 --parse-ts` on each, asserts the PASS
# count meets `threshold`. v5.7.3 P3.1 baseline:
#   .ts  → 2053 files, threshold 2053 (100% pinned at v5.9.17)
#   .tsx → 435 files,  threshold 435  (same)
# Pre-v5.9.17 the .sh used `find ... -not -path */node_modules/* …`;
# the cyrius-side version uses `find_files_with_prunes` from
# lib/fs.cyr (added v5.9.17) for the same prune semantics.
fn _ts_corpus_gate(label, ext, threshold) {
    if (file_exists(CC_PATH) != 1) {
        _p("  skip: ");
        _p(CC_PATH);
        println(" not present");
        _check(label, 0);
        return 0;
    }
    var corpus_root = _ssh_target("SY_CORPUS", "/home/macro/Repos/secureyeoman");
    if (is_dir(str_from(corpus_root)) != 1) {
        _p("  skip: SY corpus not at ");
        _p(corpus_root);
        println(" (override via SY_CORPUS=...)");
        _check(label, 0);
        return 0;
    }

    # Build prune vec — same set as the .sh's find -not -path *.
    var prunes = vec_new();
    vec_push(prunes, str_from("node_modules"));
    vec_push(prunes, str_from("dist"));
    vec_push(prunes, str_from("build"));
    vec_push(prunes, str_from(".next"));
    vec_push(prunes, str_from("coverage"));

    var files = find_files_with_prunes(str_from(corpus_root),
                                       str_from(ext), prunes);
    var total = vec_len(files);

    # For .ts we need to ALSO exclude .tsx (the .sh did this via
    # `-not -name '*.tsx'`). path_has_ext(".ts") matches both
    # foo.ts AND foo.tsx (the trailing 3 chars match either way
    # — actually no, `.ts` is exact suffix; `.tsx` ends with `.tsx`
    # not `.ts`). Verify: str_ends_with(".tsx", ".ts") on ASCII —
    # ".tsx"[len-3..] == ".sx" not ".ts", so no false match. Good.

    var pass = 0;
    var fail = 0;
    var fi = 0;
    while (fi < total) {
        var fp = vec_get(files, fi);
        var rc = _ts_mode_run(str_data(fp), "--parse-ts");
        if (rc == 0) { pass = pass + 1; }
        else { fail = fail + 1; }
        fi = fi + 1;
    }

    if (pass < threshold) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(ext);
        _p(" corpus pass count ");
        print_num(pass);
        _p("/");
        print_num(total);
        _p(" below threshold ");
        print_num(threshold);
        println(" (regression)");
        _check(label, 1);
        return 1;
    }
    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ");
    _p(ext);
    _p(" corpus ");
    print_num(pass);
    _p("/");
    print_num(total);
    _p(" parses (≥");
    print_num(threshold);
    println(" threshold)");
    _check(label, 0);
    return 0;
}

# Bespoke gate template (v5.9.7): walk
# `tests/fixtures/<subdir>/*.ts`, run `cc5 --parse-ts` on each
# fixture, expect every fixture to parse cleanly (exit 0). Used
# by the six TS acceptance gates (ts-asserts, ts-mapped,
# ts-decorators, ts-variadic-tuples, ts-const-type-params,
# ts-advanced-pin-audit), each with its own subdir of 5-7 .ts
# fixtures extracted from the v5.7.x bash heredocs. Per-fixture
# diagnostic on FAIL prints the case filename so a regression
# in `cc5 --parse-ts` reports which input shape rejected.
fn _parse_ts_dir_gate(gate_name, inner_label, subdir) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ROOT_PATH);
    str_builder_add_cstr(sb, "/tests/fixtures/");
    str_builder_add_cstr(sb, subdir);
    var dir_path = str_data(str_builder_build(sb));
    var dir_str = str_from(dir_path);
    var entries = dir_list(dir_str);
    var fail = 0;
    var total = 0;
    var i = 0;
    while (i < vec_len(entries)) {
        var name = vec_get(entries, i);
        if (path_has_ext(name, str_from(".ts")) == 1) {
            total = total + 1;
            var full = path_join(dir_str, name);
            var rc = _parse_ts_run(str_data(full));
            if (rc != 0) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                _p(": ");
                var nm_data = str_data(name);
                var nm_len = str_len(name);
                print(nm_data, nm_len);
                _p(" — cc5 --parse-ts exit ");
                print_num(rc);
                println("");
                fail = fail + 1;
            }
        }
        i = i + 1;
    }
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        _p(" (");
        print_num(total);
        println(" cases)");
    }
    _check(gate_name, fail);
    return fail;
}

# Bespoke gate: lib/args.cyr 4 KB cmdline cap (cyim BUG-001,
# fixed v5.9.5). Compiles tests/fixtures/argc_print.cyr — a
# fixture that calls args_init() and prints argc(); forks the
# binary with one synthetic >4 KB arg (8192 bytes); verifies the
# captured stdout reports `argc() == 2` (program + arg). Pre-fix
# (4 KB stack buffer in args_init), the >4063-byte cmdline
# truncated and argc() reported 1 (program only — arg lost).
fn _args_init_4kb_gate() {
    var fix = _root_path("tests/fixtures/argc_print.cyr");
    var bin = _tmp_path("audit_argc_bin_");
    var rc = _self_host_pipe(fix, CC_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": argc_print fixture compile (rc=");
        print_num(rc);
        println(")");
        _check("args_init reads >4 KB cmdline; argc()==2 with 8 KB arg (cyim BUG-001)", 1);
        return 1;
    }
    sys_chmod(bin, 493);

    # Synthesize an 8192-byte arg — 'A' repeated 8192 times,
    # null-terminated. Comfortably above the pre-v5.9.5 4063-byte
    # truncation threshold; comfortably below ARG_MAX (2 MB).
    var arg_len = 8192;
    var arg = alloc(arg_len + 1);
    var ai = 0;
    while (ai < arg_len) {
        store8(arg + ai, 65);   # 'A'
        ai = ai + 1;
    }
    store8(arg + arg_len, 0);

    var out_cap = 4096;
    var out_buf = alloc(out_cap);
    var out_n = _exec_with_arg_capture(bin, arg, out_buf, out_cap);
    sys_unlink(bin);

    # Parse leading int from captured stdout. Fixture prints
    # `<argc>\n` only.
    var got = _aw_parse_leading_int(out_buf, out_n);
    if (got != 2) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": argc()==");
        print_num(got);
        _p(" with 8 KB arg (expected 2; pre-v5.9.5 cap returned 1, captured ");
        print_num(out_n);
        println(" bytes)");
        _check("args_init reads >4 KB cmdline; argc()==2 with 8 KB arg (cyim BUG-001)", 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": argc()==2 with 8 KB arg (heap-backed buffer, cap 2 MB = ARG_MAX)");
    println("");
    _check("args_init reads >4 KB cmdline; argc()==2 with 8 KB arg (cyim BUG-001)", 0);
    return 0;
}

# Bespoke gate: stdlib doc coverage (pinned post-v5.7.20). Walks
# lib/*.cyr (skipping symlinks + distlib bundles, same convention
# as audit_lint_walk), runs `cyrdoc --check` on each, sums
# "<N> undocumented" totals. Asserts total == 0 and tracks the
# worst offender for diagnostic.
fn _stdlib_doc_coverage_gate() {
    if (CYRDOC_PATH == 0) {
        _p("  skip: cyrdoc not built (cat programs/cyrdoc.cyr | build/cc5 > build/cyrdoc)");
        println("");
        _check("every public fn in lib/*.cyr has a leading doc comment (cyrdoc --check; pinned post-v5.7.20)", 0);
        return 0;
    }
    if (file_exists(CYRDOC_PATH) != 1) {
        _p("  skip: cyrdoc not built (");
        _p(CYRDOC_PATH);
        println(" missing)");
        _check("every public fn in lib/*.cyr has a leading doc comment (cyrdoc --check; pinned post-v5.7.20)", 0);
        return 0;
    }
    var lib_dir = str_from(_root_path("lib"));
    var names = vec_new();
    var dtypes = vec_new();
    _aw_dir_list_typed(lib_dir, names, dtypes);
    var total = 0;
    var worst_n = 0;
    var worst_name = 0;
    var skipped = 0;
    var cap = 200000;
    var buf = alloc(cap);
    var i = 0;
    while (i < vec_len(names)) {
        var name = vec_get(names, i);
        if (_aw_is_cyr(name) == 1) {
            var dtype = vec_get(dtypes, i);
            var full = path_join(lib_dir, name);
            if (dtype == 10) {                       # DT_LNK — symlink
                skipped = skipped + 1;
            } else {
                if (_aw_is_distlib_bundle(full) == 1) {
                    skipped = skipped + 1;
                } else {
                    var args = vec_new();
                    vec_push(args, CYRDOC_PATH);
                    vec_push(args, "--check");
                    vec_push(args, str_data(full));
                    var n = exec_capture(args, buf, cap);
                    var u = _doc_parse_undocumented(buf, n);
                    if (u > 0) {
                        total = total + u;
                        if (u > worst_n) {
                            worst_n = u;
                            worst_name = str_data(path_basename(full));
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    if (total > 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        print_num(total);
        println(" undocumented public fns across lib/*.cyr");
        if (worst_name != 0) {
            _p("    worst offender: ");
            _p(worst_name);
            _p(" (");
            print_num(worst_n);
            println(" undocumented)");
        }
        _check("every public fn in lib/*.cyr has a leading doc comment (cyrdoc --check; pinned post-v5.7.20)", 1);
        return 1;
    }
    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    println(": lib/*.cyr doc coverage (0 undocumented)");
    _check("every public fn in lib/*.cyr has a leading doc comment (cyrdoc --check; pinned post-v5.7.20)", 0);
    return 0;
}

# Find the LAST " undocumented" needle in buf; walk back to leading
# integer. Mirrors the bash `tail -1 | grep -oE '[0-9]+ undocumented'`
# pattern: cyrdoc emits one summary line per file at the bottom.
fn _doc_parse_undocumented(buf, n) {
    var needle = " undocumented";
    var nlen = strlen(needle);
    var found = 0 - 1;
    var i = 0;
    while (i + nlen <= n) {
        if (_buf_eq(buf + i, needle, nlen) == 1) {
            found = i;
        }
        i = i + 1;
    }
    if (found < 0) { return 0; }
    var end = found;
    var start = end;
    while (start > 0) {
        var c = load8(buf + start - 1);
        if (c < 48) { return _aw_parse_leading_int(buf + start, end - start); }
        if (c > 57) { return _aw_parse_leading_int(buf + start, end - start); }
        start = start - 1;
    }
    return _aw_parse_leading_int(buf + start, end - start);
}

# Bespoke gate: reserved-keyword diagnostic (v5.5.26). Asserts
# `var <kw> = 1;` with kw in {match, in, default, shared} triggers
# both "reserved keyword '<kw>'" and "cannot be used as an
# identifier" hints, AND that a legitimate identifier (`my_var`)
# does NOT trigger the path.
fn _reserved_kw_diag_gate() {
    var fail = 0;
    fail = fail + _stderr_match_subcase("var match",
        "include \"lib/syscalls.cyr\"\nfn foo() { var match = 1; return match; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword 'match'", 1);
    fail = fail + _stderr_match_subcase("var in",
        "include \"lib/syscalls.cyr\"\nfn foo() { var in = 1; return in; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword 'in'", 1);
    fail = fail + _stderr_match_subcase("var default",
        "include \"lib/syscalls.cyr\"\nfn foo() { var default = 1; return default; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword 'default'", 1);
    fail = fail + _stderr_match_subcase("var shared",
        "include \"lib/syscalls.cyr\"\nfn foo() { var shared = 1; return shared; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword 'shared'", 1);
    fail = fail + _stderr_match_subcase("hint-text-match",
        "include \"lib/syscalls.cyr\"\nfn foo() { var match = 1; return match; }\nfoo();\nsyscall(60, 0);\n",
        "cannot be used as an identifier", 1);
    fail = fail + _stderr_match_subcase("legit-ident-no-falsepositive",
        "include \"lib/syscalls.cyr\"\nfn foo() { var my_var = 1; return my_var; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword", 0);
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": reserved keyword diagnostic (4 kw + hint + negative control)");
    }
    _check("'var match/in/default/shared' \xe2\x86\x92 'reserved keyword ... cannot be used as identifier'", fail);
    return fail;
}

# Bespoke gate: fn-name collision warning (v5.7.9). Three sub-cases:
# (1) same-arity duplicate must warn, (2) different-arity duplicate
# must warn, (3) forward-decl + later body must NOT warn (false-
# positive guard for legitimate mutual-recursion idiom).
fn _fn_collision_gate() {
    var fail = 0;
    fail = fail + _stderr_match_subcase("same-arity duplicate",
        "fn dup_a(x) { return x + 1; }\nfn dup_a(x) { return x + 2; }\nsyscall(60, 0);\n",
        "duplicate fn 'dup_a'", 1);
    fail = fail + _stderr_match_subcase("different-arity duplicate",
        "fn dup_b(a) { return a; }\nfn dup_b(a, b) { return a + b; }\nsyscall(60, 0);\n",
        "duplicate fn 'dup_b'", 1);
    fail = fail + _stderr_match_subcase("forward-decl mutual recursion",
        "fn caller_one(n) { if (n <= 0) { return 0; } return callee_two(n - 1); }\nfn callee_two(n) { if (n <= 0) { return 0; } return caller_one(n - 1); }\nsyscall(60, caller_one(3));\n",
        "duplicate fn", 0);
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": fn-name collision warning (3/3 cases)");
    }
    _check("duplicate fn warns; forward-decl no false-positive (v5.7.9)", fail);
    return fail;
}

# Bespoke gate: lexer reject paths for malformed string escapes
# (v5.7.13). 11 sub-cases — \x##, \u####, \u{...} variants. Each
# fixture is expected to fail compile with a specific lex error;
# substring grep on cc5's stderr verifies the right diagnostic
# fired. Positive coverage lives in tests/tcyr/string_escapes.tcyr
# (compile-success-only); this gate covers reject paths.
fn _string_escape_rejects_gate() {
    var fail = 0;
    fail = fail + _stderr_match_subcase("x: bad-hex-1st-nibble",
        "var s = \"\\xZ0\"; syscall(60, 0);",
        "\\x escape: bad hex digit", 1);
    fail = fail + _stderr_match_subcase("x: bad-hex-2nd-nibble",
        "var s = \"\\x1Z\"; syscall(60, 0);",
        "\\x escape: bad hex digit", 1);
    fail = fail + _stderr_match_subcase("u: bad-hex",
        "var s = \"\\u00Z0\"; syscall(60, 0);",
        "\\u escape: bad hex digit", 1);
    fail = fail + _stderr_match_subcase("u: surrogate-low",
        "var s = \"\\uD800\"; syscall(60, 0);",
        "surrogate codepoint not allowed", 1);
    fail = fail + _stderr_match_subcase("u: surrogate-high",
        "var s = \"\\uDFFF\"; syscall(60, 0);",
        "surrogate codepoint not allowed", 1);
    fail = fail + _stderr_match_subcase("u{}: empty",
        "var s = \"\\u{}\"; syscall(60, 0);",
        "\\u{...} escape: no hex digits", 1);
    fail = fail + _stderr_match_subcase("u{}: bad-hex",
        "var s = \"\\u{1G}\"; syscall(60, 0);",
        "\\u{...} escape: bad hex digit", 1);
    fail = fail + _stderr_match_subcase("u{}: too-many-digits",
        "var s = \"\\u{1234567}\"; syscall(60, 0);",
        "\\u{...} escape: > 6 hex digits", 1);
    fail = fail + _stderr_match_subcase("u{}: above-max-codepoint",
        "var s = \"\\u{110000}\"; syscall(60, 0);",
        "codepoint > U+10FFFF", 1);
    fail = fail + _stderr_match_subcase("u{}: surrogate-low",
        "var s = \"\\u{D800}\"; syscall(60, 0);",
        "surrogate codepoint not allowed", 1);
    fail = fail + _stderr_match_subcase("u{}: surrogate-high",
        "var s = \"\\u{DFFF}\"; syscall(60, 0);",
        "surrogate codepoint not allowed", 1);
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": string-escape reject cases (11/11)");
    }
    _check("lex rejects malformed \\x## / \\u#### / \\u{...} + surrogates (v5.7.13)", fail);
    return fail;
}

# Bespoke gate (v5.9.24; agnosys 1.1.5 filing): exhaustive-match
# coverage warning fires deterministically across fn names, even
# for DCE-dead fns. Pre-fix the warning fired only when the fn
# name's noff bitmap-bucket happened to collide with a stdlib
# identifier reference (e.g. `lib/string.cyr fn strlen` uses `n`
# as a local — bitmap[n_noff]=1 → user `fn n` reachable; user
# `fn name` not in stdlib → bitmap[name_noff]=0 → DCE-dead → body
# parse skipped → no warning). Probes 4 representative names from
# the agnosys sweep that previously fell into the "unlucky"
# bucket; each must emit `non-exhaustive` to its stderr.
fn _match_coverage_dce_gate() {
    var label = "match exhaustiveness check fires for DCE-dead fns regardless of fn name (v5.9.24; agnosys 1.1.5)";
    if (file_exists(CC_PATH) != 1) {
        _p("  skip: ");
        _p(CC_PATH);
        println(" not present");
        _check(label, 0);
        return 0;
    }

    var fail = 0;
    var probe_names_buf[64];
    store64(&probe_names_buf,        "name");
    store64(&probe_names_buf + 8,    "func");
    store64(&probe_names_buf + 16,   "describe");
    store64(&probe_names_buf + 24,   "handle");

    var i = 0;
    while (i < 4) {
        var fn_nm = load64(&probe_names_buf + i * 8);

        var sb = str_builder_new();
        str_builder_add_cstr(sb, "include \"lib/string.cyr\"\n");
        str_builder_add_cstr(sb, "include \"lib/alloc.cyr\"\n");
        str_builder_add_cstr(sb, "include \"lib/syscalls.cyr\"\n");
        str_builder_add_cstr(sb, "enum E { A1 = 1; B1 = 2; C1 = 3; }\n");
        str_builder_add_cstr(sb, "fn ");
        str_builder_add_cstr(sb, fn_nm);
        str_builder_add_cstr(sb, "(x) { match x { A1 => { return 1; } B1 => { return 2; } } return 0; }\n");
        str_builder_add_cstr(sb, "fn main() { return 0; }\nvar ec = main(); syscall(60, ec);\n");

        var src_path = _tmp_path("audit_match_dce_src_");
        var err_path = _tmp_path("audit_match_dce_err_");
        _write_file(src_path, str_data(str_builder_build(sb)));

        _compile_capture_stderr(src_path, CC_PATH, err_path);
        if (_file_contains_substr(err_path, "non-exhaustive match over enum") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": fn '");
            _p(fn_nm);
            println("' did not emit 'non-exhaustive match' diagnostic");
            fail = fail + 1;
        }
        sys_unlink(src_path);
        sys_unlink(err_path);
        i = i + 1;
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": warning fires for 4/4 dead fns (name / func / describe / handle)");
    }
    _check(label, fail);
    return fail;
}

# Returns 1 if the two files have identical content, 0 otherwise.
# cmp -s equivalent.
fn _files_identical(path_a, path_b) {
    var cap = 2000000;
    var buf_a = alloc(cap);
    var buf_b = alloc(cap);
    var na = file_read_all(path_a, buf_a, cap);
    var nb = file_read_all(path_b, buf_b, cap);
    if (na != nb) { return 0; }
    var i = 0;
    while (i < na) {
        if (load8(buf_a + i) != load8(buf_b + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Returns the file size in bytes via sys_stat (struct stat layout
# st_size at offset 48 on x86_64 Linux per arch/x86/include/uapi/asm/
# stat.h). Returns 0 on failure.
fn _file_size(path) {
    var sbuf = alloc(144);
    var rc = sys_stat(path, sbuf);
    if (rc < 0) { return 0; }
    return load64(sbuf + 48);
}

# Build a tmp file path "/tmp/<prefix><pid>".
fn _tmp_path(prefix) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/");
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, sys_getpid());
    var s = str_builder_build(sb);
    return str_data(s);
}

fn _self_host_gate() {
    _section("Self-Hosting");
    var src = _root_path("src/main.cyr");
    var cc_a = _tmp_path("audit_cc_a_");
    var cc_b = _tmp_path("audit_cc_b_");
    var rc1 = _self_host_pipe(src, CC_PATH, cc_a);
    if (rc1 != 0) {
        _check("cc5==cc5 byte-identical", 1);
        println("");
        return 1;
    }
    sys_chmod(cc_a, 493);
    var rc2 = _self_host_pipe(src, cc_a, cc_b);
    if (rc2 != 0) {
        _check("cc5==cc5 byte-identical", 1);
        sys_unlink(cc_a);
        println("");
        return 1;
    }
    var ok = _files_identical(cc_a, cc_b);
    if (ok == 1) { _check("cc5==cc5 byte-identical", 0); }
    else         { _check("cc5==cc5 byte-identical", 1); }
    _p("    binary: ");
    print_num(_file_size(cc_a));
    println(" bytes");
    sys_unlink(cc_a);
    sys_unlink(cc_b);
    println("");
    if (ok == 1) { return 0; }
    return 1;
}

# ── Heap-map audit ──
fn _heapmap_gate() {
    _section("Heap Map");
    _gate("no heap overlaps", "tests/heapmap.sh");
    println("");
    return 0;
}

# Returns 1 if the buffer at p starts with the c-string `s` for n
# bytes; 0 otherwise.
fn _buf_eq(p, s, n) {
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(s + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Find " failed" in buffer; walk back to the leading integer and
# return it. Returns 0 if needle not found (no summary line ⇒
# treat as PASS-by-default; the caller separately considers exit
# code). Mirrors _tcyr_parse_passed's shape.
fn _tcyr_parse_failed(buf, n) {
    var needle = " failed";
    var nlen = strlen(needle);
    var i = 0;
    while (i + nlen <= n) {
        if (_buf_eq(buf + i, needle, nlen) == 1) {
            var end = i;
            var start = end;
            while (start > 0) {
                var c = load8(buf + start - 1);
                if (c < 48) { return _aw_parse_leading_int(buf + start, end - start); }
                if (c > 57) { return _aw_parse_leading_int(buf + start, end - start); }
                start = start - 1;
            }
            return _aw_parse_leading_int(buf + start, end - start);
        }
        i = i + 1;
    }
    return 0;
}

# Compile a .tcyr file via stdin pipe to cc5, run the resulting
# binary, parse "X passed, Y failed" from output. Returns:
#   0 on PASS, positive int = failed count from summary, -1 on
#   compile failure.
fn _tcyr_compile_and_run(src_path) {
    var bin_path = _tmp_path("audit_t_");
    var rc1 = _self_host_pipe(src_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        sys_unlink(bin_path);
        return 0 - 1;
    }
    sys_chmod(bin_path, 493);

    # v5.9.6 — switched from lib/process.cyr's pipe-based
    # exec_capture to the file-backed _exec_capture_clean.
    # exec_capture deadlocks when the test fixture forks a setuid
    # helper that's reparented to init as an orphan keeping the
    # pipe write-end open (shadow_pam.tcyr → unix_chkpwd; same
    # incident fixed for `_tcyr_relay_gate` in v5.9.2). Pre-v5.9.6
    # the gate reported "0 files" — the dir_list +
    # path_has_ext bugs masked this hang because the loop never
    # iterated; now that those are fixed, the underlying capture
    # bug surfaces here too.
    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_clean(bin_path, out_buf, out_cap);
    sys_unlink(bin_path);

    return _tcyr_parse_failed(out_buf, out_n);
}

fn _testsuite_gate() {
    _section("Test Suite");
    var dir = _root_path("tests/tcyr");
    var dir_str = str_from(dir);
    var entries = dir_list(dir_str);
    var fail_count = 0;
    var total = 0;
    var i = 0;
    while (i < vec_len(entries)) {
        var name = vec_get(entries, i);
        if (path_has_ext(name, str_from(".tcyr")) == 1) {
            var full = path_join(dir_str, name);
            var basename = path_basename(full);
            var bn_data = str_data(basename);
            var bn_len = str_len(basename);
            var label_len = bn_len - 5;   # remove ".tcyr"
            _p("  ");
            print(bn_data, label_len);
            # Pad to 22 columns.
            var pad = 22 - label_len;
            while (pad > 0) { _p(" "); pad = pad - 1; }
            var failed = _tcyr_compile_and_run(str_data(full));
            if (failed < 0) {
                println("FAIL (compile)");
                fail_count = fail_count + 1;
            } else { if (failed > 0) {
                    _p("FAIL (");
                    print_num(failed);
                    println(" failed)");
                    fail_count = fail_count + 1;
                } else {
                    println("PASS");
                } }
            total = total + 1;
        }
        i = i + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "test suite (");
    str_builder_add_int(sb, total);
    str_builder_add_cstr(sb, " files)");
    var label = str_builder_build(sb);
    _check(str_data(label), fail_count);
    println("");
    return fail_count;
}

# ── Format / Lint sections ──
fn _format_gate() {
    _section("Format");
    if (CYRFMT_PATH == 0) {
        println("  cyrfmt not found in build/ or on PATH — install via 'cyriusly setup' or build via build/cc5");
        _check("format (stdlib)", 1);
        println("");
        return 1;
    }
    if (file_exists(CYRFMT_PATH) != 1) {
        println("  cyrfmt not found in build/ or on PATH — install via 'cyriusly setup' or build via build/cc5");
        _check("format (stdlib)", 1);
        println("");
        return 1;
    }
    var dirs = vec_new();
    vec_push(dirs, str_from(_root_path("lib")));
    audit_fmt_walk(CYRFMT_PATH, dirs);
    _check("format (stdlib)", AW_FMT_FAIL);
    if (AW_FMT_SKIPPED > 0) {
        _p("    (");
        print_num(AW_FMT_SKIPPED);
        println(" dep files skipped)");
    }
    println("");
    return AW_FMT_FAIL;
}

fn _lint_gate() {
    _section("Lint");
    if (CYRLINT_PATH == 0) {
        println("  cyrlint not found in build/ or on PATH — install via 'cyriusly setup' or build via build/cc5");
        _check("lint (stdlib)", 1);
        println("");
        return 1;
    }
    if (file_exists(CYRLINT_PATH) != 1) {
        println("  cyrlint not found in build/ or on PATH — install via 'cyriusly setup' or build via build/cc5");
        _check("lint (stdlib)", 1);
        println("");
        return 1;
    }
    var dirs = vec_new();
    vec_push(dirs, str_from(_root_path("lib")));
    audit_lint_walk(CYRLINT_PATH, dirs);
    var fail = 0;
    if (AW_LINT_TOTAL > 0) {
        _p("  ");
        print_num(AW_LINT_TOTAL);
        println(" warnings");
        fail = 1;
    }
    _check("lint (stdlib)", fail);
    if (AW_LINT_SKIPPED > 0) {
        _p("    (");
        print_num(AW_LINT_SKIPPED);
        println(" dep files skipped)");
    }
    println("");
    return fail;
}

# ── Build cyrius_api_surface on demand ──
# Mirrors the v5.8.44 fix: if build/cyrius_api_surface is missing,
# build it before the api-surface gate runs (otherwise the gate
# silently skips and the audit reports false-green).
fn _build_api_surface_if_missing() {
    var bin = _root_path("build/cyrius_api_surface");
    if (file_exists(bin) == 1) { return 0; }
    var src = _root_path("programs/cyrius_api_surface.cyr");
    if (file_exists(src) != 1) { return 0; }
    if (file_exists(CC_PATH) != 1) { return 0; }
    _self_host_pipe(src, CC_PATH, bin);
    sys_chmod(bin, 493);
    return 0;
}

# Bespoke gate: `shared;` directive produces a dlopen-able .so
# (v4.7.0 alpha1/alpha2/GA + shared-mode fn-body elision fix).
# Compiles tests/fixtures/shared/lib.cyr (4 exports: add,
# greeting, get_counter, inc_counter; one mutable global
# `counter = 100` whose value must survive DT_INIT) to a /tmp
# .so, compiles the dlopen-runner companion fixture, runs it,
# decodes exit code (99 = all green; 10..36 = specific sub-test
# failure with mapping in dlopen_runner.cyr's header).
#
# v5.9.17 cyrius-side replacement for tests/regression-shared.sh's
# inline-C harness. dynlib_open + dynlib_init + dynlib_sym +
# fncall0/2 covers what `dlopen` + `dlsym` + cast-and-call
# covered in the .sh, fully sovereign (no `cc` dependency).
fn _shared_dlopen_gate() {
    var label = "shared; + dlopen round-trip";
    if (file_exists(CC_PATH) != 1) {
        _p("  skip: ");
        _p(CC_PATH);
        println(" not present");
        _check(label, 0);
        return 0;
    }

    # Step 1: compile the shared-library fixture to /tmp/<fixed>.so.
    # Uses a fixed path because the runner has it baked in (avoids
    # arg passing in a one-shot fixture; dlopen_runner.cyr documents
    # the contract).
    var lib_src = _root_path("tests/fixtures/shared/lib.cyr");
    var so_path = "/tmp/cyrius_audit_shared.so";
    var rc1 = _self_host_pipe(lib_src, CC_PATH, so_path);
    if (rc1 != 0) {
        sys_unlink(so_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cc5 < lib.cyr → .so failed (rc=");
        print_num(rc1);
        println(")");
        _check(label, 1);
        return 1;
    }
    sys_chmod(so_path, 493);

    # Step 2: compile the runner.
    var runner_src = _root_path("tests/fixtures/shared/dlopen_runner.cyr");
    var runner_bin = _tmp_path("audit_dlopen_runner_");
    var rc2 = _self_host_pipe(runner_src, CC_PATH, runner_bin);
    if (rc2 != 0) {
        sys_unlink(so_path);
        sys_unlink(runner_bin);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cc5 compile of dlopen_runner.cyr failed (rc=");
        print_num(rc2);
        println(")");
        _check(label, 1);
        return 1;
    }
    sys_chmod(runner_bin, 493);

    # Step 3: run the runner, decode exit code.
    var ec = _exec_run_clean(runner_bin);
    sys_unlink(so_path);
    sys_unlink(runner_bin);

    if (ec == 99) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius `shared;` .so loadable via dynlib_open + dynlib_init; 4 exports + DT_INIT counter + state persistence");
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": dlopen runner exit=");
    print_num(ec);
    if (ec == 10) { _p(" — dynlib_bootstrap_cpu_features (no /lib64/ld-linux?)"); }
    if (ec == 11) { _p(" — dynlib_open returned 0"); }
    if (ec == 12) { _p(" — dynlib_init non-zero"); }
    if (ec == 21) { _p(" — dynlib_sym(\"add\") returned 0"); }
    if (ec == 22) { _p(" — dynlib_sym(\"greeting\") returned 0"); }
    if (ec == 23) { _p(" — dynlib_sym(\"get_counter\") returned 0"); }
    if (ec == 24) { _p(" — dynlib_sym(\"inc_counter\") returned 0"); }
    if (ec == 31) { _p(" — add(17, 25) != 42"); }
    if (ec == 32) { _p(" — greeting() string mismatch"); }
    if (ec == 33) { _p(" — get_counter() != 100 (DT_INIT didn't run)"); }
    if (ec == 34) { _p(" — inc_counter() first call != 101"); }
    if (ec == 35) { _p(" — inc_counter() second call != 102"); }
    if (ec == 36) { _p(" — get_counter() didn't persist"); }
    println("");
    _check(label, 1);
    return 1;
}

# Bespoke gate: inline-asm SSE m128 operand alignment regression
# (v5.5.21). Two fixture shapes — both must succeed:
#   A. with leading global   (sigil 2.9.0 workaround shape)
#   B. no leading global     (the shape that SIGSEGV'd pre-v5.5.21
#                             from PXOR xmm,m128 on a 8-aligned-
#                             not-16-aligned `var rk[240]`)
# Each fixture compiles with cc5, runs, and writes 16 bytes to
# stdout. If either writes != 16 bytes, fixup.cyr's
# 16-alignment-for-large-arrays prefix-sum pass regressed.
fn _inline_asm_discard_gate() {
    var label = "120B asm fn + standalone sys_write (sigil AES-NI shape)";
    if (file_exists(CC_PATH) != 1) {
        _p("  skip: ");
        _p(CC_PATH);
        println(" not present");
        _check(label, 0);
        return 0;
    }

    var fail = 0;
    var i = 0;
    while (i < 2) {
        var fix_path = 0;
        var shape_label = 0;
        if (i == 0) {
            fix_path = _root_path("tests/fixtures/inline_asm_discard/with_leading_global.cyr");
            shape_label = "shape A (with leading global)";
        }
        if (i == 1) {
            fix_path = _root_path("tests/fixtures/inline_asm_discard/no_leading_global.cyr");
            shape_label = "shape B (no leading global; pre-v5.5.21 SIGSEGV)";
        }
        var bin = _tmp_path("audit_inline_asm_");
        var rc = _self_host_pipe(fix_path, CC_PATH, bin);
        if (rc != 0) {
            sys_unlink(bin);
            _p("    ");
            _p(ANSI_RED);
            _p("FAIL");
            _p(ANSI_RESET);
            _p(": ");
            _p(shape_label);
            _p(" cc5 compile rc=");
            print_num(rc);
            println("");
            fail = fail + 1;
            i = i + 1;
            continue;
        }
        sys_chmod(bin, 493);

        var cap = 64;
        var buf = alloc(cap);
        var n = _exec_capture_clean(bin, buf, cap);
        sys_unlink(bin);
        if (n != 16) {
            _p("    ");
            _p(ANSI_RED);
            _p("FAIL");
            _p(ANSI_RESET);
            _p(": ");
            _p(shape_label);
            _p(" wrote ");
            print_num(n);
            println(" bytes (expected 16) — fixup.cyr 16-alignment regressed?");
            fail = fail + 1;
        }
        i = i + 1;
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": both shapes write 16 B (sigil 2.9.0 workaround + originally-SIGSEGV path; v5.5.21)");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: v5.7.35 stdlib syscall surface (agnosys-surfaced
# drm/luks/security additions). Inline-source compile + rc-switch
# shape — each kernel-side failure mode encodes as a unique exit
# code (1/2 = sys_getrandom; 7 = enum constant mismatch;
# 11/12 = random_bytes wrapper; 0 = pass). Test 3 (getdents64 +
# landlock_*) is wiring-only — fns referenced from an unreachable
# `if (0 != 0)` branch so cc5 emits the call sites (proving symbol
# resolution + arg shape) but the syscalls don't fire (avoids the
# CI seccomp-kill that retired this from the tcyr loop at v5.7.35
# ship — see the original .sh header for the long backstory).
fn _syscall_surface_v5735_gate() {
    var label = "stdlib syscall surface — getrandom + getdents64 + landlock + random_bytes (v5.7.35)";
    if (file_exists(CC_PATH) != 1) {
        _p("  skip: ");
        _p(CC_PATH);
        println(" not present");
        _check(label, 0);
        return 0;
    }
    var s_syscalls = _root_path("lib/syscalls.cyr");
    var s_random   = _root_path("lib/random.cyr");
    var s_security = _root_path("lib/security.cyr");
    var s_alloc    = _root_path("lib/alloc.cyr");
    if (file_exists(s_syscalls) != 1) { _p("  skip: lib/syscalls.cyr missing"); println(""); _check(label, 0); return 0; }
    if (file_exists(s_random)   != 1) { _p("  skip: lib/random.cyr missing");   println(""); _check(label, 0); return 0; }
    if (file_exists(s_security) != 1) { _p("  skip: lib/security.cyr missing"); println(""); _check(label, 0); return 0; }
    if (file_exists(s_alloc)    != 1) { _p("  skip: lib/alloc.cyr missing");    println(""); _check(label, 0); return 0; }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "include \"lib/alloc.cyr\"\n");
    str_builder_add_cstr(sb, "include \"lib/syscalls.cyr\"\n");
    str_builder_add_cstr(sb, "include \"lib/random.cyr\"\n");
    str_builder_add_cstr(sb, "include \"lib/security.cyr\"\n");
    str_builder_add_cstr(sb, "var buf1[32];\n");
    str_builder_add_cstr(sb, "var n1 = sys_getrandom(&buf1, 32, 0);\n");
    str_builder_add_cstr(sb, "if (n1 != 32) { syscall(60, 1); }\n");
    str_builder_add_cstr(sb, "var any1 = 0;\n");
    str_builder_add_cstr(sb, "var i1 = 0;\n");
    str_builder_add_cstr(sb, "while (i1 < 32) {\n");
    str_builder_add_cstr(sb, "    if (load8(&buf1 + i1) != 0) { any1 = 1; }\n");
    str_builder_add_cstr(sb, "    i1 = i1 + 1;\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "if (any1 != 1) { syscall(60, 2); }\n");
    str_builder_add_cstr(sb, "var buf2[64];\n");
    str_builder_add_cstr(sb, "var i2 = 0;\n");
    str_builder_add_cstr(sb, "while (i2 < 64) { store8(&buf2 + i2, 0); i2 = i2 + 1; }\n");
    str_builder_add_cstr(sb, "var n2 = random_bytes(&buf2, 64);\n");
    str_builder_add_cstr(sb, "if (n2 != 64) { syscall(60, 11); }\n");
    str_builder_add_cstr(sb, "var any2 = 0;\n");
    str_builder_add_cstr(sb, "i2 = 0;\n");
    str_builder_add_cstr(sb, "while (i2 < 64) {\n");
    str_builder_add_cstr(sb, "    if (load8(&buf2 + i2) != 0) { any2 = 1; }\n");
    str_builder_add_cstr(sb, "    i2 = i2 + 1;\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "if (any2 != 1) { syscall(60, 12); }\n");
    # Wiring-only references (unreachable branch; symbol resolution
    # required, runtime invocation skipped — CI seccomp guard).
    str_builder_add_cstr(sb, "if (0 != 0) {\n");
    str_builder_add_cstr(sb, "    var trash[64];\n");
    str_builder_add_cstr(sb, "    var _g  = sys_getdents64(0 - 1, &trash, 64);\n");
    str_builder_add_cstr(sb, "    var _l1 = sys_landlock_create_ruleset(0, 0, 1);\n");
    str_builder_add_cstr(sb, "    var _l2 = sys_landlock_add_rule(0 - 1, 1, 0, 0);\n");
    str_builder_add_cstr(sb, "    var _l3 = sys_landlock_restrict_self(0 - 1, 0);\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "if (LANDLOCK_ACCESS_FS_EXECUTE    != 1)    { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "if (LANDLOCK_ACCESS_FS_WRITE_FILE != 2)    { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "if (LANDLOCK_ACCESS_FS_READ_FILE  != 4)    { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "if (LANDLOCK_ACCESS_FS_READ_DIR   != 8)    { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "if (LANDLOCK_ACCESS_FS_MAKE_SYM   != 4096) { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "if (LANDLOCK_RULE_PATH_BENEATH    != 1)    { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "if (GRND_NONBLOCK                 != 1)    { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "if (GRND_RANDOM                   != 2)    { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "if (GRND_INSECURE                 != 4)    { syscall(60, 7); }\n");
    str_builder_add_cstr(sb, "syscall(60, 0);\n");

    var src_path = _tmp_path("audit_syscall_surface_");
    var src = str_builder_build(sb);
    if (_write_file(src_path, str_data(src)) <= 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cannot write tmp source");
        sys_unlink(src_path);
        _check(label, 1);
        return 1;
    }

    var ec = _compile_run_get_exit(src_path);
    sys_unlink(src_path);

    if (ec == 0) {
        _check(label, 0);
        return 0;
    }
    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": ");
    if (ec == 1)  { println("sys_getrandom returned wrong byte count"); }
    if (ec == 2)  { println("sys_getrandom buffer all-zero (CSPRNG?)"); }
    if (ec == 7)  { println("enum constant mismatch (security.cyr or random.cyr)"); }
    if (ec == 11) { println("random_bytes returned wrong count"); }
    if (ec == 12) { println("random_bytes buffer all-zero"); }
    if (ec == 0 - 1) { println("compile or fork issue"); }
    var known = 0;
    if (ec == 1)  { known = 1; }
    if (ec == 2)  { known = 1; }
    if (ec == 7)  { known = 1; }
    if (ec == 11) { known = 1; }
    if (ec == 12) { known = 1; }
    if (ec == 0 - 1) { known = 1; }
    if (known == 0) {
        _p("unexpected exit code ");
        print_num(ec);
        println(" (segfault or sandbox kill)");
    }
    _check(label, 1);
    return 1;
}

# Bespoke gate: sit `status` + `fsck` on a 100-commit fixture
# (v5.6.35 pin — sankoch 2.0.3 deflate roundtrip fix). Skips
# cleanly if `../sit` isn't checked out or `../sit/build/sit`
# isn't built (sit is a downstream consumer of cyrius+sankoch,
# not always present). Override location with SIT_DIR=...
fn _sit_status_gate() {
    var label = "sit fsck on 100-commit fixture reports 0 bad (pin v5.6.35; sankoch deflate)";
    var sit_dir = getenv("SIT_DIR");
    if (sit_dir == 0) { sit_dir = _root_path("../sit"); }

    var sit_bin_sb = str_builder_new();
    str_builder_add_cstr(sit_bin_sb, sit_dir);
    str_builder_add_cstr(sit_bin_sb, "/build/sit");
    var sit_bin = str_data(str_builder_build(sit_bin_sb));

    if (file_exists(sit_bin) != 1) {
        _p("  skip: ");
        _p(sit_bin);
        println(" not built");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_sit_");
    if (sys_mkdir(scratch, 493) < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cannot create scratch dir");
        _check(label, 1);
        return 1;
    }

    var fail = 0;

    # sit init in scratch.
    var ec = _exec_in_dir3(scratch, sit_bin, "init", 0, 0, 0);
    if (ec != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": sit init exit ");
        print_num(ec);
        println("");
        fail = fail + 1;
    }

    # 100 add+commit iterations.
    var i = 0;
    while (i < 100) {
        if (fail != 0) { i = 100; }
        else {
            # Write fN.txt with content "file N content\n".
            var fname_sb = str_builder_new();
            str_builder_add_cstr(fname_sb, scratch);
            str_builder_add_cstr(fname_sb, "/f");
            str_builder_add_int(fname_sb, i);
            str_builder_add_cstr(fname_sb, ".txt");
            var fname = str_data(str_builder_build(fname_sb));

            var content_sb = str_builder_new();
            str_builder_add_cstr(content_sb, "file ");
            str_builder_add_int(content_sb, i);
            str_builder_add_cstr(content_sb, " content\n");
            var content = str_data(str_builder_build(content_sb));
            _write_file(fname, content);

            # sit add fN.txt — relative path from cwd=scratch.
            var rel_sb = str_builder_new();
            str_builder_add_cstr(rel_sb, "f");
            str_builder_add_int(rel_sb, i);
            str_builder_add_cstr(rel_sb, ".txt");
            var rel = str_data(str_builder_build(rel_sb));

            var ec_a = _exec_in_dir3(scratch, sit_bin, "add", rel, 0, 0);
            if (ec_a != 0) {
                _p("  ");
                _p(ANSI_RED);
                _p("FAIL");
                _p(ANSI_RESET);
                _p(": sit add f");
                print_num(i);
                _p(".txt exit ");
                print_num(ec_a);
                println("");
                fail = fail + 1;
            } else {
                # sit commit -m cN.
                var cmsg_sb = str_builder_new();
                str_builder_add_cstr(cmsg_sb, "c");
                str_builder_add_int(cmsg_sb, i);
                var cmsg = str_data(str_builder_build(cmsg_sb));

                var ec_c = _exec_in_dir3(scratch, sit_bin, "commit", "-m", cmsg, 0);
                if (ec_c != 0) {
                    _p("  ");
                    _p(ANSI_RED);
                    _p("FAIL");
                    _p(ANSI_RESET);
                    _p(": sit commit c");
                    print_num(i);
                    _p(" exit ");
                    print_num(ec_c);
                    println("");
                    fail = fail + 1;
                }
            }
            i = i + 1;
        }
    }

    if (fail == 0) {
        # sit fsck — capture output, must contain "0 bad".
        var fsck_out = _tmp_path("audit_sit_fsck_");
        var ec_f = _exec_in_dir3(scratch, sit_bin, "fsck", 0, 0, fsck_out);
        # fsck may exit non-zero on bad objects, but we use the
        # output text to determine pass/fail (matches .sh shape).
        if (_file_contains_substr(fsck_out, "0 bad") != 1) {
            _p("  ");
            _p(ANSI_RED);
            _p("FAIL");
            _p(ANSI_RESET);
            _p(": fsck output didn't report '0 bad' (exit ");
            print_num(ec_f);
            println(")");
            fail = fail + 1;
        }
        sys_unlink(fsck_out);

        # sit status — must exit 0.
        var ec_s = _exec_in_dir3(scratch, sit_bin, "status", 0, 0, 0);
        if (ec_s != 0) {
            _p("  ");
            _p(ANSI_RED);
            _p("FAIL");
            _p(ANSI_RESET);
            _p(": sit status exit ");
            print_num(ec_s);
            println("");
            fail = fail + 1;
        }
    }

    # Cleanup scratch dir tree (sit creates a .sit subdir + 100
    # f*.txt files). Fork /bin/rm -rf — simpler than reimplementing
    # recursive descent; the scratch path is dispatcher-owned so
    # there's no path-injection surface to worry about.
    _exec_in_dir3("/tmp", "/bin/rm", "-rf", scratch, 0, 0);

    _check(label, fail);
    return fail;
}

# Bespoke gate: cyrfmt --write / -w in-place rewrite + idempotent
# mtime (v5.5.22). Seven sub-cases against an ugly fixture and
# its canonical formatted twin. Test 6 (mtime idempotency) uses
# the cross-arch STAT_MTIME / STAT_MTIME_NSEC offsets — read
# nanosecond mtime after a first --write, run --write again on
# the now-clean file, assert the (sec, nsec) pair didn't move.
# Catches regressions where --write's "no-op" path actually
# rewrites the file (which would advance mtime even on bytewise-
# equal output).
fn _cyrfmt_write_gate() {
    var label = "cyrfmt --write / -w in-place rewrite + idempotent mtime";
    var cyrfmt_bin = _root_path("build/cyrfmt");
    if (file_exists(cyrfmt_bin) != 1) {
        _p("  skip: ");
        _p(cyrfmt_bin);
        println(" not present");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_cyrfmt_w_");
    if (sys_mkdir(scratch, 493) < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cannot create scratch dir");
        _check(label, 1);
        return 1;
    }

    # Fixture paths.
    var ugly_sb = str_builder_new();
    str_builder_add_cstr(ugly_sb, scratch);
    str_builder_add_cstr(ugly_sb, "/ugly.cyr");
    var ugly_path = str_data(str_builder_build(ugly_sb));

    var expected_sb = str_builder_new();
    str_builder_add_cstr(expected_sb, scratch);
    str_builder_add_cstr(expected_sb, "/expected.cyr");
    var expected_path = str_data(str_builder_build(expected_sb));

    var target_sb = str_builder_new();
    str_builder_add_cstr(target_sb, scratch);
    str_builder_add_cstr(target_sb, "/target.cyr");
    var target_path = str_data(str_builder_build(target_sb));

    var short_sb = str_builder_new();
    str_builder_add_cstr(short_sb, scratch);
    str_builder_add_cstr(short_sb, "/short.cyr");
    var short_path = str_data(str_builder_build(short_sb));

    var stdout_sb = str_builder_new();
    str_builder_add_cstr(stdout_sb, scratch);
    str_builder_add_cstr(stdout_sb, "/stdout_src.cyr");
    var stdout_src_path = str_data(str_builder_build(stdout_sb));

    var stdout_out_sb = str_builder_new();
    str_builder_add_cstr(stdout_out_sb, scratch);
    str_builder_add_cstr(stdout_out_sb, "/stdout.out");
    var stdout_out_path = str_data(str_builder_build(stdout_out_sb));

    # Ugly source — leading tabs, stray indent, mixed widths.
    var ugly_src = "fn foo() {\n  var x = 1;\n    var y = 2;\n   return x + y;\n}\n";
    # Canonical formatted output (4-space indent, consistent).
    var expected_src = "fn foo() {\n    var x = 1;\n    var y = 2;\n    return x + y;\n}\n";

    _write_file(ugly_path, ugly_src);
    _write_file(expected_path, expected_src);

    var fail = 0;

    # Test 1: --check on ugly returns rc=1.
    var ec_t1 = _exec_in_dir3(scratch, cyrfmt_bin, "--check", ugly_path, 0, 0);
    if (ec_t1 != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test1 --check on ugly rc=");
        print_num(ec_t1);
        println(" (expected 1)");
        fail = fail + 1;
    }

    # Test 3: --write reformats target.cyr in place; result == expected.
    _write_file(target_path, ugly_src);
    var ec_t3 = _exec_in_dir3(scratch, cyrfmt_bin, "--write", target_path, 0, 0);
    if (ec_t3 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test3 --write rc=");
        print_num(ec_t3);
        println("");
        fail = fail + 1;
    } else { if (_files_identical(target_path, expected_path) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test3 --write produced unexpected formatted output");
            fail = fail + 1;
        } }

    # Test 4: --check on the rewritten file returns rc=0.
    var ec_t4 = _exec_in_dir3(scratch, cyrfmt_bin, "--check", target_path, 0, 0);
    if (ec_t4 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test4 --check post-rewrite rc=");
        print_num(ec_t4);
        println(" (expected 0)");
        fail = fail + 1;
    }

    # Test 5: -w short-form behaves identically.
    _write_file(short_path, ugly_src);
    var ec_t5 = _exec_in_dir3(scratch, cyrfmt_bin, "-w", short_path, 0, 0);
    if (ec_t5 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test5 -w rc=");
        print_num(ec_t5);
        println("");
        fail = fail + 1;
    } else { if (_files_identical(short_path, expected_path) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test5 -w produced unexpected formatted output");
            fail = fail + 1;
        } }

    # Test 6: mtime idempotency on already-clean target. Read mtime
    # (sec, nsec), run --write again, read mtime again. If --write
    # rewrote the (now-canonical) file unnecessarily, mtime would
    # advance — STAT_MTIME_NSEC at offset 96 catches sub-second drift.
    var stat_buf1 = alloc(STAT_BUFSZ);
    var stat_buf2 = alloc(STAT_BUFSZ);
    if (sys_stat(target_path, stat_buf1) >= 0) {
        var sec1 = load64(stat_buf1 + STAT_MTIME);
        var nsec1 = load64(stat_buf1 + STAT_MTIME_NSEC);
        _exec_in_dir3(scratch, cyrfmt_bin, "--write", target_path, 0, 0);
        if (sys_stat(target_path, stat_buf2) >= 0) {
            var sec2 = load64(stat_buf2 + STAT_MTIME);
            var nsec2 = load64(stat_buf2 + STAT_MTIME_NSEC);
            if (sec1 != sec2) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": test6 --write touched mtime on already-clean file (sec drift)");
                fail = fail + 1;
            } else { if (nsec1 != nsec2) {
                    _p("    ");
                    _p(ANSI_RED);
                    _p("case-FAIL");
                    _p(ANSI_RESET);
                    println(": test6 --write touched mtime on already-clean file (nsec drift)");
                    fail = fail + 1;
                } }
        }
    }

    # Test 7: default (no flag) writes to stdout, not to the file.
    _write_file(stdout_src_path, ugly_src);
    var stdout_size_before = _file_size(stdout_src_path);
    var ec_t7 = _exec_in_dir3(scratch, cyrfmt_bin, stdout_src_path, 0, 0, stdout_out_path);
    if (ec_t7 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test7 default-mode rc=");
        print_num(ec_t7);
        println("");
        fail = fail + 1;
    } else { if (_files_identical(stdout_out_path, expected_path) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test7 default-mode stdout output didn't match expected");
            fail = fail + 1;
        } }
    # Test 7b: stdout-mode must NOT modify the source file.
    var stdout_size_after = _file_size(stdout_src_path);
    if (stdout_size_before != stdout_size_after) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test7b default-mode modified the source file");
        fail = fail + 1;
    }

    # Cleanup.
    _exec_in_dir3("/tmp", "/bin/rm", "-rf", scratch, 0, 0);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": 7 sub-cases (--check / --write / -w / mtime / default-stdout)");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: `install.sh --refresh-only` re-links
# ~/.cyrius/bin → versions/$VERSION/bin (v5.7.22 H3 fix).
# Builds two fake "version" snapshots under a TMPDIR-isolated
# CYRIUS_HOME, points the bin/lib symlinks at the OLD version,
# runs install.sh --refresh-only (against the current repo's
# VERSION), and asserts the symlinks repoint at the new
# version's snapshot. Uses _exec_in_dir3_env to inject
# CYRIUS_HOME=fake without polluting the dispatcher's env.
fn _install_shim_symlink_gate() {
    var label = "install.sh --refresh-only re-links ~/.cyrius/bin to current version (v5.7.22; H3)";
    var install_sh = _root_path("scripts/install.sh");
    if (file_exists(install_sh) != 1) {
        _p("  skip: ");
        _p(install_sh);
        println(" not present");
        _check(label, 0);
        return 0;
    }
    var version_path = _root_path("VERSION");
    if (file_exists(version_path) != 1) {
        _p("  skip: VERSION missing (refresh-only needs a repo context)");
        println("");
        _check(label, 0);
        return 0;
    }

    # Read current VERSION (trim trailing whitespace).
    var ver_buf = alloc(64);
    var ver_n = file_read_all(version_path, ver_buf, 63);
    if (ver_n <= 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cannot read VERSION");
        _check(label, 1);
        return 1;
    }
    while (ver_n > 0) {
        var c = load8(ver_buf + ver_n - 1);
        if (c == 10) { ver_n = ver_n - 1; }
        else { if (c == 13) { ver_n = ver_n - 1; }
            else { if (c == 32) { ver_n = ver_n - 1; }
                else { c = 0 - 1; ver_n = ver_n + 1; ver_n = ver_n - 1; break; } } }
    }
    store8(ver_buf + ver_n, 0);
    var current_ver = ver_buf;

    var fake_home = _tmp_path("audit_install_shim_");
    if (sys_mkdir(fake_home, 493) < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cannot create fake CYRIUS_HOME");
        _check(label, 1);
        return 1;
    }

    var fail = 0;

    # Build $FAKE/versions and the OLD-version snapshot.
    var versions_sb = str_builder_new();
    str_builder_add_cstr(versions_sb, fake_home);
    str_builder_add_cstr(versions_sb, "/versions");
    sys_mkdir(str_data(str_builder_build(versions_sb)), 493);

    var old_version = "0.0.1-test";
    var old_dir_sb = str_builder_new();
    str_builder_add_cstr(old_dir_sb, fake_home);
    str_builder_add_cstr(old_dir_sb, "/versions/");
    str_builder_add_cstr(old_dir_sb, old_version);
    var old_dir = str_data(str_builder_build(old_dir_sb));
    sys_mkdir(old_dir, 493);

    var old_bin_sb = str_builder_new();
    str_builder_add_cstr(old_bin_sb, old_dir);
    str_builder_add_cstr(old_bin_sb, "/bin");
    var old_bin = str_data(str_builder_build(old_bin_sb));
    sys_mkdir(old_bin, 493);

    var old_lib_sb = str_builder_new();
    str_builder_add_cstr(old_lib_sb, old_dir);
    str_builder_add_cstr(old_lib_sb, "/lib");
    var old_lib = str_data(str_builder_build(old_lib_sb));
    sys_mkdir(old_lib, 493);

    # Stale shell-script "cyrius" inside the OLD bin/.
    var old_cyrius_sb = str_builder_new();
    str_builder_add_cstr(old_cyrius_sb, old_bin);
    str_builder_add_cstr(old_cyrius_sb, "/cyrius");
    var old_cyrius = str_data(str_builder_build(old_cyrius_sb));
    _write_file(old_cyrius, "#!/bin/sh\necho stale-cyrius\n");
    sys_chmod(old_cyrius, 493);

    # ~/.cyrius/current and per-version VERSION files.
    var current_file_sb = str_builder_new();
    str_builder_add_cstr(current_file_sb, fake_home);
    str_builder_add_cstr(current_file_sb, "/current");
    _write_file(str_data(str_builder_build(current_file_sb)), old_version);

    var old_version_file_sb = str_builder_new();
    str_builder_add_cstr(old_version_file_sb, old_dir);
    str_builder_add_cstr(old_version_file_sb, "/VERSION");
    _write_file(str_data(str_builder_build(old_version_file_sb)), old_version);

    # Point $FAKE/bin → OLD/bin and $FAKE/lib → OLD/lib (stale state).
    var fake_bin_sb = str_builder_new();
    str_builder_add_cstr(fake_bin_sb, fake_home);
    str_builder_add_cstr(fake_bin_sb, "/bin");
    var fake_bin = str_data(str_builder_build(fake_bin_sb));

    var fake_lib_sb = str_builder_new();
    str_builder_add_cstr(fake_lib_sb, fake_home);
    str_builder_add_cstr(fake_lib_sb, "/lib");
    var fake_lib = str_data(str_builder_build(fake_lib_sb));

    sys_symlink(old_bin, fake_bin);
    sys_symlink(old_lib, fake_lib);

    # Sanity: fake_bin should resolve to old_bin pre-refresh.
    var rl_buf = alloc(4096);
    var rl_n = sys_readlink(fake_bin, rl_buf, 4095);
    if (rl_n > 0) { store8(rl_buf + rl_n, 0); }
    if (rl_n <= 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": pre-state setup — fake_bin not a symlink");
        fail = fail + 1;
    }

    # Run install.sh --refresh-only with CYRIUS_HOME=fake_home.
    # CWD = repo root (install.sh reads ./VERSION + ./build/* etc).
    var env_extras = vec_new();
    var env_pair_sb = str_builder_new();
    str_builder_add_cstr(env_pair_sb, "CYRIUS_HOME=");
    str_builder_add_cstr(env_pair_sb, fake_home);
    vec_push(env_extras, str_data(str_builder_build(env_pair_sb)));

    var refresh_out = _tmp_path("audit_install_shim_out_");
    var ec_refresh = _exec_in_dir3_env(ROOT_PATH, "/bin/sh", install_sh, "--refresh-only", 0, env_extras, refresh_out);
    if (ec_refresh != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": install.sh --refresh-only exit ");
        print_num(ec_refresh);
        println("");
        fail = fail + 1;
    }
    sys_unlink(refresh_out);

    # Post-refresh: fake_bin must point at versions/$current_ver/bin.
    var expected_bin_sb = str_builder_new();
    str_builder_add_cstr(expected_bin_sb, fake_home);
    str_builder_add_cstr(expected_bin_sb, "/versions/");
    str_builder_add_cstr(expected_bin_sb, current_ver);
    str_builder_add_cstr(expected_bin_sb, "/bin");
    var expected_bin = str_data(str_builder_build(expected_bin_sb));

    var actual_bin_buf = alloc(4096);
    var ab_n = sys_readlink(fake_bin, actual_bin_buf, 4095);
    if (ab_n <= 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": fake_bin readlink failed post-refresh");
        fail = fail + 1;
    } else {
        store8(actual_bin_buf + ab_n, 0);
        if (streq(actual_bin_buf, expected_bin) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": fake_bin not re-linked. expected ");
            _p(expected_bin);
            _p(" actual ");
            _p(actual_bin_buf);
            println("");
            fail = fail + 1;
        }
    }

    # Same for lib/.
    var expected_lib_sb = str_builder_new();
    str_builder_add_cstr(expected_lib_sb, fake_home);
    str_builder_add_cstr(expected_lib_sb, "/versions/");
    str_builder_add_cstr(expected_lib_sb, current_ver);
    str_builder_add_cstr(expected_lib_sb, "/lib");
    var expected_lib = str_data(str_builder_build(expected_lib_sb));

    var actual_lib_buf = alloc(4096);
    var al_n = sys_readlink(fake_lib, actual_lib_buf, 4095);
    if (al_n <= 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": fake_lib readlink failed post-refresh");
        fail = fail + 1;
    } else {
        store8(actual_lib_buf + al_n, 0);
        if (streq(actual_lib_buf, expected_lib) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": fake_lib not re-linked. expected ");
            _p(expected_lib);
            _p(" actual ");
            _p(actual_lib_buf);
            println("");
            fail = fail + 1;
        }
    }

    # Cleanup.
    _exec_in_dir3("/tmp", "/bin/rm", "-rf", fake_home, 0, 0);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": refresh-only re-links bin + lib symlinks at $CYRIUS_HOME (TMPDIR-isolated)");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: `cyrius capacity` subcommand (4.8.3 series; v5.7.38
# Python3-removed). 7 sub-cases over the `cyrius` shim wrapper:
# default-stats output keys; --check on small (rc=0 + "ok" message);
# --check on 3500-fn synthetic source (rc=1 + ">=85%" diagnostic);
# direct cc5 object-mode compile of the 3500-fn source (latent
# fnc>2048 fix from alpha4); --json shape (fn_table key present);
# --json on big shows fn_table.pct >= 85; missing-entry-point error
# path runs from an empty cwd and surfaces "no file given".
fn _capacity_gate() {
    var label = "cyrius capacity (default / --check / --json / fnc>2048)";
    var cyrius_shim = _root_path("scripts/cyrius");
    if (file_exists(cyrius_shim) != 1) {
        _p("  skip: ");
        _p(cyrius_shim);
        println(" not present");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_capacity_");
    if (sys_mkdir(scratch, 493) < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cannot create scratch dir");
        _check(label, 1);
        return 1;
    }

    var fail = 0;

    # Build small.cyr fixture.
    var small_sb = str_builder_new();
    str_builder_add_cstr(small_sb, scratch);
    str_builder_add_cstr(small_sb, "/small.cyr");
    var small_path = str_data(str_builder_build(small_sb));
    _write_file(small_path, "fn main() { return 42; }\n");

    # Build big.cyr — 3500-fn synthetic stress source matching the
    # `object;` + `fn fN() { return N; }` shape the .sh used.
    var big_sb_path = str_builder_new();
    str_builder_add_cstr(big_sb_path, scratch);
    str_builder_add_cstr(big_sb_path, "/big.cyr");
    var big_path = str_data(str_builder_build(big_sb_path));
    var big = str_builder_new();
    str_builder_add_cstr(big, "object;\n");
    var ix = 0;
    while (ix < 3500) {
        str_builder_add_cstr(big, "fn f");
        str_builder_add_int(big, ix);
        str_builder_add_cstr(big, "() { return ");
        str_builder_add_int(big, ix);
        str_builder_add_cstr(big, "; }\n");
        ix = ix + 1;
    }
    _write_file(big_path, str_data(str_builder_build(big)));

    var out1 = _tmp_path("audit_capacity_out1_");
    var out2 = _tmp_path("audit_capacity_out2_");
    var out3 = _tmp_path("audit_capacity_out3_");
    var out5 = _tmp_path("audit_capacity_out5_");
    var out6 = _tmp_path("audit_capacity_out6_");
    var out7 = _tmp_path("audit_capacity_out7_");

    # Test 1: default mode prints all 6 stat keys.
    _exec_in_dir3(scratch, cyrius_shim, "capacity", small_path, 0, out1);
    var i_keys = 0;
    var keys_missing = 0;
    while (i_keys < 6) {
        var key = 0;
        if (i_keys == 0) { key = "  fn_table:"; }
        if (i_keys == 1) { key = "  identifiers:"; }
        if (i_keys == 2) { key = "  var_table:"; }
        if (i_keys == 3) { key = "  fixup_table:"; }
        if (i_keys == 4) { key = "  string_data:"; }
        if (i_keys == 5) { key = "  code_size:"; }
        if (_file_contains_substr(out1, key) != 1) {
            keys_missing = keys_missing + 1;
        }
        i_keys = i_keys + 1;
    }
    if (keys_missing != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test1 default-mode missing ");
        print_num(keys_missing);
        println(" of 6 stat keys");
        fail = fail + 1;
    }

    # Test 2: --check on small file rc=0 + "ok (all caps under 85%)".
    var ec_t2 = _exec_in_dir3(scratch, cyrius_shim, "capacity", "--check", small_path, out2);
    if (ec_t2 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test2 --check small rc=");
        print_num(ec_t2);
        println(" (expected 0)");
        fail = fail + 1;
    }
    if (_file_contains_substr(out2, "ok (all caps under 85%)") != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test2 --check small missing 'ok' message");
        fail = fail + 1;
    }

    # Test 3: --check on 3500-fn big.cyr rc=1 + "table(s) at >=85%".
    var ec_t3 = _exec_in_dir3(scratch, cyrius_shim, "capacity", "--check", big_path, out3);
    if (ec_t3 != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test3 --check big rc=");
        print_num(ec_t3);
        println(" (expected 1)");
        fail = fail + 1;
    }
    if (_file_contains_substr(out3, "table(s) at >=85%") != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test3 --check big missing 'table(s) at >=85%' diagnostic");
        fail = fail + 1;
    }

    # Test 4: 3500-fn source compiles object-mode clean (alpha4
    # fnc>2048 fix). Uses _self_host_pipe directly for stdin pipe.
    var big_obj = _tmp_path("audit_capacity_bigo_");
    var ec_t4 = _self_host_pipe(big_path, CC_PATH, big_obj);
    if (ec_t4 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test4 cc5 compile of 3500-fn source rc=");
        print_num(ec_t4);
        println(" (regression in fnc>2048 fix)");
        fail = fail + 1;
    } else {
        var sz = _file_size(big_obj);
        if (sz < 100000) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": test4 3500-fn binary suspiciously small (");
            print_num(sz);
            println(" B)");
            fail = fail + 1;
        }
    }
    sys_unlink(big_obj);

    # Test 5: --json output contains fn_table key.
    _exec_in_dir3(scratch, cyrius_shim, "capacity", "--json", small_path, out5);
    if (_file_contains_substr(out5, "\"fn_table\":") != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test5 --json missing fn_table key");
        fail = fail + 1;
    }

    # Test 6: --json on big.cyr — basic shape check; the .sh used
    # jq for pct>=85 verification, which is optional here. Keeping
    # the smoke check that --json on big returns non-empty + has
    # the fn_table key (the pct>=85 implication is already covered
    # by Test 3's --check exit-1 path).
    _exec_in_dir3(scratch, cyrius_shim, "capacity", "--json", big_path, out6);
    if (_file_contains_substr(out6, "\"fn_table\":") != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test6 --json on big missing fn_table key");
        fail = fail + 1;
    }

    # Test 7: empty cwd + no entry point arg → error with "no file
    # given" diagnostic. Use a fresh empty scratch sub-dir.
    var empty_sb = str_builder_new();
    str_builder_add_cstr(empty_sb, scratch);
    str_builder_add_cstr(empty_sb, "/empty");
    var empty_dir = str_data(str_builder_build(empty_sb));
    sys_mkdir(empty_dir, 493);
    var ec_t7 = _exec_in_dir3(empty_dir, cyrius_shim, "capacity", 0, 0, out7);
    if (ec_t7 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test7 capacity-with-no-args expected non-zero exit, got 0");
        fail = fail + 1;
    }
    if (_file_contains_substr(out7, "no file given") != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test7 missing 'no file given' diagnostic");
        fail = fail + 1;
    }

    # Cleanup output files + scratch.
    sys_unlink(out1);
    sys_unlink(out2);
    sys_unlink(out3);
    sys_unlink(out5);
    sys_unlink(out6);
    sys_unlink(out7);
    _exec_in_dir3("/tmp", "/bin/rm", "-rf", scratch, 0, 0);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": 7 sub-cases (default / --check ok+fail / 3500-fn stress / --json / no-args)");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: cyrius api-surface snapshot diff (v5.7.33; auto-
# build at v5.8.44). Three sub-cases:
#   1. Run with --snapshot=docs/api-surface.snapshot — committed
#      surface matches current; rc must be 0.
#   2. Synthetic snapshot copy with `zzz_synth::synthetic_fn/0`
#      appended (sorts after every real entry, preserving the
#      tool's lockstep merge invariant) — must report BREAKING
#      (rc=1) and the synthetic name must appear in stdout.
#   3. Synthetic snapshot copy with the FIRST line dropped — the
#      missing entry is now an "addition" in current; rc must be
#      0 and stdout must contain "1 added since snapshot".
fn _api_surface_gate() {
    var label = "cyrius api-surface diff: snapshot match + add/remove detection (v5.7.33; auto-build at v5.8.44)";
    var tool = _root_path("build/cyrius_api_surface");
    var snapshot = _root_path("docs/api-surface.snapshot");
    if (file_exists(tool) != 1) {
        _p("  skip: ");
        _p(tool);
        println(" not built");
        _check(label, 0);
        return 0;
    }
    if (file_exists(snapshot) != 1) {
        _p("  skip: ");
        _p(snapshot);
        println(" missing — run 'cyrius api-surface --update' first");
        _check(label, 0);
        return 0;
    }

    var fail = 0;

    # Test 1: committed snapshot matches current.
    var sb1 = str_builder_new();
    str_builder_add_cstr(sb1, "--snapshot=");
    str_builder_add_cstr(sb1, snapshot);
    var arg1 = str_data(str_builder_build(sb1));
    var out1 = _tmp_path("audit_api1_");
    var ec1 = _exec_in_dir(ROOT_PATH, tool, arg1, out1);
    if (ec1 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test1 committed snapshot drift detected (rc=");
        print_num(ec1);
        println(")");
        fail = fail + 1;
    }
    sys_unlink(out1);

    # Test 2: snapshot + extra synthetic entry → BREAKING.
    var snap2 = _tmp_path("audit_api_snap2_");
    var snap_sz = _file_size(snapshot);
    if (snap_sz <= 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": snapshot file_size <= 0");
        fail = fail + 1;
    } else {
        var snap_buf = alloc(snap_sz + 64);
        var got = file_read_all(snapshot, snap_buf, snap_sz);
        # Append synthetic entry (sorts after `yukti::*`).
        var extra = "zzz_synth::synthetic_fn/0\n";
        var elen = strlen(extra);
        var ej = 0;
        while (ej < elen) { store8(snap_buf + got + ej, load8(extra + ej)); ej = ej + 1; }
        file_write_all(snap2, snap_buf, got + elen);

        var sb2 = str_builder_new();
        str_builder_add_cstr(sb2, "--snapshot=");
        str_builder_add_cstr(sb2, snap2);
        var arg2 = str_data(str_builder_build(sb2));
        var out2 = _tmp_path("audit_api2_");
        var ec2 = _exec_in_dir(ROOT_PATH, tool, arg2, out2);
        if (ec2 != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": test2 synthetic removal not flagged (rc=");
            print_num(ec2);
            println(", expected 1)");
            fail = fail + 1;
        }
        if (_file_contains_substr(out2, "zzz_synth::synthetic_fn") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test2 synthetic name not in BREAKING report");
            fail = fail + 1;
        }
        sys_unlink(out2);
        sys_unlink(snap2);
    }

    # Test 3: snapshot with first line dropped → +1 addition.
    var snap3 = _tmp_path("audit_api_snap3_");
    if (snap_sz > 0) {
        var sb3_buf = alloc(snap_sz + 4);
        var got3 = file_read_all(snapshot, sb3_buf, snap_sz);
        # Locate the first \n; write everything after it.
        var nl = 0;
        while (nl < got3) {
            if (load8(sb3_buf + nl) == 10) { break; }
            nl = nl + 1;
        }
        if (nl < got3) {
            file_write_all(snap3, sb3_buf + nl + 1, got3 - nl - 1);
        }

        var sb3 = str_builder_new();
        str_builder_add_cstr(sb3, "--snapshot=");
        str_builder_add_cstr(sb3, snap3);
        var arg3 = str_data(str_builder_build(sb3));
        var out3 = _tmp_path("audit_api3_");
        var ec3 = _exec_in_dir(ROOT_PATH, tool, arg3, out3);
        if (ec3 != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": test3 synthetic addition flagged as breaking (rc=");
            print_num(ec3);
            println(", expected 0)");
            fail = fail + 1;
        }
        if (_file_contains_substr(out3, "1 added since snapshot") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test3 addition count not reported as 1");
            fail = fail + 1;
        }
        sys_unlink(out3);
        sys_unlink(snap3);
    }

    if (fail == 0) {
        var n_entries = 0;
        var c_buf = alloc(snap_sz + 1);
        var c_got = file_read_all(snapshot, c_buf, snap_sz);
        var ci = 0;
        while (ci < c_got) {
            if (load8(c_buf + ci) == 10) { n_entries = n_entries + 1; }
            ci = ci + 1;
        }
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": cyrius api-surface diff (snapshot ");
        print_num(n_entries);
        println(" entries; +1 added detected; -1 removed detected) (v5.7.33)");
    }
    _check(label, fail);
    return fail;
}

# Helper: mkdir -p semantics. Creates parent dirs if needed; tolerates
# already-existing dirs. Used by gates that synthesize multi-level scratch
# layouts (e.g. case2 of deps-transitive needs A/dist + B/dist + C/dist
# + D/dist under the same scratch root).
fn _mkdir_p(path) {
    var plen = strlen(path);
    var buf = alloc(plen + 1);
    var i = 0;
    while (i < plen) { store8(buf + i, load8(path + i)); i = i + 1; }
    store8(buf + plen, 0);
    var pos = 1;
    while (pos <= plen) {
        if (pos == plen) {
            sys_mkdir(buf, 493);
        } else { if (load8(buf + pos) == 47) {
                store8(buf + pos, 0);
                sys_mkdir(buf, 493);
                store8(buf + pos, 47);
            } }
        pos = pos + 1;
    }
    return 0;
}

# Bespoke gate: `cyrius fuzz` runs the manifest-deps auto-prepend
# codepath (parity with cmd_test / cmd_bench / cmd_build). Pinned
# v5.7.21. Two cases:
#   1. cyrius.cyml [deps] stdlib + fuzz/X.fcyr uses strlen → cyrius
#      fuzz exits 0 + stdout summarizes "1 passed, 0 failed".
#   2. No cyrius.cyml at all + fuzz/X.fcyr uses syscalls only →
#      cyrius fuzz exits 0 (no auto-prepend; no breakage).
fn _fuzz_deps_prepend_gate() {
    var label = "cyrius fuzz manifest-deps auto-prepend parity with test/bench (v5.7.21)";
    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built");
        println("");
        _check(label, 0);
        return 0;
    }
    var fail = 0;

    # Case 1: manifest declares stdlib deps; .fcyr uses strlen.
    var sc1 = _tmp_path("audit_fuzz_deps1_");
    _mkdir_p(sc1);
    var sb_fuzz_dir1 = str_builder_new();
    str_builder_add_cstr(sb_fuzz_dir1, sc1);
    str_builder_add_cstr(sb_fuzz_dir1, "/fuzz");
    var fuzz_dir1 = str_data(str_builder_build(sb_fuzz_dir1));
    sys_mkdir(fuzz_dir1, 493);
    var sb_cyml1 = str_builder_new();
    str_builder_add_cstr(sb_cyml1, sc1);
    str_builder_add_cstr(sb_cyml1, "/cyrius.cyml");
    _write_file(str_data(str_builder_build(sb_cyml1)),
        "[package]\nname = \"fz1\"\nversion = \"0.1.0\"\nlicense = \"GPL-3.0-only\"\nlanguage = \"cyrius\"\n\n[deps]\nstdlib = [\"string\", \"syscalls\"]\n");
    var sb_fcyr1 = str_builder_new();
    str_builder_add_cstr(sb_fcyr1, fuzz_dir1);
    str_builder_add_cstr(sb_fcyr1, "/uses_stdlib.fcyr");
    _write_file(str_data(str_builder_build(sb_fcyr1)),
        "fn fuzz_main(data, n) {\n    if (n == 0) { return 0; }\n    if (strlen(\"hello\") != 5) { return 1; }\n    return 0;\n}\nfn main() {\n    if (fuzz_main(\"dummy\", 5) != 0) { syscall(60, 1); }\n    syscall(60, 0);\n    return 0;\n}\nvar r = main();\nsyscall(60, r);\n");
    var out1 = _tmp_path("audit_fuzz_out1_");
    var ec1 = _exec_in_dir(sc1, cyrius_bin, "fuzz", out1);
    if (ec1 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case1 cyrius fuzz exited ");
        print_num(ec1);
        println(" (auto-prepend not working)");
        fail = fail + 1;
    } else { if (_file_contains_substr(out1, "1 passed, 0 failed") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case1 fuzz ran but did not summarize '1 passed, 0 failed'");
            fail = fail + 1;
        } }
    sys_unlink(out1);

    # Case 2: no manifest; .fcyr self-contained.
    var sc2 = _tmp_path("audit_fuzz_deps2_");
    _mkdir_p(sc2);
    var sb_fuzz_dir2 = str_builder_new();
    str_builder_add_cstr(sb_fuzz_dir2, sc2);
    str_builder_add_cstr(sb_fuzz_dir2, "/fuzz");
    var fuzz_dir2 = str_data(str_builder_build(sb_fuzz_dir2));
    sys_mkdir(fuzz_dir2, 493);
    var sb_fcyr2 = str_builder_new();
    str_builder_add_cstr(sb_fcyr2, fuzz_dir2);
    str_builder_add_cstr(sb_fcyr2, "/standalone.fcyr");
    _write_file(str_data(str_builder_build(sb_fcyr2)),
        "fn fuzz_main(data, n) {\n    if (n == 0) { return 0; }\n    return 0;\n}\nfn main() {\n    if (fuzz_main(\"x\", 1) != 0) { syscall(60, 1); }\n    syscall(60, 0);\n    return 0;\n}\nvar r = main();\nsyscall(60, r);\n");
    var out2 = _tmp_path("audit_fuzz_out2_");
    var ec2 = _exec_in_dir(sc2, cyrius_bin, "fuzz", out2);
    if (ec2 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case2 cyrius fuzz exited ");
        print_num(ec2);
        println(" (no-manifest path broken)");
        fail = fail + 1;
    }
    sys_unlink(out2);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius fuzz auto-prepend parity (2/2 cases)");
    }
    _check(label, fail);
    return fail;
}

# Bespoke gate: `cyrius deps` walks [deps.X] sections transitively,
# dedupes diamonds, breaks cycles. Pinned v5.7.14. Four cases:
#   1. 3-level chain A→B→C → A's lib/ has B.cyr + C.cyr.
#   2. Diamond A→{B,C}→D → A's lib/ contains D.cyr exactly once;
#      stdout reports "3 deps resolved".
#   3. Cycle A→B→A → must terminate cleanly (exit 0); pre-v5.7.14
#      this would infinite-loop and tripe a `timeout` kill.
#   4. Transitive `path = "..."` resolved against the transitive
#      dep's directory (relative-path resolution semantic).
fn _deps_transitive_gate() {
    var label = "cyrius deps walks [deps.X] transitively (3-level + diamond + cycle + rel-path; v5.7.14)";
    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built");
        println("");
        _check(label, 0);
        return 0;
    }
    var fail = 0;

    # ── Case 1: 3-level chain A→B→C ──
    var sc1 = _tmp_path("audit_deps_chain_");
    var dirs1[7];
    store64(&dirs1,      sc1);
    var p1 = str_builder_new();
    str_builder_add_cstr(p1, sc1);
    str_builder_add_cstr(p1, "/A");
    var a1 = str_data(str_builder_build(p1));
    var p1b = str_builder_new();
    str_builder_add_cstr(p1b, sc1);
    str_builder_add_cstr(p1b, "/B/dist");
    var b1d = str_data(str_builder_build(p1b));
    var p1c = str_builder_new();
    str_builder_add_cstr(p1c, sc1);
    str_builder_add_cstr(p1c, "/C/dist");
    var c1d = str_data(str_builder_build(p1c));
    _mkdir_p(a1);
    _mkdir_p(b1d);
    _mkdir_p(c1d);

    var sbBcyr = str_builder_new();
    str_builder_add_cstr(sbBcyr, sc1);
    str_builder_add_cstr(sbBcyr, "/B/dist/B.cyr");
    _write_file(str_data(str_builder_build(sbBcyr)), "# B\n");
    var sbCcyr = str_builder_new();
    str_builder_add_cstr(sbCcyr, sc1);
    str_builder_add_cstr(sbCcyr, "/C/dist/C.cyr");
    _write_file(str_data(str_builder_build(sbCcyr)), "# C\n");

    var sbCyml_C = str_builder_new();
    str_builder_add_cstr(sbCyml_C, sc1);
    str_builder_add_cstr(sbCyml_C, "/C/cyrius.cyml");
    _write_file(str_data(str_builder_build(sbCyml_C)),
        "[package]\nname = \"C\"\n[lib]\nmodules = [\"dist/C.cyr\"]\n");

    var sbCyml_B = str_builder_new();
    str_builder_add_cstr(sbCyml_B, sc1);
    str_builder_add_cstr(sbCyml_B, "/B/cyrius.cyml");
    var sbCB = str_builder_new();
    str_builder_add_cstr(sbCB, "[package]\nname = \"B\"\n[deps.C]\npath = \"");
    str_builder_add_cstr(sbCB, sc1);
    str_builder_add_cstr(sbCB, "/C\"\nmodules = [\"dist/C.cyr\"]\n");
    _write_file(str_data(str_builder_build(sbCyml_B)),
        str_data(str_builder_build(sbCB)));

    var sbCyml_A = str_builder_new();
    str_builder_add_cstr(sbCyml_A, sc1);
    str_builder_add_cstr(sbCyml_A, "/A/cyrius.cyml");
    var sbCA = str_builder_new();
    str_builder_add_cstr(sbCA, "[package]\nname = \"A\"\n[deps.B]\npath = \"");
    str_builder_add_cstr(sbCA, sc1);
    str_builder_add_cstr(sbCA, "/B\"\nmodules = [\"dist/B.cyr\"]\n");
    _write_file(str_data(str_builder_build(sbCyml_A)),
        str_data(str_builder_build(sbCA)));

    var out1 = _tmp_path("audit_deps_chain_out_");
    var ec1 = _exec_in_dir(a1, cyrius_bin, "deps", out1);
    if (ec1 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case1 (3-level chain) cyrius deps exited ");
        print_num(ec1);
        println("");
        fail = fail + 1;
    } else {
        # Both B.cyr and C.cyr should appear under A/lib/
        var sbAB = str_builder_new();
        str_builder_add_cstr(sbAB, a1);
        str_builder_add_cstr(sbAB, "/lib/B.cyr");
        var sbAC = str_builder_new();
        str_builder_add_cstr(sbAC, a1);
        str_builder_add_cstr(sbAC, "/lib/C.cyr");
        if (file_exists(str_data(str_builder_build(sbAB))) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case1 — A/lib/B.cyr missing");
            fail = fail + 1;
        }
        if (file_exists(str_data(str_builder_build(sbAC))) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case1 — A/lib/C.cyr missing (transitive not resolved)");
            fail = fail + 1;
        }
    }
    sys_unlink(out1);

    # ── Case 2: diamond A→{B,C}→D, dedup ──
    var sc2 = _tmp_path("audit_deps_diam_");
    var p2a = str_builder_new();
    str_builder_add_cstr(p2a, sc2);
    str_builder_add_cstr(p2a, "/A");
    var a2 = str_data(str_builder_build(p2a));
    _mkdir_p(a2);
    var p2bd = str_builder_new();
    str_builder_add_cstr(p2bd, sc2);
    str_builder_add_cstr(p2bd, "/B/dist");
    _mkdir_p(str_data(str_builder_build(p2bd)));
    var p2cd = str_builder_new();
    str_builder_add_cstr(p2cd, sc2);
    str_builder_add_cstr(p2cd, "/C/dist");
    _mkdir_p(str_data(str_builder_build(p2cd)));
    var p2dd = str_builder_new();
    str_builder_add_cstr(p2dd, sc2);
    str_builder_add_cstr(p2dd, "/D/dist");
    _mkdir_p(str_data(str_builder_build(p2dd)));

    var pBcyr = str_builder_new();
    str_builder_add_cstr(pBcyr, sc2);
    str_builder_add_cstr(pBcyr, "/B/dist/B.cyr");
    _write_file(str_data(str_builder_build(pBcyr)), "# B\n");
    var pCcyr = str_builder_new();
    str_builder_add_cstr(pCcyr, sc2);
    str_builder_add_cstr(pCcyr, "/C/dist/C.cyr");
    _write_file(str_data(str_builder_build(pCcyr)), "# C\n");
    var pDcyr = str_builder_new();
    str_builder_add_cstr(pDcyr, sc2);
    str_builder_add_cstr(pDcyr, "/D/dist/D.cyr");
    _write_file(str_data(str_builder_build(pDcyr)), "# D\n");

    var pDyml = str_builder_new();
    str_builder_add_cstr(pDyml, sc2);
    str_builder_add_cstr(pDyml, "/D/cyrius.cyml");
    _write_file(str_data(str_builder_build(pDyml)),
        "[package]\nname = \"D\"\n[lib]\nmodules = [\"dist/D.cyr\"]\n");

    var pByml = str_builder_new();
    str_builder_add_cstr(pByml, sc2);
    str_builder_add_cstr(pByml, "/B/cyrius.cyml");
    var pByml_body = str_builder_new();
    str_builder_add_cstr(pByml_body, "[package]\nname = \"B\"\n[deps.D]\npath = \"");
    str_builder_add_cstr(pByml_body, sc2);
    str_builder_add_cstr(pByml_body, "/D\"\nmodules = [\"dist/D.cyr\"]\n");
    _write_file(str_data(str_builder_build(pByml)),
        str_data(str_builder_build(pByml_body)));

    var pCyml = str_builder_new();
    str_builder_add_cstr(pCyml, sc2);
    str_builder_add_cstr(pCyml, "/C/cyrius.cyml");
    var pCyml_body = str_builder_new();
    str_builder_add_cstr(pCyml_body, "[package]\nname = \"C\"\n[deps.D]\npath = \"");
    str_builder_add_cstr(pCyml_body, sc2);
    str_builder_add_cstr(pCyml_body, "/D\"\nmodules = [\"dist/D.cyr\"]\n");
    _write_file(str_data(str_builder_build(pCyml)),
        str_data(str_builder_build(pCyml_body)));

    var pAyml = str_builder_new();
    str_builder_add_cstr(pAyml, sc2);
    str_builder_add_cstr(pAyml, "/A/cyrius.cyml");
    var pAyml_body = str_builder_new();
    str_builder_add_cstr(pAyml_body, "[package]\nname = \"A\"\n[deps.B]\npath = \"");
    str_builder_add_cstr(pAyml_body, sc2);
    str_builder_add_cstr(pAyml_body, "/B\"\nmodules = [\"dist/B.cyr\"]\n[deps.C]\npath = \"");
    str_builder_add_cstr(pAyml_body, sc2);
    str_builder_add_cstr(pAyml_body, "/C\"\nmodules = [\"dist/C.cyr\"]\n");
    _write_file(str_data(str_builder_build(pAyml)),
        str_data(str_builder_build(pAyml_body)));

    var out2 = _tmp_path("audit_deps_diam_out_");
    var ec2 = _exec_in_dir(a2, cyrius_bin, "deps", out2);
    if (ec2 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case2 (diamond) cyrius deps exited ");
        print_num(ec2);
        println("");
        fail = fail + 1;
    } else { if (_file_contains_substr(out2, "3 deps resolved") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case2 (diamond) — '3 deps resolved' not in stdout (D not dedup'd?)");
            fail = fail + 1;
        } }
    sys_unlink(out2);

    # ── Case 3: cycle A→B→A — must terminate, exit 0 ──
    var sc3 = _tmp_path("audit_deps_cyc_");
    var p3a = str_builder_new();
    str_builder_add_cstr(p3a, sc3);
    str_builder_add_cstr(p3a, "/A/dist");
    _mkdir_p(str_data(str_builder_build(p3a)));
    var p3b = str_builder_new();
    str_builder_add_cstr(p3b, sc3);
    str_builder_add_cstr(p3b, "/B/dist");
    _mkdir_p(str_data(str_builder_build(p3b)));

    var p3Acyr = str_builder_new();
    str_builder_add_cstr(p3Acyr, sc3);
    str_builder_add_cstr(p3Acyr, "/A/dist/A.cyr");
    _write_file(str_data(str_builder_build(p3Acyr)), "# A\n");
    var p3Bcyr = str_builder_new();
    str_builder_add_cstr(p3Bcyr, sc3);
    str_builder_add_cstr(p3Bcyr, "/B/dist/B.cyr");
    _write_file(str_data(str_builder_build(p3Bcyr)), "# B\n");

    var p3Ayml = str_builder_new();
    str_builder_add_cstr(p3Ayml, sc3);
    str_builder_add_cstr(p3Ayml, "/A/cyrius.cyml");
    var p3A_body = str_builder_new();
    str_builder_add_cstr(p3A_body, "[package]\nname = \"A\"\n[deps.B]\npath = \"");
    str_builder_add_cstr(p3A_body, sc3);
    str_builder_add_cstr(p3A_body, "/B\"\nmodules = [\"dist/B.cyr\"]\n");
    _write_file(str_data(str_builder_build(p3Ayml)),
        str_data(str_builder_build(p3A_body)));

    var p3Byml = str_builder_new();
    str_builder_add_cstr(p3Byml, sc3);
    str_builder_add_cstr(p3Byml, "/B/cyrius.cyml");
    var p3B_body = str_builder_new();
    str_builder_add_cstr(p3B_body, "[package]\nname = \"B\"\n[deps.A]\npath = \"");
    str_builder_add_cstr(p3B_body, sc3);
    str_builder_add_cstr(p3B_body, "/A\"\nmodules = [\"dist/A.cyr\"]\n");
    _write_file(str_data(str_builder_build(p3Byml)),
        str_data(str_builder_build(p3B_body)));

    var sb3a = str_builder_new();
    str_builder_add_cstr(sb3a, sc3);
    str_builder_add_cstr(sb3a, "/A");
    var a3 = str_data(str_builder_build(sb3a));
    var out3 = _tmp_path("audit_deps_cyc_out_");
    var ec3 = _exec_in_dir(a3, cyrius_bin, "deps", out3);
    if (ec3 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case3 (cycle) — expected exit 0, got ");
        print_num(ec3);
        println(" (likely infinite-loop pre-v5.7.14)");
        fail = fail + 1;
    }
    sys_unlink(out3);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius deps transitive walk + dedup + cycle-break (3/3 cases; v5.7.14)");
    }
    _check(label, fail);
    return fail;
}

# ── Main dispatch ──
# ROOT = absolute path to repo root. Resolved via getcwd; the shim
# in scripts/check.sh sets cwd to repo root before exec'ing.
fn _resolve_root() {
    var cwd_buf = alloc(4096);
    var n = syscall(79, cwd_buf, 4096);   # SYS_GETCWD on x86_64
    if (n <= 0) {
        store8(cwd_buf, 46);   # '.'
        store8(cwd_buf + 1, 0);
    }
    return cwd_buf;
}

fn _setup_paths() {
    ROOT_PATH = _resolve_root();
    CC_PATH = _root_path("build/cc5");
    CYRFMT_PATH = _resolve_tool("build/cyrfmt", "cyrfmt");
    CYRLINT_PATH = _resolve_tool("build/cyrlint", "cyrlint");
    CYRDOC_PATH = _resolve_tool("build/cyrdoc", "cyrdoc");
    CC_AARCH64_PATH = _root_path("build/cc5_aarch64");
    return 0;
}

# Gate registry: each entry is a (label, script_rel) pair we dispatch
# via _gate(). Matches scripts/check.sh sections 4a–4ba inclusive.
fn _run_regression_gates() {
    _section("Shared-object");
    _shared_dlopen_gate();
    println("");

    _section("Linker");
    _linker_gate();
    println("");

    _section("Capacity meter");
    _capacity_gate();
    println("");

    _section("Object init binding");
    _object_init_gate();
    println("");

    _section("aarch64 syscalls + threads");
    _aarch64_syscalls_gate();
    println("");

    _section("Mach-O aarch64 cross-build");
    _macho_cross_build_gate();
    println("");

    _section("Inline-asm discard-result");
    _inline_asm_discard_gate();
    println("");

    _section("cyrfmt --write");
    _cyrfmt_write_gate();
    println("");

    _section("Reserved-keyword diag");
    _reserved_kw_diag_gate();
    println("");

    # v5.9.25 (per v5.9.6 pin): the 6 _tcyr_relay_gate calls
    # previously here (shadow_pam / fdlopen / thread_local /
    # atomics / thread_safety / flags) are removed — each tcyr is
    # ALSO covered by `_testsuite_gate()` below, which walks
    # tests/tcyr/* alphabetically. Pre-v5.9.25 each of these 6
    # files compiled + ran twice per check.sh invocation; now each
    # runs exactly once via the testsuite walk. Audit gate count
    # drops 67 → 61 (six relay-pass lines retired).

    _section("aarch64 native self-host");
    _aarch64_native_selfhost_gate();
    println("");

    _section("Mach-O arm64 runtime");
    _gate("Mach-O arm64 syscall(60,42) → exit 42 on ecb (pin v5.6.33)", "tests/regression-macho-exit.sh");
    println("");

    _section("PE32+ Windows runtime");
    _gate("PE syscall(60,42) → exit 42 on cass (pin v5.6.36)", "tests/regression-pe-exit.sh");
    println("");

    _section("sit 100-commit fixture");
    _sit_status_gate();
    println("");

    _section("TLS live");
    _gate("libssl via fdlopen: full TLS round-trip on 1.1.1.1:443 (pin v5.6.37)", "tests/regression-tls-live.sh");
    println("");

    _section("TS lexer (cyrius-ts)");
    _ts_lex_gate();
    println("");

    _section("TS parser (SY acceptance)");
    _ts_corpus_gate("cc5 --parse-ts vs SY .ts corpus ≥98%% baseline (v5.7.3 P3.1)", ".ts", 2053);
    println("");

    _section("TS parser .tsx (JSX)");
    _ts_corpus_gate("cc5 --parse-ts vs SY .tsx corpus ≥98%% baseline (v5.7.3 P3.3)", ".tsx", 435);
    println("");

    _section("Bare-truthy after fn-call");
    _truthy_after_fncall_gate();
    println("");

    _section("fn-name collision warning");
    _fn_collision_gate();
    println("");

    _section("input_buf 1 MB cap");
    _input_1mb_gate();
    println("");

    _section("cyrius-x bytecode entry");
    _cx_build_gate();
    println("");

    _section("cyrius-x bytecode cleanliness");
    _cx_roundtrip_gate();
    println("");

    _section("String-escape rejects");
    _string_escape_rejects_gate();
    println("");

    _section("match coverage check (DCE-dead fn determinism; v5.9.24)");
    _match_coverage_dce_gate();
    println("");

    _section("cyrius deps transitive");
    _deps_transitive_gate();
    println("");

    _section("cyrius init --lib/--bin");
    _gate("cyrius init --lib emits programs/smoke.cyr + [lib]; --bin/bare keep binary shape (v5.7.15)", "tests/regression-init-lib-bin.sh");
    println("");

    _section("cyrius init/port doc-tree");
    _gate("cyrius init/port emit adr/architecture/guides/examples/development + CLAUDE.md (v5.7.16)", "tests/regression-init-doctree.sh");
    println("");

    _section("struct cap raise + diag");
    _struct_cap_gate();
    println("");

    _section("kmode emit order");
    _kmode_emit_order_gate();
    println("");

    _section("stdlib doc coverage");
    _stdlib_doc_coverage_gate();
    println("");

    _section("cyrius fuzz auto-prepend");
    _fuzz_deps_prepend_gate();
    println("");

    _section("cyrfmt comment/string brace skip");
    _cyrfmt_comment_braces_gate();
    println("");

    _section("install --refresh-only shim");
    _install_shim_symlink_gate();
    println("");

    _section("cx syscall literal propagation");
    _cx_syscall_literal_gate();
    println("");

    _section("TS asserts predicate signatures");
    _parse_ts_dir_gate("cc5 --parse-ts accepts asserts predicate signatures + this-type (v5.7.24)", "asserts predicates + this-type (TS 3.7+)", "ts_asserts");
    println("");

    _section("TS mapped types + modifiers");
    _parse_ts_dir_gate("cc5 --parse-ts accepts mapped types + as-clause + +/- modifiers (v5.7.25)", "mapped types + as-clause + +/- modifiers", "ts_mapped");
    println("");

    _section("TS decorators");
    _parse_ts_dir_gate("cc5 --parse-ts accepts TS 5.0 stage-3 decorators (v5.7.26)", "TS 5.0 stage-3 decorators", "ts_decorators");
    println("");

    _section("Token-offset parity");
    _cx_token_offsets_gate();
    println("");

    _section("aarch64 f64 basic ops");
    _aarch64_f64_basic_gate();
    println("");

    _section("aarch64 f64_exp / f64_ln / f64_log2 polyfills");
    _aarch64_f64_polyfill_gate();
    println("");

    _section("cyrlint global-init-order");
    _lint_init_order_gate();
    println("");

    _section("cyrlint large-file");
    _cyrlint_large_file_gate();
    println("");

    _build_api_surface_if_missing();
    _section("cyrius api-surface");
    _api_surface_gate();
    println("");

    _section("aarch64 codebuf cap");
    _aarch64_codebuf_cap_gate();
    println("");

    _section("stdlib syscall surface (v5.7.35)");
    _syscall_surface_v5735_gate();
    println("");

    _section("distlib >64KB module");
    _distlib_large_module_gate();
    println("");

    _section("smoke discovery");
    _smoke_discovery_gate();
    println("");

    _section("lsp definition");
    _lsp_definition_gate();
    println("");

    _section("json pretty");
    _expected_output_gate("json_v_build_pretty(v, indent) end-to-end canonical shape (v5.7.40)", "json pretty-print indent=2", "json_pretty");
    println("");

    _section("json stream");
    _expected_output_gate("json_stream_parse(buf, len, h) event order canonical sequence (v5.7.41)", "json streaming events canonical order", "json_stream");
    println("");

    _section("json pointer");
    _expected_output_gate("json_v_pointer(v, ptr) RFC 6901 paths + ~0/~1 escapes + OOB/miss (v5.7.42)", "JSON Pointer RFC 6901 + ~0/~1 escapes", "json_pointer");
    println("");

    _section("test_each");
    _expected_output_gate("test_each(cases_vec, fp) iteration order + transitive include chain (v5.7.43)", "test_each iteration + include chain", "test_lib");
    println("");

    _section("variadic tuples");
    _parse_ts_dir_gate("TS variadic tuples — parse acceptance for spread element forms (v5.7.44)", "variadic tuple spread forms", "ts_variadic_tuples");
    println("");

    _section("const type params");
    _parse_ts_dir_gate("TS const type params <const T> — parse acceptance (v5.7.45)", "const type params <const T>", "ts_const_type_params");
    println("");

    _section("advanced-TS pin audit");
    _parse_ts_dir_gate("TS advanced-pin audit — as const + satisfies + never/unknown + conditional types (v5.7.46)", "advanced-TS pin audit", "ts_advanced_pin_audit");
    println("");

    _section("args_init >4 KB cmdline (v5.9.5; cyim BUG-001)");
    _args_init_4kb_gate();
    println("");

    return 0;
}

fn main() {
    alloc_init();
    _load_environ();
    _setup_paths();

    println("=== Cyrius v2.0 Audit ===");
    println("");

    _self_host_gate();
    _heapmap_gate();
    _testsuite_gate();
    _run_regression_gates();
    _format_gate();
    _lint_gate();

    println("════════════════════════");
    print_num(G_PASS);
    _p(" passed, ");
    print_num(G_FAIL);
    _p(" failed (");
    print_num(G_TOTAL);
    println(" total)");

    return G_FAIL;
}

var r = main();
syscall(60, r);
