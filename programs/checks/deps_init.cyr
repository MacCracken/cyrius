# ================================================================
# programs/checks/deps_init.cyr — cyrius deps + cyrius init/port scaffolding gates
# ================================================================
# v6.0.90: split out of the monolithic programs/check.cyr (10.2K LoC).
# Fn DEFINITIONS only — no includes, no module-level vars, no driver.
# All lib includes + the 18 globals + the dispatcher/driver live in
# programs/checks/main.cyr, which includes this file. See CHANGELOG [6.0.90].

fn _deps_downstream_src_main_gate(): i64 {
    var label = "cyrius deps resolves stdlib pins for downstream repos with src/main.cyr (v6.0.1; mkdir-before-find regression)";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    var fixture_dir = _tmp_path("audit_deps_downstream_");
    sys_mkdir(fixture_dir, 0x1ED);

    var src_dir_sb = str_builder_new();
    str_builder_add_cstr(src_dir_sb, fixture_dir);
    str_builder_add_cstr(src_dir_sb, "/src");
    var src_dir = str_data(str_builder_build(src_dir_sb));
    sys_mkdir(src_dir, 0x1ED);

    var main_path_sb = str_builder_new();
    str_builder_add_cstr(main_path_sb, src_dir);
    str_builder_add_cstr(main_path_sb, "/main.cyr");
    var main_path = str_data(str_builder_build(main_path_sb));
    _write_file(main_path, "fn main(): i64 { return 0; }\n");

    var cyml_path_sb = str_builder_new();
    str_builder_add_cstr(cyml_path_sb, fixture_dir);
    str_builder_add_cstr(cyml_path_sb, "/cyrius.cyml");
    var cyml_path = str_data(str_builder_build(cyml_path_sb));
    _write_file(cyml_path,
        "[package]\nname = \"deps_gate_fixture\"\nversion = \"0.0.1\"\n\n[build]\nentry = \"src/main.cyr\"\n\n[deps]\nstdlib = [\"fnptr\"]\n");

    var out_path = _tmp_path("audit_deps_downstream_out_");
    var ec = _exec_in_dir(fixture_dir, cyrius_bin, "deps", out_path);

    var lib_fnptr_sb = str_builder_new();
    str_builder_add_cstr(lib_fnptr_sb, fixture_dir);
    str_builder_add_cstr(lib_fnptr_sb, "/lib/fnptr.cyr");
    var lib_fnptr = str_data(str_builder_build(lib_fnptr_sb));
    var resolved = file_exists(lib_fnptr);
    var sz = 0;
    if (resolved == 1) { sz = _file_size(lib_fnptr); }

    # Cleanup before reporting so a failed assertion still cleans up.
    sys_unlink(out_path);
    sys_unlink(lib_fnptr);
    sys_unlink(main_path);
    sys_unlink(cyml_path);
    var lib_dir_sb = str_builder_new();
    str_builder_add_cstr(lib_dir_sb, fixture_dir);
    str_builder_add_cstr(lib_dir_sb, "/lib");
    sys_rmdir(str_data(str_builder_build(lib_dir_sb)));
    sys_rmdir(src_dir);
    sys_rmdir(fixture_dir);

    var fail = 0;
    if (ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cyrius deps exited "); print_num(ec); println(" (expected 0)");
        fail = 1;
    } elif (resolved != 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": lib/fnptr.cyr not materialized in fixture (cmd_deps mkdir-before-find regression?)");
        fail = 1;
    } elif (sz <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": lib/fnptr.cyr exists but is empty (sz="); print_num(sz); println(")");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        _p(": cyrius deps materialized lib/fnptr.cyr (");
        print_num(sz); println(" bytes) in downstream-with-src/main.cyr fixture");
    }
    _check(label, fail);
    return fail;
}

fn _lk_path(base, suffix): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, base);
    str_builder_add_cstr(sb, suffix);
    return str_data(str_builder_build(sb));
}

# v6.2.46 (dependency-model arc, lever 1 / Phase A): a named dep may
# declare the stdlib leaves it needs in scope via `requires = [...]`;
# `cyrius deps` auto-resolves them (recursive stdlib resolver, ahead of
# the dep's own modules so the include order is topological), dedups a
# leaf shared by two deps, and FAILS LOUD when a required leaf is missing
# — converting the old hand-ordered "ct/keccak MUST precede sigil" chain
# and its omit-one → runtime ud2/SIGILL trap into a build-time error.
# Leaf-only deps keep the gate hermetic (no network / real fold);
# fnptr/ct/keccak are pure leaves (0 transitive includes) so the fixture
# lib/ holds exactly three files for a clean rmdir.
fn _deps_requires_gate(): i64 {
    var label = "cyrius deps resolves a named dep's `requires` stdlib leaves (transitive auto-resolve + dedup + fail-loud on missing) — v6.2.46 dependency-model lever 1 Phase A";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    # Case 1 — positive + dedup. "fnptr" is required by BOTH folds (must
    # resolve once); "ct"/"keccak" once each.
    var fx = _tmp_path("audit_deps_requires_");
    sys_mkdir(fx, 0x1ED);
    _write_file(_lk_path(fx, "/cyrius.cyml"),
        "[package]\nname = \"requires_gate\"\n\n[deps.fold_a]\nrequires = [\"fnptr\", \"ct\"]\n\n[deps.fold_b]\nrequires = [\"fnptr\", \"keccak\"]\n");
    var out1 = _tmp_path("audit_deps_requires_out1_");
    var ec1 = _exec_in_dir(fx, cyrius_bin, "deps", out1);
    var got_fnptr = file_exists(_lk_path(fx, "/lib/fnptr.cyr"));
    var got_ct = file_exists(_lk_path(fx, "/lib/ct.cyr"));
    var got_keccak = file_exists(_lk_path(fx, "/lib/keccak.cyr"));

    # Case 2 — a missing required leaf must FAIL LOUD (non-zero exit).
    var fx2 = _tmp_path("audit_deps_requires_bad_");
    sys_mkdir(fx2, 0x1ED);
    _write_file(_lk_path(fx2, "/cyrius.cyml"),
        "[package]\nname = \"requires_bad\"\n\n[deps.fold_bad]\nrequires = [\"this_leaf_does_not_exist_xyz\"]\n");
    var out2 = _tmp_path("audit_deps_requires_out2_");
    var ec2 = _exec_in_dir(fx2, cyrius_bin, "deps", out2);

    # Cleanup before reporting so a failed assertion still cleans up.
    sys_unlink(out1);
    sys_unlink(out2);
    sys_unlink(_lk_path(fx, "/lib/fnptr.cyr"));
    sys_unlink(_lk_path(fx, "/lib/ct.cyr"));
    sys_unlink(_lk_path(fx, "/lib/keccak.cyr"));
    sys_unlink(_lk_path(fx, "/cyrius.cyml"));
    sys_rmdir(_lk_path(fx, "/lib"));
    sys_rmdir(fx);
    sys_unlink(_lk_path(fx2, "/cyrius.cyml"));
    sys_rmdir(_lk_path(fx2, "/lib"));
    sys_rmdir(fx2);

    var fail = 0;
    if (ec1 != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": positive requires-resolve exited "); print_num(ec1); println(" (expected 0)");
        fail = 1;
    } elif (got_fnptr != 1 || got_ct != 1 || got_keccak != 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": requires leaves not all materialized (fnptr/ct/keccak) in fixture lib/");
        fail = 1;
    } elif (ec2 == 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": a missing required leaf did NOT fail loud (cyrius deps exited 0)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": requires resolves+dedups stdlib leaves; missing leaf fails the build");
    }
    _check(label, fail);
    return fail;
}

# v6.2.47 (deps lever 1, Phase A producer-side): `cyrius distlib` emits a
# `dist/<pkg>.deps` sidecar listing the `lib/` stdlib leaves it stripped at
# fold time; `cyrius deps` reads it next to a resolved fold module and
# auto-pulls those leaves — so a consumer declaring just `[deps.<pkg>]` (no
# hand-authored `requires`) gets them in scope, in topological order. This
# gate proves the full producer→sidecar→consumer chain end-to-end.
fn _deps_sidecar_gate(): i64 {
    var label = "cyrius distlib emits dist/<pkg>.deps + cyrius deps auto-resolves its leaves with no hand-authored `requires` — v6.2.47 dependency-model lever 1 Phase A (producer sidecar)";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    # --- Producer: a fold whose module includes lib/fnptr + lib/ct (captured)
    #     and a src/ self-ref (NOT captured). `cyrius distlib` → sidecar.
    var fd = _tmp_path("audit_deps_sidecar_fold_");
    sys_mkdir(fd, 0x1ED);
    _write_file(_lk_path(fd, "/mymod.cyr"),
        "include \"lib/fnptr.cyr\"\ninclude \"lib/ct.cyr\"\ninclude \"src/self.cyr\"\n\nfn _sc_thing(): i64 { return 1; }\n");
    # Umbrella include-hub (v6.2.48): declares a leaf (keccak) that NO folded
    # module includes directly — proves the umbrella scan captures it.
    sys_mkdir(_lk_path(fd, "/src"), 0x1ED);
    _write_file(_lk_path(fd, "/src/lib.cyr"), "include \"lib/keccak.cyr\"\n");
    _write_file(_lk_path(fd, "/cyrius.cyml"),
        "[package]\nname = \"scfold\"\nversion = \"0.0.1\"\n\n[lib]\nmodules = [\"mymod.cyr\"]\n");
    var pout = _tmp_path("audit_deps_sidecar_pout_");
    var pec = _exec_in_dir(fd, cyrius_bin, "distlib", pout);
    var sidecar = _lk_path(fd, "/dist/scfold.deps");
    var got_sidecar = file_exists(sidecar);
    # Sidecar must list fnptr (lib/) and NOT self (src/ skipped).
    var has_fnptr = 0;
    var has_keccak = 0;
    var has_self = 1;
    if (got_sidecar == 1) {
        var sb = alloc(8192);
        var sn = file_read_all(sidecar, sb, 8191);
        if (sn > 0) {
            store8(sb + sn, 0);
            if (_find_str_from(sb, sn, 0, "fnptr", 5) >= 0) { has_fnptr = 1; }
            if (_find_str_from(sb, sn, 0, "keccak", 6) >= 0) { has_keccak = 1; }
            if (_find_str_from(sb, sn, 0, "self", 4) < 0) { has_self = 0; }
        }
    }

    # --- Consumer: declares [deps.scfold] with NO `requires`; the sidecar
    #     auto-pulls fnptr + ct into the consumer's lib/.
    var cd = _tmp_path("audit_deps_sidecar_consumer_");
    sys_mkdir(cd, 0x1ED);
    var ccyml = str_builder_new();
    str_builder_add_cstr(ccyml, "[package]\nname = \"scconsumer\"\n\n[deps.scfold]\npath = \"");
    str_builder_add_cstr(ccyml, fd);
    str_builder_add_cstr(ccyml, "\"\nmodules = [\"dist/scfold.cyr\"]\n");
    _write_file(_lk_path(cd, "/cyrius.cyml"), str_data(str_builder_build(ccyml)));
    var cout = _tmp_path("audit_deps_sidecar_cout_");
    var cec = _exec_in_dir(cd, cyrius_bin, "deps", cout);
    var got_fnptr = file_exists(_lk_path(cd, "/lib/fnptr.cyr"));
    var got_ct = file_exists(_lk_path(cd, "/lib/ct.cyr"));
    var got_keccak = file_exists(_lk_path(cd, "/lib/keccak.cyr"));

    # Cleanup before reporting so a failed assertion still cleans up.
    sys_unlink(pout);
    sys_unlink(cout);
    sys_unlink(sidecar);
    sys_unlink(_lk_path(fd, "/dist/scfold.cyr"));
    sys_rmdir(_lk_path(fd, "/dist"));
    sys_unlink(_lk_path(fd, "/mymod.cyr"));
    sys_unlink(_lk_path(fd, "/src/lib.cyr"));
    sys_rmdir(_lk_path(fd, "/src"));
    sys_unlink(_lk_path(fd, "/cyrius.cyml"));
    sys_rmdir(fd);
    sys_unlink(_lk_path(cd, "/lib/fnptr.cyr"));
    sys_unlink(_lk_path(cd, "/lib/ct.cyr"));
    sys_unlink(_lk_path(cd, "/lib/keccak.cyr"));
    sys_unlink(_lk_path(cd, "/lib/scfold.cyr"));
    sys_unlink(_lk_path(cd, "/cyrius.lock"));
    sys_unlink(_lk_path(cd, "/cyrius.cyml"));
    sys_rmdir(_lk_path(cd, "/lib"));
    sys_rmdir(cd);

    var fail = 0;
    if (pec != 0 || got_sidecar != 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": distlib did not emit dist/scfold.deps (exit "); print_num(pec); println(")");
        fail = 1;
    } elif (has_fnptr != 1 || has_keccak != 1 || has_self != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": sidecar wrong (needs folded leaf 'fnptr' + umbrella-only 'keccak', NOT src/ 'self')");
        fail = 1;
    } elif (cec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": consumer deps (no requires) exited "); print_num(cec); println(" (expected 0)");
        fail = 1;
    } elif (got_fnptr != 1 || got_ct != 1 || got_keccak != 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": sidecar did not auto-pull fnptr+ct+keccak (umbrella) into the consumer's lib/");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": distlib sidecar (folded + umbrella src/lib.cyr leaves) auto-resolves with no `requires`");
    }
    _check(label, fail);
    return fail;
}

# v6.2.49 (deps lever 1 / Phase B — named module groupings): a `[groups]`
# section defines named lists that expand at resolve time wherever named in
# `[deps].stdlib` or a `[deps.NAME] requires`. This gate proves nested
# expansion (`core` → `crypto` → ct/keccak) + cycle-safety (`selfref` →
# `selfref` skips without hanging).
fn _deps_groups_gate(): i64 {
    var label = "cyrius deps expands [groups] in [deps].stdlib (nested + cycle-guarded) → members resolve — v6.2.49 dependency-model lever 1 Phase B";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    var fx = _tmp_path("audit_deps_groups_");
    sys_mkdir(fx, 0x1ED);
    # core → [crypto, fnptr] → [ct, keccak, fnptr]; selfref → selfref (pure cycle,
    # contributes nothing, must not hang).
    _write_file(_lk_path(fx, "/cyrius.cyml"),
        "[package]\nname = \"groups_gate\"\n\n[groups]\ncrypto = [\"ct\", \"keccak\"]\ncore = [\"crypto\", \"fnptr\"]\nselfref = [\"selfref\"]\n\n[deps]\nstdlib = [\"core\", \"selfref\"]\n");
    var out = _tmp_path("audit_deps_groups_out_");
    var ec = _exec_in_dir(fx, cyrius_bin, "deps", out);
    var got_ct = file_exists(_lk_path(fx, "/lib/ct.cyr"));
    var got_keccak = file_exists(_lk_path(fx, "/lib/keccak.cyr"));
    var got_fnptr = file_exists(_lk_path(fx, "/lib/fnptr.cyr"));

    # Cleanup before reporting so a failed assertion still cleans up.
    sys_unlink(out);
    sys_unlink(_lk_path(fx, "/lib/ct.cyr"));
    sys_unlink(_lk_path(fx, "/lib/keccak.cyr"));
    sys_unlink(_lk_path(fx, "/lib/fnptr.cyr"));
    sys_unlink(_lk_path(fx, "/cyrius.lock"));
    sys_unlink(_lk_path(fx, "/cyrius.cyml"));
    sys_rmdir(_lk_path(fx, "/lib"));
    sys_rmdir(fx);

    var fail = 0;
    if (ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": deps with [groups] exited "); print_num(ec); println(" (expected 0)");
        fail = 1;
    } elif (got_ct != 1 || got_keccak != 1 || got_fnptr != 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": nested group did not expand to ct+keccak+fnptr in the fixture lib/");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": [groups] expands (nested) into stdlib; self-cycle skipped without hanging");
    }
    _check(label, fail);
    return fail;
}

# v6.2.50 (deps lever 1 / Phase C — module-granular extraction): `cyrius distlib
# --modular` emits per-module `dist/<pkg>/<mod>.cyr` + an index.cyml dep graph; a
# consumer's `modular = [...]` pulls EXACT sub-modules + their transitive index
# deps (sibling modules + lib leaves), NOT the whole fold. Proves both halves
# end-to-end: gb depends on sibling ga; gc is independent and must NOT come in.
fn _deps_modular_gate(): i64 {
    var label = "cyrius distlib --modular + consumer `modular=[...]` pulls EXACT sub-modules + transitive deps, not the whole fold — v6.2.50 dependency-model lever 1 Phase C";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    # --- Producer: distlib --modular on a 3-module fold (gb → sibling ga + lib:ct;
    #     ga → lib:fnptr; gc independent → lib:keccak).
    var fd = _tmp_path("audit_deps_modular_fold_");
    sys_mkdir(fd, 0x1ED);
    sys_mkdir(_lk_path(fd, "/src"), 0x1ED);
    _write_file(_lk_path(fd, "/src/ga.cyr"), "include \"lib/fnptr.cyr\"\nfn _gm_a(): i64 { return 1; }\n");
    _write_file(_lk_path(fd, "/src/gb.cyr"), "include \"src/ga.cyr\"\ninclude \"lib/ct.cyr\"\nfn _gm_b(): i64 { return _gm_a(); }\n");
    _write_file(_lk_path(fd, "/src/gc.cyr"), "include \"lib/keccak.cyr\"\nfn _gm_c(): i64 { return 3; }\n");
    _write_file(_lk_path(fd, "/cyrius.cyml"), "[package]\nname = \"gmod\"\n\n[lib]\nmodules = [\"src/ga.cyr\", \"src/gb.cyr\", \"src/gc.cyr\"]\n");
    var pout = _tmp_path("audit_deps_modular_pout_");
    var pec = _exec_in_dir3(fd, cyrius_bin, "distlib", "--modular", 0, pout);
    var got_index = file_exists(_lk_path(fd, "/dist/gmod/index.cyml"));
    var got_gb = file_exists(_lk_path(fd, "/dist/gmod/gb.cyr"));

    # --- Consumer: pull ONLY sub-module gb.
    var cd = _tmp_path("audit_deps_modular_cons_");
    sys_mkdir(cd, 0x1ED);
    var ccyml = str_builder_new();
    str_builder_add_cstr(ccyml, "[package]\nname = \"gmcons\"\n\n[deps.gmod]\npath = \"");
    str_builder_add_cstr(ccyml, fd);
    str_builder_add_cstr(ccyml, "\"\nmodular = [\"gb\"]\n");
    _write_file(_lk_path(cd, "/cyrius.cyml"), str_data(str_builder_build(ccyml)));
    var cout = _tmp_path("audit_deps_modular_cout_");
    var cec = _exec_in_dir(cd, cyrius_bin, "deps", cout);
    var got_gb_lib = file_exists(_lk_path(cd, "/lib/gmod_gb.cyr"));
    var got_ga_lib = file_exists(_lk_path(cd, "/lib/gmod_ga.cyr"));   # sibling, pulled
    var got_gc_lib = file_exists(_lk_path(cd, "/lib/gmod_gc.cyr"));   # independent, must NOT come in

    # Cleanup before reporting.
    sys_unlink(pout);
    sys_unlink(cout);
    sys_unlink(_lk_path(fd, "/dist/gmod/ga.cyr"));
    sys_unlink(_lk_path(fd, "/dist/gmod/gb.cyr"));
    sys_unlink(_lk_path(fd, "/dist/gmod/gc.cyr"));
    sys_unlink(_lk_path(fd, "/dist/gmod/index.cyml"));
    sys_rmdir(_lk_path(fd, "/dist/gmod"));
    sys_rmdir(_lk_path(fd, "/dist"));
    sys_unlink(_lk_path(fd, "/src/ga.cyr"));
    sys_unlink(_lk_path(fd, "/src/gb.cyr"));
    sys_unlink(_lk_path(fd, "/src/gc.cyr"));
    sys_rmdir(_lk_path(fd, "/src"));
    sys_unlink(_lk_path(fd, "/cyrius.cyml"));
    sys_rmdir(fd);
    sys_unlink(_lk_path(cd, "/lib/gmod_gb.cyr"));
    sys_unlink(_lk_path(cd, "/lib/gmod_ga.cyr"));
    sys_unlink(_lk_path(cd, "/lib/ct.cyr"));
    sys_unlink(_lk_path(cd, "/lib/fnptr.cyr"));
    sys_unlink(_lk_path(cd, "/cyrius.lock"));
    sys_unlink(_lk_path(cd, "/cyrius.cyml"));
    sys_rmdir(_lk_path(cd, "/lib"));
    sys_rmdir(cd);

    var fail = 0;
    if (pec != 0 || got_index != 1 || got_gb != 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": distlib --modular did not emit dist/gmod/{gb.cyr,index.cyml} (exit "); print_num(pec); println(")");
        fail = 1;
    } elif (cec != 0 || got_gb_lib != 1 || got_ga_lib != 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": consumer modular=[gb] did not pull gb + its sibling ga into lib/");
        fail = 1;
    } elif (got_gc_lib == 1) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": independent sub-module gc was pulled — modular resolution is not exact");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": --modular + modular=[gb] pulls gb+ga (+leaves), excludes the independent gc");
    }
    _check(label, fail);
    return fail;
}

# v6.2.52 (closeout-deferred): `cyrius distlib --modular` must FAIL LOUD (non-zero)
# on (a) a duplicate module basename across src/ subdirs — two `<base>.cyr` would
# overwrite + the resolver is first-match-wins → silently lost deps; and (b) a
# missing `modules=` entry (user 2026-06-28: producer/consumer exit-code asymmetry
# fixed — distlib joins `cyrius deps` in failing loud, was warn + exit 0).
fn _distlib_failloud_gate(): i64 {
    var label = "cyrius distlib --modular fails loud (non-zero) on duplicate basename + missing module — v6.2.52 closeout-deferred";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    # Case A: two modules with the same basename in different src/ subdirs.
    var fa = _tmp_path("audit_distlib_dup_");
    sys_mkdir(fa, 0x1ED);
    sys_mkdir(_lk_path(fa, "/src"), 0x1ED);
    sys_mkdir(_lk_path(fa, "/src/a"), 0x1ED);
    sys_mkdir(_lk_path(fa, "/src/b"), 0x1ED);
    _write_file(_lk_path(fa, "/src/a/x.cyr"), "fn _da(): i64 { return 1; }\n");
    _write_file(_lk_path(fa, "/src/b/x.cyr"), "fn _db(): i64 { return 2; }\n");
    _write_file(_lk_path(fa, "/cyrius.cyml"), "[package]\nname = \"dup\"\n\n[lib]\nmodules = [\"src/a/x.cyr\", \"src/b/x.cyr\"]\n");
    var oa = _tmp_path("audit_distlib_dup_out_");
    var eca = _exec_in_dir3(fa, cyrius_bin, "distlib", "--modular", 0, oa);

    # Case B: a missing modules= entry.
    var fb = _tmp_path("audit_distlib_miss_");
    sys_mkdir(fb, 0x1ED);
    sys_mkdir(_lk_path(fb, "/src"), 0x1ED);
    _write_file(_lk_path(fb, "/cyrius.cyml"), "[package]\nname = \"miss\"\n\n[lib]\nmodules = [\"src/nope.cyr\"]\n");
    var ob = _tmp_path("audit_distlib_miss_out_");
    var ecb = _exec_in_dir3(fb, cyrius_bin, "distlib", "--modular", 0, ob);

    # Cleanup (the dup case may have written dist/dup/x.cyr for the first module
    # before failing; the miss case makes only the empty dist/miss/ dir).
    sys_unlink(oa);
    sys_unlink(ob);
    sys_unlink(_lk_path(fa, "/dist/dup/x.cyr"));
    sys_unlink(_lk_path(fa, "/dist/dup/index.cyml"));
    sys_rmdir(_lk_path(fa, "/dist/dup"));
    sys_rmdir(_lk_path(fa, "/dist"));
    sys_unlink(_lk_path(fa, "/src/a/x.cyr"));
    sys_unlink(_lk_path(fa, "/src/b/x.cyr"));
    sys_rmdir(_lk_path(fa, "/src/a"));
    sys_rmdir(_lk_path(fa, "/src/b"));
    sys_rmdir(_lk_path(fa, "/src"));
    sys_unlink(_lk_path(fa, "/cyrius.cyml"));
    sys_rmdir(fa);
    sys_rmdir(_lk_path(fb, "/dist/miss"));
    sys_rmdir(_lk_path(fb, "/dist"));
    sys_rmdir(_lk_path(fb, "/src"));
    sys_unlink(_lk_path(fb, "/cyrius.cyml"));
    sys_rmdir(fb);

    var fail = 0;
    if (eca == 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": duplicate module basename did not fail loud (would silently overwrite)");
        fail = 1;
    } elif (ecb == 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": missing modules= entry did not fail loud (still warn + exit 0)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": duplicate basename + missing module both fail loud (non-zero)");
    }
    _check(label, fail);
    return fail;
}

# v6.3.1 (dependency-model arc, lever 2 — required vs optional deps): an
# `optional = true` dep resolves only when an active `[features]` set names it; a
# `target = "<arch|os>"` dep resolves only on a matching build target; the axes are
# independent. Proves all four transitions in one fixture: optional skip + feature
# activate, target skip + target activate. The byte-identical "no new keys → resolve
# unchanged" property is the regression wall covered by the lever-1 gates above
# (requires/sidecar/groups/modular all use plain deps and must still pass).
fn _deps_features_gate(): i64 {
    var label = "cyrius deps gates `optional = true` deps behind active [features] + `target = \"...\"` deps behind the build target (axes independent) — v6.3.1 dependency-model lever 2";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    var fx = _tmp_path("audit_deps_features_");
    sys_mkdir(fx, 0x1ED);
    # fold_opt: optional, activated by the `extra` feature → pulls fnptr.
    # fold_tgt: target=windows → resolves only under --win (skipped on this host).
    _write_file(_lk_path(fx, "/cyrius.cyml"),
        "[package]\nname = \"features_gate\"\n\n[features]\nextra = [\"fold_opt\"]\n\n[deps.fold_opt]\nrequires = [\"fnptr\"]\noptional = true\n\n[deps.fold_tgt]\nrequires = [\"ct\"]\ntarget = \"windows\"\n");

    var libf = _lk_path(fx, "/lib/fnptr.cyr");
    var libc = _lk_path(fx, "/lib/ct.cyr");
    var lock = _lk_path(fx, "/cyrius.lock");

    # Run 1 — plain: optional inactive (no fnptr), target=windows skipped (no ct).
    var o1 = _tmp_path("audit_deps_features_o1_");
    var ec1 = _exec_in_dir(fx, cyrius_bin, "deps", o1);
    var r1_fnptr = file_exists(libf);
    var r1_ct = file_exists(libc);
    sys_unlink(libf); sys_unlink(libc); sys_unlink(lock);

    # Run 2 — --features extra: fold_opt activates (fnptr); fold_tgt still skipped (no ct).
    var o2 = _tmp_path("audit_deps_features_o2_");
    var ec2 = _exec_in_dir3(fx, cyrius_bin, "deps", "--features", "extra", o2);
    var r2_fnptr = file_exists(libf);
    var r2_ct = file_exists(libc);
    sys_unlink(libf); sys_unlink(libc); sys_unlink(lock);

    # Run 3 — --win: fold_tgt matches (ct); fold_opt still inactive (no fnptr).
    var o3 = _tmp_path("audit_deps_features_o3_");
    var ec3 = _exec_in_dir3(fx, cyrius_bin, "deps", "--win", 0, o3);
    var r3_fnptr = file_exists(libf);
    var r3_ct = file_exists(libc);

    # Cleanup before reporting so a failed assertion still cleans up.
    sys_unlink(libf); sys_unlink(libc); sys_unlink(lock);
    sys_unlink(o1); sys_unlink(o2); sys_unlink(o3);
    sys_unlink(_lk_path(fx, "/cyrius.cyml"));
    sys_rmdir(_lk_path(fx, "/lib"));
    sys_rmdir(fx);

    var fail = 0;
    if (ec1 != 0 || ec2 != 0 || ec3 != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": a deps run exited non-zero (");
        print_num(ec1); _p("/"); print_num(ec2); _p("/"); print_num(ec3); println(")");
        fail = 1;
    } elif (r1_fnptr != 0 || r1_ct != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": plain deps pulled a gated dep (optional + target=windows should both skip)");
        fail = 1;
    } elif (r2_fnptr != 1 || r2_ct != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": --features extra did not activate fold_opt (fnptr), or wrongly pulled the windows-only dep");
        fail = 1;
    } elif (r3_ct != 1 || r3_fnptr != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": --win did not resolve target=windows fold_tgt (ct), or wrongly pulled the optional dep");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": optional deps gate on [features]; target deps gate on build target; axes independent");
    }
    _check(label, fail);
    return fail;
}

# v6.2.51 (closeout — CVE-32 regression): a malicious/compromised dependency
# controls its dist/<pkg>/index.cyml; a sibling name that escapes lib/ (contains
# `/` or `..`) must be REJECTED before any fs op. Pre-fix, _dep_pull_submodule
# sys_unlink'd `lib/<pkg>_<submod>.cyr` on the unsanitized name → arbitrary .cyr
# deletion during automatic `cyrius deps`. This gate feeds a traversal sibling and
# asserts deps fails (non-zero) instead of silently doing the unsafe write.
fn _deps_modular_traversal_gate(): i64 {
    var label = "cyrius deps REJECTS a path-traversal sub-module name from a malicious dist/<pkg>/index.cyml — v6.2.51 closeout CVE-32 regression";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    # Hand-crafted malicious modular dist: module "m" whose index dep escapes lib/.
    var fd = _tmp_path("audit_cve32_dep_");
    sys_mkdir(fd, 0x1ED);
    sys_mkdir(_lk_path(fd, "/dist"), 0x1ED);
    sys_mkdir(_lk_path(fd, "/dist/cve"), 0x1ED);
    _write_file(_lk_path(fd, "/dist/cve/m.cyr"), "fn _cve_m(): i64 { return 0; }\n");
    _write_file(_lk_path(fd, "/dist/cve/index.cyml"), "[modular]\nm = [\"a/../../../cve32_evil\"]\n");

    var cd = _tmp_path("audit_cve32_cons_");
    sys_mkdir(cd, 0x1ED);
    var ccyml = str_builder_new();
    str_builder_add_cstr(ccyml, "[package]\nname = \"cve32c\"\n\n[deps.cve]\npath = \"");
    str_builder_add_cstr(ccyml, fd);
    str_builder_add_cstr(ccyml, "\"\nmodular = [\"m\"]\n");
    _write_file(_lk_path(cd, "/cyrius.cyml"), str_data(str_builder_build(ccyml)));
    var out = _tmp_path("audit_cve32_out_");
    var ec = _exec_in_dir(cd, cyrius_bin, "deps", out);

    # Cleanup before reporting.
    sys_unlink(out);
    sys_unlink(_lk_path(fd, "/dist/cve/m.cyr"));
    sys_unlink(_lk_path(fd, "/dist/cve/index.cyml"));
    sys_rmdir(_lk_path(fd, "/dist/cve"));
    sys_rmdir(_lk_path(fd, "/dist"));
    sys_rmdir(fd);
    sys_unlink(_lk_path(cd, "/lib/cve_m.cyr"));
    sys_unlink(_lk_path(cd, "/cyrius.lock"));
    sys_unlink(_lk_path(cd, "/cyrius.cyml"));
    sys_rmdir(_lk_path(cd, "/lib"));
    sys_rmdir(cd);

    var fail = 0;
    if (ec == 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": deps accepted a traversal sub-module name from index.cyml (CVE-32 unguarded)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": traversal sub-module name rejected (deps non-zero), no fs op before the guard");
    }
    _check(label, fail);
    return fail;
}

fn _deps_lock_gate(): i64 {
    var label = "cyrius deps --lock writes a non-empty recursive lock + --verify round-trips (v6.0.2; empty-lock-since-v5.11.8 regression)";

    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built\n");
        _check(label, 0);
        return 0;
    }

    var fx = _tmp_path("audit_deps_lock_");
    sys_mkdir(fx, 0x1ED);
    sys_mkdir(_lk_path(fx, "/lib"), 0x1ED);
    sys_mkdir(_lk_path(fx, "/lib/unicode"), 0x1ED);
    _write_file(_lk_path(fx, "/lib/foo.cyr"), "fn foo() { return 1; }\n");
    _write_file(_lk_path(fx, "/lib/unicode/cats.cyr"), "fn cats() { return 2; }\n");
    _write_file(_lk_path(fx, "/cyrius.cyml"), "[package]\nname = \"lock_gate_fixture\"\n");

    var lout = _tmp_path("audit_deps_lock_out_");
    var lec = _exec_in_dir3(fx, cyrius_bin, "deps", "--lock", 0, lout);

    var lock_path = _lk_path(fx, "/cyrius.lock");
    var lock_sz = 0;
    if (file_exists(lock_path) == 1) { lock_sz = _file_size(lock_path); }

    var has_subdir = 0;
    if (lock_sz > 0) {
        var lb = alloc(8192);
        var ln = file_read_all(lock_path, lb, 8191);
        if (ln > 0) {
            store8(lb + ln, 0);
            if (_find_str_from(lb, ln, 0, "lib/unicode/cats.cyr", 20) >= 0) { has_subdir = 1; }
        }
    }

    var vec_ec = _exec_in_dir3(fx, cyrius_bin, "deps", "--verify", 0, lout);

    # Cleanup before reporting so a failed assertion still cleans up.
    sys_unlink(lout);
    sys_unlink(lock_path);
    sys_unlink(_lk_path(fx, "/lib/unicode/cats.cyr"));
    sys_unlink(_lk_path(fx, "/lib/foo.cyr"));
    sys_unlink(_lk_path(fx, "/cyrius.cyml"));
    sys_rmdir(_lk_path(fx, "/lib/unicode"));
    sys_rmdir(_lk_path(fx, "/lib"));
    sys_rmdir(fx);

    var fail = 0;
    if (lec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cyrius deps --lock exited "); print_num(lec); println(" (expected 0)");
        fail = 1;
    } elif (lock_sz <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": cyrius.lock empty after --lock (symlink-filter regression returned?)");
        fail = 1;
    } elif (has_subdir == 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": cyrius.lock missing lib/unicode/cats.cyr (subdir recursion broken)");
        fail = 1;
    } elif (vec_ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cyrius deps --verify exited "); print_num(vec_ec); println(" (expected 0)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        _p(": cyrius.lock non-empty ("); print_num(lock_sz);
        println(" bytes, incl. unicode/ subdir) + --verify round-trips");
    }
    _check(label, fail);
    return fail;
}

# v6.2.40: drives the native scaffolder binary (build/cyrius-init)
# directly — the bash shims are gone. `scaffolder` is the binary path.
fn _scaffold_init(scratch_dir, scaffolder, flag, name): i64 {
    sys_mkdir(scratch_dir, 493);
    var out = _tmp_path("audit_init_out_");
    var ec = _exec_in_dir3(scratch_dir, scaffolder, flag, name, 0, out);
    sys_unlink(out);
    if (ec != 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, scratch_dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, name);
    return str_data(str_builder_build(sb));
}

fn _init_lib_bin_gate(): i64 {
    var label = "cyrius init --lib emits programs/smoke.cyr + [lib]; --bin/bare keep binary shape (v5.7.15)";
    var init_script = _root_path("build/cyrius-init");
    if (file_exists(init_script) != 1) {
        _p("  skip: ");
        _p(init_script);
        println(" missing");
        _check(label, 0);
        return 0;
    }
    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_init_lb_");
    sys_mkdir(scratch, 493);
    var fail = 0;

    # Case 1: --lib emits library shape, builds smoke clean.
    var c1 = _join(scratch, "case1");
    var p1 = _scaffold_init(c1, init_script, "--lib", "mylib");
    if (p1 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case1 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(p1, "programs/smoke.cyr", "case1 (--lib)");
        var test_path = _join(p1, "src/test.cyr");
        if (file_exists(test_path) == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case1 src/test.cyr emitted in lib shape (should be omitted)");
            fail = fail + 1;
        }
        fail = fail + _check_file_grep(p1, "cyrius.cyml", "[lib]",                          1, "case1");
        fail = fail + _check_file_grep(p1, "cyrius.cyml", "\ntest ",                        0, "case1");
        fail = fail + _check_file_grep(p1, "cyrius.cyml", "entry = \"programs/smoke.cyr\"", 1, "case1");
        # Build smoke + run.
        var build_out = _tmp_path("audit_init_b_");
        var ec_b = _exec_in_dir3(p1, cyrius_bin, "build", "programs/smoke.cyr", "build/mylib-smoke", build_out);
        sys_unlink(build_out);
        if (ec_b != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": case1 cyrius build smoke exit ");
            print_num(ec_b);
            println("");
            fail = fail + 1;
        } else {
            var smoke_bin = _join(p1, "build/mylib-smoke");
            if (file_exists(smoke_bin) != 1) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": case1 build/mylib-smoke not produced");
                fail = fail + 1;
            } else {
                var ec_r = _exec_run_clean(smoke_bin);
                if (ec_r != 0) {
                    _p("    ");
                    _p(ANSI_RED);
                    _p("case-FAIL");
                    _p(ANSI_RESET);
                    _p(": case1 smoke run exit ");
                    print_num(ec_r);
                    println("");
                    fail = fail + 1;
                }
            }
        }
    }

    # Case 2: --bin emits binary shape (existing behavior preserved).
    var c2 = _join(scratch, "case2");
    var p2 = _scaffold_init(c2, init_script, "--bin", "foo");
    if (p2 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case2 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(p2, "src/main.cyr", "case2 (--bin)");
        fail = fail + _check_file_exists(p2, "src/test.cyr", "case2 (--bin)");
        var prog_dir = _join(p2, "programs");
        if (file_exists(prog_dir) == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case2 programs/ created for bin shape (should not exist)");
            fail = fail + 1;
        }
        fail = fail + _check_file_grep(p2, "cyrius.cyml", "entry = \"src/main.cyr\"", 1, "case2");
        var build_out = _tmp_path("audit_init_b_");
        var ec_b = _exec_in_dir3(p2, cyrius_bin, "build", "src/main.cyr", "build/foo", build_out);
        sys_unlink(build_out);
        if (ec_b != 0) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": case2 cyrius build bin exit ");
            print_num(ec_b);
            println("");
            fail = fail + 1;
        } else {
            var bin_path = _join(p2, "build/foo");
            if (file_exists(bin_path) == 1) {
                var ec_r = _exec_run_clean(bin_path);
                if (ec_r != 0) {
                    _p("    ");
                    _p(ANSI_RED);
                    _p("case-FAIL");
                    _p(ANSI_RESET);
                    _p(": case2 bin run exit ");
                    print_num(ec_r);
                    println("");
                    fail = fail + 1;
                }
            }
        }
    }

    # Case 3: bare invocation defaults to bin.
    var c3 = _join(scratch, "case3");
    sys_mkdir(c3, 493);
    var c3_out = _tmp_path("audit_init_c3_");
    var ec_c3 = _exec_in_dir3(c3, init_script, "bareproj", 0, 0, c3_out);
    sys_unlink(c3_out);
    if (ec_c3 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case3 bare init exit non-zero");
        fail = fail + 1;
    } else {
        var p3 = _join(c3, "bareproj");
        var p3_prog = _join(p3, "programs");
        if (file_exists(p3_prog) == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case3 bare init created programs/ (should default to --bin)");
            fail = fail + 1;
        }
        fail = fail + _check_file_grep(p3, "cyrius.cyml", "entry = \"src/main.cyr\"", 1, "case3");
    }

    # Case 4: --lib CI workflow build cmd targets programs/smoke.cyr.
    var c4 = _join(scratch, "case4");
    var p4 = _scaffold_init(c4, init_script, "--lib", "libci");
    if (p4 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case4 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_grep(p4, ".github/workflows/ci.yml", "cyrius build src/main.cyr",                  0, "case4");
        fail = fail + _check_file_grep(p4, ".github/workflows/ci.yml", "cyrius build programs/smoke.cyr build/",    1, "case4");
    }

    _exec_in_dir3("/tmp", "/bin/rm", "-rf", scratch, 0, 0);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius init --lib/--bin/bare (4/4 cases)");
    }
    _check(label, fail);
    return fail;
}

fn _init_doctree_gate(): i64 {
    var label = "cyrius init/port emit adr/architecture/guides/examples/development + CLAUDE.md (v5.7.16)";
    # v6.2.40: native scaffolder binary; port mode via --__mode=port.
    var init_script = _root_path("build/cyrius-init");
    if (file_exists(init_script) != 1) {
        _p("  skip: build/cyrius-init missing");
        println("");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_init_dt_");
    sys_mkdir(scratch, 493);
    var fail = 0;

    # Case 1: cyrius init --lib emits full doc-tree.
    var c1 = _join(scratch, "case1");
    var p1 = _scaffold_init(c1, init_script, "--lib", "mylib");
    if (p1 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case1 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(p1, "docs/adr/README.md",                "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/adr/template.md",              "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/architecture/README.md",       "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/guides/getting-started.md",    "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/examples/.gitkeep",            "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/development/state.md",         "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "docs/development/roadmap.md",       "case1 (--lib)");
        fail = fail + _check_file_exists(p1, "CLAUDE.md",                         "case1 (--lib)");
        fail = fail + _check_file_grep(p1, "docs/adr/template.md", "# NNNN ",            1, "case1 ADR template");
        # Bash original: `grep -E '^\*\*Version\*\*: \[?[0-9]'` —
        # detects an INLINED version number (digit or `[` after the
        # bold marker). The valid CLAUDE.md text is `**Version**:
        # VERSION at the project root is the source of truth` (no
        # number). Approximate via "do not inline the number" check.
        fail = fail + _check_file_grep(p1, "CLAUDE.md", "do not inline the number",       1, "case1 CLAUDE.md version-sync hint");
        fail = fail + _check_file_grep(p1, "CLAUDE.md", "docs/development/state.md",     1, "case1 CLAUDE.md → state.md link");
        fail = fail + _check_file_grep(p1, "CLAUDE.md", "cyrius build programs/smoke.cyr", 1, "case1 CLAUDE.md lib build hint");
    }

    # Case 2: cyrius init --bin doc-tree.
    var c2 = _join(scratch, "case2");
    var p2 = _scaffold_init(c2, init_script, "--bin", "foo");
    if (p2 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case2 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(p2, "docs/adr/README.md",                "case2 (--bin)");
        fail = fail + _check_file_exists(p2, "docs/development/state.md",         "case2 (--bin)");
        fail = fail + _check_file_exists(p2, "CLAUDE.md",                         "case2 (--bin)");
        fail = fail + _check_file_grep(p2, "CLAUDE.md", "cyrius build src/main.cyr", 1, "case2 CLAUDE.md bin build hint");
    }

    # Case 3: bare cyrius init defaults to bin + still gets doc-tree.
    var c3 = _join(scratch, "case3");
    sys_mkdir(c3, 493);
    var c3_out = _tmp_path("audit_init_dt_c3_");
    var ec_c3 = _exec_in_dir3(c3, init_script, "bareproj", 0, 0, c3_out);
    sys_unlink(c3_out);
    if (ec_c3 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case3 bare init exit non-zero");
        fail = fail + 1;
    } else {
        var p3 = _join(c3, "bareproj");
        fail = fail + _check_file_exists(p3, "docs/adr/README.md",                "case3 (bare)");
        fail = fail + _check_file_exists(p3, "CLAUDE.md",                         "case3 (bare)");
    }

    # Case 4: cyrius port mirrors the same doc-tree.
    var c4 = _join(scratch, "case4/portproj");
    sys_mkdir(_join(scratch, "case4"), 493);
    sys_mkdir(c4, 493);
    sys_mkdir(_join(c4, "src"), 493);
    _write_file(_join(c4, "src/main.rs"), "fn main() {}\n");
    _write_file(_join(c4, "Cargo.toml"), "[package]\nname = \"portproj\"\nversion = \"0.1.0\"\nedition = \"2021\"\n");
    var c4_out = _tmp_path("audit_init_dt_c4_");
    var ec_c4 = _exec_in_dir3(_join(scratch, "case4"), init_script, "--__mode=port", c4, 0, c4_out);
    sys_unlink(c4_out);
    if (ec_c4 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case4 cyrius port exit ");
        print_num(ec_c4);
        println("");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_exists(c4, "docs/adr/README.md",                "case4 (cyrius port)");
        fail = fail + _check_file_exists(c4, "CLAUDE.md",                         "case4 (cyrius port)");
        fail = fail + _check_file_grep(c4, "CLAUDE.md", "rust-old", 1, "case4 port CLAUDE.md");
    }

    # Case 5: state.md carries 'Cyrius pin'; CLAUDE.md does not.
    var c5 = _join(scratch, "case5");
    var p5 = _scaffold_init(c5, init_script, "--lib", "pinproj");
    if (p5 == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": case5 init exit non-zero");
        fail = fail + 1;
    } else {
        fail = fail + _check_file_grep(p5, "docs/development/state.md", "Cyrius pin", 1, "case5 state.md pin line");
        fail = fail + _check_file_grep(p5, "CLAUDE.md",                  "\n- **Cyrius pin**", 0, "case5 CLAUDE.md no leaked pin");
    }

    _exec_in_dir3("/tmp", "/bin/rm", "-rf", scratch, 0, 0);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius init/port doc-tree (5/5 cases)");
    }
    _check(label, fail);
    return fail;
}

fn _fuzz_deps_prepend_gate(): i64 {
    var label = "cyrius fuzz manifest-deps auto-prepend parity with test/bench (v5.7.21)";
    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built");
        println("");
        _check(label, 0);
        return 0;
    }
    var fail = 0;

    # Case 1: manifest declares stdlib deps; .fcyr uses strlen.
    var sc1 = _tmp_path("audit_fuzz_deps1_");
    _mkdir_p(sc1);
    var sb_fuzz_dir1 = str_builder_new();
    str_builder_add_cstr(sb_fuzz_dir1, sc1);
    str_builder_add_cstr(sb_fuzz_dir1, "/fuzz");
    var fuzz_dir1 = str_data(str_builder_build(sb_fuzz_dir1));
    sys_mkdir(fuzz_dir1, 493);
    var sb_cyml1 = str_builder_new();
    str_builder_add_cstr(sb_cyml1, sc1);
    str_builder_add_cstr(sb_cyml1, "/cyrius.cyml");
    _write_file(str_data(str_builder_build(sb_cyml1)),
        "[package]\nname = \"fz1\"\nversion = \"0.1.0\"\nlicense = \"GPL-3.0-only\"\nlanguage = \"cyrius\"\n\n[deps]\nstdlib = [\"string\", \"syscalls\"]\n");
    var sb_fcyr1 = str_builder_new();
    str_builder_add_cstr(sb_fcyr1, fuzz_dir1);
    str_builder_add_cstr(sb_fcyr1, "/uses_stdlib.fcyr");
    _write_file(str_data(str_builder_build(sb_fcyr1)),
        "fn fuzz_main(data, n) {\n    if (n == 0) { return 0; }\n    if (strlen(\"hello\") != 5) { return 1; }\n    return 0;\n}\nfn main() {\n    if (fuzz_main(\"dummy\", 5) != 0) { syscall(60, 1); }\n    syscall(60, 0);\n    return 0;\n}\nvar r = main();\nsyscall(60, r);\n");
    var out1 = _tmp_path("audit_fuzz_out1_");
    var ec1 = _exec_in_dir(sc1, cyrius_bin, "fuzz", out1);
    if (ec1 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case1 cyrius fuzz exited ");
        print_num(ec1);
        println(" (auto-prepend not working)");
        fail = fail + 1;
    } else { if (_file_contains_substr(out1, "1 passed, 0 failed") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case1 fuzz ran but did not summarize '1 passed, 0 failed'");
            fail = fail + 1;
        } }
    sys_unlink(out1);

    # Case 2: no manifest; .fcyr self-contained.
    var sc2 = _tmp_path("audit_fuzz_deps2_");
    _mkdir_p(sc2);
    var sb_fuzz_dir2 = str_builder_new();
    str_builder_add_cstr(sb_fuzz_dir2, sc2);
    str_builder_add_cstr(sb_fuzz_dir2, "/fuzz");
    var fuzz_dir2 = str_data(str_builder_build(sb_fuzz_dir2));
    sys_mkdir(fuzz_dir2, 493);
    var sb_fcyr2 = str_builder_new();
    str_builder_add_cstr(sb_fcyr2, fuzz_dir2);
    str_builder_add_cstr(sb_fcyr2, "/standalone.fcyr");
    _write_file(str_data(str_builder_build(sb_fcyr2)),
        "fn fuzz_main(data, n) {\n    if (n == 0) { return 0; }\n    return 0;\n}\nfn main() {\n    if (fuzz_main(\"x\", 1) != 0) { syscall(60, 1); }\n    syscall(60, 0);\n    return 0;\n}\nvar r = main();\nsyscall(60, r);\n");
    var out2 = _tmp_path("audit_fuzz_out2_");
    var ec2 = _exec_in_dir(sc2, cyrius_bin, "fuzz", out2);
    if (ec2 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case2 cyrius fuzz exited ");
        print_num(ec2);
        println(" (no-manifest path broken)");
        fail = fail + 1;
    }
    sys_unlink(out2);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius fuzz auto-prepend parity (2/2 cases)");
    }
    _check(label, fail);
    return fail;
}

fn _deps_transitive_gate(): i64 {
    var label = "cyrius deps walks [deps.X] transitively (3-level + diamond + cycle + rel-path; v5.7.14)";
    var cyrius_bin = _root_path("build/cyrius");
    if (file_exists(cyrius_bin) != 1) {
        _p("  skip: build/cyrius not built");
        println("");
        _check(label, 0);
        return 0;
    }
    var fail = 0;

    # ── Case 1: 3-level chain A→B→C ──
    var sc1 = _tmp_path("audit_deps_chain_");
    var dirs1[7];
    store64(&dirs1,      sc1);
    var p1 = str_builder_new();
    str_builder_add_cstr(p1, sc1);
    str_builder_add_cstr(p1, "/A");
    var a1 = str_data(str_builder_build(p1));
    var p1b = str_builder_new();
    str_builder_add_cstr(p1b, sc1);
    str_builder_add_cstr(p1b, "/B/dist");
    var b1d = str_data(str_builder_build(p1b));
    var p1c = str_builder_new();
    str_builder_add_cstr(p1c, sc1);
    str_builder_add_cstr(p1c, "/C/dist");
    var c1d = str_data(str_builder_build(p1c));
    _mkdir_p(a1);
    _mkdir_p(b1d);
    _mkdir_p(c1d);

    var sbBcyr = str_builder_new();
    str_builder_add_cstr(sbBcyr, sc1);
    str_builder_add_cstr(sbBcyr, "/B/dist/B.cyr");
    _write_file(str_data(str_builder_build(sbBcyr)), "# B\n");
    var sbCcyr = str_builder_new();
    str_builder_add_cstr(sbCcyr, sc1);
    str_builder_add_cstr(sbCcyr, "/C/dist/C.cyr");
    _write_file(str_data(str_builder_build(sbCcyr)), "# C\n");

    var sbCyml_C = str_builder_new();
    str_builder_add_cstr(sbCyml_C, sc1);
    str_builder_add_cstr(sbCyml_C, "/C/cyrius.cyml");
    _write_file(str_data(str_builder_build(sbCyml_C)),
        "[package]\nname = \"C\"\n[lib]\nmodules = [\"dist/C.cyr\"]\n");

    var sbCyml_B = str_builder_new();
    str_builder_add_cstr(sbCyml_B, sc1);
    str_builder_add_cstr(sbCyml_B, "/B/cyrius.cyml");
    var sbCB = str_builder_new();
    str_builder_add_cstr(sbCB, "[package]\nname = \"B\"\n[deps.C]\npath = \"");
    str_builder_add_cstr(sbCB, sc1);
    str_builder_add_cstr(sbCB, "/C\"\nmodules = [\"dist/C.cyr\"]\n");
    _write_file(str_data(str_builder_build(sbCyml_B)),
        str_data(str_builder_build(sbCB)));

    var sbCyml_A = str_builder_new();
    str_builder_add_cstr(sbCyml_A, sc1);
    str_builder_add_cstr(sbCyml_A, "/A/cyrius.cyml");
    var sbCA = str_builder_new();
    str_builder_add_cstr(sbCA, "[package]\nname = \"A\"\n[deps.B]\npath = \"");
    str_builder_add_cstr(sbCA, sc1);
    str_builder_add_cstr(sbCA, "/B\"\nmodules = [\"dist/B.cyr\"]\n");
    _write_file(str_data(str_builder_build(sbCyml_A)),
        str_data(str_builder_build(sbCA)));

    var out1 = _tmp_path("audit_deps_chain_out_");
    var ec1 = _exec_in_dir(a1, cyrius_bin, "deps", out1);
    if (ec1 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case1 (3-level chain) cyrius deps exited ");
        print_num(ec1);
        println("");
        fail = fail + 1;
    } else {
        # Both B.cyr and C.cyr should appear under A/lib/
        var sbAB = str_builder_new();
        str_builder_add_cstr(sbAB, a1);
        str_builder_add_cstr(sbAB, "/lib/B.cyr");
        var sbAC = str_builder_new();
        str_builder_add_cstr(sbAC, a1);
        str_builder_add_cstr(sbAC, "/lib/C.cyr");
        if (file_exists(str_data(str_builder_build(sbAB))) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case1 — A/lib/B.cyr missing");
            fail = fail + 1;
        }
        if (file_exists(str_data(str_builder_build(sbAC))) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case1 — A/lib/C.cyr missing (transitive not resolved)");
            fail = fail + 1;
        }
    }
    sys_unlink(out1);

    # ── Case 2: diamond A→{B,C}→D, dedup ──
    var sc2 = _tmp_path("audit_deps_diam_");
    var p2a = str_builder_new();
    str_builder_add_cstr(p2a, sc2);
    str_builder_add_cstr(p2a, "/A");
    var a2 = str_data(str_builder_build(p2a));
    _mkdir_p(a2);
    var p2bd = str_builder_new();
    str_builder_add_cstr(p2bd, sc2);
    str_builder_add_cstr(p2bd, "/B/dist");
    _mkdir_p(str_data(str_builder_build(p2bd)));
    var p2cd = str_builder_new();
    str_builder_add_cstr(p2cd, sc2);
    str_builder_add_cstr(p2cd, "/C/dist");
    _mkdir_p(str_data(str_builder_build(p2cd)));
    var p2dd = str_builder_new();
    str_builder_add_cstr(p2dd, sc2);
    str_builder_add_cstr(p2dd, "/D/dist");
    _mkdir_p(str_data(str_builder_build(p2dd)));

    var pBcyr = str_builder_new();
    str_builder_add_cstr(pBcyr, sc2);
    str_builder_add_cstr(pBcyr, "/B/dist/B.cyr");
    _write_file(str_data(str_builder_build(pBcyr)), "# B\n");
    var pCcyr = str_builder_new();
    str_builder_add_cstr(pCcyr, sc2);
    str_builder_add_cstr(pCcyr, "/C/dist/C.cyr");
    _write_file(str_data(str_builder_build(pCcyr)), "# C\n");
    var pDcyr = str_builder_new();
    str_builder_add_cstr(pDcyr, sc2);
    str_builder_add_cstr(pDcyr, "/D/dist/D.cyr");
    _write_file(str_data(str_builder_build(pDcyr)), "# D\n");

    var pDyml = str_builder_new();
    str_builder_add_cstr(pDyml, sc2);
    str_builder_add_cstr(pDyml, "/D/cyrius.cyml");
    _write_file(str_data(str_builder_build(pDyml)),
        "[package]\nname = \"D\"\n[lib]\nmodules = [\"dist/D.cyr\"]\n");

    var pByml = str_builder_new();
    str_builder_add_cstr(pByml, sc2);
    str_builder_add_cstr(pByml, "/B/cyrius.cyml");
    var pByml_body = str_builder_new();
    str_builder_add_cstr(pByml_body, "[package]\nname = \"B\"\n[deps.D]\npath = \"");
    str_builder_add_cstr(pByml_body, sc2);
    str_builder_add_cstr(pByml_body, "/D\"\nmodules = [\"dist/D.cyr\"]\n");
    _write_file(str_data(str_builder_build(pByml)),
        str_data(str_builder_build(pByml_body)));

    var pCyml = str_builder_new();
    str_builder_add_cstr(pCyml, sc2);
    str_builder_add_cstr(pCyml, "/C/cyrius.cyml");
    var pCyml_body = str_builder_new();
    str_builder_add_cstr(pCyml_body, "[package]\nname = \"C\"\n[deps.D]\npath = \"");
    str_builder_add_cstr(pCyml_body, sc2);
    str_builder_add_cstr(pCyml_body, "/D\"\nmodules = [\"dist/D.cyr\"]\n");
    _write_file(str_data(str_builder_build(pCyml)),
        str_data(str_builder_build(pCyml_body)));

    var pAyml = str_builder_new();
    str_builder_add_cstr(pAyml, sc2);
    str_builder_add_cstr(pAyml, "/A/cyrius.cyml");
    var pAyml_body = str_builder_new();
    str_builder_add_cstr(pAyml_body, "[package]\nname = \"A\"\n[deps.B]\npath = \"");
    str_builder_add_cstr(pAyml_body, sc2);
    str_builder_add_cstr(pAyml_body, "/B\"\nmodules = [\"dist/B.cyr\"]\n[deps.C]\npath = \"");
    str_builder_add_cstr(pAyml_body, sc2);
    str_builder_add_cstr(pAyml_body, "/C\"\nmodules = [\"dist/C.cyr\"]\n");
    _write_file(str_data(str_builder_build(pAyml)),
        str_data(str_builder_build(pAyml_body)));

    var out2 = _tmp_path("audit_deps_diam_out_");
    var ec2 = _exec_in_dir(a2, cyrius_bin, "deps", out2);
    if (ec2 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case2 (diamond) cyrius deps exited ");
        print_num(ec2);
        println("");
        fail = fail + 1;
    } else { if (_file_contains_substr(out2, "3 deps resolved") != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": case2 (diamond) — '3 deps resolved' not in stdout (D not dedup'd?)");
            fail = fail + 1;
        } }
    sys_unlink(out2);

    # ── Case 3: cycle A→B→A — must terminate, exit 0 ──
    var sc3 = _tmp_path("audit_deps_cyc_");
    var p3a = str_builder_new();
    str_builder_add_cstr(p3a, sc3);
    str_builder_add_cstr(p3a, "/A/dist");
    _mkdir_p(str_data(str_builder_build(p3a)));
    var p3b = str_builder_new();
    str_builder_add_cstr(p3b, sc3);
    str_builder_add_cstr(p3b, "/B/dist");
    _mkdir_p(str_data(str_builder_build(p3b)));

    var p3Acyr = str_builder_new();
    str_builder_add_cstr(p3Acyr, sc3);
    str_builder_add_cstr(p3Acyr, "/A/dist/A.cyr");
    _write_file(str_data(str_builder_build(p3Acyr)), "# A\n");
    var p3Bcyr = str_builder_new();
    str_builder_add_cstr(p3Bcyr, sc3);
    str_builder_add_cstr(p3Bcyr, "/B/dist/B.cyr");
    _write_file(str_data(str_builder_build(p3Bcyr)), "# B\n");

    var p3Ayml = str_builder_new();
    str_builder_add_cstr(p3Ayml, sc3);
    str_builder_add_cstr(p3Ayml, "/A/cyrius.cyml");
    var p3A_body = str_builder_new();
    str_builder_add_cstr(p3A_body, "[package]\nname = \"A\"\n[deps.B]\npath = \"");
    str_builder_add_cstr(p3A_body, sc3);
    str_builder_add_cstr(p3A_body, "/B\"\nmodules = [\"dist/B.cyr\"]\n");
    _write_file(str_data(str_builder_build(p3Ayml)),
        str_data(str_builder_build(p3A_body)));

    var p3Byml = str_builder_new();
    str_builder_add_cstr(p3Byml, sc3);
    str_builder_add_cstr(p3Byml, "/B/cyrius.cyml");
    var p3B_body = str_builder_new();
    str_builder_add_cstr(p3B_body, "[package]\nname = \"B\"\n[deps.A]\npath = \"");
    str_builder_add_cstr(p3B_body, sc3);
    str_builder_add_cstr(p3B_body, "/A\"\nmodules = [\"dist/A.cyr\"]\n");
    _write_file(str_data(str_builder_build(p3Byml)),
        str_data(str_builder_build(p3B_body)));

    var sb3a = str_builder_new();
    str_builder_add_cstr(sb3a, sc3);
    str_builder_add_cstr(sb3a, "/A");
    var a3 = str_data(str_builder_build(sb3a));
    var out3 = _tmp_path("audit_deps_cyc_out_");
    var ec3 = _exec_in_dir(a3, cyrius_bin, "deps", out3);
    if (ec3 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": case3 (cycle) — expected exit 0, got ");
        print_num(ec3);
        println(" (likely infinite-loop pre-v5.7.14)");
        fail = fail + 1;
    }
    sys_unlink(out3);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrius deps transitive walk + dedup + cycle-break (3/3 cases; v5.7.14)");
    }
    _check(label, fail);
    return fail;
}
