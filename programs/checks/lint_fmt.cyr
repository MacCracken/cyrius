# ================================================================
# programs/checks/lint_fmt.cyr — cyrfmt + cyrlint + parse-drift + doc-coverage source-hygiene gates
# ================================================================
# v6.0.90: split out of the monolithic programs/check.cyr (10.2K LoC).
# Fn DEFINITIONS only — no includes, no module-level vars, no driver.
# All lib includes + the 18 globals + the dispatcher/driver live in
# programs/checks/main.cyr, which includes this file. See CHANGELOG [6.0.90].

fn _cyrfmt_idempotent_subcase(case_label, fixture_path): i64 {
    var args = vec_new();
    vec_push(args, CYRFMT_PATH);
    vec_push(args, fixture_path);
    var cap = 65536;
    var out_buf = alloc(cap);
    var out_n = exec_capture(args, out_buf, cap);

    var orig_buf = alloc(cap);
    var orig_n = file_read_all(fixture_path, orig_buf, cap);
    if (orig_n < 0) { orig_n = 0; }

    var ok = 0;
    if (out_n == orig_n) { ok = _buf_eq(out_buf, orig_buf, out_n); }
    if (ok != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(case_label);
        _p(" — cyrfmt output drifted (");
        print_num(out_n);
        _p(" got, ");
        print_num(orig_n);
        println(" original)");
        return 1;
    }
    return 0;
}

fn _cyrfmt_comment_braces_gate(): i64 {
    if (CYRFMT_PATH == 0) {
        _p("  skip: cyrfmt not built");
        println("");
        _check("cyrfmt skips {/} inside # comments + string literals (v5.7.22; agnos issue)", 0);
        return 0;
    }
    if (file_exists(CYRFMT_PATH) != 1) {
        _p("  skip: cyrfmt not built");
        println("");
        _check("cyrfmt skips {/} inside # comments + string literals (v5.7.22; agnos issue)", 0);
        return 0;
    }
    var fail = 0;
    fail = fail + _cyrfmt_idempotent_subcase("asm-in-doc-comment",
        _root_path("tests/fixtures/cyrfmt_braces/asm_in_doc.cyr"));
    fail = fail + _cyrfmt_idempotent_subcase("string-with-braces",
        _root_path("tests/fixtures/cyrfmt_braces/string_with_braces.cyr"));
    fail = fail + _cyrfmt_idempotent_subcase("well-formed",
        _root_path("tests/fixtures/cyrfmt_braces/well_formed.cyr"));
    fail = fail + _cyrfmt_idempotent_subcase("mixed",
        _root_path("tests/fixtures/cyrfmt_braces/mixed.cyr"));
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": cyrfmt skips braces in comments/strings (4/4 cases)");
    }
    _check("cyrfmt skips {/} inside # comments + string literals (v5.7.22; agnos issue)", fail);
    return fail;
}

fn _parse_drift_scan(path, buf, cap): i64 {
    var n = file_read_all(path, buf, cap);
    if (n < 0) { return 0; }     # missing file — not a failure
    var hits = 0;
    hits = hits + _count_substr_buf(buf, n, "EB(S, 0x");
    hits = hits + _count_substr_buf(buf, n, "E2(S, 0x");
    hits = hits + _count_substr_buf(buf, n, "E3(S, 0x");
    hits = hits + _count_substr_buf(buf, n, "EW(S, 0x");
    hits = hits + _count_substr_buf(buf, n, "E8(S, 0x");
    if (hits > 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(path);
        _p(" — direct-emit site(s) found (should be 0 after path-A v5.11.35-.37)\n");
    }
    return hits;
}

fn _parse_emit_drift_gate(): i64 {
    var cap = 262144;     # 256 KB — fits any parse_*.cyr
    var buf = alloc(cap);
    var fail = 0;
    # Scope: all 6 parse files. v5.11.38 covered the 5 audited
    # leaves; v5.11.39 added `ESWITCH_DISPATCH_PRE` +
    # `ESWITCH_DISPATCH_TABLE` named ops that closed parse.cyr's
    # switch-jump-table direct emits. parse.cyr now joins the gate.
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse.cyr"),       buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_ctrl.cyr"),  buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_decl.cyr"),  buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_expr.cyr"),  buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_fn.cyr"),    buf, cap);
    fail = fail + _parse_drift_scan(_root_path("src/frontend/parse_types.cyr"), buf, cap);
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": no direct emits in all 6 parse_*.cyr files (path-A baseline at v5.11.39)\n");
    }
    _check("path-A drift gate: parse_*.cyr direct-emit zero baseline (v5.11.39)", fail);
    return fail;
}

fn _cc5_contamination_gate(): i64 {
    var path = _root_path("build/cycc");
    var cap = 2097152;    # 2 MB — fits cycc (~821 KB) with headroom
    var buf = alloc(cap);
    var n = file_read_all(path, buf, cap);
    if (n < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": build/cycc not readable\n");
        _check("build/cycc contamination gate (v5.11.45)", 1);
        return 1;
    }
    var hits = 0;
    hits = hits + _count_substr_buf(buf, n, "mabda: gpu");
    hits = hits + _count_substr_buf(buf, n, "wgpuDevice");
    hits = hits + _count_substr_buf(buf, n, "compute_pipeline");
    if (hits > 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": build/cycc contains mabda/wgpu strings — likely contaminated (see CHANGELOG [5.11.44] postmortem)\n");
    }
    _check("build/cycc contamination gate (v5.11.45; no mabda/wgpu strings)", hits);
    return hits;
}

fn _cyrlint_count_marker(file_path, marker, buf, buflen): i64 {
    var n = _exec_with_arg_capture_both(CYRLINT_PATH, file_path, buf, buflen);
    return _count_substr_buf(buf, n, marker);
}

fn _cyrlint_large_file_gate(): i64 {
    if (CYRLINT_PATH == 0) {
        _p("  skip: cyrlint not built");
        println("");
        _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", 0);
        return 0;
    }
    if (file_exists(CYRLINT_PATH) != 1) {
        _p("  skip: cyrlint not built");
        println("");
        _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", 0);
        return 0;
    }

    var src_path = _tmp_path("audit_cyrlint_lf_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) {
        _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", 1);
        return 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "# v5.8.41 regression floor - cyrlint large-file false-positive.\n");
    str_builder_add_cstr(sb, "include \"lib/syscalls.cyr\"\n");
    str_builder_add_cstr(sb, "include \"lib/alloc.cyr\"\n");
    str_builder_add_cstr(sb, "include \"lib/assert.cyr\"\n\n");
    str_builder_add_cstr(sb, "alloc_init();\n\n");
    var i = 0;
    while (i < 700) {
        str_builder_add_cstr(sb, "fn _check_");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, "() {\n    test_group(\"group ");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, "\");\n    assert_eq(\n        ");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, ",\n        ");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, ",\n        \"self equality\"\n    );\n    return 0;\n}\n\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "syscall(60, 0);\n");
    var s = str_builder_build(sb);
    sys_write(fd, str_data(s), str_len(s));
    sys_close(fd);

    var line_count = _count_substr_buf(str_data(s), str_len(s), "\n");
    if (line_count < 3270) {
        sys_unlink(src_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": synthetic only ");
        print_num(line_count);
        println(" lines (need >=3270 to trigger the historic bug)");
        _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", 1);
        return 1;
    }

    var cap = 65536;
    var buf = alloc(cap);
    var unclosed = _cyrlint_count_marker(src_path, "unclosed braces at end of file", buf, cap);
    var trailing_ws = _cyrlint_count_marker(src_path, "trailing whitespace", buf, cap);
    sys_unlink(src_path);

    var fail = 0;
    if (unclosed != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        print_num(line_count);
        _p("-line file produced ");
        print_num(unclosed);
        println(" 'unclosed braces' warning(s) — historic bug regression");
        fail = fail + 1;
    }
    if (trailing_ws != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        print_num(line_count);
        _p("-line file produced ");
        print_num(trailing_ws);
        println(" 'trailing whitespace' warning(s) — likely v5.8.41 file-size false-positive regression");
        fail = fail + 1;
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": cyrlint clean on ");
        print_num(line_count);
        println("-line synthetic (mabda 2026-04-28 repro shape; floor for v5.8.41)");
    }
    _check("cyrlint clean on 7K-line synthetic (mabda 2026-04-28 repro shape; v5.8.41 floor)", fail);
    return fail;
}

fn _lint_init_order_gate(): i64 {
    if (CYRLINT_PATH == 0) {
        _p("  skip: cyrlint not built");
        println("");
        _check("cyrlint flags forward-ref var inits (v5.7.32; mabda-surfaced)", 0);
        return 0;
    }
    if (file_exists(CYRLINT_PATH) != 1) {
        _p("  skip: cyrlint not built");
        println("");
        _check("cyrlint flags forward-ref var inits (v5.7.32; mabda-surfaced)", 0);
        return 0;
    }
    var fail = 0;
    var cap = 65536;
    var buf = alloc(cap);
    var marker = "global var init refs";

    var bad_fixture = _root_path("tests/fixtures/lint_init_order/forward_refs.cyr");
    var bad_count = _cyrlint_count_marker(bad_fixture, marker, buf, cap);
    if (bad_count < 3) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": forward_refs fixture produced ");
        print_num(bad_count);
        println(" warnings (expected ≥3)");
        fail = fail + 1;
    }

    var math_path = _root_path("lib/math.cyr");
    var math_count = _cyrlint_count_marker(math_path, marker, buf, cap);
    if (math_count != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": lib/math.cyr produced ");
        print_num(math_count);
        println(" false-positive forward-ref warnings");
        fail = fail + 1;
    }

    var str_path = _root_path("lib/string.cyr");
    var str_count = _cyrlint_count_marker(str_path, marker, buf, cap);
    if (str_count != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": lib/string.cyr produced ");
        print_num(str_count);
        println(" false-positive forward-ref warnings");
        fail = fail + 1;
    }

    var strlit_fixture = _root_path("tests/fixtures/lint_init_order/string_literal_safe.cyr");
    var strlit_count = _cyrlint_count_marker(strlit_fixture, marker, buf, cap);
    if (strlit_count != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": string-literal fixture produced ");
        print_num(strlit_count);
        println(" false-positive forward-ref warnings (v5.7.36 string-lit awareness)");
        fail = fail + 1;
    }

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": cyrlint flags forward-ref var inits (");
        print_num(bad_count);
        println(" on fixture; 0 false-positives on stdlib + string-literal scope; v5.7.32 + v5.7.36)");
    }
    _check("cyrlint flags forward-ref var inits (v5.7.32; mabda-surfaced)", fail);
    return fail;
}

fn _doc_parse_undocumented(buf, n): i64 {
    var needle = " undocumented";
    var nlen = strlen(needle);
    var found = 0 - 1;
    var i = 0;
    while (i + nlen <= n) {
        if (_buf_eq(buf + i, needle, nlen) == 1) {
            found = i;
        }
        i = i + 1;
    }
    if (found < 0) { return 0; }
    var end = found;
    var start = end;
    while (start > 0) {
        var c = load8(buf + start - 1);
        if (c < 48) { return _aw_parse_leading_int(buf + start, end - start); }
        if (c > 57) { return _aw_parse_leading_int(buf + start, end - start); }
        start = start - 1;
    }
    return _aw_parse_leading_int(buf + start, end - start);
}

fn _reserved_kw_diag_gate(): i64 {
    var fail = 0;
    fail = fail + _stderr_match_subcase("var match",
        "include \"lib/syscalls.cyr\"\nfn foo() { var match = 1; return match; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword 'match'", 1);
    fail = fail + _stderr_match_subcase("var in",
        "include \"lib/syscalls.cyr\"\nfn foo() { var in = 1; return in; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword 'in'", 1);
    fail = fail + _stderr_match_subcase("var default",
        "include \"lib/syscalls.cyr\"\nfn foo() { var default = 1; return default; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword 'default'", 1);
    fail = fail + _stderr_match_subcase("var shared",
        "include \"lib/syscalls.cyr\"\nfn foo() { var shared = 1; return shared; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword 'shared'", 1);
    fail = fail + _stderr_match_subcase("hint-text-match",
        "include \"lib/syscalls.cyr\"\nfn foo() { var match = 1; return match; }\nfoo();\nsyscall(60, 0);\n",
        "cannot be used as an identifier", 1);
    fail = fail + _stderr_match_subcase("legit-ident-no-falsepositive",
        "include \"lib/syscalls.cyr\"\nfn foo() { var my_var = 1; return my_var; }\nfoo();\nsyscall(60, 0);\n",
        "reserved keyword", 0);
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": reserved keyword diagnostic (4 kw + hint + negative control)");
    }
    _check("'var match/in/default/shared' \xe2\x86\x92 'reserved keyword ... cannot be used as identifier'", fail);
    return fail;
}

fn _fn_collision_gate(): i64 {
    var fail = 0;
    fail = fail + _stderr_match_subcase("same-arity duplicate",
        "fn dup_a(x) { return x + 1; }\nfn dup_a(x) { return x + 2; }\nsyscall(60, 0);\n",
        "duplicate fn 'dup_a'", 1);
    fail = fail + _stderr_match_subcase("different-arity duplicate",
        "fn dup_b(a) { return a; }\nfn dup_b(a, b) { return a + b; }\nsyscall(60, 0);\n",
        "duplicate fn 'dup_b'", 1);
    fail = fail + _stderr_match_subcase("forward-decl mutual recursion",
        "fn caller_one(n) { if (n <= 0) { return 0; } return callee_two(n - 1); }\nfn callee_two(n) { if (n <= 0) { return 0; } return caller_one(n - 1); }\nsyscall(60, caller_one(3));\n",
        "duplicate fn", 0);
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": fn-name collision warning (3/3 cases)");
    }
    _check("duplicate fn warns; forward-decl no false-positive (v5.7.9)", fail);
    return fail;
}

fn _string_escape_rejects_gate(): i64 {
    var fail = 0;
    fail = fail + _stderr_match_subcase("x: bad-hex-1st-nibble",
        "var s = \"\\xZ0\"; syscall(60, 0);",
        "\\x escape: bad hex digit", 1);
    fail = fail + _stderr_match_subcase("x: bad-hex-2nd-nibble",
        "var s = \"\\x1Z\"; syscall(60, 0);",
        "\\x escape: bad hex digit", 1);
    fail = fail + _stderr_match_subcase("u: bad-hex",
        "var s = \"\\u00Z0\"; syscall(60, 0);",
        "\\u escape: bad hex digit", 1);
    fail = fail + _stderr_match_subcase("u: surrogate-low",
        "var s = \"\\uD800\"; syscall(60, 0);",
        "surrogate codepoint not allowed", 1);
    fail = fail + _stderr_match_subcase("u: surrogate-high",
        "var s = \"\\uDFFF\"; syscall(60, 0);",
        "surrogate codepoint not allowed", 1);
    fail = fail + _stderr_match_subcase("u{}: empty",
        "var s = \"\\u{}\"; syscall(60, 0);",
        "\\u{...} escape: no hex digits", 1);
    fail = fail + _stderr_match_subcase("u{}: bad-hex",
        "var s = \"\\u{1G}\"; syscall(60, 0);",
        "\\u{...} escape: bad hex digit", 1);
    fail = fail + _stderr_match_subcase("u{}: too-many-digits",
        "var s = \"\\u{1234567}\"; syscall(60, 0);",
        "\\u{...} escape: > 6 hex digits", 1);
    fail = fail + _stderr_match_subcase("u{}: above-max-codepoint",
        "var s = \"\\u{110000}\"; syscall(60, 0);",
        "codepoint > U+10FFFF", 1);
    fail = fail + _stderr_match_subcase("u{}: surrogate-low",
        "var s = \"\\u{D800}\"; syscall(60, 0);",
        "surrogate codepoint not allowed", 1);
    fail = fail + _stderr_match_subcase("u{}: surrogate-high",
        "var s = \"\\u{DFFF}\"; syscall(60, 0);",
        "surrogate codepoint not allowed", 1);
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": string-escape reject cases (11/11)");
    }
    _check("lex rejects malformed \\x## / \\u#### / \\u{...} + surrogates (v5.7.13)", fail);
    return fail;
}

# CVE-31 (v6.1.35): the compiler must LOUDLY reject broken input it used to
# silently accept — an unrecognized ASCII byte that matched no token (was
# skipped) and a missing include file (was a 0-byte expansion surfacing only as
# downstream undefined-fn warnings). Mirrors _string_escape_rejects_gate.
fn _input_validation_rejects_gate(): i64 {
    var fail = 0;
    # CVE-31b — stray ASCII byte (`$`) outside strings/comments is an error.
    # _input_rejects_subcase asserts BOTH the message AND a nonzero exit, so a
    # future print-then-exit-0 regression can't slip the reject past the gate.
    fail = fail + _input_rejects_subcase("stray-ascii-dollar",
        "fn main(): i64 { var x = 5 $ 3; return x; }",
        "unexpected character");
    # CVE-31a — a missing include is a hard error, not a silent empty expansion.
    fail = fail + _input_rejects_subcase("missing-include",
        "include \"zzqq_no_such_include_file.cyr\";\nfn main(): i64 { return 0; }",
        "cannot open include file");
    # CVE-24 (v6.1.40) — a function whose stack frame exceeds the 16384-slot local
    # tables (a >128 KB `stack var`) is loudly capped in SFLC, not silently
    # overflowed into the neighbouring slot-indexed tables.
    fail = fail + _input_rejects_subcase("stack-frame-overflow",
        "fn big() { stack var buf[200000]; store8(&buf + 0, 1); return load8(&buf + 0); }\nfn main(): i64 { return big(); }",
        "too many stack slots");
    # CVE-16/CVE-02 (v6.1.41) — a rejected hostile include (absolute / parent-traversal)
    # must FAIL the build (nonzero exit), not print 'error:' then exit 0 as a silent
    # empty include. The reject returns -1 so the PP's `nr < 0` guards fire SYS_EXIT.
    fail = fail + _input_rejects_subcase("absolute-include-reject",
        "include \"/etc/passwd\";\nfn main(): i64 { return 0; }",
        "absolute include path rejected");
    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": input-validation reject cases (4/4)");
    }
    _check("lex/PP reject stray ASCII + missing/absolute include + oversized frame (CVE-31/24/16)", fail);
    return fail;
}

# CVE-17 / distlib net (v6.1.36): a vendored dist bundle (a folded dep in
# lib/*.cyr) MUST be self-contained — no `include "src/*.cyr"` referencing a
# src/ tree that is absent at the consumer. sigil 3.7.11's `regen-dist.sh`
# dumb-`cat` shipped un-inlined includes (the `#ifndef` guards papered over it);
# fixed at the source in sigil 3.7.12, but this gate is the SYSTEMIC net so ANY
# future dep fold that ships un-inlined src-includes fails loudly here,
# regardless of the dep's own dist tooling. (Cyrius's own `cyrius distlib`
# already strips includes.) The leading `\n` in the needle matches a line-start
# directive only, so in-comment mentions of `include "src/..."` don't trip it.
fn _vendored_dist_selfcontained_gate(): i64 {
    _section("Vendored dist self-containment (distlib)");
    var dir = _root_path("lib");
    var dir_str = str_from(dir);
    var entries = dir_list(dir_str);
    var cap = 4194304;                          # 4 MB (largest fold ~715 KB)
    var buf = alloc(cap);
    var fail = 0;
    var i = 0;
    while (i < vec_len(entries)) {
        var name = vec_get(entries, i);
        if (path_has_ext(name, str_from(".cyr")) == 1) {
            var full = path_join(dir_str, name);
            var n = file_read_all(str_data(full), buf, cap - 1);
            if (n > 0) {
                # Scan line by line: an `include "src/` directive at a line start
                # (after optional leading whitespace) is the un-inlined dep-fold
                # bug. Line-based — so an INDENTED or FIRST-LINE include is caught,
                # while an in-comment mention (line starts with `#`) is not.
                var pos = 0;
                while (pos < n) {
                    var le = pos;                       # find end of this line
                    var scanning = 1;
                    while (scanning == 1) {
                        if (le >= n) { scanning = 0; }
                        elif ((load8(buf + le) & 0xFF) == 10) { scanning = 0; }
                        else { le = le + 1; }
                    }
                    var c = pos;                        # skip leading spaces/tabs
                    var skipping = 1;
                    while (skipping == 1) {
                        if (c >= le) { skipping = 0; }
                        else {
                            var ch = load8(buf + c) & 0xFF;
                            if (ch == 32) { c = c + 1; }
                            elif (ch == 9) { c = c + 1; }
                            else { skipping = 0; }
                        }
                    }
                    if (le - c >= 13) {
                        if (_buf_eq(buf + c, "include \"src/", 13) == 1) {
                            fail = 1;
                            _p("    un-inlined `include \"src/` in lib/");
                            print(str_data(name), str_len(name));
                            _p("\n");
                        }
                    }
                    pos = le + 1;
                }
            }
        }
        i = i + 1;
    }
    _check("vendored lib/*.cyr self-contained (no un-inlined `include \"src/\"`)", fail);
    return fail;
}

fn _format_gate(): i64 {
    _section("Format");
    if (CYRFMT_PATH == 0) {
        println("  cyrfmt not found in build/ or on PATH — install via 'cyriusly setup' or build via build/cycc");
        _check("format (stdlib)", 1);
        println("");
        return 1;
    }
    if (file_exists(CYRFMT_PATH) != 1) {
        println("  cyrfmt not found in build/ or on PATH — install via 'cyriusly setup' or build via build/cycc");
        _check("format (stdlib)", 1);
        println("");
        return 1;
    }
    var dirs = vec_new();
    vec_push(dirs, str_from(_root_path("lib")));
    audit_fmt_walk(CYRFMT_PATH, dirs);
    _check("format (stdlib)", AW_FMT_FAIL);
    if (AW_FMT_SKIPPED > 0) {
        _p("    (");
        print_num(AW_FMT_SKIPPED);
        println(" dep files skipped)");
    }
    println("");
    return AW_FMT_FAIL;
}

fn _lint_gate(): i64 {
    _section("Lint");
    if (CYRLINT_PATH == 0) {
        println("  cyrlint not found in build/ or on PATH — install via 'cyriusly setup' or build via build/cycc");
        _check("lint (stdlib)", 1);
        println("");
        return 1;
    }
    if (file_exists(CYRLINT_PATH) != 1) {
        println("  cyrlint not found in build/ or on PATH — install via 'cyriusly setup' or build via build/cycc");
        _check("lint (stdlib)", 1);
        println("");
        return 1;
    }
    var dirs = vec_new();
    vec_push(dirs, str_from(_root_path("lib")));
    audit_lint_walk(CYRLINT_PATH, dirs);
    var fail = 0;
    if (AW_LINT_TOTAL > 0) {
        _p("  ");
        print_num(AW_LINT_TOTAL);
        println(" warnings");
        fail = 1;
    }
    _check("lint (stdlib)", fail);
    if (AW_LINT_SKIPPED > 0) {
        _p("    (");
        print_num(AW_LINT_SKIPPED);
        println(" dep files skipped)");
    }
    println("");
    return fail;
}

fn _cyrfmt_write_gate(): i64 {
    var label = "cyrfmt --write / -w in-place rewrite + idempotent mtime";
    var cyrfmt_bin = _root_path("build/cyrfmt");
    if (file_exists(cyrfmt_bin) != 1) {
        _p("  skip: ");
        _p(cyrfmt_bin);
        println(" not present");
        _check(label, 0);
        return 0;
    }

    var scratch = _tmp_path("audit_cyrfmt_w_");
    if (sys_mkdir(scratch, 493) < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": cannot create scratch dir");
        _check(label, 1);
        return 1;
    }

    # Fixture paths.
    var ugly_sb = str_builder_new();
    str_builder_add_cstr(ugly_sb, scratch);
    str_builder_add_cstr(ugly_sb, "/ugly.cyr");
    var ugly_path = str_data(str_builder_build(ugly_sb));

    var expected_sb = str_builder_new();
    str_builder_add_cstr(expected_sb, scratch);
    str_builder_add_cstr(expected_sb, "/expected.cyr");
    var expected_path = str_data(str_builder_build(expected_sb));

    var target_sb = str_builder_new();
    str_builder_add_cstr(target_sb, scratch);
    str_builder_add_cstr(target_sb, "/target.cyr");
    var target_path = str_data(str_builder_build(target_sb));

    var short_sb = str_builder_new();
    str_builder_add_cstr(short_sb, scratch);
    str_builder_add_cstr(short_sb, "/short.cyr");
    var short_path = str_data(str_builder_build(short_sb));

    var stdout_sb = str_builder_new();
    str_builder_add_cstr(stdout_sb, scratch);
    str_builder_add_cstr(stdout_sb, "/stdout_src.cyr");
    var stdout_src_path = str_data(str_builder_build(stdout_sb));

    var stdout_out_sb = str_builder_new();
    str_builder_add_cstr(stdout_out_sb, scratch);
    str_builder_add_cstr(stdout_out_sb, "/stdout.out");
    var stdout_out_path = str_data(str_builder_build(stdout_out_sb));

    # Ugly source — leading tabs, stray indent, mixed widths.
    var ugly_src = "fn foo() {\n  var x = 1;\n    var y = 2;\n   return x + y;\n}\n";
    # Canonical formatted output (4-space indent, consistent).
    var expected_src = "fn foo() {\n    var x = 1;\n    var y = 2;\n    return x + y;\n}\n";

    _write_file(ugly_path, ugly_src);
    _write_file(expected_path, expected_src);

    var fail = 0;

    # Test 1: --check on ugly returns rc=1.
    var ec_t1 = _exec_in_dir3(scratch, cyrfmt_bin, "--check", ugly_path, 0, 0);
    if (ec_t1 != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test1 --check on ugly rc=");
        print_num(ec_t1);
        println(" (expected 1)");
        fail = fail + 1;
    }

    # Test 3: --write reformats target.cyr in place; result == expected.
    _write_file(target_path, ugly_src);
    var ec_t3 = _exec_in_dir3(scratch, cyrfmt_bin, "--write", target_path, 0, 0);
    if (ec_t3 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test3 --write rc=");
        print_num(ec_t3);
        println("");
        fail = fail + 1;
    } else { if (_files_identical(target_path, expected_path) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test3 --write produced unexpected formatted output");
            fail = fail + 1;
        } }

    # Test 4: --check on the rewritten file returns rc=0.
    var ec_t4 = _exec_in_dir3(scratch, cyrfmt_bin, "--check", target_path, 0, 0);
    if (ec_t4 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test4 --check post-rewrite rc=");
        print_num(ec_t4);
        println(" (expected 0)");
        fail = fail + 1;
    }

    # Test 5: -w short-form behaves identically.
    _write_file(short_path, ugly_src);
    var ec_t5 = _exec_in_dir3(scratch, cyrfmt_bin, "-w", short_path, 0, 0);
    if (ec_t5 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test5 -w rc=");
        print_num(ec_t5);
        println("");
        fail = fail + 1;
    } else { if (_files_identical(short_path, expected_path) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test5 -w produced unexpected formatted output");
            fail = fail + 1;
        } }

    # Test 6: mtime idempotency on already-clean target. Read mtime
    # (sec, nsec), run --write again, read mtime again. If --write
    # rewrote the (now-canonical) file unnecessarily, mtime would
    # advance — STAT_MTIME_NSEC at offset 96 catches sub-second drift.
    var stat_buf1 = alloc(STAT_BUFSZ);
    var stat_buf2 = alloc(STAT_BUFSZ);
    if (sys_stat(target_path, stat_buf1) >= 0) {
        var sec1 = load64(stat_buf1 + STAT_MTIME);
        var nsec1 = load64(stat_buf1 + STAT_MTIME_NSEC);
        _exec_in_dir3(scratch, cyrfmt_bin, "--write", target_path, 0, 0);
        if (sys_stat(target_path, stat_buf2) >= 0) {
            var sec2 = load64(stat_buf2 + STAT_MTIME);
            var nsec2 = load64(stat_buf2 + STAT_MTIME_NSEC);
            if (sec1 != sec2) {
                _p("    ");
                _p(ANSI_RED);
                _p("case-FAIL");
                _p(ANSI_RESET);
                println(": test6 --write touched mtime on already-clean file (sec drift)");
                fail = fail + 1;
            } else { if (nsec1 != nsec2) {
                    _p("    ");
                    _p(ANSI_RED);
                    _p("case-FAIL");
                    _p(ANSI_RESET);
                    println(": test6 --write touched mtime on already-clean file (nsec drift)");
                    fail = fail + 1;
                } }
        }
    }

    # Test 7: default (no flag) writes to stdout, not to the file.
    _write_file(stdout_src_path, ugly_src);
    var stdout_size_before = _file_size(stdout_src_path);
    var ec_t7 = _exec_in_dir3(scratch, cyrfmt_bin, stdout_src_path, 0, 0, stdout_out_path);
    if (ec_t7 != 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": test7 default-mode rc=");
        print_num(ec_t7);
        println("");
        fail = fail + 1;
    } else { if (_files_identical(stdout_out_path, expected_path) != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            println(": test7 default-mode stdout output didn't match expected");
            fail = fail + 1;
        } }
    # Test 7b: stdout-mode must NOT modify the source file.
    var stdout_size_after = _file_size(stdout_src_path);
    if (stdout_size_before != stdout_size_after) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        println(": test7b default-mode modified the source file");
        fail = fail + 1;
    }

    # Cleanup.
    _exec_in_dir3("/tmp", "/bin/rm", "-rf", scratch, 0, 0);

    if (fail == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": 7 sub-cases (--check / --write / -w / mtime / default-stdout)");
    }
    _check(label, fail);
    return fail;
}
