# check.cyr — full project audit dispatcher.
#
# Cyrius port of scripts/check.sh shipped at v5.9.1 as the first
# slot of the v5.9.x sovereignty pass (bash-toolchain → cyrius
# conversion). scripts/check.sh becomes a 1-line shim that builds
# build/cyrius_check on demand and dispatches here.
#
# What we run:
#   1. Self-host two-step (cycc → cc5b byte-identical)
#   2. Heap-map audit (sh tests/gates/memory/heapmap.sh)
#   3. Test suite (every .tcyr file under tests/tcyr/)
#   4. ~50 regression gates (sh tests/regression-X.sh)
#   5. Format walk (cyrfmt across lib/)
#   6. Lint walk (cyrlint across lib/)
#
# Each gate emits PASS/FAIL with ANSI color and increments
# pass/fail/total counters. Exit code = number of failed gates;
# 0 = all green.
#
# Architectural notes:
# * The 50+ regression-X.sh gates remain bash for v5.9.1 — those
#   batch-convert in v5.9.2-v5.9.4 per the roadmap. This dispatcher
#   spawns each via lib/process.cyr's run() (sovereign cyrius fork+
#   execve+wait — not sh -c).
# * `set -e` is deliberately not part of the cyrius dispatcher
#   semantics. Every gate captures its exit code into a local and
#   reports PASS/FAIL via _check(); a single gate failure does not
#   abort the full audit (matches the bash version's v5.7.29 fix).
# * Self-host gate inlines the stdin-pipe fork+execve+dup2 dance
#   that bash expressed as `cat src/main.cyr | $CC > $cc_a` —
#   ~25 LOC of cyrius primitives instead of a sh -c invocation.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"
include "lib/fnptr.cyr"
include "lib/flags.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"
include "lib/bounds.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fs.cyr"
include "lib/process.cyr"
include "lib/audit_walk.cyr"
include "lib/net.cyr"
include "lib/regression.cyr"

# ANSI color escapes — match scripts/check.sh's printf "\033[3Xm".
var ANSI_GREEN = "\033[32m";
var ANSI_RED   = "\033[31m";
var ANSI_RESET = "\033[0m";

# Discovered tool paths (resolved at startup).
var ROOT_PATH    = 0;   # repo root absolute path (cstring)
var CC_PATH      = 0;   # build/cycc (cstring)
var CYRFMT_PATH  = 0;   # build/cyrfmt or PATH-resolved cyrfmt (cstring)
var CYRLINT_PATH = 0;   # build/cyrlint or PATH-resolved cyrlint (cstring)
var CYRDOC_PATH  = 0;   # build/cyrdoc or PATH-resolved cyrdoc (cstring)
var CC_AARCH64_PATH = 0; # build/cycc_aarch64 cross-compiler (cstring)

# Counters.
var G_PASS = 0;
var G_FAIL = 0;
var G_TOTAL = 0;

# Cached environment pointer-array, built once at startup from
# /proc/self/environ. Child processes inherit this env via execve.
var ENVP_BUF = 0;       # raw environ buffer (null-separated KEY=VAL)
var ENVP_LEN = 0;
var ENVP_ARR = 0;       # null-terminated array of pointers into ENVP_BUF
var ENVP_COUNT = 0;
# v5.9.42: shared empty-envp pointer for the pre-v5.9.42 helpers
# that always called execve with `var envp[1]; store64(&envp, 0)`.
# Used by the lib/regression.cyr wrappers in this file. v6.5.45: this is no longer literally
# empty — it carries exactly one deterministic entry, CYRIUS_TEST_ENV=1, so environment-reading
# code is reachable from the suite at all. The name is kept because every call site means "not
# the caller's environment"; see the construction below for why.
var EMPTY_ENVP = 0;

# CO-02 (v6.1.35): the exit code of the most recent `_exec_capture_clean`,
# captured via regression_exec_capture_status. Gates read this so a tcyr that
# segfaults before printing its summary (or exits nonzero after "0 failed") is
# recorded as a FAIL locally — matching ci.yml's `$ec`-AND-count check. Was the
# CO-02 false-green: check.sh's "87/87" could be claimed over a hidden crash.
var _last_exec_ec = 0;
# CO-02: 1 if the most recent _exec_capture_clean child was killed by a signal
# (crashed). Output-comparison gates fail on THIS (a crash), not on a normal
# nonzero exit — output-only fixtures legitimately exit with their last value
# (e.g. 152). TCYR gates fail on _last_exec_ec (the exit-0-on-pass contract).
var _last_exec_sig = 0;

# Convenience: print null-terminated c-string to stdout (no newline).
# ================================================================
# v6.0.90: programs/check.cyr split into programs/checks/. This is the
# slim dispatcher: lib includes + the 18 module globals + the per-suite
# includes below + the infra/driver fns (_run_regression_gates, main —
# kept VERBATIM so gate order + tally are unchanged). check.sh points
# CHECK_SRC here. Acceptance is BEHAVIORAL identity (cyrius_check is not
# in the self-host chain; concatenation order may change its bytes).
# ================================================================

# --- per-suite fn definitions ---
include "programs/checks/shared.cyr"
include "programs/checks/selfhost.cyr"
include "programs/checks/crosshost.cyr"
include "programs/checks/platform_efi.cyr"
include "programs/checks/platform_win_macho.cyr"
include "programs/checks/platform_aarch64.cyr"
include "programs/checks/cx.cyr"
include "programs/checks/ts.cyr"
include "programs/checks/deps_init.cyr"
include "programs/checks/lint_fmt.cyr"
include "programs/checks/heap_audit.cyr"
include "programs/checks/services.cyr"
include "programs/checks/codegen_regress.cyr"

# --- dispatcher + driver (verbatim from the monolith) ---
fn _p(cstr): i64 {
    print(cstr, strlen(cstr));
    return 0;
}

fn _check(name, exit_code): i64 {
    G_TOTAL = G_TOTAL + 1;
    _p("  ");
    if (exit_code == 0) {
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        G_PASS = G_PASS + 1;
    } else {
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        G_FAIL = G_FAIL + 1;
    }
    _p(": ");
    println(name);
    return 0;
}

fn _section(label): i64 {
    _p("── ");
    _p(label);
    println(" ──");
    return 0;
}

fn _root_path(tail): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ROOT_PATH);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, tail);
    var s = str_builder_build(sb);
    return str_data(s);
}

fn _resolve_tool(rel_build_path, name): i64 {
    var absp = _root_path(rel_build_path);
    if (file_exists(absp) == 1) { return absp; }
    var home = getenv("HOME");
    if (home == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, home);
    str_builder_add_cstr(sb, "/.cyrius/bin/");
    str_builder_add_cstr(sb, name);
    var s = str_builder_build(sb);
    var cand = str_data(s);
    if (file_exists(cand) == 1) { return cand; }
    return 0;
}

fn _load_environ(): i64 {
    var cap = 65536;
    ENVP_BUF = alloc(cap);
    var fd = file_open("/proc/self/environ", 0, 0);
    if (fd < 0) { return 0; }
    ENVP_LEN = file_read(fd, ENVP_BUF, cap);
    file_close(fd);
    if (ENVP_LEN <= 0) { return 0; }
    # Count entries (null-separated) and allocate pointer array.
    var count = 0;
    var i = 0;
    while (i < ENVP_LEN) {
        if (load8(ENVP_BUF + i) == 0) { count = count + 1; }
        i = i + 1;
    }
    ENVP_COUNT = count;
    ENVP_ARR = alloc((count + 1) * 8);
    var ai = 0;
    var start = 0;
    var j = 0;
    while (j < ENVP_LEN) {
        if (load8(ENVP_BUF + j) == 0) {
            store64(ENVP_ARR + ai * 8, ENVP_BUF + start);
            ai = ai + 1;
            start = j + 1;
        }
        j = j + 1;
    }
    store64(ENVP_ARR + count * 8, 0);
    # v5.9.42: build EMPTY_ENVP — a freshly-alloc'd 1-elem array of
    # 0. Used by the lib/regression.cyr wrappers below for the
    # helpers that originally execve'd with `var envp[1]; store64(&envp, 0)`.
    # v6.5.45: ONE deterministic entry instead of a genuinely empty array.
    # ⛔ WHY THE NAME STAYS BUT THE CONTENT CHANGES. An empty environment is deterministic —
    # which is the property this was protecting, and it is worth keeping — but it also meant NO
    # test in the suite could ever exercise environment reading, because there was nothing to
    # read. That coverage hole is how `getenv` returning 0 for EVERY name on macOS survived
    # undetected until a downstream consumer (thoth 0.44.3) hit it: `_env_load` opened
    # /proc/self/environ, macOS has no /proc, and the code path had no in-suite reachability at
    # all. A single FIXED entry keeps determinism exactly — results still do not depend on the
    # invoking shell — while making the path testable. See
    # tests/tcyr/crossos/getenv_environment.tcyr.
    EMPTY_ENVP = alloc(16);
    store64(EMPTY_ENVP, "CYRIUS_TEST_ENV=1");
    store64(EMPTY_ENVP + 8, 0);
    return count;
}

fn _gate_run(script_abs): i64 {
    var pid = sys_fork();
    if (pid < 0) { return 1; }
    if (pid == 0) {
        var argv[40];   # N BYTES (CLAUDE.md buffer contract): 3 ptrs need 24 B
        store64(&argv,     "/bin/sh");
        store64(&argv + 8, script_abs);
        store64(&argv + 16, 0);
        sys_execve("/bin/sh", &argv, ENVP_ARR);
        sys_exit(127);
    }
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    var status = load32(&status_buf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
    return 1;
}

fn _gate(name, script_rel): i64 {
    var script_abs = _root_path(script_rel);
    var rc = _gate_run(script_abs);
    _check(name, rc);
    return rc;
}

fn _build_api_surface_if_missing(): i64 {
    var bin = _root_path("build/cyrius_api_surface");
    if (file_exists(bin) == 1) { return 0; }
    var src = _root_path("programs/cyrius_api_surface.cyr");
    if (file_exists(src) != 1) { return 0; }
    if (file_exists(CC_PATH) != 1) { return 0; }
    _self_host_pipe(src, CC_PATH, bin);
    sys_chmod(bin, 493);
    return 0;
}

fn _resolve_root(): i64 {
    var cwd_buf = alloc(4096);
    var n = syscall(79, cwd_buf, 4096);   # SYS_GETCWD on x86_64
    if (n <= 0) {
        store8(cwd_buf, 46);   # '.'
        store8(cwd_buf + 1, 0);
    }
    return cwd_buf;
}

fn _setup_paths(): i64 {
    ROOT_PATH = _resolve_root();
    CC_PATH = _root_path("build/cycc");
    CYRFMT_PATH = _resolve_tool("build/cyrfmt", "cyrfmt");
    CYRLINT_PATH = _resolve_tool("build/cyrlint", "cyrlint");
    CYRDOC_PATH = _resolve_tool("build/cyrdoc", "cyrdoc");
    CC_AARCH64_PATH = _root_path("build/cycc_aarch64");
    return 0;
}

fn _run_regression_gates(): i64 {
    _section("Shared-object");
    _shared_dlopen_gate();
    println("");

    _section("PIE executable");
    _pie_exec_gate();
    _kernel_pie_struct_gate();
    println("");

    _section("Linker");
    _linker_gate();
    println("");

    _section("Capacity meter");
    _capacity_gate();
    println("");

    _section("Object init binding");
    _object_init_gate();
    println("");

    _section("aarch64 syscalls + threads");
    _aarch64_syscalls_gate();
    println("");

    _section("Mach-O aarch64 cross-build");
    _macho_cross_build_gate();
    println("");

    _section("CLI cross-compile (the .25-class gate)");
    _cli_cross_compile_gate();
    println("");

    _section("Inline-asm discard-result");
    _inline_asm_discard_gate();
    println("");

    _section("cyrfmt --write");
    _cyrfmt_write_gate();
    println("");

    _section("Reserved-keyword diag");
    _reserved_kw_diag_gate();
    println("");

    _section("Differential corpus (VR-03)");
    _gate("differential-corpus harness smoke — the logic-preserving perf-arc gate (scripts/differential.sh --smoke)", "scripts/differential-smoke.sh");
    println("");

    _section("Jump-target cap (CVE-09)");
    _gate("x86 jump-target overflow hard-errors past 1023, compiles under it (CVE-09, v6.3.21)", "tests/gates/codegen/jump_target_cap.sh");
    println("");

    _section("Preprocessor flag-table cap (L1)");
    _gate("PP #define/flag table hard-errors past 16 entries; small sets compile clean (L1, v6.4.15)", "tests/gates/frontend/pp_flag_cap.sh");
    println("");

    _section("cx CLI exposure (cx arc A)");
    _gate("cyrius build --target=cx -> versioned .cyx -> cyrius run (right exit); float hard-errors (cx arc A)", "tests/gates/toolchain/cx_cli.sh");
    println("");

    _section("Parser fuzz (VR-02)");
    _gate("cycc stdin-parser survives byte-mutated hostile input, no crash (VR-02, v6.3.22)", "tests/gates/diagnostics/cycc_parser_fuzz.sh");
    # v6.5.19: the deterministic companion. The fuzz gate above finds crashes by
    # chance from a fixed seed AND skips entirely without python3; worse, its signal
    # branch was unreachable from v6.3.22 to v6.5.18 (it tested Python's returncode
    # against the SHELL's 128+N convention), so it sat green over 40 crashing
    # constructs. This one names the shapes in pure sh. See CVE-39.
    _gate("truncated/unbalanced stdin terminates: no signal, no hang, bounded output, caps honoured (CVE-39, v6.5.19)", "tests/gates/diagnostics/truncated_input_terminates.sh");
    # v6.5.19: the depth half of the same CVE-39 family — deeply nested input must be
    # REFUSED with a located diagnostic, never ride the recursive-descent stack into a
    # SIGSEGV. ⚠ This gate was WRITTEN at .19 and left registered NOWHERE; the file
    # existed so the shell-gate count rose while the gate never once ran under check.sh
    # — the same green-placebo shape `toolchain/test_runner_bounded.sh` hit earlier in
    # this very release. Derive the orphan set, never eyeball it:
    #   comm -23 <(find tests/gates -name '*.sh' | sort) \
    #            <(grep -ho 'tests/gates/[a-z-]*/[a-z0-9_]*\.sh' programs/checks/*.cyr scripts/check.sh | sort -u)
    _gate("recursive descent is depth-bounded on every tier: over-deep input exits 1 with a located diagnostic naming the bound, never a signal (CVE-39, v6.5.19)", "tests/gates/diagnostics/recursion_depth_bounded.sh");
    println("");

    _section("SIMD vector sentinel guards (v6.4.4)");
    _gate("f32v4 .field hard-errors (no OOB struct-table escape) + mismatched SIMD arg rejected (v6.4.4)", "tests/gates/codegen/simd_vec_reject.sh");
    _gate("f32v8 256-bit AVX2 emitter produces exact VEX bytes (vmovups/vaddps/vsubps/vmulps ymm + vzeroupper, v6.4.8)", "tests/gates/codegen/simd_f32v8_disasm.sh");
    _gate("f64v4 256-bit AVX2 emitter produces exact VEX bytes (vmovupd/vaddpd/vsubpd/vmulpd/vdivpd ymm + vzeroupper, stride 4, v6.5.24)", "tests/gates/codegen/f64v4_ymm_disasm.sh");
    println("");

    _section("Symbol-dump parity (DX-01)");
    _gate("CYRIUS_SYMS function-symbol dump emits on x86 + aarch64 (DX-01 parity, v6.3.23)", "tests/gates/codegen/dx01_syms_parity.sh");
    println("");

    _section("DX diagnostics: column + source excerpt (v6.4.60)");
    _gate("error output carries :LINE:COL: + a source excerpt with a caret; no at-fail dump (v6.4.60)", "tests/gates/diagnostics/dx_diag_format.sh");
    println("");

    _section("DX diagnostics: multi-error recovery (v6.4.62)");
    _gate("reports N>=2 errors per compile (panic-mode), no output on error, no crash/hang on garbage, valid emits (v6.4.62)", "tests/gates/diagnostics/dx_multi_error.sh");
    println("");

    _section("Enum-shadow hard-error");
    _gate("non-int var shadowing an enum constant hard-errors; int same-value shadow allowed (v6.3.24)", "tests/gates/frontend/enum_shadow_error.sh");
    println("");

    _section("Thread-local slot collision");
    _gate("sigil crypto-bank thread-local slot is clear of patra's 0-4 (v6.3.25 TLS RECORD_LAYER fix)", "tests/gates/concurrency/thread_local_slot_collision.sh");
    println("");

    _section("Extern-C FFI (fncallN + foreign-%fs coexistence)");
    _gate("arm64-macOS has REAL threads: `syscall(1700, &tid, attr, &start, arg)` lowers to libSystem `pthread_create` through __got[5]. ⛔ THIS IS NOT THE MECHANISM THE ROADMAP PINNED, and the correction is measured, not preferred: `bsdthread_register` returns EINVAL from a real cyrius binary on ecb (exit 22) because registration is ONE-SHOT PER PROCESS and cyrius\'s arm64 Mach-O is a dyld/LC_MAIN PIE linking libSystem, so libpthread spends it first. Going raw anyway would mean hand-building a pthread_t against libpthread INTERNALS — sig@0x00 behind a per-process ptr_munge cookie, fun@0x90, arg@0x98, tsd@0xE0, a PAC modifier — none of it stable ABI. The v6.5.43 bsdthread routes are neither wrong nor removed: they are what x86-macOS, a static no-libSystem binary where registration DOES work, will use. ⭐ __got[5] had been bound to _pthread_create since v5.6.6 and NEVER USED, so nothing in the Mach-O writer changes — no new symbol, no GOT growth, no bind-opcode arithmetic. No trampoline is needed either: a Darwin start routine is `void *(*)(void *)`, exactly the shape of a cyrius `fn body(arg): i64`. ⭐ AXIS 3 IS THE REASON THIS GATE EXISTS: it re-derives the slot index from the bind ORDER in the Mach-O writer and requires the emitter to agree. Reorder the GOT symbol list and the emitter would otherwise silently call whatever now sits in slot 5 — _fopen — with a thread\'s arguments; nothing else in the tree couples those two facts. ⚠ Axis 4 is the v6.4.26 trap: parse_expr references the emitter in EVERY fork, so a missing return-0 stub links only on the fork nobody builds locally. ⚠ Axis 6 pins THREADS_CONCURRENT honest on all four backends — the capability that `tests/tcyr/crossos/thread_runs_concurrently.tcyr` guards on; a serial peer declaring 1 would make that discriminator assert against an inline backend and redden the cross-OS leg. Mutation-proven six ways, including a slot swap, a GOT reorder, a dropped fork stub and a lying capability (v6.5.44)", "tests/gates/platform/macos_arm64_real_threads.sh");
    _gate("the preprocessor\'s source-fed scratch write loops are bounded by the space ACTUALLY free (CVE-39, CVE-40). ⛔ CVE-39: the heap map declared `0x190400 include_fname [4096]` and all three filename capture loops guarded at 4095 FROM THAT NUMBER — but two live things sit inside that declared span, PP_EXPAND\'s output-cursor return slot at S+0x190700 (768 B in) and the `#ifdef` FEATURE-FLAG TABLE at S+0x190800 (1024 B in). MEASURED against a pre-fix compiler built for the purpose: a 1210-character include path makes `#ifdef CYRIUS_ARCH_X86` select the WRONG BRANCH — the probe returns 7 where 42 is correct, exit 0, no diagnostic. A path LENGTH changed the generated code. ⚠ 768 IS THE BOUND, NOT 1024: the first cut of this fix used 1024, reasoning from the flag table alone and missing the cursor slot 256 bytes below it, which is why axis 1 DERIVES the bound from live writes instead of trusting any comment. ⛔ CVE-40: the `#define` body copy into the macro text pool at S+0x193000 ran to end-of-line with no check on the length OR on the ACCUMULATING write position, so a long body — or enough ordinary ones in sequence — walked out of the pool into live compiler state; axis 2 requires the guard to test the accumulator, because bounding one macro\'s length still overruns on the sixteenth #define. ⚠ THE GATE STRIPS COMMENTS BEFORE EXTRACTING, and its own first run is why: lex_pp.cyr carries a v6.4.81 note explaining that the map once documented a phantom scratch at 0x190500 \"an address NO code has ever written\", and the unfiltered grep read that sentence as a live writer and failed a correct bound — reading a number out of prose is the same defect the note is about. ⚠ Axis 3 pins the MAP, because an overstated region is precisely how the 4095 guard was chosen in the first place. Mutation-proven six ways (v6.5.45)", "tests/gates/frontend/preprocessor_scratch_bounds.sh");
    _gate("DCE reachability bounds are DERIVED from the enforced fn ceiling, on both backends. DCE WAS UNSOUND ABOVE 32768 FUNCTIONS FOR SIX RELEASES: v6.5.40 raised the ceiling 32768 -> 131072 and widened `live[]` from 4096 to 16384 bytes to match, but NEITHER loop that uses the bitmap came along — the clear loop still stopped at 4096, so three quarters of it started as stack garbage, and the address-taken (type-3 fixup) root-seed bound stayed `t3idx < 32768`, so a function reachable ONLY through its address was never seeded as a root, DCE concluded it was dead, and NOP-filled it. Nothing can follow a raw pointer back, so that is UNSOUND, not conservative. MEASURED with a 33,001-function program whose target is referenced only by &fn: pre-fix CYRIUS_DCE=1 exits 139 (SIGSEGV), post-fix 42; DCE off is correct either way, which is why it hid — it only bites the flag. SECOND OCCURRENCE: v6.4.75 fixed this exact clear loop for the 4096 ceiling and the v6.5.40 raise reintroduced it, so the gate reads the ceiling from _capacity_warnings — the same number the user is told is hard — and DERIVES both bounds rather than quoting any of them. Two extraction traps are recorded in the gate because both bit on its first run: matching the whole clear statement and taking every number yields 16384/8/0 (the 8 from store8, the 0 from the literal), and the identifier t3idx contains a 3. Mutation-proven four ways, the important one being raise-the-ceiling-without-sweeping-consumers, which is the v6.5.40 defect itself (v6.5.46)", "tests/gates/codegen/dce_bounds_match_fn_ceiling.sh");
    _gate("agnos proclist #99 +56 record slot is documented as what the kernel actually writes. Fourth gate in the agnos-parity family, covering a class the other three cannot see: NUMBERS, FIELD SELECTORS and STRUCT TAIL layout all stayed correct while the MEANING of one existing slot changed. The peer described +56 as u64 reserved, always 0 today, with a paragraph saying rss and cpu time are not tracked by the kernel yet; agnos 1.56.59 filled it with one store64(pl_rec + 56, (pl_rs << 32) | pl_tk) — low u32 cpu ticks, high u32 rss pages. The record SIZE did not change, so nothing structural moved and no other gate could notice. BOTH WAYS A CONSUMER CAN TRUST THE STALE TEXT ARE BAD: zero-check the u64 and skip it and you stay CORRECT while silently reading no data (what chakshu did for a release), or render it and publish ~6.6e12 — a positive, plausible, nonsensical number, 2000 years as ticks or 25 PB as pages. This is the SECOND release chakshu lost to a stale note in this file. The gate derives does-the-kernel-write-it from LIVE kernel source and handles both directions, so it stays honest if a future slot goes the other way. The half-direction axis must REJECT a shift in the low-half accessor rather than merely accept a mask: the swapped form (x >> 32) & 0xFFFFFFFF still contains the mask, so a mask-only test passed the exact mutation the axis exists to catch — measured on this gate first run. Mutation-proven four ways (v6.5.46)", "tests/gates/platform/agnos_proclist_record_parity.sh");
    _gate("the agnos `sysinfo`#35 STRUCT TAIL — tier lengths and band offsets — agrees between the kernel contract and lib/sys.cyr. Third gate in the agnos-parity family, and each covers a class the one above it cannot see: agnos_abi_doc_parity checks NUMBERS (does #N exist on both sides), agnos_net_config_field_parity checks FIELD SELECTORS (does #61 field 8 have an accessor), and this one checks STRUCT TAIL LAYOUT. ⛔ #35\'s documented rule is that future fields append at the tail and bump the minimum len while existing offsets are FROZEN ABI the moment a consumer reads them. agnos 1.56.59 appended per-core CPU ticks at +40 and per-device block counters at +104, growing the struct 40 -> 200 bytes, and BOTH gates above stayed green through it — correctly, since no number and no field selector changed. Meanwhile `fn sys_sysinfo(out)` hardcoded len=40, so every wrapper consumer kept getting the base struct and chakshu, the monitor the tail was built for, could not see a single new field. ⚠ THE BLOCK BAND IS WHERE `blkstats`#105 ENDED UP: that number was minted, filed, shipped as a cyrius peer in 6.5.44 and WITHDRAWN in 6.5.45 once an extend-vs-mint audit found a closed 5-value tag enum over flat arrays is just a fixed-size tail block — so an off-by-one in SI_BLK_BASE would now misreport disk statistics silently, as a plausible number, and nothing else in the tree ties that offset to the kernel\'s. ⚠ Reads ONLY the AGNOS enum block, because lib/sys.cyr defines SYSINFO_SIZE twice (40 for agnos, 120 for the Linux-shaped struct) and a whole-file grep picks up both. ⚠ Anti-vacuous floors on every extraction, and the size anchor is \" bytes\" rather than the first number on the line — the heading begins \"### 4.4\", so a lexical parse yields 4, measured on this gate\'s first run. Mutation-proven five ways: a shifted band offset, two wrong tiers, the deleted overload, and an overload that ignores its length argument (v6.5.45)", "tests/gates/platform/agnos_sysinfo_tail_parity.sh");
    _gate("the FIELD SELECTORS inside agnos `#61 net_config` agree between the kernel contract and the cyrius peer. agnos_abi_doc_parity.sh compares syscall NUMBERS; this compares the fields inside ONE syscall, which that gate structurally cannot see — and which is where the drift actually happened. ⛔ `#61` already passes an arbitrary field id through, so agnos EXTENDS it rather than minting numbers: fields 4..7 (ICMP counters, 1.56.48) and 8..11 (interface packet/byte totals, 1.56.59) reached consumers with NO cyrius release at all. The upside is that no peer work is needed; the trap is that NOTHING then forces the cyrius side to notice, and cyrius\'s comments still said `4..7` while the kernel answered `4..11`. ⚠ A STALE RANGE IS NOT COSMETIC — it is how a consumer concludes a capability is absent and writes a workaround for something that already works. agnos\'s tracker records two in one week: chakshu nearly filed a phantom `statfs` gap against an arm sitting 20 lines below the comment that denied it, and crab carried a blocker for FIVE releases after its fix shipped. The number-level gate was GREEN through all of it, because no number was wrong. ⚠ TWO NOTATIONS are in use in that contract row and BOTH must be read (`N=name` for 0..7, `**N**` for 8..11); reading one silently halves the contract, so the parse is floored at 8 ids on each side — a regex that matches nothing reports nothing wrong and PASSES. ⚠ agnos is a SIBLING repo and may be absent: that SKIPs loudly rather than passing quietly. Mutation-proven four ways: the filed defect (a missing field-11 accessor), a reverted range comment, a dropped mid-range accessor, and an accessor spelling change that makes the gate read nothing (v6.5.44)", "tests/gates/platform/agnos_net_config_field_parity.sh");
    _gate("BOTH Mach-O backends warn on an unrouted syscall, and the x86 answer comes from EMACHO_SYSXLAT\'s own rows. macho_route_parity.sh compares the two backends\' ROUTE TABLES; this compares their DIAGNOSTICS, which had drifted just as far and were invisible to it. Since v5.5.15 the arm64 backend has warned on any number ESYSXLAT/__got does not handle. The x86 Mach-O backend had NO such warning AT ALL — `_TARGET_MACHO == 1` was simply never checked — so on Intel-Mac a missing route was SILENT at compile time and a SIGSYS at runtime. ⛔ NOT HYPOTHETICAL: `ioctl` sat unrouted on the x86 peer and was found at v6.5.36 only by reading the table, and v6.5.16 lists five ach corpus failures whose common cause was an unrouted number nobody was warned about. Adding the x86 arm here immediately named two numbers in cycc\'s OWN macOS build — one of which (228) turned out to be a false positive that this gate now pins, and the other (12, brk) sits in EMITELF_OBJ, which has no callers. ⭐ AXIS 2 IS THE ONE THAT MATTERS LONG-TERM: `_macho_x86_routes` must REPLAY EMACHO_SYSXLAT rather than list numbers. v6.0.65 had to DELETE precisely such a parallel list on the ARM side after it drifted to 9 entries against ~40 real routes, drowning the log; re-introducing one on the x86 side would recreate a bug already paid for once. The only literals permitted are the two parse_expr reroutes (35, 228) that have no _msx row by design, and the gate asserts that set EXACTLY. ⚠ Axis 3: both diagnostics must NAME the number via PRNUM — the ARM warning fired 470 times during cycc\'s own build without ever saying which syscall, which is how it came to read as noise and get scrolled past. Mutation-proven five ways, including a straight revert to the pre-6.5.43 state and an unguarded warning that would fire on Linux (v6.5.43)", "tests/gates/platform/macho_diagnostic_parity.sh");
    _gate("every reachable syscall(228) passes a REAL buffer, because the three reroutes disagree about argument 3. arm64-macOS (EMACHO_CLOCK_ARM, __got _clock_gettime_nsec_np) and Windows (EGETTICKS_PE, GetTickCount64) IGNORE it; x86-macOS (EMACHO_CLOCK_X86) DEREFERENCES it, composing ns from gettimeofday via `pop rdi` / `mov rax,[rdi]` / `mov ecx,[rdi+8]`. ⛔ ONE `#ifdef CYRIUS_TARGET_MACOS` COVERS BOTH MACH-O BACKENDS, so a call written against the arm64 contract compiles unchanged for Intel-Mac and dereferences whatever was passed. `_prof_clock_ns()` did exactly that — `return syscall(228, 4, 0);` — a NULL dereference on ach that was perfectly fine on ecb. ⚖️ HONEST SCOPE: it was LATENT, not live, because CYRIUS_PROF is wired in src/main.cyr alone and the macOS forks never call the fn; wiring profiling into a macOS fork, or calling it from anywhere else, would have made it a SIGSEGV with no compile-time warning of any kind. Demonstrated on real ach: `syscall(228, 4, 0)` exits 139, `syscall(228, 4, &ts)` returns a live nanosecond count. ⚠ The literal-0 form stays legal inside a CYRIUS_TARGET_WIN guard, where the route genuinely ignores it, so the gate tracks #ifdef nesting rather than grepping. ⚠ It PREMISE-CHECKS EMACHO_CLOCK_X86 still dereferences arg 3 before enforcing anything — if that ever changes the gate should be re-derived, not silently kept. Mutation-proven both ways: reintroducing the NULL is caught, and so is removing the dereference the premise rests on (v6.5.43)", "tests/gates/platform/macho_clock_buffer_contract.sh");
    _gate("a FULL-STDLIB program builds for Windows: the PE base-relocation table is lazily allocated, not a fixed 64 KB ceiling. `_pe_layout` collected DIR64 sites into a FIXED 8192-slot window at S+0x1DC000, and overflowing it was a hard `error: PE reloc table full (8192)` with NO binary — so no full-stdlib Windows program could be built AT ALL. Measured: cap 8192 FULL, cap 16384 fits, so mabda needs 8k-16k slots; now `_PE_RELOC_CAP` 65536, lazily alloc\'d via `_pe_reloc_base` per the v6.4.75 `_fnvb_base` precedent. ⚠ It could NOT be raised in place: the window was exactly 64 KB and 0x1DC000+0x10000 IS 0x1EC000 gvar_initval, zero adjacent slack, so growing it would have MOVED a region = heap LAYOUT change = two-step bootstrap. ⛔ WHY IT HID: until v6.5.25 a PE build of the folded stdlib died EARLIER on `undefined variable SYS_IOCTL`, and a ceiling behind a hard error cannot be observed — clearing one cause only revealed the next. ⭐ This is also the `cycc_win` axis folds_agnos_parity.sh never had (agnos axis ONLY, which is exactly why a PE-only ceiling sat unnoticed behind a green suite). Axis 0 floors the extracted preamble at 20 modules because a hand-rolled two-include probe yields undefined ORDINARY stdlib names (alloc/memcpy/map_new) that read like missing Windows wrappers — that misreading was recorded as fact once. Axes 3-4 pin that the fixed window is not re-accessed and the heap map records it FREED. Mutation-proven: at cap 8192, mabda and yukti go red (v6.5.26)", "tests/gates/platform/pe_reloc_cap_full_stdlib.sh");
    _gate("a PE binary contains ZERO raw Linux `syscall` instructions, and the folded stdlib BUILDS for Windows. An unrouted LITERAL syscall number under CYRIUS_TARGET_WIN=1 warned and then fell through to ESCPOPS, emitting a raw syscall = STATUS_ILLEGAL_INSTRUCTION (0xC000001D), a hard crash at the first call from a warning buried in a 1233-byte wall of text. The NON-literal arm has emitted an honest -38/-ENOSYS since v6.1.17 for exactly this reason, so the two halves of one decision disagreed for four minors. ⭐ THIS IS WHAT UNBLOCKED THE STDLIB ON WINDOWS: lib/syscalls_windows.cyr is a STANDALONE peer with no SYS_IOCTL constant, so lib/yukti.cyr made `undefined variable SYS_IOCTL` a HARD COMPILE ERROR for a PE build of yukti and anything including it (measured rc=1, 4 errors; clean on Linux). The constant could NOT be added alone — that converts the compile error into 39 raw syscall instructions, a runtime crash instead of a build failure, strictly worse — so constant + honest-degrade landed together and both halves are pinned here. ⚠ SCOPE HONESTLY: SYS_IOCTL was NOT the sole blocker as the premise-check claimed; yukti/vani/patra now build for PE, while mabda and sigil still fail on SEPARATE gaps (PROT_READ/PROT_WRITE/MAP_SHARED absent from the Windows peer + undefined fns), so this gate asserts only what is true. ⛔ Counts by DISASSEMBLY, never a byte scan: the first version byte-scanned 0F 05 and FALSE-POSITIVED on patra, where the pair sat inside `e9 0f 05 00 00` — a jmp displacement of 0x050f — while objdump reported 0 syscall mnemonics for the same binary. Axis 2 is anti-vacuous (the same source on Linux must still emit real syscalls, else deleting emission would pass) (v6.5.25)", "tests/gates/platform/pe_no_raw_syscall_bytes.sh");
    _gate("bare-metal forbidden-module check: a `#host_only` stdlib module pulled by a kernel build ERRORS and NAMES the module, under BOTH the `--target=<arch>-bare-metal-elf` env path and the source `kernel;` directive — while host builds and clean kernel builds are untouched. Bare-metal arc deliverable #4 + part of #7's acceptance, unbuilt for ~2 months: the v6.3.4 premise-check found no such check, then the issue was bulk-renamed into issues/archived/ on 2026-07-10 with NO resolution banner for work that was never built, and sat in the resolved graveyard while the roadmap still listed it live (restored 2026-08-11). An ANNOTATION, not a central deny-list, so the fact lives in the module it describes and moves with the file. ⚠ The check is at end-of-PARSE_PROG, NOT the include site: PREPROCESS runs at main.cyr:1189 and CYRIUS_KERNEL is not read until :1217, so kernel_mode is still 0 while includes expand — the first cut checked it there and silently never fired. Axes 1 and 4 are the negatives that stop it becoming a blanket rejection; axis 5 runs the arc's own freestanding_tls #7 fixture as the positive case (v6.5.24)", "tests/gates/platform/bare_metal_forbidden_module.sh");
    _gate("stack-protected extern-C via fncall4/5/6/7 + foreign-TLS coexistence, no %fs clobber (v6.3.26)", "tests/gates/platform/ffi_stack_protected_extern_c.sh");
    println("");

    _section("IR cross-BB liveness + spill detection (perf-arc substrate)");
    _gate("ir_liveness_cfg fixpoint converges + precise (exit BBs live_out==0) + spill-interval detection, behavior-safe (v6.3.27)", "tests/gates/ir-opt/ir_liveness_cfg.sh");
    _gate("callee-saved frame-trim: trimmed cycc self-hosts, shrinks vs CYRIUS_FRAMETRIM=0, behavior-preserving (v6.3.29)", "tests/gates/ir-opt/frametrim.sh");
    _gate("redundant-reload elimination: self-hosts, shrinks vs CYRIUS_RELOADELIM=0, control-flow-safe, behavior-preserving (v6.3.30)", "tests/gates/ir-opt/reloadelim.sh");
    _gate("freelist agnos mmap-ABI: Linux round-trip=42, agnos build clean, _fl_mmap routes the single-arg agnos mmap (v6.3.31)", "tests/gates/memory/freelist_agnos_mmap.sh");
    _gate("single-owner mutex: thread+sync co-include has 0 duplicate-fn warnings, lock still guards under contention, thread*.cyr delegate to sync (v6.3.44)", "tests/gates/concurrency/mutex_single_owner.sh");
    _gate("net sock_accept would-block path is alloc-free: 100k no-pending polls grow the bump heap 0 B (accept-per-poll leak, v6.4.61)", "tests/gates/memory/net_accept_no_leak.sh");
    _gate("lib freshness: `cyrius build` NAMES per-lib version skew vs the pin (both header formats, sentinel-independent), silent when fresh, opt-out + --check-lib-sync + source-repo carve-out (v6.4.63)", "tests/gates/toolchain/lib_freshness.sh");
    _gate("sys_exit_group on all 3 syscall peers; old per-thread epilogue still hangs (the mutation signal); no init template ships exit(2); macOS-x86 231 translated (v6.5.6)", "tests/gates/platform/exit_group_wrapper.sh");
    _gate("async_await_readable_ms bounds the wait AND reports readable(1) vs timeout(0); legacy wrapper still returns 0; no hardcoded -1 left (v6.5.6)", "tests/gates/concurrency/async_await_readable_ms.sh");
    _gate("cyrius test/bench/fuzz each DISCOVER what `cyrius init` scaffolds into tests/, at any DEPTH, and honour an explicit subfolder argument; an unusable argument is refused (v6.4.72/.78 + v6.5.6/.7)", "tests/gates/toolchain/scaffold_verb_discovery.sh");
    _gate("cyrius port scaffolds for the language it was GIVEN — rust + python arms, language-specific marker/preserved-tree/LOC extension, and no Rust vocabulary leaking into a Python scaffold via the port templates (v6.5.34)", "tests/gates/toolchain/port_language_arms.sh");
    _gate("alloc_reset() no longer strands the default Allocator (hisab SIGSEGV); storage is TYPED i64[5] so cybs and cycc reserve the same 5 slots — a bare [5] clobbers gen1 while gen2==gen3 stays green (v6.5.7)", "tests/gates/memory/alloc_reset_default_allocator.sh");
    _gate("syscall-wrapper pass: sys_chdir / signal_default / x* family / sys_fchownat behave AND cross-compile on all 5 targets; agnos length-carrying arms asserted structurally (arity matches, so nothing else can see it); agnos #96/#97 not minted early (v6.5.7)", "tests/gates/platform/syscall_wrapper_pass.sh");
    _gate("cx callptr: an INDIRECT call returns what the same fn returns called DIRECTLY, `&fn` materialises a real code offset, and the compiler does not fault recording a fn-pointer fixup. Three defects had to land together — ELOAD_FN_ADDR was a return-0 STUB (so every fn pointer was 0), main_cx.cyr never set _fixup_base (so the shared path SIGSEGV'd, which is WHY it was stubbed), and ECALLIND hard-errored. Acceptance is indirect==direct, NOT indirect==expected: cx has a separate pre-existing multiply defect, and comparing call FORMS is what proved it pre-existing rather than caused here. Opcode 105 (0x69) is PERMANENT — scan free opcodes with a regex covering BOTH `op == 97` and `op == 0x62` forms; a decimal-only scan reports 98/99 free when they are pushc/popc (v6.5.13)", "tests/gates/codegen/cx_indirect_call.sh");
    _gate("net.cyr <-> ESYSXLAT coupling: every x86 socket number net.cyr issues is renumbered in BOTH aarch64 arms (Mach-O and aarch64-Linux), and net.cyr keeps the x86 numbers rather than native ones. STRUCTURAL by necessity — a behavioural test passes on x86 whether or not the aarch64 rows exist, which is exactly why v6.2.10 shipped with the renumbers in the macho arm ONLY and every net.cyr INET call hit the wrong syscall on native aarch64-Linux. Mutation-verified: deleting the aarch64-Linux socket-41 row turns 2 axes red. Premise-check for the x86-only-numbers filing concluded the numbers are CORRECT as-is (net_v6_connect + socket_syscalls both rc=0 on real pi) and that the missing piece was this gate, not per-arch wrappers — which CLAUDE.md's ESYSXLAT rule forbids (v6.5.11)", "tests/gates/platform/net_esysxlat_coupling.sh");
    _gate("Mach-O route parity: the two macOS backends' syscall tables (aarch64 ESYSXLAT's _TARGET_MACHO==2 branch, x86 EMACHO_SYSXLAT) agree BY CAPABILITY, every issued SYS_* is routed on its own backend, and _macho_arm_routes mirrors the ESYSXLAT sources exactly. Compares by CAPABILITY, never by source number — the peers issue different numbers by design (sys_getuid is 102 on the x86 peer and 174 on the aarch64 one, both correct), so a source diff yields ~32 false positives. STATIC by necessity: a missing route is a SIGSYS kill on ONE Mac only and invisible on the other and on Linux, so only a behavioural test that happens to CALL that syscall on that hardware can see it — which is how the whole credential family (getuid/geteuid/getgid/getegid) sat unrouted on BOTH backends behind a hardcoded is_root(), and how sys_fchmod SIGSYS'd on every Intel-Mac for as long as the wrapper existed. Mutation-verified: deleting the v6.5.15 _msx(S, 91, 0x200007C) fchmod row turns axes 1 and 2 red (exit 1). Allow-list entries each carry a one-line reason — an unexplained entry is how this rots again (v6.5.16)", "tests/gates/platform/macho_route_parity.sh");
    _gate("include dir resolution: a subfolder source includes its own neighbours via #@incdir, CWD still resolves first (additive), and the in-band marker cannot reopen CVE-02/CVE-16 — escape axes target a REAL valid-cyrius file so 'refused' is distinguishable from 'read then choked' (v6.5.7)", "tests/gates/frontend/include_dir_resolution.sh");
    _gate("every `ERR_MSG(S, \"text\", N)` declares N == strlen(text). The audit that prompted this found **49 of 104 wrong — 47 %**, and NEITHER direction is visible by reading output: too SMALL truncates (measured: \"...right-hand side\" printed as \"...right-hand sid\", losing its last character, and a truncated diagnostic still looks like a diagnostic), too LARGE makes sys_write read PAST the literal into adjacent bytes. ⛔ A GATE, not just the sweep: this is a hand-maintained value duplicating a fact the compiler already has, so it drifts on every message edit — it had reached nearly half the corpus undetected, and FOUR of the 49 were introduced in v6.5.23 days earlier by the same author who then ran the audit. A one-off correction of a self-drifting value is not a fix. Third value of this shape found in one cycle (heap-map sizes vs regions, gate counts vs files, string lengths vs strings) — all mechanically derivable, all wrong. Axis 0 floors the parsed-site count at 90 because a regex that matches nothing reports nothing wrong and PASSES. Mutation-proven: declaring 30 for a 41-char message turns it red (v6.5.24)", "tests/gates/diagnostics/err_msg_lengths_match.sh");
    _gate("`assigning non-pointer to typed pointer` tests the RIGHT SIGN. The local arm gated on `lt > 0`, but a positive local SLTYPE is a narrow WIDTH (1/2/4) or a FLOAT TAG (F64_TYID/F32_TYID) — the pointer-like case is stored NEGATIVE as `0 - sid`. Inverted in BOTH directions at once: it fired on every width/float-annotated local and NEVER on a real typed-pointer local, so the check was unreachable for its own purpose, while the GLOBAL arm of the same warning had always used the correct `vt < 0`. No .tcyr can catch a WARNING (warnings don't change exit codes), which is how it survived — and it was not harmless: the f64/f32 half BLOCKED the ranga/ganita f32 tier, whose canonical loop body is `acc = f32_op(acc, ..)`. Axis 4 is the anti-vacuous one: axes 1-3 all assert an ABSENCE, so deleting the warning would pass all three. Mutation-proven: restoring the pre-fix condition turns axes 1 and 4 red (v6.5.24)", "tests/gates/diagnostics/typed_pointer_warn_sign.sh");
    _gate("`<source>` diagnostic lines match the ENTRY FILE's own numbering whatever cbt prepends. cbt prepends `#@incdir`, `#@pkgver`, one `include` per `[deps].stdlib` module, one `#define` per `-D`, and the whole TEXT of every `[build].modules` file — and only `#@incdir` was ever compensated, so every diagnostic was reported one line late PER PREPENDED LINE. Measured on abaco's 18 modules: +17, pointing PAST EOF on a 23-line file, which reads as a compiler fault rather than a source defect so the reader stops trusting line numbers instead of adjusting them. Fixed by cbt writing `#@srcline` last before the entry file and cycc RE-ANCHORING the `<source>` span to line 1 there — carrying NO count, since cycc derives the bias from the marker's own position (a count would drift, and `[build].modules` splices in files of unknown length). Axis 3 is the point: it uses 3x the modules of axis 2 and demands the SAME line, so a fix that merely shifted the constant by one cannot pass. Mutation-proven: dropping cbt's marker write reproduces the filed signature exactly (6 modules +7, 18 modules +16, subdir +4) (v6.5.24)", "tests/gates/diagnostics/srcline_no_line_shift.sh");
    _gate("a consumer's `cyrius = \"X.Y.Z\"` pin is HONOURED even when src/main.cyr exists. _try_redirect_to_pinned decided \"am I the cyrius repo?\" with file_exists(\"src/main.cyr\") and returned early — but that is the entry point `cyrius init` GENERATES, so the test was true for essentially every cyrius project and the manifest pin was silently ignored ecosystem-wide. Same repo, one file's difference on 6.5.36: without it `cyrius --version` reported the pinned 6.3.35, with it 6.5.36 plus \"manifest-pin: 6.3.35 (drift — wrapper is 6.5.36)\". ⭐ It survived because the tool PRINTED the pin it was ignoring and called the mismatch DRIFT, which reads as a stale manifest — a consumer problem — so every symptom pointed away from the redirect; and because the bug is invisible from inside the cyrius repo, it needs a CONSUMER tree with the generated entry point. ⚠ THIRD occurrence of one shape: fixed in `cyrius audit` (v6.0.1, again v6.4.63) and in _dep_find_stdlib_dir (v6.5.25), whose fix note said _dep_is_cyrius_source_repo() \"exists precisely for this ... never a filename probe\" and was still not applied here. Axis 2 is anti-vacuous — a repo NAMED cyrius must still skip the redirect — and is what fails if the guard is deleted rather than corrected; axis 3 pins exact-name matching so cyrius-x is not exempted. Blast radius measured over ~180 repos first: 94 begin honouring a pin they had ignored, all 94 have it installed, 0 break. Mutation-proven: restoring the filename probe reddens axis 1; deleting the guard reddens axis 2 (v6.5.37)", "tests/gates/toolchain/pin_redirect_honours_manifest.sh");
    _gate("docs/ecosystem.md's fold table states the version actually vendored in lib/. The table has rotted TWICE the same way and the file records the first time (\"At the v6.4.77 fold, 5 of 11 rows were stale\"); at v6.5.37 it was 9 of 11, and FOUR of those (vani, yukti, mabda, yantra) were stale BEFORE that release's fold — their lib/ copies were already current and only the table was wrong, so the rot is not a forgotten step, it is that nothing ever checked. This row is what a human reads to answer \"which sigil is in this release?\" before deciding whether an upstream fix has landed, so a stale row is a WRONG ANSWER to the question the fold discipline exists to make answerable. ⛔ THREE bundle header formats exist (stock `# Version:`, sakshi's `Bundled distribution of <name> vX.Y.Z`, and an in-source `var <NAME>_VERSION`); a scan knowing only the first reads sakshi as none and SKIPS it, which is how the v6.4.77 audit undercounted its own staleness — axis 3 fails on any unparsed row so a fourth format cannot be skipped into a false pass. On its very first run it caught a 10th stale row (niyama 1.0.6 -> 1.0.7) that the hand audit missed. Mutation-proven: reverting one version reddens axis 1; breaking the table shape reddens axis 2 rather than passing vacuously on zero rows (v6.5.37)", "tests/gates/toolchain/fold_table_matches_vendored.sh");
    _gate("a duplicate fn that DISAGREES ABOUT ARITY is an ERROR, not a warning. `duplicate fn ... last definition wins` reads as benign shadowing and usually is — but when the two definitions disagree about ARITY the duplicate path routes AROUND the call-site arity check that has been a hard error since v6.5.1. Measured at 6.5.36: a 3-arg call bound to a 1-arg duplicate compiled and RAN, dropping arguments 2 and 3 (exit 201), while the identical mismatch with no duplicate present is refused outright — so a duplicate was the one way to defeat that check. Filed from owl 1.4.7, where vyakarana and sankoch each define a private-by-convention `_stream_grow` disagreeing about arity, buffer offsets AND return polarity: a wrong binding reports every successful buffer grow as a FAILURE, inside a tokenizer, on file content. ⚠ `private` does NOT prevent it (axis 3) — visibility is enforced on REFERENCE, not DEFINITION. ⛔ THIS IS THE CHEAP HALF AND AXIS 2 SAYS SO DELIBERATELY: a SAME-arity duplicate must still only warn, both because those are usually intentional shadowing and are load-bearing today (`_sk_emit_err` collides between lib/vani.cyr and lib/mabda.cyr at the same arity), and so nobody reads a green gate as evidence the whole class is closed. The real fix — scoping private symbols at INSERTION so the guide's \"omitted from the exported symbol table\" claim becomes literally true — remains OPEN. Blast radius measured first: cycc and the CLI produce ZERO duplicate warnings, the corpus 5, and the one arity-differing pair was two tests shadowing lib/process.cyr's `run(cmd,arg1,arg2)` with a local `run()`, renamed in the same change. Compiled against build/cycc directly, never the wrapper, which resolves the INSTALLED compiler in a consumer dir — a mistake made four times during this release. Mutation-proven: disabling the comparison reddens axis 1 (v6.5.37)", "tests/gates/frontend/duplicate_fn_arity_mismatch.sh");
    _gate("`private` scopes a fn at symbol INSERTION, so a private helper cannot be replaced by another file's same-named function. The fn table held exactly ONE entry per NAME and a second definition overwrote its body (`duplicate fn ... last definition wins`), so a private helper was silently replaced by any same-named fn in any other file — INCLUDING for its own file's internal calls — and declaring `private` on BOTH sides did not help, because visibility was enforced only at the REFERENCE site on top of an unchanged global symbol table. Measured at 6.5.37: a.cyr's private `_helper` returning 1 and b.cyr's returning 0 gave exit 0 where 10 is correct — a_entry was rebound to b.cyr's function. v6.5.37 closed only the arity-DIFFERING case; this closes the same-arity half its gate deliberately left open. ⭐ SAME-ARITY IS THE DANGEROUS ONE: the filed instance (vyakarana and sankoch each defining a private `_stream_grow`) disagrees about buffer offsets AND RETURN POLARITY, so a wrong binding does not fault — it reports every successful buffer grow as a FAILURE, inside a tokenizer, on file content. Definitions now SPLIT into separate symbols when a private one is involved and the origin files differ; resolution prefers the caller's own private definition, then the first non-private one, then falls through so `_vis_check` still produces the precise 'is private to its file' error rather than 'undefined function'. ⚠ MUST BE MULTI-FILE — the fix keys on ORIGIN FILE, so a concatenated single-file probe gets one file id and exercises nothing, which is precisely why the v6.5.37 gate next door could not have caught it. Axes 5/6 pin what must NOT change: non-private duplicates still warn (`_sk_emit_err` collides between lib/vani.cyr and lib/mabda.cyr at the same arity today) and a same-FILE redefinition is still a duplicate. Axis 4 is the anti-regression that matters most — a fix resolving every name to 'whatever is nearest' would pass axes 1-3 and silently DELETE the feature. Mutation-proven four ways: no-split, resolution ignoring the caller file, resolution dropping the privacy check, and `_vis_check` disabled each redden a different axis (v6.5.38)", "tests/gates/frontend/private_scoped_at_insertion.sh");
    _gate("lazy-init publishes carry a RELEASE FENCE on aarch64 — and ONLY on aarch64. v6.5.37 fixed the PROGRAM-ORDER half of this class (fill a local, publish last) in `_chrono_init_mdays`, mutation-proven on x86 at 0 of 400 threaded runs against 29 of 400 for the pre-.37 publish-first shape. It did NOT fix the MEMORY-ORDER half: cyrius emits no ordering at all for ordinary global access on aarch64 — a threaded aarch64 binary shows the guard read as a plain `ldr`, the publish as a plain `str`, and the whole binary carrying zero `stlr`, zero `ldar` and exactly one `dmb` (atomic_fence's own body). So a racing thread can observe `_chrono_mdays` non-null before the twelve `store64`s that filled it — the same month-13 bug one level down. ⚠ AARCH64 ONLY, and axis 2 exists because the half most likely to be 'helpfully' broken is the guard: the proposal said to copy `lib/alloc.cyr`, which fences on BOTH arches, but that is the OLD shape — x86-TSO already orders store-store, the fence there is pure tax (~22 ns, 83 % of the lock cost), and the project deliberately removed it in `lib/freelist.cyr`. ⚠ NO RUNTIME TEST IS POSSIBLE and that was PROVEN, not assumed: under qemu-aarch64 the known-broken pre-.37 mutant scores 0 bad runs in 150, i.e. qemu does not exhibit the interleaving at all, and real hardware would not catch a 12-store window at any practical rate — so the property is pinned at the CODEGEN level like the f64v4 ymm disasm gate. Axis 3 is a DIFFERENTIAL (a chrono probe must call atomic_fence strictly more often than an alloc-only probe) because the baseline cannot be zero: alloc.cyr fences on aarch64 too, so comparing against zero would be vacuous. ⚠ Three sites, and the proposal named only one of them correctly: `lib/tls.cyr:211` is an ATTEMPT LATCH not a readiness flag (the real site is `_tls_ok`), it MISSED `_tls_introspect_resolved` entirely, and `lib/regex.cyr` is deliberately NOT fenced — its reader has no address dependency so a writer-side fence would not suffice, and the matcher it guards is non-reentrant global state regardless, so fencing it would manufacture a false thread-safety signal. Mutation-proven: fence removed, fence made unconditional, and the missed tls site removed each redden a different axis (v6.5.39)", "tests/gates/concurrency/lazy_init_release_fence.sh");
    _gate("a dependency must NOT overwrite a stdlib leaf the snapshot already provided. A named dep whose NAME collides with a declared `[deps] stdlib` leaf landed its own resolved artifact on `lib/<leaf>.cyr` and WON, because the resolver's phase order guarantees it: Phase 1 copies the stdlib from the pinned snapshot, Phase 2 does named deps, Phase 3 the transitive BFS — and Phase 3 is structurally LAST. Measured at 6.5.38: `cyrius lib sync` writes sakshi 2.4.12 and the very next `cyrius deps` silently reverts it, exit 0, no diagnostic. Blast radius measured: 12 of ~101 stdlib modules share a name with a standalone package repo; 16 of 126 sibling repos are in the collision shape and 8 already carry a leaf differing from their own pin's snapshot. ⚠ THE FILING'S NAMED MECHANISM WAS WRONG — it concluded 'from the named dep's own lib/' from a byte-identity that several files share; the real source is the dep's RESOLVED ARTIFACT (`~/.cyrius/deps/<name>/<tag>/dist/<name>.cyr`), so the filing's second-ranked candidate is not even on this path. It also reads as though the consumer's direct dep is the culprit, when in the filed chain the colliding package is THREE hops down and appears in no manifest the consumer authored — which is why this is enforced in the resolver and not by advising a manifest edit. Axis 1's fixture therefore uses a sentinel string that exists nowhere else on the box, so a clobber is identified rather than inferred. ⛔ AXIS 4 CONSTRAINS THE IMPLEMENTATION and rejects the tempting one: keying on 'does <stdlib_dir>/<name>.cyr exist' is true for ALL ~101 modules, so it would also refuse a project that legitimately depends on a package of that name WITHOUT declaring it a stdlib leaf, leaving it with no lib/<name>.cyr at all. The discriminator must be the stdlib SEEN-SET (what Phase 1 actually copied), which is fully populated and order-insensitive by the time Phase 3 runs. Fully hermetic — path deps only, no git, no network. Mutation-proven three ways, each reddening a DIFFERENT axis: guard removed (axis 1), keyed on existence (axis 4), refusing silently (axis 2) (v6.5.39)", "tests/gates/toolchain/deps_stdlib_leaf_not_clobbered.sh");
    _gate("the stdlib hashes are SEEDED per process, so an offline-precomputed collision set cannot flood a map. Every stdlib hash was a published constant with no per-process state, and the bucket index is the LOW bits of it (power-of-2 capacity, linear probing) — so an attacker who can choose keys computes a colliding set ONCE, offline, and reuses it against every cyrius process forever. Measured on 6.5.38 with 8192 distinct 39-byte keys: cstr map_set 4.05 s colliding vs 4.34 ms distinct = **934x**, hash_str_v 329x; insert and every rehash-on-grow degrade to O(n^2), and no public entry point takes a hash function so consumers could not mitigate it. ⚠ THE FILING SCOPED IT TO TWO FUNCTIONS; IT IS FOUR — hash_str, hash_str_v, hash_u64 (splitmix64 with fixed constants is INVERTIBLE, so preimages for any target bucket are computed directly with no brute force), and _fhm_hash in lib/hashmap_fast.cyr, a VERBATIM second copy the filing never mentioned that floods too. All four now draw from one lib/hashseed.cyr rather than each carrying their own constant, so they cannot drift apart again — duplication is what produced the second unseeded copy. ⭐ THE FIXTURE IS A REAL ATTACK, NOT A SIMULATION: 13 block-pairs computed offline from the published FNV-1a constants alone (a Joux multicollision), giving 2^13 = 8192 keys that share one low-16 hash and land in ONE bucket at every capacity <= 2^16. ⛔ AXIS 2 IS ANTI-VACUOUS AND LOAD-BEARING: the probe recomputes every key through its own verbatim UNSEEDED FNV-1a and asserts that set STILL collapses to exactly 1 bucket, so a fixture that quietly stopped being a collision set cannot score axis 1 as a pass. ⭐ MUTATION ALSO PROVED THE FINALIZER IS REQUIRED, not decorative: with the seed kept but `_hm_mix` removed the attack set still floods at 3559 buckets against ~6448 uniform, because FNV-1a mod 2^k is closed on the low k bits and the index uses exactly those bits. Axis 3 catches a hardcoded 'seed' (which spreads keys but stays precomputable) by requiring two processes to disagree. Seeding is published via atomic_cas, not a plain store: two threads racing first-use would otherwise draw DIFFERENT seeds and hash the same key to different buckets, corrupting the map worse than the flooding this fixes (v6.5.39)", "tests/gates/memory/hash_seed_flood_resistance.sh");
    _gate("resolution errors carry a source excerpt, and `#assert` cannot eat the next statement. TWO defects one function apart. (A) THE EXCERPT ASYMMETRY: v6.5.23 converted the five `undefined variable` sites from fail-fast to report-and-continue, which is why a compile now lists every unresolved name — but `_err_excerpt` lives inside `ERR_IDENT` and those five sites deliberately BYPASS it, because `ERR_IDENT` sets `_panic = 1` and that reinstates the manufactured `unexpected else` regression on lib/fs.cyr which got an earlier attempt REVERTED. So resolution errors printed a bare message while every syntax error got line+caret. ⚠ The fix must stay a bare `_err_excerpt(S)` call and must never be tidied into an ERR_IDENT reroute — axis 2 exists to catch exactly that, because the reroute would silently stop reporting after the first error. (B) ⛔ A LATENT SILENT MISCOMPILE: the `#assert` skip-loop's comment promised 'until ; or newline change' and the loop tested only `;` and EOF — no newline check existed at all, so a `#assert` with no trailing `;` skipped across the following `fn` header and ate the first statement AND its `;`. Measured pre-fix: the axis-3 fixture exits 0 instead of 7 — wrong code, no diagnostic, no crash. Latent only because nothing in the tree uses `#assert` (all 12 grep hits are compiler implementation or comments), so it was waiting for the first consumer who did. Duplicated at THREE sites in three files (parse.cyr pass 2, plus the pass-1 arms in main.cyr and main_win.cyr); axis 3 names both failure symptoms because a partial revert makes the two passes disagree and the fixture fails to COMPILE, while a full revert compiles and returns the wrong answer. ⚠ THE FILING WAS WRONG THREE WAYS and this is recorded so a sweep does not re-inflate it: its residual count (7, re-stamped to 8) was 1 on live code, its '_ends_guard added a site' is false (that site recovers), and its 'R2 must land before R1' dependency is contradicted by the CHANGELOG of the release that shipped both. Axis 4 is anti-vacuous — a plain syntax error must still get a caret, so a globally-broken _err_excerpt is not misdiagnosed as a resolution-site problem. Mutation-proven both ways (v6.5.39)", "tests/gates/diagnostics/resolution_excerpt_and_assert_skip.sh");
    _gate("the serial thread peers' TLS save-window covers the FULL slot range. macOS and agnos have no real thread path, so `thread_create` runs the body INLINE and emulates thread-local isolation by hand: snapshot the caller's slots, zero them for the body, restore afterwards. Both peers snapshotted only the first **16** slots while TLOCAL_MAX_SLOTS is **128** — so a body's write to any slot >= 16 leaked straight back into the caller, which is precisely what that code exists to prevent. Slots 16-127 are the range `thread_local_alloc()` hands out, i.e. every library added since v6.4.65 (sigil's crypto bank, patra's SQL scratch), and four vendored stdlibs are live consumers. Measured on the serial peer: the caller's 42 comes back as 777, the worker's value. ⚠ THE STALE VALUE WAS DOCUMENTED AS CORRECT, which is why reading the code did not catch it — both peers carried `# TLOCAL_MAX_SLOTS (16)` in their headers and thread_local.cyr's own slot-range comment said '16 slots', while the constant beneath it said 128 and the backing arrays were [128]: three comments agreeing with each other and disagreeing with the code. ⛔ WHY A GATE RATHER THAN A SOURCE ASSERTION: the save buffer's size must be a LITERAL because `#assert` accepts only numbers and sizeof(), not a global (verified — it reports 'expected number or sizeof()'), so `var save: i64[128]` necessarily duplicates the constant. A hand-maintained copy of a derivable fact is the exact shape this cycle keeps finding wrong; this gate is what makes the duplicate safe. Axis 2 is the half that actually broke and axis 1 cannot see it: a LITERAL loop bound under-copies SILENTLY rather than overflowing, producing wrong data instead of a crash. ⚠ The gate's own first run caught an extraction bug in itself — `grep -oE '[0-9]+'` on `i64[128]` yields 64 first, out of the TYPE NAME. Mutation-proven both ways (v6.5.39)", "tests/gates/concurrency/tls_window_matches_max_slots.sh");
    _gate("the raised source-size ceiling holds END TO END, and the paired arena caps stay equal. `preprocess_out` was a fixed 8 MB slot and exceeding it was a HARD build failure with no flag, no env var and no manifest key — a project that hit it had exactly one move, make its source smaller, which in practice meant hand-vendoring a subset of its dependencies rather than declaring them. thoth was at ~96 % of the cap before adding anything and a dozen sibling repos measure 8-12 MB. ⭐ RAISING IT EXPOSED FOUR MORE CAPS, each of which became the next wall in turn: 1,048,576 tokens (hit at ~12 MB of realistic source), the 512 KB identifier pool (thoth alone needs ~798 KB), 32,768 functions (hit at ~12 MB), and 65,536 identifier-dedup entries (hit at ~23 MB). Fixing only the filed cap would have moved the usable ceiling from 8 MB to about 10-11 MB — a ~30 % gain that would have been reported as 3x. That is why axis 1 is an END-TO-END compile-and-run rather than a constant check: it measures the ceiling a consumer actually experiences, and it asserts the RIGHT ANSWER because a raised ceiling that miscompiles is worse than the hard error it replaced. ⚠ The probe is generated at REALISTIC density (~45 % comment, reused identifier vocabulary) because a token-dense synthetic hits the token cap first and a unique-identifier synthetic hits the pool first — both would report a wall no real consumer would meet. ⚠ AXIS 2 IS A CORRECTNESS INVARIANT, NOT TIDINESS: PP_REF_PASS copies its expanded output from preprocess_out back into _SRCB, so if the preprocess cap ever exceeds _SRC_CAP that copy runs off the end of the input buffer — and input_buf now sits at the arena top, so off the end of the arena. Axis 3 guards the other direction, someone lowering the cap back to silence a future overflow. ⚠ The gate's own first run failed for the wrong reason: `if (op > 0)` is an unrelated emptiness test in the same file and a lexical sort picked it, yielding a cap of 0 — it takes the maximum now. Mutation-proven three ways across two axes (v6.5.40)", "tests/gates/memory/preprocess_arena_caps.sh");
    _gate("every denominator the capacity meter prints equals the cap actually ENFORCED. THREE occurrences in this one block at three different times: `code_size` reported against a stale 1 MiB until v6.4.73, so a healthy stiva 3.0.6 build printed 2822736/1048576 = **269 %** and `cyrius capacity --json` published that ratio to anything consuming it; `identifiers` reported against a stale 524288 until v6.5.40 after the pool grew to 8 MB — CI caught it printing 200751/524288 while `_capacity_warnings` had ALREADY been updated to 8388608, so the two user-facing numbers disagreed with each other; and `var_table` reported against 8192, which is the INITIAL `_var_cap` and not the ceiling — `_var_grow` doubles it and refuses only past 1048576, so the meter over-reported utilization by up to 128x and a project with 20,000 globals read as 244 % while being perfectly fine (latent, nothing had raised a var-heavy build against it). ⭐ Each is a hand-maintained duplicate of a fact the compiler already enforces elsewhere, printed to users as a percentage — the same self-drifting shape this cycle keeps finding (heap-map sizes vs regions, gate counts vs files, declared string lengths vs strings, the TLS slot window vs TLOCAL_MAX_SLOTS). A one-off correction of a self-drifting value is not a fix, and the third occurrence proved it, so all six are DERIVED here from their enforcement sites. ⚠ A wrong denominator is worse than no meter: it reads as authoritative and harms in both directions — too small provokes a pointless refactor, too large hides a real approach to a hard limit until the build fails. ⚠ The gate's own first two runs failed for the wrong reasons and both are recorded in it: a sed range ending at /67108864/ stopped on a COMMENT that mentions the number while explaining the v6.4.73 fix (dropping the real denominator, reporting 5 of 6), and `_capacity_warnings(S, 67108864, 1)` contains TWO numbers so a `tail -1` derived a cap of 1. Mutation-proven three ways, including both historical defects and the meter/warning disagreement (v6.5.40)", "tests/gates/memory/capacity_meter_denominators.sh");
    _gate("cyrius's AGNOS syscall peer agrees with agnos's frozen ABI contract. ⭐ MECHANIZES A CHECK CLAUDE.md ASKS A HUMAN TO DO BY HAND EVERY REACTIVE WINDOW — 'diff agnos-userland-abi.md against lib/syscalls_x86_64_agnos.cyr once per window; it is the only cheap place to catch an ABI WIDEN of an existing number, the failure class no compile-time check can see.' A once-per-window manual diff is exactly the task that silently stops happening. ⛔ THE CLASS IT GUARDS: a number whose MEANING changed on one side. Nothing in either tree catches that — cyrius compiles fine issuing syscall(N,...) for any N and the kernel dispatches it happily; the program just does the wrong thing. agnos's own contract records why a widen is tempting and wrong: unused syscall argument registers carry STALE VALUES rather than zero, so widening a 0-argument number hands every already-shipped caller an arbitrary pointer (the #100/#101 rule, and why `mountlist` was minted as #104 rather than widening `mount`#11). ⚖️ A DOC-ONLY NUMBER IS REPORTED, NEVER FATAL, and that is deliberate: agnos mints a number, ships the kernel arm, and files for the cyrius peer, which lands on cyrius's schedule — symlink#63 and readlink#70 both shipped in that state, and agnos's state.md rules 'do not fix that gate by editing cyrius, and do not weaken the gate'. ⚠ SCOPED TO THE SYSCALL TABLES (§2..§3.4): the contract also carries §3.4's gpu op-code table and §4.x's struct-layout tables, whose rows have the SAME `| N | name |` shape but mean offset->field — an unscoped parse reports `#0 = f_bsize` against SYS_EXIT and a dozen more, measured on this gate's first version. ⚠ Anti-vacuous floors on BOTH sides (80+ contract rows, 60+ peer constants), because a regex that matches nothing reports nothing wrong and PASSES. ⚠ agnos is a SIBLING repo and may be absent; that SKIPs loudly rather than passing quietly. Mutation-proven three ways: a removed peer reports a gap and still exits 0, a repurposed number and a peer-only number each fail with a precise diagnostic (v6.5.42)", "tests/gates/platform/agnos_abi_doc_parity.sh");
    _gate("a wrapper resolves the cycc SITTING BESIDE IT, so a version pin binds the compiler too. `find_tools()` derived cycc from $CYRIUS_HOME/$HOME and NOTHING else, so `versions/6.5.32/bin/cyrius` resolved `~/.cyrius/bin/cycc` — the CURRENT compiler — while its own sibling sat right there. A manifest pin was not binding on the compiler at all. Proven semantically, not cosmetically: a program built through the 6.5.32 wrapper produced output byte-identical to cycc 6.5.39's and exercised 6.5.39 semantics on a discriminator built from the v6.5.36 enum Critical. ⚠ v6.5.37 made this STRICTLY WORSE rather than adjacent — it fixed the pin redirect so consumers reliably got the pinned WRAPPER and the CURRENT COMPILER, making the mismatch the default path. ⛔ AXIS 2 GUARDS A FIX IN THE OPPOSITE DIRECTION and matters most: v6.5.37 also made ./build/cycc win INSIDE the cyrius source repo, because otherwise every wrapper-driven gate compiles the corpus with the last RELEASED compiler and a compiler change cannot be tested through the wrapper at all. The sibling branch is ordered AFTER that one; put it first and this repo's own suite silently stops testing the new compiler. ⚠ AXIS 3: invoked bare off $PATH there is no path in argv(0) and nothing to be relative to, so it must fall through to the installed toolchain rather than guess from the CWD. ⚖️ LANDED AS-IS ON THE MAINTAINER'S CALL after measurement: 128 of 134 cyrius.cyml files under ~/Repos pin something other than current, and 45 pin into the 6.5.31-6.5.35 band carrying the v6.5.36 enum Critical — those repos were accidentally protected by this very defect (v6.5.42)", "tests/gates/toolchain/wrapper_resolves_sibling_cycc.sh");
    _gate("`cyrius audit` walks the test/bench/fuzz tree, RECURSIVELY. The sweep pushed only src/ and programs/ (plus lib/ in this repo), so tests/, benches/ and fuzz/ were never formatted, linted or checked — THE SUITE THAT GUARDS THE COMPILER WAS ITSELF UNAUDITED: 290 .tcyr files, every shell gate's fixtures, every bench. ⛔ THREE INDEPENDENT HALVES, AND ANY ONE MISSING STILL REPORTS A CLEAN VERDICT OVER NOTHING: the SCOPE did not include tests/; the walkers listed each directory and nothing beneath it, while the suite lives at tests/tcyr/<bucket>/*.tcyr TWO levels down; and `_aw_is_cyr` matched only `.cyr` — its tail scan is anchored at len-4, so 'foo.tcyr' ends in 'tcyr', not '.cyr', and did NOT fall out of the same check. ⭐ THE GATE'S OWN HISTORY IS THE LESSON. Version 1 asserted 'audit passes' — impossible here, since audit already fails by design on cycc's deliberately-unformatted main*.cyr forks. Version 2 grepped the whole transcript for the probe name and PASSED with the recursive descent deliberately removed, because the match came from `cyrius audit`'s own TEST stage failing an invalid .tcyr — it was measuring the test runner, not the walker. Version 3 required the probe to be NAMED, but the fmt stage caps its list at 20 and the widened scope surfaced ~86 pre-existing unformatted files, so the probe landed past the cap. What works is a COUNT DELTA: a valid-but-mis-formatted .tcyr two levels down must move the fmt total by exactly +1, and back. Mutation-proven: removing the descent gives 16 -> 16 (v6.5.42)", "tests/gates/toolchain/audit_scope_covers_suite.sh");
    _gate("no aarch64 syscall is SHADOWED by an x86-compat ESYSXLAT row. ESYSXLAT is a sequential cmp/b.ne chain rewriting x86 numbers into aarch64 ones, and a compat row matches on a NUMBER — it cannot tell an x86 number from an aarch64 NATIVE number that equals it. So a native declaration colliding with a rewritten x86 number is silently reissued as a different syscall, no diagnostic, every gate green. v6.5.36: ppoll(73) -> flock(2) and signalfd4(74) -> fsync(2), kybernet's whole aarch64 target non-functional, filed from outside. v6.5.37: umount2(39) -> getpid(2) — MEASURED, `sys_umount2(\"/nonexistent\",0)` returned 1179922, a PID — and epoll_pwait(22) -> pipe2(59), latent only because nothing called it. ⭐ STRUCTURAL SWEEP, NOT TWO MORE ASSERTIONS: the .36 fix added the two numbers it was told about, and this sweep then found two more in the same table — a gate pinning known symptoms would have shipped green over both. ⛔ THE DISCRIMINATOR IS LOAD-BEARING: five declarations (fsync 74, fdatasync 75, newfstatat 262, faccessat 269, utimensat 280) ARE rewritten and are CORRECT, because the documented pattern is to declare the X86 number and let ESYSXLAT renumber it — so the test is not \"is it rewritten\" but \"is the declared value the x86 number for THIS call or the aarch64 native one\", answered against the x86 peer plus a one-entry documented allowlist for a constant that peer does not declare. A raw collision list reports five false positives. Also asserts the alias band stays LAST (an alias produces a native number a compat row above it would re-catch — the identical bug via reordering) and refuses to run vacuously (>= 20 rows, >= 50 declarations). Mutation-proven: reverting UMOUNT2 to 39 names it and prints the fix; moving an alias row above the compat rows reddens the ordering axis (v6.5.37)", "tests/gates/platform/aarch64_syscall_shadow.sh");
    _gate("package-DIRECTORY family expansion is SORTED before it is walked. `dir_list` returns readdir order, which is filesystem-dependent — measured on lib/unicode at 6.5.36: _casefold_data, casefold, _normalize_data, normalize, _decode ... So `unicode`, the one stdlib module that is a directory rather than a flat lib/<name>.cyr, expanded into a consumer's lib/ AND into its prepended include list in whatever order that machine returned. ⭐ Not cosmetic in a self-hosting toolchain whose promise is byte-identical reproduction — and \"every ordering happens to compile\" is doing real work, because cyrius requires globals DECLARED BEFORE USE, so a member ordered ahead of the data file it reads is a hard compile error. The shape is \"builds here, fails on CI\". ⛔ STRUCTURAL DELIBERATELY, and the reason must survive: the ordering is NOT externally observable — vendored files land in a DIRECTORY, which has no order, and `ls` and shell globs sort their own output, so a behavioural gate listing lib/unicode/ measures `ls` and PASSES AGAINST THE UNSORTED BUILD. That is not hypothetical: the first version of this gate did exactly that and its mutation run came back GREEN, which is the only reason it was caught. `ls -U` shows destination readdir order assigned on write; the order that matters is `_dep_includes`, which cyrius.lock does not record and `deps -v` does not print. Pinning the mechanism and SAYING so beats a behavioural-looking check that cannot fail. Axis 4 is anti-vacuous (deleting lib/unicode would make axes 1-3 pass while guarding nothing). Mutation-proven: removing either expansion site's sort reddens its own axis (v6.5.37)", "tests/gates/toolchain/deps_family_expansion_ordered.sh");
    _gate("a .deps sidecar does not OUTLIVE ITS TRUTH — two halves of one hazard. (1) `cyrius distlib` never REMOVED one: the `vec_len(req_leaves) > 0` guard is deliberate (v6.5.29 — a package with genuinely no leaves should not gain a stray file) but it only decides whether to WRITE, so a package that dropped its whole [deps] stdlib went on publishing the old list — measured at 6.5.36, 7 stale leaves survived the leaf set going empty and `cyrius deps` kept vendoring all seven. (2) `--check` could not SEE that: the comparison was wrapped in `if (file_exists(regenerated))`, so when the fresh run produced no sidecar — exactly what happens once the leaf set empties — the check was SKIPPED and reported *current* over a file that no longer described anything. The ABSENCE of the regenerated file is the signal, not a reason to skip. ⭐ Over-reporting is the direction that matters: an under-reported sidecar fails silently at the consumer's compile step, an over-reported one names leaves the resolver must find and a non-stdlib name is a HARD error before compilation (the dhancha kashi_font_data shape — crab and puka could not resolve it at all). ⚠ REMOVAL, not an empty file, so v6.5.29's intent survives; axis 3 pins the never-had-leaves case so a future change cannot start emitting empty sidecars for every dependency-free package, and axis 4 is anti-vacuous (never writing one at all would pass axes 1-3). Mutation-proven independently: dropping the unlink reddens axis 1, restoring the file_exists wrapper reddens axis 2 (v6.5.37)", "tests/gates/toolchain/distlib_sidecar_staleness.sh");
    _gate("`distlib --check` compares WHOLE bundles, not the first megabyte. _distlib_files_same read 1,048,575 bytes of each side into fixed 1 MB buffers and compared only that prefix, so two files both longer than the cap read back as identical truncated prefixes: measured at 6.5.36 on a 1,489,948-byte bundle, a flip at 500,000 was caught, the SAME flip at 1,200,000 reported \"current\" (exit 0), and truncating the file to exactly 1,048,575 — dropping 441 KB — also passed. ⚠ SIX ecosystem bundles are already past the cap (agnosai 1606588, drishti 1403806, mabda 1304858, shravan 1263123, avatara 1163428, sigil 1105848), so --check was a partial compare on every one. ⭐ THIS IS THE GATE WRITTEN TO PREVENT A REPEAT OF sankoch 2.7.6, where a source fix reached the main bundle and none of the nine profiles — and v6.5.8's own comment says content comparison \"is the only thing that answers was this bundle regenerated\". A prefix compare answers a question about the first megabyte and reports it as the whole answer. Fixed size-first then 64 KB chunked streaming, so memory is bounded by the chunk rather than by an ever-growing literal — which is how the old form fell behind the tree. ⛔ The flip MUST be past 1,048,575: an early-byte test passes against the defective build, so axis 2 is the only one that fails it; axis 3 (truncation) is separate because a size-only fix catches it while a prefix compare does not. Axis 4 is anti-vacuous (an unmodified bundle must still report current). ⚠ Built from THREE modules because a separate, correct 1024 KB per-MODULE read cap fails loudly and would otherwise mask the fixture. Mutation-proven: restoring the prefix compare reddens axis 2 with \"current\" (v6.5.37)", "tests/gates/toolchain/distlib_check_full_compare.sh");
    _gate("manifest key scans read DECLARATIONS, not prose. ⛔ THE `stdlib` HOLE IS THE FOURTH OCCURRENCE OF THE COMMENT-PROSE CLASS AND IT WAS IN THE SHARED HELPER INTRODUCED TO END IT: v6.5.17 fixed cmd_deps (bayan's description saying \"foldable into stdlib per the sandhi pattern\") and created _toml_key_at; v6.5.30 fixed the un-swept second copy (niyama, same phrase); both relied on _toml_key_at's comment guard, which walks only the LEADING whitespace and breaks at the first non-space — so a `#` opening a comment MID-LINE was never seen. One line of ordinary prose (`modules = [...]   # TODO: split; stdlib = [\"math\"] will move here`) reduced seven declared leaves to one wrong one, and `cyrius deps` then vendored math.cyr and NOTHING ELSE, silently, exit 0 — in BOTH directions at once, since producer and consumer share the helper. The decoy need not mention `stdlib`: the scan takes any array literal after the `#`. Fixed for free inside the existing quote counter (a `#` seen at an EVEN quote count is outside a string, so it opens a comment). ⛔ THE `name` SCAN HAD NO GUARDS AT ALL and it decides the output FILENAME — no left boundary, no comment guard, no quote guard, no [package] anchor, and _dep_reject_unsafe_name ran only on --modular. Three measured hijacks: a comment produced `dist/the crate identifier.cyr` (axis 2), `display_name` matched on its `name` tail (axis 3), and `name = \"../victim/pwned\"` wrote BOTH files outside dist/ before any message appeared (axis 4). Axis 5 is anti-vacuous — refusing everything passes axes 1-4. Mutation-proven: reverting the inline-# guard reddens axis 1, reverting the name guard reddens axis 2 (v6.5.37)", "tests/gates/toolchain/manifest_scan_decoys.sh");
    _gate("the .deps sidecar is COMPILE-VERIFIED, not merely inferred — THE DESIGN FIX. Everything upstream INFERS the leaf set from source text (include-scan + declaration + a prune keyed on visible definitions), and that inference is unverifiable by construction AND the only surviving record of what a fold needs: folding destroys the include lines (lib/sandhi.cyr has ZERO), so a dropped leaf is unrecoverable by the consumer, the resolver, or a human. 45 of 118 ecosystem sidecars failed a clean-room build from their own declared leaves, 13 hard. Worked example: sigil-sha named alloc/freelist/string/process/thread/thread_local and NOT syscalls while freelist uses SYS_MMAP 4x — 64 undefined symbols clean-room, 4 leaves re-added after verification, 2 left (Ok/Err, sum-type constructors no leaf declares). ⭐ SELF-HEALING not rejecting, which is what makes it shippable — it repairs the under-report instead of turning 45 publishable bundles into hard errors. ⛔ THREE TRAPS, each of which produced a confidently wrong answer first: (1) absolute include paths are REJECTED by CVE-16 hardening, so an include-built entry yielded only rejection errors and the loop saw zero undefined symbols while appearing to work — sources are SPLICED; (2) a private PEER is not the answer, its DISPATCHER is — SYS_MMAP lives in syscalls_x86_64_linux/_windows/_macos/_agnos and never in syscalls.cyr, so the first cut re-added syscalls_windows and syscalls_macos, putting another platform's syscalls in the build (axis 3); (3) the symbol scan could not see `pub fn` (322 in the snapshot) or ENUM MEMBERS (2604) — and SYS_MMAP is an enum member, so axis 3 failed until enum-block tracking was added. ⚠ Every invocation sets CYRIUS_RESOLVED=1: without it a fixture pinning another version re-execs a binary built before this feature and the gate silently tests OLD code, which is how the feature first appeared not to run. Axis 2 is anti-vacuous (a sufficient sidecar must NOT be inflated, else re-adding everything passes). Mutation-proven: disabling the verify reddens axis 1, disabling dispatcher resolution reddens axis 3 (v6.5.37)", "tests/gates/toolchain/distlib_sidecar_verified.sh");
    _gate("a generated .deps sidecar names ONLY leaves that exist in the STDLIB. `include \"lib/X.cyr\"` in a bundled module means X must be in scope — it does NOT mean X is a stdlib leaf, because a VENDORED dep lands in lib/ too. dhancha's sidecar carried `kashi_font_data` and every consumer's `cyrius deps` then hard-errored \"requires kashi_font_data but it is not in the cyrius stdlib\" — crab and puka could not resolve dhancha AT ALL, and it cost three wrong answers (toolchain regression, lib/ pollution, dep ordering) before anyone read the sidecar. Still live at 6.5.36 in shabda and shabdakosh (`hisab`/`goonj`/`naad`). ⭐ THE ASYMMETRY THAT MAKES THIS FIRST: an under-reported sidecar fails SILENTLY at the consumer's compile step, an over-reported one is a HARD resolver error before compilation — over-reporting is the fatal direction and the one an include-scan cannot avoid alone. ⛔ THE REPO'S OWN lib/ CANNOT ANSWER \"is this stdlib?\" — a vendored dep and a stdlib leaf are both files in lib/; the first cut of this fix checked lib/<leaf>.cyr first and accepted exactly the leaves it was written to drop (26 in, 26 out, all three bogus names surviving). Only the SNAPSHOT can answer it, so axis 1 puts the vendored leaf in the project's own lib/ and that first cut fails it. Axis 2 is anti-vacuous (rejecting everything passes axis 1); axis 3 pins the DIRECTORY-family shape (`unicode` has no flat lib/unicode.cyr, so a flat-only test drops it from every sidecar that needs it — the family the v6.5.31 resolver fix exists for); axis 4 states the property directly. Read-only ecosystem measurement before landing: of 1177 sidecar leaves exactly 6 drop, all bogus, zero legitimate. Mutation-proven: removing the validation reddens axis 1, flat-file-only reddens axis 3 (v6.5.37)", "tests/gates/toolchain/distlib_sidecar_stdlib_only.sh");
    _gate("`cyrius deps` reports failure as a BOOLEAN exit status, not an error count. cmd_deps/cmd_update returned the raw count, which becomes the process exit status, and a wait status carries only the low 8 bits: measured at 6.5.36, 1 bad leaf -> exit 1, 255 -> 255, **256 -> 0**, 512 -> 0. `_auto_deps` propagated it so `cyrius build` exited 0 too. ⭐ THIS IS THE GATE THE OTHER SIDECAR GATES DEPEND ON — it is why a defective sidecar could pass CI at all, and the failure is ANTI-CORRELATED with severity: the more leaves a bundle got wrong, the likelier the resolve looked clean. ⛔ The count MUST be 256, not 1: a count-preserving \"fix\" passes a 1-error test and every small-N test while leaving the exact wrap. Axis 3 uses 512 so a 256-specific special case cannot pass; axis 4 is anti-vacuous (a clean resolve must still exit 0 AND vendor files, else `return 1` unconditionally passes everything else). ⭐ The gate pins the PROPERTY, not the mechanism — a cap-at-255 fix is also correct and also passes, which is the v6.5.36 enum lesson applied: a gate that pins the mechanism passes while the mechanism is wrong. Mutation-proven: restoring the raw count reddens axis 2 alone (v6.5.37)", "tests/gates/toolchain/deps_exit_code_clamped.sh");
    _gate("cyrius deps REFUSES to vendor into a SYMLINKED lib/, and refuses BEFORE delegating. nous/lib was a directory symlink to ~/.cyrius/lib -> versions/6.5.36/lib; nous pins 6.3.35, so the resolver read the RIGHT source and wrote through the link into the LIVE snapshot — 27 files downgraded, alloc.cyr losing fn _alloc_zero (the v6.4.1 memory-reuse infoleak fix, daimon VULN-007) — and because ~/.cyrius/lib is the global default SOURCE, every other repo read the corruption back out; shabda ingested it 12 seconds later, exit 0, silent. ⭐ TWO guards are required and the DISPATCHER one is load-bearing: _try_redirect_to_pinned execve's into versions/<pin>/bin/cyrius before any dispatch, so a guard living only in _dep_copy_file protects repos pinned >= 6.5.37 and nothing else — and stale-lib repos are precisely the old-pinned ones. Axis 1b pins an INSTALLED older version so the delegation really happens (axis 1 pins an absent one and therefore only proves ordering); it announces its skip by name when no second version exists. Axis 3 (a normal repo still vendors) is what fails if the guard is \"simplified\" to refuse every symlink — this repo's own ./lib IS the stdlib. Mutation-proven both ways: disabling the dispatcher guard turns axis 1 red and lets a delegated 6.3.35 write 16 files over the sentinels; disabling the resolver guard turns axis 2 red alone (v6.5.37)", "tests/gates/toolchain/deps_symlinked_lib_refused.sh");
    _gate("`#ref \"file.toml\"` actually emits `var KEY = VALUE;` for every scalar key. Found during the v6.5.22 input_buf relocation: PP_REF_PASS calls `ISREF(S, ...)` and ISREF's FIRST PARAMETER IS A SOURCE BASE, not the state pointer — so when the source buffer moved off S+0 that one call site kept reading the old address and `#ref` silently stopped expanding, surfacing only as `undefined variable` at the USE site with nothing pointing at the preprocessor. ⛔ THE WHOLE CORPUS MISSED IT: 271/271 tcyr passed against the broken compiler, because `#ref` needs an external .toml alongside the source and no .tcyr sets one up — which is exactly why this is a shell gate and not a tcyr, the fixture IS the test. Axis 3 compiles a source with no `#ref` at all, so an over-broad fix cannot pass. Mutation-proven: reverting the call site to `ISREF(S, ...)` turns axes 1 and 2 red while axis 3 stays green (v6.5.22)", "tests/gates/frontend/ref_directive_expands.sh");
    _gate("cx multi-value return: `return (a, b)`, legacy ret2/rethi, and arity-3 all carry EVERY value under cxvm. EMOVRDXRAX/EMOVRA_RDX were return-0 STUBS, so cx handed back the FIRST value TWICE — `return (5, 9)` scored 59 on x86/aarch64/PE and 55 on cx, exit 0, no diagnostic. Must be a shell gate, NOT tests/tcyr/crossos/multi_return.tcyr: a .tcyr pulls in assert/fmt, which the cx backend cannot compile, so the cross-host .tcyr covers x86/aarch64/PE and structurally CANNOT cover the one target the bug lived on. Values are distinguishable and order-sensitive on purpose — `(1,1)` or a sum passes against the defect. Mutation-proven by reverting the two emitters to their stubs: 3 of 4 axes go red (55 vs 59, 133 vs 123) while the single-return axis stays green. ⚠ Swapping build/cycc does NOT mutate this gate — it builds the cx compiler from src/backend/cx/emit.cyr in the working tree, so an old host compiler still picks up the current emitter and the gate passes vacuously (v6.5.21)", "tests/gates/codegen/cx_multi_return.sh");
    _gate("every fn body is PARSED, called or not: a syntax error inside an uncalled fn fails the build for gg / victim / abcdefghij / a, not just for names containing '_'. The old parse-time skip stubbed an unreferenced fn to `xor eax,eax; ret` and brace-skipped its tokens, so whether your function was syntax-checked depended on a CHARACTER IN ITS IDENTIFIER — and on whether some unrelated stdlib file happened to use that word as a local (`n` was checked, `name` was not). It was also fork-divergent: absent from all three aarch64 drivers, so the same source was accepted on x86/PE/Mach-O and rejected on aarch64. Judged on the COMPILER'S EXIT CODE; axis 4 is anti-vacuous (a clean uncalled fn must still build, or the gate would pass by rejecting everything) (v6.5.17)", "tests/gates/frontend/dead_fn_body_syntax_checked.sh");
    _gate("distlib .deps sidecar: the sidecar reports the DECLARED [deps] stdlib UNIONED with the include-scan, so a leaf referenced through the declaration (setu: 4 of 12 missing) is no longer dropped. ⭐ A wrong sidecar switched OFF cyrius deps' own consumer check — an under-declaring consumer built OK, silently. Profiles keep the pruned inference so a narrow bundle cannot over-report. Axis 5's decoy must precede the real key: the scan stops at its first match, and the appended form passed against a build with the guard deleted (v6.5.10)", "tests/gates/toolchain/distlib_deps_sidecar.sh");
    _gate("alloc_via no plumbing: the dispatch helpers read the vtable inline instead of through accessor CALLS, and arena_allocator registers the real fn rather than a pass-through trampoline — 15.1ns -> ~11ns on the hottest path the _a convention has. Structural axes guard both halves; the perf tripwire alone cannot say which regressed, and _bump_alloc/_bump_reset must STAY (they adapt arity, they are not pass-throughs) (v6.5.10)", "tests/gates/memory/alloc_via_no_plumbing.sh");
    _gate("sync mutex three-state: the Linux futex lock is 0/1/2 so unlock stops syscalling on EVERY release (392ns -> 48ns uncontended). Needed NO new primitive — a successful boolean CAS 1->0 already proves the pre-value, correcting the roadmap. Mutation-verified across three axes: unlock-never-wakes and a re-read expected-value HANG; a wrong fast-path state is caught only by the perf tripwire; dropping the 1->2 upgrade is caught only STRUCTURALLY (it stays correct and degrades contended throughput alone) (v6.5.9)", "tests/gates/concurrency/sync_mutex_three_state.sh");
    _gate("distlib --all/--check: every declared [lib.X] bundle is regenerated, and --check names any STALE one and exits non-zero — the sankoch 2.7.6 shape where a source fix reached the main bundle and none of the nine profiles. Compares BYTES, not version strings, which is exactly what let those profiles look fresh. Before this, --all and --check were swallowed by the arg loop and ran the base-bundle-only path, exiting 0 (v6.5.8)", "tests/gates/toolchain/distlib_all_profiles.sh");
    _gate("stdlib key-scan boundary: cmd_deps' raw-byte scan finds the REAL `[deps] stdlib` key, so the auto-prepend happens. bayan got NONE — its [package] description says 'foldable into stdlib per the sandhi pattern', 533 bytes above [deps], and the two existing guards (identifier boundary, comment line) both accept a key spelled inside a QUOTED VALUE. The positional array parse then grabbed the `[build]` SECTION HEADER, returned empty, and the scan `break`ed anyway — _dep_includes stayed empty, SYS_WRITE was undefined, and `cyrius distlib` exited 1 on a bundle proven CORRECT. It failed SILENTLY: errors never incremented, so even the 'N deps resolved' line was suppressed. ⭐ THE TWO FIXES OVERLAP ON THE FILED REPRO — reverting the quote guard alone leaves axis 1 GREEN because that mis-parse happens to land on a section header and return empty, so axis 2 gives the guard a mis-parse onto a REAL array (the v5.5.26 patra shape) and axis 3 gives the empty-parse fix a trailing inline comment, which passes all three boundary guards. Mutation-verified three ways: guard-only revert RED on axis 2, empty-parse-only revert RED on axis 3, both reverted RED on 1/2/3/5 (v6.5.17)", "tests/gates/toolchain/stdlib_key_scan_boundary.sh");
    _gate("distlib bundle self-check: the generated bundle is ACTUALLY COMPILED, and one that does not compile exits non-zero instead of printing `unresolved symbols (expected)` and 0. The old check compiled to /dev/null, where compile()'s `<out>.tmp.<pid>` intermediate cannot be created — so it failed on the WRITE every time and cycc never saw a bundle; broken and perfect bundles printed the same reassuring line. Fixing only the temp path exposes the second half: piping a bundle to stdin hits cycc's 1 MB input_buf and sigil's main bundle passed 1 MB, so it now compiles through a generated entry that `include`s the bundle (the consumer path, resolved from disk, no cap). --allow-undef keeps the ONE expected failure expected (v6.5.14)", "tests/gates/toolchain/distlib_bundle_selfcheck.sh");
    _gate("coverage corpus + fail-open: the >1 MiB test corpus is searched in full (grow-and-retry), a symbol flush against the corpus end is found (<= bound), `pub fn` counts, a subfolder callout is honoured, and an EMPTY measurement fails instead of reporting a percentage and exiting 0. Axes 1-2 are order-independent by construction — dir_walk gives no ordering guarantee and the first version passed against the truncating build (v6.5.8)", "tests/gates/toolchain/coverage_corpus_and_failopen.sh");
    _gate("cyrfmt string-literal continuations: fmt is behaviour-preserving across a literal that spans physical lines — both the trailing-`\\` form (which KEEPS the newline; not a C splice) and a bare raw newline. cyrfmt reset its in_string tracking on EVERY physical line, so the enclosing statement's indent landed INSIDE the string; agnosai's YAML fixture gained 4 spaces, which in YAML is a nesting change, and `fmt --check` AGREED with the writer so a CI cleanliness gate pushed projects onto the corrupted form. 4 independently mutation-proven axes — indent gate (the filed repro), trailing-trim gate (a DELETION vector the filed shape cannot see), leading-strip gate, and the brace ledger. ⭐ The ledger axis was VACUOUS as first written: once the ledger desyncs every later line is treated as string interior and emitted VERBATIM, so a broken formatter reproduces an already-correct fixture perfectly — it now feeds mis-indented code AFTER the literal so only a formatter that resumes code tracking can pass. Plus idempotence and an anti-vacuous axis so `fmt = cat` cannot score green (v6.5.18)", "tests/gates/toolchain/cyrfmt_string_continuation.sh");
    _gate("_auto_deps VERB-SET gate: every verb main() dispatches that transitively reaches compile()/_materialize_source() is in the AUTO_DEPS_VERBS list, or allow-listed with a reason. Derived from the CALL GRAPH over all of cbt/, not from the verb string — because a per-verb list is what produced FIVE identical patches (fuzz v5.7.21, soak+smoke v5.7.38, audit+capacity v6.4.73, distlib v6.5.17, doctest v6.5.19) and the v6.5.17 patch CREATED the sixth: cmd_publish calls cmd_distlib one frame away, so adding the `distlib` string left the same defect live under `publish`, printing the same misleading 'the generated bundle does not compile' and then git-tagging the release. Auditing the whole set found `package` too (printed 'package ready in build/', exit 0, no artifact). Exemptions must stay live AND still reach compile (axis 3) so the allow-list cannot rot; `pulsar` is the load-bearing one — auto-prepend makes it build a 434,360-byte-larger cycc that is NOT the fixpoint binary. Axis 0 floors every derived quantity and axis 4 pins known-true/known-false rows, because a static analyser that parses nothing reports nothing missing and PASSES. ⭐ Axis 6 RUNS the three verbs, because the static half proves the LIST is complete and cannot prove the ENTRY WORKS — `_materialize_source` needs BOTH `_skip_deps == 0` and a populated `_dep_includes`, and the first attempt at the v6.5.17 fix set the flag alone and changed nothing. Mutation-proven by swapping in the shipped 6.5.18 CLI against the fixed source: static axes stay green, all three runtime verbs go red (v6.5.19)", "tests/gates/toolchain/auto_deps_verb_gate.sh");
    _gate("`cyrius deps` resolves a dep's `dist/<pkg>.deps` sidecar leaves out of the PINNED SNAPSHOT, not out of the consumer's own half-populated `./lib`. `_dep_find_stdlib_dir()`'s cyrius-source-repo branch tested `file_exists(\"src/main.cyr\")` — TRUE for essentially every cyrius project, since that is the entry the init templates generate — so for a downstream repo it returned the consumer's `./lib` AS the stdlib and the version-pinned snapshot was NEVER consulted. Any sidecar leaf not already copied there looked absent, so `cyrius deps` reported `dep libro requires 'bench' but it is not in the cyrius stdlib` about a module that ships in the stdlib, pointing maintainers at deleting a correct declaration. ⭐ A FUNCTIONAL failure, not the diagnostic one it was filed as: a first pass rewrote the MESSAGE and left the resolve broken. Reproduced verbatim on the real bote tree (3 errors: bench/test via libro, patra via majra), 0 after, all three leaves copied in. Third occurrence of the `src/main.cyr` != cyrius-repo conflation (v6.0.1, `cyrius audit` v6.4.63); `_dep_is_cyrius_source_repo()` exists for it and matches `[package].name` exactly. ⚠ Axis 4b is load-bearing: the FIRST version of this gate shipped VACUOUS — with an empty `./lib` the old code fell through to the snapshot on its own, so a non-empty `[deps].stdlib` (which pre-populates `./lib`) is required for the bug to reproduce at all; caught only by mutation-testing. Axis 5 pins that the cyrius repo itself still resolves via `./lib`. Mutation-proven: restoring the file_exists probe turns axes 1-3 red with the filed message verbatim (v6.5.25)", "tests/gates/toolchain/deps_stdlib_dir_not_consumer_lib.sh");
    _gate("`_distlib_named_deps` recognises a `[deps.X]` SECTION HEADER only, never the same text in COMMENT PROSE. The exclude-set scan matched the literal `[deps.` ANYWHERE in the manifest with no line anchoring, so a comment explaining the layout registered its example dep as real — and because that set means \"this is a fold, not a stdlib leaf\", the named leaf was then EXCLUDED from the generated .deps sidecar. Filed from patra (11 leaves emitted against 12 declared, `sakshi` missing), confirmed in libro. Silent packaging corruption: the BUNDLE stays correct so nothing fails, and only a clean-room consumer resolving from the sidecar comes up short — which is what the sidecar is FOR. ⚠ The upstream symptom NO LONGER REPRODUCES: at patra 1.13.8 the manifest contains no `[deps.` text at all, the triggering comment having been removed upstream, so this gate tests the PARSER RULE directly rather than re-staging a consumer tree. A defect whose only witness has been edited away still needs a regression test, and one that depends on a third-party file staying wrong is not a test. Axis 3 is anti-vacuous (deleting the whole scan would satisfy the two guard axes); axis 4 is behavioural against patra's real sidecar (v6.5.28)", "tests/gates/toolchain/distlib_named_deps_anchored.sh");
    _gate("a `[deps].stdlib` entry gets its top-level `include` prepended even when an EARLIER entry already pulled it in TRANSITIVELY. `_dep_copy_stdlib_recursive` does two jobs — copy the file, and push `include \"lib/<mod>.cyr\"` for top-level entries — and its seen-guard returned BEFORE the push, so a module pulled transitively (is_top=0) was marked seen and its own `[deps].stdlib` entry then short-circuited without ever pushing the include. lib/X.cyr sat on disk, `cyrius deps` reported success, the lockfile listed it, and every symbol in X was an undefined function with NOTHING in the output naming X. ⚠ Purely an ORDERING artifact — the SAME declared module set builds or fails on which entry comes first, which is what made it expensive: the manifest looks correct because it IS correct. Filed from kavach 3.11.14 (whole tree stopped building on a 6.5.21->6.5.27 pin move). ⛔ Not confined to [deps].stdlib: `_dep_pull_leaves` calls the same fn with is_top=1 for the `requires` key and dist/<pkg>.deps, so a bundle whose sidecar lists leaves in an unlucky order handed the identical failure to EVERY consumer. Axis 0 is anti-vacuous (a repro that printed nothing would otherwise pass); axis 3 pins that BOTH push sites keep their is_top gate, because pushing transitive includes too would make axes 1-2 green while re-opening a PRIOR bug — an explicit include overrides the #ifdef CYRIUS_TARGET_* arch dispatchers, parsing both syscall peers at once (v6.5.28)", "tests/gates/toolchain/stdlib_transitive_include_pushed.sh");
    _gate("`cyrius fuzz --poison` makes an out-of-bounds READ and a use-after-free OBSERVABLE, and changes NOTHING when off. THE FILED GAP (sit v1.4.0): a `.git` packfile delta interpreter bounds-checked its destination but not its source, copying 127 bytes of adjacent heap — including a live heap pointer, an ASLR-defeating disclosure — into output an ordinary read-only command printed. 10 MILLION rounds/run of fuzzing ran over it for three minor versions and passed; it was found by READING THE CODE. The read landed in MAPPED memory, so there was no fault to catch: an out-of-bounds WRITE is caught only if it reaches an unmapped page, and an out-of-bounds READ essentially never is, so every `fuzz: no crashes` line in every consumer's CI carries that asterisk. `.28` shipped the alloc-side FILL and deferred redzones and quarantine-on-free, stating a free-side poison needs the block's original size which the size-class path does not store. \u26d4 That was wrong about the more valuable half: the class yields the block's CAPACITY, and filling the whole capacity on free is strictly SAFER than filling the requested size. The redzone does need the size, and the class table has ZERO slack, so poison mode BUMPS THE CLASS and stores the size in the last 8 bytes of capacity — no header change, no heap-layout change, no two-step bootstrap. Delivered as a COMPILE-TIME predefine on ALL SEVEN forks, because `lib/freelist.cyr` depends on mmap + atomic only and must not read the environment — and because a fuzz mode that exists only on x86-Linux tells three other platforms' consumers nothing. \u26a0 This gate tests the TOOLCHAIN, not the allocator (that is tests/tcyr/memory/fl_redzone_quarantine.tcyr): consumers' existing harnesses do not call `fl_poison_enable()` themselves, so a mode nobody switches on is not a mode. Axis 4 is the anti-vacuous one — it requires the SAME overread to stay invisible WITHOUT the flag, so a build with poison permanently on fails. Both mutations RED (v6.5.29)", "tests/gates/memory/poison_mode_observable.sh");
    _gate("the `[deps] stdlib` key scan never matches the word inside a QUOTED VALUE, in EVERY copy of the scan. niyama's `[package] description` reads \"...foldable into stdlib per sandhi pattern\" eleven lines above its real key; the identifier-boundary guard passed (preceded by a space) and the comment guard passed (not a `#` line), so `_distlib_union_declared_stdlib` locked onto the DESCRIPTION, `_parse_toml_str_array` walked to the next `[` — a section header — and returned empty. Zero leaves meant the `vec_len > 0` guard was false and `cyrius distlib` wrote NO SIDECAR AT ALL, silently, for a correct bundle. \u26d4 SAME BUG, SAME PHRASE, SAME MANIFEST SHAPE as the bayan defect fixed at v6.5.17 — which corrected `cmd_deps` and introduced the shared `_toml_key_at` helper but did NOT sweep the other two copies, so the identical defect sat here thirteen releases and re-surfaced through a different consumer. Ecosystem sweep found drishti in the same state. THE LESSON IS THE `_cfo` LESSON: grep the SHAPE, not the site — hence axis 3, a STRUCTURAL row that fails if any `\"stdlib\", 6` site drifts back to a hand-rolled boundary check, even while the behavioural axes stay green. Axis 2 is anti-vacuous (an empty sidecar would satisfy axis 1). Mutation-proven (v6.5.30)", "tests/gates/toolchain/stdlib_key_scan_quoted.sh");
    _gate("`#derive(...)` on a non-struct FAILS LOUDLY and names the declaration. `PP_PARSE_STRUCT_DEF` advanced `ip + 7` — the width of \"struct \" — with no check that the keyword WAS `struct`, so on `enum probe_e` it skipped \"enum pr\" and read the name as `obe_e`. That is exactly where ranga's long-recorded \"misnamed, crashing codec\" symptom came from; the downstream emit later stopped producing anything, which is why the symptom CHANGED to silence — two symptoms, one cause, and the port plan's stale note was right when written. By 6.5.27 `#derive(Serialize)` above an enum compiled rc=0, no diagnostic, NO codec, discovered as an undefined `<name>_to_json` at link time and only if the codec was ever called; ranga hand-writes four enum codecs because of it. \u26a0 No .tcyr can catch this — the old behaviour was rc=0 with clean output, indistinguishable from a derive that worked, so the assertion must be on the DIAGNOSTIC and the exit code of a compile that must fail. Axes 4 and 5 are the anti-vacuous pair: a struct derive must still generate a CALLABLE codec (2-arg composable form) and a bare struct derive must stay rc=0, so rejecting every derive fails. Codec GENERATION for enums is filed separately — its JSON wire shape is a maintainer contract decision, not an implementation detail. Mutation-proven three ways (v6.5.30)", "tests/gates/diagnostics/derive_non_struct_rejected.sh");
    _gate("a NEGATIVE enum value is accepted, and rejected only where it cannot mean anything. `enum E { B = -1; }` was `error: expected number, got '-'`, and `B = 0 - 1` is an expression an enum body will not take either, so a negative constant could not be spelled AT ALL — yet sentinels (-1 for none, negative errno families) are ordinary. \u26d4 v6.5.31 wrote this down as a language limitation instead of fixing it, in the repo that OWNS the parser; that is the antipattern CLAUDE.md records as dont-encode-codegen-bugs-as-language-rules. \u2b50 THE ENCODING WAS THE REAL WORK, not the parse: enum_const_val packs a presence marker into BIT 63 and five separate readers recovered the value with a bare `& 0x7FFFFFFFFFFFFFFF`, which for -1 yields 0x7FFF_FFFF_FFFF_FFFF — a colossal POSITIVE, so the constant silently became the wrong number and compared GREATER than zero. Fixed in one shared decoder: bit 63 is always set on a live entry, so for a negative value the marker already IS the sign bit and the slot is returned unchanged; only positives need it cleared. \u26a0\u26a0 The decoder MUST NOT live in src/common/util.cyr — any fn with a BRANCH there makes cybs emit a gen1 that links and then dies with SIGILL compiling src/main.cyr. Bisected: identical fn fine in parse_types.cyr and parse_expr.cyr, branch-free fn fine in util.cyr, so it is position-specific to util.cyr in the bootstrap compiler and ONLY seed-derive catches it. Axis 4 is anti-vacuous (a check that rejected every enum-sized array would satisfy axes 2-3 while breaking the documented `enum Sz { N = 16; } var buf[N];` idiom); axis 5 is STRUCTURAL, failing if any reader re-grows its own mask. Mutation-proven six ways (v6.5.32)", "tests/gates/diagnostics/enum_negative_value.sh");
    _gate("cybs does not STRAY-WRITE into the code stream from `parse_if_else`. That routine emits an `E9` plus a 4-byte hole for the skip-over-else jump, records the hole's offset in **rbx**, recursively parses the else body with `call parse_program`, then patches — and something inside that recursive parse CLOBBERED rbx, so the deferred `patch_rel32` fired with a stale offset and wrote a rel32 into an arbitrary place in the emitted compiler. \u2b50 IT CORRUPTED EVERY BUILD: instrumented tracing of gen1 found exactly ONE orphan patch (a PATCH with no matching SET) in the ordinary build too — it merely landed inside a `movabs` immediate, where a wrong constant in that spot was survivable. Shift the layout ~80 bytes (adding any branching fn to src/common/util.cyr did it) and the same write lands on an INSTRUCTION BOUNDARY: gen1 links fine and dies with SIGILL/SIGSEGV compiling src/main.cyr. That is why it read for a whole release as \"util.cyr cannot take a branching function\" — a position-dependent symptom of a register-discipline bug three layers down, and the `(x >> 62)` probe that also broke was NOT a second bug but the same write landing elsewhere. \u26a0 AXIS 3 MUST COMPILE THE REAL COMPILER: a first draft used a three-line probe and SURVIVED the mutation, because the stray patch lands in one region that a toy input never executes — the entire point of the bug is that gen1 links and looks fine until it does real work. Axis 1 is structural (stops the fix being tidied away), axis 2 keeps the seed->cybs->seed closure. Mutation-proven: reverting the rbx save turns axes 1 and 3 red with rc=139 (v6.5.33)", "tests/gates/toolchain/cybs_if_else_rbx.sh");
    _gate("EVERY `.bcyr` and `.fcyr` still COMPILES. The corpus loop covers `tests/tcyr/**` and nothing else, and the bench step is NON-BLOCKING by design, so a bench or fuzz source can stop compiling with no gate saying a word. Not hypothetical: the bayan 1.4.2 fold at .29 broke five `.tcyr` (caught by the corpus) AND `benches/bench_mulmod.bcyr` — caught only because a human compiled it by hand while chasing the .tcyr failures. Had the five tests not also broken, the bench would have shipped broken and silent. Same shape as the v6.5.12 `bench_string` finding: a 56-byte stack overflow that SIGSEGV'd from v6.3.15 onward, invisible behind the non-blocking bench step. \u26a0 COMPILE only, deliberately — benches are long and fuzz harnesses unbounded, so running them here would make the gate a timeout waiting to happen; compiling is what catches rot from a stdlib fold, a renamed symbol or a tightened type, which is the failure mode actually observed. Carries a premise row because an unmatched find would report 0 failures and read as success — a fake PASS from an empty glob is a documented failure mode in this tree. Mutation-proven against the real breakage (v6.5.29)", "tests/gates/toolchain/bench_fuzz_sources_compile.sh");
    _gate("`cyrius distlib <profile>` emits a sidecar SCOPED to that profile. TWO consumer filings, ONE defect: ranga (M5) got header-only `.deps` for its `[lib.spectral]`/`[lib.hwaccel]` profiles, sit (v1.4.0) got no `dist/sit-read.deps` file at all and blamed `out_path`. `out_path` is INNOCENT — the path derivation was always right; the leaf SET was empty, the `vec_len > 0` guard wrote nothing, and the base sidecar left on disk from an earlier run is what the reporter read as `overwritten with 38 leaves`. ROOT CAUSE = two individually-reasonable rules that compose into a guaranteed-empty file: v6.5.10 unioned the declared `[deps] stdlib` BASE-ONLY (a profile is a subset, so unioning would over-report), leaving profiles on include-scan inference — while the toolchain's OWN guide says includes are auto-prepended, so a conforming project has no stdlib include lines to scan. Fix keeps the intent and inverts the mechanism: union for profiles too, then PRUNE to what the bundle references — over-reporting blocked by a positive filter instead of by withholding the leaves. Plus the prune now follows a leaf's PRIVATE (name-prefixed) peers, because `lib/syscalls.cyr` is a dispatcher with TWO top-level definitions and every `sys_*` wrapper in a per-arch peer — judged literally it defines nothing and was dropped. \u26a0 The prefix guard is load-bearing: `tls_native` also includes alloc/string/io/sigil, so an unguarded recursion kept it in sit's read profile though none of its 27 symbols appear in the bundle. Axis 3 is anti-vacuous for `always write the file` (an empty file would satisfy axis 1); axis 5 for the peer recursion; axis 7 for the always-write rule itself, and axis 7 is the ONLY axis whose profile has a legitimately empty leaf set. All four mutations RED. \u26d4 This shipped in .29 after being WRONGLY archived as fixed at .28 (v6.5.29)", "tests/gates/toolchain/distlib_profile_sidecar.sh");
    _gate("the cyrfmt CONTINUATION-INDENT contract and the fmt CLI modes. cyrfmt indented every line at brace_depth*4 and NEVER TRACKED PARENS, so a continuation line inside an unclosed `(` came out at the enclosing statement indent — then `--check` compared byte-for-byte and exited 1 in SILENCE (no diff, no message, no line), so a consumer CI failed with nothing to act on while `cyrius fmt` (stdout-only) offered no in-place way to fix it. Filed from rupa 0.1.3, worked around by un-wrapping every call. ⚠ BOTH the filing headline AND its first refutation were half wrong: wrapped calls are NOT rejected (the line break survives), but fmt own output still failed fmt own --check, so the unfixable-in-place state was real. ⚖️ Maintainer contract 2026-08-18: canonical is 2 spaces per open paren level, 4 is ACCEPTED, deeper REJECTED — \"else it wouldn\'t be a format check\" — a tolerance exactly two shapes wide, so already-formatted trees do not churn and the check is still a check. Implemented by re-running the formatter at step 4 rather than teaching the comparison to skip indent differences, which would accept 8 and 12 too. `cyrius fmt` now REWRITES IN PLACE (breaking change from stdout-only), `--dry` reports without touching, `--verbose` writes and echoes. The 12-space axis is the anti-vacuous one: without it the tolerance is unbounded (v6.5.28)", "tests/gates/toolchain/fmt_continuation_contract.sh");
    _gate("duplicate-fn attribution: a `duplicate fn` warning names a file:line a user can OPEN. FM_LOOKUP reconstructs the source line by linear arithmetic over a `#@file` span, valid only while the preprocessor copies a file 1:1 — and TWO transforms broke that inside a span with no re-anchor: the #ifdef family consumed directive lines and dropped skipped bodies (line too SMALL; agnosai's kavach: 30 warnings, uniformly true−55) and #derive replaced 2-3 source lines with N generated ones (too LARGE; +476 by line 11112, so `lib/kavach.cyr:11588` named a line 267 past EOF of an 11,321-line file). 35 of 35 warnings had the wrong line. #ifdef is fixed by PADDING one newline per consumed/skipped line (no marker, no pressure on the 1024-entry map cap — a marker per block would need ~1139 and overflow makes FM_FILEID return -1, which `private` visibility is load-bearing on); #derive, which ADDS lines, is made line-exact instead — its directive lines are padded the same way, the struct is copied byte-for-byte (a field look-ahead scan used to re-copy the whitespace run after every `;`, DUPLICATING its newline: that was the +N) and the generated block is FLATTENED onto the struct's closing-`}` line, so the construct occupies exactly the source lines it consumed and carries NO marker at all. Axes 1 and 2 fail INDEPENDENTLY, axis 3 runs both so the drifts cannot cancel, axis 4 crosses an include boundary, and axis 0/6 are anti-vacuous. ⭐ THREE axes were added after the first cut, each closing a hole the first six had: axis 8 is an #ifdef inside an include with NO #derive after it, because a derive used to REPAIR the drift ahead of the duplicate — deleting the PP_IFDEF_PASS half of the padding alone left axes 0-6 fully green against a genuinely different compiler; axis 7 pins both #define forms, because the padding UNMASKED a defect it did not cause (PP_EXPAND ended with an unconditional newline, +1 per function-like invocation, which the unpadded #define line used to cancel exactly once — so ONE invocation must be pinned as well as several, and a wrapped arg list must still emit the lines it CONSUMED); axis 5b is a source with no trailing newline, where FM_BUILD sized the last span from a newline count and the final line fell out of every span, so the report was a raw expanded line past EOF with no `<file>:` prefix at all. ⭐ v6.5.20 added axes 9-13, for the residual a re-anchor structurally could not reach: a defect INSIDE a derived struct (was +1) and a duplicate of a SYNTHESIZED accessor (was 15..18 for a 14-line file — every one past EOF). ⚠ AXIS 11 IS THE LOAD-BEARING ONE and is judged on the PROGRAM'S EXIT CODE, not a line number: flattening wants the closing-`}` line, and consuming that line's tail is SILENT CODE LOSS — its shadowing sub-case compiles clean, warns nothing and returns 1 instead of 2. Axis 13 gives the emitted-literal `#` audit teeth (a `#` on the flattened line comments out every fn behind it; the one offender was reachable only through a nested-struct-typed field, a shape no .tcyr had). Fourteen mutants BUILT AND RUN across the two cuts; M3b (drop only the tail copy, line accounting still perfect) is caught by axis 11 ALONE, and M6 (no flattening) by axis 10 alone (v6.5.19/.20)", "tests/gates/frontend/duplicate_fn_attribution.sh");
    _gate("cyrius lint reports a file that does not parse — and still lints one it merely cannot RESOLVE. cyrlint is a 929-line line-based scanner with no parser, so `0 warnings` was a true statement about its nine rules and a false one about a file `cyrius build` rejects. cmd_lint now runs a compiler syntax pre-pass under _skip_deps=1 and classifies on the MESSAGE CLASS, never the exit code: 38 of the 191 files this repo lints exit non-zero standalone, 27 with `undefined variable` through the same _err_head and the same exit 1, so exit-code gating would make lint refuse 20 % of the stdlib. ⭐ Axis 3 is the discriminator that catches that wrong implementation — lib/fs.cyr in a bare dir with no manifest and no lib/, proven unresolvable by `cyrius check`, must still be linted. Axes 2 and 5 are anti-vacuous so the gate cannot be satisfied by condemning everything (v6.5.19)", "tests/gates/frontend/lint_reports_unparseable.sh");
    _gate("thread_join single-load: the FUTEX_WAIT expected-value must be a tid observed LIVE, never a second load — two independent loads let the kernel's one-shot CLEARTID wake be discarded and the joiner park forever. STRUCTURAL by necessity: the companion .tcyr passes 131/0 against the broken code (mutation-verified), and the race is ~1 in 150k so a stress loop cannot prove absence (v6.5.8)", "tests/gates/concurrency/thread_join_single_load.sh");
    _gate("freelist thread-safety: fl_alloc/fl_free serialise on a _threads_active-gated CAS spinlock. FIVE races, not the one majra filed — fl_init's check-then-set, the pop, the push, the arena bump and the arena refill, the last publishing three globals across an mmap. The structural axes catch what a Linux runtime test cannot: exactly ONE `_threads_active` declaration (two copies means one allocator's lock never engages) and all four thread backends still arming it (dropping thread_win.cyr's leaves the freelist unlocked on WINDOWS ONLY, invisible here — the macOS-rot shape). ⭐ Axis D proves its own sensitivity every run: the pinned probe must pass against the real stdlib AND fail against a copy with the lock stripped. Do not assert on a crash — consecutive anon mmaps land adjacent, so the off-the-end block lands in a mapped neighbour: 0 faults in 80 tries (v6.5.19)", "tests/gates/memory/freelist_thread_safe.sh");
    _gate("bench timer floor is MEASURED: `clock_gettime: ~120ns per call` sat in lib/bench.cyr for two years against a real 1,320-1,720ns here, 3,550ns on pi and 15-32ns on ecb — a 230x spread, so no single number is right and the framework calibrates its own. `120` was in NO arithmetic anywhere; it was a wrong FACT that made per-iteration timing look affordable, which floored all 18 benches at ~2 clock reads and left 57 of 79 recorded micro rows measuring the timer (a no-op read 2,302ns through bench_run and 9ns batched). A runtime test cannot see a comment, so the grep is what stops the number coming back; `RETIRED:` lines are exempt so the header can still quote it, capped at 3 (v6.5.19)", "tests/gates/toolchain/bench_timer_floor_measured.sh");
    _gate("test runner is BOUNDED: a spinning .tcyr is killed at a deadline, and no test child outlives the runner. run_binary was fork + execve + BLOCKING waitpid with no deadline and nothing tying the child's lifetime to the parent, so a hanging fixture hung the suite forever and killing the runner REPARENTED the child to PID 1 to burn a core indefinitely — 19 such orphans were found on the maintainer's box, the oldest at 1h42m, together ~13 of 16 cores, and they flipped the release gate's alloc_via_no_plumbing 14ns tripwire RED, which TWO implementers wrote off as 'environmental load'. A release gate whose perf tripwires can be flipped red by its own leaked children is not a gate. Both halves are needed and neither substitutes: a deadline (poll waitpid(WNOHANG) on a widening interval, then SIGKILL) for the hang, and PR_SET_PDEATHSIG(SIGKILL) set between fork and execve for the orphan — a SIGKILLed parent runs no cleanup, ever, so only the kernel can reach the child. ⭐ Axis 1b must use a MULTI-FILE suite: after a one-file run the runner exits immediately and PDEATHSIG reaps the child regardless, so the single-file check stays GREEN even with the deadline's SIGKILL mutated to a no-op — the leak is only observable while the runner is still alive, which is also the shape that burned the box. Two spinning fixtures make it order-independent; correct = never more than the one child currently running (mutation-proven: pristine max 1, sys_kill(pid,9)->sys_kill(pid,0)+WNOHANG max 2). ⚠ FOUR of this gate's own assertions shipped broken and three FAILED OPEN — a `ps` grep that matched its own command line (use the [t]est_bin bracket idiom), an anti-vacuous fixture with no assertions so the summary it greps for was never printed, a comment MENTION counted as a call site, and a hermetic CYRIUS_HOME with bin/ but no lib/ that made axis 4 vacuous (v6.5.19)", "tests/gates/toolchain/test_runner_bounded.sh");
    _gate("`cyrius build` leaves NO preprocessed-source temp on any exit path. `_materialize_source` writes <tmpdir>/cpp_<pid> (the dep-prepended, #@incdir-marked source cycc actually reads) and the unlink sat after sys_waitpid — but the call is at :618 and the fork at :679, and the pre-fork `probe_fd < 0` bail-out returns between them, so BOTH `output directory does not exist` and `cannot write output` leaked one temp per invocation. 19,753 leftover cpp_ temps were on the maintainer's box when this gate was written (21,289 dirs / 2.8 GB per state.md). The comment above the unlink asserted both paths were covered and named only the post-fork pair, which is why this gate COUNTS instead of reading. Axis 0 is load-bearing: _materialize_source returns its argument unchanged when there is nothing to prepend, and then every zero-delta assertion is trivially true, so the fixture proves a temp exists via a sibling include that resolves ONLY through the marker at byte 0 of the temp. Axis 4 proves the COUNTER can see a planted temp, since a counter that always reads 0 makes every delta pass. Mutation-proven: delete the bail-out unlink and rebuild the CLI -> axes 1 and 2 RED at delta 1 each, one per early return (v6.5.19)", "tests/gates/toolchain/build_temp_no_leak.sh");
    println("");

    _section("Binary structural lint (VR-04)");
    _binary_structural_lint_gate();
    println("");

    # v5.9.25 (per v5.9.6 pin): the 6 _tcyr_relay_gate calls
    # previously here (shadow_pam / fdlopen / thread_local /
    # atomics / thread_safety / flags) are removed — each tcyr is
    # ALSO covered by `_testsuite_gate()` below, which walks
    # tests/tcyr/* alphabetically. Pre-v5.9.25 each of these 6
    # files compiled + ran twice per check.sh invocation; now each
    # runs exactly once via the testsuite walk. Audit gate count
    # drops 67 → 61 (six relay-pass lines retired).

    _section("aarch64 native self-host");
    _aarch64_native_selfhost_gate();
    println("");

    _section("aarch64 struct-by-value (Phase 2b; v5.9.26)");
    _aarch64_struct_byval_gate();
    println("");

    _section("aarch64 sub-byte field load (v5.9.27)");
    _aarch64_sub_byte_field_load_gate();
    println("");

    _section("Mach-O arm64 runtime");
