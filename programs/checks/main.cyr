    _lint_gate();

    println("════════════════════════");
    print_num(G_PASS);
    _p(" passed, ");
    print_num(G_FAIL);
    _p(" failed (");
    print_num(G_TOTAL);
    println(" total)");

    return G_FAIL;
}

