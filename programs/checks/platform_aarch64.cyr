    if (ec == 2)  { _p(" — nlmsghdr.nlmsg_type (i16) mismatch"); }
    if (ec == 3)  { _p(" — nlmsghdr.nlmsg_flags (i16, offset>0) mismatch"); }
    if (ec == 4)  { _p(" — nlmsghdr.nlmsg_seq (i32, offset>0) mismatch"); }
    if (ec == 5)  { _p(" — mixed_widths.flag (i8) mismatch"); }
    if (ec == 6)  { _p(" — mixed_widths.pad8 (i8, offset 1) mismatch"); }
    if (ec == 7)  { _p(" — mixed_widths.word_a (i16) mismatch"); }
    if (ec == 8)  { _p(" — mixed_widths.word_b (i16) mismatch"); }
    if (ec == 9)  { _p(" — mixed_widths.long_x (i32) mismatch"); }
    if (ec == 10) { _p(" — mixed_widths.long_y (i32) mismatch"); }
    println("");
    _check(label, 1);
    return 1;
}

fn _aarch64_native_selfhost_gate(): i64 {
    var label = "native cycc self-hosts byte-identical on Pi (pin v5.6.32)";
    if (file_exists(CC_PATH) != 1) {
        _p("  skip: ");
        _p(CC_PATH);
        println(" not present");
        _check(label, 0);
        return 0;
    }
    var target = _ssh_target("SSH_TARGET", "pi");
    if (_ssh_skip_check(target) != 1) {
        _p("  skip: ");
        _p(target);
        println(" unreachable via ssh (no aarch64 runner available)");
        _check(label, 0);
        return 0;
    }

    # Step 1: cross-build aarch64-native cycc via the existing
    # cycc_aarch64 cross-compiler. (We can't reuse build/cycc_aarch64
    # directly — that's an x86 binary that runs the aarch64
    # backend; we need a binary that is itself aarch64 ELF and
    # ALSO emits aarch64 code.)
    var arch_cc_x86 = _root_path("build/cycc_aarch64");
    if (file_exists(arch_cc_x86) != 1) {
        _p("  skip: ");
        _p(arch_cc_x86);
        println(" not built (cross-compiler required)");
        _check(label, 0);
        return 0;
    }
    var native_src = _root_path("src/main_aarch64_native.cyr");
    var cc_native = _tmp_path("audit_cc_native_");
    var rc1 = _self_host_pipe(native_src, arch_cc_x86, cc_native);
    if (rc1 != 0) {
        sys_unlink(cc_native);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": cc5_native cross-build failed (rc=");
        print_num(rc1);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Step 2: ship cc5_native to remote.
    var remote_cc = "/tmp/cyr_selfhost_cc5";
    var scp_rc = _scp_to(target, cc_native, remote_cc);
    sys_unlink(cc_native);
    if (scp_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": scp cc5_native to ");
        _p(target);
        _p(" failed (rc=");
        print_num(scp_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Step 3: tar-pipe src + lib to remote.
    var remote_tree = "/tmp/cyr_selfhost_tree";
    var tar_rc = _tar_pipe_ssh(target, ROOT_PATH, "src lib", remote_tree);
    if (tar_rc != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": tar-pipe src+lib to ");
        _p(target);
        _p(" failed (rc=");
        print_num(tar_rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Step 4: two-step compile on remote, then cmp.
    var cmd_sb = str_builder_new();
    str_builder_add_cstr(cmd_sb, "chmod +x ");
    str_builder_add_cstr(cmd_sb, remote_cc);
    str_builder_add_cstr(cmd_sb, " && cd ");
    str_builder_add_cstr(cmd_sb, remote_tree);
    str_builder_add_cstr(cmd_sb, " && cat src/main_aarch64_native.cyr | ");
    str_builder_add_cstr(cmd_sb, remote_cc);
    str_builder_add_cstr(cmd_sb, " > cc5_b 2>/dev/null && chmod +x cc5_b && ");
    str_builder_add_cstr(cmd_sb, "cat src/main_aarch64_native.cyr | ./cc5_b > cc5_c 2>/dev/null && ");
    str_builder_add_cstr(cmd_sb, "cmp cc5_b cc5_c >/dev/null; rc=$?; ");
    str_builder_add_cstr(cmd_sb, "rm -rf ");
    str_builder_add_cstr(cmd_sb, remote_cc);
    str_builder_add_cstr(cmd_sb, " ");
    str_builder_add_cstr(cmd_sb, remote_tree);
    str_builder_add_cstr(cmd_sb, "; exit $rc");
    var cmd = str_data(str_builder_build(cmd_sb));
    var ec = _ssh_remote_exit(target, cmd);

    if (ec == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        _p(": native aarch64 cycc self-hosts byte-identical on ");
        _p(target);
        println(" (v5.6.32)");
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": native self-host failed on ");
    _p(target);
    _p(" (rc=");
    print_num(ec);
    println(") — compile error or cc5_b != cc5_c");
    _check(label, 1);
    return 1;
}

fn _aarch64_f64_basic_gate(): i64 {
