# ================================================================
# programs/checks/platform_efi.cyr — EFI/UEFI + ELF64-kernel + kmode emit gates
# ================================================================
# v6.0.90: split out of the monolithic programs/check.cyr (10.2K LoC).
# Fn DEFINITIONS only — no includes, no module-level vars, no driver.
# All lib includes + the 18 globals + the dispatcher/driver live in
# programs/checks/main.cyr, which includes this file. See CHANGELOG [6.0.90].

fn _kmode_emit_order_gate(): i64 {
    var src_path = _tmp_path("audit_kmode_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) {
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }
    var src = "kernel;\n\nvar marker_var = 0xDEADBEE0 | 0xF;\n\nasm { 0xF4; 0xF4; 0xF4; 0xF4; }\n";
    sys_write(fd, src, strlen(src));
    sys_close(fd);

    var bin_path = _tmp_path("audit_kmode_bin_");
    var rc = _self_host_pipe(src_path, CC_PATH, bin_path);
    sys_unlink(src_path);
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": kmode compile (rc=");
        print_num(rc);
        println(")");
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }

    var cap = 524288;
    var buf = alloc(cap);
    var n = file_read_all(bin_path, buf, cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }

    # Build the two needle byte sequences via store8 (cyrius string
    # literals can't carry raw 0xF4 / 0x48 bytes ergonomically).
    var asm_needle[1];
    store8(&asm_needle,     0xF4);
    store8(&asm_needle + 1, 0xF4);
    store8(&asm_needle + 2, 0xF4);
    store8(&asm_needle + 3, 0xF4);
    var gvar_needle[1];
    store8(&gvar_needle,     0x48);
    store8(&gvar_needle + 1, 0xB9);

    var asm_off = _find_bytes(buf, n, &asm_needle, 4);
    var gvar_off = _find_bytes(buf, n, &gvar_needle, 2);

    if (asm_off < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": asm marker (f4 f4 f4 f4) not found in kmode binary");
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }
    if (gvar_off < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": gvar-init marker (48 b9) not found in kmode binary");
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }
    if (asm_off >= gvar_off) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": asm marker at byte ");
        print_num(asm_off);
        _p(" not before gvar init at byte ");
        print_num(gvar_off);
        println("");
        println("    This is the v5.7.19 regression — kmode emit order broken;");
        println("    agnos kernel will triple-fault on multiboot entry.");
        _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": kmode emit order — asm (offset ");
    print_num(asm_off);
    _p(") before gvar init (offset ");
    print_num(gvar_off);
    println(")");
    _check("kmode==1: top-level asm emitted before 64-bit gvar inits (v5.7.19; agnos boot)", 0);
    return 0;
}

fn _elf64_kernel_entry_gate(): i64 {
    var label = "kmode==1 + CYRIUS_ELF64_KERNEL=1: FIXUP entry agrees with EMITELF64_KERNEL header (v5.11.46; agnos UEFI boot)";
    var src_path = _root_path("programs/kernel_hello.cyr");
    var bin_path = _tmp_path("audit_elf64k_bin_");
    var rc = _self_host_pipe_elf64k(src_path, CC_PATH, bin_path);
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": elf64-kernel compile (rc=");
        print_num(rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    var cap = 524288;
    var buf = alloc(cap);
    var n = file_read_all(bin_path, buf, cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _check(label, 1);
        return 1;
    }

    # ELF64 magic + class + endian sanity. Identifies a malformed
    # output before we trust e_entry / p_vaddr.
    if (load64(buf) != 0x00010102464C457F) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": elf64-kernel output is not a valid ELF64 LSB binary");
        _check(label, 1);
        return 1;
    }

    var e_entry = load64(buf + 24);
    if (e_entry != 0x1000A8) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ELF64 e_entry = ");
        print_num(e_entry);
        println(" (expected 1048744 = 0x1000A8 = 0x100000 + 120 + 48)");
        _check(label, 1);
        return 1;
    }

    # Locate "Hello from Cyrius!" — kernel_hello.cyr's vga_print() arg.
    var sneedle = "Hello from Cyrius!";
    var s_off = _find_bytes(buf, n, sneedle, 18);
    if (s_off < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": kernel_hello marker string not present in compiled binary");
        _check(label, 1);
        return 1;
    }

    var true_va = 0x100000 + s_off;
    var old_va  = true_va - 0x48;
    var bad_at  = _find_u64_le(buf, n, old_va);
    if (bad_at >= 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": FIXUP regressed — OLD-entry-shifted address ");
        print_num(old_va);
        _p(" (true_va - 72) at file offset ");
        print_num(bad_at);
        _p("; true VA ");
        print_num(true_va);
        println("");
        println("    This is the v5.11.43 → v5.11.45 agnos UEFI boot bug. FIXUP's");
        println("    kmode==1 entry must gate on _TARGET_ELF64_KERNEL — see CHANGELOG [5.11.46].");
        _check(label, 1);
        return 1;
    }

    # Positive sanity — the true-VA pattern must appear at least once
    # (otherwise the test vehicle didn't actually exercise a string
    # fixup and the negative check above is vacuous).
    var good_at = _find_u64_le(buf, n, true_va);
    if (good_at < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": no fixup baked the string's true VA ");
        print_num(true_va);
        println(" (test vehicle didn't exercise a fixup — gate is vacuous)");
        _check(label, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ELF64 kernel entry agreement — e_entry=0x1000A8, fixup baked true VA ");
    print_num(true_va);
    println("");
    _check(label, 0);
    return 0;
}

# v6.3.3 #5: settable kernel load base via `[sections] base` (CYRIUS_KERNEL_BASE
# env). Builds the same kernel with the base overridden to 0x200000 and asserts the
# e_entry AND the PT_LOAD p_vaddr both shift in lockstep — the exact property the
# kernel-load-base-settable issue warned a partial edit would break (fixups vs
# PT_LOAD disagreeing → boots to garbage). Resolves
# issues/2026-06-19-kernel-load-base-settable.md.
fn _sections_base_override_gate(): i64 {
    var label = "v6.3.3 #5: CYRIUS_KERNEL_BASE override shifts kernel e_entry (0x2000A8) + PT_LOAD p_vaddr (0x200000) in lockstep";
    var src_path = _root_path("programs/kernel_hello.cyr");
    var bin_path = _tmp_path("audit_sectbase_bin_");
    var rc = _self_host_pipe_elf64k_base(src_path, CC_PATH, bin_path, "CYRIUS_KERNEL_BASE=0x200000");
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": elf64-kernel base-override compile (rc="); print_num(rc); println(")");
        _check(label, 1);
        return 1;
    }
    var cap = 524288;
    var buf = alloc(cap);
    var n = file_read_all(bin_path, buf, cap);
    sys_unlink(bin_path);
    if (n <= 0) { _check(label, 1); return 1; }
    if (load64(buf) != 0x00010102464C457F) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": base-override output is not a valid ELF64 LSB binary");
        _check(label, 1);
        return 1;
    }
    var e_entry = load64(buf + 24);
    if (e_entry != 0x2000A8) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": e_entry = "); print_num(e_entry);
        println(" (expected 2097320 = 0x2000A8 = 0x200000 + 168 — override did not flow)");
        _check(label, 1);
        return 1;
    }
    var phoff = load64(buf + 32);
    var p_vaddr = load64(buf + phoff + 16);
    if (p_vaddr != 0x200000) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": PT_LOAD p_vaddr = "); print_num(p_vaddr);
        println(" (expected 0x200000 — header disagrees with e_entry: fixups would garble)");
        _check(label, 1);
        return 1;
    }
    _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
    println(": kernel base override 0x200000 — e_entry + p_vaddr agree (settable [sections] base)");
    _check(label, 0);
    return 0;
}

# v6.3.4 #7: lib/tls_native links FREESTANDING into a bare-metal kernel object.
# Compiles tests/fixtures/freestanding_tls/kernel_link.cyr (a `kernel;` program that
# references the TLS 1.3 handshake API + the freestanding hooks so the full native
# stack — record layer / key schedule / AEAD / x25519 / ed25519 — is reachable) and
# asserts it produces a valid freestanding kernel ELF. The native stack is
# libssl-free (no dlopen / no ld.so / no glibc TCB), which is the whole reason
# in-kernel TLS is structurally possible where the libssl wrapper isn't. The
# RUNNING proof (a full handshake over the hooks, zero socket/getrandom syscalls)
# is tests/tcyr/tls_native_freestanding.tcyr in the testsuite walk.
fn _tls_freestanding_link_gate(): i64 {
    var label = "v6.3.4 #7: lib/tls_native links freestanding into a bare-metal kernel object (no libssl / dlopen / ld.so)";
    var src_path = _root_path("tests/fixtures/freestanding_tls/kernel_link.cyr");
    var bin_path = _tmp_path("audit_tlsfree_bin_");
    var rc = _self_host_pipe(src_path, CC_PATH, bin_path);
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": tls_native kernel-link compile (rc="); print_num(rc); println(")");
        _check(label, 1);
        return 1;
    }
    var cap = 4194304;
    var buf = alloc(cap);
    var n = file_read_all(bin_path, buf, cap);
    sys_unlink(bin_path);
    if (n <= 0) { _check(label, 1); return 1; }
    if (load8(buf) != 0x7F || load8(buf + 1) != 0x45 || load8(buf + 2) != 0x4C || load8(buf + 3) != 0x46) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": kernel-link output is not an ELF");
        _check(label, 1);
        return 1;
    }
    # The whole native TLS 1.3 + sigil crypto stack is ~1.2 MB; require >= 600 KB so
    # a regression that drops the crypto/handshake link (DCE'd to a stub) fails loud.
    if (n < 600000) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": kernel ELF only "); print_num(n); println(" bytes — the TLS stack did not link");
        _check(label, 1);
        return 1;
    }
    _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
    _p(": tls_native (record/keysched/AEAD/x25519/ed25519) links into a freestanding kernel ELF (");
    print_num(n); println(" bytes, no libssl/PT_INTERP)");
    _check(label, 0);
    return 0;
}

# v6.3.5 AR-01: the revived monomorphization substrate. Compiles the same fixture
# WITHOUT and WITH CYRIUS_MONOMORPH=1. The flag re-enables the inline body-token
# capture so the (always-intact) emit-time replay path fires for the in-fn calls.
# Two properties: (1) BYTE-CORRECT — both binaries must exit 42 (the inlined value
# replay gives the same result as the normal call); (2) ACTIVE — the two binaries
# must DIFFER, so a no-op flag can't pass silently. Proves the substrate is alive
# without changing default codegen (_MONOMORPH_OK defaults 0). Type substitution
# (generics) builds on this in v6.3.7.
fn _monomorph_substrate_gate(): i64 {
    var label = "v6.3.5 AR-01: CYRIUS_MONOMORPH=1 replays an in-fn inline byte-correct (exit 42 both, binaries differ)";
    var src = _root_path("tests/fixtures/monomorph/inline_proof.cyr");
    var bin_off = _tmp_path("audit_mono_off_");
    var bin_on  = _tmp_path("audit_mono_on_");
    var rc_off = _self_host_pipe(src, CC_PATH, bin_off);
    var rc_on  = _self_host_pipe_env(src, CC_PATH, bin_on, "CYRIUS_MONOMORPH=1");
    if (rc_off != 0 || rc_on != 0) {
        sys_unlink(bin_off); sys_unlink(bin_on);
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": monomorph fixture compile (off rc="); print_num(rc_off);
        _p(", on rc="); print_num(rc_on); println(")");
        _check(label, 1);
        return 1;
    }
    sys_chmod(bin_off, 493);
    sys_chmod(bin_on, 493);
    var fail = 0;
    # (1) byte-correctness: both exit 42.
    var ec_off = _pipe_file_to_bin(bin_off, src);
    var ec_on  = _pipe_file_to_bin(bin_on, src);
    if (ec_off != 42) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-off exit "); print_num(ec_off); println(" (expected 42)");
        fail = fail + 1;
    }
    if (ec_on != 42) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON (inlined) exit "); print_num(ec_on); println(" (expected 42 — inline replay is NOT byte-correct)");
        fail = fail + 1;
    }
    # (2) substrate active: the inlined binary must differ from the normal-call one.
    var cap = 262144;
    var boff = alloc(cap);
    var bon  = alloc(cap);
    var noff = file_read_all(bin_off, boff, cap);
    var non  = file_read_all(bin_on,  bon,  cap);
    sys_unlink(bin_off); sys_unlink(bin_on);
    var same = 0;
    if (noff == non) {
        same = 1;
        var i = 0;
        while (i < noff) {
            if (load8(boff + i) != load8(bon + i)) { same = 0; i = noff; }
            i = i + 1;
        }
    }
    if (same == 1) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        println(": flag-ON binary identical to flag-off — inline capture did not fire (substrate inert)");
        fail = fail + 1;
    }
    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": monomorph token-replay substrate is byte-correct (exit 42 both) and active (binaries differ)");
    }
    _check(label, fail);
    return fail;
}

# v6.3.9 F-fns: i64 generic FUNCTIONS execute. Compiles a generic-fn fixture
# (id/add/dbl with `: T` returns + nested generic calls) under CYRIUS_MONOMORPH=1
# and runs it — must exit 42, proving the base-as-i64 monomorphization is correct.
# Also asserts the fixture is REJECTED with the flag off (the `: T` return type is
# only accepted under the gate), so the feature provably can't touch default codegen.
# Non-i64 instantiation + explicit `foo<i64>(x)` syntax land in v6.3.10 (where the
# instantiate-once machinery is shared with generic structs).
fn _generics_fn_i64_gate(): i64 {
    var label = "v6.3.9 F-fns: i64 generic functions run under CYRIUS_MONOMORPH=1 (exit 42), gated off by default";
    var src = _root_path("tests/fixtures/monomorph/generic_fn_i64.cyr");
    var fail = 0;
    # (1) flag-ON: compiles + the program exits 42 (generic fns execute correctly).
    var bin_on = _tmp_path("audit_genfn_on_");
    var rc_on = _self_host_pipe_env(src, CC_PATH, bin_on, "CYRIUS_MONOMORPH=1");
    if (rc_on != 0) {
        sys_unlink(bin_on);
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON generic-fn compile failed rc="); print_num(rc_on); println("");
        _check(label, 1);
        return 1;
    }
    sys_chmod(bin_on, 493);
    var ec_on = _pipe_file_to_bin(bin_on, src);
    sys_unlink(bin_on);
    if (ec_on != 42) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON generic-fn program exit "); print_num(ec_on); println(" (expected 42)");
        fail = fail + 1;
    }
    # (2) gated: flag-OFF must REJECT the `: T` generic return — proves the feature
    # cannot affect default codegen (the release-gate differential confirms the rest).
    var bin_off = _tmp_path("audit_genfn_off_");
    var rc_off = _self_host_pipe(src, CC_PATH, bin_off);
    sys_unlink(bin_off);
    if (rc_off == 0) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        println(": flag-OFF compiled a generic fn — the feature is NOT gated");
        fail = fail + 1;
    }
    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": i64 generic functions execute under the flag (exit 42) and are gated off by default");
    }
    _check(label, fail);
    return fail;
}

# v6.3.10 F-structs: the full non-i64 generics surface via the instantiate-once
# engine — a non-i64 generic FN instance (add<i32>, params + dedup), a non-i64
# generic STRUCT (Pair<i32>), and a generic struct over a STRUCT type-arg
# (Holder<Point>, proving the specialized field layout). Compiles + runs the fixture
# under CYRIUS_MONOMORPH=1 (must exit 42) and asserts it's REJECTED with the flag
# off (the feature can't touch default codegen).
fn _generics_full_gate(): i64 {
    var label = "v6.3.10 F-structs: non-i64 generic fns + structs + struct-type-args run under CYRIUS_MONOMORPH=1 (exit 42), gated off";
    var src = _root_path("tests/fixtures/monomorph/generics_full.cyr");
    var fail = 0;
    var bin_on = _tmp_path("audit_genfull_on_");
    var rc_on = _self_host_pipe_env(src, CC_PATH, bin_on, "CYRIUS_MONOMORPH=1");
    if (rc_on != 0) {
        sys_unlink(bin_on);
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON non-i64 generics compile failed rc="); print_num(rc_on); println("");
        _check(label, 1);
        return 1;
    }
    sys_chmod(bin_on, 493);
    var ec_on = _pipe_file_to_bin(bin_on, src);
    sys_unlink(bin_on);
    if (ec_on != 42) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON non-i64 generics program exit "); print_num(ec_on); println(" (expected 42)");
        fail = fail + 1;
    }
    var bin_off = _tmp_path("audit_genfull_off_");
    var rc_off = _self_host_pipe(src, CC_PATH, bin_off);
    sys_unlink(bin_off);
    if (rc_off == 0) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        println(": flag-OFF compiled non-i64 generics — the feature is NOT gated");
        fail = fail + 1;
    }
    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": non-i64 generic fns + structs (incl. struct-type-args) execute under the flag (exit 42), gated off");
    }
    _check(label, fail);
    return fail;
}

# v6.3.33 (generics tail): the generic-STRUCT substrate now actually instantiates
# (flag read before pass-1 → GSTP captured). Exercises the cases the pre-.33
# false-positive fixture missed: nested field access into a struct-typed generic
# field (h.v.x), multi-type-param with a distinct STRUCT 2nd param (Two<i64,Point>),
# and a NESTED generic (Box<Pair<i32>>) + multi-param scalar fn + control-flow in a
# generic body. Runs under CYRIUS_MONOMORPH=1 (must exit 42), rejected flag-off.
fn _generics_tail_gate(): i64 {
    var label = "v6.3.33 generics tail: struct instantiation + nested field access + multi-type-param + nested generics run under CYRIUS_MONOMORPH=1 (exit 42), gated off";
    var src = _root_path("tests/fixtures/monomorph/generics_tail.cyr");
    var fail = 0;
    var bin_on = _tmp_path("audit_gentail_on_");
    var rc_on = _self_host_pipe_env(src, CC_PATH, bin_on, "CYRIUS_MONOMORPH=1");
    if (rc_on != 0) {
        sys_unlink(bin_on);
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON generics-tail compile failed rc="); print_num(rc_on); println("");
        _check(label, 1);
        return 1;
    }
    sys_chmod(bin_on, 493);
    var ec_on = _pipe_file_to_bin(bin_on, src);
    sys_unlink(bin_on);
    if (ec_on != 42) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON generics-tail program exit "); print_num(ec_on); println(" (expected 42)");
        fail = fail + 1;
    }
    var bin_off = _tmp_path("audit_gentail_off_");
    var rc_off = _self_host_pipe(src, CC_PATH, bin_off);
    sys_unlink(bin_off);
    if (rc_off == 0) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        println(": flag-OFF compiled generics-tail — the feature is NOT gated");
        fail = fail + 1;
    }
    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": generic structs instantiate (nested field access + multi-param + nested generics) under the flag, gated off");
    }
    _check(label, fail);
    return fail;
}

fn _async_await_gate(): i64 {
    var label = "v6.3.11 G: async fn / await → first-class Futures over the epoll runtime, run under CYRIUS_ASYNC=1 (exit 42), gated off";
    var src = _root_path("tests/fixtures/async/async_await.cyr");
    var fail = 0;
    var bin_on = _tmp_path("audit_async_on_");
    var rc_on = _self_host_pipe_env(src, CC_PATH, bin_on, "CYRIUS_ASYNC=1");
    if (rc_on != 0) {
        sys_unlink(bin_on);
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON async/await compile failed rc="); print_num(rc_on); println("");
        _check(label, 1);
        return 1;
    }
    sys_chmod(bin_on, 493);
    var ec_on = _pipe_file_to_bin(bin_on, src);
    sys_unlink(bin_on);
    if (ec_on != 42) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": flag-ON async/await program exit "); print_num(ec_on); println(" (expected 42)");
        fail = fail + 1;
    }
    var bin_off = _tmp_path("audit_async_off_");
    var rc_off = _self_host_pipe(src, CC_PATH, bin_off);
    sys_unlink(bin_off);
    if (rc_off == 0) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        println(": flag-OFF compiled async/await — the feature is NOT gated");
        fail = fail + 1;
    }
    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": async fn / await (Futures: 0/1/3-param, await-on-call, stored, spawn+run) execute under the flag (exit 42), gated off");
    }
    _check(label, fail);
    return fail;
}

fn _wx_segments_gate(): i64 {
    var label = "v6.3.12 W^X: userland ELF defaults to separate text (R E) + data (RW) PT_LOADs; CYRIUS_WX=0 opts out to single RWX";
    var src = _root_path("tests/fixtures/wx/wx_probe.cyr");
    var fail = 0;
    var cap = 65536;
    var buf = alloc(cap);
    # Default build → W^X: e_phnum==2, PH0 R+E (5), PH1 R+W (6); the program still runs.
    var bin_on = _tmp_path("audit_wx_on_");
    var rc_on = _self_host_pipe(src, CC_PATH, bin_on);
    if (rc_on != 0) {
        sys_unlink(bin_on);
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": default W^X compile failed rc="); print_num(rc_on); println("");
        _check(label, 1);
        return 1;
    }
    file_read_all(bin_on, buf, cap);
    var phnum = load16(buf + 56);
    var f0 = load32(buf + 68);        # PH[0].p_flags (p_flags @ e_phoff(64) + 4)
    var f1 = load32(buf + 124);       # PH[1].p_flags (64 + 56 + 4)
    if (phnum != 2) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": default e_phnum="); print_num(phnum); println(" (expected 2 PT_LOADs)");
        fail = fail + 1;
    } else {
        if (f0 != 5) {
            _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
            _p(": text p_flags="); print_num(f0); println(" (expected 5 = R E, not writable)");
            fail = fail + 1;
        }
        if (f1 != 6) {
            _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
            _p(": data p_flags="); print_num(f1); println(" (expected 6 = R W, not executable)");
            fail = fail + 1;
        }
    }
    sys_chmod(bin_on, 493);
    var ec_on = _pipe_file_to_bin(bin_on, src);
    sys_unlink(bin_on);
    if (ec_on != 42) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": W^X program exit "); print_num(ec_on); println(" (expected 42)");
        fail = fail + 1;
    }
    # CYRIUS_WX=0 → historical single RWX PT_LOAD (opt-out).
    var bin_off = _tmp_path("audit_wx_off_");
    var rc_off = _self_host_pipe_env(src, CC_PATH, bin_off, "CYRIUS_WX=0");
    if (rc_off != 0) {
        sys_unlink(bin_off);
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        println(": CYRIUS_WX=0 opt-out compile failed");
        fail = fail + 1;
    } else {
        file_read_all(bin_off, buf, cap);
        sys_unlink(bin_off);
        var phnum_off = load16(buf + 56);
        var f0_off = load32(buf + 68);
        if (phnum_off != 1) {
            _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
            _p(": CYRIUS_WX=0 e_phnum="); print_num(phnum_off); println(" (expected 1)");
            fail = fail + 1;
        } else {
            if (f0_off != 7) {
                _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
                _p(": CYRIUS_WX=0 p_flags="); print_num(f0_off); println(" (expected 7 = RWX)");
                fail = fail + 1;
            }
        }
    }
    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": userland ELF defaults to text R+E / data R+W PT_LOADs (W^X), program runs; CYRIUS_WX=0 → single RWX");
    }
    _check(label, fail);
    return fail;
}

fn _array_local_threadsafe_gate(): i64 {
    var label = "v6.3.15: `var arr[N]` locals are PER-THREAD by DEFAULT (8-thread concurrency clean) — str_builder root-cause fix, now default-on; CYRIUS_STACK_ARRAYS=0 opts back to shared-global .bss arrays";
    var src = _root_path("tests/fixtures/concurrency/array_local_threadsafe.cyr");
    var fail = 0;
    # DEFAULT (no env): per-thread stack arrays → thread-safe → exit 0.
    var bin = _tmp_path("audit_arrtls_");
    var rc = _self_host_pipe(src, CC_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": default array-local concurrency test compile failed rc="); print_num(rc); println("");
        _check(label, 1);
        return 1;
    }
    sys_chmod(bin, 493);
    var ec = _pipe_file_to_bin(bin, src);
    sys_unlink(bin);
    if (ec != 0) {
        _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
        _p(": default 8-thread test exit "); print_num(ec); println(" (expected 0 = per-thread / thread-safe)");
        fail = fail + 1;
    }
    # Opt-out (CYRIUS_STACK_ARRAYS=0): shared-global arrays → cross-thread splice → exit 1.
    # Proves the test detects the bug AND documents the escape hatch's legacy behavior.
    var binD = _tmp_path("audit_arrtlsD_");
    var rcD = _self_host_pipe_env(src, CC_PATH, binD, "CYRIUS_STACK_ARRAYS=0");
    if (rcD == 0) {
        sys_chmod(binD, 493);
        # The shared-global corruption is a RACE: a single 8-thread run detects
        # it only ~90% of the time (the threads occasionally serialize under
        # scheduling and never interleave). Retry up to 5x and case-FAIL only if
        # the race NEVER manifests — a genuine "the test can't detect the bug",
        # not a one-shot scheduling miss. Fixes the ~10%-per-run flaky
        # negative-control that false-RED'd the release gate (v6.3.13 note; v6.3.26).
        var detected = 0;
        var tries = 0;
        while (tries < 5) {
            var ecD = _pipe_file_to_bin(binD, src);
            if (ecD != 0) { detected = 1; tries = 5; }
            tries = tries + 1;
        }
        if (detected == 0) {
            _p("    "); _p(ANSI_RED); _p("case-FAIL"); _p(ANSI_RESET);
            println(": CYRIUS_STACK_ARRAYS=0 (shared-global arrays) did NOT corrupt in 5 tries — the test isn't detecting the bug");
            fail = fail + 1;
        }
    }
    sys_unlink(binD);
    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": default array-locals per-thread (8-thread concurrency clean); CYRIUS_STACK_ARRAYS=0 shared-global still corrupts");
    }
    _check(label, fail);
    return fail;
}

fn _efi_emit_gate(): i64 {
    var label = "EFI Application PE emit produces correct PE32+ headers (v5.11.48; gnoboot MVP unblocker)";
    var cap = 262144;
    var buf = alloc(cap);
    var n = _efi_compile_to_buf(_root_path("programs/efi_probe.cyr"), buf, cap, "efi_probe");
    if (n <= 0) { _check(label, 1); return 1; }

    # DOS header: MZ at offset 0
    if (load8(buf) != 0x4D || load8(buf + 1) != 0x5A) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": efi_probe output missing MZ DOS header");
        _check(label, 1);
        return 1;
    }

    # PE signature offset at byte 60; signature = "PE\0\0"
    var pe_off = _read_u32_le(buf, 60);
    if (load8(buf + pe_off) != 0x50 || load8(buf + pe_off + 1) != 0x45) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": efi_probe PE signature not found at e_lfanew");
        _check(label, 1);
        return 1;
    }

    var opt_off = pe_off + 4 + 20;

    # Optional Header Magic must be PE32+ (0x020B)
    var magic = _read_u16_le(buf, opt_off);
    if (magic != 0x020B) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": Optional Header Magic ");
        print_num(magic);
        println(" != 0x020B (PE32+)");
        _check(label, 1);
        return 1;
    }

    # Subsystem at OptionalHeader + 68
    var subsys = _read_u16_le(buf, opt_off + 68);
    if (subsys != 10) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": Subsystem ");
        print_num(subsys);
        println(" != 10 (IMAGE_SUBSYSTEM_EFI_APPLICATION)");
        _check(label, 1);
        return 1;
    }

    # DllCharacteristics at OptionalHeader + 70; require NX_COMPAT (0x0100)
    var dllc = _read_u16_le(buf, opt_off + 70);
    if ((dllc & 0x0100) == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": DllCharacteristics ");
        print_num(dllc);
        println(" missing NX_COMPAT (0x0100) — UEFI 2.0+ requires it");
        _check(label, 1);
        return 1;
    }

    # Data directories at OptionalHeader + 112 (PE32+). Each entry = 8 bytes.
    var dd_base = opt_off + 112;

    # [1] Import directory — must be zeroed (no kernel32 in UEFI)
    var imp_rva  = _read_u32_le(buf, dd_base + 8);
    var imp_size = _read_u32_le(buf, dd_base + 12);
    if (imp_rva != 0 || imp_size != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": Data Dir [1] Import not zeroed (RVA=");
        print_num(imp_rva);
        _p(", Size=");
        print_num(imp_size);
        println(") — EFI mode should suppress kernel32 imports");
        _check(label, 1);
        return 1;
    }

    # [12] IAT — must be zeroed
    var iat_rva  = _read_u32_le(buf, dd_base + 96);
    var iat_size = _read_u32_le(buf, dd_base + 100);
    if (iat_rva != 0 || iat_size != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": Data Dir [12] IAT not zeroed (RVA=");
        print_num(iat_rva);
        _p(", Size=");
        print_num(iat_size);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Locate .text section to verify the EEXIT EFI variant (ret = 0xC3)
    # actually emitted. Section table starts at OptionalHeader + 240.
    var st_off = opt_off + 240;
    var found_text = 0;
    var ret_found = 0;
    var si = 0;
    while (si < 6) {
        var so = st_off + si * 40;
        # Name compare: ".text\0\0\0"
        if (load8(buf + so) == 0x2E
            && load8(buf + so + 1) == 0x74
            && load8(buf + so + 2) == 0x65
            && load8(buf + so + 3) == 0x78
            && load8(buf + so + 4) == 0x74
            && load8(buf + so + 5) == 0x00) {
            found_text = 1;
            var foff = _read_u32_le(buf, so + 20);
            var vsz  = _read_u32_le(buf, so + 8);
            # Scan .text for 0xC3 (ret) — EEXIT EFI variant
            var ti = 0;
            while (ti < vsz) {
                if (load8(buf + foff + ti) == 0xC3) {
                    ret_found = 1;
                    ti = vsz;
                } else {
                    ti = ti + 1;
                }
            }
            si = 6;
        } else {
            si = si + 1;
        }
    }
    if (found_text == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": .text section not found in efi_probe output");
        _check(label, 1);
        return 1;
    }
    if (ret_found == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": 0xC3 (ret) not found in .text — EEXIT EFI variant not emitting");
        _check(label, 1);
        return 1;
    }

    # v6.0.46 regression guard: fncallN under EFI must NOT emit `ud2 ud2`.
    # The 2026-05-19 UEFI bug dropped the CYRIUS_TARGET_WIN predefine under
    # CYRIUS_TARGET_EFI=1 → fncallN went undefined → every call site got the
    # undefined-fn stub `ud2 ud2 nop` (0F 0B 0F 0B 90, same 4 bytes as
    # `call rel32`) → #UD at every UEFI service call (gnoboot panicked OVMF).
    # Rotted + fixed untested; this locks it in. See efi_fncall_probe.cyr.
    var fbuf = alloc(cap);
    var fn_n = _efi_compile_to_buf(_root_path("programs/efi_fncall_probe.cyr"), fbuf, cap, "efi_fncall_probe");
    if (fn_n <= 0) { _check(label, 1); return 1; }
    var ud2_found = 0;
    var ui = 0;
    while (ui < fn_n - 3) {
        if (load8(fbuf + ui) == 0x0F && load8(fbuf + ui + 1) == 0x0B
            && load8(fbuf + ui + 2) == 0x0F && load8(fbuf + ui + 3) == 0x0B) {
            ud2_found = 1;
            ui = fn_n;
        } else {
            ui = ui + 1;
        }
    }
    if (ud2_found == 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": efi_fncall_probe emits `ud2 ud2` — fncallN undefined under EFI (the 2026-05-19 UEFI regression)");
        _check(label, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": EFI Application emit — Subsystem=0xA, DllChar NX_COMPAT, Data Dirs [1]/[12] zeroed, .text has ret; fncallN emit no ud2 (2026-05-19 UEFI guard)");
    println("");
    _check(label, 0);
    return 0;
}

fn _efi_ovmf_smoke_gate(): i64 {
    var label = "EFI Application boots under qemu+OVMF + writes hello via ConOut (v5.11.49; gnoboot arc KO)";

    # Probe for required tooling. Any missing → SKIP gracefully (don't
    # fail check.sh; the gate is opt-in via presence of the test
    # environment, same pattern as the macho cross-build gate which
    # skips when codesign is absent).
    if (file_exists("/usr/bin/qemu-system-x86_64") != 1) {
        _p("  "); _p(ANSI_RESET); _p("SKIP"); _p(ANSI_RESET);
        println(": qemu-system-x86_64 not installed — runtime smoke skipped");
        _check(label, 0);
        return 0;
    }
    if (file_exists("/usr/bin/parted") != 1) {
        _p("  SKIP: parted not installed — runtime smoke skipped\n");
        _check(label, 0);
        return 0;
    }
    if (file_exists("/usr/bin/mformat") != 1) {
        _p("  SKIP: mtools (mformat) not installed — runtime smoke skipped\n");
        _check(label, 0);
        return 0;
    }
    if (file_exists("/usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd") != 1) {
        _p("  SKIP: OVMF_CODE.4m.fd not at /usr/share/edk2-ovmf/x64/ — runtime smoke skipped\n");
        _check(label, 0);
        return 0;
    }
    if (file_exists("/usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd") != 1) {
        _p("  SKIP: OVMF_VARS.4m.fd not at /usr/share/edk2-ovmf/x64/ — runtime smoke skipped\n");
        _check(label, 0);
        return 0;
    }

    # Compile programs/efi_probe.cyr under CYRIUS_TARGET_EFI=1.
    var src_path = _root_path("programs/efi_probe.cyr");
    var efi_bin = _tmp_path("efi_smoke_probe_");
    var rc = _self_host_pipe_efi(src_path, CC_PATH, efi_bin);
    if (rc != 0) {
        sys_unlink(efi_bin);
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": efi_probe compile failed (rc=");
        print_num(rc);
        println(")");
        _check(label, 1);
        return 1;
    }

    # Runtime smoke pipeline. The orchestration is a /bin/sh -c
    # one-liner — test glue, not a separate shell-script deliverable
    # (cyrius owns the gate; sh is just stdlib-tool composition for
    # parted/mtools/qemu invocation, same shape as how cross-host
    # smoke uses ssh). The .efi path comes through as $1.
    var script = "set -e; D=$(mktemp -d -t efi-smoke.XXXXXX); trap 'rm -rf \"$D\"' EXIT; cd \"$D\"; dd if=/dev/zero of=disk.img bs=1M count=64 status=none; parted -s disk.img mklabel gpt mkpart ESP fat32 1MiB 100% set 1 esp on >/dev/null 2>&1; mformat -i disk.img@@1048576 -F; mmd -i disk.img@@1048576 ::EFI; mmd -i disk.img@@1048576 ::EFI/BOOT; mcopy -i disk.img@@1048576 \"$1\" ::EFI/BOOT/BOOTX64.EFI; cp /usr/share/edk2-ovmf/x64/OVMF_VARS.4m.fd vars.fd; chmod +w vars.fd; timeout 12 qemu-system-x86_64 -machine q35 -m 256M -drive if=pflash,format=raw,readonly=on,file=/usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd -drive if=pflash,format=raw,file=vars.fd -drive file=disk.img,format=raw -serial stdio -display none -no-reboot 2>/dev/null | grep -q 'hello, uefi'";

    var args = vec_new();
    vec_push(args, str_from("/bin/sh"));
    vec_push(args, str_from("-c"));
    vec_push(args, str_from(script));
    vec_push(args, str_from("--"));
    vec_push(args, str_from(efi_bin));
    var rc2 = exec_vec_str(args);
    sys_unlink(efi_bin);

    if (rc2 == 0) {
        _p("  ");
        _p(ANSI_GREEN);
        _p("PASS");
        _p(ANSI_RESET);
        println(": OVMF firmware loaded BOOTX64.EFI; \"hello, uefi\" captured on serial");
        _check(label, 0);
        return 0;
    }

    _p("  ");
    _p(ANSI_RED);
    _p("FAIL");
    _p(ANSI_RESET);
    _p(": OVMF runtime smoke did not produce \"hello, uefi\" (sh rc=");
    print_num(rc2);
    println(")");
    _check(label, 1);
    return 1;
}

fn _efi_trampoline_rex_gate(): i64 {
    var label = "efi_main trampoline REX prefix encoding (v5.11.53; save=49, restore=4C)";

    if (file_exists("/usr/bin/qemu-system-x86_64") != 1) {
        _p("  SKIP: qemu tooling not present (gate is paired with OVMF smoke ecosystem)\n");
        _check(label, 0);
        return 0;
    }

    # Compile minimal efi_main source via CYRIUS_TARGET_EFI=1 pipe.
    var src_path = _tmp_path("audit_efi_tramp_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { _check(label, 1); return 1; }
    var src = "kernel;\n\nfn efi_main(handle, st): i64 {\n    return 0;\n}\n";
    sys_write(fd, src, strlen(src));
    sys_close(fd);

    var cap = 262144;
    var buf = alloc(cap);
    var n = _efi_compile_to_buf(src_path, buf, cap, "efi_main minimal source");
    sys_unlink(src_path);
    if (n <= 0) { _check(label, 1); return 1; }

    # Build needles via store8 (string literals can't carry 0x49 / 0x4C
    # reliably and the bytes here are explicitly chosen for the test).
    var save_good[1];
    store8(&save_good + 0, 0x49); store8(&save_good + 1, 0x89); store8(&save_good + 2, 0xCE);
    store8(&save_good + 3, 0x49); store8(&save_good + 4, 0x89); store8(&save_good + 5, 0xD7);

    var save_bad[1];
    store8(&save_bad + 0, 0x4C); store8(&save_bad + 1, 0x89); store8(&save_bad + 2, 0xCE);
    store8(&save_bad + 3, 0x4C); store8(&save_bad + 4, 0x89); store8(&save_bad + 5, 0xD7);

    var restore_good[1];
    store8(&restore_good + 0, 0x4C); store8(&restore_good + 1, 0x89); store8(&restore_good + 2, 0xF1);
    store8(&restore_good + 3, 0x4C); store8(&restore_good + 4, 0x89); store8(&restore_good + 5, 0xFA);

    var save_at    = _find_bytes(buf, n, &save_good, 6);
    var save_bad_at = _find_bytes(buf, n, &save_bad, 6);
    var restore_at = _find_bytes(buf, n, &restore_good, 6);

    var fail = 0;
    if (save_at < 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": entry save bytes (49 89 CE 49 89 D7 = mov r14,rcx / mov r15,rdx) NOT found in output");
        fail = fail + 1;
    }
    if (save_bad_at >= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": v5.11.52 wrong-REX bytes (4C 89 CE 4C 89 D7 = mov rsi,r9 / mov rdi,r10) regressed at file offset ");
        print_num(save_bad_at);
        println("");
        fail = fail + 1;
    }
    if (restore_at < 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": restore bytes (4C 89 F1 4C 89 FA = mov rcx,r14 / mov rdx,r15) NOT found in output");
        fail = fail + 1;
    }

    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": efi_main trampoline encoding — save=49/89/CE+49/89/D7; restore=4C/89/F1+4C/89/FA");
    }
    _check(label, fail);
    return fail;
}

fn _efi_stdlib_fallback_gate(): i64 {
    var label = "stdlib fallback resolves lib/fnptr.cyr without vendored ./lib (v6.0.1; rename-skip regression)";

    var src_path = "/tmp/audit_efi_fallback_src.cyr";
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { _check(label, 1); return 1; }
    var src = "include \"lib/fnptr.cyr\"\nfn main(): i64 { var fp = 0; var r = fncall1(fp, 0); return r; }\n";
    sys_write(fd, src, strlen(src));
    sys_close(fd);

    var bin_path = "/tmp/audit_efi_fallback_bin";

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_unlink(src_path); _check(label, 1); return 1; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var out_fd = sys_open(bin_path, 577, 420);
    if (out_fd < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_unlink(src_path);
        _check(label, 1); return 1;
    }

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_close(out_fd);
        sys_unlink(src_path); _check(label, 1); return 1;
    }
    # Build augmented envp: parent's ENVP_ARR (carries HOME, needed
    # by cycc's `_init_cyrius_lib` to build the version-pinned
    # fallback path) + CYRIUS_TARGET_EFI=1 + NUL. _self_host_pipe_efi
    # passes only "CYRIUS_TARGET_EFI=1" but that suffices for the
    # inline-asm efi_probe.cyr — this gate needs HOME because the
    # whole point is to exercise the stdlib-include fallback.
    var aug_envp = alloc((ENVP_COUNT + 2) * 8);
    var ei = 0;
    while (ei < ENVP_COUNT) {
        store64(aug_envp + ei * 8, load64(ENVP_ARR + ei * 8));
        ei = ei + 1;
    }
    store64(aug_envp + ENVP_COUNT * 8, "CYRIUS_TARGET_EFI=1");
    store64(aug_envp + (ENVP_COUNT + 1) * 8, 0);

    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0); sys_close(read_fd);
        sys_dup2(out_fd, 1); sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var cd_rc = syscall(SYS_CHDIR, "/tmp");
        if (cd_rc < 0) { sys_exit(126); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     CC_PATH);
        store64(&argv + 8, 0);
        sys_execve(CC_PATH, &argv, aug_envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);

    var src_cap = 4096;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; } else { written = written + w; }
    }
    sys_close(write_fd);

    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    sys_unlink(src_path);

    var status = load32(&status_buf);
    if (WIFEXITED(status) == 0 || WEXITSTATUS(status) != 0) {
        sys_unlink(bin_path);
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": cycc exited non-zero (status="); print_num(status);
        println(") with CYRIUS_TARGET_EFI=1 + include \"lib/fnptr.cyr\"");
        _check(label, 1);
        return 1;
    }

    var cap = 262144;
    var buf = alloc(cap);
    var n = file_read_all(bin_path, buf, cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        println(": compiled but output unreadable");
        _check(label, 1);
        return 1;
    }

    var ud2_needle[1];
    store8(&ud2_needle + 0, 0x0F);
    store8(&ud2_needle + 1, 0x0B);
    store8(&ud2_needle + 2, 0x0F);
    store8(&ud2_needle + 3, 0x0B);
    store8(&ud2_needle + 4, 0x90);
    var ud2_at = _find_bytes(buf, n, &ud2_needle, 5);

    var fail = 0;
    if (ud2_at >= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": found ud2/ud2/nop sentinel (0F 0B 0F 0B 90) at offset ");
        print_num(ud2_at);
        println(" — lib/fnptr.cyr did not resolve via version-pinned fallback");
        println("    (rename-skip regression — check src/frontend/lex.cyr `vp =` constant)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": fncall1 resolved via $HOME/.cyrius/versions/<v>/lib/fnptr.cyr (no ud2 sentinel)");
    }
    _check(label, fail);
    return fail;
}
