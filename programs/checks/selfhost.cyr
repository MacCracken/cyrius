fn _self_host_pipe_env(src_path, compiler_path, out_path, env_kv): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }
    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);
    # Augmented envp: parent's ENVP_ARR + env_kv + null.
    var aug_envp = alloc((ENVP_COUNT + 2) * 8);
    var ei = 0;
    while (ei < ENVP_COUNT) {
        store64(aug_envp + ei * 8, load64(ENVP_ARR + ei * 8));
        ei = ei + 1;
    }
    store64(aug_envp + ENVP_COUNT * 8, env_kv);
    store64(aug_envp + (ENVP_COUNT + 1) * 8, 0);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        sys_execve(compiler_path, &argv, aug_envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

# v6.3.45: like _self_host_pipe_env but injects TWO env vars — for a fixture that
# needs two feature gates at once (e.g. async_closure_generic.cyr = CYRIUS_ASYNC=1
# + CYRIUS_MONOMORPH=1). Returns the child's exit status, or a negative setup error.
fn _self_host_pipe_env2(src_path, compiler_path, out_path, env_kv1, env_kv2): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }
    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);
    # Augmented envp: parent's ENVP_ARR + env_kv1 + env_kv2 + null.
    var aug_envp = alloc((ENVP_COUNT + 3) * 8);
    var ei = 0;
    while (ei < ENVP_COUNT) {
        store64(aug_envp + ei * 8, load64(ENVP_ARR + ei * 8));
        ei = ei + 1;
    }
    store64(aug_envp + ENVP_COUNT * 8, env_kv1);
    store64(aug_envp + (ENVP_COUNT + 1) * 8, env_kv2);
    store64(aug_envp + (ENVP_COUNT + 2) * 8, 0);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        sys_execve(compiler_path, &argv, aug_envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf2[1];
    sys_waitpid(pid, &status_buf2, 0);
    return load32(&status_buf2);
}

fn _self_host_gate(): i64 {
    _section("Self-Hosting");
    var src = _root_path("src/main.cyr");
    var cc_a = _tmp_path("audit_cc_a_");
    var cc_b = _tmp_path("audit_cc_b_");
    var rc1 = _self_host_pipe(src, CC_PATH, cc_a);
    if (rc1 != 0) {
        _check("cycc==cycc byte-identical", 1);
        println("");
        return 1;
    }
    sys_chmod(cc_a, 493);
    var rc2 = _self_host_pipe(src, cc_a, cc_b);
    if (rc2 != 0) {
        _check("cycc==cycc byte-identical", 1);
        sys_unlink(cc_a);
        println("");
        return 1;
    }
    var ok = _files_identical(cc_a, cc_b);
    if (ok == 1) { _check("cycc==cycc byte-identical", 0); }
    else         { _check("cycc==cycc byte-identical", 1); }
    _p("    binary: ");
    print_num(_file_size(cc_a));
    println(" bytes");
    sys_unlink(cc_a);
    sys_unlink(cc_b);
    println("");
    if (ok == 1) { return 0; }
    return 1;
}

fn _heapmap_gate(): i64 {
    _section("Heap Map");
    _gate("no heap overlaps", "tests/heapmap.sh");
    println("");
    return 0;
}

fn _tcyr_parse_failed(buf, n): i64 {
    var needle = " failed";
    var nlen = strlen(needle);
    var i = 0;
    while (i + nlen <= n) {
        if (_buf_eq(buf + i, needle, nlen) == 1) {
            var end = i;
            var start = end;
            while (start > 0) {
                var c = load8(buf + start - 1);
                if (c < 48) { return _aw_parse_leading_int(buf + start, end - start); }
                if (c > 57) { return _aw_parse_leading_int(buf + start, end - start); }
                start = start - 1;
            }
            return _aw_parse_leading_int(buf + start, end - start);
        }
        i = i + 1;
    }
    return 0;
}

fn _tcyr_compile_and_run(src_path): i64 {
    var bin_path = _tmp_path("audit_t_");
    var rc1 = _self_host_pipe(src_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        sys_unlink(bin_path);
        return 0 - 1;
    }
    sys_chmod(bin_path, 493);

    # v5.9.6 — switched from lib/process.cyr's pipe-based
    # exec_capture to the file-backed _exec_capture_clean.
    # exec_capture deadlocks when the test fixture forks a setuid
    # helper that's reparented to init as an orphan keeping the
    # pipe write-end open (shadow_pam.tcyr → unix_chkpwd; same
    # incident fixed for `_tcyr_relay_gate` in v5.9.2). Pre-v5.9.6
    # the gate reported "0 files" — the dir_list +
    # path_has_ext bugs masked this hang because the loop never
    # iterated; now that those are fixed, the underlying capture
    # bug surfaces here too.
    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_clean(bin_path, out_buf, out_cap);
    sys_unlink(bin_path);

    # CO-02: a tcyr that crashed (signal) or exited nonzero WITHOUT printing
    # " failed" was recorded as PASS (parse_failed==0). Treat a nonzero exit as
    # a failure — matches ci.yml:196's `$ec`-AND-count gate.
    var failed = _tcyr_parse_failed(out_buf, out_n);
    if (failed == 0 && _last_exec_ec != 0) { return 1; }
    return failed;
}

fn _testsuite_gate(): i64 {
    _section("Test Suite");
    var dir = _root_path("tests/tcyr");
    var dir_str = str_from(dir);
    var entries = dir_list(dir_str);
    var fail_count = 0;
    var total = 0;
    var i = 0;
    while (i < vec_len(entries)) {
        var name = vec_get(entries, i);
        if (path_has_ext(name, str_from(".tcyr")) == 1) {
            var full = path_join(dir_str, name);
            var basename = path_basename(full);
            var bn_data = str_data(basename);
            var bn_len = str_len(basename);
            var label_len = bn_len - 5;   # remove ".tcyr"
            _p("  ");
            print(bn_data, label_len);
            # Pad to 22 columns.
            var pad = 22 - label_len;
            while (pad > 0) { _p(" "); pad = pad - 1; }
            var failed = _tcyr_compile_and_run(str_data(full));
            if (failed < 0) {
                println("FAIL (compile)");
                fail_count = fail_count + 1;
            } else { if (failed > 0) {
                    _p("FAIL (");
                    print_num(failed);
                    println(" failed)");
                    fail_count = fail_count + 1;
                } else {
                    println("PASS");
                } }
            total = total + 1;
        }
        i = i + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "test suite (");
    str_builder_add_int(sb, total);
    str_builder_add_cstr(sb, " files)");
    var label = str_builder_build(sb);
    _check(str_data(label), fail_count);
    println("");
    return fail_count;
}
