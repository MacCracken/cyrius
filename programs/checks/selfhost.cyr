fn _self_host_pipe_env(src_path, compiler_path, out_path, env_kv): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }
    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);
    # Augmented envp: parent's ENVP_ARR + env_kv + null.
    var aug_envp = alloc((ENVP_COUNT + 2) * 8);
    var ei = 0;
    while (ei < ENVP_COUNT) {
        store64(aug_envp + ei * 8, load64(ENVP_ARR + ei * 8));
        ei = ei + 1;
    }
    store64(aug_envp + ENVP_COUNT * 8, env_kv);
    store64(aug_envp + (ENVP_COUNT + 1) * 8, 0);

    var _rg_ppid_pid = sys_getpid();

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {

        _regression_child_guard(_rg_ppid_pid);
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        sys_execve(compiler_path, &argv, aug_envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    regression_pipe_write_all(write_fd, src_buf, src_n, _regression_timeout_ms());
    sys_close(write_fd);
    var status_buf[1];
    _regression_wait_deadline(pid, &status_buf, _regression_timeout_ms());
    return load32(&status_buf);
}

# v6.3.45: like _self_host_pipe_env but injects TWO env vars — for a fixture that
# needs two feature gates at once (e.g. async_closure_generic.cyr = CYRIUS_ASYNC=1
# + CYRIUS_MONOMORPH=1). Returns the child's exit status, or a negative setup error.
fn _self_host_pipe_env2(src_path, compiler_path, out_path, env_kv1, env_kv2): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }
    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);
    # Augmented envp: parent's ENVP_ARR + env_kv1 + env_kv2 + null.
    var aug_envp = alloc((ENVP_COUNT + 3) * 8);
    var ei = 0;
    while (ei < ENVP_COUNT) {
        store64(aug_envp + ei * 8, load64(ENVP_ARR + ei * 8));
        ei = ei + 1;
    }
    store64(aug_envp + ENVP_COUNT * 8, env_kv1);
    store64(aug_envp + (ENVP_COUNT + 1) * 8, env_kv2);
    store64(aug_envp + (ENVP_COUNT + 2) * 8, 0);

    var _rg_ppid_pid = sys_getpid();

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd); sys_close(write_fd); sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {

        _regression_child_guard(_rg_ppid_pid);
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        sys_execve(compiler_path, &argv, aug_envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    regression_pipe_write_all(write_fd, src_buf, src_n, _regression_timeout_ms());
    sys_close(write_fd);
    var status_buf2[1];
    _regression_wait_deadline(pid, &status_buf2, _regression_timeout_ms());
    return load32(&status_buf2);
}

fn _self_host_gate(): i64 {
    _section("Self-Hosting");
    # v6.6.6 — ⚠ `src/main.cyr` IS CORRECT HERE, and asking `_self_host_src()` would be
    # WRONG. This gate compiles with `CC_PATH`, which `_setup_paths` pins to
    # `<root>/build/cycc` — the TRACKED x86-64 Linux compiler — so `src/main.cyr` is that
    # compiler's own fork and the pair is matched by definition. `cyrius self` / `cyrius
    # soak` ask instead because they run THIS HOST's installed compiler, which on ARM or
    # macOS is a different binary built from a different fork; naming main.cyr there was
    # the bite-23a defect. Keep the pairing derivable: if this gate ever compiles with a
    # HOST compiler it must ask, and
    # tests/gates/toolchain/self_host_src_per_target.sh axis 6 — which DISCOVERS every
    # self-host loop in the tree rather than naming two verbs — is what enforces the
    # choice. CHANGELOG [6.6.6].
    var src = _root_path("src/main.cyr");
    var cc_a = _tmp_path("audit_cc_a_");
    var cc_b = _tmp_path("audit_cc_b_");
    var rc1 = _self_host_pipe(src, CC_PATH, cc_a);
    if (rc1 != 0) {
        _check("cycc==cycc byte-identical", 1);
        println("");
        return 1;
    }
    sys_chmod(cc_a, 493);
    var rc2 = _self_host_pipe(src, cc_a, cc_b);
    if (rc2 != 0) {
        _check("cycc==cycc byte-identical", 1);
        sys_unlink(cc_a);
        println("");
        return 1;
    }
    var ok = _files_identical(cc_a, cc_b);
    if (ok == 1) { _check("cycc==cycc byte-identical", 0); }
    else         { _check("cycc==cycc byte-identical", 1); }
    _p("    binary: ");
    print_num(_file_size(cc_a));
    println(" bytes");
    sys_unlink(cc_a);
    sys_unlink(cc_b);
    println("");
    if (ok == 1) { return 0; }
    return 1;
}

fn _heapmap_gate(): i64 {
    _section("Heap Map");
    _gate("no heap overlaps", "tests/gates/memory/heapmap.sh");
    println("");
    return 0;
}

# ⛔ 6.6.17 — THE .tcyr CHILDREN GET A THROWAWAY $HOME THAT HOLDS THE fdlopen HELPER.
# They used to run with EMPTY_ENVP alone — no HOME — and lib/fdlopen.cyr finds its helper only
# at $HOME/.cyrius/dlopen-helper, so tls_available() under the libssl backend read 0 and the
# libssl groups of tls_libssl_read_errors / _session_cache / _worker_thread (and the libssl leg
# of four more) SKIPped on every check.sh and release-gate run: measured 6 / 27 / 3 assertions
# there against 348 / 60 / 83 with the helper. The children still never see the invoking
# environment: HOME is <this run's private dir>/tcyr_home, removed with that dir, and the helper
# in it is a COPY of the one the toolchain under test would use — $CYRIUS_HOME/dlopen-helper
# (check.sh's staged home builds it from programs/dlopen-helper.c), else the invoking
# $HOME/.cyrius/dlopen-helper, which is read and never written.
# Gate: tests/gates/toolchain/check_tcyr_home_has_helper.sh. CHANGELOG [6.6.17]
fn _tcyr_helper_src(): i64 {
    var ch = getenv("CYRIUS_HOME");
    if (ch != 0) {
        if (strlen(ch) > 0) {
            var p1 = _cat2(ch, "/dlopen-helper");
            if (file_exists(p1) == 1) { return p1; }
        }
    }
    var h = getenv("HOME");
    if (h != 0) {
        if (strlen(h) > 0) {
            var p2 = _cat2(h, "/.cyrius/dlopen-helper");
            if (file_exists(p2) == 1) { return p2; }
        }
    }
    return 0;
}

fn _tcyr_envp(): i64 {
    if (_TCYR_ENVP != 0) { return _TCYR_ENVP; }
    var home = _cat2(_run_tmp(), "/tcyr_home");
    sys_mkdir(home, 448);
    var dot = _cat2(home, "/.cyrius");
    sys_mkdir(dot, 448);
    var src = _tcyr_helper_src();
    if (src != 0) {
        if (_exec_in_dir3("/", "/bin/cp", src, _cat2(dot, "/dlopen-helper"), 0, 0) == 0) {
            _TCYR_HELPER = src;
        }
    }
    var envp = alloc(24);
    if (envp == 0) { return EMPTY_ENVP; }
    store64(envp, "CYRIUS_TEST_ENV=1");
    store64(envp + 8, _cat2("HOME=", home));
    store64(envp + 16, 0);
    _TCYR_ENVP = envp;
    return envp;
}

fn _tcyr_compile_and_run(src_path): i64 {
    var bin_path = _tmp_path("audit_t_");
    var rc1 = _self_host_pipe(src_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        sys_unlink(bin_path);
        if (rc1 == 0 - 2) { return 0 - 2; }   # 6.6.8: the compile hit the deadline
        return 0 - 1;
    }
    sys_chmod(bin_path, 493);

    # v5.9.6 — switched from lib/process.cyr's pipe-based
    # exec_capture to the file-backed _exec_capture_clean.
    # exec_capture deadlocks when the test fixture forks a setuid
    # helper that's reparented to init as an orphan keeping the
    # pipe write-end open (shadow_pam.tcyr → unix_chkpwd; same
    # incident fixed for `_tcyr_relay_gate` in v5.9.2). Pre-v5.9.6
    # the gate reported "0 files" — the dir_list +
    # path_has_ext bugs masked this hang because the loop never
    # iterated; now that those are fixed, the underlying capture
    # bug surfaces here too.
    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_envp(bin_path, out_buf, out_cap, _tcyr_envp());
    sys_unlink(bin_path);

    # ⛔ v6.6.6: SAY WHEN A TEST NEVER FINISHED. `_exec_capture_clean` is now deadlined
    # (lib/regression.cyr), and -2 is the module's timeout code. Before the deadline this
    # branch could not exist: a hung .tcyr hung check.sh itself, with no output and no
    # verdict, until a human killed the run. A timeout is a RESULT and it is not the same
    # result as a crash. CHANGELOG [6.6.6]
    if (_last_exec_ec == 0 - 2) {
        regression_print("\n  TIMEOUT: ");
        regression_print(src_path);
        regression_print(" did not finish and was killed (CYRIUS_CHECK_TIMEOUT, default 120s)\n");
        return 1;
    }

    # CO-02 + 6.6.11: the ONE tcyr rule — see `_tcyr_grade`. A crash or nonzero exit is a
    # failure (CO-02), and so is a missing, empty or failing assert summary (6.6.11).
    # Returns M > 0, or -3 / -4 / -5 (the caller names each with `_tcyr_grade_why`).
    var sm[16];
    return _tcyr_grade(src_path, out_buf, out_n, &sm);
}

# ⛔ NO SILENT CAPS. A corpus that SHRINKS is the failure the .tcyr gates exist to catch,
# and a count alone cannot raise it — "test suite (160 files)" reads as green. The floor
# turns a blind reader into a hard FAIL. 6.6.9: the number lives in ONE place,
# tests/tcyr/CORPUS_FLOOR (line 1), read here and by every .tcyr loop in ci.yml — it had been
# written down four times. Returns -1 when the file is missing or line 1 is not exactly a
# number; the caller FAILS on that rather than running without a floor. CHANGELOG [6.6.9]
fn _tcyr_corpus_floor(): i64 {
    var cap = 4096;
    var buf = alloc(cap);
    var n = file_read_all(_root_path("tests/tcyr/CORPUS_FLOOR"), buf, cap);
    if (n <= 0) { return 0 - 1; }
    var v = 0;
    var digits = 0;
    var i = 0;
    var going = 1;
    while (going == 1) {
        if (i >= n) { going = 0; }
        else {
            var c = load8(buf + i);
            if (c >= 48 && c <= 57) {
                v = v * 10 + (c - 48);
                digits = digits + 1;
                i = i + 1;
            } else { going = 0; }
        }
    }
    if (digits == 0 || digits > 9) { return 0 - 1; }
    if (i < n && load8(buf + i) != 10) { return 0 - 1; }
    return v;
}

fn _testsuite_gate(): i64 {
    _section("Test Suite");
    var dir = _root_path("tests/tcyr");
    var dir_str = str_from(dir);
    # v6.5.11: RECURSIVE (find_files walks subdirs; path_join → str_builder_build,
    # which allocates total+1 and NUL-terminates, so str_data is a valid cstr).
    # Was a flat dir_list: a subdirectory entry failed the extension test and was
    # dropped with no recursion, no warning and no error. This is the ONLY .tcyr
    # driver in the 162-gate audit, so a subfoldered corpus went invisible while
    # the gate still printed PASS over a shrunken count.
    var files = find_files(dir_str, str_from(".tcyr"));
    var prefix_len = str_len(dir_str) + 1;
    _tcyr_envp();
    if (_TCYR_HELPER != 0) {
        _p("  (each test runs with a throwaway HOME holding a copy of ");
        _p(_TCYR_HELPER);
        println(", so the libssl groups run)");
    } else {
        println("  note: no dlopen-helper at $CYRIUS_HOME/dlopen-helper or $HOME/.cyrius/dlopen-helper — the libssl groups SKIP (each test still runs with a throwaway HOME)");
    }
    var fail_count = 0;
    var total = 0;
    var i = 0;
    while (i < vec_len(files)) {
        var full = vec_get(files, i);
        # Label is the path RELATIVE to tests/tcyr (minus ".tcyr"), not the
        # basename: two same-named tests in different buckets must not print the
        # same line, or a failure names a file nobody can find.
        var full_data = str_data(full);
        var rel_data = full_data + prefix_len;
        var label_len = str_len(full) - prefix_len - 5;
        _p("  ");
        print(rel_data, label_len);
        # Pad to 34 columns (was 22 — bucket/name is longer than a bare name).
        var pad = 34 - label_len;
        while (pad > 0) { _p(" "); pad = pad - 1; }
        var failed = _tcyr_compile_and_run(full_data);
        if (failed == 0 - 2) {
            _p("TIMEOUT (compile) — killed at the deadline (CYRIUS_CHECK_TIMEOUT=");
            print_num(_regression_timeout_ms() / 1000);
            println("s)");
            fail_count = fail_count + 1;
        } elif (failed == 0 - 1) {
            println("FAIL (compile)");
            fail_count = fail_count + 1;
        } elif (failed < 0) {
            # 6.6.11: -3 / -4 / -5 from `_tcyr_grade` — say WHICH rule failed, with the exit code.
            _p("FAIL (");
            _p(_tcyr_grade_why(failed));
            _p("; exit ");
            print_num(_last_exec_ec);
            println(")");
            fail_count = fail_count + 1;
        } elif (failed > 0) {
            _p("FAIL (");
            print_num(failed);
            println(" failed)");
            fail_count = fail_count + 1;
        } else {
            println("PASS");
        }
        total = total + 1;
        i = i + 1;
    }
    var floor = _tcyr_corpus_floor();
    if (floor < 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        println(": corpus floor — tests/tcyr/CORPUS_FLOOR is missing or its line 1 is not a number (the floor is not optional)");
        fail_count = fail_count + 1;
    } elif (total < floor) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": corpus floor — found ");
        print_num(total);
        _p(" .tcyr, expected >= ");
        print_num(floor);
        println(" (a shrinking corpus means a reader went blind, not that tests passed)");
        fail_count = fail_count + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "test suite (");
    str_builder_add_int(sb, total);
    str_builder_add_cstr(sb, " files)");
    var label = str_builder_build(sb);
    _check(str_data(label), fail_count);
    println("");
    return fail_count;
}
