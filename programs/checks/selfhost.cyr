# ================================================================
# programs/checks/selfhost.cyr — self-host compile drivers (_self_host_pipe* family) + tcyr/expected-output relay + self-host/heapmap/testsuite gates
# ================================================================
# v6.0.90: split out of the monolithic programs/check.cyr (10.2K LoC).
# Fn DEFINITIONS only — no includes, no module-level vars, no driver.
# All lib includes + the 18 globals + the dispatcher/driver live in
# programs/checks/main.cyr, which includes this file. See CHANGELOG [6.0.90].

fn _tcyr_relay_gate(gate_name, inner_label, tcyr_basename): i64 {
    var tcyr_abs = _root_path("");
    var sb = str_builder_new();
    str_builder_add_cstr(sb, ROOT_PATH);
    str_builder_add_cstr(sb, "/tests/tcyr/");
    str_builder_add_cstr(sb, tcyr_basename);
    var tcyr_path = str_data(str_builder_build(sb));

    var bin_path = _tmp_path("audit_relay_");
    var rc1 = _self_host_pipe(tcyr_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — compile error");
        sys_unlink(bin_path);
        _check(gate_name, 1);
        return 1;
    }
    sys_chmod(bin_path, 493);

    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_clean(bin_path, out_buf, out_cap);
    sys_unlink(bin_path);

    # CO-02: also fail when the fixture crashed / exited nonzero (even if it
    # printed "0 failed" or nothing) — _last_exec_ec is its real exit status.
    var failed = _tcyr_parse_failed(out_buf, out_n);
    if (failed != 0 || _last_exec_ec != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        println(inner_label);
        _check(gate_name, 1);
        return 1;
    }
    var passed = _tcyr_parse_passed(out_buf, out_n);
    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ");
    _p(inner_label);
    _p(" (");
    print_num(passed);
    println(" assertions)");
    _check(gate_name, 0);
    return 0;
}

fn _tcyr_parse_passed(buf, n): i64 {
    var needle = " passed";
    var nlen = strlen(needle);
    var i = 0;
    while (i + nlen <= n) {
        if (_buf_eq(buf + i, needle, nlen) == 1) {
            var end = i;
            var start = end;
            while (start > 0) {
                var c = load8(buf + start - 1);
                if (c < 48) { return _aw_parse_leading_int(buf + start, end - start); }
                if (c > 57) { return _aw_parse_leading_int(buf + start, end - start); }
                start = start - 1;
            }
            return _aw_parse_leading_int(buf + start, end - start);
        }
        i = i + 1;
    }
    return 0;
}

fn _expected_output_gate(gate_name, inner_label, fixture_basename): i64 {
    var sb_src = str_builder_new();
    str_builder_add_cstr(sb_src, ROOT_PATH);
    str_builder_add_cstr(sb_src, "/tests/fixtures/");
    str_builder_add_cstr(sb_src, fixture_basename);
    str_builder_add_cstr(sb_src, ".cyr");
    var fixture_path = str_data(str_builder_build(sb_src));

    var sb_exp = str_builder_new();
    str_builder_add_cstr(sb_exp, ROOT_PATH);
    str_builder_add_cstr(sb_exp, "/tests/fixtures/");
    str_builder_add_cstr(sb_exp, fixture_basename);
    str_builder_add_cstr(sb_exp, ".expected");
    var expected_path = str_data(str_builder_build(sb_exp));

    var bin_path = _tmp_path("audit_eo_");
    var rc1 = _self_host_pipe(fixture_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — compile error");
        sys_unlink(bin_path);
        _check(gate_name, 1);
        return 1;
    }
    sys_chmod(bin_path, 493);

    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_clean(bin_path, out_buf, out_cap);
    sys_unlink(bin_path);

    # CO-02: an output-comparison fixture that CRASHED (signal) but happened to
    # emit matching bytes is a real failure; a normal nonzero exit is by design
    # (output-only fixtures return their last value), so gate on the crash flag.
    if (_last_exec_sig != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — crashed (signal)");
        _check(gate_name, 1);
        return 1;
    }

    var exp_cap = 65536;
    var exp_buf = alloc(exp_cap);
    var exp_n = file_read_all(expected_path, exp_buf, exp_cap);
    if (exp_n < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — expected file missing");
        _check(gate_name, 1);
        return 1;
    }

    var ok = 0;
    if (out_n == exp_n) { ok = _buf_eq(out_buf, exp_buf, out_n); }
    if (ok != 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        _p(" — output drift (");
        print_num(out_n);
        _p(" got, ");
        print_num(exp_n);
        println(" expected)");
        _check(gate_name, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ");
    _p(inner_label);
    _p(" (");
    print_num(out_n);
    println(" bytes match)");
    _check(gate_name, 0);
    return 0;
}

fn _compile_run_get_exit(fixture_path): i64 {
    var bin = _tmp_path("audit_xrun_");
    var rc = _self_host_pipe(fixture_path, CC_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        return 0 - 1;
    }
    sys_chmod(bin, 493);
    var ec = _exec_run_clean(bin);
    sys_unlink(bin);
    return ec;
}

# v6.3.0: the var-family is growable (was fixed-capped at 8192). cycc itself is
# well under 8192 vars, so self-host + the corpus never exercise the grow — this
# gate does: it generates 8300 distinct globals (forces vcnt past the old cap →
# _var_grow fires) and reads the last one back through the grown table. Pre-v6.3.0
# this errored "variable table full (8192)"; a broken grow miscompiles/crashes it.
fn _var_grow_gate(): i64 {
    var label = "cyrius compiles + RUNS a >8192-var program (8300 globals) — the var-family grows past the old fixed 8192 cap (v6.3.0 _var_grow)";

    var sb = str_builder_new();
    var nb[24];
    var i = 0;
    while (i < 8300) {
        str_builder_add_cstr(sb, "var g");
        fmt_int_buf(i, &nb);
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, " = ");
        fmt_int_buf(i, &nb);
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, ";\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "fn main(): i64 { return g8299 - 8299; }\n");

    var fx = _tmp_path("audit_vargrow_");
    _write_file(fx, str_data(str_builder_build(sb)));
    var ec = _compile_run_get_exit(fx);
    sys_unlink(fx);

    var fail = 0;
    if (ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": >8192-var program exited "); print_num(ec); println(" (expected 0 — _var_grow broken or cap still fixed)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": 8300-global program compiles + runs (g8299 read back through the grown var-family)");
    }
    _check(label, fail);
    return fail;
}

# v6.4.75: the fn-table twin of _var_grow_gate — the gate whose ABSENCE let the
# fn_table >8192 P0 survive two migrations. The var family was made growable at
# v6.2.0/v6.3.0, but SIX fn-indexed side tables were left at fixed 8192-slot heap
# bands packed back-to-back, so once _fnt_grow let the count past 8192, fn fi's
# per-fn metadata reset wrote into slot (fi-8192) of the NEIGHBOURING table —
# silent corruption, no diagnostic, and the capacity warning went quiet at exactly
# that point (it divided by the live _fnt_cap). cycc self-host never caught it
# because cycc has ~1135 fns; only a >8192-fn consumer (stiva, 7443) approached it.
# See issues/2026-07-23-fn-table-growth-past-8192-corrupts-fixed-side-tables.md.
#
# THE DISCRIMINATOR: put `#must_use` on a LOW fn (g58) and make a HIGH fn (g8250)
# reachable. Pre-fix, g8250's per-fn reset clobbered fn_flags[58] (8250-8192=58),
# WIPING the must-use bit, so discarding g58()'s result produced NO warning.
# Post-fix each side table is its own 32768-slot alloc'd region, so the flag
# survives and the warning fires. Mutation-proven: on 6.4.74 this emits 0
# warnings, on 6.4.75 it emits 1 — revert any of the six accessors to the fixed
# `S + 0xNNNNNN` band and this gate goes red.
fn _fn_grow_gate(): i64 {
    var label = "cyrius keeps per-fn metadata correct past 8192 fns — #must_use on fn 58 survives a reachable fn 8250 (v6.4.75; the six fn-indexed side tables no longer alias past the old 8192 cap)";

    var sb = str_builder_new();
    var nb[24];
    var i = 0;
    while (i < 8300) {
        if (i == 58) { str_builder_add_cstr(sb, "#must_use\n"); }
        str_builder_add_cstr(sb, "fn g");
        fmt_int_buf(i, &nb);
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, "(): i64 { return ");
        fmt_int_buf(i - (i / 7) * 7, &nb);   # i % 7
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, "; }\n");
        i = i + 1;
    }
    # g8250 reachable (drives the >8192 reset path); g58() discarded (must-use probe).
    str_builder_add_cstr(sb, "fn main(): i64 { var acc = g8250(); g58(); return acc; }\n");

    var fail = _stderr_match_subcase(
        "must_use on fn 58 survives reachable fn 8250 (fn-table side-table aliasing past 8192)",
        str_data(str_builder_build(sb)),
        "is discarded", 1);

    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": 8300-fn program keeps fn 58's #must_use flag past the old 8192 cap");
    }
    _check(label, fail);
    return fail;
}

fn _self_host_pipe(src_path, compiler_path, out_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var out_fd = sys_open(out_path, 577, 420);   # O_WRONLY|O_CREAT|O_TRUNC | 0644
    if (out_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[16];
        store64(&envp, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

fn _compile_capture_stderr(src_path, compiler_path, stderr_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var err_fd = sys_open(stderr_path, 577, 420);
    if (err_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(err_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(err_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(err_fd, 2);
        sys_close(err_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 1); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[16];
        store64(&envp, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(err_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

fn _stderr_match_subcase(case_label, src_str, expect_substr, want_present): i64 {
    var src_path = _tmp_path("audit_smc_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { return 1; }
    sys_write(fd, src_str, strlen(src_str));
    sys_close(fd);

    var err_path = _tmp_path("audit_smc_err_");
    _compile_capture_stderr(src_path, CC_PATH, err_path);
    sys_unlink(src_path);

    var got = _file_contains_substr(err_path, expect_substr);
    sys_unlink(err_path);

    if (want_present == 1) {
        if (got != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": ");
            _p(case_label);
            _p(" — stderr missing: ");
            println(expect_substr);
            return 1;
        }
    } else {
        if (got == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": ");
            _p(case_label);
            _p(" — stderr contains forbidden: ");
            println(expect_substr);
            return 1;
        }
    }
    return 0;
}

# CO-02 (v6.1.35 follow-up): a "rejects" subcase must verify BOTH that the loud
# message printed AND that the compiler EXITED NONZERO (a controlled reject, not
# a clean exit-0 silent-accept and not a crash). The plain _stderr_match_subcase
# only greps stderr — it can't carry the exit-code assertion because many of its
# callers are lint HINTS that legitimately exit 0. So the input-validation gate
# uses this stricter variant. The CVE-31 paths sys_exit(1). See CHANGELOG [6.1.35].
fn _input_rejects_subcase(case_label, src_str, expect_substr): i64 {
    var src_path = _tmp_path("audit_irj_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { return 1; }
    sys_write(fd, src_str, strlen(src_str));
    sys_close(fd);

    var err_path = _tmp_path("audit_irj_err_");
    var st = _compile_capture_stderr(src_path, CC_PATH, err_path);
    sys_unlink(src_path);

    var got = _file_contains_substr(err_path, expect_substr);
    sys_unlink(err_path);

    if (got != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(case_label);
        _p(" — stderr missing: ");
        println(expect_substr);
        return 1;
    }
    # Controlled nonzero exit required: WIFEXITED==0 means it crashed (signal),
    # WEXITSTATUS==0 means it accepted the input despite printing — both are bugs.
    if (WIFEXITED(st) == 0 || WEXITSTATUS(st) == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(case_label);
        println(" — printed the message but did not exit nonzero (silent-accept)");
        return 1;
    }
    return 0;
}

# v6.3.3 #5: existing callers want the canonical base — delegate with base_env=0
# (byte-identical behavior). The _base variant adds an optional CYRIUS_KERNEL_BASE
# env so the sections-override gate can exercise a settable kernel load base.
fn _self_host_pipe_elf64k(src_path, compiler_path, out_path): i64 {
    return _self_host_pipe_elf64k_base(src_path, compiler_path, out_path, 0);
}

fn _self_host_pipe_elf64k_base(src_path, compiler_path, out_path, base_env): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[32];   # up to 4 env ptrs: KERNEL, ELF64, optional KERNEL_BASE, NUL
        store64(&envp,      "CYRIUS_KERNEL=1");
        store64(&envp + 8,  "CYRIUS_ELF64_KERNEL=1");
        if (base_env != 0) {
            store64(&envp + 16, base_env);
            store64(&envp + 24, 0);
        } else {
            store64(&envp + 16, 0);
        }
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

fn _self_host_pipe_efi(src_path, compiler_path, out_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[16];   # 2 env ptrs need 16 B (was envp[3]=8 B → overlapped argv[1])
        store64(&envp,     "CYRIUS_TARGET_EFI=1");
        store64(&envp + 8, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

fn _efi_compile_to_buf(src_path, out_buf, out_buf_cap, fail_label): i64 {
    var bin_path = _tmp_path("audit_efi_compile_bin_");
    var rc = _self_host_pipe_efi(src_path, CC_PATH, bin_path);
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": "); _p(fail_label); _p(" compile failed (rc=");
        print_num(rc); println(")");
        return 0 - 1;
    }
    var n = file_read_all(bin_path, out_buf, out_buf_cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": "); _p(fail_label); println(" — compiled but output unreadable");
        return 0 - 1;
    }
    return n;
}

fn _self_host_pipe_agnos(src_path, compiler_path, out_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }
    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);
    var pid = sys_fork();
    if (pid < 0) { sys_close(read_fd); sys_close(write_fd); sys_close(out_fd); return 0 - 4; }
    if (pid == 0) {
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[16];
        store64(&envp,     "CYRIUS_TARGET_AGNOS=1");
        store64(&envp + 8, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    var written = 0;
    while (written < src_n) {
        var w = sys_write(write_fd, src_buf + written, src_n - written);
        if (w <= 0) { written = src_n; }
        else { written = written + w; }
    }
    sys_close(write_fd);
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    return load32(&status_buf);
}

fn _agnos_compile_to_buf(src_path, out_buf, out_buf_cap, fail_label): i64 {
    var bin_path = _tmp_path("audit_agnos_compile_bin_");
    var rc = _self_host_pipe_agnos(src_path, CC_PATH, bin_path);
    if (rc != 0) {
        sys_unlink(bin_path);
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": "); _p(fail_label); _p(" compile failed (rc="); print_num(rc); println(")");
        return 0 - 1;
    }
    var n = file_read_all(bin_path, out_buf, out_buf_cap);
    sys_unlink(bin_path);
    if (n <= 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": "); _p(fail_label); println(" — compiled but output unreadable");
        return 0 - 1;
    }
    return n;
}

