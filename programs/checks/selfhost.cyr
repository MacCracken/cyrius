# ================================================================
# programs/checks/selfhost.cyr — self-host compile drivers (_self_host_pipe* family) + tcyr/expected-output relay + self-host/heapmap/testsuite gates
# ================================================================
# v6.0.90: split out of the monolithic programs/check.cyr (10.2K LoC).
# Fn DEFINITIONS only — no includes, no module-level vars, no driver.
# All lib includes + the 18 globals + the dispatcher/driver live in
# programs/checks/main.cyr, which includes this file. See CHANGELOG [6.0.90].

# Callers pass a BARE basename ("core.tcyr"). v6.5.11: the corpus lives in topical
# subfolders, so resolve by SEARCH instead of pinning tests/tcyr/<basename> — that
# concatenation could no longer reach any test in the tree. This fn has had no callers
# since v5.9.25 (see main.cyr:391), which is exactly why it needed fixing rather than
# leaving: a dead path-builder that cannot work is a trap for whoever revives it.
fn _tcyr_relay_gate(gate_name, inner_label, tcyr_basename): i64 {
    var root_dir = str_from(_root_path("tests/tcyr"));
    var want = str_from(tcyr_basename);
    var cands = find_files(root_dir, str_from(".tcyr"));
    var tcyr_path = 0;
    var ci = 0;
    while (ci < vec_len(cands)) {
        var cand = vec_get(cands, ci);
        if (str_eq(path_basename(cand), want) == 1) {
            tcyr_path = str_data(cand);
            ci = vec_len(cands);
        }
        ci = ci + 1;
    }
    if (tcyr_path == 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        _p(" — no such .tcyr under tests/tcyr: ");
        println(tcyr_basename);
        _check(gate_name, 1);
        return 1;
    }

    var bin_path = _tmp_path("audit_relay_");
    var rc1 = _self_host_pipe(tcyr_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — compile error");
        sys_unlink(bin_path);
        _check(gate_name, 1);
        return 1;
    }
    sys_chmod(bin_path, 493);

    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_clean(bin_path, out_buf, out_cap);
    sys_unlink(bin_path);

    # CO-02 + 6.6.11: graded by the ONE tcyr rule (`_tcyr_grade`): exit 0 AND, when the source
    # calls assert_summary(, a last `N passed, M failed` line with N >= 1 and M == 0. This gate
    # used to print PASS "(0 assertions)" for a binary that printed nothing and exited 0.
    var sm[16];
    var verdict = _tcyr_grade(tcyr_path, out_buf, out_n, &sm);
    if (verdict != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        _p(" — ");
        println(_tcyr_grade_why(verdict));
        _check(gate_name, 1);
        return 1;
    }
    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ");
    _p(inner_label);
    _p(" (");
    print_num(load64(&sm));
    println(" assertions)");
    _check(gate_name, 0);
    return 0;
}

# Parse the decimal digits at buf[p..n) into *valp; return the index after them (== p when
# there are none).
fn _tcyr_num_at(buf, n, p, valp): i64 {
    var v = 0;
    var going = 1;
    while (going == 1) {
        if (p >= n) { going = 0; }
        else {
            var c = load8(buf + p);
            if (c >= 48 && c <= 57) {
                v = v * 10 + (c - 48);
                p = p + 1;
            } else { going = 0; }
        }
    }
    store64(valp, v);
    return p;
}

# 6.6.11: the LAST line of a .tcyr's stdout that STARTS with `N passed, M failed` — the shape
# lib/assert.cyr's assert_summary prints. Stores N at out+0 and M at out+8 and returns 1, or
# returns 0 when there is no such line. The LAST one, anchored at a line start: a test may
# print "failed" in its own messages, and a body that runs twice prints two summaries (the
# 6.6.11 main-twice shape); the first `" failed"` substring anywhere, which this replaces, read
# whichever came first.
fn _tcyr_last_summary(buf, n, out): i64 {
    var found = 0;
    var np[8];
    var nf[8];
    var ls = 0;
    while (ls < n) {
        var p = _tcyr_num_at(buf, n, ls, &np);
        if (p > ls) {
            if (p + 9 <= n) {
                if (_buf_eq(buf + p, " passed, ", 9) == 1) {
                    var q = _tcyr_num_at(buf, n, p + 9, &nf);
                    if (q > p + 9) {
                        if (q + 7 <= n) {
                            if (_buf_eq(buf + q, " failed", 7) == 1) {
                                store64(out, load64(&np));
                                store64(out + 8, load64(&nf));
                                found = 1;
                            }
                        }
                    }
                }
            }
        }
        var going = 1;
        while (going == 1) {
            if (ls >= n) { going = 0; }
            elif (load8(buf + ls) == 10) { going = 0; }
            else { ls = ls + 1; }
        }
        ls = ls + 1;
    }
    return found;
}

# ⛔ 6.6.11 — ONE RULE FOR EVERY .tcyr READER. This driver, ci.yml's three full-corpus loops,
# scripts/cross-os-libtest-runner.sh, the cass leg of scripts/cross-os-selfhost.sh and
# `cyrius test` all apply it: when the SOURCE calls assert_summary(, the LAST
# `N passed, M failed` line must exist with N >= 1 and M == 0, AND the exit code must be 0.
# The requirement is derived from the source text, so tests/tcyr/frontend/
# struct_sid_20_21_field.tcyr (no assert_summary) is graded on its exit code alone.
# Before it, this driver passed `failed == 0 && ec == 0` on the FIRST " failed" substring: a
# binary that died before its summary (its FAIL row goes to stderr, which is not captured,
# then exit 0) or ran nothing at all read PASS.
# Returns 0 (pass), M > 0 (the summary's failed count), or a negative reason for
# `_tcyr_grade_why`: -3 no summary, -4 a summary with 0 assertions, -5 a nonzero exit or a
# signal. `sm` receives N/M when a summary was found (else 0/0). CHANGELOG [6.6.11]
fn _tcyr_grade(src_path, buf, n, sm): i64 {
    store64(sm, 0);
    store64(sm + 8, 0);
    var have = _tcyr_last_summary(buf, n, sm);
    if (have == 1) {
        if (load64(sm + 8) > 0) { return load64(sm + 8); }
    }
    if (_file_contains_substr(src_path, "assert_summary(") == 1) {
        if (have == 0) { return 0 - 3; }
        if (load64(sm) < 1) { return 0 - 4; }
    }
    if (_last_exec_ec != 0 || _last_exec_sig != 0) { return 0 - 5; }
    return 0;
}

fn _tcyr_grade_why(verdict): i64 {
    if (verdict == 0 - 3) { return "no assert summary: the binary stopped before assert_summary() or ran nothing"; }
    if (verdict == 0 - 4) { return "the assert summary reports 0 assertions"; }
    if (verdict == 0 - 5) { return "the summary is clean but the process exited nonzero or was killed"; }
    if (verdict > 0) { return "the assert summary reports failures"; }
    return "pass";
}

fn _expected_output_gate(gate_name, inner_label, fixture_basename): i64 {
    var sb_src = str_builder_new();
    str_builder_add_cstr(sb_src, ROOT_PATH);
    str_builder_add_cstr(sb_src, "/tests/fixtures/");
    str_builder_add_cstr(sb_src, fixture_basename);
    str_builder_add_cstr(sb_src, ".cyr");
    var fixture_path = str_data(str_builder_build(sb_src));

    var sb_exp = str_builder_new();
    str_builder_add_cstr(sb_exp, ROOT_PATH);
    str_builder_add_cstr(sb_exp, "/tests/fixtures/");
    str_builder_add_cstr(sb_exp, fixture_basename);
    str_builder_add_cstr(sb_exp, ".expected");
    var expected_path = str_data(str_builder_build(sb_exp));

    var bin_path = _tmp_path("audit_eo_");
    var rc1 = _self_host_pipe(fixture_path, CC_PATH, bin_path);
    if (rc1 != 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — compile error");
        sys_unlink(bin_path);
        _check(gate_name, 1);
        return 1;
    }
    sys_chmod(bin_path, 493);

    var out_cap = 65536;
    var out_buf = alloc(out_cap);
    var out_n = _exec_capture_clean(bin_path, out_buf, out_cap);
    sys_unlink(bin_path);

    # CO-02: an output-comparison fixture that CRASHED (signal) but happened to
    # emit matching bytes is a real failure; a normal nonzero exit is by design
    # (output-only fixtures return their last value), so gate on the crash flag.
    # 6.6.8: and on a child that did not FINISH — killed at the deadline (-2) or never
    # observed (-1) — which the crash flag alone reads as a clean run: a fixture that printed
    # the right bytes and then hung was scored PASS.
    if (_exec_unfinished() == 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        _p(" — ");
        _p(_exec_unfinished_why());   # _p: println of an untyped i64 prints the NUMBER
        _p("\n");
        _check(gate_name, 1);
        return 1;
    }

    var exp_cap = 65536;
    var exp_buf = alloc(exp_cap);
    var exp_n = file_read_all(expected_path, exp_buf, exp_cap);
    if (exp_n < 0) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        println(" — expected file missing");
        _check(gate_name, 1);
        return 1;
    }

    var ok = 0;
    if (out_n == exp_n) { ok = _buf_eq(out_buf, exp_buf, out_n); }
    if (ok != 1) {
        _p("  ");
        _p(ANSI_RED);
        _p("FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(inner_label);
        _p(" — output drift (");
        print_num(out_n);
        _p(" got, ");
        print_num(exp_n);
        println(" expected)");
        _check(gate_name, 1);
        return 1;
    }

    _p("  ");
    _p(ANSI_GREEN);
    _p("PASS");
    _p(ANSI_RESET);
    _p(": ");
    _p(inner_label);
    _p(" (");
    print_num(out_n);
    println(" bytes match)");
    _check(gate_name, 0);
    return 0;
}

fn _compile_run_get_exit(fixture_path): i64 {
    var bin = _tmp_path("audit_xrun_");
    var rc = _self_host_pipe(fixture_path, CC_PATH, bin);
    if (rc != 0) {
        sys_unlink(bin);
        return 0 - 1;
    }
    sys_chmod(bin, 493);
    var ec = _exec_run_clean(bin);
    sys_unlink(bin);
    return ec;
}

# v6.3.0: the var-family is growable (was fixed-capped at 8192). cycc itself is
# well under 8192 vars, so self-host + the corpus never exercise the grow — this
# gate does: it generates 8300 distinct globals (forces vcnt past the old cap →
# _var_grow fires) and reads the last one back through the grown table. Pre-v6.3.0
# this errored "variable table full (8192)"; a broken grow miscompiles/crashes it.
fn _var_grow_gate(): i64 {
    var label = "cyrius compiles + RUNS a >8192-var program (8300 globals) — the var-family grows past the old fixed 8192 cap (v6.3.0 _var_grow)";

    var sb = str_builder_new();
    var nb[24];
    var i = 0;
    while (i < 8300) {
        str_builder_add_cstr(sb, "var g");
        fmt_int_buf(i, &nb);
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, " = ");
        fmt_int_buf(i, &nb);
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, ";\n");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "fn main(): i64 { return g8299 - 8299; }\n");

    var fx = _tmp_path("audit_vargrow_");
    _write_file(fx, str_data(str_builder_build(sb)));
    var ec = _compile_run_get_exit(fx);
    sys_unlink(fx);

    var fail = 0;
    if (ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": >8192-var program exited "); print_num(ec); println(" (expected 0 — _var_grow broken or cap still fixed)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": 8300-global program compiles + runs (g8299 read back through the grown var-family)");
    }
    _check(label, fail);
    return fail;
}

# v6.4.75: the fn-table twin of _var_grow_gate — the gate whose ABSENCE let the
# fn_table >8192 P0 survive two migrations. The var family was made growable at
# v6.2.0/v6.3.0, but SIX fn-indexed side tables were left at fixed 8192-slot heap
# bands packed back-to-back, so once _fnt_grow let the count past 8192, fn fi's
# per-fn metadata reset wrote into slot (fi-8192) of the NEIGHBOURING table —
# silent corruption, no diagnostic, and the capacity warning went quiet at exactly
# that point (it divided by the live _fnt_cap). cycc self-host never caught it
# because cycc has ~1135 fns; only a >8192-fn consumer (stiva, 7443) approached it.
# See issues/2026-07-23-fn-table-growth-past-8192-corrupts-fixed-side-tables.md.
#
# THE DISCRIMINATOR: put `#must_use` on a LOW fn (g58) and make a HIGH fn (g8250)
# reachable. Pre-fix, g8250's per-fn reset clobbered fn_flags[58] (8250-8192=58),
# WIPING the must-use bit, so discarding g58()'s result produced NO warning.
# Post-fix each side table is its own 32768-slot alloc'd region, so the flag
# survives and the warning fires. Mutation-proven: on 6.4.74 this emits 0
# warnings, on 6.4.75 it emits 1 — revert any of the six accessors to the fixed
# `S + 0xNNNNNN` band and this gate goes red.
fn _fn_grow_gate(): i64 {
    var label = "cyrius keeps per-fn metadata correct past 8192 fns — #must_use on fn 58 survives a reachable fn 8250 (v6.4.75; the six fn-indexed side tables no longer alias past the old 8192 cap)";

    var sb = str_builder_new();
    var nb[24];
    var i = 0;
    while (i < 8300) {
        if (i == 58) { str_builder_add_cstr(sb, "#must_use\n"); }
        str_builder_add_cstr(sb, "fn g");
        fmt_int_buf(i, &nb);
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, "(): i64 { return ");
        fmt_int_buf(i - (i / 7) * 7, &nb);   # i % 7
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, "; }\n");
        i = i + 1;
    }
    # g8250 reachable (drives the >8192 reset path); g58() discarded (must-use probe).
    str_builder_add_cstr(sb, "fn main(): i64 { var acc = g8250(); g58(); return acc; }\n");

    var fail = _stderr_match_subcase(
        "must_use on fn 58 survives reachable fn 8250 (fn-table side-table aliasing past 8192)",
        str_data(str_builder_build(sb)),
        "is discarded", 1);

    if (fail == 0) {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": 8300-fn program keeps fn 58's #must_use flag past the old 8192 cap");
    }
    _check(label, fail);
    return fail;
}

# v6.4.76: the identifier-pool cap gate. tok_names (the interned identifier pool
# at S+0x60000) was raised 256 KB → 512 KB in place (threshold 261872 → 524016).
# cycc self-host uses ~43 K of identifiers so it never approaches the cap — only a
# large consumer (stiva 3.0.6 was at 243737/262144 = 93 %) does, which is why the
# cap needed a gate that generates a program PAST the old 256 KB ceiling. Emits
# ~10000 distinct 35-char globals (~360 KB of identifiers — over the old 262144
# cap, under the new 524288) and reads the last one back. Pre-v6.4.76 this errored
# "identifier buffer full (.../262144)"; mutation-proven — revert the two lex.cyr
# thresholds to 261872 and this goes red.
fn _idpool_gate(): i64 {
    var label = "cyrius compiles + RUNS a >256 KB-identifier program (~360 KB of distinct names) — the tok_names pool grows to 512 KB in place (v6.4.76)";

    var sb = str_builder_new();
    var nb[24];
    var i = 0;
    while (i < 10000) {
        # 35-char base name keeps each distinct identifier well over the ~26-byte
        # average so 10000 of them clear the old 262144-byte cap with margin.
        str_builder_add_cstr(sb, "var identifier_pool_gate_padding_");
        fmt_int_buf(i, &nb);
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, " = ");
        fmt_int_buf(i, &nb);
        str_builder_add_cstr(sb, &nb);
        str_builder_add_cstr(sb, ";\n");
        i = i + 1;
    }
    # Read the last global back through the enlarged pool; correct read → exit 0.
    str_builder_add_cstr(sb, "fn main(): i64 { return identifier_pool_gate_padding_9999 - 9999; }\n");

    var fx = _tmp_path("audit_idpool_");
    _write_file(fx, str_data(str_builder_build(sb)));
    var ec = _compile_run_get_exit(fx);
    sys_unlink(fx);

    var fail = 0;
    if (ec != 0) {
        _p("  "); _p(ANSI_RED); _p("FAIL"); _p(ANSI_RESET);
        _p(": >256 KB-identifier program exited "); print_num(ec);
        println(" (expected 0 — pool cap not raised, or the raise miscompiles)");
        fail = 1;
    } else {
        _p("  "); _p(ANSI_GREEN); _p("PASS"); _p(ANSI_RESET);
        println(": ~360 KB-identifier program compiles + runs (last global read back through the 512 KB pool)");
    }
    _check(label, fail);
    return fail;
}

# Pipe `src_path` into `compiler_path`, stdout to `out_path`. Returns the RAW wait status
# (0 = exit 0), or: -1 source unreadable, -2 the child was killed at the DEADLINE
# (CYRIUS_CHECK_TIMEOUT), -3 pipe, -4 fork, -5 output not creatable, -6 the child's end was
# never observed. ⛔ 6.6.8: -2 used to be "output not creatable" and a deadline kill returned
# the killed child's raw status, so a compile cut at the deadline read as an ordinary
# failure (and the .tcyr row said `FAIL (compile)`). `_compile_capture_stderr` is the same.
# CHANGELOG [6.6.8]
fn _self_host_pipe(src_path, compiler_path, out_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var out_fd = sys_open(out_path, 577, 420);   # O_WRONLY|O_CREAT|O_TRUNC | 0644
    if (out_fd < 0) { return 0 - 5; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var _rg_ppid_pid = sys_getpid();

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {

        _regression_child_guard(_rg_ppid_pid);
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[16];
        store64(&envp, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    regression_pipe_write_all(write_fd, src_buf, src_n, _regression_timeout_ms());
    sys_close(write_fd);
    var status_buf[1];
    var reaped = _regression_wait_deadline(pid, &status_buf, _regression_timeout_ms());
    if (reaped == 0) { return 0 - 2; }   # 6.6.8: the DEADLINE, not the signal it sent
    if (reaped < 0) { return 0 - 6; }    # never observed: there is no status to return
    return load32(&status_buf);
}

fn _compile_capture_stderr(src_path, compiler_path, stderr_path): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var err_fd = sys_open(stderr_path, 577, 420);
    if (err_fd < 0) { return 0 - 5; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(err_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var _rg_ppid_pid = sys_getpid();

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(err_fd);
        return 0 - 4;
    }
    if (pid == 0) {

        _regression_child_guard(_rg_ppid_pid);
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(err_fd, 2);
        sys_close(err_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 1); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[16];
        store64(&envp, 0);
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(err_fd);
    regression_pipe_write_all(write_fd, src_buf, src_n, _regression_timeout_ms());
    sys_close(write_fd);
    var status_buf[1];
    var reaped = _regression_wait_deadline(pid, &status_buf, _regression_timeout_ms());
    if (reaped == 0) { return 0 - 2; }   # 6.6.8: the DEADLINE, not the signal it sent
    if (reaped < 0) { return 0 - 6; }    # never observed: there is no status to return
    return load32(&status_buf);
}

fn _stderr_match_subcase(case_label, src_str, expect_substr, want_present): i64 {
    var src_path = _tmp_path("audit_smc_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { return 1; }
    sys_write(fd, src_str, strlen(src_str));
    sys_close(fd);

    var err_path = _tmp_path("audit_smc_err_");
    _compile_capture_stderr(src_path, CC_PATH, err_path);
    sys_unlink(src_path);

    var got = _file_contains_substr(err_path, expect_substr);
    sys_unlink(err_path);

    if (want_present == 1) {
        if (got != 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": ");
            _p(case_label);
            _p(" — stderr missing: ");
            println(expect_substr);
            return 1;
        }
    } else {
        if (got == 1) {
            _p("    ");
            _p(ANSI_RED);
            _p("case-FAIL");
            _p(ANSI_RESET);
            _p(": ");
            _p(case_label);
            _p(" — stderr contains forbidden: ");
            println(expect_substr);
            return 1;
        }
    }
    return 0;
}

# CO-02 (v6.1.35 follow-up): a "rejects" subcase must verify BOTH that the loud
# message printed AND that the compiler EXITED NONZERO (a controlled reject, not
# a clean exit-0 silent-accept and not a crash). The plain _stderr_match_subcase
# only greps stderr — it can't carry the exit-code assertion because many of its
# callers are lint HINTS that legitimately exit 0. So the input-validation gate
# uses this stricter variant. The CVE-31 paths sys_exit(1). See CHANGELOG [6.1.35].
fn _input_rejects_subcase(case_label, src_str, expect_substr): i64 {
    var src_path = _tmp_path("audit_irj_src_");
    var fd = sys_open(src_path, 577, 420);
    if (fd < 0) { return 1; }
    sys_write(fd, src_str, strlen(src_str));
    sys_close(fd);

    var err_path = _tmp_path("audit_irj_err_");
    var st = _compile_capture_stderr(src_path, CC_PATH, err_path);
    sys_unlink(src_path);

    var got = _file_contains_substr(err_path, expect_substr);
    sys_unlink(err_path);

    if (got != 1) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(case_label);
        _p(" — stderr missing: ");
        println(expect_substr);
        return 1;
    }
    # Controlled nonzero exit required: WIFEXITED==0 means it crashed (signal),
    # WEXITSTATUS==0 means it accepted the input despite printing — both are bugs.
    if (WIFEXITED(st) == 0 || WEXITSTATUS(st) == 0) {
        _p("    ");
        _p(ANSI_RED);
        _p("case-FAIL");
        _p(ANSI_RESET);
        _p(": ");
        _p(case_label);
        println(" — printed the message but did not exit nonzero (silent-accept)");
        return 1;
    }
    return 0;
}

# v6.3.3 #5: existing callers want the canonical base — delegate with base_env=0
# (byte-identical behavior). The _base variant adds an optional CYRIUS_KERNEL_BASE
# env so the sections-override gate can exercise a settable kernel load base.
fn _self_host_pipe_elf64k(src_path, compiler_path, out_path): i64 {
    return _self_host_pipe_elf64k_base(src_path, compiler_path, out_path, 0);
}

fn _self_host_pipe_elf64k_base(src_path, compiler_path, out_path, base_env): i64 {
    var src_cap = 2000000;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n <= 0) { return 0 - 1; }

    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 2; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 3; }
    var read_fd = load32(&pipefd);
    var write_fd = load32(&pipefd + 4);

    var _rg_ppid_pid = sys_getpid();

    var pid = sys_fork();
    if (pid < 0) {
        sys_close(read_fd);
        sys_close(write_fd);
        sys_close(out_fd);
        return 0 - 4;
    }
    if (pid == 0) {

        _regression_child_guard(_rg_ppid_pid);
        sys_close(write_fd);
        sys_dup2(read_fd, 0);
        sys_close(read_fd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var devnull = sys_open("/dev/null", 1, 0);
        if (devnull >= 0) { sys_dup2(devnull, 2); sys_close(devnull); }
        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv,     compiler_path);
        store64(&argv + 8, 0);
        var envp[32];   # up to 4 env ptrs: KERNEL, ELF64, optional KERNEL_BASE, NUL
        store64(&envp,      "CYRIUS_KERNEL=1");
        store64(&envp + 8,  "CYRIUS_ELF64_KERNEL=1");
        if (base_env != 0) {
            store64(&envp + 16, base_env);
            store64(&envp + 24, 0);
        } else {
            store64(&envp + 16, 0);
        }
        sys_execve(compiler_path, &argv, &envp);
        sys_exit(127);
    }
    sys_close(read_fd);
    sys_close(out_fd);
    regression_pipe_write_all(write_fd, src_buf, src_n, _regression_timeout_ms());
    sys_close(write_fd);
    var status_buf[1];
    _regression_wait_deadline(pid, &status_buf, _regression_timeout_ms());
    return load32(&status_buf);
}

fn _self_host_pipe_efi(src_path, compiler_path, out_path): i64 {
    var src_cap = 2000000;
