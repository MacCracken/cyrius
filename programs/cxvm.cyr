# cxvm — Cyrius-X bytecode VM (interpreter)
# Usage: echo 'bytecode' | ./cxvm   (or: cat prog.cyx | ./cxvm)
#
# Register-based VM. 32-bit fixed-width instructions.
# Encoding: [opcode:8][a:8][b:8][c:8] (little-endian in file)
#
# Registers: r0-r255 (64-bit), r0 = accumulator, r253 = fp, r254 = sp
# Memory: 1 MB data segment (_CX_MEM_SIZE; it read "64KB" here after the v6.4.20 raise)
#
# ⚠ GUEST CONTRACT: cxvm runs TRUSTED bytecode — it is NOT a sandbox. The 0x70 syscall opcode
#   passes every number but 0/1/2/3/8/60/318/228 to the host kernel with the guest's raw
#   arguments, so running an untrusted .cyx == running a native binary with cxvm's privileges.
#   What cxvm DOES guarantee since 6.6.12 (the cxvm host-memory bug): a guest cannot reach the HOST's memory
#   through the VM itself. Every load/store is checked against [8, _CX_MEM_SIZE) for its full
#   width, the translated syscall buffers likewise (-EFAULT, as Linux answers), the data and
#   call stacks trap on overflow/underflow, the guest stack traps before it reaches the loaded
#   image, a negative pc traps, and an unknown opcode traps —
#   each with a `cxvm: ...` line on stderr and exit 1. docs/platform-status.md "cyrius-x guest
#   contract" is the full statement.
#
# OPCODES:
#   0x00 = halt
#   0x01 = movi   ra, imm16       ra = sign-extended imm16 (b:c as 16-bit LE)
#   0x02 = mov    ra, rb          ra = rb
#   0x10 = add    ra, rb, rc      ra = rb + rc
#   0x11 = sub    ra, rb, rc      ra = rb - rc
#   0x12 = mul    ra, rb, rc      ra = rb * rc
#   0x13 = div    ra, rb, rc      ra = rb / rc
#   0x14 = mod    ra, rb, rc      ra = rb % rc
#   0x20 = and    ra, rb, rc      ra = rb & rc
#   0x21 = or     ra, rb, rc      ra = rb | rc
#   0x22 = xor    ra, rb, rc      ra = rb ^ rc
#   0x23 = shl    ra, rb, rc      ra = rb << rc
#   0x24 = shr    ra, rb, rc      ra = rb >> rc
#   0x30 = eq     ra, rb, rc      ra = (rb == rc) ? 1 : 0
#   0x31 = ne     ra, rb, rc      ra = (rb != rc) ? 1 : 0
#   0x32 = lt     ra, rb, rc      ra = (rb < rc) ? 1 : 0
#   0x33 = gt     ra, rb, rc      ra = (rb > rc) ? 1 : 0
#   --- float (cx arc B): register bits reinterpreted as f64, host-backed ---
#   0x54 = fadd   ra, rb, rc      ra = f64(rb) + f64(rc)
#   0x55 = fsub   ra, rb, rc      ra = f64(rb) - f64(rc)
#   0x56 = fmul   ra, rb, rc      ra = f64(rb) * f64(rc)
#   0x57 = fdiv   ra, rb, rc      ra = f64(rb) / f64(rc)
#   0x58 = i2f    ra, rb          ra = f64-bits of (double)(i64)rb
#   0x59 = f2i    ra, rb          ra = (i64)(double)f64-bits(rb)
#   0x5A = flt    ra, rb, rc      ra = (f64(rb) <  f64(rc)) ? 1 : 0  (NaN-correct)
#   0x5B = fle    ra, rb, rc      ra = (f64(rb) <= f64(rc)) ? 1 : 0
#   0x5C = fgt    ra, rb, rc      ra = (f64(rb) >  f64(rc)) ? 1 : 0
#   0x5D = fge    ra, rb, rc      ra = (f64(rb) >= f64(rc)) ? 1 : 0
#   0x5E = feq    ra, rb, rc      ra = (f64(rb) == f64(rc)) ? 1 : 0
#   0x5F = fne    ra, rb, rc      ra = (f64(rb) != f64(rc)) ? 1 : 0
#   0x64 = fneg   ra, rb          ra = f64-bits of -f64(rb)
#   0x65 = fabs   ra, rb          ra = f64-bits of |f64(rb)|
#   0x66 = f32widen  ra, rb       ra = f64-bits of f32-from-bits(rb)   (cvtss2sd; v6.4.32 cx-SIMD)
#   0x67 = f32narrow ra, rb       ra = f32-bits of narrow(f64-bits rb) (cvtsd2ss; v6.4.32 cx-SIMD)
#   0x68 = fsqrt  ra, rb          ra = f64-bits of sqrt(f64(rb))       (v6.4.32 cx-SIMD; f64_sqrt 6.6.10)
#   0x6A = ffloor ra, rb          ra = f64-bits of floor(f64(rb))      (6.6.10)
#   0x6B = fceil  ra, rb          ra = f64-bits of ceil(f64(rb))       (6.6.10)
#   0x6C = fround ra, rb          ra = f64-bits of round-half-even(f64(rb)) (6.6.10)
#   0x6D = mulhu  ra, rb, rc      ra = high 64 bits of unsigned rb * rc (6.6.10)
#   0x6E = ftrunc ra, rb          ra = f64-bits of trunc(f64(rb)), toward zero (6.6.13)
#   0x40 = load8  ra, [rb]        ra = zero-extend byte at mem[rb]
#   0x41 = load64 ra, [rb]        ra = 64-bit at mem[rb]
#   0x42 = store8 [ra], rb        mem[ra] = low byte of rb
#   0x43 = store64 [ra], rb       mem[ra] = rb (64-bit)
#   0x44 = load16 ra, [rb]        ra = zero-extend halfword at mem[rb] (v5.9.40)
#   0x45 = load32 ra, [rb]        ra = zero-extend word at mem[rb] (v5.9.40)
#   0x46 = store16 [ra], rb       mem[ra] = low halfword of rb (v5.9.40)
#   0x47 = store32 [ra], rb       mem[ra] = low word of rb (v5.9.40)
#   0x50 = jmp    offset          PC += sign-extend(a:b:c as 24-bit)
#   0x51 = jz     ra, offset16    if ra == 0: PC += sign-extend(b:c)
#   0x52 = jnz    ra, offset16    if ra != 0: PC += sign-extend(b:c)
#   0x60 = call   offset24        push PC, PC += offset
#   0x61 = ret                    pop PC
#   0x62 = pushc  ra              push ra to call stack (for fp save)
#   0x63 = popc   ra              pop from call stack to ra
#   0x69 = callind ra             push PC, PC = ra (absolute code offset; v6.5.13)
#   0x70 = syscall ra             syscall(r1, r2, r3, r4, r5, r6), result in r0. ra = arg count.
#   0x80 = push   ra              push ra to stack
#   0x81 = pop    ra              pop to ra
#   0xFE = movhi  ra, imm16       ra = ra | (imm16 << 16)  (for building 32-bit constants)
#   0xFF = movhh  ra, imm16       ra = ra | (imm16 << 32)  (for building 48/64-bit constants)

include "lib/string.cyr"
include "lib/syscalls.cyr"   # v6.6.8: sys_getrandom, per host peer (see _cx_host_getrandom)
include "lib/chrono.cyr"     # v6.6.8: the host clocks (see _cx_host_clock_gettime)

# VM state — heap-allocated to avoid code buffer overflow
include "lib/alloc.cyr"

# The register file is 256 × 8 = 2048 bytes: a register operand is a full byte
# (r0..r255) and the backend's fp/sp are r253/r254. It was alloc(256) sized for
# r0-r31, so fp/sp (+2024/+2032) lived INSIDE the next allocation, _cx_mem, at
# guest offsets ~1768/1776 — every call rewrote guest data there, and a guest
# store there rewrote the stack pointer. Pass/fail tracked code size.
# CHANGELOG [6.6.8]
var _CX_REGS_BYTES = 2048;
var _cx_regs = 0;        # r0-r255 (256 × 8 = 2048 bytes)
var _cx_mem = 0;          # 1 MB data segment (_CX_MEM_SIZE; stack grows down from top)
var _cx_dstack = 0;       # _CX_STACK_ENTRIES data stack entries (expression spills, call args)
var _cx_dsp = 0;
var _cx_cstack = 0;       # _CX_STACK_ENTRIES call stack entries (return addresses + saved fp)
var _cx_csp = 0;

# Both VM stacks are host allocations with a hard bound: a push past the end or a pop below
# the bottom traps (cx_push / cx_call_push). They held 1024 entries with NO check until
# 6.6.12, so the 513th nested call (two entries per frame: the return address and the saved
# fp) wrote into the next host allocation — the loaded code — and a deep recursion ended with
# a garbage exit code instead of a diagnostic (the cxvm host-memory bug). 65536 entries (512 KiB each) makes
# the guest's own 1 MB data segment, not these arrays, the binding limit on recursion depth.
# CHANGELOG [6.6.12]
var _CX_STACK_ENTRIES = 65536;
var _cx_pc = 0;

# Data segment = code + var-data + strings + downward stack, one flat region.
# 64 KB was too small for a real cross-OS .cyx; raised to 1 MB (matches cycc's
# input_buf, main_cx.cyr:91). CHANGELOG [6.4.20]. NB: code, data AND the stack
# (grows down from _CX_MEM_SIZE) still share this one region — a program whose
# data approaches the top collides with the stack; keep large .cyx modest.
var _CX_MEM_SIZE = 1048576;
var _cx_code = 0;       # set after loading .cyx file

fn cx_init(): i64 {
    alloc_init();
    _cx_regs = alloc(_CX_REGS_BYTES); # 256 registers × 8
    _cx_mem = alloc(_CX_MEM_SIZE);    # data segment (see _CX_MEM_SIZE note)
    _cx_dstack = alloc(_CX_STACK_ENTRIES * 8);
    _cx_cstack = alloc(_CX_STACK_ENTRIES * 8);
    memset(_cx_regs, 0, _CX_REGS_BYTES);
    memset(_cx_mem, 0, _CX_MEM_SIZE);
    return 0;
}

# getrandom(buf, len, flags) for the guest, on whatever host cxvm runs on — through the
# HOST's own stdlib wrapper, never the guest's number: 318 is x86-Linux's getrandom, but it
# is unassigned on aarch64-Linux (278) and ESYSXLAT does not renumber it (measured on pi:
# ENOSYS, so the guest fell back to the clock), Windows has no getrandom syscall at all
# (ProcessPrng), and Darwin's getentropy returns 0 for success. sys_getrandom is written per
# peer for exactly that. CHANGELOG [6.6.8]
fn _cx_host_getrandom(buf, len, flags): i64 {
    return sys_getrandom(buf, len, flags);
}

# clock_gettime(clk, ts) for the guest, with the LINUX contract the .cyx ABI promises (fill
# `ts` = {sec, nsec}, return 0) on every host. The host's own syscall(228) does not keep that
# contract: arm64-macOS routes it to _clock_gettime_nsec_np and x86-macOS issues gettimeofday
# (id 0: the timeval composed to ns; any other id: mach time, since 6.6.12) — both RETURN
# nanoseconds; arm64 leaves the timespec untouched (measured on
# ecb: rc 0, tv_sec 0) while x86 writes a struct TIMEVAL into it ({sec, usec}, not
# {sec, nsec}; this note said "untouched" for both until 6.6.10) — and Windows routes it to
# GetTickCount64, milliseconds since boot. Neither Mac leaves a Linux timespec. So read
# the host clock through lib/chrono.cyr, which is written per host, and fill the timespec
# here. clk 0 (CLOCK_REALTIME) is wall time; every other id is the monotonic clock.
# CHANGELOG [6.6.8]
fn _cx_host_clock_gettime(clk, ts): i64 {
    if (ts == 0) { return 0 - 14; }   # -EFAULT, as Linux answers a null timespec
    var ns = 0;
    if (clk == 0) { ns = clock_epoch_ns(); } else { ns = clock_now_ns(); }
    store64(ts, ns / 1000000000);
    store64(ts + 8, ns % 1000000000);
    return 0;
}

fn cx_reg_get(r): i64 { return load64(_cx_regs + r * 8); }
fn cx_reg_set(r, v): i64 { store64(_cx_regs + r * 8, v); return 0; }

# ── VM traps (6.6.12, the cxvm host-memory bug) ────────────────────────────────────────────────────────────
# A guest fault is reported, never performed: `cxvm: <what> <value> at pc <N>` on stderr, exit
# 1. `pc` is the byte offset of the faulting instruction in the bytecode (after the 8-byte
# header), i.e. the same numbering `_cx_pc` and the backend's code offsets use.
var _cx_fault_pc = 0;   # pc of the instruction being executed (set by cx_run's decode)
# End of the loaded image (code + var data + strings, copied to guest [0, _cx_image_len)). The
# guest stack grows down from _CX_MEM_SIZE and may not cross it: a frame that would reach the
# image traps as a guest stack overflow rather than overwriting the program's globals and its
# heap (lib/alloc_cx.cyr's heap is a static buffer inside the var data). Set before cx_run.
var _cx_image_len = 0;

fn _cx_put(s, n): i64 { syscall(1, 2, s, n); return 0; }
fn _cx_put_dec(v): i64 {
    var b[24];
    var i = 23;
    var neg = 0;
    if (v < 0) { neg = 1; }
    if (v == 0) { store8(&b + i, 48); i = i - 1; }
    while (v != 0) {
        var d = v % 10;
        if (d < 0) { d = 0 - d; }
        store8(&b + i, 48 + d);
        i = i - 1;
        v = v / 10;
    }
    if (neg == 1) { store8(&b + i, 45); i = i - 1; }
    syscall(1, 2, &b + i + 1, 23 - i);
    return 0;
}
fn _cx_put_hex2(v): i64 {
    var b[4];
    var hi = (v >> 4) & 15;
    var lo = v & 15;
    if (hi < 10) { store8(&b, 48 + hi); } else { store8(&b, 55 + hi); }
    if (lo < 10) { store8(&b + 1, 48 + lo); } else { store8(&b + 1, 55 + lo); }
    syscall(1, 2, &b, 2);
    return 0;
}
# `what` names the fault; `v` is the offending value (an address, a depth), printed in decimal.
fn _cx_fault(what, wlen, v): i64 {
    _cx_put("cxvm: ", 6);
    _cx_put(what, wlen);
    _cx_put(" ", 1);
    _cx_put_dec(v);
    _cx_put(" at pc ", 7);
    _cx_put_dec(_cx_fault_pc);
    _cx_put("\n", 1);
    syscall(60, 1);
    return 0;
}

# Guest address -> host address for a `w`-byte access. The data segment is [0, _CX_MEM_SIZE);
# [0, 8) is refused as the null page (guest 0 is the in-memory copy of the bytecode, so a
# store through a null pointer used to succeed silently — x86 answers the same program with
# SIGSEGV). The upper test is written `a > SIZE - w` so no guest value can overflow it. Before
# 6.6.12 every load/store was `_cx_mem + reg` with no check, so a guest address past 1 MB read
# and wrote cxvm's own heap — the register file, the stacks, the loaded code (the cxvm host-memory bug).
fn _cx_addr(a, w): i64 {
    if (a < 8) { _cx_fault("guest address out of range:", 27, a); }
    if (a > _CX_MEM_SIZE - w) { _cx_fault("guest address out of range:", 27, a); }
    return _cx_mem + a;
}

# A guest BUFFER handed to a translated syscall: 0 = in range (host address in *out), else the
# -EFAULT Linux answers a bad buffer with. A null buffer stays null (the host answers EFAULT
# itself, or a zero-length write succeeds), exactly as before. `n` is the byte count.
fn _cx_sysbuf(a, n, out): i64 {
    if (a == 0) { store64(out, 0); return 0; }
    if (a < 8) { return 0 - 14; }
    if (n < 0) { return 0 - 14; }
    if (n > _CX_MEM_SIZE) { return 0 - 14; }
    if (a > _CX_MEM_SIZE - n) { return 0 - 14; }
    store64(out, _cx_mem + a);
    return 0;
}
# A NUL-terminated guest path: in range up to and including its NUL.
fn _cx_syspath(a, out): i64 {
    if (a == 0) { store64(out, 0); return 0; }
    if (a < 8) { return 0 - 14; }
    if (a >= _CX_MEM_SIZE) { return 0 - 14; }
    var i = a;
    while (i < _CX_MEM_SIZE) {
        if (load8(_cx_mem + i) == 0) { store64(out, _cx_mem + a); return 0; }
        i = i + 1;
    }
    return 0 - 14;
}

# Data stack (push/pop for expression temps)
fn cx_push(v): i64 {
    if (_cx_dsp >= _CX_STACK_ENTRIES) { _cx_fault("data stack overflow, depth", 26, _cx_dsp); }
    store64(_cx_dstack + _cx_dsp * 8, v);
    _cx_dsp = _cx_dsp + 1;
    return 0;
}
fn cx_pop(): i64 {
    if (_cx_dsp <= 0) { _cx_fault("data stack underflow, depth", 27, _cx_dsp); }
    _cx_dsp = _cx_dsp - 1;
    return load64(_cx_dstack + _cx_dsp * 8);
}

# Call stack (call/ret for return addresses)
fn cx_call_push(v): i64 {
    if (_cx_csp >= _CX_STACK_ENTRIES) { _cx_fault("call stack overflow, depth", 26, _cx_csp); }
    store64(_cx_cstack + _cx_csp * 8, v);
    _cx_csp = _cx_csp + 1;
    return 0;
}
fn cx_call_pop(): i64 {
    if (_cx_csp <= 0) { _cx_fault("call stack underflow, depth", 27, _cx_csp); }
    _cx_csp = _cx_csp - 1;
    return load64(_cx_cstack + _cx_csp * 8);
}

fn cx_run(code, code_len): i64 {
    _cx_pc = 0;
    var running = 1;
    while (running == 1) {
        if (_cx_pc >= code_len) { running = 0; break; }
        # A negative pc would decode the host memory in front of the code. CHANGELOG [6.6.12]
        if (_cx_pc < 0) { _cx_fault("jump to a negative code offset:", 31, _cx_pc); }
        _cx_fault_pc = _cx_pc;
        # Decode 4-byte instruction (little-endian)
        var b0 = load8(code + _cx_pc);
        var b1 = load8(code + _cx_pc + 1);
        var b2 = load8(code + _cx_pc + 2);
        var b3 = load8(code + _cx_pc + 3);
        var op = b0;
        var ra = b1;
        var rb = b2;
        var rc = b3;
        _cx_pc = _cx_pc + 4;
        var off = 0;
        var imm = 0;
        var result = 0;

        # halt
        if (op == 0) { running = 0; }

        # movi ra, imm16
        elif (op == 1) { cx_reg_set(ra, rb | (rc << 8)); }

        # mov ra, rb
        elif (op == 2) { cx_reg_set(ra, cx_reg_get(rb)); }

        # arithmetic: add, sub, mul, div, mod
        elif (op == 16) { cx_reg_set(ra, cx_reg_get(rb) + cx_reg_get(rc)); }
        elif (op == 17) {
            cx_reg_set(ra, cx_reg_get(rb) - cx_reg_get(rc));
            # `sub sp, sp, n` is how a frame is reserved (backend/cx/emit.cyr ESUBRSP, the only
            # emitter that grows r254). CHANGELOG [6.6.12]
            if (ra == 254) {
                if (cx_reg_get(254) < _cx_image_len) { _cx_fault("guest stack overflow, sp", 24, cx_reg_get(254)); }
            }
        }
        elif (op == 18) { cx_reg_set(ra, cx_reg_get(rb) * cx_reg_get(rc)); }
        elif (op == 19) { cx_reg_set(ra, cx_reg_get(rb) / cx_reg_get(rc)); }
        elif (op == 20) { cx_reg_set(ra, cx_reg_get(rb) % cx_reg_get(rc)); }

        # bitwise: and, or, xor, shl, shr
        elif (op == 32) { cx_reg_set(ra, cx_reg_get(rb) & cx_reg_get(rc)); }
        elif (op == 33) { cx_reg_set(ra, cx_reg_get(rb) | cx_reg_get(rc)); }
        elif (op == 34) { cx_reg_set(ra, cx_reg_get(rb) ^ cx_reg_get(rc)); }
        elif (op == 35) { cx_reg_set(ra, cx_reg_get(rb) << cx_reg_get(rc)); }
        elif (op == 36) { cx_reg_set(ra, cx_reg_get(rb) >> cx_reg_get(rc)); }
        elif (op == 37) {
            var _av = cx_reg_get(rb); var _ac = cx_reg_get(rc);
            if (_av >= 0) { cx_reg_set(ra, _av >> _ac); }
            else { cx_reg_set(ra, 0 - (((0 - _av) + (1 << _ac) - 1) >> _ac)); }
        }

        # compare: eq, ne, lt, gt
        elif (op == 48) { if (cx_reg_get(rb) == cx_reg_get(rc)) { cx_reg_set(ra, 1); } else { cx_reg_set(ra, 0); } }
        elif (op == 49) { if (cx_reg_get(rb) != cx_reg_get(rc)) { cx_reg_set(ra, 1); } else { cx_reg_set(ra, 0); } }
        elif (op == 50) { if (cx_reg_get(rb) < cx_reg_get(rc)) { cx_reg_set(ra, 1); } else { cx_reg_set(ra, 0); } }
        elif (op == 51) { if (cx_reg_get(rb) > cx_reg_get(rc)) { cx_reg_set(ra, 1); } else { cx_reg_set(ra, 0); } }

        # float (cx arc B): the i64 register bits ARE the f64 bit pattern, and the
        # f64_* builtins operate on bit patterns — so cxvm float is host-backed
        # (the host's native SSE/NEON f64, NaN-correct for the compares). fadd/fsub/
        # fmul/fdiv (0x54-57), i2f/f2i (0x58/59), flt/fle/fgt/fge/feq/fne (0x5A-5F).
        elif (op == 84) { cx_reg_set(ra, f64_add(cx_reg_get(rb), cx_reg_get(rc))); }
        elif (op == 85) { cx_reg_set(ra, f64_sub(cx_reg_get(rb), cx_reg_get(rc))); }
        elif (op == 86) { cx_reg_set(ra, f64_mul(cx_reg_get(rb), cx_reg_get(rc))); }
        elif (op == 87) { cx_reg_set(ra, f64_div(cx_reg_get(rb), cx_reg_get(rc))); }
        elif (op == 88) { cx_reg_set(ra, f64_from(cx_reg_get(rb))); }
        elif (op == 89) { cx_reg_set(ra, f64_to(cx_reg_get(rb))); }
        elif (op == 90) { cx_reg_set(ra, f64_lt(cx_reg_get(rb), cx_reg_get(rc))); }
        elif (op == 91) { var _le = 0; if (f64_lt(cx_reg_get(rb), cx_reg_get(rc)) == 1) { _le = 1; } if (f64_eq(cx_reg_get(rb), cx_reg_get(rc)) == 1) { _le = 1; } cx_reg_set(ra, _le); }
        elif (op == 92) { cx_reg_set(ra, f64_gt(cx_reg_get(rb), cx_reg_get(rc))); }
        elif (op == 93) { var _ge = 0; if (f64_gt(cx_reg_get(rb), cx_reg_get(rc)) == 1) { _ge = 1; } if (f64_eq(cx_reg_get(rb), cx_reg_get(rc)) == 1) { _ge = 1; } cx_reg_set(ra, _ge); }
        elif (op == 94) { cx_reg_set(ra, f64_eq(cx_reg_get(rb), cx_reg_get(rc))); }
        elif (op == 95) { if (f64_eq(cx_reg_get(rb), cx_reg_get(rc)) == 0) { cx_reg_set(ra, 1); } else { cx_reg_set(ra, 0); } }
        elif (op == 100) { cx_reg_set(ra, f64_neg(cx_reg_get(rb))); }   # 0x64 fneg
        elif (op == 101) { cx_reg_set(ra, f64_abs(cx_reg_get(rb))); }   # 0x65 fabs
        # v6.4.32 cx-SIMD: f32<->f64 (host cvtss2sd/cvtsd2ss) + sqrt, host-backed
        # like the f64 ops. f32widen: f32 bit pattern (low 32 of rb) -> f64 bits.
        # f32narrow: f64 bits -> f32 bit pattern (low 32). These let the scalar
        # per-lane f32 SIMD loops compute in f64 and round once per op (bit-exact
        # vs x86 addps/mulps). fsqrt backs f64v_sqrt (no packed sqrt on a scalar VM).
        elif (op == 102) { cx_reg_set(ra, f32_to(cx_reg_get(rb))); }    # 0x66 f32widen  (cvtss2sd)
        elif (op == 103) { cx_reg_set(ra, f32_from(cx_reg_get(rb))); }  # 0x67 f32narrow (cvtsd2ss)
        elif (op == 104) { cx_reg_set(ra, f64_sqrt(cx_reg_get(rb))); }  # 0x68 fsqrt
        # 6.6.10: the rest of the f64 unary builtins and mulh64, host-backed. The backend
        # emitted NOTHING for them before, so the operand came back unchanged, silently.
        elif (op == 106) { cx_reg_set(ra, f64_floor(cx_reg_get(rb))); } # 0x6A ffloor
        elif (op == 107) { cx_reg_set(ra, f64_ceil(cx_reg_get(rb))); }  # 0x6B fceil
        elif (op == 108) { cx_reg_set(ra, f64_round(cx_reg_get(rb))); } # 0x6C fround (ties to even)
        elif (op == 109) { cx_reg_set(ra, mulh64(cx_reg_get(rb), cx_reg_get(rc))); } # 0x6D mulhu
        elif (op == 110) { cx_reg_set(ra, f64_trunc(cx_reg_get(rb))); } # 0x6E ftrunc (6.6.13)

        # memory: load8/16/32/64, store8/16/32/64. Every guest address goes through _cx_addr,
        # which traps unless the WHOLE access lies in [8, _CX_MEM_SIZE). CHANGELOG [6.6.12]
        elif (op == 64) { cx_reg_set(ra, load8(_cx_addr(cx_reg_get(rb), 1))); }
        elif (op == 65) { cx_reg_set(ra, load64(_cx_addr(cx_reg_get(rb), 8))); }
        elif (op == 66) { store8(_cx_addr(cx_reg_get(ra), 1), cx_reg_get(rb) & 0xFF); }
        elif (op == 67) { store64(_cx_addr(cx_reg_get(ra), 8), cx_reg_get(rb)); }
        # v5.9.40 — sub-8-byte struct field load (parse_decl.cyr)
        # closes Phase 2c #2: cyrius core has only load8/load64
        # primitives, so wider loads compose from byte loads.
        elif (op == 68) {
            var l16_addr = _cx_addr(cx_reg_get(rb), 2);
            cx_reg_set(ra, load8(l16_addr) | (load8(l16_addr + 1) << 8));
        }
        elif (op == 69) {
            var l32_addr = _cx_addr(cx_reg_get(rb), 4);
            cx_reg_set(ra,
                load8(l32_addr)
                | (load8(l32_addr + 1) << 8)
                | (load8(l32_addr + 2) << 16)
                | (load8(l32_addr + 3) << 24));
        }
        elif (op == 70) {
            var s16_addr = _cx_addr(cx_reg_get(ra), 2);
            var s16_v = cx_reg_get(rb);
            store8(s16_addr,     s16_v & 0xFF);
            store8(s16_addr + 1, (s16_v >> 8) & 0xFF);
        }
        elif (op == 71) {
            var s32_addr = _cx_addr(cx_reg_get(ra), 4);
            var s32_v = cx_reg_get(rb);
            store8(s32_addr,     s32_v & 0xFF);
            store8(s32_addr + 1, (s32_v >> 8) & 0xFF);
            store8(s32_addr + 2, (s32_v >> 16) & 0xFF);
            store8(s32_addr + 3, (s32_v >> 24) & 0xFF);
        }

        # jump: jmp, jz, jnz
        elif (op == 80) {
            off = ra | (rb << 8) | (rc << 16);
            if (off > 0x7FFFFF) { off = off - 0x1000000; }
            _cx_pc = _cx_pc - 4 + off * 4;
        }
        elif (op == 81) {
            if (cx_reg_get(ra) == 0) {
                off = rb | (rc << 8);
                if (off > 0x7FFF) { off = off - 0x10000; }
                _cx_pc = _cx_pc - 4 + off * 4;
            }
        }
        elif (op == 82) {
            if (cx_reg_get(ra) != 0) {
                off = rb | (rc << 8);
                if (off > 0x7FFF) { off = off - 0x10000; }
                _cx_pc = _cx_pc - 4 + off * 4;
            }
        }

        # call/ret
        elif (op == 96) {
            cx_call_push(_cx_pc);
            off = ra | (rb << 8) | (rc << 16);
            if (off > 0x7FFFFF) { off = off - 0x1000000; }
            _cx_pc = _cx_pc - 4 + off * 4;
        }
        elif (op == 97) { _cx_pc = cx_call_pop(); }
        # pushc/popc: save/restore register to/from call stack
        elif (op == 0x62) { cx_call_push(cx_reg_get(ra)); }
        elif (op == 0x63) { cx_reg_set(ra, cx_call_pop()); }
        # v6.5.13 — callind ra (0x69 = 105): indirect call through the CODE OFFSET in ra.
        # PERMANENT opcode; see backend/cx/emit.cyr:ECALLIND for the encoding rationale.
        # Unlike op 96 (call) this is ABSOLUTE — the register holds `_fnt_offsets[idx]`,
        # already in `_cx_pc`'s numbering. A non-positive target means an unresolved fn
        # pointer: trap, rather than jump to offset 0 and silently restart the program,
        # which is precisely the defect v6.5.12 fixed on the compile side.
        elif (op == 0x69) {
            if (cx_reg_get(ra) <= 0) {
                syscall(1, 2, "cxvm: callind through a null/unresolved fn pointer\n", 51);
                syscall(60, 1);
            }
            cx_call_push(_cx_pc);
            _cx_pc = cx_reg_get(ra);
        }

        # syscall: r0 = syscall(r1, r2, r3, r4, r5, r6)
        # r1=syscall number. Pointer args need virtual→real translation.
        # Only translate args that are actually pointers (syscall-specific).
        elif (op == 112) {
            var sn = cx_reg_get(1);
            var s2 = cx_reg_get(2);
            var s3 = cx_reg_get(3);
            var s4 = cx_reg_get(4);
            var s5 = cx_reg_get(5);
            var s6 = cx_reg_get(6);
            # --- pointer-arg fixup: a guest passes .cyx-virtual offsets, but the
            # host kernel needs REAL addresses. Translate ONLY the register(s) a
            # given syscall treats as a pointer (scalar fd/len/flags/whence must
            # NOT be shifted). Keyed on the GUEST x86-Linux number `sn` BEFORE the
            # compiler renumbers it per-host (ESYSXLAT/EMACHO/PE-dynamic act on the
            # emitted syscall below). Linux ABI arg order → s2=arg0, s3=arg1, ...
            #   read(0)/write(1)  = (fd, buf, count)   → buf   is arg1 = s3
            #   open(2)           = (path, flags, mode)→ path  is arg0 = s2
            # CHANGELOG [6.4.20]: open fixed s3 (=flags) instead of s2 (=path) —
            # every guest open() corrupted flags and passed a raw offset as path
            # (EFAULT on all hosts). Other pointer-taking syscalls (nanosleep 35,
            # pipe 22, stat) need their own entry when a consumer .cyx uses them.
            #   getrandom(318)     = (buf, len, flags)  → buf is arg0 = s2
            #   clock_gettime(228) = (clk, ts)          → ts  is arg1 = s3
            # v6.6.8: both passed a raw guest offset, so the host answered EFAULT —
            # lib/hashseed.cyr is the stdlib's only caller of either on cx, and
            # its OS-RNG draw AND its clock fallback both failed, leaving every
            # cx process on the same published seed. CHANGELOG [6.6.8]
            # 6.6.12 (the cxvm host-memory bug): each buffer is range-checked for its FULL length before it is
            # translated — `read(fd, buf, n)` with buf + n past 1 MB had the host kernel write
            # cxvm's own heap. An out-of-range buffer answers -EFAULT without reaching the host,
            # which is what Linux answers a bad pointer with. CHANGELOG [6.6.12]
            var sfault = 0;
            var sx[1];
            if (sn == 0 || sn == 1) { sfault = _cx_sysbuf(s3, s4, &sx); s3 = load64(&sx); }
            elif (sn == 2) { sfault = _cx_syspath(s2, &sx); s2 = load64(&sx); }
            elif (sn == 318) { sfault = _cx_sysbuf(s2, s3, &sx); s2 = load64(&sx); }
            elif (sn == 228) { sfault = _cx_sysbuf(s3, 16, &sx); s3 = load64(&sx); }
            # --- arity-correct dispatch: issue the syscall with the guest's REAL
            # Linux arg-count so the PE arity-bucket router (EPE_SYSCALL_DYNAMIC:
            # argc4→read/write/open/lseek, argc2→close/exit) matches. cxvm's old
            # fixed 5-trailing-arg shape was argc 6 — an arity NO PE bucket routes,
            # so on Windows every guest write/read/open/close/exit returned -ENOSYS
            # and did nothing (cass exit=-38, no output). Linux/macOS ignore extra
            # args, so exact-arity is equally correct there — one dispatch, 4 hosts.
            # The `else` passes 5 args (argc 6): fine on Linux/macOS (extra ignored),
            # honest -ENOSYS on PE (the compile-time warning is expected). 6-arg
            # syscalls (mmap) aren't supported — cxvm captures only r2..r6.
            # CHANGELOG [6.4.20].
            # getrandom and clock_gettime are served by the host's stdlib (see
            # _cx_host_getrandom / _cx_host_clock_gettime) — the host's raw syscall does
            # not keep the guest's Linux contract on every host (v6.6.8).
            if (sfault != 0) { result = sfault; }
            elif (sn == 318) { result = _cx_host_getrandom(s2, s3, s4); }
            elif (sn == 0 || sn == 1 || sn == 2 || sn == 8) { result = syscall(sn, s2, s3, s4); }
            elif (sn == 228) { result = _cx_host_clock_gettime(s2, s3); }
            elif (sn == 3 || sn == 60) { result = syscall(sn, s2); }
            else { result = syscall(sn, s2, s3, s4, s5, s6); }
            cx_reg_set(0, result);
        }

        # push/pop
        elif (op == 128) { cx_push(cx_reg_get(ra)); }
        elif (op == 129) { cx_reg_set(ra, cx_pop()); }

        # movhi: ra = ra | (imm16 << 16)
        elif (op == 254) {
            imm = rb | (rc << 8);
            cx_reg_set(ra, cx_reg_get(ra) | (imm << 16));
        }
        # movhh: ra = ra | (imm16 << 32)
        elif (op == 255) {
            imm = rb | (rc << 8);
            cx_reg_set(ra, cx_reg_get(ra) | (imm << 32));
        }
        # movhk: ra = ra | (imm16 << 48) — top 16 bits (v6.4.58; full 64-bit constant loads)
        elif (op == 253) {
            imm = rb | (rc << 8);
            cx_reg_set(ra, cx_reg_get(ra) | (imm << 48));
        }
        # An opcode this cxvm does not implement is a fault, not a no-op. The chain had no
        # trailing arm until 6.6.12, so an older cxvm ran 6.6.10's 0x6A-0x6D as identity and
        # a corrupt .cyx ran on silently. CHANGELOG [6.6.12]
        else {
            _cx_put("cxvm: unknown opcode 0x", 23);
            _cx_put_hex2(op);
            _cx_put(" at pc ", 7);
            _cx_put_dec(_cx_fault_pc);
            _cx_put("\n", 1);
            syscall(60, 1);
        }
    }

    return cx_reg_get(0);
}

# ================================================================
# MAIN: read bytecode from stdin, run it
# ================================================================

# Initialize VM
cx_init();

# Read .cyx header: "CYX\0" magic + 4-byte entry offset
# 64 KB → 1 MB (CHANGELOG [6.4.20]). The read loop now probes for overflow
# instead of SILENTLY TRUNCATING a >cap .cyx (which mis-executed) — mirrors
# main_cx.cyr:95-101's input-buffer probe.
var _cx_code_cap = 1048576;
_cx_code = alloc(_cx_code_cap);
var _cx_code_len = 0;
var _cx_done = 0;
while (_cx_done == 0) {
    var n = syscall(0, 0, _cx_code + _cx_code_len, _cx_code_cap - _cx_code_len);
    if (n <= 0) { _cx_done = 1; }
    else {
        _cx_code_len = _cx_code_len + n;
        if (_cx_code_len >= _cx_code_cap) {
            var _cx_probe[1];
            var pn = syscall(0, 0, &_cx_probe, 1);
            if (pn > 0) {
                syscall(1, 2, "error: .cyx exceeds 1MB cxvm code buffer\n", 41);
                syscall(60, 1);
            }
            _cx_done = 1;
        }
    }
}

# Check magic "CYX" + format version (byte 3). cx arc A: byte 3 is the .cyx
# format version — reject a version this cxvm doesn't understand rather than
# mis-execute it. CYX_VERSION must match main_cx.cyr's writer.
if (_cx_code_len < 8) { syscall(1, 2, "error: not a .cyx file\n", 23); syscall(60, 1); }
if (load8(_cx_code) != 67) { syscall(1, 2, "error: bad magic\n", 17); syscall(60, 1); }
if (load8(_cx_code + 1) != 89) { syscall(1, 2, "error: bad magic\n", 17); syscall(60, 1); }
if (load8(_cx_code + 2) != 88) { syscall(1, 2, "error: bad magic\n", 17); syscall(60, 1); }
if (load8(_cx_code + 3) != 1) { syscall(1, 2, "error: unsupported .cyx format version\n", 39); syscall(60, 1); }

# Entry offset (4 bytes LE at offset 4)
var entry = load32(_cx_code + 4);

# Copy data section (vars + strings) from .cyx into _cx_mem.
# The cx compiler sets data addresses as offsets from bytecode start:
#   var addr = code_size + cumulative_var_offset
#   str addr = code_size + total_var_size + string_offset
# By copying the data section into _cx_mem at offset code_size,
# all load/store operations find the correct data.
var data_start = 8 + _cx_code_len - 8;  # header-adjusted
var bytecode_and_data = _cx_code_len - 8;
# We don't know exactly where code ends and data begins in the .cyx,
# but the entire content after the header is: bytecode + var_data + string_data.
# Copy ALL of it into _cx_mem so any offset works as a memory address.
var copy_len = bytecode_and_data;
if (copy_len > _CX_MEM_SIZE) { copy_len = _CX_MEM_SIZE; }
_cx_image_len = copy_len;
var ci = 0;
while (ci < copy_len) {
    store8(_cx_mem + ci, load8(_cx_code + 8 + ci));
    ci = ci + 1;
}

# Initialize sp (r254) to top of memory — stack grows downward
cx_reg_set(254, _CX_MEM_SIZE);
# Initialize fp (r253) to same
cx_reg_set(253, _CX_MEM_SIZE);

# Run from entry point
_cx_pc = entry;
var exit_code = cx_run(_cx_code + 8, _cx_code_len - 8);
syscall(60, exit_code);
