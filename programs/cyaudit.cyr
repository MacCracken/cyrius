# cyaudit — Cyrius Check (dependency audit + policy enforcement)
# Usage: cyaudit vet <file> | cyaudit deny <file>

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/args.cyr"

# 1 iff the include path has a `..` COMPONENT anywhere — split on `/` and `\`. The trust
# test and the traversal test below were both PREFIX tests, so `lib/../../etc/x.cyr` was
# "trusted" by vet and passed deny, which only looked for a LEADING `..`. CHANGELOG [6.6.8]
fn _has_dotdot(path): i64 {
    var i = 0;
    var cs = 0;
    while (1 == 1) {
        var c = load8(path + i);
        if (c == 0 || c == 47 || c == 92) {
            if (i - cs == 2) { if (load8(path + cs) == 46) { if (load8(path + cs + 1) == 46) { return 1; } } }
            if (c == 0) { return 0; }
            cs = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

# 1 iff the include path is absolute: `/x`, `\x`, or a drive letter `C:`. CHANGELOG [6.6.8]
fn _is_abs(path): i64 {
    var c = load8(path);
    if (c == 47 || c == 92) { return 1; }
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { if (load8(path + 1) == 58) { return 1; } }
    return 0;
}

fn is_trusted(path): i64 {
    if (_has_dotdot(path) == 1) { return 0; }
    if (memeq(path, "lib/", 4) == 1) { return 1; }
    if (memeq(path, "src/", 4) == 1) { return 1; }
    if (memeq(path, "programs/", 9) == 1) { return 1; }
    if (memeq(path, "cbt/", 4) == 1) { return 1; }
    if (memeq(path, "kernel/", 7) == 1) { return 1; }
    return 0;
}

# The preprocessor's lexical state after byte `c` in state `st` — a copy of PP_LEXST
# (src/frontend/lex_pp.cyr): 0 code, 1 string, 2 after `\` in a string, 3 `#` comment,
# 4 char literal, 5 after `\` in a char literal.
fn _au_lexst(st, c): i64 {
    if (st == 2) { return 1; }
    if (st == 5) { if (c == 10) { return 0; } return 4; }
    if (st == 1) {
        if (c == 92) { return 2; }
        if (c == 34) { return 0; }
        return 1;
    }
    if (st == 3) { if (c == 10) { return 0; } return 3; }
    if (st == 4) {
        if (c == 92) { return 5; }
        if (c == 10) { return 0; }
        if (c == 39) { return 0; }
        return 4;
    }
    if (c == 35) { return 3; }
    if (c == 34) { return 1; }
    if (c == 39) { return 4; }
    return 0;
}

# Collect every `include "…"` DIRECTIVE of the file into `inc`. Returns the count, or -1 when
# the file cannot be read.
# ⛔ 6.6.8 — the compiler's rule, not a substring search. An include is a directive only in
# COLUMN 0 (ISINCLUDE; an indented `include` is an expression) and only outside a string
# literal (PP_PASS gates on the PP_LEXST string state), and its line is consumed whole. This
# matched `include "` at ANY offset of a fixed 256 KB read, so a COMMENT naming a removed
# include made `vet` report it MISSING and `deny` report a traversal (rc 1), and a real
# include past byte 262,144 was invisible to both (`no dependencies` / `0 violations`, rc 0).
# The file is now read whole (file_read_whole). CHANGELOG [6.6.8]
fn scan_includes(fp, inc): i64 {
    var lr[1];
    var buf = file_read_whole(fp, &lr);
    if (buf == 0) { return 0 - 1; }
    var n = load64(&lr);
    var si = 0;
    var st = 0;
    var bol = 1;
    while (si < n) {
        if (bol == 1 && st == 0 && si + 9 <= n) {
            if (memeq(buf + si, "include \"", 9) == 1) {
                var ps = si + 9;
                var pe = ps;
                while (pe < n) {
                    var fc = load8(buf + pe);
                    if (fc == 34 || fc == 10) { break; }
                    pe = pe + 1;
                }
                var pl = pe - ps;
                if (pl > 0) {
                    var pa = alloc(pl + 1);
                    memcpy(pa, buf + ps, pl);
                    store8(pa + pl, 0);
                    vec_push(inc, pa);
                }
                # The directive consumes its whole line, as PP_PASS does.
                while (pe < n) { if (load8(buf + pe) == 10) { break; } pe = pe + 1; }
                si = pe;
                continue;
            }
        }
        var c = load8(buf + si);
        st = _au_lexst(st, c);
        bol = 0;
        if (c == 10) { bol = 1; }
        si = si + 1;
    }
    return vec_len(inc);
}

# A file that exists but cannot be read is an error, never "no dependencies".
fn _au_unreadable(fp): i64 {
    sys_write(STDERR_FD, "cyaudit: cannot read file: ", 27);
    sys_write(STDERR_FD, fp, strlen(fp));
    sys_write(STDERR_FD, "\n", 1);
    return 1;
}

fn cmd_vet(fp): i64 {
    println("=== cyaudit vet ===");
    # v6.6.5 — CHECK THE FILE FIRST. `cyaudit vet /nonexistent.cyr` printed
    # "scanning: … / no dependencies" and exited 0 — a clean bill of health for a
    # file that was never opened. `cmd_deny` already did this check; vet did not.
    if (file_exists(fp) == 0) {
        sys_write(STDERR_FD, "cyaudit: cannot read file: ", 27);
        sys_write(STDERR_FD, fp, strlen(fp));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    sys_write(STDOUT_FD, "scanning: ", 10);
    sys_write(STDOUT_FD, fp, strlen(fp));
    sys_write(STDOUT_FD, "\n", 1);
    var inc = vec_new();
    if (scan_includes(fp, inc) < 0) { return _au_unreadable(fp); }
    var len = vec_len(inc);
    if (len == 0) { println("  no dependencies"); return 0; }
    var untrusted = 0;
    var missing = 0;
    var vi = 0;
    while (vi < len) {
        var ip = vec_get(inc, vi);
        var ex = file_exists(ip);
        var tr = is_trusted(ip);
        syscall(1, 1, "  ", 2);
        if (ex == 0) { syscall(1, 1, "MISSING  ", 9); missing = missing + 1; }
        if (ex == 1) { if (tr == 0) { syscall(1, 1, "UNTRUST  ", 9); untrusted = untrusted + 1; } }
        if (ex == 1) { if (tr == 1) { syscall(1, 1, "OK       ", 9); } }
        syscall(1, 1, ip, strlen(ip));
        syscall(1, 1, "\n", 1);
        vi = vi + 1;
    }
    syscall(1, 1, "\n", 1);
    fmt_int(len);
    syscall(1, 1, " deps, ", 7);
    fmt_int(untrusted);
    syscall(1, 1, " untrusted, ", 12);
    fmt_int(missing);
    syscall(1, 1, " missing\n", 9);
    if (untrusted > 0) { return 1; }
    if (missing > 0) { return 1; }
    return 0;
}

fn cmd_deny(fp): i64 {
    println("=== cyaudit deny ===");
    var inc = vec_new();
    var sn = 0;
    if (file_exists(fp) == 1) { sn = scan_includes(fp, inc); }
    if (sn < 0) { return _au_unreadable(fp); }
    var len = vec_len(inc);
    var violations = 0;
    var di = 0;
    while (di < len) {
        var dp = vec_get(inc, di);
        if (_is_abs(dp) == 1) {
            syscall(1, 2, "  DENY: absolute path: ", 23);
            syscall(1, 2, dp, strlen(dp));
            syscall(1, 2, "\n", 1);
            violations = violations + 1;
        }
        if (_has_dotdot(dp) == 1) {
            syscall(1, 2, "  DENY: parent traversal: ", 26);
            syscall(1, 2, dp, strlen(dp));
            syscall(1, 2, "\n", 1);
            violations = violations + 1;
        }
        di = di + 1;
    }
    if (file_exists(fp) == 0) {
        syscall(1, 2, "  DENY: source not found\n", 25);
        violations = violations + 1;
    }
    if (violations == 0) {
        fmt_int(len);
        syscall(1, 1, " deps, 0 violations\n", 20);
    } else {
        fmt_int(violations);
        syscall(1, 2, " violation(s)\n", 14);
    }
    # CLAMP (v6.6.5, round-3 review): an exit status is 8 bits, so 256 violations exited
    # 0 — a clean verdict for a file with 256 policy breaches. Same wrap cyrlint and
    # cyrdoc were clamped for in this release.
    if (violations > 255) { return 255; }
    return violations;
}

fn main(): i64 {
    alloc_init();
    args_init();
    if (argc() < 3) {
        println("cyaudit — Cyrius Check");
        println("  cyaudit vet <file>  — audit dependencies");
        println("  cyaudit deny <file> — enforce policies");
        # Only an explicit help request is a success. `cyaudit vet` with no file used to
        # print this and exit 0, i.e. a CI step that lost its operand passed (v6.6.5,
        # round-3 review).
        if (argc() == 2) {
            if (streq(argv(1), "--help") == 1 || streq(argv(1), "-h") == 1) { return 0; }
        }
        sys_write(STDERR_FD, "cyaudit: missing required argument <file>\n", 42);
        return 1;
    }
    # v6.6.5 — exactly `vet|deny <file>`. Extra operands and any '-' token used to
    # be ignored, so `cyaudit vet f --x` and `cyaudit vet a b` both reported on `a`
    # alone and exited 0.
    var cmd = argv(1);
    if (streq(cmd, "vet") == 0 && streq(cmd, "deny") == 0) {
        sys_write(STDERR_FD, "cyaudit: unknown command '", 26);
        sys_write(STDERR_FD, cmd, strlen(cmd));
        sys_write(STDERR_FD, "'\n", 2);
        return 1;
    }
    # A '-' token is named as an OPTION wherever it sits, before the count — so
    # `cyaudit vet f --x` reports the flag, not "extra argument".
    var oi = 2;
    while (oi < argc()) {
        if (load8(argv(oi)) == 45) {
            sys_write(STDERR_FD, "cyaudit: unknown option '", 25);
            sys_write(STDERR_FD, argv(oi), strlen(argv(oi)));
            sys_write(STDERR_FD, "'\n", 2);
            return 1;
        }
        oi = oi + 1;
    }
    if (argc() > 3) {
        var xmsg = "cyaudit: unexpected extra argument '";
        sys_write(STDERR_FD, xmsg, strlen(xmsg));
        sys_write(STDERR_FD, argv(3), strlen(argv(3)));
        sys_write(STDERR_FD, "'\n", 2);
        return 1;
    }
    if (streq(cmd, "vet") == 1) { return cmd_vet(argv(2)); }
    return cmd_deny(argv(2));
}
var r = main();
syscall(60, r);
