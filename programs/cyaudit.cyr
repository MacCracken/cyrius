# cyaudit — Cyrius Check (dependency audit + policy enforcement)
# Usage: cyaudit vet <file> | cyaudit deny <file>

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/args.cyr"

# Pattern built at runtime (preprocessor eats the literal form)
var _pat[2];
fn _init_pat(): i64 {
    store8(&_pat, 105); store8(&_pat + 1, 110); store8(&_pat + 2, 99);
    store8(&_pat + 3, 108); store8(&_pat + 4, 117); store8(&_pat + 5, 100);
    store8(&_pat + 6, 101); store8(&_pat + 7, 32); store8(&_pat + 8, 34);
    return 0;
}

fn is_trusted(path): i64 {
    if (memeq(path, "lib/", 4) == 1) { return 1; }
    if (memeq(path, "src/", 4) == 1) { return 1; }
    if (memeq(path, "programs/", 9) == 1) { return 1; }
    if (memeq(path, "cbt/", 4) == 1) { return 1; }
    if (memeq(path, "kernel/", 7) == 1) { return 1; }
    return 0;
}

fn scan_includes(fp, inc): i64 {
    _init_pat();
    # v5.11.45: cap raised 16384 → 262144 to match _parse_drift_scan
    # in programs/checks/lint_fmt.cyr; src/main.cyr alone is 86 KB and was
    # being scanned truncated, returning "no dependencies" falsely.
    var cap = 262144;
    var buf = alloc(cap);
    var n = file_read_all(fp, buf, cap);
    if (n <= 0) { return 0; }
    var si = 0;
    var ps = 0;
    var pe = 0;
    var pl = 0;
    var pa = 0;
    while (si < n - 10) {
        if (memeq(buf + si, &_pat, 9) == 1) {
            ps = si + 9;
            pe = ps;
            while (pe < n) { if (load8(buf + pe) == 34) { break; } pe = pe + 1; }
            pl = pe - ps;
            if (pl > 0) {
                pa = alloc(pl + 1);
                memcpy(pa, buf + ps, pl);
                store8(pa + pl, 0);
                vec_push(inc, pa);
            }
        }
        si = si + 1;
    }
    return vec_len(inc);
}

fn cmd_vet(fp): i64 {
    println("=== cyaudit vet ===");
    # v6.6.5 — CHECK THE FILE FIRST. `cyaudit vet /nonexistent.cyr` printed
    # "scanning: … / no dependencies" and exited 0 — a clean bill of health for a
    # file that was never opened. `cmd_deny` already did this check; vet did not.
    if (file_exists(fp) == 0) {
        sys_write(STDERR_FD, "cyaudit: cannot read file: ", 27);
        sys_write(STDERR_FD, fp, strlen(fp));
        sys_write(STDERR_FD, "\n", 1);
        return 1;
    }
    sys_write(STDOUT_FD, "scanning: ", 10);
    sys_write(STDOUT_FD, fp, strlen(fp));
    sys_write(STDOUT_FD, "\n", 1);
    var inc = vec_new();
    scan_includes(fp, inc);
    var len = vec_len(inc);
    if (len == 0) { println("  no dependencies"); return 0; }
    var untrusted = 0;
    var missing = 0;
    var vi = 0;
    while (vi < len) {
        var ip = vec_get(inc, vi);
        var ex = file_exists(ip);
        var tr = is_trusted(ip);
        syscall(1, 1, "  ", 2);
        if (ex == 0) { syscall(1, 1, "MISSING  ", 9); missing = missing + 1; }
        if (ex == 1) { if (tr == 0) { syscall(1, 1, "UNTRUST  ", 9); untrusted = untrusted + 1; } }
        if (ex == 1) { if (tr == 1) { syscall(1, 1, "OK       ", 9); } }
        syscall(1, 1, ip, strlen(ip));
        syscall(1, 1, "\n", 1);
        vi = vi + 1;
    }
    syscall(1, 1, "\n", 1);
    fmt_int(len);
    syscall(1, 1, " deps, ", 7);
    fmt_int(untrusted);
    syscall(1, 1, " untrusted, ", 12);
    fmt_int(missing);
    syscall(1, 1, " missing\n", 9);
    if (untrusted > 0) { return 1; }
    if (missing > 0) { return 1; }
    return 0;
}

fn cmd_deny(fp): i64 {
    println("=== cyaudit deny ===");
    var inc = vec_new();
    scan_includes(fp, inc);
    var len = vec_len(inc);
    var violations = 0;
    var di = 0;
    while (di < len) {
        var dp = vec_get(inc, di);
        if (load8(dp) == 47) {
            syscall(1, 2, "  DENY: absolute path: ", 23);
            syscall(1, 2, dp, strlen(dp));
            syscall(1, 2, "\n", 1);
            violations = violations + 1;
        }
        if (memeq(dp, "..", 2) == 1) {
            syscall(1, 2, "  DENY: parent traversal: ", 26);
            syscall(1, 2, dp, strlen(dp));
            syscall(1, 2, "\n", 1);
            violations = violations + 1;
        }
        di = di + 1;
    }
    if (file_exists(fp) == 0) {
        syscall(1, 2, "  DENY: source not found\n", 25);
        violations = violations + 1;
    }
    if (violations == 0) {
        fmt_int(len);
        syscall(1, 1, " deps, 0 violations\n", 20);
    } else {
        fmt_int(violations);
        syscall(1, 2, " violation(s)\n", 14);
    }
    # CLAMP (v6.6.5, round-3 review): an exit status is 8 bits, so 256 violations exited
    # 0 — a clean verdict for a file with 256 policy breaches. Same wrap cyrlint and
    # cyrdoc were clamped for in this release.
    if (violations > 255) { return 255; }
    return violations;
}

fn main(): i64 {
    alloc_init();
    args_init();
    if (argc() < 3) {
        println("cyaudit — Cyrius Check");
        println("  cyaudit vet <file>  — audit dependencies");
        println("  cyaudit deny <file> — enforce policies");
        # Only an explicit help request is a success. `cyaudit vet` with no file used to
        # print this and exit 0, i.e. a CI step that lost its operand passed (v6.6.5,
        # round-3 review).
        if (argc() == 2) {
            if (streq(argv(1), "--help") == 1 || streq(argv(1), "-h") == 1) { return 0; }
        }
        sys_write(STDERR_FD, "cyaudit: missing required argument <file>\n", 42);
        return 1;
    }
    # v6.6.5 — exactly `vet|deny <file>`. Extra operands and any '-' token used to
    # be ignored, so `cyaudit vet f --x` and `cyaudit vet a b` both reported on `a`
    # alone and exited 0.
    var cmd = argv(1);
    if (streq(cmd, "vet") == 0 && streq(cmd, "deny") == 0) {
        sys_write(STDERR_FD, "cyaudit: unknown command '", 26);
        sys_write(STDERR_FD, cmd, strlen(cmd));
        sys_write(STDERR_FD, "'\n", 2);
        return 1;
    }
    # A '-' token is named as an OPTION wherever it sits, before the count — so
    # `cyaudit vet f --x` reports the flag, not "extra argument".
    var oi = 2;
    while (oi < argc()) {
        if (load8(argv(oi)) == 45) {
            sys_write(STDERR_FD, "cyaudit: unknown option '", 25);
            sys_write(STDERR_FD, argv(oi), strlen(argv(oi)));
            sys_write(STDERR_FD, "'\n", 2);
            return 1;
        }
        oi = oi + 1;
    }
    if (argc() > 3) {
        var xmsg = "cyaudit: unexpected extra argument '";
        sys_write(STDERR_FD, xmsg, strlen(xmsg));
        sys_write(STDERR_FD, argv(3), strlen(argv(3)));
        sys_write(STDERR_FD, "'\n", 2);
        return 1;
    }
    if (streq(cmd, "vet") == 1) { return cmd_vet(argv(2)); }
    return cmd_deny(argv(2));
}
var r = main();
syscall(60, r);
