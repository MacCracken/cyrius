# cyrdoc — Cyrius documentation generator
# Scans .cyr files for function signatures and preceding comments.
# Outputs: markdown API reference or --check mode for CI.
#
# Usage:
#   cyrdoc <file.cyr>           — generate markdown docs
#   cyrdoc --check <file.cyr>   — check all public fns have doc comments

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"

var _undocumented = 0;
var _documented = 0;
var _total_fns = 0;
# v6.6.5, review round 3: the read buffer was a fixed 64 KB and a longer file was
# SILENTLY TRUNCATED — every fn past byte 65,536 went uncounted. `--check` on
# lib/tls_native_hs13.cyr (104,939 B) judged the first 62 % of it, and sigil's CI gate
# "0 undocumented in dist/sigil.cyr" (1,106,698 B) judged the first 6 %. The buffer now
# GROWS until a read comes up short of it (a read that fills it may have been cut off),
# up to 64 MB; past that the file is a loud error, never a partial answer. One buffer
# for the whole run, grow-only.
var _doc_buf = 0;
var _doc_cap = 0;
var _DOC_CAP_MAX = 67108864;
var _doc_too_big = 0;

# Read the whole of `path` into _doc_buf. Returns the byte count (<= 0: unreadable or
# empty, as file_read_all), or -1 with _doc_too_big set when the file exceeds 64 MB.
fn _doc_read(path): i64 {
    _doc_too_big = 0;
    if (_doc_buf == 0) {
        _doc_cap = 1048576;
        _doc_buf = alloc(_doc_cap);
    }
    while (_doc_buf != 0) {
        var n = file_read_all(path, _doc_buf, _doc_cap);
        if (n < _doc_cap) { return n; }
        if (_doc_cap >= _DOC_CAP_MAX) {
            _doc_too_big = 1;
            return 0 - 1;
        }
        _doc_cap = _doc_cap * 4;
        _doc_buf = alloc(_doc_cap);
    }
    sys_write(STDERR_FD, "cyrdoc: out of memory\n", 22);
    syscall(60, 1);
    return 0 - 1;
}

fn _doc_skip_sp(line, si, len): i64 {
    while (si < len) {
        var c = load8(line + si);
        if (c != 32) { if (c != 9) { break; } }
        si += 1;
    }
    return si;
}

# 1 iff the byte at `line[q]` ENDS an attribute name: whitespace, end of line, or `(`
# (the `#deprecated(` / `#pe_import(` form). v6.6.6 gave the lexer this boundary —
# before it, `#ioctl numbers` matched the `#io` PREFIX and the rest of the comment
# was parsed as code. Mirrors LEXATTRBOUND in src/frontend/lex.cyr; the three
# _*_attr_len readers must take the same boundary or they disagree with the
# compiler about which `#` lines are comments. CHANGELOG [6.6.6]
fn _doc_attr_bound(line, q, len): i64 {
    if (q >= len) { return 1; }
    var b = load8(line + q);
    if (b == 32 || b == 9 || b == 10 || b == 13 || b == 40) { return 1; }
    return 0;
}

# Length of the `#`-attribute TOKEN at line[si] (`#inline`, `#naked`, …), or 0 when the `#`
# opens a comment. Matched exactly as the lexer matches — including the WORD BOUNDARY the
# lexer took at v6.6.6 (see _doc_attr_bound) — and kept in step with programs/cyrlint.cyr
# _lx_attr_len and cyrfmt's _cf_attr_len. CHANGELOG [6.6.5], [6.6.6].
fn _doc_attr_len(line, si, len): i64 {
    var n = len - si;
    if (n < 3) { return 0; }
    var p = line + si;
    if (memeq(p, "#io", 3) == 1) { if (_doc_attr_bound(line, si + 3, len) == 1) { return 3; } }
    if (n >= 5) { if (memeq(p, "#pure", 5) == 1) { if (_doc_attr_bound(line, si + 5, len) == 1) { return 5; } } }
    if (n >= 6) { if (memeq(p, "#alloc", 6) == 1) { if (_doc_attr_bound(line, si + 6, len) == 1) { return 6; } } }
    if (n >= 6) { if (memeq(p, "#naked", 6) == 1) { if (_doc_attr_bound(line, si + 6, len) == 1) { return 6; } } }
    if (n >= 7) { if (memeq(p, "#inline", 7) == 1) { if (_doc_attr_bound(line, si + 7, len) == 1) { return 7; } } }
    if (n >= 7) { if (memeq(p, "#assert", 7) == 1) { if (_doc_attr_bound(line, si + 7, len) == 1) { return 7; } } }
    if (n >= 9) { if (memeq(p, "#regalloc", 9) == 1) { if (_doc_attr_bound(line, si + 9, len) == 1) { return 9; } } }
    if (n >= 9) { if (memeq(p, "#must_use", 9) == 1) { if (_doc_attr_bound(line, si + 9, len) == 1) { return 9; } } }
    if (n >= 10) { if (memeq(p, "#pe_import", 10) == 1) { if (_doc_attr_bound(line, si + 10, len) == 1) { return 10; } } }
    if (n >= 11) { if (memeq(p, "#deprecated", 11) == 1) { if (_doc_attr_bound(line, si + 11, len) == 1) { return 11; } } }
    return 0;
}

# Offset of the `fn ` a line's code opens with, or -1 — after indentation, an optional
# attribute token and an optional `pub` / `public`. v6.6.5, review round 3: only a
# line-initial `fn ` counted, so `pub fn` / `public fn` / `#inline fn` definitions were
# never seen — lib/regex.cyr's eleven `public fn`s, 28,652 `pub fn` lines across the
# ecosystem — and `--check` passed files whose whole public API was undocumented.
fn _doc_fn_at(line, len): i64 {
    var si = _doc_skip_sp(line, 0, len);
    if (si < len) {
        if (load8(line + si) == 35) {
            var al = _doc_attr_len(line, si, len);
            if (al == 0) { return 0 - 1; }
            si = _doc_skip_sp(line, si + al, len);
        }
    }
    if (si + 4 <= len) { if (memeq(line + si, "pub ", 4) == 1) { si = _doc_skip_sp(line, si + 4, len); } }
    if (si + 7 <= len) { if (memeq(line + si, "public ", 7) == 1) { si = _doc_skip_sp(line, si + 7, len); } }
    if (si + 3 > len) { return 0 - 1; }
    if (memeq(line + si, "fn ", 3) == 1) { return si; }
    return 0 - 1;
}

fn is_fn_line(line, len): i64 {
    if (_doc_fn_at(line, len) >= 0) { return 1; }
    return 0;
}

# 1 if the line's first non-space byte is a `#` that opens a COMMENT. v6.6.5: a `#inline`
# / `#must_use` line is an attribute, not documentation — it used to count as the fn's
# doc comment, so an undocumented `#inline` fn passed `--check`.
fn is_comment_line(line, len): i64 {
    var si = _doc_skip_sp(line, 0, len);
    if (si < len) {
        if (load8(line + si) == 35) {
            if (_doc_attr_len(line, si, len) == 0) { return 1; }
        }
    }
    return 0;
}

# 1 if the line holds only attribute tokens (`#inline`, `#must_use`, `#deprecated("…")`)
# — the lines between a fn and its doc comment. CHANGELOG [6.6.5].
fn is_attr_line(line, len): i64 {
    var si = _doc_skip_sp(line, 0, len);
    if (si >= len) { return 0; }
    if (load8(line + si) != 35) { return 0; }
    if (_doc_attr_len(line, si, len) == 0) { return 0; }
    if (_doc_fn_at(line, len) >= 0) { return 0; }
    return 1;
}

fn extract_fn_name(line, len, buf): i64 {
    # Find "fn " then extract name until (
    var si = 0;
    while (si < len - 2) {
        if (load8(line + si) == 102) {
            if (load8(line + si + 1) == 110) {
                if (load8(line + si + 2) == 32) {
                    var ns = si + 3;
                    var ne = ns;
                    while (ne < len) {
                        var c = load8(line + ne);
                        if (c == 40) { break; }
                        if (c == 60) { break; }
                        ne += 1;
                    }
                    var nlen = ne - ns;
                    memcpy(buf, line + ns, nlen);
                    store8(buf + nlen, 0);
                    return nlen;
                }
            }
        }
        si += 1;
    }
    store8(buf, 0);
    return 0;
}

fn extract_fn_sig(line, len, buf) {
    # Extract from "fn" to end of line (trimmed)
    var si = 0;
    while (si < len - 2) {
        if (load8(line + si) == 102) {
            if (load8(line + si + 1) == 110) {
                if (load8(line + si + 2) == 32) {
                    # Find the closing ) or {
                    var se = si;
                    while (se < len) {
                        var c = load8(line + se);
                        if (c == 123) { break; }
                        se += 1;
                    }
                    # Trim trailing spaces
                    while (se > si) {
                        var tc = load8(line + se - 1);
                        if (tc != 32) { if (tc != 123) { break; } }
                        se -= 1;
                    }
                    var slen = se - si;
                    memcpy(buf, line + si, slen);
                    store8(buf + slen, 0);
                    return slen;
                }
            }
        }
        si += 1;
    }
    return 0;
}

fn process_file(filepath, check_mode) {
    var n = _doc_read(filepath);
    if (_doc_too_big == 1) { return 2; }
    var buf = _doc_buf;
    # v6.6.5 — an unreadable file used to `return 0` here and main() then exited 0
    # with NO output, which from a doc generator is indistinguishable from "this
    # file has no documentation". `cyrdoc /nonexistent.cyr` reported success.
    #
    # ⚠ v6.6.5 (round-2 review): `file_read_all` returns 0 for BOTH "could not open"
    # and "opened, zero bytes", so the first cut of this guard also failed a legal
    # 0-byte module — a consumer with an empty `mod.cyr` would have started failing
    # `cyrius doc` where 6.6.4 exited 0. Probe existence SEPARATELY: an existing empty
    # file is "no functions", which is a real and correct answer.
    if (n <= 0) {
        if (file_exists(filepath) == 1) { return 0; }
        return 1;
    }

    # Parse into lines
    var lines = vec_new();
    var line_starts = vec_new();
    var li = 0;
    while (li < n) {
        vec_push(line_starts, li);
        var le = li;
        while (le < n) {
            if (load8(buf + le) == 10) { break; }
            le += 1;
        }
        vec_push(lines, le - li);
        li = le + 1;
    }

    var num_lines = vec_len(lines);
    var namebuf = alloc(128);
    var sigbuf = alloc(256);

    if (check_mode == 0) {
        # Generate mode — output markdown
        syscall(1, 1, "# API Reference: ", 17);
        syscall(1, 1, filepath, strlen(filepath));
        syscall(1, 1, "\n\n", 2);
    }

    var fi = 0;
    while (fi < num_lines) {
        var lstart = vec_get(line_starts, fi);
        var llen = vec_get(lines, fi);

        var fo = _doc_fn_at(buf + lstart, llen);
        if (fo >= 0) {
            _total_fns += 1;

            # Check if the line before is a comment — past any attribute-only lines
            # (`#inline` / `#must_use` on their own line sit between a doc and its fn)
            var has_doc = 0;
            var doc_start = 0;
            var doc_len = 0;
            var pi = fi - 1;
            while (pi >= 0) {
                if (is_attr_line(buf + vec_get(line_starts, pi), vec_get(lines, pi)) == 0) { break; }
                pi = pi - 1;
            }
            if (pi >= 0) {
                var pstart = vec_get(line_starts, pi);
                var plen = vec_get(lines, pi);
                if (is_comment_line(buf + pstart, plen) == 1) {
                    has_doc = 1;
                    doc_start = pstart;
                    doc_len = plen;
                }
            }

            # name and signature from the `fn` on — never from an earlier "fn " inside
            # an attribute's string argument
            extract_fn_name(buf + lstart + fo, llen - fo, namebuf);
            var nlen = strlen(namebuf);

            # Skip private functions (start with _)
            var is_private = 0;
            if (nlen > 0) {
                if (load8(namebuf) == 95) { is_private = 1; }
            }

            if (is_private == 0) {
                if (check_mode == 1) {
                    if (has_doc == 0) {
                        _undocumented += 1;
                        syscall(1, 2, "  undocumented: ", 16);
                        syscall(1, 2, namebuf, nlen);
                        syscall(1, 2, "\n", 1);
                    } else {
                        _documented += 1;
                    }
                } else {
                    # Generate markdown entry
                    extract_fn_sig(buf + lstart + fo, llen - fo, sigbuf);
                    syscall(1, 1, "### `", 5);
                    syscall(1, 1, sigbuf, strlen(sigbuf));
                    syscall(1, 1, "`\n", 2);
                    if (has_doc == 1) {
                        # Print doc comment (strip leading # )
                        var ds = doc_start;
                        while (ds < doc_start + doc_len) {
                            if (load8(buf + ds) != 32) { break; }
                            ds += 1;
                        }
                        if (load8(buf + ds) == 35) { ds += 1; }
                        if (load8(buf + ds) == 32) { ds += 1; }
                        var dlen = doc_start + doc_len - ds;
                        if (dlen > 0) {
                            syscall(1, 1, buf + ds, dlen);
                            syscall(1, 1, "\n", 1);
                        }
                    }
                    syscall(1, 1, "\n", 1);
                }
            }
        }
        fi += 1;
    }

    return 0;
}

fn _doc_usage(): i64 {
    println("cyrdoc — Cyrius documentation generator");
    println("  cyrdoc [--check] <file.cyr>...");
    println("  (no flag)   generate markdown on stdout");
    println("  --check     report missing docs; exit = undocumented count (clamped to 255)");
    return 0;
}

fn main() {
    alloc_init();
    args_init();

    if (argc() < 2) { _doc_usage(); return 0; }

    # v6.6.5 — `--check` used to be read at argv(1) ONLY, so `cyrdoc f.cyr --check`
    # dropped it and wrote markdown with exit 0; an unknown '-' token became the
    # path. Flags anywhere, unknown is an error, N files. CHANGELOG [6.6.5].
    var check_mode = 0;
    var files = vec_new();
    var ai = 1;
    while (ai < argc()) {
        var a = argv(ai);
        if (streq(a, "--check") == 1) { check_mode = 1; }
        elif (streq(a, "--help") == 1 || streq(a, "-h") == 1) { _doc_usage(); return 0; }
        elif (load8(a) == 45) {
            sys_write(STDERR_FD, "cyrdoc: unknown option '", 24);
            sys_write(STDERR_FD, a, strlen(a));
            sys_write(STDERR_FD, "'\n", 2);
            _doc_usage();
            return 1;
        }
        else { vec_push(files, a); }
        ai = ai + 1;
    }
    if (vec_len(files) == 0) { _doc_usage(); return 1; }

    var read_err = 0;
    var fi = 0;
    while (fi < vec_len(files)) {
        var f = vec_get(files, fi);
        var pr = process_file(f, check_mode);
        if (pr == 2) {
            sys_write(STDERR_FD, "cyrdoc: file too large (>64MB): ", 32);
            sys_write(STDERR_FD, f, strlen(f));
            sys_write(STDERR_FD, "\n", 1);
            read_err = 1;
        } elif (pr != 0) {
            sys_write(STDERR_FD, "cyrdoc: cannot read file: ", 26);
            sys_write(STDERR_FD, f, strlen(f));
            sys_write(STDERR_FD, "\n", 1);
            read_err = 1;
        }
        fi = fi + 1;
    }
    if (read_err == 1) { return 1; }

    if (check_mode == 1) {
        var nb[24];
        var nl = fmt_int_buf(_documented, &nb);
        sys_write(STDOUT_FD, &nb, nl);
        sys_write(STDOUT_FD, " documented, ", 13);
        nl = fmt_int_buf(_undocumented, &nb);
        sys_write(STDOUT_FD, &nb, nl);
        sys_write(STDOUT_FD, " undocumented (", 15);
        nl = fmt_int_buf(_total_fns, &nb);
        sys_write(STDOUT_FD, &nb, nl);
        sys_write(STDOUT_FD, " total)\n", 8);
        # v6.6.5 — CLAMP. An exit code is 8 bits: 256 undocumented fns returned 0,
        # so a file with 256 problems reported a clean bill of health, and 257
        # returned 1. Measured on 6.6.4.
        if (_undocumented > 255) { return 255; }
        return _undocumented;
    }

    return 0;
}
var r = main();
syscall(60, r);
