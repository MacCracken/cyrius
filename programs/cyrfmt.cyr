# cyrfmt — Cyrius code formatter
# Reads source file, writes formatted output.
# Rules: 4-space indent, trim trailing whitespace, consistent brace depth.
# Usage: cyrfmt <file.cyr>                 (format to stdout)
#        cyrfmt --check <file.cyr>         (exit 0 if formatted, 1 if not)
#        cyrfmt --write <file.cyr>         (format in-place — v5.5.22)
#        cyrfmt -w <file.cyr>              (short form of --write)
#
# --write uses truncate-and-overwrite via `file_write_all` — not atomic
# via temp+rename (sankoch feedback: the behavior matches gofmt -w in
# practice, and cyrius doesn't expose sys_rename yet). Users running
# cyrfmt on their own source should have git history as their backup.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/args.cyr"

var _out_buf: i64 = 0;
var _out_pos: i64 = 0;
var _check_mode: i64 = 0;
var _write_mode: i64 = 0;
# Max file size cyrfmt will read/format in one pass (1028KB). Largest real
# source today is ~160KB; vendored stdlib bundles (mabda ~834KB) are the real
# floor. file_read_all() caps at this; a file that hits the ceiling is flagged
# fail-loud below rather than silently format-checked on a truncated buffer.
# See CHANGELOG [6.2.20].
var _MAX_FILE: i64 = 1052672;

# Emit len bytes from ptr. --check / --write both route to the in-memory
# output buffer; default (to-stdout) path issues a direct syscall(1, …).
fn emit(ptr, len): i64 {
    if (_check_mode == 1) {
        var i = 0;
        while (i < len) {
            store8(_out_buf + _out_pos, load8(ptr + i));
            _out_pos += 1;
            i += 1;
        }
    } elif (_write_mode == 1) {
        var wi = 0;
        while (wi < len) {
            store8(_out_buf + _out_pos, load8(ptr + wi));
            _out_pos += 1;
            wi += 1;
        }
    } else {
        syscall(1, 1, ptr, len);
    }
    return 0;
}

fn emit_spaces(n): i64 {
    var si = 0;
    while (si < n) { emit(" ", 1); si += 1; }
    return 0;
}

fn format_file(buf, total): i64 {
    var depth = 0;
    var pos = 0;
    # v6.5.18: literal state is CARRIED ACROSS physical lines. A cyrius string
    # literal may span lines two ways — a trailing `\` (which KEEPS the newline;
    # it is NOT a C-style splice) and a bare raw newline. The bytes on such a
    # continuation line are program DATA, not code, so re-indenting them,
    # stripping their leading/trailing spaces, or collapsing them when blank are
    # all silent data changes. These two used to be re-initialised to 0 on EVERY
    # physical line, so the state was thrown away at each newline and the
    # continuation line was formatted as ordinary code (agnosai YAML fixture:
    # four injected spaces re-nested the document). See CHANGELOG [6.5.18].
    # `in_char` is deliberately NOT carried: a char literal cannot span a line
    # (cycc rejects a multi-byte char literal), so carrying it could only let a
    # stray apostrophe run away over the rest of the file.
    var in_string = 0;
    var in_char = 0;

    while (pos < total) {
        # Find end of line
        var eol = pos;
        while (eol < total) {
            if (load8(buf + eol) == 10) { break; }
            eol += 1;
        }

        # Does THIS physical line BEGIN inside a string literal? Captured before
        # the scan below advances the state.
        var starts_in_str = in_string;
        in_char = 0;

        # Count all braces on this line — but skip any inside `#`
        # comments, `"..."` string literals, and `'...'` char
        # literals so doc lines that quote inline asm (`# asm
        # { mov cr3, rax; }`), string literals, and char
        # literals like `'}'` don't fool the indenter.
        # v5.7.22 fix added `#`-comment + `"..."`-string skip;
        # v5.10.6 added `'...'`-char skip — repro was
        # `str_builder_putc(sb, '}'); var x = 1;` where the
        # `}` inside the char literal decremented the brace
        # depth and the next statement lost its indent.
        # v6.5.18: this scan now runs BEFORE the trim/strip, over the RAW line
        # (pos..eol), and is SEEDED with the carried in_string instead of 0.
        # Order matters: the trailing trim has to know whether the line ENDS
        # inside a literal, which only the scan can tell it. Scanning raw is
        # equivalent to the old start..end scan for ordinary code, because
        # leading and trailing whitespace contain none of `#`, `"`, `'`, {, }.
        var opens = 0;
        var closes = 0;
        var bi = pos;
        while (bi < eol) {
            var bc = load8(buf + bi);
            if (in_string == 1) {
                if (bc == 92) {
                    # Backslash escape: skip next byte (covers \" \\).
                    bi += 1;
                }
                elif (bc == 34) {
                    in_string = 0;
                }
            }
            elif (in_char == 1) {
                if (bc == 92) {
                    # Backslash escape: skip next byte (covers \' \\
                    # \n \t \xNN \u{...} prefix-byte; the rest of
                    # the escape body is handled by the same
                    # byte-at-a-time loop, which won't see a `}` /
                    # `{` / `'` / `"` inside the escape body
                    # because those chars are not part of any
                    # cyrius escape grammar).
                    bi += 1;
                }
                elif (bc == 39) {
                    in_char = 0;
                }
            }
            else {
                if (bc == 35) { break; }            # `#` — comment to end of line
                if (bc == 34) { in_string = 1; }     # opening `"` of a string literal
                elif (bc == 39) { in_char = 1; }     # opening `'` of a char literal
                elif (bc == 123) { opens += 1; }
                elif (bc == 125) { closes += 1; }
            }
            bi += 1;
        }
        # ...and does it END inside one (making the NEXT line interior)?
        var ends_in_str = in_string;

        # Trim trailing whitespace — UNLESS the line ends inside a literal, where
        # those spaces are string content and deleting them changes the program.
        var end = eol;
        if (ends_in_str == 0) {
            while (end > pos) {
                var tc = load8(buf + end - 1);
                if (tc != 32 && tc != 9 && tc != 13) { break; }
                end -= 1;
            }
        }

        # Skip leading whitespace — UNLESS the line BEGINS inside a literal, for
        # the same reason (this is the half the agnosai filing reported).
        var start = pos;
        if (starts_in_str == 0) {
            while (start < end) {
                var sc = load8(buf + start);
                if (sc != 32 && sc != 9) { break; }
                start += 1;
            }
        }

        var content_len = end - start;

        if (content_len == 0) {
            emit("\n", 1);
        } else {
            # Indent BEFORE this line: decrement for leading closes
            var leading_close = 0;
            # v6.5.18: a `}` that is string INTERIOR must not move the depth.
            if (starts_in_str == 0) {
                if (load8(buf + start) == 125) { leading_close = 1; }
            }
            # For this line's indent: subtract closes that come before opens
            # Simple rule: if line starts with }, dedent first
            if (leading_close == 1) {
                if (depth > 0) { depth -= 1; }
            }

            # Emit. v6.5.18: NO indent is written in front of a line that begins
            # inside a string literal — those leading bytes are the program's data.
            if (starts_in_str == 0) {
                emit_spaces(depth * 4);
            }
            emit(buf + start, content_len);
            emit("\n", 1);

            # Adjust depth for NEXT line
            # Net change: opens - closes, but we already handled leading close
            if (leading_close == 1) {
                depth = depth + opens - (closes - 1);
            } else {
                depth = depth + opens - closes;
            }
            if (depth < 0) { depth = 0; }
        }

        pos = eol + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    args_init();

    if (argc() < 2) {
        println("Usage: cyrfmt <file.cyr>");
        println("       cyrfmt --check <file.cyr>");
        println("       cyrfmt --write <file.cyr>    (or -w)");
        return 1;
    }

    var file_arg = 1;
    if (streq(argv(1), "--check") == 1) {
        _check_mode = 1;
        file_arg = 2;
        if (argc() < 3) {
            println("Usage: cyrfmt --check <file.cyr>");
            return 1;
        }
    } elif (streq(argv(1), "--write") == 1) {
        _write_mode = 1;
        file_arg = 2;
        if (argc() < 3) {
            println("Usage: cyrfmt --write <file.cyr>");
            return 1;
        }
    } elif (streq(argv(1), "-w") == 1) {
        _write_mode = 1;
        file_arg = 2;
        if (argc() < 3) {
            println("Usage: cyrfmt -w <file.cyr>");
            return 1;
        }
    }

    var buf = alloc(_MAX_FILE);
    var path = argv(file_arg);
    var n = file_read_all(path, buf, _MAX_FILE);
    if (n <= 0) {
        println("cyrfmt: cannot read file");
        return 1;
    }
    # Fail loud on a truncated read: file_read_all stops at _MAX_FILE, so
    # n == _MAX_FILE means the file is at/over the cap and the tail was
    # dropped. Format-checking a truncated buffer would silently pass (or
    # spuriously fail mid-token) — surface it instead of guessing.
    if (n >= _MAX_FILE) {
        println("cyrfmt: file too large to format-check (>1028KB) — raise _MAX_FILE");
        return 1;
    }

    if (_check_mode == 1) {
        _out_buf = alloc(_MAX_FILE);
        _out_pos = 0;
        format_file(buf, n);
        # Compare formatted output against original
        if (_out_pos != n) { return 1; }
        if (memeq(buf, _out_buf, n) == 1) { return 0; }
        return 1;
    }

    if (_write_mode == 1) {
        _out_buf = alloc(_MAX_FILE);
        _out_pos = 0;
        format_file(buf, n);
        # Short-circuit: skip the write if input already matches formatted
        # output. Saves an fs roundtrip + avoids churning mtime on
        # already-clean files (matters for incremental build systems).
        if (_out_pos == n) {
            if (memeq(buf, _out_buf, n) == 1) { return 0; }
        }
        var w = file_write_all(path, _out_buf, _out_pos);
        if (w != _out_pos) {
            println("cyrfmt: cannot write file");
            return 1;
        }
        return 0;
    }

    format_file(buf, n);
    return 0;
}
var r = main();
syscall(60, r);
