# cyrfmt — Cyrius code formatter
# Reads source file, writes formatted output.
# Rules: 4-space indent, trim trailing whitespace, consistent brace depth.
# Usage: cyrfmt <file.cyr>                 (format to stdout)
#        cyrfmt --check <file.cyr>         (exit 0 if formatted, 1 if not)
#        cyrfmt --write <file.cyr>         (format in-place — v5.5.22)
#        cyrfmt -w <file.cyr>              (short form of --write)
#
# --write replaces the file crash-safe (`file_replace_atomic`: temp + fsync + rename, keeping
# the file's permission bits and writing THROUGH a symlink, as the old O_TRUNC write did), and a
# short write is an error that leaves the source exactly as it was. ⛔ v6.6.6: it used `file_write_all`
# (O_TRUNC, then one write) — it did detect the short count, but only after the USER'S SOURCE had
# already been truncated. The old note here said "cyrius doesn't expose sys_rename yet";
# `file_write_atomic` has existed since v6.4.57. CHANGELOG [6.6.6]

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"    # v6.6.5: N-file argument list
include "lib/args.cyr"

var _out_buf: i64 = 0;
var _out_pos: i64 = 0;
var _check_mode: i64 = 0;
# v6.5.28 — spaces of indent added per open-paren level on a continuation line.
# 2 is CANONICAL (what cyrfmt emits). `--check` also ACCEPTS 4 by re-running with this set to
# 4; anything else is rejected. Maintainer 2026-08-18: "I'd rather have 2-space indents and
# accept 4 but nothing more; else it wouldn't be a format check." A single accepted alternate
# keeps already-formatted trees from churning without turning the check into a no-op.
var _cont_step: i64 = 2;
var _write_mode: i64 = 0;
# Max file size cyrfmt will read/format in one pass (1028KB). Largest real
# source today is ~160KB; vendored stdlib bundles (mabda ~834KB) are the real
# floor. file_read_all() caps at this; a file that hits the ceiling is flagged
# fail-loud below rather than silently format-checked on a truncated buffer.
# See CHANGELOG [6.2.20].
var _MAX_FILE: i64 = 1052672;
# v6.6.5, review round 3 — ONE output buffer with a HARD CAP, in every mode. emit() wrote
# into a buffer the size of the INPUT cap with no bound, and formatted output can be far
# larger than its input: 20K lines of an unclosed `syscall(a,` indent line i by 2·i
# spaces, so `--check` / `--write` ran off the end of the buffer (SIGSEGV, rc 139 — at
# 6.6.4 too) and the stdout mode streamed more than 100 MB before a 60 s timeout. Past
# _OUT_CAP nothing more is written, emit_spaces stops looping (so the run stays linear),
# and the file fails LOUDLY instead of crashing or flooding stdout. The stdout mode formats
# into the same buffer and writes it once, only when it is complete. CHANGELOG [6.6.5].
var _OUT_CAP: i64 = 8421376;   # 8 × _MAX_FILE
var _out_over: i64 = 0;
var _in_buf: i64 = 0;          # the input buffer, one for the whole run

# Append len bytes from ptr to the output buffer (all three modes), or note the overflow.
fn emit(ptr, len): i64 {
    if (_out_over == 1) { return 0; }
    if (_out_pos + len > _OUT_CAP) {
        _out_over = 1;
        return 0;
    }
    var i = 0;
    while (i < len) {
        store8(_out_buf + _out_pos + i, load8(ptr + i));
        i += 1;
    }
    _out_pos += len;
    return 0;
}

fn emit_spaces(n): i64 {
    var si = 0;
    while (si < n) {
        if (_out_over == 1) { return 0; }
        emit(" ", 1);
        si += 1;
    }
    return 0;
}

# 1 iff the byte at `q` ENDS an attribute name: whitespace, end of buffer, or —
# when `ap` is 1 — `(`. v6.6.6 gave the lexer this boundary; before it,
# `#ioctl numbers` matched the `#io` PREFIX and the rest of the comment was parsed
# as code. `ap` is 1 at only three of the ten names: `#deprecated(` and
# `#pe_import(` are real syntax, and `#assert(` is the one whose parenthesised form
# the compiler REJECTS OUT LOUD, so reading it as a comment would silently drop an
# assertion the author wrote. Mirrors LEXATTRBOUND in src/frontend/lex.cyr; the
# three _*_attr_len readers must take the same boundary or they disagree with the
# compiler about which `#` lines are comments. CHANGELOG [6.6.6]
fn _cf_attr_bound(buf, q, lim, ap): i64 {
    if (q >= lim) { return 1; }
    var b = load8(buf + q);
    if (b == 32 || b == 9 || b == 10 || b == 13) { return 1; }
    if (b == 40) { if (ap == 1) { return 1; } }
    return 0;
}

# A `#` is not always a comment: the lexer turns ten byte prefixes into attribute TOKENS
# and keeps lexing the line after them, so `#naked fn isr() {` opens a real brace. Read as
# a comment, that `{` was never counted and `cyrius fmt` rewrote the whole fn body flush
# left (tests/tcyr/codegen/naked_fn_attribute.tcyr). Mirrors cyrlint's _lx_attr_len and
# the lexer's own match — including the WORD BOUNDARY the lexer took at v6.6.6
# (see _cf_attr_bound).
# Returns the token's length, `#` included, or 0 (a comment). CHANGELOG [6.6.5].
fn _cf_attr_len(buf, p, lim): i64 {
    var n = lim - p;
    if (n < 3) { return 0; }
    var c1 = load8(buf + p + 1);
    if (c1 == 105) {
        if (load8(buf + p + 2) == 111) {                                      # #io
            if (_cf_attr_bound(buf, p + 3, lim, 0) == 1) { return 3; }
            return 0;
        }
        if (n >= 7) { if (memeq(buf + p, "#inline", 7) == 1) { if (_cf_attr_bound(buf, p + 7, lim, 0) == 1) { return 7; } } }
        return 0;
    }
    if (c1 == 97) {
        if (n >= 7) { if (memeq(buf + p, "#assert", 7) == 1) { if (_cf_attr_bound(buf, p + 7, lim, 1) == 1) { return 7; } } }
        if (n >= 6) { if (memeq(buf + p, "#alloc", 6) == 1) { if (_cf_attr_bound(buf, p + 6, lim, 0) == 1) { return 6; } } }
        return 0;
    }
    if (c1 == 112) {
        if (n >= 5) { if (memeq(buf + p, "#pure", 5) == 1) { if (_cf_attr_bound(buf, p + 5, lim, 0) == 1) { return 5; } } }
        if (n >= 10) { if (memeq(buf + p, "#pe_import", 10) == 1) { if (_cf_attr_bound(buf, p + 10, lim, 1) == 1) { return 10; } } }
        return 0;
    }
    if (n >= 6) { if (memeq(buf + p, "#naked", 6) == 1) { if (_cf_attr_bound(buf, p + 6, lim, 0) == 1) { return 6; } } }
    if (n >= 9) { if (memeq(buf + p, "#regalloc", 9) == 1) { if (_cf_attr_bound(buf, p + 9, lim, 0) == 1) { return 9; } } }
    if (n >= 9) { if (memeq(buf + p, "#must_use", 9) == 1) { if (_cf_attr_bound(buf, p + 9, lim, 0) == 1) { return 9; } } }
    if (n >= 11) { if (memeq(buf + p, "#deprecated", 11) == 1) { if (_cf_attr_bound(buf, p + 11, lim, 1) == 1) { return 11; } } }
    return 0;
}

fn format_file(buf, total): i64 {
    var depth = 0;
    # v6.5.28 — PAREN depth, tracked across lines alongside brace depth. cyrfmt indented
    # every line at `depth * 4` from BRACE depth alone and did not look at parens at all, so
    # a continuation line inside an unclosed `(` came out at the enclosing statement's indent
    # — the "flattening" consumers hit. Filed from rupa 0.1.3, where `fmt --check` failed CI
    # on every wrapped call with zero bytes of output.
    # Maintainer decision 2026-08-18: canonical continuation indent is TWO spaces per open
    # paren level; FOUR is ACCEPTED by --check; anything deeper is REJECTED — "else it
    # wouldn't be a format check".
    var pdepth = 0;
    var pos = 0;
    # v6.5.18: literal state is CARRIED ACROSS physical lines. A cyrius string
    # literal may span lines two ways — a trailing `\` (which KEEPS the newline;
    # it is NOT a C-style splice) and a bare raw newline. The bytes on such a
    # continuation line are program DATA, not code, so re-indenting them,
    # stripping their leading/trailing spaces, or collapsing them when blank are
    # all silent data changes. These two used to be re-initialised to 0 on EVERY
    # physical line, so the state was thrown away at each newline and the
    # continuation line was formatted as ordinary code (agnosai YAML fixture:
    # four injected spaces re-nested the document). See CHANGELOG [6.5.18].
    # `in_char` is deliberately NOT carried: a char literal cannot span a line
    # (cycc rejects a multi-byte char literal), so carrying it could only let a
    # stray apostrophe run away over the rest of the file.
    var in_string = 0;
    var in_char = 0;

    while (pos < total) {
        # Find end of line
        var eol = pos;
        while (eol < total) {
            if (load8(buf + eol) == 10) { break; }
            eol += 1;
        }

        # Does THIS physical line BEGIN inside a string literal? Captured before
        # the scan below advances the state.
        var starts_in_str = in_string;
        in_char = 0;

        # Count all braces on this line — but skip any inside `#`
        # comments, `"..."` string literals, and `'...'` char
        # literals so doc lines that quote inline asm (`# asm
        # { mov cr3, rax; }`), string literals, and char
        # literals like `'}'` don't fool the indenter.
        # v5.7.22 fix added `#`-comment + `"..."`-string skip;
        # v5.10.6 added `'...'`-char skip — repro was
        # `str_builder_putc(sb, '}'); var x = 1;` where the
        # `}` inside the char literal decremented the brace
        # depth and the next statement lost its indent.
        # v6.5.18: this scan now runs BEFORE the trim/strip, over the RAW line
        # (pos..eol), and is SEEDED with the carried in_string instead of 0.
        # Order matters: the trailing trim has to know whether the line ENDS
        # inside a literal, which only the scan can tell it. Scanning raw is
        # equivalent to the old start..end scan for ordinary code, because
        # leading and trailing whitespace contain none of `#`, `"`, `'`, {, }.
        var opens = 0;
        var closes = 0;
        var popens = 0;
        var pcloses = 0;
        var bi = pos;
        while (bi < eol) {
            var bc = load8(buf + bi);
            if (in_string == 1) {
                if (bc == 92) {
                    # Backslash escape: skip next byte (covers \" \\).
                    bi += 1;
                }
                elif (bc == 34) {
                    in_string = 0;
                }
            }
            elif (in_char == 1) {
                if (bc == 92) {
                    # Backslash escape: skip next byte (covers \' \\
                    # \n \t \xNN \u{...} prefix-byte; the rest of
                    # the escape body is handled by the same
                    # byte-at-a-time loop, which won't see a `}` /
                    # `{` / `'` / `"` inside the escape body
                    # because those chars are not part of any
                    # cyrius escape grammar).
                    bi += 1;
                }
                elif (bc == 39) {
                    in_char = 0;
                }
            }
            else {
                if (bc == 35) {
                    # `#` — comment to end of line, unless it opens an attribute token
                    var al = _cf_attr_len(buf, bi, eol);
                    if (al == 0) { break; }
                    bi = bi + al - 1;
                }
                elif (bc == 34) { in_string = 1; }   # opening `"` of a string literal
                elif (bc == 39) { in_char = 1; }     # opening `'` of a char literal
                elif (bc == 123) { opens += 1; }
                elif (bc == 125) { closes += 1; }
                elif (bc == 40) { popens += 1; }     # v6.5.28: `(`
                elif (bc == 41) { pcloses += 1; }    # v6.5.28: `)`
            }
            bi += 1;
        }
        # ...and does it END inside one (making the NEXT line interior)?
        var ends_in_str = in_string;

        # Trim trailing whitespace — UNLESS the line ends inside a literal, where
        # those spaces are string content and deleting them changes the program.
        var end = eol;
        if (ends_in_str == 0) {
            while (end > pos) {
                var tc = load8(buf + end - 1);
                if (tc != 32 && tc != 9 && tc != 13) { break; }
                end -= 1;
            }
        }

        # Skip leading whitespace — UNLESS the line BEGINS inside a literal, for
        # the same reason (this is the half the agnosai filing reported).
        var start = pos;
        if (starts_in_str == 0) {
            while (start < end) {
                var sc = load8(buf + start);
                if (sc != 32 && sc != 9) { break; }
                start += 1;
            }
        }

        var content_len = end - start;

        if (content_len == 0) {
            emit("\n", 1);
        } else {
            # Indent BEFORE this line: decrement for leading closes
            var leading_close = 0;
            # v6.5.18: a `}` that is string INTERIOR must not move the depth.
            if (starts_in_str == 0) {
                if (load8(buf + start) == 125) { leading_close = 1; }
            }
            # For this line's indent: subtract closes that come before opens
            # Simple rule: if line starts with }, dedent first
            if (leading_close == 1) {
                if (depth > 0) { depth -= 1; }
            }

            # Emit. v6.5.18: NO indent is written in front of a line that begins
            # inside a string literal — those leading bytes are the program's data.
            if (starts_in_str == 0) {
                # `pdepth` is the paren depth as of the START of this line, so the statement
                # that OPENS the call keeps its own brace indent and only its continuations
                # are stepped in.
                emit_spaces(depth * 4 + pdepth * _cont_step);
            }
            emit(buf + start, content_len);
            emit("\n", 1);

            # Adjust depth for NEXT line
            # Net change: opens - closes, but we already handled leading close
            if (leading_close == 1) {
                depth = depth + opens - (closes - 1);
            } else {
                depth = depth + opens - closes;
            }
            if (depth < 0) { depth = 0; }
        }
        # v6.5.28 — carry paren depth. Done for EVERY line including blank/comment ones, so a
        # comment inside a wrapped argument list does not reset the continuation indent.
        pdepth = pdepth + popens - pcloses;
        if (pdepth < 0) { pdepth = 0; }

        pos = eol + 1;
    }
    return 0;
}

# v6.5.28 — print a small non-negative number without pulling in a dependency.
# ⚠ NOT `fmt_int`: cyrfmt includes string/fmt/alloc/io/args but NOT `lib/vec.cyr`, and
# fmt_int reaches `vec_get`, so calling it here SIGSEGVs (measured: exit 139, part-way
# through the message). A four-line local routine beats adding a vec dependency to a tool
# this small.
fn _cf_print_num(v): i64 {
    var d[24];
    var i = 24;
    var x = v;
    if (x == 0) { print("0", 1); return 0; }
    while (x > 0) {
        i = i - 1;
        store8(&d + i, 48 + (x % 10));
        x = x / 10;
    }
    print(&d + i, 24 - i);
    return 0;
}

# v6.6.5 — format ONE file. Was the tail of main(); lifted so N files run through
# the identical path instead of only argv(file_arg).
# Format buf[0, n) into _out_buf with continuation step `step`; 1 if the output overflowed.
fn _fmt_run(buf, n, step): i64 {
    _out_pos = 0;
    _out_over = 0;
    _cont_step = step;
    format_file(buf, n);
    return _out_over;
}

fn _fmt_overflow(path): i64 {
    var m = "cyrfmt: formatted output would exceed 8 MB (an unbalanced ( or { ?) - not formatted: ";
    sys_write(STDERR_FD, m, strlen(m));
    sys_write(STDERR_FD, path, strlen(path));
    sys_write(STDERR_FD, "\n", 1);
    return 1;
}

fn _fmt_one(path): i64 {
    # One input and one output buffer for the whole run: an alloc per file grew RSS by
    # the buffer size per file (nothing is freed); n bounds every reader of the input.
    if (_in_buf == 0) { _in_buf = alloc(_MAX_FILE); }
    if (_out_buf == 0) { _out_buf = alloc(_OUT_CAP); }
    var buf = _in_buf;
    var n = file_read_all(path, buf, _MAX_FILE);
    if (n <= 0) {
        println("cyrfmt: cannot read file");
        return 1;
    }
    # Fail loud on a truncated read: file_read_all stops at _MAX_FILE, so
    # n == _MAX_FILE means the file is at/over the cap and the tail was
    # dropped. Format-checking a truncated buffer would silently pass (or
    # spuriously fail mid-token) — surface it instead of guessing.
    if (n >= _MAX_FILE) {
        println("cyrfmt: file too large to format-check (>1028KB) — raise _MAX_FILE");
        return 1;
    }

    if (_check_mode == 1) {
        # Pass 1: the CANONICAL form (2-space continuation step).
        if (_fmt_run(buf, n, 2) == 1) { return _fmt_overflow(path); }
        if (_out_pos == n) {
            if (memeq(buf, _out_buf, n) == 1) { return 0; }
        }
        # Pass 2: the ACCEPTED alternate (4-space step). Re-formatting is cheaper and far
        # simpler than teaching the comparison to tolerate a range per line, and it keeps the
        # tolerance EXACTLY two shapes wide — a comparison that "skipped indent differences"
        # would accept 8 and 12 too, which is precisely what makes it not a check.
        _fmt_run(buf, n, 4);
        if (_out_pos == n) {
            if (memeq(buf, _out_buf, n) == 1) { return 0; }
        }
        # ⛔ SAY WHAT DIFFERS. This used to `return 1` in SILENCE — no diff, no message, no
        # line number — so a consumer's CI failed with nothing to act on. That silence was the
        # uncontested half of the rupa filing; the indent rule above is the other half.
        # Re-format canonically so the reported line refers to the form we actually want.
        _fmt_run(buf, n, 2);
        var dl = 1;
        var di = 0;
        var lim = n;
        if (_out_pos < lim) { lim = _out_pos; }
        while (di < lim) {
            if (load8(buf + di) != load8(_out_buf + di)) { di = lim; }
            else {
                if (load8(buf + di) == 10) { dl = dl + 1; }
                di = di + 1;
            }
        }
        print("cyrfmt: ", 8);
        print(path, strlen(path));
        print(":", 1);
        _cf_print_num(dl);
        println(": not canonically formatted (first differing line)");
        println("  canonical continuation indent is 2 spaces per open paren (4 also accepted)");
        println("  run: cyrius fmt <file>            (rewrites in place)");
        println("       cyrius fmt <file> --dry      (report only)");
        return 1;
    }

    if (_write_mode == 1) {
        if (_fmt_run(buf, n, 2) == 1) { return _fmt_overflow(path); }
        # Short-circuit: skip the write if input already matches formatted
        # output. Saves an fs roundtrip + avoids churning mtime on
        # already-clean files (matters for incremental build systems).
        if (_out_pos == n) {
            if (memeq(buf, _out_buf, n) == 1) { return 0; }
        }
        if (file_replace_atomic(path, _out_buf, _out_pos) != 0) {
            syscall(1, 2, "cyrfmt: cannot write (left as it was): ", 39);
            syscall(1, 2, path, strlen(path));
            syscall(1, 2, "\n", 1);
            return 1;
        }
        return 0;
    }

    if (_fmt_run(buf, n, 2) == 1) { return _fmt_overflow(path); }
    var wp = 0;
    while (wp < _out_pos) {
        var wn = syscall(1, 1, _out_buf + wp, _out_pos - wp);
        if (wn <= 0) { return 1; }
        wp = wp + wn;
    }
    return 0;
}

fn _fmt_usage(): i64 {
    println("Usage: cyrfmt [--check | --write | -w] <file.cyr>...");
    println("  (no mode)   format to stdout");
    println("  --check     exit 1 if not canonically formatted, and say where");
    println("  --write     rewrite in place (or -w)");
    return 1;
}

fn main(): i64 {
    alloc_init();
    args_init();

    if (argc() < 2) { return _fmt_usage(); }

    # v6.6.5 — the mode used to be read at argv(1) ONLY, so `cyrfmt f.cyr --check`
    # printed the formatted text to stdout and exited 0: a check that answered a
    # different question and reported success. An unknown '-' token became the path.
    # Flags anywhere; unknown is an error; N files; rc is the MAX. CHANGELOG [6.6.5].
    var files = vec_new();
    var ai = 1;
    while (ai < argc()) {
        var a = argv(ai);
        if (streq(a, "--check") == 1) { _check_mode = 1; }
        elif (streq(a, "--write") == 1 || streq(a, "-w") == 1) { _write_mode = 1; }
        elif (streq(a, "--help") == 1 || streq(a, "-h") == 1) { _fmt_usage(); return 0; }
        elif (load8(a) == 45) {
            # stderr, token quoted — the wording every swept tool uses (round-3 review;
            # this one printed to STDOUT, unquoted, so a CI log grep for the rule missed it).
            sys_write(STDERR_FD, "cyrfmt: unknown option '", 24);
            sys_write(STDERR_FD, a, strlen(a));
            sys_write(STDERR_FD, "'\n", 2);
            return _fmt_usage();
        }
        else { vec_push(files, a); }
        ai = ai + 1;
    }
    if (_check_mode == 1 && _write_mode == 1) {
        println("cyrfmt: --check and --write are mutually exclusive");
        return 1;
    }
    if (vec_len(files) == 0) { return _fmt_usage(); }

    var rc = 0;
    var fi = 0;
    while (fi < vec_len(files)) {
        var one = _fmt_one(vec_get(files, fi));
        if (one > rc) { rc = one; }
        fi = fi + 1;
    }
    return rc;
}
var r = main();
syscall(60, r);
