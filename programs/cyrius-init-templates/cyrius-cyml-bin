[package]
name = "{PROJ}"
version = "${file:VERSION}"
description = "{DESCRIPTION}"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "{CYRIUS_VER}"

[build]
entry = "src/main.cyr"
output = "build/{PROJ}"

[deps]
stdlib = ["string", "fmt", "alloc", "io", "vec", "str", "syscalls"]

[test]
files = ["src/test.cyr"]
stdlib = ["assert", "bench"]
