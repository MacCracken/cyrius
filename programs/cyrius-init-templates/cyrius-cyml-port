[package]
name = "{PROJ}"
version = "0.1.0"
description = "{PROJ} — Cyrius port (from {SRC_LOC} lines of {SRC_LANG})"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "{CYRIUS_VER}"

[build]
entry = "src/main.cyr"
output = "{PROJ}"

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args", "assert"]
