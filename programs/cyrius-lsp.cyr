# cyrius-lsp — Language Server Protocol implementation for Cyrius
# Protocol: JSON-RPC 2.0 over stdin/stdout
#
# Usage: cyrius-lsp (launched by editor)
#
# Capabilities (advertised in `initialize`):
#   - diagnostics       — compile via the `cyrius` wrapper (so includes resolve)
#                         + parse cycc's stderr into errors/warnings
#   - definitionProvider     — cross-file go-to-definition (symbol table)
#   - documentSymbolProvider — file outline
#   - referencesProvider     — find-all-uses
#   - semanticTokensProvider — keyword / fn / var / type / param coloring
#   - hoverProvider          — symbol kind + definition site (v6.1.24)
#
# Supported methods:
#   initialize → capabilities ; initialized (no-op) ; shutdown/exit
#   textDocument/didOpen|didSave|didChange → recompile + publishDiagnostics + index
#   textDocument/definition → Location
#   textDocument/hover → Hover (markdown)
#   textDocument/documentSymbol → SymbolInformation[]
#   textDocument/references → Location[]
#   textDocument/semanticTokens/full → SemanticTokens

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
# 6.6.10: the declaration reader the CLI uses (`cyrius coverage`, `cyrius distlib`) — ONE
# answer to "what does this file declare at top level". See lsp_index_file.
include "cbt/srcscan.cyr"

fn prints(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }

fn print_int_str(n): i64 {
    var buf[24];
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

# stderr logging for debug
fn log_msg(s): i64 {
    syscall(1, 2, "[cyrius-lsp] ", 13);
    syscall(1, 2, s, strlen(s));
    syscall(1, 2, "\n", 1);
    return 0;
}

# ================================================================
# JSON-RPC I/O
# ================================================================

# Read a Content-Length header from stdin, return the length
fn read_header(): i64 {
    var buf[256];
    var pos = 0;
    # Read until \r\n\r\n
    var found = 0;
    while (found == 0) {
        var n = syscall(0, 0, &buf + pos, 1);
        if (n <= 0) { return -1; }
        pos += 1;
        if (pos >= 4) {
            if (load8(&buf + pos - 4) == 13 && load8(&buf + pos - 3) == 10 && load8(&buf + pos - 2) == 13 && load8(&buf + pos - 1) == 10) {
                found = 1;
            }
        }
        if (pos >= 255) { return -1; }
    }
    store8(&buf + pos, 0);
    # Parse Content-Length: N
    var i = 0;
    while (i < pos) {
        if (memeq(&buf + i, "Content-Length: ", 16) == 1) {
            var num = 0;
            var j = i + 16;
            while (j < pos && load8(&buf + j) >= 48 && load8(&buf + j) <= 57) {
                num = num * 10 + load8(&buf + j) - 48;
                j += 1;
            }
            # v6.3.23 (DX-02): reject an out-of-range Content-Length from an
            # untrusted / malformed editor message. Without this a huge value
            # reaches read_body's alloc(n+1) (0 on > ALLOC_MAX) → read() into a
            # NULL page. Cap at 16 MB (no real LSP message approaches it) so the
            # framing rejects rather than faults; the main loop treats -1 as EOF.
            if (num > 16777216) { return -1; }
            return num;
        }
        i += 1;
    }
    return -1;
}

# Read exactly n bytes from stdin
fn read_body(n): i64 {
    var buf = alloc(n + 1);
    # v6.3.23 (DX-02): alloc returns 0 on failure (e.g. n+1 > ALLOC_MAX); never
    # read() into a NULL page — treat as EOF so the main loop shuts down cleanly.
    if (buf == 0) { return 0; }
    var total = 0;
    while (total < n) {
        var got = syscall(0, 0, buf + total, n - total);
        if (got <= 0) { return 0; }
        total += got;
    }
    store8(buf + n, 0);
    return buf;
}

# Send a JSON-RPC response
fn send_response(body): i64 {
    var blen = strlen(body);
    prints("Content-Length: ");
    print_int_str(blen);
    prints("\r\n\r\n");
    syscall(1, 1, body, blen);
    return 0;
}

# ================================================================
# JSON HELPERS
# ================================================================

# Find substring in JSON, return position after match or -1
fn json_find(json, key): i64 {
    var jlen = strlen(json);
    var klen = strlen(key);
    var i = 0;
    while (i + klen <= jlen) {
        if (memeq(json + i, key, klen) == 1) { return i + klen; }
        i += 1;
    }
    return -1;
}

# Extract string value after "key":" in JSON
# Handles both compact and spaced JSON (e.g. "uri": "..." or "uri":"...")
fn json_get_str(json, key): i64 {
    var pos = json_find(json, key);
    if (pos < 0) {
        # Try with space after colon (e.g. key = "\"uri\":" → try "\"uri\": ")
        # Build spaced variant: append space before searching
        var klen = strlen(key);
        var spaced = alloc(klen + 2);
        memcpy(spaced, key, klen);
        store8(spaced + klen, 32);
        store8(spaced + klen + 1, 0);
        pos = json_find(json, spaced);
        if (pos < 0) { return 0; }
    }
    # Skip to opening quote
    while (load8(json + pos) != 0 && load8(json + pos) != 34) { pos += 1; }
    if (load8(json + pos) != 34) { return 0; }
    pos += 1;
    var start = pos;
    while (load8(json + pos) != 0 && load8(json + pos) != 34) { pos += 1; }
    var len = pos - start;
    var result = alloc(len + 1);
    memcpy(result, json + start, len);
    store8(result + len, 0);
    return result;
}

# Extract integer "id" from JSON-RPC message
fn json_get_id(body): i64 {
    var id_pos = json_find(body, "\"id\":");
    if (id_pos < 0) { id_pos = json_find(body, "\"id\": "); }
    var id = 0;
    if (id_pos >= 0) {
        while (load8(body + id_pos) == 32) { id_pos += 1; }
        while (load8(body + id_pos) >= 48 && load8(body + id_pos) <= 57) {
            id = id * 10 + load8(body + id_pos) - 48;
            id_pos += 1;
        }
    }
    return id;
}

# Convert file:// URI to local path
# v6.3.23 (DX-02): does `path` contain a ".." path component? A component is a
# run between '/' separators (or string start/end). Detects "../", "/..", a
# leading "..", or a trailing "/.." — the workspace-traversal vectors — without
# false-positiving on names like "foo..bar" or "..." that merely contain dots.
fn _lsp_path_has_dotdot(path): i64 {
    var i = 0;
    while (load8(path + i) != 0) {
        var at_start = 0;
        if (i == 0) { at_start = 1; }
        elif (load8(path + i - 1) == 47) { at_start = 1; }   # previous char '/'
        if (at_start == 1) {
            if (load8(path + i) == 46 && load8(path + i + 1) == 46) {   # ".."
                var after = load8(path + i + 2);
                if (after == 0) { return 1; }        # trailing ".."
                if (after == 47) { return 1; }       # ".." followed by '/'
            }
        }
        i += 1;
    }
    return 0;
}

fn uri_to_path(uri): i64 {
    var ulen = strlen(uri);
    var path = 0;
    # Strip file:// prefix (7 chars)
    if (ulen > 7 && memeq(uri, "file://", 7) == 1) {
        var plen = ulen - 7;
        path = alloc(plen + 1);
        memcpy(path, uri + 7, plen);
        store8(path + plen, 0);
    } else {
        # No prefix, return as-is
        path = alloc(ulen + 1);
        memcpy(path, uri, ulen);
        store8(path + ulen, 0);
    }
    # v6.3.23 (DX-02): untrusted-workspace-input guard. A well-behaved editor
    # sends normalized absolute URIs; a ".." component is a traversal attempt to
    # read/index a file outside the workspace. Soft-fail to an empty string so
    # every caller's strlen/`.cyr`-suffix check rejects it without a NULL deref.
    if (_lsp_path_has_dotdot(path) == 1) {
        store8(path, 0);
    }
    return path;
}

# ================================================================
# COMPILER INTEGRATION
# ================================================================

# Global: path to cycc binary
var _cycc_path = 0;

# v5.11.56: path to cyrius wrapper binary. compile_and_capture
# prefers the wrapper for files inside a cyrius project (a tree
# containing cyrius.cyml) so [deps.*] resolution happens — that
# closes the undefined-stdlib-fn false-positive class flagged in
# the iron-boot papercut filing Item 2. Raw-cycc fallback retained
# for files outside any project tree.
var _cyrius_path = 0;

# ================================================================
# SYMBOL INDEX (v5.7.39)
# ================================================================
# Parallel-array symbol table for cross-file go-to-definition and
# document-outline support. Indexed lazily — every textDocument/
# didOpen / didChange / didSave triggers `lsp_index_file(path)`,
# which scans the file for top-level fn/var/enum/struct decls and
# recursively walks `include "..."` directives. A path is indexed
# at most once per LSP session (tracked by the indexed-path set, `_lsp_indexed_off`)
# to keep cost bounded.
#
# Sizing: every table GROWS (6.6.12). The six row arrays, the names buffer, the indexed-path
# set and its string buffer start small and double on demand through `_lsp_grow`; only a
# refused allocation stops indexing. Each file's path is interned ONCE, by
# `_lsp_mark_indexed`, and every symbol row stores that offset into `_lsp_indexed_buf`.
# ⛔ These were fixed caps that truncated SILENTLY — 4096 rows, 256 KB of names, 32 KB of
# paths, 256 files — and `_lsp_add_symbol` re-interned the path string for every symbol, so
# the 32 KB paths buffer bound first (~2,300 symbols for `lib/x.cyr` paths, ~500 for a
# 60-byte absolute path): definition() of sigil's last fn came back null. CHANGELOG [6.6.12]

var _lsp_symtab_cap = 1024;
var _lsp_names_cap = 65536;
var _lsp_paths_cap = 8192;
var _lsp_indexed_cap = 64;

# Per-symbol parallel arrays (grown together by `_lsp_add_symbol`; allocated in main()):
#   _sym_name_off   — offset into _sym_names_buf (start of name)
#   _sym_name_len   — length of the name in bytes
#   _sym_path_off   — offset into _lsp_indexed_buf (the file's path, interned once)
#   _sym_line       — 0-based line where the decl starts
#   _sym_col        — 0-based column where the IDENT starts
#   _sym_kind       — 1=fn, 2=var, 3=enum, 4=struct, 5=enum-member
var _sym_name_off = 0;
var _sym_name_len = 0;
var _sym_path_off = 0;
var _sym_line = 0;
var _sym_col = 0;
var _sym_kind = 0;
var _sym_count = 0;

# Backing buffer for the names
var _sym_names_buf = 0;
var _sym_names_used = 0;

# Per-path indexed-set: cstring offsets into _lsp_indexed_buf (poor-man's
# string-set; linear scan). The same offsets are the symbol rows' `_sym_path_off`.
var _lsp_indexed_off = 0;
var _lsp_indexed_count = 0;
var _lsp_indexed_buf = 0;
var _lsp_indexed_used = 0;

# v5.11.42: per-request local-name table for semanticTokens/full.
# Three parallel arrays sized at _LSP_LOCAL_CAP entries; allocated
# once at startup, cleared (count=0) per request. Stores (offset,
# length, kind) where offset/length point into the file buffer and
# kind is the semantic-token-type index (1=variable, 6=parameter).
# v5.9.10's narrow legend only colored symbol-table-resolved idents
# + keywords; this extension adds locals (`var X`) + fn parameters
# so editors with weak textmate fallback show coherent coloring.
var _LSP_LOCAL_CAP = 4096;
var _lsp_local_off = 0;
var _lsp_local_len = 0;
var _lsp_local_kind = 0;
var _lsp_local_count = 0;

# Alloc the symbol-table backing buffers once at startup.
fn lsp_index_init(): i64 {
    _sym_name_off = alloc(_lsp_symtab_cap * 8);
    _sym_name_len = alloc(_lsp_symtab_cap * 8);
    _sym_path_off = alloc(_lsp_symtab_cap * 8);
    _sym_line     = alloc(_lsp_symtab_cap * 8);
    _sym_col      = alloc(_lsp_symtab_cap * 8);
    _sym_kind     = alloc(_lsp_symtab_cap * 8);
    _sym_count    = 0;
    _sym_names_buf = alloc(_lsp_names_cap);
    _sym_names_used = 0;
    _lsp_indexed_off = alloc(_lsp_indexed_cap * 8);
    _lsp_indexed_count = 0;
    _lsp_indexed_buf = alloc(_lsp_paths_cap);
    _lsp_indexed_used = 0;
    # v5.11.42 locals table — allocated once, reused per request.
    _lsp_local_off  = alloc(_LSP_LOCAL_CAP * 8);
    _lsp_local_len  = alloc(_LSP_LOCAL_CAP * 8);
    _lsp_local_kind = alloc(_LSP_LOCAL_CAP * 8);
    _lsp_local_count = 0;
    return 0;
}

# Identifier-class predicates (parallel to programs/cyrlint.cyr's
# v5.7.32 _is_id_start / _is_id_cont — kept inline here so cyrius-lsp
# stays a self-contained program).
fn _lsp_id_start(c): i64 {
    if (c >= 65 && c <= 90)  { return 1; }   # A-Z
    if (c >= 97 && c <= 122) { return 1; }   # a-z
    if (c == 95)             { return 1; }   # _
    return 0;
}
fn _lsp_id_cont(c): i64 {
    if (_lsp_id_start(c) == 1) { return 1; }
    if (c >= 48 && c <= 57)    { return 1; } # 0-9
    return 0;
}

# Scan forward over [off..total) while bytes are id-cont; return the
# offset just past the IDENT.
fn _lsp_scan_id_end(buf, off, total): i64 {
    var p = off;
    while (p < total) {
        if (_lsp_id_cont(load8(buf + p)) == 0) { return p; }
        p = p + 1;
    }
    return total;
}

# Make the buffer at *buf_addr (cap bytes at *cap_addr) hold at least `need` bytes: double the
# cap until it fits, copy the live bytes to a fresh allocation and publish both. Returns 0, or
# -1 when the allocation is refused (the buffer is then left as it was). The old block is
# abandoned — the bump allocator has no free — which bounds the waste to the final size.
fn _lsp_grow(buf_addr, cap_addr, need): i64 {
    var cap = load64(cap_addr);
    if (need <= cap) { return 0; }
    var ncap = cap;
    if (ncap < 64) { ncap = 64; }
    while (ncap < need) { ncap = ncap * 2; }
    var nb = alloc(ncap);
    if (nb == 0) { return 0 - 1; }
    memcpy(nb, load64(buf_addr), cap);
    store64(buf_addr, nb);
    store64(cap_addr, ncap);
    return 0;
}

# Stash a cstring into a growable backing buffer; return the offset (or -1 if the buffer
# could not grow). Inserts a trailing NUL. Offsets stay valid across growth; pointers into
# the buffer do not, so readers add the offset to the CURRENT buffer.
fn _lsp_intern(buf_addr, used_addr, cap_addr, src, len): i64 {
    var used = load64(used_addr);
    if (_lsp_grow(buf_addr, cap_addr, used + len + 1) < 0) { return 0 - 1; }
    var off = used;
    var buf = load64(buf_addr);
    var i = 0;
    while (i < len) {
        store8(buf + off + i, load8(src + i));
        i = i + 1;
    }
    store8(buf + off + len, 0);
    store64(used_addr, used + len + 1);
    return off;
}

# Has this absolute path already been indexed? Linear scan over the
# indexed set (one row per included file, so O(n) is fine).
fn _lsp_already_indexed(path): i64 {
    var plen = strlen(path);
    var i = 0;
    while (i < _lsp_indexed_count) {
        var off = load64(_lsp_indexed_off + i * 8);
        var entry = _lsp_indexed_buf + off;
        if (memeq(entry, path, plen + 1) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Record `path` as indexed. Returns the offset of its interned copy in _lsp_indexed_buf — the
# `path_off` every symbol of the file stores — or -1 when an allocation is refused.
fn _lsp_mark_indexed(path): i64 {
    var ncap = _lsp_indexed_cap * 8;
    if (_lsp_grow(&_lsp_indexed_off, &ncap, (_lsp_indexed_count + 1) * 8) < 0) { return 0 - 1; }
    _lsp_indexed_cap = ncap / 8;
    var plen = strlen(path);
    var off = _lsp_intern(&_lsp_indexed_buf, &_lsp_indexed_used, &_lsp_paths_cap, path, plen);
    if (off < 0) { return 0 - 1; }
    store64(_lsp_indexed_off + _lsp_indexed_count * 8, off);
    _lsp_indexed_count = _lsp_indexed_count + 1;
    return off;
}

# Grow the six parallel symbol-row arrays together so row `_sym_count` fits. Returns 0, or -1
# when an allocation is refused (the table is then left as it was: the arrays that did grow
# keep their contents, and the cap only moves once all six have).
fn _lsp_grow_rows(): i64 {
    if (_sym_count < _lsp_symtab_cap) { return 0; }
    var need = (_sym_count + 1) * 8;
    var c0 = _lsp_symtab_cap * 8;
    var c1 = c0;
    var c2 = c0;
    var c3 = c0;
    var c4 = c0;
    var c5 = c0;
    if (_lsp_grow(&_sym_name_off, &c0, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_name_len, &c1, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_path_off, &c2, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_line, &c3, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_col, &c4, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_kind, &c5, need) < 0) { return 0 - 1; }
    _lsp_symtab_cap = c0 / 8;
    return 0;
}

# Append a symbol to the table. `name_src` + `name_len` describe the
# IDENT bytes; `path_off` is the file's offset in _lsp_indexed_buf (from
# _lsp_mark_indexed); line/col are 0-based; kind ∈ {1,2,3,4,5}. Returns 0
# on success, -1 when an allocation is refused.
fn _lsp_add_symbol(name_src, name_len, path_off, line, col, kind): i64 {
    if (_lsp_grow_rows() < 0) { return 0 - 1; }
    var no = _lsp_intern(&_sym_names_buf, &_sym_names_used, &_lsp_names_cap, name_src, name_len);
    if (no < 0) { return 0 - 1; }
    var i = _sym_count;
    store64(_sym_name_off + i * 8, no);
    store64(_sym_name_len + i * 8, name_len);
    store64(_sym_path_off + i * 8, path_off);
    store64(_sym_line     + i * 8, line);
    store64(_sym_col      + i * 8, col);
    store64(_sym_kind     + i * 8, kind);
    _sym_count = _sym_count + 1;
    return 0;
}

# Find next end-of-line offset starting at `start`; returns offset of
# the '\n' (or `total` if not found).
fn _lsp_find_eol(buf, start, total): i64 {
    var p = start;
    while (p < total) {
        if (load8(buf + p) == 10) { return p; }
        p = p + 1;
    }
    return total;
}

# Index a single file: scan for top-level fn/var/enum/struct decls and
# recursively walk `include "..."` directives. Path is the absolute
# cstring file path. Idempotent — second call on the same path is a
# no-op via _lsp_already_indexed. Returns 0 on success.
fn lsp_index_file(path): i64 {
    if (_lsp_already_indexed(path) == 1) { return 0; }
    var path_off = _lsp_mark_indexed(path);
    if (path_off < 0) { return 0; }    # allocation refused → soft-fail

    # Read the WHOLE file (6.6.10). This was a fixed 1 MB read — "enough for cyrius's largest
    # source" — but the stdlib it indexes through `include` is larger: lib/mabda.cyr is
    # 1.37 MB and lib/sigil.cyr 1.26 MB, so every declaration past the cut was unindexed.
    # And the buffer was stored through unchecked. An unreadable file indexes nothing.
    var total = 0;
    var buf = file_read_whole(path, &total);
    if (buf == 0) { return 0; }

    # Compute the directory of `path` for include-relative resolution.
    var path_len = strlen(path);
    var slash = 0 - 1;
    var pi = 0;
    while (pi < path_len) {
        if (load8(path + pi) == 47) { slash = pi; }
        pi = pi + 1;
    }
    var path_dir = 0;
    var path_dir_len = 0;
    if (slash >= 0) {
        path_dir_len = slash + 1;       # include trailing slash
        path_dir = alloc(path_dir_len + 1);
        var di = 0;
        while (di < path_dir_len) {
            store8(path_dir + di, load8(path + di));
            di = di + 1;
        }
        store8(path_dir + path_dir_len, 0);
    }

    var line = 0;
    var pos = 0;
    while (pos < total) {
        var eol = _lsp_find_eol(buf, pos, total);

        # `include "path/to/file.cyr"` — recurse.
        # Match at start-of-line (no leading whitespace; cyrius style).
        if (eol - pos > 9 && memeq(buf + pos, "include \"", 9) == 1) {
            var qs = pos + 9;
            var qe = qs;
            while (qe < eol && load8(buf + qe) != 34) { qe = qe + 1; }
            if (qe < eol && qe > qs) {
                var inc_len = qe - qs;
                # Try project-relative first (typical cyrius style:
                # `include "lib/string.cyr"` resolves from CWD).
                var inc_proj = alloc(inc_len + 1);
                var ii = 0;
                while (ii < inc_len) {
                    store8(inc_proj + ii, load8(buf + qs + ii));
                    ii = ii + 1;
                }
                store8(inc_proj + inc_len, 0);
                if (file_exists(inc_proj) == 1) {
                    lsp_index_file(inc_proj);
                } elif (path_dir != 0) {
                    # Fall back to relative-to-current-file dir.
                    var inc_rel = alloc(path_dir_len + inc_len + 1);
                    var ji = 0;
                    while (ji < path_dir_len) {
                        store8(inc_rel + ji, load8(path_dir + ji));
                        ji = ji + 1;
                    }
                    var ki = 0;
                    while (ki < inc_len) {
                        store8(inc_rel + path_dir_len + ki, load8(buf + qs + ki));
                        ki = ki + 1;
                    }
                    store8(inc_rel + path_dir_len + inc_len, 0);
                    if (file_exists(inc_rel) == 1) {
                        lsp_index_file(inc_rel);
                    }
                }
            }
        }
        pos = eol + 1;
        line = line + 1;
    }
    lsp_index_decls(buf, total, path_off);
    return 0;
}

# Record every top-level declaration of buf[0, total) under the file whose interned path is at
# `path_off` in _lsp_indexed_buf, through cbt/srcscan.cyr's
# `_src_decls` — the reader `cyrius coverage` and `cyrius distlib` use.
# ⛔ 6.6.10: this was a SIXTH hand-rolled declaration reader, and it matched only `fn `, `var `,
# `enum ` and `struct ` at COLUMN 0: no `pub`/`public`, no attribute (`#inline fn`), no
# indentation, no `fn<TAB>`, and `fn NAME` only when `(` followed the name at once (so no
# generic `fn f<T>(`). Go-to-definition and hover missed every `pub fn` — the 322 in
# lib/yukti.cyr among them. And it read comments and strings as code: a `fn x` inside a
# multi-line string was indexed. It reads a blanked COPY (the include scan above needs the
# raw paths), so a declaration in a comment or string is not one. CHANGELOG [6.6.10]
fn lsp_index_decls(buf, total, path_off): i64 {
    var cb = alloc(total + 1);
    if (cb == 0) { return 0; }
    memcpy(cb, buf, total);
    store8(cb + total, 0);
    _src_blank_noncode(cb, total);
    var offs = vec_new();
    var lens = vec_new();
    var kinds = vec_new();
    _src_decls(cb, total, offs, lens, kinds);
    # Offsets come out in file order, so the line/column of each is one forward walk.
    var line = 0;
    var ls = 0;
    var p = 0;
    var k = 0;
    while (k < vec_len(offs)) {
        var off = vec_get(offs, k);
        while (p < off) {
            if (load8(buf + p) == 10) { line = line + 1; ls = p + 1; }
            p = p + 1;
        }
        _lsp_add_symbol(buf + off, vec_get(lens, k), path_off, line, off - ls, vec_get(kinds, k));
        k = k + 1;
    }
    return 0;
}

# Look up a symbol name in the table; return the index of the first
# match (-1 if not found). Linear scan; future polish: hash if
# _sym_count grows past a few thousand and benchmarks ask.
fn lsp_lookup_symbol(name, name_len): i64 {
    var i = 0;
    while (i < _sym_count) {
        var nlen = load64(_sym_name_len + i * 8);
        if (nlen == name_len) {
            var noff = load64(_sym_name_off + i * 8);
            if (memeq(_sym_names_buf + noff, name, name_len) == 1) {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Map an LSP position (0-based line + character) on the given file
# content to the IDENT under the cursor. Returns (start_offset_in_buf,
# end_offset_in_buf) packed: start in low 32 bits, end in high 32. -1
# if no IDENT under the cursor.
fn lsp_ident_at_position(buf, total, target_line, target_char): i64 {
    var line = 0;
    var pos = 0;
    while (line < target_line && pos < total) {
        if (load8(buf + pos) == 10) { line = line + 1; }
        pos = pos + 1;
    }
    # `pos` is now at start of `target_line`. Advance `target_char`
    # bytes (LSP's offsets are UTF-16 code units in spec, but we treat
    # them as bytes — accurate for ASCII-only cyrius source).
    var p = pos + target_char;
    if (p >= total) { return 0 - 1; }
    # Walk backward to find IDENT start.
    var s = p;
    while (s > pos && _lsp_id_cont(load8(buf + s - 1)) == 1) { s = s - 1; }
    if (s > 0 && _lsp_id_start(load8(buf + s)) == 0) { return 0 - 1; }
    if (s == p && _lsp_id_start(load8(buf + s)) == 0) { return 0 - 1; }
    var e = _lsp_scan_id_end(buf, s, total);
    if (e == s) { return 0 - 1; }
    return s | (e << 32);
}

# The largest document lsp_read_file reads: 64 MiB. Far past any cyrius source (lib/mabda.cyr,
# the largest, is 1.4 MB) and well inside the 32-bit offsets lsp_ident_at_position packs.
var _LSP_DOC_MAX = 67108864;

# Read a file into a buffer sized by fstat; return the NUL-terminated buffer and write its
# length to *total_out (0 and 0 when the file cannot be opened, sized or held). This read
# through a fixed 1 MB buffer until 6.6.17, silently: a larger document was cut at 1 MB, so
# definition / hover / references / semantic tokens past the cut found nothing (lib/mabda.cyr
# and lib/sigil.cyr are both over 1 MB). A size over _LSP_DOC_MAX is refused by name on the
# log. CHANGELOG [6.6.17]
fn lsp_read_file(path, total_out): i64 {
    store64(total_out, 0);
    var fd = sys_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var st[144];   # STAT_BUFSZ bytes
    var size = 0 - 1;
    if (sys_fstat(fd, &st) == 0) { size = load64(&st + STAT_SIZE); }
    if (size < 0 || size > _LSP_DOC_MAX) {
        sys_close(fd);
        _lsp_refuse_doc(path, size);
        return 0;
    }
    var buf = alloc(size + 1);
    if (buf == 0) { sys_close(fd); return 0; }
    var total = 0;
    var n = 1;
    while (n > 0 && total < size) {
        n = sys_read(fd, buf + total, size - total);
        if (n > 0) { total = total + n; }
    }
    sys_close(fd);
    store8(buf + total, 0);
    store64(total_out, total);
    return buf;
}

# Name a document lsp_read_file will not read: its path and size (or that fstat failed).
fn _lsp_refuse_doc(path, size): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "not reading ");
    str_builder_add_cstr(sb, path);
    if (size < 0) {
        str_builder_add_cstr(sb, ": fstat failed, so its size is unknown");
    } else {
        str_builder_add_cstr(sb, ": ");
        str_builder_add_int(sb, size);
        str_builder_add_cstr(sb, " bytes, over the 67108864-byte (64 MiB) document limit");
    }
    log_msg(str_data(str_builder_build(sb)));
    return 0;
}

# Find cycc binary — check common locations
# v5.11.44: Resolve the LSP binary's install directory via
# /proc/self/exe — same pattern as
# programs/cyrius-init.cyr:_resolve_templates_dir. Lets find_cycc
# locate a co-installed cycc even when the LSP launcher
# (Claude Code, other editors with a minimal inherited env) wipes
# PATH and CYRIUS_HOME. Returns a pointer to the dir cstring or 0.
# See: docs/development/proposals/archived/cyrius-lsp-argv0-self-resolution.md
fn _resolve_install_dir(): i64 {
    var buf = alloc(4096);
    var n = sys_readlink("/proc/self/exe", buf, 4095);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    var i = n - 1;
    while (i >= 0) {
        if (load8(buf + i) == 47) { break; }
        i = i - 1;
    }
    if (i <= 0) { return 0; }
    store8(buf + i, 0);
    return buf;
}

fn find_cycc(): i64 {
    # v5.11.54: Try $HOME/.cyrius/bin/cycc FIRST — that's the symlink
    # to whatever ~/.cyrius/current points at (the LATEST installed
    # cyrius). Diagnostics should reflect the latest parser's view of
    # the source: a user editing a v5.11.51+ byte-array-literal file
    # in a project that pins `cyrius = "5.11.49"` in cyrius.cyml
    # should NOT see "expected ';'" errors from the .49 parser —
    # `cyrius build` still respects the pin for the actual binary
    # output, but the LSP showing OLDER-parser errors is a misleading
    # papercut (filed 2026-05-13 as gnoboot-lsp-byte-array-literal).
    # Falls back to v5.11.44's /proc/self/exe resolution if $HOME is
    # absent (editors with minimal-env LSP launchers — Claude Code
    # and similar — sometimes don't set HOME).
    var envfd = syscall(2, "/proc/self/environ", 0, 0);
    if (envfd >= 0) {
        var hbuf = alloc(32768);
        var htotal = 0;
        var hchunk = 1;
        while (hchunk > 0) {
            hchunk = syscall(0, envfd, hbuf + htotal, 32768 - htotal);
            if (hchunk > 0) { htotal += hchunk; }
        }
        syscall(3, envfd);
        var hpos = 0;
        while (hpos < htotal) {
            var hend = hpos;
            while (hend < htotal && load8(hbuf + hend) != 0) { hend += 1; }
            if (hend - hpos > 5 && memeq(hbuf + hpos, "HOME=", 5) == 1) {
                var hvstart = hpos + 5;
                var hvlen = hend - hvstart;
                var hsb = str_builder_new();
                var hval = alloc(hvlen + 1);
                memcpy(hval, hbuf + hvstart, hvlen);
                store8(hval + hvlen, 0);
                str_builder_add_cstr(hsb, hval);
                str_builder_add_cstr(hsb, "/.cyrius/bin/cycc");
                var p_latest = str_data(str_builder_build(hsb));
                var fd_latest = syscall(2, p_latest, 0, 0);
                if (fd_latest >= 0) { syscall(3, fd_latest); return p_latest; }
            }
            hpos = hend + 1;
        }
    }

    # v5.11.44: Self-resolve via /proc/self/exe. Handles the
    # editor-LSP-launcher case where PATH + CYRIUS_HOME + HOME are
    # all absent from the inherited env. Co-installed cycc in the
    # SAME version-snapshot as the LSP binary — used when the latest
    # symlink above is unreachable.
    var install_dir = _resolve_install_dir();
    if (install_dir != 0) {
        var sb_self = str_builder_new();
        str_builder_add_cstr(sb_self, install_dir);
        str_builder_add_cstr(sb_self, "/cycc");
        var p_self = str_data(str_builder_build(sb_self));
        var fd_self = syscall(2, p_self, 0, 0);
        if (fd_self >= 0) { syscall(3, fd_self); return p_self; }
    }

    # Try ./build/cycc
    var p1 = "build/cycc";
    var fd = syscall(2, p1, 0, 0);
    if (fd >= 0) { syscall(3, fd); return p1; }

    # Try /usr/local/lib/cyrius/cycc
    var p2 = "/usr/local/lib/cyrius/cycc";
    fd = syscall(2, p2, 0, 0);
    if (fd >= 0) { syscall(3, fd); return p2; }

    # Try CYRIUS_HOME/cycc via /proc/self/environ
    var envfd2 = syscall(2, "/proc/self/environ", 0, 0);
    if (envfd2 >= 0) {
        var ebuf = alloc(32768);
        var etotal = 0;
        var echunk = 1;
        while (echunk > 0) {
            echunk = syscall(0, envfd2, ebuf + etotal, 32768 - etotal);
            if (echunk > 0) { etotal += echunk; }
        }
        syscall(3, envfd2);
        var pos = 0;
        while (pos < etotal) {
            var end = pos;
            while (end < etotal && load8(ebuf + end) != 0) { end += 1; }
            if (end - pos > 12 && memeq(ebuf + pos, "CYRIUS_HOME=", 12) == 1) {
                var vstart = pos + 12;
                var vlen = end - vstart;
                var sb = str_builder_new();
                var val = alloc(vlen + 1);
                memcpy(val, ebuf + vstart, vlen);
                store8(val + vlen, 0);
                str_builder_add_cstr(sb, val);
                str_builder_add_cstr(sb, "/cycc");
                var p3 = str_data(str_builder_build(sb));
                fd = syscall(2, p3, 0, 0);
                if (fd >= 0) { syscall(3, fd); return p3; }
            }
            pos = end + 1;
        }
    }
    return 0;
}

# v5.11.56: find the `cyrius` wrapper binary. Mirrors find_cycc's
# search order (HOME/.cyrius/bin → install_dir → ./build → /usr/
# local/lib/cyrius → $CYRIUS_HOME). Returns 0 if not found;
# compile_and_capture falls back to raw cycc in that case.
fn find_cyrius(): i64 {
    var envfd = syscall(2, "/proc/self/environ", 0, 0);
    if (envfd >= 0) {
        var hbuf = alloc(32768);
        var htotal = 0;
        var hchunk = 1;
        while (hchunk > 0) {
            hchunk = syscall(0, envfd, hbuf + htotal, 32768 - htotal);
            if (hchunk > 0) { htotal += hchunk; }
        }
        syscall(3, envfd);
        var hpos = 0;
        while (hpos < htotal) {
            var hend = hpos;
            while (hend < htotal && load8(hbuf + hend) != 0) { hend += 1; }
            if (hend - hpos > 5 && memeq(hbuf + hpos, "HOME=", 5) == 1) {
                var hvstart = hpos + 5;
                var hvlen = hend - hvstart;
                var hsb = str_builder_new();
                var hval = alloc(hvlen + 1);
                memcpy(hval, hbuf + hvstart, hvlen);
                store8(hval + hvlen, 0);
                str_builder_add_cstr(hsb, hval);
                str_builder_add_cstr(hsb, "/.cyrius/bin/cyrius");
                var p_latest = str_data(str_builder_build(hsb));
                var fd_latest = syscall(2, p_latest, 0, 0);
                if (fd_latest >= 0) { syscall(3, fd_latest); return p_latest; }
            }
            hpos = hend + 1;
        }
    }
    var install_dir = _resolve_install_dir();
    if (install_dir != 0) {
        var sb_self = str_builder_new();
        str_builder_add_cstr(sb_self, install_dir);
        str_builder_add_cstr(sb_self, "/cyrius");
        var p_self = str_data(str_builder_build(sb_self));
        var fd_self = syscall(2, p_self, 0, 0);
        if (fd_self >= 0) { syscall(3, fd_self); return p_self; }
    }
    var p1 = "build/cyrius";
    var fd1 = syscall(2, p1, 0, 0);
    if (fd1 >= 0) { syscall(3, fd1); return p1; }
    var p2 = "/usr/local/lib/cyrius/cyrius";
    var fd2 = syscall(2, p2, 0, 0);
    if (fd2 >= 0) { syscall(3, fd2); return p2; }
    var envfd2 = syscall(2, "/proc/self/environ", 0, 0);
    if (envfd2 >= 0) {
        var ebuf = alloc(32768);
        var etotal = 0;
        var echunk = 1;
        while (echunk > 0) {
            echunk = syscall(0, envfd2, ebuf + etotal, 32768 - etotal);
            if (echunk > 0) { etotal += echunk; }
        }
        syscall(3, envfd2);
        var pos = 0;
        while (pos < etotal) {
            var end = pos;
            while (end < etotal && load8(ebuf + end) != 0) { end += 1; }
            if (end - pos > 12 && memeq(ebuf + pos, "CYRIUS_HOME=", 12) == 1) {
                var vstart = pos + 12;
                var vlen = end - vstart;
                var sb = str_builder_new();
                var val = alloc(vlen + 1);
                memcpy(val, ebuf + vstart, vlen);
                store8(val + vlen, 0);
                str_builder_add_cstr(sb, val);
                str_builder_add_cstr(sb, "/cyrius");
                var p3 = str_data(str_builder_build(sb));
                var fd3 = syscall(2, p3, 0, 0);
                if (fd3 >= 0) { syscall(3, fd3); return p3; }
            }
            pos = end + 1;
        }
    }
    return 0;
}

# v5.11.56: walk up from filepath looking for cyrius.cyml. Returns
# project root dir cstring on success, 0 if filepath is outside any
# cyrius project tree (caller falls back to raw cycc). Returned
# pointer is owned by the allocator; LSP doesn't free per-request
# buffers — alloc churn is bounded by edit cadence.
fn find_project_root(filepath): i64 {
    var flen = strlen(filepath);
    if (flen == 0) { return 0; }
    var pbuf = alloc(flen + 1);
    memcpy(pbuf, filepath, flen);
    store8(pbuf + flen, 0);
    var pos = flen;
    while (pos > 0) {
        pos = pos - 1;
        if (load8(pbuf + pos) == 47) {
            store8(pbuf + pos, 0);
            var sb = str_builder_new();
            str_builder_add_cstr(sb, pbuf);
            str_builder_add_cstr(sb, "/cyrius.cyml");
            var candidate = str_data(str_builder_build(sb));
            var ckfd = syscall(2, candidate, 0, 0);
            if (ckfd >= 0) {
                syscall(3, ckfd);
                var rlen = pos;
                var result = alloc(rlen + 1);
                memcpy(result, pbuf, rlen);
                store8(result + rlen, 0);
                return result;
            }
            store8(pbuf + pos, 47);
        }
    }
    return 0;
}

# v5.11.56: read /proc/self/environ and build a NULL-terminated
# envp[] array forwarding the LSP's environment to a child. The
# cyrius wrapper needs HOME (for ~/.cyrius resolution) and PATH
# (for git fallbacks during deps fetch); passing envp=NULL like
# raw cycc does breaks ~/.cyrius/versions/X.Y.Z/ lookup.
fn _build_envp_from_proc(): i64 {
    var envfd = syscall(2, "/proc/self/environ", 0, 0);
    if (envfd < 0) { return 0; }
    var buf = alloc(32768);
    var total = 0;
    var chunk = 1;
    while (chunk > 0 && total < 32767) {
        chunk = syscall(0, envfd, buf + total, 32767 - total);
        if (chunk > 0) { total += chunk; }
    }
    syscall(3, envfd);
    if (total == 0) { return 0; }
    store8(buf + total, 0);
    var count = 1;
    var i = 0;
    while (i < total - 1) {
        if (load8(buf + i) == 0) { count = count + 1; }
        i = i + 1;
    }
    var envp = alloc((count + 1) * 8);
    store64(envp, buf);
    var ei = 1;
    var ji = 0;
    while (ji < total - 1) {
        if (load8(buf + ji) == 0) {
            store64(envp + ei * 8, buf + ji + 1);
            ei = ei + 1;
        }
        ji = ji + 1;
    }
    store64(envp + ei * 8, 0);
    return envp;
}

# 6.6.20 — a failed fork (a process limit, memory) is said in the log, and the pipe is closed:
# `pid` is then -errno, and the parent used to read the pipe it still held both ends of — no
# child, so an immediate EOF — and publish EMPTY diagnostics for a file nobody compiled, then
# wait4 on a process group. Answers 0, the "could not launch" value both callers return.
fn _lsp_fork_failed(what, pid, pipe_read, pipe_write): i64 {
    sys_close(pipe_read);
    sys_close(pipe_write);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "could not start ");
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, ": fork failed (error ");
    str_builder_add_int(sb, 0 - pid);
    str_builder_add_cstr(sb, ") — no diagnostics for this file");
    log_msg(str_data(str_builder_build(sb)));
    return 0;
}

# Reap the diagnostics child (its status is not used — the diagnostics are what it wrote).
# The slot is zeroed and an EINTR retried, so the child is never left a zombie by a signal.
fn _lsp_reap(pid): i64 {
    var st[8];
    store64(&st, 0);
    var w = sys_waitpid(pid, &st, 0);
    while (w == 0 - 4) { w = sys_waitpid(pid, &st, 0); }
    return w;
}

# v5.11.56: fork cyrius wrapper with cwd=project_root, exec
# `cyrius check --with-deps --no-redirect <filepath>`. Wrapper handles [deps.*]
# resolution that raw cycc (read source from stdin, no project
# context) can't see. Closes the undefined-stdlib-fn false-positive
# class. Returns stderr buffer (never NULL except on pipe failure
# upstream of fork).
# 6.7.12 — `--no-redirect`: the open file is the unit. `--with-deps` alone keeps the CLI's legacy
# module redirect, which compiled `src/main.cyr` instead of any file with no `include`, so such a
# file showed the entry's diagnostics and never its own. A toolchain older than 6.7.12 (a project
# can pin one) refuses the flag by name; then the check runs again without it, as before.
# CHANGELOG [6.7.12]
fn _compile_via_wrapper(filepath, project_root): i64 {
    var out = _compile_via_wrapper_run(filepath, project_root, 1);
    if (out != 0 && _lsp_has(out, "unknown option '--no-redirect'") == 1) {
        log_msg("this project's cyrius predates --no-redirect (6.7.12): checking with the module redirect");
        out = _compile_via_wrapper_run(filepath, project_root, 0);
    }
    return out;
}

# `envp` (a NULL-terminated array, or 0 for none) for a check that reads no pin of its working
# directory: `CYRIUS_RESOLVED=1` — the CLI's own loop guard, which skips its version redirect
# (cbt/cyrius.cyr `_try_redirect_to_pinned`) — and `CYRIUS_NO_WARN_PIN_DRIFT=1` (cycc's drift
# warning, src/frontend/lex.cyr `_check_cyml_pin_drift`), any inherited entry of either name dropped
# (each reader takes the first). A fresh array. CHANGELOG [6.7.14]
fn _lsp_envp_unpinned(envp): i64 {
    var n = 0;
    if (envp != 0) { while (load64(envp + n * 8) != 0) { n = n + 1; } }
    var out = alloc((n + 3) * 8);
    var k = 0;
    var i = 0;
    while (i < n) {
        var e = load64(envp + i * 8);
        if (_lsp_env_named(e, "CYRIUS_RESOLVED=") == 0 && _lsp_env_named(e, "CYRIUS_NO_WARN_PIN_DRIFT=") == 0) {
            store64(out + k * 8, e);
            k = k + 1;
        }
        i = i + 1;
    }
    store64(out + k * 8, "CYRIUS_RESOLVED=1");
    store64(out + k * 8 + 8, "CYRIUS_NO_WARN_PIN_DRIFT=1");
    store64(out + k * 8 + 16, 0);
    return out;
}

# 1 when environment entry `e` begins with `key` (a `NAME=` cstr).
fn _lsp_env_named(e, key): i64 {
    var kl = strlen(key);
    if (strlen(e) < kl) { return 0; }
    return memeq(e, key, kl);
}

# 1 when the cstr `hay` contains the cstr `needle`.
fn _lsp_has(hay, needle): i64 {
    var hl = strlen(hay);
    var nl = strlen(needle);
    var i = 0;
    while (i + nl <= hl) {
        if (memeq(hay + i, needle, nl) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# One `cyrius check --with-deps [--no-redirect] <filepath>` run from `project_root`; its stderr.
# 6.7.13: `project_root` 0 = a file outside any project — `cyrius check <filepath>` (standalone,
# as `cyrius check` runs in a loose directory) from THIS server's working directory, no chdir.
# 6.7.14 (D47 / D54, the user 2026-10-16): that run reads no pin (`_lsp_envp_unpinned`): the
# server's working directory may be a project pinning a cyrius that is not installed, and its pin
# error is not the loose file's — the pin belongs to the project that pins it. So the CLI's version
# redirect is off, and so is cycc's drift warning about that same pin (`cyrius.cyml pins X but cycc
# is Y`), which the redirect being off would otherwise surface on the loose file instead. The
# project route keeps both. CHANGELOG [6.7.14]
fn _compile_via_wrapper_run(filepath, project_root, no_redirect): i64 {
    var pipe_fds[16];
    var pr = sys_pipe(&pipe_fds);
    if (pr < 0) { return 0; }
    var pipe_read = load32(&pipe_fds);
    var pipe_write = load32(&pipe_fds + 4);
    var pid = sys_fork();
    if (pid < 0) { return _lsp_fork_failed(_cyrius_path, pid, pipe_read, pipe_write); }   # 6.6.20
    if (pid == 0) {
        sys_close(pipe_read);
        var nfdi = sys_open("/dev/null", 0, 0);
        if (nfdi >= 0) { sys_dup2(nfdi, 0); sys_close(nfdi); }
        var nfdo = sys_open("/dev/null", 1, 0);
        if (nfdo >= 0) { sys_dup2(nfdo, 1); sys_close(nfdo); }
        sys_dup2(pipe_write, 2);
        sys_close(pipe_write);
        # v6.5.16: was a raw `syscall(80, ...)` on the "LSP is x86-only" assumption.
        # A raw x86 number is not portable AND it collides: 80 is the aarch64 peer's
        # SYS_FSTAT, so once the Mach-O arm branch routes 80→fstat64 this call would
        # have silently become an fstat on a path pointer instead of a chdir. The
        # wrapper renumbers per peer (x86-Linux 80, arm-macho alias 1049→12,
        # x86-macho 80→12) and is correct on every target. See the macho route
        # parity gate, tests/gates/platform/macho_route_parity.sh.
        var argv[48];   # N BYTES per CLAUDE.md buffer contract: 6 ptrs = 48 B
        var ai = 0;
        store64(&argv, _cyrius_path);
        store64(&argv + 8, "check");
        ai = 16;
        if (project_root != 0) {
            sys_chdir(project_root);
            store64(&argv + 16, "--with-deps");
            ai = 24;
            if (no_redirect == 1) { store64(&argv + ai, "--no-redirect"); ai = ai + 8; }
        }
        store64(&argv + ai, filepath);
        store64(&argv + ai + 8, 0);
        var envp = _build_envp_from_proc();
        if (project_root == 0) { envp = _lsp_envp_unpinned(envp); }
        if (envp == 0) {
            var envp_empty[1];
            store64(&envp_empty, 0);
            sys_execve(_cyrius_path, &argv, &envp_empty);
        } else {
            sys_execve(_cyrius_path, &argv, envp);
        }
        syscall(60, 127);
    }
    sys_close(pipe_write);
    var errbuf = alloc(8192);
    var total = 0;
    var chunk = 1;
    while (chunk > 0 && total < 8191) {
        chunk = syscall(0, pipe_read, errbuf + total, 8191 - total);
        if (chunk > 0) { total += chunk; }
    }
    store8(errbuf + total, 0);
    sys_close(pipe_read);
    _lsp_reap(pid);
    return errbuf;
}

# 6.7.13 — this server's working directory (a fresh string), or 0 when it cannot be read: the
# CLI's `_cwd_read` (cbt/deps.cyr) — Darwin has no getcwd syscall, so fcntl(F_GETPATH) on ".".
fn _lsp_cwd(): i64 {
    var buf = alloc(4096);
    #ifdef CYRIUS_TARGET_MACOS
    var fd = sys_open(".", 0, 0);
    if (fd < 0) { return 0; }
    var fr = sys_fcntl(fd, 50, buf);
    sys_close(fd);
    if (fr != 0) { return 0; }
    return buf;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    var n = syscall(79, buf, 4096);   # getcwd (aarch64: ESYSXLAT 79 -> 17)
    if (n <= 0) { return 0; }
    return buf;
    #endif
}

# 6.7.13 — `path` relative to `cwd` when it lies under it (`cwd` + "/" + rest: the rest), else
# `path` itself (also when `cwd` is 0).
fn _lsp_rel_to(cwd, path): i64 {
    if (cwd == 0) { return path; }
    var cl = strlen(cwd);
    if (cl == 1 && load8(cwd) == 47) {
        if (load8(path) == 47 && load8(path + 1) != 0) { return path + 1; }
        return path;
    }
    if (strlen(path) <= cl + 1) { return path; }
    if (memeq(path, cwd, cl) == 0) { return path; }
    if (load8(path + cl) != 47) { return path; }
    return path + cl + 1;
}

# 6.7.13 — the `#@incdir` the CLI writes for entry `unit` (cbt/build.cyr `_source_incdir`): its
# directory component when `unit` is relative, has one, and holds no `..` component; else 0 (no
# marker — cycc refuses an absolute or `..` directory).
fn _lsp_incdir(unit): i64 {
    var n = strlen(unit);
    if (n == 0 || load8(unit) == 47) { return 0; }
    var cut = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(unit + i) == 47) { cut = i; }
        i = i + 1;
    }
    if (cut <= 0) { return 0; }
    var j = 0;
    while (j < cut) {
        if (load8(unit + j) == 46 && load8(unit + j + 1) == 46) {
            if (j == 0 || load8(unit + j - 1) == 47) { return 0; }
        }
        j = j + 1;
    }
    var d = alloc(cut + 1);
    memcpy(d, unit, cut);
    store8(d + cut, 0);
    return d;
}

# 6.7.13 — in the cycc child: a pipe whose read end is cycc's stdin, fed by a forked writer with
# `#@incdir <incdir>\n#@srcline\n` (the incdir at byte 0, the only place cycc honours it; the
# srcline keeps `<source>` lines the file's own) and then the file open on `sfd`. The writer, not
# the server, writes the pipe, so the server only drains stderr and a cycc that stops reading
# kills nothing but the writer. Returns the read end, or `sfd` unchanged when the pipe or the
# fork fails (the file alone, as before). `errw` is the stderr pipe the writer must not hold.
fn _lsp_feed_incdir(sfd, incdir, errw): i64 {
    var fds[16];
    if (sys_pipe(&fds) < 0) { return sfd; }
    var rd = load32(&fds);
    var wr = load32(&fds + 4);
    var w = sys_fork();
    if (w < 0) {
        sys_close(rd);
        sys_close(wr);
        return sfd;
    }
    if (w == 0) {
        sys_close(rd);
        sys_close(errw);
        _lsp_write_all(wr, "#@incdir ", 9);
        _lsp_write_all(wr, incdir, strlen(incdir));
        _lsp_write_all(wr, "\n#@srcline\n", 11);
        var buf = alloc(32768);
        var k = sys_read(sfd, buf, 32768);
        while (k > 0) {
            if (_lsp_write_all(wr, buf, k) != 0) { k = 0; }
            else { k = sys_read(sfd, buf, 32768); }
        }
        sys_exit(0);
    }
    sys_close(wr);
    sys_close(sfd);
    return rd;
}

# Write all `n` bytes of `buf` to `fd`; 0, or -1 when a write fails.
fn _lsp_write_all(fd, buf, n): i64 {
    var off = 0;
    while (off < n) {
        var r = sys_write(fd, buf + off, n - off);
        if (r <= 0) { return 0 - 1; }
        off = off + r;
    }
    return 0;
}

# 6.7.12 — the directory the diagnostics' relative file names resolve against first: the project
# root when the last compile ran `cyrius check` there; (6.7.13) outside a project this server's
# working directory, where both loose routes compile (0 when it cannot be read).
var _lsp_last_root = 0;
# 6.7.13 — the name the last `cyrius check` outside a project was given for the file (relative to
# the working directory when under it), so its verdict line is known; 0 otherwise.
var _lsp_last_unit = 0;

# Run cycc on a file path, capture stderr for errors.
# Returns a pointer to the stderr output (null-terminated), or 0 on failure.
# v5.11.56: when both the cyrius wrapper and a project root are
# available, prefer wrapper-mode. Wrapper resolves [deps.*] before
# invoking cycc, which eliminates the false-positive
# `undefined function 'X' (will crash at runtime)` warnings for
# stdlib fns the consumer pulls via cyrius.cyml. Fall back to raw
# cycc (pre-.56 behavior) for files outside any project tree or
# when the wrapper isn't installed.
# ⛔ 6.7.13 — OUTSIDE A PROJECT, THE UNIT `cyrius check` COMPILES. cycc resolves an `include`
# against its working directory and then against the entry's directory — the latter only through
# the `#@incdir <dir>` line the CLI writes for an entry in a subdirectory. This forked cycc with
# the file itself on stdin, so a loose file's sibling include was `cannot open include file` unless
# the editor had started the server in that file's directory, while `cyrius check` from the same
# working directory said ok. Now, from this server's working directory and with the file named
# relative to it when it lies inside (`_lsp_rel_to`): the CLI when found runs `cyrius check <file>`
# (standalone), else cycc gets `#@incdir <dir>` + `#@srcline` ahead of the file through a pipe,
# by the CLI's own rule (`_lsp_incdir`: a relative, `..`-free directory). A file outside the
# working directory's subtree gets no marker, as `cyrius check` writes none there. Relative names
# in the diagnostics resolve against that directory first (`_lsp_last_root`). CHANGELOG [6.7.13]
fn compile_and_capture(filepath): i64 {
    _lsp_last_root = 0;
    _lsp_last_unit = 0;
    if (_cyrius_path != 0) {
        var project_root = find_project_root(filepath);
        if (project_root != 0) {
            _lsp_last_root = project_root;
            return _compile_via_wrapper(filepath, project_root);
        }
    }
    var cwd = _lsp_cwd();
    var unit = _lsp_rel_to(cwd, filepath);
    _lsp_last_root = cwd;
    if (_cyrius_path != 0) {
        _lsp_last_unit = unit;
        return _compile_via_wrapper_run(unit, 0, 0);
    }
    if (_cycc_path == 0) { return 0; }
    var incdir = _lsp_incdir(unit);

    # Create pipe for stderr capture
    var pipe_fds[16];
    var pr = sys_pipe(&pipe_fds);
    if (pr < 0) { return 0; }
    var pipe_read = load32(&pipe_fds);
    var pipe_write = load32(&pipe_fds + 4);

    var pid = sys_fork();
    if (pid < 0) { return _lsp_fork_failed(_cycc_path, pid, pipe_read, pipe_write); }   # 6.6.20
    if (pid == 0) {
        # Child: run cycc with source on stdin, /dev/null on stdout, pipe on stderr
        sys_close(pipe_read);

        var sfd = sys_open(filepath, 0, 0);
        if (sfd < 0) { syscall(60, 1); }
        if (incdir != 0) { sfd = _lsp_feed_incdir(sfd, incdir, pipe_write); }   # 6.7.13
        sys_dup2(sfd, 0);
        sys_close(sfd);

        # stdout → /dev/null
        var nfd = sys_open("/dev/null", 1, 0);
        if (nfd >= 0) {
            sys_dup2(nfd, 1);
            sys_close(nfd);
        }

        # stderr → pipe
        sys_dup2(pipe_write, 2);
        sys_close(pipe_write);

        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv, _cycc_path);
        store64(&argv + 8, 0);
        # envp = NULL (minimal env)
        var envp[16];
        store64(&envp, 0);
        sys_execve(_cycc_path, &argv, &envp);
        syscall(60, 127);
    }

    # Parent: read stderr from pipe
    sys_close(pipe_write);

    var errbuf = alloc(8192);
    var total = 0;
    var chunk = 1;
    while (chunk > 0 && total < 8191) {
        chunk = syscall(0, pipe_read, errbuf + total, 8191 - total);
        if (chunk > 0) { total += chunk; }
    }
    store8(errbuf + total, 0);
    sys_close(pipe_read);

    # Wait for child
    _lsp_reap(pid);

    return errbuf;
}

# ================================================================
# DIAGNOSTIC PARSING
# ================================================================

# Parse the compiler's stderr into LSP diagnostics and publish them.
# A diagnostic line is `error:<file>:<line>:<col>: <message>` (cycc; `<source>` for the unit it
# read), `error:<file>:<line>: <message>` or `error:<line>: <message>` (older forms), or a bare
# `error: <message>` (no location: published on the open file's line 0); `warning:` likewise.
# ⛔ 6.7.12 — this read only `error:<file>:<line>:`, skipping the file name unread: the column
# stayed in the message (`14: undefined variable …`), the range was always characters 0-100,
# and an error in an INCLUDED file was published on the open document at that line number.
# Now the column gives the range's start (col - 1, to the end of that source line) and leaves the
# message, and each diagnostic is published on the URI of the file it names. A relative name
# resolves as cycc resolved it: against the project root (the checker's working directory) when
# `cyrius check` ran there, then against the open file's directory (the entry's, `#@incdir`); a
# name that resolves to no file stays on the open file's line 0 with its location in the text.
# The files a unit published on are remembered, and a recompile that no longer names one
# publishes an empty list there, so a fixed include's error does not stick. CHANGELOG [6.7.12]
var _ld_file = 0;   # vec of cstr: the file each diagnostic is published on (resolved)
var _ld_line = 0;   # vec: 0-based line
var _ld_col = 0;    # vec: 0-based start character
var _ld_sev = 0;    # vec: 1 error, 2 warning
var _ld_ms = 0;     # vec: the message's start offset in the compiler's text
var _ld_me = 0;     # vec: its end offset
var _lsp_pub_units = 0;   # vec of cstr: per (unit, file) pair, the unit (an open document's path)
var _lsp_pub_files = 0;   # vec of cstr: the file that unit last published diagnostics on

# The digits at s[p, eol) as a number; *endp = the first non-digit (p when there is none).
fn _lsp_num(s, p, eol, endp): i64 {
    var v = 0;
    var q = p;
    while (q < eol && load8(s + q) >= 48 && load8(s + q) <= 57) {
        v = v * 10 + load8(s + q) - 48;
        q = q + 1;
    }
    store64(endp, q);
    return v;
}

# The directory of `path`, without its trailing slash ("" for a bare name).
fn _lsp_dir_of(path): i64 {
    var n = strlen(path);
    var slash = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { slash = i; }
        i = i + 1;
    }
    if (slash < 0) { slash = 0; }
    var d = alloc(slash + 1);
    memcpy(d, path, slash);
    store8(d + slash, 0);
    return d;
}

# `dir` + "/" + s[p, p + n) as a fresh cstr.
fn _lsp_join(dir, s, p, n): i64 {
    var dl = strlen(dir);
    var r = alloc(dl + n + 2);
    memcpy(r, dir, dl);
    store8(r + dl, 47);
    memcpy(r + dl + 1, s + p, n);
    store8(r + dl + 1 + n, 0);
    return r;
}

# The file a diagnostic names (s[p, p + n)), resolved: `<source>` is the open file; an absolute
# name is itself; a relative one is tried against `root` (when there is one) and then the open
# file's directory. 0 when it names no file there.
fn _lsp_resolve_file(s, p, n, open_path, root): i64 {
    if (n == 8 && memeq(s + p, "<source>", 8) == 1) { return open_path; }
    if (n > 0 && load8(s + p) == 47) {
        var a = alloc(n + 1);
        memcpy(a, s + p, n);
        store8(a + n, 0);
        return a;
    }
    if (root != 0) {
        var c1 = _lsp_join(root, s, p, n);
        if (file_exists(c1) == 1) { return c1; }
    }
    var c2 = _lsp_join(_lsp_dir_of(open_path), s, p, n);
    if (file_exists(c2) == 1) { return c2; }
    return 0;
}

var _lsp_ll_path = 0;   # the file _lsp_line_len last read, and its text
var _lsp_ll_buf = 0;
var _lsp_ll_len = 0;

# The length in bytes of 0-based line `line` of `path` (its `\r` excluded); -1 when the file or
# the line is not there.
fn _lsp_line_len(path, line): i64 {
    if (_lsp_ll_path == 0 || streq(_lsp_ll_path, path) == 0) {
        var tot = 0;
        _lsp_ll_buf = file_read_whole(path, &tot);
        _lsp_ll_len = tot;
        _lsp_ll_path = path;
    }
    if (_lsp_ll_buf == 0) { return 0 - 1; }
    var b = _lsp_ll_buf;
    var n = _lsp_ll_len;
    var i = 0;
    var l = 0;
    while (l < line && i < n) {
        if (load8(b + i) == 10) { l = l + 1; }
        i = i + 1;
    }
    if (l < line) { return 0 - 1; }
    var e = i;
    while (e < n && load8(b + e) != 10) { e = e + 1; }
    if (e > i && load8(b + e - 1) == 13) { e = e - 1; }
    return e - i;
}

# Append `s[a, b)` to `sb`, JSON-escaped (quote, backslash; a control byte becomes a space).
fn _lsp_json_esc(sb, s, a, b): i64 {
    var i = a;
    while (i < b) {
        var ch = load8(s + i);
        if (ch == 34) { str_builder_add_cstr(sb, "\\\""); }
        elif (ch == 92) { str_builder_add_cstr(sb, "\\\\"); }
        elif (ch < 32) { str_builder_add_cstr(sb, " "); }
        else {
            var cbuf[2];
            store8(&cbuf, ch);
            store8(&cbuf + 1, 0);
            str_builder_add_cstr(sb, &cbuf);
        }
        i = i + 1;
    }
    return 0;
}

# Record one parsed diagnostic.
fn _lsp_diag_add(file, line, col, sev, ms, me): i64 {
    vec_push(_ld_file, file);
    vec_push(_ld_line, line);
    vec_push(_ld_col, col);
    vec_push(_ld_sev, sev);
    vec_push(_ld_ms, ms);
    vec_push(_ld_me, me);
    return 0;
}

# 1 when line s[pos, eol) is the CLI's compile verdict for `open_path` — `error: <path> (compiler
# exit N)` or `… (the compiler did not exit normally)`, printed after the compiler's own
# diagnostics: it repeats them and is not one. (6.7.13) Outside a project the CLI was given the
# file relative to this server's working directory (`_lsp_last_unit`), and names it so.
fn _lsp_is_verdict(s, pos, eol, open_path): i64 {
    if (_lsp_verdict_for(s, pos, eol, open_path) == 1) { return 1; }
    if (_lsp_last_unit == 0) { return 0; }
    return _lsp_verdict_for(s, pos, eol, _lsp_last_unit);
}

# `_lsp_is_verdict` for the CLI's name of the unit, `path`.
fn _lsp_verdict_for(s, pos, eol, path): i64 {
    var ol = strlen(path);
    if (eol - pos < 7 + ol + 2) { return 0; }
    if (memeq(s + pos, "error: ", 7) != 1) { return 0; }
    if (memeq(s + pos + 7, path, ol) != 1) { return 0; }
    var t = pos + 7 + ol;
    if (eol - t >= 16 && memeq(s + t, " (compiler exit ", 16) == 1) { return 1; }
    if (eol - t >= 37 && memeq(s + t, " (the compiler did not exit normally)", 37) == 1) { return 1; }
    return 0;
}

# Parse one `error:` / `warning:` line, s[pos, eol), whose location starts at `p`.
fn _lsp_parse_diag(s, p, eol, sev, open_path, root): i64 {
    var endp[8];
    if (p < eol && load8(s + p) == 32) {   # `error: message` — no location
        _lsp_diag_add(open_path, 0, 0, sev, p + 1, eol);
        return 0;
    }
    # `error:N: message` — a line, no file
    var ln0 = _lsp_num(s, p, eol, &endp);
    var q0 = load64(&endp);
    if (q0 > p && q0 < eol && load8(s + q0) == 58) {
        var m0 = q0 + 1;
        if (m0 < eol && load8(s + m0) == 32) { m0 = m0 + 1; }
        if (ln0 > 0) { ln0 = ln0 - 1; }
        _lsp_diag_add(open_path, ln0, 0, sev, m0, eol);
        return 0;
    }
    # `error:<file>:<line>[:<col>]: message` — the file ends at the first `:<digits>:`
    var f = p;
    while (f < eol) {
        if (load8(s + f) == 58) {
            _lsp_num(s, f + 1, eol, &endp);
            var qd = load64(&endp);
            if (qd > f + 1 && qd < eol && load8(s + qd) == 58) { break; }
        }
        f = f + 1;
    }
    if (f >= eol) {   # no location found: the whole text on the open file
        _lsp_diag_add(open_path, 0, 0, sev, p, eol);
        return 0;
    }
    var line = _lsp_num(s, f + 1, eol, &endp);
    var q = load64(&endp) + 1;   # past the `:` after the line
    var col = 0 - 1;
    var cv = _lsp_num(s, q, eol, &endp);
    var qc = load64(&endp);
    if (qc > q && qc < eol && load8(s + qc) == 58) {
        col = cv;
        q = qc + 1;
    }
    var ms = q;
    if (ms < eol && load8(s + ms) == 32) { ms = ms + 1; }
    var file = _lsp_resolve_file(s, p, f - p, open_path, root);
    if (file == 0) {   # names no file the editor could open: keep the location in the text
        _lsp_diag_add(open_path, 0, 0, sev, p, eol);
        return 0;
    }
    if (line > 0) { line = line - 1; }
    var c0 = 0;
    if (col > 0) { c0 = col - 1; }
    _lsp_diag_add(file, line, c0, sev, ms, eol);
    return 0;
}

# Publish the diagnostics of the parsed set that sit on `file` as one notification on `uri`.
fn _lsp_publish_file(uri, file, s): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"");
    _lsp_json_esc(sb, uri, 0, strlen(uri));
    str_builder_add_cstr(sb, "\",\"diagnostics\":[");
    var n = 0;
    var i = 0;
    while (i < vec_len(_ld_file)) {
        if (file != 0 && streq(vec_get(_ld_file, i), file) == 1) {
            var line = vec_get(_ld_line, i);
            var c0 = vec_get(_ld_col, i);
            var ce = _lsp_line_len(file, line);
            if (ce < c0) { ce = c0; }
            if (n > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"range\":{\"start\":{\"line\":");
            str_builder_add_int(sb, line);
            str_builder_add_cstr(sb, ",\"character\":");
            str_builder_add_int(sb, c0);
            str_builder_add_cstr(sb, "},\"end\":{\"line\":");
            str_builder_add_int(sb, line);
            str_builder_add_cstr(sb, ",\"character\":");
            str_builder_add_int(sb, ce);
            str_builder_add_cstr(sb, "}},\"severity\":");
            str_builder_add_int(sb, vec_get(_ld_sev, i));
            str_builder_add_cstr(sb, ",\"source\":\"cyrius\",\"message\":\"");
            _lsp_json_esc(sb, s, vec_get(_ld_ms, i), vec_get(_ld_me, i));
            str_builder_add_cstr(sb, "\"}");
            n = n + 1;
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}}");
    send_response(str_data(str_builder_build(sb)));
    return n;
}

# "file://" + path.
fn _lsp_uri_of(path): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "file://");
    str_builder_add_cstr(sb, path);
    return str_data(str_builder_build(sb));
}

# 1 when the cstr vec `v` holds a string equal to `x`.
fn _lsp_vec_has(v, x): i64 {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), x) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Publish the compile of the open document (`uri`, at `open_path`) from its stderr text; `root`
# as for _lsp_resolve_file. Answers the number of diagnostics published.
fn parse_and_send_diagnostics(uri, open_path, stderr_output, root): i64 {
    _ld_file = vec_new();
    _ld_line = vec_new();
    _ld_col = vec_new();
    _ld_sev = vec_new();
    _ld_ms = vec_new();
    _ld_me = vec_new();
    _lsp_ll_path = 0;
    if (_lsp_pub_units == 0) { _lsp_pub_units = vec_new(); _lsp_pub_files = vec_new(); }
    var s = stderr_output;
    var slen = strlen(s);
    var errors = 0;
    var verdicts = vec_new();
    var pos = 0;
    while (pos < slen) {
        var eol = pos;
        while (eol < slen && load8(s + eol) != 10) { eol = eol + 1; }
        var sev = 0;
        var p = pos;
        if (eol - pos > 6 && memeq(s + pos, "error:", 6) == 1) { sev = 1; p = pos + 6; }
        elif (eol - pos > 8 && memeq(s + pos, "warning:", 8) == 1) { sev = 2; p = pos + 8; }
        if (sev > 0) {
            if (_lsp_is_verdict(s, pos, eol, open_path) == 1) {
                vec_push(verdicts, pos);
            } else {
                _lsp_parse_diag(s, p, eol, sev, open_path, root);
                if (sev == 1) { errors = errors + 1; }
            }
        }
        pos = eol + 1;
    }
    # The CLI's verdict repeats the compiler's errors; it is shown only when there are none.
    if (errors == 0) {
        var vi = 0;
        while (vi < vec_len(verdicts)) {
            var vp = vec_get(verdicts, vi);
            var ve = vp;
            while (ve < slen && load8(s + ve) != 10) { ve = ve + 1; }
            _lsp_diag_add(open_path, 0, 0, 1, vp + 7, ve);
            vi = vi + 1;
        }
    }
    # The open document always gets its list (an empty one clears it); then each other file named.
    var files = vec_new();
    var total = _lsp_publish_file(uri, open_path, s);
    var i = 0;
    while (i < vec_len(_ld_file)) {
        var f = vec_get(_ld_file, i);
        if (streq(f, open_path) == 0 && _lsp_vec_has(files, f) == 0) {
            vec_push(files, f);
            total = total + _lsp_publish_file(_lsp_uri_of(f), f, s);
        }
        i = i + 1;
    }
    # Clear what this unit published last time and no longer names; remember what it named now.
    var keep_u = vec_new();
    var keep_f = vec_new();
    var j = 0;
    while (j < vec_len(_lsp_pub_units)) {
        var uj = vec_get(_lsp_pub_units, j);
        var fj = vec_get(_lsp_pub_files, j);
        if (streq(uj, open_path) == 1) {
            if (_lsp_vec_has(files, fj) == 0) { _lsp_publish_file(_lsp_uri_of(fj), 0, s); }
        } else {
            vec_push(keep_u, uj);
            vec_push(keep_f, fj);
        }
        j = j + 1;
    }
    var k = 0;
    while (k < vec_len(files)) {
        vec_push(keep_u, open_path);
        vec_push(keep_f, vec_get(files, k));
        k = k + 1;
    }
    _lsp_pub_units = keep_u;
    _lsp_pub_files = keep_f;
    log_msg("sent diagnostics");
    return total;
}

# ================================================================
# LSP METHODS
# ================================================================

fn handle_initialize(body) : i64 {
    var id = json_get_id(body);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":{\"capabilities\":{");
    str_builder_add_cstr(sb, "\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":true},");
    # v5.7.39: advertise definitionProvider + documentSymbolProvider.
    # `textDocument/semanticTokens/full` deferred to a future slot —
    # the slot framing of "polish" landed cross-file resolution +
    # go-to-def first; semantic tokens earn their own slot when
    # consumer pull surfaces.
    str_builder_add_cstr(sb, "\"definitionProvider\":true,");
    str_builder_add_cstr(sb, "\"documentSymbolProvider\":true,");
    # v6.1.24: textDocument/hover — reuses the cross-file symbol table to show a
    # symbol's kind + where it's defined when the cursor rests on an identifier.
    str_builder_add_cstr(sb, "\"hoverProvider\":true,");
    # v5.9.10: textDocument/references (find-all-uses) on top of the
    # v5.7.39 cross-file symbol-table infrastructure.
    str_builder_add_cstr(sb, "\"referencesProvider\":true,");
    # v5.9.10: textDocument/semanticTokens/full. v5.11.42: legend
    # extended with `parameter` (index 6); coverage extended to
    # color `var X` locals as `variable` and `fn(args)` params as
    # `parameter` via a per-request pre-walk collector (see
    # `_lsp_collect_locals` + `_lsp_lookup_local`). Type idents in
    # signatures (`x: i64`, `: Result`) still fall through to
    # symbol-table lookup — user-defined struct/enum types get
    # their existing colors; built-in primitive types stay
    # uncolored. Editors fall back to textmate grammar for the
    # remaining uncolored bytes (literals, operators, comments).
    str_builder_add_cstr(sb, "\"semanticTokensProvider\":{");
    str_builder_add_cstr(sb, "\"legend\":{\"tokenTypes\":[\"function\",\"variable\",\"struct\",\"enum\",\"enumMember\",\"keyword\",\"parameter\"],\"tokenModifiers\":[]},");
    str_builder_add_cstr(sb, "\"full\":true}");
    str_builder_add_cstr(sb, "}}}");
    send_response(str_data(str_builder_build(sb)));
    log_msg("initialized");
    return 0;
}

fn handle_shutdown(body): i64 {
    var id = json_get_id(body);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":null}");
    send_response(str_data(str_builder_build(sb)));
    log_msg("shutdown");
    return 0;
}

fn handle_did_open_or_save(body): i64 {
    var uri = json_get_str(body, "\"uri\":");
    if (uri == 0) { return 0; }

    var path = uri_to_path(uri);
    log_msg(path);

    # Every extension the documented `.lsp.json` routes here (editor-integration.md). Until 6.7.12
    # only `.cyr` was compiled and indexed: a `.tcyr` / `.bcyr` / `.fcyr` / `.scyr` / `.smcyr`
    # returned before both and got no diagnostics at all. CHANGELOG [6.7.12]
    if (_lsp_is_cyrius_doc(path) == 0) { return 0; }

    # v5.7.39: index this file (and transitive includes) into the
    # symbol table for go-to-def + outline. Idempotent — second
    # didOpen on the same file is a no-op via _lsp_already_indexed.
    lsp_index_file(path);

    var stderr_out = compile_and_capture(path);
    if (stderr_out == 0) {
        # Compilation failed to launch — clear diagnostics
        parse_and_send_diagnostics(uri, path, "", 0);
        return 0;
    }

    parse_and_send_diagnostics(uri, path, stderr_out, _lsp_last_root);
    return 0;
}

# 1 when `path` ends in one of the cyrius source extensions the server compiles and indexes:
# .cyr, .tcyr, .bcyr, .fcyr, .scyr, .smcyr.
fn _lsp_is_cyrius_doc(path): i64 {
    if (_lsp_ends(path, ".cyr") == 1) { return 1; }
    if (_lsp_ends(path, ".tcyr") == 1) { return 1; }
    if (_lsp_ends(path, ".bcyr") == 1) { return 1; }
    if (_lsp_ends(path, ".fcyr") == 1) { return 1; }
    if (_lsp_ends(path, ".scyr") == 1) { return 1; }
    if (_lsp_ends(path, ".smcyr") == 1) { return 1; }
    return 0;
}

# 1 when the cstr `s` ends with the cstr `suf` (and is longer than it).
fn _lsp_ends(s, suf): i64 {
    var n = strlen(s);
    var k = strlen(suf);
    if (n <= k) { return 0; }
    return memeq(s + n - k, suf, k);
}

# v5.7.39: textDocument/definition.
# Request:  { ..., params: { textDocument: { uri: "..." }, position: { line: N, character: M } } }
# Response: { ..., result: Location | Location[] | null }
# We re-read the file content from disk (we don't cache document
# state across messages), find the IDENT at the cursor, and look it
# up in the symbol table.
fn handle_definition(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");

    # Parse line + character from "position":{...}.
    # Reuse the substring approach used elsewhere; keep simple.
    var line_pos = json_find(body, "\"line\":");
    if (line_pos < 0) { line_pos = json_find(body, "\"line\": "); }
    var line_val = 0;
    if (line_pos >= 0) {
        var p = line_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            line_val = line_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }
    var ch_pos = json_find(body, "\"character\":");
    if (ch_pos < 0) { ch_pos = json_find(body, "\"character\": "); }
    var ch_val = 0;
    if (ch_pos >= 0) {
        var p = ch_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            ch_val = ch_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }

    # Re-read the file. Symbol table doesn't store source text;
    # re-read is O(file size) per request which is fine for human-
    # interactive editor traffic.
    var path = 0;
    if (uri != 0) { path = uri_to_path(uri); }

    var found = 0;
    var resp_line = 0;
    var resp_col = 0;
    var resp_path = 0;
    if (path != 0) {
        var total_out[1];
        var buf = lsp_read_file(path, &total_out);
        var total = load64(&total_out);
        if (buf != 0 && total > 0) {
            var packed = lsp_ident_at_position(buf, total, line_val, ch_val);
            if (packed >= 0) {
                var s = packed & 0xFFFFFFFF;
                var e = (packed >> 32) & 0xFFFFFFFF;
                var name_len = e - s;
                # Look up in the symbol table.
                var idx = lsp_lookup_symbol(buf + s, name_len);
                if (idx >= 0) {
                    found = 1;
                    resp_line = load64(_sym_line + idx * 8);
                    resp_col  = load64(_sym_col  + idx * 8);
                    var po = load64(_sym_path_off + idx * 8);
                    resp_path = _lsp_indexed_buf + po;
                }
            }
        }
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    if (found == 1) {
        # Build a single-Location response. Range is the full IDENT;
        # we don't track end-col separately, so emit start+name_len.
        # Reading name_len back from the table is cheaper than
        # recomputing.
        str_builder_add_cstr(sb, ",\"result\":{\"uri\":\"file://");
        str_builder_add_cstr(sb, resp_path);
        str_builder_add_cstr(sb, "\",\"range\":{\"start\":{\"line\":");
        str_builder_add_int(sb, resp_line);
        str_builder_add_cstr(sb, ",\"character\":");
        str_builder_add_int(sb, resp_col);
        str_builder_add_cstr(sb, "},\"end\":{\"line\":");
        str_builder_add_int(sb, resp_line);
        str_builder_add_cstr(sb, ",\"character\":");
        # Approximate end: start col + name length (we have to recompute).
        var idx2 = 0;
        var end_col = resp_col + 1;
        while (idx2 < _sym_count) {
            var po2 = load64(_sym_path_off + idx2 * 8);
            if (memeq(_lsp_indexed_buf + po2, resp_path, strlen(resp_path) + 1) == 1) {
                if (load64(_sym_line + idx2 * 8) == resp_line) {
                    if (load64(_sym_col + idx2 * 8) == resp_col) {
                        end_col = resp_col + load64(_sym_name_len + idx2 * 8);
                        idx2 = _sym_count;
                    }
                }
            }
            idx2 = idx2 + 1;
        }
        str_builder_add_int(sb, end_col);
        str_builder_add_cstr(sb, "}}}}");
    } else {
        str_builder_add_cstr(sb, ",\"result\":null}");
    }
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# Map cyrius symbol kind to a human display string for hover.
fn _lsp_kind_name(k): i64 {
    if (k == 1) { return "fn"; }
    if (k == 2) { return "var"; }
    if (k == 3) { return "enum"; }
    if (k == 4) { return "struct"; }
    if (k == 5) { return "enum member"; }
    return "symbol";
}

# v6.1.24: textDocument/hover. Resolves the identifier under the cursor in the
# cross-file symbol table (same path as go-to-definition) and returns its kind +
# definition site as a markdown Hover. result:null when the cursor isn't on a
# known symbol. Mirrors handle_definition's position parsing + re-read-from-disk.
fn handle_hover(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");
    var line_pos = json_find(body, "\"line\":");
    if (line_pos < 0) { line_pos = json_find(body, "\"line\": "); }
    var line_val = 0;
    if (line_pos >= 0) {
        var p = line_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            line_val = line_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }
    var ch_pos = json_find(body, "\"character\":");
    if (ch_pos < 0) { ch_pos = json_find(body, "\"character\": "); }
    var ch_val = 0;
    if (ch_pos >= 0) {
        var p2 = ch_pos;
        while (load8(body + p2) == 32) { p2 = p2 + 1; }
        while (load8(body + p2) >= 48 && load8(body + p2) <= 57) {
            ch_val = ch_val * 10 + load8(body + p2) - 48;
            p2 = p2 + 1;
        }
    }
    var path = 0;
    if (uri != 0) { path = uri_to_path(uri); }

    var found = 0;
    var h_kind = 0;
    var h_path = 0;
    var h_line = 0;
    var h_name = 0;     # buf address of the ident
    var h_name_len = 0;
    if (path != 0) {
        var total_out[1];
        var buf = lsp_read_file(path, &total_out);
        var total = load64(&total_out);
        if (buf != 0 && total > 0) {
            var packed = lsp_ident_at_position(buf, total, line_val, ch_val);
            if (packed >= 0) {
                var s = packed & 0xFFFFFFFF;
                var e = (packed >> 32) & 0xFFFFFFFF;
                var nlen = e - s;
                var idx = lsp_lookup_symbol(buf + s, nlen);
                if (idx >= 0) {
                    found = 1;
                    h_kind = load64(_sym_kind + idx * 8);
                    var po = load64(_sym_path_off + idx * 8);
                    h_path = _lsp_indexed_buf + po;
                    h_line = load64(_sym_line + idx * 8);
                    h_name = buf + s;
                    h_name_len = nlen;
                }
            }
        }
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    if (found == 1) {
        # value = "**<kind>** `<name>`\n\nDefined at <path>:<line+1>"
        str_builder_add_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"**");
        str_builder_add_cstr(sb, _lsp_kind_name(h_kind));
        str_builder_add_cstr(sb, "** `");
        var i = 0;
        while (i < h_name_len) { str_builder_add_byte(sb, load8(h_name + i)); i = i + 1; }
        str_builder_add_cstr(sb, "`\\n\\nDefined at ");
        str_builder_add_cstr(sb, h_path);
        str_builder_add_cstr(sb, ":");
        str_builder_add_int(sb, h_line + 1);
        str_builder_add_cstr(sb, "\"}}}");
    } else {
        str_builder_add_cstr(sb, ",\"result\":null}");
    }
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# Map cyrius symbol kind to LSP SymbolKind enum.
#   1=fn → SymbolKind.Function (12)
#   2=var → SymbolKind.Variable (13)
#   3=enum → SymbolKind.Enum (10)
#   4=struct → SymbolKind.Struct (23)
#   5=enum-member → SymbolKind.EnumMember (22)
fn _lsp_kind_to_lsp(k): i64 {
    if (k == 1) { return 12; }
    if (k == 2) { return 13; }
    if (k == 3) { return 10; }
    if (k == 4) { return 23; }
    if (k == 5) { return 22; }
    return 13;
}

# v5.7.39: textDocument/documentSymbol.
# Returns SymbolInformation[] for the requested file (flat list, not
# the hierarchical DocumentSymbol[] form — the flat form is well-
# supported across editor clients and matches our flat index).
fn handle_document_symbol(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");
    var path = 0;
    if (uri != 0) { path = uri_to_path(uri); }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":[");

    var first = 1;
    if (path != 0) {
        var path_len = strlen(path);
        var i = 0;
        while (i < _sym_count) {
            var po = load64(_sym_path_off + i * 8);
            if (memeq(_lsp_indexed_buf + po, path, path_len + 1) == 1) {
                if (first == 0) { str_builder_add_cstr(sb, ","); }
                first = 0;
                var sym_line = load64(_sym_line + i * 8);
                var sym_col = load64(_sym_col + i * 8);
                var sym_kind = load64(_sym_kind + i * 8);
                var sym_no = load64(_sym_name_off + i * 8);
                var sym_nl = load64(_sym_name_len + i * 8);
                str_builder_add_cstr(sb, "{\"name\":\"");
                # Add the IDENT name (no escaping needed — IDENTs are
                # ASCII alphanumerics + underscore).
                var name_buf = alloc(sym_nl + 1);
                var ni = 0;
                while (ni < sym_nl) {
                    store8(name_buf + ni, load8(_sym_names_buf + sym_no + ni));
                    ni = ni + 1;
                }
                store8(name_buf + sym_nl, 0);
                str_builder_add_cstr(sb, name_buf);
                str_builder_add_cstr(sb, "\",\"kind\":");
                str_builder_add_int(sb, _lsp_kind_to_lsp(sym_kind));
                str_builder_add_cstr(sb, ",\"location\":{\"uri\":\"file://");
                str_builder_add_cstr(sb, path);
                str_builder_add_cstr(sb, "\",\"range\":{\"start\":{\"line\":");
                str_builder_add_int(sb, sym_line);
                str_builder_add_cstr(sb, ",\"character\":");
                str_builder_add_int(sb, sym_col);
                str_builder_add_cstr(sb, "},\"end\":{\"line\":");
                str_builder_add_int(sb, sym_line);
                str_builder_add_cstr(sb, ",\"character\":");
                str_builder_add_int(sb, sym_col + sym_nl);
                str_builder_add_cstr(sb, "}}}}");
            }
            i = i + 1;
        }
    }
    str_builder_add_cstr(sb, "]}");
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# v5.9.10: textDocument/references.
# Request:  { ..., params: { textDocument: { uri }, position: { line, character }, context: { includeDeclaration: bool } } }
# Response: Location[] | null
#
# Semantics: find every IDENT token in every indexed file whose
# byte-content equals the IDENT at the cursor. Returns each as a
# Location. The `context.includeDeclaration` flag is honored
# implicitly — declarations ARE matches by name, so they appear
# in the result; we don't expose a separate "exclude
# declarations" path because the symbol table doesn't tag use
# sites separately from decl sites.
#
# Cost: O(sum of indexed-file sizes) per request. For a project
# of ~50 files / ~30 KLOC that's a few MB of ident tokenization
# — acceptable for human-interactive editor traffic. If a
# downstream consumer surfaces latency pressure, a future slot
# can build a reverse index keyed by ident hash.
fn handle_references(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");

    var line_pos = json_find(body, "\"line\":");
    if (line_pos < 0) { line_pos = json_find(body, "\"line\": "); }
    var line_val = 0;
    if (line_pos >= 0) {
        var p = line_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            line_val = line_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }
    var ch_pos = json_find(body, "\"character\":");
    if (ch_pos < 0) { ch_pos = json_find(body, "\"character\": "); }
    var ch_val = 0;
    if (ch_pos >= 0) {
        var p = ch_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            ch_val = ch_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }

    var target_off = 0;
    var target_len = 0;
    if (uri != 0) {
        var src_path = uri_to_path(uri);
        var total_out[1];
        var src_buf = lsp_read_file(src_path, &total_out);
        var total = load64(&total_out);
        if (src_buf != 0 && total > 0) {
            var packed = lsp_ident_at_position(src_buf, total, line_val, ch_val);
            if (packed >= 0) {
                var s = packed & 0xFFFFFFFF;
                var e = (packed >> 32) & 0xFFFFFFFF;
                target_len = e - s;
                # Snapshot ident bytes — src_buf gets reused below.
                target_off = alloc(target_len);
                var i = 0;
                while (i < target_len) {
                    store8(target_off + i, load8(src_buf + s + i));
                    i = i + 1;
                }
            }
        }
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":[");

    var first = 1;
    if (target_len > 0) {
        var fi = 0;
        while (fi < _lsp_indexed_count) {
            var off = load64(_lsp_indexed_off + fi * 8);
            var path = _lsp_indexed_buf + off;

            var fb_total[1];
            var fb = lsp_read_file(path, &fb_total);
            var ftotal = load64(&fb_total);
            if (fb != 0 && ftotal > 0) {
                var p = 0;
                var line_no = 0;
                var line_start = 0;
                while (p < ftotal) {
                    var c = load8(fb + p);
                    if (c == 10) {
                        line_no = line_no + 1;
                        line_start = p + 1;
                        p = p + 1;
                    } else {
                        if (_lsp_id_start(c) == 1) {
                            var id_start = p;
                            var id_end = _lsp_scan_id_end(fb, p, ftotal);
                            var id_len = id_end - id_start;
                            if (id_len == target_len) {
                                var match_ok = 1;
                                var k = 0;
                                while (k < id_len) {
                                    if (load8(fb + id_start + k) != load8(target_off + k)) {
                                        match_ok = 0;
                                        k = id_len;
                                    } else {
                                        k = k + 1;
                                    }
                                }
                                if (match_ok == 1) {
                                    var col = id_start - line_start;
                                    if (first == 0) { str_builder_add_cstr(sb, ","); }
                                    first = 0;
                                    str_builder_add_cstr(sb, "{\"uri\":\"file://");
                                    str_builder_add_cstr(sb, path);
                                    str_builder_add_cstr(sb, "\",\"range\":{\"start\":{\"line\":");
                                    str_builder_add_int(sb, line_no);
                                    str_builder_add_cstr(sb, ",\"character\":");
                                    str_builder_add_int(sb, col);
                                    str_builder_add_cstr(sb, "},\"end\":{\"line\":");
                                    str_builder_add_int(sb, line_no);
                                    str_builder_add_cstr(sb, ",\"character\":");
                                    str_builder_add_int(sb, col + id_len);
                                    str_builder_add_cstr(sb, "}}}");
                                }
                            }
                            p = id_end;
                        } else {
                            p = p + 1;
                        }
                    }
                }
            }
            fi = fi + 1;
        }
    }

    str_builder_add_cstr(sb, "]}");
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# v5.9.10 helpers for textDocument/semanticTokens/full.
# v5.11.42: legend extended with `parameter` (index 6).
#
# Token-type indices in the legend advertised by handle_initialize:
#   0 = function, 1 = variable, 2 = struct, 3 = enum,
#   4 = enumMember, 5 = keyword, 6 = parameter (v5.11.42)
fn _lsp_kind_to_semantic_type(k): i64 {
    if (k == 1) { return 0; }   # fn → function
    if (k == 2) { return 1; }   # var → variable
    if (k == 4) { return 2; }   # struct → struct
    if (k == 3) { return 3; }   # enum → enum
    if (k == 5) { return 4; }   # enum-member → enumMember
    return 0 - 1;
}

# Is `<buf+off, len>` a cyrius keyword?
fn _lsp_is_keyword(buf, off, len, total): i64 {
    if (len == 2) {
        if (load8(buf + off) == 105 && load8(buf + off + 1) == 102) { return 1; }   # "if"
        if (load8(buf + off) == 105 && load8(buf + off + 1) == 110) { return 1; }   # "in"
        if (load8(buf + off) == 102 && load8(buf + off + 1) == 110) { return 1; }   # "fn"
        if (load8(buf + off) == 100 && load8(buf + off + 1) == 111) { return 1; }   # "do" (6.7.5)
    }
    if (len == 3) {
        if (memeq(buf + off, "var", 3) == 1) { return 1; }
        if (memeq(buf + off, "for", 3) == 1) { return 1; }
        if (memeq(buf + off, "dyn", 3) == 1) { return 1; }   # 6.7.8 (the checked trait object)
    }
    if (len == 4) {
        if (memeq(buf + off, "else", 4) == 1) { return 1; }
        if (memeq(buf + off, "elif", 4) == 1) { return 1; }
        if (memeq(buf + off, "enum", 4) == 1) { return 1; }
        if (memeq(buf + off, "impl", 4) == 1) { return 1; }
        if (memeq(buf + off, "true", 4) == 1) { return 1; }    # 6.7.3 (B2)
        # 6.7.5 (B5): `loop` is CONTEXTUAL — a keyword only when `{` follows (`loop { .. }`);
        # `var loop = 1;` and its reads stay identifiers, as the compiler treats them.
        if (memeq(buf + off, "loop", 4) == 1) { return _lsp_brace_next(buf, off + 4, total); }
    }
    if (len == 5) {
        if (memeq(buf + off, "while", 5) == 1) { return 1; }
        if (memeq(buf + off, "break", 5) == 1) { return 1; }
        if (memeq(buf + off, "match", 5) == 1) { return 1; }
        # v6.1.24: keyword-set refresh — the lexer's LEXKW_EXT (src/frontend/lex.cyr)
        # reserves these too, but the highlighter had never colored them.
        if (memeq(buf + off, "union", 5) == 1) { return 1; }   # union type
        if (memeq(buf + off, "stack", 5) == 1) { return 1; }   # stack-local array qualifier (v5.5.36)
        if (memeq(buf + off, "defer", 5) == 1) { return 1; }   # defer statement
        if (memeq(buf + off, "trait", 5) == 1) { return 1; }   # 6.7.0 (A1)
        if (memeq(buf + off, "const", 5) == 1) { return 1; }   # 6.7.2 (B1)
        if (memeq(buf + off, "false", 5) == 1) { return 1; }   # 6.7.3 (B2)
    }
    if (len == 6) {
        if (memeq(buf + off, "return", 6) == 1) { return 1; }
        if (memeq(buf + off, "struct", 6) == 1) { return 1; }
        if (memeq(buf + off, "shared", 6) == 1) { return 1; }
        # v6.1.24: secret = zeroise-on-return attribute (reserved keyword); sizeof
        # = compile-time size operator. Both were missing from the highlighter.
        if (memeq(buf + off, "secret", 6) == 1) { return 1; }
        if (memeq(buf + off, "sizeof", 6) == 1) { return 1; }
    }
    if (len == 7) {
        if (memeq(buf + off, "include", 7) == 1) { return 1; }
        if (memeq(buf + off, "default", 7) == 1) { return 1; }
    }
    if (len == 8) {
        if (memeq(buf + off, "continue", 8) == 1) { return 1; }
    }
    return 0;
}

# 1 when the first byte at or after `p` (below `total`) that is not a space, tab, CR or LF is `{`.
fn _lsp_brace_next(buf, p, total): i64 {
    while (p < total) {
        var c = load8(buf + p);
        if (c == 123) { return 1; }
        if (c != 32 && c != 9 && c != 10 && c != 13) { return 0; }
        p = p + 1;
    }
    return 0;
}

# v5.11.42 helpers: pre-walk collector + name lookup for the
# per-request locals table. The collector runs a simple state
# machine over the file:
#   default → on `var` keyword: next ident is local
#           → on `fn` keyword: next ident is fn name (skip);
#                              then `(` opens param mode
#   param-name → register ident as parameter; expect `:`/`,`/`)`
#   param-after-name → on `:` → type-annotation mode (no register)
#                    → on `,` → back to param-name
#                    → on `)` → exit signature
#   type-annotation → on `,` → param-name; on `)` → exit
# 6.7.7: a parameter may carry a default (`b = f(x, y)`) and a tuple
# type (`t: (i64, i64)`), so the `,` / `)` / `:` above count only at
# the list's own bracket depth (`sig_depth`), and a char literal is
# skipped like a string — the default's `y` (the tuple's `i64`) was
# registered as a parameter and its `)` ended the signature, dropping
# the parameters after it. The `=` itself needs no state: only a
# depth-0 `,` (or the list's `(`) leads to param-name. CHANGELOG [6.7.7]
# 6.7.11: a generic type's `<` `>` nest too (`p: Pair<i64, i64>`), in the TYPE only — as the
# compiler's _pl_next / _pl_tdepth — so after the parameter's depth-0 `=` (`sig_dflt`) a `<` is an
# operator again (`c = 1 < 2`). The comma inside `<..>` registered `i64` as a parameter, and the
# file-wide table then colored every `i64` in the file a parameter. CHANGELOG [6.7.11]
# Scope is intentionally NOT tracked: a `var x` in one fn and a
# different `var x` in another both get colored as `variable` —
# the visual outcome is identical so the simplification is free.
fn _lsp_collect_locals(fb, ftotal): i64 {
    _lsp_local_count = 0;
    var p = 0;
    var sig_state = 0;     # 0=outside, 1=after fn, 2=after fn-name,
    # 3=expect param name, 4=after param name,
    # 5=type annotation (a default stays in 4 / 5)
    var sig_depth = 0;     # brackets open inside the parameter list
    var sig_dflt = 0;      # 1 after this parameter's depth-0 `=` (in its default)
    var var_pending = 0;   # 1 = just saw `var`, next ident is local
    while (p < ftotal) {
        var c = load8(fb + p);
        if (c == 10) { p = p + 1; }
        elif (c == 35) {
            # `# comment` — skip to EOL
            while (p < ftotal && load8(fb + p) != 10) { p = p + 1; }
        }
        elif (c == 34 || c == 39) {
            # string / char literal — skip to the closing quote (with `\\` escape)
            p = p + 1;
            while (p < ftotal) {
                var sc = load8(fb + p);
                if (sc == 92) { p = p + 2; }
                else {
                    if (sc == c) { p = p + 1; break; }
                    if (sc == 10) { break; }
                    p = p + 1;
                }
            }
        }
        elif (_lsp_id_start(c) == 1) {
            var id_start = p;
            var id_end = _lsp_scan_id_end(fb, p, ftotal);
            var id_len = id_end - id_start;
            var is_var_kw = 0;
            var is_fn_kw  = 0;
            if (id_len == 3) {
                if (memeq(fb + id_start, "var", 3) == 1) { is_var_kw = 1; }
            }
            if (id_len == 2) {
                if (memeq(fb + id_start, "fn", 2)  == 1) { is_fn_kw  = 1; }
            }
            if (is_var_kw == 1) {
                var_pending = 1;
            } elif (is_fn_kw == 1) {
                sig_state = 1;
                sig_depth = 0;
                sig_dflt = 0;
                var_pending = 0;
            } else {
                if (var_pending == 1) {
                    if (_lsp_local_count < _LSP_LOCAL_CAP) {
                        store64(_lsp_local_off  + _lsp_local_count * 8, id_start);
                        store64(_lsp_local_len  + _lsp_local_count * 8, id_len);
                        store64(_lsp_local_kind + _lsp_local_count * 8, 1);  # variable
                        _lsp_local_count = _lsp_local_count + 1;
                    }
                    var_pending = 0;
                } elif (sig_state == 1) {
                    # This ident is the fn name — skip.
                    sig_state = 2;
                } elif (sig_state == 3) {
                    if (_lsp_local_count < _LSP_LOCAL_CAP) {
                        store64(_lsp_local_off  + _lsp_local_count * 8, id_start);
                        store64(_lsp_local_len  + _lsp_local_count * 8, id_len);
                        store64(_lsp_local_kind + _lsp_local_count * 8, 6);  # parameter
                        _lsp_local_count = _lsp_local_count + 1;
                    }
                    sig_state = 4;
                }
                # sig_state 4/5: ident is type or unrelated; no register.
            }
            p = id_end;
        }
        else {
            if (c == 40 || c == 91) {                 # `(` `[`
                if (sig_state == 2 && c == 40) { sig_state = 3; }
                elif (sig_state >= 3) { sig_depth = sig_depth + 1; }
            } elif (c == 41 || c == 93) {             # `)` `]`
                if (sig_state >= 3) {
                    if (sig_depth > 0) { sig_depth = sig_depth - 1; }
                    elif (c == 41) { sig_state = 0; }
                }
            } elif (c == 123) {                       # `{`
                # Defensive: a `{` outside the signature ends any
                # stale signature state (covers `fn name() { ... }`
                # boundary without sig_state being explicitly reset
                # on every `)`).
                sig_state = 0;
                sig_depth = 0;
            } elif (c == 60 || c == 62) {             # `<` `>` — in a parameter's TYPE only
                if (sig_state == 5 && sig_dflt == 0) {
                    if (c == 60) { sig_depth = sig_depth + 1; }
                    elif (sig_depth > 0) { sig_depth = sig_depth - 1; }
                }
            } elif (sig_depth == 0) {                 # not inside a default's brackets
                if (c == 58) {                        # `:`
                    if (sig_state == 4) { sig_state = 5; }
                } elif (c == 44) {                    # `,`
                    if (sig_state >= 3) { sig_state = 3; sig_dflt = 0; }
                } elif (c == 61) {                    # `=` — the parameter's default
                    if (sig_state >= 3) { sig_dflt = 1; }
                }
            }
            p = p + 1;
        }
    }
    return _lsp_local_count;
}

# Lookup `<fb+off, len>` in the per-request locals table.
# Returns the semantic-token-type index (1 or 6) on hit, -1 on miss.
fn _lsp_lookup_local(fb, off, len): i64 {
    var i = 0;
    while (i < _lsp_local_count) {
        var entry_len = load64(_lsp_local_len + i * 8);
        if (entry_len == len) {
            var entry_off = load64(_lsp_local_off + i * 8);
            if (memeq(fb + entry_off, fb + off, len) == 1) {
                return load64(_lsp_local_kind + i * 8);
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# v5.9.10: textDocument/semanticTokens/full.
# v5.11.42: added locals + fn-parameter coverage via two-pass walk
# (pre-collect + emit). Legend extended with `parameter` (index 6).
# Request:  { ..., params: { textDocument: { uri } } }
# Response: { ..., result: { data: int[] } | null }
#
# Per LSP 3.16 spec, the `data` array is a flat int sequence
# where every 5 ints describe one token:
#   [deltaLine, deltaStartChar, length, tokenType, tokenModifiers]
# Tokens are sorted ascending by (line, col); deltas are relative
# to the previous token (or start-of-file for the first). When
# the line advances, deltaStartChar resets to absolute.
#
# Coverage (v5.11.42): keywords + v5.7.39 cross-file symbol-table
# idents (fn / global var / struct / enum / enum-member) + locals
# (`var X`) + fn parameters (`fn(arg, arg2)`). Skipped: type names
# in signatures (built-in primitives like `i64`; user-defined
# struct/enum types already get their existing color via symbol
# table), string / number literals, operators, comments. Editors
# fall back to textmate grammar for the rest.
fn handle_semantic_tokens(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");
    var path = 0;
    if (uri != 0) { path = uri_to_path(uri); }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":{\"data\":[");

    var first = 1;
    var prev_line = 0;
    var prev_col = 0;

    if (path != 0) {
        var total_out[1];
        var fb = lsp_read_file(path, &total_out);
        var ftotal = load64(&total_out);
        if (fb != 0 && ftotal > 0) {
            # v5.11.42: pre-walk to collect locals + fn parameters
            # into _lsp_local_off/_len/_kind. The emit walk below
            # then checks each ident against this table BEFORE
            # falling through to keyword / symbol-table lookup.
            _lsp_collect_locals(fb, ftotal);
            var p = 0;
            var line_no = 0;
            var line_start = 0;
            while (p < ftotal) {
                var c = load8(fb + p);
                if (c == 10) {
                    line_no = line_no + 1;
                    line_start = p + 1;
                    p = p + 1;
                } else {
                    # Skip `# comment` lines wholesale.
                    if (c == 35) {
                        while (p < ftotal && load8(fb + p) != 10) { p = p + 1; }
                    } else {
                        # Skip string literals — `"..."` with `\\` escape.
                        if (c == 34) {
                            p = p + 1;
                            while (p < ftotal) {
                                var sc = load8(fb + p);
                                if (sc == 92) {       # '\\'
                                    p = p + 2;
                                } else {
                                    if (sc == 34) { p = p + 1; break; }
                                    if (sc == 10) { break; }
                                    p = p + 1;
                                }
                            }
                        } else {
                            if (_lsp_id_start(c) == 1) {
                                var id_start = p;
                                var id_end = _lsp_scan_id_end(fb, p, ftotal);
                                var id_len = id_end - id_start;
                                var ttype = 0 - 1;
                                if (_lsp_is_keyword(fb, id_start, id_len, ftotal) == 1) {
                                    ttype = 5;
                                } else {
                                    # v5.11.42: local-table lookup
                                    # wins over symbol-table — locals
                                    # shadow globals of the same name
                                    # (consistent with cyrius scoping).
                                    ttype = _lsp_lookup_local(fb, id_start, id_len);
                                    if (ttype < 0) {
                                        var idx = lsp_lookup_symbol(fb + id_start, id_len);
                                        if (idx >= 0) {
                                            var k = load64(_sym_kind + idx * 8);
                                            ttype = _lsp_kind_to_semantic_type(k);
                                        }
                                    }
                                }
                                if (ttype >= 0) {
                                    var col = id_start - line_start;
                                    var dline = 0;
                                    var dcol = 0;
                                    if (first == 1) {
                                        dline = line_no;
                                        dcol = col;
                                        first = 0;
                                    } else {
                                        dline = line_no - prev_line;
                                        if (dline == 0) {
                                            dcol = col - prev_col;
                                        } else {
                                            dcol = col;
                                        }
                                        str_builder_add_cstr(sb, ",");
                                    }
                                    str_builder_add_int(sb, dline);
                                    str_builder_add_cstr(sb, ",");
                                    str_builder_add_int(sb, dcol);
                                    str_builder_add_cstr(sb, ",");
                                    str_builder_add_int(sb, id_len);
                                    str_builder_add_cstr(sb, ",");
                                    str_builder_add_int(sb, ttype);
                                    str_builder_add_cstr(sb, ",0");
                                    prev_line = line_no;
                                    prev_col = col;
                                }
                                p = id_end;
                            } else {
                                p = p + 1;
                            }
                        }
                    }
                }
            }
        }
    }

    str_builder_add_cstr(sb, "]}}");
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# ================================================================
# MAIN LOOP
# ================================================================

fn main(): i64 {
    alloc_init();

    # v5.7.39: allocate symbol-table backing buffers up front.
    lsp_index_init();

    # Find cycc
    _cycc_path = find_cycc();
    if (_cycc_path == 0) {
        log_msg("warning: cycc not found — diagnostics disabled");
    } else {
        var log_sb = str_builder_new();
        str_builder_add_cstr(log_sb, "found cycc: ");
        str_builder_add_cstr(log_sb, _cycc_path);
        log_msg(str_data(str_builder_build(log_sb)));
    }

    # v5.11.56: find cyrius wrapper for project-aware compile path
    # (closes [deps.*]-resolution false positives — Item 2).
    _cyrius_path = find_cyrius();
    if (_cyrius_path == 0) {
        log_msg("note: cyrius wrapper not found — falling back to raw cycc (deps will not resolve in diagnostics)");
    } else {
        var clog_sb = str_builder_new();
        str_builder_add_cstr(clog_sb, "found cyrius wrapper: ");
        str_builder_add_cstr(clog_sb, _cyrius_path);
        log_msg(str_data(str_builder_build(clog_sb)));
    }

    # Main loop: read JSON-RPC messages
    var running = 1;
    while (running == 1) {
        var clen = read_header();
        if (clen < 0) { running = 0; break; }
        var body = read_body(clen);
        if (body == 0) { running = 0; break; }

        # Match methods — check longer names first to avoid prefix ambiguity
        # Handle both compact ("method":"X") and spaced ("method": "X") JSON
        if (json_find(body, "\"method\":\"initialized\"") >= 0 || json_find(body, "\"method\": \"initialized\"") >= 0) {
            # No response needed
        }
        elif (json_find(body, "\"method\":\"initialize\"") >= 0 || json_find(body, "\"method\": \"initialize\"") >= 0) {
            handle_initialize(body);
        }
        elif (json_find(body, "\"method\":\"shutdown\"") >= 0 || json_find(body, "\"method\": \"shutdown\"") >= 0) {
            handle_shutdown(body);
            running = 0;
        }
        elif (json_find(body, "\"method\":\"exit\"") >= 0 || json_find(body, "\"method\": \"exit\"") >= 0) {
            running = 0;
        }
        elif (json_find(body, "\"textDocument/didOpen\"") >= 0) {
            handle_did_open_or_save(body);
        }
        elif (json_find(body, "\"textDocument/didSave\"") >= 0) {
            handle_did_open_or_save(body);
        }
        elif (json_find(body, "\"textDocument/didChange\"") >= 0) {
            handle_did_open_or_save(body);
        }
        # v5.7.39: cross-file go-to-def + outline.
        elif (json_find(body, "\"textDocument/definition\"") >= 0) {
            handle_definition(body);
        }
        # v6.1.24: hover (symbol kind + definition site).
        elif (json_find(body, "\"textDocument/hover\"") >= 0) {
            handle_hover(body);
        }
        elif (json_find(body, "\"textDocument/documentSymbol\"") >= 0) {
            handle_document_symbol(body);
        }
        # v5.9.10: find-all-uses + semantic-tokens.
        elif (json_find(body, "\"textDocument/references\"") >= 0) {
            handle_references(body);
        }
        elif (json_find(body, "\"textDocument/semanticTokens/full\"") >= 0) {
            handle_semantic_tokens(body);
        }
    }

    return 0;
}

var r = main();
syscall(60, r);
