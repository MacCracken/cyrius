# cyrius-lsp — Language Server Protocol implementation for Cyrius
# Protocol: JSON-RPC 2.0 over stdin/stdout
#
# Usage: cyrius-lsp (launched by editor)
#
# Capabilities (advertised in `initialize`):
#   - diagnostics       — compile via the `cyrius` wrapper (so includes resolve), a project file
#                         through its unit (COMPILE UNITS, 6.7.16) + parse cycc's stderr into
#                         errors/warnings
#   - definitionProvider     — cross-file go-to-definition (symbol table)
#   - documentSymbolProvider — file outline
#   - referencesProvider     — find-all-uses
#   - semanticTokensProvider — keyword / fn / var / type / param coloring
#   - hoverProvider          — symbol kind + definition site (v6.1.24)
#
# Supported methods:
#   initialize → capabilities ; initialized (no-op) ; shutdown/exit
#   textDocument/didOpen|didSave|didChange → recompile + publishDiagnostics + index
#   textDocument/definition → Location
#   textDocument/hover → Hover (markdown)
#   textDocument/documentSymbol → SymbolInformation[]
#   textDocument/references → Location[]
#   textDocument/semanticTokens/full → SemanticTokens

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/syscalls.cyr"
# 6.7.16: argv(0), which _resolve_install_dir opens on macOS (no /proc/self/exe there).
include "lib/args.cyr"
# 6.7.16: dir_list_into, which the compile units' project walk lists each directory with.
include "lib/fs.cyr"
# 6.6.10: the declaration reader the CLI uses (`cyrius coverage`, `cyrius distlib`) — ONE
# answer to "what does this file declare at top level". See lsp_index_decls.
include "cbt/srcscan.cyr"

fn prints(s): i64 { syscall(1, 1, s, strlen(s)); return 0; }

fn print_int_str(n): i64 {
    var buf[24];
    var len = fmt_int_buf(n, &buf);
    syscall(1, 1, &buf, len);
    return 0;
}

# stderr logging for debug
fn log_msg(s): i64 {
    syscall(1, 2, "[cyrius-lsp] ", 13);
    syscall(1, 2, s, strlen(s));
    syscall(1, 2, "\n", 1);
    return 0;
}

# ================================================================
# JSON-RPC I/O
# ================================================================

# Read a Content-Length header from stdin, return the length
fn read_header(): i64 {
    var buf[256];
    var pos = 0;
    # Read until \r\n\r\n
    var found = 0;
    while (found == 0) {
        var n = syscall(0, 0, &buf + pos, 1);
        if (n <= 0) { return -1; }
        pos += 1;
        if (pos >= 4) {
            if (load8(&buf + pos - 4) == 13 && load8(&buf + pos - 3) == 10 && load8(&buf + pos - 2) == 13 && load8(&buf + pos - 1) == 10) {
                found = 1;
            }
        }
        if (pos >= 255) { return -1; }
    }
    store8(&buf + pos, 0);
    # Parse Content-Length: N
    var i = 0;
    while (i < pos) {
        if (memeq(&buf + i, "Content-Length: ", 16) == 1) {
            var num = 0;
            var j = i + 16;
            while (j < pos && load8(&buf + j) >= 48 && load8(&buf + j) <= 57) {
                num = num * 10 + load8(&buf + j) - 48;
                j += 1;
            }
            # v6.3.23 (DX-02): reject an out-of-range Content-Length from an
            # untrusted / malformed editor message. Without this a huge value
            # reaches read_body's alloc(n+1) (0 on > ALLOC_MAX) → read() into a
            # NULL page. Cap at 16 MB (no real LSP message approaches it) so the
            # framing rejects rather than faults; the main loop treats -1 as EOF.
            if (num > 16777216) { return -1; }
            return num;
        }
        i += 1;
    }
    return -1;
}

# Read exactly n bytes from stdin
fn read_body(n): i64 {
    var buf = alloc(n + 1);
    # v6.3.23 (DX-02): alloc returns 0 on failure (e.g. n+1 > ALLOC_MAX); never
    # read() into a NULL page — treat as EOF so the main loop shuts down cleanly.
    if (buf == 0) { return 0; }
    var total = 0;
    while (total < n) {
        var got = syscall(0, 0, buf + total, n - total);
        if (got <= 0) { return 0; }
        total += got;
    }
    store8(buf + n, 0);
    return buf;
}

# Send a JSON-RPC response
fn send_response(body): i64 {
    var blen = strlen(body);
    prints("Content-Length: ");
    print_int_str(blen);
    prints("\r\n\r\n");
    syscall(1, 1, body, blen);
    return 0;
}

# ================================================================
# JSON HELPERS
# ================================================================

# Find substring in JSON, return position after match or -1
fn json_find(json, key): i64 {
    var jlen = strlen(json);
    var klen = strlen(key);
    var i = 0;
    while (i + klen <= jlen) {
        if (memeq(json + i, key, klen) == 1) { return i + klen; }
        i += 1;
    }
    return -1;
}

# Extract string value after "key":" in JSON
# Handles both compact and spaced JSON (e.g. "uri": "..." or "uri":"...")
fn json_get_str(json, key): i64 {
    var pos = json_find(json, key);
    if (pos < 0) {
        # Try with space after colon (e.g. key = "\"uri\":" → try "\"uri\": ")
        # Build spaced variant: append space before searching
        var klen = strlen(key);
        var spaced = alloc(klen + 2);
        memcpy(spaced, key, klen);
        store8(spaced + klen, 32);
        store8(spaced + klen + 1, 0);
        pos = json_find(json, spaced);
        if (pos < 0) { return 0; }
    }
    # Skip to opening quote
    while (load8(json + pos) != 0 && load8(json + pos) != 34) { pos += 1; }
    if (load8(json + pos) != 34) { return 0; }
    pos += 1;
    var start = pos;
    while (load8(json + pos) != 0 && load8(json + pos) != 34) { pos += 1; }
    var len = pos - start;
    var result = alloc(len + 1);
    memcpy(result, json + start, len);
    store8(result + len, 0);
    return result;
}

# Extract integer "id" from JSON-RPC message
fn json_get_id(body): i64 {
    var id_pos = json_find(body, "\"id\":");
    if (id_pos < 0) { id_pos = json_find(body, "\"id\": "); }
    var id = 0;
    if (id_pos >= 0) {
        while (load8(body + id_pos) == 32) { id_pos += 1; }
        while (load8(body + id_pos) >= 48 && load8(body + id_pos) <= 57) {
            id = id * 10 + load8(body + id_pos) - 48;
            id_pos += 1;
        }
    }
    return id;
}

# Convert file:// URI to local path
# v6.3.23 (DX-02): does `path` contain a ".." path component? A component is a
# run between '/' separators (or string start/end). Detects "../", "/..", a
# leading "..", or a trailing "/.." — the workspace-traversal vectors — without
# false-positiving on names like "foo..bar" or "..." that merely contain dots.
fn _lsp_path_has_dotdot(path): i64 {
    var i = 0;
    while (load8(path + i) != 0) {
        var at_start = 0;
        if (i == 0) { at_start = 1; }
        elif (load8(path + i - 1) == 47) { at_start = 1; }   # previous char '/'
        if (at_start == 1) {
            if (load8(path + i) == 46 && load8(path + i + 1) == 46) {   # ".."
                var after = load8(path + i + 2);
                if (after == 0) { return 1; }        # trailing ".."
                if (after == 47) { return 1; }       # ".." followed by '/'
            }
        }
        i += 1;
    }
    return 0;
}

fn uri_to_path(uri): i64 {
    var ulen = strlen(uri);
    var path = 0;
    # Strip file:// prefix (7 chars)
    if (ulen > 7 && memeq(uri, "file://", 7) == 1) {
        var plen = ulen - 7;
        path = alloc(plen + 1);
        memcpy(path, uri + 7, plen);
        store8(path + plen, 0);
    } else {
        # No prefix, return as-is
        path = alloc(ulen + 1);
        memcpy(path, uri, ulen);
        store8(path + ulen, 0);
    }
    # v6.3.23 (DX-02): untrusted-workspace-input guard. A well-behaved editor
    # sends normalized absolute URIs; a ".." component is a traversal attempt to
    # read/index a file outside the workspace. Soft-fail to an empty string so
    # every caller's strlen/`.cyr`-suffix check rejects it without a NULL deref.
    if (_lsp_path_has_dotdot(path) == 1) {
        store8(path, 0);
    }
    return path;
}

# ================================================================
# COMPILER INTEGRATION
# ================================================================

# Global: path to cycc binary
var _cycc_path = 0;

# v5.11.56: path to cyrius wrapper binary. compile_and_capture
# prefers the wrapper for files inside a cyrius project (a tree
# containing cyrius.cyml) so [deps.*] resolution happens — that
# closes the undefined-stdlib-fn false-positive class flagged in
# the iron-boot papercut filing Item 2. Raw-cycc fallback retained
# for files outside any project tree.
var _cyrius_path = 0;

# ================================================================
# SYMBOL INDEX (v5.7.39)
# ================================================================
# Parallel-array symbol table for cross-file go-to-definition and
# document-outline support. Indexed lazily — every textDocument/
# didOpen / didChange / didSave triggers `lsp_index_file_r(path, …)`,
# which scans the file for top-level fn/var/enum/struct decls and
# recursively walks `include "..."` directives. A path is indexed
# at most once per LSP session (tracked by the indexed-path set, `_lsp_indexed_off`)
# to keep cost bounded.
#
# Sizing: every table GROWS (6.6.12). The six row arrays, the names buffer, the indexed-path
# set and its string buffer start small and double on demand through `_lsp_grow`; only a
# refused allocation stops indexing. Each file's path is interned ONCE, by
# `_lsp_mark_indexed`, and every symbol row stores that offset into `_lsp_indexed_buf`.
# ⛔ These were fixed caps that truncated SILENTLY — 4096 rows, 256 KB of names, 32 KB of
# paths, 256 files — and `_lsp_add_symbol` re-interned the path string for every symbol, so
# the 32 KB paths buffer bound first (~2,300 symbols for `lib/x.cyr` paths, ~500 for a
# 60-byte absolute path): definition() of sigil's last fn came back null. CHANGELOG [6.6.12]

var _lsp_symtab_cap = 1024;
var _lsp_names_cap = 65536;
var _lsp_paths_cap = 8192;
var _lsp_indexed_cap = 64;

# Per-symbol parallel arrays (grown together by `_lsp_add_symbol`; allocated in main()):
#   _sym_name_off   — offset into _sym_names_buf (start of name)
#   _sym_name_len   — length of the name in bytes
#   _sym_path_off   — offset into _lsp_indexed_buf (the file's path, interned once)
#   _sym_line       — 0-based line where the decl starts
#   _sym_col        — 0-based column where the IDENT starts
#   _sym_kind       — 1=fn, 2=var, 3=enum, 4=struct, 5=enum-member
var _sym_name_off = 0;
var _sym_name_len = 0;
var _sym_path_off = 0;
var _sym_line = 0;
var _sym_col = 0;
var _sym_kind = 0;
var _sym_count = 0;

# Backing buffer for the names
var _sym_names_buf = 0;
var _sym_names_used = 0;

# Per-path indexed-set: cstring offsets into _lsp_indexed_buf (poor-man's
# string-set; linear scan). The same offsets are the symbol rows' `_sym_path_off`.
var _lsp_indexed_off = 0;
var _lsp_indexed_count = 0;
var _lsp_indexed_buf = 0;
var _lsp_indexed_used = 0;

# v5.11.42: per-request local-name table for semanticTokens/full.
# Three parallel arrays sized at _LSP_LOCAL_CAP entries; allocated
# once at startup, cleared (count=0) per request. Stores (offset,
# length, kind) where offset/length point into the file buffer and
# kind is the semantic-token-type index (1=variable, 6=parameter).
# v5.9.10's narrow legend only colored symbol-table-resolved idents
# + keywords; this extension adds locals (`var X`) + fn parameters
# so editors with weak textmate fallback show coherent coloring.
var _LSP_LOCAL_CAP = 4096;
var _lsp_local_off = 0;
var _lsp_local_len = 0;
var _lsp_local_kind = 0;
var _lsp_local_count = 0;

# Alloc the symbol-table backing buffers once at startup.
fn lsp_index_init(): i64 {
    _sym_name_off = alloc(_lsp_symtab_cap * 8);
    _sym_name_len = alloc(_lsp_symtab_cap * 8);
    _sym_path_off = alloc(_lsp_symtab_cap * 8);
    _sym_line     = alloc(_lsp_symtab_cap * 8);
    _sym_col      = alloc(_lsp_symtab_cap * 8);
    _sym_kind     = alloc(_lsp_symtab_cap * 8);
    _sym_count    = 0;
    _sym_names_buf = alloc(_lsp_names_cap);
    _sym_names_used = 0;
    _lsp_indexed_off = alloc(_lsp_indexed_cap * 8);
    _lsp_indexed_count = 0;
    _lsp_indexed_buf = alloc(_lsp_paths_cap);
    _lsp_indexed_used = 0;
    # v5.11.42 locals table — allocated once, reused per request.
    _lsp_local_off  = alloc(_LSP_LOCAL_CAP * 8);
    _lsp_local_len  = alloc(_LSP_LOCAL_CAP * 8);
    _lsp_local_kind = alloc(_LSP_LOCAL_CAP * 8);
    _lsp_local_count = 0;
    return 0;
}

# Identifier-class predicates (parallel to programs/cyrlint.cyr's
# v5.7.32 _is_id_start / _is_id_cont — kept inline here so cyrius-lsp
# stays a self-contained program).
fn _lsp_id_start(c): i64 {
    if (c >= 65 && c <= 90)  { return 1; }   # A-Z
    if (c >= 97 && c <= 122) { return 1; }   # a-z
    if (c == 95)             { return 1; }   # _
    return 0;
}
fn _lsp_id_cont(c): i64 {
    if (_lsp_id_start(c) == 1) { return 1; }
    if (c >= 48 && c <= 57)    { return 1; } # 0-9
    return 0;
}

# Scan forward over [off..total) while bytes are id-cont; return the
# offset just past the IDENT.
fn _lsp_scan_id_end(buf, off, total): i64 {
    var p = off;
    while (p < total) {
        if (_lsp_id_cont(load8(buf + p)) == 0) { return p; }
        p = p + 1;
    }
    return total;
}

# Make the buffer at *buf_addr (cap bytes at *cap_addr) hold at least `need` bytes: double the
# cap until it fits, copy the live bytes to a fresh allocation and publish both. Returns 0, or
# -1 when the allocation is refused (the buffer is then left as it was). The old block is
# abandoned — the bump allocator has no free — which bounds the waste to the final size.
fn _lsp_grow(buf_addr, cap_addr, need): i64 {
    var cap = load64(cap_addr);
    if (need <= cap) { return 0; }
    var ncap = cap;
    if (ncap < 64) { ncap = 64; }
    while (ncap < need) { ncap = ncap * 2; }
    var nb = alloc(ncap);
    if (nb == 0) { return 0 - 1; }
    memcpy(nb, load64(buf_addr), cap);
    store64(buf_addr, nb);
    store64(cap_addr, ncap);
    return 0;
}

# Stash a cstring into a growable backing buffer; return the offset (or -1 if the buffer
# could not grow). Inserts a trailing NUL. Offsets stay valid across growth; pointers into
# the buffer do not, so readers add the offset to the CURRENT buffer.
fn _lsp_intern(buf_addr, used_addr, cap_addr, src, len): i64 {
    var used = load64(used_addr);
    if (_lsp_grow(buf_addr, cap_addr, used + len + 1) < 0) { return 0 - 1; }
    var off = used;
    var buf = load64(buf_addr);
    var i = 0;
    while (i < len) {
        store8(buf + off + i, load8(src + i));
        i = i + 1;
    }
    store8(buf + off + len, 0);
    store64(used_addr, used + len + 1);
    return off;
}

# Has this absolute path already been indexed? Linear scan over the
# indexed set (one row per included file, so O(n) is fine).
fn _lsp_already_indexed(path): i64 {
    var plen = strlen(path);
    var i = 0;
    while (i < _lsp_indexed_count) {
        var off = load64(_lsp_indexed_off + i * 8);
        var entry = _lsp_indexed_buf + off;
        if (memeq(entry, path, plen + 1) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Record `path` as indexed. Returns the offset of its interned copy in _lsp_indexed_buf — the
# `path_off` every symbol of the file stores — or -1 when an allocation is refused.
fn _lsp_mark_indexed(path): i64 {
    var ncap = _lsp_indexed_cap * 8;
    if (_lsp_grow(&_lsp_indexed_off, &ncap, (_lsp_indexed_count + 1) * 8) < 0) { return 0 - 1; }
    _lsp_indexed_cap = ncap / 8;
    var plen = strlen(path);
    var off = _lsp_intern(&_lsp_indexed_buf, &_lsp_indexed_used, &_lsp_paths_cap, path, plen);
    if (off < 0) { return 0 - 1; }
    store64(_lsp_indexed_off + _lsp_indexed_count * 8, off);
    _lsp_indexed_count = _lsp_indexed_count + 1;
    return off;
}

# Grow the six parallel symbol-row arrays together so row `_sym_count` fits. Returns 0, or -1
# when an allocation is refused (the table is then left as it was: the arrays that did grow
# keep their contents, and the cap only moves once all six have).
fn _lsp_grow_rows(): i64 {
    if (_sym_count < _lsp_symtab_cap) { return 0; }
    var need = (_sym_count + 1) * 8;
    var c0 = _lsp_symtab_cap * 8;
    var c1 = c0;
    var c2 = c0;
    var c3 = c0;
    var c4 = c0;
    var c5 = c0;
    if (_lsp_grow(&_sym_name_off, &c0, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_name_len, &c1, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_path_off, &c2, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_line, &c3, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_col, &c4, need) < 0) { return 0 - 1; }
    if (_lsp_grow(&_sym_kind, &c5, need) < 0) { return 0 - 1; }
    _lsp_symtab_cap = c0 / 8;
    return 0;
}

# Append a symbol to the table. `name_src` + `name_len` describe the
# IDENT bytes; `path_off` is the file's offset in _lsp_indexed_buf (from
# _lsp_mark_indexed); line/col are 0-based; kind ∈ {1,2,3,4,5}. Returns 0
# on success, -1 when an allocation is refused.
fn _lsp_add_symbol(name_src, name_len, path_off, line, col, kind): i64 {
    if (_lsp_grow_rows() < 0) { return 0 - 1; }
    var no = _lsp_intern(&_sym_names_buf, &_sym_names_used, &_lsp_names_cap, name_src, name_len);
    if (no < 0) { return 0 - 1; }
    var i = _sym_count;
    store64(_sym_name_off + i * 8, no);
    store64(_sym_name_len + i * 8, name_len);
    store64(_sym_path_off + i * 8, path_off);
    store64(_sym_line     + i * 8, line);
    store64(_sym_col      + i * 8, col);
    store64(_sym_kind     + i * 8, kind);
    _sym_count = _sym_count + 1;
    return 0;
}

# Find next end-of-line offset starting at `start`; returns offset of
# the '\n' (or `total` if not found).
fn _lsp_find_eol(buf, start, total): i64 {
    var p = start;
    while (p < total) {
        if (load8(buf + p) == 10) { return p; }
        p = p + 1;
    }
    return total;
}

# Index a single file: scan for top-level fn/var/enum/struct decls and
# recursively walk `include "..."` directives. Path is the absolute
# cstring file path. Idempotent — second call on the same path is a
# no-op via _lsp_already_indexed. Returns 0 on success.
# 6.7.16 — an include resolves from `root` (the project root; a loose file's: this server's working
# directory), then `root`/`incdir` (the entry's directory, the CLI's `#@incdir`), then the including
# file's own directory — always to an absolute path (_lsp_index_resolve). It resolved against the
# server's working directory, as given. CHANGELOG [6.7.16]
fn lsp_index_file_r(path, root, incdir): i64 {
    if (_lsp_already_indexed(path) == 1) { return 0; }
    var path_off = _lsp_mark_indexed(path);
    if (path_off < 0) { return 0; }    # allocation refused → soft-fail

    # Read the WHOLE file (6.6.10). This was a fixed 1 MB read — "enough for cyrius's largest
    # source" — but the stdlib it indexes through `include` is larger: lib/mabda.cyr is
    # 1.37 MB and lib/sigil.cyr 1.26 MB, so every declaration past the cut was unindexed.
    # And the buffer was stored through unchecked. An unreadable file indexes nothing.
    var total = 0;
    var buf = file_read_whole(path, &total);
    if (buf == 0) { return 0; }
    var path_dir = _lsp_dir_of(path);

    var pos = 0;
    while (pos < total) {
        var eol = _lsp_find_eol(buf, pos, total);
        # `include "path/to/file.cyr"` at column 0 (as cycc reads it) — recurse.
        if (eol - pos > 9 && memeq(buf + pos, "include \"", 9) == 1) {
            var qs = pos + 9;
            var qe = qs;
            while (qe < eol && load8(buf + qe) != 34) { qe = qe + 1; }
            if (qe < eol && qe > qs) {
                var inc = alloc(qe - qs + 1);
                memcpy(inc, buf + qs, qe - qs);
                store8(inc + qe - qs, 0);
                var found = _lsp_index_resolve(inc, root, incdir, path_dir);
                if (found != 0) { lsp_index_file_r(found, root, incdir); }
            }
        }
        pos = eol + 1;
    }
    lsp_index_decls(buf, total, path_off);
    return 0;
}

# The file an `include "<inc>"` of a file in directory `path_dir` names, for lsp_index_file_r: an
# absolute `inc` as is; else `root`/`inc`, `root`/`incdir`/`inc`, `path_dir`/`inc` (with `root` 0,
# `inc` as given first); the first that exists, or 0.
fn _lsp_index_resolve(inc, root, incdir, path_dir): i64 {
    if (load8(inc) == 47) {
        if (file_exists(inc) == 1) { return inc; }
        return 0;
    }
    if (root != 0) {
        var c1 = _cu_resolve_name(root, inc);
        if (file_exists(c1) == 1) { return c1; }
        if (incdir != 0) {
            var c2 = _cu_resolve_name(_lsp_join(root, incdir, 0, strlen(incdir)), inc);
            if (file_exists(c2) == 1) { return c2; }
        }
    } elif (file_exists(inc) == 1) { return inc; }
    if (path_dir == 0 || load8(path_dir) == 0) { return 0; }   # a bare name has no directory to try
    var c3 = _cu_resolve_name(path_dir, inc);
    if (file_exists(c3) == 1) { return c3; }
    return 0;
}

# Record every top-level declaration of buf[0, total) under the file whose interned path is at
# `path_off` in _lsp_indexed_buf, through cbt/srcscan.cyr's
# `_src_decls` — the reader `cyrius coverage` and `cyrius distlib` use.
# ⛔ 6.6.10: this was a SIXTH hand-rolled declaration reader, and it matched only `fn `, `var `,
# `enum ` and `struct ` at COLUMN 0: no `pub`/`public`, no attribute (`#inline fn`), no
# indentation, no `fn<TAB>`, and `fn NAME` only when `(` followed the name at once (so no
# generic `fn f<T>(`). Go-to-definition and hover missed every `pub fn` — the 322 in
# lib/yukti.cyr among them. And it read comments and strings as code: a `fn x` inside a
# multi-line string was indexed. It reads a blanked COPY (the include scan above needs the
# raw paths), so a declaration in a comment or string is not one. CHANGELOG [6.6.10]
fn lsp_index_decls(buf, total, path_off): i64 {
    var cb = alloc(total + 1);
    if (cb == 0) { return 0; }
    memcpy(cb, buf, total);
    store8(cb + total, 0);
    _src_blank_noncode(cb, total);
    var offs = vec_new();
    var lens = vec_new();
    var kinds = vec_new();
    _src_decls(cb, total, offs, lens, kinds);
    # Offsets come out in file order, so the line/column of each is one forward walk.
    var line = 0;
    var ls = 0;
    var p = 0;
    var k = 0;
    while (k < vec_len(offs)) {
        var off = vec_get(offs, k);
        while (p < off) {
            if (load8(buf + p) == 10) { line = line + 1; ls = p + 1; }
            p = p + 1;
        }
        _lsp_add_symbol(buf + off, vec_get(lens, k), path_off, line, off - ls, vec_get(kinds, k));
        k = k + 1;
    }
    return 0;
}

# Look up a symbol name in the table; return the index of the first
# match (-1 if not found). Linear scan; future polish: hash if
# _sym_count grows past a few thousand and benchmarks ask.
fn lsp_lookup_symbol(name, name_len): i64 {
    var i = 0;
    while (i < _sym_count) {
        var nlen = load64(_sym_name_len + i * 8);
        if (nlen == name_len) {
            var noff = load64(_sym_name_off + i * 8);
            if (memeq(_sym_names_buf + noff, name, name_len) == 1) {
                return i;
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Map an LSP position (0-based line + character) on the given file
# content to the IDENT under the cursor. Returns (start_offset_in_buf,
# end_offset_in_buf) packed: start in low 32 bits, end in high 32. -1
# if no IDENT under the cursor.
fn lsp_ident_at_position(buf, total, target_line, target_char): i64 {
    var line = 0;
    var pos = 0;
    while (line < target_line && pos < total) {
        if (load8(buf + pos) == 10) { line = line + 1; }
        pos = pos + 1;
    }
    # `pos` is now at start of `target_line`. Advance `target_char`
    # bytes (LSP's offsets are UTF-16 code units in spec, but we treat
    # them as bytes — accurate for ASCII-only cyrius source).
    var p = pos + target_char;
    if (p >= total) { return 0 - 1; }
    # Walk backward to find IDENT start.
    var s = p;
    while (s > pos && _lsp_id_cont(load8(buf + s - 1)) == 1) { s = s - 1; }
    if (s > 0 && _lsp_id_start(load8(buf + s)) == 0) { return 0 - 1; }
    if (s == p && _lsp_id_start(load8(buf + s)) == 0) { return 0 - 1; }
    var e = _lsp_scan_id_end(buf, s, total);
    if (e == s) { return 0 - 1; }
    return s | (e << 32);
}

# The largest document lsp_read_file reads: 64 MiB. Far past any cyrius source (lib/mabda.cyr,
# the largest, is 1.4 MB) and well inside the 32-bit offsets lsp_ident_at_position packs.
var _LSP_DOC_MAX = 67108864;

# Read a file into a buffer sized by fstat; return the NUL-terminated buffer and write its
# length to *total_out (0 and 0 when the file cannot be opened, sized or held). This read
# through a fixed 1 MB buffer until 6.6.17, silently: a larger document was cut at 1 MB, so
# definition / hover / references / semantic tokens past the cut found nothing (lib/mabda.cyr
# and lib/sigil.cyr are both over 1 MB). A size over _LSP_DOC_MAX is refused by name on the
# log. CHANGELOG [6.6.17]
fn lsp_read_file(path, total_out): i64 {
    store64(total_out, 0);
    var fd = sys_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var st[144];   # STAT_BUFSZ bytes
    var size = 0 - 1;
    if (sys_fstat(fd, &st) == 0) { size = load64(&st + STAT_SIZE); }
    if (size < 0 || size > _LSP_DOC_MAX) {
        sys_close(fd);
        _lsp_refuse_doc(path, size);
        return 0;
    }
    var buf = alloc(size + 1);
    if (buf == 0) { sys_close(fd); return 0; }
    var total = 0;
    var n = 1;
    while (n > 0 && total < size) {
        n = sys_read(fd, buf + total, size - total);
        if (n > 0) { total = total + n; }
    }
    sys_close(fd);
    store8(buf + total, 0);
    store64(total_out, total);
    return buf;
}

# Name a document lsp_read_file will not read: its path and size (or that fstat failed).
fn _lsp_refuse_doc(path, size): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "not reading ");
    str_builder_add_cstr(sb, path);
    if (size < 0) {
        str_builder_add_cstr(sb, ": fstat failed, so its size is unknown");
    } else {
        str_builder_add_cstr(sb, ": ");
        str_builder_add_int(sb, size);
        str_builder_add_cstr(sb, " bytes, over the 67108864-byte (64 MiB) document limit");
    }
    log_msg(str_data(str_builder_build(sb)));
    return 0;
}

# Find cycc binary — check common locations
# v5.11.44: the LSP binary's install directory, so find_cycc / find_cyrius locate a co-installed
# cycc even when the editor's launcher (Claude Code and others with a minimal inherited env) wipes
# PATH, CYRIUS_HOME and HOME. A pointer to the directory cstring, or 0.
# See: docs/development/proposals/archived/cyrius-lsp-argv0-self-resolution.md
# ⛔ 6.7.16 — macOS has no /proc, so the /proc/self/exe readlink failed there and this answered 0.
# There, as programs/cyrius-init.cyr's `_self_path` does: open argv(0) and ask fcntl(F_GETPATH = 50)
# for its real path. A bare argv(0) (no '/') was found through PATH, which this server does not
# search: opening it would resolve a same-named file in the working directory, so it answers 0.
# Elsewhere /proc/self/exe, as before. CHANGELOG [6.7.16]
fn _resolve_install_dir(): i64 {
    var buf = alloc(4096);
    var n = 0;
    #ifdef CYRIUS_TARGET_MACOS
    args_init();   # the argv API's contract; a no-op on macOS (the entry park already holds argv)
    var a0 = argv(0);
    if (a0 == 0 || _lsp_has(a0, "/") == 0) { return 0; }
    var afd = sys_open(a0, 0, 0);
    if (afd < 0) { return 0; }
    var gr = sys_fcntl(afd, 50, buf);
    sys_close(afd);
    if (gr < 0) { return 0; }
    n = strlen(buf);
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    n = sys_readlink("/proc/self/exe", buf, 4095);
    #endif
    if (n <= 0 || n >= 4096) { return 0; }
    store8(buf + n, 0);
    var i = n - 1;
    while (i >= 0) {
        if (load8(buf + i) == 47) { break; }
        i = i - 1;
    }
    if (i <= 0) { return 0; }
    store8(buf + i, 0);
    return buf;
}

# `<$name><suffix>` when the environment variable `name` is set and not empty and that path
# opens; else 0. The variable is read with getenv (lib/io.cyr): /proc/self/environ on Linux, the
# entry-stack envp on macOS. ⛔ 6.7.16 — find_cycc / find_cyrius opened /proc/self/environ
# themselves, which macOS does not have: HOME and CYRIUS_HOME read as unset there, so the server
# found no cycc ('cycc not found — diagnostics disabled') and published an empty list for a file
# with an error. CHANGELOG [6.7.16]
fn _lsp_env_path(name, suffix): i64 {
    var v = getenv(name);
    if (v == 0 || load8(v) == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, v);
    str_builder_add_cstr(sb, suffix);
    var p = str_data(str_builder_build(sb));
    var fd = sys_open(p, 0, 0);
    if (fd < 0) { return 0; }
    sys_close(fd);
    return p;
}

# `<install dir>/<name>` when the server's own directory holds `name` (see _resolve_install_dir);
# else 0.
fn _lsp_sibling(name): i64 {
    var dir = _resolve_install_dir();
    if (dir == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, name);
    var p = str_data(str_builder_build(sb));
    var fd = sys_open(p, 0, 0);
    if (fd < 0) { return 0; }
    sys_close(fd);
    return p;
}

# `p` when it opens, else 0.
fn _lsp_if_opens(p): i64 {
    var fd = sys_open(p, 0, 0);
    if (fd < 0) { return 0; }
    sys_close(fd);
    return p;
}

# The compiler the diagnostics run: $HOME/.cyrius/bin/cycc, then the server's own directory, then
# ./build/cycc, /usr/local/lib/cyrius/cycc and $CYRIUS_HOME/cycc; 0 when none opens.
# v5.11.54: $HOME/.cyrius/bin/cycc FIRST — the symlink to whatever ~/.cyrius/current points at
# (the LATEST installed cyrius). Diagnostics reflect the latest parser's view of the source: a
# user editing a v5.11.51+ byte-array-literal file in a project pinning `cyrius = "5.11.49"`
# should NOT see "expected ';'" errors from the .49 parser — `cyrius build` still respects the pin
# for the binary, but older-parser errors in the editor mislead (gnoboot-lsp-byte-array-literal).
# The install directory (v5.11.44) serves a launcher that passes no HOME.
fn find_cycc(): i64 {
    var p = _lsp_env_path("HOME", "/.cyrius/bin/cycc");
    if (p == 0) { p = _lsp_sibling("cycc"); }
    if (p == 0) { p = _lsp_if_opens("build/cycc"); }
    if (p == 0) { p = _lsp_if_opens("/usr/local/lib/cyrius/cycc"); }
    if (p == 0) { p = _lsp_env_path("CYRIUS_HOME", "/cycc"); }
    return p;
}

# v5.11.56: find the `cyrius` wrapper binary, in find_cycc's order ($HOME/.cyrius/bin → the
# install directory → ./build → /usr/local/lib/cyrius → $CYRIUS_HOME). 0 when not found;
# compile_and_capture then falls back to raw cycc.
fn find_cyrius(): i64 {
    var p = _lsp_env_path("HOME", "/.cyrius/bin/cyrius");
    if (p == 0) { p = _lsp_sibling("cyrius"); }
    if (p == 0) { p = _lsp_if_opens("build/cyrius"); }
    if (p == 0) { p = _lsp_if_opens("/usr/local/lib/cyrius/cyrius"); }
    if (p == 0) { p = _lsp_env_path("CYRIUS_HOME", "/cyrius"); }
    return p;
}

# v5.11.56: walk up from filepath looking for cyrius.cyml. Returns
# project root dir cstring on success, 0 if filepath is outside any
# cyrius project tree (caller falls back to raw cycc). Returned
# pointer is owned by the allocator; LSP doesn't free per-request
# buffers — alloc churn is bounded by edit cadence.
fn find_project_root(filepath): i64 {
    var flen = strlen(filepath);
    if (flen == 0) { return 0; }
    var pbuf = alloc(flen + 1);
    memcpy(pbuf, filepath, flen);
    store8(pbuf + flen, 0);
    var pos = flen;
    while (pos > 0) {
        pos = pos - 1;
        if (load8(pbuf + pos) == 47) {
            store8(pbuf + pos, 0);
            var sb = str_builder_new();
            str_builder_add_cstr(sb, pbuf);
            str_builder_add_cstr(sb, "/cyrius.cyml");
            var candidate = str_data(str_builder_build(sb));
            var ckfd = syscall(2, candidate, 0, 0);
            if (ckfd >= 0) {
                syscall(3, ckfd);
                var rlen = pos;
                var result = alloc(rlen + 1);
                memcpy(result, pbuf, rlen);
                store8(result + rlen, 0);
                return result;
            }
            store8(pbuf + pos, 47);
        }
    }
    return 0;
}

# v5.11.56: a NULL-terminated envp[] forwarding this server's environment to a child, or 0 when
# it has none. The cyrius wrapper needs HOME (for ~/.cyrius resolution) and PATH (for git fallbacks
# during deps fetch); an empty envp, as raw cycc gets, breaks ~/.cyrius/versions/X.Y.Z/ lookup.
# ⛔ 6.7.16 — built from lib/io.cyr's env_block (the block getenv reads), not from
# /proc/self/environ, which macOS does not have (there the wrapper ran with no environment). The
# whole environment: the /proc read stopped at 32767 bytes. The entries point into that shared
# block. CHANGELOG [6.7.16]
fn _lsp_envp(): i64 {
    var lenb[8];
    var blk = env_block(&lenb);
    var n = load64(&lenb);
    if (blk == 0 || n <= 0) { return 0; }
    var count = 0;
    var i = 0;
    while (i < n) {
        if (load8(blk + i) == 0) { count = count + 1; }
        i = i + 1;
    }
    var envp = alloc((count + 1) * 8);
    var ei = 0;
    var start = 0;
    i = 0;
    while (i < n) {
        if (load8(blk + i) == 0) {
            store64(envp + ei * 8, blk + start);
            ei = ei + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    store64(envp + ei * 8, 0);
    return envp;
}

# 6.6.20 — a failed fork (a process limit, memory) is said in the log, and the pipe is closed:
# `pid` is then -errno, and the parent used to read the pipe it still held both ends of — no
# child, so an immediate EOF — and publish EMPTY diagnostics for a file nobody compiled, then
# wait4 on a process group. Answers 0, the "could not launch" value both callers return.
fn _lsp_fork_failed(what, pid, pipe_read, pipe_write): i64 {
    sys_close(pipe_read);
    sys_close(pipe_write);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "could not start ");
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, ": fork failed (error ");
    str_builder_add_int(sb, 0 - pid);
    str_builder_add_cstr(sb, ") — no diagnostics for this file");
    log_msg(str_data(str_builder_build(sb)));
    return 0;
}

# Reap the diagnostics child (its status is not used — the diagnostics are what it wrote).
# The slot is zeroed and an EINTR retried, so the child is never left a zombie by a signal.
fn _lsp_reap(pid): i64 {
    var st[8];
    store64(&st, 0);
    var w = sys_waitpid(pid, &st, 0);
    while (w == 0 - 4) { w = sys_waitpid(pid, &st, 0); }
    return w;
}

# In a child: `fd` made standard fd `target`, then `fd` closed only when it is not `target`.
# ⛔ 6.7.16 — the children ran `sys_dup2(fd, N); sys_close(fd)`. In a server started with a std fd
# closed, the child's next open lands AT that fd: dup2(N, N) is a no-op and the close then closed the
# redirect just made, so the `cyrius check` / cycc child ran with that fd closed (its stdout, with
# the server's fd 1 closed). lib/process.cyr's `_proc_redirect` since 6.7.15, here.
# issues/2026-10-18-cbt-and-programs-child-redirects-close-their-own-std-fd.md, CHANGELOG [6.7.16]
fn _lsp_redirect(fd, target): i64 {
    sys_dup2(fd, target);
    if (fd != target) { sys_close(fd); }
    return 0;
}

# In a child: `fd`, a descriptor the SERVER opened (a pipe end), moved above the standard three
# (F_DUPFD: the lowest free fd >= 3) before the child's first redirect, which could otherwise
# replace it when it sits at 0 or 1 (a server started with those closed). `fd` itself when it is
# already above 2, or when no fd is left. lib/regression.cyr's `_regression_lift_fd`, here.
# CHANGELOG [6.7.16]
fn _lsp_lift_fd(fd): i64 {
    if (fd > 2) { return fd; }
    var nfd = sys_fcntl(fd, F_DUPFD, 3);
    if (nfd < 0) { return fd; }
    sys_close(fd);
    return nfd;
}

# 6.7.12 — the directory the diagnostics' relative file names resolve against first: the project
# root when the last compile ran `cyrius check` there; (6.7.13) outside a project this server's
# working directory, where both loose routes compile (0 when it cannot be read).
var _lsp_last_root = 0;
# 6.7.13 — the name the last `cyrius check` outside a project was given for the file (relative to
# the working directory when under it), so its verdict line is known; 0 otherwise. (6.7.16: in a
# project, what the unit's check was given — its entry from the root, or the lib/ include file.)
var _lsp_last_unit = 0;

# The largest compiler output _lsp_drain reads: 64 MiB, the cap _LSP_DOC_MAX sets for a document.
var _LSP_DRAIN_MAX = 67108864;

# Read `fd` to its end into a fresh NUL-terminated buffer that doubles as it fills.
# ⛔ 6.7.16 — both readers kept the first 8,191 bytes of the compiler's stderr and never read the
# rest: src/frontend/parse_ctrl.cyr compiled alone printed 11,163, and a unit compile can print an
# entry's warnings ahead of the open file's own error. Past _LSP_DRAIN_MAX it stops reading and says
# so in the log (the child then meets a closed pipe). CHANGELOG [6.7.16]
fn _lsp_drain(fd): i64 {
    var cap = 8192;
    var buf = alloc(cap);
    if (buf == 0) { return 0; }
    var total = 0;
    var go = 1;
    while (go == 1) {
        if (total + 1 >= cap) {
            if (cap >= _LSP_DRAIN_MAX) {
                log_msg("the compiler printed more than 64 MiB (_LSP_DRAIN_MAX): the rest is not read");
                break;
            }
            var nb = alloc(cap * 2);
            if (nb == 0) {
                log_msg("could not grow the compiler-output buffer: the rest is not read");
                break;
            }
            memcpy(nb, buf, total);
            buf = nb;
            cap = cap * 2;
        }
        var r = sys_read(fd, buf + total, cap - 1 - total);
        if (r == 0 - 4) { continue; }
        if (r <= 0) { go = 0; }
        else { total = total + r; }
    }
    store8(buf + total, 0);
    return buf;
}

# Run `path` with `argv` and `envp` (NULL-terminated arrays) from directory `cwd` (0: this server's),
# its stdin /dev/null and its standard fd `capfd` (1 or 2) a pipe this server drains (_lsp_drain),
# the other one /dev/null. The text, or 0 when the pipe or the fork failed. The child's redirects keep
# a fd that is already its target, and the pipe end is lifted above fd 2 first (6.7.16, see
# _lsp_redirect / _lsp_lift_fd). One runner for the check and for `cyrius build --print-config`.
fn _lsp_run_capture(path, argv, envp, cwd, capfd): i64 {
    var pipe_fds[16];
    if (sys_pipe(&pipe_fds) < 0) { return 0; }
    var pipe_read = load32(&pipe_fds);
    var pipe_write = load32(&pipe_fds + 4);
    var pid = sys_fork();
    if (pid < 0) { return _lsp_fork_failed(path, pid, pipe_read, pipe_write); }   # 6.6.20
    if (pid == 0) {
        sys_close(pipe_read);
        pipe_write = _lsp_lift_fd(pipe_write);
        var nfdi = sys_open("/dev/null", 0, 0);
        if (nfdi >= 0) { _lsp_redirect(nfdi, 0); }
        var nfdo = sys_open("/dev/null", 1, 0);
        if (nfdo >= 0) { _lsp_redirect(nfdo, 3 - capfd); }
        _lsp_redirect(pipe_write, capfd);
        # v6.5.16: sys_chdir, not a raw x86 `syscall(80, ...)` — 80 is the aarch64 peer's SYS_FSTAT
        # (tests/gates/platform/macho_route_parity.sh).
        if (cwd != 0) { sys_chdir(cwd); }
        sys_execve(path, argv, envp);
        sys_exit(127);
    }
    sys_close(pipe_write);
    var out = _lsp_drain(pipe_read);
    sys_close(pipe_read);
    _lsp_reap(pid);
    return out;
}

# `envp` (a NULL-terminated array, or 0 for none) for a unit compiled for ONE target: every
# inherited target selector dropped (an editor started under CYRIUS_TARGET_WIN=1 would compile every
# unit for Windows) and `selector` (an entry such as "CYRIUS_TARGET_WIN=1", or 0) added. A fresh
# array. CHANGELOG [6.7.16]
fn _lsp_envp_target(envp, selector): i64 {
    var n = 0;
    if (envp != 0) { while (load64(envp + n * 8) != 0) { n = n + 1; } }
    var out = alloc((n + 2) * 8);
    var k = 0;
    var i = 0;
    while (i < n) {
        var e = load64(envp + i * 8);
        if (_lsp_env_selects(e) == 0) {
            store64(out + k * 8, e);
            k = k + 1;
        }
        i = i + 1;
    }
    if (selector != 0) {
        store64(out + k * 8, selector);
        k = k + 1;
    }
    store64(out + k * 8, 0);
    return out;
}

# 1 when environment entry `e` selects a compile target (what _lsp_envp_target drops).
fn _lsp_env_selects(e): i64 {
    if (_lsp_env_named(e, "CYRIUS_TARGET_WIN=") == 1) { return 1; }
    if (_lsp_env_named(e, "CYRIUS_TARGET_AGNOS=") == 1) { return 1; }
    if (_lsp_env_named(e, "CYRIUS_TARGET_EFI=") == 1) { return 1; }
    if (_lsp_env_named(e, "CYRIUS_MACHO=") == 1) { return 1; }
    if (_lsp_env_named(e, "CYRIUS_MACHO_ARM=") == 1) { return 1; }
    return 0;
}

# ================================================================
# COMPILE UNITS (6.7.16)
# ================================================================
# ⛔ issues/2026-10-19-cyrius-lsp-compiles-an-include-fragment-alone.md — in a project the open file
# was always the unit (`cyrius check --with-deps --no-redirect <the open file>`). A file that is an
# `include` of another was compiled ALONE, so every name an earlier include declares read
# "undefined": 55 false errors on src/frontend/parse_ctrl.cyr, a duplicate-fn warning for each fn of
# lib/string.cyr and 67 on lib/syscalls_windows.cyr (the [deps] prepend defining them first), and 3
# errors on bootstrap/cybs.cyr (assembly for the seed's bootstrap/asm, not cycc input). Now each file
# is checked through its UNIT — (entry, target, deps) — chosen from the project's include graph, in
# one of five modes:
#   SELF      an entry: checked itself, and each file its compile names gets its list, as before
#             (a project file with the [deps] prepend; a lib/ module standalone, below)
#   FRAGMENT  reached from an entry on this server's own target: the entry is compiled; the open
#             file and each named file whose own unit is the same get their lists (one file, one
#             unit: a shared include another entry reaches first is left to that entry)
#   PEER      reached only on a target this server selects by environment (an x86_64 Linux server:
#             CYRIUS_TARGET_WIN=1, CYRIUS_TARGET_AGNOS=1, CYRIUS_MACHO=1, CYRIUS_TARGET_EFI=1): the
#             entry is compiled under it, and the open file gets its list (and the unit's other
#             open PEERs theirs)
#   NOTE      reached only on a target this server cannot compile for (aarch64, cx): no compile, one
#             Information diagnostic saying so
#   SKIP      named by the manifest's `[lsp] skip`: never compiled
# A FRAGMENT or PEER whose own list is clean while its unit has errors gets a one-line Information
# note naming the unit, kept in step by every publish of the unit (_lsp_pub_record). THE GRAPH:
# every .cyr under the root but hidden directories, the root's build/
# and dist/, and a subdirectory with its own cyrius.cyml (a sub-project); test files are not in it (a
# test's includes make nothing a fragment, and a test is its own unit). Each column-0 `include "x"`
# resolves as cycc resolves it — from the root, then the entry's own directory (the CLI's `#@incdir`)
# — and holds on the targets its #ifdef / #ifndef stack lets it through (_cu_sym_mask). ENTRIES: the
# manifest's [build] entry (`cyrius build --print-config`: the CLI's own resolution, `src` included),
# then every non-lib/ .cyr no other .cyr includes. A fragment's entry: the manifest's first, then the
# fewest include hops, then path order. lib/ keeps the contract
# tests/gates/toolchain/stdlib_modules_self_sufficient.sh pins: a peer is lib/<R>_<x>.cyr where
# lib/<R>.cyr exists, included by R's family, with no `# Usage: include` line of its own and no
# distlib marker; anything else is public, checked as `include "lib/<m>.cyr"` alone (no prepend), and
# a peer is checked through its nearest public includer under the target that includes it. The graph
# is kept per root and refreshed by mtime + size (an unknown file walks it again); a unit's compile is
# kept on its closure's mtimes and sizes, lib/**, the manifest + lock and the CLI / cycc binaries, so N
# fragments of one entry cost one compile. CHANGELOG [6.7.16]
#
# A graph (alloc 136): 0 root  8 its length  16 files (a vec of file records, sorted by path)  24 / 32
#   the path index and its capacity  40 generation (bumped on every change)  48 the manifest entry's
#   index (-1 none)  56 the [lsp] skip paths (absolute)  64 what the configuration was read from
#   72 the unit compiles kept  80 opened files the walk does not reach  88 1 once walked  96 the
#   entries in rank order  104 the walk stamp  112 1 once the configuration was read  120 the manifest
#   entry relative to the root (0 none)  128 1 after a walk: every edge is resolved again
# A file record (alloc 112): 0 path (absolute)  8 the same past root + "/"  16 / 24 / 32 mtime sec /
#   nsec / size  40 flags (_CU_LIB / _CU_FOLD / _CU_USAGE / _CU_INCLUDED)  48 its include edges  56 /
#   64 its unit and the generation it was chosen in  72 1 = a lib/ peer  80 its lib/ includers (a vec
#   of index, target-bits pairs)  88 / 96 a walk's stamp and hops  104 its closures as an entry (one
#   slot per target)
# An edge (alloc 32): 0 the include path as written  8 the targets it holds on  16 the file it names
#   from the root (-1 none, -2 not resolved yet)  24 from the includer's own directory (-1 none)
# A unit (alloc 64): 0 mode  8 entry (absolute)  16 entry (from the root)  24 target  32 deps (1 =
#   --with-deps --no-redirect, 0 = `include "<entry>"` alone)  40 key  48 a NOTE's text  56 root
var _CU_SELF = 1;
var _CU_FRAGMENT = 2;
var _CU_PEER = 3;
var _CU_NOTE = 4;
var _CU_SKIP = 5;
var _CU_LIB = 2;
var _CU_FOLD = 4;
var _CU_USAGE = 8;
var _CU_INCLUDED = 16;
# The targets an #ifdef stack is read for, one bit each: 0 x86_64 Linux, 1 Windows, 2 agnos,
# 3 x86_64 macOS, 4 EFI, 5 aarch64 Linux, 6 aarch64 macOS, 7 cx.
var _CU_NCFG = 8;
var _CU_ALL = 255;
var _CU_FNV = 1469598103934665603;

var _cu_graphs = 0;   # vec of graphs, one per project root
var _cu_cur_g = 0;    # the graph of the document being handled (0: none)
var _cu_st = 0;       # a stat buffer
var _cu_rb = 0;       # the reused read buffer the scan reads a file into, and its capacity
var _cu_rbcap = 0;
var _cu_stk = 0;      # the scan's #if stack: 64 frames of (targets before it, its #else side)
var _cu_dl_scr = 0;   # the directory listing's buffers (dir_list_into), grown to fit
var _cu_dl_names = 0;
var _cu_dl_ncap = 0;
var _cu_dl_offs = 0;
var _cu_dl_omax = 0;
var _cu_tmpdir = 0;   # the private directory of the lib/ include file, and the file
var _cu_wrapfile = 0;

fn _cu_cfg_name(c): i64 {
    if (c == 0) { return "x86_64 Linux"; }
    if (c == 1) { return "Windows"; }
    if (c == 2) { return "agnos"; }
    if (c == 3) { return "x86_64 macOS"; }
    if (c == 4) { return "EFI"; }
    if (c == 5) { return "aarch64 Linux"; }
    if (c == 6) { return "aarch64 macOS"; }
    return "cx";
}

# The environment entry that makes an x86_64 cycc compile for target `c`; 0 for none (the host).
# The host is checked first: on an x86_64 macOS server target 3 IS the host, and a host unit carries
# no selector (nor names one in its note). CHANGELOG [6.7.16]
fn _cu_cfg_env(c): i64 {
    if (c == _cu_host_cfg()) { return 0; }
    if (c == 1) { return "CYRIUS_TARGET_WIN=1"; }
    if (c == 2) { return "CYRIUS_TARGET_AGNOS=1"; }
    if (c == 3) { return "CYRIUS_MACHO=1"; }
    if (c == 4) { return "CYRIUS_TARGET_EFI=1"; }
    return 0;
}

# The target this server's unselected compiles are for: its own.
fn _cu_host_cfg(): i64 {
    #ifdef CYRIUS_TARGET_MACOS
    #ifdef CYRIUS_ARCH_AARCH64
    return 6;
    #endif
    return 3;
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    return 5;
    #endif
    return 0;
}

# The k-th target a unit is looked for on: the host first, then — an x86_64 Linux server only, whose
# cycc selects them by environment — Windows, agnos, x86_64 macOS and EFI; -1 past the last.
fn _cu_try_cfg(k): i64 {
    if (k == 0) { return _cu_host_cfg(); }
    if (_cu_host_cfg() != 0 || k > 4) { return 0 - 1; }
    return k;
}

# 1 when this server compiles for target `c` (the host, or one _cu_try_cfg selects).
fn _cu_can_select(c): i64 {
    if (c == _cu_host_cfg()) { return 1; }
    if (_cu_host_cfg() == 0 && c >= 1 && c <= 4) { return 1; }
    return 0;
}

# The targets (bits) an `#ifdef <s[0, n)>` holds on — the predefines each target's cycc sets — or -1
# for any other name (a project's own flag, CYRIUS_POISON): both of its sides are kept.
fn _cu_sym_mask(s, n): i64 {
    if (n == 19 && memeq(s, "CYRIUS_TARGET_LINUX", 19) == 1) { return 33; }
    if (n == 17 && memeq(s, "CYRIUS_TARGET_WIN", 17) == 1) { return 18; }
    if (n == 17 && memeq(s, "CYRIUS_TARGET_EFI", 17) == 1) { return 16; }
    if (n == 19 && memeq(s, "CYRIUS_TARGET_MACOS", 19) == 1) { return 72; }
    if (n == 19 && memeq(s, "CYRIUS_TARGET_AGNOS", 19) == 1) { return 4; }
    if (n == 16 && memeq(s, "CYRIUS_TARGET_CX", 16) == 1) { return 128; }
    if (n == 15 && memeq(s, "CYRIUS_ARCH_X86", 15) == 1) { return 31; }
    if (n == 19 && memeq(s, "CYRIUS_ARCH_AARCH64", 19) == 1) { return 96; }
    if (n == 26 && memeq(s, "CYRIUS_HAS_VAL_SIMD_PARAMS", 26) == 1) { return 255; }
    return 0 - 1;
}

fn _cu_mode_name(m): i64 {
    if (m == _CU_SELF) { return "itself"; }
    if (m == _CU_FRAGMENT) { return "fragment"; }
    if (m == _CU_PEER) { return "peer"; }
    if (m == _CU_NOTE) { return "note"; }
    return "skip";
}

fn _cu_f(g, i): i64 { return vec_get(load64(g + 16), i); }
fn _cu_nf(g): i64 { return vec_len(load64(g + 16)); }
fn _cu_flag(f, b): i64 {
    if ((load64(f + 40) & b) != 0) { return 1; }
    return 0;
}

# a + b as a fresh cstr.
fn _cu_cat(a, b): i64 {
    var al = strlen(a);
    var bl = strlen(b);
    var r = alloc(al + bl + 1);
    memcpy(r, a, al);
    memcpy(r + al, b, bl);
    store8(r + al + bl, 0);
    return r;
}

# `dir` + "/" + `inc` with any leading "./" of `inc` dropped; `inc` itself when it is absolute.
fn _cu_resolve_name(dir, inc): i64 {
    if (load8(inc) == 47) { return inc; }
    var p = inc;
    while (load8(p) == 46 && load8(p + 1) == 47) { p = p + 2; }
    return _lsp_join(dir, p, 0, strlen(p));
}

fn _cu_strcmp(a, b): i64 {
    var i = 0;
    while (load8(a + i) == load8(b + i)) {
        if (load8(a + i) == 0) { return 0; }
        i = i + 1;
    }
    return load8(a + i) - load8(b + i);
}

fn _cu_cmp_files(a, b): i64 { return _cu_strcmp(load64(a + 8), load64(b + 8)); }

fn _cu_hash_str(h, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        h = (h ^ load8(s + i)) * 1099511628211;
        i = i + 1;
    }
    return h;
}

fn _cu_hash_int(h, v): i64 {
    var k = 0;
    while (k < 8) {
        h = (h ^ ((v >> (k * 8)) & 255)) * 1099511628211;
        k = k + 1;
    }
    return h;
}

# stat `path` into _cu_st: its mode bits, or -1. _cu_st_mt / _mn / _sz read the rest.
fn _cu_stat(path): i64 {
    if (_cu_st == 0) { _cu_st = alloc(256); }
    if (sys_stat(path, _cu_st) < 0) { return 0 - 1; }
    return load32(_cu_st + STAT_MODE) & 65535;
}
fn _cu_st_mt(): i64 { return load64(_cu_st + STAT_MTIME); }
fn _cu_st_mn(): i64 { return load64(_cu_st + STAT_MTIME_NSEC); }
fn _cu_st_sz(): i64 { return load64(_cu_st + STAT_SIZE); }

# `h` mixed with `path`'s mtime and size (-1 when it does not stat).
fn _cu_mix_stat(h, path): i64 {
    if (path == 0 || _cu_stat(path) < 0) { return _cu_hash_int(h, 0 - 1); }
    h = _cu_hash_int(h, _cu_st_mt());
    h = _cu_hash_int(h, _cu_st_mn());
    return _cu_hash_int(h, _cu_st_sz());
}

# `h` mixed with file record `f`'s path and the mtime and size its refresh read.
fn _cu_mix_rec(h, f): i64 {
    h = _cu_hash_str(h, load64(f));
    h = _cu_hash_int(h, load64(f + 16));
    h = _cu_hash_int(h, load64(f + 24));
    return _cu_hash_int(h, load64(f + 32));
}

# The path index of graph `g`: open addressing over its files' paths.
fn _cu_index(g): i64 {
    var n = _cu_nf(g);
    var cap = 64;
    while (cap < n * 2 + 16) { cap = cap * 2; }
    var t = alloc(cap * 8);
    memset(t, 0, cap * 8);
    var i = 0;
    while (i < n) {
        var s = _cu_hash_str(_CU_FNV, load64(_cu_f(g, i))) & (cap - 1);
        while (load64(t + s * 8) != 0) { s = (s + 1) & (cap - 1); }
        store64(t + s * 8, i + 1);
        i = i + 1;
    }
    store64(g + 24, t);
    store64(g + 32, cap);
    return 0;
}

# The index of the file at absolute `path` in graph `g`, or -1.
fn _cu_find(g, path): i64 {
    var t = load64(g + 24);
    if (t == 0) { return 0 - 1; }
    var cap = load64(g + 32);
    var s = _cu_hash_str(_CU_FNV, path) & (cap - 1);
    while (load64(t + s * 8) != 0) {
        var i = load64(t + s * 8) - 1;
        if (streq(load64(_cu_f(g, i)), path) == 1) { return i; }
        s = (s + 1) & (cap - 1);
    }
    return 0 - 1;
}

# Read `path` whole into the reused buffer _cu_rb (up to _LSP_DOC_MAX); its length, or -1.
fn _cu_read(path): i64 {
    var fd = sys_open(path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    if (_cu_rb == 0) {
        _cu_rbcap = 262144;
        _cu_rb = alloc(_cu_rbcap);
    }
    var n = 0;
    var go = 1;
    while (go == 1) {
        if (n + 1 >= _cu_rbcap) {
            var nb = 0;
            if (_cu_rbcap < _LSP_DOC_MAX) { nb = alloc(_cu_rbcap * 2); }
            if (nb == 0) { break; }
            memcpy(nb, _cu_rb, n);
            _cu_rb = nb;
            _cu_rbcap = _cu_rbcap * 2;
        }
        var r = sys_read(fd, _cu_rb + n, _cu_rbcap - 1 - n);
        if (r == 0 - 4) { continue; }
        if (r <= 0) { go = 0; }
        else { n = n + r; }
    }
    sys_close(fd);
    store8(_cu_rb + n, 0);
    return n;
}

# The offset of `needle` in buf[a, b), or -1.
fn _cu_find_in(buf, a, b, needle): i64 {
    var nl = strlen(needle);
    var p = a;
    while (p + nl <= b) {
        if (memeq(buf + p, needle, nl) == 1) { return p; }
        p = p + 1;
    }
    return 0 - 1;
}

# 1 when buf[w, w + n) is the directive word `word`.
fn _cu_word(buf, w, n, word): i64 {
    if (n != strlen(word)) { return 0; }
    return memeq(buf + w, word, n);
}

# Read file record `f` from disk: its include edges, each with the targets its #ifdef / #ifndef stack
# lets it through, and for a lib/ file its distlib marker (the first 40 lines) and its own `# Usage:
# include "<path>"` line. An `include` counts at column 0 only, as cycc reads it; `#if`, `#ifplat`,
# `#elif` and a flag that is not a target predefine keep both of their sides.
fn _cu_scan(f): i64 {
    var edges = vec_new();
    store64(f + 48, edges);
    var fl = load64(f + 40) & _CU_LIB;
    var n = _cu_read(load64(f));
    if (n < 0) {
        store64(f + 40, fl);
        return 0;
    }
    var buf = _cu_rb;
    var uneedle = 0;
    if (fl != 0) { uneedle = _cu_cat(_cu_cat("include \"", load64(f + 8)), "\""); }
    if (_cu_stk == 0) { _cu_stk = alloc(1024); }
    var stk = _cu_stk;
    var depth = 0;
    var over = 0;
    var cur = _CU_ALL;
    var line = 0;
    var pos = 0;
    while (pos < n) {
        var eol = pos;
        while (eol < n && load8(buf + eol) != 10) { eol = eol + 1; }
        if (eol - pos > 9 && memeq(buf + pos, "include \"", 9) == 1) {
            var qs = pos + 9;
            var qe = qs;
            while (qe < eol && load8(buf + qe) != 34) { qe = qe + 1; }
            if (qe < eol && qe > qs) {
                var inc = alloc(qe - qs + 1);
                memcpy(inc, buf + qs, qe - qs);
                store8(inc + qe - qs, 0);
                var e = alloc(32);
                store64(e, inc);
                store64(e + 8, cur);
                store64(e + 16, 0 - 2);   # not resolved yet (_cu_derive)
                store64(e + 24, 0 - 1);
                vec_push(edges, e);
            }
        } else {
            var p = pos;
            while (p < eol && (load8(buf + p) == 32 || load8(buf + p) == 9)) { p = p + 1; }
            if (p < eol && load8(buf + p) == 35) {
                var w = p + 1;
                var we = w;
                while (we < eol && load8(buf + we) > 32) { we = we + 1; }
                var wl = we - w;
                var sp = we;
                while (sp < eol && (load8(buf + sp) == 32 || load8(buf + sp) == 9)) { sp = sp + 1; }
                var se = sp;
                while (se < eol && _lsp_id_cont(load8(buf + se)) == 1) { se = se + 1; }
                var isdef = _cu_word(buf, w, wl, "ifdef");
                if (isdef == 1 || _cu_word(buf, w, wl, "ifndef") == 1) {
                    if (depth < 64) {
                        var m = _cu_sym_mask(buf + sp, se - sp);
                        var a = cur;
                        var b = cur;
                        if (m >= 0 && isdef == 1) { a = cur & m; b = cur & (_CU_ALL - m); }
                        if (m >= 0 && isdef == 0) { a = cur & (_CU_ALL - m); b = cur & m; }
                        store64(stk + depth * 16, cur);
                        store64(stk + depth * 16 + 8, b);
                        cur = a;
                        depth = depth + 1;
                    } else { over = over + 1; }
                } elif (_cu_word(buf, w, wl, "if") == 1 || _cu_word(buf, w, wl, "ifplat") == 1) {
                    if (depth < 64) {
                        store64(stk + depth * 16, cur);
                        store64(stk + depth * 16 + 8, cur);
                        depth = depth + 1;
                    } else { over = over + 1; }
                } elif (_cu_word(buf, w, wl, "elif") == 1) {
                    if (over == 0 && depth > 0) {
                        cur = load64(stk + (depth - 1) * 16);
                        store64(stk + (depth - 1) * 16 + 8, cur);
                    }
                } elif (_cu_word(buf, w, wl, "else") == 1) {
                    if (over == 0 && depth > 0) { cur = load64(stk + (depth - 1) * 16 + 8); }
                } elif (_cu_word(buf, w, wl, "endif") == 1 || _cu_word(buf, w, wl, "endplat") == 1) {
                    if (over > 0) { over = over - 1; }
                    elif (depth > 0) {
                        depth = depth - 1;
                        cur = load64(stk + depth * 16);
                    }
                }
            }
        }
        if (fl != 0) {
            if (line < 40) {
                if (_cu_find_in(buf, pos, eol, "Generated by: cyrius distlib") >= 0) { fl = fl | _CU_FOLD; }
                if (_cu_find_in(buf, pos, eol, "Bundled distribution of") >= 0) { fl = fl | _CU_FOLD; }
            }
            if (load8(buf + pos) == 35) {
                var us = _cu_find_in(buf, pos, eol, "sage:");
                if (us >= 0 && _cu_find_in(buf, us, eol, uneedle) >= 0) { fl = fl | _CU_USAGE; }
            }
        }
        pos = eol + 1;
        line = line + 1;
    }
    store64(f + 40, fl);
    return 0;
}

# The entries of directory `d` into the reused name buffers (name k at _cu_dl_names +
# _cu_dl_offs[k]); their count, or a negative error. The buffers grow until the directory fits.
fn _cu_list(d): i64 {
    if (_cu_dl_scr == 0) {
        _cu_dl_scr = alloc(4096);
        _cu_dl_ncap = 65536;
        _cu_dl_names = alloc(_cu_dl_ncap);
        _cu_dl_omax = 2048;
        _cu_dl_offs = alloc(_cu_dl_omax * 8);
    }
    var ds = str_from(d);
    var tries = 0;
    while (tries < 24) {
        var r = dir_list_into(ds, _cu_dl_scr, 4096, _cu_dl_names, _cu_dl_ncap, _cu_dl_offs, _cu_dl_omax);
        if (r == 0 - 3) {
            _cu_dl_ncap = _cu_dl_ncap * 2;
            _cu_dl_names = alloc(_cu_dl_ncap);
        } elif (r == 0 - 4) {
            _cu_dl_omax = _cu_dl_omax * 2;
            _cu_dl_offs = alloc(_cu_dl_omax * 8);
        } else { return r; }
        tries = tries + 1;
    }
    return 0 - 1;
}

# The record for `path` (statted: mtime `mt` / `mn`, size `sz`): the previous walk's when unchanged,
# its scan kept; else a new one, scanned.
fn _cu_record(g, oldfiles, path, mt, mn, sz): i64 {
    if (oldfiles != 0) {
        var oi = _cu_find(g, path);
        if (oi >= 0) {
            var of = vec_get(oldfiles, oi);
            if (load64(of + 16) == mt && load64(of + 24) == mn && load64(of + 32) == sz) { return of; }
        }
    }
    var f = alloc(112);
    memset(f, 0, 112);
    store64(f, path);
    var rel = path + load64(g + 8) + 1;
    store64(f + 8, rel);
    store64(f + 16, mt);
    store64(f + 24, mn);
    store64(f + 32, sz);
    if (memeq(rel, "lib/", 4) == 1) { store64(f + 40, _CU_LIB); }
    _cu_scan(f);
    return f;
}

# Walk graph `g`'s root: every .cyr file, but not under a hidden directory, the root's build/ or dist/,
# a linked directory, or a subdirectory with its own cyrius.cyml (a sub-project). Sorted by path.
fn _cu_walk(g): i64 {
    var root = load64(g);
    var oldfiles = 0;
    if (load64(g + 88) == 1) { oldfiles = load64(g + 16); }
    var files = vec_new();
    var dirs = vec_new();
    vec_push(dirs, root);
    while (vec_len(dirs) > 0) {
        var d = vec_pop(dirs);
        var atroot = streq(d, root);
        var cnt = _cu_list(d);
        var k = 0;
        while (k < cnt) {
            var name = _cu_dl_names + load64(_cu_dl_offs + k * 8);
            k = k + 1;
            if (load8(name) == 46) { continue; }
            var full = _lsp_join(d, name, 0, strlen(name));
            var mode = _cu_stat(full);
            if (mode < 0) { continue; }
            var mt = _cu_st_mt();
            var mn = _cu_st_mn();
            var sz = _cu_st_sz();
            if ((mode & 61440) == 16384) {
                if (atroot == 1 && (streq(name, "build") == 1 || streq(name, "dist") == 1)) { continue; }
                var lb[16];
                if (sys_readlink(full, &lb, 8) >= 0) { continue; }
                if (file_exists(_lsp_join(full, "cyrius.cyml", 0, 11)) == 1) { continue; }
                vec_push(dirs, full);
            } elif ((mode & 61440) == 32768 && _lsp_ends(name, ".cyr") == 1) {
                vec_push(files, _cu_record(g, oldfiles, full, mt, mn, sz));
            }
        }
    }
    vec_sort_by(files, &_cu_cmp_files);
    store64(g + 16, files);
    store64(g + 88, 1);
    store64(g + 128, 1);   # the file indices moved: every edge is resolved again
    return 0;
}

# The length of lib/ file `f`'s stem when it is top-level ("lib/<stem>.cyr"), else -1.
fn _cu_stem_len(f): i64 {
    if (_cu_flag(f, _CU_LIB) == 0) { return 0 - 1; }
    var rel = load64(f + 8);
    var sl = strlen(rel) - 8;
    if (sl <= 0) { return 0 - 1; }
    var q = 0;
    while (q < sl) {
        if (load8(rel + 4 + q) == 47) { return 0 - 1; }
        q = q + 1;
    }
    return sl;
}

# 1 when lib/ file `i` is a PEER, by the stdlib's contract (stdlib_modules_self_sufficient.sh): it is
# lib/<R>_<x>.cyr where lib/<R>.cyr exists (the longest such R), a file of R's family (R itself or an
# R_*) includes it, and it has neither the distlib marker nor a `# Usage: include` line naming itself.
fn _cu_lib_peer(g, i): i64 {
    var f = _cu_f(g, i);
    if (_cu_flag(f, _CU_FOLD) == 1 || _cu_flag(f, _CU_USAGE) == 1) { return 0; }
    var sl = _cu_stem_len(f);
    if (sl <= 0) { return 0; }
    var stem = load64(f + 8) + 4;
    var n = _cu_nf(g);
    var rl = 0;
    var j = 0;
    while (j < n) {
        var rj = _cu_stem_len(_cu_f(g, j));
        if (rj > rl && rj < sl && load8(stem + rj) == 95) {
            if (memeq(stem, load64(_cu_f(g, j) + 8) + 4, rj) == 1) { rl = rj; }
        }
        j = j + 1;
    }
    if (rl == 0) { return 0; }
    var rd = load64(f + 80);
    var k = 0;
    while (k < vec_len(rd)) {
        var inf = _cu_f(g, vec_get(rd, k));
        var il = _cu_stem_len(inf);
        var is = load64(inf + 8) + 4;
        if (il >= rl && memeq(is, stem, rl) == 1) {
            if (il == rl || load8(is + rl) == 95) { return 1; }
        }
        k = k + 2;
    }
    return 0;
}

# Resolve edge `e` of file record `f`: the file it names from the root (e + 16), else — for the "is it
# included" test only — from the includer's own directory (e + 24); -1 when none.
fn _cu_resolve_edge(g, f, e): i64 {
    var inc = load64(e);
    var t = _cu_find(g, _cu_resolve_name(load64(g), inc));
    store64(e + 16, t);
    store64(e + 24, 0 - 1);
    if (t < 0 && load8(inc) != 47) { store64(e + 24, _cu_find(g, _cu_resolve_name(_lsp_dir_of(load64(f)), inc))); }
    return 0;
}

# Graph `g`'s derived state, after a walk or a rescan: the path index, every edge resolved (from the
# root, else — for the "is it included" test only — from the includer's own directory), each file's
# `included` flag and lib/ includers, the lib/ classes, the manifest entry and the ranked entries.
fn _cu_derive(g): i64 {
    _cu_index(g);
    var root = load64(g);
    var n = _cu_nf(g);
    var i = 0;
    while (i < n) {
        var f = _cu_f(g, i);
        store64(f + 40, load64(f + 40) & (0 - 1 - _CU_INCLUDED));
        store64(f + 56, 0);
        store64(f + 72, 0);
        store64(f + 80, vec_new());
        store64(f + 104, 0);
        i = i + 1;
    }
    var all = load64(g + 128);
    store64(g + 128, 0);
    i = 0;
    while (i < n) {
        var f2 = _cu_f(g, i);
        var edges = load64(f2 + 48);
        var j = 0;
        while (j < vec_len(edges)) {
            var e = vec_get(edges, j);
            j = j + 1;
            # An edge is resolved once — after its file's scan, or after a walk moved the indices —
            # so a save does not re-join every include path of the project (no allocator free).
            if (all != 0 || load64(e + 16) == 0 - 2) { _cu_resolve_edge(g, f2, e); }
            var t = load64(e + 16);
            if (t < 0) { t = load64(e + 24); }
            if (t >= 0 && t != i && load64(e + 8) != 0) {
                var tf = _cu_f(g, t);
                store64(tf + 40, load64(tf + 40) | _CU_INCLUDED);
                if (_cu_flag(f2, _CU_LIB) == 1 && _cu_flag(tf, _CU_LIB) == 1) {
                    vec_push(load64(tf + 80), i);
                    vec_push(load64(tf + 80), load64(e + 8));
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        var f3 = _cu_f(g, i);
        if (_cu_flag(f3, _CU_LIB) == 1) { store64(f3 + 72, _cu_lib_peer(g, i)); }
        i = i + 1;
    }
    var mi = 0 - 1;
    if (load64(g + 120) != 0) { mi = _cu_find(g, _cu_resolve_name(root, load64(g + 120))); }
    if (mi >= 0 && _cu_flag(_cu_f(g, mi), _CU_LIB) == 1) { mi = 0 - 1; }
    store64(g + 48, mi);
    var ents = vec_new();
    if (mi >= 0) { vec_push(ents, mi); }
    i = 0;
    while (i < n) {
        var f4 = _cu_f(g, i);
        if (i != mi && _cu_flag(f4, _CU_LIB) == 0 && _cu_flag(f4, _CU_INCLUDED) == 0) { vec_push(ents, i); }
        i = i + 1;
    }
    store64(g + 96, ents);
    store64(g + 40, load64(g + 40) + 1);
    return 0;
}

# Entry `e`'s closure on target `c` (a bit index): a vec of (file index, include hops) pairs, every
# non-lib/ file it reaches through edges that hold on `c`, each resolved as cycc resolves it for this
# entry — from the root, then the entry's own directory (the `#@incdir` the CLI writes). Kept until
# the graph changes.
fn _cu_closure(g, e, c): i64 {
    var ef = _cu_f(g, e);
    var slots = load64(ef + 104);
    if (slots == 0) {
        slots = alloc(_CU_NCFG * 8);
        memset(slots, 0, _CU_NCFG * 8);
        store64(ef + 104, slots);
    }
    var have = load64(slots + c * 8);
    if (have != 0) { return have; }
    var root = load64(g);
    var incdir = _lsp_incdir(load64(ef + 8));
    var idir = 0;
    if (incdir != 0) { idir = _lsp_join(root, incdir, 0, strlen(incdir)); }
    var bit = 1 << c;
    var stamp = load64(g + 104) + 1;
    store64(g + 104, stamp);
    var out = vec_new();
    store64(ef + 88, stamp);
    vec_push(out, e);
    vec_push(out, 0);
    var qi = 0;
    while (qi < vec_len(out)) {
        var x = vec_get(out, qi);
        var hx = vec_get(out, qi + 1);
        qi = qi + 2;
        var edges = load64(_cu_f(g, x) + 48);
        var j = 0;
        while (j < vec_len(edges)) {
            var ed = vec_get(edges, j);
            j = j + 1;
            if ((load64(ed + 8) & bit) == 0) { continue; }
            var t = load64(ed + 16);
            if (t < 0 && idir != 0 && load8(load64(ed)) != 47) { t = _cu_find(g, _cu_resolve_name(idir, load64(ed))); }
            if (t < 0) { continue; }
            var tf = _cu_f(g, t);
            if (_cu_flag(tf, _CU_LIB) == 1 || load64(tf + 88) == stamp) { continue; }
            store64(tf + 88, stamp);
            vec_push(out, t);
            vec_push(out, hx + 1);
        }
    }
    store64(slots + c * 8, out);
    return out;
}

# The include hops from entry `e` to file `i` on target `c`, or -1 when `e` does not reach it there.
fn _cu_hops(g, e, i, c): i64 {
    var cl = _cu_closure(g, e, c);
    var k = 0;
    while (k < vec_len(cl)) {
        if (vec_get(cl, k) == i) { return vec_get(cl, k + 1); }
        k = k + 2;
    }
    return 0 - 1;
}

# The public lib/ module nearest above peer `i` on target `c` — the fewest include hops up lib/
# includers whose edge holds on `c`, then path order — or -1.
fn _cu_lib_ancestor(g, i, c): i64 {
    var bit = 1 << c;
    var stamp = load64(g + 104) + 1;
    store64(g + 104, stamp);
    store64(_cu_f(g, i) + 88, stamp);
    var front = vec_new();
    vec_push(front, i);
    while (vec_len(front) > 0) {
        var next = vec_new();
        var best = 0 - 1;
        var k = 0;
        while (k < vec_len(front)) {
            var rd = load64(_cu_f(g, vec_get(front, k)) + 80);
            k = k + 1;
            var j = 0;
            while (j < vec_len(rd)) {
                var a = vec_get(rd, j);
                var m = vec_get(rd, j + 1);
                j = j + 2;
                if ((m & bit) == 0) { continue; }
                var af = _cu_f(g, a);
                if (load64(af + 88) == stamp) { continue; }
                store64(af + 88, stamp);
                if (load64(af + 72) == 0) {
                    if (best < 0 || a < best) { best = a; }
                } else { vec_push(next, a); }
            }
        }
        if (best >= 0) { return best; }
        front = next;
    }
    return 0 - 1;
}

# A unit record (see the layout above) for entry `epath` (`erel` from root `root`) on target `c`.
fn _cu_unit(root, mode, epath, erel, c, deps): i64 {
    var u = alloc(64);
    memset(u, 0, 64);
    store64(u, mode);
    store64(u + 8, epath);
    store64(u + 16, erel);
    store64(u + 24, c);
    store64(u + 32, deps);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, epath);
    str_builder_add_cstr(sb, "|");
    str_builder_add_int(sb, c);
    str_builder_add_cstr(sb, "|");
    str_builder_add_int(sb, deps);
    store64(u + 40, str_data(str_builder_build(sb)));
    store64(u + 56, root);
    return u;
}

# The unit of mode `mode` whose entry is file `e` of graph `g`.
fn _cu_unit_f(g, mode, e, c, deps): i64 {
    var ef = _cu_f(g, e);
    return _cu_unit(load64(g), mode, load64(ef), load64(ef + 8), c, deps);
}

# A NOTE for file `i`: reached only on the targets `reach` (bits), through `via`.
fn _cu_note_unit(g, i, via, reach): i64 {
    var u = _cu_unit_f(g, _CU_NOTE, via, _cu_host_cfg(), 0);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "not compiled here: ");
    str_builder_add_cstr(sb, load64(_cu_f(g, i) + 8));
    str_builder_add_cstr(sb, " is compiled only for ");
    var c = 0;
    var nn = 0;
    while (c < _CU_NCFG) {
        if ((reach & (1 << c)) != 0) {
            if (nn > 0) { str_builder_add_cstr(sb, ", "); }
            str_builder_add_cstr(sb, _cu_cfg_name(c));
            nn = nn + 1;
        }
        c = c + 1;
    }
    str_builder_add_cstr(sb, " (through ");
    str_builder_add_cstr(sb, load64(_cu_f(g, via) + 8));
    str_builder_add_cstr(sb, "), which this server does not compile for");
    store64(u + 48, str_data(str_builder_build(sb)));
    return u;
}

# The unit of lib/ file `i`: a public module is its own, standalone; a peer is checked through its
# nearest public includer on the first target that reaches one (a FRAGMENT on the host, a PEER on a
# selected target), else it is a NOTE.
fn _cu_lib_unit(g, i): i64 {
    if (load64(_cu_f(g, i) + 72) == 0) { return _cu_unit_f(g, _CU_SELF, i, _cu_host_cfg(), 0); }
    var k = 0;
    var c = _cu_try_cfg(0);
    while (c >= 0) {
        var a = _cu_lib_ancestor(g, i, c);
        if (a >= 0) {
            var md = _CU_PEER;
            if (k == 0) { md = _CU_FRAGMENT; }
            return _cu_unit_f(g, md, a, c, 0);
        }
        k = k + 1;
        c = _cu_try_cfg(k);
    }
    var reach = 0;
    var via = 0 - 1;
    c = 0;
    while (c < _CU_NCFG) {
        if (_cu_can_select(c) == 0) {
            var a2 = _cu_lib_ancestor(g, i, c);
            if (a2 >= 0) {
                reach = reach | (1 << c);
                if (via < 0) { via = a2; }
            }
        }
        c = c + 1;
    }
    if (reach != 0) { return _cu_note_unit(g, i, via, reach); }
    return _cu_unit_f(g, _CU_SELF, i, _cu_host_cfg(), 0);
}

# The unit of project (non-lib/) file `i`: an entry is its own (the manifest's always); a fragment's
# is the entry that reaches it on the first target one does — the manifest entry first, then the
# fewest hops, then path order; reached only on a target this server cannot compile for, a NOTE;
# reached by no entry at all, its own.
fn _cu_proj_unit(g, i): i64 {
    var mi = load64(g + 48);
    if (i == mi || _cu_flag(_cu_f(g, i), _CU_INCLUDED) == 0) { return _cu_unit_f(g, _CU_SELF, i, _cu_host_cfg(), 1); }
    var ents = load64(g + 96);
    var k = 0;
    var c = _cu_try_cfg(0);
    while (c >= 0) {
        var best = 0 - 1;
        var bh = 0;
        var j = 0;
        while (j < vec_len(ents)) {
            var e = vec_get(ents, j);
            j = j + 1;
            var h = _cu_hops(g, e, i, c);
            if (h < 0) { continue; }
            if (e == mi) {
                best = e;
                break;
            }
            if (best < 0 || h < bh) {
                best = e;
                bh = h;
            }
        }
        if (best >= 0) {
            var md = _CU_PEER;
            if (k == 0) { md = _CU_FRAGMENT; }
            return _cu_unit_f(g, md, best, c, 1);
        }
        k = k + 1;
        c = _cu_try_cfg(k);
    }
    var reach = 0;
    var via = 0 - 1;
    c = 0;
    while (c < _CU_NCFG) {
        if (_cu_can_select(c) == 0) {
            var j2 = 0;
            while (j2 < vec_len(ents)) {
                var e2 = vec_get(ents, j2);
                j2 = j2 + 1;
                if (_cu_hops(g, e2, i, c) >= 0) {
                    reach = reach | (1 << c);
                    if (via < 0) { via = e2; }
                    break;
                }
            }
        }
        c = c + 1;
    }
    if (reach != 0) { return _cu_note_unit(g, i, via, reach); }
    return _cu_unit_f(g, _CU_SELF, i, _cu_host_cfg(), 1);
}

# File `i`'s unit, chosen once per graph generation.
fn _cu_unit_of(g, i): i64 {
    var f = _cu_f(g, i);
    if (load64(f + 56) != 0 && load64(f + 64) == load64(g + 40)) { return load64(f + 56); }
    var u = 0;
    if (_cu_flag(f, _CU_LIB) == 1) { u = _cu_lib_unit(g, i); }
    else { u = _cu_proj_unit(g, i); }
    store64(f + 56, u);
    store64(f + 64, load64(g + 40));
    return u;
}

# The offset just past `key` where it begins a line of `s`, or -1.
fn _cu_cfg_value(s, key): i64 {
    var kl = strlen(key);
    var n = strlen(s);
    var p = 0;
    while (p + kl <= n) {
        if ((p == 0 || load8(s + p - 1) == 10) && memeq(s + p, key, kl) == 1) { return p + kl; }
        p = p + 1;
    }
    return 0 - 1;
}

# s[p, the next '"' or the line's end) as a fresh cstr.
fn _cu_quoted(s, p): i64 {
    var e = p;
    while (load8(s + e) != 0 && load8(s + e) != 34 && load8(s + e) != 10) { e = e + 1; }
    var r = alloc(e - p + 1);
    memcpy(r, s + p, e - p);
    store8(r + e - p, 0);
    return r;
}

# Read graph `g`'s manifest entry and `[lsp] skip` through `cyrius build --print-config` from its root
# — the CLI's own resolution (`entry` or its synonym `src`, the pin's toolchain) — again whenever
# cyrius.cyml, cyrius.lock or the CLI changed. 1 when they were read again. A CLI older than 6.7.16
# prints no lsp.skip row (no skip), and a check that fails (an uninstalled pin) leaves no entry.
fn _cu_config(g): i64 {
    var root = load64(g);
    var sig = _cu_mix_stat(_CU_FNV, _lsp_join(root, "cyrius.cyml", 0, 11));
    sig = _cu_mix_stat(sig, _lsp_join(root, "cyrius.lock", 0, 11));
    sig = _cu_mix_stat(sig, _cyrius_path);
    if (load64(g + 112) == 1 && load64(g + 64) == sig) { return 0; }
    store64(g + 112, 1);
    store64(g + 64, sig);
    store64(g + 120, 0);
    var skip = vec_new();
    store64(g + 56, skip);
    var argv = alloc(32);
    store64(argv, _cyrius_path);
    store64(argv + 8, "build");
    store64(argv + 16, "--print-config");
    store64(argv + 24, 0);
    var out = _lsp_run_capture(_cyrius_path, argv, _lsp_envp_target(_lsp_envp(), 0), root, 1);
    if (out == 0) { return 1; }
    var ep = _cu_cfg_value(out, "  build.entry = \"");
    if (ep >= 0) { store64(g + 120, _cu_quoted(out, ep)); }
    var p = _cu_cfg_value(out, "  lsp.skip = [");
    if (p >= 0) {
        while (load8(out + p) != 0 && load8(out + p) != 93 && load8(out + p) != 10) {
            if (load8(out + p) == 34) {
                var v = _cu_quoted(out, p + 1);
                vec_push(skip, _cu_resolve_name(root, v));
                p = p + strlen(v) + 2;
            } else { p = p + 1; }
        }
    }
    return 1;
}

# The graph of project root `root` (an empty one the first time).
fn _cu_graph(root): i64 {
    if (_cu_graphs == 0) { _cu_graphs = vec_new(); }
    var i = 0;
    while (i < vec_len(_cu_graphs)) {
        var g = vec_get(_cu_graphs, i);
        if (streq(load64(g), root) == 1) { return g; }
        i = i + 1;
    }
    var ng = alloc(136);
    memset(ng, 0, 136);
    store64(ng, root);
    store64(ng + 8, strlen(root));
    store64(ng + 16, vec_new());
    store64(ng + 48, 0 - 1);
    store64(ng + 56, vec_new());
    store64(ng + 72, vec_new());
    store64(ng + 80, vec_new());
    store64(ng + 96, vec_new());
    vec_push(_cu_graphs, ng);
    return ng;
}

# Bring graph `g` up to date for opening `path`: its configuration; every file's mtime and size (a
# changed one is scanned again; a vanished one, or a .cyr `path` it does not hold and was not already
# found missing by a walk, walks the tree again); then, after any change, the derived state.
fn _cu_refresh(g, path): i64 {
    var ch = _cu_config(g);
    var walk = 0;
    if (load64(g + 88) == 0) { walk = 1; }
    else {
        var files = load64(g + 16);
        var i = 0;
        while (i < vec_len(files)) {
            var f = vec_get(files, i);
            i = i + 1;
            if (_cu_stat(load64(f)) < 0) {
                walk = 1;
                break;
            }
            var mt = _cu_st_mt();
            var mn = _cu_st_mn();
            var sz = _cu_st_sz();
            if (mt != load64(f + 16) || mn != load64(f + 24) || sz != load64(f + 32)) {
                store64(f + 16, mt);
                store64(f + 24, mn);
                store64(f + 32, sz);
                _cu_scan(f);
                ch = 1;
            }
        }
        if (walk == 0 && _lsp_ends(path, ".cyr") == 1 && _cu_find(g, path) < 0) {
            if (_lsp_vec_has(load64(g + 80), path) == 0) { walk = 1; }
        }
    }
    if (walk == 1) {
        _cu_walk(g);
        store64(g + 80, vec_new());
        ch = 1;
    }
    if (ch == 1) { _cu_derive(g); }
    if (_lsp_ends(path, ".cyr") == 1 && _cu_find(g, path) < 0) { vec_push(load64(g + 80), path); }
    return 0;
}

# The unit the document at `path`, under project root `root`, is checked through (never 0). A test
# file, or a file the walk does not reach, is its own unit, as before 6.7.16.
fn _cu_unit_for(root, path): i64 {
    var g = _cu_graph(root);
    _cu_cur_g = g;
    _cu_refresh(g, path);
    var rel = _lsp_rel_to(root, path);
    if (_lsp_vec_has(load64(g + 56), path) == 1) { return _cu_unit(root, _CU_SKIP, path, rel, _cu_host_cfg(), 1); }
    var i = _cu_find(g, path);
    if (i < 0) { return _cu_unit(root, _CU_SELF, path, rel, _cu_host_cfg(), 1); }
    return _cu_unit_of(g, i);
}

# 1 when the file at `path`'s own unit is the one keyed `key`.
fn _cu_file_in_unit(path, key): i64 {
    var g = _cu_cur_g;
    if (g == 0) { return 0; }
    var i = _cu_find(g, path);
    if (i < 0) { return 0; }
    return streq(load64(_cu_unit_of(g, i) + 40), key);
}

# A private file holding `include "<rel>"\n` — how a lib/ module is checked alone, the way the
# stdlib's contract states it (stdlib_modules_self_sufficient.sh): INCLUDED, not fed as the entry. Fed
# as the entry its include-once guard does not know its name, so a module its own includes reach
# again was compiled twice (lib/alloc.cyr for agnos: 42 duplicate-fn warnings), and cycc refuses
# lib/fnptr.cyr's fncall0..8 in the main source (by design, 6.6.20). The file lives in a directory
# this server makes mode 0700 under $TMPDIR (absolute) or /tmp for the one compile (_cu_wrapper_done
# removes both after it); mkdir fails on a name that exists, so nothing planted there is used. Its
# path, or 0 when it cannot be written.
fn _cu_wrapper(rel): i64 {
    if (_cu_tmpdir == 0) {
        var base = getenv("TMPDIR");
        if (base == 0 || load8(base) != 47) { base = "/tmp"; }
        var k = 0;
        while (k < 16 && _cu_tmpdir == 0) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, base);
            str_builder_add_cstr(sb, "/cyrius-lsp-");
            str_builder_add_int(sb, sys_getpid());
            str_builder_add_cstr(sb, "-");
            str_builder_add_int(sb, k);
            var d = str_data(str_builder_build(sb));
            if (sys_mkdir(d, 448) == 0) { _cu_tmpdir = d; }
            k = k + 1;
        }
        if (_cu_tmpdir == 0) { return 0; }
        _cu_wrapfile = _lsp_join(_cu_tmpdir, "unit.cyr", 0, 8);
    }
    var fd = sys_open(_cu_wrapfile, O_WRONLY | O_CREAT | O_EXCL, 384);   # a fresh directory: never there before
    if (fd < 0) { return 0; }
    var sb2 = str_builder_new();
    str_builder_add_cstr(sb2, "include \"");
    str_builder_add_cstr(sb2, rel);
    str_builder_add_cstr(sb2, "\"\n");
    var txt = str_data(str_builder_build(sb2));
    var wr = _lsp_write_all(fd, txt, strlen(txt));
    sys_close(fd);
    if (wr != 0) {
        _cu_cleanup();
        return 0;
    }
    return _cu_wrapfile;
}

# Remove the lib/ include file and its directory: after each compile through it, and at exit.
fn _cu_cleanup(): i64 {
    if (_cu_tmpdir == 0) { return 0; }
    sys_unlink(_cu_wrapfile);
    sys_rmdir(_cu_tmpdir);
    _cu_tmpdir = 0;
    return 0;
}

# What unit `u` (entry: file `ei` of graph `g`) depends on: its key, its closure (a project unit; the
# entry alone for a lib/ one, whose includes are all lib/), every lib/ file, cyrius.cyml, cyrius.lock
# and the CLI and cycc binaries — paths, mtimes and sizes, as this request's refresh read them.
fn _cu_sig(g, u, ei): i64 {
    var h = _cu_hash_str(_CU_FNV, load64(u + 40));
    if (load64(u + 32) == 1) {
        var cl = _cu_closure(g, ei, load64(u + 24));
        var k = 0;
        while (k < vec_len(cl)) {
            h = _cu_mix_rec(h, _cu_f(g, vec_get(cl, k)));
            k = k + 2;
        }
    } else { h = _cu_mix_rec(h, _cu_f(g, ei)); }
    var n = _cu_nf(g);
    var i = 0;
    while (i < n) {
        var f = _cu_f(g, i);
        if (_cu_flag(f, _CU_LIB) == 1) { h = _cu_mix_rec(h, f); }
        i = i + 1;
    }
    var root = load64(g);
    h = _cu_mix_stat(h, _lsp_join(root, "cyrius.cyml", 0, 11));
    h = _cu_mix_stat(h, _lsp_join(root, "cyrius.lock", 0, 11));
    h = _cu_mix_stat(h, _cyrius_path);
    return _cu_mix_stat(h, _cycc_path);
}

# Log what is done with unit `u`: `what` + its entry (mode, target).
fn _cu_log_unit(what, u): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, load64(u + 16));
    str_builder_add_cstr(sb, " (");
    str_builder_add_cstr(sb, _cu_mode_name(load64(u)));
    str_builder_add_cstr(sb, ", ");
    str_builder_add_cstr(sb, _cu_cfg_name(load64(u + 24)));
    if (load64(u + 32) == 0) { str_builder_add_cstr(sb, ", standalone"); }
    str_builder_add_cstr(sb, ")");
    log_msg(str_data(str_builder_build(sb)));
    return 0;
}

# The compile output of unit `u`: the one kept for it when nothing it depends on (_cu_sig) has changed
# on disk since, else a fresh `cyrius check` (_compile_via_wrapper) from the root — the entry with
# --with-deps --no-redirect for a project unit, `include "<module>"` alone for a lib/ one — under the
# unit's target selector. A unit whose entry the graph does not hold (a test, a stray) is not kept.
fn _cu_compile(u): i64 {
    var g = _cu_cur_g;
    var ei = 0 - 1;
    if (g != 0) { ei = _cu_find(g, load64(u + 8)); }
    var sig = 0;
    var c = 0;
    if (ei >= 0) {
        sig = _cu_sig(g, u, ei);
        var cv = load64(g + 72);
        var k = 0;
        while (k < vec_len(cv)) {
            if (streq(load64(vec_get(cv, k)), load64(u + 40)) == 1) { c = vec_get(cv, k); }
            k = k + 1;
        }
        if (c != 0 && load64(c + 8) == sig) {
            _cu_log_unit("unit unchanged on disk, its last compile reused: ", u);
            _lsp_last_unit = load64(c + 24);   # the name its check was given (its verdict line)
            return load64(c + 16);
        }
    }
    var name = load64(u + 16);
    var wrapped = 0;
    if (load64(u + 32) == 0) {
        var w = _cu_wrapper(name);
        if (w != 0) {
            name = w;
            wrapped = 1;
        } else { log_msg("no private include file for a lib/ module could be written: checked as the entry"); }
    }
    _lsp_last_unit = name;
    _cu_log_unit("compiling unit ", u);
    var out = _compile_via_wrapper(name, load64(u + 56), load64(u + 32), _cu_cfg_env(load64(u + 24)));
    if (wrapped == 1) { _cu_cleanup(); }
    if (ei >= 0 && out != 0) {
        if (c == 0) {
            c = alloc(32);
            store64(c, load64(u + 40));
            vec_push(load64(g + 72), c);
        }
        store64(c + 8, sig);
        store64(c + 16, out);
        store64(c + 24, name);
    }
    return out;
}

# v5.11.56: fork cyrius wrapper with cwd=project_root, exec
# `cyrius check --with-deps --no-redirect <filepath>`. Wrapper handles [deps.*]
# resolution that raw cycc (read source from stdin, no project
# context) can't see. Closes the undefined-stdlib-fn false-positive
# class. Returns stderr buffer (never NULL except on pipe failure
# upstream of fork).
# 6.7.12 — `--no-redirect`: the open file is the unit. `--with-deps` alone keeps the CLI's legacy
# module redirect, which compiled `src/main.cyr` instead of any file with no `include`, so such a
# file showed the entry's diagnostics and never its own. A toolchain older than 6.7.12 (a project
# can pin one) refuses the flag by name; then the check runs again without it, as before.
# CHANGELOG [6.7.12]
# 6.7.16 — (unit, root, deps, selector): `unit` is what the check is given (a unit's entry relative
# to `root`, a lib/ unit's private include file, a loose file), `root` the directory it runs from
# (0: a loose file, this server's working directory), `deps` 1 for `--with-deps --no-redirect` (a
# project unit) and 0 for a standalone check, `selector` the unit's target environment entry (0: the
# host). See COMPILE UNITS. CHANGELOG [6.7.16]
fn _compile_via_wrapper(unit, root, deps, selector): i64 {
    var out = _compile_via_wrapper_run(unit, root, deps, selector, 1);
    if (deps == 1 && out != 0 && _lsp_has(out, "unknown option '--no-redirect'") == 1) {
        log_msg("this project's cyrius predates --no-redirect (6.7.12): checking with the module redirect");
        out = _compile_via_wrapper_run(unit, root, deps, selector, 0);
    }
    return out;
}

# `envp` (a NULL-terminated array, or 0 for none) for a check that reads no pin of its working
# directory: `CYRIUS_RESOLVED=1` — the CLI's own loop guard, which skips its version redirect
# (cbt/cyrius.cyr `_try_redirect_to_pinned`) — and `CYRIUS_NO_WARN_PIN_DRIFT=1` (cycc's drift
# warning, src/frontend/lex.cyr `_check_cyml_pin_drift`), any inherited entry of either name dropped
# (each reader takes the first). A fresh array. CHANGELOG [6.7.14]
fn _lsp_envp_unpinned(envp): i64 {
    var n = 0;
    if (envp != 0) { while (load64(envp + n * 8) != 0) { n = n + 1; } }
    var out = alloc((n + 3) * 8);
    var k = 0;
    var i = 0;
    while (i < n) {
        var e = load64(envp + i * 8);
        if (_lsp_env_named(e, "CYRIUS_RESOLVED=") == 0 && _lsp_env_named(e, "CYRIUS_NO_WARN_PIN_DRIFT=") == 0) {
            store64(out + k * 8, e);
            k = k + 1;
        }
        i = i + 1;
    }
    store64(out + k * 8, "CYRIUS_RESOLVED=1");
    store64(out + k * 8 + 8, "CYRIUS_NO_WARN_PIN_DRIFT=1");
    store64(out + k * 8 + 16, 0);
    return out;
}

# 1 when environment entry `e` begins with `key` (a `NAME=` cstr).
fn _lsp_env_named(e, key): i64 {
    var kl = strlen(key);
    if (strlen(e) < kl) { return 0; }
    return memeq(e, key, kl);
}

# 1 when the cstr `hay` contains the cstr `needle`.
fn _lsp_has(hay, needle): i64 {
    var hl = strlen(hay);
    var nl = strlen(needle);
    var i = 0;
    while (i + nl <= hl) {
        if (memeq(hay + i, needle, nl) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# One `cyrius check [--with-deps [--no-redirect]] <unit>` run from `root`; its stderr, read whole
# (_lsp_drain). (6.7.16: the arguments as for _compile_via_wrapper; the run is _lsp_run_capture.)
# 6.7.13: `root` 0 = a file outside any project — `cyrius check <unit>` (standalone, as `cyrius
# check` runs in a loose directory) from THIS server's working directory, no chdir.
# 6.7.14 (D47 / D54, the user 2026-10-16): that run reads no pin (`_lsp_envp_unpinned`): the
# server's working directory may be a project pinning a cyrius that is not installed, and its pin
# error is not the loose file's — the pin belongs to the project that pins it. So the CLI's version
# redirect is off, and so is cycc's drift warning about that same pin (`cyrius.cyml pins X but cycc
# is Y`), which the redirect being off would otherwise surface on the loose file instead. The
# project route keeps both. CHANGELOG [6.7.14]
# 6.7.16: a project run's environment carries the unit's target selector and no inherited one
# (_lsp_envp_target). CHANGELOG [6.7.16]
fn _compile_via_wrapper_run(unit, root, deps, selector, no_redirect): i64 {
    var argv = alloc(48);   # cyrius, check, --with-deps, --no-redirect, the unit, NULL
    store64(argv, _cyrius_path);
    store64(argv + 8, "check");
    var ai = 16;
    if (deps == 1) {
        store64(argv + ai, "--with-deps");
        ai = ai + 8;
        if (no_redirect == 1) {
            store64(argv + ai, "--no-redirect");
            ai = ai + 8;
        }
    }
    store64(argv + ai, unit);
    store64(argv + ai + 8, 0);
    var envp = _lsp_envp();
    if (root == 0) { envp = _lsp_envp_unpinned(envp); }
    else { envp = _lsp_envp_target(envp, selector); }
    if (envp == 0) {
        envp = alloc(8);
        store64(envp, 0);
    }
    return _lsp_run_capture(_cyrius_path, argv, envp, root, 2);
}

# 6.7.13 — this server's working directory (a fresh string), or 0 when it cannot be read: the
# CLI's `_cwd_read` (cbt/deps.cyr) — Darwin has no getcwd syscall, so fcntl(F_GETPATH) on ".".
fn _lsp_cwd(): i64 {
    var buf = alloc(4096);
    #ifdef CYRIUS_TARGET_MACOS
    var fd = sys_open(".", 0, 0);
    if (fd < 0) { return 0; }
    var fr = sys_fcntl(fd, 50, buf);
    sys_close(fd);
    if (fr != 0) { return 0; }
    return buf;
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    var n = syscall(79, buf, 4096);   # getcwd (aarch64: ESYSXLAT 79 -> 17)
    if (n <= 0) { return 0; }
    return buf;
    #endif
}

# 6.7.13 — `path` relative to `cwd` when it lies under it (`cwd` + "/" + rest: the rest), else
# `path` itself (also when `cwd` is 0).
fn _lsp_rel_to(cwd, path): i64 {
    if (cwd == 0) { return path; }
    var cl = strlen(cwd);
    if (cl == 1 && load8(cwd) == 47) {
        if (load8(path) == 47 && load8(path + 1) != 0) { return path + 1; }
        return path;
    }
    if (strlen(path) <= cl + 1) { return path; }
    if (memeq(path, cwd, cl) == 0) { return path; }
    if (load8(path + cl) != 47) { return path; }
    return path + cl + 1;
}

# 6.7.13 — the `#@incdir` the CLI writes for entry `unit` (cbt/build.cyr `_source_incdir`): its
# directory component when `unit` is relative, has one, and holds no `..` component; else 0 (no
# marker — cycc refuses an absolute or `..` directory).
fn _lsp_incdir(unit): i64 {
    var n = strlen(unit);
    if (n == 0 || load8(unit) == 47) { return 0; }
    var cut = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(unit + i) == 47) { cut = i; }
        i = i + 1;
    }
    if (cut <= 0) { return 0; }
    var j = 0;
    while (j < cut) {
        if (load8(unit + j) == 46 && load8(unit + j + 1) == 46) {
            if (j == 0 || load8(unit + j - 1) == 47) { return 0; }
        }
        j = j + 1;
    }
    var d = alloc(cut + 1);
    memcpy(d, unit, cut);
    store8(d + cut, 0);
    return d;
}

# 6.7.13 — in the cycc child: a pipe whose read end is cycc's stdin, fed by a forked writer with
# `#@incdir <incdir>\n#@srcline\n` (the incdir at byte 0, the only place cycc honours it; the
# srcline keeps `<source>` lines the file's own) and then the file open on `sfd`. The writer, not
# the server, writes the pipe, so the server only drains stderr and a cycc that stops reading
# kills nothing but the writer. Returns the read end, or `sfd` unchanged when the pipe or the
# fork fails (the file alone, as before). `errw` is the stderr pipe the writer must not hold.
fn _lsp_feed_incdir(sfd, incdir, errw): i64 {
    var fds[16];
    if (sys_pipe(&fds) < 0) { return sfd; }
    var rd = load32(&fds);
    var wr = load32(&fds + 4);
    var w = sys_fork();
    if (w < 0) {
        sys_close(rd);
        sys_close(wr);
        return sfd;
    }
    if (w == 0) {
        sys_close(rd);
        sys_close(errw);
        _lsp_write_all(wr, "#@incdir ", 9);
        _lsp_write_all(wr, incdir, strlen(incdir));
        _lsp_write_all(wr, "\n#@srcline\n", 11);
        var buf = alloc(32768);
        var k = sys_read(sfd, buf, 32768);
        while (k > 0) {
            if (_lsp_write_all(wr, buf, k) != 0) { k = 0; }
            else { k = sys_read(sfd, buf, 32768); }
        }
        sys_exit(0);
    }
    sys_close(wr);
    sys_close(sfd);
    return rd;
}

# Write all `n` bytes of `buf` to `fd`; 0, or -1 when a write fails.
fn _lsp_write_all(fd, buf, n): i64 {
    var off = 0;
    while (off < n) {
        var r = sys_write(fd, buf + off, n - off);
        if (r <= 0) { return 0 - 1; }
        off = off + r;
    }
    return 0;
}

# Run cycc on a file path, capture stderr for errors.
# Returns a pointer to the stderr output (null-terminated), or 0 on failure.
# v5.11.56: when both the cyrius wrapper and a project root are
# available, prefer wrapper-mode. Wrapper resolves [deps.*] before
# invoking cycc, which eliminates the false-positive
# `undefined function 'X' (will crash at runtime)` warnings for
# stdlib fns the consumer pulls via cyrius.cyml. Fall back to raw
# cycc (pre-.56 behavior) for files outside any project tree or
# when the wrapper isn't installed.
# ⛔ 6.7.13 — OUTSIDE A PROJECT, THE UNIT `cyrius check` COMPILES. cycc resolves an `include`
# against its working directory and then against the entry's directory — the latter only through
# the `#@incdir <dir>` line the CLI writes for an entry in a subdirectory. This forked cycc with
# the file itself on stdin, so a loose file's sibling include was `cannot open include file` unless
# the editor had started the server in that file's directory, while `cyrius check` from the same
# working directory said ok. Now, from this server's working directory and with the file named
# relative to it when it lies inside (`_lsp_rel_to`): the CLI when found runs `cyrius check <file>`
# (standalone), else cycc gets `#@incdir <dir>` + `#@srcline` ahead of the file through a pipe,
# by the CLI's own rule (`_lsp_incdir`: a relative, `..`-free directory). A file outside the
# working directory's subtree gets no marker, as `cyrius check` writes none there. Relative names
# in the diagnostics resolve against that directory first (`_lsp_last_root`). CHANGELOG [6.7.13]
# 6.7.16 — in a project (`u` non-zero), the unit's compile: see COMPILE UNITS. CHANGELOG [6.7.16]
fn compile_and_capture(filepath, u): i64 {
    _lsp_last_root = 0;
    _lsp_last_unit = 0;
    if (u != 0) {
        _lsp_last_root = load64(u + 56);
        return _cu_compile(u);
    }
    var cwd = _lsp_cwd();
    var unit = _lsp_rel_to(cwd, filepath);
    _lsp_last_root = cwd;
    if (_cyrius_path != 0) {
        _lsp_last_unit = unit;
        return _compile_via_wrapper_run(unit, 0, 0, 0, 0);
    }
    if (_cycc_path == 0) { return 0; }
    var incdir = _lsp_incdir(unit);

    # Create pipe for stderr capture
    var pipe_fds[16];
    var pr = sys_pipe(&pipe_fds);
    if (pr < 0) { return 0; }
    var pipe_read = load32(&pipe_fds);
    var pipe_write = load32(&pipe_fds + 4);

    var pid = sys_fork();
    if (pid < 0) { return _lsp_fork_failed(_cycc_path, pid, pipe_read, pipe_write); }   # 6.6.20
    if (pid == 0) {
        # Child: run cycc with source on stdin, /dev/null on stdout, pipe on stderr
        sys_close(pipe_read);
        pipe_write = _lsp_lift_fd(pipe_write);   # 6.7.16

        var sfd = sys_open(filepath, 0, 0);
        if (sfd < 0) { syscall(60, 1); }
        if (incdir != 0) { sfd = _lsp_feed_incdir(sfd, incdir, pipe_write); }   # 6.7.13
        _lsp_redirect(sfd, 0);   # 6.7.16: each redirect keeps a fd that is already its target

        # stdout → /dev/null
        var nfd = sys_open("/dev/null", 1, 0);
        if (nfd >= 0) { _lsp_redirect(nfd, 1); }

        # stderr → pipe
        _lsp_redirect(pipe_write, 2);

        var argv[24];   # N BYTES per CLAUDE.md buffer contract: cmd + NUL = 16 B
        store64(&argv, _cycc_path);
        store64(&argv + 8, 0);
        # envp = NULL (minimal env)
        var envp[16];
        store64(&envp, 0);
        sys_execve(_cycc_path, &argv, &envp);
        syscall(60, 127);
    }

    # Parent: read stderr from pipe, whole (6.7.16: it kept the first 8,191 bytes; see _lsp_drain)
    sys_close(pipe_write);
    var errbuf = _lsp_drain(pipe_read);
    sys_close(pipe_read);

    # Wait for child
    _lsp_reap(pid);

    return errbuf;
}

# ================================================================
# DIAGNOSTIC PARSING
# ================================================================

# Parse the compiler's stderr into LSP diagnostics and publish them.
# A diagnostic line is `error:<file>:<line>:<col>: <message>` (cycc; `<source>` for the unit it
# read), `error:<file>:<line>: <message>` or `error:<line>: <message>` (older forms), or a bare
# `error: <message>` (no location: published on the open file's line 0); `warning:` likewise.
# ⛔ 6.7.12 — this read only `error:<file>:<line>:`, skipping the file name unread: the column
# stayed in the message (`14: undefined variable …`), the range was always characters 0-100,
# and an error in an INCLUDED file was published on the open document at that line number.
# Now the column gives the range's start (col - 1, to the end of that source line) and leaves the
# message, and each diagnostic is published on the URI of the file it names. A relative name
# resolves as cycc resolved it: against the project root (the checker's working directory) when
# `cyrius check` ran there, then against the open file's directory (the entry's, `#@incdir`); a
# name that resolves to no file stays on the open file's line 0 with its location in the text.
# The files a unit published on are remembered, and a recompile that no longer names one
# publishes an empty list there, so a fixed include's error does not stick. CHANGELOG [6.7.12]
var _ld_file = 0;   # vec of cstr: the file each diagnostic is published on (resolved)
var _ld_line = 0;   # vec: 0-based line
var _ld_col = 0;    # vec: 0-based start character
var _ld_sev = 0;    # vec: 1 error, 2 warning
var _ld_ms = 0;     # vec: the message's start offset in the compiler's text
var _ld_me = 0;     # vec: its end offset
var _ld_txt = 0;    # vec: 0, or a message of its own (a cstr) in place of the text at [ms, me) (6.7.16)
# 6.7.16 — the file `<source>`, a line-only location and a location-less WARNING land on, and the
# directory a relative name falls back to: the unit's entry (the open file when it is its own unit).
# A location-less ERROR stays on the open file. CHANGELOG [6.7.16]
var _lsp_unit_path = 0;
var _lsp_pub_units = 0;   # vec of cstr: per (unit, file) pair, the unit's key
var _lsp_pub_files = 0;   # vec of cstr: the file that unit last published diagnostics on
# vec: what the pair is — 0 a file the unit published on; an open FRAGMENT / PEER document of the
# unit, whose list follows the unit (its unit note included): 1 its last list was empty, 2 it was not.
# A unit note is made for a document and named by no compile, so it was cleared as a list the unit
# no longer named; a PEER publishes no other file, so it cleared its peers' own errors. CHANGELOG [6.7.16]
var _lsp_pub_note = 0;

# The digits at s[p, eol) as a number; *endp = the first non-digit (p when there is none).
fn _lsp_num(s, p, eol, endp): i64 {
    var v = 0;
    var q = p;
    while (q < eol && load8(s + q) >= 48 && load8(s + q) <= 57) {
        v = v * 10 + load8(s + q) - 48;
        q = q + 1;
    }
    store64(endp, q);
    return v;
}

# The directory of `path`, without its trailing slash ("" for a bare name).
fn _lsp_dir_of(path): i64 {
    var n = strlen(path);
    var slash = 0 - 1;
    var i = 0;
    while (i < n) {
        if (load8(path + i) == 47) { slash = i; }
        i = i + 1;
    }
    if (slash < 0) { slash = 0; }
    var d = alloc(slash + 1);
    memcpy(d, path, slash);
    store8(d + slash, 0);
    return d;
}

# `dir` + "/" + s[p, p + n) as a fresh cstr.
fn _lsp_join(dir, s, p, n): i64 {
    var dl = strlen(dir);
    var r = alloc(dl + n + 2);
    memcpy(r, dir, dl);
    store8(r + dl, 47);
    memcpy(r + dl + 1, s + p, n);
    store8(r + dl + 1 + n, 0);
    return r;
}

# The file a diagnostic names (s[p, p + n)), resolved: `<source>` is the unit's entry
# (_lsp_unit_path; 6.7.16 — the open file when it is its own unit); an absolute name is itself; a
# relative one is tried against `root` (when there is one) and then the entry's directory. 0 when it
# names no file there.
fn _lsp_resolve_file(s, p, n, open_path, root): i64 {
    var unit = _lsp_unit_path;
    if (unit == 0) { unit = open_path; }
    if (n == 8 && memeq(s + p, "<source>", 8) == 1) { return unit; }
    if (n > 0 && load8(s + p) == 47) {
        var a = alloc(n + 1);
        memcpy(a, s + p, n);
        store8(a + n, 0);
        return a;
    }
    if (root != 0) {
        var c1 = _lsp_join(root, s, p, n);
        if (file_exists(c1) == 1) { return c1; }
    }
    var c2 = _lsp_join(_lsp_dir_of(unit), s, p, n);
    if (file_exists(c2) == 1) { return c2; }
    return 0;
}

var _lsp_ll_path = 0;   # the file _lsp_line_len last read, and its text
var _lsp_ll_buf = 0;
var _lsp_ll_len = 0;

# The length in bytes of 0-based line `line` of `path` (its `\r` excluded); -1 when the file or
# the line is not there.
fn _lsp_line_len(path, line): i64 {
    if (_lsp_ll_path == 0 || streq(_lsp_ll_path, path) == 0) {
        var tot = 0;
        _lsp_ll_buf = file_read_whole(path, &tot);
        _lsp_ll_len = tot;
        _lsp_ll_path = path;
    }
    if (_lsp_ll_buf == 0) { return 0 - 1; }
    var b = _lsp_ll_buf;
    var n = _lsp_ll_len;
    var i = 0;
    var l = 0;
    while (l < line && i < n) {
        if (load8(b + i) == 10) { l = l + 1; }
        i = i + 1;
    }
    if (l < line) { return 0 - 1; }
    var e = i;
    while (e < n && load8(b + e) != 10) { e = e + 1; }
    if (e > i && load8(b + e - 1) == 13) { e = e - 1; }
    return e - i;
}

# Append `s[a, b)` to `sb`, JSON-escaped (quote, backslash; a control byte becomes a space).
fn _lsp_json_esc(sb, s, a, b): i64 {
    var i = a;
    while (i < b) {
        var ch = load8(s + i);
        if (ch == 34) { str_builder_add_cstr(sb, "\\\""); }
        elif (ch == 92) { str_builder_add_cstr(sb, "\\\\"); }
        elif (ch < 32) { str_builder_add_cstr(sb, " "); }
        else {
            var cbuf[2];
            store8(&cbuf, ch);
            store8(&cbuf + 1, 0);
            str_builder_add_cstr(sb, &cbuf);
        }
        i = i + 1;
    }
    return 0;
}

# Record one parsed diagnostic.
fn _lsp_diag_add(file, line, col, sev, ms, me): i64 {
    vec_push(_ld_file, file);
    vec_push(_ld_line, line);
    vec_push(_ld_col, col);
    vec_push(_ld_sev, sev);
    vec_push(_ld_ms, ms);
    vec_push(_ld_me, me);
    vec_push(_ld_txt, 0);
    return 0;
}

# Record a diagnostic of this server's own (`txt`, a cstr) at line 0 of `file`, severity `sev`
# (3: Information). 6.7.16.
fn _lsp_diag_txt(file, sev, txt): i64 {
    _lsp_diag_add(file, 0, 0, sev, 0, 0);
    vec_set(_ld_txt, vec_len(_ld_txt) - 1, txt);
    return 0;
}

# Start an empty parsed set (the diagnostics of one publish).
fn _lsp_diag_reset(): i64 {
    _ld_file = vec_new();
    _ld_line = vec_new();
    _ld_col = vec_new();
    _ld_sev = vec_new();
    _ld_ms = vec_new();
    _ld_me = vec_new();
    _ld_txt = vec_new();
    _lsp_ll_path = 0;
    return 0;
}

# 1 when line s[pos, eol) is the CLI's compile verdict for `open_path` — `error: <path> (compiler
# exit N)` or `… (the compiler did not exit normally)`, printed after the compiler's own
# diagnostics: it repeats them and is not one. (6.7.13) Outside a project the CLI was given the
# file relative to this server's working directory (`_lsp_last_unit`), and names it so.
fn _lsp_is_verdict(s, pos, eol, open_path): i64 {
    if (_lsp_verdict_for(s, pos, eol, open_path) == 1) { return 1; }
    if (_lsp_last_unit == 0) { return 0; }
    return _lsp_verdict_for(s, pos, eol, _lsp_last_unit);
}

# `_lsp_is_verdict` for the CLI's name of the unit, `path`.
fn _lsp_verdict_for(s, pos, eol, path): i64 {
    var ol = strlen(path);
    if (eol - pos < 7 + ol + 2) { return 0; }
    if (memeq(s + pos, "error: ", 7) != 1) { return 0; }
    if (memeq(s + pos + 7, path, ol) != 1) { return 0; }
    var t = pos + 7 + ol;
    if (eol - t >= 16 && memeq(s + t, " (compiler exit ", 16) == 1) { return 1; }
    if (eol - t >= 37 && memeq(s + t, " (the compiler did not exit normally)", 37) == 1) { return 1; }
    return 0;
}

# Parse one `error:` / `warning:` line, s[pos, eol), whose location starts at `p`.
fn _lsp_parse_diag(s, p, eol, sev, open_path, root): i64 {
    var endp[8];
    var unit = _lsp_unit_path;
    if (unit == 0) { unit = open_path; }
    if (p < eol && load8(s + p) == 32) {   # `error: message` — no location
        # 6.7.16: a warning with no location is the unit's (`large static data`); an error stays on
        # the open file, where it is seen
        if (sev == 2) { _lsp_diag_add(unit, 0, 0, sev, p + 1, eol); }
        else { _lsp_diag_add(open_path, 0, 0, sev, p + 1, eol); }
        return 0;
    }
    # `error:N: message` — a line, no file
    var ln0 = _lsp_num(s, p, eol, &endp);
    var q0 = load64(&endp);
    if (q0 > p && q0 < eol && load8(s + q0) == 58) {
        var m0 = q0 + 1;
        if (m0 < eol && load8(s + m0) == 32) { m0 = m0 + 1; }
        if (ln0 > 0) { ln0 = ln0 - 1; }
        _lsp_diag_add(unit, ln0, 0, sev, m0, eol);
        return 0;
    }
    # `error:<file>:<line>[:<col>]: message` — the file ends at the first `:<digits>:`
    var f = p;
    while (f < eol) {
        if (load8(s + f) == 58) {
            _lsp_num(s, f + 1, eol, &endp);
            var qd = load64(&endp);
            if (qd > f + 1 && qd < eol && load8(s + qd) == 58) { break; }
        }
        f = f + 1;
    }
    if (f >= eol) {   # no location found: the whole text on the open file
        _lsp_diag_add(open_path, 0, 0, sev, p, eol);
        return 0;
    }
    var line = _lsp_num(s, f + 1, eol, &endp);
    var q = load64(&endp) + 1;   # past the `:` after the line
    var col = 0 - 1;
    var cv = _lsp_num(s, q, eol, &endp);
    var qc = load64(&endp);
    if (qc > q && qc < eol && load8(s + qc) == 58) {
        col = cv;
        q = qc + 1;
    }
    var ms = q;
    if (ms < eol && load8(s + ms) == 32) { ms = ms + 1; }
    var file = _lsp_resolve_file(s, p, f - p, open_path, root);
    if (file == 0) {   # names no file the editor could open: keep the location in the text
        _lsp_diag_add(open_path, 0, 0, sev, p, eol);
        return 0;
    }
    if (line > 0) { line = line - 1; }
    var c0 = 0;
    if (col > 0) { c0 = col - 1; }
    _lsp_diag_add(file, line, c0, sev, ms, eol);
    return 0;
}

# Publish the diagnostics of the parsed set that sit on `file` as one notification on `uri`.
fn _lsp_publish_file(uri, file, s): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"");
    _lsp_json_esc(sb, uri, 0, strlen(uri));
    str_builder_add_cstr(sb, "\",\"diagnostics\":[");
    var n = 0;
    var i = 0;
    while (i < vec_len(_ld_file)) {
        if (file != 0 && streq(vec_get(_ld_file, i), file) == 1) {
            var line = vec_get(_ld_line, i);
            var c0 = vec_get(_ld_col, i);
            var ce = _lsp_line_len(file, line);
            if (ce < c0) { ce = c0; }
            if (n > 0) { str_builder_add_cstr(sb, ","); }
            str_builder_add_cstr(sb, "{\"range\":{\"start\":{\"line\":");
            str_builder_add_int(sb, line);
            str_builder_add_cstr(sb, ",\"character\":");
            str_builder_add_int(sb, c0);
            str_builder_add_cstr(sb, "},\"end\":{\"line\":");
            str_builder_add_int(sb, line);
            str_builder_add_cstr(sb, ",\"character\":");
            str_builder_add_int(sb, ce);
            str_builder_add_cstr(sb, "}},\"severity\":");
            str_builder_add_int(sb, vec_get(_ld_sev, i));
            str_builder_add_cstr(sb, ",\"source\":\"cyrius\",\"message\":\"");
            var tx = vec_get(_ld_txt, i);
            if (tx != 0) { _lsp_json_esc(sb, tx, 0, strlen(tx)); }
            else { _lsp_json_esc(sb, s, vec_get(_ld_ms, i), vec_get(_ld_me, i)); }
            str_builder_add_cstr(sb, "\"}");
            n = n + 1;
        }
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}}");
    send_response(str_data(str_builder_build(sb)));
    return n;
}

# "file://" + path.
fn _lsp_uri_of(path): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "file://");
    str_builder_add_cstr(sb, path);
    return str_data(str_builder_build(sb));
}

# 1 when the cstr vec `v` holds a string equal to `x`.
fn _lsp_vec_has(v, x): i64 {
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(vec_get(v, i), x) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Publish the compile of the open document (`uri`, at `open_path`) from its stderr text; `root`
# as for _lsp_resolve_file. Answers the number of diagnostics published.
# 6.7.16 — `u`, the document's unit (0: a loose file, its own). The open document always gets its
# list; then a SELF unit (or a loose file) publishes on each other file its compile names, as before;
# a FRAGMENT on each such file whose own unit is the same (_cu_file_in_unit); a PEER on none. A
# FRAGMENT or PEER whose own list has no error while the unit has errors elsewhere gets a one-line
# Information note at its line 0 naming the unit. What a unit published is remembered under the
# unit's key (_lsp_pub_record) — an open FRAGMENT / PEER document always, an open SELF one when its
# list was not empty — so a recompile of that unit from any of its files clears what it no longer
# names, and brings each open FRAGMENT / PEER document of the unit to the list its own publish would
# give it now: its diagnostics, and the note while the unit has errors elsewhere. CHANGELOG [6.7.16]
fn parse_and_send_diagnostics(uri, open_path, stderr_output, root, u): i64 {
    _lsp_diag_reset();
    _lsp_pub_init();
    var mode = _CU_SELF;
    var key = open_path;
    _lsp_unit_path = open_path;
    if (u != 0) {
        mode = load64(u);
        key = load64(u + 40);
        _lsp_unit_path = load64(u + 8);
    }
    var s = stderr_output;
    var slen = strlen(s);
    var errors = 0;
    var verdicts = vec_new();
    var pos = 0;
    while (pos < slen) {
        var eol = pos;
        while (eol < slen && load8(s + eol) != 10) { eol = eol + 1; }
        var sev = 0;
        var p = pos;
        if (eol - pos > 6 && memeq(s + pos, "error:", 6) == 1) { sev = 1; p = pos + 6; }
        elif (eol - pos > 8 && memeq(s + pos, "warning:", 8) == 1) { sev = 2; p = pos + 8; }
        if (sev > 0) {
            if (_lsp_is_verdict(s, pos, eol, open_path) == 1) {
                vec_push(verdicts, pos);
            } else {
                _lsp_parse_diag(s, p, eol, sev, open_path, root);
                if (sev == 1) { errors = errors + 1; }
            }
        }
        pos = eol + 1;
    }
    # The CLI's verdict repeats the compiler's errors; it is shown only when there are none.
    if (errors == 0) {
        var vi = 0;
        while (vi < vec_len(verdicts)) {
            var vp = vec_get(verdicts, vi);
            var ve = vp;
            while (ve < slen && load8(s + ve) != 10) { ve = ve + 1; }
            _lsp_diag_add(open_path, 0, 0, 1, vp + 7, ve);
            vi = vi + 1;
        }
    }
    if (mode == _CU_FRAGMENT || mode == _CU_PEER) { _lsp_unit_note(open_path, u); }
    # The unit's other open FRAGMENT / PEER documents get their notes too, so the files loop below
    # republishes one with its note, never without it.
    var docs = _lsp_unit_docs(key, open_path, u);
    # The open document always gets its list (an empty one clears it); then each other file named.
    var files = vec_new();
    var total = _lsp_publish_file(uri, open_path, s);
    var own = total;
    var i = 0;
    while (i < vec_len(_ld_file)) {
        var f = vec_get(_ld_file, i);
        if (streq(f, open_path) == 0 && _lsp_vec_has(files, f) == 0) {
            if (mode == _CU_SELF || (mode == _CU_FRAGMENT && _cu_file_in_unit(f, key) == 1)) {
                vec_push(files, f);
                total = total + _lsp_publish_file(_lsp_uri_of(f), f, s);
            }
        }
        i = i + 1;
    }
    _lsp_pub_record(key, open_path, mode, own, files, docs, s);
    log_msg("sent diagnostics");
    return total;
}

# The (unit, file) records, made on first use.
fn _lsp_pub_init(): i64 {
    if (_lsp_pub_units == 0) {
        _lsp_pub_units = vec_new();
        _lsp_pub_files = vec_new();
        _lsp_pub_note = vec_new();
    }
    return 0;
}

# The open FRAGMENT / PEER documents recorded under unit `key` but `open_path` that are still of the
# unit (a vec of paths); each gets its unit note in the parsed set when it is due.
fn _lsp_unit_docs(key, open_path, u): i64 {
    var docs = vec_new();
    if (u == 0) { return docs; }
    var j = 0;
    while (j < vec_len(_lsp_pub_units)) {
        var fj = vec_get(_lsp_pub_files, j);
        if (vec_get(_lsp_pub_note, j) > 0 && streq(vec_get(_lsp_pub_units, j), key) == 1 && streq(fj, open_path) == 0) {
            if (_cu_file_in_unit(fj, key) == 1) {
                _lsp_unit_note(fj, u);
                vec_push(docs, fj);
            }
        }
        j = j + 1;
    }
    return docs;
}

# The number of diagnostics of the parsed set on `file`.
fn _lsp_diags_on(file): i64 {
    var n = 0;
    var i = 0;
    while (i < vec_len(_ld_file)) {
        if (streq(vec_get(_ld_file, i), file) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# After unit `key`'s publish from `open_path` (`mode`, `own` diagnostics on it; `files` the other files
# it published on; `docs` its other open documents, _lsp_unit_docs): publish on each file the unit
# published on before and no longer names an empty list, and on each open document the files loop did
# not reach its list now (a PEER's compile still names its peers; an empty one only when it last
# showed something); then remember what the unit published. An open document's record under another
# unit is dropped (its list is this unit's now).
fn _lsp_pub_record(key, open_path, mode, own, files, docs, s): i64 {
    var ku = vec_new();
    var kf = vec_new();
    var kn = vec_new();
    var j = 0;
    while (j < vec_len(_lsp_pub_units)) {
        var uj = vec_get(_lsp_pub_units, j);
        var fj = vec_get(_lsp_pub_files, j);
        var nj = vec_get(_lsp_pub_note, j);
        if (streq(uj, key) == 1) {
            if (streq(fj, open_path) == 0 && _lsp_vec_has(files, fj) == 0) {
                if (_lsp_vec_has(docs, fj) == 1) {
                    var n = _lsp_diags_on(fj);
                    if (n > 0 || nj == 2) { _lsp_publish_file(_lsp_uri_of(fj), fj, s); }
                    var st = 1;
                    if (n > 0) { st = 2; }
                    _lsp_pub_push(ku, kf, kn, key, fj, st);
                } elif (nj != 1) {
                    _lsp_publish_file(_lsp_uri_of(fj), 0, s);
                }
            }
        } elif (nj == 0 || streq(fj, open_path) == 0) {
            _lsp_pub_push(ku, kf, kn, uj, fj, nj);
        }
        j = j + 1;
    }
    var k = 0;
    while (k < vec_len(files)) {
        var fk = vec_get(files, k);
        var sk = 0;
        if (_lsp_vec_has(docs, fk) == 1) { sk = 2; }
        _lsp_pub_push(ku, kf, kn, key, fk, sk);
        k = k + 1;
    }
    if (mode == _CU_FRAGMENT || mode == _CU_PEER) {
        var so = 1;
        if (own > 0) { so = 2; }
        _lsp_pub_push(ku, kf, kn, key, open_path, so);
    } elif (own > 0 && streq(key, open_path) == 0) {
        _lsp_pub_push(ku, kf, kn, key, open_path, 0);
    }
    _lsp_pub_units = ku;
    _lsp_pub_files = kf;
    _lsp_pub_note = kn;
    return 0;
}

# Append the record (key, file, st) to the record vecs being built.
fn _lsp_pub_push(ku, kf, kn, key, file, st): i64 {
    vec_push(ku, key);
    vec_push(kf, file);
    vec_push(kn, st);
    return 0;
}

# The one-line Information note a FRAGMENT / PEER document (`open_path`, unit `u`) gets when its own
# list holds no error while its unit's compile has errors in other files. 1 when it was added.
fn _lsp_unit_note(open_path, u): i64 {
    var mine = 0;
    var elsewhere = 0;
    var i = 0;
    while (i < vec_len(_ld_file)) {
        if (vec_get(_ld_sev, i) == 1) {
            if (streq(vec_get(_ld_file, i), open_path) == 1) { mine = mine + 1; }
            else { elsewhere = elsewhere + 1; }
        }
        i = i + 1;
    }
    if (mine > 0 || elsewhere == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "checked as part of ");
    str_builder_add_cstr(sb, load64(u + 16));
    var sel = _cu_cfg_env(load64(u + 24));
    if (sel != 0) {
        str_builder_add_cstr(sb, " (");
        str_builder_add_cstr(sb, sel);
        str_builder_add_cstr(sb, ")");
    }
    str_builder_add_cstr(sb, ", which has ");
    str_builder_add_int(sb, elsewhere);
    if (elsewhere == 1) { str_builder_add_cstr(sb, " error in another file"); }
    else { str_builder_add_cstr(sb, " errors in other files"); }
    _lsp_diag_txt(open_path, 3, str_data(str_builder_build(sb)));
    return 1;
}

# Publish on `uri` (the document at `path`) one Information diagnostic of this server's own, `txt`
# at line 0 — or, with `txt` 0, an empty list. 6.7.16 (a NOTE unit; a SKIP one). Its record as an
# open document of a unit is dropped: no unit's publish speaks for it now.
fn _lsp_publish_own(uri, path, txt): i64 {
    _lsp_diag_reset();
    if (txt != 0) { _lsp_diag_txt(path, 3, txt); }
    _lsp_publish_file(uri, path, "");
    _lsp_pub_init();
    var ku = vec_new();
    var kf = vec_new();
    var kn = vec_new();
    var j = 0;
    while (j < vec_len(_lsp_pub_units)) {
        var fj = vec_get(_lsp_pub_files, j);
        var nj = vec_get(_lsp_pub_note, j);
        if (nj == 0 || streq(fj, path) == 0) { _lsp_pub_push(ku, kf, kn, vec_get(_lsp_pub_units, j), fj, nj); }
        j = j + 1;
    }
    _lsp_pub_units = ku;
    _lsp_pub_files = kf;
    _lsp_pub_note = kn;
    log_msg("sent diagnostics");
    return 0;
}

# ================================================================
# LSP METHODS
# ================================================================

fn handle_initialize(body) : i64 {
    var id = json_get_id(body);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":{\"capabilities\":{");
    str_builder_add_cstr(sb, "\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":true},");
    # v5.7.39: advertise definitionProvider + documentSymbolProvider.
    # `textDocument/semanticTokens/full` deferred to a future slot —
    # the slot framing of "polish" landed cross-file resolution +
    # go-to-def first; semantic tokens earn their own slot when
    # consumer pull surfaces.
    str_builder_add_cstr(sb, "\"definitionProvider\":true,");
    str_builder_add_cstr(sb, "\"documentSymbolProvider\":true,");
    # v6.1.24: textDocument/hover — reuses the cross-file symbol table to show a
    # symbol's kind + where it's defined when the cursor rests on an identifier.
    str_builder_add_cstr(sb, "\"hoverProvider\":true,");
    # v5.9.10: textDocument/references (find-all-uses) on top of the
    # v5.7.39 cross-file symbol-table infrastructure.
    str_builder_add_cstr(sb, "\"referencesProvider\":true,");
    # v5.9.10: textDocument/semanticTokens/full. v5.11.42: legend
    # extended with `parameter` (index 6); coverage extended to
    # color `var X` locals as `variable` and `fn(args)` params as
    # `parameter` via a per-request pre-walk collector (see
    # `_lsp_collect_locals` + `_lsp_lookup_local`). Type idents in
    # signatures (`x: i64`, `: Result`) still fall through to
    # symbol-table lookup — user-defined struct/enum types get
    # their existing colors; built-in primitive types stay
    # uncolored. Editors fall back to textmate grammar for the
    # remaining uncolored bytes (literals, operators, comments).
    str_builder_add_cstr(sb, "\"semanticTokensProvider\":{");
    str_builder_add_cstr(sb, "\"legend\":{\"tokenTypes\":[\"function\",\"variable\",\"struct\",\"enum\",\"enumMember\",\"keyword\",\"parameter\"],\"tokenModifiers\":[]},");
    str_builder_add_cstr(sb, "\"full\":true}");
    str_builder_add_cstr(sb, "}}}");
    send_response(str_data(str_builder_build(sb)));
    log_msg("initialized");
    return 0;
}

fn handle_shutdown(body): i64 {
    var id = json_get_id(body);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":null}");
    send_response(str_data(str_builder_build(sb)));
    log_msg("shutdown");
    return 0;
}

fn handle_did_open_or_save(body): i64 {
    var uri = json_get_str(body, "\"uri\":");
    if (uri == 0) { return 0; }

    var path = uri_to_path(uri);
    log_msg(path);

    # Every extension the documented `.lsp.json` routes here (editor-integration.md). Until 6.7.12
    # only `.cyr` was compiled and indexed: a `.tcyr` / `.bcyr` / `.fcyr` / `.scyr` / `.smcyr`
    # returned before both and got no diagnostics at all. CHANGELOG [6.7.12]
    if (_lsp_is_cyrius_doc(path) == 0) { return 0; }

    # 6.7.16 — in a project (with the CLI), the document's UNIT: see COMPILE UNITS. A SKIP is never
    # compiled (an empty list); a NOTE gets its one Information diagnostic, no compile.
    # CHANGELOG [6.7.16]
    var u = 0;
    var root = 0;
    _cu_cur_g = 0;
    if (_cyrius_path != 0) {
        root = find_project_root(path);
        if (root != 0) { u = _cu_unit_for(root, path); }
    }
    if (u != 0 && load64(u) == _CU_SKIP) {
        log_msg("not compiled: cyrius.cyml [lsp] skip names it");
        _lsp_publish_own(uri, path, 0);
        return 0;
    }

    # v5.7.39: index this file (and transitive includes) into the
    # symbol table for go-to-def + outline. Idempotent — second
    # didOpen on the same file is a no-op via _lsp_already_indexed.
    _lsp_index_doc(path, root, u);

    if (u != 0 && load64(u) == _CU_NOTE) {
        log_msg(load64(u + 48));
        _lsp_publish_own(uri, path, load64(u + 48));
        return 0;
    }

    var stderr_out = compile_and_capture(path, u);
    if (stderr_out == 0) {
        # Compilation failed to launch — clear diagnostics
        parse_and_send_diagnostics(uri, path, "", 0, u);
        return 0;
    }

    parse_and_send_diagnostics(uri, path, stderr_out, _lsp_last_root, u);
    return 0;
}

# Index the document at `path` and the files it includes, resolved from the compile's root — the
# project root, or this server's working directory for a loose file — then the unit's entry's
# directory (6.7.16: `lsp_index_file` resolved them against the server's working directory, so a
# project opened from elsewhere missed its own includes, and a relative name made a `file://lib/…`
# location). In a project its unit's entry is indexed too, so go-to-definition from a fragment reaches
# what the entry's earlier includes declare. CHANGELOG [6.7.16]
fn _lsp_index_doc(path, root, u): i64 {
    var iroot = root;
    var incdir = 0;
    if (iroot == 0) {
        iroot = _lsp_cwd();
        if (iroot != 0) { incdir = _lsp_incdir(_lsp_rel_to(iroot, path)); }
    } elif (u != 0 && load64(u + 32) == 1) {
        incdir = _lsp_incdir(load64(u + 16));
    }
    lsp_index_file_r(path, iroot, incdir);
    if (u != 0 && streq(load64(u + 8), path) == 0) { lsp_index_file_r(load64(u + 8), iroot, incdir); }
    return 0;
}

# 1 when `path` ends in one of the cyrius source extensions the server compiles and indexes:
# .cyr, .tcyr, .bcyr, .fcyr, .scyr, .smcyr.
fn _lsp_is_cyrius_doc(path): i64 {
    if (_lsp_ends(path, ".cyr") == 1) { return 1; }
    if (_lsp_ends(path, ".tcyr") == 1) { return 1; }
    if (_lsp_ends(path, ".bcyr") == 1) { return 1; }
    if (_lsp_ends(path, ".fcyr") == 1) { return 1; }
    if (_lsp_ends(path, ".scyr") == 1) { return 1; }
    if (_lsp_ends(path, ".smcyr") == 1) { return 1; }
    return 0;
}

# 1 when the cstr `s` ends with the cstr `suf` (and is longer than it).
fn _lsp_ends(s, suf): i64 {
    var n = strlen(s);
    var k = strlen(suf);
    if (n <= k) { return 0; }
    return memeq(s + n - k, suf, k);
}

# v5.7.39: textDocument/definition.
# Request:  { ..., params: { textDocument: { uri: "..." }, position: { line: N, character: M } } }
# Response: { ..., result: Location | Location[] | null }
# We re-read the file content from disk (we don't cache document
# state across messages), find the IDENT at the cursor, and look it
# up in the symbol table.
fn handle_definition(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");

    # Parse line + character from "position":{...}.
    # Reuse the substring approach used elsewhere; keep simple.
    var line_pos = json_find(body, "\"line\":");
    if (line_pos < 0) { line_pos = json_find(body, "\"line\": "); }
    var line_val = 0;
    if (line_pos >= 0) {
        var p = line_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            line_val = line_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }
    var ch_pos = json_find(body, "\"character\":");
    if (ch_pos < 0) { ch_pos = json_find(body, "\"character\": "); }
    var ch_val = 0;
    if (ch_pos >= 0) {
        var p = ch_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            ch_val = ch_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }

    # Re-read the file. Symbol table doesn't store source text;
    # re-read is O(file size) per request which is fine for human-
    # interactive editor traffic.
    var path = 0;
    if (uri != 0) { path = uri_to_path(uri); }

    var found = 0;
    var resp_line = 0;
    var resp_col = 0;
    var resp_path = 0;
    if (path != 0) {
        var total_out[1];
        var buf = lsp_read_file(path, &total_out);
        var total = load64(&total_out);
        if (buf != 0 && total > 0) {
            var packed = lsp_ident_at_position(buf, total, line_val, ch_val);
            if (packed >= 0) {
                var s = packed & 0xFFFFFFFF;
                var e = (packed >> 32) & 0xFFFFFFFF;
                var name_len = e - s;
                # Look up in the symbol table.
                var idx = lsp_lookup_symbol(buf + s, name_len);
                if (idx >= 0) {
                    found = 1;
                    resp_line = load64(_sym_line + idx * 8);
                    resp_col  = load64(_sym_col  + idx * 8);
                    var po = load64(_sym_path_off + idx * 8);
                    resp_path = _lsp_indexed_buf + po;
                }
            }
        }
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    if (found == 1) {
        # Build a single-Location response. Range is the full IDENT;
        # we don't track end-col separately, so emit start+name_len.
        # Reading name_len back from the table is cheaper than
        # recomputing.
        str_builder_add_cstr(sb, ",\"result\":{\"uri\":\"file://");
        str_builder_add_cstr(sb, resp_path);
        str_builder_add_cstr(sb, "\",\"range\":{\"start\":{\"line\":");
        str_builder_add_int(sb, resp_line);
        str_builder_add_cstr(sb, ",\"character\":");
        str_builder_add_int(sb, resp_col);
        str_builder_add_cstr(sb, "},\"end\":{\"line\":");
        str_builder_add_int(sb, resp_line);
        str_builder_add_cstr(sb, ",\"character\":");
        # Approximate end: start col + name length (we have to recompute).
        var idx2 = 0;
        var end_col = resp_col + 1;
        while (idx2 < _sym_count) {
            var po2 = load64(_sym_path_off + idx2 * 8);
            if (memeq(_lsp_indexed_buf + po2, resp_path, strlen(resp_path) + 1) == 1) {
                if (load64(_sym_line + idx2 * 8) == resp_line) {
                    if (load64(_sym_col + idx2 * 8) == resp_col) {
                        end_col = resp_col + load64(_sym_name_len + idx2 * 8);
                        idx2 = _sym_count;
                    }
                }
            }
            idx2 = idx2 + 1;
        }
        str_builder_add_int(sb, end_col);
        str_builder_add_cstr(sb, "}}}}");
    } else {
        str_builder_add_cstr(sb, ",\"result\":null}");
    }
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# Map cyrius symbol kind to a human display string for hover.
fn _lsp_kind_name(k): i64 {
    if (k == 1) { return "fn"; }
    if (k == 2) { return "var"; }
    if (k == 3) { return "enum"; }
    if (k == 4) { return "struct"; }
    if (k == 5) { return "enum member"; }
    return "symbol";
}

# v6.1.24: textDocument/hover. Resolves the identifier under the cursor in the
# cross-file symbol table (same path as go-to-definition) and returns its kind +
# definition site as a markdown Hover. result:null when the cursor isn't on a
# known symbol. Mirrors handle_definition's position parsing + re-read-from-disk.
fn handle_hover(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");
    var line_pos = json_find(body, "\"line\":");
    if (line_pos < 0) { line_pos = json_find(body, "\"line\": "); }
    var line_val = 0;
    if (line_pos >= 0) {
        var p = line_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            line_val = line_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }
    var ch_pos = json_find(body, "\"character\":");
    if (ch_pos < 0) { ch_pos = json_find(body, "\"character\": "); }
    var ch_val = 0;
    if (ch_pos >= 0) {
        var p2 = ch_pos;
        while (load8(body + p2) == 32) { p2 = p2 + 1; }
        while (load8(body + p2) >= 48 && load8(body + p2) <= 57) {
            ch_val = ch_val * 10 + load8(body + p2) - 48;
            p2 = p2 + 1;
        }
    }
    var path = 0;
    if (uri != 0) { path = uri_to_path(uri); }

    var found = 0;
    var h_kind = 0;
    var h_path = 0;
    var h_line = 0;
    var h_name = 0;     # buf address of the ident
    var h_name_len = 0;
    if (path != 0) {
        var total_out[1];
        var buf = lsp_read_file(path, &total_out);
        var total = load64(&total_out);
        if (buf != 0 && total > 0) {
            var packed = lsp_ident_at_position(buf, total, line_val, ch_val);
            if (packed >= 0) {
                var s = packed & 0xFFFFFFFF;
                var e = (packed >> 32) & 0xFFFFFFFF;
                var nlen = e - s;
                var idx = lsp_lookup_symbol(buf + s, nlen);
                if (idx >= 0) {
                    found = 1;
                    h_kind = load64(_sym_kind + idx * 8);
                    var po = load64(_sym_path_off + idx * 8);
                    h_path = _lsp_indexed_buf + po;
                    h_line = load64(_sym_line + idx * 8);
                    h_name = buf + s;
                    h_name_len = nlen;
                }
            }
        }
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    if (found == 1) {
        # value = "**<kind>** `<name>`\n\nDefined at <path>:<line+1>"
        str_builder_add_cstr(sb, ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"**");
        str_builder_add_cstr(sb, _lsp_kind_name(h_kind));
        str_builder_add_cstr(sb, "** `");
        var i = 0;
        while (i < h_name_len) { str_builder_add_byte(sb, load8(h_name + i)); i = i + 1; }
        str_builder_add_cstr(sb, "`\\n\\nDefined at ");
        str_builder_add_cstr(sb, h_path);
        str_builder_add_cstr(sb, ":");
        str_builder_add_int(sb, h_line + 1);
        str_builder_add_cstr(sb, "\"}}}");
    } else {
        str_builder_add_cstr(sb, ",\"result\":null}");
    }
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# Map cyrius symbol kind to LSP SymbolKind enum.
#   1=fn → SymbolKind.Function (12)
#   2=var → SymbolKind.Variable (13)
#   3=enum → SymbolKind.Enum (10)
#   4=struct → SymbolKind.Struct (23)
#   5=enum-member → SymbolKind.EnumMember (22)
fn _lsp_kind_to_lsp(k): i64 {
    if (k == 1) { return 12; }
    if (k == 2) { return 13; }
    if (k == 3) { return 10; }
    if (k == 4) { return 23; }
    if (k == 5) { return 22; }
    return 13;
}

# v5.7.39: textDocument/documentSymbol.
# Returns SymbolInformation[] for the requested file (flat list, not
# the hierarchical DocumentSymbol[] form — the flat form is well-
# supported across editor clients and matches our flat index).
fn handle_document_symbol(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");
    var path = 0;
    if (uri != 0) { path = uri_to_path(uri); }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":[");

    var first = 1;
    if (path != 0) {
        var path_len = strlen(path);
        var i = 0;
        while (i < _sym_count) {
            var po = load64(_sym_path_off + i * 8);
            if (memeq(_lsp_indexed_buf + po, path, path_len + 1) == 1) {
                if (first == 0) { str_builder_add_cstr(sb, ","); }
                first = 0;
                var sym_line = load64(_sym_line + i * 8);
                var sym_col = load64(_sym_col + i * 8);
                var sym_kind = load64(_sym_kind + i * 8);
                var sym_no = load64(_sym_name_off + i * 8);
                var sym_nl = load64(_sym_name_len + i * 8);
                str_builder_add_cstr(sb, "{\"name\":\"");
                # Add the IDENT name (no escaping needed — IDENTs are
                # ASCII alphanumerics + underscore).
                var name_buf = alloc(sym_nl + 1);
                var ni = 0;
                while (ni < sym_nl) {
                    store8(name_buf + ni, load8(_sym_names_buf + sym_no + ni));
                    ni = ni + 1;
                }
                store8(name_buf + sym_nl, 0);
                str_builder_add_cstr(sb, name_buf);
                str_builder_add_cstr(sb, "\",\"kind\":");
                str_builder_add_int(sb, _lsp_kind_to_lsp(sym_kind));
                str_builder_add_cstr(sb, ",\"location\":{\"uri\":\"file://");
                str_builder_add_cstr(sb, path);
                str_builder_add_cstr(sb, "\",\"range\":{\"start\":{\"line\":");
                str_builder_add_int(sb, sym_line);
                str_builder_add_cstr(sb, ",\"character\":");
                str_builder_add_int(sb, sym_col);
                str_builder_add_cstr(sb, "},\"end\":{\"line\":");
                str_builder_add_int(sb, sym_line);
                str_builder_add_cstr(sb, ",\"character\":");
                str_builder_add_int(sb, sym_col + sym_nl);
                str_builder_add_cstr(sb, "}}}}");
            }
            i = i + 1;
        }
    }
    str_builder_add_cstr(sb, "]}");
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# v5.9.10: textDocument/references.
# Request:  { ..., params: { textDocument: { uri }, position: { line, character }, context: { includeDeclaration: bool } } }
# Response: Location[] | null
#
# Semantics: find every IDENT token in every indexed file whose
# byte-content equals the IDENT at the cursor. Returns each as a
# Location. The `context.includeDeclaration` flag is honored
# implicitly — declarations ARE matches by name, so they appear
# in the result; we don't expose a separate "exclude
# declarations" path because the symbol table doesn't tag use
# sites separately from decl sites.
#
# Cost: O(sum of indexed-file sizes) per request. For a project
# of ~50 files / ~30 KLOC that's a few MB of ident tokenization
# — acceptable for human-interactive editor traffic. If a
# downstream consumer surfaces latency pressure, a future slot
# can build a reverse index keyed by ident hash.
fn handle_references(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");

    var line_pos = json_find(body, "\"line\":");
    if (line_pos < 0) { line_pos = json_find(body, "\"line\": "); }
    var line_val = 0;
    if (line_pos >= 0) {
        var p = line_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            line_val = line_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }
    var ch_pos = json_find(body, "\"character\":");
    if (ch_pos < 0) { ch_pos = json_find(body, "\"character\": "); }
    var ch_val = 0;
    if (ch_pos >= 0) {
        var p = ch_pos;
        while (load8(body + p) == 32) { p = p + 1; }
        while (load8(body + p) >= 48 && load8(body + p) <= 57) {
            ch_val = ch_val * 10 + load8(body + p) - 48;
            p = p + 1;
        }
    }

    var target_off = 0;
    var target_len = 0;
    if (uri != 0) {
        var src_path = uri_to_path(uri);
        var total_out[1];
        var src_buf = lsp_read_file(src_path, &total_out);
        var total = load64(&total_out);
        if (src_buf != 0 && total > 0) {
            var packed = lsp_ident_at_position(src_buf, total, line_val, ch_val);
            if (packed >= 0) {
                var s = packed & 0xFFFFFFFF;
                var e = (packed >> 32) & 0xFFFFFFFF;
                target_len = e - s;
                # Snapshot ident bytes — src_buf gets reused below.
                target_off = alloc(target_len);
                var i = 0;
                while (i < target_len) {
                    store8(target_off + i, load8(src_buf + s + i));
                    i = i + 1;
                }
            }
        }
    }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":[");

    var first = 1;
    if (target_len > 0) {
        var fi = 0;
        while (fi < _lsp_indexed_count) {
            var off = load64(_lsp_indexed_off + fi * 8);
            var path = _lsp_indexed_buf + off;

            var fb_total[1];
            var fb = lsp_read_file(path, &fb_total);
            var ftotal = load64(&fb_total);
            if (fb != 0 && ftotal > 0) {
                var p = 0;
                var line_no = 0;
                var line_start = 0;
                while (p < ftotal) {
                    var c = load8(fb + p);
                    if (c == 10) {
                        line_no = line_no + 1;
                        line_start = p + 1;
                        p = p + 1;
                    } else {
                        if (_lsp_id_start(c) == 1) {
                            var id_start = p;
                            var id_end = _lsp_scan_id_end(fb, p, ftotal);
                            var id_len = id_end - id_start;
                            if (id_len == target_len) {
                                var match_ok = 1;
                                var k = 0;
                                while (k < id_len) {
                                    if (load8(fb + id_start + k) != load8(target_off + k)) {
                                        match_ok = 0;
                                        k = id_len;
                                    } else {
                                        k = k + 1;
                                    }
                                }
                                if (match_ok == 1) {
                                    var col = id_start - line_start;
                                    if (first == 0) { str_builder_add_cstr(sb, ","); }
                                    first = 0;
                                    str_builder_add_cstr(sb, "{\"uri\":\"file://");
                                    str_builder_add_cstr(sb, path);
                                    str_builder_add_cstr(sb, "\",\"range\":{\"start\":{\"line\":");
                                    str_builder_add_int(sb, line_no);
                                    str_builder_add_cstr(sb, ",\"character\":");
                                    str_builder_add_int(sb, col);
                                    str_builder_add_cstr(sb, "},\"end\":{\"line\":");
                                    str_builder_add_int(sb, line_no);
                                    str_builder_add_cstr(sb, ",\"character\":");
                                    str_builder_add_int(sb, col + id_len);
                                    str_builder_add_cstr(sb, "}}}");
                                }
                            }
                            p = id_end;
                        } else {
                            p = p + 1;
                        }
                    }
                }
            }
            fi = fi + 1;
        }
    }

    str_builder_add_cstr(sb, "]}");
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# v5.9.10 helpers for textDocument/semanticTokens/full.
# v5.11.42: legend extended with `parameter` (index 6).
#
# Token-type indices in the legend advertised by handle_initialize:
#   0 = function, 1 = variable, 2 = struct, 3 = enum,
#   4 = enumMember, 5 = keyword, 6 = parameter (v5.11.42)
fn _lsp_kind_to_semantic_type(k): i64 {
    if (k == 1) { return 0; }   # fn → function
    if (k == 2) { return 1; }   # var → variable
    if (k == 4) { return 2; }   # struct → struct
    if (k == 3) { return 3; }   # enum → enum
    if (k == 5) { return 4; }   # enum-member → enumMember
    return 0 - 1;
}

# Is `<buf+off, len>` a cyrius keyword?
fn _lsp_is_keyword(buf, off, len, total): i64 {
    if (len == 2) {
        if (load8(buf + off) == 105 && load8(buf + off + 1) == 102) { return 1; }   # "if"
        if (load8(buf + off) == 105 && load8(buf + off + 1) == 110) { return 1; }   # "in"
        if (load8(buf + off) == 102 && load8(buf + off + 1) == 110) { return 1; }   # "fn"
        if (load8(buf + off) == 100 && load8(buf + off + 1) == 111) { return 1; }   # "do" (6.7.5)
    }
    if (len == 3) {
        if (memeq(buf + off, "var", 3) == 1) { return 1; }
        if (memeq(buf + off, "for", 3) == 1) { return 1; }
        if (memeq(buf + off, "dyn", 3) == 1) { return 1; }   # 6.7.8 (the checked trait object)
    }
    if (len == 4) {
        if (memeq(buf + off, "else", 4) == 1) { return 1; }
        if (memeq(buf + off, "elif", 4) == 1) { return 1; }
        if (memeq(buf + off, "enum", 4) == 1) { return 1; }
        if (memeq(buf + off, "impl", 4) == 1) { return 1; }
        if (memeq(buf + off, "true", 4) == 1) { return 1; }    # 6.7.3 (B2)
        # 6.7.5 (B5): `loop` is CONTEXTUAL — a keyword only when `{` follows (`loop { .. }`);
        # `var loop = 1;` and its reads stay identifiers, as the compiler treats them.
        if (memeq(buf + off, "loop", 4) == 1) { return _lsp_brace_next(buf, off + 4, total); }
    }
    if (len == 5) {
        if (memeq(buf + off, "while", 5) == 1) { return 1; }
        if (memeq(buf + off, "break", 5) == 1) { return 1; }
        if (memeq(buf + off, "match", 5) == 1) { return 1; }
        # v6.1.24: keyword-set refresh — the lexer's LEXKW_EXT (src/frontend/lex.cyr)
        # reserves these too, but the highlighter had never colored them.
        if (memeq(buf + off, "union", 5) == 1) { return 1; }   # union type
        if (memeq(buf + off, "stack", 5) == 1) { return 1; }   # stack-local array qualifier (v5.5.36)
        if (memeq(buf + off, "defer", 5) == 1) { return 1; }   # defer statement
        if (memeq(buf + off, "trait", 5) == 1) { return 1; }   # 6.7.0 (A1)
        if (memeq(buf + off, "const", 5) == 1) { return 1; }   # 6.7.2 (B1)
        if (memeq(buf + off, "false", 5) == 1) { return 1; }   # 6.7.3 (B2)
    }
    if (len == 6) {
        if (memeq(buf + off, "return", 6) == 1) { return 1; }
        if (memeq(buf + off, "struct", 6) == 1) { return 1; }
        if (memeq(buf + off, "shared", 6) == 1) { return 1; }
        # v6.1.24: secret = zeroise-on-return attribute (reserved keyword); sizeof
        # = compile-time size operator. Both were missing from the highlighter.
        if (memeq(buf + off, "secret", 6) == 1) { return 1; }
        if (memeq(buf + off, "sizeof", 6) == 1) { return 1; }
    }
    if (len == 7) {
        if (memeq(buf + off, "include", 7) == 1) { return 1; }
        if (memeq(buf + off, "default", 7) == 1) { return 1; }
    }
    if (len == 8) {
        if (memeq(buf + off, "continue", 8) == 1) { return 1; }
    }
    return 0;
}

# 1 when the first byte at or after `p` (below `total`) that is not a space, tab, CR or LF is `{`.
fn _lsp_brace_next(buf, p, total): i64 {
    while (p < total) {
        var c = load8(buf + p);
        if (c == 123) { return 1; }
        if (c != 32 && c != 9 && c != 10 && c != 13) { return 0; }
        p = p + 1;
    }
    return 0;
}

# v5.11.42 helpers: pre-walk collector + name lookup for the
# per-request locals table. The collector runs a simple state
# machine over the file:
#   default → on `var` keyword: next ident is local
#           → on `fn` keyword: next ident is fn name (skip);
#                              then `(` opens param mode
#   param-name → register ident as parameter; expect `:`/`,`/`)`
#   param-after-name → on `:` → type-annotation mode (no register)
#                    → on `,` → back to param-name
#                    → on `)` → exit signature
#   type-annotation → on `,` → param-name; on `)` → exit
# 6.7.7: a parameter may carry a default (`b = f(x, y)`) and a tuple
# type (`t: (i64, i64)`), so the `,` / `)` / `:` above count only at
# the list's own bracket depth (`sig_depth`), and a char literal is
# skipped like a string — the default's `y` (the tuple's `i64`) was
# registered as a parameter and its `)` ended the signature, dropping
# the parameters after it. The `=` itself needs no state: only a
# depth-0 `,` (or the list's `(`) leads to param-name. CHANGELOG [6.7.7]
# 6.7.11: a generic type's `<` `>` nest too (`p: Pair<i64, i64>`), in the TYPE only — as the
# compiler's _pl_next / _pl_tdepth — so after the parameter's depth-0 `=` (`sig_dflt`) a `<` is an
# operator again (`c = 1 < 2`). The comma inside `<..>` registered `i64` as a parameter, and the
# file-wide table then colored every `i64` in the file a parameter. CHANGELOG [6.7.11]
# Scope is intentionally NOT tracked: a `var x` in one fn and a
# different `var x` in another both get colored as `variable` —
# the visual outcome is identical so the simplification is free.
fn _lsp_collect_locals(fb, ftotal): i64 {
    _lsp_local_count = 0;
    var p = 0;
    var sig_state = 0;     # 0=outside, 1=after fn, 2=after fn-name,
    # 3=expect param name, 4=after param name,
    # 5=type annotation (a default stays in 4 / 5)
    var sig_depth = 0;     # brackets open inside the parameter list
    var sig_dflt = 0;      # 1 after this parameter's depth-0 `=` (in its default)
    var var_pending = 0;   # 1 = just saw `var`, next ident is local
    while (p < ftotal) {
        var c = load8(fb + p);
        if (c == 10) { p = p + 1; }
        elif (c == 35) {
            # `# comment` — skip to EOL
            while (p < ftotal && load8(fb + p) != 10) { p = p + 1; }
        }
        elif (c == 34 || c == 39) {
            # string / char literal — skip to the closing quote (with `\\` escape)
            p = p + 1;
            while (p < ftotal) {
                var sc = load8(fb + p);
                if (sc == 92) { p = p + 2; }
                else {
                    if (sc == c) { p = p + 1; break; }
                    if (sc == 10) { break; }
                    p = p + 1;
                }
            }
        }
        elif (_lsp_id_start(c) == 1) {
            var id_start = p;
            var id_end = _lsp_scan_id_end(fb, p, ftotal);
            var id_len = id_end - id_start;
            var is_var_kw = 0;
            var is_fn_kw  = 0;
            if (id_len == 3) {
                if (memeq(fb + id_start, "var", 3) == 1) { is_var_kw = 1; }
            }
            if (id_len == 2) {
                if (memeq(fb + id_start, "fn", 2)  == 1) { is_fn_kw  = 1; }
            }
            if (is_var_kw == 1) {
                var_pending = 1;
            } elif (is_fn_kw == 1) {
                sig_state = 1;
                sig_depth = 0;
                sig_dflt = 0;
                var_pending = 0;
            } else {
                if (var_pending == 1) {
                    if (_lsp_local_count < _LSP_LOCAL_CAP) {
                        store64(_lsp_local_off  + _lsp_local_count * 8, id_start);
                        store64(_lsp_local_len  + _lsp_local_count * 8, id_len);
                        store64(_lsp_local_kind + _lsp_local_count * 8, 1);  # variable
                        _lsp_local_count = _lsp_local_count + 1;
                    }
                    var_pending = 0;
                } elif (sig_state == 1) {
                    # This ident is the fn name — skip.
                    sig_state = 2;
                } elif (sig_state == 3) {
                    if (_lsp_local_count < _LSP_LOCAL_CAP) {
                        store64(_lsp_local_off  + _lsp_local_count * 8, id_start);
                        store64(_lsp_local_len  + _lsp_local_count * 8, id_len);
                        store64(_lsp_local_kind + _lsp_local_count * 8, 6);  # parameter
                        _lsp_local_count = _lsp_local_count + 1;
                    }
                    sig_state = 4;
                }
                # sig_state 4/5: ident is type or unrelated; no register.
            }
            p = id_end;
        }
        else {
            if (c == 40 || c == 91) {                 # `(` `[`
                if (sig_state == 2 && c == 40) { sig_state = 3; }
                elif (sig_state >= 3) { sig_depth = sig_depth + 1; }
            } elif (c == 41 || c == 93) {             # `)` `]`
                if (sig_state >= 3) {
                    if (sig_depth > 0) { sig_depth = sig_depth - 1; }
                    elif (c == 41) { sig_state = 0; }
                }
            } elif (c == 123) {                       # `{`
                # Defensive: a `{` outside the signature ends any
                # stale signature state (covers `fn name() { ... }`
                # boundary without sig_state being explicitly reset
                # on every `)`).
                sig_state = 0;
                sig_depth = 0;
            } elif (c == 60 || c == 62) {             # `<` `>` — in a parameter's TYPE only
                if (sig_state == 5 && sig_dflt == 0) {
                    if (c == 60) { sig_depth = sig_depth + 1; }
                    elif (sig_depth > 0) { sig_depth = sig_depth - 1; }
                }
            } elif (sig_depth == 0) {                 # not inside a default's brackets
                if (c == 58) {                        # `:`
                    if (sig_state == 4) { sig_state = 5; }
                } elif (c == 44) {                    # `,`
                    if (sig_state >= 3) { sig_state = 3; sig_dflt = 0; }
                } elif (c == 61) {                    # `=` — the parameter's default
                    if (sig_state >= 3) { sig_dflt = 1; }
                }
            }
            p = p + 1;
        }
    }
    return _lsp_local_count;
}

# Lookup `<fb+off, len>` in the per-request locals table.
# Returns the semantic-token-type index (1 or 6) on hit, -1 on miss.
fn _lsp_lookup_local(fb, off, len): i64 {
    var i = 0;
    while (i < _lsp_local_count) {
        var entry_len = load64(_lsp_local_len + i * 8);
        if (entry_len == len) {
            var entry_off = load64(_lsp_local_off + i * 8);
            if (memeq(fb + entry_off, fb + off, len) == 1) {
                return load64(_lsp_local_kind + i * 8);
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# v5.9.10: textDocument/semanticTokens/full.
# v5.11.42: added locals + fn-parameter coverage via two-pass walk
# (pre-collect + emit). Legend extended with `parameter` (index 6).
# Request:  { ..., params: { textDocument: { uri } } }
# Response: { ..., result: { data: int[] } | null }
#
# Per LSP 3.16 spec, the `data` array is a flat int sequence
# where every 5 ints describe one token:
#   [deltaLine, deltaStartChar, length, tokenType, tokenModifiers]
# Tokens are sorted ascending by (line, col); deltas are relative
# to the previous token (or start-of-file for the first). When
# the line advances, deltaStartChar resets to absolute.
#
# Coverage (v5.11.42): keywords + v5.7.39 cross-file symbol-table
# idents (fn / global var / struct / enum / enum-member) + locals
# (`var X`) + fn parameters (`fn(arg, arg2)`). Skipped: type names
# in signatures (built-in primitives like `i64`; user-defined
# struct/enum types already get their existing color via symbol
# table), string / number literals, operators, comments. Editors
# fall back to textmate grammar for the rest.
fn handle_semantic_tokens(body): i64 {
    var id = json_get_id(body);
    var uri = json_get_str(body, "\"uri\":");
    var path = 0;
    if (uri != 0) { path = uri_to_path(uri); }

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"jsonrpc\":\"2.0\",\"id\":");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, ",\"result\":{\"data\":[");

    var first = 1;
    var prev_line = 0;
    var prev_col = 0;

    if (path != 0) {
        var total_out[1];
        var fb = lsp_read_file(path, &total_out);
        var ftotal = load64(&total_out);
        if (fb != 0 && ftotal > 0) {
            # v5.11.42: pre-walk to collect locals + fn parameters
            # into _lsp_local_off/_len/_kind. The emit walk below
            # then checks each ident against this table BEFORE
            # falling through to keyword / symbol-table lookup.
            _lsp_collect_locals(fb, ftotal);
            var p = 0;
            var line_no = 0;
            var line_start = 0;
            while (p < ftotal) {
                var c = load8(fb + p);
                if (c == 10) {
                    line_no = line_no + 1;
                    line_start = p + 1;
                    p = p + 1;
                } else {
                    # Skip `# comment` lines wholesale.
                    if (c == 35) {
                        while (p < ftotal && load8(fb + p) != 10) { p = p + 1; }
                    } else {
                        # Skip string literals — `"..."` with `\\` escape.
                        if (c == 34) {
                            p = p + 1;
                            while (p < ftotal) {
                                var sc = load8(fb + p);
                                if (sc == 92) {       # '\\'
                                    p = p + 2;
                                } else {
                                    if (sc == 34) { p = p + 1; break; }
                                    if (sc == 10) { break; }
                                    p = p + 1;
                                }
                            }
                        } else {
                            if (_lsp_id_start(c) == 1) {
                                var id_start = p;
                                var id_end = _lsp_scan_id_end(fb, p, ftotal);
                                var id_len = id_end - id_start;
                                var ttype = 0 - 1;
                                if (_lsp_is_keyword(fb, id_start, id_len, ftotal) == 1) {
                                    ttype = 5;
                                } else {
                                    # v5.11.42: local-table lookup
                                    # wins over symbol-table — locals
                                    # shadow globals of the same name
                                    # (consistent with cyrius scoping).
                                    ttype = _lsp_lookup_local(fb, id_start, id_len);
                                    if (ttype < 0) {
                                        var idx = lsp_lookup_symbol(fb + id_start, id_len);
                                        if (idx >= 0) {
                                            var k = load64(_sym_kind + idx * 8);
                                            ttype = _lsp_kind_to_semantic_type(k);
                                        }
                                    }
                                }
                                if (ttype >= 0) {
                                    var col = id_start - line_start;
                                    var dline = 0;
                                    var dcol = 0;
                                    if (first == 1) {
                                        dline = line_no;
                                        dcol = col;
                                        first = 0;
                                    } else {
                                        dline = line_no - prev_line;
                                        if (dline == 0) {
                                            dcol = col - prev_col;
                                        } else {
                                            dcol = col;
                                        }
                                        str_builder_add_cstr(sb, ",");
                                    }
                                    str_builder_add_int(sb, dline);
                                    str_builder_add_cstr(sb, ",");
                                    str_builder_add_int(sb, dcol);
                                    str_builder_add_cstr(sb, ",");
                                    str_builder_add_int(sb, id_len);
                                    str_builder_add_cstr(sb, ",");
                                    str_builder_add_int(sb, ttype);
                                    str_builder_add_cstr(sb, ",0");
                                    prev_line = line_no;
                                    prev_col = col;
                                }
                                p = id_end;
                            } else {
                                p = p + 1;
                            }
                        }
                    }
                }
            }
        }
    }

    str_builder_add_cstr(sb, "]}}");
    send_response(str_data(str_builder_build(sb)));
    return 0;
}

# ================================================================
# MAIN LOOP
# ================================================================

fn main(): i64 {
    alloc_init();

    # v5.7.39: allocate symbol-table backing buffers up front.
    lsp_index_init();

    # Find cycc
    _cycc_path = find_cycc();
    if (_cycc_path == 0) {
        log_msg("warning: cycc not found — diagnostics disabled");
    } else {
        var log_sb = str_builder_new();
        str_builder_add_cstr(log_sb, "found cycc: ");
        str_builder_add_cstr(log_sb, _cycc_path);
        log_msg(str_data(str_builder_build(log_sb)));
    }

    # v5.11.56: find cyrius wrapper for project-aware compile path
    # (closes [deps.*]-resolution false positives — Item 2).
    _cyrius_path = find_cyrius();
    if (_cyrius_path == 0) {
        log_msg("note: cyrius wrapper not found — falling back to raw cycc (deps will not resolve in diagnostics)");
    } else {
        var clog_sb = str_builder_new();
        str_builder_add_cstr(clog_sb, "found cyrius wrapper: ");
        str_builder_add_cstr(clog_sb, _cyrius_path);
        log_msg(str_data(str_builder_build(clog_sb)));
    }

    # Main loop: read JSON-RPC messages
    var running = 1;
    while (running == 1) {
        var clen = read_header();
        if (clen < 0) { running = 0; break; }
        var body = read_body(clen);
        if (body == 0) { running = 0; break; }

        # Match methods — check longer names first to avoid prefix ambiguity
        # Handle both compact ("method":"X") and spaced ("method": "X") JSON
        if (json_find(body, "\"method\":\"initialized\"") >= 0 || json_find(body, "\"method\": \"initialized\"") >= 0) {
            # No response needed
        }
        elif (json_find(body, "\"method\":\"initialize\"") >= 0 || json_find(body, "\"method\": \"initialize\"") >= 0) {
            handle_initialize(body);
        }
        elif (json_find(body, "\"method\":\"shutdown\"") >= 0 || json_find(body, "\"method\": \"shutdown\"") >= 0) {
            handle_shutdown(body);
            running = 0;
        }
        elif (json_find(body, "\"method\":\"exit\"") >= 0 || json_find(body, "\"method\": \"exit\"") >= 0) {
            running = 0;
        }
        elif (json_find(body, "\"textDocument/didOpen\"") >= 0) {
            handle_did_open_or_save(body);
        }
        elif (json_find(body, "\"textDocument/didSave\"") >= 0) {
            handle_did_open_or_save(body);
        }
        elif (json_find(body, "\"textDocument/didChange\"") >= 0) {
            handle_did_open_or_save(body);
        }
        # v5.7.39: cross-file go-to-def + outline.
        elif (json_find(body, "\"textDocument/definition\"") >= 0) {
            handle_definition(body);
        }
        # v6.1.24: hover (symbol kind + definition site).
        elif (json_find(body, "\"textDocument/hover\"") >= 0) {
            handle_hover(body);
        }
        elif (json_find(body, "\"textDocument/documentSymbol\"") >= 0) {
            handle_document_symbol(body);
        }
        # v5.9.10: find-all-uses + semantic-tokens.
        elif (json_find(body, "\"textDocument/references\"") >= 0) {
            handle_references(body);
        }
        elif (json_find(body, "\"textDocument/semanticTokens/full\"") >= 0) {
            handle_semantic_tokens(body);
        }
    }

    _cu_cleanup();   # 6.7.16: the lib/ include file's private directory, should a compile have left it
    return 0;
}

var r = main();
syscall(60, r);
