# api_surface — snapshot-based public API diff for cyrius projects.
#
# Pinned 2026-04-28 at v5.7.32 ship; pattern adapted from
# agnosys/scripts/check-api-surface.sh. Shipped pure-cyrius
# rather than as a bash script per the sovereign-toolchain
# stance ("no external runtime").
#
# Usage (via cbt frontend):
#   cyrius api-surface             # diff vs committed snapshot; rc=1 on breakage
#   cyrius api-surface --update    # regenerate snapshot
#
# Direct usage:
#   cyrius_api_surface [--update] [--snapshot=PATH]
#
# What counts as "public": any `fn NAME(args)` not prefixed with
# `_`. Conventions:
#   - `_*` underscore prefix = private by convention; excluded
#   - struct types, enums, top-level vars: NOT tracked here
#     (separate concern; could be added later if a consumer
#     surfacing demands it).
#
# Entry format: `module::name/arity` per line, sorted ascending.
# Module = basename of the source file without `.cyr`.
#
# Default scan: src/*.cyr + lib/*.cyr (whichever exist).
# Default snapshot path: docs/api-surface.snapshot.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/fs.cyr"
include "lib/syscalls.cyr"
include "lib/args.cyr"

var DEFAULT_SNAPSHOT = "docs/api-surface.snapshot";
var SNAPSHOT_BUF = 0;
var ENTRIES_BUF = 0;
var ENTRIES_OFFS = 0;
var ENTRIES_LENS = 0;
var ENTRIES_COUNT = 0;
var ENTRIES_BUF_USED = 0;
# Snapshot accumulator caps. At ~4.5k fns the buffer sits near 200 KB and the
# entry tables near 4.5k/16k slots, growing ~16 entries/fold — so these had
# headroom, but `_push_entry` did NO bounds check and would SILENTLY OVERFLOW
# (heap corruption -> undetected api-surface drift on a real CI gate). Raised
# 512 KB -> 1 MB / 8192 -> 16384 slots and added a fail-loud guard. Same
# silent-cap class as the v6.2.20 fmt fix. See CHANGELOG [6.2.21].
var ENTRIES_BUF_CAP = 1048576;
var ENTRIES_MAX = 16384;
# Snapshot-file read buffer (the committed snapshot, ~130 KB, read back for the
# diff). Source-file scanning uses a separate 2 MB `filebuf` (v6.0.53). Raised
# 256 KB -> 1 MB + fail-loud so a grown snapshot can't silently truncate into a
# false diff.
var SNAPSHOT_CAP = 1048576;

fn _reset_entries(): i64 {
    ENTRIES_COUNT = 0;
    ENTRIES_BUF_USED = 0;
    return 0;
}

# Append "module::name/arity" to ENTRIES_BUF; record offset+len.
fn _push_entry(module_off, module_len, name_off, name_len, arity): i64 {
    # Fail loud rather than silently overflow the fixed buffers. Worst-case
    # entry = module + "::" + name + "/" + up-to-24-digit arity; +64 covers it.
    if (ENTRIES_COUNT >= ENTRIES_MAX) {
        syscall(SYS_WRITE, 2, "error: api-surface entry table full (raise ENTRIES_MAX)\n", 55);
        syscall(60, 3);
    }
    if (ENTRIES_BUF_USED + module_len + name_len + 64 > ENTRIES_BUF_CAP) {
        syscall(SYS_WRITE, 2, "error: api-surface buffer full (raise ENTRIES_BUF_CAP)\n", 54);
        syscall(60, 3);
    }
    var off = ENTRIES_BUF_USED;
    var i = 0;
    while (i < module_len) {
        store8(ENTRIES_BUF + off + i, load8(module_off + i));
        i = i + 1;
    }
    var p = off + module_len;
    store8(ENTRIES_BUF + p, 58); store8(ENTRIES_BUF + p + 1, 58);
    p = p + 2;
    var j = 0;
    while (j < name_len) {
        store8(ENTRIES_BUF + p + j, load8(name_off + j));
        j = j + 1;
    }
    p = p + name_len;
    store8(ENTRIES_BUF + p, 47);     # '/'
    p = p + 1;
    var ar_buf[24];
    var ar_len = fmt_int_buf(arity, &ar_buf);
    var k = 0;
    while (k < ar_len) {
        store8(ENTRIES_BUF + p + k, load8(&ar_buf + k));
        k = k + 1;
    }
    p = p + ar_len;
    var total_len = p - off;
    store64(ENTRIES_OFFS + ENTRIES_COUNT * 8, off);
    store64(ENTRIES_LENS + ENTRIES_COUNT * 8, total_len);
    ENTRIES_COUNT = ENTRIES_COUNT + 1;
    ENTRIES_BUF_USED = p;
    return 0;
}

fn _cmp_entry(i, j): i64 {
    var ai = load64(ENTRIES_OFFS + i * 8);
    var al = load64(ENTRIES_LENS + i * 8);
    var bi = load64(ENTRIES_OFFS + j * 8);
    var bl = load64(ENTRIES_LENS + j * 8);
    var min = al;
    if (bl < min) { min = bl; }
    var k = 0;
    while (k < min) {
        var ac = load8(ENTRIES_BUF + ai + k);
        var bc = load8(ENTRIES_BUF + bi + k);
        if (ac < bc) { return 0 - 1; }
        if (ac > bc) { return 1; }
        k = k + 1;
    }
    if (al < bl) { return 0 - 1; }
    if (al > bl) { return 1; }
    return 0;
}

fn _sort_entries(): i64 {
    var i = 1;
    while (i < ENTRIES_COUNT) {
        var j = i;
        while (j > 0) {
            if (_cmp_entry(j - 1, j) <= 0) { j = 0; }
            else {
                var off_a = load64(ENTRIES_OFFS + (j - 1) * 8);
                var len_a = load64(ENTRIES_LENS + (j - 1) * 8);
                var off_b = load64(ENTRIES_OFFS + j * 8);
                var len_b = load64(ENTRIES_LENS + j * 8);
                store64(ENTRIES_OFFS + (j - 1) * 8, off_b);
                store64(ENTRIES_LENS + (j - 1) * 8, len_b);
                store64(ENTRIES_OFFS + j * 8, off_a);
                store64(ENTRIES_LENS + j * 8, len_a);
                j = j - 1;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn _is_idstart(c): i64 {
    if (c >= 65) { if (c <= 90) { return 1; } }
    if (c >= 97) { if (c <= 122) { return 1; } }
    if (c == 95) { return 1; }
    return 0;
}
fn _is_idcont(c): i64 {
    if (_is_idstart(c) == 1) { return 1; }
    if (c >= 48) { if (c <= 57) { return 1; } }
    return 0;
}

fn _scan_id(buf, pos, total): i64 {
    var p = pos + 1;
    while (p < total) {
        if (_is_idcont(load8(buf + p)) == 0) { return p; }
        p = p + 1;
    }
    return p;
}

# v5.9.9: build a synthesized public-fn entry name like
# `<struct>_<field>` or `<struct>_set_<field>` or
# `<struct>_to_json` and push it. `suffix_cstr` is the literal
# infix between struct name and field name (e.g. "_", "_set_",
# "_to_json") — for Serialize-style emits with no field
# component, pass `field_len == 0`.
fn _push_synthesized(module_off, module_len,
                     struct_off, struct_len,
                     suffix_cstr,
                     field_off, field_len,
                     arity) {
    var sb = str_builder_new();
    var i = 0;
    while (i < struct_len) {
        str_builder_add_byte(sb, load8(struct_off + i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, suffix_cstr);
    var j = 0;
    while (j < field_len) {
        str_builder_add_byte(sb, load8(field_off + j));
        j = j + 1;
    }
    var s = str_builder_build(sb);
    _push_entry(module_off, module_len, str_data(s), str_len(s), arity);
    return 0;
}

# v5.9.9: scan a `struct <name> { <fields> }` definition starting
# at `start_pos` (where `struct ` keyword begins, AFTER any
# whitespace already trimmed by the caller). For each field,
# emit synthesized accessor fn entries based on the pending
# derive flags. Returns the position past the closing `}`.
#
# Pre-v5.9.9 the api-surface scanner walked `^fn name(...)`
# declarations only — `#derive(accessors)` and
# `#derive(Serialize)` emit public callable fns at compile time
# that this scanner never saw. agnosys 1.0.11 surfaced the gap
# (335 entries vs the awk-walker's 721; 386-entry delta = the
# count of derive-emitted accessor pairs).
fn _scan_derive_struct(filebuf, filelen, module_off, module_len,
                       struct_pos, want_accessors, want_serialize) {
    var p = struct_pos + 7;   # skip "struct "
    while (p < filelen) {
        var c = load8(filebuf + p);
        if (c != 32) { if (c != 9) { break; } }
        p = p + 1;
    }
    var name_start = p;
    while (p < filelen) {
        if (_is_idcont(load8(filebuf + p)) == 0) { break; }
        p = p + 1;
    }
    var name_end = p;
    var sn_off = filebuf + name_start;
    var sn_len = name_end - name_start;

    while (p < filelen) {
        if (load8(filebuf + p) == 123) { break; }   # '{'
        p = p + 1;
    }
    if (p >= filelen) { return p; }
    p = p + 1;   # past '{'

    # Serialize-derived: <name>_to_json/1 + <name>_from_json/1.
    # Mirrors PP_DERIVE_SERIALIZE in src/frontend/lex_pp.cyr.
    if (want_serialize == 1) {
        _push_synthesized(module_off, module_len, sn_off, sn_len,
                          "_to_json",   0, 0, 1);
        _push_synthesized(module_off, module_len, sn_off, sn_len,
                          "_from_json", 0, 0, 1);
    }

    # Walk fields until `}`. Each field is <name> or
    # <name>: <type>; whitespace and `# comment` lines skipped.
    while (p < filelen) {
        var c2 = load8(filebuf + p);
        if (c2 == 32) { p = p + 1; }
        else { if (c2 == 9)  { p = p + 1; }
            else { if (c2 == 10) { p = p + 1; }
                else { if (c2 == 13) { p = p + 1; }
                    else { if (c2 == 35) {           # '#' — skip to EOL
                            while (p < filelen) {
                                if (load8(filebuf + p) == 10) { break; }
                                p = p + 1;
                            }
                        }
                        else { if (c2 == 125) { p = p + 1; return p; }   # '}'
                            else {
                                if (_is_idstart(c2) == 1) {
                                    var fn_start = p;
                                    p = _scan_id(filebuf, p, filelen);
                                    var fn_end = p;
                                    if (want_accessors == 1) {
                                        _push_synthesized(module_off, module_len,
                                            sn_off, sn_len, "_",
                                            filebuf + fn_start, fn_end - fn_start, 1);
                                        _push_synthesized(module_off, module_len,
                                            sn_off, sn_len, "_set_",
                                            filebuf + fn_start, fn_end - fn_start, 2);
                                    }
                                    # Skip until `;` or `}` (handles `<name>: <type>`).
                                    while (p < filelen) {
                                        var c3 = load8(filebuf + p);
                                        if (c3 == 59) { p = p + 1; break; }
                                        if (c3 == 125) { break; }
                                        p = p + 1;
                                    }
                                } else {
                                    p = p + 1;
                                }
                            }
                        } } } } }
    }
    return p;
}

fn _scan_file(filebuf, filelen, module_off, module_len) {
    var pos = 0;
    var depth = 0;
    var pending_accessors = 0;
    var pending_serialize = 0;
    while (pos < filelen) {
        var line_start = pos;
        var eol = pos;
        while (eol < filelen) {
            if (load8(filebuf + eol) == 10) { break; }
            eol = eol + 1;
        }
        var p = line_start;
        while (p < eol) {
            var c = load8(filebuf + p);
            if (c != 32) { if (c != 9) { break; } }
            p = p + 1;
        }
        if (depth == 0) {
            # v5.9.9: `#derive(accessors)` / `#derive(Serialize)`
            # detection. Sets pending flag(s); the next struct
            # decl consumes them and emits synthesized accessors.
            # Comment / blank lines between the derive line and
            # the struct line are tolerated; any other non-derive
            # line resets the pending flags.
            if (eol - p >= 18) {
                if (memeq(filebuf + p, "#derive(accessors)", 18) == 1) {
                    pending_accessors = 1;
                    pos = eol + 1;
                    continue;
                }
            }
            if (eol - p >= 18) {
                if (memeq(filebuf + p, "#derive(Serialize)", 18) == 1) {
                    pending_serialize = 1;
                    pos = eol + 1;
                    continue;
                }
            }
            if (pending_accessors == 1 || pending_serialize == 1) {
                if (p + 7 <= eol) {
                    if (memeq(filebuf + p, "struct ", 7) == 1) {
                        # Consume the struct + emit synthesized
                        # accessor fns. Update pos to past `}`,
                        # then continue the outer loop's depth-
                        # tracking scan from there.
                        var post = _scan_derive_struct(
                            filebuf, filelen,
                            module_off, module_len,
                            p, pending_accessors, pending_serialize);
                        pending_accessors = 0;
                        pending_serialize = 0;
                        pos = post;
                        # The struct's own `{...}` was consumed by
                        # _scan_derive_struct; depth tracking is
                        # already balanced (we walked the same
                        # bytes the depth tracker would have).
                        continue;
                    }
                }
                # Comment / blank line — keep pending flags.
                if (p == eol) {
                    pos = eol + 1;
                    continue;
                }
                if (load8(filebuf + p) == 35) {   # '#' comment
                    pos = eol + 1;
                    continue;
                }
                # Anything else resets the pending flags.
                pending_accessors = 0;
                pending_serialize = 0;
            }
            if (p + 3 <= eol) {
                if (memeq(filebuf + p, "fn ", 3) == 1) {
                    var np = p + 3;
                    while (np < eol) {
                        var c2 = load8(filebuf + np);
                        if (c2 != 32) { if (c2 != 9) { break; } }
                        np = np + 1;
                    }
                    if (np < eol) {
                        if (_is_idstart(load8(filebuf + np)) == 1) {
                            if (load8(filebuf + np) != 95) {
                                var name_end = _scan_id(filebuf, np, filelen);
                                var paren = name_end;
                                while (paren < eol) {
                                    if (load8(filebuf + paren) == 40) { break; }
                                    paren = paren + 1;
                                }
                                if (paren < eol) {
                                    var rparen = paren + 1;
                                    while (rparen < eol) {
                                        if (load8(filebuf + rparen) == 41) { break; }
                                        rparen = rparen + 1;
                                    }
                                    if (rparen < eol) {
                                        var arity = 0;
                                        var has_arg = 0;
                                        var ai = paren + 1;
                                        while (ai < rparen) {
                                            var c3 = load8(filebuf + ai);
                                            if (c3 != 32) { if (c3 != 9) { has_arg = 1; ai = rparen; } }
                                            ai = ai + 1;
                                        }
                                        if (has_arg == 1) {
                                            arity = 1;
                                            var ci = paren + 1;
                                            while (ci < rparen) {
                                                if (load8(filebuf + ci) == 44) { arity = arity + 1; }
                                                ci = ci + 1;
                                            }
                                        }
                                        _push_entry(module_off, module_len,
                                        filebuf + np, name_end - np, arity);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        # v5.10.16 — skip braces inside string literals, char
        # literals, and `#` comments (matches the cyrlint v5.10.10
        # fix). Pre-fix the byte counter saw `{` inside strings
        # like `"{\"x\":"` as a real opening brace, so depth never
        # returned to 0 after the first JSON-emitting line — every
        # fn / struct decl past that point in the same module was
        # silently dropped from the surface. agnosys 1.1.13 hit
        # this on every hand-rolled `_to_json` shim and read
        # 657 fns instead of 730 (filing
        # 2026-05-09-cyrius-api-surface-putc-brace-desync).
        var bp = line_start;
        while (bp < eol) {
            var bc = load8(filebuf + bp);
            if (bc == 35) {                  # '#' comment to EOL
                bp = eol;
            }
            elif (bc == 34) {                # '"' string literal
                bp = bp + 1;
                while (bp < eol) {
                    if (load8(filebuf + bp) == 92) { bp = bp + 1; }
                    elif (load8(filebuf + bp) == 34) { break; }
                    bp = bp + 1;
                }
                bp = bp + 1;
            }
            elif (bc == 39) {                # '\'' char literal
                bp = bp + 1;
                while (bp < eol) {
                    if (load8(filebuf + bp) == 92) { bp = bp + 1; }
                    elif (load8(filebuf + bp) == 39) { break; }
                    bp = bp + 1;
                }
                bp = bp + 1;
            }
            else {
                if (bc == 123) { depth = depth + 1; }
                if (bc == 125) { depth = depth - 1; }
                bp = bp + 1;
            }
        }
        pos = eol + 1;
    }
    return 0;
}

fn _module_name(filename, len) {
    if (len > 4) {
        if (load8(filename + len - 4) == 46) {
            if (load8(filename + len - 3) == 99) {
                if (load8(filename + len - 2) == 121) {
                    if (load8(filename + len - 1) == 114) {
                        return len - 4;
                    }
                }
            }
        }
    }
    return len;
}

fn _scan_dir(dir_cstr) {
    var dir_str = str_from(dir_cstr);
    var names = dir_list(dir_str);
    if (names == 0) { return 0; }
    var n = vec_len(names);
    var dir_len = strlen(dir_cstr);
    # v6.0.53: per-file read buffer alloc'd ONCE + reused. Was alloc(262144) PER
    # FILE inside the loop — both too small for sigil 3.6.0's 610 KB dist (it
    # truncated mid-file at 256 KB, dropping the tail P-384 fns as false
    # "removed/changed" in the api-surface diff) and ×N-files wasteful. 2 MB
    # handles the largest dep + growth; reused so it doesn't accumulate.
    var filebuf = alloc(2097152);
    var i = 0;
    while (i < n) {
        var fname_str = vec_get(names, i);
        var fname = str_data(fname_str);
        var fname_len = str_len(fname_str);
        if (fname_len > 4) {
            if (load8(fname + fname_len - 4) == 46) {
                if (load8(fname + fname_len - 3) == 99) {
                    if (load8(fname + fname_len - 2) == 121) {
                        if (load8(fname + fname_len - 1) == 114) {
                            var path_buf = alloc(1024);
                            var pi = 0;
                            while (pi < dir_len) { store8(path_buf + pi, load8(dir_cstr + pi)); pi = pi + 1; }
                            store8(path_buf + dir_len, 47);
                            var qi = 0;
                            while (qi < fname_len) { store8(path_buf + dir_len + 1 + qi, load8(fname + qi)); qi = qi + 1; }
                            store8(path_buf + dir_len + 1 + fname_len, 0);
                            var nbytes = file_read_all(path_buf, filebuf, 2097152);
                            if (nbytes > 0) {
                                var module_len = _module_name(fname, fname_len);
                                _scan_file(filebuf, nbytes, fname, module_len);
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn _print_entries(fd) {
    var i = 0;
    while (i < ENTRIES_COUNT) {
        var off = load64(ENTRIES_OFFS + i * 8);
        var len = load64(ENTRIES_LENS + i * 8);
        syscall(SYS_WRITE, fd, ENTRIES_BUF + off, len);
        syscall(SYS_WRITE, fd, "\n", 1);
        i = i + 1;
    }
    return 0;
}

fn _read_snapshot(path) {
    var n = file_read_all(path, SNAPSHOT_BUF, SNAPSHOT_CAP);
    if (n >= SNAPSHOT_CAP) {
        syscall(SYS_WRITE, 2, "error: api-surface snapshot too large to read (raise SNAPSHOT_CAP)\n", 66);
        syscall(60, 3);
    }
    return n;
}

fn _diff_against_snapshot(snapshot_bytes) {
    var s_pos = 0;
    var e_idx = 0;
    var removed_count = 0;
    var added_count = 0;
    while (1 == 1) {
        if (s_pos >= snapshot_bytes) { if (e_idx >= ENTRIES_COUNT) { break; } }
        if (s_pos < snapshot_bytes) {
            var s_eol = s_pos;
            while (s_eol < snapshot_bytes) {
                if (load8(SNAPSHOT_BUF + s_eol) == 10) { break; }
                s_eol = s_eol + 1;
            }
            var s_len = s_eol - s_pos;
            if (e_idx < ENTRIES_COUNT) {
                var e_off = load64(ENTRIES_OFFS + e_idx * 8);
                var e_len = load64(ENTRIES_LENS + e_idx * 8);
                var cmp = 0;
                var min = s_len;
                if (e_len < min) { min = e_len; }
                var k = 0;
                while (k < min) {
                    var sc = load8(SNAPSHOT_BUF + s_pos + k);
                    var ec = load8(ENTRIES_BUF + e_off + k);
                    if (sc < ec) { cmp = 0 - 1; k = min; }
                    elif (sc > ec) { cmp = 1; k = min; }
                    else { k = k + 1; }
                }
                if (cmp == 0) {
                    if (s_len < e_len) { cmp = 0 - 1; }
                    elif (s_len > e_len) { cmp = 1; }
                }
                if (cmp == 0) {
                    s_pos = s_eol + 1;
                    e_idx = e_idx + 1;
                } elif (cmp < 0) {
                    if (removed_count == 0) {
                        # v5.8.44: was 66 — off-by-one included the cstring's
                    # trailing \0 in the syscall length, producing a stray
                    # null byte in the output that the shell flagged as
                    # "ignored null byte in input" on command substitution.
                    syscall(SYS_WRITE, 2, "BREAKING: public fn removed or signature changed since snapshot:\n", 65);
                    }
                    syscall(SYS_WRITE, 2, "  - ", 4);
                    syscall(SYS_WRITE, 2, SNAPSHOT_BUF + s_pos, s_len);
                    syscall(SYS_WRITE, 2, "\n", 1);
                    removed_count = removed_count + 1;
                    s_pos = s_eol + 1;
                } else {
                    added_count = added_count + 1;
                    e_idx = e_idx + 1;
                }
            } else {
                if (removed_count == 0) {
                    # v5.8.44: was 66 — see line 341 for the off-by-one
                    # null-byte fix. Two sites with identical literal.
                    syscall(SYS_WRITE, 2, "BREAKING: public fn removed or signature changed since snapshot:\n", 65);
                }
                syscall(SYS_WRITE, 2, "  - ", 4);
                syscall(SYS_WRITE, 2, SNAPSHOT_BUF + s_pos, s_len);
                syscall(SYS_WRITE, 2, "\n", 1);
                removed_count = removed_count + 1;
                s_pos = s_eol + 1;
            }
        } else {
            added_count = added_count + 1;
            e_idx = e_idx + 1;
        }
    }
    if (removed_count > 0) {
        syscall(SYS_WRITE, 2, "(", 1);
        var nb[24];
        var nl = fmt_int_buf(removed_count, &nb);
        syscall(SYS_WRITE, 2, &nb, nl);
        syscall(SYS_WRITE, 2, " removed; ", 10);
        var nb2[24];
        var nl2 = fmt_int_buf(added_count, &nb2);
        syscall(SYS_WRITE, 2, &nb2, nl2);
        syscall(SYS_WRITE, 2, " added; rerun with --update if intentional API bump)\n", 53);
        return 1;
    }
    if (added_count > 0) {
        syscall(SYS_WRITE, 1, "ok: ", 4);
        var nb3[24];
        var nl3 = fmt_int_buf(ENTRIES_COUNT, &nb3);
        syscall(SYS_WRITE, 1, &nb3, nl3);
        syscall(SYS_WRITE, 1, " public fns, ", 13);
        var nb4[24];
        var nl4 = fmt_int_buf(added_count, &nb4);
        syscall(SYS_WRITE, 1, &nb4, nl4);
        syscall(SYS_WRITE, 1, " added since snapshot (non-breaking)\n", 37);
    } else {
        syscall(SYS_WRITE, 1, "ok: ", 4);
        var nb5[24];
        var nl5 = fmt_int_buf(ENTRIES_COUNT, &nb5);
        syscall(SYS_WRITE, 1, &nb5, nl5);
        syscall(SYS_WRITE, 1, " public fns, surface matches snapshot exactly\n", 46);
    }
    return 0;
}

fn main() {
    alloc_init();
    args_init();

    SNAPSHOT_BUF = alloc(SNAPSHOT_CAP);
    ENTRIES_BUF = alloc(ENTRIES_BUF_CAP);     # 1 MB (was 512 KB); guarded in _push_entry
    ENTRIES_OFFS = alloc(ENTRIES_MAX * 8);    # 16384 slots (was 8192)
    ENTRIES_LENS = alloc(ENTRIES_MAX * 8);

    var update_mode = 0;
    # v5.9.11: --scope=project (agnosys 1.0.11 follow-up review).
    # Default = scan src/ + lib/ (preserves pre-v5.9.11 behavior;
    # cyrius's own snapshot stays self-consistent). With
    # --scope=project, only src/ is scanned; lib/ entries are
    # excluded so downstream consumers (agnosys, cyim, mabda)
    # don't pick up cyrius stdlib fns that churn across cyrius
    # releases. Filing:
    #   agnosys/docs/development/issues/2026-05-06-cyrius-api-surface-derive-blind.md §4
    var scope_project = 0;
    var snapshot_path = DEFAULT_SNAPSHOT;
    var i = 1;
    while (i < argc()) {
        var a = argv(i);
        if (streq(a, "--update") == 1) { update_mode = 1; }
        elif (streq(a, "--scope=project") == 1) { scope_project = 1; }
        elif (streq(a, "--help") == 1) {
            println("Usage: cyrius_api_surface [--update] [--snapshot=PATH] [--scope=project]");
            return 0;
        }
        elif (strlen(a) > 11) {
            if (memeq(a, "--snapshot=", 11) == 1) {
                snapshot_path = a + 11;
            }
        }
        i = i + 1;
    }

    _reset_entries();
    _scan_dir("src");
    if (scope_project == 0) { _scan_dir("lib"); }

    _sort_entries();

    if (update_mode == 1) {
        var fd = file_open(snapshot_path, 0x241, 0x180);
        if (fd < 0) {
            syscall(SYS_WRITE, 2, "error: cannot open snapshot for writing: ", 41);
            syscall(SYS_WRITE, 2, snapshot_path, strlen(snapshot_path));
            syscall(SYS_WRITE, 2, "\n", 1);
            return 1;
        }
        _print_entries(fd);
        file_close(fd);
        syscall(SYS_WRITE, 1, "snapshot updated: ", 18);
        var nb[24];
        var nl = fmt_int_buf(ENTRIES_COUNT, &nb);
        syscall(SYS_WRITE, 1, &nb, nl);
        syscall(SYS_WRITE, 1, " public fns written to ", 23);
        syscall(SYS_WRITE, 1, snapshot_path, strlen(snapshot_path));
        syscall(SYS_WRITE, 1, "\n", 1);
        return 0;
    }

    var snap_bytes = _read_snapshot(snapshot_path);
    if (snap_bytes <= 0) {
        syscall(SYS_WRITE, 2, "snapshot missing: ", 18);
        syscall(SYS_WRITE, 2, snapshot_path, strlen(snapshot_path));
        syscall(SYS_WRITE, 2, "\n  regenerate with: cyrius api-surface --update\n", 48);
        return 1;
    }
    return _diff_against_snapshot(snap_bytes);
}

var r = main();
syscall(SYS_EXIT, r);
