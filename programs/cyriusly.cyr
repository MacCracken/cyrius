# cyriusly.cyr — Cyrius version manager (sovereignty port of scripts/cyriusly).
#
# Yare (adj): quick, agile, responsive — the ship answers the helm.
# Like rustup, pyenv, rbenv: manages installed Cyrius versions.
#
# Sovereignty port pinned at v5.10.36; lands across v5.11.9 + v5.11.10
# per the paired-slot direction. This file is v5.11.9's first
# deliverable — the lighter subcommands (version, list, which, home,
# help). v5.11.10 absorbs `setup` / `install` / `update` (the heavier
# verbs that shell-out via curl / install.sh).

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/args.cyr"
include "lib/process.cyr"

# ----------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------

# CYRIUS_HOME default: $HOME/.cyrius. The shell version honors
# the override env var; the cyrius port does the same.
fn _cyrius_home(): i64 {
    var h = getenv("CYRIUS_HOME");
    if (h != 0 && load8(h) != 0) { return h; }
    var u = getenv("HOME");
    if (u == 0) { return "/root/.cyrius"; }
    # Allocate the joined path "$HOME/.cyrius" + NUL.
    var ulen = strlen(u);
    var out = alloc(ulen + 16);
    memcpy(out, u, ulen);
    store8(out + ulen, 47);                 # '/'
    store8(out + ulen + 1, 46);              # '.'
    memcpy(out + ulen + 2, "cyrius", 6);
    store8(out + ulen + 8, 0);
    return out;
}

# Read $CYRIUS_HOME/current; print "none" if missing.
fn _cyrius_current_into(buf, bufsz): i64 {
    var home = _cyrius_home();
    var pathlen = strlen(home);
    var path = alloc(pathlen + 16);
    memcpy(path, home, pathlen);
    memcpy(path + pathlen, "/current", 8);
    store8(path + pathlen + 8, 0);
    var n = file_read_all(path, buf, bufsz - 1);
    if (n <= 0) {
        memcpy(buf, "none", 4);
        store8(buf + 4, 0);
        return 4;
    }
    # Strip trailing newline / whitespace.
    while (n > 0) {
        var c = load8(buf + n - 1);
        if (c == 10 || c == 13 || c == 32 || c == 9) { n = n - 1; }
        else { break; }
    }
    store8(buf + n, 0);
    return n;
}

# Path join: "${home}/${suffix}" → fresh alloc, NUL-terminated.
fn _path_join(prefix, suffix): i64 {
    var plen = strlen(prefix);
    var slen = strlen(suffix);
    var out = alloc(plen + slen + 2);
    memcpy(out, prefix, plen);
    store8(out + plen, 47);                 # '/'
    memcpy(out + plen + 1, suffix, slen);
    store8(out + plen + 1 + slen, 0);
    return out;
}

# ----------------------------------------------------------------
# Subcommands
# ----------------------------------------------------------------

# `cyriusly version` — print "cyriusly <current>".
fn _cmd_version(): i64 {
    var buf[64];
    _cyrius_current_into(&buf, 64);
    syscall(1, 1, "cyriusly ", 9);
    syscall(1, 1, &buf, strlen(&buf));
    syscall(1, 1, "\n", 1);
    return 0;
}

# `cyriusly list` — list installed versions, mark active with "* ".
fn _cmd_list(): i64 {
    var home = _cyrius_home();
    var versions_dir = _path_join(home, "versions");
    syscall(1, 1, "Installed versions:\n", 20);
    var cur_buf[64];
    _cyrius_current_into(&cur_buf, 64);
    if (is_dir(str_from(versions_dir)) == 0) {
        syscall(1, 1, "  (none — install with `cyriusly install <ver>`)\n", 51);
        return 0;
    }
    var entries = dir_list(str_from(versions_dir));
    var ec = vec_len(entries);
    if (ec == 0) {
        syscall(1, 1, "  (none — install with `cyriusly install <ver>`)\n", 51);
        return 0;
    }
    var i = 0;
    while (i < ec) {
        var entry = vec_get(entries, i);
        var ed = str_data(entry);
        var el = str_len(entry);
        # Compare entry against cur_buf; if match, prepend "  * "
        # else prepend "    ".
        var clen = strlen(&cur_buf);
        var is_match = 0;
        if (clen == el) {
            is_match = memeq(ed, &cur_buf, el);
        }
        if (is_match == 1) {
            syscall(1, 1, "  * ", 4);
            syscall(1, 1, ed, el);
            syscall(1, 1, " (active)\n", 10);
        } else {
            syscall(1, 1, "    ", 4);
            syscall(1, 1, ed, el);
            syscall(1, 1, "\n", 1);
        }
        i = i + 1;
    }
    return 0;
}

# `cyriusly which` — print path to active compiler.
fn _cmd_which(): i64 {
    var home = _cyrius_home();
    var binpath = _path_join(home, "bin/cycc");
    syscall(1, 1, binpath, strlen(binpath));
    syscall(1, 1, "\n", 1);
    return 0;
}

# `cyriusly home` — print install directory.
fn _cmd_home(): i64 {
    var home = _cyrius_home();
    syscall(1, 1, home, strlen(home));
    syscall(1, 1, "\n", 1);
    return 0;
}

# `cyriusly help` — usage text.
fn _cmd_help(): i64 {
    syscall(1, 1, "cyriusly — Cyrius version manager\n\n", 37);
    syscall(1, 1, "USAGE:\n", 7);
    syscall(1, 1, "    cyriusly <command> [args]\n\n", 31);
    syscall(1, 1, "COMMANDS:\n", 10);
    syscall(1, 1, "    version            Show active version\n", 43);
    syscall(1, 1, "    list               List installed versions\n", 47);
    syscall(1, 1, "    use <version>      Switch to a version\n", 43);
    syscall(1, 1, "    install <version>  Download and install\n", 44);
    syscall(1, 1, "    setup              Install from current repo checkout\n", 58);
    syscall(1, 1, "    uninstall <ver>    Remove a version\n", 40);
    syscall(1, 1, "    update             Check for new versions\n", 46);
    syscall(1, 1, "    which              Show path to active compiler\n", 52);
    syscall(1, 1, "    home               Show install directory\n", 46);
    syscall(1, 1, "    cmdtools [action]  Manage prompt integrations\n", 50);
    syscall(1, 1, "    help               Show this help\n", 38);
    return 0;
}

# v5.11.26: rewrite cyrius.cyml's `[package].cyrius = "..."` field.
# Reads file, locates [package] section, replaces existing `cyrius`
# field value OR appends one if absent. Returns 0 on success, 1 on
# error. Format-preserving: only touches the field's value line.
fn _write_cyml_cyrius_pin(ver_cstr): i64 {
    var vlen = strlen(ver_cstr);
    # v6.6.6: the WHOLE manifest, however large. This was `alloc(65536)` + a 65535-byte
    # file_read_all, and the edited buffer is written BACK — so a bigger cyrius.cyml came out
    # truncated at 65,535 bytes, cut mid-line, while `use` printed "Pinned" and exited 0.
    # Measured: a 144,090-byte manifest lost 78,555 bytes. CHANGELOG [6.6.6]
    var n = 0;
    var buf = file_read_whole("cyrius.cyml", &n);
    if (buf == 0 || n <= 0) {
        syscall(1, 2, "error: failed to read cyrius.cyml\n", 34);
        return 1;
    }

    # Locate [package] header.
    var pkg_pos = 0;
    while (pkg_pos < n) {
        if (memeq(buf + pkg_pos, "[package]", 9) == 1) { break; }
        pkg_pos = pkg_pos + 1;
    }
    if (pkg_pos >= n) {
        syscall(1, 2, "error: cyrius.cyml has no [package] section\n", 44);
        return 1;
    }
    # Skip to end of [package] header line.
    var scan = pkg_pos + 9;
    while (scan < n && load8(buf + scan) != 10) { scan = scan + 1; }
    if (scan < n) { scan = scan + 1; }
    var pkg_body_start = scan;

    # Walk lines until next section header (`[` at line start) or EOF.
    # Look for existing `cyrius = "..."` line.
    var existing_line_start = 0 - 1;
    var existing_line_end = 0 - 1;
    var p = pkg_body_start;
    while (p < n) {
        # Skip leading whitespace within line for `[` check.
        var ls = p;
        while (ls < n && (load8(buf + ls) == 32 || load8(buf + ls) == 9)) { ls = ls + 1; }
        if (load8(buf + ls) == 91) { break; }   # `[` → next section
        # `cyrius` field?
        if (memeq(buf + ls, "cyrius", 6) == 1) {
            var after = ls + 6;
            while (after < n && (load8(buf + after) == 32 || load8(buf + after) == 9)) {
                after = after + 1;
            }
            if (after < n && load8(buf + after) == 61) {
                existing_line_start = p;
                # Find end of line.
                var le = p;
                while (le < n && load8(buf + le) != 10) { le = le + 1; }
                existing_line_end = le;
            }
        }
        # Skip to end of line.
        while (p < n && load8(buf + p) != 10) { p = p + 1; }
        if (p < n) { p = p + 1; }
    }

    # Build the new line: `cyrius = "X.Y.Z"\n`.
    var new_line_len = 11 + vlen + 2;  # `cyrius = "` (10) + value + `"\n` (2) — actually 10+vlen+2
    var new_line = alloc(new_line_len + 1);
    memcpy(new_line, "cyrius = \"", 10);
    memcpy(new_line + 10, ver_cstr, vlen);
    store8(new_line + 10 + vlen, 34);   # `"`
    store8(new_line + 10 + vlen + 1, 10);  # `\n`
    store8(new_line + 10 + vlen + 2, 0);
    var new_line_bytes = 10 + vlen + 2;

    # Build output buffer.
    var out = alloc(n + new_line_bytes + 4);
    var out_n = 0;
    if (existing_line_start >= 0) {
        # Replace: copy [0..start), new_line, [end..n)
        memcpy(out, buf, existing_line_start);
        out_n = existing_line_start;
        memcpy(out + out_n, new_line, new_line_bytes);
        out_n = out_n + new_line_bytes;
        var rest = n - existing_line_end - 1;
        if (existing_line_end + 1 < n) {
            memcpy(out + out_n, buf + existing_line_end + 1, rest);
            out_n = out_n + rest;
        }
    } else {
        # Insert at top of [package] body. Copy [0..pkg_body_start),
        # new_line, [pkg_body_start..n).
        memcpy(out, buf, pkg_body_start);
        out_n = pkg_body_start;
        memcpy(out + out_n, new_line, new_line_bytes);
        out_n = out_n + new_line_bytes;
        var rest2 = n - pkg_body_start;
        memcpy(out + out_n, buf + pkg_body_start, rest2);
        out_n = out_n + rest2;
    }
    store8(out + out_n, 0);

    # v6.6.6: the user's manifest is replaced crash-safe and the write is CHECKED — this was an
    # unchecked file_write_all, so a full disk truncated cyrius.cyml and `use` still said it
    # worked. CHANGELOG [6.6.6]
    if (file_replace_atomic("cyrius.cyml", out, out_n) != 0) {
        syscall(1, 2, "error: failed to write cyrius.cyml (left as it was)\n", 52);
        return 1;
    }
    return 0;
}

# v5.11.26: `cyriusly use` with no version → print resolved version
# + source (cyml-pinned / global / latest fallback). Pairs with the
# v5.11.25 dispatcher: tells the user which version a `cyrius` in
# this cwd would actually use.
fn _print_resolved_version(): i64 {
    if (file_exists("cyrius.cyml") == 1) {
        # Reuse _dep_read_cyml_cyrius_field's logic inline — small.
        # v6.6.6: the WHOLE manifest (was a 65535-byte cap): a `[package]` section past the cap
        # was invisible, so `cyriusly use` with no argument reported the GLOBAL default for a
        # repo that is in fact pinned. CHANGELOG [6.6.6]
        var n = 0;
        var buf = file_read_whole("cyrius.cyml", &n);
        if (buf != 0 && n > 0) {
            var p = 0;
            while (p < n) {
                if (memeq(buf + p, "[package]", 9) == 1) { break; }
                p = p + 1;
            }
            if (p < n) {
                p = p + 9;
                while (p < n) {
                    while (p < n && (load8(buf + p) == 10 || load8(buf + p) == 32 || load8(buf + p) == 9)) {
                        p = p + 1;
                    }
                    if (p >= n) { break; }
                    if (load8(buf + p) == 91) { break; }
                    if (memeq(buf + p, "cyrius", 6) == 1) {
                        var a = p + 6;
                        while (a < n && (load8(buf + a) == 32 || load8(buf + a) == 9)) { a = a + 1; }
                        if (a < n && load8(buf + a) == 61) {
                            a = a + 1;
                            while (a < n && (load8(buf + a) == 32 || load8(buf + a) == 9)) { a = a + 1; }
                            if (a < n && load8(buf + a) == 34) {
                                a = a + 1;
                                var vs = a;
                                while (a < n && load8(buf + a) != 34) { a = a + 1; }
                                syscall(1, 1, "cyrius ", 7);
                                syscall(1, 1, buf + vs, a - vs);
                                syscall(1, 1, " (pinned in cyrius.cyml)\n", 25);
                                return 0;
                            }
                        }
                    }
                    while (p < n && load8(buf + p) != 10) { p = p + 1; }
                }
            }
        }
    }
    # Fall back to global current.
    var cbuf[64];
    _cyrius_current_into(&cbuf, 64);
    syscall(1, 1, "cyrius ", 7);
    syscall(1, 1, &cbuf, strlen(&cbuf));
    syscall(1, 1, " (~/.cyrius/current — global default)\n", 40);
    return 0;
}

# ── v6.6.6: an ATOMIC `~/.cyrius/{bin,lib}` switch. CHANGELOG [6.6.6]
#
# ⛔ WHAT WAS WRONG: `sys_unlink(bin_link); sys_unlink(lib_link); sys_symlink(...);
# sys_symlink(...)` with not one return value checked, then "Now using". Three failures in one
# sequence: (a) between the unlink and the symlink ~/.cyrius/bin does not EXIST, so anything
# that fails there (ENOSPC, a concurrent `cyriusly use`, a kill) leaves the user with no
# toolchain at all; (b) a failed symlink was reported as SUCCESS; (c) the two links are switched
# independently, so one succeeding and the other failing leaves new binaries over an old stdlib.
# Measured: with `bin` an ordinary directory (an older install) `use 9.9.9 --global` printed "Now
# using Cyrius 9.9.9" and exited 0 while `bin` still held the old files.
#
# ⭐ THE FIX IS rename(), NOT A CHECK ROUND unlink+symlink. A checked unlink+symlink still has
# window (a), because the check comes after the damage. `symlink()` cannot replace an existing
# entry, but `rename()` can and does so in ONE step, so the link is never absent and a failure
# leaves it EXACTLY as it was — including when it is a directory, where the rename fails EISDIR
# instead of the old sequence silently doing nothing and claiming success.

# Point `link_path` at `target` atomically. Returns 0, or a negative errno.
fn _relink_atomic(link_path, target): i64 {
    var tmp = _io_tmp_name(link_path);     # "<link>.cyrtmp.<pid>.<ctr>" — a unique sibling
    sys_unlink(tmp);                       # a leftover from a killed run
    var r = sys_symlink(target, tmp);
    if (r < 0) { return r; }
    var rr = file_rename(tmp, link_path);
    if (rr < 0) { sys_unlink(tmp); return rr; }
    return 0;
}

# The target `path` currently names, NUL-terminated, or 0 when it is not a symlink. Read
# BEFORE the switch so a half-applied switch can be rolled back to what the user had.
fn _link_target_dup(path): i64 {
    var b = alloc(4097);
    var n = xreadlink(path, b, 4096);
    if (n <= 0) { return 0; }
    store8(b + n, 0);
    return b;
}

# Put a link back the way it was after a failed switch. `old_target` is what it named before
# (0 when it was not a symlink at all — including the fresh-install case). Returns 1 when the
# link is EXACTLY as the user had it, 0 when something was left behind.
#
# ⛔ v6.6.6 — WHY THE 0 CASE IS NOT A NO-OP. The rollbacks were `if (old_bin != 0) {
# _relink_atomic(...); }`, and `_use_switch_err` ended every message with "nothing was changed".
# On a FRESH install there is no previous target, so the guard skipped the rollback and the link
# this command had just created stayed — while the tool said nothing had changed, in exactly the
# state a user would act on. Nothing there before means nothing there after. The link is removed
# only when it is still the one we made: a concurrent `cyriusly use` may own it now, and
# deleting someone else's switch would be a worse lie than the message. CHANGELOG [6.6.6]
fn _undo_relink(link_path, old_target, new_target): i64 {
    if (old_target != 0) {
        if (_relink_atomic(link_path, old_target) < 0) { return 0; }
        return 1;
    }
    var cur = _link_target_dup(link_path);
    if (cur == 0) { return 1; }                     # already nothing — as it was
    if (streq(cur, new_target) == 0) { return 0; }  # not ours; leave it and say so
    if (sys_unlink(link_path) < 0) { return 0; }
    return 1;
}

# Report a failed switch on stderr: what could not be done, the errno, and whether the user is
# back where they started. `undone` is 1 only when every step that landed was taken back —
# saying "nothing was changed" over a link this command created is the lie this argument exists
# to prevent. CHANGELOG [6.6.6]
fn _use_switch_err(what, path, err, undone): i64 {
    syscall(1, 2, "error: could not ", 17);
    syscall(1, 2, what, strlen(what));
    syscall(1, 2, " ", 1);
    syscall(1, 2, path, strlen(path));
    syscall(1, 2, " (errno ", 8);
    fmt_int_fd(2, 0 - err);
    var tail = " — WARNING: the switch is half-applied; re-run `cyriusly use <version> --global`\n";
    if (undone == 1) { tail = " — nothing was changed\n"; }
    syscall(1, 2, ")", 1);
    syscall(1, 2, tail, strlen(tail));
    return 1;
}

# v5.11.26: `cyriusly use [<ver> [--global]]` — switch the active
# toolchain. Pre-v5.11.26 always wrote `~/.cyrius/current` (global);
# now defaults to writing `cyrius.cyml`'s `[package].cyrius` field
# (per-repo). `--global` keeps the legacy global-write behavior.
# No args → print the resolved version + source.
fn _cmd_use_v2(ver_cstr, is_global): i64 {
    if (ver_cstr == 0) {
        return _print_resolved_version();
    }
    if (load8(ver_cstr) == 0) {
        return _print_resolved_version();
    }

    var home = _cyrius_home();
    var hlen = strlen(home);
    var vlen = strlen(ver_cstr);
    var ver_dir = alloc(hlen + 11 + vlen + 1);
    memcpy(ver_dir, home, hlen);
    memcpy(ver_dir + hlen, "/versions/", 10);
    memcpy(ver_dir + hlen + 10, ver_cstr, vlen);
    store8(ver_dir + hlen + 10 + vlen, 0);
    if (is_dir(str_from(ver_dir)) == 0) {
        syscall(1, 2, "error: cyrius ", 14);
        syscall(1, 2, ver_cstr, vlen);
        syscall(1, 2, " not installed.\n  run: cyriusly install ", 40);
        syscall(1, 2, ver_cstr, vlen);
        syscall(1, 2, "\n", 1);
        return 1;
    }

    if (is_global == 0) {
        # Per-repo default — write cyrius.cyml's [package].cyrius field.
        if (file_exists("cyrius.cyml") == 0) {
            syscall(1, 2, "error: no cyrius.cyml in this directory.\n", 41);
            syscall(1, 2, "  cd to a project root, or pass --global to set the global toolchain default.\n", 78);
            return 1;
        }
        var rc = _write_cyml_cyrius_pin(ver_cstr);
        if (rc != 0) { return rc; }
        syscall(1, 1, "Pinned cyrius.cyml to ", 22);
        syscall(1, 1, ver_cstr, vlen);
        syscall(1, 1, "\n", 1);
        return 0;
    }

    # --global: legacy behavior. Re-point ~/.cyrius/{bin,lib} at versions/<ver>/{bin,lib},
    # then write ~/.cyrius/current. v6.6.6: every step is atomic AND checked, and the ORDER is
    # links-then-`current` — `current` is what names the version the links serve, so writing it
    # first (as this did) published a version the links might never reach. CHANGELOG [6.6.6]
    var current_path = _path_join(home, "current");
    var content = alloc(vlen + 2);
    memcpy(content, ver_cstr, vlen);
    store8(content + vlen, 10);
    store8(content + vlen + 1, 0);
    var bin_link = _path_join(home, "bin");
    var lib_link = _path_join(home, "lib");
    var ver_bin = alloc(hlen + 11 + vlen + 5);
    memcpy(ver_bin, ver_dir, hlen + 10 + vlen);
    memcpy(ver_bin + hlen + 10 + vlen, "/bin", 4);
    store8(ver_bin + hlen + 10 + vlen + 4, 0);
    var ver_lib = alloc(hlen + 11 + vlen + 5);
    memcpy(ver_lib, ver_dir, hlen + 10 + vlen);
    memcpy(ver_lib + hlen + 10 + vlen, "/lib", 4);
    store8(ver_lib + hlen + 10 + vlen + 4, 0);
    # What the user has NOW, so a switch that fails half way is rolled back to it.
    var old_bin = _link_target_dup(bin_link);
    var old_lib = _link_target_dup(lib_link);
    var rb = _relink_atomic(bin_link, ver_bin);
    # nothing has landed yet, so the user really is untouched here
    if (rb < 0) { return _use_switch_err("re-point", bin_link, rb, 1); }
    var rl = _relink_atomic(lib_link, ver_lib);
    if (rl < 0) {
        var ub = _undo_relink(bin_link, old_bin, ver_bin);
        return _use_switch_err("re-point", lib_link, rl, ub);
    }
    var rc_cur = file_write_atomic(current_path, content, vlen + 1);
    if (rc_cur != 0) {
        var ul2 = _undo_relink(lib_link, old_lib, ver_lib);
        var ub2 = _undo_relink(bin_link, old_bin, ver_bin);
        var both = 0;
        if (ul2 == 1 && ub2 == 1) { both = 1; }
        return _use_switch_err("write", current_path, rc_cur, both);
    }
    syscall(1, 1, "Now using Cyrius ", 17);
    syscall(1, 1, ver_cstr, vlen);
    syscall(1, 1, " (--global; ~/.cyrius/current + symlinks updated)\n", 50);
    return 0;
}

# Legacy entry. Kept for callers that might still invoke the 1-arg
# shape; routes to v2 with is_global=1 (preserves pre-v5.11.26
# behavior — no surprise in-place semantic flip when called
# without the new flag awareness).
fn _cmd_use(ver_cstr): i64 {
    return _cmd_use_v2(ver_cstr, 1);
}

# Shell-out helper for verbs that wrap OS tools (curl, sh, rm).
# Builds an argv vec from cstr literals + caller args and calls
# exec_vec from lib/process.cyr.
fn _exec_shell(cmd_line): i64 {
    return exec_cmd(cmd_line);
}

# `cyriusly uninstall <ver>` — remove a version directory.
# Recursive rm via `rm -rf` shell-out (rmdir-walk is future work).
fn _cmd_uninstall(ver_cstr): i64 {
    if (ver_cstr == 0) {
        syscall(1, 2, "Usage: cyriusly uninstall <version>\n", 36);
        return 1;
    }
    if (load8(ver_cstr) == 0) {
        syscall(1, 2, "Usage: cyriusly uninstall <version>\n", 36);
        return 1;
    }
    # Safety: refuse if active version
    var cur_buf[64];
    _cyrius_current_into(&cur_buf, 64);
    var clen = strlen(&cur_buf);
    var vlen = strlen(ver_cstr);
    if (clen == vlen) {
        if (memeq(&cur_buf, ver_cstr, vlen) == 1) {
            syscall(1, 2, "Cannot uninstall active version. Switch first: cyriusly use <other>\n", 68);
            return 1;
        }
    }
    var home = _cyrius_home();
    var hlen = strlen(home);
    var ver_dir = alloc(hlen + 11 + vlen + 1);
    memcpy(ver_dir, home, hlen);
    memcpy(ver_dir + hlen, "/versions/", 10);
    memcpy(ver_dir + hlen + 10, ver_cstr, vlen);
    store8(ver_dir + hlen + 10 + vlen, 0);
    if (is_dir(str_from(ver_dir)) == 0) {
        syscall(1, 1, "Version ", 8);
        syscall(1, 1, ver_cstr, vlen);
        syscall(1, 1, " not installed.\n", 16);
        return 0;
    }
    # Shell out for recursive rm (native recursive-rm helper is future
    # work — file walk + sys_unlink + sys_rmdir is straightforward but
    # not the highest-priority next port). Build "rm -rf <path>" and exec.
    var cmd = alloc(hlen + vlen + 32);
    memcpy(cmd, "rm -rf ", 7);
    memcpy(cmd + 7, ver_dir, hlen + 10 + vlen);
    store8(cmd + 7 + hlen + 10 + vlen, 0);
    var rc = _exec_shell(cmd);
    if (rc != 0) {
        syscall(1, 2, "error: rm -rf failed\n", 21);
        return 1;
    }
    syscall(1, 1, "Uninstalled Cyrius ", 19);
    syscall(1, 1, ver_cstr, vlen);
    syscall(1, 1, "\n", 1);
    return 0;
}

# `cyriusly install <ver>` — shell out to curl + install.sh.
# Native curl + cyml resolve is future work; for now this is a
# thin transparent wrapper around the existing shell flow.
fn _cmd_install(ver_cstr): i64 {
    if (ver_cstr == 0) {
        syscall(1, 2, "Usage: cyriusly install <version>\n", 34);
        return 1;
    }
    if (load8(ver_cstr) == 0) {
        syscall(1, 2, "Usage: cyriusly install <version>\n", 34);
        return 1;
    }
    var vlen = strlen(ver_cstr);
    syscall(1, 1, "Installing Cyrius ", 18);
    syscall(1, 1, ver_cstr, vlen);
    syscall(1, 1, "...\n", 4);
    # Build: curl -sSf URL | CYRIUS_VERSION=<ver> sh
    var cmd_pre = "curl -sSf https://raw.githubusercontent.com/MacCracken/cyrius/main/scripts/install.sh | CYRIUS_VERSION=";
    var pre_len = strlen(cmd_pre);
    var cmd_suf = " sh";
    var cmd = alloc(pre_len + vlen + 4);
    memcpy(cmd, cmd_pre, pre_len);
    memcpy(cmd + pre_len, ver_cstr, vlen);
    memcpy(cmd + pre_len + vlen, " sh", 3);
    store8(cmd + pre_len + vlen + 3, 0);
    return _exec_shell(cmd);
}

# `cyriusly update` — check GitHub releases API for latest tag.
fn _cmd_update(): i64 {
    syscall(1, 1, "Checking for updates...\n", 24);
    # Shell-out: curl GitHub releases API + grep tag_name. Plain JSON
    # parsing in cyrius is doable (lib/json.cyr) but for v5.11.10's
    # port-closeout slot, the cmdline pipeline is the pragmatic shape.
    var cmd = "LATEST=$(curl -sSf https://api.github.com/repos/MacCracken/cyrius/releases/latest 2>/dev/null | grep '\"tag_name\"' | sed 's/.*\"tag_name\": *\"\\([^\"]*\\)\".*/\\1/'); CUR=$(cat ~/.cyrius/current 2>/dev/null || echo none); if [ -z \"$LATEST\" ]; then echo 'Could not check for updates.'; elif [ \"$LATEST\" = \"$CUR\" ]; then echo \"Already up to date: $CUR\"; else echo \"Update available: $CUR -> $LATEST\"; echo \"Run: cyriusly install $LATEST && cyriusly use $LATEST\"; fi";
    return _exec_shell(cmd);
}

# `cyriusly setup` — install from current repo checkout.
# Heaviest verb: bootstraps cycc if missing, parses cyrius.cyml
# [release] section, builds release bins, then runs
# `sh scripts/install.sh --refresh-only`. The native port of
# the cyml [release] parsing is future work — for v5.11.10 this
# shells out to bash equivalents.
# v6.6.4: a checkout whose VERSION is a CUT RELEASE (tag exists) but whose tree has moved
# past the tag is REFUSED by install.sh unless the checkout is at the tag — installing
# in-progress content under a released name is what corrupted the 6.6.1/6.6.2 slots.
# Check out the tag, or bump VERSION, or use a throwaway CYRIUS_HOME.
fn _cmd_setup(): i64 {
    # Sanity check: must run from repo checkout.
    if (file_exists("VERSION") == 0) {
        syscall(1, 2, "error: cyriusly setup must run from a Cyrius repo checkout\n", 59);
        return 1;
    }
    if (file_exists("cyrius.cyml") == 0) {
        syscall(1, 2, "error: cyrius.cyml not found in cwd\n", 36);
        return 1;
    }
    if (file_exists("scripts/install.sh") == 0) {
        syscall(1, 2, "error: scripts/install.sh not found in cwd\n", 43);
        return 1;
    }
    # Bootstrap if needed.
    if (file_exists("build/cycc") == 0) {
        syscall(1, 1, "  build/cycc not found — running bootstrap/bootstrap.sh...\n", 61);
        var bs_rc = _exec_shell("sh bootstrap/bootstrap.sh");
        if (bs_rc != 0) {
            syscall(1, 2, "error: bootstrap failed\n", 24);
            return 1;
        }
    }
    # Build any missing release tools. The cyml parser shells out
    # to awk for the [release] section extraction — native cyml
    # parsing via lib/cyml.cyr is doable but the awk one-liner is
    # already proven in scripts/cyriusly:101.
    syscall(1, 1, "  building release tools...\n", 28);
    var build_cmd = "BINS=$(awk '/^\\[release\\]/{r=1;next} r&&/^\\[/{exit} r&&$1==\"bins\"{sub(/^[^=]+= \\[/,\"\");sub(/\\].*$/,\"\");gsub(/[\",]/,\" \");print;exit}' cyrius.cyml); CROSS=$(awk '/^\\[release\\]/{r=1;next} r&&/^\\[/{exit} r&&$1==\"cross_bins\"{sub(/^[^=]+= \\[/,\"\");sub(/\\].*$/,\"\");gsub(/[\",]/,\" \");print;exit}' cyrius.cyml); built=0; for t in $BINS; do [ \"$t\" = cycc ] && continue; [ -x \"build/$t\" ] && continue; if [ \"$t\" = cyrius ] && [ -f cbt/cyrius.cyr ]; then cat cbt/cyrius.cyr | ./build/cycc > build/$t && chmod +x build/$t && built=$((built+1)); elif [ -f programs/$t.cyr ]; then cat programs/$t.cyr | ./build/cycc > build/$t && chmod +x build/$t && built=$((built+1)); fi; done; for t in $CROSS; do [ -x \"build/$t\" ] && continue; arch=${t#cc5_}; if [ -f src/main_$arch.cyr ]; then cat src/main_$arch.cyr | ./build/cycc > build/$t && chmod +x build/$t && built=$((built+1)); fi; done; echo \"  built $built tool(s)\"";
    _exec_shell(build_cmd);
    # Delegate the snapshot install to install.sh --refresh-only.
    syscall(1, 1, "  refreshing install snapshot...\n", 33);
    var refresh_rc = _exec_shell("sh scripts/install.sh --refresh-only");
    if (refresh_rc != 0) {
        syscall(1, 2, "error: install.sh --refresh-only failed\n", 40);
        return 1;
    }
    var vbuf[64];
    var vn = file_read_all("VERSION", &vbuf, 63);
    while (vn > 0) {
        var ch = load8(&vbuf + vn - 1);
        if (ch == 10 || ch == 13 || ch == 32 || ch == 9) { vn = vn - 1; }
        else { break; }
    }
    store8(&vbuf + vn, 0);
    syscall(1, 1, "\nDone. Cyrius ", 14);
    syscall(1, 1, &vbuf, vn);
    syscall(1, 1, " installed from local checkout.\n", 32);
    return 0;
}

# `cyriusly cmdtools [action] [tool]` — manage starship/p10k integrations.
# Defers to scripts/cyriusly cmdtools because the verb has substantial
# shell-side state (heredoc'd starship/p10k config blocks). Native port
# is a v5.11.x or v6.x slot in its own right; for this closeout we
# delegate transparently so users get a unified entry point.
fn _cmd_cmdtools(action_cstr, tool_cstr): i64 {
    var cmd_pre = "sh scripts/cyriusly cmdtools";
    var pre_len = strlen(cmd_pre);
    var alen = 0;
    var tlen = 0;
    if (action_cstr != 0) { alen = strlen(action_cstr); }
    if (tool_cstr != 0)   { tlen = strlen(tool_cstr); }
    var cmd = alloc(pre_len + alen + tlen + 4);
    memcpy(cmd, cmd_pre, pre_len);
    var off = pre_len;
    if (alen > 0) {
        store8(cmd + off, 32);
        memcpy(cmd + off + 1, action_cstr, alen);
        off = off + 1 + alen;
    }
    if (tlen > 0) {
        store8(cmd + off, 32);
        memcpy(cmd + off + 1, tool_cstr, tlen);
        off = off + 1 + tlen;
    }
    store8(cmd + off, 0);
    return _exec_shell(cmd);
}

# ----------------------------------------------------------------
# The argument rule (v6.6.5) — same as cbt/cli_args.cyr, scaled to this binary.
# ----------------------------------------------------------------
#
# ⛔ cyriusly is one of the `[release].bins` (cyrius.cyml:23) and is installed by
# scripts/install.sh, and it carried the WHOLE defect family this release removes.
# Measured at 6.6.5 before this block existed:
#   `cyriusly use 6.6.4 --globl`   — the typo was silently DROPPED and the LOCAL-pin
#                                    path taken (the filed shape, verbatim: you ask
#                                    for a global switch and get a local one, exit 0)
#   `cyriusly use --globl 6.6.4`   — the flag became the VERSION
#   `cyriusly install --dry-run`   — started a REAL install of a version literally
#                                    named `--dry-run`, leaving `versions/--dry-run`
#                                    behind: SILENT *and* MUTATING
#   `cyriusly uninstall --bogus`   — exit 0
#   `cyriusly which a b`, `list --bogus` — extras dropped
#
# The rule: flags may appear in any position, a `-`-prefixed token the verb does not
# declare is an error that NAMES it, and operand counts are enforced — an operand the
# verb will not act on is REJECTED, never dropped. CHANGELOG [6.6.5].
var _cy_pos = 0;
var _cy_global = 0;

# `<prefix>'<tok>'` + newline on stderr. The token is always NAMED — an error that
# does not say which argument it means is barely better than dropping it.
fn _cy_err_tok(prefix, tok): i64 {
    syscall(1, 2, prefix, strlen(prefix));
    syscall(1, 2, "'", 1);
    syscall(1, 2, tok, strlen(tok));
    syscall(1, 2, "'\n", 2);
    return 0;
}

# Scan argv[2..]: collect positionals, accept `--global` only when `want_global`,
# reject every other '-' token by name. Returns 0 on error.
fn _cy_scan(cmd, want_global): i64 {
    _cy_pos = vec_new();
    _cy_global = 0;
    var i = 2;
    while (i < argc()) {
        var a = argv(i);
        if (load8(a) == 45) {
            if (want_global == 1 && streq(a, "--global") == 1) { _cy_global = 1; }
            else {
                _cy_err_tok("cyriusly: unknown option ", a);
                var uh = "run 'cyriusly help' for usage.\n";
                syscall(1, 2, uh, strlen(uh));
                return 0;
            }
        } else { vec_push(_cy_pos, a); }
        i = i + 1;
    }
    return 1;
}

# Enforce the operand count. `max` < 0 means unbounded.
fn _cy_count_ok(cmd, min, max): i64 {
    var n = vec_len(_cy_pos);
    if (n < min) {
        _cy_err_tok("cyriusly: missing required argument for ", cmd);
        return 0;
    }
    if (max >= 0 && n > max) {
        _cy_err_tok("cyriusly: unexpected extra argument ", vec_get(_cy_pos, max));
        return 0;
    }
    return 1;
}

# Scan + count in one call — every verb below goes through exactly this.
fn _cy_args_ok(cmd, min, max, want_global): i64 {
    if (_cy_scan(cmd, want_global) == 0) { return 0; }
    return _cy_count_ok(cmd, min, max);
}

# Operand `i`, or 0 when it was not given.
fn _cy_at(i): i64 {
    if (i >= vec_len(_cy_pos)) { return 0; }
    return vec_get(_cy_pos, i);
}

# Is `cmd` a verb this binary dispatches? The single source of truth for the
# dispatcher below — `help` is handled ahead of it (it takes anything).
fn _cyl_known_cmd(cmd): i64 {
    if (streq(cmd, "version") == 1) { return 1; }
    if (streq(cmd, "--version") == 1) { return 1; }
    if (streq(cmd, "-v") == 1) { return 1; }
    if (streq(cmd, "list") == 1) { return 1; }
    if (streq(cmd, "ls") == 1) { return 1; }
    if (streq(cmd, "which") == 1) { return 1; }
    if (streq(cmd, "home") == 1) { return 1; }
    if (streq(cmd, "use") == 1) { return 1; }
    if (streq(cmd, "install") == 1) { return 1; }
    if (streq(cmd, "uninstall") == 1) { return 1; }
    if (streq(cmd, "update") == 1) { return 1; }
    if (streq(cmd, "setup") == 1) { return 1; }
    if (streq(cmd, "cmdtools") == 1) { return 1; }
    return 0;
}

# ----------------------------------------------------------------
# Dispatcher — argv[1] selects the subcommand.
# ----------------------------------------------------------------

fn main(): i64 {
    args_init();
    var ac = argc();
    if (ac < 2) { return _cmd_help(); }
    var cmd = argv(1);

    # help takes anything and prints usage — checked first so `cyriusly help --x`
    # still helps rather than erroring about `--x`.
    if (streq(cmd, "help") == 1) { return _cmd_help(); }
    if (streq(cmd, "--help") == 1) { return _cmd_help(); }
    if (streq(cmd, "-h") == 1) { return _cmd_help(); }

    # v6.6.5 — the verb NAME first, then its arguments: an unknown command with an
    # argument must say "unknown command", not complain about the operand count of a
    # command that does not exist (the ark lesson, same release).
    if (_cyl_known_cmd(cmd) == 0) {
        syscall(1, 2, "Unknown command: ", 17);
        syscall(1, 2, cmd, strlen(cmd));
        syscall(1, 2, "\n", 1);
        syscall(1, 2, "Run 'cyriusly help' for usage.\n", 31);
        return 1;
    }

    # -- zero-operand verbs --
    if (streq(cmd, "version") == 1 || streq(cmd, "--version") == 1 || streq(cmd, "-v") == 1) {
        if (_cy_args_ok(cmd, 0, 0, 0) == 0) { return 1; }
        return _cmd_version();
    }
    if (streq(cmd, "list") == 1 || streq(cmd, "ls") == 1) {
        if (_cy_args_ok(cmd, 0, 0, 0) == 0) { return 1; }
        return _cmd_list();
    }
    if (streq(cmd, "which") == 1) {
        if (_cy_args_ok(cmd, 0, 0, 0) == 0) { return 1; }
        return _cmd_which();
    }
    if (streq(cmd, "home") == 1) {
        if (_cy_args_ok(cmd, 0, 0, 0) == 0) { return 1; }
        return _cmd_home();
    }
    if (streq(cmd, "update") == 1) {
        if (_cy_args_ok(cmd, 0, 0, 0) == 0) { return 1; }
        return _cmd_update();
    }
    if (streq(cmd, "setup") == 1) {
        if (_cy_args_ok(cmd, 0, 0, 0) == 0) { return 1; }
        return _cmd_setup();
    }

    # -- use [<ver>] [--global] — the FILED SHAPE --
    # `--global` is the ONE flag this binary declares, and it is honoured in either
    # position. A misspelling is now named instead of being dropped into the
    # local-pin path.
    if (streq(cmd, "use") == 1) {
        if (_cy_args_ok(cmd, 0, 1, 1) == 0) { return 1; }
        # `use --global` with no version used to print the resolved version and drop the
        # flag — there is nothing to switch globally TO. Named, not ignored.
        if (_cy_global == 1 && _cy_at(0) == 0) {
            _cy_err_tok("cyriusly: --global needs a version: ", "use <ver> --global");
            return 1;
        }
        return _cmd_use_v2(_cy_at(0), _cy_global);
    }

    # -- one-operand verbs (both MUTATE — an unchecked flag here installed or
    #    deleted a version literally named `--dry-run`) --
    if (streq(cmd, "install") == 1) {
        if (_cy_args_ok(cmd, 1, 1, 0) == 0) { return 1; }
        return _cmd_install(_cy_at(0));
    }
    if (streq(cmd, "uninstall") == 1) {
        if (_cy_args_ok(cmd, 1, 1, 0) == 0) { return 1; }
        return _cmd_uninstall(_cy_at(0));
    }

    # -- cmdtools [action] [tool] --
    if (streq(cmd, "cmdtools") == 1) {
        if (_cy_args_ok(cmd, 0, 2, 0) == 0) { return 1; }
        return _cmd_cmdtools(_cy_at(0), _cy_at(1));
    }

    # Unreachable: _cyl_known_cmd above is derived from exactly these names.
    syscall(1, 2, "Unknown command: ", 17);
    syscall(1, 2, cmd, strlen(cmd));
    syscall(1, 2, "\n", 1);
    return 1;
}

var rc = main();
syscall(60, rc);
