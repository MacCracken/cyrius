# cyrlint — Cyrius code linter
# Static analysis: naming, style, common mistakes.
# Reads source file, reports warnings to stderr.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"

var _warnings = 0;
var _errors = 0;
# Max file size cyrlint reads in one pass (1028KB); mirrors cyrfmt's _MAX_FILE.
# A file that hits the ceiling is flagged fail-loud rather than linted on a
# silently-truncated buffer. See CHANGELOG [6.2.20].
var _MAX_FILE = 1052672;

fn warn(line, msg): i64 {
    syscall(1, 2, "  warn line ", 12);
    var nb[24];
    var nl = fmt_int_buf(line, &nb);
    syscall(1, 2, &nb, nl);
    syscall(1, 2, ": ", 2);
    syscall(1, 2, msg, strlen(msg));
    syscall(1, 2, "\n", 1);
    _warnings += 1;
    return 0;
}

# v6.2.24: informational note (NOT a warning) — surfaced but does NOT increment
# `_warnings`, so it never fails the lint gate (which keys on the "N warnings"
# summary). Used by the raw-sys_open-flags rule: the pattern is worth flagging
# for an agnos port, but the ~40 pre-existing host-only sites (regression/process
# /args test infra) are legitimate on the host, so this raises visibility without
# breaking the build. See 2026-06-18-stdlib-native-agnos-abi-fs.md.
var _sysopen_notes = 0;
fn note_sysopen(line): i64 {
    syscall(1, 2, "  note line ", 12);
    var nb2[24];
    var nl2 = fmt_int_buf(line, &nb2);
    syscall(1, 2, &nb2, nl2);
    var m = ": raw sys_open w/ literal flags - agnos sys_open is (name,namelen,flags); prefer io.cyr's xopen / file_open (or xstat/xunlink/xgetdents) portable wrappers on agnos-bound paths\n";
    syscall(1, 2, m, strlen(m));
    _sysopen_notes += 1;
    return 0;
}

# v6.2.26: raw getdents syscall (per-target number/arity footgun). Linux
# getdents64 #217 (4-arg, basep) vs agnos getdents #29 (3-arg) vs macOS
# getdirentries — a raw `syscall(SYS_GETDENTS…)` only works on the target it was
# written for. Informational (the correct bridge sites in io.cyr/fs.cyr will note
# here too, like the sys_open rule's ~40 host-only sites). See the agnos-fs-abi
# issue; prefer io.cyr's `xgetdents` on agnos-bound dir code.
var _getdents_notes = 0;
fn note_rawgetdents(line): i64 {
    syscall(1, 2, "  note line ", 12);
    var gb[24];
    var gl = fmt_int_buf(line, &gb);
    syscall(1, 2, &gb, gl);
    var gm = ": raw getdents syscall - number/arity differ per target (agnos #29 3-arg, Linux 217 4-arg); prefer io.cyr's xgetdents on agnos-bound dir code\n";
    syscall(1, 2, gm, strlen(gm));
    _getdents_notes += 1;
    return 0;
}

# === Deferral-language policy (sigil idea, 2026-06-04) ===
# Flag deferred / broken-work markers in source that are NOT cross-referenced by   #skip-lint
# a tracking pointer (CHANGELOG / issue / roadmap / version). A bare `# TODO` or
# `return ..._NOT_IMPLEMENTED` with no pointer is the antipattern that let whole   #skip-lint
# arcs rot untracked in comments (see docs/development/issues/ shipped-broken
# register). Reported by default (separate counter, non-failing so the existing
# --strict gate is unaffected by the legacy backlog); `--strict-deferrals` makes
# it a hard gate once the backlog is cross-referenced (TDD-style hardening).
var _deferrals = 0;
var _strict_deferrals = 0;

# Bounded substring search within a line [start,end). Line buffers aren't
# NUL-terminated, so strstr() can't be used directly.
fn _line_has(buf, start, end, needle): i64 {
    var nl = strlen(needle);
    if (nl == 0) { return 0; }
    var i = start;
    while (i + nl <= end) {
        if (memeq(buf + i, needle, nl) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Returns the matched deferral-term cstr, or 0 if the line carries no marker.
fn _line_deferral_term(buf, start, end): i64 {
    if (_line_has(buf, start, end, "NOT_IMPLEMENTED") == 1) { return "NOT_IMPLEMENTED"; }   #skip-lint
    if (_line_has(buf, start, end, "SCAFFOLD") == 1) { return "SCAFFOLD"; }                 #skip-lint
    if (_line_has(buf, start, end, "TODO") == 1) { return "TODO"; }                         #skip-lint
    if (_line_has(buf, start, end, "FIXME") == 1) { return "FIXME"; }                       #skip-lint
    if (_line_has(buf, start, end, "XXX") == 1) { return "XXX"; }                           #skip-lint
    if (_line_has(buf, start, end, "deferred") == 1) { return "deferred"; }                 #skip-lint
    if (_line_has(buf, start, end, "follow-up") == 1) { return "follow-up"; }               #skip-lint
    if (_line_has(buf, start, end, "for now") == 1) { return "for now"; }                   #skip-lint
    if (_line_has(buf, start, end, "not yet") == 1) { return "not yet"; }                   #skip-lint
    if (_line_has(buf, start, end, "later bite") == 1) { return "later bite"; }             #skip-lint
    if (_line_has(buf, start, end, "future bite") == 1) { return "future bite"; }           #skip-lint
    if (_line_has(buf, start, end, "out of scope") == 1) { return "out of scope"; }         #skip-lint
    return 0;
}

# A deferral line is "tracked" if it points at where the work lives.
fn _line_has_tracking_ptr(buf, start, end): i64 {
    if (_line_has(buf, start, end, "CHANGELOG") == 1) { return 1; }   #skip-lint
    if (_line_has(buf, start, end, "roadmap") == 1) { return 1; }     #skip-lint
    if (_line_has(buf, start, end, "docs/") == 1) { return 1; }       #skip-lint
    if (_line_has(buf, start, end, "issue") == 1) { return 1; }       #skip-lint
    if (_line_has(buf, start, end, "See ") == 1) { return 1; }        #skip-lint
    if (_line_has(buf, start, end, "v6.") == 1) { return 1; }         #skip-lint
    if (_line_has(buf, start, end, "v5.") == 1) { return 1; }         #skip-lint
    return 0;
}

fn note_deferral(line, term): i64 {
    var p1 = "  deferral line ";
    syscall(1, 2, p1, strlen(p1));
    var nb[24];
    var nl = fmt_int_buf(line, &nb);
    syscall(1, 2, &nb, nl);
    var p2 = ": untracked '";
    syscall(1, 2, p2, strlen(p2));
    syscall(1, 2, term, strlen(term));
    var p3 = "' (cross-reference a CHANGELOG/issue/roadmap entry, or #skip-lint)\n";
    syscall(1, 2, p3, strlen(p3));
    _deferrals += 1;
    return 0;
}

fn lint_file(buf, total): i64 {
    var lineno = 1;
    var pos = 0;
    var prev_blank = 0;
    var in_fn = 0;
    var brace_depth = 0;

    # === Pre-pass: detect is_err naming-clash hazard (bote feedback #5) ===
    # `is_err` is defined in BOTH lib/syscalls.cyr (checks `ret < 0`) and
    # lib/tagged.cyr (checks a tagged Result). Applying the syscalls version
    # to a tagged Result silently never catches errors — Result heap pointers
    # are always > 0. If both modules are included, every `is_err(` call is
    # potentially wrong. Pre-scan for the combination and remember it so the
    # main loop can warn per call site.
    var has_syscalls = 0;
    var has_tagged = 0;
    var px = 0;
    while (px < total) {
        if (memeq(buf + px, "include \"lib/syscalls.cyr\"", 26) == 1) { has_syscalls = 1; }
        if (memeq(buf + px, "include \"lib/tagged.cyr\"", 24) == 1) { has_tagged = 1; }
        px += 1;
    }
    var is_err_clash = 0;
    if (has_syscalls == 1 && has_tagged == 1) { is_err_clash = 1; }

    while (pos < total) {
        # Find end of line
        var eol = pos;
        while (eol < total) {
            if (load8(buf + eol) == 10) { break; }
            eol += 1;
        }
        var linelen = eol - pos;

        # === Rule: #skip-lint comment ===
        # Lines containing #skip-lint are exempt from all rules
        var skip_line = 0;
        if (linelen >= 10) {
            var si = pos;
            while (si + 9 < eol) {
                if (memeq(buf + si, "#skip-lint", 10) == 1) { skip_line = 1; si = eol; }
                si += 1;
            }
        }

        if (skip_line == 0) {

            # === Rule: no trailing whitespace ===
            if (linelen > 0) {
                var last = load8(buf + eol - 1);
                if (last == 32) { warn(lineno, "trailing whitespace"); }
                if (last == 9) { warn(lineno, "trailing tab"); }
            }

            # === Rule: untracked deferral language (separate counter) ===
            var _dterm = _line_deferral_term(buf, pos, eol);
            if (_dterm != 0) {
                if (_line_has_tracking_ptr(buf, pos, eol) == 0) { note_deferral(lineno, _dterm); }
            }

            # === Rule: no tabs (use spaces) ===
            var ti = pos;
            while (ti < eol) {
                if (load8(buf + ti) == 9) {
                    warn(lineno, "tab character (use 4 spaces)");
                    ti = eol;
                }
                ti += 1;
            }

            # === Rule: line too long (>120 chars) ===
            if (linelen > 120) { warn(lineno, "line exceeds 120 characters"); }

            # === Rule: is_err naming clash (bote feedback #5) ===
            # If BOTH syscalls.cyr (is_err for raw ret<0) and tagged.cyr
            # (is_err_result for Results) are in scope, any plain `is_err(`
            # call is ambiguous and often silently wrong. Warn on each use.
            if (is_err_clash == 1) {
                var ic = pos;
                while (ic + 7 <= eol) {
                    if (memeq(buf + ic, "is_err(", 7) == 1) {
                        # Skip if preceded by an identifier char (e.g., `is_err_result`
                        # happens to start with `is_err` — don't false-flag it).
                        var preceded = 0;
                        if (ic > 0) {
                            var pc = load8(buf + ic - 1);
                            if (pc == 95) { preceded = 1; }
                            if (pc >= 48 && pc <= 57) { preceded = 1; }
                            if (pc >= 65 && pc <= 90) { preceded = 1; }
                            if (pc >= 97 && pc <= 122) { preceded = 1; }
                        }
                        if (preceded == 0) {
                            warn(lineno, "ambiguous is_err: syscalls.cyr checks ret<0, tagged.cyr has is_err_result for Result — be explicit");
                            ic = eol;
                        }
                    }
                    ic += 1;
                }
            }

            # === Rule: raw sys_open with a literal flags arg (agnos ABI footgun) ===
            # agnos sys_open is (name, namelen, flags) — NOT Linux (path, flags,
            # mode). A bare integer-literal 2nd arg (`sys_open(p, 0, 0)`) is read as
            # namelen=0 on agnos → opens a zero-length name → every call fails (the
            # tls_native_set_ca_system + sigil luks_write_keyfile class). Correct
            # code passes O_RDONLY (a name) on Linux or strlen(path) (a call) on
            # agnos — never a digit. Route through io.cyr's file_open per-target
            # bridge. See 2026-06-18-stdlib-native-agnos-abi-fs.md.
            # only scan the CODE portion (up to the first '#') so explanatory
            # comments that mention sys_open(...) aren't flagged.
            var code_end = eol;
            var ce = pos;
            while (ce < eol) {
                if (load8(buf + ce) == 35) { code_end = ce; ce = eol; }
                ce += 1;
            }
            var so = pos;
            while (so + 9 <= code_end) {
                if (memeq(buf + so, "sys_open(", 9) == 1) {
                    # not preceded by an identifier char (skip file_open / _sys_open)
                    var pre_ok = 1;
                    if (so > 0) {
                        var pc2 = load8(buf + so - 1);
                        if (pc2 == 95) { pre_ok = 0; }
                        if (pc2 >= 48) { if (pc2 <= 57) { pre_ok = 0; } }
                        if (pc2 >= 65) { if (pc2 <= 90) { pre_ok = 0; } }
                        if (pc2 >= 97) { if (pc2 <= 122) { pre_ok = 0; } }
                    }
                    if (pre_ok == 1) {
                        # find the first comma at the sys_open( paren depth
                        var k = so + 9;
                        var depth = 1;
                        var cpos = 0 - 1;
                        while (k < eol) {
                            var ch = load8(buf + k);
                            if (ch == 40) { depth += 1; }
                            if (ch == 41) { depth -= 1; }
                            if (ch == 44) { if (depth == 1) { if (cpos < 0) { cpos = k; } } }
                            k += 1;
                        }
                        if (cpos >= 0) {
                            # skip spaces after the comma; flag if the 2nd arg is a digit
                            var a2 = cpos + 1;
                            var seen = 0;
                            while (a2 < eol) {
                                if (seen == 0) {
                                    var fc = load8(buf + a2);
                                    if (fc != 32) {
                                        seen = 1;
                                        if (fc >= 48) { if (fc <= 57) {
                                            note_sysopen(lineno);
                                        } }
                                    }
                                }
                                a2 += 1;
                            }
                        }
                    }
                    so = eol;
                }
                so += 1;
            }

            # === Rule: raw getdents syscall (per-target number/arity, v6.2.26) ===
            # Flag when the code region holds BOTH `syscall(` and a `…SYS_GETDENTS`
            # number — catching the per-target alias family (`SYS_GETDENTS`,
            # `SYS_GETDENTS64`, and the `FSYS_`/`NSYS_`-prefixed forms, e.g. fs.cyr's
            # `syscall(FSYS_GETDENTS64,…)`) which a literal `syscall(SYS_GETDENTS`
            # prefix match would miss. The both-present test skips the `var …SYS_
            # GETDENTS… = N` const defs (no `syscall(`). Reuses code_end (the comment
            # boundary computed for the sys_open rule).
            var has_syscall = 0;
            var has_getdents = 0;
            var gso = pos;
            while (gso < code_end) {
                if (gso + 8 <= code_end) { if (memeq(buf + gso, "syscall(", 8) == 1) { has_syscall = 1; } }
                if (gso + 12 <= code_end) { if (memeq(buf + gso, "SYS_GETDENTS", 12) == 1) { has_getdents = 1; } }
                gso += 1;
            }
            if (has_syscall == 1) { if (has_getdents == 1) { note_rawgetdents(lineno); } }

        }

        # === Rule: multiple blank lines ===
        if (linelen == 0) {
            if (prev_blank == 1) { warn(lineno, "multiple consecutive blank lines"); }
            prev_blank = 1;
        } else {
            prev_blank = 0;
        }

        # Find first non-space char
        var first = pos;
        while (first < eol) {
            if (load8(buf + first) != 32) { break; }
            first += 1;
        }
        var content_len = eol - first;

        if (content_len > 0) {
            # === Rule: fn names should be snake_case ===
            if (content_len >= 3) {
                if (memeq(buf + first, "fn ", 3) == 1) {
                    var ni = first + 3;
                    # Check for camelCase fn names
                    # Allow: _prefixed, ALL_CAPS, Type_method (Cap + _)
                    var fn_first = load8(buf + ni);
                    var fn_second = load8(buf + ni + 1);
                    var skip_case = 0;
                    if (fn_first == 95) { skip_case = 1; }
                    if (fn_first == 0) { skip_case = 1; }
                    # Type_method: uppercase first + underscore second
                    if (fn_first >= 65) { if (fn_first <= 90) { if (fn_second == 95) { skip_case = 1; } } }
                    # Pascal_snake (UFCS-style "free fn on a type"):
                    # leading uppercase + at least one `_` whose
                    # immediate next char is lowercase a-z. Accepts
                    # `ResourceLimits_to_json`, `Foo_method_v2`,
                    # `T_method`. Rejects `Foo_BadCase` — the camel
                    # detector below still catches the suffix.
                    # Filed by agnostik 2026-04-26 — 28/28 false-
                    # positive rate against this convention.
                    if (fn_first >= 65) {
                        if (fn_first <= 90) {
                            if (skip_case == 0) {
                                var pi = ni;
                                var saw_us = 0;
                                var us_idx = 0;
                                while (pi < eol) {
                                    var pc = load8(buf + pi);
                                    if (pc == 40) { break; }
                                    if (pc == 60) { break; }
                                    if (pc == 95) { saw_us = 1; us_idx = pi; break; }
                                    pi += 1;
                                }
                                if (saw_us == 1) {
                                    var after = load8(buf + us_idx + 1);
                                    if (after >= 97) {
                                        if (after <= 122) { skip_case = 1; }
                                    }
                                }
                            }
                        }
                    }
                    if (skip_case == 0) {
                        # Detect camelCase: lowercase followed by uppercase
                        var is_camel = 0;
                        var prev_lower = 0;
                        var sci = ni;
                        while (sci < eol) {
                            var nc = load8(buf + sci);
                            if (nc == 40) { break; }
                            if (nc == 60) { break; }
                            if (nc >= 97) { if (nc <= 122) { prev_lower = 1; } }
                            elif (nc >= 65) { if (nc <= 90) { if (prev_lower == 1) { is_camel = 1; } prev_lower = 0; } }
                            else { prev_lower = 0; }
                            sci += 1;
                        }
                        if (is_camel == 1) {
                            warn(lineno, "fn name should be snake_case");
                        }
                    }
                }
            }

            # === Rule: missing alloc_init() in main ===
            if (content_len >= 9) {
                if (memeq(buf + first, "fn main()", 9) == 1) {
                    in_fn = 1;
                }
            }

            # === Rule: var used as keyword parameter name ===
            # Check for 'default' used as identifier (common mistake)

            # Track brace depth (skip string literals, char literals,
            # and comments). v5.10.10 — char-literal skip mirrors the
            # v5.10.6 cyrfmt fix; agnostik 5.10.9 toolchain refresh
            # filed the same bug class for cyrlint (694 false-positive
            # `unmatched closing brace` warnings on every `}` after a
            # `str_builder_putc(sb, '}')` call across 6 serde-emit
            # files). See agnostik/docs/development/issues/cyrlint-
            # char-literal-brace-bug-2026-05-09.md.
            var bi = first;
            while (bi < eol) {
                var bc = load8(buf + bi);
                if (bc == 35) {
                    # Comment: skip rest of line
                    bi = eol;
                }
                elif (bc == 34) {
                    # Skip string literal: advance past closing quote
                    bi += 1;
                    while (bi < eol) {
                        if (load8(buf + bi) == 92) { bi += 1; }
                        elif (load8(buf + bi) == 34) { break; }
                        bi += 1;
                    }
                    bi += 1;
                }
                elif (bc == 39) {
                    # Skip char literal: advance past closing single
                    # quote. `'\''` (escaped quote) and `'\\'` (escaped
                    # backslash) handled via the backslash-skip pattern.
                    bi += 1;
                    while (bi < eol) {
                        if (load8(buf + bi) == 92) { bi += 1; }
                        elif (load8(buf + bi) == 39) { break; }
                        bi += 1;
                    }
                    bi += 1;
                }
                else {
                    if (bc == 123) { brace_depth += 1; }
                    if (bc == 125) { brace_depth -= 1; }
                    bi += 1;
                }
            }

            # === Rule: negative brace depth ===
            if (brace_depth < 0) {
                warn(lineno, "unmatched closing brace");
            }
        }

        pos = eol + 1;
        lineno += 1;
    }

    # === Rule: unclosed braces at end ===
    if (brace_depth > 0) {
        warn(lineno, "unclosed braces at end of file");
    }

    return 0;
}

# === Rule: top-level var X = expr referencing var Y declared later ===
#
# v5.7.32 (mabda surfacing): cyrius initializes top-level
# `var X = expr;` declarations in source declaration order. If
# `expr` references a constant declared LATER in the same file,
# the reference resolves to 0 (default zero-init) at the time X
# is evaluated. No warning, no error.
#
# Mabda v3 Step 4f.ii hit this on hardware-iter work and burned
# 30+ minutes on a "wedged GPU" misdiagnosis before a CPU
# regression test pinned the actual cause. Filed at
# `docs/development/issues/2026-04-28-global-init-order-forward-
# ref.md`.
#
# Rule: walk the file twice. Pass 1 collects every TOP-LEVEL
# `var IDENT = ...;` and records (name, line) in parallel arrays.
# Pass 2 walks every `var X = expr;` initializer, scans the expr
# for identifier tokens, and warns if an IDENT was declared at a
# line LATER than X (silent zero at init time).
#
# Scope deliberately narrow: only `var → var` references. fns,
# enums, and structs are forward-ref-safe (fn addresses fixed at
# emit time; enum values are compile-time constants; structs are
# types, not values), so they don't need tracking.
#
# Capacity: 256 top-level vars × 32-byte names. Sized for stdlib
# (lib/math.cyr alone has ~25 top-level constants); typical
# consumer code is well under.
fn _is_id_start(c): i64 {
    if (c >= 65) { if (c <= 90) { return 1; } }    # A-Z
    if (c >= 97) { if (c <= 122) { return 1; } }   # a-z
    if (c == 95) { return 1; }                      # _
    return 0;
}
fn _is_id_cont(c): i64 {
    if (_is_id_start(c) == 1) { return 1; }
    if (c >= 48) { if (c <= 57) { return 1; } }    # 0-9
    return 0;
}

# Helper: at buf[pos..eol), find a top-level `var IDENT` decl.
# Returns the offset of IDENT's first byte, or -1 if not a var-
# decl line. Caller already checked this line is at brace_depth==0.
fn _find_var_decl_ident(buf, pos, eol): i64 {
    # Skip leading whitespace
    var p = pos;
    while (p < eol) {
        var c = load8(buf + p);
        if (c != 32) { if (c != 9) { break; } }
        p = p + 1;
    }
    # Match `var ` (4 chars)
    if (p + 4 > eol) { return 0 - 1; }
    if (memeq(buf + p, "var ", 4) == 0) { return 0 - 1; }
    p = p + 4;
    # Skip more whitespace
    while (p < eol) {
        var c2 = load8(buf + p);
        if (c2 != 32) { if (c2 != 9) { break; } }
        p = p + 1;
    }
    if (p >= eol) { return 0 - 1; }
    if (_is_id_start(load8(buf + p)) == 0) { return 0 - 1; }
    return p;
}

# Walk buf, find IDENT length starting at off (caller guaranteed
# is_id_start). Returns end position (one past last id char).
fn _scan_id_end(buf, off, total): i64 {
    var p = off + 1;
    while (p < total) {
        if (_is_id_cont(load8(buf + p)) == 0) { return p; }
        p = p + 1;
    }
    return p;
}

# Compare buf[off, off+len) to buf[other_off, other_off+other_len).
fn _eq_substr(buf, off1, len1, off2, len2): i64 {
    if (len1 != len2) { return 0; }
    var i = 0;
    while (i < len1) {
        if (load8(buf + off1 + i) != load8(buf + off2 + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _find_eol(buf, start, total): i64 {
    var p = start;
    while (p < total) {
        if (load8(buf + p) == 10) { return p; }
        p = p + 1;
    }
    return total;
}

fn lint_globals_init_order(buf, total): i64 {
    # Parallel arrays: name_off[i], name_len[i], name_line[i]. Cap 256.
    var name_off  = alloc(2048);   # 256 × 8B
    var name_len  = alloc(2048);
    var name_line = alloc(2048);
    var nvars = 0;

    # Pass 1: collect top-level `var IDENT = ...;` decls.
    var pos = 0;
    var lineno = 1;
    var depth = 0;
    while (pos < total) {
        var eol = _find_eol(buf, pos, total);
        if (depth == 0) {
            var decl = _find_var_decl_ident(buf, pos, eol);
            if (decl >= 0) {
                if (nvars < 256) {
                    var id_end = _scan_id_end(buf, decl, total);
                    store64(name_off  + nvars * 8, decl);
                    store64(name_len  + nvars * 8, id_end - decl);
                    store64(name_line + nvars * 8, lineno);
                    nvars = nvars + 1;
                }
            }
        }
        # v5.10.10 — skip braces inside string and char literals
        # (matching the lint() main-loop fix). The globals-init-
        # order pass walks every line and tracks depth; a `}` inside
        # `'}'` or `"..."` would break out of fn-tracking prematurely
        # and false-positive flag fn-internal vars as top-level.
        var bp = pos;
        while (bp < eol) {
            var bc = load8(buf + bp);
            if (bc == 35) { bp = eol; }
            elif (bc == 34) {
                bp = bp + 1;
                while (bp < eol) {
                    if (load8(buf + bp) == 92) { bp = bp + 1; }
                    elif (load8(buf + bp) == 34) { break; }
                    bp = bp + 1;
                }
                bp = bp + 1;
            }
            elif (bc == 39) {
                bp = bp + 1;
                while (bp < eol) {
                    if (load8(buf + bp) == 92) { bp = bp + 1; }
                    elif (load8(buf + bp) == 39) { break; }
                    bp = bp + 1;
                }
                bp = bp + 1;
            }
            else {
                if (bc == 123) { depth = depth + 1; }
                if (bc == 125) { depth = depth - 1; }
                bp = bp + 1;
            }
        }
        pos = eol + 1;
        lineno = lineno + 1;
    }

    # Pass 2: re-walk. For each top-level `var X = expr;`, scan
    # expr tokens; warn on any IDENT whose def_line > current.
    pos = 0;
    lineno = 1;
    depth = 0;
    while (pos < total) {
        var eol = _find_eol(buf, pos, total);
        if (depth == 0) {
            var decl = _find_var_decl_ident(buf, pos, eol);
            if (decl >= 0) {
                var id_end = _scan_id_end(buf, decl, total);
                # Find `=` after IDENT (uninit decl skipped).
                var eq = id_end;
                var found_eq = 0;
                while (eq < eol) {
                    if (load8(buf + eq) == 61) {
                        found_eq = 1;
                        eq = eol;
                    } else {
                        eq = eq + 1;
                    }
                }
                if (found_eq == 1) {
                    # Recompute eq position (the loop overshot to eol).
                    eq = id_end;
                    while (eq < eol) {
                        if (load8(buf + eq) == 61) { eq = eol + 1; }
                        else { eq = eq + 1; }
                    }
                    var scan = (eol - eol) + (id_end + 0);
                    # eq now at eol+1 if found. The actual `=` was
                    # somewhere in [id_end, eol). Find its real pos.
                    var real_eq = id_end;
                    while (real_eq < eol) {
                        if (load8(buf + real_eq) == 61) { break; }
                        real_eq = real_eq + 1;
                    }
                    scan = real_eq + 1;
                    while (scan < eol) {
                        var c = load8(buf + scan);
                        if (c == 35) { scan = eol; }              # # comment
                        elif (c == 34) {
                            # v5.7.36: skip string literal. Identifiers
                            # nested in "..." strings would otherwise
                            # match against the global var-name table
                            # and trigger spurious forward-ref warnings
                            # (e.g. an init expression that builds an
                            # error message naming a forward-declared
                            # var). Honour `\"` and `\\` escapes; bail
                            # at eol if unterminated.
                            scan = scan + 1;
                            while (scan < eol) {
                                var sc = load8(buf + scan);
                                if (sc == 92) { scan = scan + 2; }
                                elif (sc == 34) { scan = scan + 1; break; }
                                else { scan = scan + 1; }
                            }
                        }
                        elif (c == 39) {
                            # Same shape for char literals: '\n', 'a',
                            # '\\', etc. Cyrius char literals are
                            # single-line; eol bound is sufficient.
                            scan = scan + 1;
                            while (scan < eol) {
                                var sc = load8(buf + scan);
                                if (sc == 92) { scan = scan + 2; }
                                elif (sc == 39) { scan = scan + 1; break; }
                                else { scan = scan + 1; }
                            }
                        }
                        elif (_is_id_start(c) == 1) {
                            var id_e = _scan_id_end(buf, scan, total);
                            var idlen = id_e - scan;
                            var i = 0;
                            while (i < nvars) {
                                var v_off  = load64(name_off  + i * 8);
                                var v_len  = load64(name_len  + i * 8);
                                var v_line = load64(name_line + i * 8);
                                if (_eq_substr(buf, v_off, v_len, scan, idlen) == 1) {
                                    if (v_line > lineno) {
                                        syscall(1, 2, "  warn line ", 12);
                                        var nb[24];
                                        var nl = fmt_int_buf(lineno, &nb);
                                        syscall(1, 2, &nb, nl);
                                        syscall(1, 2, ": global var init refs '", 24);
                                        syscall(1, 2, buf + v_off, v_len);
                                        syscall(1, 2, "' declared at line ", 19);
                                        var nb2[24];
                                        var nl2 = fmt_int_buf(v_line, &nb2);
                                        syscall(1, 2, &nb2, nl2);
                                        syscall(1, 2, " (silent zero at init)\n", 23);
                                        _warnings += 1;
                                        i = nvars;   # break — single warn per ref
                                    }
                                }
                                i = i + 1;
                            }
                            scan = id_e;
                        } else {
                            scan = scan + 1;
                        }
                    }
                }
            }
        }
        # v5.10.10 — same skip pattern as the pass-1 brace counter.
        var bp = pos;
        while (bp < eol) {
            var bc = load8(buf + bp);
            if (bc == 35) { bp = eol; }
            elif (bc == 34) {
                bp = bp + 1;
                while (bp < eol) {
                    if (load8(buf + bp) == 92) { bp = bp + 1; }
                    elif (load8(buf + bp) == 34) { break; }
                    bp = bp + 1;
                }
                bp = bp + 1;
            }
            elif (bc == 39) {
                bp = bp + 1;
                while (bp < eol) {
                    if (load8(buf + bp) == 92) { bp = bp + 1; }
                    elif (load8(buf + bp) == 39) { break; }
                    bp = bp + 1;
                }
                bp = bp + 1;
            }
            else {
                if (bc == 123) { depth = depth + 1; }
                if (bc == 125) { depth = depth - 1; }
                bp = bp + 1;
            }
        }
        pos = eol + 1;
        lineno = lineno + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    args_init();

    if (argc() < 2) {
        println("Usage: cyrlint [--strict] [--strict-deferrals] [--exit-with-count] <file.cyr>");
        return 1;
    }

    # Exit-code policy (v6.0.36, issue 2026-04-26): default is conventional
    # (0 = success, 1 = read error, 2 = --strict and warnings present) so
    # `set -eo pipefail` CI scripts see a clean rc and the warning detail
    # in stdout. The old "rc == warning count" behavior — useful in some
    # scripts but indistinguishable from a crash under `set -e` — is opt-in
    # via --exit-with-count. Flags may appear before or after the path.
    var strict = 0;
    var exit_with_count = 0;
    var path = 0;
    var ai = 1;
    while (ai < argc()) {
        var a = argv(ai);
        if (streq(a, "--strict") == 1) { strict = 1; }
        elif (streq(a, "--exit-with-count") == 1) { exit_with_count = 1; }
        elif (streq(a, "--strict-deferrals") == 1) { _strict_deferrals = 1; }
        elif (path == 0) { path = a; }
        ai = ai + 1;
    }
    if (path == 0) {
        println("Usage: cyrlint [--strict] [--strict-deferrals] [--exit-with-count] <file.cyr>");
        return 1;
    }

    syscall(1, 1, "=== cyrlint: ", 13);
    syscall(1, 1, path, strlen(path));
    syscall(1, 1, " ===\n", 5);

    var buf = alloc(_MAX_FILE);
    var n = file_read_all(path, buf, _MAX_FILE);
    if (n <= 0) {
        println("cyrlint: cannot read file");
        return 1;
    }
    # Fail loud on a truncated read (see cyrfmt _MAX_FILE rationale).
    if (n >= _MAX_FILE) {
        println("cyrlint: file too large to lint (>1028KB) — raise _MAX_FILE");
        return 1;
    }

    lint_file(buf, n);
    lint_globals_init_order(buf, n);

    # Deferral summary goes to STDERR (with its per-line notes), and BEFORE the
    # warnings line, so the canonical machine-readable last line of STDOUT stays
    # "<n> warnings" — gates parse it via `tail -1 | grep -oP '^\d+'` and must
    # NOT pick up the deferral count.
    var db[24];
    var dl = fmt_int_buf(_deferrals, &db);
    syscall(1, 2, &db, dl);
    var dsfx = " untracked deferrals\n";
    syscall(1, 2, dsfx, strlen(dsfx));

    var nb[24];
    var nl = fmt_int_buf(_warnings, &nb);
    syscall(1, 1, &nb, nl);
    syscall(1, 1, " warnings\n", 10);

    # See the exit-code policy note at the top of main().
    if (exit_with_count == 1) { return _warnings; }
    if (strict == 1 && _warnings > 0) { return 2; }
    if (_strict_deferrals == 1 && _deferrals > 0) { return 2; }
    return 0;
}
var r = main();
syscall(60, r);
