# programs/gen_syscall_xlat.cyr — native cyrius codegen for the x86_64 <-> aarch64
# syscall correspondence table.
#
# WHY THIS EXISTS. On ELF-aarch64 a raw hardcoded syscall NUMBER is indistinguishable
# from an intended native one: `ESYSXLAT`'s aarch64 arm passes unmatched numbers through
# to the `svc` verbatim, which is correct by design. So a consumer that writes the x86_64
# number gets a DIFFERENT, VALID syscall, the build succeeds, and nothing warns. Filed
# from darshana 2026-08-23; the `var SYS_* = <x86 number>` SHADOW half was diagnosed at
# v6.5.50, this is the raw-literal half.
#
# ⛔ A HEURISTIC IS NOT ENOUGH, AND THE DATA SAYS SO. The obvious table-free check —
# "warn if the number is not a valid SYS_* value on this target" — catches 61 of the 71
# differing syscalls and MISSES THE 10 THAT MATTER MOST, because those x86 numbers collide
# with real aarch64 syscalls:
#     SYS_UNAME  63 -> aarch64 63 is READ          SYS_KILL    62 -> aarch64 62 is LSEEK
#     SYS_EXECVE 59 -> aarch64 59 is PIPE2         SYS_WAIT4   61 -> aarch64 61 is GETDENTS64
#     SYS_CLONE  56 -> aarch64 56 is OPENAT        SYS_CHDIR   80 -> aarch64 80 is FSTAT
# Those are exactly the silent-wrong-syscall cases the diagnostic is for, so the
# correspondence has to be real data, not an inference.
#
# ⭐ AND IT IS DERIVED, NEVER HAND-MAINTAINED. The two stdlib peers already ARE the
# correspondence; this reads them and emits the table, so the two cannot drift. A
# hand-maintained duplicate of a derivable fact is the self-drifting shape this repo keeps
# finding (heap-map sizes vs regions, gate counts vs files, capacity denominators vs caps,
# declared string lengths vs strings). `tests/gates/platform/syscall_xlat_generated.sh`
# re-runs this and fails on any diff, so the table cannot rot.
#
# Sovereignty: cyrius writes its own data tables. No Python, no awk. Mirrors
# programs/gen_unicode_data.cyr.
#
# Run via:
#   cyrius build programs/gen_syscall_xlat.cyr build/gen_syscall_xlat
#   ./build/gen_syscall_xlat
# Writes: src/common/syscall_xlat.cyr

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"

var MAXSYS = 512;
var NAMEPOOL = 32768;

# ⚠ Entries at or above this are CYRIUS-PRIVATE ALIASES (v6.5.7 band), not kernel
# numbers — `SYS_UMOUNT2 = 1039` on aarch64 is renumbered by ESYSXLAT because the native
# 39 is already eaten by an x86-compat shim. They are legitimate as the "what to write"
# side, but must NEVER be used as the "what does this number mean natively" side.
var ALIAS_BASE = 1000;

fn _is_upper_or_digit_or_us(c): i64 {
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    if (c == 95) { return 1; }
    return 0;
}

# Parse `SYS_NAME = <digits>;` declarations out of a stdlib syscall table.
# Names are copied into `pool` (NUL-terminated); `names[i]` holds the pool offset and
# `nums[i]` the value. Returns the count.
fn parse_table(buf, blen, names, nums, pool, pool_pos_p): i64 {
    var n = 0;
    var i = 0;
    var pp = load64(pool_pos_p);
    while (i < blen) {
        # line start: skip leading whitespace
        while (i < blen && (load8(buf + i) == 32 || load8(buf + i) == 9)) { i = i + 1; }
        # a comment line contributes nothing
        if (i < blen && load8(buf + i) == 35) {
            while (i < blen && load8(buf + i) != 10) { i = i + 1; }
            i = i + 1;
            continue;
        }
        if (i + 4 < blen) {
            if (load8(buf + i) == 83) {
            if (load8(buf + i + 1) == 89) {
            if (load8(buf + i + 2) == 83) {
            if (load8(buf + i + 3) == 95) {
                var ns = i;
                var ne = i;
                while (ne < blen && _is_upper_or_digit_or_us(load8(buf + ne)) == 1) { ne = ne + 1; }
                var j = ne;
                while (j < blen && (load8(buf + j) == 32 || load8(buf + j) == 9)) { j = j + 1; }
                if (j < blen && load8(buf + j) == 61) {
                    j = j + 1;
                    while (j < blen && (load8(buf + j) == 32 || load8(buf + j) == 9)) { j = j + 1; }
                    var v = 0;
                    var digits = 0;
                    while (j < blen && load8(buf + j) >= 48 && load8(buf + j) <= 57) {
                        v = v * 10 + (load8(buf + j) - 48);
                        j = j + 1;
                        digits = digits + 1;
                    }
                    # require a terminating `;` so `SYS_X = SYS_Y` and prose never match
                    if (digits > 0 && j < blen && load8(buf + j) == 59) {
                        if (n < MAXSYS) {
                            var k = 0;
                            store64(names + n * 8, pp);
                            while (ns + k < ne) {
                                store8(pool + pp + k, load8(buf + ns + k));
                                k = k + 1;
                            }
                            store8(pool + pp + k, 0);
                            pp = pp + k + 1;
                            store64(nums + n * 8, v);
                            n = n + 1;
                        }
                    }
                }
            } } } }
        }
        while (i < blen && load8(buf + i) != 10) { i = i + 1; }
        i = i + 1;
    }
    store64(pool_pos_p, pp);
    return n;
}

# Collect the x86 numbers that ESYSXLAT's ELF-aarch64 arm ALREADY REMAPS, straight out of
# the emitter source. That arm is written as literal `EW(S, 0x...)` instruction words
# rather than `_esx_arm(...)` calls, so it must be decoded, not grepped for call rows:
# `cmp x8, #imm` is 0xF1000000 | (imm << 10) | (8 << 5) | 0x1F, so imm = (w >> 10) & 0xFFF.
#
# ⭐ THIS IS THE ROW SET THAT MAKES THE DIAGNOSTIC USABLE. Writing an x86 number that this
# chain remaps is the SUPPORTED convention on ELF-aarch64 — cycc's own `enum Sys` uses
# x86 numbers (main_aarch64.cyr: SYS_WRITE = 1) precisely because the chain rewrites them.
# Warning on those flags the compiler's own correct code: measured 510 warnings on
# cycc's aarch64 source and 15 on a stdlib hello-world before this exclusion, and 0 after.
fn collect_routed(buf, blen, out): i64 {
    var n = 0;
    var i = 0;
    # bound the scan to ESYSXLAT so unrelated `cmp` encodings elsewhere cannot over-exclude
    var start = 0 - 1;
    var j = 0;
    while (j + 16 < blen) {
        if (memeq(buf + j, "fn ESYSXLAT(S)", 14) == 1) { start = j; j = blen; }
        j = j + 1;
    }
    if (start < 0) { return 0; }
    var stop = blen;
    j = start + 16;
    while (j + 4 < blen) {
        if (load8(buf + j) == 10) {
            if (memeq(buf + j + 1, "fn ", 3) == 1) { stop = j; j = blen; }
        }
        j = j + 1;
    }
    i = start;
    while (i + 14 < stop) {
        if (memeq(buf + i, "EW(S, 0x", 8) == 1) {
            var v = 0;
            var k = 0;
            var okhex = 1;
            while (k < 8) {
                var c = load8(buf + i + 8 + k);
                var d = 0 - 1;
                if (c >= 48 && c <= 57) { d = c - 48; }
                if (c >= 65 && c <= 70) { d = c - 55; }
                if (c >= 97 && c <= 102) { d = c - 87; }
                if (d < 0) { okhex = 0; k = 8; }
                if (d >= 0) { v = v * 16 + d; k = k + 1; }
            }
            if (okhex == 1) {
                # cmp x8, #imm  ->  top byte 0xF1
                if (v / 16777216 == 241) {
                    var imm = (v / 1024) & 4095;
                    store64(out + n * 8, imm);
                    n = n + 1;
                }
            }
        }
        i = i + 1;
    }
    return n;
}

# Is `v` a REAL aarch64 syscall number? Aliases (>= ALIAS_BASE) are cyrius-private and
# never reach the kernel as themselves, so they do not make a number "native".
# Excluding native numbers is what removes the 10 genuinely AMBIGUOUS cases: for those,
# the x86 number IS a valid aarch64 syscall (uname 63 = read, kill 62 = lseek), so a
# literal cannot be judged wrong — warning there would fire on correct low-level code.
# A row earns a place in the diagnostic table only when writing that x86 number as a raw
# literal on ELF-aarch64 is UNAMBIGUOUSLY WRONG:
#   * the two arches disagree about the number (otherwise there is nothing to warn about),
#   * ESYSXLAT does not already remap it (remapped numbers are the supported convention —
#     cycc's own aarch64 fork writes them deliberately), and
#   * it is not itself a valid native aarch64 number (else the literal is plausibly correct).
# Measured against that filter: 525 in-tree warnings become 0, and 43 rows remain.
fn _row_wanted(xv, i, av, aj, ac, routed, routed_n): i64 {
    var xnum = load64(xv + i * 8);
    if (xnum == load64(av + aj * 8)) { return 0; }
    if (is_in(routed, routed_n, xnum) == 1) { return 0; }
    if (is_native_a64(av, ac, xnum) == 1) { return 0; }
    return 1;
}

fn is_native_a64(av, ac, v): i64 {
    var i = 0;
    while (i < ac) {
        if (load64(av + i * 8) == v) {
            if (load64(av + i * 8) < ALIAS_BASE) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

fn is_in(list, cnt, v): i64 {
    var i = 0;
    while (i < cnt) {
        if (load64(list + i * 8) == v) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn name_at(pool, names, i): i64 { return pool + load64(names + i * 8); }

fn find_by_name(pool, names, nums, cnt, want): i64 {
    var i = 0;
    while (i < cnt) {
        if (streq(name_at(pool, names, i), want) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# lowercase the `SYS_` prefix off a name into `out`, for readable messages
fn short_lower(pool, names, i, out): i64 {
    var p = name_at(pool, names, i) + 4;      # skip "SYS_"
    var k = 0;
    var c = load8(p);
    while (c != 0) {
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(out + k, c);
        k = k + 1;
        c = load8(p + k);
    }
    store8(out + k, 0);
    return k;
}

fn emit(out, oo_p, s): i64 {
    var oo = load64(oo_p);
    var k = 0;
    var c = load8(s + k);
    while (c != 0) { store8(out + oo + k, c); k = k + 1; c = load8(s + k); }
    store64(oo_p, oo + k);
    return 0;
}

fn emit_num(out, oo_p, v): i64 {
    var tmp[32];
    var stack_addr = &tmp;
    var n = 0;
    if (v == 0) { store8(stack_addr, 48); n = 1; }
    var x = v;
    while (x > 0) { store8(stack_addr + n, 48 + x % 10); n = n + 1; x = x / 10; }
    var oo = load64(oo_p);
    var i = n;
    while (i > 0) { i = i - 1; store8(out + oo, load8(stack_addr + i)); oo = oo + 1; }
    store64(oo_p, oo);
    return 0;
}

fn main(): i64 {
    var xb = alloc(262144);
    var ab = alloc(262144);
    var xlen = file_read_all("lib/syscalls_x86_64_linux.cyr", xb, 262143);
    var alen = file_read_all("lib/syscalls_aarch64_linux.cyr", ab, 262143);
    if (xlen <= 0 || alen <= 0) {
        println("gen_syscall_xlat: cannot read the stdlib syscall tables (run from the repo root)");
        return 1;
    }
    var eb = alloc(1048576);
    var elen = file_read_all("src/backend/aarch64/emit.cyr", eb, 1048575);
    if (elen <= 0) {
        println("gen_syscall_xlat: cannot read src/backend/aarch64/emit.cyr");
        return 1;
    }
    var routed = alloc(MAXSYS * 8);
    var routed_n = collect_routed(eb, elen, routed);

    var pool = alloc(NAMEPOOL);
    var ppos = alloc(8);
    store64(ppos, 0);
    var xn = alloc(MAXSYS * 8); var xv = alloc(MAXSYS * 8);
    var an = alloc(MAXSYS * 8); var av = alloc(MAXSYS * 8);
    var xc = parse_table(xb, xlen, xn, xv, pool, ppos);
    var ac = parse_table(ab, alen, an, av, pool, ppos);

    var out = alloc(1048576);
    var oo = alloc(8);
    store64(oo, 0);

    emit(out, oo, "# src/common/syscall_xlat.cyr — AUTO-GENERATED by programs/gen_syscall_xlat.cyr\n");
    emit(out, oo, "# DO NOT EDIT. Regenerate with:\n");
    emit(out, oo, "#     cyrius build programs/gen_syscall_xlat.cyr build/gen_syscall_xlat && ./build/gen_syscall_xlat\n");
    emit(out, oo, "# Derived from lib/syscalls_x86_64_linux.cyr + lib/syscalls_aarch64_linux.cyr, which ARE\n");
    emit(out, oo, "# the correspondence — so the table cannot drift from the stdlib it describes.\n");
    emit(out, oo, "# Pinned by tests/gates/platform/syscall_xlat_generated.sh (regenerates and diffs).\n");
    emit(out, oo, "#\n");
    emit(out, oo, "# Rows are syscalls DEFINED IN BOTH tables whose numbers DIFFER. Numbers >= 1000 on the\n");
    emit(out, oo, "# aarch64 side are cyrius-private aliases (v6.5.7 band) renumbered by ESYSXLAT, so they are\n");
    emit(out, oo, "# valid as 'what to write' but never as 'what this number means natively'.\n\n");

    # --- x86 number -> aarch64 syscall NAME (what the user meant) ---
    emit(out, oo, "# The x86_64 number `n` names this syscall. 0 when `n` is not an x86_64 number whose\n");
    emit(out, oo, "# aarch64 counterpart differs.\n");
    emit(out, oo, "fn _SYSX_MEANT(n): i64 {\n");
    var rows = 0;
    var i = 0;
    var sbuf = alloc(128);
    while (i < xc) {
        var nm = name_at(pool, xn, i);
        var aj = find_by_name(pool, an, av, ac, nm);
        if (aj >= 0) {
            if (_row_wanted(xv, i, av, aj, ac, routed, routed_n) == 1) {
                short_lower(pool, xn, i, sbuf);
                emit(out, oo, "    if (n == ");
                emit_num(out, oo, load64(xv + i * 8));
                emit(out, oo, ") { return \"");
                emit(out, oo, sbuf);
                emit(out, oo, "\"; }\n");
                rows = rows + 1;
            }
        }
        i = i + 1;
    }
    emit(out, oo, "    return 0;\n}\n\n");

    # --- x86 number -> the SYS_* name to use instead ---
    emit(out, oo, "# The stdlib constant to write instead, for the x86_64 number `n`.\n");
    emit(out, oo, "fn _SYSX_USE(n): i64 {\n");
    i = 0;
    while (i < xc) {
        var nm2 = name_at(pool, xn, i);
        var aj2 = find_by_name(pool, an, av, ac, nm2);
        if (aj2 >= 0) {
            if (_row_wanted(xv, i, av, aj2, ac, routed, routed_n) == 1) {
                emit(out, oo, "    if (n == ");
                emit_num(out, oo, load64(xv + i * 8));
                emit(out, oo, ") { return \"");
                emit(out, oo, nm2);
                emit(out, oo, "\"; }\n");
            }
        }
        i = i + 1;
    }
    emit(out, oo, "    return 0;\n}\n\n");

    # --- what that number ACTUALLY is on aarch64 (the dangerous collisions) ---
    emit(out, oo, "# What `n` really invokes on ELF-aarch64, when it is a native aarch64 number. 0 when the\n");
    emit(out, oo, "# number is not a known aarch64 syscall — the call then simply does not exist there.\n");
    emit(out, oo, "# ⭐ THIS ARM IS THE POINT OF THE TABLE: 10 of the differing syscalls have an x86 number\n");
    emit(out, oo, "# that IS a real, different aarch64 syscall (uname 63 = read, kill 62 = lseek,\n");
    emit(out, oo, "# execve 59 = pipe2), and those are the silent-wrong-call cases a heuristic cannot see.\n");
    emit(out, oo, "fn _SYSX_ACTUALLY(n): i64 {\n");
    i = 0;
    while (i < ac) {
        if (load64(av + i * 8) < ALIAS_BASE) {
            short_lower(pool, an, i, sbuf);
            emit(out, oo, "    if (n == ");
            emit_num(out, oo, load64(av + i * 8));
            emit(out, oo, ") { return \"");
            emit(out, oo, sbuf);
            emit(out, oo, "\"; }\n");
        }
        i = i + 1;
    }
    emit(out, oo, "    return 0;\n}\n");

    var n_written = file_write_all("src/common/syscall_xlat.cyr", out, load64(oo));
    if (n_written <= 0) {
        println("gen_syscall_xlat: write failed");
        return 1;
    }
    syscall(SYS_WRITE, 1, "gen_syscall_xlat: wrote src/common/syscall_xlat.cyr — x86 names ", 66);
    print_num(xc);
    syscall(SYS_WRITE, 1, ", aarch64 names ", 16);
    print_num(ac);
    syscall(SYS_WRITE, 1, ", differing rows ", 17);
    print_num(rows);
    syscall(SYS_WRITE, 1, "\n", 1);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
