# programs/release/common.cyr — what the release steps share (place, briefs, archive, assemble,
# roadmap_state): the common options (--repo, --ver, --c6, --date, --dry), the checkout and the
# scratch dir they default to, UTF-8 reads and dry-run-aware writes, and JSON read with Python's
# dict and str() semantics. Not a program: each step includes it.
#
#   --repo  default: $CYRIUS_REPO, else the checkout the current directory is in
#   --c6    default: $CYRIUS_SCRATCH, else ${XDG_CACHE_HOME:-$HOME/.cache}/c6 — the release's
#           scratch directory, where every step's <tag>_* inputs and outputs live
#           (<tag> = the version without dots: X.Y.Z -> XYZ)
#
# It replaced scripts/release/release_common.py. CHANGELOG [6.7.17]

include "programs/dev/helper_common.cyr"
include "lib/bayan.cyr"

var RC_PROG = 0;
var RC_USAGE = 0;
var RC_REPO = 0;
var RC_C6 = 0;
var RC_VER = 0;
var RC_TAG = 0;
var RC_DATE = 0;
var RC_DRY = 0;

# sys.exit(msg): the message on stderr, exit 1.
fn rc_exit(msg): i64 {
    hc_err(msg);
    hc_errc("\n");
    sys_exit(1);
    return 1;
}
fn rc_exitc(c): i64 { return rc_exit(hc_s(c)); }

# The common options; `date` and `dry` add --date (required) and --dry. Declare the step's own
# options with hc_opt after this, then call rc_finish.
fn rc_options(progc, usagec, date, dry): i64 {
    RC_PROG = progc;
    RC_USAGE = usagec;
    hc_opt("repo", 1);
    hc_opt("ver", 1);
    hc_opt("c6", 1);
    if (date == 1) { hc_opt("date", 1); }
    if (dry == 1) { hc_opt("dry", 0); }
    return 0;
}

# re.fullmatch of `<d>+(.<d>+){2}` (X.Y.Z) or `<d>{4}-<d>{2}-<d>{2}` (a date) with Python's \d.
fn _rc_digits(s, i, lenp): i64 {
    var k = 0;
    var l = 0;
    while (i < hc_n(s)) {
        var cp = hc_u8(s, i, &l);
        if (hc_nd_value(cp) < 0) { break; }
        i = i + l;
        k = k + 1;
    }
    store64(lenp, k);
    return i;
}
fn _rc_is_ver(s): i64 {
    var i = 0;
    var k = 0;
    var part = 0;
    while (part < 3) {
        i = _rc_digits(s, i, &k);
        if (k == 0) { return 0; }
        part = part + 1;
        if (part < 3) {
            if (i >= hc_n(s) || hc_at(s, i) != 46) { return 0; }
            i = i + 1;
        }
    }
    if (i != hc_n(s)) { return 0; }
    return 1;
}
fn _rc_is_date(s): i64 {
    var i = 0;
    var k = 0;
    i = _rc_digits(s, i, &k);
    if (k != 4 || i >= hc_n(s) || hc_at(s, i) != 45) { return 0; }
    i = _rc_digits(s, i + 1, &k);
    if (k != 2 || i >= hc_n(s) || hc_at(s, i) != 45) { return 0; }
    i = _rc_digits(s, i + 1, &k);
    if (k != 2 || i != hc_n(s)) { return 0; }
    return 1;
}

# Read the command line (at most `maxpos` positionals) and resolve the defaults (finish()).
fn rc_finish(date, maxpos): i64 {
    hc_parse(RC_PROG, RC_USAGE, maxpos);
    var missing = vec_new();
    if (hc_optv("ver") == 0) { vec_push(missing, hc_s("--ver")); }
    if (date == 1 && hc_optv("date") == 0) { vec_push(missing, hc_s("--date")); }
    if (vec_len(missing) > 0) {
        _hc_usage_err(RC_PROG, RC_USAGE, hc_ccat("the following arguments are required: ", hc_join(missing, ", ")));
    }
    RC_VER = hc_optv("ver");
    if (_rc_is_ver(RC_VER) == 0) { rc_exit(hc_ccat("--ver must be X.Y.Z, got ", hc_pyrepr(RC_VER))); }
    if (date == 1) {
        RC_DATE = hc_optv("date");
        if (_rc_is_date(RC_DATE) == 0) { rc_exit(hc_ccat("--date must be YYYY-MM-DD, got ", hc_pyrepr(RC_DATE))); }
    }
    var repo = hc_optv("repo");
    if (repo == 0) { repo = hc_getenv_ne("CYRIUS_REPO"); }
    if (repo == 0) { repo = hc_repo_root(0); }
    if (repo == 0) {
        rc_exitc("no cyrius checkout here (run it from the checkout, or pass --repo DIR / set CYRIUS_REPO)");
    }
    RC_REPO = hc_abspath(repo);
    var c6 = hc_optv("c6");
    if (c6 == 0) { c6 = hc_scratch(); }
    RC_C6 = hc_abspath(c6);
    RC_TAG = hc_replace(RC_VER, hc_s("."), hc_s(""));
    if (hc_optv("dry") == 1) { RC_DRY = 1; }
    return 0;
}

# <c6>/<tag>_<name>
fn rc_in_c6(namec): i64 {
    var sb = hc_sb();
    hc_sba(sb, RC_TAG);
    hc_sbc(sb, "_");
    hc_sbc(sb, namec);
    return hc_join2(RC_C6, hc_sbend(sb));
}

# A UTF-8 text file read as Python's open(path, encoding='utf-8').read() reads it; a file that
# cannot be read (or decoded) ends the step, exit 1.
fn rc_rd(path): i64 {
    var s = hc_read(hc_cstr(path));
    if (s == 0) { rc_exit(hc_cat3(hc_ccat(RC_PROG, ": "), path, hc_s(": cannot read (no such file?)"))); }
    if (hc_utf8_ok(s) == 0) { rc_exit(hc_cat3(hc_ccat(RC_PROG, ": "), path, hc_s(": not valid UTF-8"))); }
    return hc_univ_nl(s);
}

# Write `s` to `path` unless dry: an existing file is replaced atomically (its mode kept), a new one
# created.
fn rc_wr(path, s, dry): i64 {
    if (dry == 1) { return 0; }
    var r = 0;
    if (hc_exists(hc_cstr(path)) == 1) { r = hc_replace_file(hc_cstr(path), s); }
    else { r = hc_write_new(hc_cstr(path), s); }
    if (r != 0) { rc_exit(hc_cat3(hc_ccat(RC_PROG, ": "), path, hc_s(": cannot write"))); }
    return 0;
}

# ── JSON with Python's semantics ─────────────────────────────────────────────────────────

fn rc_json(path): i64 {
    var v = bayan_json_v_parse(rc_rd(path));
    if (v == 0) {
        rc_exit(hc_cat3(hc_ccat(RC_PROG, ": "), path, hc_ccat(": invalid JSON: ", hc_s(bayan_json_last_error()))));
    }
    return v;
}
fn rc_jsonc(pathc): i64 { return rc_json(hc_s(pathc)); }

# The JSON value `v` at key `k` (a C string) of an object, Python's dict[k] (the LAST duplicate
# wins), or 0 when the key is absent.
fn rc_jget(obj, k): i64 {
    if (obj == 0 || bayan_json_v_is_obj(obj) == 0) { return 0; }
    var r = 0;
    var i = 0;
    while (i < bayan_json_v_obj_len(obj)) {
        if (hc_eqc(bayan_json_v_obj_key(obj, i), k) == 1) { r = bayan_json_v_obj_val(obj, i); }
        i = i + 1;
    }
    return r;
}
fn rc_jhas(obj, k): i64 {
    if (rc_jget(obj, k) != 0) { return 1; }
    return 0;
}

# dict.items(): [key, value] pairs, each key once at its first position with its last value.
fn rc_jitems(obj): i64 {
    var out = vec_new();
    if (obj == 0 || bayan_json_v_is_obj(obj) == 0) { return out; }
    var i = 0;
    while (i < bayan_json_v_obj_len(obj)) {
        var k = bayan_json_v_obj_key(obj, i);
        var seen = 0;
        var j = 0;
        while (j < vec_len(out)) {
            if (hc_eq(vec_get(vec_get(out, j), 0), k) == 1) {
                vec_set(vec_get(out, j), 1, bayan_json_v_obj_val(obj, i));
                seen = 1;
                break;
            }
            j = j + 1;
        }
        if (seen == 0) {
            var p = vec_new();
            vec_push(p, k);
            vec_push(p, bayan_json_v_obj_val(obj, i));
            vec_push(out, p);
        }
        i = i + 1;
    }
    return out;
}

fn rc_jlen(arr): i64 {
    if (arr == 0 || bayan_json_v_is_arr(arr) == 0) { return 0; }
    return bayan_json_v_arr_len(arr);
}
fn rc_jat(arr, i): i64 { return bayan_json_v_arr_get(arr, i); }

# Python str(v) of a JSON value (what an f-string prints): a str as it is, an int in decimal, a
# bool True / False, null None, a list or dict as Python's repr (a float as JSON writes it).
fn rc_jstr(v): i64 {
    if (v == 0) { return hc_s("None"); }
    if (bayan_json_v_is_str(v) == 1) { return bayan_json_v_str(v); }
    return _rc_jrepr(v);
}
fn _rc_jrepr(v): i64 {
    if (v == 0 || bayan_json_v_is_null(v) == 1) { return hc_s("None"); }
    if (bayan_json_v_is_str(v) == 1) { return hc_pyrepr(bayan_json_v_str(v)); }
    if (bayan_json_v_is_int(v) == 1) { return hc_itoa(bayan_json_v_int(v)); }
    if (bayan_json_v_is_bool(v) == 1) {
        if (bayan_json_v_bool(v) != 0) { return hc_s("True"); }
        return hc_s("False");
    }
    if (bayan_json_v_is_float(v) == 1) { return hc_s(bayan_json_v_build(v)); }
    var sb = hc_sb();
    if (bayan_json_v_is_arr(v) == 1) {
        hc_sbc(sb, "[");
        var i = 0;
        while (i < rc_jlen(v)) {
            if (i > 0) { hc_sbc(sb, ", "); }
            hc_sba(sb, _rc_jrepr(rc_jat(v, i)));
            i = i + 1;
        }
        hc_sbc(sb, "]");
        return hc_sbend(sb);
    }
    var it = rc_jitems(v);
    hc_sbc(sb, "{");
    var j = 0;
    while (j < vec_len(it)) {
        if (j > 0) { hc_sbc(sb, ", "); }
        hc_sba(sb, hc_pyrepr(vec_get(vec_get(it, j), 0)));
        hc_sbc(sb, ": ");
        hc_sba(sb, _rc_jrepr(vec_get(vec_get(it, j), 1)));
        j = j + 1;
    }
    hc_sbc(sb, "}");
    return hc_sbend(sb);
}

# d[k] that must be there (Python: a KeyError ends the step).
fn rc_jreq(obj, k): i64 {
    var v = rc_jget(obj, k);
    if (v == 0) { rc_exit(hc_cat3(hc_ccat(RC_PROG, ": KeyError: "), hc_pyrepr(hc_s(k)), hc_s(""))); }
    return v;
}
# str(d[k])
fn rc_jreqs(obj, k): i64 { return rc_jstr(rc_jreq(obj, k)); }

# A JSON value compared as Python compares them for `==` / `in` (ints and strings; others never).
fn rc_jeq(a, b): i64 {
    if (bayan_json_v_is_int(a) == 1 && bayan_json_v_is_int(b) == 1) {
        if (bayan_json_v_int(a) == bayan_json_v_int(b)) { return 1; }
        return 0;
    }
    if (bayan_json_v_is_str(a) == 1 && bayan_json_v_is_str(b) == 1) {
        return hc_eq(bayan_json_v_str(a), bayan_json_v_str(b));
    }
    return 0;
}
