# wc — count lines, words, bytes from stdin
# Usage: cat file | ./wc
#
# Output is GNU `wc`'s: the three counts right-justified to the widest of them, one space
# apart, so no two fields ever touch. 6.7.12: each count was padded to 8 columns with no
# separator, so a count of 8 or more digits fused with the one before it (a 10,000,000-byte
# word printed `       0       110000000`), and words split on space, tab, LF and CR only —
# VT and FF, which C `isspace` (GNU `wc`, C locale) counts, joined words. CHANGELOG [6.7.12]

# The C `isspace` set: tab, LF, VT, FF, CR (9-13) and space.
fn is_ws(c: i64): i64 {
    if (c == 32) { return 1; }
    if (c >= 9 && c <= 13) { return 1; }
    return 0;
}

# The number of decimal digits in `n` (n >= 0).
fn num_width(n: i64): i64 {
    var w: i64 = 1;
    while (n >= 10) {
        n = n / 10;
        w += 1;
    }
    return w;
}

# Write `n` right-justified in `width` columns.
fn print_num(n: i64, width: i64): i64 {
    var dbuf[32];
    var i: i64 = 31;
    if (n == 0) { store8(&dbuf + i, 48); i -= 1; }
    while (n > 0) {
        store8(&dbuf + i, 48 + n % 10);
        i -= 1;
        n = n / 10;
    }
    while (31 - i < width) {
        store8(&dbuf + i, 32);
        i -= 1;
    }
    syscall(1, 1, &dbuf + i + 1, 31 - i);
    return 0;
}

fn wc(): i64 {
    var buf[4096];
    var lines: i64 = 0;
    var words: i64 = 0;
    var bytes: i64 = 0;
    var in_word: i64 = 0;
    var go: i64 = 1;
    while (go == 1) {
        var n: i64 = syscall(0, 0, &buf, 4096);
        if (n <= 0) { go = 0; }
        if (go == 1) {
            var j: i64 = 0;
            while (j < n) {
                var c: i64 = load8(&buf + j);
                bytes += 1;
                if (c == 10) { lines += 1; }
                if (is_ws(c) == 1) {
                    in_word = 0;
                } else {
                    if (in_word == 0) {
                        words += 1;
                        in_word = 1;
                    }
                }
                j += 1;
            }
        }
    }
    # The widest count sets every field's width (bytes is never smaller than the other two).
    var width: i64 = num_width(bytes);
    print_num(lines, width);
    syscall(1, 1, " ", 1);
    print_num(words, width);
    syscall(1, 1, " ", 1);
    print_num(bytes, width);
    syscall(1, 1, "\n", 1);
    return 0;
}

wc();
syscall(60, 0);
