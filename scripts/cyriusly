#!/bin/sh
# cyriusly — Cyrius version manager ("Language Yare")
#
# Yare (adj): quick, agile, responsive — the ship answers the helm.
# Like rustup, pyenv, rbenv: manages installed Cyrius versions.
CYRIUS_HOME="${CYRIUS_HOME:-$HOME/.cyrius}"

current() { cat "$CYRIUS_HOME/current" 2>/dev/null || echo "none"; }

# v6.6.6: replace each link IN PLACE — never remove the live one first, and both or neither.
#
# ⛔ `rm -rf "$CYRIUS_HOME/bin" "$CYRIUS_HOME/lib"` + two `ln -sf` left the user with NO
# ~/.cyrius/bin in between: measured with a watching process, that shape showed the link ABSENT
# in 464,025 of 977,258 checks (47 %), and anything failing in the window left it that way. The
# `-n` in `ln -sfn` is also what the old `rm -rf` was really for: without it `ln -sf` creates the
# link INSIDE the directory the destination symlink points at, which is the hazard the comment
# here used to describe. A legacy REAL directory (a pre-v5.7.22 copy install) is the one case
# that still has to be removed, and it is now the only thing removed.
# Same fix as programs/cyriusly.cyr `_cmd_use_v2` and scripts/install.sh. CHANGELOG [6.6.6]
relink_one() {   # relink_one <target> <link>
    if [ -d "$2" ] && [ ! -L "$2" ]; then rm -rf "$2" || return 1; fi
    ln -sfn "$1" "$2"
}

link_version() {
    ver="$1"
    old_bin=""
    [ -L "$CYRIUS_HOME/bin" ] && old_bin=$(readlink "$CYRIUS_HOME/bin")
    relink_one "$CYRIUS_HOME/versions/$ver/bin" "$CYRIUS_HOME/bin" || return 1
    if ! relink_one "$CYRIUS_HOME/versions/$ver/lib" "$CYRIUS_HOME/lib"; then
        # new binaries over an old stdlib is worse than not switching: put bin back — and when
        # there was nothing there before, take the link we just made away again, so the caller's
        # "nothing was changed" is true rather than nearly true
        if [ -n "$old_bin" ]; then relink_one "$old_bin" "$CYRIUS_HOME/bin"
        elif [ -L "$CYRIUS_HOME/bin" ] && [ "$(readlink "$CYRIUS_HOME/bin")" = "$CYRIUS_HOME/versions/$ver/bin" ]; then
            rm -f "$CYRIUS_HOME/bin"
        fi
        return 1
    fi
    return 0
}

case "${1:-help}" in
    version|--version|-v)
        echo "cyriusly $(current)"
        ;;

    list|ls)
        echo "Installed versions:"
        cur=$(current)
        for d in "$CYRIUS_HOME/versions"/*/; do
            [ -d "$d" ] || continue
            v=$(basename "$d")
            if [ "$v" = "$cur" ]; then
                echo "  * $v (active)"
            else
                echo "    $v"
            fi
        done
        ;;

    use)
        [ -z "$2" ] && echo "Usage: cyriusly use <version>" && exit 1
        [ ! -d "$CYRIUS_HOME/versions/$2" ] && echo "Version $2 not installed." && exit 1
        # v6.6.6: links FIRST, then `current` — `current` names the version the links serve, so
        # writing it first published a version the links might never reach — and say nothing
        # about "using" a version we could not switch to. CHANGELOG [6.6.6]
        if ! link_version "$2"; then
            echo "error: could not re-point $CYRIUS_HOME/bin + lib at $2 — nothing was changed" >&2
            exit 1
        fi
        echo "$2" > "$CYRIUS_HOME/current"
        echo "Now using Cyrius $2"
        ;;

    install)
        [ -z "$2" ] && echo "Usage: cyriusly install <version>" && exit 1
        echo "Installing Cyrius $2..."
        # CYRIUS_VERSION must be set on the `sh` invocation (the
        # consumer of install.sh's env), not on `curl` (whose env
        # is consumed and discarded before the pipe). Pre-fix the
        # env var leaked into curl-only and `sh` ran install.sh
        # without seeing it → resolved "latest" from GitHub API.
        #
        # CVE-21 (v6.2.30): fetch install.sh from the immutable TAG ($2),
        # not the mutable `main` branch. Pre-fix, a main-branch compromise
        # instantly hit every `cyriusly install` even when pinning a tag —
        # the installer and the release it installs now come from the same
        # immutable ref. ($2 is always a concrete version here; the empty
        # check above already rejected the no-arg form.)
        curl -sSf "https://raw.githubusercontent.com/MacCracken/cyrius/$2/scripts/install.sh" | CYRIUS_VERSION="$2" sh
        ;;

    setup)
        # v5.7.36: install Cyrius from the current repo checkout. Closes
        # the fresh-checkout UX gap — pre-v5.7.36 the only `cyriusly`-
        # native install path was `cyriusly install <ver>`, which curls
        # install.sh from main and re-clones the repo via tarball or
        # `git clone --depth 1`. None of the existing verbs reused an
        # already-checked-out tree, so a fresh box that had cloned the
        # repo (e.g. for development) had to remember `sh scripts/
        # install.sh` and bypass `cyriusly` entirely.
        #
        # `cyriusly setup` requires being run from a Cyrius repo
        # checkout (VERSION + cyrius.cyml + scripts/install.sh). It
        # bootstraps the seed if `build/cycc` is missing, builds the
        # release tools listed in `cyrius.cyml [release]` from the
        # local `build/cycc`, and then delegates to `install.sh
        # --refresh-only` to populate `~/.cyrius/versions/$VERSION/`
        # and re-link `~/.cyrius/bin`.
        # v6.6.4: if VERSION is a CUT RELEASE and the checkout has moved past its tag,
        # install.sh refuses (a released slot is written from the tag only) — check out
        # the tag, bump VERSION, or point CYRIUS_HOME at a throwaway.
        if [ ! -f "VERSION" ] || [ ! -f "cyrius.cyml" ] || [ ! -f "scripts/install.sh" ]; then
            echo "error: cyriusly setup must run from a Cyrius repo checkout"
            echo "       (expected VERSION, cyrius.cyml, and scripts/install.sh in cwd)"
            exit 1
        fi

        VERSION="$(tr -d '[:space:]' < VERSION)"
        echo "Setting up Cyrius $VERSION from $(pwd)..."

        # Bootstrap the seed if cycc isn't present.
        if [ ! -x "build/cycc" ]; then
            echo "  build/cycc not found — running bootstrap/bootstrap.sh..."
            sh bootstrap/bootstrap.sh || { echo "error: bootstrap failed"; exit 1; }
            chmod +x build/cycc 2>/dev/null || true
            if [ ! -x "build/cycc" ]; then
                echo "error: bootstrap did not produce build/cycc"
                exit 1
            fi
        fi

        # Parse [release].bins, [release].cross_bins from cyrius.cyml.
        # Same shape install.sh uses for the source-bootstrap fallback,
        # inlined here so this verb doesn't depend on install.sh helpers
        # (which only get sourced when install.sh is invoked).
        _setup_parse_release_array() {
            awk -v k="$1" '
                /^\[release\]/ { in_r = 1; next }
                in_r && /^\[/ { exit }
                in_r && $1 == k {
                    sub(/^[^=]+= \[/, ""); sub(/\].*$/, "")
                    gsub(/[",]/, " "); gsub(/ +/, " ")
                    sub(/^ +/, ""); sub(/ +$/, ""); print; exit
                }' cyrius.cyml
        }
        _BINS=$(_setup_parse_release_array bins)
        _CROSS_BINS=$(_setup_parse_release_array cross_bins)

        # Build any missing release tools from build/cycc. cycc itself
        # already exists; cyrius lives in cbt/, all others in programs/.
        echo "  building release tools..."
        _built=0
        for tool in $_BINS; do
            [ "$tool" = "cycc" ] && continue
            [ -x "build/$tool" ] && continue
            if [ "$tool" = "cyrius" ] && [ -f "cbt/cyrius.cyr" ]; then
                cat "cbt/cyrius.cyr" | ./build/cycc > "build/$tool" && \
                    chmod +x "build/$tool" && _built=$((_built + 1))
            elif [ -f "programs/${tool}.cyr" ]; then
                cat "programs/${tool}.cyr" | ./build/cycc > "build/$tool" && \
                    chmod +x "build/$tool" && _built=$((_built + 1))
            fi
        done
        for tool in $_CROSS_BINS; do
            [ -x "build/$tool" ] && continue
            if [ "$tool" = "cycc_aarch64" ] && [ -f "src/main_aarch64.cyr" ]; then
                cat "src/main_aarch64.cyr" | ./build/cycc > "build/$tool" && \
                    chmod +x "build/$tool" && _built=$((_built + 1))
            fi
        done
        echo "  built $_built tool(s)"

        # Delegate to install.sh --refresh-only. It copies build/* +
        # lib/*.cyr + scripts named in [release].scripts into
        # ~/.cyrius/versions/$VERSION/ and re-links ~/.cyrius/bin.
        echo "  refreshing install snapshot..."
        sh scripts/install.sh --refresh-only || { echo "error: install.sh --refresh-only failed"; exit 1; }
        echo ""
        echo "Done. Cyrius $VERSION installed from local checkout."
        echo "  ~/.cyrius/bin/ now points at versions/$VERSION/bin/"
        echo "  ensure ~/.cyrius/bin is on PATH (install.sh adds it to .zshrc / .bashrc on first install)"
        ;;

    uninstall)
        [ -z "$2" ] && echo "Usage: cyriusly uninstall <version>" && exit 1
        cur=$(current)
        if [ "$2" = "$cur" ]; then
            echo "Cannot uninstall active version. Switch first: cyriusly use <other>"
            exit 1
        fi
        if [ -d "$CYRIUS_HOME/versions/$2" ]; then
            rm -rf "$CYRIUS_HOME/versions/$2"
            echo "Uninstalled Cyrius $2"
        else
            echo "Version $2 not installed."
        fi
        ;;

    which)
        echo "$CYRIUS_HOME/versions/$(current)/bin/cycc"
        ;;

    home)
        echo "$CYRIUS_HOME"
        ;;

    update)
        echo "Checking for updates..."
        LATEST=$(curl -sSf "https://api.github.com/repos/MacCracken/cyrius/releases/latest" 2>/dev/null | \
            grep '"tag_name"' | sed 's/.*"tag_name": *"\([^"]*\)".*/\1/' || echo "")
        CUR=$(current)
        if [ -z "$LATEST" ]; then
            echo "Could not check for updates."
        elif [ "$LATEST" = "$CUR" ]; then
            echo "Already up to date: $CUR"
        else
            echo "Update available: $CUR -> $LATEST"
            echo "Run: cyriusly install $LATEST && cyriusly use $LATEST"
        fi
        ;;

    cmdtools)
        shift
        _CT_ACTION="${1:-list}"
        _CT_TOOL="${2:-}"

        _starship_conf="${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
        _p10k_conf="$HOME/.p10k.zsh"

        # v5.8.0: two-segment cyrius prompt (replaces single 𝕮 segment from
        # v5.7.x). Package side (ॐ Om) shows `name version (repo)` from
        # cyrius.cyml [package]; toolchain side (🌀 cyclone) shows the
        # active cyrius version. Same `cyrius-prompt-info` helper backs both.
        # v5.8.47: colored TEXT on default bg — ॐ Om → forestgreen
        # (#228B22), 🌀 cyclone → light blue (#87CEEB). Pre-v5.8.47 both
        # segments shared bg:teal with fg:base text; the bg collapse hid
        # which side was which. Now the colored TEXT itself differentiates
        # the segments — no background fill, no visual conflict with the
        # rest of the prompt.
        # ASCII fallback for emoji-hostile terminals: change `symbol = "🌀"`
        # to `symbol = "𝕮"` in starship.toml and `🌀` → `𝕮` / `ॐ` → `[C]`
        # in p10k.zsh — both are inline edits to the user's own config.
        _CYRIUS_STARSHIP='[custom.cyrius_pkg]
command = "cyrius-prompt-info pkg"
when = "test -f cyrius.cyml"
symbol = "ॐ"
style = "fg:#228B22"
format = '"'"'[[ $symbol $output ](fg:#228B22)]($style)'"'"'
detect_files = ["cyrius.cyml"]

[custom.cyrius]
command = "cyrius-prompt-info tool"
when = "test -f cyrius.cyml || test -f cyrius.toml"
symbol = "🌀"
style = "fg:#87CEEB"
format = '"'"'[[ | $symbol $output ](fg:#87CEEB)]($style)'"'"'
detect_files = ["cyrius.cyml", "cyrius.toml"]'

        _CYRIUS_P10K='# Cyrius prompt segment (v5.8.0: ॐ pkg + 🌀 toolchain;
# v5.8.47: colored TEXT on default bg — ॐ Om → forestgreen, 🌀 cyclone → light blue)
function prompt_cyrius() {
  if [[ -f cyrius.cyml ]] || [[ -f cyrius.toml ]]; then
    local pkg=$(cyrius-prompt-info pkg 2>/dev/null)
    local tool=$(cyrius-prompt-info tool 2>/dev/null)
    if [[ -n "$pkg" ]]; then
      p10k segment -f 28 -t "ॐ $pkg"
      p10k segment -f 117 -t "| 🌀 $tool"
    elif [[ -n "$tool" ]]; then
      p10k segment -f 117 -t "🌀 $tool"
    fi
  fi
}'

        case "$_CT_ACTION" in
            list)
                echo "cmdtools integrations:"
                if grep -q "custom.cyrius" "$_starship_conf" 2>/dev/null; then
                    echo "  * starship  (installed)"
                elif command -v starship > /dev/null 2>&1; then
                    echo "    starship  (available, not configured)"
                fi
                if grep -q "prompt_cyrius" "$_p10k_conf" 2>/dev/null; then
                    echo "  * p10k      (installed)"
                elif [ -f "$_p10k_conf" ]; then
                    echo "    p10k      (available, not configured)"
                fi
                ;;
            install|add)
                case "$_CT_TOOL" in
                    starship)
                        if ! command -v starship > /dev/null 2>&1; then
                            echo "error: starship not installed"
                            exit 1
                        fi
                        # v6.0.36: resolve a symlinked config to its real
                        # target before editing. `sed -i` on a symlink
                        # replaces the link with a regular file, breaking
                        # dotfile management (chezmoi/stow/hapi); operating on
                        # the target preserves the link and edits the tracked
                        # file in place. Also take a `.bak` first — the prior
                        # behavior left no recovery point (issue 2026-05-20).
                        _starship_target="$_starship_conf"
                        if [ -L "$_starship_conf" ]; then
                            _starship_link=$(readlink "$_starship_conf")
                            case "$_starship_link" in
                                /*) _starship_target="$_starship_link" ;;
                                *)  _starship_target="$(dirname "$_starship_conf")/$_starship_link" ;;
                            esac
                        fi
                        if [ -e "$_starship_target" ]; then
                            cp "$_starship_target" "$_starship_target.bak" 2>/dev/null && \
                                echo "  (backed up existing config -> $_starship_target.bak)"
                        fi
                        # v5.8.0: clean up BOTH the legacy single-segment
                        # block (`[custom.cyrius]` from v5.7.x) AND the
                        # new package segment (`[custom.cyrius_pkg]`).
                        # Each `[custom.X]` block runs to the next blank
                        # line per the existing convention.
                        if grep -qE "custom\.cyrius(_pkg)?" "$_starship_target" 2>/dev/null; then
                            sed -i '/\[custom\.cyrius_pkg\]/,/^$/d' "$_starship_target"
                            sed -i '/\[custom\.cyrius\]/,/^$/d' "$_starship_target"
                        fi
                        echo "" >> "$_starship_target"
                        echo "$_CYRIUS_STARSHIP" >> "$_starship_target"
                        echo "starship: Cyrius segments (cyrius_pkg + cyrius) installed in $_starship_target"
                        ;;
                    p10k|powerlevel10k)
                        if [ ! -f "$_p10k_conf" ]; then
                            echo "error: ~/.p10k.zsh not found (run p10k configure first)"
                            exit 1
                        fi
                        if grep -q "prompt_cyrius" "$_p10k_conf" 2>/dev/null; then
                            echo "p10k: Cyrius segment already installed"
                        else
                            echo "" >> "$_p10k_conf"
                            echo "$_CYRIUS_P10K" >> "$_p10k_conf"
                            echo "p10k: Cyrius segment installed in $_p10k_conf"
                            echo "  Add 'cyrius' to POWERLEVEL9K_RIGHT_PROMPT_ELEMENTS in ~/.p10k.zsh"
                        fi
                        ;;
                    *)
                        echo "Available tools: starship, p10k"
                        ;;
                esac
                ;;
            remove)
                case "$_CT_TOOL" in
                    starship)
                        # Symlink-safe (see the install path, v6.0.36): edit
                        # the link target so dotfile-managed configs keep
                        # their symlink instead of being replaced by sed -i.
                        _starship_target="$_starship_conf"
                        if [ -L "$_starship_conf" ]; then
                            _starship_link=$(readlink "$_starship_conf")
                            case "$_starship_link" in
                                /*) _starship_target="$_starship_link" ;;
                                *)  _starship_target="$(dirname "$_starship_conf")/$_starship_link" ;;
                            esac
                        fi
                        if grep -qE "custom\.cyrius(_pkg)?" "$_starship_target" 2>/dev/null; then
                            sed -i '/\[custom\.cyrius_pkg\]/,/^$/d' "$_starship_target"
                            sed -i '/\[custom\.cyrius\]/,/^$/d' "$_starship_target"
                            echo "starship: Cyrius segments removed"
                        else
                            echo "starship: no Cyrius segment found"
                        fi
                        ;;
                    p10k|powerlevel10k)
                        if grep -q "prompt_cyrius" "$_p10k_conf" 2>/dev/null; then
                            sed -i '/# Cyrius prompt segment/,/^}/d' "$_p10k_conf"
                            echo "p10k: Cyrius segment removed"
                        else
                            echo "p10k: no Cyrius segment found"
                        fi
                        ;;
                    *)
                        echo "Available tools: starship, p10k"
                        ;;
                esac
                ;;
            *)
                echo "Usage: cyriusly cmdtools [list|install|remove] [starship|p10k]"
                ;;
        esac
        ;;

    help|--help|-h)
        echo "cyriusly - Cyrius version manager"
        echo ""
        echo "USAGE:"
        echo "    cyriusly <command> [args]"
        echo ""
        echo "COMMANDS:"
        echo "    version             Show active version"
        echo "    list                List installed versions"
        echo "    use <version>       Switch to a version"
        echo "    install <version>   Download and install a version"
        echo "    setup               Install from current repo checkout (no download)"
        echo "    uninstall <version> Remove a version"
        echo "    update              Check for new versions"
        echo "    which               Show path to active compiler"
        echo "    home                Show install directory"
        echo "    cmdtools [action]   Manage prompt integrations (starship, p10k)"
        echo "    help                Show this help"
        echo ""
        echo "EXAMPLES:"
        echo "    cyriusly install <version>   # e.g. the latest release tag"
        echo "    cyriusly setup               # install from cwd (must be a repo checkout)"
        echo "    cyriusly use <version>       # switch the active toolchain"
        echo "    cyriusly cmdtools install starship"
        echo "    cyriusly cmdtools list"
        ;;

    *)
        echo "Unknown command: $1"
        echo "Run 'cyriusly help' for usage."
        exit 1
        ;;
esac
