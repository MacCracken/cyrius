# v5.6.8 O2 category 2: flag-result-reuse tracker. Declared on both
# backends so shared parse_ctrl.cyr links cleanly. On aarch64 the
# arith emits (EADDR/ESUBR/EANDR/etc.) use the non-S-variant opcodes
# (`add`/`sub`/`and` — no flag side-effect), so this flag never goes
# true and ECONDCMP's `if (_flags_reflect_rax == 0) { ETESTAZ(S); }`
# always emits the test — identical behavior to pre-v5.6.8. Future
# aarch64 work that switches to `adds`/`subs` (e.g. checked overflow
# from v5.6.2) can start setting this flag and the peephole fires.
var _flags_reflect_rax = 0;

# v5.6.9 O2 category 3: redundant push/pop elimination. Tracks CP
# immediately after the last EPUSHR/ESPILL. If the very next emit is
# EPOPR/EUNSPILL with CP unchanged (i.e. nothing emitted between push
# and pop), both the push and the pop are no-ops — rewind CP past the
# push instead of emitting the pop. `-1` = no recent push / invalidated.
# aarch64 push/pop are 4-byte instructions (vs 1 byte on x86).
var _last_push_cp = 0 - 1;

# v5.6.10 O2 category 4 — commutative-combine shuttle trackers.
# Declared as stubs in v5.6.10 for the shared parse.cyr dispatch;
# v5.6.11 wires them on aarch64 too. Despite aarch64's 3-register
# op encoding (ADD x0, x1, x0), `parse.cyr`'s combine codegen is
# shared and emits the same 12-byte trailer (`mov x1,x0` + `ldr
# x0,[sp],#16` + `add x0,x0,x1`) as the x86 7-byte shuttle. The
# v5.6.11 fix rewinds 8 B past mov+pop and replaces them with
# `ldr x1,[sp],#16` (EPOPC encoding 0xF84107E1, 4 B), netting
# 12 → 8 B per commutative-op site. 4419 sites in v5.6.10
# cc5_aarch64 (ADD 4021, AND 266, ORR 95, MUL 35, EOR 2).
var _last_emovca_cp = 0 - 1;
var _last_movca_popr_cp = 0 - 1;

# ================================================================
# AARCH64 CODE EMISSION (writes to codebuf at S+0x20000+CP)
# ================================================================
# All instructions are 32-bit (4 bytes), little-endian.
# Register mapping: x0=rax(result), x1=rcx(scratch), x0-x7=args
# x9-x15 = temporaries, x29=fp(rbp), x30=lr, sp=rsp

# Target format: 0=ELF (Linux), 2=Mach-O ARM64 (macOS)
var _TARGET_MACHO = 0;

# PE32+ (Windows x86_64) output target is x86-only — declared here
# as an always-zero shim so `src/frontend/parse.cyr`'s `_TARGET_PE`
# reference (for the `syscall(60)` Win32 reroute) resolves when
# compiling the aarch64-backed entry points (`main_aarch64*.cyr`).
# Mirrors the parallel `_TARGET_MACHO` declaration pattern between
# the two backends. The `if (_TARGET_PE == 1)` branches in parse.cyr
# are statically dead on aarch64 targets — Windows PE is x86_64 only.
var _TARGET_PE = 0;
# ELF64 kernel target — x86-only concern (AGNOS kernel build for
# UEFI x86_64 boot). Declared here as always-zero shim so any future
# shared parser/codegen reference to _TARGET_ELF64_KERNEL resolves
# when compiling the aarch64-backed entry points. Statically dead on
# aarch64 — aarch64 kernel emit (aarch64/fixup.cyr EMITELF_KERNEL) is
# already ELF64 by definition of the target architecture.
var _TARGET_ELF64_KERNEL = 0;
# v5.11.47: UEFI Application PE emit marker. x86-only by construction
# (only the x86 PE backend has _TARGET_PE wired). Declared here as
# always-zero shim so shared parser/codegen references resolve when
# compiling the aarch64-backed entry points.
var _TARGET_EFI_APPLICATION = 0;
# v5.7.12: cx (cyrius-x bytecode) backend marker. =0 on aarch64
# emit (this file); =1 only on backend/cx/emit.cyr. See path B
# notes in docs/audit/2026-04-27-cx-direct-emit-inventory.md.
var _TARGET_CX = 0;

# No-op shim for the PE pending-imports helper, same reasoning:
# `parse.cyr` calls `_pe_pending_imp_add` from the `#pe_import`
# directive handler unconditionally so the compile-time name
# resolves. aarch64-backed `main_*.cyr` entry points don't include
# `src/backend/pe/emit.cyr`, so the real helper isn't available —
# this stub is. Harmless: `#pe_import` on aarch64 outputs is a no-op
# because Windows PE is x86_64 only.
fn _pe_pending_imp_add(S, name): i64 {
    return 0;
}

# No-op shim for the Win64 `syscall(1)` rerouting helper (v5.4.7).
# Same rationale as the `_pe_pending_imp_add` shim above: parse.cyr
# calls `EWRITE_PE` unconditionally inside its `_TARGET_PE == 1`
# branch, so the compile-time symbol must resolve when the aarch64
# backend builds. The branch is statically dead at runtime because
# `_TARGET_PE` is always 0 on aarch64 targets.
fn EWRITE_PE(S): i64 {
    return 0;
}

# v5.6.6 aarch64 stub for the CYRIUS_PROF GetTickCount64 reroute in
# parse_expr.cyr's `_TARGET_PE == 1 && sc_num == 228` branch. Same
# rationale as EWRITE_PE above — statically dead on aarch64 but
# must resolve at link time.
fn EGETTICKS_PE(S): i64 {
    return 0;
}

# v5.8.54 — completing the PE-shim cohort. Same justification as
# EWRITE_PE / EGETTICKS_PE above: parse_expr.cyr (lines ~564-590)
# emits these unconditionally inside its `if (_TARGET_PE == 1)`
# branch — Win64 syscall reroutes for read/open/close/lseek/mmap.
# `_TARGET_PE` is always 0 on aarch64 so the branch is statically
# dead at runtime, but cc5's symbol resolution still requires the
# fns to exist at compile time. Pre-v5.8.54 only EWRITE_PE +
# EGETTICKS_PE had stubs here — the others (read/open/close/lseek/
# mmap) were defined ONLY in `src/backend/x86/emit.cyr`, surfacing
# as five "undefined function ... (will crash at runtime)" cc5
# warnings on every aarch64 cross-build. Latent issue (dead branches
# never executed) but exactly the kind of half-fix the user has
# called out — landing the cohort closes the symmetry gap.
fn EREAD_PE(S)   { return 0; }
fn EOPEN_PE(S)   { return 0; }
fn ECLOSE_PE(S)  { return 0; }
fn ELSEEK_PE(S)  { return 0; }
fn EMMAP_PE(S)   { return 0; }

# Marker that the aarch64 backend is present in this compiler binary.
# Checked by EMITMACHO_ARM64 to refuse Mach-O ARM output when accidentally
# invoked through the x86 backend (which would emit x86 code inside an
# arm64 Mach-O header — silently broken, SIGILLs on Apple Silicon).
var _AARCH64_BACKEND = 1;

# Emit one byte to codebuf
# v5.7.34: cap raised 524288 → 3145728 to match the v5.7.27
# codebuf grow on x86 (`src/backend/x86/emit.cyr:68`). v5.7.27
# missed the aarch64 EB, so cc5_aarch64 was still rejecting
# programs > 512 KB even though the heap region grew to 3 MB.
# Phylax-surfaced when a downstream cross-build with phylax-
# shape program tripped `error: codebuf overflow (.../524288)`
# on aarch64 while the same source built fine on x86.
fn EB(S, b): i64 {
    var cp = GCP(S);
    if (cp >= 3145728) {
        syscall(SYS_WRITE, 2, "error: codebuf overflow (", 25);
        PRNUM(cp);
        syscall(SYS_WRITE, 2, "/3145728 bytes) — program too large for single compilation\n", 60);
        syscall(SYS_EXIT, 1);
    }
    store8(S + 0x64A000 + cp, b & 0xFF);
    SCP(S, cp + 1);
    return 0;
}

# Emit 32-bit instruction word (little-endian).
# v5.4.19: alignment assert. aarch64 instructions must land on a
# 4-byte boundary; the hardware decoder assumes this. Any prior
# emit sequence that leaves the code position at a non-multiple-
# of-4 (e.g. a stray x86-leak E2/EB from the shared frontend) would
# produce an undecoded instruction stream. Catch it loudly here
# rather than debugging a SIGILL in the emitted binary. Adds ~7
# LOC per EW call — negligible against the 4 EB calls that follow.
fn EW(S, w): i64 {
    var cp = GCP(S);
    if ((cp & 3) != 0) {
        syscall(SYS_WRITE, 2, "error: EW misaligned at cp=", 27);
        PRNUM(cp);
        syscall(SYS_WRITE, 2, " (not 4-byte boundary; shared parse.cyr leaked x86 bytes to aarch64 stream?)\n", 77);
        syscall(SYS_EXIT, 1);
    }
    EB(S, w & 0xFF);
    EB(S, (w >> 8) & 0xFF);
    EB(S, (w >> 16) & 0xFF);
    EB(S, (w >> 24) & 0xFF);
    return 0;
}

# Emit 2 bytes (for compatibility with x86 E2 calls)
fn E2(S, v): i64 {
    EB(S, v & 0xFF);
    EB(S, v >> 8 & 0xFF);
    return 0;
}

# Emit 8 bytes (for mov imm64 compatibility)
fn E8(S, v): i64 {
    EB(S, v & 0xFF); EB(S, v >> 8 & 0xFF);
    EB(S, v >> 16 & 0xFF); EB(S, v >> 24 & 0xFF);
    EB(S, v >> 32 & 0xFF); EB(S, v >> 40 & 0xFF);
    EB(S, v >> 48 & 0xFF); EB(S, v >> 56 & 0xFF);
    return 0;
}

fn E3(S, v): i64 {
    EB(S, v & 0xFF); EB(S, v >> 8 & 0xFF); EB(S, v >> 16 & 0xFF);
    return 0;
}

# === Move immediate to x0 (result register) ===
# MOVZ x0, #imm16 = 0xD2800000 | (imm16 << 5)
# For 64-bit immediates: MOVZ + MOVK for each 16-bit chunk
fn EMOVI(S, v): i64 {
    # MOVZ x0, #(v & 0xFFFF)
    EW(S, 0xD2800000 | ((v & 0xFFFF) << 5));
    # Emit MOVK for each non-zero 16-bit chunk above the low word.
    # Uses an unsigned bit-extract (not a signed `v > N` comparison),
    # so a negative `v` — whose upper bits are all 1 in two's
    # complement — gets the full 4-instruction sequence. Previously
    # `v > 0xFFFF` short-circuited on negatives, truncating the
    # value to 16 bits (e.g. `-1` became `0xFFFF` = 65535).
    if (((v >> 16) & 0xFFFF) != 0) {
        EW(S, 0xF2A00000 | (((v >> 16) & 0xFFFF) << 5));
    }
    if (((v >> 32) & 0xFFFF) != 0) {
        EW(S, 0xF2C00000 | (((v >> 32) & 0xFFFF) << 5));
    }
    if (((v >> 48) & 0xFFFF) != 0) {
        EW(S, 0xF2E00000 | (((v >> 48) & 0xFFFF) << 5));
    }
    return 0;
}

# === Stack operations ===
# aarch64 has no push/pop — use STP/LDP with SP
# push x0: STR x0, [sp, #-16]! (pre-decrement)
fn EPUSHR(S): i64 { EW(S, 0xF81F0FE0); _last_push_cp = GCP(S); return 0; }   # str x0, [sp, #-16]!
# pop x1 (into scratch): LDR x1, [sp], #16 (post-increment)
fn EPOPC(S): i64 { EW(S, 0xF84107E1); return 0; }     # ldr x1, [sp], #16
# pop x0: LDR x0, [sp], #16 (post-indexed)
fn EPOPR(S): i64 {
    if (GCP(S) == _last_push_cp) {
        # v5.6.9: adjacent push+pop = no-op. Rewind past the 4-byte push.
        SCP(S, GCP(S) - 4);
        _last_push_cp = 0 - 1;
        return 0;
    }
    # v5.6.11: remember if the pop landed immediately after EMOVCA,
    # so a commutative op next can collapse the 12-byte shuttle.
    var after_movca = 0;
    if (GCP(S) == _last_emovca_cp) { after_movca = 1; }
    EW(S, 0xF84107E0);     # ldr x0, [sp], #16
    if (after_movca == 1) { _last_movca_popr_cp = GCP(S); }
    return 0;
}

# === Register moves ===
# mov x1, x0 (scratch = result)
# v5.6.11: record CP post-emit for combine-shuttle peephole.
fn EMOVCA(S): i64 { EW(S, 0xAA0003E1); _last_emovca_cp = GCP(S); return 0; }

# v5.6.11: commutative-combine peephole. If current CP matches the
# GCP recorded when EPOPR/EUNSPILL finished *immediately after*
# EMOVCA, rewind 8 bytes (past `mov x1,x0; ldr x0,[sp],#16`) and
# drop in `ldr x1,[sp],#16` (EPOPC encoding 0xF84107E1, 4 B) — the
# op that follows then reads the correct operand from x1. Only safe
# for commutative ops because the pop-target swap (lhs now in x1,
# rhs still in x0) is the inverse of the original shuttle.
fn _TRY_COMBINE_SHUTTLE(S): i64 {
    if (GCP(S) == _last_movca_popr_cp) {
        SCP(S, GCP(S) - 8);
        EW(S, 0xF84107E1);   # ldr x1, [sp], #16 (matches EPOPC)
        _last_movca_popr_cp = 0 - 1;
    }
    return 0;
}

# === Arithmetic ===
# add x0, x0, x1
fn EADDR(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0x8B010000); return 0; }
# sub x0, x0, x1 — non-commutative, NOT fused (swap inverts subtract).
fn ESUBR(S): i64 { EW(S, 0xCB010000); return 0; }
# mul x0, x0, x1 — commutative.
fn EIMUL(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0x9B017C00); return 0; }
# EMULH: high 64 bits of unsigned x1 * x0 into x0. Used by mulh64(a, b).
fn EMULH(S): i64 { EW(S, 0x9BC07C20); return 0; }     # umulh x0, x1, x0
# sdiv x0, x0, x1
# Division: sdiv x0, x2, x1 (uses saved dividend from ECQO)
fn EIDIV(S): i64 { EW(S, 0x9AC10C40); return 0; }     # sdiv x0, x2, x1
# Save dividend before division: mov x2, x0
fn ECQO(S): i64 { EW(S, 0xAA0003E2); return 0; }      # mov x2, x0
# Modulo: msub x0, x0, x1, x2 (x0 = x2 - x0*x1 = remainder)
fn EMOVDR(S): i64 { EW(S, 0x9B018800); return 0; }    # msub x0, x0, x1, x2

# === Compare ===
# cmp x0, x1 (subs xzr, x0, x1)
fn ECMPR(S): i64 { EW(S, 0xEB01001F); return 0; }     # cmp x0, x1
fn ETESTAZ(S): i64 { EW(S, 0xF100001F); return 0; }  # cmp x0, #0 (sets ZF)
fn EMOVRDXRAX(S): i64 { EW(S, 0xAA0003E2); return 0; }  # mov x2, x0
fn EMOVRA_RDX(S): i64 { EW(S, 0xAA0203E0); return 0; }  # mov x0, x2 (read second return value — aarch64 multi-return uses x0, x2)

# === Load/Store through x1 (pointer register) ===
# ldr x0, [x1]
fn ELODC(S): i64 { EW(S, 0xF9400020); return 0; }     # ldr x0, [x1]
# str x0, [x1]
fn ESTOC(S): i64 { EW(S, 0xF9000020); return 0; }     # str x0, [x1]

# === Load through x0 (dereference) ===
fn ELOAD8(S): i64 { EW(S, 0x39400000); return 0; }    # ldrb w0, [x0]
fn ELOAD16(S): i64 { EW(S, 0x79400000); return 0; }   # ldrh w0, [x0]
fn ELOAD32(S): i64 { EW(S, 0xB9400000); return 0; }   # ldr w0, [x0]
fn ELOAD64(S): i64 { EW(S, 0xF9400000); return 0; }   # ldr x0, [x0]

# === Store: [x1] = x0 (various widths) ===
fn ESTORE8(S): i64 { EW(S, 0x39000020); return 0; }   # strb w0, [x1]
fn ESTORE16(S): i64 { EW(S, 0x79000020); return 0; }  # strh w0, [x1]
fn ESTORE32(S): i64 { EW(S, 0xB9000020); return 0; }  # str w0, [x1]
fn ESTORE64(S): i64 { EW(S, 0xF9000020); return 0; }  # str x0, [x1]

# === Bitwise ===
# v5.6.11: commutative bitwise ops wired to combine-shuttle peephole.
fn EANDR(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0x8A010000); return 0; }
fn EORR(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0xAA010000); return 0; }
fn EXORR(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0xCA010000); return 0; }
fn ENOTR(S): i64 { EW(S, 0xAA2003E0); return 0; }     # mvn x0, x0
fn ESHLCL(S): i64 { EW(S, 0x9AC12000); return 0; }    # lslv x0, x0, x1
fn ESHRCL(S): i64 { EW(S, 0x9AC12400); return 0; }    # lsrv x0, x0, x1
# v5.6.7 O2: shift x0 by immediate (1..63) using UBFM aliases.
# LSL Xd, Xn, #n → UBFM Xd, Xn, #((-n) mod 64), #(63-n)
# LSR Xd, Xn, #n → UBFM Xd, Xn, #n, #63
# Base UBFM imm sf=1: 0xD3400000 | (immr << 16) | (imms << 10)
fn ESHLIMM(S, n): i64 {
    var immr = (64 - n) & 0x3F;
    var imms = (63 - n) & 0x3F;
    EW(S, 0xD3400000 | (immr << 16) | (imms << 10));
    return 0;
}
# v5.8.56: ESHRIMM removed in lockstep with x86 — sibling of ESHLIMM
# (above) that never got a call site.
fn EXORAA(S): i64 { EW(S, 0xCA000000); return 0; }    # eor x0, x0, x0 (zero)

# === mov rdi, rax (for exit: x0 already has the value) ===
fn EMOVRDI(S): i64 { return 0; }  # no-op: x0 is already the first arg on aarch64

# === Syscall ===
# SVC #0 (Linux) or SVC #0x80 (macOS/BSD). On BSD the error convention
# is "carry flag set → errno in x0 as a small positive"; Linux uses
# "-errno in rax/x0". To make higher-level code (which checks
# `if (result < 0) ...`) work identically on both platforms, we append
# a `csneg x0, x0, x0, cc` after the Mach-O ARM SVC: if carry clear
# (success) x0 is unchanged; if carry set (error) x0 gets negated so
# the returned value is -errno, matching Linux.
fn ESYSCALL(S): i64 {
    if (_TARGET_MACHO == 2) {
        EW(S, 0xD4001001);      # svc #0x80
        EW(S, 0xDA803400);      # csneg x0, x0, x0, cc
        return 0;
    }
    EW(S, 0xD4000001); return 0;                               # svc #0
}

# === Syscall argument pops ===
# On aarch64, syscall args are x0-x5 (already in the right regs from Cyrius calling convention)
# Pop from stack into x0-x5 in reverse order
fn EPOPRDI(S): i64 { EW(S, 0xF8410FE0); return 0; }  # ldr x0, [sp], #16
fn EPOPRSI(S): i64 { EW(S, 0xF8410FE1); return 0; }  # ldr x1, [sp], #16
fn EPOPRDX(S): i64 { EW(S, 0xF8410FE2); return 0; }  # ldr x2, [sp], #16
fn EPOPR10(S): i64 { EW(S, 0xF8410FE3); return 0; }  # ldr x3, [sp], #16 (arg4)
fn EPOPR8(S): i64 { EW(S, 0xF8410FE4); return 0; }   # ldr x4, [sp], #16 (arg5)
fn EPOPR9(S): i64 { EW(S, 0xF8410FE5); return 0; }   # ldr x5, [sp], #16

# === PIE-safe PC-relative addressing (Mach-O ARM) ===
# ADRP xN, #0 — placeholder, page-diff patched by FIXUP_ADRP_ADD.
# Encoding: 0x90000000 | Rd (bits 4:0). immlo/immhi fields start at 0.
fn EADRP(S, reg): i64 {
    EW(S, 0x90000000 | (reg & 0x1F));
    return 0;
}

# ADD xN, xN, #0 — placeholder, imm12 patched by FIXUP_ADRP_ADD.
# Encoding: 0x91000000 | (Rn << 5) | Rd, with Rn == Rd == reg.
fn EADD_IMM12(S, reg): i64 {
    EW(S, 0x91000000 | ((reg & 0x1F) << 5) | (reg & 0x1F));
    return 0;
}

# === Fixup + variable access ===
fn RECFIX(S, idx): i64 {
    var fc = GFCNT(S);
    if (fc >= 262144) {
        syscall(SYS_WRITE, 2, "error: fixup table full (", 25);
        PRNUM(fc);
        syscall(SYS_WRITE, 2, "/262144)\n", 9);
        syscall(SYS_EXIT, 1);
    }
    var addr = S + 0x198B000 + fc * 16;
    S64(addr, GCP(S));
    S64(addr + 8, idx);
    SFCNT(S, fc + 1);
    return 0;
}

# Load variable address into x1 (for struct field access)
fn EVADDR_X1(S, idx): i64 {
    RECFIX(S, idx);
    if (_TARGET_MACHO == 2) {
        EADRP(S, 1);          # adrp x1, <page>
        EADD_IMM12(S, 1);     # add  x1, x1, #<lo12>
        return 0;
    }
    EW(S, 0xD2800001);  # movz x1, #0
    EW(S, 0xF2A00001);  # movk x1, #0, lsl 16
    EW(S, 0xF2C00001);  # movk x1, #0, lsl 32
    return 0;
}

# Add immediate to x1
fn EADDIMM_X1(S, val): i64 {
    # add x1, x1, #val (imm12)
    EW(S, 0x91000021 | ((val & 0xFFF) << 10));
    return 0;
}

# Store: mov x1, <addr>; str x0, [x1]
fn EVSTORE(S, idx): i64 {
    # RECFIX before the address sequence so fixup patches the right instructions
    RECFIX(S, idx);
    if (_TARGET_MACHO == 2) {
        EADRP(S, 1); EADD_IMM12(S, 1);
        EW(S, 0xF9000020);  # str x0, [x1]
        return 0;
    }
    EW(S, 0xD2800001);  # movz x1, #0
    EW(S, 0xF2A00001);  # movk x1, #0, lsl 16
    EW(S, 0xF2C00001);  # movk x1, #0, lsl 32
    EW(S, 0xF9000020);  # str x0, [x1]
    return 0;
}

# Load: mov x1, <addr>; ldr x0, [x1]
fn EVLOAD(S, idx): i64 {
    RECFIX(S, idx);
    if (_TARGET_MACHO == 2) {
        EADRP(S, 1); EADD_IMM12(S, 1);
        EW(S, 0xF9400020);  # ldr x0, [x1]
        return 0;
    }
    EW(S, 0xD2800001);  # movz x1, #0
    EW(S, 0xF2A00001);  # movk x1, #0, lsl 16
    EW(S, 0xF2C00001);  # movk x1, #0, lsl 32
    EW(S, 0xF9400020);  # ldr x0, [x1]
    return 0;
}

# Address: mov x0, <addr>
fn EVADDR(S, idx): i64 {
    RECFIX(S, idx);
    if (_TARGET_MACHO == 2) {
        EADRP(S, 0); EADD_IMM12(S, 0);
        return 0;
    }
    EW(S, 0xD2800000);  # movz x0, #0
    EW(S, 0xF2A00000);  # movk x0, #0, lsl 16
    EW(S, 0xF2C00000);  # movk x0, #0, lsl 32
    return 0;
}

# String address
fn ESADDR(S, soff): i64 {
    var fc = GFCNT(S);
    if (fc >= 262144) {
        syscall(SYS_WRITE, 2, "error: fixup table full (262144)\n", 33);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x198B000 + fc * 16;
    S64(faddr, GCP(S));
    S64(faddr + 8, (1 << 56) | soff);
    SFCNT(S, fc + 1);
    if (_TARGET_MACHO == 2) {
        EADRP(S, 0); EADD_IMM12(S, 0);
        return 0;
    }
    EW(S, 0xD2800000);  # movz x0, #0
    EW(S, 0xF2A00000);  # movk x0, #0, lsl 16
    EW(S, 0xF2C00000);  # movk x0, #0, lsl 32
    return 0;
}

# Pop syscall args then SVC
# Translate x86 syscall number (in x8) to aarch64 equivalent
fn ESYSXLAT(S): i64 {
    # Mach-O ARM (Apple Silicon, BSD syscall convention):
    #   - syscall number goes in x16 (not x8)
    #   - svc #0x80 (not #0)
    #   - BSD numbers, not Linux: read=3, write=4, open=5, close=6,
    #     mmap=197, mprotect=74, munmap=73, exit=1
    # Emit chained cmp/b.ne/movz pattern, comparing x8 (Linux num) and
    # writing BSD num to x16. The caller-side ESYSCALL emits svc #0x80.
    if (_TARGET_MACHO == 2) {
        # read: 0→3     movz x16,#3  = 0xD2800070
        EW(S, 0xF100011F); EW(S, 0x54000041); EW(S, 0xD2800070);
        # write: 1→4    movz x16,#4  = 0xD2800090
        EW(S, 0xF100051F); EW(S, 0x54000041); EW(S, 0xD2800090);
        # open: 2→5     movz x16,#5  = 0xD28000B0
        EW(S, 0xF100091F); EW(S, 0x54000041); EW(S, 0xD28000B0);
        # close: 3→6    movz x16,#6  = 0xD28000D0
        EW(S, 0xF1000D1F); EW(S, 0x54000041); EW(S, 0xD28000D0);
        # mmap: 9→197   movz x16,#197 = 0xD2801890 (197 << 5 = 0x18A0, wrong)
        #   movz x16,#imm = 0xD2800000 | (imm << 5) | 16
        #   197 = 0xC5, <<5 = 0x18A0, |0x10 = 0x18B0 → 0xD28018B0
        EW(S, 0xF100251F); EW(S, 0x54000041); EW(S, 0xD28018B0);
        # mprotect: 10→74  74 = 0x4A, <<5 = 0x940, |0x10 = 0x950 → 0xD2800950
        EW(S, 0xF100291F); EW(S, 0x54000041); EW(S, 0xD2800950);
        # munmap: 11→73   73 = 0x49, <<5 = 0x920, |0x10 = 0x930 → 0xD2800930
        EW(S, 0xF1002D1F); EW(S, 0x54000041); EW(S, 0xD2800930);
        # exit: 60→1    movz x16,#1  = 0xD2800030
        EW(S, 0xF100F11F); EW(S, 0x54000041); EW(S, 0xD2800030);
        return 0;
    }
    # Emit: compare x8 against known x86 numbers, replace with aarch64
    # x86:0=read→a64:63, x86:1=write→a64:64, x86:2=open→a64:56
    # x86:3=close→a64:57, x86:12=brk→a64:214, x86:60=exit→a64:93
    # x86:59=execve→a64:221, x86:57=fork→a64:220
    # x86:228=clock_gettime→a64:113
    # Implemented as chained: cmp x8, #N; b.ne +8; movz x8, #M
    # x86→aarch64 syscall translation (cmp/b.ne/movz chain)
    # read: 0→63     movz x8,#63  = 0xD28007E8
    EW(S, 0xF100011F); EW(S, 0x54000041); EW(S, 0xD28007E8);
    # write: 1→64    movz x8,#64  = 0xD2800808
    EW(S, 0xF100051F); EW(S, 0x54000041); EW(S, 0xD2800808);
    # open: 2→56     movz x8,#56  = 0xD2800708
    EW(S, 0xF100091F); EW(S, 0x54000041); EW(S, 0xD2800708);
    # close: 3→57    movz x8,#57  = 0xD2800728
    EW(S, 0xF1000D1F); EW(S, 0x54000041); EW(S, 0xD2800728);
    # brk: 12→214    movz x8,#214 = 0xD2801AC8
    EW(S, 0xF100311F); EW(S, 0x54000041); EW(S, 0xD2801AC8);
    # exit: 60→93    movz x8,#93  = 0xD2800BA8
    EW(S, 0xF100F11F); EW(S, 0x54000041); EW(S, 0xD2800BA8);
    # clock_gettime: 228→113  movz x8,#113 = 0xD2800E28
    EW(S, 0xF103911F); EW(S, 0x54000041); EW(S, 0xD2800E28);
    # mmap: 9→222       cmp x8,#9 = 0xF100251F; movz x8,#222 = 0xD2801BC8
    EW(S, 0xF100251F); EW(S, 0x54000041); EW(S, 0xD2801BC8);
    # mprotect: 10→226  cmp x8,#10 = 0xF100291F; movz x8,#226 = 0xD2801C48
    EW(S, 0xF100291F); EW(S, 0x54000041); EW(S, 0xD2801C48);
    # munmap: 11→215    cmp x8,#11 = 0xF1002D1F; movz x8,#215 = 0xD2801AE8
    EW(S, 0xF1002D1F); EW(S, 0x54000041); EW(S, 0xD2801AE8);
    # getpid: 39→172    cmp x8,#39 = 0xF1009D1F; movz x8,#172 = 0xD2801588
    EW(S, 0xF1009D1F); EW(S, 0x54000041); EW(S, 0xD2801588);
    return 0;
}

# Pop syscall args (LIFO — last pushed = first popped)
# Push order: syscall_num, arg1, arg2, ..., argN
# Pop order: argN first, syscall_num last
fn ESCPOPS(S, n): i64 {
    # LIFO: last pushed (argN) pops first, first pushed (syscall_num) pops last
    # For syscall(num, a1, a2, a3, a4, a5, a6):
    #   Push order: num, a1, a2, a3, a4, a5, a6
    #   Stack: [a6_top, a5, a4, a3, a2, a1, num_bottom]
    #   Pop: a6 first → x5, ... , num last → x9
    # Pop all into x0, move to target reg one by one.
    # LIFO: top=last_arg, bottom=syscall_num
    if (n >= 7) { EPOPR(S); EW(S, 0xAA0003E5); }  # pop → x0, mov x5, x0
    if (n >= 6) { EPOPR(S); EW(S, 0xAA0003E4); }  # pop → x0, mov x4, x0
    if (n >= 5) { EPOPR(S); EW(S, 0xAA0003E3); }  # pop → x0, mov x3, x0
    if (n >= 4) { EPOPR(S); EW(S, 0xAA0003E2); }  # pop → x0, mov x2, x0
    if (n >= 3) { EPOPR(S); EW(S, 0xAA0003E1); }  # pop → x0, mov x1, x0
    # Pop syscall num into x8 BEFORE arg1 into x0
    if (n >= 1) {
        if (n >= 2) {
            # 2+ args: pop arg1 → x9, pop syscall → x8, then mov x0, x9
            EPOPR(S); EW(S, 0xAA0003E9);  # pop arg1 → x0, mov x9, x0
            EPOPR(S); EW(S, 0xAA0003E8);  # pop syscall → x0, mov x8, x0
            EW(S, 0xAA0903E0);             # mov x0, x9 (restore arg1)
        } else {
            # 1 arg (just syscall num, no real args)
            EPOPR(S); EW(S, 0xAA0003E8);  # pop → x0, mov x8, x0
        }
    }
    ESYSXLAT(S);
    ESYSCALL(S);
    return 0;
}

# Exit: on Linux, movz x8,#93; svc #0.  On macOS/BSD, movz x16,#1; svc #0x80.
fn EEXIT(S): i64 {
    # x0 already has the exit value
    if (_TARGET_MACHO == 2) {
        EW(S, 0xD2800030);    # movz x16, #1 (BSD _exit)
        EW(S, 0xD4001001);    # svc #0x80
        return 0;
    }
    EW(S, 0xD2800BA8);  # movz x8, #93 (aarch64 Linux exit)
    ESYSCALL(S);
    return 0;
}

# v5.5.13 Mach-O arm64 first __got reroute — syscall(60, code) → libSystem._exit.
# Stack on entry (argc==2): [exit_code][sc_num=60] top-down.
# Sequence:
#   ldr x0, [sp], #16       pop exit code → x0
#   add sp, sp, #16         discard sc_num
#   adrp x16, __got@PAGE    (page-diff patched by FIXUP ftype=5)
#   ldr  x16, [x16, #0]     load __got[0] = &_exit (dyld-bound)
#   br   x16                tail-call _exit; no return
#
# FIXUP reuses FIXUP_ADRP_ADD mechanics for the adrp patch because __got[0]
# is page-aligned in __DATA_CONST (addr & 0xFFF == 0, so the ADD-style
# imm12 write is a no-op on the LDR's imm12 field). For multi-slot
# imports (v5.5.14+) the fixup will need to encode slot*8 properly scaled
# for LDR (imm12 = offset/8), at which point this path gets a dedicated
# FIXUP_ADRP_LDR in aarch64/fixup.cyr.
fn EMACHO_EXIT_ARM(S): i64 {
    # EPOPR is the verified post-indexed pop into x0 (encoding 0xF84107E0).
    # The EPOPRDI/SI/DX/R10/R8/R9 family at lines 216-221 uses 0xF8410FE0
    # which is actually PRE-indexed (`[sp, #16]!`) — comments there lie.
    # They're unreferenced elsewhere so the latent bug hasn't bitten; left
    # as-is pending a proper audit.
    EPOPR(S);                      # ldr x0, [sp], #16 — exit code (arg1, top of stack)
    EW(S, 0x910043FF);             # add sp, sp, #16 — discard sc_num
    # Record ftype=5 __got-ref fixup at the adrp that follows.
    var fc = GFCNT(S);
    if (fc >= 262144) {
        syscall(SYS_WRITE, 2, "error: fixup table full (262144)\n", 33);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x198B000 + fc * 16;
    S64(faddr, GCP(S));
    S64(faddr + 8, (5 << 56) | 0);  # ftype=5, __got slot idx=0 (_exit)
    SFCNT(S, fc + 1);
    EW(S, 0x90000010);             # adrp x16, #0 (placeholder — patched)
    EW(S, 0xF9400210);             # ldr  x16, [x16, #0] — load __got[0]
    EW(S, 0xD61F0200);             # br   x16 — tail to _exit
    return 0;
}

# Shared helper: record a ftype=5 __got-ref fixup at GCP + emit the
# adrp/ldr/blr trio that calls through __got[slot]. Returns 0.
# Non-zero slots are patched by FIXUP_ADRP_LDR (imm12 scaled /8);
# slot 0 reuses FIXUP_ADRP_ADD.
fn _EMACHO_BLR_GOT(S, slot): i64 {
    var fc = GFCNT(S);
    if (fc >= 262144) {
        syscall(SYS_WRITE, 2, "error: fixup table full (262144)\n", 33);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x198B000 + fc * 16;
    S64(faddr, GCP(S));
    S64(faddr + 8, (5 << 56) | slot);
    SFCNT(S, fc + 1);
    EW(S, 0x90000010);             # adrp x16, #0 (placeholder — patched)
    EW(S, 0xF9400210);             # ldr  x16, [x16, #0] — imm12 patched for slot>0
    EW(S, 0xD63F0200);             # blr  x16 — result in x0
    return 0;
}

# v5.5.14 Mach-O arm64 syscall(1, fd, buf, len) → libSystem._write(fd, buf, len).
# Stack top-down (argc==4): [len][buf][fd][sc_num=1]. AAPCS64 wants x0=fd,
# x1=buf, x2=len, so pop top→x2, next→x1, next→x0, then discard sc_num.
# Return value lands in x0 per both AAPCS64 and the syscall convention.
fn EMACHO_WRITE_ARM(S): i64 {
    EPOPARG(S, 2);                 # ldr x2, [sp], #16 — len
    EPOPARG(S, 1);                 # ldr x1, [sp], #16 — buf
    EPOPARG(S, 0);                 # ldr x0, [sp], #16 — fd
    EW(S, 0x910043FF);             # add sp, sp, #16 — discard sc_num
    _EMACHO_BLR_GOT(S, 1);         # __got[1] = _write
    return 0;
}

# v5.5.14 Mach-O arm64 syscall(0, fd, buf, len) → libSystem._read(fd, buf, len).
# Same stack layout as EMACHO_WRITE_ARM; dispatches through __got[2] = _read.
fn EMACHO_READ_ARM(S): i64 {
    EPOPARG(S, 2);                 # ldr x2, [sp], #16 — len
    EPOPARG(S, 1);                 # ldr x1, [sp], #16 — buf
    EPOPARG(S, 0);                 # ldr x0, [sp], #16 — fd
    EW(S, 0x910043FF);             # add sp, sp, #16 — discard sc_num
    _EMACHO_BLR_GOT(S, 2);         # __got[2] = _read
    return 0;
}

# v5.6.6 Mach-O arm64 syscall(228, clock_id, _) →
# libSystem._clock_gettime_nsec_np(clock_id). Only x0 matters; the
# 2nd cyrius-side arg is a Linux-shape placeholder (it was
# `&timespec` on Linux; macOS returns ns directly in x0 so no
# buffer is needed). Returns u64 ns in x0.
# Stack top-down (argc==3): [arg2][arg1=clock_id][sc_num=228].
fn EMACHO_CLOCK_ARM(S): i64 {
    EW(S, 0x910043FF);             # add sp, sp, #16 — drop arg2 (placeholder)
    EPOPARG(S, 0);                 # ldr x0, [sp], #16 — clock_id
    EW(S, 0x910043FF);             # add sp, sp, #16 — discard sc_num
    _EMACHO_BLR_GOT(S, 6);         # __got[6] = _clock_gettime_nsec_np
    return 0;
}

# ================================================================
# FUNCTION CALLING CONVENTION (aarch64 AAPCS64)
# x29=frame pointer, x30=link register, x0-x7=args
# ================================================================

# Function prologue: stp x29,x30,[sp,#-16]!; mov x29,sp
fn EFNPRO(S): i64 {
    EW(S, 0xA9BF7BFD);  # stp x29, x30, [sp, #-16]!
    EW(S, 0x910003FD);  # mov x29, sp
    return 0;
}

# Emit sub sp, sp, #imm — returns patch offset
fn ESUBRSP(S): i64 {
    var patch = GCP(S);
    EW(S, 0xD10003FF);  # sub sp, sp, #0 (placeholder, imm12 in bits [21:10])
    return patch;
}

# v5.8.56: ELVRLOAD / ELVRSTORE / ELVRINIT stubs removed in lockstep
# with x86's removal — the x86 versions were a v4.8.4-alpha6 loop-var
# r12 caching optimization never wired up to the parser, and the
# aarch64 stubs only existed to satisfy cc5's symbol resolution when
# the x86 versions were called. With both gone, the symmetry holds.

# Function epilogue: mov sp,x29; ldp x29,x30,[sp],#16; ret
fn EFNEPI(S): i64 {
    EW(S, 0x910003BF);  # mov sp, x29
    EW(S, 0xA8C17BFD);  # ldp x29, x30, [sp], #16
    EW(S, 0xD65F03C0);  # ret
    return 0;
}

# v5.11.35 path-A named ops — Class D refactor. aarch64 stubs
# preserve the IR record (matches current behavior — IR record
# fires when regalloc >= 1 regardless of arch) but skip emits
# because regalloc-save/restore is x86-callee-save-list specific.
# aarch64 never auto-enables `_cur_fn_regalloc >= 1` today, so
# these stubs are dead paths in practice. See x86/emit.cyr for
# the active implementations + docs/audit/2026-04-27-cx-direct-emit-inventory.md.
fn EREGALLOC_SAVE(S, n): i64 {
    if (n >= 1) { _IR_REC0(S, IR_RAW_EMIT); }
    return 0;
}

fn EREGALLOC_RESTORE(S, n): i64 {
    if (n >= 1) { _IR_REC0(S, IR_RAW_EMIT); }
    return 0;
}

# EDROPI64 — PE-only path; aarch64 doesn't enter the calling
# code (parse_expr.cyr PE syscall stubs are gated by _TARGET_PE).
# Stub provided for completeness; never reached at compile time.
fn EDROPI64(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

# v5.11.36 path-A named ops — Class B refactor (PIC-vs-direct
# address loads). aarch64 has two emit shapes depending on
# `_TARGET_MACHO`: ELF uses MOVZ+MOVK chain (12 bytes, FIXUP_MOV
# patched at link time); Mach-O uses ADRP+ADD (8 bytes,
# FIXUP_ADRP_ADD — PC-relative, required for PIE/ASLR per
# v5.9.39 Bug B fix). Records fixup-type-3 entry at `fnaddr`.

# ELOAD_FN_ADDR — load fn-address into x0. See x86/emit.cyr
# for full semantics; aarch64 differs only in emit shape.
fn ELOAD_FN_ADDR(S, fnaddr, fc, fni): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    S64(fnaddr, GCP(S));
    S64(fnaddr + 8, (3 << 56) | fni);
    SFCNT(S, fc + 1);
    if (_TARGET_MACHO == 2) {
        EADRP(S, 0); EADD_IMM12(S, 0);
    } else {
        EW(S, 0xD2800000);  # movz x0, #0
        EW(S, 0xF2A00000);  # movk x0, #0, lsl 16
        EW(S, 0xF2C00000);  # movk x0, #0, lsl 32
    }
    return 0;
}

# ELOAD_LOCAL_ADDR — load address of local at fp-relative
# `adisp` (negative) into x0. aarch64: SUB X0, X29, #imm12 when
# |adisp| <= 4095; otherwise MOVZ/MOVK chain into x0 + SUB x0,
# x29, x0. x86 emitted 7 raw bytes (3 + 4 disp32) here which was
# 3 mod 4 and corrupted aarch64 instruction alignment — the
# arch-specific encoding is mandatory not optional.
fn ELOAD_LOCAL_ADDR(S, adisp): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    var disp_abs = 0 - adisp;
    if (disp_abs <= 4095) {
        # SUB X0, X29, #imm12: 0xD10003A0 | (imm12 << 10)
        EW(S, 0xD10003A0 | ((disp_abs & 0xFFF) << 10));
    } else {
        # MOVZ X0, #lo16; (MOVK X0, #hi16, LSL 16); SUB X0, X29, X0
        EW(S, 0xD2800000 | ((disp_abs & 0xFFFF) << 5));
        if (((disp_abs >> 16) & 0xFFFF) != 0) {
            EW(S, 0xF2A00000 | (((disp_abs >> 16) & 0xFFFF) << 5));
        }
        EW(S, 0xCB0003A0);  # sub x0, x29, x0
    }
    return 0;
}

# v5.11.37 path-A named ops — Class C refactor (f64 unary ops).
# aarch64 has native FNEG for f64_neg; the transcendentals split
# into hard-errors (sin/cos/exp2/atan — no native, no polyfill yet)
# and polyfill-dispatch (exp/ln/log2 — dispatch to lib/math.cyr's
# `_f64_<op>_polyfill` fns via _FINDFN_CSTR + ECALLFIX).

# EF64_NEG — fmov d0, x0; fneg d0, d0; fmov x0, d0.
fn EF64_NEG(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E614000);   # fneg d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# Hard-error ops (no native, no polyfill in lib/math.cyr yet).
fn EF64_SIN(S): i64 {
    ERR_MSG(S, "f64_sin is x86-only for v5.6.0; aarch64 has no native trig — needs polyfill", 75);
    return 0;
}

fn EF64_COS(S): i64 {
    ERR_MSG(S, "f64_cos is x86-only for v5.6.0; aarch64 has no native trig — needs polyfill", 75);
    return 0;
}

fn EF64_EXP2(S): i64 {
    ERR_MSG(S, "f64_exp2 is x86-only for v5.6.0; aarch64 has no native exp2 — needs polyfill", 76);
    return 0;
}

fn EF64_ATAN(S): i64 {
    ERR_MSG(S, "f64_atan is x86-only for v5.6.0; aarch64 has no native fpatan — needs polyfill", 78);
    return 0;
}

# Polyfill-dispatch ops — find the lib/math.cyr _f64_*_polyfill fn
# by name and emit a tail-call into it. Each pushes rax onto the
# stack, sets up the 1-arg fncall stack-state via ECALLPOPS, then
# ECALLFIX emits the call+fixup. Closes phylax #1 (v5.8.4 Shannon
# entropy) lineage. _FINDFN_CSTR was relocated to util.cyr at
# v5.11.37 so emit.cyr can resolve polyfill fn indices.

fn EF64_EXP(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_exp_polyfill", 17);
    if (pf < 0) {
        ERR_MSG(S, "f64_exp on aarch64 requires include \"lib/math.cyr\" (provides _f64_exp_polyfill)", 78);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

fn EF64_LN(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_ln_polyfill", 16);
    if (pf < 0) {
        ERR_MSG(S, "f64_ln on aarch64 requires include \"lib/math.cyr\" (provides _f64_ln_polyfill)", 76);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

fn EF64_LOG2(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_log2_polyfill", 18);
    if (pf < 0) {
        ERR_MSG(S, "f64_log2 on aarch64 requires include \"lib/math.cyr\" (provides _f64_log2_polyfill)", 80);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

# EF64_ABS — native FABS via FP register shuttle. Replaces a
# 32-byte sequence (4× MOVK chain into x0 + push/EMOVCA-mov/pop/AND)
# with 12 bytes — save 20 bytes per call site on aarch64.
fn EF64_ABS(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E60C000);   # fabs d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# v5.11.39 path-A stubs — switch-table dispatch. aarch64 takes
# the chain path (parse.cyr sets `use_table = 0` for
# _AARCH64_BACKEND == 1); these ops are defined for include-time
# symmetry but never invoked at compile time.
fn ESWITCH_DISPATCH_PRE(S, case_min, range): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

fn ESWITCH_DISPATCH_TABLE(S, range): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

# EF64_CMP — aarch64 f64 compare. Stack on entry: a in x1 (pushed
# earlier as the second operand), b in x0 (current). Uses FCMP +
# CSET with the ordered condition codes (MI for lt so unordered/
# NaN yields 0).
fn EF64_CMP(S, tok): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EW(S, 0x9E670020);  # fmov d0, x1   — d0 = a
    EPOPR(S);            # pop b back to x0 (stack now empty)
    EW(S, 0x9E670001);  # fmov d1, x0   — d1 = b
    EW(S, 0x1E612000);  # fcmp d0, d1
    if (tok == 68) { EW(S, 0x9A9F17E0); }  # cset x0, eq
    if (tok == 69) { EW(S, 0x9A9F57E0); }  # cset x0, mi  (ordered <)
    if (tok == 70) { EW(S, 0x9A9FD7E0); }  # cset x0, gt  (ordered >)
    return 0;
}

# Emit BL to known target
fn ECALLTO(S, target): i64 {
    var cp = GCP(S);
    var rel = (target - cp) / 4;
    EW(S, 0x94000000 | (rel & 0x3FFFFFF));
    return 0;
}

# Emit BL placeholder, record type-2 fixup
fn ECALLFIX(S, fnidx): i64 {
    var poff = GCP(S);
    EW(S, 0x94000000);  # bl +0 (placeholder)
    var fc = GFCNT(S);
    if (fc >= 262144) {
        syscall(SYS_WRITE, 2, "error: fixup table full (262144)\n", 33);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x198B000 + fc * 16;
    S64(faddr, poff);
    S64(faddr + 8, (2 << 56) | fnidx);
    SFCNT(S, fc + 1);
    return 0;
}

# Pop into aarch64 arg register (x0-x7).
# v5.6.25: when n == 0 and the immediately preceding instruction is
# `push x0` (EPUSHR), the push+pop pair is a no-op — rewind past the
# push rather than emitting the pop. Mirrors EPOPR's v5.6.9 cancel.
# Applies to 1-arg call sites (and the trailing pop of any N-arg
# call, but only the N=1 case has the pop's CP == _last_push_cp
# since EPOPARG(N-1..1) push the emit cursor forward before this).
# Pre-v5.6.25 cc5_aarch64 carried 2,569 such pairs.
fn EPOPARG(S, n): i64 {
    if (n == 0) {
        if (GCP(S) == _last_push_cp) {
            SCP(S, GCP(S) - 4);
            _last_push_cp = 0 - 1;
            return 0;
        }
    }
    # ldr xN, [sp], #16
    EW(S, 0xF84107E0 | n);
    return 0;
}

# Pop args into registers for function call
fn ECALLPOPS(S, n): i64 {
    if (n <= 6) {
        var i = n - 1;
        while (i >= 0) { EPOPARG(S, i); i = i - 1; }
        return 0;
    }
    # >6 args: stack = [a1..aN], aN on top.
    # 1. Pop (n-6) extras into x9-x12 (caller-saved temps)
    # 2. Pop 6 register args into x0-x5
    # 3. Push extras back for callee to find at [sp]
    var nextra = n - 6;
    # Step 1: pop extras into x9-x12 (up to 4 extras = 10 args max)
    # ldr x9, [sp], #16
    EW(S, 0xF84107E9);
    if (nextra >= 2) { EW(S, 0xF84107EA); }  # ldr x10, [sp], #16
    if (nextra >= 3) { EW(S, 0xF84107EB); }  # ldr x11, [sp], #16
    if (nextra >= 4) { EW(S, 0xF84107EC); }  # ldr x12, [sp], #16
    # Step 2: pop 6 register args
    var i = 5;
    while (i >= 0) { EPOPARG(S, i); i = i - 1; }
    # Step 3: push extras back (reverse order)
    if (nextra >= 4) { EW(S, 0xF81F0FEC); }  # str x12, [sp, #-16]!
    if (nextra >= 3) { EW(S, 0xF81F0FEB); }  # str x11, [sp, #-16]!
    if (nextra >= 2) { EW(S, 0xF81F0FEA); }  # str x10, [sp, #-16]!
    EW(S, 0xF81F0FE9);                        # str x9, [sp, #-16]!
    return 0;
}

# Stack cleanup after call with >6 args
fn ECALLCLEAN(S, n): i64 {
    if (n > 6) {
        # add sp, sp, #(nextra * 16)
        var extra = (n - 6) * 16;
        EW(S, 0x910003FF | (extra << 10));  # add sp, sp, #imm12
    }
    return 0;
}

# Helper: not needed on aarch64 but must exist for parse.cyr
fn EDISP32(S, disp): i64 { return 0; }

# v5.9.26 Phase 2b-aarch64 — load &local into X8 (the dedicated
# indirect-result register on aarch64 SysV / AAPCS64 §6.9). Used at
# caller-side of a struct-returning call to set the hidden retptr
# arg directly, BEFORE the regular ECALLPOPS into X0..X5. Differs
# from x86's EFLADDR (which puts &local into RAX and then pushes to
# stack to be popped into RDI) because aarch64 reserves X8 outside
# the regular arg-reg sequence.
#   add x8, x29, #abs_disp     ; or sub if negative
fn EFLADDR_X8(S, lli): i64 {
    var disp = 0 - ((lli + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    var abs = 0 - disp;
    # SUB Xd, Xn, #imm12: 0xD1000000 base. Rd=8, Rn=29.
    # bits[28:24]=10001, bits[31]=1 (sf=64-bit), bits[30:29]=10 (op=SUB).
    # Encoding: 0xD1_00_00_00 | (sh=0) | (imm12<<10) | (Rn<<5) | Rd
    if (abs <= 4095) {
        EW(S, 0xD10003A8 | (abs << 10));   # sub x8, x29, #abs
        return 0;
    }
    # Fallback for large frames — movz x9 + sub x8, x29, x9.
    EW(S, 0xD2800009 | ((abs & 0xFFFF) << 5));   # movz x9, #abs
    EW(S, 0xCB0903A8);                            # sub x8, x29, x9
    return 0;
}

# Compute x9 = x29 + disp for local access when disp is outside the
# LDUR/STUR signed 9-bit immediate range (-256..+255). Called only with
# disp <= -256 (locals at idx >= 32). Assumes |disp| fits in 16 bits —
# Cyrius functions with >= 8192 locals are implausible.
fn _EFP_ADDR_X9(S, disp): i64 {
    var abs = 0 - disp;
    EW(S, 0xD2800009 | ((abs & 0xFFFF) << 5));  # movz x9, #abs
    EW(S, 0xCB0903A9);                            # sub x9, x29, x9
    return 0;
}

# Store parameter to frame: str xN, [x29, #-offset]
fn ESTOREREGPARM(S, pidx, disp): i64 {
    # STUR Xt, [Xn, #simm9]: 1111 1000 000 simm9 00 Xn Xt
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF80003A0 | (off9 << 12) | pidx);  # stur xPIDX, [x29, #disp]
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    EW(S, 0xF9000120 | pidx);  # str xPIDX, [x9]
    return 0;
}

fn ESTORESTACKPARM(S, pidx, disp, pc): i64 {
    # Load extra arg from caller's stack, store to local frame
    # Caller pushed extras at [sp+0], [sp+16], ... before the call
    # After prologue, they're at [x29+16], [x29+32], ...
    var nstack = pc - 6;
    var si = nstack - 1 - (pidx - 6);
    var soff = 16 + si * 16;
    # ldr x9, [x29, #soff]   (soff positive, LDR imm12*8 range — 32760 max)
    EW(S, 0xF94003A9 | ((soff / 8) << 10));
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF80003A9 | (off9 << 12));  # stur x9, [x29, #disp]
        return 0;
    }
    # disp out of range — compute dest addr in x10 (x9 holds value), str x9, [x10]
    var abs = 0 - disp;
    EW(S, 0xD280000A | ((abs & 0xFFFF) << 5));  # movz x10, #abs
    EW(S, 0xCB0A03AA);                            # sub x10, x29, x10
    EW(S, 0xF9000149);                            # str x9, [x10]
    return 0;
}

fn ESTOREPARM(S, pidx, lidx, pc): i64 {
    var disp = 0 - ((lidx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (pidx < 6) {
        ESTOREREGPARM(S, pidx, disp);
    } else {
        ESTORESTACKPARM(S, pidx, disp, pc);
    }
    return 0;
}

# v5.10.36 — aarch64 V0 NEON register-class return for f64v2
# (Phase 8 of the value-type ABI arc; mirror of v5.10.32's x86
# XMM0 SSE-class optimisation).
#
# Pre-v5.10.36 (v5.10.29 Phase 2): aarch64 returned f64v2 as an
# int-class pair (X0 = lo, X1 = hi), 8 bytes of emit per
# load/store (two LDUR / STUR X-form instructions). That's
# correct under AAPCS64's general-purpose composite rules but
# leaves performance on the floor: AAPCS64 classifies 16-byte
# composites composed of FP fields as **SIMD class**, returned
# in V0 — same shape as x86 SysV SSE class returning in XMM0.
#
# v5.10.36 switches to V0: a single 128-bit NEON load/store
# (`ldur q0` / `stur q0`, 4 bytes each) replaces the v5.10.29
# X-pair (8 bytes each). cc5_aarch64 shrinks by the
# encoding-density gain (same shape as v5.10.32's -384 B on x86).
#
# `idx` is the NAMED slot's local index (returned by FINDLOCAL on
# the f64v2 var name). 2-slot layout matches x86:
#   slot idx-1 = anonymous filler (hi half = &v + 8)
#   slot idx   = named (lo half / bottom of struct = &v + 0)
# Named slot is at the deepest frame offset; field 0 (lo) is at
# &v+0, field 1 (hi) at &v+8. The single LDUR Q0 loads 16 bytes
# starting at &v (= disp_lo), packed as V0[63:0] = lo,
# V0[127:64] = hi — exact in-memory layout.
#
# Disp must fit LDUR/STUR (SIMD) imm9 (-256..+255). For typical
# regalloc cap 5 + named-slot idx ≤ ~64, disp stays well within
# range; defensive guard for the implausible cap-overflow case.
#
# Encoding (LDUR Q0, [X29, #imm9]):
#   bits 31..30 = 00 (size=00 for 128-bit unscaled SIMD/FP)
#   bits 29..24 = 111100
#   bits 23..22 = 11 (opc=11 = 128-bit load)
#   bit 21      = 0
#   bits 20..12 = imm9 (signed)
#   bits 11..10 = 00 (LDUR unscaled offset)
#   bits 9..5   = 11101 (Rn = X29 / FP)
#   bits 4..0   = 00000 (Rt = Q0)
# Base (imm9=0): 0x3CC003A0.
#
# Encoding (STUR Q0, [X29, #imm9]):
#   Same as LDUR but opc = 10 (128-bit store). Base: 0x3C8003A0.
fn EFLLOAD_F64V2_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) {
        disp_lo = disp_lo - _cur_fn_ret_stash;
    }
    if (disp_lo < 0 - 256) {
        syscall(SYS_WRITE, 2, "error: f64v2 NEON return disp out of LDUR Q imm9 range on aarch64\n", 67);
        syscall(SYS_EXIT, 1);
    }
    var off_lo = disp_lo & 0x1FF;
    # ldur q0, [x29, #disp_lo] — single 128-bit SIMD load.
    EW(S, 0x3CC003A0 | (off_lo << 12));
    return 0;
}

# Mirror of EFLLOAD_F64V2_PAIR for caller-side post-call store:
#   stur q0, [x29, #disp_lo]   (16 bytes at &v)
# Single STUR Q0 lays the returned V0 into caller's 16-byte
# stack-local (named slot at disp_lo = lo half, filler at
# disp_lo+8 = hi half). Same layout as v5.10.32's x86 XMM0.
fn EFLSTORE_F64V2_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) {
        disp_lo = disp_lo - _cur_fn_ret_stash;
    }
    if (disp_lo < 0 - 256) {
        syscall(SYS_WRITE, 2, "error: f64v2 NEON return disp out of STUR Q imm9 range on aarch64\n", 67);
        syscall(SYS_EXIT, 1);
    }
    var off_lo = disp_lo & 0x1FF;
    # stur q0, [x29, #disp_lo] — single 128-bit SIMD store.
    EW(S, 0x3C8003A0 | (off_lo << 12));
    return 0;
}

# v5.10.37 — emit f64v4 pair-quad return LOAD (callee-side).
# Two LDUR Q's: Q0 from [&v + 0..15], Q1 from [&v + 16..31].
# Mirror of x86's EFLLOAD_F64V4_PAIR. AAPCS64's SIMD&FP class
# allows 256-bit composites in V0+V1 (mirror of SysV's
# xmm0+xmm1 for 32B). Encoding bases per the v5.10.36 LDUR Q
# decode: 0x3CC003A0 + offset shift + Rt LSB.
#   LDUR Q0 = 0x3CC003A0
#   LDUR Q1 = 0x3CC003A1
# Win64 PE uses retptr-style; this fn isn't called when
# _cur_fn_ret_stash > 0 (PARSE_RETURN routes to
# ESTRUCT_BYVAL_COPY instead).
fn EFLLOAD_F64V4_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) {
        disp_lo = disp_lo - _cur_fn_ret_stash;
    }
    var disp_hi = disp_lo + 16;
    # v5.10.37 — fast path: both halves fit LDUR Q imm9 (-256..255).
    # Fallback when out of range: compute x9 = x29 + disp_lo via
    # _EFP_ADDR_X9, then LDR Q0,[x9] + LDR Q1,[x9,#16] (imm12*16 scaled
    # range, fits both halves). Mirrors the EFLLOAD/ESTOREREGPARM
    # fast/slow pattern at lines 816-825.
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        # ldur q0, [x29, #disp_lo]
        EW(S, 0x3CC003A0 | (off_lo << 12));
        # ldur q1, [x29, #disp_hi]
        EW(S, 0x3CC003A1 | (off_hi << 12));
        return 0;
    }
    # Slow path: deep-frame fallback via X9 base.
    _EFP_ADDR_X9(S, disp_lo);
    # ldr q0, [x9, #0] — 128-bit LDR (imm12-scaled, imm=0)
    EW(S, 0x3DC00120);
    # ldr q1, [x9, #16] — 128-bit LDR (imm12=1 → byte offset 16)
    EW(S, 0x3DC00521);
    return 0;
}

# v5.10.37 — emit f64v4 pair-quad STORE post-call (caller-side).
# Mirror of EFLLOAD_F64V4_PAIR. STUR Q encoding: 0x3C8003A0 + Rt.
#   STUR Q0 = 0x3C8003A0
#   STUR Q1 = 0x3C8003A1
# Fallback STR Q (imm12-scaled) bases:
#   STR Q0, [x9, #0]  = 0x3D800120
#   STR Q1, [x9, #16] = 0x3D800521
fn EFLSTORE_F64V4_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) {
        disp_lo = disp_lo - _cur_fn_ret_stash;
    }
    var disp_hi = disp_lo + 16;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        # stur q0, [x29, #disp_lo]
        EW(S, 0x3C8003A0 | (off_lo << 12));
        # stur q1, [x29, #disp_hi]
        EW(S, 0x3C8003A1 | (off_hi << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    # str q0, [x9, #0]
    EW(S, 0x3D800120);
    # str q1, [x9, #16]
    EW(S, 0x3D800521);
    return 0;
}

# v5.10.46 Phase 2 of struct-byval ABI arc — aarch64 AAPCS64
# int-class 16B struct pair-return. AAPCS64 §6.9 specifies X0+X1
# for ≤16B int-class composite returns (lo in X0, hi in X1).
# Linux aarch64 and macOS arm64 share AAPCS64 → this same encoding
# covers both `_TARGET_MACHO` ∈ {0, 2}; the macho branches in this
# file are for relocation / branch encoding, NOT for the value-
# return ABI. Phase 3 (v5.10.47) cross-host verifies on pi + ecb.
#
# Encoding (LDUR Xt, [X29, #simm9]):
#   1111 1000 010 simm9 00 Xn Xt
#   Base for X0 [X29]: 0xF84003A0; for X1: 0xF84003A1.
#   imm9 range: -256..+255.
# Deep-frame fallback (disp_lo < -256): compute X9 = X29 + disp_lo
# via _EFP_ADDR_X9, then LDR (imm12-scaled).
fn EFLLOAD_STRUCT_INT_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 8;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        EW(S, 0xF84003A0 | (off_lo << 12));   # ldur x0, [x29, #disp_lo]
        EW(S, 0xF84003A1 | (off_hi << 12));   # ldur x1, [x29, #disp_hi]
        return 0;
    }
    # Deep-frame fallback: ldr x0, [x9, #0] + ldr x1, [x9, #8] via
    # imm12-scaled (byte_offset = imm12 * 8, range 0..32760).
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0xF9400120);   # ldr x0, [x9, #0]  (imm12=0)
    EW(S, 0xF9400521);   # ldr x1, [x9, #8]  (imm12=1 → byte 8)
    return 0;
}

# Mirror: STUR Xt encoding: 0xF80003A0 (X0) / 0xF80003A1 (X1).
# Receives X0+X1 into the caller's 2-slot stack-local after the
# callee returns.
fn EFLSTORE_STRUCT_INT_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 8;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        EW(S, 0xF80003A0 | (off_lo << 12));   # stur x0, [x29, #disp_lo]
        EW(S, 0xF80003A1 | (off_hi << 12));   # stur x1, [x29, #disp_hi]
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0xF9000120);   # str x0, [x9, #0]
    EW(S, 0xF9000521);   # str x1, [x9, #8]
    return 0;
}

# v5.10.38 — aarch64 f64v2 SIMD-class param store at fn entry.
# Mirror of x86 ESTOREPARM_F64V2. `simd_ord` is the V-register
# ordinal (0..7 under AAPCS64); `named_idx` is the named slot
# of the 2-slot stack-local where the f64v2 value lives.
# Single STUR Q<simd_ord> stores 16 bytes from the NEON
# register into the local; deep-frame fallback via X9 + STR Q
# (imm12-scaled) if disp_lo < -256.
#
# Encoding: `stur q<N>, [x29, #imm9]` = 0x3C8003A0 + N | (off9 << 12)
# Deep-frame: `str q<N>, [x9, #0]` = 0x3D800120 + N
fn ESTOREPARM_F64V2(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        EW(S, 0x3C8003A0 | (simd_ord & 0x1F) | (off_lo << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0x3D800120 | (simd_ord & 0x1F));
    return 0;
}

# v5.10.38 — aarch64 f64v4 SIMD-class param store at fn entry.
# Two STUR Q (V<simd_ord>+V<simd_ord+1>) for the 4-slot region.
fn ESTOREPARM_F64V4(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 16;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        # stur q<simd_ord>, [x29, #disp_lo]
        EW(S, 0x3C8003A0 | (simd_ord & 0x1F) | (off_lo << 12));
        # stur q<simd_ord+1>, [x29, #disp_hi]
        EW(S, 0x3C8003A0 | ((simd_ord + 1) & 0x1F) | (off_hi << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    # str q<simd_ord>, [x9, #0]
    EW(S, 0x3D800120 | (simd_ord & 0x1F));
    # str q<simd_ord+1>, [x9, #16]
    EW(S, 0x3D800520 | ((simd_ord + 1) & 0x1F));
    return 0;
}

# v5.10.38 — aarch64 caller-side SIMD-arg LOAD into V-register.
# Mirror of x86 ELOAD_F64V2_TO_XMM. Encoding: ldur q<N> base
# 0x3CC003A0 + N; deep-frame fallback ldr q<N> base 0x3DC00120 + N.
fn ELOAD_F64V2_TO_XMM(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        EW(S, 0x3CC003A0 | (simd_ord & 0x1F) | (off_lo << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0x3DC00120 | (simd_ord & 0x1F));
    return 0;
}

fn ELOAD_F64V4_TO_XMM(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 16;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        EW(S, 0x3CC003A0 | (simd_ord & 0x1F) | (off_lo << 12));
        EW(S, 0x3CC003A0 | ((simd_ord + 1) & 0x1F) | (off_hi << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0x3DC00120 | (simd_ord & 0x1F));
    EW(S, 0x3DC00520 | ((simd_ord + 1) & 0x1F));
    return 0;
}

# Local variable load: ldur x0, [x29, #-offset]
# v5.9.26: account for `_cur_fn_ret_stash` so locals in
# struct-returning fns don't overlap the X8 retptr stash slot.
fn EFLLOAD(S, idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF84003A0 | (off9 << 12));  # ldur x0, [x29, #disp]
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    EW(S, 0xF9400120);  # ldr x0, [x9]
    return 0;
}

# Local variable store: stur x0, [x29, #-offset]
# v5.9.26: account for `_cur_fn_ret_stash` (see EFLLOAD note).
fn EFLSTORE(S, idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF80003A0 | (off9 << 12));  # stur x0, [x29, #disp]
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    EW(S, 0xF9000120);  # str x0, [x9]
    return 0;
}

# v5.8.54 — frame-local-address pair, peer of x86's EFLADDR / EFLADDR_X1
# (`src/backend/x86/emit.cyr:1391` / `:1373`). Compute the address of
# local slot `lli` into x0 (EFLADDR) or x1 (EFLADDR_X1) for caller code
# that needs an &local — struct-field LEA, hidden retbuf-arg push,
# slice canonical-slot init via `slice_set` / `slice_ptr`. Pre-v5.8.54
# these were defined in x86/emit.cyr only; parse_decl.cyr (lines 127,
# 236, 301, 355, 931, 1019, 1060) and parse_expr.cyr:234 call them
# unconditionally — the aarch64 cross-build emitted "undefined function"
# warnings + "will crash at runtime" errors. sit v0.7.2 release flow
# never hit them (sit's source doesn't trip the parser paths that emit
# these); the cross-build was building a binary that would have SIGILL'd
# on the first struct-field-load or slice-init had any consumer reached
# them on aarch64. Latent bug, not active regression — surfaced when
# v5.8.53's install-pipeline fix cleared the noise from the cross-build
# warnings.
#
# **Asymmetry to flag**: x86's EFLADDR formula adjusts disp for
# `_cur_fn_regalloc * 8` (callee-saved register save slots) and
# `_cur_fn_ret_stash` (hidden retbuf alignment). aarch64's existing
# EFLLOAD / EFLSTORE / ESTOREPARM don't apply these adjustments —
# aarch64 doesn't currently stash callee-saved x19-x28 to the frame,
# and its multi-return path uses x0+x2 register-pair return rather
# than a stack-allocated retbuf with hidden first-arg.
# EFLADDR / EFLADDR_X1 below mirror the existing aarch64 formula
# (`disp = -((lli+1)*8)`, no adjustments) for consistency. **If a
# future slot adds callee-saved register stashing on aarch64**, this
# pair must update in lockstep with EFLLOAD / EFLSTORE — they're a
# coupled set; fixing one without the others silently corrupts
# locals.
fn EFLADDR(S, lli): i64 {
    var disp = (lli + 1) * 8;     # positive magnitude — locals below x29
    if (_cur_fn_ret_stash > 0) { disp = disp + _cur_fn_ret_stash; }
    if (disp <= 4095) {
        # sub x0, x29, #disp (imm12, no shift)
        EW(S, 0xD10003A0 | (disp << 10));
        return 0;
    }
    # Fallback — disp >= 4096. Synthesize via x9 scratch then sub.
    # cyrius functions with > 511 locals are implausible (would need
    # 4096 / 8 = 512 frame slots before hitting this), but the path
    # exists for safety.
    _EFP_ADDR_X9(S, 0 - disp);   # x9 = x29 - disp
    EW(S, 0xAA0903E0);           # mov x0, x9
    return 0;
}

fn EFLADDR_X1(S, lli): i64 {
    var disp = (lli + 1) * 8;
    if (_cur_fn_ret_stash > 0) { disp = disp + _cur_fn_ret_stash; }
    if (disp <= 4095) {
        # sub x1, x29, #disp (imm12, no shift)
        EW(S, 0xD10003A1 | (disp << 10));
        return 0;
    }
    _EFP_ADDR_X9(S, 0 - disp);   # x9 = x29 - disp
    EW(S, 0xAA0903E1);           # mov x1, x9
    return 0;
}

# Object mode check (shared with x86)
fn _IS_OBJ(S): i64 { return L64(S + 0x18FCA0) == 3; }

# Width-aware local load: ldurb/ldurh/ldur w0/ldur x0 from [x29, #-offset]
fn EFLLOAD_W(S, idx, width): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        if (width == 1) { EW(S, 0x384003A0 | (off9 << 12)); return 0; }
        if (width == 2) { EW(S, 0x784003A0 | (off9 << 12)); return 0; }
        if (width == 4) { EW(S, 0xB84003A0 | (off9 << 12)); return 0; }
        EW(S, 0xF84003A0 | (off9 << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    if (width == 1) { EW(S, 0x39400120); return 0; }  # ldrb w0, [x9]
    if (width == 2) { EW(S, 0x79400120); return 0; }  # ldrh w0, [x9]
    if (width == 4) { EW(S, 0xB9400120); return 0; }  # ldr w0, [x9]
    EW(S, 0xF9400120);  # ldr x0, [x9]
    return 0;
}

# Width-aware local store: sturb/sturh/stur w0/stur x0 to [x29, #-offset]
fn EFLSTORE_W(S, idx, width): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        if (width == 1) { EW(S, 0x380003A0 | (off9 << 12)); return 0; }
        if (width == 2) { EW(S, 0x780003A0 | (off9 << 12)); return 0; }
        if (width == 4) { EW(S, 0xB80003A0 | (off9 << 12)); return 0; }
        EW(S, 0xF80003A0 | (off9 << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    if (width == 1) { EW(S, 0x39000120); return 0; }  # strb w0, [x9]
    if (width == 2) { EW(S, 0x79000120); return 0; }  # strh w0, [x9]
    if (width == 4) { EW(S, 0xB9000120); return 0; }  # str w0, [x9]
    EW(S, 0xF9000120);  # str x0, [x9]
    return 0;
}

# Width-aware global load: ldr from [x1] with width
fn EVLOAD_W(S, idx, width): i64 {
    EVADDR_X1(S, idx);
    if (width == 1) { EW(S, 0x39400020); return 0; }
    if (width == 2) { EW(S, 0x79400020); return 0; }
    if (width == 4) { EW(S, 0xB9400020); return 0; }
    EW(S, 0xF9400020); return 0;
}

# Width-aware global store: str to [x1] with width
fn EVSTORE_W(S, idx, width): i64 {
    EVADDR_X1(S, idx);
    if (width == 1) { EW(S, 0x39000020); return 0; }
    if (width == 2) { EW(S, 0x79000020); return 0; }
    if (width == 4) { EW(S, 0xB9000020); return 0; }
    EW(S, 0xF9000020); return 0;
}

# v5.9.40 — sub-byte struct field load (parse_decl.cyr:252).
# Field-base ptr is in x1 (already advanced to the field start
# by callers). Emits ldrb/ldrh/ldr w0/ldr x0 by width. Pulled
# out of an inline `if (_AARCH64_BACKEND == 1)` block into a
# named helper so the cx backend can sit alongside as a peer
# without parse_decl.cyr having to grow another arch arm.
fn EFIELD_LOAD_W(S, width): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    if (width == 1) { EW(S, 0x39400020); return 0; }   # ldrb w0, [x1]
    if (width == 2) { EW(S, 0x79400020); return 0; }   # ldrh w0, [x1]
    if (width == 4) { EW(S, 0xB9400020); return 0; }   # ldr  w0, [x1]
    EW(S, 0xF9400020); return 0;                       # ldr  x0, [x1]
}

# v5.9.40 — struct-by-value return aarch64 byte-copy loop
# (parse_fn.cyr:339). Pulled out of an inline emit block in
# parse_fn.cyr so the cx backend's `ESTRUCT_BYVAL_COPY` peer
# fires from the same call site. Encoding plan (8 instructions):
#   x9  = fp + src_disp                  (via _EFP_ADDR_X9)
#   x10 = ldur [fp + stash_disp]         (retptr)
#   x11 = movz aligned_byte_count
#   loop:
#     ldrb w12, [x9], #1                 (post-incr src)
#     strb w12, [x10], #1                (post-incr dst)
#     subs x11, x11, #1
#     b.ne loop                          (-3 instructions back)
#   x0  = ldur [fp + stash_disp]         (reload retptr — x10 is past)
fn ESTRUCT_BYVAL_COPY(S, src_disp, stash_disp, aligned): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    _EFP_ADDR_X9(S, src_disp);
    var off9 = stash_disp & 0x1FF;
    EW(S, 0xF84003AA | (off9 << 12));               # ldur x10, [x29, #stash_disp]
    EW(S, 0xD280000B | ((aligned & 0xFFFF) << 5));  # movz x11, #aligned
    EW(S, 0x3840152C);                              # ldrb w12, [x9], #1
    EW(S, 0x3800154C);                              # strb w12, [x10], #1
    EW(S, 0xF100056B);                              # subs x11, x11, #1
    EW(S, 0x54FFFFA1);                              # b.ne -3
    EW(S, 0xF84003A0 | (off9 << 12));               # ldur x0,  [x29, #stash_disp]
    return 0;
}

# Patch frame size: sub sp, sp, #N at the prologue
fn EPATCHFRAME(S, patch, size): i64 {
    # Read the SUB instruction and patch imm12
    var addr = S + 0x64A000 + patch;
    var insn = L64(addr) & 0xFFFFFFFF;
    # Clear imm12 (bits [21:10]) and set new value
    insn = (insn & 0xFFC003FF) | ((size & 0xFFF) << 10);
    S64(addr, (L64(addr) >> 32 << 32) | (insn & 0xFFFFFFFF));
    return 0;
}

# === Token access (arch-independent, same as x86) ===
fn TOKTYP(S, i): i64 { return L64(S + 0x368C000 + i * 8); }   # v5.8.46: relocated to fresh 8 MiB region post-TS (cap 1048576)
fn TOKVAL(S, i): i64 { return L64(S + 0x3E8C000 + i * 8); }   # v5.8.46: relocated to fresh 8 MiB region post-TS (cap 1048576)
fn PEEKT(S): i64 { return TOKTYP(S, GTI(S)); }
fn PEEKV(S): i64 { return TOKVAL(S, GTI(S)); }

# ================================================================
# AARCH64 INLINE ASM MNEMONICS
# ================================================================

fn ASM_MNEMONIC(S): i64 {
    var noff = PEEKV(S);
    var mnem = L64(S + 0x60000 + noff);
    STI(S, GTI(S) + 1);
    if (mnem & 0xFFFFFF == 0x637673) { EW(S, 0xD4000001); }                    # svc
    elif (mnem & 0xFFFFFF == 0x696677) { EW(S, 0xD503207F); }                  # wfi
    elif (mnem & 0xFFFFFF == 0x656677) { EW(S, 0xD5031020); }                  # wfe
    elif (mnem & 0xFFFFFF == 0x626D64) { EW(S, 0xD50330BF); }                  # dmb
    elif (mnem & 0xFFFFFF == 0x627364) { EW(S, 0xD503309F); }                  # dsb
    elif (mnem & 0xFFFFFF == 0x627369) { EW(S, 0xD50330DF); }                  # isb
    elif (mnem & 0xFFFFFF == 0x706F6E) { EW(S, 0xD503201F); }                  # nop
    elif (mnem & 0xFFFFFF == 0x746572) { EW(S, 0xD65F03C0); }                  # ret
    else {
        syscall(SYS_WRITE, 2, "error:", 6);
        FM_LOOKUP(S, GTLINE(S, GTI(S) - 1));
        syscall(SYS_WRITE, 2, ": unknown aarch64 asm mnemonic\n", 31);
        syscall(SYS_EXIT, 1);
    }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# Tail call: epilogue + branch to function (aarch64)
fn ETAILJMP(S, fnidx): i64 {
    # Restore frame: mov sp, x29; ldp x29, x30, [sp], #16
    EW(S, 0x910003BF);  # mov sp, x29
    EW(S, 0xA8C17BFD);  # ldp x29, x30, [sp], #16
    # Branch to function — use fixup type 4 for B (not BL)
    var poff = GCP(S);
    EW(S, 0x14000000);  # B placeholder
    var fc = GFCNT(S);
    if (fc >= 262144) {
        syscall(SYS_WRITE, 2, "error: fixup table full (262144)\n", 33);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x198B000 + fc * 16;
    S64(faddr, poff);
    S64(faddr + 8, (4 << 56) | fnidx);
    SFCNT(S, fc + 1);
    return 0;
}

# ================================================================
# COMPARISON EXPRESSION (ESETCC equivalent for aarch64)
# ================================================================
# cmp x0, x1; cset x0, <cond>
# op: 17=EQ, 18=NE, 19=LT, 20=GT, 21=LE, 22=GE
fn ESETCC(S, op): i64 {
    # cmp x0, x1 (EB 00 01 6B = subs xzr, x0, x1... actually CMP is alias)
    EW(S, 0xEB01001F);
    # cset x0, <cond>
    if (op == 17) { EW(S, 0x9A9F17E0); }
    if (op == 18) { EW(S, 0x9A9F07E0); }
    if (op == 19) { EW(S, 0x9A9FA7E0); }   # lt → csinc x0, xzr, xzr, ge  (cond=1010)
    if (op == 20) { EW(S, 0x9A9FD7E0); }   # gt → csinc x0, xzr, xzr, le  (cond=1101)
    if (op == 21) { EW(S, 0x9A9FC7E0); }   # le → csinc x0, xzr, xzr, gt  (cond=1100)
    if (op == 22) { EW(S, 0x9A9FB7E0); }   # ge → csinc x0, xzr, xzr, lt  (cond=1011)
    return 0;
}

# ================================================================
# F64 STUBS (aarch64 float not yet implemented — stubs for compilation)
# ================================================================
# v5.7.30: aarch64 f64 basic-op implementation. Pre-v5.7.30 every
# fn below was `return 0;` — silent miscompile on every f64 op
# (basic ops emitted no fp instructions; f64_add(1.0, 2.0) returned
# 2.0 because parser left second arg in x0 and EMIT_F64_BINOP did
# nothing). phylax-blocking; surfaced via the f64_exp hard-reject.
# The single-instruction emits below match the x86 contract:
# inputs are bit-pattern in x0 (last arg) + stack TOS (first arg);
# output is bit-pattern in x0.

# v5.7.30: x86-named no-ops kept for parser-shared codepaths. The
# EMOVQ_*/EUCOMISD/EXORPD_X1/EMOVAPD_01/EX87PUSH/EX87POP helpers are
# x86 bit-cast / x87-stack-mgmt helpers the aarch64 path doesn't
# need — fmov d, x and fmov x, d are inlined directly into EMIT_
# F64_BINOP / EMIT_F64_CMP / etc. The stubs preserve the parser API.
fn EMOVQ_X0_A(S): i64 { return 0; }
fn EMOVQ_X1_C(S): i64 { return 0; }
fn EMOVQ_A_X0(S): i64 { return 0; }
fn EUCOMISD(S): i64 { return 0; }
fn EXORPD_X1(S): i64 { return 0; }
fn EMOVAPD_01(S): i64 { return 0; }
fn EX87PUSH(S): i64 { return 0; }
fn EX87POP(S): i64 { return 0; }

# v5.7.30: int → f64. Input: x0 = int. Output: x0 = f64 bit pattern.
# scvtf d0, x0  (signed convert to double)
# fmov x0, d0   (extract bits)
# Replaces the previous `return 0;` stub which silently produced 0.
fn EI2F(S): i64 {
    EW(S, 0x9E620000);   # scvtf d0, x0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# v5.7.30: f64 → int. Input: x0 = f64 bit pattern. Output: x0 = int.
# fmov d0, x0   (interpret bits as double)
# fcvtzs x0, d0 (signed convert, round toward zero)
fn EF2I(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x9E780000);   # fcvtzs x0, d0
    return 0;
}

# fsqrt d0, d0  (single-source FP op; bits in x0 already → fmov to
# d0, FSQRT, fmov back).
fn EF64SQRT(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0   — interpret x0 bits as double
    EW(S, 0x1E61C000);   # fsqrt d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0   — extract bit pattern
    return 0;
}

# frintm d0, d0  (round toward -∞)
fn EF64FLOOR(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E654000);   # frintm d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# frintp d0, d0  (round toward +∞)
fn EF64CEIL(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E64C000);   # frintp d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# frintn d0, d0  (round to nearest, ties to even)
fn EF64ROUND(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E644000);   # frintn d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# Binop contract (matches x86 path):
#   in:  stack TOS = first arg bits (a); x0 = second arg bits (b)
#   out: x0 = (a OP b) bit pattern; stack popped.
# fop: 0=add, 1=sub, 2=mul, 3=div.
fn EMIT_F64_BINOP(S, fop): i64 {
    EW(S, 0x9E670001);   # fmov d1, x0   — d1 = b (second arg)
    EPOPR(S);            # pop a into x0
    EW(S, 0x9E670000);   # fmov d0, x0   — d0 = a (first arg)
    if (fop == 0) { EW(S, 0x1E612800); }   # fadd d0, d0, d1
    if (fop == 1) { EW(S, 0x1E613800); }   # fsub d0, d0, d1
    if (fop == 2) { EW(S, 0x1E610800); }   # fmul d0, d0, d1
    if (fop == 3) { EW(S, 0x1E611800); }   # fdiv d0, d0, d1
    EW(S, 0x9E660000);   # fmov x0, d0   — extract result bit pattern
    return 0;
}

# Load a float literal into x0 as IEEE 754 bits. The lexer encodes
# fval as `(denom << 32) | numer` so we reconstruct the double at
# runtime via scvtf + fdiv, matching x86/float.cyr's strategy.
# Mirrors the EMIT_FLOAT_LIT in x86/float.cyr — same input shape,
# same output (f64 bit pattern in x0/rax), aarch64 FP instructions.
fn EMIT_FLOAT_LIT(S, fval): i64 {
    var numer = fval & 0xFFFFFFFF;
    var denom = (fval >> 32) & 0xFFFFFFFF;
    EMOVI(S, numer);           # x0 = numer
    EW(S, 0x9E620000);         # scvtf d0, x0   — d0 = (double) numer
    EMOVI(S, denom);           # x0 = denom (clobbers x0; that's fine)
    EW(S, 0x9E620001);         # scvtf d1, x0   — d1 = (double) denom
    EW(S, 0x1E611800);         # fdiv d0, d0, d1
    EW(S, 0x9E660000);         # fmov x0, d0    — x0 = f64 bit pattern
    return 0;
}
# Expression spill stubs
fn ESPILL(S): i64 { EPUSHR(S); return 0; }
fn EUNSPILL(S): i64 { EPOPR(S); return 0; }
# Inline disabled on aarch64
var _INLINE_OK = 0;
var _LOOPVAR_OK = 0;

# v5.10.16 — NEON SIMD packed-double primitives.
# Replaces the v1.9.0-era stubs that returned 0 (silent no-op).
# Pre-v5.10.16: a consumer calling `f64v_add(dst, a, b, n)` on
# aarch64 got an empty function body — dst was never written, the
# loop never ran. Cross-arch propagation gap that escaped because
# no tcyr exercised f64v_*; v5.10.16 adds those.
#
# Frame contract mirrors x86/float.cyr's EMIT_F64V_LOOP:
#   vbase     = dst pointer
#   vbase + 1 = a pointer
#   vbase + 2 = b pointer (LOOP/FMADD only)
#   vbase + 3 = c pointer (FMADD only)
#   x0        = n (count of f64 elements; entry register)
# Loop processes 2 doubles per iteration via Q-registers
# (NEON 128-bit vector regs hold v.2d = 2x f64). Index in x11
# counts doubles; pair-step is +2 to match x86's `rsi += 2`.
#
# Tail behavior: identical to x86 — if n is odd, the last
# iteration touches one element past the array (16-byte load/
# store starting at index n-1). Caller contract: over-allocate
# by one slot or pass even n. Pre-existing footgun preserved
# for cross-arch parity; documented here, not silently fixed.

fn EMIT_F64V_LOOP(S, op, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index = 0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done (patched later)
    # v0 = a[index..index+1]
    EFLLOAD(S, vbase + 1);            # x0 = a base
    EW(S, 0xAA0003EC);                # mov x12, x0
    EW(S, 0x8B0B0D8C);                # add x12, x12, x11, lsl #3
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # v1 = b[index..index+1]
    EFLLOAD(S, vbase + 2);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    # NEON op: f{add,sub,mul,div} v0.2d, v0.2d, v1.2d
    if (op == 0) { EW(S, 0x4E61D400); }
    if (op == 1) { EW(S, 0x4EE1D400); }
    if (op == 2) { EW(S, 0x6E61DC00); }
    if (op == 3) { EW(S, 0x6E61FC00); }
    # dst[index..index+1] = v0
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

fn EMIT_F64V_UNARY(S, op, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0
    EW(S, 0xD280000B);                # movz x11, #0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # v0 = src[index..index+1]
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # NEON unary: fsqrt or fabs v0.2d, v0.2d
    if (op == 0) { EW(S, 0x6EE1F800); }
    if (op == 1) { EW(S, 0x4EE0F800); }
    # dst[index..index+1] = v0
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

fn EMIT_F64V_FMADD(S, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0
    EW(S, 0xD280000B);                # movz x11, #0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # FMLA v0.2d, v1.2d, v2.2d computes v0 = v0 + v1*v2.
    # We want dst = a*b + c, so load c → v0, a → v1, b → v2.
    # v0 = c
    EFLLOAD(S, vbase + 3);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # v1 = a
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    # v2 = b
    EFLLOAD(S, vbase + 2);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00182);                # ldr q2, [x12]
    # fmla v0.2d, v1.2d, v2.2d
    EW(S, 0x4E62CC20);
    # dst = v0
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v5.10.17 — keystone primitives for hisab gap-close.
# Same ordering as x86: dot returns f64 in x0, scale + axpy take
# scalar at slot vbase+2.

# EMIT_F64V_DOT(S, vbase) — sum of a[i] * b[i].
# Slots: vbase=a, vbase+1=b. n in x0.
# Returns f64 bit pattern in x0.
# Strategy: v2 holds 2-wide running sum via fmla; tail uses faddp
# (NEON pairwise add) to reduce to a scalar in d0; fmov x0, d0.
fn EMIT_F64V_DOT(S, vbase): i64 {
    EW(S, 0x6E221C42);                # eor v2.16b, v2.16b, v2.16b — zero accumulator
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # v0 = a[i..i+1]
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # v1 = b[i..i+1]
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    # fmla v2.2d, v0.2d, v1.2d  — v2 += v0 * v1
    EW(S, 0x4E61CC02);
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    # faddp d0, v2.2d  — d0 = v2[0] + v2[1] (horizontal reduce)
    EW(S, 0x7E70D840);
    # fmov x0, d0  — extract f64 bit pattern into x0
    EW(S, 0x9E660000);
    return 0;
}

# EMIT_F64V_SCALE(S, vbase) — dst[i] = a[i] * scalar.
# Slots: vbase=dst, vbase+1=a, vbase+2=scalar (f64 bit pattern). n in x0.
# Pre-loop: load scalar bits → x0, fmov d3 ← x0, dup v3.2d, v3.d[0]
# (broadcast across both lanes). Loop: ldr q0, fmul, str q0.
fn EMIT_F64V_SCALE(S, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0  — n SAVED before clobber
    # x0 = scalar bits
    EFLLOAD(S, vbase + 2);
    EW(S, 0x9E670003);                # fmov d3, x0
    EW(S, 0x4E080463);                # dup v3.2d, v3.d[0]
    EW(S, 0xD280000B);                # movz x11, #0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # v0 = a[i..i+1]
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # fmul v0.2d, v0.2d, v3.2d  — v0 *= scalar
    EW(S, 0x6E63DC00);
    # store v0 to dst[i..i+1]
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# EMIT_F64V_AXPY(S, vbase) — y[i] += alpha * x[i].
# Slots: vbase=y, vbase+1=x, vbase+2=alpha. n in x0.
# Uses FMLA — fused multiply-add, single-instruction y += x*alpha.
fn EMIT_F64V_AXPY(S, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0  — save n
    EFLLOAD(S, vbase + 2);
    EW(S, 0x9E670003);                # fmov d3, x0  — alpha bits → d3
    EW(S, 0x4E080463);                # dup v3.2d, v3.d[0]
    EW(S, 0xD280000B);                # movz x11, #0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # v0 = y[i..i+1]  (FMLA accumulates into v0)
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # v1 = x[i..i+1]
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    # fmla v0.2d, v1.2d, v3.2d  — v0 = v0 + v1 * v3 = y + x * alpha
    EW(S, 0x4E63CC20);
    # store v0 back to y[i..i+1]
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}
