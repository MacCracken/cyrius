# Marker that the aarch64 backend is present in this compiler binary.
# Checked by EMITMACHO_ARM64 to refuse Mach-O ARM output when accidentally
# invoked through the x86 backend (which would emit x86 code inside an
# arm64 Mach-O header — silently broken, SIGILLs on Apple Silicon).
var _AARCH64_BACKEND = 1;

# Emit one byte to codebuf
# v5.7.34: cap raised 524288 → 3145728 to match the v5.7.27
# codebuf grow on x86 (`src/backend/x86/emit.cyr:68`). v5.7.27
# missed the aarch64 EB, so cycc_aarch64 was still rejecting
# programs > 512 KB even though the heap region grew to 3 MB.
# Phylax-surfaced when a downstream cross-build with phylax-
# shape program tripped `error: codebuf overflow (.../524288)`
# on aarch64 while the same source built fine on x86.
fn EB(S, b): i64 {
    var cp = GCP(S);
    if (_codebuf_cap != 0 && cp >= _codebuf_cap - 64) { _codebuf_grow(S); }
    store8(_codebuf_base + cp, b & 0xFF);
    SCP(S, cp + 1);
    return 0;
}

# Emit 32-bit instruction word (little-endian).
# v5.4.19: alignment assert. aarch64 instructions must land on a
# 4-byte boundary; the hardware decoder assumes this. Any prior
# emit sequence that leaves the code position at a non-multiple-
# of-4 (e.g. a stray x86-leak E2/EB from the shared frontend) would
# produce an undecoded instruction stream. Catch it loudly here
# rather than debugging a SIGILL in the emitted binary. Adds ~7
# LOC per EW call — negligible against the 4 EB calls that follow.
fn EW(S, w): i64 {
    var cp = GCP(S);
    if ((cp & 3) != 0) {
        syscall(SYS_WRITE, 2, "error: EW misaligned at cp=", 27);
        PRNUM(cp);
        syscall(SYS_WRITE, 2, " (not 4-byte boundary; shared parse.cyr leaked x86 bytes to aarch64 stream?)\n", 77);
        syscall(SYS_EXIT, 1);
    }
    EB(S, w & 0xFF);
    EB(S, (w >> 8) & 0xFF);
    EB(S, (w >> 16) & 0xFF);
    EB(S, (w >> 24) & 0xFF);
    return 0;
}

# Emit 2 bytes (for compatibility with x86 E2 calls)
fn E2(S, v): i64 {
    EB(S, v & 0xFF);
    EB(S, v >> 8 & 0xFF);
    return 0;
}

# Emit 8 bytes (for mov imm64 compatibility)
fn E8(S, v): i64 {
    EB(S, v & 0xFF); EB(S, v >> 8 & 0xFF);
    EB(S, v >> 16 & 0xFF); EB(S, v >> 24 & 0xFF);
    EB(S, v >> 32 & 0xFF); EB(S, v >> 40 & 0xFF);
    EB(S, v >> 48 & 0xFF); EB(S, v >> 56 & 0xFF);
    return 0;
}

fn E3(S, v): i64 {
    EB(S, v & 0xFF); EB(S, v >> 8 & 0xFF); EB(S, v >> 16 & 0xFF);
    return 0;
}

# === Move immediate to x0 (result register) ===
# MOVZ x0, #imm16 = 0xD2800000 | (imm16 << 5)
# For 64-bit immediates: MOVZ + MOVK for each 16-bit chunk
fn EMOVI(S, v): i64 {
    # MOVZ x0, #(v & 0xFFFF)
    EW(S, 0xD2800000 | ((v & 0xFFFF) << 5));
    # Emit MOVK for each non-zero 16-bit chunk above the low word.
    # Uses an unsigned bit-extract (not a signed `v > N` comparison),
    # so a negative `v` — whose upper bits are all 1 in two's
    # complement — gets the full 4-instruction sequence. Previously
    # `v > 0xFFFF` short-circuited on negatives, truncating the
    # value to 16 bits (e.g. `-1` became `0xFFFF` = 65535).
    if (((v >> 16) & 0xFFFF) != 0) {
        EW(S, 0xF2A00000 | (((v >> 16) & 0xFFFF) << 5));
    }
    if (((v >> 32) & 0xFFFF) != 0) {
        EW(S, 0xF2C00000 | (((v >> 32) & 0xFFFF) << 5));
    }
    if (((v >> 48) & 0xFFFF) != 0) {
        EW(S, 0xF2E00000 | (((v >> 48) & 0xFFFF) << 5));
    }
    return 0;
}

# === Stack operations ===
# aarch64 has no push/pop — use STP/LDP with SP
# push x0: STR x0, [sp, #-16]! (pre-decrement)
fn EPUSHR(S): i64 { EW(S, 0xF81F0FE0); _last_push_cp = GCP(S); return 0; }   # str x0, [sp, #-16]!
# pop x1 (into scratch): LDR x1, [sp], #16 (post-increment)
fn EPOPC(S): i64 { EW(S, 0xF84107E1); return 0; }     # ldr x1, [sp], #16
# pop x0: LDR x0, [sp], #16 (post-indexed)
fn EPOPR(S): i64 {
    if (GCP(S) == _last_push_cp) {
        # v5.6.9: adjacent push+pop = no-op. Rewind past the 4-byte push.
        SCP(S, GCP(S) - 4);
        _last_push_cp = 0 - 1;
        return 0;
    }
    # v5.6.11: remember if the pop landed immediately after EMOVCA,
    # so a commutative op next can collapse the 12-byte shuttle.
    var after_movca = 0;
    if (GCP(S) == _last_emovca_cp) { after_movca = 1; }
    EW(S, 0xF84107E0);     # ldr x0, [sp], #16
    if (after_movca == 1) { _last_movca_popr_cp = GCP(S); }
    return 0;
}

# === Register moves ===
# mov x1, x0 (scratch = result)
# v5.6.11: record CP post-emit for combine-shuttle peephole.
fn EMOVCA(S): i64 { EW(S, 0xAA0003E1); _last_emovca_cp = GCP(S); return 0; }

# v5.6.11: commutative-combine peephole. If current CP matches the
# GCP recorded when EPOPR/EUNSPILL finished *immediately after*
# EMOVCA, rewind 8 bytes (past `mov x1,x0; ldr x0,[sp],#16`) and
# drop in `ldr x1,[sp],#16` (EPOPC encoding 0xF84107E1, 4 B) — the
# op that follows then reads the correct operand from x1. Only safe
# for commutative ops because the pop-target swap (lhs now in x1,
# rhs still in x0) is the inverse of the original shuttle.
fn _TRY_COMBINE_SHUTTLE(S): i64 {
    if (GCP(S) == _last_movca_popr_cp) {
        SCP(S, GCP(S) - 8);
        EW(S, 0xF84107E1);   # ldr x1, [sp], #16 (matches EPOPC)
        _last_movca_popr_cp = 0 - 1;
    }
    return 0;
}

# === Arithmetic ===
# add x0, x0, x1
fn EADDR(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0x8B010000); return 0; }
# v5.11.51: x0 += imm12 (zero-extended). Used by byte-array literal
# `var foo[N] = { 0x.., ... };` to compute &var + i. Encoding:
# `ADD x0, x0, #imm`: 0x91000000 base | (imm << 10). imm fits 0..4095;
# byte-array literal callers stay within this range by construction
# (byte offsets in a single array).
# add x0, x0, #n. The aarch64 ADD-immediate form only carries a 12-bit
# operand (with an optional LSL #12), so the pre-v6.1.2 single
# `add x0,x0,#(n & 0xFFF)` SILENTLY corrupted for n >= 4096 (e.g. n==4096
# masked to #0 → byte written to &var+0). Fixed: split into the 12-bit
# low + LSL #12 high adds (covers n <= 0xFFFFFF / 16 MB, above the 8 MB
# compile-source cap so it reaches every in-range offset), with a
# movz/movk + add-reg guard for the >24-bit case so the bug class can't
# re-emerge if the source cap is ever raised past 16 MB. x16 (IP0) is a
# scratch the allocator never holds a value in. See CHANGELOG [6.1.2],
# issue 2026-06-07-aarch64-eaddra-imm-12bit-mask-over-4095.md.
fn EADDRA_IMM(S, n): i64 {
    if (n < 4096) {
        EW(S, 0x91000000 | (n << 10));                       # add x0, x0, #n
    } elif (n <= 0xFFFFFF) {
        var _lo = n & 0xFFF;
        if (_lo != 0) { EW(S, 0x91000000 | (_lo << 10)); }   # add x0, x0, #lo
        EW(S, 0x91400000 | (((n >> 12) & 0xFFF) << 10));     # add x0, x0, #hi, LSL #12
    } else {
        EW(S, 0xD2800010 | ((n & 0xFFFF) << 5));             # movz x16, #(n & 0xFFFF)
        EW(S, 0xF2A00010 | (((n >> 16) & 0xFFFF) << 5));     # movk x16, #(n>>16), LSL #16
        EW(S, 0x8B100000);                                   # add x0, x0, x16
    }
    return 0;
}
# sub x0, x0, x1 — non-commutative, NOT fused (swap inverts subtract).
fn ESUBR(S): i64 { EW(S, 0xCB010000); return 0; }
# mul x0, x0, x1 — commutative.
fn EIMUL(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0x9B017C00); return 0; }
# EMULH: high 64 bits of unsigned x1 * x0 into x0. Used by mulh64(a, b).
fn EMULH(S): i64 { EW(S, 0x9BC07C20); return 0; }     # umulh x0, x1, x0
# sdiv x0, x0, x1
# Division: sdiv x0, x2, x1 (uses saved dividend from ECQO)
fn EIDIV(S): i64 { EW(S, 0x9AC10C40); return 0; }     # sdiv x0, x2, x1
# Save dividend before division: mov x2, x0
fn ECQO(S): i64 { EW(S, 0xAA0003E2); return 0; }      # mov x2, x0
# Modulo: msub x0, x0, x1, x2 (x0 = x2 - x0*x1 = remainder)
fn EMOVDR(S): i64 { EW(S, 0x9B018800); return 0; }    # msub x0, x0, x1, x2

# === Compare ===
# cmp x0, x1 (subs xzr, x0, x1)
fn ECMPR(S): i64 { EW(S, 0xEB01001F); return 0; }     # cmp x0, x1
fn ETESTAZ(S): i64 { EW(S, 0xF100001F); return 0; }  # cmp x0, #0 (sets ZF)
fn EMOVRDXRAX(S): i64 { EW(S, 0xAA0003E2); return 0; }  # mov x2, x0
fn EMOVRA_RDX(S): i64 { EW(S, 0xAA0203E0); return 0; }  # mov x0, x2 (read second return value — aarch64 multi-return uses x0, x2)
# v6.5.21 — THIRD multi-value return slot = x3. `mov xd, xn` is ORR xd, xzr, xn:
# 0xAA0003E0 | (n << 16) | d.
fn EMOVR3RAX(S): i64 { EW(S, 0xAA0003E3); return 0; }  # mov x3, x0
fn EMOVRA_R3(S): i64 { EW(S, 0xAA0303E0); return 0; }  # mov x0, x3

# === Load/Store through x1 (pointer register) ===
# ldr x0, [x1]
fn ELODC(S): i64 { EW(S, 0xF9400020); return 0; }     # ldr x0, [x1]
# str x0, [x1]
fn ESTOC(S): i64 { EW(S, 0xF9000020); return 0; }     # str x0, [x1]

# === Load through x0 (dereference) ===
fn ELOAD8(S): i64 { EW(S, 0x39400000); return 0; }    # ldrb w0, [x0]
fn ELOAD16(S): i64 { EW(S, 0x79400000); return 0; }   # ldrh w0, [x0]
fn ELOAD32(S): i64 { EW(S, 0xB9400000); return 0; }   # ldr w0, [x0]
fn ELOAD64(S): i64 { EW(S, 0xF9400000); return 0; }   # ldr x0, [x0]

# === Store: [x1] = x0 (various widths) ===
fn ESTORE8(S): i64 { EW(S, 0x39000020); return 0; }   # strb w0, [x1]
# v6.0.88: byte-array literal peephole — `mov w0, #imm; strb w0, [x1, #disp]`.
# Base &var is hoisted into x1 once via EVADDR_X1; this emits 2 ops per
# byte instead of the ~6-op legacy chain. STRB's unsigned imm12 offset
# caps at 4095; for disp >= 4096 we return 1 so the caller falls back to
# the legacy per-byte sequence. See CHANGELOG [6.0.88].
fn ESTOREB_IMM(S, disp, val): i64 {
    if (disp >= 4096) { return 1; }
    EMOVI(S, val);                              # x0 = val (movz/movk)
    EW(S, 0x39000020 | ((disp & 0xFFF) << 10)); # strb w0, [x1, #disp]
    return 0;
}
fn ESTORE16(S): i64 { EW(S, 0x79000020); return 0; }  # strh w0, [x1]
fn ESTORE32(S): i64 { EW(S, 0xB9000020); return 0; }  # str w0, [x1]
fn ESTORE64(S): i64 { EW(S, 0xF9000020); return 0; }  # str x0, [x1]

# === Bitwise ===
# v5.6.11: commutative bitwise ops wired to combine-shuttle peephole.
fn EANDR(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0x8A010000); return 0; }
fn EORR(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0xAA010000); return 0; }
fn EXORR(S): i64 { _TRY_COMBINE_SHUTTLE(S); EW(S, 0xCA010000); return 0; }
fn ENOTR(S): i64 { EW(S, 0xAA2003E0); return 0; }     # mvn x0, x0
fn ESHLCL(S): i64 { EW(S, 0x9AC12000); return 0; }    # lslv x0, x0, x1
fn ESHRCL(S): i64 { EW(S, 0x9AC12400); return 0; }    # lsrv x0, x0, x1
fn EASHRCL(S): i64 { EW(S, 0x9AC12800); return 0; }   # asrv x0, x0, x1 (`>>>` arithmetic)
# v5.6.7 O2: shift x0 by immediate (1..63) using UBFM aliases.
# LSL Xd, Xn, #n → UBFM Xd, Xn, #((-n) mod 64), #(63-n)
# LSR Xd, Xn, #n → UBFM Xd, Xn, #n, #63
# Base UBFM imm sf=1: 0xD3400000 | (immr << 16) | (imms << 10)
fn ESHLIMM(S, n): i64 {
    var immr = (64 - n) & 0x3F;
    var imms = (63 - n) & 0x3F;
    EW(S, 0xD3400000 | (immr << 16) | (imms << 10));
    return 0;
}
# v5.8.56: ESHRIMM removed in lockstep with x86 — sibling of ESHLIMM
# (above) that never got a call site.
fn EXORAA(S): i64 { EW(S, 0xCA000000); return 0; }    # eor x0, x0, x0 (zero)

# === mov rdi, rax (for exit: x0 already has the value) ===
fn EMOVRDI(S): i64 { return 0; }  # no-op: x0 is already the first arg on aarch64

# === Syscall ===
# SVC #0 (Linux) or SVC #0x80 (macOS/BSD). On BSD the error convention
# is "carry flag set → errno in x0 as a small positive"; Linux uses
# "-errno in rax/x0". To make higher-level code (which checks
# `if (result < 0) ...`) work identically on both platforms, we append
# a `csneg x0, x0, x0, cc` after the Mach-O ARM SVC: if carry clear
# (success) x0 is unchanged; if carry set (error) x0 gets negated so
# the returned value is -errno, matching Linux.
fn ESYSCALL(S): i64 {
    if (_TARGET_MACHO == 2) {
        # v6.5.15 pipe fd-buffer fixup, PRE-svc half. Darwin `pipe` (BSD 42) returns the
        # two fds in x0/x1 and never writes the caller's buffer, but the Linux-shaped
        # caller passed an fds pointer in x0 (lib/process.cyr:71 `sys_pipe(&pipefd)`), and
        # the svc destroys x0. Stash it now, recover it post-svc. Gated on x16 — ESYSXLAT
        # runs immediately before this with nothing in between (see ESCPOPS), so x16
        # already holds the TRANSLATED BSD number, and it is preserved across svc (the
        # v6.0.34 fork fixup below has relied on that since it shipped). Push and pop are
        # gated on the IDENTICAL condition, so sp is balanced on every path. 42 is unique
        # in this chain — no other row produces movz x16,#42. Cross-arch twin of
        # EMACHO_PROC_FIXUP's `cmp r11, 22` pipe arm in backend/x86/emit.cyr.
        EW(S, 0xF100AA1F);      # cmp x16, #42  (pipe?)
        EW(S, 0x54000041);      # b.ne +8       (not pipe → skip the stash)
        EW(S, 0xF81F0FE0);      # str x0, [sp, #-16]!  (stash the fds buffer pointer)
        EW(S, 0xD4001001);      # svc #0x80
        EW(S, 0xDA803400);      # csneg x0, x0, x0, cc  (error → -errno)
        # v6.0.34 fork x1-fixup. macOS raw fork (BSD #2) returns the child
        # pid in x0 for BOTH parent and child, distinguishing via x1
        # (0=parent, 1=child). Without this, the child sees a nonzero x0
        # and runs the parent path → broken fork. x16 holds the BSD num
        # (preserved across svc) and x1 survives csneg, so: if fork and
        # child, zero x0. Gated on x16==2 → no-op for every other syscall.
        EW(S, 0xF1000A1F);      # cmp x16, #2   (fork?)
        EW(S, 0x54000081);      # b.ne +16      (not fork → skip 3)
        EW(S, 0xF100043F);      # cmp x1, #1    (child?)
        EW(S, 0x54000041);      # b.ne +8       (parent → skip 1)
        EW(S, 0xD2800000);      # movz x0, #0   (child → return 0)
        # v6.5.15 pipe fd-buffer fixup, POST-svc half (see the PRE-svc stash above). MUST
        # sit AFTER the csneg: csneg consumes the carry flag svc sets, so nothing that
        # writes the flags may come between them — the fork block above is already past
        # it, and this block falls through from it (x16==2 and x16==42 are exclusive).
        # ldr pops UNCONDITIONALLY inside the x16==42 arm so sp always re-balances; the
        # b.lt then keeps -errno on failure and leaves the caller's buffer untouched,
        # matching the x86 `js +8` guard. Success stores fd0→[buf] / fd1→[buf+4] as two
        # 32-bit ints (the shape lib/process.cyr load32s) and returns 0.
        EW(S, 0xF100AA1F);      # cmp x16, #42        (pipe?)
        EW(S, 0x540000E1);      # b.ne +28            (not pipe → past the whole fixup)
        EW(S, 0xF84107E2);      # ldr x2, [sp], #16   (recover the fds buffer ptr; always)
        EW(S, 0xF100001F);      # cmp x0, #0
        EW(S, 0x5400008B);      # b.lt +16            (error → keep -errno, no store)
        EW(S, 0xB9000040);      # str w0, [x2]        (fds[0] = read end)
        EW(S, 0xB9000441);      # str w1, [x2, #4]    (fds[1] = write end)
        EW(S, 0xD2800000);      # movz x0, #0         (success → 0, Linux-shaped)
        # v6.0.75: getrandom→getentropy return-normalization (0→len) is NOT done
        # here — the kernel clobbers x1 across a getentropy svc (verified on ecb:
        # x1 came back 0, unlike fork which WRITES x1), so len can't be recovered
        # post-svc. The 0→len conversion lives in sys_getrandom (stdlib) instead;
        # ESYSXLAT only maps the number (318/278→500). getentropy success returns
        # x0=0 (buffer filled), which sys_getrandom turns into the byte count.
        return 0;
    }
    EW(S, 0xD4000001); return 0;                               # svc #0
}

# === Syscall argument pops ===
# On aarch64, syscall args are x0-x5 (already in the right regs from Cyrius calling convention)
# Pop from stack into x0-x5 in reverse order
# Post-indexed `ldr xN, [sp], #16` = 0xF84107E0|N (index bits [11:10]=01).
# Pre-v6.2.34 these encoded 0xF8410FE0 ([11:10]=11) = PRE-indexed
# `ldr xN, [sp, #16]!`, which reads sp+16 (wrong slot) AND writes sp back —
# contradicting the comments. Latent only (unreferenced in the aarch64 build;
# the called twins live in backend/x86), corrected here so the family is right
# if ever wired to aarch64 syscall-arg pops. Matches EPOPR (0xF84107E0).
fn EPOPRDI(S): i64 { EW(S, 0xF84107E0); return 0; }  # ldr x0, [sp], #16
fn EPOPRSI(S): i64 { EW(S, 0xF84107E1); return 0; }  # ldr x1, [sp], #16
fn EPOPRDX(S): i64 { EW(S, 0xF84107E2); return 0; }  # ldr x2, [sp], #16
fn EPOPR10(S): i64 { EW(S, 0xF84107E3); return 0; }  # ldr x3, [sp], #16 (arg4)
fn EPOPR8(S): i64 { EW(S, 0xF84107E4); return 0; }   # ldr x4, [sp], #16 (arg5)
fn EPOPR9(S): i64 { EW(S, 0xF84107E5); return 0; }   # ldr x5, [sp], #16

# === PIE-safe PC-relative addressing (Mach-O ARM) ===
# ADRP xN, #0 — placeholder, page-diff patched by FIXUP_ADRP_ADD.
# Encoding: 0x90000000 | Rd (bits 4:0). immlo/immhi fields start at 0.
fn EADRP(S, reg): i64 {
    EW(S, 0x90000000 | (reg & 0x1F));
    return 0;
}

# ADD xN, xN, #0 — placeholder, imm12 patched by FIXUP_ADRP_ADD.
# Encoding: 0x91000000 | (Rn << 5) | Rd, with Rn == Rd == reg.
fn EADD_IMM12(S, reg): i64 {
    EW(S, 0x91000000 | ((reg & 0x1F) << 5) | (reg & 0x1F));
    return 0;
}

# === Fixup + variable access ===
# RECFIX moved to src/backend/common/runtime.cyr at v6.0.8 (the
# aarch64 PRNUM-error-message form is the canonical one).

# Load variable address into x1 (for struct field access)
fn EVADDR_X1(S, idx): i64 {
    RECFIX(S, idx);
    if (_TARGET_MACHO == 2 || _pie_mode == 1) {
        EADRP(S, 1);          # adrp x1, <page>
        EADD_IMM12(S, 1);     # add  x1, x1, #<lo12>
        return 0;
    }
    EW(S, 0xD2800001);  # movz x1, #0
    EW(S, 0xF2A00001);  # movk x1, #0, lsl 16
    EW(S, 0xF2C00001);  # movk x1, #0, lsl 32
    return 0;
}

# v6.0.88: obj-aware &var-into-base alias for the byte-array peephole.
# aarch64 EVADDR_X1 is already Mach-O-aware (adrp/add branch above), so
# the base load is correct under PIE — unlike the x86 EVADDR_X1, whose
# absolute-mov form needed the rip-relative `_EVRCX` variant. Shared name
# so EMIT_GVAR_INITS can hoist the base on every backend. See CHANGELOG [6.0.88].
fn _EVRCX(S, idx): i64 { return EVADDR_X1(S, idx); }

# Add immediate to x1. ADD-immediate carries only a 12-bit imm (optionally
# LSL #12), so the bare `val & 0xFFF` silently corrupted field/array offsets
# >= 4096 (the last unguarded sibling of the EADDRA_IMM imm12-mask class;
# callers pass struct fld_off / array byte-offset, which a consumer can push
# past 4095 — self-host-invisible since cycc's own offsets are small). Mirror
# EADDRA_IMM's three-way split. See CHANGELOG [6.2.21].
fn EADDIMM_X1(S, val): i64 {
    if (val < 4096) {
        EW(S, 0x91000021 | (val << 10));                       # add x1, x1, #val
    } elif (val <= 0xFFFFFF) {
        var _lo = val & 0xFFF;
        if (_lo != 0) { EW(S, 0x91000021 | (_lo << 10)); }     # add x1, x1, #lo
        EW(S, 0x91400021 | (((val >> 12) & 0xFFF) << 10));     # add x1, x1, #hi, LSL #12
    } else {
        EW(S, 0xD2800010 | ((val & 0xFFFF) << 5));             # movz x16, #(val & 0xFFFF)
        EW(S, 0xF2A00010 | (((val >> 16) & 0xFFFF) << 5));     # movk x16, #(val>>16), LSL #16
        EW(S, 0x8B100021);                                     # add x1, x1, x16
    }
    return 0;
}

# Store: mov x1, <addr>; str x0, [x1]
fn EVSTORE(S, idx): i64 {
    # RECFIX before the address sequence so fixup patches the right instructions
    RECFIX(S, idx);
    if (_TARGET_MACHO == 2 || _pie_mode == 1) {
        EADRP(S, 1); EADD_IMM12(S, 1);
        EW(S, 0xF9000020);  # str x0, [x1]
        return 0;
    }
    EW(S, 0xD2800001);  # movz x1, #0
    EW(S, 0xF2A00001);  # movk x1, #0, lsl 16
    EW(S, 0xF2C00001);  # movk x1, #0, lsl 32
    EW(S, 0xF9000020);  # str x0, [x1]
    return 0;
}

# Load: mov x1, <addr>; ldr x0, [x1]
fn EVLOAD(S, idx): i64 {
    RECFIX(S, idx);
    if (_TARGET_MACHO == 2 || _pie_mode == 1) {
        EADRP(S, 1); EADD_IMM12(S, 1);
        EW(S, 0xF9400020);  # ldr x0, [x1]
        return 0;
    }
    EW(S, 0xD2800001);  # movz x1, #0
    EW(S, 0xF2A00001);  # movk x1, #0, lsl 16
    EW(S, 0xF2C00001);  # movk x1, #0, lsl 32
    EW(S, 0xF9400020);  # ldr x0, [x1]
    return 0;
}

# Address: mov x0, <addr>
fn EVADDR(S, idx): i64 {
    RECFIX(S, idx);
    if (_TARGET_MACHO == 2 || _pie_mode == 1) {
        EADRP(S, 0); EADD_IMM12(S, 0);
        return 0;
    }
    EW(S, 0xD2800000);  # movz x0, #0
    EW(S, 0xF2A00000);  # movk x0, #0, lsl 16
    EW(S, 0xF2C00000);  # movk x0, #0, lsl 32
    return 0;
}

# String address
fn ESADDR(S, soff): i64 {
    var fc = GFCNT(S);
    var faddr = _fixup_base + fc * 16;
    S64(faddr, GCP(S));
    S64(faddr + 8, (1 << 56) | soff);
    SFCNT(S, fc + 1);
    if (_TARGET_MACHO == 2 || _pie_mode == 1) {
        EADRP(S, 0); EADD_IMM12(S, 0);
        return 0;
    }
    EW(S, 0xD2800000);  # movz x0, #0
    EW(S, 0xF2A00000);  # movk x0, #0, lsl 16
    EW(S, 0xF2C00000);  # movk x0, #0, lsl 32
    return 0;
}

# Pop syscall args then SVC
# Translate x86 syscall number (in x8) to aarch64 equivalent
fn ESYSXLAT(S): i64 {
    # Mach-O ARM (Apple Silicon, BSD syscall convention):
    #   - syscall number goes in x16 (not x8)
    #   - svc #0x80 (not #0)
    #   - BSD numbers, not Linux: read=3, write=4, open=5, close=6,
    #     mmap=197, mprotect=74, munmap=73, exit=1
    # Emit chained cmp/b.ne/movz pattern, comparing x8 (Linux num) and
    # writing BSD num to x16. The caller-side ESYSCALL emits svc #0x80.
    if (_TARGET_MACHO == 2) {
        # read: 0→3     movz x16,#3  = 0xD2800070
        EW(S, 0xF100011F); EW(S, 0x54000041); EW(S, 0xD2800070);
        # write: 1→4    movz x16,#4  = 0xD2800090
        EW(S, 0xF100051F); EW(S, 0x54000041); EW(S, 0xD2800090);
        # open: 2→5     movz x16,#5  = 0xD28000B0
        EW(S, 0xF100091F); EW(S, 0x54000041); EW(S, 0xD28000B0);
        # close: 3→6    movz x16,#6  = 0xD28000D0
        EW(S, 0xF1000D1F); EW(S, 0x54000041); EW(S, 0xD28000D0);
        # mmap: 9→197   movz x16,#197 = 0xD2801890 (197 << 5 = 0x18A0, wrong)
        #   movz x16,#imm = 0xD2800000 | (imm << 5) | 16
        #   197 = 0xC5, <<5 = 0x18A0, |0x10 = 0x18B0 → 0xD28018B0
        EW(S, 0xF100251F); EW(S, 0x54000041); EW(S, 0xD28018B0);
        # mprotect: 10→74  74 = 0x4A, <<5 = 0x940, |0x10 = 0x950 → 0xD2800950
        EW(S, 0xF100291F); EW(S, 0x54000041); EW(S, 0xD2800950);
        # munmap: 11→73   73 = 0x49, <<5 = 0x920, |0x10 = 0x930 → 0xD2800930
        EW(S, 0xF1002D1F); EW(S, 0x54000041); EW(S, 0xD2800930);
        # exit: 60→1    movz x16,#1  = 0xD2800030
        EW(S, 0xF100F11F); EW(S, 0x54000041); EW(S, 0xD2800030);
        # ── v6.0.34: aarch64-Linux numbers → BSD ──
        # The compiler's own enum Sys uses x86 numbers (handled above);
        # the STDLIB the tools/wrapper pull (syscalls_aarch64_linux.cyr)
        # uses aarch64 numbers. Translate those to BSD too so cyrfmt/
        # cyrlint/cyrdoc/cyrius work on macOS. Pure renumbers below;
        # openat is rerouted to BSD open(5) with an arg-shift (drop the
        # AT_FDCWD dirfd — macOS open takes path/flags/mode directly).
        EW(S, 0xF100FD1F); EW(S, 0x54000041); EW(S, 0xD2800070);  # read 63→3
        EW(S, 0xF101011F); EW(S, 0x54000041); EW(S, 0xD2800090);  # write 64→4
        EW(S, 0xF100E51F); EW(S, 0x54000041); EW(S, 0xD28000D0);  # close 57→6
        EW(S, 0xF100F91F); EW(S, 0x54000041); EW(S, 0xD28018F0);  # lseek 62→199
        EW(S, 0xF103791F); EW(S, 0x54000041); EW(S, 0xD28018B0);  # mmap 222→197
        EW(S, 0xF103891F); EW(S, 0x54000041); EW(S, 0xD2800950);  # mprotect 226→74
        EW(S, 0xF1035D1F); EW(S, 0x54000041); EW(S, 0xD2800930);  # munmap 215→73
        EW(S, 0xF101751F); EW(S, 0x54000041); EW(S, 0xD2800030);  # exit 93→1
        EW(S, 0xF101791F); EW(S, 0x54000041); EW(S, 0xD2800030);  # exit_group 94→1
        # openat 56 → open 5 (arg-shift x0=path,x1=flags,x2=mode; b.ne +20)
        EW(S, 0xF100E11F); EW(S, 0x540000A1);
        EW(S, 0xAA0103E0); EW(S, 0xAA0203E1); EW(S, 0xAA0303E2);
        EW(S, 0xD28000B0);
        # ── v6.0.34: wrapper (cbt) process + fs syscalls ──
        EW(S, 0xF103751F); EW(S, 0x54000041); EW(S, 0xD2800770);  # execve 221→59
        EW(S, 0xF100611F); EW(S, 0x54000041); EW(S, 0xD2800B50);  # dup3 24→dup2 90
        EW(S, 0xF104111F); EW(S, 0x54000041); EW(S, 0xD28000F0);  # wait4 260→7
        EW(S, 0xF103711F); EW(S, 0x54000041); EW(S, 0xD2800050);  # clone 220→fork 2 (x1-fixup post-svc)
        # mkdirat 34 → mkdir 136 (arg-shift x0=path,x1=mode; b.ne +16)
        EW(S, 0xF100891F); EW(S, 0x54000081); EW(S, 0xAA0103E0); EW(S, 0xAA0203E1); EW(S, 0xD2801110);
        # v6.5.7: unlinkat 35 → Darwin unlinkat 472, a PURE RENUMBER. It used to map to
        # Darwin unlink(10) with an x1→x0 arg-shift that DROPPED the dirfd and the flag —
        # right for `unlink`, and fatal for `rmdir`, which is the same syscall with
        # AT_REMOVEDIR. So on macOS-arm64 `sys_rmdir` ran unlink(AT_FDCWD) — the dirfd
        # -2 reinterpreted as the path pointer — and returned -1 for every directory.
        # `xrmdir` therefore never worked on this target from the day it shipped (v6.5.2);
        # found the first time vr01_syscall_wrappers.tcyr ran on ecb.
        # All three callers (syscalls_aarch64_linux.cyr:489/:495, linux_common.cyr:91) pass
        # the full (dirfd, path, flags) form, and Darwin's unlinkat takes the same three, so
        # the renumber is safe and strictly more faithful than the shift it replaces.
        # cmp x8,#35; b.ne +8; movz x16,#472 = 0xD2803B10 (aarch64-linux-gnu-as verified).
        EW(S, 0xF1008D1F); EW(S, 0x54000041); EW(S, 0xD2803B10);  # unlinkat 35→472
        # fchmodat 53 → chmod 15 (arg-shift x0=path,x1=mode; b.ne +16)
        EW(S, 0xF100D51F); EW(S, 0x54000081); EW(S, 0xAA0103E0); EW(S, 0xAA0203E1); EW(S, 0xD28001F0);
        # ── v6.0.34: raw x86-number syscalls the cbt wrapper hardcodes
        # (syscall(39)/(82)/(4)/(79)/(88)) — same x86→BSD renumbers the
        # Linux-aarch64 ESYSXLAT does. Without these, the untranslated svc
        # ran with a stale x16 → garbage call + side effects that broke
        # `cyrius build` (esp. getpid for the temp name + rename for the
        # atomic output move). Pure renumbers (arg conventions match BSD).
        EW(S, 0xF100111F); EW(S, 0x54000041); EW(S, 0xD2801790);  # stat 4→188
        EW(S, 0xF1009D1F); EW(S, 0x54000041); EW(S, 0xD2800290);  # getpid 39→20
        # v6.3.44: aarch64-macOS getpid + getppid. The aarch64-macho stdlib uses the
        # aarch64-LINUX syscall numbers (syscalls.cyr → syscalls_aarch64_linux.cyr:
        # getpid=172, getppid=173), NOT the x86 39/110 — and NEITHER 172 nor 173 was
        # translated. So getpid ran an untranslated svc and returned positive GARBAGE
        # (which passed the old callable-only smoke), and getppid returned 0. Map both
        # to their BSD numbers (getpid=20, getppid=39). The 39→20 above stays for the
        # cbt hardcodes syscall(39). Encodings verified via llvm-mc + disasm on ecb.
        EW(S, 0xF102B11F); EW(S, 0x54000041); EW(S, 0xD2800290);  # getpid  172→20
        EW(S, 0xF102B51F); EW(S, 0x54000041); EW(S, 0xD28004F0);  # getppid 173→39
        # v6.4.51: rt_sigaction (aarch64-Linux #134) → BSD sigaction 46, for
        # signal_ignore(SIGPIPE) so a server on sock_send survives a peer
        # disconnect on macOS instead of dying (SIGPIPE DoS). llvm-mc-verified:
        # cmp x8,#134=0xF102191F, movz x16,#46=0xD28005D0. See signal_ignore
        # (lib/syscalls.cyr) + issue 2026-07-11-sandhi-signal-ignore-stdlib-gap.
        EW(S, 0xF102191F); EW(S, 0x54000041); EW(S, 0xD28005D0);  # rt_sigaction 134→46
        # v6.0.41: Darwin has NO getcwd syscall — the old `79→326` map was
        # bogus (slot 326 is unused → SIGSYS, which killed `cyrius deps`/
        # `build` for any [deps] manifest via _abs_path). cwd is now derived
        # in _abs_path via open(".")+fcntl(F_GETPATH)+close, so getcwd needs
        # no mapping; fcntl does. fcntl: x86 72 → BSD 92.
        EW(S, 0xF101211F); EW(S, 0x54000041); EW(S, 0xD2800B90);  # fcntl 72→92
        EW(S, 0xF101491F); EW(S, 0x54000041); EW(S, 0xD2801010);  # rename 82→128
        # v6.4.57: fsync 74→BSD 95 (Darwin arm64). syscalls_aarch64_linux.cyr (the peer
        # arm-macho pulls) issues x86 number 74; untranslated it ran BSD 74 (mprotect) —
        # the durability half of lib/io.cyr file_write_atomic was a wrong syscall on
        # macOS. Pure renumber (fsync takes just fd; x16=95). cmp x8,#74=0xF101291F;
        # movz x16,#95=0xD2800BF0 (llvm-mc -triple aarch64-apple-darwin verified).
        EW(S, 0xF101291F); EW(S, 0x54000041); EW(S, 0xD2800BF0);  # fsync  74→95
        EW(S, 0xF101611F); EW(S, 0x54000041); EW(S, 0xD2800730);  # symlink 88→57
        # v6.1.20: aarch64-Linux at-family numbers the macho branch never mapped —
        # sys_stat/lstat/fstatat (262), sys_link/linkat (37), sys_rename/renameat
        # (38) ran with a stale x16 → wrong Darwin syscall (rc -9/-14 on ecb). The
        # aarch64-Linux stdlib (syscalls_aarch64_linux.cyr) routes the bare names
        # through the at-family, and Darwin HAS the at-family (no arg-shift needed —
        # dirfd/path/.../flags layouts match), so these are pure renumbers to the
        # Darwin BSD numbers (from MacOSX.sdk sys/syscall.h, llvm-mc -arch arm64
        # verified). newfstatat→fstatat64 fills a Darwin stat64 struct, whose field
        # offsets differ from Linux's — handled in syscalls_aarch64_linux.cyr's
        # #ifdef CYRIUS_TARGET_MACOS Stat enum. utimensat (280) has NO Darwin
        # syscall → the wrapper returns -ENOSYS on macOS (not routed here). See
        # issues/2026-06-08-macho-arm-at-family-darwin-syscall-mappings.md, CHANGELOG [6.1.20].
        EW(S, 0xF104191F); EW(S, 0x54000041); EW(S, 0xD2803AD0);  # newfstatat 262→fstatat64 470
        EW(S, 0xF100951F); EW(S, 0x54000041); EW(S, 0xD2803AF0);  # linkat 37→471
        EW(S, 0xF100991F); EW(S, 0x54000041); EW(S, 0xD2803A30);  # renameat 38→465
        # v6.5.7: fchownat, reached through the private alias 1054 (see the
        # aarch64-Linux arm at the end of this fn, and the SYS_FCHOWNAT comment in
        # lib/syscalls_aarch64_linux.cyr — macOS-arm64 resolves THAT peer, so the
        # alias arrives here too and an absent row leaves a stale x16). No ordering
        # hazard on this branch: the chain compares x8 and writes x16, so the 468 it
        # produces can never be re-caught. cmp x8,#1054 = 0xF110791F;
        # movz x16,#468 = 0xD2803A90 (aarch64-linux-gnu-as verified).
        EW(S, 0xF110791F); EW(S, 0x54000041); EW(S, 0xD2803A90);  # fchownat 1054→468
        # v6.5.7: chdir alias → Darwin 12. macOS-arm64 resolves the aarch64-Linux peer, so
        # the alias arrives here too; without this row x16 is stale.
        # cmp x8,#1049 = 0xF110651F; movz x16,#12 = 0xD2800190 (aarch64-linux-gnu-as verified).
        EW(S, 0xF110651F); EW(S, 0x54000041); EW(S, 0xD2800190);  # chdir 1049→12
        # v6.5.7: symlinkat + readlinkat. The aarch64 peer's sys_symlink/sys_readlink have
        # always issued 36 / 78, and this branch never mapped either — so on macOS-arm64
        # they ran with a stale x16 and the compiler warned "syscall not routed" on every
        # build that touched them. Newly REACHABLE this release via xsymlink/xreadlink, and
        # found the first time vr01_syscall_wrappers.tcyr ran on ecb. Pure renumbers: Linux
        # symlinkat(target, newdirfd, linkpath) and readlinkat(dirfd, path, buf, sz) have
        # the same arg layout as Darwin's. Numbers read off ecb's SDK sys/syscall.h.
        # cmp x8,#36 = 0xF100911F; movz x16,#474 = 0xD2803B50 (aarch64-linux-gnu-as verified).
        EW(S, 0xF100911F); EW(S, 0x54000041); EW(S, 0xD2803B50);  # symlinkat  36→474
        EW(S, 0xF101391F); EW(S, 0x54000041); EW(S, 0xD2803B30);  # readlinkat 78→473
        # v6.0.84: socketpair. arm-macho pulls syscalls_aarch64_linux.cyr (see
        # lib/syscalls.cyr — there is no syscalls_aarch64_macos.cyr), so the
        # number is the aarch64-Linux 199, NOT the x86/macos 53 (which is
        # fchmodat on this enum, already mapped above → a 53 entry would collide).
        # Untranslated 199 ran svc with a stale x16 → garbage fds → the
        # fork+socketpair TLS e2e (tls12_handshake.tcyr) failed every socket
        # read/write (TLS_ERR_IO). Masked until the thread_local crypto crash
        # (same slot) was fixed. The x86-macho peer maps 53→135 (x86 enum) in
        # x86/emit.cyr EMACHO_SYSXLAT. cmp x8,#199 = 0xF1031D1F; movz x16,#135 =
        # 0xD28010F0 (as -arch arm64 verified). socketpair 199 → Darwin 135.
        EW(S, 0xF1031D1F); EW(S, 0x54000041); EW(S, 0xD28010F0);  # socketpair 199→135
        # ── v6.0.59: net.cyr socket surface (x86 nums → Darwin BSD). lib/net.cyr
        # uses the x86 socket numbers; without these the svc ran with a stale x16
        # → garbage socket fd + EBADF connect (all networking broke on macОS).
        # See 2026-06-04-macos-net-socket-syscalls-unported.md. (cmp/b.ne/movz,
        # encodings llvm-mc-verified.)
        EW(S, 0xF100A51F); EW(S, 0x54000041); EW(S, 0xD2800C30);  # socket     41→97
        EW(S, 0xF100A91F); EW(S, 0x54000041); EW(S, 0xD2800C50);  # connect    42→98
        EW(S, 0xF100AD1F); EW(S, 0x54000041); EW(S, 0xD28003D0);  # accept     43→30
        EW(S, 0xF100C11F); EW(S, 0x54000041); EW(S, 0xD28010D0);  # shutdown   48→134
        EW(S, 0xF100C51F); EW(S, 0x54000041); EW(S, 0xD2800D10);  # bind       49→104
        EW(S, 0xF100C91F); EW(S, 0x54000041); EW(S, 0xD2800D50);  # listen     50→106
        EW(S, 0xF100D91F); EW(S, 0x54000041); EW(S, 0xD2800D30);  # setsockopt 54→105
        EW(S, 0xF100DD1F); EW(S, 0x54000041); EW(S, 0xD2800ED0);  # getsockopt 55→118
        # v6.2.24: aarch64-Linux socket numbers → Darwin. The .59 port mapped only
        # the x86 numbers (41-55), but after the v6.2.24 net/fs SYS_* dedup,
        # consumers that reference the canonical syscalls_aarch64_linux peer (yukti,
        # sandhi) issue the aarch64 numbers (198/200/201/203/208), which the macho
        # backend never mapped → stale x16 + garbage fd on Darwin. Same x86+aarch64
        # dual-map shape as getdents64 below (v6.0.63). Darwin targets identical to
        # the x86 rows above; only the cmp input differs.
        EW(S, 0xF103191F); EW(S, 0x54000041); EW(S, 0xD2800C30);  # socket    198→97
        # v6.4.64: getpeername/getsockname join the dual-map for the same reason the
        # block exists — macOS-arm64 resolves the syscalls_aarch64_linux peer, so a
        # consumer calling sys_getpeername() issues the AARCH64 number (205/204), which
        # Darwin does not understand. Mapping the aarch64 numbers is safe where mapping
        # the x86 ones is NOT: x86-52 collides with that peer's own SYS_FCHMOD = 52
        # (CI caught it — sandbox_syscalls RED on pi), whereas 204/205 are unambiguous
        # here, exactly like socket 198→97 above. BSD: accept=30, getpeername=31,
        # getsockname=32.
        EW(S, 0xF103351F); EW(S, 0x54000041); EW(S, 0xD28003F0);  # getpeername 205→31
        EW(S, 0xF103311F); EW(S, 0x54000041); EW(S, 0xD2800410);  # getsockname 204→32
        EW(S, 0xF1032D1F); EW(S, 0x54000041); EW(S, 0xD2800C50);  # connect   203→98
        EW(S, 0xF103211F); EW(S, 0x54000041); EW(S, 0xD2800D10);  # bind      200→104
        EW(S, 0xF103251F); EW(S, 0x54000041); EW(S, 0xD2800D50);  # listen    201→106
        EW(S, 0xF103411F); EW(S, 0x54000041); EW(S, 0xD2800D30);  # setsockopt 208→105
        EW(S, 0xF1001D1F); EW(S, 0x54000041); EW(S, 0xD2801CD0);  # poll        7→230
        # v6.0.60: dir enumeration — Linux getdents64 (x86 217) → Darwin
        # getdirentries64 (344). Darwin takes a 4th basep out-param; fs.cyr
        # passes it on macОS. See 2026-06-02-macos-getdirentries-dir-listing-port.md.
        EW(S, 0xF103651F); EW(S, 0x54000041); EW(S, 0xD2802B10);  # getdents64 217→344
        # v6.0.63: the .60 port only translated the x86 number (217). But the
        # wrapper/tools pull the aarch64-Linux stdlib (syscalls_aarch64_linux.cyr),
        # whose SYS_GETDENTS64 = 61 — and which WINS over fs.cyr's 217 when included
        # last (cbt/cyrius.cyr: fs.cyr then syscalls.cyr). Untranslated 61 ran with a
        # stale x16 → EBADF, so `cyrius lib sync` reported "snapshot lib not found"
        # on a dir that exists, and macOS was broken-in-fact (found by yantra CI).
        # A small probe bound 217 (different include order) and worked, masking it.
        # cmp x8,#61 = 0xF100F51F; movz x16,#344 = 0xD2802B10. See CHANGELOG [6.0.63].
        EW(S, 0xF100F51F); EW(S, 0x54000041); EW(S, 0xD2802B10);  # getdents64 aarch64 61→344
        # v6.0.75: getrandom → Darwin getentropy (BSD 500). macОS has NO
        # getrandom; the old SYS_GETRANDOM=318 (a Linux number) ran as a
        # bogus Darwin call → garbage random → the WHOLE native TLS stack
        # (1.2+1.3) was non-functional on macOS (it filled key/nonce/random
        # buffers with junk, so build_client_hello and every CSPRNG path
        # failed). Map both the x86/macos number (318) and the aarch64-Linux
        # number (278) → 500 (defensive dual-map, cf. getdents64 above). The
        # 0-on-success → byte-count return conversion is the ESYSCALL post-svc
        # fixup. getentropy caps at 256 bytes/call (ample for TLS's ≤32).
        # cmp x8,#318 = 0xF104F91F; movz x16,#500 = 0xD2803E90.
        EW(S, 0xF104F91F); EW(S, 0x54000041); EW(S, 0xD2803E90);  # getrandom 318→getentropy 500
        EW(S, 0xF104591F); EW(S, 0x54000041); EW(S, 0xD2803E90);  # getrandom aarch64 278→500
        # v6.5.15: pipe. The aarch64 peer's sys_pipe issues SYS_PIPE2 = 59, which this
        # branch never mapped — so `syscall(59, &fds)` ran with a stale x16 and the two
        # fds were never written (lib/process.cyr:71 then load32s garbage → "pipe read 4
        # (got -9)" = EBADF). Darwin `pipe` is BSD 42 and takes NO argument: it returns
        # fd0 in x0 and fd1 in x1 and does NOT touch the caller's buffer, so the renumber
        # alone is not enough — the x0/x1 → [buf], [buf+4] store lives in the ESYSCALL
        # post-svc fixup next to the fork x1-fixup. This is the cross-arch twin of the
        # x86-macho `_msx(S, 22, 0x200002A)` + EMACHO_PROC_FIXUP pipe pair (v6.0.58),
        # which arm64 was never given. Darwin's `pipe` has no flags word, so any
        # O_CLOEXEC/O_NONBLOCK a caller passes to pipe2 is silently dropped — apply it
        # post-hoc with fcntl (already mapped, 72→92) if a consumer needs it.
        # SYS_pipe 42 read off ecb's MacOSX.sdk sys/syscall.h AND confirmed by a live
        # raw-svc probe (x0=3, x1=4, caller buffer untouched).
        # cmp x8,#59 = 0xF100ED1F; movz x16,#42 = 0xD2800550 (as -arch arm64 verified).
        EW(S, 0xF100ED1F); EW(S, 0x54000041); EW(S, 0xD2800550);  # pipe2 59→pipe 42 (x0/x1-fixup post-svc)
        # v6.5.15: fchmod. syscalls_linux_common.cyr:153 issues the peer's SYS_FCHMOD,
        # which on the aarch64 enum is 52 — unmapped here, so sys_fchmod ran a stale x16.
        # ⚠ The "x86-52 collides with SYS_FCHMOD" warning in syscalls_aarch64_linux.cyr:202
        # is about the aarch64-LINUX arm (where x86-52 would be re-caught as getpeername);
        # on THIS branch 52 as a SOURCE number is unambiguously fchmod, and getpeername
        # arrives as the aarch64 number 205 (mapped above). Pure renumber — (fd, mode) is
        # identical on both. Darwin SYS_fchmod 124 read off ecb's SDK header AND live-probed
        # (fchmod(fd,0644)→0 with fstat confirming 0644; bad fd → -9 EBADF).
        # cmp x8,#52 = 0xF100D11F; movz x16,#124 = 0xD2800F90 (as -arch arm64 verified).
        EW(S, 0xF100D11F); EW(S, 0x54000041); EW(S, 0xD2800F90);  # fchmod 52→124
        # v6.5.15: faccessat — the REAL at-family hole. syscalls_aarch64_linux.cyr:81 sets
        # SYS_FACCESSAT = 269 (the x86 number, chosen to dodge an aarch64-Linux collision)
        # and :636 routes sys_access through it, so EVERY existence check on macOS-arm64
        # ran with a stale x16. Mapped on the aarch64-Linux arm at the end of this fn but
        # never here. (fstatat needs NO entry: the peer issues SYS_NEWFSTATAT = 262, already
        # mapped to fstatat64 470 above — a `cmp x8,#79` row would be dead code.) Pure
        # renumber: Linux faccessat(dirfd, path, mode, flags) matches Darwin's. Darwin
        # SYS_faccessat 466 read off ecb's SDK header AND live-probed with AT_FDCWD = -2
        # (existing → 0, missing → -2 ENOENT).
        # cmp x8,#269 = 0xF104351F; movz x16,#466 = 0xD2803A50 (as -arch arm64 verified).
        EW(S, 0xF104351F); EW(S, 0x54000041); EW(S, 0xD2803A50);  # faccessat 269→466
        # v6.5.16: sysctl + gettimeofday, the two Darwin-only private aliases that
        # back lib/sys.cyr's macOS sys_uname/sys_sysinfo. Darwin has no uname(2)
        # and no sysinfo(2); the data is read through sysctl(2), and uptime needs a
        # wall-clock "now" to subtract kern.boottime from. gettimeofday is used
        # rather than clock_gettime because syscall(228) is NOT routed on x86-macOS
        # (lib/chrono.cyr:27 — "that arch is HELD"), and a time source that works on
        # ecb but is dead on ach is precisely the "fixed one fork, not the other"
        # shape that turned the v6.5.15 gate RED.
        # No ordering hazard on this branch (compares x8, writes x16 — the 202/116
        # produced can never be re-caught), and no aarch64-Linux arm exists for
        # either: Linux has no live sysctl to renumber to, and every call site is
        # inside `#ifdef CYRIUS_TARGET_MACOS` so the lines are removed before parse
        # on Linux. See lib/syscalls_aarch64_linux.cyr's alias-band comment.
        # Both live-probed on ecb with x16 set by hand: sysctl {1,1} → "Darwin"
        # (rc 0, outlen 7), gettimeofday → tv_sec matching libc time(0).
        # cmp x8,#1202 = 0xF112C91F; movz x16,#202 = 0xD2801950;
        # cmp x8,#1116 = 0xF111711F; movz x16,#116 = 0xD2800E90 (as -arch arm64 verified).
        EW(S, 0xF112C91F); EW(S, 0x54000041); EW(S, 0xD2801950);  # sysctl       1202→202
        EW(S, 0xF111711F); EW(S, 0x54000041); EW(S, 0xD2800E90);  # gettimeofday 1116→116
        # v6.5.27 — kqueue/kevent (Darwin readiness API), private-alias band 1000+native.
        # cmp x8,#1362 = 0xF115491F; movz x16,#362 = 0xD2802D50
        # cmp x8,#1363 = 0xF1154D1F; movz x16,#363 = 0xD2802D70
        # Encodings derived with the same SUBS/MOVZ field layout as the rows above, and the
        # deriver was cross-checked by re-computing those rows' known-good values first.
        EW(S, 0xF115491F); EW(S, 0x54000041); EW(S, 0xD2802D50);  # kqueue 1362→362
        EW(S, 0xF1154D1F); EW(S, 0x54000041); EW(S, 0xD2802D70);  # kevent 1363→363
        # ── v6.5.16: the credential family. `is_root()` hardcoded `return 0` on macOS
        # (lib/sys.cyr), so the ONE consumer that would have exercised these never called
        # them and the whole family sat unrouted on BOTH Mach-O backends since forever:
        # on ecb sys_getuid() returned -9 (stale x16 falling onto a neighbouring call),
        # on ach it SIGSYS'd (rc 140). A primitive that fails in a way that makes its
        # caller skip is invisible — the same shape as the original macOS rot. Pure
        # renumbers, no args. Darwin numbers are NOT sequential (getegid 43 precedes
        # getgid 47) — a guessed value would be wrong; these were read off ecb's SDK
        # syscall.h AND live-probed (raw svc → 501/501/20/20, matching `id -u`/`id -g`).
        # Gated by tests/tcyr/crossos/uid_identity.tcyr, which asserts the REAL uid
        # rather than `>= 0` so a wrapper returning a constant still fails.
        # as -arch arm64 verified (control: the shipped getpid 172→20 row re-assembles
        # to the identical F102B11F/D2800290 pair).
        EW(S, 0xF102B91F); EW(S, 0x54000041); EW(S, 0xD2800310);  # getuid  174→24
        EW(S, 0xF102BD1F); EW(S, 0x54000041); EW(S, 0xD2800330);  # geteuid 175→25
        EW(S, 0xF102C11F); EW(S, 0x54000041); EW(S, 0xD28005F0);  # getgid  176→47
        EW(S, 0xF102C51F); EW(S, 0x54000041); EW(S, 0xD2800570);  # getegid 177→43
        # v6.5.16: fstat. ⚠ NOT Darwin's bare `fstat` (189) — this peer's Stat enum uses
        # the **stat64** field offsets (MODE=4, SIZE=96, syscalls_aarch64_linux.cyr:521),
        # and 189 fills the LEGACY struct (MODE=8, SIZE=72). Live-probed on ecb against
        # /etc/hosts: 189 → mode@8 + size@72, 339 → mode@4 + size@96. Routing 80→189 would
        # have returned rc=0 with every field silently wrong — worse than the stale-x16 it
        # replaces. The x86 peer is the mirror image (legacy offsets → 5→189 is correct
        # there), which is exactly why the parity gate compares CAPABILITY, not number.
        EW(S, 0xF101411F); EW(S, 0x54000041); EW(S, 0xD2802A70);  # fstat 80→fstat64 339
        # v6.5.16: fcntl. This peer's SYS_FCNTL is 25, and only the raw x86 72 was routed
        # (for lib/net.cyr's hardcoded syscall(72,...)), so every `syscall(SYS_FCNTL, …)`
        # in lib/async.cyr — the O_NONBLOCK + FD_CLOEXEC setup on every async fd — ran
        # with a stale x16 on macOS-arm64. Same Darwin target as the 72 row (BSD 92).
        EW(S, 0xF100651F); EW(S, 0x54000041); EW(S, 0xD2800B90);  # fcntl 25→92
        EW(S, 0xF1012D1F); EW(S, 0x54000041); EW(S, 0xD2801770);  # fdatasync 75→187
        EW(S, 0xF1005D1F); EW(S, 0x54000041); EW(S, 0xD2800530);  # dup   23→41
        EW(S, 0xF100751F); EW(S, 0x54000041); EW(S, 0xD28006D0);  # ioctl 29→54
        EW(S, 0xF102051F); EW(S, 0x54000041); EW(S, 0xD28004B0);  # kill  129→37
        EW(S, 0xF101451F); EW(S, 0x54000041); EW(S, 0xD2800490);  # sync  81→36
        EW(S, 0xF102C91F); EW(S, 0x54000041); EW(S, 0xD2802E90);  # gettid 178→thread_selfid 372
        EW(S, 0xF1033D1F); EW(S, 0x54000041); EW(S, 0xD28003B0);  # recvfrom 207→29
        EW(S, 0xF103511F); EW(S, 0x54000041); EW(S, 0xD2800370);  # recvmsg  212→27
        EW(S, 0xF102491F); EW(S, 0x54000041); EW(S, 0xD28002F0);  # setuid    146→23
        EW(S, 0xF102411F); EW(S, 0x54000041); EW(S, 0xD28016B0);  # setgid    144→181
        EW(S, 0xF102751F); EW(S, 0x54000041); EW(S, 0xD2801270);  # setsid    157→147
        EW(S, 0xF1027D1F); EW(S, 0x54000041); EW(S, 0xD2800A10);  # setgroups 159→80
        # v6.5.16: flock. lib/io.cyr's macOS arm issued a raw `syscall(92)` labelled
        # "BSD flock" — but Darwin 92 is fcntl and flock is 131, and 92 was not a routed
        # source here either. io.cyr now issues the x86-Linux number 73 on macOS so one
        # source serves both Mach-O backends. cmp x8,#73 = 0xF101251F;
        # movz x16,#131 = 0xD2801070 (as -arch arm64 verified on ecb).
        EW(S, 0xF101251F); EW(S, 0x54000041); EW(S, 0xD2801070);  # flock 73→131
        return 0;
    }
    # Emit: compare x8 against known x86 numbers, replace with aarch64
    # x86:0=read→a64:63, x86:1=write→a64:64, x86:2=open→a64:56
    # x86:3=close→a64:57, x86:12=brk→a64:214, x86:60=exit→a64:93
    # x86:59=execve→a64:221, x86:57=fork→a64:220
    # x86:228=clock_gettime→a64:113
    # Implemented as chained: cmp x8, #N; b.ne +8; movz x8, #M
    # x86→aarch64 syscall translation (cmp/b.ne/movz chain)
    # read: 0→63     movz x8,#63  = 0xD28007E8
    EW(S, 0xF100011F); EW(S, 0x54000041); EW(S, 0xD28007E8);
    # write: 1→64    movz x8,#64  = 0xD2800808
    EW(S, 0xF100051F); EW(S, 0x54000041); EW(S, 0xD2800808);
    # open: 2→56 + arg-shift to openat(AT_FDCWD,path,flags,mode). aarch64-Linux
    # has NO open(2); the compiler's `enum Sys` uses x86 open=2 (correct for the
    # x86-hosted cross-compiler, which is ESYSXLAT-free), but the EMITTED native
    # aarch64 code must call openat(56) with AT_FDCWD inserted as the dirfd.
    # open(path,flags,mode) in x0/x1/x2 → openat(AT_FDCWD,path,flags,mode) in
    # x0/x1/x2/x3. Without the shift, `path` sat in the dirfd slot → EFAULT, so
    # READFILE returned 0 and PREPROCESS expanded ZERO includes — which is why
    # native aarch64 self-host (never gated until v6.0.45) failed with
    # 'undefined variable _TARGET_MACHO'. The Mach-O path does the inverse
    # (openat→open) shift above. cmp x8,#2; b.ne +24 (skip 5); mov x3,x2;
    # mov x2,x1; mov x1,x0; movn x0,#99(AT_FDCWD=-100); movz x8,#56.
    EW(S, 0xF100091F); EW(S, 0x540000C1);
    EW(S, 0xAA0203E3); EW(S, 0xAA0103E2); EW(S, 0xAA0003E1); EW(S, 0x92800C60);
    EW(S, 0xD2800708);
    # close: 3→57    movz x8,#57  = 0xD2800728
    EW(S, 0xF1000D1F); EW(S, 0x54000041); EW(S, 0xD2800728);
    # brk: 12→214    movz x8,#214 = 0xD2801AC8
    EW(S, 0xF100311F); EW(S, 0x54000041); EW(S, 0xD2801AC8);
    # exit: 60→93    movz x8,#93  = 0xD2800BA8
    EW(S, 0xF100F11F); EW(S, 0x54000041); EW(S, 0xD2800BA8);
    # clock_gettime: 228→113  movz x8,#113 = 0xD2800E28
    EW(S, 0xF103911F); EW(S, 0x54000041); EW(S, 0xD2800E28);
    # mmap: 9→222       cmp x8,#9 = 0xF100251F; movz x8,#222 = 0xD2801BC8
    EW(S, 0xF100251F); EW(S, 0x54000041); EW(S, 0xD2801BC8);
    # mprotect: 10→226  cmp x8,#10 = 0xF100291F; movz x8,#226 = 0xD2801C48
    EW(S, 0xF100291F); EW(S, 0x54000041); EW(S, 0xD2801C48);
    # munmap: 11→215    cmp x8,#11 = 0xF1002D1F; movz x8,#215 = 0xD2801AE8
    EW(S, 0xF1002D1F); EW(S, 0x54000041); EW(S, 0xD2801AE8);
    # getpid: 39→172    cmp x8,#39 = 0xF1009D1F; movz x8,#172 = 0xD2801588
    EW(S, 0xF1009D1F); EW(S, 0x54000041); EW(S, 0xD2801588);
    # v6.2.27: pipe 22 → pipe2 59 + flags=0. aarch64-Linux has NO pipe(2)
    # (22 is epoll_pwait there); only pipe2(fds, flags). Raw `syscall(22, &fds)`
    # is a sanctioned x86-canonical call (_SC_ARITY n==22 → 1 arg, parse_expr.cyr:24)
    # used by tests/tcyr/platform/process.tcyr's fork+pipe group and any consumer issuing a
    # bare pipe. Untranslated, x8=22 ran epoll_pwait(garbage) → -EINVAL, garbage
    # rfd/wfd → downstream SIGSEGV/SIGILL. Same self-host-blind class as the v6.2.10
    # socket + v6.2.24 getdents64 gaps (cycc self-host never issues pipe). pipe(fds)
    # x0 → pipe2(fds, 0) x0/x1: set flags=0 in x1, then x8=59. cmp x8,#22; b.ne +12
    # (skip 2); movz x1,#0; movz x8,#59 (pipe2). aarch64-linux-gnu-as verified.
    EW(S, 0xF100591F); EW(S, 0x54000061); EW(S, 0xD2800001); EW(S, 0xD2800768);
    # v6.2.10: net.cyr socket surface on aarch64-Linux. lib/net.cyr issues the
    # x86 socket syscall NUMBERS (SYS_SOCKET=41, SYS_CONNECT=42, ... + raw
    # fcntl 72 / poll 7) and relies on ESYSXLAT to renumber them — but those
    # renumbers existed ONLY in the _TARGET_MACHO==2 branch (added v6.0.59 for
    # macOS), never here. So on native aarch64-Linux EVERY net.cyr INET call hit
    # the wrong syscall (socket 41 → pivot_root → -EPERM; fcntl 72 → pselect6;
    # poll 7 → fsetxattr), i.e. ALL of tcp_socket / net_connect_nb / the new v6
    # surface was silently broken. cycc self-host never exercises net, so it went
    # unseen until net_v6_connect.tcyr ran on real pi hardware. Pure renumbers
    # (x86 + aarch64-Linux share the socket/fcntl arg layouts); movz x8. Mirrors
    # the macho socket block. See 2026-06-15-cyrius-net-v6-darwin.md.
    EW(S, 0xF100A51F); EW(S, 0x54000041); EW(S, 0xD28018C8);  # socket      41→198
    EW(S, 0xF100A91F); EW(S, 0x54000041); EW(S, 0xD2801968);  # connect     42→203
    EW(S, 0xF100AD1F); EW(S, 0x54000041); EW(S, 0xD2801948);  # accept      43→202
    EW(S, 0xF100C11F); EW(S, 0x54000041); EW(S, 0xD2801A48);  # shutdown    48→210
    EW(S, 0xF100C51F); EW(S, 0x54000041); EW(S, 0xD2801908);  # bind        49→200
    EW(S, 0xF100C91F); EW(S, 0x54000041); EW(S, 0xD2801928);  # listen      50→201
    EW(S, 0xF100CD1F); EW(S, 0x54000041); EW(S, 0xD2801988);  # getsockname 51→204
    EW(S, 0xF100D91F); EW(S, 0x54000041); EW(S, 0xD2801A08);  # setsockopt  54→208
    EW(S, 0xF100DD1F); EW(S, 0x54000041); EW(S, 0xD2801A28);  # getsockopt  55→209
    # v6.2.24: getdents64 — the v6.2.24 fs.cyr SYS_*→FSYS_ dedup made fs.cyr emit
    # the x86 number 217 (was the peer's a64 61 via the pre-dedup collision), but
    # this branch (unlike the macho one, which maps both 217→344 + 61→344) never
    # had a 217→61 renumber — so `cyrius lib sync`'s dir-walk hit syscall 217
    # (a64: not getdents) and vendored nothing. Same self-host-blind class as the
    # v6.2.10 socket renumbers; caught by the aarch64 funcgate. cmp x8,#217 =
    # 0xF103651F; movz x8,#61 = 0xD28007A8.
    EW(S, 0xF103651F); EW(S, 0x54000041); EW(S, 0xD28007A8);  # getdents64  217→61
    EW(S, 0xF101211F); EW(S, 0x54000041); EW(S, 0xD2800328);  # fcntl       72→25
    # v6.2.x: flock 73→32. lib/io.cyr's file_lock/unlock/trylock issue the x86
    # flock number (73); on aarch64-Linux 73 is ppoll, so the untranslated svc
    # ran ppoll(fd, LOCK_EX, ...) → deref'd fd as a struct pollfd* → -EFAULT
    # (io.tcyr "lock acquired"/"trylock ok" → got -14). Pure renumber (flock's
    # (fd, operation) arg layout is identical on x86 + aarch64). MUST stay BEFORE
    # the poll→ppoll block below, which sets x8=73 — placing this after it would
    # re-catch a remapped poll(73) and wrongly turn it into flock(32).
    # cmp x8,#73 = 0xF101251F; movz x8,#32 = 0xD2800408 (aarch64-as verified).
    EW(S, 0xF101251F); EW(S, 0x54000041); EW(S, 0xD2800408);  # flock       73→32
    # poll 7 → ppoll 73 + timespec arg-shift. aarch64-Linux has no poll(2)
    # (7=fsetxattr); x86 poll(fds,nfds,timeout_ms) →
    # ppoll(fds,nfds,timespec*,sigmask=0,sigsetsize=0). Convert the int ms in x2
    # to a {sec,nsec} timespec at [sp,#-16] — scratch BELOW sp: ESYSCALL fires the
    # svc immediately after ESYSXLAT with nothing touching the stack, so no sp
    # adjust is owed. ms<0 → NULL tmo_p (infinite). Fixes net_connect_sa_nb's
    # POLLOUT connect-wait AND chrono.cyr sleep_ms (both issue raw poll(7), which
    # returned -EFAULT instantly on aarch64 before this — no sleep / failed
    # connect). Assembled branch offsets baked in — these 18 words MUST stay
    # contiguous (aarch64-linux-gnu-as verified). See issue above.
    EW(S, 0xF1001D1F); EW(S, 0x54000221);   # cmp x8,#7;  b.ne poll_end(+0x44, past block)
    EW(S, 0xF100005F); EW(S, 0x5400016B);   # cmp x2,#0;  b.lt poll_null (ms<0 → NULL)
    EW(S, 0xD2807D09);                       # movz x9,#1000
    EW(S, 0x9AC9084A);                       # udiv x10,x2,x9        (tv_sec = ms/1000)
    EW(S, 0x9B09894B);                       # msub x11,x10,x9,x2    (rem_ms = ms - sec*1000)
    EW(S, 0xD288480C); EW(S, 0xF2A001EC);   # movz x12,#0x4240; movk x12,#0xf,lsl#16  (=1e6)
    EW(S, 0x9B0C7D6B);                       # mul x11,x11,x12       (tv_nsec = rem_ms*1e6)
    EW(S, 0xD10043ED);                       # sub x13,sp,#16
    EW(S, 0xA9002DAA);                       # stp x10,x11,[x13]     (timespec{sec,nsec})
    EW(S, 0xAA0D03E2);                       # mov x2,x13            (x2 = timespec*)
    EW(S, 0x14000002);                       # b poll_sig
    EW(S, 0xD2800002);                       # poll_null: movz x2,#0 (NULL tmo_p)
    EW(S, 0xD2800003);                       # poll_sig:  movz x3,#0 (sigmask=NULL)
    EW(S, 0xD2800004);                       # movz x4,#0            (sigsetsize=0)
    EW(S, 0xD2800928);                       # movz x8,#73           (ppoll)
    # v6.0.41: getcwd 79→17. _abs_path issues x86 getcwd(79); on aarch64-
    # Linux 79 is fstatat, so without this it silently returned a relative
    # path (degraded dep resolution). cmp x8,#79 = 0xF1013D1F; movz x8,#17
    # = 0xD2800228.
    EW(S, 0xF1013D1F); EW(S, 0x54000041); EW(S, 0xD2800228);  # getcwd 79→17
    # v6.0.68: stat 4 → fstatat 79 + AT_FDCWD arg-shift. aarch64-Linux has NO
    # stat(2) (79 IS fstatat — see getcwd note above); x86 syscall(4) [used by
    # _file_size in cbt/deps.cyr] ran as aarch64 io_getevents(4) → garbage →
    # _file_size returned -1 → the `cyrius deps` include-scan short-circuited
    # (`if (sz<=0) return 0`) → transitive stdlib deps SILENTLY dropped on
    # aarch64-Linux (the dispatcher modules' peers — syscalls_aarch64_linux.cyr,
    # alloc_*, atomic — never copied). §D1, found by the gate not a consumer.
    # MUST come AFTER getcwd (79→17) so the x8=79 we set isn't re-caught by
    # cmp x8,#79. stat(path,buf)→fstatat(AT_FDCWD,path,buf,0): shift x1→x2, x0→x1,
    # x0=AT_FDCWD(-100), x3=0, x8=79. struct stat st_size@48 (same as x86_64).
    # cmp x8,#4; b.ne +24 (skip 5); movz x3,#0; mov x2,x1; mov x1,x0; movn x0,#99; movz x8,#79
    EW(S, 0xF100111F); EW(S, 0x540000C1);
    EW(S, 0xD2800003); EW(S, 0xAA0103E2); EW(S, 0xAA0003E1); EW(S, 0x92800C60);
    EW(S, 0xD28009E8);
    # v6.0.68: rename 82 → renameat 38 + AT_FDCWD arg-shift. Same class as stat:
    # aarch64-Linux has no rename(2) (82 is fsync there). cbt/build.cyr:185 issues
    # x86 syscall(82, tmp_out, output) to finalize a build; untranslated it ran as
    # fsync → the .tmp.<pid> output was NEVER renamed to the final name, so every
    # `cyrius build` on aarch64-Linux silently produced no binary (the funcgate's
    # build step). rename(old,new) x0/x1 → renameat(AT_FDCWD,old,AT_FDCWD,new)
    # x0/x1/x2/x3. cmp x8,#82; b.ne +24 (skip 5); mov x3,x1; mov x1,x0; movn x0,#99; movn x2,#99; movz x8,#38
    EW(S, 0xF101491F); EW(S, 0x540000C1);
    EW(S, 0xAA0103E3); EW(S, 0xAA0003E1); EW(S, 0x92800C60); EW(S, 0x92800C62);
    EW(S, 0xD28004C8);
    # v6.0.68: symlink 88 → symlinkat 36 + AT_FDCWD arg-shift. aarch64-Linux has no
    # symlink(2). cbt/pulsar.cyr:270-271 issues x86 syscall(88, target, linkpath)
    # to create the install bin/lib symlinks; untranslated `cyrius pulsar` left a
    # native aarch64 install without its symlinks. symlink(target,linkpath) x0/x1 →
    # symlinkat(target,AT_FDCWD,linkpath) x0/x1/x2.
    # cmp x8,#88; b.ne +16 (skip 3); mov x2,x1; movn x1,#99; movz x8,#36
    EW(S, 0xF101611F); EW(S, 0x54000081);
    EW(S, 0xAA0103E2); EW(S, 0x92800C61);
    EW(S, 0xD2800488);
    # v6.1.3: the at-family stat/utimensat collision fix. The aarch64 stdlib
    # emits the X86 newfstatat(262)/utimensat(280) numbers (not the aarch64-
    # native 79/88, which collide with the getcwd(79→17)/symlink(88→36)
    # entries above — cbt issues raw x86 getcwd/symlink). x86 and aarch64
    # newfstatat/utimensat share arg layouts, so these are PURE renumbers (no
    # arg-shift). MUST be LAST: they produce x8=79/88, and placing them after
    # the getcwd/symlink cmp entries prevents re-capture. This restores
    # sys_stat/lstat/fstatat/utimensat on native aarch64 (silently broken
    # since v6.0.41). See CHANGELOG [6.1.3].
    # newfstatat 262→79: cmp x8,#262; b.ne +8; movz x8,#79
    EW(S, 0xF104191F); EW(S, 0x54000041); EW(S, 0xD28009E8);
    # utimensat 280→88: cmp x8,#280; b.ne +8; movz x8,#88
    EW(S, 0xF104611F); EW(S, 0x54000041); EW(S, 0xD2800B08);
    # v6.2.x: faccessat 269→48. lib/syscalls_aarch64_linux.cyr emits the x86
    # number (269) — the aarch64-native 48 collides with shutdown(48→210) above
    # (lib/net.cyr issues raw x86 shutdown(48), v6.2.10), so a stdlib syscall(48)
    # meant as faccessat was remapped to setsockopt(210) → -EBADF, breaking EVERY
    # sys_access() on native aarch64. Pure renumber (shared dirfd,path,mode args).
    # MUST come AFTER the shutdown(48→210) cmp so the x8=48 produced here is not
    # re-captured — same ordering rule as newfstatat/utimensat above.
    # cmp x8,#269; b.ne +8; movz x8,#48
    EW(S, 0xF104351F); EW(S, 0x54000041); EW(S, 0xD2800608);
    # v6.2.14: fsync/fdatasync. lib/syscalls_aarch64_linux.cyr emits the x86 numbers
    # (74/75) — the aarch64-native 82/83 collide (82 is x86 rename, remapped 82→128
    # above). Pure renumbers (both take just fd). MUST be LAST: fsync produces x8=82,
    # and placing it after the rename(82→128) cmp prevents that re-capture (same
    # ordering rule as the at-family above). See proposal 2026-05-20.
    EW(S, 0xF101291F); EW(S, 0x54000041); EW(S, 0xD2800A48);  # fsync     74→82
    EW(S, 0xF1012D1F); EW(S, 0x54000041); EW(S, 0xD2800A68);  # fdatasync 75→83
    # v6.4.42: epoll_wait 232 → epoll_pwait 22 (arg-extend, NULL sigmask). aarch64-Linux
    # has NO bare epoll_wait; #22 is epoll_pwait, which COLLIDES with the pipe(22→pipe2)
    # remap above — issuing raw 22 ran pipe2(epfd,0) → -EFAULT, so the async epoll reactor
    # NEVER worked on aarch64 (async gates run only on x86; found on real pi hardware).
    # lib/syscalls_aarch64_linux.cyr:sys_epoll_wait now issues the x86 number 232, which
    # this entry arg-extends: epoll_wait(epfd,events,maxevents,timeout) x0-x3 →
    # epoll_pwait(...,sigmask=0,sigsetsize=0) x0-x5, x8=22. MUST come AFTER the
    # pipe(22→pipe2) cmp so the x8=22 produced here is not re-caught (same ordering rule
    # as the at-family/flock entries). aarch64-linux-gnu-as verified.
    # cmp x8,#232; b.ne +16 (skip 3); movz x4,#0; movz x5,#0; movz x8,#22.
    EW(S, 0xF103A11F); EW(S, 0x54000081);
    EW(S, 0xD2800004); EW(S, 0xD2800005); EW(S, 0xD28002C8);
    # v6.5.38: ioctl 16 → 29 (x86-compat), closing the darshana filing's first ask.
    # A consumer that hardcodes `var SYS_IOCTL = 16` — the x86_64 number, and a very common
    # thing to write — got NO remap on ELF-aarch64 and issued raw 16, which on the
    # asm-generic table is **fremovexattr**. Silently, with no diagnostic.
    # ⚠ NOT a live stdlib bug: `lib/syscalls_aarch64_linux.cyr` correctly declares the
    # NATIVE 29, nothing compares against 29 in this arm, and the v6.5.37 shadow gate reports
    # it unshadowed — so `sys_ioctl` has always worked through the stdlib. This row is for
    # source that bypasses the stdlib peer, which is exactly the reported case and the same
    # reason the getcwd/symlink compat rows above exist ("cbt issues raw x86 getcwd/symlink").
    # ⚠ SAFE TO ADD, checked in both directions: nothing in this arm does `cmp x8,#16`, no
    # aarch64 declaration uses 16 as a syscall number, and nothing in the tree calls
    # fremovexattr — so this claims a number that was genuinely unused. A consumer that really
    # wants aarch64 fremovexattr now needs the ≥1000 private alias band, which is the
    # established escape hatch for exactly this trade.
    # ⚠ ORDERING: produces x8=29, and NO row in this arm compares against 29, so it cannot be
    # re-captured wherever it sits — but it stays ABOVE the private-alias band, which must
    # remain last for the reasons the band's own comments give.
    # cmp x8,#16 = 0xF100411F; movz x8,#29 = 0xD28003A8 (aarch64-linux-gnu-as verified).
    EW(S, 0xF100411F); EW(S, 0x54000041); EW(S, 0xD28003A8);  # ioctl 16→29

    # v6.5.7: fchownat via the PRIVATE ALIAS 1054 → native 54. aarch64's real
    # fchownat number (54) is unreachable from source because the x86-compat shim
    # above rewrites 54→208 (setsockopt) — load-bearing for 51 ecosystem repos — and
    # the usual escape hatch (borrow the x86 number, 260) is this peer's own native
    # SYS_WAIT4. Hence a number no OS mints; see lib/syscalls_aarch64_linux.cyr's
    # SYS_FCHOWNAT comment. ⚠ THIS ENTRY MUST STAY LAST IN THE CHAIN: it produces
    # x8=54, and the setsockopt entry compares against 54 — placed above it, every
    # fchownat would be re-caught and issued as setsockopt. Same ordering rule as
    # flock-before-poll and epoll_wait-after-pipe.
    # cmp x8,#1054 = 0xF110791F; movz x8,#54 = 0xD28006C8 (aarch64-linux-gnu-as verified).
    EW(S, 0xF110791F); EW(S, 0x54000041); EW(S, 0xD28006C8);  # fchownat 1054→54
    # v6.5.7: chdir via the private alias 1049 → native 49. Second occupant of the band,
    # and the same trap twice: native 49 is eaten by the x86-compat bind(49→200) entry, and
    # the x86 number 80 is this peer's own SYS_FSTAT. ⚠ SAME ORDERING RULE — this produces
    # x8=49 and the bind entry compares against 49, so it must stay below it.
    # cmp x8,#1049 = 0xF110651F; movz x8,#49 = 0xD2800628 (aarch64-linux-gnu-as verified).
    EW(S, 0xF110651F); EW(S, 0x54000041); EW(S, 0xD2800628);  # chdir 1049→49
    # v6.5.36: ppoll + signalfd4 via the PRIVATE ALIASES 1073/1074 → native 73/74.
    # ⛔ THE BUG THESE FIX WAS A TWO-WAY COLLISION THE BAND EXISTS FOR. `lib/syscalls_aarch64_linux.cyr`
    # declared the NATIVE numbers (73 ppoll, 74 signalfd4) and expected them to pass through
    # untouched. They did not: the x86-compat rows above rewrite 73 (x86 flock) → 32 and
    # 74 (x86 fsync) → 82, and a compat row cannot tell a native number from the x86 number it
    # is matching. So `sys_pause()` issued **flock(2)** and `sys_signalfd()` issued **fsync(2)** —
    # silently, on every ELF-aarch64 build, with every gate green. Filed by kybernet (PID 1 for
    # AGNOS), whose entire aarch64 target was non-functional.
    # ⚠ SAME ORDERING RULE AS THE WHOLE BAND, and it bites harder here than anywhere else: these
    # produce x8=73 and x8=74, which are EXACTLY the values the flock and fsync compat rows above
    # compare against. Placed anywhere before them, every ppoll would be reissued as flock and
    # every signalfd4 as fsync — i.e. the identical bug, reintroduced by a reordering.
    # cmp x8,#1073 = 0xF110C51F; movz x8,#73 = 0xD2800928 (aarch64-linux-gnu-as verified).
    EW(S, 0xF110C51F); EW(S, 0x54000041); EW(S, 0xD2800928);  # ppoll     1073→73
    # cmp x8,#1074 = 0xF110C91F; movz x8,#74 = 0xD2800948 (aarch64-linux-gnu-as verified).
    EW(S, 0xF110C91F); EW(S, 0x54000041); EW(S, 0xD2800948);  # signalfd4 1074→74
    # v6.5.37: umount2 + epoll_pwait via the PRIVATE ALIASES 1039/1022 → native 39/22.
    # ⛔ OCCURRENCES THREE AND FOUR OF EXACTLY THE v6.5.36 CLASS, found by sweeping the whole
    # table rather than by another filing. `lib/syscalls_aarch64_linux.cyr` declared the
    # NATIVE numbers and expected them to pass through; the x86-compat rows above rewrite
    # 39 (x86 getpid) → 172 and 22 (x86 pipe) → 59, and a compat row cannot tell a native
    # number from the x86 number it matches.
    # MEASURED under qemu-aarch64 before the fix: `sys_umount2("/nonexistent", 0)` returned
    # **1179922** — a PID. The call was getpid(2). epoll_pwait was LATENT rather than live
    # only because nothing calls it: the working epoll path issues x86 232, which the
    # arg-shift row above extends to epoll_pwait with a NULL sigmask. A future caller of the
    # declared constant would have got pipe2.
    # ⚠ SAME ORDERING RULE AS THE WHOLE BAND: these produce x8=39 and x8=22, the exact values
    # the getpid and pipe compat rows compare against, so they must stay BELOW them — which
    # here means last in the chain.
    # ⭐ The sweep that found these also flagged fsync 74, fdatasync 75, newfstatat 262,
    # faccessat 269 and utimensat 280 as "shadowed". They are NOT: each declares the X86
    # number and is renumbered to the aarch64 one by design. The discriminator is whether the
    # declared value is the x86 number for that syscall (intended) or the aarch64 native one
    # (shadowed) — a raw collision list without that test reports five false positives.
    # cmp x8,#1039 = 0xF1103D1F; movz x8,#39 = 0xD28004E8.
    EW(S, 0xF1103D1F); EW(S, 0x54000041); EW(S, 0xD28004E8);  # umount2     1039→39
    # cmp x8,#1022 = 0xF10FF91F; movz x8,#22 = 0xD28002C8.
    EW(S, 0xF10FF91F); EW(S, 0x54000041); EW(S, 0xD28002C8);  # epoll_pwait 1022→22
    return 0;
}

# v6.0.65: SINGLE SOURCE OF TRUTH for "is syscall n safely handled on Mach-O
# ARM?" — used by parse_expr.cyr's macho whitelist warning instead of a drifting
# parallel list. MUST mirror the cmp x8,#N entries in ESYSXLAT's _TARGET_MACHO==2
# branch above (+ 228 clock_gettime, handled on macho via the __got[6] reroute,
# not ESYSXLAT). When you add/remove an ESYSXLAT macho entry, update this too —
# they sit adjacent for exactly that reason. 35 here is aarch64 unlinkat (→unlink),
# NOT x86 nanosleep; portable sleeping goes through lib/chrono.cyr sleep_ms (poll).
fn _macho_arm_routes(n): i64 {
    if (n == 0) { return 1; }    if (n == 1) { return 1; }    # read / write
    if (n == 2) { return 1; }    if (n == 3) { return 1; }    # open / close
    if (n == 4) { return 1; }    if (n == 7) { return 1; }    # stat / poll (sleep_ms)
    if (n == 9) { return 1; }    if (n == 10) { return 1; }   # mmap / mprotect
    if (n == 11) { return 1; }   if (n == 24) { return 1; }   # munmap / dup3→dup2
    if (n == 34) { return 1; }   if (n == 35) { return 1; }   # mkdirat / unlinkat
    if (n == 39) { return 1; }   if (n == 41) { return 1; }   # getpid (x86 hardcode) / socket
    if (n == 172) { return 1; }  if (n == 173) { return 1; }  # getpid / getppid (aarch64 stdlib nums, v6.3.44 ESYSXLAT 172→20 / 173→39)
    if (n == 134) { return 1; }                                # rt_sigaction (v6.4.51 signal_ignore, ESYSXLAT 134→46)
    if (n == 74) { return 1; }                                 # fsync (v6.4.57 xfsync, ESYSXLAT 74→95)
    if (n == 42) { return 1; }   if (n == 43) { return 1; }   # connect / accept
    if (n == 48) { return 1; }   if (n == 49) { return 1; }   # shutdown / bind
    if (n == 50) { return 1; }   if (n == 53) { return 1; }   # listen / fchmodat (53=fchmodat on the a64 enum; socketpair is 199, below)
    if (n == 54) { return 1; }   if (n == 55) { return 1; }   # setsockopt / getsockopt
    if (n == 56) { return 1; }   if (n == 57) { return 1; }   # openat / close(a64)
    if (n == 60) { return 1; }   if (n == 61) { return 1; }   # exit / getdents64(a64)
    if (n == 62) { return 1; }   if (n == 63) { return 1; }   # lseek / read(a64)
    if (n == 64) { return 1; }   if (n == 72) { return 1; }   # write(a64) / fcntl
    if (n == 82) { return 1; }   if (n == 88) { return 1; }   # rename / symlink
    if (n == 93) { return 1; }   if (n == 94) { return 1; }   # exit(a64) / exit_group
    if (n == 199) { return 1; }                                # socketpair(a64)→135 (v6.0.84)
    if (n == 215) { return 1; }  if (n == 217) { return 1; }  # munmap(a64) / getdents64(x86)
    if (n == 220) { return 1; }  if (n == 221) { return 1; }  # clone→fork / execve(a64)
    if (n == 222) { return 1; }  if (n == 226) { return 1; }  # mmap(a64) / mprotect(a64)
    if (n == 228) { return 1; }  if (n == 260) { return 1; }  # clock_gettime(__got) / wait4
    if (n == 278) { return 1; }  if (n == 318) { return 1; }  # getrandom(a64/x86)→getentropy 500 (v6.0.75)
    if (n == 1054) { return 1; }                               # fchownat private alias →468 (v6.5.7)
    if (n == 1049) { return 1; }                               # chdir private alias →12 (v6.5.7)
    if (n == 36) { return 1; }   if (n == 78) { return 1; }   # symlinkat →474 / readlinkat →473 (v6.5.7)
    if (n == 37) { return 1; }   if (n == 38) { return 1; }   # linkat→471 / renameat→465 (v6.1.20)
    if (n == 262) { return 1; }                                # newfstatat→fstatat64 470 (v6.1.20)
    if (n == 59) { return 1; }   if (n == 52) { return 1; }   # pipe2→pipe 42 (+x0/x1 fixup) / fchmod→124 (v6.5.15)
    if (n == 269) { return 1; }                                # faccessat→466 (v6.5.15)
    if (n == 1202) { return 1; }                               # sysctl private alias →202 (v6.5.16)
    if (n == 1116) { return 1; }                               # gettimeofday private alias →116 (v6.5.16)
    if (n == 1362) { return 1; }                               # kqueue private alias →362 (v6.5.27)
    if (n == 1363) { return 1; }                               # kevent private alias →363 (v6.5.27)
    # v6.5.16: the aarch64-Linux socket numbers were LIVE in ESYSXLAT (v6.2.24/v6.4.64)
    # but never registered here, so every build touching them printed a bogus "syscall not
    # routed" warning while the route worked fine. A warning that cries wolf on working
    # code is how a real one gets ignored. The macho_route_parity gate now asserts this
    # table and the ESYSXLAT sources are the same set, so they cannot drift again.
    if (n == 198) { return 1; }  if (n == 200) { return 1; }  # socket / bind
    if (n == 201) { return 1; }  if (n == 203) { return 1; }  # listen / connect
    if (n == 204) { return 1; }  if (n == 205) { return 1; }  # getsockname / getpeername
    if (n == 208) { return 1; }                                # setsockopt
    # v6.5.16: credential family →24/25/47/43 (the is_root() blind spot)
    if (n == 174) { return 1; }  if (n == 175) { return 1; }  # getuid / geteuid
    if (n == 176) { return 1; }  if (n == 177) { return 1; }  # getgid / getegid
    # v6.5.16: the rest of the unrouted-but-Darwin-reachable sweep
    if (n == 80) { return 1; }   if (n == 25) { return 1; }   # fstat→fstat64 339 / fcntl→92
    if (n == 75) { return 1; }   if (n == 23) { return 1; }   # fdatasync→187 / dup→41
    if (n == 29) { return 1; }   if (n == 129) { return 1; }  # ioctl→54 / kill→37
    if (n == 81) { return 1; }   if (n == 178) { return 1; }  # sync→36 / gettid→thread_selfid 372
    if (n == 207) { return 1; }  if (n == 212) { return 1; }  # recvfrom→29 / recvmsg→27
    if (n == 146) { return 1; }  if (n == 144) { return 1; }  # setuid→23 / setgid→181
    if (n == 157) { return 1; }  if (n == 159) { return 1; }  # setsid→147 / setgroups→80
    if (n == 73) { return 1; }                                 # flock→131 (io.cyr macOS arm)
    return 0;
}

# Pop syscall args (LIFO — last pushed = first popped)
# Push order: syscall_num, arg1, arg2, ..., argN
# Pop order: argN first, syscall_num last
fn ESCPOPS(S, n): i64 {
    # LIFO: last pushed (argN) pops first, first pushed (syscall_num) pops last
    # For syscall(num, a1, a2, a3, a4, a5, a6):
    #   Push order: num, a1, a2, a3, a4, a5, a6
    #   Stack: [a6_top, a5, a4, a3, a2, a1, num_bottom]
    #   Pop: a6 first → x5, ... , num last → x9
    # Pop all into x0, move to target reg one by one.
    # LIFO: top=last_arg, bottom=syscall_num
    if (n >= 7) { EPOPR(S); EW(S, 0xAA0003E5); }  # pop → x0, mov x5, x0
    if (n >= 6) { EPOPR(S); EW(S, 0xAA0003E4); }  # pop → x0, mov x4, x0
    if (n >= 5) { EPOPR(S); EW(S, 0xAA0003E3); }  # pop → x0, mov x3, x0
    if (n >= 4) { EPOPR(S); EW(S, 0xAA0003E2); }  # pop → x0, mov x2, x0
    if (n >= 3) { EPOPR(S); EW(S, 0xAA0003E1); }  # pop → x0, mov x1, x0
    # Pop syscall num into x8 BEFORE arg1 into x0
    if (n >= 1) {
        if (n >= 2) {
            # 2+ args: pop arg1 → x9, pop syscall → x8, then mov x0, x9
            EPOPR(S); EW(S, 0xAA0003E9);  # pop arg1 → x0, mov x9, x0
            EPOPR(S); EW(S, 0xAA0003E8);  # pop syscall → x0, mov x8, x0
            EW(S, 0xAA0903E0);             # mov x0, x9 (restore arg1)
        } else {
            # 1 arg (just syscall num, no real args)
            EPOPR(S); EW(S, 0xAA0003E8);  # pop → x0, mov x8, x0
        }
    }
    ESYSXLAT(S);
    ESYSCALL(S);
    return 0;
}

# Exit: on Linux, movz x8,#93; svc #0.  On macOS/BSD, movz x16,#1; svc #0x80.
fn EEXIT(S): i64 {
    # x0 already has the exit value
    if (_TARGET_MACHO == 2) {
        EW(S, 0xD2800030);    # movz x16, #1 (BSD _exit)
        EW(S, 0xD4001001);    # svc #0x80
        return 0;
    }
    EW(S, 0xD2800BA8);  # movz x8, #93 (aarch64 Linux exit)
    ESYSCALL(S);
    return 0;
}

# v5.5.13 Mach-O arm64 first __got reroute — syscall(60, code) → libSystem._exit.
# Stack on entry (argc==2): [exit_code][sc_num=60] top-down.
# Sequence:
#   ldr x0, [sp], #16       pop exit code → x0
#   add sp, sp, #16         discard sc_num
#   adrp x16, __got@PAGE    (page-diff patched by FIXUP ftype=5)
#   ldr  x16, [x16, #0]     load __got[0] = &_exit (dyld-bound)
#   br   x16                tail-call _exit; no return
#
# FIXUP reuses FIXUP_ADRP_ADD mechanics for the adrp patch because __got[0]
# is page-aligned in __DATA_CONST (addr & 0xFFF == 0, so the ADD-style
# imm12 write is a no-op on the LDR's imm12 field). For multi-slot
# imports (v5.5.14+) the fixup will need to encode slot*8 properly scaled
# for LDR (imm12 = offset/8), at which point this path gets a dedicated
# FIXUP_ADRP_LDR in aarch64/fixup.cyr.
fn EMACHO_EXIT_ARM(S): i64 {
    # EPOPR is the verified post-indexed pop into x0 (encoding 0xF84107E0).
    # The EPOPRDI/SI/DX/R10/R8/R9 family was corrected to true post-index
    # (0xF84107E0|N) in v6.2.34 — the prior 0xF8410FE0 was PRE-indexed and
    # contradicted its comments (latent only; the family is unreferenced in
    # the aarch64 build).
    EPOPR(S);                      # ldr x0, [sp], #16 — exit code (arg1, top of stack)
    EW(S, 0x910043FF);             # add sp, sp, #16 — discard sc_num
    # Record ftype=5 __got-ref fixup at the adrp that follows.
    var fc = GFCNT(S);
    var faddr = _fixup_base + fc * 16;
    S64(faddr, GCP(S));
    S64(faddr + 8, (5 << 56) | 0);  # ftype=5, __got slot idx=0 (_exit)
    SFCNT(S, fc + 1);
    EW(S, 0x90000010);             # adrp x16, #0 (placeholder — patched)
    EW(S, 0xF9400210);             # ldr  x16, [x16, #0] — load __got[0]
    EW(S, 0xD61F0200);             # br   x16 — tail to _exit
    return 0;
}

# Shared helper: record a ftype=5 __got-ref fixup at GCP + emit the
# adrp/ldr/blr trio that calls through __got[slot]. Returns 0.
# Non-zero slots are patched by FIXUP_ADRP_LDR (imm12 scaled /8);
# slot 0 reuses FIXUP_ADRP_ADD.
fn _EMACHO_BLR_GOT(S, slot): i64 {
    var fc = GFCNT(S);
    var faddr = _fixup_base + fc * 16;
    S64(faddr, GCP(S));
    S64(faddr + 8, (5 << 56) | slot);
    SFCNT(S, fc + 1);
    EW(S, 0x90000010);             # adrp x16, #0 (placeholder — patched)
    EW(S, 0xF9400210);             # ldr  x16, [x16, #0] — imm12 patched for slot>0
    EW(S, 0xD63F0200);             # blr  x16 — result in x0
    return 0;
}

# v5.5.14 Mach-O arm64 syscall(1, fd, buf, len) → libSystem._write(fd, buf, len).
# Stack top-down (argc==4): [len][buf][fd][sc_num=1]. AAPCS64 wants x0=fd,
# x1=buf, x2=len, so pop top→x2, next→x1, next→x0, then discard sc_num.
# Return value lands in x0 per both AAPCS64 and the syscall convention.
fn EMACHO_WRITE_ARM(S): i64 {
    EPOPARG(S, 2);                 # ldr x2, [sp], #16 — len
    EPOPARG(S, 1);                 # ldr x1, [sp], #16 — buf
    EPOPARG(S, 0);                 # ldr x0, [sp], #16 — fd
    EW(S, 0x910043FF);             # add sp, sp, #16 — discard sc_num
    _EMACHO_BLR_GOT(S, 1);         # __got[1] = _write
    return 0;
}

# v5.5.14 Mach-O arm64 syscall(0, fd, buf, len) → libSystem._read(fd, buf, len).
# Same stack layout as EMACHO_WRITE_ARM; dispatches through __got[2] = _read.
fn EMACHO_READ_ARM(S): i64 {
    EPOPARG(S, 2);                 # ldr x2, [sp], #16 — len
    EPOPARG(S, 1);                 # ldr x1, [sp], #16 — buf
    EPOPARG(S, 0);                 # ldr x0, [sp], #16 — fd
    EW(S, 0x910043FF);             # add sp, sp, #16 — discard sc_num
    _EMACHO_BLR_GOT(S, 2);         # __got[2] = _read
    return 0;
}

# v5.6.6 Mach-O arm64 syscall(228, clock_id, _) →
# libSystem._clock_gettime_nsec_np(clock_id). Only x0 matters; the
# 2nd cyrius-side arg is a Linux-shape placeholder (it was
# `&timespec` on Linux; macOS returns ns directly in x0 so no
# buffer is needed). Returns u64 ns in x0.
# Stack top-down (argc==3): [arg2][arg1=clock_id][sc_num=228].
# v6.5.16 aarch64 stub for EMACHO_CLOCK_X86. Statically dead here (the
# `_TARGET_MACHO == 1` branch in parse_expr.cyr is x86-macho only), but the
# shared parse_expr.cyr is compiled for BOTH backends, so the symbol must
# resolve or the aarch64 build fails to link. Same story as x86's
# EMACHO_CLOCK_ARM / EMACHO_EXIT_ARM stubs in the other direction.
fn EMACHO_CLOCK_X86(S): i64 {
    return 0;
}

# v6.5.16 aarch64 stub for EMACHO_NANOSLEEP_X86 — same link-only reason as above.
fn EMACHO_NANOSLEEP_X86(S): i64 {
    return 0;
}

fn EMACHO_CLOCK_ARM(S): i64 {
    EW(S, 0x910043FF);             # add sp, sp, #16 — drop arg2 (placeholder)
    EPOPARG(S, 0);                 # ldr x0, [sp], #16 — clock_id
    EW(S, 0x910043FF);             # add sp, sp, #16 — discard sc_num
    _EMACHO_BLR_GOT(S, 6);         # __got[6] = _clock_gettime_nsec_np
    return 0;
}

# ================================================================
# FUNCTION CALLING CONVENTION (aarch64 AAPCS64)
# x29=frame pointer, x30=link register, x0-x7=args
# ================================================================

# Function prologue: stp x29,x30,[sp,#-16]!; mov x29,sp
fn EFNPRO(S): i64 {
    EW(S, 0xA9BF7BFD);  # stp x29, x30, [sp, #-16]!
    EW(S, 0x910003FD);  # mov x29, sp
    return 0;
}

# Emit sub sp, sp, #imm — returns patch offset
fn ESUBRSP(S): i64 {
    var patch = GCP(S);
    # Reserve TWO slots so EPATCHFRAME can encode frames >= 4096 as
    # `sub #lo ; sub #hi, LSL #12` (ADD/SUB-imm caps imm at 4095). Small
    # frames NOP slot2. +4 bytes/prologue vs the old single-slot reserve —
    # the cost of closing the frame-size imm12-mask bug. See CHANGELOG [6.2.21].
    EW(S, 0xD10003FF);  # sub sp, sp, #0 (placeholder slot1 — lo / full)
    EW(S, 0xD10003FF);  # sub sp, sp, #0 (placeholder slot2 — hi, LSL #12 / NOP)
    return patch;
}

# v5.8.56: ELVRLOAD / ELVRSTORE / ELVRINIT stubs removed in lockstep
# with x86's removal — the x86 versions were a v4.8.4-alpha6 loop-var
# r12 caching optimization never wired up to the parser, and the
# aarch64 stubs only existed to satisfy cycc's symbol resolution when
# the x86 versions were called. With both gone, the symmetry holds.

# Function epilogue: mov sp,x29; ldp x29,x30,[sp],#16; ret
fn EFNEPI(S): i64 {
    EW(S, 0x910003BF);  # mov sp, x29
    EW(S, 0xA8C17BFD);  # ldp x29, x30, [sp], #16
    EW(S, 0xD65F03C0);  # ret
    return 0;
}

# v5.11.35 path-A named ops — Class D refactor. aarch64 stubs
# preserve the IR record (matches current behavior — IR record
# fires when regalloc >= 1 regardless of arch) but skip emits
# because regalloc-save/restore is x86-callee-save-list specific.
# aarch64 never auto-enables `_cur_fn_regalloc >= 1` today, so
# these stubs are dead paths in practice. See x86/emit.cyr for
# the active implementations + docs/audit/2026-04-27-cx-direct-emit-inventory.md.
fn EREGALLOC_SAVE(S, n): i64 {
    if (n >= 1) { _IR_REC0(S, IR_RAW_EMIT); }
    return 0;
}

fn EREGALLOC_RESTORE(S, n): i64 {
    if (n >= 1) { _IR_REC0(S, IR_RAW_EMIT); }
    return 0;
}

# EDROPI64 — PE-only path; aarch64 doesn't enter the calling
# code (parse_expr.cyr PE syscall stubs are gated by _TARGET_PE).
# Stub provided for completeness; never reached at compile time.
fn EDROPI64(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

# v5.11.36 path-A named ops — Class B refactor (PIC-vs-direct
# address loads). aarch64 has two emit shapes depending on
# `_TARGET_MACHO`: ELF uses MOVZ+MOVK chain (12 bytes, FIXUP_MOV
# patched at link time); Mach-O uses ADRP+ADD (8 bytes,
# FIXUP_ADRP_ADD — PC-relative, required for PIE/ASLR per
# v5.9.39 Bug B fix). Records fixup-type-3 entry at `fnaddr`.

# ELOAD_FN_ADDR — load fn-address into x0. See x86/emit.cyr
# for full semantics; aarch64 differs only in emit shape.
fn ELOAD_FN_ADDR(S, fnaddr, fc, fni): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    S64(fnaddr, GCP(S));
    S64(fnaddr + 8, (3 << 56) | fni);
    SFCNT(S, fc + 1);
    if (_TARGET_MACHO == 2 || _pie_mode == 1) {
        EADRP(S, 0); EADD_IMM12(S, 0);
    } else {
        EW(S, 0xD2800000);  # movz x0, #0
        EW(S, 0xF2A00000);  # movk x0, #0, lsl 16
        EW(S, 0xF2C00000);  # movk x0, #0, lsl 32
    }
    return 0;
}

# ELOAD_LOCAL_ADDR — load address of local at fp-relative
# `adisp` (negative) into x0. aarch64: SUB X0, X29, #imm12 when
# |adisp| <= 4095; otherwise MOVZ/MOVK chain into x0 + SUB x0,
# x29, x0. x86 emitted 7 raw bytes (3 + 4 disp32) here which was
# 3 mod 4 and corrupted aarch64 instruction alignment — the
# arch-specific encoding is mandatory not optional.
fn ELOAD_LOCAL_ADDR(S, adisp): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    var disp_abs = 0 - adisp;
    if (disp_abs <= 4095) {
        # SUB X0, X29, #imm12: 0xD10003A0 | (imm12 << 10)
        EW(S, 0xD10003A0 | ((disp_abs & 0xFFF) << 10));
    } else {
        # MOVZ X0, #lo16; (MOVK X0, #hi16, LSL 16); SUB X0, X29, X0
        EW(S, 0xD2800000 | ((disp_abs & 0xFFFF) << 5));
        if (((disp_abs >> 16) & 0xFFFF) != 0) {
            EW(S, 0xF2A00000 | (((disp_abs >> 16) & 0xFFFF) << 5));
        }
        EW(S, 0xCB0003A0);  # sub x0, x29, x0
    }
    return 0;
}

# v5.11.37 path-A named ops — Class C refactor (f64 unary ops).
# aarch64 has native FNEG for f64_neg; the transcendentals split
# into hard-errors (sin/cos/exp2/atan — no native, no polyfill yet)
# and polyfill-dispatch (exp/ln/log2 — dispatch to lib/math.cyr's
# `_f64_<op>_polyfill` fns via _FINDFN_CSTR + ECALLFIX).

# EF64_NEG — fmov d0, x0; fneg d0, d0; fmov x0, d0.
fn EF64_NEG(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E614000);   # fneg d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# f64_sin / f64_cos — polyfill-dispatch (v6.4.16, mirrors EF64_LN/EF64_EXP).
# Route to lib/math.cyr's `_f64_sin_polyfill` / `_f64_cos_polyfill` (attn11
# aarch64 trig unblock, issues/2026-07-07-aarch64-no-trig-polyfill.md).
fn EF64_SIN(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_sin_polyfill", 17);
    if (pf < 0) {
        ERR_MSG(S, "f64_sin on aarch64 requires include \"lib/math.cyr\" (provides _f64_sin_polyfill)", 79);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

fn EF64_COS(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_cos_polyfill", 17);
    if (pf < 0) {
        ERR_MSG(S, "f64_cos on aarch64 requires include \"lib/math.cyr\" (provides _f64_cos_polyfill)", 79);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

# f64_exp2 / f64_atan — polyfill-dispatch (v6.4.25, mirrors EF64_SIN/EF64_EXP).
# Route to lib/math.cyr's `_f64_exp2_polyfill` / `_f64_atan_polyfill` (closes the
# last two aarch64 transcendental gaps; issues/2026-07-07-aarch64-f64-exp2-atan-
# hard-error.md). x86 keeps its native x87 f2xm1/fpatan paths.
fn EF64_EXP2(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_exp2_polyfill", 18);
    if (pf < 0) {
        ERR_MSG(S, "f64_exp2 on aarch64 requires include \"lib/math.cyr\" (provides _f64_exp2_polyfill)", 81);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

fn EF64_ATAN(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_atan_polyfill", 18);
    if (pf < 0) {
        ERR_MSG(S, "f64_atan on aarch64 requires include \"lib/math.cyr\" (provides _f64_atan_polyfill)", 81);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

# Polyfill-dispatch ops — find the lib/math.cyr _f64_*_polyfill fn
# by name and emit a tail-call into it. Each pushes rax onto the
# stack, sets up the 1-arg fncall stack-state via ECALLPOPS, then
# ECALLFIX emits the call+fixup. Closes phylax #1 (v5.8.4 Shannon
# entropy) lineage. _FINDFN_CSTR was relocated to util.cyr at
# v5.11.37 so emit.cyr can resolve polyfill fn indices.

fn EF64_EXP(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_exp_polyfill", 17);
    if (pf < 0) {
        ERR_MSG(S, "f64_exp on aarch64 requires include \"lib/math.cyr\" (provides _f64_exp_polyfill)", 79);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

fn EF64_LN(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_ln_polyfill", 16);
    if (pf < 0) {
        ERR_MSG(S, "f64_ln on aarch64 requires include \"lib/math.cyr\" (provides _f64_ln_polyfill)", 77);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

fn EF64_LOG2(S): i64 {
    var pf = _FINDFN_CSTR(S, "_f64_log2_polyfill", 18);
    if (pf < 0) {
        ERR_MSG(S, "f64_log2 on aarch64 requires include \"lib/math.cyr\" (provides _f64_log2_polyfill)", 81);
    }
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, pf);
    return 0;
}

# EF64_ABS — native FABS via FP register shuttle. Replaces a
# 32-byte sequence (4× MOVK chain into x0 + push/EMOVCA-mov/pop/AND)
# with 12 bytes — save 20 bytes per call site on aarch64.
fn EF64_ABS(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E60C000);   # fabs d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# v5.11.39 path-A stubs — switch-table dispatch. aarch64 takes
# the chain path (parse.cyr sets `use_table = 0` for
# _AARCH64_BACKEND == 1); these ops are defined for include-time
# symmetry but never invoked at compile time.
fn ESWITCH_DISPATCH_PRE(S, case_min, range): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

fn ESWITCH_DISPATCH_TABLE(S, range): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

# EF64_CMP — aarch64 f64 compare. Stack on entry: a in x1 (pushed
# earlier as the second operand), b in x0 (current). Uses FCMP +
# CSET with the ordered condition codes (MI for lt so unordered/
# NaN yields 0).
fn EF64_CMP(S, tok): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EW(S, 0x9E670020);  # fmov d0, x1   — d0 = a
    EPOPR(S);            # pop b back to x0 (stack now empty)
    EW(S, 0x9E670001);  # fmov d1, x0   — d1 = b
    EW(S, 0x1E612000);  # fcmp d0, d1
    if (tok == 68) { EW(S, 0x9A9F17E0); }  # cset x0, eq
    if (tok == 69) { EW(S, 0x9A9F57E0); }  # cset x0, mi  (ordered <)
    if (tok == 70) { EW(S, 0x9A9FD7E0); }  # cset x0, gt  (ordered >)
    # v6.2.19: f64 comparison-operator sugar (ops 17-22). Ordered conditions —
    # matches the x86 setcc + the f64_lt/gt/eq builtin semantics.
    if (tok == 17) { EW(S, 0x9A9F17E0); }  # ==  cset eq
    if (tok == 18) { EW(S, 0x9A9F07E0); }  # !=  cset ne
    if (tok == 19) { EW(S, 0x9A9F57E0); }  # <   cset mi
    if (tok == 20) { EW(S, 0x9A9FD7E0); }  # >   cset gt
    # v6.2.41 IEEE-754 NaN-correctness (issue 2026-06-24-f64-le-nan-comparison).
    # `cset le` is true on unordered (LE = Z==1 || N!=V; fcmp NaN sets N=0,V=1 →
    # N!=V → fires), so `NaN <= x` wrongly returned 1. `cset ls` (C clear || Z set)
    # is false on unordered (fcmp NaN sets C=1,Z=0) while matching le on ordered
    # operands. The other five conditions (eq/ne/mi/gt/ge) are already unordered-
    # safe on aarch64, and the lt/gt/eq builtins use mi/gt/eq → f64_le/f64_ge in
    # lib/math.cyr were already NaN-correct here; only the operator `<=` was wrong.
    if (tok == 21) { EW(S, 0x9A9F87E0); }  # <=  cset ls  (was cset le — NaN bug)
    if (tok == 22) { EW(S, 0x9A9FB7E0); }  # >=  cset ge
    return 0;
}

# v6.4.56 (scalar-float D2) — f32 scalar compare. Mirror of EF64_CMP with S-regs:
# fmov s,w + fcmp s0,s1 (0x1E212000). fcmp on S-regs sets the same NZCV as the
# D-reg form, so the cset condition table (incl. the v6.2.41 `<=` = cset ls NaN
# fix) is reused unchanged. Entry (from _PLOGIC_ATOM): a in x1, b in x0.
fn EF32_CMP(S, tok): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EW(S, 0x1E270020);  # fmov s0, w1   — s0 = a
    EPOPR(S);            # pop b back to x0
    EW(S, 0x1E270001);  # fmov s1, w0   — s1 = b
    EW(S, 0x1E212000);  # fcmp s0, s1
    if (tok == 68) { EW(S, 0x9A9F17E0); }  # cset x0, eq
    if (tok == 69) { EW(S, 0x9A9F57E0); }  # cset x0, mi  (ordered <)
    if (tok == 70) { EW(S, 0x9A9FD7E0); }  # cset x0, gt  (ordered >)
    if (tok == 17) { EW(S, 0x9A9F17E0); }  # ==  cset eq
    if (tok == 18) { EW(S, 0x9A9F07E0); }  # !=  cset ne
    if (tok == 19) { EW(S, 0x9A9F57E0); }  # <   cset mi
    if (tok == 20) { EW(S, 0x9A9FD7E0); }  # >   cset gt
    if (tok == 21) { EW(S, 0x9A9F87E0); }  # <=  cset ls  (NaN-safe, matches EF64_CMP)
    if (tok == 22) { EW(S, 0x9A9FB7E0); }  # >=  cset ge
    return 0;
}

# Emit BL to known target
fn ECALLTO(S, target): i64 {
    var cp = GCP(S);
    var rel = (target - cp) / 4;
    EW(S, 0x94000000 | (rel & 0x3FFFFFF));
    return 0;
}

# Emit BL placeholder, record type-2 fixup
fn ECALLFIX(S, fnidx): i64 {
    var poff = GCP(S);
    EW(S, 0x94000000);  # bl +0 (placeholder)
    var fc = GFCNT(S);
    var faddr = _fixup_base + fc * 16;
    S64(faddr, poff);
    S64(faddr + 8, (2 << 56) | fnidx);
    SFCNT(S, fc + 1);
    return 0;
}

# v6.0.70 §0 — indirect call through a callee ptr spilled to local `idx`.
# The callptr builtin spills the callee to a fresh frame slot BEFORE the
# args so it survives ECALLPOPS. Mirror EFLLOAD_W's [x29,#disp] addressing
# but load into x6 (NOT x0 — x0 holds arg0 after ECALLPOPS; x6 is outside
# cyrius's 6 arg regs x0-x5 and isn't the x9 >6-arg shuffle scratch), then
# blr x6. aarch64 emits directly (no IR record layer; cf. ECALLFIX). disp
# matches EFLLOAD_W exactly (ret_stash only — aarch64 has no regalloc slots).
# ── v6.5.17 closure ABI — aarch64 peer of the x86 ECLTAG/ECLENV/ECLNORM trio.
# A capturing closure's value is its heap env object with bit 63 SET, so an
# indirect call site decides "closure or bare fn pointer" at RUNTIME instead of
# from the declaring var's static type (which was lost through params, returns,
# globals and memory — the SIGSEGV in
# hisab-capturing-closure-segv-across-fn-boundary.md). See backend/x86/emit.cyr
# for the full note. Encodings verified against llvm-mc / binutils aarch64-as.
fn ECLTAG(S): i64 { EW(S, 0xB2410000); return 0; }    # orr x0, x0, #0x8000000000000000
fn ECLENV(S): i64 { EW(S, 0x9240F800); return 0; }    # and x0, x0, #0x7fffffffffffffff
# ECLNORM: x0 = callee value -> x0 = real code address.
# TBZ skips the load outright when bit 63 is clear, so a bare fn pointer is never
# dereferenced. x9 is scratch here only (ECALLPOPS reuses it, but not across this
# sequence); `idx` is unused on aarch64 — the cx backend needs it.
fn ECLNORM(S, idx): i64 {
    EW(S, 0x9240F809);   # and x9, x0, #0x7fffffffffffffff
    EW(S, 0xB6F80040);   # tbz x0, #63, .+8   (untagged -> skip the load)
    EW(S, 0xF9400120);   # ldr x0, [x9]       (x0 = env[0] = fn pointer)
    return 0;
}

fn ECALLIND(S, idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF84003A6 | (off9 << 12));   # ldur x6, [x29, #disp]
    } else {
        _EFP_ADDR_X9(S, disp);              # x9 = x29 + disp
        EW(S, 0xF9400126);                  # ldr x6, [x9]
    }
    EW(S, 0xD63F00C0);                       # blr x6
    return 0;
}

# Pop into aarch64 arg register (x0-x7).
# v5.6.25: when n == 0 and the immediately preceding instruction is
# `push x0` (EPUSHR), the push+pop pair is a no-op — rewind past the
# push rather than emitting the pop. Mirrors EPOPR's v5.6.9 cancel.
# Applies to 1-arg call sites (and the trailing pop of any N-arg
# call, but only the N=1 case has the pop's CP == _last_push_cp
# since EPOPARG(N-1..1) push the emit cursor forward before this).
# Pre-v5.6.25 cycc_aarch64 carried 2,569 such pairs.
fn EPOPARG(S, n): i64 {
    if (n == 0) {
        if (GCP(S) == _last_push_cp) {
            SCP(S, GCP(S) - 4);
            _last_push_cp = 0 - 1;
            return 0;
        }
    }
    # ldr xN, [sp], #16
    EW(S, 0xF84107E0 | n);
    return 0;
}

# Pop args into registers for function call
# v6.0.57: ldr/str xN, [sp, #imm] (unsigned offset, 64-bit; imm a multiple of
# 8). For the >6-arg ECALLPOPS memory-shuffle — loads/stores WITHOUT moving sp,
# so it handles any arg count (the 12-bit scaled imm reaches ~32 KB).
fn ELDR_SP(S, reg, imm): i64 { EW(S, 0xF94003E0 | ((imm / 8) << 10) | reg); return 0; }
fn ESTR_SP(S, reg, imm): i64 { EW(S, 0xF90003E0 | ((imm / 8) << 10) | reg); return 0; }

fn ECALLPOPS(S, n): i64 {
    if (n <= 6) {
        var i = n - 1;
        while (i >= 0) { EPOPARG(S, i); i = i - 1; }
        return 0;
    }
    # >6 args: stack = [a1..aN], aN on top, slots 16 B; a_k at [sp+(n-k)*16].
    # v6.0.57: was capped at 4 extras (10 args) via x9-x12 pop/push — fns with
    # >10 args silently mishandled args 11+. Rewritten to the same memory-shuffle
    # the x86 backend uses (load reg args by offset, shift extras up by 6 slots,
    # add sp), which matches the old result for nextra<=4 and extends to any
    # count. Closes the aarch64 half of 2026-04-26-cc5-18-arg-fn-scrambles-params.
    var nextra = n - 6;
    # Step 1: load the 6 reg args a1..a6 into x0..x5 (no pop).
    var k = 1;
    while (k <= 6) {
        ELDR_SP(S, k - 1, (n - k) * 16);
        k = k + 1;
    }
    # Step 2: shift the extras up by 6 slots (96 B) to land below the dropped
    # reg slots. Descending so a write never clobbers a slot a later read needs
    # (the same read-after-write hazard fixed on x86).
    var si = nextra - 1;
    while (si >= 0) {
        ELDR_SP(S, 9, si * 16);            # x9 = extra at [sp+si*16]
        ESTR_SP(S, 9, 96 + si * 16);       # [sp+96+si*16] = x9
        si = si - 1;
    }
    # Step 3: drop the 6 reg-arg slots: add sp, sp, #96 (16-aligned throughout).
    EW(S, 0x910003FF | (96 << 10));
    return 0;
}

# Stack cleanup after call with >6 args
fn ECALLCLEAN(S, n): i64 {
    if (n > 6) {
        # add sp, sp, #(nextra * 16)
        var extra = (n - 6) * 16;
        EW(S, 0x910003FF | (extra << 10));  # add sp, sp, #imm12
    }
    return 0;
}

# Helper: not needed on aarch64 but must exist for parse.cyr
fn EDISP32(S, disp): i64 { return 0; }

# v5.9.26 Phase 2b-aarch64 — load &local into X8 (the dedicated
# indirect-result register on aarch64 SysV / AAPCS64 §6.9). Used at
# caller-side of a struct-returning call to set the hidden retptr
# arg directly, BEFORE the regular ECALLPOPS into X0..X5. Differs
# from x86's EFLADDR (which puts &local into RAX and then pushes to
# stack to be popped into RDI) because aarch64 reserves X8 outside
# the regular arg-reg sequence.
#   add x8, x29, #abs_disp     ; or sub if negative
fn EFLADDR_X8(S, lli): i64 {
    var disp = 0 - ((lli + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    var abs = 0 - disp;
    # SUB Xd, Xn, #imm12: 0xD1000000 base. Rd=8, Rn=29.
    # bits[28:24]=10001, bits[31]=1 (sf=64-bit), bits[30:29]=10 (op=SUB).
    # Encoding: 0xD1_00_00_00 | (sh=0) | (imm12<<10) | (Rn<<5) | Rd
    if (abs <= 4095) {
        EW(S, 0xD10003A8 | (abs << 10));   # sub x8, x29, #abs
        return 0;
    }
    # Fallback for large frames — movz x9 + sub x8, x29, x9.
    EW(S, 0xD2800009 | ((abs & 0xFFFF) << 5));   # movz x9, #abs
    EW(S, 0xCB0903A8);                            # sub x8, x29, x9
    return 0;
}

# Compute x9 = x29 + disp for local access when disp is outside the
# LDUR/STUR signed 9-bit immediate range (-256..+255). Called only with
# disp <= -256 (locals at idx >= 32). Assumes |disp| fits in 16 bits —
# Cyrius functions with >= 8192 locals are implausible.
fn _EFP_ADDR_X9(S, disp): i64 {
    var abs = 0 - disp;
    EW(S, 0xD2800009 | ((abs & 0xFFFF) << 5));  # movz x9, #abs
    EW(S, 0xCB0903A9);                            # sub x9, x29, x9
    return 0;
}

# Store parameter to frame: str xN, [x29, #-offset]
fn ESTOREREGPARM(S, pidx, disp): i64 {
    # STUR Xt, [Xn, #simm9]: 1111 1000 000 simm9 00 Xn Xt
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF80003A0 | (off9 << 12) | pidx);  # stur xPIDX, [x29, #disp]
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    EW(S, 0xF9000120 | pidx);  # str xPIDX, [x9]
    return 0;
}

fn ESTORESTACKPARM(S, pidx, disp, pc): i64 {
    # Load extra arg from caller's stack, store to local frame
    # Caller pushed extras at [sp+0], [sp+16], ... before the call
    # After prologue, they're at [x29+16], [x29+32], ...
    var nstack = pc - 6;
    var si = nstack - 1 - (pidx - 6);
    var soff = 16 + si * 16;
    # ldr x9, [x29, #soff]   (soff positive, LDR imm12*8 range — 32760 max)
    EW(S, 0xF94003A9 | ((soff / 8) << 10));
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF80003A9 | (off9 << 12));  # stur x9, [x29, #disp]
        return 0;
    }
    # disp out of range — compute dest addr in x10 (x9 holds value), str x9, [x10]
    var abs = 0 - disp;
    EW(S, 0xD280000A | ((abs & 0xFFFF) << 5));  # movz x10, #abs
    EW(S, 0xCB0A03AA);                            # sub x10, x29, x10
    EW(S, 0xF9000149);                            # str x9, [x10]
    return 0;
}

fn ESTOREPARM(S, pidx, lidx, pc): i64 {
    var disp = 0 - ((lidx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (pidx < 6) {
        ESTOREREGPARM(S, pidx, disp);
    } else {
        ESTORESTACKPARM(S, pidx, disp, pc);
    }
    return 0;
}

# v5.10.36 — aarch64 V0 NEON register-class return for f64v2
# (Phase 8 of the value-type ABI arc; mirror of v5.10.32's x86
# XMM0 SSE-class optimisation).
#
# Pre-v5.10.36 (v5.10.29 Phase 2): aarch64 returned f64v2 as an
# int-class pair (X0 = lo, X1 = hi), 8 bytes of emit per
# load/store (two LDUR / STUR X-form instructions). That's
# correct under AAPCS64's general-purpose composite rules but
# leaves performance on the floor: AAPCS64 classifies 16-byte
# composites composed of FP fields as **SIMD class**, returned
# in V0 — same shape as x86 SysV SSE class returning in XMM0.
#
# v5.10.36 switches to V0: a single 128-bit NEON load/store
# (`ldur q0` / `stur q0`, 4 bytes each) replaces the v5.10.29
# X-pair (8 bytes each). cycc_aarch64 shrinks by the
# encoding-density gain (same shape as v5.10.32's -384 B on x86).
#
# `idx` is the NAMED slot's local index (returned by FINDLOCAL on
# the f64v2 var name). 2-slot layout matches x86:
#   slot idx-1 = anonymous filler (hi half = &v + 8)
#   slot idx   = named (lo half / bottom of struct = &v + 0)
# Named slot is at the deepest frame offset; field 0 (lo) is at
# &v+0, field 1 (hi) at &v+8. The single LDUR Q0 loads 16 bytes
# starting at &v (= disp_lo), packed as V0[63:0] = lo,
# V0[127:64] = hi — exact in-memory layout.
#
# Disp must fit LDUR/STUR (SIMD) imm9 (-256..+255). For typical
# regalloc cap 5 + named-slot idx ≤ ~64, disp stays well within
# range; defensive guard for the implausible cap-overflow case.
#
# Encoding (LDUR Q0, [X29, #imm9]):
#   bits 31..30 = 00 (size=00 for 128-bit unscaled SIMD/FP)
#   bits 29..24 = 111100
#   bits 23..22 = 11 (opc=11 = 128-bit load)
#   bit 21      = 0
#   bits 20..12 = imm9 (signed)
#   bits 11..10 = 00 (LDUR unscaled offset)
#   bits 9..5   = 11101 (Rn = X29 / FP)
#   bits 4..0   = 00000 (Rt = Q0)
# Base (imm9=0): 0x3CC003A0.
#
# Encoding (STUR Q0, [X29, #imm9]):
#   Same as LDUR but opc = 10 (128-bit store). Base: 0x3C8003A0.
fn EFLLOAD_F64V2_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) {
        disp_lo = disp_lo - _cur_fn_ret_stash;
    }
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        # ldur q0, [x29, #disp_lo] — single 128-bit SIMD load.
        EW(S, 0x3CC003A0 | (off_lo << 12));
        return 0;
    }
    # v6.4.30: large frame — disp out of LDUR Q's imm9 (±256). Compute the address in
    # x9 (= x29 + disp) then ldr q0, [x9] — mirrors EFLLOAD's x-reg large-disp fallback.
    # (Surfaced enabling simd_ints on aarch64: its value-form vector returns sit past −256.)
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0x3DC00120);                # ldr q0, [x9]
    return 0;
}

# Mirror of EFLLOAD_F64V2_PAIR for caller-side post-call store:
#   stur q0, [x29, #disp_lo]   (16 bytes at &v)
# Single STUR Q0 lays the returned V0 into caller's 16-byte
# stack-local (named slot at disp_lo = lo half, filler at
# disp_lo+8 = hi half). Same layout as v5.10.32's x86 XMM0.
fn EFLSTORE_F64V2_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) {
        disp_lo = disp_lo - _cur_fn_ret_stash;
    }
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        # stur q0, [x29, #disp_lo] — single 128-bit SIMD store.
        EW(S, 0x3C8003A0 | (off_lo << 12));
        return 0;
    }
    # v6.4.30: large frame — use x9-relative str q0 (see EFLLOAD_F64V2_PAIR).
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0x3D800120);                # str q0, [x9]
    return 0;
}

# v5.10.37 — emit f64v4 pair-quad return LOAD (callee-side).
# Two LDUR Q's: Q0 from [&v + 0..15], Q1 from [&v + 16..31].
# Mirror of x86's EFLLOAD_F64V4_PAIR. AAPCS64's SIMD&FP class
# allows 256-bit composites in V0+V1 (mirror of SysV's
# xmm0+xmm1 for 32B). Encoding bases per the v5.10.36 LDUR Q
# decode: 0x3CC003A0 + offset shift + Rt LSB.
#   LDUR Q0 = 0x3CC003A0
#   LDUR Q1 = 0x3CC003A1
# Win64 PE uses retptr-style; this fn isn't called when
# _cur_fn_ret_stash > 0 (PARSE_RETURN routes to
# ESTRUCT_BYVAL_COPY instead).
fn EFLLOAD_F64V4_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) {
        disp_lo = disp_lo - _cur_fn_ret_stash;
    }
    var disp_hi = disp_lo + 16;
    # v5.10.37 — fast path: both halves fit LDUR Q imm9 (-256..255).
    # Fallback when out of range: compute x9 = x29 + disp_lo via
    # _EFP_ADDR_X9, then LDR Q0,[x9] + LDR Q1,[x9,#16] (imm12*16 scaled
    # range, fits both halves). Mirrors the EFLLOAD/ESTOREREGPARM
    # fast/slow pattern at lines 816-825.
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        # ldur q0, [x29, #disp_lo]
        EW(S, 0x3CC003A0 | (off_lo << 12));
        # ldur q1, [x29, #disp_hi]
        EW(S, 0x3CC003A1 | (off_hi << 12));
        return 0;
    }
    # Slow path: deep-frame fallback via X9 base.
    _EFP_ADDR_X9(S, disp_lo);
    # ldr q0, [x9, #0] — 128-bit LDR (imm12-scaled, imm=0)
    EW(S, 0x3DC00120);
    # ldr q1, [x9, #16] — 128-bit LDR (imm12=1 → byte offset 16)
    EW(S, 0x3DC00521);
    return 0;
}

# v5.10.37 — emit f64v4 pair-quad STORE post-call (caller-side).
# Mirror of EFLLOAD_F64V4_PAIR. STUR Q encoding: 0x3C8003A0 + Rt.
#   STUR Q0 = 0x3C8003A0
#   STUR Q1 = 0x3C8003A1
# Fallback STR Q (imm12-scaled) bases:
#   STR Q0, [x9, #0]  = 0x3D800120
#   STR Q1, [x9, #16] = 0x3D800521
fn EFLSTORE_F64V4_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) {
        disp_lo = disp_lo - _cur_fn_ret_stash;
    }
    var disp_hi = disp_lo + 16;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        # stur q0, [x29, #disp_lo]
        EW(S, 0x3C8003A0 | (off_lo << 12));
        # stur q1, [x29, #disp_hi]
        EW(S, 0x3C8003A1 | (off_hi << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    # str q0, [x9, #0]
    EW(S, 0x3D800120);
    # str q1, [x9, #16]
    EW(S, 0x3D800521);
    return 0;
}

# v5.10.46 Phase 2 of struct-byval ABI arc — aarch64 AAPCS64
# int-class 16B struct pair-return. AAPCS64 §6.9 specifies X0+X1
# for ≤16B int-class composite returns (lo in X0, hi in X1).
# Linux aarch64 and macOS arm64 share AAPCS64 → this same encoding
# covers both `_TARGET_MACHO` ∈ {0, 2}; the macho branches in this
# file are for relocation / branch encoding, NOT for the value-
# return ABI. Phase 3 (v5.10.47) cross-host verifies on pi + ecb.
#
# Encoding (LDUR Xt, [X29, #simm9]):
#   1111 1000 010 simm9 00 Xn Xt
#   Base for X0 [X29]: 0xF84003A0; for X1: 0xF84003A1.
#   imm9 range: -256..+255.
# Deep-frame fallback (disp_lo < -256): compute X9 = X29 + disp_lo
# via _EFP_ADDR_X9, then LDR (imm12-scaled).
fn EFLLOAD_STRUCT_INT_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 8;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        EW(S, 0xF84003A0 | (off_lo << 12));   # ldur x0, [x29, #disp_lo]
        EW(S, 0xF84003A1 | (off_hi << 12));   # ldur x1, [x29, #disp_hi]
        return 0;
    }
    # Deep-frame fallback: ldr x0, [x9, #0] + ldr x1, [x9, #8] via
    # imm12-scaled (byte_offset = imm12 * 8, range 0..32760).
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0xF9400120);   # ldr x0, [x9, #0]  (imm12=0)
    EW(S, 0xF9400521);   # ldr x1, [x9, #8]  (imm12=1 → byte 8)
    return 0;
}

# Mirror: STUR Xt encoding: 0xF80003A0 (X0) / 0xF80003A1 (X1).
# Receives X0+X1 into the caller's 2-slot stack-local after the
# callee returns.
fn EFLSTORE_STRUCT_INT_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 8;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        EW(S, 0xF80003A0 | (off_lo << 12));   # stur x0, [x29, #disp_lo]
        EW(S, 0xF80003A1 | (off_hi << 12));   # stur x1, [x29, #disp_hi]
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0xF9000120);   # str x0, [x9, #0]
    EW(S, 0xF9000521);   # str x1, [x9, #8]
    return 0;
}

# v5.10.38 — aarch64 f64v2 SIMD-class param store at fn entry.
# Mirror of x86 ESTOREPARM_F64V2. `simd_ord` is the V-register
# ordinal (0..7 under AAPCS64); `named_idx` is the named slot
# of the 2-slot stack-local where the f64v2 value lives.
# Single STUR Q<simd_ord> stores 16 bytes from the NEON
# register into the local; deep-frame fallback via X9 + STR Q
# (imm12-scaled) if disp_lo < -256.
#
# Encoding: `stur q<N>, [x29, #imm9]` = 0x3C8003A0 + N | (off9 << 12)
# Deep-frame: `str q<N>, [x9, #0]` = 0x3D800120 + N
fn ESTOREPARM_F64V2(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        EW(S, 0x3C8003A0 | (simd_ord & 0x1F) | (off_lo << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0x3D800120 | (simd_ord & 0x1F));
    return 0;
}

# v5.10.38 — aarch64 f64v4 SIMD-class param store at fn entry.
# Two STUR Q (V<simd_ord>+V<simd_ord+1>) for the 4-slot region.
fn ESTOREPARM_F64V4(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 16;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        # stur q<simd_ord>, [x29, #disp_lo]
        EW(S, 0x3C8003A0 | (simd_ord & 0x1F) | (off_lo << 12));
        # stur q<simd_ord+1>, [x29, #disp_hi]
        EW(S, 0x3C8003A0 | ((simd_ord + 1) & 0x1F) | (off_hi << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    # str q<simd_ord>, [x9, #0]
    EW(S, 0x3D800120 | (simd_ord & 0x1F));
    # str q<simd_ord+1>, [x9, #16]
    EW(S, 0x3D800520 | ((simd_ord + 1) & 0x1F));
    return 0;
}

# v6.4.31 — Win64-only value-form SIMD param store (MS x64 by-pointer ABI).
# Never reached off-PE (_TARGET_PE==0 on aarch64); stub so the shared
# parse_fn.cyr reference resolves in the aarch64 forks. [[project_v6426]]
# ETERMINATE_PE cross-fork-stub lesson.
fn ESTOREPARM_SIMD_WIN64(S, pidx, named_idx, nbytes): i64 { return 0; }

# v5.10.38 — aarch64 caller-side SIMD-arg LOAD into V-register.
# Mirror of x86 ELOAD_F64V2_TO_XMM. Encoding: ldur q<N> base
# 0x3CC003A0 + N; deep-frame fallback ldr q<N> base 0x3DC00120 + N.
fn ELOAD_F64V2_TO_XMM(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        EW(S, 0x3CC003A0 | (simd_ord & 0x1F) | (off_lo << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0x3DC00120 | (simd_ord & 0x1F));
    return 0;
}

fn ELOAD_F64V4_TO_XMM(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 16;
    if (disp_lo >= 0 - 256) {
        var off_lo = disp_lo & 0x1FF;
        var off_hi = disp_hi & 0x1FF;
        EW(S, 0x3CC003A0 | (simd_ord & 0x1F) | (off_lo << 12));
        EW(S, 0x3CC003A0 | ((simd_ord + 1) & 0x1F) | (off_hi << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp_lo);
    EW(S, 0x3DC00120 | (simd_ord & 0x1F));
    EW(S, 0x3DC00520 | ((simd_ord + 1) & 0x1F));
    return 0;
}

# Local variable load: ldur x0, [x29, #-offset]
# v5.9.26: account for `_cur_fn_ret_stash` so locals in
# struct-returning fns don't overlap the X8 retptr stash slot.
fn EFLLOAD(S, idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF84003A0 | (off9 << 12));  # ldur x0, [x29, #disp]
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    EW(S, 0xF9400120);  # ldr x0, [x9]
    return 0;
}

# Local variable store: stur x0, [x29, #-offset]
# v5.9.26: account for `_cur_fn_ret_stash` (see EFLLOAD note).
fn EFLSTORE(S, idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        EW(S, 0xF80003A0 | (off9 << 12));  # stur x0, [x29, #disp]
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    EW(S, 0xF9000120);  # str x0, [x9]
    return 0;
}

# v5.8.54 — frame-local-address pair, peer of x86's EFLADDR / EFLADDR_X1
# (`src/backend/x86/emit.cyr:1391` / `:1373`). Compute the address of
# local slot `lli` into x0 (EFLADDR) or x1 (EFLADDR_X1) for caller code
# that needs an &local — struct-field LEA, hidden retbuf-arg push,
# slice canonical-slot init via `slice_set` / `slice_ptr`. Pre-v5.8.54
# these were defined in x86/emit.cyr only; parse_decl.cyr (lines 127,
# 236, 301, 355, 931, 1019, 1060) and parse_expr.cyr:234 call them
# unconditionally — the aarch64 cross-build emitted "undefined function"
# warnings + "will crash at runtime" errors. sit v0.7.2 release flow
# never hit them (sit's source doesn't trip the parser paths that emit
# these); the cross-build was building a binary that would have SIGILL'd
# on the first struct-field-load or slice-init had any consumer reached
# them on aarch64. Latent bug, not active regression — surfaced when
# v5.8.53's install-pipeline fix cleared the noise from the cross-build
# warnings.
#
# **Asymmetry to flag**: x86's EFLADDR formula adjusts disp for
# `_cur_fn_regalloc * 8` (callee-saved register save slots) and
# `_cur_fn_ret_stash` (hidden retbuf alignment). aarch64's existing
# EFLLOAD / EFLSTORE / ESTOREPARM don't apply these adjustments —
# aarch64 doesn't currently stash callee-saved x19-x28 to the frame,
# and its multi-return path uses x0+x2 register-pair return rather
# than a stack-allocated retbuf with hidden first-arg.
# EFLADDR / EFLADDR_X1 below mirror the existing aarch64 formula
# (`disp = -((lli+1)*8)`, no adjustments) for consistency. **If a
# future slot adds callee-saved register stashing on aarch64**, this
# pair must update in lockstep with EFLLOAD / EFLSTORE — they're a
# coupled set; fixing one without the others silently corrupts
# locals.
fn EFLADDR(S, lli): i64 {
    var disp = (lli + 1) * 8;     # positive magnitude — locals below x29
    if (_cur_fn_ret_stash > 0) { disp = disp + _cur_fn_ret_stash; }
    if (disp <= 4095) {
        # sub x0, x29, #disp (imm12, no shift)
        EW(S, 0xD10003A0 | (disp << 10));
        return 0;
    }
    # Fallback — disp >= 4096. Synthesize via x9 scratch then sub.
    # cyrius functions with > 511 locals are implausible (would need
    # 4096 / 8 = 512 frame slots before hitting this), but the path
    # exists for safety.
    _EFP_ADDR_X9(S, 0 - disp);   # x9 = x29 - disp
    EW(S, 0xAA0903E0);           # mov x0, x9
    return 0;
}

fn EFLADDR_X1(S, lli): i64 {
    var disp = (lli + 1) * 8;
    if (_cur_fn_ret_stash > 0) { disp = disp + _cur_fn_ret_stash; }
    if (disp <= 4095) {
        # sub x1, x29, #disp (imm12, no shift)
        EW(S, 0xD10003A1 | (disp << 10));
        return 0;
    }
    _EFP_ADDR_X9(S, 0 - disp);   # x9 = x29 - disp
    EW(S, 0xAA0903E1);           # mov x1, x9
    return 0;
}

# Object mode check (shared with x86)
fn _IS_OBJ(S): i64 { return L64(S + 0x18FCA0) == 3; }

# Width-aware local load: ldurb/ldurh/ldur w0/ldur x0 from [x29, #-offset]
fn EFLLOAD_W(S, idx, width): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        # v6.3.35: negative width = SIGNED → sign-extending unscaled load (ldursb/h/sw).
        if (width < 0) {
            var sw = 0 - width;
            if (sw == 1) { EW(S, 0x388003A0 | (off9 << 12)); return 0; }  # ldursb x0, [x29]
            if (sw == 2) { EW(S, 0x788003A0 | (off9 << 12)); return 0; }  # ldursh x0, [x29]
            if (sw == 4) { EW(S, 0xB88003A0 | (off9 << 12)); return 0; }  # ldursw x0, [x29]
        }
        if (width == 1) { EW(S, 0x384003A0 | (off9 << 12)); return 0; }
        if (width == 2) { EW(S, 0x784003A0 | (off9 << 12)); return 0; }
        if (width == 4) { EW(S, 0xB84003A0 | (off9 << 12)); return 0; }
        EW(S, 0xF84003A0 | (off9 << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    if (width < 0) {
        var sw2 = 0 - width;
        if (sw2 == 1) { EW(S, 0x39800120); return 0; }  # ldrsb x0, [x9]
        if (sw2 == 2) { EW(S, 0x79800120); return 0; }  # ldrsh x0, [x9]
        if (sw2 == 4) { EW(S, 0xB9800120); return 0; }  # ldrsw x0, [x9]
    }
    if (width == 1) { EW(S, 0x39400120); return 0; }  # ldrb w0, [x9]
    if (width == 2) { EW(S, 0x79400120); return 0; }  # ldrh w0, [x9]
    if (width == 4) { EW(S, 0xB9400120); return 0; }  # ldr w0, [x9]
    EW(S, 0xF9400120);  # ldr x0, [x9]
    return 0;
}

# Width-aware local store: sturb/sturh/stur w0/stur x0 to [x29, #-offset]
fn EFLSTORE_W(S, idx, width): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (disp >= 0 - 256) {
        var off9 = disp & 0x1FF;
        if (width == 1) { EW(S, 0x380003A0 | (off9 << 12)); return 0; }
        if (width == 2) { EW(S, 0x780003A0 | (off9 << 12)); return 0; }
        if (width == 4) { EW(S, 0xB80003A0 | (off9 << 12)); return 0; }
        EW(S, 0xF80003A0 | (off9 << 12));
        return 0;
    }
    _EFP_ADDR_X9(S, disp);
    if (width == 1) { EW(S, 0x39000120); return 0; }  # strb w0, [x9]
    if (width == 2) { EW(S, 0x79000120); return 0; }  # strh w0, [x9]
    if (width == 4) { EW(S, 0xB9000120); return 0; }  # str w0, [x9]
    EW(S, 0xF9000120);  # str x0, [x9]
    return 0;
}

# Width-aware positive-width load from [x1] → w0/x0 (R4, v6.4.15): the 4 positive
# arms shared by EVLOAD_W and EFIELD_LOAD_W (ldrb/ldrh/ldr w0 for 1/2/4, ldr x0
# for 8). Signed arms stay inline in EFIELD_LOAD_W (EVLOAD_W has none — its only
# caller passes a positive var_size).
fn _EMIT_NLOAD_X1_POS(S, width): i64 {
    if (width == 1) { EW(S, 0x39400020); return 0; }   # ldrb w0, [x1]
    if (width == 2) { EW(S, 0x79400020); return 0; }   # ldrh w0, [x1]
    if (width == 4) { EW(S, 0xB9400020); return 0; }   # ldr  w0, [x1]
    EW(S, 0xF9400020); return 0;                       # ldr  x0, [x1]
}

# Width-aware global load: ldr from [x1] with width
fn EVLOAD_W(S, idx, width): i64 {
    EVADDR_X1(S, idx);
    # v6.4.23: negative width = SIGNED sub-i64 global → sign-extending load from [x1]
    # (same encodings as EFIELD_LOAD_W; the global-load caller now passes a negated
    # width for signed iN globals per parse_expr.cyr's GVSGN check).
    if (width < 0 - 2) { EW(S, 0xB9800020); return 0; }  # -4: ldrsw x0, [x1]
    if (width == 0 - 2) { EW(S, 0x79800020); return 0; } # ldrsh x0, [x1]
    if (width == 0 - 1) { EW(S, 0x39800020); return 0; } # ldrsb x0, [x1]
    _EMIT_NLOAD_X1_POS(S, width);
    return 0;
}

# Width-aware global store: str to [x1] with width
fn EVSTORE_W(S, idx, width): i64 {
    EVADDR_X1(S, idx);
    if (width == 1) { EW(S, 0x39000020); return 0; }
    if (width == 2) { EW(S, 0x79000020); return 0; }
    if (width == 4) { EW(S, 0xB9000020); return 0; }
    EW(S, 0xF9000020); return 0;
}

# v5.9.40 — sub-byte struct field load (parse_decl.cyr:252).
# Field-base ptr is in x1 (already advanced to the field start
# by callers). Emits ldrb/ldrh/ldr w0/ldr x0 by width. Pulled
# out of an inline `if (_AARCH64_BACKEND == 1)` block into a
# named helper so the cx backend can sit alongside as a peer
# without parse_decl.cyr having to grow another arch arm.
fn EFIELD_LOAD_W(S, width): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    # v6.3.35: negative width = SIGNED field → sign-extending load from [x1].
    if (width < 0 - 2) { EW(S, 0xB9800020); return 0; }  # -4: ldrsw x0, [x1]
    if (width == 0 - 2) { EW(S, 0x79800020); return 0; } # ldrsh x0, [x1]
    if (width == 0 - 1) { EW(S, 0x39800020); return 0; } # ldrsb x0, [x1]
    _EMIT_NLOAD_X1_POS(S, width);                        # shared positive arms (R4, v6.4.15)
    return 0;
}

# v5.9.40 — struct-by-value return aarch64 byte-copy loop
# (parse_fn.cyr:339). Pulled out of an inline emit block in
# parse_fn.cyr so the cx backend's `ESTRUCT_BYVAL_COPY` peer
# fires from the same call site. Encoding plan (8 instructions):
#   x9  = fp + src_disp                  (via _EFP_ADDR_X9)
#   x10 = ldur [fp + stash_disp]         (retptr)
#   x11 = movz aligned_byte_count
#   loop:
#     ldrb w12, [x9], #1                 (post-incr src)
#     strb w12, [x10], #1                (post-incr dst)
#     subs x11, x11, #1
#     b.ne loop                          (-3 instructions back)
#   x0  = ldur [fp + stash_disp]         (reload retptr — x10 is past)
fn ESTRUCT_BYVAL_COPY(S, src_disp, stash_disp, aligned): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    _EFP_ADDR_X9(S, src_disp);
    var off9 = stash_disp & 0x1FF;
    EW(S, 0xF84003AA | (off9 << 12));               # ldur x10, [x29, #stash_disp]
    EW(S, 0xD280000B | ((aligned & 0xFFFF) << 5));  # movz x11, #aligned
    EW(S, 0x3840152C);                              # ldrb w12, [x9], #1
    EW(S, 0x3800154C);                              # strb w12, [x10], #1
    EW(S, 0xF100056B);                              # subs x11, x11, #1
    EW(S, 0x54FFFFA1);                              # b.ne -3
    EW(S, 0xF84003A0 | (off9 << 12));               # ldur x0,  [x29, #stash_disp]
    return 0;
}

# Patch frame size into the two prologue slots reserved by ESUBRSP.
# ADD/SUB-immediate carries only a 12-bit imm (optionally LSL #12), so the
# old single-slot `size & 0xFFF` silently masked frames >= 4096 — at exactly
# 4096 -> `sub sp, sp, #0` (no allocation) -> silent stack corruption. The
# epilogue restores sp via `mov sp, x29` (frame-pointer-based), so it needs no
# matching change. slot1 = sub #lo, slot2 = sub #hi, LSL #12 — covers frames up
# to 0xFFFFFF (16 MB); small frames NOP slot2. See CHANGELOG [6.2.21].
fn EPATCHFRAME(S, patch, size): i64 {
    var addr = _codebuf_base + patch;
    var slot1 = 0;
    var slot2 = 0;
    if (size < 4096) {
        slot1 = 0xD10003FF | (size << 10);                    # sub sp, sp, #size
        slot2 = 0xD503201F;                                   # nop
    } else {
        slot1 = 0xD10003FF | ((size & 0xFFF) << 10);          # sub sp, sp, #lo
        slot2 = 0xD14003FF | (((size >> 12) & 0xFFF) << 10);  # sub sp, sp, #hi, LSL #12
    }
    S64(addr, (slot1 & 0xFFFFFFFF) | ((slot2 & 0xFFFFFFFF) << 32));
    return 0;
}

# === Token access moved to src/backend/common/tokens.cyr at v6.0.8 ===

# ================================================================
# AARCH64 INLINE ASM MNEMONICS
# ================================================================

fn ASM_MNEMONIC(S): i64 {
    var noff = PEEKV(S);
    var mnem = L64(S + 0xEC00000 + noff);
    STI(S, GTI(S) + 1);
    if (mnem & 0xFFFFFF == 0x637673) { EW(S, 0xD4000001); }                    # svc
    elif (mnem & 0xFFFFFF == 0x696677) { EW(S, 0xD503207F); }                  # wfi
    elif (mnem & 0xFFFFFF == 0x656677) { EW(S, 0xD5031020); }                  # wfe
    elif (mnem & 0xFFFFFF == 0x626D64) { EW(S, 0xD50330BF); }                  # dmb
    elif (mnem & 0xFFFFFF == 0x627364) { EW(S, 0xD503309F); }                  # dsb
    elif (mnem & 0xFFFFFF == 0x627369) { EW(S, 0xD50330DF); }                  # isb
    elif (mnem & 0xFFFFFF == 0x706F6E) { EW(S, 0xD503201F); }                  # nop
    elif (mnem & 0xFFFFFF == 0x746572) { EW(S, 0xD65F03C0); }                  # ret
    elif (mnem & 0xFFFFFFFF == 0x74657265) { EW(S, 0xD69F03E0); }              # eret (v6.2.28 — exception return for aarch64 #naked ISR handlers; mirrors x86 iretq)
    elif (mnem == 0x6F6C5F6D61726170) { ASM_PARAM_LOAD(S, noff); }             # param_load(reg,idx)
    else {
        syscall(SYS_WRITE, 2, "error:", 6);
        FM_LOOKUP(S, GTLINE(S, GTI(S) - 1));
        syscall(SYS_WRITE, 2, ": unknown aarch64 asm mnemonic\n", 31);
        syscall(SYS_EXIT, 1);
    }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# v6.0.67: map an aarch64 register NAME (first bytes as L64) → number 0-30. 3-char
# names (x10-x30) checked before 2-char (x0-x9) so "x10" doesn't match "x1".
fn _asm_aarch64_reg(n): i64 {
    if (n & 0xFFFFFF == 0x303178) { return 10; }   if (n & 0xFFFFFF == 0x313178) { return 11; }
    if (n & 0xFFFFFF == 0x323178) { return 12; }   if (n & 0xFFFFFF == 0x333178) { return 13; }
    if (n & 0xFFFFFF == 0x343178) { return 14; }   if (n & 0xFFFFFF == 0x353178) { return 15; }
    if (n & 0xFFFFFF == 0x363178) { return 16; }   if (n & 0xFFFFFF == 0x373178) { return 17; }
    if (n & 0xFFFFFF == 0x383178) { return 18; }   if (n & 0xFFFFFF == 0x393178) { return 19; }
    if (n & 0xFFFFFF == 0x303278) { return 20; }   if (n & 0xFFFFFF == 0x313278) { return 21; }
    if (n & 0xFFFFFF == 0x323278) { return 22; }   if (n & 0xFFFFFF == 0x333278) { return 23; }
    if (n & 0xFFFFFF == 0x343278) { return 24; }   if (n & 0xFFFFFF == 0x353278) { return 25; }
    if (n & 0xFFFFFF == 0x363278) { return 26; }   if (n & 0xFFFFFF == 0x373278) { return 27; }
    if (n & 0xFFFFFF == 0x383278) { return 28; }   if (n & 0xFFFFFF == 0x393278) { return 29; }
    if (n & 0xFFFFFF == 0x303378) { return 30; }
    if (n & 0xFFFF == 0x3078) { return 0; }   if (n & 0xFFFF == 0x3178) { return 1; }
    if (n & 0xFFFF == 0x3278) { return 2; }   if (n & 0xFFFF == 0x3378) { return 3; }
    if (n & 0xFFFF == 0x3478) { return 4; }   if (n & 0xFFFF == 0x3578) { return 5; }
    if (n & 0xFFFF == 0x3678) { return 6; }   if (n & 0xFFFF == 0x3778) { return 7; }
    if (n & 0xFFFF == 0x3878) { return 8; }   if (n & 0xFFFF == 0x3978) { return 9; }
    return 0 - 1;
}

# v6.0.67: asm-block `param_load(reg, idx)` — emit `ldur reg, [x29, #disp]` loading the
# idx-th parameter from its ACTUAL prologue slot (disp = -(idx+1+_cur_fn_regalloc)*8),
# instead of hardcoded `[x29,#-N]` byte literals that break on prologue drift. Byte-
# identical to the old literals when _cur_fn_regalloc==0. ldur's imm9 is signed
# -256..255; params beyond that ERR (rare). See issue 2026-05-21-asm-block-global-symbol-pseudo.
fn ASM_PARAM_LOAD(S, noff): i64 {
    if (load8(S + 0xEC00000 + noff + 8) != 97) { ERR(S); }    # 'a'
    if (load8(S + 0xEC00000 + noff + 9) != 100) { ERR(S); }   # 'd'
    if (PEEKT(S) != 10) { ERR(S); }      # (
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 2) { ERR(S); }       # register identifier
    var reg = _asm_aarch64_reg(L64(S + 0xEC00000 + PEEKV(S)));
    if (reg < 0) { ERR(S); }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 31) { ERR(S); }      # ,
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 1) { ERR(S); }       # idx (integer literal)
    var idx = PEEKV(S);
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 11) { ERR(S); }      # )
    STI(S, GTI(S) + 1);
    var disp = 0 - ((idx + 1 + _cur_fn_regalloc) * 8);
    if (disp < 0 - 256) { ERR(S); }      # ldur imm9 signed range
    EW(S, 0xF8400000 | ((disp & 0x1FF) << 12) | (29 << 5) | reg);
    return 0;
}

# Tail call: epilogue + branch to function (aarch64)
fn ETAILJMP(S, fnidx): i64 {
    # Restore frame: mov sp, x29; ldp x29, x30, [sp], #16
    EW(S, 0x910003BF);  # mov sp, x29
    EW(S, 0xA8C17BFD);  # ldp x29, x30, [sp], #16
    # Branch to function — use fixup type 4 for B (not BL)
    var poff = GCP(S);
    EW(S, 0x14000000);  # B placeholder
    var fc = GFCNT(S);
    var faddr = _fixup_base + fc * 16;
    S64(faddr, poff);
    S64(faddr + 8, (4 << 56) | fnidx);
    SFCNT(S, fc + 1);
    return 0;
}

# ================================================================
# COMPARISON EXPRESSION (ESETCC equivalent for aarch64)
# ================================================================
# cmp x0, x1; cset x0, <cond>
# op: 17=EQ, 18=NE, 19=LT, 20=GT, 21=LE, 22=GE
fn ESETCC(S, op): i64 {
    # cmp x0, x1 (EB 00 01 6B = subs xzr, x0, x1... actually CMP is alias)
    EW(S, 0xEB01001F);
    # cset x0, <cond>
    if (op == 17) { EW(S, 0x9A9F17E0); }
    if (op == 18) { EW(S, 0x9A9F07E0); }
    if (op == 19) { EW(S, 0x9A9FA7E0); }   # lt → csinc x0, xzr, xzr, ge  (cond=1010)
    if (op == 20) { EW(S, 0x9A9FD7E0); }   # gt → csinc x0, xzr, xzr, le  (cond=1101)
    if (op == 21) { EW(S, 0x9A9FC7E0); }   # le → csinc x0, xzr, xzr, gt  (cond=1100)
    if (op == 22) { EW(S, 0x9A9FB7E0); }   # ge → csinc x0, xzr, xzr, lt  (cond=1011)
    return 0;
}

# ================================================================
# F64 STUBS (aarch64 float not yet implemented — stubs for compilation)
# ================================================================
# v5.7.30: aarch64 f64 basic-op implementation. Pre-v5.7.30 every
# fn below was `return 0;` — silent miscompile on every f64 op
# (basic ops emitted no fp instructions; f64_add(1.0, 2.0) returned
# 2.0 because parser left second arg in x0 and EMIT_F64_BINOP did
# nothing). phylax-blocking; surfaced via the f64_exp hard-reject.
# The single-instruction emits below match the x86 contract:
# inputs are bit-pattern in x0 (last arg) + stack TOS (first arg);
# output is bit-pattern in x0.

# v5.7.30: x86-named no-ops kept for parser-shared codepaths. The
# EMOVQ_*/EUCOMISD/EXORPD_X1/EMOVAPD_01/EX87PUSH/EX87POP helpers are
# x86 bit-cast / x87-stack-mgmt helpers the aarch64 path doesn't
# need — fmov d, x and fmov x, d are inlined directly into EMIT_
# F64_BINOP / EMIT_F64_CMP / etc. The stubs preserve the parser API.
fn EMOVQ_X0_A(S): i64 { return 0; }
fn EMOVQ_X1_C(S): i64 { return 0; }
fn EMOVQ_A_X0(S): i64 { return 0; }
fn EUCOMISD(S): i64 { return 0; }
fn EXORPD_X1(S): i64 { return 0; }
fn EMOVAPD_01(S): i64 { return 0; }
fn EX87PUSH(S): i64 { return 0; }
fn EX87POP(S): i64 { return 0; }

# v5.7.30: int → f64. Input: x0 = int. Output: x0 = f64 bit pattern.
# scvtf d0, x0  (signed convert to double)
# fmov x0, d0   (extract bits)
# Replaces the previous `return 0;` stub which silently produced 0.
fn EI2F(S): i64 {
    EW(S, 0x9E620000);   # scvtf d0, x0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# v5.7.30: f64 → int. Input: x0 = f64 bit pattern. Output: x0 = int.
# fmov d0, x0   (interpret bits as double)
# fcvtzs x0, d0 (signed convert, round toward zero)
fn EF2I(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x9E780000);   # fcvtzs x0, d0
    return 0;
}

# fsqrt d0, d0  (single-source FP op; bits in x0 already → fmov to
# d0, FSQRT, fmov back).
fn EF64SQRT(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0   — interpret x0 bits as double
    EW(S, 0x1E61C000);   # fsqrt d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0   — extract bit pattern
    return 0;
}

# frintm d0, d0  (round toward -∞)
fn EF64FLOOR(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E654000);   # frintm d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# frintp d0, d0  (round toward +∞)
fn EF64CEIL(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E64C000);   # frintp d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# frintn d0, d0  (round to nearest, ties to even)
fn EF64ROUND(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E644000);   # frintn d0, d0
    EW(S, 0x9E660000);   # fmov x0, d0
    return 0;
}

# Binop contract (matches x86 path):
#   in:  stack TOS = first arg bits (a); x0 = second arg bits (b)
#   out: x0 = (a OP b) bit pattern; stack popped.
# fop: 0=add, 1=sub, 2=mul, 3=div.
fn EMIT_F64_BINOP(S, fop): i64 {
    EW(S, 0x9E670001);   # fmov d1, x0   — d1 = b (second arg)
    EPOPR(S);            # pop a into x0
    EW(S, 0x9E670000);   # fmov d0, x0   — d0 = a (first arg)
    if (fop == 0) { EW(S, 0x1E612800); }   # fadd d0, d0, d1
    if (fop == 1) { EW(S, 0x1E613800); }   # fsub d0, d0, d1
    if (fop == 2) { EW(S, 0x1E610800); }   # fmul d0, d0, d1
    if (fop == 3) { EW(S, 0x1E611800); }   # fdiv d0, d0, d1
    EW(S, 0x9E660000);   # fmov x0, d0   — extract result bit pattern
    return 0;
}

# v6.4.56 (scalar-float D2) — f32 scalar arith. Mirror of EMIT_F64_BINOP with
# single-precision S-regs: fmov s,w (bits→reg) / fmov w,s (reg→bits) and the
# f{add,sub,mul,div} s0,s0,s1 forms. All S-reg encodings llvm-mc-verified.
fn EMIT_F32_BINOP(S, fop): i64 {
    EW(S, 0x1E270001);   # fmov s1, w0   — s1 = b (second arg)
    EPOPR(S);            # pop a into x0
    EW(S, 0x1E270000);   # fmov s0, w0   — s0 = a (first arg)
    if (fop == 0) { EW(S, 0x1E212800); }   # fadd s0, s0, s1
    if (fop == 1) { EW(S, 0x1E213800); }   # fsub s0, s0, s1
    if (fop == 2) { EW(S, 0x1E210800); }   # fmul s0, s0, s1
    if (fop == 3) { EW(S, 0x1E211800); }   # fdiv s0, s0, s1
    EW(S, 0x1E260000);   # fmov w0, s0   — extract result bit pattern (zero-ext into x0)
    return 0;
}

# Load a float literal into x0 as IEEE 754 bits. The lexer encodes
# fval as `(denom << 32) | numer` so we reconstruct the double at
# runtime via scvtf + fdiv, matching x86/float.cyr's strategy.
# Mirrors the EMIT_FLOAT_LIT in x86/float.cyr — same input shape,
# same output (f64 bit pattern in x0/rax), aarch64 FP instructions.
fn EMIT_FLOAT_LIT(S, fval): i64 {
    # v6.5.28 — `fval` is now an INDEX into the float-literal side table, not a packed 32/32
    # rational (which overflowed silently past ~9 significant digits). See FLIT_ADD in
    # src/common/util.cyr.
    var numer = FLIT_NUM(fval);
    var denom = FLIT_DEN(fval);
    EMOVI(S, numer);           # x0 = numer
    EW(S, 0x9E620000);         # scvtf d0, x0   — d0 = (double) numer
    EMOVI(S, denom);           # x0 = denom (clobbers x0; that's fine)
    EW(S, 0x9E620001);         # scvtf d1, x0   — d1 = (double) denom
    EW(S, 0x1E611800);         # fdiv d0, d0, d1
    EW(S, 0x9E660000);         # fmov x0, d0    — x0 = f64 bit pattern
    return 0;
}

# f32_from(x): f64 (bit pattern in x0) → f32 (bit pattern in w0). v6.2.18.
fn EF32_FROM(S): i64 {
    EW(S, 0x9E670000);   # fmov d0, x0
    EW(S, 0x1E624000);   # fcvt s0, d0    — narrow double → single
    EW(S, 0x1E260000);   # fmov w0, s0    — w0 = f32 bits (zero-extends x0)
    return 0;
}

# f32_to(x): f32 (bit pattern in w0) → f64 (bit pattern in x0). v6.2.18.
fn EF32_TO(S): i64 {
    EW(S, 0x1E270000);   # fmov s0, w0
    EW(S, 0x1E22C000);   # fcvt d0, s0    — widen single → double
    EW(S, 0x9E660000);   # fmov x0, d0    — x0 = f64 bits
    return 0;
}
# Expression spill stubs
fn ESPILL(S): i64 { EPUSHR(S); return 0; }
fn EUNSPILL(S): i64 { EPOPR(S); return 0; }
# Inline disabled on aarch64
var _INLINE_OK = 0;
var _LOOPVAR_OK = 0;

# v5.10.16 — NEON SIMD packed-double primitives.
# Replaces the v1.9.0-era stubs that returned 0 (silent no-op).
# Pre-v5.10.16: a consumer calling `f64v_add(dst, a, b, n)` on
# aarch64 got an empty function body — dst was never written, the
# loop never ran. Cross-arch propagation gap that escaped because
# no tcyr exercised f64v_*; v5.10.16 adds those.
#
# Frame contract mirrors x86/float.cyr's EMIT_F64V_LOOP:
#   vbase     = dst pointer
#   vbase + 1 = a pointer
#   vbase + 2 = b pointer (LOOP/FMADD only)
#   vbase + 3 = c pointer (FMADD only)
#   x0        = n (count of f64 elements; entry register)
# Loop processes 2 doubles per iteration via Q-registers
# (NEON 128-bit vector regs hold v.2d = 2x f64). Index in x11
# counts doubles; pair-step is +2 to match x86's `rsi += 2`.
#
# Tail behavior: identical to x86 — if n is odd, the last
# iteration touches one element past the array (16-byte load/
# store starting at index n-1). Caller contract: over-allocate
# by one slot or pass even n. Pre-existing footgun preserved
# for cross-arch parity; documented here, not silently fixed.

# SIMD Phase 5 (v6.4.28) — f32v4 packed ops on aarch64 NEON. Mirrors EMIT_F64V_LOOP
# but 4 f32 lanes/iter (128-bit q reg): index scales ×4 (lsl #2), the NEON op is
# .4s, and the counter advances by 4. Slots: vbase=dst, vbase+1=a, vbase+2=b; n in
# x0. op 0=fadd, 1=fsub, 2=fmul (.4s). Encodings verified via llvm-mc. This flips the
# simd_f32v4 XFAIL → XPASS on real ARM (was x86-only in Phase 1).
fn EMIT_F32V_LOOP(S, op, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index = 0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done (patched later)
    EFLLOAD(S, vbase + 1);            # x0 = a base
    EW(S, 0xAA0003EC);                # mov x12, x0
    EW(S, 0x8B0B098C);                # add x12, x12, x11, lsl #2   (f32 stride)
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    EFLLOAD(S, vbase + 2);            # b base
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B098C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    if (op == 0) { EW(S, 0x4E21D400); }   # fadd v0.4s, v0.4s, v1.4s
    if (op == 1) { EW(S, 0x4EA1D400); }   # fsub v0.4s, v0.4s, v1.4s
    if (op == 2) { EW(S, 0x6E21DC00); }   # fmul v0.4s, v0.4s, v1.4s
    EFLLOAD(S, vbase);               # dst base
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B098C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100116B);                # add x11, x11, #4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}
# SIMD Phase 5 (v6.4.28) — f32v4 fmadd / dot on aarch64 NEON.
# EMIT_F32V_FMADD: dst[i] = a[i]*b[i] + c[i], done as fmul then fadd (NOT fused fmla)
# to match the x86 mulps+addps rounding. Slots: vbase=dst, +1=a, +2=b, +3=c; n in x0.
fn EMIT_F32V_FMADD(S, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    EFLLOAD(S, vbase + 1);            # a
    EW(S, 0xAA0003EC); EW(S, 0x8B0B098C); EW(S, 0x3DC00180);   # ldr q0, [x12]
    EFLLOAD(S, vbase + 2);            # b
    EW(S, 0xAA0003EC); EW(S, 0x8B0B098C); EW(S, 0x3DC00181);   # ldr q1, [x12]
    EW(S, 0x6E21DC00);                # fmul v0.4s, v0.4s, v1.4s   (a*b)
    EFLLOAD(S, vbase + 3);            # c
    EW(S, 0xAA0003EC); EW(S, 0x8B0B098C); EW(S, 0x3DC00181);   # ldr q1, [x12] (c)
    EW(S, 0x4E21D400);                # fadd v0.4s, v0.4s, v1.4s   (a*b + c)
    EFLLOAD(S, vbase);                # dst
    EW(S, 0xAA0003EC); EW(S, 0x8B0B098C); EW(S, 0x3D800180);   # str q0, [x12]
    EW(S, 0x9100116B);                # add x11, x11, #4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# EMIT_F32V_DOT: sum(a[i]*b[i]) → f32 bits in x0. v2 accumulates fmul+fadd per iter
# (matches x86 mulps+addps, NOT fused); tail reduces 4 lanes via two faddp (4→2→1).
# Slots: vbase=a, +1=b; n in x0.
fn EMIT_F32V_DOT(S, vbase): i64 {
    EW(S, 0x6E221C42);                # eor v2.16b, v2.16b, v2.16b — zero accumulator
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    EFLLOAD(S, vbase);                # a
    EW(S, 0xAA0003EC); EW(S, 0x8B0B098C); EW(S, 0x3DC00180);   # ldr q0, [x12]
    EFLLOAD(S, vbase + 1);            # b
    EW(S, 0xAA0003EC); EW(S, 0x8B0B098C); EW(S, 0x3DC00181);   # ldr q1, [x12]
    EW(S, 0x6E21DC00);                # fmul v0.4s, v0.4s, v1.4s   (a*b)
    EW(S, 0x4E20D442);                # fadd v2.4s, v2.4s, v0.4s   (accumulate)
    EW(S, 0x9100116B);                # add x11, x11, #4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EW(S, 0x6E22D442);                # faddp v2.4s, v2.4s, v2.4s  (4 → 2)
    EW(S, 0x6E22D442);                # faddp v2.4s, v2.4s, v2.4s  (2 → 1, total in lane 0)
    EW(S, 0x1E260040);                # fmov w0, s2   — f32 bits → x0
    return 0;
}
# SIMD Phase 5 (v6.4.30) — packed integer add/sub/mul on aarch64 NEON, width-dispatched.
# w = element bytes (1/2/4/8 → i8/i16/i32/i64); 16/w lanes per 128-bit iter. op 0=add, 1=sub,
# 2=mul. add/sub via ADD/SUB `.16b/.8h/.4s/.2d`; MUL uses `.8h/.4s` for i16/i32, and i64 (w==8)
# is synthesized from 2 scalar GPR products (NEON has no .2d integer mul); i8 (w==1) hard-errors
# (SSE/NEON have no 8-bit vector mul — matched to x86, v6.4.53). Slots:
# vbase=dst, +1=a, +2=b; n in x0. Mirrors EMIT_F32V_LOOP with a per-width stride/op. llvm-mc.
fn EMIT_IVEC_BINOP(S, op, w, vbase): i64 {
    var shcode = 0x8B0B018C; var incr = 0x9100416B;   # w==1: add x12,x11,lsl#0 ; add x11,#16
    if (w == 2) { shcode = 0x8B0B058C; incr = 0x9100216B; }   # lsl#1 ; +8
    if (w == 4) { shcode = 0x8B0B098C; incr = 0x9100116B; }   # lsl#2 ; +4
    if (w == 8) { shcode = 0x8B0B0D8C; incr = 0x9100096B; }   # lsl#3 ; +2
    var opword = 0;
    if (op == 0) {   # add v0.T, v0.T, v1.T
        if (w == 1) { opword = 0x4E218400; }
        if (w == 2) { opword = 0x4E618400; }
        if (w == 4) { opword = 0x4EA18400; }
        if (w == 8) { opword = 0x4EE18400; }
    }
    if (op == 1) {   # sub v0.T, v0.T, v1.T
        if (w == 1) { opword = 0x6E218400; }
        if (w == 2) { opword = 0x6E618400; }
        if (w == 4) { opword = 0x6EA18400; }
        if (w == 8) { opword = 0x6EE18400; }
    }
    var i64mul = 0;
    if (op == 2) {   # mul — MUL .8h/.4s for i16/i32; i64 synthesized below; i8 hard-errors
        if (w == 2) { opword = 0x4E619C00; }
        if (w == 4) { opword = 0x4EA19C00; }
        if (w == 1) { ERR_MSG(S, "packed integer mul is i16/i32/i64 only", 38); }
        if (w == 8) { i64mul = 1; }   # NEON has no .2d integer mul — see the inline synthesis
    }
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    EFLLOAD(S, vbase + 1);            # a
    EW(S, 0xAA0003EC); EW(S, shcode); EW(S, 0x3DC00180);   # mov x12,x0 ; add x12,x11,lsl ; ldr q0
    EFLLOAD(S, vbase + 2);            # b
    EW(S, 0xAA0003EC); EW(S, shcode); EW(S, 0x3DC00181);   # ldr q1, [x12]
    if (i64mul == 1) {
        # v6.4.53: NEON has no .2d integer multiply, so do the two i64 lanes as scalar
        # GPR products (exact for the low 64 bits — signed==unsigned in two's complement).
        # Extract a/b lanes → x13/x14/x15/x9, mul, reinsert into v0. Those GPRs are dead
        # before the dst store (loop state is x10=n, x11=index). All 8 words llvm-mc-verified.
        EW(S, 0x4E083C0D);            # umov x13, v0.d[0]  (a_lo)
        EW(S, 0x4E183C0E);            # umov x14, v0.d[1]  (a_hi)
        EW(S, 0x4E083C2F);            # umov x15, v1.d[0]  (b_lo)
        EW(S, 0x4E183C29);            # umov x9,  v1.d[1]  (b_hi)
        EW(S, 0x9B0F7DAD);            # mul  x13, x13, x15 (a_lo*b_lo)
        EW(S, 0x9B097DCE);            # mul  x14, x14, x9  (a_hi*b_hi)
        EW(S, 0x4E081DA0);            # ins  v0.d[0], x13
        EW(S, 0x4E181DC0);            # ins  v0.d[1], x14
    } else {
        EW(S, opword);               # v0.T = v0.T {add,sub,mul} v1.T
    }
    EFLLOAD(S, vbase);               # dst
    EW(S, 0xAA0003EC); EW(S, shcode); EW(S, 0x3D800180);   # str q0, [x12]
    EW(S, incr);                     # add x11, x11, #(16/w lanes)
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# SIMD Phase 5 (v6.4.30) — int8 widening dot (b1.58 ML inner loop): sum(a_u8[i] * b_i8[i]) → i32,
# sign-extended into x0. NEON: widen each 16-byte chunk to i16 (uxtl a → u16 which is always
# positive so signed math is exact; sxtl b → i16), then signed smlal (i16*i16→i32) accumulates
# into v16.4s; tail `addv` reduces the 4 lanes + `sxtw` sign-extends. Matches x86's
# pmaddubsw+pmaddwd (unsigned activations · signed weights). Slots: vbase=a(u8), +1=b(i8); n in x0.
fn EMIT_IVEC_DP8(S, vbase): i64 {
    EW(S, 0x4F000410);                # movi v16.4s, #0 — i32 accumulator
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index (bytes; w=1)
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    EFLLOAD(S, vbase);                # a (u8)
    EW(S, 0xAA0003EC); EW(S, 0x8B0B018C); EW(S, 0x3DC00180);   # add x12,x11,lsl#0 ; ldr q0
    EFLLOAD(S, vbase + 1);            # b (i8)
    EW(S, 0xAA0003EC); EW(S, 0x8B0B018C); EW(S, 0x3DC00181);   # ldr q1
    EW(S, 0x2F08A402);                # uxtl  v2.8h, v0.8b   (a lo → u16)
    EW(S, 0x6F08A403);                # uxtl2 v3.8h, v0.16b  (a hi → u16)
    EW(S, 0x0F08A424);                # sxtl  v4.8h, v1.8b   (b lo → i16)
    EW(S, 0x4F08A425);                # sxtl2 v5.8h, v1.16b  (b hi → i16)
    EW(S, 0x0E648050);                # smlal  v16.4s, v2.4h, v4.4h  (+= a*b, i32)
    EW(S, 0x4E648050);                # smlal2 v16.4s, v2.8h, v4.8h
    EW(S, 0x0E658070);                # smlal  v16.4s, v3.4h, v5.4h
    EW(S, 0x4E658070);                # smlal2 v16.4s, v3.8h, v5.8h
    EW(S, 0x9100416B);                # add x11, x11, #16
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EW(S, 0x4EB1BA00);                # addv s0, v16.4s — horizontal add 4×i32 → s0
    EW(S, 0x1E260000);                # fmov w0, s0
    EW(S, 0x93407C00);                # sxtw x0, w0 — sign-extend i32 sum → i64
    return 0;
}
# 256-bit AVX2 f32v8 is x86-only; aarch64 has no 256-bit register. These stay STUBS on
# aarch64 and are NEVER reached: on aarch64 the lib/simd.cyr f32v8 wrappers take the
# 2×128-bit fallback (f32v_*(n=8) → EMIT_F32V_LOOP, real NEON as of Phase 5 v6.4.28), so
# f32v8 works on aarch64 without a native 256-bit path (v6.4.29 — un-XFAIL'd simd_f32v8).
# The stubs remain only for symbol resolution (the wrappers reference them before the
# runtime AVX2 gate picks the fallback).
# v6.5.24 — f64v4 (256-bit ymm on x86) has no aarch64 analogue: NEON vectors are 128-bit.
# DELEGATE to the NEON f64v loop, which iterates `n` two lanes at a time and produces the
# CORRECT result, just without the 4-lane stride.
# ⚠ A `return 0;` stub would ALSO be safe here for the same reason the F32V8 stubs above
# are (lib/simd.cyr's f64v4 wrappers gate on simd_has_avx2(), which returns 0 on every
# non-x86 target, so these are never reached at runtime). Delegating anyway is
# belt-and-braces: it means that IF a future caller ever reaches this emitter without the
# gate, it computes the right answer instead of silently doing nothing — the failure mode
# the cx multi-return stubs had at v6.5.21 (compiles clean, runs clean, wrong answer, zero
# diagnostics). Cheap insurance, not a claim that the F32V8 stubs are buggy.
fn EMIT_F64V4_LOOP(S, op, vbase): i64 { EMIT_F64V_LOOP(S, op, vbase); return 0; }
# v6.5.38: 256-bit fmadd has no meaning off x86 — delegate to the 128-bit emitter, exactly as
# EMIT_F64V4_LOOP above does. The lib wrapper gates on simd_has_avx2(), which is x86-only, so
# this path is unreachable in practice; it exists so every fork links and so a future arch with
# 256-bit vectors has one obvious place to specialise.
fn EMIT_F64V4_FMADD(S, vbase): i64 { EMIT_F64V_FMADD(S, vbase); return 0; }
fn EMIT_F64V4_UNARY(S, op, vbase): i64 { EMIT_F64V_UNARY(S, op, vbase); return 0; }
fn EMIT_F64V4_SCALE(S, vbase): i64 { EMIT_F64V_SCALE(S, vbase); return 0; }
fn EMIT_F64V4_DOT(S, vbase): i64 { EMIT_F64V_DOT(S, vbase); return 0; }
fn EMIT_F32V8_LOOP(S, op, vbase): i64 { return 0; }
fn EMIT_F32V8_FMADD(S, vbase): i64 { return 0; }
fn EMIT_F32V8_DOT(S, vbase): i64 { return 0; }
fn EMIT_F64V_LOOP(S, op, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index = 0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done (patched later)
    # v0 = a[index..index+1]
    EFLLOAD(S, vbase + 1);            # x0 = a base
    EW(S, 0xAA0003EC);                # mov x12, x0
    EW(S, 0x8B0B0D8C);                # add x12, x12, x11, lsl #3
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # v1 = b[index..index+1]
    EFLLOAD(S, vbase + 2);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    # NEON op: f{add,sub,mul,div} v0.2d, v0.2d, v1.2d
    if (op == 0) { EW(S, 0x4E61D400); }
    if (op == 1) { EW(S, 0x4EE1D400); }
    if (op == 2) { EW(S, 0x6E61DC00); }
    if (op == 3) { EW(S, 0x6E61FC00); }
    # dst[index..index+1] = v0
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

fn EMIT_F64V_UNARY(S, op, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0
    EW(S, 0xD280000B);                # movz x11, #0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # v0 = src[index..index+1]
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # NEON unary: fsqrt or fabs v0.2d, v0.2d
    if (op == 0) { EW(S, 0x6EE1F800); }
    if (op == 1) { EW(S, 0x4EE0F800); }
    # dst[index..index+1] = v0
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

fn EMIT_F64V_FMADD(S, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0
    EW(S, 0xD280000B);                # movz x11, #0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # FMLA v0.2d, v1.2d, v2.2d computes v0 = v0 + v1*v2.
    # We want dst = a*b + c, so load c → v0, a → v1, b → v2.
    # v0 = c
    EFLLOAD(S, vbase + 3);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # v1 = a
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    # v2 = b
    EFLLOAD(S, vbase + 2);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00182);                # ldr q2, [x12]
    # fmla v0.2d, v1.2d, v2.2d
    EW(S, 0x4E62CC20);
    # dst = v0
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v5.10.17 — keystone primitives for hisab gap-close.
# Same ordering as x86: dot returns f64 in x0, scale + axpy take
# scalar at slot vbase+2.

# EMIT_F64V_DOT(S, vbase) — sum of a[i] * b[i].
# Slots: vbase=a, vbase+1=b. n in x0.
# Returns f64 bit pattern in x0.
# Strategy: v2 holds 2-wide running sum via fmla; tail uses faddp
# (NEON pairwise add) to reduce to a scalar in d0; fmov x0, d0.
fn EMIT_F64V_DOT(S, vbase): i64 {
    EW(S, 0x6E221C42);                # eor v2.16b, v2.16b, v2.16b — zero accumulator
    EW(S, 0xAA0003EA);                # mov x10, x0   — n
    EW(S, 0xD280000B);                # movz x11, #0  — index
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # v0 = a[i..i+1]
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # v1 = b[i..i+1]
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    # fmla v2.2d, v0.2d, v1.2d  — v2 += v0 * v1
    EW(S, 0x4E61CC02);
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    # faddp d0, v2.2d  — d0 = v2[0] + v2[1] (horizontal reduce)
    EW(S, 0x7E70D840);
    # fmov x0, d0  — extract f64 bit pattern into x0
    EW(S, 0x9E660000);
    return 0;
}

# EMIT_F64V_SCALE(S, vbase) — dst[i] = a[i] * scalar.
# Slots: vbase=dst, vbase+1=a, vbase+2=scalar (f64 bit pattern). n in x0.
# Pre-loop: load scalar bits → x0, fmov d3 ← x0, dup v3.2d, v3.d[0]
# (broadcast across both lanes). Loop: ldr q0, fmul, str q0.
fn EMIT_F64V_SCALE(S, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0  — n SAVED before clobber
    # x0 = scalar bits
    EFLLOAD(S, vbase + 2);
    EW(S, 0x9E670003);                # fmov d3, x0
    EW(S, 0x4E080463);                # dup v3.2d, v3.d[0]
    EW(S, 0xD280000B);                # movz x11, #0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # v0 = a[i..i+1]
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # fmul v0.2d, v0.2d, v3.2d  — v0 *= scalar
    EW(S, 0x6E63DC00);
    # store v0 to dst[i..i+1]
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# EMIT_F64V_AXPY(S, vbase) — y[i] += alpha * x[i].
# Slots: vbase=y, vbase+1=x, vbase+2=alpha. n in x0.
# Uses FMLA — fused multiply-add, single-instruction y += x*alpha.
fn EMIT_F64V_AXPY(S, vbase): i64 {
    EW(S, 0xAA0003EA);                # mov x10, x0  — save n
    EFLLOAD(S, vbase + 2);
    EW(S, 0x9E670003);                # fmov d3, x0  — alpha bits → d3
    EW(S, 0x4E080463);                # dup v3.2d, v3.d[0]
    EW(S, 0xD280000B);                # movz x11, #0
    var loop_top = GCP(S);
    EW(S, 0xEB0A017F);                # cmp x11, x10
    var done_patch = GCP(S);
    EW(S, 0x5400000A);                # b.ge done
    # v0 = y[i..i+1]  (FMLA accumulates into v0)
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00180);                # ldr q0, [x12]
    # v1 = x[i..i+1]
    EFLLOAD(S, vbase + 1);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3DC00181);                # ldr q1, [x12]
    # fmla v0.2d, v1.2d, v3.2d  — v0 = v0 + v1 * v3 = y + x * alpha
    EW(S, 0x4E63CC20);
    # store v0 back to y[i..i+1]
    EFLLOAD(S, vbase);
    EW(S, 0xAA0003EC);
    EW(S, 0x8B0B0D8C);
    EW(S, 0x3D800180);                # str q0, [x12]
    EW(S, 0x9100096B);                # add x11, x11, #2
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v6.5.35 — stub. `RA_SCAN_LOOPS` really lives in src/backend/x86/decode.cyr, which this
# fork does not include; `parse_fn.cyr` is shared by every fork and calls it. Returning -1
# means "no loop information", which the caller must already handle by falling back to the
# conservative whole-function interval extent — so the picker behaves exactly as it did
# before v6.5.35 here. (The x86 regalloc post-pass does not run on these targets anyway;
# this exists so the shared frontend RESOLVES, the same reason the E*_PE reroutes carry
# return-0 stubs in these two files.)
fn RA_SCAN_LOOPS(base, lo, hi, out_t, out_s, cap): i64 { return 0 - 1; }
