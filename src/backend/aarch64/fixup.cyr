# ================================================================
# AARCH64 FIXUP + ELF EMISSION
# ================================================================
# Patches MOVZ/MOVK sequences for variable/string/function addresses.
# Emits aarch64 ELF64 binary (e_machine=0xB7=183).

# _env_scratch, _read_env, _prof_clock_ns moved to
# src/backend/common/runtime.cyr at v6.0.8 (shared with x86).

# _emit_fmt hoisted to src/backend/common/runtime.cyr at v6.1.4 (shared with
# x86 now that _TARGET_* live in runtime.cyr). _entry_base below stays per-
# backend — aarch64's entry VAs differ from x86's. See CHANGELOG [6.1.4].

# Entry virtual address for the active (format, kmode) combination. Mach-O
# ARM64 overrides kmode; the 16-byte kernel preamble stays a FIXUP-local
# modifier (added to dbase there, not part of the entry base). Byte-identical
# to the pre-v6.0.89 inline ladder.
fn _entry_base(S): i64 {
    if (_emit_fmt(S) == 2) { return 0x100004000; }   # Mach-O ARM64: TEXT_BASE + 16384
    if (L64(S + 0x18FCA0) == 1) { return 0x40000078; }   # kernel
    return 0x400078;
}

fn FIXUP(S): i64 {
    # Check for Mach-O ARM64 output mode
    var _ma_env = _read_env("CYRIUS_MACHO_ARM");
    if (_ma_env != 0) {
        if (load8(_ma_env) == 49 && load8(_ma_env + 1) == 0) {
            _TARGET_MACHO = 2;
        }
    }
    var fx_dbg = 0;
    var fx_dbg_env = _read_env("CYRIUS_DEBUG_PHASES");
    if (fx_dbg_env != 0) {
        if (load8(fx_dbg_env) == 49 && load8(fx_dbg_env + 1) == 0) { fx_dbg = 1; }
    }
    if (fx_dbg == 1) { syscall(SYS_WRITE, 2, "[phase] aarch64 FIXUP entry\n", 28); }
    var cp = GCP(S);
    # v6.0.64: round the code size to 8 (was 4) so the var-area base
    # (entry + acp for the global-addr fixups; 0x400000 + bss_foff in EMITELF)
    # is 8-byte aligned. aarch64 ldxr/stxr — used by atomic_cas on a GLOBAL
    # (e.g. lib/alloc.cyr's _alloc_lock) — FAULT with SIGBUS on a 4-aligned
    # address even where plain access is permitted. x86 fixup.cyr already
    # rounds code to 8 for the same reason. SCP stores it so EMITELF /
    # EMITELF_KERNEL / EMITMACHO_ARM64 and the dbase fixups all read one
    # consistent size via GCP; the <=4 extra .text pad bytes are zero and
    # never executed (entry + branches stay within the real code). See CHANGELOG [6.0.64].
    cp = (cp + 7) & (0 - 8);
    SCP(S, cp);
    var acp = cp;
    var kmode = L64(S + 0x18FCA0);
    # v6.0.89: entry VA via _entry_base / _emit_fmt (was a raw-flag ladder
    # duplicated against EMITELF's dispatch). Mach-O ARM64 overrides kmode;
    # the 16-byte kernel preamble stays a FIXUP-local modifier on dbase.
    # Byte-identical to the prior ladder.
    var entry = _entry_base(S);
    var preamble = 0;
    if (kmode == 1) { preamble = 16; }
    var dbase = entry + preamble + acp;
    var vcnt = GVCNT(S);
    var totvar = 0;
    var vi = 0;
    # v5.11.64: also populate the stable gvar_byte_off mirror so the
    # EMIT_* paths can patch static-init literal values at the correct
    # offset (see _EMIT_GVAR_STATIC_INITS in src/common/util.cyr).
    while (vi < vcnt) {
        S64(S + 0x1B0000 + vi * 8, totvar);
        totvar = totvar + L64(S + 0x12A000 + vi * 8);
        vi = vi + 1;
    }
    # v5.11.59: undef-fn check relocated below the fixup patch loop
    # so the new aarch64 DCE pass can populate live[] first and the
    # check can suppress warnings for fixups whose host fn is
    # unreachable from entry. Cross-arch parity with x86 (same slot,
    # per feedback_cross_arch_propagation_mandatory). The aarch64
    # DCE pass below is NEW infrastructure mirroring x86's seed +
    # propagate passes with aarch64 BL/B (4-byte fixed-width)
    # opcodes. See CHANGELOG [5.11.59].
    var undef_count = 0;
    var fcnt_pre = GFCNT(S);
    # Warning only — don't abort (partial includes are common in test files)
    var fcnt = GFCNT(S);
    var fi = 0;
    while (fi < fcnt) {
        var faddr = S + 0x107B000 + fi * 16;
        var coff = L64(faddr);
        var raw = L64(faddr + 8);
        var ftype = raw >> 56;
        var idx = raw & 0x00FFFFFFFFFFFFFF;
        if (ftype == 2) {
            # Function call: patch BL rel26
            var target = L64(S + 0x9CA000 + idx * 8);
            # v5.6.29-1: undef-fn sentinel — see x86 fixup.cyr:217 for the
            # full rationale (sandhi M2 silent-loop incident). aarch64 form:
            # replace the 4-byte BL with `UDF #0` (0x00000000), which is
            # the architecture's permanently-undefined encoding → SIGILL.
            if (target < 0) {
                var pu = S + 0x41A000 + coff;
                S64(pu, (L64(pu) >> 32 << 32) | 0);
            } else {
                var rel = (target - coff) / 4;
                var pa = S + 0x41A000 + coff;
                var insn = 0x94000000 | (rel & 0x3FFFFFF);
                S64(pa, (L64(pa) >> 32 << 32) | (insn & 0xFFFFFFFF));
            }
        }
        else { if (ftype == 3) {
                # Function address (the `&fn_name` and closure-literal
                # paths in parse_expr.cyr). ftype 3 is the function-
                # pointer counterpart to ftype 0 (var address).
                #   Linux aarch64 → 3-instruction MOVZ/MOVK chain (12 B),
                #     patched absolute by FIXUP_MOV.
                #   Mach-O ARM     → 2-instruction ADRP+ADD pair (8 B),
                #     patched PC-relative by FIXUP_ADRP_ADD. Required
                #     for PIE/ASLR — Apple Silicon enforces MH_PIE,
                #     dyld slides the whole image at load and absolute
                #     addresses (MOVZ-chain) point past `__text` at
                #     runtime. (v5.9.39 Bug B fix; v5.9.38 shipped the
                #     `lib/fnptr.cyr` macOS-branch companion as Fix A.)
                var ftarget = L64(S + 0x9CA000 + idx * 8) + entry;
                if (_TARGET_MACHO == 2) { FIXUP_ADRP_ADD(S, coff, ftarget); }
                else { FIXUP_MOV(S, coff, ftarget); }
            }
            else { if (ftype == 4) {
                    # Tail call: patch B rel26 (not BL — no link register update)
                    var target = L64(S + 0x9CA000 + idx * 8);
                    # v5.6.29-1: undef sentinel → UDF #0 (see ftype==2 above).
                    if (target < 0) {
                        var pu4 = S + 0x41A000 + coff;
                        S64(pu4, (L64(pu4) >> 32 << 32) | 0);
                    } else {
                        var rel = (target - coff) / 4;
                        var pa = S + 0x41A000 + coff;
                        var insn = 0x14000000 | (rel & 0x3FFFFFF);
                        S64(pa, (L64(pa) >> 32 << 32) | (insn & 0xFFFFFFFF));
                    }
                }
                else { if (ftype == 1) {
                        # String address: Linux flat layout vs Mach-O ARM __cstring section.
                        var saddr = dbase + totvar + idx;
                        if (_TARGET_MACHO == 2) { saddr = entry + acp + idx; }
                        if (_TARGET_MACHO == 2) { FIXUP_ADRP_ADD(S, coff, saddr); }
                        else { FIXUP_MOV(S, coff, saddr); }
                    }
                    else { if (ftype == 5) {
                            # Mach-O arm64 __got reference. idx = slot number.
                            # __got sits at the start of __DATA_CONST, which follows __TEXT
                            # in VM. Layout matches EMITMACHO_ARM64's computation in
                            # ftype=0 variable-address path (must stay in lockstep).
                            var gfspos = GSPOS(S);
                            var gfts = acp + gfspos;
                            var gfp = 1;
                            if (gfts > 0) {
                                gfp = (gfts + 16384 - 1) / 16384;
                                if (gfp < 1) { gfp = 1; }
                            }
                            var got_addr = 0x100000000 + (1 + gfp) * 16384 + idx * 8;
                            # Slot 0 is page-aligned — the ADD's imm12 ends up 0, which
                            # coincides with the LDR's imm12 at rest. Non-zero slots need
                            # FIXUP_ADRP_LDR because the LDR encodes imm12 scaled by 8
                            # (offset = imm12 * 8 for the 64-bit LDR variant); feeding
                            # an ADD-style low12 in would multiply the intended offset
                            # by 8 at load time.
                            if (idx == 0) { FIXUP_ADRP_ADD(S, coff, got_addr); }
                            else { FIXUP_ADRP_LDR(S, coff, got_addr); }
                        }
                        else {
                            var cumul = 0;
                            vi = 0;
                            while (vi < idx) {
                                cumul = cumul + L64(S + 0x12A000 + vi * 8);
                                vi = vi + 1;
                            }
                            # Variable address: Linux flat layout vs Mach-O ARM __DATA segment.
                            # Mach-O arm64 layout (v5.5.12+):
                            #   page 0              headers
                            #   page 1..mfp         __TEXT content (code + __cstring)
                            #   page 1+mfp          __DATA_CONST (__got, 1 page; added v5.5.12)
                            #   page 2+mfp..        __DATA (globals)
                            # Must stay in lockstep with EMITMACHO_ARM64. Pre-v5.5.12 the
                            # formula was (1 + mfp) × PAGE; the +1 below is the __DATA_CONST
                            # page inserted between __TEXT and __DATA.
                            var vaddr = dbase + cumul;
                            if (_TARGET_MACHO == 2) {
                                var mfspos = GSPOS(S);
                                var mfts = acp + mfspos;
                                var mfp = 1;
                                if (mfts > 0) {
                                    mfp = (mfts + 16384 - 1) / 16384;
                                    if (mfp < 1) { mfp = 1; }
                                }
                                vaddr = 0x100000000 + (2 + mfp) * 16384 + cumul;
                            }
                            if (_TARGET_MACHO == 2) { FIXUP_ADRP_ADD(S, coff, vaddr); }
                            else { FIXUP_MOV(S, coff, vaddr); }
                        } } } } }
        fi = fi + 1;
    }
    if (fx_dbg == 1) { syscall(SYS_WRITE, 2, "[phase] aarch64 reloc-loop done\n", 32); }
    # ================================================================
    # v5.11.59: DCE-aware reachability pass (cross-arch parity with
    # x86 fixup.cyr line 325-681). Mirrors the x86 mark-and-sweep
    # algorithm: build live[] bitmap by byte-scanning BL/B control
    # transfers, BFS-propagate from entry roots, then optionally
    # NOP-fill dead bodies gated on CYRIUS_DCE=1.
    #
    # aarch64 specifics vs x86:
    #   - 4-byte fixed instruction width (no length decoder needed).
    #   - BL (call):  top 6 bits 100101 → b3 mask `& 0xFC == 0x94`.
    #   - B  (jump):  top 6 bits 000101 → b3 mask `& 0xFC == 0x14`.
    #   - rel26 sign-extend + shift-left-2 for byte offset.
    #   - Target byte = scn + rel (vs x86's scn + 5 + rel32).
    #   - RET = 0xD65F03C0 (safety sentinel for sweep — must precede
    #     dead-fn slot OR be the dead-fn's own last instruction).
    #   - NOP = 0xD503201F (fill word).
    # ================================================================
    # v6.0.4: fn count is GFNC (0x18DA00), NOT GFCNT (fixup count,
    # 0x18FCA8). This pass walks the fn_start table (0x9CA000) and
    # builds an 8192-slot hash; feeding the larger fixup count made
    # `while (sh_i < fnc)` insert > 8192 entries → the uncapped
    # open-addressing probe never found an empty slot → infinite loop
    # (kybernet aarch64 cross-build hang, issue 2026-05-20). Also
    # corrupted reachability (iterating garbage fn slots). x86 always
    # used GFNC here. See CHANGELOG [6.0.4].
    var fnc = GFNC(S);
    var dce_enabled = 0;
    var dce_env = _read_env("CYRIUS_DCE");
    if (dce_env != 0) {
        if (load8(dce_env) == 49 && load8(dce_env + 1) == 0) { dce_enabled = 1; }
    }
    var dce_verbose = 0;
    var dce_verbose_env = _read_env("CYRIUS_DCE_VERBOSE");
    if (dce_verbose_env != 0) {
        if (load8(dce_verbose_env) == 49 && load8(dce_verbose_env + 1) == 0) { dce_verbose = 1; }
    }
    # v6.0.4: CYRIUS_DEBUG_PHASES=1 emits DCE-pass progress markers to
    # stderr to localize the kybernet aarch64 hang (issue 2026-05-20).
    # Env-gated → self-host byte-identical (unset during verify).
    var dce_dbg = 0;
    var dce_dbg_env = _read_env("CYRIUS_DEBUG_PHASES");
    if (dce_dbg_env != 0) {
        if (load8(dce_dbg_env) == 49 && load8(dce_dbg_env + 1) == 0) { dce_dbg = 1; }
    }
    # live[i] = 1 iff fn i is reachable from entry. 1024 bytes × 8
    # bits = 8192 fn cap, matching the parse_fn.cyr REGFN ceiling.
    # v6.0.4: was 512/4096 — a >4096-fn unit overflowed live[] with an
    # OOB stack write (latent on both arches). See CHANGELOG [6.0.4].
    var live[1024];
    var ci = 0;
    while (ci < 1024) { store8(&live + ci, 0); ci = ci + 1; }
    # Build fn_start → fi+1 hash table at 0x114000 (16 KB region
    # shared with x86 path; verified unused on aarch64 by reading
    # x86 fixup.cyr's v5.10.41 comment). Knuth golden-ratio
    # multiplicative hash; load factor 0.5 at 4096 fns → avg <2
    # probes. Region zero-init from prior heap state isn't
    # guaranteed; explicit per-slot reset.
    var sh_clr = 0;
    while (sh_clr < 8192) {
        store16(S + 0x114000 + sh_clr * 2, 0);
        sh_clr = sh_clr + 1;
    }
    var sh_i = 0;
    while (sh_i < fnc) {
        var sh_start = L64(S + 0x9CA000 + sh_i * 8);
        if (sh_start >= 0) {
            var sh_h = (sh_start * 0x9E3779B97F4A7C15) >> 16;
            var sh_slot = sh_h & 8191;
            while (load16(S + 0x114000 + sh_slot * 2) != 0) {
                sh_slot = (sh_slot + 1) & 8191;
            }
            store16(S + 0x114000 + sh_slot * 2, sh_i + 1);
        }
        sh_i = sh_i + 1;
    }
    # Type-3 address-of fixups are conservative roots: fn pointers
    # can dispatch indirectly in ways the static call graph misses.
    var t3i = 0;
    while (t3i < fcnt_pre) {
        var t3a = S + 0x107B000 + t3i * 16;
        var t3r = L64(t3a + 8);
        if ((t3r >> 56) == 3) {
            var t3idx = t3r & 0x00FFFFFFFFFFFFFF;
            if (t3idx < 8192) {
                store8(&live + (t3idx >> 3), load8(&live + (t3idx >> 3)) | (1 << (t3idx & 7)));
            }
        }
        t3i = t3i + 1;
    }
    # Seed pass: scan emitted bytes for BL/B (4-byte stride).
    # Classify by host fn; mark targets live when host is entry
    # (outside all fn bodies). Like x86, this over-approximates
    # (intra-fn B jumps that happen to target a fn_start are kept
    # alive — safe for DCE).
    var b_base = S + 0x41A000;
    if (dce_dbg == 1) {
        syscall(SYS_WRITE, 2, "[dce] aarch64 seed begin fnc=", 29);
        PRNUM(fnc);
        syscall(SYS_WRITE, 2, " acp=", 5);
        PRNUM(acp);
        syscall(SYS_WRITE, 2, "\n", 1);
    }
    var scn = 0;
    while (scn + 4 <= acp) {
        var insn = load32(b_base + scn);
        var op_hi = (insn >> 24) & 0xFF;
        var is_bl = 0;
        var is_b = 0;
        if ((op_hi & 0xFC) == 0x94) { is_bl = 1; }
        if ((op_hi & 0xFC) == 0x14) { is_b = 1; }
        if (is_bl == 1 || is_b == 1) {
            var imm26 = insn & 0x3FFFFFF;
            if (imm26 >= 0x2000000) { imm26 = imm26 - 0x4000000; }
            var tgt = scn + imm26 * 4;
            if (tgt >= 0 && tgt < acp) {
                # v6.1.5: probe + host-scan hoisted to common/runtime.cyr
                # (_dce_hash_lookup / _dce_host_fn) — byte-identical, shared
                # with the x86 backend (arch delta is only the BL/B scan above).
                var fnhit = _dce_hash_lookup(S, tgt);
                if (fnhit >= 0) {
                    # Host = fn containing scn. If none → entry = ROOT.
                    var host = _dce_host_fn(S, scn, fnc);
                    if (host < 0) {
                        store8(&live + (fnhit >> 3), load8(&live + (fnhit >> 3)) | (1 << (fnhit & 7)));
                    }
                }
            }
        }
        scn = scn + 4;
    }
    if (dce_dbg == 1) { syscall(SYS_WRITE, 2, "[dce] aarch64 seed done\n", 24); }
    # Propagate: for each live fn, scan its body for BL/B and mark
    # targets live. Fixpoint loop.
    var changed = 1;
    var iters = 0;
    while (changed == 1 && iters < 512) {
        changed = 0;
        iters = iters + 1;
        if (dce_dbg == 1) {
            syscall(SYS_WRITE, 2, "[dce] aarch64 prop iter=", 24);
            PRNUM(iters);
            syscall(SYS_WRITE, 2, "\n", 1);
        }
        var pfi = 0;
        while (pfi < fnc) {
            var phl = load8(&live + (pfi >> 3)) & (1 << (pfi & 7));
            if (phl != 0) {
                var pfs = L64(S + 0x9CA000 + pfi * 8);
                var pfe = GFNE(S, pfi);
                if (pfs >= 0 && pfe > pfs) {
                    var pscn = pfs;
                    while (pscn + 4 <= pfe) {
                        var pinsn = load32(b_base + pscn);
                        var p_op_hi = (pinsn >> 24) & 0xFF;
                        var p_is_bl = 0;
                        var p_is_b = 0;
                        if ((p_op_hi & 0xFC) == 0x94) { p_is_bl = 1; }
                        if ((p_op_hi & 0xFC) == 0x14) { p_is_b = 1; }
                        if (p_is_bl == 1 || p_is_b == 1) {
                            var pimm26 = pinsn & 0x3FFFFFF;
                            if (pimm26 >= 0x2000000) { pimm26 = pimm26 - 0x4000000; }
                            var ptgt = pscn + pimm26 * 4;
                            if (ptgt >= 0 && ptgt < acp) {
                                # v6.1.5: probe hoisted to common/runtime.cyr
                                # (_dce_hash_lookup) — byte-identical.
                                var phit = _dce_hash_lookup(S, ptgt);
                                if (phit >= 0) {
                                    var prev_live = load8(&live + (phit >> 3)) & (1 << (phit & 7));
                                    if (prev_live == 0) {
                                        store8(&live + (phit >> 3), load8(&live + (phit >> 3)) | (1 << (phit & 7)));
                                        changed = 1;
                                    }
                                }
                            }
                        }
                        pscn = pscn + 4;
                    }
                }
            }
            pfi = pfi + 1;
        }
    }
    if (dce_dbg == 1) {
        syscall(SYS_WRITE, 2, "[dce] aarch64 prop done iters=", 30);
        PRNUM(iters);
        syscall(SYS_WRITE, 2, "\n", 1);
    }
    # Sweep: count dead fns + optionally NOP-fill bodies.
    # Safety check for NOP-fill: the dead-fn body must end with RET
    # (0xD65F03C0) AND the instruction preceding the fn body must
    # also be RET (so control can't fall through). aarch64's fixed
    # 4-byte width removes the x86 decoder-validation step.
    var dead_count = 0;
    var dce_bytes = 0;
    var dwi = 0;
    while (dwi < fnc) {
        var dfoff = L64(S + 0x9CA000 + dwi * 8);
        if (dfoff >= 0) {
            var is_live = load8(&live + (dwi >> 3)) & (1 << (dwi & 7));
            if (is_live == 0) {
                dead_count = dead_count + 1;
                var dfend = GFNE(S, dwi);
                if (dfend > dfoff && dfoff >= 4) {
                    var safe = 0;
                    # (a) Preceding instruction is RET — no fallthrough.
                    if (load32(S + 0x41A000 + dfoff - 4) == 0xD65F03C0) { safe = 1; }
                    # (b) Body ends with RET — combined with the byte-
                    #     scan confirming no callers, no byte executes.
                    if (safe == 0 && dfend >= 4) {
                        if (load32(S + 0x41A000 + dfend - 4) == 0xD65F03C0) { safe = 1; }
                    }
                    if (safe == 1) {
                        dce_bytes = dce_bytes + (dfend - dfoff);
                        if (dce_enabled == 1) {
                            var nop_i = dfoff;
                            while (nop_i + 4 <= dfend) {
                                # Write NOP (0xD503201F) little-endian.
                                store8(S + 0x41A000 + nop_i + 0, 0x1F);
                                store8(S + 0x41A000 + nop_i + 1, 0x20);
                                store8(S + 0x41A000 + nop_i + 2, 0x03);
                                store8(S + 0x41A000 + nop_i + 3, 0xD5);
                                nop_i = nop_i + 4;
                            }
                        }
                    }
                }
            }
        }
        dwi = dwi + 1;
    }
    if (dead_count > 0) {
        syscall(SYS_WRITE, 2, "note: ", 6);
        PRNUM(dead_count);
        syscall(SYS_WRITE, 2, " unreachable fns (", 18);
        PRNUM(dce_bytes);
        if (dce_enabled == 1) {
            syscall(SYS_WRITE, 2, " bytes NOPed)\n", 14);
        } else {
            syscall(SYS_WRITE, 2, " bytes — set CYRIUS_DCE=1 to eliminate, CYRIUS_DCE_VERBOSE=1 to list)\n", 72);
        }
        if (dce_verbose == 1) {
            var dni = 0;
            while (dni < fnc) {
                var dnoff = L64(S + 0x9CA000 + dni * 8);
                if (dnoff >= 0) {
                    var dn_live = load8(&live + (dni >> 3)) & (1 << (dni & 7));
                    if (dn_live == 0) {
                        syscall(SYS_WRITE, 2, "  dead: ", 8);
                        PRSTR(S + 0x60000 + L64(S + 0x9BA000 + dni * 8));
                        syscall(SYS_WRITE, 2, "\n", 1);
                    }
                }
                dni = dni + 1;
            }
        }
    }
    # v5.11.59: reachability-filtered undef-fn check (moved from
    # before the patch loop). Same shape as x86 — locate host fn
    # for each undef'd fixup's coff; skip the warning if host is
    # dead. v5.11.63 added the cross-arch `_strict_mode` parity —
    # `main_aarch64.cyr` declares the global + parses `--strict`
    # from /proc/self/cmdline; the strict-exit below mirrors
    # x86/fixup.cyr lines 729-738 so `cycc_aarch64 --strict` exits
    # with code 1 on any reachable undef ref.
    var u59_ufi = 0;
    while (u59_ufi < fcnt_pre) {
        var u59_ufaddr = S + 0x107B000 + u59_ufi * 16;
        var u59_ucoff = L64(u59_ufaddr);
        var u59_uraw = L64(u59_ufaddr + 8);
        var u59_uftype = u59_uraw >> 56;
        var u59_uidx = u59_uraw & 0x00FFFFFFFFFFFFFF;
        if (u59_uftype == 2 || u59_uftype == 3) {
            var u59_utarget = L64(S + 0x9CA000 + u59_uidx * 8);
            if (u59_utarget == 0 - 1) {
                # v6.1.5: host-scan hoisted to common/runtime.cyr (_dce_host_fn).
                var u59_host = _dce_host_fn(S, u59_ucoff, fnc);
                var u59_skip = 0;
                if (u59_host >= 0) {
                    var u59_lb = load8(&live + (u59_host >> 3)) & (1 << (u59_host & 7));
                    if (u59_lb == 0) { u59_skip = 1; }
                }
                if (u59_skip == 0) {
                    var u59_ufnoff = L64(S + 0x9BA000 + u59_uidx * 8);
                    syscall(SYS_WRITE, 2, "warning: undefined function '", 29);
                    var u59_unptr = S + 0x60000 + u59_ufnoff;
                    var u59_unlen = 0;
                    while (load8(u59_unptr + u59_unlen) != 0) { u59_unlen = u59_unlen + 1; }
                    syscall(SYS_WRITE, 2, u59_unptr, u59_unlen);
                    syscall(SYS_WRITE, 2, "' (call site may be unreachable)\n", 33);
                    undef_count = undef_count + 1;
                }
                S64(S + 0x9CA000 + u59_uidx * 8, 0 - 2);
            }
        }
        u59_ufi = u59_ufi + 1;
    }
    # v5.11.63: --strict parity with x86 (which has had it since
    # v5.4.19). Filtered-out (dead-host) refs above did NOT bump
    # undef_count, so strict mode only fires on reachable undef refs
    # — matching x86's exit-on-strict semantics exactly. `_strict_mode`
    # is declared + cmdline-parsed in `src/main_aarch64.cyr`.
    if (_strict_mode == 1 && undef_count > 0) {
        syscall(SYS_WRITE, 2, "error: --strict: refusing to emit binary with ", 46);
        PRNUM(undef_count);
        syscall(SYS_WRITE, 2, " undefined function(s)\n", 23);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x18FCD0, totvar);
    return 0;
}

# PIE-safe ADRP+ADD patch (Mach-O ARM). Pair at coff:
#   ADRP xN, <page>   (offset +0)  — immhi/immlo hold target-page diff (4KB units)
#   ADD  xN, xN, #lo  (offset +4)  — imm12 holds target address low 12 bits
# Apple Silicon enforces MH_PIE, so absolute addressing (MOVZ/MOVK) is unsafe.
# This pair is PC-relative and survives the ASLR slide.
fn FIXUP_ADRP_ADD(S, coff, addr): i64 {
    var pc = 0x100004000 + coff;
    var pc_page = pc >> 12;
    var target_page = addr >> 12;
    var page_diff = target_page - pc_page;
    var immlo = page_diff & 0x3;
    var immhi = (page_diff >> 2) & 0x7FFFF;
    var adrp_base = S + 0x41A000 + coff;
    var adrp_insn = L64(adrp_base) & 0xFFFFFFFF;
    adrp_insn = (adrp_insn & 0x9F00001F) | (immlo << 29) | (immhi << 5);
    S64(adrp_base, (L64(adrp_base) >> 32 << 32) | (adrp_insn & 0xFFFFFFFF));
    var add_base = S + 0x41A000 + coff + 4;
    var add_insn = L64(add_base) & 0xFFFFFFFF;
    var low12 = addr & 0xFFF;
    add_insn = (add_insn & 0xFFC003FF) | (low12 << 10);
    S64(add_base, (L64(add_base) >> 32 << 32) | (add_insn & 0xFFFFFFFF));
    return 0;
}

# Patch ADRP + LDR (unsigned offset, 64-bit) pair for a PC-relative load.
# Same adrp page-diff patch as FIXUP_ADRP_ADD, but the second instruction
# is `ldr xN, [xN, #imm12]` where imm12 is SCALED by 8 for the 64-bit
# variant. So the encoded imm12 field = (low 12 bits of target) >> 3.
# v5.5.14 uses this for non-zero __got slots; slot 0 still reuses
# FIXUP_ADRP_ADD because its low 12 bits are 0, and 0 in the ADD's
# imm12 field coincides with 0 in the LDR's imm12 field.
fn FIXUP_ADRP_LDR(S, coff, addr): i64 {
    var pc = 0x100004000 + coff;
    var pc_page = pc >> 12;
    var target_page = addr >> 12;
    var page_diff = target_page - pc_page;
    var immlo = page_diff & 0x3;
    var immhi = (page_diff >> 2) & 0x7FFFF;
    var adrp_base = S + 0x41A000 + coff;
    var adrp_insn = L64(adrp_base) & 0xFFFFFFFF;
    adrp_insn = (adrp_insn & 0x9F00001F) | (immlo << 29) | (immhi << 5);
    S64(adrp_base, (L64(adrp_base) >> 32 << 32) | (adrp_insn & 0xFFFFFFFF));
    var ldr_base = S + 0x41A000 + coff + 4;
    var ldr_insn = L64(ldr_base) & 0xFFFFFFFF;
    var scaled = (addr & 0xFFF) >> 3;
    ldr_insn = (ldr_insn & 0xFFC003FF) | (scaled << 10);
    S64(ldr_base, (L64(ldr_base) >> 32 << 32) | (ldr_insn & 0xFFFFFFFF));
    return 0;
}

# Patch a MOVZ+MOVK sequence at codebuf offset with a 48-bit address
# The sequence is 3 instructions (12 bytes):
#   MOVZ xN, #low16          (offset +0)
#   MOVK xN, #mid16, LSL 16  (offset +4)
#   MOVK xN, #hi16, LSL 32   (offset +8)
fn FIXUP_MOV(S, coff, addr): i64 {
    var base = S + 0x41A000 + coff;
    var lo = addr & 0xFFFF;
    var mid = (addr >> 16) & 0xFFFF;
    var hi = (addr >> 32) & 0xFFFF;
    # Read existing instructions to preserve register number
    var insn0 = L64(base) & 0xFFFFFFFF;
    var insn1 = L64(base + 4) & 0xFFFFFFFF;
    var insn2 = L64(base + 8) & 0xFFFFFFFF;
    # Clear imm16 field (bits [20:5]) and set new value
    var mask = 0xFFE0001F;
    insn0 = (insn0 & mask) | (lo << 5);
    insn1 = (insn1 & mask) | (mid << 5);
    insn2 = (insn2 & mask) | (hi << 5);
    S64(base, (L64(base) >> 32 << 32) | (insn0 & 0xFFFFFFFF));
    S64(base + 4, (L64(base + 4) >> 32 << 32) | (insn1 & 0xFFFFFFFF));
    S64(base + 8, (L64(base + 8) >> 32 << 32) | (insn2 & 0xFFFFFFFF));
    return 0;
}

# ================================================================
# ELF EMISSION — aarch64 ELF64
# ================================================================

fn EMITELF(S): i64 {
    # v6.0.89: dispatch on the derived _emit_fmt (same selector _entry_base
    # uses) instead of re-reading the raw _TARGET_MACHO flag.
    if (_emit_fmt(S) == 2) { EMITMACHO_ARM64(S); return 0; }
    if (L64(S + 0x18FCA0) == 1) { EMITELF_KERNEL(S); return 0; }
    var cp = GCP(S);
    var totvar = L64(S + 0x18FCD0);
    var spos = GSPOS(S);
    var filesz = 120 + cp + totvar + spos;
    filesz = (filesz + 7) & (0 - 8);
    var memsz = filesz + 4096;

    # Section header table — v5.11.34 mirror of v5.11.32 (x86 user) and
    # v5.11.30 (aarch64 kernel). Non-loaded metadata past PT_LOAD;
    # 5-section ELF64 (NULL + .text + .rodata + .bss + .shstrtab).
    var text_foff = 120;
    var text_addr = 0x400000 + 120;
    var text_size = cp;
    var bss_foff = 120 + cp;
    var bss_addr = 0x400000 + bss_foff;
    var bss_size = totvar;
    var rod_foff = bss_foff + totvar;
    var rod_addr = 0x400000 + rod_foff;
    var rod_size = spos;
    # .shstrtab: "\0.text\0.rodata\0.bss\0.shstrtab\0" = 30 bytes
    var shstrtab_size = 30;
    var shstrtab_foff = filesz;
    # ELF64 shdrs are 64 bytes each; align table to 8 bytes
    var shdr_off = (shstrtab_foff + shstrtab_size + 7) & (0 - 8);

    var O = S + 0x71A000;
    var op = 0;
    # ELF64 header (64 bytes)
    # e_ident: ELF magic + class64 + LE + version + ELFOSABI_NONE
    S64(O + op, 0x00010102464C457F); op = op + 8;
    S64(O + op, 0x0000000000000000); op = op + 8;
    # e_type=EXEC(2) + e_machine=AARCH64(0xB7=183)
    S64(O + op, 0x0000000100B70002); op = op + 8;
    # e_entry = 0x400078
    S64(O + op, 0x0000000000400078); op = op + 8;
    # e_phoff = 64
    S64(O + op, 0x0000000000000040); op = op + 8;
    # e_shoff (v5.11.34 — was 0)
    S64(O + op, shdr_off); op = op + 8;
    # e_flags=0, e_ehsize=64, e_phentsize=56, e_phnum=1
    S64(O + op, 0x0038004000000000); op = op + 8;
    # e_phnum=1, e_shentsize=64, e_shnum=5, e_shstrndx=4
    # LE byte layout 56..63: 01 00 40 00 05 00 04 00
    S64(O + op, 0x0004000500400001); op = op + 8;
    # Program header (56 bytes)
    S64(O + op, 0x0000000700000001); op = op + 8;
    S64(O + op, 0x0000000000000000); op = op + 8;
    S64(O + op, 0x0000000000400000); op = op + 8;
    S64(O + op, 0x0000000000400000); op = op + 8;
    S64(O + op, filesz); op = op + 8;
    S64(O + op, memsz); op = op + 8;
    S64(O + op, 0x0000000000010000); op = op + 8;
    # Code
    var i = 0;
    while (i < cp) { store8(O + op, load8(S + 0x41A000 + i)); op = op + 1; i = i + 1; }
    # Variable data
    var bss_o = op;
    i = 0;
    while (i < totvar) { store8(O + op, 0); op = op + 1; i = i + 1; }
    # v5.11.64: overwrite static-init slots with their literal values
    _EMIT_GVAR_STATIC_INITS(S, O, bss_o);
    # String data
    i = 0;
    while (i < spos) { store8(O + op, load8(S + 0x21A000 + i)); op = op + 1; i = i + 1; }
    while (op % 8 != 0) { store8(O + op, 0); op = op + 1; }

    # ---- .shstrtab (30 bytes) — "\0.text\0.rodata\0.bss\0.shstrtab\0" ----
    store8(O + op, 0); op = op + 1;
    store8(O + op,     0x2E); store8(O + op + 1, 0x74); store8(O + op + 2, 0x65);
    store8(O + op + 3, 0x78); store8(O + op + 4, 0x74); store8(O + op + 5, 0);
    op = op + 6;
    store8(O + op,     0x2E); store8(O + op + 1, 0x72); store8(O + op + 2, 0x6F);
    store8(O + op + 3, 0x64); store8(O + op + 4, 0x61); store8(O + op + 5, 0x74);
    store8(O + op + 6, 0x61); store8(O + op + 7, 0);
    op = op + 8;
    store8(O + op,     0x2E); store8(O + op + 1, 0x62); store8(O + op + 2, 0x73);
    store8(O + op + 3, 0x73); store8(O + op + 4, 0);
    op = op + 5;
    store8(O + op,     0x2E); store8(O + op + 1, 0x73); store8(O + op + 2, 0x68);
    store8(O + op + 3, 0x73); store8(O + op + 4, 0x74); store8(O + op + 5, 0x72);
    store8(O + op + 6, 0x74); store8(O + op + 7, 0x61); store8(O + op + 8, 0x62);
    store8(O + op + 9, 0);
    op = op + 10;
    while (op % 8 != 0) { store8(O + op, 0); op = op + 1; }

    # ---- Section headers (5 × 64 bytes) ----
    # ELF64 Shdr layout (each 64 bytes):
    #   u32 sh_name; u32 sh_type; u64 sh_flags; u64 sh_addr;
    #   u64 sh_offset; u64 sh_size; u32 sh_link; u32 sh_info;
    #   u64 sh_addralign; u64 sh_entsize;
    # We pack (name|type) into a single 8-byte store.

    # [0] SHT_NULL — 64 zero bytes
    i = 0;
    while (i < 64) { store8(O + op, 0); op = op + 1; i = i + 1; }

    # [1] .text — SHT_PROGBITS, SHF_ALLOC|SHF_EXECINSTR
    S64(O + op, (1 << 32) | 1);   op = op + 8;
    S64(O + op, 6);               op = op + 8;
    S64(O + op, text_addr);       op = op + 8;
    S64(O + op, text_foff);       op = op + 8;
    S64(O + op, text_size);       op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 4);               op = op + 8;
    S64(O + op, 0);               op = op + 8;

    # [2] .rodata — SHT_PROGBITS, SHF_ALLOC
    S64(O + op, (1 << 32) | 7);   op = op + 8;
    S64(O + op, 2);               op = op + 8;
    S64(O + op, rod_addr);        op = op + 8;
    S64(O + op, rod_foff);        op = op + 8;
    S64(O + op, rod_size);        op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 1);               op = op + 8;
    S64(O + op, 0);               op = op + 8;

    # [3] .bss — SHT_NOBITS, SHF_WRITE|SHF_ALLOC
    S64(O + op, (8 << 32) | 15);  op = op + 8;
    S64(O + op, 3);               op = op + 8;
    S64(O + op, bss_addr);        op = op + 8;
    S64(O + op, bss_foff);        op = op + 8;
    S64(O + op, bss_size);        op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 1);               op = op + 8;
    S64(O + op, 0);               op = op + 8;

    # [4] .shstrtab — SHT_STRTAB
    S64(O + op, (3 << 32) | 20);  op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, shstrtab_foff);   op = op + 8;
    S64(O + op, shstrtab_size);   op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 1);               op = op + 8;
    S64(O + op, 0);               op = op + 8;

    while (op % 8 != 0) { store8(O + op, 0); op = op + 1; }
    S64(S + 0x1903F8, op);
    return 0;
}

# Kernel ELF for aarch64: ELF64 at base 0x40000000
# Bootable by: qemu-system-aarch64 -M virt -cpu cortex-a57 -kernel build/agnos_aarch64
# No multiboot (ARM uses device tree). Entry at base + 0x78 (after ELF + PH headers).
# v5.11.30: emit minimal section header table (mirrors the x86 fix in
# 5.11.29) so tools that walk section headers — and any aarch64
# bootloader equivalent to GRUB's `grub_elf64_get_shnum` — accept
# the binary. The PT_LOAD segment is unchanged; section headers
# and .shstrtab sit after `filesz` as non-allocated metadata.
fn EMITELF_KERNEL(S): i64 {
    var cp = GCP(S);
    var totvar = L64(S + 0x18FCD0);
    var spos = GSPOS(S);
    var preamble_sz = 16;
    var filesz = 120 + preamble_sz + cp + totvar + spos;
    filesz = (filesz + 7) & (0 - 8);
    var memsz = filesz + 65536;
    var base = 0x40000000;
    var entry = base + 120;

    # Section layout (loaded segment unchanged):
    #   .text     file 120                  addr base+120  size = preamble + cp
    #             (SP-setup MOVZ/MOVK chain is executable code so it lives in .text)
    #   .bss      file 120+preamble+cp      addr base+...  size = totvar  (NOBITS)
    #   .rodata   file 120+preamble+cp+totvar              size = spos
    var text_foff = 120;
    var text_addr = base + 120;
    var text_size = preamble_sz + cp;
    var bss_foff = 120 + preamble_sz + cp;
    var bss_addr = base + bss_foff;
    var bss_size = totvar;
    var rod_foff = bss_foff + totvar;
    var rod_addr = base + rod_foff;
    var rod_size = spos;
    # .shstrtab: "\0.text\0.rodata\0.bss\0.shstrtab\0" = 30 bytes
    var shstrtab_size = 30;
    var shstrtab_foff = filesz;
    # ELF64 shdrs are 64 bytes each; align table to 8 bytes
    var shdr_off = (shstrtab_foff + shstrtab_size + 7) & (0 - 8);

    var O = S + 0x71A000;
    var op = 0;
    # ELF64 header (64 bytes)
    S64(O + op, 0x00010102464C457F); op = op + 8;
    S64(O + op, 0x0000000000000000); op = op + 8;
    S64(O + op, 0x0000000100B70002); op = op + 8;
    S64(O + op, entry); op = op + 8;
    S64(O + op, 0x0000000000000040); op = op + 8;
    S64(O + op, shdr_off); op = op + 8;
    S64(O + op, 0x0038004000000000); op = op + 8;
    # e_phnum=1, e_shentsize=64, e_shnum=5, e_shstrndx=4
    # LE byte layout 56..63: 01 00 40 00 05 00 04 00
    S64(O + op, 0x0004000500400001); op = op + 8;
    # Program header (56 bytes)
    S64(O + op, 0x0000000700000001); op = op + 8;
    S64(O + op, 0x0000000000000000); op = op + 8;
    S64(O + op, base); op = op + 8;
    S64(O + op, base); op = op + 8;
    S64(O + op, filesz); op = op + 8;
    S64(O + op, memsz); op = op + 8;
    S64(O + op, 0x0000000000010000); op = op + 8;
    # SP setup preamble (16 bytes = 4 instructions)
    # Stack at top of memsz region
    var stack_top = base + memsz;
    var st_lo = stack_top & 0xFFFF;
    var st_mid = (stack_top >> 16) & 0xFFFF;
    var st_hi = (stack_top >> 32) & 0xFFFF;
    # MOVZ x9, #lo
    var sp0 = 0xD2800009 | (st_lo << 5);
    store8(O + op, sp0 & 0xFF); store8(O + op + 1, (sp0 >> 8) & 0xFF);
    store8(O + op + 2, (sp0 >> 16) & 0xFF); store8(O + op + 3, (sp0 >> 24) & 0xFF);
    op = op + 4;
    # MOVK x9, #mid, LSL#16
    var sp1 = 0xF2A00009 | (st_mid << 5);
    store8(O + op, sp1 & 0xFF); store8(O + op + 1, (sp1 >> 8) & 0xFF);
    store8(O + op + 2, (sp1 >> 16) & 0xFF); store8(O + op + 3, (sp1 >> 24) & 0xFF);
    op = op + 4;
    # MOVK x9, #hi, LSL#32
    var sp2 = 0xF2C00009 | (st_hi << 5);
    store8(O + op, sp2 & 0xFF); store8(O + op + 1, (sp2 >> 8) & 0xFF);
    store8(O + op + 2, (sp2 >> 16) & 0xFF); store8(O + op + 3, (sp2 >> 24) & 0xFF);
    op = op + 4;
    # MOV SP, x9  (encoded as: ADD SP, x9, #0 = 0x9100013F)
    store8(O + op, 0x3F); store8(O + op + 1, 0x01); store8(O + op + 2, 0x00); store8(O + op + 3, 0x91);
    op = op + 4;
    # Code
    var i = 0;
    while (i < cp) { store8(O + op, load8(S + 0x41A000 + i)); op = op + 1; i = i + 1; }
    # Variable data
    var bss_o = op;
    i = 0;
    while (i < totvar) { store8(O + op, 0); op = op + 1; i = i + 1; }
    # v5.11.64: overwrite static-init slots with their literal values
    _EMIT_GVAR_STATIC_INITS(S, O, bss_o);
    # String data
    i = 0;
    while (i < spos) { store8(O + op, load8(S + 0x21A000 + i)); op = op + 1; i = i + 1; }
    while (op % 8 != 0) { store8(O + op, 0); op = op + 1; }

    # ---- .shstrtab (30 bytes) — "\0.text\0.rodata\0.bss\0.shstrtab\0" ----
    store8(O + op, 0); op = op + 1;
    store8(O + op,     0x2E); store8(O + op + 1, 0x74); store8(O + op + 2, 0x65);
    store8(O + op + 3, 0x78); store8(O + op + 4, 0x74); store8(O + op + 5, 0);
    op = op + 6;
    store8(O + op,     0x2E); store8(O + op + 1, 0x72); store8(O + op + 2, 0x6F);
    store8(O + op + 3, 0x64); store8(O + op + 4, 0x61); store8(O + op + 5, 0x74);
    store8(O + op + 6, 0x61); store8(O + op + 7, 0);
    op = op + 8;
    store8(O + op,     0x2E); store8(O + op + 1, 0x62); store8(O + op + 2, 0x73);
    store8(O + op + 3, 0x73); store8(O + op + 4, 0);
    op = op + 5;
    store8(O + op,     0x2E); store8(O + op + 1, 0x73); store8(O + op + 2, 0x68);
    store8(O + op + 3, 0x73); store8(O + op + 4, 0x74); store8(O + op + 5, 0x72);
    store8(O + op + 6, 0x74); store8(O + op + 7, 0x61); store8(O + op + 8, 0x62);
    store8(O + op + 9, 0);
    op = op + 10;
    while (op % 8 != 0) { store8(O + op, 0); op = op + 1; }

    # ---- Section headers (5 × 64 bytes) ----
    # ELF64 Shdr layout (each 64 bytes):
    #   u32 sh_name; u32 sh_type; u64 sh_flags; u64 sh_addr;
    #   u64 sh_offset; u64 sh_size; u32 sh_link; u32 sh_info;
    #   u64 sh_addralign; u64 sh_entsize;
    # We pack (name|type) and (link|info) into single 8-byte stores.

    # [0] SHT_NULL — 64 zero bytes
    i = 0;
    while (i < 64) { store8(O + op, 0); op = op + 1; i = i + 1; }

    # [1] .text — SHT_PROGBITS, SHF_ALLOC|SHF_EXECINSTR
    S64(O + op, (1 << 32) | 1);   op = op + 8;
    S64(O + op, 6);               op = op + 8;
    S64(O + op, text_addr);       op = op + 8;
    S64(O + op, text_foff);       op = op + 8;
    S64(O + op, text_size);       op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 4);               op = op + 8;
    S64(O + op, 0);               op = op + 8;

    # [2] .rodata — SHT_PROGBITS, SHF_ALLOC
    S64(O + op, (1 << 32) | 7);   op = op + 8;
    S64(O + op, 2);               op = op + 8;
    S64(O + op, rod_addr);        op = op + 8;
    S64(O + op, rod_foff);        op = op + 8;
    S64(O + op, rod_size);        op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 1);               op = op + 8;
    S64(O + op, 0);               op = op + 8;

    # [3] .bss — SHT_NOBITS, SHF_WRITE|SHF_ALLOC
    S64(O + op, (8 << 32) | 15);  op = op + 8;
    S64(O + op, 3);               op = op + 8;
    S64(O + op, bss_addr);        op = op + 8;
    S64(O + op, bss_foff);        op = op + 8;
    S64(O + op, bss_size);        op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 1);               op = op + 8;
    S64(O + op, 0);               op = op + 8;

    # [4] .shstrtab — SHT_STRTAB
    S64(O + op, (3 << 32) | 20);  op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, shstrtab_foff);   op = op + 8;
    S64(O + op, shstrtab_size);   op = op + 8;
    S64(O + op, 0);               op = op + 8;
    S64(O + op, 1);               op = op + 8;
    S64(O + op, 0);               op = op + 8;

    while (op % 8 != 0) { store8(O + op, 0); op = op + 1; }
    S64(S + 0x1903F8, op);
    return 0;
}
