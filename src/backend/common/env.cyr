# ================================================================
# The compiler's environment reader — shared by EVERY compiler fork.
# ================================================================
# Moved out of src/backend/common/runtime.cyr so the cx driver can include it too:
# main_cx.cyr does NOT include runtime.cyr (it keeps its own RECFIX, with a different
# fixup-table cap and region), and until 6.6.10 it compiled against a `return 0`
# _read_env stub in cx/emit.cyr instead. Every env-gated frontend knob was dead on
# cycc_cx — CYRIUS_ASYNC, CYRIUS_ALLOW_PARENT_INCLUDES, CYRIUS_MONOMORPH,
# CYRIUS_POISON, CYRIUS_STACK_ARRAYS, CYRIUS_DCE, … — and the refusals that NAME one
# ("async fn requires CYRIUS_ASYNC=1", "set CYRIUS_ALLOW_PARENT_INCLUDES=1 to
# permit") told the user to set a variable the compiler could not read.
# Included from runtime.cyr (the x86/aarch64/PE/Mach-O forks) and from main_cx.cyr,
# in both cases AFTER src/common/util.cyr (the macOS arms call util's _macho_x28).
# It needs SYS_OPEN / SYS_READ / SYS_CLOSE from the including driver. CHANGELOG [6.6.10]

# Static scratch for env value (256 bytes).
var _env_scratch[256];

# `_macho_x28()` (the macOS entry-stack base both macOS arms below read) lives in
# src/common/util.cyr, the one module all SEVEN drivers include, which is included
# before this file everywhere. CHANGELOG [6.6.6]

# Read an env var by name. Returns &_env_scratch (NUL-terminated
# value) on hit, 0 on miss — and 0, with a warning naming the variable,
# for a value longer than 255 bytes (refused on every target since
# 6.6.20, never truncated). /proc/self/environ is Linux-only; macOS
# reads the init-stack envp (v6.0.33) and Windows asks kernel32
# (v6.6.6, below). The SYS_OPEN == 2 shim picks the correct Linux
# path: x86_64 uses raw `open` (syscall 2), aarch64 native uses
# `openat(AT_FDCWD, ...)` (-100 first arg).
#
# ⛔ v6.6.6 — WINDOWS WAS STILL RETURNING 0 HERE, FOR EVERY NAME. The comment that
# stood above said the Win lookup was "queued for v5.5.x tail"; the PE reroute it needs
# (0xF015 GetEnvironmentVariableA) shipped at v6.0.85 and this function was never wired
# to it, so `cycc.exe` saw NONE of its own knobs — all 20 of them, derived from the
# `_read_env` call sites reachable from src/main_win.cyr: CYRIUS_STATS, CYRIUS_DCE,
# CYRIUS_DCE_VERBOSE, CYRIUS_DEBUG_PHASES, CYRIUS_DECODE_AUDIT, CYRIUS_SYMS, CYRIUS_WX,
# CYRIUS_IR, CYRIUS_MONOMORPH, CYRIUS_ASYNC, CYRIUS_STACK_ARRAYS, CYRIUS_TYPE_CHECK,
# CYRIUS_FILEID_DUMP, CYRIUS_POISON, CYRIUS_MACHO, CYRIUS_MACHO_ARM, CYRIUS_TARGET_WIN,
# CYRIUS_TARGET_EFI, CYRIUS_ALLOW_PARENT_INCLUDES, CYRIUS_ALLOW_ABSOLUTE_INCLUDES.
# ⭐ THE SHAPE IS THE ONE lib/io.cyr's `getenv` CARRIES A NOTE ABOUT: at v6.5.45 the
# stdlib hit exactly this — "Windows has the reroute but NOTHING IN THE STDLIB CALLED
# IT". The stdlib half was fixed then and the COMPILER half, one call away in this file,
# was not, because each was investigated as its own bug rather than as one class. The
# same gap on macOS was the root of the v5.3.13→v6.0.32 self-host rot.
fn _read_env(name): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    # 6.6.20 — read TO EOF in 4 KB chunks; the FIRST `name=` entry decides. This was ONE
    # 8191-byte read: every entry past that byte was invisible, and the CLI APPENDS the target
    # selectors it injects (CYRIUS_TARGET_WIN, CYRIUS_PIE, CYRIUS_TARGET_AGNOS, CYRIUS_DCE,
    # CYRIUS_KERNEL*, …) after the inherited environment, so in a shell over ~8 KB
    # `cyrius build --win` wrote an ELF and reported OK; an entry straddling the cut was read
    # SHORT (CYRIUS_KERNEL_BASE=0x40000000 linked at 0x400). Same scan shape as
    # `_env_scan_homes` (src/frontend/lex.cyr). CHANGELOG [6.6.20]
    var efd = 0;
    if (SYS_OPEN == 2) { efd = syscall(SYS_OPEN, "/proc/self/environ", 0, 0); }
    else { efd = syscall(SYS_OPEN, 0 - 100, "/proc/self/environ", 0, 0); }
    if (efd < 0) { return 0; }
    var nlen = 0;
    while (load8(name + nlen) != 0) { nlen = nlen + 1; }
    var st[32];
    store64(&st, 0);
    store64(&st + 8, 1);
    store64(&st + 16, 0);
    store64(&st + 24, 0 - 1);
    var ebuf[4096];
    var n = syscall(SYS_READ, efd, &ebuf, 4096);
    while (n > 0 && load64(&st + 24) == 0 - 1) {
        var i = 0;
        while (i < n) {
            _re_step(&st, name, nlen, load8(&ebuf + i));
            i = i + 1;
        }
        n = syscall(SYS_READ, efd, &ebuf, 4096);
    }
    syscall(SYS_CLOSE, efd);
    if (n >= 0) { _re_step(&st, name, nlen, 0); }   # EOF ends an unterminated last entry
    var verdict = load64(&st + 24);
    if (verdict == 1) { return &_env_scratch; }
    if (verdict == 2) { _env_refuse_long(name); }
    return 0;
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    # macOS has no /proc/self/environ. The Mach-O arm64 entry prologue
    # (main_aarch64.cyr v5.5.17) parked argc/argv in x28; on the Darwin
    # stack envp immediately follows argv + its NULL terminator, so
    # envp = argv + (argc+1)*8. Walk the NAME=VALUE entries (the array
    # is NULL-terminated). Without this, _read_env returned 0 on macOS →
    # a natively-running cycc never saw CYRIUS_MACHO_ARM → it built every
    # binary Linux-shaped (no entry prologue, brk heap, no ESYSXLAT) and
    # could not self-host on Apple Silicon. Root cause of the macOS
    # self-host rot v5.3.13 → v6.0.32. See CHANGELOG [6.0.33].
    # v6.0.44: only the arm64 driver parks argv in x28. On x86-macOS there
    # is no argv parking yet, so _macho_x28() would return a stale-register
    # garbage value (e.g. 0x23), which the `m_base == 0` guard does NOT
    # catch → load64(garbage) SIGSEGVs. There's nothing to read on x86
    # macho, so return 0 directly without touching _macho_x28. Guard on the
    # TARGET arch (AARCH64), NOT CYRIUS_ARCH_X86 (the x86 cross-compiler
    # predefines X86 even when building the arm64 cycc). See issue layer 6.
    #ifdef CYRIUS_ARCH_AARCH64
    # arm64: x28 base; argc=[base], argv=[base+8] (a char**); envp follows argv+NULL.
    var m_base = _macho_x28();
    if (m_base == 0) { return 0; }
    var m_argc = load64(m_base);
    var m_argv = load64(m_base + 8);
    var m_envp = m_argv + (m_argc + 1) * 8;
    #else
    # x86-macho (v6.4.59): _macho_x28() returns r15 = the init rsp. The
    # LC_UNIXTHREAD init stack is INLINE — [rsp]=argc, argv[i] at rsp+8+i*8, then a
    # NULL, then envp — so envp = r15 + 8 + (argc+1)*8 (single-deref, unlike the
    # arm64 char** double-deref above). Un-stubs the old `return 0` so native Intel
    # cycc now honors CYRIUS_MONOMORPH / CYRIUS_SYMS / CYRIUS_DCE /
    # CYRIUS_ALLOW_PARENT_INCLUDES. Byte-identical self-host: env unset → the walk
    # below finds nothing → same defaults as the stub.
    var m_base = _macho_x28();
    if (m_base == 0) { return 0; }
    var m_argc = load64(m_base);
    var m_envp = m_base + 8 + (m_argc + 1) * 8;
    #endif
    var m_nlen = 0;
    while (load8(name + m_nlen) != 0) { m_nlen = m_nlen + 1; }
    var m_i = 0;
    var m_e = load64(m_envp);
    while (m_e != 0) {
        # m_e -> "NAME=VALUE\0". Match name then '='.
        if (load8(m_e + m_nlen) == 61) {
            var m_match = 1;
            var m_k = 0;
            while (m_k < m_nlen) {
                if (load8(m_e + m_k) != load8(name + m_k)) { m_match = 0; break; }
                m_k = m_k + 1;
            }
            if (m_match == 1) {
                var m_vs = m_e + m_nlen + 1;
                var m_vl = 0;
                while (load8(m_vs + m_vl) != 0) { m_vl = m_vl + 1; }
                # 6.6.20: refused, as on Linux and Windows — it was cut to 255 B and handed
                # back, so a long CYRIUS_SYMS path wrote the dump over its 255-byte prefix.
                if (m_vl > 255) { _env_refuse_long(name); return 0; }
                var m_ci = 0;
                while (m_ci < m_vl) {
                    store8(&_env_scratch + m_ci, load8(m_vs + m_ci));
                    m_ci = m_ci + 1;
                }
                store8(&_env_scratch + m_vl, 0);
                return &_env_scratch;
            }
        }
        m_i = m_i + 1;
        m_e = load64(m_envp + m_i * 8);
    }
    #endif
    #ifdef CYRIUS_TARGET_WIN
    # Windows has no /proc and no readable init-stack envp — the environment block is
    # the loader's, reached through kernel32. syscall(0xF015, name, buf, size) is the
    # GetEnvironmentVariableA reroute (EGETENV_PE, src/backend/x86/emit.cyr), which
    # returns the character count written EXCLUDING the NUL, 0 when the name is not
    # defined, or the count INCLUDING the NUL when the buffer was too small. So 0 is an
    # honest miss, and a value that does not fit is refused rather than handed back cut
    # short — the same call shape and the same refusal as lib/io.cyr's `getenv`.
    # ⚠ This runs during the gvar-init prologue, before alloc_init, which is why it
    # writes the static _env_scratch and allocates nothing. CHANGELOG [6.6.6]
    var w_n = syscall(0xF015, name, &_env_scratch, 256);
    if (w_n <= 0) { return 0; }
    if (w_n > 255) { _env_refuse_long(name); return 0; }
    store8(&_env_scratch + w_n, 0);
    return &_env_scratch;
    #endif
    return 0;
}

# One environ byte for `_read_env`'s Linux scan. State `st` (i64 slots): +0 bytes into the
# entry, +8 1 while the entry still spells `name=`, +16 value bytes seen (written into
# _env_scratch while they fit), +24 the verdict: -1 until the first `name=` entry ends, then
# 1 (captured, NUL-terminated) or 2 (longer than 255 B — refused). Once decided, every byte is
# a no-op, so a later duplicate entry can neither win nor overwrite the captured value.
#ifdef CYRIUS_TARGET_LINUX
fn _re_step(st, name, nl, c): i64 {
    if (load64(st + 24) != 0 - 1) { return 0; }
    var ep = load64(st);
    if (c == 0) {
        if (load64(st + 8) == 1) {
            if (ep > nl) {
                var vend = load64(st + 16);
                if (vend > 255) { store64(st + 24, 2); }
                else {
                    store8(&_env_scratch + vend, 0);
                    store64(st + 24, 1);
                }
            }
        }
        store64(st, 0);
        store64(st + 8, 1);
        store64(st + 16, 0);
        return 0;
    }
    store64(st, ep + 1);
    if (load64(st + 8) == 0) { return 0; }
    if (ep < nl) {
        if (load8(name + ep) != c) { store64(st + 8, 0); }
        return 0;
    }
    if (ep == nl) {
        if (c != 61) { store64(st + 8, 0); }
        return 0;
    }
    var vl = load64(st + 16);
    if (vl < 256) { store8(&_env_scratch + vl, c); }
    store64(st + 16, vl + 1);
    return 0;
}
#endif

# A value longer than 255 B does not fit `_env_scratch`. It is REFUSED — never handed back cut
# short — on every target (the Windows arm always refused; Linux and macOS truncated until
# 6.6.20), and it is SAID: a refused knob silently changes what the compiler does.
fn _env_refuse_long(name): i64 {
    var nl = 0;
    while (load8(name + nl) != 0) { nl = nl + 1; }
    syscall(SYS_WRITE, 2, "warning: ignoring ", 18);
    syscall(SYS_WRITE, 2, name, nl);
    syscall(SYS_WRITE, 2, ": its value is longer than 255 bytes\n", 37);
    return 0;
}
