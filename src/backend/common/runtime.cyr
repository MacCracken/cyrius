# ================================================================
# Runtime helpers — shared by x86 + aarch64 backends (v6.0.8 collapse)
# ================================================================
# _env_scratch, _read_env, _prof_clock_ns, RECFIX previously lived
# in src/backend/x86/{fixup,emit}.cyr AND src/backend/aarch64/{fixup,
# emit}.cyr. Bodies were logically identical; only syscall numbers
# differed for _prof_clock_ns (228 vs 113) and RECFIX's error
# message text. v6.0.8 unifies them here.
#
# NOT included from main_cx.cyr — cx/emit.cyr has its own RECFIX
# (different fixup-table cap, different region) and a _read_env
# stub returning 0 (no env-var support in the bytecode mode). cx also
# keeps its OWN _TARGET_* block (with _TARGET_CX=1); the copy below is
# the shared x86+aarch64 one.

# ================================================================
# Output-target flags (v6.1.4: hoisted here from x86/emit.cyr +
# aarch64/emit.cyr so they're declared BEFORE the backend emit/fixup
# includes — the prereq that unblocks the shared _emit_fmt below).
# Set from CYRIUS_* env vars in the main_*.cyr entry points AFTER all
# includes; default 0. Read by name in emit/fixup/parse, so the move is
# offset-independent. cx/emit.cyr declares its own copy (CX=1).
# ================================================================
# 0=ELF (Linux), 1=Mach-O x86_64 (macOS), 2=Mach-O ARM64 (macOS).
var _TARGET_MACHO = 0;
# PE32+ (Windows x86_64): 0=off, 1=on. Set from CYRIUS_TARGET_WIN=1.
# x86-only in practice; the aarch64 branches are statically dead shims.
var _TARGET_PE = 0;
# AGNOS ring-3 userspace target: 0=off, 1=on (CYRIUS_TARGET_AGNOS=1).
# x86_64 ELF64 with the agnos syscall ABI; only EEXIT diverges.
var _TARGET_AGNOS = 0;
# ELF64 kernel target: 0=off, 1=on (CYRIUS_ELF64_KERNEL=1). x86-only —
# routes EMITELF→EMITELF64_KERNEL (multiboot2/UEFI x86_64 boot).
var _TARGET_ELF64_KERNEL = 0;
# UEFI Application PE emit mode: 0=off, 1=on (CYRIUS_TARGET_EFI=1; implies
# _TARGET_PE). Subsystem=0xA, no kernel32 imports, EEXIT=ret. x86-only.
var _TARGET_EFI_APPLICATION = 0;
# cx (cyrius-x bytecode) backend marker. 0 on x86+aarch64 emit; =1 only
# in backend/cx/emit.cyr's own copy. gates direct-byte emits in shared
# parse paths. See docs/audit/2026-04-27-cx-direct-emit-inventory.md.
var _TARGET_CX = 0;
# PIE codegen (v6.1.6): 0=off, 1=on. Set from --pie cmdline / CYRIUS_PIE=1 env
# in the main_*.cyr entry points AFTER includes; default 0. When 1 AND kmode==1
# (kernel), x86 codegen goes position-independent — `lea [rip+disp32]` instead of
# `mov imm64` (reusing the proven shared/object _IS_OBJ path), the fixup walk
# patches RIP-relative deltas, and EMITELF64_KERNEL emits an ET_DYN with a real
# _start + p_vaddr=0 so a boot shim can KASLR-slide the kernel. Read by name in
# x86 emit/fixup; non-PIE builds keep _pie_mode==0 → byte-identical. x86_64 only
# this slot (aarch64 PIE is a later sub-arc). See CHANGELOG [6.1.6].
var _pie_mode = 0;

# Active output format for the (target-flag) combination — 0=ELF,
# 1=Mach-O x86_64, 2=Mach-O ARM64, 3=PE. Hoisted from the byte-identical
# copies in x86/fixup.cyr + aarch64/fixup.cyr at v6.1.4 (the v6.0.89
# first-bite left them duplicated pending the _TARGET_* move above).
# Precedence matches the pre-v6.0.89 EMITELF ladder EXACTLY: Mach-O is
# tested before PE — _TARGET_MACHO / _TARGET_PE are independent unguarded
# env vars, so the combined state is reachable; the old code let Mach-O
# win, and we keep that. (_entry_base stays per-backend — its entry VAs
# are arch-specific, NOT a byte-identical dup. See each fixup.cyr.)
fn _emit_fmt(S): i64 {
    if (_TARGET_MACHO == 1) { return 1; }
    if (_TARGET_MACHO == 2) { return 2; }
    if (_TARGET_PE == 1) { return 3; }
    return 0;
}

# Static scratch for env value (256 bytes).
var _env_scratch[256];

#ifdef CYRIUS_TARGET_MACOS
# Return the argc/argv base the Mach-O arm64 entry prologue parked in
# x28 (callee-saved, untouched by the aarch64 backend). Same inline-asm
# pattern as lib/args_macos.cyr's _macho_argv_base — the result lands in
# the single local at [x29,#-8]. Used by _read_env's macOS branch to
# reach envp. Only compiled into macOS (CYRIUS_TARGET_MACOS) builds.
fn _macho_x28(): i64 {
    # Guard on the TARGET arch (CYRIUS_ARCH_AARCH64), NOT CYRIUS_ARCH_X86:
    # when the x86 cross-compiler (cc_x) builds the arm64 macho cycc it
    # predefines CYRIUS_ARCH_X86 *alongside* the driver's CYRIUS_ARCH_AARCH64,
    # so an `#ifdef CYRIUS_ARCH_X86` here would wrongly fire for the arm64
    # build and zero out x28 parking on the shipped (cross-built) arm64 cycc.
    # AARCH64 is only ever predefined for the arm64 target. See [6.0.42].
    #ifdef CYRIUS_ARCH_AARCH64
    var r = 0;
    asm {
        0xE0; 0x03; 0x1C; 0xAA;    # mov x0, x28
        0xA0; 0x83; 0x1F; 0xF8;    # stur x0, [x29, #-8]  (r)
    }
    return r;
    #else
    # x86-macOS: argv parking (entry prologue + r13 read) is deferred until
    # it can live in the shared macho entry emit — cycc itself calls
    # _read_env, and its cross-built entry has garbage r13, so reading r13
    # here crashes cycc. Return 0 (→ _read_env reports "not found", env
    # features default off) until the macho-emit prologue lands. See issue
    # 2026-06-02-macos-x86-release-no-compiler.md layer 6.
    return 0;
    #endif
}
#endif

# Read an env var by name. Returns &_env_scratch (NUL-terminated
# value) on hit, 0 on miss. v5.5.9: /proc/self/environ is Linux-only;
# Windows + macOS fall through to 0 (GetEnvironmentVariableW-based
# Win lookup queued for v5.5.x tail). The SYS_OPEN == 2 shim picks
# the correct path: x86_64 uses raw `open` (syscall 2), aarch64
# native uses `openat(AT_FDCWD, ...)` (-100 first arg).
fn _read_env(name): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var ebuf[8192];
    var efd = 0;
    if (SYS_OPEN == 2) { efd = syscall(SYS_OPEN, "/proc/self/environ", 0, 0); }
    else { efd = syscall(SYS_OPEN, 0 - 100, "/proc/self/environ", 0, 0); }
    if (efd < 0) { return 0; }
    var elen = syscall(SYS_READ, efd, &ebuf, 8191);
    syscall(SYS_CLOSE, efd);
    if (elen <= 0) { return 0; }
    store8(&ebuf + elen, 0);
    var nlen = 0;
    while (load8(name + nlen) != 0) { nlen = nlen + 1; }
    var pos = 0;
    while (pos < elen) {
        var end = pos;
        while (end < elen && load8(&ebuf + end) != 0) { end = end + 1; }
        if (end - pos > nlen && load8(&ebuf + pos + nlen) == 61) {
            var matched = 1;
            var k = 0;
            while (k < nlen) {
                if (load8(&ebuf + pos + k) != load8(name + k)) { matched = 0; break; }
                k = k + 1;
            }
            if (matched == 1) {
                var vstart = pos + nlen + 1;
                var vlen = end - vstart;
                if (vlen > 255) { vlen = 255; }
                var ci = 0;
                while (ci < vlen) {
                    store8(&_env_scratch + ci, load8(&ebuf + vstart + ci));
                    ci = ci + 1;
                }
                store8(&_env_scratch + vlen, 0);
                return &_env_scratch;
            }
        }
        pos = end + 1;
    }
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    # macOS has no /proc/self/environ. The Mach-O arm64 entry prologue
    # (main_aarch64.cyr v5.5.17) parked argc/argv in x28; on the Darwin
    # stack envp immediately follows argv + its NULL terminator, so
    # envp = argv + (argc+1)*8. Walk the NAME=VALUE entries (the array
    # is NULL-terminated). Without this, _read_env returned 0 on macOS →
    # a natively-running cycc never saw CYRIUS_MACHO_ARM → it built every
    # binary Linux-shaped (no entry prologue, brk heap, no ESYSXLAT) and
    # could not self-host on Apple Silicon. Root cause of the macOS
    # self-host rot v5.3.13 → v6.0.32. See CHANGELOG [6.0.33].
    # v6.0.44: only the arm64 driver parks argv in x28. On x86-macOS there
    # is no argv parking yet, so _macho_x28() would return a stale-register
    # garbage value (e.g. 0x23), which the `m_base == 0` guard does NOT
    # catch → load64(garbage) SIGSEGVs. There's nothing to read on x86
    # macho, so return 0 directly without touching _macho_x28. Guard on the
    # TARGET arch (AARCH64), NOT CYRIUS_ARCH_X86 (the x86 cross-compiler
    # predefines X86 even when building the arm64 cycc). See issue layer 6.
    #ifndef CYRIUS_ARCH_AARCH64
    return 0;
    #endif
    var m_base = _macho_x28();
    if (m_base == 0) { return 0; }
    var m_argc = load64(m_base);
    var m_argv = load64(m_base + 8);
    var m_envp = m_argv + (m_argc + 1) * 8;
    var m_nlen = 0;
    while (load8(name + m_nlen) != 0) { m_nlen = m_nlen + 1; }
    var m_i = 0;
    var m_e = load64(m_envp);
    while (m_e != 0) {
        # m_e -> "NAME=VALUE\0". Match name then '='.
        if (load8(m_e + m_nlen) == 61) {
            var m_match = 1;
            var m_k = 0;
            while (m_k < m_nlen) {
                if (load8(m_e + m_k) != load8(name + m_k)) { m_match = 0; break; }
                m_k = m_k + 1;
            }
            if (m_match == 1) {
                var m_vs = m_e + m_nlen + 1;
                var m_vl = 0;
                while (load8(m_vs + m_vl) != 0) { m_vl = m_vl + 1; }
                if (m_vl > 255) { m_vl = 255; }
                var m_ci = 0;
                while (m_ci < m_vl) {
                    store8(&_env_scratch + m_ci, load8(m_vs + m_ci));
                    m_ci = m_ci + 1;
                }
                store8(&_env_scratch + m_vl, 0);
                return &_env_scratch;
            }
        }
        m_i = m_i + 1;
        m_e = load64(m_envp + m_i * 8);
    }
    #endif
    return 0;
}

# v6.3.23 (DX-01): shared function-symbol dump — opt-in via the CYRIUS_SYMS env
# var (value = output path). Writes "<16-hex VA> <name>\n" per emitted function so
# a RIP captured by coredumpctl (or the AGNOS/Windows/macOS crash reporter) maps
# back to function+offset. Hoisted here from the x86-only inline block that lived
# in x86/fixup.cyr since v5.x so all backends reach crash-localization parity, not
# just x86-ELF (issue 2026-06-10-unreviewed-dimensions DX-01). The VA base is
# passed in because it is target-specific: ELF entry (x86/aarch64), the Mach-O
# TEXT base (via _entry_base's fmt branch), or the PE ImageBase+text RVA — the
# caller resolves it. Portable syscalls: SYS_OPEN==2 is the x86 raw `open`; every
# other arch (aarch64) has no bare open, so mirror _read_env's openat(AT_FDCWD)
# shim. Flags 0x241 = O_WRONLY|O_CREAT|O_TRUNC, mode 0x1A4 = 0644. Entirely behind
# the `sym_path != 0` guard → zero effect (byte-identical emitted programs) unless
# CYRIUS_SYMS is set. cx keeps its own no-op _read_env stub, so this is inert there.
fn _emit_sym_dump(S, base): i64 {
    var sym_path = _read_env("CYRIUS_SYMS");
    if (sym_path == 0) { return 0; }
    var symfd = 0;
    if (SYS_OPEN == 2) { symfd = syscall(SYS_OPEN, sym_path, 0x241, 0x1A4); }
    else { symfd = syscall(SYS_OPEN, 0 - 100, sym_path, 0x241, 0x1A4); }
    if (symfd < 0) { return 0; }
    var sym_fnc = GFNC(S);
    var sfi = 0;
    while (sfi < sym_fnc) {
        var foff = L64(_fnt_offsets + sfi * 8);
        if (foff >= 0) {
            var vabuf[20];
            var va = base + foff;
            var vi2 = 15;
            while (vi2 >= 0) {
                var hd = va & 15;
                if (hd < 10) { store8(&vabuf + vi2, 48 + hd); }
                else { store8(&vabuf + vi2, 87 + hd); }
                va = va >> 4;
                vi2 = vi2 - 1;
            }
            syscall(SYS_WRITE, symfd, &vabuf, 16);
            syscall(SYS_WRITE, symfd, " ", 1);
            var nptr = S + 0x60000 + L64(_fnt_names + sfi * 8);
            var nlen = 0;
            while (load8(nptr + nlen) != 0) { nlen = nlen + 1; }
            syscall(SYS_WRITE, symfd, nptr, nlen);
            syscall(SYS_WRITE, symfd, "\n", 1);
        }
        sfi = sfi + 1;
    }
    syscall(SYS_CLOSE, symfd);
    return 0;
}

# v6.3.3 #5: parse a "0x<hex>" env string -> i64 (0 on empty / missing 0x / a bad
# digit). The only 0x-hex env parser in the compiler (CYRIUS_DCE_CAP is decimal);
# CYRIUS_KERNEL_BASE (and the `[sections] base` manifest key that funnels into it)
# uses it to set the kernel load/link base. Loads + arithmetic only — no fn calls,
# no tail call — so cybs derives it cleanly (seed-derive gate).
fn _parse_hex_env(p): i64 {
    if (load8(p) != 48) { return 0; }       # '0'
    if (load8(p + 1) != 120) { return 0; }   # 'x'
    var v = 0;
    var i = 2;
    var c = load8(p + i);
    if (c == 0) { return 0; }                 # "0x" with no digits
    while (c != 0) {
        var d = 0 - 1;
        if (c >= 48 && c <= 57) { d = c - 48; }          # 0-9
        elif (c >= 97 && c <= 102) { d = c - 97 + 10; }  # a-f
        elif (c >= 65 && c <= 70) { d = c - 65 + 10; }   # A-F
        else { return 0; }
        v = v * 16 + d;
        i = i + 1;
        c = load8(p + i);
    }
    return v;
}

# Nanosecond wall clock for CYRIUS_PROF (v5.6.5 O1 + v5.6.6).
# Linux x86_64: clock_gettime(CLOCK_MONOTONIC=1) via syscall 228.
# Linux aarch64: clock_gettime(CLOCK_MONOTONIC=1) via syscall 113
# (generic table — different number from x86_64).
# Windows PE: syscall(228, _, _) rerouted by EGETTICKS_PE to
# kernel32!GetTickCount64; returns ms in rax, scaled to ns here.
# macOS arm64: syscall(228, 4, _) rerouted by EMACHO_CLOCK_ARM to
# libSystem _clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW=4) via
# __got[6]; returns u64 ns directly in x0.
# Non-Linux non-PE non-macOS: returns 0 (no clock available).
fn _prof_clock_ns(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var _ms = syscall(228, 0, 0);
    return _ms * 1000000;
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    return syscall(228, 4, 0);
    #endif
    var ts[16];
    #ifdef CYRIUS_TARGET_LINUX
    #ifdef CYRIUS_ARCH_X86
    syscall(228, 1, &ts);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    syscall(113, 1, &ts);
    #endif
    #endif
    return load64(&ts) * 1000000000 + load64(&ts + 8);
}

# Record a fixup entry — append (codepos, var_idx) to the fixup
# table at _fixup_base. AR-03 (v6.2.0): the table is now GROWABLE —
# GFCNT() doubles _fixup_base/_fixup_cap (via _fixup_grow) the moment
# the count reaches the cap, so the writers never cap-check. Initial
# cap is 1048576 (16 MiB at S+0x107B000); _fixup_grow alloc()s a fresh
# 2× buffer off the heap and copies the live entries, up to a 64M-entry
# runaway ceiling. This retired the 10 per-writer `fc >= 1048576` hard-
# error checks that spuriously rejected big programs (the v6.1.38 cap-
# unification was the last fixed-region patch before this migration).
# Note: cx/emit.cyr has its own RECFIX (fixed cap 1048576, region
# 0x150B000) — it never inits _fixup_cap, so the `_fixup_cap != 0`
# guard in GFCNT leaves the cx path on its original fixed storage.
fn RECFIX(S, idx): i64 {
    var fc = GFCNT(S);
    var addr = _fixup_base + fc * 16;
    S64(addr, GCP(S));
    S64(addr + 8, idx);
    SFCNT(S, fc + 1);
    return 0;
}

# v6.1.35 (CVE-23): shared 16 MB output_buf cap guard. The 16 MB output
# region at S+0x4D9D000 (output_buf end 0x5D9D000; brk-final 0x5E1D000) was cap-checked inline only in
# the x86 EMITELF_USER/SHARED/OBJ + Mach-O writers; the aarch64 ELF emitter,
# both kernel-ELF emitters, and the PE writer wrote past it unchecked. The
# overrun happens DURING emit, before the single flush point, so a flush-time
# guard is too late — each writer calls this with the TRUE final on-disk size
# (the section-header table sits past the PT_LOAD filesz, so the arg is
# shdr_off + shnum*shentsize, NOT filesz — a filesz-only check left a
# ~370 B/ELF64 (~240 B/ELF32) window just under 16 MB; mirror EMITELF_OBJ)
# BEFORE its first output_buf store. Mirrors EMITELF_USER's top-3-largest-vars
# diagnostic (so the user learns which `var buf[N]` blew the budget). Exits 1
# on overflow; a no-op for in-cap output → byte-identical valid builds. Kernel
# images (the AGNOS authorship goal + v6.2.x bare-metal) were exactly the
# unguarded path. See CHANGELOG [6.1.35].
fn _check_output_cap(S, filesz): i64 {
    if (filesz > 16777216) {
        syscall(SYS_WRITE, 2, "error: output too large (", 25);
        PRNUM(filesz);
        syscall(SYS_WRITE, 2, "/16777216 bytes)", 16);
        var vcount = GVCNT(S);
        var top1_sz = 0; var top1_ix = 0 - 1;
        var top2_sz = 0; var top2_ix = 0 - 1;
        var top3_sz = 0; var top3_ix = 0 - 1;
        var vi = 0;
        while (vi < vcount) {
            var vsz = L64(_vars_base + vi * 8);
            if (vsz > top1_sz) {
                top3_sz = top2_sz; top3_ix = top2_ix;
                top2_sz = top1_sz; top2_ix = top1_ix;
                top1_sz = vsz; top1_ix = vi;
            } elif (vsz > top2_sz) {
                top3_sz = top2_sz; top3_ix = top2_ix;
                top2_sz = vsz; top2_ix = vi;
            } elif (vsz > top3_sz) {
                top3_sz = vsz; top3_ix = vi;
            }
            vi = vi + 1;
        }
        if (top1_ix >= 0) {
            syscall(SYS_WRITE, 2, "\n  largest vars:\n    ", 21);
            PRNUM(top1_sz);
            syscall(SYS_WRITE, 2, " bytes: ", 8);
            var nptr = S + 0x60000 + L64(_varn_base + top1_ix * 8);
            var nlen = 0;
            while (load8(nptr + nlen) != 0) { nlen = nlen + 1; }
            syscall(SYS_WRITE, 2, nptr, nlen);
            if (top2_ix >= 0) {
                syscall(SYS_WRITE, 2, "\n    ", 5);
                PRNUM(top2_sz);
                syscall(SYS_WRITE, 2, " bytes: ", 8);
                nptr = S + 0x60000 + L64(_varn_base + top2_ix * 8);
                nlen = 0;
                while (load8(nptr + nlen) != 0) { nlen = nlen + 1; }
                syscall(SYS_WRITE, 2, nptr, nlen);
            }
            if (top3_ix >= 0) {
                syscall(SYS_WRITE, 2, "\n    ", 5);
                PRNUM(top3_sz);
                syscall(SYS_WRITE, 2, " bytes: ", 8);
                nptr = S + 0x60000 + L64(_varn_base + top3_ix * 8);
                nlen = 0;
                while (load8(nptr + nlen) != 0) { nlen = nlen + 1; }
                syscall(SYS_WRITE, 2, nptr, nlen);
            }
        }
        syscall(SYS_WRITE, 2, "\n  tip: heap-allocate large var buf[N] arrays (alloc(N) + pointer)\n", 67);
        syscall(SYS_EXIT, 1);
    }
    return 0;
}

# ================================================================
# DCE shared probes (v6.1.5) — hoisted from the byte-identical copies
# in x86/fixup.cyr + aarch64/fixup.cyr. The mark-and-sweep reachability
# pass in each backend's FIXUP duplicated two arch-identical lookups, and
# each was written twice within a backend: the open-addressing fn_start→fi
# hash probe (seed + propagate) and the linear host-fn [start,end) scan
# (seed + undef-fn). The only arch delta is the opcode-scan STRIDE
# (x86 E8/E9 + DECODE_LEN vs aarch64 BL/B fixed 4-byte), which stays inline
# in each FIXUP. These two lookups read the same heap regions on both
# arches, so they unify here. Logic-preserving — see CHANGELOG [6.1.5].

# fn_start → fn-index lookup over the 8192-slot open-addressing hash at
# S+0x114000 (built once per FIXUP before the DCE byte-scan). Knuth
# golden-ratio multiplicative hash (0x9E3779B97F4A7C15 = floor(2^64/phi)),
# slot 0..8191, mask 8191. Returns the fn whose start offset == tgt, or -1
# on miss. Byte-identical to the four inline probe loops it replaces — the
# old `probes = 8192` loop-exit on empty-slot / match becomes a direct
# return; same termination, same result.
fn _dce_hash_lookup(S, tgt): i64 {
    var h = (tgt * 0x9E3779B97F4A7C15) >> 16;
    var slot = h & _fnt_hash_mask;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load16(_fnt_starthash + slot * 2);
        if (stored == 0) { return 0 - 1; }
        var fi = stored - 1;
        if (L64(_fnt_offsets + fi * 8) == tgt) { return fi; }
        slot = (slot + 1) & _fnt_hash_mask;
        probes = probes + 1;
    }
    return 0 - 1;
}

# Host fn for a code offset: the fn whose [start, end) range contains
# `coff`, or -1 when `coff` lies outside every fn body (entry / top-level
# code → conservative ROOT in the seed pass; always-live in the undef-fn
# check). Linear scan over the fn_start table at S+0x9CA000 (ends via
# GFNE); returns the FIRST match in index order. Byte-identical to the
# four inline host-scan loops it replaces — the old `host = fj; fj = fnc`
# early-exit (guarded so it didn't re-increment) becomes a direct return.
fn _dce_host_fn(S, coff, fnc): i64 {
    var fj = 0;
    while (fj < fnc) {
        var fs = L64(_fnt_offsets + fj * 8);
        if (fs >= 0) {
            var fe = GFNE(S, fj);
            if (fe > fs && coff >= fs && coff < fe) { return fj; }
        }
        fj = fj + 1;
    }
    return 0 - 1;
}
