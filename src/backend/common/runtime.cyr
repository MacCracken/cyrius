# ================================================================
# Runtime helpers — shared by x86 + aarch64 backends (v6.0.8 collapse)
# ================================================================
# _env_scratch, _read_env, _prof_clock_ns, RECFIX previously lived
# in src/backend/x86/{fixup,emit}.cyr AND src/backend/aarch64/{fixup,
# emit}.cyr. Bodies were logically identical; only syscall numbers
# differed for _prof_clock_ns (228 vs 113) and RECFIX's error
# message text. v6.0.8 unifies them here.
#
# NOT included from main_cx.cyr — cx/emit.cyr has its own RECFIX
# (different fixup-table cap, different region) and a _read_env
# stub returning 0 (no env-var support in the bytecode mode).

# Static scratch for env value (256 bytes).
var _env_scratch[256];

#ifdef CYRIUS_TARGET_MACOS
# Return the argc/argv base the Mach-O arm64 entry prologue parked in
# x28 (callee-saved, untouched by the aarch64 backend). Same inline-asm
# pattern as lib/args_macos.cyr's _macho_argv_base — the result lands in
# the single local at [x29,#-8]. Used by _read_env's macOS branch to
# reach envp. Only compiled into macOS (CYRIUS_TARGET_MACOS) builds.
fn _macho_x28(): i64 {
    # Guard on the TARGET arch (CYRIUS_ARCH_AARCH64), NOT CYRIUS_ARCH_X86:
    # when the x86 cross-compiler (cc_x) builds the arm64 macho cycc it
    # predefines CYRIUS_ARCH_X86 *alongside* the driver's CYRIUS_ARCH_AARCH64,
    # so an `#ifdef CYRIUS_ARCH_X86` here would wrongly fire for the arm64
    # build and zero out x28 parking on the shipped (cross-built) arm64 cycc.
    # AARCH64 is only ever predefined for the arm64 target. See [6.0.42].
    #ifdef CYRIUS_ARCH_AARCH64
    var r = 0;
    asm {
        0xE0; 0x03; 0x1C; 0xAA;    # mov x0, x28
        0xA0; 0x83; 0x1F; 0xF8;    # stur x0, [x29, #-8]  (r)
    }
    return r;
    #else
    # x86-macOS (v6.0.42 dedicated-driver arc): the x28 argv-parking
    # mechanism is arm64-only. No x86 entry prologue parks argv yet, so
    # return 0 — _read_env's macho branch falls through to "not found"
    # instead of dereferencing garbage. The x86 macho driver hardcodes the
    # target, so env-based detection isn't needed; argv / --version on
    # x86-macOS is the follow-up. See issue layer 4.
    return 0;
    #endif
}
#endif

# Read an env var by name. Returns &_env_scratch (NUL-terminated
# value) on hit, 0 on miss. v5.5.9: /proc/self/environ is Linux-only;
# Windows + macOS fall through to 0 (GetEnvironmentVariableW-based
# Win lookup queued for v5.5.x tail). The SYS_OPEN == 2 shim picks
# the correct path: x86_64 uses raw `open` (syscall 2), aarch64
# native uses `openat(AT_FDCWD, ...)` (-100 first arg).
fn _read_env(name): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var ebuf[8192];
    var efd = 0;
    if (SYS_OPEN == 2) { efd = syscall(SYS_OPEN, "/proc/self/environ", 0, 0); }
    else { efd = syscall(SYS_OPEN, 0 - 100, "/proc/self/environ", 0, 0); }
    if (efd < 0) { return 0; }
    var elen = syscall(SYS_READ, efd, &ebuf, 8191);
    syscall(SYS_CLOSE, efd);
    if (elen <= 0) { return 0; }
    store8(&ebuf + elen, 0);
    var nlen = 0;
    while (load8(name + nlen) != 0) { nlen = nlen + 1; }
    var pos = 0;
    while (pos < elen) {
        var end = pos;
        while (end < elen && load8(&ebuf + end) != 0) { end = end + 1; }
        if (end - pos > nlen && load8(&ebuf + pos + nlen) == 61) {
            var matched = 1;
            var k = 0;
            while (k < nlen) {
                if (load8(&ebuf + pos + k) != load8(name + k)) { matched = 0; break; }
                k = k + 1;
            }
            if (matched == 1) {
                var vstart = pos + nlen + 1;
                var vlen = end - vstart;
                if (vlen > 255) { vlen = 255; }
                var ci = 0;
                while (ci < vlen) {
                    store8(&_env_scratch + ci, load8(&ebuf + vstart + ci));
                    ci = ci + 1;
                }
                store8(&_env_scratch + vlen, 0);
                return &_env_scratch;
            }
        }
        pos = end + 1;
    }
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    # macOS has no /proc/self/environ. The Mach-O arm64 entry prologue
    # (main_aarch64.cyr v5.5.17) parked argc/argv in x28; on the Darwin
    # stack envp immediately follows argv + its NULL terminator, so
    # envp = argv + (argc+1)*8. Walk the NAME=VALUE entries (the array
    # is NULL-terminated). Without this, _read_env returned 0 on macOS →
    # a natively-running cycc never saw CYRIUS_MACHO_ARM → it built every
    # binary Linux-shaped (no entry prologue, brk heap, no ESYSXLAT) and
    # could not self-host on Apple Silicon. Root cause of the macOS
    # self-host rot v5.3.13 → v6.0.32. See CHANGELOG [6.0.33].
    var m_base = _macho_x28();
    if (m_base == 0) { return 0; }
    var m_argc = load64(m_base);
    var m_argv = load64(m_base + 8);
    var m_envp = m_argv + (m_argc + 1) * 8;
    var m_nlen = 0;
    while (load8(name + m_nlen) != 0) { m_nlen = m_nlen + 1; }
    var m_i = 0;
    var m_e = load64(m_envp);
    while (m_e != 0) {
        # m_e -> "NAME=VALUE\0". Match name then '='.
        if (load8(m_e + m_nlen) == 61) {
            var m_match = 1;
            var m_k = 0;
            while (m_k < m_nlen) {
                if (load8(m_e + m_k) != load8(name + m_k)) { m_match = 0; break; }
                m_k = m_k + 1;
            }
            if (m_match == 1) {
                var m_vs = m_e + m_nlen + 1;
                var m_vl = 0;
                while (load8(m_vs + m_vl) != 0) { m_vl = m_vl + 1; }
                if (m_vl > 255) { m_vl = 255; }
                var m_ci = 0;
                while (m_ci < m_vl) {
                    store8(&_env_scratch + m_ci, load8(m_vs + m_ci));
                    m_ci = m_ci + 1;
                }
                store8(&_env_scratch + m_vl, 0);
                return &_env_scratch;
            }
        }
        m_i = m_i + 1;
        m_e = load64(m_envp + m_i * 8);
    }
    #endif
    return 0;
}

# Nanosecond wall clock for CYRIUS_PROF (v5.6.5 O1 + v5.6.6).
# Linux x86_64: clock_gettime(CLOCK_MONOTONIC=1) via syscall 228.
# Linux aarch64: clock_gettime(CLOCK_MONOTONIC=1) via syscall 113
# (generic table — different number from x86_64).
# Windows PE: syscall(228, _, _) rerouted by EGETTICKS_PE to
# kernel32!GetTickCount64; returns ms in rax, scaled to ns here.
# macOS arm64: syscall(228, 4, _) rerouted by EMACHO_CLOCK_ARM to
# libSystem _clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW=4) via
# __got[6]; returns u64 ns directly in x0.
# Non-Linux non-PE non-macOS: returns 0 (no clock available).
fn _prof_clock_ns(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var _ms = syscall(228, 0, 0);
    return _ms * 1000000;
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    return syscall(228, 4, 0);
    #endif
    var ts[16];
    #ifdef CYRIUS_TARGET_LINUX
    #ifdef CYRIUS_ARCH_X86
    syscall(228, 1, &ts);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    syscall(113, 1, &ts);
    #endif
    #endif
    return load64(&ts) * 1000000000 + load64(&ts + 8);
}

# Record a fixup entry — append (codepos, var_idx) to the fixup
# table at S + 0x107B000. Cap 262144 entries (16 bytes each →
# 4 MiB region). Pre-collapse: x86 + aarch64 had byte-identical
# bodies modulo the error message — aarch64 also printed the count
# via PRNUM. Unified to use the PRNUM variant.
# Note: cx/emit.cyr keeps its own RECFIX (cap 1048576, region
# 0x150B000) — different storage layout.
fn RECFIX(S, idx): i64 {
    var fc = GFCNT(S);
    if (fc >= 262144) {
        syscall(SYS_WRITE, 2, "error: fixup table full (", 25);
        PRNUM(fc);
        syscall(SYS_WRITE, 2, "/262144)\n", 9);
        syscall(SYS_EXIT, 1);
    }
    var addr = S + 0x107B000 + fc * 16;
    S64(addr, GCP(S));
    S64(addr + 8, idx);
    SFCNT(S, fc + 1);
    return 0;
}
