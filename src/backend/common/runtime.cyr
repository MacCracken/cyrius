# ================================================================
# Runtime helpers — shared by x86 + aarch64 backends (v6.0.8 collapse)
# ================================================================
# _env_scratch, _read_env, _prof_clock_ns, RECFIX previously lived
# in src/backend/x86/{fixup,emit}.cyr AND src/backend/aarch64/{fixup,
# emit}.cyr. Bodies were logically identical; only syscall numbers
# differed for _prof_clock_ns (228 vs 113) and RECFIX's error
# message text. v6.0.8 unifies them here.
#
# NOT included from main_cx.cyr — cx/emit.cyr has its own RECFIX
# (different fixup-table cap, different region). cx also keeps its OWN
# _TARGET_* block (with _TARGET_CX=1); the copy below is the shared
# x86+aarch64 one. The env reader is the exception: it lives in env.cyr,
# which main_cx.cyr includes directly (6.6.10).

# ================================================================
# Output-target flags (v6.1.4: hoisted here from x86/emit.cyr +
# aarch64/emit.cyr so they're declared BEFORE the backend emit/fixup
# includes — the prereq that unblocks the shared _emit_fmt below).
# Set from CYRIUS_* env vars in the main_*.cyr entry points AFTER all
# includes; default 0. Read by name in emit/fixup/parse, so the move is
# offset-independent. cx/emit.cyr declares its own copy (CX=1).
# ================================================================
# 0=ELF (Linux), 1=Mach-O x86_64 (macOS), 2=Mach-O ARM64 (macOS).
var _TARGET_MACHO = 0;
# PE32+ (Windows x86_64): 0=off, 1=on. Set from CYRIUS_TARGET_WIN=1.
# x86-only in practice; the aarch64 branches are statically dead shims.
var _TARGET_PE = 0;
# AGNOS ring-3 userspace target: 0=off, 1=on (CYRIUS_TARGET_AGNOS=1).
# x86_64 ELF64 with the agnos syscall ABI; only EEXIT diverges.
var _TARGET_AGNOS = 0;
# ELF64 kernel target: 0=off, 1=on (CYRIUS_ELF64_KERNEL=1). x86-only —
# routes EMITELF→EMITELF64_KERNEL (multiboot2/UEFI x86_64 boot).
var _TARGET_ELF64_KERNEL = 0;
# UEFI Application PE emit mode: 0=off, 1=on (CYRIUS_TARGET_EFI=1; implies
# _TARGET_PE). Subsystem=0xA, no kernel32 imports, EEXIT=ret. x86-only.
var _TARGET_EFI_APPLICATION = 0;
# cx (cyrius-x bytecode) backend marker. 0 on x86+aarch64 emit; =1 only
# in backend/cx/emit.cyr's own copy. gates direct-byte emits in shared
# parse paths. See docs/audit/2026-04-27-cx-direct-emit-inventory.md.
var _TARGET_CX = 0;
# PIE codegen (v6.1.6): 0=off, 1=on. Set from --pie cmdline / CYRIUS_PIE=1 env
# in the main_*.cyr entry points AFTER includes; default 0. When 1 AND kmode==1
# (kernel), x86 codegen goes position-independent — `lea [rip+disp32]` instead of
# `mov imm64` (reusing the proven shared/object _IS_OBJ path), the fixup walk
# patches RIP-relative deltas, and EMITELF64_KERNEL emits an ET_DYN with a real
# _start + p_vaddr=0 so a boot shim can KASLR-slide the kernel. Read by name in
# x86 emit/fixup; non-PIE builds keep _pie_mode==0 → byte-identical. x86_64 only
# this slot (aarch64 PIE is a later sub-arc). See CHANGELOG [6.1.6].
var _pie_mode = 0;

# Active output format for the (target-flag) combination — 0=ELF,
# 1=Mach-O x86_64, 2=Mach-O ARM64, 3=PE. Hoisted from the byte-identical
# copies in x86/fixup.cyr + aarch64/fixup.cyr at v6.1.4 (the v6.0.89
# first-bite left them duplicated pending the _TARGET_* move above).
# Precedence matches the pre-v6.0.89 EMITELF ladder EXACTLY: Mach-O is
# tested before PE — _TARGET_MACHO / _TARGET_PE are independent unguarded
# env vars, so the combined state is reachable; the old code let Mach-O
# win, and we keep that. (_entry_base stays per-backend — its entry VAs
# are arch-specific, NOT a byte-identical dup. See each fixup.cyr.)
fn _emit_fmt(S): i64 {
    if (_TARGET_MACHO == 1) { return 1; }
    if (_TARGET_MACHO == 2) { return 2; }
    if (_TARGET_PE == 1) { return 3; }
    return 0;
}

# 6.6.10 — `kernel;` / `shared;` / `object;` are refused BY NAME where no emitter exists.
# Only the ELF emitters implement them (x86: EMITELF_KERNEL/_SHARED/_OBJ; aarch64: KERNEL),
# but every fork's pass 1 accepted the directives unconditionally, and both EMITELF
# ladders dispatch Mach-O/PE before consulting the mode — so the request was dropped or
# half-applied, silently: PE `object;` wrote 0 bytes with rc 0 (FIXUP's object early
# return), PE `shared;` built an exe that access-violates (RIP-relative _IS_OBJ codegen,
# no loader to relocate it), x86 Mach-O `object;` ran and exited 72, `kernel;`/`shared;`
# on Mach-O were byte-identical to no mode, and aarch64 ELF `shared;` emitted an
# EXECUTABLE. Per mode, not per format: `kernel;` STAYS legal on PE — it is the bare-metal
# gate a UEFI build relies on (gnoboot, programs/efi_probe.cyr; it drives the #host_only
# refusal), and PE/EFI output needs nothing else from it. cx has its own check
# (_cx_mode_refused, backend/cx/emit.cyr). `a64` = 1 from the aarch64 FIXUP. CHANGELOG [6.6.10]
fn _mode_word(km): i64 {
    if (km == 1) { return "kernel;"; }
    if (km == 2) { return "shared;"; }
    return "object;";
}
fn _fmt_word(fmt): i64 {
    if (fmt == 1) { return "x86_64 Mach-O"; }
    if (fmt == 2) { return "arm64 Mach-O"; }
    if (fmt == 3) { return "PE"; }
    return "aarch64 ELF";
}
fn _mode_unsupported(S, a64): i64 {
    var km = L64(S + 0x18FCA0);
    if (km == 0) { return 0; }
    var fmt = _emit_fmt(S);
    var bad = 0;
    if (fmt == 1 || fmt == 2) { bad = 1; }
    if (fmt == 3) { if (km != 1) { bad = 1; } }
    if (fmt == 0) { if (a64 == 1) { if (km != 1) { bad = 1; } } }
    if (bad == 0) { return 0; }
    syscall(SYS_WRITE, 2, "error: `", 8);
    PRSTR(_mode_word(km));
    syscall(SYS_WRITE, 2, "` is not supported for ", 23);
    PRSTR(_fmt_word(fmt));
    syscall(SYS_WRITE, 2, " output (no emitter for it on this target: x86_64 ELF implements kernel;/shared;/object;, aarch64 ELF kernel;, PE kernel; only)\n", 128);
    return 1;
}

# 6.6.18 — CYRIUS_DCE=1 compaction: ONE predicate DECIDES and REPORTS. Six paths declined
# compaction and said nothing: PE, x86 Mach-O, `--pie`, `shared;`, every aarch64 target, and a
# saturated repair registry on the one target that does compact (static x86 ELF). The last is a
# cliff: 4,096 dead fns compact to 4,456 B, 4,097 leave 201,064 B (one-line fns) — and it was misdiagnosed on
# record as a DECODE_WALK_OK bail. The x86 FIXUP gates wp_compact on `why == 0`, so the note
# cannot drift from the decision; wp_compact keeps its own guards (the CYRIUS_IR=3 seam uses
# them) and FIXUP flags any refusal this does not classify. 0 = compaction will run.
# `a64` = 1 from the aarch64 FIXUP. CHANGELOG [6.6.18]
fn _dce_compact_why(S, a64): i64 {
    if (a64 == 1) { return "aarch64 has no compaction repair model yet"; }
    var fmt = _emit_fmt(S);
    if (fmt == 3) { return "its import table is reached through rip-relative disp32s this pass cannot repair"; }
    if (fmt == 1) { return "its stub table is reached through rip-relative disp32s this pass cannot repair"; }
    if (_pie_mode != 0) { return "position-independent code reaches data through rip-relative disp32s this pass cannot repair"; }
    if (L64(S + 0x18FCA0) > 1) { return "a shared object reaches data through rip-relative disp32s this pass cannot repair"; }
    var rw = _wp_registry_why();
    return rw;
}
# A saturated repair registry, named — shared by the CYRIUS_DCE=1 note above and the
# CYRIUS_IR=3 seam in main.cyr, which declined on the same flags and said nothing. 0 = none.
# CHANGELOG [6.6.20]
fn _wp_registry_why(): i64 {
    if (_wpnr_ovf == 1) { return "more than 4096 dead-code runs, the repair registry cap"; }
    if (_wpjs_ovf == 1) { return "the rel32/disp32 source registry could not grow (alloc failed)"; }
    if (_wpsw_ovf == 1) { return "more than 4096 switch tables, the repair registry cap"; }
    return 0;
}
fn _dce_target_word(S, a64): i64 {
    var fmt = _emit_fmt(S);
    if (a64 == 1) { return _fmt_word(fmt); }
    if (fmt == 3) { return "PE"; }
    if (fmt == 1) { return "x86_64 Mach-O"; }
    if (_pie_mode != 0) { return "x86_64 ELF (--pie)"; }
    if (L64(S + 0x18FCA0) > 1) { return "x86_64 ELF (shared;)"; }
    return "x86_64 ELF";
}
# The reason rides INSIDE the existing `note: N unreachable fns (...)` line, never on a line of
# its own: consumers filter that note with `grep -v "unreachable fns"`, and a separate line
# would slip through every such filter.
fn _dce_nop_tail(S, a64, why, nbytes): i64 {
    PRSTR(" bytes NOPed");
    if (why != 0) {
        if (nbytes > 0) {
            PRSTR("; compaction declined on ");
            PRSTR(_dce_target_word(S, a64));
            PRSTR(": ");
            PRSTR(why);
        }
    }
    PRSTR(")\n");
    return 0;
}
# The CYRIUS_DCE-unset hint. It promised "set CYRIUS_DCE=1 to eliminate" on every target, including
# the ones that can never eliminate (dce_eliminates.sh records that broken promise from v6.5.72).
# Unset, FIXUP still records the dead-code runs, so the 4,096-run cap shows here too; the jump and
# switch registries record only under CYRIUS_DCE=1 / CYRIUS_IR, so those two caps cannot.
fn _dce_hint_tail(S, a64, why): i64 {
    if (why == 0) {
        PRSTR(" bytes — set CYRIUS_DCE=1 to eliminate, CYRIUS_DCE_VERBOSE=1 to list)\n");
        return 0;
    }
    PRSTR(" bytes — set CYRIUS_DCE=1 to NOP-fill them; no compaction on ");
    PRSTR(_dce_target_word(S, a64));
    PRSTR(": ");
    PRSTR(why);
    PRSTR("; CYRIUS_DCE_VERBOSE=1 to list)\n");
    return 0;
}
# Drift catch: called after a `why == 0` compaction. wp_compact zeroes the run count when it
# compacts, so runs left over with nothing removed mean it refused for a reason the note above
# did not give — a guard added to wp_compact and not to _dce_compact_why. Say so, not nothing.
fn _dce_drift_check(S, removed): i64 {
    if (removed != 0) { return 0; }
    if (_wpnr_n == 0) { return 0; }
    PRSTR("note: dead-code compaction declined on ");
    PRSTR(_dce_target_word(S, 0));
    PRSTR(": wp_compact refused for a reason the unreachable-fns note does not classify (compiler drift: _dce_compact_why is missing a guard) - the dead bytes stay NOP-filled\n");
    return 1;
}

# _env_scratch + _read_env live in env.cyr (6.6.10), shared with the cx driver.
include "src/backend/common/env.cyr"

# v6.3.23 (DX-01): shared function-symbol dump — opt-in via the CYRIUS_SYMS env
# var (value = output path). Writes "<16-hex VA> <name>\n" per emitted function so
# a RIP captured by coredumpctl (or the AGNOS/Windows/macOS crash reporter) maps
# back to function+offset. Hoisted here from the x86-only inline block that lived
# in x86/fixup.cyr since v5.x so all backends reach crash-localization parity, not
# just x86-ELF (issue 2026-06-10-unreviewed-dimensions DX-01). The VA base is
# passed in because it is target-specific: ELF entry (x86/aarch64), the Mach-O
# TEXT base (via _entry_base's fmt branch), or the PE ImageBase+text RVA — the
# caller resolves it. Portable syscalls: SYS_OPEN==2 is the x86 raw `open`; every
# other arch (aarch64) has no bare open, so mirror _read_env's openat(AT_FDCWD)
# shim. Flags 0x241 = O_WRONLY|O_CREAT|O_TRUNC, mode 0x1A4 = 0644. Entirely behind
# the `sym_path != 0` guard → zero effect (byte-identical emitted programs) unless
# CYRIUS_SYMS is set. cx never calls this (it has no symbol dump).
fn _emit_sym_dump(S, base): i64 {
    var sym_path = _read_env("CYRIUS_SYMS");
    if (sym_path == 0) { return 0; }
    var symfd = 0;
    if (SYS_OPEN == 2) { symfd = syscall(SYS_OPEN, sym_path, 0x241, 0x1A4); }
    else { symfd = syscall(SYS_OPEN, 0 - 100, sym_path, 0x241, 0x1A4); }
    if (symfd < 0) { return 0; }
    var sym_fnc = GFNC(S);
    var sfi = 0;
    while (sfi < sym_fnc) {
        var foff = L64(_fnt_offsets + sfi * 8);
        if (foff >= 0) {
            var vabuf[20];
            var va = base + foff;
            var vi2 = 15;
            while (vi2 >= 0) {
                var hd = va & 15;
                if (hd < 10) { store8(&vabuf + vi2, 48 + hd); }
                else { store8(&vabuf + vi2, 87 + hd); }
                va = va >> 4;
                vi2 = vi2 - 1;
            }
            syscall(SYS_WRITE, symfd, &vabuf, 16);
            syscall(SYS_WRITE, symfd, " ", 1);
            var nptr = S + 0xEC00000 + L64(_fnt_names + sfi * 8);
            var nlen = 0;
            while (load8(nptr + nlen) != 0) { nlen = nlen + 1; }
            syscall(SYS_WRITE, symfd, nptr, nlen);
            syscall(SYS_WRITE, symfd, "\n", 1);
        }
        sfi = sfi + 1;
    }
    syscall(SYS_CLOSE, symfd);
    return 0;
}

# v6.3.3 #5: parse a "0x<hex>" env string -> i64 (0 on empty / missing 0x / a bad
# digit). The only 0x-hex env parser in the compiler (CYRIUS_DCE_CAP is decimal);
# CYRIUS_KERNEL_BASE (and the `[sections] base` manifest key that funnels into it)
# uses it to set the kernel load/link base. Loads + arithmetic only — no fn calls,
# no tail call — so cybs derives it cleanly (seed-derive gate).
fn _parse_hex_env(p): i64 {
    if (load8(p) != 48) { return 0; }       # '0'
    if (load8(p + 1) != 120) { return 0; }   # 'x'
    var v = 0;
    var i = 2;
    var c = load8(p + i);
    if (c == 0) { return 0; }                 # "0x" with no digits
    while (c != 0) {
        var d = 0 - 1;
        if (c >= 48 && c <= 57) { d = c - 48; }          # 0-9
        elif (c >= 97 && c <= 102) { d = c - 97 + 10; }  # a-f
        elif (c >= 65 && c <= 70) { d = c - 65 + 10; }   # A-F
        else { return 0; }
        v = v * 16 + d;
        i = i + 1;
        c = load8(p + i);
    }
    return v;
}

# Nanosecond wall clock for CYRIUS_PROF (v5.6.5 O1 + v5.6.6).
# Linux x86_64: clock_gettime(CLOCK_MONOTONIC=1) via syscall 228.
# Linux aarch64: the SAME raw 228 — ESYSXLAT's ELF arm carries the
# `228 → 113` row, so the number is renumbered at emit. v6.6.5 deleted
# the `#ifdef CYRIUS_ARCH_AARCH64 syscall(113, …)` arm that used to sit
# here: an arch-guarded NATIVE syscall number is the exact shape this
# release's shadow class is about (a later compat row whose SOURCE is
# 113 would silently reissue it), and the compiler's own source was the
# one place still writing it after the guide rule went in. Latent, not
# live — 113 is a row PRODUCT today and nothing sources it — but the
# x86 spelling is the supported one and costs nothing: the chain is
# emitted inline at every aarch64 syscall site regardless, so the two
# spellings are byte-for-byte the same size. CHANGELOG [6.6.5]
# Windows PE: syscall(228, _, _) rerouted by EGETTICKS_PE to
# kernel32!GetTickCount64; returns ms in rax, scaled to ns here.
# macOS arm64: syscall(228, 4, _) rerouted by EMACHO_CLOCK_ARM to
# libSystem _clock_gettime_nsec_np(CLOCK_MONOTONIC_RAW=4) via
# __got[6]; returns u64 ns directly in x0 — the third arg is IGNORED.
# macOS x86_64: syscall(228, 4, &tv) rerouted by EMACHO_CLOCK_X86, which issues gettimeofday
# with the third arg as tp — the kernel WRITES a timeval there — and returns mach time (ns,
# Intel 1:1 timebase) for id 4 since 6.6.12 (id 0 composes the timeval). v6.5.43: this
# fn passed a literal 0 there, so CYRIUS_PROF SIGSEGV'd on Intel-Mac while working on ecb —
# one `#ifdef CYRIUS_TARGET_MACOS` covering two backends with different pointer contracts.
# The buffer is now always real, which both routes accept.
# Non-Linux non-PE non-macOS: returns 0 (no clock available).
fn _prof_clock_ns(): i64 {
    #ifdef CYRIUS_TARGET_WIN
    var _ms = syscall(228, 0, 0);
    return _ms * 1000000;
    #endif
    var ts[16];
    store64(&ts, 0); store64(&ts + 8, 0);
    #ifdef CYRIUS_TARGET_MACOS
    return syscall(228, 4, &ts);
    #endif
    #ifdef CYRIUS_TARGET_LINUX
    syscall(228, 1, &ts);
    #endif
    return load64(&ts) * 1000000000 + load64(&ts + 8);
}

# Record a fixup entry — append (codepos, var_idx) to the fixup
# table at _fixup_base. AR-03 (v6.2.0): the table is now GROWABLE —
# GFCNT() doubles _fixup_base/_fixup_cap (via _fixup_grow) the moment
# the count reaches the cap, so the writers never cap-check. Initial
# cap is 1048576 (16 MiB at S+0x107B000); _fixup_grow alloc()s a fresh
# 2× buffer off the heap and copies the live entries, up to a 64M-entry
# runaway ceiling. This retired the 10 per-writer `fc >= 1048576` hard-
# error checks that spuriously rejected big programs (the v6.1.38 cap-
# unification was the last fixed-region patch before this migration).
# Note: cx/emit.cyr has its own RECFIX (fixed cap 1048576, region
# 0x150B000) — main_cx.cyr leaves _fixup_cap at 0, so the `_fixup_cap != 0`
# guard in GFCNT leaves the cx path on its fixed storage (6.6.20; v6.5.13 had set it).
fn RECFIX(S, idx): i64 {
    var fc = GFCNT(S);
    var addr = _fixup_base + fc * 16;
    S64(addr, GCP(S));
    S64(addr + 8, idx);
    SFCNT(S, fc + 1);
    return 0;
}

# v6.1.35 (CVE-23): shared output-buffer cap guard. The cap is `_output_cap` — the off-heap
# `_output_base` alloc, 1 GiB since v6.4.51/.52. At v6.1.35 the buffer was the fixed 16 MB
# region at S+0x4D9D000 (output_buf end 0x5D9D000; brk-final 0x5E1D000), cap-checked inline only in
# the x86 EMITELF_USER/SHARED/OBJ + Mach-O writers; the aarch64 ELF emitter,
# both kernel-ELF emitters, and the PE writer wrote past it unchecked. The
# overrun happens DURING emit, before the single flush point, so a flush-time
# guard is too late — each writer calls this with the TRUE final on-disk size
# (the section-header table sits past the PT_LOAD filesz, so the arg is
# shdr_off + shnum*shentsize, NOT filesz — a filesz-only check left a
# ~370 B/ELF64 (~240 B/ELF32) window just under 16 MB; mirror EMITELF_OBJ)
# BEFORE its first output_buf store. Mirrors EMITELF_USER's top-3-largest-vars
# diagnostic (so the user learns which `var buf[N]` blew the budget). Exits 1
# on overflow; a no-op for in-cap output → byte-identical valid builds. Kernel
# images (the AGNOS authorship goal + v6.2.x bare-metal) were exactly the
# unguarded path. See CHANGELOG [6.1.35].
fn _check_output_cap(S, filesz): i64 {
    if (filesz > _output_cap) {
        syscall(SYS_WRITE, 2, "error: output too large (", 25);
        PRNUM(filesz);
        syscall(SYS_WRITE, 2, "/", 1);
        PRNUM(_output_cap);
        syscall(SYS_WRITE, 2, " bytes)", 7);
        var vcount = GVCNT(S);
        var top1_sz = 0; var top1_ix = 0 - 1;
        var top2_sz = 0; var top2_ix = 0 - 1;
        var top3_sz = 0; var top3_ix = 0 - 1;
        var vi = 0;
        while (vi < vcount) {
            var vsz = L64(_vars_base + vi * 8);
            if (vsz > top1_sz) {
                top3_sz = top2_sz; top3_ix = top2_ix;
                top2_sz = top1_sz; top2_ix = top1_ix;
                top1_sz = vsz; top1_ix = vi;
            } elif (vsz > top2_sz) {
                top3_sz = top2_sz; top3_ix = top2_ix;
                top2_sz = vsz; top2_ix = vi;
            } elif (vsz > top3_sz) {
                top3_sz = vsz; top3_ix = vi;
            }
            vi = vi + 1;
        }
        if (top1_ix >= 0) {
            syscall(SYS_WRITE, 2, "\n  largest vars:\n    ", 21);
            PRNUM(top1_sz);
            syscall(SYS_WRITE, 2, " bytes: ", 8);
            var nptr = S + 0xEC00000 + L64(_varn_base + top1_ix * 8);
            var nlen = 0;
            while (load8(nptr + nlen) != 0) { nlen = nlen + 1; }
            syscall(SYS_WRITE, 2, nptr, nlen);
            if (top2_ix >= 0) {
                syscall(SYS_WRITE, 2, "\n    ", 5);
                PRNUM(top2_sz);
                syscall(SYS_WRITE, 2, " bytes: ", 8);
                nptr = S + 0xEC00000 + L64(_varn_base + top2_ix * 8);
                nlen = 0;
                while (load8(nptr + nlen) != 0) { nlen = nlen + 1; }
                syscall(SYS_WRITE, 2, nptr, nlen);
            }
            if (top3_ix >= 0) {
                syscall(SYS_WRITE, 2, "\n    ", 5);
                PRNUM(top3_sz);
                syscall(SYS_WRITE, 2, " bytes: ", 8);
                nptr = S + 0xEC00000 + L64(_varn_base + top3_ix * 8);
                nlen = 0;
                while (load8(nptr + nlen) != 0) { nlen = nlen + 1; }
                syscall(SYS_WRITE, 2, nptr, nlen);
            }
        }
        syscall(SYS_WRITE, 2, "\n  tip: heap-allocate large var buf[N] arrays (alloc(N) + pointer)\n", 67);
        syscall(SYS_EXIT, 1);
    }
    return 0;
}

# ================================================================
# DCE shared probes (v6.1.5) — hoisted from the byte-identical copies
# in x86/fixup.cyr + aarch64/fixup.cyr. The mark-and-sweep reachability
# pass in each backend's FIXUP duplicated two arch-identical lookups, and
# each was written twice within a backend: the open-addressing fn_start→fi
# hash probe (seed + propagate) and the linear host-fn [start,end) scan
# (seed + undef-fn). The only arch delta is the opcode-scan STRIDE
# (x86 E8/E9 + DECODE_LEN vs aarch64 BL/B fixed 4-byte), which stays inline
# in each FIXUP. These two lookups read the same heap regions on both
# arches, so they unify here. Logic-preserving — see CHANGELOG [6.1.5].

# fn_start → fn-index lookup over the 8192-slot open-addressing hash at
# S+0x114000 (built once per FIXUP before the DCE byte-scan). Knuth
# golden-ratio multiplicative hash (0x9E3779B97F4A7C15 = floor(2^64/phi)),
# slot 0.._fnt_hash_mask, masked by `_fnt_hash_mask` (DYNAMIC since v6.2.0, grows
# with _fnt_cap 8192→32768 — the old "slot 0..8191, mask 8191" was fixed-cap text).
# Returns the fn whose start offset == tgt, or -1 on miss. Byte-identical to the
# four inline probe loops it replaces — the old loop-exit on empty-slot / match
# becomes a direct return; same termination, same result.
fn _dce_hash_lookup(S, tgt): i64 {
    var h = (tgt * 0x9E3779B97F4A7C15) >> 16;
    var slot = h & _fnt_hash_mask;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_starthash + slot * 4);
        if (stored == 0) { return 0 - 1; }
        var fi = stored - 1;
        if (L64(_fnt_offsets + fi * 8) == tgt) { return fi; }
        slot = (slot + 1) & _fnt_hash_mask;
        probes = probes + 1;
    }
    return 0 - 1;
}

# 6.6.10 — the dead-static attribution behind the "large static data" hint
# (_warn_large_static, parse_fn.cyr): bytes of array statics declared inside UNREACHABLE fns,
# and how many such fns hold them, stashed in the DCE-warning cells 0x18FCD8 / 0x18FCE0 for
# the emitters. `live` is the caller's reachability bitmap. Shared by the x86 and aarch64
# FIXUPs. Two defects it replaces: the x86 loop (inline in FIXUP) counted EVERY dead fn, so
# one static holder plus two empty dead fns printed "inside 3 unreachable fn(s)"; and the
# aarch64 FIXUP had live[] but never computed either number, so the hint never fired there
# (EMITELF passed 0, 0). Only fns with GFVB > 0 count now. CHANGELOG [6.6.10]
fn _dead_static_stash(S, live, fnc): i64 {
    var dvb = 0;
    var dcn = 0;
    var fi = 0;
    while (fi < fnc) {
        if (L64(_fnt_offsets + fi * 8) >= 0) {
            if ((load8(live + (fi >> 3)) & (1 << (fi & 7))) == 0) {
                var vb = GFVB(S, fi);
                if (vb > 0) { dvb = dvb + vb; dcn = dcn + 1; }
            }
        }
        fi = fi + 1;
    }
    S64(S + 0x18FCD8, dvb);
    S64(S + 0x18FCE0, dcn);
    return 0;
}

# Host fn for a code offset: the fn whose [start, end) range contains
# `coff`, or -1 when `coff` lies outside every fn body (entry / top-level
# code → conservative ROOT in the seed pass; always-live in the undef-fn
# check). Linear scan over the fn_start table at S+0x9CA000 (ends via
# GFNE); returns the FIRST match in index order. Byte-identical to the
# four inline host-scan loops it replaces — the old `host = fj; fj = fnc`
# early-exit (guarded so it didn't re-increment) becomes a direct return.
fn _dce_host_fn(S, coff, fnc): i64 {
    var fj = 0;
    while (fj < fnc) {
        var fs = L64(_fnt_offsets + fj * 8);
        if (fs >= 0) {
            var fe = GFNE(S, fj);
            if (fe > fs && coff >= fs && coff < fe) { return fj; }
        }
        fj = fj + 1;
    }
    return 0 - 1;
}
