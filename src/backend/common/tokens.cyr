# ================================================================
# Token-stream accessors — shared across backends (v6.0.8 collapse)
# ================================================================
# Before v6.0.8 these four fns lived byte-identically in
# src/backend/x86/emit.cyr, src/backend/aarch64/emit.cyr, AND
# src/backend/cx/emit.cyr. The bodies are pure heap-offset reads
# with no arch-specific encoding, so they belong in common/.
# Region offsets (0x8C00000 / 0xAC00000) come from the v5.8.46 +
# v5.11.68 heap-map layout — shared by all three backends.

fn TOKTYP(S, i): i64 { return L64(S + 0x8C00000 + i * 8); }
fn TOKVAL(S, i): i64 { return L64(S + 0xAC00000 + i * 8); }
# v6.4.62: anti-hang watchdog (inert until the first error).
# v6.4.78: past-end EOF clamp, placed INSIDE the existing `_had_error == 1` guard so
# it costs NOTHING on the hot path — PEEKT is the most-called fn in the parser, and
# that compare-against-a-global is already there for the watchdog.
#
# THE BUG: TOKTYP is an unchecked `L64`. Past GTCNT it reads zeroed heap and returns
# token type 0 — never 12 (EOF). So every `t == 12` EOF test in `_sync_skip` and the
# block loops silently failed, panic-mode recovery could never terminate normally,
# and PARSE_STMT's forced-progress guard was disarmed too (it only advances while
# `GTI < GTCNT`, exactly the condition that is false there). Truncated input — a
# clipped file, an unclosed `fn`, EOF mid-expression — therefore spewed **166,670**
# stderr lines before the watchdog aborted. Not a hang, but unusable output that
# buries the real error. (issues/archived/2026-07-24-truncated-input-166k-line-error-cascade.md)
#
# ⛔ v6.5.19 — THE `_had_error` GATE ON THE CLAMP WAS WRONG, AND IT HID 40 CRASHES.
# v6.4.78 placed the clamp INSIDE the watchdog's `_had_error == 1` guard and justified
# it with: "a WELL-FORMED parse never advances past [EOF] — GTI < GTCNT holds until an
# error occurs. The runaway is exclusively a post-error recovery phenomenon." **That
# premise is false.** Several parse paths walk off the end of the token array BEFORE
# emitting any diagnostic at all — `_prescan_fn_sig` and the type/generic skippers run
# ahead of the error machinery — so `_had_error` is still 0, the clamp is bypassed,
# TOKTYP's unchecked `L64` returns zeroed heap as token type 0, and every `t == 12`
# EOF test in the codebase silently fails. MEASURED at 6.5.18: of 103 truncated
# top-level constructs, **40 crashed or hung**, and `fn`, `var x`, `async` (2-5 bytes)
# SIGSEGV'd with **ZERO bytes of stderr** — no error line, no diagnostic, nothing.
# That is a bare `cat file.cyr | cycc` on a clipped file, i.e. reachable from untrusted
# source, which is the include filename-capture overflow bug/the READFILE path-composition overflow bug/the long-HOME
# overflow bug class. See docs/audit/2026-08-11-security-audit.md
# (the include-length ifdef bug) and tests/gates/diagnostics/truncated_input_terminates.sh.
#
# So the clamp is now UNCONDITIONAL. The cost objection in the old comment does not
# apply to it: it was written about clamping inside TOKTYP, which would tax the
# `TOKTYP(S, GTI(S) + 1)` lookahead sites too. Here it is one compare against a global
# in PEEKT only — measured at self_compile −0.4 % / +0.2 % across runs, i.e. inside
# noise, against a whole crash class removed. Correctness of a compiler reading
# untrusted stdin is not a hot-path trade.
#
# The watchdog stays gated on `_had_error` (it is post-error recovery machinery, and
# `_wd_tick` on every clean-path PEEKT would be a real cost) — but it now also counts
# advancing-past-EOF as non-progress, so a desynced loop that keeps INCREMENTING GTI
# is bounded too. Before v6.5.19 it only detected a STALL, so the enum/struct/union
# member loops (which advance every iteration) ran free and overflowed a 1024-entry
# table into a SIGSEGV at ~1027 iterations, long before the 500000 stall bound.
# Defence in depth: the clamp makes existing EOF guards work, the loops below have
# their own guards, and the watchdog bounds anything still missed.
fn PEEKT(S): i64 {
    if (GTI(S) >= GTCNT(S)) {
        _wd_eof_tick(S);
        return 12;
    }
    if (_had_error == 1) { _wd_tick(S); }
    return TOKTYP(S, GTI(S));
}
fn PEEKV(S): i64 { return TOKVAL(S, GTI(S)); }

# 6.7.14 — an asm-block refusal (D16, 2026-10-16: a mnemonic the assembler does not have, or an
# operand its instruction cannot take, stops the compile) names the token at fault, token `ti`, at
# its location with the excerpt, then skips the rest of the asm statement — to its `;`, or to the
# block's `}` — so the block loop moves on instead of stalling on an operand. `msg` precedes the
# quoted token; the backends call it (x86 / aarch64 / cx emit.cyr). CHANGELOG [6.7.14]
fn _asm_refuse(S, ti, msg): i64 {
    STI(S, ti);
    if (_panic == 0) {
        syscall(SYS_WRITE, 2, "error:", 6);
        _err_head(S);
        syscall(SYS_WRITE, 2, ": ", 2);
        PRSTR(msg);
        _asm_tok_text(S, ti);
        syscall(SYS_WRITE, 2, "\n", 1);
        _err_excerpt(S);
        _had_error = 1;
        _panic = 1;
    }
    STI(S, ti + 1);
    _asm_skip_stmt(S);
    return 1;
}

# Token `ti` quoted as the source spells it: an identifier from the name pool; anything else (a
# number, a keyword such as `in`, punctuation) from the expanded source at its offset.
fn _asm_tok_text(S, ti): i64 {
    syscall(SYS_WRITE, 2, "'", 1);
    if (TOKTYP(S, ti) == 2) { PRSTR(S + 0xEC00000 + TOKVAL(S, ti)); }
    else {
        var off = GTOFF(S, ti);
        var e = off;
        var go = 1;
        while (go == 1) {
            var c = load8(S + 0x459D000 + e);
            go = 0;
            if (c >= 48) { if (c <= 57) { go = 1; } }
            if (c >= 65) { if (c <= 90) { go = 1; } }
            if (c >= 97) { if (c <= 122) { go = 1; } }
            if (c == 95) { go = 1; }
            if (go == 1) { e = e + 1; }
        }
        if (e == off) { e = off + 1; }
        syscall(SYS_WRITE, 2, S + 0x459D000 + off, e - off);
    }
    syscall(SYS_WRITE, 2, "'", 1);
    return 0;
}

fn _asm_skip_stmt(S): i64 {
    var t = PEEKT(S);
    var go = 1;
    while (go == 1) {
        if (t == 5) { go = 0; }
        if (t == 14) { go = 0; }
        if (t == 12) { go = 0; }
        if (go == 1) { STI(S, GTI(S) + 1); t = PEEKT(S); }
    }
    if (t == 5) { STI(S, GTI(S) + 1); }
    return 0;
}
