# v6.5.35 — stub. `RA_SCAN_LOOPS` really lives in src/backend/x86/decode.cyr, which this
# fork does not include; `parse_fn.cyr` is shared by every fork and calls it. Returning -1
# means "no loop information", which the caller must already handle by falling back to the
# conservative whole-function interval extent — so the picker behaves exactly as it did
# before v6.5.35 here. (The x86 regalloc post-pass does not run on these targets anyway;
# this exists so the shared frontend RESOLVES, the same reason the E*_PE reroutes carry
# return-0 stubs in these two files.)
fn RA_SCAN_LOOPS(base, lo, hi, out_t, out_s, cap): i64 { return 0 - 1; }

# v6.5.64 — symbol-resolution stub. The direct 128-bit emitter is an x86 fast path; PARSE_SIMD_EXT
# gates the whole detection on `_AARCH64_BACKEND == 0 && _TARGET_CX == 0` and never reaches this,
# but an undefined fn has been a HARD ERROR since v6.3.2, so every fork that compiles parse_expr.cyr
# needs the symbol. Returning 0 without emitting is correct precisely because it is unreachable —
# do NOT make this a partial implementation.
fn EMIT_VEC_DIRECT(S, op, dst_li, a_li, b_li, dbl): i64 { return 0; }

# v6.5.66 — symbol-resolution stub. `_F64V_DISP` is the x86 frame-displacement helper
# (backend/x86/float.cyr), which this fork does not include. `_inl_simd_arg` in the SHARED
# frontend references it, and although that reference is gated behind a runtime
# `_AARCH64_BACKEND`/`_TARGET_CX` test — so it is never executed here — the CALL SITE still has
# to resolve: an undefined fn has been a hard error since v6.3.2, and without this the three
# aarch64 forks and main_cx.cyr fail to build outright (measured rc=256 on main_aarch64_macho).
# Returning 0 is correct precisely because it is unreachable; do NOT make it a real
# implementation, since this fork's frame displacement uses a DIFFERENT formula (positive
# magnitude, ret_stash only, no regalloc term — see the note above ADDR_FP).
fn _F64V_DISP(idx): i64 { return 0; }

# Byte size of the global var named exactly `lit` (a C string), or 0 when there is none.
# main_cx.cyr uses it to leave lib/alloc_cx.cyr's own heap out of the static-data advisory.
# cx-only, so it lives in this backend rather than shared parse_fn.cyr, where it was
# unreachable code in the six other forks. CHANGELOG [6.6.20]
fn _gvar_bytes_named(S, lit): i64 {
    var vi = 0;
    var n = GVCNT(S);
    while (vi < n) {
        var p = S + 0xEC00000 + L64(_varn_base + vi * 8);
        var k = 0;
        while (load8(p + k) != 0 && load8(p + k) == load8(lit + k)) { k = k + 1; }
        if (load8(p + k) == 0 && load8(lit + k) == 0) { return L64(_vars_base + vi * 8); }
        vi = vi + 1;
    }
    return 0;
}
