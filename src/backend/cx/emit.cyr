# ================================================================
# CYRIUS-X BYTECODE EMISSION
# ================================================================
# Emits register-based bytecode instead of x86 machine code.
# Same interface as x86/emit.cyr so the shared frontend works unchanged.
#
# A register operand is a full byte, so the bytecode has r0-r255. The emitter maps:
#   rax → r0 (accumulator, expression results)
#   rcx → r1 (secondary, right-hand operand)
#   stack push/pop → the VM's data stack (push/pop opcodes 0x80/0x81)
#   fp → r253, sp → r254
# ⚠ cxvm's register file must therefore hold all 256 (2048 bytes). It held 32 until 6.6.8,
# which put fp/sp inside guest memory. CHANGELOG [6.6.8]
#
# Each instruction is 4 bytes: [opcode][ra][rb][rc] (little-endian in output)

# v5.7.11: stubs matching backend/x86/emit.cyr — parse.cyr / parse_expr.cyr
# / parse_decl.cyr / parse_fn.cyr reference these in shared codepaths
# (`if (_AARCH64_BACKEND == 1)`, `if (_TARGET_MACHO == ...)`, etc.).
# cx backend is x86-shaped, never aarch64/mach-o/PE — all 0.
# Drifted out of sync over multiple v5.6.x/v5.7.x minors because no
# CI gate builds main_cx.cyr; v5.7.11 fixes the drift + adds the gate.
var _AARCH64_BACKEND = 0;
var _TARGET_MACHO = 0;
var _TARGET_PE = 0;
var _TARGET_ELF64_KERNEL = 0;
# v5.11.47: UEFI Application PE emit marker. cx (bytecode) has no PE
# emission; this is a parser-resolution stub kept consistent with the
# x86/aarch64 emit headers.
var _TARGET_EFI_APPLICATION = 0;
# v6.0.48: AGNOS target marker — x86-only; always-zero parser-resolution
# stub (parse_expr.cyr references _TARGET_AGNOS in the syscall arity skip).
var _TARGET_AGNOS = 0;
# v5.7.12: this is the cyrius-x bytecode backend. =1 here so
# parse_*.cyr can gate direct x86-byte emits via
# `if (_TARGET_CX == 0)` (path B from
# docs/audit/2026-04-27-cx-direct-emit-inventory.md).
var _TARGET_CX = 1;
# v5.6.8 flag-reuse tracker — defined in x86 + aarch64 emit; mirror
# here so parse_ctrl.cyr / parse_expr.cyr resolve the symbol on cx
# builds. Always 0 on cx — bytecode has no flag-reuse semantic.
var _flags_reflect_rax = 0;
# v5.6.9 push/pop-cancel + v5.6.10 combine-shuttle peephole trackers.
# x86 + aarch64 emit use these for peephole rewinds; cx emits 4-byte
# bytecode instructions, has no equivalent peephole, so trackers are
# always "no last push/movca recorded" (= -1).
var _last_push_cp = 0 - 1;
var _last_emovca_cp = 0 - 1;
var _last_movca_popr_cp = 0 - 1;
# x86 inline-fn toggle. cx does not inline; 0.
var _INLINE_OK = 0;

# Emit byte to codebuf (same as x86/emit.cyr but for bytecode)
fn EB(S, b): i64 {
    var cp = GCP(S);
    if (cp >= 524288) {
        syscall(SYS_WRITE, 2, "error: codebuf overflow\n", 24);
        syscall(SYS_EXIT, 1);
    }
    store8(S + 0x54A000 + cp, b & 0xFF);
    SCP(S, cp + 1);
    return 0;
}

fn CX_EMIT(S, op, ra, rb, rc): i64 {
    EB(S, op & 0xFF);
    EB(S, ra & 0xFF);
    EB(S, rb & 0xFF);
    EB(S, rc & 0xFF);
    return 0;
}

# Emit 16-bit immediate load (movi ra, imm16)
fn CX_MOVI(S, reg, val): i64 {
    # v6.4.58: build the full 64-bit constant from FOUR 16-bit chunks. movi loads
    # bits 0-15; movhi/movhh/movhk OR in bits 16-31 / 32-47 / 48-63. The old code
    # stopped at bit 47 (no top-word emit) so any constant with set bits in 48-63
    # (e.g. f64 6.0 = 0x4018<<48) silently loaded 0. Test each higher word with a
    # LOGICAL >> (not the old signed `val > 0xFFFFFFFF` magnitude test) so bit-63 /
    # negative constants load their top word too. See issue
    # 2026-07-11-cx-fmt-int-and-large-immediate-gaps.md.
    CX_EMIT(S, 1, reg, val & 0xFF, (val >> 8) & 0xFF);
    if (((val >> 16) & 0xFFFF) != 0) {
        # movhi: ra |= (imm16 << 16)
        CX_EMIT(S, 254, reg, (val >> 16) & 0xFF, (val >> 24) & 0xFF);
    }
    if (((val >> 32) & 0xFFFF) != 0) {
        # movhh: ra |= (imm16 << 32)
        CX_EMIT(S, 255, reg, (val >> 32) & 0xFF, (val >> 40) & 0xFF);
    }
    if (((val >> 48) & 0xFFFF) != 0) {
        # movhk: ra |= (imm16 << 48) — top 16 bits (v6.4.58)
        CX_EMIT(S, 253, reg, (val >> 48) & 0xFF, (val >> 56) & 0xFF);
    }
    return 0;
}

# ================================================================
# INTERFACE FUNCTIONS (match x86/emit.cyr signatures)
# ================================================================

# emit byte — shared with x86, writes to codebuf
# EB is defined in the including main file (or we redefine here)

# mov rax, imm64
fn EMOVI(S, v): i64 {
    CX_MOVI(S, 0, v);
    return 0;
}

# push rax (spill to virtual register)
fn EPUSHR(S): i64 {
    CX_EMIT(S, 128, 0, 0, 0);
    return 0;
}
# pop rax
fn EPOPR(S): i64 {
    CX_EMIT(S, 129, 0, 0, 0);
    return 0;
}
# 6.6.7 — the defer walker's save: r0-r5, the whole return convention (r0; the r0-r3 f64v4
# quad; the r4 pair / Ok-Err payload; the r5 arity-3 slot), not r0 alone. CHANGELOG [6.6.7]
fn EDEFER_SAVE(S): i64 {
    var r = 0;
    while (r < 6) { CX_EMIT(S, 128, r, 0, 0); r = r + 1; }
    return 0;
}
fn EDEFER_RESTORE(S): i64 {
    var r = 5;
    while (r >= 0) { CX_EMIT(S, 129, r, 0, 0); r = r - 1; }
    return 0;
}
# pop rcx
fn EPOPC(S): i64 {
    CX_EMIT(S, 129, 1, 0, 0);
    return 0;
}

# Expression spill (same as push/pop for bytecode)
fn ESPILL(S): i64 { EPUSHR(S); return 0; }
fn EUNSPILL(S): i64 { EPOPR(S); return 0; }

# mov rcx, rax
fn EMOVCA(S): i64 { CX_EMIT(S, 2, 1, 0, 0); return 0; }

# Arithmetic: result in r0, operands r0 and r1
fn EADDR(S): i64 { CX_EMIT(S, 16, 0, 0, 1); return 0; }    # add r0, r0, r1
# v5.11.51: r0 += imm. Compose via CX_MOVI to scratch r1 + add — the
# cx bytecode doesn't have a single add-imm form. Used by byte-array
# literal `var foo[N] = { 0x.., ... };` to compute &var + i.
fn EADDRA_IMM(S, n): i64 {
    CX_MOVI(S, 1, n);
    CX_EMIT(S, 16, 0, 0, 1);   # add r0, r0, r1
    return 0;
}
fn ESUBR(S): i64 { CX_EMIT(S, 17, 0, 0, 1); return 0; }    # sub r0, r0, r1
fn EIMUL(S): i64 { CX_EMIT(S, 18, 0, 0, 1); return 0; }    # mul r0, r0, r1
fn ECQO(S): i64 { return 0; }                                 # no-op (sign extend for div)
# v6.4.58: cx has no dual-output divide (x86 IDIV yields quotient in rax AND remainder
# in rdx from ONE instruction; the shared frontend emits `ECQO; EIDIV; EMOVDR` and
# EMOVDR just reads rdx). cx `div` OVERWRITES the dividend (r0) with the quotient, so
# the old EMOVDR `mod r0, r0, r1` computed (n/d) % d, not n % d — every cx `%` was
# wrong (fmt_int printed "01234" for 12345). Fix: EIDIV stashes the dividend to r13
# first; EMOVDR takes the remainder of that stashed dividend. EIDIV/EMOVDR are always
# emitted adjacently (ir.cyr IR_MOD) and r13 is otherwise unused across the pair.
fn EIDIV(S): i64 { CX_EMIT(S, 2, 13, 0, 0); CX_EMIT(S, 19, 0, 0, 1); return 0; }  # r13 = r0 (dividend); r0 = r0 / r1
fn EMOVDR(S): i64 { CX_EMIT(S, 20, 0, 13, 1); return 0; }                          # r0 = r13 % r1 (true remainder)

# Bitwise
fn EANDR(S): i64 { CX_EMIT(S, 32, 0, 0, 1); return 0; }
fn EORR(S): i64 { CX_EMIT(S, 33, 0, 0, 1); return 0; }
fn EXORR(S): i64 { CX_EMIT(S, 34, 0, 0, 1); return 0; }
# `~x` = x XOR all-ones, the all-ones built in r1 (dead here: every caller has just parsed the
# operand into r0, or ends a shift whose count r1 held). It XORed with r31, which nothing ever set:
# cxvm zeroes its registers, so `~x` was `x` and `bitset` / `bitclr`'s `~mask` was `mask`, while
# r31 is also an argument register from 29 arguments on. CHANGELOG [6.7.6]
fn ENOTR(S): i64 {
    CX_MOVI(S, 1, 0 - 1);                 # r1 = all-ones (movi + movhi + movhh + movhk)
    CX_EMIT(S, 34, 0, 0, 1);              # xor r0, r0, r1
    return 0;
}
fn ESHLCL(S): i64 { CX_EMIT(S, 35, 0, 0, 1); return 0; }   # shl r0, r0, r1
fn ESHRCL(S): i64 { CX_EMIT(S, 36, 0, 0, 1); return 0; }   # shr r0, r0, r1
fn EASHRCL(S): i64 { CX_EMIT(S, 37, 0, 0, 1); return 0; }  # asr r0, r0, r1 (`>>>`)

# Load/store memory
fn ELOAD8(S): i64 { CX_EMIT(S, 64, 0, 0, 0); return 0; }   # load8 r0, [r0]
# v5.9.40: ELOAD16/ELOAD32 had approximations; wire them to the
# now-real cxvm 0x44/0x45 opcodes added this slot. ELOAD64 and
# ELODC stay the same.
fn ELOAD16(S): i64 { CX_EMIT(S, 68, 0, 0, 0); return 0; }  # load16 r0, [r0]
fn ELOAD32(S): i64 { CX_EMIT(S, 69, 0, 0, 0); return 0; }  # load32 r0, [r0]
fn ELOAD64(S): i64 { CX_EMIT(S, 65, 0, 0, 0); return 0; }  # load64 r0, [r0]
fn ELODC(S): i64 { CX_EMIT(S, 65, 0, 1, 0); return 0; }    # load64 r0, [r1]
fn ESTORE8(S): i64 { CX_EMIT(S, 66, 1, 0, 0); return 0; }  # store8 [r1], r0
# v5.9.40: ESTORE16/ESTORE32 also had approximations; wire to real
# cxvm 0x46/0x47 opcodes. ESTORE64 / ESTOC stay the same.
fn ESTORE16(S): i64 { CX_EMIT(S, 70, 1, 0, 0); return 0; }
fn ESTORE32(S): i64 { CX_EMIT(S, 71, 1, 0, 0); return 0; }
fn ESTORE64(S): i64 { CX_EMIT(S, 67, 1, 0, 0); return 0; }
fn ESTOC(S): i64 { CX_EMIT(S, 67, 1, 0, 0); return 0; }    # store64 [r1], r0

# ⛔ 6.7.6 (Break 1, D2) — u128 `+` / `-` (parse_expr.cyr _w128_*): r1 = a 16-byte accumulator;
# EW128_ACCM takes r0 = the ADDRESS of a u128, EW128_ACCI r0 = an integer, zero-extended. op 0 adds,
# 1 subtracts, 2 copies / sets. cxvm has no carry flag, so the carry is computed: an unsigned
# `a < b` is the signed compare of `a ^ (1 << 63)` and `b ^ (1 << 63)`. r8-r12 are scratch (self-
# contained, as the SIMD loops use them); r0 is free once the source is read. CHANGELOG [6.7.6]
fn EW128_ACCM(S, op): i64 {
    CX_EMIT(S, 65, 8, 0, 0);              # load64 r8, [r0]          the source's low word
    CX_MOVI(S, 11, 8);
    CX_EMIT(S, 16, 10, 0, 11);            # add r10, r0, r11
    CX_EMIT(S, 65, 10, 10, 0);            # load64 r10, [r10]        its high word
    if (op == 2) {
        CX_EMIT(S, 67, 1, 8, 0);          # store64 [r1], r8
        CX_EMIT(S, 16, 11, 1, 11);        # add r11, r1, r11
        CX_EMIT(S, 67, 11, 10, 0);        # store64 [r11], r10
        return 0;
    }
    return _cx_w128_op(S, op, 8, 10);
}
fn EW128_ACCI(S, op): i64 {
    if (op == 2) {
        CX_EMIT(S, 67, 1, 0, 0);          # store64 [r1], r0
        CX_MOVI(S, 10, 0);
        CX_MOVI(S, 11, 8);
        CX_EMIT(S, 16, 11, 1, 11);        # add r11, r1, r11
        CX_EMIT(S, 67, 11, 10, 0);        # store64 [r11], r10       the high word: 0
        return 0;
    }
    CX_EMIT(S, 2, 8, 0, 0);               # mov r8, r0               the integer
    CX_MOVI(S, 10, 0);                    # its high word
    return _cx_w128_op(S, op, 8, 10);
}
# [r1] (op)= the pair (lo, hi): the low words, the carry (add: sum <u lo) or borrow (sub: acc <u lo,
# taken before the subtraction), then the high words with it.
fn _cx_w128_op(S, op, lo, hi): i64 {
    CX_EMIT(S, 65, 9, 1, 0);              # load64 r9, [r1]          the accumulator's low word
    CX_MOVI(S, 0, 1 << 63);               # r0 = the sign bit
    CX_EMIT(S, 34, 12, lo, 0);            # xor r12, lo, r0
    if (op == 0) {
        CX_EMIT(S, 16, 9, 9, lo);         # add r9, r9, lo
        CX_EMIT(S, 34, 11, 9, 0);         # xor r11, r9, r0
        CX_EMIT(S, 50, 12, 11, 12);       # lt r12, r11, r12         carry = sum <u lo
    } else {
        CX_EMIT(S, 34, 11, 9, 0);         # xor r11, r9, r0
        CX_EMIT(S, 50, 12, 11, 12);       # lt r12, r11, r12         borrow = acc <u lo
        CX_EMIT(S, 17, 9, 9, lo);         # sub r9, r9, lo
    }
    CX_EMIT(S, 67, 1, 9, 0);              # store64 [r1], r9
    CX_MOVI(S, 11, 8);
    CX_EMIT(S, 16, 11, 1, 11);            # add r11, r1, r11         &the high word
    CX_EMIT(S, 65, 9, 11, 0);             # load64 r9, [r11]
    if (op == 0) { CX_EMIT(S, 16, 9, 9, hi); CX_EMIT(S, 16, 9, 9, 12); }   # + hi + carry
    else { CX_EMIT(S, 17, 9, 9, hi); CX_EMIT(S, 17, 9, 9, 12); }           # - hi - borrow
    CX_EMIT(S, 67, 11, 9, 0);             # store64 [r11], r9
    return 0;
}

# Comparison: setCC pattern → compare and set r0 to 0/1
fn ECMPR(S): i64 { return 0; }  # no-op, comparison done inline
# cx arc B follow-up: cx has no flags, and EJCC re-synthesizes a TWO-operand
# `eq r0,r0,r1` on the bare-boolean truthiness path (ECONDCMP's no-cmp branch,
# parse_ctrl.cyr:47-50) where only r0 holds the boolean and r1 is STALE garbage —
# so `if (f64_lt(...))` / `if (bool)` mis-branched ("always true"). x86's ETESTAZ
# emits `test rax,rax` (flag from the single value); cx has no flags, so instead we
# set r1 = 0, turning EJCC's `eq r0,r0,r1` into `eq r0,r0,0` = a genuine `r0 == 0`
# truthiness test. ETESTAZ only fires on the bare-boolean condition path (r1 is
# scratch there — both callers, parse_ctrl.cyr:48 + parse_fn.cyr:3409, are truthiness).
fn ETESTAZ(S): i64 { CX_MOVI(S, 1, 0); return 0; }  # r1 = 0 so EJCC's eq r0,r0,r1 tests r0==0
# v6.5.21: these were `return 0;` stubs, so multi-return (`return (a, b);` and
# the legacy `ret2`/`rethi`) SILENTLY returned the FIRST value twice on cx —
# `return (5, 9)` scored 59 on x86/aarch64/PE and 55 under cxvm, exit 0, no
# diagnostic. The macOS-rot shape: a stub that compiles clean and lies.
# r4 is cx's rdx-peer return register (ECALLPOPS also pops an argument into it
# before a call), and it survives a call —
# cxvm's `call` (op 96) pushes only the PC and EFNPRO/EFNEPI touch only
# fp/sp, so nothing between the callee's write and the caller's read
# clobbers it. Opcode 2 is `mov ra, rb` with ra = DEST.
fn EMOVRDXRAX(S): i64 { CX_EMIT(S, 2, 4, 0, 0); return 0; }  # mov rdx, rax → mov r4, r0
fn EMOVRA_RDX(S): i64 { CX_EMIT(S, 2, 0, 4, 0); return 0; }  # mov rax, rdx → mov r0, r4
# v6.5.21 — THIRD multi-value return slot = r5 (cx's r10 peer). Same
# survivability argument as r4: cxvm's `call` pushes only the PC, and
# EFNPRO/EFNEPI touch only fp/sp.
fn EMOVR3RAX(S): i64 { CX_EMIT(S, 2, 5, 0, 0); return 0; }  # mov r5, r0
fn EMOVRA_R3(S): i64 { CX_EMIT(S, 2, 0, 5, 0); return 0; }  # mov r0, r5
fn ESETCC(S, op): i64 {
    if (op == 17) { CX_EMIT(S, 48, 0, 0, 1); }  # eq
    if (op == 18) { CX_EMIT(S, 49, 0, 0, 1); }  # ne
    if (op == 19) { CX_EMIT(S, 50, 0, 0, 1); }  # lt
    if (op == 20) { CX_EMIT(S, 51, 0, 0, 1); }  # gt
    # `lte`/`gte` have no single cx opcode, so they are `(lhs < rhs) | (lhs == rhs)`.
    # The strict half MUST land in the scratch r2 that the closing `or` reads, and it
    # must compare r0 against r1 in that order — it did NEITHER until 6.6.6. It emitted
    # `lt r0, r1, r0` (destination r0, operands SWAPPED), so the `or` read whatever r2
    # happened to hold from an earlier emit and the strict half was computed backwards
    # AND then destroyed by the following `eq`. Result: `a <= b` / `a >= b` were wrong
    # for every rhs but 0, and wrong even for rhs 0 once anything had left r2 non-zero
    # (ESHLIMM's shift immediate is the common writer — that is why a `g * 8` earlier in
    # the program flipped a later `size <= 0` guard). `>`/`<`/`==`/`!=` are single
    # opcodes and were never affected. CHANGELOG [6.6.6].
    if (op == 21) { CX_EMIT(S, 50, 2, 0, 1); CX_EMIT(S, 48, 0, 0, 1); CX_EMIT(S, 33, 0, 0, 2); }  # lte = lt|eq
    if (op == 22) { CX_EMIT(S, 51, 2, 0, 1); CX_EMIT(S, 48, 0, 0, 1); CX_EMIT(S, 33, 0, 0, 2); }  # gte = gt|eq
    return 0;
}

# Syscall: pop args from stack into r1-r6, syscall, result in r0
fn ESYSCALL(S): i64 { CX_EMIT(S, 112, 0, 0, 0); return 0; }

# Syscall arg pop: VM convention is r1=number, r2-r7=args
# x86 push order: number, arg1, arg2, ... (left to right)
# Pop order (reverse): last arg first, number last
fn ESCPOPS(S, n, lit): i64 {   # lit: the aarch64 fold's literal number; unused here
    if (_sc_argc_refuse(S, n) == 1) { return 0; }   # > 6 arguments: no backend can pass them
    # Pop args into r(n+1) down to r2
    if (n >= 7) { CX_EMIT(S, 129, 7, 0, 0); }
    if (n >= 6) { CX_EMIT(S, 129, 6, 0, 0); }
    if (n >= 5) { CX_EMIT(S, 129, 5, 0, 0); }
    if (n >= 4) { CX_EMIT(S, 129, 4, 0, 0); }
    if (n >= 3) { CX_EMIT(S, 129, 3, 0, 0); }
    if (n >= 2) { CX_EMIT(S, 129, 2, 0, 0); }
    # Pop syscall number into r1 (always last, was pushed first)
    if (n >= 1) { CX_EMIT(S, 129, 1, 0, 0); }
    ESYSCALL(S);
    return 0;
}

# Function prologue/epilogue
fn EFNPRO(S): i64 {
    # save frame pointer to call stack (not data stack — data stack has expression temps)
    # opcode 0x62 = pushc (push to call stack), 0x63 = popc (pop from call stack)
    CX_EMIT(S, 0x62, 253, 0, 0);  # pushc fp
    CX_EMIT(S, 2, 253, 254, 0);   # mov fp, sp
    return 0;
}

fn ESUBRSP(S): i64 {
    # sub sp, imm — movi r252, size; movhi r252, size >> 16; sub r254, r254, r252
    # 6.6.17: r252, not r15 — this runs before the parameters are stored (see _cx_fpaddr).
    # ⛔ The movhi slot is ALWAYS emitted, the v6.6.4 code-offset shape: EPATCHFRAME writes fixed
    # slots once the frame size is known. Without it a frame of 64 KiB or more lowered sp by only
    # size mod 64 KiB, and the callee frames landed inside the caller's own buffer. CHANGELOG [6.6.20]
    var patch = GCP(S);
    CX_EMIT(S, 1, 252, 0, 0);       # movi r252, 0 (placeholder: bits 0..15)
    CX_EMIT(S, 254, 252, 0, 0);     # movhi r252, 0 (placeholder: bits 16..31)
    CX_EMIT(S, 17, 254, 254, 252);  # sub sp, sp, r252
    return patch;
}

fn EFNEPI(S): i64 {
    CX_EMIT(S, 2, 254, 253, 0);   # mov sp, fp
    CX_EMIT(S, 0x63, 253, 0, 0);  # popc fp (from call stack)
    CX_EMIT(S, 97, 0, 0, 0);      # ret
    return 0;
}

# v5.11.35 path-A named ops — Class D refactor. cx stubs preserve
# the IR record but skip emits because cx bytecode doesn't have an
# x86-style callee-saved register set (CYX has 256 virtual regs,
# no caller/callee-save split that needs prologue spills). The
# regalloc save/restore are conceptual no-ops for cx; preserved
# stubs let parse_*.cyr call them unconditionally. See
# x86/emit.cyr for the active implementations +
# docs/audit/2026-04-27-cx-direct-emit-inventory.md.
fn EREGALLOC_SAVE(S, n): i64 {
    if (n >= 1) { _IR_REC0(S, IR_RAW_EMIT); }
    return 0;
}

fn EREGALLOC_RESTORE(S, n): i64 {
    if (n >= 1) { _IR_REC0(S, IR_RAW_EMIT); }
    return 0;
}

# EDROPI64 — PE-only path; cx doesn't enter the calling code
# (parse_expr.cyr PE syscall stubs are gated by _TARGET_PE).
fn EDROPI64(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

# v5.11.36 path-A named ops — Class B refactor. cx bytecode has
# no fn-pointer or local-address semantic in this slot; both ops
# are no-ops with just the IR record. Real CYX `LOAD_FN_ADDR` /
# `LOAD_LOCAL_ADDR` opcodes coordinated with cxvm are deferred.
# Critically: cx does NOT bump SFCNT — the fixup table isn't used
# by cxvm, and bumping fc without recording a real fixup would
# leave empty slots in the table. (This is a slight behavior
# improvement over the pre-refactor fn-addr site, which bumped
# SFCNT for cx outside the arch dispatch; closure-fn-addr already
# skipped SFCNT on cx, so this aligns the two sites.)
# ⛔ v6.5.13 — WAS A RETURN-0 STUB, exactly like `ELOAD_LOCAL_ADDR` below before v6.4.32.
# `&fn_name` therefore materialised as **0** on cx: `var f = &helper; return f;` returned 0,
# so every fn-pointer value was null long before anything tried to CALL through it. Only
# x86 (`backend/x86/emit.cyr:2555`) and aarch64 (`:1268`) ever recorded the ftype==3
# fn-pointer fixup — `main_cx.cyr` has the handler for it in its fixup loop, but nothing on
# the cx side ever produced one, so that arm was dead code.
#
# This is the PREREQUISITE for the callind opcode (see ECALLIND): an indirect call is
# useless while the pointer is always 0. Both halves land together.
#
# Emit `movi r0, <fn code offset>` and record an ftype==3 fixup pointing at it. The fixup
# loop patches bytes 2-3 of the movi with `_fnt_offsets[fni]` (main_cx.cyr), which is why
# the placeholder is emitted as a fixed-shape movi + movhi pair and NOT via CX_MOVI — CX_MOVI
# emits a VARIABLE number of words for a value, and the patcher writes fixed slots.
# v6.6.4: the movhi slot is always emitted; the codebuf is 512 KiB, so code offsets DO
# exceed 16 bits (a fn past 64 KB of code used to have its pointer truncated).
fn ELOAD_FN_ADDR(S, fnaddr, fc, fni): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    S64(fnaddr, GCP(S));                 # fixup patches the movi at this code offset
    S64(fnaddr + 8, (3 << 56) | fni);    # ftype 3 = function pointer
    SFCNT(S, fc + 1);
    CX_EMIT(S, 1, 0, 0, 0);              # movi r0, 0  (imm16 patched by the fixup loop)
    CX_EMIT(S, 254, 0, 0, 0);            # movhi slot — code offsets past 0xFFFF (v6.6.4)
    return 0;
}

fn ELOAD_LOCAL_ADDR(S, adisp): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    # v6.4.32: was a return-0 STUB — so `&local` (address-of a stack-local)
    # emitted nothing and r0 kept its stale value, aliasing every local-array
    # address. Latent until v6.3.15 flipped stack-arrays default-on (before that
    # `var arr[N]` locals were globals → EVADDR, which works). Emit the frame
    # address into r0 (the accumulator), mirroring x86's `lea rax,[rbp+adisp]`
    # and cx's EFLADDR: adisp is negative (fp − offset), so r0 = fp − (−adisp).
    var d = 0 - adisp;
    CX_EMIT(S, 2, 0, 253, 0);             # mov r0, fp
    CX_MOVI(S, 14, d);                    # r14 = frame offset
    CX_EMIT(S, 17, 0, 0, 14);             # sub r0, r0, r14  → r0 = &local
    return 0;
}

# v5.11.37 path-A named ops — Class C refactor (f64 unary ops).
# cx has no f64 opcodes in this slot. All 8 ops are IR-record
# stubs; real CYX f64 op coverage (coordinated with cxvm) is
# future work tracked in docs/audit/2026-04-27-cx-direct-emit-inventory.md.
# cx arc B: fneg/fabs are real (host-backed opcodes 0x64/0x65). The transcendentals
# (sin/cos/exp/ln/log2/exp2/atan) still FAIL LOUD — the VM has no libm opcodes (a
# later cx-arc tail; `_cx_float_unsupported` defined below in the float block).
fn EF64_NEG(S): i64  { CX_EMIT(S, 100, 0, 0, 0); return 0; }   # fneg r0, r0
fn EF64_ABS(S): i64  { CX_EMIT(S, 101, 0, 0, 0); return 0; }   # fabs r0, r0
fn EF64_SIN(S): i64  { _cx_float_unsupported(S); return 0; }
fn EF64_COS(S): i64  { _cx_float_unsupported(S); return 0; }
fn EF64_EXP(S): i64  { _cx_float_unsupported(S); return 0; }
fn EF64_LN(S): i64   { _cx_float_unsupported(S); return 0; }
fn EF64_LOG2(S): i64 { _cx_float_unsupported(S); return 0; }
fn EF64_EXP2(S): i64 { _cx_float_unsupported(S); return 0; }
fn EF64_ATAN(S): i64 { _cx_float_unsupported(S); return 0; }

# EF64_CMP — f64 comparison (cx arc B follow-up: RE-ENABLED). The frontend
# (PF64CMP :1686 + the site-2 `== N` path :2690) leaves a (left) in r1 and b (right)
# on the stack — mirror of x86 EF64_CMP. r0 = (a CMP b) ? 1 : 0 via the NaN-correct
# cxvm float-compare opcodes 0x5A-0x5F. The result is a clean i64 0/1 in r0; the
# "misbehaves in if()/==" symptom was NOT this emit — it was cx's flag-less EJCC
# truthiness path (fixed in ETESTAZ above), so this is safe to re-enable.
fn EF64_CMP(S, tok): i64 {
    EPOPR(S);                       # r0 = b (right); r1 = a (left) from the frontend setup
    var op = 94;                    # default feq (== is tok 17, eq builtin tok 68)
    if (tok == 69) { op = 90; }     # lt builtin → flt
    if (tok == 70) { op = 92; }     # gt builtin → fgt
    if (tok == 19) { op = 90; }     # <   → flt
    if (tok == 20) { op = 92; }     # >   → fgt
    if (tok == 21) { op = 91; }     # <=  → fle
    if (tok == 22) { op = 93; }     # >=  → fge
    if (tok == 18) { op = 95; }     # !=  → fne
    CX_EMIT(S, op, 0, 1, 0);        # fcmp r0, r1, r0  = (a CMP b) ? 1 : 0
    return 0;
}

# v5.11.39 path-A stubs — switch-table dispatch. cx takes the
# chain path (parse.cyr now sets `use_table = 0` for _TARGET_CX
# == 1, paired guard at the existing aarch64 one). Stubs for
# include-time symmetry.
fn ESWITCH_DISPATCH_PRE(S, case_min, range): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

fn ESWITCH_DISPATCH_TABLE(S, range): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    return 0;
}

fn EEXIT(S): i64 {
    CX_EMIT(S, 2, 2, 0, 0);      # mov r2, r0 (exit code → arg1)
    CX_MOVI(S, 1, 60);            # r1 = 60 (SYS_EXIT)
    CX_EMIT(S, 112, 0, 0, 0);    # syscall(r1=60, r2=exit_code)
    return 0;
}

# Call: emit call with fixup
fn ECALLTO(S, target): i64 {
    var cp = GCP(S);
    var off = (target - cp) / 4;
    CX_EMIT(S, 96, off & 0xFF, (off >> 8) & 0xFF, (off >> 16) & 0xFF);
    return 0;
}

# 6.6.20 — a REDEFINED fn: turn the earlier body's entry into `jmp new_off` (opcode 80, 4-byte
# instruction units like ECALLTO), so every reference already compiled against it reaches the
# last definition. Writes the cx code buffer EB writes (S + 0x54A000). Returns 1, writing
# nothing, when the earlier body is too short. See `_fn_redirect` (parse_fn.cyr). CHANGELOG [6.6.20]
fn EFNREDIRECT(S, old_off, old_end, new_off): i64 {
    if (old_end > old_off) { if (old_end - old_off < 4) { return 1; } }
    var off = (new_off - old_off) / 4;
    var a = S + 0x54A000 + old_off;
    store8(a, 80);
    store8(a + 1, off & 0xFF);
    store8(a + 2, (off >> 8) & 0xFF);
    store8(a + 3, (off >> 16) & 0xFF);
    return 0;
}

fn ECALLFIX(S, fnidx): i64 {
    # A negative index is a failed lookup that reached the emitter. It must not become a
    # fixup: `(2 << 56) | -1` decodes as a different fixup type with an index near 2^56,
    # which the aarch64 and cx walks followed off their tables (rc 139). Every caller that
    # can fail reports first; the check here is the backstop for one that does not.
    # CHANGELOG [6.6.9]
    if (fnidx < 0) {
        if (_had_error == 0) { ERR_MSG(S, "internal: a call was emitted for an unresolved function (index < 0)", 67); }
        return 0;
    }
    # Emit call placeholder, record fixup
    var poff = GCP(S);
    CX_EMIT(S, 96, 0, 0, 0);  # call +0 (placeholder)
    var fc = GFCNT(S);
    if (fc >= 1048576) {
        syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x150B000 + fc * 16;
    S64(faddr, poff);
    S64(faddr + 8, (2 << 56) | fnidx);
    SFCNT(S, fc + 1);
    return 0;
}

# v6.5.13 — cx indirect call. `.cyx` opcode **105 (0x69) = callind**.
#
# ⛔ OPCODE 105 IS PERMANENT. `.cyx` is a shipped, versioned format: every file ever
# produced encodes this number and `cxvm` must honour it forever — the same one-way door
# as the binary-naming rule.
#
# ⚠ HOW TO PICK A FREE OPCODE (learned the hard way). cxvm's dispatch writes some arms in
# DECIMAL (`op == 97`) and others in HEX (`op == 0x62`). A decimal-only scan reports 98/99
# as free when they are `pushc`/`popc` — and an arm added for 98 SHADOWS pushc, silently
# corrupting every program that saves a register. Scan with a regex covering BOTH forms:
#     grep -oE 'op == (0x[0-9A-Fa-f]+|[0-9]+)' programs/cxvm.cyr
# 105 was verified free against that scan and against a frequency count of the opcodes an
# actual .cyx contains.
#
# ENCODING: [105][ra][0][0] — call through the CODE OFFSET held in register `ra`.
# Semantics mirror op 96 (call): push the return address, then set pc. 96 is PC-relative
# (`off*4`, instruction units); 105 is ABSOLUTE, because the register holds whatever the
# ftype==3 fn-pointer fixup wrote — `_fnt_offsets[idx]`, a byte offset in the same
# numbering `_cx_pc` uses (op 96's `_cx_pc - 4 + off*4` is what proves the spaces coincide).
#
# `idx` is a LOCAL SLOT, matching x86's `call [rbp+disp]` (backend/x86/emit.cyr:2888):
# the caller spilled the callee address there. So materialise `fp - _cx_ldisp(idx)`, load
# the slot, call through it. 6.6.17: through r251 / r252 (`_cx_fpaddr`) — r14 / r15 are argument
# registers from 12 arguments.
#
# ⚠ callptr-to-NATIVE (COM/DXGI) is still impossible on cx and always will be — a `.cyx`
# has no machine addresses. This covers cyrius-internal fn pointers, which is what
# lib/fnptr.cyr / vec_sort_by / the Allocator vtable actually need.
# ── v6.5.17 closure ABI — cx peer of the x86 ECLTAG/ECLENV/ECLNORM trio.
# A capturing closure's value is its heap env object with bit 63 SET, so an
# indirect call site decides "closure or bare fn pointer" at RUNTIME rather than
# from the declaring var's static type. See backend/x86/emit.cyr for the note.
fn ECLTAG(S): i64 {
    CX_MOVI(S, 1, 0x8000000000000000);
    CX_EMIT(S, 33, 0, 0, 1);              # or  r0, r0, r1
    return 0;
}
fn ECLENV(S): i64 {
    CX_MOVI(S, 1, 0x7FFFFFFFFFFFFFFF);
    CX_EMIT(S, 32, 0, 0, 1);              # and r0, r0, r1
    return 0;
}
# ECLNORM: r0 = callee value -> r0 = real code offset.
# cx has no flags and no cmov, so the select is arithmetic:
#   mask = asr(v, 63)                 0 (plain) or -1 (tagged)
#   addr = p ^ ((p ^ u) & mask)       p = &slot(idx) (which HOLDS v), u = untag(v)
#   r0   = load64(addr)               plain -> v itself; tagged -> env[0]
# `idx` is the callee's spill slot, so the plain arm loads a value it already
# knows — no code offset is ever used as a data address (a cx guest has no
# machine addresses, so dereferencing one would be a VM fault, not junk).
fn ECLNORM(S, idx): i64 {
    CX_MOVI(S, 1, 63);
    CX_EMIT(S, 37, 2, 0, 1);              # asr  r2, r0, r1        (mask)
    CX_MOVI(S, 1, 0x7FFFFFFFFFFFFFFF);
    CX_EMIT(S, 32, 15, 0, 1);             # and  r15, r0, r1       (u = untag(v))
    CX_EMIT(S, 2, 14, 253, 0);            # mov  r14, fp
    CX_MOVI(S, 1, _cx_ldisp(idx));
    CX_EMIT(S, 17, 14, 14, 1);            # sub  r14, r14, r1      (p = &slot)
    CX_EMIT(S, 34, 15, 14, 15);           # xor  r15, r14, r15     (p ^ u)
    CX_EMIT(S, 32, 15, 15, 2);            # and  r15, r15, r2      (& mask)
    CX_EMIT(S, 34, 14, 14, 15);           # xor  r14, r14, r15     (addr)
    CX_EMIT(S, 65, 0, 14, 0);             # load64 r0, [r14]
    return 0;
}

fn ECALLIND(S, idx): i64 {
    _cx_fpaddr(S, _cx_ldisp(idx));        # 6.6.17: r251 = the callee's slot (see _cx_fpaddr)
    CX_EMIT(S, 65, 251, 251, 0);          # load64 r251, [r251]   (callee code offset)
    CX_EMIT(S, 105, 251, 0, 0);           # callind r251
    return 0;
}

# 6.6.16 — the MICRO-FRAME around a TOP-LEVEL indirect call (PINDIRECT_CALL, parse_expr.cyr; the
# x86 peer in backend/x86/emit.cyr has the full note). The ordinary prologue pair — EFNPRO
# (`pushc fp; mov fp, sp`, fp saved on the CALL stack) and ESUBRSP's patchable
# `movi r252; movhi r252; sub sp` — and the epilogue without its `ret`. Before 6.6.16 a top-level fncallN on cx was an ordinary
# call into lib/fnptr.cyr, which has no cx arm, so it returned 0 for EVERY callee.
fn ETLFRAME_OPEN(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EFNPRO(S);
    var patch = ESUBRSP(S);
    return patch;
}
fn ETLFRAME_CLOSE(S, patch, nslots): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EPATCHFRAME(S, patch, ((nslots * 8 + 15) / 16) * 16);
    CX_EMIT(S, 2, 254, 253, 0);   # mov sp, fp
    CX_EMIT(S, 0x63, 253, 0, 0);  # popc fp (from call stack)
    return 0;
}

# ⛔ 6.7.6 — THE cx CALL'S REGISTER WINDOW, AND THE ARGUMENTS PAST IT. The register file at a call:
#   r0..r2     the accumulator, the secondary operand, scratch — never an argument
#   r3..r234   integer arguments 0..231: argument k rides r(3 + k) for k < _CX_ARG_REGS (232)
#   r235..r250 value-form vector arguments, _CX_VEC_BASE + 2 * ordinal (8 ordinals, see below)
#   r251/r252  the call-boundary scratch (`_cx_fpaddr`); r253 / r254 fp / sp
# Argument k >= _CX_ARG_REGS is passed in the GUEST stack, the way SysV passes
# arguments 7+: the caller lowers sp by 8 per such argument and stores argument k at
# [sp + 8 * (k - _CX_ARG_REGS)]; the callee's fp IS that sp (EFNPRO: `mov fp, sp`), so ESTOREPARM
# copies it from [fp + 8 * (k - _CX_ARG_REGS)] — above the callee's own frame, which grows down
# from fp — into its slot; ECALLCLEAN raises sp again. A call of up to _CX_ARG_REGS integer
# arguments emits exactly what it always did. Before 6.7.6 every argument was a register: argument 248 was
# popped into r251, 250 into fp, 251 into sp, and past 252 the operand byte wrapped to r0 — 249
# arguments returned a wrong value and 252 trapped "cxvm: guest stack overflow" — and the vector
# band sat at r16..r31, which ARE integer argument registers from 14 arguments (ESTOREPARM_F64V2).
# CHANGELOG [6.7.6]
var _CX_ARG_REGS = 232;
var _CX_VEC_BASE = 235;

fn ECALLPOPS(S, n): i64 {
    # Pop args into r3.. (argument registers); the ones past the window first, into the guest stack.
    var i = n - 1;
    if (n > _CX_ARG_REGS) { i = _cx_pop_stack_args(S, n); }
    while (i >= 0) {
        CX_EMIT(S, 129, 3 + i, 0, 0);  # pop into arg register
        i = i - 1;
    }
    return 0;
}
# Arguments _CX_ARG_REGS..n-1 — the top of the data stack — into a block of 8 * (n - _CX_ARG_REGS)
# bytes reserved below sp. r0 / r251 / r252 are free here (every argument is on the data stack, and
# the callee pointer of an indirect call is in a frame slot). Returns the last register argument.
fn _cx_pop_stack_args(S, n): i64 {
    CX_MOVI(S, 252, (n - _CX_ARG_REGS) * 8);
    CX_EMIT(S, 17, 254, 254, 252);        # sub  sp, sp, r252   (cxvm traps a guest stack overflow)
    var i = n - 1;
    while (i >= _CX_ARG_REGS) {
        CX_EMIT(S, 129, 0, 0, 0);         # pop  r0             (argument i)
        CX_MOVI(S, 252, (i - _CX_ARG_REGS) * 8);
        CX_EMIT(S, 16, 251, 254, 252);    # add  r251, sp, r252
        CX_EMIT(S, 67, 251, 0, 0);        # store64 [r251], r0
        i = i - 1;
    }
    return i;
}

# Takes back the guest-stack argument block ECALLPOPS reserved; nothing below the window.
fn ECALLCLEAN(S, n): i64 {
    if (n <= _CX_ARG_REGS) { return 0; }
    CX_MOVI(S, 252, (n - _CX_ARG_REGS) * 8);
    CX_EMIT(S, 16, 254, 254, 252);        # add  sp, sp, r252   (r0 / r4 / r5, the result, untouched)
    return 0;
}

# Jump helpers
fn EJCC(S, cc): i64 {
    # cx has no flags — emit comparison + conditional jump.
    # ECMPR was a no-op; r0=LHS, r1=RHS are still in registers from ECONDCMP.
    # x86 cc codes map to inverted comparisons (jump on FALSE):
    #   0x84 = JE  (jump if equal)      → eq r0,r0,r1; jnz r0 (jump if equal)
    #   0x85 = JNE (jump if not equal)  → eq r0,r0,r1; jz r0 (jump if not equal → skip)
    #   0x8C = JL  (jump if less)       → lt r0,r0,r1; jnz r0
    #   0x8D = JGE (jump if >= )        → lt r0,r0,r1; jz r0
    #   0x8E = JLE (jump if <=)         → gt r0,r0,r1; jz r0
    #   0x8F = JG  (jump if >)          → gt r0,r0,r1; jnz r0
    # ECONDOP inverts: for GT, it emits JLE (jump if NOT greater = skip true branch)
    if (cc == 0x84) { CX_EMIT(S, 48, 0, 0, 1); }      # eq r0, r0, r1
    elif (cc == 0x85) { CX_EMIT(S, 48, 0, 0, 1); }    # eq r0, r0, r1
    elif (cc == 0x8C) { CX_EMIT(S, 50, 0, 0, 1); }    # lt r0, r0, r1
    elif (cc == 0x8D) { CX_EMIT(S, 50, 0, 0, 1); }    # lt r0, r0, r1
    elif (cc == 0x8E) { CX_EMIT(S, 51, 0, 0, 1); }    # gt r0, r0, r1
    elif (cc == 0x8F) { CX_EMIT(S, 51, 0, 0, 1); }    # gt r0, r0, r1
    else { CX_EMIT(S, 48, 0, 0, 1); }                  # default: eq
    # Now r0 = comparison result (1 or 0). Emit conditional jump.
    var patch = GCP(S);
    if (cc == 0x84) { CX_EMIT(S, 82, 0, 0, 0); }      # jnz (jump if equal)
    elif (cc == 0x85) { CX_EMIT(S, 81, 0, 0, 0); }    # jz (jump if NOT equal → skip)
    elif (cc == 0x8C) { CX_EMIT(S, 82, 0, 0, 0); }    # jnz (jump if less)
    elif (cc == 0x8D) { CX_EMIT(S, 81, 0, 0, 0); }    # jz (jump if NOT less → skip)
    elif (cc == 0x8E) { CX_EMIT(S, 81, 0, 0, 0); }    # jz (jump if NOT greater → skip)
    elif (cc == 0x8F) { CX_EMIT(S, 82, 0, 0, 0); }    # jnz (jump if greater)
    else { CX_EMIT(S, 81, 0, 0, 0); }
    return patch;
}

fn EJMP(S, target): i64 {
    var cp = GCP(S);
    var off = (target - cp) / 4;
    CX_EMIT(S, 80, off & 0xFF, (off >> 8) & 0xFF, (off >> 16) & 0xFF);
    return 0;
}

fn EJMP0(S): i64 {
    var patch = GCP(S);
    CX_EMIT(S, 80, 0, 0, 0);  # jmp +0 (placeholder)
    return patch;
}

fn EPATCH(S, off): i64 {
    var cp = GCP(S);
    var rel = (cp - off) / 4;
    var opcode = load8(S + 0x54A000 + off);
    # For jz/jnz (0x51/0x52): offset is in bytes 2-3 (byte 1 = register)
    # For jmp/call (0x50/0x60): offset is in bytes 1-3
    if (opcode == 0x51) {
        store8(S + 0x54A000 + off + 2, rel & 0xFF);
        store8(S + 0x54A000 + off + 3, (rel >> 8) & 0xFF);
    }
    elif (opcode == 0x52) {
        store8(S + 0x54A000 + off + 2, rel & 0xFF);
        store8(S + 0x54A000 + off + 3, (rel >> 8) & 0xFF);
    }
    else {
        store8(S + 0x54A000 + off + 1, rel & 0xFF);
        store8(S + 0x54A000 + off + 2, (rel >> 8) & 0xFF);
        store8(S + 0x54A000 + off + 3, (rel >> 16) & 0xFF);
    }
    return 0;
}

# Variable load/store via fixup
fn RECFIX(S, idx): i64 {
    var fc = GFCNT(S);
    if (fc >= 1048576) {
        syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
        syscall(SYS_EXIT, 1);
    }
    var addr = S + 0x150B000 + fc * 16;
    S64(addr, GCP(S));
    S64(addr + 8, idx);
    SFCNT(S, fc + 1);
    return 0;
}

fn EVSTORE(S, idx): i64 {
    # Store r0 to global var
    CX_MOVI(S, 1, 0);  # placeholder address
    RECFIX(S, idx);
    CX_EMIT(S, 254, 1, 0, 0);   # movhi slot: main_cx.cyr patches bytes 2-3 of the instruction AFTER the movi when addr > 0xFFFF; a bare movi put that patch on the NEXT instruction (v6.6.4)
    CX_EMIT(S, 67, 1, 0, 0);  # store64 [r1], r0
    return 0;
}

fn EVLOAD(S, idx): i64 {
    CX_MOVI(S, 1, 0);  # placeholder address
    RECFIX(S, idx);
    CX_EMIT(S, 254, 1, 0, 0);   # movhi slot: main_cx.cyr patches bytes 2-3 of the instruction AFTER the movi when addr > 0xFFFF; a bare movi put that patch on the NEXT instruction (v6.6.4)
    CX_EMIT(S, 65, 0, 1, 0);  # load64 r0, [r1]
    return 0;
}

fn EVADDR(S, idx): i64 {
    CX_MOVI(S, 0, 0);  # placeholder address
    RECFIX(S, idx);
    CX_EMIT(S, 254, 0, 0, 0);   # movhi slot: main_cx.cyr patches bytes 2-3 of the instruction AFTER the movi when addr > 0xFFFF; a bare movi put that patch on the NEXT instruction (v6.6.4)
    return 0;
}

# v6.4.32: frame offset (bytes) for local slot `idx`, INCLUDING the reserved
# callee-saved (regalloc) block + retptr stash — matching EFLADDR/EFLADDR_X1 and
# the shared frontend's &-of-local disp (parse_expr `adisp`). Before this, the
# scalar EFLLOAD/EFLSTORE, the f64v2/f64v4 pair emitters, ESTOREPARM, and the
# SIMD arg-loader all omitted the regalloc term while EFLADDR added it — so a
# slot INDEX mapped to two different ADDRESSES depending on the access path.
# Access-by-name was self-consistent (both omit it) so it went unnoticed, but
# `&local` + pointer use, and the SIMD arg-stash slots, collided with the
# regalloc-shifted array storage. One helper → one uniform slot→address map.
fn _cx_ldisp(idx): i64 {
    var d = (idx + 1) * 8;
    if (_cur_fn_regalloc > 0) { d = d + _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { d = d + _cur_fn_ret_stash; }
    return d;
}

# v5.10.30 — cx f64v2 pair-register return (Phase 3 of the
# value-type ABI arc; Phase 1 x86 v5.10.28, Phase 2 aarch64
# v5.10.29). cx PCS for f64v2: r0 = lo, r1 = hi. Mirror of
# x86's rax/rdx and aarch64's X0/X1 — same caller/callee
# shape, different register names.
#
# `idx` is the NAMED slot's local index; 2-slot layout:
#   slot idx-1 = anonymous filler (hi half = &v + 8)
#   slot idx   = named (lo half / bottom of struct = &v + 0)
# Frame computation matches existing EFLLOAD pattern: use
# r14 as scratch (mov r14, fp; sub r14, r14, r15; load64).
fn EFLLOAD_F64V2_PAIR(S, idx): i64 {
    # lo: r0 = [fp - (idx+1)*8]  (named slot)
    CX_EMIT(S, 2, 14, 253, 0);          # mov r14, fp
    CX_MOVI(S, 15, _cx_ldisp(idx));      # r15 = offset_lo
    CX_EMIT(S, 17, 14, 14, 15);         # sub r14, r14, r15
    CX_EMIT(S, 65, 0, 14, 0);           # load64 r0, [r14]
    # hi: r1 = [fp - idx*8]  (filler slot)
    CX_EMIT(S, 2, 14, 253, 0);          # mov r14, fp
    CX_MOVI(S, 15, _cx_ldisp(idx - 1));            # r15 = offset_hi
    CX_EMIT(S, 17, 14, 14, 15);         # sub r14, r14, r15
    CX_EMIT(S, 65, 1, 14, 0);           # load64 r1, [r14]
    return 0;
}

fn EFLSTORE_F64V2_PAIR(S, idx): i64 {
    # lo: [fp - (idx+1)*8] = r0  (named slot)
    CX_EMIT(S, 2, 14, 253, 0);          # mov r14, fp
    CX_MOVI(S, 15, _cx_ldisp(idx));      # r15 = offset_lo
    CX_EMIT(S, 17, 14, 14, 15);         # sub r14, r14, r15
    CX_EMIT(S, 67, 14, 0, 0);           # store64 [r14], r0
    # hi: [fp - idx*8] = r1  (filler slot)
    CX_EMIT(S, 2, 14, 253, 0);          # mov r14, fp
    CX_MOVI(S, 15, _cx_ldisp(idx - 1));            # r15 = offset_hi
    CX_EMIT(S, 17, 14, 14, 15);         # sub r14, r14, r15
    CX_EMIT(S, 67, 14, 1, 0);           # store64 [r14], r1
    return 0;
}

# v5.10.37 — cx 4-register pair-quad return for f64v4.
# Layout (named at deepest slot):
#   slot idx-3 = filler (bytes 24..31)  → r3
#   slot idx-2 = filler (bytes 16..23)  → r2
#   slot idx-1 = filler (bytes 8..15)   → r1
#   slot idx   = named  (bytes 0..7)    → r0
# cxvm supports r0..r3 as return registers (extension over the
# 2-register pair used for f64v2). r14/r15 stay scratch.
fn EFLLOAD_F64V4_PAIR(S, idx): i64 {
    # r0 = [fp - (idx+1)*8]  (lo, named)
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 65, 0, 14, 0);
    # r1 = [fp - idx*8]      (filler 1)
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx - 1));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 65, 1, 14, 0);
    # r2 = [fp - (idx-1)*8]  (filler 2)
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx - 2));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 65, 2, 14, 0);
    # r3 = [fp - (idx-2)*8]  (filler 3)
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx - 3));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 65, 3, 14, 0);
    return 0;
}

# v5.10.38 — cx stubs for SIMD-class param store/load. cxvm
# doesn't have a SIMD register file; f64v2/f64v4 param-side
# ABI on cx is conceptual only and not required by current
# cxvm consumers. No-op emits so the parser's per-backend
# dispatch doesn't fault when these names resolve under
# CYRIUS_TARGET_CX. If a future cx consumer needs SIMD param
# passing, mirror the v5.10.37 4-register pair-quad return
# shape (R0..R3 stores per slot).
# ⛔ 6.6.17 (a11) — THE CALL BOUNDARY'S SCRATCH IS r251 / r252, NOT r14 / r15. ECALLPOPS pops
# argument k into r(3+k) for EVERY k, so from 12 arguments r14 and from 13 r15 ARE argument
# registers — and every emitter that runs between the caller's pops and the callee's stores used
# them as scratch: ECALLIND (`fncallN` / `callptr`), the prologue's frame `movi` (ESUBRSP), and
# each parameter store. A 12-argument call read argument 11 as a frame address (measured on cxvm:
# 12581018 where 650 is right, direct and indirect alike). r251 / r252 sit above every argument
# register (the window and the vector band, see _CX_ARG_REGS), below fp / sp (r253 / r254).
# `_cx_fpaddr` leaves r251 = fp - off. CHANGELOG [6.6.17]
fn _cx_fpaddr(S, off): i64 {
    CX_EMIT(S, 2, 251, 253, 0);           # mov  r251, fp
    CX_MOVI(S, 252, off);                 # movi r252, off
    CX_EMIT(S, 17, 251, 251, 252);        # sub  r251, r251, r252
    return 0;
}
# v6.4.54 — cx value-form SIMD param/return marshaling. cxvm has no vector register
# file, so 16B/32B value-form vectors ride a GP register-PAIR transport: SIMD ordinal
# k occupies r(B+2k)=lo / r(B+2k+1)=hi, B = _CX_VEC_BASE (a 32B f64v4 spans two ordinals → the
# 4 consecutive regs r(B+2k)..r(B+2k+3)). The frontend caps the ordinals at 8 (the XMM0..XMM7
# budget), so the band is r235..r250: above every integer argument register (r3..r234, see
# _CX_ARG_REGS), below the call-boundary scratch (r251/r252), clear of the returns (r0..r3).
# Nothing between the caller's ELOAD (call site, after ECALLPOPS) and the callee's ESTOREPARM
# (fn entry) touches it, so the pair survives the call. ⛔ It was r16..r31 until 6.7.6 — integer
# argument registers from 14 arguments: `g(v, a0..a13)` read a13 as the vector's low lane (the
# caller loaded the vector over it) and the vector as garbage. Frame lane layout reuses _cx_ldisp
# and mirrors EFL{STORE,LOAD}_*_PAIR. 16B covers f64v2 / f32v4 / i32v4 (2-slot pair); f64v4 is
# the 4-slot quad. CHANGELOG [6.4.54] [6.7.6]
fn ESTOREPARM_F64V2(S, simd_ord, named_idx): i64 {
    var base = _CX_VEC_BASE + simd_ord * 2;
    _cx_fpaddr(S, _cx_ldisp(named_idx));     # 6.6.17: r251 / r252 scratch (see _cx_fpaddr)
    CX_EMIT(S, 67, 251, base, 0);            # store64 [r251], r_lo
    _cx_fpaddr(S, _cx_ldisp(named_idx - 1)); # filler slot (hi half)
    CX_EMIT(S, 67, 251, base + 1, 0);        # store64 [r251], r_hi
    return 0;
}
fn ESTOREPARM_F64V4(S, simd_ord, named_idx): i64 {
    var base = _CX_VEC_BASE + simd_ord * 2;
    var k = 0;
    while (k < 4) {
        _cx_fpaddr(S, _cx_ldisp(named_idx - k));
        CX_EMIT(S, 67, 251, base + k, 0);
        k = k + 1;
    }
    return 0;
}
fn ESTOREPARM_SIMD_WIN64(S, pidx, named_idx, nbytes): i64 { return 0; }  # v6.4.31 PE-only; stub off-PE
fn ELOAD_F64V2_TO_XMM(S, simd_ord, named_idx): i64 {
    var base = _CX_VEC_BASE + simd_ord * 2;
    _cx_fpaddr(S, _cx_ldisp(named_idx));     # 6.6.17: runs after the caller's pops (_cx_fpaddr)
    CX_EMIT(S, 65, base, 251, 0);            # load64 r_lo, [r251]
    _cx_fpaddr(S, _cx_ldisp(named_idx - 1));
    CX_EMIT(S, 65, base + 1, 251, 0);        # load64 r_hi, [r251]
    return 0;
}
fn ELOAD_F64V4_TO_XMM(S, simd_ord, named_idx): i64 {
    var base = _CX_VEC_BASE + simd_ord * 2;
    var k = 0;
    while (k < 4) {
        _cx_fpaddr(S, _cx_ldisp(named_idx - k));
        CX_EMIT(S, 65, base + k, 251, 0);
        k = k + 1;
    }
    return 0;
}

fn EFLSTORE_F64V4_PAIR(S, idx): i64 {
    # [fp - (idx+1)*8] = r0
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 67, 14, 0, 0);
    # [fp - idx*8] = r1
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx - 1));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 67, 14, 1, 0);
    # [fp - (idx-1)*8] = r2
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx - 2));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 67, 14, 2, 0);
    # [fp - (idx-2)*8] = r3
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx - 3));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 67, 14, 3, 0);
    return 0;
}

# v5.10.45 Phase 1 stub — int-class 16B struct pair-return.
# cx bytecode has no pair-return ABI today. Phase 2/3 may add it
# if cyrius-x bytecode needs to consume value-typed struct
# returns; for now error so consumers fail loudly rather than
# silently miscompiling.
fn EFLLOAD_STRUCT_INT_PAIR(S, idx): i64 {
    ERR_MSG(S, "cx: int-class 16B struct pair-return ABI not supported", 54);
    return 0;
}
fn EFLSTORE_STRUCT_INT_PAIR(S, idx): i64 {
    ERR_MSG(S, "cx: int-class 16B struct pair-return ABI not supported", 54);
    return 0;
}

# Function local load/store
fn EFLLOAD(S, idx): i64 {
    # load from [fp - (idx+1)*8]. Use r14/r15 as temps.
    CX_EMIT(S, 2, 14, 253, 0);      # mov r14, fp
    CX_MOVI(S, 15, _cx_ldisp(idx));  # r15 = offset
    CX_EMIT(S, 17, 14, 14, 15);     # sub r14, r14, r15
    CX_EMIT(S, 65, 0, 14, 0);       # load64 r0, [r14]
    return 0;
}

fn EFLSTORE(S, idx): i64 {
    CX_EMIT(S, 2, 14, 253, 0);
    CX_MOVI(S, 15, _cx_ldisp(idx));
    CX_EMIT(S, 17, 14, 14, 15);
    CX_EMIT(S, 67, 14, 0, 0);       # store64 [r14], r0
    return 0;
}

fn EPATCHFRAME(S, patch, size): i64 {
    # Patch ESUBRSP's movi r252 (bits 0..15) and the movhi r252 after it (bits 16..31). A frame is
    # far below 4 GiB (arrays past the per-fn frame budget go static), so two slots carry it whole.
    store8(S + 0x54A000 + patch, 1);        # movi opcode
    store8(S + 0x54A000 + patch + 1, 252);  # r252
    store8(S + 0x54A000 + patch + 2, size & 0xFF);
    store8(S + 0x54A000 + patch + 3, (size >> 8) & 0xFF);
    store8(S + 0x54A000 + patch + 4, 254);  # movhi opcode
    store8(S + 0x54A000 + patch + 5, 252);  # r252
    store8(S + 0x54A000 + patch + 6, (size >> 16) & 0xFF);
    store8(S + 0x54A000 + patch + 7, (size >> 24) & 0xFF);
    return 0;
}

fn ESTOREPARM(S, pidx, lidx, pc): i64 {
    # Store param register to local slot. 6.6.17: r251 / r252 temps — r14 / r15 ARE argument
    # registers from 12 arguments (see _cx_fpaddr). 6.7.6: past the register window the parameter
    # is in the caller's guest-stack block (see ECALLPOPS).
    if (pidx >= _CX_ARG_REGS) { return _cx_storeparm_stack(S, pidx, lidx); }
    _cx_fpaddr(S, _cx_ldisp(lidx));
    CX_EMIT(S, 67, 251, 3 + pidx, 0);    # store64 [r251], arg_reg
    return 0;
}
# Parameter `pidx` >= _CX_ARG_REGS: [fp + 8 * (pidx - _CX_ARG_REGS)] -> its slot, through r1 (no
# argument rides r1, and nothing is live in it in a prologue). CHANGELOG [6.7.6]
fn _cx_storeparm_stack(S, pidx, lidx): i64 {
    CX_MOVI(S, 252, (pidx - _CX_ARG_REGS) * 8);
    CX_EMIT(S, 16, 251, 253, 252);        # add  r251, fp, r252   (the caller's argument block)
    CX_EMIT(S, 65, 1, 251, 0);            # load64 r1, [r251]
    _cx_fpaddr(S, _cx_ldisp(lidx));
    CX_EMIT(S, 67, 251, 1, 0);            # store64 [r251], r1
    return 0;
}

fn EXORAA(S): i64 { CX_MOVI(S, 0, 0); return 0; }

# ⛔ 6.6.5 — THE WIDTH-AWARE LOADS WERE 64-BIT STUBS, WHICH IS A WRONG VALUE, NOT A GAP.
# Every other backend narrows an `i8`/`i16`/`i32` load to its declared width and SIGN-EXTENDS
# it when the declaration is signed (x86 `_EMIT_NLOAD_RCX`, the aarch64 ldrsb/ldrsh/ldrsw
# arms). cx returned all 64 bits, so a signed narrow local or struct field compared EXACTLY
# against a negative literal passed on x86 and aarch64 and FAILED on cx — the same source,
# two answers. The convention is the shared one: `width` is the byte count and a NEGATIVE
# width means signed. cx has no sized load for a global or a local, so the value arrives wide
# and is normalised here — shl + asr for signed, a mask for unsigned. CHANGELOG [6.6.5]
fn _cx_width_mask(aw): i64 {
    if (aw == 1) { return 0xFF; }
    if (aw == 2) { return 0xFFFF; }
    return 0xFFFFFFFF;
}
fn _CX_NARROW(S, width): i64 {
    var aw = width;
    if (aw < 0) { aw = 0 - aw; }
    if (aw != 1) { if (aw != 2) { if (aw != 4) { return 0; } } }
    if (width < 0) {
        var sh = 64 - aw * 8;
        CX_MOVI(S, 1, sh);
        ESHLCL(S);
        CX_MOVI(S, 1, sh);
        EASHRCL(S);
        return 0;
    }
    CX_MOVI(S, 1, _cx_width_mask(aw));
    EANDR(S);
    return 0;
}
# ⛔ 6.6.12 — THE WIDTH-AWARE STORES WERE 8-BYTE STORES. A narrow slot is only `|width|` bytes
# wide: typed narrow GLOBALS are packed (`var a: u8; var b: u8;` puts b at a+1), so EVSTORE_W's
# store64 to `a` wrote over the 7 bytes after it — every x86/aarch64/PE store is width-correct
# (x86 EVSTORE_W's ESTORE8/16/32), so the same source gave b = 7 natively and 0 on cx (V1's cx
# half). The loads read 8 bytes and masked, which gave the right value but reached 7 bytes past
# the slot — past the end of the data segment for a slot in its last 7 bytes, which cxvm now
# refuses (the cxvm host-memory bug). So both directions use the sized cxvm opcodes (load8/16/32 0x40/0x44/0x45,
# store8/16/32 0x42/0x46/0x47), and a signed load sign-extends after the zero-extending load.
# `width` is the shared convention: the byte count, negative = signed. CHANGELOG [6.6.12]
fn _cx_width_abs(width): i64 {
    if (width < 0) { return 0 - width; }
    return width;
}
# load{w} r0, [areg]; a width outside 1/2/4 is a full 8-byte load.
fn _CX_LOAD_W(S, areg, width): i64 {
    var aw = _cx_width_abs(width);
    if (aw == 1) { CX_EMIT(S, 64, 0, areg, 0); }
    elif (aw == 2) { CX_EMIT(S, 68, 0, areg, 0); }
    elif (aw == 4) { CX_EMIT(S, 69, 0, areg, 0); }
    else { CX_EMIT(S, 65, 0, areg, 0); return 0; }
    if (width < 0) { _CX_NARROW(S, width); }
    return 0;
}
# store{w} [areg], r0; a width outside 1/2/4 is a full 8-byte store.
fn _CX_STORE_W(S, areg, width): i64 {
    var aw = _cx_width_abs(width);
    if (aw == 1) { CX_EMIT(S, 66, areg, 0, 0); }
    elif (aw == 2) { CX_EMIT(S, 70, areg, 0, 0); }
    elif (aw == 4) { CX_EMIT(S, 71, areg, 0, 0); }
    else { CX_EMIT(S, 67, areg, 0, 0); }
    return 0;
}
fn EVLOAD_W(S, idx, width): i64 {
    EVADDR_X1(S, idx);              # r1 = &global (movi + fixup + movhi, as EVLOAD)
    _CX_LOAD_W(S, 1, width);
    return 0;
}
fn EVSTORE_W(S, idx, width): i64 {
    EVADDR_X1(S, idx);
    _CX_STORE_W(S, 1, width);
    return 0;
}
fn EFLLOAD_W(S, idx, width): i64 {
    CX_EMIT(S, 2, 14, 253, 0);      # mov r14, fp
    CX_MOVI(S, 15, _cx_ldisp(idx));
    CX_EMIT(S, 17, 14, 14, 15);     # sub r14, r14, r15
    _CX_LOAD_W(S, 14, width);
    return 0;
}
fn EFLSTORE_W(S, idx, width): i64 {
    CX_EMIT(S, 2, 14, 253, 0);      # mov r14, fp
    CX_MOVI(S, 15, _cx_ldisp(idx));
    CX_EMIT(S, 17, 14, 14, 15);     # sub r14, r14, r15
    _CX_STORE_W(S, 14, width);
    return 0;
}

# v5.9.40 — sub-byte struct field load (parse_decl.cyr:252).
# Field-base ptr is in r1; emit width-correct load into r0.
# Mirrors the aarch64 ldrb/ldrh/ldr w0 dispatch and the x86
# movzx rax/movzx eax/mov eax dispatch, with cx using the new
# 0x44/0x45 cxvm opcodes added this slot.
fn EFIELD_LOAD_W(S, width): i64 {
    # 6.6.5: a NEGATIVE width is a SIGNED field. The three sized cxvm loads zero-extend, so
    # the signed case needs the shl/asr pair after them; this ladder used to test `width == 1`
    # and friends, which no negative width ever matched, so a signed narrow field fell all the
    # way through to the 64-bit `ELODC`.
    var aw = width;
    if (aw < 0) { aw = 0 - aw; }
    if (aw == 1) { CX_EMIT(S, 64, 0, 1, 0); }
    elif (aw == 2) { CX_EMIT(S, 68, 0, 1, 0); }
    elif (aw == 4) { CX_EMIT(S, 69, 0, 1, 0); }
    else { ELODC(S); return 0; }
    if (width < 0) { _CX_NARROW(S, width); }
    return 0;
}

# v5.9.40 — struct-by-value return (parse_fn.cyr:371).
# Emits a byte-copy loop: src in r9 (= fp + src_disp), dst in
# r10 (= load64 [fp + stash_disp]), counter in r11. Loop body
# walks the aligned byte count copying byte-by-byte; tail
# reloads retptr to r0 for the cyrius return ABI. Mirrors
# aarch64's LDRB/STRB-with-post-increment loop and x86's
# `rep movsb` block with an explicit cxvm-friendly shape.
fn ESTRUCT_BYVAL_COPY(S, src_disp, stash_disp, aligned): i64 {
    var src_abs = 0 - src_disp;
    var stash_abs = 0 - stash_disp;
    # r9 = fp - |src_disp|
    CX_EMIT(S, 2, 9, 253, 0);             # mov r9, fp
    CX_MOVI(S, 14, src_abs);              # r14 = |src_disp|
    CX_EMIT(S, 17, 9, 9, 14);             # sub r9, r9, r14
    # r14 = fp - |stash_disp|; r10 = load64 [r14] = retptr
    CX_EMIT(S, 2, 14, 253, 0);            # mov r14, fp
    CX_MOVI(S, 15, stash_abs);            # r15 = |stash_disp|
    CX_EMIT(S, 17, 14, 14, 15);           # sub r14, r14, r15
    CX_EMIT(S, 65, 10, 14, 0);            # load64 r10, [r14]
    # r11 = aligned byte count, r15 = 1 (incr/decr step)
    CX_MOVI(S, 11, aligned);
    CX_MOVI(S, 15, 1);
    # Loop body (6 instructions):
    #   load8  r12, [r9]
    #   store8 [r10], r12
    #   add    r9, r9, r15
    #   add    r10, r10, r15
    #   sub    r11, r11, r15
    #   jnz    r11, -5  (back 5 instructions)
    CX_EMIT(S, 64, 12, 9, 0);             # load8 r12, [r9]
    CX_EMIT(S, 66, 10, 12, 0);            # store8 [r10], r12
    CX_EMIT(S, 16, 9, 9, 15);             # add r9, r9, 1
    CX_EMIT(S, 16, 10, 10, 15);           # add r10, r10, 1
    CX_EMIT(S, 17, 11, 11, 15);           # sub r11, r11, 1
    # jnz r11, -5: PC after fetch points past jnz; -5 lands on
    # the load8 at the top of the body. cxvm decode:
    # `_cx_pc = _cx_pc - 4 + off * 4` with off = -5 (16-bit).
    var off = 0 - 5;
    var off_lo = off & 0xFF;
    var off_hi = (off >> 8) & 0xFF;
    CX_EMIT(S, 82, 11, off_lo, off_hi);
    # Reload retptr to r0 (loop incremented r10 past dest):
    #   r14 = fp - |stash_disp|; r0 = load64 [r14]
    CX_EMIT(S, 2, 14, 253, 0);            # mov r14, fp
    CX_MOVI(S, 15, stash_abs);            # r15 = |stash_disp|
    CX_EMIT(S, 17, 14, 14, 15);           # sub r14, r14, r15
    CX_EMIT(S, 65, 0, 14, 0);             # load64 r0, [r14]
    return 0;
}

# String address (fixup type 1)
fn ESADDR(S, soff): i64 {
    CX_MOVI(S, 0, 0);  # placeholder
    var fc = GFCNT(S);
    if (fc >= 1048576) {
        syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x150B000 + fc * 16;
    S64(faddr, GCP(S));
    S64(faddr + 8, (1 << 56) | soff);
    SFCNT(S, fc + 1);
    CX_EMIT(S, 254, 0, 0, 0);   # movhi slot: main_cx.cyr patches bytes 2-3 of the instruction AFTER the movi when addr > 0xFFFF; a bare movi put that patch on the NEXT instruction (v6.6.4)
    return 0;
}

# Var address into r1
fn EVADDR_X1(S, idx): i64 {
    CX_MOVI(S, 1, 0);
    RECFIX(S, idx);
    CX_EMIT(S, 254, 1, 0, 0);   # movhi slot: main_cx.cyr patches bytes 2-3 of the instruction AFTER the movi when addr > 0xFFFF; a bare movi put that patch on the NEXT instruction (v6.6.4)
    return 0;
}

# Add immediate to r1
fn EADDIMM_X1(S, val): i64 {
    CX_MOVI(S, 2, val);
    CX_EMIT(S, 16, 1, 1, 2);  # add r1, r1, r2
    return 0;
}

# Tail call: `return f(args);` → tear down THIS frame, then `jmp f` — the x86 shape (`mov rsp,rbp;
# pop rbp; jmp`), with cx's frame ops: `mov sp, fp; popc fp; jmp`. The callee's own prologue
# (`pushc fp; mov fp, sp`) then builds its frame where ours was, and its `ret` pops OUR caller's
# return address, which the jmp left on the call stack — so a tail recursion runs in constant
# call-stack and guest-stack space.
#
# By the time this is called the shared tail path (parse_fn.cyr PARSE_RETURN) has evaluated every
# argument onto the data stack and ECALLPOPS has popped them into r3.. — the data stack is
# balanced and nothing of this frame is read after the jmp, so a nested call among the arguments
# needs no special handling. Until 6.6.12 this emitted a normal call + epilogue under a comment
# claiming exactly that interleave broke a jmp; the cost was that every tail recursion grew both
# VM stacks, a 20M-deep one that runs on x86 died on cxvm, and past depth 512 it overwrote cxvm's
# loaded code (the call stack had no bound — see programs/cxvm.cyr, the cxvm host-memory bug). CHANGELOG [6.6.12]
#
# The jmp (0x50) takes its target from the same ftype-2 fixup ECALLFIX records: main_cx.cyr
# patches bytes 1-3 with `(target - coff) / 4` and keeps byte 0, which is the jmp encoding too.
fn ETAILJMP(S, fnidx): i64 {
    if (fnidx < 0) {
        if (_had_error == 0) { ERR_MSG(S, "internal: a call was emitted for an unresolved function (index < 0)", 67); }
        return 0;
    }
    CX_EMIT(S, 2, 254, 253, 0);   # mov sp, fp
    CX_EMIT(S, 0x63, 253, 0, 0);  # popc fp (from call stack)
    var poff = GCP(S);
    CX_EMIT(S, 80, 0, 0, 0);      # jmp +0 (placeholder, patched by the ftype-2 fixup)
    var fc = GFCNT(S);
    if (fc >= 1048576) {
        syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x150B000 + fc * 16;
    S64(faddr, poff);
    S64(faddr + 8, (2 << 56) | fnidx);
    SFCNT(S, fc + 1);
    return 0;
}

# Token access moved to src/backend/common/tokens.cyr at v6.0.8.

# Inline asm — not supported in bytecode
fn ASM_MNEMONIC(S): i64 {
    ERR_MSG(S, "inline asm not supported in cyrius-x", 36);
    return 0;
}

# v5.8.56: ELVRLOAD / ELVRSTORE / ELVRINIT stubs removed in lockstep
# with x86 + aarch64 removal — the x86 versions were never wired in,
# and these cx stubs only existed to mirror that backend.

# cx arc B: scalar f64 is REAL via the host-backed cxvm float opcodes (0x54-0x5F
# fadd/fsub/fmul/fdiv, i2f/f2i, flt/fle/fgt/fge/feq/fne; 0x64/0x65 fneg/fabs;
# 0x66/0x67 f32widen/f32narrow since v6.4.32; 0x68 fsqrt; 0x6A-0x6C ffloor/fceil/
# fround and 0x6D mulhu since 6.6.10, 0x6E ftrunc since 6.6.13 — EF64SQRT/FLOOR/CEIL/
# ROUND/TRUNC and EMULH below).
# What still FAILS LOUD through the helper below is the transcendental family
# (sin/cos/exp/ln/…): the VM has no libm opcodes. ⛔ Until 6.6.10 this comment said
# sqrt/floor and f32 conversion failed loud too — f32 was already real, and sqrt,
# floor, ceil, round and mulh64 were `return 0` stubs that left the operand in r0:
# a silent identity (sqrt(4.0) = 4.0, mulh64(2^32, 2^32) = 2^32). CHANGELOG [6.6.10]
# 6.6.10 — `kernel;` / `shared;` have no cx emitter: pass 1 (main_cx.cyr) recorded the mode
# and nothing read it, so the .cyx was byte-identical to no directive. Refused by name.
# (`object;` never reaches here: the cx pass 1 does not accept it.) CHANGELOG [6.6.10]
fn _cx_mode_refused(S): i64 {
    var km = L64(S + 0x18FCA0);
    if (km == 0) { return 0; }
    syscall(SYS_WRITE, 2, "error: `", 8);
    if (km == 1) { syscall(SYS_WRITE, 2, "kernel;", 7); } else { syscall(SYS_WRITE, 2, "shared;", 7); }
    syscall(SYS_WRITE, 2, "` is not supported by the cx bytecode backend (a .cyx is a cxvm program; there is no kernel image or shared object to emit)\n", 124);
    return 1;
}
# 6.6.11 — modules OUTSIDE the cx target's scope, refused BY NAME before anything is lexed.
# lib/tls.cyr, lib/tls_native.cyr and the lib/sigil.cyr fold compile to several MB of cx
# bytecode (cx output runs ~3.2x x86: tls is ~1.6 MB as an x86 ELF) against the fixed
# 512 KiB code buffer here and cxvm's 1 MB code/guest caps, so they died mid-emit with a
# bare "codebuf overflow" that named nothing. cx is a single-threaded test VM; the TLS stack
# and the crypto bundle are declared out of its scope rather than growing both halves.
# `p` is one NUL-terminated #@file name (the include path as written); it matches `suf` when
# it IS `suf` or ends in "/" + `suf`. CHANGELOG [6.6.11]
fn _cx_path_is(p, n, suf, sl): i64 {
    if (n < sl) { return 0; }
    if (n > sl) { if (load8(p + n - sl - 1) != 47) { return 0; } }
    var i = 0;
    while (i < sl) { if (load8(p + n - sl + i) != load8(suf + i)) { return 0; } i = i + 1; }
    return 1;
}
fn _cx_out_of_scope(p, n): i64 {
    if (_cx_path_is(p, n, "lib/tls.cyr", 11) == 1) { return 1; }
    if (_cx_path_is(p, n, "lib/tls_native.cyr", 18) == 1) { return 1; }
    if (_cx_path_is(p, n, "lib/sigil.cyr", 13) == 1) { return 1; }
    return 0;
}
# Walks FM_BUILD's name table (one entry per distinct file). A map that overflowed its
# 1024 entries drops later names; such a build still stops at the codebuf cap.
fn _cx_scope_refused(S): i64 {
    var nm = S + 0x721000;
    var pos = 0;
    var bad = 0;
    while (pos < _fm_str_pos) {
        var n = 0;
        while (load8(nm + pos + n) != 0) { n = n + 1; }
        if (_cx_out_of_scope(nm + pos, n) == 1) {
            syscall(SYS_WRITE, 2, "error: ", 7);
            PRSTR(nm + pos);
            syscall(SYS_WRITE, 2, " is outside the cx target's scope (the TLS stack and the sigil bundle compile to several MB of bytecode; a .cyx holds 512 KiB) — build it for a native target\n", 160);
            bad = 1;
        }
        pos = pos + n + 1;
    }
    return bad;
}
fn _cx_float_unsupported(S): i64 {
    ERR_MSG(S, "this float op is not yet supported on the cx bytecode target", 60);
    return 0;
}
# float literal: `v` indexes the side table, whose FLIT_NUM is the literal's binary64 bits,
# correctly rounded by the lexer (_flit_bits in src/frontend/lex.cyr) — one 64-bit movi,
# the same bits as the x86 movabs. ⛔ 6.6.10 — it was i2f/i2f/fdiv over an i64 numer/denom
# pair, which overflowed and double-rounded silently. CHANGELOG [6.6.10]
fn EMIT_FLOAT_LIT(S, v): i64 {
    CX_MOVI(S, 0, FLIT_NUM(v));     # r0 = f64 bit pattern
    return 0;
}
# f64 a OP b: the frontend leaves a (left) on the stack, b (right) in r0
# (mirrors x86 EMIT_F64_BINOP). fop 0=add 1=sub 2=mul 3=div → opcodes 0x54..0x57.
fn EMIT_F64_BINOP(S, op): i64 {
    EPOPC(S);                       # r1 = a (left)
    CX_EMIT(S, 84 + op, 0, 1, 0);   # f{add,sub,mul,div} r0, r1, r0  = a OP b
    return 0;
}
# v6.4.56 (scalar-float D2) — f32 scalar arith. cxvm has no native f32 ALU op:
# widen both operands to f64 (f32widen=102), do the f64 op (84+op), narrow the
# result back to f32 bits (f32narrow=103). Frontend leaves a on stack, b in r0.
fn EMIT_F32_BINOP(S, op): i64 {
    EPOPC(S);                       # r1 = a (left, f32 bits); r0 = b (right, f32 bits)
    CX_EMIT(S, 102, 1, 1, 0);       # f32widen r1  = (f64)a
    CX_EMIT(S, 102, 0, 0, 0);       # f32widen r0  = (f64)b
    CX_EMIT(S, 84 + op, 0, 1, 0);   # f{add,sub,mul,div} r0, r1, r0  = a OP b (f64)
    CX_EMIT(S, 103, 0, 0, 0);       # f32narrow r0  = (f32 bits)result
    return 0;
}
# v6.4.56 (scalar-float D2) — f32 scalar compare. Widen both to f64, then reuse
# the exact fcmp opcode select from EF64_CMP. Frontend leaves a in r1, b on stack.
fn EF32_CMP(S, tok): i64 {
    EPOPR(S);                       # r0 = b (right); r1 = a (left)
    CX_EMIT(S, 102, 1, 1, 0);       # f32widen r1  = (f64)a
    CX_EMIT(S, 102, 0, 0, 0);       # f32widen r0  = (f64)b
    var op = 94;                    # default feq (== tok 17, eq builtin tok 68)
    if (tok == 69) { op = 90; }     # lt builtin → flt
    if (tok == 70) { op = 92; }     # gt builtin → fgt
    if (tok == 19) { op = 90; }     # <   → flt
    if (tok == 20) { op = 92; }     # >   → fgt
    if (tok == 21) { op = 91; }     # <=  → fle
    if (tok == 22) { op = 93; }     # >=  → fge
    if (tok == 18) { op = 95; }     # !=  → fne
    CX_EMIT(S, op, 0, 1, 0);        # fcmp r0, r1, r0  = (a CMP b) ? 1 : 0
    return 0;
}
fn EI2F(S): i64 { CX_EMIT(S, 88, 0, 0, 0); return 0; }   # i2f r0, r0
fn EF2I(S): i64 { CX_EMIT(S, 89, 0, 0, 0); return 0; }   # f2i r0, r0
fn EF32_FROM(S): i64 { CX_EMIT(S, 103, 0, 0, 0); return 0; }   # v6.4.32: f32narrow r0 (f64→f32 bits)
fn EF32_TO(S): i64 { CX_EMIT(S, 102, 0, 0, 0); return 0; }     # v6.4.32: f32widen r0 (f32 bits→f64)
# EMOVQ_X0_A / EMOVQ_A_X0 are x86 bit-cast helpers that shared parse code
# calls around f64 values. cx keeps the f64 BITS in r0 (the float opcodes
# above operate on them), so both are no-ops.
fn EMOVQ_X0_A(S): i64 { return 0; }
fn EMOVQ_A_X0(S): i64 { return 0; }
# ============================================================================
# v6.4.32 — cx SIMD flat-array emitters (per-lane scalar bytecode loops).
# cx is a scalar VM with no vector registers, so every packed SIMD builtin lowers
# to a loop over the same &dst/&a/&b pointers (the frontend stashes them + n into
# frame slots vbase..vbase+k). Results are byte-identical to the x86 SSE /
# aarch64 NEON packed paths — cx is a portable correctness oracle, not hardware
# SIMD. Reg map: r8=n · r9=i(lane) · r2=byte offset(i*stride) · r10..r13=base
# ptrs · r14/r15=addr+imm scratch · r0/r1=values · r3=accumulator. Loop guard:
# `lt r0,i,n` (op 50) then `jz r0,done` (op 81); back-edge via EJMP/EPATCH.
# Value-form params/returns stay stubbed (ESTOREPARM_*/ELOAD_* above) — deferred,
# see docs/development/issues/archived/2026-07-09-cx-valueform-simd-params-returns.md.

# Load the pointer/scalar held in frame local `idx` into `reg` (local idx lives
# at [fp − (idx+1)*8], same convention as EFLLOAD_F64V2_PAIR).
fn _cx_ld_local(S, reg, idx): i64 {
    CX_EMIT(S, 2, 14, 253, 0);            # mov r14, fp
    CX_MOVI(S, 15, _cx_ldisp(idx));        # r15 = (idx+1)*8
    CX_EMIT(S, 17, 14, 14, 15);           # sub r14, r14, r15  → &local[idx]
    CX_EMIT(S, 65, reg, 14, 0);           # load64 reg, [r14]
    return 0;
}

# dst[i] = a[i] <arop> b[i], i in [0,n). stride=lane bytes; ldop/stop width-matched
# load/store; arop=scalar op (f64 84+ / int 16+). is_f32=1 → widen operands (op
# 102) + narrow result (op 103): compute-in-f64, round once → bit-exact vs addps.
fn _CX_VLOOP_BIN(S, dslot, aslot, bslot, stride, ldop, stop, arop, is_f32): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0 from the last PCMPE, like x86 rax) — NOT a frame slot
    _cx_ld_local(S, 10, dslot);
    _cx_ld_local(S, 11, aslot);
    _cx_ld_local(S, 12, bslot);
    CX_MOVI(S, 9, 0);
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);              # r0 = (i < n)
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);              # jz r0, done
    CX_MOVI(S, 15, stride);
    CX_EMIT(S, 18, 2, 9, 15);             # r2 = i*stride
    CX_EMIT(S, 16, 14, 11, 2);            # a+off
    CX_EMIT(S, ldop, 1, 14, 0);           # r1 = a[i]
    CX_EMIT(S, 16, 14, 12, 2);            # b+off
    CX_EMIT(S, ldop, 0, 14, 0);           # r0 = b[i]
    if (is_f32 == 1) { CX_EMIT(S, 102, 1, 1, 0); CX_EMIT(S, 102, 0, 0, 0); }
    CX_EMIT(S, arop, 1, 1, 0);            # r1 = a OP b
    if (is_f32 == 1) { CX_EMIT(S, 103, 1, 1, 0); }
    CX_EMIT(S, 16, 14, 10, 2);            # dst+off
    CX_EMIT(S, stop, 14, 1, 0);           # store dst[i]
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);             # i++
    EJMP(S, top);
    EPATCH(S, dp);
    return 0;
}

fn EMIT_F64V_LOOP(S, op, vbase): i64 { _CX_VLOOP_BIN(S, vbase, vbase + 1, vbase + 2, 8, 65, 67, 84 + op, 0); return 0; }
fn EMIT_F32V_LOOP(S, op, vbase): i64 { _CX_VLOOP_BIN(S, vbase, vbase + 1, vbase + 2, 4, 69, 71, 84 + op, 1); return 0; }
fn EMIT_F32V8_LOOP(S, op, vbase): i64 { EMIT_F32V_LOOP(S, op, vbase); return 0; }
# v6.5.24 — f64v4: cx SIMD is a per-lane scalar loop driven by `n`, so lane width per
# iteration is irrelevant and delegating to the f64v loop is exactly correct.
fn EMIT_F64V4_LOOP(S, op, vbase): i64 { EMIT_F64V_LOOP(S, op, vbase); return 0; }
# v6.5.38: 256-bit fmadd has no meaning off x86 — delegate to the 128-bit emitter, exactly as
# EMIT_F64V4_LOOP above does. The lib wrapper gates on simd_has_avx2(), which is x86-only, so
# this path is unreachable in practice; it exists so every fork links and so a future arch with
# 256-bit vectors has one obvious place to specialise.
fn EMIT_F64V4_FMADD(S, vbase): i64 { EMIT_F64V_FMADD(S, vbase); return 0; }
fn EMIT_F64V4_UNARY(S, op, vbase): i64 { EMIT_F64V_UNARY(S, op, vbase); return 0; }
fn EMIT_F64V4_SCALE(S, vbase): i64 { EMIT_F64V_SCALE(S, vbase); return 0; }
fn EMIT_F64V4_DOT(S, vbase): i64 { EMIT_F64V_DOT(S, vbase); return 0; }

fn EMIT_IVEC_BINOP(S, op, w, vbase): i64 {
    var ldop = 64; var stop = 66;         # w==1: load8/store8 (store truncates → low-w)
    if (w == 2) { ldop = 68; stop = 70; }
    if (w == 4) { ldop = 69; stop = 71; }
    if (w == 8) { ldop = 65; stop = 67; }
    # v6.4.53: i64 mul (w==8) works natively here — the scalar per-lane loop does a 64-bit
    # MUL (opcode 18) on load64'd lanes, giving the low-64 product with no pmuludq synthesis
    # (that's only needed on the packed SIMD backends). i8 (w==1) still has no vector mul.
    if (op == 2) { if (w == 1) { ERR_MSG(S, "packed integer mul is i16/i32/i64 only", 38); } }
    _CX_VLOOP_BIN(S, vbase, vbase + 1, vbase + 2, w, ldop, stop, 16 + op, 0);
    return 0;
}

# dst[i] = <uop>(src[i]). op 0 = sqrt (op 104), op 1 = abs (op 101). slots: dst,src,n.
fn EMIT_F64V_UNARY(S, op, vbase): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0 from last PCMPE)
    _cx_ld_local(S, 10, vbase);
    _cx_ld_local(S, 11, vbase + 1);
    CX_MOVI(S, 9, 0);
    var uop = 104; if (op == 1) { uop = 101; }
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);
    CX_MOVI(S, 15, 8);
    CX_EMIT(S, 18, 2, 9, 15);
    CX_EMIT(S, 16, 14, 11, 2);
    CX_EMIT(S, 65, 1, 14, 0);             # r1 = src[i]
    CX_EMIT(S, uop, 1, 1, 0);             # r1 = sqrt/abs(r1)
    CX_EMIT(S, 16, 14, 10, 2);
    CX_EMIT(S, 67, 14, 1, 0);
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);
    EJMP(S, top);
    EPATCH(S, dp);
    return 0;
}

# sum(a[i]*b[i]) → f64 bits in r0. slots: a=vbase, b=vbase+1, n=vbase+2.
fn EMIT_F64V_DOT(S, vbase): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0)
    _cx_ld_local(S, 11, vbase);
    _cx_ld_local(S, 12, vbase + 1);
    CX_MOVI(S, 9, 0);
    CX_MOVI(S, 3, 0);                     # acc = 0.0 (f64 bits)
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);
    CX_MOVI(S, 15, 8);
    CX_EMIT(S, 18, 2, 9, 15);
    CX_EMIT(S, 16, 14, 11, 2);
    CX_EMIT(S, 65, 0, 14, 0);             # r0 = a[i]
    CX_EMIT(S, 16, 14, 12, 2);
    CX_EMIT(S, 65, 1, 14, 0);             # r1 = b[i]
    CX_EMIT(S, 86, 0, 0, 1);              # r0 = a*b
    CX_EMIT(S, 84, 3, 3, 0);              # acc += r0
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);
    EJMP(S, top);
    EPATCH(S, dp);
    CX_EMIT(S, 2, 0, 3, 0);               # r0 = acc
    return 0;
}

# dst[i] = a[i] * scalar. slots: dst=vbase, a=+1, scalar(f64 bits)=+2, n=+3.
fn EMIT_F64V_SCALE(S, vbase): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0)
    _cx_ld_local(S, 10, vbase);
    _cx_ld_local(S, 11, vbase + 1);
    _cx_ld_local(S, 12, vbase + 2);       # scalar bits
    CX_MOVI(S, 9, 0);
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);
    CX_MOVI(S, 15, 8);
    CX_EMIT(S, 18, 2, 9, 15);
    CX_EMIT(S, 16, 14, 11, 2);
    CX_EMIT(S, 65, 1, 14, 0);
    CX_EMIT(S, 86, 1, 1, 12);             # r1 = a[i]*scalar
    CX_EMIT(S, 16, 14, 10, 2);
    CX_EMIT(S, 67, 14, 1, 0);
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);
    EJMP(S, top);
    EPATCH(S, dp);
    return 0;
}

# y[i] = y[i] + alpha*x[i]. slots: y=vbase, x=+1, alpha=+2, n=+3.
fn EMIT_F64V_AXPY(S, vbase): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0)
    _cx_ld_local(S, 10, vbase);
    _cx_ld_local(S, 11, vbase + 1);
    _cx_ld_local(S, 12, vbase + 2);       # alpha bits
    CX_MOVI(S, 9, 0);
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);
    CX_MOVI(S, 15, 8);
    CX_EMIT(S, 18, 2, 9, 15);
    CX_EMIT(S, 16, 14, 11, 2);
    CX_EMIT(S, 65, 1, 14, 0);             # x[i]
    CX_EMIT(S, 86, 1, 1, 12);             # alpha*x[i]
    CX_EMIT(S, 16, 14, 10, 2);
    CX_EMIT(S, 65, 0, 14, 0);             # y[i]  (r14 = y+off)
    CX_EMIT(S, 84, 0, 0, 1);              # y[i] + alpha*x[i]
    CX_EMIT(S, 67, 14, 0, 0);             # store y[i]
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);
    EJMP(S, top);
    EPATCH(S, dp);
    return 0;
}

# dst[i] = a[i]*b[i] + c[i]. slots: dst=vbase, a=+1, b=+2, c=+3, n=+4 (2 rounds).
fn EMIT_F64V_FMADD(S, vbase): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0)
    _cx_ld_local(S, 10, vbase);
    _cx_ld_local(S, 11, vbase + 1);
    _cx_ld_local(S, 12, vbase + 2);
    _cx_ld_local(S, 13, vbase + 3);
    CX_MOVI(S, 9, 0);
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);
    CX_MOVI(S, 15, 8);
    CX_EMIT(S, 18, 2, 9, 15);
    CX_EMIT(S, 16, 14, 11, 2);
    CX_EMIT(S, 65, 0, 14, 0);             # a
    CX_EMIT(S, 16, 14, 12, 2);
    CX_EMIT(S, 65, 1, 14, 0);             # b
    CX_EMIT(S, 86, 0, 0, 1);              # a*b
    CX_EMIT(S, 16, 14, 13, 2);
    CX_EMIT(S, 65, 1, 14, 0);             # c
    CX_EMIT(S, 84, 0, 0, 1);              # a*b + c
    CX_EMIT(S, 16, 14, 10, 2);
    CX_EMIT(S, 67, 14, 0, 0);
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);
    EJMP(S, top);
    EPATCH(S, dp);
    return 0;
}

# f32 fmadd: dst[i] = narrow(narrow(a*b) + c). Two roundings match mulps+addps.
fn EMIT_F32V_FMADD(S, vbase): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0)
    _cx_ld_local(S, 10, vbase);
    _cx_ld_local(S, 11, vbase + 1);
    _cx_ld_local(S, 12, vbase + 2);
    _cx_ld_local(S, 13, vbase + 3);
    CX_MOVI(S, 9, 0);
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);
    CX_MOVI(S, 15, 4);
    CX_EMIT(S, 18, 2, 9, 15);
    CX_EMIT(S, 16, 14, 11, 2);
    CX_EMIT(S, 69, 0, 14, 0); CX_EMIT(S, 102, 0, 0, 0);   # a widened
    CX_EMIT(S, 16, 14, 12, 2);
    CX_EMIT(S, 69, 1, 14, 0); CX_EMIT(S, 102, 1, 1, 0);   # b widened
    CX_EMIT(S, 86, 0, 0, 1);              # a*b
    CX_EMIT(S, 103, 0, 0, 0); CX_EMIT(S, 102, 0, 0, 0);   # round to f32, widen back
    CX_EMIT(S, 16, 14, 13, 2);
    CX_EMIT(S, 69, 1, 14, 0); CX_EMIT(S, 102, 1, 1, 0);   # c widened
    CX_EMIT(S, 84, 0, 0, 1);              # (a*b)+c
    CX_EMIT(S, 103, 0, 0, 0);             # round to f32
    CX_EMIT(S, 16, 14, 10, 2);
    CX_EMIT(S, 71, 14, 0, 0);             # store32
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);
    EJMP(S, top);
    EPATCH(S, dp);
    return 0;
}

# f32 dot: accumulator rounded to f32 each step (matches addps). slots a,b,n.
fn EMIT_F32V_DOT(S, vbase): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0)
    _cx_ld_local(S, 11, vbase);
    _cx_ld_local(S, 12, vbase + 1);
    CX_MOVI(S, 9, 0);
    CX_MOVI(S, 3, 0);                     # acc (f32 bits 0)
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);
    CX_MOVI(S, 15, 4);
    CX_EMIT(S, 18, 2, 9, 15);
    CX_EMIT(S, 16, 14, 11, 2);
    CX_EMIT(S, 69, 0, 14, 0); CX_EMIT(S, 102, 0, 0, 0);   # a widened
    CX_EMIT(S, 16, 14, 12, 2);
    CX_EMIT(S, 69, 1, 14, 0); CX_EMIT(S, 102, 1, 1, 0);   # b widened
    CX_EMIT(S, 86, 0, 0, 1);              # a*b
    CX_EMIT(S, 103, 0, 0, 0); CX_EMIT(S, 102, 0, 0, 0);   # prod round→f32, widen
    CX_EMIT(S, 102, 1, 3, 0);             # widen acc into r1
    CX_EMIT(S, 84, 0, 0, 1);              # acc + prod (f64)
    CX_EMIT(S, 103, 3, 0, 0);             # acc = round → f32
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);
    EJMP(S, top);
    EPATCH(S, dp);
    CX_EMIT(S, 2, 0, 3, 0);               # r0 = acc (f32 bits)
    return 0;
}

fn EMIT_F32V8_FMADD(S, vbase): i64 { EMIT_F32V_FMADD(S, vbase); return 0; }
fn EMIT_F32V8_DOT(S, vbase): i64 { EMIT_F32V_DOT(S, vbase); return 0; }

# int8 widening dot: a=u8 (zero-ext), b=i8 (sign-ext), acc in i32, result sign-
# extended to i64 in r0. slots: a=vbase, b=vbase+1, n=vbase+2 (stride 1).
fn EMIT_IVEC_DP8(S, vbase): i64 {
    CX_EMIT(S, 2, 8, 0, 0);               # r8 = n (in r0)
    _cx_ld_local(S, 11, vbase);
    _cx_ld_local(S, 12, vbase + 1);
    CX_MOVI(S, 9, 0);
    CX_MOVI(S, 3, 0);                     # acc = 0
    var top = GCP(S);
    CX_EMIT(S, 50, 0, 9, 8);
    var dp = GCP(S);
    CX_EMIT(S, 81, 0, 0, 0);
    CX_EMIT(S, 16, 14, 11, 9);            # a + i
    CX_EMIT(S, 64, 0, 14, 0);             # r0 = a[i] (u8, zero-ext)
    CX_EMIT(S, 16, 14, 12, 9);            # b + i
    CX_EMIT(S, 64, 1, 14, 0);             # r1 = b[i] (0..255)
    # sign-extend i8 (cxvm >> is LOGICAL): signed = b − ((b>>7) << 8).
    CX_MOVI(S, 15, 7);
    CX_EMIT(S, 36, 14, 1, 15);            # r14 = b >> 7  (bit 7: 0 or 1)
    CX_MOVI(S, 15, 8);
    CX_EMIT(S, 35, 14, 14, 15);           # r14 = bit7 << 8  (0 or 256)
    CX_EMIT(S, 17, 1, 1, 14);             # r1 = b − r14  → signed i8
    CX_EMIT(S, 18, 0, 0, 1);              # r0 = a*b (a=u8 ≥0, b=i8 signed)
    CX_EMIT(S, 16, 3, 3, 0);              # acc += a*b  (i64 acc; corpus never overflows i32)
    CX_MOVI(S, 15, 1);
    CX_EMIT(S, 16, 9, 9, 15);
    EJMP(S, top);
    EPATCH(S, dp);
    CX_EMIT(S, 2, 0, 3, 0);               # r0 = acc (already correctly signed i64)
    return 0;
}
# f64 unary ops on the f64 BITS in r0 (the frontend's EMOVQ_* around these are no-ops
# on cx), host-backed like the other float opcodes. round = nearest, ties to EVEN — the
# x86 `roundsd imm 0` and aarch64 `frintn` contract, which cxvm inherits by calling the
# host's own f64_round. These were `return 0` stubs until 6.6.10. CHANGELOG [6.6.10]
fn EF64SQRT(S): i64 { CX_EMIT(S, 104, 0, 0, 0); return 0; }    # 0x68 fsqrt  r0, r0
fn EF64FLOOR(S): i64 { CX_EMIT(S, 106, 0, 0, 0); return 0; }   # 0x6A ffloor r0, r0
fn EF64CEIL(S): i64 { CX_EMIT(S, 107, 0, 0, 0); return 0; }    # 0x6B fceil  r0, r0
fn EF64ROUND(S): i64 { CX_EMIT(S, 108, 0, 0, 0); return 0; }   # 0x6C fround r0, r0
fn EF64TRUNC(S): i64 { CX_EMIT(S, 110, 0, 0, 0); return 0; }   # 0x6E ftrunc r0, r0 (6.6.13)
# v5.9.40 Phase 2c — real EFLADDR / EFLADDR_X1 for cx. Compute
# &local-slot. Required by parse_decl.cyr's asv (assignment-
# from-struct-value) caller-side and by PARSE_FIELD_STORE/LOAD
# when the local var is an inline struct (fs_is_ptr == 0 path,
# parse_decl.cyr:344).
#   EFLADDR    → addr in r0 (pushed as fn-arg or paired with EPOPC)
#   EFLADDR_X1 → addr in r1 (paired with EPOPR + storeN [r1], r0)
# Sub-8-byte struct field stores route through EFLADDR_X1 when
# the parent var is inline; without this stub cycc_cx hit SIGILL
# at parse-time on any struct mixing i8/i16/i32 with i64.
fn EFLADDR(S, lli): i64 {
    var disp = (lli + 1) * 8;
    if (_cur_fn_regalloc > 0) { disp = disp + _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp + _cur_fn_ret_stash; }
    CX_EMIT(S, 2, 0, 253, 0);             # mov r0, fp
    CX_MOVI(S, 14, disp);                 # r14 = disp
    CX_EMIT(S, 17, 0, 0, 14);             # sub r0, r0, r14
    return 0;
}
fn EFLADDR_X1(S, lli): i64 {
    var disp = (lli + 1) * 8;
    if (_cur_fn_regalloc > 0) { disp = disp + _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp + _cur_fn_ret_stash; }
    CX_EMIT(S, 2, 1, 253, 0);             # mov r1, fp
    CX_MOVI(S, 14, disp);                 # r14 = disp
    CX_EMIT(S, 17, 1, 1, 14);             # sub r1, r1, r14
    return 0;
}

# v5.9.40 Phase 2c — real ESTOREREGPARM for cx. Stash the param
# register r(3+pidx) into the local frame at fp+disp (disp is
# negative). Used by parse_fn.cyr:930 in the struct-return
# prologue: cx receives retptr as the FIRST arg in r3, then
# stashes it for later reload by ESTRUCT_BYVAL_COPY's tail.
# x86 + aarch64 backends have separate ESTOREREGPARM impls that
# encode their native indirect-result register conventions
# (RDI/RCX for x86 SysV/Win64, X8 for aarch64 AAPCS); cx mirrors
# the x86-shape convention since cxvm has no dedicated indirect-
# result register but plenty of GP regs.
fn ESTOREREGPARM(S, pidx, disp): i64 {
    _cx_fpaddr(S, 0 - disp);              # 6.6.17: r251 = fp - |disp| (see _cx_fpaddr)
    CX_EMIT(S, 67, 251, 3 + pidx, 0);     # store64 [r251], r(3+pidx)
    return 0;
}
# mulh64(a, b): the high 64 bits of the UNSIGNED 128-bit product. The frontend pops a
# into r1 (EPOPC) with b in r0, as x86 `mul rcx` / aarch64 `umulh x0, x1, x0` expect.
# A `return 0` stub until 6.6.10, which returned b. CHANGELOG [6.6.10]
fn EMULH(S): i64 { CX_EMIT(S, 109, 0, 1, 0); return 0; }       # 0x6D mulhu r0, r1, r0

