# v5.9.40 — clean up cx-side undefined-fn warnings carried since
# v5.9.39's Mach-O fix (EADRP/EADD_IMM12 added to aarch64/x86
# but cx wasn't paired). Stubs for the dead cross-arch branches
# in shared frontend files. EFLADDR + EMULH + _read_env are
# pre-existing carry-overs from earlier minors — folded in here
# rather than spinning a separate slot per the v5.9.38/.39
# "don't lazy-defer related fixes" feedback.
fn EADRP(S, reg): i64 { return 0; }
fn EADD_IMM12(S, reg): i64 { return 0; }
# v5.9.40 Phase 2c — real EFLADDR / EFLADDR_X1 for cx. Compute
# &local-slot. Required by parse_decl.cyr's asv (assignment-
# from-struct-value) caller-side and by PARSE_FIELD_STORE/LOAD
# when the local var is an inline struct (fs_is_ptr == 0 path,
# parse_decl.cyr:344).
#   EFLADDR    → addr in r0 (pushed as fn-arg or paired with EPOPC)
#   EFLADDR_X1 → addr in r1 (paired with EPOPR + storeN [r1], r0)
# Sub-8-byte struct field stores route through EFLADDR_X1 when
# the parent var is inline; without this stub cycc_cx hit SIGILL
# at parse-time on any struct mixing i8/i16/i32 with i64.
fn EFLADDR(S, lli): i64 {
    var disp = (lli + 1) * 8;
    if (_cur_fn_regalloc > 0) { disp = disp + _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp + _cur_fn_ret_stash; }
    CX_EMIT(S, 2, 0, 253, 0);             # mov r0, fp
    CX_MOVI(S, 14, disp);                 # r14 = disp
    CX_EMIT(S, 17, 0, 0, 14);             # sub r0, r0, r14
    return 0;
}
fn EFLADDR_X1(S, lli): i64 {
    var disp = (lli + 1) * 8;
    if (_cur_fn_regalloc > 0) { disp = disp + _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp + _cur_fn_ret_stash; }
    CX_EMIT(S, 2, 1, 253, 0);             # mov r1, fp
    CX_MOVI(S, 14, disp);                 # r14 = disp
    CX_EMIT(S, 17, 1, 1, 14);             # sub r1, r1, r14
    return 0;
}

# v5.9.40 Phase 2c — real ESTOREREGPARM for cx. Stash the param
# register r(3+pidx) into the local frame at fp+disp (disp is
# negative). Used by parse_fn.cyr:930 in the struct-return
# prologue: cx receives retptr as the FIRST arg in r3, then
# stashes it for later reload by ESTRUCT_BYVAL_COPY's tail.
# x86 + aarch64 backends have separate ESTOREREGPARM impls that
# encode their native indirect-result register conventions
# (RDI/RCX for x86 SysV/Win64, X8 for aarch64 AAPCS); cx mirrors
# the x86-shape convention since cxvm has no dedicated indirect-
# result register but plenty of GP regs.
fn ESTOREREGPARM(S, pidx, disp): i64 {
    var abs_disp = 0 - disp;
    CX_EMIT(S, 2, 14, 253, 0);            # mov r14, fp
    CX_MOVI(S, 15, abs_disp);             # r15 = |disp|
    CX_EMIT(S, 17, 14, 14, 15);           # sub r14, r14, r15
    CX_EMIT(S, 67, 14, 3 + pidx, 0);      # store64 [r14], r(3+pidx)
    return 0;
}
fn EMULH(S): i64 { return 0; }
fn _read_env(name): i64 { return 0; }

# ============================================================================
# v6.3.2: cross-arch emit stubs. The cyrius-x (cx) bytecode target shares the
# frontend/dispatch with the x86/PE + Mach-O backends, which reference these
# *_PE (Windows) / *_ARM (Mach-O) emitters. They are DEAD on cx (it emits
# bytecode, never PE/Mach-O) but reachable-per-DCE, so the v6.3.2 default
# undefined-fn hard error needs them defined. No-op (return 0); the aarch64
# fork stubs the *_PE family the same way (see src/backend/aarch64/emit.cyr).
# ============================================================================
