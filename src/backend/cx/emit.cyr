# v6.6.4: was a return-0 STUB, so the power-of-two multiply strength reduction
# (`x * 2` -> `shl`) emitted NOTHING on cx and `x * 2` returned x. r2 is the
# immediate scratch (EADDIMM_X1 uses it the same way); r1 may hold the RHS.
fn ESHLIMM(S, n): i64 {
    CX_MOVI(S, 2, n & 0x3F);
    CX_EMIT(S, 35, 0, 0, 2);   # shl r0, r0, r2
    return 0;
}
