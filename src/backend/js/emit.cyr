# ================================================================
# src/backend/js/emit.cyr — TS/TSX → JS emitter (Phase D, v6.1.11)
# ================================================================
# `cycc --emit-js <file.tsx>` walks the parsed AST (made walkable by the
# v6.1.10 children-list allocator fix) and emits browser JS:
#   - strips type annotations, interfaces, type aliases, `as`/`!`,
#     generic type-args, optional `?` markers, param/return types;
#   - lowers JSX to `h(tag, props, ...children)` pragma calls (pragma
#     configurable via CYRIUS_JSX_PRAGMA; default `h`), and — unless a
#     custom pragma is set — prepends a ~12-line standalone `h` runtime so
#     the output is browser-runnable with zero deps;
#   - passes ESM import/export through, pruning type-only export names;
#   - re-emits template literals + string/number literals verbatim.
# Single-file emit; no bundler. The AST traversal mirrors the v6.1.10
# walk-validator and keeps its revisit self-check, so `--emit-js` still
# exits non-zero on a children-list regression (check.sh _ts_walk_gate).
# CYRIUS_TS_DUMP=1 gives the raw node-table dump. See CHANGELOG [6.1.11].

# ---- output buffer (_output_base = the otherwise-idle output_buf) ----
var _js_buf = 0;
var _js_len = 0;
var _js_walk_err = 0;          # revisit / out-of-range → non-zero exit
# v6.1.12: structural-newline indent depth (2 spaces/level). Bumped only around
# block bodies (class/block/switch); applied ONLY at structural newlines via
# _ej_nl, never inside verbatim string/template content (_ej_raw), so template
# literals carrying their own newlines are never re-indented. See CHANGELOG [6.1.12].
var _js_ind = 0;
# v6.1.12: when set, a STMT_VAR_DECL emits its binding WITHOUT the trailing `;`.
# Used for loop headers: a for-init / for-of / for-in binding is a var-decl node
# but must not carry its own statement semicolon (`for (let i = 0;; …)` /
# `for (const x; of …)` were invalid JS — the var-decl's `;` plus the header
# separator). Set only around the header binding, cleared immediately. See
# CHANGELOG [6.1.12].
var _js_omit_semi = 0;
# JSX pragma (default "h") + whether to emit the standalone h prelude.
var _jsx_pragma[64];
var _jsx_pragma_len = 0;
var _jsx_prelude = 1;
# Type-only names (interfaces + type aliases) to prune from `export {}`.
var _type_spans[512];          # up to 512 packed name-spans
var _type_count = 0;

fn _ej(b): i64 {
    if (_js_len >= 2097152) { return 0; }
    store8(_js_buf + _js_len, b & 0xFF);
    _js_len = _js_len + 1;
    return 0;
}

# Emit a NUL-terminated cstring literal.
fn _ejs(s): i64 {
    var i = 0;
    var c = load8(s + i);
    while (c != 0) {
        _ej(c);
        i = i + 1;
        c = load8(s + i);
    }
    return 0;
}

# Emit `len` raw bytes from src+start.
fn _ej_raw(src, start, len): i64 {
    var i = 0;
    while (i < len) {
        _ej(load8(src + start + i));
        i = i + 1;
    }
    return 0;
}

# v6.1.12: emit the current indent (2 spaces × _js_ind).
fn _ej_indent(): i64 {
    var i = 0;
    while (i < _js_ind) { _ej(32); _ej(32); i = i + 1; }
    return 0;
}

# v6.1.12: structural newline — `\n` then the current indent for the next line.
fn _ej_nl(): i64 {
    _ej(10);
    _ej_indent();
    return 0;
}

# v6.1.12: emit a for-loop-header binding (init / for-of / for-in target). If it
# is a var-decl it must drop its statement `;` (the header supplies separators).
# A plain expression target (`for (x of …)`) is emitted unchanged.
fn _ej_for_head(ts_base, src, p): i64 {
    _js_omit_semi = 1;
    _TS_JS(ts_base, src, p);
    _js_omit_semi = 0;
    return 0;
}

fn _span_start(span): i64 { return (span / 16777216) % 16777216; }
fn _span_len(span): i64 { return span % 16777216; }

# Emit the source text a span covers (identifier / number / raw chunk).
fn _ej_span(src, span): i64 {
    _ej_raw(src, _span_start(span), _span_len(span));
    return 0;
}

# Emit a string literal verbatim INCLUDING its original quotes. Lex spans
# for string content exclude the quotes, so the opening quote sits at
# start-1 and the closing quote at start+len — emit start-1 .. start+len+1.
fn _ej_strlit(src, span): i64 {
    var st = _span_start(span);
    var ln = _span_len(span);
    if (st > 0) {
        _ej_raw(src, st - 1, ln + 2);
    } else {
        _ej(34); _ej_raw(src, st, ln); _ej(34);
    }
    return 0;
}

# True if a span's text is a valid JS identifier (so a JSX attr name can be
# an unquoted object key; `data-id` etc. must be quoted).
fn _is_ident_span(src, span): i64 {
    var st = _span_start(span);
    var ln = _span_len(span);
    if (ln == 0) { return 0; }
    var i = 0;
    while (i < ln) {
        var c = load8(src + st + i);
        var ok = 0;
        if (c >= 97 && c <= 122) { ok = 1; }      # a-z
        elif (c >= 65 && c <= 90) { ok = 1; }      # A-Z
        elif (c == 95 || c == 36) { ok = 1; }      # _ $
        elif (i > 0 && c >= 48 && c <= 57) { ok = 1; }  # 0-9 (not first)
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# True if a span's first char is uppercase (JSX component vs HTML tag).
fn _is_upper_span(src, span): i64 {
    var st = _span_start(span);
    var c = load8(src + st);
    if (c >= 65 && c <= 90) { return 1; }
    return 0;
}

# Compare two spans' source text for equality.
fn _span_eq(src, a, b): i64 {
    var la = _span_len(a);
    var lb = _span_len(b);
    if (la != lb) { return 0; }
    var sa = _span_start(a);
    var sb = _span_start(b);
    var i = 0;
    while (i < la) {
        if (load8(src + sa + i) != load8(src + sb + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn _is_type_name(src, span): i64 {
    var i = 0;
    while (i < _type_count) {
        if (_span_eq(src, span, load64(&_type_spans + i * 8)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Map a TS_TOK_* operator constant to its JS text. Word operators
# (typeof/void/delete/await/yield/in/instanceof) include a trailing space;
# the caller handles spacing for symbol operators.
fn _ej_op(op): i64 {
    if (op == TS_TOK_PLUS)        { _ejs("+"); return 0; }
    if (op == TS_TOK_MINUS)       { _ejs("-"); return 0; }
    if (op == TS_TOK_STAR)        { _ejs("*"); return 0; }
    if (op == TS_TOK_SLASH)       { _ejs("/"); return 0; }
    if (op == TS_TOK_PERCENT)     { _ejs("%"); return 0; }
    if (op == TS_TOK_STAR_STAR)   { _ejs("**"); return 0; }
    if (op == TS_TOK_BANG)        { _ejs("!"); return 0; }
    if (op == TS_TOK_TILDE)       { _ejs("~"); return 0; }
    if (op == TS_TOK_AMP)         { _ejs("&"); return 0; }
    if (op == TS_TOK_PIPE)        { _ejs("|"); return 0; }
    if (op == TS_TOK_CARET)       { _ejs("^"); return 0; }
    if (op == TS_TOK_EQ)          { _ejs("="); return 0; }
    if (op == TS_TOK_EQ_EQ)       { _ejs("=="); return 0; }
    if (op == TS_TOK_EQ_EQ_EQ)    { _ejs("==="); return 0; }
    if (op == TS_TOK_BANG_EQ)     { _ejs("!="); return 0; }
    if (op == TS_TOK_BANG_EQ_EQ)  { _ejs("!=="); return 0; }
    if (op == TS_TOK_LT)          { _ejs("<"); return 0; }
    if (op == TS_TOK_GT)          { _ejs(">"); return 0; }
    if (op == TS_TOK_LT_EQ)       { _ejs("<="); return 0; }
    if (op == TS_TOK_GT_EQ)       { _ejs(">="); return 0; }
    if (op == TS_TOK_LT_LT)       { _ejs("<<"); return 0; }
    if (op == TS_TOK_GT_GT)       { _ejs(">>"); return 0; }
    if (op == TS_TOK_GT_GT_GT)    { _ejs(">>>"); return 0; }
    if (op == TS_TOK_AMP_AMP)     { _ejs("&&"); return 0; }
    if (op == TS_TOK_PIPE_PIPE)   { _ejs("||"); return 0; }
    if (op == TS_TOK_QQ)          { _ejs("??"); return 0; }
    if (op == TS_TOK_PLUS_PLUS)   { _ejs("++"); return 0; }
    if (op == TS_TOK_MINUS_MINUS) { _ejs("--"); return 0; }
    if (op == TS_TOK_PLUS_EQ)     { _ejs("+="); return 0; }
    if (op == TS_TOK_MINUS_EQ)    { _ejs("-="); return 0; }
    if (op == TS_TOK_STAR_EQ)     { _ejs("*="); return 0; }
    if (op == TS_TOK_SLASH_EQ)    { _ejs("/="); return 0; }
    if (op == TS_TOK_PERCENT_EQ)  { _ejs("%="); return 0; }
    if (op == TS_TOK_STAR_STAR_EQ){ _ejs("**="); return 0; }
    if (op == TS_TOK_AMP_EQ)      { _ejs("&="); return 0; }
    if (op == TS_TOK_PIPE_EQ)     { _ejs("|="); return 0; }
    if (op == TS_TOK_CARET_EQ)    { _ejs("^="); return 0; }
    if (op == TS_TOK_LT_LT_EQ)    { _ejs("<<="); return 0; }
    if (op == TS_TOK_GT_GT_EQ)    { _ejs(">>="); return 0; }
    if (op == TS_TOK_GT_GT_GT_EQ) { _ejs(">>>="); return 0; }
    if (op == TS_TOK_AMP_AMP_EQ)  { _ejs("&&="); return 0; }
    if (op == TS_TOK_PIPE_PIPE_EQ){ _ejs("||="); return 0; }
    if (op == TS_TOK_QQ_EQ)       { _ejs("??="); return 0; }
    if (op == TS_TOK_KW_TYPEOF)   { _ejs("typeof "); return 0; }
    if (op == TS_TOK_KW_VOID)     { _ejs("void "); return 0; }
    if (op == TS_TOK_KW_DELETE)   { _ejs("delete "); return 0; }
    if (op == TS_TOK_KW_AWAIT)    { _ejs("await "); return 0; }
    if (op == TS_TOK_KW_YIELD)    { _ejs("yield "); return 0; }
    if (op == TS_TOK_KW_IN)       { _ejs(" in "); return 0; }
    if (op == TS_TOK_KW_INSTANCEOF) { _ejs(" instanceof "); return 0; }
    return 0;
}

# Emit "var" / "let" / "const" from the kind token.
fn _ej_varkind(tok): i64 {
    if (tok == TS_TOK_KW_LET)   { _ejs("let"); return 0; }
    if (tok == TS_TOK_KW_CONST) { _ejs("const"); return 0; }
    _ejs("var");
    return 0;
}

# Emit the configured JSX pragma.
fn _ej_pragma(): i64 {
    var i = 0;
    while (i < _jsx_pragma_len) { _ej(load8(&_jsx_pragma + i)); i = i + 1; }
    return 0;
}

# True if payload `p` is a child-node reference (small) rather than a packed
# span/token/flag. Param/binding name spans always have start>0 (a name never
# sits at source offset 0), so a packed span is >= 1<<24; a node index is not.
fn _is_node_ref(p): i64 {
    if (p > 0 && p < 16777216) { return 1; }
    return 0;
}

# (forward calls to _TS_JS below are resolved by cyrius's fixup table)

# Emit a sentinel-terminated children list, each via _TS_JS, joined by `sep`.
fn _ej_list(ts_base, src, off, sep): i64 {
    if (off <= 0) { return 0; }
    var nc = TS_AST_NODE_COUNT(ts_base);
    var at = off;
    var first = 1;
    var guard = 0;
    var c = TS_AST_CHILDREN_GET(ts_base, at);
    while (c != 0 - 1) {
        if (c < 0 || c >= nc) { _js_walk_err = 1; return 0; }
        if (guard >= 131072) { _js_walk_err = 1; return 0; }
        if (first == 0) { _ejs(sep); }
        first = 0;
        _TS_JS(ts_base, src, c);
        at = at + 1;
        guard = guard + 1;
        c = TS_AST_CHILDREN_GET(ts_base, at);
    }
    return 0;
}

# v6.1.12: like _ej_list but emits a structural newline+indent (_ej_nl) BEFORE
# each item, so every body statement lands on its own line at the current indent.
# Leading (not separating) so an empty body yields a clean `{\n}` from the caller
# (no dangling indented blank line). Used for block/class/switch bodies.
fn _ej_list_nl(ts_base, src, off): i64 {
    if (off <= 0) { return 0; }
    var nc = TS_AST_NODE_COUNT(ts_base);
    var at = off;
    var guard = 0;
    var c = TS_AST_CHILDREN_GET(ts_base, at);
    while (c != 0 - 1) {
        if (c < 0 || c >= nc) { _js_walk_err = 1; return 0; }
        if (guard >= 131072) { _js_walk_err = 1; return 0; }
        _ej_nl();
        _TS_JS(ts_base, src, c);
        at = at + 1;
        guard = guard + 1;
        c = TS_AST_CHILDREN_GET(ts_base, at);
    }
    return 0;
}

# Emit a parameter list `(a, b, c)` from a params children-offset.
fn _ej_params(ts_base, src, off): i64 {
    _ej(40);                       # (
    _ej_list(ts_base, src, off, ", ");
    _ej(41);                       # )
    return 0;
}

# Emit an object-literal property KEY (JSX attr name or object key) — bare if
# it's a valid JS identifier, else quoted. Used for JSX attr -> object keys.
fn _ej_attrkey(src, span): i64 {
    if (_is_ident_span(src, span) == 1) {
        _ej_span(src, span);
    } else {
        _ej(34); _ej_span(src, span); _ej(34);
    }
    return 0;
}

# Emit a JSX text child as a JS string (trimmed; returns 1 if non-empty).
# Whitespace-only text between elements is dropped (returns 0).
fn _ej_jsx_text(src, span): i64 {
    var st = _span_start(span);
    var ln = _span_len(span);
    var a = 0;
    while (a < ln) {
        var c = load8(src + st + a);
        if (c == 32 || c == 9 || c == 10 || c == 13) { a = a + 1; } else { break; }
    }
    var b = ln;
    while (b > a) {
        var c2 = load8(src + st + b - 1);
        if (c2 == 32 || c2 == 9 || c2 == 10 || c2 == 13) { b = b - 1; } else { break; }
    }
    if (b <= a) { return 0; }
    _ej(34);                       # "
    var i = a;
    while (i < b) {
        var c3 = load8(src + st + i);
        if (c3 == 34 || c3 == 92) { _ej(92); _ej(c3); }   # escape " and \
        elif (c3 == 10 || c3 == 9 || c3 == 13) { _ej(32); }
        else { _ej(c3); }
        i = i + 1;
    }
    _ej(34);
    return 1;
}

# Lower a JSX element/fragment to `pragma(tag, props, ...children)`.
fn _ej_jsx(ts_base, src, idx): i64 {
    var k = TS_AST_KIND(ts_base, idx);
    _ej_pragma();
    _ej(40);                       # (
    if (k == TS_AST_JSX_FRAGMENT) {
        # Fragment -> pragma(null, null, ...children)
        _ejs("null, null");
        var fbody = TS_AST_PAYLOAD(ts_base, idx, 0);
        _ej_jsx_children(ts_base, src, fbody);
        _ej(41);
        return 0;
    }
    # Tag: uppercase name -> component identifier; else quoted HTML tag.
    var name_span = TS_AST_PAYLOAD(ts_base, idx, 0);
    if (_is_upper_span(src, name_span) == 1) {
        _ej_span(src, name_span);
    } else {
        _ej(34); _ej_span(src, name_span); _ej(34);
    }
    _ejs(", ");
    # Props from attrs.
    var attrs = TS_AST_PAYLOAD(ts_base, idx, 1);
    _ej_jsx_props(ts_base, src, attrs);
    # Children (only when not self-closing; payload[3] == 1 = self-close).
    var selfclose = TS_AST_PAYLOAD(ts_base, idx, 3);
    if (selfclose != 1) {
        var body = TS_AST_PAYLOAD(ts_base, idx, 2);
        _ej_jsx_children(ts_base, src, body);
    }
    _ej(41);                       # )
    return 0;
}

# Emit the props object for a JSX element from its attrs children-offset.
fn _ej_jsx_props(ts_base, src, off): i64 {
    if (off <= 0) { _ejs("null"); return 0; }
    var nc = TS_AST_NODE_COUNT(ts_base);
    var at = off;
    var any = 0;
    var c = TS_AST_CHILDREN_GET(ts_base, at);
    # First pass: any attrs at all?
    if (c == 0 - 1) { _ejs("null"); return 0; }
    _ejs("{ ");
    var first = 1;
    var guard = 0;
    while (c != 0 - 1) {
        if (c < 0 || c >= nc) { _js_walk_err = 1; return 0; }
        if (guard >= 131072) { _js_walk_err = 1; return 0; }
        if (first == 0) { _ejs(", "); }
        first = 0;
        var ak = TS_AST_KIND(ts_base, c);
        if (ak == TS_AST_JSX_SPREAD_ATTR) {
            _ejs("...");
            var sx = TS_AST_PAYLOAD(ts_base, c, 0);
            if (sx > 0) { _TS_JS(ts_base, src, sx); }
        } else {
            var aname = TS_AST_PAYLOAD(ts_base, c, 0);
            var vkind = TS_AST_PAYLOAD(ts_base, c, 1);
            var vval = TS_AST_PAYLOAD(ts_base, c, 2);
            _ej_attrkey(src, aname);
            _ejs(": ");
            if (vkind == 1) { _ej_strlit(src, vval); }
            elif (vkind == 2) { if (vval > 0) { _TS_JS(ts_base, src, vval); } else { _ejs("true"); } }
            else { _ejs("true"); }
        }
        at = at + 1;
        guard = guard + 1;
        c = TS_AST_CHILDREN_GET(ts_base, at);
    }
    _ejs(" }");
    return 0;
}

# Emit JSX children as trailing pragma args (each prefixed with ", ").
fn _ej_jsx_children(ts_base, src, off): i64 {
    if (off <= 0) { return 0; }
    var nc = TS_AST_NODE_COUNT(ts_base);
    var at = off;
    var guard = 0;
    var c = TS_AST_CHILDREN_GET(ts_base, at);
    while (c != 0 - 1) {
        if (c < 0 || c >= nc) { _js_walk_err = 1; return 0; }
        if (guard >= 131072) { _js_walk_err = 1; return 0; }
        var ck = TS_AST_KIND(ts_base, c);
        if (ck == TS_AST_JSX_TEXT) {
            var tspan = TS_AST_SPAN(ts_base, c);
            # peek: only emit separator if the text is non-empty
            var save = _js_len;
            _ejs(", ");
            var emitted = _ej_jsx_text(src, tspan);
            if (emitted == 0) { _js_len = save; }
        } elif (ck == TS_AST_JSX_EXPR_CONTAINER) {
            var ex = TS_AST_PAYLOAD(ts_base, c, 0);
            if (ex > 0) { _ejs(", "); _TS_JS(ts_base, src, ex); }
        } else {
            _ejs(", ");
            _ej_jsx(ts_base, src, c);
        }
        at = at + 1;
        guard = guard + 1;
        c = TS_AST_CHILDREN_GET(ts_base, at);
    }
    return 0;
}

# Emit a template literal verbatim: `quasi${expr}quasi...`.
fn _ej_template(ts_base, src, idx): i64 {
    _ej(96);                       # `
    var qoff = TS_AST_PAYLOAD(ts_base, idx, 0);
    var eoff = TS_AST_PAYLOAD(ts_base, idx, 1);
    var nc = TS_AST_NODE_COUNT(ts_base);
    var qi = qoff;
    var ei = eoff;
    var first = 1;
    var guard = 0;
    var q = TS_AST_CHILDREN_GET(ts_base, qi);
    while (q != 0 - 1) {
        if (q < 0 || q >= nc || guard >= 131072) { _js_walk_err = 1; return 0; }
        # quasi text
        _ej_span(src, TS_AST_SPAN(ts_base, q));
        # interleave the matching expr (one fewer expr than quasis)
        if (eoff > 0) {
            var e = TS_AST_CHILDREN_GET(ts_base, ei);
            if (e != 0 - 1 && e >= 0 && e < nc) {
                _ejs("${");
                _TS_JS(ts_base, src, e);
                _ej(125);          # }
                ei = ei + 1;
            }
        }
        qi = qi + 1;
        guard = guard + 1;
        q = TS_AST_CHILDREN_GET(ts_base, qi);
    }
    _ej(96);                       # `
    return 0;
}

# Emit one named-export / import specifier list, pruning type-only names.
# Returns the count actually emitted.
fn _ej_export_specs(ts_base, src, off): i64 {
    if (off <= 0) { return 0; }
    var nc = TS_AST_NODE_COUNT(ts_base);
    var at = off;
    var n = 0;
    var guard = 0;
    var c = TS_AST_CHILDREN_GET(ts_base, at);
    while (c != 0 - 1) {
        if (c < 0 || c >= nc || guard >= 131072) { _js_walk_err = 1; return 0; }
        var iname = TS_AST_PAYLOAD(ts_base, c, 0);
        var alias = TS_AST_PAYLOAD(ts_base, c, 1);
        if (_is_type_name(src, iname) == 0) {
            if (n > 0) { _ejs(", "); }
            _ej_span(src, iname);
            if (alias > 0) { _ejs(" as "); _ej_span(src, alias); }
            n = n + 1;
        }
        at = at + 1;
        guard = guard + 1;
        c = TS_AST_CHILDREN_GET(ts_base, at);
    }
    return n;
}

# ================================================================
# Main per-node JS emitter
# ================================================================
fn _TS_JS(ts_base, src, idx): i64 {
    if (idx < 0) { return 0; }
    # Revisit detection (tree invariant; reuses the idle parse stack).
    if (idx < 8192) {
        if (load64(&_ts_cst + idx * 8) != 0) { _js_walk_err = 1; return 0; }
        store64(&_ts_cst + idx * 8, 1);
    }
    var k = TS_AST_KIND(ts_base, idx);
    var span = TS_AST_SPAN(ts_base, idx);
    var p0 = TS_AST_PAYLOAD(ts_base, idx, 0);
    var p1 = TS_AST_PAYLOAD(ts_base, idx, 1);
    var p2 = TS_AST_PAYLOAD(ts_base, idx, 2);
    var p3 = TS_AST_PAYLOAD(ts_base, idx, 3);

    # ---- type-only declarations: emit nothing ----
    if (k == TS_AST_DECL_INTERFACE || k == TS_AST_DECL_TYPE_ALIAS) { return 0; }

    # ---- literals ----
    if (k == TS_AST_EXPR_INT || k == TS_AST_EXPR_FLOAT || k == TS_AST_EXPR_REGEX) { _ej_span(src, span); return 0; }
    if (k == TS_AST_EXPR_STRING) { _ej_strlit(src, span); return 0; }
    if (k == TS_AST_EXPR_TEMPLATE) { _ej_template(ts_base, src, idx); return 0; }
