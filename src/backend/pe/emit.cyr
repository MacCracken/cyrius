fn _pe_tlsset_get(): i64 { return _pe_tlsset_idx; }

# Called from `parse.cyr`'s `#pe_import("dll", "symbol")` handler
# with `name` pointing at the NUL-terminated symbol string inside
# str_data. Appends the name to the pending buffer; `_pe_layout`
# iterates the buffer and forwards each entry to `_pe_imp_add`
# after placing `ExitProcess` at imp_idx=0.
fn _pe_pending_imp_add(S, name): i64 {
    S64(&_pe_pending_imp_offs + _pe_pending_imp_count * 8,
    _pe_pending_imp_pos);
    var i = 0;
    var c = load8(name);
    while (c != 0) {
        store8(&_pe_pending_imp_buf + _pe_pending_imp_pos + i, c);
        i = i + 1;
        c = load8(name + i);
    }
    store8(&_pe_pending_imp_buf + _pe_pending_imp_pos + i, 0);
    _pe_pending_imp_pos = _pe_pending_imp_pos + i + 1;
    _pe_pending_imp_count = _pe_pending_imp_count + 1;
    return 0;
}

# Register a PE IAT reference fixup. `coff` is the code offset
# where the 4-byte disp32 placeholder lives (inside a
# `FF 15 <disp32>` call). `imp_idx` is the import index into the
# imports registry (0 = ExitProcess for v5.4.3). At FIXUP time,
# ftype=4 entries are patched with
#   disp32 = IAT_RVA - (text_rva + coff + 4)
# where IAT_RVA = _pe_idata_rva + _pe_iat_sub_off + imp_idx * 8.
fn _pe_iat_fixup_add(S, coff, imp_idx): i64 {
    var fc = GFCNT(S);
    if (fc >= 262144) {
        syscall(SYS_WRITE, 2,
        "error: fixup table full (262144)\n", 33);
        syscall(SYS_EXIT, 1);
    }
    var faddr = S + 0x107B000 + fc * 16;
    SFCNT(S, fc + 1);
    S64(faddr, coff);
    S64(faddr + 8, (4 << 56) | imp_idx);
    return 0;
}

# ================================================================
# Pass 1: layout
# ================================================================
# Computes RVAs, file offsets, and sizes for every region. Pure
# computation — writes only to pe/emit.cyr's own globals, nothing
# to the output buffer. Must be called before EMITPE_EXEC.

fn _pe_layout(S): i64 {
    # Reset import registry so _pe_layout is idempotent (callers can
    # re-enter it after a failed compile without stale state).
    _pe_imp_count = 0;
    _pe_imp_buf_pos = 0;

    # v5.4.2 hardcodes kernel32!ExitProcess at imp_idx=0 (EEXIT's
    # IAT-reference fixup is hardcoded against that slot). v5.11.47:
    # UEFI Application mode skips this entirely — UEFI has no
    # kernel32 and EEXIT emits a bare `ret`, not an IAT call.
    # ExitProcess at imp_idx 0 is kernel32 (dll id 0).
    if (_TARGET_EFI_APPLICATION == 0) { _pe_imp_add("ExitProcess"); store8(&_pe_imp_dll, 0); }

    # Consume `#pe_import` declarations collected at parse time.
    # ExitProcess stays at imp_idx=0 (EEXIT hardcodes that slot);
    # user imports start at imp_idx=1. Duplicates of ExitProcess
    # are allowed and harmless (extra IAT slot with same target).
    # Tag each import with its DLL id (parallel to the name) BEFORE
    # _pe_imp_add increments _pe_imp_count, so _pe_imp_dll is keyed by
    # the same imp_idx the ftype=4 fixups already captured.
    var pi = 0;
    var pi_off = 0;
    var pi_ptr = 0;
    while (pi < _pe_pending_imp_count) {
        pi_off = L64(&_pe_pending_imp_offs + pi * 8);
        pi_ptr = &_pe_pending_imp_buf + pi_off;
        store8(&_pe_imp_dll + _pe_imp_count, load8(&_pe_pending_imp_dll + pi));
        _pe_imp_add(pi_ptr);
        pi = pi + 1;
    }

    var cp = GCP(S);

    # Header block: DOS(64) + PEsig(4) + COFF(20) + OptHdr(240) +
    # 3× SectionHeader(40) = 448. Round up to FileAlignment (0x200).
    # Third section (.rdata) added v5.4.8 for gvar + string data.
    var hdr_raw = 448;
    _pe_hdr_aligned_size = (hdr_raw + 0x1FF) & (0 - 0x200);

    # .text — first section, starts at SectionAlignment past ImageBase.
    _pe_text_rva = 0x1000;
    _pe_text_file_off = _pe_hdr_aligned_size;
    _pe_text_vsize = cp;
    _pe_text_file_size = (cp + 0x1FF) & (0 - 0x200);

    # .idata — follows .text, SectionAlignment-padded in memory.
    _pe_idata_rva = (_pe_text_rva + _pe_text_vsize + 0xFFF) & (0 - 0x1000);
    _pe_idata_file_off = _pe_text_file_off + _pe_text_file_size;

    # .idata sub-regions. In PE32+ each IAT/ILT thunk is 8 bytes;
    # each import table ends with a zero thunk.
    var imp_count = _pe_imp_count;
    _pe_iat_sub_off = 0;

    # Group imports by DLL into per-descriptor IAT/ILT runs (each run
    # null-terminated, PE32+ 8-byte thunks). Walk DLL ids ascending
    # (kernel32=0 first → ExitProcess stays at physical slot 0).
    # _pe_iat_pos[imp_idx] = physical slot (for the ftype=4 fixup);
    # _pe_dll_first / _pe_dll_id_used / _pe_dll_name_off describe each
    # emitted descriptor. One DLL reproduces the legacy layout exactly.
    var phys = 0;
    var dname_off = 0;
    var dll = 0;
    var dll_has = 0;
    var first_phys = 0;
    var k = 0;
    var dn = 0;
    var dnl = 0;
    _pe_dll_count = 0;
    while (dll < 3) {
        dll_has = 0;
        first_phys = phys;
        k = 0;
        while (k < imp_count) {
            if (load8(&_pe_imp_dll + k) == dll) {
                if (dll_has == 0) { first_phys = phys; dll_has = 1; }
                S64(&_pe_iat_pos + k * 8, phys);
                phys = phys + 1;
            }
            k = k + 1;
        }
        if (dll_has == 1) {
            phys = phys + 1;   # per-DLL null thunk terminator
            S64(&_pe_dll_first + _pe_dll_count * 8, first_phys);
            S64(&_pe_dll_id_used + _pe_dll_count * 8, dll);
            S64(&_pe_dll_name_off + _pe_dll_count * 8, dname_off);
            dn = _pe_dll_name(dll);
            dnl = 0;
            while (load8(dn + dnl) != 0) { dnl = dnl + 1; }
            dname_off = dname_off + ((dnl + 1 + 1) & (0 - 2));
            _pe_dll_count = _pe_dll_count + 1;
        }
        dll = dll + 1;
    }
    _pe_iat_size = phys * 8;
    _pe_imp_dir_sub_off = _pe_iat_sub_off + _pe_iat_size;
    _pe_imp_dir_size = (_pe_dll_count + 1) * 20;
    _pe_ilt_sub_off = _pe_imp_dir_sub_off + _pe_imp_dir_size;
    _pe_ilt_size = phys * 8;
    _pe_hint_name_sub_off = _pe_ilt_sub_off + _pe_ilt_size;

    # Hint/Name table: each entry = 2-byte hint + name + NUL,
    # word-aligned per entry. Kept in imp_idx order (bytes unchanged
    # from the legacy path); _pe_imp_hn_off[imp_idx] lets the grouped
    # IAT/ILT emit find each import's entry by imp_idx.
    var hn_total = 0;
    var i = 0;
    var name_off = 0;
    var np = 0;
    var nlen = 0;
    var entry = 0;
    while (i < imp_count) {
        S64(&_pe_imp_hn_off + i * 8, hn_total);
        name_off = L64(&_pe_imp_name_offs + i * 8);
        np = &_pe_imp_name_buf + name_off;
        nlen = 0;
        while (load8(np + nlen) != 0) { nlen = nlen + 1; }
        entry = 2 + nlen + 1;
        entry = (entry + 1) & (0 - 2);
        hn_total = hn_total + entry;
        i = i + 1;
    }
    _pe_hint_name_size = hn_total;

    # DLL names — one word-aligned NUL-terminated string per descriptor,
    # concatenated; _pe_dll_name_off[d] is each descriptor's offset.
    _pe_dll_name_sub_off = _pe_hint_name_sub_off + _pe_hint_name_size;
    _pe_dll_name_size = dname_off;

    _pe_idata_vsize = _pe_dll_name_sub_off + _pe_dll_name_size;
    _pe_idata_file_size = (_pe_idata_vsize + 0x1FF) & (0 - 0x200);

    # .rdata — gvar storage (zero-filled) followed by string literals.
    # totvar/spos are computed here from the same state FIXUP later
    # walks; snapshotting them onto globals keeps EMITPE_EXEC and
    # fixup.cyr's ftype=0/1 branches pulling from one source of truth.
    var vcnt = GVCNT(S);
    var totvar = 0;
    var rvi = 0;
    while (rvi < vcnt) {
        totvar = totvar + L64(S + 0x12A000 + rvi * 8);
        rvi = rvi + 1;
    }
    var spos = GSPOS(S);
    _pe_rdata_totvar = totvar;
    _pe_rdata_spos   = spos;
    _pe_rdata_gvar_off = 0;
    _pe_rdata_str_off  = totvar;

    _pe_rdata_rva = (_pe_idata_rva + _pe_idata_vsize + 0xFFF) & (0 - 0x1000);
    _pe_rdata_file_off = _pe_idata_file_off + _pe_idata_file_size;
    _pe_rdata_vsize = totvar + spos;
    _pe_rdata_file_size = (_pe_rdata_vsize + 0x1FF) & (0 - 0x200);

    _pe_image_file_size = _pe_rdata_file_off + _pe_rdata_file_size;
    # SizeOfImage is virtual: last section's virtual end, rounded to
    # SectionAlignment. Use vsize even if zero — PE requires the
    # section descriptor to be consistent with file-layout order.
    var rdata_end_rva = _pe_rdata_rva + _pe_rdata_vsize;
    if (_pe_rdata_vsize == 0) { rdata_end_rva = _pe_rdata_rva; }
    _pe_image_size = (rdata_end_rva + 0xFFF) & (0 - 0x1000);

    # ============================================================
    # .reloc — base relocation blocks (v5.5.35)
    # ============================================================
    # Walk fixup table, collect coffs for every absolute 64-bit
    # patch site (ftype 0 = gvar, 1 = string, 3 = fn address).
    # ftype 2 (fn call) and 4 (IAT ref) are rel32, no reloc needed.
    # Insertion-sort keeps the coff buffer ascending so the emit
    # pass can group by 4 KB page in one linear walk.
    _pe_reloc_count = 0;
    var rl_fcnt = GFCNT(S);
    var rl_fi = 0;
    var rl_raw = 0;
    var rl_ft = 0;
    var rl_coff = 0;
    var rl_k = 0;
    var rl_prev = 0;
    var rl_shift = 0;
    while (rl_fi < rl_fcnt) {
        rl_raw = L64(S + 0x107B000 + rl_fi * 16 + 8);
        rl_ft = rl_raw >> 56;
        if (rl_ft == 0 || rl_ft == 1 || rl_ft == 3) {
            rl_coff = L64(S + 0x107B000 + rl_fi * 16);
            # Find insertion index (first slot where stored > rl_coff)
            rl_k = _pe_reloc_count;
            var rl_j = 0;
            while (rl_j < _pe_reloc_count) {
                rl_prev = L64(S + 0x1DC000 + rl_j * 8);
                if (rl_prev > rl_coff) {
                    rl_k = rl_j;
                    rl_j = _pe_reloc_count;  # break
                } else {
                    rl_j = rl_j + 1;
                }
            }
            # Shift tail right from rl_k..count by one
            rl_shift = _pe_reloc_count;
            while (rl_shift > rl_k) {
                S64(S + 0x1DC000 + rl_shift * 8,
                L64(S + 0x1DC000 + (rl_shift - 1) * 8));
                rl_shift = rl_shift - 1;
            }
            S64(S + 0x1DC000 + rl_k * 8, rl_coff);
            _pe_reloc_count = _pe_reloc_count + 1;
            if (_pe_reloc_count >= 8192) {
                syscall(SYS_WRITE, 2,
                "error: PE reloc table full (8192)\n", 34);
                syscall(SYS_EXIT, 1);
            }
        }
        rl_fi = rl_fi + 1;
    }

    # Compute .reloc virtual size — group sorted coffs by 4 KB
    # page (relative to image base; equivalent to page of
    # _pe_text_rva + coff). Each block: 8-byte header + 2-byte
    # entry per coff, block size rounded up to 4 bytes.
    _pe_reloc_vsize = 0;
    if (_pe_reloc_count > 0) {
        var rl_pi = 0;
        var rl_cur_page = (L64(S + 0x1DC000) + _pe_text_rva) >> 12;
        var rl_cur_cnt = 0;
        var rl_this_rva = 0;
        var rl_this_page = 0;
        var rl_blk_bytes = 0;
        while (rl_pi < _pe_reloc_count) {
            rl_this_rva = L64(S + 0x1DC000 + rl_pi * 8) + _pe_text_rva;
            rl_this_page = rl_this_rva >> 12;
            if (rl_this_page != rl_cur_page) {
                rl_blk_bytes = 8 + rl_cur_cnt * 2;
                rl_blk_bytes = (rl_blk_bytes + 3) & (0 - 4);
                _pe_reloc_vsize = _pe_reloc_vsize + rl_blk_bytes;
                rl_cur_page = rl_this_page;
                rl_cur_cnt = 1;
            } else {
                rl_cur_cnt = rl_cur_cnt + 1;
            }
            rl_pi = rl_pi + 1;
        }
        # Flush final block
        rl_blk_bytes = 8 + rl_cur_cnt * 2;
        rl_blk_bytes = (rl_blk_bytes + 3) & (0 - 4);
        _pe_reloc_vsize = _pe_reloc_vsize + rl_blk_bytes;
    }

    # Position .reloc section after .rdata (or .idata if rdata
    # was dropped), SectionAlignment-padded.
    _pe_reloc_rva = 0;
    _pe_reloc_file_off = 0;
    _pe_reloc_file_size = 0;
    if (_pe_reloc_vsize > 0) {
        var rl_prev_end_rva = _pe_rdata_rva + _pe_rdata_vsize;
        if (_pe_rdata_vsize == 0) {
            rl_prev_end_rva = _pe_idata_rva + _pe_idata_vsize;
        }
        _pe_reloc_rva = (rl_prev_end_rva + 0xFFF) & (0 - 0x1000);
        _pe_reloc_file_off = _pe_rdata_file_off + _pe_rdata_file_size;
        _pe_reloc_file_size = (_pe_reloc_vsize + 0x1FF) & (0 - 0x200);
        _pe_image_file_size = _pe_reloc_file_off + _pe_reloc_file_size;
        _pe_image_size = (_pe_reloc_rva + _pe_reloc_vsize + 0xFFF) & (0 - 0x1000);
    }

    return 0;
}

# ================================================================
# Pass 2: serialize
# ================================================================
# Walks regions in file order, writing bytes into output_buf at
# S + 0x41A000. _pe_layout must have been called first. All
# loop-local vars are hoisted to the function top because cycc
# treats sequential `var x` declarations in the same scope as
# redeclaration (reassignment is the supported pattern).

fn EMITPE_EXEC(S): i64 {
    var O = S + 0x71A000;
    var o = 0;
    var cp = GCP(S);
    var cb = S + 0x41A000;       # codebuf base
    var imp_count = _pe_imp_count;
    var dd_idx = 0;
    var ii = 0;
    var name_off = 0;
    var np = 0;
    var nlen = 0;
    var idata_start = 0;
    var idata_pad_target = 0;
    var ti = 0;

    # ============================================================
    # DOS header (64 bytes). "MZ" magic + e_lfanew at 0x3C pointing
    # at the PE signature directly after the header. No DOS stub —
    # loaders tolerate a bare header.
    # ============================================================
    o = _pe_w16(O, o, 0x5A4D);          # "MZ"
    while (o < 60) { store8(O + o, 0); o = o + 1; }
    o = _pe_w32(O, o, 64);              # e_lfanew

    # ============================================================
    # PE signature (4 bytes)
    # ============================================================
    o = _pe_w32(O, o, 0x00004550);      # "PE\0\0"

    # ============================================================
    # COFF file header (20 bytes)
    # ============================================================
    o = _pe_w16(O, o, 0x8664);          # Machine = AMD64
    # NumberOfSections — drop `.rdata` when there are no gvars and no
    # string literals (e.g. exit-only programs). A section header with
    # `VirtualSize == 0 && SizeOfRawData == 0` makes the Windows loader
    # reject the image as "%1 is not a valid Win32 application" — the
    # CI gate caught this on `exit0/exit1/exit42/exit255` after v5.4.8
    # added the unconditional 3rd section. The header bytes that would
    # have described `.rdata` still get emitted (as zeros) into the
    # 448-byte header allotment, harmless because NumberOfSections=2
    # tells the loader to ignore that slot.
    var _nsec = 3;
    if (_pe_rdata_vsize == 0) { _nsec = 2; }
    if (_pe_reloc_vsize != 0) { _nsec = _nsec + 1; }   # v5.5.35: .reloc
    o = _pe_w16(O, o, _nsec);
    o = _pe_w32(O, o, 0);               # TimeDateStamp (0 = unbound)
    o = _pe_w32(O, o, 0);               # PointerToSymbolTable
    o = _pe_w32(O, o, 0);               # NumberOfSymbols
    o = _pe_w16(O, o, 240);             # SizeOfOptionalHeader
    # Characteristics: EXECUTABLE_IMAGE (0x0002) | LARGE_ADDRESS_AWARE
    # (0x0020) | RELOCS_STRIPPED (0x0001) by default. Clear
    # RELOCS_STRIPPED when we're shipping a real .reloc section so
    # the loader knows it MUST apply relocations (and is willing to
    # place the image at a non-default ImageBase — prerequisite for
    # ASLR). v5.5.35.
    var _chars = 0x0023;
    if (_pe_reloc_vsize != 0) { _chars = 0x0022; }
    # v5.11.49: UEFI Application mode MUST NOT claim RELOCS_STRIPPED
    # even with zero actual fixups. UEFI firmware (OVMF BdsDxe confirmed
    # 2026-05-13) treats RELOCS_STRIPPED as "you MUST load me at exactly
    # ImageBase or fail." If ImageBase 0x140000000 isn't free in firmware
    # memory map, BdsDxe reports "Not Found" and skips the image. Clearing
    # the bit lets firmware place the image anywhere; absolute imm64
    # references in user code would need .reloc to survive that, but the
    # MVP probe (programs/efi_probe.cyr) is all runtime register-indirect
    # so it works at any address.
    if (_TARGET_EFI_APPLICATION == 1) { _chars = 0x0022; }
    o = _pe_w16(O, o, _chars);

    # ============================================================
    # Optional header PE32+ (240 bytes = 24 standard + 88 Win + 128 data-dirs)
    # ============================================================
    # Standard fields (24 bytes)
    o = _pe_w16(O, o, 0x020B);          # Magic = PE32+
    o = _pe_w8(O, o, 0);                # MajorLinkerVersion
    o = _pe_w8(O, o, 0);                # MinorLinkerVersion
    o = _pe_w32(O, o, _pe_text_file_size);   # SizeOfCode
    # SizeOfInitializedData covers .idata + .rdata (both CNT_INITIALIZED_DATA).
    o = _pe_w32(O, o, _pe_idata_file_size + _pe_rdata_file_size);
    o = _pe_w32(O, o, 0);                    # SizeOfUninitializedData
    o = _pe_w32(O, o, _pe_text_rva);         # AddressOfEntryPoint
    o = _pe_w32(O, o, _pe_text_rva);         # BaseOfCode

    # Windows-specific fields (88 bytes for PE32+)
    o = _pe_w64(O, o, 0x140000000);     # ImageBase
    o = _pe_w32(O, o, 0x1000);          # SectionAlignment
    o = _pe_w32(O, o, 0x200);           # FileAlignment
    o = _pe_w16(O, o, 6);               # MajorOSVersion
    o = _pe_w16(O, o, 0);               # MinorOSVersion
    o = _pe_w16(O, o, 0);               # MajorImageVersion
    o = _pe_w16(O, o, 0);               # MinorImageVersion
    o = _pe_w16(O, o, 6);               # MajorSubsystemVersion
    o = _pe_w16(O, o, 0);               # MinorSubsystemVersion
    o = _pe_w32(O, o, 0);               # Win32VersionValue (reserved)
    o = _pe_w32(O, o, _pe_image_size);        # SizeOfImage (virtual)
    o = _pe_w32(O, o, _pe_hdr_aligned_size);  # SizeOfHeaders
    o = _pe_w32(O, o, 0);               # CheckSum (0 OK for user-mode)
    # Subsystem: 3 = WINDOWS_CUI (default); 10 = EFI_APPLICATION
    # (v5.11.47, CYRIUS_TARGET_EFI=1). Per MS PE/COFF spec § 5.2.
    var _subsys = 3;
    if (_TARGET_EFI_APPLICATION == 1) { _subsys = 10; }
    o = _pe_w16(O, o, _subsys);         # Subsystem
    # DllCharacteristics — 0 when RELOCS_STRIPPED. With .reloc shipped
    # (v5.5.35), set DYNAMIC_BASE (0x0040) + NX_COMPAT (0x0100)
    # = 0x0140. HIGH_ENTROPY_VA (0x0020) is DELIBERATELY OMITTED.
    # Empirically cycc_win.exe deterministically fails stdin read on
    # Win11 with HIGH_ENTROPY_VA set (5/5 runs). All 2043 MOVABS sites
    # in .text were audited — the 264 uncovered imm64 values are all
    # legitimate data constants (bitmasks, 0x140000000 used as literal
    # numeric data, opcode-bytes packed as u64), not pointers missing
    # a DIR64 entry. Root cause of the failure under 64-bit ASLR is
    # not yet isolated; 32-bit ASLR via DYNAMIC_BASE delivers the
    # primary security win. HIGH_ENTROPY_VA pinned as a v5.5.35
    # follow-up investigation.
    var _dllc = 0;
    if (_pe_reloc_vsize != 0) { _dllc = 0x0140; }  # v6.0.39: drop accidental HIGH_ENTROPY_VA
    # v5.11.48: UEFI Application mode ALWAYS sets NX_COMPAT (0x0100),
    # even when no fixups → no .reloc. UEFI 2.0+ honors NX on code pages
    # for memory protection (Memory Attributes Protocol); firmware
    # implementations may refuse to invoke an image without this bit.
    # DYNAMIC_BASE only flips when .reloc is present (image relocatable);
    # otherwise firmware honors ImageBase = 0x140000000 directly.
    if (_TARGET_EFI_APPLICATION == 1 && _pe_reloc_vsize == 0) { _dllc = 0x0100; }
    o = _pe_w16(O, o, _dllc);
    o = _pe_w64(O, o, 0x100000);        # SizeOfStackReserve (1 MB)
    o = _pe_w64(O, o, 0x1000);          # SizeOfStackCommit  (4 KB)
    o = _pe_w64(O, o, 0x100000);        # SizeOfHeapReserve  (1 MB)
    o = _pe_w64(O, o, 0x1000);          # SizeOfHeapCommit   (4 KB)
    o = _pe_w32(O, o, 0);               # LoaderFlags
    o = _pe_w32(O, o, 16);              # NumberOfRvaAndSizes

    # Data directories (16 × 8 bytes). Only [1] Import and [12] IAT
    # are populated; everything else is zero for v5.4.2.
    # [0] Export
    o = _pe_w32(O, o, 0);
    o = _pe_w32(O, o, 0);
    # [1] Import. v5.11.47: UEFI Application mode zeros this so the
    # UEFI PE loader skips import resolution entirely (UEFI has no
    # kernel32). The .idata section bytes still emit as a benign
    # region — they're never referenced when Data Directory [1].size
    # == 0. A future slot could drop the section outright; for the
    # MVP, zeroed data-dirs are enough to make firmware happy.
    if (_TARGET_EFI_APPLICATION == 1) {
        o = _pe_w32(O, o, 0);
        o = _pe_w32(O, o, 0);
    } else {
        o = _pe_w32(O, o, _pe_idata_rva + _pe_imp_dir_sub_off);
        o = _pe_w32(O, o, _pe_imp_dir_size);
    }
    # [2..11] = zero, except [5] BaseRelocationTable when .reloc present (v5.5.35)
    dd_idx = 2;
    while (dd_idx < 12) {
        if (dd_idx == 5) {
            if (_pe_reloc_vsize != 0) {
                o = _pe_w32(O, o, _pe_reloc_rva);
                o = _pe_w32(O, o, _pe_reloc_vsize);
            } else {
                o = _pe_w32(O, o, 0);
                o = _pe_w32(O, o, 0);
            }
        } else {
            o = _pe_w32(O, o, 0);
            o = _pe_w32(O, o, 0);
        }
        dd_idx = dd_idx + 1;
    }
    # [12] IAT. v5.11.47: zero in EFI mode (same rationale as [1]
    # Import above).
    if (_TARGET_EFI_APPLICATION == 1) {
        o = _pe_w32(O, o, 0);
        o = _pe_w32(O, o, 0);
    } else {
        o = _pe_w32(O, o, _pe_idata_rva + _pe_iat_sub_off);
        o = _pe_w32(O, o, _pe_iat_size);
    }
    # [13..15] = zero
    dd_idx = 13;
    while (dd_idx < 16) {
        o = _pe_w32(O, o, 0);
        o = _pe_w32(O, o, 0);
        dd_idx = dd_idx + 1;
    }

    # ============================================================
    # Section headers (40 bytes each)
    # ============================================================
    # .text
    store8(O + o, 0x2E);        # '.'
    store8(O + o + 1, 0x74);    # 't'
    store8(O + o + 2, 0x65);    # 'e'
    store8(O + o + 3, 0x78);    # 'x'
    store8(O + o + 4, 0x74);    # 't'
    store8(O + o + 5, 0);
    store8(O + o + 6, 0);
    store8(O + o + 7, 0);
    o = o + 8;
    o = _pe_w32(O, o, _pe_text_vsize);       # VirtualSize
    o = _pe_w32(O, o, _pe_text_rva);         # VirtualAddress
    o = _pe_w32(O, o, _pe_text_file_size);   # SizeOfRawData
    o = _pe_w32(O, o, _pe_text_file_off);    # PointerToRawData
    o = _pe_w32(O, o, 0);                    # PointerToRelocations
    o = _pe_w32(O, o, 0);                    # PointerToLinenumbers
    o = _pe_w16(O, o, 0);                    # NumberOfRelocations
    o = _pe_w16(O, o, 0);                    # NumberOfLinenumbers
    o = _pe_w32(O, o, 0x60000020);           # CNT_CODE | MEM_EXECUTE | MEM_READ

    # .idata
    store8(O + o, 0x2E);        # '.'
    store8(O + o + 1, 0x69);    # 'i'
    store8(O + o + 2, 0x64);    # 'd'
    store8(O + o + 3, 0x61);    # 'a'
    store8(O + o + 4, 0x74);    # 't'
    store8(O + o + 5, 0x61);    # 'a'
    store8(O + o + 6, 0);
    store8(O + o + 7, 0);
    o = o + 8;
    o = _pe_w32(O, o, _pe_idata_vsize);
    o = _pe_w32(O, o, _pe_idata_rva);
    o = _pe_w32(O, o, _pe_idata_file_size);
    o = _pe_w32(O, o, _pe_idata_file_off);
    o = _pe_w32(O, o, 0);
    o = _pe_w32(O, o, 0);
    o = _pe_w16(O, o, 0);
    o = _pe_w16(O, o, 0);
    o = _pe_w32(O, o, 0xC0000040);           # CNT_INIT_DATA | MEM_READ | MEM_WRITE

    # .rdata — gvar storage + string literals (v5.4.8). Only emit the
    # section header when there's actually content: a 0-vsize/0-rsize
    # section descriptor passes our local sanity checks but the
    # Windows loader rejects it as `%1 is not a valid Win32
    # application`. exit-only programs (`syscall(60, 0);` etc.) have
    # zero gvars and zero string literals — for those we keep
    # NumberOfSections=2 (set above) and skip the descriptor entirely.
    if (_pe_rdata_vsize != 0) {
        store8(O + o,     0x2E);    # '.'
        store8(O + o + 1, 0x72);    # 'r'
        store8(O + o + 2, 0x64);    # 'd'
        store8(O + o + 3, 0x61);    # 'a'
        store8(O + o + 4, 0x74);    # 't'
        store8(O + o + 5, 0x61);    # 'a'
        store8(O + o + 6, 0);
        store8(O + o + 7, 0);
        o = o + 8;
        o = _pe_w32(O, o, _pe_rdata_vsize);
        o = _pe_w32(O, o, _pe_rdata_rva);
        o = _pe_w32(O, o, _pe_rdata_file_size);
        o = _pe_w32(O, o, _pe_rdata_file_off);
        o = _pe_w32(O, o, 0);
        o = _pe_w32(O, o, 0);
        o = _pe_w16(O, o, 0);
        o = _pe_w16(O, o, 0);
        # CNT_INIT_DATA | MEM_READ | MEM_WRITE. For v5.4.8 gvar storage
        # and string literals share one section. Name is `.rdata` for
        # historical symmetry with the sub-region naming in this file,
        # but permissions are RW because Cyrius gvars are writable at
        # runtime (`var x = 0; x = 42;`). Splitting into real `.rdata`
        # (RO strings) + `.data` (RW gvars) is a follow-up cleanup —
        # harmless today because PE loaders honor section flags, not
        # section names.
        o = _pe_w32(O, o, 0xC0000040);
    }

    # .reloc — base relocations (v5.5.35). 4th and last section when
    # DIR64 sites exist (skipped for exit-only / trivial programs
    # with zero abs-64 patches).
    if (_pe_reloc_vsize != 0) {
        store8(O + o,     0x2E);    # '.'
        store8(O + o + 1, 0x72);    # 'r'
        store8(O + o + 2, 0x65);    # 'e'
        store8(O + o + 3, 0x6C);    # 'l'
        store8(O + o + 4, 0x6F);    # 'o'
        store8(O + o + 5, 0x63);    # 'c'
        store8(O + o + 6, 0);
        store8(O + o + 7, 0);
        o = o + 8;
        o = _pe_w32(O, o, _pe_reloc_vsize);
        o = _pe_w32(O, o, _pe_reloc_rva);
        o = _pe_w32(O, o, _pe_reloc_file_size);
        o = _pe_w32(O, o, _pe_reloc_file_off);
        o = _pe_w32(O, o, 0);
        o = _pe_w32(O, o, 0);
        o = _pe_w16(O, o, 0);
        o = _pe_w16(O, o, 0);
        # CNT_INITIALIZED_DATA (0x40) | MEM_DISCARDABLE (0x02000000)
        # | MEM_READ (0x40000000) = 0x42000040. DISCARDABLE lets the
        # loader drop .reloc from working set after relocations are
        # applied (it's never read at runtime).
        o = _pe_w32(O, o, 0x42000040);
    }

    # Pad headers to FileAlignment.
    o = _pe_wpad(O, o, 0x200);

    # ============================================================
    # .text section — copy codebuf verbatim, pad to FileAlignment
    # ============================================================
    ti = 0;
    while (ti < cp) {
        store8(O + o + ti, load8(cb + ti));
        ti = ti + 1;
    }
    o = o + cp;
    o = _pe_wpad(O, o, 0x200);

    # ============================================================
    # .idata section
    # ============================================================
    idata_start = o;

    # IAT — grouped by DLL, each DLL's run null-terminated. Each thunk
    # is the RVA of its IMAGE_IMPORT_BY_NAME (hint/name) entry; high bit
    # clear = import-by-name. Descriptors in layout order; within each,
    # that DLL's imports in imp_idx order (hint/name offset precomputed).
    var dd = 0;
    var ddll = 0;
    while (dd < _pe_dll_count) {
        ddll = L64(&_pe_dll_id_used + dd * 8);
        ii = 0;
        while (ii < imp_count) {
            if (load8(&_pe_imp_dll + ii) == ddll) {
                o = _pe_w64(O, o, _pe_idata_rva + _pe_hint_name_sub_off + L64(&_pe_imp_hn_off + ii * 8));
            }
            ii = ii + 1;
        }
        o = _pe_w64(O, o, 0);   # per-DLL IAT null terminator
        dd = dd + 1;
    }

    # Import Directory — one descriptor per DLL + null terminator. Each
    # descriptor's ILT/IAT thunks point at this DLL's run start.
    dd = 0;
    while (dd < _pe_dll_count) {
        o = _pe_w32(O, o, _pe_idata_rva + _pe_ilt_sub_off + L64(&_pe_dll_first + dd * 8) * 8);    # OriginalFirstThunk
        o = _pe_w32(O, o, 0);                                                                       # TimeDateStamp
        o = _pe_w32(O, o, 0);                                                                       # ForwarderChain
        o = _pe_w32(O, o, _pe_idata_rva + _pe_dll_name_sub_off + L64(&_pe_dll_name_off + dd * 8));  # Name (DLL name RVA)
        o = _pe_w32(O, o, _pe_idata_rva + _pe_iat_sub_off + L64(&_pe_dll_first + dd * 8) * 8);       # FirstThunk
        dd = dd + 1;
    }
    # 20 bytes of zero — terminator descriptor
    o = _pe_w32(O, o, 0);
    o = _pe_w32(O, o, 0);
    o = _pe_w32(O, o, 0);
    o = _pe_w32(O, o, 0);
    o = _pe_w32(O, o, 0);

    # ILT — mirrors the IAT exactly (same grouped thunk RVAs + per-DLL
    # nulls). The loader strictly needs only the IAT, but emitting the
    # ILT avoids loader-version compatibility surprises.
    dd = 0;
    while (dd < _pe_dll_count) {
        ddll = L64(&_pe_dll_id_used + dd * 8);
        ii = 0;
        while (ii < imp_count) {
            if (load8(&_pe_imp_dll + ii) == ddll) {
                o = _pe_w64(O, o, _pe_idata_rva + _pe_hint_name_sub_off + L64(&_pe_imp_hn_off + ii * 8));
            }
            ii = ii + 1;
        }
        o = _pe_w64(O, o, 0);   # per-DLL ILT null terminator
        dd = dd + 1;
    }

    # Hint/Name table — per import: 2-byte hint (0 = name lookup),
    # NUL-terminated name, pad to 2-byte alignment.
    ii = 0;
    while (ii < imp_count) {
        o = _pe_w16(O, o, 0);   # Hint (0 is fine — loader falls back to name)
        name_off = L64(&_pe_imp_name_offs + ii * 8);
        np = &_pe_imp_name_buf + name_off;
        o = _pe_wstr(O, o, np);
        o = _pe_wpad(O, o, 2);
        ii = ii + 1;
    }

    # DLL names — one NUL-terminated, word-aligned string per descriptor,
    # in the same layout order as _pe_dll_name_off recorded.
    dd = 0;
    while (dd < _pe_dll_count) {
        o = _pe_wstr(O, o, _pe_dll_name(L64(&_pe_dll_id_used + dd * 8)));
        o = _pe_wpad(O, o, 2);
        dd = dd + 1;
    }

    # Pad .idata to FileAlignment.
    idata_pad_target = idata_start + _pe_idata_file_size;
    while (o < idata_pad_target) {
        store8(O + o, 0);
        o = o + 1;
    }

    # ============================================================
    # .rdata section — gvar storage (zero-filled) + string bytes.
    # Strings are copied from the compiler's str_data region
    # (S + 0x21A000) so `movabs rax, imm64` fixups patched with
    # ImageBase + _pe_rdata_rva + totvar + str_offset resolve to
    # real content at runtime. gvars stay zero-initialized on PE
    # (same treatment as ELF); runtime stores into them use the
    # same movabs+store path that works once the VA is mapped.
    # ============================================================
    var bss_o = o;
    ti = 0;
    while (ti < _pe_rdata_totvar) {
        store8(O + o + ti, 0);
        ti = ti + 1;
    }
    # v5.11.64: overwrite static-init slots with their literal values
    _EMIT_GVAR_STATIC_INITS(S, O, bss_o);
    o = o + _pe_rdata_totvar;
    ti = 0;
    while (ti < _pe_rdata_spos) {
        store8(O + o + ti, load8(S + 0x21A000 + ti));
        ti = ti + 1;
    }
    o = o + _pe_rdata_spos;
    # Pad rdata to FileAlignment (the in-memory tail beyond vsize
    # stays zero; the file-aligned pad keeps the on-disk image
    # aligned so SizeOfImage / PointerToRawData arithmetic holds).
    var rdata_pad_target = _pe_rdata_file_off + _pe_rdata_file_size;
    while (o < rdata_pad_target) {
        store8(O + o, 0);
        o = o + 1;
    }

    # ============================================================
    # .reloc section — per-4KB-page DIR64 blocks (v5.5.35).
    # ============================================================
    # Walks the coff array collected in _pe_layout (stored at
    # S + 0x1DC000, sorted ascending). Emits one base-relocation
    # block per 4 KB page of code, matching PE32+ spec:
    #
    #   Block header (8 B):  DWORD PageRVA; DWORD BlockSize
    #   Entries (2 B each):  top 4 bits = type (DIR64 = 10),
    #                        bottom 12 bits = offset within page
    #
    # BlockSize includes the header + all entries + optional
    # 2-byte IMAGE_REL_BASED_ABSOLUTE (type 0) pad when the entry
    # count is odd (blocks must be DWORD-aligned).
    if (_pe_reloc_vsize != 0) {
        var rl_ei = 0;
        var rl_rj = 0;
        var rl_page = 0;
        var rl_rva_i = 0;
        var rl_ec = 0;
        var rl_blk_bytes = 0;
        var rl_blk_size = 0;
        var rl_k2 = 0;
        var rl_rva_k = 0;
        var rl_off = 0;
        var rl_ent = 0;
        while (rl_ei < _pe_reloc_count) {
            rl_rva_i = L64(S + 0x1DC000 + rl_ei * 8) + _pe_text_rva;
            rl_page = rl_rva_i >> 12;
            # Walk forward to find end of this page's entries.
            rl_rj = rl_ei + 1;
            var rl_same = 1;
            while (rl_same == 1 && rl_rj < _pe_reloc_count) {
                rl_rva_k = L64(S + 0x1DC000 + rl_rj * 8) + _pe_text_rva;
                if ((rl_rva_k >> 12) == rl_page) {
                    rl_rj = rl_rj + 1;
                } else {
                    rl_same = 0;
                }
            }
            rl_ec = rl_rj - rl_ei;
            rl_blk_bytes = 8 + rl_ec * 2;
            rl_blk_size = (rl_blk_bytes + 3) & (0 - 4);
            # Block header
            o = _pe_w32(O, o, rl_page << 12);   # PageRVA (4KB-aligned)
            o = _pe_w32(O, o, rl_blk_size);
            # Entries
            rl_k2 = rl_ei;
            while (rl_k2 < rl_rj) {
                rl_rva_k = L64(S + 0x1DC000 + rl_k2 * 8) + _pe_text_rva;
                rl_off = rl_rva_k & 0xFFF;
                # DIR64 type = 10 → top nibble 0xA; combine with offset
                rl_ent = 0xA000 | rl_off;
                o = _pe_w16(O, o, rl_ent);
                rl_k2 = rl_k2 + 1;
            }
            # DWORD pad — one ABSOLUTE (type 0) entry when odd count
            if (rl_blk_size > rl_blk_bytes) {
                o = _pe_w16(O, o, 0);
            }
            rl_ei = rl_rj;
        }
        # Pad .reloc to FileAlignment on disk.
        var reloc_pad_target = _pe_reloc_file_off + _pe_reloc_file_size;
        while (o < reloc_pad_target) {
            store8(O + o, 0);
            o = o + 1;
        }
    }

    # ============================================================
    # Final image size — FIXUP reads this from 0x1903F8 to know how
    # much of output_buf to write to stdout.
    # ============================================================
    S64(S + 0x1903F8, _pe_image_file_size);
    return 0;
}

# EMITPE_OBJ removed v5.5.40 closeout — was a no-op stub slotted for
# future PE .obj emission (relocatable object files); not reached
# from any entry point. When PE object emission is actually needed,
# the work starts from an EMITELF_OBJ-shaped analog here.
