# bespoke EWIN*_PE emit reroutes in src/backend/x86/emit.cyr; see
# lib/process_win.cyr + issue 2026-06-03-windows-pe-syscall-surface.
var _pe_waitobj_ready     = 0;
var _pe_waitobj_idx       = 0;
