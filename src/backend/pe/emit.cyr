var _pe_acqsrw_ready = 0;
var _pe_acqsrw_idx   = 0;
fn _pe_ensure_acqsrw(S): i64 {
    if (_pe_acqsrw_ready == 1) { return 0; }
    _pe_register_kernel32(S, &_pe_acqsrw_idx, "AcquireSRWLockExclusive");
    _pe_acqsrw_ready = 1;
    return 0;
}
fn _pe_acqsrw_get(): i64 { return _pe_acqsrw_idx; }

var _pe_relsrw_ready = 0;
var _pe_relsrw_idx   = 0;
fn _pe_ensure_relsrw(S): i64 {
    if (_pe_relsrw_ready == 1) { return 0; }
    _pe_register_kernel32(S, &_pe_relsrw_idx, "ReleaseSRWLockExclusive");
    _pe_relsrw_ready = 1;
    return 0;
}
fn _pe_relsrw_get(): i64 { return _pe_relsrw_idx; }

# v6.0.65: kernel32 Sleep import — portable lib/chrono.cyr sleep_ms on Windows
# (poll isn't routed on PE; raw nanosleep 35 faulted). 1-arg (dwMilliseconds).
var _pe_sleep_ready = 0;
var _pe_sleep_idx   = 0;
fn _pe_ensure_sleep(S): i64 {
    if (_pe_sleep_ready == 1) { return 0; }
    _pe_register_kernel32(S, &_pe_sleep_idx, "Sleep");
    _pe_sleep_ready = 1;
    return 0;
}
fn _pe_sleep_get(): i64 { return _pe_sleep_idx; }

# v6.0.61 Stage 2: thread-local storage imports (lib/thread_local.cyr).
var _pe_getcurtid_ready = 0;
var _pe_getcurtid_idx   = 0;
fn _pe_ensure_getcurtid(S): i64 {
    if (_pe_getcurtid_ready == 1) { return 0; }
    _pe_register_kernel32(S, &_pe_getcurtid_idx, "GetCurrentThreadId");
    _pe_getcurtid_ready = 1;
    return 0;
}
fn _pe_getcurtid_get(): i64 { return _pe_getcurtid_idx; }

var _pe_tlsalloc_ready = 0;
var _pe_tlsalloc_idx   = 0;
fn _pe_ensure_tlsalloc(S): i64 {
    if (_pe_tlsalloc_ready == 1) { return 0; }
    _pe_register_kernel32(S, &_pe_tlsalloc_idx, "TlsAlloc");
    _pe_tlsalloc_ready = 1;
    return 0;
}
fn _pe_tlsalloc_get(): i64 { return _pe_tlsalloc_idx; }

var _pe_tlsget_ready = 0;
var _pe_tlsget_idx   = 0;
fn _pe_ensure_tlsget(S): i64 {
    if (_pe_tlsget_ready == 1) { return 0; }
    _pe_register_kernel32(S, &_pe_tlsget_idx, "TlsGetValue");
    _pe_tlsget_ready = 1;
    return 0;
}
fn _pe_tlsget_get(): i64 { return _pe_tlsget_idx; }

var _pe_tlsset_ready = 0;
var _pe_tlsset_idx   = 0;
fn _pe_ensure_tlsset(S): i64 {
    if (_pe_tlsset_ready == 1) { return 0; }
    _pe_register_kernel32(S, &_pe_tlsset_idx, "TlsSetValue");
    _pe_tlsset_ready = 1;
    return 0;
