# _pe_ensure_closeh scaffold; lazily registered on the first 0xF007-0xF00A
# syscall the parser sees under _TARGET_PE==1. (WaitForSingleObject + CloseHandle
# for thread_join already exist — reused.) See thread issue + nuances issue.
var _pe_createthread_ready = 0;
