# v5.11.22: CreateDirectoryW / DeleteFileW auto-imports for the
# `syscall(83, path, mode)` (mkdir) + `syscall(87, path)` (unlink)
# PE reroute. ai-hwaccel 2.2.2 surfaced the need: their cache.cyr
# uses mkdir + unlink via raw syscall numbers; without these
# reroutes, cycc_win emitted the generic `0F 05` SYSCALL instruction
# which fault with STATUS_ILLEGAL_INSTRUCTION (0xC000001D) on Windows.

var _pe_createdir_ready   = 0;
