# ================================================================
# x86-64 length-only instruction decoder (v4.4.5)
# ================================================================
#
# Port of Nomade040's ldisasm.cpp, scoped to the subset of x86-64
# instructions Cyrius actually emits (no AVX/VEX/EVEX, no x87, no MMX).
# Foundation for byte-walking CFG construction (4.5.x), DCE
# correctness validation, and future register allocation work.
#
# Public functions:
#   DECODE_LEN(buf, off) -> N    instruction length at buf+off, 0 if undecodable
#   CLASSIFY_CF(buf, off) -> tag control-flow class:
#                                  0 = falls through (no CF instruction)
#                                  1 = JMP rel (E9 / EB / FF /4)
#                                  2 = JCC rel (0F 8x / 7x)
#                                  3 = CALL rel (E8 / FF /2)
#                                  4 = RET (C3 / C2 / C9-then-C3)
#                                  5 = unknown / indirect / undecodable
#   CF_TARGET(buf, off, kind) -> target offset (only meaningful for kinds 1/2/3)
#
# Reference: https://github.com/gh-nomad/length-disassembler/blob/master/ldisasm.cpp
# Plus Intel SDM Vol 2 §2.1 (instruction format) and §2.2.1 (REX).

# ----------------------------------------------------------------
# ModR/M length helper.
# Given the byte at `off` (the ModR/M byte) plus the address-size
# prefix flag, return how many BYTES follow ModR/M (SIB + displacement).
# Caller adds 1 for the ModR/M byte itself.
# ----------------------------------------------------------------
fn _MODRM_FOLLOW(modrm): i64 {
    var mfld = (modrm >> 6) & 3;
    var rm = modrm & 7;
    if (mfld == 3) { return 0; }                # register operand: no extra
    var extra = 0;
    if (mfld == 0) {
        if (rm == 4) { extra = 1; }            # SIB byte
        if (rm == 5) { extra = 4; }            # disp32 (RIP-rel in 64-bit)
    } elif (mfld == 1) {
        if (rm == 4) { extra = 2; }            # SIB + disp8
        else { extra = 1; }                    # disp8
    } elif (mfld == 2) {
        if (rm == 4) { extra = 5; }            # SIB + disp32
        else { extra = 4; }                    # disp32
    }
    return extra;
}

# ----------------------------------------------------------------
# Decode the length of the x86-64 instruction at buf+off.
# Returns 0 when undecodable (caller treats as "stop walking").
# ----------------------------------------------------------------
fn DECODE_LEN(buf, off): i64 {
    var p = off;
    var op_prefix = 0;       # 0x66 operand-size override
    var addr_prefix = 0;     # 0x67 address-size override
    var rex_w = 0;
    # Consume legacy prefixes + REX. Up to 14 prefix bytes per Intel.
    var pi = 0;
    while (pi < 14) {
        var b = load8(buf + p);
        if (b == 0x26 || b == 0x2E || b == 0x36 || b == 0x3E) { p = p + 1; pi = pi + 1; }
        elif (b == 0x64 || b == 0x65) { p = p + 1; pi = pi + 1; }
        elif (b == 0x66) { op_prefix = 1; p = p + 1; pi = pi + 1; }
        elif (b == 0x67) { addr_prefix = 1; p = p + 1; pi = pi + 1; }
        elif (b == 0xF0 || b == 0xF2 || b == 0xF3) { p = p + 1; pi = pi + 1; }
        elif (b >= 0x40 && b <= 0x4F) { rex_w = b & 8; p = p + 1; pi = pi + 1; }
        else { pi = 14; }                      # not a prefix; break
    }

    var op = load8(buf + p);
    p = p + 1;

    # ----- Two-byte opcode escape: 0x0F xx -----
    if (op == 0x0F) {
        var op2 = load8(buf + p);
        p = p + 1;
        # Three-byte opcode escapes. ⛔ THIS USED TO BAIL WITH "Cyrius doesn't emit these in
        # normal codegen" — and it does: `roundsd`/`roundss` (`66 0F 3A 0B` / `0A`) appear in
        # the float formatting path, so every binary that formats a float carried a function
        # this decoder could not walk. Found at v6.5.72 by auditing a LIBRARY binary; the
        # v6.5.68 audit only ever saw cycc's own `.text`, which contains none of them — a
        # coverage claim is only as wide as the corpus it was measured on.
        #   0F 38 xx — ModR/M, no immediate.
        #   0F 3A xx — ModR/M plus an imm8 (every member of that map takes one).
        if (op2 == 0x38) {
            var mr38 = load8(buf + p + 1);
            return p - off + 1 + _MODRM_FOLLOW(mr38);
        }
        if (op2 == 0x3A) {
            var mr3a = load8(buf + p + 1);
            return p - off + 1 + _MODRM_FOLLOW(mr3a) + 1;
        }
        # Common two-byte opcodes Cyrius emits — all take ModR/M:
        #   80..8F  Jcc rel32          (no ModR/M, has rel32)
        #   90..9F  SETcc r/m8         (ModR/M)
        #   A3      BT r/m, r          (ModR/M)
        #   AF      IMUL r, r/m        (ModR/M)
        #   B6      MOVZX r, r/m8      (ModR/M)
        #   B7      MOVZX r, r/m16     (ModR/M)
        #   BE      MOVSX r, r/m8      (ModR/M)
        #   BF      MOVSX r, r/m16     (ModR/M)
        if (op2 >= 0x80 && op2 <= 0x8F) {
            return p - off + 4;                # rel32
        }
        # No-ModR/M, no-operand two-byte opcodes — the 2-byte form is the whole
        # instruction (v6.4.15 DECODE fix). Cyrius emits 0F 05 SYSCALL constantly
        # and 0F A2 CPUID (sigil AES-NI/SHA-NI probes); the rest are future-proofing.
        #   05 SYSCALL  07 SYSRET   08 INVD    09 WBINVD  0B UD2     30 WRMSR
        #   31 RDTSC    32 RDMSR    33 RDPMC   34 SYSENTER 35 SYSEXIT 77 EMMS
        #   A2 CPUID    AA RSM
        # (A2 CPUID is distinct from A3 BT/ModR/M; AA RSM from AB BTS/ModR/M.)
        if (op2 == 0x05 || op2 == 0x07 || op2 == 0x08 || op2 == 0x09 ||
            op2 == 0x0B || op2 == 0x30 || op2 == 0x31 || op2 == 0x32 ||
            op2 == 0x33 || op2 == 0x34 || op2 == 0x35 || op2 == 0x77 ||
            op2 == 0xA2 || op2 == 0xAA) {
            return p - off;                    # 0F + op2 already consumed (2 bytes + prefixes)
        }
        # ModR/M-bearing forms carrying an imm8 AFTER the ModR/M (v6.5.68).
        # ⛔ THESE WERE MISSING AND THE OMISSION WAS NOT FAIL-SAFE. Everything else this
        # decoder cannot handle returns 0, and every caller treats 0 as "stop" — but a
        # length that is merely one byte SHORT desynchronises the walk, and the walker then
        # decodes an immediate as an opcode. MEASURED across 39 corpus binaries (854,747
        # instructions): 559 sites, 489 of them `0F BA` — `48 0F BA F0 3F` (`btr rax, 63`,
        # the f64 tag strip at emit.cyr:3164) is FIVE bytes and this function returned FOUR.
        #   70 PSHUFD/PSHUFLW/PSHUFHW · 71/72/73 the PSRL/PSRA/PSLL groups · A4 SHLD ·
        #   AC SHRD · BA the BT/BTS/BTR/BTC group · C2 CMPPS/CMPPD · C4 PINSRW ·
        #   C5 PEXTRW · C6 SHUFPS/SHUFPD
        # RA_SCAN_LOOPS (the regalloc picker's loop finder) is the live consumer, so a
        # desync there costs a missed backward edge — which is the v5.6.22 miscompile the
        # loop-extension exists to prevent. CHANGELOG [6.5.68]
        var _imm8_after = 0;
        if (op2 == 0x70 || op2 == 0x71 || op2 == 0x72 || op2 == 0x73 ||
            op2 == 0xA4 || op2 == 0xAC || op2 == 0xBA ||
            op2 == 0xC2 || op2 == 0xC4 || op2 == 0xC5 || op2 == 0xC6) { _imm8_after = 1; }
        # ModR/M-bearing forms
        var mr = load8(buf + p);
        p = p + 1;
        return p - off + _MODRM_FOLLOW(mr) + _imm8_after;
    }

    # ----- One-byte opcodes -----
    # No-operand single bytes (RET, NOPs, prefixes-as-opcodes, push/pop reg)
    if (op == 0xC3 || op == 0xC9 || op == 0x90 || op == 0xFC || op == 0xFD) { return p - off; }
    # 0x98 CWDE/CDQE, 0x99 CWD/CDQ/CQO — no operands (v6.5.68). `ECQO` (emit.cyr:282) emits
    # `48 99` before EVERY integer division, and without this case DECODE_LEN returned 0 for
    # all 81 of them in cycc's own `.text`. That is fail-safe but expensive: RA_SCAN_LOOPS
    # returns -1 on an undecodable byte and the picker then falls back to whole-function
    # intervals, so v6.5.35's loop-aware register time-sharing was silently OFF in every
    # function containing `/` or `%`. CHANGELOG [6.5.68]
    if (op == 0x98 || op == 0x99) { return p - off; }
    if (op >= 0x50 && op <= 0x5F) { return p - off; }   # push/pop r64
    # Single byte CALL/JMP relative
    if (op == 0xE8 || op == 0xE9) { return p - off + 4; }   # rel32
    if (op == 0xEB) { return p - off + 1; }                  # JMP rel8
    if (op >= 0x70 && op <= 0x7F) { return p - off + 1; }   # Jcc rel8
    if (op == 0xE3 || op == 0xE0 || op == 0xE1 || op == 0xE2) { return p - off + 1; }  # JRCXZ/LOOP
    if (op == 0xC2) { return p - off + 2; }                  # RET imm16
    if (op == 0xCC) { return p - off; }                      # INT3
    if (op == 0xCD) { return p - off + 1; }                  # INT imm8

    # Two-byte sequences with no ModR/M — common Cyrius emissions:
    if (op == 0x05 || op == 0x0D || op == 0x15 || op == 0x1D ||
    op == 0x25 || op == 0x2D || op == 0x35 || op == 0x3D) {
        # ADD/OR/.../CMP eax, imm32 (or rax, imm32 with REX.W)
        return p - off + 4;
    }
    if (op == 0x04 || op == 0x0C || op == 0x14 || op == 0x1C ||
    op == 0x24 || op == 0x2C || op == 0x34 || op == 0x3C) {
        return p - off + 1;                    # AL, imm8 family
    }

    # MOV r64, imm64 — opcode B8..BF + 8-byte imm (with REX.W); imm32 without
    if (op >= 0xB8 && op <= 0xBF) {
        if (rex_w != 0) { return p - off + 8; }
        if (op_prefix == 1) { return p - off + 2; }
        return p - off + 4;
    }
    # MOV r8, imm8 — B0..B7
    if (op >= 0xB0 && op <= 0xB7) { return p - off + 1; }

    # ModR/M-bearing arithmetic/move/test family (most of Cyrius's emit set):
    #   00..03 ADD,  08..0B OR,   10..13 ADC,  18..1B SBB
    #   20..23 AND,  28..2B SUB,  30..33 XOR,  38..3B CMP
    #   84..85 TEST, 86..87 XCHG, 88..8B MOV,  8D LEA,  8F POP r/m
    #   D1, D3 (shifts by 1 / by CL)  — ModR/M only
    #   F6, F7 (TEST/NOT/NEG/MUL/IMUL/DIV/IDIV) — ModR/M, F6 +imm8 if reg=0/1, F7 +imm32 if reg=0/1
    #   FE, FF — ModR/M only (INC/DEC, CALL/JMP indirect)
    var has_modrm = 0;
    var imm_after_modrm = 0;   # 0/1/2/4 bytes after ModR/M

    if ((op >= 0x00 && op <= 0x03) || (op >= 0x08 && op <= 0x0B) ||
    (op >= 0x10 && op <= 0x13) || (op >= 0x18 && op <= 0x1B) ||
    (op >= 0x20 && op <= 0x23) || (op >= 0x28 && op <= 0x2B) ||
    (op >= 0x30 && op <= 0x33) || (op >= 0x38 && op <= 0x3B)) {
        has_modrm = 1;
    }
    if (op == 0x84 || op == 0x85 || op == 0x86 || op == 0x87) { has_modrm = 1; }
    if (op == 0x63) { has_modrm = 1; }   # MOVSXD r64, r/m32 (v6.5.68 — the switch dispatch)
    if (op >= 0x88 && op <= 0x8B) { has_modrm = 1; }
    if (op == 0x8D || op == 0x8F) { has_modrm = 1; }
    if (op == 0xD1 || op == 0xD3) { has_modrm = 1; }
    if (op == 0xFE || op == 0xFF) { has_modrm = 1; }

    # Group 1: 80/81/82/83 — ModR/M then immediate (sized by opcode)
    if (op == 0x80 || op == 0x82) { has_modrm = 1; imm_after_modrm = 1; }
    if (op == 0x83) { has_modrm = 1; imm_after_modrm = 1; }
    if (op == 0x81) {
        has_modrm = 1;
        if (op_prefix == 1) { imm_after_modrm = 2; }
        else { imm_after_modrm = 4; }
    }
    # C0/C1 — shift r/m8/16/32/64 by imm8
    if (op == 0xC0 || op == 0xC1) { has_modrm = 1; imm_after_modrm = 1; }
    # C6/C7 — MOV r/m, imm
    if (op == 0xC6) { has_modrm = 1; imm_after_modrm = 1; }
    if (op == 0xC7) {
        has_modrm = 1;
        if (op_prefix == 1) { imm_after_modrm = 2; }
        else { imm_after_modrm = 4; }
    }
    # F6/F7: ModR/M; if reg field == 0 or 1 (TEST), an immediate follows
    if (op == 0xF6 || op == 0xF7) {
        has_modrm = 1;
        var modrm = load8(buf + p);
        var reg = (modrm >> 3) & 7;
        if (reg == 0 || reg == 1) {
            if (op == 0xF6) { imm_after_modrm = 1; }
            else {
                if (op_prefix == 1) { imm_after_modrm = 2; }
                else { imm_after_modrm = 4; }
            }
        }
    }

    if (has_modrm == 1) {
        var mr = load8(buf + p);
        p = p + 1;
        return p - off + _MODRM_FOLLOW(mr) + imm_after_modrm;
    }

    # 0xA0..0xA3 — MOV moffs, A0/A1 are 8-byte addr in 64-bit mode
    if (op == 0xA0 || op == 0xA1 || op == 0xA2 || op == 0xA3) {
        if (addr_prefix == 1) { return p - off + 4; }
        return p - off + 8;
    }
    # 0xA4..0xA7 / 0xAA..0xAF — string ops (MOVS, CMPS, STOS, LODS, SCAS): no operands
    if (op == 0xA4 || op == 0xA5 || op == 0xA6 || op == 0xA7 ||
    op == 0xAA || op == 0xAB || op == 0xAC || op == 0xAD || op == 0xAE || op == 0xAF) {
        return p - off;
    }
    # 0x6A — PUSH imm8;  0x68 — PUSH imm32
    if (op == 0x6A) { return p - off + 1; }
    if (op == 0x68) {
        if (op_prefix == 1) { return p - off + 2; }
        return p - off + 4;
    }
    # IDIV / DIV / NEG / NOT 1-operand fallback handled by F6/F7 above.

    # Everything else: bail out conservatively. The CFG walker should
    # treat this as a black-box and not advance past it. Better than
    # silently miscounting and walking off the end of an instruction.
    return 0;
}

# ----------------------------------------------------------------
# Classify the control-flow effect of the instruction at buf+off.
# Returns:
#   0 falls through (no CF effect; execution continues at off + length)
#   1 JMP rel (E9 / EB)
#   2 Jcc rel (0F 8x / 7x)
#   3 CALL rel (E8)
#   4 RET (C3 / C2 / C9 followed by C3)
#   5 unknown / indirect / undecodable
# Caller pairs this with DECODE_LEN to walk the binary.
# ----------------------------------------------------------------
fn CLASSIFY_CF(buf, off): i64 {
    # Skip prefixes + REX so the opcode classification is clean.
    var p = off;
    var pi = 0;
    while (pi < 14) {
        var b = load8(buf + p);
        if (b == 0x26 || b == 0x2E || b == 0x36 || b == 0x3E) { p = p + 1; pi = pi + 1; }
        elif (b == 0x64 || b == 0x65 || b == 0x66 || b == 0x67) { p = p + 1; pi = pi + 1; }
        elif (b == 0xF0 || b == 0xF2 || b == 0xF3) { p = p + 1; pi = pi + 1; }
        elif (b >= 0x40 && b <= 0x4F) { p = p + 1; pi = pi + 1; }
        else { pi = 14; }
    }
    var op = load8(buf + p);
    if (op == 0xE8) { return 3; }
    if (op == 0xE9 || op == 0xEB) { return 1; }
    if (op >= 0x70 && op <= 0x7F) { return 2; }
    if (op == 0xC3 || op == 0xC2) { return 4; }
    if (op == 0xC9) {
        if (load8(buf + p + 1) == 0xC3) { return 4; }
        return 0;
    }
    if (op == 0x0F) {
        var op2 = load8(buf + p + 1);
        if (op2 >= 0x80 && op2 <= 0x8F) { return 2; }
        return 0;
    }
    if (op == 0xFF) {
        var modrm = load8(buf + p + 1);
        var reg = (modrm >> 3) & 7;
        if (reg == 2 || reg == 3) { return 5; }   # CALL r/m
        if (reg == 4 || reg == 5) { return 5; }   # JMP r/m (treated as terminator-unknown)
        return 0;
    }
    return 0;
}

# ----------------------------------------------------------------
# For a JMP/Jcc/CALL with rel8 or rel32, return the target offset.
# Returns -1 for undecodable / indirect.
# Caller is expected to have already classified via CLASSIFY_CF.
# ----------------------------------------------------------------
fn CF_TARGET(buf, off, kind): i64 {
    # Skip prefixes + REX.
    var p = off;
    var pi = 0;
    while (pi < 14) {
        var b = load8(buf + p);
        if (b == 0x26 || b == 0x2E || b == 0x36 || b == 0x3E) { p = p + 1; pi = pi + 1; }
        elif (b == 0x64 || b == 0x65 || b == 0x66 || b == 0x67) { p = p + 1; pi = pi + 1; }
        elif (b == 0xF0 || b == 0xF2 || b == 0xF3) { p = p + 1; pi = pi + 1; }
        elif (b >= 0x40 && b <= 0x4F) { p = p + 1; pi = pi + 1; }
        else { pi = 14; }
    }
    var op = load8(buf + p);
    # rel32 cases
    if (op == 0xE8 || op == 0xE9) {
        var rel32 = load32(buf + p + 1);
        if (rel32 >= 0x80000000) { rel32 = rel32 - 0x100000000; }
        return p + 5 + rel32;
    }
    # 0x0F 0x8x rel32
    if (op == 0x0F) {
        var op2 = load8(buf + p + 1);
        if (op2 >= 0x80 && op2 <= 0x8F) {
            var r32 = load32(buf + p + 2);
            if (r32 >= 0x80000000) { r32 = r32 - 0x100000000; }
            return p + 6 + r32;
        }
        return 0 - 1;
    }
    # rel8 cases
    if (op == 0xEB) {
        var r = load8(buf + p + 1);
        if (r >= 0x80) { r = r - 0x100; }
        return p + 2 + r;
    }
    if (op >= 0x70 && op <= 0x7F) {
        var r = load8(buf + p + 1);
        if (r >= 0x80) { r = r - 0x100; }
        return p + 2 + r;
    }
    return 0 - 1;
}

# ----------------------------------------------------------------
# v6.5.35 — backward-edge (loop) discovery, for the linear-scan register
# allocator's live-interval extension.
#
# WHY THIS EXISTS. `PARSE_FN_DEF`'s Poletto-Sarkar picker computes real live
# intervals (`ra_first` / `ra_last`) and then, since v5.6.22, THREW THEM AWAY —
# every interval's end was force-set to the function end so the expire step could
# never fire. That was not an oversight: naive time-sharing is UNSOUND across a
# backward edge. When the picker reuses a register for a later interval, a
# `JMP_BACK` into a position inside an EARLIER interval re-reads the register
# expecting the earlier value and finds the later one. It surfaced on
# `PP_ALREADY_INCLUDED` (`while (i < cnt)`: the `cnt` load was rewritten to rbx,
# and rbx was later reused for `p` inside the loop body).
#
# The v5.6.22 note called the fix "extend last_cp to fn_end so expire never fires
# → effectively greedy-equivalent assignment", with the proper fix — loop-aware
# liveness extension — deferred. This is the substrate for that proper fix: find
# every backward branch in a function's emitted range so an interval overlapping a
# loop body can be extended to the loop's end instead of to the whole function's.
#
# ⚠ Read "the cross-BB defect is ONE line" with care: reverting that one line
# alone REINTRODUCES the v5.6.22 miscompile. The line is a correct, conservative
# guard; what replaces it has to be at least as safe.
#
# Walks [lo, hi) instruction by instruction via DECODE_LEN, and records every
# JMP rel / Jcc whose target lands at or after `lo` and strictly BEFORE the branch
# itself. Writes targets to `out_t` and branch offsets to `out_s`.
#
# Returns the edge count, or -1 if the range could not be walked reliably (an
# undecodable instruction) or there are more edges than `cap`. **-1 means "no
# information", and every caller must then fall back to the conservative
# whole-function extent** — a partial edge list is worse than none, because the
# picker would time-share across the loop this function failed to see.
fn RA_SCAN_LOOPS(base, lo, hi, out_t, out_s, cap): i64 {
    var n = 0;
    var p = lo;
    while (p < hi) {
        var ilen = DECODE_LEN(base, p);
        if (ilen <= 0) { return 0 - 1; }
        var k = CLASSIFY_CF(base, p);
        if (k == 1 || k == 2) {
            var tg = CF_TARGET(base, p, k);
            if (tg >= lo) {
                if (tg < p) {
                    if (n >= cap) { return 0 - 1; }
                    store64(out_t + n * 8, tg);
                    store64(out_s + n * 8, p);
                    n = n + 1;
                }
            }
        }
        p = p + ilen;
    }
    return n;
}

# ----------------------------------------------------------------
# DECODE_WALK_OK — can DECODE_LEN walk [lo, hi) and land EXACTLY on hi?
#
# Returns 1 if every instruction in the range decodes and the walk terminates
# exactly at `hi`; 0 if it hits an undecodable byte, and 0 - 1 if it OVERSHOOTS
# (which means a length was wrong, not merely unknown, or the range contains
# data — an embedded switch jump table is the live example).
#
# ⛔ WHY THIS EXISTS, v6.5.68. `DECODE_LEN` is load-bearing — `RA_SCAN_LOOPS`
# above feeds the register allocator's loop-aware interval extension on the
# DEFAULT path — and NOTHING verified its coverage against the bytes cyrius
# actually emits. Two gaps had accumulated:
#   * `0x99` (CQO) had no case at all. `ECQO` emits `48 99` before EVERY integer
#     division, so `RA_SCAN_LOOPS` returned -1 for every function containing `/`
#     or `%`, and v6.5.35's register time-sharing was silently OFF there. That
#     is the SAFE failure — -1 means "no information" and the picker falls back.
#   * The two-byte opcodes carrying an imm8 AFTER the ModR/M (`0F BA` BT-group,
#     `0F 70`-`0F 73` the shift groups, `0F C2`/`C4`/`C5`/`C6`) returned a length
#     ONE BYTE SHORT — 559 sites across a 39-binary corpus. That is the UNSAFE
#     failure: the walk desynchronises and decodes an immediate as an opcode, so
#     a real backward edge can be stepped over, which is exactly the v5.6.22
#     miscompile the loop extension exists to prevent.
# A length decoder that is wrong is worse than one that is incomplete, and only a
# check that walks REAL emitted code can tell the two apart. CHANGELOG [6.5.68]
# ----------------------------------------------------------------
fn DECODE_WALK_OK(base, lo, hi): i64 {
    var p = lo;
    while (p < hi) {
        var ilen = DECODE_LEN(base, p);
        if (ilen <= 0) { return 0; }
        p = p + ilen;
    }
    if (p != hi) { return 0 - 1; }
    return 1;
}
