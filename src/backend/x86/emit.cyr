# ================================================================
# CODE EMISSION (writes to codebuf at S+0x41A000+CP (1MB since v3.5.1))
# ================================================================

# Mirror of the aarch64 backend's marker. Lets arch-neutral code
# (e.g. parse.cyr asm-block handling) check which backend is live
# via a plain `if` without touching the preprocessor.
var _AARCH64_BACKEND = 0;

# v5.6.8 O2 category 2: flag-result reuse tracking. When set to 1,
# the most-recent x86 emit left ZF reflecting "rax == 0" (i.e., any
# subsequent `test rax, rax` is redundant). Set by arith helpers
# that compute into rax AND set ZF from the result; set by the
# xor-rax-zero path in EMOVI(0) and EXORAA (both yield ZF=1); set
# by ETESTAZ itself (it IS the test-from-rax). Cleared by any emit
# that modifies rax without a matching ZF update (EPOPR, EMOVI
# with nonzero immediate, load helpers, EIMUL whose ZF is
# architecturally undefined per Intel SDM). Read by ECONDCMP in
# parse_ctrl.cyr to skip a redundant ETESTAZ when the bare-value-
# in-rax flow already has correct ZF.
var _flags_reflect_rax = 0;

# v5.6.9 O2 category 3: redundant push/pop cancellation tracker.
# Records CP immediately AFTER any EPUSHR/ESPILL emit. When the
# very next emit is EPOPR/EUNSPILL (which check GCP == _last_push_cp),
# the push/pop pair is known to be back-to-back with no code between
# — rewind CP by 1 to cancel both. Initialised to -1 so a pop
# before any push falls through to the normal pop path. ANY
# intervening emit advances CP, which breaks the equality check
# naturally — no explicit invalidation needed across other helpers.
# Observed v5.6.8 cycc has 381 occurrences of `50 58` (push rax;
# pop rax) adjacent, mostly from v5.6.7 strength-reduction's
# ESPILL → _TRY_MUL_BY_POW2 → EUNSPILL pattern. Cancel saves
# 2 B per site.
var _last_push_cp = 0 - 1;

# v5.6.10 O2 category 4: commutative combine-shuttle elim. The
# compiler's binary-operator codegen path emits (for a+b): eval
# LHS → push; eval RHS → rax; mov rcx, rax; pop rax; op rax, rcx.
# The 7-byte trailer `48 89 C1 58 48 01 C8` (EMOVCA + EPOPR + EADDR)
# is pure shuttle — for commutative ops (ADD/AND/OR/XOR/IMUL) the
# same result drops out of `pop rcx; op rax, rcx` in 4 bytes.
#
# Two-state tracker:
#   _last_emovca_cp      = GCP after EMOVCA emitted its 3 bytes.
#   _last_movca_popr_cp  = GCP after EPOPR/EUNSPILL emitted its 1 byte,
#                          iff the pop immediately followed an EMOVCA.
#
# Commutative emit helpers (EADDR/EANDR/EORR/EXORR/EIMUL) check
# GCP == _last_movca_popr_cp and, on match, rewind 4 bytes (past
# `48 89 C1 58`), emit `59` (pop rcx), then fall through to the
# normal op bytes. Net: 7 B → 4 B per site, saves 3 B.
#
# Observed v5.6.9 cycc: 5399 ADD + 340 AND + 66 OR + 3 XOR + 53 IMUL
# sites = 5861 total → ~17.5 KB raw savings. Non-commutative ops
# (SUB 392, CMP 3880) deliberately excluded — they need flag-order
# flip / explicit negation, pinned for a later LEA-spirit patch.
var _last_emovca_cp = 0 - 1;
var _last_movca_popr_cp = 0 - 1;

# Stub so parse.cyr's `_AARCH64_BACKEND == 1` branches can reference
# aarch64 emit primitives without the x86 build emitting an
# "undefined function" warning. Dead on x86 at runtime.
fn EW(S, w): i64 { return 0; }
# v5.9.26 — Phase 2b-aarch64 struct-copy in PARSE_RETURN
# references _EFP_ADDR_X9 from the aarch64 backend. Stub here for
# the same dead-on-x86 reason as EW above.
fn _EFP_ADDR_X9(S, disp): i64 { return 0; }
# v5.9.26 — caller-side aarch64 retptr load via X8. Stub on x86
# (the x86 caller path uses EFLADDR + EPUSHR + ECALLPOPS instead).
fn EFLADDR_X8(S, lli): i64 { return 0; }
# v5.9.39 — Mach-O ARM PIE-safe `&fn_name` / closure-literal emit
# in parse_expr.cyr's `_AARCH64_BACKEND == 1` branch references
# the aarch64 ADRP+ADD primitives. Stubs here for the same
# dead-on-x86 reason as EW / _EFP_ADDR_X9 above.
fn EADRP(S, reg): i64 { return 0; }
fn EADD_IMM12(S, reg): i64 { return 0; }

fn EB(S, b): i64 {
    var cp = GCP(S);
    if (_codebuf_cap != 0 && cp >= _codebuf_cap - 64) { _codebuf_grow(S); }
    store8(_codebuf_base + cp, b & 0xFF);
    SCP(S, cp + 1);
    return 0;
}

fn E2(S, v): i64 {
    EB(S, v & 0xFF);
    EB(S, v >> 8 & 0xFF);
    return 0;
}

fn E8(S, v): i64 {
    EB(S, v & 0xFF);
    EB(S, v >> 8 & 0xFF);
    EB(S, v >> 16 & 0xFF);
    EB(S, v >> 24 & 0xFF);
    EB(S, v >> 32 & 0xFF);
    EB(S, v >> 40 & 0xFF);
    EB(S, v >> 48 & 0xFF);
    EB(S, v >> 56 & 0xFF);
    return 0;
}

# emit "mov rax, imm64" — 48 B8 <imm64>
# cycc: records IR_LOAD_IMM when IR is enabled
fn EMOVI(S, v): i64 {
    var _ire = IR_ENABLED(S);
    if (_ire >= 1) { ir_emit(S, IR_LOAD_IMM, 0, 0, v); if (_ire == 2) { return 0; } }
    if (v == 0) {
        # xor eax, eax (2 bytes, clears rax — faster and smaller than movabs)
        EB(S, 0x31); EB(S, 0xC0);
        _flags_reflect_rax = 1;   # xor rax, rax → ZF=1; flag good
        return 0;
    }
    if (v > 0) { if (v < 0x80000000) {
            # mov eax, imm32 (5 bytes — zero-extends to rax)
            EB(S, 0xB8);
            EB(S, v & 0xFF); EB(S, (v >> 8) & 0xFF);
            EB(S, (v >> 16) & 0xFF); EB(S, (v >> 24) & 0xFF);
            _flags_reflect_rax = 0;   # mov doesn't set flags; rax changed
            return 0;
        } }
    E2(S, 0xB848);
    E8(S, v);
    _flags_reflect_rax = 0;
    return 0;
}

# emit 3-byte instruction from packed value
fn E3(S, v): i64 {
    EB(S, v & 0xFF);
    EB(S, v >> 8 & 0xFF);
    EB(S, v >> 16 & 0xFF);
    return 0;
}

# Standard codegen emissions (match cybs exactly)
# cycc: all record IR nodes when IR_ENABLED(S)==1
fn EPUSHR(S): i64 { if (_IR_REC0(S, IR_PUSH) == 1) { return 0; } EB(S, 0x50); _last_push_cp = GCP(S); return 0; }
fn EPOPC(S): i64 { if (_IR_REC0(S, IR_POP_RCX) == 1) { return 0; } EB(S, 0x59); return 0; }
fn EPOPR(S): i64 {
    if (_IR_REC0(S, IR_POP_RAX) == 1) { return 0; }
    if (GCP(S) == _last_push_cp) {
        # v5.6.9: adjacent push+pop = no-op. Rewind past the push.
        SCP(S, GCP(S) - 1);
        _last_push_cp = 0 - 1;
        return 0;
    }
    # v5.6.10: remember if the pop landed immediately after EMOVCA,
    # so a commutative op next can collapse the 7-byte shuttle.
    var after_movca = 0;
    if (GCP(S) == _last_emovca_cp) { after_movca = 1; }
    EB(S, 0x58);
    if (after_movca == 1) { _last_movca_popr_cp = GCP(S); }
    _flags_reflect_rax = 0;
    return 0;
}

# Expression spill: identical to push/pop
var _INLINE_OK = 0;
var _LOOPVAR_OK = 0;  # loop var r12 caching disabled (caused 2x regression + stack corruption)
fn ESPILL(S): i64 { if (_IR_REC0(S, IR_PUSH) == 1) { return 0; } EB(S, 0x50); _last_push_cp = GCP(S); return 0; }
fn EUNSPILL(S): i64 {
    if (_IR_REC0(S, IR_POP_RAX) == 1) { return 0; }
    if (GCP(S) == _last_push_cp) {
        # v5.6.9: adjacent push+pop = no-op. Rewind past the push.
        SCP(S, GCP(S) - 1);
        _last_push_cp = 0 - 1;
        return 0;
    }
    # v5.6.10: same EMOVCA-follow detection as EPOPR.
    var after_movca = 0;
    if (GCP(S) == _last_emovca_cp) { after_movca = 1; }
    EB(S, 0x58);
    if (after_movca == 1) { _last_movca_popr_cp = GCP(S); }
    _flags_reflect_rax = 0;
    return 0;
}
fn EMOVCA(S): i64 { if (_IR_REC0(S, IR_MOV_CA) == 1) { return 0; } E3(S, 0xC18948); _last_emovca_cp = GCP(S); return 0; }
# v5.7.9: deleted the imm8-form `EADDIMM_X1(S, imm)` that lived
# here. It was a silent name collision with the imm32-form at
# line ~1390; the imm32-form (later definition) was winning at
# every call site since whenever it landed, and cycc self-builds
# clean because imm32 handles all the small-immediate values
# the call sites use (just 3 extra bytes per call). The collision
# was surfaced by v5.7.9's duplicate-fn warning (parse_fn.cyr).
# v5.6.10: commutative-combine peephole. If current CP matches the
# GCP recorded when EPOPR/EUNSPILL finished *immediately after*
# EMOVCA, rewind 4 bytes (past `48 89 C1 58`) and drop in `59`
# (pop rcx) — the op that follows then reads the correct operand
# from rcx. Only safe for commutative ops.
fn _TRY_COMBINE_SHUTTLE(S): i64 {
    if (GCP(S) == _last_movca_popr_cp) {
        SCP(S, GCP(S) - 4);
        EB(S, 0x59);
        _last_movca_popr_cp = 0 - 1;
    }
    return 0;
}
fn EADDR(S): i64 { if (_IR_REC0(S, IR_ADD) == 1) { return 0; } _TRY_COMBINE_SHUTTLE(S); E3(S, 0xC80148); _flags_reflect_rax = 1; return 0; }
# v5.11.51: rax += imm32 (sign-extended to 64). Used by the byte-array
# literal `var foo[N] = { 0x.., ... };` parser path to compute &var + i
# without going through a full expression evaluation. Encoding:
# `48 05 imm32` (6 bytes); imm32 is the 4-byte little-endian offset.
fn EADDRA_IMM(S, n): i64 {
    EB(S, 0x48); EB(S, 0x05);
    EB(S, n & 0xFF);
    EB(S, (n >> 8) & 0xFF);
    EB(S, (n >> 16) & 0xFF);
    EB(S, (n >> 24) & 0xFF);
    _flags_reflect_rax = 1;
    return 0;
}
# v5.11.54: MS-x64 reg-move + RSP-adjust named ops, used by the EFI
# Application entry trampoline (src/main.cyr) under
# CYRIUS_TARGET_EFI=1. The 5.11.52 ship had hand-coded `EB(S, 0x4C)`
# saves that decoded as wrong instructions (`4C 89 CE` = `mov rsi,
# r9` not `mov r14, rcx`) because MR-form `mov r/m, r` uses REX.B
# for destination-extension and REX.R for source-extension —
# v5.11.52 set REX.R when it needed REX.B. The 5.11.53 hotfix
# changed the byte literals; 5.11.54 changes the call sites to
# these named ops so the encoding is locked in code (op name spells
# the intent, REX bit can't drift). Filed as
# 2026-05-13-efi-main-trampoline-save-rex-wrong.md.
#
# **MR-form encoding cheat sheet** (opcode 89 /r — mov r/m64, r64):
#   REX.W = 1 always (64-bit operand)
#   REX.B = 1 → r/m field extends to r8..r15 (DESTINATION-extension)
#   REX.R = 1 → reg field extends to r8..r15 (SOURCE-extension)
#   ModR/M: mod=11 (reg-direct), reg=<src low 3 bits>, rm=<dst low 3 bits>
#
# r14/r15 as DESTINATION → REX.B=1 → REX byte 0x49
# r14/r15 as SOURCE      → REX.R=1 → REX byte 0x4C
#
# These ops aren't IR-recorded (they're only emitted at the very
# end of the entry trampoline, outside any user fn body — the IR
# pipeline doesn't reach them).
#
# Cross-arch: x86-only by construction. CYRIUS_TARGET_EFI is gated
# to x86_64 UEFI (UEFI aarch64 isn't a cyrius target yet) and these
# ops are only called when _TARGET_EFI_APPLICATION == 1.

# mov r14, rcx  →  49 89 CE  (save firmware ImageHandle into callee-saved r14)
fn EMOV_R14_RCX(S): i64 {
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xCE);
    return 0;
}
# mov r15, rdx  →  49 89 D7  (save firmware SystemTable into callee-saved r15)
fn EMOV_R15_RDX(S): i64 {
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xD7);
    return 0;
}
# mov rcx, r14  →  4C 89 F1  (restore ImageHandle for the efi_main call)
fn EMOV_RCX_R14(S): i64 {
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0xF1);
    return 0;
}
# mov rdx, r15  →  4C 89 FA  (restore SystemTable for the efi_main call)
fn EMOV_RDX_R15(S): i64 {
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0xFA);
    return 0;
}
# sub rsp, imm8  →  48 83 EC nn  (MS-x64 shadow space + alignment).
# Reserved for the trampoline's pre-call setup; imm8 is the standard
# 0x28 = 32B shadow + 8B align under EFI's entry-from-firmware shape.
fn ESUB_RSP_IMM8(S, n): i64 {
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, n & 0xFF);
    return 0;
}
# add rsp, imm8  →  48 83 C4 nn  (matching cleanup after the call).
fn EADD_RSP_IMM8(S, n): i64 {
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, n & 0xFF);
    return 0;
}
fn ESUBR(S): i64 { if (_IR_REC0(S, IR_SUB) == 1) { return 0; } E3(S, 0xC82948); _flags_reflect_rax = 1; return 0; }
fn EIMUL(S): i64 { if (_IR_REC0(S, IR_MUL) == 1) { return 0; } _TRY_COMBINE_SHUTTLE(S); E3(S, 0xE9F748); _flags_reflect_rax = 0; return 0; }
# EMULH: high 64 bits of unsigned rcx * rax. MUL rcx → rdx:rax; then rax = rdx.
# Used by the mulh64(a, b) builtin.
# v5.6.14: record IR_RAX_CLOBBER so LASE sees the rax overwrite.
fn EMULH(S): i64 { _IR_REC0(S, IR_RAX_CLOBBER); if (IR_ENABLED(S) == 2) { return 0; } E3(S, 0xE1F748); E3(S, 0xD08948); return 0; }
fn ECQO(S): i64 { if (IR_ENABLED(S) == 2) { return 0; } E2(S, 0x9948); return 0; }
# v5.6.14: EIDIV writes quotient to rax → record IR_RAX_CLOBBER.
fn EIDIV(S): i64 { _IR_REC0(S, IR_RAX_CLOBBER); if (IR_ENABLED(S) == 2) { return 0; } E3(S, 0xF9F748); return 0; }
fn EMOVDR(S): i64 { if (_IR_REC0(S, IR_MOV_RAX_RDX) == 1) { return 0; } E3(S, 0xD08948); _flags_reflect_rax = 0; return 0; }
# v5.6.14: ELODC emits `mov rax, [rcx]` → record IR_RAX_CLOBBER.
fn ELODC(S): i64 { _IR_REC0(S, IR_RAX_CLOBBER); if (IR_ENABLED(S) == 2) { return 0; } E3(S, 0x018B48); _flags_reflect_rax = 0; return 0; }
fn ESTOC(S): i64 { if (IR_ENABLED(S) == 2) { return 0; } E3(S, 0x018948); return 0; }
fn ECMPR(S): i64 { if (_IR_REC0(S, IR_CMP) == 1) { return 0; } E3(S, 0xC83948); _flags_reflect_rax = 0; return 0; }
fn ETESTAZ(S): i64 { if (_IR_REC0(S, IR_TEST_AZ) == 1) { return 0; } E3(S, 0xC08548); _flags_reflect_rax = 1; return 0; }
fn EMOVRDXRAX(S): i64 { if (_IR_REC0(S, IR_MOV_RDX_RAX) == 1) { return 0; } E3(S, 0xC28948); return 0; }
fn EMOVRA_RDX(S): i64 { if (_IR_REC0(S, IR_MOV_RAX_RDX) == 1) { return 0; } E3(S, 0xD08948); _flags_reflect_rax = 0; return 0; }
fn EMOVRDI(S): i64 { if (IR_ENABLED(S) == 2) { return 0; } E3(S, 0xC78948); return 0; }
fn ESYSCALL(S): i64 {
    if (_IR_REC0(S, IR_SYSCALL) == 1) { return 0; }
    if (_TARGET_MACHO == 1) {
        EB(S, 0x50);                       # push rax — stash the RAW Linux num for
        EMACHO_SYSXLAT(S);                 # EMACHO_PROC_FIXUP, THEN translate to BSD
    }                                      # (syscall clobbers rax; we pop the num back)
    E2(S, 0x050F);
    # v6.0.43: Darwin returns syscall errors via the CARRY flag with a
    # POSITIVE errno in rax (BSD convention), not Linux's negative return.
    # cyrius code checks `if (result < 0)`, so without converting, failed
    # syscalls look like success with a small positive value → garbage
    # pointers, missed fallbacks (e.g. PP_IFDEF_PASS's Linux-flags mmap that
    # must fall back to macОS MAP_ANON) → SIGSEGV. The arm64 backend handles
    # this with `csneg x0,x0,x0,cc`; the x86 equivalent is a post-syscall
    # `jnc +3; neg rax` (negate only when carry/error is set). See issue
    # 2026-06-02-macos-x86-release-no-compiler.md layer 5.
    if (_TARGET_MACHO == 1) {
        EB(S, 0x73); EB(S, 0x03);          # jnc +3 (skip neg when no error)
        EB(S, 0x48); EB(S, 0xF7); EB(S, 0xD8);  # neg rax
        EMACHO_PROC_FIXUP(S);              # fork/pipe rax:rdx multi-return fixup
    }
    _flags_reflect_rax = 0; return 0;
}

# v6.0.58: macOS process-syscall fixups that can't live in EMACHO_SYSXLAT's
# number table because they touch the rax:rdx multi-return AFTER the syscall.
# The BSD number was pushed pre-syscall (ESYSCALL); recover it into r11 (dead
# post-syscall — the kernel clobbers it with rflags) and branch on it:
#   fork (BSD 2): the kernel returns the child pid in rax for BOTH processes,
#     setting rdx=1 in the child. POSIX fork wants 0 in the child → if rdx==1,
#     zero rax. (x86 analog of the aarch64 .34 x1-fixup; cross-arch parity.)
#   pipe (BSD 42): returns fd0:fd1 in rax:rdx, NOT through a *fds pointer. The
#     Linux-shaped caller passed an fds ptr in rdi (preserved across the
#     syscall); on success store fd0→[rdi], fd1→[rdi+4] and return 0. The `js`
#     guard skips the store when the carry-negate already left rax<0 (error).
# Every other syscall falls straight through (both cmps miss), paying only the
# pop + two compares — cycc's own read/write/mmap/exit are unaffected, so it
# still self-hosts byte-identical. macho-only (Linux path never reaches here).
# r11 holds the RAW Linux syscall number (pushed pre-translation in ESYSCALL),
# so the compares use the Linux numbers (fork 57, pipe 22) as clean imm8s.
fn EMACHO_PROC_FIXUP(S): i64 {
    EB(S, 0x41); EB(S, 0x5B);                            # pop r11  (recover Linux num)
    EB(S, 0x49); EB(S, 0x83); EB(S, 0xFB); EB(S, 0x39);  # cmp r11, 57  (fork?)
    EB(S, 0x75); EB(S, 0x09);                            # jne +9
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xFA); EB(S, 0x01);  # cmp rdx, 1   (child?)
    EB(S, 0x75); EB(S, 0x03);                            # jne +3
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xC0);               # xor rax, rax (child → 0)
    EB(S, 0x49); EB(S, 0x83); EB(S, 0xFB); EB(S, 0x16);  # cmp r11, 22  (pipe?)
    EB(S, 0x75); EB(S, 0x0A);                            # jne +10
    EB(S, 0x78); EB(S, 0x08);                            # js  +8  (rax<0 error → skip)
    EB(S, 0x89); EB(S, 0x07);                            # mov [rdi], eax     (fds[0])
    EB(S, 0x89); EB(S, 0x57); EB(S, 0x04);               # mov [rdi+4], edx   (fds[1])
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xC0);               # xor rax, rax (success → 0)
    return 0;
}
fn ELOAD8(S): i64 { if (_IR_REC0(S, IR_LOAD8) == 1) { return 0; } EB(S, 0x48); EB(S, 0x0F); EB(S, 0xB6); EB(S, 0x00); _flags_reflect_rax = 0; return 0; }
fn ELOAD16(S): i64 { if (_IR_REC0(S, IR_LOAD16) == 1) { return 0; } EB(S, 0x0F); EB(S, 0xB7); EB(S, 0x00); _flags_reflect_rax = 0; return 0; }
fn ELOAD32(S): i64 { if (_IR_REC0(S, IR_LOAD32) == 1) { return 0; } EB(S, 0x8B); EB(S, 0x00); _flags_reflect_rax = 0; return 0; }
fn ELOAD64(S): i64 { if (_IR_REC0(S, IR_LOAD64) == 1) { return 0; } E3(S, 0x008B48); _flags_reflect_rax = 0; return 0; }
fn ESTORE8(S): i64 { if (_IR_REC0(S, IR_STORE8) == 1) { return 0; } E2(S, 0x0188); return 0; }
# v6.0.88: byte-array literal peephole — `mov byte [rcx + disp], imm8`
# (C6 /0). Base &var is hoisted into rcx once via EVADDR_X1; this emits
# one instruction per byte instead of the ~7-op EVADDR/EADDRA_IMM/PUSH/
# MOVI/POPC/STORE8/XORAA chain. x86 disp32 covers any array, so this
# always handles the store (returns 0). See CHANGELOG [6.0.88].
fn ESTOREB_IMM(S, disp, val): i64 {
    EB(S, 0xC6);
    if (disp >= 0 && disp < 128) {
        EB(S, 0x41);                 # ModRM mod=01 reg=000 rm=001: [rcx+disp8]
        EB(S, disp & 0xFF);
    } else {
        EB(S, 0x81);                 # ModRM mod=10 reg=000 rm=001: [rcx+disp32]
        EB(S, disp & 0xFF);
        EB(S, (disp >> 8) & 0xFF);
        EB(S, (disp >> 16) & 0xFF);
        EB(S, (disp >> 24) & 0xFF);
    }
    EB(S, val & 0xFF);
    return 0;
}
fn ESTORE16(S): i64 { if (_IR_REC0(S, IR_STORE16) == 1) { return 0; } EB(S, 0x66); E2(S, 0x0189); return 0; }
fn ESTORE32(S): i64 { if (_IR_REC0(S, IR_STORE32) == 1) { return 0; } E2(S, 0x0189); return 0; }
fn ESTORE64(S): i64 { if (_IR_REC0(S, IR_STORE64) == 1) { return 0; } E3(S, 0x018948); return 0; }
fn EXORAA(S): i64 { if (_IR_REC0(S, IR_XOR_AA) == 1) { return 0; } E3(S, 0xC03148); _flags_reflect_rax = 1; return 0; }
# Bitwise
fn EANDR(S): i64 { if (_IR_REC0(S, IR_AND) == 1) { return 0; } _TRY_COMBINE_SHUTTLE(S); E3(S, 0xC82148); _flags_reflect_rax = 1; return 0; }
fn EORR(S): i64 { if (_IR_REC0(S, IR_OR) == 1) { return 0; } _TRY_COMBINE_SHUTTLE(S); E3(S, 0xC80948); _flags_reflect_rax = 1; return 0; }
fn EXORR(S): i64 { if (_IR_REC0(S, IR_XOR) == 1) { return 0; } _TRY_COMBINE_SHUTTLE(S); E3(S, 0xC83148); _flags_reflect_rax = 1; return 0; }
fn ENOTR(S): i64 { if (_IR_REC0(S, IR_NOT) == 1) { return 0; } E3(S, 0xD0F748); return 0; }
fn ESHLCL(S): i64 { if (_IR_REC0(S, IR_SHL) == 1) { return 0; } E3(S, 0xE0D348); _flags_reflect_rax = 0; return 0; }
fn ESHRCL(S): i64 { if (_IR_REC0(S, IR_SHR) == 1) { return 0; } E3(S, 0xE8D348); _flags_reflect_rax = 0; return 0; }
# `>>>` arithmetic shift: sar rax, cl (48 D3 F8). `>>` stays logical (shr). CHANGELOG [6.4.46].
fn EASHRCL(S): i64 { if (_IR_REC0(S, IR_ASHR) == 1) { return 0; } E3(S, 0xF8D348); _flags_reflect_rax = 0; return 0; }
# v5.6.7 O2: shift rax by immediate (1..63). Encoding: 48 C1 E0 imm8
# for shl; 48 C1 E8 imm8 for shr. Used by strength-reduction peephole
# (x * 2^n → shl rax, n and x / 2^n → shr rax, n for unsigned).
# v5.6.8 O2: shift-by-1-or-more sets ZF from result; shift-by-0 is a
# no-op and doesn't modify flags. Callers only pass n>=1, so the
# "set flag" path is always safe. Still clear defensively so an
# accidental n==0 caller doesn't leave a stale 1.
fn ESHLIMM(S, n): i64 { EB(S, 0x48); EB(S, 0xC1); EB(S, 0xE0); EB(S, n & 0x3F); if (n > 0) { _flags_reflect_rax = 1; } return 0; }
# v5.8.56: ESHRIMM removed — sibling of ESHLIMM (heavily used at
# parse_expr.cyr:1141) that never got a call site. Re-add when a
# parser path actually needs `shr rax, imm`.
# Syscall pop helpers
fn EPOPRDI(S): i64 { EB(S, 0x5F); return 0; }
fn EPOPRSI(S): i64 { EB(S, 0x5E); return 0; }
fn EPOPRDX(S): i64 { EB(S, 0x5A); return 0; }
fn EPOPR10(S): i64 { E2(S, 0x5A41); return 0; }
fn EPOPR8(S): i64 { E2(S, 0x5841); return 0; }
fn EPOPR9(S): i64 { E2(S, 0x5941); return 0; }

# RECFIX moved to src/backend/common/runtime.cyr at v6.0.8.

# Check if compiling in object mode (kernel_mode == 3) OR shared mode
# (kernel_mode == 2). Both require PIC-safe addressing: the linker
# resolves data refs in .o files, and the dynamic loader applies a
# random bias when mapping an ET_DYN — absolute `mov rax, imm64`
# baked with a fixed VA can't survive either. Use
# `lea rax, [rip+disp32]` instead.
fn _IS_OBJ(S): i64 {
    var km = L64(S + 0x18FCA0);
    if (km == 3 || km == 2) { return 1; }
    # v6.1.6: any --pie/CYRIUS_PIE build takes the PIC-safe LEA path (a PIE
    # executable the kernel/boot-shim loads at a random base → ASLR/KASLR).
    # Reuses the proven shared/object RIP-relative emit + rel32 fixup math.
    # _pie_mode==0 on every non-PIE build → this branch is dead → byte-
    # identical. See CHANGELOG [6.1.6].
    if (_pie_mode == 1) { return 1; }
    return 0;
}

# Emit rcx = address of variable (object mode: LEA, else: MOV imm64)
fn _EVRCX(S, idx): i64 {
    if (_IS_OBJ(S) == 1) {
        # LEA rcx, [rip+disp32]: 48 8D 0D <rel32>
        EB(S, 0x48); EB(S, 0x8D); EB(S, 0x0D);
        RECFIX(S, idx);
        EDISP32(S, 0);
        return 0;
    }
    E2(S, 0xB948);
    RECFIX(S, idx);
    E8(S, 0);
    return 0;
}

# emit var_store: rcx = &var; mov [rcx], rax + record fixup
fn EVSTORE(S, idx): i64 {
    if (_IR_REC1(S, IR_STORE_GLOBAL, idx) == 1) { return 0; }
    _EVRCX(S, idx);
    ESTOC(S);
    return 0;
}

# emit var_load: rcx = &var; mov rax, [rcx] + record fixup
fn EVLOAD(S, idx): i64 {
    if (_IR_REC1(S, IR_LOAD_GLOBAL, idx) == 1) { return 0; }
    _EVRCX(S, idx);
    ELODC(S);
    return 0;
}

# Width-aware narrow load from [rcx] → rax. Shared byte ladder for EVLOAD_W /
# EFIELD_LOAD_W (R4, v6.4.15): emits the sign/zero-extending mov for width
# -4/-2/-1/1/2/4 (ModRM rm=001) and returns 1 (narrow); width-8 falls to ELODC
# and returns 0. The _flags_reflect_rax bookkeeping stays in the CALLERS —
# EVLOAD_W clears it, EFIELD_LOAD_W deliberately leaves it (load-bearing:
# parse_ctrl reads _flags_reflect_rax before conditional branches).
fn _EMIT_NLOAD_RCX(S, width): i64 {
    if (width < 0 - 2) { EB(S, 0x48); EB(S, 0x63); EB(S, 0x01); return 1; }              # -4: movsxd rax, dword [rcx]
    if (width == 0 - 2) { EB(S, 0x48); EB(S, 0x0F); EB(S, 0xBF); EB(S, 0x01); return 1; } # movsx rax, word [rcx]
    if (width == 0 - 1) { EB(S, 0x48); EB(S, 0x0F); EB(S, 0xBE); EB(S, 0x01); return 1; } # movsx rax, byte [rcx]
    if (width == 1) { EB(S, 0x48); EB(S, 0x0F); EB(S, 0xB6); EB(S, 0x01); return 1; }  # movzx rax, byte [rcx]
    if (width == 2) { EB(S, 0x0F); EB(S, 0xB7); EB(S, 0x01); return 1; }               # movzx eax, word [rcx]
    if (width == 4) { EB(S, 0x8B); EB(S, 0x01); return 1; }                            # mov eax, [rcx]
    ELODC(S);
    return 0;
}

# Width-aware var load: rcx = &var; load_width [rcx] → rax
fn EVLOAD_W(S, idx, width): i64 {
    if (_IR_REC(S, IR_LOAD_GLOBAL, width, idx, 0) == 1) { return 0; }
    _EVRCX(S, idx);   # global address → RCX
    # v6.3.35: RCX-based narrow loads (ModRM rm=001) — the old ELOAD8/16/32 read
    # from [RAX] (garbage here → SIGSEGV on a typed sub-i64 global). Signed widths
    # sign-extend (movsx). A narrow load clobbers flags → clear _flags_reflect_rax.
    if (_EMIT_NLOAD_RCX(S, width) == 1) { _flags_reflect_rax = 0; }
    return 0;
}

# Width-aware var store: rcx = &var; store_width [rcx] ← rax
fn EVSTORE_W(S, idx, width): i64 {
    if (_IR_REC(S, IR_STORE_GLOBAL, width, idx, 0) == 1) { return 0; }
    _EVRCX(S, idx);
    if (width == 1) { ESTORE8(S); return 0; }
    if (width == 2) { ESTORE16(S); return 0; }
    if (width == 4) { ESTORE32(S); return 0; }
    ESTOC(S);
    return 0;
}

# Width-aware local load: load_width [rbp-off] → rax
fn EFLLOAD_W(S, idx, width): i64 {
    if (_IR_REC(S, IR_LOAD_LOCAL, width, idx, 0) == 1) { return 0; }
    var disp = 0 - ((idx + 1) * 8);
    # v4.8.4-alpha6: #regalloc fns reserve [rbp-8] for the saved rbx,
    # so every user-visible local sits 8 bytes deeper in the frame.
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    # v6.3.35: a NEGATIVE width = SIGNED sub-i64 → sign-extend (movsx) rather than the
    # historical zero-extend (movzx). Positive width is unchanged (byte-identical until
    # a caller opts in). Fixes signed i8/i16/i32 reading a stored negative as a huge +.
    if (width < 0) {
        var sw = 0 - width;
        if (sw == 1) { EB(S, 0x48); EB(S, 0x0F); EB(S, 0xBE); EB(S, 0x85); EDISP32(S, disp); return 0; }  # movsx rax, byte [rbp+disp]
        if (sw == 2) { EB(S, 0x48); EB(S, 0x0F); EB(S, 0xBF); EB(S, 0x85); EDISP32(S, disp); return 0; }  # movsx rax, word [rbp+disp]
        if (sw == 4) { EB(S, 0x48); EB(S, 0x63); EB(S, 0x85); EDISP32(S, disp); return 0; }               # movsxd rax, dword [rbp+disp]
    }
    if (width == 1) {
        # movzx rax, byte [rbp+disp]
        EB(S, 0x48); EB(S, 0x0F); EB(S, 0xB6); EB(S, 0x85);
        EDISP32(S, disp);
        return 0;
    }
    if (width == 2) {
        # movzx eax, word [rbp+disp]
        EB(S, 0x0F); EB(S, 0xB7); EB(S, 0x85);
        EDISP32(S, disp);
        return 0;
    }
    if (width == 4) {
        # mov eax, [rbp+disp] (32-bit, zero-extends to rax)
        EB(S, 0x8B); EB(S, 0x85);
        EDISP32(S, disp);
        return 0;
    }
    # Default: 64-bit load
    EFLLOAD(S, idx);
    return 0;
}

# Width-aware local store: rax → store_width [rbp-off]
fn EFLSTORE_W(S, idx, width): i64 {
    if (_IR_REC(S, IR_STORE_LOCAL, width, idx, 0) == 1) { return 0; }
    var disp = 0 - ((idx + 1) * 8);
    # v4.8.4-alpha6: shift past the reserved rbx save slot.
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    if (width == 1) {
        # mov byte [rbp+disp], al
        EB(S, 0x88); EB(S, 0x85);
        EDISP32(S, disp);
        return 0;
    }
    if (width == 2) {
        # mov word [rbp+disp], ax
        EB(S, 0x66); EB(S, 0x89); EB(S, 0x85);
        EDISP32(S, disp);
        return 0;
    }
    if (width == 4) {
        # mov dword [rbp+disp], eax
        EB(S, 0x89); EB(S, 0x85);
        EDISP32(S, disp);
        return 0;
    }
    # Default: 64-bit store
    EFLSTORE(S, idx);
    return 0;
}

# v5.9.40 — sub-byte struct field load (parse_decl.cyr:252).
# Field-base ptr is in rcx (already advanced to the field start
# by callers). Emits movzx rax/movzx eax/mov eax/mov rax by
# width. Pulled out of an inline emit block in parse_decl.cyr
# so the aarch64 + cx backends can sit alongside as peers.
fn EFIELD_LOAD_W(S, width): i64 {
    if (width == 1 || width == 2 || width == 4) { _IR_REC0(S, IR_RAW_EMIT); }
    # Same [rcx] narrow ladder as EVLOAD_W (R4, v6.4.15) — but does NOT touch
    # _flags_reflect_rax (the field-load path must leave it as the caller set it).
    _EMIT_NLOAD_RCX(S, width);
    return 0;
}

# v5.9.40 — struct-by-value return x86 `rep movsb` block
# (parse_fn.cyr:415). Pulled out of an inline emit block so the
# aarch64 + cx backends fire from the same parse call site.
# Caller-saves rsi/rdi (Win64 strict-compliance — both are
# nonvolatile there; SysV is fine without but we save uniformly
# for emit symmetry).
fn ESTRUCT_BYVAL_COPY(S, src_disp, stash_disp, aligned): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0x56);                                    # push rsi
    EB(S, 0x57);                                    # push rdi
    # lea rsi, [rbp + src_disp]
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0xB5);
    var a1 = _codebuf_base + GCP(S);
    S64(a1, (L64(a1) >> 32 << 32) | (src_disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    # mov rdi, [rbp + stash_disp]
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0xBD);
    var a2 = _codebuf_base + GCP(S);
    S64(a2, (L64(a2) >> 32 << 32) | (stash_disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    # mov ecx, imm32   (zero-extends to rcx)
    EB(S, 0xB9);
    EB(S, aligned & 0xFF);
    EB(S, (aligned >> 8) & 0xFF);
    EB(S, (aligned >> 16) & 0xFF);
    EB(S, (aligned >> 24) & 0xFF);
    # v5.11.41 CVE-08 hardening: cld clears DF=0 before rep movsb.
    # SysV ABI requires DF=0 at fn entry, but a signal handler or
    # foreign inline asm could set DF=1; rep movsb with DF=1 copies
    # backward and corrupts memory. Single-byte fix per
    # docs/audit/2026-04-13-security-audit.md § CVE-08.
    EB(S, 0xFC);                # cld
    EB(S, 0xF3); EB(S, 0xA4);   # rep movsb
    EB(S, 0x5F);                                    # pop rdi
    EB(S, 0x5E);                                    # pop rsi
    # mov rax, [rbp + stash_disp]   (rep movsb advanced rdi)
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x85);
    var a3 = _codebuf_base + GCP(S);
    S64(a3, (L64(a3) >> 32 << 32) | (stash_disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# emit var addr: rax = &var (object mode: LEA rax,[rip+disp32], else: MOV rax,imm64)
fn EVADDR(S, idx): i64 {
    if (_IR_REC1(S, IR_LOAD_ADDR_G, idx) == 1) { return 0; }
    if (_IS_OBJ(S) == 1) {
        # LEA rax, [rip+disp32]: 48 8D 05 <rel32>
        EB(S, 0x48); EB(S, 0x8D); EB(S, 0x05);
        RECFIX(S, idx);
        EDISP32(S, 0);
        return 0;
    }
    E2(S, 0xB848);
    RECFIX(S, idx);
    E8(S, 0);
    return 0;
}

# emit string addr: rax = &string (object mode: LEA, else: MOV imm64)
fn ESADDR(S, soff): i64 {
    if (_IR_REC1(S, IR_LOAD_STR, soff) == 1) { return 0; }
    var fc = GFCNT(S);
    if (_IS_OBJ(S) == 1) {
        # LEA rax, [rip+disp32]: 48 8D 05 <rel32>
        EB(S, 0x48); EB(S, 0x8D); EB(S, 0x05);
        var faddr = _fixup_base + fc * 16;
        S64(faddr, GCP(S));
        S64(faddr + 8, (1 << 56) | soff);
        SFCNT(S, fc + 1);
        EDISP32(S, 0);
        return 0;
    }
    E2(S, 0xB848);
    var faddr = _fixup_base + fc * 16;
    S64(faddr, GCP(S));
    S64(faddr + 8, (1 << 56) | soff);
    SFCNT(S, fc + 1);
    E8(S, 0);
    return 0;
}

# emit syscall pops for N args then syscall
fn ESCPOPS(S, n): i64 {
    var _ire = IR_ENABLED(S); if (_ire >= 1) { ir_emit1(S, IR_CALL_POPS, n); }
    if (n >= 7) { EPOPR9(S); }
    if (n >= 6) { EPOPR8(S); }
    if (n >= 5) { EPOPR10(S); }
    if (n >= 4) { EPOPRDX(S); }
    if (n >= 3) { EPOPRSI(S); }
    if (n >= 2) { EPOPRDI(S); }
    if (n >= 1) { EPOPR(S); }
    ESYSCALL(S);
    return 0;
}

# Output-target flags (_TARGET_MACHO / _TARGET_PE / _TARGET_AGNOS /
# _TARGET_ELF64_KERNEL / _TARGET_EFI_APPLICATION / _TARGET_CX) moved to
# src/backend/common/runtime.cyr at v6.1.4 — included before this file so
# they're declared once for both x86 + aarch64 (cx keeps its own copy).
# Set from CYRIUS_* env vars in the main_*.cyr entry points after includes.

# v6.0.71 — force-16-aligned `callptr` call for PE/Win64 (issue 2026-06-05-
# windows-com-vtable-real-callee-frame-corruption.md). REPLACES the generic
# ECALLPOPS+ECALLIND+ECALLCLEAN trio at a callptr site under _TARGET_PE.
#
# WHY: cyrius's PE call chain runs at a CONSTANT body alignment that lands
# every callee at entry rsp ≡ 0, NOT the Win64-ABI-required ≡ 8 (Windows
# enters the EXE at rsp ≡ 8 and cyrius never re-aligns). cyrius-emitted code
# never uses SSE so the misalignment is harmless; the kernel32 IAT reroutes
# mask it with their own `push rbx; and rsp,-16` anchor; but `callptr` exists
# precisely to invoke REAL Win64 callees (COM vtable methods), whose aligned
# `movaps` SSE spill #GP-faults (AV 0xC0000005) or corrupts the caller frame
# when entered at ≡ 0. Seeding alignment at the entry instead (an earlier
# attempt) destabilised the top-level-only cycc compiler itself, so the fix
# is local to the callptr site — the same proven anchor the reroutes use,
# robust to ANY caller body alignment (main or top-level reaches it).
#
# Args are already pushed (a1..aN, aN on top). Marshal them into the Win64
# arg registers, THEN `push rbx; mov rbx,rsp; and rsp,-16` (16-align,
# rbx-anchored for exact restore), shadow/stack-arg sub, `call [rbp+disp]`
# (the callee spill slot is rbp-relative — survives every rsp move), then
# `mov rsp,rbx; pop rbx`. The callee is entered at rsp ≡ 8 → its SSE spills
# are aligned. disp mirrors EFLLOAD_W / ECALLIND.
# v6.0.86: the callee arrives on the STACK (pushed FIRST by the parser, so it
# sits BELOW all the args), NOT in a frame slot. v6.0.70 spilled it to a GFLC
# frame slot (`call [rbp+disp]`), but that slot could ALIAS a `&`-taken local
# (cdb on cass: a COM out-param `&pAdapter` and the callee-spill both landed at
# rbp-0x50 → EnumAdapters1's out-param fought the spilled callee → frame/regalloc
# corruption → AV in the GetDesc1 dispatch). Popping the callee into rax (a
# volatile scratch, consumed immediately by `call rax`) removes the frame slot
# entirely, so no local can collide. cycc has no callptr → self-host unaffected.
fn ECALLPTR_PE(S, n): i64 {
    if (n <= 4) {
        var i = n - 1;
        while (i >= 0) { EPOPARG(S, i); i = i - 1; }       # a1→rcx, a2→rdx, a3→r8, a4→r9 (args were on top)
        EB(S, 0x58);                                        # pop rax (callee — now top, pushed first/below args)
        EB(S, 0x53);                                        # push rbx
        EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp (anchor)
        EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
        EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20); # sub rsp, 0x20 (shadow)
        EB(S, 0xFF); EB(S, 0xD0);                           # call rax
        EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx (restore)
        EB(S, 0x5B);                                        # pop rbx
        _flags_reflect_rax = 0;
        return 0;
    }
    # n > 4 (v6.4.43 FIX): read the 4 reg args + the callee by STACK OFFSET into
    # rcx/rdx/r8/r9 + r11, and copy each stack-arg through the VOLATILE r10 only — the
    # caller's NON-volatile r12/r14/r15 are NEVER touched. The old form popped extras
    # into r12/r14/r15, clobbering a caller-live value the regalloc had placed there
    # (an open socket → downstream WSAENOTSOCK); this >4 path had NEVER been exercised
    # until ConnectEx (7-arg) hit it. Stack (top→bottom): [a_{n-1}]..[a4] a3 a2 a1 a0
    # callee. rax = args base throughout; args + callee dropped with one `add rsp` at
    # the end (net-equivalent to the old pops). See CHANGELOG [6.4.43].
    var nextra = n - 4;
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE0);                            # mov rax, rsp (args base)
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x48); EB(S, (nextra + 3) * 8);   # mov rcx, [rax+..] (a0)
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x50); EB(S, (nextra + 2) * 8);   # mov rdx, [rax+..] (a1)
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x40); EB(S, (nextra + 1) * 8);   # mov r8,  [rax+..] (a2)
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x48); EB(S, nextra * 8);         # mov r9,  [rax+..] (a3)
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x58); EB(S, (nextra + 4) * 8);   # mov r11, [rax+..] (callee)
    EB(S, 0x53);                                                     # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);                           # mov rbx, rsp (anchor)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0);              # and rsp, -16
    var framesize = 32 + nextra * 8;
    if ((framesize & 15) != 0) { framesize = framesize + 8; }
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, framesize);         # sub rsp, framesize
    var j = 0;
    while (j < nextra) {
        EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, (nextra - 1 - j) * 8);      # mov r10, [rax+..]
        EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x20 + j * 8); # mov [rsp+..], r10
        j = j + 1;
    }
    EB(S, 0x41); EB(S, 0xFF); EB(S, 0xD3);                           # call r11 (callee)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);                           # mov rsp, rbx (restore)
    EB(S, 0x5B);                                                     # pop rbx
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, (n + 1) * 8);       # add rsp, (n+1)*8 (drop args + callee)
    _flags_reflect_rax = 0;
    return 0;
}

# emit exit epilogue: mov rdi, rax; mov rax, <exit_nr>; syscall
fn EEXIT(S): i64 {
    if (_TARGET_PE == 1) {
        if (_TARGET_EFI_APPLICATION == 1) {
            # v5.11.47: UEFI Application exit. UEFI firmware calls
            # AddressOfEntryPoint as a regular MS x64 fn — the entry
            # returns to firmware via plain `ret`, with rax holding
            # the EFI_STATUS code (expression result is already there).
            # No ExitProcess / kernel32 / IAT lookup — UEFI has no
            # kernel32. Single 0xC3 byte; firmware unwinds the stack
            # frame it set up before calling our entry.
            EB(S, 0xC3);
            return 0;
        }
        # Win64 ExitProcess call. Exit code is already in rax
        # (expression result). Sequence (13 bytes total):
        #   89 C1                 mov ecx, eax              arg1 = exit code
        #   48 83 EC 28           sub rsp, 0x28             32 B shadow + 8 B align
        #   FF 15 <disp32>        call [rip+ExitProcess]    IAT-dispatched
        #   CC                    int3                      unreachable
        # FIXUP later patches disp32 = IAT_RVA - (text_rva + coff + 4)
        # where coff is the 4-byte disp32 position (imp_idx=0 → ExitProcess).
        EB(S, 0x89); EB(S, 0xC1);
        EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x28);
        EB(S, 0xFF); EB(S, 0x15);
        _pe_iat_fixup_add(S, GCP(S), 0);
        EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
        EB(S, 0xCC);
        return 0;
    }
    EMOVRDI(S);
    if (_TARGET_MACHO == 1) { EMOVI(S, 0x2000001); }
    elif (_TARGET_AGNOS == 1) { EMOVI(S, 0); }   # agnos exit = syscall 0 (not Linux 60)
    else { EMOVI(S, 60); }
    ESYSCALL(S);
    return 0;
}

# v6.0.41: x86_64 Darwin BSD syscall translation — the x86 analog of the
# arm64 ESYSXLAT (v6.0.34). On Mach-O, `cycc`'s syscalls carry Linux
# numbers (the compiler's Sys enum is x86-Linux), but Darwin uses BSD
# numbers with the Unix-class flag 0x2000000 in rax. Emitted inline right
# before the `syscall` instruction (see ESYSCALL) when _TARGET_MACHO==1.
# Args already match — Darwin x86_64 passes rdi/rsi/rdx/r10/r8/r9 exactly
# like Linux, so ESCPOPS needs no change; only the number is rewritten.
# Without this the x86 Mach-O cycc ran trivial programs (exit path was
# pre-classed in EEXIT) but SIGSYS'd on any real compile (read/mmap/write
# hit untranslated numbers). See issue 2026-06-02-macos-x86-release-no-compiler.
#
# Each entry: cmp rax,<lin>; jne +7; mov rax,<0x2000000|bsd>. If rax holds
# the Linux number it is rewritten and subsequent cmps (now rax≈0x2000xxx)
# never match; otherwise it falls through unchanged (e.g. EEXIT's already-
# classed 0x2000001 skips the whole chain).
fn _msx(S, lin, classed): i64 {
    if (lin >= 128) { return _msx32(S, lin, classed); }   # >127 sets imm8 bit 7 -> sign-extends to negative; route to the imm32 form (cf. getdents64 217, getrandom 318). CHANGELOG [6.4.15] L2
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xF8); EB(S, lin);    # cmp rax, lin (imm8)
    EB(S, 0x75); EB(S, 0x07);                             # jne +7 (skip the mov)
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0xC0);                # mov rax, imm32:
    EB(S, classed & 0xFF); EB(S, (classed >> 8) & 0xFF);
    EB(S, (classed >> 16) & 0xFF); EB(S, (classed >> 24) & 0xFF);
    return 0;
}
# Like _msx but with a 32-bit `cmp rax, imm32` for Linux syscall numbers
# > 255 (getrandom is 318 — the imm8 cmp in _msx can't reach it). v6.0.75.
fn _msx32(S, lin, classed): i64 {
    EB(S, 0x48); EB(S, 0x3D);                            # cmp rax, imm32 (REX.W 3D)
    EB(S, lin & 0xFF); EB(S, (lin >> 8) & 0xFF);
    EB(S, (lin >> 16) & 0xFF); EB(S, (lin >> 24) & 0xFF);
    EB(S, 0x75); EB(S, 0x07);                            # jne +7 (skip the mov)
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0xC0);               # mov rax, imm32:
    EB(S, classed & 0xFF); EB(S, (classed >> 8) & 0xFF);
    EB(S, (classed >> 16) & 0xFF); EB(S, (classed >> 24) & 0xFF);
    return 0;
}
fn EMACHO_SYSXLAT(S): i64 {
    _msx(S, 0,  0x2000003);   # read     0  → 3
    _msx(S, 1,  0x2000004);   # write    1  → 4
    _msx(S, 2,  0x2000005);   # open     2  → 5
    _msx(S, 3,  0x2000006);   # close    3  → 6
    _msx(S, 4,  0x20000BC);   # stat     4  → 188
    _msx(S, 5,  0x20000BD);   # fstat    5  → 189
    _msx(S, 8,  0x20000C7);   # lseek    8  → 199
    _msx(S, 9,  0x20000C5);   # mmap     9  → 197
    _msx(S, 10, 0x200004A);   # mprotect 10 → 74
    _msx(S, 11, 0x2000049);   # munmap   11 → 73
    _msx(S, 21, 0x2000021);   # access   21 → 33
    _msx(S, 39, 0x2000014);   # getpid   39 → 20
    _msx(S, 110, 0x2000027);  # getppid  110 → 39  (v6.3.44: Linux 110 was untranslated → ran BSD 110, wrong)
    _msx(S, 59, 0x200003B);   # execve   59 → 59
    _msx(S, 60, 0x2000001);   # exit     60 → 1
    _msx(S, 61, 0x2000007);   # wait4    61 → 7
    _msx(S, 72, 0x200005C);   # fcntl    72 → 92
    _msx(S, 77, 0x20000C9);   # ftruncate 77 → 201
    _msx(S, 82, 0x2000080);   # rename   82 → 128
    _msx(S, 74, 0x200005F);   # fsync    74 → BSD 95 (v6.4.57 xfsync durability half of file_write_atomic)
    _msx(S, 83, 0x2000088);   # mkdir    83 → 136
    _msx(S, 84, 0x2000089);   # rmdir    84 → 137
    _msx(S, 87, 0x200000A);   # unlink   87 → 10
    _msx(S, 88, 0x2000039);   # symlink  88 → 57
    _msx(S, 89, 0x200003A);   # readlink 89 → 58
    _msx(S, 90, 0x200000F);   # chmod    90 → 15
    # v6.0.58: process family for the cyrius wrapper's fork-exec (cbt/build.cyr).
    # dup2 needs translating (Linux 33 == BSD `access`!). fork + pipe also get a
    # post-syscall fixup in ESYSCALL (rax:rdx multi-return) — see EMACHO_PROC_FIXUP.
    _msx(S, 33, 0x200005A);   # dup2     33 → 90
    _msx(S, 22, 0x200002A);   # pipe     22 → 42
    _msx(S, 57, 0x2000002);   # fork     57 → 2
    # v6.0.59: net.cyr socket surface (parity with arm64 ESYSXLAT — cross-arch).
    _msx(S, 41, 0x2000061);   # socket     41 → 97
    _msx(S, 42, 0x2000062);   # connect    42 → 98
    _msx(S, 43, 0x200001E);   # accept     43 → 30
    _msx(S, 48, 0x2000086);   # shutdown   48 → 134
    _msx(S, 49, 0x2000068);   # bind       49 → 104
    _msx(S, 50, 0x200006A);   # listen     50 → 106
    _msx(S, 54, 0x2000069);   # setsockopt 54 → 105
    _msx(S, 55, 0x2000076);   # getsockopt 55 → 118
    # v6.0.84: socketpair was the last untranslated socket syscall (cross-arch
    # parity with the arm64 ESYSXLAT). The fork+socketpair TLS e2e ran the Linux
    # number on Darwin → garbage fds → TLS_ERR_IO. See aarch64/emit.cyr.
    _msx(S, 53, 0x2000087);   # socketpair 53 → 135
    _msx(S, 13, 0x200002E);   # rt_sigaction 13 → sigaction 46 (v6.4.51 signal_ignore(SIGPIPE); BSD-classed 0x2000000|46)
    _msx(S, 7,  0x20000E6);   # poll        7 → 230
    # v6.0.60: dir enumeration — getdents64 217 → getdirentries64 344 (0x158).
    # fs.cyr passes the 4th basep out-param (Linux ignores it). Parity w/ arm64.
    # MUST use _msx32: 217 > 127, so the `cmp rax, imm8` in _msx sign-extends
    # 0xD9 → -39 and the translation never fires (raw 217 → SIGSYS on Darwin,
    # silent broken dir-listing — self-host-blind, "found by ports" class).
    _msx32(S, 217, 0x2000158);  # getdents64 217 → getdirentries64 344
    # v6.0.75: getrandom 318 → Darwin getentropy 500 (cross-arch parity with
    # the aarch64 ESYSXLAT). 318 > 255 → needs the imm32 cmp (_msx32). The
    # 0-on-success → byte-count return is normalized in sys_getrandom (stdlib),
    # so no x86 post-syscall fixup is needed.
    _msx32(S, 318, 0x20001F4);  # getrandom 318 → getentropy 500
    return 0;
}

# v5.5.13 x86 stub: the `_TARGET_MACHO == 2` branch in parse.cyr that
# calls EMACHO_EXIT_ARM is unreachable on the x86 compiler — fixup.cyr
# hard-errors on CYRIUS_MACHO_ARM=1 against cycc before the parser gets
# here. This stub exists purely to resolve the symbol at link time so
# parse.cyr can be built for both backends. If this ever emits bytes,
# something routed a Mach-O arm64 build through the x86 backend.
fn EMACHO_EXIT_ARM(S): i64 {
    return 0;
}

# v5.5.14 x86 stubs for EMACHO_WRITE_ARM / EMACHO_READ_ARM. Same story
# as EMACHO_EXIT_ARM — unreachable on x86 but must link on both backends
# so shared parse.cyr stays arch-portable.
fn EMACHO_WRITE_ARM(S): i64 {
    return 0;
}

fn EMACHO_READ_ARM(S): i64 {
    return 0;
}

# v5.6.6 x86 stub for EMACHO_CLOCK_ARM. Statically dead on x86 (the
# _TARGET_MACHO == 2 branch in parse_expr.cyr is arm64-only). Must
# link to keep shared parse.cyr arch-portable.
fn EMACHO_CLOCK_ARM(S): i64 {
    return 0;
}

# emit Win64 write epilogue: consume stack args pushed by the
# generic syscall-argument loop for `syscall(1, fd, buf, len)` and
# reroute to `GetStdHandle(fd) + WriteFile(hFile, buf, len, &n, 0)`.
# Result in rax (bytes written, or 0 on error). No Linux `0F 05`
# emitted — the parser's `_TARGET_PE && sc_num == 1` branch calls
# this and returns before falling into `ESCPOPS`.
#
# Stack layout on entry (top→bottom): [len] [buf] [fd] [sc_nr=1].
#
# Local frame layout (after `sub rsp, 0x40`):
#   [rsp+0x00..0x1F]  shadow space for both calls (32 B, Win64 ABI)
#   [rsp+0x20]        lpOverlapped slot (5th WriteFile arg, = 0)
#   [rsp+0x28]        scratch DWORD for lpBytesWritten (r9 target)
#   [rsp+0x30]        saved `buf` (rdx) across GetStdHandle call
#   [rsp+0x38]        saved `len` (r8)  across GetStdHandle call
# 0x40 bytes keeps RSP 16-aligned at each `call` site (caller's RSP
# was 8-mod-16 entering this fn because of the implicit return
# address on the stack — same guarantee EEXIT relies on).

# v6.4.26 (R2): fd → Win32 HANDLE prologue, shared by EWRITE_PE + EREAD_PE.
# Input: rax = fd. Output: rcx = HANDLE. fd {0,1,2} → GetStdHandle({-10,-11,-12});
# ANY other fd is a real CreateFileW handle used DIRECTLY (UNSIGNED compare — real
# handles can have the high bit set; GetStdHandle(realHandle) returns garbage).
# EWRITE_PE and EREAD_PE hand-duplicated this block — the exact repeat-fix hazard
# the v6.2.43 VR-01 fix hit (it had to re-apply the fd>2 direct-handle path to
# EWRITE_PE after EREAD_PE already had it). Extracted per
# 2026-07-07-v6415-closeout-residuals.md (R2). NOTE: collapsing the two sites to
# this one canonical sequence changes EWRITE_PE's emitted bytes (its old form left
# hFile in rax + a trailing `mov rcx,rax`); EREAD_PE is byte-identical. Verified on
# cass (self-host reads source via EREAD_PE + writes the PE via EWRITE_PE).
fn _pe_fd_to_handle_rcx(S, gsh_idx): i64 {
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xF8); EB(S, 0x02); # cmp rax, 2
    EB(S, 0x77); EB(S, 0x15);                           # ja +0x15 → .direct (skip std block)
    EB(S, 0x48); EB(S, 0xF7); EB(S, 0xD8);              # neg rax
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE8); EB(S, 0x0A); # sub rax, 10
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (nStdHandle)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+GetStdHandle]
    _pe_iat_fixup_add(S, GCP(S), gsh_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (std handle → rcx)
    EB(S, 0xEB); EB(S, 0x03);                           # jmp +3 → .ready
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # .direct: mov rcx, rax (fd IS the handle)
    return 0;                                            # .ready: rcx = HANDLE
}
fn EWRITE_PE(S): i64 {
    _pe_ensure_stdio(S);
    var gsh_idx = _pe_stdio_getstd_get();
    var wf_idx  = _pe_stdio_writef_get();

    # Pop args off the expr stack into Win64 ABI registers.
    EB(S, 0x58);                                   # pop rax (len)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC0);         # mov r8, rax
    EB(S, 0x58);                                   # pop rax (buf)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);         # mov rdx, rax
    EB(S, 0x58);                                   # pop rax (fd)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    # Allocate 64 B frame and stash buf/len BEFORE any call clobbers rdx/r8.
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x40); # sub rsp, 0x40
    EB(S, 0x48); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x30); # mov [rsp+0x30], rdx (buf)
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x44); EB(S, 0x24); EB(S, 0x38); # mov [rsp+0x38], r8 (len)

    # v6.3.43 (VR-01): the fd may be a real CreateFileW handle (>2), not a std
    # stream. fd 0/1/2 → GetStdHandle; fd>2 → use the handle directly. The block is
    # now the shared _pe_fd_to_handle_rcx helper (v6.4.26 R2) — it leaves the HANDLE
    # in rcx (WriteFile's hFile arg). Before this, EWRITE_PE always neg/sub'd the fd
    # into a std-handle index, so sys_write to a file wrote to a bogus handle and
    # failed (found by vr01 on cass).
    _pe_fd_to_handle_rcx(S, gsh_idx);              # rcx = HANDLE (std or direct)
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x54); EB(S, 0x24); EB(S, 0x30); # mov rdx, [rsp+0x30]
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x44); EB(S, 0x24); EB(S, 0x38); # mov r8, [rsp+0x38]
    EB(S, 0x4C); EB(S, 0x8D); EB(S, 0x4C); EB(S, 0x24); EB(S, 0x28); # lea r9, [rsp+0x28]
    # 5th arg: lpOverlapped = 0 at [rsp+0x20].
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0x44); EB(S, 0x24); EB(S, 0x20);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    # call [rip+WriteFile]
    EB(S, 0xFF); EB(S, 0x15);
    _pe_iat_fixup_add(S, GCP(S), wf_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    # v5.5.10: return the bytes-written count (not WriteFile's BOOL
    # success flag). Without this, the caller's
    # `written += syscall_result` loop sees `w=1` each iteration
    # and writes `olen*(olen+1)/2` bytes total — the 1.18 MB bloat
    # for a 1.5 KB output. Mirrors EREAD_PE's post-call fixup.
    # v5.6.31: switched to `mov eax, [rsp+0x28]` (32-bit load,
    # auto-zero-extends rax) for the same reason as EREAD_PE —
    # `lpNumberOfBytesWritten` writes only a DWORD; under
    # HIGH_ENTROPY_VA the upper 4 bytes of the qword slot carry
    # stack garbage and the 64-bit load returned a huge bogus
    # count, breaking every PE caller's write loop. See EREAD_PE
    # comment for full diagnosis.
    EB(S, 0x8B); EB(S, 0x44); EB(S, 0x24); EB(S, 0x28); # mov eax, [rsp+0x28]
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x40); # add rsp, 0x40
    return 0;
}

# ================================================================
# v5.5.1 — remaining kernel32 syscall reroutes (Read / Close /
# Seek / Map / Open). Each mirrors EWRITE_PE's shape: pop args off
# the expr stack into Win64 ABI registers, allocate a 16-aligned
# frame with 32 B shadow, IAT-call through an auto-registered
# import, unwind the frame. The parser's _TARGET_PE dispatch in
# parse.cyr calls the appropriate helper and returns before falling
# into ESCPOPS (which would emit the Linux-only `0F 05`).
# ================================================================

# emit Win64 close: `syscall(3, fd)` → CloseHandle(fd).
# Stack on entry (top→bottom): [fd] [sc_nr=3]. Return in rax is
# the BOOL from CloseHandle (1 = success, 0 = failure) — callers
# coding to `sys_close` semantics should treat non-zero as success.
# v6.4.44: routed through the rbx-anchored dynamic-align helper (was a fixed `sub rsp,0x28`
# that only aligned the call when the caller's rsp landed on the right parity). CloseHandle
# faults on an aligned SSE access inside kernel32 when the stack is 8-misaligned — the async
# subprocess resume (deep call stack) hit exactly that. See CHANGELOG [6.4.44].
fn ECLOSE_PE(S): i64 {
    _pe_ensure_closeh(S);
    return _pe_srw_call_1arg(S, _pe_closeh_get());
}

# v6.0.51: Windows process-creation reroutes (the ai-hwaccel spawn arc).
# Each mirrors ECLOSE_PE's frame shape: pop args (top→bottom = last→first)
# off the expr stack into Win64 ABI regs (rcx/rdx/r8/r9 + stack for 5+),
# drop the sc_nr, sub rsp 0x28 (32 B shadow + 8 align — same net rsp offset
# from pre-push as ECLOSE_PE), `FF 15` IAT-call the auto-registered import,
# unwind. process_win.cyr drives these via syscall(0xF00N, ...). See
# lib/process_win.cyr + issue 2026-06-03-windows-pe-syscall-surface.

# syscall(0xF001, handle, timeout) → WaitForSingleObject(handle, timeout).
# Stack on entry (top→bottom): [timeout] [handle] [sc_nr]. Ret in rax = the
# DWORD wait result (0 = WAIT_OBJECT_0).
# v6.4.44: routed through the rbx-anchored 2-arg aligned helper (was a fixed `sub rsp,0x28`).
fn EWAIT_PE(S): i64 {
    _pe_ensure_waitobj(S);
    return _pe_call_2arg_aligned(S, _pe_waitobj_get());
}

# syscall(0xF002, handle, &exitcode) → GetExitCodeProcess(handle, &code).
# Stack (top→bottom): [&exitcode] [handle] [sc_nr]. Ret rax = BOOL.
# v6.4.44: routed through the rbx-anchored 2-arg aligned helper (was a fixed `sub rsp,0x28`).
fn EGETEXIT_PE(S): i64 {
    _pe_ensure_getexit(S);
    return _pe_call_2arg_aligned(S, _pe_getexit_get());
}

# syscall(0xF003, handle, mask, flags) →
# SetHandleInformation(handle, mask, flags). Used to clear
# HANDLE_FLAG_INHERIT on the parent ends of the stdio pipes.
# Stack (top→bottom): [flags] [mask] [handle] [sc_nr]. Ret rax = BOOL.
# v6.4.44: routed through the rbx-anchored 3-arg aligned helper (was a fixed `sub rsp,0x28`).
fn ESETHANDLE_PE(S): i64 {
    _pe_ensure_sethandle(S);
    return _pe_call_3arg_aligned(S, _pe_sethandle_get());
}

# syscall(0xF004, &rd, &wr, &sa, size) →
# CreatePipe(&hReadPipe, &hWritePipe, &saAttributes, nSize).
# Stack (top→bottom): [size] [&sa] [&wr] [&rd] [sc_nr]. Ret rax = BOOL.
# v6.4.44: routed through the rbx-anchored 4-arg aligned helper (was a fixed `sub rsp,0x28`).
fn ECREATEPIPE_PE(S): i64 {
    _pe_ensure_createpipe(S);
    return _pe_call_4arg_aligned(S, _pe_createpipe_get());
}

# syscall(0xF005, &args) → CreateProcessW(...10 args from *args...).
# CreateProcessW has 10 params — past the syscall(n, ≤6) form AND
# fncall8 — so process_win.cyr packs them into a 10-qword struct and
# passes its address. Layout (i64 each): [0]lpApplicationName
# [8]lpCommandLine [16]lpProcessAttributes [24]lpThreadAttributes
# [32]bInheritHandles [40]dwCreationFlags [48]lpEnvironment
# [56]lpCurrentDirectory [64]lpStartupInfo [72]lpProcessInformation.
# a1-a4 → rcx/rdx/r8/r9; a5-a10 → [rsp+0x20..0x48]. Frame 0x50 (32 B
# shadow + 48 B for the 6 stack args) keeps rsp 16-aligned at the call
# (the expr stack is 16-aligned at the syscall boundary; see EWRITE_PE).
# Stack (top→bottom): [&args] [sc_nr]. Ret rax = BOOL.
fn ECREATEPROC_PE(S): i64 {
    _pe_ensure_createproc(S);
    var idx = _pe_createproc_get();
    EB(S, 0x58);                                        # pop rax (&args base)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    # Force 16-byte rsp alignment for the call: CreateProcessW's internal SSE
    # string ops fault on a misaligned stack, and the syscall-site rsp alignment
    # is NOT guaranteed (the ≤4-arg reroutes tolerate a misalign this 10-arg call
    # does not — verified on cass: CreatePipe ran, CreateProcessW faulted). Save
    # the live rsp in callee-saved rbx (preserved across the Win64 call), align
    # down, then carve the 0x50 frame (32 B shadow + 6 stack args). rax (&args)
    # is an absolute pointer, unaffected by the rsp shuffle.
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x50); # sub rsp, 0x50
    # a1-a4 → registers.
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x48); EB(S, 0x00); # mov rcx, [rax+0]
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x08); # mov rdx, [rax+8]
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x40); EB(S, 0x10); # mov r8,  [rax+16]
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x48); EB(S, 0x18); # mov r9,  [rax+24]
    # a5-a10 → [rsp+0x20 .. rsp+0x48] via r10.
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x20); # mov r10, [rax+32]
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x20); # mov [rsp+0x20], r10
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x28); # mov r10, [rax+40]
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x28); # mov [rsp+0x28], r10
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x30); # mov r10, [rax+48]
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x30); # mov [rsp+0x30], r10
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x38); # mov r10, [rax+56]
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x38); # mov [rsp+0x38], r10
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x40); # mov r10, [rax+64]
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x40); # mov [rsp+0x40], r10
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x48); # mov r10, [rax+72]
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x48); # mov [rsp+0x48], r10
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx (undo align + frame)
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# emit Win64 read epilogue: `syscall(0, fd, buf, len)` →
# `GetStdHandle(fd) + ReadFile(hFile, buf, len, &n, 0)`. Stack on
# entry (top→bottom): [len] [buf] [fd] [sc_nr=0]. Mirrors
# EWRITE_PE's 0x40 frame layout — the GetStdHandle call clobbers
# rdx/r8/r9 so we stash `buf` and `len` in the frame first.
fn EREAD_PE(S): i64 {
    _pe_ensure_readf(S);
    var gsh_idx = _pe_stdio_getstd_get();
    var rf_idx  = _pe_readf_get();

    EB(S, 0x58);                                   # pop rax (len)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC0);         # mov r8, rax
    EB(S, 0x58);                                   # pop rax (buf)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);         # mov rdx, rax
    EB(S, 0x58);                                   # pop rax (fd / handle)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    # 64 B frame + stash buf/len across the (possible) GetStdHandle call.
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x40); # sub rsp, 0x40
    EB(S, 0x48); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x30); # mov [rsp+0x30], rdx (buf)
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x44); EB(S, 0x24); EB(S, 0x38); # mov [rsp+0x38], r8 (len)

    # v6.0.45: resolve the Win32 HANDLE into rcx. fd {0,1,2} are the std streams
    # (map to nStdHandle {-10,-11,-12} via GetStdHandle); ANY other fd is a real
    # handle returned by CreateFileW (the `include` file reads) and must be used
    # DIRECTLY — GetStdHandle(realHandle) returns garbage, which made every
    # include READFILE return 0 (the Windows self-host bug: zero includes
    # expanded → 'undefined variable _TARGET_MACHO'). v6.4.26 (R2): now the shared
    # _pe_fd_to_handle_rcx helper (byte-identical to this site's prior emission).
    _pe_fd_to_handle_rcx(S, gsh_idx);
    # rcx = handle; reload ReadFile args.
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x54); EB(S, 0x24); EB(S, 0x30); # mov rdx, [rsp+0x30]
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x44); EB(S, 0x24); EB(S, 0x38); # mov r8, [rsp+0x38]
    EB(S, 0x4C); EB(S, 0x8D); EB(S, 0x4C); EB(S, 0x24); EB(S, 0x28); # lea r9, [rsp+0x28] (lpNumberOfBytesRead)
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0x44); EB(S, 0x24); EB(S, 0x20); # mov qword [rsp+0x20], 0 (lpOverlapped)
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    EB(S, 0xFF); EB(S, 0x15);                      # call [rip+ReadFile]
    _pe_iat_fixup_add(S, GCP(S), rf_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    # Return the bytes-read count (not the BOOL success flag).
    # v5.6.31: was `mov rax, [rsp+0x28]` (64-bit load). ReadFile's
    # `lpNumberOfBytesRead` writes only a DWORD (4 bytes) at the
    # pointed location, so the upper 4 bytes of the qword slot are
    # whatever was on the stack. Under DYNAMIC_BASE those bytes
    # happened to be zero and nobody noticed. Under HIGH_ENTROPY_VA
    # the Win11 loader randomises stack differently and the upper
    # bytes carry garbage — cycc_win.exe's main read loop then saw
    # `n = 0x29233B9948A` on a 74-byte stdin and tripped the
    # "input exceeds 512KB buffer" overflow check at main.cyr:341.
    # `mov eax, [rsp+0x28]` (4-byte opcode) implicitly zero-extends
    # rax on x86_64, so the upper 4 bytes are guaranteed zero
    # regardless of stack state. One byte shorter than the 64-bit
    # form, too.
    EB(S, 0x8B); EB(S, 0x44); EB(S, 0x24); EB(S, 0x28); # mov eax, [rsp+0x28]
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x40); # add rsp, 0x40
    return 0;
}

# v5.6.6: emit Win64 GetTickCount64 call for CYRIUS_PROF
# profiling. `syscall(228, a, b)` on PE → GetTickCount64() with the
# 2 cyrius-side args discarded (GetTickCount64 takes no args).
# Returns u64 ms in rax; the cyrius caller multiplies by 1_000_000
# in _prof_clock_ns to match the ns convention.
# Stack on entry (top→bottom): [b] [a] [sc_nr=228] — argc=3.
# Frame: 0x28 (32 B shadow + 8 B align) at each call site.
# v6.4.44: drop the 2 dummy args, then the rbx-anchored 0-arg aligned helper drops the sc_nr
# and dynamically 16-aligns the call (was a fixed `sub rsp,0x28`).
fn EGETTICKS_PE(S): i64 {
    _pe_ensure_gettick(S);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x10); # add rsp, 0x10 (drop 2 dummy args)
    return _pe_call_0arg_aligned(S, _pe_gettick_get()); # drops sc_nr, aligns, calls GetTickCount64
}

# v6.0.54: emit Win64 GetCommandLineW call. `syscall(0xF006)` on PE →
# GetCommandLineW() — 0 args, returns the process command-line LPWSTR
# (UTF-16LE, NUL-terminated, kernel-owned/process-static) in rax,
# returned to the cyrius caller as-is (lib/args_win.cyr down-converts).
# Stack on entry: [sc_nr=0xF006] (argc=1). `add rsp,8` drops the sc_nr
# slot; `sub rsp,0x28` opens the Win64 frame (32-byte shadow + 8 pad).
# Net delta entry→CALL is `sub rsp,0x20` (32 B, a multiple of 16) — so the
# CALL keeps whatever 16-alignment the site entered with. Same leaf shape
# as EGETTICKS_PE (pure pointer return, no path-API alignment trap).
# Verified on real Windows: cycc_win self-hosts + --version + argv all OK.
# v6.4.44: routed through the rbx-anchored 0-arg aligned helper (was a fixed `sub rsp,0x28`).
fn EGETCMDLINE_PE(S): i64 {
    _pe_ensure_getcmdline(S);
    return _pe_call_0arg_aligned(S, _pe_getcmdline_get());
}

# v6.0.61: real Windows threading reroutes (lib/thread_win.cyr).
# syscall(0xF007, &args6) → CreateThread(lpThreadAttributes, dwStackSize,
# lpStartAddress, lpParameter, dwCreationFlags, lpThreadId). 6 params — packed
# into a 6-qword struct + passed by address (same as ECREATEPROC_PE). a1-a4 →
# rcx/rdx/r8/r9; a5-a6 → [rsp+0x20],[rsp+0x28]; rbx-anchored 16-aligned 0x40
# frame (32 shadow + 16 for the 2 stack args). Ret rax = thread HANDLE. The
# cyrius thread-body fn is a valid MS-x64 ThreadProc directly (PE arg0 == RCX ==
# lpParameter), so no trampoline. Struct (i64 each): [0]attrs [8]stacksize
# [16]startaddr [24]param [32]flags [40]threadid.
fn ECREATETHREAD_PE(S): i64 {
    _pe_ensure_createthread(S);
    var idx = _pe_createthread_get();
    EB(S, 0x58);                                        # pop rax (&args base)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x40); # sub rsp, 0x40
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x48); EB(S, 0x00); # mov rcx, [rax+0]  (attrs)
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x08); # mov rdx, [rax+8]  (stacksize)
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x40); EB(S, 0x10); # mov r8,  [rax+16] (startaddr)
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x48); EB(S, 0x18); # mov r9,  [rax+24] (param)
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x20); # mov r10, [rax+32] (flags)
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x20); # mov [rsp+0x20], r10
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, 0x28); # mov r10, [rax+40] (threadid)
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x28); # mov [rsp+0x28], r10
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# 1-arg kernel32 reroute with FORCED 16-byte rsp alignment (rbx-anchored, the
# ECREATEPROC_PE pattern). The bare `sub rsp,0x28` form tolerates a misaligned
# call site only on a fn's FAST path; AcquireSRWLockExclusive's CONTENDED path
# builds a wait-block on the stack and uses 16-aligned ops on it, so it faults
# (0xC0000005) when two real threads contend on a misaligned rsp — verified on
# cass: uncontended (1 thread) ran, 4 threads contending crashed. Save the live
# rsp in callee-saved rbx, align down, carve the 32 B shadow, call, restore. rax
# (&lock) is an absolute pointer, unaffected by the rsp shuffle. Used by all
# three SRWLOCK reroutes (init/acquire/release) for uniformity.
fn _pe_srw_call_1arg(S, idx): i64 {
    EB(S, 0x58);                                        # pop rax (&lock)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20); # sub rsp, 0x20 (shadow)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (a1 = &lock)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# syscall(0xF008, &lock) → InitializeSRWLock(&lock). 1 arg. SRWLOCK is one
# pointer (8 bytes), zero-initialized; InitializeSRWLock just sets it to the
# SRWLOCK_INIT state. Ret void. Stack (top→bottom): [&lock] [sc_nr].
fn EINITSRW_PE(S): i64 {
    _pe_ensure_initsrw(S);
    return _pe_srw_call_1arg(S, _pe_initsrw_get());
}

# syscall(0xF009, &lock) → AcquireSRWLockExclusive(&lock). 1 arg.
fn EACQSRW_PE(S): i64 {
    _pe_ensure_acqsrw(S);
    return _pe_srw_call_1arg(S, _pe_acqsrw_get());
}

# syscall(0xF00A, &lock) → ReleaseSRWLockExclusive(&lock). 1 arg.
fn ERELSRW_PE(S): i64 {
    _pe_ensure_relsrw(S);
    return _pe_srw_call_1arg(S, _pe_relsrw_get());
}

# syscall(0xF00F, ms) → Sleep(ms). 1 arg (dwMilliseconds in ecx). v6.0.65 —
# portable lib/chrono.cyr sleep_ms on Windows. ms is a value (not a pointer),
# but the aligned 1-arg caller passes it the same way (pop → rcx).
fn ESLEEP_PE(S): i64 {
    _pe_ensure_sleep(S);
    return _pe_srw_call_1arg(S, _pe_sleep_get());
}

# syscall(35, &req, &rem) → Sleep(req-in-ms). v6.1.17 — completes the v6.1.16
# PE var-syscall dispatch (nanosleep(35) was the one routable-arity gap, so a
# `var`-number nanosleep returned -38/-ENOSYS and the portable arch-dispatch
# idiom — sakshi's clock calibration — had to busy-spin on Windows). Linux
# nanosleep takes a `struct timespec*` (req): [req+0]=tv_sec, [req+8]=tv_nsec;
# Sleep takes a flat DWORD ms, so convert ms = tv_sec*1000 + tv_nsec/1e6. `rem`
# (2nd arg) is ignored (Sleep is non-interruptible here — full sleep always
# elapses). Reuses ESLEEP_PE's kernel32!Sleep import. Sub-ms requests round to
# 0/1 ms — Sleep's own granularity, acceptable for calibration windows.
#
# Stack on entry (top→bottom): [rem] [req] [sc_nr=35] — argc=3. Can't reuse
# _pe_srw_call_1arg: it pops the arg straight into rcx, but nanosleep must first
# LOAD the timespec the ptr points at. Consumes all 3 slots (back to the
# pre-syscall baseline), then the rbx-anchored and-rsp,-16 forces the Win64
# 16-alignment at the CALL regardless of entry RSP.
fn ENANOSLEEP_PE(S): i64 {
    _pe_ensure_sleep(S);
    var idx = _pe_sleep_get();

    EB(S, 0x58);                                        # pop rax (rem ptr, ignored)
    EB(S, 0x41); EB(S, 0x5B);                           # pop r11 (req timespec ptr)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    # ms = tv_sec*1000 + tv_nsec/1_000_000.
    EB(S, 0x49); EB(S, 0x8B); EB(S, 0x43); EB(S, 0x08); # mov rax, [r11+8] (tv_nsec)
    EB(S, 0x31); EB(S, 0xD2);                           # xor edx, edx
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0xC1);              # mov rcx, 1000000
    EB(S, 0x40); EB(S, 0x42); EB(S, 0x0F); EB(S, 0x00);
    EB(S, 0x48); EB(S, 0xF7); EB(S, 0xF1);              # div rcx (rax = tv_nsec/1e6)
    EB(S, 0x49); EB(S, 0x8B); EB(S, 0x0B);              # mov rcx, [r11] (tv_sec)
    EB(S, 0x48); EB(S, 0x69); EB(S, 0xC9);              # imul rcx, rcx, 1000
    EB(S, 0xE8); EB(S, 0x03); EB(S, 0x00); EB(S, 0x00);
    EB(S, 0x48); EB(S, 0x01); EB(S, 0xC8);              # add rax, rcx (total ms)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (dwMilliseconds)

    # Aligned 1-arg call to Sleep (rcx already set).
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20); # sub rsp, 0x20 (shadow)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+Sleep]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx

    EB(S, 0x48); EB(S, 0x31); EB(S, 0xC0);              # xor rax, rax (nanosleep → 0)
    return 0;
}

# syscall(0xF010, cmdline, &argc) → shell32!CommandLineToArgvW. 2 args
# (lpCmdLine→rcx, *pNumArgs→rdx). Returns LPWSTR* (array of arg pointers)
# in rax; *pNumArgs receives the count. v6.0.69 §3 — the first shell32
# (non-kernel32) import, exercising the multi-DLL IAT foundation.
fn ECMDTOARGV_PE(S): i64 {
    _pe_ensure_cmdtoargv(S);
    return _pe_call_2arg_aligned(S, _pe_cmdtoargv_get());
}

# syscall(0xF011, ptr) → kernel32!LocalFree(ptr). 1 arg. Frees the
# LPWSTR* CommandLineToArgvW allocated.
fn ELOCALFREE_PE(S): i64 {
    _pe_ensure_localfree(S);
    return _pe_srw_call_1arg(S, _pe_localfree_get());
}

# syscall(0xF013, name) → kernel32!GetModuleHandleA(name). 1 arg (LPCSTR→rcx).
# Returns HMODULE in rax. v6.0.71 — runtime symbol resolution for callptr FFI.
fn EGETMODH_PE(S): i64 {
    _pe_ensure_getmodh(S);
    return _pe_srw_call_1arg(S, _pe_getmodh_get());
}

# syscall(0xF014, hmod, name) → kernel32!GetProcAddress(hmod, name). 2 args
# (HMODULE→rcx, LPCSTR→rdx). Returns FARPROC in rax. v6.0.71.
fn EGETPROC_PE(S): i64 {
    _pe_ensure_getproc(S);
    return _pe_call_2arg_aligned(S, _pe_getproc_get());
}

# syscall(0xF015, name, buf, size) → kernel32!GetEnvironmentVariableA(name, buf,
# size). 3 args (LPCSTR→rcx, LPSTR→rdx, DWORD→r8). Returns the char count in rax.
# v6.0.85 — the Windows env-read path for the cyrius wrapper's cycc resolution.
fn EGETENV_PE(S): i64 {
    _pe_ensure_getenv(S);
    return _pe_call_3arg_aligned(S, _pe_getenv_get());
}

# v6.1.18 — directory enumeration reroutes for lib/fs_win.cyr (the Windows
# dir_list/is_dir port). All kernel32, marshalled through the existing aligned
# helpers (no new asm). syscall(0xF016, wpattern, &finddata) → FindFirstFileW
# (2 args), syscall(0xF017, hFind, &finddata) → FindNextFileW (2 args),
# syscall(0xF018, hFind) → FindClose (1 arg), syscall(0xF019, wpath) →
# GetFileAttributesW (1 arg). See CHANGELOG [6.1.18].
fn EFINDFIRST_PE(S): i64 {
    _pe_ensure_findfirst(S);
    return _pe_call_2arg_aligned(S, _pe_findfirst_get());
}
fn EFINDNEXT_PE(S): i64 {
    _pe_ensure_findnext(S);
    return _pe_call_2arg_aligned(S, _pe_findnext_get());
}
fn EFINDCLOSE_PE(S): i64 {
    _pe_ensure_findclose(S);
    return _pe_srw_call_1arg(S, _pe_findclose_get());
}
fn EGETFATTR_PE(S): i64 {
    _pe_ensure_getfattr(S);
    return _pe_srw_call_1arg(S, _pe_getfattr_get());
}

# 3-arg kernel32 reroute, 16-byte aligned (rbx-anchored, same rationale as the
# 1/2-arg callers above). Stack on entry (top→bottom): [a3][a2][a1][sc_nr].
# a1→rcx, a2→rdx, a3→r8 (Win64 integer arg order), then carve the 32 B shadow.
fn _pe_call_3arg_aligned(S, idx): i64 {
    EB(S, 0x58);                                        # pop rax (a3)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC0);              # mov r8, rax  (a3)
    EB(S, 0x58);                                        # pop rax (a2)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);              # mov rdx, rax (a2)
    EB(S, 0x58);                                        # pop rax (a1)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (a1)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20); # sub rsp, 0x20 (shadow)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# 4-arg kernel32 reroute, 16-byte aligned. a1→rcx, a2→rdx, a3→r8, a4→r9. Result in
# rax. Stack on entry (top→bottom): [a4] [a3] [a2] [a1] [sc_nr]. v6.4.43 (IOCP core:
# CreateIoCompletionPort / PostQueuedCompletionStatus).
fn _pe_call_4arg_aligned(S, idx): i64 {
    EB(S, 0x58);                                        # pop rax (a4)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC1);              # mov r9, rax  (a4)
    EB(S, 0x58);                                        # pop rax (a3)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC0);              # mov r8, rax  (a3)
    EB(S, 0x58);                                        # pop rax (a2)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);              # mov rdx, rax (a2)
    EB(S, 0x58);                                        # pop rax (a1)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (a1)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20); # sub rsp, 0x20 (shadow)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# 5-arg kernel32 reroute, 16-byte aligned. a1-a4 → rcx/rdx/r8/r9; a5 → [rsp+0x20]
# (above the 32-byte shadow, Win64). Result in rax. Stack on entry (top→bottom):
# [a5] [a4] [a3] [a2] [a1] [sc_nr]. v6.4.43 (IOCP core: GetQueuedCompletionStatus —
# 5-arg with 3 out-params in a2/a3/a4). Frame 0x30 (32 shadow + a5 + 8 pad) keeps
# rsp 16-aligned at the call.
fn _pe_call_5arg_aligned(S, idx): i64 {
    EB(S, 0x58);                                        # pop rax (a5)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC2);              # mov r10, rax (a5, temp)
    EB(S, 0x58);                                        # pop rax (a4)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC1);              # mov r9, rax  (a4)
    EB(S, 0x58);                                        # pop rax (a3)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC0);              # mov r8, rax  (a3)
    EB(S, 0x58);                                        # pop rax (a2)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);              # mov rdx, rax (a2)
    EB(S, 0x58);                                        # pop rax (a1)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (a1)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x30); # sub rsp, 0x30 (32 shadow + a5 + pad)
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x20);  # mov [rsp+0x20], r10 (a5)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# 6-arg kernel32/ws2_32 reroute, 16-byte aligned. a1-a4 → rcx/rdx/r8/r9; a5 →
# [rsp+0x20], a6 → [rsp+0x28] (above the 32-byte shadow, Win64). Result in rax.
# Stack on entry (top→bottom): [a6] [a5] [a4] [a3] [a2] [a1] [sc_nr]. v6.4.43
# (WSASocketW — af/type/proto/lpProtocolInfo/g/dwFlags). Frame 0x30 keeps rsp
# 16-aligned at the call.
fn _pe_call_6arg_aligned(S, idx): i64 {
    EB(S, 0x58);                                        # pop rax (a6)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC2);              # mov r10, rax (a6, temp)
    EB(S, 0x58);                                        # pop rax (a5)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC3);              # mov r11, rax (a5, temp)
    EB(S, 0x58);                                        # pop rax (a4)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC1);              # mov r9, rax  (a4)
    EB(S, 0x58);                                        # pop rax (a3)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC0);              # mov r8, rax  (a3)
    EB(S, 0x58);                                        # pop rax (a2)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);              # mov rdx, rax (a2)
    EB(S, 0x58);                                        # pop rax (a1)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (a1)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x30); # sub rsp, 0x30 (32 shadow + a5 + a6)
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x5C); EB(S, 0x24); EB(S, 0x20);  # mov [rsp+0x20], r11 (a5)
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x28);  # mov [rsp+0x28], r10 (a6)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# General n-arg kernel32/ws2_32 reroute, 16-byte aligned. a1-a4 → rcx/rdx/r8/r9;
# a5..aN → [rsp+0x20 + (i-5)*8] (above the 32-byte shadow, Win64). Result in rax.
# Stack on entry (top→bottom): [aN] .. [a1] [sc_nr]. v6.4.43 (WSAIoctl n=9;
# WSARecv/WSASend n=7). n <= 6 have dedicated helpers; this handles n >= 5 (caps at
# n=15 → disp8 for the arg offsets).
#
# v6.4.43 FIX: the args are read by STACK OFFSET (not popped into temp registers) and
# each stack-arg is copied through the VOLATILE r10 only — so the caller's NON-volatile
# r12/r14/r15 are NEVER clobbered. The old pop-into-r12/r14/r15 form corrupted a
# caller-live value the regalloc had placed there (e.g. an open socket), which
# surfaced as a downstream WSAENOTSOCK on the first >4-arg call ever emitted
# (WSAIoctl). rax holds the args-base for the whole body; args are dropped at the end
# with a single `add rsp` (net-equivalent to the old pops). See CHANGELOG [6.4.43].
fn _pe_call_nargs_aligned(S, idx, n): i64 {
    var nextra = n - 4;
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE0);                            # mov rax, rsp (args base)
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x48); EB(S, (nextra + 3) * 8);   # mov rcx, [rax+..] (a1)
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x50); EB(S, (nextra + 2) * 8);   # mov rdx, [rax+..] (a2)
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x40); EB(S, (nextra + 1) * 8);   # mov r8,  [rax+..] (a3)
    EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x48); EB(S, nextra * 8);         # mov r9,  [rax+..] (a4)
    EB(S, 0x53);                                                      # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);                            # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0);               # and rsp, -16
    var framesize = 32 + nextra * 8;
    if ((framesize & 15) != 0) { framesize = framesize + 8; }
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, framesize);          # sub rsp, framesize
    var j = 0;
    while (j < nextra) {
        # a[4+j] (0-indexed from a5) → [rsp+0x20 + j*8]; source [rax + (nextra-1-j)*8].
        EB(S, 0x4C); EB(S, 0x8B); EB(S, 0x50); EB(S, (nextra - 1 - j) * 8);     # mov r10, [rax+..]
        EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x20 + j * 8); # mov [rsp+..], r10
        j = j + 1;
    }
    EB(S, 0xFF); EB(S, 0x15);                                         # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);                            # mov rsp, rbx
    EB(S, 0x5B);                                                      # pop rbx
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, (n + 1) * 8);        # add rsp, (n+1)*8 (drop args + sc_nr)
    return 0;
}

# syscall(0xF027, s, code, &in, inlen, &out, outlen, &bytes, 0, 0) → ws2_32!WSAIoctl
# (9-arg). Used with SIO_GET_EXTENSION_FUNCTION_POINTER (0xC8000006) + WSAID_CONNECTEX
# to fetch the ConnectEx function pointer into &out (then called via callptr).
fn EWSAIOCTL_PE(S): i64 {
    _pe_ensure_wsaioctl(S);
    return _pe_call_nargs_aligned(S, _pe_wsaioctl_get(), 9);
}
# syscall(0xF028, s, &sockaddr, namelen) → ws2_32!connect (3-arg blocking connect; 0
# on success).
fn ECONNECT_PE(S): i64 {
    _pe_ensure_connect(S);
    return _pe_call_3arg_aligned(S, _pe_connect_get());
}
# syscall(0xF029, s, &WSABUF, count, &recvd, &flags, &overlapped, 0) → ws2_32!WSARecv
# (7-arg; blocking when &overlapped is 0, else IOCP-overlapped).
fn EWSARECV_PE(S): i64 {
    _pe_ensure_wsarecv(S);
    return _pe_call_nargs_aligned(S, _pe_wsarecv_get(), 7);
}
# syscall(0xF02A, s, &WSABUF, count, &sent, flags, &overlapped, 0) → ws2_32!WSASend
# (7-arg; blocking when &overlapped is 0, else IOCP-overlapped).
fn EWSASEND_PE(S): i64 {
    _pe_ensure_wsasend(S);
    return _pe_call_nargs_aligned(S, _pe_wsasend_get(), 7);
}
# syscall(0xF02B, node, service, hints, &result) → ws2_32!getaddrinfo (4-arg; 0 on
# success, &result → addrinfo list).
fn EGETADDRINFO_PE(S): i64 {
    _pe_ensure_getaddrinfo(S);
    return _pe_call_4arg_aligned(S, _pe_getaddrinfo_get());
}
# syscall(0xF02C, result) → ws2_32!freeaddrinfo (1-arg; frees the addrinfo list).
fn EFREEADDRINFO_PE(S): i64 {
    _pe_ensure_freeaddrinfo(S);
    return _pe_srw_call_1arg(S, _pe_freeaddrinfo_get());
}
# v6.4.43 R2 — the non-IOCP-event → IOCP bridge (kernel32).
# syscall(0xF02D, &phWait, hObject, callback, context, ms, flags) →
# RegisterWaitForSingleObject (6-arg; callback = a cyrius fn that PostQueuedCompletionStatus).
fn EREGWAIT_PE(S): i64 {
    _pe_ensure_regwait(S);
    return _pe_call_6arg_aligned(S, _pe_regwait_get());
}
# syscall(0xF02E, attrs, manualReset, name) → CreateWaitableTimerW (3-arg; → timer HANDLE).
fn ECREATETIMER_PE(S): i64 {
    _pe_ensure_createtimer(S);
    return _pe_call_3arg_aligned(S, _pe_createtimer_get());
}
# syscall(0xF02F, hTimer, &dueTime, period, routine, arg, resume) → SetWaitableTimer (6-arg;
# dueTime = negative LARGE_INTEGER = relative 100ns units).
fn ESETTIMER_PE(S): i64 {
    _pe_ensure_settimer(S);
    return _pe_call_6arg_aligned(S, _pe_settimer_get());
}
# syscall(0xF030, waitHandle, completionEvent) → UnregisterWaitEx (2-arg; drain the
# RegisterWaitForSingleObject callback before closing the waited-on handle).
fn EUNREGWAIT_PE(S): i64 {
    _pe_ensure_unregwait(S);
    return _pe_call_2arg_aligned(S, _pe_unregwait_get());
}
# syscall(0xF031, hFile, &overlapped) → CancelIoEx (2-arg; cancel one in-flight overlapped
# op without closing the handle).
fn ECANCELIO_PE(S): i64 {
    _pe_ensure_cancelio(S);
    return _pe_call_2arg_aligned(S, _pe_cancelio_get());
}
# syscall(0xF032, s, level, optname, optval, optlen) → ws2_32!setsockopt (5-arg;
# SO_UPDATE_CONNECT_CONTEXT after ConnectEx).
fn ESETSOCKOPT_PE(S): i64 {
    _pe_ensure_setsockopt(S);
    return _pe_call_5arg_aligned(S, _pe_setsockopt_get());
}

# v6.4.43: ws2_32 socket foundation. syscall(0xF022, af,type,proto,info,g,flags) →
# WSASocketW (6-arg; WSA_FLAG_OVERLAPPED=1 → an IOCP-associable socket; returns
# SOCKET or INVALID_SOCKET=-1).
fn EWSASOCKET_PE(S): i64 {
    _pe_ensure_wsasocket(S);
    return _pe_call_6arg_aligned(S, _pe_wsasocket_get());
}
# syscall(0xF023, s) → closesocket (1-arg; 0 on success).
fn ECLOSESOCKET_PE(S): i64 {
    _pe_ensure_closesocket(S);
    return _pe_srw_call_1arg(S, _pe_closesocket_get());
}
# syscall(0xF024) → WSAGetLastError (0-arg; last-error DWORD, e.g. WSA_IO_PENDING=997).
fn EWSALASTERR_PE(S): i64 {
    _pe_ensure_wsalasterr(S);
    return _pe_call_0arg_aligned(S, _pe_wsalasterr_get());
}
# syscall(0xF025, s, &sockaddr, namelen) → ws2_32!bind (3-arg; 0 on success — the
# local bind ConnectEx requires).
fn EBIND_PE(S): i64 {
    _pe_ensure_bind(S);
    return _pe_call_3arg_aligned(S, _pe_bind_get());
}

# v6.4.44 R3: syscall(0xF033, s, backlog) → ws2_32!listen(s, backlog). 2-arg.
fn ELISTEN_PE(S): i64 {
    _pe_ensure_listen(S);
    return _pe_call_2arg_aligned(S, _pe_listen_get());
}
# syscall(0xF026, s, level, optname, &optval, &optlen) → ws2_32!getsockopt (5-arg;
# SO_ERROR read after a connect completion). optval/optlen are OUT-pointers.
fn EGETSOCKOPT_PE(S): i64 {
    _pe_ensure_getsockopt(S);
    return _pe_call_5arg_aligned(S, _pe_getsockopt_get());
}

# syscall(0xF012, &iid, &ppFactory) → dxgi!CreateDXGIFactory1. 2 args
# (REFIID riid → rcx, void** ppFactory → rdx). Returns HRESULT (0=S_OK) in
# rax/eax; *ppFactory receives the IDXGIFactory1*. v6.0.70 §0 — dxgi.dll is
# the 3rd import DLL via the v6.0.69 multi-DLL foundation. The factory's
# methods are then called through its vtable with callptr.
fn ECREATEDXGI_PE(S): i64 {
    _pe_ensure_createdxgi(S);
    return _pe_call_2arg_aligned(S, _pe_createdxgi_get());
}

# syscall(0xF01A, pbData, cbData) → bcryptprimitives!ProcessPrng. 2 args
# (PBYTE→rcx, SIZE_T→rdx). Returns BOOL (nonzero=success) in rax — the Windows
# CSPRNG for lib/syscalls_windows.cyr's sys_getrandom (replacing the -1 stub).
# v6.2.12 — see 2026-06-11-windows-entropy-primitive.md.
fn EPROCPRNG_PE(S): i64 {
    _pe_ensure_procprng(S);
    return _pe_call_2arg_aligned(S, _pe_procprng_get());
}

# syscall(0xF01B, &ft) → kernel32!GetSystemTimeAsFileTime(LPFILETIME→rcx). 1 arg;
# returns void, fills the 8-byte FILETIME at &ft (100ns ticks since 1601). The
# Windows wall-clock source for chrono.clock_epoch_secs/ns. v6.2.13 — see the
# 2026-06-16 clock issue.
fn EGETSYSTIME_PE(S): i64 {
    _pe_ensure_getsystime(S);
    return _pe_srw_call_1arg(S, _pe_getsystime_get());
}

# v6.0.65: stub for the macho-ARM syscall-routed query (real impl in
# src/backend/aarch64/emit.cyr next to ESYSXLAT). parse_expr.cyr references it
# for the _TARGET_MACHO==2 whitelist warning; that path is dead on x86, so this
# never runs — it exists only for symbol resolution on the x86/PE/x86-macho closures.
fn _macho_arm_routes(n): i64 { return 0; }

# 0-arg kernel32 reroute, 16-byte aligned (rbx-anchored, same rationale as
# _pe_srw_call_1arg). Result in rax. Stack on entry (top→bottom): [sc_nr].
fn _pe_call_0arg_aligned(S, idx): i64 {
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20); # sub rsp, 0x20 (shadow)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# 2-arg kernel32 reroute, 16-byte aligned. a1→rcx, a2→rdx (set BEFORE the rsp
# shuffle; the align/shadow ops touch only rax/rbx/rsp). Result in rax. Stack
# on entry (top→bottom): [a2] [a1] [sc_nr].
fn _pe_call_2arg_aligned(S, idx): i64 {
    EB(S, 0x58);                                        # pop rax (a2)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);              # mov rdx, rax (a2)
    EB(S, 0x58);                                        # pop rax (a1)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (a1)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20); # sub rsp, 0x20 (shadow)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+IAT]
    _pe_iat_fixup_add(S, GCP(S), idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# syscall(0xF00B) → GetCurrentThreadId(). 0 args. DWORD thread id in eax
# (zero-extended to rax). Backs gettid() on Windows.
fn EGETCURTID_PE(S): i64 {
    _pe_ensure_getcurtid(S);
    return _pe_call_0arg_aligned(S, _pe_getcurtid_get());
}

# v6.3.44: syscall(0xF01C) → GetCurrentProcessId(). 0 args. DWORD pid in eax
# (zero-extended to rax). Backs getpid() on Windows (was a 0-returning stub).
fn EGETCURPID_PE(S): i64 {
    _pe_ensure_getcurpid(S);
    return _pe_call_0arg_aligned(S, _pe_getcurpid_get());
}

# v6.4.26: syscall(0xF01D, hProcess, uExitCode) → kernel32!TerminateProcess. 2 args
# (HANDLE→rcx, UINT exit code→rdx). Returns BOOL (nonzero=success) in rax. The Windows
# SIGKILL analogue — force-terminates a spawned child that ran past a wall-clock
# deadline (thoth's exec_shell_capture timeout-kill). Uses the same 2-arg aligned
# reroute as GetProcAddress/ProcessPrng. See 2026-07-08-windows-pe-surface-no-terminateprocess.md.
fn ETERMINATE_PE(S): i64 {
    _pe_ensure_terminateproc(S);
    return _pe_call_2arg_aligned(S, _pe_terminateproc_get());
}

# v6.4.43: syscall(0xF01E, wVersionRequested, lpWSAData) → ws2_32!WSAStartup, the
# Winsock init the async IOCP backend calls once before any socket op (2-arg,
# rcx=version(0x0202), rdx=&WSADATA; 0 in eax on success). First ws2_32 (dll_id 4)
# symbol — async arc 5b "W" step. Same 2-arg aligned reroute as ETERMINATE_PE.
fn EWSASTARTUP_PE(S): i64 {
    _pe_ensure_wsastartup(S);
    return _pe_call_2arg_aligned(S, _pe_wsastartup_get());
}

# v6.4.43: the IOCP core (kernel32), the async reactor's completion engine.
# syscall(0xF01F, FileHandle, ExistingPort, Key, NumThreads) → CreateIoCompletionPort
# (4-arg; returns the IOCP HANDLE, or associates a socket with an existing port).
fn ECREATEIOCP_PE(S): i64 {
    _pe_ensure_createiocp(S);
    return _pe_call_4arg_aligned(S, _pe_createiocp_get());
}
# syscall(0xF020, port, &bytes, &key, &overlapped, ms) → GetQueuedCompletionStatus
# (5-arg; a2/a3/a4 are OUT-pointers the kernel writes; returns BOOL, timeout → 0).
fn EGETQCS_PE(S): i64 {
    _pe_ensure_getqcs(S);
    return _pe_call_5arg_aligned(S, _pe_getqcs_get());
}
# syscall(0xF021, port, bytes, key, &overlapped) → PostQueuedCompletionStatus
# (4-arg; posts a manual completion to wake the reactor for non-socket sources).
fn EPOSTQCS_PE(S): i64 {
    _pe_ensure_postqcs(S);
    return _pe_call_4arg_aligned(S, _pe_postqcs_get());
}

# syscall(0xF00C) → TlsAlloc(). 0 args. Returns a fresh TLS slot index (DWORD)
# in eax, or TLS_OUT_OF_INDEXES (0xFFFFFFFF) on failure.
fn ETLSALLOC_PE(S): i64 {
    _pe_ensure_tlsalloc(S);
    return _pe_call_0arg_aligned(S, _pe_tlsalloc_get());
}

# syscall(0xF00D, idx) → TlsGetValue(idx). 1 arg. Returns this thread's LPVOID
# at the slot (0 if never set) in rax.
fn ETLSGET_PE(S): i64 {
    _pe_ensure_tlsget(S);
    return _pe_srw_call_1arg(S, _pe_tlsget_get());
}

# syscall(0xF00E, idx, val) → TlsSetValue(idx, val). 2 args. BOOL in eax.
fn ETLSSET_PE(S): i64 {
    _pe_ensure_tlsset(S);
    return _pe_call_2arg_aligned(S, _pe_tlsset_get());
}

# emit Win64 seek: `syscall(8, fd, offset, whence)` →
# SetFilePointerEx(hFile, liDistanceToMove, lpNewFilePointer, dwMoveMethod).
# Stack on entry (top→bottom): [whence] [offset] [fd] [sc_nr=8].
# Frame is 0x30: shadow (32 B) + new-position output slot at
# [rsp+0x28] + 8 B align pad. Returns the new file position (or -1
# packed as 0xFFFFFFFF if the API returned 0 for failure — callers
# should range-check if distinguishing from a valid offset of -1).
fn ELSEEK_PE(S): i64 {
    _pe_ensure_seekfp(S);
    var spe_idx = _pe_seekfp_get();

    EB(S, 0x58);                                   # pop rax (whence)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC1);         # mov r9, rax (dwMoveMethod)
    EB(S, 0x58);                                   # pop rax (offset)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);         # mov rdx, rax (liDistanceToMove)
    EB(S, 0x58);                                   # pop rax (fd)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);         # mov rcx, rax (hFile)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x30); # sub rsp, 0x30
    # Zero the lpNewFilePointer output slot at [rsp+0x28].
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0x44); EB(S, 0x24); EB(S, 0x28);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # lea r8, [rsp+0x28] (lpNewFilePointer arg)
    EB(S, 0x4C); EB(S, 0x8D); EB(S, 0x44); EB(S, 0x24); EB(S, 0x28);

    EB(S, 0xFF); EB(S, 0x15);                      # call [rip+SetFilePointerEx]
    _pe_iat_fixup_add(S, GCP(S), spe_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    # Return the new offset (always 64-bit — LARGE_INTEGER in slot).
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x44); EB(S, 0x24); EB(S, 0x28); # mov rax, [rsp+0x28]
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x30); # add rsp, 0x30
    return 0;
}

# emit Win64 memory map: `syscall(9, addr, length, prot, flags, fd, offset)` →
# VirtualAlloc(lpAddress, dwSize, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE).
# Stack on entry (top→bottom): [offset] [fd] [flags] [prot] [length] [addr] [sc_nr=9].
# `prot`/`flags`/`fd`/`offset` from the Linux mmap surface are
# dropped — v5.5.1 uses fixed RW protection and always reserves +
# commits. Future patches can derive flProtect from prot if needed.
fn EMMAP_PE(S): i64 {
    _pe_ensure_vallo(S);
    var va_idx = _pe_vallo_get();

    # Drop offset/fd/flags/prot (4 slots = 32 B).
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x20); # add rsp, 0x20
    EB(S, 0x58);                                        # pop rax (length)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC2);              # mov rdx, rax (dwSize)
    EB(S, 0x58);                                        # pop rax (addr)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax (lpAddress)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    # mov r8d, 0x3000 (MEM_COMMIT | MEM_RESERVE)
    EB(S, 0x41); EB(S, 0xB8); EB(S, 0x00); EB(S, 0x30); EB(S, 0x00); EB(S, 0x00);
    # mov r9d, 0x04 (PAGE_READWRITE)
    EB(S, 0x41); EB(S, 0xB9); EB(S, 0x04); EB(S, 0x00); EB(S, 0x00); EB(S, 0x00);

    # v6.4.44: rbx-anchored dynamic 16-align (was a fixed `sub rsp,0x28` that only aligned
    # on the right parity). The align touches only rax/rbx/rsp, so rcx/rdx/r8/r9 survive.
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20); # sub rsp, 0x20 (shadow)
    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+VirtualAlloc]
    _pe_iat_fixup_add(S, GCP(S), va_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    return 0;
}

# ================================================================
# v6.1.16 — Runtime PE syscall dispatch for NON-LITERAL numbers.
#
# The literal-number reroute above (`sc_num == N` cases in
# parse_expr.cyr) is a compile-time pattern match: it only fires when
# the first arg constant-folds. A consumer that holds the syscall
# number in a `var` (the portable arch-dispatch idiom — sakshi's
# `var _SK_SYS_WRITE = 1;`) leaves `sc_num == -1`, no case matches, and
# the generic ESCPOPS path emits the Linux `0F 05` syscall instruction,
# which faults / silently no-ops on Windows. Issue:
# docs/development/issues/2026-06-09-pe-syscall-variable-number-not-rerouted.md
#
# Fix: when the number is non-literal, emit a runtime switch on it.
# argc is fixed at the call site (only the NUMBER is dynamic), so we
# only compare against the routable POSIX syscalls whose arity == argc,
# branching to the SAME E*_PE sequence the literal path uses. The
# number is still on the expr stack at [rsp + 8*(argc-1)] (deepest
# push); `mov`/`cmp`/`jne` don't touch rsp, so each E*_PE sees the
# identical entry-RSP state (and thus the identical Win64 16-alignment)
# it gets on the literal path. Unknown number at this arity → rax = -38
# (-ENOSYS) with the stack balanced, never `0F 05`.
#
# The 0xF0xx Win32-internal reroutes (process/threading/TLS/DXGI/…) are
# DELIBERATELY excluded: they're emitted only as literal `syscall(0xF0NN,…)`
# from the *_win.cyr stdlib and are never held in an arch-dispatch var,
# so a runtime number is always a real Linux syscall number.
# ================================================================

# mov rax, [rsp+disp]  — load the (runtime) syscall number without
# disturbing the args. disp = 8*(argc-1) ≤ 56, so the disp8 form fits.
fn _pe_dyn_load(S, disp): i64 {
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x44); EB(S, 0x24); EB(S, disp);
    return 0;
}

# cmp rax, imm32 ; jne <next-candidate>.  Returns the EJCC patch offset
# so the caller lands it past this candidate's block + jmp-done.
fn _pe_dyn_cmp(S, num): i64 {
    EB(S, 0x48); EB(S, 0x3D); EDISP32(S, num);   # cmp rax, imm32 (sign-ext)
    return EJCC(S, 0x85);                        # jne rel32 (0F 85)
}

# No-match tail: drop all argc args and return -38 (-ENOSYS) in rax —
# an honest error to the caller rather than the silent-no-op 0F 05.
fn _pe_dyn_nomatch(S, argc): i64 {
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 8 * argc);  # add rsp, 8*argc
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0xC0); EDISP32(S, 0 - 38); # mov rax, -38
    return 0;
}

# Emit the runtime switch. Returns 1 if argc is routable on PE (cmp/jne over the
# routable syscalls of this arity; unknown number → -38). Returns 2 if NO
# routable syscall has this arity — emits an honest -38/-ENOSYS no-op
# (stack-balanced) and the caller warns. (v6.1.17 softened this from a hard
# error: the arity-5 getdents64 in lib/fs.cyr's dir-listing is a Linux-only path
# dead on Windows, and refusing to compile it blocked the whole PE tarball.)
fn EPE_SYSCALL_DYNAMIC(S, argc): i64 {
    var disp = 8 * (argc - 1);
    if (argc == 4) {
        _pe_dyn_load(S, disp);
        var p0 = _pe_dyn_cmp(S, 0); EREAD_PE(S);  var d0 = EJMP0(S); EPATCH(S, p0);
        var p1 = _pe_dyn_cmp(S, 1); EWRITE_PE(S); var d1 = EJMP0(S); EPATCH(S, p1);
        var p2 = _pe_dyn_cmp(S, 2); EOPEN_PE(S);  var d2 = EJMP0(S); EPATCH(S, p2);
        var p3 = _pe_dyn_cmp(S, 8); ELSEEK_PE(S); var d3 = EJMP0(S); EPATCH(S, p3);
        _pe_dyn_nomatch(S, argc);
        EPATCH(S, d0); EPATCH(S, d1); EPATCH(S, d2); EPATCH(S, d3);
        return 1;
    }
    if (argc == 3) {
        _pe_dyn_load(S, disp);
        var q0 = _pe_dyn_cmp(S, 83);  ECREATEDIR_PE(S); var e0 = EJMP0(S); EPATCH(S, q0);
        var q1 = _pe_dyn_cmp(S, 228); EGETTICKS_PE(S);  var e1 = EJMP0(S); EPATCH(S, q1);
        var q2 = _pe_dyn_cmp(S, 35);  ENANOSLEEP_PE(S); var e2 = EJMP0(S); EPATCH(S, q2);
        _pe_dyn_nomatch(S, argc);
        EPATCH(S, e0); EPATCH(S, e1); EPATCH(S, e2);
        return 1;
    }
    if (argc == 2) {
        _pe_dyn_load(S, disp);
        var r0 = _pe_dyn_cmp(S, 3);  ECLOSE_PE(S);   var f0 = EJMP0(S); EPATCH(S, r0);
        var r1 = _pe_dyn_cmp(S, 87); EDELETEF_PE(S); var f1 = EJMP0(S); EPATCH(S, r1);
        # exit(60): mirror the literal path (pop code, drop sc_nr, ExitProcess).
        # EEXIT ends in int3 and never returns, so its jmp-done is dead but kept
        # for uniform structure.
        var r2 = _pe_dyn_cmp(S, 60); EPOPR(S); EDROPI64(S); EEXIT(S); var f2 = EJMP0(S); EPATCH(S, r2);
        _pe_dyn_nomatch(S, argc);
        EPATCH(S, f0); EPATCH(S, f1); EPATCH(S, f2);
        return 1;
    }
    if (argc == 7) {
        _pe_dyn_load(S, disp);
        var g0 = _pe_dyn_cmp(S, 9); EMMAP_PE(S); var h0 = EJMP0(S); EPATCH(S, g0);
        _pe_dyn_nomatch(S, argc);
        EPATCH(S, h0);
        return 1;
    }
    # v6.1.17: no routable syscall has this arity (e.g. `syscall(SYS_GETDENTS64,
    # fd, buf, 4096, basep)` — argc==5 — in lib/fs.cyr's dir-listing). Do NOT
    # hard-error: it's almost always a Linux-only path that's dead on Windows
    # (which enumerates dirs via FindFirstFile, not a syscall), and refusing to
    # *compile* it blocked the whole PE tarball build (6.1.16 release-blocker).
    # Emit the honest `-38`/`-ENOSYS` no-op (stack-balanced — same as an unknown
    # NUMBER of a known arity above) and return 2 so the caller warns.
    _pe_dyn_nomatch(S, argc);
    return 2;
}

# v5.11.23: emit Win64 mkdir: `syscall(83, path, mode)` →
# CreateDirectoryW(lpPathName, lpSecurityAttributes). Drops `mode`
# (Windows uses ACLs, not POSIX mode bits). Returns 0 on success,
# -1 on failure (Linux mkdir convention).
#
# Stack on entry (top→bottom): [mode] [path] [sc_nr=83].
#
# FRAME 0x258 (NOT 0x250 like the original placeholder draft —
# v5.11.22 bisect found the alignment bug). Win64 ABI requires
# RSP 16-aligned at CALL. cyrius's pre-syscall RSP is 16k+8
# (loader's CALL into _start pushed 8 bytes); 3-arg syscall
# pushes 24 then ECREATEDIR_PE pops 16 + drops 8 = back to 16k+8.
# `sub rsp, 0x258` lands RSP at 16(k-37) = 16-aligned. The
# original 0x250 left RSP at 16(k-37)+8 — misaligned by 8.
# Wine tolerates this; real Windows kernel32 path APIs detect
# the misalignment in ntdll!+0x41912 and access-violate. The
# `_pe_exit_gate` only exercised exit42 + hello-world (frames
# 0x28 and 0x40 respectively + matching pre-states — incidentally
# aligned), masking this for the entire EOPEN_PE pattern.
# See CHANGELOG [5.11.23].
fn ECREATEDIR_PE(S): i64 {
    _pe_ensure_createdir(S);
    var cd_idx = _pe_createdir_get();

    EB(S, 0x58);                                        # pop rax (mode, ignored)
    EB(S, 0x58);                                        # pop rax (path ptr)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC3);              # mov r11, rax (stash path)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    # Frame 0x258 — aligns RSP at call; UTF-16 buffer at +0x38.
    EB(S, 0x48); EB(S, 0x81); EB(S, 0xEC);
    EB(S, 0x58); EB(S, 0x02); EB(S, 0x00); EB(S, 0x00);

    EB(S, 0x4C); EB(S, 0x89); EB(S, 0xDE);              # mov rsi, r11
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x7C); EB(S, 0x24); EB(S, 0x38); # lea rdi, [rsp+0x38]
    EB(S, 0x31); EB(S, 0xC9);                           # xor ecx, ecx

    # widen_loop (ASCII-only round-trip; non-ASCII WIP).
    EB(S, 0x0F); EB(S, 0xB6); EB(S, 0x04); EB(S, 0x0E); # movzx eax, byte [rsi+rcx]
    EB(S, 0x66); EB(S, 0x89); EB(S, 0x04); EB(S, 0x4F); # mov word [rdi+rcx*2], ax
    EB(S, 0x85); EB(S, 0xC0);                           # test eax, eax
    EB(S, 0x74); EB(S, 0x0C);                           # jz widen_done
    EB(S, 0xFF); EB(S, 0xC1);                           # inc ecx
    EB(S, 0x81); EB(S, 0xF9); EB(S, 0x04); EB(S, 0x01); EB(S, 0x00); EB(S, 0x00); # cmp ecx, 260
    EB(S, 0x73); EB(S, 0x02);                           # jae widen_done
    EB(S, 0xEB); EB(S, 0xE8);                           # jmp widen_loop (-24)
    EB(S, 0x66); EB(S, 0xC7); EB(S, 0x04); EB(S, 0x4F); EB(S, 0x00); EB(S, 0x00); # force NUL

    # CreateDirectoryW(rsp+0x38, NULL).
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x4C); EB(S, 0x24); EB(S, 0x38); # lea rcx, [rsp+0x38]
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xD2);                           # xor rdx, rdx

    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+CreateDirectoryW]
    _pe_iat_fixup_add(S, GCP(S), cd_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    EB(S, 0x48); EB(S, 0x81); EB(S, 0xC4);              # add rsp, 0x258
    EB(S, 0x58); EB(S, 0x02); EB(S, 0x00); EB(S, 0x00);

    # BOOL → Linux mkdir rc: 0 success, -1 failure.
    EB(S, 0x48); EB(S, 0xFF); EB(S, 0xC8);              # dec rax
    EB(S, 0x48); EB(S, 0xC1); EB(S, 0xF8); EB(S, 0x3F); # sar rax, 63
    return 0;
}

# v5.11.23: emit Win64 unlink: `syscall(87, path)` →
# DeleteFileW(lpFileName). Stack on entry: [path] [sc_nr=87].
# Same widening + alignment story as ECREATEDIR_PE.
#
# 2-arg syscall: 2 pushes (24 → wait no — sc_nr+path = 2 pushes = 16),
# 1 pop + drop = 16 bytes consumed. Pre-sub RSP back to 16k+8.
# Frame 0x258 aligns the call same as ECREATEDIR_PE.
fn EDELETEF_PE(S): i64 {
    _pe_ensure_deletef(S);
    var df_idx = _pe_deletef_get();

    EB(S, 0x58);                                        # pop rax (path ptr)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC3);              # mov r11, rax (stash path)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    EB(S, 0x48); EB(S, 0x81); EB(S, 0xEC);              # sub rsp, 0x258
    EB(S, 0x58); EB(S, 0x02); EB(S, 0x00); EB(S, 0x00);

    EB(S, 0x4C); EB(S, 0x89); EB(S, 0xDE);              # mov rsi, r11
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x7C); EB(S, 0x24); EB(S, 0x38); # lea rdi, [rsp+0x38]
    EB(S, 0x31); EB(S, 0xC9);                           # xor ecx, ecx

    EB(S, 0x0F); EB(S, 0xB6); EB(S, 0x04); EB(S, 0x0E);
    EB(S, 0x66); EB(S, 0x89); EB(S, 0x04); EB(S, 0x4F);
    EB(S, 0x85); EB(S, 0xC0);
    EB(S, 0x74); EB(S, 0x0C);
    EB(S, 0xFF); EB(S, 0xC1);
    EB(S, 0x81); EB(S, 0xF9); EB(S, 0x04); EB(S, 0x01); EB(S, 0x00); EB(S, 0x00);
    EB(S, 0x73); EB(S, 0x02);
    EB(S, 0xEB); EB(S, 0xE8);
    EB(S, 0x66); EB(S, 0xC7); EB(S, 0x04); EB(S, 0x4F); EB(S, 0x00); EB(S, 0x00); # NUL

    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x4C); EB(S, 0x24); EB(S, 0x38); # lea rcx, [rsp+0x38]

    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+DeleteFileW]
    _pe_iat_fixup_add(S, GCP(S), df_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    EB(S, 0x48); EB(S, 0x81); EB(S, 0xC4);              # add rsp, 0x258
    EB(S, 0x58); EB(S, 0x02); EB(S, 0x00); EB(S, 0x00);

    EB(S, 0x48); EB(S, 0xFF); EB(S, 0xC8);              # dec rax
    EB(S, 0x48); EB(S, 0xC1); EB(S, 0xF8); EB(S, 0x3F); # sar rax, 63
    return 0;
}

# v6.4.57: MoveFileExW(lpExistingFileName, lpNewFileName, MOVEFILE_REPLACE_EXISTING)
# — the Windows half of lib/io.cyr's portable file_rename (POSIX rename(2) / AGNOS
# 4-arg sys_rename). syscall(0xF034, old, new): stack on entry (top->bottom):
# [new] [old] [sc_nr=0xF034]. BOTH paths are widened inline UTF-8->UTF-16LE (ASCII
# fast path, same widener as EOPEN_PE/ECREATEDIR_PE) into two 528-byte frame
# buffers, then rcx=old_wide, rdx=new_wide, r8d=1 (MOVEFILE_REPLACE_EXISTING) and
# kernel32!MoveFileExW is called. BOOL result -> 0 (success) / -1 (fail) via the
# EDELETEF_PE dec+sar idiom. Frame (rbx-anchored + and rsp,-16, so alignment-
# agnostic): 0x460 = 32 shadow + 528 old + 528 new + 32 slack, 16-aligned at CALL.
fn EMOVEFILEEX_PE(S): i64 {
    _pe_ensure_movefileex(S);
    var mv_idx = _pe_movefileex_get();

    EB(S, 0x58);                                        # pop rax (new ptr)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC3);              # mov r11, rax (stash new)
    EB(S, 0x58);                                        # pop rax (old ptr)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC2);              # mov r10, rax (stash old)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    # anchor + align (rbx-preserved; alignment-agnostic)
    EB(S, 0x53);                                        # push rbx
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xE3);              # mov rbx, rsp
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xE4); EB(S, 0xF0); # and rsp, -16
    EB(S, 0x48); EB(S, 0x81); EB(S, 0xEC);              # sub rsp, 0x460
    EB(S, 0x60); EB(S, 0x04); EB(S, 0x00); EB(S, 0x00);

    # widen old (r10) -> [rsp+0x20]
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0xD6);              # mov rsi, r10
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x7C); EB(S, 0x24); EB(S, 0x20); # lea rdi, [rsp+0x20]
    EB(S, 0x31); EB(S, 0xC9);                           # xor ecx, ecx
    EB(S, 0x0F); EB(S, 0xB6); EB(S, 0x04); EB(S, 0x0E); # movzx eax, byte [rsi+rcx]
    EB(S, 0x66); EB(S, 0x89); EB(S, 0x04); EB(S, 0x4F); # mov [rdi+rcx*2], ax
    EB(S, 0x85); EB(S, 0xC0);                           # test eax, eax
    EB(S, 0x74); EB(S, 0x0C);                           # jz old_done (+12)
    EB(S, 0xFF); EB(S, 0xC1);                           # inc ecx
    EB(S, 0x81); EB(S, 0xF9); EB(S, 0x04); EB(S, 0x01); EB(S, 0x00); EB(S, 0x00); # cmp ecx, 260
    EB(S, 0x73); EB(S, 0x02);                           # jae old_done (+2)
    EB(S, 0xEB); EB(S, 0xE8);                           # jmp widen_old (-24)
    EB(S, 0x66); EB(S, 0xC7); EB(S, 0x04); EB(S, 0x4F); EB(S, 0x00); EB(S, 0x00); # old_done: NUL WCHAR

    # widen new (r11) -> [rsp+0x230]
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0xDE);              # mov rsi, r11
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0xBC); EB(S, 0x24); EB(S, 0x30); EB(S, 0x02); EB(S, 0x00); EB(S, 0x00); # lea rdi, [rsp+0x230]
    EB(S, 0x31); EB(S, 0xC9);                           # xor ecx, ecx
    EB(S, 0x0F); EB(S, 0xB6); EB(S, 0x04); EB(S, 0x0E); # movzx eax, byte [rsi+rcx]
    EB(S, 0x66); EB(S, 0x89); EB(S, 0x04); EB(S, 0x4F); # mov [rdi+rcx*2], ax
    EB(S, 0x85); EB(S, 0xC0);                           # test eax, eax
    EB(S, 0x74); EB(S, 0x0C);                           # jz new_done (+12)
    EB(S, 0xFF); EB(S, 0xC1);                           # inc ecx
    EB(S, 0x81); EB(S, 0xF9); EB(S, 0x04); EB(S, 0x01); EB(S, 0x00); EB(S, 0x00); # cmp ecx, 260
    EB(S, 0x73); EB(S, 0x02);                           # jae new_done (+2)
    EB(S, 0xEB); EB(S, 0xE8);                           # jmp widen_new (-24)
    EB(S, 0x66); EB(S, 0xC7); EB(S, 0x04); EB(S, 0x4F); EB(S, 0x00); EB(S, 0x00); # new_done: NUL WCHAR

    # args: rcx = old_wide, rdx = new_wide, r8d = MOVEFILE_REPLACE_EXISTING
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x4C); EB(S, 0x24); EB(S, 0x20); # lea rcx, [rsp+0x20]
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x94); EB(S, 0x24); EB(S, 0x30); EB(S, 0x02); EB(S, 0x00); EB(S, 0x00); # lea rdx, [rsp+0x230]
    EB(S, 0x41); EB(S, 0xB8); EB(S, 0x01); EB(S, 0x00); EB(S, 0x00); EB(S, 0x00); # mov r8d, 1

    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+MoveFileExW]
    _pe_iat_fixup_add(S, GCP(S), mv_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    EB(S, 0x48); EB(S, 0x89); EB(S, 0xDC);              # mov rsp, rbx
    EB(S, 0x5B);                                        # pop rbx
    EB(S, 0x48); EB(S, 0xFF); EB(S, 0xC8);              # dec rax
    EB(S, 0x48); EB(S, 0xC1); EB(S, 0xF8); EB(S, 0x3F); # sar rax, 63 (BOOL->0/-1)
    return 0;
}

# emit Win64 open: `syscall(2, path, flags, mode)` →
# CreateFileW(lpFileName, dwDesiredAccess, dwShareMode,
#             lpSecurityAttributes, dwCreationDisposition,
#             dwFlagsAndAttributes, hTemplateFile).
# Stack on entry (top→bottom): [mode] [flags] [path] [sc_nr=2].
#
# v5.5.1 simplifications (document in CHANGELOG):
#  1. `path` is widened inline from UTF-8 to UTF-16LE assuming
#     ASCII bytes (copy each byte as a WCHAR). Non-ASCII paths
#     will not round-trip correctly; proper UTF-8→UTF-16 is a
#     v5.5.x+ refinement when Windows filesystem tests need it.
#  2. `dwDesiredAccess` is hardcoded to GENERIC_READ|GENERIC_WRITE
#     (0xC0000000) regardless of O_RDONLY / O_WRONLY / O_RDWR.
#     Generous but lets a single reroute cover all three modes.
#  3. `dwCreationDisposition` derives from the O_CREAT bit only:
#     OPEN_EXISTING (3) if clear, OPEN_ALWAYS (4) if set. O_TRUNC
#     / O_EXCL refinements are deferred — most downstream code
#     opens existing or open-or-create, covered by this pair.
#
# Frame layout (0x258 = 600 B; v5.11.23 alignment fix from 0x250):
#   [rsp+0x000..0x01F]  shadow space (32 B, Win64 ABI)
#   [rsp+0x020]         dwCreationDisposition stack arg (8 B)
#   [rsp+0x028]         dwFlagsAndAttributes stack arg (8 B)
#   [rsp+0x030]         hTemplateFile stack arg (8 B, = 0)
#   [rsp+0x038..0x247]  widened UTF-16 path buffer (528 B ≈ 264 WCHARs)
#   [rsp+0x248..0x257]  16 B align pad (was 8 B at 0x250 pre-v5.11.23)
#
# v5.11.23 alignment fix: original 0x250 left RSP misaligned by 8
# at the CALL. Win64 ABI requires 16-aligned RSP at CALL; cyrius's
# 4-arg syscall (sc_nr+path+flags+mode) leaves pre-sub RSP at 16k+8,
# and 0x250 mod 16 = 0 preserves the +8 misalignment. kernel32 path
# APIs detect this in ntdll!+0x41912 and access-violate.
# 0x258 mod 16 = 8 → cancels the +8 → RSP 16-aligned at CALL.
# Wine 11.8 tolerated 0x250; cass (Win11 26200) does not.
# The `_pe_exit_gate` only tested exit42 + hello-world (frames
# happened to align by coincidence given their syscall arities);
# never exercised a path API, masking this for an unknown number
# of minors. v5.11.23 adds `_pe_path_apis_gate` to lock the fix.
fn EOPEN_PE(S): i64 {
    _pe_ensure_createf(S);
    var cf_idx = _pe_createf_get();

    EB(S, 0x58);                                        # pop rax (mode, ignored)
    EB(S, 0x58);                                        # pop rax (flags)
    # Derive disposition = 3 + ((flags >> 6) & 1); result in r10d.
    EB(S, 0xC1); EB(S, 0xE8); EB(S, 0x06);              # shr eax, 6
    EB(S, 0x83); EB(S, 0xE0); EB(S, 0x01);              # and eax, 1
    EB(S, 0x83); EB(S, 0xC0); EB(S, 0x03);              # add eax, 3
    EB(S, 0x41); EB(S, 0x89); EB(S, 0xC2);              # mov r10d, eax
    EB(S, 0x58);                                        # pop rax (path ptr)
    EB(S, 0x49); EB(S, 0x89); EB(S, 0xC3);              # mov r11, rax (stash path)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x08); # add rsp, 8 (drop sc_nr)

    # Allocate frame 0x258 (16-aligns RSP at the call — v5.11.23 fix).
    EB(S, 0x48); EB(S, 0x81); EB(S, 0xEC);
    EB(S, 0x58); EB(S, 0x02); EB(S, 0x00); EB(S, 0x00);

    # rsi = r11 (source UTF-8); rdi = rsp+0x38 (dest UTF-16).
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0xDE);              # mov rsi, r11
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x7C); EB(S, 0x24); EB(S, 0x38); # lea rdi, [rsp+0x38]
    EB(S, 0x31); EB(S, 0xC9);                           # xor ecx, ecx

    # widen_loop: 24 bytes total.
    EB(S, 0x0F); EB(S, 0xB6); EB(S, 0x04); EB(S, 0x0E); # movzx eax, byte [rsi+rcx]
    EB(S, 0x66); EB(S, 0x89); EB(S, 0x04); EB(S, 0x4F); # mov [rdi+rcx*2], ax
    EB(S, 0x85); EB(S, 0xC0);                           # test eax, eax
    EB(S, 0x74); EB(S, 0x0C);                           # jz widen_done (skip next 12 B)
    EB(S, 0xFF); EB(S, 0xC1);                           # inc ecx
    EB(S, 0x81); EB(S, 0xF9); EB(S, 0x04); EB(S, 0x01); EB(S, 0x00); EB(S, 0x00); # cmp ecx, 260
    EB(S, 0x73); EB(S, 0x02);                           # jae widen_done (skip next 2 B)
    EB(S, 0xEB); EB(S, 0xE8);                           # jmp widen_loop (-24)
    # widen_done: force NUL WCHAR terminator in case we hit the cap.
    EB(S, 0x66); EB(S, 0xC7); EB(S, 0x04); EB(S, 0x4F); EB(S, 0x00); EB(S, 0x00); # mov word [rdi+rcx*2], 0

    # Set up CreateFileW args.
    EB(S, 0x48); EB(S, 0x8D); EB(S, 0x4C); EB(S, 0x24); EB(S, 0x38); # lea rcx, [rsp+0x38]
    EB(S, 0xBA); EB(S, 0x00); EB(S, 0x00); EB(S, 0x00); EB(S, 0xC0); # mov edx, 0xC0000000 (GENERIC_READ|GENERIC_WRITE)
    EB(S, 0x41); EB(S, 0xB8); EB(S, 0x03); EB(S, 0x00); EB(S, 0x00); EB(S, 0x00); # mov r8d, 3 (FILE_SHARE_READ|WRITE)
    EB(S, 0x4D); EB(S, 0x31); EB(S, 0xC9);                           # xor r9, r9
    EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x20); # mov [rsp+0x20], r10 (dwCreationDisposition)
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0x44); EB(S, 0x24); EB(S, 0x28); # mov qword [rsp+0x28], 0x80 (FILE_ATTRIBUTE_NORMAL)
    EB(S, 0x80); EB(S, 0x00); EB(S, 0x00); EB(S, 0x00);
    EB(S, 0x48); EB(S, 0xC7); EB(S, 0x44); EB(S, 0x24); EB(S, 0x30); # mov qword [rsp+0x30], 0 (hTemplateFile)
    EB(S, 0x00); EB(S, 0x00); EB(S, 0x00); EB(S, 0x00);

    EB(S, 0xFF); EB(S, 0x15);                           # call [rip+CreateFileW]
    _pe_iat_fixup_add(S, GCP(S), cf_idx);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

    EB(S, 0x48); EB(S, 0x81); EB(S, 0xC4);              # add rsp, 0x258
    EB(S, 0x58); EB(S, 0x02); EB(S, 0x00); EB(S, 0x00);
    return 0;
}

# ================================================================
# SETCC — comparison to value (0 or 1 in rax)
# Emit: cmp rax, rcx; setCC al; movzx rax, al
# ================================================================

# emit setCC: cmp rax,rcx; setCC al; movzx rax,al → rax = 0 or 1
# op: 17=EQ, 18=NEQ, 19=LT, 20=GT, 21=LTE, 22=GTE
fn ESETCC(S, op): i64 {
    # v5.6.15: IR order must match byte order. Previously IR_SETCC
    # was recorded BEFORE ECMPR, so the IR stream read SETCC→CMP
    # while the actual bytes emitted cmp→setcc. Any IR-walking pass
    # (LASE, const-fold, liveness, DCE) saw CMP's flags as "defined
    # after SETCC consumed them" which is false — CMP defines flags
    # that SETCC reads. Record IR_CMP first (via ECMPR), then
    # IR_SETCC, so the IR stream matches the byte-emit stream.
    ECMPR(S);
    if (_IR_REC1(S, IR_SETCC, op) == 1) { return 0; }
    # setCC al (0F xx C0)
    EB(S, 0x0F);
    if (op == 17) { EB(S, 0x94); }
    if (op == 18) { EB(S, 0x95); }
    if (op == 19) { EB(S, 0x9C); }
    if (op == 20) { EB(S, 0x9F); }
    if (op == 21) { EB(S, 0x9E); }
    if (op == 22) { EB(S, 0x9D); }
    EB(S, 0xC0);
    # movzx rax, al (48 0F B6 C0)
    EB(S, 0x48); EB(S, 0x0F); EB(S, 0xB6); EB(S, 0xC0);
    return 0;
}

# ================================================================
# FUNCTION CALLING CONVENTION (x86_64 System V ABI)
# ================================================================

# Emit push rbp; mov rbp, rsp
fn EFNPRO(S): i64 {
    if (_IR_REC0(S, IR_PROLOGUE) == 1) { return 0; }
    EB(S, 0x55);       # push rbp
    E3(S, 0xE58948);   # mov rbp, rsp
    return 0;
}

# Emit sub rsp, imm32 — returns patch offset for the imm32.
#
# Under _TARGET_PE (v5.5.36): emit an inline __chkstk-equivalent
# probe sequence that walks the frame in 4 KB steps, touching each
# page so Windows kernel-mode guard-page handler commits them in
# order. Required for any fn with a frame ≥ 4 KB on Win64 — the
# `sub rsp, N` alone skips past the guard, yielding
# STATUS_STACK_OVERFLOW on first memory access inside the new
# frame. Always emitting the probe (vs conditional on frame size)
# costs ~25 bytes per fn but avoids a two-phase emit — correctness
# is unconditional, runtime overhead on small frames is one
# `cmp rsp, rcx; jbe .done` (then the final `mov rsp, rcx` does
# the whole sub at once).
#
# 32-byte PE block (v5.5.36 uses R11 — volatile scratch on BOTH ABIs
# AND not an arg reg on either, so the probe doesn't clobber RCX
# which the Win64 ABI uses for the first argument, including the
# hidden retptr of a struct-returning fn — Phase 2b depends on this):
#   [ 0] B8 xx xx xx xx       mov eax, imm32   (patched = frame size)
#   [ 5] 49 89 E3             mov r11, rsp
#   [ 8] 49 29 C3             sub r11, rax     (r11 = target rsp)
#   [11] 4C 39 DC             cmp rsp, r11     (.probe label)
#   [14] 76 0D                jbe .done
#   [16] 48 81 EC 00 10 00 00 sub rsp, 0x1000
#   [23] 48 89 24 24          mov [rsp], rsp   (touches new page top)
#   [27] EB EE                jmp .probe       (rel8 = -18)
#   [29] 4C 89 DC             mov rsp, r11     (.done — exact adjust)
fn ESUBRSP(S): i64 {
    var _ire = IR_ENABLED(S); if (_ire >= 1) { ir_emit0(S, IR_ALLOC_FRAME); }
    if (_TARGET_PE == 1) {
        EB(S, 0xB8);                                   # mov eax, imm32
        var patch = GCP(S);
        EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);        # imm32 placeholder
        EB(S, 0x49); EB(S, 0x89); EB(S, 0xE3);         # mov r11, rsp
        EB(S, 0x49); EB(S, 0x29); EB(S, 0xC3);         # sub r11, rax
        EB(S, 0x4C); EB(S, 0x39); EB(S, 0xDC);         # cmp rsp, r11  (.probe)
        EB(S, 0x76); EB(S, 0x0D);                      # jbe .done (+13)
        EB(S, 0x48); EB(S, 0x81); EB(S, 0xEC);         # sub rsp, 0x1000
        EB(S, 0x00); EB(S, 0x10); EB(S, 0x00); EB(S, 0x00);
        EB(S, 0x48); EB(S, 0x89); EB(S, 0x24); EB(S, 0x24); # mov [rsp], rsp
        EB(S, 0xEB); EB(S, 0xEE);                      # jmp .probe (-18)
        EB(S, 0x4C); EB(S, 0x89); EB(S, 0xDC);         # mov rsp, r11  (.done)
        return patch;
    }
    E3(S, 0xEC8148);
    var patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    return patch;
}

# Emit leave; ret
fn EFNEPI(S): i64 {
    if (_IR_REC0(S, IR_EPILOGUE) == 1) { return 0; }
    E2(S, 0xC3C9);     # leave; ret
    return 0;
}

# v5.11.35 path-A named ops — Class D refactor (parser-to-emit
# named-op refactor). Replaces unconditionally-emitted x86 byte
# sequences in parse_*.cyr with named ops that each backend
# implements. parse_*.cyr drops its `_TARGET_CX == 0 &&
# _AARCH64_BACKEND == 0` guards; dispatch lives here instead.
# See docs/audit/2026-04-27-cx-direct-emit-inventory.md.

# EREGALLOC_SAVE — save first `n` callee-saved regs to
# `[rbp-8*i]` slots reserved by EFNPRO+ESUBRSP. x86 SysV / PE
# callee-save list: rbx, r12, r13, r14, r15. Called from
# parse_fn.cyr at fn prologue when `_cur_fn_regalloc > 0`.
fn EREGALLOC_SAVE(S, n): i64 {
    if (n >= 1) { _IR_REC0(S, IR_RAW_EMIT); }
    if (n >= 1) { E3(S, 0x5D8948); EB(S, 0xF8); }  # mov [rbp-8], rbx
    if (n >= 2) { E3(S, 0x65894C); EB(S, 0xF0); }  # mov [rbp-16], r12
    if (n >= 3) { E3(S, 0x6D894C); EB(S, 0xE8); }  # mov [rbp-24], r13
    if (n >= 4) { E3(S, 0x75894C); EB(S, 0xE0); }  # mov [rbp-32], r14
    if (n >= 5) { E3(S, 0x7D894C); EB(S, 0xD8); }  # mov [rbp-40], r15
    return 0;
}

# EREGALLOC_RESTORE — mirror of EREGALLOC_SAVE for fn epilogue.
# Restores in reverse order so `mov rbx, [rbp-8]` is the last
# load before leave/ret.
fn EREGALLOC_RESTORE(S, n): i64 {
    if (n >= 1) { _IR_REC0(S, IR_RAW_EMIT); }
    if (n >= 5) { E3(S, 0x7D8B4C); EB(S, 0xD8); }  # mov r15, [rbp-40]
    if (n >= 4) { E3(S, 0x758B4C); EB(S, 0xE0); }  # mov r14, [rbp-32]
    if (n >= 3) { E3(S, 0x6D8B4C); EB(S, 0xE8); }  # mov r13, [rbp-24]
    if (n >= 2) { E3(S, 0x658B4C); EB(S, 0xF0); }  # mov r12, [rbp-16]
    if (n >= 1) { E3(S, 0x5D8B48); EB(S, 0xF8); }  # mov rbx, [rbp-8]
    return 0;
}

# EDROPI64 — discard top 8 bytes of stack (`add rsp, 8`).
# Used by PE-target syscall stubs to pop the syscall-number
# argument after the inner emit (EPOPR rax = real arg) has
# consumed the lower stack slot. PE is x86-only; aarch64/cx
# stubs are no-ops because the calling path never reaches them.
fn EDROPI64(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0x48); EB(S, 0x83);
    EB(S, 0xC4); EB(S, 0x08);
    return 0;
}

# v5.11.36 path-A named ops — Class B refactor (PIC-vs-direct
# address loads). x86 splits between PIC (`_IS_OBJ` mode →
# `lea rax, [rip+disp32]`) and direct exec (`movabs rax, imm64`).
# Records a fixup-type-3 entry at `fnaddr` so the linker patches
# the placeholder when the target fn's address is known.

# ELOAD_FN_ADDR — load fn-address into rax (x86) / x0 (aarch64).
# Used by `&fn_name` and closure-fn literal sites in parse_expr.cyr.
# `fnaddr` = pre-allocated fixup-table slot at `S+0x107B000+fc*16`;
# `fc` = current fixup-table index (named op bumps SFCNT internally);
# `fni` = fn index recorded in the fixup metadata word.
fn ELOAD_FN_ADDR(S, fnaddr, fc, fni): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    if (_IS_OBJ(S) == 1) {
        # LEA rax, [rip+disp32]: 48 8D 05 <rel32> (PIC-safe)
        EB(S, 0x48); EB(S, 0x8D); EB(S, 0x05);
        S64(fnaddr, GCP(S));
        S64(fnaddr + 8, (3 << 56) | fni);
        SFCNT(S, fc + 1);
        EDISP32(S, 0);
    } else {
        # MOVABS rax, imm64: 48 B8 <imm64>
        E2(S, 0xB848);
        S64(fnaddr, GCP(S));
        S64(fnaddr + 8, (3 << 56) | fni);
        SFCNT(S, fc + 1);
        E8(S, 0);
    }
    return 0;
}

# ELOAD_LOCAL_ADDR — load address of local at rbp-relative
# `adisp` (negative) into rax. x86: `lea rax, [rbp+disp32]`
# (7 bytes; disp32 patched in-place via direct buffer write).
fn ELOAD_LOCAL_ADDR(S, adisp): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    E3(S, 0x858D48);
    var aaddr = _codebuf_base + GCP(S);
    S64(aaddr, (L64(aaddr) >> 32 << 32) | (adisp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# v5.11.37 path-A named ops — Class C refactor (f64 unary ops).
# x86 uses SSE2 (subsd) for f64_neg and x87 (fsin/fcos/fyl2x/etc.)
# for transcendentals. aarch64 has native fneg but errors / dispatches
# to lib/math.cyr polyfills for transcendentals. cx has no f64
# opcodes in this slot (real CYX f64 ops = future work). Closes
# Class C of docs/audit/2026-04-27-cx-direct-emit-inventory.md.

# EF64_NEG — `-x` for f64. x86 SSE: subsd xmm1, xmm0 with
# xmm1 zeroed (XORPD), result moves back through xmm0 → rax.
fn EF64_NEG(S): i64 {
    EMOVQ_X0_A(S);
    EXORPD_X1(S);
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x5C); EB(S, 0xC8);  # subsd xmm1, xmm0
    EMOVAPD_01(S);
    EMOVQ_A_X0(S);
    return 0;
}

# EF64_SIN — x87 fsin (D9 FE).
fn EF64_SIN(S): i64 {
    EX87PUSH(S);
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0xD9); EB(S, 0xFE);
    EX87POP(S);
    return 0;
}

# EF64_COS — x87 fcos (D9 FF).
fn EF64_COS(S): i64 {
    EX87PUSH(S);
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0xD9); EB(S, 0xFF);
    EX87POP(S);
    return 0;
}

# EF64_EXP — x87 fldl2e; fmulp; fld st0; frndint; fsub st1,st0;
# fxch; f2xm1; fld1; faddp; fscale; fstp st1 (22 bytes).
fn EF64_EXP(S): i64 {
    EX87PUSH(S);
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0xD9); EB(S, 0xEA); EB(S, 0xDE); EB(S, 0xC9); EB(S, 0xD9); EB(S, 0xC0);
    EB(S, 0xD9); EB(S, 0xFC); EB(S, 0xDC); EB(S, 0xE9); EB(S, 0xD9); EB(S, 0xC9);
    EB(S, 0xD9); EB(S, 0xF0); EB(S, 0xD9); EB(S, 0xE8); EB(S, 0xDE); EB(S, 0xC1);
    EB(S, 0xD9); EB(S, 0xFD); EB(S, 0xDD); EB(S, 0xD9);
    EX87POP(S);
    return 0;
}

# EF64_LN — x87 fldln2; fxch; fyl2x (6 bytes).
fn EF64_LN(S): i64 {
    EX87PUSH(S);
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0xD9); EB(S, 0xED); EB(S, 0xD9); EB(S, 0xC9); EB(S, 0xD9); EB(S, 0xF1);
    EX87POP(S);
    return 0;
}

# EF64_LOG2 — x87 fld1; fxch; fyl2x (6 bytes).
fn EF64_LOG2(S): i64 {
    EX87PUSH(S);
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0xD9); EB(S, 0xE8); EB(S, 0xD9); EB(S, 0xC9); EB(S, 0xD9); EB(S, 0xF1);
    EX87POP(S);
    return 0;
}

# EF64_EXP2 — x87 fld st0; frndint; fsub st1,st0; fxch;
# f2xm1; fld1; faddp; fscale; fstp st1 (18 bytes).
fn EF64_EXP2(S): i64 {
    EX87PUSH(S);
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0xD9); EB(S, 0xC0); EB(S, 0xD9); EB(S, 0xFC); EB(S, 0xDC); EB(S, 0xE9);
    EB(S, 0xD9); EB(S, 0xC9); EB(S, 0xD9); EB(S, 0xF0); EB(S, 0xD9); EB(S, 0xE8);
    EB(S, 0xDE); EB(S, 0xC1); EB(S, 0xD9); EB(S, 0xFD); EB(S, 0xDD); EB(S, 0xD9);
    EX87POP(S);
    return 0;
}

# EF64_ABS — `|x|` for f64. Peephole over the previous 5-instr
# sequence (`push rax ; movabs rax, mask ; mov rcx, rax ; pop rax ;
# and rax, rcx` = 18 bytes). New: `movabs rcx, 0x7FFFFFFFFFFFFFFF ;
# and rax, rcx` = 13 bytes — save 5 bytes per call site. Pinned
# in `docs/audit/2026-05-01-pre-5.8.0-audit.md` § Optimization
# Opportunities; landed at v5.11.40 after the path-A arc.
fn EF64_ABS(S): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    # movabs rcx, 0x7FFFFFFFFFFFFFFF (REX.W=48, opcode B9+rcx, 8-byte LE imm)
    EB(S, 0x48); EB(S, 0xB9);
    EB(S, 0xFF); EB(S, 0xFF); EB(S, 0xFF); EB(S, 0xFF);
    EB(S, 0xFF); EB(S, 0xFF); EB(S, 0xFF); EB(S, 0x7F);
    # and rax, rcx (48 21 C8)
    EB(S, 0x48); EB(S, 0x21); EB(S, 0xC8);
    return 0;
}

# EF64_ATAN — x87 fld1; fpatan (4 bytes).
fn EF64_ATAN(S): i64 {
    EX87PUSH(S);
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0xD9); EB(S, 0xE8); EB(S, 0xD9); EB(S, 0xF3);
    EX87POP(S);
    return 0;
}

# v5.11.39 path-A named ops — switch-table dispatch (closes
# parse.cyr's pre-arc direct-emit block at lines ~217-243). x86
# emits a `sub/cmp/ja-default/lea/movsxd/add/jmp/<zero-table>`
# sequence; aarch64/cx never enter this path because parse.cyr
# gates `use_table = 0` for both before reaching the dispatch.
# Closes the parse.cyr exclusion in `_parse_emit_drift_gate`.

# ESWITCH_DISPATCH_PRE — emit the rax-range-check prelude:
#   sub rax, case_min ; cmp rax, range
# Both use the EMOVI→EMOVCA shuttle via rcx (which is why the
# named-op wraps EPUSHR/EPOPR pairs around each immediate setup).
# Parser follows this with `EJCC(S, 0x87)` for `ja default`.
fn ESWITCH_DISPATCH_PRE(S, case_min, range): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EPUSHR(S); EMOVI(S, case_min); EMOVCA(S); EPOPR(S);
    E3(S, 0xC82948);     # sub rax, rcx
    EPUSHR(S); EMOVI(S, range); EMOVCA(S); EPOPR(S);
    E3(S, 0xC83948);     # cmp rax, rcx
    return 0;
}

# ESWITCH_DISPATCH_TABLE — emit the rip-relative table dispatch +
# reserve (range+1) × 4 bytes of zero-init table. Returns
# `table_cp` (the codebuf offset of the table base) so the
# parser can patch entry N via
# `S + 0x41A000 + table_cp + (val - case_min) * 4`.
# Sequence: lea rcx, [rip+placeholder] ; movsxd rax, [rcx+rax*4] ;
#           add rax, rcx ; jmp rax ; <(range+1) × 4 zeroes>.
# The lea's disp32 placeholder is patched in-place to point at
# `table_cp` (= GCP after the jmp emit) before the zero table is
# written — keeps the patch arithmetic local to the named op.
fn ESWITCH_DISPATCH_TABLE(S, range): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    E3(S, 0x0D8D48);     # lea rcx, [rip+disp32]
    var lea_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);  # disp32 placeholder
    EB(S, 0x48); EB(S, 0x63); EB(S, 0x04); EB(S, 0x81);  # movsxd rax, [rcx+rax*4]
    E3(S, 0xC80148);     # add rax, rcx
    E2(S, 0xE0FF);       # jmp rax
    var table_cp = GCP(S);
    var lea_disp = table_cp - lea_patch - 4;
    var la = _codebuf_base + lea_patch;
    S64(la, (L64(la) >> 32 << 32) | (lea_disp & 0xFFFFFFFF));
    # Table data — not code. Mark raw so DBE/LASE ignore the range.
    _IR_REC0(S, IR_RAW_EMIT);
    var ti = 0;
    while (ti <= range) { EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0); ti = ti + 1; }
    return table_cp;
}

# EF64_CMP — f64 comparison (`==`, `<`, `>`). Class B missed-site
# closed at v5.11.38. Stack on entry: top = a, second = b (pushed
# earlier). Result in rax: 1 if cmp holds, 0 otherwise.
# tok: 68=eq, 69=lt, 70=gt. x86 uses UCOMISD + SETcc; the
# `mov rax, rcx` and `mov rcx, rax` shuffles handle the SSE-vs-
# integer-register move pair.
fn EF64_CMP(S, tok): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC8);  # mov rax, rcx
    EMOVQ_X0_A(S);
    EPOPR(S);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);  # mov rcx, rax
    EMOVQ_X1_C(S);
    EUCOMISD(S);
    EB(S, 0xB8); EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);  # mov eax, 0
    if (tok == 68) { EB(S, 0x0F); EB(S, 0x94); EB(S, 0xC0); }  # sete al
    if (tok == 69) { EB(S, 0x0F); EB(S, 0x92); EB(S, 0xC0); }  # setb al  (ordered <)
    if (tok == 70) { EB(S, 0x0F); EB(S, 0x97); EB(S, 0xC0); }  # seta al  (ordered >)
    # v6.2.19: f64 comparison-operator sugar (ops 17-22 == != < > <= >=).
    # ucomisd a,b flags: a<b→CF, a==b→ZF. Matches the f64_lt/gt/eq builtin semantics.
    if (tok == 17) { EB(S, 0x0F); EB(S, 0x94); EB(S, 0xC0); }  # ==  sete
    if (tok == 18) { EB(S, 0x0F); EB(S, 0x95); EB(S, 0xC0); }  # !=  setne
    if (tok == 19) { EB(S, 0x0F); EB(S, 0x92); EB(S, 0xC0); }  # <   setb
    if (tok == 20) { EB(S, 0x0F); EB(S, 0x97); EB(S, 0xC0); }  # >   seta
    if (tok == 21) { EB(S, 0x0F); EB(S, 0x96); EB(S, 0xC0); }  # <=  setbe
    if (tok == 22) { EB(S, 0x0F); EB(S, 0x93); EB(S, 0xC0); }  # >=  setae
    # v6.2.41 IEEE-754 NaN-correctness (issue 2026-06-24-f64-le-nan-comparison).
    # ucomisd sets PF (parity) when either operand is NaN (unordered); it ALSO
    # sets CF=ZF=1, so the CF/ZF-reading conditions (setb/sete/setbe/setne) fire
    # on NaN when IEEE says every ordered compare must be false (and != true).
    # Fold the parity flag in: ordered compares (==,<,<=, and the eq/lt builtins)
    # AND with !PF → forced 0 on NaN; != ORs with PF → forced 1 on NaN. seta/setae
    # (>,>=,gt-builtin) read CF and are already 0 on NaN, so they're left alone.
    var nan_and = 0;
    if (tok == 68) { nan_and = 1; }   # eq builtin
    if (tok == 69) { nan_and = 1; }   # lt builtin
    if (tok == 17) { nan_and = 1; }   # ==
    if (tok == 19) { nan_and = 1; }   # <
    if (tok == 21) { nan_and = 1; }   # <=
    if (nan_and == 1) {
        EB(S, 0x0F); EB(S, 0x9B); EB(S, 0xC1);  # setnp cl
        EB(S, 0x20); EB(S, 0xC8);               # and al, cl
    }
    if (tok == 18) {                            # != is true on unordered
        EB(S, 0x0F); EB(S, 0x9A); EB(S, 0xC1);  # setp cl
        EB(S, 0x08); EB(S, 0xC8);               # or al, cl
    }
    EB(S, 0x0F); EB(S, 0xB6); EB(S, 0xC0);  # movzx eax, al
    return 0;
}

# v6.4.56 (scalar-float D2) — f32 scalar compare. Mirror of EF64_CMP but single-
# precision: transfer via movd (f32 bits in low 32) and ucomiss (0F 2E C1, NO 66
# prefix) instead of the movq shuttles + ucomisd (66 0F 2E C1). ucomiss sets
# CF/ZF/PF exactly as ucomisd, so the setcc ladder AND the IEEE-754 NaN parity
# fold (setnp/and for ordered ==,<,<=,eq,lt; setp/or for !=) are byte-for-byte
# reusable. Entry (from _PLOGIC_ATOM): rcx = a (lhs), rax pushed = b (rhs).
fn EF32_CMP(S, tok): i64 {
    _IR_REC0(S, IR_RAW_EMIT);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC8);              # mov rax, rcx  (a)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC0); # movd xmm0, eax  (a)
    EPOPR(S);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax  (b)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC9); # movd xmm1, ecx  (b)
    EB(S, 0x0F); EB(S, 0x2E); EB(S, 0xC1);              # ucomiss xmm0, xmm1
    EB(S, 0xB8); EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);  # mov eax, 0
    if (tok == 68) { EB(S, 0x0F); EB(S, 0x94); EB(S, 0xC0); }  # sete al   (eq builtin)
    if (tok == 69) { EB(S, 0x0F); EB(S, 0x92); EB(S, 0xC0); }  # setb al   (lt builtin, ordered <)
    if (tok == 70) { EB(S, 0x0F); EB(S, 0x97); EB(S, 0xC0); }  # seta al   (gt builtin, ordered >)
    if (tok == 17) { EB(S, 0x0F); EB(S, 0x94); EB(S, 0xC0); }  # ==  sete
    if (tok == 18) { EB(S, 0x0F); EB(S, 0x95); EB(S, 0xC0); }  # !=  setne
    if (tok == 19) { EB(S, 0x0F); EB(S, 0x92); EB(S, 0xC0); }  # <   setb
    if (tok == 20) { EB(S, 0x0F); EB(S, 0x97); EB(S, 0xC0); }  # >   seta
    if (tok == 21) { EB(S, 0x0F); EB(S, 0x96); EB(S, 0xC0); }  # <=  setbe
    if (tok == 22) { EB(S, 0x0F); EB(S, 0x93); EB(S, 0xC0); }  # >=  setae
    var nan_and = 0;
    if (tok == 68) { nan_and = 1; }
    if (tok == 69) { nan_and = 1; }
    if (tok == 17) { nan_and = 1; }
    if (tok == 19) { nan_and = 1; }
    if (tok == 21) { nan_and = 1; }
    if (nan_and == 1) {
        EB(S, 0x0F); EB(S, 0x9B); EB(S, 0xC1);  # setnp cl
        EB(S, 0x20); EB(S, 0xC8);               # and al, cl
    }
    if (tok == 18) {
        EB(S, 0x0F); EB(S, 0x9A); EB(S, 0xC1);  # setp cl
        EB(S, 0x08); EB(S, 0xC8);               # or al, cl
    }
    EB(S, 0x0F); EB(S, 0xB6); EB(S, 0xC0);  # movzx eax, al
    return 0;
}

# Emit call rel32 to known target
fn ECALLTO(S, target): i64 {
    var _ire = IR_ENABLED(S); if (_ire >= 1) { ir_emit(S, IR_CALL_KNOWN, 0, 0, target); }
    EB(S, 0xE8);
    var cp = GCP(S);
    var rel = target - cp - 4;
    var addr = _codebuf_base + cp;
    S64(addr, (L64(addr) >> 32 << 32) | (rel & 0xFFFFFFFF));
    SCP(S, cp + 4);
    # v5.6.27: record disp32 source CP for codebuf-compaction repair.
    var _jsc = L64(S + 0x1A0000);
    if (_jsc < 1024) {
        S64(S + 0x1A0008 + _jsc * 8, cp);
        S64(S + 0x1A0000, _jsc + 1);
    }
    # v5.6.21: callee may set flags arbitrarily; rax = return value.
    _flags_reflect_rax = 0;
    return 0;
}

# Emit call placeholder, record type-2 fixup
fn ECALLFIX(S, fnidx): i64 {
    if (_IR_REC1(S, IR_CALL, fnidx) == 1) { return 0; }
    EB(S, 0xE8);
    var poff = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    var fc = GFCNT(S);
    var faddr = _fixup_base + fc * 16;
    S64(faddr, poff);
    S64(faddr + 8, (2 << 56) | fnidx);
    SFCNT(S, fc + 1);
    # v5.6.21: callee may set flags arbitrarily; rax = return value.
    _flags_reflect_rax = 0;
    return 0;
}

# v6.0.70 §0 — indirect call through a callee pointer spilled to local
# `idx`. The callptr builtin evaluates the callee + stores it to a FRESH
# frame slot BEFORE pushing the args, so it survives ECALLPOPS — which on
# Win64 does `sub rsp, 0x20` for the shadow home and would bury a
# stack-pushed callee below rsp. `call [rbp+disp]` is rbp-relative
# (unaffected by ECALLPOPS's rsp moves) and clobbers no arg register, so
# it works for every ABI + arg count. disp mirrors the local-var formula
# (EFLLOAD_W: regalloc + ret_stash offsets). FF /2, mod=10, rm=101 (rbp).
fn ECALLIND(S, idx): i64 {
    if (_IR_REC1(S, IR_CALL_INDIRECT, idx) == 1) { return 0; }
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    EB(S, 0xFF); EB(S, 0x95);     # call [rbp + disp32]
    EDISP32(S, disp);
    _flags_reflect_rax = 0;       # callee clobbers flags; rax = return value
    return 0;
}

# Emit pop into arg register for arg N.
# SysV x86_64: n=0..5 → rdi/rsi/rdx/rcx/r8/r9.
# Win64   (v5.5.3): n=0..3 → rcx/rdx/r8/r9. n>=4 falls through to
# the SysV encoding (incorrect on Win64 — proper stack-arg handling
# queued for v5.5.4). Cyrius-to-cyrius call sites with >=5 args are
# out of scope for v5.5.3 and will mis-compile under CYRIUS_TARGET_WIN
# until v5.5.4 lands the shadow-space + stack-arg shuttle.
fn EPOPARG(S, n): i64 {
    if (_TARGET_PE == 1) {
        if (n == 0) { EB(S, 0x59); return 0; }     # pop rcx  (arg 0)
        if (n == 1) { EB(S, 0x5A); return 0; }     # pop rdx  (arg 1)
        if (n == 2) { E2(S, 0x5841); return 0; }   # pop r8   (arg 2)
        if (n == 3) { E2(S, 0x5941); return 0; }   # pop r9   (arg 3)
    }
    if (n == 0) { EB(S, 0x5F); return 0; }
    if (n == 1) { EB(S, 0x5E); return 0; }
    if (n == 2) { EB(S, 0x5A); return 0; }
    if (n == 3) { EB(S, 0x59); return 0; }
    if (n == 4) { E2(S, 0x5841); return 0; }
    if (n == 5) { E2(S, 0x5941); return 0; }
    return 0;
}

# Emit fn call pops for N args.
# Args pushed left-to-right: stack = [a1..aN] with aN on top.
# For ≤6: pop top N → registers. Pop order (r9,r8,rcx,rdx,rsi,rdi) reverses
#   the push order, giving rdi=a1, rsi=a2, etc.
# v6.0.57: emit `mov reg, [rsp+disp]` (op=0x8B) or `mov [rsp+disp], reg`
# (op=0x89), auto-selecting the disp8 (mod=01) vs disp32 (mod=10) ModRM form
# so a large arg frame doesn't overflow the signed disp8 (+127). `rex` is
# 0x48 (or 0x4C for r8-r15, REX.R+W), `reg3` the low 3 bits of the register.
# Byte-identical to the old hardcoded disp8 emit when disp < 128, so small
# (<= 16-arg) calls are unchanged. Closes the >16-arg ECALLPOPS param scramble
# (issue 2026-04-26-cc5-18-arg-fn-scrambles-params.md): at 17 args, (n-1)*8 =
# 128 > 127, so the disp8 sign-wrapped negative and read garbage below rsp.
fn _emov_rsp_disp(S, rex, op, reg3, disp): i64 {
    EB(S, rex); EB(S, op);
    if (disp < 128) {
        EB(S, 0x40 + reg3 * 8 + 0x04);   # mod=01 (disp8), reg=reg3, rm=100 (SIB)
        EB(S, 0x24);                       # SIB: base=rsp, no index
        EB(S, disp);
    } else {
        EB(S, 0x80 + reg3 * 8 + 0x04);   # mod=10 (disp32)
        EB(S, 0x24);
        EDISP32(S, disp);
    }
    return 0;
}

# For >6: the top (n-6) items are stack args that must stay on the stack.
#   Pop them to temp (r11), pop 6 register args, push them back.
fn ECALLPOPS(S, n): i64 {
    if (_IR_REC1(S, IR_CALL_POPS, n) == 1) { return 0; }
    # Win64 path (v5.5.7 strict-compliance): always allocate 32 B
    # shadow home area at cyrius-to-cyrius call sites. v5.5.4
    # shipped without shadow as an intentional shortcut (callees
    # spill arg regs to their own locals), but that broke
    # C-FFI-via-fnptr — a Win64 C callee expects the shadow
    # region to spill into. v5.5.7 lifts strict compliance so
    # both cyrius and C callees work identically.
    #
    # For N≤4: `sub rsp, 32` after reg-arg pops.
    # For N>4: total frame = 32 + (N-4)*8, rounded up to 16 for
    # alignment; extras land at [rsp+32..] (above shadow).
    # Matching ESTORESTACKPARM Win64 branch reads stack args at
    # [rbp+16+32+(pidx-4)*8]. fnptr.cyr fncallN allocates shadow
    # the same way.
    if (_TARGET_PE == 1) {
        if (n <= 4) {
            var i = n - 1;
            while (i >= 0) { EPOPARG(S, i); i = i - 1; }
            EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x20);   # sub rsp, 0x20 (shadow)
            return 0;
        }
        # n > 4: shuttle extras, pop register args, write extras
        # to stack at [rsp+0..(nextra-1)*8]. Stack on entry:
        # [a[n-1], a[n-2], …, a[0]] with a[n-1] on top.
        # Max nextra = 5 (v5.5.6 extended from v5.5.4's 4) to
        # accommodate fncall8 which takes 9 params (fp + 8 args =
        # N=9 pushes = nextra=5). 5 scratch regs: r10/r11/r14/r15 +
        # r12. No save/restore needed — cyrius fncallN bodies don't
        # read r12 beyond this asm block.
        var nextra = n - 4;
        # Pop extras into r10/r11/r14/r15/r12. First pop = top =
        # a[n-1] → r10; second pop = a[n-2] → r11; etc.
        if (nextra >= 1) { EB(S, 0x58); E3(S, 0xC28949); }   # pop rax; mov r10, rax (a[n-1])
        if (nextra >= 2) { EB(S, 0x58); E3(S, 0xC38949); }   # pop rax; mov r11, rax (a[n-2])
        if (nextra >= 3) { EB(S, 0x58); E3(S, 0xC68949); }   # pop rax; mov r14, rax (a[n-3])
        if (nextra >= 4) { EB(S, 0x58); E3(S, 0xC78949); }   # pop rax; mov r15, rax (a[n-4])
        if (nextra >= 5) { EB(S, 0x58); E3(S, 0xC48949); }   # pop rax; mov r12, rax (a[n-5])
        # Pop 4 register args (stack now has a[3],a[2],a[1],a[0] top-down).
        EB(S, 0x41); EB(S, 0x59);                             # pop r9   (a[3])
        EB(S, 0x41); EB(S, 0x58);                             # pop r8   (a[2])
        EB(S, 0x5A);                                          # pop rdx  (a[1])
        EB(S, 0x59);                                          # pop rcx  (a[0])
        # Allocate 32 B shadow + stack-arg frame (16-aligned).
        # v5.5.7: framesize = 32 (shadow) + nextra*8 (stack args)
        # rounded up to 16.
        var framesize = 32 + nextra * 8;
        if ((framesize & 15) != 0) { framesize = framesize + 8; }
        EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, framesize);  # sub rsp, framesize (imm8)
        # Write extras above shadow at [rsp+32..]. Layout at call:
        #   [rsp+0..31]  = 32 B shadow (callee's arg reg home area)
        #   [rsp+32]     = a[4]
        #   [rsp+40]     = a[5]
        #   [rsp+48]     = a[6]
        #   [rsp+56]     = a[7]
        #   [rsp+64]     = a[8]    (nextra=5 only)
        # Register assignments: r15=a[n-4], r14=a[n-3], r11=a[n-2], r10=a[n-1].
        if (nextra == 1) {
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x20);              # mov [rsp+32], r10 (a[4])
        }
        if (nextra == 2) {
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x5C); EB(S, 0x24); EB(S, 0x20);              # mov [rsp+32], r11 (a[4])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x28);              # mov [rsp+40], r10 (a[5])
        }
        if (nextra == 3) {
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x74); EB(S, 0x24); EB(S, 0x20);              # mov [rsp+32], r14 (a[4])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x5C); EB(S, 0x24); EB(S, 0x28);              # mov [rsp+40], r11 (a[5])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x30);              # mov [rsp+48], r10 (a[6])
        }
        if (nextra == 4) {
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x7C); EB(S, 0x24); EB(S, 0x20);              # mov [rsp+32], r15 (a[4])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x74); EB(S, 0x24); EB(S, 0x28);              # mov [rsp+40], r14 (a[5])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x5C); EB(S, 0x24); EB(S, 0x30);              # mov [rsp+48], r11 (a[6])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x38);              # mov [rsp+56], r10 (a[7])
        }
        if (nextra == 5) {
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x64); EB(S, 0x24); EB(S, 0x20);              # mov [rsp+32], r12 (a[4])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x7C); EB(S, 0x24); EB(S, 0x28);              # mov [rsp+40], r15 (a[5])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x74); EB(S, 0x24); EB(S, 0x30);              # mov [rsp+48], r14 (a[6])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x5C); EB(S, 0x24); EB(S, 0x38);              # mov [rsp+56], r11 (a[7])
            EB(S, 0x4C); EB(S, 0x89); EB(S, 0x54); EB(S, 0x24); EB(S, 0x40);              # mov [rsp+64], r10 (a[8])
        }
        return 0;
    }
    if (n <= 6) {
        var i = n - 1;
        while (i >= 0) { EPOPARG(S, i); i = i - 1; }
        return 0;
    }
    # >6 args (SysV): stack = [a1..aN], aN on top. Need a1..a6 in
    # registers rdi/rsi/rdx/rcx/r8/r9; a7..aN on stack with a7 at top.
    #
    # v5.6.24 fix: the earlier shuttle used r12/r13/r14 as scratch to
    # hold popped extras across the 6 reg-arg pops. r12-r14 are
    # CALLEE-SAVED in SysV; under v5.6.20+ regalloc the picker may
    # pin caller's locals to them, so silent clobber = silent
    # corruption. Surfaced by sandhi M2's `sandhi_http_response_parse`
    # (headers local zeroed by downstream call) and flags.tcyr's
    # `test_defaults` (default_val 7 → 0 when preceding
    # `test_str_short` is auto-regalloc'd) — both match the 8+ arg
    # call signature (flags_add_str takes 5 regs + extras in
    # `_argv(3, ..., 0, 0, 0, 0, 0, 0)`; response_parse called an
    # 8-arg helper).
    #
    # New shuttle: use only r10 (caller-saved) as scratch via direct
    # [rsp+offset] addressing. No pops; all reads via MOV; end with
    # `add rsp, 48` to drop the 6 reg-arg slots. Extras shifted from
    # [rsp+0..(nextra-1)*8] to [rsp+48..48+(nextra-1)*8] (reversed so
    # a7 lands at new [rsp+0]). Old/new positions don't overlap for
    # any nextra in [1, 5].
    var nextra = n - 6;
    # v5.6.41: SysV ABI requires rsp 16-aligned BEFORE every CALL (so the
    # callee sees rsp+8 16-aligned at entry). Caller's body rsp is 16-aligned
    # (prolog enforces it). N pushes leave rsp at R - 8N. For nextra-odd
    # (n=7,9,11), R-8N is 8-aligned, so the pre-fix `add rsp, 48` left rsp
    # at R-8N+48 = R - (nextra*8 - 0) = R - nextra*8 = 8-aligned for odd
    # nextra. Without alignment, the next call's resolved-symbol prologue
    # (any libssl/libc fn that uses SSE on stack-saved values) SIGSEGVs at
    # its first instruction. Win64 path already aligns via line ~1068.
    # Sandhi-filed: 2026-04-25-cyrius-7arg-frame-tls-connect-segfault.md.
    #
    # Fix shape: for odd nextra, shift step-2 writes DOWN by 8 (write to
    # [rsp+40+i*8] instead of [rsp+48+i*8]) and use `add rsp, 40` instead
    # of 48. This drops one less slot, so the extras land 8 bytes deeper
    # in the new frame (= same place from rbp's POV after CALL+push rbp+
    # mov rbp,rsp), and rsp ends up at R - nextra*8 - 8 (16-aligned).
    # Even nextra (n=8,10): no change — already 16-aligned.
    var write_base = 6 * 8;        # = 48: original step-2 write base
    var sp_drop = 0x30;            # = 48: original step-3 drop
    if ((nextra & 1) == 1) {
        write_base = write_base - 8;   # = 40: step-2 writes one slot deeper
        sp_drop = 0x28;                # = 40: step-3 drops one less slot
    }
    # Step 1: load 6 reg args from stack (a_k at [rsp+(n-k)*8]). disp8/disp32
    # auto-selected — at n >= 17 the displacement crosses 127 (the old bug).
    _emov_rsp_disp(S, 0x48, 0x8B, 7, (n - 1) * 8);   # rdi = a1
    _emov_rsp_disp(S, 0x48, 0x8B, 6, (n - 2) * 8);   # rsi = a2
    _emov_rsp_disp(S, 0x48, 0x8B, 2, (n - 3) * 8);   # rdx = a3
    _emov_rsp_disp(S, 0x48, 0x8B, 1, (n - 4) * 8);   # rcx = a4
    _emov_rsp_disp(S, 0x4C, 0x8B, 0, (n - 5) * 8);   # r8  = a5
    _emov_rsp_disp(S, 0x4C, 0x8B, 1, (n - 6) * 8);   # r9  = a6
    # Step 2: shift extras up to [rsp+write_base..] (a_n at [rsp+0], deepest
    # extra a_7 at [rsp+(nextra-1)*8]). The write target [rsp+write_base+si*8]
    # equals the read source of iteration si+6 ([rsp+(si+6)*8]) once nextra > 6,
    # so ASCENDING order overwrote a slot a later iteration still needed → the
    # middle args (7-12) scrambled. Iterate DESCENDING so every read happens
    # before the write that clobbers its slot. (v6.0.57; was the second half of
    # the >12-arg corruption alongside the disp8 overflow above.)
    var si = nextra - 1;
    while (si >= 0) {
        # mov r10, [rsp + si*8]  then  mov [rsp + write_base + si*8], r10
        _emov_rsp_disp(S, 0x4C, 0x8B, 2, si * 8);
        _emov_rsp_disp(S, 0x4C, 0x89, 2, write_base + si * 8);
        si = si - 1;
    }
    # Step 3: drop 6 reg-arg slots (even nextra) or 5 (odd nextra → 16-aligned at CALL).
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, sp_drop);
    return 0;
}

# Emit stack cleanup after call.
# SysV: >6 args needed `(n-6)*8` bytes of caller-side stack-arg slots.
# Win64 (v5.5.7 strict-compliance): every call allocates 32 B
# shadow; for N>4 we also allocated `(n-4)*8` for stack args
# (rounded up to 16). ECALLCLEAN adds back the same total.
fn ECALLCLEAN(S, n): i64 {
    if (_IR_REC1(S, IR_CALL_CLEAN, n) == 1) { return 0; }
    if (_TARGET_PE == 1) {
        if (n <= 4) {
            EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x20);    # add rsp, 0x20 (shadow)
            return 0;
        }
        var framesize = 32 + (n - 4) * 8;
        if ((framesize & 15) != 0) { framesize = framesize + 8; }
        EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, framesize);   # add rsp, framesize (imm8)
        return 0;
    }
    if (n > 6) {
        var extra = (n - 6) * 8;
        # v5.6.41: ECALLPOPS drops 5 (not 6) reg-arg slots when nextra is
        # odd, leaving 8 extra bytes on the stack for 16-alignment. Release
        # those here too. See ECALLPOPS line ~1131 for the symmetric write.
        var nextra = n - 6;
        if ((nextra & 1) == 1) { extra = extra + 8; }
        E3(S, 0xC48148);
        EB(S, extra & 0xFF);
        EB(S, extra >> 8 & 0xFF);
        EB(S, extra >> 16 & 0xFF);
        EB(S, extra >> 24 & 0xFF);
    }
    return 0;
}

# Emit tail call: epilogue + jmp (instead of call + epilogue)
fn ETAILJMP(S, fnidx): i64 {
    var _ire = IR_ENABLED(S); if (_ire >= 1) { ir_emit1(S, IR_TAIL_JMP, fnidx); }
    # v4.9.1: restore callee-saved registers before tearing down frame.
    # Reverse order of save (parse.cyr prologue).
    if (_cur_fn_regalloc >= 5) { E3(S, 0x7D8B4C); EB(S, 0xD8); }  # mov r15, [rbp-40]
    if (_cur_fn_regalloc >= 4) { E3(S, 0x758B4C); EB(S, 0xE0); }  # mov r14, [rbp-32]
    if (_cur_fn_regalloc >= 3) { E3(S, 0x6D8B4C); EB(S, 0xE8); }  # mov r13, [rbp-24]
    if (_cur_fn_regalloc >= 2) { E3(S, 0x658B4C); EB(S, 0xF0); }  # mov r12, [rbp-16]
    if (_cur_fn_regalloc >= 1) { E3(S, 0x5D8B48); EB(S, 0xF8); }  # mov rbx, [rbp-8]
    # Emit epilogue: mov rsp, rbp; pop rbp (match EFNEPI)
    E3(S, 0xEC8948);  # mov rsp, rbp
    EB(S, 0x5D);       # pop rbp
    # Emit jmp rel32 with fixup (like ECALLFIX but type 2 + jmp opcode)
    EB(S, 0xE9);        # jmp rel32
    var poff = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    var fc = GFCNT(S);
    var faddr = _fixup_base + fc * 16;
    S64(faddr, poff);
    S64(faddr + 8, (2 << 56) | fnidx);
    SFCNT(S, fc + 1);
    return 0;
}

# Helper: emit disp32 at current CP
fn EDISP32(S, disp): i64 {
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# v5.10.38 — emit f64v2 SIMD-class param store at fn entry.
# `simd_ord` is the XMM register ordinal (0..7 under SysV;
# cyrius-internal convention reuses the same on aarch64 PE
# but that path isn't enabled in v5.10.38 — PE f64v2 params
# error out at parse time). `named_idx` is the named slot of
# the 2-slot stack-local where the f64v2 value lives (lo half
# at &v+0, hi half at &v+8 via the v5.10.28 named-slot-at-
# deepest pattern). Emits a single MOVUPD storing 16 bytes
# from XMM<simd_ord> into the 2-slot region.
#
# ModR/M for `movupd [rbp+disp32], xmm<N>`: 0x85 + (N << 3)
# (mod=10 disp32, reg=N, rm=101 rbp). Opcode: 66 0F 11 (MOVUPD
# m128, xmm).
fn ESTOREPARM_F64V2(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var modrm = 0x85 + (simd_ord << 3);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, modrm);
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# v5.10.38 — emit f64v4 SIMD-class param store at fn entry.
# Two MOVUPDs: XMM<simd_ord> → [&v+0..15], XMM<simd_ord+1> →
# [&v+16..31]. Same shape as v5.10.37's EFLLOAD/STORE_F64V4_PAIR
# for return-side, but reversed direction (store from XMM).
fn ESTOREPARM_F64V4(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 16;
    var modrm_lo = 0x85 + (simd_ord << 3);
    var modrm_hi = 0x85 + ((simd_ord + 1) << 3);
    # movupd [rbp+disp_lo], xmm<simd_ord>
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, modrm_lo);
    var addr_lo = _codebuf_base + GCP(S);
    S64(addr_lo, (L64(addr_lo) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    # movupd [rbp+disp_hi], xmm<simd_ord+1>
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, modrm_hi);
    var addr_hi = _codebuf_base + GCP(S);
    S64(addr_hi, (L64(addr_hi) >> 32 << 32) | (disp_hi & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# v6.4.31 — emit Win64 value-form SIMD-class param store at fn entry.
# The MS x64 ABI passes __m128 / any >8B aggregate BY POINTER in an
# integer arg reg (rcx/rdx/r8/r9 for pidx 0..3; stack for pidx>=4),
# NOT in XMM as SysV does. `pidx` is that integer arg-reg index (already
# retptr-shifted by the caller). `named_idx` is the named slot of the
# same multi-slot frame region SysV uses, so &v + lane access are
# byte-identical to SysV downstream — only the arrival differs. We copy
# `nbytes` (16 for f64v2/f32v4/int-vec, 32 for f64v4) from [ptr] into the
# frame. Scratch: rax (the pointer), xmm5 (Win64 volatile, not an arg reg).
fn ESTOREPARM_SIMD_WIN64(S, pidx, named_idx, nbytes): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    # ptr → rax
    if (pidx == 0) { E3(S, 0xC88948); }        # mov rax, rcx
    if (pidx == 1) { E3(S, 0xD08948); }        # mov rax, rdx
    if (pidx == 2) { E3(S, 0xC0894C); }        # mov rax, r8
    if (pidx == 3) { E3(S, 0xC8894C); }        # mov rax, r9
    if (pidx >= 4) {
        var win_sdisp = 16 + 32 + (pidx - 4) * 8;
        E3(S, 0x858B48);                        # mov rax, [rbp+sdisp]
        EDISP32(S, win_sdisp);
    }
    # lo 16: movupd xmm5,[rax] ; movupd [rbp+disp_lo],xmm5
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x28);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0xAD);
    var a1 = _codebuf_base + GCP(S);
    S64(a1, (L64(a1) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    if (nbytes > 16) {
        # hi 16: movupd xmm5,[rax+16] ; movupd [rbp+disp_lo+16],xmm5
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x68); EB(S, 0x10);
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0xAD);
        var a2 = _codebuf_base + GCP(S);
        var disp_hi = disp_lo + 16;
        S64(a2, (L64(a2) >> 32 << 32) | (disp_hi & 0xFFFFFFFF));
        SCP(S, GCP(S) + 4);
    }
    return 0;
}

# v5.10.38 — emit caller-side SIMD-arg LOAD (mirror of ESTOREPARM_F64V2).
# Used by PARSE_FNCALL when a callee param is f64v2: load 16 bytes
# from the caller's local (at named_idx) into XMM<simd_ord>.
# Encoding: 66 0F 10 (0x85 + (simd_ord << 3)) disp32.
fn ELOAD_F64V2_TO_XMM(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var modrm = 0x85 + (simd_ord << 3);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, modrm);
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# v5.10.38 — emit caller-side SIMD-arg LOAD for f64v4.
fn ELOAD_F64V4_TO_XMM(S, simd_ord, named_idx): i64 {
    var disp_lo = 0 - ((named_idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 16;
    var modrm_lo = 0x85 + (simd_ord << 3);
    var modrm_hi = 0x85 + ((simd_ord + 1) << 3);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, modrm_lo);
    var addr_lo = _codebuf_base + GCP(S);
    S64(addr_lo, (L64(addr_lo) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, modrm_hi);
    var addr_hi = _codebuf_base + GCP(S);
    S64(addr_hi, (L64(addr_hi) >> 32 << 32) | (disp_hi & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

fn ESTOREREGPARM(S, pidx, disp): i64 {
    # Callee-side symmetric flip with EPOPARG. Under _TARGET_PE,
    # incoming args 0..3 arrive in rcx/rdx/r8/r9 (Win64 ABI) not
    # rdi/rsi/rdx/rcx (SysV). Spill-to-local encoding changes
    # accordingly; disp32 payload is written by EDISP32 below.
    # pidx>=4 under Win64 falls through to SysV encoding (wrong
    # register mapping on Win64; acceptable for v5.5.3 since the
    # ≤4-arg-only caller surface never produces pidx>=4 on
    # Windows-compiled code paths the tests exercise).
    if (_TARGET_PE == 1) {
        # pidx 0..3 arrive in Win64 arg regs. pidx>=4 is routed to
        # ESTORESTACKPARM by ESTOREPARM's v5.5.4 dispatch — this fn
        # is never called with pidx>=4 under _TARGET_PE.
        if (pidx == 0) { E3(S, 0x8D8948); }       # mov [rbp+disp], rcx
        if (pidx == 1) { E3(S, 0x958948); }       # mov [rbp+disp], rdx
        if (pidx == 2) { E3(S, 0x85894C); }       # mov [rbp+disp], r8
        if (pidx == 3) { E3(S, 0x8D894C); }       # mov [rbp+disp], r9
        EDISP32(S, disp);
        return 0;
    }
    if (pidx == 0) { E3(S, 0xBD8948); }
    if (pidx == 1) { E3(S, 0xB58948); }
    if (pidx == 2) { E3(S, 0x958948); }
    if (pidx == 3) { E3(S, 0x8D8948); }
    if (pidx == 4) { E3(S, 0x85894C); }
    if (pidx == 5) { E3(S, 0x8D894C); }
    EDISP32(S, disp);
    return 0;
}

fn ESTORESTACKPARM(S, pidx, disp, pc): i64 {
    # Win64 (v5.5.7 strict-compliance): caller allocated 32 B
    # shadow + stack args at [rsp+32..]. After `call` pushes ret
    # addr and callee's `push rbp`, the first stack arg (a[4])
    # lands at [rbp+16+32] = [rbp+48]. ESTORESTACKPARM reads
    # [rbp+16+32+(pidx-4)*8] into rax and stores to the local slot.
    if (_TARGET_PE == 1) {
        var win_sdisp = 16 + 32 + (pidx - 4) * 8;
        E3(S, 0x858B48);                                             # mov rax, [rbp+sdisp]
        EDISP32(S, win_sdisp);
        E3(S, 0x858948);                                             # mov [rbp+disp], rax
        EDISP32(S, disp);
        return 0;
    }
    var nstack = pc - 6;
    var si = nstack - 1 - (pidx - 6);
    var sdisp = 16 + si * 8;
    E3(S, 0x858B48);
    EDISP32(S, sdisp);
    E3(S, 0x858948);
    EDISP32(S, disp);
    return 0;
}

fn ESTOREPARM(S, pidx, lidx, pc): i64 {
    if (_IR_REC(S, IR_STORE_PARM, 0, pidx, lidx) == 1) { return 0; }
    var disp = 0 - ((lidx + 1) * 8);
    # v4.8.4-alpha6: shift past the reserved rbx save slot.
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    # Win64 (v5.5.4): dispatch boundary is 4 (register args) vs
    # SysV's 6. Args 4+ go through ESTORESTACKPARM with the Win64
    # stack layout formula.
    if (_TARGET_PE == 1) {
        if (pidx < 4) {
            ESTOREREGPARM(S, pidx, disp);
        } else {
            ESTORESTACKPARM(S, pidx, disp, pc);
        }
        return 0;
    }
    if (pidx < 6) {
        ESTOREREGPARM(S, pidx, disp);
    } else {
        ESTORESTACKPARM(S, pidx, disp, pc);
    }
    return 0;
}

# v5.10.28 — emit f64v2 pair-register return load:
#   mov rax, [rbp - (idx+1)*8]   (lo half — bottom-of-struct, named slot)
#   mov rdx, [rbp - idx*8]       (hi half — anonymous filler slot above)
# `idx` is the NAMED slot's local index (returned by FINDLOCAL on
# the f64v2 var name). For a 2-slot stack-local f64v2:
#   slot idx-1 = anonymous filler (hi half)
#   slot idx   = named (lo half / bottom of struct)
# The named slot lives at the deeper frame offset; struct-relative
# field 0 (lo) is at &v+0 = the named slot, field 1 (hi) at &v+8 =
# the filler slot above. x86 SysV ABI: 16-byte int-class struct
# returns split rax (lo) + rdx (hi).
fn EFLLOAD_F64V2_PAIR(S, idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    # v5.10.32 — XMM register passing optimization. Replaced the
    # v5.10.28 `mov rax, [rbp+lo]; mov rdx, [rbp+hi]` int-class
    # pair (14 bytes) with a single `movupd xmm0, [rbp+disp]`
    # (8 bytes). XMM0 holds f64v2 as a packed 128-bit value: lo
    # in low 64 bits, hi in high 64 bits — matching the in-memory
    # layout (lo @ &v+0, hi @ &v+8). Caller's matching
    # EFLSTORE_F64V2_PAIR uses `movupd [rbp+disp], xmm0` to land
    # the returned f64v2 in 16 bytes of caller's local. NO
    # alignment requirement (movupd, not movapd) — &v is 8-aligned
    # but not necessarily 16-aligned in stack frames.
    #
    # x86 SysV ABI: SSE class 16-byte aggregates return in XMM0.
    # The hisab benchmark gap (30-700× vs Rust+glam) closes
    # 2-4× from this optimization once typed wrappers (v5.10.33)
    # expose f64v2 to consumers.
    #
    # 8-byte encoding: 66 0F 10 85 [disp32]
    #   66 — operand-size prefix (selects packed-double form)
    #   0F 10 — MOVUPD xmm, m128 opcode
    #   85 — ModRM (mod=10 disp32, reg=0 xmm0, rm=101 rbp)
    #   <disp32> — 4-byte signed displacement
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x85);
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    _flags_reflect_rax = 0;
    return 0;
}

# v5.10.28 — emit f64v2 pair-register STORE post-call.
# v5.10.32 — XMM register passing optimization: single
# `movupd [rbp+disp], xmm0` (8 bytes) replaces the
# v5.10.28 `mov [rbp+lo], rax; mov [rbp+hi], rdx`
# int-class pair (14 bytes). Mirror of EFLLOAD_F64V2_PAIR.
# 8-byte encoding: 66 0F 11 85 [disp32] (opcode 0x11 = MOVUPD m128, xmm).
fn EFLSTORE_F64V2_PAIR(S, idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x85);
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# v5.10.37 — emit f64v4 pair-quad return LOAD (callee-side).
# Two MOVUPDs: xmm0 = [&v + 0..15], xmm1 = [&v + 16..31].
# `idx` is the NAMED slot's local index — 4-slot layout:
#   slot idx-3 = filler (top of struct, &v + 24..31)
#   slot idx-2 = filler (&v + 16..23)
#   slot idx-1 = filler (&v + 8..15)
#   slot idx   = named (bottom of struct, &v + 0..7)
# Named slot is at the deepest frame offset; xmm0 covers the
# lower 16 bytes (named + first filler), xmm1 covers the upper
# 16 bytes (next two fillers). Cyrius-internal calling
# convention — not strictly SysV-compliant for 32B composites
# (SysV requires retptr-style for >16B); valid because all
# f64v4 consumers are cyrius-compiled. Win64 PE uses retptr
# via _cur_fn_ret_stash + ESTRUCT_BYVAL_COPY (size 32) in
# PARSE_RETURN — this fn isn't called on _TARGET_PE.
# 16-byte encoding: two `66 0F 10 85 [disp32]` = 8 bytes each.
fn EFLLOAD_F64V4_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 16;
    # movupd xmm0, [rbp + disp_lo]: 66 0F 10 85 disp32
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x85);
    var addr_lo = _codebuf_base + GCP(S);
    S64(addr_lo, (L64(addr_lo) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    # movupd xmm1, [rbp + disp_hi]: 66 0F 10 8D disp32
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x8D);
    var addr_hi = _codebuf_base + GCP(S);
    S64(addr_hi, (L64(addr_hi) >> 32 << 32) | (disp_hi & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    _flags_reflect_rax = 0;
    return 0;
}

# v5.10.37 — emit f64v4 pair-quad STORE post-call (caller-side).
# Mirror of EFLLOAD_F64V4_PAIR. 16-byte encoding: two
# `66 0F 11 85 [disp32]` (opcode 0x11 = MOVUPD m128, xmm).
fn EFLSTORE_F64V4_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 16;
    # movupd [rbp + disp_lo], xmm0
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x85);
    var addr_lo = _codebuf_base + GCP(S);
    S64(addr_lo, (L64(addr_lo) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    # movupd [rbp + disp_hi], xmm1
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x8D);
    var addr_hi = _codebuf_base + GCP(S);
    S64(addr_hi, (L64(addr_hi) >> 32 << 32) | (disp_hi & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# v5.10.45 Phase 1 — int-class 16B struct pair-return LOAD (callee).
# Used in PARSE_RETURN when `_cur_fn_ret_pair == 1` (9-16B non-Str
# value-type struct return on x86 SysV). Layout matches f64v2's
# pair convention (filler above named):
#   slot idx-1 = filler (hi half, &v + 8..15)
#   slot idx   = named  (lo half / bottom, &v + 0..7)
# Emits:
#   mov rax, [rbp + disp_lo]   ; 48 8B 85 disp32 (named, lo half)
#   mov rdx, [rbp + disp_hi]   ; 48 8B 95 disp32 (filler, hi half)
# x86 SysV ABI: 16-byte int-class composite returns split rax/rdx
# (rax = lo, rdx = hi). For SSE-class composites (f64v2), v5.10.32
# optimized to a single `movupd xmm0, [m128]` via EFLLOAD_F64V2_PAIR
# — INT-class structs can't use XMM, hence this separate helper.
# 14-byte encoding total (7 bytes per mov).
fn EFLLOAD_STRUCT_INT_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 8;
    # mov rax, [rbp + disp_lo]: 48 8B 85 disp32
    E3(S, 0x858B48);
    var addr_lo = _codebuf_base + GCP(S);
    S64(addr_lo, (L64(addr_lo) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    # mov rdx, [rbp + disp_hi]: 48 8B 95 disp32 (ModRM 0x95 = mod=10 reg=010 rm=101)
    E3(S, 0x958B48);
    var addr_hi = _codebuf_base + GCP(S);
    S64(addr_hi, (L64(addr_hi) >> 32 << 32) | (disp_hi & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    _flags_reflect_rax = 0;
    return 0;
}

# v5.10.45 Phase 1 — int-class 16B struct pair-return STORE (caller).
# Mirror of EFLLOAD_STRUCT_INT_PAIR — receives rax/rdx into the
# caller's 2-slot stack-local. Emits:
#   mov [rbp + disp_lo], rax   ; 48 89 85 disp32
#   mov [rbp + disp_hi], rdx   ; 48 89 95 disp32
# 14-byte encoding (7 bytes per mov).
fn EFLSTORE_STRUCT_INT_PAIR(S, idx): i64 {
    var disp_lo = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp_lo = disp_lo - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp_lo = disp_lo - _cur_fn_ret_stash; }
    var disp_hi = disp_lo + 8;
    # mov [rbp + disp_lo], rax: 48 89 85 disp32
    E3(S, 0x858948);
    var addr_lo = _codebuf_base + GCP(S);
    S64(addr_lo, (L64(addr_lo) >> 32 << 32) | (disp_lo & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    # mov [rbp + disp_hi], rdx: 48 89 95 disp32
    E3(S, 0x958948);
    var addr_hi = _codebuf_base + GCP(S);
    S64(addr_hi, (L64(addr_hi) >> 32 << 32) | (disp_hi & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# Emit fn local load: mov rax, [rbp - offset]
fn EFLLOAD(S, idx): i64 {
    if (_IR_REC1(S, IR_LOAD_LOCAL, idx) == 1) { return 0; }
    # v6.3.30 O2 cat 5: a 64-bit reload of a local that was JUST stored (this load
    # is the very next emit — GCP still == the store's post-emit CP — and reloads the
    # SAME idx) is DEAD: rax still holds the stored value. Skip the emit entirely.
    # Fail-safe via CP-adjacency: any intervening emit moves GCP off _efl_store_cp;
    # zero-byte control-flow entries (loop-tops, forward-join landings) clear
    # _efl_store_cp so a reachable-via-jump reload is never skipped.
    if (_RELOADELIM_OK == 1) {
        if (GCP(S) == _efl_store_cp) { if (idx == _efl_store_idx) {
            return 0;
        } }
    }
    var disp = 0 - ((idx + 1) * 8);
    # v4.8.4-alpha6: shift past the reserved rbx save slot.
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    E3(S, 0x858B48);
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    # v5.6.21 codegen-bug fix: mov rax, [rbp+disp] writes rax but does
    # NOT set ZF from the value. Without this reset, a stale
    # `_flags_reflect_rax = 1` from a prior op (e.g., CMP/SETCC inside
    # a callee) survives across `var r = fn_call(); if (r)`, and
    # ECONDCMP skips the `test rax, rax` → bare-truthy branches on
    # stale flags. Mirrors the existing reset in ELOAD8/16/32/64 and
    # the i32-path of EMOVI. Repro: /tmp/cyrius_5.6_codegen_bug.cyr.
    _flags_reflect_rax = 0;
    return 0;
}

# Load variable address into rcx (x86: mov rcx, <addr>)
fn EVADDR_X1(S, idx): i64 {
    var _ire = IR_ENABLED(S); if (_ire >= 1) { ir_emit1(S, IR_LOAD_ADDR_G_X1, idx); }
    # v6.1.6: PIC-gate the byte-array-literal address load. This was the one
    # &global address-emit site _IS_OBJ did NOT gate — an unconditional
    # absolute `mov rcx, imm64` that broke shared/object/PIE builds using a
    # byte-array literal (`var b[N] = {...}`), since the baked VA can't
    # survive a load-bias / .o relocation. Mirror _EVRCX's LEA form. Non-PIE
    # builds (_IS_OBJ==0) keep the absolute path → byte-identical. CHANGELOG [6.1.6].
    if (_IS_OBJ(S) == 1) {
        EB(S, 0x48); EB(S, 0x8D); EB(S, 0x0D);   # lea rcx, [rip+disp32]
        RECFIX(S, idx);
        EDISP32(S, 0);
        return 0;
    }
    E2(S, 0xB948);
    RECFIX(S, idx);
    E8(S, 0);
    return 0;
}

# v5.5.36 Phase 2: local-addr counterpart — `lea rcx, [rbp - disp]`.
# PARSE_FIELD_LOAD / PARSE_FIELD_STORE for struct-typed locals call
# this instead of EVADDR_X1 when the struct lives on the stack.
# Mirrors the EVADDR (EFLADDR's rax variant) offset math: shift past
# reserved rbx/r12-r15 save slots, then (idx+1)*8 below rbp.
fn EFLADDR_X1(S, lli): i64 {
    var disp = 0 - ((lli + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    # lea rcx, [rbp + disp32]: 48 8D 8D <rel32>
    E3(S, 0x8D8D48);
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# v5.5.36 Phase 2b — rax variant: `lea rax, [rbp + disp]`. Used at
# caller-side of a struct-returning call to push the retbuf address
# as the hidden first arg (RDI on SysV, RCX on Win64 — both filled
# by ECALLPOPS + EPOPARG from the stack).
fn EFLADDR(S, lli): i64 {
    var disp = 0 - ((lli + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    # lea rax, [rbp + disp32]: 48 8D 85 <rel32>
    E3(S, 0x858D48);
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    return 0;
}

# Add immediate to rcx (x86: add rcx, imm32)
fn EADDIMM_X1(S, val): i64 {
    if (_IR_REC(S, IR_ADD_IMM_X1, 0, 0, val) == 1) { return 0; }
    E3(S, 0xC18148);
    EB(S, val & 0xFF); EB(S, val >> 8 & 0xFF);
    EB(S, val >> 16 & 0xFF); EB(S, val >> 24 & 0xFF);
    return 0;
}

# Patch frame size: write imm32 at the sub rsp placeholder
fn EPATCHFRAME(S, patch, size): i64 {
    var _ire = IR_ENABLED(S); if (_ire >= 1) { ir_emit(S, IR_PATCH_FRAME, 0, patch, size); }
    var pa = _codebuf_base + patch;
    S64(pa, (L64(pa) >> 32 << 32) | (size & 0xFFFFFFFF));
    return 0;
}

# Emit fn local store: mov [rbp - offset], rax
fn EFLSTORE(S, idx): i64 {
    if (_IR_REC1(S, IR_STORE_LOCAL, idx) == 1) { return 0; }
    var disp = 0 - ((idx + 1) * 8);
    # v4.8.4-alpha6: shift past the reserved rbx save slot.
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    E3(S, 0x858948);
    var addr = _codebuf_base + GCP(S);
    S64(addr, (L64(addr) >> 32 << 32) | (disp & 0xFFFFFFFF));
    SCP(S, GCP(S) + 4);
    _efl_store_cp = GCP(S);   # v6.3.30: record post-store CP + idx for reload-elim
    _efl_store_idx = idx;
    return 0;
}

# v5.8.56: removed ELVRLOAD / ELVRSTORE / ELVRINIT — loop-variable r12
# caching introduced in v4.8.4-alpha6 that was never wired up to the
# parser. Zero callers across cyrius source + downstream consumers
# (vidya only referenced ELVRINIT in implementation.cyml ARCHIVE,
# i.e. historical). Saves ~80 B per backend; frees up r12 for the
# regalloc picker (which was already free of any ELVR* dependency
# because the caching never reached the parser).

# ================================================================
# TOKEN ACCESS — TOKTYP/TOKVAL/PEEKT/PEEKV moved to
# src/backend/common/tokens.cyr at v6.0.8 (byte-identical across
# x86 + aarch64 + cx backends).
# ================================================================

# ================================================================
# x86_64 INLINE ASM MNEMONICS
# ================================================================

fn ASM_MNEMONIC(S): i64 {
    var noff = PEEKV(S);
    var mnem = L64(S + 0x60000 + noff);
    STI(S, GTI(S) + 1);
    if (mnem & 0xFFFFFF == 0x696C63) { EB(S, 0xFA); }                          # cli
    elif (mnem & 0xFFFFFF == 0x697473) { EB(S, 0xFB); }                        # sti
    elif (mnem & 0xFFFFFF == 0x746C68) { EB(S, 0xF4); }                        # hlt
    elif (mnem & 0xFFFFFF == 0x706F6E) { EB(S, 0x90); }                        # nop
    elif (mnem & 0xFFFFFFFFFF == 0x7174657269) { EB(S, 0x48); EB(S, 0xCF); }   # iretq
    elif (mnem & 0xFFFFFFFFFF == 0x72736D7277) { EB(S, 0x0F); EB(S, 0x30); }   # wrmsr
    elif (mnem & 0xFFFFFFFFFF == 0x72736D6472) { EB(S, 0x0F); EB(S, 0x32); }   # rdmsr
    elif (mnem & 0xFFFFFFFFFF == 0x6469757063) { EB(S, 0x0F); EB(S, 0xA2); }   # cpuid
    elif (mnem & 0xFFFFFFFFFFFF == 0x65636E65666D) { EB(S, 0x0F); EB(S, 0xAE); EB(S, 0xF0); }   # mfence (v6.3.3 #6 — full memory barrier)
    elif (mnem & 0xFFFFFFFFFFFF == 0x65636E65666C) { EB(S, 0x0F); EB(S, 0xAE); EB(S, 0xE8); }   # lfence (v6.3.3 #6 — load barrier)
    elif (mnem & 0xFFFFFFFFFFFF == 0x65636E656673) { EB(S, 0x0F); EB(S, 0xAE); EB(S, 0xF8); }   # sfence (v6.3.3 #6 — store barrier)
    elif (mnem & 0xFFFFFFFFFFFF == 0x716668737570) { EB(S, 0x9C); }            # pushfq
    elif (mnem & 0xFFFFFFFFFF == 0x7166706F70) { EB(S, 0x9D); }                # popfq
    elif (mnem & 0xFFFFFFFF == 0x7464676C) { ASM_LGDT(S); }                    # lgdt
    elif (mnem & 0xFFFFFFFF == 0x7464696C) { ASM_LIDT(S); }                    # lidt
    elif (mnem & 0xFFFFFF == 0x766F6D) { ASM_MOV_CR(S); }                      # mov (cr)
    elif (mnem & 0xFFFFFFFFFFFF == 0x67706C766E69) { ASM_INVLPG(S); }          # invlpg
    elif (mnem & 0xFFFFFF == 0x746E69) { ASM_INT(S); }                          # int
    elif (mnem & 0xFFFF == 0x6E69) { ASM_IN(S); }                              # in
    elif (mnem & 0xFFFFFF == 0x74756F) { ASM_OUT(S); }                          # out
    elif (mnem & 0xFFFFFF == 0x72746C) { ASM_LTR(S); }                          # ltr
    elif (mnem == 0x6F6C5F6D61726170) { ASM_PARAM_LOAD(S, noff); }              # param_load(reg,idx)
    else { ERR(S); }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

fn ASM_LGDT(S): i64 {
    if (PEEKT(S) != 28) { ERR(S); }
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    if (PEEKT(S) != 29) { ERR(S); }
    STI(S, GTI(S) + 1);
    EB(S, 0x0F); EB(S, 0x01); EB(S, 0x10);
    return 0;
}

fn ASM_LIDT(S): i64 {
    if (PEEKT(S) != 28) { ERR(S); }
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    if (PEEKT(S) != 29) { ERR(S); }
    STI(S, GTI(S) + 1);
    EB(S, 0x0F); EB(S, 0x01); EB(S, 0x18);
    return 0;
}

fn ASM_CR_MODRM(packed): i64 {
    var crn = ((packed >> 16) & 0xFF) - 48;
    return 0xC0 | (crn << 3);
}

fn ASM_MOV_CR(S): i64 {
    var o1 = L64(S + 0x60000 + PEEKV(S));
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 31) { ERR(S); }
    STI(S, GTI(S) + 1);
    var o2 = L64(S + 0x60000 + PEEKV(S));
    STI(S, GTI(S) + 1);
    if (o1 & 0xFFFF == 0x7263) { EB(S, 0x0F); EB(S, 0x22); EB(S, ASM_CR_MODRM(o1)); }
    elif (o2 & 0xFFFF == 0x7263) { EB(S, 0x0F); EB(S, 0x20); EB(S, ASM_CR_MODRM(o2)); }
    else { ERR(S); }
    return 0;
}

fn ASM_INT(S): i64 {
    if (PEEKT(S) != 1) { ERR(S); }
    EB(S, 0xCD); EB(S, PEEKV(S) & 0xFF);
    STI(S, GTI(S) + 1);
    return 0;
}

# v6.0.67: map an x86-64 register NAME (its first bytes read as an L64) → encoding 0-15.
fn _asm_x86_reg(n): i64 {
    if (n & 0xFFFFFF == 0x786172) { return 0; }    # rax
    if (n & 0xFFFFFF == 0x786372) { return 1; }    # rcx
    if (n & 0xFFFFFF == 0x786472) { return 2; }    # rdx
    if (n & 0xFFFFFF == 0x786272) { return 3; }    # rbx
    if (n & 0xFFFFFF == 0x707372) { return 4; }    # rsp
    if (n & 0xFFFFFF == 0x706272) { return 5; }    # rbp
    if (n & 0xFFFFFF == 0x697372) { return 6; }    # rsi
    if (n & 0xFFFFFF == 0x696472) { return 7; }    # rdi
    if (n & 0xFFFF == 0x3872) { return 8; }         # r8
    if (n & 0xFFFF == 0x3972) { return 9; }         # r9
    if (n & 0xFFFFFF == 0x303172) { return 10; }   # r10
    if (n & 0xFFFFFF == 0x313172) { return 11; }   # r11
    if (n & 0xFFFFFF == 0x323172) { return 12; }   # r12
    if (n & 0xFFFFFF == 0x333172) { return 13; }   # r13
    if (n & 0xFFFFFF == 0x343172) { return 14; }   # r14
    if (n & 0xFFFFFF == 0x353172) { return 15; }   # r15
    return 0 - 1;
}

# v6.0.67: asm-block `param_load(reg, idx)` pseudo-op — emit `mov reg, [rbp+disp]`
# loading the idx-th parameter from its ACTUAL prologue slot, instead of hardcoding
# `[rbp-N]` byte literals that silently break when the prologue layout shifts (the
# sigil AES-NI / cyrius atomic.cyr coupling bug class). disp uses the SAME formula the
# prologue spills params at: -(idx + 1 + _cur_fn_regalloc)*8. Byte-identical to the old
# hand-rolled literals when _cur_fn_regalloc==0 (disp8 form, mod=01, rm=rbp). noff is
# the mnemonic's name offset — verify the full "param_load" (first-8 matched in the
# dispatch; check the trailing "ad"). See issue 2026-05-21-asm-block-global-symbol-pseudo.
fn ASM_PARAM_LOAD(S, noff): i64 {
    if (load8(S + 0x60000 + noff + 8) != 97) { ERR(S); }    # 'a'
    if (load8(S + 0x60000 + noff + 9) != 100) { ERR(S); }   # 'd'
    if (PEEKT(S) != 10) { ERR(S); }      # (
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 2) { ERR(S); }       # register identifier
    var reg = _asm_x86_reg(L64(S + 0x60000 + PEEKV(S)));
    if (reg < 0) { ERR(S); }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 31) { ERR(S); }      # ,
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 1) { ERR(S); }       # idx (integer literal)
    var idx = PEEKV(S);
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 11) { ERR(S); }      # )
    STI(S, GTI(S) + 1);
    var disp = 0 - ((idx + 1 + _cur_fn_regalloc) * 8);
    if (reg < 8) { EB(S, 0x48); } else { EB(S, 0x4C); }   # REX.W (+REX.R for r8-15)
    EB(S, 0x8B);                                           # mov r64, r/m64
    var rl = reg & 7;
    if (disp >= 0 - 128) {
        EB(S, 0x45 | (rl << 3));    # mod=01 (disp8), rm=101 (rbp)
        EB(S, disp & 0xFF);
    } else {
        EB(S, 0x85 | (rl << 3));    # mod=10 (disp32), rm=101 (rbp)
        EDISP32(S, disp);
    }
    return 0;
}

fn ASM_IN(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 31) { ERR(S); }
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    EB(S, 0xEC);
    return 0;
}

fn ASM_OUT(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 31) { ERR(S); }
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    EB(S, 0xEE);
    return 0;
}

fn ASM_LTR(S): i64 {
    STI(S, GTI(S) + 1);
    EB(S, 0x0F); EB(S, 0x00); EB(S, 0xD8);
    return 0;
}

fn ASM_INVLPG(S): i64 {
    if (PEEKT(S) != 28) { ERR(S); }
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    if (PEEKT(S) != 29) { ERR(S); }
    STI(S, GTI(S) + 1);
    EB(S, 0x0F); EB(S, 0x01); EB(S, 0x38);
    return 0;
}
