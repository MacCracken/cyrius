# ================================================================
# SSE2 FLOAT EMISSION
# ================================================================
fn EMOVQ_X0_A(S): i64 { EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC0); return 0; }
fn EMOVQ_X1_C(S): i64 { EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC9); return 0; }
fn EMOVQ_A_X0(S): i64 { EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xC0); return 0; }
fn EF64ADD(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC1); return 0; }
fn EF64SUB(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x5C); EB(S, 0xC1); return 0; }
fn EF64MUL(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1); return 0; }
fn EF64DIV(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x5E); EB(S, 0xC1); return 0; }
fn EI2F(S): i64 { EB(S, 0xF2); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x2A); EB(S, 0xC0); return 0; }
fn EF2I(S): i64 { EB(S, 0xF2); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x2C); EB(S, 0xC0); return 0; }
fn EUCOMISD(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x2E); EB(S, 0xC1); return 0; }
fn EXORPD_X1(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x57); EB(S, 0xC9); return 0; }
fn EMOVAPD_01(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x28); EB(S, 0xC1); return 0; }

# x87 FPU: rax→stack→x87, compute, x87→stack→rax
fn EX87PUSH(S): i64 {
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x10);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0x04); EB(S, 0x24);
    EB(S, 0xDD); EB(S, 0x04); EB(S, 0x24);
    return 0;
}
fn EX87POP(S): i64 {
    EB(S, 0xDD); EB(S, 0x1C); EB(S, 0x24);
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x04); EB(S, 0x24);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x10);
    return 0;
}

# sqrtsd xmm0, xmm0
fn EF64SQRT(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x51); EB(S, 0xC0); return 0; }
# roundsd xmm0, xmm0, 1 (floor) — SSE4.1
fn EF64FLOOR(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x3A); EB(S, 0x0B); EB(S, 0xC0); EB(S, 0x01); return 0; }
# roundsd xmm0, xmm0, 2 (ceil) — SSE4.1
fn EF64CEIL(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x3A); EB(S, 0x0B); EB(S, 0xC0); EB(S, 0x02); return 0; }
# roundsd xmm0, xmm0, 0 (round to nearest) — SSE4.1
fn EF64ROUND(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x3A); EB(S, 0x0B); EB(S, 0xC0); EB(S, 0x00); return 0; }
# f64_abs: clear sign bit (bit 63) via integer AND
# No SSE needed — value is already in rax as bit pattern
# push rax; movabs rax, 0x7FFF...; mov rcx, rax; pop rax; and rax, rcx

fn EMIT_F64_BINOP(S, fop): i64 {
    EPOPC(S);
    EPUSHR(S);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC8);
    EMOVQ_X0_A(S);
    EPOPR(S);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EMOVQ_X1_C(S);
    if (fop == 0) { EF64ADD(S); }
    if (fop == 1) { EF64SUB(S); }
    if (fop == 2) { EF64MUL(S); }
    if (fop == 3) { EF64DIV(S); }
    EMOVQ_A_X0(S);
    return 0;
}

# v6.4.56 (scalar-float D2) — f32 scalar arith: dst = a OP b on IEEE-754 single
# bit patterns. Mirror of EMIT_F64_BINOP but single-precision: transfer via movd
# (f32 lives in the low 32 bits) instead of movq, and addss/subss/mulss/divss
# (F3 0F 58/5C/59/5E C1) instead of the F2-prefixed sd forms. movd eax, xmm0 on
# extract zero-extends rax, keeping the stored slot's high half clean (matching
# the f32 storage convention: bits in low 32, high 32 = 0). fop 0=add 1=sub 2=mul
# 3=div. All encodings llvm-mc-verified. cycc uses no scalar f32 → never emitted
# on the self-host input (byte-identical).
fn EMIT_F32_BINOP(S, fop): i64 {
    EPOPC(S);
    EPUSHR(S);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC8);              # mov rax, rcx  (a)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC0); # movd xmm0, eax  (a)
    EPOPR(S);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);              # mov rcx, rax  (b)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC9); # movd xmm1, ecx  (b)
    if (fop == 0) { EB(S, 0xF3); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC1); }  # addss
    if (fop == 1) { EB(S, 0xF3); EB(S, 0x0F); EB(S, 0x5C); EB(S, 0xC1); }  # subss
    if (fop == 2) { EB(S, 0xF3); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1); }  # mulss
    if (fop == 3) { EB(S, 0xF3); EB(S, 0x0F); EB(S, 0x5E); EB(S, 0xC1); }  # divss
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xC0); # movd eax, xmm0  (result, zero-ext)
    return 0;
}

fn EMIT_FLOAT_LIT(S, fval): i64 {
    # v6.5.28 — `fval` is now an INDEX into the float-literal side table, not a packed
    # 32/32 rational. The old unpack could not represent more than ~9 significant digits and
    # corrupted silently past that; see FLIT_ADD in src/common/util.cyr.
    var numer = FLIT_NUM(fval);
    var denom = FLIT_DEN(fval);
    E2(S, 0xB848); E8(S, numer);
    EI2F(S);
    E2(S, 0xB948); E8(S, denom);
    EB(S, 0xF2); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x2A); EB(S, 0xC9);
    EF64DIV(S);
    EMOVQ_A_X0(S);
    return 0;
}

# f32_from(x): f64 (bit pattern in rax) → f32 (bit pattern in eax). v6.2.18.
# movq xmm0, rax; cvtsd2ss xmm0, xmm0; movd eax, xmm0 (zero-extends rax).
fn EF32_FROM(S): i64 {
    EMOVQ_X0_A(S);
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x5A); EB(S, 0xC0);   # cvtsd2ss xmm0, xmm0
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xC0);   # movd eax, xmm0
    return 0;
}

# f32_to(x): f32 (bit pattern in eax) → f64 (bit pattern in rax). v6.2.18.
# movd xmm0, eax; cvtss2sd xmm0, xmm0; movq rax, xmm0.
fn EF32_TO(S): i64 {
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC0);   # movd xmm0, eax
    EB(S, 0xF3); EB(S, 0x0F); EB(S, 0x5A); EB(S, 0xC0);   # cvtss2sd xmm0, xmm0
    EMOVQ_A_X0(S);
    return 0;
}

# ================================================================
# SIMD — SSE2 packed f64 batch operations
# ================================================================
# v5.10.16 — fixes a long-latent x86 codegen bug (likely shipped
# v1.9.0): the LOOP/UNARY/FMADD emits computed slot-N frame disps
# as `-(N+1)*8` but EFLSTORE / EFLLOAD adjust by an additional
# `_cur_fn_regalloc * 8 + _cur_fn_ret_stash` for fns that auto-
# enabled callee-save register caching or return a struct via the
# hidden retbuf slot. The arg-stash and the loop-body load
# diverged by 40+ bytes for any fn that hit auto-regalloc — every
# call to f64v_add/_sub/_mul/_div/_sqrt/_abs/_fmadd from within
# such a fn segfaulted reading off the stash. Latent because the
# only consumers (programs/simd_expand_test.cyr) were never
# wired into check.sh; tcyr coverage added v5.10.16 forces this
# never to silently regress again.
#
# `_F64V_DISP` mirrors EFLSTORE's adjustment formula. The disp32
# `mov rdx, [rbp + disp32]` form (`48 8B 95 disp32`) is used
# unconditionally so adjusted disps below -128 don't truncate
# silently; the +3 bytes per load is amortized across the loop.

fn _F64V_DISP(idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    return disp;
}

fn _EMIT_LOAD_RDX_FROM_LOCAL(S, idx): i64 {
    # v6.5.66 — the batch kernel reading a param slot keeps its inline copy alive.
    _prov_read(idx);
    # mov rdx, [rbp + disp32]: 48 8B 95 disp32
    var disp = _F64V_DISP(idx);
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x95);
    EB(S, disp & 0xFF);
    EB(S, (disp >> 8) & 0xFF);
    EB(S, (disp >> 16) & 0xFF);
    EB(S, (disp >> 24) & 0xFF);
    return 0;
}

fn EMIT_F64V_LOOP(S, op, vbase): i64 {
    # rcx = n (already in rax from last arg)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    # rsi = 0 (loop counter)
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    # Loop header: cmp rsi, rcx; jge done
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # rdx = a base; movupd xmm0, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # rdx = b base; movupd xmm1, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # Operation: addpd/subpd/mulpd/divpd xmm0, xmm1
    EB(S, 0x66); EB(S, 0x0F);
    if (op == 0) { EB(S, 0x58); }
    if (op == 1) { EB(S, 0x5C); }
    if (op == 2) { EB(S, 0x59); }
    if (op == 3) { EB(S, 0x5E); }
    EB(S, 0xC1);
    # rdx = dst base; movupd [rdx+rsi*8], xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);
    # rsi += 2
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    # jmp loop_top
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v6.4.3+ (SIMD Phase 1) — packed f32 batch: addps/subps/mulps(dst, a, b, n).
# Mirror of EMIT_F64V_LOOP minus the 66 prefix (movups vs movupd, addps vs addpd)
# and with 4-byte lanes: the loads/store use [rdx+rsi*4] (SIB 0xB2, scale *4) and
# rsi advances by 4 f32s per 128-bit iteration. op 0=add(0x58) 1=sub(0x5C) 2=mul(0x59).
# v6.5.64 — DIRECT (loop-free, pointer-free) 128-bit binary op on THREE FRAME LOCALS.
#
# The batch emitters above are memory kernels: they take three POINTERS out of stash slots and
# loop. For the value-form wrappers that is all overhead — `f32v4_add(a, b)` expands to
# `f32v_add(&r, &a, &b, 4)` with a CONSTANT lane count and three `&local` operands, so the
# addresses are known frame displacements and the "loop" runs exactly one iteration. Measured at
# 6.5.63: one such link emits 28 real instructions and ~15 memory ops for ONE `addps`.
#
# ⚠ THIS ALONE IS WORTH ZERO, AND THAT WAS MEASURED BEFORE IT WAS BUILT. The critical path of a
# chained expression is made of 16-byte STORE-TO-LOAD FORWARDS, and the pointer machinery is not
# on it: a hand-written replica that removes exactly this scaffolding and nothing else runs
# 33.99 ms against the current 33.96 ms. What pays is removing FORWARDS. This emitter is the
# enabler — it puts the result store and the `return r` reload ADJACENT, which is what lets the
# v6.5.53 SLASE peephole (parse_fn.cyr) collapse them; that pair currently sits ~0x31 bytes apart
# and SLASE's own comment records it deleting nothing.
#
# ⛔ ENCODING CONSTRAINTS, each of which is a real hazard, not a style choice:
#   * UNALIGNED moves only. Vector locals sit on the 8-byte local grid and are NOT 16-byte
#     aligned (measured: 12 of 17 slots at 8 mod 16), so `movaps`/`movapd` would #GP.
#   * disp32 (mod=10) only. The disp8 form `0F 10 45 <disp8>` is INVISIBLE to the register
#     allocator's safety scan, so a small-frame shortcut would reintroduce the hole v6.5.64
#     widened that scan to close.
#   * The 66-prefixed `movupd` encoding, not the 3-bytes-shorter `movups`. `66 0F 11/10 <mr>` is
#     exactly what SLASE matches and what `EFLLOAD_F64V2_PAIR` already emits, so both the
#     peephole and the safety scan already speak this vocabulary. `movups` matches neither.
# Reuses `_F64V_DISP` rather than re-deriving the displacement — float.cyr:120-136 records that
# duplicating that formula once already cost a segfault class.
# `dbl` selects the arithmetic domain: 0 = packed SINGLE (addps 0F 58) for f32v4, 1 = packed
# DOUBLE (addpd 66 0F 58) for f64v2. The MOVES are `movupd` in both cases — a 16-byte unaligned
# move is the same operation either way, and the 66-prefixed form is the one SLASE matches.
# op: 0 add, 1 sub, 2 mul, 3 div (div is f64v only; the f32v builtin has no div arm).
fn EMIT_VEC_DIRECT(S, op, dst_li, a_li, b_li, dbl): i64 {
    var da = _F64V_DISP(a_li);
    var db = _F64V_DISP(b_li);
    var dr = _F64V_DISP(dst_li);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x85); EDISP32(S, da);   # movupd xmm0,[rbp+da]
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x8D); EDISP32(S, db);   # movupd xmm1,[rbp+db]
    if (dbl == 1) { EB(S, 0x66); }                                        # packed-double prefix
    EB(S, 0x0F);
    if (op == 0) { EB(S, 0x58); }
    if (op == 1) { EB(S, 0x5C); }
    if (op == 2) { EB(S, 0x59); }
    if (op == 3) { EB(S, 0x5E); }
    EB(S, 0xC1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x85); EDISP32(S, dr);   # movupd [rbp+dr],xmm0
    _flags_reflect_rax = 0;
    return 0;
}

fn EMIT_F32V_LOOP(S, op, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0 (loop counter)
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);  # rdx = a base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # movups xmm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);  # rdx = b base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # movups xmm1, [rdx+rsi*4]
    EB(S, 0x0F);                              # addps/subps/mulps xmm0, xmm1
    if (op == 0) { EB(S, 0x58); }
    if (op == 1) { EB(S, 0x5C); }
    if (op == 2) { EB(S, 0x59); }
    EB(S, 0xC1);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);      # rdx = dst base
    EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xB2);   # movups [rdx+rsi*4], xmm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);   # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v6.4.8 (SIMD Phase 4 R1) — packed f32 batch on 256-bit AVX2: vaddps/vsubps/vmulps
# ymm. EMIT_F32V_LOOP widened to 256-bit VEX — the 128-bit SSE bytes gain a 2-byte VEX
# prefix (C5 FC), the loads/store/op address 8 f32 per 256-bit iteration (SIB 0xB2,
# scale *4; rsi advances by 8), and `vzeroupper` (C5 F8 77) on loop exit avoids the
# AVX↔SSE transition penalty before returning to legacy-SSE code. op 0=add(0x58)
# 1=sub(0x5C) 2=mul(0x59). ALL VEX bytes verified with llvm-mc (the vvvv field is the
# byte-order trap: src1=ymm0 → vvvv=1111 → 2nd VEX byte 0xFC). This emits AVX2 that
# SIGILLs on pre-AVX2 CPUs — the lib f32v8_* wrappers gate on simd_has_avx2() and fall
# back to the SSE (EMIT_F32V_LOOP, n=8 = 2 iters) path. cycc has no f32v8 → its own
# self-host never emits a VEX byte (byte-identical, same as every prior SIMD phase).
# v6.5.24 (SIMD fix-list item 3, pulled forward from band G) — f64v4 widened to 256-bit
# ymm. dst[i] = a[i] OP b[i] over FOUR f64 lanes per iteration instead of two.
#
# ⭐ THIS NEEDED NO IR/REGALLOC SUBSTRATE. The filing bundles it with two items that do
# (register-resident value-form arithmetic, wrapper inlining), and the roadmap gated all
# three behind Slot 3 — but this one is a self-contained emitter mirroring
# EMIT_F32V8_LOOP, and it was measured at 15.9 -> ~7.9 ns while the substrate sat unbuilt.
#
# Encoding is the `pd` sibling of the f32v8 loop: 2-byte VEX C5, second byte FD instead of
# FC (pp=01, the 66-prefix slot) so every op is packed-DOUBLE; SIB 0xF2 = [rdx+rsi*8]
# (scale 8, index rsi, base rdx), the same addressing the SSE f64v loop uses.
#
# ⚠ rsi ADVANCES BY 4, so this emitter can NEVER serve the n=2 f64v2 caller — a 4-lane
# stride over a 2-element vector walks off the end. It is reached only through a distinct
# builtin whose lib wrapper gates on simd_has_avx2(); f64v2 keeps EMIT_F64V_LOOP.
# ⚠ vzeroupper before returning, or every later SSE instruction pays the AVX-SSE
# transition penalty — the same reason EMIT_F32V8_LOOP ends with it.
fn EMIT_F64V4_LOOP(S, op, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);   # vmovupd ymm0, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);   # vmovupd ymm1, [rdx+rsi*8]
    EB(S, 0xC5); EB(S, 0xFD);                                          # vaddpd/vsubpd/vmulpd/vdivpd
    if (op == 0) { EB(S, 0x58); }
    if (op == 1) { EB(S, 0x5C); }
    if (op == 2) { EB(S, 0x59); }
    if (op == 3) { EB(S, 0x5E); }
    EB(S, 0xC1);                                                       # ymm0 = ymm0 OP ymm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);   # vmovupd [rdx+rsi*8], ymm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);                # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xC5); EB(S, 0xF8); EB(S, 0x77);                             # vzeroupper
    return 0;
}

fn EMIT_F32V8_LOOP(S, op, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0 (loop counter)
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);  # rdx = a base
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # vmovups ymm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);  # rdx = b base
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # vmovups ymm1, [rdx+rsi*4]
    EB(S, 0xC5); EB(S, 0xFC);                  # vaddps/vsubps/vmulps ymm0, ymm0, ymm1
    if (op == 0) { EB(S, 0x58); }
    if (op == 1) { EB(S, 0x5C); }
    if (op == 2) { EB(S, 0x59); }
    EB(S, 0xC1);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);      # rdx = dst base
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x11); EB(S, 0x04); EB(S, 0xB2);   # vmovups [rdx+rsi*4], ymm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x08);   # rsi += 8
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xC5); EB(S, 0xF8); EB(S, 0x77);     # vzeroupper — clear upper ymm before SSE code
    return 0;
}

# v6.4.9 (SIMD Phase 4 R2) — EMIT_F32V8_FMADD — dst[i] = a[i]*b[i] + c[i] over 8 f32
# lanes with a TRUE fused multiply-add (vfmadd231ps ymm, single rounding — the matmul
# inner-loop verb). Args at vbase: dst, a, b, c, n(rax). The FIRST 3-byte VEX (C4) the
# toolchain emits: vfmadd231ps is FMA3 (0F38 map → forces the 3-byte form). ymm2 =
# ymm0*ymm1 + ymm2 (231 = dst is the accumulator operand). All bytes llvm-mc-verified.
# vfmadd231ps needs the FMA CPUID bit (leaf 1 ECX bit 12), a DIFFERENT bit than AVX2
# (leaf 7 EBX bit 5) — the lib f32v8_fma_ptr wrapper gates on simd_has_fma() and falls
# back to f32v_fmadd (mulps+addps, 2 roundings; contract callers use exact-product
# inputs so both agree). Same over-WRITE footgun as f32v_fmadd: the tail iteration
# over-writes up to 7 dst lanes past n — lib wrappers pin n=8.
fn EMIT_F32V8_FMADD(S, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # a base
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # vmovups ymm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);              # b base
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # vmovups ymm1, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 3);              # c base (accumulator)
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x10); EB(S, 0x14); EB(S, 0xB2);   # vmovups ymm2, [rdx+rsi*4]
    EB(S, 0xC4); EB(S, 0xE2); EB(S, 0x7D); EB(S, 0xB8); EB(S, 0xD1);   # vfmadd231ps ymm2, ymm0, ymm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # dst base
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x11); EB(S, 0x14); EB(S, 0xB2);   # vmovups [rdx+rsi*4], ymm2
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x08);   # rsi += 8
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xC5); EB(S, 0xF8); EB(S, 0x77);     # vzeroupper
    return 0;
}

# v6.4.9 (SIMD Phase 4 R2) — EMIT_F32V8_DOT(S, vbase) — sum of a[i]*b[i] over 8 f32
# lanes → f32 bit pattern in eax. Args: vbase=a, vbase+1=b; n in rax. Accumulate with
# vmulps+vaddps in ymm2 (AVX2, no FMA needed → gates on simd_has_avx2 not simd_has_fma).
# The 8-lane horizontal reduce CANNOT use f32v_dot's two-haddps trick — haddps never
# crosses the 128-bit lane split. So: vextractf128 the high 128 into xmm1, vaddps it
# into xmm2 (**L=0 / 128-bit** — C5 E8, NOT C5 EC), vzeroupper (clear upper ymm before
# the legacy-SSE tail — xmm2's low 128 survives), then the proven f32v4 tail (two
# haddps + movd eax). Same over-READ contract as f32v_dot (n a multiple of 8 or zero-pad).
fn EMIT_F32V8_DOT(S, vbase): i64 {
    EB(S, 0xC5); EB(S, 0xEC); EB(S, 0x57); EB(S, 0xD2);   # vxorps ymm2, ymm2, ymm2 (zero accum)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # a base
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # vmovups ymm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # b base
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # vmovups ymm1, [rdx+rsi*4]
    EB(S, 0xC5); EB(S, 0xFC); EB(S, 0x59); EB(S, 0xC1);   # vmulps ymm0, ymm0, ymm1
    EB(S, 0xC5); EB(S, 0xEC); EB(S, 0x58); EB(S, 0xD0);   # vaddps ymm2, ymm2, ymm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x08);   # rsi += 8
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xC4); EB(S, 0xE3); EB(S, 0x7D); EB(S, 0x19); EB(S, 0xD1); EB(S, 0x01);  # vextractf128 xmm1, ymm2, 1
    EB(S, 0xC5); EB(S, 0xE8); EB(S, 0x58); EB(S, 0xD1);   # vaddps xmm2, xmm2, xmm1  (L=0! low+high 128)
    EB(S, 0xC5); EB(S, 0xF8); EB(S, 0x77);                # vzeroupper (before the legacy-SSE tail)
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);   # haddps xmm2, xmm2  (4→2)
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);   # haddps xmm2, xmm2  (2→1)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xD0);   # movd eax, xmm2 — f32 bits → rax
    return 0;
}

# v6.4.5 (SIMD Phase 2) — EMIT_F32V_FMADD — dst[i] = a[i]*b[i] + c[i] via
# mulps + addps (SSE, packed-single). Mirror of EMIT_F64V_FMADD minus the 66
# prefix, with 4-byte lanes ([rdx+rsi*4] SIB 0xB2, rsi += 4).
# Args at vbase: dst, a, b, c, n(rax). The dense-f32 matmul inner-loop verb.
# Caller contract: n a multiple of 4, or over-allocate dst/a/b/c to a multiple
# of 4. Unlike f32v_dot (which only over-READS), the tail iteration also
# over-WRITES up to 3 dst lanes past n — a memory-corruption footgun for a
# tightly-sized dst. The lib f32v4_fmadd wrappers pin n=4 (always lane-safe).
fn EMIT_F32V_FMADD(S, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # a base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # movups xmm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);              # b base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # movups xmm1, [rdx+rsi*4]
    EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1);                # mulps xmm0, xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 3);              # c base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # movups xmm1, [rdx+rsi*4]
    EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC1);                # addps xmm0, xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # dst base
    EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xB2);   # movups [rdx+rsi*4], xmm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);   # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v6.4.5 (SIMD Phase 2) — EMIT_F32V_DOT(S, vbase) — sum of a[i]*b[i] for i in
# [0, n). Returns the f32 bit pattern in eax (zero-extended into rax). Slots:
# vbase=a, vbase+1=b; n in rax. Mirror of EMIT_F64V_DOT but reducing FOUR
# packed-single lanes: mulps+addps accumulate in xmm2, then TWO haddps (SSE3,
# F2 0F 7C) fold 4→1, then movd eax,xmm2 extracts the 32-bit result.
# Caller contract (same footgun as f64v_dot): n a multiple of 4, OR
# over-allocate to a multiple of 4 with ZEROED padding — the tail iteration
# multiplies+sums up to 3 lanes past n.
fn EMIT_F32V_DOT(S, vbase): i64 {
    EB(S, 0x0F); EB(S, 0x57); EB(S, 0xD2);   # xorps xmm2, xmm2 — zero accumulator
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # a base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # movups xmm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # b base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # movups xmm1, [rdx+rsi*4]
    EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1);                # mulps xmm0, xmm1
    EB(S, 0x0F); EB(S, 0x58); EB(S, 0xD0);                # addps xmm2, xmm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);   # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);   # haddps xmm2, xmm2  (4→2)
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);   # haddps xmm2, xmm2  (2→1)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xD0);   # movd eax, xmm2 — f32 bits → rax
    return 0;
}

# v6.4.6 (Phase 3a) — EMIT_IVEC_BINOP(S, op, w, vbase) — packed INTEGER
# dst[i] = a[i] OP b[i]. op: 0=add 1=sub 2=mul. w = lane byte-width (1/2/4/8).
# Descriptor-driven (the "one integer op-table" the Phase-0 encoding was designed
# for): one 128-bit movups load/store per iter (reusing the f32v4 pattern), the
# op is padd{b,w,d,q} / psub{b,w,d,q} / pmullw|pmulld selected by w, and rsi
# advances by 16/w lanes with SIB scale = w. Args at vbase: dst, a, b, n(rax).
# add/sub are width-agnostic (two's complement — signed==unsigned); mul is i16/i32
# only (pmullw / pmulld SSE4.1) — w=1/w=8 mul hard-errors (no 1-instruction
# pmulb/pmulq). All integer ops carry the 66 prefix (packed-integer SSE2).
fn EMIT_IVEC_BINOP(S, op, w, vbase): i64 {
    var sib = 0x32; var step = 16;                       # w == 1: [rdx+rsi*1], +16 lanes
    if (w == 2) { sib = 0x72; step = 8; }
    if (w == 4) { sib = 0xB2; step = 4; }
    if (w == 8) { sib = 0xF2; step = 2; }
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # a base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, sib);   # movups xmm0, [rdx+rsi*w]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);              # b base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, sib);   # movups xmm1, [rdx+rsi*w]
    if (op == 0) {                                        # padd{b,w,d,q} xmm0, xmm1
        EB(S, 0x66); EB(S, 0x0F);
        if (w == 1) { EB(S, 0xFC); } if (w == 2) { EB(S, 0xFD); } if (w == 4) { EB(S, 0xFE); } if (w == 8) { EB(S, 0xD4); }
        EB(S, 0xC1);
    }
    if (op == 1) {                                        # psub{b,w,d,q} xmm0, xmm1
        EB(S, 0x66); EB(S, 0x0F);
        if (w == 1) { EB(S, 0xF8); } if (w == 2) { EB(S, 0xF9); } if (w == 4) { EB(S, 0xFA); } if (w == 8) { EB(S, 0xFB); }
        EB(S, 0xC1);
    }
    if (op == 2) {
        if (w == 2) { EB(S, 0x66); EB(S, 0x0F); EB(S, 0xD5); EB(S, 0xC1); }                   # pmullw
        elif (w == 4) { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x38); EB(S, 0x40); EB(S, 0xC1); }    # pmulld (SSE4.1)
        elif (w == 8) {
            # v6.4.53: packed i64 multiply (low 64 bits/lane). SSE has no pmullq (AVX-512
            # only), so synthesize via pmuludq (unsigned 32×32→64 on the low dword of each
            # qword): a*b = a_lo·b_lo + (a_lo·b_hi + a_hi·b_lo)<<32 — the a_hi·b_hi·2^64
            # term wraps out mod 2^64, and low-64 signed == unsigned (two's complement).
            # xmm0=a, xmm1=b in; result in xmm0; xmm2/xmm3 scratch (caller-saved). All
            # ten encodings llvm-mc-verified. See issue 2026-07-07-i64v2-valueform-packed-multiply.
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0x6F); EB(S, 0xD1);                # movdqa xmm2, xmm1  (b)
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0x73); EB(S, 0xD2); EB(S, 0x20);   # psrlq  xmm2, 32    (b_hi)
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0xF4); EB(S, 0xD0);                # pmuludq xmm2, xmm0 (a_lo·b_hi)
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0x6F); EB(S, 0xD8);                # movdqa xmm3, xmm0  (a)
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0x73); EB(S, 0xD3); EB(S, 0x20);   # psrlq  xmm3, 32    (a_hi)
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0xF4); EB(S, 0xD9);                # pmuludq xmm3, xmm1 (a_hi·b_lo)
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0xD4); EB(S, 0xD3);                # paddq  xmm2, xmm3  (cross sum)
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0x73); EB(S, 0xF2); EB(S, 0x20);   # psllq  xmm2, 32
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0xF4); EB(S, 0xC1);                # pmuludq xmm0, xmm1 (a_lo·b_lo)
            EB(S, 0x66); EB(S, 0x0F); EB(S, 0xD4); EB(S, 0xC2);                # paddq  xmm0, xmm2  (final)
        }
        else { ERR_MSG(S, "packed integer mul is i16/i32/i64 only", 38); }
    }
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # dst base
    EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, sib);   # movups [rdx+rsi*w], xmm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, step);   # add rsi, step (16/w lanes)
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v6.4.7 (Phase 3b) — EMIT_IVEC_DP8(S, vbase) — the b1.58 / int8 GEMM-cell primitive:
# the widening int8 dot product sum(a[i]*b[i]) for i in [0,n), a=UNSIGNED u8, b=SIGNED
# i8, accumulated in i32 and returned in eax/rax. Args at vbase: a, b; n in rax.
# Per 16-byte iteration: pmaddubsw (u8×i8 → 8×i16, adjacent-pair sums, saturating) →
# pmaddwd against an all-ones i16 vector (→ 4×i32 pair sums) → paddd into the i32
# accumulator xmm2. Tail: two phaddd fold the 4 i32 lanes → movd eax. The ones vector
# is built in xmm3 via pcmpeqw + psrlw 15 (no memory constant). SSSE3 (pmaddubsw/
# phaddd) + SSE2. Caller contract: n a multiple of 16 (or zero-pad the tail).
fn EMIT_IVEC_DP8(S, vbase): i64 {
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0xEF); EB(S, 0xD2);         # pxor xmm2, xmm2 (i32 accumulator)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x75); EB(S, 0xDB);         # pcmpeqw xmm3, xmm3 (all ones)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x71); EB(S, 0xD3); EB(S, 0x0F);  # psrlw xmm3, 15 → each i16 lane = 1
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # a base (u8)
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0x32);   # movups xmm0, [rdx+rsi*1]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # b base (i8)
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0x32);   # movups xmm1, [rdx+rsi*1]
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x38); EB(S, 0x04); EB(S, 0xC1);  # pmaddubsw xmm0, xmm1 → 8×i16
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0xF5); EB(S, 0xC3);   # pmaddwd xmm0, xmm3 (×ones) → 4×i32
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0xFE); EB(S, 0xD0);   # paddd xmm2, xmm0 (accumulate)
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x10);   # rsi += 16
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x38); EB(S, 0x02); EB(S, 0xD2);  # phaddd xmm2, xmm2 (4→2)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x38); EB(S, 0x02); EB(S, 0xD2);  # phaddd xmm2, xmm2 (2→1)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xD0);   # movd eax, xmm2 → i32 sum in eax
    EB(S, 0x48); EB(S, 0x63); EB(S, 0xC0);               # movsxd rax, eax — SIGN-extend (signed dot; weights can be < 0)
    return 0;
}

# EMIT_F64V_UNARY — packed unary ops: sqrtpd (op=0), abs via andpd (op=1)
# Args at vbase: dst, src, n(rax)
fn EMIT_F64V_UNARY(S, op, vbase): i64 {
    # For abs: build sign mask in xmm2 — pcmpeqd xmm2,xmm2; psrlq xmm2,1
    if (op == 1) {
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x76); EB(S, 0xD2);
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x73); EB(S, 0xD2); EB(S, 0x01);
    }
    # rcx = n
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    # rsi = 0
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # rdx = src base; movupd xmm0, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    if (op == 0) {
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x51); EB(S, 0xC0);
    }
    if (op == 1) {
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x54); EB(S, 0xC2);
    }
    # rdx = dst base; movupd [rdx+rsi*8], xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v5.10.17 — keystone primitives for hisab gap-close.
# Three flat-array verbs that compose enough of the dot/normalize/
# slerp/mat4_mul hot paths to make hisab benchmarks measurably
# faster vs Rust+glam. Cross-arch propagation MANDATORY in this
# slot (per the v5.10.16 lesson on aarch64-stub debt).

# EMIT_F64V_DOT(S, vbase) — sum of a[i] * b[i] for i in [0, n).
# Returns f64 bit pattern in rax. Slots: vbase=a, vbase+1=b. n in rax.
# Accumulator strategy: xmm2 holds packed pair of partial sums; loop
# does mulpd+addpd to accumulate; tail uses haddpd (SSE3) to reduce
# to a scalar, then movq rax, xmm2 to extract bits.
fn EMIT_F64V_DOT(S, vbase): i64 {
    # xorpd xmm2, xmm2 — zero accumulator
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x57); EB(S, 0xD2);
    # rcx = n
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    # rsi = 0
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);          # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                       # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # rdx = a base; movupd xmm0, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # rdx = b base; movupd xmm1, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # mulpd xmm0, xmm1
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1);
    # addpd xmm2, xmm0  — accumulator += a*b
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xD0);
    # rsi += 2
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    # haddpd xmm2, xmm2 — SSE3 horizontal add: xmm2.low = xmm2[0] + xmm2[1]
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);
    # movq rax, xmm2  — extract f64 bit pattern into rax
    EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xD0);
    return 0;
}

# EMIT_F64V_SCALE(S, vbase) — dst[i] = a[i] * scalar.
# Slots: vbase=dst, vbase+1=a, vbase+2=scalar (f64 bit pattern). n in rax.
# Pre-loop: load scalar into xmm2 and broadcast to both lanes.
fn EMIT_F64V_SCALE(S, vbase): i64 {
    # rdx = scalar (i64 bit pattern)
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    # movq xmm2, rdx — xmm2.low = scalar bits
    EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xD2);
    # unpcklpd xmm2, xmm2 — broadcast: xmm2 = {scalar, scalar}
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x14); EB(S, 0xD2);
    # rcx = n; rsi = 0
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # load a[i..i+1] into xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # mulpd xmm0, xmm2  — xmm0 *= broadcast scalar
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC2);
    # store xmm0 to dst[i..i+1]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# EMIT_F64V_AXPY(S, vbase) — y[i] += alpha * x[i].
# Slots: vbase=y, vbase+1=x, vbase+2=alpha. n in rax.
# SSE2 has no FMA — fused via mulpd + addpd.
fn EMIT_F64V_AXPY(S, vbase): i64 {
    # rdx = alpha bits; xmm2 = {alpha, alpha}
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xD2);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x14); EB(S, 0xD2);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # load x[i..i+1] into xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # mulpd xmm0, xmm2 — xmm0 = alpha * x[i..i+1]
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC2);
    # load y[i..i+1] into xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # addpd xmm1, xmm0 — xmm1 += alpha*x
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC8);
    # store xmm1 to y[i..i+1]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x0C); EB(S, 0xF2);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# EMIT_F64V_FMADD — dst[i] = a[i]*b[i] + c[i] using mulpd + addpd (SSE2)
# Args at vbase: dst, a, b, c, n(rax)
# ⭐ v6.5.38 — the 256-bit sibling of EMIT_F64V_FMADD, completing the .24 ymm widening.
#
# `.24` widened f64v4 add/sub/mul/div to ymm and measured 15.9 -> ~7.9 ns. It did NOT widen
# fmadd, dot, scale or abs, and the roadmap recorded only `fmadd` as the residual — a 2026-09-01
# sweep found all FOUR in the same state: `lib/simd.cyr:642/649/654` had no `simd_has_avx2()`
# gate at all, unlike their four gated siblings at `:612/620/628/636`, and every VEX byte in
# this file sat between lines 255-361 with nothing past 376. So an `f64v4_fmadd` ran the 128-bit
# SSE2 loop at `rsi += 2` — **two iterations for four lanes**.
#
# Byte-for-byte the same transposition `.24` used: `66 0F` -> `C5 FD` (2-byte VEX, L=1, pp=01),
# xmm -> ymm, stride 2 -> 4, and `vzeroupper` on exit.
# ⚠ VEX.vvvv IS ONE'S-COMPLEMENT. `FD` = 1111_1101: vvvv=1111 inverts to register 0, so
# `C5 FD 59 C1` is `vmulpd ymm0, ymm0, ymm1` — dest ModRM.reg=0, src1=vvvv=ymm0, src2=rm=1.
# The same byte is used by EMIT_F64V4_LOOP above; if you hand-derive a different one, you have
# almost certainly forgotten the inversion (this is a recorded trap in CLAUDE.md).
# ⚠ n MUST be a multiple of 4 — the stride is 4, so a 2-element vector walks off the end. Only
# the AVX2-gated f64v4 lib wrappers (n=4) reach here.
#
# ⚠ Deliberately mulpd+addpd rather than a single `vfmadd231pd`: FMA3 is a SEPARATE cpuid bit
# (leaf 1 ECX bit 12) from AVX2 (leaf 7 EBX bit 5), so emitting it under an AVX2-only gate would
# fault on an AVX2 machine without FMA. It would also change the ROUNDING — one rounding instead
# of two — so a fused version is not a drop-in for the 128-bit path this must agree with.
# v6.5.38 — 256-bit sqrt (op 0) / abs (op 1), the ymm sibling of EMIT_F64V_UNARY.
# ⚠ The abs sign-mask build is AVX2, not just AVX: `vpcmpeqd`/`vpsrlq` on a ymm operand are
# 256-bit INTEGER ops, which AVX1 does not have. That is fine — the only caller is gated on
# simd_has_avx2() — but it means this emitter must never be re-gated to a mere AVX check.
fn EMIT_F64V4_UNARY(S, op, vbase): i64 {
    if (op == 1) {
        EB(S, 0xC5); EB(S, 0xED); EB(S, 0x76); EB(S, 0xD2);                # vpcmpeqd ymm2,ymm2,ymm2
        EB(S, 0xC5); EB(S, 0xED); EB(S, 0x73); EB(S, 0xD2); EB(S, 0x01);   # vpsrlq   ymm2,ymm2,1
    }
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);       # vmovupd ymm0,[rdx+rsi*8]
    if (op == 0) { EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x51); EB(S, 0xC0); }   # vsqrtpd ymm0,ymm0
    if (op == 1) { EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x54); EB(S, 0xC2); }   # vandpd  ymm0,ymm0,ymm2
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);       # vmovupd [rdx+rsi*8],ymm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);                    # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xC5); EB(S, 0xF8); EB(S, 0x77);                                 # vzeroupper
    return 0;
}

# v6.5.38 — 256-bit r[i] = a[i] * s, the ymm sibling of EMIT_F64V_SCALE.
# The 128-bit version broadcasts with `unpcklpd xmm2,xmm2` (2 lanes). Four lanes cannot be
# filled that way, so this uses `vbroadcastsd ymm2, xmm2` — a 3-BYTE VEX (C4), because the
# opcode lives in the 0F38 map which the 2-byte form cannot encode.
fn EMIT_F64V4_SCALE(S, vbase): i64 {
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xD2);       # movq xmm2, rdx
    EB(S, 0xC4); EB(S, 0xE2); EB(S, 0x7D); EB(S, 0x19); EB(S, 0xD2);       # vbroadcastsd ymm2,xmm2
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);       # vmovupd ymm0,[rdx+rsi*8]
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x59); EB(S, 0xC2);                    # vmulpd  ymm0,ymm0,ymm2
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);       # vmovupd [rdx+rsi*8],ymm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);                    # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xC5); EB(S, 0xF8); EB(S, 0x77);                                 # vzeroupper
    return 0;
}

# v6.5.38 — 256-bit dot product, the ymm sibling of EMIT_F64V_DOT. Result f64 bits -> rax.
#
# This is the only op in the family that is not pointwise: the 4-lane accumulator has to be
# reduced to one scalar. `haddpd` does NOT do that for ymm — the 256-bit form adds within each
# 128-bit LANE independently and never crosses the lane boundary, so a naive widening of the
# 128-bit tail silently drops the upper two products. The fold is therefore explicit:
#   vextractf128 xmm0, ymm2, 1   ; xmm0 = {acc2, acc3}
#   vaddpd       xmm2, xmm2, xmm0 ; xmm2 = {acc0+acc2, acc1+acc3}
#   haddpd       xmm2, xmm2       ; xmm2.low = all four summed
# ⚠ ORDER: vzeroupper sits between the last VEX op and the legacy-SSE `haddpd`. Running legacy
# SSE with a dirty upper-YMM state is the AVX-SSE transition penalty (tens of cycles per
# instruction on several microarchitectures) — the very cost this widening exists to avoid.
# ⚠ FP addition is not associative, so this pairs lanes (0+2, 1+3) and gives results that can
# differ in the last ulp from the 128-bit path's (0+1)+(2+3). That is inherent to any vector
# reduction, not a defect; do not "fix" it by serialising.
fn EMIT_F64V4_DOT(S, vbase): i64 {
    EB(S, 0xC5); EB(S, 0xED); EB(S, 0x57); EB(S, 0xD2);                    # vxorpd ymm2,ymm2,ymm2
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);       # vmovupd ymm0,[rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);       # vmovupd ymm1,[rdx+rsi*8]
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x59); EB(S, 0xC1);                    # vmulpd  ymm0,ymm0,ymm1
    EB(S, 0xC5); EB(S, 0xED); EB(S, 0x58); EB(S, 0xD0);                    # vaddpd  ymm2,ymm2,ymm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);                    # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xC4); EB(S, 0xE3); EB(S, 0x7D); EB(S, 0x19); EB(S, 0xD0); EB(S, 0x01);  # vextractf128 xmm0,ymm2,1
    EB(S, 0xC5); EB(S, 0xE9); EB(S, 0x58); EB(S, 0xD0);                    # vaddpd xmm2,xmm2,xmm0
    EB(S, 0xC5); EB(S, 0xF8); EB(S, 0x77);                                 # vzeroupper
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);                    # haddpd xmm2,xmm2
    EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xD0);       # movq   rax, xmm2
    return 0;
}

fn EMIT_F64V4_FMADD(S, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);   # vmovupd ymm0, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);   # vmovupd ymm1, [rdx+rsi*8]
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x59); EB(S, 0xC1);                # vmulpd  ymm0, ymm0, ymm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 3);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);   # vmovupd ymm1, [rdx+rsi*8]
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x58); EB(S, 0xC1);                # vaddpd  ymm0, ymm0, ymm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0xC5); EB(S, 0xFD); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);   # vmovupd [rdx+rsi*8], ymm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);                # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xC5); EB(S, 0xF8); EB(S, 0x77);                             # vzeroupper
    return 0;
}

fn EMIT_F64V_FMADD(S, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # a → xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # b → xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # mulpd xmm0, xmm1
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1);
    # c → xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 3);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # addpd xmm0, xmm1
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC1);
    # store to dst
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}
