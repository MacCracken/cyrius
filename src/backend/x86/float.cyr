# ================================================================
# SSE2 FLOAT EMISSION
# ================================================================
fn EMOVQ_X0_A(S): i64 { EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC0); return 0; }
fn EMOVQ_X1_C(S): i64 { EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC9); return 0; }
fn EMOVQ_A_X0(S): i64 { EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xC0); return 0; }
fn EF64ADD(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC1); return 0; }
fn EF64SUB(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x5C); EB(S, 0xC1); return 0; }
fn EF64MUL(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1); return 0; }
fn EF64DIV(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x5E); EB(S, 0xC1); return 0; }
fn EI2F(S): i64 { EB(S, 0xF2); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x2A); EB(S, 0xC0); return 0; }
fn EF2I(S): i64 { EB(S, 0xF2); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x2C); EB(S, 0xC0); return 0; }
fn EUCOMISD(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x2E); EB(S, 0xC1); return 0; }
fn EXORPD_X1(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x57); EB(S, 0xC9); return 0; }
fn EMOVAPD_01(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x28); EB(S, 0xC1); return 0; }

# x87 FPU: rax→stack→x87, compute, x87→stack→rax
fn EX87PUSH(S): i64 {
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xEC); EB(S, 0x10);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0x04); EB(S, 0x24);
    EB(S, 0xDD); EB(S, 0x04); EB(S, 0x24);
    return 0;
}
fn EX87POP(S): i64 {
    EB(S, 0xDD); EB(S, 0x1C); EB(S, 0x24);
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x04); EB(S, 0x24);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC4); EB(S, 0x10);
    return 0;
}

# sqrtsd xmm0, xmm0
fn EF64SQRT(S): i64 { EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x51); EB(S, 0xC0); return 0; }
# roundsd xmm0, xmm0, 1 (floor) — SSE4.1
fn EF64FLOOR(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x3A); EB(S, 0x0B); EB(S, 0xC0); EB(S, 0x01); return 0; }
# roundsd xmm0, xmm0, 2 (ceil) — SSE4.1
fn EF64CEIL(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x3A); EB(S, 0x0B); EB(S, 0xC0); EB(S, 0x02); return 0; }
# roundsd xmm0, xmm0, 0 (round to nearest) — SSE4.1
fn EF64ROUND(S): i64 { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x3A); EB(S, 0x0B); EB(S, 0xC0); EB(S, 0x00); return 0; }
# f64_abs: clear sign bit (bit 63) via integer AND
# No SSE needed — value is already in rax as bit pattern
# push rax; movabs rax, 0x7FFF...; mov rcx, rax; pop rax; and rax, rcx

fn EMIT_F64_BINOP(S, fop): i64 {
    EPOPC(S);
    EPUSHR(S);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC8);
    EMOVQ_X0_A(S);
    EPOPR(S);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EMOVQ_X1_C(S);
    if (fop == 0) { EF64ADD(S); }
    if (fop == 1) { EF64SUB(S); }
    if (fop == 2) { EF64MUL(S); }
    if (fop == 3) { EF64DIV(S); }
    EMOVQ_A_X0(S);
    return 0;
}

fn EMIT_FLOAT_LIT(S, fval): i64 {
    var numer = fval & 0xFFFFFFFF;
    var denom = (fval >> 32) & 0xFFFFFFFF;
    E2(S, 0xB848); E8(S, numer);
    EI2F(S);
    E2(S, 0xB948); E8(S, denom);
    EB(S, 0xF2); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x2A); EB(S, 0xC9);
    EF64DIV(S);
    EMOVQ_A_X0(S);
    return 0;
}

# f32_from(x): f64 (bit pattern in rax) → f32 (bit pattern in eax). v6.2.18.
# movq xmm0, rax; cvtsd2ss xmm0, xmm0; movd eax, xmm0 (zero-extends rax).
fn EF32_FROM(S): i64 {
    EMOVQ_X0_A(S);
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x5A); EB(S, 0xC0);   # cvtsd2ss xmm0, xmm0
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xC0);   # movd eax, xmm0
    return 0;
}

# f32_to(x): f32 (bit pattern in eax) → f64 (bit pattern in rax). v6.2.18.
# movd xmm0, eax; cvtss2sd xmm0, xmm0; movq rax, xmm0.
fn EF32_TO(S): i64 {
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xC0);   # movd xmm0, eax
    EB(S, 0xF3); EB(S, 0x0F); EB(S, 0x5A); EB(S, 0xC0);   # cvtss2sd xmm0, xmm0
    EMOVQ_A_X0(S);
    return 0;
}

# ================================================================
# SIMD — SSE2 packed f64 batch operations
# ================================================================
# v5.10.16 — fixes a long-latent x86 codegen bug (likely shipped
# v1.9.0): the LOOP/UNARY/FMADD emits computed slot-N frame disps
# as `-(N+1)*8` but EFLSTORE / EFLLOAD adjust by an additional
# `_cur_fn_regalloc * 8 + _cur_fn_ret_stash` for fns that auto-
# enabled callee-save register caching or return a struct via the
# hidden retbuf slot. The arg-stash and the loop-body load
# diverged by 40+ bytes for any fn that hit auto-regalloc — every
# call to f64v_add/_sub/_mul/_div/_sqrt/_abs/_fmadd from within
# such a fn segfaulted reading off the stash. Latent because the
# only consumers (programs/simd_expand_test.cyr) were never
# wired into check.sh; tcyr coverage added v5.10.16 forces this
# never to silently regress again.
#
# `_F64V_DISP` mirrors EFLSTORE's adjustment formula. The disp32
# `mov rdx, [rbp + disp32]` form (`48 8B 95 disp32`) is used
# unconditionally so adjusted disps below -128 don't truncate
# silently; the +3 bytes per load is amortized across the loop.

fn _F64V_DISP(idx): i64 {
    var disp = 0 - ((idx + 1) * 8);
    if (_cur_fn_regalloc > 0) { disp = disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { disp = disp - _cur_fn_ret_stash; }
    return disp;
}

fn _EMIT_LOAD_RDX_FROM_LOCAL(S, idx): i64 {
    # mov rdx, [rbp + disp32]: 48 8B 95 disp32
    var disp = _F64V_DISP(idx);
    EB(S, 0x48); EB(S, 0x8B); EB(S, 0x95);
    EB(S, disp & 0xFF);
    EB(S, (disp >> 8) & 0xFF);
    EB(S, (disp >> 16) & 0xFF);
    EB(S, (disp >> 24) & 0xFF);
    return 0;
}

fn EMIT_F64V_LOOP(S, op, vbase): i64 {
    # rcx = n (already in rax from last arg)
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    # rsi = 0 (loop counter)
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    # Loop header: cmp rsi, rcx; jge done
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # rdx = a base; movupd xmm0, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # rdx = b base; movupd xmm1, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # Operation: addpd/subpd/mulpd/divpd xmm0, xmm1
    EB(S, 0x66); EB(S, 0x0F);
    if (op == 0) { EB(S, 0x58); }
    if (op == 1) { EB(S, 0x5C); }
    if (op == 2) { EB(S, 0x59); }
    if (op == 3) { EB(S, 0x5E); }
    EB(S, 0xC1);
    # rdx = dst base; movupd [rdx+rsi*8], xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);
    # rsi += 2
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    # jmp loop_top
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v6.4.3+ (SIMD Phase 1) — packed f32 batch: addps/subps/mulps(dst, a, b, n).
# Mirror of EMIT_F64V_LOOP minus the 66 prefix (movups vs movupd, addps vs addpd)
# and with 4-byte lanes: the loads/store use [rdx+rsi*4] (SIB 0xB2, scale *4) and
# rsi advances by 4 f32s per 128-bit iteration. op 0=add(0x58) 1=sub(0x5C) 2=mul(0x59).
fn EMIT_F32V_LOOP(S, op, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0 (loop counter)
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);  # rdx = a base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # movups xmm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);  # rdx = b base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # movups xmm1, [rdx+rsi*4]
    EB(S, 0x0F);                              # addps/subps/mulps xmm0, xmm1
    if (op == 0) { EB(S, 0x58); }
    if (op == 1) { EB(S, 0x5C); }
    if (op == 2) { EB(S, 0x59); }
    EB(S, 0xC1);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);      # rdx = dst base
    EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xB2);   # movups [rdx+rsi*4], xmm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);   # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v6.4.5 (SIMD Phase 2) — EMIT_F32V_FMADD — dst[i] = a[i]*b[i] + c[i] via
# mulps + addps (SSE, packed-single). Mirror of EMIT_F64V_FMADD minus the 66
# prefix, with 4-byte lanes ([rdx+rsi*4] SIB 0xB2, rsi += 4).
# Args at vbase: dst, a, b, c, n(rax). The dense-f32 matmul inner-loop verb.
# Caller contract: n a multiple of 4, or over-allocate dst/a/b/c to a multiple
# of 4. Unlike f32v_dot (which only over-READS), the tail iteration also
# over-WRITES up to 3 dst lanes past n — a memory-corruption footgun for a
# tightly-sized dst. The lib f32v4_fmadd wrappers pin n=4 (always lane-safe).
fn EMIT_F32V_FMADD(S, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # a base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # movups xmm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);              # b base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # movups xmm1, [rdx+rsi*4]
    EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1);                # mulps xmm0, xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 3);              # c base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # movups xmm1, [rdx+rsi*4]
    EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC1);                # addps xmm0, xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # dst base
    EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xB2);   # movups [rdx+rsi*4], xmm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);   # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v6.4.5 (SIMD Phase 2) — EMIT_F32V_DOT(S, vbase) — sum of a[i]*b[i] for i in
# [0, n). Returns the f32 bit pattern in eax (zero-extended into rax). Slots:
# vbase=a, vbase+1=b; n in rax. Mirror of EMIT_F64V_DOT but reducing FOUR
# packed-single lanes: mulps+addps accumulate in xmm2, then TWO haddps (SSE3,
# F2 0F 7C) fold 4→1, then movd eax,xmm2 extracts the 32-bit result.
# Caller contract (same footgun as f64v_dot): n a multiple of 4, OR
# over-allocate to a multiple of 4 with ZEROED padding — the tail iteration
# multiplies+sums up to 3 lanes past n.
fn EMIT_F32V_DOT(S, vbase): i64 {
    EB(S, 0x0F); EB(S, 0x57); EB(S, 0xD2);   # xorps xmm2, xmm2 — zero accumulator
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # a base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xB2);   # movups xmm0, [rdx+rsi*4]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # b base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xB2);   # movups xmm1, [rdx+rsi*4]
    EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1);                # mulps xmm0, xmm1
    EB(S, 0x0F); EB(S, 0x58); EB(S, 0xD0);                # addps xmm2, xmm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x04);   # rsi += 4
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);   # haddps xmm2, xmm2  (4→2)
    EB(S, 0xF2); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);   # haddps xmm2, xmm2  (2→1)
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xD0);   # movd eax, xmm2 — f32 bits → rax
    return 0;
}

# v6.4.6 (Phase 3a) — EMIT_IVEC_BINOP(S, op, w, vbase) — packed INTEGER
# dst[i] = a[i] OP b[i]. op: 0=add 1=sub 2=mul. w = lane byte-width (1/2/4/8).
# Descriptor-driven (the "one integer op-table" the Phase-0 encoding was designed
# for): one 128-bit movups load/store per iter (reusing the f32v4 pattern), the
# op is padd{b,w,d,q} / psub{b,w,d,q} / pmullw|pmulld selected by w, and rsi
# advances by 16/w lanes with SIB scale = w. Args at vbase: dst, a, b, n(rax).
# add/sub are width-agnostic (two's complement — signed==unsigned); mul is i16/i32
# only (pmullw / pmulld SSE4.1) — w=1/w=8 mul hard-errors (no 1-instruction
# pmulb/pmulq). All integer ops carry the 66 prefix (packed-integer SSE2).
fn EMIT_IVEC_BINOP(S, op, w, vbase): i64 {
    var sib = 0x32; var step = 16;                       # w == 1: [rdx+rsi*1], +16 lanes
    if (w == 2) { sib = 0x72; step = 8; }
    if (w == 4) { sib = 0xB2; step = 4; }
    if (w == 8) { sib = 0xF2; step = 2; }
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);   # rcx = n
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);   # rsi = 0
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);   # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                 # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);              # a base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, sib);   # movups xmm0, [rdx+rsi*w]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);              # b base
    EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, sib);   # movups xmm1, [rdx+rsi*w]
    if (op == 0) {                                        # padd{b,w,d,q} xmm0, xmm1
        EB(S, 0x66); EB(S, 0x0F);
        if (w == 1) { EB(S, 0xFC); } if (w == 2) { EB(S, 0xFD); } if (w == 4) { EB(S, 0xFE); } if (w == 8) { EB(S, 0xD4); }
        EB(S, 0xC1);
    }
    if (op == 1) {                                        # psub{b,w,d,q} xmm0, xmm1
        EB(S, 0x66); EB(S, 0x0F);
        if (w == 1) { EB(S, 0xF8); } if (w == 2) { EB(S, 0xF9); } if (w == 4) { EB(S, 0xFA); } if (w == 8) { EB(S, 0xFB); }
        EB(S, 0xC1);
    }
    if (op == 2) {
        if (w == 2) { EB(S, 0x66); EB(S, 0x0F); EB(S, 0xD5); EB(S, 0xC1); }                   # pmullw
        elif (w == 4) { EB(S, 0x66); EB(S, 0x0F); EB(S, 0x38); EB(S, 0x40); EB(S, 0xC1); }    # pmulld (SSE4.1)
        else { ERR_MSG(S, "packed integer mul is i16/i32 only", 34); }
    }
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);                  # dst base
    EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, sib);   # movups [rdx+rsi*w], xmm0
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, step);   # add rsi, step (16/w lanes)
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# EMIT_F64V_UNARY — packed unary ops: sqrtpd (op=0), abs via andpd (op=1)
# Args at vbase: dst, src, n(rax)
fn EMIT_F64V_UNARY(S, op, vbase): i64 {
    # For abs: build sign mask in xmm2 — pcmpeqd xmm2,xmm2; psrlq xmm2,1
    if (op == 1) {
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x76); EB(S, 0xD2);
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x73); EB(S, 0xD2); EB(S, 0x01);
    }
    # rcx = n
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    # rsi = 0
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # rdx = src base; movupd xmm0, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    if (op == 0) {
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x51); EB(S, 0xC0);
    }
    if (op == 1) {
        EB(S, 0x66); EB(S, 0x0F); EB(S, 0x54); EB(S, 0xC2);
    }
    # rdx = dst base; movupd [rdx+rsi*8], xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# v5.10.17 — keystone primitives for hisab gap-close.
# Three flat-array verbs that compose enough of the dot/normalize/
# slerp/mat4_mul hot paths to make hisab benchmarks measurably
# faster vs Rust+glam. Cross-arch propagation MANDATORY in this
# slot (per the v5.10.16 lesson on aarch64-stub debt).

# EMIT_F64V_DOT(S, vbase) — sum of a[i] * b[i] for i in [0, n).
# Returns f64 bit pattern in rax. Slots: vbase=a, vbase+1=b. n in rax.
# Accumulator strategy: xmm2 holds packed pair of partial sums; loop
# does mulpd+addpd to accumulate; tail uses haddpd (SSE3) to reduce
# to a scalar, then movq rax, xmm2 to extract bits.
fn EMIT_F64V_DOT(S, vbase): i64 {
    # xorpd xmm2, xmm2 — zero accumulator
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x57); EB(S, 0xD2);
    # rcx = n
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    # rsi = 0
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);          # cmp rsi, rcx
    EB(S, 0x0F); EB(S, 0x8D);                       # jge done
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # rdx = a base; movupd xmm0, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # rdx = b base; movupd xmm1, [rdx+rsi*8]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # mulpd xmm0, xmm1
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1);
    # addpd xmm2, xmm0  — accumulator += a*b
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xD0);
    # rsi += 2
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    # haddpd xmm2, xmm2 — SSE3 horizontal add: xmm2.low = xmm2[0] + xmm2[1]
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x7C); EB(S, 0xD2);
    # movq rax, xmm2  — extract f64 bit pattern into rax
    EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x7E); EB(S, 0xD0);
    return 0;
}

# EMIT_F64V_SCALE(S, vbase) — dst[i] = a[i] * scalar.
# Slots: vbase=dst, vbase+1=a, vbase+2=scalar (f64 bit pattern). n in rax.
# Pre-loop: load scalar into xmm2 and broadcast to both lanes.
fn EMIT_F64V_SCALE(S, vbase): i64 {
    # rdx = scalar (i64 bit pattern)
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    # movq xmm2, rdx — xmm2.low = scalar bits
    EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xD2);
    # unpcklpd xmm2, xmm2 — broadcast: xmm2 = {scalar, scalar}
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x14); EB(S, 0xD2);
    # rcx = n; rsi = 0
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # load a[i..i+1] into xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # mulpd xmm0, xmm2  — xmm0 *= broadcast scalar
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC2);
    # store xmm0 to dst[i..i+1]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# EMIT_F64V_AXPY(S, vbase) — y[i] += alpha * x[i].
# Slots: vbase=y, vbase+1=x, vbase+2=alpha. n in rax.
# SSE2 has no FMA — fused via mulpd + addpd.
fn EMIT_F64V_AXPY(S, vbase): i64 {
    # rdx = alpha bits; xmm2 = {alpha, alpha}
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0x66); EB(S, 0x48); EB(S, 0x0F); EB(S, 0x6E); EB(S, 0xD2);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x14); EB(S, 0xD2);
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # load x[i..i+1] into xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # mulpd xmm0, xmm2 — xmm0 = alpha * x[i..i+1]
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC2);
    # load y[i..i+1] into xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # addpd xmm1, xmm0 — xmm1 += alpha*x
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC8);
    # store xmm1 to y[i..i+1]
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x0C); EB(S, 0xF2);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}

# EMIT_F64V_FMADD — dst[i] = a[i]*b[i] + c[i] using mulpd + addpd (SSE2)
# Args at vbase: dst, a, b, c, n(rax)
fn EMIT_F64V_FMADD(S, vbase): i64 {
    EB(S, 0x48); EB(S, 0x89); EB(S, 0xC1);
    EB(S, 0x48); EB(S, 0x31); EB(S, 0xF6);
    var loop_top = GCP(S);
    EB(S, 0x48); EB(S, 0x39); EB(S, 0xCE);
    EB(S, 0x0F); EB(S, 0x8D);
    var done_patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # a → xmm0
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 1);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x04); EB(S, 0xF2);
    # b → xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 2);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # mulpd xmm0, xmm1
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x59); EB(S, 0xC1);
    # c → xmm1
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase + 3);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x10); EB(S, 0x0C); EB(S, 0xF2);
    # addpd xmm0, xmm1
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x58); EB(S, 0xC1);
    # store to dst
    _EMIT_LOAD_RDX_FROM_LOCAL(S, vbase);
    EB(S, 0x66); EB(S, 0x0F); EB(S, 0x11); EB(S, 0x04); EB(S, 0xF2);
    EB(S, 0x48); EB(S, 0x83); EB(S, 0xC6); EB(S, 0x02);
    EJMP(S, loop_top);
    EPATCH(S, done_patch);
    return 0;
}
