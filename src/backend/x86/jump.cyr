
# ================================================================
# JUMP / PATCH HELPERS
# ================================================================

# Emit conditional jump (0F cc 00000000), return patch offset
# cycc: records IR_JCC node with condition code in flags
fn EJCC(S, cc): i64 {
    # Note: always emit x86 even in mode 2 — patch offsets needed by parse.cyr
    EB(S, 0x0F);
    EB(S, cc);
    var patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # cycc: record conditional jump with patch offset for edge matching
    var _ire = IR_ENABLED(S);
    if (_ire >= 1) { ir_emit(S, IR_JCC, cc, 0, patch); }
    # v5.6.27: record disp32 source CP for codebuf-compaction repair.
    var _jsc = L64(S + 0x1A0000);
    if (_jsc < 1024) {
        S64(S + 0x1A0008 + _jsc * 8, patch);
        S64(S + 0x1A0000, _jsc + 1);
    }
    return patch;
}

# Emit unconditional jmp to target (E9 rel32)
# Also records target as a jump target for basic-block analysis.
# cycc: records IR_JMP_BACK with absolute target offset
fn EJMP(S, target): i64 {
    var _ire = IR_ENABLED(S);
    if (_ire >= 1) { ir_emit(S, IR_JMP_BACK, 0, 0, target); }
    EB(S, 0xE9);
    var cp = GCP(S);
    var rel = target - cp - 4;
    var addr = _codebuf_base + cp;
    S64(addr, (L64(addr) >> 32 << 32) | (rel & 0xFFFFFFFF));
    SCP(S, cp + 4);
    # v5.6.27: record disp32 source CP for codebuf-compaction repair.
    var _jsc = L64(S + 0x1A0000);
    if (_jsc < 1024) {
        S64(S + 0x1A0008 + _jsc * 8, cp);
        S64(S + 0x1A0000, _jsc + 1);
    }
    # Record jump target (CVE-09: warn on overflow)
    # AR-03 (v6.1.38): the table is 0x19E000..0x1A0000 (8 KB) with the count in
    # the first 8 B, so the entries at 0x19E008 hold only 1023 slots (8184/8),
    # not 1024 — at jtc=1023 the write landed at 0x1A0000 = jump_src_cnt, the
    # next region. Cap at 1023; warn (LASE off) when the 1023rd is reached.
    var jtc = L64(S + 0x19E000);
    if (jtc < 1023) {
        S64(S + 0x19E008 + jtc * 8, target);
        S64(S + 0x19E000, jtc + 1);
    } else {
        # CVE-09 (v6.3.21): the table holds only 1023 slots (the count eats the
        # first 8 B of the 8 KB budget). Past 1023, targets go UNRECORDED, so
        # ir_build_bbs misses a BB boundary and LASE (Load-After-Store Elim, x86,
        # CYRIUS_IR=3) can eliminate a load that is live via the unrecorded target
        # → silent wrong codegen. HARD-ERROR now, not the old silent warn: no real
        # function comes near 1023 targets (0 hits across cycc self-host + the whole
        # differential corpus), so this is byte-identical for every real program.
        syscall(SYS_WRITE, 2, "error: function exceeds 1023 jump targets (x86 LASE cap) - split the function\n", 78);
        syscall(SYS_EXIT, 1);
    }
    return 0;
}

# Emit jmp placeholder (E9 00000000), return patch offset
# cycc: records IR_JMP node (forward, target resolved at EPATCH)
fn EJMP0(S): i64 {
    EB(S, 0xE9);
    var patch = GCP(S);
    EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
    # cycc: record forward JMP with patch offset for edge matching
    var _ire = IR_ENABLED(S);
    if (_ire >= 1) { ir_emit(S, IR_JMP, 0, 0, patch); }
    # v5.6.27: record disp32 source CP for codebuf-compaction repair.
    var _jsc = L64(S + 0x1A0000);
    if (_jsc < 1024) {
        S64(S + 0x1A0008 + _jsc * 8, patch);
        S64(S + 0x1A0000, _jsc + 1);
    }
    return patch;
}

# Patch a previously emitted rel32 at codebuf offset to jump here
# Also records GCP(S) as a jump target for basic-block analysis.
# cycc: records IR_NOP as BB boundary marker (landing pad)
fn EPATCH(S, off): i64 {
    # cycc: record landing pad with the patch offset for edge matching
    var _ire = IR_ENABLED(S);
    if (_ire >= 1) { ir_emit(S, IR_NOP, 0, off, 0); }
    var cp = GCP(S);
    var rel = cp - off - 4;
    var addr = _codebuf_base + off;
    S64(addr, (L64(addr) >> 32 << 32) | (rel & 0xFFFFFFFF));
    # Record jump target
    # AR-03 (v6.1.38): cap at 1023 like EJMP — the table at 0x19E008 holds only
    # 1023 slots before jump_src_cnt at 0x1A0000 (the count eats the first 8 B of
    # the 8 KB budget). jtc<1024 here wrote slot 1023 into jump_src_cnt.
    var jtc = L64(S + 0x19E000);
    if (jtc < 1023) {
        S64(S + 0x19E008 + jtc * 8, cp);
        S64(S + 0x19E000, jtc + 1);
    } else {
        # CVE-09 (v6.3.21): same 1023 cap as EJMP — hard-error rather than silently
        # drop the landing pad (which would let LASE mis-eliminate). Shared count, so
        # whichever of EJMP/EPATCH reaches the cap first errors.
        syscall(SYS_WRITE, 2, "error: function exceeds 1023 jump targets (x86 LASE cap) - split the function\n", 78);
        syscall(SYS_EXIT, 1);
    }
    return 0;
}

