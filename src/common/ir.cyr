# ir.cyr — cycc intermediate representation
#
# Basic-block CFG between parse (frontend) and emit (backend).
# Parse builds IR; lowering pass walks IR and calls emit functions.
#
# Memory layout (all relative to S):
#   0x5E9D000  ir_nodes    [16MB]  1048576 nodes × 16 bytes  (v6.3.28: relocated
#              from 0xA3A000 + cap 262144→1048576. cycc's own whole-program IR
#              demands ~280K nodes — over the old cap → "IR node buffer full"
#              abort → 0 bytes. The node/cp arrays were boxed against ir_blocks,
#              so both moved to the arena TOP, above the v6.3.27 liveness arrays.
#              IR is touched ONLY under CYRIUS_IR, so the larger region is lazy
#              VA — zero real-memory cost on default builds.)
#   0x6E9D000  ir_cp       [4MB]   1048576 node CP offsets × 4 bytes (relocated
#              from 0xF7B000). ir_nodes ends 0x6E9D000; ir_cp ends 0x729D000.
#   0xB3A000  ir_blocks   [1MB]   32768 blocks × 32 bytes  (unchanged)
#   0xF3A000 ir_state    [4KB]   counters + current state (IR_NCNT/BCNT/CURBB/ECNT/ENABLED @ 0xF3A000..028)
#   0xF3B000 ir_edges    [256KB] 32768 edges × 8 bytes
#
# IRNode (16 bytes):
#   +0: opcode (i16) + flags (i16) packed in low 32 bits
#   +4: arg1 (i32) — var index, block target, immediate
#   +8: arg2 (i64) — large immediate, fn index, etc.
#
# BB (32 bytes):
#   +0:  id
#   +8:  first_node (index into ir_nodes)
#   +16: node_count
#   +24: succ0 (first successor BB, -1 = none)
#        succ1 packed in high 32 bits (for conditional branches)

# IR_ENABLED modes:
#   0 = off (normal direct emit)
#   1 = dual (record IR AND emit x86 — for analysis/debugging)
#   2 = record-only (record IR, skip x86 — for IR-driven codegen)
#
# After parsing with mode 2, call ir_lower_all with mode 0 to emit x86.

# ================================================================
# IR opcodes
# ================================================================

enum IROp {
    # -- Values --
    IR_NOP         = 0;
    IR_LOAD_IMM    = 1;   # arg2 = immediate value → rax
    IR_LOAD_LOCAL  = 2;   # arg1 = local index → rax
    IR_STORE_LOCAL = 3;   # arg1 = local index ← rax
    IR_LOAD_GLOBAL = 4;   # arg1 = var index → rax
    IR_STORE_GLOBAL= 5;   # arg1 = var index ← rax
    IR_LOAD_ADDR_L = 6;   # arg1 = local index → rax = &local
    IR_LOAD_ADDR_G = 7;   # arg1 = var index → rax = &global
    IR_LOAD_STR    = 8;   # arg1 = string offset → rax
    IR_LOAD_ADDR_G_X1 = 9;  # arg1 = var index → RCX = &global (EVADDR_X1, x86).
                            # v6.3.28: DISTINCT from IR_LOAD_ADDR_G (which is → RAX
                            # via EVADDR). Both emit movabs $imm,reg but into
                            # different registers; sharing one opcode made the
                            # liveness model treat the rcx-writing movabs as a pure
                            # RAX def, so ir_dce_capped eliminated it as "dead rax"
                            # → NOP-fill → SIGILL on struct-init/#derive. This op is
                            # in _ir_def_rcx_any (writes rcx) and in NO _pure set
                            # (never DCE-eliminable). CYRIUS_IR=3 substrate fix.

    # -- Arithmetic --
    IR_ADD         = 10;  # rax = rcx + rax
    IR_SUB         = 11;  # rax = rcx - rax
    IR_MUL         = 12;  # rax = rcx * rax (imul)
    IR_DIV         = 13;  # rax = rcx / rax (idiv, cqo)
    IR_MOD         = 14;  # rax = rcx % rax (idiv, rdx)
    IR_NEG         = 15;  # rax = -rax

    # -- Bitwise --
    IR_AND         = 20;
    IR_OR          = 21;
    IR_XOR         = 22;
    IR_NOT         = 23;
    IR_SHL         = 24;  # rax = rcx << rax
    IR_SHR         = 25;  # rax = rcx >> rax
    IR_ASHR        = 26;  # rax = rcx >>> rax (ARITHMETIC/sign-preserving; keep >> logical)

    # -- Stack --
    IR_PUSH        = 30;  # push rax
    IR_POP_RAX     = 31;  # pop rax
    IR_POP_RCX     = 32;  # pop rcx
    IR_MOV_CA      = 33;  # mov rcx, rax

    # -- Memory --
    IR_LOAD8       = 40;  # rax = zero_extend(byte [rax])
    IR_LOAD16      = 41;
    IR_LOAD32      = 42;
    IR_LOAD64      = 43;  # rax = [rax]
    IR_STORE8      = 44;  # [rcx] = al
    IR_STORE16     = 45;
    IR_STORE32     = 46;
    IR_STORE64     = 47;  # [rcx] = rax

    # -- Compare --
    IR_CMP         = 50;  # cmp rax, rcx (sets flags)
    IR_SETCC       = 51;  # arg1 = condition code → rax = 0 or 1
    IR_TEST_AZ     = 52;  # test rax, rax

    # -- Calls --
    IR_CALL        = 60;  # arg1 = fn index (fixup)
    IR_CALL_KNOWN  = 61;  # arg2 = code offset (direct)
    IR_CALL_POPS   = 62;  # arg1 = argc (pop args into regs)
    IR_CALL_CLEAN  = 63;  # arg1 = argc (stack cleanup)
    IR_TAIL_JMP    = 64;  # arg1 = fn index
    IR_SYSCALL     = 65;  # syscall instruction
    IR_CALL_INDIRECT = 66;  # arg1 = spill local idx holding the callee ptr; call [rbp-disp] / blr (v6.0.70)

    # -- Control flow (terminators) --
    IR_JMP         = 70;  # arg1 = target BB index
    IR_JCC         = 71;  # arg1 = true BB, arg2 = false BB, flags = cc
    IR_RET         = 72;  # return (jump to epilogue)
    IR_JMP_BACK    = 73;  # arg2 = absolute code offset (loop back-edge)
    IR_SWITCH      = 74;  # arg1 = table BB index

    # -- Frame --
    IR_PROLOGUE    = 80;  # push rbp; mov rbp, rsp
    IR_ALLOC_FRAME = 81;  # sub rsp, N (arg1 = patch offset)
    IR_EPILOGUE    = 82;  # leave; ret
    IR_PATCH_FRAME = 83;  # arg1 = patch offset, arg2 = frame size

    # -- Special --
    IR_RAW_BYTE    = 90;  # arg1 = byte value (inline asm)
    IR_MOV_RDX_RAX = 91;  # mov rdx, rax
    IR_MOV_RAX_RDX = 92;  # mov rax, rdx
    IR_XOR_AA      = 93;  # xor rax, rax
    IR_STORE_PARM  = 94;  # arg1 = param_idx, arg2 = local_idx
    IR_ADD_IMM_X1  = 95;  # rcx += arg2
    # v5.6.14 O3a-fix: marker recorded by emit fns that clobber rax
    # but have no natural IR opcode of their own (EMULH, EIDIV, ELODC).
    # Before v5.6.14 these fns gated only on `IR_ENABLED == 2` (skip
    # direct emit in replay mode) and never recorded IR in mode 1 —
    # LASE then couldn't see the rax clobber and wrongly eliminated
    # subsequent LOAD_LOCALs that read a local whose corresponding
    # rax shadow had been destroyed by the unrecorded intermediate.
    # No lowering — the emit fn already wrote the raw bytes.
    IR_RAX_CLOBBER = 97;
    # v5.6.12 O3a: "parse emitted raw bytes here — treat opaquely".
    # Placed before an un-wrapped EB/E2/E3/EW/E8 block in parse_*.cyr.
    # Conservatively clobbers rax (callers must not assume anything
    # about rax across this marker). Keeps DBE's `all_nop` check from
    # deciding a BB is dead when parse emitted real code into it.
    # No lowering — the raw emit has already happened by the time the
    # IR is walked.
    IR_RAW_EMIT    = 98;
    IR_ELIMINATED  = 99;  # LASE-eliminated node (NOP-fill in codebuf)
    # v6.5.21 — THIRD multi-value return slot, for `fn f(): (a, b, c)`.
    # Peer of IR_MOV_RDX_RAX / IR_MOV_RAX_RDX (91/92); the physical register
    # is r8 on x86-family, x3 on aarch64, r5 on cx. Every opcode-keyed table
    # below gains an arm alongside its 91/92 sibling — the replay dispatch,
    # the name table, the defines-rax set and the reads-rax set.
    IR_MOV_R3_RAX  = 100;  # mov <ret3>, rax
    IR_MOV_RAX_R3  = 101;  # mov rax, <ret3>
}

# Helper: record IR node and return 1 if should skip x86 (mode 2), 0 if should emit
fn _IR_REC0(S, op): i64 {
    var m = IR_ENABLED(S);
    if (m >= 1) { ir_emit0(S, op); }
    if (m == 2) { return 1; }
    return 0;
}
fn _IR_REC1(S, op, a1): i64 {
    var m = IR_ENABLED(S);
    if (m >= 1) { ir_emit1(S, op, a1); }
    if (m == 2) { return 1; }
    return 0;
}
fn _IR_REC(S, op, fl, a1, a2): i64 {
    var m = IR_ENABLED(S);
    if (m >= 1) { ir_emit(S, op, fl, a1, a2); }
    if (m == 2) { return 1; }
    return 0;
}

# ================================================================
# IR state accessors
# ================================================================

fn IR_NCNT(S): i64 { return L64(S + 0xF3A000); }
fn IR_SNCNT(S, v): i64 { S64(S + 0xF3A000, v); return 0; }
# v6.1.41: these 4 IR-state counters were stranded at 0x174A0xx — INSIDE the
# fixup_tbl region (0x107B000+fc*16; fixup entry 446208 lands at 0x174A000), so
# at ≥446k fixups with CYRIUS_IR enabled they collided. Moved into the documented
# ir_state region [0xF3A000,0xF3B000) alongside IR_NCNT (0xF3A000).
fn IR_BCNT(S): i64 { return L64(S + 0xF3A008); }
fn IR_SBCNT(S, v): i64 { S64(S + 0xF3A008, v); return 0; }
fn IR_CURBB(S): i64 { return L64(S + 0xF3A010); }
fn IR_SCURBB(S, v): i64 { S64(S + 0xF3A010, v); return 0; }
fn IR_ECNT(S): i64 { return L64(S + 0xF3A018); }
fn IR_SECNT(S, v): i64 { S64(S + 0xF3A018, v); return 0; }
fn IR_ENABLED(S): i64 { return L64(S + 0xF3A020); }
fn IR_SENABLE(S, v): i64 { S64(S + 0xF3A020, v); return 0; }

# ================================================================
# IR node read/write
# ================================================================

# Pack opcode (16 bit) + flags (16 bit) into one i64 low 32 bits
fn _ir_pack_op(op, flags): i64 {
    return (op & 0xFFFF) | ((flags & 0xFFFF) << 16);
}

# Write an IR node at index ni
fn _ir_set_node(S, ni, opflags, arg1, arg2): i64 {
    var base = S + 0x5E9D000 + ni * 16;
    store32(base, opflags);
    store32(base + 4, arg1);
    store64(base + 8, arg2);
    return 0;
}

# Read IR node fields
fn IR_NODE_CP(S, ni): i64 { return load32(S + 0x6E9D000 + ni * 4); }
fn IR_NODE_OP(S, ni): i64 { return load16(S + 0x5E9D000 + ni * 16); }
fn IR_NODE_FL(S, ni): i64 { return load16(S + 0x5E9D000 + ni * 16 + 2); }
fn IR_NODE_A1(S, ni): i64 { return load32(S + 0x5E9D000 + ni * 16 + 4); }
fn IR_NODE_A2(S, ni): i64 { return load64(S + 0x5E9D000 + ni * 16 + 8); }

# ================================================================
# Basic block read/write
# ================================================================

# BB layout (32 bytes):
#   +0:  id
#   +8:  first_node
#   +16: node_count
#   +24: succ0 | (succ1 << 32)

fn _ir_set_bb(S, bi, first, count, succ0, succ1): i64 {
    var base = S + 0xB3A000 + bi * 32;
    store64(base, bi);
    store64(base + 8, first);
    store64(base + 16, count);
    store64(base + 24, (succ0 & 0xFFFFFFFF) | ((succ1 & 0xFFFFFFFF) << 32));
    return 0;
}

fn IR_BB_ID(S, bi): i64 { return load64(S + 0xB3A000 + bi * 32); }
fn IR_BB_FIRST(S, bi): i64 { return load64(S + 0xB3A000 + bi * 32 + 8); }
fn IR_BB_COUNT(S, bi): i64 { return load64(S + 0xB3A000 + bi * 32 + 16); }
fn IR_BB_SUCC0(S, bi): i64 { return load64(S + 0xB3A000 + bi * 32 + 24) & 0xFFFFFFFF; }
fn IR_BB_SUCC1(S, bi): i64 { return (load64(S + 0xB3A000 + bi * 32 + 24) >> 32) & 0xFFFFFFFF; }

# ================================================================
# Cross-BB liveness arrays (v6.3.27, analysis-only, gated under CYRIUS_IR)
# ================================================================
# Per-BB register-liveness bitmaps (one u64 each, indexed by BB id, ≤32768).
# Bit encoding widens the v5.6.16 2-bit DCE map: bit0=RAX, bit1=RCX, and (storage
# reserved, no allocation meaning yet) bit2=RBX, bit3=R12, bit4=R13, bit5=R14,
# bit6=R15. `ir_liveness_cfg` computes these as a CFG fixpoint; the register
# allocation/rewrite that would CONSUME bits 2-6 is deferred to a later slot that
# first builds the IR re-emit path (the in-place-patch emit model can't grow a
# `push`→`mov reg` instruction). Cross-BB liveness is the reusable substrate the
# v6.3.28 copy-prop + v6.3.29 cross-BB DSE consume.
#
# Placed at the arena top (past local_types @ 0x5DDD000): live_in @ S+0x207B000,
# live_out @ S+0x217B000, 256 KB each (32768 × 8). The S arena was bumped +512 KB
# (0x207B000 → 0x5E9D000, main.cyr) to hold them. Zero-init by mmap/brk; only
# touched under CYRIUS_IR, so the default emit path is unaffected.
fn IR_LIVEIN(S, bi): i64 { return load64(S + 0x207B000 + bi * 8); }
fn IR_SLIVEIN(S, bi, v): i64 { store64(S + 0x207B000 + bi * 8, v); return 0; }
fn IR_LIVEOUT(S, bi): i64 { return load64(S + 0x217B000 + bi * 8); }
fn IR_SLIVEOUT(S, bi, v): i64 { store64(S + 0x217B000 + bi * 8, v); return 0; }

# ================================================================
# IR builder — Phase 2 API
# ================================================================

# Create a new basic block. Returns block index.
fn ir_bb_new(S): i64 {
    var bi = IR_BCNT(S);
    if (bi >= 131072) {
        syscall(SYS_WRITE, 2, "error: IR block table full\n", 27);
        syscall(SYS_EXIT, 1);
    }
    var ni = IR_NCNT(S);
    _ir_set_bb(S, bi, ni, 0, 0 - 1, 0 - 1);
    IR_SBCNT(S, bi + 1);
    return bi;
}

# Set current basic block for subsequent ir_emit calls
fn ir_set_bb(S, bi): i64 {
    IR_SCURBB(S, bi);
    return 0;
}

# Emit an IR node into the current basic block.
# Also records current CP for post-LASE NOP patching.
# Returns node index.
fn ir_emit(S, op, flags, arg1, arg2): i64 {
    var ni = IR_NCNT(S);
    if (ni >= 1048576) {
        syscall(SYS_WRITE, 2, "error: IR node buffer full\n", 27);
        syscall(SYS_EXIT, 1);
    }
    _ir_set_node(S, ni, _ir_pack_op(op, flags), arg1, arg2);
    # Record codebuf position (32-bit, CP fits in 1MB)
    store32(S + 0x6E9D000 + ni * 4, GCP(S));
    IR_SNCNT(S, ni + 1);

    # Update current BB's node count
    var bi = IR_CURBB(S);
    if (bi >= 0 && bi < 131072) {
        var base = S + 0xB3A000 + bi * 32;
        store64(base + 16, load64(base + 16) + 1);
    }
    return ni;
}

# Convenience: emit with just opcode (no args)
fn ir_emit0(S, op): i64 { return ir_emit(S, op, 0, 0, 0); }

# Convenience: emit with opcode + arg1
fn ir_emit1(S, op, arg1): i64 { return ir_emit(S, op, 0, arg1, 0); }

# Convenience: emit with opcode + arg2 (large immediate)
fn ir_emit2(S, op, arg2): i64 { return ir_emit(S, op, 0, 0, arg2); }

# Set BB successor (unconditional jump)
fn ir_bb_set_succ(S, bi, target): i64 {
    var base = S + 0xB3A000 + bi * 32;
    var cur = load64(base + 24);
    store64(base + 24, (target & 0xFFFFFFFF) | (cur & 0xFFFFFFFF00000000));
    return 0;
}

# Set BB successors (conditional: true_bb, false_bb)
fn ir_bb_set_cond(S, bi, true_bb, false_bb): i64 {
    var base = S + 0xB3A000 + bi * 32;
    store64(base + 24, (true_bb & 0xFFFFFFFF) | ((false_bb & 0xFFFFFFFF) << 32));
    return 0;
}

# Add a CFG edge (for analysis passes)
fn ir_add_edge(S, from_bb, to_bb): i64 {
    var ec = IR_ECNT(S);
    if (ec >= 8192) { return 0; }
    var base = S + 0xF3B000 + ec * 8;
    store64(base, (from_bb & 0xFFFFFFFF) | ((to_bb & 0xFFFFFFFF) << 32));
    IR_SECNT(S, ec + 1);
    return 0;
}

fn IR_EDGE_FROM(S, ei): i64 { return load64(S + 0xF3B000 + ei * 8) & 0xFFFFFFFF; }
fn IR_EDGE_TO(S, ei): i64 { return (load64(S + 0xF3B000 + ei * 8) >> 32) & 0xFFFFFFFF; }

# Reset IR state (between functions or at start of compilation)
fn ir_reset(S): i64 {
    IR_SNCNT(S, 0);
    IR_SBCNT(S, 0);
    IR_SCURBB(S, 0 - 1);
    IR_SECNT(S, 0);
    return 0;
}

# ================================================================
# IR→x86 lowering (Phase 3)
# ================================================================
# Walks all basic blocks in order, emits x86 for each IR node
# by calling the existing emit.cyr functions.
# This function is the bridge: same output as direct emission,
# but driven from the IR data structure.

fn ir_lower_all(S): i64 {
    var bi = 0;
    var bcnt = IR_BCNT(S);
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        var ni = first;
        while (ni < first + count) {
            var op = IR_NODE_OP(S, ni);
            var fl = IR_NODE_FL(S, ni);
            var a1 = IR_NODE_A1(S, ni);
            var a2 = IR_NODE_A2(S, ni);
            _ir_lower_node(S, op, fl, a1, a2);
            ni = ni + 1;
        }
        bi = bi + 1;
    }
    return 0;
}

# Lower a single IR node to x86 via emit.cyr functions
fn _ir_lower_node(S, op, fl, a1, a2): i64 {
    if (op == IR_NOP)           { return 0; }
    if (op == IR_LOAD_IMM)      { EMOVI(S, a2); return 0; }
    if (op == IR_LOAD_LOCAL)    { EFLLOAD(S, a1); return 0; }
    if (op == IR_STORE_LOCAL)   { EFLSTORE(S, a1); return 0; }
    if (op == IR_LOAD_GLOBAL)   { EVLOAD(S, a1); return 0; }
    if (op == IR_STORE_GLOBAL)  { EVSTORE(S, a1); return 0; }
    if (op == IR_LOAD_ADDR_L)   {
        # LEA rax, [rbp + disp32] — emit inline (no dedicated emit fn)
        var disp = 0 - ((a1 + 1) * 8);
        EB(S, 0x48); EB(S, 0x8D); EB(S, 0x85);
        EDISP32(S, disp);
        return 0;
    }
    if (op == IR_LOAD_ADDR_G)   { EVADDR(S, a1); return 0; }
    if (op == IR_LOAD_STR)      { ESADDR(S, a1); return 0; }

    if (op == IR_ADD)           { EADDR(S); return 0; }
    if (op == IR_SUB)           { ESUBR(S); return 0; }
    if (op == IR_MUL)           { EIMUL(S); return 0; }
    if (op == IR_DIV)           { ECQO(S); EIDIV(S); return 0; }
    if (op == IR_MOD)           { ECQO(S); EIDIV(S); EMOVDR(S); return 0; }

    if (op == IR_AND)           { EANDR(S); return 0; }
    if (op == IR_OR)            { EORR(S); return 0; }
    if (op == IR_XOR)           { EXORR(S); return 0; }
    if (op == IR_NOT)           { ENOTR(S); return 0; }
    if (op == IR_SHL)           { ESHLCL(S); return 0; }
    if (op == IR_SHR)           { ESHRCL(S); return 0; }
    if (op == IR_ASHR)          { EASHRCL(S); return 0; }

    if (op == IR_PUSH)          { EPUSHR(S); return 0; }
    if (op == IR_POP_RAX)       { EPOPR(S); return 0; }
    if (op == IR_POP_RCX)       { EPOPC(S); return 0; }
    if (op == IR_MOV_CA)        { EMOVCA(S); return 0; }

    if (op == IR_LOAD8)         { ELOAD8(S); return 0; }
    if (op == IR_LOAD16)        { ELOAD16(S); return 0; }
    if (op == IR_LOAD32)        { ELOAD32(S); return 0; }
    if (op == IR_LOAD64)        { ELOAD64(S); return 0; }
    if (op == IR_STORE8)        { ESTORE8(S); return 0; }
    if (op == IR_STORE16)       { ESTORE16(S); return 0; }
    if (op == IR_STORE32)       { ESTORE32(S); return 0; }
    if (op == IR_STORE64)       { ESTORE64(S); return 0; }

    if (op == IR_CMP)           { ECMPR(S); return 0; }
    if (op == IR_SETCC)         { ESETCC(S, a1); return 0; }
    if (op == IR_TEST_AZ)       { ETESTAZ(S); return 0; }

    if (op == IR_CALL)          { ECALLFIX(S, a1); return 0; }
    if (op == IR_CALL_KNOWN)    { ECALLTO(S, a2); return 0; }
    if (op == IR_CALL_POPS)     { ECALLPOPS(S, a1); return 0; }
    if (op == IR_CALL_CLEAN)    { ECALLCLEAN(S, a1); return 0; }
    if (op == IR_TAIL_JMP)      { ETAILJMP(S, a1); return 0; }
    if (op == IR_SYSCALL)       { ESYSCALL(S); return 0; }
    if (op == IR_CALL_INDIRECT) { ECALLIND(S, a1); return 0; }

    if (op == IR_PROLOGUE)      { EFNPRO(S); return 0; }
    if (op == IR_ALLOC_FRAME)   { ESUBRSP(S); return 0; }
    if (op == IR_EPILOGUE)      { EFNEPI(S); return 0; }
    if (op == IR_PATCH_FRAME)   { EPATCHFRAME(S, a1, a2); return 0; }

    if (op == IR_RAW_BYTE)      { EB(S, a1); return 0; }
    # v5.6.12 IR_RAW_EMIT is a parse-time marker only — the raw bytes
    # were already emitted at record time. No action in lower.
    if (op == IR_RAW_EMIT)      { return 0; }
    # v5.6.14 IR_RAX_CLOBBER is a record-time marker only — same
    # "already emitted" shape as IR_RAW_EMIT.
    if (op == IR_RAX_CLOBBER)   { return 0; }
    if (op == IR_MOV_RDX_RAX)   { EMOVRDXRAX(S); return 0; }
    if (op == IR_MOV_RAX_RDX)   { EMOVRA_RDX(S); return 0; }
    if (op == IR_MOV_R3_RAX)    { EMOVR3RAX(S); return 0; }
    if (op == IR_MOV_RAX_R3)    { EMOVRA_R3(S); return 0; }
    if (op == IR_XOR_AA)        { EXORAA(S); return 0; }
    if (op == IR_STORE_PARM)    { ESTOREPARM(S, a1, a2, 0); return 0; }
    if (op == IR_ADD_IMM_X1)    { EADDIMM_X1(S, a2); return 0; }

    # Jump terminators are handled by the BB walker, not individual lowering
    if (op == IR_JMP)           { EJMP(S, a2); return 0; }
    if (op == IR_JCC)           { EJCC(S, fl); return 0; }
    if (op == IR_RET)           { return 0; }  # epilogue emitted separately

    return 0;
}

# ================================================================
# IR dump (CYRIUS_IR=2 verbose mode)
# ================================================================

fn _ir_opname(op): i64 {
    if (op == IR_NOP)          { return "NOP"; }
    if (op == IR_LOAD_IMM)     { return "LOAD_IMM"; }
    if (op == IR_LOAD_LOCAL)   { return "LOAD_L"; }
    if (op == IR_STORE_LOCAL)  { return "STORE_L"; }
    if (op == IR_LOAD_GLOBAL)  { return "LOAD_G"; }
    if (op == IR_STORE_GLOBAL) { return "STORE_G"; }
    if (op == IR_LOAD_ADDR_G)  { return "ADDR_G"; }
    if (op == IR_LOAD_ADDR_G_X1) { return "ADDR_G_X1"; }
    if (op == IR_LOAD_STR)     { return "LOAD_STR"; }
    if (op == IR_ADD)          { return "ADD"; }
    if (op == IR_SUB)          { return "SUB"; }
    if (op == IR_MUL)          { return "MUL"; }
    if (op == IR_AND)          { return "AND"; }
    if (op == IR_OR)           { return "OR"; }
    if (op == IR_XOR)          { return "XOR"; }
    if (op == IR_NOT)          { return "NOT"; }
    if (op == IR_SHL)          { return "SHL"; }
    if (op == IR_SHR)          { return "SHR"; }
    if (op == IR_ASHR)         { return "ASHR"; }
    if (op == IR_PUSH)         { return "PUSH"; }
    if (op == IR_POP_RAX)      { return "POP_A"; }
    if (op == IR_POP_RCX)      { return "POP_C"; }
    if (op == IR_MOV_CA)       { return "MOV_CA"; }
    if (op == IR_LOAD8)        { return "LD8"; }
    if (op == IR_LOAD16)       { return "LD16"; }
    if (op == IR_LOAD32)       { return "LD32"; }
    if (op == IR_LOAD64)       { return "LD64"; }
    if (op == IR_STORE8)       { return "ST8"; }
    if (op == IR_STORE16)      { return "ST16"; }
    if (op == IR_STORE32)      { return "ST32"; }
    if (op == IR_STORE64)      { return "ST64"; }
    if (op == IR_CMP)          { return "CMP"; }
    if (op == IR_SETCC)        { return "SETCC"; }
    if (op == IR_TEST_AZ)      { return "TEST"; }
    if (op == IR_CALL)         { return "CALL"; }
    if (op == IR_CALL_POPS)    { return "CPOPS"; }
    if (op == IR_CALL_CLEAN)   { return "CCLEN"; }
    if (op == IR_SYSCALL)      { return "SYSC"; }
    if (op == IR_CALL_INDIRECT) { return "CIND"; }
    if (op == IR_PROLOGUE)     { return "PROLOG"; }
    if (op == IR_EPILOGUE)     { return "EPILOG"; }
    if (op == IR_MOV_RDX_RAX)  { return "MVDXA"; }
    if (op == IR_MOV_RAX_RDX)  { return "MVAXD"; }
    if (op == IR_MOV_R3_RAX)   { return "MVR3A"; }
    if (op == IR_MOV_RAX_R3)   { return "MVAR3"; }
    if (op == IR_XOR_AA)       { return "XOR_AA"; }
    if (op == IR_JMP)          { return "JMP"; }
    if (op == IR_JCC)          { return "JCC"; }
    if (op == IR_JMP_BACK)     { return "JMPB"; }
    if (op == IR_RET)          { return "RET"; }
    if (op == IR_LOAD_ADDR_L)  { return "ADDR_L"; }
    if (op == IR_RAW_EMIT)     { return "RAW_EM"; }
    if (op == IR_RAX_CLOBBER)  { return "CLBRA"; }
    if (op == IR_ELIMINATED)   { return "ELIM"; }
    return "???";
}

# ================================================================
# LASE — Load After Store Elimination
# ================================================================
# Scan each BB. Track which local index is "live in rax" (just stored).
# If we see LOAD_LOCAL for the same index without intervening clobber,
# the load is redundant. Mark it as NOP.
#
# Clobber set: anything that writes rax — PUSH, POP_RAX, MOV_CA,
# ADD, SUB, MUL, LOAD_IMM, LOAD_GLOBAL, LOAD8-64, SETCC, CALL, SYSCALL,
# XOR_AA, MOV_RAX_RDX, LOAD_ADDR_G, LOAD_STR, and any terminator.
#
# Returns: number of loads eliminated.

fn _ir_clobbers_rax(op): i64 {
    if (op == IR_LOAD_IMM)     { return 1; }
    if (op == IR_LOAD_LOCAL)   { return 1; }
    if (op == IR_LOAD_GLOBAL)  { return 1; }
    if (op == IR_LOAD_ADDR_G)  { return 1; }
    if (op == IR_LOAD_ADDR_L)  { return 1; }
    if (op == IR_LOAD_STR)     { return 1; }
    if (op == IR_ADD)          { return 1; }
    if (op == IR_SUB)          { return 1; }
    if (op == IR_MUL)          { return 1; }
    if (op == IR_AND)          { return 1; }
    if (op == IR_OR)           { return 1; }
    if (op == IR_XOR)          { return 1; }
    if (op == IR_NOT)          { return 1; }
    if (op == IR_SHL)          { return 1; }
    if (op == IR_SHR)          { return 1; }
    if (op == IR_ASHR)          { return 1; }
    if (op == IR_POP_RAX)      { return 1; }
    if (op == IR_LOAD8)        { return 1; }
    if (op == IR_LOAD16)       { return 1; }
    if (op == IR_LOAD32)       { return 1; }
    if (op == IR_LOAD64)       { return 1; }
    if (op == IR_SETCC)        { return 1; }
    if (op == IR_XOR_AA)       { return 1; }
    if (op == IR_MOV_RAX_RDX)  { return 1; }
    if (op == IR_MOV_RAX_R3)   { return 1; }   # v6.5.21 — writes rax, like its 92 peer
    if (op == IR_CALL)         { return 1; }
    if (op == IR_CALL_KNOWN)   { return 1; }
    if (op == IR_CALL_INDIRECT) { return 1; }
    if (op == IR_SYSCALL)      { return 1; }
    # v5.6.12: conservative — parse raw emits can clobber anything,
    # including rax. Stops LASE's last_store tracking at the boundary.
    if (op == IR_RAW_EMIT)     { return 1; }
    # v5.6.14: emit fns without their own IR opcode (EMULH, EIDIV,
    # ELODC) record this marker so LASE correctly resets last_store.
    if (op == IR_RAX_CLOBBER)  { return 1; }
    return 0;
}

fn ir_lase(S): i64 {
    var eliminated = 0;
    var bcnt = IR_BCNT(S);
    var bi = 0;
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        # Track: last_store_idx = local index that was just stored (-1 = none)
        var last_store_idx = 0 - 1;

        var ni = first;
        while (ni < first + count) {
            var op = IR_NODE_OP(S, ni);
            var a1 = IR_NODE_A1(S, ni);

            if (op == IR_STORE_LOCAL) {
                last_store_idx = a1;
            } elif (op == IR_LOAD_LOCAL) {
                if (a1 == last_store_idx) {
                    # Redundant load — value still in rax from the store
                    _ir_set_node(S, ni, _ir_pack_op(IR_ELIMINATED, 0), a1, 0);
                    eliminated = eliminated + 1;
                } else {
                    # Loading a different local — clobbers rax
                    last_store_idx = 0 - 1;
                }
            } elif (op == IR_PUSH || op == IR_MOV_CA) {
                # PUSH/MOV_CA read rax but don't clobber it — keep tracking
            } elif (_ir_clobbers_rax(op) == 1) {
                last_store_idx = 0 - 1;
            }

            ni = ni + 1;
        }
        bi = bi + 1;
    }
    return eliminated;
}

# Apply LASE: NOP-fill codebuf bytes for eliminated nodes.
# Must run after ir_lase() and before FIXUP.
# Returns bytes eliminated.
fn ir_apply_lase(S): i64 {
    var ncnt = IR_NCNT(S);
    var bytes = 0;
    var ni = 0;
    while (ni < ncnt) {
        var op = IR_NODE_OP(S, ni);
        if (op == IR_ELIMINATED) {
            var cp_start = IR_NODE_CP(S, ni);
            # Find the next node's CP to determine the byte range
            var cp_end = cp_start;
            if (ni + 1 < ncnt) {
                cp_end = IR_NODE_CP(S, ni + 1);
            }
            var sz = cp_end - cp_start;
            # Only NOP-fill if there's actual code to eliminate
            # (landing-pad NOPs have sz==0 since they don't emit x86)
            if (sz > 0 && sz < 16) {
                var j = 0;
                while (j < sz) {
                    store8(_codebuf_base + cp_start + j, 0x90);
                    j = j + 1;
                }
                bytes = bytes + sz;
            }
        }
        ni = ni + 1;
    }
    return bytes;
}

# ================================================================
# v5.6.16 — IR constant folding
# ================================================================
# Forward state-machine sweep matching:
#   LOAD_IMM(a), PUSH, LOAD_IMM(b), [POP_RCX | MOV_CA + POP_RAX], OP
# When matched, computes fold_val = a OP b, rewrites codebuf with
# EMOVI(fold_val) at the start of the LHS LOAD_IMM and NOP-fills the
# rest of the span. Marks consumed IR nodes as IR_NOP.
#
# v5.6.10 collapsed the commutative shuttle to `POP_RCX, OP`; SUB / SHL /
# SHR / non-commutative ops still emit `MOV_CA, POP_RAX, OP`. Both shapes
# matched.
#
# Foldable ops: ADD/SUB/MUL/AND/OR/XOR/SHL/SHR. DIV/MOD skipped — divide
# by zero would need a panic path mid-fold.

fn _ir_is_foldable_binop(op): i64 {
    if (op == IR_ADD) { return 1; }
    if (op == IR_SUB) { return 1; }
    if (op == IR_MUL) { return 1; }
    if (op == IR_AND) { return 1; }
    if (op == IR_OR)  { return 1; }
    if (op == IR_XOR) { return 1; }
    if (op == IR_SHL) { return 1; }
    if (op == IR_SHR) { return 1; }
    if (op == IR_ASHR) { return 1; }
    return 0;
}

fn _ir_compute_fold(op, a, b): i64 {
    if (op == IR_ADD) { return a + b; }
    if (op == IR_SUB) { return a - b; }
    if (op == IR_MUL) { return a * b; }
    if (op == IR_AND) { return a & b; }
    if (op == IR_OR)  { return a | b; }
    if (op == IR_XOR) { return a ^ b; }
    if (op == IR_SHL) { return a << b; }
    if (op == IR_SHR) { return a >> b; }
    if (op == IR_ASHR) { if (b == 0) { return a; } if (a >= 0) { return a >> b; } return 0 - (((0 - a) + (1 << b) - 1) >> b); }
    return 0;
}

# EMOVI byte-size for a given immediate value. Mirrors EMOVI in
# src/backend/x86/emit.cyr: 2 bytes for zero, 5 bytes for u31 (0..2^31-1),
# 10 bytes for everything else.
fn _ir_emovi_size(v): i64 {
    if (v == 0) { return 2; }
    if (v > 0) { if (v < 0x80000000) { return 5; } }
    return 10;
}

# Write EMOVI(v) into codebuf at absolute offset `off`, then NOP-fill
# from off+emovi_size up to off+span. Returns bytes saved (span -
# emovi_size). Caller must ensure span >= emovi_size.
fn _ir_write_emovi_at(S, off, v, span): i64 {
    var sz = _ir_emovi_size(v);
    var base = _codebuf_base + off;
    if (v == 0) {
        # xor eax, eax (31 C0)
        store8(base, 0x31);
        store8(base + 1, 0xC0);
    } elif (v > 0 && v < 0x80000000) {
        # mov eax, imm32 (B8 imm32)
        store8(base, 0xB8);
        store8(base + 1, v & 0xFF);
        store8(base + 2, (v >> 8) & 0xFF);
        store8(base + 3, (v >> 16) & 0xFF);
        store8(base + 4, (v >> 24) & 0xFF);
    } else {
        # movabs rax, imm64 (48 B8 imm64)
        store8(base, 0x48);
        store8(base + 1, 0xB8);
        var k = 0;
        while (k < 8) {
            store8(base + 2 + k, (v >> (k * 8)) & 0xFF);
            k = k + 1;
        }
    }
    var j = sz;
    while (j < span) {
        store8(base + j, 0x90);
        j = j + 1;
    }
    return span - sz;
}

# Constant-fold pass. Returns (folds_count << 32) | bytes_saved.
fn ir_const_fold(S): i64 {
    var ncnt = IR_NCNT(S);
    var ccnt = GCP(S);
    var folds = 0;
    var bytes = 0;

    # State machine markers (-1 = empty)
    var st = 0;             # 0=INIT 1=SAW_A 2=SAW_PUSH 3=SAW_B 4=SAW_MOVCA 5=POP_RCX 6=POP_RAX
    var ni_a   = 0 - 1;
    var val_a  = 0;
    var ni_pu  = 0 - 1;
    var ni_b   = 0 - 1;
    var val_b  = 0;
    var ni_mv  = 0 - 1;
    var ni_po  = 0 - 1;

    var ni = 0;
    while (ni < ncnt) {
        var op = IR_NODE_OP(S, ni);

        if (op == IR_NOP || op == IR_ELIMINATED) {
            # Skip — these are no-ops that don't break the pattern.
            ni = ni + 1;
            continue;
        }

        if (op == IR_LOAD_IMM) {
            if (st == 2) {
                # AFTER_PUSH → second LOAD_IMM
                ni_b = ni;
                val_b = IR_NODE_A2(S, ni);
                st = 3;
            } else {
                # Restart pattern. The current LOAD_IMM may be the LHS of
                # a future fold.
                ni_a = ni;
                val_a = IR_NODE_A2(S, ni);
                ni_pu = 0 - 1; ni_b = 0 - 1; ni_mv = 0 - 1; ni_po = 0 - 1;
                st = 1;
            }
        } elif (op == IR_PUSH) {
            if (st == 1) { ni_pu = ni; st = 2; }
            else { st = 0; }
        } elif (op == IR_POP_RCX) {
            if (st == 3) { ni_po = ni; st = 5; }
            else { st = 0; }
        } elif (op == IR_MOV_CA) {
            if (st == 3) { ni_mv = ni; st = 4; }
            else { st = 0; }
        } elif (op == IR_POP_RAX) {
            if (st == 4) { ni_po = ni; st = 6; }
            else { st = 0; }
        } elif (_ir_is_foldable_binop(op) == 1) {
            var ok = 0;
            if (st == 5) { ok = 1; }   # commutative shuttle elim path
            if (st == 6) { ok = 1; }   # non-commutative shuttle path
            if (ok == 1) {
                var lhs = val_a;
                var rhs = val_b;
                # In AFTER_POP_RCX (commutative ops only — ADD/AND/OR/XOR/MUL),
                # the shuttle elim swapped operand order: rax holds the second
                # LOAD_IMM (val_b), rcx holds the first via pop. For a
                # commutative op the result is the same either way, so we can
                # just compute val_a OP val_b.
                var fv = _ir_compute_fold(op, lhs, rhs);
                var cp_a = IR_NODE_CP(S, ni_a);
                var cp_end = ccnt;
                if (ni + 1 < ncnt) { cp_end = IR_NODE_CP(S, ni + 1); }
                var span = cp_end - cp_a;
                var need = _ir_emovi_size(fv);
                if (span >= need && span < 64) {
                    var saved = _ir_write_emovi_at(S, cp_a, fv, span);
                    # Mark consumed IR nodes as IR_NOP. The bytes are
                    # already committed; this just keeps IR consistent.
                    _ir_set_node(S, ni_a, _ir_pack_op(IR_NOP, 0), 0, fv);
                    _ir_set_node(S, ni_pu, _ir_pack_op(IR_NOP, 0), 0, 0);
                    _ir_set_node(S, ni_b, _ir_pack_op(IR_NOP, 0), 0, 0);
                    if (ni_mv >= 0) {
                        _ir_set_node(S, ni_mv, _ir_pack_op(IR_NOP, 0), 0, 0);
                    }
                    _ir_set_node(S, ni_po, _ir_pack_op(IR_NOP, 0), 0, 0);
                    _ir_set_node(S, ni, _ir_pack_op(IR_NOP, 0), 0, 0);
                    folds = folds + 1;
                    bytes = bytes + saved;
                }
            }
            st = 0;
        } else {
            # Anything else breaks the pattern.
            st = 0;
        }

        ni = ni + 1;
    }

    return (folds << 32) | (bytes & 0xFFFFFFFF);
}

# ================================================================
# v5.6.16 — Bitmap liveness + DCE
# ================================================================
# Per-BB backward sweep with a u64 liveness bitmap. Bit 0 = RAX,
# bit 1 = RCX. Future regalloc (v5.6.18) can claim more bits.
#
# A side-effect-free def whose target reg isn't live at this point
# is dead — mark IR_ELIMINATED so ir_apply_lase NOP-fills it.
#
# Conservative: at BB exit (entry of backward sweep), assume both
# RAX and RCX live (they may flow to a successor BB).
#
# Side-effect-free defs (DCE candidates):
#   IR_LOAD_IMM, IR_LOAD_LOCAL, IR_LOAD_GLOBAL,
#   IR_LOAD_ADDR_L, IR_LOAD_ADDR_G, IR_LOAD_STR, IR_XOR_AA,
#   IR_MOV_CA (writes RCX), IR_SETCC
# Anything with side effects (PUSH/POP/STORE/CALL/SYSCALL/RAW_EMIT)
# is never dead.

# Returns 1 if op writes RAX without side effects, 0 otherwise.
fn _ir_def_rax_pure(op): i64 {
    if (op == IR_LOAD_IMM)     { return 1; }
    if (op == IR_LOAD_LOCAL)   { return 1; }
    if (op == IR_LOAD_GLOBAL)  { return 1; }
    if (op == IR_LOAD_ADDR_L)  { return 1; }
    if (op == IR_LOAD_ADDR_G)  { return 1; }
    if (op == IR_LOAD_STR)     { return 1; }
    if (op == IR_XOR_AA)       { return 1; }
    if (op == IR_SETCC)        { return 1; }
    return 0;
}

# Returns 1 if op writes RCX without side effects.
fn _ir_def_rcx_pure(op): i64 {
    if (op == IR_MOV_CA) { return 1; }
    return 0;
}

# Returns 1 if op reads RAX (so RAX must be live before this node).
fn _ir_uses_rax(op): i64 {
    if (op == IR_PUSH)         { return 1; }
    if (op == IR_MOV_CA)       { return 1; }
    if (op == IR_STORE_LOCAL)  { return 1; }
    if (op == IR_STORE_GLOBAL) { return 1; }
    if (op == IR_STORE8)       { return 1; }
    if (op == IR_STORE16)      { return 1; }
    if (op == IR_STORE32)      { return 1; }
    if (op == IR_STORE64)      { return 1; }
    if (op == IR_ADD)          { return 1; }
    if (op == IR_SUB)          { return 1; }
    if (op == IR_MUL)          { return 1; }
    if (op == IR_DIV)          { return 1; }
    if (op == IR_MOD)          { return 1; }
    if (op == IR_AND)          { return 1; }
    if (op == IR_OR)           { return 1; }
    if (op == IR_XOR)          { return 1; }
    if (op == IR_SHL)          { return 1; }
    if (op == IR_SHR)          { return 1; }
    if (op == IR_ASHR)          { return 1; }
    if (op == IR_NOT)          { return 1; }
    if (op == IR_NEG)          { return 1; }
    if (op == IR_CMP)          { return 1; }
    if (op == IR_TEST_AZ)      { return 1; }
    if (op == IR_LOAD8)        { return 1; }
    if (op == IR_LOAD16)       { return 1; }
    if (op == IR_LOAD32)       { return 1; }
    if (op == IR_LOAD64)       { return 1; }
    if (op == IR_MOV_RDX_RAX)  { return 1; }
    if (op == IR_MOV_R3_RAX)   { return 1; }   # v6.5.21 — reads rax, like its 91 peer
    # SYSCALL reads RAX (sc_num); CALL/TAIL_JMP/RET implicitly read RAX
    # (return value flows via rax). RAW_EMIT / RAX_CLOBBER are opaque —
    # treat conservatively as readers so DCE can't kill a preceding def
    # whose value the raw emit might consume.
    if (op == IR_SYSCALL)      { return 1; }
    if (op == IR_CALL)         { return 1; }
    if (op == IR_CALL_KNOWN)   { return 1; }
    if (op == IR_CALL_INDIRECT) { return 1; }
    if (op == IR_TAIL_JMP)     { return 1; }
    if (op == IR_RET)          { return 1; }
    if (op == IR_EPILOGUE)     { return 1; }
    if (op == IR_RAW_EMIT)     { return 1; }
    if (op == IR_RAX_CLOBBER)  { return 1; }
    return 0;
}

# Returns 1 if op reads RCX.
# v5.6.17 fix: IR_RAX_CLOBBER (EMULH/EIDIV/ELODC) all read RCX (mulh
# multiplies rax × rcx; idiv divides by rcx; elodc loads from [rcx]).
# IR_ADD_IMM_X1 reads rcx (rcx += imm). IR_RAW_EMIT is opaque —
# conservative: treat as RCX reader.
fn _ir_uses_rcx(op): i64 {
    if (op == IR_ADD)          { return 1; }
    if (op == IR_SUB)          { return 1; }
    if (op == IR_MUL)          { return 1; }
    if (op == IR_AND)          { return 1; }
    if (op == IR_OR)           { return 1; }
    if (op == IR_XOR)          { return 1; }
    if (op == IR_SHL)          { return 1; }
    if (op == IR_SHR)          { return 1; }
    if (op == IR_ASHR)          { return 1; }
    if (op == IR_CMP)          { return 1; }
    if (op == IR_STORE8)       { return 1; }
    if (op == IR_STORE16)      { return 1; }
    if (op == IR_STORE32)      { return 1; }
    if (op == IR_STORE64)      { return 1; }
    if (op == IR_RAX_CLOBBER)  { return 1; }
    if (op == IR_ADD_IMM_X1)   { return 1; }
    if (op == IR_RAW_EMIT)     { return 1; }
    return 0;
}

# Returns 1 if op writes RCX (pure or otherwise — for liveness kill).
# Calls / syscalls / call_pops are caller-saves; they clobber RCX.
# v5.6.17 fix: IR_RAX_CLOBBER (EMULH/EIDIV/ELODC) does NOT write RCX —
# it only reads it. Removed from this list; added to _ir_uses_rcx.
fn _ir_def_rcx_any(op): i64 {
    if (op == IR_MOV_CA)       { return 1; }
    if (op == IR_LOAD_ADDR_G_X1) { return 1; }   # v6.3.28: EVADDR_X1 `movabs $imm,%rcx`
    if (op == IR_POP_RCX)      { return 1; }
    if (op == IR_CALL)         { return 1; }
    if (op == IR_CALL_KNOWN)   { return 1; }
    if (op == IR_CALL_INDIRECT) { return 1; }
    if (op == IR_CALL_POPS)    { return 1; }
    if (op == IR_CALL_CLEAN)   { return 1; }
    if (op == IR_TAIL_JMP)     { return 1; }
    if (op == IR_SYSCALL)      { return 1; }
    if (op == IR_ADD_IMM_X1)   { return 1; }
    # IR_RAX_CLOBBER intentionally NOT here — it doesn't write RCX.
    if (op == IR_RAW_EMIT)     { return 1; }
    return 0;
}

# Standard liveness DCE. live_in = (live_out - all_defs) | all_uses.
# A pure def whose target reg isn't in live_out is dead.
#
# v5.6.17 bisection: `cap` limits how many nodes get killed; pass -1 for
# uncapped. Used to find the first wrongly-killed node by binary search.
fn ir_dce_capped(S, cap): i64 {
    var bcnt = IR_BCNT(S);
    var killed = 0;
    var bi = 0;
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        # Conservative: both RAX and RCX live at BB exit.
        var live = 3;
        var k = count;
        while (k > 0) {
            k = k - 1;
            var ni = first + k;
            var op = IR_NODE_OP(S, ni);

            if (op == IR_NOP || op == IR_ELIMINATED) { continue; }

            var dead = 0;
            if (_ir_def_rax_pure(op) == 1) {
                if ((live & 1) == 0) { dead = 1; }
            } elif (_ir_def_rcx_pure(op) == 1) {
                if ((live & 2) == 0) { dead = 1; }
            }

            # Bisection cap: only kill the first `cap` candidates.
            if (cap >= 0) { if (killed >= cap) { dead = 0; } }

            if (dead == 1) {
                _ir_set_node(S, ni, _ir_pack_op(IR_ELIMINATED, 0), 0, 0);
                killed = killed + 1;
                # Killed nodes don't affect liveness — neither def nor use.
                continue;
            }

            # live_in = (live_out - all_defs) | all_uses
            if (_ir_clobbers_rax(op) == 1) { live = live & 0xFFFFFFFFFFFFFFFE; }
            if (_ir_def_rcx_any(op) == 1)  { live = live & 0xFFFFFFFFFFFFFFFD; }
            if (_ir_uses_rax(op) == 1)     { live = live | 1; }
            if (_ir_uses_rcx(op) == 1)     { live = live | 2; }
        }
        bi = bi + 1;
    }
    return killed;
}

fn ir_dce(S): i64 { return ir_dce_capped(S, 0 - 1); }

# ================================================================
# v6.3.27 — cross-BB liveness (CFG backward dataflow fixpoint)
# ================================================================
# The per-BB DCE above seeds each BB's exit conservatively (live = 3, both
# RAX/RCX). This computes the PRECISE per-BB live-out as the union of the
# successors' live-in, iterated to a fixpoint over the CFG (succ0/succ1 from
# ir_build_edges). Pure ANALYSIS — it writes only the ir_live_in/ir_live_out
# arrays (v6.3.27 heap region) and never mutates codegen; it runs only on the
# CYRIUS_IR path, so the default emit path is untouched. It is the reusable
# substrate the v6.3.28 copy-prop + v6.3.29 cross-BB DSE consume. The register
# allocation/rewrite that would CONSUME this liveness is deferred to a later slot
# (the in-place-patch emit model can't grow a `push`→`mov reg` instruction; see
# docs/development/issues/2026-07-02-ir-regalloc-rewrite-needs-reemit.md).
#
# cybs note (feedback_seed_derive_mandatory_cybs_limits): kept as several small
# helpers chained by regular (non-tail) calls so no single fn trips the bootstrap
# compiler's ref-density / tail-call limits. seed-derive after this bite.

# Backward per-node transfer for ONE BB: returns live_in given live_out.
# Same reg-effect model as ir_dce_capped's inner loop (lines 977-980), WITHOUT
# the DCE kill — seeded with the real live_out instead of the conservative 3.
fn _ir_bb_transfer(S, bi, live_out): i64 {
    var first = IR_BB_FIRST(S, bi);
    var count = IR_BB_COUNT(S, bi);
    var live = live_out;
    var k = count;
    while (k > 0) {
        k = k - 1;
        var ni = first + k;
        var op = IR_NODE_OP(S, ni);
        if (op == IR_NOP) { continue; }
        if (op == IR_ELIMINATED) { continue; }
        if (_ir_clobbers_rax(op) == 1) { live = live & 0xFFFFFFFFFFFFFFFE; }
        if (_ir_def_rcx_any(op) == 1)  { live = live & 0xFFFFFFFFFFFFFFFD; }
        if (_ir_uses_rax(op) == 1)     { live = live | 1; }
        if (_ir_uses_rcx(op) == 1)     { live = live | 2; }
    }
    return live;
}

# live_in of one successor, or 0 if the successor slot is empty (-1 reads as
# 0xFFFFFFFF after the SUCC accessor mask; a real BB id is always < bcnt).
fn _ir_succ_livein(S, s, bcnt): i64 {
    if (s < bcnt) { return IR_LIVEIN(S, s); }
    return 0;
}

# Union of a BB's successors' live-in (0/1/2 successors: JMP/fall = succ0 only,
# JCC = succ0+succ1, RET/EPILOGUE = neither → 0).
fn _ir_succ_union(S, bi, bcnt): i64 {
    var s0 = IR_BB_SUCC0(S, bi);
    var s1 = IR_BB_SUCC1(S, bi);
    var u0 = _ir_succ_livein(S, s0, bcnt);
    var u1 = _ir_succ_livein(S, s1, bcnt);
    return u0 | u1;
}

# Conservative bail: everything live everywhere (never frees a reg). Only reached
# if the monotone fixpoint fails to converge within the cap — a 7-bit lattice
# over ≤32768 BBs converges in a handful of passes, so this must never fire on
# real IR; if it does, it's a bug to investigate, not a correctness hole.
fn _ir_liveness_bail(S, bcnt): i64 {
    var bi = 0;
    while (bi < bcnt) {
        IR_SLIVEIN(S, bi, 0 - 1);
        IR_SLIVEOUT(S, bi, 0 - 1);
        bi = bi + 1;
    }
    return 0;
}

# Compute cross-BB liveness to a fixpoint. Returns the iteration count (the gate
# test asserts convergence < the cap). Call AFTER ir_build_bbs + ir_build_edges.
fn ir_liveness_cfg(S): i64 {
    var bcnt = IR_BCNT(S);
    var bi = 0;
    while (bi < bcnt) {
        IR_SLIVEIN(S, bi, 0);
        IR_SLIVEOUT(S, bi, 0);
        bi = bi + 1;
    }
    var iters = 0;
    var changed = 1;
    while (changed == 1) {
        changed = 0;
        var b = bcnt;
        while (b > 0) {
            b = b - 1;
            var out = _ir_succ_union(S, b, bcnt);
            IR_SLIVEOUT(S, b, out);
            var lin = _ir_bb_transfer(S, b, out);
            if (lin != IR_LIVEIN(S, b)) {
                IR_SLIVEIN(S, b, lin);
                changed = 1;
            }
        }
        iters = iters + 1;
        if (iters >= 64) { changed = 0; }
    }
    if (iters >= 64) { _ir_liveness_bail(S, bcnt); }
    return iters;
}

# Count BBs whose live_out is empty — i.e. exit/return blocks nothing flows past.
# Observable proof the fixpoint is more precise than the DCE's conservative
# "always 3" seed (a RET/EPILOGUE BB gets live_out==0). Used by the gate test.
fn ir_count_exit_bbs(S): i64 {
    var bcnt = IR_BCNT(S);
    var n = 0;
    var bi = 0;
    while (bi < bcnt) {
        if (IR_LIVEOUT(S, bi) == 0) { n = n + 1; }
        bi = bi + 1;
    }
    return n;
}

# ================================================================
# v6.3.27 — spill-interval detection (analysis-only)
# ================================================================
# A value computed in RAX is spilled to the stack via IR_PUSH and later reloaded
# via IR_POP_RAX / IR_POP_RCX — the classic stack round-trip of the binop shuttle
# (LOAD_IMM a; PUSH; LOAD_IMM b; POP_RCX; OP). A future register allocator could
# keep that value in a free callee-saved reg (rbx/r12-r15) across the interval,
# eliminating the memory traffic. This pass COUNTS the promotable intervals; it
# does NOT allocate or rewrite — the rewrite needs the IR re-emit path (the
# in-place-patch emit model can't grow `push`(1B)→`mov reg`(3B)); deferred to a
# later slot (see docs/development/issues/2026-07-02-ir-regalloc-rewrite-needs-reemit.md).

# Ops that break the clean-span guarantee: they may touch [rsp] (RAW/inline-asm),
# consume stack args (CALL_POPS/CALL_CLEAN), transfer control (SWITCH/TAIL_JMP),
# or clobber regs opaquely (SYSCALL/CALL*/RAX_CLOBBER). Seeing one abandons the
# open-push stack, so any matched PUSH..POP is guaranteed opaque-op-free.
fn _ir_op_opaque_stack(op): i64 {
    if (op == IR_CALL)          { return 1; }
    if (op == IR_CALL_KNOWN)    { return 1; }
    if (op == IR_CALL_POPS)     { return 1; }
    if (op == IR_CALL_CLEAN)    { return 1; }
    if (op == IR_CALL_INDIRECT) { return 1; }
    if (op == IR_TAIL_JMP)      { return 1; }
    if (op == IR_SYSCALL)       { return 1; }
    if (op == IR_SWITCH)        { return 1; }
    if (op == IR_RAW_BYTE)      { return 1; }
    if (op == IR_RAW_EMIT)      { return 1; }
    if (op == IR_RAX_CLOBBER)   { return 1; }
    return 0;
}

# Count clean, INTRA-BB PUSH..POP spill intervals (the future allocation targets).
# Depth counter per BB: PUSH deepens, POP_RAX/POP_RCX matches (one promotable
# interval), any opaque op resets the stack. Cross-BB spills are excluded (depth
# resets at each BB boundary). Analysis-only: returns the count, records nothing
# (the node list isn't needed until allocation, which is deferred).
fn _ir_find_spill_intervals(S): i64 {
    var bcnt = IR_BCNT(S);
    var promotable = 0;
    var bi = 0;
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        var depth = 0;
        var k = 0;
        while (k < count) {
            var op = IR_NODE_OP(S, first + k);
            if (op == IR_PUSH) { depth = depth + 1; }
            elif (op == IR_POP_RAX) {
                if (depth > 0) { depth = depth - 1; promotable = promotable + 1; }
            }
            elif (op == IR_POP_RCX) {
                if (depth > 0) { depth = depth - 1; promotable = promotable + 1; }
            }
            elif (_ir_op_opaque_stack(op) == 1) { depth = 0; }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return promotable;
}

# ================================================================
# v5.6.18 — Dead-store elimination
# ================================================================
# Per-BB forward sweep: for each STORE_LOCAL(x), scan forward in the
# same BB. If we find another STORE_LOCAL(x) before any LOAD of x or
# any opaque op (CALL/SYSCALL/RAW_EMIT — could read via &local), the
# first store is dead.
#
# Conservative bail set:
#   - IR_LOAD_ADDR_L of same lidx anywhere: pointer might survive,
#     opaque ops downstream could deref it
#   - IR_CALL / IR_CALL_KNOWN / IR_SYSCALL / IR_RAW_EMIT / IR_TAIL_JMP:
#     opaque w.r.t. memory; may read any local
#   - IR_LOAD_LOCAL(same lidx): use found before re-store
#
# Returns kill count. CYRIUS_DSE_CAP=N caps kills for bisection.

fn ir_dead_store_capped(S, cap): i64 {
    var bcnt = IR_BCNT(S);
    var killed = 0;
    var bi = 0;
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        var k = 0;
        while (k < count) {
            if (cap >= 0) { if (killed >= cap) { k = count; continue; } }
            var ni = first + k;
            var op = IR_NODE_OP(S, ni);
            if (op == IR_STORE_LOCAL) {
                var lidx = IR_NODE_A1(S, ni);
                var dead = 0;
                var j = k + 1;
                while (j < count) {
                    var nj = first + j;
                    var oj = IR_NODE_OP(S, nj);
                    var aj = IR_NODE_A1(S, nj);
                    if (oj == IR_NOP) { j = j + 1; continue; }
                    if (oj == IR_ELIMINATED) { j = j + 1; continue; }
                    # Opaque memory-touching ops bail conservatively
                    if (oj == IR_CALL) { j = count; }
                    elif (oj == IR_CALL_KNOWN) { j = count; }
                    elif (oj == IR_SYSCALL) { j = count; }
                    elif (oj == IR_RAW_EMIT) { j = count; }
                    elif (oj == IR_TAIL_JMP) { j = count; }
                    elif (oj == IR_LOAD_ADDR_L && aj == lidx) { j = count; }
                    elif (oj == IR_LOAD_LOCAL && aj == lidx) {
                        # Use found before re-store; not dead.
                        j = count;
                    }
                    elif (oj == IR_STORE_LOCAL && aj == lidx) {
                        dead = 1;
                        j = count;
                    }
                    else { j = j + 1; }
                }
                if (dead == 1) {
                    _ir_set_node(S, ni, _ir_pack_op(IR_ELIMINATED, 0), 0, 0);
                    killed = killed + 1;
                }
            }
            k = k + 1;
        }
        bi = bi + 1;
    }
    return killed;
}

fn ir_dead_store(S): i64 { return ir_dead_store_capped(S, 0 - 1); }

# ================================================================
# BB construction pass
# ================================================================
# Walk the recorded IR nodes and split them into basic blocks.
# BB boundaries at: PROLOG, EPILOG, JMP, JCC, JMP_BACK, NOP (landing pads)
# Call after compilation, before optimization.

fn ir_build_bbs(S): i64 {
    var ncnt = IR_NCNT(S);
    if (ncnt == 0) { return 0; }

    IR_SBCNT(S, 0);
    IR_SECNT(S, 0);

    # First BB starts at node 0
    var cur_bb = ir_bb_new(S);
    ir_set_bb(S, cur_bb);

    var i = 0;
    while (i < ncnt) {
        var op = IR_NODE_OP(S, i);

        # Terminators end the current BB and start a new one
        if (op == IR_JMP || op == IR_JCC || op == IR_JMP_BACK || op == IR_EPILOGUE || op == IR_RET) {
            # This node belongs to current BB — update count
            var base = S + 0xB3A000 + cur_bb * 32;
            store64(base + 16, i - IR_BB_FIRST(S, cur_bb) + 1);

            # Start new BB at next node
            if (i + 1 < ncnt) {
                cur_bb = ir_bb_new(S);
                ir_set_bb(S, cur_bb);
                # Set first_node for the new BB
                store64(S + 0xB3A000 + cur_bb * 32 + 8, i + 1);
            }
        }
        # NOP with patch offset = landing pad → always starts a new BB
        # This ensures every EPATCH target gets its own BB for edge matching.
        elif (op == IR_NOP && i > 0 && IR_NODE_A1(S, i) != 0) {
            var cur_first = IR_BB_FIRST(S, cur_bb);
            if (i > cur_first) {
                var base = S + 0xB3A000 + cur_bb * 32;
                store64(base + 16, i - cur_first);
                cur_bb = ir_bb_new(S);
                ir_set_bb(S, cur_bb);
                store64(S + 0xB3A000 + cur_bb * 32 + 8, i);
            }
        }
        # PROLOG starts a new BB (function entry)
        elif (op == IR_PROLOGUE && i > 0) {
            var base = S + 0xB3A000 + cur_bb * 32;
            store64(base + 16, i - IR_BB_FIRST(S, cur_bb));
            cur_bb = ir_bb_new(S);
            ir_set_bb(S, cur_bb);
            store64(S + 0xB3A000 + cur_bb * 32 + 8, i);
        }

        i = i + 1;
    }

    # Finalize last BB's node count
    if (IR_BCNT(S) > 0) {
        var last = IR_BCNT(S) - 1;
        var base = S + 0xB3A000 + last * 32;
        var first = load64(base + 8);
        store64(base + 16, ncnt - first);
    }

    return IR_BCNT(S);
}

# ================================================================
# CFG edge builder
# ================================================================
# After BBs are constructed, walk each BB's terminator node and
# connect to successor BBs. Uses CP tracking to match jump targets.
# Returns number of edges added.

# Find which BB contains the given codebuf offset (binary search)
fn _ir_find_bb_for_cp(S, target_cp): i64 {
    var bcnt = IR_BCNT(S);
    # Linear scan (good enough for <32K BBs)
    var bi = 0;
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        if (count > 0) {
            var bb_cp_start = IR_NODE_CP(S, first);
            var bb_cp_end = bb_cp_start;
            if (first + count < IR_NCNT(S)) {
                bb_cp_end = IR_NODE_CP(S, first + count);
            } else {
                bb_cp_end = GCP(S);
            }
            if (target_cp >= bb_cp_start && target_cp < bb_cp_end) {
                return bi;
            }
        }
        bi = bi + 1;
    }
    return 0 - 1;  # not found
}

# Find the BB that contains a NOP landing pad whose arg1 matches patch_off.
# Scans all nodes (not just first) because multiple NOPs can land in one BB.
fn _ir_find_bb_for_patch(S, patch_off): i64 {
    var bcnt = IR_BCNT(S);
    var bi = 0;
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        var ni = first;
        while (ni < first + count) {
            if (IR_NODE_OP(S, ni) == IR_NOP) {
                if (IR_NODE_A1(S, ni) == patch_off) { return bi; }
            }
            ni = ni + 1;
        }
        bi = bi + 1;
    }
    return 0 - 1;
}

fn ir_build_edges(S): i64 {
    var bcnt = IR_BCNT(S);
    IR_SECNT(S, 0);
    var edges = 0;

    var bi = 0;
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        if (count > 0) {
            var last_ni = first + count - 1;
            var op = IR_NODE_OP(S, last_ni);

            if (op == IR_JMP) {
                # Forward JMP — patch offset stored in arg2
                var patch_off = IR_NODE_A2(S, last_ni);
                if (patch_off > 0) {
                    var target_bb = _ir_find_bb_for_patch(S, patch_off);
                    if (target_bb >= 0) {
                        ir_bb_set_succ(S, bi, target_bb);
                        ir_add_edge(S, bi, target_bb);
                        edges = edges + 1;
                    }
                }
            }
            elif (op == IR_JMP_BACK) {
                # Backward jump — target CP in arg2
                var target_cp = IR_NODE_A2(S, last_ni);
                var target_bb = _ir_find_bb_for_cp(S, target_cp);
                if (target_bb >= 0) {
                    ir_bb_set_succ(S, bi, target_bb);
                    ir_add_edge(S, bi, target_bb);
                    edges = edges + 1;
                }
            }
            elif (op == IR_JCC) {
                # Conditional — fall-through to next BB + jump to patch target
                # Fall-through (condition false — continues to next BB)
                if (bi + 1 < bcnt) {
                    ir_add_edge(S, bi, bi + 1);
                    edges = edges + 1;
                }
                # Jump target (condition true — resolved via patch offset)
                var patch_off = IR_NODE_A2(S, last_ni);
                if (patch_off > 0) {
                    var target_bb = _ir_find_bb_for_patch(S, patch_off);
                    if (target_bb >= 0) {
                        var fall_bb = bi;
                        if (bi + 1 < bcnt) { fall_bb = bi + 1; }
                        ir_bb_set_cond(S, bi, fall_bb, target_bb);
                        ir_add_edge(S, bi, target_bb);
                        edges = edges + 1;
                    }
                }
            }
            elif (op != IR_EPILOGUE) {
                # Fall-through to next BB
                if (bi + 1 < bcnt) {
                    ir_bb_set_succ(S, bi, bi + 1);
                    ir_add_edge(S, bi, bi + 1);
                    edges = edges + 1;
                }
            }
        }
        bi = bi + 1;
    }
    return edges;
}

# ================================================================
# Dead block elimination
# ================================================================
# Find BBs with no incoming edges and no PROLOG (entry points).
# NOP-fill their codebuf bytes.
# Returns bytes eliminated.

fn ir_dead_block_elim(S): i64 {
    var bcnt = IR_BCNT(S);
    var ecnt = IR_ECNT(S);
    var bytes = 0;

    var bi = 0;
    while (bi < bcnt) {
        var first = IR_BB_FIRST(S, bi);
        var count = IR_BB_COUNT(S, bi);
        if (count == 0) { bi = bi + 1; continue; }

        # Skip entry blocks (first BB, or BBs starting with PROLOG)
        var first_op = IR_NODE_OP(S, first);
        if (bi == 0 || first_op == IR_PROLOGUE) {
            bi = bi + 1;
            continue;
        }

        # Check if any edge targets this BB
        var has_pred = 0;
        var ei = 0;
        while (ei < ecnt) {
            if (IR_EDGE_TO(S, ei) == bi) {
                has_pred = 1;
                ei = ecnt;  # break
            }
            ei = ei + 1;
        }

        # Extra safety: only eliminate if ALL nodes in the BB are NOP/ELIMINATED
        # (avoid killing BBs with real code that just have missing edges)
        var all_nop = 1;
        if (has_pred == 0) {
            var ci = first;
            while (ci < first + count) {
                var cop = IR_NODE_OP(S, ci);
                if (cop != IR_NOP && cop != IR_ELIMINATED) { all_nop = 0; ci = first + count; }
                ci = ci + 1;
            }
        }

        if (has_pred == 0 && all_nop == 1) {
            # Dead NOP-only block — safe to NOP-fill
            var cp_start = IR_NODE_CP(S, first);
            var cp_end = cp_start;
            if (first + count < IR_NCNT(S)) {
                cp_end = IR_NODE_CP(S, first + count);
            }
            var sz = cp_end - cp_start;
            if (sz > 0 && sz < 4096) {
                var j = 0;
                while (j < sz) {
                    store8(_codebuf_base + cp_start + j, 0x90);
                    j = j + 1;
                }
                bytes = bytes + sz;
            }
        }

        bi = bi + 1;
    }
    return bytes;
}

fn ir_dump(S): i64 {
    var ncnt = IR_NCNT(S);
    syscall(SYS_WRITE, 2, "=== IR DUMP (", 13);
    PRNUM(ncnt);
    syscall(SYS_WRITE, 2, " nodes) ===\n", 12);
    var i = 0;
    while (i < ncnt) {
        var op = IR_NODE_OP(S, i);
        var a1 = IR_NODE_A1(S, i);
        var a2 = IR_NODE_A2(S, i);
        syscall(SYS_WRITE, 2, "  ", 2);
        PRNUM(i);
        syscall(SYS_WRITE, 2, ": ", 2);
        var name = _ir_opname(op);
        PRSTR(name);
        if (a1 != 0 || a2 != 0) {
            syscall(SYS_WRITE, 2, " (", 2);
            if (a1 != 0) { PRNUM(a1); }
            if (a2 != 0) { syscall(SYS_WRITE, 2, ", ", 2); PRNUM(a2); }
            syscall(SYS_WRITE, 2, ")", 1);
        }
        syscall(SYS_WRITE, 2, "\n", 1);
        i = i + 1;
    }
    return 0;
}
