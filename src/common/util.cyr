# ================================================================
# 64-BIT MEMORY HELPERS
# ================================================================

fn S64(a, v): i64 {
    store64(a, v);
    return 0;
}

fn L64(a): i64 {
    return load64(a);
}

# ================================================================
# STATE ACCESSORS
# ================================================================

fn GBL(S): i64 { return L64(S + 0x18C100); }
fn SBL(S, v): i64 { S64(S + 0x18C100, v); return 0; }
fn GCP(S): i64 { return L64(S + 0x18C108); }
fn SCP(S, v): i64 { S64(S + 0x18C108, v); return 0; }
fn GVCNT(S): i64 { return L64(S + 0x18C110); }
# Phase 0 tail (v6.3.0): growable var-family. SEVEN parallel 8 B/slot tables —
# var_noffs (0x11A000), var_sizes (0x12A000), var_types (0x13A000), gvar_byte_off
# (0x1B0000), enum_const_val (0x1D8000), gvar_initval (0x1EC000), var_enum_id
# (0x204000) — were all FIXED, indexed by the var count, hard-capped at 8192
# (SVCNT errored). They are grown as one family: bases start AT the original
# offsets + _var_cap at 8192, so under the old cap nothing changes (byte-identical
# fixpoint); SVCNT grows the whole family 2x the moment the count would reach the
# cap, ending the last fixed compile-time cap (the var tail the v6.2.0 Phase-0
# migration left). Inited per-driver after the heap is up.
var _varn_base = 0;    # 0x11A000 var_noffs
var _vars_base = 0;    # 0x12A000 var_sizes
var _vart_base = 0;    # 0x13A000 var_types
var _vgoff_base = 0;   # 0x1B0000 gvar_byte_off
var _vecv_base = 0;    # 0x1D8000 enum_const_val
var _vgsi_base = 0;    # 0x1EC000 gvar_initval
var _venid_base = 0;   # 0x204000 var_enum_id
var _var_cap = 0;
# Grow ONE var-family table 2x: alloc a new region (2x cap slots), copy the used
# `cap` slots, return the new base. Kept tiny (3 locals) ON PURPOSE — cybs, the
# bootstrap assembler-compiler, mis-compiles fns with too many locals, which broke
# the seed chain (seed→cybs→cycc) when _var_grow inlined all 7 grows in one ~10-local
# fn: cybs produced a gen1 that segfaulted compiling main.cyr. Splitting the per-table
# work into this helper keeps every fn under cybs's local capacity. (DO NOT re-inline.)
fn _grow_one(old_base, cap): i64 {
    var nb = alloc(cap * 2 * 8);
    var bytes = cap * 8;
    var i = 0;
    while (i < bytes) { store64(nb + i, load64(old_base + i)); i = i + 8; }
    return nb;
}
# Grow the var family 2x, ONE table per function, CHAINED. cybs (the bootstrap
# assembler-compiler) mis-compiles a fn with too many global/call references — the
# seed chain (seed→cybs→cycc) segfaulted when _var_grow grew all 7 tables inline
# (verified: 1 grow/fn self-hosts, 4 grows/fn desyncs cybs and gen1 segfaults). So
# each fn grows ONE table with the CURRENT _var_cap and tail-calls the next; the
# LAST (_grow_g7) bumps _var_cap, so every grow above sees the old cap. DO NOT
# re-inline these into one fn — it re-breaks the seed. See seed-derive-cycc.sh.
fn _grow_g7(): i64 { _venid_base = _grow_one(_venid_base, _var_cap); _var_cap = _var_cap * 2; return 0; }
fn _grow_g6(): i64 { _vgsi_base = _grow_one(_vgsi_base, _var_cap); _grow_g7(); return 0; }
fn _grow_g5(): i64 { _vecv_base = _grow_one(_vecv_base, _var_cap); _grow_g6(); return 0; }
fn _grow_g4(): i64 { _vgoff_base = _grow_one(_vgoff_base, _var_cap); _grow_g5(); return 0; }
fn _grow_g3(): i64 { _vart_base = _grow_one(_vart_base, _var_cap); _grow_g4(); return 0; }
fn _grow_g2(): i64 { _vars_base = _grow_one(_vars_base, _var_cap); _grow_g3(); return 0; }
fn _grow_g1(): i64 { _varn_base = _grow_one(_varn_base, _var_cap); _grow_g2(); return 0; }
fn _var_grow(S): i64 {
    if (_var_cap * 2 > 1048576) {
        syscall(SYS_WRITE, 2, "error: variable table exceeds 1048576 entries (too many globals+enums+arrays)\n", 78);
        syscall(SYS_EXIT, 1);
    }
    _grow_g1();
    return 0;
}
fn SVCNT(S, v): i64 {
    # v6.3.0: grow the var family 2x when the count would reach the cap, instead
    # of erroring at the old fixed 8192. _var_cap==0 guards any pre-init call.
    if (_var_cap != 0 && v >= _var_cap) { _var_grow(S); }
    S64(S + 0x18C110, v);
    return 0;
}
# v5.8.22 bite #1 — per-variant → parent-enum bookkeeping for
# exhaustive-match coverage check (consumer in subsequent bite).
# var_enum_id[vcnt] is 1-based: 0 = not a variant, N = variant
# of enum at index N-1. enum_count tracks total enum decls seen
# at parse time. enum_variant_count[eid] tracks variants per
# enum so PARSE_MATCH can verify all variants are covered.
# Layout chosen 2026-05-03 — extends the metadata band past
# fn_flags (0xF0000+0x10000 = 0x100000); fn_table was doubled at
# v5.11.19, and the post-v5.11.68 heap-map full reorg dropped
# brk-final to 0x4D9D000 (~77.6 MB; -9.06 MB from the v5.11.67
# 0x56AD000 baseline).
# v5.8.24 — enum cap bumped 256 → 1024. Audit data (2026-05-03):
# stdlib alone has 299 enum decls; downstream vani/yukti/sigil/
# patra/mabda compose to >250 in realistic multi-dep programs;
# the prior 256 cap had a 1-2 release runway before tripping.
# enum_variant_count[] grew 256×8B=2KB → 1024×8B=8KB; enum_name[]
# same. +12KB total in the metadata band. Layout shifts:
# enum_name[] moved 0x214808 → 0x216008. var_enum_id[8192] stays
# at 0x204000 (variant-keyed; the 8192 cap is the variant cap,
# not the enum cap — different bucket).
fn GVENUMID(S, vi): i64 { return L64(_venid_base + vi * 8); }
fn SVENUMID(S, vi, v): i64 { S64(_venid_base + vi * 8, v); return 0; }
fn GENUMC(S): i64 { return L64(S + 0x214000); }
fn SENUMC(S, v): i64 {
    if (v >= 1024) {
        syscall(SYS_WRITE, 2, "error: enum table full (1024) — too many enum decls\n", 54);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x214000, v);
    return 0;
}
fn GENUMVCNT(S, eid): i64 { return L64(S + 0x214008 + eid * 8); }
fn SENUMVCNT(S, eid, v): i64 { S64(S + 0x214008 + eid * 8, v); return 0; }
# v5.8.22 bite #2 — per-enum name (offset into S+0x60000 ident
# pool) for diagnostic messages at exhaustive-match check time.
# Written by PARSE_ENUM_DEF in pass 1 alongside variant tagging.
# v5.8.24 — moved 0x214808 → 0x216008 to accommodate
# enum_variant_count[] growing from 256 to 1024 slots.
fn GENUMNM(S, eid): i64 { return L64(S + 0x216008 + eid * 8); }
fn SENUMNM(S, eid, v): i64 { S64(S + 0x216008 + eid * 8, v); return 0; }
fn GTCNT(S): i64 { return L64(S + 0x18C118); }
fn STCNT(S, v): i64 { S64(S + 0x18C118, v); return 0; }
fn GTI(S): i64 { return L64(S + 0x18C120); }
fn STI(S, v): i64 { S64(S + 0x18C120, v); return 0; }
fn GNPOS(S): i64 { return L64(S + 0x18C128); }
fn SNPOS(S, v): i64 { S64(S + 0x18C128, v); return 0; }

# Phase 0 (v6.2.0): growable fixup table. The fixup entries — (codepos, var_idx)
# pairs, 16 B each — lived in a FIXED 16 MiB region at S+0x107B000 hard-capped at
# 1048576 (the cap AR-03 unified + the deep-dive flagged as a silent-overrun risk).
# `_fixup_base` starts AT that region and `_fixup_cap` at the old cap, so for any
# program under the old cap nothing changes (byte-identical); GFCNT grows the
# backing 2x via alloc() the moment the count would exceed it, ending the
# cap-raise treadmill. Inited in each per-target driver after the heap is up.
var _fixup_base = 0;
var _fixup_cap = 0;
# Grow the fixup backing 2x: alloc a new region, copy the used entries, repoint
# _fixup_base (the old region is leaked — cycc is a short-lived process). Uses a
# RAW count read (L64, not GFCNT) to avoid re-entering the grow check.
fn _fixup_grow(S): i64 {
    var nc = _fixup_cap * 2;
    # Runaway guard (replaces the old hard 1048576 cap with a generous ceiling —
    # 64M entries = 1 GiB; no real program reaches it, but a pathological input
    # can't grow unbounded into OOM).
    if (nc > 67108864) {
        syscall(SYS_WRITE, 2, "error: fixup table exceeds 64M entries\n", 39);
        syscall(SYS_EXIT, 1);
    }
    var nb = alloc(nc * 16);
    var used = L64(S + 0x18FCA8) * 16;
    var i = 0;
    while (i < used) { store64(nb + i, load64(_fixup_base + i)); i = i + 8; }
    _fixup_base = nb;
    _fixup_cap = nc;
    return 0;
}
# Fixup count. GFCNT is called right before every fixup write (writers do
# `fc = GFCNT(S)` then write slot fc), so the grow-when-full check lives here —
# one global compare per call; readers (count < cap) never trigger it.
fn GFCNT(S): i64 {
    var c = L64(S + 0x18FCA8);
    # _fixup_cap==0 → growable fixup not inited (the cx backend keeps its own
    # fixed 0x150B000 table; also guards any pre-init call) → skip the grow.
    if (_fixup_cap != 0 && c >= _fixup_cap) { _fixup_grow(S); }
    return c;
}
fn SFCNT(S, v): i64 { S64(S + 0x18FCA8, v); return 0; }
# Last var index
fn GLVAR(S): i64 { return L64(S + 0x18FCB0); }
fn SLVAR(S, v): i64 { S64(S + 0x18FCB0, v); return 0; }
# String pos — moved to 0x18FCC8 in 4.6.2 (was 0x70000) so tok_names
# can expand to 128 KB (0x60000–0x80000) without overlap.
fn GSPOS(S): i64 { return L64(S + 0x18FCC8); }
fn SSPOS(S, v): i64 { S64(S + 0x18FCC8, v); return 0; }

# Function state accessors
fn GFNC(S): i64 { return L64(S + 0x18DA00); }
fn SFNC(S, v): i64 { S64(S + 0x18DA00, v); return 0; }

# Phase 0 (v6.2.0): growable fn-tables. The function metadata was a FIXED family
# of 16 parallel 8 B/slot tables at S+0x93A000..0xA2A000 plus two cap-sized 2 B/slot
# hashes (fn_name_hash @0x110000 built at parse, fn_start_hash @0x114000 rebuilt each
# fixup), all hard-capped at 8192 fns — and cycc itself is at ~6500 (79% full; the
# cap error literally tells consumers to "split into compilation units"). Each table
# + hash gets a relocatable base behind a single `_fnt_cap` source of truth; REGFN
# grows the family 2x (and rehashes the name-hash) when the count would exceed the
# cap, ceilinged at 32768 (the 2 B hash slot stores fi+1, so fi+1 <= 65535). Bases
# start AT the original offsets, mask at 8191, cap at 8192 → byte-identical under the
# old cap. Inited per-driver after the heap is up (the cx backend inits too — it
# shares REGFN/the data tables; only its emit differs). The live[] DCE bitmap in
# x86/aarch64 fixup is fixed-sized to the 32768 ceiling (live[4096]) rather than
# grown — it is rebuilt per pass and never relocates.
var _fnt_cstrmask = 0;    # 0x93A000 fn_param_cstring_mask
var _fnt_resmask = 0;     # 0x94A000 fn_param_result_mask
var _fnt_optmask = 0;     # 0x95A000 fn_param_option_mask
var _fnt_tagmask = 0;     # 0x96A000 fn_param_tagged_mask
var _fnt_ovstr = 0;       # 0x97A000 fn_overload_str
var _fnt_ovint = 0;       # 0x98A000 fn_overload_int
var _fnt_ovcstr = 0;      # 0x99A000 fn_overload_cstr
var _fnt_simdmask = 0;    # 0x9AA000 fn_param_simd_mask
var _fnt_names = 0;       # 0x9BA000 fn_names (noff)
var _fnt_offsets = 0;     # 0x9CA000 fn_offsets (code start)
var _fnt_params = 0;      # 0x9DA000 fn_params (param count)
var _fnt_bodystart = 0;   # 0x9EA000 fn_body_start
var _fnt_bodyend = 0;     # 0x9FA000 fn_body_end
var _fnt_inline = 0;      # 0xA0A000 fn_inline
var _fnt_strmask = 0;     # 0xA1A000 fn_param_str_mask
var _fnt_codeend = 0;     # 0xA2A000 fn_code_end
# v6.3.9 (F-fns): per-fn generic type-param names, packed (off0+1) | ((off1+1)<<32),
# 0 = non-generic fn. LAZY-alloc'd at the first generic capture (SFTP) to the MAX fn
# cap (32768 slots × 8 B = 256 KB) so it never needs to ride _fnt_grow; stays 0
# (unallocated) for the entire default (_MONOMORPH_OK=0) self-host → zero overhead,
# byte-identical. No fixed heap slot exists after the fn-table family (0xA3A000 is
# ir_nodes on x86), so this is alloc-backed, not fixed-offset.
var _fnt_tparams = 0;
# v6.3.10 (instantiate-once): per-fn `fn`-keyword token index, so a non-i64 generic
# instance can re-invoke PARSE_FN_DEF on the base's verbatim tokens. Lazy-alloc'd
# (max fn cap) like _fnt_tparams; 0 = not a generic fn / unrecorded.
var _fnt_defstart = 0;
# v6.3.10: PARSE_FN_DEF overrides when emitting a specialized instance. _inst_name
# (0 = normal) replaces the parsed fn name with the mangled `foo$ty`; _inst_conc0/1
# (0 = base-as-i64) bind the type-params to the concrete instance types instead of
# the default i64. Cleared by the instantiate trigger after the re-invoke returns.
var _inst_name = 0;
var _inst_conc0 = 0;
var _inst_conc1 = 0;
# v6.3.33 (generics tail — nested `Outer<Inner<T>>`): `>>` lexes to ONE right-shift
# token (39), not two `>`. When a nested type-arg close consumes a `>>`, it closes the
# INNER level and OWES one `>` to the outer level — tracked here (see _consume_gt).
var _ta_pending_gt = 0;
# v6.3.11 (G): per-fn async flag (1 = `async fn`, else 0). Lazy-alloc'd (max fn
# cap) like _fnt_tparams; stays 0 (unallocated) for the default self-host (cycc
# has no async fn) → zero overhead, byte-identical. A call to a flagged fn builds
# a Future object `[impl_ptr, argc, args…]` (synthesized constructor) instead of
# calling directly; `await fut` forces it via the runtime's future_force.
var _fnt_is_async = 0;
# v6.3.11 (G): async/await feature gate. Default 0 (off) → cycc self-host
# byte-identical (async/await tokens never appear in cycc src; the gated lowering
# is unreachable). Lazily set to 1 by _ensure_async_gate when CYRIUS_ASYNC=1, the
# first time an `async`/`await` token reaches pass 2 (PARSE_FN_DEF / PEXPR). Same
# opt-in shape as _MONOMORPH_OK, but lazy (no per-fork driver edit) — see parse_fn.cyr.
var _ASYNC_OK = 0;
var _async_gate_init = 0;
# v6.3.13: thread-safe array locals — route `var arr[N]` (inside a fn) to a per-thread
# stack/heap slot instead of the shared global/BSS data region. Default off (lazy-init
# from CYRIUS_STACK_ARRAYS); flipped on at slot close. See parse.cyr `_ensure_stack_arrays`.
var _STACK_ARRAYS = 0;
var _sa_init = 0;
# v6.3.11 (G): set by the pass-2 top-level dispatch when it consumes a leading
# `async` (token 134) before routing to PARSE_FN_DEF — the consume happens IN the
# dispatch (not PARSE_FN_DEF) so the fn-name the cursor points at for the DCE
# reachability pre-check is the real name, not `async`. PARSE_FN_DEF reads + clears
# it at entry. Only set on the reachable (real-emit) path, so an unreachable async
# fn that gets DCE-stubbed can't leak the flag to the next fn.
var _pending_async = 0;
var _fnt_namehash = 0;    # 0x110000 fn_name_hash (2 B/slot, name -> fi+1)
var _fnt_starthash = 0;   # 0x114000 fn_start_hash (2 B/slot, start -> fi+1)
var _fnt_hash_mask = 0;   # _fnt_cap - 1 (both hashes; cap is power-of-2)
var _fnt_cap = 0;
# v6.3.5 AR-01 — monomorphization substrate (gated proof). Opt-in flag that
# re-enables the inline body-token CAPTURE (SFBS/SFBE/SFINL in PARSE_FN_DEF) so
# the still-intact emit-time replay path (PARSE_FNCALL, GFINL!=0 branch) fires.
# Default 0: the per-backend `_INLINE_OK` default-off (x86 size regression v1.11.3;
# aarch64 metadata overlap, since relocated) stays untouched, so default codegen
# is byte-identical. Each driver sets this to 1 when CYRIUS_MONOMORPH=1. The
# capture gates OR `_INLINE_OK == 1 || _MONOMORPH_OK == 1`. Type substitution
# (generics) builds on this in v6.3.7; v6.3.5 only proves the value-replay
# substrate is byte-correct cross-arch behind the flag.
var _MONOMORPH_OK = 0;
# v6.3.29 — callee-saved frame-trim (CYRIUS_FRAMETRIM). Every #regalloc fn saves+
# restores ALL _cur_fn_regalloc callee-saved regs (rbx,r12-r15) in prologue/epilogue,
# even when the linear-scan picker used FEWER. Since the picker allocates lowest-first
# and callee-saved regs are written ONLY by the picker, the regs it used are a prefix
# {0.._ra_used_n-1}; the saves/restores for [_ra_used_n, _cur_fn_regalloc) are DEAD →
# NOP them + let the existing compactor harvest them. ~2% cycc size + fewer mem-ops/call.
# v6.3.29: DEFAULT ON (CYRIUS_FRAMETRIM=0 opts out). Verified via self-host fixpoint +
# full tcyr (exit-identical to default) + the two-step bootstrap.
var _FRAMETRIM_OK = 1;
var _ra_used_n = 0;      # max callee-saved reg index the picker assigned, +1 (per-fn)
# v6.3.30 — redundant-reload elimination. Naive codegen emits, at statement
# boundaries, `mov [rbp-N],rax` (store a just-computed value) immediately
# followed by `mov rax,[rbp-N]` (reload it for the next use). The reload is
# DEAD: the two are adjacent, nothing writes rax or [rbp-N] between them, so
# rax already holds the value. Record the 7-byte reload as a nop_run → the
# existing compactor deletes it (size + one fewer memory load per site). The
# only hazard is a jump landing ON the reload (control could arrive without the
# store) → guarded by IS_JUMP_TARGET. DEFAULT ON (CYRIUS_RELOADELIM=0 opts out).
# x86-only; runs in PARSE_FN_DEF's compaction block after the picker + frame-trim.
var _RELOADELIM_OK = 1;
# v6.3.30 O2 category 5 reload-elim tracker (shared home so parse_ctrl.cyr's loop-top
# clears compile on every fork; only the x86 EFLSTORE/EFLLOAD set/consult it — the
# aarch64/cx forks leave it at -1, so the clears are no-ops there). EFLSTORE records
# its post-emit CP + local idx; a 64-bit EFLLOAD of the SAME idx as the very next emit
# (GCP still == _efl_store_cp) is a dead reload (rax still holds it) → skipped. Fail-safe
# via CP-adjacency; loop-tops + EPATCH landings clear it for control-flow entries.
var _efl_store_cp = 0 - 1;
var _efl_store_idx = 0 - 1;
# Copy an 8 B/slot table's live oc entries into a fresh nc-slot buffer. The tail
# (oc..nc) is zeroed by alloc's fresh mmap pages — new fn slots default 0, which is
# exactly what REGFN's mask/overload/body tables expect (they're only written when
# a fn actually has that property).
fn _fnt_copy_table(old, oc, nc): i64 {
    var nb = alloc(nc * 8);
    var i = 0;
    var b = oc * 8;
    while (i < b) { store64(nb + i, load64(old + i)); i = i + 8; }
    return nb;
}

# Phase 0 (v6.2.0): growable codebuf. The generated machine code lived in a FIXED
# 3 MB region at S+0x41A000 (the cx bytecode backend keeps its own separate 512 KB
# region at 0x54A000), hard-capped — cyrius-ts test compiles hit 94 %. EB appends
# bytes here; the disp32 patch sites do an 8 B read-modify-write at cp (4 B past the
# 4 B slot) and the DSE/LASE peephole passes read+patch already-emitted code in
# place — all reach codebuf through `_codebuf_base`, re-derived fresh each access,
# so a relocation is transparent (the bytes are copied, offsets preserved). EB grows
# 2x when cp nears the cap, with a 64 B guard band so the disp32 RMW (and any byte
# advanced past the EB cap-check) never crosses the buffer end. Ceiling 64 MiB (the
# 16 MB output cap bounds real code well under it). Inited per-driver after the heap
# is up; `_codebuf_cap==0` guards any pre-init call. Byte-identical under the old cap.
var _codebuf_base = 0;
var _codebuf_cap = 0;
fn _codebuf_grow(S): i64 {
    var nc = _codebuf_cap * 2;
    if (nc > 67108864) {
        syscall(SYS_WRITE, 2, "error: codebuf exceeds 64 MiB (program too large)\n", 50);
        syscall(SYS_EXIT, 1);
    }
    var nb = alloc(nc);
    var used = GCP(S);
    var i = 0;
    while (i < used) { store64(nb + i, load64(_codebuf_base + i)); i = i + 8; }
    _codebuf_base = nb;
    _codebuf_cap = nc;
    return 0;
}

# v5.11.37: relocated from parse_fn.cyr to util.cyr so that
# backend emit.cyr files (included before parse_*.cyr in
# main_*.cyr) can resolve C-string-named functions — e.g.
# aarch64 emit.cyr's polyfill-dispatch named ops (EF64_EXP,
# EF64_LN, EF64_LOG2) need to look up `_f64_*_polyfill` fn
# indices at parse time. The implementation is unchanged from
# parse_fn.cyr's version.
fn _FINDFN_CSTR(S, str_ptr, str_len): i64 {
    var fc = GFNC(S);
    var fi = 0;
    while (fi < fc) {
        var sn = L64(_fnt_names + fi * 8);
        var i = 0;
        var eq = 1;
        while (i < str_len) {
            if (load8(S + 0x60000 + sn + i) != load8(str_ptr + i)) {
                eq = 0;
                i = str_len;
            } else {
                i = i + 1;
            }
        }
        if (eq == 1) {
            if (load8(S + 0x60000 + sn + str_len) == 0) {
                return fi;
            }
        }
        fi = fi + 1;
    }
    return 0 - 1;
}
fn GINFN(S): i64 { return L64(S + 0x18DA08); }
fn SINFN(S, v): i64 { S64(S + 0x18DA08, v); return 0; }
fn GFLC(S): i64 { return L64(S + 0x18DA10); }
# CVE-24 (v6.1.40): cap the per-fn stack-slot count. SFLC counts FRAME SLOTS
# (a `stack var buf[N]` registers N/8 fillers), and the four slot-indexed local
# tables — fn_local_names/local_depths/local_types/local_slice_widths, relocated
# to S+0x5D9D000.. (4×128 KB) — hold 16384 slots each. Fire before the
# 16384th-slot write overflows the table.
fn SFLC(S, v): i64 {
    if (v >= 16384) {
        syscall(SYS_WRITE, 2, "error: too many stack slots in one function (max 16384)\n", 56);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x18DA10, v);
    return 0;
}
# GRPC/SRPC retired at v6.0.7 — return-patch storage moved off the fixed
# 256-slot array at S + 0x18DA20 and onto rp_vec (lib/vec.cyr). The 2 KB
# array region [0x18DA20..0x18E220) and the counter slot at S + 0x18E220
# were FREED at v6.0.88 (dead init writes removed) — see CHANGELOG [6.0.88].
# Inline metadata accessors (GFBE getter removed — unused;
# SFBE is the only direction the inliner needs.)
fn GFBS(S, fi): i64 { return L64(_fnt_bodystart + fi * 8); }
fn SFBS(S, fi, v): i64 { S64(_fnt_bodystart + fi * 8, v); return 0; }
fn SFBE(S, fi, v): i64 { S64(_fnt_bodyend + fi * 8, v); return 0; }
fn GFINL(S, fi): i64 { return L64(_fnt_inline + fi * 8); }
fn SFINL(S, fi, v): i64 { S64(_fnt_inline + fi * 8, v); return 0; }
# v6.3.9 (F-fns): per-fn generic type-param accessors. GFTP returns 0 (no tparams)
# when the table is unallocated (the non-generic default), so callers never special-
# case. SFTP lazy-allocs the table (max fn cap) on first use — only ever reached under
# _MONOMORPH_OK with a `fn foo<T>` definition present.
fn GFTP(S, fi): i64 { if (_fnt_tparams == 0) { return 0; } return L64(_fnt_tparams + fi * 8); }
fn SFTP(S, fi, v): i64 { if (_fnt_tparams == 0) { _fnt_tparams = alloc(32768 * 8); } S64(_fnt_tparams + fi * 8, v); return 0; }
# v6.3.10 (instantiate-once): the base fn's `fn`-keyword token index (lazy-alloc'd).
fn GFDS(S, fi): i64 { if (_fnt_defstart == 0) { return 0; } return L64(_fnt_defstart + fi * 8); }
fn SFDS(S, fi, v): i64 { if (_fnt_defstart == 0) { _fnt_defstart = alloc(32768 * 8); } S64(_fnt_defstart + fi * 8, v); return 0; }
# v6.3.11 (G): per-fn async flag (lazy-alloc'd, 0 = not async / table unallocated).
fn GFAS(S, fi): i64 { if (_fnt_is_async == 0) { return 0; } return L64(_fnt_is_async + fi * 8); }
fn SFAS(S, fi, v): i64 { if (_fnt_is_async == 0) { _fnt_is_async = alloc(32768 * 8); } S64(_fnt_is_async + fi * 8, v); return 0; }
# v6.3.10 (generic structs): per-struct (0-based si) type-params (packed, like
# _fnt_tparams) + the `struct`-keyword token (defstart+1; 0=unrecorded). Lazy-alloc'd
# at 1024 slots (the struct cap). Used to instantiate `Box<Point>` by re-invoking
# PARSE_STRUCT_DEF on the base's tokens with T bound.
var _struct_tparams = 0;
var _struct_defstart = 0;
fn GSTP(S, si): i64 { if (_struct_tparams == 0) { return 0; } return L64(_struct_tparams + si * 8); }
fn SSTP(S, si, v): i64 { if (_struct_tparams == 0) { _struct_tparams = alloc(1024 * 8); } S64(_struct_tparams + si * 8, v); return 0; }
fn GSDS(S, si): i64 { if (_struct_defstart == 0) { return 0; } return L64(_struct_defstart + si * 8); }
fn SSDS(S, si, v): i64 { if (_struct_defstart == 0) { _struct_defstart = alloc(1024 * 8); } S64(_struct_defstart + si * 8, v); return 0; }
# v6.3.9 (F-fns): the ACTIVE generic-instantiation binding — up to 2 type-params,
# each {name-offset -> CANONICAL concrete-type token}. The token: <0 = scalar of
# width -tok (i64=-8, i32=-4, i16=-2, i8=-1); >0 = struct sid (1-based, FINDSTRUCT
# form); 0 = unbound (so `_tp_cN != 0` is the live-slot test, cheap-guarding the 4
# resolution-site consults). Scoped: bound right before a generic body replay,
# cleared after. Default (_MONOMORPH_OK=0) leaves all four at 0 → every consult is
# a no-op → byte-identical.
var _tp_n0 = 0;
var _tp_c0 = 0;
var _tp_n1 = 0;
var _tp_c1 = 0;
fn _tp_clear(S): i64 { _tp_n0 = 0; _tp_c0 = 0; _tp_n1 = 0; _tp_c1 = 0; return 0; }
fn _tp_bind(S, slot, noff, conc): i64 {
    if (slot == 0) { _tp_n0 = noff; _tp_c0 = conc; }
    if (slot == 1) { _tp_n1 = noff; _tp_c1 = conc; }
    return 0;
}
# Resolve a type-name offset against the active binding → canonical token, or 0 if
# noff isn't a bound type-param. Callers cheap-guard with `if (_tp_c0 != 0)` first.
fn _tp_resolve(S, noff): i64 {
    if (_tp_c0 != 0) { if (noff == _tp_n0) { return _tp_c0; } }
    if (_tp_c1 != 0) { if (noff == _tp_n1) { return _tp_c1; } }
    return 0;
}
# Fn code-end offset (v4.4.0 DCE). Set at end of PARSE_FN_DEF to the GCP
# where the fn body finishes. Paired with fn code starts at 0x1C4000.
# 0 means "not recorded" (fn was registered but never defined, or emitted
# via a path that bypasses the recording site).
fn GFNE(S, fi): i64 { return L64(_fnt_codeend + fi * 8); }
fn SFNE(S, fi, v): i64 { S64(_fnt_codeend + fi * 8, v); return 0; }

# v5.5.36 Phase 2b — per-fn struct return ID. 0 = scalar return,
# sid = returns StructName. Set by PARSE_FN when signature has
# `: StructName` annotation; consulted at PARSE_RETURN to emit
# the by-value copy and at call sites to pre-allocate caller-
# side struct space + pass &space as hidden first arg in
# RDI (SysV) or RCX (Win64).
fn GFRS(S, fi): i64 { return L64(S + 0x15A000 + fi * 8); }
fn SFRS(S, fi, v): i64 { S64(S + 0x15A000 + fi * 8, v); return 0; }

# v5.5.36 Phase 3 — per-fn variadic marker. 0 = fixed-arity;
# 1 = `fn f(a, ...)` (ellipsis terminator on the param list).
fn SFVA(S, fi, v): i64 { S64(S + 0x16A000 + fi * 8, v); return 0; }
# v6.2.41 — getter for the variadic marker (was write-only). Read by the
# call-site arity check in PARSE_FNCALL to exempt variadic callees.
fn GFVA(S, fi): i64 { return L64(S + 0x16A000 + fi * 8); }
# Per-fn #regalloc flag (v4.8.4-alpha4). 0 = default ABI, 1 = opt-in
# to callee-saved hot-local allocation. Set when `#regalloc` precedes
# a `fn` definition; read by codegen in subsequent alphas.
fn GFRA(S, fi): i64 { return L64(S + 0x14A000 + fi * 8); }
fn SFRA(S, fi, v): i64 { S64(S + 0x14A000 + fi * 8, v); return 0; }

# v5.11.64 — static-init literal value for `var X = INT_LITERAL ;`
# gvars detected by PARSE_GVAR_REG. FIXUP-time emit paths read these
# and pre-write into the var area, eliminating the runtime store
# sequence and fixing the kmode-entry init-order bug filed at
# docs/development/issues/2026-05-18-gvar-init-order-zero-reads.md.
# Zero == not statically initialized (BSS-zero already correct, so
# leave the runtime emit path in place — observable behavior is
# identical, no need to fork).
fn GVSI(S, vi): i64 { return L64(_vgsi_base + vi * 8); }
# v5.11.64 — stable mirror of FIXUP's prefix-sum table. Each entry
# is the byte offset of var vi within the var area (post m128
# alignment padding for size > 8 vars). Written in lockstep with
# the codebuf-fixup `pfx` scratch at 0x4D9D000+131072 (latter gets
# clobbered once output writing passes 128 KB into output_buf).
fn GVOFF(S, vi): i64 { return L64(_vgoff_base + vi * 8); }

# v5.11.64 — apply gvar static-init values to the var area at the
# given output offset `bss_o`. Called by each EMIT_* emit fn after
# its var-area zero-fill loop completes. Iterates the gvar table;
# any var with a recorded non-zero literal gets an 8-byte store at
# its byte offset, overwriting the zeros. Vars without static init
# (or with size != 8, e.g. arrays) are left zero — the array byte-
# list path (PARSE_GVAR_ARR + EMIT_GVAR_INITS) keeps its existing
# runtime-store handling, since per-byte arrays don't suffer the
# kmode-entry init-order bug (the store sequence is the workaround
# the user already writes by hand).
fn _EMIT_GVAR_STATIC_INITS(S, O, bss_o): i64 {
    var gvc = GVCNT(S);
    var gvi = 0;
    while (gvi < gvc) {
        var siv = GVSI(S, gvi);
        if (siv != 0) {
            var vsize = L64(_vars_base + gvi * 8);
            if (vsize == 8) {
                S64(O + bss_o + GVOFF(S, gvi), siv);
            }
        }
        gvi = gvi + 1;
    }
    return 0;
}

fn GIDEP(S): i64 { return L64(S + 0x1903E8); }
fn SIDEP(S, v): i64 { S64(S + 0x1903E8, v); return 0; }
# (GLVR/SLVR for r12 loop-var cache removed — the feature was
# reverted in v3.3.12 after a 2x perf regression; the 0x1903F8 slot is now
# owned by init_offset / elf_out_len (see src/main.cyr heap map).)
# Extra condition patches (for && chaining)
fn GXPC(S): i64 { return L64(S + 0x18F888); }
fn SXPC(S, v): i64 { S64(S + 0x18F888, v); return 0; }
fn ADDXP(S, p): i64 {
    var c = GXPC(S);
    if (c >= 8) {
        syscall(SYS_WRITE, 2, "error: too many && conditions (max 8)\n", 38);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x18F848 + c * 8, p);
    SXPC(S, c + 1);
    return 0;
}

# Line tracking
fn GCLINE(S): i64 { return L64(S + 0x18FCB8); }
fn SCLINE(S, v): i64 { S64(S + 0x18FCB8, v); return 0; }
fn GTLINE(S, ti): i64 { return L64(S + 0x3D7C000 + ti * 8); }
fn STLINE(S, ti, v): i64 { S64(S + 0x3D7C000 + ti * 8, v); return 0; }

# Block scoping
fn GSDEP(S): i64 { return L64(S + 0x18FCC0); }
fn SSDEP(S, v): i64 { S64(S + 0x18FCC0, v); return 0; }
fn GLDEP(S, li): i64 { return L64(S + 0x5DBD000 + li * 8); }
fn SLDEP(S, li, v): i64 { S64(S + 0x5DBD000 + li * 8, v); return 0; }

# Expression type tracking
fn GESTYPE(S): i64 { return L64(S + 0x1903D8); }
fn SESTYPE(S, v): i64 { S64(S + 0x1903D8, v); return 0; }
# Variable index of last struct expression (for address-based operator dispatch)
fn GESVAR(S): i64 { return L64(S + 0x1903E0); }
fn SESVAR(S, v): i64 { S64(S + 0x1903E0, v); return 0; }

# Module system. (GPUB/SPUB were scaffolded for the `pub` visibility check
# in docs/development/module-manifest-design.md but never wired up in the
# compiler — removed to stop tracking dead state. The 0x18FED0
# pub_flags region remains reserved in the heap map.)
fn GMOD(S): i64 { return L64(S + 0x18FEC8); }
fn SMOD(S, v): i64 { S64(S + 0x18FEC8, v); return 0; }
fn GUSEC(S): i64 { return L64(S + 0x1903D0); }
fn SUSEC(S, v): i64 { S64(S + 0x1903D0, v); return 0; }

fn SCOPE_PUSH(S): i64 { SSDEP(S, GSDEP(S) + 1); return 0; }
fn SCOPE_POP(S): i64 {
    # Mark out-of-scope locals as invisible by clearing their names.
    # Do NOT change GFLC — stack slots are permanent for the function frame.
    var dep = GSDEP(S);
    var lc = GFLC(S);
    var si = lc - 1;
    while (si >= 0) {
        if (GLDEP(S, si) >= dep) {
            # Mark as dead so FINDLOCAL won't match
            S64(S + 0x5D9D000 + si * 8, 0 - 1);
        }
        si = si - 1;
    }
    SSDEP(S, dep - 1);
    return 0;
}

# Pointer scale tracking (0 = not a pointer, >0 = element size in bytes)
fn GPSC(S): i64 { return L64(S + 0x18F890); }
fn SPSC(S, v): i64 { S64(S + 0x18F890, v); return 0; }
fn GLTYPE(S, li): i64 { return L64(S + 0x5DDD000 + li * 8); }
fn SLTYPE(S, li, v): i64 { S64(S + 0x5DDD000 + li * 8, v); return 0; }

# v5.8.14 §6 — TYPE_SLICE element-type tracking.
# Parallel-array stash for slice-typed locals: 576 entries × 8B,
# matching fn_local_names / local_types extent. Stores element
# byte-width per slice local (0 = not a slice, 1=u8, 2=u16,
# 4=u32, 8=i64/ptr, 16=u128). Read by §7 bounds-aware indexing
# (`s[i]` lowering picks load*/store* width from this) and §8
# dot-syntax field access (.ptr returns pointer-to-element type).
fn GSLICE_W(S, li): i64 { return L64(S + 0x5DFD000 + li * 8); }
fn SSLICE_W(S, li, w): i64 { S64(S + 0x5DFD000 + li * 8, w); return 0; }

# (TWIDTH type-width helper removed — every call site now inlines
# the byte-width decision directly for single-dispatch code paths.)

# Expression width tracking (0=untyped/i64, 1=i8, 2=i16, 4=i32)
fn GEXW(S): i64 { return L64(S + 0x1903F0); }
fn SEXW(S, v): i64 { S64(S + 0x1903F0, v); return 0; }

# Print a number to stderr (decimal)
fn PRNUM(n): i64 {
    var buf[24];
    var i = 23;
    var neg = 0;
    if (n < 0) { neg = 1; n = 0 - n; }
    if (n == 0) { store8(&buf + i, 48); i = i - 1; }
    while (n > 0) {
        store8(&buf + i, 48 + n % 10);
        i = i - 1;
        n = n / 10;
    }
    if (neg == 1) { store8(&buf + i, 45); i = i - 1; }
    syscall(SYS_WRITE, 2, &buf + i + 1, 23 - i);
    return 0;
}

# Print a null-terminated string to stderr
fn PRSTR(s): i64 {
    var i = 0;
    while (load8(s + i) != 0) { i = i + 1; }
    syscall(SYS_WRITE, 2, s, i);
    return 0;
}

fn TOKNAME(typ): i64 {
    if (typ == 1) { return "number"; }
    if (typ == 2) { return "identifier"; }
    if (typ == 3) { return "var"; }
    if (typ == 4) { return "'='"; }
    if (typ == 5) { return "';'"; }
    if (typ == 6) { return "'+'"; }
    if (typ == 7) { return "'-'"; }
    if (typ == 8) { return "'*'"; }
    if (typ == 9) { return "'/'"; }
    if (typ == 10) { return "'('"; }
    if (typ == 11) { return "')'"; }
    if (typ == 12) { return "end of file"; }
    if (typ == 13) { return "'{'"; }
    if (typ == 14) { return "'}'"; }
    if (typ == 15) { return "if"; }
    if (typ == 16) { return "while"; }
    if (typ == 17) { return "'=='"; }
    if (typ == 18) { return "'!='"; }
    if (typ == 19) { return "'<'"; }
    if (typ == 20) { return "'>'"; }
    if (typ == 23) { return "else"; }
    if (typ == 28) { return "'['"; }
    if (typ == 29) { return "']'"; }
    if (typ == 30) { return "string"; }
    if (typ == 31) { return "','"; }
    if (typ == 32) { return "fn"; }
    if (typ == 33) { return "return"; }
    if (typ == 40) { return "struct"; }
    if (typ == 41) { return "'.'"; }
    if (typ == 48) { return "asm"; }
    if (typ == 49) { return "':'"; }
    if (typ == 50) { return "elif"; }
    if (typ == 51) { return "break"; }
    if (typ == 52) { return "continue"; }
    if (typ == 55) { return "for"; }
    if (typ == 57) { return "switch"; }
    if (typ == 58) { return "case"; }
    if (typ == 59) { return "default"; }
    if (typ == 60) { return "enum"; }
    if (typ == 72) { return "mod"; }
    if (typ == 73) { return "pub"; }
    if (typ == 74) { return "use"; }
    if (typ == 75) { return "match"; }
    if (typ == 76) { return "in"; }
    if (typ == 77) { return "impl"; }
    if (typ == 78) { return "shared"; }
    if (typ == 79) { return "object"; }
    if (typ == 111) { return "stack"; }
    return "unknown";
}

# v5.8.45: returns 1 iff the current token is the bare ident "kernel".
# Used by main.cyr top-level dispatch to recognize the AGNOS kernel-mode
# switch (`kernel;`) without making `kernel` a reserved word in the lexer.
# Pre-v5.8.45 the lexer emitted token 56 unconditionally, which broke
# any DSP/graphics/AI code using `kernel` as a parameter or local name
# (vidya audio_dsp 11-lang port, 2026-05-03).
fn _TOK_IS_KERNEL(S): i64 {
    if (PEEKT(S) != 2) { return 0; }
    var noff = PEEKV(S);
    var p = S + 0x60000 + noff;
    if (load8(p)     != 107) { return 0; }  # 'k'
    if (load8(p + 1) != 101) { return 0; }  # 'e'
    if (load8(p + 2) != 114) { return 0; }  # 'r'
    if (load8(p + 3) != 110) { return 0; }  # 'n'
    if (load8(p + 4) != 101) { return 0; }  # 'e'
    if (load8(p + 5) != 108) { return 0; }  # 'l'
    if (load8(p + 6) != 0)   { return 0; }  # NUL — full match, not "kernel*"
    return 1;
}

# Is this token type a reserved keyword (that a user might mistakenly
# try to use as an identifier)? Used by ERR_EXPECT to print a clearer
# diagnostic when a user writes e.g. `var match = 1;`.
fn IS_KEYWORD_TOK(typ): i64 {
    if (typ == 3)  { return 1; }   # var
    if (typ == 15) { return 1; }   # if
    if (typ == 16) { return 1; }   # while
    if (typ == 23) { return 1; }   # else
    if (typ == 32) { return 1; }   # fn
    if (typ == 33) { return 1; }   # return
    if (typ == 40) { return 1; }   # struct
    if (typ == 48) { return 1; }   # asm
    if (typ == 50) { return 1; }   # elif
    if (typ == 51) { return 1; }   # break
    if (typ == 52) { return 1; }   # continue
    if (typ == 55) { return 1; }   # for
    if (typ == 57) { return 1; }   # switch
    if (typ == 58) { return 1; }   # case
    if (typ == 59) { return 1; }   # default
    if (typ == 60) { return 1; }   # enum
    if (typ == 72) { return 1; }   # mod
    if (typ == 73) { return 1; }   # pub
    if (typ == 74) { return 1; }   # use
    if (typ == 75) { return 1; }   # match
    if (typ == 76) { return 1; }   # in
    if (typ == 77) { return 1; }   # impl
    if (typ == 78) { return 1; }   # shared
    if (typ == 79) { return 1; }   # object
    if (typ == 111) { return 1; }  # stack
    return 0;
}

fn ERRDUPVAR(S): i64 {
    syscall(SYS_WRITE, 2, "error:", 6);
    FM_LOOKUP(S, GTLINE(S, GTI(S)));
    syscall(SYS_WRITE, 2, ": duplicate variable\n", 21);
    syscall(SYS_EXIT, 1);
    return 0;
}

fn WARN(S, msg, len): i64 {
    syscall(SYS_WRITE, 2, "warning:", 8);
    FM_LOOKUP(S, GTLINE(S, GTI(S)));
    syscall(SYS_WRITE, 2, ": ", 2);
    syscall(SYS_WRITE, 2, msg, len);
    syscall(SYS_WRITE, 2, "\n", 1);
    return 0;
}

fn ERR(S): i64 {
    var typ = PEEKT(S);
    syscall(SYS_WRITE, 2, "error:", 6);
    FM_LOOKUP(S, GTLINE(S, GTI(S)));
    syscall(SYS_WRITE, 2, ": unexpected ", 13);
    PRSTR(TOKNAME(typ));
    if (typ == 2) {
        syscall(SYS_WRITE, 2, " '", 2);
        PRSTR(S + 0x60000 + PEEKV(S));
        syscall(SYS_WRITE, 2, "'", 1);
    }
    if (typ == 1) {
        syscall(SYS_WRITE, 2, " ", 1);
        PRNUM(PEEKV(S));
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    syscall(SYS_EXIT, 1);
    return 0;
}

# v5.11.54: locate a registered fn by exact byte-match on its name.
# Returns the fn-table index on hit, -1 on miss.
#
# Pre-v5.11.54 the `main` lookup (main.cyr:1338 for fn auto-call)
# and the `efi_main` lookup (main.cyr:1369 for the EFI trampoline)
# were each open-coded as 5-9-deep nested-if byte comparisons —
# same shape, different name. This helper collapses both call
# sites and pre-empts the next "scan fn_names for a magic name"
# pattern.
#
# Used at pass-2 emit time only — the fn-table at S+0x9BA000
# (name offsets into tok_names @ S+0x60000) and S+0x9CA000 (fn
# code offsets) are populated by REGFN during pass 1.
fn _find_fn_by_name(S, name_cstr, name_len): i64 {
    var fc = GFNC(S);
    var fi = 0;
    while (fi < fc) {
        var noff = L64(_fnt_names + fi * 8);
        var eq = 1;
        var ci = 0;
        while (ci < name_len) {
            if (load8(S + 0x60000 + noff + ci) != load8(name_cstr + ci)) {
                eq = 0;
                ci = name_len;
            } else {
                ci = ci + 1;
            }
        }
        # Require the next byte to be NUL — guards against names
        # like "mainframe" matching when searching for "main".
        if (eq == 1) {
            if (load8(S + 0x60000 + noff + name_len) == 0) {
                return fi;
            }
        }
        fi = fi + 1;
    }
    return 0 - 1;
}

fn ERR_EXPECT(S, expected_type): i64 {
    var got = PEEKT(S);
    syscall(SYS_WRITE, 2, "error:", 6);
    FM_LOOKUP(S, GTLINE(S, GTI(S)));
    syscall(SYS_WRITE, 2, ": expected ", 11);
    PRSTR(TOKNAME(expected_type));
    syscall(SYS_WRITE, 2, ", got ", 6);
    # v5.5.26: when the expected token is an identifier and the got
    # token is a reserved keyword, make the diagnostic unambiguous.
    # Previously a user writing `var match = 1;` got "expected
    # identifier, got match" (or worse, "got unknown" for tokens
    # like `in` / `shared` / `default` missing from TOKNAME), leaving
    # them unsure whether the keyword name was misspelled or reserved.
    if (expected_type == 2) {
        if (IS_KEYWORD_TOK(got) == 1) {
            syscall(SYS_WRITE, 2, "reserved keyword '", 18);
            PRSTR(TOKNAME(got));
            syscall(SYS_WRITE, 2, "' (cannot be used as an identifier; rename the variable/field/fn)", 65);
            syscall(SYS_WRITE, 2, "\n", 1);
            syscall(SYS_WRITE, 2, "  at fail: fn=", 14); PRNUM(L64(S + 0x18DA00));
            syscall(SYS_WRITE, 2, "/8192 ident=", 12); PRNUM(L64(S + 0x18C128));
            syscall(SYS_WRITE, 2, "/262144 var=", 12); PRNUM(L64(S + 0x18C110));
            syscall(SYS_WRITE, 2, "/8192 fixup=", 12); PRNUM(L64(S + 0x18FCA8));
            syscall(SYS_WRITE, 2, "/32768\n", 7);
            syscall(SYS_EXIT, 1);
        }
    }
    PRSTR(TOKNAME(got));
    if (got == 2) {
        syscall(SYS_WRITE, 2, " '", 2);
        PRSTR(S + 0x60000 + PEEKV(S));
        syscall(SYS_WRITE, 2, "'", 1);
    }
    if (got == 1) {
        syscall(SYS_WRITE, 2, " ", 1);
        PRNUM(PEEKV(S));
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    # v5.11.28: when fn-arg parsing surfaces "expected ')' / ',', got string"
    # the underlying cause is often a nested 2-arg call inside another fn-call
    # confusing the parser's arg-list state machine. Stage the inner call
    # into a `var` first as a workaround. See CHANGELOG [5.11.28] + bote
    # 2.7.1 filing.
    if (got == 30) {
        if (expected_type == 11) {
            syscall(SYS_WRITE, 2, "  hint: a string literal where ')' is expected often means a nested call inside a fn argument confused the parser; stage the inner call into a `var` first.\n", 156);
        }
        if (expected_type == 31) {
            syscall(SYS_WRITE, 2, "  hint: a string literal where ',' is expected often means a nested call inside a fn argument confused the parser; stage the inner call into a `var` first.\n", 156);
        }
    }
    # v4.8.4-alpha3: dump capacity at error site so consumers can
    # see if the error is correlated with a near-cap table — same
    # diagnostic as CYRIUS_STATS=1 but fired on parse failures so
    # users don't need to re-run with the env flag to get context.
    syscall(SYS_WRITE, 2, "  at fail: fn=", 14); PRNUM(L64(S + 0x18DA00));
    syscall(SYS_WRITE, 2, "/8192 ident=", 12); PRNUM(L64(S + 0x18C128));
    syscall(SYS_WRITE, 2, "/262144 var=", 12); PRNUM(L64(S + 0x18C110));
    syscall(SYS_WRITE, 2, "/8192 fixup=", 12); PRNUM(L64(S + 0x18FCA8));
    syscall(SYS_WRITE, 2, "/32768\n", 7);
    syscall(SYS_EXIT, 1);
    return 0;
}

fn ERR_MSG(S, msg, len): i64 {
    syscall(SYS_WRITE, 2, "error:", 6);
    FM_LOOKUP(S, GTLINE(S, GTI(S)));
    syscall(SYS_WRITE, 2, ": ", 2);
    syscall(SYS_WRITE, 2, msg, len);
    syscall(SYS_WRITE, 2, "\n", 1);
    syscall(SYS_EXIT, 1);
    return 0;
}

# ── Compiler-state heap zero-init (v5.8.63) ──────────────────────────
# Writes the post-brk scratch-state region (S+0x18C100..S+0x1903F8 +
# IR state at S+0xF3A000..S+0xF3A028 (5 counters; relocated out of the
# fixup_tbl-overlapping 0x174A0xx band @ v6.1.41) + global-var-init slots) to
# zero, with two sentinel-value exceptions:
#   - 0x18FCB0 = -1 (last_var: initial "no-var" sentinel)
#   - 0x18FCB8 =  1 (cur_line: lexer line counter starts at 1)
# All other slots zeroed.
#
# Universal across all 6 main_*.cyr entry points (main.cyr,
# main_aarch64.cyr, main_aarch64_native.cyr, main_aarch64_macho.cyr,
# main_cx.cyr, main_win.cyr). Pre-v5.8.63 each main inlined this
# ~30-line block; extraction here
# saves ~150 LOC of duplication. The aarch64 and cx mains over-zero
# IR state (they include ir.cyr but don't actively use the IR
# pipeline) — harmless because zero-init matches the post-brk
# kernel-zeroed state, and brk extends through 0x4D9D000 in every
# main (v5.11.68 reorg; was 0x56AD000 pre-.68) so the writes
# land in mapped memory.
fn _HEAP_INIT_SCRATCH(S): i64 {
    # Compiler-state scalars (BL, CP, VCNT, TCNT, TI, NPOS)
    S64(S + 0x18C100, 0);
    S64(S + 0x18C108, 0);
    S64(S + 0x18C110, 0);
    S64(S + 0x18C118, 0);
    S64(S + 0x18C120, 0);
    S64(S + 0x18C128, 0);
    # Function state (fn_count, in_fn, local_cnt)
    # ret_patch_cnt (0x18E220) retired v6.0.88 — see CHANGELOG [6.0.88];
    # return patches migrated to rp_vec at v6.0.7, region now FREED.
    S64(S + 0x18DA00, 0);
    S64(S + 0x18DA08, 0);
    S64(S + 0x18DA10, 0);
    # IR state (cycc — gated by CYRIUS_IR=1 env at runtime; init
    # unconditionally so the gate read sees zero, not garbage)
    S64(S + 0xF3A000, 0);    # ir_node_count
    S64(S + 0xF3A008, 0);    # ir_block_count   (v6.1.41: was 0x174A008, inside fixup_tbl)
    S64(S + 0xF3A010, 0);    # ir_cur_block     (v6.1.41: was 0x174A010)
    S64(S + 0xF3A018, 0);    # ir_edge_count    (v6.1.41: was 0x174A018)
    S64(S + 0xF3A020, 0);    # ir_enabled       (v6.1.41: was 0x174A020)
    # Struct state
    S64(S + 0x18F830, 0);
    # Condition patch state
    S64(S + 0x18F888, 0);
    # Continue forward patch (for-loop, relocated v3.3.12)
    S64(S + 0x18F898, 0);
    # Global-var-init bookkeeping (gvar_cnt + scratch slots)
    S64(S + 0x19A000, 0);
    S64(S + 0x197000, 0);
    S64(S + 0x197F00, 0);
    # Kernel mode
    S64(S + 0x18FCA0, 0);
    # Fixup count
    S64(S + 0x18FCA8, 0);
    # last_var sentinel (-1 = "no var seen yet")
    S64(S + 0x18FCB0, 0 - 1);
    # cur_line (lexer starts at line 1)
    S64(S + 0x18FCB8, 1);
    # Block scoping
    S64(S + 0x18FCC0, 0);
    # str_pos (string write position)
    S64(S + 0x18FCC8, 0);
    # Module system (current_module + use_count)
    S64(S + 0x18FEC8, 0);
    S64(S + 0x1903D0, 0);
    # Expression tracking (stype, var, inline_depth, width)
    S64(S + 0x1903D8, 0);
    S64(S + 0x1903E0, 0);
    S64(S + 0x1903E8, 0);
    S64(S + 0x1903F0, 0);
    return 0;
}
