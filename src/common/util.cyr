# ================================================================
# 64-BIT MEMORY HELPERS
# ================================================================

fn S64(a, v): i64 {
    store64(a, v);
    return 0;
}

fn L64(a): i64 {
    return load64(a);
}

# ================================================================
# STATE ACCESSORS
# ================================================================

fn GBL(S): i64 { return L64(S + 0x18C100); }
fn SBL(S, v): i64 { S64(S + 0x18C100, v); return 0; }
fn GCP(S): i64 { return L64(S + 0x18C108); }
fn SCP(S, v): i64 { S64(S + 0x18C108, v); return 0; }
fn GVCNT(S): i64 { return L64(S + 0x18C110); }
# Phase 0 tail (v6.3.0): growable var-family. SEVEN parallel 8 B/slot tables —
# var_noffs (0x11A000), var_sizes (0x12A000), var_types (0x13A000), gvar_byte_off
# (0x1B0000), enum_const_val (0x1D8000), gvar_initval (0x1EC000), var_enum_id
# (0x204000) — were all FIXED, indexed by the var count, hard-capped at 8192
# (SVCNT errored). They are grown as one family: bases start AT the original
# offsets + _var_cap at 8192, so under the old cap nothing changes (byte-identical
# fixpoint); SVCNT grows the whole family 2x the moment the count would reach the
# cap, ending the last fixed compile-time cap (the var tail the v6.2.0 Phase-0
# migration left). Inited per-driver after the heap is up.
var _varn_base = 0;    # 0x11A000 var_noffs
var _vars_base = 0;    # 0x12A000 var_sizes
var _vart_base = 0;    # 0x13A000 var_types
var _vgoff_base = 0;   # 0x1B0000 gvar_byte_off
var _vecv_base = 0;    # 0x1D8000 enum_const_val

# v6.5.36 — enum-constant presence is OUT-OF-BAND. Do not put it back in the value.
#
# ⛔ THE HISTORY IS THE WARNING. `_vecv_base` used to store `(1 << 63) | val` and use the sign
# bit to mean "this slot holds an enum constant". That is 65 bits of information in a 64-bit
# slot, and it cannot be made to work:
#   * v5.5.2 shipped it with a bare `& 0x7FFF...F` decode. Negative values came back as
#     colossal positives.
#   * v6.5.32 "fixed" that with a heuristic — if bit 62 is set, assume the slot is a negative
#     value and return it unchanged — and documented the result as "Range: -2^62 .. 2^62-1",
#     i.e. it wrote the truncation down as a specification instead of treating it as the defect.
#     `enum { K = 0x7FFFFFFFFFFFFFFF }` then evaluated to **-1**, silently, in five shipped
#     releases (6.5.31–6.5.35), with a green 282-file corpus. szal found it, not us.
# The lesson is the one this repo keeps re-learning: an in-band tag that steals a bit from a
# full-range value is not a tag, it is a silent truncation waiting for the first consumer to
# use the top of the range. **Presence and value need separate storage.**
#
# So: `_vecv_base` now holds the RAW i64 value — every bit pattern, no marker, no decode — and
# this table holds the presence flag. Lazily allocated on first write with the `_fnt_tparams`
# precedent, so there is NO new heap region, NO fork edit and NO change to the cybs-fragile
# `_grow_g*` chain (adding an 8th link to that chain DESYNCED cybs once already — see
# `_vsgn_base`'s note below). 1024 slots, matching the fold table's own cap, which every reader
# and the single writer already guard on.
var _vecp_base = 0;    # per-var "this slot holds a folded enum constant" (1 = yes)
fn GVECP(S, vi): i64 {
    if (_vecp_base == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1024) { return 0; }
    return L64(_vecp_base + vi * 8);
}
fn SVECP(S, vi, v): i64 {
    if (_vecp_base == 0) { _vecp_base = alloc(1024 * 8); }
    S64(_vecp_base + vi * 8, v);
    return 0;
}
var _vgsi_base = 0;    # 0x1EC000 gvar_initval
var _venid_base = 0;   # 0x204000 var_enum_id
var _vsgn_base = 0;    # v6.4.23: per-var signedness (1 = signed sub-i64 iN scalar, 0 = uN/other).
                       # Read by the global-scalar load path to sign-extend (movsx) vs zero-extend.
                       # NOT a grow-chain table: it's alloc'd MAX-sized (1048576 = _var_grow's hard
                       # cap) at init, so it never grows — adding an 8th link to the grow chain
                       # DESYNCED cybs (gen1 mis-grew the var tables into the adjacent enum table →
                       # "enum table full"). 8 MB lazy-mapped is ~free. See _var_grow's cap below.
var _var_cap = 0;
# Grow ONE var-family table 2x: alloc a new region (2x cap slots), copy the used
# `cap` slots, return the new base. Kept tiny (3 locals) ON PURPOSE — cybs, the
# bootstrap assembler-compiler, mis-compiles fns with too many locals, which broke
# the seed chain (seed→cybs→cycc) when _var_grow inlined all 7 grows in one ~10-local
# fn: cybs produced a gen1 that segfaulted compiling main.cyr. Splitting the per-table
# work into this helper keeps every fn under cybs's local capacity. (DO NOT re-inline.)
fn _grow_one(old_base, cap): i64 {
    var nb = alloc(cap * 2 * 8);
    var bytes = cap * 8;
    var i = 0;
    while (i < bytes) { store64(nb + i, load64(old_base + i)); i = i + 8; }
    return nb;
}
# Grow the var family 2x, ONE table per function, CHAINED. cybs (the bootstrap
# assembler-compiler) mis-compiles a fn with too many global/call references — the
# seed chain (seed→cybs→cycc) segfaulted when _var_grow grew all 7 tables inline
# (verified: 1 grow/fn self-hosts, 4 grows/fn desyncs cybs and gen1 segfaults). So
# each fn grows ONE table with the CURRENT _var_cap and tail-calls the next; the
# LAST (_grow_g7) bumps _var_cap, so every grow above sees the old cap. DO NOT
# re-inline these into one fn — it re-breaks the seed. See seed-derive-cycc.sh.
fn _grow_g7(): i64 { _venid_base = _grow_one(_venid_base, _var_cap); _var_cap = _var_cap * 2; return 0; }
fn _grow_g6(): i64 { _vgsi_base = _grow_one(_vgsi_base, _var_cap); _grow_g7(); return 0; }
fn _grow_g5(): i64 { _vecv_base = _grow_one(_vecv_base, _var_cap); _grow_g6(); return 0; }
fn _grow_g4(): i64 { _vgoff_base = _grow_one(_vgoff_base, _var_cap); _grow_g5(); return 0; }
fn _grow_g3(): i64 { _vart_base = _grow_one(_vart_base, _var_cap); _grow_g4(); return 0; }
fn _grow_g2(): i64 { _vars_base = _grow_one(_vars_base, _var_cap); _grow_g3(); return 0; }
fn _grow_g1(): i64 { _varn_base = _grow_one(_varn_base, _var_cap); _grow_g2(); return 0; }
fn _var_grow(S): i64 {
    if (_var_cap * 2 > 1048576) {
        syscall(SYS_WRITE, 2, "error: variable table exceeds 1048576 entries (too many globals+enums+arrays)\n", 78);
        syscall(SYS_EXIT, 1);
    }
    _grow_g1();
    return 0;
}
fn SVCNT(S, v): i64 {
    # v6.3.0: grow the var family 2x when the count would reach the cap, instead
    # of erroring at the old fixed 8192. _var_cap==0 guards any pre-init call.
    if (_var_cap != 0 && v >= _var_cap) { _var_grow(S); }
    S64(S + 0x18C110, v);
    return 0;
}
# v5.8.22 bite #1 — per-variant → parent-enum bookkeeping for
# exhaustive-match coverage check (consumer in subsequent bite).
# var_enum_id[vcnt] is 1-based: 0 = not a variant, N = variant
# of enum at index N-1. enum_count tracks total enum decls seen
# at parse time. enum_variant_count[eid] tracks variants per
# enum so PARSE_MATCH can verify all variants are covered.
# Layout chosen 2026-05-03 — extends the metadata band past
# fn_flags (0xF0000+0x10000 = 0x100000); fn_table was doubled at
# v5.11.19, and the post-v5.11.68 heap-map full reorg dropped
# brk-final to 0x4D9D000 (~77.6 MB; -9.06 MB from the v5.11.67
# 0x56AD000 baseline).
# v5.8.24 — enum cap bumped 256 → 1024. Audit data (2026-05-03):
# stdlib alone has 299 enum decls; downstream vani/yukti/sigil/
# patra/mabda compose to >250 in realistic multi-dep programs;
# the prior 256 cap had a 1-2 release runway before tripping.
# enum_variant_count[] grew 256×8B=2KB → 1024×8B=8KB; enum_name[]
# same. +12KB total in the metadata band. Layout shifts:
# enum_name[] moved 0x214808 → 0x216008. var_enum_id[8192] stays
# at 0x204000 (variant-keyed; the 8192 cap is the variant cap,
# not the enum cap — different bucket).
fn GVENUMID(S, vi): i64 { return L64(_venid_base + vi * 8); }
fn SVENUMID(S, vi, v): i64 { S64(_venid_base + vi * 8, v); return 0; }
fn GENUMC(S): i64 { return L64(S + 0x214000); }
fn SENUMC(S, v): i64 {
    if (v >= 1024) {
        syscall(SYS_WRITE, 2, "error: enum table full (1024) — too many enum decls\n", 54);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x214000, v);
    return 0;
}
fn GENUMVCNT(S, eid): i64 { return L64(S + 0x214008 + eid * 8); }
fn SENUMVCNT(S, eid, v): i64 { S64(S + 0x214008 + eid * 8, v); return 0; }
# v5.8.22 bite #2 — per-enum name (offset into S+0x60000 ident
# pool) for diagnostic messages at exhaustive-match check time.
# Written by PARSE_ENUM_DEF in pass 1 alongside variant tagging.
# v5.8.24 — moved 0x214808 → 0x216008 to accommodate
# enum_variant_count[] growing from 256 to 1024 slots.
fn GENUMNM(S, eid): i64 { return L64(S + 0x216008 + eid * 8); }
fn SENUMNM(S, eid, v): i64 { S64(S + 0x216008 + eid * 8, v); return 0; }
fn GTCNT(S): i64 { return L64(S + 0x18C118); }
fn STCNT(S, v): i64 { S64(S + 0x18C118, v); return 0; }
fn GTI(S): i64 { return L64(S + 0x18C120); }
fn STI(S, v): i64 { S64(S + 0x18C120, v); return 0; }
fn GNPOS(S): i64 { return L64(S + 0x18C128); }
fn SNPOS(S, v): i64 { S64(S + 0x18C128, v); return 0; }

# Phase 0 (v6.2.0): growable fixup table. The fixup entries — (codepos, var_idx)
# pairs, 16 B each — lived in a FIXED 16 MiB region at S+0x107B000 hard-capped at
# 1048576 (the cap AR-03 unified + the deep-dive flagged as a silent-overrun risk).
# `_fixup_base` starts AT that region and `_fixup_cap` at the old cap, so for any
# program under the old cap nothing changes (byte-identical); GFCNT grows the
# backing 2x via alloc() the moment the count would exceed it, ending the
# cap-raise treadmill. Inited in each per-target driver after the heap is up.
var _fixup_base = 0;
var _fixup_cap = 0;
# Grow the fixup backing 2x: alloc a new region, copy the used entries, repoint
# _fixup_base (the old region is leaked — cycc is a short-lived process). Uses a
# RAW count read (L64, not GFCNT) to avoid re-entering the grow check.
fn _fixup_grow(S): i64 {
    var nc = _fixup_cap * 2;
    # Runaway guard (replaces the old hard 1048576 cap with a generous ceiling —
    # 64M entries = 1 GiB; no real program reaches it, but a pathological input
    # can't grow unbounded into OOM).
    if (nc > 67108864) {
        syscall(SYS_WRITE, 2, "error: fixup table exceeds 64M entries\n", 39);
        syscall(SYS_EXIT, 1);
    }
    var nb = alloc(nc * 16);
    var used = L64(S + 0x18FCA8) * 16;
    var i = 0;
    while (i < used) { store64(nb + i, load64(_fixup_base + i)); i = i + 8; }
    _fixup_base = nb;
    _fixup_cap = nc;
    return 0;
}
# Fixup count. GFCNT is called right before every fixup write (writers do
# `fc = GFCNT(S)` then write slot fc), so the grow-when-full check lives here —
# one global compare per call; readers (count < cap) never trigger it.
fn GFCNT(S): i64 {
    var c = L64(S + 0x18FCA8);
    # _fixup_cap==0 → growable fixup not inited (the cx backend keeps its own
    # fixed 0x150B000 table; also guards any pre-init call) → skip the grow.
    if (_fixup_cap != 0 && c >= _fixup_cap) { _fixup_grow(S); }
    return c;
}
fn SFCNT(S, v): i64 { S64(S + 0x18FCA8, v); return 0; }
# Last var index
fn GLVAR(S): i64 { return L64(S + 0x18FCB0); }
fn SLVAR(S, v): i64 { S64(S + 0x18FCB0, v); return 0; }
# String pos — moved to 0x18FCC8 in 4.6.2 (was 0x70000) so tok_names
# can expand to 128 KB (0x60000–0x80000) without overlap.
fn GSPOS(S): i64 { return L64(S + 0x18FCC8); }
fn SSPOS(S, v): i64 { S64(S + 0x18FCC8, v); return 0; }

# Function state accessors
fn GFNC(S): i64 { return L64(S + 0x18DA00); }
fn SFNC(S, v): i64 { S64(S + 0x18DA00, v); return 0; }

# Phase 0 (v6.2.0): growable fn-tables. The function metadata was a FIXED family
# of 16 parallel 8 B/slot tables at S+0x93A000..0xA2A000 plus two cap-sized 2 B/slot
# hashes (fn_name_hash @0x110000 built at parse, fn_start_hash @0x114000 rebuilt each
# fixup), all hard-capped at 8192 fns. (An earlier version of this note claimed cycc
# was "at ~6500 (79% full)" — stale by ~6x: live measurement is ~1135 fns / 13.9%.
# That gap is exactly WHY the >8192 side-table corruption fixed at v6.4.75 never
# surfaced in-repo — cycc is nowhere near the cap; only a large consumer is.) Each table
# + hash gets a relocatable base behind a single `_fnt_cap` source of truth; REGFN
# grows the family 2x (and rehashes the name-hash) when the count would exceed the
# cap, ceilinged at 32768 (the 2 B hash slot stores fi+1, so fi+1 <= 65535). Bases
# start AT the original offsets, mask at 8191, cap at 8192 → byte-identical under the
# old cap. Inited per-driver after the heap is up (the cx backend inits too — it
# shares REGFN/the data tables; only its emit differs). The live[] DCE bitmap in
# x86/aarch64 fixup is fixed-sized to the 131072 ceiling (live[16384]; was 32768 /
# live[4096] before v6.5.40, and its clear loop + root bound followed only at v6.5.46) rather than
# grown — it is rebuilt per pass and never relocates.
var _fnt_cstrmask = 0;    # 0x93A000 fn_param_cstring_mask
var _fnt_resmask = 0;     # 0x94A000 fn_param_result_mask
var _fnt_optmask = 0;     # 0x95A000 fn_param_option_mask
var _fnt_tagmask = 0;     # 0x96A000 fn_param_tagged_mask
var _fnt_ovstr = 0;       # 0x97A000 fn_overload_str
var _fnt_ovint = 0;       # 0x98A000 fn_overload_int
var _fnt_ovcstr = 0;      # 0x99A000 fn_overload_cstr
var _fnt_simdmask = 0;    # 0x9AA000 fn_param_simd_mask
var _fnt_names = 0;       # 0x9BA000 fn_names (noff)
var _fnt_offsets = 0;     # 0x9CA000 fn_offsets (code start)
var _fnt_params = 0;      # 0x9DA000 fn_params (param count)
var _fnt_bodystart = 0;   # 0x9EA000 fn_body_start
var _fnt_bodyend = 0;     # 0x9FA000 fn_body_end
var _fnt_inline = 0;      # 0xA0A000 fn_inline
var _fnt_strmask = 0;     # 0xA1A000 fn_param_str_mask
var _fnt_codeend = 0;     # 0xA2A000 fn_code_end
var _fnt_structmask = 0;  # 0xA3A000 fn_param_struct_mask (v6.3.36 issue [5]): bit N set
                          # = param N is a plain (non-Str/Result/…) struct >8 B, which
                          # the callee derefs as a pointer → the caller address-passes it.
# v6.3.9 (F-fns): per-fn generic type-param names, packed (off0+1) | ((off1+1)<<32),
# 0 = non-generic fn. LAZY-alloc'd at the first generic capture (SFTP) to the MAX fn
# cap (32768 slots × 8 B = 256 KB) so it never needs to ride _fnt_grow; stays 0
# (unallocated) for the entire default (_MONOMORPH_OK=0) self-host → zero overhead,
# byte-identical. No fixed heap slot exists after the fn-table family (0xA3A000 is
# ir_nodes on x86), so this is alloc-backed, not fixed-offset.
var _fnt_tparams = 0;
# v6.3.10 (instantiate-once): per-fn `fn`-keyword token index, so a non-i64 generic
# instance can re-invoke PARSE_FN_DEF on the base's verbatim tokens. Lazy-alloc'd
# (max fn cap) like _fnt_tparams; 0 = not a generic fn / unrecorded.
var _fnt_defstart = 0;
# v6.3.10: PARSE_FN_DEF overrides when emitting a specialized instance. _inst_name
# (0 = normal) replaces the parsed fn name with the mangled `foo$ty`; _inst_conc0/1
# (0 = base-as-i64) bind the type-params to the concrete instance types instead of
# the default i64. Cleared by the instantiate trigger after the re-invoke returns.
var _inst_name = 0;
var _inst_conc0 = 0;
var _inst_conc1 = 0;
# v6.3.33 (generics tail — nested `Outer<Inner<T>>`): `>>` lexes to ONE right-shift
# token (39), not two `>`. When a nested type-arg close consumes a `>>`, it closes the
# INNER level and OWES one `>` to the outer level — tracked here (see _consume_gt).
var _ta_pending_gt = 0;
# v6.3.11 (G): per-fn async flag (1 = `async fn`, else 0). Lazy-alloc'd (max fn
# cap) like _fnt_tparams; stays 0 (unallocated) for the default self-host (cycc
# has no async fn) → zero overhead, byte-identical. A call to a flagged fn builds
# a Future object `[impl_ptr, argc, args…]` (synthesized constructor) instead of
# calling directly; `await fut` forces it via the runtime's future_force.
var _fnt_is_async = 0;
# v6.3.11 (G): async/await feature gate. Default 0 (off) → cycc self-host
# byte-identical (async/await tokens never appear in cycc src; the gated lowering
# is unreachable). Lazily set to 1 by _ensure_async_gate when CYRIUS_ASYNC=1, the
# first time an `async`/`await` token reaches pass 2 (PARSE_FN_DEF / PEXPR). Same
# opt-in shape as _MONOMORPH_OK, but lazy (no per-fork driver edit) — see parse_fn.cyr.
var _ASYNC_OK = 0;
# --- v6.5.69: coroutine frames (mid-body suspend) ------------------------------------
# ⛔ WHY THIS EXISTS. `async`/`await` shipped at v6.3.11 as deferred-then-forced Futures:
# `await e` lowered to a plain synchronous CALL to `future_force`, and a task that parked
# re-entered its body FROM THE TOP — the contract `lib/async.cyr` states outright. So the
# natural shape (a loop that awaits mid-body and continues) COMPILED CLEAN AND DID NOTHING:
# measured on the shipped compiler, a two-direction TTY relay written that way builds with
# zero errors, relays ZERO bytes and hangs. That is the v6.5.63 `#inline` class — a shipped
# syntax with no handler behind it — not a missing feature.
#
# THE TRANSFORM: an `async fn` body becomes a state machine. Its locals live in a HEAP frame
# (the Future object, which the runtime already hands back on every resume), a state word
# records which suspend point it left from, and the fn top dispatches to that point. The
# runtime needs NO change: `_async_step` re-invokes `fp(arg)` from the top, and the top is
# now a dispatch. CHANGELOG [6.5.69]
#
# Coro object layout, allocated by the synthesized constructor:
#   [0] impl fn ptr   [8] argc(=1)   [16] SELF   [24] state   [32 + i*8] local slot i
var _cur_fn_coro = 0;       # 1 while emitting a coroutine body
var _coro_base = 0;         # stack slot holding the heap frame base (always 0)
var _coro_lo = 0;           # locals with idx >= this live in the heap frame
var _coro_nsusp = 0;        # suspend points seen so far in this fn
var _coro_top_jmp = 0;      # the fn-top `jmp DISPATCH` placeholder
var _coro_entry_cp = 0;     # state 0 landing pad (top of the real body)
var _CORO_STATE_OFF = 24;   # byte offset of the state word inside the coro object
var _CORO_LOCAL_OFF = 32;   # byte offset of local slot 0
var _CORO_MAX_SUSP = 64;    # resume-label table size; exceeding it is a hard error
var _coro_rcp[512];         # resume-label CP per suspend index (1-based), 64 x 8 B
# --- v6.5.71: PP-generated functions that must be inlined, passed by SIDE CHANNEL ----------
# ⛔ WHY A SIDE CHANNEL AND NOT `#inline` TEXT. `#derive(accessors)` generates the canonical
# inline candidate — `fn Name_field(p) { return load64(p + K); }`, one parameter, flat,
# generated code nobody hand-tunes, measured 3.45x faster inlined. Emitting `#inline` into the
# generated text does not work and CANNOT be made to work: derive bodies are FLATTENED ONTO A
# SINGLE LINE to keep the user's line numbering honest, and `#` opens a COMMENT — so the `#`
# comments out the rest of that line, which is the user's tail AND the next `#derive`. Measured:
# a two-struct fixture gives exit 10 normally and `error: unexpected struct` with the emit
# added, because the second derive never fires. (The same fact v6.4.81 recorded as "`#` is a
# COMMENT so `#include` probes are inert", surfacing in a new place.)
#
# So the request travels BESIDE the text: the preprocessor records a hash of each accessor's
# name and `_PARSE_FN_DEF_IMPL` consults it. A 64-bit bloom mask short-circuits the scan, so an
# ordinary function pays one AND and one branch. CHANGELOG [6.5.71]
var _pp_inl_base = 0;
var _pp_inl_n = 0;
var _pp_inl_bloom = 0;

fn _pp_inl_hash(p): i64 {
    var h = 0xCBF29CE484222325;
    var i = 0;
    var c = load8(p + i);
    while (c != 0) {
        h = (h ^ c) * 0x100000001B3;
        i = i + 1;
        c = load8(p + i);
    }
    return h;
}
# Fold a name emitted in PIECES (struct name, an optional "set_", field name) without
# materialising the joined string — the preprocessor never holds it in one place.
fn _pp_inl_hash3(a, b, c): i64 {
    var h = 0xCBF29CE484222325;
    var i = 0;
    var ch = load8(a + i);
    while (ch != 0) { h = (h ^ ch) * 0x100000001B3; i = i + 1; ch = load8(a + i); }
    h = (h ^ 95) * 0x100000001B3;
    if (b != 0) {
        i = 0; ch = load8(b + i);
        while (ch != 0) { h = (h ^ ch) * 0x100000001B3; i = i + 1; ch = load8(b + i); }
    }
    i = 0; ch = load8(c + i);
    while (ch != 0) { h = (h ^ ch) * 0x100000001B3; i = i + 1; ch = load8(c + i); }
    return h;
}
fn _pp_inl_add(h): i64 {
    if (_pp_inl_base == 0) { _pp_inl_base = alloc(65536 * 8); }
    if (_pp_inl_base == 0) { return 0; }
    if (_pp_inl_n >= 65536) { return 0; }
    S64(_pp_inl_base + _pp_inl_n * 8, h);
    _pp_inl_n = _pp_inl_n + 1;
    _pp_inl_bloom = _pp_inl_bloom | (1 << (h & 63));
    return 0;
}
fn _pp_inl_has(p): i64 {
    if (_pp_inl_n == 0) { return 0; }
    var h = _pp_inl_hash(p);
    if ((_pp_inl_bloom & (1 << (h & 63))) == 0) { return 0; }
    var i = 0;
    while (i < _pp_inl_n) {
        if (L64(_pp_inl_base + i * 8) == h) { return 1; }
        i = i + 1;
    }
    return 0;
}
var _pending_coro = 0;      # this fn's body awaits: reserve slot 0 before params
var _coro_was = 0;          # the body just emitted was a coroutine
var _coro_flc = 0;          # that body's local-slot count (its frame size)
var _async_gate_init = 0;
# v6.3.13: thread-safe array locals — route `var arr[N]` (inside a fn) to a per-thread
# stack/heap slot instead of the shared global/BSS data region. Default off (lazy-init
# from CYRIUS_STACK_ARRAYS); flipped on at slot close. See parse.cyr `_ensure_stack_arrays`.
var _STACK_ARRAYS = 0;
var _sa_init = 0;
# v6.3.11 (G): set by the pass-2 top-level dispatch when it consumes a leading
# `async` (token 134) before routing to PARSE_FN_DEF — the consume happens IN the
# dispatch (not PARSE_FN_DEF) so the fn-name the cursor points at for the DCE
# reachability pre-check is the real name, not `async`. PARSE_FN_DEF reads + clears
# it at entry. Only set on the reachable (real-emit) path, so an unreachable async
# fn that gets DCE-stubbed can't leak the flag to the next fn.
var _pending_async = 0;
var _fnt_namehash = 0;    # 0x110000 fn_name_hash (2 B/slot, name -> fi+1)
var _fnt_starthash = 0;   # 0x114000 fn_start_hash (2 B/slot, start -> fi+1)
var _fnt_hash_mask = 0;   # _fnt_cap - 1 (both hashes; cap is power-of-2)
var _fnt_cap = 0;
# v6.4.75 — the SIX fn-indexed side tables the v6.2.0 growable-fn_table migration
# left behind at FIXED 8192-slot heap bands (0x100000, 0x14A000, 0x15A000,
# 0x16A000, 0x17A000, 0x1C8000). They abutted their neighbours, so once _fnt_grow
# let the fn count past 8192 (fi >= 8192), index fi of each wrote into slot
# (fi-8192) of the NEXT table — silent metadata corruption with no diagnostic, and
# the capacity warning went quiet at the same moment (it divides by the live
# _fnt_cap). See issues/2026-07-23-fn-table-growth-past-8192-corrupts-fixed-side-
# tables.md.
#
# Fix follows the SAME lazy-alloc-at-max-cap pattern already used for the fn-indexed
# _fnt_tparams / _fnt_defstart / _fnt_is_async tables just above (and _vsgn_base on
# the var side, v6.4.23): each table is alloc'd MAX-sized (32768 slots = the
# _fnt_grow ceiling) on first write and never grows, so it can never desync the
# cybs-fragile grow chain — the accessors carry the whole change and NO per-fork
# driver edit is needed. alloc() hands back kernel-zeroed bump-allocator pages, so
# an un-written slot reads 0 exactly like the old BSS band did.
var _fndep_base = 0;      # was 0x100000 fn_deprecated_msg (string-lit token: off<<16|len)
var _fnreg_base = 0;      # was 0x14A000 fn_regalloc (#regalloc opt-in flag)
var _fnret_base = 0;      # was 0x15A000 fn_ret_sid (struct-return StructName id)
var _fnretn_base = 0;     # v6.5.21 multi-value return ARITY  (0 = not multi-value)
var _fnrett_base = 0;     # v6.5.21 multi-value return ELEMENT TYPES (4 slots per fn)
var _fnvar_base = 0;      # was 0x16A000 fn_variadic (1 = fn f(a, ...))
var _fnflg_base = 0;      # was 0x17A000 fn_flags (must_use/deprecated/pure/io/alloc bits)
var _fnvb_base = 0;       # was 0x1C8000 fn_var_bytes (per-fn array-bytes attribution)

# v6.5.28 — FLOAT LITERAL side table. Two i64 slots per literal: numer @0, denom @8.
#
# ⛔ WHY THIS EXISTS. A decimal float literal used to be packed into ONE token value as
# `(denom << 32) | (numer & 0xFFFFFFFF)` — a 32/32 rational. Both halves overflowed silently
# past ~9 significant digits: `numer & 0xFFFFFFFF` TRUNCATES, and `denom << 32` overflows the
# i64 outright once denom > 2^32 (i.e. more than 9 fractional digits). The result was not a
# rounding error and not a saturation — `3.1415926535` became `0.95822` and
# `3.141592653589793` became `0.061575`, off by a factor of 51, with NO diagnostic: the build
# succeeded, lint was clean, and the program produced plausible-looking output.
# Filed from the ranga colour-space port, where 10-17 significant digits is the norm
# (2026-08-17-decimal-float-literal-silent-precision-loss).
#
# Widening to full i64 per field is what buys real f64 precision: `3.141592653589793` needs
# denom 1e15 and numer 3141592653589793, both comfortably inside i64. Capping the digit count
# instead would have been a smaller change but would still LOSE precision silently — the
# defect class, just quieter.
#
# Lazily allocated per the v6.4.75 `_fnvb_base` precedent above: no heap-map region, no
# layout change, no two-step bootstrap, and a program with no float literals allocates nothing.
# v6.5.28 — the declared return sid of the call on the RHS of an assignment, captured before
# the RHS is parsed (src/frontend/parse.cyr). 0 when the RHS is not a call to a known fn.
var _asg_ret_sid = 0;
var _flit_base = 0;
var _flit_n = 0;
var _FLIT_CAP = 16384;

# Intern a float literal's numer/denom, returning its index (the token value). Fails CLOSED:
# past the cap it returns -1 and the caller emits a hard error rather than aliasing slot 0,
# which is the v6.4.75 fn_table lesson (index N aliasing index 0 of the neighbour was a SILENT
# miscompile, and silence is exactly what this whole fix is removing).
fn FLIT_ADD(numer, denom): i64 {
    if (_flit_base == 0) { _flit_base = alloc(_FLIT_CAP * 16); }
    if (_flit_n >= _FLIT_CAP) { return 0 - 1; }
    var i = _flit_n;
    S64(_flit_base + i * 16, numer);
    S64(_flit_base + i * 16 + 8, denom);
    _flit_n = i + 1;
    return i;
}
# Numerator of interned float literal `i`.
fn FLIT_NUM(i): i64 { if (_flit_base == 0) { return 0; } return L64(_flit_base + i * 16); }
# Denominator of interned float literal `i`.
fn FLIT_DEN(i): i64 { if (_flit_base == 0) { return 1; } return L64(_flit_base + i * 16 + 8); }
# v6.3.5 AR-01 — monomorphization substrate (gated proof). Opt-in flag that
# re-enables the inline body-token CAPTURE (SFBS/SFBE/SFINL in PARSE_FN_DEF) so
# the still-intact emit-time replay path (PARSE_FNCALL, GFINL!=0 branch) fires.
# Default 0: the per-backend `_INLINE_OK` default-off (x86 size regression v1.11.3;
# aarch64 metadata overlap, since relocated) stays untouched, so default codegen
# is byte-identical. Each driver sets this to 1 when CYRIUS_MONOMORPH=1. The
# capture gates OR `_INLINE_OK == 1 || _MONOMORPH_OK == 1`. Type substitution
# (generics) builds on this in v6.3.7; v6.3.5 only proves the value-replay
# substrate is byte-correct cross-arch behind the flag.
var _MONOMORPH_OK = 1;
# v6.3.29 — callee-saved frame-trim (CYRIUS_FRAMETRIM). Every #regalloc fn saves+
# restores ALL _cur_fn_regalloc callee-saved regs (rbx,r12-r15) in prologue/epilogue,
# even when the linear-scan picker used FEWER. Since the picker allocates lowest-first
# and callee-saved regs are written ONLY by the picker, the regs it used are a prefix
# {0.._ra_used_n-1}; the saves/restores for [_ra_used_n, _cur_fn_regalloc) are DEAD →
# NOP them + let the existing compactor harvest them. ~2% cycc size + fewer mem-ops/call.
# v6.3.29: DEFAULT ON (CYRIUS_FRAMETRIM=0 opts out). Verified via self-host fixpoint +
# full tcyr (exit-identical to default) + the two-step bootstrap.
var _FRAMETRIM_OK = 1;
var _ra_used_n = 0;      # max callee-saved reg index the picker assigned, +1 (per-fn)
# v6.3.30 — redundant-reload elimination. Naive codegen emits, at statement
# boundaries, `mov [rbp-N],rax` (store a just-computed value) immediately
# followed by `mov rax,[rbp-N]` (reload it for the next use). The reload is
# DEAD: the two are adjacent, nothing writes rax or [rbp-N] between them, so
# rax already holds the value. Record the 7-byte reload as a nop_run → the
# existing compactor deletes it (size + one fewer memory load per site). The
# only hazard is a jump landing ON the reload (control could arrive without the
# store) → guarded by IS_JUMP_TARGET. DEFAULT ON (CYRIUS_RELOADELIM=0 opts out).
# x86-only; runs in PARSE_FN_DEF's compaction block after the picker + frame-trim.
var _RELOADELIM_OK = 1;
# v6.3.30 O2 category 5 reload-elim tracker (shared home so parse_ctrl.cyr's loop-top
# clears compile on every fork; only the x86 EFLSTORE/EFLLOAD set/consult it — the
# aarch64/cx forks leave it at -1, so the clears are no-ops there). EFLSTORE records
# its post-emit CP + local idx; a 64-bit EFLLOAD of the SAME idx as the very next emit
# (GCP still == _efl_store_cp) is a dead reload (rax still holds it) → skipped. Fail-safe
# via CP-adjacency; loop-tops + EPATCH landings clear it for control-flow entries.
var _efl_store_cp = 0 - 1;
var _efl_store_idx = 0 - 1;
# Copy an 8 B/slot table's live oc entries into a fresh nc-slot buffer. The tail
# (oc..nc) is zeroed by alloc's fresh mmap pages — new fn slots default 0, which is
# exactly what REGFN's mask/overload/body tables expect (they're only written when
# a fn actually has that property).
fn _fnt_copy_table(old, oc, nc): i64 {
    var nb = alloc(nc * 8);
    var i = 0;
    var b = oc * 8;
    while (i < b) { store64(nb + i, load64(old + i)); i = i + 8; }
    return nb;
}

# Phase 0 (v6.2.0): growable codebuf. The generated machine code lived in a FIXED
# 3 MB region at S+0x41A000 (the cx bytecode backend keeps its own separate 512 KB
# region at 0x54A000), hard-capped — cyrius-ts test compiles hit 94 %. EB appends
# bytes here; the disp32 patch sites do an 8 B read-modify-write at cp (4 B past the
# 4 B slot) and the DSE/LASE peephole passes read+patch already-emitted code in
# place — all reach codebuf through `_codebuf_base`, re-derived fresh each access,
# so a relocation is transparent (the bytes are copied, offsets preserved). EB grows
# +8 MiB when cp nears the cap, with a 64 B guard band so the disp32 RMW (and any byte
# advanced past the EB cap-check) never crosses the buffer end. Ceiling 64 MiB (the
# 16 MB output cap bounds real code well under it). Inited per-driver after the heap
# is up; `_codebuf_cap==0` guards any pre-init call. Byte-identical under the old cap.
var _codebuf_base = 0;
# --- v6.5.68: whole-program compaction registries ---------------------------------
# The per-fn NOP compactor (parse_fn.cyr) repairs positions from three tables that are
# ZEROED AT EVERY FUNCTION START — jump_src_tbl, sw_tbl, nop_run_tbl. That is fine for a
# pass that runs inside `_PARSE_FN_DEF_IMPL`, and useless for one that runs after all
# parsing: the IR fixpoint writes its NOPs into a table that has already been consumed
# 1,275 times. So the whole-program pass keeps its own append-only registries, filled AT
# THE MOMENT THE BYTES ARE WRITTEN.
#
# ⭐ REGISTER, DO NOT RE-SCAN — the failure modes are asymmetric. A registry that misses a
# producer leaves bytes uncollected: a lost optimisation. A re-scan for `0x90` runs would
# DELETE A DELIBERATE NOP: a miscompile. Deliberate NOPs exist — `asm { nop }` (emit.cyr
# reaches the `nop` mnemonic) and the `ud2; ud2; nop` an undefined-fn call is rewritten to
# (fixup.cyr). A re-scan also cannot tell code from data: switch jump tables live INSIDE
# `.text`, and a linear decoder walking one manufactures phantom jumps out of table bytes.
# ⚠ This is NOT the v6.5.66 whitelist mistake in a new hat. That was a whitelist of READER
# emitters — an open-ended set that must be kept in sync with every future reader. These are
# three calls at the exact statements that WRITE the bytes, and each already has (cp, len)
# in hand to do the write.
#
# Layout, in the 0x60000-0x100000 band freed when v6.5.40 relocated the identifier pool to
# 0xEC00000 (verified: `S + 0x60000` has zero live users):
#   WPJS  0x60000  49152 x 8B   disp32 SOURCE cps
#   WPNR  0xC0000   4096 x 24B  (cp, len, cum) NOP runs + 4096 records of merge scratch
#   WPSW  0xF0000   4096 x 16B  (table_cp, nent) switch jump tables
# Measured on a cycc self-compile: 32,438 sources, 2,079 runs. Overflow sets a flag and the
# whole pass declines — never a partial repair. CHANGELOG [6.5.68]
var _wpjs_n = 0;      # disp32 sources recorded
var _wpjs_ovf = 0;
var _wpnr_n = 0;      # NOP runs recorded
var _wpnr_ovf = 0;
var _wpsw_n = 0;      # switch jump tables recorded
var _wpsw_ovf = 0;
var _wp_fn_js0 = 0;   # WPJS watermark at the current fn's start
var _wp_fn_sw0 = 0;   # WPSW watermark at the current fn's start
var _wp_deleted = 0;

# ⚠ The entry-trampoline form, which must record UNCONDITIONALLY. `IR_SENABLE` runs after the
# trampoline is emitted (main.cyr), so at that moment `IR_ENABLED` is 0 even under CYRIUS_IR=3 —
# gating this one would drop the single site nothing else repairs.
fn _wpjs_add_raw(S, cp): i64 {
    if (_wpjs_n < 49152) { S64(S + 0x60000 + _wpjs_n * 8, cp); _wpjs_n = _wpjs_n + 1; }
    else { _wpjs_ovf = 1; }
    return 0;
}
# ⭐ GATED ON IR: `wp_compact` only runs under `CYRIUS_IR`, so recording on a default build is
# pure cost with no consumer. The first cut recorded unconditionally and taxed EVERY compile —
# measured 686 -> 712 ms self_compile, +3.8 %, for a feature no default build uses.
# ⚠ ANY FUTURE SECOND CONSUMER MUST WIDEN THIS GATE. v6.5.71 added a `CYRIUS_DCE=1` compaction
# and spent a debugging cycle on an empty registry before noticing that this line — correct when
# written — silently disabled the machinery for the new caller. See
# `docs/development/issues/2026-09-06-dce-nop-fill-does-not-eliminate.md`.
fn _wpjs_add(S, cp): i64 {
    if (IR_ENABLED(S) == 0) { return 0; }
    return _wpjs_add_raw(S, cp);
}
fn _wpnr_add(S, cp, ln): i64 {
    if (ln <= 0) { return 0; }
    if (_wpnr_n < 4096) {
        S64(S + 0xC0000 + _wpnr_n * 24, cp);
        S64(S + 0xC0000 + _wpnr_n * 24 + 8, ln);
        S64(S + 0xC0000 + _wpnr_n * 24 + 16, 0);
        _wpnr_n = _wpnr_n + 1;
    } else { _wpnr_ovf = 1; }
    return 0;
}
fn _wpsw_add(S, table_cp, nent): i64 {
    if (IR_ENABLED(S) == 0) { return 0; }
    if (_wpsw_n < 4096) {
        S64(S + 0xF0000 + _wpsw_n * 16, table_cp);
        S64(S + 0xF0000 + _wpsw_n * 16 + 8, nent);
        _wpsw_n = _wpsw_n + 1;
    } else { _wpsw_ovf = 1; }
    return 0;
}

var _codebuf_cap = 0;
# v6.4.51: the final output image (ELF/Mach-O/PE) is emitted here — an off-heap,
# lazy-mapped 1 GiB `alloc()` set per-driver, replacing the fixed 16 MiB in-heap
# region at S+0x4D9D000 (which capped a large single-translation-unit test binary
# — thoth hit 16.78 MB). Off-heap because it sits mid-heap (regions above it) so
# it couldn't grow in place; lazy overcommit means only touched pages cost RAM.
# Every emit/fixup/write site reaches the buffer through this base. CHANGELOG [6.4.51].
var _output_base = 0;
# The output buffer's real capacity, set per-driver: 1 GiB when the off-heap
# `alloc` succeeds (Linux), else 16 MiB when it falls back to the fixed
# S+0x4D9D000 region (macOS/Windows, whose allocators can't yet produce a >256 MiB
# single region — a dedicated large-alloc path is the v6.4.52 follow-up; see
# issue 2026-07-11-macos-windows-large-single-allocation-path.md). `_check_output_cap`
# keys on this so the cap always matches the actual buffer.
var _output_cap = 0;
fn _codebuf_grow(S): i64 {
    var nc = _codebuf_cap + 8388608;   # v6.4.49: +8 MiB linear steps (was *2)
    if (nc > 67108864) {
        syscall(SYS_WRITE, 2, "error: codebuf exceeds 64 MiB (program too large)\n", 50);
        syscall(SYS_EXIT, 1);
    }
    var nb = alloc(nc);
    var used = GCP(S);
    var i = 0;
    while (i < used) { store64(nb + i, load64(_codebuf_base + i)); i = i + 8; }
    _codebuf_base = nb;
    _codebuf_cap = nc;
    return 0;
}

# End-of-compile soft capacity warnings (85% on the fixed tables, 75% on the
# code buffer). v4.8.3-alpha2 shipped these inline in the x86-Linux + Win64
# drivers only; v6.4.50 extracts them here so ALL 7 drivers share one impl —
# aarch64/macho/cx emitted ZERO capacity warnings before (why thoth's codebuf
# warning surfaced only on x86). Suppressed under CYRIUS_STATS=1 (drivers that
# print full stats already showed the numbers). `codebuf_cap` is this target's
# code-region ceiling and `codebuf_growable` its message form: the 6 native
# forks pass (67108864, 1) — the 64 MiB growable off-heap buffer; cx passes
# (524288, 0) — its fixed 512 KiB region at 0x54A000, which never grows.
# Fork-agnostic by construction: every metric is read through its accessor
# (GFNC/GNPOS/GVCNT/GFCNT/GSPOS/GCP), no hardcoded S+offset. CHANGELOG [6.4.50].
fn _capacity_warnings(S, codebuf_cap, codebuf_growable): i64 {
    if (_read_env("CYRIUS_STATS") == 0) {
        # v6.4.75 — warn against the true hard ceiling (32768 = _fnt_grow's max),
        # NOT the live _fnt_cap. Pre-.75 this divided by _fnt_cap, which DOUBLES as
        # the table grows (8192→16384→32768): so the warning screamed "99%" at 8191
        # fns and then went SILENT the instant the table grew (9000/16384 = 54%) —
        # and back then 8192 was a real corruption cliff, so the silence coincided
        # exactly with the danger. The six side tables that made 8192 a cliff are
        # fixed (they now run to the ceiling too), so the honest signal is distance to the
        # hard error, which no longer moves. v6.5.40 raised that ceiling 32768 -> 131072.
        # ⚠ EVERY denominator below must equal the LIVE cap. Three have been stale here at
        # different times (code_size until v6.4.73 reported 269 %, identifiers and var_table
        # until v6.5.40), so `tests/gates/memory/capacity_meter_denominators.sh` derives all
        # six from the caps rather than trusting these literals.
        if (GFNC(S) * 100 / 131072 >= 85) {
            syscall(SYS_WRITE, 2, "warning: fn_table at ", 21);
            PRNUM(GFNC(S) * 100 / 131072);
            syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GFNC(S));
            syscall(SYS_WRITE, 2, "/131072) — approaching the hard fn limit; split into compilation units\n", 73);
        }
        if (GNPOS(S) * 100 / 8388608 >= 85) {
            syscall(SYS_WRITE, 2, "warning: identifier buffer at ", 30);
            PRNUM(GNPOS(S) * 100 / 8388608);
            syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GNPOS(S));
            syscall(SYS_WRITE, 2, "/8388608 bytes) — reduce includes or split soon\n", 50);
        }
        if (GVCNT(S) * 100 / 1048576 >= 85) {
            syscall(SYS_WRITE, 2, "warning: var_table at ", 22);
            PRNUM(GVCNT(S) * 100 / 1048576);
            syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GVCNT(S));
            syscall(SYS_WRITE, 2, "/1048576) — too many globals + locals\n", 40);
        }
        if (GFCNT(S) * 100 / 1048576 >= 85) {
            syscall(SYS_WRITE, 2, "warning: fixup_table at ", 24);
            PRNUM(GFCNT(S) * 100 / 1048576);
            syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GFCNT(S));
            syscall(SYS_WRITE, 2, "/1048576) — too many cross-fn refs\n", 37);
        }
        if (GSPOS(S) * 100 / 2097152 >= 85) {
            syscall(SYS_WRITE, 2, "warning: string_data at ", 24);
            PRNUM(GSPOS(S) * 100 / 2097152);
            syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GSPOS(S));
            syscall(SYS_WRITE, 2, "/2097152 bytes)\n", 16);
        }
        if (GCP(S) * 100 / codebuf_cap >= 75) {
            syscall(SYS_WRITE, 2, "warning: code buffer at ", 24);
            PRNUM(GCP(S) * 100 / codebuf_cap);
            if (codebuf_growable != 0) {
                syscall(SYS_WRITE, 2, "% of 64 MiB ceiling (", 21); PRNUM(GCP(S));
                syscall(SYS_WRITE, 2, " bytes, +8 MiB/grow)\n", 21);
            } else {
                syscall(SYS_WRITE, 2, "% of the 512 KiB cx region (", 28); PRNUM(GCP(S));
                syscall(SYS_WRITE, 2, " bytes)\n", 8);
            }
        }
    }
    return 0;
}

# v5.11.37: relocated from parse_fn.cyr to util.cyr so that
# backend emit.cyr files (included before parse_*.cyr in
# main_*.cyr) can resolve C-string-named functions — e.g.
# aarch64 emit.cyr's polyfill-dispatch named ops (EF64_EXP,
# EF64_LN, EF64_LOG2) need to look up `_f64_*_polyfill` fn
# indices at parse time. The implementation is unchanged from
# parse_fn.cyr's version.
fn _FINDFN_CSTR(S, str_ptr, str_len): i64 {
    var fc = GFNC(S);
    var fi = 0;
    while (fi < fc) {
        var sn = L64(_fnt_names + fi * 8);
        var i = 0;
        var eq = 1;
        while (i < str_len) {
            if (load8(S + 0xEC00000 + sn + i) != load8(str_ptr + i)) {
                eq = 0;
                i = str_len;
            } else {
                i = i + 1;
            }
        }
        if (eq == 1) {
            if (load8(S + 0xEC00000 + sn + str_len) == 0) {
                return fi;
            }
        }
        fi = fi + 1;
    }
    return 0 - 1;
}
fn GINFN(S): i64 { return L64(S + 0x18DA08); }
fn SINFN(S, v): i64 { S64(S + 0x18DA08, v); return 0; }
fn GFLC(S): i64 { return L64(S + 0x18DA10); }
# CVE-24 (v6.1.40): cap the per-fn stack-slot count. SFLC counts FRAME SLOTS
# (a `stack var buf[N]` registers N/8 fillers), and the four slot-indexed local
# tables — fn_local_names/local_depths/local_types/local_slice_widths, relocated
# to S+0x5D9D000.. (4×128 KB) — hold 16384 slots each. Fire before the
# 16384th-slot write overflows the table.
fn SFLC(S, v): i64 {
    if (v >= 16384) {
        syscall(SYS_WRITE, 2, "error: too many stack slots in one function (max 16384)\n", 56);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x18DA10, v);
    return 0;
}
# GRPC/SRPC retired at v6.0.7 — return-patch storage moved off the fixed
# 256-slot array at S + 0x18DA20 and onto rp_vec (lib/vec.cyr). The 2 KB
# array region [0x18DA20..0x18E220) and the counter slot at S + 0x18E220
# were FREED at v6.0.88 (dead init writes removed) — see CHANGELOG [6.0.88].
# Inline metadata accessors (GFBE getter removed — unused;
# SFBE is the only direction the inliner needs.)
fn GFBS(S, fi): i64 { return L64(_fnt_bodystart + fi * 8); }
fn SFBS(S, fi, v): i64 { S64(_fnt_bodystart + fi * 8, v); return 0; }
fn SFBE(S, fi, v): i64 { S64(_fnt_bodyend + fi * 8, v); return 0; }
fn GFINL(S, fi): i64 { return L64(_fnt_inline + fi * 8); }
fn SFINL(S, fi, v): i64 { S64(_fnt_inline + fi * 8, v); return 0; }
# v6.3.9 (F-fns): per-fn generic type-param accessors. GFTP returns 0 (no tparams)
# when the table is unallocated (the non-generic default), so callers never special-
# case. SFTP lazy-allocs the table (max fn cap) on first use — only ever reached under
# _MONOMORPH_OK with a `fn foo<T>` definition present.
# v6.5.52 — per-fn INLINE PARAM TYPES, for the inline-replay path.
#
# WHY THIS EXISTS. The replay re-registers a callee's params as temporary locals BY NAME
# ONLY (`GFINL` packs the two name offsets and nothing else), so the param loses its type
# inside the inlined body — and it binds them to ADJACENT 8-BYTE SLOTS, which silently
# overruns for anything wider. Both defects are invisible until a 16-byte param arrives:
# ONE SIMD param inlines fine, TWO SIGSEGV the compiler, and one-SIMD-plus-one-int reports
# a bogus "value-form SIMD arg type mismatch". This table is what lets the replay allocate
# slots by WIDTH and re-apply the SLTYPE.
#
# ⚠ `_fnt_simdmask` was checked first and is NOT sufficient, though it is close: its 2 bits
# per param give the ABI class (128b / 256b / f32v4) and therefore the slot width, but not
# the sentinel — code 1 covers f64v2 AND every 16-byte integer vector, which have different
# sids. Re-applying the wrong sentinel is a wrong-type bug rather than a crash, so it would
# have been the worse failure. Widths could come from the mask; the sentinel could not.
#
# Encoding: two 16-bit fields, param 0 low. Each holds `desc + 1`, where
# `desc = (0 - sltype) - 2048` is the vector descriptor (0..255 per the band layout above);
# 0 means "this param is not a vector". Storing desc rather than the raw negative sentinel
# keeps the pack sign-free.
#
# Lazy-alloc'd at the max fn cap exactly like _fnt_tparams — deliberately NOT a fixed heap
# region, so this adds no heap-map entry, no fork edit and no `_fnt_grow` copy row.
var _fnt_inlpt = 0;
fn GFIPT(S, fi): i64 { if (_fnt_inlpt == 0) { return 0; } return L64(_fnt_inlpt + fi * 8); }
fn SFIPT(S, fi, v): i64 { if (_fnt_inlpt == 0) { _fnt_inlpt = alloc(131072 * 8); } S64(_fnt_inlpt + fi * 8, v); return 0; }

# Unpack param `which` (0|1) from a GFIPT word -> SLTYPE sentinel, or 0 if not a vector.
fn _ipt_sltype(packed, which): i64 {
    var f = packed & 0xFFFF;
    if (which == 1) { f = (packed >> 16) & 0xFFFF; }
    if (f == 0) { return 0; }
    return 0 - ((f - 1) + 2048);
}

# Slot count for a param SLTYPE: vectors are 2 (128-bit) or 4 (256-bit), everything else 1.
fn _ipt_slots(S, sltype): i64 {
    if (sltype == 0) { return 1; }
    if (_vec_desc(S, sltype) == 1) { return GVEC_NSLOTS(S); }
    return 1;
}

fn GFTP(S, fi): i64 { if (_fnt_tparams == 0) { return 0; } return L64(_fnt_tparams + fi * 8); }
fn SFTP(S, fi, v): i64 { if (_fnt_tparams == 0) { _fnt_tparams = alloc(131072 * 8); } S64(_fnt_tparams + fi * 8, v); return 0; }
# v6.3.10 (instantiate-once): the base fn's `fn`-keyword token index (lazy-alloc'd).
fn GFDS(S, fi): i64 { if (_fnt_defstart == 0) { return 0; } return L64(_fnt_defstart + fi * 8); }
fn SFDS(S, fi, v): i64 { if (_fnt_defstart == 0) { _fnt_defstart = alloc(131072 * 8); } S64(_fnt_defstart + fi * 8, v); return 0; }
# v6.3.11 (G): per-fn async flag (lazy-alloc'd, 0 = not async / table unallocated).
fn GFAS(S, fi): i64 { if (_fnt_is_async == 0) { return 0; } return L64(_fnt_is_async + fi * 8); }
fn SFAS(S, fi, v): i64 { if (_fnt_is_async == 0) { _fnt_is_async = alloc(131072 * 8); } S64(_fnt_is_async + fi * 8, v); return 0; }
# v6.5.0 Phase 1 (public/private visibility): per-fn ORIGIN FILE, so a call can later
# be judged same-file or cross-file. Stored as `FM_FILEID(decl line) + 1`, following
# the _fnt_defstart "+1, 0 = unrecorded" idiom, because every raw FM_FILEID value is
# itself meaningful and 0 would otherwise be ambiguous with "main source":
#     0   unrecorded (table unallocated, or fn registered outside a definition —
#         e.g. a forward reference created by a call site before the definition)
#     1   main source          (raw 0)
#     2.. included file id-2   (raw 1..)
#     -1+1 == 0 is NOT produced: an overflowed map yields raw -1, which is stored as
#         0 and therefore reads back as UNRECORDED — the fail-closed direction, since
#         an unrecorded fn can never be proven same-file. See FM_FILEID's warning.
#
# Lazy-alloc'd at the MAX fn cap (32768 slots) exactly like _fnt_tparams, NOT a fixed
# heap band. That is the v6.4.75 P0 contract: six fn-indexed tables were left at fixed
# 8192-slot bands where index 8192 aliased index 0 of the NEIGHBOUR table, silently
# corrupting both. A new fn-indexed table must either ride _fnt_grow or allocate for
# the full 32768 ceiling up front; this does the latter, so it needs no fork edit and
# no change to the grow chain.
# v6.5.0 Phase 2b — per-GLOBAL-VAR visibility. The committed design covers `fn` AND
# `var`, so a `private` file hides its globals too.
#
# ONE table, not two: it stores `origin_fileid + 1` ONLY for a var that is private,
# and 0 otherwise. So 0 means "public, a local, or unrecorded" and a non-zero value is
# both the private marker and the owning file. That avoids a second 8 MB table purely
# to hold one bit, and it makes locals free — they are never stamped, so they read 0
# and the check skips them without needing to know about scopes at all.
#
# ⚠ Lazy-alloc'd at the var-grow HARD CAP (1048576 slots). It must NEVER join the
# `_grow_g1..g7` chain: util.cyr records that adding an 8th link DESYNCED cybs — gen1
# mis-grew the var tables into the adjacent enum table and died with "enum table
# full". `_vsgn_base` solved that by allocating max-sized at init in all 7 forks;
# lazy-alloc gets the same guarantee with no fork edit at all, and costs nothing on
# the overwhelmingly common build where no file opts in.
var _var_fileid = 0;
fn GVFI(S, vi): i64 { if (_var_fileid == 0) { return 0; } return L64(_var_fileid + vi * 8); }
fn SVFI(S, vi, v): i64 { if (_var_fileid == 0) { _var_fileid = alloc(1048576 * 8); } S64(_var_fileid + vi * 8, v); return 0; }

var _fnt_fileid = 0;
fn GFFI(S, fi): i64 { if (_fnt_fileid == 0) { return 0; } return L64(_fnt_fileid + fi * 8); }
fn SFFI(S, fi, v): i64 { if (_fnt_fileid == 0) { _fnt_fileid = alloc(131072 * 8); } S64(_fnt_fileid + fi * 8, v); return 0; }
# v6.3.10 (generic structs): per-struct (0-based si) type-params (packed, like
# _fnt_tparams) + the `struct`-keyword token (defstart+1; 0=unrecorded). Lazy-alloc'd
# at 1024 slots (the struct cap). Used to instantiate `Box<Point>` by re-invoking
# PARSE_STRUCT_DEF on the base's tokens with T bound.
var _struct_tparams = 0;
var _struct_defstart = 0;
fn GSTP(S, si): i64 { if (_struct_tparams == 0) { return 0; } return L64(_struct_tparams + si * 8); }
fn SSTP(S, si, v): i64 { if (_struct_tparams == 0) { _struct_tparams = alloc(1024 * 8); } S64(_struct_tparams + si * 8, v); return 0; }
fn GSDS(S, si): i64 { if (_struct_defstart == 0) { return 0; } return L64(_struct_defstart + si * 8); }
fn SSDS(S, si, v): i64 { if (_struct_defstart == 0) { _struct_defstart = alloc(1024 * 8); } S64(_struct_defstart + si * 8, v); return 0; }
# v6.3.9 (F-fns): the ACTIVE generic-instantiation binding — up to 2 type-params,
# each {name-offset -> CANONICAL concrete-type token}. The token: <0 = scalar of
# width -tok (i64=-8, i32=-4, i16=-2, i8=-1); >0 = struct sid (1-based, FINDSTRUCT
# form); 0 = unbound (so `_tp_cN != 0` is the live-slot test, cheap-guarding the 4
# resolution-site consults). Scoped: bound right before a generic body replay,
# cleared after. Default (_MONOMORPH_OK=0) leaves all four at 0 → every consult is
# a no-op → byte-identical.
var _tp_n0 = 0;
var _tp_c0 = 0;
var _tp_n1 = 0;
var _tp_c1 = 0;
fn _tp_clear(S): i64 { _tp_n0 = 0; _tp_c0 = 0; _tp_n1 = 0; _tp_c1 = 0; return 0; }
fn _tp_bind(S, slot, noff, conc): i64 {
    if (slot == 0) { _tp_n0 = noff; _tp_c0 = conc; }
    if (slot == 1) { _tp_n1 = noff; _tp_c1 = conc; }
    return 0;
}
# Resolve a type-name offset against the active binding → canonical token, or 0 if
# noff isn't a bound type-param. Callers cheap-guard with `if (_tp_c0 != 0)` first.
fn _tp_resolve(S, noff): i64 {
    if (_tp_c0 != 0) { if (noff == _tp_n0) { return _tp_c0; } }
    if (_tp_c1 != 0) { if (noff == _tp_n1) { return _tp_c1; } }
    return 0;
}
# Fn code-end offset (v4.4.0 DCE). Set at end of PARSE_FN_DEF to the GCP
# where the fn body finishes. Paired with fn code starts at 0x1C4000.
# 0 means "not recorded" (fn was registered but never defined, or emitted
# via a path that bypasses the recording site).
fn GFNE(S, fi): i64 { return L64(_fnt_codeend + fi * 8); }
fn SFNE(S, fi, v): i64 { S64(_fnt_codeend + fi * 8, v); return 0; }

# v5.5.36 Phase 2b — per-fn struct return ID. 0 = scalar return,
# sid = returns StructName. Set by PARSE_FN when signature has
# `: StructName` annotation; consulted at PARSE_RETURN to emit
# the by-value copy and at call sites to pre-allocate caller-
# side struct space + pass &space as hidden first arg in
# RDI (SysV) or RCX (Win64).
fn GFRS(S, fi): i64 { if (_fnret_base == 0) { return 0; } return L64(_fnret_base + fi * 8); }
fn SFRS(S, fi, v): i64 { if (_fnret_base == 0) { _fnret_base = alloc(131072 * 8); } S64(_fnret_base + fi * 8, v); return 0; }

# v6.5.21 — per-fn MULTI-VALUE return record, for `fn f(a, b): (f64, f64)`.
# GFRS holds the marker MULTIRET_SID (0 - 40); the arity and the per-element
# types live here. Two lazily-allocated side tables, the `_fnt_tparams` /
# `_fnret_base` shape (v6.4.75): `alloc()` is OFF the fixed heap map, so adding
# these is NOT a heap-LAYOUT change and needs no two-step bootstrap.
# Arity is known at the DECLARATION, which is the whole point — a fn may mix
# `return 5;` and `return (a, b);` in different branches, and a forward call has
# no body parsed yet, so scanning bodies could never give the call site an answer.
# GFRT's element codes are `_classify_return_type` values (0 = plain i64).
# 4 slots per fn (max arity 3) keeps the index arithmetic a shift-friendly *4.
fn GFRN(S, fi): i64 { if (_fnretn_base == 0) { return 0; } return L64(_fnretn_base + fi * 8); }
fn SFRN(S, fi, v): i64 { if (_fnretn_base == 0) { _fnretn_base = alloc(131072 * 8); } S64(_fnretn_base + fi * 8, v); return 0; }
fn GFRT(S, fi, k): i64 { if (_fnrett_base == 0) { return 0; } return L64(_fnrett_base + (fi * 4 + k) * 8); }
fn SFRT(S, fi, k, v): i64 { if (_fnrett_base == 0) { _fnrett_base = alloc(131072 * 4 * 8); } S64(_fnrett_base + (fi * 4 + k) * 8, v); return 0; }

# v5.5.36 Phase 3 — per-fn variadic marker. 0 = fixed-arity;
# 1 = `fn f(a, ...)` (ellipsis terminator on the param list).
fn SFVA(S, fi, v): i64 { if (_fnvar_base == 0) { _fnvar_base = alloc(131072 * 8); } S64(_fnvar_base + fi * 8, v); return 0; }
# v6.2.41 — getter for the variadic marker (was write-only). Read by the
# call-site arity check in PARSE_FNCALL to exempt variadic callees.
fn GFVA(S, fi): i64 { if (_fnvar_base == 0) { return 0; } return L64(_fnvar_base + fi * 8); }
# Per-fn #regalloc flag (v4.8.4-alpha4). 0 = default ABI, 1 = opt-in
# to callee-saved hot-local allocation. Set when `#regalloc` precedes
# a `fn` definition; read by codegen in subsequent alphas.
fn GFRA(S, fi): i64 { if (_fnreg_base == 0) { return 0; } return L64(_fnreg_base + fi * 8); }
fn SFRA(S, fi, v): i64 { if (_fnreg_base == 0) { _fnreg_base = alloc(131072 * 8); } S64(_fnreg_base + fi * 8, v); return 0; }

# v6.4.75 — accessors for the three fn-indexed tables that previously used raw
# `S + 0xNNNNNN + fi * 8` at their call sites (fn_flags, fn_deprecated_msg,
# fn_var_bytes). Same lazy-alloc-at-max-cap shape as the accessors above, so the
# raw sites become GFLG/SFLG/GFDM/SFDM/GFVB/SFVB and the fixed heap bands retire.
fn GFLG(S, fi): i64 { if (_fnflg_base == 0) { return 0; } return L64(_fnflg_base + fi * 8); }
fn SFLG(S, fi, v): i64 { if (_fnflg_base == 0) { _fnflg_base = alloc(131072 * 8); } S64(_fnflg_base + fi * 8, v); return 0; }
fn GFDM(S, fi): i64 { if (_fndep_base == 0) { return 0; } return L64(_fndep_base + fi * 8); }
fn SFDM(S, fi, v): i64 { if (_fndep_base == 0) { _fndep_base = alloc(131072 * 8); } S64(_fndep_base + fi * 8, v); return 0; }
fn GFVB(S, fi): i64 { if (_fnvb_base == 0) { return 0; } return L64(_fnvb_base + fi * 8); }
fn SFVB(S, fi, v): i64 { if (_fnvb_base == 0) { _fnvb_base = alloc(131072 * 8); } S64(_fnvb_base + fi * 8, v); return 0; }

# v5.11.64 — static-init literal value for `var X = INT_LITERAL ;`
# gvars detected by PARSE_GVAR_REG. FIXUP-time emit paths read these
# and pre-write into the var area, eliminating the runtime store
# sequence and fixing the kmode-entry init-order bug filed at
# docs/development/issues/2026-05-18-gvar-init-order-zero-reads.md.
# Zero == not statically initialized (BSS-zero already correct, so
# leave the runtime emit path in place — observable behavior is
# identical, no need to fork).
fn GVSI(S, vi): i64 { return L64(_vgsi_base + vi * 8); }
# v5.11.64 — stable mirror of FIXUP's prefix-sum table. Each entry
# is the byte offset of var vi within the var area (post m128
# alignment padding for size > 8 vars). Written in lockstep with
# the codebuf-fixup `pfx` scratch at 0x4D9D000+131072 (latter gets
# clobbered once output writing passes 128 KB into output_buf).
fn GVOFF(S, vi): i64 { return L64(_vgoff_base + vi * 8); }

# v5.11.64 — apply gvar static-init values to the var area at the
# given output offset `bss_o`. Called by each EMIT_* emit fn after
# its var-area zero-fill loop completes. Iterates the gvar table;
# any var with a recorded non-zero literal gets an 8-byte store at
# its byte offset, overwriting the zeros. Vars without static init
# (or with size != 8, e.g. arrays) are left zero — the array byte-
# list path (PARSE_GVAR_ARR + EMIT_GVAR_INITS) keeps its existing
# runtime-store handling, since per-byte arrays don't suffer the
# kmode-entry init-order bug (the store sequence is the workaround
# the user already writes by hand).
fn _EMIT_GVAR_STATIC_INITS(S, O, bss_o): i64 {
    var gvc = GVCNT(S);
    var gvi = 0;
    while (gvi < gvc) {
        var siv = GVSI(S, gvi);
        if (siv != 0) {
            var vsize = L64(_vars_base + gvi * 8);
            # v6.3.35: also write the static-init literal for sub-i64 globals. The
            # `vsize == 8` gate skipped narrow globals entirely, so `var G: i32 = 40`
            # left G zero in the file image (the load then read 0). Write the value at
            # the var's width (the load reads the same width from the same offset).
            if (vsize == 8) {
                S64(O + bss_o + GVOFF(S, gvi), siv);
            } elif (vsize == 4) {
                store32(O + bss_o + GVOFF(S, gvi), siv & 0xFFFFFFFF);
            } elif (vsize == 2) {
                store16(O + bss_o + GVOFF(S, gvi), siv & 0xFFFF);
            } elif (vsize == 1) {
                store8(O + bss_o + GVOFF(S, gvi), siv & 0xFF);
            }
        }
        gvi = gvi + 1;
    }
    return 0;
}

fn GIDEP(S): i64 { return L64(S + 0x1903E8); }
fn SIDEP(S, v): i64 { S64(S + 0x1903E8, v); return 0; }
# (GLVR/SLVR for r12 loop-var cache removed — the feature was
# reverted in v3.3.12 after a 2x perf regression; the 0x1903F8 slot is now
# owned by init_offset / elf_out_len (see src/main.cyr heap map).)
# Extra condition patches (for && chaining)
fn GXPC(S): i64 { return L64(S + 0x18F888); }
fn SXPC(S, v): i64 { S64(S + 0x18F888, v); return 0; }
fn ADDXP(S, p): i64 {
    var c = GXPC(S);
    if (c >= 8) {
        syscall(SYS_WRITE, 2, "error: too many && conditions (max 8)\n", 38);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x18F848 + c * 8, p);
    SXPC(S, c + 1);
    return 0;
}

# Line tracking
fn GCLINE(S): i64 { return L64(S + 0x18FCB8); }
fn SCLINE(S, v): i64 { S64(S + 0x18FCB8, v); return 0; }
# v6.4.60 (DX): tok_lines packs the token-start byte offset (into preprocess_out)
# in the high 32 bits + the line number in the low 32. GTLINE masks to the line
# (all ~30 readers use it purely as a line number); GTOFF reads the offset for the
# column + source-excerpt. STLINE writes the whole packed word (ADDTOK builds it).
fn GTLINE(S, ti): i64 { return L64(S + 0xCC00000 + ti * 8) & 0xFFFFFFFF; }
fn GTOFF(S, ti): i64 { return L64(S + 0xCC00000 + ti * 8) >> 32; }
fn STLINE(S, ti, v): i64 { S64(S + 0xCC00000 + ti * 8, v); return 0; }

# Block scoping
fn GSDEP(S): i64 { return L64(S + 0x18FCC0); }
fn SSDEP(S, v): i64 { S64(S + 0x18FCC0, v); return 0; }
fn GLDEP(S, li): i64 { return L64(S + 0x5DBD000 + li * 8); }
fn SLDEP(S, li, v): i64 { S64(S + 0x5DBD000 + li * 8, v); return 0; }

# Expression type tracking
fn GESTYPE(S): i64 { return L64(S + 0x1903D8); }
fn SESTYPE(S, v): i64 { S64(S + 0x1903D8, v); return 0; }
# Variable index of last struct expression (for address-based operator dispatch)
fn GESVAR(S): i64 { return L64(S + 0x1903E0); }
fn SESVAR(S, v): i64 { S64(S + 0x1903E0, v); return 0; }

# Module system. (GPUB/SPUB were scaffolded for the `pub` visibility check
# in docs/development/module-manifest-design.md but never wired up in the
# compiler — removed to stop tracking dead state. The 0x18FED0
# pub_flags region remains reserved in the heap map.)
fn GMOD(S): i64 { return L64(S + 0x18FEC8); }
fn SMOD(S, v): i64 { S64(S + 0x18FEC8, v); return 0; }
fn GUSEC(S): i64 { return L64(S + 0x1903D0); }
fn SUSEC(S, v): i64 { S64(S + 0x1903D0, v); return 0; }

fn SCOPE_PUSH(S): i64 { SSDEP(S, GSDEP(S) + 1); return 0; }
fn SCOPE_POP(S): i64 {
    # Mark out-of-scope locals as invisible by clearing their names.
    # Do NOT change GFLC — stack slots are permanent for the function frame.
    var dep = GSDEP(S);
    var lc = GFLC(S);
    var si = lc - 1;
    while (si >= 0) {
        if (GLDEP(S, si) >= dep) {
            # Mark as dead so FINDLOCAL won't match
            S64(S + 0x5D9D000 + si * 8, 0 - 1);
        }
        si = si - 1;
    }
    SSDEP(S, dep - 1);
    return 0;
}

# Pointer scale tracking (0 = not a pointer, >0 = element size in bytes)
fn GPSC(S): i64 { return L64(S + 0x18F890); }
fn SPSC(S, v): i64 { S64(S + 0x18F890, v); return 0; }
fn GLTYPE(S, li): i64 { return L64(S + 0x5DDD000 + li * 8); }
fn SLTYPE(S, li, v): i64 { S64(S + 0x5DDD000 + li * 8, v); return 0; }

# v5.8.14 §6 — TYPE_SLICE element-type tracking.
# Parallel-array stash for slice-typed locals: 576 entries × 8B,
# matching fn_local_names / local_types extent. Stores element
# byte-width per slice local (0 = not a slice, 1=u8, 2=u16,
# 4=u32, 8=i64/ptr, 16=u128). Read by §7 bounds-aware indexing
# (`s[i]` lowering picks load*/store* width from this) and §8
# dot-syntax field access (.ptr returns pointer-to-element type).
fn GSLICE_W(S, li): i64 { return L64(S + 0x5DFD000 + li * 8); }
fn SSLICE_W(S, li, w): i64 { S64(S + 0x5DFD000 + li * 8, w); return 0; }

# v6.4.3+ (SIMD arc, Phase 1) — structured SIMD vector descriptor decoder.
# A SIMD vector local/param/return is tagged by a NEGATIVE SLTYPE sentinel. ALL vector
# types (f64v2/f64v4/f32v4/f32v8 + the int lanes) live in a reserved band BELOW -2048
# — collision-free because struct sids cap at 1024 (parse_types.cyr), so their pscale
# (0-sid) never reaches -2048. (v6.4.14 moved f64v2/f64v4 off the old flat -20/-21,
# which collided with struct-ids 20/21.) `desc = (0 - sltype) - 2048` packs the shape:
#   bit 0     is_float (1 = float lanes, 0 = integer lanes)
#   bit 1     signed   (integer lanes only; float = 0)
#   bits 2-4  lane_log2  = log2(lane byte-width): i8=0,i16=1,i32/f32=2,i64/f64=3
#   bits 5-7  lanes_log2 = log2(lane count): 2 lanes=1, 4 lanes=2, 8 lanes=3
# f32v4 = is_float 1, lane_log2 2, lanes_log2 2 -> desc 73 -> sentinel -2121.
# _vec_desc(S, sltype) returns 1 if sltype is a vector (results in the _vd_* globals),
# else 0. Called only for SIMD sentinels, never for structs (guarded by the caller).
var _vd_nslots = 0;      # 16-byte/128b vec = 2, 32-byte/256b = 4
var _vd_lane_bytes = 0;  # per-lane byte width (f32 = 4, f64 = 8)
var _vd_is_float = 0;    # 1 = float lanes, 0 = integer lanes
var _vd_signed = 0;      # v6.4.6 (Phase 3): 1 = signed integer lanes, 0 = unsigned (float = 0)
fn _vec_desc(S, sltype): i64 {
    # v6.4.14: f64v2/f64v4 now live in the descriptor band (desc 45 -> -2093,
    # desc 77 -> -2125) like every other vector; the old flat -20/-21
    # special-cases were removed because they collided with struct-ids 20/21.
    if (sltype <= 0 - 2048) {
        var neg = 0 - sltype;
        var desc = neg - 2048;
        _vd_is_float = desc & 1;
        _vd_signed = (desc >> 1) & 1;
        var lane_log2 = (desc >> 2) & 7;
        var lanes_log2 = (desc >> 5) & 7;
        _vd_lane_bytes = 1 << lane_log2;
        var total = _vd_lane_bytes << lanes_log2;
        _vd_nslots = (total + 7) / 8;
        return 1;
    }
    return 0;
}
# Getters for the last _vec_desc decode.
fn GVEC_NSLOTS(S): i64 { return _vd_nslots; }
fn GVEC_LANEB(S): i64 { return _vd_lane_bytes; }
fn GVEC_ISFLOAT(S): i64 { return _vd_is_float; }
fn GVEC_SIGNED(S): i64 { return _vd_signed; }

# v6.4.6 (Phase 3a) — descriptor-driven register-class predicates. The value-form
# SIMD ABI treats ALL 128-bit vectors identically (1 XMM: param/return/receive) and
# all 256-bit vectors identically (2 XMM). These replace the ~21 f32v4-hardcoded
# `== -2121` (and f64v2 `== -20`) checks so integer vectors (i32v4/i16v8/i8v16/i64v2,
# all 16 B) share the same machinery. v6.4.14 folded f64v2/f64v4 into the descriptor
# band too (-2093/-2125), so every vector now routes through the single `<= -2048`
# decode — no flat sentinels remain. (These call _vec_desc, which sets the _vd_*
# globals — a boolean-class query; callers needing the full decode re-call _vec_desc.)
fn _is_simd128(S, pscale): i64 {
    if (pscale <= 0 - 2048) {
        if (_vec_desc(S, pscale) == 1) { if (_vd_nslots == 2) { return 1; } }
    }
    return 0;
}
fn _is_simd256(S, pscale): i64 {
    if (pscale <= 0 - 2048) {
        if (_vec_desc(S, pscale) == 1) { if (_vd_nslots == 4) { return 1; } }
    }
    return 0;
}
# 1 if pscale is ANY SIMD vector sentinel (128b or 256b, float or int).
# v6.4.14: f64v2/f64v4 fold into the band; no more flat -20/-21.
fn _is_simd_any(S, pscale): i64 {
    if (pscale <= 0 - 2048) { return 1; }
    return 0;
}

# v6.5.52 — does this fn take a SIMD-typed parameter? Admits the value-form SIMD wrappers to
# the inline-replay path WITHOUT enabling general inlining (default-off for a MEASURED reason:
# +25.6 % on cycc at v1.11.3 — ⛔ re-taken at v6.5.63 and that figure is now unquotable: a
# cycc built with `_INLINE_OK = 1` dies with "function exceeds 1023 jump targets (x86 LASE
# cap)", so general inlining does not compile the compiler and there is no size to compare.
# `#inline` (token 163, v6.5.63) is the opt-in route). Inlining is a PREREQUISITE for SIMD register residency, not a
# nicety — a value chain emits a `call` per link and every xmm is caller-saved under SysV, so
# each intermediate is provably spilled and reloaded until the calls go away.
fn _fn_has_simd_param(S, pc): i64 {
    # v6.5.58 — THIS SCANNED SLOTS [0, pc) AND A WIDE PARAM IS NOT IN THAT RANGE.
    # A parameter wider than 8 bytes occupies `slots` consecutive locals: (slots-1) anonymous
    # fillers (name sentinel -1) and THEN its named slot, which is the one carrying the SLTYPE.
    # So param k's type lives at an index that grows with every wide param before it, and the
    # old `i < pc` window contained it only when `slots-1 < pc` — i.e. ONLY for the two-128-bit-
    # param case. A single 128-bit param (named slot 1, window {0}) and every 256-bit param
    # (4 slots) were missed, so `f64v4_add(a, b)` — the family this arc was filed about — was
    # never admitted to the inline-replay path and still emitted a `call` per chain link.
    #
    # ⭐ SAME OFF-BY-SLOT BUG v6.5.52 FIXED IN `SFINL`, left unfixed in the gate that decides
    # whether to look. Fixing the consumer of a slot index and not the predicate guarding it
    # leaves the feature dark for exactly the inputs the predicate mis-scans.
    #
    # Walk named slots instead of a fixed window: fillers carry the -1 sentinel, so counting
    # named slots reaches parameter k's own slot whatever the widths before it were.
    var seen = 0;
    var i = 0;
    var flc = GFLC(S);
    while (seen < pc) {
        if (i >= flc) { return 0; }
        if (L64(S + 0x5D9D000 + i * 8) != 0 - 1) {
            if (_is_simd_any(S, GLTYPE(S, i)) == 1) { return 1; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    return 0;
}

# (TWIDTH type-width helper removed — every call site now inlines
# the byte-width decision directly for single-dispatch code paths.)

# Expression width tracking (0=untyped/i64, 1=i8, 2=i16, 4=i32)
fn GEXW(S): i64 { return L64(S + 0x1903F0); }
fn SEXW(S, v): i64 { S64(S + 0x1903F0, v); return 0; }

# Print a number to stderr (decimal)
fn PRNUM(n): i64 {
    var buf[24];
    var i = 23;
    var neg = 0;
    # i64::MIN — see lib/fmt.cyr:fmt_int. Diagnostic-only here, but it is the same
    # defect and the roadmap's seven-site list never named the two in-compiler ones.
    # Kept inside the existing body (no new globals or calls) so cybs still compiles it
    # — this file is on the seed path. CHANGELOG [6.5.8]
    if (n < 0) { neg = 1; }
    if (n == 0) { store8(&buf + i, 48); i = i - 1; }
    while (n != 0) {
        var d = n % 10;
        if (d < 0) { d = 0 - d; }
        store8(&buf + i, 48 + d);
        i = i - 1;
        n = n / 10;
    }
    if (neg == 1) { store8(&buf + i, 45); i = i - 1; }
    syscall(SYS_WRITE, 2, &buf + i + 1, 23 - i);
    return 0;
}

# Print a null-terminated string to stderr
fn PRSTR(s): i64 {
    var i = 0;
    while (load8(s + i) != 0) { i = i + 1; }
    syscall(SYS_WRITE, 2, s, i);
    return 0;
}

# v6.4.77 — printable names for the BUILTIN / INTRINSIC token types.
#
# WHY THIS IS SEPARATE FROM TOKNAME: 51 entries means 51 string-literal (global)
# references. cybs — the bootstrap assembler-compiler the 29 KB seed assembles —
# mis-compiles a fn with too many global references (the same limit that forced
# `_var_grow` into the `_grow_g1.._grow_g7` tail-call chain; see this file's grow
# chain and CLAUDE.md's Release Gate item 2). Folding these into TOKNAME's existing
# ~48 literals risked the seed chain, so they live here and TOKNAME delegates.
#
# It is ALSO the single source of truth: `IS_KEYWORD_TOK` derives from this table
# rather than repeating the list, so the "is it reserved?" set and the "what is it
# called?" set can never drift apart. Returns 0 for a non-builtin token.
#
# THE BUG THIS FIXES (issue 2026-07-17-iv-simd-intrinsic-shadows-var-name):
# every one of these 51 tokens was missing from BOTH TOKNAME and IS_KEYWORD_TOK,
# which stopped at token 111. So `var iv_add = 1;` reported
#   error: expected identifier, got unknown
# — pointing at a syntactically clean identifier and calling it "unknown". It cost
# hisab its whole 312-assertion suite, found only by bisection. Filed for
# iv_add/iv_sub/iv_mul; the real surface is all 51 (syscall, load8/16/32/64,
# store8/16/32/64, the f64_*/f64v_*/f32_*/f32v_*/f32v8_*/iv_* intrinsics, union,
# defer, secret, async, await, u128, bitget/bitset/bitclr, ret2/rethi).
#
# COUNT NOTE: 67, not the 51 a first pass finds. The lexer has TWO keyword paths —
# `LEXKW_EXT` (lex.cyr:740, which `return`s a token) and the inline ADDTOK chain
# (lex.cyr:900+) — and names longer than 8 chars are matched by a u64 compare PLUS
# per-byte `load8` tails, so they never appear as a single decodable literal. Any
# regex sweep over one path or over 8-byte literals alone silently under-counts by
# 16 (f64_floor/f64_round/f64v_sqrt/f64v_fmadd/f64v_scale/f64v_axpy/f32v_fmadd/
# f32v8_*). Each entry below was confirmed by compiling `var <name> = 1;`.
fn TOKNAME_BUILTIN(typ): i64 {
    if (typ == 24) { return "syscall"; }
    if (typ == 25) { return "load8"; }
    if (typ == 26) { return "store8"; }
    if (typ == 42) { return "load16"; }
    if (typ == 43) { return "load32"; }
    if (typ == 44) { return "load64"; }
    if (typ == 45) { return "store16"; }
    if (typ == 46) { return "store32"; }
    if (typ == 47) { return "store64"; }
    if (typ == 62) { return "f64_add"; }
    if (typ == 63) { return "f64_sub"; }
    if (typ == 64) { return "f64_mul"; }
    if (typ == 65) { return "f64_div"; }
    if (typ == 66) { return "f64_from"; }
    if (typ == 67) { return "f64_to"; }
    if (typ == 68) { return "f64_eq"; }
    if (typ == 69) { return "f64_lt"; }
    if (typ == 70) { return "f64_gt"; }
    if (typ == 71) { return "f64_neg"; }
    if (typ == 80) { return "f64_abs"; }
    if (typ == 81) { return "f64_floor"; }
    if (typ == 82) { return "f64_ceil"; }
    if (typ == 83) { return "f64_sin"; }
    if (typ == 84) { return "f64_cos"; }
    if (typ == 85) { return "f64_exp"; }
    if (typ == 86) { return "f64_ln"; }
    if (typ == 87) { return "f64_log2"; }
    if (typ == 88) { return "f64_exp2"; }
    if (typ == 89) { return "f64v_add"; }
    if (typ == 90) { return "f64v_sub"; }
    if (typ == 91) { return "f64v_mul"; }
    if (typ == 92) { return "f64_round"; }
    if (typ == 93) { return "f64v_div"; }
    if (typ == 94) { return "f64v_sqrt"; }
    if (typ == 95) { return "f64v_abs"; }
    if (typ == 96) { return "f64v_fmadd"; }
    if (typ == 97) { return "ret2"; }
    if (typ == 98) { return "rethi"; }
    if (typ == 99) { return "f64_atan"; }
    if (typ == 101) { return "union"; }
    if (typ == 102) { return "bitget"; }
    if (typ == 103) { return "bitset"; }
    if (typ == 104) { return "bitclr"; }
    if (typ == 105) { return "u128"; }
    if (typ == 106) { return "defer"; }
    if (typ == 108) { return "secret"; }
    if (typ == 128) { return "f64v_dot"; }
    if (typ == 129) { return "f64v_scale"; }
    if (typ == 130) { return "f64v_axpy"; }
    if (typ == 131) { return "f32_from"; }
    if (typ == 132) { return "f32_to"; }
    if (typ == 134) { return "async"; }
    if (typ == 135) { return "await"; }
    if (typ == 138) { return "f32v_add"; }
    if (typ == 139) { return "f32v_sub"; }
    if (typ == 140) { return "f32v_mul"; }
    if (typ == 141) { return "f32v_fmadd"; }
    if (typ == 142) { return "f32v_dot"; }
    if (typ == 143) { return "iv_add"; }
    if (typ == 144) { return "iv_sub"; }
    if (typ == 145) { return "iv_mul"; }
    if (typ == 146) { return "iv_dp8"; }
    if (typ == 147) { return "f32v8_add"; }
    if (typ == 148) { return "f32v8_sub"; }
    if (typ == 149) { return "f32v8_mul"; }
    if (typ == 150) { return "f32v8_fma"; }
    if (typ == 151) { return "f32v8_dot"; }
    # v6.5.24 — the 256-bit packed-double kernel. Named for its register width, not its
    # lane count, because the lane-count name (`f64v4_add`) is a pre-existing lib fn; see
    # LEXKW_EXT in src/frontend/lex.cyr. IS_KEYWORD_TOK derives from this table, so these
    # four entries are what actually reserves the names.
    if (typ == 154) { return "f64v256_add"; }
    if (typ == 155) { return "f64v256_sub"; }
    if (typ == 156) { return "f64v256_mul"; }
    if (typ == 157) { return "f64v256_div"; }
    if (typ == 158) { return "f64v256_fmadd"; }   # v6.5.38
    if (typ == 159) { return "f64v256_dot"; }     # v6.5.38
    if (typ == 160) { return "f64v256_scale"; }   # v6.5.38
    if (typ == 161) { return "f64v256_abs"; }     # v6.5.38
    if (typ == 162) { return "f64v256_sqrt"; }    # v6.5.38
    return 0;
}

fn TOKNAME(typ): i64 {
    if (typ == 1) { return "number"; }
    if (typ == 2) { return "identifier"; }
    if (typ == 3) { return "var"; }
    if (typ == 4) { return "'='"; }
    if (typ == 5) { return "';'"; }
    if (typ == 6) { return "'+'"; }
    if (typ == 7) { return "'-'"; }
    if (typ == 8) { return "'*'"; }
    if (typ == 9) { return "'/'"; }
    if (typ == 10) { return "'('"; }
    if (typ == 11) { return "')'"; }
    if (typ == 12) { return "end of file"; }
    if (typ == 13) { return "'{'"; }
    if (typ == 14) { return "'}'"; }
    if (typ == 15) { return "if"; }
    if (typ == 16) { return "while"; }
    if (typ == 17) { return "'=='"; }
    if (typ == 18) { return "'!='"; }
    if (typ == 19) { return "'<'"; }
    if (typ == 20) { return "'>'"; }
    if (typ == 23) { return "else"; }
    if (typ == 28) { return "'['"; }
    if (typ == 29) { return "']'"; }
    if (typ == 30) { return "string"; }
    if (typ == 31) { return "','"; }
    if (typ == 32) { return "fn"; }
    if (typ == 33) { return "return"; }
    if (typ == 40) { return "struct"; }
    if (typ == 41) { return "'.'"; }
    if (typ == 48) { return "asm"; }
    if (typ == 49) { return "':'"; }
    if (typ == 50) { return "elif"; }
    if (typ == 51) { return "break"; }
    if (typ == 52) { return "continue"; }
    if (typ == 55) { return "for"; }
    if (typ == 57) { return "switch"; }
    if (typ == 58) { return "case"; }
    if (typ == 59) { return "default"; }
    if (typ == 60) { return "enum"; }
    if (typ == 72) { return "mod"; }
    # v6.5.0: 73 is now DOUBLE-SPELLED — `pub` and `public` both lex to it. Named
    # together for the same reason tokens 79 and 111 are: v6.4.77 shipped a diagnostic
    # that confidently named the WRONG keyword for every double-assigned token, and
    # "got 'pub'" for source that says `public` is that bug in miniature.
    if (typ == 73) { return "pub'/'public"; }
    if (typ == 153) { return "private"; }   # v6.5.0 file-scoped visibility
    if (typ == 74) { return "use"; }
    if (typ == 75) { return "match"; }
    if (typ == 76) { return "in"; }
    if (typ == 77) { return "impl"; }
    if (typ == 78) { return "shared"; }
    # v6.4.77 — these two token numbers are DOUBLE-ASSIGNED by the lexer, so the
    # spelling cannot be recovered from the token type alone; name both. Verified
    # by decoding every keyword literal in lex.cyr (both the extended-keyword table
    # that `return`s a token and the inline ADDTOK chain): 79 = `object`
    # (lex.cyr:970) AND `f64_sqrt` (lex.cyr:1013); 111 = `stack` (lex.cyr:753) AND
    # `callptr` (lex.cyr:990). They coexist because the grammar disambiguates by
    # POSITION (`object;` is a top-level mode declaration, `f64_sqrt(x)` an
    # expression intrinsic; likewise `stack var b[N];` vs `callptr(...)`), and both
    # spellings still compile correctly — but the diagnostic previously picked one
    # arbitrarily and LIED: `var f64_sqrt = 1;` said "reserved keyword 'object'"
    # and `var callptr = 1;` said "reserved keyword 'stack'". The caret excerpt
    # shows which one the user actually wrote. (The collision itself is filed
    # separately — renumbering touches codegen and is not a diagnostic fix.)
    if (typ == 79) { return "object'/'f64_sqrt"; }
    if (typ == 111) { return "stack'/'callptr"; }
    # v6.4.77: the 51 builtin/intrinsic names live in TOKNAME_BUILTIN (see the note
    # there for the cybs global-reference limit that keeps them out of this fn).
    var bn = TOKNAME_BUILTIN(typ);
    if (bn != 0) { return bn; }
    return "unknown";
}

# v5.8.45: returns 1 iff the current token is the bare ident "kernel".
# Used by main.cyr top-level dispatch to recognize the AGNOS kernel-mode
# switch (`kernel;`) without making `kernel` a reserved word in the lexer.
# Pre-v5.8.45 the lexer emitted token 56 unconditionally, which broke
# any DSP/graphics/AI code using `kernel` as a parameter or local name
# (vidya audio_dsp 11-lang port, 2026-05-03).
fn _TOK_IS_KERNEL(S): i64 {
    if (PEEKT(S) != 2) { return 0; }
    var noff = PEEKV(S);
    var p = S + 0xEC00000 + noff;
    if (load8(p)     != 107) { return 0; }  # 'k'
    if (load8(p + 1) != 101) { return 0; }  # 'e'
    if (load8(p + 2) != 114) { return 0; }  # 'r'
    if (load8(p + 3) != 110) { return 0; }  # 'n'
    if (load8(p + 4) != 101) { return 0; }  # 'e'
    if (load8(p + 5) != 108) { return 0; }  # 'l'
    if (load8(p + 6) != 0)   { return 0; }  # NUL — full match, not "kernel*"
    return 1;
}

# Is this token type a reserved keyword (that a user might mistakenly
# try to use as an identifier)? Used by ERR_EXPECT to print a clearer
# diagnostic when a user writes e.g. `var match = 1;`.
fn IS_KEYWORD_TOK(typ): i64 {
    # v6.5.0 — `private` (153). Listed HERE as well as in TOKNAME because the
    # "derives from TOKNAME_BUILTIN, so they cannot drift" guarantee at the top of
    # this file only covers the BUILTIN/intrinsic table; plain statement keywords are
    # still enumerated separately below. Adding to one and not the other is exactly
    # the drift that note claims is impossible.
    if (typ == 153) { return 1; }   # private
    if (typ == 3)  { return 1; }   # var
    if (typ == 15) { return 1; }   # if
    if (typ == 16) { return 1; }   # while
    if (typ == 23) { return 1; }   # else
    if (typ == 32) { return 1; }   # fn
    if (typ == 33) { return 1; }   # return
    if (typ == 40) { return 1; }   # struct
    if (typ == 48) { return 1; }   # asm
    if (typ == 50) { return 1; }   # elif
    if (typ == 51) { return 1; }   # break
    if (typ == 52) { return 1; }   # continue
    if (typ == 55) { return 1; }   # for
    if (typ == 57) { return 1; }   # switch
    if (typ == 58) { return 1; }   # case
    if (typ == 59) { return 1; }   # default
    if (typ == 60) { return 1; }   # enum
    if (typ == 72) { return 1; }   # mod
    if (typ == 73) { return 1; }   # pub
    if (typ == 74) { return 1; }   # use
    if (typ == 75) { return 1; }   # match
    if (typ == 76) { return 1; }   # in
    if (typ == 77) { return 1; }   # impl
    if (typ == 78) { return 1; }   # shared
    if (typ == 79) { return 1; }   # object / f64_sqrt (double-assigned — see TOKNAME)
    if (typ == 111) { return 1; }  # stack / callptr (double-assigned — see TOKNAME)
    # v6.4.77 — every BUILTIN/INTRINSIC token is reserved too. DERIVED from
    # TOKNAME_BUILTIN rather than repeated here, so this set and the name table
    # cannot drift apart: if a future intrinsic gets a name there, it is reserved
    # here automatically. Before this, all 51 fell through to `return 0` and
    # ERR_EXPECT printed "expected identifier, got unknown" instead of naming them.
    if (TOKNAME_BUILTIN(typ) != 0) { return 1; }
    return 0;
}

# v6.4.62 (DX multi-error): panic-mode recovery state. Declared HERE (util.cyr is
# included by every fork) so the emitters, the PARSE_STMT wrapper, EMITELF's output
# gate, each fork's exit, and the PEEKT anti-hang watchdog all see them. _had_error
# moved here from main.cyr (was main.cyr-only). On VALID input NONE is ever set →
# recovery never fires, the watchdog is inert → the self-compile output is unchanged.
var _had_error = 0;
var _panic = 0;

# ── v6.5.19: `--syntax-only` — answer "does this file PARSE?" without resolution.
#
# THE PROBLEM IT SOLVES (hisab, the residual half of the lint filing). `cyrius lint`
# runs a compiler pre-pass and classifies on the compiler's message. But an undefined
# VARIABLE is a parse-time `SYS_EXIT` — `--allow-undef` only reaches the fixup stage,
# so it cannot downgrade one — and the compiler stops at the FIRST error. So a file
# whose first diagnostic is a resolution failure never reached its syntax errors at
# all, and lint printed `0 warnings`, exit 0, on a file that does not parse. That is
# verbatim the shape the filing reported and v6.5.19 exists to close.
#
# ⛔ WHY NOT JUST MAKE THE RESOLUTION SITES REPORT-AND-CONTINUE (panic-mode). Tried
# first, and it REGRESSED the P1 this release had already fixed. Routing the five
# `undefined variable` sites through `ERR_IDENT` sets `_panic`, and `_sync_skip`
# resyncs to the next `;`/`}` — which lands BEFORE an `else`, so `lib/fs.cyr` (a
# perfectly well-formed file that merely lacks its includes) started reporting
# `unexpected else`. A MANUFACTURED syntax error is indistinguishable from a real one
# to any message-based classifier, so lint went straight back to refusing valid
# downstream source. Gate axis 3 of tests/gates/frontend/lint_reports_unparseable.sh
# caught it. Cascade recovery cannot be the substrate for this question.
#
# WHAT THIS MODE DOES INSTEAD: an unresolved name is not an error and not a panic —
# it RESOLVES to a benign constant, and the parse continues in perfect sync, taking
# exactly the control flow a resolvable name would (`emit; return 0`, the same shape
# as every sibling success path). No message, no `_panic`, no `_sync_skip`, so no
# cascade and no invented syntax error. What survives is the genuine grammar errors,
# which is precisely the question lint needs answered.
#
# Codegen under this flag is deliberately WRONG (every unresolved read is 0) and the
# output must never be used — `cmd_lint` compiles to a temp and unlinks it. It is a
# QUESTION-ANSWERING mode, not a build mode.
#
# Default 0, so `cyrius build` is untouched and the self-host stays byte-identical.
var _syntax_only = 0;
# Anti-hang watchdog state (see _wd_tick / PEEKT).
var _wd_last = 0;
var _wd_stall = 0;
# v6.5.19: past-EOF read counter (see _wd_eof_tick / PEEKT).
var _wd_eof = 0;

# ── v6.5.19 (CVE-40): recursive-descent DEPTH bound.
#
# THE DEFECT. Neither watchdog above can see this one. `_wd_tick` bounds a parse that
# STALLS (GTI stops advancing) and `_wd_eof_tick` bounds reads PAST EOF — but a deeply
# nested source advances GTI at every level and never reads past the end, so both stay
# inert while the native stack runs out. `fn f() { ` repeated 514 times SIGSEGVs cycc;
# so do nested blocks, `if`, `while`, parenthesised expressions, unary-minus chains and
# call chains, at their own depths. Reachable from ordinary untrusted stdin
# (`cat hostile.cyr | cycc`), which is the CVE-32/33 threat model exactly.
#
# PROVEN TO BE STACK EXHAUSTION, NOT A TABLE. The crash depth scales LINEARLY with
# RLIMIT_STACK — 512 at 8 MB, 1026 at 16 MB, 2053 at 32 MB — i.e. ~16 KB of stack per
# nesting level for the `fn` vector, which is the most expensive of the six. Cheaper
# vectors (parens, `if`) cost ~500 B and survive past 16384.
#
# WHY A DEPTH COUNTER AND NOT A STACK-POINTER PROBE. Measuring `&local` against a
# high-water mark would adapt per-vector and is what a C compiler would do, but it
# assumes a single downward-growing native stack — an assumption the cx bytecode target
# does not owe us, and a wrong delta there would FALSE-FIRE on valid input. A counter is
# pure arithmetic and behaves identically on all seven forks.
#
# THE BOUND. 256 levels. Real source nests O(10) — the deepest in cycc's own tree is
# ~12 — so 256 is >20x any legitimate program and cannot false-fire; and at the worst
# observed 16 KB/level it caps stack use at ~4.2 MB, inside the 8 MB default of Linux,
# macOS and aarch64. Windows reserved only 1 MB, which no depth bound above ~60 could
# fit, so `SizeOfStackReserve` was raised to 8 MB in the same patch (src/backend/pe/
# emit.cyr) — reserve is address space, not committed memory, so the cost is nil. The
# bound is worthless without that change and the change is pointless without the bound;
# they ship together.
#
# NO UNWINDING. Like every other guard here, tripping means SYS_EXIT: we are mid-parse,
# before EMITELF, so nothing has been written and every diagnostic already found is
# printed. The counter still decrements on the normal path so a long FLAT file (which is
# not nested at all) can never accumulate its way to the bound.
var _rdepth = 0;

# Called from the two recursive-descent chokepoints — the PARSE_STMT and PEXPR wrappers
# — which between them cover all six crashing vectors. Returns 1 if the caller must not
# descend (it never returns at all once the bound trips, but the shape keeps the call
# sites honest).
fn _rd_enter(S): i64 {
    _rdepth = _rdepth + 1;
    if (_rdepth > 256) {
        syscall(SYS_WRITE, 2, "error:", 6);
        _err_head(S);
        syscall(SYS_WRITE, 2, ": nesting too deep (over 256 levels — truncated or hostile source)\n", 69);
        syscall(SYS_EXIT, 1);
    }
    return 0;
}

fn _rd_exit(): i64 {
    _rdepth = _rdepth - 1;
    return 0;
}

# ── v6.5.7: the include directory of the top-level source (`#@incdir`).
#
# THE PROBLEM. cycc reads its source from STDIN (`cyrius build` dup2's the file
# onto fd 0, cbt/build.cyr:516), so it never learns where that file LIVES, and
# every `include "…"` resolves against the process CWD. Build `src/sub/a.cyr` from
# the project root and its `include "b.cyr"` — a file sitting right next to it —
# does not resolve. Three fixes were considered and two are dead: `chdir` breaks
# the dep prepend (`_materialize_source` emits `include "lib/…"` lines that are
# root-relative), and an env var is unreadable on two targets (`_read_env` is
# stubbed on Windows and cx). What every target DOES read identically is the source
# text itself, so the directory rides in-band as `#@incdir <dir>` on line 1.
#
# WHY IT IS INERT EVERYWHERE ELSE. `#` opens a comment in cyrius, so the marker is
# already ignored by every compiler that does not look for it — older cycc, cybs,
# and the cx/JS forks all skip the line. Nothing needs to be taught to tolerate it.
#
# ⛔ THE SECURITY RULE, AND WHY IT IS NOT NEGOTIABLE. The marker is in-band, so a
# HOSTILE .cyr can write one. If an absolute directory were honoured, `#@incdir
# /home/u/.ssh` + `include "id_rsa"` would reconstruct exactly the read-anything
# primitive CVE-16 was filed to remove. So `PP_SCAN_INCDIR` accepts only a
# RELATIVE, `..`-free directory: composed with an include name that has itself
# already passed the CVE-02/CVE-16 guards, the result is relative and `..`-free,
# i.e. confined to the CWD subtree — provably not one file more than a plain
# relative include could already reach. The CLI relativises an absolute source
# against CWD and emits no marker when it cannot; that path keeps today's
# behaviour rather than buying reach with a hole.
#
# Bounded at 480 on purpose: a top-level `var x[N]` is N*8 bytes under cycc but N
# BYTES under cybs, and this file is on the seed path — 480 is inside 512 either way.
# v6.5.22 — BASE OFFSET of the raw-stdin / preprocessor WORKING buffer.
#
# It was 0 (S + 0) with a 1 MB cap, and that cap became consumer-blocking: sigil's
# bundle is 1,084,265 B, mabda's 1,259,999 B and drishti's 1,403,806 B — all three
# refused with `input exceeds 1MB buffer`. It could not simply grow in place: the
# 0x100000-0x18F830 gap above it is OCCUPIED (fn_name_hash 0x110000, fn_start_hash
# 0x114000, var_noffs 0x11A000, var_sizes 0x12A000, var_types 0x13A000).
#
# So it moved (v6.4.52) into the RETIRED `output_buf` band — 16 MB at 0x4D9D000, contiguous
# immediately above preprocess_out and ending exactly at the locals table. ⚠ THAT PLACEMENT IS
# HISTORY as of v6.5.39: sitting directly on top of preprocess_out is exactly what capped the
# preprocessor at 8 MB, so this buffer moved again, to the arena top, and preprocess_out took
# the vacated band. ⭐ It also retires the old `tok_names`-nested-inside-input_buf hazard
# and its "pool end must stay <= 0x100000" constraint — the buffer no longer
# overlaps tok_names at all.
#
# ⚠ This is the base for RAW INPUT *and* for every preprocessor pass, because the
# passes write to preprocess_out and COPY BACK here (PP_MACRO_PASS). Anything
# reading the source stream reads `S + _SRCB + <offset>`.
# ⭐ v6.5.39 — RELOCATED 0x4D9D000 -> 0x7400000 (the arena top) so `preprocess_out` can grow
# into the 16 MB this vacates. `preprocess_out`'s 8 MB ceiling was a HARD BUILD FAILURE with no
# flag, no env var and no manifest key: a project that hit it could only make its source
# smaller, and in practice that meant hand-vendoring a subset of its dependencies. thoth was at
# ~96 % of the cap before adding anything, and a dozen sibling repos measure 8-12 MB.
#
# ⚠ WHY input_buf MOVED AND preprocess_out DID NOT, which is the whole reason this is a small
# change: `preprocess_out`'s base is a bare literal `0x459D000` at ~90 code sites across 8
# files, while this buffer's base is THIS ONE named constant. Growing preprocess_out in place
# and shifting everything above it would instead have moved `fn_local_names` (60 code sites).
# Same pattern the map already used twice — lexid_entries and the per-fn local tables were both
# relocated to the arena top when they were boxed in.
#
# ⚠ THE TWO CAPS MUST STAY EQUAL. `PP_REF_PASS` copies its expanded output from preprocess_out
# back into THIS buffer, so a preprocess_out larger than _SRC_CAP would overflow the arena.
# `tests/gates/memory/preprocess_arena_caps.sh` fails the build if they diverge.
var _SRCB = 0x7400000;
var _SRC_CAP = 25165824;

var _pp_incdir[512];
var _pp_incdir_len = 0;
# v6.5.21 — `#@pkgver <version>`: the package version cbt resolves from
# `[package].version`, surfaced to source as `CYRIUS_PKG_VERSION`. Same in-band
# shape as `#@incdir` and for the same reason (common/util.cyr's note above): the
# source text is the ONE channel every target reads identically — `_read_env` is
# dead on the PE fork and stubbed on cx, and the macOS forks do not honour the
# CLI-flag scan.
var _pp_pkgver[128];
var _pp_pkgver_len = 0;
# v6.5.34 — where PP_EMIT_PKGVER put the declaration in the expanded buffer, and how long
# it is. PP_PASS revisits that span at its tail: the declaration must be emitted at the TOP
# (a global is NOT visible above its declaration — the assumption that it is, is what sent
# the v6.5.33 attempt at this bug down an append-at-the-end path that could never work),
# but "is it referenced?" cannot be answered until every include has been expanded. So it
# is written optimistically and BLANKED WITH SPACES if the finished unit never names it —
# same byte count, so no line or column moves, and whitespace emits no code, which is what
# `auto_deps_verb_gate.sh` axis 5 actually requires.
var _pp_pkgver_at = 0;
var _pp_pkgver_declen = 0;

# The anti-hang backstop. After the FIRST error, PEEKT calls this every read. A
# desynced parse loop that spins on hostile input reads the SAME token forever →
# GTI stalls; _wd_stall accumulates and, past a bound FAR above any legal recursive-
# descent depth (so it NEVER false-fires on deeply-nested valid code parsed after an
# earlier error), we abort cleanly — every error found is already printed, and no
# output was emitted (we're still mid-parse, before EMITELF). This makes cycc
# provably terminate on ANY stdin (the VR-02 fuzz invariant). Gated on _had_error,
# so it is completely inert until the first error → valid self-compile byte-identical.
fn _wd_tick(S): i64 {
    var g = GTI(S);
    if (g == _wd_last) {
        _wd_stall = _wd_stall + 1;
        if (_wd_stall > 500000) {
            syscall(SYS_WRITE, 2, "error: parser recovery aborted (desync — too many errors)\n", 60);
            syscall(SYS_EXIT, _had_error);
        }
    } else {
        _wd_last = g;
        _wd_stall = 0;
    }
    return 0;
}

# v6.5.19 — THE SECOND BACKSTOP, AND THE ONE THAT IS NOT GATED ON `_had_error`.
#
# `_wd_tick` above only fires after the first error, because it is recovery machinery
# and calling it on every clean-path PEEKT would be a real cost. That gate is what let
# 40 truncated constructs crash or hang at 6.5.18: `SKIP_GENERICS`, `_capture_tparams`
# and the `var`/`match` skippers are SILENT — they consume tokens without emitting any
# diagnostic — so `_had_error` was still 0, the watchdog was inert, and the loop ran
# forever. `fn`, `var x` and `async` SIGSEGV'd with zero bytes of stderr.
#
# This one is called from PEEKT's PAST-EOF branch, unconditionally. That costs nothing
# on a clean compile because a clean compile NEVER takes that branch: LEX appends the
# EOF token (`ADDTOK(S, 12, 0)`, lex.cyr:1730) so the EOF token itself sits at
# GTCNT - 1 and reading it leaves GTI < GTCNT. Past-EOF PEEKT reads on valid input are
# exactly ZERO — measured, not assumed (the self-host is byte-identical either way).
#
# THE BOUND. A legitimate unwind after truncation reads EOF a few times per nesting
# level as each recursive-descent frame checks its terminator and returns; real source
# nests O(100) deep, so O(1000) reads is the plausible ceiling. 20000 is >10x that and
# still small enough to bound a runaway promptly. It is deliberately NOT the 500000 of
# the stall bound: a spinning loop that WRITES a bounded table (the enum member loop
# walks a 1024-entry table off its region) must be stopped in the low thousands, not
# the high hundred-thousands. The loops that write tables also carry their own explicit
# EOF guards now — this is the net beneath them, not a substitute for them.
# The message is deliberately in the STANDARD `error:<file>:<line>:<col>: <msg>` shape
# rather than a bare `error: …`, for two reasons. It is a real diagnostic a user will
# see (a file missing its final `;` reaches it), so it should carry a location like
# every other one. And `cyrius lint`'s pre-pass classifies on the message, matching the
# `unexpected ` prefix through `_lint_capture_has_syntax` — which parses exactly this
# shape and would silently ignore a bare `error:` line, letting lint bless a file that
# does not parse. That is the very defect v6.5.19 exists to close, so the format is
# load-bearing: see `_lint_msg_is_syntax` in cbt/commands.cyr.
fn _wd_eof_tick(S): i64 {
    _wd_eof = _wd_eof + 1;
    if (_wd_eof > 20000) {
        # Rewind the cursor to the LAST REAL token before reporting. `_err_head` reads
        # the token at GTI, and past the end that is zeroed heap — it printed a
        # locationless `error:0:1:`. The EOF token carries the true end-of-file
        # position, which is exactly where "input ended unexpectedly" happened. Safe to
        # clobber GTI: the next statement exits.
        var _wn = GTCNT(S);
        if (_wn > 0) { STI(S, _wn - 1); }
        syscall(SYS_WRITE, 2, "error:", 6);
        _err_head(S);
        syscall(SYS_WRITE, 2, ": unexpected end of input (truncated or unbalanced source)\n", 59);
        syscall(SYS_EXIT, 1);
    }
    return 0;
}

# Skip tokens to the next recovery point after an error: consume up to and INCLUDING
# the next ';' (statement end), or stop AT '}' (block end, token 14) / EOF (token 12)
# so the enclosing block loop still sees its terminator. Bounded by GTCNT — can NEVER
# run past the token array. Clears _panic so parsing resumes clean.
fn _sync_skip(S): i64 {
    var n = GTCNT(S);
    var go = 1;
    while (go == 1) {
        if (GTI(S) >= n) { go = 0; }
        else {
            var t = PEEKT(S);
            if (t == 12) { go = 0; }                       # EOF — stop
            elif (t == 14) { go = 0; }                     # '}' — stop (block loop consumes it)
            elif (t == 5) { STI(S, GTI(S) + 1); go = 0; }  # ';' — consume, then stop
            # v6.5.23 (R2) — STOP AT A STATEMENT-START KEYWORD, without consuming it.
            #
            # Until now recovery only resynced on ';' / '}' / EOF, so an error inside a
            # construct with no ';' before the next statement swallowed whole statements
            # looking for one, and every error they contained was lost. Stopping here
            # lets the statement loop re-enter cleanly at the next real statement.
            #
            # ⛔ `else` (23) and `elif` (50) are DELIBERATELY NOT IN THIS SET, and that
            # omission is the whole reason the earlier attempt at R1 was reverted: they
            # are CONTINUATIONS, not statement starts. Stopping in front of one hands the
            # statement loop a bare `else` with no `if` to attach to, which is exactly the
            # MANUFACTURED `unexpected else` on well-formed `lib/fs.cyr` that made
            # `cyrius lint` refuse valid downstream source. Skip past them like any other
            # token and let the enclosing `if` handler own them.
            elif (t == 32) { go = 0; }                     # fn
            elif (t == 3) { go = 0; }                      # var
            elif (t == 15) { go = 0; }                     # if
            elif (t == 16) { go = 0; }                     # while
            elif (t == 55) { go = 0; }                     # for
            elif (t == 33) { go = 0; }                     # return
            elif (t == 57) { go = 0; }                     # switch
            elif (t == 75) { go = 0; }                     # match
            elif (t == 40) { go = 0; }                     # struct
            elif (t == 60) { go = 0; }                     # enum
            else { STI(S, GTI(S) + 1); }
        }
    }
    _panic = 0;
    return 0;
}

# v6.4.60 (DX diagnostics): derive the 1-based BYTE column of a token from its
# packed start offset (GTOFF) by back-scanning preprocess_out (S+0x459D000) to
# the preceding newline. off==0 (unpacked token / buffer start) → column 1. The
# expanded-buffer column equals the original-source column (the preprocessor
# copies source lines verbatim, inserting only whole #@file marker lines).
fn _err_col(S, off): i64 {
    var ls = off;
    while (ls > 0) {
        if (load8(S + 0x459D000 + ls - 1) == 10) { break; }
        ls = ls - 1;
    }
    return off - ls + 1;
}

# Shared diagnostic location head: prints "<file>:line:col" (NO "error:" /
# "warning:" prefix — each caller writes its own). Routing all five emitters
# through this gives every one of the 432 error sites a column for free.
fn _err_head(S): i64 {
    return _err_head_at(S, GTI(S));
}

# v6.5.19 — the same head for a diagnostic about a token OTHER than the cursor.
# `_err_head` reads GTI(S), which is correct for a parse error (the cursor IS the
# problem) and wrong for a warning raised after the parser has already walked past the
# thing it is describing: the `duplicate fn` warning fires once the fn NAME has been
# consumed, so it used to point at the `(` rather than at the definition.
fn _err_head_at(S, ti): i64 {
    FM_LOOKUP(S, GTLINE(S, ti));
    syscall(SYS_WRITE, 2, ":", 1);
    PRNUM(_err_col(S, GTOFF(S, ti)));
    return 0;
}

# v6.4.60 (DX diagnostics): print the offending source line + a caret under the
# column. Slices the line containing the current token's byte offset out of
# preprocess_out (S+0x459D000, still resident through parse+emit) bounded by
# GBL(S), then writes (col-1) spaces + '^'. off==0 / out-of-range → skip (no
# crash). Byte column — tabs count as 1 (documented caveat). Format:
#     <source line>
#         ^
fn _err_excerpt(S): i64 {
    var off = GTOFF(S, GTI(S));
    var bl = GBL(S);
    if (off == 0) { return 0; }
    if (off >= bl) { return 0; }
    var ls = off;
    while (ls > 0) {
        if (load8(S + 0x459D000 + ls - 1) == 10) { break; }
        ls = ls - 1;
    }
    var le = off;
    while (le < bl) {
        if (load8(S + 0x459D000 + le) == 10) { break; }
        le = le + 1;
    }
    # v6.5.20 — WINDOW a long line. `#derive` now emits its whole generated block on ONE
    # expanded line (the construct's closing-`}` line, which is what makes the block's
    # line accounting exact); a 10-field `#derive(Serialize)` flattens to ~9.5 KB. Printed
    # whole that was ~19 KB of stderr for ONE diagnostic — the line, then one space per
    # column for the caret. Lines up to 200 bytes take the ORIGINAL path byte-for-byte:
    # `lead`/`trail` stay 0, `ws`/`we` stay `ls`/`le`, and the writes are identical.
    var ws = ls;
    var we = le;
    var lead = 0;
    var trail = 0;
    if (le - ls > 200) {
        ws = off - 60;
        if (ws < ls) { ws = ls; }
        we = ws + 160;
        if (we > le) { we = le; }
        if (ws > ls) { lead = 1; }
        if (we < le) { trail = 1; }
    }
    syscall(SYS_WRITE, 2, "    ", 4);
    if (lead == 1) { syscall(SYS_WRITE, 2, "...", 3); }
    syscall(SYS_WRITE, 2, S + 0x459D000 + ws, we - ws);
    if (trail == 1) { syscall(SYS_WRITE, 2, "...", 3); }
    syscall(SYS_WRITE, 2, "\n    ", 5);
    var nsp = off - ws;
    if (lead == 1) { nsp = nsp + 3; }
    var sp = 0;
    while (sp < nsp) { syscall(SYS_WRITE, 2, " ", 1); sp = sp + 1; }
    syscall(SYS_WRITE, 2, "^\n", 2);
    return 0;
}

fn ERRDUPVAR(S): i64 {
    if (_panic == 1) { return 0; }   # v6.4.62: swallow the cascade until _sync_skip resyncs
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": duplicate variable\n", 21);
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}

fn WARN(S, msg, len): i64 {
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": ", 2);
    syscall(SYS_WRITE, 2, msg, len);
    syscall(SYS_WRITE, 2, "\n", 1);
    _err_excerpt(S);
    return 0;
}

fn ERR(S): i64 {
    if (_panic == 1) { return 0; }   # v6.4.62: swallow the cascade until _sync_skip resyncs
    var typ = PEEKT(S);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": unexpected ", 13);
    PRSTR(TOKNAME(typ));
    if (typ == 2) {
        syscall(SYS_WRITE, 2, " '", 2);
        PRSTR(S + 0xEC00000 + PEEKV(S));
        syscall(SYS_WRITE, 2, "'", 1);
    }
    if (typ == 1) {
        syscall(SYS_WRITE, 2, " ", 1);
        PRNUM(PEEKV(S));
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}

# v5.11.54: locate a registered fn by exact byte-match on its name.
# Returns the fn-table index on hit, -1 on miss.
#
# Pre-v5.11.54 the `main` lookup (main.cyr:1338 for fn auto-call)
# and the `efi_main` lookup (main.cyr:1369 for the EFI trampoline)
# were each open-coded as 5-9-deep nested-if byte comparisons —
# same shape, different name. This helper collapses both call
# sites and pre-empts the next "scan fn_names for a magic name"
# pattern.
#
# Used at pass-2 emit time only — the fn-table at S+0x9BA000
# (name offsets into tok_names @ S+0x60000) and S+0x9CA000 (fn
# code offsets) are populated by REGFN during pass 1.
fn _find_fn_by_name(S, name_cstr, name_len): i64 {
    var fc = GFNC(S);
    var fi = 0;
    while (fi < fc) {
        var noff = L64(_fnt_names + fi * 8);
        var eq = 1;
        var ci = 0;
        while (ci < name_len) {
            if (load8(S + 0xEC00000 + noff + ci) != load8(name_cstr + ci)) {
                eq = 0;
                ci = name_len;
            } else {
                ci = ci + 1;
            }
        }
        # Require the next byte to be NUL — guards against names
        # like "mainframe" matching when searching for "main".
        if (eq == 1) {
            if (load8(S + 0xEC00000 + noff + name_len) == 0) {
                return fi;
            }
        }
        fi = fi + 1;
    }
    return 0 - 1;
}

fn ERR_EXPECT(S, expected_type): i64 {
    if (_panic == 1) { return 0; }   # v6.4.62: swallow the cascade until _sync_skip resyncs
    var got = PEEKT(S);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": expected ", 11);
    PRSTR(TOKNAME(expected_type));
    syscall(SYS_WRITE, 2, ", got ", 6);
    # v5.5.26: when the expected token is an identifier and the got
    # token is a reserved keyword, make the diagnostic unambiguous.
    # Previously a user writing `var match = 1;` got "expected
    # identifier, got match" (or worse, "got unknown" for tokens
    # like `in` / `shared` / `default` missing from TOKNAME), leaving
    # them unsure whether the keyword name was misspelled or reserved.
    if (expected_type == 2) {
        if (IS_KEYWORD_TOK(got) == 1) {
            syscall(SYS_WRITE, 2, "reserved keyword '", 18);
            PRSTR(TOKNAME(got));
            syscall(SYS_WRITE, 2, "' (cannot be used as an identifier; rename the variable/field/fn)", 65);
            syscall(SYS_WRITE, 2, "\n", 1);
            _err_excerpt(S);
            _had_error = 1;
            _panic = 1;
            return 0;
        }
    }
    PRSTR(TOKNAME(got));
    if (got == 2) {
        syscall(SYS_WRITE, 2, " '", 2);
        PRSTR(S + 0xEC00000 + PEEKV(S));
        syscall(SYS_WRITE, 2, "'", 1);
    }
    if (got == 1) {
        syscall(SYS_WRITE, 2, " ", 1);
        PRNUM(PEEKV(S));
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    # v5.11.28: when fn-arg parsing surfaces "expected ')' / ',', got string"
    # the underlying cause is often a nested 2-arg call inside another fn-call
    # confusing the parser's arg-list state machine. Stage the inner call
    # into a `var` first as a workaround. See CHANGELOG [5.11.28] + bote
    # 2.7.1 filing.
    if (got == 30) {
        if (expected_type == 11) {
            syscall(SYS_WRITE, 2, "  hint: a string literal where ')' is expected often means a nested call inside a fn argument confused the parser; stage the inner call into a `var` first.\n", 156);
        }
        if (expected_type == 31) {
            syscall(SYS_WRITE, 2, "  hint: a string literal where ',' is expected often means a nested call inside a fn argument confused the parser; stage the inner call into a `var` first.\n", 156);
        }
    }
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}

# v6.5.19 — a NAME-RESOLUTION diagnostic that NAMES the identifier at fault.
#
# WHY IT EXISTS, AND WHY THE MESSAGE CLASS MATTERS. Six struct-field sites in
# parse_decl.cyr reported through `ERR(S)` — i.e. `unexpected ';'`, the SYNTAX
# emitter — for what is a resolution failure. `total = total + e.size;` where the
# struct `e` belongs to is declared in a SIBLING FILE is well-formed cyrius that
# merely lacks context, and calling it a syntax error was wrong twice over:
#   1. it sent the reader hunting for a typo that does not exist, and
#   2. `cyrius lint` classifies on the message CLASS (a lint of ONE file in
#      isolation has no manifest and no lib/, so it cannot key on the exit code —
#      see cbt/commands.cyr `_lint_msg_is_syntax`), so lint REFUSED to lint those
#      files. Measured at 6.5.18 across 472 files in nine repos: 3 refusals, all
#      in stiva — the repo that filed the original "lint never parses" issue.
# Messages emitted here are deliberately NOT of the `unexpected …` / `expected …`
# syntax class, so the classifier's stated invariant ("an `unexpected` message
# means a token the grammar cannot accept") is true again rather than aspirational.
#
# PRSTR everywhere, no explicit lengths: the ERR_MSG(msg, len) shape makes the
# caller hand-count bytes, and a miscount silently truncates or over-reads.
# `tail` = 0 for none; `noff2` = -1 for none (else a second name, quoted).
# CHANGELOG [6.5.19].
fn ERR_IDENT(S, msg, noff, tail, noff2): i64 {
    if (_panic == 1) { return 0; }   # v6.4.62: swallow the cascade until _sync_skip resyncs
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": ", 2);
    PRSTR(msg);
    syscall(SYS_WRITE, 2, "'", 1);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "'", 1);
    if (tail != 0) { PRSTR(tail); }
    if (noff2 >= 0) {
        syscall(SYS_WRITE, 2, "'", 1);
        PRSTR(S + 0xEC00000 + noff2);
        syscall(SYS_WRITE, 2, "'", 1);
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}

fn ERR_MSG(S, msg, len): i64 {
    if (_panic == 1) { return 0; }   # v6.4.62: swallow the cascade until _sync_skip resyncs
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": ", 2);
    syscall(SYS_WRITE, 2, msg, len);
    syscall(SYS_WRITE, 2, "\n", 1);
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}

# ── Compiler-state heap zero-init (v5.8.63) ──────────────────────────
# Writes the post-brk scratch-state region (S+0x18C100..S+0x1903F8 +
# IR state at S+0xF3A000..S+0xF3A028 (5 counters; relocated out of the
# fixup_tbl-overlapping 0x174A0xx band @ v6.1.41) + global-var-init slots) to
# zero, with two sentinel-value exceptions:
#   - 0x18FCB0 = -1 (last_var: initial "no-var" sentinel)
#   - 0x18FCB8 =  1 (cur_line: lexer line counter starts at 1)
# All other slots zeroed.
#
# Universal across all 6 main_*.cyr entry points (main.cyr,
# main_aarch64.cyr, main_aarch64_native.cyr, main_aarch64_macho.cyr,
# main_cx.cyr, main_win.cyr). Pre-v5.8.63 each main inlined this
# ~30-line block; extraction here
# saves ~150 LOC of duplication. The aarch64 and cx mains over-zero
# IR state (they include ir.cyr but don't actively use the IR
# pipeline) — harmless because zero-init matches the post-brk
# kernel-zeroed state, and brk extends through 0x4D9D000 in every
# main (v5.11.68 reorg; was 0x56AD000 pre-.68) so the writes
# land in mapped memory.
fn _HEAP_INIT_SCRATCH(S): i64 {
    # Compiler-state scalars (BL, CP, VCNT, TCNT, TI, NPOS)
    S64(S + 0x18C100, 0);
    S64(S + 0x18C108, 0);
    S64(S + 0x18C110, 0);
    S64(S + 0x18C118, 0);
    S64(S + 0x18C120, 0);
    S64(S + 0x18C128, 0);
    # Function state (fn_count, in_fn, local_cnt)
    # ret_patch_cnt (0x18E220) retired v6.0.88 — see CHANGELOG [6.0.88];
    # return patches migrated to rp_vec at v6.0.7, region now FREED.
    S64(S + 0x18DA00, 0);
    S64(S + 0x18DA08, 0);
    S64(S + 0x18DA10, 0);
    # IR state (cycc — gated by CYRIUS_IR=1 env at runtime; init
    # unconditionally so the gate read sees zero, not garbage)
    S64(S + 0xF3A000, 0);    # ir_node_count
    S64(S + 0xF3A008, 0);    # ir_block_count   (v6.1.41: was 0x174A008, inside fixup_tbl)
    S64(S + 0xF3A010, 0);    # ir_cur_block     (v6.1.41: was 0x174A010)
    S64(S + 0xF3A018, 0);    # ir_edge_count    (v6.1.41: was 0x174A018)
    S64(S + 0xF3A020, 0);    # ir_enabled       (v6.1.41: was 0x174A020)
    # Struct state
    S64(S + 0x18F830, 0);
    # Condition patch state
    S64(S + 0x18F888, 0);
    # Continue forward patch (for-loop, relocated v3.3.12)
    S64(S + 0x18F898, 0);
    # Global-var-init bookkeeping (gvar_cnt + scratch slots)
    S64(S + 0x19A000, 0);
    S64(S + 0x197000, 0);
    S64(S + 0x197F00, 0);
    # Kernel mode
    S64(S + 0x18FCA0, 0);
    # Fixup count
    S64(S + 0x18FCA8, 0);
    # last_var sentinel (-1 = "no var seen yet")
    S64(S + 0x18FCB0, 0 - 1);
    # cur_line (lexer starts at line 1)
    S64(S + 0x18FCB8, 1);
    # Block scoping
    S64(S + 0x18FCC0, 0);
    # str_pos (string write position)
    S64(S + 0x18FCC8, 0);
    # Module system (current_module + use_count)
    S64(S + 0x18FEC8, 0);
    S64(S + 0x1903D0, 0);
    # Expression tracking (stype, var, inline_depth, width)
    S64(S + 0x1903D8, 0);
    S64(S + 0x1903E0, 0);
    S64(S + 0x1903E8, 0);
    S64(S + 0x1903F0, 0);
    return 0;
}
