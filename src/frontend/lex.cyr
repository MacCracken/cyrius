                                                                                                                            while (sgo == 1) {
                                                                                                                                if (p >= bl) { sgo = 0; }
                                                                                                                                # CVE-06: bounds check str_data (2MB at 0x21A000; v5.8.59 was 256KB at 0x14A000)
                                                                                                                                if (spos >= 2097152) {
                                                                                                                                    syscall(SYS_WRITE, 2, "error: string data overflow (2MB limit)\n", 40);
                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                }
                                                                                                                                if (sgo == 1) {
                                                                                                                                    var sc = load8(S + 0x459D000 + p);
                                                                                                                                    if (sc == 34) { p = p + 1; sgo = 0; }
                                                                                                                                    else {
                                                                                                                                        if (sc == 92) {
                                                                                                                                            p = p + 1;
                                                                                                                                            var ec = load8(S + 0x459D000 + p);
                                                                                                                                            p = p + 1;
                                                                                                                                            if (ec == 110)      { store8(S + 0x21A000 + spos, 10); spos = spos + 1; }
                                                                                                                                            elif (ec == 114)    { store8(S + 0x21A000 + spos, 13); spos = spos + 1; }
                                                                                                                                            elif (ec == 116)    { store8(S + 0x21A000 + spos,  9); spos = spos + 1; }
                                                                                                                                            elif (ec == 48)     { store8(S + 0x21A000 + spos,  0); spos = spos + 1; }
                                                                                                                                            elif (ec == 92)     { store8(S + 0x21A000 + spos, 92); spos = spos + 1; }
                                                                                                                                            elif (ec == 34)     { store8(S + 0x21A000 + spos, 34); spos = spos + 1; }
                                                                                                                                            elif (ec == 39)     { store8(S + 0x21A000 + spos, 39); spos = spos + 1; }
                                                                                                                                            elif (ec == 97)     { store8(S + 0x21A000 + spos,  7); spos = spos + 1; }
                                                                                                                                            elif (ec == 98)     { store8(S + 0x21A000 + spos,  8); spos = spos + 1; }
                                                                                                                                            elif (ec == 102)    { store8(S + 0x21A000 + spos, 12); spos = spos + 1; }
                                                                                                                                            elif (ec == 118)    { store8(S + 0x21A000 + spos, 11); spos = spos + 1; }
                                                                                                                                            elif (ec == 120) {
                                                                                                                                                # v5.7.13: \x## - exactly two hex digits.
                                                                                                                                                if (p + 1 >= bl) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\x escape needs two hex digits\n", 33);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                var h1 = _LEX_HEX_VAL(load8(S + 0x459D000 + p));
                                                                                                                                                var h2 = _LEX_HEX_VAL(load8(S + 0x459D000 + p + 1));
                                                                                                                                                if (h1 < 0) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\x escape: bad hex digit\n", 27);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                if (h2 < 0) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\x escape: bad hex digit\n", 27);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                store8(S + 0x21A000 + spos, (h1 << 4) | h2);
                                                                                                                                                spos = spos + 1;
                                                                                                                                                p = p + 2;
                                                                                                                                            }
                                                                                                                                            elif (ec == 117) {
                                                                                                                                                # v5.7.13: \u#### (four hex) or \u{...} (1..6 hex).
                                                                                                                                                var cp = 0;
                                                                                                                                                if (p < bl && load8(S + 0x459D000 + p) == 123) {
                                                                                                                                                    p = p + 1;
                                                                                                                                                    var ndig = 0;
                                                                                                                                                    var udone = 0;
                                                                                                                                                    while (udone == 0) {
                                                                                                                                                        if (p >= bl) {
                                                                                                                                                            syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                            PRNUM(GCLINE(S));
                                                                                                                                                            syscall(SYS_WRITE, 2, ": \\u{...} escape: missing closing brace\n", 40);
                                                                                                                                                            syscall(SYS_EXIT, 1);
                                                                                                                                                        }
                                                                                                                                                        var bc = load8(S + 0x459D000 + p);
                                                                                                                                                        if (bc == 125) { udone = 1; }
                                                                                                                                                        else {
                                                                                                                                                            var hv = _LEX_HEX_VAL(bc);
                                                                                                                                                            if (hv < 0) {
                                                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                                PRNUM(GCLINE(S));
                                                                                                                                                                syscall(SYS_WRITE, 2, ": \\u{...} escape: bad hex digit\n", 32);
                                                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                                                            }
                                                                                                                                                            if (ndig >= 6) {
                                                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                                PRNUM(GCLINE(S));
                                                                                                                                                                syscall(SYS_WRITE, 2, ": \\u{...} escape: > 6 hex digits\n", 33);
                                                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                                                            }
                                                                                                                                                            cp = (cp << 4) | hv;
                                                                                                                                                            ndig = ndig + 1;
                                                                                                                                                            p = p + 1;
                                                                                                                                                        }
                                                                                                                                                    }
                                                                                                                                                    if (ndig == 0) {
                                                                                                                                                        syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                        PRNUM(GCLINE(S));
                                                                                                                                                        syscall(SYS_WRITE, 2, ": \\u{...} escape: no hex digits\n", 32);
                                                                                                                                                        syscall(SYS_EXIT, 1);
                                                                                                                                                    }
                                                                                                                                                    p = p + 1;
                                                                                                                                                } else {
                                                                                                                                                    if (p + 3 >= bl) {
                                                                                                                                                        syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                        PRNUM(GCLINE(S));
                                                                                                                                                        syscall(SYS_WRITE, 2, ": \\u escape needs four hex digits\n", 34);
                                                                                                                                                        syscall(SYS_EXIT, 1);
                                                                                                                                                    }
                                                                                                                                                    var di = 0;
                                                                                                                                                    while (di < 4) {
                                                                                                                                                        var hv = _LEX_HEX_VAL(load8(S + 0x459D000 + p + di));
                                                                                                                                                        if (hv < 0) {
                                                                                                                                                            syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                            PRNUM(GCLINE(S));
                                                                                                                                                            syscall(SYS_WRITE, 2, ": \\u escape: bad hex digit\n", 27);
                                                                                                                                                            syscall(SYS_EXIT, 1);
                                                                                                                                                        }
                                                                                                                                                        cp = (cp << 4) | hv;
                                                                                                                                                        di = di + 1;
                                                                                                                                                    }
                                                                                                                                                    p = p + 4;
                                                                                                                                                }
                                                                                                                                                if (cp > 1114111) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\u escape: codepoint > U+10FFFF\n", 34);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                if (cp >= 55296 && cp <= 57343) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\u escape: surrogate codepoint not allowed\n", 45);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                spos = _LEX_EMIT_UTF8(S, spos, cp);
                                                                                                                                            }
                                                                                                                                            else { store8(S + 0x21A000 + spos, ec); spos = spos + 1; }
                                                                                                                                        } else {
                                                                                                                                            store8(S + 0x21A000 + spos, sc);
                                                                                                                                            spos = spos + 1;
                                                                                                                                            p = p + 1;
                                                                                                                                        }
                                                                                                                                    }
                                                                                                                                }
                                                                                                                            }
                                                                                                                            # Add null terminator after string literal
                                                                                                                            store8(S + 0x21A000 + spos, 0);
                                                                                                                            var slen = spos - sstart;
                                                                                                                            # String interning: check if an identical string already
                                                                                                                            # exists in str_data. If so, reuse its offset — deduplicates string
                                                                                                                            # literals so pointer-identity comparison works.
                                                                                                                            var interned = 0 - 1;
                                                                                                                            var si = 0;
                                                                                                                            while (si < sstart) {
                                                                                                                                var eq = 1;
                                                                                                                                var sk = 0;
                                                                                                                                while (sk <= slen) {
                                                                                                                                    if (load8(S + 0x21A000 + si + sk) != load8(S + 0x21A000 + sstart + sk)) { eq = 0; break; }
                                                                                                                                    sk = sk + 1;
                                                                                                                                }
                                                                                                                                if (eq == 1) { interned = si; si = sstart; }
                                                                                                                                else {
                                                                                                                                    while (si < sstart) { if (load8(S + 0x21A000 + si) == 0) { si = si + 1; break; } si = si + 1; }
                                                                                                                                }
                                                                                                                            }
                                                                                                                            if (interned >= 0) {
                                                                                                                                sstart = interned;
                                                                                                                            } else {
                                                                                                                                spos = spos + 1;
                                                                                                                                if (spos >= 2097152) {
                                                                                                                                    syscall(SYS_WRITE, 2, "error: string data buffer full (2MB limit)\n", 43);
                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                }
                                                                                                                                SSPOS(S, spos);
                                                                                                                            }
                                                                                                                            ADDTOK(S, 30, (sstart << 16) | slen);
                                                                                                                        }
                                                                                                                        else {
                                                                                                                            # Reject non-ASCII bytes outside strings/comments
                                                                                                                            if (c > 127) {
                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                PRNUM(GCLINE(S));
                                                                                                                                syscall(SYS_WRITE, 2, ": non-ASCII byte (0x", 20);
                                                                                                                                # Print hex byte
                                                                                                                                var hi = c >> 4;
                                                                                                                                var lo = c & 15;
                                                                                                                                if (hi < 10) { store8(S, 48 + hi); } else { store8(S, 87 + hi); }
                                                                                                                                syscall(SYS_WRITE, 2, S, 1);
                                                                                                                                if (lo < 10) { store8(S, 48 + lo); } else { store8(S, 87 + lo); }
                                                                                                                                syscall(SYS_WRITE, 2, S, 1);
                                                                                                                                syscall(SYS_WRITE, 2, ") -- only ASCII allowed in source (UTF-8 ok in strings)\n", 56);
                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                            }
                                                                                                                            else {
                                                                                                                                # CVE-31: a stray ASCII byte (`$`, backtick, a control char, ...) that
                                                                                                                                # matched no token was silently skipped, changing program meaning with
                                                                                                                                # no diagnostic -- error now (mirrors the >127 non-ASCII reject above).
                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                PRNUM(GCLINE(S));
                                                                                                                                syscall(SYS_WRITE, 2, ": unexpected character (0x", 26);
                                                                                                                                var hi2 = c >> 4;
                                                                                                                                var lo2 = c & 15;
                                                                                                                                if (hi2 < 10) { store8(S, 48 + hi2); } else { store8(S, 87 + hi2); }
                                                                                                                                syscall(SYS_WRITE, 2, S, 1);
                                                                                                                                if (lo2 < 10) { store8(S, 48 + lo2); } else { store8(S, 87 + lo2); }
                                                                                                                                syscall(SYS_WRITE, 2, S, 1);
                                                                                                                                syscall(SYS_WRITE, 2, ")\n", 2);
                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                            }
                                                                                                                            p = p + 1;
                                                                                                                        }
                                                                                                                    } } } } } } } } } } }
                                                                                } } } } } } } } }
                                            } } } } } } } } }
        }
    }
    ADDTOK(S, 12, 0);
    return 0;
}

# ================================================================
