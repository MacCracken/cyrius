# ================================================================
# LEXER — tokenizes input at S+0 into tok arrays
# ================================================================

# File map: tracks #@file markers for file:line error messages.
# CVE-31 (v6.1.35): relocated into the freed 0x71A000 band (the old 2 MB
# output_buf slot, vacated when .27 moved output_buf to heap-top) so the cap
# could grow 128 → 1024 without colliding with file_map_str; the TS frontend's
# scratch starts at 0x800000, so we stay below it.
# S+0x71A000: entry count (8 bytes)              (was 0x19A100)
# S+0x71A040: entries[1024], each 24 bytes: (start_line, line_count, fname_offset)  (was 0x19A108[128])
# S+0x721000: filename strings (32 KB scratch)   (was 0x19D000[4 KB])

var _fm_count = 0;
var _fm_str_pos = 0;
var _fm_overflowed = 0;

fn FM_BUILD(S): i64 {
    _fm_count = 0;
    _fm_str_pos = 0;
    _fm_overflowed = 0;
    var buf = S + 0x459D000;
    var bl = GBL(S);
    var line = 1;
    var pos = 0;
    # First pass: find all markers and their start lines
    while (pos < bl) {
        if (load8(buf + pos) == 35 && pos + 7 < bl) {
            if (load8(buf + pos + 1) == 64 && load8(buf + pos + 2) == 102 && load8(buf + pos + 3) == 105 && load8(buf + pos + 4) == 108 && load8(buf + pos + 5) == 101 && load8(buf + pos + 6) == 32 && load8(buf + pos + 7) == 34) {
                var fstart = pos + 8;
                var fend = fstart;
                while (fend < bl && load8(buf + fend) != 34) { fend = fend + 1; }
                var flen = fend - fstart;
                if (flen > 0) {
                    if (_fm_count < 1024 && _fm_str_pos + flen + 1 <= 32768) {
                        store64(S + 0x71A040 + _fm_count * 24, line + 1);
                        store64(S + 0x71A040 + _fm_count * 24 + 8, 0);
                        store64(S + 0x71A040 + _fm_count * 24 + 16, _fm_str_pos);
                        var fi = 0;
                        while (fi < flen) {
                            store8(S + 0x721000 + _fm_str_pos + fi, load8(buf + fstart + fi));
                            fi = fi + 1;
                        }
                        store8(S + 0x721000 + _fm_str_pos + flen, 0);
                        _fm_str_pos = _fm_str_pos + flen + 1;
                        _fm_count = _fm_count + 1;
                    } else {
                        # CVE-31: past the cap (or str scratch full), drop the marker
                        # but warn ONCE — silently dropping mis-attributes file:line in
                        # later error messages on big multi-include consumer builds.
                        if (_fm_overflowed == 0) {
                            syscall(SYS_WRITE, 2, "warning: file map full (1024 entries) -- file:line attribution truncated past here\n", 83);
                            _fm_overflowed = 1;
                        }
                    }
                }
            }
        }
        if (load8(buf + pos) == 10) { line = line + 1; }
        pos = pos + 1;
    }
    # Second: compute line counts from start_line gaps
    var i = 0;
    while (i < _fm_count) {
        var start = load64(S + 0x71A040 + i * 24);
        var next_start = 0;
        if (i + 1 < _fm_count) {
            next_start = load64(S + 0x71A040 + (i + 1) * 24);
            store64(S + 0x71A040 + i * 24 + 8, next_start - start - 1);
        } else {
            # Last file: count remaining lines to EOF
            store64(S + 0x71A040 + i * 24 + 8, line - start);
        }
        i = i + 1;
    }
    store64(S + 0x71A000, _fm_count);
    return 0;
}

# Look up file:line for an expanded line number. Prints to stderr.
# Returns 1 if found, 0 if fallback to raw line number.
fn FM_LOOKUP(S, expanded_line): i64 {
    var cnt = load64(S + 0x71A000);
    if (cnt == 0) { PRNUM(expanded_line); return 0; }
    # Find which file contains this line
    var i = 0;
    while (i < cnt) {
        var start = load64(S + 0x71A040 + i * 24);
        var lines = load64(S + 0x71A040 + i * 24 + 8);
        if (expanded_line >= start && expanded_line < start + lines) {
            var foff = load64(S + 0x71A040 + i * 24 + 16);
            var fptr = S + 0x721000 + foff;
            var flen = 0;
            while (load8(fptr + flen) != 0) { flen = flen + 1; }
            syscall(SYS_WRITE, 2, fptr, flen);
            syscall(SYS_WRITE, 2, ":", 1);
            PRNUM(expanded_line - start + 1);
            return 1;
        }
        i = i + 1;
    }
    # Line not in any included file — it's the main source
    PRNUM(expanded_line);
    return 0;
}

# Store a token
fn ADDTOK(S, typ, val): i64 {
    var tc = GTCNT(S);
    if (tc >= 1048576) {
        # v5.8.46 (sit-surfaced): diagnostic prints actual `tc + 1`
        # so the next cap raise can be sized to an empirical M.
        # Cap was 262144 pre-v5.8.46; raised 4× to absorb sandhi-
        # consumer compile pressure (sit v0.7.2 with sandhi in
        # [deps].stdlib threshold-aborted at the 262144 cap).
        # Tok arrays relocated v5.8.46 from the 0x4D9D000 (overlap
        # with output_buf) / 0xD4A000 / 0xF4A000 trio (each 2 MiB
        # at those addresses) to the post-TS-region high block at
        # 0x2D7C000 / 0x357C000 / 0x3D7C000 (each 8 MiB), brk
        # extended to S + 0x457C000 in every main_*.cyr.
        syscall(SYS_WRITE, 2, "error: token limit exceeded: needed ", 36);
        PRNUM(tc + 1);
        syscall(SYS_WRITE, 2, ", cap is 1048576\n", 17);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x2D7C000 + tc * 8, typ);
    S64(S + 0x357C000 + tc * 8, val);
    STLINE(S, tc, GCLINE(S));
    STCNT(S, tc + 1);
    return 0;
}

# Classify character: 0=other, 1=ws, 2=digit, 3=lower, 4=upper, 5=underscore
fn CCLASS(c): i64 {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 10) { return 1; }
    if (c == 13) { return 1; }
    if (c >= 48) { if (c <= 57) { return 2; } }
    if (c >= 97) { if (c <= 122) { return 3; } }
    if (c >= 65) { if (c <= 90) { return 4; } }
    if (c == 95) { return 5; }
    return 0;
}

fn ISALNUM(c): i64 {
    var cl = CCLASS(c);
    if (cl >= 2) { return 1; }
    return 0;
}

# v5.7.13: ASCII hex digit -> value [0..15], or -1 if not a hex digit.
# Used by string-literal `\x##` and `\u####` / `\u{...}` decoders.
fn _LEX_HEX_VAL(c): i64 {
    if (c >= 48) { if (c <= 57) { return c - 48; } }
    if (c >= 97) { if (c <= 102) { return c - 87; } }
    if (c >= 65) { if (c <= 70) { return c - 55; } }
    return 0 - 1;
}

# v5.7.13: emit codepoint cp as UTF-8 into str_data at S+0x21A000+spos.
# Returns the new spos. Callers must reject surrogates (D800-DFFF)
# and codepoints > U+10FFFF before calling.
fn _LEX_EMIT_UTF8(S, spos, cp): i64 {
    var dst = S + 0x21A000;
    var need = 1;
    if (cp >= 128) { need = 2; }
    if (cp >= 2048) { need = 3; }
    if (cp >= 65536) { need = 4; }
    if (spos + need > 2097152) {
        syscall(SYS_WRITE, 2, "error: string data overflow (2MB limit)\n", 40);
        syscall(SYS_EXIT, 1);
    }
    if (cp < 128) {
        store8(dst + spos, cp);
    }
    elif (cp < 2048) {
        store8(dst + spos, 192 | (cp >> 6));
        store8(dst + spos + 1, 128 | (cp & 63));
    }
    elif (cp < 65536) {
        store8(dst + spos, 224 | (cp >> 12));
        store8(dst + spos + 1, 128 | ((cp >> 6) & 63));
        store8(dst + spos + 2, 128 | (cp & 63));
    }
    else {
        store8(dst + spos, 240 | (cp >> 18));
        store8(dst + spos + 1, 128 | ((cp >> 12) & 63));
        store8(dst + spos + 2, 128 | ((cp >> 6) & 63));
        store8(dst + spos + 3, 128 | (cp & 63));
    }
    return spos + need;
}

# ================================================================
# INCLUDE / FILE I/O / PREPROCESSOR
# ================================================================

# Read a file into buffer at dst, return bytes read. Path must be null-terminated.
# Fallback lib path for include resolution (set from CYRIUS_HOME env)
var _cyrius_lib[256];
var _cyrius_lib_len = 0;

fn _init_cyrius_lib(): i64 {
    # v5.5.9: /proc/self/environ readback is Linux-only. On Windows
    # CreateFileW returns INVALID_HANDLE_VALUE for the non-existent
    # path; the `if (efd < 0)` guard below should handle it but in
    # practice cycc_win.exe crashes somewhere in this fn's early
    # syscall chain (exact cause TBD). Gate the whole body on
    # CYRIUS_TARGET_LINUX so Windows gets a no-op that leaves
    # _cyrius_lib empty — include-resolution falls back to CWD,
    # fine for stdin-fed compilation. GetEnvironmentVariableW-based
    # HOME lookup queued for v5.5.x tail.
    #
    # v5.10.9 — version-PINNED lib path. Pre-v5.10.9 the fallback
    # was `$HOME/.cyrius/lib/` which is a symlink to whichever
    # version `cyriusly use` last pointed at. That created a
    # contamination bug: if a user runs cycc v5.10.8 against a
    # symlink pointing at v5.10.6 lib, the codegen emits calls to
    # helpers (str_builder_add_json_str, etc.) that don't exist
    # in the older lib snapshot → undefined-fn warnings → SIGILL.
    # The agnosys agent hit exactly this on real Pi hardware
    # (their pin was 5.10.6; testing 5.10.7+ binaries against
    # 5.10.6 lib produced the SIGILL pattern documented in the
    # 1.1.12 issue file).
    #
    # Fix: each cycc binary loads `$HOME/.cyrius/versions/<MY_VERSION>/
    # lib/` directly, where <MY_VERSION> is extracted from
    # `_VERSION_STR_CYCC` at runtime ("cycc X.Y.Z\n" → "X.Y.Z").
    # Each cycc binary always uses its own version-matched lib;
    # the `~/.cyrius/lib` symlink is no longer consulted (it stays
    # for `cyriusly use` to point `~/.cyrius/bin` at the active
    # version, but lib resolution doesn't go through it).
    #ifdef CYRIUS_TARGET_LINUX
    # Read /proc/self/environ to find HOME=
    var ebuf[4096];
    # v5.11.27: aarch64 has only openat (syscall 56); literal syscall(2,...)
    # gets xlat'd 2→56 but cyrius doesn't reshuffle args, so path lands in
    # dfd slot and dfd=0 in path → EFAULT. Match READFILE's branch — when
    # SYS_OPEN != 2 we're on openat and must pass AT_FDCWD=-100 first.
    var efd = 0;
    if (SYS_OPEN == 2) { efd = syscall(SYS_OPEN, "/proc/self/environ", 0, 0); }
    else { efd = syscall(SYS_OPEN, 0 - 100, "/proc/self/environ", 0, 0); }
    if (efd < 0) { return 0; }
    var elen = syscall(0, efd, &ebuf, 4096);
    syscall(3, efd);
    # Scan for HOME=
    var ei = 0;
    while (ei < elen) {
        if (load8(&ebuf + ei) == 72) {
            if (load8(&ebuf + ei + 1) == 79) {
                if (load8(&ebuf + ei + 2) == 77) {
                    if (load8(&ebuf + ei + 3) == 69) {
                        if (load8(&ebuf + ei + 4) == 61) {
                            # Found HOME=, copy value + /.cyrius/versions/<VERSION>/lib/
                            var hi = ei + 5;
                            var wi = 0;
                            while (hi < elen) {
                                var hc = load8(&ebuf + hi);
                                if (hc == 0) { break; }
                                store8(&_cyrius_lib + wi, hc);
                                wi = wi + 1; hi = hi + 1;
                            }
                            # Append /.cyrius/versions/
                            store8(&_cyrius_lib + wi, 47); wi = wi + 1;   # /
                            store8(&_cyrius_lib + wi, 46); wi = wi + 1;   # .
                            store8(&_cyrius_lib + wi, 99); wi = wi + 1;   # c
                            store8(&_cyrius_lib + wi, 121); wi = wi + 1;  # y
                            store8(&_cyrius_lib + wi, 114); wi = wi + 1;  # r
                            store8(&_cyrius_lib + wi, 105); wi = wi + 1;  # i
                            store8(&_cyrius_lib + wi, 117); wi = wi + 1;  # u
                            store8(&_cyrius_lib + wi, 115); wi = wi + 1;  # s
                            store8(&_cyrius_lib + wi, 47); wi = wi + 1;   # /
                            store8(&_cyrius_lib + wi, 118); wi = wi + 1;  # v
                            store8(&_cyrius_lib + wi, 101); wi = wi + 1;  # e
                            store8(&_cyrius_lib + wi, 114); wi = wi + 1;  # r
                            store8(&_cyrius_lib + wi, 115); wi = wi + 1;  # s
                            store8(&_cyrius_lib + wi, 105); wi = wi + 1;  # i
                            store8(&_cyrius_lib + wi, 111); wi = wi + 1;  # o
                            store8(&_cyrius_lib + wi, 110); wi = wi + 1;  # n
                            store8(&_cyrius_lib + wi, 115); wi = wi + 1;  # s
                            store8(&_cyrius_lib + wi, 47); wi = wi + 1;   # /
                            # Append the version digits from _VERSION_STR_CYCC
                            # ("cycc X.Y.Z\n" — skip first 5 chars "cycc ",
                            # copy until '\n'). v6.0.1: was 4 (correct for
                            # the old "cc5 " prefix), missed at v6.0.0
                            # rename — yielded "/versions/ X.Y.Z/lib/"
                            # (leading space) so the fallback path didn't
                            # exist on FS, stdlib includes failed to
                            # resolve, fncallN bodies went undefined,
                            # fixup emitted ud2 sentinels. See CHANGELOG
                            # [6.0.1].
                            var vp = 5;
                            while (vp < _VERSION_LEN_CYCC) {
                                var vc = load8(_VERSION_STR_CYCC + vp);
                                if (vc == 10) { break; }
                                store8(&_cyrius_lib + wi, vc);
                                wi = wi + 1; vp = vp + 1;
                            }
                            # Append /lib/
                            store8(&_cyrius_lib + wi, 47); wi = wi + 1;   # /
                            store8(&_cyrius_lib + wi, 108); wi = wi + 1;  # l
                            store8(&_cyrius_lib + wi, 105); wi = wi + 1;  # i
                            store8(&_cyrius_lib + wi, 98); wi = wi + 1;   # b
                            store8(&_cyrius_lib + wi, 47); wi = wi + 1;   # /
                            store8(&_cyrius_lib + wi, 0);
                            _cyrius_lib_len = wi;
                            # v5.10.15 — shadow-lib compile warn.
                            # Detect if cwd has its own `lib/` that
                            # would shadow the version-pinned path.
                            # The agnosys 1.1.12 saga (v5.10.7-.10)
                            # spent four slots chasing what turned
                            # out to be a stale shadow lib in the
                            # consumer project folder. This emits a
                            # one-line note so future consumers
                            # catch the resolution choice at compile
                            # time, not at SIGILL.
                            #
                            # Opt-out via CYRIUS_NO_WARN_SHADOW_LIB=1
                            # for cyrius-repo dev workflow (where
                            # cwd `lib/` IS the intended source of
                            # truth) or for any consumer that
                            # knowingly uses a project-local lib.
                            _check_shadow_lib();
                            # v5.11.57: detect cyml pin drift
                            # (iron-boot papercut Item 1).
                            # Wrapper-side drift is invisible to
                            # consumers because wrapper has been
                            # stuck at .25 since May-12 (install.sh
                            # rebuild-staleness misses version_str.cyr
                            # dep). cycc IS current per self-host
                            # discipline, so cycc is the authoritative
                            # surfacer. See CHANGELOG [5.11.57].
                            _check_cyml_pin_drift();
                            return 1;
                        }
                    }
                }
            }
        }
        # Skip to next null
        while (ei < elen) { if (load8(&ebuf + ei) == 0) { break; } ei = ei + 1; }
        ei = ei + 1;
    }
    #endif
    return 0;
}

# v5.10.15 — emit a one-line note to stderr if cwd has a `lib/`
# directory that will shadow the version-pinned path. Called
# once at the end of `_init_cyrius_lib`. Uses sys_open with
# O_RDONLY|O_DIRECTORY to probe `lib/`; if open succeeds we
# know cwd has the shadow.
fn _check_shadow_lib(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    # Opt-out: if CYRIUS_NO_WARN_SHADOW_LIB=1, skip the note.
    var _shadow_env_buf[4096];
    # v5.11.27: aarch64 openat ABI — see _init_cyrius_lib above.
    var _shadow_efd = 0;
    if (SYS_OPEN == 2) { _shadow_efd = syscall(SYS_OPEN, "/proc/self/environ", 0, 0); }
    else { _shadow_efd = syscall(SYS_OPEN, 0 - 100, "/proc/self/environ", 0, 0); }
    if (_shadow_efd < 0) { return 0; }
    var _shadow_elen = syscall(0, _shadow_efd, &_shadow_env_buf, 4096);
    syscall(3, _shadow_efd);
    var _shadow_ei = 0;
    while (_shadow_ei < _shadow_elen) {
        # Look for "CYRIUS_NO_WARN_SHADOW_LIB=1\0" in the env stream.
        # The name is 25 chars; '=' is at offset 25; '1' at offset 26.
        # Cheap two-byte gate first ('C','Y'); full-prefix check on hit.
        if (load8(&_shadow_env_buf + _shadow_ei) == 67) {       # 'C'
            if (load8(&_shadow_env_buf + _shadow_ei + 1) == 89) {   # 'Y'
                if (load8(&_shadow_env_buf + _shadow_ei + 25) == 61) {  # '=' at byte 25
                    if (load8(&_shadow_env_buf + _shadow_ei + 26) == 49) {  # '1' at byte 26
                        # Confirm the full prefix "CYRIUS_NO_WARN_SHADOW_LIB".
                        var _check_str = "CYRIUS_NO_WARN_SHADOW_LIB";
                        var _ck = 0;
                        var _ck_match = 1;
                        while (_ck < 25) {
                            if (load8(&_shadow_env_buf + _shadow_ei + _ck) != load8(_check_str + _ck)) { _ck_match = 0; break; }
                            _ck = _ck + 1;
                        }
                        if (_ck_match == 1) { return 0; }
                    }
                }
            }
        }
        # Skip to next null
        while (_shadow_ei < _shadow_elen) { if (load8(&_shadow_env_buf + _shadow_ei) == 0) { break; } _shadow_ei = _shadow_ei + 1; }
        _shadow_ei = _shadow_ei + 1;
    }
    # Probe cwd `lib/` via O_RDONLY|O_DIRECTORY (0x10000).
    # v5.11.27: aarch64 openat ABI — see _init_cyrius_lib above.
    var _shadow_fd = 0;
    if (SYS_OPEN == 2) { _shadow_fd = syscall(SYS_OPEN, "lib", 0x10000, 0); }
    else { _shadow_fd = syscall(SYS_OPEN, 0 - 100, "lib", 0x10000, 0); }
    if (_shadow_fd < 0) { return 0; }
    syscall(3, _shadow_fd);
    # v5.11.57: content-compare filter. Without this, the note
    # fires on every build when cwd has ./lib/ — even when the
    # directory is empty (the agnosticos/scripts/lib/ case from
    # the iron-boot papercut filing) or contains only project-
    # local files unrelated to stdlib. Filter: probe a canonical
    # stdlib file (alloc.cyr — universally present) in cwd lib/.
    # If absent, cwd lib/ isn't shadowing stdlib at all; skip
    # the note. If present, byte-size-compare against the
    # snapshot's alloc.cyr; only emit when they differ (real
    # drift). See CHANGELOG [5.11.57].
    var _shadow_local_sz = _file_size("lib/alloc.cyr");
    if (_shadow_local_sz < 0) { return 0; }
    var _shadow_snap_path[4096];
    var _shadow_spi = 0;
    while (_shadow_spi < _cyrius_lib_len) {
        store8(&_shadow_snap_path + _shadow_spi, load8(&_cyrius_lib + _shadow_spi));
        _shadow_spi = _shadow_spi + 1;
    }
    store8(&_shadow_snap_path + _shadow_spi + 0, 97);   # a
    store8(&_shadow_snap_path + _shadow_spi + 1, 108);  # l
    store8(&_shadow_snap_path + _shadow_spi + 2, 108);  # l
    store8(&_shadow_snap_path + _shadow_spi + 3, 111);  # o
    store8(&_shadow_snap_path + _shadow_spi + 4, 99);   # c
    store8(&_shadow_snap_path + _shadow_spi + 5, 46);   # .
    store8(&_shadow_snap_path + _shadow_spi + 6, 99);   # c
    store8(&_shadow_snap_path + _shadow_spi + 7, 121);  # y
    store8(&_shadow_snap_path + _shadow_spi + 8, 114);  # r
    store8(&_shadow_snap_path + _shadow_spi + 9, 0);
    var _shadow_snap_sz = _file_size(&_shadow_snap_path);
    if (_shadow_snap_sz == _shadow_local_sz) { return 0; }
    # Drift detected — emit the note.
    syscall(1, 2, "note: cwd ./lib/ shadows version-pinned ", 40);
    syscall(1, 2, &_cyrius_lib, _cyrius_lib_len);
    syscall(1, 2, " — delete ./lib/ to use the version-matched snapshot, or set CYRIUS_NO_WARN_SHADOW_LIB=1 to silence this note\n", 112);
    #endif
    return 0;
}

# v5.11.57: open path, lseek to end, return size. Returns -1 if
# the file doesn't exist. Used by _check_shadow_lib (Item 4) for
# canonical-file byte-size compare against the snapshot.
fn _file_size(path): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var _fs_fd = 0;
    if (SYS_OPEN == 2) { _fs_fd = syscall(SYS_OPEN, path, 0, 0); }
    else { _fs_fd = syscall(SYS_OPEN, 0 - 100, path, 0, 0); }
    if (_fs_fd < 0) { return 0 - 1; }
    # SYS_LSEEK = 8 on x86_64, SEEK_END = 2.
    var _fs_sz = syscall(8, _fs_fd, 0, 2);
    syscall(3, _fs_fd);
    return _fs_sz;
    #endif
    return 0 - 1;
}

# v5.11.57: shared opt-out env probe. Returns 1 if
# /proc/self/environ contains "<name>=1\0", 0 otherwise. Used
# by _check_cyml_pin_drift (CYRIUS_NO_WARN_PIN_DRIFT,
# CYRIUS_STRICT_PIN). The existing _check_shadow_lib inline
# pattern (CYRIUS_NO_WARN_SHADOW_LIB) predates this helper and
# stays inline for byte-identity stability of the surrounding
# code; future cleanup can converge.
fn _env_var_is_1(name, name_len): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var _ev_buf[4096];
    var _ev_fd = 0;
    if (SYS_OPEN == 2) { _ev_fd = syscall(SYS_OPEN, "/proc/self/environ", 0, 0); }
    else { _ev_fd = syscall(SYS_OPEN, 0 - 100, "/proc/self/environ", 0, 0); }
    if (_ev_fd < 0) { return 0; }
    var _ev_len = syscall(0, _ev_fd, &_ev_buf, 4096);
    syscall(3, _ev_fd);
    var _ev_i = 0;
    while (_ev_i < _ev_len) {
        var _ev_start = _ev_i;
        while (_ev_i < _ev_len && load8(&_ev_buf + _ev_i) != 0) { _ev_i = _ev_i + 1; }
        var _ev_entry_len = _ev_i - _ev_start;
        if (_ev_entry_len == name_len + 2) {
            if (load8(&_ev_buf + _ev_start + name_len) == 61) {
                if (load8(&_ev_buf + _ev_start + name_len + 1) == 49) {
                    var _ev_match = 1;
                    var _ev_m = 0;
                    while (_ev_m < name_len) {
                        if (load8(&_ev_buf + _ev_start + _ev_m) != load8(name + _ev_m)) { _ev_match = 0; break; }
                        _ev_m = _ev_m + 1;
                    }
                    if (_ev_match == 1) { return 1; }
                }
            }
        }
        _ev_i = _ev_i + 1;
    }
    #endif
    return 0;
}

# v5.11.57: detect toolchain drift between cwd's
# cyrius.cyml [package].cyrius = "X.Y.Z" pin and cycc's own
# compile-time version. Iron-boot papercut filing Item 1: the
# wrapper has been stuck at .25 since 2026-05-12 (install.sh
# rebuild-staleness misses src/version_str.cyr as transitive
# dep), so consumers see `cyrius --version: 5.11.25` even when
# they pin .55+ in cyml. cycc IS rebuilt every bump for
# self-host, so cycc's compile-time _VERSION_STR_CYCC is the
# authoritative current version. Emitting from cycc surfaces
# the drift regardless of wrapper-rebuild state. Wrapper-side
# fixes (--strict-pin CLI flag, --version manifest-pin line,
# cyrius lib sync, install.sh rebuild fix) land in v5.11.58.
fn _check_cyml_pin_drift(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var _pd_no = "CYRIUS_NO_WARN_PIN_DRIFT";
    if (_env_var_is_1(_pd_no, 24) == 1) { return 0; }
    var _pd_fd = 0;
    if (SYS_OPEN == 2) { _pd_fd = syscall(SYS_OPEN, "cyrius.cyml", 0, 0); }
    else { _pd_fd = syscall(SYS_OPEN, 0 - 100, "cyrius.cyml", 0, 0); }
    if (_pd_fd < 0) { return 0; }
    var _pd_buf[32768];
    var _pd_clen = syscall(0, _pd_fd, &_pd_buf, 32767);
    syscall(3, _pd_fd);
    if (_pd_clen <= 0) { return 0; }
    store8(&_pd_buf + _pd_clen, 0);
    var _pd_pos = 0;
    var _pd_found_pkg = 0;
    while (_pd_pos < _pd_clen - 8) {
        if (load8(&_pd_buf + _pd_pos) == 91) {
            if (load8(&_pd_buf + _pd_pos + 1) == 112) {
                if (load8(&_pd_buf + _pd_pos + 2) == 97) {
                    if (load8(&_pd_buf + _pd_pos + 3) == 99) {
                        if (load8(&_pd_buf + _pd_pos + 4) == 107) {
                            if (load8(&_pd_buf + _pd_pos + 5) == 97) {
                                if (load8(&_pd_buf + _pd_pos + 6) == 103) {
                                    if (load8(&_pd_buf + _pd_pos + 7) == 101) {
                                        if (load8(&_pd_buf + _pd_pos + 8) == 93) {
                                            _pd_found_pkg = 1;
                                            _pd_pos = _pd_pos + 9;
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        _pd_pos = _pd_pos + 1;
    }
    if (_pd_found_pkg == 0) { return 0; }
    var _pd_pin_start = 0 - 1;
    var _pd_pin_end = 0 - 1;
    while (_pd_pos < _pd_clen) {
        while (_pd_pos < _pd_clen && (load8(&_pd_buf + _pd_pos) == 10 || load8(&_pd_buf + _pd_pos) == 32 || load8(&_pd_buf + _pd_pos) == 9 || load8(&_pd_buf + _pd_pos) == 13)) {
            _pd_pos = _pd_pos + 1;
        }
        if (_pd_pos >= _pd_clen) { break; }
        if (load8(&_pd_buf + _pd_pos) == 91) { break; }
        if (_pd_pos + 6 <= _pd_clen) {
            if (load8(&_pd_buf + _pd_pos) == 99) {
                if (load8(&_pd_buf + _pd_pos + 1) == 121) {
                    if (load8(&_pd_buf + _pd_pos + 2) == 114) {
                        if (load8(&_pd_buf + _pd_pos + 3) == 105) {
                            if (load8(&_pd_buf + _pd_pos + 4) == 117) {
                                if (load8(&_pd_buf + _pd_pos + 5) == 115) {
                                    var _pd_after = _pd_pos + 6;
                                    while (_pd_after < _pd_clen && (load8(&_pd_buf + _pd_after) == 32 || load8(&_pd_buf + _pd_after) == 9)) { _pd_after = _pd_after + 1; }
                                    if (_pd_after < _pd_clen && load8(&_pd_buf + _pd_after) == 61) {
                                        _pd_after = _pd_after + 1;
                                        while (_pd_after < _pd_clen && (load8(&_pd_buf + _pd_after) == 32 || load8(&_pd_buf + _pd_after) == 9)) { _pd_after = _pd_after + 1; }
                                        if (_pd_after < _pd_clen && load8(&_pd_buf + _pd_after) == 34) {
                                            _pd_after = _pd_after + 1;
                                            _pd_pin_start = _pd_after;
                                            while (_pd_after < _pd_clen && load8(&_pd_buf + _pd_after) != 34) { _pd_after = _pd_after + 1; }
                                            _pd_pin_end = _pd_after;
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        while (_pd_pos < _pd_clen && load8(&_pd_buf + _pd_pos) != 10) { _pd_pos = _pd_pos + 1; }
    }
    if (_pd_pin_start < 0) { return 0; }
    if (_pd_pin_end <= _pd_pin_start) { return 0; }
    var _pd_pin_len = _pd_pin_end - _pd_pin_start;
    # cycc self-version: skip "cycc " (5 chars), read until '\n'.
    # v6.0.1: was 4 (correct for the old "cc5 " prefix), missed at
    # v6.0.0 rename — substring read started at the trailing space so
    # length-mismatch fired pin-drift warning even when cyml pin and
    # cycc version matched. See CHANGELOG [6.0.1].
    var _pd_self_start = 5;
    var _pd_self_end = _pd_self_start;
    while (_pd_self_end < _VERSION_LEN_CYCC && load8(_VERSION_STR_CYCC + _pd_self_end) != 10) {
        _pd_self_end = _pd_self_end + 1;
    }
    var _pd_self_len = _pd_self_end - _pd_self_start;
    if (_pd_pin_len == _pd_self_len) {
        var _pd_match = 1;
        var _pd_mi = 0;
        while (_pd_mi < _pd_pin_len) {
            if (load8(&_pd_buf + _pd_pin_start + _pd_mi) != load8(_VERSION_STR_CYCC + _pd_self_start + _pd_mi)) { _pd_match = 0; break; }
            _pd_mi = _pd_mi + 1;
        }
        if (_pd_match == 1) { return 0; }
    }
    var _pd_strict_name = "CYRIUS_STRICT_PIN";
    var _pd_strict = _env_var_is_1(_pd_strict_name, 17);
    if (_pd_strict == 1) {
        syscall(1, 2, "error: cyrius.cyml pins ", 24);
        syscall(1, 2, &_pd_buf + _pd_pin_start, _pd_pin_len);
        syscall(1, 2, " but cycc is ", 13);
        syscall(1, 2, _VERSION_STR_CYCC + _pd_self_start, _pd_self_len);
        syscall(1, 2, " — toolchain drift (CYRIUS_STRICT_PIN)\n", 41);
        syscall(60, 1);
    }
    syscall(1, 2, "warning: cyrius.cyml pins ", 26);
    syscall(1, 2, &_pd_buf + _pd_pin_start, _pd_pin_len);
    syscall(1, 2, " but cycc is ", 13);
    syscall(1, 2, _VERSION_STR_CYCC + _pd_self_start, _pd_self_len);
    syscall(1, 2, " — toolchain drift (snapshot may be stale; set CYRIUS_NO_WARN_PIN_DRIFT=1 to silence)\n", 88);
    #endif
    return 0;
}

fn READFILE(path, dst, maxsz): i64 {
    # CVE-02: reject path traversal (.. components) UNLESS explicitly
    # allowed via CYRIUS_ALLOW_PARENT_INCLUDES=1. Bote (and any project
    # with sibling-directory deps via `[deps.X] path = "../foo"`) needs
    # the override; default behavior stays strict for untrusted-source
    # builds. `cyrius build` can set the env automatically when it
    # resolves deps with a relative `..` path.
    var _allow_parent = _read_env("CYRIUS_ALLOW_PARENT_INCLUDES");
    var allow_parent = 0;
    if (_allow_parent != 0) {
        if (load8(_allow_parent) == 49 && load8(_allow_parent + 1) == 0) {
            allow_parent = 1;
        }
    }
    if (allow_parent == 0) {
        var pi = 0;
        while (load8(path + pi) != 0) {
            if (load8(path + pi) == 46 && load8(path + pi + 1) == 46) {
                if (pi == 0 || load8(path + pi - 1) == 47) {
                    syscall(SYS_WRITE, 2, "error: path traversal rejected: ", 32);
                    var plen = 0;
                    while (load8(path + plen) != 0) { plen += 1; }
                    syscall(SYS_WRITE, 2, path, plen);
                    syscall(SYS_WRITE, 2, " (set CYRIUS_ALLOW_PARENT_INCLUDES=1 to permit)\n", 48);
                    # CVE-02/CO-02 (v6.1.41): return -1 so the PP's `nr < 0` guards fire
                    # SYS_EXIT — a rejected hostile include must FAIL the build, not be
                    # treated as a silent empty include (exit 0 after printing 'error:').
                    return 0 - 1;
                }
            }
            pi += 1;
        }
    }
    # CVE-16 (v6.1.33): reject absolute include paths (leading '/') UNLESS
    # CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 — completes the CVE-02 spec (the v4.x fix
    # landed only the '..' half). A hostile `.cyr` could `include "/home/u/.ssh/id_rsa"`
    # and surface the contents via error text / embedded output. The CYRIUS_HOME
    # lib fallback below builds its own absolute path and opens it directly (not
    # through this guard), so it is unaffected.
    var _allow_abs = _read_env("CYRIUS_ALLOW_ABSOLUTE_INCLUDES");
    var allow_abs = 0;
    if (_allow_abs != 0) {
        if (load8(_allow_abs) == 49 && load8(_allow_abs + 1) == 0) {
            allow_abs = 1;
        }
    }
    if (allow_abs == 0) {
        if (load8(path) == 47) {
            syscall(SYS_WRITE, 2, "error: absolute include path rejected: ", 39);
            var alen = 0;
            while (load8(path + alen) != 0) { alen += 1; }
            syscall(SYS_WRITE, 2, path, alen);
            syscall(SYS_WRITE, 2, " (set CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 to permit)\n", 50);
            # CVE-16/CO-02 (v6.1.41): return -1 (fatal) — see the parent-include reject.
            return 0 - 1;
        }
    }
    var fd = 0;
    if (SYS_OPEN == 2) { fd = syscall(SYS_OPEN, path, 0, 0); }
    else { fd = syscall(SYS_OPEN, 0 - 100, path, 0, 0); }
    # Fallback: if open fails and path starts with "lib/", try CYRIUS_HOME/lib/
    if (fd < 0) {
        if (_cyrius_lib_len > 0) {
            if (load8(path) == 108) { if (load8(path + 1) == 105) { if (load8(path + 2) == 98) { if (load8(path + 3) == 47) {
                            # Build fallback path: _cyrius_lib + (path + 4)
                            var fbuf[512];
                            var fi = 0;
                            while (fi < _cyrius_lib_len) { store8(&fbuf + fi, load8(&_cyrius_lib + fi)); fi = fi + 1; }
                            var pi = 4;
                            while (load8(path + pi) != 0) { store8(&fbuf + fi, load8(path + pi)); fi = fi + 1; pi = pi + 1; }
                            store8(&fbuf + fi, 0);
                            if (SYS_OPEN == 2) { fd = syscall(SYS_OPEN, &fbuf, 0, 0); }
                            else { fd = syscall(SYS_OPEN, 0 - 100, &fbuf, 0, 0); }
                        } } } }
        }
    }
    # CVE-31: distinguish open-fail from a legitimately-empty file. Return -1
    # when the path could not be opened (after the CYRIUS_HOME/lib fallback);
    # the PP include sites hard-error on -1. A successfully-opened empty file
    # still returns 0 (a valid, silent no-op include).
    if (fd < 0) { return 0 - 1; }
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = syscall(SYS_READ, fd, dst + total, maxsz - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= maxsz) { rgo = 0; }
        }
    }
    syscall(SYS_CLOSE, fd);
    return total;
}

# Check if buffer at pos starts with "include " (8 chars)
# Check for "#ref " directive (5 bytes: # r e f space)

# v5.5.38: preprocessor (PP_*) passes + predicates extracted.
include "src/frontend/lex_pp.cyr"


fn LEXHEX(S, p): i64 {
    var val = 0;
    var go = 1;
    while (go == 1) {
        if (p >= GBL(S)) { go = 0; }
        if (go == 1) {
            var c = load8(S + 0x459D000 + p);
            # Underscore separator (e.g. 0xDEAD_BEEF) — skip silently.
            if (c == 95) { p = p + 1; }
            else {
                var hd = 0 - 1;
                if (c >= 48) { if (c <= 57) { hd = c - 48; } }
                if (c >= 97) { if (c <= 102) { hd = c - 87; } }
                if (c >= 65) { if (c <= 70) { hd = c - 55; } }
                if (hd >= 0) { val = val << 4 | hd; p = p + 1; }
                else { go = 0; }
            }
        }
    }
    ADDTOK(S, 1, val);
    return p;
}

# v6.0.62: lex an octal literal (0o755). Mirrors LEXHEX but base-8:
# accumulate `val << 3 | digit` over digits 0-7 only; an 8/9 (or any
# non-octal) terminates the literal. Underscore separators (0o7_5_5)
# skipped silently, like hex/decimal.
fn LEXOCT(S, p): i64 {
    var val = 0;
    var go = 1;
    while (go == 1) {
        if (p >= GBL(S)) { go = 0; }
        if (go == 1) {
            var c = load8(S + 0x459D000 + p);
            if (c == 95) { p = p + 1; }
            else {
                var od = 0 - 1;
                if (c >= 48) { if (c <= 55) { od = c - 48; } }
                if (od >= 0) { val = val << 3 | od; p = p + 1; }
                else { go = 0; }
            }
        }
    }
    ADDTOK(S, 1, val);
    return p;
}

# Lex decimal number
fn LEXDEC(S, p): i64 {
    var c = load8(S + 0x459D000 + p);
    var val = c - 48;
    p = p + 1;
    var go = 1;
    while (go == 1) {
        if (p >= GBL(S)) { go = 0; }
        if (go == 1) {
            c = load8(S + 0x459D000 + p);
            # Underscore separator (e.g. 1_000_000) — skip silently.
            if (c == 95) { p = p + 1; }
            elif (c >= 48) {
                if (c <= 57) { val = val * 10 + (c - 48); p = p + 1; }
                else { go = 0; }
            } else { go = 0; }
        }
    }
    # Float literal: digits.digits
    if (p < GBL(S)) { if (load8(S + 0x459D000 + p) == 46) {
            var np = p + 1;
            if (np < GBL(S)) { var nc = load8(S + 0x459D000 + np);
                if (nc >= 48) { if (nc <= 57) {
                        p = np;
                        var frac = 0;
                        var denom = 1;
                        var fgo = 1;
                        while (fgo == 1) {
                            if (p >= GBL(S)) { fgo = 0; }
                            if (fgo == 1) {
                                c = load8(S + 0x459D000 + p);
                                if (c >= 48) { if (c <= 57) {
                                        frac = frac * 10 + (c - 48);
                                        denom = denom * 10;
                                        p = p + 1;
                                    } else { fgo = 0; } }
                                else { fgo = 0; }
                            }
                        }
                        var numer = val * denom + frac;
                        ADDTOK(S, 61, (denom << 32) | (numer & 0xFFFFFFFF));
                        return p;
                    } } }
        } }
    ADDTOK(S, 1, val);
    return p;
}

# Lex a number starting at p, return new p
fn LEXNUM(S, p): i64 {
    var c = load8(S + 0x459D000 + p);
    if (c == 48) {
        if (p + 1 < GBL(S)) {
            if (load8(S + 0x459D000 + p + 1) == 120) {
                return LEXHEX(S, p + 2);
            }
            if (load8(S + 0x459D000 + p + 1) == 111) {
                return LEXOCT(S, p + 2);
            }
        }
    }
    return LEXDEC(S, p);
}

# Extended keyword check (klen >= 4). Returns token or 0.
fn LEXKW_EXT(kw, klen, S, ws): i64 {
    # ret2/rethi/sizeof
    if (klen == 4) {
        if (kw & 0xFFFFFFFF == 0x32746572) { return 97; }
        if (kw & 0xFFFFFFFF == 0x38323175) { return 105; }
    }
    if (klen == 5) { if (kw & 0xFFFFFFFFFF == 0x6968746572) { return 98; } }
    if (klen == 5) { if (kw & 0xFFFFFFFFFF == 0x6E6F696E75) { return 101; } }
    if (klen == 5) { if (kw & 0xFFFFFFFFFF == 0x7265666564) { return 106; } }
    # "stack" = 0x6B63617473 — v5.5.36 stack-local array qualifier:
    # `stack var buf[N];` inside a fn body reserves N bytes on the
    # call stack (vs the default of hoisting all `var x[N]` to .bss).
    # Triggers __chkstk on Win64 when fn frame ≥ 4 KB.
    if (klen == 5) { if (kw & 0xFFFFFFFFFF == 0x6B63617473) { return 111; } }
    if (klen == 6) {
        if (kw & 0xFFFFFFFFFFFF == 0x746567746962) { return 102; }
        if (kw & 0xFFFFFFFFFFFF == 0x746573746962) { return 103; }
        if (kw & 0xFFFFFFFFFFFF == 0x726C63746962) { return 104; }
        # "secret" = 0x746572636573 — zeroise-on-return attribute for local arrays
        if (kw & 0xFFFFFFFFFFFF == 0x746572636573) { return 108; }
    }
    # SIMD + trig keywords
    if (klen == 8) {
        if (kw == 0x7669645F76343666) { return 93; }
        if (kw == 0x7362615F76343666) { return 95; }
        if (kw == 0x6E6174615F343666) { return 99; }
        # v5.10.17: f64v_dot (sum of products → f64 in rax/x0)
        if (kw == 0x746F645F76343666) { return 128; }
    }
    if (klen == 9) {
        if (kw == 0x7271735F76343666) {
            if (load8(S + 0x60000 + ws + 8) == 116) { return 94; }
        }
        # v5.10.17: f64v_axpy (y[i] += alpha * x[i])
        if (kw == 0x7078615F76343666) {
            if (load8(S + 0x60000 + ws + 8) == 121) { return 130; }
        }
    }
    if (klen == 10) {
        if (kw == 0x616D665F76343666) {
            if (load8(S + 0x60000 + ws + 8) == 100) {
                if (load8(S + 0x60000 + ws + 9) == 100) { return 96; }
            }
        }
        # v5.10.17: f64v_scale (dst[i] = a[i] * scalar)
        if (kw == 0x6163735F76343666) {
            if (load8(S + 0x60000 + ws + 8) == 108) {
                if (load8(S + 0x60000 + ws + 9) == 101) { return 129; }
            }
        }
    }
    return 0;
}

# Guard the identifier buffer (tok_names @ S+0x60000, 256 KB v5.11.18;
# was 128 KB v4.6.2-v5.11.17). Called before any mangled-name write
# (variant ctors, closure names, operator impls) so overflow emits the
# clean diagnostic from where it actually occurs, not as a downstream
# parse error after memory corruption. `need` is a pessimistic byte
# count for the pending write. See CHANGELOG [5.11.18].
fn NPOS_GUARD(S, need): i64 {
    var np = GNPOS(S);
    if (np + need >= 261872) {
        syscall(SYS_WRITE, 2, "error: identifier buffer full (", 31);
        PRNUM(np);
        syscall(SYS_WRITE, 2, "/262144 bytes) — reduce included modules or split into separate units\n", 72);
        syscall(SYS_EXIT, 1);
    }
    return 0;
}

# Lex an identifier starting at p, return new p. Stores token.
# Threshold 261872 leaves 272 bytes of slack for the inner write loop.
# Buffer grows 0x60000–0xA0000 (was 0x60000–0x80000 pre-v5.11.18,
# 0x60000–0x70000 pre-v4.6.2). v5.11.18: kybernet 1.1.0 was 85% full
# at the old 128 KB cap; 2× headroom unblocks 1.2.0's edge-boot
# surface expansion. See CHANGELOG [5.11.18].
fn LEXID(S, p, npos): i64 {
    if (npos >= 261872) {
        syscall(SYS_WRITE, 2, "error: identifier buffer full (", 31);
        PRNUM(npos);
        syscall(SYS_WRITE, 2, "/262144 bytes) — reduce included modules or split into separate units\n", 72);
        syscall(SYS_EXIT, 1);
    }
    var bl = GBL(S);
    var ws = npos;
    var go = 1;
    var c = 0;
    while (go == 1) {
        if (p >= bl) { go = 0; }
        if (go == 1) {
            c = load8(S + 0x459D000 + p);
            if (ISALNUM(c) == 1) {
                store8(S + 0x60000 + npos, c);
                npos = npos + 1;
                p = p + 1;
            } else { go = 0; }
        }
    }
    store8(S + 0x60000 + npos, 0);
    # Dedup via length-bucketed chain (v5.10.40). Replaces the prior
    # O(N²) walk-from-zero scan (lex was 58% of compile time per v5.10.0
    # profile, dedup_cmps the inner hot spot). Layout — at offsets past
    # the v5.10.39 brk extension (heap-map in main.cyr §LEXID_DEDUP):
    #   0x457C000  lexid_count   [8]            entries in use
    #   0x457C100  lexid_heads   [2048]         per-length head idx+1 (256 × 8B; 0 = empty)
    #   0x457C900  lexid_entries [131072]       16384 × 8B; low32 = canonical offset
    #                                            into tok_names @ 0x60000, high32 =
    #                                            next-entry idx+1 (0 = chain tail).
    # First-occurrence wins (canonical offset preserved across calls →
    # byte-identical) because we only insert when no match found, and
    # subsequent lookups for the same string return the recorded offset
    # regardless of chain order.
    bl = ws;
    var klen = npos - bl;
    var bucket = klen;
    if (bucket > 255) { bucket = 255; }
    var hi = L64(S + 0x457C100 + bucket * 8);
    while (hi > 0) {
        var idx = hi - 1;
        var ent = L64(S + 0x457C900 + idx * 8);
        var eoff = ent & 0xFFFFFFFF;
        var dc = 0;
        c = 1;
        while (dc < klen) {
            if (load8(S + 0x60000 + eoff + dc) != load8(S + 0x60000 + bl + dc)) { c = 0; break; }
            dc = dc + 1;
        }
        if (c == 1) { ws = eoff; break; }
        hi = ent >> 32;
    }
    if (ws == bl) {
        var ec = L64(S + 0x457C000);
        if (ec >= 16384) {
            syscall(SYS_WRITE, 2, "error: identifier dedup table full (16384 entries) - raise LEXID cap in lex.cyr\n", 80);
            syscall(SYS_EXIT, 1);
        }
        var prev_head = L64(S + 0x457C100 + bucket * 8);
        S64(S + 0x457C900 + ec * 8, bl | (prev_head << 32));
        S64(S + 0x457C100 + bucket * 8, ec + 1);
        S64(S + 0x457C000, ec + 1);
    }
    if (ws == bl) { npos = npos + 1; SNPOS(S, npos); }
    else { SNPOS(S, bl); }
    # Check keywords
    var kw = L64(S + 0x60000 + ws);
    # Extended keywords (ret2, rethi, SIMD) in separate function
    if (klen >= 4) {
        var ext_tok = LEXKW_EXT(kw, klen, S, ws);
        if (ext_tok > 0) { ADDTOK(S, ext_tok, 0); return p; }
    }
    if (klen == 2) {
        if (kw & 0xFFFF == 0x6669) { ADDTOK(S, 15, 0); return p; }
        if (kw & 0xFFFF == 0x6E66) { ADDTOK(S, 32, 0); return p; }
        if (kw & 0xFFFF == 0x6E69) { ADDTOK(S, 76, 0); return p; }
    }
    if (klen == 3) {
        if (kw & 0xFFFFFFFF == 0x00726176) { ADDTOK(S, 3, 0); return p; }
        if (kw & 0xFFFFFFFF == 0x006D7361) { ADDTOK(S, 48, 0); return p; }
        if (kw & 0xFFFFFFFF == 0x00726F66) { ADDTOK(S, 55, 0); return p; }
        # "mod" = 0x646F6D
        if (kw & 0xFFFFFFFF == 0x00646F6D) { ADDTOK(S, 72, 0); return p; }
        # "pub" = 0x627570
        if (kw & 0xFFFFFFFF == 0x00627570) { ADDTOK(S, 73, 0); return p; }
        # "use" = 0x657375
        if (kw & 0xFFFFFFFF == 0x00657375) { ADDTOK(S, 74, 0); return p; }
    }
    if (klen == 4) {
        if (kw & 0xFFFFFFFF == 0x65736C65) { ADDTOK(S, 23, 0); return p; }
        # "elif" = 0x66696C65
        if (kw & 0xFFFFFFFF == 0x66696C65) { ADDTOK(S, 50, 0); return p; }
        if (kw & 0xFFFFFFFF == 0x65736163) { ADDTOK(S, 58, 0); return p; }
        if (kw & 0xFFFFFFFF == 0x6D756E65) { ADDTOK(S, 60, 0); return p; }
        # "impl" = 0x6C706D69
        if (kw & 0xFFFFFFFF == 0x6C706D69) { ADDTOK(S, 77, 0); return p; }
    }
    if (klen == 5) {
        if (kw & 0xFFFFFFFFFF == 0x00656C696877) { ADDTOK(S, 16, 0); return p; }
        if (kw & 0xFFFFFFFFFF == 0x003864616F6C) { ADDTOK(S, 25, 0); return p; }
        # "break" = 0x6B61657262
        if (kw & 0xFFFFFFFFFF == 0x6B61657262) { ADDTOK(S, 51, 0); return p; }
        # "match" = 0x686374616D
        if (kw & 0xFFFFFFFFFF == 0x686374616D) { ADDTOK(S, 75, 0); return p; }
    }
    if (klen == 6) {
        # "return" = 0x006E7275746572
        if (kw & 0xFFFFFFFFFFFFFF == 0x006E7275746572) { ADDTOK(S, 33, 0); return p; }
        # "store8" = 0x003865726F7473
        if (kw & 0xFFFFFFFFFFFFFF == 0x003865726F7473) { ADDTOK(S, 26, 0); return p; }
        # "struct" = 0x00746375727473
        if (kw & 0xFFFFFFFFFFFFFF == 0x746375727473) { ADDTOK(S, 40, 0); return p; }
        # "load16" = 0x363164616F6C
        if (kw & 0xFFFFFFFFFFFFFF == 0x363164616F6C) { ADDTOK(S, 42, 0); return p; }
        # "load32" = 0x323364616F6C
        if (kw & 0xFFFFFFFFFFFFFF == 0x323364616F6C) { ADDTOK(S, 43, 0); return p; }
        # "load64" = 0x343664616F6C
        if (kw & 0xFFFFFFFFFFFFFF == 0x343664616F6C) { ADDTOK(S, 44, 0); return p; }
        # v5.8.45: `kernel` demoted from reserved token 56 to plain
        # ident. Top-level `kernel;` (AGNOS kernel-mode switch) now
        # detected via _TOK_IS_KERNEL(S) at the dispatch site in
        # main.cyr / main_*.cyr. Pre-v5.8.45 the lexer always emitted
        # token 56, which broke `kernel` as a fn parameter or local
        # variable name everywhere — an issue surfaced from the vidya
        # audio_dsp 11-lang port where `fn fir_step(kernel, ...)` is
        # the natural DSP signature.
        # "shared" = 0x646572616873
        if (kw & 0xFFFFFFFFFFFFFF == 0x646572616873) { ADDTOK(S, 78, 0); return p; }
        # "object" = 0x7463656a626f → token 79, sets mode 3 (.o output)
        if (kw & 0xFFFFFFFFFFFFFF == 0x7463656a626f) { ADDTOK(S, 79, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x686374697773) { ADDTOK(S, 57, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6F745F343666) { ADDTOK(S, 67, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x71655F343666) { ADDTOK(S, 68, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x746C5F343666) { ADDTOK(S, 69, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x74675F343666) { ADDTOK(S, 70, 0); return p; }
    }
    if (klen == 7) {
        if (kw & 0xFFFFFFFFFFFFFF == 0x6C6C6163737973) { ADDTOK(S, 24, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x363165726F7473) { ADDTOK(S, 45, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x323365726F7473) { ADDTOK(S, 46, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x343665726F7473) { ADDTOK(S, 47, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x746C7561666564) { ADDTOK(S, 59, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6464615F343666) { ADDTOK(S, 62, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6275735F343666) { ADDTOK(S, 63, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6C756D5F343666) { ADDTOK(S, 64, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x7669645F343666) { ADDTOK(S, 65, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x67656E5F343666) { ADDTOK(S, 71, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x7362615F343666) { ADDTOK(S, 80, 0); return p; }
        # "callptr" = 0x7274706C6C6163 → token 111 (v6.0.70 §0 indirect-call builtin)
        if (kw & 0xFFFFFFFFFFFFFF == 0x7274706C6C6163) { ADDTOK(S, 111, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6E69735F343666) { ADDTOK(S, 83, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x736F635F343666) { ADDTOK(S, 84, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x7078655F343666) { ADDTOK(S, 85, 0); return p; }
    }
    if (klen == 6) {
        if (kw & 0xFFFFFFFFFFFF == 0x6E6C5F343666) { ADDTOK(S, 86, 0); return p; }
    }
    # "continue" = 0x65756E69746E6F63 (8 bytes)
    if (klen == 8) {
        if (kw == 0x65756E69746E6F63) { ADDTOK(S, 52, 0); return p; }
        if (kw == 0x6D6F72665F343666) { ADDTOK(S, 66, 0); return p; }
        if (kw == 0x747271735F343666) { ADDTOK(S, 79, 0); return p; }
        if (kw == 0x6C6965635F343666) { ADDTOK(S, 82, 0); return p; }
        if (kw == 0x32676F6C5F343666) { ADDTOK(S, 87, 0); return p; }
        if (kw == 0x327078655F343666) { ADDTOK(S, 88, 0); return p; }
        if (kw == 0x6464615F76343666) { ADDTOK(S, 89, 0); return p; }
        if (kw == 0x6275735F76343666) { ADDTOK(S, 90, 0); return p; }
        if (kw == 0x6C756D5F76343666) { ADDTOK(S, 91, 0); return p; }
    }
    if (klen == 9) {
        if (kw == 0x6F6F6C665F343666) {
            if (load8(S + 0x60000 + ws + 8) == 114) { ADDTOK(S, 81, 0); return p; }
        }
        if (kw == 0x6E756F725F343666) {
            if (load8(S + 0x60000 + ws + 8) == 100) { ADDTOK(S, 92, 0); return p; }
        }
        if (kw == 8246499246534309478) {
            if (load8(S + 0x60000 + ws + 8) == 116) { ADDTOK(S, 94, 0); return p; }
        }
    }
    if (klen == 10) {
        if (kw == 7020379954331530854) {
            if (load8(S + 0x60000 + ws + 8) == 100) {
                if (load8(S + 0x60000 + ws + 9) == 100) { ADDTOK(S, 96, 0); return p; }
            }
        }
    }
    ADDTOK(S, 2, ws);
    return p;
}

fn LEX(S): i64 {
    var p = 0;
    var bl = GBL(S);
    STCNT(S, 0);
    SNPOS(S, 0);
    while (p < bl) {
        var c = load8(S + 0x459D000 + p);
        var cl = CCLASS(c);
        # Whitespace — skip (track newlines for line numbers)
        if (cl == 1) {
            if (c == 10) { SCLINE(S, GCLINE(S) + 1); }
            p = p + 1;
        }
        # Comment or #assert / #regalloc directive
        else { if (c == 35) {
                # Check for #assert (35 97 115 115 101 114 116 = #assert)
                if (p + 6 < bl) {
                    if (load8(S + 0x459D000 + p + 1) == 97) {
                        if (load8(S + 0x459D000 + p + 2) == 115) {
                            if (load8(S + 0x459D000 + p + 3) == 115) {
                                if (load8(S + 0x459D000 + p + 4) == 101) {
                                    if (load8(S + 0x459D000 + p + 5) == 114) {
                                        if (load8(S + 0x459D000 + p + 6) == 116) {
                                            # Emit token 107 = HASH_ASSERT, skip "assert"
                                            ADDTOK(S, 107, 0);
                                            p = p + 7;
                                            # Skip whitespace after #assert
                                            while (p < bl) {
                                                var wc = load8(S + 0x459D000 + p);
                                                if (wc == 32 || wc == 9) { p = p + 1; }
                                                else { break; }
                                            }
                                            continue;
                                        } } } } } } }
                # Check for #regalloc (4.8.4-alpha1) — opt-in attribute
                # on the next fn def. Codegen change lands in later alphas;
                # alpha1 just emits the token so the parser can attach
                # the flag to the fn.
                # bytes: 23 72 65 67 61 6C 6C 6F 63 = "#regalloc" (9 chars)
                if (p + 8 < bl) {
                    if (load8(S + 0x459D000 + p + 1) == 114) {
                        if (load8(S + 0x459D000 + p + 2) == 101) {
                            if (load8(S + 0x459D000 + p + 3) == 103) {
                                if (load8(S + 0x459D000 + p + 4) == 97) {
                                    if (load8(S + 0x459D000 + p + 5) == 108) {
                                        if (load8(S + 0x459D000 + p + 6) == 108) {
                                            if (load8(S + 0x459D000 + p + 7) == 111) {
                                                if (load8(S + 0x459D000 + p + 8) == 99) {
                                                    ADDTOK(S, 109, 0);   # token 109 = HASH_REGALLOC
                                                    p = p + 9;
                                                    while (p < bl) {
                                                        var wc2 = load8(S + 0x459D000 + p);
                                                        if (wc2 == 32 || wc2 == 9 || wc2 == 10 || wc2 == 13) {
                                                            if (wc2 == 10) { SCLINE(S, GCLINE(S) + 1); }
                                                            p = p + 1;
                                                        }
                                                        else { break; }
                                                    }
                                                    continue;
                                                } } } } } } } }
                }
                # v5.6.4: #deprecated("msg") — attribute on the next fn
                # def that warns at every call site. Checked BEFORE
                # #must_use so "#deprecated" doesn't trigger the lexer
                # prefix check for "#must_use" (different first char anyway
                # — `d` vs `m` — so ordering is only for readability).
                # bytes: 23 64 65 70 72 65 63 61 74 65 64 = "#deprecated" (11 chars)
                if (p + 10 < bl) {
                    if (load8(S + 0x459D000 + p + 1) == 100) {
                        if (load8(S + 0x459D000 + p + 2) == 101) {
                            if (load8(S + 0x459D000 + p + 3) == 112) {
                                if (load8(S + 0x459D000 + p + 4) == 114) {
                                    if (load8(S + 0x459D000 + p + 5) == 101) {
                                        if (load8(S + 0x459D000 + p + 6) == 99) {
                                            if (load8(S + 0x459D000 + p + 7) == 97) {
                                                if (load8(S + 0x459D000 + p + 8) == 116) {
                                                    if (load8(S + 0x459D000 + p + 9) == 101) {
                                                        if (load8(S + 0x459D000 + p + 10) == 100) {
                                                            ADDTOK(S, 124, 0);   # token 124 = HASH_DEPRECATED
                                                            p = p + 11;
                                                            continue;
                                                        } } } } } } } } } }
                }
                # v5.6.3: #must_use — attribute on the next fn def marking
                # its return as required-to-use. PARSE_STMT's expr-stmt
                # discard path warns if a must_use fn's result is dropped.
                # bytes: 23 6D 75 73 74 5F 75 73 65 = "#must_use" (9 chars)
                if (p + 8 < bl) {
                    if (load8(S + 0x459D000 + p + 1) == 109) {
                        if (load8(S + 0x459D000 + p + 2) == 117) {
                            if (load8(S + 0x459D000 + p + 3) == 115) {
                                if (load8(S + 0x459D000 + p + 4) == 116) {
                                    if (load8(S + 0x459D000 + p + 5) == 95) {
                                        if (load8(S + 0x459D000 + p + 6) == 117) {
                                            if (load8(S + 0x459D000 + p + 7) == 115) {
                                                if (load8(S + 0x459D000 + p + 8) == 101) {
                                                    ADDTOK(S, 122, 0);   # token 122 = HASH_MUST_USE
                                                    p = p + 9;
                                                    while (p < bl) {
                                                        var wcm = load8(S + 0x459D000 + p);
                                                        if (wcm == 32 || wcm == 9 || wcm == 10 || wcm == 13) {
                                                            if (wcm == 10) { SCLINE(S, GCLINE(S) + 1); }
                                                            p = p + 1;
                                                        }
                                                        else { break; }
                                                    }
                                                    continue;
                                                } } } } } } } }
                }
                # v5.8.20: #pure — fn-attribute marking the next fn def as
                # pure. PARSE_FNCALL inside a #pure body warns when the
                # callee is #io or #alloc. bytes: 23 70 75 72 65 = "#pure" (5 chars)
                if (p + 4 < bl) {
                    if (load8(S + 0x459D000 + p + 1) == 112) {
                        if (load8(S + 0x459D000 + p + 2) == 117) {
                            if (load8(S + 0x459D000 + p + 3) == 114) {
                                if (load8(S + 0x459D000 + p + 4) == 101) {
                                    ADDTOK(S, 125, 0);   # token 125 = HASH_PURE
                                    p = p + 5;
                                    while (p < bl) {
                                        var wcp = load8(S + 0x459D000 + p);
                                        if (wcp == 32 || wcp == 9 || wcp == 10 || wcp == 13) {
                                            if (wcp == 10) { SCLINE(S, GCLINE(S) + 1); }
                                            p = p + 1;
                                        }
                                        else { break; }
                                    }
                                    continue;
                                } } } } }
                # v5.8.20: #io — fn-attribute marking a fn as performing I/O.
                # bytes: 23 69 6F = "#io" (3 chars)
                if (p + 2 < bl) {
                    if (load8(S + 0x459D000 + p + 1) == 105) {
                        if (load8(S + 0x459D000 + p + 2) == 111) {
                            ADDTOK(S, 126, 0);   # token 126 = HASH_IO
                            p = p + 3;
                            while (p < bl) {
                                var wcio = load8(S + 0x459D000 + p);
                                if (wcio == 32 || wcio == 9 || wcio == 10 || wcio == 13) {
                                    if (wcio == 10) { SCLINE(S, GCLINE(S) + 1); }
                                    p = p + 1;
                                }
                                else { break; }
                            }
                            continue;
                        } } }
                # v5.8.20: #alloc — fn-attribute marking a fn as allocating.
                # bytes: 23 61 6C 6C 6F 63 = "#alloc" (6 chars)
                if (p + 5 < bl) {
                    if (load8(S + 0x459D000 + p + 1) == 97) {
                        if (load8(S + 0x459D000 + p + 2) == 108) {
                            if (load8(S + 0x459D000 + p + 3) == 108) {
                                if (load8(S + 0x459D000 + p + 4) == 111) {
                                    if (load8(S + 0x459D000 + p + 5) == 99) {
                                        ADDTOK(S, 127, 0);   # token 127 = HASH_ALLOC
                                        p = p + 6;
                                        while (p < bl) {
                                            var wca = load8(S + 0x459D000 + p);
                                            if (wca == 32 || wca == 9 || wca == 10 || wca == 13) {
                                                if (wca == 10) { SCLINE(S, GCLINE(S) + 1); }
                                                p = p + 1;
                                            }
                                            else { break; }
                                        }
                                        continue;
                                    } } } } } }
                # Check for #pe_import (v5.4.6) — PE32+ kernel32 symbol
                # registration directive. Parser consumes (dll, symbol)
                # string-literal args and forwards to the pe emitter's
                # pending-imports buffer.
                # bytes: 23 70 65 5F 69 6D 70 6F 72 74 = "#pe_import" (10 chars)
                if (p + 9 < bl) {
                    if (load8(S + 0x459D000 + p + 1) == 112) {
                        if (load8(S + 0x459D000 + p + 2) == 101) {
                            if (load8(S + 0x459D000 + p + 3) == 95) {
                                if (load8(S + 0x459D000 + p + 4) == 105) {
                                    if (load8(S + 0x459D000 + p + 5) == 109) {
                                        if (load8(S + 0x459D000 + p + 6) == 112) {
                                            if (load8(S + 0x459D000 + p + 7) == 111) {
                                                if (load8(S + 0x459D000 + p + 8) == 114) {
                                                    if (load8(S + 0x459D000 + p + 9) == 116) {
                                                        ADDTOK(S, 110, 0);   # token 110 = HASH_PE_IMPORT
                                                        p = p + 10;
                                                        while (p < bl) {
                                                            var wc3 = load8(S + 0x459D000 + p);
                                                            if (wc3 == 32 || wc3 == 9 || wc3 == 10 || wc3 == 13) {
                                                                if (wc3 == 10) { SCLINE(S, GCLINE(S) + 1); }
                                                                p = p + 1;
                                                            }
                                                            else { break; }
                                                        }
                                                        continue;
                                                    } } } } } } } } }
                }
                # Regular comment — skip to newline
                p = p + 1;
                var cgo = 1;
                while (cgo == 1) {
                    if (p >= bl) { cgo = 0; }
                    if (cgo == 1) {
                        if (load8(S + 0x459D000 + p) == 10) { SCLINE(S, GCLINE(S) + 1); p = p + 1; cgo = 0; }
                        else { p = p + 1; }
                    }
                }
            }
            # Digit
            else { if (cl == 2) { p = LEXNUM(S, p); }
                # Letter (lower or upper) or underscore
                else { if (cl >= 3) { p = LEXID(S, p, GNPOS(S)); }
                    # Single/double char tokens
                    else { if (c == 61) {
                            if (p + 1 < bl) {
                                if (load8(S + 0x459D000 + p + 1) == 61) { ADDTOK(S, 17, 0); p = p + 2; }
                                else { ADDTOK(S, 4, 0); p = p + 1; }
                            } else { ADDTOK(S, 4, 0); p = p + 1; }
                        }
                        else { if (c == 59) { ADDTOK(S, 5, 0); p = p + 1; }
                            else { if (c == 44) { ADDTOK(S, 31, 0); p = p + 1; }
                                else { if (c == 46) {
                                        # v5.5.36 Phase 3 — collapse three consecutive dots into
                                        # a single ELLIPSIS token (TOK=112) for variadic fn syntax
                                        # `fn f(a, ...)`. Single or double dots still emit DOT
                                        # tokens (struct field access, nested `s.inner.field`).
                                        if (p + 2 < bl) {
                                            if (load8(S + 0x459D000 + p + 1) == 46) {
                                                if (load8(S + 0x459D000 + p + 2) == 46) {
                                                    ADDTOK(S, 112, 0); p = p + 3;
                                                } else { ADDTOK(S, 41, 0); p = p + 1; }
                                            } else { ADDTOK(S, 41, 0); p = p + 1; }
                                        } else { ADDTOK(S, 41, 0); p = p + 1; }
                                    }
                                    else { if (c == 58) { ADDTOK(S, 49, 0); p = p + 1; }
                                        # v5.6.2: overflow operators `+%` / `+|` / `+?` (wrapping /
                                        # saturating / checked). Lookahead one byte; if no match, fall
                                        # back to plain `+` (token 6). Wrapping is semantically identical
                                        # to bare `+` — the distinct token carries intent for readers
                                        # and future `--strict`-mode diagnostics. Saturating and checked
                                        # compile to a stdlib helper call (lib/overflow.cyr — explicit
                                        # include required).
                                        else { if (c == 43) {
                                                if (p + 1 < bl) {
                                                    var nc = load8(S + 0x459D000 + p + 1);
                                                    if (nc == 37)      { ADDTOK(S, 113, 0); p = p + 2; }  # +%
                                                    elif (nc == 124)   { ADDTOK(S, 114, 0); p = p + 2; }  # +|
                                                    elif (nc == 63)    { ADDTOK(S, 115, 0); p = p + 2; }  # +?
                                                    else               { ADDTOK(S, 6,   0); p = p + 1; }
                                                } else { ADDTOK(S, 6, 0); p = p + 1; }
                                            }
                                            else { if (c == 45) {
                                                    if (p + 1 < bl) {
                                                        var nc = load8(S + 0x459D000 + p + 1);
                                                        if (nc == 37)      { ADDTOK(S, 116, 0); p = p + 2; }  # -%
                                                        elif (nc == 124)   { ADDTOK(S, 117, 0); p = p + 2; }  # -|
                                                        elif (nc == 63)    { ADDTOK(S, 118, 0); p = p + 2; }  # -?
                                                        else               { ADDTOK(S, 7,   0); p = p + 1; }
                                                    } else { ADDTOK(S, 7, 0); p = p + 1; }
                                                }
                                                else { if (c == 42) {
                                                        if (p + 1 < bl) {
                                                            var nc = load8(S + 0x459D000 + p + 1);
                                                            if (nc == 37)      { ADDTOK(S, 119, 0); p = p + 2; }  # *%
                                                            elif (nc == 124)   { ADDTOK(S, 120, 0); p = p + 2; }  # *|
                                                            elif (nc == 63)    { ADDTOK(S, 121, 0); p = p + 2; }  # *?
                                                            else               { ADDTOK(S, 8,   0); p = p + 1; }
                                                        } else { ADDTOK(S, 8, 0); p = p + 1; }
                                                    }
                                                    else { if (c == 47) { ADDTOK(S, 9, 0); p = p + 1; }
                                                        else { if (c == 40) { ADDTOK(S, 10, 0); p = p + 1; }
                                                            else { if (c == 41) { ADDTOK(S, 11, 0); p = p + 1; }
                                                                else { if (c == 123) { ADDTOK(S, 13, 0); p = p + 1; }
                                                                    else { if (c == 125) { ADDTOK(S, 14, 0); p = p + 1; }
                                                                        # !=
                                                                        else { if (c == 33) {
                                                                                if (p + 1 < bl) {
                                                                                    if (load8(S + 0x459D000 + p + 1) == 61) { ADDTOK(S, 18, 0); p = p + 2; }
                                                                                    else { p = p + 1; }
                                                                                } else { p = p + 1; }
                                                                            }
                                                                            # < or <= or <<
                                                                            else { if (c == 60) {
                                                                                    if (p + 1 < bl) {
                                                                                        var nc = load8(S + 0x459D000 + p + 1);
                                                                                        if (nc == 61) { ADDTOK(S, 21, 0); p = p + 2; }
                                                                                        else {
                                                                                            if (nc == 60) { ADDTOK(S, 38, 0); p = p + 2; }
                                                                                            else { ADDTOK(S, 19, 0); p = p + 1; }
                                                                                        }
                                                                                    } else { ADDTOK(S, 19, 0); p = p + 1; }
                                                                                }
                                                                                # > or >= or >>
                                                                                else { if (c == 62) {
                                                                                        if (p + 1 < bl) {
                                                                                            var gc = load8(S + 0x459D000 + p + 1);
                                                                                            if (gc == 61) { ADDTOK(S, 22, 0); p = p + 2; }
                                                                                            else {
                                                                                                if (gc == 62) { ADDTOK(S, 39, 0); p = p + 2; }
                                                                                                else { ADDTOK(S, 20, 0); p = p + 1; }
                                                                                            }
                                                                                        } else { ADDTOK(S, 20, 0); p = p + 1; }
                                                                                    }
                                                                                    else { if (c == 38) {
                                                                                            if (p + 1 < bl) {
                                                                                                if (load8(S + 0x459D000 + p + 1) == 38) { ADDTOK(S, 53, 0); p = p + 2; }
                                                                                                else { ADDTOK(S, 27, 0); p = p + 1; }
                                                                                            } else { ADDTOK(S, 27, 0); p = p + 1; }
                                                                                        }
                                                                                        else { if (c == 91) { ADDTOK(S, 28, 0); p = p + 1; }
                                                                                            else { if (c == 93) { ADDTOK(S, 29, 0); p = p + 1; }
                                                                                                else { if (c == 124) {
                                                                                                        if (p + 1 < bl) {
                                                                                                            if (load8(S + 0x459D000 + p + 1) == 124) { ADDTOK(S, 54, 0); p = p + 2; }
                                                                                                            else { ADDTOK(S, 35, 0); p = p + 1; }
                                                                                                        } else { ADDTOK(S, 35, 0); p = p + 1; }
                                                                                                    }
                                                                                                    else { if (c == 94) { ADDTOK(S, 36, 0); p = p + 1; }
                                                                                                        else { if (c == 126) { ADDTOK(S, 37, 0); p = p + 1; }
                                                                                                            # v5.8.29: `?` standalone postfix token (Result-propagation).
                                                                                                            # Distinct from the TS-regex compounds `+?`/`-?`/`*?` (115/118/121)
                                                                                                            # already handled in their respective add/sub/mul branches above —
                                                                                                            # those consume two bytes; this single-char form is the bare `?`.
                                                                                                            else { if (c == 63) { ADDTOK(S, 124, 0); p = p + 1; }
                                                                                                            # v5.6.3: @unsafe — block attribute marking memory/FFI boundary.
                                                                                                            # bytes: 40 75 6E 73 61 66 65 = "@unsafe" (7 chars). Advisory in
                                                                                                            # v5.6.3 (nested-unsafe warning only). Parser treats the body as
                                                                                                            # a plain `{ ... }` block.
                                                                                                            else { if (c == 64) {
                                                                                                                    if (p + 6 < bl) {
                                                                                                                        if (load8(S + 0x459D000 + p + 1) == 117) {
                                                                                                                            if (load8(S + 0x459D000 + p + 2) == 110) {
                                                                                                                                if (load8(S + 0x459D000 + p + 3) == 115) {
                                                                                                                                    if (load8(S + 0x459D000 + p + 4) == 97) {
                                                                                                                                        if (load8(S + 0x459D000 + p + 5) == 102) {
                                                                                                                                            if (load8(S + 0x459D000 + p + 6) == 101) {
                                                                                                                                                ADDTOK(S, 123, 0);   # token 123 = AT_UNSAFE
                                                                                                                                                p = p + 7;
                                                                                                                                                while (p < bl) {
                                                                                                                                                    var wcu = load8(S + 0x459D000 + p);
                                                                                                                                                    if (wcu == 32 || wcu == 9 || wcu == 10 || wcu == 13) {
                                                                                                                                                        if (wcu == 10) { SCLINE(S, GCLINE(S) + 1); }
                                                                                                                                                        p = p + 1;
                                                                                                                                                    }
                                                                                                                                                    else { break; }
                                                                                                                                                }
                                                                                                                                                continue;
                                                                                                                                            } } } } } }
                                                                                                                    }
                                                                                                                    # Unknown @-sequence: skip for now. Keeping `@` as a syntax
                                                                                                                    # error rather than a silently-eaten byte would need a
                                                                                                                    # tokname entry; deferred until more `@X` attributes land.
                                                                                                                    p = p + 1;
                                                                                                                }
                                                                                                                else { if (c == 37) { ADDTOK(S, 34, 0); p = p + 1; }
                                                                                                                    # << or <
                                                                                                                    # (already handled < and <= above, need << separately)
                                                                                                                    # >> or >
                                                                                                                    # (already handled > and >= above, need >> separately)
                                                                                                                    # v5.9.37: char literal — `'X'` or `'\X'`. Emits a
                                                                                                                    # NUMBER token (type 1) with the byte value.
                                                                                                                    # Required by agnosys 1.1.12 verbatim repro at
                                                                                                                    # /tmp/cyrius-derive-serialize-incomplete/minimal_repro.cyr
                                                                                                                    # which uses `str_builder_putc(sb, '[')`.
                                                                                                                    # Pre-fix the lexer had no char-literal branch; aarch64
                                                                                                                    # error:N: unexpected '['.
                                                                                                                    else { if (c == 39) {
                                                                                                                            p = p + 1;
                                                                                                                            if (p >= bl) {
                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6); PRNUM(GCLINE(S));
                                                                                                                                syscall(SYS_WRITE, 2, ": unterminated char literal\n", 28);
                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                            }
                                                                                                                            var clv = 0;
                                                                                                                            var c0 = load8(S + 0x459D000 + p);
                                                                                                                            if (c0 == 92) {
                                                                                                                                p = p + 1;
                                                                                                                                if (p >= bl) {
                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6); PRNUM(GCLINE(S));
                                                                                                                                    syscall(SYS_WRITE, 2, ": unterminated char escape\n", 27);
                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                }
                                                                                                                                var c1 = load8(S + 0x459D000 + p);
                                                                                                                                p = p + 1;
                                                                                                                                if      (c1 == 110) { clv = 10; }       # \n
                                                                                                                                elif    (c1 == 114) { clv = 13; }       # \r
                                                                                                                                elif    (c1 == 116) { clv =  9; }       # \t
                                                                                                                                elif    (c1 == 48)  { clv =  0; }       # \0
                                                                                                                                elif    (c1 == 92)  { clv = 92; }       # \\
                                                                                                                                elif    (c1 == 39)  { clv = 39; }       # \'
                                                                                                                                elif    (c1 == 34)  { clv = 34; }       # \"
                                                                                                                                else {
                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6); PRNUM(GCLINE(S));
                                                                                                                                    syscall(SYS_WRITE, 2, ": unknown char escape\n", 22);
                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                }
                                                                                                                            } else {
                                                                                                                                clv = c0;
                                                                                                                                p = p + 1;
                                                                                                                            }
                                                                                                                            if (p >= bl) {
                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6); PRNUM(GCLINE(S));
                                                                                                                                syscall(SYS_WRITE, 2, ": unterminated char literal\n", 28);
                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                            }
                                                                                                                            if (load8(S + 0x459D000 + p) != 39) {
                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6); PRNUM(GCLINE(S));
                                                                                                                                syscall(SYS_WRITE, 2, ": multi-byte char literal not supported\n", 40);
                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                            }
                                                                                                                            p = p + 1;
                                                                                                                            ADDTOK(S, 1, clv);
                                                                                                                        }
                                                                                                                    # String literal
                                                                                                                    else { if (c == 34) {
                                                                                                                            p = p + 1;
                                                                                                                            var spos = GSPOS(S);
                                                                                                                            var sstart = spos;
                                                                                                                            var sgo = 1;
                                                                                                                            while (sgo == 1) {
                                                                                                                                if (p >= bl) { sgo = 0; }
                                                                                                                                # CVE-06: bounds check str_data (2MB at 0x21A000; v5.8.59 was 256KB at 0x14A000)
                                                                                                                                if (spos >= 2097152) {
                                                                                                                                    syscall(SYS_WRITE, 2, "error: string data overflow (2MB limit)\n", 40);
                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                }
                                                                                                                                if (sgo == 1) {
                                                                                                                                    var sc = load8(S + 0x459D000 + p);
                                                                                                                                    if (sc == 34) { p = p + 1; sgo = 0; }
                                                                                                                                    else {
                                                                                                                                        if (sc == 92) {
                                                                                                                                            p = p + 1;
                                                                                                                                            var ec = load8(S + 0x459D000 + p);
                                                                                                                                            p = p + 1;
                                                                                                                                            if (ec == 110)      { store8(S + 0x21A000 + spos, 10); spos = spos + 1; }
                                                                                                                                            elif (ec == 114)    { store8(S + 0x21A000 + spos, 13); spos = spos + 1; }
                                                                                                                                            elif (ec == 116)    { store8(S + 0x21A000 + spos,  9); spos = spos + 1; }
                                                                                                                                            elif (ec == 48)     { store8(S + 0x21A000 + spos,  0); spos = spos + 1; }
                                                                                                                                            elif (ec == 92)     { store8(S + 0x21A000 + spos, 92); spos = spos + 1; }
                                                                                                                                            elif (ec == 34)     { store8(S + 0x21A000 + spos, 34); spos = spos + 1; }
                                                                                                                                            elif (ec == 39)     { store8(S + 0x21A000 + spos, 39); spos = spos + 1; }
                                                                                                                                            elif (ec == 97)     { store8(S + 0x21A000 + spos,  7); spos = spos + 1; }
                                                                                                                                            elif (ec == 98)     { store8(S + 0x21A000 + spos,  8); spos = spos + 1; }
                                                                                                                                            elif (ec == 102)    { store8(S + 0x21A000 + spos, 12); spos = spos + 1; }
                                                                                                                                            elif (ec == 118)    { store8(S + 0x21A000 + spos, 11); spos = spos + 1; }
                                                                                                                                            elif (ec == 120) {
                                                                                                                                                # v5.7.13: \x## - exactly two hex digits.
                                                                                                                                                if (p + 1 >= bl) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\x escape needs two hex digits\n", 33);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                var h1 = _LEX_HEX_VAL(load8(S + 0x459D000 + p));
                                                                                                                                                var h2 = _LEX_HEX_VAL(load8(S + 0x459D000 + p + 1));
                                                                                                                                                if (h1 < 0) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\x escape: bad hex digit\n", 27);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                if (h2 < 0) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\x escape: bad hex digit\n", 27);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                store8(S + 0x21A000 + spos, (h1 << 4) | h2);
                                                                                                                                                spos = spos + 1;
                                                                                                                                                p = p + 2;
                                                                                                                                            }
                                                                                                                                            elif (ec == 117) {
                                                                                                                                                # v5.7.13: \u#### (four hex) or \u{...} (1..6 hex).
                                                                                                                                                var cp = 0;
                                                                                                                                                if (p < bl && load8(S + 0x459D000 + p) == 123) {
                                                                                                                                                    p = p + 1;
                                                                                                                                                    var ndig = 0;
                                                                                                                                                    var udone = 0;
                                                                                                                                                    while (udone == 0) {
                                                                                                                                                        if (p >= bl) {
                                                                                                                                                            syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                            PRNUM(GCLINE(S));
                                                                                                                                                            syscall(SYS_WRITE, 2, ": \\u{...} escape: missing closing brace\n", 40);
                                                                                                                                                            syscall(SYS_EXIT, 1);
                                                                                                                                                        }
                                                                                                                                                        var bc = load8(S + 0x459D000 + p);
                                                                                                                                                        if (bc == 125) { udone = 1; }
                                                                                                                                                        else {
                                                                                                                                                            var hv = _LEX_HEX_VAL(bc);
                                                                                                                                                            if (hv < 0) {
                                                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                                PRNUM(GCLINE(S));
                                                                                                                                                                syscall(SYS_WRITE, 2, ": \\u{...} escape: bad hex digit\n", 32);
                                                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                                                            }
                                                                                                                                                            if (ndig >= 6) {
                                                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                                PRNUM(GCLINE(S));
                                                                                                                                                                syscall(SYS_WRITE, 2, ": \\u{...} escape: > 6 hex digits\n", 33);
                                                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                                                            }
                                                                                                                                                            cp = (cp << 4) | hv;
                                                                                                                                                            ndig = ndig + 1;
                                                                                                                                                            p = p + 1;
                                                                                                                                                        }
                                                                                                                                                    }
                                                                                                                                                    if (ndig == 0) {
                                                                                                                                                        syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                        PRNUM(GCLINE(S));
                                                                                                                                                        syscall(SYS_WRITE, 2, ": \\u{...} escape: no hex digits\n", 32);
                                                                                                                                                        syscall(SYS_EXIT, 1);
                                                                                                                                                    }
                                                                                                                                                    p = p + 1;
                                                                                                                                                } else {
                                                                                                                                                    if (p + 3 >= bl) {
                                                                                                                                                        syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                        PRNUM(GCLINE(S));
                                                                                                                                                        syscall(SYS_WRITE, 2, ": \\u escape needs four hex digits\n", 34);
                                                                                                                                                        syscall(SYS_EXIT, 1);
                                                                                                                                                    }
                                                                                                                                                    var di = 0;
                                                                                                                                                    while (di < 4) {
                                                                                                                                                        var hv = _LEX_HEX_VAL(load8(S + 0x459D000 + p + di));
                                                                                                                                                        if (hv < 0) {
                                                                                                                                                            syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                            PRNUM(GCLINE(S));
                                                                                                                                                            syscall(SYS_WRITE, 2, ": \\u escape: bad hex digit\n", 27);
                                                                                                                                                            syscall(SYS_EXIT, 1);
                                                                                                                                                        }
                                                                                                                                                        cp = (cp << 4) | hv;
                                                                                                                                                        di = di + 1;
                                                                                                                                                    }
                                                                                                                                                    p = p + 4;
                                                                                                                                                }
                                                                                                                                                if (cp > 1114111) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\u escape: codepoint > U+10FFFF\n", 34);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                if (cp >= 55296 && cp <= 57343) {
                                                                                                                                                    syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                                    PRNUM(GCLINE(S));
                                                                                                                                                    syscall(SYS_WRITE, 2, ": \\u escape: surrogate codepoint not allowed\n", 45);
                                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                                }
                                                                                                                                                spos = _LEX_EMIT_UTF8(S, spos, cp);
                                                                                                                                            }
                                                                                                                                            else { store8(S + 0x21A000 + spos, ec); spos = spos + 1; }
                                                                                                                                        } else {
                                                                                                                                            store8(S + 0x21A000 + spos, sc);
                                                                                                                                            spos = spos + 1;
                                                                                                                                            p = p + 1;
                                                                                                                                        }
                                                                                                                                    }
                                                                                                                                }
                                                                                                                            }
                                                                                                                            # Add null terminator after string literal
                                                                                                                            store8(S + 0x21A000 + spos, 0);
                                                                                                                            var slen = spos - sstart;
                                                                                                                            # String interning: check if an identical string already
                                                                                                                            # exists in str_data. If so, reuse its offset — deduplicates string
                                                                                                                            # literals so pointer-identity comparison works.
                                                                                                                            var interned = 0 - 1;
                                                                                                                            var si = 0;
                                                                                                                            while (si < sstart) {
                                                                                                                                var eq = 1;
                                                                                                                                var sk = 0;
                                                                                                                                while (sk <= slen) {
                                                                                                                                    if (load8(S + 0x21A000 + si + sk) != load8(S + 0x21A000 + sstart + sk)) { eq = 0; break; }
                                                                                                                                    sk = sk + 1;
                                                                                                                                }
                                                                                                                                if (eq == 1) { interned = si; si = sstart; }
                                                                                                                                else {
                                                                                                                                    while (si < sstart) { if (load8(S + 0x21A000 + si) == 0) { si = si + 1; break; } si = si + 1; }
                                                                                                                                }
                                                                                                                            }
                                                                                                                            if (interned >= 0) {
                                                                                                                                sstart = interned;
                                                                                                                            } else {
                                                                                                                                spos = spos + 1;
                                                                                                                                if (spos >= 2097152) {
                                                                                                                                    syscall(SYS_WRITE, 2, "error: string data buffer full (2MB limit)\n", 43);
                                                                                                                                    syscall(SYS_EXIT, 1);
                                                                                                                                }
                                                                                                                                SSPOS(S, spos);
                                                                                                                            }
                                                                                                                            ADDTOK(S, 30, (sstart << 16) | slen);
                                                                                                                        }
                                                                                                                        else {
                                                                                                                            # Reject non-ASCII bytes outside strings/comments
                                                                                                                            if (c > 127) {
                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                PRNUM(GCLINE(S));
                                                                                                                                syscall(SYS_WRITE, 2, ": non-ASCII byte (0x", 20);
                                                                                                                                # Print hex byte
                                                                                                                                var hi = c >> 4;
                                                                                                                                var lo = c & 15;
                                                                                                                                if (hi < 10) { store8(S, 48 + hi); } else { store8(S, 87 + hi); }
                                                                                                                                syscall(SYS_WRITE, 2, S, 1);
                                                                                                                                if (lo < 10) { store8(S, 48 + lo); } else { store8(S, 87 + lo); }
                                                                                                                                syscall(SYS_WRITE, 2, S, 1);
                                                                                                                                syscall(SYS_WRITE, 2, ") -- only ASCII allowed in source (UTF-8 ok in strings)\n", 56);
                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                            }
                                                                                                                            else {
                                                                                                                                # CVE-31: a stray ASCII byte (`$`, backtick, a control char, ...) that
                                                                                                                                # matched no token was silently skipped, changing program meaning with
                                                                                                                                # no diagnostic -- error now (mirrors the >127 non-ASCII reject above).
                                                                                                                                syscall(SYS_WRITE, 2, "error:", 6);
                                                                                                                                PRNUM(GCLINE(S));
                                                                                                                                syscall(SYS_WRITE, 2, ": unexpected character (0x", 26);
                                                                                                                                var hi2 = c >> 4;
                                                                                                                                var lo2 = c & 15;
                                                                                                                                if (hi2 < 10) { store8(S, 48 + hi2); } else { store8(S, 87 + hi2); }
                                                                                                                                syscall(SYS_WRITE, 2, S, 1);
                                                                                                                                if (lo2 < 10) { store8(S, 48 + lo2); } else { store8(S, 87 + lo2); }
                                                                                                                                syscall(SYS_WRITE, 2, S, 1);
                                                                                                                                syscall(SYS_WRITE, 2, ")\n", 2);
                                                                                                                                syscall(SYS_EXIT, 1);
                                                                                                                            }
                                                                                                                            p = p + 1;
                                                                                                                        }
                                                                                                                    } } } } } } } } } } }
                                                                                } } } } } } } } }
                                            } } } } } } } } }
        }
    }
    ADDTOK(S, 12, 0);
    return 0;
}

# ================================================================
