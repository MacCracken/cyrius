# ================================================================
# LEXER — tokenizes the preprocessed source into tok arrays
# ================================================================

# File map: tracks #@file markers for file:line error messages.
# CVE-31 (v6.1.35): relocated into the freed 0x71A000 band (the old 2 MB
# output_buf slot, vacated when .27 moved output_buf to heap-top) so the cap
# could grow 128 → 1024 without colliding with file_map_str; the TS frontend's
# scratch starts at 0x800000, so we stay below it.
# S+0x71A000: entry count (8 bytes)              (was 0x19A100)
# S+0x71A040: entries[1024], each 24 bytes: (start_line, line_count, fname_offset)  (was 0x19A108[128])
# S+0x721000: filename strings (32 KB scratch)   (was 0x19D000[4 KB])

var _fm_count = 0;
var _fm_str_pos = 0;
var _fm_overflowed = 0;
# v6.4.60 (DX diagnostics): byte offset into preprocess_out (S+0x459D000) of the
# CURRENT token, set at the top of the LEX loop body and read by ADDTOK, which
# packs it into the high 32 bits of the tok_lines word (line stays in the low 32).
# The error emitters recover it via GTOFF() to derive the column + source-excerpt.
var _tok_start = 0;

# 1 iff `buf[pos]` sits at the START OF A LINE. CVE-45's consumer half: FM_BUILD
# scanned for `#@file` at ANY offset, so a span could be minted by bytes that merely
# CONTAINED the marker. Bite 5b closed the producer routes (PP_NEUT_FMARK neutralises
# user bytes at both entry points) but deliberately skips STRING LITERALS, so a
# program's own DATA could still mint one: `var q = "#@file ";` ends its literal with
# the very quote the scan wants, and the "filename" then ran from there to the next
# `"` in the file — a real span, with `;\nvar w = ` for a name, which showed up as the
# filename in a diagnostic. It could not defeat `private` (a string's closing quote is
# always followed by punctuation in valid cyrius, so the name is not attacker-chosen),
# but a marker is a compiler-internal control line and only the compiler should be able
# to mint one. `#@incdir` has required byte 0 since v6.5.7 for the same reason; this is
# the same rule one notch weaker, and it closes the class at the CONSUMER instead of at
# every producer.
#
# SAFE FOR REAL MARKERS, measured AND argued. Measured: instrumenting FM_BUILD to report
# any marker not at a line start found ZERO across the compiler's own build (100+ includes)
# and all 330 `.tcyr`. Argued: all four PP_FMARK call sites emit at a line start, and
# ⭐ PP_REANCHOR ALREADY SAID SO AND ENFORCED IT — `# A marker must own its line.` followed
# by `if (op > 0) { if (load8(out + op - 1) != 10) { store8(out + op, 10); op = op + 1; } }`.
# The producer has required this since v6.5.19; FM_BUILD simply never checked what
# PP_FMARK already guarantees. (Same shape as ISELSE in lex_pp.cyr: an invariant written
# down and enforced at one site while its siblings went without.) CHANGELOG [6.6.6]
fn FM_ATBOL(buf, pos): i64 {
    if (pos == 0) { return 1; }
    if (load8(buf + pos - 1) == 10) { return 1; }
    return 0;
}

fn FM_BUILD(S): i64 {
    _fm_count = 0;
    _fm_str_pos = 0;
    _fm_overflowed = 0;
    var buf = S + 0x459D000;
    var bl = GBL(S);
    var line = 1;
    var pos = 0;
    # First pass: find all markers and their start lines
    while (pos < bl) {
        if (load8(buf + pos) == 35 && pos + 7 < bl && FM_ATBOL(buf, pos) == 1) {
            if (load8(buf + pos + 1) == 64 && load8(buf + pos + 2) == 102 && load8(buf + pos + 3) == 105 && load8(buf + pos + 4) == 108 && load8(buf + pos + 5) == 101 && load8(buf + pos + 6) == 32 && load8(buf + pos + 7) == 34) {
                var fstart = pos + 8;
                var fend = fstart;
                while (fend < bl && load8(buf + fend) != 34) { fend = fend + 1; }
                var flen = fend - fstart;
                if (flen > 0) {
                    if (_fm_count < 1024 && _fm_str_pos + flen + 1 <= 32768) {
                        # v6.5.0 Phase 1 — CANONICAL identity. One physical file now
                        # produces SEVERAL markers (one on entry plus a RESUME after each
                        # include it contains), so the entry index is no longer a file
                        # identity. Reuse the fname_offset of the first entry already
                        # carrying this name; FM_FILEID then derives the id from that
                        # offset, and every span belonging to one file answers alike.
                        # Also stops the 32 KB name scratch being consumed N times over
                        # for a file with N includes.
                        var canon = 0 - 1;
                        var ci = 0;
                        while (ci < _fm_count) {
                            var coff = load64(S + 0x71A040 + ci * 24 + 16);
                            var same = 1;
                            var k = 0;
                            while (k < flen) {
                                if (load8(S + 0x721000 + coff + k) != load8(buf + fstart + k)) { same = 0; k = flen; }
                                else { k = k + 1; }
                            }
                            if (same == 1) { if (load8(S + 0x721000 + coff + flen) != 0) { same = 0; } }
                            if (same == 1) { canon = coff; ci = _fm_count; }
                            else { ci = ci + 1; }
                        }
                        store64(S + 0x71A040 + _fm_count * 24, line + 1);
                        # v6.5.3 — parse the trailing ` BASE` the marker now carries and
                        # stash it in the HIGH 32 bits of the line-count word. The entry
                        # MUST stay 24 B (1024 of them have to fit 0x71A040..0x721000), and
                        # a line count never approaches 2^32, so the word has room. Pass 2
                        # ORs the count into the low half. Absent/garbage -> 1, i.e. the
                        # pre-v6.5.3 behaviour, so an old marker still parses.
                        var _fb = 0;
                        var _fp = fend + 1;
                        if (_fp < bl) { if (load8(buf + _fp) == 32) {
                                _fp = _fp + 1;
                                while (_fp < bl && load8(buf + _fp) >= 48 && load8(buf + _fp) <= 57) {
                                    _fb = _fb * 10 + (load8(buf + _fp) - 48);
                                    _fp = _fp + 1;
                                }
                            } }
                        if (_fb < 1) { _fb = 1; }
                        store64(S + 0x71A040 + _fm_count * 24 + 8, _fb * 4294967296);
                        if (canon >= 0) {
                            store64(S + 0x71A040 + _fm_count * 24 + 16, canon);
                        } else {
                            store64(S + 0x71A040 + _fm_count * 24 + 16, _fm_str_pos);
                            var fi = 0;
                            while (fi < flen) {
                                store8(S + 0x721000 + _fm_str_pos + fi, load8(buf + fstart + fi));
                                fi = fi + 1;
                            }
                            store8(S + 0x721000 + _fm_str_pos + flen, 0);
                            _fm_str_pos = _fm_str_pos + flen + 1;
                        }
                        _fm_count = _fm_count + 1;
                    } else {
                        # CVE-31: past the cap (or str scratch full), drop the marker
                        # but warn ONCE — silently dropping mis-attributes file:line in
                        # later error messages on big multi-include consumer builds.
                        if (_fm_overflowed == 0) {
                            syscall(SYS_WRITE, 2, "warning: file map full (1024 entries) -- file:line attribution truncated past here\n", 83);
                            _fm_overflowed = 1;
                        }
                    }
                }
            }
        }
        if (load8(buf + pos) == 10) { line = line + 1; }
        pos = pos + 1;
    }
    # v6.5.19 — a buffer that does not END in a newline still has a final, REAL line.
    # `line` counts newlines + 1, so when the last byte is `\n` it already sits one past
    # the last line, which is what the span arithmetic below wants. When it is not, it
    # names the last line instead of one past it, the LAST entry's count comes out one
    # short, and that final line falls OUT of every span. FM_LOOKUP then fell through to
    # PRNUM(expanded_line): a source with no trailing newline reported its last line as
    # a RAW EXPANDED line — past the file's own EOF, and with no `<file>:` prefix at all.
    # Measured on a 4-line source ending in an unterminated defect: `error:9:11:`, now
    # `error:<source>:4:11:`. Only the LAST span is affected; earlier spans are sized by
    # `next_start - start - 1` and an included file that lacks its final newline already
    # gets one from PP_REANCHOR.
    # NOT a `private`-visibility bug, though FM_FILEID shares this arithmetic: the last
    # marker in the stream is always the `<source>` RESUME (every include and every
    # derive re-anchors after itself), so a line falling out of it returns 0 = main
    # source, which is the same answer it would have given. Verified, not assumed —
    # a private fn on the unterminated last line of an included file warns identically
    # with and without this line. CHANGELOG [6.5.19].
    if (bl > 0) { if (load8(buf + bl - 1) != 10) { line = line + 1; } }
    # Second: compute line counts from start_line gaps
    var i = 0;
    while (i < _fm_count) {
        var start = load64(S + 0x71A040 + i * 24);
        var next_start = 0;
        if (i + 1 < _fm_count) {
            next_start = load64(S + 0x71A040 + (i + 1) * 24);
            store64(S + 0x71A040 + i * 24 + 8, (next_start - start - 1) | (load64(S + 0x71A040 + i * 24 + 8) & 0xFFFFFFFF00000000));
        } else {
            # Last file: count remaining lines to EOF
            store64(S + 0x71A040 + i * 24 + 8, (line - start) | (load64(S + 0x71A040 + i * 24 + 8) & 0xFFFFFFFF00000000));
        }
        i = i + 1;
    }
    store64(S + 0x71A000, _fm_count);
    return 0;
}

# Look up file:line for an expanded line number. Prints to stderr.
# Returns 1 if found, 0 if fallback to raw line number.
# v6.5.0 Phase 1 (public/private visibility) — the index-returning sibling of
# FM_LOOKUP below. FM_LOOKUP *prints* `file:line` for a diagnostic; this returns the
# identity instead, so a fn can be attributed to its origin file.
#
# Returns a **1-based file id**:
#     0        the line is not inside any included file -> the MAIN source
#     1..cnt   the file at file_map index (id - 1)
#    -1        the map OVERFLOWED and this line is past the last mapped file
#
# ⚠ THE -1 CASE IS LOAD-BEARING, do not fold it into 0. `file_map` caps at 1024
# entries / 32 KB of filename scratch (`_fm_overflowed`), and FM_LOOKUP's fall-through
# reports "main source" for anything it cannot find. That is fine for a diagnostic —
# it degrades to printing a raw line number. It is NOT fine for visibility: past the
# cap, EVERY unmapped file would collapse to the same identity, so `private` fns in
# two genuinely different files would be judged same-file and see each other. Silent
# mis-scoping, in the direction of wrongly ALLOWING access. Callers must fail closed
# on -1 rather than treat it as a file id.
fn FM_FILEID(S, expanded_line): i64 {
    var cnt = load64(S + 0x71A000);
    if (cnt == 0) { return 0; }
    var i = 0;
    while (i < cnt) {
        var start = load64(S + 0x71A040 + i * 24);
        # v6.5.3: MASK — the high 32 bits now carry the span's source-line base. Left
        # unmasked, `start + lines` overflows into the billions, the range check below is
        # true for the FIRST entry always, and every line resolves to one file id. That is
        # silent `private` mis-scoping (two different files judged same-file, access
        # wrongly ALLOWED), not just a bad diagnostic.
        var lines = load64(S + 0x71A040 + i * 24 + 8) & 0xFFFFFFFF;
        if (expanded_line >= start) {
            if (expanded_line < start + lines) {
                # Canonical: the NAME offset, not the entry index — one file spans
                # several entries once resume markers exist. +1 keeps it 1-based so 0
                # stays available for "not in any mapped file".
                return load64(S + 0x71A040 + i * 24 + 16) + 1;
            }
        }
        i = i + 1;
    }
    # Not in any mapped file. If the map is complete that genuinely means the main
    # source; if it overflowed we cannot tell, so say so instead of guessing.
    if (_fm_overflowed != 0) { return 0 - 1; }
    return 0;
}

fn FM_LOOKUP(S, expanded_line): i64 {
    var cnt = load64(S + 0x71A000);
    if (cnt == 0) { PRNUM(expanded_line); return 0; }
    # Find which file contains this line
    var i = 0;
    while (i < cnt) {
        var start = load64(S + 0x71A040 + i * 24);
        # v6.5.3: low 32 = line count, high 32 = the source line this span STARTS on.
        var _lw = load64(S + 0x71A040 + i * 24 + 8);
        var lines = _lw & 0xFFFFFFFF;
        var _base = _lw >> 32;          # `>>` is LOGICAL in cyrius (`>>>` is arithmetic)
        if (_base < 1) { _base = 1; }
        if (expanded_line >= start && expanded_line < start + lines) {
            var foff = load64(S + 0x71A040 + i * 24 + 16);
            var fptr = S + 0x721000 + foff;
            var flen = 0;
            while (load8(fptr + flen) != 0) { flen = flen + 1; }
            syscall(SYS_WRITE, 2, fptr, flen);
            syscall(SYS_WRITE, 2, ":", 1);
            PRNUM(expanded_line - start + _base);
            return 1;
        }
        i = i + 1;
    }
    # Line not in any included file — it's the main source
    PRNUM(expanded_line);
    return 0;
}

# v6.5.19 — print the file that a stored `_fnt_fileid` value names. SFFI stores
# FM_FILEID(...) + 1, and FM_FILEID returns the filename-scratch offset + 1 (0 = main
# source, -1 = the map overflowed), so the stored word is `foff + 2` for an included
# file, 1 for the main source, and 0 when nothing was recorded.
# Used by the `duplicate fn` warning to name where the LOSING definition came from —
# the filing's point was that one position cannot answer "which copy wins" on its own.
fn _fm_print_fid(S, v): i64 {
    if (v <= 0) { syscall(SYS_WRITE, 2, "<unknown>", 9); return 0; }
    if (v == 1) { syscall(SYS_WRITE, 2, "<source>", 8); return 0; }
    var p = S + 0x721000 + (v - 2);
    var n = 0;
    while (load8(p + n) != 0) { n = n + 1; }
    syscall(SYS_WRITE, 2, p, n);
    return 0;
}

# Store a token
fn ADDTOK(S, typ, val): i64 {
    var tc = GTCNT(S);
    # v6.5.39: 1048576 -> 4194304. The token arrays were 8 MiB each, boxed in between
    # fixup_tbl and preprocess_out; they are now 32 MiB each at the arena top. With the
    # preprocess ceiling raised 8 -> 24 MB, the OLD token cap became the new binding wall at
    # ~12 MB of realistic source (measured: 45 %-comment source tripped it at 12,582,940 B),
    # so raising preprocess_out alone would have moved the ceiling by only ~30 %, not 3x.
    if (tc >= 4194304) {
        # v5.8.46 (sit-surfaced): diagnostic prints actual `tc + 1`
        # so the next cap raise can be sized to an empirical M.
        # Cap was 262144 pre-v5.8.46; raised 4× to absorb sandhi-
        # consumer compile pressure (sit v0.7.2 with sandhi in
        # [deps].stdlib threshold-aborted at the 262144 cap).
        # Tok arrays relocated v5.8.46 from the 0x4D9D000 (overlap
        # with output_buf) / 0xD4A000 / 0xF4A000 trio (each 2 MiB
        # at those addresses) to the post-TS-region high block at
        # 0x8C00000 / 0xAC00000 / 0xCC00000 (each 8 MiB), brk
        # extended to S + 0x457C000 in every main_*.cyr.
        syscall(SYS_WRITE, 2, "error: token limit exceeded: needed ", 36);
        PRNUM(tc + 1);
        syscall(SYS_WRITE, 2, ", cap is 4194304\n", 17);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x8C00000 + tc * 8, typ);
    S64(S + 0xAC00000 + tc * 8, val);
    # v6.4.60 (DX): pack the token-start byte offset into the high 32 bits, line in
    # the low 32. GTLINE masks it off (line-only readers unaffected); GTOFF reads it.
    STLINE(S, tc, (_tok_start << 32) | GCLINE(S));
    STCNT(S, tc + 1);
    return 0;
}

# Classify character: 0=other, 1=ws, 2=digit, 3=lower, 4=upper, 5=underscore
fn CCLASS(c): i64 {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    if (c == 10) { return 1; }
    if (c == 13) { return 1; }
    if (c >= 48) { if (c <= 57) { return 2; } }
    if (c >= 97) { if (c <= 122) { return 3; } }
    if (c >= 65) { if (c <= 90) { return 4; } }
    if (c == 95) { return 5; }
    return 0;
}

fn ISALNUM(c): i64 {
    var cl = CCLASS(c);
    if (cl >= 2) { return 1; }
    return 0;
}

# v5.7.13: ASCII hex digit -> value [0..15], or -1 if not a hex digit.
# Used by string-literal `\x##` and `\u####` / `\u{...}` decoders.
fn _LEX_HEX_VAL(c): i64 {
    if (c >= 48) { if (c <= 57) { return c - 48; } }
    if (c >= 97) { if (c <= 102) { return c - 87; } }
    if (c >= 65) { if (c <= 70) { return c - 55; } }
    return 0 - 1;
}

# v5.7.13: emit codepoint cp as UTF-8 into str_data at S+0x21A000+spos.
# Returns the new spos. Callers must reject surrogates (D800-DFFF)
# and codepoints > U+10FFFF before calling.
fn _LEX_EMIT_UTF8(S, spos, cp): i64 {
    var dst = S + 0x21A000;
    var need = 1;
    if (cp >= 128) { need = 2; }
    if (cp >= 2048) { need = 3; }
    if (cp >= 65536) { need = 4; }
    if (spos + need > 2097152) {
        syscall(SYS_WRITE, 2, "error: string data overflow (2MB limit)\n", 40);
        syscall(SYS_EXIT, 1);
    }
    if (cp < 128) {
        store8(dst + spos, cp);
    }
    elif (cp < 2048) {
        store8(dst + spos, 192 | (cp >> 6));
        store8(dst + spos + 1, 128 | (cp & 63));
    }
    elif (cp < 65536) {
        store8(dst + spos, 224 | (cp >> 12));
        store8(dst + spos + 1, 128 | ((cp >> 6) & 63));
        store8(dst + spos + 2, 128 | (cp & 63));
    }
    else {
        store8(dst + spos, 240 | (cp >> 18));
        store8(dst + spos + 1, 128 | ((cp >> 12) & 63));
        store8(dst + spos + 2, 128 | ((cp >> 6) & 63));
        store8(dst + spos + 3, 128 | (cp & 63));
    }
    return spos + need;
}

# ================================================================
# INCLUDE / FILE I/O / PREPROCESSOR
# ================================================================

# ── The `lib/...` include fallback: THIS cycc's own store slot ──────────────────────────
# A `lib/<leaf>.cyr` include that does not open in the CWD is retried by READFILE (below)
# against ONE store slot, the one named by this cycc's own version (`_VERSION_TOOLCHAIN`):
#   CYRIUS_HOME/versions/<VERSION>/lib/      when CYRIUS_HOME is set and non-empty
#   HOME/.cyrius/versions/<VERSION>/lib/     otherwise
# — the home the CLI resolves (cbt `_home`), so `cyrius` and a raw cycc read one stdlib.
# ⛔ A set CYRIUS_HOME is AUTHORITATIVE: no fall-through to HOME's slot when its slot lacks
# a file (that compiles a mix of two stdlibs, the misattribution this exists to end), and
# an over-long one disables the fallback rather than falling back to HOME. An EMPTY
# CYRIUS_HOME (or HOME) is unset — not the root-anchored `/versions/...`. Until 6.6.16 only
# `HOME=` was read, and only the first 4 KB of the environment. CHANGELOG [6.6.16]
# Why version-PINNED (never the `~/.cyrius/lib` symlink): a cycc compiling against another
# version's stdlib emits calls to helpers that lib lacks. CHANGELOG [5.10.9]
# Linux-targeted builds only — /proc/self/environ; the macOS and PE-native cycc have no
# fallback. CHANGELOG [5.5.9]
var _cyrius_lib[256];    # 2048 B: a bare top-level array is N*8 bytes (v6.4.10)
var _cyrius_lib_len = 0;

#ifdef CYRIUS_TARGET_LINUX
# Append the NUL-terminated `s` to the fallback path. 0, or -1 when it would not fit the
# 2048-B buffer: the caller then disables the fallback, because a TRUNCATED path names a
# DIFFERENT directory (CVE-34). CHANGELOG [6.6.16]
fn _cl_append(s): i64 {
    var i = 0;
    while (load8(s + i) != 0) {
        if (_cyrius_lib_len >= 2047) { return 0 - 1; }
        store8(&_cyrius_lib + _cyrius_lib_len, load8(s + i));
        _cyrius_lib_len = _cyrius_lib_len + 1;
        i = i + 1;
    }
    store8(&_cyrius_lib + _cyrius_lib_len, 0);
    return 0;
}

# The environ scan's state, `st` (i64 slots), carried across reads so an entry split between
# two chunks still matches:
#   +0  bytes into the current entry      +8  name bits still matching: 1 CYRIUS_HOME=, 2 HOME=
#   +16 capturing: 0 no, 1 CYRIUS_HOME, 2 HOME                +24 bytes captured
#   +32 CYRIUS_HOME length  +40 HOME length: -1 absent, -2 over 1984 B (unusable, never
#                                            truncated — CVE-34's bound), else the length
#   +48 CYRIUS_HOME buffer  +56 HOME buffer (2048 B each, NUL-terminated)
# A capture slot is at st + 24 + 8*which and its buffer at st + 40 + 8*which.

# Keep `bit` in `mt` only while byte `ep` of the entry still spells `name` (`nl` bytes).
fn _env_name_bit(mt, bit, name, nl, ep, c): i64 {
    if ((mt & bit) == 0) { return mt; }
    if (ep < nl) {
        if (load8(name + ep) == c) { return mt; }
    }
    return mt - bit;
}

# `name=` just completed for variable `which`. The FIRST occurrence wins, as getenv and
# _read_env do: a later duplicate is not captured.
fn _env_cap_start(st, which): i64 {
    store64(st + 8, 0);
    if (load64(st + 24 + 8 * which) != 0 - 1) { return 0; }
    store64(st + 16, which);
    store64(st + 24, 0);
    return 0;
}

# The entry being captured ended: record its length (-2 when it overflowed).
fn _env_cap_end(st, which): i64 {
    var k = load64(st + 24);
    if (k > 1984) { store64(st + 24 + 8 * which, 0 - 2); return 0; }
    store8(load64(st + 40 + 8 * which) + k, 0);
    store64(st + 24 + 8 * which, k);
    return 0;
}

# Feed one environ byte `c` to the scan.
fn _env_step(st, c): i64 {
    var cap = load64(st + 16);
    if (c == 0) {
        if (cap != 0) { _env_cap_end(st, cap); }
        store64(st, 0);
        store64(st + 8, 3);
        store64(st + 16, 0);
        return 0;
    }
    if (cap != 0) {
        var k = load64(st + 24);
        if (k < 1984) { store8(load64(st + 40 + 8 * cap) + k, c); }
        if (k <= 1984) { store64(st + 24, k + 1); }
        return 0;
    }
    var ep = load64(st);
    store64(st, ep + 1);
    var mt = load64(st + 8);
    if (mt == 0) { return 0; }
    mt = _env_name_bit(mt, 1, "CYRIUS_HOME=", 12, ep, c);
    mt = _env_name_bit(mt, 2, "HOME=", 5, ep, c);
    store64(st + 8, mt);
    if ((mt & 1) != 0 && ep == 11) { _env_cap_start(st, 1); }
    if ((mt & 2) != 0 && ep == 4) { _env_cap_start(st, 2); }
    return 0;
}

# ONE pass over /proc/self/environ, read in chunks TO EOF (it was a single 4096-B read, so
# a HOME past the first 4 KB of the environment was silently missed). No heap, and not
# _read_env: this captures BOTH paths in one pass, each up to 1984 B, where _read_env holds
# one value of at most 255 B. 0, or -1 (unreadable: no fallback). The open matches
# READFILE's: aarch64 has only openat. CHANGELOG [5.11.27]
fn _env_scan_homes(st): i64 {
    var fd = 0;
    if (SYS_OPEN == 2) { fd = syscall(SYS_OPEN, "/proc/self/environ", 0, 0); }
    else { fd = syscall(SYS_OPEN, 0 - 100, "/proc/self/environ", 0, 0); }
    if (fd < 0) { return 0 - 1; }
    var buf[4096];
    var n = syscall(SYS_READ, fd, &buf, 4096);
    while (n > 0) {
        var i = 0;
        while (i < n) {
            _env_step(st, load8(&buf + i));
            i = i + 1;
        }
        n = syscall(SYS_READ, fd, &buf, 4096);
    }
    syscall(SYS_CLOSE, fd);
    if (n < 0) { return 0 - 1; }
    _env_step(st, 0);   # end an unterminated last entry
    return 0;
}

# Build the slot path from the scan's two values (see the block comment above). 1, or 0
# for no fallback.
fn _cl_select(st): i64 {
    var chl = load64(st + 32);
    if (chl == 0 - 2) { return 0; }
    if (chl > 0) {
        if (_cl_append(load64(st + 48)) != 0) { return 0; }
    } else {
        if (load64(st + 40) <= 0) { return 0; }
        if (_cl_append(load64(st + 56)) != 0) { return 0; }
        if (_cl_append("/.cyrius") != 0) { return 0; }
    }
    if (_cl_append("/versions/") != 0) { return 0; }
    if (_cl_append(_VERSION_TOOLCHAIN) != 0) { return 0; }
    if (_cl_append("/lib/") != 0) { return 0; }
    return 1;
}
#endif

fn _init_cyrius_lib(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var st[64];
    var ch[2048];
    var hm[2048];
    store64(&st, 0);
    store64(&st + 8, 3);
    store64(&st + 16, 0);
    store64(&st + 24, 0);
    store64(&st + 32, 0 - 1);
    store64(&st + 40, 0 - 1);
    store64(&st + 48, &ch);
    store64(&st + 56, &hm);
    _cyrius_lib_len = 0;
    var ok = 0;
    if (_env_scan_homes(&st) == 0) { ok = _cl_select(&st); }
    if (ok != 1) {
        _cyrius_lib_len = 0;
        store8(&_cyrius_lib, 0);
        return 0;
    }
    # Once, after EITHER home selected the slot (it ran on the HOME branch only until
    # 6.6.16). CHANGELOG [5.11.57]
    _check_cyml_pin_drift();
    return 1;
    #endif
    return 0;
}

# v6.4.66: `_check_shadow_lib` + `_file_size` were RETIRED here. The one-line
# shadow-lib note they emitted is superseded by the CLI wrapper's version-aware
# `_check_lib_freshness` (cbt/, v6.4.63), which is stronger (names per-lib version
# skew, works on all four hosts, no single-sentinel false negative). Removing them
# also drops ~80 lines of global/call-heavy frontend from cycc (a cybs-ceiling
# liability). `CYRIUS_NO_WARN_SHADOW_LIB` is still honored by the wrapper check.
# See docs/development/issues/archived/2026-07-14-converge-cycc-shadow-lib-sentinel.md.

# v5.11.57: the shared opt-out env probe — 1 when the FIRST entry named `name` has the value
# exactly "1", else 0. Used by _check_cyml_pin_drift (CYRIUS_NO_WARN_PIN_DRIFT,
# CYRIUS_STRICT_PIN). 6.6.17 gave it its own chunked /proc/self/environ scan because
# `_read_env` then read only the first 8 KB; 6.6.20 made `_read_env` read to EOF, so this is
# that one walker again (a value over 255 B is refused there, and is not "1" anyway).
# CHANGELOG [6.6.20]
fn _env_var_is_1(name): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var v = _read_env(name);
    if (v != 0) {
        if (load8(v) == 49) { if (load8(v + 1) == 0) { return 1; } }
    }
    #endif
    return 0;
}

# v5.11.57: detect toolchain drift between cwd's
# cyrius.cyml [package].cyrius = "X.Y.Z" pin and cycc's own
# compile-time version. Iron-boot papercut filing Item 1: the
# wrapper has been stuck at .25 since 2026-05-12 (install.sh
# rebuild-staleness misses src/version_str.cyr as transitive
# dep), so consumers see `cyrius --version: 5.11.25` even when
# they pin .55+ in cyml. cycc IS rebuilt every bump for
# self-host, so cycc's compile-time _VERSION_STR_CYCC is the
# authoritative current version. Emitting from cycc surfaces
# the drift regardless of wrapper-rebuild state. Wrapper-side
# fixes (--strict-pin CLI flag, --version manifest-pin line,
# cyrius lib sync, install.sh rebuild fix) land in v5.11.58.
fn _check_cyml_pin_drift(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var _pd_no = "CYRIUS_NO_WARN_PIN_DRIFT";
    if (_env_var_is_1(_pd_no) == 1) { return 0; }
    var _pd_fd = 0;
    if (SYS_OPEN == 2) { _pd_fd = syscall(SYS_OPEN, "cyrius.cyml", 0, 0); }
    else { _pd_fd = syscall(SYS_OPEN, 0 - 100, "cyrius.cyml", 0, 0); }
    if (_pd_fd < 0) { return 0; }
    var _pd_buf[32768];
    var _pd_clen = syscall(0, _pd_fd, &_pd_buf, 32767);
    syscall(3, _pd_fd);
    if (_pd_clen <= 0) { return 0; }
    store8(&_pd_buf + _pd_clen, 0);
    var _pd_pos = 0;
    var _pd_found_pkg = 0;
    while (_pd_pos < _pd_clen - 8) {
        if (load8(&_pd_buf + _pd_pos) == 91) {
            if (load8(&_pd_buf + _pd_pos + 1) == 112) {
                if (load8(&_pd_buf + _pd_pos + 2) == 97) {
                    if (load8(&_pd_buf + _pd_pos + 3) == 99) {
                        if (load8(&_pd_buf + _pd_pos + 4) == 107) {
                            if (load8(&_pd_buf + _pd_pos + 5) == 97) {
                                if (load8(&_pd_buf + _pd_pos + 6) == 103) {
                                    if (load8(&_pd_buf + _pd_pos + 7) == 101) {
                                        if (load8(&_pd_buf + _pd_pos + 8) == 93) {
                                            _pd_found_pkg = 1;
                                            _pd_pos = _pd_pos + 9;
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        _pd_pos = _pd_pos + 1;
    }
    if (_pd_found_pkg == 0) { return 0; }
    var _pd_pin_start = 0 - 1;
    var _pd_pin_end = 0 - 1;
    while (_pd_pos < _pd_clen) {
        while (_pd_pos < _pd_clen && (load8(&_pd_buf + _pd_pos) == 10 || load8(&_pd_buf + _pd_pos) == 32 || load8(&_pd_buf + _pd_pos) == 9 || load8(&_pd_buf + _pd_pos) == 13)) {
            _pd_pos = _pd_pos + 1;
        }
        if (_pd_pos >= _pd_clen) { break; }
        if (load8(&_pd_buf + _pd_pos) == 91) { break; }
        if (_pd_pos + 6 <= _pd_clen) {
            if (load8(&_pd_buf + _pd_pos) == 99) {
                if (load8(&_pd_buf + _pd_pos + 1) == 121) {
                    if (load8(&_pd_buf + _pd_pos + 2) == 114) {
                        if (load8(&_pd_buf + _pd_pos + 3) == 105) {
                            if (load8(&_pd_buf + _pd_pos + 4) == 117) {
                                if (load8(&_pd_buf + _pd_pos + 5) == 115) {
                                    var _pd_after = _pd_pos + 6;
                                    while (_pd_after < _pd_clen && (load8(&_pd_buf + _pd_after) == 32 || load8(&_pd_buf + _pd_after) == 9)) { _pd_after = _pd_after + 1; }
                                    if (_pd_after < _pd_clen && load8(&_pd_buf + _pd_after) == 61) {
                                        _pd_after = _pd_after + 1;
                                        while (_pd_after < _pd_clen && (load8(&_pd_buf + _pd_after) == 32 || load8(&_pd_buf + _pd_after) == 9)) { _pd_after = _pd_after + 1; }
                                        if (_pd_after < _pd_clen && load8(&_pd_buf + _pd_after) == 34) {
                                            _pd_after = _pd_after + 1;
                                            _pd_pin_start = _pd_after;
                                            while (_pd_after < _pd_clen && load8(&_pd_buf + _pd_after) != 34) { _pd_after = _pd_after + 1; }
                                            _pd_pin_end = _pd_after;
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        while (_pd_pos < _pd_clen && load8(&_pd_buf + _pd_pos) != 10) { _pd_pos = _pd_pos + 1; }
    }
    if (_pd_pin_start < 0) { return 0; }
    if (_pd_pin_end <= _pd_pin_start) { return 0; }
    var _pd_pin_len = _pd_pin_end - _pd_pin_start;
    # cycc self-version: skip "cycc " (5 chars), read until '\n'.
    # v6.0.1: was 4 (correct for the old "cc5 " prefix), missed at
    # v6.0.0 rename — substring read started at the trailing space so
    # length-mismatch fired pin-drift warning even when cyml pin and
    # cycc version matched. See CHANGELOG [6.0.1].
    var _pd_self_start = 5;
    var _pd_self_end = _pd_self_start;
    while (_pd_self_end < _VERSION_LEN_CYCC && load8(_VERSION_STR_CYCC + _pd_self_end) != 10) {
        _pd_self_end = _pd_self_end + 1;
    }
    var _pd_self_len = _pd_self_end - _pd_self_start;
    if (_pd_pin_len == _pd_self_len) {
        var _pd_match = 1;
        var _pd_mi = 0;
        while (_pd_mi < _pd_pin_len) {
            if (load8(&_pd_buf + _pd_pin_start + _pd_mi) != load8(_VERSION_STR_CYCC + _pd_self_start + _pd_mi)) { _pd_match = 0; break; }
            _pd_mi = _pd_mi + 1;
        }
        if (_pd_match == 1) { return 0; }
    }
    var _pd_strict_name = "CYRIUS_STRICT_PIN";
    var _pd_strict = _env_var_is_1(_pd_strict_name);
    if (_pd_strict == 1) {
        syscall(1, 2, "error: cyrius.cyml pins ", 24);
        syscall(1, 2, &_pd_buf + _pd_pin_start, _pd_pin_len);
        syscall(1, 2, " but cycc is ", 13);
        syscall(1, 2, _VERSION_STR_CYCC + _pd_self_start, _pd_self_len);
        syscall(1, 2, " — toolchain drift (CYRIUS_STRICT_PIN)\n", 41);
        syscall(60, 1);
    }
    syscall(1, 2, "warning: cyrius.cyml pins ", 26);
    syscall(1, 2, &_pd_buf + _pd_pin_start, _pd_pin_len);
    syscall(1, 2, " but cycc is ", 13);
    syscall(1, 2, _VERSION_STR_CYCC + _pd_self_start, _pd_self_len);
    syscall(1, 2, " — toolchain drift (snapshot may be stale; set CYRIUS_NO_WARN_PIN_DRIFT=1 to silence)\n", 88);
    #endif
    return 0;
}

# Read a file into buffer at dst, return bytes read. Path must be null-terminated.
# 1 when a fallback path — `pre` bytes of prefix, then `path` from byte `skip` — fits READFILE's
# 4096-B buffer with its NUL; else it names the include and returns 0 (the caller returns -1,
# which the preprocessor turns into a hard error). CHANGELOG [6.6.17]
fn _rf_fits(path, skip, pre): i64 {
    var n = 0;
    while (load8(path + n) != 0) { n = n + 1; }
    if (pre + n - skip <= 4095) { return 1; }
    syscall(SYS_WRITE, 2, "error: include path too long for the fallback directory (", 57);
    PRNUM(pre + n - skip);
    syscall(SYS_WRITE, 2, " bytes, the limit is 4095): ", 28);
    syscall(SYS_WRITE, 2, path, n);
    syscall(SYS_WRITE, 2, "\n", 1);
    return 0;
}

fn READFILE(path, dst, maxsz): i64 {
    # CVE-02: reject path traversal (.. components) UNLESS explicitly
    # allowed via CYRIUS_ALLOW_PARENT_INCLUDES=1. Bote (and any project
    # with sibling-directory deps via `[deps.X] path = "../foo"`) needs
    # the override; default behavior stays strict for untrusted-source
    # builds. `cyrius build` can set the env automatically when it
    # resolves deps with a relative `..` path.
    var _env_parent = _read_env("CYRIUS_ALLOW_PARENT_INCLUDES");
    var allow_parent = 0;
    if (_env_parent != 0) {
        if (load8(_env_parent) == 49 && load8(_env_parent + 1) == 0) {
            allow_parent = 1;
        }
    }
    if (allow_parent == 0) {
        var pi = 0;
        while (load8(path + pi) != 0) {
            if (load8(path + pi) == 46 && load8(path + pi + 1) == 46) {
                if (pi == 0 || load8(path + pi - 1) == 47) {
                    syscall(SYS_WRITE, 2, "error: path traversal rejected: ", 32);
                    var plen = 0;
                    while (load8(path + plen) != 0) { plen += 1; }
                    syscall(SYS_WRITE, 2, path, plen);
                    syscall(SYS_WRITE, 2, " (set CYRIUS_ALLOW_PARENT_INCLUDES=1 to permit)\n", 48);
                    # CVE-02/CO-02 (v6.1.41): return -1 so the PP's `nr < 0` guards fire
                    # SYS_EXIT — a rejected hostile include must FAIL the build, not be
                    # treated as a silent empty include (exit 0 after printing 'error:').
                    return 0 - 1;
                }
            }
            pi += 1;
        }
    }
    # CVE-16 (v6.1.33): reject absolute include paths (leading '/') UNLESS
    # CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 — completes the CVE-02 spec (the v4.x fix
    # landed only the '..' half). A hostile `.cyr` could `include "/home/u/.ssh/id_rsa"`
    # and surface the contents via error text / embedded output. The store-slot
    # `lib/` fallback below builds its own path from CYRIUS_HOME or HOME
    # (`_init_cyrius_lib`) and opens it directly (not through this guard), so it
    # is unaffected.
    var _env_abs = _read_env("CYRIUS_ALLOW_ABSOLUTE_INCLUDES");
    var allow_abs = 0;
    if (_env_abs != 0) {
        if (load8(_env_abs) == 49 && load8(_env_abs + 1) == 0) {
            allow_abs = 1;
        }
    }
    if (allow_abs == 0) {
        if (load8(path) == 47) {
            syscall(SYS_WRITE, 2, "error: absolute include path rejected: ", 39);
            var alen = 0;
            while (load8(path + alen) != 0) { alen += 1; }
            syscall(SYS_WRITE, 2, path, alen);
            syscall(SYS_WRITE, 2, " (set CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 to permit)\n", 50);
            # CVE-16/CO-02 (v6.1.41): return -1 (fatal) — see the parent-include reject.
            return 0 - 1;
        }
    }
    var fd = 0;
    if (SYS_OPEN == 2) { fd = syscall(SYS_OPEN, path, 0, 0); }
    # The openat arm (here and at the two fallbacks below) is dead in a PE compiler —
    # main_win.cyr declares SYS_OPEN = 2 — and a 4-argument open is not a PE route, so each
    # drew a "not routed" warning in every cycc_win build: noise that hides a real unrouted
    # call. Compiled out there. CHANGELOG [6.6.20]
    #ifndef CYRIUS_TARGET_WIN
    else { fd = syscall(SYS_OPEN, 0 - 100, path, 0, 0); }
    #endif
    # Fallback: if open fails and path starts with "lib/", try the store slot
    # `_init_cyrius_lib` chose — CYRIUS_HOME/versions/<VERSION>/lib/, else
    # HOME/.cyrius/versions/<VERSION>/lib/ — with `lib/` replaced by it.
    if (fd < 0) {
        if (_cyrius_lib_len > 0) {
            if (load8(path) == 108) { if (load8(path + 1) == 105) { if (load8(path + 2) == 98) { if (load8(path + 3) == 47) {
                            # Build fallback path: _cyrius_lib + (path + 4)
                            # v6.4.81 (CVE-33): the copies were unbounded into a 512-B
                            # local. 6.6.17: a path that does not fit is REFUSED by
                            # name (`_rf_fits`) — the loops used to stop at 4095 and
                            # open the PREFIX, which can name a different file. Not
                            # reachable today (`path` <= 767 B, PP_FNAME_TOO_LONG;
                            # the slot prefix <= ~2013 B), enforced all the same.
                            if (_rf_fits(path, 4, _cyrius_lib_len) == 0) { return 0 - 1; }
                            var fbuf[4096];
                            var fi = 0;
                            while (fi < _cyrius_lib_len) { store8(&fbuf + fi, load8(&_cyrius_lib + fi)); fi = fi + 1; }
                            var pi = 4;
                            while (load8(path + pi) != 0) { store8(&fbuf + fi, load8(path + pi)); fi = fi + 1; pi = pi + 1; }
                            store8(&fbuf + fi, 0);
                            if (SYS_OPEN == 2) { fd = syscall(SYS_OPEN, &fbuf, 0, 0); }
                            #ifndef CYRIUS_TARGET_WIN
                            else { fd = syscall(SYS_OPEN, 0 - 100, &fbuf, 0, 0); }
                            #endif
                        } } } }
        }
    }
    # v6.5.7: LAST-RESORT fallback — retry relative to the top-level source's own
    # directory (`#@incdir`, see common/util.cyr). Placed after every existing
    # resolution step ON PURPOSE: CWD-first means no path that resolves today can
    # change where it resolves to, so this is provably additive — it can only turn
    # a build that fails into one that succeeds. It is what makes
    # `cyrius build src/sub/a.cyr` able to `include "b.cyr"` for the sibling file
    # sitting next to it.
    #
    # `path` has already cleared the CVE-02 (`..`) and CVE-16 (absolute) guards
    # above, and `_pp_incdir` is relative and `..`-free by construction, so the
    # composed path cannot escape the CWD subtree. The open is direct rather than
    # recursive: re-entering READFILE would re-run guards that both halves have
    # already passed, and would recurse.
    if (fd < 0) {
        if (_pp_incdir_len > 0) {
            # 6.6.17: refused by name when it does not fit, as the store-slot copy above.
            if (_rf_fits(path, 0, _pp_incdir_len + 1) == 0) { return 0 - 1; }
            var ibuf[4096];
            var ii2 = 0;
            while (ii2 < _pp_incdir_len) { store8(&ibuf + ii2, load8(&_pp_incdir + ii2)); ii2 = ii2 + 1; }
            store8(&ibuf + ii2, 47);
            ii2 = ii2 + 1;
            var pj = 0;
            while (load8(path + pj) != 0) { store8(&ibuf + ii2, load8(path + pj)); ii2 = ii2 + 1; pj = pj + 1; }
            store8(&ibuf + ii2, 0);
            if (SYS_OPEN == 2) { fd = syscall(SYS_OPEN, &ibuf, 0, 0); }
            #ifndef CYRIUS_TARGET_WIN
            else { fd = syscall(SYS_OPEN, 0 - 100, &ibuf, 0, 0); }
            #endif
        }
    }
    # CVE-31: distinguish open-fail from a legitimately-empty file. Return -1
    # when the path could not be opened (after the store-slot `lib/` fallback
    # and the `#@incdir` retry);
    # the PP include sites hard-error on -1. A successfully-opened empty file
    # still returns 0 (a valid, silent no-op include).
    if (fd < 0) { return 0 - 1; }
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = syscall(SYS_READ, fd, dst + total, maxsz - total);
        if (n <= 0) { rgo = 0; }
        else {
            total = total + n;
            if (total >= maxsz) { rgo = 0; }
        }
    }
    syscall(SYS_CLOSE, fd);
    return total;
}

# Check if buffer at pos starts with "include " (8 chars)
# Check for "#ref " directive (5 bytes: # r e f space)

# v5.5.38: preprocessor (PP_*) passes + predicates extracted.
include "src/frontend/lex_pp.cyr"

# WORD BOUNDARY after an attribute name in the `#` branch of LEX.
#
# WHY: every attribute test there (`#assert`, `#regalloc`, `#deprecated`,
# `#must_use`, `#pure`, `#io`, `#alloc`, `#naked`, `#inline`, `#pe_import`)
# compared a byte PREFIX and then kept lexing the SAME line, with no check that
# the name actually ENDED. So a comment whose first word merely starts with an
# attribute name was parsed as code: `#ioctl numbers` lexed as `#io` + the
# identifier `ctl`, and the diagnostic pointed at the comment's second word.
# The set of words that broke a comment was invisible to the author.
#
# Only whitespace, end of input, or `(` can legitimately follow an attribute
# name, so anything else means this `#` opens an ordinary comment. Strictly more
# permissive: no program that compiles today can contain `#io` followed by a
# non-boundary byte, because today the tail is parsed as code and fails.
#
# `ap` — ALLOW PAREN, and only three of the ten sites pass 1. The first cut took
# `(` as a boundary everywhere, which left the filed defect standing for a
# narrower input class: `#io(fd) reads a byte` still died with `unexpected '('`,
# and so did `#naked(truth)`, `#pure(ly)`, `#alloc(16)`, `#inline(always)`,
# `#must_use(result)` and `#regalloc(2)`. For those seven the `(` form is not
# syntax, so the line is a comment. `#deprecated(` and `#pe_import(` ARE syntax.
# ⚠ `#assert(` passes 1 as well although it is not syntax either: it is the one
# attribute whose parenthesised form the compiler already REJECTS OUT LOUD
# (`#assert: expected constant expression`), and turning that into a comment
# would silently DROP a compile-time assertion the author wrote. A loud error on
# a rare prose comment beats a silent hole in an assertion. CHANGELOG [6.6.6]
#
# 6.6.20 — reads `base + q` (bounded by `n`) rather than the lexer's own buffer, so the
# preprocessor can ask the same question of whichever buffer it is walking (LEXATTRWORD).
fn LEXATTRBOUND(base, q, n, ap): i64 {
    if (q >= n) { return 1; }
    var b = load8(base + q);
    if (b == 32) { return 1; }
    if (b == 9) { return 1; }
    if (b == 10) { return 1; }
    if (b == 13) { return 1; }
    if (b == 40) { if (ap == 1) { return 1; } }
    return 0;
}

# The length of attribute word `w` (a NUL-terminated name, no `#`) when it follows the `#`
# at `base + q` and ends on an attribute boundary (LEXATTRBOUND, `ap` as there); else 0.
fn _lex_attr_is(base, q, n, w, ap): i64 {
    var k = 0;
    while (load8(w + k) != 0) {
        if (q + 1 + k >= n) { return 0; }
        if (load8(base + q + 1 + k) != load8(w + k)) { return 0; }
        k = k + 1;
    }
    if (LEXATTRBOUND(base, q + 1 + k, n, ap) == 0) { return 0; }
    return k;
}

# ⛔ 6.6.20 (CVE-TBD) — THE ONE LIST of `#` attributes: the `#` at `base + q` (bounded by
# `n`) spells one of them, packed `token * 16 + name length`, else 0 (the `#` opens a
# comment). LEX emits the token and keeps lexing the SAME LINE as code.
#
# WHY ONE LIST, SHARED. The preprocessor decides "is this line a directive / is this byte in
# a string" with its own lexical state machine (PP_LEXST). Until 6.6.20 that machine read
# EVERY `#` in code as a comment opener, while this lexer lexes an attribute's line as code
# — string literals included, and a literal may hold a raw LF. So after
# `#assert 1 == 1, "x<LF>"` the two disagreed for as long as the next line ran: the PP
# read the literal's CLOSING quote as an opening one and stayed "in a string" while the
# lexer was in code. A `#@file "secret.cyr" 1` line there was skipped by the neutraliser
# (PP_NEUT_FMARK leaves string bytes alone) and minted by FM_BUILD, and a `private` fn of
# secret.cyr was CALLED (built, exit 42; the same call without the forged line is refused).
# The same desync made the PP skip a real `#ifdef CYRIUS_TARGET_WIN` line (the lexer then
# read it as a comment and compiled the Windows-only arm on Linux), and execute a
# `#define` it should have kept as string data. 6.6.6 declined to teach the PP the list
# for fear the two copies would drift; with ONE list there is nothing to drift, and the PP
# asks this function (PP_LEXST_AT). No line-start rule: LEX has none either.
#
#   #assert      token 107 = HASH_ASSERT       ap   (v4.x)
#   #regalloc    token 109 = HASH_REGALLOC          (4.8.4) opt-in register allocation
#   #deprecated  token 124 = HASH_DEPRECATED   ap   (v5.6.4) warns at every call site
#   #must_use    token 122 = HASH_MUST_USE          (v5.6.3) a dropped result warns
#   #pure        token 125 = HASH_PURE              (v5.8.20)
#   #io          token 126 = HASH_IO                (v5.8.20)
#   #alloc       token 127 = HASH_ALLOC             (v5.8.20)
#   #naked       token 133 = HASH_NAKED             (v6.2.27) no prologue/epilogue (an ISR)
#   #inline      token 163 = HASH_INLINE            (v6.5.63) admits the fn to inline replay
#   #pe_import   token 110 = HASH_PE_IMPORT    ap   (v5.4.6) PE32+ import registration
# (`ap` = `(` may follow: the three whose parenthesised form is syntax — see LEXATTRBOUND.)
# tests/gates/frontend/lexer_attribute_word_boundary.sh derives its census from this table
# and from the `_lex_attr_is` rows below, and fails if they and its probe table disagree.
# CHANGELOG [6.6.20]
fn LEXATTRWORD(base, q, n): i64 {
    if (q + 2 >= n) { return 0; }
    var c1 = load8(base + q + 1);
    if (c1 < 97) { return 0; }
    if (c1 > 122) { return 0; }
    var k = _lex_attr_is(base, q, n, "assert", 1);
    if (k > 0) { return 107 * 16 + k; }
    k = _lex_attr_is(base, q, n, "regalloc", 0);
    if (k > 0) { return 109 * 16 + k; }
    k = _lex_attr_is(base, q, n, "deprecated", 1);
    if (k > 0) { return 124 * 16 + k; }
    k = _lex_attr_is(base, q, n, "must_use", 0);
    if (k > 0) { return 122 * 16 + k; }
    k = _lex_attr_is(base, q, n, "pure", 0);
    if (k > 0) { return 125 * 16 + k; }
    k = _lex_attr_is(base, q, n, "io", 0);
    if (k > 0) { return 126 * 16 + k; }
    k = _lex_attr_is(base, q, n, "alloc", 0);
    if (k > 0) { return 127 * 16 + k; }
    k = _lex_attr_is(base, q, n, "naked", 0);
    if (k > 0) { return 133 * 16 + k; }
    k = _lex_attr_is(base, q, n, "inline", 0);
    if (k > 0) { return 163 * 16 + k; }
    k = _lex_attr_is(base, q, n, "pe_import", 1);
    if (k > 0) { return 110 * 16 + k; }
    return 0;
}

# ⛔ 6.6.10 — a hex, octal or decimal literal whose value does not fit in 64 bits is an
# ERROR. The three lexers accumulated with no check, so `0x10000000000000001` was 1 and
# `99999999999999999999` was 0x6bc75e2d630fffff, silently. 2^63..2^64-1 stays legal (it is
# how a bit pattern with the sign bit set is written). CHANGELOG [6.6.10]
fn _lex_int_ovf(S): i64 {
    _lex_die(S, _tok_start, "integer literal does not fit in 64 bits");
    return 0;
}

fn LEXHEX(S, p): i64 {
    var val = 0;
    var ovf = 0;
    var go = 1;
    while (go == 1) {
        if (p >= GBL(S)) { go = 0; }
        if (go == 1) {
            var c = load8(S + 0x459D000 + p);
            # Underscore separator (e.g. 0xDEAD_BEEF) — skip silently.
            if (c == 95) { p = p + 1; }
            else {
                var hd = 0 - 1;
                if (c >= 48) { if (c <= 57) { hd = c - 48; } }
                if (c >= 97) { if (c <= 102) { hd = c - 87; } }
                if (c >= 65) { if (c <= 70) { hd = c - 55; } }
                if (hd >= 0) {
                    if ((val >> 60) != 0) { ovf = 1; }
                    val = val << 4 | hd; p = p + 1;
                }
                else { go = 0; }
            }
        }
    }
    if (ovf == 1) { _lex_int_ovf(S); }
    ADDTOK(S, 1, val);
    return p;
}

# v6.0.62: lex an octal literal (0o755). Mirrors LEXHEX but base-8:
# accumulate `val << 3 | digit` over digits 0-7 only; an 8/9 (or any
# non-octal) terminates the literal. Underscore separators (0o7_5_5)
# skipped silently, like hex/decimal.
fn LEXOCT(S, p): i64 {
    var val = 0;
    var ovf = 0;
    var go = 1;
    while (go == 1) {
        if (p >= GBL(S)) { go = 0; }
        if (go == 1) {
            var c = load8(S + 0x459D000 + p);
            if (c == 95) { p = p + 1; }
            else {
                var od = 0 - 1;
                if (c >= 48) { if (c <= 55) { od = c - 48; } }
                if (od >= 0) {
                    if ((val >> 61) != 0) { ovf = 1; }
                    val = val << 3 | od; p = p + 1;
                }
                else { go = 0; }
            }
        }
    }
    if (ovf == 1) { _lex_int_ovf(S); }
    ADDTOK(S, 1, val);
    return p;
}

# ================================================================
# DECIMAL FLOAT LITERALS -> correctly rounded binary64, at compile time.
# ================================================================
# ⛔ 6.6.10 — the literal is converted HERE, exactly, and the token carries the IEEE-754 bits.
# It used to be an i64 numerator/denominator pair divided at RUNTIME (cvtsi2sd/scvtf + divide):
# the numerator overflowed once the digit string reached 2^63 and the denominator past 18
# fraction digits (leading zeros included), so `0.0000000000000000001` was NEGATIVE and
# `9.999999999999999999` was -8.2; and once numer > 2^53 the runtime division double-rounded,
# putting ~3%/24%/21% of 16/17/18-digit literals 1 ulp off. All of it silent.
#
# Integer-only bignums (32-bit limbs in 8-byte slots, slot 0 = limb count, no leading zero
# limb), a sticky bit, round-half-even, subnormals, overflow to +inf. Two scratch bignums,
# allocated on the first float literal — no heap-map region, no layout change.
# Size bound: at most _FLIT_SIG significant digits are kept (a nonzero tail becomes one
# trailing `1`, which cannot move the result: every binary64 value and every halfway point
# between two of them has at most 767 significant digits), and anything below 1e-324 or at
# or above 1e309 is decided before any bignum is built, so D < 10^1125 and both operands
# stay under 3800 bits — inside _FLB_W.
# Every fn here is small and plain on purpose: cybs (the seed's compiler) fails SILENTLY past
# its per-fn limits. CHANGELOG [6.6.10]
var _flb = 0;
var _FLB_W = 136;
var _FLIT_SIG = 800;

# b = b * m + a, for small m and a.
fn _bn_muladd(b, m, a): i64 {
    var n = load64(b);
    var c = a;
    var i = 0;
    while (i < n) {
        var x = load64(b + 8 + i * 8) * m + c;
        store64(b + 8 + i * 8, x & 0xFFFFFFFF);
        c = x >> 32;
        i = i + 1;
    }
    if (c != 0) { store64(b + 8 + n * 8, c); store64(b, n + 1); }
    return 0;
}

# b = b << k.
fn _bn_shl(b, k): i64 {
    var n = load64(b);
    if (n == 0) { return 0; }
    var w = k >> 5;
    var s = k & 31;
    store64(b + 8 + (n + w) * 8, 0);
    var i = n - 1;
    while (i >= 0) {
        var v = load64(b + 8 + i * 8) << s;
        var d = b + 8 + (i + w) * 8;
        store64(d + 8, load64(d + 8) | (v >> 32));
        store64(d, v & 0xFFFFFFFF);
        i = i - 1;
    }
    i = 0;
    while (i < w) { store64(b + 8 + i * 8, 0); i = i + 1; }
    n = n + w;
    if (load64(b + 8 + n * 8) != 0) { n = n + 1; }
    store64(b, n);
    return 0;
}

# b = b >> 1.
fn _bn_shr1(b): i64 {
    var n = load64(b);
    var i = 0;
    while (i < n) {
        var v = load64(b + 8 + i * 8) >> 1;
        if (i + 1 < n) { v = v | ((load64(b + 16 + i * 8) & 1) << 31); }
        store64(b + 8 + i * 8, v);
        i = i + 1;
    }
    if (n > 0) { if (load64(b + n * 8) == 0) { store64(b, n - 1); } }
    return 0;
}

# -1 / 0 / 1 as a < / == / > b.
fn _bn_cmp(a, b): i64 {
    var n = load64(a);
    var m = load64(b);
    if (n > m) { return 1; }
    if (n < m) { return 0 - 1; }
    var i = n - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x > y) { return 1; }
        if (x < y) { return 0 - 1; }
        i = i - 1;
    }
    return 0;
}

# a = a - b, for a >= b.
fn _bn_sub(a, b): i64 {
    var n = load64(a);
    var m = load64(b);
    var br = 0;
    var i = 0;
    while (i < n) {
        var y = 0;
        if (i < m) { y = load64(b + 8 + i * 8); }
        var x = load64(a + 8 + i * 8) - y - br;
        br = 0;
        if (x < 0) { x = x + 0x100000000; br = 1; }
        store64(a + 8 + i * 8, x);
        i = i + 1;
    }
    var go = 1;
    while (go == 1) {
        if (n == 0) { go = 0; }
        elif (load64(a + n * 8) != 0) { go = 0; }
        else { n = n - 1; }
    }
    store64(a, n);
    return 0;
}

# Number of significant bits of b (0 for zero).
fn _bn_bitlen(b): i64 {
    var n = load64(b);
    if (n == 0) { return 0; }
    var top = load64(b + n * 8);
    var l = (n - 1) * 32;
    while (top != 0) { l = l + 1; top = top >> 1; }
    return l;
}

# Bits of q (2^54 <= q < 2^56), the value being q * 2^-k plus a tail that is nonzero when
# st != 0, rounded to binary64: nearest, ties to even; subnormal below 2^-1022; +inf at or
# past the overflow threshold.
fn _flit_round(q, k, st): i64 {
    var lq = 0;
    var t = q;
    while (t != 0) { lq = lq + 1; t = t >> 1; }
    var e = lq - 1 - k;
    if (e > 1023) { return 0x7FF0000000000000; }
    var s = lq - 53;
    if (e < 0 - 1022) { s = s + (0 - 1022 - e); }
    if (s > 57) { return 0; }
    var m = q >> s;
    var half = 1 << (s - 1);
    var sticky = st;
    if ((q & (half - 1)) != 0) { sticky = 1; }
    if ((q & half) != 0) {
        if (sticky != 0) { m = m + 1; }
        elif ((m & 1) != 0) { m = m + 1; }
    }
    # Subnormal: the bits ARE m (a carry to 2^52 is exactly the smallest normal).
    if (e < 0 - 1022) { return m; }
    # Normal: m in [2^52, 2^53]; a carry to 2^53 bumps the exponent, and past 1023 is +inf.
    var bits = ((e + 1022) << 52) + m;
    if (bits >= 0x7FF0000000000000) { return 0x7FF0000000000000; }
    return bits;
}

# The 56-bit quotient of a / (d >> 55), d already shifted left by 55; the remainder is
# left in a.
fn _flit_divq(a, d): i64 {
    var q = 0;
    var i = 55;
    while (i >= 0) {
        if (_bn_cmp(a, d) >= 0) { _bn_sub(a, d); q = q | (1 << i); }
        _bn_shr1(d);
        i = i - 1;
    }
    return q;
}

# Bits of n * 10^e10, n a nonzero bignum in the first scratch slot.
fn _flit_scale(e10): i64 {
    var a = _flb;
    var d = _flb + _FLB_W * 8;
    store64(d, 1);
    store64(d + 8, 1);
    var i = 0;
    if (e10 >= 0) { while (i < e10) { _bn_muladd(a, 10, 0); i = i + 1; } }
    else { while (i < 0 - e10) { _bn_muladd(d, 10, 0); i = i + 1; } }
    var k = 55 - (_bn_bitlen(a) - _bn_bitlen(d));
    if (k >= 0) { _bn_shl(a, k); } else { _bn_shl(d, 0 - k); }
    _bn_shl(d, 55);
    var q = _flit_divq(a, d);
    return _flit_round(q, k, load64(a));
}

# Index (0-based, `_` and `.` skipped) of the first nonzero digit of the literal at
# [p0, pe), or -1 when every digit is zero.
fn _flit_scan(S, p0, pe): i64 {
    var i = 0 - 1;
    var p = p0;
    while (p < pe) {
        var c = load8(S + 0x459D000 + p);
        if (c >= 48) { if (c <= 57) {
                i = i + 1;
                if (c != 48) { return i; }
            } }
        p = p + 1;
    }
    return 0 - 1;
}

# Index of the last nonzero digit of the literal at [p0, pe), or -1.
fn _flit_last(S, p0, pe): i64 {
    var i = 0 - 1;
    var last = 0 - 1;
    var p = p0;
    while (p < pe) {
        var c = load8(S + 0x459D000 + p);
        if (c >= 48) { if (c <= 57) {
                i = i + 1;
                if (c != 48) { last = i; }
            } }
        p = p + 1;
    }
    return last;
}

# Correctly rounded binary64 bits of the decimal literal at [p0, pe), which has `fd`
# fraction digits and `nd` digits in all.
fn _flit_bits(S, p0, pe, fd, nd): i64 {
    var i0 = _flit_scan(S, p0, pe);
    if (i0 < 0) { return 0; }
    var i1 = _flit_last(S, p0, pe);
    if (_flb == 0) {
        _flb = alloc(_FLB_W * 16);
        if (_flb == 0) { _lex_die(S, p0, "out of memory converting a float literal"); }
    }
    var a = _flb;
    store64(a, 0);
    var iu = i1;
    if (i1 - i0 >= _FLIT_SIG) { iu = i0 + _FLIT_SIG - 1; }
    var p = p0;
    var i = 0 - 1;
    while (p < pe) {
        var c = load8(S + 0x459D000 + p);
        if (c >= 48) { if (c <= 57) {
                i = i + 1;
                if (i >= i0) { if (i <= iu) { _bn_muladd(a, 10, c - 48); } }
            } }
        p = p + 1;
    }
    # A dropped tail is never all zeros (i1 is the last nonzero digit): one trailing 1.
    if (iu < i1) { _bn_muladd(a, 10, 1); iu = iu + 1; }
    # value = a * 10^e10, and 10^(sig-1+e10) <= value < 10^(sig+e10).
    var e10 = (nd - 1 - iu) - fd;
    var top = iu - i0 + 1 + e10;
    if (top <= 0 - 324) { return 0; }
    if (top > 309) { return 0x7FF0000000000000; }
    return _flit_scale(e10);
}

# 1 when v * 10 + d no longer fits in 64 bits (unsigned: 2^64 - 1 = 1844674407370955161 * 10 + 5).
fn _lex_u64_ovf10(v, d): i64 {
    if (v < 0) { return 1; }
    if (v > 1844674407370955161) { return 1; }
    if (v == 1844674407370955161) { if (d > 5) { return 1; } }
    return 0;
}

# Lex decimal number
fn LEXDEC(S, p): i64 {
    var p0 = p;
    var c = load8(S + 0x459D000 + p);
    var val = c - 48;
    var nd = 1;
    var ovf = 0;
    p = p + 1;
    var go = 1;
    while (go == 1) {
        if (p >= GBL(S)) { go = 0; }
        if (go == 1) {
            c = load8(S + 0x459D000 + p);
            # Underscore separator (e.g. 1_000_000) — skip silently.
            if (c == 95) { p = p + 1; }
            elif (c >= 48) {
                if (c <= 57) {
                    if (_lex_u64_ovf10(val, c - 48) == 1) { ovf = 1; }
                    val = val * 10 + (c - 48); nd = nd + 1; p = p + 1;
                }
                else { go = 0; }
            } else { go = 0; }
        }
    }
    # Float literal: digits.digits
    if (p < GBL(S)) { if (load8(S + 0x459D000 + p) == 46) {
            var np = p + 1;
            if (np < GBL(S)) { var nc = load8(S + 0x459D000 + np);
                if (nc >= 48) { if (nc <= 57) {
                        p = np;
                        var fd = 0;
                        var fgo = 1;
                        while (fgo == 1) {
                            if (p >= GBL(S)) { fgo = 0; }
                            if (fgo == 1) {
                                c = load8(S + 0x459D000 + p);
                                if (c >= 48) { if (c <= 57) { fd = fd + 1; p = p + 1; }
                                    else { fgo = 0; } }
                                else { fgo = 0; }
                            }
                        }
                        # 6.6.10 — the token indexes the literal's correctly rounded binary64
                        # BITS (FLIT_NUM); the backends load them as one 64-bit immediate. See
                        # the block above _bn_muladd for what the i64 numer/denom pair did.
                        var bits = _flit_bits(S, p0, p, fd, nd + fd);
                        var fidx = FLIT_ADD(bits);
                        if (fidx < 0) {
                            _lex_die(S, p0, "too many distinct float literals (raise _FLIT_CAP in src/common/util.cyr)");
                        }
                        ADDTOK(S, 61, fidx);
                        return p;
                    } } }
        } }
    if (ovf == 1) { _lex_int_ovf(S); }
    ADDTOK(S, 1, val);
    return p;
}

# Lex a number starting at p, return new p
fn LEXNUM(S, p): i64 {
    var c = load8(S + 0x459D000 + p);
    if (c == 48) {
        if (p + 1 < GBL(S)) {
            if (load8(S + 0x459D000 + p + 1) == 120) {
                return LEXHEX(S, p + 2);
            }
            if (load8(S + 0x459D000 + p + 1) == 111) {
                return LEXOCT(S, p + 2);
            }
        }
    }
    return LEXDEC(S, p);
}

# Extended keyword check (klen >= 4). Returns token or 0.
fn LEXKW_EXT(kw, klen, S, ws): i64 {
    # ret2/rethi/sizeof
    if (klen == 4) {
        if (kw & 0xFFFFFFFF == 0x32746572) { return 97; }
        if (kw & 0xFFFFFFFF == 0x38323175) { return 105; }
    }
    if (klen == 5) { if (kw & 0xFFFFFFFFFF == 0x6968746572) { return 98; } }
    if (klen == 5) { if (kw & 0xFFFFFFFFFF == 0x6E6F696E75) { return 101; } }
    if (klen == 5) { if (kw & 0xFFFFFFFFFF == 0x7265666564) { return 106; } }
    # "stack" = 0x6B63617473 — v5.5.36 stack-local array qualifier:
    # `stack var buf[N];` inside a fn body reserves N bytes on the
    # call stack (vs the default of hoisting all `var x[N]` to .bss).
    # Triggers __chkstk on Win64 when fn frame ≥ 4 KB.
    if (klen == 5) { if (kw & 0xFFFFFFFFFF == 0x6B63617473) { return 111; } }
    if (klen == 6) {
        if (kw & 0xFFFFFFFFFFFF == 0x746567746962) { return 102; }
        if (kw & 0xFFFFFFFFFFFF == 0x746573746962) { return 103; }
        if (kw & 0xFFFFFFFFFFFF == 0x726C63746962) { return 104; }
        # "secret" = 0x746572636573 — zeroise-on-return attribute for local arrays
        if (kw & 0xFFFFFFFFFFFF == 0x746572636573) { return 108; }
        # 6.6.13 — f64_le / f64_ge are builtins (were lib/math.cyr calls). The exact-klen
        # match keeps f64_lerp / f64_get… identifiers. CHANGELOG [6.6.13]
        if (kw & 0xFFFFFFFFFFFF == 0x656C5F343666) { return 164; }   # f64_le
        if (kw & 0xFFFFFFFFFFFF == 0x65675F343666) { return 165; }   # f64_ge
    }
    # SIMD + trig keywords
    if (klen == 8) {
        if (kw == 0x7669645F76343666) { return 93; }
        if (kw == 0x7362615F76343666) { return 95; }
        if (kw == 0x6E6174615F343666) { return 99; }
        # v5.10.17: f64v_dot (sum of products → f64 in rax/x0)
        if (kw == 0x746F645F76343666) { return 128; }
    }
    if (klen == 9) {
        if (kw == 0x7271735F76343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 116) { return 94; }
        }
        # v5.10.17: f64v_axpy (y[i] += alpha * x[i])
        if (kw == 0x7078615F76343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 121) { return 130; }
        }
        # 6.6.13: f64_trunc (round toward zero) — a builtin, was a lib/math.cyr branch
        if (kw == 0x6E7572745F343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 99) { return 166; }
        }
    }
    if (klen == 10) {
        if (kw == 0x616D665F76343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 100) {
                if (load8(S + 0xEC00000 + ws + 9) == 100) { return 96; }
            }
        }
        # v5.10.17: f64v_scale (dst[i] = a[i] * scalar)
        if (kw == 0x6163735F76343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 108) {
                if (load8(S + 0xEC00000 + ws + 9) == 101) { return 129; }
            }
        }
    }
    # v6.5.24 (ymm widening) — f64v256_add/sub/mul/div(dst, a, b, n): the 256-bit AVX2
    # packed-DOUBLE kernel (vaddpd/vsubpd/vmulpd/vdivpd ymm) → EMIT_F64V4_LOOP. Tokens
    # 154-157, CONSECUTIVE so `ptyp - 154` IS the op index (0=add 1=sub 2=mul 3=div),
    # matching how every other SIMD family derives its op from the token.
    #
    # ⚠ WHY NOT NAMED `f64v4_add`. That is the f32v8 family's own convention — the
    # 256-bit TYPE names the builtin — but for f64 the name is already taken:
    # `lib/simd.cyr:590` defines the value-form `fn f64v4_add(a: f64v4, b: f64v4): f64v4`.
    # f64v4 shipped years before its widening and f32v8 shipped after, so only f32v8 ever
    # got the plain name. Reserving `f64v4_add` here would turn that lib definition into a
    # "reserved word as identifier" parse error and break every consumer calling the value
    # form, so the 256-bit KERNEL is named for its register WIDTH instead. That also
    # leaves `f64v512_*` free for an AVX-512 tier without a third collision.
    #
    # 11-char names → klen==11: shared 8-byte prefix "f64v256_" plus a 3-byte op tail.
    # Byte 8 alone (a/s/m/d) is already unique across the four, but all three tail bytes
    # are checked so a user identifier like `f64v256_ann` can't be silently stolen by the
    # `add` arm — the lexer's other multi-byte arms check every byte for the same reason.
    # v6.5.38 — f64v256_sqrt(dst, a, n): 12 chars, so its own klen arm between the 11- and
    # 13-char f64v256_ families. Same prefix, 4-byte tail "sqrt", every byte checked.
    if (klen == 12) {
        if (kw == 0x5F36353276343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 115) {          # 's'
                if (load8(S + 0xEC00000 + ws + 9) == 113) {      # 'q'
                    if (load8(S + 0xEC00000 + ws + 10) == 114) { # 'r'
                        if (load8(S + 0xEC00000 + ws + 11) == 116) { return 162; }   # 't'
                    }
                }
            }
        }
    }
    # v6.5.38 — f64v256_fmadd(dst, a, b, c, n): the 256-bit sibling of f64v_fmadd, token 158.
    # 13 chars, so its own klen arm; same 8-byte prefix "f64v256_" as the 11-char family above,
    # then the 5-byte tail "fmadd". Every tail byte is checked, for the reason the 11-char arm
    # records: a user identifier sharing the prefix must not be silently stolen.
    # ⚠ NOT named `f64v4_fmadd` — `lib/simd.cyr:642` already defines that as the value form, and
    # reserving the name here would turn a live lib definition into a reserved-word parse error.
    # Same reasoning, same trap, as the 11-char family; see its comment.
    if (klen == 13) {
        if (kw == 0x5F36353276343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 102) {          # 'f'
                if (load8(S + 0xEC00000 + ws + 9) == 109) {      # 'm'
                    if (load8(S + 0xEC00000 + ws + 10) == 97) {  # 'a'
                        if (load8(S + 0xEC00000 + ws + 11) == 100) {      # 'd'
                            if (load8(S + 0xEC00000 + ws + 12) == 100) { return 158; }   # 'd'
                        }
                    }
                }
            }
            if (load8(S + 0xEC00000 + ws + 8) == 115) {          # 's'  f64v256_scale -> 160
                if (load8(S + 0xEC00000 + ws + 9) == 99) {       # 'c'
                    if (load8(S + 0xEC00000 + ws + 10) == 97) {  # 'a'
                        if (load8(S + 0xEC00000 + ws + 11) == 108) {      # 'l'
                            if (load8(S + 0xEC00000 + ws + 12) == 101) { return 160; }   # 'e'
                        }
                    }
                }
            }
        }
    }
    if (klen == 11) {
        if (kw == 0x5F36353276343666) {
            # v6.5.38 — the two 3-char tails the .24 family did not claim.
            if (load8(S + 0xEC00000 + ws + 8) == 100) {          # 'd'  f64v256_dot -> 159
                if (load8(S + 0xEC00000 + ws + 9) == 111) {      # 'o'
                    if (load8(S + 0xEC00000 + ws + 10) == 116) { return 159; }   # 't'
                }
            }
            if (load8(S + 0xEC00000 + ws + 8) == 97) {           # 'a'  f64v256_abs -> 161
                if (load8(S + 0xEC00000 + ws + 9) == 98) {       # 'b'
                    if (load8(S + 0xEC00000 + ws + 10) == 115) { return 161; }   # 's'
                }
            }
            if (load8(S + 0xEC00000 + ws + 8) == 97) {
                if (load8(S + 0xEC00000 + ws + 9) == 100) {
                    if (load8(S + 0xEC00000 + ws + 10) == 100) { return 154; }
                }
            }
            if (load8(S + 0xEC00000 + ws + 8) == 115) {
                if (load8(S + 0xEC00000 + ws + 9) == 117) {
                    if (load8(S + 0xEC00000 + ws + 10) == 98) { return 155; }
                }
            }
            if (load8(S + 0xEC00000 + ws + 8) == 109) {
                if (load8(S + 0xEC00000 + ws + 9) == 117) {
                    if (load8(S + 0xEC00000 + ws + 10) == 108) { return 156; }
                }
            }
            if (load8(S + 0xEC00000 + ws + 8) == 100) {
                if (load8(S + 0xEC00000 + ws + 9) == 105) {
                    if (load8(S + 0xEC00000 + ws + 10) == 118) { return 157; }
                }
            }
        }
    }
    return 0;
}

# Guard the identifier buffer (tok_names @ S+0x60000, 256 KB v5.11.18;
# was 128 KB v4.6.2-v5.11.17). Called before any mangled-name write
# (variant ctors, closure names, operator impls) so overflow emits the
# clean diagnostic from where it actually occurs, not as a downstream
# parse error after memory corruption. `need` is a pessimistic byte
# count for the pending write. See CHANGELOG [5.11.18].
fn NPOS_GUARD(S, need): i64 {
    var np = GNPOS(S);
    # v6.5.40: 512 KB -> 8 MB. The pool was boxed in at 0x60000 by fn_name_hash @ 0x110000
    # ("pool end must stay <= 0x100000"), so it could not grow in place; it is now at the arena
    # top. Measured on real consumers, the identifier pool was the THIRD wall behind the 8 MB
    # preprocess ceiling: thoth's lib+src alone needs ~798 KB of pool, agnostic ~797 KB — both
    # already past the old 512 KB cap for a whole-tree build.
    if (np + need >= 8388336) {
        syscall(SYS_WRITE, 2, "error: identifier buffer full (", 31);
        PRNUM(np);
        syscall(SYS_WRITE, 2, "/8388608 bytes) — reduce included modules or split into separate units\n", 73);
        syscall(SYS_EXIT, 1);
    }
    return 0;
}

# Lex an identifier starting at p, return new p. Stores token.
# The identifier pool (tok_names) is 8 MB at S+0xEC00000 since v6.5.40. It was 512 KB at
# 0x60000, nested in the old input_buf and boxed in by fn_name_hash at 0x110000 — the
# "pool END must stay <= 0x100000" ceiling this comment stated until 6.6.20. The guard
# below refuses at 8388336, 272 bytes short of the 8 MB end: the slack the inner write
# loop needs. See NPOS_GUARD above.
fn LEXID(S, p, npos): i64 {
    if (npos >= 8388336) {
        syscall(SYS_WRITE, 2, "error: identifier buffer full (", 31);
        PRNUM(npos);
        syscall(SYS_WRITE, 2, "/8388608 bytes) — reduce included modules or split into separate units\n", 73);
        syscall(SYS_EXIT, 1);
    }
    var bl = GBL(S);
    var ws = npos;
    var go = 1;
    var c = 0;
    while (go == 1) {
        if (p >= bl) { go = 0; }
        if (go == 1) {
            c = load8(S + 0x459D000 + p);
            if (ISALNUM(c) == 1) {
                store8(S + 0xEC00000 + npos, c);
                npos = npos + 1;
                p = p + 1;
            } else { go = 0; }
        }
    }
    store8(S + 0xEC00000 + npos, 0);
    # Dedup via length-bucketed chain (v5.10.40). Replaces the prior
    # O(N²) walk-from-zero scan (lex was 58% of compile time per v5.10.0
    # profile, dedup_cmps the inner hot spot). Layout — at offsets past
    # the v5.10.39 brk extension (heap-map in main.cyr §LEXID_DEDUP):
    #   0x457C000  lexid_count   [8]            entries in use
    #   0x457C100  lexid_heads   [131072]       16384 × 8B content-hashed chain heads (v6.5.50;
    #                                            was 256 length-keyed buckets — see main.cyr)
    #   0xF400000  lexid_entries [524288]       65536 × 8B; low32 = canonical offset
    #                                            into tok_names @ 0x60000, high32 =
    #                                            next-entry idx+1 (0 = chain tail).
    #   CHANGELOG [6.4.21]: cap 16384 → 65536 (stiva + multi-bundle consumers).
    #   entries RELOCATED 0x457C900 → 0xF400000 (a fresh arena-top region above the
    #   x86 IR arena; the old 0x457C900 slot was boxed in by preprocess_out). All 7
    #   forks' arenas now extend to 0xF600000 (lazy mmap → no physical cost on the
    #   aarch64/macho/cx forks that don't use the range below it). count/heads stay put.
    # First-occurrence wins (canonical offset preserved across calls →
    # byte-identical) because we only insert when no match found, and
    # subsequent lookups for the same string return the recorded offset
    # regardless of chain order.
    bl = ws;
    var klen = npos - bl;
    # v6.5.50: bucket by CONTENT, not by length alone. `bucket = klen` (saturated at
    # 255) put EVERY identifier of the same length on one chain, so a unit with many
    # similar names degenerated to the O(N²) walk this index was added to remove — a
    # 60,000-fn unit named f0..f59999 is ~50,000 entries in a single bucket. v6.5.50
    # mixed length with the first, middle and last byte to spread them over 16384 chains;
    # it did not (see the v6.6.9 correction below).
    # Only the chain ORDER changes: the canonical offset is still the first occurrence in
    # source order, so cycc's output is byte-identical.
    # ⛔ CORRECTED v6.6.9 — the key used to be `klen*131 + first*7 + last*65599 + mid*4099`,
    # and this comment claimed it spread f0..f59999 across 16384 chains. False: generated
    # names differ in bytes three samples never look at. g0..g139999 landed in 500 buckets
    # (max chain 900) and the old gate's own "uniform" fixture f%09d in 20, so the lex phase
    # went superlinear again (35k -> 70k names: 3.5x). The key is now FNV-1a over EVERY byte
    # of the name (FNV1A_NOFF — the name is NUL-terminated at bl+klen just above): 16376 and
    # 9854 buckets for those two sets. Gated by lexid_buckets_by_content.sh's scaling row,
    # which is RED on the sampled key. CHANGELOG [6.6.9]
    # ⛔ CORRECTED v6.5.56 — this comment used to end "dedup remains an exact byte-compare",
    # and that was FALSE and load-bearing: the compare below is a PREFIX compare that was only
    # exact because `bucket = klen` put one length per chain. Changing the bucketing silently
    # invalidated it, and the sentence asserting the property is what made the gap invisible.
    # See the P0 note at the compare itself.
    var bucket = FNV1A_NOFF(S, bl) & 16383;
    var hi = L64(S + 0x457C100 + bucket * 8);
    while (hi > 0) {
        var idx = hi - 1;
        var ent = L64(S + 0xF400000 + idx * 8);
        var eoff = ent & 0xFFFFFFFF;
        var dc = 0;
        c = 1;
        while (dc < klen) {
            if (load8(S + 0xEC00000 + eoff + dc) != load8(S + 0xEC00000 + bl + dc)) { c = 0; break; }
            dc = dc + 1;
        }
        # v6.5.56 — P0: THE COMPARE ABOVE IS A PREFIX COMPARE, NOT AN EXACT ONE. It walks
        # klen bytes of the candidate and never checks that the STORED entry ends there, so a
        # shorter identifier matched a longer one it is a prefix of and took its pool offset —
        # `var ah = 7; var ahxaa = 99;` then read `ah` as **99**, exit 0, no diagnostic.
        #
        # ⭐ IT WAS CORRECT UNTIL v6.5.50 FOR A REASON THAT WAS NEVER WRITTEN DOWN. While
        # `bucket = klen`, one chain held exactly one length, so two entries in a chain could
        # not differ in length and the prefix compare WAS exact. The content hash above
        # replaced that invariant with a mixed one and no longer guarantees equal lengths per
        # chain — but the check the invariant had been standing in for was never added. The
        # comment above still says "dedup remains an exact byte-compare"; it was not.
        #
        # ⚠ THE SELF-HOST CANNOT SEE THIS, WHICH IS WHY IT SURVIVED SIX RELEASES. cycc's own
        # source has 0 colliding prefix pairs out of 54,089, and the aliasing is deterministic,
        # so it reproduces identically across generations: the fixpoint is byte-identical while
        # consumer code miscompiles. Confirmed live in six ecosystem repos (whirl's
        # `_cli_body` / `_cli_bodyerr` is the exact shape). Gated by
        # tests/gates/frontend/lexid_prefix_exact.sh, which pins the PROPERTY on a known
        # colliding pair rather than the fixpoint.
        if (c == 1) { if (load8(S + 0xEC00000 + eoff + klen) != 0) { c = 0; } }
        if (c == 1) { ws = eoff; break; }
        hi = ent >> 32;
    }
    if (ws == bl) {
        var ec = L64(S + 0x457C000);
        # v6.5.40: 65536 -> 262144. This was the FIFTH cap behind the 8 MB preprocess
        # ceiling, reached at ~23 MB of realistic source. Real consumers already sit close:
        # thoth has 40,641 unique identifiers, agnostic 34,659. lexid_entries relocated
        # 0x7300000 -> 0xF400000 (arena top) and grown 512 KB -> 2 MiB.
        # ⚠ The 65536 at lex.cyr:306/:318 is a UTF-8 codepoint WIDTH test, not this cap.
        if (ec >= 262144) {
            syscall(SYS_WRITE, 2, "error: identifier dedup table full (262144 entries) - raise LEXID cap in lex.cyr\n", 81);
            syscall(SYS_EXIT, 1);
        }
        var prev_head = L64(S + 0x457C100 + bucket * 8);
        S64(S + 0xF400000 + ec * 8, bl | (prev_head << 32));
        S64(S + 0x457C100 + bucket * 8, ec + 1);
        S64(S + 0x457C000, ec + 1);
    }
    if (ws == bl) { npos = npos + 1; SNPOS(S, npos); }
    else { SNPOS(S, bl); }
    # Check keywords
    var kw = L64(S + 0xEC00000 + ws);
    # Extended keywords (ret2, rethi, SIMD) in separate function
    if (klen >= 4) {
        var ext_tok = LEXKW_EXT(kw, klen, S, ws);
        if (ext_tok > 0) { ADDTOK(S, ext_tok, 0); return p; }
    }
    if (klen == 2) {
        if (kw & 0xFFFF == 0x6669) { ADDTOK(S, 15, 0); return p; }
        if (kw & 0xFFFF == 0x6E66) { ADDTOK(S, 32, 0); return p; }
        if (kw & 0xFFFF == 0x6E69) { ADDTOK(S, 76, 0); return p; }
    }
    if (klen == 3) {
        if (kw & 0xFFFFFFFF == 0x00726176) { ADDTOK(S, 3, 0); return p; }
        if (kw & 0xFFFFFFFF == 0x006D7361) { ADDTOK(S, 48, 0); return p; }
        if (kw & 0xFFFFFFFF == 0x00726F66) { ADDTOK(S, 55, 0); return p; }
        # "mod" = 0x646F6D
        if (kw & 0xFFFFFFFF == 0x00646F6D) { ADDTOK(S, 72, 0); return p; }
        # "pub" = 0x627570
        if (kw & 0xFFFFFFFF == 0x00627570) { ADDTOK(S, 73, 0); return p; }
        # "use" = 0x657375
        if (kw & 0xFFFFFFFF == 0x00657375) { ADDTOK(S, 74, 0); return p; }
    }
    if (klen == 4) {
        if (kw & 0xFFFFFFFF == 0x65736C65) { ADDTOK(S, 23, 0); return p; }
        # "elif" = 0x66696C65
        if (kw & 0xFFFFFFFF == 0x66696C65) { ADDTOK(S, 50, 0); return p; }
        if (kw & 0xFFFFFFFF == 0x65736163) { ADDTOK(S, 58, 0); return p; }
        if (kw & 0xFFFFFFFF == 0x6D756E65) { ADDTOK(S, 60, 0); return p; }
        # "impl" = 0x6C706D69
        if (kw & 0xFFFFFFFF == 0x6C706D69) { ADDTOK(S, 77, 0); return p; }
    }
    if (klen == 5) {
        if (kw & 0xFFFFFFFFFF == 0x00656C696877) { ADDTOK(S, 16, 0); return p; }
        if (kw & 0xFFFFFFFFFF == 0x003864616F6C) { ADDTOK(S, 25, 0); return p; }
        # "break" = 0x6B61657262
        if (kw & 0xFFFFFFFFFF == 0x6B61657262) { ADDTOK(S, 51, 0); return p; }
        # "match" = 0x686374616D
        if (kw & 0xFFFFFFFFFF == 0x686374616D) { ADDTOK(S, 75, 0); return p; }
        # v6.3.11 (G): "async" = 0x636E797361 → token 134 (async-fn modifier,
        # consumed before `fn`). "await" = 0x7469617761 → token 135 (await-expr
        # prefix). Lexed unconditionally — no bare `async`/`await` identifier
        # exists in src/ or lib/, so cycc's token stream is unchanged (the words
        # never appear), keeping self-host byte-identical. The FEATURE is gated in
        # pass 2 (PARSE_FN_DEF / PEXPR via _ensure_async_gate / _ASYNC_OK); a
        # default build errors loud on async/await rather than miscompiling.
        if (kw & 0xFFFFFFFFFF == 0x636E797361) { ADDTOK(S, 134, 0); return p; }
        if (kw & 0xFFFFFFFFFF == 0x7469617761) { ADDTOK(S, 135, 0); return p; }
    }
    if (klen == 6) {
        # v6.5.0 — "public" = 0x63696C627570, lexed to token 73, the SAME token as the
        # existing `pub`. Deliberate alias, not a new id: `pub` is already consumed at
        # every position `public` must reach (pass 1 and pass 2 of all 7 main_*.cyr
        # forks, plus PARSE_IMPL), so aliasing inherits 15 working dispatch sites
        # instead of hand-editing them and risking one being missed.
        if (kw & 0xFFFFFFFFFFFFFF == 0x63696C627570) { ADDTOK(S, 73, 0); return p; }
        # "return" = 0x006E7275746572
        if (kw & 0xFFFFFFFFFFFFFF == 0x006E7275746572) { ADDTOK(S, 33, 0); return p; }
        # "store8" = 0x003865726F7473
        if (kw & 0xFFFFFFFFFFFFFF == 0x003865726F7473) { ADDTOK(S, 26, 0); return p; }
        # "struct" = 0x00746375727473
        if (kw & 0xFFFFFFFFFFFFFF == 0x746375727473) { ADDTOK(S, 40, 0); return p; }
        # "load16" = 0x363164616F6C
        if (kw & 0xFFFFFFFFFFFFFF == 0x363164616F6C) { ADDTOK(S, 42, 0); return p; }
        # "load32" = 0x323364616F6C
        if (kw & 0xFFFFFFFFFFFFFF == 0x323364616F6C) { ADDTOK(S, 43, 0); return p; }
        # "load64" = 0x343664616F6C
        if (kw & 0xFFFFFFFFFFFFFF == 0x343664616F6C) { ADDTOK(S, 44, 0); return p; }
        # v5.8.45: `kernel` demoted from reserved token 56 to plain
        # ident. Top-level `kernel;` (AGNOS kernel-mode switch) now
        # detected via _TOK_IS_KERNEL(S) at the dispatch site in
        # main.cyr / main_*.cyr. Pre-v5.8.45 the lexer always emitted
        # token 56, which broke `kernel` as a fn parameter or local
        # variable name everywhere — an issue surfaced from the vidya
        # audio_dsp 11-lang port where `fn fir_step(kernel, ...)` is
        # the natural DSP signature.
        # "shared" = 0x646572616873
        if (kw & 0xFFFFFFFFFFFFFF == 0x646572616873) { ADDTOK(S, 78, 0); return p; }
        # "object" = 0x7463656a626f → token 79, sets mode 3 (.o output)
        if (kw & 0xFFFFFFFFFFFFFF == 0x7463656a626f) { ADDTOK(S, 79, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x686374697773) { ADDTOK(S, 57, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6F745F343666) { ADDTOK(S, 67, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x71655F343666) { ADDTOK(S, 68, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x746C5F343666) { ADDTOK(S, 69, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x74675F343666) { ADDTOK(S, 70, 0); return p; }
    }
    if (klen == 7) {
        # v6.5.0 — "private" = 0x65746176697270, token 153 (first genuinely free id;
        # 152 is already taken by the `>` operator group at lex.cyr:1483).
        if (kw & 0xFFFFFFFFFFFFFF == 0x65746176697270) { ADDTOK(S, 153, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6C6C6163737973) { ADDTOK(S, 24, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x363165726F7473) { ADDTOK(S, 45, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x323365726F7473) { ADDTOK(S, 46, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x343665726F7473) { ADDTOK(S, 47, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x746C7561666564) { ADDTOK(S, 59, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6464615F343666) { ADDTOK(S, 62, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6275735F343666) { ADDTOK(S, 63, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6C756D5F343666) { ADDTOK(S, 64, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x7669645F343666) { ADDTOK(S, 65, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x67656E5F343666) { ADDTOK(S, 71, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x7362615F343666) { ADDTOK(S, 80, 0); return p; }
        # "callptr" = 0x7274706C6C6163 → token 111 (v6.0.70 §0 indirect-call builtin)
        # v6.6.2: callptr was token 111, SHARED with `stack`. Worse than a diagnostics defect —
        # `callptr(fp, 41);` in STATEMENT position was a hard error ("expected var, got '('"),
        # because PARSE_STMT saw 111 and routed to the `stack var` parser before any expression
        # path. Statement position IS a shared position, so the "grammar disambiguates by
        # POSITION" premise did not hold for 111. `stack` keeps 111 (both its uses).
        if (kw & 0xFFFFFFFFFFFFFF == 0x7274706C6C6163) { ADDTOK(S, 137, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x6E69735F343666) { ADDTOK(S, 83, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x736F635F343666) { ADDTOK(S, 84, 0); return p; }
        if (kw & 0xFFFFFFFFFFFFFF == 0x7078655F343666) { ADDTOK(S, 85, 0); return p; }
    }
    if (klen == 6) {
        if (kw & 0xFFFFFFFFFFFF == 0x6E6C5F343666) { ADDTOK(S, 86, 0); return p; }
        # "f32_to" → token 132 (f32→f64, cvtss2sd). v6.2.18 native-float math arc.
        if (kw & 0xFFFFFFFFFFFF == 0x6F745F323366) { ADDTOK(S, 132, 0); return p; }
        # v6.4.6 (Phase 3a) — packed integer ops iv_add/iv_sub/iv_mul(dst,a,b,n,w):
        # w = lane byte-width literal (1/2/4/8). Tokens 143-145 (142=f32v_dot).
        if (kw & 0xFFFFFFFFFFFF == 0x6464615F7669) { ADDTOK(S, 143, 0); return p; }  # iv_add
        if (kw & 0xFFFFFFFFFFFF == 0x6275735F7669) { ADDTOK(S, 144, 0); return p; }  # iv_sub
        if (kw & 0xFFFFFFFFFFFF == 0x6C756D5F7669) { ADDTOK(S, 145, 0); return p; }  # iv_mul
        # v6.4.7 (Phase 3b) — iv_dp8(a, b, n) → i32 widening int8 dot (b1.58). Token 146.
        if (kw & 0xFFFFFFFFFFFF == 0x3870645F7669) { ADDTOK(S, 146, 0); return p; }  # iv_dp8
    }
    # "continue" = 0x65756E69746E6F63 (8 bytes)
    if (klen == 8) {
        if (kw == 0x65756E69746E6F63) { ADDTOK(S, 52, 0); return p; }
        if (kw == 0x6D6F72665F343666) { ADDTOK(S, 66, 0); return p; }
        # "f32_from" → token 131 (f64→f32, cvtsd2ss). v6.2.18 native-float math arc.
        if (kw == 0x6D6F72665F323366) { ADDTOK(S, 131, 0); return p; }
        # v6.6.2: f64_sqrt was token 79, SHARED with `object`. A token type could not recover its
        # spelling, so `var f64_sqrt = 1;` reported "reserved keyword 'object'" until v6.4.77
        # taped over it with a disjunction. 136 is free in TOKNAME and in every dispatch band.
        # `object` KEEPS 79 — it is the statement keyword that legitimately owns it, and that is
        # what makes this a zero-fork-edit change (main.cyr/main_win.cyr compare against 79).
        if (kw == 0x747271735F343666) { ADDTOK(S, 136, 0); return p; }
        if (kw == 0x6C6965635F343666) { ADDTOK(S, 82, 0); return p; }
        if (kw == 0x32676F6C5F343666) { ADDTOK(S, 87, 0); return p; }
        if (kw == 0x327078655F343666) { ADDTOK(S, 88, 0); return p; }
        if (kw == 0x6464615F76343666) { ADDTOK(S, 89, 0); return p; }
        if (kw == 0x6275735F76343666) { ADDTOK(S, 90, 0); return p; }
        if (kw == 0x6C756D5F76343666) { ADDTOK(S, 91, 0); return p; }
        # v6.4.3+ (SIMD Phase 1) — f32v_add/sub/mul (packed f32: addps/subps/mulps).
        # Tokens 138-140: 134=async, 135=await are taken, so f32v starts at 138.
        if (kw == 0x6464615F76323366) { ADDTOK(S, 138, 0); return p; }  # f32v_add
        if (kw == 0x6275735F76323366) { ADDTOK(S, 139, 0); return p; }  # f32v_sub
        if (kw == 0x6C756D5F76323366) { ADDTOK(S, 140, 0); return p; }  # f32v_mul
        # v6.4.5 (SIMD Phase 2) — f32v_dot(a,b,n) → f32 scalar (horizontal dot).
        if (kw == 0x746F645F76323366) { ADDTOK(S, 142, 0); return p; }  # f32v_dot
    }
    if (klen == 9) {
        if (kw == 0x6F6F6C665F343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 114) { ADDTOK(S, 81, 0); return p; }
        }
        if (kw == 0x6E756F725F343666) {
            if (load8(S + 0xEC00000 + ws + 8) == 100) { ADDTOK(S, 92, 0); return p; }
        }
        if (kw == 8246499246534309478) {
            if (load8(S + 0xEC00000 + ws + 8) == 116) { ADDTOK(S, 94, 0); return p; }
        }
        # v6.4.8 (SIMD Phase 4 R1) — f32v8_add/sub/mul (packed f32 on 256-bit AVX2:
        # vaddps/vsubps/vmulps ymm). 9-char names: 8-byte packed kw + 9th byte 'd'/'b'/'l'.
        # Tokens 147-149 (146=iv_dp8 is the prior max).
        if (kw == 0x64615F3876323366) {
            if (load8(S + 0xEC00000 + ws + 8) == 100) { ADDTOK(S, 147, 0); return p; }   # f32v8_add
        }
        if (kw == 0x75735F3876323366) {
            if (load8(S + 0xEC00000 + ws + 8) == 98) { ADDTOK(S, 148, 0); return p; }    # f32v8_sub
        }
        if (kw == 0x756D5F3876323366) {
            if (load8(S + 0xEC00000 + ws + 8) == 108) { ADDTOK(S, 149, 0); return p; }   # f32v8_mul
        }
        # v6.4.9 (SIMD Phase 4 R2) — f32v8_fma (vfmadd231ps ymm) + f32v8_dot (8-lane
        # AVX2 dot). 9-char names → klen==9. Tokens 150-151 (149=f32v8_mul is the R1 max).
        if (kw == 0x6D665F3876323366) {
            if (load8(S + 0xEC00000 + ws + 8) == 97) { ADDTOK(S, 150, 0); return p; }    # f32v8_fma
        }
        if (kw == 0x6F645F3876323366) {
            if (load8(S + 0xEC00000 + ws + 8) == 116) { ADDTOK(S, 151, 0); return p; }   # f32v8_dot
        }
    }
    if (klen == 10) {
        if (kw == 7020379954331530854) {
            if (load8(S + 0xEC00000 + ws + 8) == 100) {
                if (load8(S + 0xEC00000 + ws + 9) == 100) { ADDTOK(S, 96, 0); return p; }
            }
        }
        # v6.4.5 (SIMD Phase 2) — f32v_fmadd(dst,a,b,c,n). "f32v_fma" packed +
        # bytes 8,9 == 'd','d'. Token 141 (140=f32v_mul is the last Phase-1 tok).
        if (kw == 0x616D665F76323366) {
            if (load8(S + 0xEC00000 + ws + 8) == 100) {
                if (load8(S + 0xEC00000 + ws + 9) == 100) { ADDTOK(S, 141, 0); return p; }
            }
        }
    }
    ADDTOK(S, 2, ws);
    return p;
}

# ⛔ 6.6.10 — THE LEXER'S ONE DIAGNOSTIC HEAD: `error:<file>:<line>:<col>: `.
# The lexer's error sites printed `error:<N>:` with N the raw EXPANDED line — every
# `#@file` marker line and every included file's body counted — and no file and no
# column, so `$` on line 1 of a one-line source said `error:2:`, and a defect in an
# included file named a line of nothing. FM_BUILD runs before LEX in every fork, so the
# parser's own FM_LOOKUP maps the line and `_err_col` gives the column from the byte
# offset. ⚠ The message text after the head is load-bearing: `cyrius lint` classifies
# on it through `_lint_capture_has_syntax` (cbt/commands.cyr), which parses exactly this
# shape. Kept small and separate: LEX is far past the size cybs compiles comfortably.
# CHANGELOG [6.6.10]
fn _lex_err_head(S, p): i64 {
    syscall(SYS_WRITE, 2, "error:", 6);
    FM_LOOKUP(S, GCLINE(S));
    syscall(SYS_WRITE, 2, ":", 1);
    PRNUM(_err_col(S, p));
    syscall(SYS_WRITE, 2, ": ", 2);
    return 0;
}

# Report `msg` (a cstr, no newline) at expanded-source offset `p`, and stop: a lexer
# error leaves no token stream to recover in. CHANGELOG [6.6.10]
fn _lex_die(S, p, msg): i64 {
    _lex_err_head(S, p);
    PRSTR(msg);
    syscall(SYS_WRITE, 2, "\n", 1);
    syscall(SYS_EXIT, 1);
    return 0;
}

# A string literal still open at EOF: report it at its opening quote `p`, on the line
# the literal STARTED (`sline`) -- the loop has already counted any LFs inside it, and
# `_lex_err_head` reads the current line. Kept out of LEX (the cybs per-fn cap).
# CHANGELOG [6.6.12]
fn _lex_unterm_str(S, p, sline): i64 {
    SCLINE(S, sline);
    _lex_die(S, p, "unterminated string literal");
    return 0;
}

# 1 iff offset `q` starts a WHOLE preprocessor file-marker line, in PP_FMARK's exact
# shape: `#@file "<name>" <digits>` then LF. The whole line, not just the `#@file "`
# prefix FM_BUILD keys on: a string that is CLOSED by a `"` right after `#@file ` on its
# own line is valid source, and must not be refused as unterminated. CHANGELOG [6.6.12]
fn _lex_fmark_line(S, q): i64 {
    var bl = GBL(S);
    if (q + 11 >= bl) { return 0; }
    var b = S + 0x459D000;
    if (load8(b + q) != 35 || load8(b + q + 1) != 64 || load8(b + q + 2) != 102 || load8(b + q + 3) != 105) { return 0; }
    if (load8(b + q + 4) != 108 || load8(b + q + 5) != 101 || load8(b + q + 6) != 32 || load8(b + q + 7) != 34) { return 0; }
    var e = q + 8;
    while (e < bl && load8(b + e) != 34 && load8(b + e) != 10) { e = e + 1; }
    if (e == q + 8 || e + 2 >= bl) { return 0; }
    if (load8(b + e) != 34 || load8(b + e + 1) != 32) { return 0; }
    e = e + 2;
    var d = e;
    while (e < bl && load8(b + e) >= 48 && load8(b + e) <= 57) { e = e + 1; }
    if (e == d || e >= bl) { return 0; }
    if (load8(b + e) != 10) { return 0; }
    return 1;
}

# A LF inside a string literal: count the line, and refuse the literal if the next line
# (offset `q`) is a preprocessor file marker. Inside a string that marker can only be the
# one PP_FMARK writes where an INCLUDED file ends, so the literal was still open at the
# end of its file -- unterminated exactly as one open at EOF is. It used to run on into
# the marker, close on the marker's own quote and pair every later quote wrongly, so the
# error named the main file, or a VALID literal in it. Kept out of LEX (the cybs per-fn
# cap). CHANGELOG [6.6.12]
fn _lex_str_lf(S, q, sline): i64 {
    SCLINE(S, GCLINE(S) + 1);
    if (_lex_fmark_line(S, q) == 1) { _lex_unterm_str(S, _tok_start, sline); }
    return 0;
}

# Byte `c` as two lowercase hex digits on stderr.
fn _lex_hex2(c): i64 {
    var b = 0;
    var hi = (c >> 4) & 15;
    var lo = c & 15;
    if (hi < 10) { store8(&b, 48 + hi); } else { store8(&b, 87 + hi); }
    if (lo < 10) { store8(&b + 1, 48 + lo); } else { store8(&b + 1, 87 + lo); }
    syscall(SYS_WRITE, 2, &b, 2);
    return 0;
}

# ⛔ 6.6.10 (CVE-52) — a byte at offset `p` that begins no token is an ERROR, whatever
# the byte. CVE-31 (v6.1.35) made every unmatched ASCII byte and every non-ASCII one an
# error, but never touched the `@` arm, which since v5.6.3 skipped any `@` that did not
# spell `@unsafe`: `return @@@;` compiled and returned 0, `5 @- 3` was 2, `a @* 2` was
# a*2, and `cyrius lint` passed all of it, because every gate that trusts cycc's rc
# inherited the rc 0. All three routes now share this one reject. CHANGELOG [6.6.10]
fn _lex_stray(S, p, c): i64 {
    _lex_err_head(S, p);
    if (c > 127) {
        syscall(SYS_WRITE, 2, "non-ASCII byte (0x", 18);
        _lex_hex2(c);
        syscall(SYS_WRITE, 2, ") -- only ASCII allowed in source (UTF-8 ok in strings)\n", 56);
    } else {
        syscall(SYS_WRITE, 2, "unexpected character (0x", 24);
        _lex_hex2(c);
        syscall(SYS_WRITE, 2, ")\n", 2);
    }
    syscall(SYS_EXIT, 1);
    return 0;
}

# 6.6.17 — the EOF token sits just past the last byte of real source: trailing whitespace and
# the preprocessor's `#@` marker lines are skipped (an include on the last line leaves a
# `<source>` RESUME marker there, which belongs to no file-map span). It used to carry the
# cursor's line at the end of the buffer — one past the last span — so `expected '}', got end
# of file` lost its `<source>:` prefix and named a line the file does not have (`error:3:24:`
# for a one-line file). A buffer of only whitespace and markers keeps the end position.
fn _lex_eof_tok(S, bl): i64 {
    var q = _lex_eof_last(S, bl);
    if (q < 0) { ADDTOK(S, 12, 0); return 0; }
    var nl = 0;
    var i = q + 1;
    while (i < bl) { if (load8(S + 0x459D000 + i) == 10) { nl = nl + 1; } i = i + 1; }
    var sv = GCLINE(S);
    SCLINE(S, sv - nl);
    _tok_start = q + 1;
    ADDTOK(S, 12, 0);
    SCLINE(S, sv);
    return 0;
}

# Offset of the last byte that is neither whitespace nor inside a `#@` marker line, or -1.
fn _lex_eof_last(S, bl): i64 {
    var buf = S + 0x459D000;
    var q = bl - 1;
    while (q >= 0) {
        var c = load8(buf + q);
        if (CCLASS(c) == 1) { q = q - 1; }
        else {
            var ls = q;
            while (ls > 0) { if (load8(buf + ls - 1) == 10) { break; } ls = ls - 1; }
            if (load8(buf + ls) != 35) { return q; }
            if (load8(buf + ls + 1) != 64) { return q; }
            q = ls - 1;                          # a `#@` marker line: skip it
        }
    }
    return 0 - 1;
}

# 6.6.17 — A COMPILE-TIME-ONLY STRING IS NOT EMITTED. The whole string pool (str_data) is copied
# into every binary, so a `#deprecated("use new_f")` or `#assert .., "msg"` message — read only by
# a diagnostic, never by code — cost every binary its bytes (+16 B for "use new_f"). Right after
# such a literal is lexed it is moved to a side table and the pool is wound back to where it
# began: it is the LAST string in the pool (an interned one shares bytes another literal needs and
# stays), so no other offset moves. Its token value keeps the (offset << 32) | length shape with
# bit 30 of the offset set; the two readers (`_DEPRECATED_WARN`, the #assert failure printer)
# resolve it through `_lit_ptr`. The side table is alloc'd on first use: no heap-map region.
var _lex_side = 0;
var _lex_side_n = 0;
var _lex_side_cap = 0;
fn _lex_dir_msg_fix(S, interned): i64 {
    if (interned >= 0) { return 0; }
    var tc = GTCNT(S) - 1;
    if (_lex_is_dir_msg(S, tc) == 0) { return 0; }
    var v = TOKVAL(S, tc);
    var off = v >> 32;
    var n = v & 0xFFFFFFFF;
    var so = _lex_side_put(S + 0x21A000 + off, n + 1);
    if (so < 0) { return 0; }
    SSPOS(S, off);
    S64(S + 0xAC00000 + tc * 8, ((so | 0x40000000) << 32) | n);
    return 0;
}
# Copy `n` bytes to the side table; its offset, or -1 when it cannot grow (the literal stays in
# the pool, as before).
fn _lex_side_put(src, n): i64 {
    if (_lex_side_n + n > _lex_side_cap) {
        var nc = _lex_side_cap * 2;
        if (nc < 4096) { nc = 4096; }
        while (nc < _lex_side_n + n) { nc = nc * 2; }
        if (nc >= 0x40000000) { return 0 - 1; }
        var nb = alloc(nc);
        if (nb == 0) { return 0 - 1; }
        var i = 0;
        while (i < _lex_side_n) { store8(nb + i, load8(_lex_side + i)); i = i + 1; }
        _lex_side = nb;
        _lex_side_cap = nc;
    }
    var o = _lex_side_n;
    var k = 0;
    while (k < n) { store8(_lex_side + o + k, load8(src + k)); k = k + 1; }
    _lex_side_n = o + n;
    return o;
}
# 6.6.19 — STRING INTERNING LOOKS A LITERAL UP IN AN INDEX instead of scanning the pool. LEX used
# to compare every new literal against EVERY segment of str_data, byte by byte, so N literals cost
# N x pool bytes: 3,000 small literals 573 ms, 9,000 4,983 ms, and one 1.9 MB literal ahead of
# 3,000 small ones 11.4 s (the same program with it after them: 0.92 s).
#
# Why the output is BYTE-IDENTICAL. The scan visits segment starts (offset 0 and every offset
# after a NUL) in pool order and takes the first whose window (slen + 1 bytes) equals the literal
# and its terminator. For a literal with NO NUL that window is a whole segment: it starts after a
# NUL and holds none before its last byte. So the first match is the FIRST segment equal to the
# literal, which is exactly what the index keeps (an equal segment indexed later never replaces
# it). A literal holding a NUL can match across segments, so it keeps the scan VERBATIM
# (`_lex_intern_scan`, B0a's committed-window rule). CHANGELOG [6.6.19]
#
# The index is synced LAZILY over [upto, sstart) before each lookup. That is sound because only
# the lexer writes str_data and the committed pool always ends in a terminator, so `upto` is
# always a segment start; the one writer that winds the pool back (`_lex_dir_msg_fix`) goes back
# only to the current literal's own start, which is >= upto. A wind-back below `upto` (a re-lex)
# rebuilds the index from 0. The handle is alloc'd on first use — no heap-map region:
#   +0 table (16-byte entries: FNV-1a of the segment, its pool offset + 1; 0 = empty)
#   +8 mask (slots - 1)   +16 entries in use   +24 upto
var _lex_ix = 0;
# The pool offset `interned` resolves to, or -1: a new literal is appended.
fn _lex_intern(S, sstart, slen): i64 {
    var lit = S + 0x21A000 + sstart;
    var i = 0;
    while (i < slen) {
        if (load8(lit + i) == 0) {
            var r = _lex_intern_scan(S, sstart, slen);
            return r;
        }
        i = i + 1;
    }
    _lex_intern_catchup(S, sstart);
    var f = _lex_intern_find(S, sstart, slen);
    return f;
}
# ⛔ The window compared at `si` (slen + 1 bytes) must lie wholly in the COMMITTED pool,
# below sstart: past it is this literal's own copy, which the next literal overwrites once
# this one is interned. A literal holding a NUL matched there and aliased onto bytes that
# were not its own (`"a"`, `"a\0a"`, `"zzzz"`: X+2 read 'z'). A NUL-free literal never
# reaches sstart (the byte before it is a terminator), so it is unaffected. CHANGELOG [6.6.15]
fn _lex_intern_scan(S, sstart, slen): i64 {
    var interned = 0 - 1;
    var si = 0;
    while (si + slen < sstart) {
        var eq = 1;
        var sk = 0;
        while (sk <= slen) {
            if (load8(S + 0x21A000 + si + sk) != load8(S + 0x21A000 + sstart + sk)) { eq = 0; break; }
            sk = sk + 1;
        }
        if (eq == 1) { interned = si; si = sstart; }
        else {
            while (si < sstart) { if (load8(S + 0x21A000 + si) == 0) { si = si + 1; break; } si = si + 1; }
        }
    }
    return interned;
}
# The first pool offset whose segment is the (NUL-free) literal at `sstart`, or -1.
fn _lex_intern_find(S, sstart, slen): i64 {
    var pool = S + 0x21A000;
    var a = _lex_ix_probe(pool, _lex_fnv(pool + sstart, slen), sstart, slen);
    var o = load64(a + 8);
    return o - 1;
}
# Index the segments in [upto, end); a pool wound back below `upto` is re-indexed from 0.
fn _lex_intern_catchup(S, end): i64 {
    if (_lex_ix == 0) { _lex_ix = alloc(32); _lex_ix_alloc(4096); }
    if (end < load64(_lex_ix + 24)) { _lex_ix_alloc(4096); }
    var pool = S + 0x21A000;
    var p = load64(_lex_ix + 24);
    while (p < end) {
        var q = p;
        while (q < end) { if (load8(pool + q) == 0) { break; } q = q + 1; }
        _lex_ix_add(pool, p, q - p);
        p = q + 1;
    }
    store64(_lex_ix + 24, end);
    return 0;
}
# A fresh, empty table of `slots` entries; nothing indexed.
fn _lex_ix_alloc(slots): i64 {
    store64(_lex_ix, alloc(slots * 16));
    store64(_lex_ix + 8, slots - 1);
    store64(_lex_ix + 16, 0);
    store64(_lex_ix + 24, 0);
    return 0;
}
fn _lex_fnv(p, n): i64 {
    var h = 0xcbf29ce484222325;
    var i = 0;
    while (i < n) {
        h = h ^ load8(p + i);
        h = h * 0x100000001b3;
        i = i + 1;
    }
    return h;
}
# The entry whose segment is the `n` bytes at pool + `off` (hash `h`), or the empty entry it
# would go in. A stored segment matches when its first `n` bytes are those and its NUL is next.
fn _lex_ix_probe(pool, h, off, n): i64 {
    var tab = load64(_lex_ix);
    var mask = load64(_lex_ix + 8);
    var s = h & mask;
    while (load64(tab + s * 16 + 8) != 0) {
        var e = tab + s * 16;
        if (load64(e) == h) {
            if (_lex_seg_eq(pool + load64(e + 8) - 1, pool + off, n) == 1) { return e; }
        }
        s = (s + 1) & mask;
    }
    return tab + s * 16;
}
fn _lex_seg_eq(a, b, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    if (load8(a + n) != 0) { return 0; }
    return 1;
}
# Index the segment at pool + `off` (`n` bytes): an equal segment already indexed keeps its
# entry, so every entry is the FIRST offset of its bytes. Doubles at half full.
fn _lex_ix_add(pool, off, n): i64 {
    var h = _lex_fnv(pool + off, n);
    var e = _lex_ix_probe(pool, h, off, n);
    if (load64(e + 8) != 0) { return 0; }
    store64(e, h);
    store64(e + 8, off + 1);
    var used = load64(_lex_ix + 16) + 1;
    store64(_lex_ix + 16, used);
    if (used * 2 > load64(_lex_ix + 8)) { _lex_ix_grow(); }
    return 0;
}
# Re-home every entry into a table twice the size (entries are distinct: no compare needed).
fn _lex_ix_grow(): i64 {
    var old = load64(_lex_ix);
    var n = load64(_lex_ix + 8) + 1;
    var tab = alloc(n * 32);
    var mask = n * 2 - 1;
    var i = 0;
    while (i < n) {
        var h = load64(old + i * 16);
        var v = load64(old + i * 16 + 8);
        if (v != 0) {
            var s = h & mask;
            while (load64(tab + s * 16 + 8) != 0) { s = (s + 1) & mask; }
            store64(tab + s * 16, h);
            store64(tab + s * 16 + 8, v);
        }
        i = i + 1;
    }
    store64(_lex_ix, tab);
    store64(_lex_ix + 8, mask);
    return 0;
}
# 1 when string token `tc` is a directive's message: `#deprecated ( STRING`, or the message slot of
# an `#assert ATOM [OP ATOM] [,] STRING` (the grammar `_tl_assert` / PARSE_STMT's arm consume).
fn _lex_is_dir_msg(S, tc): i64 {
    if (tc >= 2) { if (TOKTYP(S, tc - 1) == 10) { if (TOKTYP(S, tc - 2) == 124) { return 1; } } }
    var a = tc - 1;
    var lo = tc - 12;
    if (lo < 0) { lo = 0; }
    while (a >= lo) {
        if (TOKTYP(S, a) == 107) {
            if (_lex_assert_msg_at(S, a) == tc) { return 1; }
            return 0;
        }
        a = a - 1;
    }
    return 0;
}
fn _lex_assert_msg_at(S, a): i64 {
    var i = _lex_assert_atom(S, a + 1);
    var op = TOKTYP(S, i);
    if (op >= 17) { if (op <= 22) { i = _lex_assert_atom(S, i + 1); } }
    if (TOKTYP(S, i) == 31) { i = i + 1; }
    return i;
}
# `_assert_skip_atom` over token indices: a number, `sizeof ( [T] )`, `E.N`, or a name.
fn _lex_assert_atom(S, i): i64 {
    var t = TOKTYP(S, i);
    if (t == 1) { return i + 1; }
    if (t != 2) { return i; }
    if (_is_sizeof_word(S, TOKVAL(S, i)) != 1) {
        if (TOKTYP(S, i + 1) == 41) { if (TOKTYP(S, i + 2) == 2) { return i + 3; } }
        return i + 1;
    }
    var j = i + 2;
    var tj = TOKTYP(S, j);
    if (tj == 2) { j = j + 1; }
    elif (tj == 105) { j = j + 1; }
    return j + 1;
}
# A string token value's bytes: the pool, or the side table for a directive message (bit 30).
fn _lit_ptr(S, v): i64 {
    var off = v >> 32;
    if ((off & 0x40000000) != 0) { return _lex_side + (off & 0x3FFFFFFF); }
    return S + 0x21A000 + off;
}

fn LEX(S): i64 {
    var p = 0;
    var bl = GBL(S);
    STCNT(S, 0);
    SNPOS(S, 0);
    while (p < bl) {
        _tok_start = p;   # v6.4.60: token-start offset for the packed tok_lines column/excerpt
        var c = load8(S + 0x459D000 + p);
        var cl = CCLASS(c);
        # Whitespace — skip (track newlines for line numbers)
        if (cl == 1) {
            if (c == 10) { SCLINE(S, GCLINE(S) + 1); }
            p = p + 1;
        }
        # Comment, or one of the ten `#` attributes (#assert, #regalloc, #deprecated, ...)
        else { if (c == 35) {
                # An attribute emits its token and the REST OF THE LINE IS LEXED AS CODE —
                # the whitespace after it is skipped by the loop's own whitespace arm.
                # ⛔ 6.6.20 — the word list is LEXATTRWORD, and the preprocessor reads the
                # SAME list (PP_LEXST_AT) so its lexical state cannot drift from this one.
                # CHANGELOG [6.6.20]
                var atk = LEXATTRWORD(S + 0x459D000, p, bl);
                if (atk != 0) {
                    ADDTOK(S, atk >> 4, 0);
                    p = p + 1 + (atk & 15);
                    continue;
                }
                # Regular comment — skip to newline
                p = p + 1;
                var cgo = 1;
                while (cgo == 1) {
                    if (p >= bl) { cgo = 0; }
                    if (cgo == 1) {
                        if (load8(S + 0x459D000 + p) == 10) { SCLINE(S, GCLINE(S) + 1); p = p + 1; cgo = 0; }
                        else { p = p + 1; }
                    }
                }
            }
            # Digit
            else { if (cl == 2) { p = LEXNUM(S, p); }
                # Letter (lower or upper) or underscore
                else { if (cl >= 3) { p = LEXID(S, p, GNPOS(S)); }
                    # Single/double char tokens
                    else { if (c == 61) {
                            if (p + 1 < bl) {
                                if (load8(S + 0x459D000 + p + 1) == 61) { ADDTOK(S, 17, 0); p = p + 2; }
                                else { ADDTOK(S, 4, 0); p = p + 1; }
                            } else { ADDTOK(S, 4, 0); p = p + 1; }
                        }
                        else { if (c == 59) { ADDTOK(S, 5, 0); p = p + 1; }
                            else { if (c == 44) { ADDTOK(S, 31, 0); p = p + 1; }
                                else { if (c == 46) {
                                        # v5.5.36 Phase 3 — collapse three consecutive dots into
                                        # a single ELLIPSIS token (TOK=112) for variadic fn syntax
                                        # `fn f(a, ...)`. Single or double dots still emit DOT
                                        # tokens (struct field access, nested `s.inner.field`).
                                        if (p + 2 < bl) {
                                            if (load8(S + 0x459D000 + p + 1) == 46) {
                                                if (load8(S + 0x459D000 + p + 2) == 46) {
                                                    ADDTOK(S, 112, 0); p = p + 3;
                                                } else { ADDTOK(S, 41, 0); p = p + 1; }
                                            } else { ADDTOK(S, 41, 0); p = p + 1; }
                                        } else { ADDTOK(S, 41, 0); p = p + 1; }
                                    }
                                    else { if (c == 58) { ADDTOK(S, 49, 0); p = p + 1; }
                                        # v5.6.2: overflow operators `+%` / `+|` / `+?` (wrapping /
                                        # saturating / checked). Lookahead one byte; if no match, fall
                                        # back to plain `+` (token 6). Wrapping is semantically identical
                                        # to bare `+` — the distinct token carries intent for readers
                                        # and future `--strict`-mode diagnostics. Saturating and checked
                                        # compile to a stdlib helper call (lib/overflow.cyr — explicit
                                        # include required).
                                        else { if (c == 43) {
                                                if (p + 1 < bl) {
                                                    var nc = load8(S + 0x459D000 + p + 1);
                                                    if (nc == 37)      { ADDTOK(S, 113, 0); p = p + 2; }  # +%
                                                    elif (nc == 124)   { ADDTOK(S, 114, 0); p = p + 2; }  # +|
                                                    elif (nc == 63)    { ADDTOK(S, 115, 0); p = p + 2; }  # +?
                                                    else               { ADDTOK(S, 6,   0); p = p + 1; }
                                                } else { ADDTOK(S, 6, 0); p = p + 1; }
                                            }
                                            else { if (c == 45) {
                                                    if (p + 1 < bl) {
                                                        var nc = load8(S + 0x459D000 + p + 1);
                                                        if (nc == 37)      { ADDTOK(S, 116, 0); p = p + 2; }  # -%
                                                        elif (nc == 124)   { ADDTOK(S, 117, 0); p = p + 2; }  # -|
                                                        elif (nc == 63)    { ADDTOK(S, 118, 0); p = p + 2; }  # -?
                                                        else               { ADDTOK(S, 7,   0); p = p + 1; }
                                                    } else { ADDTOK(S, 7, 0); p = p + 1; }
                                                }
                                                else { if (c == 42) {
                                                        if (p + 1 < bl) {
                                                            var nc = load8(S + 0x459D000 + p + 1);
                                                            if (nc == 37)      { ADDTOK(S, 119, 0); p = p + 2; }  # *%
                                                            elif (nc == 124)   { ADDTOK(S, 120, 0); p = p + 2; }  # *|
                                                            elif (nc == 63)    { ADDTOK(S, 121, 0); p = p + 2; }  # *?
                                                            else               { ADDTOK(S, 8,   0); p = p + 1; }
                                                        } else { ADDTOK(S, 8, 0); p = p + 1; }
                                                    }
                                                    else { if (c == 47) { ADDTOK(S, 9, 0); p = p + 1; }
                                                        else { if (c == 40) { ADDTOK(S, 10, 0); p = p + 1; }
                                                            else { if (c == 41) { ADDTOK(S, 11, 0); p = p + 1; }
                                                                else { if (c == 123) { ADDTOK(S, 13, 0); p = p + 1; }
                                                                    else { if (c == 125) { ADDTOK(S, 14, 0); p = p + 1; }
                                                                        # !=
                                                                        else { if (c == 33) {
                                                                                if (p + 1 < bl) {
                                                                                    if (load8(S + 0x459D000 + p + 1) == 61) { ADDTOK(S, 18, 0); p = p + 2; }
                                                                                    else { p = p + 1; }
                                                                                } else { p = p + 1; }
                                                                            }
                                                                            # < or <= or <<
                                                                            else { if (c == 60) {
                                                                                    if (p + 1 < bl) {
                                                                                        var nc = load8(S + 0x459D000 + p + 1);
                                                                                        if (nc == 61) { ADDTOK(S, 21, 0); p = p + 2; }
                                                                                        else {
                                                                                            if (nc == 60) { ADDTOK(S, 38, 0); p = p + 2; }
                                                                                            else { ADDTOK(S, 19, 0); p = p + 1; }
                                                                                        }
                                                                                    } else { ADDTOK(S, 19, 0); p = p + 1; }
                                                                                }
                                                                                # > or >= or >>
                                                                                else { if (c == 62) {
                                                                                        if (p + 1 < bl) {
                                                                                            var gc = load8(S + 0x459D000 + p + 1);
                                                                                            if (gc == 61) { ADDTOK(S, 22, 0); p = p + 2; }
                                                                                            else {
                                                                                                if (gc == 62) {
                                                                                                    var g3 = 0;
                                                                                                    if (p + 2 < bl) { g3 = load8(S + 0x459D000 + p + 2); }
                                                                                                    if (g3 == 62) { ADDTOK(S, 152, 0); p = p + 3; }
                                                                                                    else { ADDTOK(S, 39, 0); p = p + 2; }
                                                                                                }
                                                                                                else { ADDTOK(S, 20, 0); p = p + 1; }
                                                                                            }
                                                                                        } else { ADDTOK(S, 20, 0); p = p + 1; }
                                                                                    }
                                                                                    else { if (c == 38) {
                                                                                            if (p + 1 < bl) {
                                                                                                if (load8(S + 0x459D000 + p + 1) == 38) { ADDTOK(S, 53, 0); p = p + 2; }
                                                                                                else { ADDTOK(S, 27, 0); p = p + 1; }
                                                                                            } else { ADDTOK(S, 27, 0); p = p + 1; }
                                                                                        }
                                                                                        else { if (c == 91) { ADDTOK(S, 28, 0); p = p + 1; }
                                                                                            else { if (c == 93) { ADDTOK(S, 29, 0); p = p + 1; }
                                                                                                else { if (c == 124) {
                                                                                                        if (p + 1 < bl) {
                                                                                                            if (load8(S + 0x459D000 + p + 1) == 124) { ADDTOK(S, 54, 0); p = p + 2; }
                                                                                                            else { ADDTOK(S, 35, 0); p = p + 1; }
                                                                                                        } else { ADDTOK(S, 35, 0); p = p + 1; }
                                                                                                    }
                                                                                                    else { if (c == 94) { ADDTOK(S, 36, 0); p = p + 1; }
                                                                                                        else { if (c == 126) { ADDTOK(S, 37, 0); p = p + 1; }
                                                                                                            # v5.8.29: `?` standalone postfix token (Result-propagation).
                                                                                                            # Distinct from the TS-regex compounds `+?`/`-?`/`*?` (115/118/121)
                                                                                                            # already handled in their respective add/sub/mul branches above —
                                                                                                            # those consume two bytes; this single-char form is the bare `?`.
                                                                                                            else { if (c == 63) { ADDTOK(S, 124, 0); p = p + 1; }
                                                                                                                # v5.6.3: @unsafe — block attribute marking memory/FFI boundary.
                                                                                                                # bytes: 40 75 6E 73 61 66 65 = "@unsafe" (7 chars). Advisory in
                                                                                                                # v5.6.3 (nested-unsafe warning only). Parser treats the body as
                                                                                                                # a plain `{ ... }` block.
                                                                                                                else { if (c == 64) {
                                                                                                                        if (p + 6 < bl) {
                                                                                                                            if (load8(S + 0x459D000 + p + 1) == 117) {
                                                                                                                                if (load8(S + 0x459D000 + p + 2) == 110) {
                                                                                                                                    if (load8(S + 0x459D000 + p + 3) == 115) {
                                                                                                                                        if (load8(S + 0x459D000 + p + 4) == 97) {
                                                                                                                                            if (load8(S + 0x459D000 + p + 5) == 102) {
                                                                                                                                                if (load8(S + 0x459D000 + p + 6) == 101) {
                                                                                                                                                    ADDTOK(S, 123, 0);   # token 123 = AT_UNSAFE
                                                                                                                                                    p = p + 7;
                                                                                                                                                    while (p < bl) {
                                                                                                                                                        var wcu = load8(S + 0x459D000 + p);
                                                                                                                                                        if (wcu == 32 || wcu == 9 || wcu == 10 || wcu == 13) {
                                                                                                                                                            if (wcu == 10) { SCLINE(S, GCLINE(S) + 1); }
                                                                                                                                                            p = p + 1;
                                                                                                                                                        }
                                                                                                                                                        else { break; }
                                                                                                                                                    }
                                                                                                                                                    continue;
                                                                                                                                                } } } } } }
                                                                                                                        }
                                                                                                                        # Any other `@` is a stray byte (CVE-52): see _lex_stray. CHANGELOG [6.6.10]
                                                                                                                        _lex_stray(S, p, c);
                                                                                                                    }
                                                                                                                    else { if (c == 37) { ADDTOK(S, 34, 0); p = p + 1; }
                                                                                                                        # << or <
                                                                                                                        # (already handled < and <= above, need << separately)
                                                                                                                        # >> or >
                                                                                                                        # (already handled > and >= above, need >> separately)
                                                                                                                        # v5.9.37: char literal — `'X'` or `'\X'`. Emits a
                                                                                                                        # NUMBER token (type 1) with the byte value.
                                                                                                                        # Required by agnosys 1.1.12 verbatim repro at
                                                                                                                        # /tmp/cyrius-derive-serialize-incomplete/minimal_repro.cyr
                                                                                                                        # which uses `str_builder_putc(sb, '[')`.
                                                                                                                        # Pre-fix the lexer had no char-literal branch; aarch64
                                                                                                                        # error:N: unexpected '['.
                                                                                                                        else { if (c == 39) {
                                                                                                                                p = p + 1;
                                                                                                                                if (p >= bl) {
                                                                                                                                    _lex_die(S, _tok_start, "unterminated char literal");
                                                                                                                                }
                                                                                                                                var clv = 0;
                                                                                                                                var c0 = load8(S + 0x459D000 + p);
                                                                                                                                if (c0 == 92) {
                                                                                                                                    p = p + 1;
                                                                                                                                    if (p >= bl) {
                                                                                                                                        _lex_die(S, _tok_start, "unterminated char escape");
                                                                                                                                    }
                                                                                                                                    var c1 = load8(S + 0x459D000 + p);
                                                                                                                                    p = p + 1;
                                                                                                                                    if      (c1 == 110) { clv = 10; }       # \n
                                                                                                                                    elif    (c1 == 114) { clv = 13; }       # \r
                                                                                                                                    elif    (c1 == 116) { clv =  9; }       # \t
                                                                                                                                    elif    (c1 == 48)  { clv =  0; }       # \0
                                                                                                                                    elif    (c1 == 92)  { clv = 92; }       # \\
                                                                                                                                    elif    (c1 == 39)  { clv = 39; }       # \'
                                                                                                                                    elif    (c1 == 34)  { clv = 34; }       # \"
                                                                                                                                    else {
                                                                                                                                        _lex_die(S, _tok_start, "unknown char escape");
                                                                                                                                    }
                                                                                                                                } else {
                                                                                                                                    clv = c0;
                                                                                                                                    p = p + 1;
                                                                                                                                }
                                                                                                                                if (p >= bl) {
                                                                                                                                    _lex_die(S, _tok_start, "unterminated char literal");
                                                                                                                                }
                                                                                                                                if (load8(S + 0x459D000 + p) != 39) {
                                                                                                                                    _lex_die(S, _tok_start, "multi-byte char literal not supported");
                                                                                                                                }
                                                                                                                                p = p + 1;
                                                                                                                                ADDTOK(S, 1, clv);
                                                                                                                            }
                                                                                                                            # String literal
                                                                                                                            else { if (c == 34) {
                                                                                                                                    p = p + 1;
                                                                                                                                    var spos = GSPOS(S);
                                                                                                                                    var sstart = spos;
                                                                                                                                    var sline = GCLINE(S);   # the token keeps its OPENING line; LFs inside count after it
                                                                                                                                    var sgo = 1;
                                                                                                                                    while (sgo == 1) {
                                                                                                                                        # EOF before the closing quote is an ERROR (it ended the string silently, so the
                                                                                                                                        # parser reported a misleading `expected ';'` at a later line). Named at the OPENING
                                                                                                                                        # quote's file:line:col. CHANGELOG [6.6.12]
                                                                                                                                        if (p >= bl) { _lex_unterm_str(S, _tok_start, sline); }
                                                                                                                                        # CVE-06: bounds check str_data (2MB at 0x21A000; v5.8.59 was 256KB at 0x14A000)
                                                                                                                                        if (spos >= 2097152) {
                                                                                                                                            syscall(SYS_WRITE, 2, "error: string data overflow (2MB limit)\n", 40);
                                                                                                                                            syscall(SYS_EXIT, 1);
                                                                                                                                        }
                                                                                                                                        if (sgo == 1) {
                                                                                                                                            var sc = load8(S + 0x459D000 + p);
                                                                                                                                            if (sc == 34) { p = p + 1; sgo = 0; }
                                                                                                                                            else {
                                                                                                                                                # A `\` that is the LAST byte escapes nothing: kept raw, so the EOF check above
                                                                                                                                                # reports the unterminated string instead of reading past the buffer. CHANGELOG [6.6.12]
                                                                                                                                                if (sc == 92 && p + 1 < bl) {
                                                                                                                                                    var esc = p;   # the backslash: where an escape diagnostic points. CHANGELOG [6.6.10]
                                                                                                                                                    p = p + 1;
                                                                                                                                                    var ec = load8(S + 0x459D000 + p);
                                                                                                                                                    p = p + 1;
                                                                                                                                                    if (ec == 110)      { store8(S + 0x21A000 + spos, 10); spos = spos + 1; }
                                                                                                                                                    elif (ec == 114)    { store8(S + 0x21A000 + spos, 13); spos = spos + 1; }
                                                                                                                                                    elif (ec == 116)    { store8(S + 0x21A000 + spos,  9); spos = spos + 1; }
                                                                                                                                                    elif (ec == 48)     { store8(S + 0x21A000 + spos,  0); spos = spos + 1; }
                                                                                                                                                    elif (ec == 92)     { store8(S + 0x21A000 + spos, 92); spos = spos + 1; }
                                                                                                                                                    elif (ec == 34)     { store8(S + 0x21A000 + spos, 34); spos = spos + 1; }
                                                                                                                                                    elif (ec == 39)     { store8(S + 0x21A000 + spos, 39); spos = spos + 1; }
                                                                                                                                                    elif (ec == 97)     { store8(S + 0x21A000 + spos,  7); spos = spos + 1; }
                                                                                                                                                    elif (ec == 98)     { store8(S + 0x21A000 + spos,  8); spos = spos + 1; }
                                                                                                                                                    elif (ec == 102)    { store8(S + 0x21A000 + spos, 12); spos = spos + 1; }
                                                                                                                                                    elif (ec == 118)    { store8(S + 0x21A000 + spos, 11); spos = spos + 1; }
                                                                                                                                                    elif (ec == 120) {
                                                                                                                                                        # v5.7.13: \x## - exactly two hex digits.
                                                                                                                                                        if (p + 1 >= bl) {
                                                                                                                                                            _lex_die(S, esc, "\\x escape needs two hex digits");
                                                                                                                                                        }
                                                                                                                                                        var h1 = _LEX_HEX_VAL(load8(S + 0x459D000 + p));
                                                                                                                                                        var h2 = _LEX_HEX_VAL(load8(S + 0x459D000 + p + 1));
                                                                                                                                                        if (h1 < 0) {
                                                                                                                                                            _lex_die(S, esc, "\\x escape: bad hex digit");
                                                                                                                                                        }
                                                                                                                                                        if (h2 < 0) {
                                                                                                                                                            _lex_die(S, esc, "\\x escape: bad hex digit");
                                                                                                                                                        }
                                                                                                                                                        store8(S + 0x21A000 + spos, (h1 << 4) | h2);
                                                                                                                                                        spos = spos + 1;
                                                                                                                                                        p = p + 2;
                                                                                                                                                    }
                                                                                                                                                    elif (ec == 117) {
                                                                                                                                                        # v5.7.13: \u#### (four hex) or \u{...} (1..6 hex).
                                                                                                                                                        var cp = 0;
                                                                                                                                                        if (p < bl && load8(S + 0x459D000 + p) == 123) {
                                                                                                                                                            p = p + 1;
                                                                                                                                                            var ndig = 0;
                                                                                                                                                            var udone = 0;
                                                                                                                                                            while (udone == 0) {
                                                                                                                                                                if (p >= bl) {
                                                                                                                                                                    _lex_die(S, esc, "\\u{...} escape: missing closing brace");
                                                                                                                                                                }
                                                                                                                                                                var bc = load8(S + 0x459D000 + p);
                                                                                                                                                                if (bc == 125) { udone = 1; }
                                                                                                                                                                else {
                                                                                                                                                                    var hv = _LEX_HEX_VAL(bc);
                                                                                                                                                                    if (hv < 0) {
                                                                                                                                                                        _lex_die(S, esc, "\\u{...} escape: bad hex digit");
                                                                                                                                                                    }
                                                                                                                                                                    if (ndig >= 6) {
                                                                                                                                                                        _lex_die(S, esc, "\\u{...} escape: > 6 hex digits");
                                                                                                                                                                    }
                                                                                                                                                                    cp = (cp << 4) | hv;
                                                                                                                                                                    ndig = ndig + 1;
                                                                                                                                                                    p = p + 1;
                                                                                                                                                                }
                                                                                                                                                            }
                                                                                                                                                            if (ndig == 0) {
                                                                                                                                                                _lex_die(S, esc, "\\u{...} escape: no hex digits");
                                                                                                                                                            }
                                                                                                                                                            p = p + 1;
                                                                                                                                                        } else {
                                                                                                                                                            if (p + 3 >= bl) {
                                                                                                                                                                _lex_die(S, esc, "\\u escape needs four hex digits");
                                                                                                                                                            }
                                                                                                                                                            var di = 0;
                                                                                                                                                            while (di < 4) {
                                                                                                                                                                var hv = _LEX_HEX_VAL(load8(S + 0x459D000 + p + di));
                                                                                                                                                                if (hv < 0) {
                                                                                                                                                                    _lex_die(S, esc, "\\u escape: bad hex digit");
                                                                                                                                                                }
                                                                                                                                                                cp = (cp << 4) | hv;
                                                                                                                                                                di = di + 1;
                                                                                                                                                            }
                                                                                                                                                            p = p + 4;
                                                                                                                                                        }
                                                                                                                                                        if (cp > 1114111) {
                                                                                                                                                            _lex_die(S, esc, "\\u escape: codepoint > U+10FFFF");
                                                                                                                                                        }
                                                                                                                                                        if (cp >= 55296 && cp <= 57343) {
                                                                                                                                                            _lex_die(S, esc, "\\u escape: surrogate codepoint not allowed");
                                                                                                                                                        }
                                                                                                                                                        spos = _LEX_EMIT_UTF8(S, spos, cp);
                                                                                                                                                    }
                                                                                                                                                    # `\<LF>` KEEPS its LF (the v6.5.18 contract, tests/gates/toolchain/cyrfmt_string_
                                                                                                                                                    # continuation.sh) and counts the line; `\<CR><LF>` keeps both bytes, the LF counted
                                                                                                                                                    # by the plain arm below. Any other byte after `\` is refused: it used to be stored
                                                                                                                                                    # verbatim with the backslash dropped (`"\q"` was "q"). CHANGELOG [6.6.11]
                                                                                                                                                    elif (ec == 10) { _lex_str_lf(S, p, sline); store8(S + 0x21A000 + spos, 10); spos = spos + 1; }
                                                                                                                                                    elif (ec == 13 && load8(S + 0x459D000 + p) == 10) { store8(S + 0x21A000 + spos, 13); spos = spos + 1; }
                                                                                                                                                    else { _lex_die(S, esc, "unknown string escape"); }
                                                                                                                                                } else {
                                                                                                                                                    if (sc == 10) { _lex_str_lf(S, p + 1, sline); }   # a raw LF in a string is a line. CHANGELOG [6.6.11]
                                                                                                                                                    store8(S + 0x21A000 + spos, sc);
                                                                                                                                                    spos = spos + 1;
                                                                                                                                                    p = p + 1;
                                                                                                                                                }
                                                                                                                                            }
                                                                                                                                        }
                                                                                                                                    }
                                                                                                                                    # Add null terminator after string literal
                                                                                                                                    store8(S + 0x21A000 + spos, 0);
                                                                                                                                    var slen = spos - sstart;
                                                                                                                                    # String interning: an identical literal already in str_data is reused (its offset), so
                                                                                                                                    # pointer-identity comparison works. `_lex_intern` looks a NUL-free literal up in an index
                                                                                                                                    # and scans for one holding a NUL. CHANGELOG [6.6.19]
                                                                                                                                    var interned = _lex_intern(S, sstart, slen);
                                                                                                                                    if (interned >= 0) {
                                                                                                                                        sstart = interned;
                                                                                                                                    } else {
                                                                                                                                        spos = spos + 1;
                                                                                                                                        if (spos >= 2097152) {
                                                                                                                                            syscall(SYS_WRITE, 2, "error: string data buffer full (2MB limit)\n", 43);
                                                                                                                                            syscall(SYS_EXIT, 1);
                                                                                                                                        }
                                                                                                                                        SSPOS(S, spos);
                                                                                                                                    }
                                                                                                                                    # Token-30 value = (pool offset << 32) | length. str_data is 2 MB (offsets and
                                                                                                                                    # lengths both need 21 bits); the old 16-bit length field OR-ed a >= 64 KB
                                                                                                                                    # literal's length INTO the offset, so the literal read from its 2nd byte.
                                                                                                                                    # Decoders: parse_expr.cyr ESADDR, parse.cyr #assert/#pe_import, parse_fn.cyr
                                                                                                                                    # #deprecated. CHANGELOG [6.6.4]
                                                                                                                                    var eline = GCLINE(S);
                                                                                                                                    SCLINE(S, sline);
                                                                                                                                    ADDTOK(S, 30, (sstart << 32) | slen);
                                                                                                                                    SCLINE(S, eline);
                                                                                                                                    _lex_dir_msg_fix(S, interned);   # 6.6.17: a directive-only message leaves the pool
                                                                                                                                }
                                                                                                                                else {
                                                                                                                                    # Reject non-ASCII bytes outside strings/comments
                                                                                                                                    if (c > 127) {
                                                                                                                                        _lex_stray(S, p, c);
                                                                                                                                    }
                                                                                                                                    else {
                                                                                                                                        # CVE-31: a stray ASCII byte (`$`, backtick, a control char, ...) that
                                                                                                                                        # matched no token was silently skipped -- error now, through the same
                                                                                                                                        # reject as `@` and non-ASCII (_lex_stray). CHANGELOG [6.6.10]
                                                                                                                                        _lex_stray(S, p, c);
                                                                                                                                    }
                                                                                                                                    p = p + 1;
                                                                                                                                }
                                                                                                                            } } } } } } } } } } }
                                                                                } } } } } } } } }
                                            } } } } } } } } }
        }
    }
    _lex_eof_tok(S, bl);
    # 6.6.5 — one pass over the finished token stream to record which files declared
    # `private`, BEFORE pass 1 stamps anything. See _PRIV_PRESCAN (src/frontend/parse.cyr)
    # for why this cannot be done during the walk. CHANGELOG [6.6.5]
    _PRIV_PRESCAN(S);
    return 0;
}

# ================================================================
