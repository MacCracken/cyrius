        op = op + PP_EMIT_STR(out, op, "if (load8(bp + p) == 91) { p = p + 1;\nwhile (1 == 1) {\n");
        op = op + PP_EMIT_STR(out, op, "while (load8(bp + p) == 32 || load8(bp + p) == 10 || load8(bp + p) == 13 || load8(bp + p) == 9 || load8(bp + p) == 44) { p = p + 1; }\n");
        op = op + PP_EMIT_STR(out, op, "var c = load8(bp + p);\nif (c == 93 || c == 0) { break; }\nvar vs = p;\n");
