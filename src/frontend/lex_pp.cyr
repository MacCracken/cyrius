# LEXER — preprocessor: #include / #define / #ifdef / #ifplat /
# #derive / #regalloc / #pe_import handling, macro expansion,
# ref-expansion pass.
# ================================================================
# Split out of src/frontend/lex.cyr in v5.5.38 to keep single-file
# LOC under ~1500. The lexer proper (LEX / LEXID / LEXNUM etc.)
# stays in lex.cyr; this file owns everything that runs in the
# PREPROCESS orchestrator before LEX sees the output buffer.
# Included by lex.cyr at the same textual position the original
# content lived; self-host byte-identical.

fn ISREF(S, pos, bl): i64 {
    if (pos + 5 >= bl) { return 0; }
    if (load8(S + pos) != 35) { return 0; }
    if (load8(S + pos + 1) != 114) { return 0; }
    if (load8(S + pos + 2) != 101) { return 0; }
    if (load8(S + pos + 3) != 102) { return 0; }
    if (load8(S + pos + 4) != 32) { return 0; }
    return 1;
}

# Emit TOML key-value pairs as var declarations into preprocessor output.
# Simple: read file, for each line starting with a letter, emit "var LINE;\n".

fn ISINCLUDE(S, pos, bl): i64 {
    if (pos + 8 >= bl) { return 0; }
    # i=69 n=6E c=63 l=6C u=75 d=64 e=65 space=20
    if (load8(S + pos) != 105) { return 0; }
    if (load8(S + pos + 1) != 110) { return 0; }
    if (load8(S + pos + 2) != 99) { return 0; }
    if (load8(S + pos + 3) != 108) { return 0; }
    if (load8(S + pos + 4) != 117) { return 0; }
    if (load8(S + pos + 5) != 100) { return 0; }
    if (load8(S + pos + 6) != 101) { return 0; }
    if (load8(S + pos + 7) != 32) { return 0; }
    return 1;
}

# Preprocess: expand include directives in-place.
# Uses S+0 as input, S+0x459D000 as expanded output (1MB), copies back to S+0.
# Check if buffer at pos starts with a directive (returns length or 0)
fn ISDEFINE(S, pos, bl): i64 {
    # Leading whitespace tolerated (see PP_SKIP_WS). Note that the
    # callers pass `ip + 8` to PP_DEFINE to reach the name — if we
    # skipped whitespace here, that offset would be wrong. ISDEFINE
    # stays strict; directive detection remains col-0 for #define.
    if (pos + 8 >= bl) { return 0; }
    # "#define " = 23 64 65 66 69 6E 65 20
    if (load8(S + pos) != 35) { return 0; }
    if (load8(S + pos + 1) != 100) { return 0; }
    if (load8(S + pos + 2) != 101) { return 0; }
    if (load8(S + pos + 3) != 102) { return 0; }
    if (load8(S + pos + 4) != 105) { return 0; }
    if (load8(S + pos + 5) != 110) { return 0; }
    if (load8(S + pos + 6) != 101) { return 0; }
    if (load8(S + pos + 7) != 32) { return 0; }
    return 1;
}

# Skip spaces/tabs starting at `pos`. Used by the `#`-prefixed
# directive detectors so `    #ifdef FOO` (cyrfmt indents directives
# to match the enclosing function body) still registers. Keeping
# this separate from the plain ISINCLUDE path means `    include = 0;`
# (a variable named `include` at indentation) stays an expression,
# not a directive.
fn PP_SKIP_WS(S, pos, bl): i64 {
    while (pos < bl) {
        var sc = load8(S + pos);
        if (sc != 32) { if (sc != 9) { return pos; } }
        pos = pos + 1;
    }
    return pos;
}

fn ISIFDEF(S, pos, bl): i64 {
    if (pos + 7 >= bl) { return 0; }
    # "#ifdef " = 23 69 66 64 65 66 20
    if (load8(S + pos) != 35) { return 0; }
    if (load8(S + pos + 1) != 105) { return 0; }
    if (load8(S + pos + 2) != 102) { return 0; }
    if (load8(S + pos + 3) != 100) { return 0; }
    if (load8(S + pos + 4) != 101) { return 0; }
    if (load8(S + pos + 5) != 102) { return 0; }
    if (load8(S + pos + 6) != 32) { return 0; }
    return 1;
}

# "#ifndef " = 23 69 66 6E 64 65 66 20 (v5.6.1) — inverse of #ifdef.
# `#ifndef X` emits body iff X is NOT defined. Standard C-family shape
# (and what every stdlib selector in lib/*.cyr would need to drop a
# few paired `#ifdef` blocks once `#else` also lands later in this
# patch).
fn ISIFNDEF(S, pos, bl): i64 {
    if (pos + 8 >= bl) { return 0; }
    if (load8(S + pos)     != 35)  { return 0; }
    if (load8(S + pos + 1) != 105) { return 0; }
    if (load8(S + pos + 2) != 102) { return 0; }
    if (load8(S + pos + 3) != 110) { return 0; }
    if (load8(S + pos + 4) != 100) { return 0; }
    if (load8(S + pos + 5) != 101) { return 0; }
    if (load8(S + pos + 6) != 102) { return 0; }
    if (load8(S + pos + 7) != 32)  { return 0; }
    return 1;
}

# "#else" = 23 65 6C 73 65 (v5.6.1). No arg. Must not accidentally
# match "#elseif" or other prefixes — check byte 5 is non-identifier
# (space, newline, or end of buffer).
fn ISELSE(S, pos, bl): i64 {
    if (pos + 5 > bl) { return 0; }
    if (load8(S + pos)     != 35)  { return 0; }
    if (load8(S + pos + 1) != 101) { return 0; }
    if (load8(S + pos + 2) != 108) { return 0; }
    if (load8(S + pos + 3) != 115) { return 0; }
    if (load8(S + pos + 4) != 101) { return 0; }
    if (pos + 5 < bl) {
        var tc = load8(S + pos + 5);
        # Terminator: whitespace, newline, or EOF. Reject identifier
        # continuation so "#elseif" (hypothetical typo) doesn't match.
        if (tc != 32) { if (tc != 9) { if (tc != 10) { if (tc != 13) { if (tc != 0) { return 0; } } } } }
    }
    return 1;
}

# "#elif " = 23 65 6C 69 66 20 (v5.6.1). Arg is a condition expression
# parsed by the same PP_EVAL_IF used for `#if`.
fn ISELIF(S, pos, bl): i64 {
    if (pos + 6 >= bl) { return 0; }
    if (load8(S + pos)     != 35)  { return 0; }
    if (load8(S + pos + 1) != 101) { return 0; }
    if (load8(S + pos + 2) != 108) { return 0; }
    if (load8(S + pos + 3) != 105) { return 0; }
    if (load8(S + pos + 4) != 102) { return 0; }
    if (load8(S + pos + 5) != 32)  { return 0; }
    return 1;
}

# "#if " = 23 69 66 20
fn ISIF(S, pos, bl): i64 {
    if (pos + 4 >= bl) { return 0; }
    if (load8(S + pos) != 35) { return 0; }
    if (load8(S + pos + 1) != 105) { return 0; }
    if (load8(S + pos + 2) != 102) { return 0; }
    if (load8(S + pos + 3) != 32) { return 0; }
    # Must NOT be #ifdef (check 5th char isn't 'd')
    if (load8(S + pos + 4) == 100) { return 0; }
    return 1;
}

# Evaluate #if condition: NAME OP VALUE
# Supports: ==, !=, <, >, <=, >=
# Returns 1 (true) or 0 (false)
# v5.6.42: src_base for source reads (see PP_HASH above).
fn PP_EVAL_IF(S, src_base, pos): i64 {
    # Skip whitespace
    while (load8(src_base + pos) == 32) { pos = pos + 1; }
    # Get name value
    var lhs = PP_GETVAL(S, src_base, pos);
    # Skip name
    while (load8(src_base + pos) != 32) {
        if (load8(src_base + pos) == 10) { return lhs != 0; }
        if (load8(src_base + pos) == 0) { return lhs != 0; }
        pos = pos + 1;
    }
    # Skip whitespace
    while (load8(src_base + pos) == 32) { pos = pos + 1; }
    # Read operator
    var op1 = load8(src_base + pos);
    var op2 = load8(src_base + pos + 1);
    var op = 0;
    if (op1 == 61) { if (op2 == 61) { op = 1; pos = pos + 2; } }
    if (op1 == 33) { if (op2 == 61) { op = 2; pos = pos + 2; } }
    if (op1 == 62) { if (op2 == 61) { op = 5; pos = pos + 2; } elif (op2 != 61) { op = 3; pos = pos + 1; } }
    if (op1 == 60) { if (op2 == 61) { op = 6; pos = pos + 2; } elif (op2 != 61) { op = 4; pos = pos + 1; } }
    if (op == 0) { return lhs != 0; }
    # Skip whitespace
    while (load8(src_base + pos) == 32) { pos = pos + 1; }
    # Parse RHS integer
    var rhs = 0;
    var rc = load8(src_base + pos);
    while (rc >= 48) {
        if (rc > 57) { break; }
        rhs = rhs * 10 + rc - 48;
        pos = pos + 1;
        rc = load8(src_base + pos);
    }
    # Evaluate
    if (op == 1) { return lhs == rhs; }
    if (op == 2) { return lhs != rhs; }
    if (op == 3) { return lhs > rhs; }
    if (op == 4) { return lhs < rhs; }
    if (op == 5) { return lhs >= rhs; }
    if (op == 6) { return lhs <= rhs; }
    return 0;
}

fn ISENDIF(S, pos, bl): i64 {
    if (pos + 6 >= bl) { return 0; }
    # "#endif" = 23 65 6E 64 69 66
    if (load8(S + pos) != 35) { return 0; }
    if (load8(S + pos + 1) != 101) { return 0; }
    if (load8(S + pos + 2) != 110) { return 0; }
    if (load8(S + pos + 3) != 100) { return 0; }
    if (load8(S + pos + 4) != 105) { return 0; }
    if (load8(S + pos + 5) != 102) { return 0; }
    return 1;
}

# `#ifplat PLAT` (v5.4.19) — sugar for `#ifdef CYRIUS_ARCH_<PLAT>`.
# Supported platform tokens: `x86`, `aarch64`. Unknown tokens fall
# through as false (block skipped). `#endplat` is paired with
# `#ifplat`; semantically identical to `#endif` but visually pairs.
# "#ifplat " = 23 69 66 70 6C 61 74 20
fn ISIFPLAT(S, pos, bl): i64 {
    if (pos + 8 >= bl) { return 0; }
    if (load8(S + pos)     != 35)  { return 0; }
    if (load8(S + pos + 1) != 105) { return 0; }
    if (load8(S + pos + 2) != 102) { return 0; }
    if (load8(S + pos + 3) != 112) { return 0; }
    if (load8(S + pos + 4) != 108) { return 0; }
    if (load8(S + pos + 5) != 97)  { return 0; }
    if (load8(S + pos + 6) != 116) { return 0; }
    if (load8(S + pos + 7) != 32)  { return 0; }
    return 1;
}

# "#endplat" = 23 65 6E 64 70 6C 61 74
fn ISENDPLAT(S, pos, bl): i64 {
    if (pos + 8 >= bl) { return 0; }
    if (load8(S + pos)     != 35)  { return 0; }
    if (load8(S + pos + 1) != 101) { return 0; }
    if (load8(S + pos + 2) != 110) { return 0; }
    if (load8(S + pos + 3) != 100) { return 0; }
    if (load8(S + pos + 4) != 112) { return 0; }
    if (load8(S + pos + 5) != 108) { return 0; }
    if (load8(S + pos + 6) != 97)  { return 0; }
    if (load8(S + pos + 7) != 116) { return 0; }
    return 1;
}

# v6.5.24 — `#@srcline`: "the entry file's own line 1 starts on the NEXT line".
#
# WHY. cbt prepends a variable number of lines in front of the entry file — `#@incdir`,
# `#@pkgver`, one `include` per `[deps].stdlib` module, one `#define` per `-D`, and the
# ENTIRE TEXT of every `[build].modules` file — and only `#@incdir` was ever compensated.
# So `<source>` diagnostics were reported one line late per prepended line: measured at
# 6.5.21, abaco's 18-module manifest shifted every diagnostic by +17, pointing PAST EOF
# on a 23-line file, which reads as a compiler fault rather than a source defect. Filed as
# 2026-08-13-source-diag-line-shift-scales-with-deps-stdlib.
#
# ⭐ WHY A POSITION MARKER AND NOT A COUNT. The obvious design — have cbt declare "I
# prepended N lines" — makes N a hand-maintained value duplicating something derivable,
# and this cycle alone three such values had all silently drifted (heap-map sizes, gate
# counts, ERR_MSG lengths). It would also be wrong the moment `[build].modules` appears,
# since those contribute whole FILES of unknown length. This marker instead says only
# "the real source starts here" and the compiler DERIVES the bias from the marker's own
# line position, so cbt counts nothing and cannot drift.
#
# ⚠ NOT the foreclosed remedy. The filing proposed re-emitting `#@file`, which v6.5.21
# deliberately neutralises in PP_PASS/PP_MACRO_PASS to close a forged-marker bypass of
# `private`. This is a distinct directive that cannot re-enter that hole: it carries no
# filename, cannot open or rename a file span, and only ever moves `<source>` line
# attribution. See the honour-once guard at the PP_PASS call site.
fn ISSRCLINE(S, pos, bl): i64 {
    if (pos + 9 >= bl) { return 0; }
    if (load8(S + pos)     != 35)  { return 0; }   # '#'
    if (load8(S + pos + 1) != 64)  { return 0; }   # '@'
    if (load8(S + pos + 2) != 115) { return 0; }   # 's'
    if (load8(S + pos + 3) != 114) { return 0; }   # 'r'
    if (load8(S + pos + 4) != 99)  { return 0; }   # 'c'
    if (load8(S + pos + 5) != 108) { return 0; }   # 'l'
    if (load8(S + pos + 6) != 105) { return 0; }   # 'i'
    if (load8(S + pos + 7) != 110) { return 0; }   # 'n'
    if (load8(S + pos + 8) != 101) { return 0; }   # 'e'
    return 1;
}

# Include-once: track included filenames to skip duplicates.
# v4.8.4-alpha2: relocated to 0x1C0000 (formerly fn-tables, freed in
# 4.7.1 — 144 KB available). Capacity raised 64 → 256 entries.
# Bote-class projects (16 stdlib + 9 libro + 6 majra + 15 source +
# transitive autos) easily exceed 64; cyrius itself at ~30, kybernet
# >40 already pushed against the wall.
# S+0x197F00: include count (8 bytes — kept at original location)
# S+0x1C0000: included filenames[256] (256 * 128 bytes = 32 KB)
fn PP_ALREADY_INCLUDED(S, fname): i64 {
    var cnt = L64(S + 0x197F00);
    var i = 0;
    while (i < cnt) {
        var p = S + 0x1C0000 + i * 128;
        var c = 0;
        var eq = 1;
        while (eq == 1) {
            var a = load8(fname + c);
            var b = load8(p + c);
            if (a != b) { eq = 0; }
            if (a == 0) { break; }
            c = c + 1;
        }
        if (eq == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# v6.4.81 (CVE-32) — bound for the include / `#ref` filename scratch at
# S+0x190400. The scratch runs to the `#ref` read buffer at S+0x191800, so 4096 B
# (0x190400..0x191400) fits with slack and is well past any real path.
#
# All THREE filename-capture loops (`include`, post-macro-expansion `include`,
# and `#ref`) were UNBOUNDED. `include "<31490 chars>"` walked the write through
# the include-count cell at S+0x197F00 and SIGSEGV'd (exit 139); below that
# threshold it silently corrupted whatever lay between. Reachable from untrusted
# source text with no flag, which is the whole threat model for a compiler.
#
# The heap map hid it: it documented this scratch at 0x190500 [256] — an address
# NO code has ever written (every use is 0x190400) — so `tests/gates/memory/heapmap.sh`
# validated a fiction and reported PASS through three minors of audits. The map
# entry is corrected alongside this bound. See CHANGELOG [6.4.81].
#
# Split into its own fn rather than inlined at the three sites because PREPROCESS
# is already near cybs's per-fn literal/global ceiling (the `_var_grow` /
# TOKNAME_BUILTIN precedent) and seed-derive is the gate that would catch it.
# v6.5.0 Phase 1 — emit one `#@file "<name>"\n` marker into `out` at `op`; returns the
# new `op`. `name` is a NUL-terminated cstr.
#
# Factored out of three inline copies (the initial main-source marker, and the two
# include-expansion sites in PP_PASS / PP_IFDEF_PASS) because v6.5.0 adds a fourth and
# fifth caller — the RESUME markers below — and five copies of an 8-store block inside
# two already-enormous fns is exactly the shape cybs mis-compiles. The `_var_grow`
# `_grow_g1..g7` chain, `TOKNAME_BUILTIN` and `PP_FNAME_TOO_LONG` are all in this file
# or its neighbours for the same reason; seed-derive is the gate that catches it.
# v6.5.0 Phase 1 — the file PP_IFDEF_PASS is currently copying FROM, so a nested
# include can emit a correct resume marker. PP_PASS does not need this (it only ever
# expands top-level includes, so its enclosing file is always the main source), but
# PP_IFDEF_PASS runs over a stream that ALREADY carries `#@file` markers and expands
# the nested ones, so it must remember which file it is inside.
#
# Its own 4 KB scratch rather than a heap band: the surrounding fns already sit near
# cybs's per-fn global-reference ceiling, and a bare top-level `var x[N]` is N*8 bytes
# (the v6.4.10 contract — this is 512*8 = 4096, not 512).
var _pp_curfile[512];
var _pp_curfile_set = 0;
# v6.5.3 — where the CURRENT file's marker sat in this pass's input, and the source line
# it declared. PP_IFDEF_PASS's input is PP_PASS's OUTPUT, i.e. already expanded, so
# counting newlines from offset 0 yields the EXPANDED line, not the file's own. A file
# that itself contains an include therefore reported lines inflated by that include's
# whole body (lib/mid.cyr:2 came out as :4). Anchoring to the file's own marker and
# adding the base it carried fixes that without needing a per-file line counter.
var _pp_curfile_anchor = 0;
var _pp_curfile_base = 1;
# v6.5.19 — 1 when the raw input opened with a `#@incdir <dir>` line (v6.5.7; written at
# byte 0 by `cyrius build` / `check` / `lint` for any source with a directory component).
# That line is a DIRECTIVE, not source, so raw input line N+1 is source line N. Without
# this every diagnostic for such a source was reported one line late — measured at 6.5.18:
# `cyrius build src/g.cyr` said 2:20 for a defect on line 1, while `cycc < g.cyr` on the
# same bytes said 1:20.
var _pp_srcline_bias = 0;
# v6.5.24 — honour-once latch for `#@srcline` (see ISSRCLINE + its PP_PASS call site).
var _pp_srcline_seen = 0;

# v6.5.24 — bare-metal forbidden-module check (bare-metal deliverable #4, filed
# 2026-06-28 as never-built and restored from `archived/` 2026-08-11 after being
# archived UNFIXED). A `--target=<arch>-bare-metal-elf` build sets CYRIUS_KERNEL=1 and
# used to place NO restriction on which `lib/*.cyr` an `include` could pull, so a kernel
# that included a host-OS module compiled silently and faulted at runtime in the kernel.
#
# ⭐ AN ANNOTATION, NOT A DENY-LIST. The filing offered both and preferred the
# annotation, and it is also the anti-drift choice: a central list of host-only modules
# is a hand-maintained value that goes stale every time a module is added or renamed —
# the exact shape that had silently drifted in three separate places this cycle. With
# `#host_only` the fact lives IN the module it describes, so it moves with the file.
# Unannotated modules stay allowed, which keeps the default behaviour identical to
# before (a missing annotation is no worse than today) rather than breaking every
# kernel build on day one.
#
# `#host_only` is inert to everything else in the pipeline: `#` opens a comment in
# cyrius, so an annotated module still compiles normally for host targets.
var _pp_hostonly_hit = 0;      # 1 once a #host_only module has been pulled at all
var _pp_hostonly_user = 0;     # 1 if the pull came from the USER's own source
var _pp_hostonly_name[128];    # the filename to name in the diagnostic (1024 B in .bss)

# Does the freshly-read include text carry a first-column `#host_only` line?
# Bounded to the first 4096 bytes: this is a FILE-level annotation and belongs at the
# top, and a bounded scan keeps it off the hot path. Requires column 0 so prose that
# merely mentions the directive (this comment included) cannot trip it.
fn PP_IS_HOST_ONLY(buf, n): i64 {
    var lim = n;
    if (lim > 4096) { lim = 4096; }
    var i = 0;
    var bol = 1;
    while (i < lim) {
        if (bol == 1) {
            if (i + 10 <= lim) {
                if (load8(buf + i) == 35) {              # '#'
                    if (load8(buf + i + 1) == 104) {      # 'h'
                        if (load8(buf + i + 2) == 111) {  # 'o'
                            if (load8(buf + i + 3) == 115) {  # 's'
                                if (load8(buf + i + 4) == 116) {  # 't'
                                    if (load8(buf + i + 5) == 95) {   # '_'
                                        if (load8(buf + i + 6) == 111) {  # 'o'
                                            if (load8(buf + i + 7) == 110) {  # 'n'
                                                if (load8(buf + i + 8) == 108) {  # 'l'
                                                    if (load8(buf + i + 9) == 121) { return 1; }  # 'y'
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if (load8(buf + i) == 10) { bol = 1; } else { bol = 0; }
        i = i + 1;
    }
    return 0;
}

# Record the first host-only module pulled, and error immediately IF this build already
# knows it is a kernel build. kernel_mode (S+0x18FCA0) is set from CYRIUS_KERNEL by
# main.cyr BEFORE preprocessing, which is the `--target=...-bare-metal-elf` path the
# arc's acceptance names.
# ⚠ HONEST LIMITATION: a build that declares itself with the SOURCE `kernel;` directive
# instead of the triple sets kernel_mode during PARSE, i.e. after this runs, so that
# path is not caught here. Recording the name in `_pp_hostonly_name` is what leaves a
# later parse-time check possible without re-reading any file.
fn _pp_ho_copy_name(fname): i64 {
    var i = 0;
    while (i < 127) {
        var c = load8(fname + i);
        store8(&_pp_hostonly_name + i, c);
        if (c == 0) { i = 127; } else { i = i + 1; }
    }
    store8(&_pp_hostonly_name + 127, 0);
    return 0;
}

# ⛔ WHOSE include is it? cbt prepends one `include` per `[deps].stdlib` module to EVERY
# build regardless of target, so this repo's own `programs/boot_serial.cyr` — a kernel with
# NO includes of its own — got `lib/fs.cyr` from the manifest and the first cut of this
# check FAILED it. check.sh's qemu-boot gate caught that ("FAIL: plain kernel build"); left
# in, it would have broken every kernel build in every repo whose manifest happens to list a
# host-only module, which makes the feature unusable rather than useful.
#
# The arc's acceptance is about "bare-metal CODE pulling host-OS modules" — the kernel
# source's own choice, not a build-system default the author never wrote. `#@srcline` splits
# the two exactly: everything above it is cbt's prepend, everything below is the user's file.
# So a pull is attributed to the USER only once the marker has been seen.
#
# With no marker at all (raw `cat | cycc`, the compiler-internal path) every include IS the
# user's, so `_pp_hostonly_hit` is the one consulted — see the reporting site in PARSE_PROG.
fn PP_NOTE_HOST_ONLY(fname): i64 {
    if (_pp_srcline_seen == 1) {
        if (_pp_hostonly_user == 1) { return 0; }
        _pp_hostonly_user = 1;
        _pp_ho_copy_name(fname);
        return 0;
    }
    if (_pp_hostonly_hit == 1) { return 0; }
    _pp_hostonly_hit = 1;
    if (_pp_hostonly_user == 0) { _pp_ho_copy_name(fname); }
    return 0;
}

fn _pp_curfile_ptr(): i64 {
    if (_pp_curfile_set == 0) { return "<source>"; }
    return &_pp_curfile;
}

# Record `name` (a NUL-terminated cstr) as the file currently being copied.
fn _pp_curfile_note(name): i64 {
    var i = 0;
    while (load8(name + i) != 0) {
        if (i >= 4090) { i = 4090; }
        store8(&_pp_curfile + i, load8(name + i));
        i = i + 1;
    }
    store8(&_pp_curfile + i, 0);
    _pp_curfile_set = 1;
    return 0;
}

# v6.5.3 — newlines in [from, upto) of `buf`.
fn _pp_count_nl(buf, from, upto): i64 {
    var n = 0;
    var i = from;
    while (i < upto) {
        if (load8(buf + i) == 10) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Parse a `#@file "NAME"` line at `dip` and record NAME as the current file.
# Tolerant by design: anything that is not exactly this shape is ignored, so an
# ordinary `#@`-starting comment cannot corrupt the tracker.
fn _pp_note_marker(tmp, dip, bl): i64 {
    var p = dip + 2;
    if (load8(tmp + p) != 102) { return 0; }      # 'f'
    if (load8(tmp + p + 1) != 105) { return 0; }  # 'i'
    if (load8(tmp + p + 2) != 108) { return 0; }  # 'l'
    if (load8(tmp + p + 3) != 101) { return 0; }  # 'e'
    if (load8(tmp + p + 4) != 32) { return 0; }   # ' '
    if (load8(tmp + p + 5) != 34) { return 0; }   # '"'
    p = p + 6;
    var i = 0;
    var qpos = 0;
    while (p < bl) {
        var ch = load8(tmp + p);
        if (ch == 34) { qpos = p; p = bl; }
        else {
            if (i < 4090) { store8(&_pp_curfile + i, ch); i = i + 1; }
            p = p + 1;
        }
    }
    store8(&_pp_curfile + i, 0);
    _pp_curfile_set = 1;
    # v6.5.3 — record the base this marker carries and the offset just past its line, so
    # a RESUME emitted later in THIS pass can be expressed relative to the current file's
    # own first line instead of the expanded-buffer line. `qpos` is the closing quote —
    # the loop breaks by setting `p = bl`, so `p` cannot be used for this.
    var bp = qpos + 1;
    var bv = 0;
    if (bp < bl) { if (load8(tmp + bp) == 32) {
        bp = bp + 1;
        while (bp < bl && load8(tmp + bp) >= 48 && load8(tmp + bp) <= 57) {
            bv = bv * 10 + (load8(tmp + bp) - 48);
            bp = bp + 1;
        }
    } }
    if (bv < 1) { bv = 1; }
    _pp_curfile_base = bv;
    while (bp < bl && load8(tmp + bp) != 10) { bp = bp + 1; }
    _pp_curfile_anchor = bp + 1;
    return 0;
}

# v6.5.3 — count the 1-based line number at input offset `upto` in the buffer at `base`.
# Used to give a RESUME marker the line the enclosing file actually resumes ON. Computed
# on demand rather than threaded through PP_PASS's loop: that loop advances `ip` at 17
# distinct sites and an off-by-one in any one of them would be invisible here, which is
# exactly how the first attempt at this fix (reverted, see the issue) went wrong.
# O(input) per include and includes are few, so the cost is irrelevant next to being right.
fn _pp_lineno_at(S, base, upto): i64 {
    var n = 1;
    var i = 0;
    while (i < upto) {
        if (load8(base + i) == 10) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# v6.5.3 — `base` is the source line the span AFTER this marker starts on.
#   ENTER  (a fresh include)  -> 1, the included file's own first line
#   RESUME (back to the parent) -> the parent's line just past the include directive
# Emitted as `#@file "NAME" BASE`. FM_BUILD parses it; FM_LOOKUP adds it instead of
# assuming 1. Without it the parent's numbering RESTARTS at 1 after every include, so a
# diagnostic in the main source reported `actual_line - includes_before_it`.
fn PP_FMARK(S, out, op, name, base): i64 {
    store8(out + op, 35); op = op + 1;    # '#'
    store8(out + op, 64); op = op + 1;    # '@'
    store8(out + op, 102); op = op + 1;   # 'f'
    store8(out + op, 105); op = op + 1;   # 'i'
    store8(out + op, 108); op = op + 1;   # 'l'
    store8(out + op, 101); op = op + 1;   # 'e'
    store8(out + op, 32); op = op + 1;    # ' '
    store8(out + op, 34); op = op + 1;    # '"'
    var i = 0;
    while (load8(name + i) != 0) {
        store8(out + op, load8(name + i));
        op = op + 1; i = i + 1;
    }
    store8(out + op, 34); op = op + 1;    # '"'
    store8(out + op, 32); op = op + 1;    # ' '
    # base as decimal, most-significant first
    var d = base;
    if (d < 1) { d = 1; }
    var div = 1;
    while (d / div >= 10) { div = div * 10; }
    while (div > 0) {
        store8(out + op, 48 + (d / div) % 10); op = op + 1;
        div = div / 10;
    }
    store8(out + op, 10); op = op + 1;    # '\n'
    return op;
}

# v6.5.19 — RE-ANCHOR the file map at a point where the expansion changed the line
# count, so FM_LOOKUP's `expanded - start + base` arithmetic stays exact.
#
# THE DEFECT (agnosai, 35 duplicate-fn warnings). FM_LOOKUP reconstructs a source line
# by linear arithmetic over a `#@file` span, which is only valid while the preprocessor
# copies a file's lines into the expanded buffer 1:1. Two transforms broke that INSIDE a
# span and neither re-anchored: the `#ifdef` family (directive lines consumed, skipped
# bodies dropped -> reported line too SMALL) and `#derive` (2-3 source lines replaced by
# N generated ones -> reported line too LARGE). Drift accumulates from the last marker,
# so `lib/kavach.cyr:11588` named a line 267 past that file's EOF.
#
# The `#ifdef` half is fixed by PADDING (one newline per consumed/skipped source line)
# at the call sites — no marker, no cost against the 1024-entry cap. `#derive` cannot be
# padded (it ADDS lines), so it re-anchors here. Emitting a marker per `#ifdef` block
# too would need ~1139 entries on agnosai's build against a 1024 cap, and overflow makes
# FM_FILEID return -1, which `private` visibility is load-bearing on. CHANGELOG [6.5.19].
fn PP_REANCHOR(S, out, op, name, srcline): i64 {
    # A marker must own its line. Derive bodies end in `\n`, but an INCLUDED file that
    # does not end in a newline would otherwise glue the marker onto its last line of
    # code — where `#` comments the marker out and the span start lands one line early.
    if (op > 0) { if (load8(out + op - 1) != 10) { store8(out + op, 10); op = op + 1; } }
    return PP_FMARK(S, out, op, name, srcline);
}

# Re-anchor to the MAIN source at input offset `ip` (PP_PASS: its input is the raw
# source, so the line number is exact by counting).
fn PP_REANCHOR_SRC(S, out, op, ip): i64 {
    return PP_REANCHOR(S, out, op, "<source>", _pp_lineno_at(S, S + _SRCB, ip) - _pp_srcline_bias);
}

# Re-anchor to whichever file PP_IFDEF_PASS is currently copying from. Its input is the
# PREVIOUS pass's output, so the offset is expressed against the last marker seen —
# correct precisely because the padding keeps that stream line-faithful.
fn PP_REANCHOR_CUR(S, out, op, tmp, ip): i64 {
    return PP_REANCHOR(S, out, op, _pp_curfile_ptr(), _pp_curfile_base + _pp_count_nl(tmp, _pp_curfile_anchor, ip));
}

# ⛔ v6.5.45 (CVE-39) — THE BOUND IS 768, NOT 4096, AND THE DIFFERENCE WAS A SILENT
# MISCOMPILE. The heap map declared `0x190400 include_fname [4096]` and all three capture loops
# guarded at 4095 from that number, but TWO live things sit inside that declared span:
#   S+0x190700  PP_EXPAND's output-write-cursor return slot (:2334 store / :3166 load) — 768 B in
#   S+0x190800  the `#ifdef` FEATURE-FLAG TABLE (:2368/:2379), 1024 B in
# So an include or `#ref` path of 768 characters or more corrupts the preprocessor's own output
# cursor — expanded macro text then lands at the wrong offset — and past 1024 it overwrites the
# hashes of CYRIUS_ARCH_X86, CYRIUS_TARGET_MACOS and friends, after which `#ifdef` selects the
# WRONG BRANCHES. No diagnostic, no crash: a path LENGTH changes the generated code.
# ⚠ 768 IS THE NUMBER AND IT WAS NOT OBVIOUS. This fix first shipped at 1023, reasoning from the
# flag table alone; the cursor slot 256 bytes below it is what makes the real bound 768. The map
# now declares both, so the next reader does not have to re-derive them from grep.
# ⚠ A long path is not exotic — deep vendored dep trees under a long $HOME reach four figures,
# and the input is attacker-influenced wherever source is compiled on someone's behalf.
# The map line is corrected to [1024] in src/main.cyr; the guards below are the enforcement.
fn PP_FNAME_TOO_LONG(): i64 {
    syscall(SYS_WRITE, 2, "error: include/#ref filename exceeds 767 bytes\n", 47);
    syscall(SYS_EXIT, 1);
    return 0;
}
# Refuse a #define whose body would run past the macro text pool (CVE-40). Mirrors
# PP_FNAME_TOO_LONG: an honest hard error beats a silent wrong compile.
fn PP_MACRO_TEXT_FULL(): i64 {
    syscall(SYS_WRITE, 2, "error: #define bodies exceed the 16 KB macro text pool\n", 55);
    syscall(SYS_EXIT, 1);
    return 0;
}


fn PP_MARK_INCLUDED(S, fname): i64 {
    var cnt = L64(S + 0x197F00);
    if (cnt >= 256) {
        syscall(SYS_WRITE, 2, "error: include-once table full (256 files) — split compilation unit\n", 70);
        syscall(SYS_EXIT, 1);
    }
    var p = S + 0x1C0000 + cnt * 128;
    var c = 0;
    while (load8(fname + c) != 0) {
        store8(p + c, load8(fname + c));
        c = c + 1;
        if (c >= 127) { break; }
    }
    store8(p + c, 0);
    S64(S + 0x197F00, cnt + 1);
    return 0;
}

# "#derive(Serialize)" = 23 64 65 72 69 76 65 28 53 65 72 69 61 6C 69 7A 65 29
fn ISDERIVE(S, pos, bl): i64 {
    if (pos + 18 >= bl) { return 0; }
    if (load8(S + pos) != 35) { return 0; }
    if (load8(S + pos + 1) != 100) { return 0; }
    if (load8(S + pos + 2) != 101) { return 0; }
    if (load8(S + pos + 3) != 114) { return 0; }
    if (load8(S + pos + 4) != 105) { return 0; }
    if (load8(S + pos + 5) != 118) { return 0; }
    if (load8(S + pos + 6) != 101) { return 0; }
    if (load8(S + pos + 7) != 40) { return 0; }
    if (load8(S + pos + 8) != 83) { return 0; }
    if (load8(S + pos + 9) != 101) { return 0; }
    if (load8(S + pos + 10) != 114) { return 0; }
    if (load8(S + pos + 11) != 105) { return 0; }
    if (load8(S + pos + 12) != 97) { return 0; }
    if (load8(S + pos + 13) != 108) { return 0; }
    if (load8(S + pos + 14) != 105) { return 0; }
    if (load8(S + pos + 15) != 122) { return 0; }
    if (load8(S + pos + 16) != 101) { return 0; }
    if (load8(S + pos + 17) != 41) { return 0; }
    return 1;
}

# "#derive(Deserialize)" = 20 bytes
fn ISDERIVE_DE(S, pos, bl): i64 {
    if (pos + 20 >= bl) { return 0; }
    if (load8(S + pos) != 35) { return 0; }
    if (load8(S + pos + 1) != 100) { return 0; }
    if (load8(S + pos + 2) != 101) { return 0; }
    if (load8(S + pos + 3) != 114) { return 0; }
    if (load8(S + pos + 4) != 105) { return 0; }
    if (load8(S + pos + 5) != 118) { return 0; }
    if (load8(S + pos + 6) != 101) { return 0; }
    if (load8(S + pos + 7) != 40) { return 0; }
    if (load8(S + pos + 8) != 68) { return 0; }
    if (load8(S + pos + 9) != 101) { return 0; }
    if (load8(S + pos + 10) != 115) { return 0; }
    if (load8(S + pos + 11) != 101) { return 0; }
    if (load8(S + pos + 12) != 114) { return 0; }
    if (load8(S + pos + 13) != 105) { return 0; }
    if (load8(S + pos + 14) != 97) { return 0; }
    if (load8(S + pos + 15) != 108) { return 0; }
    if (load8(S + pos + 16) != 105) { return 0; }
    if (load8(S + pos + 17) != 122) { return 0; }
    if (load8(S + pos + 18) != 101) { return 0; }
    if (load8(S + pos + 19) != 41) { return 0; }
    return 1;
}

# Derive state: struct sizes for nested struct offset calculation.
#
# v5.9.5 layout reshuffle. Pre-v5.9.5 the per-struct sizes/names
# tables ([32] cap) shared the same 0x197XXX 4 KB region as the
# shared parse-state buffers (op, field_count, cumul, sname,
# field_names, field_types, field_offsets), with overlapping
# extents — struct_names[31] reached 0x197508, op was at 0x197400
# (inside struct_names entries 23+), and the size store for the
# 33rd struct (`store64(S + 0x197008 + 32*8, ...)`) overwrote
# struct_names[0]'s first 8 bytes. agnosys 1.1.0 hit this at 37
# `#derive(accessors)` structs in the integration test compilation
# (pam + netns + update modules pushed past 32). Two reproducible
# modes: clean truncation (33rd struct silently fails to emit) and
# prefix corruption (struct[0]'s name first 8 chars overwritten by
# struct[32]'s size, leading to `update_state_X` getting emitted
# as `tate_X`).
#
# Fix: separate the per-struct tables from the shared parse buffer. Shared parse
# state stays in the low half (0x197008..0x1974E0); 0x197F00 (include count) and
# 0x197F10 (pp_state) stay where they were — callers in main*.cyr / util.cyr.
#
# S+0x197000: derive struct count (8 bytes)
# S+0x197008: output position (op)
# S+0x197010: field_count
# S+0x197018: cumul_off (total struct byte size)
# S+0x197020: sname[64]
# Per-struct field tables — v6.0.47 relocated to the freed 0x1FC000-0x204000
# band + cap raised 32 → 256 fields. The `fc >= 256` bounds check below guards
# the silent clobber that bit agnos 1.28.3 pre-v5.11.24.
# S+0x1FC000: field_names[256][32]  (8192 bytes)
# S+0x1FE000: field_types[256][32]  (8192 bytes)
# S+0x200000: field_offsets[256][8] (2048 bytes; ends 0x200800)
#
# v6.0.53: the derive struct sizes[512] + names[512*32] tables (cap 64 → 512 —
# libro -D LIBRO_TPM pulls 66 #derive structs: 27 libro + 39 agnosys) are ALLOC'd
# from the heap, NOT fixed S-offsets. The fixed scratch band is packed solid (the
# old 0x197500/0x197700 slot fit only 64; every nearby fixed region is live during
# preprocessing — file_map@0x19A108, the struct pool@0x1A0000+, preprocess_out@0x459D000;
# gvar_toks now lives at 0x729000, moved off 0x198000 at v6.3.41). alloc() lands them in
# the post-brk heap, zero collision.
# (CI-SIGILL fix: the first cut relocated sizes/names to a FIXED 0x198000 and clobbered
# gvar_toks (which lived at 0x198000 until v6.3.41) → corrupted deferred-global-init
# codegen → Illegal instruction. The fixed scratch band stays packed, so alloc() remains
# the right home even though 0x198000 itself is now free.)
var _pp_derive_count = 0;
# v6.5.31: emit the shared enum name-compare helper once per compilation.
var _pp_enum_helper_done = 0;
var _pp_derive_sizes = 0;   # alloc(512*8)  lazily on first #derive registration
var _pp_derive_names = 0;   # alloc(512*32) ditto
# v6.5.20 — FLATTEN mode for PP_EMIT_STR: newline -> space. Set only around the
# `#derive` BODY emitters (the generated fns), never around the struct copy.
#
# WHY. `#derive` is the one preprocessor transform that ADDS lines, so unlike the
# `#ifdef` family it could not be padded back to 1:1 and had to re-anchor the file map
# after itself (v6.5.19). A re-anchor makes everything AFTER the construct exact but
# nothing INSIDE it: the expansion still occupies more expanded lines than the source it
# replaced, and FM_LOOKUP's `expanded - start + base` is linear, so it cannot represent
# a span that stretches in the middle. Emitting the whole generated block on ONE
# expanded line — the line of the struct's closing `}` — removes the stretch entirely:
# the block now occupies exactly the source lines it consumed, the arithmetic is exact
# everywhere including inside, and the re-anchor markers are no longer needed at all.
#
# ⚠ `#` IS A COMMENT in cyrius, so any `#` in a flattened literal comments out the rest
# of the block. Every PP_EMIT_STR literal was audited (191 call sites, 178 with a string
# literal); exactly one carried a `#` — a `# nested struct` comment in the generated
# from_json body, deleted rather than escaped. The 13 non-literal arguments are struct
# names, field names and field type names read from source, i.e. identifiers.
var _pp_flatten = 0;
# v6.5.20 — offset (relative to the handler's `src_base`) of the first byte AFTER the
# `#derive`d struct's closing `}`, i.e. the start of that line's tail. PP_PARSE_STRUCT_DEF
# records it; the entry-point handler copies the tail with PP_COPY_TAIL *after* it has
# emitted the generated bodies. See PP_COPY_TAIL for why the tail must come LAST.
var _pp_tail_ip = 0;
var _pp_vecdec_int_done = 0;  # v6.4.x R2 — emitted the shared _cy_vecdec_int JSON-array helper yet?
var _pp_vecdec_f64_done = 0;  # v6.4.x R2 — emitted the shared _cy_vecdec_f64 JSON-array helper yet?
var _pp_skipval_done = 0;     # v6.4.x R3 — emitted the shared _cy_json_skipval value-skip helper yet?

# Helper: write decimal integer to output buffer, return bytes written
fn PP_EMIT_INT(out, op, val): i64 {
    var digits[20];
    var dc = 0;
    if (val == 0) { store8(out + op, 48); return 1; }
    var v = val;
    while (v > 0) {
        store8(&digits + dc, 48 + (v % 10));
        dc = dc + 1;
        v = v / 10;
    }
    # Reverse
    var di = 0;
    while (di < dc) {
        store8(out + op + di, load8(&digits + dc - 1 - di));
        di = di + 1;
    }
    return dc;
}

# Helper: copy C string bytes to output, return length.
# v6.5.20 — honours `_pp_flatten` (newline -> space). See the flag's declaration.
fn PP_EMIT_STR(out, op, cstr): i64 {
    var i = 0;
    while (load8(cstr + i) != 0) {
        var ch = load8(cstr + i);
        if (_pp_flatten == 1) { if (ch == 10) { ch = 32; } }
        store8(out + op + i, ch);
        i = i + 1;
    }
    return i;
}

# v6.5.20 — copy the REMAINDER of the struct's closing-`}` line, stopping at a `#`
# that is outside a string literal, and WITHOUT copying the newline.
#
# ⚠ COPY, never consume. The obvious implementation of design 1 consumes this tail so
# the generated bodies can own the line, and that is SILENT CODE LOSS, not merely a
# dropped comment: `struct Z { a; } fn helper() { return 2; }` is legal cyrius, and
# consuming the tail deletes `helper` with no diagnostic — the program compiles clean
# and returns the wrong answer. Measured: `struct Z { a; b; } var g = 77;` went from
# exit 77 to `undefined variable 'g'`.
#
# ⚠ THE TAIL GOES LAST, AFTER THE GENERATED BODIES. This call is made by the ENTRY-POINT
# handler once its bodies are emitted, never by PP_PARSE_STRUCT_DEF mid-way — the tail's
# offset travels in `_pp_tail_ip`. The first cut copied the tail first and appended the
# bodies behind it, which is correct only while the tail is SELF-CONTAINED. A tail that
# OPENS a construct continuing on later source lines —
#     struct Z { a; } fn helper() {
#         return 42;
#     }
# — then had every generated fn spliced INSIDE `helper`'s body: nested fn definitions,
# `rc=0`, no diagnostic, and a binary that SIGSEGVs. Emitting the bodies first makes the
# user's opener the last thing on the expanded line, so the lines that continue it follow
# it verbatim, exactly as written. This ordering needs no look-ahead and no guess about
# what the tail opens — `fn`, `if`, `while`, another `struct`, or nothing at all.
#
# The `#` stop is what makes copying safe on a flattened line: everything after a `#`
# is a comment, and on one expanded line a copied comment would eat whatever follows it.
# Dropping a trailing comment is semantically inert (the lexer discards it either way).
# The scan is string-aware so a `#` inside a literal — say `} var s = "#!/bin/sh";` — is
# copied through rather than truncating the string.
#
# The newline is deliberately not copied: the caller terminates the line itself, which is
# what keeps the block's expanded line count equal to its source line count. `ip` is
# advanced past the newline by PP_PARSE_STRUCT_DEF with PP_SKIPLINE, so only the new `op`
# needs returning.
fn PP_COPY_TAIL(src_base, ip, bl, out, op): i64 {
    var q = 0;
    var esc = 0;
    while (ip < bl) {
        var ch = load8(src_base + ip);
        if (ch == 10) { return op; }
        # v6.5.20: NO `#` stop here. The first cut copied the tail BEFORE the
        # generated bodies, so a `#` comment in the tail would have commented the
        # bodies out — hence the stop. The multi-line-tail fix inverted that: the
        # tail is now the LAST thing on the expanded line and the newline is written
        # immediately after it, so a `#` can no longer swallow anything. Keeping the
        # stop was a REGRESSION against 6.5.19 — `q` tracks `"` but never `'`, so a
        # `'#'` char literal on the closing-`}` line was cut mid-literal, leaving a
        # dangling quote that the lexer carried across the newline and reported as a
        # bogus `multi-byte char literal not supported`. `#` mid-line is not always a
        # comment; only the newline ends the tail.
        store8(out + op, ch); op = op + 1;
        if (esc == 1) { esc = 0; }
        elif (ch == 92) { if (q == 1) { esc = 1; } }
        elif (ch == 34) { q = 1 - q; }
        ip = ip + 1;
    }
    return op;
}

# Shared struct parser for #derive handlers. Skips derive lines, parses struct
# name + fields, copies struct to output, computes offsets, registers in derive table.
# Results stored at S+0x197008..S+0x200000. Returns new ip.
#
# v5.6.30: `src_base` carries the base for SOURCE reads. PP_PASS passes `S`
# (the raw-input buffer). PP_IFDEF_PASS passes the `tmp` mmap buffer (full
# preprocessed source up to 1 MB). Before this parameter split, both passes
# read from `S + ip` — which for PP_IFDEF_PASS was the copy-back region capped
# at 1048576 bytes. Any #derive directive landing past that offset read stale
# data (zeros), produced corrupted output with a 0xff sentinel leaking through
# from the heap state, and LEX died with `non-ASCII byte (0xff)` at an
# apparently-valid source line. Libro 2.0.5 tripped this at
# `src/file_store.cyr:10` (offset 543565, past the 1048576 cap). STATE-TABLE
# writes (S+0x197020 struct names, S+0x1FC000 field names, S+0x1FE000 types,
# S+0x200000 offsets, S+0x197008 op-out, S+0x197010 field count) stay addressed
# relative to `S` — those regions are well below 0x100000 and always in sync.
fn PP_PARSE_STRUCT_DEF(S, src_base, ip, bl, out, op): i64 {
    # v6.5.20 — LINE ACCOUNTING (design 1). The block is made to occupy exactly the
    # source lines it consumes, in three parts:
    #   1. every consumed `#derive(...)` directive line is PADDED with one newline
    #      (the `#ifdef` mechanism from v6.5.19; those lines emit no text of their own),
    #   2. the struct itself is copied byte-for-byte, so its lines land 1:1, and
    #   3. the closing-`}` line is left UNTERMINATED here — the caller flattens the
    #      generated bodies onto it and writes the single closing newline.
    # Total emitted newlines == total consumed newlines, so FM_LOOKUP's linear span
    # arithmetic is exact INSIDE the construct as well as after it, and the v6.5.19
    # re-anchor markers are gone.
    var ndir = 1;
    ip = PP_SKIPLINE(src_base, ip, bl);
    # v5.10.14 — collect stacked `#derive(...)` flags so the
    # entry-point handler can run additional codegen passes.
    # Pre-fix this loop silently swallowed every `#` line
    # between the entry-point `#derive(...)` and the struct
    # definition, so stacked `#derive(accessors) +
    # #derive(Serialize)` only got the FIRST handler's
    # codegen — the second was dropped with no diagnostic.
    # agnosys 1.1.12 follow-on filing
    # (2026-05-08-cyrius-derive-multi-stacking.md).
    #
    # S+0x197F08 layout (8 bytes, treated as bitfield):
    #   bit 0: Serialize stacked
    #   bit 1: Deserialize stacked
    #   bit 2: accessors stacked
    # Reset to 0 at struct-def entry; set per matching skipped
    # line. Entry-point handler reads it post-PP_PARSE_STRUCT_DEF
    # to decide whether to also emit other directives' bodies.
    S64(S + 0x197F08, 0);
    while (ip < bl) {
        if (load8(src_base + ip) == 35) {
            if (ISDERIVE(src_base, ip, bl) == 1) {
                S64(S + 0x197F08, L64(S + 0x197F08) | 1);
            } else { if (ISDERIVE_DE(src_base, ip, bl) == 1) {
                    S64(S + 0x197F08, L64(S + 0x197F08) | 2);
                } else { if (ISDERIVE_ACC(src_base, ip, bl) == 1) {
                        S64(S + 0x197F08, L64(S + 0x197F08) | 4);
                    } } }
            ip = PP_SKIPLINE(src_base, ip, bl);
            ndir = ndir + 1;
        } else { break; }
    }
    # Pad the consumed directive lines (part 1 above). Must precede any other output.
    var dpad = 0;
    while (dpad < ndir) { store8(out + op, 10); op = op + 1; dpad = dpad + 1; }
    while (ip < bl) { if (load8(src_base + ip) == 32) { ip = ip + 1; } else { break; } }
    # v6.5.30 — REJECT a `#derive(...)` that is not sitting on a `struct`.
    #
    # ⛔ `ip = ip + 7` below blindly skips the width of `"struct "`. On an `enum` it therefore
    # skipped `"enum pr"` and read the NAME as `obe_e` — which is where ranga's long-recorded
    # "misnamed, crashing codec" symptom came from. By 6.5.27 the downstream emit no longer
    # produced anything at all, so `#derive(Serialize)` above an enum compiled with rc=0, no
    # diagnostic, and NO codec: the caller discovered it as `undefined function
    # <name>_to_json` at link time, possibly long after writing the derive, and only if the
    # codec was ever called. ranga hand-writes four enum codecs because of this.
    #
    # The filing (2026-08-19-derive-serialize-on-enum-emits-nothing) ranks the outcomes:
    # support it, else reject loudly, else warn — and says explicitly that rejecting "would be
    # strictly better than the current silence, even if enum support never lands". Enum
    # support is a real feature (a name<->value codec, plus the parse direction ranga also
    # needs) whose JSON shape is a design call the maintainer owns, so it is pinned separately.
    # What ships here is the end of the silence.
    # ⚠ Byte-compared inline rather than with `memeq`: that lives in lib/string.cyr, which
    # cycc does not include, so a call here is an undefined symbol in the compiler itself.
    # Every other keyword probe in this file (ISDERIVE and friends) is written the same way.
    var is_struct = 0;
    if (ip + 7 <= bl) {
        is_struct = 1;
        if (load8(src_base + ip)     != 115) { is_struct = 0; }   # s
        if (load8(src_base + ip + 1) != 116) { is_struct = 0; }   # t
        if (load8(src_base + ip + 2) != 114) { is_struct = 0; }   # r
        if (load8(src_base + ip + 3) != 117) { is_struct = 0; }   # u
        if (load8(src_base + ip + 4) != 99)  { is_struct = 0; }   # c
        if (load8(src_base + ip + 5) != 116) { is_struct = 0; }   # t
        if (load8(src_base + ip + 6) != 32)  { is_struct = 0; }   # ' '
    }
    # v6.5.30/.31 — `enum` is a FIRST-CLASS derive target; anything else is rejected.
    #
    # ⭐ The member-name collection below needs NO enum-specific code. `enum E { A = 0; B = 1; }`
    # walks the same copy loop as a struct: after each `{` or `;` it skips whitespace, reads an
    # identifier and stops at the space before `=`, so `A` and `B` land in the field-name table
    # exactly as struct fields do, with an empty type slot. The ONLY differences are the
    # keyword width (5 vs 7) and a flag telling the emitter which codec shape to generate.
    #
    # ⛔ `ip + 7` below skips the width of `"struct "`. Before v6.5.30 it ran unconditionally,
    # so on an enum it skipped `"enum pr"` and read the name as `obe_e` — which is where the
    # long-recorded "misnamed, crashing codec" symptom came from; the downstream emit later
    # produced nothing at all, turning it into a silent no-op. One mechanism, both symptoms.
    var kwlen = 0;
    if (ip + 7 <= bl) { if (is_struct == 1) { kwlen = 7; } }
    var is_enum = 0;
    if (ip + 5 <= bl) {
        is_enum = 1;
        if (load8(src_base + ip)     != 101) { is_enum = 0; }   # e
        if (load8(src_base + ip + 1) != 110) { is_enum = 0; }   # n
        if (load8(src_base + ip + 2) != 117) { is_enum = 0; }   # u
        if (load8(src_base + ip + 3) != 109) { is_enum = 0; }   # m
        if (load8(src_base + ip + 4) != 32)  { is_enum = 0; }   # ' '
    }
    if (kwlen == 0) { if (is_enum == 1) { kwlen = 5; } }
    S64(S + 0x197F10, is_enum);
    if (kwlen == 0) {
        # Neither struct nor enum. Still rejected loudly, naming nothing we cannot name.
        syscall(SYS_WRITE, 2, "error: #derive(...) applies to a struct or an enum; the following declaration is neither\n", 89);
        syscall(SYS_EXIT, 1);
    }
    ip = ip + kwlen;
    # ⛔ v6.5.47 (CVE-41) — THIS CAPTURE WAS UNBOUNDED. `sname` is 64 bytes at S+0x197020, and
    # the name is then copied into `_pp_derive_names` at a 32-BYTE STRIDE (see the copy below),
    # so 31 is the real ceiling — the smaller of the two, not the 64 the scratch declares.
    # ⚠ THE SIBLING TYPE-NAME LOOP HAS BEEN BOUNDED AT 31 ALL ALONG (the `tni >= 31` check a few
    # dozen lines down). Three name captures sit in this one construct; one was written with a
    # guard and two without, and nothing compared them. That asymmetry inside a single function
    # is the whole finding — the correct pattern was already present and simply not applied.
    var sni = 0;
    while (ip < bl) {
        var c = load8(src_base + ip);
        if (c == 32 || c == 123 || c == 10) { break; }
        if (sni >= 31) {
            syscall(SYS_WRITE, 2, "error: #derive struct name too long (max 31 bytes)\n", 51);
            syscall(SYS_EXIT, 1);
        }
        store8(S + 0x197020 + sni, c); sni = sni + 1; ip = ip + 1;
    }
    store8(S + 0x197020 + sni, 0);
    var struct_start = ip - kwlen - sni;
    while (struct_start > 0) { if (load8(src_base + struct_start - 1) == 10) { break; } struct_start = struct_start - 1; }
    var depth = 0;
    var cp = struct_start;
    var fc = 0;
    var past_brace = 0;
    while (cp < bl) {
        var ch = load8(src_base + cp);
        store8(out + op, ch); op = op + 1;
        if (ch == 123) { depth = depth + 1; past_brace = 1; }
        if (ch == 125) { depth = depth - 1; if (depth == 0) { cp = cp + 1; break; } }
        if (past_brace == 1 && depth == 1) {
            if (ch == 123 || ch == 59) {
                var fp = cp + 1;
                # v6.5.20 — LOOK-AHEAD ONLY. This scan used to copy the whitespace run
                # it walks into `out`, and the enclosing loop then copied the same bytes
                # again when `cp` reached them — so every field-terminating `;` (and the
                # opening `{`) DUPLICATED its trailing newline. That is where the struct's
                # +N line inflation came from: `struct Z { a; b = ; }` over 4 source lines
                # occupied 7 expanded ones, and the error on `b` reported 7 for line 6.
                # Duplicated whitespace is inert to the lexer, so dropping the copy is
                # codegen-neutral; it is the line count that had to be repaired.
                while (fp < bl) { var xc = load8(src_base + fp); if (xc != 32 && xc != 10 && xc != 13 && xc != 9) { break; } fp = fp + 1; }
                if (load8(src_base + fp) != 125) {
                    # v5.11.24: hard-cap diagnostic (was silent clobber pre-fix).
                    # agnos 1.28.3 Process struct (22 fields with
                    # `#derive(accessors)`) silently overflowed field_types →
                    # wrong accessor offsets → CR3=0x2 page-fault on first
                    # kernel context switch. 32 covers the worst-case struct
                    # seen in the wild (agnos Process @ 22); past that, fail
                    # loud.
                    if (fc >= 256) {
                        syscall(SYS_WRITE, 2, "error: #derive struct field cap exceeded (max 256 — raise in lex_pp.cyr / S+0x1FC000 region)\n", 95);
                        syscall(SYS_EXIT, 1);
                    }
                    # ⛔ v6.5.47 (CVE-41) — unbounded, into a 32-byte stride. A field name past
                    # 31 characters ran into the NEXT field's slot (silently renaming it), and at
                    # fc == 255 past the 8 KB region entirely. Same construct, same fix, same
                    # ceiling as the type-name loop below — which already had it.
                    var fni = 0;
                    while (fp < bl) { var xc = load8(src_base + fp); if (xc == 59 || xc == 58 || xc == 125 || xc == 32 || xc == 10) { break; } if (fni >= 31) { syscall(SYS_WRITE, 2, "error: #derive field name too long (max 31 bytes)\n", 50); syscall(SYS_EXIT, 1); } store8(S + 0x1FC000 + fc * 32 + fni, xc); fni = fni + 1; fp = fp + 1; }
                    store8(S + 0x1FC000 + fc * 32 + fni, 0);
                    store8(S + 0x1FE000 + fc * 32, 0);
                    if (load8(src_base + fp) == 58) {
                        fp = fp + 1;
                        while (fp < bl && load8(src_base + fp) == 32) { fp = fp + 1; }
                        var tni = 0;
                        # v6.4.x R3 (R-2): bound the 32-byte type-name slot. A >31-byte type
                        # name (e.g. Vec<VeryLongStructName> — the "Vec<>" counts) would else
                        # overrun into the next field's slot, splicing a garbage merged name.
                        while (fp < bl) { var tc = load8(src_base + fp); if (tc == 59 || tc == 125 || tc == 32 || tc == 10) { break; } if (tni >= 31) { syscall(SYS_WRITE, 2, "error: #derive field type name too long (max 31 bytes)\n", 55); syscall(SYS_EXIT, 1); } store8(S + 0x1FE000 + fc * 32 + tni, tc); tni = tni + 1; fp = fp + 1; }
                        store8(S + 0x1FE000 + fc * 32 + tni, 0);
                    }
                    fc = fc + 1;
                }
            }
        }
        cp = cp + 1;
    }
    ip = cp;
    # v6.5.20 — the closing-`}` line's tail (part 3 above). Its offset is HANDED OFF; the
    # entry-point handler flattens the generated bodies onto this same line, copies the
    # tail behind them, then writes the single newline. See PP_COPY_TAIL for why the tail
    # must be copied rather than consumed AND why it has to come after the bodies.
    _pp_tail_ip = ip;
    ip = PP_SKIPLINE(src_base, ip, bl);
    # v5.9.36: derive-side offset table must use the same per-field
    # widths as the parser-side `FIELDSZ` so PP_DERIVE_SERIALIZE's
    # `load32`/`store32` etc target the actual struct-literal byte
    # positions. Pre-fix this used a flat `fsz=8` for every typed
    # field (overridden only when the type-name matched another
    # `#derive`-registered struct), so narrow-typed fields at
    # offsets 4/8 in memory were read by PP_DERIVE codegen at
    # offsets 8/16 — net `point_i32 { 100, 200, 300 }` serialized
    # as `{"x":100,"y":300,"z":<garbage>}`.
    var cumul = 0;
    var fi = 0;
    while (fi < fc) {
        store64(S + 0x200000 + fi * 8, cumul);
        if (load8(S + 0x1FE000 + fi * 32) != 0) {
            # Default 8 bytes for typed fields; refine for known
            # primitive widths and nested derive structs below.
            var fsz = 8;
            # Primitive integer detection (mirrors the
            # PP_DERIVE_SERIALIZE prim_load block — i8/i16/i32/i64
            # all distinct on (+1) byte: '8'/'1'/'3'/'6').
            if (load8(S + 0x1FE000 + fi * 32) == 105) {
                var pb1 = load8(S + 0x1FE000 + fi * 32 + 1);
                if (pb1 == 56) { if (load8(S + 0x1FE000 + fi * 32 + 2) == 0) { fsz = 1; } }
                if (pb1 == 49) { if (load8(S + 0x1FE000 + fi * 32 + 2) == 54) { if (load8(S + 0x1FE000 + fi * 32 + 3) == 0) { fsz = 2; } } }
                if (pb1 == 51) { if (load8(S + 0x1FE000 + fi * 32 + 2) == 50) { if (load8(S + 0x1FE000 + fi * 32 + 3) == 0) { fsz = 4; } } }
                if (pb1 == 54) { if (load8(S + 0x1FE000 + fi * 32 + 2) == 52) { if (load8(S + 0x1FE000 + fi * 32 + 3) == 0) { fsz = 8; } } }
            }
            # Nested-struct override (matched against derive-name
            # table at _pp_derive_names; its size lives at _pp_derive_sizes).
            var di = 0;
            while (di < _pp_derive_count) {
                var eq = 1; var ci = 0;
                while (eq == 1) { var a = load8(S + 0x1FE000 + fi * 32 + ci); var b = load8(_pp_derive_names + di * 32 + ci); if (a != b) { eq = 0; } if (a == 0) { break; } ci = ci + 1; }
                if (eq == 1) { fsz = load64(_pp_derive_sizes + di * 8); }
                di = di + 1;
            }
            cumul = cumul + fsz;
        } else { cumul = cumul + 8; }
        fi = fi + 1;
    }
    if (_pp_derive_count >= 512) {
        syscall(SYS_WRITE, 2, "error: too many #derive structs in one file (max 512)\n", 54);
        syscall(SYS_EXIT, 1);
    }
    # v6.0.53: lazily alloc the sizes/names tables from the heap (post-brk, no
    # fixed-offset collision). Once per run; reused across files. Safe before the
    # earlier field-loop reads — those only fire when _pp_derive_count > 0, i.e.
    # after a prior registration already ran this alloc.
    if (_pp_derive_sizes == 0) {
        _pp_derive_sizes = alloc(512 * 8);
        _pp_derive_names = alloc(512 * 32);
    }
    var dsi = _pp_derive_count;
    var ri = 0;
    while (load8(S + 0x197020 + ri) != 0) { store8(_pp_derive_names + dsi * 32 + ri, load8(S + 0x197020 + ri)); ri = ri + 1; }
    store8(_pp_derive_names + dsi * 32 + ri, 0);
    store64(_pp_derive_sizes + dsi * 8, cumul);
    _pp_derive_count = _pp_derive_count + 1;
    store64(S + 0x197008, op);
    store64(S + 0x197010, fc);
    store64(S + 0x197018, cumul);
    return ip;
}

# v6.4.x Pin 2 R2 — classify the element type of a `#derive` field whose type
# string (a 32-byte cstring at `t`) is `Vec<T>`. Returns:
#   0                  — not a Vec<...> field
#   8 / 16 / 32 / 64   — Vec<i8/i16/i32/i64> (int element; the JSON-text width, but
#                        Vec slots are always i64 so encode/decode use the full slot)
#   200                — Vec<f64>
#   201                — Vec<other> (struct / Str element) — unsupported until R3
# The type string reaches here verbatim because the #derive text pre-parser stops
# only on `; } space \n` — never on `<`/`>` — so `xs: Vec<i64>` lands as "Vec<i64>".
fn _pp_vec_elem(S, t): i64 {
    if (load8(t) != 86) { return 0; }       # 'V'
    if (load8(t + 1) != 101) { return 0; }  # 'e'
    if (load8(t + 2) != 99) { return 0; }   # 'c'
    if (load8(t + 3) != 60) { return 0; }   # '<'
    var e0 = load8(t + 4);
    if (e0 == 105) {                         # 'i'
        var e1 = load8(t + 5);
        if (e1 == 56) { if (load8(t + 6) == 62) { return 8; } }                               # i8>
        if (e1 == 49) { if (load8(t + 6) == 54) { if (load8(t + 7) == 62) { return 16; } } }  # i16>
        if (e1 == 51) { if (load8(t + 6) == 50) { if (load8(t + 7) == 62) { return 32; } } }  # i32>
        if (e1 == 54) { if (load8(t + 6) == 52) { if (load8(t + 7) == 62) { return 64; } } }  # i64>
        return 300;   # R3 (BUG-2): an iNN that isn't i8/16/32/64 is a struct name (e.g. Vec<info>)
    }
    if (e0 == 102) {                         # 'f'
        if (load8(t + 5) == 54) { if (load8(t + 6) == 52) { if (load8(t + 7) == 62) { return 200; } } }  # f64>
        return 300;   # R3 (BUG-2): an fNN that isn't f64 is a struct name (e.g. Vec<f64x>)
    }
    # v6.4.x R3 — the inner element is not int/f64. "Str>" stays unsupported (201); any
    # other name is taken as a #derive-struct element (300 → Vec<struct>), whose
    # <Name>_to_json / <Name>_from_json_str codecs its own #derive emits (an undefined
    # element codec surfaces as a clear "undefined function <Name>_to_json").
    if (e0 == 83) {                          # 'S' — maybe "Str"
        if (load8(t + 5) == 116) { if (load8(t + 6) == 114) { if (load8(t + 7) == 62) { return 201; } } }  # Str>
    }
    return 300;
}

# R2 — true when _pp_vec_elem returned a Vec kind supported by the codecs (int/f64/struct).
fn _pp_vec_ok(k): i64 {
    if (k == 8) { return 1; }
    if (k == 16) { return 1; }
    if (k == 32) { return 1; }
    if (k == 64) { return 1; }
    if (k == 200) { return 1; }
    if (k == 300) { return 1; }
    return 0;
}

# v6.4.x R3 — emit the inner element type NAME of a "Vec<T>" type string (bytes t+4
# until '>'), e.g. "Vec<SvPhonemeEvent>" → "SvPhonemeEvent". Returns bytes written so
# callers can do `op = op + PP_EMIT_VEC_ELEM(out, op, t)` then append "_to_json" etc.
fn PP_EMIT_VEC_ELEM(out, op, t): i64 {
    var i = 4;
    var n = 0;
    while (1 == 1) {
        var c = load8(t + i);
        if (c == 62) { break; }
        if (c == 0) { break; }
        store8(out + op + n, c);
        n = n + 1;
        i = i + 1;
    }
    return n;
}

# Emit #derive(Serialize) — generates Name_to_json function after struct def
# ip points to '#' of #derive. out+op is the output position.
# Returns new ip (past the struct). Updates op via S+0x197008.
# v5.10.14 — Serialize body emit, factored out for cross-call
# from stacked-derive entry points (e.g. accessors-first source
# order with Serialize stacked above the struct). Reads
# metadata at S+0x197010 (field count) / S+0x197018 (cumul_off)
# / S+0x197020 (struct name) / S+0x1FC000 (field names) /
# S+0x1FE000 (field types) / S+0x200000 (offsets). Caller is
# responsible for having called PP_PARSE_STRUCT_DEF first to
# populate that metadata.
# v6.5.31 — emit `E_to_json(v, sb)` + `E_from_json_str(json)` for a `#derive`d enum.
#
# Shape (name string, Result on parse — see the note in PP_DERIVE_SERIALIZE_BODY):
#   fn E_to_json(v, sb) {
#       if (v == A) { str_builder_add_cstr(sb, "\"A\""); return 0; }
#       ...
#       str_builder_add_cstr(sb, "null");     # unrecognised value, still valid JSON
#       return 0;
#   }
#   fn E_from_json_str(json) {
#       if (_cy_enum_name_eq(json, "A") == 1) { return Ok(A); }
#       ...
#       return Err(0 - 1);
#   }
#
# ⚠ `null` for an out-of-range value, not a crash and not a bogus name: `to_json` writing
# invalid JSON would corrupt the whole document around it, and an enum value can legitimately
# be out of range (a cast, a wire value from an older peer). ranga's hand-written Display side
# does the same thing with "unknown".
fn PP_DERIVE_ENUM_BODY(S, out, op): i64 {
    var mcount = load64(S + 0x197010);
    # The name-compare helper is emitted ONCE per compilation, like the Vec decode helpers.
    # It skips a leading quote so the same fn works whether the caller hands it a raw JSON
    # value (`"A"`) or a bare name (`A`), which is what makes `from_json_str` usable both
    # inside a decoded document and directly on a config string.
    if (_pp_enum_helper_done == 0) {
        op = op + PP_EMIT_STR(out, op, "fn _cy_enum_name_eq(json, name) {\nvar p = json;\nif (load8(p) == 34) { p = p + 1; }\nvar i = 0;\nwhile (load8(name + i) != 0) {\nif (load8(p + i) != load8(name + i)) { return 0; }\ni = i + 1;\n}\nvar c = load8(p + i);\nif (c == 34) { return 1; }\nif (c == 0) { return 1; }\nreturn 0;\n}\n");
        _pp_enum_helper_done = 1;
    }
    # === E_to_json(v, sb) ===
    op = op + PP_EMIT_STR(out, op, "fn ");
    op = op + PP_EMIT_STR(out, op, S + 0x197020);
    op = op + PP_EMIT_STR(out, op, "_to_json(v, sb) {\n");
    var mi = 0;
    while (mi < mcount) {
        op = op + PP_EMIT_STR(out, op, "if (v == ");
        op = op + PP_EMIT_STR(out, op, S + 0x1FC000 + mi * 32);
        op = op + PP_EMIT_STR(out, op, ") { str_builder_add_cstr(sb, \"\\\"");
        op = op + PP_EMIT_STR(out, op, S + 0x1FC000 + mi * 32);
        op = op + PP_EMIT_STR(out, op, "\\\"\"); return 0; }\n");
        mi = mi + 1;
    }
    op = op + PP_EMIT_STR(out, op, "str_builder_add_cstr(sb, \"null\");\nreturn 0;\n}\n");
    # === E_from_json_str(json) -> Result ===
    op = op + PP_EMIT_STR(out, op, "fn ");
    op = op + PP_EMIT_STR(out, op, S + 0x197020);
    op = op + PP_EMIT_STR(out, op, "_from_json_str(json) {\n");
    mi = 0;
    while (mi < mcount) {
        op = op + PP_EMIT_STR(out, op, "if (_cy_enum_name_eq(json, \"");
        op = op + PP_EMIT_STR(out, op, S + 0x1FC000 + mi * 32);
        op = op + PP_EMIT_STR(out, op, "\") == 1) { return Ok(");
        op = op + PP_EMIT_STR(out, op, S + 0x1FC000 + mi * 32);
        op = op + PP_EMIT_STR(out, op, "); }\n");
        mi = mi + 1;
    }
    op = op + PP_EMIT_STR(out, op, "return Err(0 - 1);\n}\n");
    return op;
}

fn PP_DERIVE_SERIALIZE_BODY(S, out, op): i64 {
    var field_count = load64(S + 0x197010);
    var cumul_off = load64(S + 0x197018);
    # v6.5.31 — ENUM codecs. A C-like enum is an integer with names, so the codec is the
    # name<->value table the compiler already holds; the generated code compares against the
    # ENUM CONSTANTS THEMSELVES rather than baking in numbers, so renumbering a variant cannot
    # desynchronise the codec from the enum.
    #
    # ⚖️ WIRE SHAPE: a bare NAME STRING (`"Multiply"`), settled by the maintainer 2026-08-19.
    # It matches what ranga's hand-written codecs already emit (`pixel_format_name` returns
    # "RGBA8"), it keeps derived structs flat — `{"fmt":"RGBA8"}` rather than
    # `{"fmt":{"PixelFormat":"RGBA8"}}`, where the tag merely restates the field name — and it
    # is serde's representation for unit-variant enums, which is the Rust line the ranga port
    # is measured against. The number form was rejected as ambiguous: a JSON consumer cannot
    # tell it from any other integer field.
    #
    # ⚖️ PARSE FAILURE: `Result`, also the maintainer's call — `E_from_json_str` returns
    # `Ok(value)` or `Err(0 - 1)`, composable with `?`. This DIFFERS from the struct
    # deserializer, which returns a raw pointer: an enum parse can genuinely fail on an
