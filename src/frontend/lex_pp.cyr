        op = op + PP_EMIT_STR(out, op, "fn _cy_vecdec_int(bp) {\nvar v = vec_new();\nvar p = 0;\n");
        op = op + PP_EMIT_STR(out, op, "while (load8(bp + p) != 0 && load8(bp + p) != 91) { p = p + 1; }\n");
        op = op + PP_EMIT_STR(out, op, "if (load8(bp + p) == 91) { p = p + 1;\nwhile (1 == 1) {\n");
