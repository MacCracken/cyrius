            # Untyped scalar: parse decimal
            op = op + PP_EMIT_STR(out, op, "_neg = 0; if (load8(json + _p) == 45) { _neg = 1; _p = _p + 1; }\n");
            op = op + PP_EMIT_STR(out, op, "_iv = 0;\nwhile (load8(json + _p) >= 48 && load8(json + _p) <= 57) { _iv = _iv * 10 + load8(json + _p) - 48; _p = _p + 1; }\n");
            op = op + PP_EMIT_STR(out, op, "if (_neg == 1) { _iv = 0 - _iv; }\n");
            op = op + PP_EMIT_STR(out, op, "store64(ptr + ");
            op = op + PP_EMIT_INT(out, op, load64(S + 0x200000 + fi * 8));
            op = op + PP_EMIT_STR(out, op, ", _iv);\n");
        }
        op = op + PP_EMIT_STR(out, op, "}\n");
        fi = fi + 1;
    }
    # Skip unknown fields
    op = op + PP_EMIT_STR(out, op, "else { while (load8(json + _p) != 44 && load8(json + _p) != 125 && load8(json + _p) != 0) { _p = _p + 1; } }\n");
    op = op + PP_EMIT_STR(out, op, "} else { _p = _p + 1; }\n}\nreturn ptr;\n}\n");
    return op;
}

# v5.10.14 — Serialize entry point. Parses struct, emits body,
# then runs additional codegen for any stacked `#derive(...)`
# directives detected by PP_PARSE_STRUCT_DEF's `#`-skip loop.
fn PP_DERIVE_SERIALIZE(S, src_base, ip, bl, out, op): i64 {
    ip = PP_PARSE_STRUCT_DEF(S, src_base, ip, bl, out, op);
    op = load64(S + 0x197008);
    # v6.5.20 — the generated block goes onto the ONE expanded line PP_PARSE_STRUCT_DEF
    # left open (the struct's closing-`}` line), then the user's tail, then that line is
    # terminated. Every synthesized fn therefore reports the line of the construct that
    # produced it, and the block consumes exactly the source lines it replaced.
    _pp_flatten = 1;
    op = PP_DERIVE_SERIALIZE_BODY(S, out, op);
    var _stacked = L64(S + 0x197F08);
    if ((_stacked & 4) != 0) {
        op = PP_DERIVE_ACCESSORS_BODY(S, out, op);
    }
    _pp_flatten = 0;
    op = PP_COPY_TAIL(src_base, _pp_tail_ip, bl, out, op);
    store8(out + op, 10); op = op + 1;
    store64(S + 0x197008, op);
    return ip;
}

# `#derive(Deserialize)` entry point. The `_from_json` decoder is emitted by
# `#derive(Serialize)` (PP_DERIVE_SERIALIZE_BODY emits both codecs), so this handler adds
# no bodies of its own — but it MUST still route through PP_PARSE_STRUCT_DEF, which is
# what copies the struct into the expanded stream.
#
# ⚠ v6.5.20 — until now it did not, and the struct was DELETED. The handler hand-rolled
# "skip the directive line, then scan forward to the first `}`" and emitted only newline
# padding, so:
#   (a) the type was unusable — `#derive(Deserialize) struct D { x; y; }` followed by
#       `D { 5, 7 }` failed with `undefined variable 'D'`, i.e. the ONE directive whose
#       name says "this struct is data" was the one that threw the struct away; and
#   (b) worse, a MALFORMED field inside it was silently accepted. `struct D { x; y = ; }`
#       compiled rc=0 with zero diagnostics, because the parser is what diagnoses field
#       syntax and the parser never saw the text. Silent acceptance of malformed source.
# Bite 2 of this release gave the handler PP_COPY_TAIL + newline padding and its comment
# claimed it had been "dropping its tail *and the struct* since forever" — but only the
# tail half was actually repaired. This is the struct half.
#
# Routing through the shared parser also fixes stacking in this direction: `#derive(
# Deserialize)` above `#derive(Serialize)` / `#derive(accessors)` used to drop the stacked
# handler entirely (the flag bits were never even collected), while the reverse order
# worked. Both orders now emit the same bodies.
fn PP_DERIVE_DESER(S, src_base, ip, bl, out, op): i64 {
    ip = PP_PARSE_STRUCT_DEF(S, src_base, ip, bl, out, op);
    op = load64(S + 0x197008);
    # v6.5.20 — see PP_DERIVE_SERIALIZE: bodies flattened onto the open closing-`}` line,
    # then the user's tail, then the single newline.
    _pp_flatten = 1;
    var _stacked = L64(S + 0x197F08);
    # v6.5.31 — emit the codec body UNCONDITIONALLY, not only when `Serialize` is also
    # stacked.
    #
    # ⛔ A bare `#derive(Deserialize)` emitted NOTHING — the same silent no-op the enum case
    # was filed for, in the same subsystem, and pre-existing on the STRUCT path too:
    # `#derive(Deserialize) struct P { a; b; }` compiled clean and left `P_from_json_str`
    # undefined until link time. It only ever worked when `#derive(Serialize)` happened to be
    # stacked with it, because this body is what emits BOTH codecs.
    #
    # Found while wiring the enum arm: the enum path inherited the identical wart, and fixing
    # it for enums alone would have left the struct half of one directive still silent.
    # `PP_DERIVE_SERIALIZE_BODY` is called exactly ONCE here regardless of stacking, so the
    # both-stacked case is unchanged and no fn is emitted twice.
    op = PP_DERIVE_SERIALIZE_BODY(S, out, op);
    if ((_stacked & 4) != 0) {
        op = PP_DERIVE_ACCESSORS_BODY(S, out, op);
    }
    _pp_flatten = 0;
    op = PP_COPY_TAIL(src_base, _pp_tail_ip, bl, out, op);
    store8(out + op, 10); op = op + 1;
    store64(S + 0x197008, op);
    return ip;
}

# "#derive(accessors)" = 18 bytes: 35 100 101 114 105 118 101 40 97 99 99 101 115 115 111 114 115 41
fn ISDERIVE_ACC(S, pos, bl): i64 {
    if (pos + 18 >= bl) { return 0; }
    if (load8(S + pos) != 35) { return 0; }
    if (load8(S + pos + 1) != 100) { return 0; }
    if (load8(S + pos + 2) != 101) { return 0; }
    if (load8(S + pos + 3) != 114) { return 0; }
    if (load8(S + pos + 4) != 105) { return 0; }
    if (load8(S + pos + 5) != 118) { return 0; }
    if (load8(S + pos + 6) != 101) { return 0; }
    if (load8(S + pos + 7) != 40) { return 0; }
    if (load8(S + pos + 8) != 97) { return 0; }
    if (load8(S + pos + 9) != 99) { return 0; }
    if (load8(S + pos + 10) != 99) { return 0; }
    if (load8(S + pos + 11) != 101) { return 0; }
    if (load8(S + pos + 12) != 115) { return 0; }
    if (load8(S + pos + 13) != 115) { return 0; }
    if (load8(S + pos + 14) != 111) { return 0; }
    if (load8(S + pos + 15) != 114) { return 0; }
    if (load8(S + pos + 16) != 115) { return 0; }
    if (load8(S + pos + 17) != 41) { return 0; }
    return 1;
}

# Emit #derive(accessors) — generates Name_field(p) getters and Name_set_field(p, v) setters
# Same struct parsing as PP_DERIVE_SERIALIZE. Generates:
#   fn Name_field(p) { return load64(p + OFFSET); }
#   fn Name_set_field(p, v) { store64(p + OFFSET, v); return 0; }
# v5.10.14 — accessors body emit, factored out for cross-call
# from stacked-derive entry points. Reads metadata at S+0x197020
# (struct name) / S+0x1FC000 (field names) / S+0x200000 (offsets)
# / S+0x197010 (field count). Caller is responsible for having
# called PP_PARSE_STRUCT_DEF first to populate that metadata.
fn PP_DERIVE_ACCESSORS_BODY(S, out, op): i64 {
    var field_count = load64(S + 0x197010);
    var fi = 0;
    while (fi < field_count) {
        var off = load64(S + 0x200000 + fi * 8);
        op = op + PP_EMIT_STR(out, op, "fn ");
        op = op + PP_EMIT_STR(out, op, S + 0x197020);
        store8(out + op, 95); op = op + 1;
        op = op + PP_EMIT_STR(out, op, S + 0x1FC000 + fi * 32);
        op = op + PP_EMIT_STR(out, op, "(p) { return load64(p + ");
        op = op + PP_EMIT_INT(out, op, off);
        op = op + PP_EMIT_STR(out, op, "); }\n");
        # v6.5.71: record the GETTER for auto-inlining. The name is emitted in pieces and
        # never exists as one string, so it is hashed the same way — see `_pp_inl_hash3`.
        _pp_inl_add(_pp_inl_hash3(S + 0x197020, 0, S + 0x1FC000 + fi * 32));
        op = op + PP_EMIT_STR(out, op, "fn ");
        op = op + PP_EMIT_STR(out, op, S + 0x197020);
        op = op + PP_EMIT_STR(out, op, "_set_");
        op = op + PP_EMIT_STR(out, op, S + 0x1FC000 + fi * 32);
        op = op + PP_EMIT_STR(out, op, "(p, v) { store64(p + ");
        op = op + PP_EMIT_INT(out, op, off);
        op = op + PP_EMIT_STR(out, op, ", v); return 0; }\n");
        _pp_inl_add(_pp_inl_hash3(S + 0x197020, "set_", S + 0x1FC000 + fi * 32));
        fi = fi + 1;
    }
    return op;
}

fn PP_DERIVE_ACCESSORS(S, src_base, ip, bl, out, op): i64 {
    ip = PP_PARSE_STRUCT_DEF(S, src_base, ip, bl, out, op);
    op = load64(S + 0x197008);
    # v6.5.20 — see PP_DERIVE_SERIALIZE: flattened onto the open closing-`}` line.
    _pp_flatten = 1;
    op = PP_DERIVE_ACCESSORS_BODY(S, out, op);
    # v5.10.14 — multi-stack support. If the source had stacked
    # `#derive(Serialize)` above this directive, PP_PARSE_STRUCT_DEF's
    # `#`-skip loop set bit 0 in S+0x197F08. Run Serialize codegen
    # too so consumers get both fn families. Same metadata; no
    # struct re-parse.
    var _stacked = L64(S + 0x197F08);
    if ((_stacked & 1) != 0) {
        op = PP_DERIVE_SERIALIZE_BODY(S, out, op);
    }
    _pp_flatten = 0;
    op = PP_COPY_TAIL(src_base, _pp_tail_ip, bl, out, op);
    store8(out + op, 10); op = op + 1;
    store64(S + 0x197008, op);
    return ip;
}

# Feature flag table: up to 16 flags, stored as name hashes at S+0x190800
var _pp_flag_count = 0;

# Macro table: up to 16 macros with args
# S+0x192000: 16 name hashes (128 bytes)
# S+0x192080: 16 definition text offsets (128 bytes) — points into S+0x193000
# S+0x192100: 16 definition text lengths (128 bytes)
# S+0x193000: definition text storage (16KB)
var _pp_macro_count = 0;
var _pp_macro_text_pos = 0;

# Hash stopping at ( for macro names
fn PP_HASH_ID(S, pos): i64 {
    var h = 0;
    var pi = 0;
    var pc = load8(S + pos + pi);
    while (pc != 0) {
        if (pc == 10) { return h; }
        if (pc == 13) { return h; }
        if (pc == 32) { return h; }
        if (pc == 40) { return h; }
        h = h * 31 + pc;
        pi = pi + 1;
        pc = load8(S + pos + pi);
    }
    return h;
}

# Find macro by name hash at input position, return index or -1
fn PP_FIND_MACRO(S, ip): i64 {
    var h = PP_HASH_ID(S + _SRCB, ip);
    var mi = 0;
    while (mi < _pp_macro_count) {
        if (load64(S + 0x192000 + mi * 8) == h) { return mi; }
        mi = mi + 1;
    }
    return 0 - 1;
}

# Expand macro invocation: NAME(arg1, arg2)
# Reads args from input at ip, substitutes into body, writes to out+op
# Returns new ip position (after the closing paren)
fn PP_EXPAND(S, mi, ip, bl, out, op): i64 {
    # v6.5.19 — line-faithful expansion. This fn used to end with an
    # unconditional `store8(out + op, 10)`, i.e. +1 output line per
    # invocation. That was only ever *masked*: the `#define` directive line
    # was consumed WITHOUT padding, contributing −1, so a single-invocation
    # file happened to balance. v6.5.19 pads every consumed directive line
    # (PP_PASS / PP_IFDEF_PASS), which is correct and fixes object-like
    # `#define`, and thereby unmasked this: each function-like invocation
    # became +1. Anchor the input/output positions here so the tail can emit
    # exactly as many newlines as the invocation CONSUMED — 0 for the usual
    # single-line call, N for a call whose arg list spans N+1 source lines.
    var _ip_start = ip;
    var _op_start = op;
    var def = S + 0x193000 + load64(S + 0x192080 + mi * 8);
    # Skip name in definition to find (
    var dp = 0;
    while (load8(def + dp) != 40) { dp = dp + 1; }
    dp = dp + 1;  # skip (
    # Read param names from definition
    var pnames[512];   # up to 8 params, 64 bytes each
    var pcnt = 0;
    var pp = 0;
    while (load8(def + dp) != 41) {
        if (load8(def + dp) == 44) { store8(&pnames + pp, 0); pp = pp + 1; pcnt = pcnt + 1; dp = dp + 1; }
        elif (load8(def + dp) == 32) { dp = dp + 1; }
        else { store8(&pnames + pp, load8(def + dp)); pp = pp + 1; dp = dp + 1; }
    }
    if (pp > 0) { store8(&pnames + pp, 0); pp = pp + 1; pcnt = pcnt + 1; }
    dp = dp + 1;  # skip )
    if (load8(def + dp) == 32) { dp = dp + 1; }  # skip space after )
    # Read body text from definition (rest after params)
    var body = def + dp;
    # Skip name in input to find (
    while (ip < bl) {
        if (load8(S + _SRCB + ip) == 40) { break; }
        ip = ip + 1;
    }
    ip = ip + 1;  # skip (
    # Read args from input (comma-separated, handle nested parens)
    var args[512];    # up to 8 args, 64 bytes each
    var acnt = 0;
    var ap = 0;
    var depth = 0;
    while (ip < bl) {
        var c = load8(S + _SRCB + ip);
        if (c == 40) { depth = depth + 1; store8(&args + ap, c); ap = ap + 1; }
        elif (c == 41) {
            if (depth == 0) { store8(&args + ap, 0); ap = ap + 1; acnt = acnt + 1; ip = ip + 1; break; }
            depth = depth - 1; store8(&args + ap, c); ap = ap + 1;
        }
        elif (c == 44) {
            if (depth == 0) { store8(&args + ap, 0); ap = ap + 1; acnt = acnt + 1; }
            else { store8(&args + ap, c); ap = ap + 1; }
        }
        else { store8(&args + ap, c); ap = ap + 1; }
        ip = ip + 1;
    }
    # Substitute: walk body, replace param names with args
    var bi = 0;
    while (load8(body + bi) != 0) {
        var bc = load8(body + bi);
        var matched = 0 - 1;
        # Check if current position matches a param name (alpha/underscore start)
        if (bc >= 97) { if (bc <= 122) { matched = 0 - 2; } }
        if (bc >= 65) { if (bc <= 90) { matched = 0 - 2; } }
        if (bc == 95) { matched = 0 - 2; }
        if (matched == 0 - 2) {
            # Try each param
            var pi2 = 0;
            var poff = 0;
            while (pi2 < pcnt) {
                # Compare param at pnames+poff with body at bi
                var pk = 0;
                var pmatch = 1;
                while (load8(&pnames + poff + pk) != 0) {
                    if (load8(body + bi + pk) != load8(&pnames + poff + pk)) { pmatch = 0; break; }
                    pk = pk + 1;
                }
                # Ensure not a longer identifier
                if (pmatch == 1) {
                    var nc = load8(body + bi + pk);
                    if (nc >= 97) { if (nc <= 122) { pmatch = 0; } }
                    if (nc >= 65) { if (nc <= 90) { pmatch = 0; } }
                    if (nc >= 48) { if (nc <= 57) { pmatch = 0; } }
                    if (nc == 95) { pmatch = 0; }
                }
                if (pmatch == 1) { matched = pi2; break; }
                while (load8(&pnames + poff) != 0) { poff = poff + 1; }
                poff = poff + 1;
                pi2 = pi2 + 1;
            }
        }
        if (matched >= 0) {
            # Find arg text: walk args buffer to the matched index
            var aoff = 0;
            var ai2 = 0;
            while (ai2 < matched) { while (load8(&args + aoff) != 0) { aoff = aoff + 1; } aoff = aoff + 1; ai2 = ai2 + 1; }
            # Copy arg text to output. v6.5.19 — a newline INSIDE an arg (a call
            # whose arg list wraps) is flattened to a space here so the substituted
            # text can never inject a line of its own, and can never inject it a
            # different number of times than the source had it (a param used twice
            # would otherwise double the wrap's newline). The invocation's real line
            # count is restored once, at the tail, from the consumed input.
            while (load8(&args + aoff) != 0) {
                var _ac = load8(&args + aoff);
                if (_ac == 10) { _ac = 32; }
                elif (_ac == 13) { _ac = 32; }
                store8(out + op, _ac); op = op + 1; aoff = aoff + 1;
            }
            # Skip param name in body
            var poff2 = 0;
            var pi3 = 0;
            while (pi3 < matched) { while (load8(&pnames + poff2) != 0) { poff2 = poff2 + 1; } poff2 = poff2 + 1; pi3 = pi3 + 1; }
            var plen = 0;
            while (load8(&pnames + poff2 + plen) != 0) { plen = plen + 1; }
            bi = bi + plen;
        } else {
            store8(out + op, bc); op = op + 1; bi = bi + 1;
        }
    }
    # v6.5.19 — emit exactly the newlines this invocation CONSUMED, no more.
    # `_nl_in` counts source lines swallowed between the macro name and the
    # closing paren (0 for the ordinary one-line call); `_nl_out` counts what
    # the substitution already wrote, so a wrapped arg that carried its own
    # newline through is not double-counted. The old unconditional newline
    # here is what made every function-like invocation report one line late.
    var _nl_in = 0;
    var _sk = _ip_start;
    while (_sk < ip) {
        if (load8(S + _SRCB + _sk) == 10) { _nl_in = _nl_in + 1; }
        _sk = _sk + 1;
    }
    var _nl_out = 0;
    var _ok = _op_start;
    while (_ok < op) {
        if (load8(out + _ok) == 10) { _nl_out = _nl_out + 1; }
        _ok = _ok + 1;
    }
    while (_nl_out < _nl_in) { store8(out + op, 10); op = op + 1; _nl_out = _nl_out + 1; }
    # Return new ip via storing op in a known location
    store64(S + 0x190700, op);
    return ip;
}

# v5.6.42: src_base carries the SOURCE buffer base. PP_PASS path passes
# `S` (raw input at S+0). PP_IFDEF_PASS path passes the `tmp` mmap
# buffer that holds the full uncapped expanded source — needed because
# PP_IFDEF_PASS's S+0 copy-back is bounded to 1048576 B and reads past
# that boundary would land in stale heap bytes. Same shape as the
# v5.6.30 PP_DERIVE_* fix; this closes the rest of the family
# (PP_DEFINE / PP_DEFINED / PP_GETVAL / PP_EVAL_IF / PP_HASH).
fn PP_HASH(src_base, pos): i64 {
    var h = 0;
    var pi = 0;
    var pc = load8(src_base + pos + pi);
    while (pc != 10) {
        if (pc == 13) { return h; }
        if (pc == 0) { return h; }
        if (pc == 32) { return h; }
        h = h * 31 + pc;
        pi = pi + 1;
        pc = load8(src_base + pos + pi);
    }
    return h;
}

# Hash a null-terminated cstr using the same polynomial as PP_HASH,
# stopping at the first terminator byte (\0, \n, \r, space). Used by
# PP_PREDEFINE to register compiler-builtin defines (e.g. the
# CYRIUS_ARCH_* marker) from a plain C string instead of a preprocessor
# source position.
fn PP_HASH_CSTR(name): i64 {
    var h = 0;
    var i = 0;
    var c = load8(name + i);
    while (c != 0) {
        if (c == 10) { return h; }
        if (c == 13) { return h; }
        if (c == 32) { return h; }
        h = h * 31 + c;
        i = i + 1;
        c = load8(name + i);
    }
    return h;
}

# Register a builtin preprocessor symbol with value 0. Called from the
# compiler's main entry point before PREPROCESS so that lib files can
# `#ifdef CYRIUS_ARCH_AARCH64` / `#ifdef CYRIUS_ARCH_X86` to gate
# architecture-specific asm blocks without per-arch lib files.
fn PP_PREDEFINE(S, name): i64 {
    if (_pp_flag_count >= 16) { ERR_MSG(S, "too many preprocessor #define/flag entries (max 16)", 51); }
    var h = PP_HASH_CSTR(name);
    store64(S + 0x190800 + _pp_flag_count * 8, h);
    store64(S + 0x190880 + _pp_flag_count * 8, 0);
    _pp_flag_count = _pp_flag_count + 1;
    return 0;
}

# v5.6.42: src_base separated from S — see PP_HASH above. Source reads
# come from src_base+pos; flag-table writes stay at S+0x190800/0x190880.
fn PP_DEFINE(S, src_base, pos): i64 {
    if (_pp_flag_count >= 16) { ERR_MSG(S, "too many preprocessor #define/flag entries (max 16)", 51); }
    var h = PP_HASH(src_base, pos);
    store64(S + 0x190800 + _pp_flag_count * 8, h);
    # Check for value: #define NAME VALUE (skip name, find space, parse int)
    var vi = 0;
    var vc = load8(src_base + pos + vi);
    while (vc != 32) {
        if (vc == 10) { break; }
        if (vc == 0) { break; }
        vi = vi + 1;
        vc = load8(src_base + pos + vi);
    }
    var defval = 0;
    if (vc == 32) {
        vi = vi + 1;
        var dvc = load8(src_base + pos + vi);
        while (dvc >= 48) {
            if (dvc > 57) { break; }
            defval = defval * 10 + dvc - 48;
            vi = vi + 1;
            dvc = load8(src_base + pos + vi);
        }
    }
    store64(S + 0x190880 + _pp_flag_count * 8, defval);
    _pp_flag_count = _pp_flag_count + 1;
    return 0;
}

# Look up value of a #define'd name (returns 0 if not found)
fn PP_GETVAL(S, src_base, pos): i64 {
    var h = PP_HASH(src_base, pos);
    var di = 0;
    while (di < _pp_flag_count) {
        if (load64(S + 0x190800 + di * 8) == h) {
            return load64(S + 0x190880 + di * 8);
        }
        di = di + 1;
    }
    return 0;
}

fn PP_DEFINED(S, src_base, pos): i64 {
    var h = PP_HASH(src_base, pos);
    var di = 0;
    while (di < _pp_flag_count) {
        if (load64(S + 0x190800 + di * 8) == h) { return 1; }
        di = di + 1;
    }
    return 0;
}

# Given the position right after "#ifplat " (i.e. pointing at PLAT),
# resolve PLAT → CYRIUS_ARCH_<UPPER> and return 1 if that symbol is
# defined. Supported: `x86` and `aarch64`. Unknown platforms return
# 0 (fail-closed: block skipped). Used by the v5.4.19 `#ifplat`
# directive; the comparison hashes are computed at call time from
# the same literal strings that compiler bootstrap would register.
fn PP_IFPLAT_MATCH(S, pos): i64 {
    # Skip leading whitespace
    while (load8(S + _SRCB + pos) == 32) { pos = pos + 1; }
    var target_hash = 0;
    # "x86" = 78 38 36 — 3 chars, must be followed by a terminator
    if (load8(S + _SRCB + pos) == 120 && load8(S + _SRCB + pos + 1) == 56 && load8(S + _SRCB + pos + 2) == 54) {
        var nc = load8(S + _SRCB + pos + 3);
        if (nc == 32 || nc == 10 || nc == 13 || nc == 0) {
            target_hash = PP_HASH_CSTR("CYRIUS_ARCH_X86");
        }
    }
    # "aarch64" = 61 61 72 63 68 36 34 — 7 chars, must be followed by a terminator
    if (target_hash == 0) {
        if (load8(S + _SRCB + pos) == 97 && load8(S + _SRCB + pos + 1) == 97 && load8(S + _SRCB + pos + 2) == 114
        && load8(S + _SRCB + pos + 3) == 99 && load8(S + _SRCB + pos + 4) == 104
        && load8(S + _SRCB + pos + 5) == 54 && load8(S + _SRCB + pos + 6) == 52) {
            var nc = load8(S + _SRCB + pos + 7);
            if (nc == 32 || nc == 10 || nc == 13 || nc == 0) {
                target_hash = PP_HASH_CSTR("CYRIUS_ARCH_AARCH64");
            }
        }
    }
    if (target_hash == 0) { return 0; }
    var di = 0;
    while (di < _pp_flag_count) {
        if (load64(S + 0x190800 + di * 8) == target_hash) { return 1; }
        di = di + 1;
    }
    return 0;
}

fn PP_SKIPLINE(S, ip, bl): i64 {
    while (ip < bl) {
        if (load8(S + ip) == 10) { return ip + 1; }
        ip = ip + 1;
    }
    return ip;
}

# Builds expanded source into a new buffer, then copies back.
# v6.5.21 — turn a `#@pkgver <version>` marker into a real, source-visible
# constant: `var CYRIUS_PKG_VERSION = "<version>";`.
#
# ONE line in, ONE line out. That is the whole reason this is a directive rather
# than cbt simply prepending the `var` line: every other thing cbt prepends shifts
# `<source>` diagnostics by one (measured at 6.5.20: `-D FOO=1` moves a line-5
# error to :6, a one-include `[deps] stdlib` does the same), and only `#@incdir`
# was ever compensated. Replacing the line in place costs the file map nothing.
#
# ⚠ The value is STRICTLY validated — `[0-9A-Za-z._+-]`, max 64. It lands inside a
# `"..."` literal and it comes from a manifest, which is consumer-controlled input:
# an unfiltered `"` would close the string and let a `version` field inject
# arbitrary cyrius into the compile. Anything unexpected emits a bare newline
# instead, so the constant is simply ABSENT and the use site fails honestly with
# `undefined variable 'CYRIUS_PKG_VERSION'` rather than compiling something forged.
fn PP_EMIT_PKGVER(S, out, op, ip, bl): i64 {
    # v6.5.34 — the reference scan MOVED to the end of PP_PASS; this function now only
    # VALIDATES the version and stashes it in `_pp_pkgver`, emitting nothing.
    #
    # It used to scan for the literal `CYRIUS_PKG_` right here, in the marker's own buffer
    # — which at this moment is the ENTRY FILE's raw text, because includes have not been
    # expanded yet. So the declaration appeared when the entry file named the symbol and
    # was silently omitted when only an `include`d file did, which is the exact reverse of
    # what the marker's byte-0 position suggests. Reported by agnostic wiring a `/ready`
    # endpoint whose handler lived in `src/routes/health.cyr`:
    #   error: undefined variable 'CYRIUS_PKG_VERSION' (missing include or enum?)
    #
    # ⚠ The conditional itself is NOT incidental and must survive any rework: declaring
    # unconditionally puts an unused global plus its string data into EVERY binary built
    # through `cyrius build`, changing the bytes of programs that never asked for the
    # feature. `tests/gates/toolchain/auto_deps_verb_gate.sh` axis 5 catches exactly that
    # and is right to. The fix widens what "referenced" is scanned OVER; it does not drop
    # the test. See PP_RESOLVE_PKGVER at the tail of PP_PASS.
    var p = ip + 9;
    var n = 0;
    var ok = 1;
    while (p < bl) {
        var c = load8(S + p);
        if (c == 10) { break; }
        if (c == 13) { break; }
        var good = 0;
        if (c >= 48) { if (c <= 57) { good = 1; } }
        if (c >= 65) { if (c <= 90) { good = 1; } }
        if (c >= 97) { if (c <= 122) { good = 1; } }
        if (c == 46) { good = 1; }
        if (c == 95) { good = 1; }
        if (c == 43) { good = 1; }
        if (c == 45) { good = 1; }
        if (good == 0) { ok = 0; break; }
        if (n >= 64) { ok = 0; break; }
        store8(&_pp_pkgver + n, c);
        n = n + 1;
        p = p + 1;
    }
    if (n == 0) { ok = 0; }
    if (ok == 0) {
        _pp_pkgver_len = 0;
        return op;
    }
    store8(&_pp_pkgver + n, 0);
    _pp_pkgver_len = n;
    # Emit OPTIMISTICALLY, and record the span so PP_PASS's tail can blank it if the
    # finished unit turns out never to name the constant. The declaration has to be here,
    # at the top — a global is not visible above its declaration — but whether it is wanted
    # is not knowable until the includes are expanded.
    _pp_pkgver_at = op;
    op = op + PP_EMIT_STR(out, op, "var CYRIUS_PKG_VERSION = ");
    store8(out + op, 34); op = op + 1;         # '"'
    var i = 0;
    while (i < n) {
        store8(out + op, load8(&_pp_pkgver + i));
        op = op + 1;
        i = i + 1;
    }
    store8(out + op, 34); op = op + 1;         # '"'
    store8(out + op, 59); op = op + 1;         # ';'
    _pp_pkgver_declen = op - _pp_pkgver_at;
    # ⚠ NO trailing newline, deliberately. Emitting one would make this a 1-for-1
    # line REPLACEMENT, which is NOT line-neutral: cbt ADDS this marker above the
    # user's file, so any line the marker occupies pushes every user line down by
    # one — exactly the +N shift `-D` and `[deps] stdlib` already cause today.
    # Emitting zero newlines merges the declaration onto the front of the user's
    # first line, so expanded line N is user line N. Same technique as the v6.5.20
    # `#derive` fix. Statements are `;`-terminated, so sharing the line is legal.
    return op;
}

# v6.5.34 — decide whether the `CYRIUS_PKG_VERSION` declaration PP_EMIT_PKGVER wrote
# optimistically should stay, now that the unit is fully expanded. Called at the tail of
# PP_PASS, where `out[0..op]` holds the entry file with every top-level `include` expanded
# in place — so an included file naming the constant is finally visible to the test, which
# is the whole bug.
#
# ⚠ THE DECLARATION CANNOT MOVE. A global is NOT visible above its declaration in cyrius:
#     fn f(): i64 { return XYZ; }  var _r = f();  var XYZ = 7;
#     → error: undefined variable 'XYZ'
# The v6.5.33 attempt appended it after expansion on the issue file's recorded (and wrong)
# claim that forward globals resolve, and could never have worked. So the declaration stays
# where it must be — at the top — and this pass BLANKS it to spaces when unwanted. Same byte
# count, so no line and no column moves, and whitespace emits no code.
#
# ⚠ Scanning for the 11-byte prefix `CYRIUS_PKG_` rather than the full name is deliberate
# and unchanged from v6.5.21: a false positive costs one unused global, a false negative is
# impossible, and the prefix is distinctive enough that neither happens in practice.
fn PP_RESOLVE_PKGVER(out, op): i64 {
    if (_pp_pkgver_len == 0) { return op; }
    if (_pp_pkgver_declen == 0) { return op; }
    # Scan the FULLY EXPANDED unit — this is the whole fix. The v6.5.21 scan ran inside
    # PP_EMIT_PKGVER, whose buffer at that moment is the ENTRY FILE's raw text, includes
    # not yet expanded. So the constant resolved when the entry file named it and failed
    # when only an `include`d file did — the exact reverse of what the byte-0 marker
    # position suggests. Reported by agnostic against a `/ready` handler in
    # `src/routes/health.cyr`.
    #
    # ⚠ SKIP THE DECLARATION'S OWN BYTES. It contains the very prefix being searched for,
    # so scanning the whole buffer would match itself and every build would keep the global
    # — silently restoring the unconditional behaviour axis 5 of auto_deps_verb_gate.sh
    # exists to forbid, while looking like it still had a test.
    var declo = _pp_pkgver_at;
    var dechi = _pp_pkgver_at + _pp_pkgver_declen;
    var sp = 0;
    var seen = 0;
    while (sp + 11 <= op) {
        if (sp >= declo && sp < dechi) { sp = dechi; continue; }
        if (load8(out + sp) == 67) {
            if (load8(out + sp + 1) == 89 && load8(out + sp + 2) == 82 && load8(out + sp + 3) == 73 && load8(out + sp + 4) == 85 && load8(out + sp + 5) == 83 && load8(out + sp + 6) == 95 && load8(out + sp + 7) == 80 && load8(out + sp + 8) == 75 && load8(out + sp + 9) == 71 && load8(out + sp + 10) == 95) {
                seen = 1;
                break;
            }
        }
        sp = sp + 1;
    }
    if (seen == 1) { return op; }
    # Not referenced: blank the declaration to spaces. Same byte count, so no line and no
    # column moves, and whitespace emits no code — the produced binary is byte-identical to
    # a build that never saw the marker, which is what axis 5 measures.
    var b = declo;
    while (b < dechi) {
        store8(out + b, 32);
        b = b + 1;
    }
    _pp_pkgver_len = 0;
    return op;
}

fn PP_PASS(S): i64 {
    var bl = GBL(S);
    var out = S + 0x459D000;
    var op = 0;
    var ip = 0;
    var bol = 1;
    var skip_depth = 0;
    # v5.6.1: pp_depth tracks the index into the per-level state stack
    # at S+0x197F10 (64-byte cap, one byte per nesting level). Shared
    # with skip_depth: skip_depth == number of stack entries with
    # state != 0. See the directive handler comments below for the
    # state machine.
    var pp_depth = 0;
    var had_include = 0;
    # Emit an initial `#@file "<source>"` marker so the main source is
    # ALWAYS covered by the file map — even if no includes fire. Fixes
    # bote feedback item 6 where a parse error in main source with no
    # preceding includes fell through to the raw preprocessed line number.
    # v6.5.3 — through PP_FMARK, so this carries a base like every other marker.
    # Hand-rolled bytes here meant no base field, which FM_BUILD reads as 0 -> 1.
    # Correct for THIS one (the main source really does start at line 1), but it was
    # the same hand-rolling in the one-shot below (deleted at v6.5.3) that silently
    # defeated the resume-line fix.
    op = PP_FMARK(S, out, op, "<source>", 1);
    # v6.5.19 — DROP a leading `#@incdir <dir>` line. PP_SCAN_INCDIR only READS it; it
    # was then copied through as an ordinary `#` comment and occupied an expanded line
    # the source did not have, so `<source>` numbering ran one line late for every file
    # `cyrius build`/`check`/`lint` materialised with the marker (i.e. every source with
    # a directory component). Setting the bias here rather than reading _pp_incdir_len
    # is deliberate: a marker REJECTED by PP_SCAN_INCDIR's path guards still occupied its
    # line, so the line count and the marker's validity are different questions.
    if (bl >= 9) {
        if (load8(S + _SRCB) == 35 && load8(S + _SRCB + 1) == 64 && load8(S + _SRCB + 2) == 105 && load8(S + _SRCB + 3) == 110 && load8(S + _SRCB + 4) == 99 && load8(S + _SRCB + 5) == 100 && load8(S + _SRCB + 6) == 105 && load8(S + _SRCB + 7) == 114 && load8(S + _SRCB + 8) == 32) {
            ip = PP_SKIPLINE(S + _SRCB, ip, bl);
            _pp_srcline_bias = 1;
        }
    }
    # v6.5.21 — `#@pkgver <version>`, accepted at byte 0 or on the line directly
    # after `#@incdir` (cbt emits both, incdir first — that one is byte-0-ONLY and
    # its writer is guarded by "Nothing may be emitted above this line").
    # No `_pp_srcline_bias` bump here: PP_EMIT_PKGVER writes a replacement line,
    # so the expanded stream keeps the same line count as the source.
    if (bl - ip >= 10) {
        if (load8(S + _SRCB + ip) == 35 && load8(S + _SRCB + ip + 1) == 64 && load8(S + _SRCB + ip + 2) == 112 && load8(S + _SRCB + ip + 3) == 107 && load8(S + _SRCB + ip + 4) == 103 && load8(S + _SRCB + ip + 5) == 118 && load8(S + _SRCB + ip + 6) == 101 && load8(S + _SRCB + ip + 7) == 114 && load8(S + _SRCB + ip + 8) == 32) {
            op = PP_EMIT_PKGVER(S + _SRCB, out, op, ip, bl);
            ip = PP_SKIPLINE(S + _SRCB, ip, bl);
        }
    }
    # v5.8.40 — string-literal awareness. `in_string` flips on
    # unescaped `"`; `escape_next` suppresses the toggle for the
    # byte immediately following `\` while inside a string. The
    # directive-detection block below gates on `in_string == 0`
    # so a string literal containing `include "..."` (or any other
    # directive prefix) doesn't get mistaken for a real directive.
    # Mirrors the cyrlint v5.7.36 string-literal fix.
    # v5.9.34 — `in_comment` added (vyakarana 1.0.2 fix). See the
    # state-machine site below for the full rationale.
    var in_string = 0;
    var escape_next = 0;
    var in_comment = 0;
    while (ip < bl) {
        var c = load8(S + _SRCB + ip);
        var handled = 0;
        # Preprocessor directives at start of line. `dip` lets
        # `#`-prefixed directives tolerate leading whitespace
        # (cyrfmt indents `#ifdef` inside function bodies); ISINCLUDE
        # stays at `ip` so `    include = 0;` remains an expression,
        # not a directive. v5.8.40 — also gated on `in_string == 0`
        # so directive prefixes inside string literals aren't
        # processed.
        var dip = PP_SKIP_WS(S + _SRCB, ip, bl);
        if (bol == 1 && in_string == 0) {
            if (ISDEFINE(S + _SRCB, dip, bl) == 1) {
                if (skip_depth == 0) {
                    # Check for macro with args: #define NAME(
                    var dp = dip + 8;
                    var is_macro = 0;
                    while (dp < bl) {
                        var dc = load8(S + _SRCB + dp);
                        if (dc == 40) { is_macro = 1; break; }
                        if (dc == 32) { break; }
                        if (dc == 10) { break; }
                        dp = dp + 1;
                    }
                    if (is_macro == 1) {
                        # Store macro inline: copy line text to storage
                        var msi = _pp_macro_count;
                        if (msi < 16) {
                            var mip = dip + 8;
                            store64(S + 0x192000 + msi * 8, PP_HASH_ID(S + _SRCB, mip));
                            store64(S + 0x192080 + msi * 8, _pp_macro_text_pos);
                            var mdst = S + 0x193000 + _pp_macro_text_pos;
                            var mlen = 0;
                            var mcp = mip;
                            # ⛔ v6.5.45 (CVE-40) — THIS COPY WAS UNBOUNDED. The loop ran to
                            # end-of-line with no check on `mlen` or on the ACCUMULATING
                            # `_pp_macro_text_pos`, writing straight out of the macro text pool
                            # at S+0x193000. The pool's free headroom runs to S+0x197000
                            # (0x193400 is FREED since v6.1.40; the next LIVE writer is
                            # 0x197000), i.e. 16 KB shared across all 16 macros — so a single
                            # long `#define` body, or several ordinary ones in sequence, walked
                            # into live compiler state. Silent: no diagnostic, no crash, a
                            # wrong compile. Same class as CVE-32.
                            # ⚠ The guard is on the DESTINATION OFFSET, not on this macro's
                            # length, because the position accumulates across macros — bounding
                            # `mlen` alone would still overrun on the sixteenth #define.
                            var mcap = 16384;
                            while (mcp < bl) {
                                if (load8(S + _SRCB + mcp) == 10) { break; }
                                if (_pp_macro_text_pos + mlen + 1 >= mcap) { PP_MACRO_TEXT_FULL(); }
                                store8(mdst + mlen, load8(S + _SRCB + mcp));
                                mlen = mlen + 1;
                                mcp = mcp + 1;
                            }
                            store8(mdst + mlen, 0);
                            store64(S + 0x192100 + msi * 8, mlen);
                            _pp_macro_text_pos = _pp_macro_text_pos + mlen + 1;
                            _pp_macro_count = _pp_macro_count + 1;
                        }
                        ip = PP_SKIPLINE(S + _SRCB, ip, bl);
                    } else {
                        PP_DEFINE(S, S + _SRCB, dip + 8);
                        ip = PP_SKIPLINE(S + _SRCB, ip, bl);
                    }
                } else {
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl);
                }
                # v6.5.19 — a consumed directive line still OCCUPIED a source line.
                # Emit a blank line in its place so the expanded stream stays 1:1 with
                # the source and FM_LOOKUP's span arithmetic stays exact. All three
                # arms above consume exactly one line, so one newline covers them.
                store8(out + op, 10); op = op + 1;
                bol = 1; handled = 1;
            }
            # #ifdef / #ifndef / #ifplat / #if (v5.6.1 state-stack
            # rewrite). Per-level state lives at S+0x197F10[pp_depth],
            # one byte per level, cap 64 levels. Encoding:
            #   0 = EMITTING    — branch emits; outer emits
            #   1 = SEARCHING   — branch skips, no true match yet; outer emits
            #   2 = DONE        — true branch already taken; skip rest
            #   3 = OUTER_SKIP  — outer was skipping on entry; stays skip
            # Emit iff skip_depth == 0, which tracks (count of levels
            # with state != 0). Push-site logic below is identical
            # across the four ISIF* variants — only the cond-eval
            # callee differs.
            if (handled == 0) { if (ISIFDEF(S + _SRCB, dip, bl) == 1) {
                    var _s = 3;  # default: OUTER_SKIP
                    if (skip_depth == 0) {
                        if (PP_DEFINED(S, S + _SRCB, dip + 7) == 1) { _s = 0; }
                        else { _s = 1; }
                    }
                    store8(S + 0x197F10 + pp_depth, _s);
                    pp_depth = pp_depth + 1;
                    if (_s != 0) { skip_depth = skip_depth + 1; }
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                } }
            if (handled == 0) { if (ISIFNDEF(S + _SRCB, dip, bl) == 1) {
                    var _s = 3;
                    if (skip_depth == 0) {
                        if (PP_DEFINED(S, S + _SRCB, dip + 8) == 0) { _s = 0; }
                        else { _s = 1; }
                    }
                    store8(S + 0x197F10 + pp_depth, _s);
                    pp_depth = pp_depth + 1;
                    if (_s != 0) { skip_depth = skip_depth + 1; }
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                } }
            # #ifplat PLAT (v5.4.19) — sugar for #ifdef CYRIUS_ARCH_<UPPER>.
            # Must come before ISIF so "#ifp..." doesn't match the 4-byte
            # "#if " prefix check (ISIF explicitly rejects byte 4 == 'd'
            # but not 'p'). Paired with ISENDPLAT below.
            if (handled == 0) { if (ISIFPLAT(S + _SRCB, dip, bl) == 1) {
                    var _s = 3;
                    if (skip_depth == 0) {
                        if (PP_IFPLAT_MATCH(S, dip + 8) == 1) { _s = 0; }
                        else { _s = 1; }
                    }
                    store8(S + 0x197F10 + pp_depth, _s);
                    pp_depth = pp_depth + 1;
                    if (_s != 0) { skip_depth = skip_depth + 1; }
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                } }
            if (handled == 0) { if (ISIF(S + _SRCB, dip, bl) == 1) {
                    var _s = 3;
                    if (skip_depth == 0) {
                        if (PP_EVAL_IF(S, S + _SRCB, dip + 4) == 1) { _s = 0; }
                        else { _s = 1; }
                    }
                    store8(S + 0x197F10 + pp_depth, _s);
                    pp_depth = pp_depth + 1;
                    if (_s != 0) { skip_depth = skip_depth + 1; }
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                } }
            # #else (v5.6.1) — flip current level's state.
            #   0 → 2 (was emit; done-skip now)           skip_depth++
            #   1 → 0 (was search; else body emits)       skip_depth--
            #   2 → 2 no-op (already done)
            #   3 → 3 no-op (outer skipping)
            # Unbalanced #else (pp_depth == 0) is a programmer error;
            # ignore silently rather than abort — matches existing
            # ISENDIF behavior when skip_depth underflows.
            if (handled == 0) { if (ISELSE(S + _SRCB, dip, bl) == 1) {
                    if (pp_depth > 0) {
                        var _s = load8(S + 0x197F10 + pp_depth - 1);
                        if (_s == 0) { store8(S + 0x197F10 + pp_depth - 1, 2); skip_depth = skip_depth + 1; }
                        elif (_s == 1) { store8(S + 0x197F10 + pp_depth - 1, 0); skip_depth = skip_depth - 1; }
                    }
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                } }
            # #elif COND (v5.6.1) — transition like #else for states 0/2/3
            # but state 1 evaluates COND: if true, flip 1→0 (emit now);
            # if false, stay 1 (keep searching for a later #elif/#else).
            if (handled == 0) { if (ISELIF(S + _SRCB, dip, bl) == 1) {
                    if (pp_depth > 0) {
                        var _s = load8(S + 0x197F10 + pp_depth - 1);
                        if (_s == 0) { store8(S + 0x197F10 + pp_depth - 1, 2); skip_depth = skip_depth + 1; }
                        elif (_s == 1) {
                            if (PP_EVAL_IF(S, S + _SRCB, dip + 6) == 1) {
                                store8(S + 0x197F10 + pp_depth - 1, 0);
                                skip_depth = skip_depth - 1;
                            }
                        }
                    }
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                } }
            # v6.5.24 — `#@srcline`: set the `<source>` line bias from THIS marker's own
            # position, so every cbt prepend above it stops shifting diagnostics. See
            # ISSRCLINE for why this is a position marker rather than a count.
            #
            # `_pp_lineno_at` is 1-based, so a marker on raw line L means the entry file's
            # line 1 is raw line L+1, and `PP_REANCHOR_SRC`'s `raw_line - bias` yields the
            # user's own numbering exactly when bias == L. Assigned ABSOLUTELY, which also
            # SUBSUMES the `#@incdir` bias of 1 set above — L already counts that line.
            #
            # ⚠ HONOUR-ONCE (`_pp_srcline_seen`). A hostile include could contain the
            # marker text; accepting a second one would let it re-point line attribution.
            # Worst case is still only wrong line numbers — it carries no filename and
            # cannot open a file span, unlike the `#@file` hole v6.5.21 closed — but
            # first-one-wins costs one flag and keeps cbt's marker authoritative.
            if (handled == 0) { if (ISSRCLINE(S + _SRCB, dip, bl) == 1) {
                    if (_pp_srcline_seen == 0) {
                        _pp_srcline_bias = _pp_lineno_at(S, S + _SRCB, dip);
                        _pp_srcline_seen = 1;
                        # ⭐ RE-ANCHOR HERE, don't just set the bias. Setting `bias` alone
                        # does nothing for the common case: the bias is only consumed by
                        # PP_REANCHOR_SRC when an include RETURNS, and cbt's prepended
                        # `include` lines all sit ABOVE this marker — so the last reanchor
                        # has already happened by the time the marker is read, with the old
                        # bias, and nothing recomputes it. Measured while building this:
                        # bias-only reported the RAW line (8) instead of the user's (3).
                        # Declaring the span outright — "what follows is <source> line 1" —
                        # is what actually moves the numbering. Costs ONE map entry per
                        # compile, which the 1024-entry cap absorbs (that cap is why
                        # v6.5.19 pads #ifdef blocks instead of marking them).
                        op = PP_REANCHOR(S, out, op, "<source>", 1);
                    }
                    # The bias assignment above still matters for what comes AFTER: a user
                    # `include` inside the entry file re-anchors on return via
                    # PP_REANCHOR_SRC, which needs raw→user in the bias. L subsumes the
                    # `#@incdir` bias of 1 set before the loop — L already counts that line.
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); bol = 1; handled = 1;
                } }
            if (handled == 0) { if (ISENDIF(S + _SRCB, dip, bl) == 1) {
                    if (pp_depth > 0) {
                        var _s = load8(S + 0x197F10 + pp_depth - 1);
                        if (_s != 0) { skip_depth = skip_depth - 1; }
                        pp_depth = pp_depth - 1;
                    }
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                } }
            # #endplat — semantically identical to #endif, visually pairs
            # with #ifplat. Must come after ISENDIF because "#endp" would
            # match "#end" prefix but we only want ISENDPLAT catching it.
            if (handled == 0) { if (ISENDPLAT(S + _SRCB, dip, bl) == 1) {
                    if (pp_depth > 0) {
                        var _s = load8(S + 0x197F10 + pp_depth - 1);
                        if (_s != 0) { skip_depth = skip_depth - 1; }
                        pp_depth = pp_depth - 1;
                    }
                    ip = PP_SKIPLINE(S + _SRCB, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                } }
            # v6.5.20 — `#derive` is now LINE-EXACT and carries NO marker. v6.5.19 had it
            # re-anchor here, because the expansion added lines and could not be padded;
            # that made everything AFTER a derive exact but nothing INSIDE it (a linear
            # `expanded - start + base` cannot describe a span that stretches in the
            # middle, so a diagnostic in the struct stayed +1 and a SYNTHESIZED fn landed
            # in the generated block past the struct). The handlers now emit the whole
            # generated block on the struct's closing-`}` line and pad the consumed
            # directive lines, so the construct occupies exactly the source lines it
            # replaced — no marker, and one less entry per derive against the 1024-entry
            # file-map cap. See PP_PARSE_STRUCT_DEF and `_pp_flatten`.
            if (handled == 0) { if (skip_depth == 0) { if (ISDERIVE(S + _SRCB, dip, bl) == 1) {
                        ip = PP_DERIVE_SERIALIZE(S, S + _SRCB, dip, bl, out, op);
                        op = load64(S + 0x197008);
                        bol = 1; handled = 1;
                    } } }
            if (handled == 0) { if (skip_depth == 0) { if (ISDERIVE_DE(S + _SRCB, dip, bl) == 1) {
                        ip = PP_DERIVE_DESER(S, S + _SRCB, dip, bl, out, op);
                        op = load64(S + 0x197008);
                        bol = 1; handled = 1;
                    } } }
            if (handled == 0) { if (skip_depth == 0) { if (ISDERIVE_ACC(S + _SRCB, dip, bl) == 1) {
                        ip = PP_DERIVE_ACCESSORS(S, S + _SRCB, dip, bl, out, op);
                        op = load64(S + 0x197008);
                        bol = 1; handled = 1;
                    } } }
            if (handled == 0) { if (skip_depth == 0) { if (ISINCLUDE(S + _SRCB, ip, bl) == 1) {
                        ip = ip + 8;
                        if (load8(S + _SRCB + ip) == 34) {
                            ip = ip + 1;
                            var fname = S + 0x190400;
                            var fi = 0;
                            var fgo = 1;
                            while (fgo == 1) {
                                if (ip >= bl) { fgo = 0; }
                                if (fgo == 1) {
                                    var fc = load8(S + _SRCB + ip);
                                    if (fc == 34) { ip = ip + 1; fgo = 0; }
                                    else { if (fi >= 767) { PP_FNAME_TOO_LONG(); } store8(fname + fi, fc); fi = fi + 1; ip = ip + 1; }
                                }
                            }
                            store8(fname + fi, 0);
                            var sgo = 1;
                            while (sgo == 1) {
                                if (ip >= bl) { sgo = 0; }
                                if (sgo == 1) { if (load8(S + _SRCB + ip) == 10) { ip = ip + 1; sgo = 0; } else { ip = ip + 1; } }
                            }
                            # Include-once: skip if already included
                            if (PP_ALREADY_INCLUDED(S, fname) == 0) {
                                PP_MARK_INCLUDED(S, fname);
                                op = PP_FMARK(S, out, op, fname, 1);
                                var nr = READFILE(fname, out + op, 25165824 - op);
                                if (nr < 0) {
                                    syscall(SYS_WRITE, 2, "error: cannot open include file: ", 33);
                                    var _ifl = 0;
                                    while (load8(fname + _ifl) != 0) { _ifl = _ifl + 1; }
                                    syscall(SYS_WRITE, 2, fname, _ifl);
                                    syscall(SYS_WRITE, 2, "\n", 1);
                                    syscall(SYS_EXIT, 1);
                                }
                                # v6.5.24 — bare-metal forbidden-module check: RECORD only.
                                # Scanning the bytes just read means no file is opened
                                # twice. The decision cannot be made here — kernel_mode is
                                # still 0 during preprocessing (see the reporting site at
                                # the end of PARSE_PROG in parse.cyr for why).
                                if (PP_IS_HOST_ONLY(out + op, nr) == 1) { PP_NOTE_HOST_ONLY(fname); }
                                op = op + nr;
                                # v6.5.0 Phase 1 — RESUME marker. Without this the
                                # enclosing file's remaining text inherits the INCLUDED
                                # file's identity, because FM_BUILD derives each span as
                                # the gap to the NEXT marker. That made `private`
                                # mis-scope in BOTH directions in cycc's own build
                                # (lib/alloc.cyr and lib/atomic.cyr shared an id;
                                # src/frontend/lex.cyr split across two), and it is also
                                # a live DX bug — diagnostics reported the wrong file for
                                # anything after an include.
                                # PP_PASS only ever expands TOP-LEVEL includes (an
                                # included file's own `include` lines are copied verbatim
                                # into `out` and expanded later by PP_IFDEF_PASS), so the
                                # file being resumed here is always the main source.
                                op = PP_REANCHOR_SRC(S, out, op, ip);
                                had_include = 1;
                            } else {
                                # v6.5.3 — include-once SKIP still consumes the directive
                                # LINE, so the enclosing file's numbering advances by one
                                # with no marker to record it. Without this the base set by
                                # an earlier RESUME goes stale by one per skipped include
                                # and every later diagnostic drifts. Re-anchor with a RESUME
                                # marker; there is no ENTER to pair it with, which is fine —
                                # it only re-states where the parent now is.
                                op = PP_REANCHOR_SRC(S, out, op, ip);
                            }
                        }
                        bol = 1; handled = 1;
                    } } }
        }
        # Default: copy byte to output (if not skipping)
        if (handled == 0) {
            if (skip_depth == 0) {
                # v6.5.3 — the `source_marked` one-shot USED to emit a bare
                # `#@file "<source>"` here, before the first non-directive line after an
                # include. It was an earlier, partial attempt at this same problem and it
                # is now actively harmful: it fired at the very point the RESUME marker
                # had just correctly marked, adding a SECOND entry for the same place
                # carrying no base — so FM_LOOKUP matched the base-less one and restarted
                # the main source's numbering at 1. That is precisely why the first
                # attempt at this fix "changed nothing": the fix was right and this
                # overwrote it. Deleted rather than patched — RESUME markers cover every
                # case it covered, and the issue's own note said to fold it into whatever
                # landed rather than leave two mechanisms.
                # v6.5.21 — NEUTRALISE a user-authored `#@file` marker.
                #
                # FM_BUILD scans the FINAL buffer for `#@file` at ANY offset — no
                # byte-0 rule and no beginning-of-line rule, unlike `#@incdir`. So
                # ordinary source could FORGE a file-map entry claiming its code came
                # from another file, which DEFEATS `private` file visibility: a forged
                # `#@file "hidden.cyr" 3` — even sitting as a trailing comment
                # mid-line — turned a correct `'secret_fn' is private to its file`
                # rejection into a clean build that ran the private fn.
                #
                # Done HERE rather than in the final PP_MACRO_PASS because this loop
                # is the one that knows about string literals (`in_string`); the macro
                # pass has no such state, so rewriting there would silently mangle a
                # string that happens to contain `#@file`. PP_MACRO_PASS only copies,
                # so neutralising the source once here is sufficient. Real markers are
                # unaffected: PP_FMARK writes them straight to `out`, never through
                # this copy of the input.
                #
                # `# @file` stays a comment and is inert to the scanner; the extra
                # byte shifts columns only INSIDE a comment, where nothing is reported.
                # Not a sandbox escape — a forger already controls the source being
                # compiled — but `private` is meant to be a checkable guarantee.
                var _ff = 0;
                if (in_string == 0) { if (c == 35) { if (ip + 5 < bl) {
                    if (load8(S + _SRCB + ip + 1) == 64 && load8(S + _SRCB + ip + 2) == 102 && load8(S + _SRCB + ip + 3) == 105 && load8(S + _SRCB + ip + 4) == 108 && load8(S + _SRCB + ip + 5) == 101) {
                        _ff = 1;
                    }
                } } }
                store8(out + op, c); op = op + 1;
                if (_ff == 1) { store8(out + op, 32); op = op + 1; }
            }
            # v6.5.19 — a SKIPPED body line still occupied a source line. Keep its
            # newline so the expanded stream stays 1:1 with the source; the rest of the
            # line is dropped as before. Without this, `#ifdef`-excluded bodies shrank
            # the stream inside a `#@file` span and every later diagnostic in that file
            # reported a line too small (agnosai: 30 warnings, uniformly true − 55).
            elif (c == 10) { store8(out + op, 10); op = op + 1; }
            # v5.8.40 — string-literal state machine. Track `"`
            # boundaries so the directive block above can skip
            # detection while inside a literal. `\` inside a
            # string sets escape_next so the following byte (a
            # quote, backslash, n, etc.) doesn't toggle the
            # in_string flag.
            #
            # v5.9.34 — comment-aware. `#` outside a string starts
            # a line comment; comments end at the next newline.
            # Inside a comment, `"` does NOT toggle in_string.
            # Pre-fix vyakarana 1.0.2 tripped on a `\"` inside a
            # backtick-quoted comment in `src/grammar.cyr` —
            # `"` was treated as a string opener, `in_string`
            # stayed 1 through the rest of the buffer, every
            # subsequent `include` directive failed the bol+in_string
            # gate at PP_IFDEF_PASS:1603 and was passed through as
            # raw text. The lexer then reported `expected '=', got
            # string` at the include line because `include` was
            # consumed as an identifier.
            #
            # Newline also resets in_string + escape_next + in_comment
            # to 0 as a safety net. cyrius source uses single-line
            # strings (`\n` escape, not literal LF inside a string);
            # any state corruption from comments / char literals /
            # other oddities is bounded to one line.
            if (in_comment == 1) {
                if (c == 10) { in_comment = 0; bol = 1; }
                else { bol = 0; }
                ip = ip + 1;
            } else {
                if (escape_next == 1) {
                    escape_next = 0;
                } else {
                    if (in_string == 0) {
                        if (c == 35)      { in_comment = 1; }   # '#' starts comment
                        elif (c == 34)    { in_string = 1; }    # '"' opens string
                    } else {
                        if (c == 92)      { escape_next = 1; }
                        elif (c == 34)    { in_string = 0; }
                    }
                }
                ip = ip + 1;
                if (c == 10) {
                    bol = 1;
                    in_string = 0;
                    escape_next = 0;
                    in_comment = 0;
                } else {
                    bol = 0;
                }
            }
        }
    }
    # Check preprocess output size. Buffer is 8MB at 0x459D000
    # (v5.11.33 — was 2MB at 0x44A000 pre-relocation; raised to absorb
    # sandhi-folded stdlib growth + headroom into v6.x).
    if (op > 25165824) {
        syscall(SYS_WRITE, 2, "error: expanded source exceeds 24MB (", 37);
        PRNUM(op);
        syscall(SYS_WRITE, 2, " bytes)\n", 8);
        syscall(SYS_EXIT, 1);
    }
    # v6.5.34 — the `#@pkgver` declaration was written optimistically at the marker; only
    # HERE, with every top-level include expanded, can "does this unit reference the
    # constant?" be answered honestly. Blanks it to spaces if not. Length is unchanged, so
    # this neither grows the buffer nor affects the 8 MB guard above.
    op = PP_RESOLVE_PKGVER(out, op);
    # No copy-back — data stays at S+0x459D000.
    # PP_IFDEF_PASS reads from 0x459D000, writes to S+0.
    SBL(S, op);
    return had_include;
}

# Separate pass: expand macro invocations after all includes/ifdefs are resolved
fn PP_MACRO_PASS(S): i64 {
    if (_pp_macro_count == 0) { return 0; }
    var bl = GBL(S);
    # Copy from 0x459D000 to S+0, save/restore state if large
    var out = S + 0x459D000;
    var op = 0;
    var ip = 0;
    while (ip < bl) {
        var c = load8(S + _SRCB + ip);
        var expanded = 0;
        # Check for uppercase-starting identifier that might be a macro
        if (c >= 65) { if (c <= 90) {
                var mmi = PP_FIND_MACRO(S, ip);
                if (mmi >= 0) {
                    # Verify ( follows the name (skip alpha chars to find it)
                    var mp = ip;
                    while (mp < bl) {
                        var mc = load8(S + _SRCB + mp);
                        if (mc == 40) { break; }
                        if (mc >= 65) { if (mc <= 90) { mp = mp + 1; } else { break; } }
                        elif (mc >= 97) { if (mc <= 122) { mp = mp + 1; } else { break; } }
                        elif (mc >= 48) { if (mc <= 57) { mp = mp + 1; } else { break; } }
                        elif (mc == 95) { mp = mp + 1; }
                        else { break; }
                    }
                    if (mp < bl) { if (load8(S + _SRCB + mp) == 40) {
                            ip = PP_EXPAND(S, mmi, ip, bl, out, op);
                            op = load64(S + 0x190700);
                            expanded = 1;
                        } }
                }
            } }
        # v6.5.21 — NEUTRALISE a user-authored `#@file` marker.
        #
        # FM_BUILD scans the EXPANDED buffer for `#@file` at ANY offset — no byte-0
        # rule and no beginning-of-line rule, unlike `#@incdir`. So ordinary source
        # could FORGE a file-map entry claiming its code came from another file,
        # which DEFEATS `private` file visibility: a forged
        # `#@file "hidden.cyr" 3` — even sitting as a trailing comment mid-line —
        # turned a correct `'secret_fn' is private to its file` rejection into a
        # clean build that ran the private fn.
        #
        # Only PP_FMARK may mint these, and it writes to `out` directly rather than
        # through this copy, so breaking the sequence here cannot damage a real
        # marker. `# @file` remains a comment and is inert to the scanner; the extra
        # byte only shifts columns INSIDE a comment, where nothing is reported.
        # Not a sandbox escape — whoever forges it already controls the source being
        # compiled — but it is a soundness hole in `private`, which is supposed to be
        # a checkable guarantee rather than a convention.
        if (expanded == 0) {
            store8(out + op, c);
            op = op + 1;
            ip = ip + 1;
        }
    }
    # No copy-back — output stays at S+0x459D000. LEX reads from there.
    SBL(S, op);
    return 0;
}

# Second pass: evaluate #ifdef/#define/#endif only (no includes).
# Processes conditional blocks in already-included content.
#
# v3.6.5: reads source from the preprocess buffer (S+0x459D000) directly via
# `src` pointer. Only the first 256KB is copied to S+0 for helper functions
# (ISDEFINE, PP_DEFINE, PP_SKIPLINE, etc.) which read via S+pos and also
# access heap state at S+0x190800. Directives only appear in the first few KB
# of source (stdlib headers), so the 256KB copy always covers them.
#
# Output writes go to S+0x459D000 (in-place: op <= ip always, safe because
# ifdef filtering only removes lines). NO copy-back to S+0 at the end —
# LEX reads from S+0x459D000, and PP_MACRO_PASS short-circuits for programs
# without macros.
#
# This eliminates the Bug #35 family of copy-back overflows that corrupted
# compiler state (BL/CP at 0x18C100+) for programs >256KB of expanded source.
fn PP_IFDEF_PASS(S): i64 {
    # Allocate a temp buffer via mmap to hold the source. This avoids copying
    # to S+0 (which overflows into heap state for programs >256KB — Bug #35).
    # The temp buffer is separate memory that the helpers can safely read from.
    #
    # mmap flags differ between Linux and macOS:
    #   Linux: MAP_PRIVATE(2) | MAP_ANONYMOUS(0x20) = 0x22 = 34
    #   macOS: MAP_PRIVATE(2) | MAP_ANON(0x1000)    = 0x1002
    # We try Linux flags first (runs fine on Linux host), fall back to
    # macOS flags if the kernel rejects them (EINVAL on macOS — BSD raw
    # SVC returns -errno now that ESYSCALL emits `csneg x0, x0, x0, cc`).
    var prot = 3;     # PROT_READ | PROT_WRITE
    # v5.11.33: tmp buffer sized to match the new 8 MB preprocess_out
    # cap (was 2 MB at 0x44A000 before the relocation).
    var tmp = syscall(9, 0, 25165824, prot, 34, 0 - 1, 0);
    if (tmp < 0) {
        tmp = syscall(9, 0, 25165824, prot, 0x1002, 0 - 1, 0);
    }
    # v4.8.4-alpha3: fixpoint loop so nested includes in files expanded
    # during this pass (e.g. registry.cyr → hashmap.cyr → fnptr.cyr)
    # are themselves scanned for further includes. Without the loop only
    # one level of nesting was resolved, leaving literal `include "..."`
    # directives in the parser input. Loop terminates when a pass does
    # no include expansion (had_new_include==0); bounded at 16 iters
    # as a safety net against pathological depth.
    var iter = 0;
    var had_new_include = 1;
    while (had_new_include == 1) {
        if (iter >= 16) {
            syscall(SYS_WRITE, 2, "error: preprocessor include nesting exceeded 16 levels\n", 55);
            syscall(SYS_EXIT, 1);
        }
        had_new_include = 0;
        var bl = GBL(S);
        # Copy the preprocessed source to the temp buffer
        var ci = 0;
        while (ci < bl) { store8(tmp + ci, load8(S + 0x459D000 + ci)); ci = ci + 1; }
        # Redirect S-based reads to the temp buffer by copying back to S+0
        # for helpers (PP_DEFINE, PP_DEFINED, PP_EVAL_IF, PP_DERIVE_*,
        # PP_SKIPLINE) that take `S` as a base pointer and touch other
        # regions of S too (e.g. `S+0x190800` for the #ifdef flag table).
        # The safe upper bound is 1048576 — input_buf ends at 0x100000 and
        # compiler state starts at 0x18C100. v4.8.4 capped at 262144 which
        # made ISINCLUDE / ISDEFINE / etc. blind to directives past the
        # 256 KB mark whenever `bl > 1048576` (bote 2.5.0 tripped exactly
        # this on ~525 KB preprocessed source — `lib/assert.cyr:3`
        # directive at offset ~525000 slipped through unexpanded).
        # Directive DETECTION (IS*) now reads from `tmp` directly so it
        # sees the full buffer regardless of where directives land.
        var cap = bl;
        if (cap > 1048576) { cap = 1048576; }
        ci = 0;
        while (ci < cap) { store8(S + _SRCB + ci, load8(tmp + ci)); ci = ci + 1; }
        var out = S + 0x459D000;
        var op = 0;
        var ip = 0;
        var bol = 1;
        var skip_depth = 0;
        # v5.6.1: shared state stack with PP_PASS (see there for state
        # machine). Both passes must agree on the encoding since the same
        # pp_depth / skip_depth invariant holds; we RESET the stack at the
        # top of each pass rather than carry state across, because each
        # pass walks the full source independently.
        var pp_depth = 0;
        # v5.8.40 — string-literal awareness mirroring PP_PASS;
        # see there for the state-machine rationale. The fixpoint
        # loop scans expanded source again with its own ISINCLUDE
        # check, so the same string-literal blindness applies and
        # gets the same in_string + escape_next gate.
        # v5.9.34 — `in_comment` added (vyakarana 1.0.2 fix).
        var in_string = 0;
        var escape_next = 0;
        var in_comment = 0;
        while (ip < bl) {
            var c = load8(tmp + ip);
            var handled = 0;
            # `dip` lets `#`-prefixed directives tolerate leading
            # whitespace — see PP_PASS for the rationale. v5.8.40 —
            # also gated on `in_string == 0`.
            var dip = PP_SKIP_WS(tmp, ip, bl);
            if (bol == 1 && in_string == 0) {
                # v6.5.0 Phase 1 — remember which file we are copying FROM, so a nested
                # include below can emit a correct RESUME marker. This only OBSERVES the
                # marker; it is still copied through verbatim by the default path, so the
                # emitted stream is unchanged by this branch.
                if (load8(tmp + dip) == 35) {
                    if (load8(tmp + dip + 1) == 64) { _pp_note_marker(tmp, dip, bl); }
                }
                if (ISDEFINE(tmp, dip, bl) == 1) {
                    if (skip_depth == 0) { PP_DEFINE(S, tmp, dip + 8); }
                    ip = PP_SKIPLINE(tmp, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                }
                if (handled == 0) { if (ISIFDEF(tmp, dip, bl) == 1) {
                        var _s = 3;
                        if (skip_depth == 0) {
                            if (PP_DEFINED(S, tmp, dip + 7) == 1) { _s = 0; }
                            else { _s = 1; }
                        }
                        store8(S + 0x197F10 + pp_depth, _s);
                        pp_depth = pp_depth + 1;
                        if (_s != 0) { skip_depth = skip_depth + 1; }
                        ip = PP_SKIPLINE(tmp, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                    } }
                if (handled == 0) { if (ISIFNDEF(tmp, dip, bl) == 1) {
                        var _s = 3;
                        if (skip_depth == 0) {
                            if (PP_DEFINED(S, tmp, dip + 8) == 0) { _s = 0; }
                            else { _s = 1; }
                        }
                        store8(S + 0x197F10 + pp_depth, _s);
                        pp_depth = pp_depth + 1;
                        if (_s != 0) { skip_depth = skip_depth + 1; }
                        ip = PP_SKIPLINE(tmp, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                    } }
                if (handled == 0) { if (ISIF(tmp, dip, bl) == 1) {
                        var _s = 3;
                        if (skip_depth == 0) {
                            if (PP_EVAL_IF(S, tmp, dip + 4) == 1) { _s = 0; }
                            else { _s = 1; }
                        }
                        store8(S + 0x197F10 + pp_depth, _s);
                        pp_depth = pp_depth + 1;
                        if (_s != 0) { skip_depth = skip_depth + 1; }
                        ip = PP_SKIPLINE(tmp, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                    } }
                if (handled == 0) { if (ISELSE(tmp, dip, bl) == 1) {
                        if (pp_depth > 0) {
                            var _s = load8(S + 0x197F10 + pp_depth - 1);
                            if (_s == 0) { store8(S + 0x197F10 + pp_depth - 1, 2); skip_depth = skip_depth + 1; }
                            elif (_s == 1) { store8(S + 0x197F10 + pp_depth - 1, 0); skip_depth = skip_depth - 1; }
                        }
                        ip = PP_SKIPLINE(tmp, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                    } }
                if (handled == 0) { if (ISELIF(tmp, dip, bl) == 1) {
                        if (pp_depth > 0) {
                            var _s = load8(S + 0x197F10 + pp_depth - 1);
                            if (_s == 0) { store8(S + 0x197F10 + pp_depth - 1, 2); skip_depth = skip_depth + 1; }
                            elif (_s == 1) {
                                if (PP_EVAL_IF(S, tmp, dip + 6) == 1) {
                                    store8(S + 0x197F10 + pp_depth - 1, 0);
                                    skip_depth = skip_depth - 1;
                                }
                            }
                        }
                        ip = PP_SKIPLINE(tmp, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                    } }
                if (handled == 0) { if (ISENDIF(tmp, dip, bl) == 1) {
                        if (pp_depth > 0) {
                            var _s = load8(S + 0x197F10 + pp_depth - 1);
                            if (_s != 0) { skip_depth = skip_depth - 1; }
                            pp_depth = pp_depth - 1;
                        }
                        ip = PP_SKIPLINE(tmp, ip, bl); store8(out + op, 10); op = op + 1; bol = 1; handled = 1;
                    } }
                # v6.5.20 — line-exact, no marker; see the PP_PASS twin. This is the pass
                # that sees derives inside INCLUDED files, which is where all 93 of
                # agnosai's live (kavach alone turned 3 source lines into 112).
                if (handled == 0) { if (skip_depth == 0) { if (ISDERIVE(tmp, dip, bl) == 1) {
                            ip = PP_DERIVE_SERIALIZE(S, tmp, dip, bl, out, op);
                            op = load64(S + 0x197008);
                            bol = 1; handled = 1;
                        } } }
                if (handled == 0) { if (skip_depth == 0) { if (ISDERIVE_DE(tmp, dip, bl) == 1) {
                            ip = PP_DERIVE_DESER(S, tmp, dip, bl, out, op);
                            op = load64(S + 0x197008);
                            bol = 1; handled = 1;
                        } } }
                if (handled == 0) { if (skip_depth == 0) { if (ISDERIVE_ACC(tmp, dip, bl) == 1) {
                            ip = PP_DERIVE_ACCESSORS(S, tmp, dip, bl, out, op);
                            op = load64(S + 0x197008);
                            bol = 1; handled = 1;
                        } } }
                if (handled == 0) { if (skip_depth == 0) { if (ISINCLUDE(tmp, ip, bl) == 1) {
                            ip = ip + 8;
                            if (load8(tmp + ip) == 34) {
                                ip = ip + 1;
                                var fname = S + 0x190400;
                                var fi = 0;
                                var fgo = 1;
                                while (fgo == 1) {
                                    if (ip >= bl) { fgo = 0; }
                                    if (fgo == 1) {
                                        var fc = load8(tmp + ip);
                                        if (fc == 34) { ip = ip + 1; fgo = 0; }
                                        else { if (fi >= 767) { PP_FNAME_TOO_LONG(); } store8(fname + fi, fc); fi = fi + 1; ip = ip + 1; }
                                    }
                                }
                                store8(fname + fi, 0);
                                var sgo = 1;
                                while (sgo == 1) {
                                    if (ip >= bl) { sgo = 0; }
                                    if (sgo == 1) { if (load8(tmp + ip) == 10) { ip = ip + 1; sgo = 0; } else { ip = ip + 1; } }
                                }
                                if (PP_ALREADY_INCLUDED(S, fname) == 0) {
                                    PP_MARK_INCLUDED(S, fname);
                                    op = PP_FMARK(S, out, op, fname, 1);
                                    var nr = READFILE(fname, out + op, 25165824 - op);
                                    if (nr < 0) {
                                        syscall(SYS_WRITE, 2, "error: cannot open include file: ", 33);
                                        var _ifl = 0;
                                        while (load8(fname + _ifl) != 0) { _ifl = _ifl + 1; }
                                        syscall(SYS_WRITE, 2, fname, _ifl);
                                        syscall(SYS_WRITE, 2, "\n", 1);
                                        syscall(SYS_EXIT, 1);
                                    }
                                    op = op + nr;
                                    # v6.5.0 Phase 1 — RESUME marker (see PP_PASS). This
                                    # pass expands the NESTED includes, so the file being
                                    # resumed is whichever `#@file` was last seen in the
                                    # INPUT stream, tracked in `_pp_curfile` as this pass
                                    # copies markers through. Falls back to "<source>"
                                    # when no marker has been seen yet.
                                    op = PP_REANCHOR_CUR(S, out, op, tmp, ip);
                                    had_new_include = 1;
                                } else {
                                    # v6.5.3 — see the PP_PASS skip path: an include-once
                                    # SKIP still consumes its directive line, so re-anchor.
                                    op = PP_REANCHOR_CUR(S, out, op, tmp, ip);
                                }
                            }
                            bol = 1; handled = 1;
                        } } }
            }
            if (handled == 0) {
                if (skip_depth == 0) { store8(out + op, c); op = op + 1; }
                # v6.5.19 — keep a skipped line's newline; see the PP_PASS twin.
                elif (c == 10) { store8(out + op, 10); op = op + 1; }
                # v5.8.40 — string-literal state machine; mirrors
                # PP_PASS. See PP_PASS for the rationale.
                # v5.9.34 — comment-aware + reset on newline.
                # See PP_PASS state-machine site for the full
                # vyakarana 1.0.2 root-cause writeup.
                if (in_comment == 1) {
                    if (c == 10) { in_comment = 0; bol = 1; }
                    else { bol = 0; }
                    ip = ip + 1;
                } else {
                    if (escape_next == 1) {
                        escape_next = 0;
                    } else {
                        if (in_string == 0) {
                            if (c == 35)      { in_comment = 1; }
                            elif (c == 34)    { in_string = 1; }
                        } else {
                            if (c == 92)      { escape_next = 1; }
                            elif (c == 34)    { in_string = 0; }
                        }
                    }
                    ip = ip + 1;
                    if (c == 10) {
                        bol = 1;
                        in_string = 0;
                        escape_next = 0;
                        in_comment = 0;
                    } else {
                        bol = 0;
                    }
                }
            }
        }
        # Size guard on the fixpoint output. v4.8.4 added the original
        # 1 MB cap after bote reported silent overrun → downstream
        # corruption (`lib/assert.cyr:3: expected '=', got string`).
        # v5.6.40 doubled to 2 MB when patra 1.8.3 + stdlib crossed
        # 1 MB. v5.11.33 raised to 8 MB after sit v0.7.6 hit 2,099,593
        # bytes (2,441 over the 2 MB cap) on a stock sandhi-folded
        # [deps].stdlib — the cap was sized pre-sandhi-fold and didn't
        # grow with the canonical service-boundary consumer shape.
        # See CHANGELOG [5.11.33].
        if (op > 25165824) {
            syscall(SYS_WRITE, 2, "error: expanded source exceeds 24MB (", 37);
            PRNUM(op);
            syscall(SYS_WRITE, 2, " bytes) in PP_IFDEF_PASS iter=", 30);
            PRNUM(iter);
            syscall(SYS_WRITE, 2, "\n", 1);
            syscall(SYS_EXIT, 1);
        }
        SBL(S, op);
        iter = iter + 1;
    }
    # No copy-back. Output stays at S+0x459D000. LEX reads from there.
    # Free the temp buffer.
    syscall(11, tmp, 25165824);
    return 0;
}

# Pre-pass: expand #ref directives in raw input (S+0) into S+0x459D000, copy back
fn PP_REF_PASS(S): i64 {
    var bl = GBL(S);
    var out = S + 0x459D000;
    var op = 0;
    var ip = 0;
    var found = 0;
    var bol = 1;
    while (ip < bl) {
        var _refc = load8(S + _SRCB + ip);
        if (bol == 1) {
            if (ISREF(S + _SRCB, ip, bl) == 1) {
                ip = ip + 5;
                if (load8(S + _SRCB + ip) == 34) {
                    ip = ip + 1;
                    var rfn = S + 0x190400;
                    var rfi = 0;
                    while (ip < bl) {
                        var rc = load8(S + _SRCB + ip);
                        if (rc == 34) { ip = ip + 1; break; }
                        if (rfi >= 767) { PP_FNAME_TOO_LONG(); }
                        store8(rfn + rfi, rc); rfi = rfi + 1; ip = ip + 1;
                    }
                    store8(rfn + rfi, 0);
                    while (ip < bl) { if (load8(S + _SRCB + ip) == 10) { ip = ip + 1; break; } ip = ip + 1; }
                    var rnr = READFILE(rfn, S + 0x191800, 16384);
                    if (rnr < 0) {
                        syscall(SYS_WRITE, 2, "error: cannot open #ref file: ", 30);
                        var _rfl = 0;
                        while (load8(rfn + _rfl) != 0) { _rfl = _rfl + 1; }
                        syscall(SYS_WRITE, 2, rfn, _rfl);
                        syscall(SYS_WRITE, 2, "\n", 1);
                        syscall(SYS_EXIT, 1);
                    }
                    # Inline: emit var declarations for each key-value line
                    var ri = 0;
                    while (ri < rnr) {
                        var rch = load8(S + 0x191800 + ri);
                        if (rch <= 32) { ri = ri + 1; }
                        elif (rch == 35) { while (ri < rnr) { if (load8(S + 0x191800 + ri) == 10) { break; } ri = ri + 1; } }
                        elif (rch == 91) { while (ri < rnr) { if (load8(S + 0x191800 + ri) == 10) { break; } ri = ri + 1; } }
                        elif (rch >= 65) {
                            store8(out + op, 118); store8(out + op + 1, 97);
                            store8(out + op + 2, 114); store8(out + op + 3, 32); op = op + 4;
                            while (ri < rnr) {
                                rch = load8(S + 0x191800 + ri);
                                if (rch == 10) { ri = ri + 1; break; }
                                store8(out + op, rch); op = op + 1; ri = ri + 1;
                            }
                            while (load8(out + op - 1) == 32) { op = op - 1; }
                            store8(out + op, 59); store8(out + op + 1, 10); op = op + 2;
                        }
                        else { ri = ri + 1; }
                    }
                    found = 1;
                    bol = 1;
                }
            } else {
                store8(out + op, _refc);
                op = op + 1; ip = ip + 1;
                if (_refc == 10) { bol = 1; } else { bol = 0; }
            }
        } else {
            store8(out + op, _refc);
            op = op + 1; ip = ip + 1;
            if (_refc == 10) { bol = 1; } else { bol = 0; }
        }
    }
    # ⛔ v6.5.39 — BOUND THE COPY-BACK. This was `while (ci < op)` with NO cap anywhere in
    # PP_REF_PASS: unlike its two sibling passes it never checked `op` against the arena size,
    # so a `#ref` expansion larger than the buffer wrote past `preprocess_out` into whatever
    # followed it, and then copied the same overrun into `_SRCB`. It mattered less while the
    # cap was 8 MB and _SRCB was the 16 MB region directly above (the overflow landed in the
    # buffer it was copying to anyway); with preprocess_out grown to 24 MB the region above it
    # is `fn_local_names`, so the same overrun would corrupt the per-fn local tables instead.
    # Raising the ceiling without this would have converted a contained bug into a live one.
    if (op > 25165824) {
        syscall(SYS_WRITE, 2, "error: #ref expansion exceeds 24MB (", 36);
        PRNUM(op);
        syscall(SYS_WRITE, 2, " bytes)\n", 8);
        syscall(SYS_EXIT, 1);
    }
    if (found == 1) {
        var ci = 0;
        while (ci < op) { store8(S + _SRCB + ci, load8(out + ci)); ci = ci + 1; }
        SBL(S, op);
    }
    return 0;
}

# v6.5.7: read the `#@incdir <dir>` marker off line 1 of the raw source.
#
# ONLY at byte 0. `cyrius build` writes the marker as the very first bytes of the
# materialised temp file, ahead of the dep-include prepend, so the CLI's value is
# the one that lands there; a second marker further down the file — the shape a
# hostile include would use — is past byte 0 and stays an ordinary comment. That
# positional rule is what keeps the trusted value trusted.
#
# Rejects are SILENT and simply leave the marker unset, so a bad value costs the
# same as no value: the include fails where it already fails today, with the
# existing "cannot open include file" error naming the path. See the _pp_incdir
# comment in common/util.cyr for why relative-and-`..`-free is the whole guard.
fn PP_SCAN_INCDIR(S): i64 {
    _pp_incdir_len = 0;
    if (GBL(S) < 10) { return 0; }
    if (load8(S + _SRCB) != 35) { return 0; }        # '#'
    if (load8(S + _SRCB + 1) != 64) { return 0; }    # '@'
    if (load8(S + _SRCB + 2) != 105) { return 0; }   # 'i'
    if (load8(S + _SRCB + 3) != 110) { return 0; }   # 'n'
    if (load8(S + _SRCB + 4) != 99) { return 0; }    # 'c'
    if (load8(S + _SRCB + 5) != 100) { return 0; }   # 'd'
    if (load8(S + _SRCB + 6) != 105) { return 0; }   # 'i'
    if (load8(S + _SRCB + 7) != 114) { return 0; }   # 'r'
    if (load8(S + _SRCB + 8) != 32) { return 0; }    # ' '
    var p = 9;
    var n = 0;
    while (p < GBL(S)) {
        var c = load8(S + _SRCB + p);
        if (c == 10) { break; }
        if (c == 13) { break; }
        if (n >= 480) { return 0; }          # over-long → unset, not truncated
        store8(&_pp_incdir + n, c);
        n = n + 1;
        p = p + 1;
    }
    while (n > 0) {                          # strip trailing spaces / separators
        var t = load8(&_pp_incdir + n - 1);
        if (t != 32 && t != 47 && t != 92) { break; }
        n = n - 1;
    }
    if (n == 0) { return 0; }
    # ⛔ THE GUARD (see common/util.cyr). Absolute → CVE-16 bypass; `..` → CVE-02
    # bypass. Either one makes the marker a read-anything primitive, so both are
    # refused outright rather than sanitised.
    if (load8(&_pp_incdir) == 47) { return 0; }    # '/' — POSIX absolute
    if (load8(&_pp_incdir) == 92) { return 0; }    # '\' — UNC / rooted on Windows
    if (n > 1) { if (load8(&_pp_incdir + 1) == 58) { return 0; } }   # 'X:' drive
    var i = 0;
    while (i < n) {
        if (load8(&_pp_incdir + i) == 46) {
            if (load8(&_pp_incdir + i + 1) == 46) {
                if (i == 0) { return 0; }
                if (load8(&_pp_incdir + i - 1) == 47) { return 0; }
                if (load8(&_pp_incdir + i - 1) == 92) { return 0; }
            }
        }
        i = i + 1;
    }
    store8(&_pp_incdir + n, 0);
    _pp_incdir_len = n;
    return 0;
}

fn PREPROCESS(S): i64 {
    # v6.5.7: before any include is resolved — READFILE consults _pp_incdir.
    PP_SCAN_INCDIR(S);
    # Pre-pass: expand #ref directives (TOML → var declarations)
    PP_REF_PASS(S);
    PP_PASS(S);
    # Pass 2: evaluate #ifdef/#define in included content
    PP_IFDEF_PASS(S);
    # Final pass: expand macros with args
    PP_MACRO_PASS(S);
    return 0;
}
