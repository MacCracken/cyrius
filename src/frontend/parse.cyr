# PARSER + CODEGEN — recursive descent, direct emission
# ================================================================

# v4.8.4-alpha4: pending-flag for `#regalloc` → next `fn` definition.
# Token 109 sets this; PARSE_FN_DEF (and the DCE-stub path in main.cyr)
# consume it when they resolve `fi`, storing the flag into fn_regalloc
# at 0x14A000. Codegen attachment (callee-saved spill/restore driven by
# hot-local counting) lands in subsequent alphas — alpha4 only wires
# the metadata so the attribute survives into fn-level state.
var _regalloc_pending = 0;

# v5.6.3: pending-flag for `#must_use` → next `fn` definition. Lexer
# token 122 sets this; PARSE_FN_DEF consumes it when resolving `fi`,
# storing bit 0 into fn_flags at 0x17A000. Call-site discard detection
# is _must_use_warn, called from PARSE_STMT's expression-statement arms
# when a call is the whole statement (its result dropped).
var _must_use_pending = 0;
# v5.6.3: `@unsafe { ... }` block depth. Incremented on entry to an
# unsafe block; decremented on exit. A nested unsafe block (depth > 1
# at entry) emits an advisory warning. No runtime cost — the block
# body parses exactly like a plain `{ ... }`.
var _unsafe_depth = 0;

# v5.6.4: pending `#deprecated("msg")` → next `fn` definition. Lexer
# token 124 arms _deprecated_pending and the parser consumes the
# `(STR)` args, storing the string token value (offset<<32 | length
# into str_data at 0x21A000) in _deprecated_msg_pending. PARSE_FN_DEF
# transfers both into fn_flags[fi] bit 2 + fn_deprecated_msg[fi].
# Call-site check is `_callee_site_checks` (parse_fn.cyr) — every call path, at every
# call, not just statement-level discards (that's #must_use's job).
var _deprecated_pending = 0;
var _deprecated_msg_pending = 0;
# 6.6.16 — PASS 1's own copy of the pair: `_tl_deprecated(S, 0)` records, `_prescan_fn_sig`
# hands it to the fn it registers (`_prescan_dep_take`), so a call parsed BEFORE the
# definition sees the bit. Never the pass-2 pair: a flag carried across the pass boundary
# is the `_pub_pending` defect (see `_prescan_fn_sig`). CHANGELOG [6.6.16]
var _pre_dep_pending = 0;
var _pre_dep_msg = 0;

# v5.8.20: pending fn-attribute flags for the next `fn` definition.
# Lexer tokens 125 / 126 / 127 (#pure / #io / #alloc) set the
# corresponding `_X_pending`; PARSE_FN_DEF consumes them into
# fn_flags[fi] bits 3 / 4 / 5. Effect-checking happens at
# PARSE_FNCALL: when the current fn body is `#pure` (`_cur_fn_is_pure
# == 1`) and the callee has bit 4 (#io) or bit 5 (#alloc) set, emit
# a warning. Same warning shape as #must_use / #deprecated — easy
# downstream incremental adoption; --strict can escalate later.
var _pure_pending = 0;
var _io_pending = 0;
var _alloc_pending = 0;
# v6.2.27: #naked (token 128) — the next fn def is an interrupt-handler /
# naked fn: PARSE_FN_DEF emits NO prologue/epilogue/frame (skip EFNPRO /
# ESUBRSP+frame_patch / regalloc save-restore / EFNEPI). `_cur_fn_naked`
# mirrors it for the duration of the fn body (reset at fn end).
var _naked_pending = 0;
var _cur_fn_naked = 0;
# v6.5.63: #inline (token 163) — pending flag for the next fn definition, consumed by
# PARSE_FN_DEF. Opt-in admission to the inline-replay path. Deliberately NOT a flip of
# `_INLINE_OK`: general inlining does not compile the compiler today (it hits the 1023
# jump-target LASE cap in a single function), and its default-off note cites a size figure
# measured at v1.11.3. Per-fn opt-in has neither problem.
var _inline_pending = 0;
# v6.5.67 — does the cursor sit on a call to a PAIR-RETURNING fn (fn flag 256)?
#
# A `: stack` enum constructor hands back (tag, payload) in two registers. Binding that to one
# variable keeps the tag and silently drops the payload; v6.5.55 shipped the representation with
# nothing recording which calls produce a pair, so every lossy context was silent data loss.
#
# ⚠ DELIBERATELY LOOKAHEAD, NOT A GLOBAL "last expression was a pair" FLAG. This repo has paid
# for that shape four times — the `_cfo` re-arm bug was declared fixed three times before the
# fourth occurrence turned up in a path nobody had enumerated. A flag set by one emitter and read
# by another has to be cleared correctly on every path; a peek at the cursor cannot go stale.
# Same test at an ARBITRARY token index, for sites whose cursor has not reached the call yet
# (e.g. `var x = f();` where the cursor is on `=`).
# ⚠ NO propagation check here, deliberately. This variant feeds `_tpair` in `_PARSE_TERM_IMPL`,
# which is exactly what tells `?` it is looking at a PAIR and must take the two-register path.
# Suppressing it for a propagated call sends `?` down the BOXED lowering, which dereferences the
# tag as a pointer — measured: an immediate SIGSEGV. The propagation check belongs only in the
# cursor variant below, whose caller is the single-variable bind refusal.
# v6.6.0 — FORWARD-REFERENCE RESOLUTION FOR PAIR-RETURNING CALLEES.
#
# ⛔ WHY THIS EXISTS. Flag 256 ("returns a `(tag, payload)` pair") is set on an enum constructor
# in pass 1, but on an ORDINARY fn only while its own body is parsed — at its `return Ok(x)`.
# So a caller that appears EARLIER IN THE FILE than its callee saw the flag unset, and `?` took
# the BOXED lowering: it dereferenced the tag (0 or 1) as a pointer. Compiled clean, SIGSEGV at
# run time. That is not an exotic shape — it is how every flattened dist bundle is laid out, and
# how ordinary code reads when helpers are defined below their callers.
#
# The fix is one linear propagation pass over the token stream, run lazily on first demand (by
# which time pass 1 has registered every fn and flagged every `: stack` constructor). For each
# `fn NAME (...) { ... }` whose flag is unset, look for `return IDENT (` in its OWN body where
# IDENT is already flagged (since 6.6.16 also `return IDENT<..>(` and the method `return x.m(`,
# `_tok_ret_callee`). Repeat until nothing changes, bounded — a chain of forwarding
# wrappers needs one round per link.
#
# ⚠ CLOSURE BODIES AND NESTED fn BODIES ARE SKIPPED (`_skip_nested_body`). A closure defined
# inside the body has its own `return`, and counting it would flag the OUTER fn as
# pair-returning — over-flagging is worse than under-flagging here, because it routes a non-pair
# call into the two-register receive and reads a garbage rdx. A closure literal (`|x| { .. }`,
# `|| { .. }`) has NO `fn` token, so a skip keyed on `fn` alone booked its `return h(..)` to the
# enclosing fn: a false "bind both" refusal at every single-variable bind of that fn's result, and
# the mixed-return warning aimed at its own plain return. The closure's own pair-ness is
# unaffected — its fn entry is flagged while its body is parsed — and `_warn_mixed_pair_returns`
# judges a closure's returns as its OWN unit (`_warn_closure_block`). A named fn inside a body is
# REFUSED since 6.6.16 (`_refuse_nested_fn`), so no program that compiles has one; skipping it
# stays, as diagnostic hygiene for the refused program — `_warn_mixed_pair_returns` runs at the
# end of a parse that has errors, and without the skip a refused fn's `return h(x)` would put a
# bogus mixed-return warning on the OUTER fn beside the refusal. CHANGELOG [6.6.16]
# ⚠ INVALIDATED whenever a `: stack` constructor is flagged (parse_types.cyr). The prescan is
# demand-driven, and the first demand can arrive BEFORE the enum declaration has been reached —
# measured: the pass ran with a complete 3,498-token stream and flagged nothing, because no
# constructor carried the flag yet for it to propagate FROM. Re-running on each new stack enum
# is cheap (enum declarations are few) and is what makes the propagation order-independent.
var _pair_prescan_done = 0;

# Token-stream skip helpers shared by the two pair scans (`_pair_prescan`,
# `_warn_mixed_pair_returns`). Separate small fns, not inline loops: cybs (the seed-built
# bootstrap compiler) fails SILENTLY on too many references in one fn.
#
# Does the `{` at token k open a CLOSURE body? Call only when TOKTYP(S, k) == 13. Closure grammar
# is `|` IDENT (`,` IDENT)* `|` or `||`, then the body — untyped params, no return annotation
# (parse_expr.cyr, the `typ == 35 || typ == 54` factor arm) — and `{` never begins an expression,
# so a `{` right after `|` (35) or `||` (54) can only be a closure block body, never `a | b` /
# `a || b`. ⚠ If closure params or a return type ever gain annotations, this must scan the param
# list instead. A brace-less closure (`|x| h(x)`) needs no skip: an expression holds no `return`.
fn _tok_is_closure_body(S, k): i64 {
    if (k < 1) { return 0; }
    var p = TOKTYP(S, k - 1);
    if (p == 35) { return 1; }
    if (p == 54) { return 1; }
    return 0;
}

# Index of the `}` that closes the first `{` at or after token k (n when the stream ends first).
fn _tok_skip_block(S, k, n): i64 {
    var d = 0;
    var started = 0;
    while (k < n) {
        var t = TOKTYP(S, k);
        if (t == 13) { d = d + 1; started = 1; }
        if (t == 14) {
            d = d - 1;
            if (d == 0) { if (started == 1) { return k; } }
        }
        k = k + 1;
    }
    return k;
}

# THE one skip of a nested unit, shared by both pair scans and by the nested-fn refusal: the
# index of the LAST token of the unit that starts at token k, or -1 when none starts there.
#   - a `{` that opens a closure body (`_tok_is_closure_body`): that brace's matching `}`;
#   - a `fn` keyword (a nested fn — refused, see `_refuse_nested_fn`; an `async` before it is
#     the caller's to step over): its header runs to the first `{` or `;` at paren depth 0, so
#     a bodiless `fn x(..);` ends at its `;` instead of swallowing the next block, and a body
#     ends at its matching `}`.
# Never past the EOF token (12, the stream's last): a truncated or unbalanced source ends there.
fn _skip_nested_body(S, k): i64 {
    var n = GTCNT(S);
    var t = TOKTYP(S, k);
    var e = 0 - 1;
    if (t == 13) {
        if (_tok_is_closure_body(S, k) == 1) { e = _tok_skip_block(S, k, n); }
    } elif (t == 32) {
        e = n;
        var pd = 0;
        var j = k + 1;
        while (j < n) {
            var u = TOKTYP(S, j);
            if (u == 12) { e = j; j = n; }
            elif (u == 10) { pd = pd + 1; }
            elif (u == 11) { pd = pd - 1; }
            elif (pd == 0 && u == 5) { e = j; j = n; }
            elif (pd == 0 && u == 13) { e = _tok_skip_block(S, j, n); j = n; }
            j = j + 1;
        }
    }
    if (e >= n) { e = n - 1; }
    return e;
}

# ⛔ 6.6.16 — THE CALL A TOKEN PASS SEES, for the pair question. The pair scans run on the token
# stream before (prescan) or after (warnings) the fns are parsed, so no local is registered for
# them: a callee is resolved from the tokens alone, in the three spellings the parser's own
# `_pair_callee_at` resolves — `name(`, `name<..>(` and the method `x.m(`. They recognised only
# `name(`, so a wrapper `return g<i32>(..)` / `return p.m(..)` defined after its caller was never
# flagged pair-returning (`w(..)?` then dereferenced the tag: rc 139), and `return g<i32>(..)`
# beside `return Ok(5)` was reported as a dropped tag.
# ⚠ THE TOKEN ANSWER MUST BE THE PARSER'S ANSWER, OR -1. A wrong fn is worse than none. The first
# cut typed a receiver from its lexically LAST `name: T` declaration, so (measured):
#   - `var p: Qt; if (c) { var p: Pt; } return p.div(d);` resolved `Pt_div` for a `Qt` receiver:
#     the wrapper was flagged pair-returning and a plain `var v = w(..);` of it was REFUSED;
#   - `var p = Pt { .. }` / `var p = mk(n)` (PARSE_VAR types both) read as untyped, so a forward
#     wrapper `return p.div(d)` was never flagged (`w(..)?` rc 139, `var v = w(..);` dropped the
#     payload in silence) and the wrapper, flagged once parsed, drew a false mixed-return warning.
# So the receiver is found BY SCOPE and typed as the parser types it (`_tok_name_sid`: an
# annotation, a `*T` param, an initializer, a generic's bound `: T`), a name typed by nothing a
# token pass can see falls back to the one `T_m` every struct agrees on
# (`_tok_method_any`), and -1 means unknown to every reader: a missed flag, never a false one, and
# never a warning (`_ret_is_variant`). CHANGELOG [6.6.16]
#
# The `(` of `name(` or `name<..>(` at token ti, else -1.
fn _pair_ret_open(S, ti): i64 {
    var nt = TOKTYP(S, ti + 1);
    if (nt == 10) { return ti + 1; }
    if (nt != 19) { return 0 - 1; }
    var e = _tok_targs_close(S, ti + 2);
    if (e < 0) { return 0 - 1; }
    if (TOKTYP(S, e + 1) != 10) { return 0 - 1; }
    return e + 1;
}
# The `>` (or the `>>` / `>>>` tail) closing the type-argument list that starts at token i, just
# past its `<`, or -1. The arguments are not resolved (none are bound this early), so the list is
# bounded by shape instead: it must close before any `;` `(` `)` `{` `}` or EOF — `return n < m;`
# must not reach a `> (` in a later statement.
fn _tok_targs_close(S, i): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 5 || t == 10 || t == 11 || t == 12 || t == 13 || t == 14) { return 0 - 1; }
        if (t == 19) { d = d + 1; }
        elif (t == 20) { d = d - 1; }
        elif (t == 39) { d = d - 2; }
        elif (t == 152) { d = d - 3; }
        if (d <= 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# The struct id the name `noff` holds at token k, in the top-level unit that starts at token a (its
# `fn` keyword; a closure's own `{` when no top-level fn encloses it). Found BY SCOPE, walking back
# from k: a block closed before k (its `}` .. `{`) is stepped over whole, so no declaration inside
# it is seen, and a closure body k sits in is left for the fn around it, whose locals it
# captures — PARSE_FIELD_LOAD's order, local then capture. The first declaration reached decides
# (`_tok_decl_sid`); with none, the global's (`_glob_name_sid`, `_recv_sid`'s global arm). 0 when
# untyped. (A closure's own params are untyped, so a receiver among them never compiles.)
fn _tok_name_sid(S, a, k, noff): i64 {
    var b = a;
    while (b < k) { if (TOKTYP(S, b) == 13) { break; } b = b + 1; }   # the body `{`: params lie before it
    var cd = 0;
    var i = k - 1;
    while (i > a) {
        var t = TOKTYP(S, i);
        if (t == 14) { cd = cd + 1; }
        elif (t == 13) { if (cd > 0) { cd = cd - 1; } }
        elif (cd == 0) {
            if (t == 2) {
                if (STREQ(S, TOKVAL(S, i), noff) == 1) {
                    var r = _tok_decl_sid(S, a, i, b);
                    if (r >= 0) { return r; }
                }
            }
        }
        i = i - 1;
    }
    var g = _glob_name_sid(S, noff);
    return g;
}
# What the name at token i is declared as: a struct id, 0 when untyped, -1 when the name there is not
# a declaration. A declaration is `var NAME`, or a param `(NAME` / `, NAME` in the header (before
# the body `{` at token b). A `: T` annotation types it — for a param also `: *T`, whose `*` the
# parameter loop skips (`_mark_ptr_param`); a `var p: *T` local is a plain pointer — and an untyped
# `var` takes its initializer's struct (`_tok_init_sid`). `a` is the unit's first token.
fn _tok_decl_sid(S, a, i, b): i64 {
    var pt = TOKTYP(S, i - 1);
    var d = 0;
    if (pt == 3) { d = 1; }
    elif (i < b) { if (pt == 10 || pt == 31) { d = 1; } }
    if (d == 0) { return 0 - 1; }
    var r = 0;
    var nt = TOKTYP(S, i + 1);
    if (nt == 49) {
        var at = i + 2;
        if (pt != 3) { if (TOKTYP(S, at) == 8) { at = at + 1; } }
        if (TOKTYP(S, at) == 2) { r = FINDSTRUCT(S, TOKVAL(S, at)); }
    }
    elif (pt == 3) { if (nt == 4) { r = _tok_init_sid(S, a, i, i + 2); } }
    return r;
}
# The struct an untyped `var x = ..` (its name at token i) takes from the initializer at token j, as
# PARSE_VAR infers it (`_lit_head`, `_var_rhs_call`): a literal `Name {` / `Name<..> {` (a generic
# struct's methods are its base's), or a call `f(..)` / `g<..>(..)`, not `f(..).field`, whose fn
# declares a struct return (GFRS) — for a generic's `: T`, the struct T is bound to at this call
# (`_tok_gen_ret_sid`). 0 otherwise.
fn _tok_init_sid(S, a, i, j): i64 {
    if (TOKTYP(S, j) != 2) { return 0; }
    var e = j;
    if (TOKTYP(S, j + 1) == 19) { e = _tok_targs_close(S, j + 2); }
    if (e < 0) { return 0; }
    var nt = TOKTYP(S, e + 1);
    var r = 0;
    if (nt == 13) { r = FINDSTRUCT(S, TOKVAL(S, j)); }
    elif (nt == 10) {
        if (TOKTYP(S, _call_close(S, e + 1) + 1) == 41) { return 0; }   # `f(..).field`: the field's value
        var fi = FINDFN(S, TOKVAL(S, j));
        if (fi < 0) { return 0; }
        var gen = GFTP(S, fi);
        if (e > j) { if (gen == 0) { return 0; } }   # `<` on a generic only
        r = GFRS(S, fi);
        if (r <= 0) { if (gen != 0) { r = _tok_gen_ret_sid(S, a, i, j, fi); } }
        if (r < 0) { r = 0; }
    }
    return r;
}
# Which type parameter (0 / 1) the generic fi returns as `: T`, or -1.
fn _gen_ret_tp(S, fi): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0 - 1; }
    var c = _tok_close_paren(S, o);
    if (c < 0) { return 0 - 1; }
    if (TOKTYP(S, c + 1) != 49) { return 0 - 1; }
    if (TOKTYP(S, c + 2) != 2) { return 0 - 1; }
    var rn = TOKVAL(S, c + 2) + 1;
    var tp = GFTP(S, fi);
    if ((tp & 0xFFFFFFFF) == rn) { return 0; }
    if (((tp >> 32) & 0xFFFFFFFF) == rn) { return 1; }
    return 0 - 1;
}
# The struct a generic's `: T` return is bound to at the call `g<..>(` / `g(` at token j (fi its
# base), as the call binds it: T's explicit argument when that is a plain struct name, else the
# WHOLE argument in T's parameter position (`_gen_infer_tp`) — a name, typed scanning back from
# token i (the declaration being typed, so an initializer never sees its own name), or a call of a
# struct-returning fn. 0 when the return is not a type parameter or binds no struct.
fn _tok_gen_ret_sid(S, a, i, j, fi): i64 {
    var w = _gen_ret_tp(S, fi);
    if (w < 0) { return 0; }
    var r = 0;
    if (TOKTYP(S, j + 1) == 19) {
        var k = j + 2;
        if (w == 1) { if (TOKTYP(S, k + 1) != 31) { return 0; } k = k + 2; }
        if (TOKTYP(S, k) != 2) { return 0; }
        var kt = TOKTYP(S, k + 1);
        if (kt != 20) { if (kt != 31) { return 0; } }   # a plain name, not `Box<..>`
        r = FINDSTRUCT(S, TOKVAL(S, k));
        if (r > 0) { if (GSTP(S, r - 1) != 0) { r = 0; } }
        return r;
    }
    var m = GFGM(S, fi);
    var pk = w + 1;
    if ((m & 4) != 0) { pk = (m >> (8 + w * 8)) & 255; }
    if (pk == 0) { return 0; }
    var at = _call_arg_start(S, j + 1, pk - 1);
    if (at < 0) { return 0; }
    if (TOKTYP(S, at) != 2) { return 0; }
    var nt = TOKTYP(S, at + 1);
    if (nt == 31 || nt == 11) { r = _tok_name_sid(S, a, i, TOKVAL(S, at)); }
    elif (nt == 10) { if (_call_is_whole_arg(S, at) == 1) { r = _tok_init_sid(S, a, i, at); } }
    return r;
}
# A method `x.m(` whose single-name receiver the tokens do not type — a generic fn's `p: T` param,
# bound per instance — still has ONE answer when every struct's `T_m` agrees on the pair flag: the
# receiver's struct, whichever it is, must define `T_m` or the call does not compile. That fn (the
# first), or -1 when no struct defines `_m` or two of them disagree.
fn _tok_method_any(S, mnoff): i64 {
    var sc = GSTC(S);
    var r = 0 - 1;
    var i = 0;
    while (i < sc) {
        var f = FINDFN(S, BUILD_METHOD_NAME(S, i, mnoff));
        if (f >= 0) {
            if (r < 0) { r = f; }
            elif ((GFLG(S, f) & 256) != (GFLG(S, r) & 256)) { return 0 - 1; }
        }
        i = i + 1;
    }
    return r;
}
# The fn the call at token t reaches — `name(`, `name<..>(`, or `x.m(` with x resolved at t in the
# unit starting at token a (`_tok_name_sid`; its `T_m`, else `_tok_method_any`) — or -1.
fn _tok_ret_callee(S, a, t): i64 {
    if (TOKTYP(S, t) != 2) { return 0 - 1; }
    var o = _pair_ret_open(S, t);
    if (o >= 0) {
        var fi = FINDFN(S, TOKVAL(S, t));
        if (o > t + 1) { if (fi >= 0) { if (GFTP(S, fi) == 0) { fi = 0 - 1; } } }   # `<` on a generic only
        return fi;
    }
    if (_tok_method_open(S, t) == 0) { return 0 - 1; }
    if (t > 0) { if (TOKTYP(S, t - 1) == 41) { return 0 - 1; } }   # `a.x.m(`: not a single name
    var sid = _tok_name_sid(S, a, t, TOKVAL(S, t));
    var mf = 0 - 1;
    if (sid > 0) { mf = _meth_fn_at(S, sid, TOKVAL(S, t + 2), t + 2); }
    else { mf = _tok_method_any(S, TOKVAL(S, t + 2)); }
    return mf;
}

fn _pair_prescan(S): i64 {
    var n = GTCNT(S);
    var round = 0;
    while (round < 6) {
        var changed = 0;
        var d = 0;
        var i = 0;
        while (i < n) {
            var t0 = TOKTYP(S, i);
            if (t0 == 13) { d = d + 1; }
            elif (t0 == 14) { d = d - 1; }
            elif (t0 == 32) {
                # Only TOP-LEVEL definitions. Depth > 0 is a nested/closure fn or an `impl`
                # method (whose registered name is mangled), and registering a bare name for
                # either would mint a spurious fn-table entry.
                if (d == 0) {
                    if (TOKTYP(S, i + 1) == 2) {
                        # ⛔ THIS PASS MUST NEVER REGISTER A FN, and an earlier cut of it did.
                        # `REGFN` here mints a fn-table entry that no definition ever fills in
                        # (a fn defined AFTER a top-level expression statement is registered by a
                        # different path), and the undefined-call check then reports it: bayan's
                        # zero-warning CI gate went red with 17 `undefined function` warnings for
                        # helpers that were defined right there in the file. Measured: 17 with the
                        # REGFN, 0 without, and every axis of the lossy-context gate — including
                        # the forward-reference ones this pass exists for — passes without it.
                        # The registration was never what made forward references work; the
                        # invalidation on each new `: stack` ctor is. Skip what is not registered:
                        # a fn nothing has referenced yet cannot be the subject of a pending query.
                        var pnoff = TOKVAL(S, i + 1);
                        var pfi = FINDFN(S, pnoff);
                        if (pfi >= 0) {
                            if ((GFLG(S, pfi) & 256) == 0) {
                                var j = i + 2;
                                var lim = i + 512;
                                while (j < n) {
                                    if (TOKTYP(S, j) == 13) { break; }
                                    if (TOKTYP(S, j) == 5) { break; }   # `;` — declaration only
                                    if (j > lim) { break; }
                                    j = j + 1;
                                }
                                if (j < n) {
                                    if (TOKTYP(S, j) == 13) {
                                        var bd = 0;
                                        var k = j;
                                        var go = 1;
                                        while (go == 1) {
                                            if (k >= n) { go = 0; }
                                            else {
                                                var t = TOKTYP(S, k);
                                                if (t == 13) {
                                                    # a closure body — its returns are its own
                                                    var sk = _skip_nested_body(S, k);
                                                    if (sk >= 0) { k = sk; } else { bd = bd + 1; }
                                                }
                                                elif (t == 14) {
                                                    bd = bd - 1;
                                                    if (bd == 0) { go = 0; }
                                                }
                                                elif (t == 32) { k = _skip_nested_body(S, k); }   # a refused nested fn (header)
                                                elif (t == 33) {                  # `return`
                                                    # `return f(`, `return g<..>(`, `return x.m(` (6.6.16)
                                                    var rf = _tok_ret_callee(S, i, k + 1);
                                                    if (rf >= 0) {
                                                        if ((GFLG(S, rf) & 256) != 0) {
                                                            SFLG(S, pfi, GFLG(S, pfi) | 256);
                                                            changed = 1;
                                                            go = 0;
                                                        }
                                                    }
                                                }
                                                if (go == 1) { k = k + 1; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        if (changed == 0) { round = 6; } else { round = round + 1; }
    }
    return 0;
}

# v6.6.0 — MIXED RETURNS IN A PAIR-RETURNING FN. The class that cost 19 silent defects in one
# stdlib during this release's own migration, and the one the compiler is the only thing that can
# see.
#
# ⛔ THE SHAPE. The pre-flip error-propagation idiom is:
#       var res = f();
#       if (is_err_result(res) == 1) { return res; }     # forwards the boxed Err
# Migrated mechanically it becomes `var res_tag, res = f(); if (is_err_result(res_tag) == 1) {
# return res; }` — and `res` is now the PAYLOAD ALONE. The tag is dropped, so the caller receives
# the error VALUE as its tag: measured, a propagated `Err(77)` arrives as tag=77, is_err=0.
# **An error that reads as success** — the v6.5.15 class, one level up, in the one code path whose
# entire job is to refuse. The correct form is `return Err(res);`.
#
# Neither half is a type error: `return res;` and `return Err(res);` are both `return <i64>;`, so
# nothing else in the compiler can distinguish them. What CAN be said is structural: **a fn that
# returns a pair on one path and a single value on another cannot be consumed correctly**, because
# its caller must either destructure (and read garbage on the single-value path) or bind one (and
# be refused). So every plain return in a pair-returning fn is reported.
#
# ⚠ A WARNING, not an error, and deliberately so: mixing was legal before the value form existed
# and the pattern may appear in code that is not a Result at all. It runs once, after parsing, so
# every fn has its final flag — the propagation pass above is order-dependent and a mid-parse
# verdict would be wrong for exactly the forward-reference case that motivated it.
#
# ⛔ READ THE CALLERS BEFORE ACTING ON IT — it reports a SHAPE, and the fix is at the callers as
# much as at the return. vani's `vani_drain` / `vani_drop` / `vani_state` returned `Err(code)` on
# the null guard and the RAW status on the live path, and were kept that way through vani 1.2.7 as
# a supposed false positive (callers `is_ok(f(x))` the guard, sign-test the status). It was a real
# defect: a two-value bind of the live path read the status as the TAG, so a device in state
# SETUP (1) read as Err. vani 1.2.8 returns a Result on every path (CHANGELOG [6.6.12]). Wrapping
# the raw path in `Ok(...)` ALONE had broken three of vani's tests in 1.2.4 because the tests
# pinned the raw value; those rows had to change with it. In yukti it was 19 real defects too.
var _mixed_warned = 0;

# Is the `return IDENT …` at token `t` a whole variant value (returns 0 = not plain) or a
# single value (1 = plain)? A variant value is a call of a pair constructor (fn flag 256),
# a call of a NULLARY stack-variant constructor (flag 512 — the tag IS the whole value),
# or a nullary variant named bare (`return None;` — the same tag, the same rax). Anything
# else — a wrapper, a local, a raw integer — is the dropped-tag class and stays plain.
# 6.6.9: the nullary cases used to be plain, so `return None();` beside `return Some(v);`
# was reported as a dropped tag and told to `return Err(x);`. CHANGELOG [6.6.9]
# 6.6.16: the call is resolved as `_tok_ret_callee` resolves it (`a` = the unit's first token),
# so `return g<i32>(..)` / `return p.m(..)` forwarding a pair is a whole variant, not a dropped
# tag, and the same spellings returning ONE value still warn. A method whose callee the tokens
# cannot resolve is UNKNOWN, and unknown is not plain: the parser may have typed that receiver and
# flagged this fn by it (PARSE_RETURN, `_pair_callee_at`), and the receiver's own NAME looked up as
# a fn — the old fallback — answered "plain" and warned on a wrapper's only return. CHANGELOG [6.6.16]
fn _ret_is_variant(S, a, t): i64 {
    var rf = _tok_ret_callee(S, a, t);
    var nt = 10;
    if (rf < 0) {
        if (_tok_method_open(S, t) == 1) { return 0; }
        rf = FINDFN(S, TOKVAL(S, t));
        nt = TOKTYP(S, t + 1);
    }
    if (rf < 0) { return 1; }
    var fl = GFLG(S, rf);
    if (nt == 10) {
        if ((fl & 256) != 0) { return 0; }
        if ((fl & 512) != 0) { return 0; }
    }
    if (nt == 5) { if ((fl & 512) != 0) { return 0; } }
    return 1;
}

# ⛔ 6.6.16 — A CLOSURE IS A FN FOR THIS RULE. The fn walk below skips a closure body, because
# its returns are not the enclosing fn's (H2). Skipping alone took away the only warning a
# GENUINELY mixed closure had: `|x| { if (x > 0) { return h(x); } return 0; }` built silent, and
# `var t, v = fncall1(g, 0)` on it read a stale rdx — the exact hazard this warning exists for.
# So every closure body is judged as its OWN unit, at any depth (top level, an unflagged fn, a
# nested closure): it is pair-returning when its own body — nested closures and fns skipped,
# each is its own unit — says `return f(..)` or `f(..)?` with f flagged 256 (f spelled `f(`,
# `f<..>(` or `x.f(`), the two things that flag a fn 256 while it is parsed; a plain return there
# is then reported. CHANGELOG [6.6.16]

# Is the call at token t (`f(`, `g<..>(`, `x.m(` — `_tok_ret_callee`, `a` the unit's first token)
# pair-returning (flag 256)? The test PARSE_RETURN and `?`'s `_tpair` apply while parsing
# (`_pair_callee_at`), read here with FINAL flags.
fn _tok_call_is_pair(S, a, t): i64 {
    if (t < 0) { return 0; }
    var rf = _tok_ret_callee(S, a, t);
    if (rf < 0) { return 0; }
    if ((GFLG(S, rf) & 256) == 0) { return 0; }
    return 1;
}

# The `<` opening the type-argument list whose closing `>` / `>>` / `>>>` is token e, or -1.
fn _tok_targs_open(S, e): i64 {
    var d = 0;
    while (e > 0) {
        var t = TOKTYP(S, e);
        if (t == 20) { d = d + 1; }
        elif (t == 39) { d = d + 2; }
        elif (t == 152) { d = d + 3; }
        elif (t == 19) { d = d - 1; if (d <= 0) { return e; } }
        elif (t == 5 || t == 10 || t == 11 || t == 13 || t == 14) { return 0 - 1; }
        e = e - 1;
    }
    return 0 - 1;
}

# Does the `?` at token q consume a pair (`f(..)?`, `g<..>(..)?`, `x.m(..)?` — the callee flagged
# 256)? Walks back to the `(` that matches the `)` before it, then to the call's first token.
# 6.6.16: a method or explicit generic call was never a pair here, as it was not in `_tpair`;
# both now are, so both are here. CHANGELOG [6.6.16]
fn _tok_q_is_pair(S, a, q): i64 {
    if (q < 1) { return 0; }
    if (TOKTYP(S, q - 1) != 11) { return 0; }
    var d = 0;
    var p = q - 1;
    while (p > 0) {
        var t = TOKTYP(S, p);
        if (t == 11) { d = d + 1; }
        elif (t == 10) {
            d = d - 1;
            if (d == 0) {
                var c = p - 1;
                var ct = TOKTYP(S, c);
                if (ct == 20 || ct == 39 || ct == 152) { c = _tok_targs_open(S, c) - 1; }
                elif (c >= 2) { if (TOKTYP(S, c - 1) == 41) { c = c - 2; } }
                var r = _tok_call_is_pair(S, a, c);
                return r;
            }
        }
        p = p - 1;
    }
    return 0;
}

# The mixed-return warning for a CLOSURE, at its plain `return` (token k). `encl` is the name
# offset of the top-level fn whose body holds the closure, or -1 (top level, an impl method).
fn _warn_closure_mixed_at(S, k, encl): i64 {
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head_at(S, k);
    syscall(SYS_WRITE, 2, ": a closure", 11);
    if (encl >= 0) {
        syscall(SYS_WRITE, 2, " in `", 5);
        PRSTR(S + 0xEC00000 + encl);
        syscall(SYS_WRITE, 2, "`", 1);
    }
    syscall(SYS_WRITE, 2, " returns a `: stack` pair on another path but a SINGLE value here — the tag is dropped, so the caller reads this value as its TAG. Return a variant of the same enum on this path: `Err(x)` for a Result, `None()` for an Option.\n", 228);
    return 0;
}

# Judge ONE closure body (the `{` at token k) as its own fn; warns at most once, at its first
# plain return. Names in it resolve in the unit starting at token `a` — the top-level fn that
# encloses the closure, whose locals it captures, else k itself. Returns the index of the body's
# closing `}`.
fn _warn_closure_block(S, k, n, encl, a): i64 {
    var e = _tok_skip_block(S, k, n);
    var pair = 0;
    var plain = 0 - 1;
    var j = k + 1;
    while (j < e) {
        var t = TOKTYP(S, j);
        if (t == 13 || t == 32) {                  # a nested closure or (refused) fn — its own unit
            var sk = _skip_nested_body(S, j);
            if (sk >= 0) { j = sk; }
        }
        elif (t == 124) { if (_tok_q_is_pair(S, a, j) == 1) { pair = 1; } }
        elif (t == 33) {
            var nt = TOKTYP(S, j + 1);
            if (_tok_call_is_pair(S, a, j + 1) == 1) { pair = 1; }
            elif (nt == 2) { if (_ret_is_variant(S, a, j + 1) == 1) { if (plain < 0) { plain = j; } } }
            elif (nt != 5) { if (plain < 0) { plain = j; } }
        }
        j = j + 1;
    }
    if (pair == 1) { if (plain >= 0) { _warn_closure_mixed_at(S, plain, encl); } }
    return e;
}

fn _warn_mixed_pair_returns(S): i64 {
    if (_mixed_warned == 1) { return 0; }
    _mixed_warned = 1;
    var n = GTCNT(S);
    var d = 0;
    var i = 0;
    var encl = 0 - 1;     # the top-level fn whose body the walk is in (for a closure's message)
    var ea = 0 - 1;       # ...and its `fn` token, where a closure's names resolve (captures)
    while (i < n) {
        var t0 = TOKTYP(S, i);
        if (t0 == 13) {
            # every closure body, at any depth, is its own unit (see `_warn_closure_block`)
            if (_tok_is_closure_body(S, i) == 1) {
                var ca = i;
                if (ea >= 0) { ca = ea; }
                _warn_closure_block(S, i, n, encl, ca);
            }
            d = d + 1;
        }
        elif (t0 == 14) { d = d - 1; if (d == 0) { encl = 0 - 1; ea = 0 - 1; } }
        elif (t0 == 5) { if (d == 0) { encl = 0 - 1; ea = 0 - 1; } }
        elif (t0 == 32) {
            if (d == 0) {
                if (TOKTYP(S, i + 1) == 2) {
                    encl = TOKVAL(S, i + 1);
                    ea = i;
                    var wfi = FINDFN(S, TOKVAL(S, i + 1));
                    if (wfi >= 0) {
                        if ((GFLG(S, wfi) & 256) != 0) {
                            var j = i + 2;
                            var lim = i + 512;
                            while (j < n) {
                                if (TOKTYP(S, j) == 13) { break; }
                                if (TOKTYP(S, j) == 5) { break; }
                                if (j > lim) { break; }
                                j = j + 1;
                            }
                            if (j < n) {
                                if (TOKTYP(S, j) == 13) {
                                    var bd = 0;
                                    var k = j;
                                    var go = 1;
                                    while (go == 1) {
                                        if (k >= n) { go = 0; }
                                        else {
                                            var t = TOKTYP(S, k);
                                            if (t == 13) {
                                                # a closure body — its own unit, judged by the outer walk
                                                var sk = _skip_nested_body(S, k);
                                                if (sk >= 0) { k = sk; } else { bd = bd + 1; }
                                            }
                                            elif (t == 14) {
                                                bd = bd - 1;
                                                if (bd == 0) { go = 0; }
                                            }
                                            elif (t == 32) { k = _skip_nested_body(S, k); }   # a refused nested fn (see `_pair_prescan`)
                                            elif (t == 33) {
                                                var plain = 1;
                                                if (TOKTYP(S, k + 1) == 5) { plain = 0; }
                                                if (TOKTYP(S, k + 1) == 2) {
                                                    plain = _ret_is_variant(S, i, k + 1);
                                                }
                                                if (plain == 1) {
                                                    syscall(SYS_WRITE, 2, "warning:", 8);
                                                    _err_head_at(S, k);
                                                    syscall(SYS_WRITE, 2, ": `", 3);
                                                    PRSTR(S + 0xEC00000 + TOKVAL(S, i + 1));
                                                    syscall(SYS_WRITE, 2, "` returns a `: stack` pair on another path but a SINGLE value here — the tag is dropped, so the caller reads this value as its TAG. Return a variant of the same enum on this path: `Err(x)` for a Result, `None()` for an Option.\n", 229);
                                                    go = 0;
                                                }
                                            }
                                            if (go == 1) { k = k + 1; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Run the propagation once, on first demand. Cheap on every call after the first.
fn _ensure_pair_flags(S): i64 {
    if (_pair_prescan_done == 1) { return 0; }
    _pair_prescan_done = 1;
    _pair_prescan(S);
    return 0;
}

# ⛔ 6.6.16 — THE ONE CALLEE RESOLVER FOR "DOES THIS CALL RETURN A PAIR". Every asker — `?`'s
# `_tpair`, the lossy-bind refusals (`var v = ..`, `x = ..`, store8/16/32/64), PARSE_RETURN's
# wrapper flag, the destructure — recognised only `name(`, so the explicit generic `g<i32>(..)`
# and the method `p.m(..)` (its `T_m`) fell through all of them: `var v = g<i32>(n, d)?;` and
# `var v = p.m(d)?;` took the BOXED `?` lowering and dereferenced the tag (rc 139), `var v =
# g<i32>(..);` / `x = p.m(..);` / `store64(&s, g<i32>(..))` kept the tag and dropped the payload
# in silence, `var a, b = g<i32>(..);` was "multi-value destructure needs a call", and `p.m(..)?;`
# was "expected ';'". The fn index of the call at token ti, or -1:
#   - `name(` / a resolvable `name<..>(` (`_gcall_open`): FINDFN's entry — the generic TEMPLATE,
#     the flag source the 6.6.12 statement form (`_stmt_explicit_generic`) reads;
#   - `x.m(` on a single name typed as a struct (`_recv_sid`, PARSE_FIELD_LOAD's order): `T_m`.
#     BUILD_METHOD_NAME writes only uncommitted scratch at GNPOS, so the peek is safe — the real
#     call path does the same.
# A receiver that is not one name (`a.b.m()`, `f().m()`, an untyped impl `self`) is typed by no
# call path; it stays -1, today's answer. CHANGELOG [6.6.16]
# ⛔ 6.6.17 (a7): a GENERIC's call answers for the INSTANCE it reaches (`_pair_gen_inst`), not the
# template — `fn w<T>(p: T, d) { return p.div(d); }` is a pair at T = Pt (`Pt_div` returns Ok/Err)
# and one value at T = Qt, and the template, whose flag no single answer fits, left `w(p, d)?` on
# the boxed lowering (rc 139). CHANGELOG [6.6.17]
fn _pair_callee_at(S, ti): i64 {
    if (_gcall_open(S, ti) >= 0) {
        var fi = _pair_gen_inst(S, ti);
        return fi;
    }
    if (_tok_method_open(S, ti) == 0) { return 0 - 1; }
    var sid = _recv_sid(S, TOKVAL(S, ti));
    if (sid <= 0) { return 0 - 1; }
    var mf = _meth_fn_at(S, sid, TOKVAL(S, ti + 2), ti + 2);
    return mf;
}
# The fn the call at token ti reaches (`_gen_resolve_call`: a generic's instance, instantiating it if
# needed, so its body — parsed with T bound — has set its own pair flag; else FINDFN's entry). A
# lookahead: the refusal state that resolver leaves for an emitting path is put back.
fn _pair_gen_inst(S, ti): i64 {
    var se = _grc_err;
    var sf = _grc_fi;
    var fi = _gen_resolve_call(S, ti);
    _grc_err = se;
    _grc_fi = sf;
    return fi;
}
# `IDENT . IDENT (` at token ti: a method call on a single name. 1 / 0.
fn _tok_method_open(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (TOKTYP(S, ti + 1) != 41) { return 0; }
    if (TOKTYP(S, ti + 2) != 2) { return 0; }
    if (TOKTYP(S, ti + 3) != 10) { return 0; }
    return 1;
}
# The struct id of a method call's single-name receiver, resolved in PARSE_FIELD_LOAD's order: a
# local decides by itself, then a closure's capture of a struct, then a global (`_diag_name_sid`:
# GVTYPE where GVPM marks a struct, else an inferred global's GVDSID). 0 when untyped.
fn _recv_sid(S, noff): i64 {
    if (GINFN(S) == 1) {
        if (FINDLOCAL(S, noff) < 0) {
            if (_CL_CAP_FIELD_IDX(S, noff) < 0 - 1) { return _cap_fld_sid; }
        }
    }
    var r = _diag_name_sid(S, noff);
    return r;
}
fn _callee_returns_pair_at(S, ti): i64 {
    var _cra = _pair_callee_at(S, ti);
    if (_cra < 0) { return 0; }
    _ensure_pair_flags(S);
    if ((GFLG(S, _cra) & 256) == 0) { return 0; }
    return 1;
}
# v6.6.0 — does a `?` immediately follow the call whose `(` is at token index `ti`? Scans the
# balanced parens and looks at the token after the closing one.
# ⛔ WITHOUT THIS, `var v = f()?;` is refused by the single-bind check below: the callee IS
# pair-returning, but `?` CONSUMES the pair — it propagates the Err half out of the enclosing
# function and yields the payload alone, so exactly one value reaches the binding. Refusing it
# would make the propagation operator unusable on the very type it exists for.
fn _call_is_propagated(S, ti): i64 {
    var _d = 0;
    var _i = ti;
    var _g = 0;
    while (_g < 4096) {
        var _t = TOKTYP(S, _i);
        if (_t == 12) { return 0; }                 # EOF
        if (_t == 10) { _d = _d + 1; }
        elif (_t == 11) {
            _d = _d - 1;
            if (_d == 0) { if (TOKTYP(S, _i + 1) == 124) { return 1; } return 0; }
        }
        _i = _i + 1;
        _g = _g + 1;
    }
    return 0;
}

# v6.6.0 — THE LOSSY-CONTEXT REFUSAL, at the cursor. v6.5.67 closed exactly ONE lossy shape,
# `var x = f();`, and that was enough while `: stack` was an opt-in nobody used. Flipping
# Result/Option/Either to the value form makes every OTHER single-value context live across the
# whole ecosystem, and two of them compiled clean and dropped the payload in silence:
#
#     x = f();                 # assignment to an existing variable
#     store64(&slot, f());     # storing a Result into a slot (an array of Results is this shape)
#
# Both are the v6.5.67 defect wearing a different statement, and `store64` is the one that
# matters most: it is how every "collection of Results" is written, and the payload it drops is
# the error code. Refused here rather than in a helper, for the same reason the bind-site check
# is: `_callee_returns_pair` also feeds `_tpair`, which is what tells `?` it holds a pair.
# ⭐ ANTI-VACUOUS BY CONSTRUCTION: the flag tested is set only on `: stack` constructors, so a
# BOXED Result — still the documented idiom at thousands of sites — is untouched.
fn _refuse_lossy_pair(S): i64 {
    if (_callee_returns_pair(S) == 0) { return 0; }
    if (_call_is_propagated(S, GTI(S) + 1) == 1) { return 0; }
    ERR_MSG(S, "a `: stack` enum returns two values — bind both: `var tag, val = f();`", 72);
    return 1;
}

fn _callee_returns_pair(S): i64 {
    var _crp = _callee_returns_pair_at(S, GTI(S));
    if (_crp == 0) { return 0; }
    # ⚠ NO propagation check here either — this feeds `_tpair` in `_PARSE_TERM_IMPL`, the flag
    # that tells `?` it is holding a pair. Both helpers answer "does this callee return a pair",
    # nothing more; whether a `?` then CONSUMES that pair is the binding site's question, and it
    # is asked there (parse_decl.cyr). Putting it in either helper silently routes `?` into the
    # boxed lowering, which dereferences the tag as a pointer.
    return 1;
}
# v6.5.65 — INLINE PARAM PROVENANCE. When the inline replay binds a value-form SIMD argument it
# COPIES 16/32 bytes from the caller's local into a fresh callee param slot, and the direct vector
# emitter then RELOADS that slot two instructions later. Measured at 6.5.64 that reload is a
# 16-byte store-to-load FORWARD, and forwards are what the critical path is made of — two per
# chain link, the only ones left after `.64`.
#
# These record "callee param slot P currently holds a verbatim copy of caller local C", so the
# emitter can read C directly and the forward disappears. Two entries is the whole capacity
# needed: the inline path admits at most 2 params (`pc > 2` is structural — SFINL packs two
# 32-bit name offsets in one 64-bit word).
#
# ⚠ INVALIDATED ON ANY STORE TO THE SLOT (see EFLSTORE / EFLSTORE_F64V2_PAIR /
# EFLSTORE_F64V4_PAIR). If the inlined body ever assigns to a param, the caller's local no longer
# holds the param's value and redirecting the read would silently return a stale vector. That
# invalidation is the correctness argument — not an assumption about what stdlib wrappers happen
# to do today.
var _prov_s0 = 0 - 1;
var _prov_c0 = 0 - 1;
var _prov_s1 = 0 - 1;
var _prov_c1 = 0 - 1;
# Clear a recorded provenance whose param slot is being written. Called from the local-store
# emitters; a plain integer compare on the hot path.
# v6.5.66 — the copy's CODE RANGE and whether anything actually READ the param slot. With the
# v6.5.65 redirect in place the copy is usually DEAD: nothing reads the slot, because the emitter
# reads the caller local instead. Recording [cp_start, cp_end) lets the replay NOP it out at the
# end, once it knows no read occurred.
#
# ⭐ AND THE DEAD COPY IS NOT MERELY WASTED BYTES — IT IS THE LAST DEPENDENCY. Its load clobbers
# xmm0 between a chain link's result store and the next link's read of it, which is precisely what
# stops the value staying in a register. Deleting the copy puts that store and load ADJACENT, so
# the v6.5.53 SLASE peephole removes the reload and the value becomes register-resident across the
# link. That is why eliminating the copies and achieving residency are ONE piece of work, not two.
var _prov_p0 = 0;
var _prov_e0 = 0;
var _prov_l0 = 0;
var _prov_d0 = 0;
var _prov_w0 = 0;
var _prov_p1 = 0;
var _prov_e1 = 0;
var _prov_l1 = 0;
var _prov_d1 = 0;
var _prov_w1 = 0;
# ⚠ THE DISPLACEMENT IS RECORDED, NOT RE-DERIVED FROM THE EMITTED BYTES. The first cut read it
# back at a fixed byte offset into the copy, which is correct for a 128-bit copy (one load + one
# store) and WRONG for a 256-bit one (TWO loads + TWO stores) — the offset landed inside the
# second load, so the liveness scan searched for the wrong slot and deleted a live copy. Caught by
# tests/tcyr/crossos/simd_param_then_scalar.tcyr's flat-body control.
# `nsl` is carried too because a 256-bit slot spans TWO displacements (d and d+16) and a reference
# to the HIGH half must keep the copy alive just as surely as one to the low half.
fn _prov_record(slot, src, cps, cpe, disp, nsl): i64 {
    if (_prov_s0 < 0) {
        _prov_s0 = slot; _prov_c0 = src; _prov_p0 = cps; _prov_e0 = cpe; _prov_l0 = 0;
        _prov_d0 = disp; _prov_w0 = nsl;
        return 0;
    }
    _prov_s1 = slot; _prov_c1 = src; _prov_p1 = cps; _prov_e1 = cpe; _prov_l1 = 0;
    _prov_d1 = disp; _prov_w1 = nsl;
    return 0;
}
fn _prov_reset(): i64 {
    _prov_s0 = 0 - 1; _prov_c0 = 0 - 1; _prov_p0 = 0; _prov_e0 = 0; _prov_l0 = 0; _prov_d0 = 0; _prov_w0 = 0;
    _prov_s1 = 0 - 1; _prov_c1 = 0 - 1; _prov_p1 = 0; _prov_e1 = 0; _prov_l1 = 0; _prov_d1 = 0; _prov_w1 = 0;
    return 0;
}
# Any DIRECT read of a param slot — a load, or taking its address — makes the copy live. The
# redirect never comes through here: it resolves to the CALLER's local index, so a redirected
# operand load marks the caller's slot (which has no provenance entry), not the param slot.
fn _prov_read(idx): i64 {
    if (_prov_s0 == idx) { _prov_l0 = 1; }
    if (_prov_s1 == idx) { _prov_l1 = 1; }
    return 0;
}
# NOP out any copy that was never read and never written. Called once, at the end of the inline
# replay, when the whole body has been emitted and the question is finally answerable.
#
# ⚠ CONSERVATIVE BY CONSTRUCTION: a slot that was WRITTEN has already had its entry cleared by
# `_prov_kill` (so it is not harvested), and a slot that was READ is marked live here. Only a copy
# that is provably neither survives to be deleted. Straight-line arg binding, so nothing jumps
# into the range; NOP-filling is the same idiom DSE_PASS uses, and PARSE_FN_DEF's compactor
# collects the runs afterwards with full jump/fixup repair.
# ⛔ THE EMITTER HOOKS ABOVE ARE NOT SUFFICIENT ON THEIR OWN, AND SHIPPING ONLY THEM MISCOMPILED.
# Enumerating every emitter that READS a local is open-ended: the first cut hooked seven of them
# and still missed `ELOAD_F64V2_TO_XMM` / `ELOAD_F64V4_TO_XMM` (a vector local passed to a REAL,
# non-inlined call), so six SIMD tests read an unwritten slot. A whitelist of readers is the wrong
# shape for a liveness question.
#
# So the harvest is gated on a CLOSED-FORM check as well: scan the emitted bytes of the whole
# replay window for ANY `[rbp+disp32]` reference carrying this slot's displacement, excluding the
# copy's own range. That is the same idiom the register-allocator safety scan uses, and it cannot
# miss an emitter because it looks at the instruction stream rather than at who wrote it.
# Conservative in the safe direction: a false positive only means the copy is kept.
fn _prov_refs(win_s, win_e, cp_s, cp_e, disp): i64 {
    var q = win_s;
    while (q + 7 <= win_e) {
        if (q >= cp_s) { if (q < cp_e) { q = cp_e; } }
        if (q + 7 > win_e) { return 0; }
        if ((load8(_codebuf_base + q + 2) & 0xC7) == 0x85) {
            if (load32(_codebuf_base + q + 3) == disp) { return 1; }
        }
        q = q + 1;
    }
    return 0;
}
fn _prov_dead(win_s, win_e, cps, cpe, disp, nsl): i64 {
    if (_prov_refs(win_s, win_e, cps, cpe, disp & 0xFFFFFFFF) == 1) { return 0; }
    if (nsl == 4) {
        if (_prov_refs(win_s, win_e, cps, cpe, (disp + 16) & 0xFFFFFFFF) == 1) { return 0; }
    }
    return 1;
}
fn _prov_harvest(win_s, win_e): i64 {
    if (_prov_s0 >= 0) { if (_prov_l0 == 0) {
            if (_prov_dead(win_s, win_e, _prov_p0, _prov_e0, _prov_d0, _prov_w0) == 1) {
                var h0 = _prov_p0;
                while (h0 < _prov_e0) { store8(_codebuf_base + h0, 0x90); h0 = h0 + 1; }
            }
        } }
    if (_prov_s1 >= 0) { if (_prov_l1 == 0) {
            if (_prov_dead(win_s, win_e, _prov_p1, _prov_e1, _prov_d1, _prov_w1) == 1) {
                var h1 = _prov_p1;
                while (h1 < _prov_e1) { store8(_codebuf_base + h1, 0x90); h1 = h1 + 1; }
            }
        } }
    return 0;
}
fn _prov_kill(idx): i64 {
    if (_prov_s0 == idx) { _prov_s0 = 0 - 1; _prov_c0 = 0 - 1; }
    if (_prov_s1 == idx) { _prov_s1 = 0 - 1; _prov_c1 = 0 - 1; }
    return 0;
}
# Map a callee param slot to the caller local it was copied from, or return the slot unchanged.
fn _prov_src(idx): i64 {
    if (_prov_s0 == idx) { return _prov_c0; }
    if (_prov_s1 == idx) { return _prov_c1; }
    return idx;
}
var _cur_fn_is_pure = 0;

# v4.9.1: current-fn #regalloc register count, set inside PARSE_FN_DEF.
# 0 = default ABI, 1 = rbx only (4.8.4 behavior), 2 = rbx+r12,
# 3 = rbx+r12+r13, 4 = rbx+r12+r13+r14, 5 = rbx+r12+r13+r14+r15.
# Codegen uses this to compute displacement shifts (N*8 bytes reserved)
# and to save/restore the correct set of callee-saved registers.
var _cur_fn_regalloc = 0;
# v6.3.37 (A3) — per-fn frame-slot high-water mark. The monomorph/inline-replay
# path (parse_fn.cyr, gated _INLINE_OK||_MONOMORPH_OK) transiently bumps GFLC to
# materialize callee args into enclosing-frame slots, then restores it — so the
# frame-size patch (which reads the FINAL GFLC) under-reserves, and a live runtime
# `push rax` (a binary operand) aliases the transient inline param slot. This
# records the peak so the frame reserves it. Raised ONLY in the flagged replay
# path; stays 0 on default builds → frame size byte-identical.
var _flc_hwm = 0;
# v6.5.14 — set when this fn materialises the address of one of its OWN locals
# (`&local`, incl. `&arr` / `&param`). The tail-call epilogue frees the frame
# BEFORE jumping, so a callee reading through such a pointer sees dead stack.
# v5.8.16 §8 guarded only the SYNTACTIC form `return f(&local)`; a pointer
# laundered through a variable (`var p = &buf; ... return f(p);`) walked straight
# past it. Reset per fn in PARSE_FN_DEF; read by the tail-call guard in
# parse_fn.cyr. See CHANGELOG [6.5.14]. 6.6.20: also set where an address in this
# frame is pushed WITHOUT a `&` — an inline aggregate argument, a temp, a field of a
# frame aggregate, a method's `self`, an operator's operand — and can outlive the call
# (`_sarg_escapes`; `_tc_sarg_divert` has the rules).
var _fn_local_addr = 0;
# v6.3.7 — set to 1 when the current fn emits a closure literal. Closures are
# emitted INLINE in the enclosing fn's code range (jumped over), so the enclosing
# fn's regalloc post-pass — a byte-scan that NOP-patches + reallocates locals —
# would rewrite the closure's instructions and corrupt them (SIGILL on call).
# A fn that emits a closure therefore skips the regalloc post-pass (it keeps a
# correct, un-reallocated frame; the only cost is losing the optimization).
var _cur_fn_has_closure = 0;
# v6.3.8 — lexical-capture state for the closure currently being parsed. A closure
# whose body references an enclosing local (a free variable) captures it BY VALUE
# into a heap env object `[fn_ptr, cap0, cap1, …]`; the closure value is that
# object (vtable-shaped, fn_ptr at offset 0), dispatched via callptr. `_cl_snap`
# / `_cl_snap_n` point at the enclosing-locals name snapshot (taken in the closure
# setup); `_cl_cap_slots[0.._cl_ncap)` holds the enclosing slot index of each
# capture (capture index = position in this array); `_cl_shadow` tracks body-local
# `var` names so they shadow enclosing names during the pre-scan.
var _cl_capturing = 0;
var _cl_ncap = 0;
var _cl_snap = 0;
var _cl_snap_n = 0;
# 6.6.17 — entries [0, _cl_snap_nl) of `_cl_snap` are the enclosing fn's LOCALS; entries
# [_cl_snap_nl, _cl_snap_n) are the enclosing closure's own CAPTURES, so a closure nested in a
# capturing closure can capture them in turn (`_cl_ctx_enter`). CHANGELOG [6.6.17]
var _cl_snap_nl = 0;
var _cl_nshadow = 0;
var _cl_env_lidx = 0;
# ⛔ 6.6.5 — A fn-LOCAL STATIC ARRAY IS NOT A PROGRAM-WIDE GLOBAL NAME.
#
# An array local over the per-fn frame budget (or any array under CYRIUS_STACK_ARRAYS=0)
# falls back to shared static storage, and it used to be registered with an ORDINARY GLOBAL
# NAME. FINDVAR is one flat last-match table over every file, so `fn f() { var big[200000]; }`
# in one file captured every later reference to `big` anywhere in the program — returning 7
# where 3 is right, silently. v6.6.4 additionally stamped it with the declaring file's
# visibility, which turned the same collision into an error naming the CONSUMER's variable.
# It was also invisible to FINDLOCAL, so an outer LOCAL of the same name shadowed it inside
# its own fn and `&big` wrote into that scalar.
#
# The STORAGE stays static (raising the budget is a heap-layout change, and the two
# consumers over it bank their buffers on purpose) — only the NAME is scoped: the slot is
# marked dead when its block closes, and an enclosing local it shadows is hidden for the
# duration and restored after. The note it used to print is now a WARNING that says the
# storage is static and shared across calls and threads, because that is the part a caller
# has to know. CHANGELOG [6.6.5]
# ⛔ THE OVERFLOW IS A DIAGNOSTIC, NOT A `return 0`. The first cut of this table was 64 deep
# and opened `if (_fs_n >= 64) { return 0; }` — so the 65th fn-local static in one body got
# NEITHER the new scoping NOR the v6.6.4 `_GVAR_VIS` stamp the else-arm applies, i.e. it
# silently reverted to the exact 6.6.3 shape this release removes, in a `private` file as a
# program-wide PUBLIC global. Measured with `CYRIUS_STACK_ARRAYS=0` (where every array local
# is static, so the cap is reachable): N=64 answered 3, N=65 answered 64. A fail-open guard
# on the defect under repair is the defect. The bound is 256 and hitting it stops the compile.
# The gate derives this number from the declaration below rather than quoting it.
# CHANGELOG [6.6.5]
var _fs_n = 0;
var _fs_floor = 0;
var _fs_vi[256];
var _fs_dep[256];
var _fs_hidli[256];
var _fs_hidnm[256];
fn _fs_push(S, vi, noff): i64 {
    if (_fs_n >= 256) {
        ERR_MSG(S, "too many static array locals in one fn (limit 256); move some to top level", 74);
        return 0;
    }
    S64(&_fs_vi + _fs_n * 8, vi);
    S64(&_fs_dep + _fs_n * 8, GSDEP(S));
    var _fh = FINDLOCAL(S, noff);
    S64(&_fs_hidli + _fs_n * 8, _fh);
    if (_fh >= 0) {
        S64(&_fs_hidnm + _fs_n * 8, L64(S + 0x5D9D000 + _fh * 8));
        S64(S + 0x5D9D000 + _fh * 8, 0 - 1);
    }
    _fs_n = _fs_n + 1;
    return 0;
}
fn _fs_kill(S, k): i64 {
    SVDEAD(S, L64(&_fs_vi + k * 8), 1);
    var _fh = L64(&_fs_hidli + k * 8);
    if (_fh >= 0) { S64(S + 0x5D9D000 + _fh * 8, L64(&_fs_hidnm + k * 8)); }
    return 0;
}
# Close every fn-static whose block depth is >= `dep`, never crossing into the enclosing
# fn's entries (`_fs_floor` is the current fn/closure body's mark).
fn _fs_pop(S, dep): i64 {
    var go = 1;
    while (go == 1) {
        if (_fs_n <= _fs_floor) { go = 0; }
        else {
            var k = _fs_n - 1;
            if (L64(&_fs_dep + k * 8) < dep) { go = 0; }
            else { _fs_kill(S, k); _fs_n = k; }
        }
    }
    return 0;
}
fn _fs_popto(S, mark): i64 {
    while (_fs_n > mark) {
        var k = _fs_n - 1;
        _fs_kill(S, k);
        _fs_n = k;
    }
    return 0;
}

var _cl_cap_slots[64];
# 6.6.5 — the WORD COUNT of each capture. A closure captured every free variable as ONE
# word, which is right for a scalar and wrong for an aggregate: an enclosing struct local or
# stack array is `n` words, and the closure body addresses its fields relative to the base.
# With one word copied, the body either read a single word as if it were the whole struct or
# (once struct literals became real locals) failed to resolve the name at all. The env is now
# `1 + sum(widths)` words and each capture copies its own width.
var _cl_cap_w[64];
var _cl_shadow[64];
# v5.5.36 Phase 2b — nonzero (= 8) when the current fn returns a
# struct by value. Reserves one 8-byte frame slot for the hidden
# retptr stash, living immediately after the regalloc save area
# and before any regular locals. All local-access emits shift disp
# by this amount so the retptr slot doesn't collide with locals.
var _cur_fn_ret_stash = 0;
# Mirrors the same fn's return-struct sid so PARSE_RETURN can emit
# the struct-copy sequence without re-scanning the fn table. 0 when
# scalar return. Set/reset in parallel with _cur_fn_ret_stash.
var _cur_fn_ret_sid = 0;

# v5.10.45 Phase 1 of struct-byval ABI arc — nonzero when the
# current fn returns a 9-16B int-class value-type struct (Str's
# 16B handle-shape is special-cased out via `_STR_SID(S)` check).
# Triggers PARSE_RETURN's pair-emit path (rax = lo, rdx = hi)
# instead of the scalar PCMPE path. Mutually exclusive with
# `_cur_fn_ret_stash > 0` (the >16B retptr path). Set/reset in
# parallel with `_cur_fn_ret_stash` and `_cur_fn_ret_sid` in the
# fn rough-scan + PARSE_FN_DEF teardown.
var _cur_fn_ret_pair = 0;

# ⭐ 6.6.6 — HOW MANY FRAME SLOTS THE CURRENT FN'S PARAMETER LIST OWNS. Parameters are
# registered first, from slot 0 up, so `li < _cur_fn_pslots` IS "this local is a parameter" —
# the one fact that separates an ADDRESS-PASSED by-value struct parameter (its slot holds a
# pointer to the caller's copy) from the other pointer-mode struct local, `var a = str_from(x)`,
# whose slot holds a heap handle and for which `a = b` must stay a pointer rebind. Recorded
# rather than re-derived because a value-form vector parameter owns 2-4 slots, so the parameter
# COUNT is not the slot count. Set once at the end of the parameter loop; zeroed by the fn
# teardown, and saved/restored around the async constructor and the generic-instance re-emit
# exactly like `_cur_fn_ix` (the constructor's save was added at bite 16's review — until then
# this line described a save/restore that did not exist, and the constructor was correct only
# because the teardown happens to zero this four lines before it runs). See
# `_local_is_sptr_param`. CHANGELOG [6.6.6]
var _cur_fn_pslots = 0;

# ⭐ 6.6.6 (bite 14 review) — THE STRUCT-RESULT RECORD, for the two call paths whose callee a
# destination cannot see in its tokens: a method call `s.m(..)` (the callee depends on `s`'s
# type) and an overloaded operator `a + b`. Each puts a struct result in a frame temp and
# records it here; a destination (`var p: S = ..`, `x = ..`, a by-value struct argument,
# `return ..` in a struct fn) arms `_sc_want` with the token it is about to parse, and after
# the parse takes the temp when the record spans EXACTLY that expression (`_sc_whole`). See
# `_sc_pre` in parse_fn.cyr. A free fn needs none of this — its name is the next token.
var _sc_want = 0 - 1;   # first token of the expression a destination is parsing
var _sc_beg = 0 - 1;    # first token of the last recorded struct-valued call
var _sc_end = 0 - 1;    # the token after it
var _sc_tmp = 0 - 1;    # its temp's field-0 slot; -1 at top level (no frame)
var _sc_sid = 0;        # the struct it returned
var _sc_fn = 0;         # the callee's name offset, for a top-level refusal
var _sc_n0 = 0;         # 1 when `_sc_pre` pushed a retptr as int arg 0
# The span of the last >16 B call `_sc_pre` REFUSED at top level (not recorded above, so no
# destination re-refuses it): a positional literal's nested field takes it as the whole field,
# instead of descending and reporting the values it is then short. CHANGELOG [6.6.12]
var _sc_rbeg = 0 - 1;
var _sc_rend = 0 - 1;

# v5.10.28 — current fn's return-type scalar tag (negative encodings
# from `_rt_scalar`: -1=i8, -2=i16, -4=i32, -8=i64, -16=Result,
# -17=Option, -18=Tagged, -19=cstring, -2093=f64v2). PARSE_RETURN
# checks this to dispatch f64v2 multi-register pair return ABI.
# (v6.4.14: f64v2 moved off -20 -> descriptor -2093; f64v4 -> -2125.)
# 0 when fn returns a struct (use _cur_fn_ret_sid) or no annotation.
var _cur_fn_ret_scalar = 0;

# v5.6.19 O4a: 1 if CYRIUS_REGALLOC_DUMP=1 was set at compile start.
# Read once early in main.cyr; consulted by PARSE_FN_DEF to print
# per-fn live-interval table for inspection. Foundation for v5.6.20
# Poletto-Sarkar linear-scan picker — letting us verify intervals
# match expectations before wiring the algorithm.
var _ra_dump_enabled = 0;

# v5.6.20 O4b: CYRIUS_REGALLOC_PICKER_CAP=N — caps total picker
# assignments per fn for bisection (per v5.6.17 saved methodology).
# -1 = uncapped (default; algorithm assigns up to _cur_fn_regalloc).
# 0 = disabled (no picker assignments — falls back to all-stack).
# Used to bisect any codegen bug the new picker might surface.
var _ra_picker_cap = 0 - 1;

# v5.6.22 O4c: CYRIUS_REGALLOC_AUTO_CAP=N — caps how many fns get
# auto-regalloc enabled (per-fn counter increments inside PARSE_FN_DEF).
# -1 = uncapped (every fn auto-enabled). 0 = no auto-enable (back to
# explicit #regalloc opt-in only). Bisection knob for the auto-enable
# codegen bug — find first fn where output diverges.
var _ra_auto_cap = 0 - 1;
var _ra_auto_count = 0;

# v5.11.62: current fn index for the per-fn array-byte attribution
# tracked at 0x1C8000 (reclaimed v5.11.19 fn_regalloc slot). PARSE_FN_DEF
# sets to the fn's fi at entry and resets to -1 at exit. parse_decl.cyr's
# array-registration path (parse_decl.cyr `PARSE_ARRAY`) adds the aligned
# size into the slot when this is >= 0; top-level `var foo[N]` declarations
# (no enclosing fn) skip the accounting. Read by FIXUP's `large static
# data` warning emitter (src/backend/x86/fixup.cyr) to compute "M bytes
# inside N unreachable fns" attribution after the DCE pass identifies dead
# hosts. See CHANGELOG [5.11.62].
var _cur_fn_ix = 0 - 1;

# ⭐ 6.6.7 — PER-FN STATE ISOLATION for the three emitters that emit a fn body WHILE another
# fn is still being emitted: a closure literal, a first generic instantiation `f<T>(..)`, and
# the async constructor. Each used to save its own hand-picked subset of the per-fn globals,
# and each subset had drifted. The return-patch vector was saved by LENGTH, truncated to 0 and
# pushed over, so an early `return` before a closure or a first `f<T>()` kept rel32 = 0 and fell
# through (x86/PE) or hung (aarch64); the defer table was not saved at all, so a closure's
# `defer`/`secret` landed on the ENCLOSING fn (zeroing an enclosing slot, never running at the
# closure's return) and an instantiation DROPPED the enclosing fn's defers; `_fn_local_addr`,
# the loop context and the coroutine mode leaked as well. ONE snapshot now covers
# every per-fn global, and the nested fn owns only the range it appends:
#   _rp_base    — first rp_vec index owned by the fn being emitted (0 at top level)
#   _defer_base — first defer-table entry owned by the fn being emitted (0 at top level)
# PARSE_FN_DEF truncates to / patches from these instead of index 0. CHANGELOG [6.6.7]
var _rp_base = 0;
var _defer_base = 0;
# 6.6.7 — how many loops (`_loop_depth`) and break targets (`_brk_depth` = loops + switch +
# match) enclose the current statement IN THE CURRENT FN. A `break`/`continue` with none used to
# compile clean: `break` stayed an unpatched chain link, `continue` jumped to the stale loop top
# of whatever fn last had a loop (SIGSEGV). Zeroed for every nested fn body and for a defer body,
# so neither can jump out of its own frame. `_in_defer` only picks the diagnostic.
var _loop_depth = 0;
var _brk_depth = 0;
var _in_defer = 0;
# 6.6.20 — the pending `continue` jumps of EVERY enclosing `for` (C-style, range, collection) in
# one growable vector. A `for` owns the entries from its base (the length when it opened,
# `_cont_open`) up, patches them to its step and truncates back (`_cont_close`, parse_ctrl.cyr),
# so the ranges of a nest are disjoint at any depth, across a `while`, a closure body or a
# generic instance emitted mid-loop. It replaces the flat array at S+0x18F8A0, whose next-free
# index 0x18F898 a `while` had to ZERO (0 was also its mode flag): a `for` inside that `while`
# restarted at entry 0 and stole the outer `for`'s pending jump. 0x18F898 is now the mode only
# (0 = `continue` jumps to the loop top, 1 = it is pushed here). CHANGELOG [6.6.20]
var _cont_vec = 0;
# 6.6.7 — 1 when the fn being emitted has a `defer` / `secret var` anywhere in its body
# (`_body_has_defer`, set at the body's `{`): its `return f(..);` must reach the walker, so it
# never tail-calls (`_tc_frame_divert`). Per-fn: in the snapshot below.
var _cur_fn_has_defer = 0;
# 6.6.7 — a coroutine suspend exit returns 0 to the runtime WITHOUT completing the body, so it
# must skip the defer walker; its jmp is recorded here (per suspend index) instead of rp_vec.
var _coro_sjp[64];

fn _fnst_put_cg(b): i64 {
    store64(b + 88, _fn_local_addr);    _fn_local_addr = 0;
    store64(b + 96, _flc_hwm);          _flc_hwm = 0;
    store64(b + 104, _cur_fn_regalloc); _cur_fn_regalloc = 0;
    store64(b + 112, _cur_fn_ret_stash); _cur_fn_ret_stash = 0;
    store64(b + 120, _cur_fn_ret_sid);  _cur_fn_ret_sid = 0;
    store64(b + 128, _cur_fn_ret_scalar); _cur_fn_ret_scalar = 0;
    store64(b + 136, _cur_fn_ret_pair); _cur_fn_ret_pair = 0;
    store64(b + 144, _cur_fn_naked);    _cur_fn_naked = 0;
    store64(b + 152, _cur_fn_ix);
    store64(b + 160, _cur_fn_pslots);   _cur_fn_pslots = 0;
    # b + 168 was _cur_fn_tp_pmask (retired 6.6.10: the B3 stub fact is recorded per fn, GFGM).
    store64(b + 168, _cur_fn_ptrp);     _cur_fn_ptrp = 0;
    store64(b + 176, _cur_fn_is_pure);  _cur_fn_is_pure = 0;
    return 0;
}
fn _fnst_get_cg(b): i64 {
    _fn_local_addr = load64(b + 88);
    _flc_hwm = load64(b + 96);
    _cur_fn_regalloc = load64(b + 104);
    _cur_fn_ret_stash = load64(b + 112);
    _cur_fn_ret_sid = load64(b + 120);
    _cur_fn_ret_scalar = load64(b + 128);
    _cur_fn_ret_pair = load64(b + 136);
    _cur_fn_naked = load64(b + 144);
    _cur_fn_ix = load64(b + 152);
    _cur_fn_pslots = load64(b + 160);
    _cur_fn_ptrp = load64(b + 168);
    _cur_fn_is_pure = load64(b + 176);
    return 0;
}
# The coroutine mode: a closure inside an `async fn` body is NOT a coroutine, and with the mode
# leaked its locals were addressed through the enclosing coroutine's heap frame (SIGSEGV).
fn _fnst_put_coro(b): i64 {
    store64(b + 184, _cur_fn_coro);     _cur_fn_coro = 0;
    store64(b + 192, _coro_base);
    store64(b + 200, _coro_lo);
    store64(b + 208, _coro_nsusp);
    store64(b + 216, _coro_top_jmp);
    store64(b + 224, _coro_entry_cp);
    return 0;
}
fn _fnst_get_coro(b): i64 {
    _cur_fn_coro = load64(b + 184);
    _coro_base = load64(b + 192);
    _coro_lo = load64(b + 200);
    _coro_nsusp = load64(b + 208);
    _coro_top_jmp = load64(b + 216);
    _coro_entry_cp = load64(b + 224);
    return 0;
}
# The pending `&&` false-exit patches (count + 8 entries) belong to the enclosing statement's
# condition; a nested body re-runs ECOND/PATCHXP, which zero the count. Carried across for
# completeness — no miscompile through this path was measured (a closure literal in a
# condition did not reach it in the probes that were tried).
fn _fnst_put_xp(S, b): i64 {
    store64(b + 232, GXPC(S));
    var i = 0;
    while (i < 8) { store64(b + 240 + i * 8, L64(S + 0x18F848 + i * 8)); i = i + 1; }
    SXPC(S, 0);
    return 0;
}
fn _fnst_get_xp(S, b): i64 {
    SXPC(S, load64(b + 232));
    var i = 0;
    while (i < 8) { S64(S + 0x18F848 + i * 8, load64(b + 240 + i * 8)); i = i + 1; }
    return 0;
}
# Save EVERY per-fn global into a snapshot and enter a fresh fn: in-fn, no locals, scope 0, no
# loop, the return-patch and defer ranges starting where the enclosing fn's end. The caller then
# sets what is specific to it (`_cur_fn_ix`, captures, locals snapshot). Returns the snapshot.
fn _fnst_save(S): i64 {
    var b = alloc(320);
    store64(b, GLVAR(S));
    store64(b + 8, GINFN(S));
    store64(b + 16, GFLC(S));
    store64(b + 24, GSDEP(S));
    store64(b + 32, _rp_base);
    store64(b + 40, _defer_base);
    store64(b + 48, _loop_depth);
    store64(b + 56, _brk_depth);
    store64(b + 64, L64(S + 0x18F838));
    store64(b + 72, L64(S + 0x18F840));
    store64(b + 80, _in_defer);
    store64(b + 304, _cur_fn_has_defer);
    store64(b + 312, _cur_iself_sid);   # 6.7.0 (A4): kept, not cleared — a closure inherits it
    _fnst_put_cg(b);
    _fnst_put_coro(b);
    _fnst_put_xp(S, b);
    SINFN(S, 1);
    SFLC(S, 0);
    SSDEP(S, 0);
    _rp_base = vec_len(rp_vec);
    _defer_base = L64(S + 0x1AC020);
    _loop_depth = 0;
    _brk_depth = 0;
    _in_defer = 0;
    _cur_fn_has_defer = 0;
    S64(S + 0x18F840, 0);
    return b;
}
# Leave the nested fn: drop its return patches and defer entries (both already emitted and
# patched by it), then put every enclosing global back.
fn _fnst_restore(S, b): i64 {
    vec_truncate(rp_vec, _rp_base);
    S64(S + 0x1AC020, _defer_base);
    SLVAR(S, load64(b));
    SINFN(S, load64(b + 8));
    SFLC(S, load64(b + 16));
    SSDEP(S, load64(b + 24));
    _rp_base = load64(b + 32);
    _defer_base = load64(b + 40);
    _loop_depth = load64(b + 48);
    _brk_depth = load64(b + 56);
    S64(S + 0x18F838, load64(b + 64));
    S64(S + 0x18F840, load64(b + 72));
    _in_defer = load64(b + 80);
    _cur_fn_has_defer = load64(b + 304);
    _cur_iself_sid = load64(b + 312);
    _fnst_get_cg(b);
    _fnst_get_coro(b);
    _fnst_get_xp(S, b);
    return 0;
}

# 6.6.7 — the fn EPILOGUE's defer machinery, shared by PARSE_FN_DEF and the closure path so
# there is ONE authority (the closure path had none: no zeroing trampoline and no walker, which
# is why a closure's defer ran in the enclosing frame). All three walk [_defer_base, count).
fn _defer_zero_flags(S): i64 {
    var dc = L64(S + 0x1AC020);
    var i = _defer_base;
    while (i < dc) {
        EMOVI(S, 0);
        EFLSTORE(S, L64(S + 0x1AC028 + i * 24 + 16));
        i = i + 1;
    }
    return 0;
}
# Resolve the fn-entry `jmp` (emitted just before the body) — to a flag-zeroing trampoline that
# returns to `body_cp` when this fn registered defers, else to `body_cp` itself. The body's
# FALL-THROUGH end is routed round the trampoline to the return landing: without that jmp a body
# that ended without `return` ran into the trampoline and re-entered the body forever (and every
# expression-bodied closure falls through). A coroutine zeroes its flags at the state-0 landing
# instead (see the dispatch in PARSE_FN_DEF), because its flags live in the heap frame, which is
# not reachable yet at fn entry — and must not be re-zeroed on each resume.
fn _defer_emit_init(S, init_jmp, body_cp): i64 {
    var dc = L64(S + 0x1AC020);
    if (dc > _defer_base) {
        # The body's fall-through jumps round the trampoline to the return landing. Only a
        # plain fn / closure needs it: a coroutine's body end is already routed there (PARSE_FN_DEF),
        # and the resume dispatch before this ends in an unconditional jmp, so the jmp was
        # unreachable (`e9 00000000`). CHANGELOG [6.6.12]
        if (_cur_fn_coro == 0) {
            vec_push(rp_vec, EJMP0(S));
            EPATCH(S, init_jmp);
            _defer_zero_flags(S);
            EJMP(S, body_cp);
            return 0;
        }
    }
    var saved_cp = GCP(S);
    SCP(S, body_cp);
    EPATCH(S, init_jmp);
    SCP(S, saved_cp);
    return 0;
}
# Land every return jmp this fn recorded ([_rp_base, len)) at the current position.
fn _rp_patch_here(S): i64 {
    var n = vec_len(rp_vec);
    var i = _rp_base;
    while (i < n) {
        EPATCH(S, vec_get(rp_vec, i));
        i = i + 1;
    }
    return 0;
}
# ⛔ 6.6.20 — THE f64 RETURN BOX, ONCE, AT THE LANDING (`rs` = the return scalar of the fn whose
# returns land here). A `: f64` fn carries its value boxed in rax (x0 / r0) and the x86-family
# ABI wants it in xmm0, which every call site reads back (`_call_ret_marks`). The box used to sit
# on three PARSE_RETURN arms only, so a bare `return;`, falling off the end, the `ret2` builtin,
# a `?` early return and an inlined `: f64` callee all handed back whatever the last f64 op left
# in xmm0 on x86 / PE / x86 Mach-O, while aarch64 / cx (a no-op box) were right. Every return of
# the fn jmps to the landing, so one box here covers every arm, present and future; a tail call
# never reaches it and is diverted unless its callee boxes too (`_tc_f64_ret_divert`). The defer
# walker runs after this and EDEFER_SAVE keeps xmm0. CHANGELOG [6.6.20]
fn _ret_box_f64(S, rs): i64 {
    if (rs == 0 - 9) { EMOVQ_X0_A(S); }
    return 0;
}
# Run the reached defer blocks LIFO: save the return convention, check each flag, jmp to the
# block, which jmps back. ⚠ EDEFER_SAVE/RESTORE (per backend) keep EVERY return register of
# EVERY return convention — the pair, the arity-3 slot, the f64 / vector registers — because a
# block is ordinary code and any call in it clobbers them; saving rax alone lost an `Ok`
# payload to a `sys_write` in the block. CHANGELOG [6.6.7]
fn _defer_emit_walk(S): i64 {
    var dc = L64(S + 0x1AC020);
    if (dc <= _defer_base) { return 0; }
    EDEFER_SAVE(S);
    var di = dc - 1;
    while (di >= _defer_base) {
        EFLLOAD(S, L64(S + 0x1AC028 + di * 24 + 16));
        ETESTAZ(S);
        var dskip = EJCC(S, 0x84);                  # je skip — flag 0: never reached
        EJMP(S, L64(S + 0x1AC028 + di * 24));        # run the block ...
        EPATCH(S, L64(S + 0x1AC028 + di * 24 + 8));  # ... whose end-jmp returns here
        EPATCH(S, dskip);
        di = di - 1;
    }
    EDEFER_RESTORE(S);
    return 0;
}
# 6.6.7 — a coroutine suspend exit (`await` inside a coroutine body, parse_expr.cyr): record the
# `jmp` to the fn end per suspend index, not in rp_vec, so it bypasses the defer walker. An
# `await` inside a DEFER body is refused: the walker is mid-run with rax pushed on a stack frame
# that the suspend destroys.
fn _coro_suspend_jmp(S, sk): i64 {
    if (_in_defer == 1) { ERR_MSG(S, "await cannot suspend inside a defer body", 40); }
    var j = EJMP0(S);
    if (sk < 64) { store64(&_coro_sjp + sk * 8, j); }   # past 63 the caller has already errored
    return 0;
}
# ⛔ 6.6.8 — A COMPLETED COROUTINE IS DONE. Completion never wrote the state word, so forcing a
# finished future re-entered at its LAST suspend: the tail of the body ran again, with its
# defers, and a loop kept counting past its own exit (forces 5..10 of a 3-await loop returned
# 4..9). The body's real return now stamps C[state] = DONE (-1) and keeps its value in a word
# past the frame (`_CORO_LOCAL_OFF + _coro_flc * 8`, which the constructor sizes for); the
# dispatch answers a DONE entry with that value and leaves through the suspend exit, so no
# statement and no defer runs twice. CHANGELOG [6.6.8]
fn _coro_res_off(): i64 { return _CORO_LOCAL_OFF + _coro_flc * 8; }
# The first link of the resume dispatch (`_coro_flc` is already final: every local exists).
fn _coro_done_check(S): i64 {
    EFLLOAD(S, _coro_base);
    EADDRA_IMM(S, _CORO_STATE_OFF);
    ELOAD64(S);                       # rax = C[state]
    EPUSHR(S);
    EMOVI(S, 0 - 1);
    EPOPC(S);
    ECMPR(S);
    var skip = EJCC(S, 0x85);         # jne -> the resume chain
    EFLLOAD(S, _coro_base);
    EADDRA_IMM(S, _coro_res_off());
    ELOAD64(S);                       # rax = the completion value
    store64(&_coro_sjp, EJMP0(S));    # -> the suspend exit (slot 0 is no suspend index)
    EPATCH(S, skip);
    return 0;
}
# At the real return, after the defer walker: rax is the completion value.
fn _coro_mark_done(S): i64 {
    EPUSHR(S);
    EFLLOAD(S, _coro_base);
    EADDRA_IMM(S, _CORO_STATE_OFF);
    EPUSHR(S);
    EMOVI(S, 0 - 1);
    EPOPC(S);
    ESTORE64(S);                      # C[state] = DONE
    EFLLOAD(S, _coro_base);
    EADDRA_IMM(S, _coro_res_off());
    EPUSHR(S);
    EPOPC(S);
    EPOPR(S);
    ESTORE64(S);                      # C[res] = rax
    return 0;
}
fn _coro_land_suspends(S): i64 {
    EPATCH(S, load64(&_coro_sjp));    # the DONE exit from _coro_done_check
    var k = 1;
    while (k <= _coro_nsusp && k < 64) {
        EPATCH(S, load64(&_coro_sjp + k * 8));
        k = k + 1;
    }
    return 0;
}
# A loop body: one more loop and one more break target for the statements inside it.
fn _loop_body(S, scoped): i64 {
    _loop_depth = _loop_depth + 1;
    _brk_depth = _brk_depth + 1;
    if (scoped == 1) { SCOPE_PUSH(S); }
    PARSE_PROG(S);
    if (scoped == 1) { SCOPE_POP(S); }
    _loop_depth = _loop_depth - 1;
    _brk_depth = _brk_depth - 1;
    return 0;
}

# v6.3.11 (G) — async/await. `_IS_FN_KW` lets the top-level dispatch in every
# driver fork route a leading `async` (token 134) to the same fn path as `fn`
# (token 32) without 7×2 bespoke branches: the dispatch checks `_IS_FN_KW(S)==1`
# instead of `PEEKT(S)==32`, and the shared _prescan_fn_sig / PARSE_FN_DEF consume
# the optional `async` prefix. Token 134 only exists when source has `async`
# (cycc has none → byte-identical self-host), so no _ASYNC_OK guard is needed here.
# ── v6.5.0 file-scoped visibility: the top-level `private` / `public` markers ──
#
# `private` on its own at top level flips THIS FILE to private-by-default; `public`
# (== `pub`, token 73) in front of an individual item re-exposes it. Default with no
# declaration is today's behaviour, everything public — so this is opt-in per file and
# nothing in the tree or the ecosystem changes until a file asks for it.
#
# ONE shared helper rather than 14 hand-written dispatch arms. The top-level token
# dispatch is inline code duplicated across pass 1 and pass 2 of all 7 `main_*.cyr`
# forks, and BOTH fallthroughs terminate the parse SILENTLY — so a fork where the new
# token was forgotten would not error, it would quietly stop parsing. Routing every
# site through one call means the set of edits is a mechanical one-line substitution
# and the behaviour cannot drift between forks. (Same reasoning as `_capacity_warnings`
# at v6.4.50, which pulled a block duplicated in 2 of 7 drivers into one shared fn and
# thereby fixed the 5 forks that had silently never had it.)
#
# Returns 1 if it consumed a visibility marker, 0 otherwise. Callers pass through to
# their existing chain on 0.
#
# Recording is IDEMPOTENT: both passes walk the same token stream, so pass 2 re-marks
# the same file id pass 1 already marked. That is deliberate — it means one helper
# serves both passes with no pass-awareness.
var _priv_files[512];        # 512*8 = 4096 B = 32768 bits, one per possible file id
var _pub_pending = 0;        # `public` seen; consumed by the next fn / global-var definition; un-armed by _TL_VIS on struct/union/enum/impl/use (v6.6.4)

fn _PRIV_MARK(fid): i64 {
    if (fid <= 0) { return 0; }
    if (fid >= 32768) { return 0; }
    var w = fid / 64;
    var b = fid % 64;
    store64(&_priv_files + w * 8, load64(&_priv_files + w * 8) | (1 << b));
    return 0;
}

fn _PRIV_FILE(fid): i64 {
    if (fid <= 0) { return 0; }
    if (fid >= 32768) { return 0; }
    var w = fid / 64;
    var b = fid % 64;
    if ((load64(&_priv_files + w * 8) & (1 << b)) != 0) { return 1; }
    return 0;
}

# ⭐ 6.6.5 — mark every `private` file BEFORE either parser pass, from the end of LEX.
#
# `private` used to be recorded by _TL_VIS as pass 1 WALKED PAST the marker, so whether a
# definition was stamped private depended on where in the file the marker sat: a fn above
# the `private` line was prescanned while the file was still "public" and a forward call
# to it was allowed, and a GLOBAL above the line was never private in either order. The
# guide says the marker applies to the whole file — so the marking has to happen before
# anything is stamped, not during the walk.
#
# It also gives the per-item diagnostic a place to be emitted EXACTLY ONCE: both passes
# walk the same tokens, so reporting from _TL_VIS printed the same error twice. This loop
# visits each token once.
#
# ⚠ The per-item form `private fn h()` must NOT mark the file. _TL_VIS marked first and
# errored second, so the rejected form still privatised the file — and a legitimate `fn g`
# in that same file was then reported "private to its file" at its caller: a false cascade
# on top of a doubled diagnostic. CHANGELOG [6.6.5]
fn _PRIV_PRESCAN(S): i64 {
    var i = 0;
    var n = GTCNT(S);
    while (i < n) {
        if (TOKTYP(S, i) == 153) { _PRIV_PRESCAN_TOK(S, i); }
        i = i + 1;
    }
    return 0;
}

fn _PRIV_PRESCAN_TOK(S, ti): i64 {
    var ln = GTLINE(S, ti);
    # THE DISCRIMINATOR IS THE LINE (v6.5.56): `private` alone on its own line is the
    # file-level form; a trailing `;` closes the statement so `private; fn h()` is legal
    # too. Anything else sharing the token's line is the per-item misread.
    # ⚠ EOF (token 12) is NOT "something on the line". LEX appends it with ADDTOK(S, 12, 0)
    # on whatever line the source ended on, so a file whose last byte is the `e` of
    # `private` — no trailing newline — has the EOF token sharing the marker's line and was
    # told "per-item `private` is not supported", a rule the author did not break. 6.6.4
    # refused that source too (`unexpected private` when a statement precedes it), so the
    # only thing at stake is WHICH diagnostic; the carve-out restores it. CHANGELOG [6.6.5]
    var nx = ti + 1;
    if (nx < GTCNT(S)) {
        if (TOKTYP(S, nx) != 5) {
            if (TOKTYP(S, nx) != 12) {
                if (GTLINE(S, nx) == ln) { _priv_per_item_err(S, ti); return 0; }
            }
        }
    }
    _PRIV_MARK(FM_FILEID(S, ln));
    return 0;
}

# Emitted from the pre-pass, so NOT through ERR_MSG: ERR_MSG sets `_panic`, which exists
# to swallow a cascade until the statement parser resyncs — arming it before the parse has
# started would swallow the first genuine syntax error instead. `_had_error` alone
# withholds the binary, which is the v6.4.62 multi-error contract.
fn _priv_per_item_err(S, ti): i64 {
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": per-item `private` is not supported; put `private` alone on a line to make the file private\n", 94);
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}

# v6.6.4: the tokens `public` can ARM the marker for — a `var`, a `fn`
# (plain, `async`), or a fn-attribute directive that precedes one (#regalloc #must_use
# #deprecated #pure #io #alloc #naked #inline). Anything else — struct, union, enum, impl,
# `use`, `mod`, … — records no visibility (the committed design covers fns and global vars
# only), so `public` on it is consumed UN-ARMED. Before this, the marker was armed
# unconditionally and only fn/var definitions ever cleared it, so `public enum E {..}`
# silently re-exposed the NEXT fn or var in a private file (hisab `_ad_pow`, 2026-09-13) —
# and the same for struct / union / impl / `use`. A positive list rather than a negative
# one so a future top-level keyword cannot re-open it.
fn _PUB_CAN_ARM(t): i64 {
    if (t == 3) { return 1; }      # var (`secret var` is fn-local only — never at top level)
    if (t == 32) { return 1; }     # fn
    if (t == 134) { return 1; }    # async (fn)
    if (t == 109) { return 1; }    # #regalloc
    if (t == 122) { return 1; }    # #must_use
    if (t == 124) { return 1; }    # #deprecated
    if (t == 125) { return 1; }    # #pure
    if (t == 126) { return 1; }    # #io
    if (t == 127) { return 1; }    # #alloc
    if (t == 133) { return 1; }    # #naked
    if (t == 163) { return 1; }    # #inline
    return 0;
}

fn _TL_VIS(S): i64 {
    var t = PEEKT(S);
    if (t == 73) {
        # `public` / `pub` — re-expose the NEXT item. Consumed by PARSE_FN_DEF / _GVAR_VIS;
        # consumed HERE, un-armed, when the next item cannot carry visibility (v6.6.4).
        STI(S, GTI(S) + 1);
        _pub_pending = 0;
        if (_PUB_CAN_ARM(PEEKT(S)) == 1) { _pub_pending = 1; }
        return 1;
    }
    if (t == 153) {
        # `private` — CONSUME ONLY. The file was flipped by `_PRIV_PRESCAN` at the end of
        # LEX, and the v6.5.56 per-item rejection is reported there too.
        #
        # ⛔ 6.6.5: this arm used to do both jobs itself, and both were wrong from here.
        #  * Marking DURING the walk made the stamp depend on where the marker sat — a fn
        #    or a global ABOVE the `private` line was prescanned while the file still read
        #    public. The guide says the marker applies to the whole file.
        #  * It marked BEFORE rejecting the per-item form, so `private fn h()` still
        #    privatised the file; and because both passes walk these tokens, the rejection
        #    printed TWICE and a legitimate sibling fn was then reported "private to its
        #    file" at its caller. One pre-pass visit fixes all three. CHANGELOG [6.6.5]
        STI(S, GTI(S) + 1);
        # Tolerate an optional trailing `;` so both `private` and `private;` parse.
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
        return 1;
    }
    return 0;
}

# v6.5.0 Phase 2b — stamp a global var's visibility. `decl_ti` is the `var` keyword
# token, so the file is derived from the declaration itself rather than from whatever
# token happens to be current (the same reasoning as the fn stamp using `_defstart_ti`).
fn _GVAR_VIS(S, vi, decl_ti): i64 {
    var fid = FM_FILEID(S, GTLINE(S, decl_ti));
    if (_pub_pending == 0) {
        if (_PRIV_FILE(fid) == 1) { SVFI(S, vi, fid + 1); }
    }
    _pub_pending = 0;
    return 0;
}

fn _IS_FN_KW(S): i64 {
    var t = PEEKT(S);
    if (t == 32) { return 1; }
    if (t == 134) { return 1; }
    return 0;
}

# Lazily resolve the async feature gate from CYRIUS_ASYNC the first time an
# `async`/`await` token reaches pass 2 (PARSE_FN_DEF / PEXPR). Default off → the
# gated lowering is unreachable and cycc self-host is byte-identical (async/await
# never appear in cycc src, so this is never called during self-host). Same opt-in
# contract as _MONOMORPH_OK, but lazy — avoids a per-fork driver env-read edit.
fn _ensure_async_gate(S): i64 {
    if (_async_gate_init == 1) { return _ASYNC_OK; }
    _async_gate_init = 1;
    var e = _read_env("CYRIUS_ASYNC");
    if (e != 0) { if (load8(e) == 49) { if (load8(e + 1) == 0) { _ASYNC_OK = 1; } } }
    return _ASYNC_OK;
}

# v6.3.13 (thread-safe array locals): a `var arr[N]` declared INSIDE a function is
# historically allocated in the global/BSS data region at a FIXED address — shared
# by every thread, so concurrent code that uses an array-local corrupts (root cause
# of the str_builder concurrency bug). When this gate is on, small array locals are
# registered as multi-slot per-thread STACK locals (the struct-local mechanism) and
# large ones are heap-allocated per call — so &arr / arr[i] resolve via FINDLOCAL to
# a per-thread address. Default OFF during the v6.3.13 dev cycle (flipped ON at slot
# close via a two-step bootstrap). Lazy-init from CYRIUS_STACK_ARRAYS — no per-fork edit.
fn _ensure_stack_arrays(S): i64 {
    if (_sa_init == 1) { return _STACK_ARRAYS; }
    _sa_init = 1;
    # v6.3.15: DEFAULT-ON. `var arr[N]` LOCALS route to per-thread STACK slots (fixes the
    # str_builder concurrency root cause — v6.3.13: array locals used to share one global
    # .bss buffer across all threads). The two v6.3.13 default-on blockers are resolved:
    # (1) SSE m128 16-alignment — array stack slots whose `&arr` disp would be 8 (mod 16)
    # get a one-slot parity pad so `pxor/aesenc xmm,[arr]` stays #GP-free (see PARSE_ARRAY);
    # (2) `secret var` zeroise now addresses the LOCAL (ELOAD_LOCAL_ADDR), not the global.
    # CYRIUS_STACK_ARRAYS=0 opts back to legacy global (.bss) arrays. See CHANGELOG [6.3.15].
    # ⛔ v6.5.12: THE OPT-OUT IS NOT SILENT ANY MORE — it can re-open a fixed CVE-class
    # defect in a DOWNSTREAM library, and nothing said so.
    #
    # sigil 3.12.3 fixed an RSA authentication bypass (`rsa_pkcs1v15_verify_sha256`
    # returning 1 for INVALID signatures — 888 of 400,000 forged signatures accepted,
    # measured by agnosai) and the ENTIRE fix is "make the verify scratch buffers
    # function-LOCAL": `var nbuf[512]` / `var embuf[512]` / `var expbuf[512]`. That fix
    # only holds because array locals are per-thread STACK slots. Setting
    # CYRIUS_STACK_ARRAYS=0 turns them back into shared .bss globals — the two operands
    # of the verify decision land in one lane-indexed global again and the bypass
    # RETURNS, with no diagnostic anywhere.
    #
    # The flag stays (it is a real debugging escape hatch and has been default-on since
    # v6.3.15), but a security property must not be revocable in silence. Warn, name what
    # it costs, and let the caller decide — the same reasoning as the v6.5.11 "no silent
    # caps" work.
    _STACK_ARRAYS = 1;
    var e = _read_env("CYRIUS_STACK_ARRAYS");
    if (e == 0) { return _STACK_ARRAYS; }
    if (load8(e) == 48) {
        if (load8(e + 1) == 0) {
            _STACK_ARRAYS = 0;
            syscall(SYS_WRITE, 2, "warning: CYRIUS_STACK_ARRAYS=0 — `var arr[N]` locals are shared .bss globals, not per-thread stack.\n", 102);
            syscall(SYS_WRITE, 2, "  This REVERTS the mechanism sigil 3.12.3 relies on to fix its RSA verify bypass; crypto scratch\n", 97);
            syscall(SYS_WRITE, 2, "  buffers become cross-thread shared again. Do not use for anything that verifies signatures.\n", 94);
        }
    }
    return _STACK_ARRAYS;
}


# v5.5.38: struct/enum/union + shared-helper fns extracted.
include "src/frontend/parse_types.cyr"


# Syscall arity table: returns expected arg count for well-known
# Linux x86_64 syscalls, or -1 if unknown. The table is fixed — free information.

# v5.5.38: expression-parsing fns extracted.
include "src/frontend/parse_expr.cyr"


# Parse array: already past [, parse N]; register global var with aligned size

# v5.5.38: var/array/field/struct-init/assignment fns extracted.
include "src/frontend/parse_decl.cyr"


# Emit inverted jcc for comparison op, return patch offset

# v5.5.38: fn decls + calls + returns + impls + PARSE_FN_DEF extracted.
include "src/frontend/parse_fn.cyr"


# ASM_MNEMONIC and helpers are in arch-specific emit files:
# src/backend/x86/emit.cyr and src/backend/aarch64/emit.cyr

# v6.5.19 (CVE-39) — bound the jump-end arrays of PARSE_SWITCH and PARSE_MATCH.
#
# Both fns collect one "jump to end of construct" patch site per case/arm into a LOCAL
# `ends: i64[256]`, then walk it once the construct closes. The counter `ec` was never
# checked against 256 at ANY of the four write sites, so case 257 wrote straight off the
# stack frame. This needs no hostile input: a 400-case `switch` and a 400-arm `match`
# are ordinary valid cyrius — exactly the opcode-dispatch shape this compiler's own
# sources use — and both killed cycc with a SIGSEGV and ZERO diagnostic bytes.
#
# v6.2.1 is the near-miss worth recording: it found the same arrays overflowing at 32
# entries, correctly diagnosed the `var ends[256]` = 256 BYTES = 32 slots trap (see
# CLAUDE.md), and resized them to `i64[256]`. But resizing MOVED the cliff from 32 to
# 256 without ever fencing it, and added a `seen_count < 256` guard on the neighbouring
# dedup array — so the file already shows the author knew a bound was needed, one
# declaration away. A capacity fix is not a bounds fix.
#
# HARD ERROR, never a silent skip: dropping a jump-end patch leaves that arm falling
# through into the next one, i.e. a silent miscompile, which is strictly worse than
# refusing the file. Shared by all four sites so the limit cannot drift between them.
# v6.5.23 — CAPACITY joins the RECOVERABLE diagnostic class (maintainer decision,
# 2026-08-17: "recoverable"). Reported once and the parse continues, so ONE compile names
# this alongside every other error in the file instead of stopping here.
#
# ⚠ THIS DOES NOT WEAKEN THE HAZARD THE NOTE ABOVE DESCRIBES. `_had_error` withholds the
# binary (the v6.4.62 multi-error contract), so the fall-through miscompile it warns about
# — an unpatched jump-end letting one arm fall into the next — can never reach an
# executable. "Recoverable" means the DIAGNOSTIC recovers, not that a broken binary ships.
# Returning 1 lets the caller skip recording a patch it has no slot for, rather than
# writing past the 256-slot array, which is what the guard existed to prevent.
#
# ⛔ THE 256 CAP ITSELF IS UNRESOLVED AND MUST BE RE-REVIEWED WHEN IT BECOMES THE
# BOTTLENECK (maintainer, 2026-08-17). This change makes hitting it survivable and
# legible; it does not raise it. v6.2.1 already moved this cliff once (32 → 256) without
# fencing it, and the note above records that "a capacity fix is not a bounds fix" — the
# converse also holds: this is a bounds fix, not a capacity fix. When a real consumer
# needs >256 arms, the arrays are `i64[256]` in four sites and the limit is shared through
# this fn precisely so it can be raised in one place.
fn _ends_guard(S, ec): i64 {
    if (ec >= 256) {
        syscall(SYS_WRITE, 2, "error:", 6); _err_head(S);
        syscall(SYS_WRITE, 2, ": too many case/arm bodies in one switch/match (max 256)\n", 57);
        _had_error = 1;
        return 1;
    }
    return 0;
}

# v6.5.20 — patch the pending `break` chain to the CURRENT code position and
# restore the enclosing construct's chain head. `break` threads a linked list
# through the rel32 field of each placeholder jmp, head at S+0x18F840; the
# construct that owns the chain saves the head, zeroes it, parses the body, then
# walks and patches. PARSE_WHILE / PARSE_FOR did this; PARSE_SWITCH / PARSE_MATCH
# never touched the slot at all, so a `break` inside a switch either broke the
# ENCLOSING LOOP or — with no enclosing loop — was never patched and kept the
# chain link in its displacement field: a wild jump, SIGSEGV at runtime.
# CHANGELOG [6.5.20]
fn _brk_chain_end(S, saved_brk): i64 {
    var bp = L64(S + 0x18F840);
    while (bp > 0) {
        var _ba = _codebuf_base + bp;
        var _nb = L64(_ba) & 0xFFFFFFFF;
        EPATCH(S, bp);
        bp = _nb;
    }
    S64(S + 0x18F840, saved_brk);
    _brk_depth = _brk_depth - 1;   # 6.6.7 — paired with the switch/match entry
    return 0;
}

# v6.5.20 — register a switch jump table for the per-fn NOP-compaction repair
# (_sw_tbl_repair, parse_fn.cyr). Entries hold `target_cp - table_cp`; the
# v5.6.27 compactor shifts code but knew nothing about this table, so harvesting
# a 4-byte NOP run between the table and a case body left every later entry
# stale. Overflow past the 256 cap keeps counting so the compaction gate trips
# and skips the pass for that fn — never a silent drop. CHANGELOG [6.5.20]
fn _sw_tbl_reg(S, table_cp, nent): i64 {
    var n = L64(S + 0x1AC800);
    if (n < 256) {
        S64(S + 0x1AC808 + n * 16, table_cp);
        S64(S + 0x1AC808 + n * 16 + 8, nent);
    }
    S64(S + 0x1AC800, n + 1);
    # v6.5.68: the per-fn table above is zeroed at every function start, so the
    # whole-program pass keeps its own copy. A switch jump table is DATA inside `.text`
    # holding `target_cp - table_cp` deltas; delete a run between a table and its targets
    # without repairing it and the dispatch jumps into the middle of an instruction.
    _wpsw_add(S, table_cp, nent);
    return 0;
}

# ⛔ 6.6.5 — A COMPILER-GENERATED TEMPORARY IS NOT A GLOBAL.
#
# `switch`, `match`, both `?` lowerings and `for ... in` each stashed their subject in a
# GLOBAL slot registered at GVCNT with NAME OFFSET 0. Three consequences, all silent:
#   * RECURSION reloaded the outer call's value. `rec(n)` through a range `for` returned 63
#     where 255 is right; a `match` re-entered from an arm pattern returned 1 for 30.
#   * THREADS shared one word. A chain-path `switch` across 8 threads exited non-zero on
#     every run.
#   * NAME OFFSET 0 IS THE FIRST LEXED WORD of the program (the lexer resets NPOS to 0), so
#     FINDVAR — a flat last-match table — RETURNED THESE SLOTS for that identifier. Measured:
#     `&setup` changed value after a fn containing a `switch` was parsed between two uses.
#
# Inside a fn they are anonymous FRAME slots, which makes them per call and per thread. At
# top level they stay global and are marked dead so FINDVAR skips them. The handle is the
# slot index for a frame slot and `-2 - vi` for a global, so callers use `_HTSTORE`/`_HTLOAD`
# and never care which. CHANGELOG [6.6.5]
fn _HTEMP(S): i64 {
    if (GINFN(S) == 1) {
        var _hli = GFLC(S);
        S64(S + 0x5D9D000 + _hli * 8, 0 - 1);
        SLDEP(S, _hli, 0);
        SLTYPE(S, _hli, 0);
        SSLICE_W(S, _hli, 0);
        SFLC(S, _hli + 1);
        return _hli;
    }
    var _hvi = GVCNT(S);
    S64(_varn_base + _hvi * 8, 0);
    S64(_vars_base + _hvi * 8, 8);
    SVDEAD(S, _hvi, 1);
    SVCNT(S, _hvi + 1);
    return 0 - 2 - _hvi;
}
# The NAMED sibling of _HTEMP: a `for x in ...` loop variable. Inside a fn it is a frame slot
# at the loop's scope depth, as it always was. At top level there is NO frame on any executable
# entry (ELF x86/aarch64, PE, Mach-O), and the frame slot it used to get there was an `[rbp-8]`
# store into nothing: every top-level for-in segfaulted, and every READ of the variable was
# `undefined variable` because top-level resolution never runs FINDLOCAL. So at top level it is
# a LIVE global; the loop's SCOPE_PUSH recorded GVCNT, so its SCOPE_POP takes the name out of
# scope and _HTLOOPEND re-marks it as a loop variable for the diagnostic. CHANGELOG [6.6.8]
fn _HTNAMED(S, noff): i64 {
    if (GINFN(S) == 1) {
        var li = GFLC(S);
        S64(S + 0x5D9D000 + li * 8, noff);
        SLDEP(S, li, GSDEP(S));
        SLTYPE(S, li, 0);
        SFLC(S, li + 1);
        return li;
    }
    var vi = GVCNT(S);
    S64(_varn_base + vi * 8, noff);
    S64(_vars_base + vi * 8, 8);
    SVCNT(S, vi + 1);
    return 0 - 2 - vi;
}
# After the loop's SCOPE_POP: dead mark 3 (not the block-var 2) so a later use of the name is
# told it was a loop variable — "declare it before the block" does not apply to one.
fn _HTLOOPEND(S, h): i64 {
    if (h < 0) { SVDEAD(S, 0 - 2 - h, 3); }
    return 0;
}
fn _HTSTORE(S, h): i64 {
    if (h >= 0) { EFLSTORE(S, h); } else { EVSTORE(S, 0 - 2 - h); }
    return 0;
}
fn _HTLOAD(S, h): i64 {
    if (h >= 0) { EFLLOAD(S, h); } else { EVLOAD(S, 0 - 2 - h); }
    return 0;
}

fn PARSE_SWITCH(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
    STI(S, GTI(S) + 1);
    PCMPE(S);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    # Pre-scan: collect case values to decide chain vs jump table
    var save_ti = GTI(S);
    var case_count = 0;
    var case_min = 0x7FFFFFFFFFFFFFFF;
    var case_max = 0;
    var has_default = 0;
    var pgo = 1;
    while (pgo == 1) {
        if (PEEKT(S) == 58) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) == 1) {
                var cv = PEEKV(S);
                if (case_count == 0) { case_min = cv; case_max = cv; }
                else {
                    if (cv < case_min) { case_min = cv; }
                    if (cv > case_max) { case_max = cv; }
                }
                case_count = case_count + 1;
            }
            # Skip to next case/default/} (track brace depth for block bodies)
            var _psd = 0;
            while (1) {
                if (PEEKT(S) == 13) { _psd = _psd + 1; }
                if (PEEKT(S) == 14) { if (_psd > 0) { _psd = _psd - 1; } else { break; } }
                if (_psd == 0 && PEEKT(S) == 58) { break; }
                if (_psd == 0 && PEEKT(S) == 59) { break; }
                if (PEEKT(S) == 12) { break; }
                STI(S, GTI(S) + 1);
            }
        }
        else { if (PEEKT(S) == 59) { has_default = 1;
                var _psd2 = 0;
                while (1) {
                    if (PEEKT(S) == 13) { _psd2 = _psd2 + 1; }
                    if (PEEKT(S) == 14) { if (_psd2 > 0) { _psd2 = _psd2 - 1; } else { break; } }
                    if (PEEKT(S) == 12) { break; }
                    STI(S, GTI(S) + 1);
                }
            }
            else { pgo = 0; } }
    }
    STI(S, save_ti);
    # Decide: jump table if >= 4 cases, density >= 1/3, and range < 256.
    # v4.8.2 lowered threshold from 50% (*2) to 33% (*3) — more real-world
    # enum-like switches with a few gaps now hit the O(1) dispatch path.
    # The 256-byte range cap keeps the jump table itself small.
    var range = case_max - case_min;
    var use_table = 0;
    if (case_count >= 4) {
        if (range + 1 <= case_count * 3) {
            # v4.8.2-alpha2: range cap raised 256 → 1024. Jump table is
            # (range+1) × 4 bytes, so a 1024-range table is ~4 KB of
            # .text — still tiny, and wider enum dispatches (e.g. the
            # 40+-variant tagged-union switches in libro / kybernet)
            # now hit the O(1) path.
            if (range < 1024) { use_table = 1; }
        }
    }
    # v5.6.0 + v5.11.39: jump-table path is x86-only. aarch64 and cx
    # take the chain path (linear comparison) — aarch64 has no jump-
    # table emitter today, and cx bytecode has no analog of rip-
    # relative LEA + indirect JMP via a packed-i32 table. Without
    # these guards the named-op layer would still no-op out for both
    # (the stubs in <arch>/emit.cyr are pure IR-record), but the
    # parser would still emit the `EJCC` jump pre-table that has no
    # corresponding back-patch on the no-op path — leaving a stranded
    # `ja default` in cx output. Setting use_table = 0 here keeps the
    # parser on the correctness-preserving chain path.
    if (_AARCH64_BACKEND == 1) { use_table = 0; }
    if (_TARGET_CX == 1) { use_table = 0; }
    # Allocate hidden global to hold switch value
    var swidx = _HTEMP(S);
    _HTSTORE(S, swidx);
    # v6.5.20: own the `break` chain for the duration of the case bodies so a
    # `break` inside a case leaves the SWITCH (C semantics), not the enclosing
    # loop. `continue` is a separate chain (0x18F898 / `_cont_vec`) and is deliberately
    # NOT captured — it must still continue the enclosing loop.
    var saved_brk = L64(S + 0x18F840);
    S64(S + 0x18F840, 0);
    _brk_depth = _brk_depth + 1;   # 6.6.7 — a `break` target (see _brk_chain_end)
    if (use_table == 1) {
        # === JUMP TABLE PATH ===
        # v5.11.39 path-A: dispatch sequence + reserved zero table
        # live in <backend>/emit.cyr. Parser keeps the `EJCC` call
        # between the two named ops since EJCC returns the
        # default-jump patch position (back-patched when the
        # `default:` case body is parsed).
        ESWITCH_DISPATCH_PRE(S, case_min, range);
        var default_patch = EJCC(S, 0x87);   # ja default
        var table_cp = ESWITCH_DISPATCH_TABLE(S, range);
        # v6.5.20: hand the table to the compaction repair. The `lea rcx,[rip+d32]`
        # inside ESWITCH_DISPATCH_TABLE needs no repair — the nine bytes between its
        # disp32 and table_cp are raw (`movsxd`/`add`/`jmp rax`) and can never match
        # the picker's `48 8B|89 85` probe, so no NOP run can be harvested between
        # them and the disp is shift-invariant.
        _sw_tbl_reg(S, table_cp, range + 1);
        var ti = 0;
        # Parse case bodies, patching table entries
        var ends: i64[256];   # v6.2.1: 256 jump-end slots (was bare [256]=256B=32 slots → OOB at >32 cases)
        var ec = 0;
        var default_cp = 0 - 1;   # filled in when `default:` is parsed
        var sgo = 1;
        while (sgo == 1) {
            if (PEEKT(S) == 58) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 1) { ERR_EXPECT(S, 1); }
                var val = PEEKV(S);
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
                STI(S, GTI(S) + 1);
                # Patch table entry: table[val - min] = body_cp - table_cp
                var body_cp = GCP(S);
                var toff = (val - case_min) * 4 + table_cp;
                var ta = _codebuf_base + toff;
                var trel = body_cp - table_cp;
                S64(ta, (L64(ta) >> 32 << 32) | (trel & 0xFFFFFFFF));
                # Parse case body
                var cgo = 1;
                while (cgo == 1) {
                    if (PEEKT(S) == 58) { cgo = 0; }
                    else { if (PEEKT(S) == 59) { cgo = 0; }
                        else { if (PEEKT(S) == 14) { cgo = 0; }
                            else { if (PEEKT(S) == 12) { cgo = 0; }
                                else { _PARSE_STMT_NESTED(S); } } } }
                }
                var _eg = _ends_guard(S, ec);
                var _ep = EJMP0(S);
                if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
            }
            else { if (PEEKT(S) == 59) {
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
                    STI(S, GTI(S) + 1);
                    # Default body — patch default_patch to here
                    EPATCH(S, default_patch);
                    default_patch = 0;
                    default_cp = GCP(S);
                    while (PEEKT(S) != 14) {
                        if (PEEKT(S) == 12) { break; }
                        _PARSE_STMT_NESTED(S);
                    }
                    var _eg = _ends_guard(S, ec);
                    var _ep = EJMP0(S);
                    if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
                }
                else { sgo = 0; } }
        }
        # Patch default jump if no default case was found
        if (default_patch > 0) { EPATCH(S, default_patch); }
        # Fill unpatched table entries. If a `default:` was present
        # (v4.8.2), gaps within [case_min, case_max] now jump to the
        # default body — before this fix they fell through to the
        # end of the switch, which silently hid sparse-case bugs at
        # the previous 50% density threshold (no gaps). When no
        # default exists, gaps still fall through.
        var end_cp = GCP(S);
        var gap_rel = end_cp - table_cp;
        if (default_cp >= 0) { gap_rel = default_cp - table_cp; }
        ti = 0;
        while (ti <= range) {
            var te = _codebuf_base + table_cp + ti * 4;
            if (load32(te) == 0) {
                S64(te, (L64(te) >> 32 << 32) | (gap_rel & 0xFFFFFFFF));
            }
            ti = ti + 1;
        }
        if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
        STI(S, GTI(S) + 1);
        for (var ei = 0; ei < ec; ei = ei + 1) { EPATCH(S, load64(&ends + ei * 8)); }
    } else {
        # === CHAIN PATH (original) ===
        var ends: i64[256];   # v6.2.1: 256 jump-end slots (see table-path note above)
        var ec = 0;
        var sgo = 1;
        while (sgo == 1) {
            if (PEEKT(S) == 58) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 1) { ERR_EXPECT(S, 1); }
                var val = PEEKV(S);
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
                STI(S, GTI(S) + 1);
                _HTLOAD(S, swidx);
                EPUSHR(S);
                EMOVI(S, val);
                EMOVCA(S);
                EPOPR(S);
                ECMPR(S);
                var skip = EJCC(S, 0x85);
                var cgo = 1;
                while (cgo == 1) {
                    if (PEEKT(S) == 58) { cgo = 0; }
                    else { if (PEEKT(S) == 59) { cgo = 0; }
                        else { if (PEEKT(S) == 14) { cgo = 0; }
                            else { if (PEEKT(S) == 12) { cgo = 0; }
                                else { _PARSE_STMT_NESTED(S); } } } }
                }
                var _eg = _ends_guard(S, ec);
                var _ep = EJMP0(S);
                if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
                EPATCH(S, skip);
            }
            else { if (PEEKT(S) == 59) {
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
                    STI(S, GTI(S) + 1);
                    # NOTE (v6.5.20): unlike the table path, this body deliberately gets
                    # NO jump to the end of the switch — the chain path REACHES its
                    # default by falling out of the last comparison, so the default body
                    # must be emitted last and control already lands past it. A
                    # `default:` written before another arm is rejected outright
                    # (`unexpected case`) by the `!= 14` loop above, so there is no
                    # silent fall-through here. Do not "fix" this into an EJMP0 without
                    # also giving a non-last default a jump-over + backward entry.
                    while (PEEKT(S) != 14) {
                        if (PEEKT(S) == 12) { break; }
                        _PARSE_STMT_NESTED(S);
                    }
                }
                else { sgo = 0; } }
        }
        if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
        STI(S, GTI(S) + 1);
        for (var ei = 0; ei < ec; ei = ei + 1) { EPATCH(S, load64(&ends + ei * 8)); }
    }
    _brk_chain_end(S, saved_brk);
    return 0;
}

# Parse: match expr { val => { stmts } val => { stmts } _ => { stmts } }
fn PARSE_MATCH(S): i64 {
    # v5.8.22 bite #2 — capture match-keyword line for exhaustive-
    # coverage diagnostic before STI consumes it.
    var match_line = GTLINE(S, GTI(S));
    STI(S, GTI(S) + 1);
    PCMPE(S);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    # Store match value in hidden temp var
    var midx = _HTEMP(S);
    _HTSTORE(S, midx);
    # v6.5.20: `break` inside a match arm leaves the MATCH — same chain protocol
    # as PARSE_SWITCH / PARSE_WHILE. Untouched before this, so it either broke the
    # enclosing loop or left an unpatched wild jump. CHANGELOG [6.5.20]
    var saved_brk = L64(S + 0x18F840);
    S64(S + 0x18F840, 0);
    _brk_depth = _brk_depth + 1;   # 6.6.7 — a `break` target (see _brk_chain_end)
    var ends: i64[256];   # v6.2.1: 256 match-arm jump-end slots (was [256]=32 slots → OOB at >32 arms)
    var ec = 0;
    # v5.8.22 bite #2 — exhaustive-match coverage tracking. When the
    # arm's pattern is a bare-or-payloaded variant of an enum, look
    # up its parent enum-id (var_enum_id at 0x204000, written by
    # PARSE_ENUM_DEF in bite #1). First variant arm sets match_eid;
    # subsequent variant arms must share the same eid (mixed → warn).
    # had_default tracks whether `_ =>` was present (opt-out). Final
    # check: if eid != 0 && !had_default && covered < total → warn.
    var match_eid = 0;
    var match_covered = 0;
    var match_mixed = 0;
    var had_default = 0;
    # v5.8.25 — arm-tag dedup. Stack array of variant vcnts seen
    # so far; per-arm linear scan flags duplicate arms with
    # `warning: duplicate match arm 'X'` and skips counting the
    # dup toward match_covered (so the non-exhaustive check
    # stays accurate when a user writes the same variant twice).
    # 256 cap matches the per-match arm budget; beyond that no
    # dedup (rare-edge tolerated). Linear scan is O(N²) but
    # typical match has 2-10 arms so cost is negligible.
    var seen_vcnt: i64[256];   # v6.2.1: matches the `seen_count < 256` guard (was [256]=32 slots → OOB at >32 unique variants)
    var seen_count = 0;
    var mgo = 1;
    while (mgo == 1) {
        if (PEEKT(S) == 14) { mgo = 0; }
        # v6.5.19: EOF guard (CVE-39). `fn f() { match` and `fn f() { match (` SIGSEGV'd
        # at 6.5.18 — and this one bit FASTEST of the whole class, because the arm loop
        # writes `ends`/`seen_vcnt`, which are 256-slot LOCAL (stack) arrays: a runaway
        # arm count smashes the frame long before any heap table overflows.
        elif (PEEKT(S) == 12) { mgo = 0; }
        else {
            # Check for _ (wildcard/default)
            var is_default = 0;
            if (PEEKT(S) == 2) {
                # Check if identifier is "_"
                var mnoff = PEEKV(S);
                if (load8(S + 0xEC00000 + mnoff) == 95) {
                    if (load8(S + 0xEC00000 + mnoff + 1) == 0) {
                        is_default = 1;
                    }
                }
            }
            if (is_default == 1) {
                had_default = 1;
                # _ => { stmts }
                STI(S, GTI(S) + 1);
                # Expect =>
                if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 20) { ERR_EXPECT(S, 20); }
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
                STI(S, GTI(S) + 1);
                SCOPE_PUSH(S);
                PARSE_PROG(S);
                SCOPE_POP(S);
                if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
                STI(S, GTI(S) + 1);
                # v6.5.20: the `_ =>` arm emitted no jump to the end of the match,
                # so a wildcard arm written before another arm FELL THROUGH into
                # that arm's comparison and a LATER arm could win — a silent wrong
                # answer (`match 2 { 1 => 11  _ => 7  2 => 22 }` gave 22, not 7).
                # A wildcard matches everything, so the arms after it are dead.
                # PARSE_SWITCH's chain-path `default:` looks like the same shape but
                # is NOT: a non-last `default:` is rejected there at parse time.
                var _eg = _ends_guard(S, ec);
                var _ep = EJMP0(S);
                if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
            } else {
                # v5.8.22 bite #2 — pre-PCMPE peek: if the arm pattern's
                # first token is a variant-of-enum ident, record its
                # parent eid. Bare variants (`Ok`) and payload-bearing
                # variants (`Ok(v)`) both have the variant name as the
                # first ident. Non-variant arms (literals, regular
                # const vars, complex exprs) skip the bookkeeping.
                if (PEEKT(S) == 2) {
                    var arm_noff = PEEKV(S);
                    var arm_vi = FINDVAR(S, arm_noff);
                    if (arm_vi >= 0) {
                        var arm_eid = GVENUMID(S, arm_vi);
                        if (arm_eid > 0) {
                            # v5.8.25 — dedup: scan seen_vcnt for arm_vi.
                            # If found, emit duplicate-arm warning + skip
                            # coverage bump (accurate non-exhaustive math).
                            # If new, record + bump as before.
                            var dupe = 0;
                            var di = 0;
                            while (di < seen_count) {
                                if (load64(&seen_vcnt + di * 8) == arm_vi) { dupe = 1; }
                                di = di + 1;
                            }
                            if (dupe == 1) {
                                syscall(SYS_WRITE, 2, "warning:", 8);
                                _err_head(S);
                                syscall(SYS_WRITE, 2, ": duplicate match arm '", 23);
                                PRSTR(S + 0xEC00000 + arm_noff);
                                syscall(SYS_WRITE, 2, "'\n", 2);
                            } else {
                                if (seen_count < 256) {
                                    store64(&seen_vcnt + seen_count * 8, arm_vi);
                                    seen_count = seen_count + 1;
                                }
                                if (match_eid == 0) { match_eid = arm_eid; }
                                if (arm_eid == match_eid) {
                                    match_covered = match_covered + 1;
                                } else {
                                    match_mixed = 1;
                                }
                            }
                        }
                    }
                }
                # val => { stmts }
                _HTLOAD(S, midx);
                EPUSHR(S);
                PCMPE(S);
                EMOVCA(S);
                EPOPR(S);
                ECMPR(S);
                var skip = EJCC(S, 0x85);
                # Expect =>
                if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 20) { ERR_EXPECT(S, 20); }
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
                STI(S, GTI(S) + 1);
                SCOPE_PUSH(S);
                PARSE_PROG(S);
                SCOPE_POP(S);
                if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
                STI(S, GTI(S) + 1);
                var _eg = _ends_guard(S, ec);
                var _ep = EJMP0(S);
                if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
                EPATCH(S, skip);
            }
        }
    }
    STI(S, GTI(S) + 1);
    for (var ei = 0; ei < ec; ei = ei + 1) { EPATCH(S, load64(&ends + ei * 8)); }
    _brk_chain_end(S, saved_brk);
    # v5.8.22 bite #2 — exhaustive-match coverage check. Warning (not
    # error) so v5.8.x downstream consumers can adopt incrementally —
    # same trade-off as #must_use / #deprecated / #pure→#io. Promotes
    # to lint --strict in a follow-up slot.
    if (match_eid != 0) {
        if (match_mixed == 1) {
            syscall(SYS_WRITE, 2, "warning:", 8);
            FM_LOOKUP(S, match_line);
            syscall(SYS_WRITE, 2, ": match arms span multiple enums (exhaustive-coverage check skipped)\n", 69);
        } else {
            if (had_default == 0) {
                var match_total = GENUMVCNT(S, match_eid - 1);
                if (match_covered < match_total) {
                    syscall(SYS_WRITE, 2, "warning:", 8);
                    FM_LOOKUP(S, match_line);
                    syscall(SYS_WRITE, 2, ": non-exhaustive match over enum '", 34);
                    PRSTR(S + 0xEC00000 + GENUMNM(S, match_eid - 1));
                    syscall(SYS_WRITE, 2, "' — covers ", 13);
                    PRNUM(match_covered);
                    syscall(SYS_WRITE, 2, " of ", 4);
                    PRNUM(match_total);
                    syscall(SYS_WRITE, 2, " variants; add `_ =>` to opt out\n", 33);
                }
            }
        }
    }
    return 0;
}

# The highest token index whose failing #assert was reported. Now that a failure no longer
# exits, the replays of the same tokens (an #inline body re-parsed at every call site) must
# not report it again: in pass 2 the cursor only moves forward except in such a replay.
# CHANGELOG [6.6.11]
var _assert_rep_ti = 0 - 1;

# The tail of an #assert, from wherever its operands and `,` ended: the rest of THAT line
# (the message string), then one `;`. Shared by PARSE_STMT's arm and the pass-1 skip
# (_tl_assert), so both passes stop on the same token. CHANGELOG [6.6.9]
# ⛔ v6.5.39 — the newline stop is load-bearing: testing only `;` (5) and EOF (12) let a
# `#assert` with no trailing `;` skip across the following `fn` header and eat its first
# statement — silent wrong code, no diagnostic.
# ⛔ 6.6.11 — the line is the LAST CONSUMED token's (an operand or the `,`), not the cursor's:
# with no `,`, message or `;`, the cursor already sits on the NEXT line, and taking its line
# ate that whole line — `#assert 1 == 1<LF> return 42;` dropped the return, silently. A
# string AT the cursor is this assert's message wherever it sits (`#assert X,<LF> "msg";`),
# which is also what the failure printer reads. CHANGELOG [6.6.11]
fn _assert_tail(S): i64 {
    var ln = GTLINE(S, GTI(S) - 1);
    if (PEEKT(S) == 30) { ln = GTLINE(S, GTI(S)); }
    while (PEEKT(S) != 5 && PEEKT(S) != 12) {
        if (GTLINE(S, GTI(S)) != ln) { break; }
        STI(S, GTI(S) + 1);
    }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# 6.6.10 — the operands of an #assert (`ATOM [OP ATOM]`) may be followed only by `,` (the
# message), the message string itself (the comma-less `#assert 1 == 1 "ok"` form the failure
# printer has always honoured), `;`, EOF, or a token on a LATER line. _assert_tail skips
# the rest of the line unchecked, so `#assert E.EB * 2 == 9;` evaluated `E.EB` alone and a
# FALSE assertion compiled green, as did `#assert 4 == 4 junk;`. Reports once (ERR_MSG
# latches) and returns 1; the caller then drops the "#assert failed" cascade. CHANGELOG [6.6.10]
fn _assert_operands_end(S): i64 {
    var t = PEEKT(S);
    if (t == 31) { return 0; }
    if (t == 30) { return 0; }
    if (t == 5) { return 0; }
    if (t == 12) { return 0; }
    if (GTLINE(S, GTI(S)) != GTLINE(S, GTI(S) - 1)) { return 0; }
    ERR_MSG(S, "#assert: expected `,` or `;` after the operands (no arithmetic inside #assert)", 78);
    return 1;
}

# 6.6.10 — ONE recogniser for an enum-constant atom: `NAME` or `Enum.NAME`, where NAME is a
# folded enum constant (the GVECP flag). Shared by #assert (_EVAL_CONST_ATOM) and both
# array-size parsers (PARSE_ARRAY, and the top-level one in parse_decl.cyr), which each
# hand-rolled the bare form only — so `#assert EB == 4` and `var buf[E.EB]` were refused
# while `syscall(60, E.EB)` compiled. As in expressions, a base that is a VARIABLE makes
# `.NAME` a field access, not a variant. Returns the var index and advances past the atom,
# or -1 without moving (spelled `0 - 1`: cybs has no unary minus). CHANGELOG [6.6.10]
fn _enum_atom_idx(S): i64 {
    if (PEEKT(S) != 2) { return 0 - 1; }
    var ti = GTI(S);
    var vn = PEEKV(S);
    if (TOKTYP(S, ti + 1) == 41) {
        if (TOKTYP(S, ti + 2) != 2) { return 0 - 1; }
        if (GINFN(S) == 1) { if (FINDLOCAL(S, vn) >= 0) { return 0 - 1; } }
        if (FINDVAR(S, vn) >= 0) { return 0 - 1; }
        var qvi = _enum_qual_resolve(S, ti);
        if (qvi < 0) { return 0 - 1; }
        STI(S, ti + 3);
        return qvi;
    }
    var vi = FINDVAR(S, vn);
    if (GVECP(S, vi) != 1) { return 0 - 1; }
    STI(S, ti + 1);
    return vi;
}

# ⛔ 6.6.11 — `Base.NAME` resolved NAME alone and never looked at Base: `Foo.EB` (no such
# enum) and `E2.EB` (EB belongs to E1) compiled in expressions, #assert and array sizes,
# `Nope.gz` loaded the plain global gz, and with a variant name shared by two enums `A.X`
# read B's X. ONE resolver for all three sites. Base is known not to be a variable (that
# is a field access). Returns NAME's slot IN Base's enum; when NAME is a global but Base is
# not an enum, or not NAME's enum, reports it and returns FINDVAR's slot (the caller goes on
# as before, no cascade); -1 when NAME is no global at all (the caller's own path, as
# before). CHANGELOG [6.6.11]
fn _enum_qual_resolve(S, bti): i64 {
    var bnoff = TOKVAL(S, bti);
    var vn = TOKVAL(S, bti + 2);
    var vi = _enum_variant_in(S, bnoff, vn);
    if (vi >= 0) { _vis_check_var(S, vi, vn); return vi; }
    var any = FINDVAR(S, vn);
    if (any < 0) { return 0 - 1; }
    var sv = GTI(S);
    if (_enum_id_of(S, bnoff) == 0) {
        STI(S, bti);
        ERR_IDENT(S, "", bnoff, " is not an enum", 0 - 1);
    } else {
        STI(S, bti + 2);
        ERR_IDENT(S, "", vn, " is not a variant of ", bnoff);
    }
    STI(S, sv);
    return any;
}

# The slot of the enum constant `vn` declared in an enum NAMED `bnoff`, or -1. Walks every
# global of that name (FINDVAR returns only the LAST) and compares the parent's NAME, not
# its id: an enum name may be declared more than once (lib/syscalls*.cyr each declare
# `Signal`, and a program may declare its own). CHANGELOG [6.6.11]
fn _enum_variant_in(S, bnoff, vn): i64 {
    var e = _fvh_head(S, vn);
    while (e != 0) {
        var vi = e - 1;
        if (GVECP(S, vi) == 1) {
            var pe = GVENUMID(S, vi);
            if (pe > 0) { if (STREQ(S, GENUMNM(S, pe - 1), bnoff) == 1) { return vi; } }
        }
        e = _fvh_next(vi);
    }
    return 0 - 1;
}

# `sizeof` as a whole identifier: the 6 letters AND the NUL after them (7 bytes). A 6-byte
# prefix test took `sizeofzz(P)` for sizeof. Also used by pass 1's _assert_skip_atom.
fn _is_sizeof_word(S, noff): i64 {
    if (L64(S + 0xEC00000 + noff) & 0xFFFFFFFFFFFFFF == 0x666F657A6973) { return 1; }
    return 0;
}

# `mulh64` as a whole identifier, the same 7-byte test. PARSE_FACTOR's 6-byte prefix test
# compiled a user fn `mulh64x(a, b)` as the intrinsic. CHANGELOG [6.6.11]
fn _is_mulh64_word(S, noff): i64 {
    if (L64(S + 0xEC00000 + noff) & 0xFFFFFFFFFFFFFF == 0x3436686C756D) { return 1; }
    return 0;
}

# An IDENT-spelled intrinsic that PARSE_FACTOR lowers inline: `sizeof(..)`, `mulh64(..)`.
# Neither is a fn, so `return sizeof(i64);` must not take the tail-call path, which
# jumped to an undefined fn of that name. CHANGELOG [6.6.11]
fn _is_ident_intrinsic(S, noff): i64 {
    if (_is_sizeof_word(S, noff) == 1) { return 1; }
    return _is_mulh64_word(S, noff);
}

# ⛔ 6.6.20 — THE IDENTIFIER-SPELLED INTRINSICS ARE RESERVED NAMES. `sizeof` / `mulh64`
# (_is_ident_intrinsic) and `fncall0`..`fncall8` (_IS_FNCALL_NAME) lex as plain IDENTs and are
# lowered BY NAME at the call, so they sit in neither of util.cyr's reserved tables
# (TOKNAME_BUILTIN / IS_KEYWORD_TOK) and nothing refused them as a declaration:
#   * `fn mulh64(a, b)` compiled and every call got the intrinsic (the fn: "unreachable");
#   * `fn fncall1(a, b)` compiled and `fncall1(5, 6)` called THROUGH 5 — SIGSEGV;
#   * `fn sizeof()` / `var sizeof` / a param `mulh64` declared, and every use was a parse
#     error about a `(` that was never wanted.
# Lexer tokens would have meant re-plumbing every by-name site and could not express the one
# legitimate declarer below, so the refusal is made where a NAME IS DECLARED: fn, param,
# closure param, local / `stack` / global var, `for` binding, `use m.NAME;` (_tl_use) — which
# binds the BARE name — and a PAYLOAD enum variant (PARSE_ENUM_DEF), whose constructor is a fn
# under the bare variant name with no qualified form. A UNIT variant declares no fn and is
# accepted (read it `E.mulh64`). A module- or impl-mangled DEFINITION (`m_sizeof`, `T_mulh64`)
# is accepted, so a fn is judged AFTER mangling; re-exposing it bare with `use` is refused.
# ⚠ THE ONE LEGITIMATE DECLARER is lib/fnptr.cyr's `fncall0`..`fncall8`: those definitions ARE
# the lowering's enabler (it is gated on FINDFN, so a program that never included fnptr still
# gets "undefined function"), and cybs — which has no lowering — calls them in gen1. Exempt by
# FILE: an included file whose basename is `fnptr.cyr` (every copy in the ecosystem, surveyed
# 6.6.20, is one). The main source carries no file name (its map entry is `<source>`), so
# lib/fnptr.cyr fed AS the entry is refused — deliberately: exempting the main source is the
# filed repro's own shape. CHANGELOG [6.6.20]
fn _rsv_in_fnptr(S, ti): i64 {
    var fid = FM_FILEID(S, GTLINE(S, ti));
    # ⚠ -1 (the file map overflowed) fails OPEN, against FM_FILEID's fail-closed contract: closed
    # would refuse a real lib/fnptr.cyr included past the cap; open only restores pre-6.6.20.
    if (fid == 0 - 1) { return 1; }
    if (fid <= 0) { return 0; }
    var p = S + 0x721000 + fid - 1;
    var n = 0;
    while (load8(p + n) != 0) { n = n + 1; }
    if (n < 9) { return 0; }
    var q = p + n - 9;
    if (load64(q) != 0x79632E7274706E66) { return 0; }   # "fnptr.cy"
    if (load8(q + 8) != 114) { return 0; }               # "r"
    if (n == 9) { return 1; }
    if (load8(q - 1) == 47) { return 1; }                # '/'
    if (load8(q - 1) == 92) { return 1; }                # '\'
    return 0;
}

# Refuse declaring `noff` (its name token is `ti`) when it spells an identifier intrinsic.
# `isfn` = 1 for a fn definition, the only kind lib/fnptr.cyr's exemption applies to. An
# instance re-parses its base's tokens, so it was already judged there. 1 = refused.
# ⚠ Only an IDENT token's value is a name offset: every caller has already reported a non-IDENT
# (`var 140737488355327 = 1;`), and reading its NUMBER as an offset into the name pool faulted.
fn _RSV_INTRINSIC_DECL(S, noff, ti, isfn): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (_inst_name != 0) { return 0; }
    if (_is_ident_intrinsic(S, noff) == 0) {
        if (_IS_FNCALL_NAME(S, noff) == 0) { return 0; }
        if (isfn == 1) { if (_rsv_in_fnptr(S, ti) == 1) { return 0; } }
    }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": reserved intrinsic name '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("' (cannot be used as an identifier: the compiler lowers every call to it; rename the fn/variable/param)\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    return 1;
}

# Evaluate a single constant atom for #assert: number literal, sizeof(T), or an enum
# constant (`NAME` / `Enum.NAME`, 6.6.10). Returns the constant value. Advances TI past the
# consumed tokens.
fn _EVAL_CONST_ATOM(S): i64 {
    var t = PEEKT(S);
    if (t == 1) {
        var v = PEEKV(S);
        STI(S, GTI(S) + 1);
        return v;
    }
    if (t == 2) {
        var noff = PEEKV(S);
        var ei = _enum_atom_idx(S);
        if (ei >= 0) { return L64(_vecv_base + ei * 8); }
        # sizeof(Type)
        if (_is_sizeof_word(S, noff) == 1) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
            STI(S, GTI(S) + 1);
            var szval = 0;
            # 6.6.16 (C8): the one resolver, as the expression's sizeof — and u128 (a keyword token,
            # it was `expected ')'` here). An unknown name is refused naming it. CHANGELOG [6.6.16]
            if (PEEKT(S) == 2 || PEEKT(S) == 105) {
                szval = _sizeof_type(S, 1);   # 6.6.17: + `<..>` (_sizeof_type)
            }
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
            STI(S, GTI(S) + 1);
            return szval;
        }
        ERR_MSG(S, "#assert: expected a number, sizeof(T) or an enum constant", 57);
    }
    ERR_MSG(S, "#assert: expected constant expression", 37);
    return 0;
}

# v6.4.62 (DX multi-error): the recovery chokepoint. Every statement parse goes
# through this wrapper, so when a nested error set _panic we resync to the next
# statement boundary (_sync_skip) once, at the tightest enclosing statement. The
# guaranteed-progress guard (GTI must advance or force one token) stops the
# enclosing block/PROG loop from spinning if a statement made no progress; the
# PEEKT watchdog is the deeper backstop for loops that never return here. On VALID
# input _panic is never set and every statement advances → pure pass-through (byte-id).
# 6.6.5 — ONE OPERAND of `dst = src` between aggregates, resolved to its recorded layout.
# Fills `_agc_li` (a LOCAL's named slot) or `_agc_gvi` (a GLOBAL's slot) plus `_agc_t` (the
# type, normalised to the local `0 - sid` convention), and returns the SLOT SPAN — 0 when
# this name is not an inline aggregate, so the caller falls through to the 8-byte store.
# ⚠ THE TWO FRAMES COUNT IN OPPOSITE DIRECTIONS and the emit loop below is the only place
# that has to know: a local aggregate is named at its DEEPEST slot, so its word k is slot
# `li - k`; a global's fields ascend from its named slot (`EVADDR(gvi) + off`), so its word k
# is slot `gvi + k`. CHANGELOG [6.6.5]
# 6.6.6 — `_agc_pp` is the third answer: the operand IS an aggregate, but its slot holds the
# ADDRESS of one (a by-value struct PARAMETER). Read it beside `_agc_li`; the copy below takes
# the addressed path for it exactly as it does for a global. CHANGELOG [6.6.6]
# ⛔ 6.6.16 (C2) — `_agc_pp == 2` is a HANDLE: a slot holding the address of a plain struct over
# 8 B that is NOT the struct's value — a pointer-mode local (`var a: Pt = alloc(16);`) or a `*T`
# parameter. A pointer-mode GLOBAL handle publishes `_agc_gvi` in the deref band `0 - 1000 - gvi`
# instead (`_agc_addr_x1` loads the slot, as `_AGC_DREF` does for a local), so a consumer testing
# `>= 0` before SLVAR skips it: the global itself is not written. Both copy through the address
# exactly as `_agc_pp == 1` does; the difference is the RULE: handle <- handle is a pointer
# REBIND (`_try_aggregate_copy_assign`), every other pair with a handle in it is a copy. Before,
# `_agc_operand` reported a handle as "not an aggregate" and every arm fell to the one-word store
# — the address into an inline struct's field 0, or field 0's value into the handle (SIGSEGV at
# the next `a.x`). Read `_agc_hdl()` for "is a handle". CHANGELOG [6.6.16]
var _agc_li = 0 - 1;
var _agc_gvi = 0 - 1;
var _agc_t = 0;
var _agc_pp = 0;
fn _agc_hdl(): i64 {
    if (_agc_pp == 2) { return 1; }
    if (_agc_gvi <= 0 - 1000) { return 1; }
    return 0;
}
# 1 = `t` (a `0 - sid` type) is a plain struct over 8 B — the only kind a handle copies. `Str` /
# `Result` / `Option` / `Tagged` are excluded by name through the classifier that builds a fn's
# structmask, as `_local_is_sptr_param` excludes them: their slots hold heap handles that every
# assignment rebinds (the stdlib's convention). A <= 8 B struct is held by value. CHANGELOG [6.6.16]
fn _agc_plain_big(S, t): i64 {
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }
    var si = (0 - t) - 1;
    if (STRUCTSZ(S, si) <= 8) { return 0; }
    if (_classify_param_type(S, L64(S + 0x1A6018 + si * 8)) != 0) { return 0; }
    return 1;
}
# A one-slot struct local (GLAGG == 0): an address-passed by-value parameter (`_agc_pp` 1), a
# handle (2), or not an aggregate operand (0 returned). Kept out of `_agc_operand` for cybs's
# per-fn reference limit. Since C7 a by-value parameter is copied into an inline local in the
# prologue (`_sptr_params_localize`), so 1 is left only for a `#naked` fn's. CHANGELOG [6.6.16]
fn _agc_handle_local(S, li): i64 {
    var lt = GLTYPE(S, li);
    if (_agc_plain_big(S, lt) == 0) { return 0; }
    _agc_pp = 2;
    if (_local_is_sptr_param(S, li) == 1) { if (_is_ptr_param(S, li) == 0) { _agc_pp = 1; } }
    _agc_li = li;
    _agc_t = lt;
    var n = AGG_NSLOTS(S, lt);
    return n;
}
# A pointer-mode global (GVPM 1) of a plain struct over 8 B: a handle, in the deref band.
fn _agc_handle_global(S, gvi): i64 {
    if (GVPM(S, gvi) != 1) { return 0; }
    var t = 0 - GVTYPE(S, gvi);
    if (_agc_plain_big(S, t) == 0) { return 0; }
    _agc_gvi = 0 - 1000 - gvi;
    _agc_t = t;
    var n = AGG_NSLOTS(S, t);
    return n;
}
fn _agc_operand(S, onoff): i64 {
    _agc_li = 0 - 1;
    _agc_gvi = 0 - 1;
    _agc_t = 0;
    _agc_pp = 0;
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, onoff);
        if (li >= 0) {
            if (GLAGG(S, li) == 0) {
                # 6.6.6 — span 0 is "not inline", which an address-passed struct parameter also
                # is. It owns ONE slot holding the caller's pointer, so it is an aggregate
                # operand reached through one indirection. See `_local_is_sptr_param`.
                # 6.6.16 (C2): and so is a handle. See `_agc_handle_local`.
                var hn = _agc_handle_local(S, li);
                return hn;
            }
            var lt = GLTYPE(S, li);
            if (lt >= 0) { return 0; }
            _agc_li = li;
            _agc_t = lt;
            var ln = AGG_NSLOTS(S, lt);
            return ln;
        }
    }
    var gvi = FINDVAR(S, onoff);
    if (gvi < 0) { return 0; }
    # 2 == the slot IS the struct. 1 == it holds an address, 0 == not a recorded aggregate.
    # GVTYPE's positive range is shared with scalar widths, so it is never the gate.
    # 6.6.16 (C2): a 1 is a handle (`_agc_handle_global`), no longer "not an aggregate".
    if (GVPM(S, gvi) != 2) {
        var hg = _agc_handle_global(S, gvi);
        return hg;
    }
    var gt = GVTYPE(S, gvi);
    if (gt <= 0) { return 0; }
    _agc_gvi = gvi;
    _agc_t = 0 - gt;
    var gn = AGG_NSLOTS(S, 0 - gt);
    return gn;
}

# ⛔ 6.6.13 — the SOURCE operand of `dst = src;`: `_agc_operand`, plus a closure CAPTURE between the
# local and the global rung (PARSE_FACTOR's order). Without it `q = p;` / `G = p;` / `w = v;`
# inside a closure stored the capture's address as one word. A capture is recorded for
# `_fsc_src_x1` (see `_fsc_cap_src`) and answered as the `-2` source. Never asked for the
# DESTINATION, which must not touch that record. CHANGELOG [6.6.13]
fn _agc_src_operand(S, onoff): i64 {
    if (GINFN(S) == 1) { if (FINDLOCAL(S, onoff) >= 0) { return _agc_operand(S, onoff); } }
    var t = _fsc_cap_src(S, onoff);
    if (t == 0) { return _agc_operand(S, onoff); }
    _agc_li = 0 - 2;
    _agc_gvi = 0 - 1;
    _agc_pp = 0;
    _agc_t = t;
    return AGG_NSLOTS(S, t);
}

# ⛔ 6.6.6 — `x = f(..);` where `x` is an inline struct (local or global) and `f` returns that
# struct BY VALUE. The declaration form (`var x: S = f(..)`) always had a destination; this one
# fell to the scalar store, so a >16 B return had no retptr at all (x86: SIGSEGV writing through
# argument 1; aarch64: exit 0 with `x.x` = a stack address) and a 9-16 B one kept rax and dropped
# rdx (`q = p2(3, 4)` left `q.y` stale). Now: the call into a temp, then the same copy `x = t`
# performs. Through a temp rather than straight into `x`, so an argument that reads `x` (or is
# `x`, address-passed) sees the old value. At top level there is no frame for the temp: a
# retptr callee is refused by PARSE_FNCALL, a rax:rdx one here. CHANGELOG [6.6.6]
fn _try_struct_call_assign(S, noff, term): i64 {
    # ⛔ 6.6.10 (bite 7 review): `name<..>(` too, and the fn the call REACHES. `r = mk(p);` into a
    # `Box<Pt>` local compared the base's `Box` return, missed, and fell to the scalar store —
    # fields stale, silently; the explicit `r = mk<Pt>(p);` did the same once its return type
    # named the instance.
    var o = _gcall_open(S, GTI(S));
    if (o < 0) { return 0; }
    var fi = _gen_resolve_call(S, GTI(S));
    if (_call_follow(S, o - 1) != term) { return 0; }
    var n = _agc_operand(S, noff);
    # ⛔ 6.6.11 — THE TYPE CHECK COMES BEFORE EVERY EXIT. `p = mkq();` (Q into a Pt) returned 0 at
    # the sid test below and the scalar store kept one word, silently; a <= 8 B result had already
    # left at `cls == 0`, and a one-slot destination at `n <= 1`. The declaration form refuses
    # all of these. A generic call is compared as the instance it reaches, so `s = mk(r.v)` into
    # a `Box<Pt>` (the field argument infers T = i64) is refused by name. CHANGELOG [6.6.11]
    if (_sca_mismatch(S, fi, noff) == 1) { return 0; }
    var cls = _ret_agg_class(S, fi);
    if (cls == 0) { return 0; }
    if (n <= 1) { return 0; }
    if (_agc_t != 0 - GFRS(S, fi)) { return 0; }
    if (GINFN(S) != 1) {
        if (cls == 1) { _refuse_toplevel_struct_call(S, PEEKV(S)); }
        return 0;
    }
    var dli = _agc_li;
    var dgv = _agc_gvi;
    if (_agc_pp != 0) { dli = _AGC_DREF(dli); }   # 6.6.16 (C2): a handle copies through it too
    var t = _struct_call_into_temp(S);
    _agc_from_temp(S, t, dli, dgv, n, GFRS(S, fi));
    if (PEEKT(S) != term) { ERR_EXPECT(S, term); }
    STI(S, GTI(S) + 1);   # consume the terminator
    return 1;
}

# `x = f(..);` — x a struct operand (`_agc_operand` just ran) and f returning a DIFFERENT struct:
# refused by name (1). Reads `_agc_t`. CHANGELOG [6.6.11]
# 6.6.16 (C2): into a HANDLE, a call returning a struct HANDLE (`Str`: class 0 over 8 B, the
# address in rax) is handle <- handle, a rebind at any type — as before, when a handle was not an
# operand at all. A struct VALUE of a different type is refused, as into an inline one.
fn _sca_mismatch(S, fi, noff): i64 {
    if (fi < 0) { return 0; }
    if (_grc_err < 0) { return 0; }   # a failed instantiation: the call refuses itself, once
    var rs = GFRS(S, fi);
    if (rs <= 0) { return 0; }
    if (_agc_hdl() == 1) { if (_ret_agg_class(S, fi) == 0) { if (STRUCTSZ(S, rs - 1) > 8) { return 0; } } }
    return _AGG_ASSIGN_TYPE_ERR(S, _agc_t, 0 - rs, noff, PEEKV(S));
}

# The copy both struct-call assignments end with: temp `t` (field-0 slot, `n` slots of struct
# `sid`) into the destination local `dli` or global `dgv` (the other is -1). A `dli` in the
# `_AGC_DREF` band is a by-value PARAMETER whose slot holds the struct's ADDRESS (6.6.6) — the
# slot-index loop cannot express that, so it takes the same addressed copy a global takes.
# CHANGELOG [6.6.6]
# 6.6.16 (C2): a `dgv` in the deref band (`<= -1000`, a pointer-mode global handle) is addressed
# too, and never SLVAR'd — the global's own slot is not written. CHANGELOG [6.6.16]
fn _agc_from_temp(S, t, dli, dgv, n, sid): i64 {
    if (dgv != 0 - 1) {
        _agc_copy_bytes(S, 0 - 1, dgv, t, 0 - 1, STRUCTSZ(S, sid - 1));
        if (dgv >= 0) { SLVAR(S, dgv); }
        return 0;
    }
    if (dli <= 0 - 1000) {
        _agc_copy_bytes(S, dli, 0 - 1, t, 0 - 1, STRUCTSZ(S, sid - 1));
        return 0;
    }
    var i = 0;
    while (i < n) {
        EFLLOAD(S, t - i);
        EFLSTORE(S, dli - i);
        i = i + 1;
    }
    return 0;
}

# ⛔ 6.6.11 — COMPOUND ASSIGNMENT is ONE implementation, shared by the statement arm
# (_PARSE_STMT_IMPL) and the classic-for step replay (parse_ctrl.cyr). They were two copies and
# both were wrong about floats: the statement arm took its float routing from a LOCAL's type
# only, so `G += 1.0` on an f64 GLOBAL added the two bit patterns as integers, and the step copy
# had no float routing at all — `for (var x: f64 = 0.0; x < 1.0; x += 0.25)` ran 2 iterations,
# not 4. Neither checked the right operand, so `t += 1` on an f64 silently added a subnormal.
# Out of _PARSE_STMT_IMPL on purpose: cybs miscompiles that body SILENTLY past its per-fn
# reference limit. CHANGELOG [6.6.11]
# The `op =` pair at the cursor: consumes both and returns the op token, else 0.
fn _asg_compound_tok(S): i64 {
    var ct = PEEKT(S);
    if (ct == 6 || ct == 7 || ct == 8 || ct == 9 || ct == 34 || ct == 27 || ct == 35 || ct == 36 || ct == 38 || ct == 39) {
        var tn = GTI(S) + 1;
        if (tn < GTCNT(S)) {
            if (TOKTYP(S, tn) == 4) { STI(S, GTI(S) + 2); return ct; }
        }
    }
    return 0;
}
# 6.7.0 (A5) — cursor on the `.` after a statement's first IDENT: 1 when a chain of `.name`s ends in
# a call (`.m(`, `.v.m(`, `.next.v.m(`), so the statement is a method call; 0 for a field store. The
# cursor is left wherever the walk stopped (the caller rewinds).
fn _stmt_dot_chain_call(S): i64 {
    while (PEEKT(S) == 41) {
        if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
        STI(S, GTI(S) + 2);
        if (PEEKT(S) == 10) { return 1; }
    }
    return 0;
}
# Loads the left side (a local, else a global) into rax; returns its slot type.
# ⛔ 6.6.12 — AT THE SLOT'S WIDTH, as a read of it in an expression loads it. This loaded 8
# bytes, so `a >>= 1` on a u8 global followed by `var b: u8 = 1;` shifted b's byte down into a:
# 130 where 2 is right. A narrow local is its own 8-byte frame slot, so the full-width load
# read whatever an earlier full-width store had left above the low byte. CHANGELOG [6.6.12]
# 6.6.17: and records the slot's pointer step (`_asg_cstep`), which `_asg_compound_op` applies to
# `p += n` / `p -= n` as `p + n` applies it — the compound form never scaled at all.
var _asg_cstep = 0;
fn _asg_compound_load(S, noff): i64 {
    _asg_cstep = 0;
    if (_cur_iself_sid > 0) { if (_noff_is(S, noff, "self", 4) == 1) {   # 6.7.0 (A4): `self += n`
            ERR_IDENT(S, "compound assignment to an untyped `self` is refused - in an impl it points at ", L64(S + 0x1A6018 + (_cur_iself_sid - 1) * 8), ": declare `self: *T` to step whole elements", 0 - 1);
        } }
    var li = FINDLOCAL(S, noff);
    if (li >= 0) {
        var lt = _load_lt(S, li);
        _asg_cstep = _slot_ptr_step(S, li);
        if (lt > 0) { if (lt < 8) {
                var lw = lt;
                if (GSLICE_W(S, li) < 0) { lw = 0 - lt; }   # signed: movsx (parse_expr.cyr)
                EFLLOAD_W(S, li, lw);
                return lt;
            } }
        EFLLOAD(S, li);
        return lt;
    }
    var gi = FINDVAR(S, noff);
    if (gi >= 0) {
        _vecg_refuse(S, gi);   # 6.6.17 (a3)
        var gsz = L64(_vars_base + gi * 8);
        if (gsz < 8) {
            var gw = gsz;
            if (GVSGN(S, gi) == 1) { gw = 0 - gsz; }
            EVLOAD_W(S, gi, gw);
            return GVTYPE(S, gi);
        }
        if (GVTYPE(S, gi) < 0) { _asg_cstep = 0 - GVTYPE(S, gi); }   # a typed-pointer global
        EVLOAD(S, gi);
        return GVTYPE(S, gi);
    }
    return 0;
}

# ⛔ 6.6.12 — THE STORE OF AN ASSIGNMENT, at the slot's width: a local (g == 0) or a global
# (g == 1, then SLVAR) takes rax. ONE implementation for the statement arm (_PARSE_STMT_IMPL)
# and the classic-for step replay (parse_ctrl.cyr), which had its own 8-byte copy: `for (a = 250;
# a != 252; a = a + 1)` on a u8 global zeroed the seven packed globals after it, and `a += 1`
# carried 255 -> 0 into the next one. Warns on a narrowing store, as the statement always did.
fn _asg_store_slot(S, idx, g): i64 {
    var ew = GEXW(S);
    if (g == 0) {
        var lt = GLTYPE(S, idx);
        if (lt > 0) { if (lt <= 8) {
                if (ew > lt) { WARN(S, "narrowing assignment (value may truncate)", 41); }
                EFLSTORE_W(S, idx, lt);
                return 0;
            } }
        EFLSTORE(S, idx);
        return 0;
    }
    _vecg_refuse(S, idx);   # 6.6.17 (a3)
    var avsz = L64(_vars_base + idx * 8);
    if (avsz < 8) {
        if (ew > avsz) { WARN(S, "narrowing assignment (value may truncate)", 41); }
        EVSTORE_W(S, idx, avsz);
    }
    else { EVSTORE(S, idx); }
    SLVAR(S, idx);
    return 0;
}
# The float emitter op for `cop` on a slot of type `lt`: 0-3 for + - * / on f64/f32, else -1.
fn _asg_float_fop(cop, lt): i64 {
    if (lt != F64_TYID) { if (lt != F32_TYID) { return 0 - 1; } }
    if (cop == 6) { return 0; }
    if (cop == 7) { return 1; }
    if (cop == 8) { return 2; }
    if (cop == 9) { return 3; }
    return 0 - 1;
}
# Stack = x, rax = the right operand — EMIT_F{64,32}_BINOP's convention. Warns when the right
# operand is not the slot's kind (kind 1 for f64, kind 5 for f32), as `x = x + <rhs>` does.
fn _asg_compound_float(S, fop, lt): i64 {
    if (lt == F64_TYID) {
        if (_FBR_ST(S) != F64_TYID) { _FLT_TYPE_WARN(S, 1); }
        EMIT_F64_BINOP(S, fop);
        return 0;
    }
    if (_FBR_ST(S) != F32_TYID) { _FLT_TYPE_WARN(S, 5); }
    EMIT_F32_BINOP(S, fop);
    return 0;
}
# `x OP= <expr>` with rax = x (from _asg_compound_load, whose slot type is `lt`): leaves the
# combined value in rax for the caller's store. %, &, |, ^, <<, >> on a float slot take the
# integer arm, as they always have.
fn _asg_compound_op(S, cop, lt): i64 {
    var st = _asg_cstep;
    _asg_cstep = 0;
    EPUSHR(S);
    PCMPE(S);
    if (st > 1) { if (cop == 6 || cop == 7) { EPTR_SCALE(S, st); } }   # 6.6.17: `p += n` steps T
    var fop = _asg_float_fop(cop, lt);
    if (fop >= 0) { return _asg_compound_float(S, fop, lt); }
    EMOVCA(S);   # rcx = expr; pop rax = x; rax = x OP rcx
    EPOPR(S);
    if (cop == 6) { EADDR(S); }
    elif (cop == 7) { ESUBR(S); }
    elif (cop == 8) { EIMUL(S); }
    elif (cop == 9) { ECQO(S); EIDIV(S); }
    elif (cop == 34) { ECQO(S); EIDIV(S); EMOVDR(S); }
    elif (cop == 27) { EANDR(S); }
    elif (cop == 35) { EORR(S); }
    elif (cop == 36) { EXORR(S); }
    elif (cop == 38) { ESHLCL(S); }
    elif (cop == 39) { ESHRCL(S); }
    if (st > 0) { if (cop == 6 || cop == 7) { SPSC(S, st); } }   # 6.6.17: the result is the pointer
    return 0;
}

# ⛔ 6.6.11 — RE-JUDGE AN UNTYPED VARIABLE AT EVERY PLAIN ASSIGNMENT. The kind-3 flag (unary
# minus on an untyped float, _UFV_L / _UFV_G) was written only at the declaration, so
# `var g = 0; g = 1.5; -g` was a silent integer negation of 1.5's bits and `var h = 1.5; h = 7;
# -h` warned about a correct -7. A plain store into an untyped slot (`t` == 0) now rewrites the
# flag from its RHS (`_asg_ufv`). Flow-insensitive: the flag is whatever the last assignment
# COMPILED said — source order within a fn, and across fns for a global. Compound assignment
# keeps the flag (`_asg_ufv` -1). `g` = 1 for a global slot. CHANGELOG [6.6.11]
fn _asg_rejudge(S, idx, t, g): i64 {
    if (_asg_ufv < 0) { return 0; }
    if (t != 0) { return 0; }
    if (g == 1) { SGFI(S, idx, _asg_ufv); } else { SLFI(S, idx, _asg_ufv); }
    return 0;
}

# ⛔ 6.6.6 (bite 14 review) — `x = <expr>;` where <expr> is one whole METHOD call or OVERLOADED
# OPERATOR returning x's struct (`r = b.mk(5)`, `q = b.mp(3)`, `c = a + b`): the same temp-then-
# copy as `_try_struct_call_assign`, which can only see a free fn's name. The method/operator
# emitter stores the result in a temp and records it (`_sc_pre` / `_sc_post`, parse_fn.cyr); this
# replaces the statement's PCMPE and takes that temp when the record spans the whole right-hand
# side. `r = b.mk(5)` SIGSEGV'd, `q = b.mp(3)` kept rax only. Returns 1 when the statement is done
# (`;` consumed — `term`, which is `)` for a classic-for step); 0 leaves the ordinary store to
# run, exactly as after a plain PCMPE.
# 6.6.11: also arms the struct-typed FIELD source (`q = b.v;`, see `_fla_arm`) when the destination
# is a struct, and type-checks every recorded struct result against it — a <= 8 B one (`_sc_tmp`
# -3, value in rax) included — before any exit. CHANGELOG [6.6.11]
# The assignment's RHS type, read before PCMPE consumes it, for the typed-pointer warning in
# `_PARSE_STMT_IMPL`: a call's declared return (v6.5.28 — `t = str_new(..)` warned while the
# identical `var t = str_new(..)` did not) and, since 6.6.17, a RHS that is ONE primary of the
# destination local's own struct type: `a = GP` (a pointer-mode struct global), `b = q.name()`
# (a method declared `: Str`), `c = h.name` (a `: Str` field, nested fields walked). Each of those
# warned "assigning non-pointer to typed pointer" about a value of exactly the local's type.
# Its own fn so `_PARSE_STMT_IMPL` carries one reference here, not seven (cybs's ceiling).
fn _asg_ret_peek(S, noff): i64 {
    _asg_ret_sid = 0;
    if (PEEKT(S) != 2) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) == 10) {
        var fi = FINDFN(S, PEEKV(S));
        if (fi >= 0) { _asg_ret_sid = GFRS(S, fi); }
        return 0;
    }
    if (GINFN(S) == 0) { return 0; }
    var li = FINDLOCAL(S, noff);
    if (li < 0) { return 0; }
    var lt = GLTYPE(S, li);
    if (lt >= 0) { return 0; }
    if (lt <= 0 - 2048) { return 0; }
    var rs = _asg_rhs_sid(S);
    if (rs == 0 - lt) { _asg_ret_sid = rs; }
    return 0;
}
# The struct ONE primary at the cursor evaluates to when it ends at `;`: a name (`_arg_name_sid`:
# a typed local, a capture, a pointer-mode struct global), or a name followed by nested struct
# fields ending in a `: Str` field or a method call (`<Struct>_<m>`'s declared return). An inline
# struct field is not a pointer, so it is not typed here. 0 otherwise. A peek.
fn _asg_rhs_sid(S): i64 {
    var ti = GTI(S);
    var nt = TOKTYP(S, ti + 1);
    if (nt == 5) {
        var r = _arg_name_sid(S, PEEKV(S));
        return r;
    }
    if (nt != 41) { return 0; }
    var k = _asg_rhs_steps(S, ti + 1, _recv_sid(S, PEEKV(S)));
    return k;
}
fn _asg_rhs_steps(S, di, rsid): i64 {
    while (rsid > 0) {
        if (TOKTYP(S, di + 1) != 2) { return 0; }
        if (TOKTYP(S, di + 2) == 10) {
            var e = _tok_close_paren(S, di + 2);
            if (e < 0) { return 0; }
            if (TOKTYP(S, e + 1) != 5) { return 0; }
            var mf = _meth_fn_at(S, rsid, TOKVAL(S, di + 1), di + 1);
            if (mf < 0) { return 0; }
            var ms = GFRS(S, mf);
            if (ms < 0) { ms = 0; }
            return ms;
        }
        var fx = FINDFIELD(S, rsid - 1, TOKVAL(S, di + 1));
        if (fx < 0) { return 0; }
        var ft = GETFTYPE(S, rsid - 1, fx);
        if (TOKTYP(S, di + 2) == 5) {
            if (IS_STR_FIELD(S, ft) == 1) { return ft; }
            return 0;
        }
        if (TOKTYP(S, di + 2) != 41) { return 0; }
        if (IS_STR_FIELD(S, ft) == 1) { return 0; }   # a Str field is a pointer slot: no walk INTO it
        rsid = ft;
        di = di + 2;
    }
    return 0;
}

fn _pcmpe_struct_assign(S, noff, term): i64 {
    var st = GTI(S);
    _agc_operand(S, noff);
    _fla_arm(st, _agc_t);
    var fs = _fla_stp;
    if (term == 11) { _fla_stp = st; }   # 6.6.20: a for step's field source ends at `)`
    var w = _sc_arm(S);
    PCMPE(S);
    _asg_ufv = _UFV_IS_FLOAT(S);   # 6.6.11: here, while _FBR_KIND is still valid (see _asg_rejudge)
    _sc_want = w;
    _fla_want = 0 - 1;
    _fla_stp = fs;
    if (_fla_hit == 1) { return _fla_assign(S, noff, term); }
    var t = _sc_whole(S, st);
    if (t == 0 - 2) { return 0; }
    var n = _agc_operand(S, noff);
    if (t == 0 - 3) { _asg_ret_sid = _sc_sid; }   # a <= 8 B struct VALUE: not a pointer mismatch
    if (_AGG_ASSIGN_TYPE_ERR(S, _agc_t, 0 - _sc_sid, noff, _sc_fn) == 1) { return 0; }
    if (t == 0 - 3) { return 0; }
    if (n <= 1) { return 0; }
    if (_agc_t != 0 - _sc_sid) { return 0; }
    if (t < 0) { _refuse_toplevel_struct_call(S, _sc_fn); return 0; }
    var pdli = _agc_li;
    if (_agc_pp != 0) { pdli = _AGC_DREF(pdli); }   # 6.6.16 (C2): a handle too
    _agc_from_temp(S, t, pdli, _agc_gvi, n, _sc_sid);
    if (PEEKT(S) != term) { ERR_EXPECT(S, term); }
    STI(S, GTI(S) + 1);   # consume the terminator
    return 1;
}

fn _try_aggregate_copy_assign(S, noff, term): i64 {
    if (PEEKT(S) != 2) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != term) { return 0; }
    # ⛔ 6.6.5 — THIS USED TO OPEN `if (GINFN(S) != 1) return 0;` AND THEN `FINDLOCAL` BOTH
    # SIDES, so no global could ever reach it and `B = A` between two inline struct GLOBALS
    # copied EIGHT BYTES — the whole struct's first word, silently, at top level and inside a
    # fn alike (measured: `var A = P{1,2}; var B = P{3,4}; B = A;` left `B.y` at 4). The same
    # hole covered `B = p` and `q = A`. Once the LOCAL side was tightened onto the recorded
    # layout, the two answered the same assignment differently, which is worse than both being
    # wrong. Every combination now goes through `_agc_operand`. CHANGELOG [6.6.5]
    var nslots = _agc_operand(S, noff);
    # 6.6.6 — the destination's recorded type, read BEFORE the span test, and the source
    # probed even when the destination is a ONE-slot (<= 8 B) struct: such a struct has no
    # multi-slot copy but it still has a TYPE, and the declaration form reports a mismatch
    # for it. Two paths answering the same pair differently is the shape 6.6.5 called out.
    # `dt < 0` gates the probe so an ordinary scalar `x = y;` does not pay for it.
    # See `_AGG_ASSIGN_TYPE_ERR` (src/common/util.cyr). CHANGELOG [6.6.6]
    var dt = _agc_t;
    var src_noff = TOKVAL(S, GTI(S));
    if (nslots <= 1) {
        if (dt < 0) {
            _agc_src_operand(S, src_noff);
            _AGG_ASSIGN_TYPE_ERR(S, dt, _agc_t, noff, src_noff);
        }
        return 0;
    }
    # ⛔ 6.6.16 (C2) — read whether the destination is a HANDLE (`_agc_hdl`) before the source
    # probe resets the globals. handle <- handle is a pointer REBIND — the one-word store below,
    # at ANY pair of struct types, exactly as before a handle was an operand: Str and every heap
    # handle idiom rely on it. It returns ahead of the type check, so a rebind between handles of
    # two struct types stays legal. Every other pair holding a handle copies the struct (through
    # its address, the `_AGC_DREF` / deref-band path) and is type-checked like any copy.
    var dh = _agc_hdl();
    var dst_li = _agc_li;
    if (_agc_pp != 0) { dst_li = _AGC_DREF(dst_li); }
    var dst_gv = _agc_gvi;
    var lt = _agc_t;
    var snslots = _agc_src_operand(S, src_noff);   # 6.6.13: a closure capture too
    if (dh == 1) { if (_agc_hdl() == 1) { return 0; } }
    # 6.6.6 — this pair of tests USED to be the whole answer to a type mismatch, and the
    # answer was `return 0` = the generic 8-byte store. See `_AGG_ASSIGN_TYPE_ERR`.
    if (_AGG_ASSIGN_TYPE_ERR(S, lt, _agc_t, noff, src_noff) == 1) { return 0; }
    if (snslots != nslots) { return 0; }
    if (_agc_t != lt) { return 0; }
    var src_li = _agc_li;
    if (_agc_pp != 0) { src_li = _AGC_DREF(src_li); }
    var src_gv = _agc_gvi;
    # ⛔ v6.6.1 — A NEGATIVE GLTYPE DOES NOT MEAN "INLINE AGGREGATE", AND ASSUMING IT DID SHIPPED
    # A SILENT MISCOMPILE IN v6.5.57. Two different layouts share the same negative type marker:
    #   var b: P = a;        -> INLINE: ceil(STRUCTSZ/8) slots, anonymous fillers (name -1) below
    #                           the named slot.
    #   var a = str_from(x); -> POINTER: ONE slot holding an address. The declaration path infers
    #                           the callee's declared return sid (`_ti_inferred_sid`) so field
    #                           access works, which stamps the SAME negative GLTYPE.
    # The test above accepted both, so `a = b;` between two Str POINTERS copied STRUCTSZ(Str)/8
    # slots and scribbled over whatever locals sat below them. Measured: a 12-line probe whose
    # `guard` parameter came back corrupted, and in the wild yukti's `parse_uevent` had its `len`
    # parameter overwritten with a pointer mid-loop, so `for (i = 0; i <= len; ...)` walked off
    # the buffer into the process stack and SIGSEGV'd. Live in every release from v6.5.57.
    #
    # ⭐ THE DISCRIMINATOR IS THE RECORDED LAYOUT. v6.6.1 used the FILLER SENTINEL for this —
    # "an inline aggregate owns the slots below its named one and they carry name -1" — which
    # closed the reported shape and left the converse open: SCOPE_POP names the locals of a
    # CLOSED BLOCK -1 too, so two pointer-mode struct locals separated by an `if { var t; }`
    # passed the filler test and this copied STRUCTSZ/8 slots over their neighbours anyway.
    # Measured: an unreached `defer` ran, because the copy landed on its runtime flag.
    # 6.6.5 asks the bit that registration set (inside `_agc_operand`). CHANGELOG [6.6.5]
    # 6.6.6 — the frame-span guard applies to an INLINE local only, and a `_AGC_DREF`-encoded
    # parameter is already outside `>= 0` so it skips the guard by construction: it owns ONE
    # slot whatever the struct's width, and measuring its span here would reject every such
    # parameter back into the 8-byte store this bite exists to remove.
    if (dst_li >= 0) { if (dst_li - nslots + 1 < 0) { return 0; } }
    if (src_li >= 0) { if (src_li - nslots + 1 < 0) { return 0; } }
    if (dst_li < 0 || src_li < 0) {
        # A global or an address-passed parameter on either side: byte-exact, addressed.
        # See `_agc_copy_bytes`. 6.6.13: so is a closure capture (`src_li` -2, `_agc_src_operand`).
        # 6.6.16 (C2): and a handle — a local in the `_AGC_DREF` band, a global in the deref band.
        # Only two INLINE locals (both slots >= 0) take the slot loop below; every other operand
        # has `li` < 0 (a global's is -1), so one test says it. CHANGELOG [6.6.16]
        var nb = nslots * 8;
        if (lt < 0) { if (lt > 0 - 2048) { nb = STRUCTSZ(S, (0 - lt) - 1); } }
        _agc_copy_bytes(S, dst_li, dst_gv, src_li, src_gv, nb);
        if (dst_gv >= 0) { SLVAR(S, dst_gv); }
        STI(S, GTI(S) + 1);
        STI(S, GTI(S) + 1);
        return 1;
    }
    var i = 0;
    while (i < nslots) {
        EFLLOAD(S, src_li - i);
        EFLSTORE(S, dst_li - i);
        i = i + 1;
    }
    STI(S, GTI(S) + 1);
    STI(S, GTI(S) + 1);
    return 1;
}

# break; — forward jump to after the loop/switch/match (linked list through codebuf).
# 6.6.7: refused when nothing in THIS fn encloses it (`_brk_depth` counts loops + switch +
# match). An unowned break was never patched: its rel32 kept the chain link, a wild jump.
fn _PARSE_BREAK(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    if (_brk_depth == 0) {
        if (_in_defer == 1) { ERR_MSG(S, "break cannot leave a defer body", 31); return 0; }
        ERR_MSG(S, "break outside a loop or switch", 30);
        return 0;
    }
    var prev_brk = L64(S + 0x18F840);
    var brk_off = EJMP0(S);
    # Store prev break offset in this jmp's rel32 field (chain link)
    var brk_addr = _codebuf_base + brk_off;
    S64(brk_addr, (L64(brk_addr) >> 32 << 32) | (prev_brk & 0xFFFFFFFF));
    S64(S + 0x18F840, brk_off);
    return 0;
}
# continue; — jump to loop top (or forward to the step of a C-style for).
# 6.6.7: refused with no loop in THIS fn — it used to jump to the stale loop top of whatever
# fn last had a loop (SIGSEGV), or into the enclosing fn's loop from a closure.
fn _PARSE_CONTINUE(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    if (_loop_depth == 0) {
        if (_in_defer == 1) { ERR_MSG(S, "continue cannot leave a defer body", 34); return 0; }
        ERR_MSG(S, "continue outside a loop", 23);
        return 0;
    }
    if (L64(S + 0x18F898) > 0) {
        # A `for`: a forward jump to its step, patched by `_cont_close` (see `_cont_vec`).
        # No cap: the vector grows. The fixed 8-entry array this replaced was shared by the
        # whole nest, so its "max 8" counted the OUTER loops' continues and named the inner
        # one (5 outer + 4 inner was refused). CHANGELOG [6.6.20]
        vec_push(_cont_vec, EJMP0(S));
    } else {
        # A `while`: a direct jump to the loop top
        EJMP(S, L64(S + 0x18F838));
    }
    return 0;
}
# defer { body } — execute body at function return (LIFO)
# Each defer gets a runtime flag (hidden local) set to 1 when reached.
# At epilogue, flag is checked before running the block — unreached defers are skipped.
# 6.6.7 — CONTEXT RULES. Top level is refused (no frame for the flag — it was written through
# rbp = 0 and SIGSEGV'd — and no epilogue to run the block), like `secret`/`stack` var. The
# body runs FROM the epilogue walker, so it may not leave: a `return`/`?`/`ret2` inside it
# (seen as rp_vec growth) re-entered the walker and re-ran the block, and a `break`/`continue`
# jumped back into the loop it was registered in; both are refused. A loop OPENED inside the
# body is fine — `_loop_body` counts it. CHANGELOG [6.6.7]
fn _PARSE_DEFER(S): i64 {
    if (GINFN(S) != 1) {
        ERR_MSG(S, "defer only allowed inside a function", 36);
    }
    # A #naked fn has no epilogue (its body ends in its own asm return) and no frame: the walker
    # emitted after the body is unreachable, so the block never ran. Refused. CHANGELOG [6.6.15]
    if (_cur_fn_naked == 1) {
        ERR_MSG(S, "defer is not allowed in a #naked fn (it has no epilogue to run the block)", 73);
    }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    # Allocate hidden local for defer flag (initialized to 0 in prologue)
    var dflag = GFLC(S);
    S64(S + 0x5D9D000 + dflag * 8, 0 - 1);   # 6.6.5: anonymous — name 0 is the first lexed word
    SLDEP(S, dflag, GSDEP(S));
    SLTYPE(S, dflag, 0);
    SFLC(S, dflag + 1);
    # Emit: flag = 1 (set when defer statement is reached)
    EMOVI(S, 1);
    EFLSTORE(S, dflag);
    # Emit jmp-over (skip deferred block during normal execution)
    var djmp = EJMP0(S);
    # Record block start (current CP after jmp-over)
    var dstart = GCP(S);
    # Parse deferred block body — with no loop and no break target of its own
    STI(S, GTI(S) + 1);
    var sv_ld = _loop_depth;
    var sv_bd = _brk_depth;
    var sv_id = _in_defer;
    var rp0 = vec_len(rp_vec);
    _loop_depth = 0;
    _brk_depth = 0;
    _in_defer = 1;
    PARSE_PROG(S);
    _loop_depth = sv_ld;
    _brk_depth = sv_bd;
    _in_defer = sv_id;
    if (vec_len(rp_vec) != rp0) {
        ERR_MSG(S, "return inside a defer body (a defer block cannot leave its function)", 68);
    }
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    # Emit jmp placeholder (patched to next defer block or epilogue)
    var dend = EJMP0(S);
    # Store {block_start, end_jmp, flag_local} triple (24 bytes per entry)
    var dci = L64(S + 0x1AC020);
    if (dci >= 64) {
        syscall(SYS_WRITE, 2, "error: too many defer blocks (max 64)\n", 38);
        syscall(SYS_EXIT, 1);
    }
    S64(S + 0x1AC028 + dci * 24, dstart);
    S64(S + 0x1AC028 + dci * 24 + 8, dend);
    S64(S + 0x1AC028 + dci * 24 + 16, dflag);
    S64(S + 0x1AC020, dci + 1);
    # Patch jmp-over to land here (after the deferred block)
    EPATCH(S, djmp);
    return 0;
}
# v5.6.3: #must_use — warn when the fn `noff` names is marked #must_use and is called as a
# bare expression statement (result dropped). Called BEFORE the call is parsed, so the line
# is the call site's, not the trailing ';'. Shared by the `IDENT (` statement arm and the
# bare explicit-generic statement (`_stmt_explicit_generic`). CHANGELOG [6.6.12]
fn _must_use_warn(S, noff): i64 {
    var _mu_fi = FINDFN(S, noff);
    if (_mu_fi >= 0) {
        var _mu_flags = GFLG(S, _mu_fi);
        if (_mu_flags & 1 != 0) {
            syscall(SYS_WRITE, 2, "warning:", 8);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": #must_use result of '", 23);
            PRSTR(S + 0xEC00000 + noff);
            syscall(SYS_WRITE, 2, "' is discarded\n", 15);
        }
    }
    return 0;
}

# v5.8.31 — postfix `?` on a bare fncall-statement
# (`expr?;` form). v5.8.29 added `?` in PARSE_TERM but
# this path bypasses PARSE_TERM entirely (PARSE_STMT
# dispatches IDENT+LPAREN straight to PARSE_FNCALL),
# so the `?` was unhandled and the next token check
# for `;` reported "expected ';', got unknown" (token
# 124 has no TOKNAME entry). Same desugar shape as the
# PARSE_TERM hook: tag-check + early-return on Err +
# payload-load on Ok. The unwrapped value lands in rax
# and is dropped by the bare-statement convention.
# 6.6.12: one copy for both statement forms, `f(..)?;` and `g<T>(..)?;`, out of
# _PARSE_STMT_IMPL (the cybs per-fn cap). `pair` = the callee is pair-returning, read by name
# BEFORE the call was parsed. Cursor on the token after the call; no-op unless it is `?`.
fn _stmt_qmark(S, pair): i64 {
    if (PEEKT(S) == 124) {
        STI(S, GTI(S) + 1);
        if (GINFN(S) == 0) {
            ERR_MSG(S, "?: '?' propagation operator only valid inside a fn body", 55);
        }
        # ⛔ v6.6.0 — THE VALUE-FORM PATH, AND WHY IT IS HERE TWICE. This block is a
        # SECOND, PARALLEL COPY of the `?` desugar: PARSE_STMT dispatches IDENT+LPAREN
        # straight to PARSE_FNCALL and never reaches `_PARSE_TERM_IMPL`, so v5.8.31 had
        # to repeat the lowering. When v6.6.0 taught `?` the pair form it was fixed in
        # the OTHER copy only, and this one kept dereferencing the operand — reading the
        # TAG (0 or 1) as a pointer. `look(n)?;` as a bare statement compiled clean and
        # SIGSEGV'd while `var x = look(n)?;` was correct. Same parallel-copy class as
        # the global-init REPLAY that had to take the v6.3.44 struct fix separately.
        # ⭐ The Err path re-emits BOTH halves, exactly as the expression copy does:
        # propagating out of the enclosing fn means RETURNING a pair, so restoring only
        # rax would hand the caller a correct tag with a stale payload.
        if (pair == 1) {
            var qstag = _HTEMP(S);
            var qsval = _HTEMP(S);
            _HTSTORE(S, qstag);           # tag (rax as returned)
            EMOVRA_RDX(S);                # rax = rdx = payload
            _HTSTORE(S, qsval);
            _HTLOAD(S, qstag);
            EPUSHR(S);
            EMOVI(S, 0);
            EMOVCA(S);                    # rcx = 0 (Ok)
            EPOPR(S);                     # rax = tag
            ECMPR(S);
            var qspj = EJCC(S, 0x84);     # JE -> Ok, skip the propagate
            _HTLOAD(S, qsval);
            EMOVRDXRAX(S);                # rdx = payload
            _HTLOAD(S, qstag);            # rax = tag
            var qsprp = EJMP0(S);
            vec_push(rp_vec, qsprp);
            EPATCH(S, qspj);
            _HTLOAD(S, qsval);            # Ok path: rax = payload (dropped by the
            # bare-statement convention)
            if (_cur_fn_ix >= 0) { SFLG(S, _cur_fn_ix, GFLG(S, _cur_fn_ix) | 256); }
        } else {
            var qsidx = _HTEMP(S);
            _HTSTORE(S, qsidx);
            _HTLOAD(S, qsidx);
            ELOAD64(S);
            EPUSHR(S);
            EMOVI(S, 0);
            EMOVCA(S);
            EPOPR(S);
            ECMPR(S);
            var qsjcc = EJCC(S, 0x84);
            _HTLOAD(S, qsidx);
            var qsrp = EJMP0(S);
            vec_push(rp_vec, qsrp);
            EPATCH(S, qsjcc);
            _HTLOAD(S, qsidx);
            EPUSHR(S);
            EMOVI(S, 8);
            EMOVCA(S);
            EPOPR(S);
            EADDR(S);
            ELOAD64(S);
        }
    }
    return 0;
}

# ⛔ 6.6.12 — AN EXPLICIT GENERIC CALL AS A BARE STATEMENT (`id<i32>(4);`) was "expected '=',
# got '<'": the IDENT arm of _PARSE_STMT_IMPL sent only `IDENT (` to PARSE_FNCALL, so `IDENT <`
# fell into the assignment path. Same guards as the factor's arm (parse_expr.cyr: the monomorph
# flag, a generic callee, the `name<..>(` lookahead), so `a < b;` and a non-generic `<` never
# get here. Parity with the `IDENT (` arm: a `.field` / `.method()` on the result
# (`_stmt_call_field`), the #must_use warning and a postfix `?`. Cursor just past the callee
# IDENT; 1 = the statement is consumed through its `;`, 0 = not that shape (cursor untouched).
# One call in _PARSE_STMT_IMPL: that body is near cybs's per-function reference limit.
# CHANGELOG [6.6.12]
fn _stmt_explicit_generic(S, noff): i64 {
    if (PEEKT(S) != 19) { return 0; }
    if (_MONOMORPH_OK != 1) { return 0; }
    var fi = FINDFN(S, noff);
    if (fi < 0) { return 0; }
    if (GFTP(S, fi) == 0) { return 0; }
    if (LOOKAHEAD_IS_TYPE_ARG_CALL(S) != 1) { return 0; }
    if (_stmt_call_field(S) == 1) { return 1; }
    _must_use_warn(S, noff);
    _ensure_pair_flags(S);
    var pair = 0;
    if ((GFLG(S, fi) & 256) != 0) { pair = 1; }
    _explicit_generic_call(S, noff, fi);
    _cfo = 0;
    _stmt_qmark(S, pair);
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    return 1;
}

# ⛔ 6.6.16 — A METHOD CALL AS A BARE STATEMENT, `p.m(..);` — with a postfix `?`, like `f(..)?;`
# and `g<T>(..)?;`. The arm in _PARSE_STMT_IMPL called PARSE_FIELD_LOAD and then demanded `;`, so
# `p.div(d)?;` was "expected ';', got unknown". `pair` is read BEFORE the call is parsed
# (`_pair_callee_at`: the receiver's `T_m`), as the other two statement forms read theirs. Cursor
# on the DOT after the receiver `noff`; consumes through the `;`. One call in _PARSE_STMT_IMPL
# (the cybs per-function cap). CHANGELOG [6.6.16]
# 6.6.17: and #must_use, as a discarded `f(..);` warns — an impl method takes the attribute since
# 6.6.17 (`_impl_attrs`). The method the statement ENDED with is the one discarded (`_mcall_last`:
# `p.bump().mu();` discards `mu`'s result; `p.mu().x;` used it).
fn _stmt_method_call(S, noff): i64 {
    var pair = _callee_returns_pair_at(S, GTI(S) - 1);
    _mcall_last = 0 - 1;
    PARSE_FIELD_LOAD(S, noff);
    if (_mcall_last >= 0) { if (PEEKT(S) == 5) { _must_use_warn(S, L64(_fnt_names + _mcall_last * 8)); } }
    _stmt_qmark(S, pair);
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    return 0;
}

# ⛔ 6.6.16 — A fn IS DEFINED AT TOP LEVEL. A named `fn` / `async fn` inside a fn body — or a
# closure, an impl method, a generic body — reached PARSE_PROG's relaxed-ordering arm, which is
# for TOP-LEVEL code: PARSE_FN_DEF for the inner fn overwrote the OUTER fn's per-fn state while
# the outer was still being emitted (its locals and frame, its return patches, `_cur_fn_ix`, and
# `SINFN(S, 0)` at the inner fn's end, so the rest of the outer body parsed as top-level code),
# and pass 1 never registered the inner fn (bodies are brace-skipped). Measured on x86:
# `fn outer(): i64 { fn inner(): i64 { return 3; } return inner(); }` compiled rc 0 and ran SIGILL
# (132), and still did with `return 7;` in place of the call; a multi-line form, an untyped one,
# one inside an `if` and one in a generic instance SIGSEGV'd. In a switch case, an `async fn`, a
# closure body or an impl method it failed with an unrelated message (`unexpected async`,
# `undefined variable 'x'`, `undefined function 'inner'`), often with a cascade.
# So it is ONE named error, and nothing cascades: the nested fn's tokens are consumed
# (`_skip_nested_body`, the pair scans' own skip), its name is entered as already REPORTED
# (`_nested_fn_mark`), and the panic latch is left as it was (the report is written here, not
# through an ERR_* emitter that would latch it), so the outer body parses on and reports its own
# errors. A fn inside a TOP-LEVEL block (`if (on) { fn f() { .. } }`, GINFN == 0) is the
# relaxed-ordering feature, compiles correctly, and is untouched. A local function is a closure.
# CHANGELOG [6.6.16]
var _nfn_seen = 0;   # vec of the `fn` tokens refused so far: a body parsed twice reports once

# Has the nested `fn` at token kw been reported? A body can be parsed more than once — a generic
# instance and an `#inline` replay re-parse the base's tokens — and each is the same definition.
fn _nested_fn_seen(kw): i64 {
    if (_nfn_seen == 0) { _nfn_seen = vec_new(); }
    var i = 0;
    var c = vec_len(_nfn_seen);
    while (i < c) {
        if (vec_get(_nfn_seen, i) == kw) { return 1; }
        i = i + 1;
    }
    vec_push(_nfn_seen, kw);
    return 0;
}

# The refused fn's NAME is entered in the fn table as already REPORTED — offset -2, the
# undefined-call check's own "reported" marker, plus an owner so the pre-pass check skips it too —
# so a call to it adds no "undefined function" warning and no "refusing to emit binary" error to
# the one diagnostic. Only an entry nothing defines: a fn of the same name defined elsewhere keeps
# its entry untouched, and a call reaches that one.
fn _nested_fn_mark(S, noff, kw): i64 {
    var fi = FINDFN(S, noff);
    if (fi < 0) { fi = REGFN(S, noff); }
    if (L64(_fnt_offsets + fi * 8) != 0 - 1) { return 0; }
    if (GFFI(S, fi) != 0) { return 0; }
    S64(_fnt_offsets + fi * 8, 0 - 2);
    SFFI(S, fi, FM_FILEID(S, GTLINE(S, kw)) + 1);
    return 0;
}

# Where the refused fn sits, for the message: `fn 'outer'` (a generic instance's or an async
# body's `$..` suffix cut), or `a closure` for a closure's `__clNNNNN` entry.
fn _nested_fn_encl(S): i64 {
    if (_cur_fn_ix < 0) { PRSTR("a fn body"); return 0; }
    var p = S + 0xEC00000 + L64(_fnt_names + _cur_fn_ix * 8);
    if (load8(p) == 95 && load8(p + 1) == 95 && load8(p + 2) == 99 && load8(p + 3) == 108) {
        if (load8(p + 4) >= 48 && load8(p + 4) <= 57) { PRSTR("a closure"); return 0; }
    }
    PRSTR("fn '");
    var l = 0;
    while (load8(p + l) != 0 && load8(p + l) != 36) { l = l + 1; }
    syscall(SYS_WRITE, 2, p, l);
    PRSTR("'");
    return 0;
}

# Refuse the `fn` / `async fn` at the cursor when it is inside a fn body (GINFN == 1).
# 1 = refused: reported once, consumed through its body's `}` (or a bodiless header's `;`, never
# past EOF). 0 = not a nested fn: nothing moved. Small and with no tail call (cybs).
# Called by PARSE_PROG's `fn` arm, the end of _PARSE_STMT_IMPL (`async fn`, and the statement
# positions that bypass PARSE_PROG: a switch case body, `@unsafe { }`) and the generic stub-body
# skip in PARSE_FN_DEF.
fn _refuse_nested_fn(S): i64 {
    if (GINFN(S) != 1) { return 0; }
    var kw = GTI(S);
    if (TOKTYP(S, kw) == 134) { kw = kw + 1; }    # `async fn`
    if (TOKTYP(S, kw) != 32) { return 0; }
    if (_nested_fn_seen(kw) == 0) {
        syscall(SYS_WRITE, 2, "error:", 6);
        _err_head(S);
        if (TOKTYP(S, kw + 1) == 2) {
            PRSTR(": fn '");
            PRSTR(S + 0xEC00000 + TOKVAL(S, kw + 1));
            PRSTR("' is defined inside ");
            _nested_fn_mark(S, TOKVAL(S, kw + 1), kw);
        } else { PRSTR(": a fn is defined inside "); }
        _nested_fn_encl(S);
        PRSTR("; define it at top level\n");
        _err_excerpt(S);
        PRSTR("  note: a local function is a closure (`var f = |x| { .. };`); a fn inside a top-level block is allowed\n");
        _had_error = 1;
    }
    var e = _skip_nested_body(S, kw);
    if (TOKTYP(S, e) != 12) { e = e + 1; }
    STI(S, e);
    return 1;
}

fn PARSE_STMT(S): i64 {
    var before = GTI(S);
    # v6.5.19 (CVE-40): this wrapper is already the one place every statement descent
    # passes through, which makes it the natural home for the depth bound too. See
    # _rd_enter (src/common/util.cyr). Covers nested fn / blocks / if / while.
    _rd_enter(S);
    # 6.6.5: and for the same reason, the natural home for the expression-stack check — a
    # statement must leave the machine stack exactly as it found it. See `_xd_check`.
    var _xd0 = _xdepth;
    _PARSE_STMT_IMPL(S);
    _rd_exit();
    _xd_check(S, _xd0, "statement");
    if (_panic == 1) { _sync_skip(S); }
    if (GTI(S) == before) {
        if (GTI(S) < GTCNT(S)) { STI(S, GTI(S) + 1); }
    }
    return 0;
}

# 6.6.16 (C1): a statement inside another statement that has NO braced PARSE_PROG body — a
# `switch` case / default arm, an `@unsafe { }` body, a `for`'s init clause — is one nesting
# level deeper for _gai_stmt (parse_decl.cyr), which takes an array initializer only at module
# scope (`_pp_depth == 1`). PARSE_PROG counts every braced body; these parse their statements
# through PARSE_STMT directly, so a list in a top-level `case` arm was baked whether the arm ran
# or not. A wrapper, so no hot function gains a global reference. CHANGELOG [6.6.16]
fn _PARSE_STMT_NESTED(S): i64 {
    _pp_depth = _pp_depth + 1;
    PARSE_STMT(S);
    _pp_depth = _pp_depth - 1;
    return 0;
}

fn _PARSE_STMT_IMPL(S): i64 {
    var typ = PEEKT(S);
    # v5.6.3: @unsafe { ... } block. Body parses as a plain block
    # (no scope change). Nested unsafe triggers an advisory warning —
    # by design, @unsafe is for marking memory/FFI crossings and
    # wrapping an unsafe region in another one usually means the
    # outer-scope responsibility is being redelegated, which is what
    # the warning flags.
    if (typ == 123) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
        STI(S, GTI(S) + 1);
        _unsafe_depth = _unsafe_depth + 1;
        if (_unsafe_depth > 1) {
            syscall(SYS_WRITE, 2, "warning:", 8);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": nested @unsafe block\n", 23);
        }
        while (PEEKT(S) != 14) {
            if (PEEKT(S) == 12) { break; }
            _PARSE_STMT_NESTED(S);
        }
        STI(S, GTI(S) + 1);
        _unsafe_depth = _unsafe_depth - 1;
        return 0;
    }
    # #assert EXPR OP EXPR, "msg" — compile-time check
    if (typ == 107) {
        var as_p0 = _panic;
        STI(S, GTI(S) + 1);
        var lhs = _EVAL_CONST_ATOM(S);
        # Check for comparison operator
        var op = PEEKT(S);
        if (op >= 17 && op <= 22) {
            STI(S, GTI(S) + 1);
            var rhs = _EVAL_CONST_ATOM(S);
            var result = 0;
            if (op == 17) { if (lhs == rhs) { result = 1; } }
            if (op == 18) { if (lhs != rhs) { result = 1; } }
            if (op == 19) { if (lhs < rhs) { result = 1; } }
            if (op == 20) { if (lhs > rhs) { result = 1; } }
            if (op == 21) { if (lhs <= rhs) { result = 1; } }
            if (op == 22) { if (lhs >= rhs) { result = 1; } }
            lhs = result;
        }
        # lhs is now the assertion value (0 = fail, non-zero = pass)
        _assert_operands_end(S);
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
        # 6.6.10: an operand (or a trailing token) that THIS assert reported has latched
        # _panic; a "#assert failed" after it was a second error for the same mistake. Only
        # this assert's own latch counts — an earlier, unresynced error must not swallow an
        # independent failing #assert. CHANGELOG [6.6.10]
        if (as_p0 == 0) { if (_panic == 1) { lhs = 1; } }
        if (lhs == 0) { if (GTI(S) > _assert_rep_ti) {
                _assert_rep_ti = GTI(S);
                syscall(SYS_WRITE, 2, "error:", 6);
                _err_head(S);
                syscall(SYS_WRITE, 2, ": #assert failed", 16);
                if (PEEKT(S) == 30) {
                    # String token value is (offset << 32) | length
                    var sv = PEEKV(S);
                    var slen = sv & 0xFFFFFFFF;
                    syscall(SYS_WRITE, 2, ": ", 2);
                    syscall(SYS_WRITE, 2, _lit_ptr(S, sv), slen);   # 6.6.17: a side-table message
                }
                syscall(SYS_WRITE, 2, "\n", 1);
                # 6.6.11: record, don't exit. A top-level #assert runs in the declaration phase,
                # BEFORE PARSE_PROG parses the top-level `var` initialisers, so exiting here lost
                # an earlier syntax error (`var x = ;` then a failing assert printed only the
                # assert). Every fork's EMITELF refuses on _had_error and main exits with it.
                _had_error = 1;
            } }
        _assert_tail(S);
        return 0;
    }
    # #pe_import("kernel32.dll", "WriteFile"); — declare a PE32+ IAT
    # import symbol at parse time. The dll string is accepted but
    # ignored in v5.4.6 (kernel32.dll is the only supported DLL);
    # the symbol string is handed to the pe emitter's pending-
    # imports buffer, to be folded into the real imports registry
    # by `_pe_layout` during FIXUP.
    if (typ == 110) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
        STI(S, GTI(S) + 1);
        # dll name (ignored for v5.4.6)
        if (PEEKT(S) != 30) { ERR_EXPECT(S, 30); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); }
        STI(S, GTI(S) + 1);
        # symbol name
        if (PEEKT(S) != 30) { ERR_EXPECT(S, 30); }
        var pe_sv = PEEKV(S);
        var pe_soff = pe_sv >> 32;
        _pe_pending_imp_add(S, S + 0x21A000 + pe_soff);
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
        return 0;
    }
    if (typ == 3) { PARSE_VAR(S); return 0; }
    # secret var buf[N]; — declares an array that is memset(0) at every
    # function-return path. Implemented as a synthetic defer body: the
    # var is registered normally, then a zeroise loop is emitted into a
    # defer entry so the existing epilogue walker runs it. Only supports
    # array declarations in v5.3.5 scope — the crypto consumers (sigil,
    # sakshi) use arrays exclusively.
    if (typ == 108) {
        if (GINFN(S) != 1) {
            ERR_MSG(S, "secret var only allowed inside a function", 41);
        }
        # A #naked fn has no epilogue to zeroise from: the wipe never ran. Refused. CHANGELOG [6.6.15]
        if (_cur_fn_naked == 1) {
            ERR_MSG(S, "secret var is not allowed in a #naked fn (it has no epilogue to zeroise it)", 75);
        }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 3) { ERR_EXPECT(S, 3); }
        # v6.3.15: when array locals are per-thread STACK (CYRIUS_STACK_ARRAYS), the
        # `var buf[N]` here is registered as fn-LOCAL slots, not a global var — so detect
        # the array via FINDLOCAL + a slot-delta size and zeroise through the local
        # address (`lea [rbp-disp]`) instead of the global `EVADDR`. Off (legacy global
        # array) keeps the original VCNT/`_vars_base`/`EVADDR` path byte-identical.
        var s_name = TOKVAL(S, GTI(S) + 1);   # the array's name token (after `var`)
        var s_flc_pre = GFLC(S);
        var vcnt_pre = GVCNT(S);
        PARSE_VAR(S);
        var sidx = 0;
        var ssz = 0;
        var s_lidx = 0;
        # 6.6.5 — ASK WHERE THE ARRAY ACTUALLY WENT, not whether stack arrays are enabled.
        # An array over the per-fn budget falls back to static storage even with the flag on,
        # so the flag said "local", FINDLOCAL found nothing, and a perfectly good
        # `secret var buf[200000];` was refused with "secret requires array declaration".
        # Worse, with an outer local of the same name in scope FINDLOCAL DID find something
        # and the zeroise ran against the wrong storage — the buffer was never cleared, which
        # is the one thing `secret` exists to guarantee. The slot-count delta is the fact.
        var s_stack = 0;
        if (GFLC(S) > s_flc_pre) { s_stack = 1; }
        if (s_stack == 1) {
            s_lidx = FINDLOCAL(S, s_name);
            if (s_lidx < 0) {
                ERR_MSG(S, "secret requires array declaration: secret var buf[N];", 53);
            }
            ssz = (GFLC(S) - s_flc_pre) * 8;   # array slot count (incl. any 16-align pad) × 8
        } else {
            if (GVCNT(S) != vcnt_pre + 1) {
                ERR_MSG(S, "secret requires array declaration: secret var buf[N];", 53);
            }
            sidx = vcnt_pre;
            ssz = L64(_vars_base + sidx * 8);
        }
        # Flag local (initialized to 0 in prologue; set to 1 when this
        # declaration is reached at runtime).
        var sflag = GFLC(S);
        S64(S + 0x5D9D000 + sflag * 8, 0 - 1);   # 6.6.5: anonymous — name 0 is the first lexed word
        SLDEP(S, sflag, GSDEP(S));
        SLTYPE(S, sflag, 0);
        SFLC(S, sflag + 1);
        EMOVI(S, 1);
        EFLSTORE(S, sflag);
        var sjmp = EJMP0(S);
        var ssbody = GCP(S);
        # Zeroise body: load &buf once, then unroll `store64 [ptr], 0; ptr += 8`.
        # Stack array (flag on): rbp-relative `lea` of the local; global array
        # (flag off, legacy): absolute `EVADDR`. Both leave the base in rax.
        if (s_stack == 1) {
            var s_disp = 0 - ((s_lidx + 1) * 8);
            if (_cur_fn_regalloc > 0) { s_disp = s_disp - _cur_fn_regalloc * 8; }
            if (_cur_fn_ret_stash > 0) { s_disp = s_disp - _cur_fn_ret_stash; }
            ELOAD_LOCAL_ADDR(S, s_disp);
        } else {
            EVADDR(S, sidx);
        }
        EMOVCA(S);
        EXORAA(S);
        var sqw = ssz / 8;
        var sqi = 0;
        while (sqi < sqw) {
            ESTORE64(S);
            EADDIMM_X1(S, 8);
            sqi = sqi + 1;
        }
        var ssend = EJMP0(S);
        var sdci = L64(S + 0x1AC020);
        if (sdci >= 64) {
            syscall(SYS_WRITE, 2, "error: too many defer/secret blocks (max 64)\n", 45);
            syscall(SYS_EXIT, 1);
        }
        S64(S + 0x1AC028 + sdci * 24, ssbody);
        S64(S + 0x1AC028 + sdci * 24 + 8, ssend);
        S64(S + 0x1AC028 + sdci * 24 + 16, sflag);
        S64(S + 0x1AC020, sdci + 1);
        EPATCH(S, sjmp);
        return 0;
    }
    # v5.5.36: `stack var buf[N];` — stack-local array. Unlike the
    # default `var x[N]` which hoists to .bss as a global, this
    # reserves N bytes (aligned up to 8) on the call stack. Each fn
    # invocation gets its own copy (re-entrant-safe). Addressed via
    # rbp-relative displacement through the existing `&local`
    # codepath, so no emit-side changes are needed for access.
    #
    # Implementation: register ceil(N/8) fn-local slots. The first
    # nslots-1 are anonymous sentinels (name offset = -1; FINDLOCAL
    # skips them via its `sn >= 0` gate). The last slot carries the
    # user's name, so FINDLOCAL returns the deepest (lowest-address)
    # slot — `&buf` therefore points at the BOTTOM of the array,
    # with byte[0] at rbp-(nslots*8) and byte[N-1] immediately below
    # the regular locals block.
    #
    # __chkstk for frames ≥ 4 KB under _TARGET_PE is v5.5.36 Phase 1b
    # (pinned — same patch). For now, small-frame `stack var` lands
    # cleanly on Windows because Win11 happens to extend stack on
    # guard-page access for frames ≤ one-page-past-the-guard; deeper
    # frames need the chkstk walker to touch every page in order.
    if (typ == 111) {
        if (GINFN(S) != 1) {
            ERR_MSG(S, "stack var only allowed inside a function", 40);
        }
        STI(S, GTI(S) + 1);                         # consume 'stack'
        if (PEEKT(S) != 3) { ERR_EXPECT(S, 3); }    # need 'var'
        STI(S, GTI(S) + 1);                         # consume 'var'
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }    # need IDENT
        var stk_noff = PEEKV(S);
        _RSV_INTRINSIC_DECL(S, stk_noff, GTI(S), 0);   # 6.6.20: `stack var sizeof`
        STI(S, GTI(S) + 1);                         # consume IDENT
        if (PEEKT(S) != 28) { ERR_EXPECT(S, 28); }  # need '['
        STI(S, GTI(S) + 1);                         # consume '['
        if (PEEKT(S) != 1) { ERR_EXPECT(S, 1); }    # need NUM
        var stk_size = PEEKV(S);
        STI(S, GTI(S) + 1);                         # consume NUM
        if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }  # need ']'
        STI(S, GTI(S) + 1);                         # consume ']'
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }    # need ';'
        STI(S, GTI(S) + 1);                         # consume ';'
        if (stk_size <= 0) {
            ERR_MSG(S, "stack var size must be > 0", 26);
        }
        var stk_aligned = (stk_size + 7) & (0 - 8);
        var stk_nslots = stk_aligned / 8;
        # Reject duplicate name (same rule as regular locals)
        var stk_existing = FINDLOCAL(S, stk_noff);
        if (stk_existing >= 0) {
            if (GLDEP(S, stk_existing) == GSDEP(S)) { ERRDUPVAR(S); }
        }
        # Anonymous filler slots — FINDLOCAL skips `sn < 0` entries.
        var stk_j = 0;
        while (stk_j < stk_nslots - 1) {
            var stk_li = GFLC(S);
            S64(S + 0x5D9D000 + stk_li * 8, 0 - 1);
            SLDEP(S, stk_li, GSDEP(S));
            SLTYPE(S, stk_li, 0);
            SFLC(S, stk_li + 1);
            stk_j = stk_j + 1;
        }
        # Named slot at the deepest frame offset — this is where
        # `&buf` and `buf` resolve via FINDLOCAL.
        var stk_named = GFLC(S);
        S64(S + 0x5D9D000 + stk_named * 8, stk_noff);
        SLDEP(S, stk_named, GSDEP(S));
        SLAGG(S, stk_named, stk_nslots);   # 6.6.5: the slots ARE the buffer
        SLTYPE(S, stk_named, 0);
        SFLC(S, stk_named + 1);
        return 0;
    }
    # Block statement: { ... }
    if (typ == 13) {
        STI(S, GTI(S) + 1);
        SCOPE_PUSH(S);
        PARSE_PROG(S);
        SCOPE_POP(S);
        if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
        STI(S, GTI(S) + 1);
        return 0;
    }
    if (typ == 15) { PARSE_IF(S); return 0; }
    if (typ == 16) { PARSE_WHILE(S); return 0; }
    if (typ == 55) { PARSE_FOR(S); return 0; }
    if (typ == 57) { PARSE_SWITCH(S); return 0; }
    if (typ == 75) { PARSE_MATCH(S); return 0; }
    if (typ == 33) { PARSE_RETURN(S); return 0; }
    # break; / defer { } / continue; — see _PARSE_BREAK / _PARSE_DEFER / _PARSE_CONTINUE.
    if (typ == 51) { _PARSE_BREAK(S); return 0; }
    if (typ == 106) { _PARSE_DEFER(S); return 0; }
    if (typ == 52) { _PARSE_CONTINUE(S); return 0; }
    # asm { ... } — raw bytes or mnemonic instructions
    if (typ == 48) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
        STI(S, GTI(S) + 1);
        # v5.6.12: inline asm block is opaque to IR — each byte is
        # arbitrary user-provided machine code.
        _IR_REC0(S, IR_RAW_EMIT);
        var ago = 1;
        while (ago == 1) {
            if (PEEKT(S) == 14) { ago = 0; }
            else {
                if (PEEKT(S) == 1) {
                    # Raw byte
                    EB(S, PEEKV(S) & 0xFF);
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                }
                elif (PEEKT(S) == 2) {
                    # Mnemonic — dispatch to ASM_MNEMONIC
                    ASM_MNEMONIC(S);
                }
                else { ERR(S); }
            }
        }
        STI(S, GTI(S) + 1);
        # aarch64 requires every instruction 4-byte aligned. Existing
        # lib/*.cyr asm blocks are x86-specific byte sequences that the
        # aarch64 backend pastes verbatim; if the length isn't a multiple
        # of 4, every downstream instruction decodes at the wrong offset
        # and the program SIGILLs long before it ever reaches the x86
        # bytes. Pad with zeros so downstream emit stays aligned. The x86
        # backend is variable-length and doesn't care about alignment, so
        # this costs nothing there — on aarch64 `_AARCH64_BACKEND == 1`.
        # v6.4.58: cx bytecode is ALSO strictly 4-byte instructions (cxvm computes
        # call/jump targets as off*4), so a raw asm block whose length isn't a
        # multiple of 4 misaligns every following fn — same class as the v6.4.54
        # DCE-stub bug. Pad on cx too. x86 is variable-length (both operands 0 →
        # no padding, byte-identical). See issue 2026-07-11-cx-naked-asm-4byte-realign.
        if (_AARCH64_BACKEND == 1 || _TARGET_CX == 1) {
            while ((GCP(S) & 3) != 0) { EB(S, 0); }
        }
        return 0;
    }
    # *expr = val; (pointer store)
    if (typ == 8) {
        STI(S, GTI(S) + 1);
        PARSE_FACTOR(S);
        # rax now holds the address
        EPUSHR(S);
        if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
        STI(S, GTI(S) + 1);
        PCMPE(S);
        # rax = value, stack = address
        EPOPC(S);
        ESTORE64(S);
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);
        return 0;
    }
    # Expression statements: syscall(...); store8(...); load8(...);
    if (typ == 24) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 26) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 25) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 45) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 46) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 47) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    # f64/SIMD builtins as statements
    if (typ >= 62) { if (typ <= 105) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v5.10.17: f64v_dot/scale/axpy as statements (out-of-range from
    # the existing 62-105 SIMD band; share the same PCMPE-then-`;` shape).
    if (typ >= 128) { if (typ <= 130) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.3+ (SIMD Phase 1): f32v_add/sub/mul as statements (138-140).
    if (typ >= 138) { if (typ <= 140) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.5 (SIMD Phase 2): f32v_fmadd/f32v_dot as statements (141-142).
    if (typ >= 141) { if (typ <= 142) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.6 (Phase 3a): iv_add/iv_sub/iv_mul as statements (143-145).
    if (typ >= 143) { if (typ <= 146) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.8 (SIMD Phase 4 R1): f32v8_add/sub/mul as statements (147-149).
    if (typ >= 147) { if (typ <= 149) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.9 (SIMD Phase 4 R2): f32v8_fma/f32v8_dot as statements (150-151).
    if (typ >= 150) { if (typ <= 151) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.5.24 (ymm widening): f64v256_add/sub/mul/div as statements (154-157). The lib
    # wrappers call these in STATEMENT position (`f64v256_add(&r, a_ptr, b_ptr, 4);`), so
    # without this band the builtin lexes and emits fine yet is a syntax error at every
    # real call site. 152/153 (`>>>`, `private`) are deliberately not in the range.
    if (typ >= 154) { if (typ <= 162) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.6.2 — f64_sqrt (136) and callptr (137), renumbered out of their collisions.
    # ⚠ f64_sqrt WAS inside the 62..105 band above, so moving it without this entry would
    # silently regress `f64_sqrt(x);` as a statement, and no test in the tree covered that form.
    # callptr GAINS statement position here: at 111 it hit the `stack var` parser and was a hard
    # error, which the filing recorded as diagnostics-only and was not.
    if (typ >= 136) { if (typ <= 137) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # 6.6.13 — f64_le / f64_ge / f64_trunc (164-166). As lib calls they were legal statements;
    # without this band the builtins would make `f64_trunc(x);` a syntax error (the f64_sqrt lesson).
    if (typ >= 164) { if (typ <= 166) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    if (typ == 2) {
        # Could be assignment or fn call as statement
        var noff = PEEKV(S);
        STI(S, GTI(S) + 1);
        if (_stmt_explicit_generic(S, noff) == 1) { return 0; }   # 6.6.12: `id<i32>(4);`
        if (PEEKT(S) == 10) {
            if (_stmt_call_field(S) == 1) { return 0; }   # 6.6.12: `mk(3).total();`
            # v5.6.3: #must_use — warned BEFORE PARSE_FNCALL, so the line is the call's.
            var _mu_fi = FINDFN(S, noff);
            _must_use_warn(S, noff);
            # fn call statement
            # v6.6.0 — is the callee pair-returning? Read the flag BEFORE PARSE_FNCALL consumes
            # the call, so the `?` desugar below can take the value-form path. Read from the fn
            # table by name rather than peeking the cursor: by the time `?` is seen the cursor is
            # already past the call.
            var _qs_pair = 0;
            _ensure_pair_flags(S);
            var _qs_fi = FINDFN(S, noff);
            if (_qs_fi >= 0) {
                if ((GFLG(S, _qs_fi) & 256) != 0) { _qs_pair = 1; }
            }
            # ⛔ 6.6.5 — `fncallN(cb, …);` AS A STATEMENT WAS NOT THE SAME LANGUAGE AS IN AN
            # EXPRESSION. v6.5.17 lowered `fncallN` to the closure-aware indirect call in
            # PARSE_FACTOR (parse_expr.cyr), but this dispatch sends IDENT+`(` straight to
            # PARSE_FNCALL, so in statement position the SAME TEXT stayed an ordinary call
            # into lib/fnptr.cyr — which calls the bit-63-tagged env pointer verbatim.
            # `fncall1(closure, 2);` SIGSEGV'd (exit 139) while `var r = fncall1(closure, 2);`
            # returned 42. It also gave the two positions OPPOSITE stack alignment (the
            # lowering spills the callee to a frame slot; the plain call pushes it as an
            # argument), which is the asymmetry the mabda filing measured and could not
            # explain from the source text. Same gate as the expression side — a real
            # `fncallN` name, and FINDFN >= 0 so a program that never included
            # lib/fnptr.cyr still gets its "undefined function" diagnostic.
            # CHANGELOG [6.6.5]
            # 6.6.16: no longer "inside a fn" too — at top level the lowering brings its own
            # micro-frame (PINDIRECT_CALL), and the old fall-through to lib/fnptr.cyr called a
            # capturing closure's tagged value: `fncall1(g, 1);` at top level SIGSEGV'd.
            # CHANGELOG [6.6.16]
            var _stmt_fcn = 0;
            if (_IS_FNCALL_NAME(S, noff) == 1) { if (_mu_fi >= 0) { _stmt_fcn = 1; } }
            if (_stmt_fcn == 1) {
                _fncall_expect = ((L64(S + 0xEC00000 + noff) >> 48) & 0xFF) - 48;
                STI(S, GTI(S) + 1);   # consume '('
                PINDIRECT_CALL(S);
            } else {
                PARSE_FNCALL(S, noff);
            }
            _stmt_qmark(S, _qs_pair);   # postfix `?` on the call: see _stmt_qmark
            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
            STI(S, GTI(S) + 1);
            return 0;
        }
        # struct field access: ident.field = expr; or ident.method(args);
        if (PEEKT(S) == 41) {
            # Peek ahead: is this a method call or field store?
            # Save position, consume DOT, check if ident followed by (
            var save_ti = GTI(S);
            # 6.7.0 (A5): the whole `.a.b.m(` chain, not one `.m(` — `b.v.scale(3);` on a nested
            # field was `expected '=', got '.'` (it went to the field store).
            if (_stmt_dot_chain_call(S) == 1) {
                # Method call: rewind and use PARSE_FIELD_LOAD (which handles methods),
                # a postfix `?` included (6.6.16, _stmt_method_call)
                STI(S, save_ti);
                _stmt_method_call(S, noff);
                return 0;
            }
            # Not a method call — rewind and do field store
            STI(S, save_ti);
            PARSE_FIELD_STORE(S, noff);
            return 0;
        }
        if (_arr_sub_stmt(S, noff) == 1) { return 0; }   # 6.6.12: `a[i] = v;` (parse_expr.cyr)
        # assignment or compound assignment: already consumed IDENT
        # Check for +=, -=, *=, /=, %=, &=, |=, ^=, <<=, >>=
        var compound_op = _asg_compound_tok(S);
        _asg_ti = 0 - 1;
        _asg_ufv = 0 - 1;
        if (compound_op == 0) {
            if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
            STI(S, GTI(S) + 1);
            _asg_ti = GTI(S);   # 6.6.10: the RHS's first token, for _IFS_CHECK below
        }
        if (compound_op != 0) {
            # x OP= expr — load x, combine; the store below is shared with `x = expr`. 6.6.11:
            # one implementation with the for-step replay (see _asg_compound_tok).
            var cltype = _asg_compound_load(S, noff);
            _asg_compound_op(S, compound_op, cltype);
            _asg_ufv = 0 - 1;   # after the RHS: a statement nested in it (a closure body) set it
        } else {
            # v6.5.28 — capture the callee's DECLARED return sid BEFORE the RHS is consumed.
            # The declaration path already does this (parse_decl.cyr:2352-2362: peek
            # `IDENT (`, FINDFN, GFRS) — which is why `var t = str_new(..)` correctly types
            # `t` as a Str. The ASSIGNMENT path never did, so `t = str_new(..)` on that same
            # binding warned "assigning non-pointer to typed pointer" about a call that
            # returns exactly that pointer. Filed from abaco after v6.5.27's sign fix made
            # the check reach real typed-pointer locals for the FIRST time and exposed the
            # gap sitting behind it (2026-08-14-typed-ptr-warn-ignores-declared-return-type).
            # ⚠ Must be read BEFORE PCMPE — afterwards the token cursor has moved past the
            # callee name and FINDFN would resolve nothing.
            if (_try_aggregate_copy_assign(S, noff, 5) == 1) { return 0; }
            if (_try_struct_call_assign(S, noff, 5) == 1) { return 0; }   # 6.6.6
            # v6.5.61 — `r = f(...)` into a VECTOR local needs the 16/32-byte receive the
            # declaration form has; without it this fell to the 8-byte EFLSTORE below.
            if (_try_vector_call_assign(S, noff, 5) == 1) { return 0; }
            # v6.6.0 — `x = f();` where f returns a `: stack` pair keeps the tag and drops the
            # payload, silently. Same refusal as the declaration form. CHANGELOG [6.6.0].
            _refuse_lossy_pair(S);
            _asg_ret_peek(S, noff);   # 6.6.17: the RHS's declared type, before PCMPE moves on
            if (_pcmpe_struct_assign(S, noff, 5) == 1) { return 0; }   # PCMPE + a method/operator struct result (6.6.6)
        }
        # Type check at assignment
        var aps = GPSC(S);
        var idx = 0 - 1;
        if (GINFN(S) == 1) {
            idx = FINDLOCAL(S, noff);
            if (idx >= 0) {
                var lt = GLTYPE(S, idx);
                # v6.5.24 — THE SIGN TEST WAS INVERTED, so this warning fired on exactly
                # the locals it should ignore and never once on the case it exists for.
                # In the local SLTYPE scheme a POSITIVE lt is a narrow width in bytes
                # (1/2/4) or a float tag (F64_TYID 0x40000001 / F32_TYID 0x40000002);
                # the pointer-like case is stored NEGATIVE, as `0 - sid`
                # (parse_decl.cyr:2490). `lt > 0` therefore meant "narrow or float".
                # Measured before the fix: `var w: i32 = 5; w = 6;` warned, `var a: f64
                # = ...; a = ...;` warned, and a struct-typed local — the actual typed
                # pointer — did NOT, i.e. the check was unreachable for its own purpose.
                # `lt < 0` is also what the GLOBAL arm of this very warning already uses
                # (`vt < 0`, ~40 lines below); the two arms had silently disagreed.
                # ⭐ Fixing the float half UNGATED the ranga/ganita f32 tier: `acc =
                # f32_op(acc, ..)` is the canonical loop body there, so every f32
                # accumulator in every consumer would have emitted a bogus warning.
                # Filed as 2026-08-13-f64-typed-binding-reassign-warns-as-pointer plus
                # the wider inverted-sign finding (roadmap Slot 1 item (d)).
                # v6.5.28 — a call whose DECLARED return sid is a struct (> 0) IS a typed
                # pointer, even though the call itself leaves the expression pointer-scale at
                # 0. Without this the warning fired on `t = str_new(..)` while the identical
                # initializer `var t = str_new(..)` was accepted — the two paths disagreeing
                # about the same expression.
                if (lt < 0 && _asg_ret_sid <= 0) {
                    if (aps == 0) { WARN(S, "assigning non-pointer to typed pointer", 38); }
                }
            }
        }
        if (idx >= 0) {
            var lt = GLTYPE(S, idx);
            _IFS_CHECK(S, _IFS_K(lt), _asg_ti);   # 6.6.10: `t = 1` into an f64 / f32 local
            _asg_rejudge(S, idx, lt, 0);            # 6.6.11
            _asg_store_slot(S, idx, 0);             # 6.6.12: shared with the for step
        }
        else {
            idx = FINDVAR(S, noff);
            if (idx < 0) {
                # v6.5.19: --syntax-only drops the STORE (there is nowhere to store to)
                # but must still consume the statement's `;`, exactly as the tail of
                # this fn does below. Returning without it left the `;` dangling and
                # the statement layer reported `unexpected ';'` — a FALSE ACCUSATION
                # against valid code, measured on `lib/thread_win.cyr`'s
                # `_threads_active = 1;` (a global declared in a sibling module) and
                # therefore on all 74 repos that vendor it. See _syntax_only.
                if (_syntax_only == 1) {
                    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                    STI(S, GTI(S) + 1);
                    return 0;
                }
                syscall(SYS_WRITE, 2, "error:", 6);
                _err_head(S);
                syscall(SYS_WRITE, 2, ": undefined variable '", 22);
                PRSTR(S + 0xEC00000 + noff);
                syscall(SYS_WRITE, 2, "'\n", 2);
                _err_excerpt(S);   # v6.5.39: excerpt+caret, like every syntax error
                _gv_note_blockscoped(S, noff);   # 6.6.6: see there
                _had_error = 1; if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0;
            }
            var vt = GVTYPE(S, idx);
            if (vt < 0) {
                if (aps == 0) { WARN(S, "assigning non-pointer to typed pointer", 38); }
            }
            _IFS_CHECK(S, _IFS_K(vt), _asg_ti);   # 6.6.10: `G = 1` into an f64 / f32 global
            _asg_rejudge(S, idx, vt, 1);            # 6.6.11
            _asg_store_slot(S, idx, 1);             # 6.6.12: shared with the for step
        }
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);
        return 0;
    }
    if (_refuse_nested_fn(S) == 1) { return 0; }   # 6.6.16: a `fn` / `async fn` in a fn body
    ERR(S);
    return 0;
}

fn PARSE_PROG(S): i64 {
    # v6.6.4: a `public` marker armed before the first top-level statement is STALE here —
    # pass 2's inline `var` skip re-arms it at `public var` and consumes nothing, and this
    # loop never parses `public` (a syntax error after top-level code). Without this the
    # FIRST PARSE_PROG-path declaration (`var`, array, struct literal, destructure) in a
    # private file consumed it and was stamped public. Found by the bite-3 review.
    _pub_pending = 0;
    _pp_depth = _pp_depth + 1;   # 6.6.16 (C1): 1 = module scope (parse_decl.cyr _gai_stmt)
    var go = 1;
    while (go == 1) {
        var typ = PEEKT(S);
        if (typ == 12) { go = 0; }
        else { if (typ == 14) { go = 0; }
            else { if (_tl_directive(S, 1) == 1) {
                    # 6.6.9: the SAME dispatcher the pass-2 scan (_tl_scan2) calls, so an attribute written
                    # after the first top-level statement behaves exactly like one written before it.
                    # (This was a 15th copy; bare `#deprecated` errored here and was a silent no-op
                    # there.) `#assert` also lands here and is evaluated via PARSE_STMT. See _tl_directive.
                }
                else { if (typ == 32) {
                        # 6.6.16: THIS loop is also the fn-body and block parser, so a `fn` here
                        # inside a fn body is a nested fn — refused (`_refuse_nested_fn`). The
                        # relaxed-ordering arm below is for top-level code only (GINFN == 0).
                        if (_refuse_nested_fn(S) == 0) {
                            # fn definition inside top-level code (relaxed ordering)
                            # Emit jmp over fn body, compile fn, patch jmp
                            # v6.6.4: this loop never parses `public` (a `public` after
                            # top-level code is a syntax error), so any armed marker here
                            # is STALE — pass 2's `var` skip re-arms it at `public var` and
                            # nothing on this path consumed it, re-exposing the first
                            # relaxed-ordering fn in a private file.
                            _pub_pending = 0;
                            var fn_skip = EJMP0(S);
                            PARSE_FN_DEF(S);
                            EPATCH(S, fn_skip);
                        }
                    }
                    else { PARSE_STMT(S); } } } }
    }
    # v6.5.24 — bare-metal forbidden-module check (bare-metal deliverable #4), reported
    # HERE rather than at the include site. The preprocessor records which host-only
    # module was pulled (PP_IS_HOST_ONLY / PP_NOTE_HOST_ONLY in lex_pp.cyr) but CANNOT
    # decide: `PREPROCESS(S)` runs at main.cyr:1189 and the CYRIUS_KERNEL env is not read
    # until :1217, so kernel_mode (S+0x18FCA0) is still 0 while includes expand — the
    # first cut checked it there and the gate never fired.
    # ⭐ End-of-PARSE_PROG catches BOTH declaration paths: the
    # `--target=<arch>-bare-metal-elf` triple (env, set before parse) AND the source
    # `kernel;` directive, which is only known once every top-level statement above has
    # been parsed. One shared site, so no per-fork duplication.
    # ⛔ Only the USER's own includes count. cbt prepends one `include` per `[deps].stdlib`
    # module to EVERY build regardless of target, so when a `#@srcline` marker is present
    # (i.e. cbt materialised this compiland) the pre-marker prepends are NOT the kernel
    # author's choice and must not fail the build — the first cut ignored that and turned
    # this repo's own `programs/boot_serial.cyr` red via a manifest-supplied `lib/fs.cyr`.
    # 6.6.5 — re-judge the references whose callee had no owner when they were parsed.
    # Here rather than in each fork: every fork calls PARSE_PROG, so there is no per-fork
    # edit to forget. ⚠ THIS FN IS THE BLOCK PARSER **AND THE FN-BODY PARSER** — it runs at
    # the end of every `if` / `while` body and of every fn definition, so `_vis_check_deferred`
    # consumes each entry as it reports it; the LAST invocation is the end of the fork's
    # top-level call, by which point everything is parsed. Because it is entered that often,
    # the sweep itself is guarded by a PRIVATE-stamp sequence (see `_vis_stamp_seq` in
    # parse_fn.cyr) — without it the walk is quadratic in the deferral count.
    # See _vis_check (src/frontend/parse_fn.cyr). CHANGELOG [6.6.5]
    _vis_check_deferred(S);
    _pp_depth = _pp_depth - 1;
    # With no marker (raw `cat | cycc`) every include is the user's, so the plain latch
    # applies. See PP_NOTE_HOST_ONLY.
    var _ho = _pp_hostonly_hit;
    if (_pp_srcline_seen == 1) { _ho = _pp_hostonly_user; }
    if (_ho == 1) {
        if (L64(S + 0x18FCA0) == 1) {
            syscall(SYS_WRITE, 2, "error: bare-metal build includes host-only module: ", 51);
            var _hol = 0;
            while (load8(&_pp_hostonly_name + _hol) != 0) { _hol = _hol + 1; }
            syscall(SYS_WRITE, 2, &_pp_hostonly_name, _hol);
            syscall(SYS_WRITE, 2, " (marked #host_only; not available under CYRIUS_KERNEL)\n", 56);
            syscall(SYS_EXIT, 1);
        }
    }
    return 0;
}

