# PARSER + CODEGEN — recursive descent, direct emission
# ================================================================

# v4.8.4-alpha4: pending-flag for `#regalloc` → next `fn` definition.
# Token 109 sets this; PARSE_FN_DEF (and the DCE-stub path in main.cyr)
# consume it when they resolve `fi`, storing the flag into fn_regalloc
# at 0x14A000. Codegen attachment (callee-saved spill/restore driven by
# hot-local counting) lands in subsequent alphas — alpha4 only wires
# the metadata so the attribute survives into fn-level state.
var _regalloc_pending = 0;

# v5.6.3: pending-flag for `#must_use` → next `fn` definition. Lexer
# token 122 sets this; PARSE_FN_DEF consumes it when resolving `fi`,
# storing bit 0 into fn_flags at 0x17A000. Call-site discard detection
# lives at PARSE_STMT's expression-statement path: it tracks the
# outermost call's fi in `_stmt_topcall_fi` and warns if that fn's
# must_use bit is set when the statement terminates without the
# result being used (assignment, comparison, or as a sub-expression
# argument — see PARSE_FACTOR for the tracking site).
var _must_use_pending = 0;
var _stmt_topcall_fi = 0 - 1;
# v5.6.3: `@unsafe { ... }` block depth. Incremented on entry to an
# unsafe block; decremented on exit. A nested unsafe block (depth > 1
# at entry) emits an advisory warning. No runtime cost — the block
# body parses exactly like a plain `{ ... }`.
var _unsafe_depth = 0;

# v5.6.4: pending `#deprecated("msg")` → next `fn` definition. Lexer
# token 124 arms _deprecated_pending and the parser consumes the
# `(STR)` args, storing the string token value (offset<<16 | length
# into str_data at 0x21A000) in _deprecated_msg_pending. PARSE_FN_DEF
# transfers both into fn_flags[fi] bit 2 + fn_deprecated_msg[fi].
# Call-site check lives in PARSE_FNCALL — fires at every call, not
# just statement-level discards (that's #must_use's job).
var _deprecated_pending = 0;
var _deprecated_msg_pending = 0;

# v5.8.20: pending fn-attribute flags for the next `fn` definition.
# Lexer tokens 125 / 126 / 127 (#pure / #io / #alloc) set the
# corresponding `_X_pending`; PARSE_FN_DEF consumes them into
# fn_flags[fi] bits 3 / 4 / 5. Effect-checking happens at
# PARSE_FNCALL: when the current fn body is `#pure` (`_cur_fn_is_pure
# == 1`) and the callee has bit 4 (#io) or bit 5 (#alloc) set, emit
# a warning. Same warning shape as #must_use / #deprecated — easy
# downstream incremental adoption; --strict can escalate later.
var _pure_pending = 0;
var _io_pending = 0;
var _alloc_pending = 0;
# v6.2.27: #naked (token 128) — the next fn def is an interrupt-handler /
# naked fn: PARSE_FN_DEF emits NO prologue/epilogue/frame (skip EFNPRO /
# ESUBRSP+frame_patch / regalloc save-restore / EFNEPI). `_cur_fn_naked`
# mirrors it for the duration of the fn body (reset at fn end).
var _naked_pending = 0;
var _cur_fn_naked = 0;
var _cur_fn_is_pure = 0;

# v4.9.1: current-fn #regalloc register count, set inside PARSE_FN_DEF.
# 0 = default ABI, 1 = rbx only (4.8.4 behavior), 2 = rbx+r12,
# 3 = rbx+r12+r13, 4 = rbx+r12+r13+r14, 5 = rbx+r12+r13+r14+r15.
# Codegen uses this to compute displacement shifts (N*8 bytes reserved)
# and to save/restore the correct set of callee-saved registers.
var _cur_fn_regalloc = 0;
# v6.3.37 (A3) — per-fn frame-slot high-water mark. The monomorph/inline-replay
# path (parse_fn.cyr, gated _INLINE_OK||_MONOMORPH_OK) transiently bumps GFLC to
# materialize callee args into enclosing-frame slots, then restores it — so the
# frame-size patch (which reads the FINAL GFLC) under-reserves, and a live runtime
# `push rax` (a binary operand) aliases the transient inline param slot. This
# records the peak so the frame reserves it. Raised ONLY in the flagged replay
# path; stays 0 on default builds → frame size byte-identical.
var _flc_hwm = 0;
# v6.5.14 — set when this fn materialises the address of one of its OWN locals
# (`&local`, incl. `&arr` / `&param`). The tail-call epilogue frees the frame
# BEFORE jumping, so a callee reading through such a pointer sees dead stack.
# v5.8.16 §8 guarded only the SYNTACTIC form `return f(&local)`; a pointer
# laundered through a variable (`var p = &buf; ... return f(p);`) walked straight
# past it. Reset per fn in PARSE_FN_DEF; read by the tail-call guard in
# parse_fn.cyr. See CHANGELOG [6.5.14].
var _fn_local_addr = 0;
# v6.3.39 (B3) — per-fn bitmask: bit i set = param i's declared type is a type-param
# (`fn wrap<T>(p: T)` → bit 0). Populated in PARSE_FN_DEF's param loop (gated
# _MONOMORPH_OK) and read by _body_field_accesses_tparam to decide whether the i64
# BASE emission must skip the body (a tparam-typed param field-accessed as a struct
# has no valid i64 form). Reset per fn; stays 0 on default builds → byte-identical.
var _cur_fn_tp_pmask = 0;
# v6.3.7 — set to 1 when the current fn emits a closure literal. Closures are
# emitted INLINE in the enclosing fn's code range (jumped over), so the enclosing
# fn's regalloc post-pass — a byte-scan that NOP-patches + reallocates locals —
# would rewrite the closure's instructions and corrupt them (SIGILL on call).
# A fn that emits a closure therefore skips the regalloc post-pass (it keeps a
# correct, un-reallocated frame; the only cost is losing the optimization).
var _cur_fn_has_closure = 0;
# v6.3.8 — lexical-capture state for the closure currently being parsed. A closure
# whose body references an enclosing local (a free variable) captures it BY VALUE
# into a heap env object `[fn_ptr, cap0, cap1, …]`; the closure value is that
# object (vtable-shaped, fn_ptr at offset 0), dispatched via callptr. `_cl_snap`
# / `_cl_snap_n` point at the enclosing-locals name snapshot (taken in the closure
# setup); `_cl_cap_slots[0.._cl_ncap)` holds the enclosing slot index of each
# capture (capture index = position in this array); `_cl_shadow` tracks body-local
# `var` names so they shadow enclosing names during the pre-scan.
var _cl_capturing = 0;
var _cl_ncap = 0;
var _cl_snap = 0;
var _cl_snap_n = 0;
var _cl_nshadow = 0;
var _cl_env_lidx = 0;
var _cl_cap_slots[64];
var _cl_shadow[64];
# v5.5.36 Phase 2b — nonzero (= 8) when the current fn returns a
# struct by value. Reserves one 8-byte frame slot for the hidden
# retptr stash, living immediately after the regalloc save area
# and before any regular locals. All local-access emits shift disp
# by this amount so the retptr slot doesn't collide with locals.
var _cur_fn_ret_stash = 0;
# Mirrors the same fn's return-struct sid so PARSE_RETURN can emit
# the struct-copy sequence without re-scanning the fn table. 0 when
# scalar return. Set/reset in parallel with _cur_fn_ret_stash.
var _cur_fn_ret_sid = 0;

# v5.10.45 Phase 1 of struct-byval ABI arc — nonzero when the
# current fn returns a 9-16B int-class value-type struct (Str's
# 16B handle-shape is special-cased out via `_STR_SID(S)` check).
# Triggers PARSE_RETURN's pair-emit path (rax = lo, rdx = hi)
# instead of the scalar PCMPE path. Mutually exclusive with
# `_cur_fn_ret_stash > 0` (the >16B retptr path). Set/reset in
# parallel with `_cur_fn_ret_stash` and `_cur_fn_ret_sid` in the
# fn rough-scan + PARSE_FN_DEF teardown.
var _cur_fn_ret_pair = 0;

# v5.10.28 — current fn's return-type scalar tag (negative encodings
# from `_rt_scalar`: -1=i8, -2=i16, -4=i32, -8=i64, -16=Result,
# -17=Option, -18=Tagged, -19=cstring, -2093=f64v2). PARSE_RETURN
# checks this to dispatch f64v2 multi-register pair return ABI.
# (v6.4.14: f64v2 moved off -20 -> descriptor -2093; f64v4 -> -2125.)
# 0 when fn returns a struct (use _cur_fn_ret_sid) or no annotation.
var _cur_fn_ret_scalar = 0;

# v5.6.19 O4a: 1 if CYRIUS_REGALLOC_DUMP=1 was set at compile start.
# Read once early in main.cyr; consulted by PARSE_FN_DEF to print
# per-fn live-interval table for inspection. Foundation for v5.6.20
# Poletto-Sarkar linear-scan picker — letting us verify intervals
# match expectations before wiring the algorithm.
var _ra_dump_enabled = 0;

# v5.6.20 O4b: CYRIUS_REGALLOC_PICKER_CAP=N — caps total picker
# assignments per fn for bisection (per v5.6.17 saved methodology).
# -1 = uncapped (default; algorithm assigns up to _cur_fn_regalloc).
# 0 = disabled (no picker assignments — falls back to all-stack).
# Used to bisect any codegen bug the new picker might surface.
var _ra_picker_cap = 0 - 1;

# v5.6.22 O4c: CYRIUS_REGALLOC_AUTO_CAP=N — caps how many fns get
# auto-regalloc enabled (per-fn counter increments inside PARSE_FN_DEF).
# -1 = uncapped (every fn auto-enabled). 0 = no auto-enable (back to
# explicit #regalloc opt-in only). Bisection knob for the auto-enable
# codegen bug — find first fn where output diverges.
var _ra_auto_cap = 0 - 1;
var _ra_auto_count = 0;

# v5.11.62: current fn index for the per-fn array-byte attribution
# tracked at 0x1C8000 (reclaimed v5.11.19 fn_regalloc slot). PARSE_FN_DEF
# sets to the fn's fi at entry and resets to -1 at exit. parse_decl.cyr's
# array-registration path (parse_decl.cyr `PARSE_ARRAY`) adds the aligned
# size into the slot when this is >= 0; top-level `var foo[N]` declarations
# (no enclosing fn) skip the accounting. Read by FIXUP's `large static
# data` warning emitter (src/backend/x86/fixup.cyr) to compute "M bytes
# inside N unreachable fns" attribution after the DCE pass identifies dead
# hosts. See CHANGELOG [5.11.62].
var _cur_fn_ix = 0 - 1;

# v6.3.11 (G) — async/await. `_IS_FN_KW` lets the top-level dispatch in every
# driver fork route a leading `async` (token 134) to the same fn path as `fn`
# (token 32) without 7×2 bespoke branches: the dispatch checks `_IS_FN_KW(S)==1`
# instead of `PEEKT(S)==32`, and the shared _prescan_fn_sig / PARSE_FN_DEF consume
# the optional `async` prefix. Token 134 only exists when source has `async`
# (cycc has none → byte-identical self-host), so no _ASYNC_OK guard is needed here.
# ── v6.5.0 file-scoped visibility: the top-level `private` / `public` markers ──
#
# `private` on its own at top level flips THIS FILE to private-by-default; `public`
# (== `pub`, token 73) in front of an individual item re-exposes it. Default with no
# declaration is today's behaviour, everything public — so this is opt-in per file and
# nothing in the tree or the ecosystem changes until a file asks for it.
#
# ONE shared helper rather than 14 hand-written dispatch arms. The top-level token
# dispatch is inline code duplicated across pass 1 and pass 2 of all 7 `main_*.cyr`
# forks, and BOTH fallthroughs terminate the parse SILENTLY — so a fork where the new
# token was forgotten would not error, it would quietly stop parsing. Routing every
# site through one call means the set of edits is a mechanical one-line substitution
# and the behaviour cannot drift between forks. (Same reasoning as `_capacity_warnings`
# at v6.4.50, which pulled a block duplicated in 2 of 7 drivers into one shared fn and
# thereby fixed the 5 forks that had silently never had it.)
#
# Returns 1 if it consumed a visibility marker, 0 otherwise. Callers pass through to
# their existing chain on 0.
#
# Recording is IDEMPOTENT: both passes walk the same token stream, so pass 2 re-marks
# the same file id pass 1 already marked. That is deliberate — it means one helper
# serves both passes with no pass-awareness.
var _priv_files[512];        # 512*8 = 4096 B = 32768 bits, one per possible file id
var _pub_pending = 0;        # `public` seen; consumed by the next fn definition

fn _PRIV_MARK(fid): i64 {
    if (fid <= 0) { return 0; }
    if (fid >= 32768) { return 0; }
    var w = fid / 64;
    var b = fid % 64;
    store64(&_priv_files + w * 8, load64(&_priv_files + w * 8) | (1 << b));
    return 0;
}

fn _PRIV_FILE(fid): i64 {
    if (fid <= 0) { return 0; }
    if (fid >= 32768) { return 0; }
    var w = fid / 64;
    var b = fid % 64;
    if ((load64(&_priv_files + w * 8) & (1 << b)) != 0) { return 1; }
    return 0;
}

fn _TL_VIS(S): i64 {
    var t = PEEKT(S);
    if (t == 73) {
        # `public` / `pub` — re-expose the NEXT item. Consumed by PARSE_FN_DEF.
        _pub_pending = 1;
        STI(S, GTI(S) + 1);
        return 1;
    }
    if (t == 153) {
        # `private` — flip the file this token sits in. Keyed on the token's own line
        # through the file map, NOT on a running flag: a running flag armed here would
        # leak into every file included AFTER this point, which is exactly the
        # inheritance the committed design forbids.
        _PRIV_MARK(FM_FILEID(S, GTLINE(S, GTI(S))));
        STI(S, GTI(S) + 1);
        # Tolerate an optional trailing `;` so both `private` and `private;` parse.
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
        return 1;
    }
    return 0;
}

# v6.5.0 Phase 2b — stamp a global var's visibility. `decl_ti` is the `var` keyword
# token, so the file is derived from the declaration itself rather than from whatever
# token happens to be current (the same reasoning as the fn stamp using `_defstart_ti`).
fn _GVAR_VIS(S, vi, decl_ti): i64 {
    var fid = FM_FILEID(S, GTLINE(S, decl_ti));
    if (_pub_pending == 0) {
        if (_PRIV_FILE(fid) == 1) { SVFI(S, vi, fid + 1); }
    }
    _pub_pending = 0;
    return 0;
}

fn _IS_FN_KW(S): i64 {
    var t = PEEKT(S);
    if (t == 32) { return 1; }
    if (t == 134) { return 1; }
    return 0;
}

# Lazily resolve the async feature gate from CYRIUS_ASYNC the first time an
# `async`/`await` token reaches pass 2 (PARSE_FN_DEF / PEXPR). Default off → the
# gated lowering is unreachable and cycc self-host is byte-identical (async/await
# never appear in cycc src, so this is never called during self-host). Same opt-in
# contract as _MONOMORPH_OK, but lazy — avoids a per-fork driver env-read edit.
fn _ensure_async_gate(S): i64 {
    if (_async_gate_init == 1) { return _ASYNC_OK; }
    _async_gate_init = 1;
    var e = _read_env("CYRIUS_ASYNC");
    if (e != 0) { if (load8(e) == 49) { if (load8(e + 1) == 0) { _ASYNC_OK = 1; } } }
    return _ASYNC_OK;
}

# v6.3.13 (thread-safe array locals): a `var arr[N]` declared INSIDE a function is
# historically allocated in the global/BSS data region at a FIXED address — shared
# by every thread, so concurrent code that uses an array-local corrupts (root cause
# of the str_builder concurrency bug). When this gate is on, small array locals are
# registered as multi-slot per-thread STACK locals (the struct-local mechanism) and
# large ones are heap-allocated per call — so &arr / arr[i] resolve via FINDLOCAL to
# a per-thread address. Default OFF during the v6.3.13 dev cycle (flipped ON at slot
# close via a two-step bootstrap). Lazy-init from CYRIUS_STACK_ARRAYS — no per-fork edit.
fn _ensure_stack_arrays(S): i64 {
    if (_sa_init == 1) { return _STACK_ARRAYS; }
    _sa_init = 1;
    # v6.3.15: DEFAULT-ON. `var arr[N]` LOCALS route to per-thread STACK slots (fixes the
    # str_builder concurrency root cause — v6.3.13: array locals used to share one global
    # .bss buffer across all threads). The two v6.3.13 default-on blockers are resolved:
    # (1) SSE m128 16-alignment — array stack slots whose `&arr` disp would be 8 (mod 16)
    # get a one-slot parity pad so `pxor/aesenc xmm,[arr]` stays #GP-free (see PARSE_ARRAY);
    # (2) `secret var` zeroise now addresses the LOCAL (ELOAD_LOCAL_ADDR), not the global.
    # CYRIUS_STACK_ARRAYS=0 opts back to legacy global (.bss) arrays. See CHANGELOG [6.3.15].
    # ⛔ v6.5.12: THE OPT-OUT IS NOT SILENT ANY MORE — it can re-open a fixed CVE-class
    # defect in a DOWNSTREAM library, and nothing said so.
    #
    # sigil 3.12.3 fixed an RSA authentication bypass (`rsa_pkcs1v15_verify_sha256`
    # returning 1 for INVALID signatures — 888 of 400,000 forged signatures accepted,
    # measured by agnosai) and the ENTIRE fix is "make the verify scratch buffers
    # function-LOCAL": `var nbuf[512]` / `var embuf[512]` / `var expbuf[512]`. That fix
    # only holds because array locals are per-thread STACK slots. Setting
    # CYRIUS_STACK_ARRAYS=0 turns them back into shared .bss globals — the two operands
    # of the verify decision land in one lane-indexed global again and the bypass
    # RETURNS, with no diagnostic anywhere.
    #
    # The flag stays (it is a real debugging escape hatch and has been default-on since
    # v6.3.15), but a security property must not be revocable in silence. Warn, name what
    # it costs, and let the caller decide — the same reasoning as the v6.5.11 "no silent
    # caps" work.
    _STACK_ARRAYS = 1;
    var e = _read_env("CYRIUS_STACK_ARRAYS");
    if (e == 0) { return _STACK_ARRAYS; }
    if (load8(e) == 48) {
        if (load8(e + 1) == 0) {
            _STACK_ARRAYS = 0;
            syscall(SYS_WRITE, 2, "warning: CYRIUS_STACK_ARRAYS=0 — `var arr[N]` locals are shared .bss globals, not per-thread stack.\n", 102);
            syscall(SYS_WRITE, 2, "  This REVERTS the mechanism sigil 3.12.3 relies on to fix its RSA verify bypass; crypto scratch\n", 97);
            syscall(SYS_WRITE, 2, "  buffers become cross-thread shared again. Do not use for anything that verifies signatures.\n", 94);
        }
    }
    return _STACK_ARRAYS;
}


