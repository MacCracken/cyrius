# Linux x86_64 syscalls, or -1 if unknown. The table is fixed — free information.

# v5.5.38: expression-parsing fns extracted.
include "src/frontend/parse_expr.cyr"


# Parse array: already past [, parse N]; register global var with aligned size

# v5.5.38: var/array/field/struct-init/assignment fns extracted.
include "src/frontend/parse_decl.cyr"


# Emit inverted jcc for comparison op, return patch offset

# v5.5.38: fn decls + calls + returns + impls + PARSE_FN_DEF extracted.
include "src/frontend/parse_fn.cyr"


# ASM_MNEMONIC and helpers are in arch-specific emit files:
# src/backend/x86/emit.cyr and src/backend/aarch64/emit.cyr

# v6.5.19 (CVE-39) — bound the jump-end arrays of PARSE_SWITCH and PARSE_MATCH.
#
# Both fns collect one "jump to end of construct" patch site per case/arm into a LOCAL
# `ends: i64[256]`, then walk it once the construct closes. The counter `ec` was never
# checked against 256 at ANY of the four write sites, so case 257 wrote straight off the
# stack frame. This needs no hostile input: a 400-case `switch` and a 400-arm `match`
# are ordinary valid cyrius — exactly the opcode-dispatch shape this compiler's own
# sources use — and both killed cycc with a SIGSEGV and ZERO diagnostic bytes.
#
# v6.2.1 is the near-miss worth recording: it found the same arrays overflowing at 32
# entries, correctly diagnosed the `var ends[256]` = 256 BYTES = 32 slots trap (see
# CLAUDE.md), and resized them to `i64[256]`. But resizing MOVED the cliff from 32 to
# 256 without ever fencing it, and added a `seen_count < 256` guard on the neighbouring
# dedup array — so the file already shows the author knew a bound was needed, one
# declaration away. A capacity fix is not a bounds fix.
#
# HARD ERROR, never a silent skip: dropping a jump-end patch leaves that arm falling
# through into the next one, i.e. a silent miscompile, which is strictly worse than
# refusing the file. Shared by all four sites so the limit cannot drift between them.
# v6.5.23 — CAPACITY joins the RECOVERABLE diagnostic class (maintainer decision,
# 2026-08-17: "recoverable"). Reported once and the parse continues, so ONE compile names
# this alongside every other error in the file instead of stopping here.
#
# ⚠ THIS DOES NOT WEAKEN THE HAZARD THE NOTE ABOVE DESCRIBES. `_had_error` withholds the
# binary (the v6.4.62 multi-error contract), so the fall-through miscompile it warns about
# — an unpatched jump-end letting one arm fall into the next — can never reach an
# executable. "Recoverable" means the DIAGNOSTIC recovers, not that a broken binary ships.
# Returning 1 lets the caller skip recording a patch it has no slot for, rather than
# writing past the 256-slot array, which is what the guard existed to prevent.
#
# ⛔ THE 256 CAP ITSELF IS UNRESOLVED AND MUST BE RE-REVIEWED WHEN IT BECOMES THE
# BOTTLENECK (maintainer, 2026-08-17). This change makes hitting it survivable and
# legible; it does not raise it. v6.2.1 already moved this cliff once (32 → 256) without
# fencing it, and the note above records that "a capacity fix is not a bounds fix" — the
# converse also holds: this is a bounds fix, not a capacity fix. When a real consumer
# needs >256 arms, the arrays are `i64[256]` in four sites and the limit is shared through
# this fn precisely so it can be raised in one place.
fn _ends_guard(S, ec): i64 {
    if (ec >= 256) {
        syscall(SYS_WRITE, 2, "error:", 6); _err_head(S);
        syscall(SYS_WRITE, 2, ": too many case/arm bodies in one switch/match (max 256)\n", 57);
        _had_error = 1;
        return 1;
    }
    return 0;
}

# v6.5.20 — patch the pending `break` chain to the CURRENT code position and
# restore the enclosing construct's chain head. `break` threads a linked list
# through the rel32 field of each placeholder jmp, head at S+0x18F840; the
# construct that owns the chain saves the head, zeroes it, parses the body, then
# walks and patches. PARSE_WHILE / PARSE_FOR did this; PARSE_SWITCH / PARSE_MATCH
# never touched the slot at all, so a `break` inside a switch either broke the
# ENCLOSING LOOP or — with no enclosing loop — was never patched and kept the
# chain link in its displacement field: a wild jump, SIGSEGV at runtime.
# CHANGELOG [6.5.20]
fn _brk_chain_end(S, saved_brk): i64 {
    var bp = L64(S + 0x18F840);
    while (bp > 0) {
        var _ba = _codebuf_base + bp;
        var _nb = L64(_ba) & 0xFFFFFFFF;
        EPATCH(S, bp);
        bp = _nb;
    }
    S64(S + 0x18F840, saved_brk);
    return 0;
}

# v6.5.20 — register a switch jump table for the per-fn NOP-compaction repair
# (_sw_tbl_repair, parse_fn.cyr). Entries hold `target_cp - table_cp`; the
# v5.6.27 compactor shifts code but knew nothing about this table, so harvesting
# a 4-byte NOP run between the table and a case body left every later entry
# stale. Overflow past the 256 cap keeps counting so the compaction gate trips
# and skips the pass for that fn — never a silent drop. CHANGELOG [6.5.20]
fn _sw_tbl_reg(S, table_cp, nent): i64 {
    var n = L64(S + 0x1AC800);
    if (n < 256) {
        S64(S + 0x1AC808 + n * 16, table_cp);
        S64(S + 0x1AC808 + n * 16 + 8, nent);
    }
    S64(S + 0x1AC800, n + 1);
    return 0;
}

fn PARSE_SWITCH(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
    STI(S, GTI(S) + 1);
    PCMPE(S);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    # Pre-scan: collect case values to decide chain vs jump table
    var save_ti = GTI(S);
    var case_count = 0;
    var case_min = 0x7FFFFFFFFFFFFFFF;
    var case_max = 0;
    var has_default = 0;
    var pgo = 1;
    while (pgo == 1) {
        if (PEEKT(S) == 58) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) == 1) {
                var cv = PEEKV(S);
                if (case_count == 0) { case_min = cv; case_max = cv; }
                else {
                    if (cv < case_min) { case_min = cv; }
                    if (cv > case_max) { case_max = cv; }
                }
                case_count = case_count + 1;
            }
            # Skip to next case/default/} (track brace depth for block bodies)
            var _psd = 0;
            while (1) {
                if (PEEKT(S) == 13) { _psd = _psd + 1; }
                if (PEEKT(S) == 14) { if (_psd > 0) { _psd = _psd - 1; } else { break; } }
                if (_psd == 0 && PEEKT(S) == 58) { break; }
                if (_psd == 0 && PEEKT(S) == 59) { break; }
                if (PEEKT(S) == 12) { break; }
                STI(S, GTI(S) + 1);
            }
        }
        else { if (PEEKT(S) == 59) { has_default = 1;
                var _psd2 = 0;
                while (1) {
                    if (PEEKT(S) == 13) { _psd2 = _psd2 + 1; }
                    if (PEEKT(S) == 14) { if (_psd2 > 0) { _psd2 = _psd2 - 1; } else { break; } }
                    if (PEEKT(S) == 12) { break; }
                    STI(S, GTI(S) + 1);
                }
            }
            else { pgo = 0; } }
    }
    STI(S, save_ti);
    # Decide: jump table if >= 4 cases, density >= 1/3, and range < 256.
    # v4.8.2 lowered threshold from 50% (*2) to 33% (*3) — more real-world
    # enum-like switches with a few gaps now hit the O(1) dispatch path.
    # The 256-byte range cap keeps the jump table itself small.
    var range = case_max - case_min;
    var use_table = 0;
    if (case_count >= 4) {
        if (range + 1 <= case_count * 3) {
            # v4.8.2-alpha2: range cap raised 256 → 1024. Jump table is
            # (range+1) × 4 bytes, so a 1024-range table is ~4 KB of
            # .text — still tiny, and wider enum dispatches (e.g. the
            # 40+-variant tagged-union switches in libro / kybernet)
            # now hit the O(1) path.
            if (range < 1024) { use_table = 1; }
        }
    }
    # v5.6.0 + v5.11.39: jump-table path is x86-only. aarch64 and cx
    # take the chain path (linear comparison) — aarch64 has no jump-
    # table emitter today, and cx bytecode has no analog of rip-
    # relative LEA + indirect JMP via a packed-i32 table. Without
    # these guards the named-op layer would still no-op out for both
    # (the stubs in <arch>/emit.cyr are pure IR-record), but the
    # parser would still emit the `EJCC` jump pre-table that has no
    # corresponding back-patch on the no-op path — leaving a stranded
    # `ja default` in cx output. Setting use_table = 0 here keeps the
    # parser on the correctness-preserving chain path.
    if (_AARCH64_BACKEND == 1) { use_table = 0; }
    if (_TARGET_CX == 1) { use_table = 0; }
    # Allocate hidden global to hold switch value
    var swidx = GVCNT(S);
    S64(_varn_base + swidx * 8, 0);
    S64(_vars_base + swidx * 8, 8);
    SVCNT(S, swidx + 1);
    EVSTORE(S, swidx);
    # v6.5.20: own the `break` chain for the duration of the case bodies so a
    # `break` inside a case leaves the SWITCH (C semantics), not the enclosing
    # loop. `continue` is a separate chain (0x18F898/0x18F8A0) and is deliberately
    # NOT captured — it must still continue the enclosing loop.
    var saved_brk = L64(S + 0x18F840);
    S64(S + 0x18F840, 0);
    if (use_table == 1) {
        # === JUMP TABLE PATH ===
        # v5.11.39 path-A: dispatch sequence + reserved zero table
        # live in <backend>/emit.cyr. Parser keeps the `EJCC` call
        # between the two named ops since EJCC returns the
        # default-jump patch position (back-patched when the
        # `default:` case body is parsed).
        ESWITCH_DISPATCH_PRE(S, case_min, range);
        var default_patch = EJCC(S, 0x87);   # ja default
        var table_cp = ESWITCH_DISPATCH_TABLE(S, range);
        # v6.5.20: hand the table to the compaction repair. The `lea rcx,[rip+d32]`
        # inside ESWITCH_DISPATCH_TABLE needs no repair — the nine bytes between its
        # disp32 and table_cp are raw (`movsxd`/`add`/`jmp rax`) and can never match
        # the picker's `48 8B|89 85` probe, so no NOP run can be harvested between
        # them and the disp is shift-invariant.
        _sw_tbl_reg(S, table_cp, range + 1);
        var ti = 0;
        # Parse case bodies, patching table entries
        var ends: i64[256];   # v6.2.1: 256 jump-end slots (was bare [256]=256B=32 slots → OOB at >32 cases)
        var ec = 0;
        var default_cp = 0 - 1;   # filled in when `default:` is parsed
        var sgo = 1;
        while (sgo == 1) {
            if (PEEKT(S) == 58) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 1) { ERR_EXPECT(S, 1); }
                var val = PEEKV(S);
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
                STI(S, GTI(S) + 1);
                # Patch table entry: table[val - min] = body_cp - table_cp
                var body_cp = GCP(S);
                var toff = (val - case_min) * 4 + table_cp;
                var ta = _codebuf_base + toff;
                var trel = body_cp - table_cp;
                S64(ta, (L64(ta) >> 32 << 32) | (trel & 0xFFFFFFFF));
                # Parse case body
                var cgo = 1;
                while (cgo == 1) {
                    if (PEEKT(S) == 58) { cgo = 0; }
                    else { if (PEEKT(S) == 59) { cgo = 0; }
                        else { if (PEEKT(S) == 14) { cgo = 0; }
                            else { if (PEEKT(S) == 12) { cgo = 0; }
                                else { PARSE_STMT(S); } } } }
                }
                var _eg = _ends_guard(S, ec);
                var _ep = EJMP0(S);
                if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
            }
            else { if (PEEKT(S) == 59) {
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
                    STI(S, GTI(S) + 1);
                    # Default body — patch default_patch to here
                    EPATCH(S, default_patch);
                    default_patch = 0;
                    default_cp = GCP(S);
                    while (PEEKT(S) != 14) {
                        if (PEEKT(S) == 12) { break; }
                        PARSE_STMT(S);
                    }
                    var _eg = _ends_guard(S, ec);
                    var _ep = EJMP0(S);
                    if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
                }
                else { sgo = 0; } }
        }
        # Patch default jump if no default case was found
        if (default_patch > 0) { EPATCH(S, default_patch); }
        # Fill unpatched table entries. If a `default:` was present
        # (v4.8.2), gaps within [case_min, case_max] now jump to the
        # default body — before this fix they fell through to the
        # end of the switch, which silently hid sparse-case bugs at
        # the previous 50% density threshold (no gaps). When no
        # default exists, gaps still fall through.
        var end_cp = GCP(S);
        var gap_rel = end_cp - table_cp;
        if (default_cp >= 0) { gap_rel = default_cp - table_cp; }
        ti = 0;
        while (ti <= range) {
            var te = _codebuf_base + table_cp + ti * 4;
            if (load32(te) == 0) {
                S64(te, (L64(te) >> 32 << 32) | (gap_rel & 0xFFFFFFFF));
            }
            ti = ti + 1;
        }
        if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
        STI(S, GTI(S) + 1);
        for (var ei = 0; ei < ec; ei = ei + 1) { EPATCH(S, load64(&ends + ei * 8)); }
    } else {
        # === CHAIN PATH (original) ===
        var ends: i64[256];   # v6.2.1: 256 jump-end slots (see table-path note above)
        var ec = 0;
        var sgo = 1;
        while (sgo == 1) {
            if (PEEKT(S) == 58) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 1) { ERR_EXPECT(S, 1); }
                var val = PEEKV(S);
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
                STI(S, GTI(S) + 1);
                EVLOAD(S, swidx);
                EPUSHR(S);
                EMOVI(S, val);
                EMOVCA(S);
                EPOPR(S);
                ECMPR(S);
                var skip = EJCC(S, 0x85);
                var cgo = 1;
                while (cgo == 1) {
                    if (PEEKT(S) == 58) { cgo = 0; }
                    else { if (PEEKT(S) == 59) { cgo = 0; }
                        else { if (PEEKT(S) == 14) { cgo = 0; }
                            else { if (PEEKT(S) == 12) { cgo = 0; }
                                else { PARSE_STMT(S); } } } }
                }
                var _eg = _ends_guard(S, ec);
                var _ep = EJMP0(S);
                if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
                EPATCH(S, skip);
            }
            else { if (PEEKT(S) == 59) {
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
                    STI(S, GTI(S) + 1);
                    # NOTE (v6.5.20): unlike the table path, this body deliberately gets
                    # NO jump to the end of the switch — the chain path REACHES its
                    # default by falling out of the last comparison, so the default body
                    # must be emitted last and control already lands past it. A
                    # `default:` written before another arm is rejected outright
                    # (`unexpected case`) by the `!= 14` loop above, so there is no
                    # silent fall-through here. Do not "fix" this into an EJMP0 without
                    # also giving a non-last default a jump-over + backward entry.
                    while (PEEKT(S) != 14) {
                        if (PEEKT(S) == 12) { break; }
                        PARSE_STMT(S);
                    }
                }
                else { sgo = 0; } }
        }
        if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
        STI(S, GTI(S) + 1);
        for (var ei = 0; ei < ec; ei = ei + 1) { EPATCH(S, load64(&ends + ei * 8)); }
    }
    _brk_chain_end(S, saved_brk);
    return 0;
}

# Parse: match expr { val => { stmts } val => { stmts } _ => { stmts } }
fn PARSE_MATCH(S): i64 {
    # v5.8.22 bite #2 — capture match-keyword line for exhaustive-
    # coverage diagnostic before STI consumes it.
    var match_line = GTLINE(S, GTI(S));
    STI(S, GTI(S) + 1);
    PCMPE(S);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    # Store match value in hidden temp var
    var midx = GVCNT(S);
    S64(_varn_base + midx * 8, 0);
    S64(_vars_base + midx * 8, 8);
    SVCNT(S, midx + 1);
    EVSTORE(S, midx);
    # v6.5.20: `break` inside a match arm leaves the MATCH — same chain protocol
    # as PARSE_SWITCH / PARSE_WHILE. Untouched before this, so it either broke the
    # enclosing loop or left an unpatched wild jump. CHANGELOG [6.5.20]
    var saved_brk = L64(S + 0x18F840);
    S64(S + 0x18F840, 0);
    var ends: i64[256];   # v6.2.1: 256 match-arm jump-end slots (was [256]=32 slots → OOB at >32 arms)
    var ec = 0;
    # v5.8.22 bite #2 — exhaustive-match coverage tracking. When the
    # arm's pattern is a bare-or-payloaded variant of an enum, look
    # up its parent enum-id (var_enum_id at 0x204000, written by
    # PARSE_ENUM_DEF in bite #1). First variant arm sets match_eid;
    # subsequent variant arms must share the same eid (mixed → warn).
    # had_default tracks whether `_ =>` was present (opt-out). Final
    # check: if eid != 0 && !had_default && covered < total → warn.
    var match_eid = 0;
    var match_covered = 0;
    var match_mixed = 0;
    var had_default = 0;
    # v5.8.25 — arm-tag dedup. Stack array of variant vcnts seen
    # so far; per-arm linear scan flags duplicate arms with
    # `warning: duplicate match arm 'X'` and skips counting the
    # dup toward match_covered (so the non-exhaustive check
    # stays accurate when a user writes the same variant twice).
    # 256 cap matches the per-match arm budget; beyond that no
    # dedup (rare-edge tolerated). Linear scan is O(N²) but
    # typical match has 2-10 arms so cost is negligible.
    var seen_vcnt: i64[256];   # v6.2.1: matches the `seen_count < 256` guard (was [256]=32 slots → OOB at >32 unique variants)
    var seen_count = 0;
    var mgo = 1;
    while (mgo == 1) {
        if (PEEKT(S) == 14) { mgo = 0; }
        # v6.5.19: EOF guard (CVE-39). `fn f() { match` and `fn f() { match (` SIGSEGV'd
        # at 6.5.18 — and this one bit FASTEST of the whole class, because the arm loop
        # writes `ends`/`seen_vcnt`, which are 256-slot LOCAL (stack) arrays: a runaway
        # arm count smashes the frame long before any heap table overflows.
        elif (PEEKT(S) == 12) { mgo = 0; }
        else {
            # Check for _ (wildcard/default)
            var is_default = 0;
            if (PEEKT(S) == 2) {
                # Check if identifier is "_"
                var mnoff = PEEKV(S);
                if (load8(S + 0x60000 + mnoff) == 95) {
                    if (load8(S + 0x60000 + mnoff + 1) == 0) {
                        is_default = 1;
                    }
                }
            }
            if (is_default == 1) {
                had_default = 1;
                # _ => { stmts }
                STI(S, GTI(S) + 1);
                # Expect =>
                if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 20) { ERR_EXPECT(S, 20); }
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
                STI(S, GTI(S) + 1);
                SCOPE_PUSH(S);
                PARSE_PROG(S);
                SCOPE_POP(S);
                if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
                STI(S, GTI(S) + 1);
                # v6.5.20: the `_ =>` arm emitted no jump to the end of the match,
                # so a wildcard arm written before another arm FELL THROUGH into
                # that arm's comparison and a LATER arm could win — a silent wrong
                # answer (`match 2 { 1 => 11  _ => 7  2 => 22 }` gave 22, not 7).
                # A wildcard matches everything, so the arms after it are dead.
                # PARSE_SWITCH's chain-path `default:` looks like the same shape but
                # is NOT: a non-last `default:` is rejected there at parse time.
                var _eg = _ends_guard(S, ec);
                var _ep = EJMP0(S);
                if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
            } else {
                # v5.8.22 bite #2 — pre-PCMPE peek: if the arm pattern's
                # first token is a variant-of-enum ident, record its
                # parent eid. Bare variants (`Ok`) and payload-bearing
                # variants (`Ok(v)`) both have the variant name as the
                # first ident. Non-variant arms (literals, regular
                # const vars, complex exprs) skip the bookkeeping.
                if (PEEKT(S) == 2) {
                    var arm_noff = PEEKV(S);
                    var arm_vi = FINDVAR(S, arm_noff);
                    if (arm_vi >= 0) {
                        var arm_eid = GVENUMID(S, arm_vi);
                        if (arm_eid > 0) {
                            # v5.8.25 — dedup: scan seen_vcnt for arm_vi.
                            # If found, emit duplicate-arm warning + skip
                            # coverage bump (accurate non-exhaustive math).
                            # If new, record + bump as before.
                            var dupe = 0;
                            var di = 0;
                            while (di < seen_count) {
                                if (load64(&seen_vcnt + di * 8) == arm_vi) { dupe = 1; }
                                di = di + 1;
                            }
                            if (dupe == 1) {
                                syscall(SYS_WRITE, 2, "warning:", 8);
                                _err_head(S);
                                syscall(SYS_WRITE, 2, ": duplicate match arm '", 23);
                                PRSTR(S + 0x60000 + arm_noff);
                                syscall(SYS_WRITE, 2, "'\n", 2);
                            } else {
                                if (seen_count < 256) {
                                    store64(&seen_vcnt + seen_count * 8, arm_vi);
                                    seen_count = seen_count + 1;
                                }
                                if (match_eid == 0) { match_eid = arm_eid; }
                                if (arm_eid == match_eid) {
                                    match_covered = match_covered + 1;
                                } else {
                                    match_mixed = 1;
                                }
                            }
                        }
                    }
                }
                # val => { stmts }
                EVLOAD(S, midx);
                EPUSHR(S);
                PCMPE(S);
                EMOVCA(S);
                EPOPR(S);
                ECMPR(S);
                var skip = EJCC(S, 0x85);
                # Expect =>
                if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 20) { ERR_EXPECT(S, 20); }
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
                STI(S, GTI(S) + 1);
                SCOPE_PUSH(S);
                PARSE_PROG(S);
                SCOPE_POP(S);
                if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
                STI(S, GTI(S) + 1);
                var _eg = _ends_guard(S, ec);
                var _ep = EJMP0(S);
                if (_eg == 0) { store64(&ends + ec * 8, _ep); ec = ec + 1; }
                EPATCH(S, skip);
            }
        }
    }
    STI(S, GTI(S) + 1);
    for (var ei = 0; ei < ec; ei = ei + 1) { EPATCH(S, load64(&ends + ei * 8)); }
    _brk_chain_end(S, saved_brk);
    # v5.8.22 bite #2 — exhaustive-match coverage check. Warning (not
    # error) so v5.8.x downstream consumers can adopt incrementally —
    # same trade-off as #must_use / #deprecated / #pure→#io. Promotes
    # to lint --strict in a follow-up slot.
    if (match_eid != 0) {
        if (match_mixed == 1) {
            syscall(SYS_WRITE, 2, "warning:", 8);
            FM_LOOKUP(S, match_line);
            syscall(SYS_WRITE, 2, ": match arms span multiple enums (exhaustive-coverage check skipped)\n", 69);
        } else {
            if (had_default == 0) {
                var match_total = GENUMVCNT(S, match_eid - 1);
                if (match_covered < match_total) {
                    syscall(SYS_WRITE, 2, "warning:", 8);
                    FM_LOOKUP(S, match_line);
                    syscall(SYS_WRITE, 2, ": non-exhaustive match over enum '", 34);
                    PRSTR(S + 0x60000 + GENUMNM(S, match_eid - 1));
                    syscall(SYS_WRITE, 2, "' — covers ", 13);
                    PRNUM(match_covered);
                    syscall(SYS_WRITE, 2, " of ", 4);
                    PRNUM(match_total);
                    syscall(SYS_WRITE, 2, " variants; add `_ =>` to opt out\n", 33);
                }
            }
        }
    }
    return 0;
}

# Evaluate a single constant atom for #assert: number literal or sizeof(T).
# Returns the constant value. Advances TI past the consumed tokens.
fn _EVAL_CONST_ATOM(S): i64 {
    var t = PEEKT(S);
    if (t == 1) {
        var v = PEEKV(S);
        STI(S, GTI(S) + 1);
        return v;
    }
    if (t == 2) {
        var noff = PEEKV(S);
        # sizeof(Type)
        if (L64(S + 0x60000 + noff) & 0xFFFFFFFFFFFF == 0x666F657A6973) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
            STI(S, GTI(S) + 1);
            var szval = 0;
            if (PEEKT(S) == 2) {
                var szn = PEEKV(S);
                STI(S, GTI(S) + 1);
                var szname = L64(S + 0x60000 + szn);
                szval = _scalar_name_width(szname);
                if (szval == 0) {
                    var szsid = FINDSTRUCT(S, szn);
                    if (szsid > 0) { szval = STRUCTSZ(S, szsid - 1); }
                    else { ERR_MSG(S, "#assert: unknown type in sizeof", 31); }
                }
            }
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
            STI(S, GTI(S) + 1);
            return szval;
        }
        ERR_MSG(S, "#assert: expected number or sizeof()", 36);
    }
    ERR_MSG(S, "#assert: expected constant expression", 37);
    return 0;
}

# v6.4.62 (DX multi-error): the recovery chokepoint. Every statement parse goes
# through this wrapper, so when a nested error set _panic we resync to the next
# statement boundary (_sync_skip) once, at the tightest enclosing statement. The
# guaranteed-progress guard (GTI must advance or force one token) stops the
# enclosing block/PROG loop from spinning if a statement made no progress; the
# PEEKT watchdog is the deeper backstop for loops that never return here. On VALID
# input _panic is never set and every statement advances → pure pass-through (byte-id).
fn PARSE_STMT(S): i64 {
    var before = GTI(S);
    # v6.5.19 (CVE-40): this wrapper is already the one place every statement descent
    # passes through, which makes it the natural home for the depth bound too. See
    # _rd_enter (src/common/util.cyr). Covers nested fn / blocks / if / while.
    _rd_enter(S);
    _PARSE_STMT_IMPL(S);
    _rd_exit();
    if (_panic == 1) { _sync_skip(S); }
    if (GTI(S) == before) {
        if (GTI(S) < GTCNT(S)) { STI(S, GTI(S) + 1); }
    }
    return 0;
}

fn _PARSE_STMT_IMPL(S): i64 {
    var typ = PEEKT(S);
    # v5.6.3: @unsafe { ... } block. Body parses as a plain block
    # (no scope change). Nested unsafe triggers an advisory warning —
    # by design, @unsafe is for marking memory/FFI crossings and
    # wrapping an unsafe region in another one usually means the
    # outer-scope responsibility is being redelegated, which is what
    # the warning flags.
    if (typ == 123) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
        STI(S, GTI(S) + 1);
        _unsafe_depth = _unsafe_depth + 1;
        if (_unsafe_depth > 1) {
            syscall(SYS_WRITE, 2, "warning:", 8);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": nested @unsafe block\n", 23);
        }
        while (PEEKT(S) != 14) {
            if (PEEKT(S) == 12) { break; }
            PARSE_STMT(S);
        }
        STI(S, GTI(S) + 1);
        _unsafe_depth = _unsafe_depth - 1;
        return 0;
    }
    # #assert EXPR OP EXPR, "msg" — compile-time check
    if (typ == 107) {
        STI(S, GTI(S) + 1);
        var lhs = _EVAL_CONST_ATOM(S);
        # Check for comparison operator
        var op = PEEKT(S);
        if (op >= 17 && op <= 22) {
            STI(S, GTI(S) + 1);
            var rhs = _EVAL_CONST_ATOM(S);
            var result = 0;
            if (op == 17) { if (lhs == rhs) { result = 1; } }
            if (op == 18) { if (lhs != rhs) { result = 1; } }
            if (op == 19) { if (lhs < rhs) { result = 1; } }
            if (op == 20) { if (lhs > rhs) { result = 1; } }
            if (op == 21) { if (lhs <= rhs) { result = 1; } }
            if (op == 22) { if (lhs >= rhs) { result = 1; } }
            lhs = result;
        }
        # lhs is now the assertion value (0 = fail, non-zero = pass)
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
        if (lhs == 0) {
            syscall(SYS_WRITE, 2, "error:", 6);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": #assert failed", 16);
            if (PEEKT(S) == 30) {
                # String token value is (offset << 16) | length
                var sv = PEEKV(S);
                var soff = sv >> 16;
                var slen = sv & 0xFFFF;
                syscall(SYS_WRITE, 2, ": ", 2);
                syscall(SYS_WRITE, 2, S + 0x21A000 + soff, slen);
            }
            syscall(SYS_WRITE, 2, "\n", 1);
            syscall(SYS_EXIT, 1);
        }
        # Skip to end of line (consume remaining tokens until ; or newline change)
        while (PEEKT(S) != 5 && PEEKT(S) != 12) { STI(S, GTI(S) + 1); }
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
        return 0;
    }
    # #pe_import("kernel32.dll", "WriteFile"); — declare a PE32+ IAT
    # import symbol at parse time. The dll string is accepted but
    # ignored in v5.4.6 (kernel32.dll is the only supported DLL);
    # the symbol string is handed to the pe emitter's pending-
    # imports buffer, to be folded into the real imports registry
    # by `_pe_layout` during FIXUP.
    if (typ == 110) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
        STI(S, GTI(S) + 1);
        # dll name (ignored for v5.4.6)
        if (PEEKT(S) != 30) { ERR_EXPECT(S, 30); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); }
        STI(S, GTI(S) + 1);
        # symbol name
        if (PEEKT(S) != 30) { ERR_EXPECT(S, 30); }
        var pe_sv = PEEKV(S);
        var pe_soff = pe_sv >> 16;
        _pe_pending_imp_add(S, S + 0x21A000 + pe_soff);
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
        return 0;
    }
    if (typ == 3) { PARSE_VAR(S); return 0; }
    # secret var buf[N]; — declares an array that is memset(0) at every
    # function-return path. Implemented as a synthetic defer body: the
    # var is registered normally, then a zeroise loop is emitted into a
    # defer entry so the existing epilogue walker runs it. Only supports
    # array declarations in v5.3.5 scope — the crypto consumers (sigil,
    # sakshi) use arrays exclusively.
    if (typ == 108) {
        if (GINFN(S) != 1) {
            ERR_MSG(S, "secret var only allowed inside a function", 41);
        }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 3) { ERR_EXPECT(S, 3); }
        # v6.3.15: when array locals are per-thread STACK (CYRIUS_STACK_ARRAYS), the
        # `var buf[N]` here is registered as fn-LOCAL slots, not a global var — so detect
        # the array via FINDLOCAL + a slot-delta size and zeroise through the local
        # address (`lea [rbp-disp]`) instead of the global `EVADDR`. Off (legacy global
        # array) keeps the original VCNT/`_vars_base`/`EVADDR` path byte-identical.
        var s_name = TOKVAL(S, GTI(S) + 1);   # the array's name token (after `var`)
        var s_stack = _ensure_stack_arrays(S);
        var s_flc_pre = GFLC(S);
        var vcnt_pre = GVCNT(S);
        PARSE_VAR(S);
        var sidx = 0;
        var ssz = 0;
        var s_lidx = 0;
        if (s_stack == 1) {
            s_lidx = FINDLOCAL(S, s_name);
            if (s_lidx < 0) {
                ERR_MSG(S, "secret requires array declaration: secret var buf[N];", 53);
            }
            ssz = (GFLC(S) - s_flc_pre) * 8;   # array slot count (incl. any 16-align pad) × 8
        } else {
            if (GVCNT(S) != vcnt_pre + 1) {
                ERR_MSG(S, "secret requires array declaration: secret var buf[N];", 53);
            }
            sidx = vcnt_pre;
            ssz = L64(_vars_base + sidx * 8);
        }
        # Flag local (initialized to 0 in prologue; set to 1 when this
        # declaration is reached at runtime).
        var sflag = GFLC(S);
        S64(S + 0x5D9D000 + sflag * 8, 0);
        SLDEP(S, sflag, GSDEP(S));
        SLTYPE(S, sflag, 0);
        SFLC(S, sflag + 1);
        EMOVI(S, 1);
        EFLSTORE(S, sflag);
        var sjmp = EJMP0(S);
        var ssbody = GCP(S);
        # Zeroise body: load &buf once, then unroll `store64 [ptr], 0; ptr += 8`.
        # Stack array (flag on): rbp-relative `lea` of the local; global array
        # (flag off, legacy): absolute `EVADDR`. Both leave the base in rax.
        if (s_stack == 1) {
            var s_disp = 0 - ((s_lidx + 1) * 8);
            if (_cur_fn_regalloc > 0) { s_disp = s_disp - _cur_fn_regalloc * 8; }
            if (_cur_fn_ret_stash > 0) { s_disp = s_disp - _cur_fn_ret_stash; }
            ELOAD_LOCAL_ADDR(S, s_disp);
        } else {
            EVADDR(S, sidx);
        }
        EMOVCA(S);
        EXORAA(S);
        var sqw = ssz / 8;
        var sqi = 0;
        while (sqi < sqw) {
            ESTORE64(S);
            EADDIMM_X1(S, 8);
            sqi = sqi + 1;
        }
        var ssend = EJMP0(S);
        var sdci = L64(S + 0x1AC020);
        if (sdci >= 64) {
            syscall(SYS_WRITE, 2, "error: too many defer/secret blocks (max 64)\n", 45);
            syscall(SYS_EXIT, 1);
        }
        S64(S + 0x1AC028 + sdci * 24, ssbody);
        S64(S + 0x1AC028 + sdci * 24 + 8, ssend);
        S64(S + 0x1AC028 + sdci * 24 + 16, sflag);
        S64(S + 0x1AC020, sdci + 1);
        EPATCH(S, sjmp);
        return 0;
    }
    # v5.5.36: `stack var buf[N];` — stack-local array. Unlike the
    # default `var x[N]` which hoists to .bss as a global, this
    # reserves N bytes (aligned up to 8) on the call stack. Each fn
    # invocation gets its own copy (re-entrant-safe). Addressed via
    # rbp-relative displacement through the existing `&local`
    # codepath, so no emit-side changes are needed for access.
    #
    # Implementation: register ceil(N/8) fn-local slots. The first
    # nslots-1 are anonymous sentinels (name offset = -1; FINDLOCAL
    # skips them via its `sn >= 0` gate). The last slot carries the
    # user's name, so FINDLOCAL returns the deepest (lowest-address)
    # slot — `&buf` therefore points at the BOTTOM of the array,
    # with byte[0] at rbp-(nslots*8) and byte[N-1] immediately below
    # the regular locals block.
    #
    # __chkstk for frames ≥ 4 KB under _TARGET_PE is v5.5.36 Phase 1b
    # (pinned — same patch). For now, small-frame `stack var` lands
    # cleanly on Windows because Win11 happens to extend stack on
    # guard-page access for frames ≤ one-page-past-the-guard; deeper
    # frames need the chkstk walker to touch every page in order.
    if (typ == 111) {
        if (GINFN(S) != 1) {
            ERR_MSG(S, "stack var only allowed inside a function", 40);
        }
        STI(S, GTI(S) + 1);                         # consume 'stack'
        if (PEEKT(S) != 3) { ERR_EXPECT(S, 3); }    # need 'var'
        STI(S, GTI(S) + 1);                         # consume 'var'
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }    # need IDENT
        var stk_noff = PEEKV(S);
        STI(S, GTI(S) + 1);                         # consume IDENT
        if (PEEKT(S) != 28) { ERR_EXPECT(S, 28); }  # need '['
        STI(S, GTI(S) + 1);                         # consume '['
        if (PEEKT(S) != 1) { ERR_EXPECT(S, 1); }    # need NUM
        var stk_size = PEEKV(S);
        STI(S, GTI(S) + 1);                         # consume NUM
        if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }  # need ']'
        STI(S, GTI(S) + 1);                         # consume ']'
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }    # need ';'
        STI(S, GTI(S) + 1);                         # consume ';'
        if (stk_size <= 0) {
            ERR_MSG(S, "stack var size must be > 0", 26);
        }
        var stk_aligned = (stk_size + 7) & (0 - 8);
        var stk_nslots = stk_aligned / 8;
        # Reject duplicate name (same rule as regular locals)
        var stk_existing = FINDLOCAL(S, stk_noff);
        if (stk_existing >= 0) {
            if (GLDEP(S, stk_existing) == GSDEP(S)) { ERRDUPVAR(S); }
        }
        # Anonymous filler slots — FINDLOCAL skips `sn < 0` entries.
        var stk_j = 0;
        while (stk_j < stk_nslots - 1) {
            var stk_li = GFLC(S);
            S64(S + 0x5D9D000 + stk_li * 8, 0 - 1);
            SLDEP(S, stk_li, GSDEP(S));
            SLTYPE(S, stk_li, 0);
            SFLC(S, stk_li + 1);
            stk_j = stk_j + 1;
        }
        # Named slot at the deepest frame offset — this is where
        # `&buf` and `buf` resolve via FINDLOCAL.
        var stk_named = GFLC(S);
        S64(S + 0x5D9D000 + stk_named * 8, stk_noff);
        SLDEP(S, stk_named, GSDEP(S));
        SLTYPE(S, stk_named, 0);
        SFLC(S, stk_named + 1);
        return 0;
    }
    # Block statement: { ... }
    if (typ == 13) {
        STI(S, GTI(S) + 1);
        SCOPE_PUSH(S);
        PARSE_PROG(S);
        SCOPE_POP(S);
        if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
        STI(S, GTI(S) + 1);
        return 0;
    }
    if (typ == 15) { PARSE_IF(S); return 0; }
    if (typ == 16) { PARSE_WHILE(S); return 0; }
    if (typ == 55) { PARSE_FOR(S); return 0; }
    if (typ == 57) { PARSE_SWITCH(S); return 0; }
    if (typ == 75) { PARSE_MATCH(S); return 0; }
    if (typ == 33) { PARSE_RETURN(S); return 0; }
    # break; — forward jump to after loop (linked list through codebuf)
    if (typ == 51) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);
        var prev_brk = L64(S + 0x18F840);
        var brk_off = EJMP0(S);
        # Store prev break offset in this jmp's rel32 field (chain link)
        var brk_addr = _codebuf_base + brk_off;
        S64(brk_addr, (L64(brk_addr) >> 32 << 32) | (prev_brk & 0xFFFFFFFF));
        S64(S + 0x18F840, brk_off);
        return 0;
    }
    # defer { body } — execute body at function return (LIFO)
    # Each defer gets a runtime flag (hidden local) set to 1 when reached.
    # At epilogue, flag is checked before running the block — unreached defers are skipped.
    if (typ == 106) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
        # Allocate hidden local for defer flag (initialized to 0 in prologue)
        var dflag = GFLC(S);
        S64(S + 0x5D9D000 + dflag * 8, 0);
        SLDEP(S, dflag, GSDEP(S));
        SLTYPE(S, dflag, 0);
        SFLC(S, dflag + 1);
        # Emit: flag = 1 (set when defer statement is reached)
        EMOVI(S, 1);
        EFLSTORE(S, dflag);
        # Emit jmp-over (skip deferred block during normal execution)
        var djmp = EJMP0(S);
        # Record block start (current CP after jmp-over)
        var dstart = GCP(S);
        # Parse deferred block body
        STI(S, GTI(S) + 1);
        PARSE_PROG(S);
        if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
        STI(S, GTI(S) + 1);
        # Emit jmp placeholder (patched to next defer block or epilogue)
        var dend = EJMP0(S);
        # Store {block_start, end_jmp, flag_local} triple (24 bytes per entry)
        var dci = L64(S + 0x1AC020);
        if (dci >= 64) {
            syscall(SYS_WRITE, 2, "error: too many defer blocks (max 64)\n", 38);
            syscall(SYS_EXIT, 1);
        }
        S64(S + 0x1AC028 + dci * 24, dstart);
        S64(S + 0x1AC028 + dci * 24 + 8, dend);
        S64(S + 0x1AC028 + dci * 24 + 16, dflag);
        S64(S + 0x1AC020, dci + 1);
        # Patch jmp-over to land here (after the deferred block)
        EPATCH(S, djmp);
        return 0;
    }
    # continue; — jump to loop top (or step for C-style for)
    if (typ == 52) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);
        var cfw = L64(S + 0x18F898);
        if (cfw > 0) {
            # For-loop: forward patch to step (array of patches)
            var ci = cfw - 1;
            if (ci >= 8) {
                ERR_MSG(S, "too many continue statements in loop (max 8)", 44);
            }
            S64(S + 0x18F8A0 + ci * 8, EJMP0(S));
            S64(S + 0x18F898, cfw + 1);
        } else {
            # While/for-in: direct jump to loop top
            EJMP(S, L64(S + 0x18F838));
        }
        return 0;
    }
    # asm { ... } — raw bytes or mnemonic instructions
    if (typ == 48) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
        STI(S, GTI(S) + 1);
        # v5.6.12: inline asm block is opaque to IR — each byte is
        # arbitrary user-provided machine code.
        _IR_REC0(S, IR_RAW_EMIT);
        var ago = 1;
        while (ago == 1) {
            if (PEEKT(S) == 14) { ago = 0; }
            else {
                if (PEEKT(S) == 1) {
                    # Raw byte
                    EB(S, PEEKV(S) & 0xFF);
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                }
                elif (PEEKT(S) == 2) {
                    # Mnemonic — dispatch to ASM_MNEMONIC
                    ASM_MNEMONIC(S);
                }
                else { ERR(S); }
            }
        }
        STI(S, GTI(S) + 1);
        # aarch64 requires every instruction 4-byte aligned. Existing
        # lib/*.cyr asm blocks are x86-specific byte sequences that the
        # aarch64 backend pastes verbatim; if the length isn't a multiple
        # of 4, every downstream instruction decodes at the wrong offset
        # and the program SIGILLs long before it ever reaches the x86
        # bytes. Pad with zeros so downstream emit stays aligned. The x86
        # backend is variable-length and doesn't care about alignment, so
        # this costs nothing there — on aarch64 `_AARCH64_BACKEND == 1`.
        # v6.4.58: cx bytecode is ALSO strictly 4-byte instructions (cxvm computes
        # call/jump targets as off*4), so a raw asm block whose length isn't a
        # multiple of 4 misaligns every following fn — same class as the v6.4.54
        # DCE-stub bug. Pad on cx too. x86 is variable-length (both operands 0 →
        # no padding, byte-identical). See issue 2026-07-11-cx-naked-asm-4byte-realign.
        if (_AARCH64_BACKEND == 1 || _TARGET_CX == 1) {
            while ((GCP(S) & 3) != 0) { EB(S, 0); }
        }
        return 0;
    }
    # *expr = val; (pointer store)
    if (typ == 8) {
        STI(S, GTI(S) + 1);
        PARSE_FACTOR(S);
        # rax now holds the address
        EPUSHR(S);
        if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
        STI(S, GTI(S) + 1);
        PCMPE(S);
        # rax = value, stack = address
        EPOPC(S);
        ESTORE64(S);
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);
        return 0;
    }
    # Expression statements: syscall(...); store8(...); load8(...);
    if (typ == 24) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 26) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 25) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 45) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 46) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    if (typ == 47) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; }
    # f64/SIMD builtins as statements
    if (typ >= 62) { if (typ <= 105) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v5.10.17: f64v_dot/scale/axpy as statements (out-of-range from
    # the existing 62-105 SIMD band; share the same PCMPE-then-`;` shape).
    if (typ >= 128) { if (typ <= 130) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.3+ (SIMD Phase 1): f32v_add/sub/mul as statements (138-140).
    if (typ >= 138) { if (typ <= 140) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.5 (SIMD Phase 2): f32v_fmadd/f32v_dot as statements (141-142).
    if (typ >= 141) { if (typ <= 142) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.6 (Phase 3a): iv_add/iv_sub/iv_mul as statements (143-145).
    if (typ >= 143) { if (typ <= 146) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.8 (SIMD Phase 4 R1): f32v8_add/sub/mul as statements (147-149).
    if (typ >= 147) { if (typ <= 149) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.4.9 (SIMD Phase 4 R2): f32v8_fma/f32v8_dot as statements (150-151).
    if (typ >= 150) { if (typ <= 151) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    # v6.5.24 (ymm widening): f64v256_add/sub/mul/div as statements (154-157). The lib
    # wrappers call these in STATEMENT position (`f64v256_add(&r, a_ptr, b_ptr, 4);`), so
    # without this band the builtin lexes and emits fine yet is a syntax error at every
    # real call site. 152/153 (`>>>`, `private`) are deliberately not in the range.
    if (typ >= 154) { if (typ <= 162) { PCMPE(S); if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0; } }
    if (typ == 2) {
        # Could be assignment or fn call as statement
        var noff = PEEKV(S);
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 10) {
            # v5.6.3: #must_use — warn when a fn marked #must_use is
            # called as a bare expression statement (result dropped).
            # The check happens BEFORE PARSE_FNCALL so the diagnostic
            # line number matches the call site, not the trailing ';'.
            var _mu_fi = FINDFN(S, noff);
            if (_mu_fi >= 0) {
                var _mu_flags = GFLG(S, _mu_fi);
                if (_mu_flags & 1 != 0) {
                    syscall(SYS_WRITE, 2, "warning:", 8);
                    _err_head(S);
                    syscall(SYS_WRITE, 2, ": #must_use result of '", 23);
                    PRSTR(S + 0x60000 + noff);
                    syscall(SYS_WRITE, 2, "' is discarded\n", 15);
                }
            }
            # fn call statement
            PARSE_FNCALL(S, noff);
            # v5.8.31 — postfix `?` on a bare fncall-statement
            # (`expr?;` form). v5.8.29 added `?` in PARSE_TERM but
            # this path bypasses PARSE_TERM entirely (PARSE_STMT
            # dispatches IDENT+LPAREN straight to PARSE_FNCALL),
            # so the `?` was unhandled and the next token check
            # for `;` reported "expected ';', got unknown" (token
            # 124 has no TOKNAME entry). Same desugar shape as the
            # PARSE_TERM hook: tag-check + early-return on Err +
            # payload-load on Ok. The unwrapped value lands in rax
            # and is dropped by the bare-statement convention.
            if (PEEKT(S) == 124) {
                STI(S, GTI(S) + 1);
                if (GINFN(S) == 0) {
                    ERR_MSG(S, "?: '?' propagation operator only valid inside a fn body", 55);
                }
                var qsidx = GVCNT(S);
                S64(_varn_base + qsidx * 8, 0);
                S64(_vars_base + qsidx * 8, 8);
                SVCNT(S, qsidx + 1);
                EVSTORE(S, qsidx);
                EVLOAD(S, qsidx);
                ELOAD64(S);
                EPUSHR(S);
                EMOVI(S, 0);
                EMOVCA(S);
                EPOPR(S);
                ECMPR(S);
                var qsjcc = EJCC(S, 0x84);
                EVLOAD(S, qsidx);
                var qsrp = EJMP0(S);
                vec_push(rp_vec, qsrp);
                EPATCH(S, qsjcc);
                EVLOAD(S, qsidx);
                EPUSHR(S);
                EMOVI(S, 8);
                EMOVCA(S);
                EPOPR(S);
                EADDR(S);
                ELOAD64(S);
            }
            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
            STI(S, GTI(S) + 1);
            return 0;
        }
        # struct field access: ident.field = expr; or ident.method(args);
        if (PEEKT(S) == 41) {
            # Peek ahead: is this a method call or field store?
            # Save position, consume DOT, check if ident followed by (
            var save_ti = GTI(S);
            STI(S, GTI(S) + 1);  # consume DOT
            if (PEEKT(S) == 2) {
                var peek_noff = PEEKV(S);
                STI(S, GTI(S) + 1);  # consume method name
                if (PEEKT(S) == 10) {
                    # Method call: rewind and use PARSE_FIELD_LOAD (which handles methods)
                    STI(S, save_ti);
                    PARSE_FIELD_LOAD(S, noff);
                    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                    STI(S, GTI(S) + 1);
                    return 0;
                }
            }
            # Not a method call — rewind and do field store
            STI(S, save_ti);
            PARSE_FIELD_STORE(S, noff);
            return 0;
        }
        # assignment or compound assignment: already consumed IDENT
        # Check for +=, -=, *=, /=, %=, &=, |=, ^=, <<=, >>=
        var compound_op = 0;
        var ct = PEEKT(S);
        if (ct == 6 || ct == 7 || ct == 8 || ct == 9 || ct == 34 || ct == 27 || ct == 35 || ct == 36 || ct == 38 || ct == 39) {
            var ti_next = GTI(S) + 1;
            if (ti_next < GTCNT(S)) {
                if (TOKTYP(S, ti_next) == 4) {
                    compound_op = ct;
                    STI(S, GTI(S) + 2);
                }
            }
        }
        if (compound_op == 0) {
            if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
            STI(S, GTI(S) + 1);
        }
        if (compound_op != 0) {
            # Compound: x += expr → load x, push, eval expr, then x OP expr
            var cidx = FINDLOCAL(S, noff);
            var cltype = 0;
            if (cidx >= 0) { EFLLOAD(S, cidx); cltype = GLTYPE(S, cidx); }
            else {
                var gidx = FINDVAR(S, noff);
                if (gidx >= 0) { EVLOAD(S, gidx); }
            }
            EPUSHR(S);
            PCMPE(S);
            # v6.4.57 (scalar-float, Gap B): when the LHS local is f64/f32-typed,
            # `x += y` must FLOAT-add, not integer-add on the raw bit pattern. Stack =
            # x (LHS), rax = expr (RHS) — exactly EMIT_F{64,32}_BINOP's convention, so
            # route through the same emitters the `x = x + y` path uses. fop 0/1/2/3 maps
            # to compound_op 6/7/8/9; %,&,|,^,<<,>> on a float fall through to the integer
            # arms. cycc has no `: f64`/`: f32` locals → this arm never emits on the
            # self-host input (byte-identical). See issue 2026-07-11-scalar-float-param-*.
            var f_fop = 0 - 1;
            if (cltype == F64_TYID || cltype == F32_TYID) {
                if (compound_op == 6) { f_fop = 0; }
                if (compound_op == 7) { f_fop = 1; }
                if (compound_op == 8) { f_fop = 2; }
                if (compound_op == 9) { f_fop = 3; }
            }
            if (f_fop >= 0) {
                if (cltype == F64_TYID) { EMIT_F64_BINOP(S, f_fop); }
                else { EMIT_F32_BINOP(S, f_fop); }
            }
            else {
            # Stack = x, rax = expr. For x OP expr: mov rcx,rax; pop rax; OP
            EMOVCA(S);
            EPOPR(S);
            if (compound_op == 6) { EADDR(S); }
            elif (compound_op == 7) { ESUBR(S); }
            elif (compound_op == 8) { EIMUL(S); }
            elif (compound_op == 9) { ECQO(S); EIDIV(S); }
            elif (compound_op == 34) { ECQO(S); EIDIV(S); EMOVDR(S); }
            elif (compound_op == 27) { EANDR(S); }
            elif (compound_op == 35) { EORR(S); }
            elif (compound_op == 36) { EXORR(S); }
            elif (compound_op == 38) { ESHLCL(S); }
            elif (compound_op == 39) { ESHRCL(S); }
            }   # close the v6.4.57 non-float (integer-op) else
        } else {
            # v6.5.28 — capture the callee's DECLARED return sid BEFORE the RHS is consumed.
            # The declaration path already does this (parse_decl.cyr:2352-2362: peek
            # `IDENT (`, FINDFN, GFRS) — which is why `var t = str_new(..)` correctly types
            # `t` as a Str. The ASSIGNMENT path never did, so `t = str_new(..)` on that same
            # binding warned "assigning non-pointer to typed pointer" about a call that
            # returns exactly that pointer. Filed from abaco after v6.5.27's sign fix made
            # the check reach real typed-pointer locals for the FIRST time and exposed the
            # gap sitting behind it (2026-08-14-typed-ptr-warn-ignores-declared-return-type).
            # ⚠ Must be read BEFORE PCMPE — afterwards the token cursor has moved past the
            # callee name and FINDFN would resolve nothing.
            _asg_ret_sid = 0;
            if (PEEKT(S) == 2) {
                if (TOKTYP(S, GTI(S) + 1) == 10) {
                    var _ar_fi = FINDFN(S, PEEKV(S));
                    if (_ar_fi >= 0) { _asg_ret_sid = GFRS(S, _ar_fi); }
                }
            }
            PCMPE(S);
        }
        # Type check at assignment
        var aps = GPSC(S);
        var idx = 0 - 1;
        if (GINFN(S) == 1) {
            idx = FINDLOCAL(S, noff);
            if (idx >= 0) {
                var lt = GLTYPE(S, idx);
                # v6.5.24 — THE SIGN TEST WAS INVERTED, so this warning fired on exactly
                # the locals it should ignore and never once on the case it exists for.
                # In the local SLTYPE scheme a POSITIVE lt is a narrow width in bytes
                # (1/2/4) or a float tag (F64_TYID 0x40000001 / F32_TYID 0x40000002);
                # the pointer-like case is stored NEGATIVE, as `0 - sid`
                # (parse_decl.cyr:2490). `lt > 0` therefore meant "narrow or float".
                # Measured before the fix: `var w: i32 = 5; w = 6;` warned, `var a: f64
                # = ...; a = ...;` warned, and a struct-typed local — the actual typed
                # pointer — did NOT, i.e. the check was unreachable for its own purpose.
                # `lt < 0` is also what the GLOBAL arm of this very warning already uses
                # (`vt < 0`, ~40 lines below); the two arms had silently disagreed.
                # ⭐ Fixing the float half UNGATED the ranga/ganita f32 tier: `acc =
                # f32_op(acc, ..)` is the canonical loop body there, so every f32
                # accumulator in every consumer would have emitted a bogus warning.
                # Filed as 2026-08-13-f64-typed-binding-reassign-warns-as-pointer plus
                # the wider inverted-sign finding (roadmap Slot 1 item (d)).
                # v6.5.28 — a call whose DECLARED return sid is a struct (> 0) IS a typed
                # pointer, even though the call itself leaves the expression pointer-scale at
                # 0. Without this the warning fired on `t = str_new(..)` while the identical
                # initializer `var t = str_new(..)` was accepted — the two paths disagreeing
                # about the same expression.
                if (lt < 0 && _asg_ret_sid <= 0) {
                    if (aps == 0) { WARN(S, "assigning non-pointer to typed pointer", 38); }
                }
            }
        }
        if (idx >= 0) {
            var lt = GLTYPE(S, idx);
            var ew = GEXW(S);
            if (lt > 0) {
                if (lt <= 8) {
                    if (ew > lt) { WARN(S, "narrowing assignment (value may truncate)", 45); }
                    EFLSTORE_W(S, idx, lt);
                } else { EFLSTORE(S, idx); }
            }
            else { EFLSTORE(S, idx); }
        }
        else {
            idx = FINDVAR(S, noff);
            if (idx < 0) {
                # v6.5.19: --syntax-only drops the STORE (there is nowhere to store to)
                # but must still consume the statement's `;`, exactly as the tail of
                # this fn does below. Returning without it left the `;` dangling and
                # the statement layer reported `unexpected ';'` — a FALSE ACCUSATION
                # against valid code, measured on `lib/thread_win.cyr`'s
                # `_threads_active = 1;` (a global declared in a sibling module) and
                # therefore on all 74 repos that vendor it. See _syntax_only.
                if (_syntax_only == 1) {
                    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                    STI(S, GTI(S) + 1);
                    return 0;
                }
                syscall(SYS_WRITE, 2, "error:", 6);
                _err_head(S);
                syscall(SYS_WRITE, 2, ": undefined variable '", 22);
                PRSTR(S + 0x60000 + noff);
                syscall(SYS_WRITE, 2, "'\n", 2);
                _had_error = 1; if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1); return 0;
            }
            var vt = GVTYPE(S, idx);
            if (vt < 0) {
                if (aps == 0) { WARN(S, "assigning non-pointer to typed pointer", 38); }
            }
            var avsz = L64(_vars_base + idx * 8);
            var ew = GEXW(S);
            if (avsz < 8) {
                if (ew > avsz) { WARN(S, "narrowing assignment (value may truncate)", 45); }
                EVSTORE_W(S, idx, avsz);
            }
            else { EVSTORE(S, idx); }
            SLVAR(S, idx);
        }
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);
        return 0;
    }
    ERR(S);
    return 0;
}

fn PARSE_PROG(S): i64 {
    var go = 1;
    while (go == 1) {
        var typ = PEEKT(S);
        if (typ == 12) { go = 0; }
        else { if (typ == 14) { go = 0; }
            else { if (typ == 109) {
                    # v4.8.4-beta1: #regalloc directive inside top-level init
                    # body (e.g. `alloc_init(); #regalloc fn foo() {...}` in a
                    # .tcyr harness). Arm the pending flag exactly like the
                    # pass-2 declaration dispatcher — the next PARSE_FN_DEF
                    # picks it up.
                    _regalloc_pending = 1;
                    STI(S, GTI(S) + 1);
                }
                else { if (typ == 122) {
                        # v5.6.3: #must_use — arm the pending flag; the next
                        # PARSE_FN_DEF consumes it into fn_flags[fi] bit 0.
                        _must_use_pending = 1;
                        STI(S, GTI(S) + 1);
                    }
                    else { if (typ == 124) {
                            # v5.6.4: #deprecated("msg") — arm pending flag + capture
                            # the message string for PARSE_FN_DEF. Syntax mirrors
                            # #pe_import: paren, single string literal, close paren.
                            # Unlike #must_use the message is REQUIRED (the diagnostic
                            # is expected to carry a reason / replacement pointer).
                            STI(S, GTI(S) + 1);
                            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
                            STI(S, GTI(S) + 1);
                            if (PEEKT(S) != 30) { ERR_EXPECT(S, 30); }
                            _deprecated_msg_pending = PEEKV(S);
                            STI(S, GTI(S) + 1);
                            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
                            STI(S, GTI(S) + 1);
                            _deprecated_pending = 1;
                        }
                        else { if (typ == 125) {
                                # v5.8.20: #pure — arm pending flag for next fn.
                                _pure_pending = 1;
                                STI(S, GTI(S) + 1);
                            }
                            else { if (typ == 126) {
                                    # v5.8.20: #io — arm pending flag for next fn.
                                    _io_pending = 1;
                                    STI(S, GTI(S) + 1);
                                }
                                else { if (typ == 127) {
                                        # v5.8.20: #alloc — arm pending flag for next fn.
                                        _alloc_pending = 1;
                                        STI(S, GTI(S) + 1);
                                    }
                                    else { if (typ == 133) {
                                        # v6.2.27: #naked (token 133; 128 is f64v_dot) — arm pending; PARSE_FN_DEF
                                        # skips prologue/epilogue/frame for the next fn.
                                        _naked_pending = 1;
                                        STI(S, GTI(S) + 1);
                                    }
                                    else { if (typ == 32) {
                                # fn definition inside top-level code (relaxed ordering)
                                # Emit jmp over fn body, compile fn, patch jmp
                                var fn_skip = EJMP0(S);
                                PARSE_FN_DEF(S);
                                EPATCH(S, fn_skip);
                            }
                            else { PARSE_STMT(S); } } } } } } } } } }
    }
    # v6.5.24 — bare-metal forbidden-module check (bare-metal deliverable #4), reported
    # HERE rather than at the include site. The preprocessor records which host-only
    # module was pulled (PP_IS_HOST_ONLY / PP_NOTE_HOST_ONLY in lex_pp.cyr) but CANNOT
    # decide: `PREPROCESS(S)` runs at main.cyr:1189 and the CYRIUS_KERNEL env is not read
    # until :1217, so kernel_mode (S+0x18FCA0) is still 0 while includes expand — the
    # first cut checked it there and the gate never fired.
    # ⭐ End-of-PARSE_PROG catches BOTH declaration paths: the
    # `--target=<arch>-bare-metal-elf` triple (env, set before parse) AND the source
    # `kernel;` directive, which is only known once every top-level statement above has
    # been parsed. One shared site, so no per-fork duplication.
    # ⛔ Only the USER's own includes count. cbt prepends one `include` per `[deps].stdlib`
    # module to EVERY build regardless of target, so when a `#@srcline` marker is present
    # (i.e. cbt materialised this compiland) the pre-marker prepends are NOT the kernel
    # author's choice and must not fail the build — the first cut ignored that and turned
    # this repo's own `programs/boot_serial.cyr` red via a manifest-supplied `lib/fs.cyr`.
    # With no marker (raw `cat | cycc`) every include is the user's, so the plain latch
    # applies. See PP_NOTE_HOST_ONLY.
    var _ho = _pp_hostonly_hit;
    if (_pp_srcline_seen == 1) { _ho = _pp_hostonly_user; }
    if (_ho == 1) {
        if (L64(S + 0x18FCA0) == 1) {
            syscall(SYS_WRITE, 2, "error: bare-metal build includes host-only module: ", 51);
            var _hol = 0;
            while (load8(&_pp_hostonly_name + _hol) != 0) { _hol = _hol + 1; }
            syscall(SYS_WRITE, 2, &_pp_hostonly_name, _hol);
            syscall(SYS_WRITE, 2, " (marked #host_only; not available under CYRIUS_KERNEL)\n", 56);
            syscall(SYS_EXIT, 1);
        }
    }
    return 0;
}

