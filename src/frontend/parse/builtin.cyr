# PARSER — `#assert` (`_assert_*`, `_asrt_*`), `Base.NAME` enum qualifiers (`_enum_qual_*`) and the builtin and
# intrinsic names — whole-word tests, a type-argument list on one, one as a statement (`_stmt_intr*`), the reserved
# identifier intrinsics (_RSV_INTRINSIC_DECL).
# ================================================================
# Split from parse/parse.cyr at 6.7.18, unchanged; parse.cyr includes its pieces in source order. CHANGELOG [6.7.18]

# The highest token index whose failing #assert was reported. Now that a failure no longer
# exits, the replays of the same tokens (an #inline body re-parsed at every call site) must
# not report it again: in pass 2 the cursor only moves forward except in such a replay.
# CHANGELOG [6.6.11]
var _assert_rep_ti = 0 - 1;

# The tail of an #assert, from wherever its operands and `,` ended: the rest of THAT line
# (the message string), then one `;`. Shared by PARSE_STMT's arm and the pass-1 skip
# (_tl_assert), so both passes stop on the same token. CHANGELOG [6.6.9]
# ⛔ v6.5.39 — the newline stop is load-bearing: testing only `;` (5) and EOF (12) let a
# `#assert` with no trailing `;` skip across the following `fn` header and eat its first
# statement — silent wrong code, no diagnostic.
# ⛔ 6.6.11 — the line is the LAST CONSUMED token's (an operand or the `,`), not the cursor's:
# with no `,`, message or `;`, the cursor already sits on the NEXT line, and taking its line
# ate that whole line — `#assert 1 == 1<LF> return 42;` dropped the return, silently. A
# string AT the cursor is this assert's message wherever it sits (`#assert X,<LF> "msg";`),
# which is also what the failure printer reads. CHANGELOG [6.6.11]
# ⛔ 6.7.15 — `#assert`'s const context is evaluated in place with the latch clear (`_assert_open`: the `#assert`
# stepped, `_ce_asrt` armed), and a refused assertion that ends at its own `;` puts the caller's latch back
# (`_assert_end`). Two refused `#assert`s printed only the first — the declaration zone never resyncs, and in a fn
# the resync skipped the next statement — and one after another declaration's latched error printed "#assert
# failed" in place of its refusal. CHANGELOG [6.7.15]
# ⛔ 6.7.16 — AN #assert IS LINE-TERMINATED, SO ITS REFUSAL ENDS IN SYNC AT ITS LINE TOO, not only at its `;`
# (issues/archived/2026-10-19-refused-assert-after-first-statement-swallows-next-statement.md): `#assert zz9 == 1` with no
# `;` kept the latch, and the statement on the next line was skipped by the resync, its own error unreported. The
# refused expression is stepped to its grammar's end (`_ce_extent`, what pass 1 skips — the evaluator stops at the
# refusal, maybe a line short), when that is a well-bracketed stretch with no `;` (`_asrt_span_ok`), then the tail
# ends the directive. And IN A BLOCK the tail stops at the `}` on its line that closes the block (`_asrt_in_blk`):
# it ate it, so `{ #assert 1 == 1 }` added "expected '}', got end of file" to its refusal, and `{ #assert 1 == 1,
# "m" }` was that invented error alone — now "expected `;` or a line break before `}`". At module scope a `}` there
# closes nothing and the tail still takes it. CHANGELOG [6.7.16]
var _asrt_ti = 0;     # the #assert's first expression token (`_assert_open`)
var _asrt_impl = 0;   # 1 = an impl body's directive (`_impl_dir`): its `}` closes the body
fn _assert_open(S): i64 {
    var pw = _panic;
    STI(S, GTI(S) + 1);
    _asrt_ti = GTI(S);
    _panic = 0;
    _ce_asrt = 1;
    return pw;
}
fn _assert_end(S, pw): i64 {
    var e = 0 - 1;
    if (_panic == 1) { e = _asrt_ext(S); }
    var p1 = _panic;
    var bs = _assert_tail(S, 1);
    if (bs == 1) { _asrt_brace_err(S); }
    if (p1 == 0) { if (_panic == 1) { e = GTI(S); } }   # 6.7.17: the tail's own refusal, its line stepped: in sync
    if (_panic == 1) { if (_asrt_synced(S, e, bs) == 0) { return 0; } }
    _panic = pw;
    return 0;
}
# 1 = the tail stopped at the enclosing block's `}` (left for the block), else 0.
# ⛔ 6.7.17 — ONLY `;` OR THE LINE'S END MAY FOLLOW THE MESSAGE (the user's D28, 2026-10-22). The tail skipped whatever
# followed the message to the next `;` or the line's end, unread: `#assert 1 == 1, "m" junk` compiled, and in an impl
# body `#assert 1 == 1, "m" fn m(self): i64 { return 5; }` ate the method up to its `;`, pass 2 ended the impl at the
# method's `}`, and the program's statements after it were never compiled (exit 0, not 9). Now a token there — or
# after a `,` with no message — is one error (`rep` 1: PARSE_STMT's arm; pass 1 steps silently), and the rest of the
# line is stepped whole (`_ln_rest`: a `{` through its `}`), so the next line reports its own. Both passes stop on the
# same token. CHANGELOG [6.7.17]
fn _assert_tail(S, rep): i64 {
    var ln = GTLINE(S, GTI(S) - 1);
    var m = 0;
    if (PEEKT(S) == 30) { ln = _str_end_line(S, GTI(S)); STI(S, GTI(S) + 1); m = 1; }
    var blk = _asrt_in_blk(S);
    var t = PEEKT(S);
    if (t == 5) { STI(S, GTI(S) + 1); return 0; }
    if (t == 12) { return 0; }
    if (GTLINE(S, GTI(S)) != ln) { return 0; }
    if (t == 14) { if (blk == 1) { return 1; } }
    if (rep == 1) { _asrt_tail_err(S, m); }
    var a = GTI(S);
    var r = _ln_rest(S, ln, blk);
    _asrt_tail_names(S, a, GTI(S), rep);   # 6.7.17: what it declares, as reported (parse/fn/def.cyr)
    return r;
}
# The line the string token `ti` ends on: its first line (the token's) plus the line breaks inside it, a raw LF or
# `\<LF>`. A message spanning lines ends on its last: `"multi<LF>line" junk` has `junk` on the message's line.
fn _str_end_line(S, ti): i64 {
    var p = GTOFF(S, ti) + 1;
    var bl = GBL(S);
    var ln = GTLINE(S, ti);
    while (p < bl) {
        var c = load8(S + 0x459D000 + p);
        if (c == 34) { return ln; }
        if (c == 10) { ln = ln + 1; }
        if (c == 92) {
            p = p + 1;
            if (load8(S + 0x459D000 + p) == 10) { ln = ln + 1; }
        }
        p = p + 1;
    }
    return ln;
}
# The tail's refusal at the cursor: after the message (`m` 1), or after a `,` that has none.
fn _asrt_tail_err(S, m): i64 {
    if (m == 1) { ERR_MSG(S, "#assert: expected `;` or the end of the line after the message", 62); }
    else { ERR_MSG(S, "#assert: expected the message string, `;` or the end of the line after `,`", 74); }
    return 0;
}
# A refused directive line's rest, from the cursor, stepped whole: each `(` / `[` / `{` through its match wherever that
# sits, the walk then going on along the line the match closes on. Stops at EOF, at a token on a later line and, `blk`
# 1, at a `}` at depth 0, which closes the enclosing body: 1 = stopped there, else 0. An #assert's refused tail
# (`_assert_tail`) and a refused `use` (`_use_step`): both passes step the same tokens through it. CHANGELOG [6.7.17]
fn _ln_rest(S, ln, blk): i64 {
    var d = 0;
    while (PEEKT(S) != 12) {
        var t = PEEKT(S);
        if (d == 0) {
            if (GTLINE(S, GTI(S)) != ln) { return 0; }
            if (t == 14) { if (blk == 1) { return 1; } }
        }
        if (t == 10 || t == 28 || t == 13) { d = d + 1; }
        if (t == 11 || t == 29 || t == 14) { if (d > 0) {
                d = d - 1;
                if (d == 0) { ln = GTLINE(S, GTI(S)); }
            } }
        STI(S, GTI(S) + 1);
    }
    return 0;
}
# 1 = the #assert sits in a braced body: a fn's, a nested block's (`_pp_depth` > 1) or an impl's.
fn _asrt_in_blk(S): i64 {
    if (GINFN(S) == 1) { return 1; }
    if (_pp_depth > 1) { return 1; }
    return _asrt_impl;
}
# An impl body's directive (pass 1's `_prescan_impl_body`, pass 2's `_impl_attrs`): `_tl_directive` with the body's
# `}` closing an #assert's line. CHANGELOG [6.7.16]
fn _impl_dir(S, arm): i64 {
    _asrt_impl = 1;
    var r = _tl_directive(S, arm);
    _asrt_impl = 0;
    return r;
}
fn _asrt_brace_err(S): i64 {
    if (_panic == 1) { return 0; }
    ERR_MSG(S, "#assert: expected `;` or a line break before `}`", 48);
    return 0;
}
# A refused #assert's expression (from `_asrt_ti`): its grammar extent, the cursor stepped there (and past its
# `,`) when the evaluator stopped short; -1 when the extent is no well-bracketed stretch (an unclosed `(` runs on).
fn _asrt_ext(S): i64 {
    var e = _ce_extent(S, _asrt_ti);
    if (_asrt_span_ok(S, _asrt_ti, e) == 0) { return 0 - 1; }
    if (e > GTI(S)) {
        STI(S, e);
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    }
    return e;
}
# 1 = tokens [a, b) hold no `;` / EOF and balance `(`..`)` and `{`..`}` each, never closing more than opened.
fn _asrt_span_ok(S, a, b): i64 {
    var p = 0;
    var c = 0;
    while (a < b) {
        var t = TOKTYP(S, a);
        if (t == 5 || t == 12) { return 0; }
        if (t == 10) { p = p + 1; }
        if (t == 11) { p = p - 1; if (p < 0) { return 0; } }
        if (t == 13) { c = c + 1; }
        if (t == 14) { c = c - 1; if (c < 0) { return 0; } }
        a = a + 1;
    }
    if (p != 0) { return 0; }
    if (c != 0) { return 0; }
    return 1;
}
# The refused directive ended in sync: at its `;`, at its block's `}` (`bs`), or past its whole expression (`e`).
fn _asrt_synced(S, e, bs): i64 {
    if (TOKTYP(S, GTI(S) - 1) == 5) { return 1; }
    if (bs == 1) { return 1; }
    if (e < 0) { return 0; }
    return 1;
}

# 6.6.10 — the operands of an #assert (`ATOM [OP ATOM]`) may be followed only by `,` (the
# message), the message string itself (the comma-less `#assert 1 == 1 "ok"` form the failure
# printer has always honoured), `;`, EOF, or a token on a LATER line. _assert_tail skips
# the rest of the line unchecked, so `#assert E.EB * 2 == 9;` evaluated `E.EB` alone and a
# FALSE assertion compiled green, as did `#assert 4 == 4 junk;`. Reports once (ERR_MSG
# latches) and returns 1; the caller then drops the "#assert failed" cascade. CHANGELOG [6.6.10]
fn _assert_operands_end(S): i64 {
    var t = PEEKT(S);
    if (t == 31) { return 0; }
    if (t == 30) { return 0; }
    if (t == 5) { return 0; }
    if (t == 12) { return 0; }
    if (GTLINE(S, GTI(S)) != GTLINE(S, GTI(S) - 1)) { return 0; }
    ERR_MSG(S, "#assert: expected `,` or `;` after the expression", 49);
    return 1;
}

# ⛔ 6.6.11 — `Base.NAME` resolved NAME alone and never looked at Base: `Foo.EB` (no such
# enum) and `E2.EB` (EB belongs to E1) compiled in expressions, #assert and array sizes,
# `Nope.gz` loaded the plain global gz, and with a variant name shared by two enums `A.X`
# read B's X. ONE resolver for all three sites. Base is known not to be a variable (that
# is a field access). Returns NAME's slot IN Base's enum; when NAME is a global but Base is
# not an enum, or not NAME's enum, reports it and returns FINDVAR's slot (the caller goes on
# as before, no cascade); -1 when NAME is no global at all (the caller's own path, as
# before). CHANGELOG [6.6.11]
# 6.7.16: NAME declared nowhere after a Base that IS an enum is the same "'NOPE' is not a variant of 'Color'", at
# NAME, and -2 (reported): each caller fell back to its undefined-name report for the BASE — "undefined variable
# 'Color'", "unknown name 'Color' in a const context" — blaming the enum, which is declared
# (issues/archived/2026-10-19-enum-qualified-unknown-member-named-as-unknown-enum.md). A Base that is no enum keeps -1.
# CHANGELOG [6.7.16]
fn _enum_qual_resolve(S, bti): i64 {
    var bnoff = TOKVAL(S, bti);
    var vn = TOKVAL(S, bti + 2);
    var vi = _enum_variant_in(S, bnoff, vn);
    if (vi >= 0) { _vis_check_var(S, vi, vn); return vi; }
    var any = FINDVAR(S, vn);
    if (any < 0) { return _enum_qual_none(S, bti, bnoff, vn); }
    var sv = GTI(S);
    if (_enum_id_of(S, bnoff) == 0) {
        STI(S, bti);
        _refuse_in_sync(S);   # 6.7.16: the caller parses on, so the statement after it is parsed (and reported)
        ERR_IDENT(S, "", bnoff, " is not an enum", 0 - 1);
    } elif (_dl_refd_at(S, bnoff) == 0) {   # 6.7.16: an enum whose body was refused answers nothing more
        STI(S, bti + 2);
        _refuse_in_sync(S);
        ERR_IDENT(S, "", vn, " is not a variant of ", bnoff);
    }
    STI(S, sv);
    return any;
}

# ... `vn` is no global at all: -2 after the report when `bnoff` names an enum, else -1 (the caller's own path).
fn _enum_qual_none(S, bti, bnoff, vn): i64 {
    if (_enum_qual_bad(S, bnoff, vn, bti + 2) == 0) { return 0 - 1; }
    return 0 - 2;
}
# "'vn' is not a variant of 'bnoff'" at token `mti` when `bnoff` names an enum (`vn` none of its members): 1 =
# reported. The resolver's, and the statement / `&` paths' that never reach it (`_enum_qual_store_refused`,
# `_enum_qual_lv_refuse`, `_stmt_enum_qual`). Not under --syntax-only: a file read alone may lack the other
# declaration of an enum of that name (one may be declared twice) — its unknown names stay opaque. CHANGELOG [6.7.16]
fn _enum_qual_bad(S, bnoff, vn, mti): i64 {
    if (_syntax_only == 1) { return 0; }
    return _enum_qual_bad_any(S, bnoff, vn, mti);
}
# ... under --syntax-only too: a const context names every unknown name there (`_ce_qual_unk`).
fn _enum_qual_bad_any(S, bnoff, vn, mti): i64 {
    if (_enum_id_of(S, bnoff) == 0) { return 0; }
    if (_dl_refd_at(S, bnoff) == 1) { return 1; }   # 6.7.16: its body was refused (`_enum_mem_name`) — stood down, counted
    var sv = GTI(S);
    STI(S, mti);
    _refuse_in_sync(S);   # every caller steps the member (and the statement) on: in sync
    ERR_IDENT(S, "", vn, " is not a variant of ", bnoff);
    STI(S, sv);
    return 1;
}

# The slot of the enum constant `vn` declared in an enum NAMED `bnoff`, or -1. Walks every
# global of that name (FINDVAR returns only the LAST) and compares the parent's NAME, not
# its id: an enum name may be declared more than once (lib/syscalls*.cyr each declare
# `Signal`, and a program may declare its own). CHANGELOG [6.6.11]
fn _enum_variant_in(S, bnoff, vn): i64 {
    var e = _fvh_head(S, vn);
    while (e != 0) {
        var vi = e - 1;
        if (GVECP(S, vi) == 1) {
            var pe = GVENUMID(S, vi);
            if (pe > 0) { if (STREQ(S, GENUMNM(S, pe - 1), bnoff) == 1) { return vi; } }
        }
        e = _fvh_next(vi);
    }
    return 0 - 1;
}

# `sizeof` as a whole identifier: the 6 letters AND the NUL after them (7 bytes). A 6-byte
# prefix test took `sizeofzz(P)` for sizeof. Also used by pass 1's _assert_skip_atom.
fn _is_sizeof_word(S, noff): i64 {
    if (L64(S + 0xEC00000 + noff) & 0xFFFFFFFFFFFFFF == 0x666F657A6973) { return 1; }
    return 0;
}

# `mulh64` as a whole identifier, the same 7-byte test. PARSE_FACTOR's 6-byte prefix test
# compiled a user fn `mulh64x(a, b)` as the intrinsic. CHANGELOG [6.6.11]
fn _is_mulh64_word(S, noff): i64 {
    if (L64(S + 0xEC00000 + noff) & 0xFFFFFFFFFFFFFF == 0x3436686C756D) { return 1; }
    return 0;
}

# An IDENT-spelled intrinsic that PARSE_FACTOR lowers inline: `sizeof(..)`, `mulh64(..)`.
# Neither is a fn, so `return sizeof(i64);` must not take the tail-call path, which
# jumped to an undefined fn of that name. CHANGELOG [6.6.11]
fn _is_ident_intrinsic(S, noff): i64 {
    if (_is_sizeof_word(S, noff) == 1) { return 1; }
    return _is_mulh64_word(S, noff);
}
# ⛔ 6.7.16 — A BUILTIN OR AN INTRINSIC CALLED WITH A TYPE-ARGUMENT LIST: `load64<i64>(p)`, `syscall<i64>(39)`,
# `mulh64<i64>(2, 3)`, `sizeof<i64>(H)`. Its arm asks for the `(` right after its name: "expected '(', got '<'", the
# list then read as comparisons ("undefined variable 'i64'"; a statement's `store64<i64>(&a, 2);` went on to "expected
# '}', got end of file"), and `mulh64<i64>(2, 3);` as a statement was "undefined function 'mulh64'". Refused once at the
# name with a fn's words (6.7.16, `_eta_gen`) — "'load64' is not a generic fn: it takes no type arguments" — and the list
# stepped, so the arm parses its call. ERR_EXPECT asks `_ngt_callee_lt` when it wants a `(`: one hook for every arm.
# Only a list of type names closing right before a `(` (`_ugc_open`): `sizeof < a` stays what it was. CHANGELOG [6.7.16]
# The name a callee at token nt that takes no type arguments prints with: a builtin token (a callable one: TOKNAME's
# `f64_sqrt` / `callptr` and TOKNAME_BUILTIN's, less the keywords `union` `u128` `defer` `secret` `async` `await`) or
# an IDENT-spelled intrinsic (`sizeof`, `mulh64`). 0 for anything else.
fn _ngt_callee_name(S, nt): i64 {
    var t = TOKTYP(S, nt);
    if (t == 2) {
        if (_is_ident_intrinsic(S, TOKVAL(S, nt)) == 1) { return S + 0xEC00000 + TOKVAL(S, nt); }
        return 0;
    }
    if (t == 101 || t == 105 || t == 106 || t == 108 || t == 134 || t == 135) { return 0; }
    if (t == 136 || t == 137) { return TOKNAME(t); }
    return TOKNAME_BUILTIN(t);
}
# The cursor on the `<` after such a callee, opening a type list a `(` follows: refused at the name (once — a generic
# body's instances share it; silent under --syntax-only, as D6's are; the latch put back, so the call parses in sync)
# and stepped, the cursor on the `(`. 1 = stepped; 0 = not that shape (cursor untouched).
fn _ngt_callee_lt(S): i64 {
    if (PEEKT(S) != 19) { return 0; }
    var nt = GTI(S) - 1;
    var nm = _ngt_callee_name(S, nt);
    if (nm == 0) { return 0; }
    var o = _ugc_open(S, GTI(S));
    if (o < 0) { return 0; }
    _ngt_say_s(S, nt, nm);
    STI(S, o);
    return 1;
}
fn _ngt_say_s(S, nt, nm): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, nt) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, nt);
    var tg = "_ngt_say_s";
    if (_err_once(S, (tg * 31 + nt) * 8 + 7) == 1) {
        _ew("error:", 6);
        _err_head(S);
        PRSTR(": '");
        PRSTR(nm);
        PRSTR("' is not a generic fn: it takes no type arguments\n");
        _err_excerpt(S);
        _had_error = 1;
    }
    STI(S, sv);
    return 1;
}
# `mulh64<i64>(2, 3);` as a statement (cursor on its `<`; `_stmt_undef_gcall`, the name being no fn): the list refused
# and stepped, then D11's statement — the value parsed, the statement ended at its `;` in sync — its own words standing
# down (`_stmt_intr_at`). 1 = consumed; 0 = no type list (cursor untouched).
fn _stmt_intr_targs(S, noff): i64 {
    var nt = GTI(S) - 1;
    if (_ngt_callee_lt(S) == 0) { return 0; }
    return _stmt_intr_at(S, noff, nt);
}
# ⛔ 6.7.16 — `mulh64(a, b);` / `sizeof(T);` AS A STATEMENT IS REFUSED BY NAME (the user's D11, 2026-10-19). The
# `IDENT (` statement arm sent it to PARSE_FNCALL, a call to a fn that cannot exist (6.6.20 reserved the names): the
# compile was refused for "undefined function 'mulh64'" (`sizeof(H);` with "undefined variable 'H'" first) and
# --allow-undef wrote a binary that died with SIGILL at the line. Its value is discarded, as `load64(&g);`, `x + 1;`
# and 6.7.15's D60 `(s).a;` discard one: "the value of 'mulh64(..)' is discarded - a statement is an assignment or a
# call", once at the name, no binary. The value is then parsed under the latch (`sizeof`'s type and all), the
# statement ending at its `;` in sync (`_refuse_in_sync`), so the next statement is parsed. Cursor on the `(` after the
# name `noff`; 1 = refused, the statement consumed. `fncallN` is no intrinsic here: its statement arm stays a call. A
# `.` after the call's `)` (`mulh64(2, 3).n = 5;`) is not the shape: `_stmt_intrinsic_dot`. CHANGELOG [6.7.16]
fn _stmt_intrinsic(S, noff): i64 { return _stmt_intr_at(S, noff, GTI(S) - 1); }
# ... the name at token nt (6.7.16: `mulh64<i64>(2, 3);`'s list stepped, `_stmt_intr_targs`). The discarded value's
# words stand down when the list was refused at nt (`_tn_seen_at`): the statement is one error, at the name.
fn _stmt_intr_at(S, noff, nt): i64 {
    if (_is_ident_intrinsic(S, noff) == 0) { return 0; }
    var c = _call_close(S, GTI(S)) + 1;
    if (c < GTCNT(S)) { if (TOKTYP(S, c) == 41) { return _stmt_intrinsic_dot(S, nt); } }
    STI(S, nt);   # the name
    _refuse_in_sync(S);
    if (_tn_seen_at(S, nt) == 0) { _stmt_val_say(S, "_stmt_intrinsic", noff, S + 0xEC00000 + noff); }
    PCMPE(S);
    _expect_step(S, 5);
    return 1;
}

# ⛔ 6.7.17 — A VALUE BUILTIN AS A WHOLE STATEMENT IS REFUSED IN D11'S WORDS (the user's D32, 2026-10-22): `load8(p);`,
# `load64(p);`, `f32_to(x);`, `f64_sqrt(x);`, `f64_add(a, b);`, `bitget(v, 0, 4);`, `rethi();`, `f64v_dot(a, b, n);`
# (IS_VALUE_BUILTIN, util.cyr). Like mulh64 (6.7.16's D11) each is lowered inline and has no fn to call, so its value
# is discarded: "the value of 'load8(..)' is discarded - a statement is an assignment or a call", once at the name, no
# binary; the value is then parsed under the latch and the statement ends at its `;` in sync, so the next statement is
# parsed. Through 6.7.16 `load8` and the f64 / bit / dot builtins compiled with the value dropped (PARSE_STMT's builtin
# bands) while `load16` `load32` `load64` `f32_from` `f32_to` were "unexpected load16". A builtin that stores through a
# destination (`store8`, `f64v_add(dst, ..)`), returns (`ret2`) or calls (`syscall`, `callptr`) stays a statement. As
# for mulh64: a type-argument list is the one error at the name (6.7.16's `_ngt_callee_lt`), a `.` after the call's
# `)` is parsed as the value position parses it (`_stmt_intrinsic_dot`), and with no `(` the statement is "expected
# '('" alone (`_stmt_no_paren`). Cursor on the builtin token `typ`; 1 = consumed. CHANGELOG [6.7.17]
fn _stmt_value_builtin(S, typ): i64 {
    if (IS_VALUE_BUILTIN(typ) == 0) { return 0; }
    var nt = GTI(S);
    STI(S, nt + 1);
    _ngt_callee_lt(S);   # `load8<i64>(p);`: the list refused at the name and stepped
    if (PEEKT(S) != 10) { return _stmt_no_paren(S); }   # `load16;`
    var c = _call_close(S, GTI(S)) + 1;
    if (c < GTCNT(S)) { if (TOKTYP(S, c) == 41) { return _stmt_intrinsic_dot(S, nt); } }
    STI(S, nt);   # the name
    _refuse_in_sync(S);
    if (_tn_seen_at(S, nt) == 0) { _stmt_val_say(S, "_stmt_value_builtin", typ, TOKNAME(typ)); }
    PCMPE(S);
    _expect_step(S, 5);
    return 1;
}

# A value builtin or an identifier intrinsic named as a statement with no `(` — `load16;`, `mulh64;`, `f64_sqrt 2.0;`,
# `load16.x = 1;`, `sizeof = 1;` (cursor on the token after the name): "expected '('" there, once, and the statement
# ends in sync with nothing read as a value (`_stmt_rest_skip`), so the next statement is parsed with its own errors.
# Parsed as the value position parses it, the token was stepped and the rest read as the argument: `load16.x = 1;`
# added "undefined variable 'x'", `load16 { 5 };` closed the block at the `}` ("unexpected ';'", "return outside a fn
# body"); `mulh64;` was the assignment arm's "expected '='" with "undefined variable 'mulh64'". 1. CHANGELOG [6.7.17]
fn _stmt_no_paren(S): i64 {
    _refuse_in_sync(S);
    ERR_EXPECT(S, 10);
    _stmt_rest_skip(S);
    return 1;
}
# `mulh64;` / `sizeof = 1;` — an identifier intrinsic named as a statement with no `(` (cursor after the name `noff`):
# as a value builtin's (`_stmt_no_paren`). 1 = consumed. CHANGELOG [6.7.17]
fn _stmt_intr_bare(S, noff): i64 {
    if (PEEKT(S) == 10) { return 0; }
    if (_is_ident_intrinsic(S, noff) == 0) { return 0; }
    return _stmt_no_paren(S);
}

# D11's words for the statement at the cursor, naming `nm` — `mulh64`, `load8` — (the report's identity: the tag `tg`
# and the key `k`): once, latched. CHANGELOG [6.7.16] [6.7.17]
fn _stmt_val_say(S, tg, k, nm): i64 {
    if (_err_once(S, (tg * 31 + k) * 8 + 7) == 0) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": the value of '");
    PRSTR(nm);
    PRSTR("(..)' is discarded - a statement is an assignment or a call\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# ⛔ 6.7.16 — `mulh64(2, 3).n = 5;` / `sizeof(H).n;`: a `.` after the intrinsic's `)` is no D11 shape, and the call
# statement's field arm (`_stmt_call_field`) took it as a call to a fn that cannot exist: "expected ';', got '.'" and
# then "undefined function 'mulh64'" twice and "refusing to emit binary" (`sizeof(H)` also read H as a variable). The
# statement is parsed as the value position parses it (`var x = mulh64(2, 3).n;`): the factor lowers the intrinsic by
# name and stops at the `.`, one "expected ';', got '.'". Not marked in sync: the statement is left mid-way, so the
# resync steps to its `;`. The name at token nt; 1. CHANGELOG [6.7.16]
fn _stmt_intrinsic_dot(S, nt): i64 {
    STI(S, nt);   # the name
    PCMPE(S);
    _expect_step(S, 5);
    return 1;
}

# ⛔ 6.6.20 — THE IDENTIFIER-SPELLED INTRINSICS ARE RESERVED NAMES. `sizeof` / `mulh64`
# (_is_ident_intrinsic) and `fncall0`..`fncall8` (_IS_FNCALL_NAME) lex as plain IDENTs and are
# lowered BY NAME at the call, so they sit in neither of util.cyr's reserved tables
# (TOKNAME_BUILTIN / IS_KEYWORD_TOK) and nothing refused them as a declaration:
#   * `fn mulh64(a, b)` compiled and every call got the intrinsic (the fn: "unreachable");
#   * `fn fncall1(a, b)` compiled and `fncall1(5, 6)` called THROUGH 5 — SIGSEGV;
#   * `fn sizeof()` / `var sizeof` / a param `mulh64` declared, and every use was a parse
#     error about a `(` that was never wanted.
# Lexer tokens would have meant re-plumbing every by-name site and could not express the one
# legitimate declarer below, so the refusal is made where a NAME IS DECLARED: fn, param,
# closure param, local / `stack` / global var, `for` binding, `use m.NAME;` (_tl_use) — which
# binds the BARE name — and a PAYLOAD enum variant (PARSE_ENUM_DEF), whose constructor is a fn
# under the bare variant name with no qualified form. A UNIT variant declares no fn and is
# accepted (read it `E.mulh64`). A module- or impl-mangled DEFINITION (`m_sizeof`, `T_mulh64`)
# is accepted, so a fn is judged AFTER mangling; re-exposing it bare with `use` is refused.
# ⚠ THE ONE LEGITIMATE DECLARER is lib/fnptr.cyr's `fncall0`..`fncall8`: those definitions ARE
# the lowering's enabler (it is gated on FINDFN, so a program that never included fnptr still
# gets "undefined function"), and cybs — which has no lowering — calls them in gen1. Exempt by
# FILE: an included file whose basename is `fnptr.cyr` (every copy in the ecosystem, surveyed
# 6.6.20, is one). The main source carries no file name (its map entry is `<source>`), so
# lib/fnptr.cyr fed AS the entry is refused — deliberately: exempting the main source is the
# filed repro's own shape. CHANGELOG [6.6.20]
fn _rsv_in_fnptr(S, ti): i64 {
    var fid = FM_FILEID(S, GTLINE(S, ti));
    # ⚠ -1 (the file map overflowed) fails OPEN, against FM_FILEID's fail-closed contract: closed
    # would refuse a real lib/fnptr.cyr included past the cap; open only restores pre-6.6.20.
    if (fid == 0 - 1) { return 1; }
    if (fid <= 0) { return 0; }
    var p = S + 0x721000 + fid - 1;
    var n = 0;
    while (load8(p + n) != 0) { n = n + 1; }
    if (n < 9) { return 0; }
    var q = p + n - 9;
    if (load64(q) != 0x79632E7274706E66) { return 0; }   # "fnptr.cy"
    if (load8(q + 8) != 114) { return 0; }               # "r"
    if (n == 9) { return 1; }
    if (load8(q - 1) == 47) { return 1; }                # '/'
    if (load8(q - 1) == 92) { return 1; }                # '\'
    return 0;
}

# Refuse declaring `noff` (its name token is `ti`) when it spells an identifier intrinsic.
# `isfn` = 1 for a fn definition, the only kind lib/fnptr.cyr's exemption applies to. An
# instance re-parses its base's tokens, so it was already judged there. 1 = refused.
# ⚠ Only an IDENT token's value is a name offset: every caller has already reported a non-IDENT
# (`var 140737488355327 = 1;`), and reading its NUMBER as an offset into the name pool faulted.
fn _RSV_INTRINSIC_DECL(S, noff, ti, isfn): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (_inst_name != 0) { return 0; }
    if (_is_ident_intrinsic(S, noff) == 0) {
        if (_IS_FNCALL_NAME(S, noff) == 0) { return 0; }
        if (isfn == 1) { if (_rsv_in_fnptr(S, ti) == 1) { return 0; } }
    }
    var sv = GTI(S);
    STI(S, ti);
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": reserved intrinsic name '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("' (cannot be used as an identifier: the compiler lowers every call to it; rename the fn/variable/param)\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    return 1;
}
