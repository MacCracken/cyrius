# `.m<..>(..)` at the cursor (on the `<`, the method's name just consumed; receiver (idx, sid)): the list read as
# an explicit generic call reads it (`_explicit_generic_call`), the callee resolved, and the method arm entered
# on the `(`. 0 = not that shape (the field miss reports). An all-i64 list, or a stub's scalar one, calls the base
# — refused as `p.m(5)` is when the base is the stub or bad for its bound; a refused type argument mints nothing
# and the arguments are consumed, not judged (`_mx_qt`).
fn _meth_targs(S, noff, fnoff, beg, idx, sid): i64 {
    if (PEEKT(S) != 19) { return 0; }
    var nt = GTI(S) - 1;
