# `<` was read as less-than: "unknown field 'm' on struct 'Pt'" + "undefined variable 'i64'", "no struct type in scope
# for 'v'", "expected ';', got '.'", "undefined variable 'nf'" + "expected ';', got '>'" — two or three errors, none
# naming the list. Refused once at the callee's name with D6 / D7's words for `Pt<i64>` — "'Pt.m' is not a generic
# method: it takes no type arguments", "'nf' is not a generic fn: ..." — the list stepped and the call parsed as
# `p.m(1)` / `nf(6)`, so nothing cascades. Only a list whose every name is a type (`_tylist_at`): `p.n < a, b > (c)`
# keeps its comparison reading. CHANGELOG [6.7.16]
# 1 = token nt is `.m<..>(`'s method on struct `sid` that takes type arguments (`_mtargs_at`), or any other `.m<types>(`
# with m no field of sid (`_mlist_end`); at a scalar field (sid <= 0), a bounded site's — the field walks stop at it for
# the member arm.
fn _mtargs_ng(S, sid, nt): i64 {
    if (_mtargs_at(S, sid, nt) == 1) { return 1; }
    if (sid <= 0) {
        if (_mngt_at(S, sid, nt) >= 0) { return 1; }
        return 0;
