# "'Pt.m' is not a generic method", false. CHANGELOG [6.7.17]
fn _meth_ngt_say(S, nt, mf): i64 {
    if (_MONOMORPH_OK != 1) { if (_fn_gen_tok(S, mf) == 1) { return _eta_nm_say(S, nt + 1); } }
    var nm = _fn_src_name(S, mf, L64(_fnt_names + mf * 8));   # `Pt.m`, `i64.show`
    _ngt_say_n(S, nt, nm, " is not a generic method: it takes no type arguments");
    return 0;
