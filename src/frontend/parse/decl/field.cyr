    var sv_gt = _ta_pending_gt;
    var sv_rf = _ta_refd;
    _ta_pending_gt = 0;
    _ta_refd = 0;
    STI(S, lt + 1);
    var sv_xq = _ta_xq;
    _ta_xq = 1;   # 6.7.16 (D5): the method's own read (`_meth_targs`) reports the list
    var c0 = _parse_one_type_arg(S);
    var c1 = _ta_rest_f(S, mf);
    _ta_xq = sv_xq;
    var rf = _ta_refd;
    _ta_pending_gt = sv_gt;
    _ta_refd = sv_rf;
    STI(S, sv);
    if (rf == 1) { return mf; }   # a refused type argument mints nothing (the call reports it)
    if (((GFTP(S, mf) >> 32) & 0xFFFFFFFF) == 0) { c1 = 0; }
    if (c0 <= 0 && c1 <= 0) {
        if (_gen_stub(S, mf) != 0) { return mf; }
        if (c0 == 0 - 8 && (c1 == 0 || c1 == 0 - 8)) { return mf; }
    }
    _gen_msp = 1;   # 6.7.15: a bound refusal here (it may report first) names the method `P.m`
    var spec = _instantiate_generic_fn(S, mf, c0, c1);
    _gen_msp = 0;
    if (spec >= 0) { return spec; }
    return mf;
}
# ⚠ Six parameters at most: the leaf's type is read back from `_resolve_leaf_field` (`_rlf_si` /
# `_rlf_fi`), because cybs — the bootstrap compiler seed-derive runs — rejects a 7-argument call
# with a bare "syntax error" (found by seed-derive, 6.7.0).
fn _load_inline_hop(S, noff, beg, idx, sid, off): i64 {
    var ft = GETFTYPE(S, _rlf_si, _rlf_fi);
    if (ft <= 0) { return _load_bs_field(S, noff, beg, idx, sid, off); }   # 6.7.14
    if (IS_STR_FIELD(S, ft) == 1) { return _load_str_hop(S, noff, beg, idx, sid, off); }   # 6.7.15
    if (idx <= 0 - 1000000) { _CL_CAP_BASE_RA(S, 0 - 1000000 - idx, sid); }
    elif (idx < 0 - 1) {
        var li = 0 - idx - 2;
        if (_local_struct_is_ptr(S, li, 0 - sid) == 1) { EFLLOAD(S, li); }
        else { _fn_local_addr = 1; EFLADDR(S, li); }
    } else {
        if (_gv_holds_addr(S, idx) == 1) { EVLOAD(S, idx); } else { EVADDR(S, idx); }
    }
    if (off > 0) { EADDRA_IMM(S, off); }
    var h = _ptr_park(S, ft);
    STI(S, GTI(S) + 1);                 # `.`
    var mnoff = PEEKV(S);
    STI(S, GTI(S) + 1);                 # the method name
    return _field_load_on(S, noff, mnoff, beg, h, ft);
}
fn _load_hop(S, noff, beg, idx, sid, off): i64 {
    var ps = _fld_hop_sid(S);
    var h = _ptr_hop(S, idx, sid, off, ps);
    STI(S, GTI(S) + 1);                 # `.`
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);                 # the field / method name
    return _field_load_on(S, noff, fnoff, beg, h, ps);
}
# 6.6.17 — `f().val`, `f().next.val`, `f().m(..)` for `fn f(): *T`, T a struct: the call's result
# is a pointer, so it is parked as a pointer-mode receiver and the chain continues from it, as for
# a `*T` local. (It was "cannot take a field of the result of 'f': it does not return a struct".)
# Cursor just past the callee name at `ti`; 1 = consumed. 6.7.11: a generic callee too — `fi` is the
# instance the call reaches (its `: *T` recorded under its binding, `_ret_ptr_record`), and an explicit
# `g<S>(..).val` is parsed as the factor parses it (`gpg<S>().v` was refused: issues/2026-10-13-generic-
# pointer-returning-call-as-struct-source.md).
fn _call_ptr_field(S, ti, fi): i64 {
    if (fi < 0) { return 0; }
    if (_fn_rpsid == 0) { return 0; }
    var psid = L64(_fn_rpsid + fi * 8);
    if (psid <= 0) { return 0; }
    if (TOKTYP(S, ti + 1) == 19) {
        STI(S, ti + 1);
        _explicit_generic_call(S, TOKVAL(S, ti), FINDFN(S, TOKVAL(S, ti)));
    } else {
        if (TOKTYP(S, ti + 1) != 10) { return 0; }
        STI(S, ti + 1);
        PARSE_FNCALL(S, TOKVAL(S, ti));
