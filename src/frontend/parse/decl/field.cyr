# 6.7.15: the fn the explicit `x.m<..>(` reaches, generic method mf with its list's `<` at token lt — for a
# lookahead, quietly: its instance, else mf (`_gen_resolve_call`'s explicit arm; a list naming anything but a
# declared struct / plain scalar / bound type parameter, or a base the call refuses, is the call's own to report).
fn _mcall_xquiet(S, mf, lt): i64 {
    if (mf < 0) { return mf; }
    if (_MONOMORPH_OK == 0) { return mf; }
    if (GFTP(S, mf) == 0) { return mf; }
