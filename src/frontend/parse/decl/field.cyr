# 6.7.16 — `_meth_ngt` for `_field_load_on`'s `sid == 0` arm, asked BEFORE its const and refused-annotation checks: a
# const `C.m<i64>(1)` was "has no fields" and a refused annotation's `x.m<i64>(1)` stood down, each with the cursor on
# the `<` — the list then read as comparisons ("undefined variable 'i64'"); stepped first, both are their `.m(1)`. Not
# in a refused const fn's run-time body: its field stand-down (`_ce_fld_said`) steps `.m<..>(..)` whole, so a later
# name of the statement's own is still reported. 1 = taken. CHANGELOG [6.7.16]
fn _meth_ngt0(S, noff, fnoff, beg, idx, sid): i64 {
    if (_ce_fn_refd != 0) { return 0; }
    return _meth_ngt(S, noff, fnoff, beg, idx, sid);
