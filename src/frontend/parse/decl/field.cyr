# The `>` closing `.m<..>(`'s list at method-name token nt when it is a type list (`_tylist_at`) followed by `(` and m
# no field of struct sid (sid <= 0: a receiver of no known struct); else -1.
fn _mlist_end(S, sid, nt): i64 {
    if (TOKTYP(S, nt) != 2) { return 0 - 1; }
    if (TOKTYP(S, nt + 1) != 19) { return 0 - 1; }
    if (sid >= 2048) { return 0 - 1; }
    if (sid > 0) { if (FINDFIELD(S, sid - 1, TOKVAL(S, nt)) >= 0) { return 0 - 1; } }
    var e = _tok_targs_close(S, nt + 2);
    if (e < 0) { return 0 - 1; }
    if (TOKTYP(S, e + 1) != 10) { return 0 - 1; }
    if (_tylist_at(S, nt + 2, e, 0 - 1) == 0) { return 0 - 1; }
    return e;
}
# The method `.m<..>(` at token nt reaches when it is NOT generic, the list a type list; else -1. On struct sid: m no
# field of it (a field keeps the comparison); at sid <= 0, a bounded site's callee (a scalar T's impl method).
fn _mngt_at(S, sid, nt): i64 {
    if (_mlist_end(S, sid, nt) < 0) { return 0 - 1; }
    var mf = 0 - 1;
    if (sid <= 0) {
        if (_bs_n == 0) { return 0 - 1; }
        var b = _bs_find(S, nt);
        if (b < 0) { return 0 - 1; }
        mf = _bs_callee(S, b, 0);
    } else {
        mf = _meth_fn_at(S, sid, TOKVAL(S, nt), nt);
    }
    if (mf < 0) { return 0 - 1; }
    if (GFTP(S, mf) != 0) { return 0 - 1; }
    return mf;
