# The member arm past a list it does not take (cursor on the `<` past the method's name; receiver (idx, sid)): a
# method that is not generic refused (`_mngt_at`), and any `.m<types>(` (`_mlist_end`: no such method, a receiver of
# no known struct) stepped too — the call parsed from its `(` as the plain spelling is, which reports what `p.m(1)`
# reports. 1 = taken; 0 = not that shape.
fn _meth_ngt(S, noff, fnoff, beg, idx, sid): i64 {
    if (PEEKT(S) != 19) { return 0; }
    var nt = GTI(S) - 1;
    var e = _mlist_end(S, sid, nt);
    if (e < 0) { return 0; }
    var mf = _mngt_at(S, sid, nt);
    if (mf >= 0) { _meth_ngt_say(S, nt, mf); }
    STI(S, e + 1);
    _mx_ti = nt;   # the arm's method name, not the list's `>`
    _field_load_on(S, noff, fnoff, beg, idx, sid);
    _mx_ti = 0 - 1;
    return 1;
}
# The fn `p.m<c0, c1>(..)` reaches (generic method mf): its instance, else its base — refused where the free
# spelling refuses it (`_explicit_generic_call` / `_gen_call_head`).
fn _meth_xinst(S, mf, c0, c1): i64 {
    _mx_qt = 0;
    var mn = L64(_fnt_names + mf * 8);
    if (_ta_refd == 1) { _ta_refd = 0; _mx_qt = 1; return mf; }
    if (((GFTP(S, mf) >> 32) & 0xFFFFFFFF) == 0) { c1 = 0; }
    var base = 1;
    if (c0 != 0 - 8) { base = 0; }
    if (c1 != 0) { if (c1 != 0 - 8) { base = 0; } }
    if (c0 < 0) { if (c1 <= 0) { if (_gen_stub(S, mf) != 0) { base = 1; } } }
    _gen_msp = 1;   # 6.7.15: its refusals name the method `P.m`
    if (base == 1) {
        if (_bnd_base_bad(S, mf) == 1) { _refuse_bnd_base(S, mf, mn); }
        elif (_gen_stub(S, mf) != 0) { _refuse_gen_stub(S, mf, mn); }
        _gen_msp = 0;
        return mf;
    }
    var spec = _instantiate_generic_fn(S, mf, c0, c1);
    if (spec < 0) { if (spec != 0 - 4) { _refuse_gen_inst(S, mf, mn, spec); } }
    _gen_msp = 0;
    if (spec >= 0) { return spec; }
    if (spec == 0 - 4) { _mx_qt = 1; }   # the bound's refusal, reported at the type it binds
