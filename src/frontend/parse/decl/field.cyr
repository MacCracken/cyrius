# ⛔ 6.7.14 (the user's D7 (a), 2026-10-16) — EXPLICIT TYPE ARGUMENTS ON A METHOD CALL, as on its free spelling:
# `p.id<f64>(h)`, `w.v.id<f64>(h)`, `var a = p.id<f64>(h);` call `P_id$f64`, as `P_id<f64>(&p, h)` does. The `<`
# was read as less-than, so the call was refused "unknown field 'id'" + "undefined variable 'f64'". The shape
# is `.m<..>(` where m names no field of the receiver's struct and a GENERIC method of it (`_mtargs_at`), so a
# field of that name still wins (`p.n < k`). CHANGELOG [6.7.14]
var _mx_fi = 0 - 1;   # the method arm's callee, set by `_meth_targs` for the arm it enters (-1: none)
var _mx_ti = 0 - 1;   # ... and the method's name token
var _mx_qt = 0;       # ... 1 = a type argument was refused: the arm consumes the arguments, judging none
# 1 = token nt is a method name `m` followed by `<..>(`, with m no field of struct `sid` and a generic method of it.
# 6.7.16: at a scalar receiver, a bounded site's (`_mtargs_bs`).
fn _mtargs_at(S, sid, nt): i64 {
    if (sid <= 0) { return _mtargs_bs(S, nt); }
    if (sid >= 2048) { return 0; }
    if (_MONOMORPH_OK == 0) { return 0; }
    if (TOKTYP(S, nt) != 2) { return 0; }
    if (TOKTYP(S, nt + 1) != 19) { return 0; }
    if (FINDFIELD(S, sid - 1, TOKVAL(S, nt)) >= 0) { return 0; }
    var mf = _meth_fn_at(S, sid, TOKVAL(S, nt), nt);
    if (mf < 0) { return 0; }
    if (GFTP(S, mf) == 0) { return 0; }
    var e = _tok_targs_close(S, nt + 2);
    if (e < 0) { return 0; }
    if (TOKTYP(S, e + 1) != 10) { return 0; }
    return 1;
}
# ⛔ 6.7.16 (the user's D4, 2026-10-19) — A BOUND'S OWN GENERIC MEMBER, CALLED WITH ITS EXPLICIT LIST ON A SCALAR T:
# `v.show<i64>(1)` / `b.v.show<i64>(1)` with `T: Show`, `trait Show { fn show<V>(self, k: V): i64; }` and T bound to
# i64. A scalar receiver has no struct, so the member arm never read the list: the name form was "no struct type in
# scope for 'v'" + "undefined variable 'i64'", the field form "expected ';', got '.'" (and both were the stub base
# until the site scan took the spelling, `_bnd_mopen`), where `v.show(1)` calls `i64_show`. 1 = token nt is a bounded
# site recorded with its list whose callee, T's impl method (`_bs_callee`), is generic: the arm reads the list and
# calls that instance with the value as `self`, as the inferred spelling does. CHANGELOG [6.7.16]
fn _mtargs_bs(S, nt): i64 {
    if (_bs_n == 0) { return 0; }
    if (_MONOMORPH_OK == 0) { return 0; }
    if (TOKTYP(S, nt + 1) != 19) { return 0; }
    var b = _bs_find(S, nt);
    if (b < 0) { return 0; }
    var f = _bs_callee(S, b, 0);
    if (f < 0) { return 0; }
    if (GFTP(S, f) == 0) { return 0; }
    return 1;
