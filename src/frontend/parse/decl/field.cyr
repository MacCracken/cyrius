# The method arm's name token: `_meth_targs`'s, taken once, else the token before the cursor's `(`.
fn _mx_take(S): i64 {
    if (_mx_ti < 0) { return GTI(S) - 1; }
    var t = _mx_ti;
    _mx_ti = 0 - 1;
    return t;
}
# The method arm's callee: the instance `_meth_targs` named, else the one the arguments bind (`_mcall_gen`).
fn _mcall_gen_x(S, fi, open, rsid): i64 {
    if (_mx_fi < 0) { return _mcall_gen(S, fi, open, rsid, 1); }
    var f = _mx_fi;
    _mx_fi = 0 - 1;
    return f;
