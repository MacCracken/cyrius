# (_gvk_chain), in declaration order: pass 1 records what it knows in `_gvc_rec`, 4 words a record —
#   kind 0 (`_gvc_unfolded`): an initializer pass 1 cannot fold follows the slot's constant (`has`, value): the
#     chain's state before it;
#   kind 1 (`_gv_dup_later`): a constant after such an initializer — its compare, at its `=`, is the replay's;
# word 1 = the deferred entry the record precedes (the entry count when it was made). Every other pair is compared
# in pass 1, as before. CHANGELOG [6.7.15]
var _gvc_rec = 0;
var _gvc_n = 0;
var _gvc_cap = 0;   # in words
fn _gvc_add(S, kind, slot, v, x): i64 {
    if (_gvc_n * 4 + 4 > _gvc_cap) { _gvc_grow(); }
    var r = _gvc_rec + _gvc_n * 32;
    store64(r, kind + slot * 2);
    store64(r + 8, L64(S + 0x19A000));
