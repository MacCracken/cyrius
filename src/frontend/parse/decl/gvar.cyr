        elif (PEEKT(S) == 105) { ann_scalar = 16; STI(S, GTI(S) + 1); }
        else {
            if (_gvar_ann_head(S, noff) == 1) {   # 6.7.7 (B4): or a tuple type's `(`; 6.7.8: a slice refused
                # ⛔ 6.6.16 (C8): the one type-name resolver, as PARSE_VAR's ladder. This one
                # matched PREFIXES before the struct lookup (`var g: i8x = 300` was an i8 global,
                # `var g: u8pair;` a u8 scalar, `var g: f64v2` an f64) and read an unknown name as
                # a silent i64. A vector is a plain 8-byte global here, as it is after the first
                # statement (PARSE_VAR's global arm). CHANGELOG [6.6.16]
                var ann_c = _tn_ann(S, GTI(S), noff);
                ann_vec = _tn_vec(ann_c);   # 6.6.17 (a3): see _vecg_size
                ann_scalar = _tn_iw(ann_c);
                ann_signed = _tn_sgn(ann_c);
                ann_float = _tn_flt(ann_c);
                ann_sid = _tn_sid(ann_c);
                ann_bool = _tn_bool(ann_c);
            }
            STI(S, GTI(S) + 1);
            ann_sid = _gen_ann_sid(S, ann_sid);   # 6.6.11: `W1<Pt>` is the instance, not the base
        }
    }
    # Array: register with size. v5.11.51 — when the array has a
    # `= { byte-list };` initializer, PARSE_GVAR_ARR saves sti to
    # gvar_toks so EMIT_GVAR_INITS replays it at top-level emit time
    # (pass-1 emits get skipped by the entry-jmp patch).
    if (PEEKT(S) == 28) {
        var ann_eb = _gvar_ebytes(S, ann_scalar, ann_float, ann_sid, psc, ann_ti);   # 6.6.13 (M2)
        PARSE_GVAR_ARR(S, noff, sti, ann_scalar, ann_signed, ann_eb);
        return 0;
    }
    # Check for struct init after =: var p = StructName { ... }
    # Peek ahead: skip to = then check if next is IDENT matching a struct
    var save_peek = GTI(S);
    # We're past the type annotation, at = or the token before it
    # Find the = sign
    var pgo = 1;
    while (pgo == 1) {
        if (PEEKT(S) == 4) { pgo = 0; }
        else { if (PEEKT(S) == 5) { pgo = 0; }
            else { if (PEEKT(S) == 12) { pgo = 0; }
                else { STI(S, GTI(S) + 1); } } }
    }
    var is_struct = 0;
    var ssid = 0;
    # v5.11.64: detect `var X = INT_LITERAL ;` shape for static init.
    # Non-zero literals get pre-written into the var area at FIXUP time
    # so the value is correct on FIRST READ — fixes the kmode-entry
    # init-order bug where gvar reads before the post-PROG EMIT_GVAR_INITS
    # block returned 0. Zero literals fall through to the existing
    # runtime-store path (BSS-zero is already correct for them).
    # See CHANGELOG [5.11.64] + the filed issue.
    #
    # 6.6.6: a REDECLARATION reuses the global's slot (_gv_fold) and a constant one is
    # static too — the old shadow opt-out sent it to the runtime-store path while the FIRST
    # declaration's static value sat in a slot nothing read (b = 0 in `var a = 5; var b = a;
    # var a = 5;`). An earlier deferred store is now superseded rather than clobbering
    # (_gv_supersede), which is the hazard the opt-out existed for (mabda `var F64_TWO = 0;`
    # shadowed by math `var F64_TWO = 0x4000...;`). A declaration that shadows a global it does
    # NOT fold into — an enum constant, or a global with another visibility owner — is static
    # as well: each replay entry now stores into the slot it recorded (_gv_ent_slot), so an
    # earlier deferred store can no longer land on this one, and the enum's startup store skips
    # a slot that is not an enum constant's (PARSE_ENUM_DEF). CHANGELOG [6.6.6]
    var sit_lit = 0;
    var sit_val = 0;
    var sit_shadow = 0;
    var rhs_ti = 0;     # 6.7.3: the initializer's first token (a static bool is judged by its shape)
    var cf_has = 0;     # 6.6.6: the initializer folded to a constant (any target, any value)
    var cf_val = 0;
    var chk_lit = 0;    # v6.2.11: `= NUM ;` literal for the collision guardrail
    var chk_has = 0;
    # 6.6.6: _findvar_core, not FINDVAR — "does this name already exist?" asked while
    # REGISTERING this global is not a reference to the prior one, and running the cross-file
    # `private` check here refused a file its own re-declaration. See _findvar_core.
    if (_findvar_core(S, noff) >= 0) { sit_shadow = 1; }
    if (PEEKT(S) == 4) {
        STI(S, GTI(S) + 1);
        # v5.9.33: only treat this as a struct-typed gvar if the RHS is a real struct
        # literal `var p = Point { ... };`. A bare ident reference like `var x = MASK & 0xF;`
        # (where MASK is also a struct name) must allocate a scalar slot, not STRUCTSZ bytes.
        # 6.6.12: `Box<Pt> { .. }` too (`_lit_head`), and an annotation must agree with it.
        var lh_ti = GTI(S);
        rhs_ti = lh_ti;
        ssid = _lit_head_p(S);   # 6.7.14: a wrap too
        STI(S, lh_ti);
        if (ssid > 0) {
            is_struct = 1;
            _lit_ann_check(S, 0 - ann_sid, ssid, ann_bool);
        } else {
            ssid = _gci_inline(S, ann_sid, ann_ti);   # 6.6.12: `var G: T = A;` / `= X.f;` — inline; 6.7.7: a tuple literal
            if (ssid > 0) { is_struct = 1; }
        }
        # Static-init detection: shape is exactly `= NUM ;`. Negative
        # literals (`= - NUM ;`), hex-as-expr, parenthesized literals,
        # and arithmetic RHS all fall through to the runtime-store
        # path. Conservative on purpose — no false positives means no
        # silent value drift versus today's behavior.
        #
        # cx takes this path too (6.7.9): its scalar globals are zero in the .cyx var data, and
        # _gv_cx_prestore stores every recorded value at startup, before the replay. cx used to
        # opt out and ALSO replay the initializer, so a folded value was computed again at run
        # time there alone: `var Q = INT_MIN / -1;` trapped in cxvm's `idiv`. CHANGELOG [6.7.9]
        # v6.2.11: capture a `= NUM ;` literal for the collision guardrail,
        # INDEPENDENT of the static-init opt below (which skipped shadowing
        # redefinitions until 6.6.6 — and a collision warning must fire EXACTLY on
        # those). Read-only (PEEKV, no STI advance); does not affect codegen.
        if (PEEKT(S) == 1 && TOKTYP(S, GTI(S) + 1) == 5) { chk_lit = PEEKV(S); chk_has = 1; }
        # v6.4.74: widened from the exact `= NUM ;` shape to ANY constant-foldable
        # integer expression (`-5`, `0 - 61`, `512 * 2`, `1 << 4`, `(A) | B`, …) via
        # _CF_TRY above. A folded value is indistinguishable from a literal here, so
        # it takes the same static-init path and is correct on FIRST READ — which is
        # what makes computed module-scope initializers work in kmode, where the
        # deferred EMIT_GVAR_INITS block is unreachable for a kernel whose top-level
        # program never returns. _CF_TRY is conservative: anything it cannot prove
        # constant leaves _cf_ok == 0 and we fall through to the runtime-store path
        # exactly as before. A folded ZERO still falls through — BSS is already zero,
        # so the runtime store is redundant but harmless, and keeping that branch
        # identical preserves the v5.11.64 behaviour for `= 0 ;`.
        var fv = _CF_TRY(S, GTI(S), 5);
        if (_cf_ok == 1) {
            cf_has = 1;
            cf_val = fv;
            if (fv != 0) {
                sit_lit = 1;
                sit_val = fv;
            }
        }
    }
    STI(S, save_peek);  # restore
    # v6.3.24: a NON-int-literal global (string / expr / struct / array init →
    # chk_has==0) that shadows an enum constant is the dangerous silent-miscompile
    # case — a pointer/expr can never be a benign same-value alias of an int enum
    # fold, and once registered every later reference to the name rebinds to the
    # var, INCLUDING inside already-parsed library code that uses the constant as an
    # ABI offset (patra `DbOff.DB_PATH`). Hard-error. An int-literal shadow stays a
    # CHKDUPVAL warning above (e.g. chrono's harmless `var CLOCK_MONOTONIC = 1`
    # aliasing the syscall enum, same value). See CHK_ENUM_SHADOW in parse/types.cyr.
    if (chk_has == 0) { CHK_ENUM_SHADOW(S, noff); }
    # Register
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, noff);
    if (is_struct == 1) {
        S64(_vars_base + vcnt * 8, STRUCTSZ(S, ssid - 1));
        SVTYPE(S, vcnt, ssid);
        SVPM(S, vcnt, 2);   # 6.6.5: INLINE — the global owns STRUCTSZ bytes
    } else {
        if (ann_float != 0) {
            # f64/f32: 8-byte slot (f64 bit pattern, or f32 bits in the low 32);
            # SVTYPE marks it so PEXPR/PARSE_TERM route operators to EMIT_F64_BINOP.
            S64(_vars_base + vcnt * 8, 8);
            SVTYPE(S, vcnt, ann_float);
        } elif (ann_scalar > 0) {
            if (ann_scalar < 8) {
                S64(_vars_base + vcnt * 8, ann_scalar);
                SVTYPE(S, vcnt, ann_scalar);
                SVSGN(S, vcnt, ann_signed);   # v6.4.23: sign-extend a signed iN global on load
            } else {
                # 8 (i64) or 16 (u128) — allocate the full width.
                # No type marker for now: u128 bytes live in the slot,
                # scalar ops touch the low 64 bits until alpha3 lands
                # proper arithmetic.
                S64(_vars_base + vcnt * 8, ann_scalar);
            }
        } else {
            _vecg_size(S, vcnt, ann_vec);
            if (ann_vec != 0) { _vecg_init_ok(S, cf_has, cf_val, noff, rhs_ti); }
            # 6.6.5 — `var G: P = <expr>;` gets ONE 8-byte slot, so the slot HOLDS an address;
            # the literal form above owns STRUCTSZ bytes and IS the struct. Both carry the same
            # positive SVTYPE, so nothing downstream could tell them apart and every `G.field`
            # was emitted as `lea &G` — reading the pointer's own bytes as field 0 (measured 0
            # where 22 is right). Record which one this is. CHANGELOG [6.6.5]
            if (ann_sid > 0) {
                _tup_svtype_p1(S, vcnt, ann_sid, noff, ann_ti);   # 6.7.7: SVTYPE, never a pointer-mode tuple
                if (STRUCTSZ(S, ann_sid - 1) > 8) { SVPM(S, vcnt, 1); } else { SVPM(S, vcnt, 2); }
            }
            elif (psc > 0) { _gv_ptr_type(S, vcnt, psc, ann_ti); }   # 6.6.17: + T
        }
    }
    # v6.5.0 Phase 2b: stamp this global's owning file if the file opted into
    # private-by-default and no `public` moniker preceded it (fileid+1; 0 stays "not
    # private" — see _var_fileid in util.cyr). Placed HERE, immediately before the
    # count bump, because this is the point every SCALAR global var reaches: the first
    # cut sat inside the `ann_scalar < 8` arm and so only ever fired for annotated
    # narrow scalars like `var x: i32`, silently doing nothing for a plain `var x = 1`.
    # ⚠ NOT every global: the array form returns from PARSE_GVAR_ARR above and the
    # destructure form stamps per name — each carries its own _GVAR_VIS (v6.6.4).
    # v6.2.11: flag a conflicting-value redefinition (issue 2026-06-14) when this
    # global has a `= NUM ;` literal AND shadows a prior def, BEFORE it's
    # counted so the lookup sees only prior defs. Mirrors the enum-member site in
    # parse/types.cyr. Gated on the shadow so the common non-colliding case skips
    # the scan; CHKDUPVAL itself is value-conflict-only (identical = silent).
    # 6.7.15: asked once the registration is written, so a refused shape and a prior the replay folds stand it down
    # (_gv_dup_later). The cursor is still the declaration's `=`.
    var gpi = _gv_fold_peek(S, vcnt, sti, ann_bool);
    if (_gv_dup_later(S, gpi, cf_has * (1 - is_struct), cf_val) == 0) {
        if (chk_has == 1 && sit_shadow == 1) { CHKDUPVAL(S, noff, chk_lit); }
        if (chk_has == 0 && sit_shadow == 1) { _gv_dup_folded(S, noff, cf_has, cf_val, is_struct); }   # 6.7.14
    }
    var gvi = _gv_fold_b(S, vcnt, sti, ann_bool);   # 6.6.6: a redeclaration reuses the global's slot; 6.7.14: + bool
    _gz_reg(S, gvi, is_struct, ssid, ann_sid, rhs_ti);   # 6.7.10 (B7-1g): judged at the end of pass 1
    _gu_reg(S, gvi, ann_ti + is_struct, rhs_ti);         # 6.7.14 (D29 / D30): an untyped whole call, typed there
    _gzf_reg(S, gvi, ann_ti + is_struct, rhs_ti, 0 - 1);   # 6.7.16 (D98): an untyped f64 call, typed there too
    _GVAR_VIS(S, gvi, sti);
    _gv_last_marks(S, gvi, ann_bool, ann_scalar, ann_ti);   # 6.7.3 (B2): like the float flag, the last declaration's; 6.7.6: + the integer and u128 marks
    SGFI(S, gvi, _gv_ufv(S, sti, psc + ann_sid + ann_scalar + ann_float));   # 6.6.10
    _gv_float_copy(S, gvi, sti, psc + ann_sid + ann_scalar + ann_float);     # 6.6.11
    _gv_diag_sid(S, gvi, sti, psc + ann_sid + ann_scalar + ann_float + is_struct);   # 6.6.13 I11
    if (ann_float != 0) { _gv_ifs(S, sti, ann_float); }                      # 6.6.10
    if (gvi == vcnt) {
        SVCNT(S, vcnt + 1);
        # A shadow that keeps its own slot (over an enum constant, or over a global with
        # another visibility owner): a constant one is its value from program start on every
        # target, zero and cx included (_gv_cx_prestore) — the global it hides can store
        # nothing into it (see above), and a read between the two must not see 0.
        if (sit_shadow == 1 && cf_has == 1 && is_struct == 0) { sit_lit = 1; sit_val = cf_val; }
    }
    else {
        # A redeclaration: a constant one wins from program start (see _gv_supersede) — on
        # every target, including a zero and including cx (_gv_cx_prestore).
        sit_lit = 0;
        if (cf_has == 1 && is_struct == 0) {
            sit_lit = 1;
            sit_val = cf_val;
            _gv_supersede(S, noff, 0);
        }
    }
    # v5.11.64: static-init path — record literal value, skip gvar_toks
    # registration so EMIT_GVAR_INITS won't replay the (now redundant)
    # runtime store. FIXUP's var-area writer reads gvar_initval and
    # writes the literal into the file image at the var's offset.
    #
    # SLVAR(vcnt) keeps the "last var" pointer in sync with the runtime-
    # store path (which SLVAR's inside EMIT_GVAR_INITS's replay loop —
    # see line ~900). Programs like `var x = 42;` with no main rely on
    # the entry-trailing `EVLOAD(GLVAR())` → EEXIT to use the last var
    # as the exit code (aarch64 ci's literal-only test cases hit this
    # exact shape: `var x = 42;` expects exit 42). Without this call,
    # static-init vars would silently fall out of the last-var chain
    # and the binary would exit with whatever rax held — exit-code
    # corruption the runtime-store path can't reproduce.
    # On cx the recorded value is what _gv_cx_prestore stores at startup (its var data holds no
    # scalar), so a forward read agrees with the image targets there too. CHANGELOG [6.6.6] [6.7.9]
    _bx_gv_reg(S, ann_bool, sit_lit, rhs_ti, noff);   # 6.7.3: a baked bool is judged here
    if (sit_lit == 1) { if (psc > 0) { _tp_warn_baked(S, rhs_ti); } }   # 6.7.13 (D18 (a)): never replayed
    if (cf_has == 1) { if (is_struct == 0) { _gv_lit_set(gvi, 1); } }   # 6.7.12 (D30): a constant, zero too
    if (sit_lit == 1) {
        S64(_vgsi_base + gvi * 8, sit_val);
        SLVAR(S, gvi);
    } else {
        # Save token index for deferred init
        _gvc_unfolded(S, gvi, cf_has + is_struct);   # 6.7.15: the replay's compare chain
        _gv_defer(S, sti, gvi + 1);   # 6.6.6: gvi + 1 = the slot this entry declared
    }
    _skip_gvar_decl(S, sti);   # 6.6.6: through the `;` outside every `{ }` (see there)
    return 0;
}
