# 1 = the tokens [a, e) are one postfix chain: a name (`f<..>(`: a call's explicit list) or a parenthesised chain,
# then any run of `.name` (`.m<..>(`), `( .. )` and `[ .. ]`. Anything else at its level (an operator, a literal, a
# keyword) fixes the value as no struct: 0.
fn _ini_chain(S, a, e): i64 {
    var i = a + 1;
