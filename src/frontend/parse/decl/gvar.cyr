    _gvc_cap = _gvc_cap * 2;
    return 0;
}
# A deferred scalar entry of slot `gvi` that pass 1 did not fold (`k` = cf_has + is_struct, 0): the slot's constant
# so far is the chain's state before it, recorded once per run of such entries.
fn _gvc_unfolded(S, gvi, k): i64 {
