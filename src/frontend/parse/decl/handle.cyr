fn _hl_pname(S): i64 { return _src_span_nm(S, _hl_psa, _hl_pse, _hl_dnm); }
# `_AGG_ASSIGN_TYPE_ERR` for `_hl_psrc`'s source into `dnoff`, named only when refused (1).
fn _hl_psrc_err(S, td, ts, dnoff): i64 { return _agg_span_err(S, td, ts, dnoff, _hl_psa, _hl_pse, _hl_dnm); }
# The name a refusal of the `*T` expression [a, e) names: in pointer arithmetic the pointer operand's (the
# side `_hl_psid` types), else the last name of the chain (`w.pu` -> `pu`, `gu()` -> `gu`).
fn _hl_pnm(S, a, e): i64 {
    a = _ie_unparen(S, a, e);
    e = _ie_pe;
    var k = _hl_addop(S, a, e);
    if (k > a) {
        if (_hl_psid(S, a, k) > 0) { return _hl_pnm(S, a, k); }
        return _hl_pnm(S, k + 1, e);
    }
    return _hl_lastnm(S, a, e, TOKVAL(S, a));
}
# Fn `fi`'s `: *T` struct (`_fn_rpsid`), else 0.
fn _hl_fn_psid(fi): i64 {
    if (fi < 0) { return 0; }
    if (_fn_rpsid == 0) { return 0; }
    return L64(_fn_rpsid + fi * 8);
}
# ⛔ 6.7.16 — A KNOWN `&f` CALLEE'S RESULT IS TYPED BY ITS TOKENS AS THE DIRECT CALL'S (6.7.14's D26 (a), 6.7.13's D16):
# the token typers read `f(..)` but not `fncallN(&f, ..)` / `callptr(&f, ..)`, so with `gp: *P2` the wraps
# `(fncall0(&gp)).b` / `(*fncall0(&gp)).b` were refused "not a struct" (6.7.14's D24 (a)), `var t: P2 =
# *fncall0(&gp);` bound a handle to G's first field (SIGSEGV) and `l = fncall0(&gp)`, `o.s = fncall0(&gp)`, `m =
# *fncall0(&gp)` stored the pointer word into the first field. The struct of the call at token `b`: fn `f`'s `*T`
# (`_hl_icp` 1), else its struct by value; 0 for a callee held in a variable (6.7.11's D31: a word). CHANGELOG [6.7.16]
var _hl_icp = 0;
fn _hl_ic_psid(S, b): i64 {
    _hl_icp = 0;
    var fi = _hl_ic_fi(S, b);
    if (fi < 0) { return 0; }
    var t = _hl_fn_psid(fi);
    if (t > 0) {
        _hl_icp = 1;
        return t;
    }
    return GFRS(S, fi);
}
# The fn of the call through fncallN / callptr at token `b` when its callee is `&f` (`_icall_fti`) and `f` resolves to
# that fn as the `&` factor resolves it (no local, capture or global of the name), else -1.
fn _hl_ic_fi(S, b): i64 {
    var f = _icall_fti(S, b);
    if (f < 0) { return 0 - 1; }
    var noff = TOKVAL(S, f);
    if (GINFN(S) == 1) {
        if (FINDLOCAL(S, noff) >= 0) { return 0 - 1; }
        if (_hl_capn(S, noff) == 1) { return 0 - 1; }
    }
    if (_findvar_core(S, noff) >= 0) { return 0 - 1; }
    return FINDFN(S, noff);
}
# ⛔ 6.7.11 — A GENERIC CALL DECLARED `: *T` IS A STRUCT SOURCE, as `fn gp(): *S` is (6.7.10): `l = gpg<S>()`
# stored the pointer word, `*gpg<S>()` as a value faulted and `gpg<S>().v` was refused, because the chain
# typer skipped a generic call and its instance recorded T's step but not its struct (issues/2026-10-13-
# generic-pointer-returning-call-as-struct-source.md). The struct the call at token `b` (`g<..>(` or `g(`,
# its `(` at `o`, `fi` the base) points at: the base's return annotation read under the binding the call
# instantiates with — its explicit type arguments, or those its arguments infer, as `_gen_resolve_call`
# computes them — WITHOUT instantiating (a typer runs before the call is parsed, and in pass 1); the
# instance records the same struct (`_ret_ptr_record`). 0 = none: a scalar binding, a return that is no
# `*T`. CHANGELOG [6.7.11]
fn _gen_call_psid(S, b, o, fi): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    var ann = _gen_ret_ann(S, fi);
    if (ann < 0) { return 0; }
    _gen_call_targs(S, b, o, fi);
    return _gen_ann_bound(S, fi, ann, _gct_c0, _gct_c1);
}
# The binding the call at token `b` (its `(` at `o`, `fi` the base) instantiates with — its explicit type arguments,
# or those its arguments infer — into `_gct_c0` / `_gct_c1`. Shared by the two readers of a generic call's `: *T`.
var _gct_c0 = 0;
var _gct_c1 = 0;
fn _gen_call_targs(S, b, o, fi): i64 {
    _gct_c0 = 0 - 8;
    _gct_c1 = 0;
    if (o != b + 1) {
        var sv = GTI(S);
        var sv_gt = _ta_pending_gt;
        _ta_pending_gt = 0;
        STI(S, b + 2);
        var sv_xq = _ta_xq;
        _ta_xq = 1;   # 6.7.16 (D5): the call's own parse reports the list
        _gct_c0 = _parse_one_type_arg(S);
        _gct_c1 = _ta_rest_f(S, fi);
        _ta_xq = sv_xq;
        _ta_pending_gt = sv_gt;
        STI(S, sv);
    } else {
        var sg = _gi_sc;
        _gi_sc = 0;
        _gct_c0 = _gen_infer_tp(S, fi, o, 0);
        _gct_c1 = _gen_infer_tp(S, fi, o, 1);
        _gi_sc = sg;
    }
    return 0;
}
# 6.7.14 — the step word of that call's `: *T` / `: **T` return under the binding it instantiates with (`_pp_word_at`:
# a `**T`'s pin names its pointee), as its instance records it; 0 for any other return. `_hl_cw`'s generic call, so
# `**gq<P>()` of a `: **S` is the struct value too. CHANGELOG [6.7.14]
fn _gen_call_word(S, b, o, fi): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    var ann = _gen_ret_ann(S, fi);
    if (ann < 0) { return 0; }
    _gen_call_targs(S, b, o, fi);
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _bind_generic_call(S, fi, _gct_c0, _gct_c1);
    var w = _pp_word_at(S, ann, 0 - 1, 0 - 1);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return w;
}
# The struct the `*T` annotation at `ann` names with fn `fi`'s type parameters bound to `c0` / `c1` (the
# binding in force put back after).
fn _gen_ann_bound(S, fi, ann, c0, c1): i64 {
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _bind_generic_call(S, fi, c0, c1);
    var sid = _ptr_ann_sid_tp(S, ann);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return sid;
}
# The `*` of generic fn `fi`'s `): *T` return annotation, else -1.
fn _gen_ret_ann(S, fi): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0 - 1; }
    var c = _call_close(S, o);
    if (TOKTYP(S, c + 1) != 49) { return 0 - 1; }
    if (TOKTYP(S, c + 2) != 8) { return 0 - 1; }
    return c + 2;
}
# The struct name `noff` holds (`_hl_cp` 1: a `*T`, T returned), else 0: a local or a closure capture in a
# fn (a struct-typed slot, inline, a handle or a `*T`), else a global (a `*T` one, or a struct global).
fn _hl_name_ty(S, noff): i64 {
    _hl_cp = 0;
    var t = 0;
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) {
            t = GLTYPE(S, li);
            if (t >= 0) { return 0; }
            if (t <= 0 - 2048) { return 0; }
            _hl_cp = GLPTRP(S, li);
            return 0 - t;
        }
        if (_hl_capn(S, noff) == 1) {
            var esl = _cl_snap_find(S, noff);
            t = _cl_snap_type(esl);
            if (t >= 0) { return 0; }
            if (t <= 0 - 2048) { return 0; }
            _hl_cp = _cl_snap_ptrp(esl);
            return 0 - t;
        }
    }
    var gvi = _findvar_core(S, noff);
    if (gvi < 0) { return 0; }
    var ps = _gv_ptr_sid(S, gvi);
    if (ps > 0) {
        _hl_cp = 1;
        return ps;
    }
    if (GVPM(S, gvi) == 0) { return 0; }
    t = GVTYPE(S, gvi);
    if (t <= 0) { return 0; }
    if (t >= 2048) { return 0; }
    return t;
}
# The replay of a declaration-zone `var G: T = <* E>;` other than `* IDENT` (`_gz_star_init`'s general
# arm), cursor on the initialiser: over 8 B copied through E into the inline G pass 1 registered
# (`_gci_inline` asked `_gz_star`), the cursor on the `;` (1); 8 B or less, the value store copies its word
# (0). A `*U` of another struct is refused by name; a dereference pass 1 could not type (a `*T` global or
# fn declared below G) is refused by name, as a whole source declared below is (`_gci_below`).
# 6.7.16 (D17 (a)): `*pp` of a `**S` (`_hl_dstar_x`'s mode 1) is copied through the `*S` it reads at EVERY size — the
# value store would keep that pointer word (a handle). CHANGELOG [6.7.16]
# 6.7.16: and 8 B or less, a dereference reading a global a later entry stores (`_gvr_below`: `(*GP8)`, `*GPP8`) is
# refused the same way — it read address 0 at startup. CHANGELOG [6.7.16]
fn _gz_dx_init(S, dgv, gps, dnoff): i64 {
    var ps = _hl_dstar_x(S, GTI(S), 5, 1);
    if (ps <= 0) { return 0; }
    var dpp = _hl_dpp;
    if (_agg_dx_err(S, gps, 0 - ps, dnoff) == 1) { return 0; }
    var sid = 0 - gps;
    if (dgv < 0) { return 0; }
    if (STRUCTSZ(S, sid - 1) <= 8) {
        if (_gvr_below(S, GTI(S), dnoff) == 1) { return _gz_dx_below(S, dnoff); }
        if (dpp == 0) { return 0; }
    }
    _hl_dpp = dpp;
    if (GVPM(S, dgv) != 2) { return _gz_dx_below(S, dnoff); }
    var h = _hl_dx_src(S);
    _agc_copy_bytes(S, 0 - 1, dgv, 0 - 1, 0 - 1000 - (0 - 2 - h), STRUCTSZ(S, sid - 1));
    _gv_slvar(S, dgv);
    return 1;
}
# `_gz_dx_init`'s refusal: the dereference reads a global or fn declared below G (`_hl_dnm`, its operand's last name),
# the cursor left on the `;`. 1.
fn _gz_dx_below(S, dnoff): i64 {
    ERR_IDENT(S, "cannot copy-init ", dnoff,
      " from a dereference of a global or fn declared below it (declare it first): ", _hl_dnm);
    while (PEEKT(S) != 5) { STI(S, GTI(S) + 1); }
    return 1;
}
