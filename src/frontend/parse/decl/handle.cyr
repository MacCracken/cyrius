# so `mkg1(30 + 3)`, `mkg1(-3)`, `mkg1(1.5)`, `mkg1(sc())`, `mkg1(&n)` and `mkc(BX)` with `BX: Box<i32>` bind what the
# replay's call binds (they bound nothing: `x.v` was "no struct type in scope for 'x'" in the zone and worked after
# the first statement). No fn instance is made here (`_gu_noinst`; a fn body compiled now would read the zone's
# layouts before they are judged): a binding only an instance answers is a miss (`_gu_miss`) — the global stays
# untyped, as before — as is a tuple (the call refuses itself). No local is in scope (as at the replay). `_gi_sc` is
# marked as `_gen_infer_tp` marks it. CHANGELOG [6.7.16]
var _gu_noinst = 0;
var _gu_miss = 0;
fn _gu_tp(S, c, fi, w): i64 {
    var g = _gu_tpg(S, c, fi, w);   # 6.7.16: a carrying generic call is the instance it makes
    if (g > 0) { return g; }
    if (g < 0) { _gu_miss = 1; return 0 - 8; }
    var s = _tok_gen_tp_sid(S, c - 1, c - 1, c, fi, w);
    if (s > 0) { return s; }
    var sv = GTI(S);
    var lc = GFLC(S);
    var ni = _gu_noinst;
    _gu_noinst = 1;
    SFLC(S, 0);
    var r = _gu_tp_ic(S, c, fi, w);
    SFLC(S, lc);
    _gu_noinst = ni;
    STI(S, sv);
    if (_tup_is(S, r) == 1) { _gu_miss = 1; }
    if (r == 0 - 9) { _gi_sc = 1; }
    return r;
}
# ⛔ 6.7.16 — A CARRYING GENERIC CALL IS THE INSTANCE IT MAKES. Type parameter `w` of generic `fi` at the call whose name
# is token `c` (no explicit list), when its carrying argument is ONE whole generic call (inside any wrap): a `: G<..>`
# return is the instance that call makes (`_gu_gen` on its name token: the struct only, no fn instance), a `: T` one
# the struct its own carrier binds (recursively); -1 when it is such a call but the zone cannot read it (`_gu_miss`);
# 0 when it is no such call (the token reader's and the classifier's). The pair scans' reader (`_tok_init_sid`, shared
# with pass 2) typed the inner call by its BASE: `var x = mkg1(mkg1(P));` minted `G1$G1` where the replay's call returns
# `G1$G1$Pt`, and `var x = id(mkg1(P));` took `G1` for `G1$Pt` — refused "the declaration zone misread whether the
# initializer of 'x' is a struct value". CHANGELOG [6.7.16]
fn _gu_tpg(S, c, fi, w): i64 {
    if (TOKTYP(S, c + 1) == 19) { return 0; }
    _gen_stub(S, fi);
    var m = GFGM(S, fi);
    var pk = w + 1;
    if ((m & 4) != 0) { pk = (m >> (8 + w * 8)) & 255; }
    if (pk == 0) { return 0; }
    var a = _call_arg_for(S, fi, c + 1, pk - 1);
    if (a < 0) { return 0; }
    a = _ie_unparen(S, a, _arg_next(S, a));
    if (TOKTYP(S, a) != 2) { return 0; }
    var o = _gcall_open(S, a);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 != _ie_pe) { return 0; }
    var gi = FINDFN(S, TOKVAL(S, a));
    if (gi < 0) { return 0; }
    if (GFTP(S, gi) == 0) { return 0; }
    var r = GFRS(S, gi);
    if (_gz_gbase(S, r) == 1) { return _gu_cg(S, a, r); }
    if (r > 0) { return 0; }
    var w2 = _gen_ret_tp(S, gi);
    if (w2 < 0) { return 0; }
    return _gu_tpg(S, a, gi, w2);
}
# The instance the generic call at token `a` returning `: G<..>` (G = `g`) makes (`_gu_gen`), the zone reader's state
# put back (`_gz_gb`, `_gu_hdl`: an inner refused list reaches its base, the outer call's global is no handle for it);
# -1 = not read.
fn _gu_cg(S, a, g): i64 {
    var gb = _gz_gb;
    var hd = _gu_hdl;
    _gz_gb = g;
    var s = _gu_ok(S, _gu_gen(S, a));
    _gz_gb = gb;
    _gu_hdl = hd;
    if (s <= 0) { return 0 - 1; }
    return s;
}
# The zone sweep's `_gsc_call` (a struct carrier given a whole call at token `a`): a generic callee's return read as the
# classifier reads it (`_gu_ircs`, nothing instanced) — a `: G<..>` the instance the call makes, a `: T` its binding, a
# fixed return itself. `mkc(mkbx(33))` / `mkc(mkbx<i32>(33))` with `fn mkbx<T>(v: T): Box<T>`, and `mkc(mkbf(P))` with
# `fn mkbf<T>(v: T): Box<i32>`, were a miss (the global untyped, `x.v`: "no struct type in scope for 'x'"); a call the
# zone cannot read is still one (`_gu_miss`). A `: *S` callee keeps its path. 1 = answered, the struct (or 0) in
# `_gu_gsc_s`; 0 = not such a call. CHANGELOG [6.7.16]
var _gu_gsc_s = 0;
fn _gu_gsc(S, a): i64 {
    var fi = FINDFN(S, TOKVAL(S, a));
    if (fi < 0) { return 0; }
    if (GFTP(S, fi) == 0) { return 0; }
    if (_fn_rpsid != 0) { if (L64(_fn_rpsid + fi * 8) > 0) { return 0; } }
    var sv = GTI(S);
    STI(S, a);
    var r = _gu_ircs(S, fi, GFRS(S, fi), 0);
    STI(S, sv);
    _gu_gsc_s = 0;
    if (r > 0) { if (r < 2048) { _gu_gsc_s = r; } }
    return 1;
}
fn _gu_tp_ic(S, c, fi, w): i64 {
    var m = GFGM(S, fi);
    var pk = w + 1;
    if ((m & 4) != 0) { pk = (m >> (8 + w * 8)) & 255; }
    if (pk == 0) { return _gen_infer_ind(S, fi, c + 1, w, 0); }
    var a = _call_arg_for(S, fi, c + 1, pk - 1);
    if (a < 0) { return 0 - 8; }
    return _ic_arg(S, fi, a, pk);
}
# `_ic_call_rs` at the sweep: what the GENERIC call at the cursor (fi its base, `r` its return) returns, with no instance
# made — a `: T` return is T's binding at this call when that is a struct or f64 (the instance's, `_gtype_tp_ret`), else
# `r`; a `: G<..>` return the instance the call makes (`_gu_icg`), a pointer carrier a miss. CHANGELOG [6.7.16]
fn _gu_ircs(S, fi, r, ptr): i64 {
    if (ptr == 1) { _gu_miss = 1; return r; }
    var w = _gen_ret_tp(S, fi);
    if (w < 0) {
        if (_gz_gbase(S, r) == 1) { return _gu_icg(S, r); }
        return r;
    }
    var c = GTI(S);
    var sc = _gi_sc;
    var b = 0 - 8;
    if (TOKTYP(S, c + 1) == 19) {
        if (_gu_xlist(S, c, fi) == 0) { _gu_miss = 1; }
        elif (w == 1) { b = _gu_x1; }
        else { b = _gu_x0; }
    } else { b = _gu_tp(S, c, fi, w); }
    _gi_sc = sc;
    if (b > 0) { return b; }
    if (b == 0 - 9) { return b; }
    return r;
}
# `_gu_ircs`'s `: G<..>` return (G = `r`, the cursor on the call's name): the instance the call makes (`_gu_cg`), as
# the replay's call returns it (6.7.16: it was a miss); a call the zone cannot read is still one. CHANGELOG [6.7.16]
fn _gu_icg(S, r): i64 {
    var s = _gu_cg(S, GTI(S), r);
    if (s > 0) { return s; }
    _gu_miss = 1;
    return r;
}
# The struct generic `fi`'s return `: G<..>` (`_gz_gb` G) names under the binding (c0, c1), read by `_gtype_sid` as
# PARSE_FN_DEF reads an instance's return — `G$..` minted and deduped by name, so the instance the replay's call makes
# returns this same struct. Only a list of plain names. 0 = none.
# 6.7.16: a G with bounds too (`struct G1<T: Show>`), its bound judged quietly (`_bnd_quiet`): the call's own instance
# judges it, once; a failing one keeps the base G, as `_ret_targ_parse` does for that instance. CHANGELOG [6.7.16]
fn _gu_inst(S, fi, c0, c1): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    var rc = _tok_close_paren(S, o);
    if (rc < 0) { return 0; }
    if (TOKTYP(S, rc + 1) != 49) { return 0; }
    var n = rc + 2;
    if (TOKTYP(S, n) != 2) { return 0; }
    if (FINDSTRUCT(S, TOKVAL(S, n)) != _gz_gb) { return 0; }
    if (_gu_plain(S, n + 1) == 0) { return 0; }
    var sv = GTI(S);
    var s0 = _inst_conc0;
    var s1 = _inst_conc1;
    var q = _bnd_quiet;
    var qh = _bnd_quiet_hit;
    _bnd_quiet = 1;
    _inst_conc0 = c0;
    _inst_conc1 = c1;
    STI(S, n);
    var r = _gtype_sid(S, fi, _gz_gb);
    _inst_conc0 = s0;
    _inst_conc1 = s1;
    _bnd_quiet = q;
    _bnd_quiet_hit = qh;
    STI(S, sv);
    return r;
}
# 1 = the tokens from `i` are `< NAME >` or `< NAME , NAME >`.
fn _gu_plain(S, i): i64 {
    if (TOKTYP(S, i) != 19) { return 0; }
    if (TOKTYP(S, i + 1) != 2) { return 0; }
    if (TOKTYP(S, i + 2) == 20) { return 1; }
    if (TOKTYP(S, i + 2) != 31) { return 0; }
    if (TOKTYP(S, i + 3) != 2) { return 0; }
    if (TOKTYP(S, i + 4) == 20) { return 1; }
    return 0;
}
fn _gu_type(S, gvi, sid): i64 {
    SVTYPE(S, gvi, sid);
    if (STRUCTSZ(S, sid - 1) > 8) { SVPM(S, gvi, 1); return 0; }
    SVPM(S, gvi, 2);
    return 0;
}
# 6.7.15 — after the end of pass 1's handle-line walk (`_gz_sweep`): a method / operator verdict read before it can name
# a struct the walk took back (an operator whose left operand the walk made a handle: pointer arithmetic, no dispatch).
# Each typed global's initialiser is read again; one that no longer gives its struct is untyped as it was registered.
# 1 = something changed (the walk runs again).
fn _gu_recheck(S): i64 {
    if (_gu_v == 0) { return 0; }
    var ch = 0;
    var n = vec_len(_gu_v);
    var i = 0;
    while (i < n) {
        var sid = vec_get(_gu_v, i + 2);
        if (sid > 0) { if (_gu_zsid(S, vec_get(_gu_v, i + 1)) != sid) {
                SVTYPE(S, vec_get(_gu_v, i), 0);
                SVPM(S, vec_get(_gu_v, i), 0);
                vec_set(_gu_v, i + 2, 0);
                ch = 1;
            } }
        i = i + 3;
    }
    return ch;
}
# 6.7.15 — an untyped zone global the sweep made an inline struct (its initialiser token `ti`): `0 - sid`, so the
# replay checks that verdict as an annotated global's (`_gz_agree`: a disagreement is refused by name, never stored
# into the other layout); else 0.
fn _gu_agps(S, gvi, ti): i64 {
    if (_gu_v == 0) { return 0; }
    if (GVPM(S, gvi) != 2) { return 0; }
    var i = _gu_find(ti);
    if (i < 0) { return 0; }
    var sid = vec_get(_gu_v, i + 2);
    if (sid <= 0) { return 0; }
    if (GVTYPE(S, gvi) != sid) { return 0; }
    return 0 - sid;
}
# The `_gu_v` triple whose initialiser token is `ti` (its index; -1 none). The replay asks once per zone global, so a
# scan per ask made the zone quadratic in its struct-call globals: the notes are in token order, so it bisects (a scan
# if one ever was not). CHANGELOG [6.7.15]
fn _gu_find(ti): i64 {
    if (_gu_uo == 1) { return _gu_scan(ti); }
    var lo = 0;
    var hi = vec_len(_gu_v) / 3;
    while (lo < hi) {
        var mid = (lo + hi) >> 1;
        var t = vec_get(_gu_v, mid * 3 + 1);
        if (t == ti) { return mid * 3; }
        if (t < ti) { lo = mid + 1; } else { hi = mid; }
    }
    return 0 - 1;
}
fn _gu_scan(ti): i64 {
    var n = vec_len(_gu_v);
    var i = 0;
    while (i < n) {
        if (vec_get(_gu_v, i + 1) == ti) { return i; }
        i = i + 3;
    }
    return 0 - 1;
}
# ⛔ 6.7.10 (B7-1g) — 1 = global `gvi` is a struct HANDLE of 8 B or less (GVPM 1, a struct type). No
# global was one before the handle line (every struct global of 8 B or less was inline), so each
# consumer arm keyed on it is inert on a program without one.
fn _small_ghdl(S, gvi): i64 {
    if (gvi < 0) { return 0; }
    if (GVPM(S, gvi) != 1) { return 0; }
    var t = GVTYPE(S, gvi);
    if (t <= 0) { return 0; }
    if (t >= 2048) { return 0; }
    if (STRUCTSZ(S, t - 1) > 8) { return 0; }
    return 1;
}
# rax = the struct a handle global `gvi` (struct `sid`, 8 B or less) points at: one load of 1 / 2 / 4 / 8
# bytes, else (3, 5, 6, 7) a byte-exact copy into a temp — a frame temp in a fn, a hidden global at top
# level, where there is no frame — whose word is loaded: no byte past the object is read.
fn _hg_val_ra(S, gvi, sid): i64 {
    var sz = STRUCTSZ(S, sid - 1);
    if (_hl_wpow(sz) == 1) {
        EVLOAD(S, gvi);
        EMOVCA(S);
        EFIELD_LOAD_W(S, sz);
        return 0;
    }
    var tl = 0 - 1;
    var tg = 0 - 1;
    if (GINFN(S) == 1) { tl = _agg_temp(S, sid); }
    else { tg = _hl_gtemp(S); }
    _agc_copy_bytes(S, tl, tg, 0 - 1, 0 - 1000 - gvi, sz);
    if (tl >= 0) { EFLLOAD(S, tl); }
    else { EVLOAD(S, tg); }
    return 0;
}
# A hidden 8-byte global (zero, dead to every lookup): a struct temp at top level (`_HTEMP`'s top arm).
fn _hl_gtemp(S): i64 {
    var h = _HTEMP(S);
    return 0 - 2 - h;
}
# 1 = `noff` names a closure CAPTURE here (an enclosing local the snapshot holds), never a global.
fn _hl_capn(S, noff): i64 {
    if (_cl_capturing != 1) { return 0; }
    if (_cl_env_lidx < 0) { return 0; }
    if (_cl_snap_find(S, noff) < 0) { return 0; }
    return 1;
}
# `_hl_bare_val`'s global arm: a bare name `noff` (no local, no capture) that is a handle global of 8 B
# or less — rax becomes its struct (`_hg_val_ra`). 1 = done.
fn _hl_gbare(S, noff): i64 {
    var gvi = _findvar_core(S, noff);
    if (_small_ghdl(S, gvi) == 0) { return 0; }
    _hg_val_ra(S, gvi, GVTYPE(S, gvi));
    return 1;
}
# `return G;` / `return (G);` (`k` parentheses) with G a handle global of 8 B or less and no local of
# that name: its struct, as a handle local's (`_ret_small_ptrp`). Consumes `IDENT ;` and the wrap and
# jumps to the epilogue (1); 0 leaves the cursor alone.
fn _ret_small_gh(S, k): i64 {
    var nm = TOKVAL(S, GTI(S) + k);
    if (_hl_capn(S, nm) == 1) { return 0; }
    var gvi = _findvar_core(S, nm);
    if (_small_ghdl(S, gvi) == 0) { return 0; }
    if (GVTYPE(S, gvi) != _cur_fn_ret_sid) { return 0; }   # 6.7.11: refused by name (`_ret_small_val`)
    STI(S, GTI(S) + 2 + 2 * k);           # IDENT ; and the wrap
    _hg_val_ra(S, gvi, GVTYPE(S, gvi));
    var rp = EJMP0(S);
    vec_push(rp_vec, rp);
    return 1;
}
# ⛔ 6.7.10 (B7-1g) — `var G: T = *p;` with `p` a `*T` global: `*p` is a struct VALUE (the user's
# decision 6, 2026-10-12), copied at every size, as a local's is (B7-1). Over 8 B the global was a
# handle holding the word `*p` read, and the first `G.a = 9` SIGSEGV'd. `* IDENT` at token `b`, IDENT a
# `*T` global: its slot (FINDVAR: the visibility check) when T is the declared struct; a `*U` of
# another struct is refused by name (-1), as a U struct value is; -1 for anything else.
fn _gz_star_src(S, b, pscale, dnoff): i64 {
    if (_sci_star(S, b) == 0) { return 0 - 1; }
    var ps = _gz_pg(S, b);
    if (ps <= 0) { return 0 - 1; }
    if (_agg_span_err(S, pscale, 0 - ps, dnoff, b, b + 2, TOKVAL(S, b + 1)) == 1) { return 0 - 1; }   # 6.7.16: '*p'
    var pg = FINDVAR(S, TOKVAL(S, b + 1));
    return pg;
}
# The replay of `var G: T = *p;` (cursor on the `*`): over 8 B copied through p into the inline G pass
# 1 registered (`_gci_inline`), the cursor left on the `;` (1); 8 B or less, the value store copies
# its word (0). A p pass 1 could not see (declared below G) is refused, as `_gci_below` refuses a
# whole source declared below — and 8 B or less a p a later entry stores (`_gvr_below`, 6.7.16).
fn _gz_star_init(S, dgv, gps, dnoff): i64 {
