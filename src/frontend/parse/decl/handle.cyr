# `_hl_dk` = the parentheses around it; `_hl_dnm` = the operand's last name, for a refusal.
var _hl_dk = 0;
var _hl_dnm = 0;
var _hl_dna = 0 - 1;   # 6.7.16: the `*` of the dereference `_hl_dstar_x` typed last (-1: `_hl_dnm` is `_hl_psrc`'s)
var _hl_dne = 0 - 1;   # ... and the token after its operand
var _hl_psa = 0 - 1;   # 6.7.16: the span [_hl_psa, _hl_pse) a `*T` source `_hl_psrc` typed last is named by (`_hl_pspan`)
var _hl_pse = 0 - 1;
# `_hl_dstar_x` with no `**S` arm, for a source that ends at `term` (6.7.11: an assignment's — its `;`, or the `)` of
# a for step or of the parentheses wrapping it, `_hl_dx_end`). A declaration's initialiser asks `_hl_dstar_x(S, ti, 5,
# 1)` itself (6.7.16, D17 (a): its `*pp` of a `**S` copies at top level too). CHANGELOG [6.7.16]
fn _hl_dstar_t(S, ti, term): i64 { return _hl_dstar_x(S, ti, term, 0); }
# ⛔ 6.7.15 — `*pp` OF A `**S` IS A `*S` AS A WHOLE COPY SOURCE TOO: with `pp` 1 this also answers a dereference whose
# operand is a `**S` (`*pp` the `*S` 6.7.13's D9 (a) made it, `_hl_dref_psid`), `_hl_dpp` 1 — its copy goes through
# the struct `*pp` points at, as the `*S`-name twin's (`l = p`, `var t: S = p;`) does. Asked by the assignment
