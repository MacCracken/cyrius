# PARSER — decl: the handle line — small struct handles (`_hl_*`), the declaration zone's struct, untyped and f64
# globals (`_gz_*`, `_gu_*`, `_gzf_*`), a dereference as a struct value.
# ================================================================
# Split from parse/decl.cyr at 6.7.18, unchanged; parse.cyr includes parse/decl/ in source order. CHANGELOG [6.7.18]

# PARSE_ASSIGN removed v5.5.40 closeout — assignment is handled inline
# by PARSE_STMT's expression path (assignment-as-expression). The fn
# was orphaned across every main_*.cyr entry point per the DCE audit.

# ⛔ 6.7.10 (B7-1) — THE HANDLE LINE (the user's decision, 2026-10-12): a struct local of 8 B or less
# initialised from anything that is not a struct value of its type is a HANDLE, as one over 8 B is —
# its slot holds the address, `q.v = 5` writes the object, and every consumer that takes its struct
# (a by-value argument, `return q`, an operator's right operand, an if-expression branch, a copy)
# copies through it. It used to be marked inline whatever the initialiser, so `var q: S8 = alloc(8);`
# (or `= &s`, `= gp()` with `fn gp(): *S8`) held the ADDRESS as q.v and its writes never reached the
# object. Marked inline (MARK_SMALL_STRUCT, unchanged) only for a struct value: a name source that
# `_try_struct_copy_init` let through (`_sci_sval`: an inline local, a by-value parameter, a value
# global, a captured struct's words), a whole method / operator / if-expression / dyn-call result
# (`_sc_whole` -3), or a whole free or generic call returning the type (`_hl_call_whole`). A literal,
# a field, `*p` and a `*T` name take their own copy paths and never reach here. CHANGELOG [6.7.10]
fn _mark_small_init(S, li, start): i64 {
    var sv = _sci_sval;
    _sci_sval = 0;
    var t = GLTYPE(S, li);
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }
    var sid = 0 - t;
    if (STRUCTSZ(S, sid - 1) > 8) { return 0; }
    if (sv == 0) { if (_hl_sval(S, start, sid) == 0) { return 0; } }
    MARK_SMALL_STRUCT(S, li, t);
    return 0;
}
# 1 = the initialiser [start, cursor) is a whole struct-valued call of struct `sid`: a method,
# operator, if-expression or dyn call (the -3 record), or a free / generic call (`_hl_call_whole`).
fn _hl_sval(S, start, sid): i64 {
    if (_sc_whole(S, start) == 0 - 3) { if (_sc_sid == sid) { return 1; } }
    return _hl_call_whole(S, start, sid);
}
# 1 = [start, cursor) is one whole free or generic call (inside any wrap) of a fn returning struct
# `sid` by value — a free call records no -3 (a `: *T` call is a handle: its return is not `sid`).
# Resolved after the parse, a dedup hit, as `_sarg_byval_small` resolves its argument.
fn _hl_call_whole(S, start, sid): i64 {
    var k = _pwrap_k(S, start);
    var c = start + k;
    var o = _gcall_open(S, c);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 + k != GTI(S)) { return 0; }
    var fi = _gen_resolve_call(S, c);
    if (fi < 0) { return 0; }
    if (_grc_err < 0) { return 0; }
    if (GFRS(S, fi) != sid) { return 0; }
    return 1;
}
# ⛔ 6.7.10 (B7-1) — `var q: T = *p;` with `p: *T`: `*p` is a struct VALUE (the user's decision,
# 2026-10-12) and is copied through p at every size, as `var q: T = p;` is (6.7.0). Over 8 B the
# scalar init bound q as a handle holding the word `*p` read (the first field), and the first `q.a = 9`
# SIGSEGV'd. 1 = the initialiser at token `ti` is `* IDENT ;`.
fn _sci_star(S, ti): i64 {
    if (TOKTYP(S, ti) != 8) { return 0; }
    if (TOKTYP(S, ti + 1) != 2) { return 0; }
    if (TOKTYP(S, ti + 2) != 5) { return 0; }
    return 1;
}
# ⛔ 6.7.17 (D12, the user's decision, 2026-10-22) — A POINTER OF ANOTHER DEPTH INTO A STRUCT DECLARATION IS REFUSED BY
# NAME. `var g: P3 = pp;` with `pp: **P3` copied 24 bytes through pp's `*P3` slot (g.x was s's address, the rest read
# past the slot), in a fn and at top level (the zone and after the first statement), as did a `**P3` parameter,
# global, capture, field, `: **P3` call, `pp + n` and `*ppp` of a `***P3`: no decision makes a `**T` name a struct
# value (6.7.10's handle line makes a `*T` one; 6.7.16's D17 (a) makes `*pp` one). The initialiser at token `b`, up
# to its `;`, one whole pointer whose pointee is itself a pointer to a struct (`_hl_pw`'s pin, `_pps_of_pin`), into
# a struct `pscale`: "cannot copy 'pp' into a variable of a different struct/vector type: 'g'", named as spelled
# inside any parentheses. `= *pp` (a copy) and `= ps` are unchanged. 1 = refused. CHANGELOG [6.7.17]
fn _sci_ppsrc(S, b, dnoff, pscale): i64 {
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    var e = _gz_end(S, b);
    var w = _hl_pw(S, b, e);
    if (_ps_pinned(w) == 0) { return 0; }
    if (_pps_of_pin(S, _ps_pin(w)) <= 0) { return 0; }
    var a = _ie_unparen(S, b, e);
    var pe = _ie_pe;
    ERR_IDENT(S, "cannot copy ", _src_span_nm(S, a, pe, TOKVAL(S, pe - 1)),
      " into a variable of a different struct/vector type: ", dnoff);
    return 1;
}
# A local source of another struct, the name at token `ti` (`dr` 1: after a `*`, `var q: T = *p;`) — refused by name
# (`_AGG_ASSIGN_TYPE_ERR`); a dereference is named from its `*`, as the source spells it ('*p'; it was 'p', 6.7.16).
fn _sci_lsrc_err(S, td, ts, dnoff, ti, dr): i64 {
    if (dr == 0) { return _AGG_ASSIGN_TYPE_ERR(S, td, ts, dnoff, TOKVAL(S, ti)); }
    return _agg_span_err(S, td, ts, dnoff, ti - 1, ti + 1, TOKVAL(S, ti));
}
# `*p` with `p` a closure capture: 1 = a captured `*T` of the declared type (copied through the
# word it captured, `_CL_CAP_BASE_RA`); 2 = anything else (the scalar init, as before). A `*U` of
# another struct is refused by name, as `var q: T = p;` refuses it.
fn _sci_cap_deref(S, snoff, dnoff, pscale): i64 {
    var t = _fsc_cap_src(S, snoff);
    if (t == 0) { return 0; }
    if (_cl_snap_ptrp(_cl_snap_find(S, snoff)) == 0) { return 2; }
    if (t != pscale) { _agg_span_err(S, pscale, t, dnoff, GTI(S) + 1, GTI(S) + 3, snoff); return 2; }   # 6.7.16: '*p'
    return 1;
}
# `*G` with `G` a global that is not a `*T` of the declared type: a `*U` of another struct is refused
# by name; anything else (an untyped word) is the scalar init's. Returns 0.
fn _sci_gderef_err(S, snoff, dnoff, pscale): i64 {
    var gvi = FINDVAR(S, snoff);
    if (gvi < 0) { return 0; }
    var ps = _gv_ptr_sid(S, gvi);
    if (ps <= 0) { return 0; }
    _agg_span_err(S, pscale, 0 - ps, dnoff, GTI(S) + 1, GTI(S) + 3, snoff);   # 6.7.16: '*G', the `*` after the `=`
    return 0;
}
# ⛔ 6.7.10 (B7-1) — 1 = local `li` is a HANDLE of 8 B or less (the handle line, `_mark_small_init`):
# a struct-typed local of this fn that is not inline, not a `*T` and not a parameter (a by-value
# one of 8 B or less is inline, MARK_SMALL_STRUCT at the parameter). Nothing answered 1 before the
# handle line — every such local was marked inline — so each consumer arm keyed on it is inert on a
# program without one. CHANGELOG [6.7.10]
fn _small_hdl(S, li): i64 {
    if (li < 0) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    if (li < _cur_fn_pslots) { return 0; }
    if (GLAGG(S, li) != 0) { return 0; }
    if (GLPTRP(S, li) == 1) { return 0; }
    var t = GLTYPE(S, li);
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }
    if (STRUCTSZ(S, (0 - t) - 1) > 8) { return 0; }
    return 1;
}
# ⛔ 6.7.10 (B7-1c) — STRUCT COPIES ARE SIZE-INDEPENDENT (the user's decision 6, 2026-10-12): `l = p` /
# `G = p` with `p: *S` copy the struct p points at, and `q = r` through `q: *S` copies r into the
# pointee, at every size — as over 8 B, where a `*T` local or parameter is a copy-assign HANDLE
# (`_agc_plain_big`). One of 8 B or less was not an operand at all, so `l = p` stored the POINTER into
# `l.v` and `q = r` rebound q to r's word (S3). 1 = local `li` is a `*T` (a local or a parameter) of a
# struct of 8 B or less; `_agc_handle_local` answers it as a handle, one slot. CHANGELOG [6.7.10]
fn _small_sptr(S, li): i64 {
    if (li < 0) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    if (GLAGG(S, li) != 0) { return 0; }
    if (GLPTRP(S, li) != 1) { return 0; }
    var t = GLTYPE(S, li);
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }
    if (STRUCTSZ(S, (0 - t) - 1) > 8) { return 0; }
    return 1;
}
# 1 = a load of `sz` bytes is one instruction (1, 2, 4, 8).
fn _hl_wpow(sz): i64 {
    if (sz == 1 || sz == 2 || sz == 4 || sz == 8) { return 1; }
    return 0;
}
# rax = the STRUCT a handle of 8 B or less points at (`li` a local, struct `sid`), as a by-value
# consumer takes a struct of that class: one load of 1 / 2 / 4 / 8 bytes, else (3, 5, 6, 7) a
# byte-exact copy into a frame temp whose slot is loaded — no byte past the object is read.
fn _hdl_val_ra(S, li, sid): i64 {
    var sz = STRUCTSZ(S, sid - 1);
    if (_hl_wpow(sz) == 1) {
        EFLLOAD(S, li);
        EMOVCA(S);
        EFIELD_LOAD_W(S, sz);
        return 0;
    }
    EFLLOAD(S, _sptr_param_temp(S, li, sid));
    return 0;
}
# Inside a closure: the struct a CAPTURED name `noff` is a handle of, 8 B or less (its enclosing slot
# one word, not inline, not a `*T`), else 0. Its one captured word is the address (`_CL_CAP_BASE_RA`).
fn _hl_cap_hdl(S, noff): i64 { return _hl_cap_word(S, noff, 0); }
# 1 = a captured name's one word is the address of a struct of 8 B or less: a handle, or (6.7.10,
# B7-1c) a `*T` — a copy-assign source the copy goes through, as over 8 B (`_hl_small_copy`).
fn _hl_cap_addr(S, noff): i64 {
    if (_hl_cap_word(S, noff, 0) > 0) { return 1; }
    if (_hl_cap_word(S, noff, 1) > 0) { return 1; }
    return 0;
}
# `_hl_cap_hdl`'s lookup; `ptrp` 1 asks for a captured `*T` instead of a handle.
fn _hl_cap_word(S, noff, ptrp): i64 {
    if (_cl_capturing != 1) { return 0; }
    if (_cl_env_lidx < 0) { return 0; }
    var esl = _cl_snap_find(S, noff);
    if (esl < 0) { return 0; }
    var capi = _cl_cap_find(esl);
    if (capi < 0) { return 0; }
    if (L64(&_cl_cap_w + capi * 8) != 1) { return 0; }
    if (_cl_snap_span(esl) != 0) { return 0; }
    if (_cl_snap_ptrp(esl) != ptrp) { return 0; }
    var t = _cl_snap_type(esl);
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }
    if (STRUCTSZ(S, (0 - t) - 1) > 8) { return 0; }
    return 0 - t;
}
# rax = the struct a captured handle `noff` (struct `sid`, `_hl_cap_hdl`) points at; `_hdl_val_ra`'s
# two shapes, through the capture source record (`_fsc_cap_src`). The temp is zeroed first, as
# `_sptr_param_temp`'s is: its word's padding is 0. CHANGELOG [6.7.13]
fn _hl_cap_val_ra(S, noff, sid): i64 {
    var sz = STRUCTSZ(S, sid - 1);
    _fsc_cap_src(S, noff);
    if (_hl_wpow(sz) == 1) {
        _resolve_field_base_addr(S, _fsc_fidx, sid);
        EFIELD_LOAD_W(S, sz);
        return 0;
    }
    var t = _agg_temp(S, sid);
    EMOVI(S, 0);
    EFLSTORE(S, t);
    _agc_copy_bytes(S, t, 0 - 1, 0 - 2, 0 - 1, sz);
    EFLLOAD(S, t);
    return 0;
}
# The by-value consumers (an argument, a `return`, an operator's right operand, an if-expression
# branch): when the expression [b, e) just parsed is a bare name, inside any balanced parentheses,
# that is a handle of 8 B or less — a local or a closure capture — rax becomes its STRUCT (the parse
# left the handle's address there), as a struct over 8 B is taken through its handle. 1 = done.
# 6.7.10 (B7-1g): and a handle GLOBAL (`_hl_gbare`), inside a fn or at top level.
fn _hl_bare_val(S, b, e): i64 {
    var a = _ie_unparen(S, b, e);
    if (_ie_pe != a + 1) { return 0; }
    if (TOKTYP(S, a) != 2) { return 0; }
    var nm = TOKVAL(S, a);
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, nm);
        if (li >= 0) {
            if (_small_hdl(S, li) == 0) { return 0; }
            _hdl_val_ra(S, li, 0 - GLTYPE(S, li));
            return 1;
        }
        if (_hl_capn(S, nm) == 1) {
            var cs = _hl_cap_hdl(S, nm);
            if (cs <= 0) { return 0; }
            _hl_cap_val_ra(S, nm, cs);
            return 1;
        }
    }
    return _hl_gbare(S, nm);   # 6.7.10 (B7-1g): a handle global, in a fn or at top level
}
# 1 = parameter `k` of fn `fi` takes a struct of 8 B or less BY VALUE (one word, no struct-mask bit).
fn _hl_byval(S, fi, k): i64 {
    if (fi < 0) { return 0; }
    var ps = GFPSID(S, fi, k);
    if (ps <= 0) { return 0; }
    if (_pm_struct(fi, k) != 0) { return 0; }
    if (STRUCTSZ(S, ps - 1) > 8) { return 0; }
    return 1;
}
# ⛔ 6.7.10 (B7-1b) — A POINTER INTO A BY-VALUE STRUCT PARAMETER OF 8 B OR LESS PASSES THE STRUCT IT
# POINTS AT (the user's decision 7, 2026-10-12), as one over 8 B always did: that parameter is
# address-passed, so the pointer was the argument. A struct of 8 B or less travels in one word, and
# `bs1(sp)` (`sp: *S1`), `bs1(&s)`, a `*S1` parameter, a `: *S1` call, method or field, a `*S1`
# global or capture, `gw(wp)` into `w: W1<T>`, `bs1(sp + i)` and `s + sp` into an operator fn pushed
# the ADDRESS as that word — the callee read the pointer's bits as its fields, on every target, from
# 6.6.0 (issues/archived/2026-10-11-typed-pointer-into-small-byvalue-struct-param.md: 0 where 111 is right).
# An untyped value is not a pointer here: it is the struct's word, as before. `_hl_byval_arg` is the
# by-value argument's tail (`_sarg_byval_small`, `_op_rhs`), after the parse: a handle's struct
# (B7-1), else a pointer's. 1 = rax replaced. CHANGELOG [6.7.10]
fn _hl_byval_arg(S, fi, k, b, ps): i64 {
    if (_hl_bare_val(S, b, GTI(S)) == 1) { return 1; }
    if (_hl_parg(S, b, GTI(S), ps) == 0) { return 0; }
    _hl_pval_ra(S, GFPSID(S, fi, k));
    return 1;
}
# 1 = the argument [b, e) just parsed, its pointer step `ps` (GPSC after its parse), is a typed pointer
# or an address — a `*T` name, `&name` (a variable's: `&fn` has no step), a call / method / field
# declared `*T`, pointer arithmetic on one — by the compiler's own typing. Step 1 is ambiguous: an i8 /
# i16 / i32 local also reads with step 1 (`n + 2` adds 2, v6.3.34), so it is decided by `_hl_p1`.
fn _hl_parg(S, b, e, ps): i64 {
    if (_hl_ie_ptr(S, b, e) == 1) { return 1; }   # 6.7.11: an if-expression of pointers
    if (ps <= 0) { return 0; }
    if (ps > 1) { return 1; }
    if (GINFN(S) != 1) { return 1; }
    return _hl_p1(S, b, e);
}
# ⛔ 6.7.11 — AN IF-EXPRESSION WHOSE EVERY BRANCH IS A POINTER, by this same typing (`_hl_parg` on each
# branch, `_ie_kind`), is one as a by-value argument or right operand: its merged step word is 0 when the
# branches' steps differ (`_ps_merge`: `py` step 7 beside `&s` step 1, or `pz` step 4), so `t7(if (c == 1)
# { py } else { &s })` passed the address as the B7 (168 where 5 is right), and with one step 1 the whole
# range's narrow condition (`c: i32`) read it as a value. The merge word itself is unchanged (the
# `var r: *B7 = if ..` warning, `(if ..) - q`). `_ie_finish` records the if-expression that ended at this
# code pointer; [b, e), inside any parentheses, must be exactly it. Branches mixing a pointer and a value
# stay a value. CHANGELOG [6.7.11]
var _iep_beg = 0 - 1;   # the recorded if-expression's `if` token,
var _iep_end = 0 - 1;   #   the token after it,
var _iep_cp = 0 - 1;    #   and the code pointer at its end (-1: none)
fn _hl_ie_ptr(S, b, e): i64 {
    if (_iep_cp != GCP(S)) { return 0; }
    var a = _ie_unparen(S, b, e);
    if (a != _iep_beg) { return 0; }
    if (_ie_pe != _iep_end) { return 0; }
    return 1;
}
# Step 1 on [a, e): `+` / `-` keep their LEFT operand's step (`_add_word`), so the left side of the
# chain's last `+` / `-` carried it — but a `*T` struct pointer on the RIGHT of a `+` carries it (6.7.11,
# decision 1(b) extended: `n + pb` is that pointer whatever narrow local `n` is), and so does `&x` of a
# variable (6.7.14: `n + &x` is the pointer `&x + n` is); a primary that reads an
# i8 / i16 / i32 local (a bare name, an if-expression's branch) is a value, any other (`&s`, `pb`,
# `mk1p()`, `h.p` of a `*T` step 1) an address.
fn _hl_p1(S, a, e): i64 {
    a = _ie_unparen(S, a, e);
    e = _ie_pe;
    var k = _hl_addop(S, a, e);
    if (k > a) {
        k = _hl_lastop(S, k, e);
        if (_hl_rcarry(S, k, e) == 1) { return 1; }
        return _hl_p1(S, a, k);
    }
    while (a < e) {
        if (_hl_narrow_at(S, a) == 1) { return 0; }
        a = a + 1;
    }
    return 1;
}
# The last top-level `+` / `-` of [k, e), `k` the first (`_hl_addop`): the one applied last.
fn _hl_lastop(S, k, e): i64 {
    var n = _hl_addop(S, k + 1, e);
    while (n > k) {
        k = n;
        n = _hl_addop(S, k + 1, e);
    }
    return k;
}
# 1 = the operator at `k` is a `+` whose right operand [k + 1, e) is typed `*T` of a struct (`_hl_psid`),
# or is `&x` of a variable (`_hl_amp_var`, 6.7.14).
fn _hl_rcarry(S, k, e): i64 {
    var t = TOKTYP(S, k);
    if (t != 6) { if (t != 113) { return 0; } }
    if (_hl_psid(S, k + 1, e) > 0) { return 1; }
    return _hl_amp_var(S, k + 1, e);
}
# ⛔ 6.7.14 — `n + &x` IS THE POINTER `&x + n` IS (6.7.11, the user's decision of 2026-10-13, guide § Pointers)
# as a by-value argument too. 1 = [a, e), inside balanced parentheses, is exactly `& IDENT` naming a variable — a
# local or parameter, a closure capture, a global (`&f` of a fn has no step). The right-carry asked `_hl_psid`
# alone, which answers 0 for `&x`, so a narrow left `n` made `bs(n + &x)` a value: the callee read the address's
# bits as its struct (78 where 77 is right, every target). CHANGELOG [6.7.14]
fn _hl_amp_var(S, a, e): i64 {
    var b = _ie_unparen(S, a, e);
    if (TOKTYP(S, b) != 27) { return 0; }
    if (_ie_pe != b + 2) { return 0; }
    if (TOKTYP(S, b + 1) != 2) { return 0; }
    var nm = TOKVAL(S, b + 1);
    if (GINFN(S) == 1) {
        if (FINDLOCAL(S, nm) >= 0) { return 1; }
        if (_hl_capn(S, nm) == 1) { return 1; }
    }
    if (_findvar_core(S, nm) >= 0) { return 1; }
    return 0;
}
# The first `+` / `-` (`+%` / `-%` too) of [a, e) outside any bracket, past its first token, else -1.
fn _hl_addop(S, a, e): i64 {
    var d = 0;
    var i = a;
    while (i < e) {
        var t = TOKTYP(S, i);
        if (t == 10 || t == 13 || t == 28) { d = d + 1; }
        elif (t == 11 || t == 14 || t == 29) { d = d - 1; }
        elif (d == 0) {
            if (i > a) { if (t == 6 || t == 7 || t == 113 || t == 116) { return i; } }
        }
        i = i + 1;
    }
    return 0 - 1;
}
# 1 = token `i` reads an i8 / i16 / i32 local or parameter (not `&n`, not a field name `.n`).
fn _hl_narrow_at(S, i): i64 {
    if (TOKTYP(S, i) != 2) { return 0; }
    var pt = TOKTYP(S, i - 1);
    if (pt == 27 || pt == 41) { return 0; }
    var li = FINDLOCAL(S, TOKVAL(S, i));
    if (li < 0) { return 0; }
    if (GLPTRP(S, li) == 1) { return 0; }
    var t = GLTYPE(S, li);
    if (t > 0) { if (t < 8) { return 1; } }
    return 0;
}
# rax (an address) becomes the struct `sid` (8 B or less) it points at, as a by-value consumer takes
# it: one load of 1 / 2 / 4 / 8 bytes, else (3, 5, 6, 7) a byte-exact copy into a temp — a frame temp
# in a fn, a hidden global at top level — whose word is loaded: no byte past the object is read. The
# frame temp is zeroed first, so the word's padding is 0 as a fresh hidden global's is, for every
# consumer (the frame's old bytes showed there). CHANGELOG [6.7.13]
fn _hl_pval_ra(S, sid): i64 {
    var sz = STRUCTSZ(S, sid - 1);
    if (_hl_wpow(sz) == 1) {
        EMOVCA(S);
        EFIELD_LOAD_W(S, sz);
        return 0;
    }
    var h = _HTEMP(S);
    _HTSTORE(S, h);
    if (h >= 0) {
        var t = _agg_temp(S, sid);
        EMOVI(S, 0);
        EFLSTORE(S, t);
