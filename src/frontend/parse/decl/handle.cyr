    if (gps <= 0 - 2048) { return 0; }
    var b = GTI(S);
    if (_gz_star1(S, b) == 0) { return _gz_dx_init(S, dgv, gps, dnoff); }   # 6.7.10 (review): any `*E`; 6.7.16: `*GPP`
