# *h.pu;` is "cannot copy '*h.pu' ...", `o.s = *qq` '*qq', `l = *gp()` '*gp()' — it was the operand's last name ('pu',
# 'qq', 'gp'), as 6.7.15's argument arm already spells it (`_src_span_nm`). The dereference `_hl_dstar_x` typed last,
# rendered now, at the refusal (the span's scratch is uncommitted); else (`_hl_psrc`'s `*T` source) `_hl_dnm`.
# CHANGELOG [6.7.16]
fn _hl_dname(S): i64 {
    if (_hl_dna < 0) { return _hl_dnm; }
    return _src_span_nm(S, _hl_dna, _hl_dne, _hl_dnm);
}
# `_AGG_ASSIGN_TYPE_ERR` for that dereference source into `dnoff` (`td` its type, `ts` the source's): 1 = refused,
# the source named as `_hl_dname` names it.
fn _agg_dx_err(S, td, ts, dnoff): i64 {
    if (_hl_dna < 0) { return _AGG_ASSIGN_TYPE_ERR(S, td, ts, dnoff, _hl_dnm); }
    return _agg_span_err(S, td, ts, dnoff, _hl_dna, _hl_dne, _hl_dnm);
}
# ... for a source spelled by the tokens [a, e) (`dflt` when they have no source spelling), rendered only when it is
# refused (1).
fn _agg_span_err(S, td, ts, dnoff, a, e, dflt): i64 {
    if (td >= 0) { return 0; }
    if (ts >= 0) { return 0; }
    if (td == ts) { return 0; }
    return _AGG_ASSIGN_TYPE_ERR(S, td, ts, dnoff, _src_span_nm(S, a, e, dflt));
}
# The struct the `*S` a dereference's operand [a, e) reads points at — the operand a `**S`, S a plain struct (not a
# `Str` / tuple / dyn: their own paths) — when `pp` asks, `_hl_dpp` 1; else 0. `pp` 2 (the assignment, `_asg_dstar`)
# and, since 6.7.16, 1 (a declaration) answer `Str` too (`_hl_dpp_str`).
fn _hl_dpp_sid(S, a, e, pp): i64 {
    if (pp == 0) { return 0; }
    var ps = _hl_dref_psid(S, a, e);
    if (ps <= 0) { return 0; }
    if (_dx_plain(S, ps) == 0) { if (_hl_dpp_str(S, ps, pp) == 0) { return 0; } }
    _hl_dpp = 1;
    return ps;
}
# ⛔ 6.7.16 — `t = *pp` (pp a `**Str`: `*pp` is a `*Str`) INTO AN INLINE `Str` COPIES THE HEADER, as `t = p` / `t = *p`
# do since 6.7.15's D14: it stored the header's address into t.data and left t.len stale. 1 = `pp` asks (2 the
# assignment, 1 a declaration) and `ps` is `Str` — `_istr_dxa` then copies through the `*Str` the whole `*pp` reads; into
# a handle or a `*Str` it stays the one-word store, a rebind. A field store's mode 1 (`_fsc_dstar`) declines a `Str`.
# ⛔ 6.7.16 — `var u: Str = *pp;` IS u's OWN COPY OF THE HEADER (the user's D74, 2026-10-20), as `var u: Str = p;`, `=
# *p` and `= **pp` are: the declaration asked mode 1, which answered no `Str`, so the scalar init bound u as a HANDLE on
# the header `*pp` points at — a later `a.len = 1` was seen through u. In a fn (`_sci_dexpr`) and at top level, in the
# declaration zone (`_gz_star` / `_gz_dx_init`) and after a statement (`_gci_dx_top`): `*GPP`, `(*GPP)`. CHANGELOG [6.7.16]
fn _hl_dpp_str(S, ps, pp): i64 {
    if (pp == 0) { return 0; }
    if (ps != _STR_SID(S)) { return 0; }
    return 1;
}
# The last name in [a, e) — the one a refusal quotes (`*w.pu` -> `pu`, `*gu()` -> `gu`) — `dflt` when there is
# none. A generic call's type-argument list is no name of the operand: `*gpg<U>()` names `gpg`. CHANGELOG [6.7.11]
fn _hl_lastnm(S, a, e, dflt): i64 {
    var nm = dflt;
    var i = a;
    while (i < e) {
        if (TOKTYP(S, i) == 2) {
            nm = TOKVAL(S, i);
            var o = _gcall_open(S, i);
            if (o > i + 1) { i = o; }   # past `<..>`
        }
        i = i + 1;
