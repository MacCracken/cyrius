# The end of a source at token `ti` that ends at `term`: its `;` (`_gz_end`), or for a `)` the first `)`
# no bracket after `ti` opened; -1 when it ends at anything else. CHANGELOG [6.7.11]
fn _hl_dx_end(S, ti, term): i64 {
    if (term == 5) {
        var e = _gz_end(S, ti);
        if (TOKTYP(S, e) != 5) { return 0 - 1; }
        return e;
    }
    var d = 0;
    var i = ti;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 10 || t == 13 || t == 28) { d = d + 1; }
        elif (t == 11 || t == 14 || t == 29) {
