# CHANGELOG [6.7.17]
fn _vin_avv(S, pscale, sty, ann): i64 {
    if (GINFN(S) != 1) { return 0; }
    if (ann != 0) { return 0; }
    if (pscale != 0) { return 0; }
    if (sty != 0) { return 0; }
