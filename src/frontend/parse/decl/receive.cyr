    var ann = 1;
    if (_gu_untyped(S, st) == 1) { ann = 0; }
    if (ann == 1) { if (_vin_zval(S, st) == 1) { return 1; } }   # 6.7.17 (D24): `var X: i64 = *GP;`
    if (ann == 1) { if (_svin_zval(S, st) == 1) { return 1; } }   # 6.7.17 (D106): `var X: i64 = GQ;`
    if (ann == 1) { if (_ppd_zval(S, st) == 1) { return 1; } }   # 6.7.17 (D107): `var GU: *Pt = GPP;`
    return _vtop_ref(S, st, ann);
