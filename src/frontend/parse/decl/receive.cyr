# the cursor on the `=`. 0. CHANGELOG [6.7.17]
fn _svin_val(S, pscale, ann): i64 {
    if (ann <= 0) { return 0; }
    if (pscale < 0) { return 0; }
    if (TOKTYP(S, ann - 1) != 49) { return 0; }
    var ti = GTI(S) + 1;
    return _svin_judge(S, ti, _hl_dx_end(S, ti, 5), ann, TOKVAL(S, ann - 2));
