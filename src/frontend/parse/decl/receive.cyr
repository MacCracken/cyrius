# The declaration zone's replay, cursor on the initialiser of global `gi` (`noff`): `_vtop_ref`, unless the global is
# a vector (pass 1 refused its initializer: `_vecg_init_ok`).
fn _vin_zone(S, gi, noff): i64 {
    var slot = _gv_ent_slot(S, gi, 0, noff);
    if (slot >= 0) { if (GVVEC(S, slot) != 0) { return 0; } }
