# PARSER — decl: the module-scope initializer constant folder (`_CF_*`) and the global array initializers baked into
# the image (`_gai_*`).
# ================================================================
# Split from parse/decl.cyr at 6.7.18, unchanged; parse.cyr includes parse/decl/ in source order. CHANGELOG [6.7.18]

# Register a global var in declaration zone (no codegen, deferred init)
# ================================================================
# Module-scope initializer constant folder (v6.4.74)
# ================================================================
# WHY THIS EXISTS. v5.11.64 added a static-init path so a module-scope
# `var X = <non-zero NUM> ;` is pre-written into the var area at FIXUP time and
# is therefore correct on FIRST READ. It deliberately recognised ONLY a bare
# integer literal ("Conservative on purpose"), and everything else — `-5`,
# `0 - 61`, `512 * 2`, `1 << 4` — fell through to the deferred runtime-store
# path in EMIT_GVAR_INITS.
#
# In kmode (`_init_km == 1`) on the x86_64 ELF fork ONLY, main.cyr emits
# PARSE_PROG FIRST and EMIT_GVAR_INITS AFTER it (the v5.7.19 multiboot
# invariant: top-level asm must run before 64-bit gvar inits — agnos depends on
# this and the filing explicitly asks us NOT to change the order). agnos's
# top-level program IS the whole boot and ends in `arch_halt()`, so it never
# returns and that deferred block is DEAD CODE. Result: every computed
# module-scope initializer read as 0 for the life of the kernel, with no
# warning and no error — it built clean, formatted clean, and produced a 4/4
# PASS selftest that was comparing 0 against 0.
#
# The fix is to widen what counts as statically-initialisable, so foldable
# expressions get baked into the image exactly like plain literals. No ordering
# change, no risk to the multiboot invariant.
# (issues/archived/2026-07-23-cyrius-module-scope-var-expr-initializer-zero.md)
#
# PRECEDENCE IS LOAD-BEARING AND IS *NOT* C's. This folder must agree with
# PEXPR/PARSE_TERM exactly, or it would bake in a different value than the
# runtime path computes — the same silent-wrong-value class we are fixing.
# Verified empirically against the running compiler at 6.4.73:
#   PARSE_TERM tier (binds tighter): *  /  %  <<  >>  >>>     (8 9 34 38 39 152)
#   PEXPR tier:                      +  -  &  |  ^            (6 7 27 35 36)
# so `&`, `|`, `^` sit at the SAME precedence as `+`/`-`, left-associative —
# NOT C, where they bind looser. Probes: `1 | 2 + 1` == 4 (i.e. `(1|2)+1`, not
# `1|(2+1)` == 3) and `5 & 3 + 1` == 2. Both tiers are left-associative
# (`100 - 10 - 5` == 85).
#
# Shift semantics mostly come free: this folder is itself written in cyrius and
# compiled by cycc, so its `<<` / `>>` are the same shifts the emitted code
# uses, with the same backend count-masking — self-consistent by construction
# rather than by a second implementation of the rules. The ONE exception is
# `>>>`, which cybs cannot lex; see _CF_ASR below for why and how.
#
# CONSERVATISM: any construct that is not a pure integer-literal expression
# (an identifier, a call, a string, a float) clears `_cf_ok` and the caller
# falls straight back to today's runtime-store path. Division/modulo by zero
# also bails rather than folding, so the runtime keeps whatever trap behaviour
# it has today. The one exception is a -1 divisor: it FOLDS, as the wrapping
# negation for `/` and 0 for `%`, so INT_MIN / -1 bakes INT_MIN where a runtime
# idiv on the same operands would trap (CHANGELOG [6.6.20]). `_CF_TRY`
# additionally requires the fold to land EXACTLY on the terminating `;`, which
# makes a partial fold impossible.
var _cf_ok = 0;
var _cf_ti = 0;
var _cf_enum = 0;   # 6.6.16 (C1): 1 = enum constants fold (see _CF_ENUM)

# Arithmetic (sign-propagating) right shift, spelled WITHOUT the `>>>` operator.
#
# THE SEED CEILING, NOT A STYLE CHOICE: the first cut of this folder wrote the
# obvious `v >>> _CF_FACTOR(S)` and self-hosted + fixpointed cleanly on
# build/cycc — then `seed-derive-cycc.sh` failed at step [3/5] with a bare
# `syntax error`. **cybs cannot lex `>>>`**: its lexer (bootstrap/cybs.cyr
# `lexer_shr`) knows only `>` / `>=` / `>>` (token 39) and has no three-char
# form, so it tokenised `>>` `>` and the parse died. `build/cycc` compiled it
# happily, which is precisely why the cycc fixpoint does NOT substitute for the
# seed gate. See CLAUDE.md's Release Gate item 2.
#
# Semantics verified empirically against the running compiler rather than taken
# from the doc: `((0-16) >> 2) >> 56` == 63 (zero-filled ⇒ `>>` is LOGICAL) and
# `((0-16) >>> 2) >> 56` == 255 (sign-filled ⇒ `>>>` is ARITHMETIC) — the
# reverse of JS/Java, as CLAUDE.md warns.
#
# The `& 63` matches the backend: x86 `sar r64, cl` masks the count to 6 bits,
# so `v >>> 64` is `v`, not 0/-1. With sh in 1..63, `64 - sh` is 1..63 and the
# mask shift is always in range.
fn _CF_ASR(v, n): i64 {
    var sh = n & 63;
    if (sh == 0) { return v; }
    var r = v >> sh;
    if (v < 0) { r = r | ((0 - 1) << (64 - sh)); }
    return r;
}

fn _CF_FACTOR(S): i64 {
    var t = TOKTYP(S, _cf_ti);
    if (t == 1) { var v = TOKVAL(S, _cf_ti); _cf_ti = _cf_ti + 1; return v; }
    if (t == 7) { _cf_ti = _cf_ti + 1; return 0 - _CF_FACTOR(S); }
    if (t == 169) { _cf_ti = _cf_ti + 1; return 1; }   # true (6.7.3) — `!` is not folded
    if (t == 170) { _cf_ti = _cf_ti + 1; return 0; }   # false
    if (t == 10) {
        _cf_ti = _cf_ti + 1;
        var pv = _CF_EXPR(S);
        if (_cf_ok == 0) { return 0; }
        if (TOKTYP(S, _cf_ti) != 11) { _cf_ok = 0; return 0; }
        _cf_ti = _cf_ti + 1;
        return pv;
    }
    if (t == 2) { if (_cf_enum == 1) { return _CF_ENUM(S); } }
    if (t == 15) { if (_cf_enum == 1) { return _CF_IFX(S); } }   # 6.7.4: a constant-condition if-expression
    _cf_ok = 0;
    return 0;
}

# 6.7.4 (B3) — an if-expression, where the folder's enum arm is on (a kernel build's static bake, a
# baked struct literal): every condition a folder expression with at most one comparison, every arm a
# folder expression, `else` present — anything else is `_cf_ok = 0`, QUIET, and the runtime store
# the replay emits stays the value (it runs only the taken arm; the folder walks them all, so an
# untaken `1 / 0` just declines to fold). CHANGELOG [6.7.4]
fn _CF_IFX(S): i64 {
    _cf_ti = _cf_ti + 1;
    var done = 0;
    var res = 0;
    var go = 1;
    while (go == 1) {
        if (_CF_TOK(S, 10) == 0) { return 0; }
        var c = _CF_COND(S);
        if (_CF_TOK(S, 11) == 0) { return 0; }
        var v = _CF_ARMV(S);
        if (_cf_ok == 0) { return 0; }
        if (done == 0) { if (c != 0) { res = v; done = 1; } }
        var t = TOKTYP(S, _cf_ti);
        if (t == 50) { _cf_ti = _cf_ti + 1; }
        elif (t == 23) {
            _cf_ti = _cf_ti + 1;
            var e = _CF_ARMV(S);
            if (_cf_ok == 0) { return 0; }
            if (done == 0) { res = e; }
            return res;
        } else { _cf_ok = 0; return 0; }
    }
    return res;
}
fn _CF_TOK(S, t): i64 {
    if (_cf_ok == 0) { return 0; }
    if (TOKTYP(S, _cf_ti) != t) { _cf_ok = 0; return 0; }
    _cf_ti = _cf_ti + 1;
    return 1;
}
fn _CF_ARMV(S): i64 {
    if (_CF_TOK(S, 13) == 0) { return 0; }
    var v = _CF_EXPR(S);
    if (_CF_TOK(S, 14) == 0) { return 0; }
    return v;
}
fn _CF_COND(S): i64 {
    var a = _CF_EXPR(S);
    if (_cf_ok == 0) { return 0; }
    var op = TOKTYP(S, _cf_ti);
    if (op < 17 || op > 22) { return a; }
    _cf_ti = _cf_ti + 1;
    var b = _CF_EXPR(S);
    if (op == 17) { if (a == b) { return 1; } return 0; }
    if (op == 18) { if (a != b) { return 1; } return 0; }
    if (op == 19) { if (a < b) { return 1; } return 0; }
    if (op == 20) { if (a > b) { return 1; } return 0; }
    if (op == 21) { if (a <= b) { return 1; } return 0; }
    if (a >= b) { return 1; }
    return 0;
}

# ⛔ 6.6.16 (C1) — THE ENUM ARM, ON ONLY WHERE NAMES RESOLVE AS THE RUNTIME DOES. An enum constant
# (`A`, `E.A`) folds to its value when `_cf_enum == 1`, which only an evaluation at the REPLAY or
# after the first top-level statement sets: by then every name is registered, so a forward enum and
# a later global that shadows the name resolve exactly as a runtime read of them would. Pass 1's
# call (PARSE_GVAR_REG) leaves it 0 — there it would miss a forward enum and fold 3 where the program
# reads a shadowing `var A = 9;` as 9. QUIET: no error, no cursor move; a name it cannot fold clears
# `_cf_ok` and the caller reports (a qualified base that is a variable is a field access). An enum
# constant carries no `private` stamp (PARSE_ENUM_DEF sets none), so a fold has no visibility to
# check. The value is the raw i64 (_vecv_base, the presence flag in GVECP). CHANGELOG [6.6.16]
fn _CF_ENUM(S): i64 {
    var ti = _cf_ti;
    var vi = 0 - 1;
    if (TOKTYP(S, ti + 1) == 41) {
        if (TOKTYP(S, ti + 2) != 2) { _cf_ok = 0; return 0; }
        if (_findvar_core(S, TOKVAL(S, ti)) >= 0) { _cf_ok = 0; return 0; }
        vi = _enum_variant_in(S, TOKVAL(S, ti), TOKVAL(S, ti + 2));
        ti = ti + 2;
    } else {
        vi = _findvar_core(S, TOKVAL(S, ti));
    }
    if (GVECP(S, vi) != 1) { _cf_ok = 0; return 0; }
    _cf_ti = ti + 1;
    return L64(_vecv_base + vi * 8);
}

fn _CF_TERM(S): i64 {
    var v = _CF_FACTOR(S);
    var go = 1;
    while (go == 1) {
        if (_cf_ok == 0) { return 0; }
        var t = TOKTYP(S, _cf_ti);
        if (t == 8) { _cf_ti = _cf_ti + 1; v = v * _CF_FACTOR(S); }
        elif (t == 9) {
            _cf_ti = _cf_ti + 1;
            var d = _CF_FACTOR(S);
            if (d == 0) { _cf_ok = 0; return 0; }
            # A -1 divisor folds as the wrapping negation: idiv traps (SIGFPE) on INT_MIN / -1 and
            # took the compiler down; for every other value it is the same quotient. CHANGELOG [6.6.20]
            if (d == 0 - 1) { v = 0 - v; }
            else { v = v / d; }
        }
        elif (t == 34) {
            _cf_ti = _cf_ti + 1;
            var m = _CF_FACTOR(S);
            if (m == 0) { _cf_ok = 0; return 0; }
            if (m == 0 - 1) { v = 0; }
            else { v = v % m; }
        }
        elif (t == 38) { _cf_ti = _cf_ti + 1; v = v << _CF_FACTOR(S); }
        elif (t == 39) { _cf_ti = _cf_ti + 1; v = v >> _CF_FACTOR(S); }
        elif (t == 152) { _cf_ti = _cf_ti + 1; v = _CF_ASR(v, _CF_FACTOR(S)); }
        else { go = 0; }
    }
    return v;
}

fn _CF_EXPR(S): i64 {
    var v = _CF_TERM(S);
    var go = 1;
    while (go == 1) {
        if (_cf_ok == 0) { return 0; }
        var t = TOKTYP(S, _cf_ti);
        if (t == 6) { _cf_ti = _cf_ti + 1; v = v + _CF_TERM(S); }
        elif (t == 7) { _cf_ti = _cf_ti + 1; v = v - _CF_TERM(S); }
        elif (t == 27) { _cf_ti = _cf_ti + 1; v = v & _CF_TERM(S); }
        elif (t == 35) { _cf_ti = _cf_ti + 1; v = v | _CF_TERM(S); }
        elif (t == 36) { _cf_ti = _cf_ti + 1; v = v ^ _CF_TERM(S); }
        else { go = 0; }
    }
    return v;
}

# Fold the initializer expression starting at token `ti`. On success sets
# _cf_ok = 1 and returns the value; on ANY doubt sets _cf_ok = 0 and the caller
# keeps today's behaviour. Requires the expression to end exactly on its
# terminator so a partially-consumed initializer can never be mistaken for a
# folded one: `term` 5 is a declaration's `;`, 31 an array element's `,` or `}`
# (6.6.16). On success `_cf_ti` is the terminator's token.
fn _CF_TRY(S, ti, term): i64 {
    _cf_ok = 1;
    _cf_ti = ti;
    var v = _CF_EXPR(S);
    if (_cf_ok == 0) { return 0; }
    var t = TOKTYP(S, _cf_ti);
    if (t == term) { return v; }
    if (term == 31) { if (t == 14) { return v; } }
    _cf_ok = 0;
    return 0;
}

# ================================================================
# Global array initializers (6.6.16, C1)
# ================================================================
# ⛔ WHY. `var X: T[N] = { .. }` meant BYTES whatever T was: the list went into the first bytes
# of the array one byte per element, so `var T: i64[3] = {1, 2, 42};` read T[0] = 0x2A0201 and
# T[1] = T[2] = 0, on every target (an i8 list read right only because its element IS a byte).
# A value over 255 was "byte-array literal value must be in [0, 255]", `-3` and `1.5` were
# syntax errors, an enum constant was "expected number", and `Pt[2]` / `i8v16[2]` / `bool[2]`
# lists compiled silently as bytes. The element type sized the array and was never consulted
# again. And the list was STORED AT RUN TIME by the deferred replay, which a `kernel;` build runs
# after the top-level program — so in a kernel that never returns every array literal read 0.
#
# NOW. `var X: T[N] = { .. }` is N elements of T, baked into the image:
#   * Pass 1 (PARSE_GVAR_ARR) checks the element type — refused BY NAME where a list of
#     constants cannot fill it — and the element count, and records the deferred entry. It does
#     NOT evaluate: an element may name an enum declared further down.
#   * The replay (EMIT_GVAR_INITS -> _gai_replay) evaluates each element with the constant folder,
#     its enum arm on (_CF_ENUM), into the slot's blob (_vgai_base, util.cyr). Names resolve there
#     exactly as a runtime read of them would.
#   * Every target copies the blob into the var area (_gai_bake, from _EMIT_GVAR_STATIC_INITS,
#     and main_cx.cyr's var-data write: a .cyx carries its var data too) and emits NO code.
#   * The same declaration after the first top-level statement (PARSE_ARRAY) is evaluated at once
#     — at true module scope only (_gai_stmt): a global's meaning does not depend on where it is.
# Values: an integer element takes -2^(8w-1) .. 2^(8w)-1 (so `0xFF` into i8 and `-1` into u8 are
# bit patterns, while a value that would be TRUNCATED is refused); i64 / u64 / bool / an enum /
# `*T` take any i64; the bare byte list keeps [0, 255]; u128 is the value in its low 8 bytes; f64
# is a float literal's bits; f32 the literal narrowed to binary32, round-to-nearest-even
# (_gai_f32). An integer in an f64 / f32 element keeps its bits, with the warning a scalar gives.
# CHANGELOG [6.6.16]
var _gai_w = 0;        # the element bytes _gai_kind found
var _gai_isbool = 0;   # 6.7.3 / 6.7.4: the list being evaluated fills a `bool[N]` (each element a bool)
var _gai_ok = 0;       # _gai_val: 1 = the element is a constant
var _pp_depth = 0;     # PARSE_PROG nesting: 1 = module scope (see _gai_stmt)

# A leading-block declaration at `sti` (its `var`): the annotation's type token, 0 for a bare
# `var b[N]` — `var NAME : T`, so the token after the `:`.
fn _gai_ann(S, sti): i64 {
    if (TOKTYP(S, sti + 2) == 49) { return sti + 3; }
    return 0;
}

# The element kind of an array annotated at `ann_ti` (0 = a bare `var b[N]`), its bytes in
# `_gai_w`: 1 an integer (iN / uN, bool, an enum, `*T`), 2 the bare byte list, 3 u128, 4 f64,
# 5 f32. 0 = an element no list of constants fills (a struct or union, a vector, a slice,
# cstring, Result / Option / Tagged, Vec); -1 = a name that is no type, which _arr_name_ebytes has
# already refused at the name. The type comes from the one resolver (_tn_resolve_at).
fn _gai_kind(S, ann_ti): i64 {
    _gai_w = 1;
    if (ann_ti == 0) { return 2; }
    var t = TOKTYP(S, ann_ti);
    _gai_w = 8;
    if (t == 8) { return 1; }
    if (t == 105) { _gai_w = 16; return 3; }
    if (t != 2) { return 0; }
    var c = _tn_resolve_at(S, ann_ti);
    if (c == 0) { return 0 - 1; }
    var f = _tn_flt(c);
    if (f == F64_TYID) { return 4; }
    if (f == F32_TYID) { _gai_w = 4; return 5; }
    _gai_w = _tn_init_w(c);
    if (_gai_w > 0) { return 1; }
    return 0;
}

# A diagnostic at token `ti`, the cursor put back. Each is reported once and the latch it set is
# cleared, so every bad array of a file is reported; an error already holding it is left alone.
fn _gai_err(S, ti, msg): i64 {
    if (_panic == 1) { return 0; }
    var n = 0;
    while (load8(msg + n) != 0) { n = n + 1; }
    var sv = GTI(S);
    STI(S, ti);
    ERR_MSG(S, msg, n);
    STI(S, sv);
    _panic = 0;
    return 0;
}
fn _gai_type_err(S, ti): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (TOKTYP(S, ti) != 2) {
        _gai_err(S, ti, "an initializer list is not supported for this array's element type; store the elements explicitly");
        return 0;
    }
    var sv = GTI(S);
    STI(S, ti);
    ERR_IDENT(S, "an initializer list for an array of ", TOKVAL(S, ti), " is not supported; store the elements explicitly (a list fills integer, bool, enum, pointer, u128, f64 and f32 elements)", 0 - 1);
    STI(S, sv);
    _panic = 0;
    return 0;
}
# More elements than the array holds: the bare list keeps its message (it counts BYTES).
fn _gai_cap_err(S, cap, bare): i64 {
    if (bare == 1) {
        _gai_err(S, GTI(S), "byte-array literal has more bytes than the array's declared capacity (cap is [N]*8 bytes)");
        return 0;
    }
    if (_panic == 1) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": array initializer has more elements than the array holds (");
    PRNUM(cap);
    PRSTR(")\n");
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}

# Step over one element: to its `,` or `}` outside parentheses. A `;` or EOF stops it (the caller
# reports the missing `}`). An empty element is `expected number`, as it always was — unless
# `quiet` (the evaluation, after the walk has reported).
fn _gai_skip(S, quiet): i64 {
    var t = PEEKT(S);
    if (t == 31 || t == 14) {
        if (quiet == 0) { ERR_EXPECT(S, 1); }
        return 0;
    }
    var d = 0;
    while (t != 5 && t != 12) {
        if (d == 0) { if (t == 31 || t == 14) { return 0; } }
        if (t == 10 || t == 13) { d = d + 1; }   # 6.7.4: an if-expression element's braces
        if (t == 11 || t == 14) { d = d - 1; }
        STI(S, GTI(S) + 1);
        t = PEEKT(S);
    }
    return 0;
}
# The walk of `{ e, e, .. }`, cursor on `{` and left past `}`: the element count against `cap`
# (elements; the bare list's bytes), reported at the first element past it. No value is looked at.
fn _gai_walk(S, cap, bare): i64 {
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); return 0; }
    STI(S, GTI(S) + 1);
    var n = 0;
    while (PEEKT(S) != 14) {
        var t = PEEKT(S);
        if (t == 5 || t == 12) { ERR_EXPECT(S, 14); return n; }
        if (n == cap) { _gai_cap_err(S, cap, bare); }
        _gai_skip(S, 0);
        n = n + 1;
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    }
    STI(S, GTI(S) + 1);
    return n;
}
# The declaration's half (pass 1, and _gai_stmt): the element type, then the walk. `n` the
# declared element count, `sz` the slot's bytes (the bare list's cap). Cursor on `{`.
fn _gai_decl(S, ann_ti, n, sz): i64 {
    var bare = 0;
    if (ann_ti == 0) { bare = 1; n = sz; }
    if (_gai_kind(S, ann_ti) == 0) { _gai_type_err(S, ann_ti); }
    _gai_walk(S, n, bare);
    return 0;
}

# After the first top-level statement (PARSE_ARRAY, GINFN != 1, cursor on `=`). At module scope
# the declaration is the leading block's, evaluated once the slot is registered (_gai_now) — by
# then every name is. In a top-level block (`while`, `if` / `elif` / `else`, `for` and its init,
# `switch` arms, `match`, `@unsafe`, a bare `{ }`) it is REFUSED: a baked list would hold its
# values once, where a scalar's initializer runs each time the block does (that shape never
# compiled — `expected ';'`).
# PARSE_PROG counts its nesting in `_pp_depth`, and _PARSE_STMT_NESTED (parse.cyr) the statements
# parsed with no PARSE_PROG body — a `switch` case / default arm, `@unsafe { }`, a `for`'s init;
# scope depth cannot tell, an `elif` body opens no scope. Returns the `{` token, or 0.
fn _gai_stmt(S, ann_ti, n): i64 {
    var eq = GTI(S);
    STI(S, eq + 1);
    var bare = 0;
    if (ann_ti == 0) { bare = 1; }
    if (_pp_depth != 1) {
        _gai_err(S, eq, "an array initializer is allowed only at module scope: in a block it would hold its values once, not each time the block runs; assign the elements in the block");
        _gai_walk(S, 0 - 1, bare);
        return 0;
    }
    var lb = GTI(S);
    _gai_decl(S, ann_ti, n, n * 8);
    return lb;
}
fn _gai_now(S, vi, lb, ann_ti): i64 {
    var sv = GTI(S);
    STI(S, lb);
    _gai_eval(S, vi, ann_ti, GVSI(S, vi));
    STI(S, sv);
    return 0;
}

# The replay of a leading-block array initializer (EMIT_GVAR_INITS, cursor on `[`). An entry a
# later constant declaration superseded (_gv_supersede) is evaluated for its errors and writes
# nothing: the later declaration is the value, and no blob of this one may land over it.
fn _gai_replay(S, gi, noff, gsup, sti): i64 {
    while (PEEKT(S) != 13) {
        var t = PEEKT(S);
        if (t == 5 || t == 12) { ERR_EXPECT(S, 13); return 0; }
        STI(S, GTI(S) + 1);
    }
    var ann = _gai_ann(S, sti);
    var vi = _gv_ent_slot(S, gi, 0, noff);
    if ((gsup & 1) != 0) { vi = 0 - 1; }
    var seed = 0;
    if (vi >= 0) { seed = _gai_seed(S, gi, vi, noff); }
    _gai_eval(S, vi, ann, seed);
    _expect_step(S, 5);
    return 0;
}

# Evaluate `{ e, e, .. }` (cursor on `{`, left past `}`) into slot `vi`'s blob (vi < 0: errors
# only; `seed` a new blob's first word, _gai_blob). The walk has reported the shape; this reports the values.
fn _gai_eval(S, vi, ann, seed): i64 {
    var k = _gai_kind(S, ann);
    var eb = _gai_w;
    _gai_isbool = 0;
    if (ann > 0) { if (TOKTYP(S, ann) == 2) { _gai_isbool = _bx_is_bool_name(S, TOKVAL(S, ann)); } }
    if (_syntax_only == 1) { k = 0; }
    var b = 0;
    if (k > 0) { b = _gai_blob(S, vi, eb, k, seed); }
    STI(S, GTI(S) + 1);
    var off = 0;
    while (PEEKT(S) != 14) {
        var t = PEEKT(S);
        if (t == 5 || t == 12) { return 0; }
        var ti = GTI(S);
        if (k > 0) { _gai_one(S, b, off, eb, k, ti); }
        STI(S, ti);
        _gai_skip(S, 1);
        off = off + eb;
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    }
    STI(S, GTI(S) + 1);
    return 0;
}

# Slot `vi`'s blob, made on first use: zeroed, then seeded with `seed`, the scalar constant this slot
# held (a bare `var B[1]` redeclaring `var B = 5;` keeps the bytes it does not list, as the replayed
# stores did; _gai_seed). A later declaration of the slot reuses it, so the overlay order is the old
# store order. 0 for `vi < 0`.
fn _gai_blob(S, vi, eb, k, seed): i64 {
    if (vi < 0) { return 0; }
    var b = GVGAI(S, vi);
    if (b == 0) {
        var sz = L64(_vars_base + vi * 8);
        b = alloc(sz + 24);
        store64(b, sz);
        if (sz >= 8) { store64(b + 16, seed); }
        SVGAI(S, vi, b);
    }
    store64(b + 8, eb | (k << 8));
    return b;
}
# ⛔ 6.7.16 — THE SEED IS THE SLOT'S LAST SCALAR CONSTANT BEFORE THE LIST, HOWEVER IT IS SPELLED
# (issues/archived/2026-10-18-list-redeclaration-over-named-scalar-constant-loses-unlisted-bytes.md). It was the static init,
# which only a pass-1 literal writes: a const- or enum-named scalar (`var a = C; var a[1] = {9};`) is a deferred entry
# the list supersedes (_gvk_one's bk 4: folded, not baked), so the list dropped its bytes (0x0009, where `var a =
# 0x0506;` gives 0x0509), and `var a = 0x0506; var a = C;` seeded the stale literal. Now the nearest earlier entry
# of slot `vi` that folded to an integer (`_gvk_ik` 1; a computed one is no constant and is stepped past, as the
# literal's static init outlives it) is the seed, unless a pass-1 constant redeclaration came after it
# (_gv_supersede's bit 43): then that literal, the static init, is. A FLOAT constant is a constant too (`_gvk_ik` 2,
# its bits; the user's D86 (a), 2026-10-20): a list over `var K = 1.5;` keeps 1.5's bytes it does not list
# (0x3FF8000000000009), as the integer spelling of those bits does — it seeded the static init (the float is a
# deferred entry the list supersedes: no bake), so 1.5's bytes were dropped, and a pass-1 literal before the float
# read through (`var a = 0x0506; var a = 1.5; var a[1] = {9};` 0x0509). A struct / tuple literal of constants
# (`_gvk_ik` 3) stops the walk at the static init. `gi` = the list's entry, `noff` its name. CHANGELOG [6.7.16]
fn _gai_seed(S, gi, vi, noff): i64 {
    if (_gvx_m == 0) { return GVSI(S, vi); }
    var e = _nm_get(S, _gvx_m, noff);
    while (e != 0) {
        var r = load64(_gvx_rec + (e - 1) * 8);
        var g = r >> 2;
        var sk = 0;
        if (g < gi) { if ((r & 3) == 0) { sk = _gai_seed_ent(S, g, vi); } }
        if (sk == 2) { return GVSI(S, vi); }
        if (sk == 1) {
            if ((_gv_sup(L64(_gvt(S) + g * 8)) & 8) != 0) { return GVSI(S, vi); }
            return load64(_gvk_v + g * 8);
        }
        e = load64(_gvx_nxt + (e - 1) * 8);
    }
    return GVSI(S, vi);
}
# Entry `g` against slot `vi`: 1 = it declared the slot and _gvk_pre folded its initializer to a scalar constant
# (`_gvk_ik` 1, an integer; 2, a float's bits, D86 (a)), its value in `_gvk_v`; 2 = it declared the slot with a
# struct / tuple literal of constants (`_gvk_ik` 3), which stops _gai_seed's walk; 0 = neither (another slot, a
# computed initializer).
fn _gai_seed_ent(S, g, vi): i64 {
    if (g >= _gv_ent_cap) { return 0; }
    if ((load64(_gv_ent_base + g * 8) & 0x1FFFFF) - 1 != vi) { return 0; }
    var ik = load8(_gvk_ik + g);
    if (ik == 0) { return 0; }
    if (ik == 3) { return 2; }
    return 1;
}

# One element at token `ti`, written at byte `off` of blob `b` (b == 0: checked only). An empty
# element, and one past the declared count, were reported by the walk.
fn _gai_one(S, b, off, eb, k, ti): i64 {
    var t = TOKTYP(S, ti);
    if (t == 31 || t == 14) { return 0; }
    var v = _gai_val(S, ti, k, eb);
    if (_gai_ok != 1) { _gai_bad_k(S, ti); return 0; }
    if (b == 0) { return 0; }
    if (off + eb > load64(b)) { return 0; }
    _gai_put(b + 16 + off, eb, v);
    return 0;
}
fn _gai_put(d, eb, v): i64 {
    if (eb == 1) { store8(d, v); return 0; }
    if (eb == 2) { store16(d, v); return 0; }
    if (eb == 4) { store32(d, v); return 0; }
    store64(d, v);
    if (eb == 16) { store64(d + 8, 0); }
    return 0;
}

# ⛔ 6.7.4 — THE VALUE OF THE ELEMENT AT `ti`, from the compile-time evaluator: a list element is
# a const context, as 6.7.2 made every other compile-time value (the user's decision, 2026-10-08:
# one evaluator for every site). It was the integer folder, so a comparison, `&&` / `||`, `!`, a
# const fn call, f64 const arithmetic and the if-expression were "not a constant". `_gai_ok`: 1 a
# value; 0 not a constant (a string, a trailing token); 2 the evaluator already said why; 3 a
# `bool[N]` element that is not a bool; 4 an f64 into an integer element. An f64 element takes an
# f64 value's bits (an f32 element narrows them, _gai_f32) and an integer's bits with the warning
# `var G: f64 = 2;` gives; an integer element is range-checked as before. CHANGELOG [6.7.4]
fn _gai_val(S, ti, k, eb): i64 {
    _gai_ok = 1;
    var sv = GTI(S);
    STI(S, ti);
    var v = _ce_eval_here(S);
    var kk = _ce_k;
    var e = GTI(S);
    STI(S, sv);
    if (_ce_err == 1) { _panic = 0; _gai_ok = 2; return 0; }
    var et = TOKTYP(S, e);
    if (et != 31) { if (et != 14) { _gai_ok = 0; return 0; } }
    if (kk == 2) { _gai_ok = 0; return 0; }
    if (_gai_isbool == 1) { if (kk != 3) { _gai_ok = 3; return 0; } }
    if (k >= 4) {
        if (kk != 1) { _gai_ifs(S, ti, e); }
        if (k == 5) { if (kk == 1) { return _gai_f32(v); } return v & 0xFFFFFFFF; }
        return v;
    }
    if (kk == 1) { _gai_ok = 4; return 0; }
    _gai_range(S, ti, v, eb, k);
    return v;
}
fn _gai_bad_k(S, ti): i64 {
    if (_gai_ok == 2) { return 0; }
    if (_gai_ok == 3) {
        _gai_err(S, ti, "a bool array's element takes a boolean value: true, false, a comparison or a bool const");
        return 0;
    }
    if (_gai_ok == 4) {
        var t = TOKTYP(S, ti);
        if (t == 7) { t = TOKTYP(S, ti + 1); }
        if (t == 61) { _gai_err(S, ti, "a float literal initializes only an f64 or f32 array element"); return 0; }
        _gai_err(S, ti, "an f64 value initializes only an f64 or f32 array element");
        return 0;
    }
    return _gai_bad(S, ti);
}
# `-`? FLOAT, then the element's end: the literal's binary64 bits, the sign bit flipped for `-`
# (the struct-literal baker's float leaf, _spc_leaf).
fn _gai_flit(S, ti): i64 {
    var neg = 0;
    if (TOKTYP(S, ti) == 7) { neg = 1; ti = ti + 1; }
    _gai_ok = 0;
    if (TOKTYP(S, ti) != 61) { return 0; }
    var e = TOKTYP(S, ti + 1);
    if (e != 31) { if (e != 14) { if (e != _spc_cl) { return 0; } } }   # 6.7.7: a tuple's `)`
    _gai_ok = 1;
    var bits = FLIT_NUM(TOKVAL(S, ti));
    if (neg == 1) { bits = bits ^ (1 << 63); }
    return bits;
}
# An integer in an f64 / f32 element: the warning `var G: f64 = 2;` gives (_IFS_SPAN's shapes).
fn _gai_ifs(S, ti, e): i64 {
    if (_IFS_SPAN(S, ti, e) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    _FLT_TYPE_WARN(S, 4);
    STI(S, sv);
    return 0;
}
# One window per width, -2^(8w-1) .. 2^(8w)-1: a bit-pattern spelling is taken, a value that would
# be truncated is refused. The bare byte list keeps [0, 255].
fn _gai_range(S, ti, v, eb, k): i64 {
    if (k == 2) {
        if (v < 0 || v > 255) { _gai_err(S, ti, "byte-array literal value must be in [0, 255]"); }
        return 0;
    }
    if (k != 1) { return 0; }
    if (eb >= 8) { return 0; }
    var hi = (1 << (eb * 8)) - 1;
    var lo = 0 - (1 << (eb * 8 - 1));
    if (v < lo || v > hi) { _gai_range_err(S, ti, v, eb, lo, hi); }
    return 0;
}
fn _gai_range_err(S, ti, v, eb, lo, hi): i64 {
    if (_panic == 1) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": array initializer value ");
    PRNUM(v);
    PRSTR(" does not fit a ");
    PRNUM(eb);
    PRSTR("-byte element (");
    PRNUM(lo);
    PRSTR(" .. ");
    PRNUM(hi);
    PRSTR(")\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    return 0;
}
# An element that is not a constant. A name gets the report a reference to it would give (a variant
# named through the wrong enum, a global another file keeps `private`); otherwise one message.
fn _gai_bad(S, ti): i64 {
    if (_panic == 1) { return 0; }
    var e0 = _had_error;
    _had_error = 0;
    var sv = GTI(S);
    STI(S, ti);
    var t = TOKTYP(S, ti);
    if (t == 2) {
        var vn = TOKVAL(S, ti);
        if (TOKTYP(S, ti + 1) == 41) {
            if (_findvar_core(S, vn) < 0) { _enum_qual_resolve(S, ti); }
        } else {
            var vi = _findvar_core(S, vn);
            if (vi >= 0) { _vis_check_var(S, vi, vn); }
        }
    }
    var said = _had_error;
    _had_error = _had_error | e0;
    _panic = 0;
    STI(S, sv);
    if (said != 0) { return 0; }
    if (t == 7) { t = TOKTYP(S, ti + 1); }
    if (t == 61) {
        _gai_err(S, ti, "a float literal initializes only an f64 or f32 array element");
        return 0;
    }
    _gai_err(S, ti, "array initializer elements must be constants: integers, enum constants and constant expressions (float literals in an f64 or f32 array)");
    return 0;
}

# The binary32 bits of binary64 `d`, round-to-nearest-even — what cvtsd2ss / fcvt give — in
# integers only (cybs compiles no float builtin, and src/ uses none). A result below f32's least
# subnormal is a signed zero, one past its range infinity; a NaN stays a quiet NaN (its top
# payload bits). `(x - 1) << 23 + r` makes both carries by addition: a significand that rounds up
# to 2^24 bumps the exponent, and a subnormal that rounds up to 2^23 is the least normal.
fn _gai_f32(d): i64 {
    var s = (d >> 63) << 31;
    var e = (d >> 52) & 0x7FF;
    var m = d & 0xFFFFFFFFFFFFF;
    if (e == 0x7FF) {
        if (m == 0) { return s | 0x7F800000; }
        return s | 0x7FC00000 | (m >> 29);
    }
    if (e == 0) { return s; }
    m = m | (1 << 52);
    var x = e - 896;
    var sh = 29;
    if (x < 1) { sh = 30 - x; x = 1; }
    if (sh >= 54) { return s; }
    var r = m >> sh;
    var rem = m & ((1 << sh) - 1);
    var half = 1 << (sh - 1);
    if (rem > half) { r = r + 1; }
    elif (rem == half) { if ((r & 1) == 1) { r = r + 1; } }
    var bits = ((x - 1) << 23) + r;
    if (bits >= 0x7F800000) { return s | 0x7F800000; }
    return s | bits;
}

# A deferred entry (`sti` = its `var`) that is an array list — the replay's own test
# (EMIT_GVAR_INITS): `var NAME [`, or `var NAME : <annotation> [`. The cursor is put back.
fn _gai_is_list(S, sti): i64 {
    var sv = GTI(S);
    STI(S, sti + 2);
    if (PEEKT(S) == 49) { _gvi_ann(S, 0 - 1); }
    var r = 0;
    if (PEEKT(S) == 28) { r = 1; }
    STI(S, sv);
    return r;
}

# cx (_gv_cx_prestore): make the blob of every slot a live leading-block list writes — the replay
# fills it — so the prestore leaves that slot to the var data. The blob is seeded with the scalar
# constant the slot held (_gai_seed, as the replay seeds it); storing the scalar at run time would
# land over the baked list.
fn _gai_cx_blobs(S): i64 {
    var gc = L64(S + 0x19A000);
    var gi = 0;
    while (gi < gc) {
        var graw = L64(_gvt(S) + gi * 8);
        var sti = _gv_tok(graw);
        if ((_gv_sup(graw) & 1) == 0) {
            if (_gai_is_list(S, sti) == 1) { _gai_cx_blob(S, gi, TOKVAL(S, sti + 1)); }
        }
        gi = gi + 1;
    }
    return 0;
}
fn _gai_cx_blob(S, gi, noff): i64 {
    var vi = _gv_ent_slot(S, gi, 0, noff);
    if (vi < 0) { return 0; }
    _gai_blob(S, vi, 0, 0, _gai_seed(S, gi, vi, noff));
    return 0;
}
