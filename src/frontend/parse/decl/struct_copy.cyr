fn _istr_pfdx(S, pf, term): i64 {
    if (pf == 0) { return 0; }
    var ti = GTI(S);
    return _istr_vdx(S, ti, _hl_dx_end(S, ti, term));
}
# A declaration's initialiser at the cursor (`_var_value`, after `var x: * Str =`): `*p` is p (1: parsed).
fn _istr_pvd(S): i64 {
    var ti = GTI(S);
