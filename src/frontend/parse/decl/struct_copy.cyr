# 1 = the tail call `return f(..);` (`cfi`) in a fn returning `Str` reaches a callee returning a struct of another type:
# diverted to the normal path, where `_istr_rsv` refuses it (`_tc_small_sret_divert`).
fn _istr_tcd(S, cfi): i64 {
    var ss = _STR_SID(S);
    if (ss <= 0) { return 0; }
    if (_cur_fn_ret_sid != ss) { return 0; }
    if (GIDEP(S) != 0) { return 0; }
    if (_mv_callee(S, cfi) == 1) { return 1; }   # 6.7.17 (D99): a multi-value callee, refused there too
    if (_istr_vok(S, GFRS(S, cfi)) == 0) { return 0; }
    return 1;
}
# ⛔ 6.7.14 — A TOP-LEVEL `var H: Str = gt;` BINDS A HANDLE TO gt's HEADER, AS THE SAME LINE IN A FN DOES (the user's
# decision D21 (a), 2026-10-16): gt (an inline `Str` global, `var gt: Str = Str { .. };`) has a static address, so H
# is a handle global (8 bytes) holding it — `H.len = 3` writes gt.len — in the declaration zone and after the first
# statement alike. Both made H an inline 16-byte COPY of gt (`_gci_inline` / `_gci_init`, `_gci_toplevel`). A `var P:
# *Str = gt;` in the zone takes the same address, as after the first statement (6.7.14's D18 (c)). The untyped `var
# H = gt;` keeps gt's first word at top level (the user's D22 (b): 6.7.13's D6 (b) — an untyped global keeps the
# word). CHANGELOG [6.7.14]
# Pass 1, cursor on the RHS: 1 = `sid` is `Str` and the RHS a whole name (inside any wrap) of an inline `Str` global.
fn _istr_gsrc(S, sid): i64 {
    if (sid != _STR_SID(S)) { return 0; }
    var pk = _sci_pname(S, GTI(S));
    if (pk < 0) {   # 6.7.16 (D71): `*(&gt)`
        if (_istr_samp(S, GTI(S)) == 0) { return 0; }
        if (_istr_at(S, GTI(S), _gz_end(S, GTI(S))) != 2) { return 0; }
        return 1;
    }
    if (_istr_name(S, TOKVAL(S, GTI(S) + pk)) != 2) { return 0; }
    return 1;
}
# The zone replay, cursor on the RHS (`gps` the annotation's; a `*Str` reads 0, so its tokens are asked): such a
# `Str` / `*Str` declaration stores the global's static address into `dgv` (1, the cursor left on the `;`); else 0.
# A gt declared BELOW H binds too (the user's D17, 2026-10-18): its address is static, so the bind needs no layout pass
# 1 could not see — the reason `_gci_below` refuses a COPY from below. CHANGELOG [6.7.15]
fn _istr_gz(S, dgv, gps): i64 {
    var ss = _STR_SID(S);
    if (ss <= 0) { return 0; }
    if (gps != 0 - ss) {
        if (gps != 0) { return 0; }
        if (TOKTYP(S, GTI(S) - 4) != 49) { return 0; }
        if (_istr_pann(S, GTI(S) - 3) == 0) { return 0; }
        if (_istr_gzdx(S, dgv) == 1) { return 1; }   # 6.7.16 (D73): `var P: *Str = *GP;`
    }
    if (_istr_gsrc(S, ss) == 0) { return 0; }
