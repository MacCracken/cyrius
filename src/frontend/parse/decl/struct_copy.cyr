# declaration (`var y: *Str = *p;`, in a fn and at top level), a `*Str` field (`w.p = *p`) or a literal's `*Str`
# element, a `p: *Str` argument and `return *p;` from a fn returning `*Str` each took the word `*p` reads — the header's
# data pointer — as the header's address, silently or with a false "assigning non-pointer to typed pointer". A `Str`
# value stored where a `*Str` is held is its header's address (D7 (1), 6.7.15's D16, D19), and `*p` is the header p
# points at (6.7.10's decision 6), so the slot takes p. CHANGELOG [6.7.16]
# `*d = <v>` (`_deref_store`, the cursor on the value at `ti`, ending at `term`), the operand [d + 1, ti - 1) a `*Str`
# or a `**Str` (`*pp` the `*Str` slot, `_istr_dspp`): `*p` is p (1: parsed).
fn _istr_dsdx(S, d, ti, term): i64 {
    var ss = _STR_SID(S);
    if (ss <= 0) { return 0; }
    if (_hl_dpsid(S, d + 1, ti - 1) != ss) { if (_hl_dref_psid(S, d + 1, ti - 1) != ss) { return 0; } }
    return _istr_vdx(S, ti, _hl_dx_end(S, ti, term));
