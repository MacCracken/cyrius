            } elif (PEEKT(S) == 10) { _ti_inferred_sid = _var_rhs_wsid(S, GTI(S)); }   # 6.7.13: `var x = (mk1());`
        } }
    # v6.5.17 — the v6.3.8/v6.3.36 CLOSURE_TYID SLTYPE stamp is GONE. A capturing
    # closure now identifies itself at RUNTIME (bit 63 of its value; see the callptr
    # lowering in parse/expr.cyr), so a `var` holding one needs no special type — and
    # `var g = f;` needs no hand-written tag propagation, because there is nothing
    # left to propagate. Two bugs die with it: every escape the stamp could not
    # follow (param / return / global / memory / plain assignment) used to dispatch
    # as a bare fn pointer and SIGSEGV, and the sentinel 0x40000003 itself leaked
    # into SPSC as a POINTER SCALE, so `(f + 1) - f` on a closure local evaluated to
    # 1073741827 instead of 1.
    # parse expression (scalar) — use PCMPE for comparisons and &&/||
    # 6.6.6 (bite 14 review): armed, so a method / operator returning a struct stores it in a temp
    # this declaration can take — see `_sc_var_receive`. CHANGELOG [6.6.6]
    var scv_start = GTI(S);
    var scv_prev = _scv_arm(S, pscale, scalar_type + lfloat + slice_elt_w + lbool);   # 6.6.11; 6.7.11: + an untyped wrap
    _var_value(S);   # PCMPE; 6.7.16: a bare declaration's 0
    _scv_disarm(S, scv_prev);
    _scv_rec_ann(S, pscale, scv_start);   # 6.7.13 (D13): a method / operator struct result into `: i64`
    _bx_decl(S, lbool, noff, scv_start);   # 6.7.3 (B2): a bool takes a boolean value
    # 6.6.10: an integer constant into an `f64` / `f32` declaration warns (_IFS_CHECK), and an
    # UNTYPED declaration records whether its initialiser was a float (_UFV_*).
    # 6.7.6: and an f64 value into an `f32` declaration rounds to f32 (_f32_init_round).
    _decl_float_init(S, lfloat, scv_start);
    _ti_inferred_sid = _var_rhs_post(S, _ti_inferred_sid, pscale, scalar_type + lbool, scv_start, ann_ti);   # 6.7.9; 6.7.10
    var ufv = 0;
    if (pscale == 0) { if (scalar_type == 0) { if (lfloat == 0) { if (slice_elt_w == 0) { if (_ti_inferred_sid == 0) {
                        ufv = _UFV_IS_FLOAT(S);
                    } } } } }
    var dfc = 0;   # 6.6.11: a pure copy of a declared f64 / f32 value types the var (_decl_float_copy)
    if (ufv == 1) { dfc = _decl_float_copy(S, scv_start, GTI(S)); if (dfc != 0) { ufv = 0; } }
    # Type check: warn if pointer/scalar mismatch
    var expr_ps = GPSC(S);
    if (pscale > 0) {
        if (expr_ps == 0) { _tp_warn_decl(S, ann_ti, scv_start); }   # 6.7.11; 6.7.13: not the literal 0
    }
    # Check if inside function → local variable
    if (GINFN(S) == 1) {
        # Reject duplicate local var names
        # Allow same name in different scope (shadowing)
        var existing = FINDLOCAL(S, noff);
        if (existing >= 0) {
            if (GLDEP(S, existing) == GSDEP(S)) { ERRDUPVAR(S); }
        }
        # 6.6.6: `var p: S = b.mk(..)` / `var c: V3 = a + b` — the call's temp becomes `p`.
        if (_sc_var_receive(S, noff, pscale, scalar_type + lfloat + slice_elt_w + lbool, scv_start) == 1) {
            _expect_step(S, 5);
            return 0;
        }
        var li = GFLC(S);
        # v5.8.16 §8: 16-byte locals (slice, u128) layout-flip.
        # The slice convention puts ptr@offset 0 and len@offset 8
        # (slice_set / slice_ptr / slice_len all assume this).
        # On the stack, slot N+1 sits at a LOWER address than slot
        # N (locals grow down). Pre-fix we wrote the slice's ptr
        # field to slot li (the higher address) and treated slot
        # li+1 (the lower address) as the unused "high half" — but
        # then `slice_set(&s, ...)` issued `store64(&s + 8, len)`,
        # which lands at saved-rbp position rather than slot li+1.
        # §7 indexing tests passed by luck — they wrote and read
        # the corrupted location consistently and exited before
        # the corrupted rbp surfaced. §8 dot-field access made the
        # mismatch impossible to ignore (`s.len` reads from a
        # location slice_set never wrote to).
        #
        # Fix: for scalar_type==16, allocate the HIGH-HALF slot
        # FIRST (slot li, higher address) and the CANONICAL slot
        # SECOND (slot li+1, lower address). The name + meta live
        # on slot li+1 so FINDLOCAL returns it; EFLADDR(li+1)
        # yields the lower address; EFLADDR(li+1) + 8 lands on
        # slot li (higher address) = the second 8 bytes the
        # convention expects. Now slice_set / slice_ptr /
        # slice_len work correctly on fn-local slices, no rbp
        # corruption, no consumer changes.
        if (scalar_type == 16) {
            # High-half slot (allocated first, higher address) —
            # nameless, tracks no scope. This is where addr+8
            # lands once we install the canonical slot below.
            # 6.6.5: NAME -1, not 0. Name offset 0 is the FIRST LEXED WORD of the program,
            # and FINDLOCAL matches any slot with `sn >= 0` — so this unnamed high half
            # resolved for that identifier inside any fn that declared a slice or u128.
            S64(S + 0x5D9D000 + li * 8, 0 - 1);
            SLDEP(S, li, 0);
            SLTYPE(S, li, 0);
            SSLICE_W(S, li, 0);
            # Canonical (lower-address) slot — this is what the
            # name resolves to; EFLADDR returns its address.
            var li_canon = li + 1;
            S64(S + 0x5D9D000 + li_canon * 8, noff);
            SLDEP(S, li_canon, GSDEP(S));
            SLAGG(S, li_canon, 2);   # 6.6.5: a slice / u128 is a 2-slot INLINE pair
            SLTYPE(S, li_canon, 0);
            _sl_slice(S, li_canon, slice_elt_w, ann_ti);   # 6.7.8: width + slice bit 62 (C2-2a), element (C2-6a)
            _w16_local_init(S, li_canon, ann_ti);   # the initial value: a slice's, or (6.7.6) a u128's whole
            SFLC(S, li_canon + 1);
        } else {
            S64(S + 0x5D9D000 + li * 8, noff);
            SLDEP(S, li, GSDEP(S));
            if (lfloat != 0) {
                # f64/f32 local: tag the slot's type so access SESTYPEs it; store
                # the 8-byte value (f64 bits, or f32 bits in the low 32).
                SLTYPE(S, li, lfloat);
                EFLSTORE(S, li);
            } elif (scalar_type > 0) {
                if (scalar_type < 8) {
                    SLTYPE(S, li, scalar_type);
                    EFLSTORE_W(S, li, scalar_type);
                } else {
                    SLTYPE(S, li, 0);
                    EFLSTORE(S, li);
                }
            } else {
                # v5.10.4 — fold inferred sid (peeked pre-PCMPE) into
                # the no-annotation branch so `var x = f();` picks
                # up f's `: ReturnType` annotation as x's SLTYPE.
                # NOTE: scalar return inference (negative GFRS, i.e.
                # `var n = strlen(s);` where strlen is `: i64`) was
                # tried at v5.10.5 with SLTYPE = positive width
                # (8 for i64), but that encoding tripped the
                # parse/expr.cyr:263 width-aware load path which
                # SEXW(S, 8) marks expr_width = 8 and downstream
                # arithmetic emit narrowed incorrectly (`hlen -
                # nlen` returned -29 instead of 6 in the tcyr
                # strstr regression). Reverted: scalar-return
                # inference deferred to the future slot pinned at
                # `CYRIUS_TYPE_CHECK` default-on flip — same root
                # cause (need scalar-vs-pointer per-param distinction
                # before tracking i64-as-i64 vs i64-as-pointer).
                if (_ti_inferred_sid > 0) {
                    SLTYPE(S, li, 0 - _ti_inferred_sid);
                } elif (_ti_inferred_sid == 0 - 9) {
                    # v6.5.21 — `var x = f();` where f is `: f64` now types x as
                    # f64. Before this, the annotation bought the caller NOTHING:
                    # the local came back untagged, so `x + x` emitted an INTEGER
                    # add over the IEEE-754 bit pattern and returned garbage. That
                    # is why the `: f64` RETURN annotation shipped at v6.4.55 and
                    # then sat at TWO uses ecosystem-wide, both in our own tests —
                    # it was unusable, not unpopular.
                    # ⚠ This is deliberately NARROWER than the scalar-return
                    # inference reverted at v5.10.5 (see the note above): that one
                    # encoded `: i64` as a positive WIDTH (8), which tripped the
                    # width-aware load path at parse/expr.cyr:263 and narrowed
                    # downstream arithmetic. F64_TYID is 0x40000001, not a small
                    # positive width, so it cannot reach that path.
                    SLTYPE(S, li, F64_TYID);
                } elif (dfc != 0) {
                    SLTYPE(S, li, dfc);   # 6.6.11: `var t = p.y;` — see _decl_float_copy
                } else {
                    _sl_ptr_type(S, li, pscale, ann_ti);   # 6.6.16: 8 bytes; 6.6.17: `*Struct` dot syntax
                }
                EFLSTORE(S, li);
            }
            # v5.8.14 §6: per-local slice element width (0 = not a slice).
            SSLICE_W(S, li, slice_elt_w);
            # 6.6.5 — THE LAYOUT IS RECORDED HERE, AND THE ABSENCE OF THE MARK IS THE POINT.
            # This branch produces BOTH shapes of struct-typed local and nothing visible at the use
            # site tells them apart: one initialised from an address (`var p: P = alloc(16);`,
            # `var s = str_from(x);`) leaves the slot holding an ADDRESS, while a struct VALUE of 8 B
            # or less (`var q: S8 = mk8(1);`) is the slot. Leaving the bit clear for the handle is
            # what stops `p.y` reading the frame instead of the heap. 6.7.10 (B7-1): the line is the
            # initialiser at every size (the handle line), no longer the width — `_mark_small_init`.
            _mark_small_init(S, li, scv_start);
            # v6.3.35: mark a SIGNED sub-i64 scalar local with a NEGATIVE sentinel in the
            # (otherwise-0-for-scalars) slice-width table — slice-logic only checks `>0`, so
            # the sentinel is invisible to it. The load reads it to sign-extend (movsx).
            # 6.6.16: and a local `*i8`/`*i16`/`*i32` with its pointer mark (_sl_marks).
            _sl_marks(S, li, scalar_signed, scalar_type, slice_elt_w, pscale);
            SFLC(S, li + 1);
            SLFI(S, li, ufv);   # 6.6.10: set on EVERY declaration, after SFLC cleared it (see _UFV_L)
            _sl_last_marks(S, li, lbool, scalar_type, ann_ti);   # 6.7.3: last — the high half is rewritten above; 6.7.6: + bit 59; 6.7.8: + a `*T`'s kind, a declared scalar's name
        }
    } else {
        _sc_global_receive(S, pscale, scv_start);   # 6.6.6: no frame at top level — refused by name
        if (ann_ti == 0) { pscale = _gu_late(S, pscale, scv_start, _ti_inferred_sid); }   # 6.7.14 (D29 / D30): `var x = mk1();`; 6.7.17 (D22): a `Str`
        lfloat = _gzf_late(lfloat, pscale, scalar_type + slice_elt_w + dfc, _ti_inferred_sid);   # 6.7.16 (D98)
        var vcnt = GVCNT(S);
        S64(_varn_base + vcnt * 8, noff);
        if (lfloat != 0) {
            # f64/f32 local: 8-byte slot + float type marker → PEXPR/PARSE_TERM
            # route operators to EMIT_F64_BINOP (f32 type-only, converted via f32_*).
            S64(_vars_base + vcnt * 8, 8);
            SVTYPE(S, vcnt, lfloat);
            EVSTORE(S, vcnt);
        } elif (scalar_type > 0) {
            if (scalar_type < 8) {
                S64(_vars_base + vcnt * 8, scalar_type);
                SVTYPE(S, vcnt, scalar_type);
                # A signed iN global sign-extends on load, as PARSE_GVAR_REG's (v6.4.23): one
                # declared after the first top-level statement read zero-extended. CHANGELOG [6.7.16]
                SVSGN(S, vcnt, scalar_signed);
                EVSTORE_W(S, vcnt, scalar_type);
            } else {
                # 8 (i64 explicit) or 16 (u128) — allocate the full width.
                # Pre-4.8.0-alpha3 this hardcoded 8, truncating u128 vars
                # declared in the PARSE_PROG path (e.g. after a top-level
                # expression statement like `alloc_init();` that stops
                # pass 1 — see _tl_scan1's termination, parse/fn_def.cyr).
                S64(_vars_base + vcnt * 8, scalar_type);
                _w16_global_init(S, vcnt, scalar_type, ann_ti);   # 6.7.6 (D2): a u128 whole
            }
        } else {
            _vecg_size(S, vcnt, pscale);   # 6.6.17 (a3): 8, or a vector's 16/32 bytes
            if (pscale > 0) { _gv_ptr_type(S, vcnt, pscale, ann_ti); }   # 6.6.17: + T
            if (dfc != 0) { SVTYPE(S, vcnt, dfc); }   # 6.6.11: see _decl_float_copy
            # 6.6.5 — a STRUCT-annotated global declared on the PARSE_PROG path (any `var`
            # after the first top-level statement) recorded no type at all, so `G.y` was
            # refused with "no struct type in scope for 'G'" — a diagnostic blaming a missing
            # include for a global the compiler had just parsed. The SIMD descriptor band
            # (<= -2048) is excluded: it is not a struct sid. CHANGELOG [6.6.5]
            if (pscale < 0 && pscale > 0 - 2048) {
                _tup_svtype(S, vcnt, 0 - pscale, noff, ann_ti);   # 6.7.7: SVTYPE, never a pointer-mode tuple
                SVPM(S, vcnt, _gz_late(S, 0 - pscale, scv_start));   # 6.7.10 (B7-1g): the handle line
            }
            EVSTORE(S, vcnt);
        }
        SLVAR(S, vcnt);
        SGFI(S, vcnt, ufv);   # 6.6.10: see _UFV_G
        _gv_last_marks(S, vcnt, lbool, scalar_type, ann_ti);   # 6.7.3 (B2); 6.7.6: + the integer and u128 marks
        # 6.6.13 I11: an untyped `var g = f(..);` here records f for the Str -> cstring diagnostic,
        # as PARSE_GVAR_REG does for a global above the first statement (_gv_diag_sid).
        var gdc = 0;
        if (pscale == 0 && scalar_type == 0 && lfloat == 0 && slice_elt_w == 0 && dfc == 0) { gdc = _gv_rhs_call_sid(S, scv_start); }
        SVDSID(S, vcnt, gdc);
        _GVAR_VIS(S, vcnt, GTI(S));   # v6.6.4: stamp visibility — a global registered on the PARSE_PROG path (any `var` after the FIRST top-level statement) skipped PARSE_GVAR_REG entirely and was never private
        SVCNT(S, vcnt + 1);
    }
    _expect_step(S, 5);
    return 0;
}
