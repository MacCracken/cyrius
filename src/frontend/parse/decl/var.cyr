# PARSER — decl: PARSE_VAR.
# ================================================================
# Split from parse/decl.cyr at 6.7.18, unchanged; parse.cyr includes parse/decl/ in source order. CHANGELOG [6.7.18]

fn PARSE_VAR(S): i64 {
    STI(S, GTI(S) + 1);  # consume VAR
    # expect IDENT
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var noff = PEEKV(S);
    _RSV_INTRINSIC_DECL(S, noff, GTI(S), 0);   # 6.6.20: `var sizeof` / `var mulh64` / `var fncallN`
    _lc_var_dup(S, noff);                       # 6.7.2: a local const of this name in this scope
    STI(S, GTI(S) + 1);
    _dt_ann1(S);   # 6.7.17: `var a: i64, b = f();` refused, its annotation stepped
    # Multi-var destructure: var x, y[, z] = fn()
    if (PEEKT(S) == 31) {
        STI(S, GTI(S) + 1);  # consume ,
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
        var noff2 = PEEKV(S);
        _RSV_INTRINSIC_DECL(S, noff2, GTI(S), 0);
        STI(S, GTI(S) + 1);
        _dt_annk(S);
        # v6.5.21 — optional THIRD target: `var x, y, z = f();`
        var noff3 = 0;
        var _dt_n = 2;
        if (PEEKT(S) == 31) {
            STI(S, GTI(S) + 1);  # consume ,
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            noff3 = PEEKV(S);
            _RSV_INTRINSIC_DECL(S, noff3, GTI(S), 0);
            STI(S, GTI(S) + 1);
            _dt_annk(S);
            _dt_n = 3;
        }
        if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
        STI(S, GTI(S) + 1);  # consume =
        # v6.5.21 — peek the callee's return annotation BEFORE PCMPE consumes the
        # call, mirroring `_ti_inferred_sid` on the single-binding path. Without
        # this both destructured locals were registered SLTYPE 0, so
        # `var p, s = two(x, y); var d: f64 = p + s;` emitted an INTEGER add over
        # two IEEE-754 bit patterns and produced garbage — the transport was
        # always correct, the TYPE was what got dropped.
        var _dt_ftype = 0;
        var _dt_t1 = 0;
        var _dt_t2 = 0;
        var _dt_t3 = 0;
        # v6.5.21 — THE DESTRUCTURE CONTRACT. Before this there was none at all:
        # `var q, r = 42;` compiled, `var q, r = dm(17,5) + (k/9) - 11;` put the
        # idiv REMAINDER in r, and `var q, r = inner()?;` yielded garbage — every
        # one silently, because the second target simply read whatever rdx held.
        # A non-call right-hand side can never produce a second value, so it is
        # now rejected outright.
        # 6.6.16: `f(`, `g<..>(` or `x.m(` (`_dt_call_open`). CHANGELOG [6.6.16]
        # 6.6.17 (a5): factored into `_dt_rhs_check_t`, which the declaration-zone replay shares.
        # 6.7.14 (D45): inside parentheses that wrap the whole call (`_dt_peel`), closed after it.
        var _dt_d0 = _dt_dfr_n();   # 6.7.17: a refusal the chain's own error may stand for
        var _dt_wk = _dt_peel(S, 5);
        var _dt_fi = _dt_call_fn_d(S);
        if (_dt_icall_vec(S, 0) == 1) { _dt_fi = 0 - 1; }   # 6.7.16: `callptr(&f, ..)` / `fncallN(&f, ..)` of a vector f
        _dt_icall_pair(S, _dt_n);   # 6.7.17: `var a, b, c = callptr(&f, 4);` / `fncall1(&f, 4)`, f a pair
        if (_dt_fi >= 0) {
            var _dt_rs = GFRS(S, _dt_fi);
            if (_dt_rs == 0 - 9) { _dt_ftype = F64_TYID; _dt_t1 = F64_TYID; _dt_t2 = F64_TYID; _dt_t3 = F64_TYID; }
            _dt_arity_check(S, _dt_fi, _dt_n);   # 6.6.17 (a5): the declared AND the one-value arity
            if (_dt_rs == MULTIRET_SID) {
                # Declared `: (T1, T2[, T3])` — take the element types from the signature, so
                # the bindings need no annotation of their own.
                if (GFRT(S, _dt_fi, 0) == 0 - 9) { _dt_t1 = F64_TYID; }
                if (GFRT(S, _dt_fi, 1) == 0 - 9) { _dt_t2 = F64_TYID; }
                if (GFRT(S, _dt_fi, 2) == 0 - 9) { _dt_t3 = F64_TYID; }
            }
        }
        PCMPE(S);
        _dt_dfr_say(S, _dt_d0);
        _pw_close(S, _dt_wk);
        # rax = first value, rdx = second value (from ret2/return (a,b))
        if (GINFN(S) == 1) {
            # Register first local
            var li1 = GFLC(S);
            var li2 = li1 + 1;
            var li3 = li1 + 2;
            # First value: already in rax from the call.
            S64(S + 0x5D9D000 + li1 * 8, noff);
            SLDEP(S, li1, GSDEP(S));
            SLTYPE(S, li1, _dt_t1);
            EFLSTORE(S, li1);
            # v6.5.21: drain the THIRD slot BEFORE rdx. EMOVRA_R3 and EMOVRA_RDX
            # both land in rax, so reading rdx first would be overwritten by the
            # ret3 read. EFLSTORE only touches rax, so ret3 is still live here.
            if (_dt_n == 3) {
                EMOVRA_R3(S);
                S64(S + 0x5D9D000 + li3 * 8, noff3);
                SLDEP(S, li3, GSDEP(S));
                SLTYPE(S, li3, _dt_t3);
                EFLSTORE(S, li3);
            }
            # mov rax, rdx (get second return value)
            EMOVRA_RDX(S);
            S64(S + 0x5D9D000 + li2 * 8, noff2);
            SLDEP(S, li2, GSDEP(S));
            SLTYPE(S, li2, _dt_t2);
            EFLSTORE(S, li2);
            if (_dt_n == 3) { SFLC(S, li1 + 3); } else { SFLC(S, li1 + 2); }
        } else {
            # v6.6.0 — TOP-LEVEL destructure. This used to be refused outright, and the refusal
            # became load-bearing the moment `Result` went to the value form: binding BOTH halves
            # is the only correct way to receive a pair, so a top-level `var t, v = f();` had no
            # legal spelling at all and the stdlib flip could not land while it errored.
            # The global path mirrors the local one exactly, INCLUDING THE DRAIN ORDER — EMOVRA_R3
            # and EMOVRA_RDX both land in rax, so the third slot must be read BEFORE rdx
            # overwrites it. Indices are allocated in declaration order and the STORES are what
            # get reordered; doing it the other way round would number the names by emit order.
            # CHANGELOG [6.6.0].
            var gi1 = GVCNT(S);
            var gi2 = gi1 + 1;
            var gi3 = gi1 + 2;
            # Grow the var family BEFORE the name stores: the GVCNT < _var_cap invariant covers
            # only gi1, so gi2/gi3 written first landed past the cap — aliasing var_sizes[0] /
            # var_types[0] at 8190, or the next alloc'd table at 16382 (a silent miscompile).
            # SVCNT may reallocate, so _varn_base/_vars_base are read after it. CHANGELOG [6.6.10]
            if (_dt_n == 3) { SVCNT(S, gi1 + 3); } else { SVCNT(S, gi1 + 2); }
            S64(_varn_base + gi1 * 8, noff);
            S64(_vars_base + gi1 * 8, 8);
            if (_dt_t1 != 0) { SVTYPE(S, gi1, _dt_t1); }
            S64(_varn_base + gi2 * 8, noff2);
            S64(_vars_base + gi2 * 8, 8);
            if (_dt_t2 != 0) { SVTYPE(S, gi2, _dt_t2); }
            if (_dt_n == 3) {
                S64(_varn_base + gi3 * 8, noff3);
                S64(_vars_base + gi3 * 8, 8);
                if (_dt_t3 != 0) { SVTYPE(S, gi3, _dt_t3); }
            }
            # First value: already in rax from the call.
            EVSTORE(S, gi1);
            if (_dt_n == 3) { EMOVRA_R3(S); EVSTORE(S, gi3); }
            EMOVRA_RDX(S);
            EVSTORE(S, gi2);
            SLVAR(S, gi2);
            _GVAR_VIS(S, gi1, GTI(S));   # v6.6.4: stamp visibility — a global registered on the PARSE_PROG path (any `var` after the FIRST top-level statement) skipped PARSE_GVAR_REG entirely and was never private
            _GVAR_VIS(S, gi2, GTI(S));
            if (_dt_n == 3) { _GVAR_VIS(S, gi3, GTI(S)); }
        }
        _expect_step(S, 5);
        return 0;
    }
    # Optional type annotation: var x: type = ... or var x: *type = ...
    var pscale = 0;
    var scalar_type = 0;
    var scalar_signed = 0;   # v6.3.35: 1 for a SIGNED sub-i64 (iN) local, 0 for uN/other
    var lfloat = 0;   # v6.2.19 math arc: F64_TYID / F32_TYID for local `var x: f64`/`f32`
    var lbool = 0;    # 6.7.3 (B2): `var b: bool` — its initializer and every write are checked
    var slice_elt_w = 0;  # v5.8.14 §6: element width for slice<T>/[T] (0 = not a slice)
    var ann_ti = 0;       # 6.6.13 (M2): the annotation's type token (an array's element size)
    if (PEEKT(S) == 49) {
        STI(S, GTI(S) + 1);  # consume :
        ann_ti = GTI(S);
        if (PEEKT(S) == 8) {
            # Pointer type `*T`: T resolved by its WHOLE name, an unknown T refused; the scale is
            # sizeof(T) (6.6.17) — a local keeps an 8-byte slot (_sl_ptr_type).
            pscale = _ptr_annot(S, noff, 0);
        } elif (PEEKT(S) == 28) {
            # v5.8.9 §1: `[T]` slice type sugar — `var x: [u8] = ...`.
            # v5.8.10 §2: 16-byte {ptr, len} slot (u128 path).
            # v5.8.14 §6: capture element width for §7 sized indexing.
            STI(S, GTI(S) + 1);  # consume [
            if (PEEKT(S) == 8) {
                # Pointer element: [*T] — width = 8 (pointer size); T must name a type (6.6.16)
                STI(S, GTI(S) + 1);  # consume *
                slice_elt_w = 8;
                _tn_slice_ptr_el(S, noff);   # consume T (6.7.8: `*[U]` refused by name)
            } elif (_tn_slice_head(S) == 1) {   # 6.7.7: + a tuple's `(`, refused by _tn_slice_w
                # Element [u8], [i32], [Foo], [u128]: sizeof(T) by the WHOLE name (a bound type
                # parameter by its argument); an unknown name is refused — it was 8. CHANGELOG [6.6.16]
                slice_elt_w = _tn_slice_w(S, GTI(S), noff);
                STI(S, GTI(S) + 1);
            }
            if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
            STI(S, GTI(S) + 1);  # consume ]
            SKIP_GENERICS(S);
            scalar_type = 16;
        } elif (PEEKT(S) == 105) {
            # u128 type
            scalar_type = 16;
            STI(S, GTI(S) + 1);
        } elif (_sl_word_builtin(S) == 1) {   # 6.7.11: a program's own `struct slice` wins (see there)
            # v5.8.10 §2: `slice<T>` ident form — 16-byte {ptr,len} slot.
            # v5.8.14 §6: extract element width from <T> for §7 indexing.
            # Bytes for "slice\0" = 0x006563696C73 (little-endian load64
            # lower 6 bytes; 's'=0x73 'l'=0x6C 'i'=0x69 'c'=0x63 'e'=0x65, NUL).
            # 6.6.16: the WHOLE word (the NUL is in the mask): `slices` / `slicer` were a slice.
            # Manual <T> parsing replaces SKIP_GENERICS so we can capture T.
            scalar_type = 16;
            STI(S, GTI(S) + 1);  # consume "slice"
            if (PEEKT(S) == 19) {  # `<`
                STI(S, GTI(S) + 1);  # consume <
                if (PEEKT(S) == 8) {
                    STI(S, GTI(S) + 1);  # consume *
                    slice_elt_w = 8;
                    _tn_slice_ptr_el(S, noff);
                } elif (_tn_slice_head(S) == 1) {   # 6.7.7: + a tuple's `(`
                    slice_elt_w = _tn_slice_w(S, GTI(S), noff);   # 6.6.16 (C8): as `[T]` above
                    STI(S, GTI(S) + 1);
                }
                if (PEEKT(S) == 20) { STI(S, GTI(S) + 1); }  # consume >
            }
        } else {
            var _gs_sid = 0;   # v6.3.10: base sid if `: StructName` resolved (for generic-struct instantiation below)
            if (_tn_head_var(S, noff) == 1) {   # 6.7.7 (B4): or a tuple type's `(`; 6.7.14: else refused by name
                # ⛔ 6.6.16 (C8): the one type-name resolver (parse/types.cyr _tn_var_ann).
                # This ladder matched PREFIXES (`i8x` an i8, `f64zz` an f64, the struct
                # `u8pair` a u8 scalar before the struct lookup) and read an unknown name as a
                # silent i64; a bound type parameter took its argument's raw code as a WIDTH
                # (T = f64 a 9-byte word, T = i8 never sign-extended). Now: iN/uN set the width
                # (and the sign of i8/i16/i32), f64/f32 the float tag, a vector its descriptor
                # sentinel, a struct `0 - sid` — for a bound T exactly as for its argument
                # spelled out; bool, cstring, Vec, an enum, Result/Option/Tagged or an unbound
                # type parameter stay a plain i64; any other name is refused by name.
                # CHANGELOG [6.6.16]
                var _lc = _tn_var_ann(S, GTI(S), noff);
                scalar_type = _tn_iw(_lc);
                scalar_signed = _tn_sgn(_lc);
                lfloat = _tn_flt(_lc);
                lbool = _tn_bool(_lc);
                _gs_sid = _tn_sid(_lc);
                pscale = _tn_vec(_lc) - _gs_sid;
            }
            STI(S, GTI(S) + 1);
            # v6.3.10 (generic structs): `var x: Box<conc>` retargets the local to the instance
            # sid; see _gen_ann_sid (6.6.11: shared with the declaration-zone global path).
            var _gi = _gen_ann_sid(S, _gs_sid);
            if (_gi != _gs_sid) { pscale = 0 - _gi; }
        }
    }
    # v6.5.61 — INFER THE VECTOR TYPE FROM THE CALLEE'S RETURN TYPE WHEN THE VAR HAS NONE.
    #
    # The 128-bit and 256-bit receive paths below are gated entirely on `pscale`, and `pscale`
    # came ONLY from the var's own type annotation. So `var r: f64v2 = f64v2_add(a, b);` stored
    # both halves, while `var r = f64v2_add(a, b);` — the spelling a user reaches for first —
    # fell through to the SCALAR init and read back as zero. Silent: exit 0, no diagnostic,
    # wrong numbers. Every width was affected (f32v4 → 4, f64v2 → 0, f64v4 → 0) and every
    # vector-returning fn, stdlib or user-defined, not just `lib/simd.cyr`.
    #
    # ⚠ The corpus could not see this because every existing call site spells the annotation:
    # `var sum: f64v2 = f64v2_add(&x, &y);`. An API's most natural spelling being the one no
    # test uses is exactly the blind spot the v6.5.55 payload-enum sweep found from the other
    # side — write the test for the shape a consumer writes, not the shape the stdlib writes.
    #
    # The callee's return sid is already recorded, so the annotation is redundant information.
    # Take it from GFRS when the var declares none; a var that DOES declare one keeps it (a
    # mismatch is diagnosed at the receive paths below rather than silently truncated).
    # v6.5.67 — a `: stack` enum call bound to ONE variable keeps the tag and silently drops the
    # payload. Refuse it. The two-variable destructure is handled earlier in this fn, so reaching
    # here with a pair-returning callee means the payload is about to be lost. 6.7.6: at top level
    # too (a global after the first statement; the declaration zone's replay is `_gvi_expr`).
    # 6.7.7 (B4): `_tup_var` runs it — first taking a tuple literal initializer, which declares the
    # whole tuple here (1: done).
    if (_tup_var(S, noff, pscale, ann_ti) == 1) { return 0; }
    pscale = _vin_decl(S, pscale, scalar_type, ann_ti);   # 6.7.15: out of PARSE_VAR (cybs), + the top-level arm

    # v5.5.36 Phase 2: `var p: StructName;` — stack-local struct
    # with no initializer. `pscale < 0` means the type annotation
    # resolved to a struct id (FINDSTRUCT returned sid, `pscale`
    # was set to 0 - sid above). If the next token is `;`, we've
    # hit the uninitialized-struct case: allocate stack space and
    # register a struct-typed local.
    #
    # Same anonymous+named-slot trick as `stack var`: reserve
    # ceil(STRUCTSZ/8) fn-local slots, sentinel-name all but the
    # last, give the last slot `ltype = -sid` so PARSE_FIELD_LOAD /
    # PARSE_FIELD_STORE's existing local-struct branch resolves
    # field offsets correctly. FINDLOCAL skips sentinel slots via
    # the `sn >= 0` gate, and the named slot lives at the deepest
    # frame offset — so `&p` points at the BOTTOM of the struct,
    # which is where field 0 lives.
    if (pscale < 0 && PEEKT(S) == 5) {
        if (GINFN(S) != 1) { return _usl_top(S, noff); }   # 6.7.16: refused in sync, `noff` entered as reported
        var sv_sid = 0 - pscale;
        var sv_sz = 0;
        # SIMD band (sentinel <= -2048, below the struct-sid range): size via
        # the structured descriptor. f64v2 (-2093) -> 2 slots / 16 bytes,
        # f64v4 (-2125) -> 4 slots / 32 bytes, f32v4 (-2121) -> 2 slots.
        # v6.4.14 folded the old flat f64v2/f64v4 -20/-21 cases into this
        # band (they collided with struct-ids 20/21); _vec_desc handles all.
        if (pscale <= 0 - 2048) { _vec_desc(S, pscale); sv_sz = GVEC_NSLOTS(S) * 8; }
        else { sv_sz = STRUCTSZ(S, sv_sid - 1); }
        if (sv_sz < 8) { sv_sz = 8; }
        var sv_aligned = (sv_sz + 7) & (0 - 8);
        var sv_nslots = sv_aligned / 8;
        # Duplicate-name check
        var sv_existing = FINDLOCAL(S, noff);
        if (sv_existing >= 0) {
            if (GLDEP(S, sv_existing) == GSDEP(S)) { ERRDUPVAR(S); }
        }
        # Anonymous filler slots
        var sv_j = 0;
        while (sv_j < sv_nslots - 1) {
            var sv_li = GFLC(S);
            S64(S + 0x5D9D000 + sv_li * 8, 0 - 1);
            SLDEP(S, sv_li, GSDEP(S));
            SLTYPE(S, sv_li, 0);
            SFLC(S, sv_li + 1);
            sv_j = sv_j + 1;
        }
        # Named slot with struct-type marker (ltype = -sid)
        var sv_named = GFLC(S);
        S64(S + 0x5D9D000 + sv_named * 8, noff);
        SLDEP(S, sv_named, GSDEP(S));
        SLAGG(S, sv_named, sv_nslots);   # 6.6.5: `var p: T;` is inline, at EVERY width and on every target
        SLTYPE(S, sv_named, 0 - sv_sid);
        SFLC(S, sv_named + 1);
        STI(S, GTI(S) + 1);   # consume ';'
        return 0;
    }
    # v6.3.36 (issue [6]) — `var b: P = a;` struct-to-struct copy-init from a
    # local struct variable (as opposed to a fn call, handled by the asv paths).
    if (ann_ti == 0) { if (pscale == 0) { pscale = _uci_ps(S); } }   # 6.7.12 (D29): untyped `var q = p;`
    if (_try_struct_copy_init(S, noff, pscale) == 1) { return 0; }
    # v5.5.36 Phase 2b — struct-valued assignment from a fn call:
    #   `var got: Point = make(args);`
    # Allocates `got` as a stack-local struct (same slot-trick as the
    # no-init case above), then calls `make` with &got prepended as
    # the hidden first arg. The callee's `return p;` copies bytes
    # straight into &got, so `got` is populated when we fall through.
    # No post-call rax-to-local store is needed; rax = &got (return
    # convention) is discarded.
    # Scope the branch strictly: (a) inside a fn, (b) struct type
    # annotation present, (c) next-token `=`, (d) RHS is IDENT `(`,
    # (e) that IDENT resolves to a fn with a declared struct return.
    # This way the existing module-scope pattern
    # `var a: Num = 20;` (where Num is a wrapper struct and the
    # init expression is a plain scalar) falls through to PCMPE-
    # as-usual instead of being rejected here.
    # v5.10.28 — `var x: f64v2 = f();` caller-side path.
    # f64v2 returns split rax+rdx (pair-register on SysV/aarch64/cx).
    # Caller must:
    #  (a) allocate 2-slot stack-local (16 bytes) for x
    #  (b) compile RHS (the fn call) — result lands in rax (lo) + rdx (hi)
    #  (c) store rax → x's named slot (lo, &x+0)
    #      store rdx → x's filler slot (hi, &x+8)
    # Detected via pscale == -20 (f64v2 sentinel from the type
    # annotation parser) AND RHS is `IDENT(...)` whose target fn
    # was annotated `: f64v2` (GFRS == -20).
    #
    # v5.10.31 — Win64 PE branch: ≤16B composite returns use
    # retptr-style. Caller allocates the 16B local up front,
    # pushes &local as hidden first arg (RCX on Win64), the
    # callee writes through the retptr. No post-call store needed
    # (the local is already populated). Mirror of the existing
    # big-struct asv path at line ~1063.
    if (_vrcv_decl(S, noff, pscale, ann_ti) == 1) { return 0; }   # 6.7.11: wrapped, or through fncallN / callptr (6.7.13: a method; untyped)
    if ((_is_simd128(S, pscale) == 1) && (PEEKT(S) == 4) && (GINFN(S) == 1)) {  # any 16B/1-XMM vector receive
        var _f2c_look_ti = GTI(S) + 1;
        if (TOKTYP(S, _f2c_look_ti) == 2) {
            if (_vrcv_wcall(S, _f2c_look_ti) == 1) {   # 6.7.16 (D24): the whole initialiser
                var _f2c_look_noff = TOKVAL(S, _f2c_look_ti);
                var _f2c_look_fi = FINDFN(S, _f2c_look_noff);
                if (_f2c_look_fi >= 0) {
                    if (GFRS(S, _f2c_look_fi) == pscale) {  # callee's ret sid matches the var's f64v2/f32v4 tag
                        # Allocate 2-slot stack-local (filler + named, like
                        # the v5.5.36 Phase 2 struct-local pattern).
                        var _f2c_existing = FINDLOCAL(S, noff);
                        if (_f2c_existing >= 0) {
                            if (GLDEP(S, _f2c_existing) == GSDEP(S)) { ERRDUPVAR(S); }
                        }
                        # Filler slot (hi half = &x+8)
                        var _f2c_fill = GFLC(S);
                        S64(S + 0x5D9D000 + _f2c_fill * 8, 0 - 1);
                        SLDEP(S, _f2c_fill, GSDEP(S));
                        SLTYPE(S, _f2c_fill, 0);
                        SFLC(S, _f2c_fill + 1);
                        # Named slot (lo half = &x+0)
                        var _f2c_named = GFLC(S);
                        S64(S + 0x5D9D000 + _f2c_named * 8, noff);
                        SLDEP(S, _f2c_named, GSDEP(S));
                        SLAGG(S, _f2c_named, 2);   # 6.6.5: inline 2-slot vector receive
                        SLTYPE(S, _f2c_named, pscale);  # tag the received local f64v2(-20) or f32v4(-2121)
                        SFLC(S, _f2c_named + 1);
                        STI(S, GTI(S) + 1);  # consume '='
                        if (_TARGET_PE == 1) {
                            # Win64 retptr-style call. Mirror of asv
                            # path at line ~1063: push &named first,
                            # then user args, ECALLPOPS pops into RCX
