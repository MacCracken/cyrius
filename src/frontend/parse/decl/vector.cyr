# ⛔ 6.7.14 (D38 A, the user's decision, 2026-10-16) — A METHOD DECLARED TO RETURN A VECTOR INTO A DESTINATION OF
# ANOTHER TYPE IS REFUSED BY NAME, as the by-name call is (PARSE_VAR's check, `_try_vector_call_assign`; since 6.7.11):
# `var x: i64 = s.mv();` and `x = s.mv();` compiled, storing a word (x86_64 / aarch64 0, cx / PE 41). The whole method
# call at the cursor (`term` after it) into the declaration annotated `pscale` (`ann` its token; none: the untyped
# declaration's, D37) / the local `noff` — neither a 16 / 32-byte vector, whose receives refuse another vector
# themselves — of another type: "vector return type does not match the declared type" / ".. the assigned variable". 0.
# CHANGELOG [6.7.14]
# ⛔ 6.7.15 — every spelling of the call (`_vcall_vt`): inside parentheses (D28 A, the user's decision, 2026-10-18: `var
# x: i64 = (mk2(41, 7));`, `x = (s.m2());` stored a word), `fncallN(&f, ..)` / `callptr(&f, ..)`, and into the
# declaration a method or an indirect call that STARTS the initialiser (D29 A, 2026-10-18: `var x: i64 = s.m2() + 1;`
# gave 1, cx / PE 42), as the by-name call has since 6.7.11. CHANGELOG [6.7.15]
fn _vrcv_mscal(S, pscale, ann): i64 {
    if (ann == 0) { return 0; }
    var mt = _vcall_vt(S, GTI(S) + 1, 5, 1);
    if (mt == 0) { return 0; }
    if (mt == pscale) { return 0; }
    if (_vrcv_annbad(S, GTI(S)) == 1) { return 0; }   # 6.7.16: a refused annotation's one error
    _refuse_in_sync(S);   # 6.7.16: the statement parses on; the next one keeps its errors
    ERR_MSG(S, "vector return type does not match the declared type", 51);
    return 0;
}
# ⛔ 6.7.15 — AND INTO A GLOBAL THAT IS NO VECTOR, and `fncallN(&f, ..)` / `callptr(&f, ..)` into a scalar local: the
