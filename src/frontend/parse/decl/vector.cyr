# The accepted source of kind `k` (`_vrcv_src`; cursor on it) into the vector at slot `dst` of type
# `ty`: inside its parentheses, the call — on PE passing `dst`'s address as its hidden result pointer,
# elsewhere storing the vector registers it returns in — then the parentheses' `)`.
fn _vrcv_emit(S, dst, ty, k): i64 {
    var w = _vrcv_k;
    STI(S, GTI(S) + w);
    if (_TARGET_PE == 1) {
        if (k == 1) { _vrcv_pe_call(S, dst); }
        elif (k == 3) {   # 6.7.13 (D29): the method arm's `_sc_pre` passes dst's address, before `self`
            _sc_vbeg = GTI(S);
            _sc_vdst = dst;
            PCMPE(S);
            _sc_vbeg = 0 - 1;
        } else {
            _icall_vbeg = GTI(S);
            _icall_vdst = dst;
            PCMPE(S);
        }
    } else {
        PCMPE(S);
        _vec_desc(S, ty);
        if (GVEC_NSLOTS(S) == 4) { EFLSTORE_F64V4_PAIR(S, dst); }
        else { EFLSTORE_F64V2_PAIR(S, dst); }
    }
    _pw_close(S, w);
    return 0;
}
# PE: the by-name call `f(..)` at the cursor with `dst`'s address its hidden result pointer (int arg
# 0), as the receives' own Win64 arm emits it.
fn _vrcv_pe_call(S, dst): i64 {
    var fnoff = PEEKV(S);
    var fi = _vcall_fi(S, GTI(S));   # 6.7.13: an explicit instance's, past its `<..>`
    fi = _pe_venter(S, fi);   # 6.7.14 (D33): `f(&a, ..)` -> `f_ptr`
    EFLADDR(S, dst);
    EPUSHR(S);
    var n = _owncall_args(S, fi, fnoff, 1);
    var t = L64(_fnt_offsets + fi * 8);
    if (t >= 0) { ECALLTO(S, t); }
    else { ECALLFIX(S, fi); }
    ECALLCLEAN(S, n);
    return 0;
}
# PARSE_VAR, cursor on `=`: `var v: <vector> = <src>;` in a fn for an accepted source the receives
# there do not take — inside parentheses, through fncallN / callptr, or (6.7.13) an explicit instance
# `g<T>(..)` or a method `x.m(..)`: the inline receives below test `IDENT (`. 1 = declared.
# ⛔ 6.7.13 (D29 A, the user's decision, 2026-10-15) — AN UNANNOTATED `var v = callptr(&f, ..);` /
# `fncallN(&f, ..)` WITH `f` DECLARED TO RETURN A VECTOR IS THAT VECTOR'S LOCAL, as `var v = f(..);` is (v6.5.61): it
# bound one word — `lanes(v)` was refused "value-form SIMD arg must be a 16-byte vector" on x86_64 / aarch64 / cx, and on
# PE `v` held lane 0, which the value-form parameter took as the vector's address (exit 5). `ann` = the annotation's
# token (0: none); the call must be the whole initialiser. A callee held in a variable stays a word (D32).
fn _vrcv_decl(S, noff, pscale, ann): i64 {
    if (GINFN(S) != 1) { return 0; }
    if (PEEKT(S) != 4) { return 0; }
    if (pscale == 0) { if (ann == 0) { pscale = _vrcv_ity(S, GTI(S) + 1); } }
    if (_vrcv_vec(S, pscale) == 0) { return _vrcv_mscal(S, pscale, ann); }   # 6.7.14 (D38): `var x: i64 = s.mv();`
    var k = _vrcv_src(S, GTI(S) + 1, pscale, 5);
    if (k == 0) {
        _vrcv_bad(S, GTI(S) + 1, pscale, 5, 0);   # a call of another vector, wrapped or not
        return 0;
    }
    if (_vrcv_k == 0) { if (k == 1) { if (_vrcv_g == 0) { return 0; } } }   # 6.7.13: `g<T>(..)` is ours
    _vec_desc(S, pscale);
    var named = _sci_slots(S, noff, pscale, GVEC_NSLOTS(S));
    STI(S, GTI(S) + 1);   # `=`
    if (k == 4) { _vrcv_demit(S, named, pscale, "initialised", noff); }   # 6.7.13 (D34): `*p`
    else { _vrcv_emit(S, named, pscale, k); }
    _expect_step(S, 5);
    return 1;
