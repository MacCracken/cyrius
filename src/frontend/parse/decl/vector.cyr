# PARSER — decl: vector values — vector-valued calls and their receives (`_vmc_*`, `_vrcv_*`), vector operators and
# slices (`_vop_*`, `_vsl_*`), array element types (`_arr_*`).
# ================================================================
# Split from parse/decl.cyr at 6.7.18, unchanged; parse.cyr includes parse/decl/ in source order. CHANGELOG [6.7.18]

# v6.5.61 — `r = f(...);` where `r` is a VECTOR local and `f` returns that vector.
#
# The DECLARATION form `var r: f64v2 = f(...)` has had a 16/32-byte receive since v5.10.28
# (the `_is_simd128` / `_is_simd256` paths in PARSE_VAR below). The ASSIGNMENT form never got
# one: it fell through to the generic `EFLSTORE(S, idx)` in parse/assign.cyr, an 8-BYTE store, so a
# correctly-declared `var r: f64v2;` followed by `r = f64v2_add(a, b);` kept at most the low
# half and read back as zero — with only a misleading "assigning non-pointer to typed pointer"
# warning to show for it.
#
# ⭐ EXACTLY THE SPLIT v6.5.57 CLOSED FOR STRUCTS ("the assignment path gets the multi-word copy
# the declaration path has had"), one type-class over. That fix added
# `_try_aggregate_copy_assign` for the local-to-local shape `c = a`; the CALL-RHS shape was
# still uncovered for structs' vector siblings. When a receive path is added to declarations,
# the assignment path is not a separate feature — it is the other half of the same statement.
#
# Mirrors PARSE_VAR's receive exactly, including the Win64 retptr branch: on PE a 16/32-byte
# return is written through a hidden pointer, so the destination address is pushed as arg 0
# rather than a pair being stored after the call.
fn _try_vector_call_assign(S, noff, term): i64 {
    if (GINFN(S) != 1) { return _vasg_gtop(S, noff, term); }   # 6.7.16: a top-level assignment
    var vo = _vrcv_asg(S, noff, term);   # 6.7.11
    if (vo >= 0) { return vo; }
    var dst_li = FINDLOCAL(S, noff);
    var vfi = 0 - 1;
    if (dst_li >= 0) { if (_gcall_open(S, GTI(S)) >= 0) { vfi = _vcall_fi(S, GTI(S)); } }   # 6.7.13: `g<T>(..)` too
    # Not a by-name vector call into a local: 6.7.14 (D38) `x = s.mv();`; 6.7.15 a global, `x = fncallN(&f, ..)`.
    if (vfi < 0) { return _vasg_mscal(S, noff, term); }
    var vrs = GFRS(S, vfi);
    var lt = GLTYPE(S, dst_li);
    # Destination is not the vector the callee returns. Diagnose rather than fall through to
    # the 8-byte store, which is what made every form of this silent (see the header above).
    if (lt != vrs) {
        _refuse_in_sync(S);   # 6.7.16: the statement parses on; the next one keeps its errors
        ERR_MSG(S, "vector return type does not match the assigned variable", 55);
        return 0;
    }
    if (_vec_desc(S, lt) != 1) { return 0; }
    var vns = GVEC_NSLOTS(S);
    if (vns <= 1) { return 0; }
    if (_TARGET_PE == 1) {
        var vnoff = PEEKV(S);
        vfi = _pe_venter(S, vfi);   # v6.6.4: PE retptr receive emits its own call (6.7.13: past `<..>`; 6.7.14: routed)
        EFLADDR(S, dst_li);
        EPUSHR(S);
        # 6.6.6: the arguments through `_owncall_args` — the gates AND the arity check, which
        # this PE-only loop never had (`v = f(3)` on a 2-param `f` built clean). CHANGELOG [6.6.6]
        var vargc = _owncall_args(S, vfi, vnoff, 1);
        var vtarget = L64(_fnt_offsets + vfi * 8);
        if (vtarget >= 0) { ECALLTO(S, vtarget); }
        else { ECALLFIX(S, vfi); }
        ECALLCLEAN(S, vargc);
    } else {
        PCMPE(S);
        if (vns == 4) { EFLSTORE_F64V4_PAIR(S, dst_li); }
        else { EFLSTORE_F64V2_PAIR(S, dst_li); }
    }
    _expect_step(S, term);   # consume the terminator
    return 1;
}

# ⛔ 6.7.11 — A VALUE-FORM VECTOR LOCAL TAKES A VECTOR, OR NOTHING. A vector local gets its 16 / 32 bytes
# — the register pair stored, or on PE the callee's hidden result pointer passed — only from a source
# that IS that vector: a local of its type (`_try_struct_copy_init`, `_try_aggregate_copy_assign`), a
# by-name call declared to return it, that call inside parentheses, and `fncallN(&f, ..)` /
# `callptr(&f, ..)` with `f` declared to return it (`_icall_vret` on PE). Any other source was stored
# as ONE word with the high lanes stale, and on PE a call returning the vector wrote through its first
# argument: refused by name, in the declaration and the assignment (the user's decision, 2026-10-13),
# as the same sources are as a vector RETURN (6.6.6). CHANGELOG [6.7.11]
var _vrcv_k = 0;    # the parentheses `_vrcv_src` found around the source
var _vrcv_g = 0;    # 1 = the by-name source `_vrcv_byname` took is an explicit instance (`g<T>(..)`)
# ⛔ 6.7.13 — A CALL DECLARED TO RETURN A VECTOR, BY NAME: `f(..)`, or an explicit instance `g<T>(..)` (`_gcall_open`
# steps over its `<..>`). Every vector receive tested `IDENT (`, so `v = mkg<i64>(41, 7);` was refused, `var v: f64v2 =
# mkg<i64>(..)` dropped its annotation (a one-word local: `load64(&v + 8)` read garbage, silently), and `return
# mkg<i64>(..)` from a `: f64v2` fn was refused — an explicit instance is a by-name call declared to return the vector,
# which 6.7.11's rule accepts. At token `ti`: the fn the call reaches (`IDENT (`: FINDFN, as ever; `g<T>(`:
# `_gen_resolve_call`, asked only once the base is declared to return a vector — a type argument never makes one), else
# -1; `_vcall_o` its `(`. CHANGELOG [6.7.13]
var _vcall_o = 0;
fn _vcall_fi(S, ti): i64 {
    var o = _gcall_open(S, ti);
    if (o < 0) { return 0 - 1; }
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return 0 - 1; }
    if (GFRS(S, fi) > 0 - 2048) { return 0 - 1; }
    if (o != ti + 1) { fi = _gen_resolve_call(S, ti); }
    _vcall_o = o;
    return fi;
}
# ⛔ 6.7.13 (D29 A, the user's decision, 2026-10-15) — A METHOD CALL DECLARED TO RETURN A VECTOR IS ONE: `x.m(..)` on a
# single name typed as a struct (`_tok_method_open`, `_pair_callee_at`), at the instance its arguments reach
# (`_mcall_gen`, quietly, as `_var_rhs_msid` resolves it). Every vector receive refused it ("got `s`"), where a by-name
# call declared `: f64v2` was taken. At token `ti`: that method's fn when it is declared to return a vector, else -1;
# `_vcall_o` its `(`. Its call is the method arm's (`_field_load_on`), which on Win64 passes a receive's own
# destination as the hidden result pointer (`_sc_vbeg`, parse/fn/call_agg.cyr). CHANGELOG [6.7.13]
# 6.7.15: on a field chain `h.f.m(..)` too (`_vmc_open`).
fn _vmc_fi(S, ti): i64 {
    var o = _vmc_open(S, ti);   # 6.7.15: `x.m<..>(` too, at its explicit instance
    if (o < 0) { return 0 - 1; }
    var mf = _vmc_mf;
    if (mf < 0) { return 0 - 1; }
    var mt = _vmc_mt;
    if (o == mt + 1) { mf = _mcall_gen(S, mf, o, _vmc_rs, 0); }
    _vmc_mt = mt;
    if (mf < 0) { return 0 - 1; }
    if (GFRS(S, mf) > 0 - 2048) { return 0 - 1; }
    _vcall_o = o;
    return mf;
}
# ⛔ 6.7.15 — A METHOD ON A FIELD CHAIN IS A METHOD CALL AT EVERY VECTOR RECEIVE: 6.7.13's D29 A (a method declared
# `: V` is a call declared to return it) and 6.7.14's D37 / D38 / D39 hold for any receiver spelling, and only this
# recogniser knew a single name — `var v = w.s.mv();` bound one word of stack garbage, the other receives refused
# "got `w`". The method call at token `ti` — `x.m(` / `x.m<..>(` on a single name (`_mcall_open`, `_pair_callee_at`)
# or on a field chain (`_mch_open`): its `(`, else -1; `_vmc_mf` the method's fn (a generic's base, an explicit
# instance's), `_vmc_mt` its name token, `_vmc_rs` the receiver's struct. CHANGELOG [6.7.15]
# 6.7.16: `_mcall_open` answers a chain itself (`_mco_ch`), as every pair / multi-value asker now reads one.
var _vmc_mf = 0 - 1;
var _vmc_mt = 0;
var _vmc_rs = 0;
fn _vmc_open(S, ti): i64 {
    var o = _mcall_open(S, ti, 0 - 1);
    if (o < 0) { return 0 - 1; }
    if (_mco_ch == 1) {   # a chain's last method (6.7.16: `o.gp(..).s.mv()` too)
        _vmc_mf = _mco_inst(S, _mco_mf, _mco_mt, o);
        _vmc_mt = _mco_mt;
        _vmc_rs = _mco_rs;
        return o;
    }
    _vmc_mf = _pair_callee_at(S, ti);
    _vmc_mt = ti + 2;
    _vmc_rs = _recv_sid(S, TOKVAL(S, ti));
    return o;
}
# The last method of the chain at token `ti` — `h.f(.g)*.m(` / `.m<..>(`, each step a field an inline struct's
# (GETFTYPE) or a `*S`'s (`_fld_ptr_sid`) or a method whose result is a struct or a `*S` — the hops the method arm takes
# (`_load_inline_hop`, `_load_hop`, `_method_chain`) — and `m` a method of the last one's struct (`_meth_fn_at`; `<..>`
# as the arm reads it, `_mtargs_at`): its `(` and `_vmc_*`, as `_vmc_open`; else -1. The head `h` (`_mch_head`): a name
# typed as a struct or a pointer to one (`_dyn_base_sid`, a chain's base as `_chain_leaf` reads it; then a step at
# least, `x.m(` is `_mcall_open`'s).
# ⛔ 6.7.16 — AND ANY HEAD THE METHOD ARM TAKES: a parenthesised one — `(*ps).mv()`, `(*pw).s.mv()`, `(s).mv()`,
# `(gw(&w)).s.mv()` (`_paren_field`) — a call — `gw(&w).s.mv()`, `mks(1).mv()`, `callptr(&gw, &w).s.mv()` (`_call_field`,
# `_icall_chain`) — and a method's result mid-chain (`o.gp(&w).s.mv()`). 6.7.15 read a name head only: on any other,
# `var v = ..;` bound one word of stack garbage, `var x: i64 = ..;` stored a word, `var v: f64v2 = ..;` was refused
# "got `(...)`" (issues/archived/2026-10-18-vector-method-on-dereference-or-call-head-receiver-binds-a-word.md). The typers it
# asks are lookaheads: their answers stay their callers'. CHANGELOG [6.7.16]
fn _mch_open(S, ti): i64 {
    if (ti > 0) { if (TOKTYP(S, ti - 1) == 41) { return 0 - 1; } }   # mid-chain: not its head
    if (_mchain_at(S, _mch_hend(S, ti)) == 0) { return 0 - 1; }   # no step after the head, by its shape
    var cf = _cap_fld_sid;
    var cp = _hl_cp;
    var da = _hl_damp;
    var o = 0 - 1;
    var sid = _mch_head(S, ti);
    if (sid > 0) { o = _mch_walk(S, ti, sid, _mch_hx, _mch_nh); }
    _cap_fld_sid = cf;   # a lookahead: the capture lookup's answer stays its caller's
    _hl_cp = cp;
    _hl_damp = da;
    return o;
}
# From token `i` (after the head of struct `sid` at `ti`; `nh` 1 = a name head), the chain's steps to its last method:
# its `(` and `_vmc_*`, else -1.
fn _mch_walk(S, ti, sid, i, nh): i64 {
    while (_mchain_at(S, i) == 1) {
        var nt = i + 1;
        var o = _mch_mopen(S, sid, nt);
        if (o < 0) {
            sid = _mch_hop(S, sid, nt);
            i = i + 2;
        } else {
            var c = _call_close(S, o) + 1;
            if (_mchain_at(S, c) == 0) {
                if (nh == 1) { if (nt == ti + 2) { return 0 - 1; } }   # `x.m(`: `_mcall_open`'s
                return _mch_last(S, sid, nt, o);
            }
            sid = _mch_mres(S, sid, nt, o);
            i = c;
        }
        if (sid <= 0) { return 0 - 1; }
    }
    return 0 - 1;
}
# The `(` of the method step whose name is token `nt` on struct `sid` — `.m(`, or `.m<..>(` when m is a generic method
# and no field of it (`_mtargs_at`, the arm's own test) — else -1: a field.
fn _mch_mopen(S, sid, nt): i64 {
    if (TOKTYP(S, nt + 1) == 10) { return nt + 1; }
    if (TOKTYP(S, nt + 1) != 19) { return 0 - 1; }
    if (_mtargs_at(S, sid, nt) == 0) { return 0 - 1; }
    return _tok_targs_close(S, nt + 2) + 1;
}
# The chain's last method: `_vmc_*` set, its `(` returned — its template, as `_mcall_open`'s single-name arm answers (an
# asker that wants an explicit `.m<..>(`'s instance takes it, `_mco_inst`). CHANGELOG [6.7.16]
fn _mch_last(S, sid, nt, o): i64 {
    _vmc_mf = _meth_fn_at(S, sid, TOKVAL(S, nt), nt);
    _vmc_mt = nt;
    _vmc_rs = sid;
    return o;
}
# ⛔ 6.7.16 — A LOOKAHEAD TYPES EVERY STEP OF A CHAIN FROM ITS TEMPLATE AND MINTS NOTHING, as it answers the last one.
# The struct a method step's result continues the chain through (`_method_chain`): a struct by value, else a `*S`'s S
# (`_mchain_ptr`); a generic's `: V` the struct V binds at this step, a `: G<..>` the instance of G that binding names
# (`_mch_gres`) — each read by a peek (`_mch_bind`); 0 = none. An explicit `.m<..>(` step was typed from its instance,
# minted here (`_mcall_xquiet`), and the zone's pass 1 asks (`_gzf_elem`, the tuple captures): `var ga, gb =
# GW.p.gq<f64>(2.5).m2();` minted `P_gq$f64` there and SIGSEGV'd under CYRIUS_COVERAGE=1. CHANGELOG [6.7.16]
fn _mch_mres(S, sid, nt, o): i64 {
    var mf = _meth_fn_at(S, sid, TOKVAL(S, nt), nt);
    if (mf < 0) { return 0; }
    var t = GFRS(S, mf);
    if (GFTP(S, mf) != 0) {
        var w = _mch_rtp(S, mf);
        if (w >= 0) { return _gu_okc(_mch_bind(S, mf, sid, nt, o, w)); }
        if (_gz_gbase(S, t) == 1) { return _mch_gres(S, mf, sid, nt, o, t); }
    }
    if (t > 0) {
        if (t >= 2048) { return 0; }
        return t;
    }
    return _hl_fn_psid(mf);
}
# Which type parameter (0 / 1) generic `fi` returns as `: T` or `: *T` (the struct T binds is the step's either way:
# by value, or the `*S` the chain continues through), else -1. CHANGELOG [6.7.16]
fn _mch_rtp(S, fi): i64 {
    var w = _gen_ret_tparam(S, fi);
    if (w >= 0) { return w; }
    var k = _tok_ret_ann(S, fi);
    if (k < 0) { return 0 - 1; }
    if (TOKTYP(S, k) != 8) { return 0 - 1; }
    return _tok_tp_which(S, fi, k + 1);
}
# ... a generic method step's `: G<..>` (G = g): the instance of G its binding names (`_gs_ginst`: a struct made, no fn).
fn _mch_gres(S, mf, sid, nt, o, g): i64 {
    var c0 = _mch_bind(S, mf, sid, nt, o, 0);
    var c1 = 0;
    if (_gs_tp2(S, mf) == 1) { c1 = _mch_bind(S, mf, sid, nt, o, 1); }
    return _gs_ginst(S, mf, g, c0, c1);
}
# ... type parameter `w` of generic method `mf` at the step whose name is token nt (its `(` at o, on struct sid), read
# without instantiating: an explicit `.m<..>(` list as the zone reads it (`_gu_xlist`; a token pass as its scans read
# one, `_tok_gen_tp_sid`), an inferred `.m(` the argument that carries it as the method arm binds it (`_mch_itp`; a token
# pass from the unit's tokens, `_gs_mtp`) — an inferred step's `: V` was no struct, so `var a, b = w.p.idv(q).m2();` was
# "needs a call", `w.p.idv(q).rs(3)?` took the boxed `?` (SIGSEGV) and `var v = w.p.idv(q).rs(3);` kept the tag in
# silence; 0 = none read. CHANGELOG [6.7.16]
fn _mch_bind(S, mf, sid, nt, o, w): i64 {
    if (o == nt + 1) {
        if (_mch_tok == 1) { return _gs_mtp(S, _mch_ta, o, mf, w, sid); }
        return _mch_itp(S, mf, o, w, sid);
    }
    if (_mch_tok == 1) { return _tok_gen_tp_sid(S, _mch_ta, nt, nt, mf, w); }
    if (_gu_xlist(S, nt, mf) == 0) { return 0; }
    if (w == 1) { return _gu_x1; }
    return _gu_x0;
}
# `_mcall_infer` at the inferred step (its `(` at o, receiver struct sid) in the parser's scope, as `_gu_mtp` reads the
# zone's: no fn instance made (`_gu_noinst`; a binding it cannot read without one is a miss, 0), the cursor and
# `_gi_sc` put back.
fn _mch_itp(S, mf, o, w, sid): i64 {
    _gen_stub(S, mf);
    var sv = GTI(S);
    var ni = _gu_noinst;
    var sc = _gi_sc;
    var ms = _gu_miss;
    _gu_noinst = 1;
    _gi_sc = 0;
    _gu_miss = 0;
    var b = _mcall_infer(S, mf, o, w, sid);
    if (_gu_miss == 1) { b = 0; }
    _gu_noinst = ni;
    STI(S, sv);
    _gi_sc = sc;
    _gu_miss = ms;
    return b;
}
# The token after the receiver head at `ti` by its shape alone (`_mch_head`'s, untyped): `( .. )`, a call, a name.
fn _mch_hend(S, ti): i64 {
    if (TOKTYP(S, ti) == 10) { return _call_close(S, ti) + 1; }
    var o = _icall_open_at(S, ti);
    if (o < 0) { o = _gcall_open(S, ti); }
    if (o >= 0) { return _call_close(S, o) + 1; }
    return ti + 1;
}
# The receiver head at token `ti`: its struct (0: none this reads), `_mch_hx` the token after it, `_mch_nh` 1 for a name.
# A name (`_dyn_base_sid`); a call `f(..)` / `g<..>(..)` / `fncallN(&f, ..)` / `callptr(&f, ..)` (`_mch_chead`); a
# parenthesised head (`_mch_whead`).
var _mch_hx = 0;
var _mch_nh = 0;
fn _mch_head(S, ti): i64 {
    if (_mch_tok == 1) { return _tok_mch_head(S, _mch_ta, ti); }   # 6.7.16: a token pass
    if (TOKTYP(S, ti) == 10) { return _mch_whead(S, ti); }
    _mch_nh = 0;
    var o = _icall_open_at(S, ti);
    if (o < 0) { o = _gcall_open(S, ti); }
    if (o >= 0) {
        _mch_hx = _call_close(S, o) + 1;
        return _mch_chead(S, ti, o);
    }
    if (TOKTYP(S, ti) != 2) { return 0; }
    _mch_hx = ti + 1;
    _mch_nh = 1;
    return _dyn_base_sid(S, TOKVAL(S, ti));
}
# 6.7.16 — `_mch_head` in a token pass (`_mch_tok`: the pair flags' propagation, the mixed-return warning): the head
# typed from the tokens of the unit starting at token a, never the parser's scope — a name as `_tok_ta_decl` declares it
# (a struct value or a `*S`; an impl's untyped `self`, `_tok_iself`), a call (`_hl_pchain`: a struct or `*S` result; a
# generic's `_tok_mch_gret`), a parenthesised one (`_tok_mch_whead`).
fn _tok_mch_head(S, a, ti): i64 {
    _mch_nh = 0;
    if (TOKTYP(S, ti) == 10) { return _tok_mch_whead(S, a, ti); }
    var o = _icall_open_at(S, ti);
    if (o < 0) { o = _gcall_open(S, ti); }
    if (o >= 0) {
        _mch_hx = _call_close(S, o) + 1;
        if (TOKTYP(S, ti) == 2) {
            var fi = FINDFN(S, TOKVAL(S, ti));
            if (fi < 0) { return 0; }
            if (GFTP(S, fi) != 0) { return _tok_mch_gret(S, a, ti, fi); }
        }
        return _hl_pchain(S, ti, _mch_hx);
    }
    if (TOKTYP(S, ti) != 2) { return 0; }
    _mch_hx = ti + 1;
    _mch_nh = 1;
    var sid = _tok_ta_decl(S, a, ti, TOKVAL(S, ti));
    if (sid <= 0) { sid = _tok_iself(S, a, ti); }
    if (sid >= 2048) { return 0; }
    return sid;
}
# ⛔ 6.7.16 — ... a GENERIC call head (its name token ti): a `: T` / `: *T` return the struct T binds at the call, read
# from the unit's tokens as the scans read a free generic call's (`_tok_gen_tp_sid`); a return that names no type
# parameter its template's struct or `*S` (a binding changes nothing), as the parser's arm reads it (`_mch_chead`); a
# `: G<T>` none (0). A forwarder below its caller, `return gw<i64>(2).p.rs(3);` / `return gw(2).p.rs(3);` with `fn
# gw<V>(x: V): *W`, was no pair there (`var v = fwd();` kept the tag, `gw(2).p.rs(3)?` was not "bind both"). CHANGELOG
# [6.7.16]
fn _tok_mch_gret(S, a, ti, fi): i64 {
    var w = _mch_rtp(S, fi);
    if (w >= 0) { return _gu_okc(_tok_gen_tp_sid(S, a, ti, ti, fi, w)); }
    var t = _hl_fn_psid(fi);
    if (t > 0) { return t; }
    t = GFRS(S, fi);
    if (t <= 0) { return 0; }
    if (t >= 2048) { return 0; }
    if (_gz_gbase(S, t) == 1) { return 0; }
    return t;
}
# ... a parenthesised head `( E )`: a `*name` of a name declared `*S`, else a name, a call or a chain (`_mch_ty`, its
# head typed as above) — inside any parentheses; `_mch_hx` after the `)`.
fn _tok_mch_whead(S, a, ti): i64 {
    var c = _call_close(S, ti);
    var t = 0;
    if (_tup_lit_at(S, ti) < 0) {
        var b = _ie_unparen(S, ti + 1, c);
        var e = _ie_pe;
        if (TOKTYP(S, b) == 8) { t = _tok_mch_deref(S, a, ti, b, e); }
        else { t = _mch_ty(S, b, e); }
    }
    _mch_hx = c + 1;
    _mch_nh = 0;
    return t;
}
# `*name` filling [b, e): the struct a name declared `*S` points at, else 0.
fn _tok_mch_deref(S, a, ti, b, e): i64 {
    if (e != b + 2) { return 0; }
    if (TOKTYP(S, b + 1) != 2) { return 0; }
