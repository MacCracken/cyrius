# word (x86_64 / aarch64 0, cx / PE 41) where `x = mkv(41, 7);` into a local is refused — 6.7.14's D27 (a), one rule
# for every path. The global's by-name call is read as the local's arm reads it, starting the source (`_vasg_vt`); a
# vector global keeps its own refusal (`_vecg_refuse`: read and written through its address). CHANGELOG [6.7.15]
fn _vasg_mscal(S, noff, term): i64 {
