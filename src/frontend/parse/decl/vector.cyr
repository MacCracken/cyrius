# The vector a whole initialiser `fncallN(&f, ..)` / `callptr(&f, ..)` at token `ti` (`;` after it) returns, `f`
# declared to return one (`_icall_rs_at`), else 0.
# ⛔ 6.7.14 (D37 A, the user's decision, 2026-10-16) — AND A WHOLE METHOD CALL `s.mv(..)` DECLARED TO RETURN A VECTOR:
# an unannotated `var v = s.mv();` is that vector's local, as `var v = mkv(..)` is (v6.5.61) and `var v = callptr(&mkv,
# ..)` (6.7.13's D29) — it bound one word, whatever the scalar path stored (the filed repro: x86_64 / IR=3 / aarch64 1,
# cx 155, PE 195 where 161 is right). The receive then takes it as the annotated form does (`_vrcv_src` kind 3; on Win64
# the method's hidden result pointer is the local's address). CHANGELOG [6.7.14]
# ⛔ 6.7.15 (D28 A, the user's decision, 2026-10-18) — PARENTHESES AROUND THE WHOLE CALL ARE TRANSPARENT (the guide's §
# Parentheses): `var x = (mk2(41, 7));` / `= (s.m2());` / `= (callptr(&mk2, ..));` are the vector's local, as
# unwrapped — they bound one word (x86_64 / aarch64 0 or 1, cx 154 / 155, PE 195 where 161 is right). Every spelling of
# the whole call, wrapped or not (`_vcall_vt`). CHANGELOG [6.7.15]
fn _vrcv_ity(S, ti): i64 {
    return _vcall_vt(S, ti, 5, 0);
}
# The vector a whole method call `x.m(..)` at token `ti` (`term` after it) is declared to return (`_vrcv_mty`), else 0 —
# a method its fn (the base, for a generic) declares no vector is not resolved (`_mcall_gen` would instantiate it
# early). CHANGELOG [6.7.14]
fn _vmc_whole(S, ti, term): i64 {
    var o = _vmc_open(S, ti);   # 6.7.15: `x.m<..>(` too; a field chain's
    if (o < 0) { return 0; }
    var mf = _vmc_mf;
    if (mf < 0) { return 0; }
    if (GFRS(S, mf) > 0 - 2048) { return 0; }
    if (_vcall_more(S, _call_close(S, o) + 1, term) == 1) { return 0; }   # 6.7.16: a stray token is the parse's
