# ⛔ 6.7.13 — THE REFUSAL NAMES WHAT IT REFUSES, AND ITS ADVICE FITS THE SOURCE. Since 6.7.11 the text ended
# "; through a fn pointer held in a variable, give the target an out-pointer" for every source (`= 5`,
# `= load64(&w)`, `= &w`), and a call to a fn that does not exist — `var v: f64v2 = f64v2_splat(1.0);` with
# lib/simd.cyr not included — was reported as a refused source ("got `f64v2_splat`") ahead of the
# undefined-function warnings. The hint now follows a callee held in a variable only (`_vrcv_fptr`), a call
# naming no fn is left to the undefined-function path (`_vrcv_nofn`: "undefined function 'f64v2_splat'",
# then "refusing to emit binary"; under --allow-undef it builds and traps at the call, as through 6.7.10),
# and the accepted list names `*p` (D34). CHANGELOG [6.7.13]
# The refusal at token `ti`, `verb` "initialised" / "assigned"; `fp` 1 = the source is a call through a fn
# pointer held in a variable (the out-pointer hint). 0.
fn _vrcv_err(S, ti, verb, fp): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(ti, "_vrcv_err", verb * 2 + fp, 0) == 1) { return 0; }   # 6.7.15: once per site
    var sv = GTI(S);
    STI(S, ti);
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": a value-form vector local is ");
    PRSTR(verb);
    PRSTR(" only from a local of its type, a call declared to return it (by name, a method, or fncallN / callptr with the callee written `&f`) or a dereference of a pointer to its type (`*p`) - got `");
    _vrcv_offender(S, ti);
    if (fp == 1) { PRSTR("`; through a fn pointer held in a variable, give the target an out-pointer\n"); }
    else { PRSTR("`\n"); }
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}
# 1 = the source at token `ti` starts with a call `name(` naming no fn: FINDFN finds none, or only the entry an
# earlier such call registered (no definition — `GFDS` 0, the prescan stamps every fn — and no code); not
# `sizeof` / `mulh64`, intrinsics read by name. Before the parse or after it (the call registers the name).
fn _vrcv_nofn(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (TOKTYP(S, ti + 1) != 10) { return 0; }
    var n = TOKVAL(S, ti);
    if (_is_sizeof_word(S, n) == 1) { return 0; }
    if (_is_mulh64_word(S, n) == 1) { return 0; }
    var fi = FINDFN(S, n);
    if (fi < 0) { return 1; }
    if (GFDS(S, fi) != 0) { return 0; }
    if (L64(_fnt_offsets + fi * 8) != 0 - 1) { return 0; }
    return 1;
}
# ⛔ 6.7.14 — A CALL NAMING NO FN IS THE UNDEFINED-FUNCTION PATH'S AT EVERY VECTOR DESTINATION, inside parentheses too.
# 6.7.13 left `var v: f64v2 = f64v2_splat(1.0);` (no include) to that path, but the wrapped `= (f64v2_splat(1.0))`,
# `return f64v2_splat(1.0);` from a vector fn and the value-form argument `lanes(f64v2_splat(1.0))` were reported as a
# refused source of their own ("got `(...)`" / "got `f64v2_splat`") ahead of the undefined-function lines — the argument
# instead of them, so the missing include was never named. 1 = the source [a, b), inside any parentheses wrapping all
# of it (`_ie_unparen`), starts with such a call (`_vrcv_nofn`). CHANGELOG [6.7.14]
fn _vrcv_nofnw(S, a, b): i64 {
    return _vrcv_nofn(S, _ie_unparen(S, a, b));
}
# 1 = the source [ti, e), inside any parentheses, is one whole call through fncallN / callptr (`_icall_open_at`)
# whose callee is not written `&f` (`_icall_fti`: `&f` inside any parentheses is the known callee) — a fn pointer
# held in a variable, the one source an out-pointer is the answer for.
fn _vrcv_fptr(S, ti, e): i64 {
    var a = _ie_unparen(S, ti, e);
    var o = _icall_open_at(S, a);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 != _ie_pe) { return 0; }
    if (_icall_fti(S, a) >= 0) { return 0; }
    return 1;
}
# The refused source at token `ti`, as written: a name, a builtin (`callptr`, `load64`), a number,
# `&x` / `*x`, `(...)`.
fn _vrcv_offender(S, ti): i64 {
    var t = TOKTYP(S, ti);
    if (IS_KEYWORD_TOK(t) == 1) { PRSTR(TOKNAME(t)); return 0; }
    if (t == 1) { PRNUM(TOKVAL(S, ti)); return 0; }
    if (t == 10) { PRSTR("(...)"); return 0; }
    if (t == 27 || t == 8) {
        if (t == 27) { PRSTR("&"); } else { PRSTR("*"); }
        if (TOKTYP(S, ti + 1) == 2) { PRSTR(S + 0xEC00000 + TOKVAL(S, ti + 1)); }
        else { PRSTR("..."); }
        return 0;
    }
    if (t == 2) { PRSTR(S + 0xEC00000 + TOKVAL(S, ti)); return 0; }
    PRSTR("this expression");
    return 0;
}
