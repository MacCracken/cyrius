# PARSER — stores through a dereference — `*p = v` (`_dst_*`, `_dsr_*`), a struct value's source and operator checks
# (`_ssv_*`, `_ssc_*`, `_sop_*`), _deref_store.
# ================================================================
# Split from parse/parse.cyr at 6.7.18, unchanged; parse.cyr includes its pieces in source order. CHANGELOG [6.7.18]

# ⛔ 6.7.11 — `*p = v` THROUGH A `*S` COPIES THE STRUCT (the user's decision (a), 2026-10-13; issues/2026-10-11-
# deref-store-through-struct-pointer-decision.md). Decision 6 makes `*p` a struct value at every size, and since
# 6.7.10 `p = l` copies `l` INTO `*p`; the store wrote the 8-byte word whatever S: a zero-size or 3..7 B struct
# overran into its neighbour, one over 8 B kept only its first 8 bytes, `*p = q` stored the pointer, and `*p += a`
# added to the first word. The cursor past the operand of the `*` at `d`, rax = the pointer: when the operand is
# typed `*S` by the compiler's own typing (`_hl_dpsid`, its step the struct's size; not `Str` / tuple / dyn),
# `*p OP= v` is refused by name as `l += a` is (the statement parses on: 0), and for `=` the pointer is parked in a
# hidden temp and the statement's assignment arms run with that temp as their destination (`_agc_ovr`), so
# `*p = v` copies exactly what `G = v` copies — a local, parameter, global, field, call, method or operator result,
# a handle or a `*T` (copied, never rebound), `*q` — `sizeof(S)` bytes (none for a zero-size struct), another
# struct refused by name; any other value (untyped, an integer) is stored as the struct's word at `sizeof(S)` bytes,
# at most 8, never past the object (`_dst_word`). 1 = done (`term` consumed); 0 = not this shape (cursor untouched).
fn _dst_struct(S, term, d): i64 {
    var sid = _hl_dpsid(S, d + 1, GTI(S));
    if (sid <= 0) { return 0; }
    if (_dx_plain(S, sid) == 0) { return 0; }
    if (_hl_dstep(_ps_step(GPSC(S)), STRUCTSZ(S, sid - 1)) == 0) { return 0; }
    var nm = _hl_lastnm(S, d + 1, GTI(S), TOKVAL(S, d + 1));
    if (PEEKT(S) != 4) {
        if (_asg_pair_at(S) == 1) { _dst_cop_err(S, nm, _sval_stars(S, d + 1)); }   # 6.7.15: `**pp` names '*pp'
        return 0;
    }
    STI(S, GTI(S) + 1);   # `=`
    var h = _HTEMP(S);
    _HTSTORE(S, h);
    if (_dst_arms(S, term, sid, h, nm) == 1) { return 1; }
    _dst_word(S, h, STRUCTSZ(S, sid - 1));
    _expect_step(S, term);
    return 1;
}
# ⛔ 6.7.17 (D14, the user's decision, 2026-10-22: "copy through the slot") — A STRUCT VALUE STORED INTO A `*S` SLOT
# REACHED THROUGH A DEREFERENCE OR A FIELD IS COPIED INTO THE S THE SLOT POINTS AT, as `pq = r` into a `*Q` name copies
# (6.7.10's decision 6, B7-1c): `*ppq = r;` / `*ppq = mkp();` (ppq a `**Q`) and `w.pq = r;` (a `*Q` field) REBOUND the
# slot to the value's own storage and left q unchanged (the filed repro exited 113 where 34 is right). The slot's
# address in rax (the operand of the `*`, typed `**S` by its pin, `_pp_sid`; or the field's), the cursor on the `=`:
# the value, unless it is provably no struct value (`_psv_not`) or another struct's whole call (D99's refusal,
# `_psv_other`), runs the statement's assignment arms against the slot's pointee as a HANDLE (`_agc_ovr_pp` 2) — a
# struct value of S is copied in (another struct's refused by name), a handle or a `*S` rebinds the slot, as for a
# `*Q` name; anything else is stored into the slot as before. 1 = done (`term` consumed). CHANGELOG [6.7.17]
fn _dst_pslot(S, term, d): i64 {
    if (PEEKT(S) != 4) { return 0; }
    var sid = _pp_sid(S, _ps_pin(_hl_pw(S, d + 1, GTI(S))));
    if (sid <= 0) { return 0; }
    if (_dx_plain(S, sid) == 0) { return 0; }
    if (_psv_not(S, GTI(S) + 1, term) == 1) { return 0; }
    if (_psv_other(S, GTI(S) + 1, term, sid) == 1) { return 0; }
    var nm = _hl_lastnm(S, d + 1, GTI(S), TOKVAL(S, d + 1));
    STI(S, GTI(S) + 1);   # `=`
    return _psl_store(S, term, sid, nm);
}
# rax = the `*S` slot's address, the cursor past the `=`: the slot and its pointee parked, the arms run against the
# pointee (a handle: `_agc_ovr_pp` 2) named `nm`; a value they leave in rax is stored into the slot. 1.
fn _psl_store(S, term, sid, nm): i64 {
    var hs = _HTEMP(S);
    _HTSTORE(S, hs);
    ELOAD64(S);
    var ho = _HTEMP(S);
    _HTSTORE(S, ho);
    var sv = _agc_ovr_pp;
    _agc_ovr_pp = 2;
    var r = _dst_arms(S, term, sid, ho, nm);
    _agc_ovr_pp = sv;
    if (r == 1) { return 1; }
    _dst_word(S, hs, 8);
    _expect_step(S, term);
    return 1;
}
# 1 = the value [st, its `term`) is provably no struct value, by its tokens: empty, an address `&x`, a literal, a name
# that is no inline struct (a handle, a `*T`, an untyped or scalar name), a typed pointer (`_hl_pw`: a `*T` field,
# call, `p + n`), or a whole call of a fn that returns no struct (not a known `&f` through fncallN / callptr).
# CHANGELOG [6.7.17]
fn _psv_not(S, st, term): i64 {
    var e = _hl_dx_end(S, st, term);
    if (e < 0) { return 1; }
    var a = _ie_unparen(S, st, e);
    var pe = _ie_pe;
    if (pe <= a) { return 1; }
    var t = TOKTYP(S, a);
    if (t == 27) { return 1; }
    if (pe == a + 1) {
        if (t != 2) { return 1; }
        if (_hl_amp_sid(S, TOKVAL(S, a)) > 0) { return 0; }
        return 1;
    }
    if (_hl_pw(S, a, pe) > 0) { return 1; }
    if (t != 2) { return 0; }
    if (_icall_sid_at(S, a) > 0) { return 0; }
    var o = _gcall_open(S, a);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 != pe) { return 0; }
    if (_icall_open_at(S, a) >= 0) { return 0; }
    var fi = FINDFN(S, TOKVAL(S, a));
    if (fi < 0) { return 0; }
    if (GFTP(S, fi) != 0) { return 0; }
    if (GFRS(S, fi) != 0) { return 0; }
    return 1;
}
# 1 = the value [st, its `term`) is a whole free call returning ANOTHER struct than `sid` by value: D99's refusal
# (`_dsr_sres`), in its words, not the arms'. CHANGELOG [6.7.17]
fn _psv_other(S, st, term, sid): i64 {
    var e = _hl_dx_end(S, st, term);
    if (e < 0) { return 0; }
    var a = _ie_unparen(S, st, e);
    var pe = _ie_pe;
    if (TOKTYP(S, a) != 2) { return 0; }
    var o = _gcall_open(S, a);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 != pe) { return 0; }
    if (_icall_open_at(S, a) >= 0) { return 0; }
    var fi = FINDFN(S, TOKVAL(S, a));
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs <= 0) { return 0; }
    if (rs >= 2048) { return 0; }
    if (rs == sid) { return 0; }
    return 1;
}
# ⛔ 6.7.17 (D23 A, the user's decision, 2026-10-22: "The whole vector") — `*pv = v` THROUGH A `*V` COPIES THE VECTOR,
# as `w = u` does and as a store through a `*S` copies the struct (6.7.11); 6.7.13's D34 made `*pv` the vector when read.
# The store wrote one word: from a local its lane 0 (`*pv = u;` 42 on x86_64 / aarch64 / cx / PE where 47 is right), from
# a call the word its result register held (`*pv = mk2(4, 7);` x86_64 / aarch64 2, cx / PE 42), and `*(&w) = ..` the
# same (issues/archived/2026-10-21-vector-value-in-a-word-position-beyond-d100-d101.md row 1). The cursor past the
# operand of the `*` at `d`, rax = the pointer: when the operand points at a vector (`_dop_vd`: its step word — a `*V`
# local, parameter, capture, field, global, `: *V` call, `pv + n`, `*ppv` of a `**V` — or `&w` of a vector, `*(&w)`
# being w), `*pv OP= v` is refused as `w OP= v` is (the statement parses on: 0), and for `=` the pointer is parked in a
# hidden temp and the value received as `w = <src>` receives it (`_dvec_rcv`). 1 = done (`term` consumed). CHANGELOG
# [6.7.17]
fn _dst_vec(S, term, d): i64 {
    var vd = _dop_vd(S, d + 1, GTI(S));
    if (vd == 0) { return 0; }
    if (PEEKT(S) != 4) {
        if (_asg_pair_at(S) == 1) { _dvec_cop_err(S, d); }
        return 0;
    }
    var nm = _hl_lastnm(S, d + 1, GTI(S), TOKVAL(S, d + 1));
    STI(S, GTI(S) + 1);   # `=`
    var h = _HTEMP(S);
    _HTSTORE(S, h);
    if (_dvec_rcv(S, term, 0 - vd, h, nm) == 1) { return 1; }
    _expect_step(S, term);
    return 1;
}
# `*pv OP= v` through a pointer to a vector, refused by name as `w OP= v` is (`_asg_wide_refused`): `*(&w)` is w; else
# "the vector 'pv' points at" (`**ppv`: '*ppv'). In sync, as the struct's (`_dst_cop_err`). 0.
fn _dvec_cop_err(S, d): i64 {
    var nm = _hl_lastnm(S, d + 1, GTI(S), TOKVAL(S, d + 1));
    _cop_rti = GTI(S) + 2;   # 6.7.17: past the `op =` the cursor is on
    if (_amp_vd(S, d + 1, GTI(S)) != 0) {
        _err_in_sync(S, "compound assignment to vector ", nm,
          " is refused - a vector value is not an integer or a float (write the long form with the packed-op builtins)");
        return 0;
    }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, GTI(S)) == 0) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": compound assignment to the vector '");
    _dst_spell(S, nm, _sval_stars(S, d + 1));
    PRSTR("' points at is refused - a vector value is not an integer or a float (write the long form with the packed-op builtins)\n");
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}
# The value at the cursor (ended by `term`) stored into the vector of type `vt` the parked pointer `h` points at, as `w =
# <src>` stores it (`_vrcv_asg`): a call declared to return `vt` — by name, an explicit instance, a method, `callptr(&f,
# ..)` / `fncallN(&f, ..)`, inside parentheses — received into a frame temporary (SysV / AAPCS64 / cx: its vector
# registers; Win64: the temporary is its hidden result pointer) and copied (at top level there is no frame: refused as a
# top-level declaration is); a dereference `*q` of a pointer to `vt` (`_vrcv_demit`'s), copied through; a vector local,
# parameter or capture of `vt`, copied (`_try_aggregate_copy_assign` with the parked pointer its destination,
# `_agc_ovr`, as `_dst_struct`'s); another vector refused by name; anything else by the receive's words
# (`_vrcv_other`). 1 = `term` consumed; 0 = the cursor on `term`.
fn _dvec_rcv(S, term, vt, h, nm): i64 {
    var ti = GTI(S);
    var k = _vrcv_src(S, ti, vt, term);
    _vec_desc(S, vt);
    var n = GVEC_NSLOTS(S);
    if (k == 4) { return _dvec_deref(S, vt, h, nm, n * 8); }
    if (k != 0) {
        if (GINFN(S) != 1) {
            _vcall_vt(S, ti, term, 0);
            _svc_toplevel_at(S, _vcv_a, _vcv_nt);
            PCMPE(S);
            return 0;
        }
        var t = _agg_temp_t(S, n, vt);
        _vrcv_emit(S, t, vt, k);
        _agc_copy_bytes(S, _dh_li(h), _dh_gv(h), t, 0 - 1, n * 8);
        return 0;
    }
    if (_vval_at(S, ti, _hl_dx_end(S, ti, term)) != 0) {   # a vector name, wrapped too: copied, or refused by name
        if (_vvl_arr == 0) {   # 6.7.17 (D103): an array of vectors is the receive's own refusal
            if (_dvec_name(S, term, vt, h, nm) == 1) { return 1; }
        }
    }
    _vrcv_bad(S, ti, vt, term, 1);   # a call of another vector, wrapped or not
    if (_vrcv_other(S, term, vt) == 1) { return 1; }
    PCMPE(S);   # a call naming no fn: the undefined-function path's
    return 0;
}
# ... a vector name: the statement's copy (`_try_aggregate_copy_assign`) into the parked pointer. 1 = done.
fn _dvec_name(S, term, vt, h, nm): i64 {
    var sv = _agc_ovr;
    var svn = _agc_ovr_nm;
    var svh = _agc_ovr_h;
    var svt = _agc_ovr_t;
    _agc_ovr = 1;
    _agc_ovr_nm = nm;
    _agc_ovr_h = h;
    _agc_ovr_t = vt;
    var r = _try_aggregate_copy_assign(S, nm, term);
    _agc_ovr = sv;
    _agc_ovr_nm = svn;
    _agc_ovr_h = svh;
    _agc_ovr_t = svt;
    return r;
}
# ... a dereference `*q` (`_vrcv_k` parentheses, then `*`): q parsed and its vector read (`_vrcv_dparse`) — `vt`'s, the
# `nb` bytes copied from where q points to where `h` points; another vector refused by name; none, the receive's words.
fn _dvec_deref(S, vt, h, nm, nb): i64 {
    var ti = GTI(S);
    var a = ti + _vrcv_k + 1;
    var vd = _vrcv_dparse(S);
    if (vd == 0) { return _vrcv_err(S, ti, "assigned", 0); }
    if (0 - vd != vt) { return _vrcv_dbad(S, ti, vt, vd, nm, _hl_lastnm(S, a, _vrcv_dpe, TOKVAL(S, a))); }
    _agc_copy_bytes(S, _dh_li(h), _dh_gv(h), _dh_li(_vrcv_dh), _dh_gv(_vrcv_dh), nb);
    return 0;
}
# A hidden temp `h` holding an address (`_HTEMP`: a frame slot in a fn, a hidden global at top level) as
# `_agc_copy_bytes`' operand: the slot's band (`_AGC_DREF`), else -1 — and the global's (`0 - 1000 - gvi`), else -1.
fn _dh_li(h): i64 {
    if (h >= 0) { return _AGC_DREF(h); }
    return 0 - 1;
}
fn _dh_gv(h): i64 {
    if (h >= 0) { return 0 - 1; }
    return 0 - 1000 - (0 - 2 - h);
}
# `*p OP= v` through a `*S` refused by name. ⛔ 6.7.14 — `*(&s) OP= v` (the `&` arm, `_hl_damp`) is the struct value
# s (6.7.13), so it is refused as `s OP= v` is (the user's D17 (a), 2026-10-16): it kept 6.7.5's word op, on s's
# first word, through 6.7.13. CHANGELOG [6.7.14]
# `star`: the `*`s the operand of the outer `*` opens with (`_sval_stars`) — 1 for `**pp`, whose operand is `*pp`.
fn _dst_cop_err(S, nm, star): i64 {
    _cop_rti = GTI(S) + 2;   # 6.7.17: past the `op =` the cursor is on
    if (_hl_damp == 1) {
        _err_in_sync(S, "compound assignment to struct ", nm,
          " is refused - a struct value is not an integer or a float (write `a = a + b`)");
        return 0;
    }
    if (star > 0) { return _dst_cop_pp(S, nm, star); }
    _err_in_sync(S, "compound assignment to the struct ", nm,
      " points at is refused - a struct value is not an integer or a float (write `*p = *p + b`)");
    return 0;
}
# ⛔ 6.7.15 — `**pp OP= v` THROUGH A `**S` NAMES ITS OPERAND AS WRITTEN: the outer `*`'s operand is `*pp` (`star` `*`s
# before the name `nm`), so the struct '*pp' points at, and the hint in that spelling (`**pp = **pp + b`). It named
# 'pp', which points at a pointer (and `*p = *p + b`). `_err_in_sync`'s rules: once at the token (a generic's
# instances parse it again), the panic latch left as it was. CHANGELOG [6.7.15]
fn _dst_cop_pp(S, nm, star): i64 {
    if (_panic == 1) { return 0; }
    if (_tn_once(S, GTI(S)) == 0) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": compound assignment to the struct '");
    _dst_spell(S, nm, star);
    PRSTR("' points at is refused - a struct value is not an integer or a float (write `*");
    _dst_spell(S, nm, star);
    PRSTR(" = *");
    _dst_spell(S, nm, star);
    PRSTR(" + b`)\n");
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}
# `star` `*`s, then the name `nm`, on stderr.
fn _dst_spell(S, nm, star): i64 {
    while (star > 0) {
        PRSTR("*");
        star = star - 1;
    }
    PRSTR(S + 0xEC00000 + nm);
    return 0;
}
# The statement's assignment arms (`_PARSE_STMT_IMPL`'s order) with the parked pointer `h` as their destination
# `nm` (`_agc_ovr`). 1 = a copy (`term` consumed); 0 = the value is in rax, the cursor on `term`.
fn _dst_arms(S, term, sid, h, nm): i64 {
    var sv = _agc_ovr;
    var svn = _agc_ovr_nm;
    var svh = _agc_ovr_h;
    var svt = _agc_ovr_t;
    _agc_ovr = 1;
    _agc_ovr_nm = nm;
    _agc_ovr_h = h;
    _agc_ovr_t = 0 - sid;
    var r = _try_aggregate_copy_assign(S, nm, term);
    if (r == 0) { r = _try_struct_call_assign(S, nm, term); }
    if (r == 0) {
        _refuse_lossy_pair(S);   # 6.7.7 (T5b), as the word store refused it
        r = _pcmpe_struct_assign(S, nm, term);
    }
    _agc_ovr = sv;
    _agc_ovr_nm = svn;
    _agc_ovr_h = svh;
    _agc_ovr_t = svt;
    return r;
}
# rax = a value that is no struct of `*p`'s type: stored as the struct's word through the parked pointer `h` at
# `sz` bytes, at most 8 — 8 / 4 / 2 / 1-byte chunks, each shifted down into place (the `_fst_odd` shape) — so a
# struct under 8 B is never written past (a zero-size one not at all).
fn _dst_word(S, h, sz): i64 {
    var dli = 0 - 1;
    var dgv = 0 - 1;
    if (h >= 0) { dli = _AGC_DREF(h); } else { dgv = 0 - 1000 - (0 - 2 - h); }
    var nb = sz;
    if (nb > 8) { nb = 8; }
    EPUSHR(S);
    var o = 0;
    while (o < nb) {
        var w = 8;
        if (nb - o < 8) { w = 4; }
        if (nb - o < 4) { w = 2; }
        if (nb - o < 2) { w = 1; }
        if (o > 0) { EMOVI(S, o * 8); EMOVCA(S); }
        EPOPR(S);
        EPUSHR(S);
        if (o > 0) { ESHRCL(S); }
        EPUSHR(S);
        _agc_addr_x1(S, dli, dgv, o);
        EPOPR(S);
        if (w == 1) { ESTORE8(S); }
        elif (w == 2) { ESTORE16(S); }
        elif (w == 4) { ESTORE32(S); }
        else { ESTOC(S); }
        o = o + w;
    }
    EPOPR(S);
    return 0;
}

# `*expr = v` / `*expr OP= v` (cursor on the `*`), ending at `term` — `;` for a statement, `)` for
# a classic-for step: the address once, before the value, then the store. 6.7.5 (B8): the compound
# form — it was "expected '=', got '+'" — loads, `_asg_compound_op`s it and stores it back. Out of
# _PARSE_STMT_IMPL, whose body sits at cybs's silent per-fn reference ceiling. CHANGELOG [6.7.5]
# 6.7.8 (C2-5): through a narrow `*T` (`_deref_ed`, parse/expr/deref.cyr) the element is written at its
# width, as `p[0] = v` / `p[0] OP= v` write it: `=` checks the value as a store into an f32 element
# (an f64 rounds, an integer constant warns), `OP=` loads the element at its width (sign- /
# zero-extended; an f32 combines as an f32), a wider integer warns "narrowing". Every other operand
# keeps the WORD store (`_asg_store_w` at width 0 is EPOPC + ESTORE64). Before, `*q = 5` through a
# `*i32` zeroed the next element. CHANGELOG [6.7.8]
# 6.7.11: through a `*S` (a struct), `*p = v` copies the struct and `*p OP= v` is refused (`_dst_struct`).
# 6.7.16: `*(&pi) OP= n` of a typed pointer steps as `pi OP= n` does — `*(&p)` is p, its type kept (6.7.15's D21 A,
# `_amp_pw`), as `*(&pi) + n` already stepped; it stepped one byte. CHANGELOG [6.7.16]
# 6.7.16 (D70): the value just stored by `*E = v` (`ti` its first token, `d` the `*`) through the element kind `ed` — an
# f32's checks (an integer constant warns, an f64 rounds), and for `*(&x)` of an f64 x the integer-constant warning and
# of a bool x the refusal of a non-bool, named at x, as `x = v` takes them.
fn _dst_fk_chk(S, ed, ti, d): i64 {
    var k = _ek_fk(ed);
    if (k == 0) { return 0; }
    if (k == 16) { return _bx_asg(S, _dst_amp_nm(S, d), ti); }
    return _ifs_bx(S, k, ti, 0);
}
# `*(&b) OP= v` of a bool b: refused as `b OP= v` is (6.7.16, D70).
fn _dst_fk_cop(S, ed, d): i64 {
    if (_ek_fk(ed) != 16) { return 0; }
    return _bx_compound(S, _dst_amp_nm(S, d));
}
# The NAME of `*(& NAME)` / `*&NAME` whose `*` is token `d` (the shape `_amp_ew` vouched for: a bool kind is its alone).
fn _dst_amp_nm(S, d): i64 {
    var i = d + 1;
    while (TOKTYP(S, i) == 10) { i = i + 1; }
    return TOKVAL(S, i + 1);
}
# ⛔ 6.7.16 (D99, the user's decision, 2026-10-20) — A STRUCT RESULT OVER 8 B STORED THROUGH A POINTER TO A SCALAR IS
# REFUSED, as its sibling stores are: `*p = mkp();` with `p: *i64` and mkp returning a 16-byte Q stored Q's first word
# (the filed repro exited 77), silently, where `var y: i64 = mkp();` (6.7.11's D24), `y = mkp();` (6.7.14's D27) and
# `p = mkp();` (6.7.15's D32) are refused. The dereference `*E` at token `d` (its operand ends at `oe`) whose operand is
