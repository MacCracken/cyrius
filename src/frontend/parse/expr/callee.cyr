# PARSER — expr: what a call's head names — the explicit type-argument lookahead (LOOKAHEAD_IS_TYPE_ARG_CALL),
# _IS_FNCALL_NAME, indirect calls (PINDIRECT_CALL, `_icall_*`), mulh64, and the per-platform syscall reroutes and their
# warnings (`_PE_ROUTE_*`, `_macho_*`).
# ================================================================
# Split from parse/expr.cyr at 6.7.18, unchanged; parse.cyr includes parse/expr/ in source order. CHANGELOG [6.7.18]

# v6.3.10 (F-structs/explicit): non-consuming lookahead from a `<` (token 19) at the
# current cursor. Returns 1 iff the `<...>` is a TYPE-ARGUMENT list immediately
# followed by `(` — i.e. the `foo<T,...>(` shape. Depth-tracks `<`/`>`; bails (→ 0,
# meaning "this is a comparison, not type-args") on `;`(5), `{`(13), or `(`(10) seen
# INSIDE the brackets (those mark a comparison like `a < foo()`). Bounded 64-token
# scan; never mutates GTI. The caller additionally gates on the flag + a generic-fn
# callee, so `a < b` and non-generic `<` are never misread.
# 6.7.16: 1 = fn fi is generic (the explicit call's arm reads its `<..>`). One that is not, given `<..>(` at the cursor
# (just past its name) with a type list (`_tylist_at`), is refused once at the name — "'nf' is not a generic fn: it
# takes no type arguments" — and the list stepped, so the call parses as `nf(..)` (it was "undefined variable 'nf'" +
# "undefined variable 'i64'" + "expected ';', got '>'"; `_meth_ngt`'s free twin, parse/decl/field.cyr). 0.
fn _eta_gen(S, fi): i64 {
    if (GFTP(S, fi) != 0) { return 1; }
    var nt = GTI(S) - 1;
    if (TOKTYP(S, nt + 1) != 19) { return 0; }
    var e = _tok_targs_close(S, nt + 2);
    if (e < 0) { return 0; }
    if (TOKTYP(S, e + 1) != 10) { return 0; }
    if (_MONOMORPH_OK != 1) { if (_fn_gen_tok(S, fi) == 1) { return _tylist_fl(S, nt + 2, e); } }   # 6.7.17 (D7)
    if (_tylist_at(S, nt + 2, e, 0 - 1) == 0) { return 0; }
    _ngt_say(S, nt, " is not a generic fn: it takes no type arguments");
    STI(S, e + 1);
    return 0;
}
# ⛔ 6.7.17 (D7) — AN EXPLICIT TYPE-ARGUMENT CALL UNDER CYRIUS_MONOMORPH=0: `g<i32>(3)` of a defined `fn g<T>` was
# "undefined function 'g'" (the explicit arm was compiled only under monomorphization, so the name read as a value and
# the list as comparisons; as a statement "expected '=', got '<'" and two more), and a generic method's `p.m<i32>(1)`
# "'Pt.m' is not a generic method". The flag records no type parameter, so a fn is generic by its definition's tokens
# (`_fn_gen_tok`): `_eta_gen` answers 1 for one, as monomorphization does, and every explicit reader takes the call —
# `_gcall_open` opens it, the arms reach `_explicit_generic_call` — whose refusal is by name at the `<`: "explicit type
# arguments need monomorphization (CYRIUS_MONOMORPH=0 turns it off)" (the user's D7, 2026-10-22: the list is never
# run as the i64 base silently), once, the list stepped and the BASE call parsed (`_egc_nomono`), so nothing cascades
# — `.field` on the result, `[i] = v`, a statement. A fn that is not generic keeps 6.7.16's words under the flag too
# (they were the same cascade). A type parameter in scope counts in the list (read off the tokens: the flag binds
# none). Silent under --syntax-only, as D6's. CHANGELOG [6.7.17]
fn _eta_nm_say(S, lt): i64 {
    _dyn_err(S, lt, "explicit type arguments need monomorphization (CYRIUS_MONOMORPH=0 turns it off)", 0, 0 - 1, 0);
    return 0;
}
# The factor's explicit-call arm, cursor past the callee's name on its `<` (out of PARSE_FACTOR: cybs's per-fn reference
# ceiling): a generic fn's `<..>(` call parsed — 1; a fn that is not generic has its list refused and stepped
# (`_eta_gen`), and the plain call is the factor's — 0.
fn _eta_arm(S, noff): i64 {
    var fi = FINDFN(S, noff);
    if (fi < 0) { return 0; }
    if (_eta_gen(S, fi) == 0) { return 0; }   # 6.7.16: a non-generic fn's list refused, stepped
    if (LOOKAHEAD_IS_TYPE_ARG_CALL(S) != 1) { return 0; }
    _explicit_generic_call(S, noff, fi);
    _cfo = 0;
    return 1;
}
# `_explicit_generic_call` under CYRIUS_MONOMORPH=0 (cursor on the `<`): refused, the list stepped, the base call.
fn _egc_nomono(S, noff, fi): i64 {
    _eta_nm_say(S, GTI(S));
    _skip_targ_list(S);
    PARSE_FNCALL(S, noff);
    _call_ret_marks(S, fi);
    return 0;
}
# 1 when fn `fi`'s definition declares a `<..>` (its name token's next): generic, read off the tokens.
fn _fn_gen_tok(S, fi): i64 {
    var d = GFDS(S, fi);
    if (d <= 0) { return 0; }
    if (TOKTYP(S, d + 1) == 19) { return 1; }
    return 0;
}
# `_tylist_at` under CYRIUS_MONOMORPH=0: a name may also be a type parameter in scope, read off the tokens.
fn _tylist_fl(S, a, e): i64 {
    while (a < e) {
        var t = TOKTYP(S, a);
        if (t == 2) {
            if (_bnd_tyname(S, 0 - 1, TOKVAL(S, a)) == 0) { if (_tn_tparam(S, a, TOKVAL(S, a)) == 0) { return 0; } }
        } elif (t != 31 && t != 19 && t != 20 && t != 39 && t != 152) { return 0; }
        a = a + 1;
    }
    return 1;
}
# ⛔ 6.7.17 — `&g<i32>` / `&nf<i32>`: the `&` factor took the fn's name and left its `<..>` to the expression as
# comparisons — "undefined variable 'i32'" + "expected ';', got '>'" (a local's or a global's initializer, a `callptr`
# argument alike). A fn that is not generic is refused at the name with 6.7.16's words ("'nf' is not a generic fn: it
# takes no type arguments", `_eta_gen`'s), the list stepped and nf's address taken; a generic fn's instance has no
# address to take: "cannot take the address of a generic instance: 'g' - ..." once at the name, the list (and a call's
# `( .. )`) stepped, the factor 0. A list that is no type list stays a comparison. Both monomorph modes.
# CHANGELOG [6.7.17]
# Cursor past fn fni's name: 1 = refused (the factor yields 0), else 0 (the cursor past any refused list).
fn _amp_targs(S, fni): i64 {
    if (PEEKT(S) != 19) { return 0; }
    var nt = GTI(S) - 1;
    var e = _tok_targs_close(S, nt + 2);
    if (e < 0) { return 0; }
    var gen = 0;
    if (_MONOMORPH_OK != 1) {
        if (_tylist_fl(S, nt + 2, e) == 0) { return 0; }
        gen = _fn_gen_tok(S, fni);
    } else {
        if (_tylist_at(S, nt + 2, e, 0 - 1) == 0) { return 0; }
        if (GFTP(S, fni) != 0) { gen = 1; }
    }
    STI(S, e + 1);
    if (gen == 0) { _ngt_say(S, nt, " is not a generic fn: it takes no type arguments"); return 0; }
    var tl = " - wrap the call in a fn that is not generic and take its address";
    _dyn_err(S, nt, "cannot take the address of a generic instance: ", 0, TOKVAL(S, nt), tl);
    if (PEEKT(S) == 10) { var c = _tok_close_paren(S, GTI(S)); if (c > 0) { STI(S, c + 1); } }
    EMOVI(S, 0);
    return 1;
}
# `_gcall_open`'s explicit call under CYRIUS_MONOMORPH=0 (name token ti, its `<` next): a generic fn's `<types>(`
# opens at that `(`, as monomorphization opens it; else -1.
fn _gcall_open_fl(S, ti): i64 {
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return 0 - 1; }
    if (_fn_gen_tok(S, fi) == 0) { return 0 - 1; }
    var e = _tok_targs_close(S, ti + 2);
    if (e < 0) { return 0 - 1; }
    if (TOKTYP(S, e + 1) != 10) { return 0 - 1; }
    if (_tylist_fl(S, ti + 2, e) == 0) { return 0 - 1; }
    return e + 1;
}
fn LOOKAHEAD_IS_TYPE_ARG_CALL(S): i64 {
    var i = GTI(S);
    var n = GTCNT(S);
    var cap = i + 64;
    if (cap > n) { cap = n; }
    var depth = 0;
    while (i < cap) {
        var t = TOKTYP(S, i);
        if (t == 19) { depth = depth + 1; }
        elif (t == 20) {
            depth = depth - 1;
            if (depth == 0) {
                if (i + 1 < n) { if (TOKTYP(S, i + 1) == 10) { return 1; } }
                return 0;
            }
        } elif (t == 152) {
            # `>>>` (arith-shift lexeme) closes THREE type-arg levels (A<B<C<T>>>).
            depth = depth - 3;
            if (depth <= 0) {
                if (i + 1 < n) { if (TOKTYP(S, i + 1) == 10) { return 1; } }
                return 0;
            }
        } elif (t == 39) {
            # v6.3.33: `>>` (right-shift lexeme) closes TWO type-arg levels — the tail
            # of a nested `Outer<Inner<T>>`. If that lands us at (or past) depth 0, this
            # is a type-arg call iff a `(` follows; else it's a real `a < b >> c` shift.
            depth = depth - 2;
            if (depth <= 0) {
                if (i + 1 < n) { if (TOKTYP(S, i + 1) == 10) { return 1; } }
                return 0;
            }
        } elif (t == 5) { return 0; }
        elif (t == 13) { return 0; }
        elif (t == 10) {
            # 6.7.7 (R3): a tuple TYPE ARGUMENT, `f<( .. )>(..)` — stepped over, so the call parses
            # and _parse_one_type_arg refuses the type by name. Only right after `<` or `,`: any
            # other `(` ends the lookahead as before (both callers have a generic fn in hand, whose
            # bare name is no value, so no comparison that compiled reads differently).
            if (depth < 1) { return 0; }
            var pt = TOKTYP(S, i - 1);
            if (pt != 19) { if (pt != 31) { return 0; } }
            i = _call_close(S, i);
        }
        i = i + 1;
    }
    return 0;
}

# v6.5.17 — how many arguments this target passes in registers. SysV and AAPCS64
# use six (cyrius's own subset of AAPCS64's eight); Win64 uses four. The closure
# ABI needs it in two places that MUST agree: the call site, which appends the
# hidden env argument only when it lands in a register, and the closure prologue,
# which reads it from that same index.
fn _ARG_REG_COUNT(): i64 {
    if (_TARGET_PE == 1) { return 4; }
    return 6;
}

# v6.5.17 — is `noff` the name `fncall0` … `fncall8`? Packed little-endian u64
# compare, the same 8-byte trick the `sizeof` / `mulh64` intrinsics use below:
# 'f','n','c','a','l','l' occupy the low 48 bits (0x6C6C61636E66), the ASCII digit
# sits at byte 6, and byte 7 must be NUL so `fncall2x` cannot match.
# v6.5.46 — the arity `fncallN` promises, or -1 for `callptr`, which is variadic BY DESIGN
# (its callee's arity is not knowable at the call site). Set immediately before PINDIRECT_CALL
# and cleared by it, so the check cannot leak into the callptr path.
var _fncall_expect = 0 - 1;

fn _IS_FNCALL_NAME(S, noff): i64 {
    var w = L64(S + 0xEC00000 + noff);
    if ((w & 0xFFFFFFFFFFFF) != 0x6C6C61636E66) { return 0; }
    if (((w >> 56) & 0xFF) != 0) { return 0; }
    var d = (w >> 48) & 0xFF;
    if (d < 48) { return 0; }
    if (d > 56) { return 0; }
    return 1;
}

# v6.5.17 — the shared indirect-call lowering behind BOTH `callptr(callee, …)` and
# `fncall0(callee)` … `fncall8(callee, …)`. The cursor enters just past the `(` and
# leaves just past the `)`; the callee's return lands in rax/x0 like any call.
#
# Evaluate the callee FIRST and spill it to a FRESH frame slot (re-entrant: nested
# indirect calls get distinct slots) so it survives ECALLPOPS — which on Win64
# `sub`s rsp for the 32 B shadow home and would bury a stack-pushed callee. Then
# push args, marshal, and call through the slot via ECALLIND (`call [rbp-disp]` /
# `ldur x6; blr x6`). The spill is a frame local, so the call needs a frame.
#
# ⛔ 6.6.16 — AT TOP LEVEL THE CALL BRINGS ITS OWN FRAME. Top-level code has none (its
# vars are globals; rbp / x29 / cx fp hold whatever the loader left), and this used to
# be answered two ways at once: `callptr` was refused ("must be inside a function"),
# while `fncallN` was simply NOT LOWERED there (both gates below were `_cur_fn_ix >= 0`)
# and fell through to lib/fnptr.cyr, whose asm calls the raw value. A capturing
# closure's value is its env object with bit 63 set, so every top-level fncallN on a
# closure that ESCAPED a fn (returned, stashed in a global, round-tripped through
# memory) jumped to a non-canonical address: SIGSEGV on x86_64/aarch64/Mach-O,
# 0xC0000005 on Windows, and on cx — where lib/fnptr.cyr has no arm — EVERY top-level
# fncallN returned 0, plain fn pointers included. Now `PINDIRECT_CALL` wraps a top-level
# call in a per-call-site MICRO-FRAME (`ETLFRAME_OPEN` / `ETLFRAME_CLOSE` in each
# backend), sized at the close from the slots the call actually used, so fncall0..8
# and callptr take the same closure-aware lowering everywhere. Inside a fn nothing
# changes: the wrapper calls `_PINDIRECT_CALL_IN` directly. See
# 2026-10-03-hisab-toplevel-fncall-capturing-closure-segv.md. CHANGELOG [6.6.16]
#
# RUNTIME CLOSURE DISPATCH. The spilled callee value is read TWICE: once through
# ECLENV for the hidden env argument, once through ECLNORM for the real code
# address. A capturing closure carries its heap env object with BIT 63 SET, so both
# reads answer correctly no matter where the value came from.
#
# This REPLACES a compile-time test (v6.3.8/v6.3.36) that peeked at the declaring
# local's CLOSURE_TYID SLTYPE. That test could only see a closure while it was still
# sitting in the `var` it was built in: pass it to a fn, return it, stash it in a
# global, round-trip it through store64/load64, or even copy it with `g = f` (as
# opposed to `var g = f`) and the tag was gone — so the value was dispatched as a
# bare fn pointer, i.e. a jump INTO the env object and a SIGSEGV on the NX heap,
# with no diagnostic. It was wrong in the other direction too: `callptr(f + 0, …)`
# still looked like a closure. See
# hisab-capturing-closure-segv-across-fn-boundary.md.
#
# THE ENV ARGUMENT IS ALWAYS PUSHED, AND ALWAYS LAST. Passing it last (rather than
# as the hidden FIRST arg it used to be) is what lets ONE marshalling sequence serve
# both cases: a plain fn pointer or non-capturing closure simply ignores one extra
# register argument, which every ABI we emit for (SysV, Win64, AAPCS64) permits
# because the CALLER cleans the argument area. Leading it would shift every user
# argument of every non-closure indirect call.
#
# THE TOP-LEVEL MICRO-FRAME. Slot numbering restarts at 0 inside it (nothing at top level
# lives in a frame slot — hidden temps there are globals, and every other frame-slot
# user refuses top level or is gated on GINFN), and the frame is sized from the larger
# of the final GFLC and the `_flc_hwm` high-water, because hidden temps and the inline
# replay release GFLC back down after use. Both are restored afterwards, so the
# enclosing top-level state is untouched; a nested top-level indirect call (one in
# another's arguments) opens its own frame inside this one. The result stays in
# rax / x0 / r0 across the close. Kept a SMALL separate fn with no tail call: cybs,
# which builds this file on the seed chain, has a per-fn reference ceiling.
fn PINDIRECT_CALL(S): i64 {
    if (_cur_fn_ix >= 0) { _PINDIRECT_CALL_IN(S); return 0; }
    var tl_flc = GFLC(S);
    var tl_hwm = _flc_hwm;
    SFLC(S, 0);
    _flc_hwm = 0;
    var tl_patch = ETLFRAME_OPEN(S);
    _PINDIRECT_CALL_IN(S);
    var tl_n = GFLC(S);
    if (_flc_hwm > tl_n) { tl_n = _flc_hwm; }
    ETLFRAME_CLOSE(S, tl_patch, tl_n);
    SFLC(S, tl_flc);
    _flc_hwm = tl_hwm;
    return 0;
}

# ⛔ 6.7.6 (FE) — E-2's `_icall_untyped` (below) also dropped the f64 TYPE a fncallN / callptr result
# carried before 6.7.6: the leak typed it as its last argument, so `fncall1(&dbl, d) + 1.0` with
# `fn dbl(x: f64): f64` and `d: f64` was an f64 add (7.0), and 6.7.6 made it an integer add of the
# bit patterns. The decided fix was the STRUCT leak only. So where the callee is known — the callee
# expression is exactly `&f` resolving to fn `f` (`_lfa_load` records it, after the local / capture /
# global shadowing) — and `f` returns `: f64`, the result keeps the f64 type in the case 6.7.5 gave
# it (the last argument an f64), and in no other. CHANGELOG [6.7.6]
# 6.7.14 (D25 (a)): whatever its arguments, as the direct call `f()` is (`_icall_scalar`). CHANGELOG [6.7.14]
var _lfa_fi = 0 - 1;    # the fn the last `&f` factor loaded ...
var _lfa_end = 0 - 1;   # ... and the token after its name
fn _lfa_load(S, fnaddr, fc, fni): i64 {
    _lfa_fi = fni;
    _lfa_end = GTI(S);
    ELOAD_FN_ADDR(S, fnaddr, fc, fni);
    return 0;
}
fn _icall_mark(S): i64 {
    _lfa_end = 0 - 1;
    return GTI(S);
}
# The callee expression parsed from `cst` to the cursor: its fn when it is exactly `&f`, inside any
# parentheses that wrap the whole callee (`callptr((&mk3), 5)`, 6.7.13: guide § Parentheses), else -1.
fn _icall_callee(S, cst): i64 {
    var a = _pwrap_in(S, cst);
    if (a < 0) { return 0 - 1; }
    if (TOKTYP(S, a) != 27) { return 0 - 1; }
    if (_lfa_end != a + 2) { return 0 - 1; }
    if (GTI(S) != a + 2 + (a - cst)) { return 0 - 1; }
    return _lfa_fi;
}
# The result of a call through fncallN / callptr to `cfi` (-1: not known): an untyped word — or (6.7.11) a
# known callee's struct, recorded as a direct call's is (`_sc_post`, `t` the temp `_icall_sret` gave it;
# `beg` the fncallN / callptr name), and (6.7.14) its `: f64` / `: *T` result typed as the direct call's.
fn _icall_result(S, cfi, t, beg): i64 {
    _icall_untyped(S);
    if (_icall_sfn(S, cfi) == 1) { return _sc_post(S, cfi, _bx_fname(S, cfi), beg, t); }
    if (_pe_vret(S, cfi) == 1) { return _sc_post(S, cfi, _bx_fname(S, cfi), beg, t); }   # 6.7.12: its first word
    return _icall_scalar(S, cfi, beg);
}
# ⛔ 6.7.14 — A KNOWN CALLEE'S `: f64` AND `: *T` RESULTS ARE THE DIRECT CALL'S (the user's decisions D25 (a) and
# D26 (a), 2026-10-16: "as the direct call", the reading 6.7.11's D31, 6.7.12's D28 and 6.7.13's D15 / D16 give a
# known `&f`). `var a = fncall0(&f); a + 1.5` with `f: f64` added integers under a kind-1 warning (the f64 type was
# kept only when the LAST ARGUMENT was an f64, 6.7.6's rule above), and `fncall0(&gp)` with `gp: *P2` was an untyped
# word: `var w: *P2 = fncall0(&gp);` warned "assigning non-pointer to typed pointer" and `fncall0(&gp) + 1` stepped
# one byte where `gp() + 1` steps one P2. Now the f64 is brought into rax and typed (`_call_ret_marks`' f64 half) and
# a `*T` carries T's step (`_fn_ret_ps`), whatever the arguments; a callee held in a variable stays a word (D31).
# An untyped `var a = fncall0(&f);` takes the f64 after its parse (`_var_rhs_if64`); the step is recorded against
# the call's fncallN / callptr token `beg`, which the factor's scale fix (`_call_scale_fix`) keeps. CHANGELOG [6.7.14]
# 6.7.15 (the user's decision D30 (a), 2026-10-18): and a `: bool` callee's result is a boolean value, as `isb()`'s is
# (`_call_ret_ps`' 6.7.3 mark): `var b: bool = fncall0(&isb);` was refused "not a bool". And (D31 (a)) a `*T`'s
# element kind is the value's own, as `bp()`'s is: `_sub_word` / `_pk_post` / `_sub_ret_sid` read this record, so
# `*fncall0(&bp)` with `bp: *u8` reads one byte (it read the word) and `fncall0(&bp)[1]` subscripts. CHANGELOG [6.7.15]
var _icall_ps_beg = 0 - 1;
var _icall_ps = 0;
var _icall_fi = 0 - 1;   # 6.7.15 (D31): ... and its callee, for a `*S` element's name (`_sub_ret_sid`)
fn _icall_scalar(S, cfi, beg): i64 {
    _icall_ps_beg = beg;
    _icall_ps = _fn_ret_ps(cfi);
    _icall_fi = cfi;
    SPSC(S, _icall_ps);
    if (cfi < 0) { return 0; }
    if (GFRS(S, cfi) == 0 - 9) { EMOVQ_A_X0(S); SESTYPE(S, F64_TYID); }
    if (_bx_fn_is_bool(S, cfi) == 1) { _BX_MARK(S); }   # D30: last, after any emission
    return 0;
}
# ⛔ 6.7.11 — A KNOWN CALLEE'S STRUCT RESULT. A call through a fn pointer must give a struct-returning
# callee the convention a direct call gives it — the hidden result pointer over 16 B (x86 / cx / Win64
# int arg 0, pushed before the user arguments and after PE's callee push, which ECALLPTR_PE pops last;
# aarch64 X8), the register pair at 9-16 B — and hand every destination a struct value; without it the
# callee wrote through its first argument. Where the callee is written `&f` (`_icall_callee`) the call
# takes the struct-call hooks a method call takes (`_sc_pre` / `_sc_x8` / `_sc_post`). A callee held in
# a variable is unknown: its result is a word, and a struct-typed receive of it is a handle (the
# user's decision, 2026-10-13). CHANGELOG [6.7.11]
# 1 = fn `cfi` (-1: not known) returns a struct by value.
fn _icall_sfn(S, cfi): i64 {
    if (cfi < 0) { return 0; }
    if (GFRS(S, cfi) <= 0) { return 0; }
    return 1;
}
# The struct the callee of a call through fncallN / callptr at token `ti` returns, read from the
# tokens: `callptr (` or a lowered fncallN name `(`, then `&f` alone as the first argument, `f` a fn
# returning a struct. 0 otherwise. A route for the destinations that must decide before the parse
# (an argument, `return`); what the parse finds (`_icall_callee`, which sees a local or global that
# shadows `f`) is the record they read.
fn _icall_sid_at(S, ti): i64 {
    var r = _icall_rs_at(S, ti);
    if (r <= 0) { return 0; }
    return r;
}
# ... the declared return (GFRS: a struct, a vector's descriptor, a scalar's sentinel) of that `&f`, or 0.
fn _icall_rs_at(S, ti): i64 {
    var f = _icall_fti(S, ti);
    if (f < 0) { return 0; }
    var fi = FINDFN(S, TOKVAL(S, f));
    if (fi < 0) { return 0; }
    return GFRS(S, fi);
}
# ⛔ 6.7.13 — A PARENTHESISED `&f` CALLEE IS THE KNOWN CALLEE. `callptr((&mk3), 5)` was an unknown callee:
# the token routes wanted `&` right after the call's `(`, so the struct result convention was lost (SIGSEGV).
# The `f` token of the call through fncallN / callptr at token `ti` when its first argument is `& IDENT`
# alone, inside any parentheses wrapping that whole argument (`_pwrap_in`) — the name followed by the
# wrap's closers, then `,` / `)`; else -1. CHANGELOG [6.7.13]
fn _icall_fti(S, ti): i64 {
    var o = _icall_open_at(S, ti);
    if (o < 0) { return 0 - 1; }
    var a = _pwrap_in(S, o + 1);
    if (a < 0) { return 0 - 1; }
    if (TOKTYP(S, a) != 27) { return 0 - 1; }
    if (TOKTYP(S, a + 1) != 2) { return 0 - 1; }
    var e = a + 2;
    var k = a - (o + 1);
    while (k > 0) {
        if (TOKTYP(S, e) != 11) { return 0 - 1; }
        e = e + 1;
        k = k - 1;
    }
    var nx = TOKTYP(S, e);
    if (nx != 31) { if (nx != 11) { return 0 - 1; } }
    return a + 1;
}
# The `(` of a call through fncallN / callptr at token `ti` (PARSE_FACTOR's gates), or -1.
fn _icall_open_at(S, ti): i64 {
    if (TOKTYP(S, ti + 1) != 10) { return 0 - 1; }
    if (TOKTYP(S, ti) == 137) { return ti + 1; }
    if (TOKTYP(S, ti) != 2) { return 0 - 1; }
    if (_IS_FNCALL_NAME(S, TOKVAL(S, ti)) == 0) { return 0 - 1; }
    if (FINDFN(S, TOKVAL(S, ti)) < 0) { return 0 - 1; }
    return ti + 1;
}
# Before the first argument (cursor past the callee): the result's temp, or -1; `_sc_n0` = 1 when its
# address was pushed as int arg 0.
fn _icall_sret(S, cfi, beg): i64 {
    _sc_n0 = 0;
    if (beg == _icall_vbeg) { return _icall_vret(S); }
    if (_icall_sfn(S, cfi) == 0) { if (_pe_vret(S, cfi) == 0) { return 0 - 1; } }   # 6.7.12: a Win64 vector's pointer
    return _sc_pre_c(S, cfi, _bx_fname(S, cfi), beg, beg + 1);   # 6.7.13: + a 9-16 B temp when a chain follows
}
# ⛔ 6.7.13 — A KNOWN CALLEE'S RESULT TAKES `.field` AND `.method(..)` (the user's decision D16 (a), 2026-10-15):
# `fncall1(&mk3, 5).b`, `callptr(&mk3, 5).tot()`, `fncall1((&gp), 5).n`, as `mk3(5).b` (6.6.12) and a method's
# result (6.6.17) do. The call returned at its `)` and the `.` was "expected ';'". After the call the method arm's
# chain runs on the result (`_method_chain`: a struct in the temp `_icall_sret` gave it, a `*T` parked, a scalar
# callee and a top-level struct refused by name); a callee in a variable is unknown, its result a word (D31), so a
# `.name` on it is refused by name. Cursor past the call's `)`; `beg` the fncallN / callptr token. CHANGELOG [6.7.13]
fn _icall_chain(S, cfi, t, beg): i64 {
    if (_mchain_at(S, GTI(S)) == 0) { return 0; }
    if (cfi < 0) { return _icall_fld_err(S, beg); }
    _method_chain(S, cfi, _bx_fname(S, cfi), beg, t);
    _cfo = 0;
    return 1;
}
# Silent under `--syntax-only` (lint's pre-pass), where a callee from a sibling file is unknown too, as `_method_chain`
# and `_call_field` stay silent there.
fn _icall_fld_err(S, beg): i64 {
    var say = 0;
    if (_panic + _syntax_only == 0) { if (_derr_seen(GTI(S), "_icall_fld_err", beg, 1) == 0) { say = 1; } }   # 6.7.15
    if (say == 1) {
        _ew("error:", 6);
        _err_head(S);
        PRSTR(": cannot take a field of the result of '");
        if (TOKTYP(S, beg) == 137) { PRSTR("callptr"); }
        else { PRSTR(S + 0xEC00000 + TOKVAL(S, beg)); }
        PRSTR("': its callee is a value, not `&f`, so the result is a word\n");
        _err_excerpt(S);
        _had_error = 1;
        _panic = 1;
    }
    _mchain_skip(S);
    return 1;
}
# The statement form `fncall1(&mk3, 5).tot();` (`_call_field` from `_stmt_call_field`, ti the lowered fncallN
# name): the call as PARSE_STMT lowers it, its chain run by `_icall_chain`. 1.
fn _icall_stmt_chain(S, ti): i64 {
    _fncall_expect = 0 - 1;   # 6.7.14: `callptr` (token 137, `_stmt_callptr_field`) is variadic: no arity
    if (TOKTYP(S, ti) == 2) { _fncall_expect = ((L64(S + 0xEC00000 + TOKVAL(S, ti)) >> 48) & 0xFF) - 48; }
    STI(S, ti + 2);
    PINDIRECT_CALL(S);
    _cfo = 0;
    return 1;
}
# 6.7.11 — a value-form vector receive of `fncallN(&f, ..)` / `callptr(&f, ..)` (`_vrcv_emit`,
# parse/decl/vector.cyr) on PE: a vector result comes back through a hidden pointer there (int arg 0), as
# from `f(..)`, so the call whose name is token `_icall_vbeg` (one-shot) passes the destination's
# address, slot `_icall_vdst`. Elsewhere the result is in the vector registers and the receive
# stores them. -1 (no struct temp).
var _icall_vbeg = 0 - 1;
var _icall_vdst = 0;
fn _icall_vret(S): i64 {
    _icall_vbeg = 0 - 1;
    EFLADDR(S, _icall_vdst);
    EPUSHR(S);
    _sc_n0 = 1;
    return 0 - 1;
}
# ⛔ 6.7.13 — AN INDIRECT CALL'S OWN SPILL SLOTS COUNT IN THE FRAME. A fresh anonymous frame slot (the callee value,
# the callee pointer), recorded in the `_flc_hwm` high-water as every other transient slot is: the inline replay
# releases GFLC back to its parameters after each argument, so a slot GFLC alone counted could lie below the frame,
# where the call's own argument `push` landed on it: D30's `la(callptr(&mkv, 4, 2))` into an inline-replayed
# value-form vector parameter passed `mkv` its code address as `a` (2 on x86_64 where 42 is right), and
# `lc(callptr(&mkv, 4, 2), 0)` faulted. CHANGELOG [6.7.13]
fn _icall_slot(S): i64 {
    var t = GFLC(S);
    S64(S + 0x5D9D000 + t * 8, 0 - 1);   # anonymous (stale-name guard)
    SLDEP(S, t, 0);
    SFLC(S, t + 1);
    if (t + 1 > _flc_hwm) { _flc_hwm = t + 1; }
    return t;
}
fn _PINDIRECT_CALL_IN(S): i64 {
    var cst = _icall_mark(S);
    PCMPE(S);                               # eval callee → rax
    var cfi = _icall_callee(S, cst);
    var cp_ce = GTI(S);                     # 6.7.17 (D109): the callee's end, for `_arr_iarg`
    var cp_v = _icall_slot(S);
    EFLSTORE(S, cp_v);                      # spill the callee VALUE
    var cp_idx = 0;
    var cp_argc = 0;
    # v6.0.86: on PE the callee goes on the STACK (pushed FIRST, below the args),
    # NOT a frame slot — a GFLC slot could alias a `&`-taken local (the COM
    # out-param AV; see ECALLPTR_PE). Non-PE keeps the frame-slot spill (its
    # ECALLPOPS shadow would otherwise bury a stack-pushed callee).
    if (_TARGET_PE == 1) {
        EFLLOAD(S, cp_v);
        ECLNORM(S, cp_v);                   # rax = real code address
        EPUSHR(S);                          # push callee (consumed by ECALLPTR_PE)
    }
    var cp_t = _icall_sret(S, cfi, cst - 2);   # 6.7.11: a known callee's struct result
    var cp_n0 = _sc_n0;
    while (PEEKT(S) == 31) {                # ',' → another arg
        STI(S, GTI(S) + 1);                 # consume ','
        if (_pd_label_at(S, GTI(S)) == 1) { _pd_icall_named(S, cst); }   # 6.7.7 (B6): C7
        var cp_at = GTI(S);
        PCMPE(S);                           # eval arg → rax
        _arr_iarg(S, cfi, cp_argc, cp_at, cst, cp_ce);   # 6.7.17 (D109): an array's name into a pointer parameter
        EPUSHR(S);                          # push arg
        cp_argc = cp_argc + 1;
    }
    _expect_step(S, 11);                    # consume ')' (6.7.14: a miss keeps a `;` / keyword)
    # ⛔ v6.5.46 — THE `fncallN` FAMILY WAS EXEMPT FROM THE CALL-ARITY CHECK that ordinary calls
    # have enforced as a hard error since v6.5.1. `fncall3(f, a, b)` and `fncall1(f, a, b, c)`
    # both compiled: the name says how many arguments follow, `cp_argc` counts how many did, and
    # the two were never compared. The result is not a miscompile of correct code — it is the
    # ABSENCE of a diagnostic, so a caller that miscounts gets a callee reading an argument slot
    # nobody wrote (too few) or silently ignoring a value (too many), with no message either way.
    # ⚠ `callptr` is deliberately NOT checked: its callee is a runtime value whose arity the call
    # site cannot know. That is why the expectation is carried in `_fncall_expect` rather than
    # derived here — the two callers of this function want different rules.
    var _fe = _fncall_expect;
    _fncall_expect = 0 - 1;
    if (_fe >= 0) {
        if (cp_argc != _fe) {
            ERR_MSG(S, "fncallN argument count does not match the N in its name", 55);
        }
    }
    _pd_icall_short(S, cfi, cp_argc, cst);   # 6.7.7 (B6): C15 — defaults fill only a direct call
    cp_argc = cp_argc + cp_n0;              # 6.7.11: + the result's address (int arg 0)
    # The env rides in an argument REGISTER or not at all. Under SysV the caller
    # places stack arguments anchored on the LAST one (ECALLPOPS puts a_n at
    # [rsp+0]) and the callee reads them back the same way (ESTORESTACKPARM's
    # `si = nstack - 1 - (pidx - 6)`), so a trailing extra argument slides every
    # stack argument of an ordinary callee by 8 bytes. Measured, not reasoned:
    # `callptr(&nargs7, 1,2,3,4,5,6,21)` in tests/tcyr/codegen/callptr.tcyr returned
    # a code address instead of 42, because nargs7's 7th parameter read the env.
    # Below the register ceiling nothing moves, so the extra argument is free — and
    # a capturing closure that needs more parameters than that is rejected where it
    # is DEFINED (see the closure prologue), not silently miscompiled here.
    if (cp_argc < _ARG_REG_COUNT()) {
        EFLLOAD(S, cp_v);
        ECLENV(S);                          # rax = env pointer (no-op on a bare fn ptr)
        EPUSHR(S);                          # push the hidden env arg — LAST
        cp_argc = cp_argc + 1;
    }
    # v6.0.71: on PE/Win64, an indirect call can target a REAL Win64 callee (a COM
    # vtable method) whose aligned SSE spills need rsp ≡ 0 at the `call`. The generic
    # marshal+call below runs at cyrius's constant body alignment, which lands callees
    # at ≡ 0 entry (off by 8) — fine for cyrius callees (no SSE), fatal for real Win64
    # ones. ECALLPTR_PE force-aligns the call with an rbx-anchored `and rsp,-16` (the
    # kernel32-reroute pattern), so the callee is entered ABI-correct regardless of
    # caller alignment. See
    # 2026-06-05-windows-com-vtable-real-callee-frame-corruption.md.
    if (_TARGET_PE == 1) {
        # v6.4.26/v6.5.17: capturing and non-capturing callees share one path on PE —
        # cp_argc counts the user args PLUS the trailing env, and the already-
        # normalized code address was pushed as the callee (deepest).
        ECALLPTR_PE(S, cp_argc);            # pop args + pop callee (rax) + call rax
    } else {
        EFLLOAD(S, cp_v);
        ECLNORM(S, cp_v);                   # rax = real code address
        cp_idx = _icall_slot(S);            # fresh frame slot for the callee ptr
        EFLSTORE(S, cp_idx);                # spill callee → [rbp-disp(cp_idx)]
        ECALLPOPS(S, cp_argc);              # marshal args into arg regs (+ Win64 shadow)
        _sc_x8(S, cfi, cp_t);               # 6.7.11: aarch64's result pointer
        ECALLIND(S, cp_idx);                # load callee from the slot + call/blr
        ECALLCLEAN(S, cp_argc);             # unwind the arg frame
    }
    _cfo = 0;
    _icall_result(S, cfi, cp_t, cst - 2);   # 6.7.6: the result is not its last argument's struct (an f64: FE)
    _icall_chain(S, cfi, cp_t, cst - 2);    # 6.7.13 (D16 (a)): `.field` / `.m(..)` on it
    return 0;
}

# ⛔ 6.7.6 — A NAME INTRINSIC'S RESULT INHERITED ITS LAST ARGUMENT'S STRUCT TYPE. `mulh64(..)`,
# `fncall0`..`fncall8(..)` and `callptr(..)` parse their arguments as expressions inside the call's
# factor, and the expression state the last one left (its struct type, its variable) survived the
# call: with `n: Num` and `fn Num_add`, `fncall1(&f, n) + 1` and `mulh64(3, n) + 1` dispatched
# `Num_add` (100 where 8 / 1 is right), silently. A free call resets the type in PARSE_FNCALL; these
# lower in place, so the result — an untyped word — is marked here. CHANGELOG [6.7.6]
fn _icall_untyped(S): i64 {
    SESTYPE(S, 0);
    SESVAR(S, 0 - 1);
    _esv_name = 0 - 1;
    return 0;
}
# `mulh64(a, b)` (cursor on the name): the high 64 bits of a 64x64 unsigned multiply. Out of
# _PARSE_FACTOR_IMPL, whose body sits at cybs's silent per-fn reference ceiling. CHANGELOG [6.7.6]
fn _lower_mulh64(S): i64 {
    STI(S, GTI(S) + 1);
    _expect_step(S, 10);
    PCMPE(S); EPUSHR(S);
    _expect_step(S, 31);
    PCMPE(S); EPOPC(S); EMULH(S);
    _expect_step(S, 11);
    _cfo = 0;
    _icall_untyped(S);
    return 0;
}

# v6.6.5 — the Windows MONOTONIC-clock reroutes, 0xF038 QueryPerformanceCounter and
# 0xF039 QueryPerformanceFrequency, both `BOOL f(LARGE_INTEGER*)` → argc==2.
#
# ⚠ THEY LIVE IN THEIR OWN FUNCTION ON PURPOSE. The PE reroute chain inside
# `_PARSE_FACTOR_IMPL` is the longest one in this file, and **cybs** — the hand-assembly
# bootstrap compiler the 29 KB seed assembles, which must compile this file on the way to
# cycc — fails SILENTLY past its per-function limit on global and call references. Adding
# two more inline arms there risks losing the seed→cybs→cycc chain, which is days of
# repair; one call ref does not. Returns 1 if it routed.
#
# The var-number switch (`EPE_SYSCALL_DYNAMIC`) is deliberately NOT extended for these:
# every caller spells the number as a literal (lib/syscalls_windows.cyr's `sys_qpc`/
# `sys_qpf`, and lib/chrono.cyr's `_chrono_qpc_ns` / lib/bench.cyr's `_bench_qpc_ns`,
# which spell them raw to stay self-sufficient), and a non-literal number degrades to an
# honest -38/-ENOSYS. ⚠ WITHOUT a compile-time warning at argc 2: the var-number warning
# fires only for an arity with NO routable member, and argc 2 has several (the value is
# known only at run time). Corrected 6.6.9; the claim that stood here said it warned.
fn _PE_ROUTE_PERFCOUNTER(S, sc_num, argc): i64 {
    if (argc != 2) { return 0; }
    if (sc_num == 61496) { EQPC_PE(S); return 1; }
    if (sc_num == 61497) { EQPF_PE(S); return 1; }
    return 0;
}

# v6.6.8 — the arity each Mach-O PARSE-TIME reroute fires at, or 0 if `n` is not one. `argc`
# counts the number itself, as the reroute blocks in the syscall() parse do: 228 (clock) and 35
# (nanosleep) at 3, 1700 (pthread_create, arm64 only) at 5, and 1701 (libSystem fork, arm64
# only; 6.6.13) at 1. MUST mirror those blocks; the
# Darwin syscall gate probes every in-tree literal site at its real argc through this diagnostic.
# 6.6.10: 35 on BOTH backends. arm64 reroutes it inside ESYSXLAT (EMACHO_NANOSLEEP_ARM), which
# used to fire at ANY arity — at argc 1 it dereferenced x0 = the number (SIGSEGV, no warning) —
# and now fires at argc 3 only, so every other arity is SIGSYS, as on x86-macOS and PE.
fn _macho_reroute_argc(tgt, n): i64 {
    if (n == 228) { return 3; }
    if (n == 35) { return 3; }
    if (tgt == 2) { if (n == 1700) { return 5; } }
    if (tgt == 2) { if (n == 1701) { return 1; } }
    return 0;
}

# 6.6.10 — the MINIMUM arity of the Mach-O pipe emulations, or 0. Darwin pipe returns both fds in
# registers and the backend stores them through the caller's fds pointer, so a call that passes
# no pointer (argc 1) has nothing to store through: the backend now emits no row for it
# (x86 `_msx_short`, arm64 `_esx_short`) and the call is SIGSYS. Before, x86-macOS stored the
# fds through a STALE rdi — a silent 8-byte write — and arm64-macOS through x0 = 59 (SIGSEGV).
# pipe is 22 on the x86 peer and pipe2 59 on the aarch64 peer.
fn _macho_min_argc(tgt, n): i64 {
    if (tgt == 1) { if (n == 22) { return 2; } }
    if (tgt == 2) { if (n == 59) { return 2; } }
    return 0;
}

# The ELF-aarch64 raw-syscall-number warning (the comment at its call in _PARSE_FACTOR_IMPL), out of that
# cybs-ceiling fn; once per site (`_warn_seen`: a generic body is parsed per instance, an #inline one per call).
# CHANGELOG [6.7.15]
fn _sysx_raw_warn(S, sc_num): i64 {
    if (sc_num >= 0) {
        var sxm = _sysx_meant_here(S, sc_num);   # 6.6.12: 0 inside a native aarch64 #ifdef
        if (sxm != 0) {
            if (_warn_seen(GTI(S), "_sysx_raw_warn", sc_num) == 1) { return 0; }   # 6.7.15: once per site
            _ew("warning:", 8);
            _err_head(S);
            _ew(": raw syscall ", 14);
            PRNUM(sc_num);
            _ew(" is x86_64 `", 12);
            PRSTR(sxm);
            # ⛔ THIS SECOND CLAUSE WAS DEAD CODE FROM v6.5.51 TO v6.6.4 — measured, 43
            # rows compiled, 43 taking the `sxa == 0` path and not one carrying the
            # better text. It was structural, not luck: `_SYSX_ACTUALLY` was generated
            # from the aarch64 stdlib PEER's declarations while `_row_wanted` emits a
            # `_SYSX_MEANT` row only for x86 numbers that peer does NOT declare, so the
            # two sets could not intersect. The single most useful half of the whole
            # diagnostic — naming the call the number really invokes on ARM — therefore
            # never printed once. v6.6.5 regenerates `_SYSX_ACTUALLY` from the committed
            # KERNEL table instead (tests/data/syscalls/aarch64.tbl), restricted to the
            # `_SYSX_MEANT` numbers, so 35 of the 43 now carry it and the rest are
            # genuinely unassigned on aarch64. CHANGELOG [6.6.5]
            var sxa = _SYSX_ACTUALLY(sc_num);
            if (sxa != 0) {
                _ew("`; on ELF-aarch64 that number is `", 34);
                PRSTR(sxa);
                _ew("`. Use ", 7);
            }
            if (sxa == 0) {
                # v6.6.5: the table is the KERNEL's generic aarch64 list now, so a 0 here
                # means the number really is unassigned on aarch64 and the call returns
                # -ENOSYS. (v6.6.4's text said "not one the aarch64 stdlib declares",
                # correct while the table came from the peer; before that it claimed "not
                # a syscall at all", which was simply false — 91 is capset there.)
                _ew("`; on ELF-aarch64 that number is unassigned, so the call fails with -ENOSYS", 75);
                _ew(". Use ", 6);
            }
            PRSTR(_SYSX_USE(sc_num));
            _ew(" from lib/syscalls.cyr instead of the raw number.
", 50);
        }
    }
    return 0;
}

# Warns and returns 1 when `sc_num` is below its Mach-O emulation's minimum arity. Its own fn so
# _macho_warn_unrouted does not grow past cybs's per-function reference limit. CHANGELOG [6.6.10]
fn _macho_warn_short(sc_num, argc): i64 {
    var need = _macho_min_argc(_TARGET_MACHO, sc_num);
    if (need == 0) { return 0; }
    if (argc >= need) { return 0; }
    _ew("warning: syscall ", 17);
    PRNUM(sc_num);
    _ew(" not routed at this arity: its Mach-O emulation stores through a pointer argument and this call passes none; it will SIGSYS on macOS. Pass the fds buffer, or use the stdlib wrapper.\n", 182);
    return 1;
}

# 6.6.10 — the PE "unrouted literal syscall" warning names the NUMBER and the SITE. It was one
# 1,471-byte line naming neither, so the warnings left in a PE compiler build could not be
# attributed to a call. The cursor is past the call's `)`; walk back over the balanced
# parentheses to its `syscall` token so the site is the call, not the `;` after it. The
# routed-number list is a note printed ONCE per compile, not once per site.
# 6.6.18 — the generic syscall path (every backend's ESCPOPS) pops the number plus at most six
# arguments: x86 into rdi..r9, aarch64 into x0..x5, cx into r2..r7. An 8th pushed value was left
# on the stack and the pops shifted by one, so the call ran with an ARGUMENT as its number and
# leaked 16 bytes — and on arm64 macOS a variable number at that arity left its `bl .` placeholder
# unpatched (an infinite loop). Refused by name instead. The PE parse-time reroutes that take
# more (WSARecv/WSASend at 8, WSAIoctl at 10) return before ESCPOPS and are unaffected.
# CHANGELOG [6.6.18]
fn _sc_argc_refuse(S, n): i64 {
    if (n <= 7) { return 0; }
    ERR_MSG(S, "syscall() takes at most 6 arguments after the number: no backend passes a 7th (it would be popped as the syscall number)", 120);
    return 1;
}
var _pe_unrouted_noted = 0;
# The call's `syscall` token, the cursor just past its `)`.
fn _sc_site_ti(S): i64 {
    var ti = GTI(S) - 1;
    var depth = 0;
    while (ti > 0) {
        var t = TOKTYP(S, ti);
        if (t == 11) { depth = depth + 1; }
        if (t == 10) {
            depth = depth - 1;
            if (depth == 0) { break; }
        }
        ti = ti - 1;
    }
    if (ti > 0) { ti = ti - 1; }
    return ti;
}
fn _pe_warn_unrouted(S, sc_num, argc): i64 {
    if (_panic == 1) { return 0; }   # a refused call (`syscall(60 0)`): its arity is unknown. CHANGELOG [6.7.16]
    var ti = _sc_site_ti(S);
    if (_warn_seen(ti, "_pe_warn_unrouted", sc_num * 4096 + argc) == 1) { return 0; }   # 6.7.15: once per site
    _ew("warning:", 8);
    _err_head_at(S, ti);
    _ew(": syscall ", 10);
    PRNUM(sc_num);
    _ew(" with ", 6);
    PRNUM(argc - 1);
    _ew(" argument(s) is not routed on CYRIUS_TARGET_WIN=1; it returns -38 (-ENOSYS) on Windows. Guard the call with #ifdef CYRIUS_TARGET_WIN, use the stdlib wrapper, or add a PE reroute.\n", 179);
    if (_pe_unrouted_noted == 1) { return 0; }
    _pe_unrouted_noted = 1;
    _ew(
      "  note: CYRIUS_TARGET_WIN=1 routes, each at its own arity, n=0,1,2,3,8,9,11,35,60,74,75,83,87,228 + 0xF001-0xF005 (process creation) + 0xF006 (cmdline) + 0xF007-0xF00A (threading) + 0xF00B-0xF00E (thread-local) + 0xF00F (sleep) + 0xF010-0xF011 (CommandLineToArgvW/LocalFree) + 0xF012 (CreateDXGIFactory1) + 0xF013-0xF015 (GetModuleHandleA/GetProcAddress/GetEnvironmentVariableA) + 0xF016-0xF019 (FindFirstFileW/FindNextFileW/FindClose/GetFileAttributesW) + 0xF01A (ProcessPrng CSPRNG) + 0xF01B (GetSystemTimeAsFileTime) + 0xF01C (GetCurrentProcessId) + 0xF01D (TerminateProcess) + 0xF01E (WSAStartup) + 0xF01F-0xF021 (IOCP: CreateIoCompletionPort/GetQueuedCompletionStatus/PostQueuedCompletionStatus) + 0xF022-0xF02C (ws2_32: WSASocketW/closesocket/WSAGetLastError/bind/getsockopt/WSAIoctl/connect/WSARecv/WSASend/getaddrinfo/freeaddrinfo) + 0xF02D-0xF032 (kernel32/ws2_32: RegisterWaitForSingleObject/CreateWaitableTimerW/SetWaitableTimer/UnregisterWaitEx/CancelIoEx/setsockopt) + 0xF033 (ws2_32: listen) + 0xF034 (kernel32: MoveFileExW) + 0xF035 (kernel32: DeleteFileW) + 0xF036-0xF037 (ws2_32: getpeername/getsockname) + 0xF038-0xF039 (kernel32: QueryPerformanceCounter/QueryPerformanceFrequency) + 0xF03A-0xF03B (kernel32: GetModuleFileNameW/RemoveDirectoryW) + 0xF03D-0xF03F (kernel32: GetFileInformationByHandleEx/CreateSymbolicLinkW/SetEndOfFile) + 0xF040-0xF044 (kernel32: CreateJobObjectW/AssignProcessToJobObject/TerminateJobObject/ResumeThread/SetInformationJobObject) + 0xF045-0xF04A (ws2_32: accept/shutdown/send/recv/ioctlsocket/WSAPoll) + 0xF04B (kernel32: GetLastError) + 0xF04C-0xF04D (kernel32: LockFileEx/UnlockFileEx) + 0xF04E (kernel32: GetFinalPathNameByHandleW) + 0xF04F (kernel32: GetLastError as -errno).\n",
      1730);
    return 0;
}

# The non-literal-number twin of `_pe_warn_unrouted`: no route at this arity, named at the call's site, once per site
# and arity (it was a bare `warning:` line naming neither). A refused call's arity is unknown, so it says nothing there.
# CHANGELOG [6.7.16]
fn _pe_warn_dyn(S, argc): i64 {
    if (_panic == 1) { return 0; }
    var ti = _sc_site_ti(S);
    if (_warn_seen(ti, "_pe_warn_dyn", argc) == 1) { return 0; }
    _ew("warning:", 8);
    _err_head_at(S, ti);
    _ew(": syscall(<non-literal number>, ...) with ", 42);
    PRNUM(argc - 1);
    _ew(
      " argument(s) has no Windows-routable syscall of this arity on CYRIUS_TARGET_WIN=1 - emits -ENOSYS (-38). Harmless if the path is Linux-only (dead on Windows); else guard with #ifdef CYRIUS_TARGET_WIN or add a PE reroute.\n",
      221);
    return 0;
}

# The Mach-O "syscall not routed" diagnostic — both backends, one source of truth each
# (_macho_x86_routes replays EMACHO_SYSXLAT's rows, _macho_arm_routes replays ESYSXLAT's).
# ⛔ v6.6.8 — IT WAS BLIND TO ARITY. The route queries answer by NUMBER, but the parse-time
# reroutes (228/35 on x86-macOS, 228/1700 on arm64-macOS) fire only at one argc, so a
# wrong-arity `syscall(228, id)` or `syscall(35, &ts)` was neither rerouted NOR warned: it fell
# through to the chain and faulted at run time from a clean build. Such a call is now reported
# with the arity the reroute wants. Also since v6.6.8 the arm64 wording says SIGSYS, which it
# now is — ESYSXLAT's chain head defaults x16 to an invalid number; before that an unrouted
# arm64 number silently re-ran the previous syscall and "will fault" was false.
# v6.5.43: the x86 Mach-O half. _TARGET_MACHO==1 had NO unrouted diagnostic at all, so a
# missing _msx row was silent at compile time and a SIGSYS at runtime — the shape that let
# `ioctl` sit unrouted until v6.5.36 and that macho_route_parity.sh exists to catch.
fn _macho_warn_unrouted(sc_num, argc): i64 {
    if (sc_num < 0) { return 0; }
    if (_TARGET_MACHO != 1) { if (_TARGET_MACHO != 2) { return 0; } }
    var shw = _macho_warn_short(sc_num, argc);
    if (shw == 1) { return 0; }
    var want = _macho_reroute_argc(_TARGET_MACHO, sc_num);
    if (want > 0) {
        if (argc != want) {
            _ew("warning: syscall ", 17);
            PRNUM(sc_num);
            _ew(" not routed at this arity: its Mach-O reroute takes the number plus ", 68);
            PRNUM(want - 1);
            _ew(" argument(s) and this call passes ", 34);
            PRNUM(argc - 1);
            _ew("; it will SIGSYS on macOS. Pass the full argument list, or use the stdlib wrapper.\n", 83);
            return 0;
        }
    }
    if (_TARGET_MACHO == 1) {
        var sx_ok = _macho_x86_routes(sc_num);
        if (sx_ok == 0) {
            _ew("warning: syscall ", 17);
            PRNUM(sc_num);
            _ew(
              " not routed by the Mach-O x86 translation (EMACHO_SYSXLAT); will SIGSYS on macOS. Add an _msx row or use a stdlib wrapper.\n",
              123);
        }
    }
    if (_TARGET_MACHO == 2) {
        # v6.0.65: query the single source of truth (_macho_arm_routes, adjacent to ESYSXLAT)
        # instead of a parallel hardcoded list that drifted out of sync.
        var sc_ok = _macho_arm_routes(sc_num);
        if (sc_ok == 0) {
            # v6.5.43: NAME the number. This warned 470 times during cycc's own build and never
            # once said which syscall — so it read as noise and was scrolled past.
            _ew("warning: syscall ", 17);
            PRNUM(sc_num);
            _ew(
              " not routed by the Mach-O ARM translation (ESYSXLAT/__got); will SIGSYS on macOS. Add an ESYSXLAT entry or use a stdlib wrapper.\n",
              129);
        }
    }
    return 0;
}

# v6.6.6 — 0xF03A GetModuleFileNameW(NULL, wbuf, cch) → argc == 3. The Windows source
# for "the full path of THIS executable"; the cyrius-side wrapper is `sys_self_exe_w`
# (lib/syscalls_windows.cyr), whose caller narrows the UTF-16 result with `_args_w2u8`.
# Its own function for the same reason as _PE_ROUTE_PERFCOUNTER above — the inline PE
# chain in `_PARSE_FACTOR_IMPL` is already near cybs's per-function global/call-reference
# limit, past which cybs fails SILENTLY and the seed→cybs→cycc chain is lost. Returns 1
# if it routed. Literal-only, like the perfcounter pair: the one caller spells the number
# as a literal, and a non-literal degrades to an honest -38 with a warning.
fn _PE_ROUTE_MODULEPATH(S, sc_num, argc): i64 {
    if (argc != 3) { return 0; }
    if (sc_num == 61498) { EGETMODFILENAME_PE(S); return 1; }
    return 0;
}

# v6.6.7 — Linux fsync (74) / fdatasync (75), argc == 2 → kernel32!FlushFileBuffers
# (EFLUSHFB_PE). The LINUX numbers are routed, not a new 0xF0xx id — the precedent of
# 83 → CreateDirectoryW and 87 → DeleteFileW — so every caller that already spells
# `syscall(SYS_FSYNC/SYS_FDATASYNC, fd)` (the vendored patra fold's raw fdatasync, which
# was a loud -38 on Windows) flushes with no source change, and the Windows peer can
# define sys_fsync/sys_fdatasync the way every other peer does. Windows has one flush for
# data + metadata, so both numbers make the same call. Its own function for the cybs
# per-function reference limit (see _PE_ROUTE_PERFCOUNTER). A number held in a var reaches
# EPE_SYSCALL_DYNAMIC's argc-2 switch (`_pe_dyn_arity2`), which routes 74/75 the same way
# since 6.6.9 — before that it carried 3/60/87 only, so `var n = 74; syscall(n, fd)` got
# -38 with no warning while the literal flushed. CHANGELOG [6.6.7], [6.6.9]
fn _PE_ROUTE_FLUSH(S, sc_num, argc): i64 {
    if (argc == 2) {
        if (sc_num == 74) { EFLUSHFB_PE(S); return 1; }
        if (sc_num == 75) { EFLUSHFB_PE(S); return 1; }
    }
    # 6.6.20: munmap (11), argc == 3 → kernel32!VirtualFree(addr, 0, MEM_RELEASE) (EMUNMAP_PE).
    # Another LINUX number routed by its own value, so it rides this helper rather than adding an
    # inline arm (and its call reference) to `_PARSE_FACTOR_IMPL`. Before it every PE munmap
    # returned -38 and released nothing — fl_free leaked each large block. A var-held 11 reaches
    # `_pe_dyn_arity3`, which routes it the same way. CHANGELOG [6.6.20]
    if (argc == 3) {
        if (sc_num == 11) { EMUNMAP_PE(S); return 1; }
    }
    # 6.6.9: the file-handle table is reached THROUGH this helper, so the inline chain in
    # `_PARSE_FACTOR_IMPL` gains no reference (see _PE_ROUTE_PERFCOUNTER on the cybs limit).
    # Held in a var, not `return f(...)`: cybs miscompiles a tail call silently.
    var fh = _PE_ROUTE_FILEHANDLE(S, sc_num, argc);
    return fh;
}

# 6.6.9 — the reroutes behind POSIX open semantics on PE (lib/syscalls_windows.cyr):
#   0xF03D GetFileInformationByHandleEx(h, class, buf, size) → argc 5 — sys_open's verify of
#          the OPENED handle (name-surrogate reparse point → -ELOOP, O_DIRECTORY on a file →
#          -ENOTDIR);
#   0xF03E CreateSymbolicLinkW(link, target, flags) → argc 4 — sys_symlink / xsymlink; NARROW
#          UTF-8 paths since 6.7.12 (the emitter widens them; the link, and an absolute target,
#          get `\\?\` at 248+ units — a relative target is decoded only);
#   0xF03F SetEndOfFile(h) → argc 2 — O_TRUNC|O_NOFOLLOW truncates only after the verify, and
#          sys_ftruncate; 0 / -errno since 6.7.16 (the BOOL before).
# Literal-only, like every 0xF0xx id: a number held in a var reaches EPE_SYSCALL_DYNAMIC,
# which routes Linux numbers only and returns -38 for anything else. CHANGELOG [6.6.9]
fn _PE_ROUTE_FILEHANDLE(S, sc_num, argc): i64 {
    if (sc_num == 61501) { if (argc == 5) { EGETFINFO_PE(S); return 1; } }
    if (sc_num == 61502) { if (argc == 4) { ESYMLINKW_PE(S); return 1; } }
    if (sc_num == 61503) { if (argc == 2) { ESETEOF_PE(S); return 1; } }
    # 6.6.10: the Job-object table is reached THROUGH this helper, so the inline chain in
    # `_PARSE_FACTOR_IMPL` gains no reference (cybs's per-function limit — see
    # _PE_ROUTE_PERFCOUNTER). Held in a var, not `return f(...)`: cybs miscompiles a tail call.
    var jb = _PE_ROUTE_JOB(S, sc_num, argc);
    return jb;
}

# 6.6.10 — the reroutes behind a Windows process TREE (lib/process_win.cyr, lib/async_win.cyr,
# cbt's `_win_run_timed`): a child starts CREATE_SUSPENDED, joins a KILL_ON_JOB_CLOSE Job
# object, then resumes, and a deadline ends the job — before, it could TerminateProcess the
# direct child only, so a grandchild holding the capture pipe outlived the bound.
#   0xF040 CreateJobObjectW(attrs, name)             → argc 3
#   0xF041 AssignProcessToJobObject(job, hProcess)   → argc 3
#   0xF042 TerminateJobObject(job, code)             → argc 3
#   0xF043 ResumeThread(hThread)                     → argc 2
#   0xF044 SetInformationJobObject(job, class, info, len) → argc 5
# Literal-only, like every 0xF0xx id. The emitters are ECREATEJOB_PE … ESETJOBINFO_PE
# (x86/emit.cyr; stubs on the aarch64 and cx backends). CHANGELOG [6.6.10]
fn _PE_ROUTE_JOB(S, sc_num, argc): i64 {
    if (sc_num == 61504) { if (argc == 3) { ECREATEJOB_PE(S); return 1; } }
    if (sc_num == 61505) { if (argc == 3) { EASSIGNJOB_PE(S); return 1; } }
    if (sc_num == 61506) { if (argc == 3) { ETERMJOB_PE(S); return 1; } }
    if (sc_num == 61507) { if (argc == 2) { ERESUMETHREAD_PE(S); return 1; } }
    if (sc_num == 61508) { if (argc == 5) { ESETJOBINFO_PE(S); return 1; } }
    # 6.6.11: the ws2_32 socket table is reached THROUGH this helper, so the inline chain in
    # `_PARSE_FACTOR_IMPL` gains no reference (cybs's per-function limit — see
    # _PE_ROUTE_PERFCOUNTER). Held in a var, not `return f(...)`: cybs miscompiles a tail call.
    var sk = _PE_ROUTE_SOCK(S, sc_num, argc);
    return sk;
}

# 6.6.11 — the blocking ws2_32 verbs behind lib/net.cyr's PE arms (before them every net.cyr
# socket verb returned -38 on Windows, so http_* and sandhi's v4 path could not work):
#   0xF045 accept(s, addr, addrlen)       → argc 4
#   0xF046 shutdown(s, how)               → argc 3
#   0xF047 send(s, buf, len, flags)       → argc 5
#   0xF048 recv(s, buf, len, flags)       → argc 5
#   0xF049 ioctlsocket(s, cmd, argp)      → argc 4
#   0xF04A WSAPoll(fds, nfds, timeout)    → argc 4
# Literal-only, like every 0xF0xx id. The emitters are EACCEPT_PE … EWSAPOLL_PE
# (x86/emit.cyr; stubs on the aarch64 and cx backends). CHANGELOG [6.6.11]
fn _PE_ROUTE_SOCK(S, sc_num, argc): i64 {
    if (sc_num == 61509) { if (argc == 4) { EACCEPT_PE(S); return 1; } }
    if (sc_num == 61510) { if (argc == 3) { ESHUTDOWN_PE(S); return 1; } }
    if (sc_num == 61511) { if (argc == 5) { ESEND_PE(S); return 1; } }
    if (sc_num == 61512) { if (argc == 5) { ERECV_PE(S); return 1; } }
    if (sc_num == 61513) { if (argc == 4) { EIOCTLSOCK_PE(S); return 1; } }
    if (sc_num == 61514) { if (argc == 4) { EWSAPOLL_PE(S); return 1; } }
    # 6.6.12: 0xF04B kernel32!GetLastError() → argc 1, the kernel32 peer of 0xF024 (lib/fs_win.cyr
    # reads it after FindNextFileW returns 0). Routed HERE, at the end of the chain, so the inline
    # chain in `_PARSE_FACTOR_IMPL` gains no reference (cybs's per-function limit). CHANGELOG [6.6.12]
    if (sc_num == 61515) { if (argc == 1) { EGETLASTERR_PE(S); return 1; } }
    # 6.7.12: the file-lock pair is reached THROUGH this helper, so this chain gains one
    # reference (cybs's per-function limit). Held in a var, not `return f(...)`: cybs
    # miscompiles a tail call.
    var fl = _PE_ROUTE_FILELOCK(S, sc_num, argc);
    return fl;
}

# 6.7.12 — kernel32's byte-range locks behind xflock's Windows arm (lib/io.cyr), which answered
# -1 for every lock, so patra's open-time WAL recovery never ran on Windows; and where an opened
# handle really is, for cbt's [embed] / ${file:} open (lib/fs_win.cyr win_handle_under — a
# directory swapped for a junction after the per-prefix link check was followed on Windows):
#   0xF04C LockFileEx(h, flags, 0, lenLo, lenHi, &ov)  → argc 7
#   0xF04D UnlockFileEx(h, 0, lenLo, lenHi, &ov)       → argc 6
#   0xF04E GetFinalPathNameByHandleW(h, buf, cch, fl)  → argc 5
#   0xF04F the last error as -errno (the Win32 table)  → argc 1 (6.7.17: xflock's other
#          failures answer it — a closed handle -9, 6.7.17's D37; it answered -1)
# Literal-only, like every 0xF0xx id. The emitters are ELOCKFILEEX_PE / EUNLOCKFILEEX_PE /
# EGETFINALPATH_PE / ELASTERRNO_PE (x86/emit.cyr; stubs on the aarch64 and cx backends). Routed here,
# not in the inline chain, for cybs's per-function reference limit. CHANGELOG [6.7.12] [6.7.17]
fn _PE_ROUTE_FILELOCK(S, sc_num, argc): i64 {
    if (sc_num == 61516) { if (argc == 7) { ELOCKFILEEX_PE(S); return 1; } }
    if (sc_num == 61517) { if (argc == 6) { EUNLOCKFILEEX_PE(S); return 1; } }
    if (sc_num == 61518) { if (argc == 5) { EGETFINALPATH_PE(S); return 1; } }
    if (sc_num == 61519) { if (argc == 1) { ELASTERRNO_PE(S); return 1; } }
    return 0;
}
