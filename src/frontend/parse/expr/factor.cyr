# PARSER — expr: the factor tier's body, _PARSE_FACTOR_IMPL (PARSE_FACTOR, its depth entry, is in stamp.cyr).
# ================================================================
# Split from parse/expr.cyr at 6.7.18, unchanged; parse.cyr includes parse/expr/ in source order. CHANGELOG [6.7.18]

fn _PARSE_FACTOR_IMPL(S): i64 {
    var typ = PEEKT(S);
    SPSC(S, 0);
    SESTYPE(S, 0);
    SESVAR(S, 0 - 1);
    _esv_name = 0 - 1;
    SEXW(S, 0);
    _fbr_k = 0;   # 6.6.10: a new factor's value is not the last builtin's (see _FBR_MARK)
    # v6.4.83 — the RIGHT-operand half of the intrinsic-flanking fix. PARSE_TERM's
    # `* / % << >> >>>` loop parses its right operand with PARSE_FACTOR, one tier DOWN
    # from where the intrinsics were dispatched, so `a * f64_from(2)` was a syntax
    # error. Routing through the same shared PARSE_INTRIN the TERM tier uses means
    # there is exactly ONE list of intrinsic tokens, so the two tiers cannot drift
    # apart again. Placed AFTER the four state resets above so a dispatched intrinsic
    # starts from the same clean slate as any other factor.
    # `_cfo = 0`: an intrinsic result is never a const-foldable literal — see the
    # `_cfo` discipline note on PARSE_INTRIN.
    if (PARSE_INTRIN(S, typ) == 1) { _cfo = 0; return 0; }
    # Unary minus: -expr
    if (typ == 7) {
        STI(S, GTI(S) + 1);
        # Optimization: -NUM → emit negated constant
        if (PEEKT(S) == 1) {
            EMOVI(S, 0 - PEEKV(S));
            STI(S, GTI(S) + 1);
            return 0;
        }
        # General: parse factor, emit 0-rax via push/sub.
        # ⛔ A FLOAT operand (a float literal, an f64/f32-typed value) is negated by flipping
        # its SIGN BIT, never by integer `0 - bits`: that computed `-1.0` as -4.0, `-0.0` as
        # +0 and `-x` on an f64 likewise, on every target. The operand's type is known only
        # after it is parsed, so the integer prologue is shared and a float operand discards
        # its pushed 0 (EF64_NEG is exact for every value, -0.0 and NaN included). CHANGELOG [6.6.8]
        # A float-returning BUILTIN is recognised through the result flag (_FBR_ST), which also
        # reaches one inside parentheses (`-(f64_sqrt(v))` negated the integer until 6.6.10); the
        # negation re-marks it, so `-f64_sqrt(u) * 2.0` is still a float multiply. An untyped
        # variable that holds a float (kind 3) is negated as an integer and WARNS. CHANGELOG [6.6.10]
        EMOVI(S, 0);
        EPUSHR(S);
        PARSE_FACTOR(S);
        var _ngt = _FBR_ST(S);
        if (_ngt == F64_TYID) { EPOPC(S); EF64_NEG(S); _FBR_MARK(S, 1); _cfo = 0; return 0; }
        if (_ngt == F32_TYID) { _NEG_F32(S); _FBR_MARK(S, 2); _cfo = 0; return 0; }
        return _neg_int(S);
    }
    # Unary bitwise NOT: ~expr
    if (typ == 37) {
        STI(S, GTI(S) + 1);
        PARSE_FACTOR(S);
        return _bnot_int(S);
    }
    if (typ == 61) { var fval = PEEKV(S); STI(S, GTI(S) + 1); EMIT_FLOAT_LIT(S, fval); SESTYPE(S, F64_TYID); return 0; }
    # sizeof(Type) — compile-time constant (detected as IDENT "sizeof")
    # 6.6.11: the WHOLE name (_is_sizeof_word); a 6-byte prefix took `sizeofzz(..)` too.
    if (typ == 2) { if (_is_sizeof_word(S, PEEKV(S)) == 1) {
            STI(S, GTI(S) + 1);
            _expect_step(S, 10);
            var szval = 0;
            # 6.7.17: no type is read when the `(` is missing — reading one stepped the `;` / `}` the cursor stays on.
            if (TOKTYP(S, GTI(S) - 1) == 10) {
                if (PEEKT(S) == 105) {
                    # sizeof(u128) = 16
                    szval = 16;
                    STI(S, GTI(S) + 1);
                } else {
                    # 6.6.16 (C8): the one type-name resolver — a bound type parameter its argument's
                    # size, else the WHOLE name (u8..u64, f32, f64, bool, cstring, an enum, a vector, a
                    # struct), else refused by name. sizeof(f64) / sizeof(u8) did not compile. CHANGELOG [6.6.16]
                    # 6.7.7: _sizeof_type expects the name itself (and refuses a tuple type by name).
                    szval = _sizeof_type(S, 0);   # 6.6.17: + `<..>` (_sizeof_type)
                }
                _expect_step(S, 11);
            }
            EMOVI(S, szval);
            return 0;
        } }
    # mulh64(a, b) — high 64 bits of a 64×64 unsigned multiply
    # The WHOLE name (_is_mulh64_word): a 6-byte prefix compiled a user fn `mulh64x(..)` as
    # this intrinsic. CHANGELOG [6.6.11]  6.7.6: lowered in `_lower_mulh64` (the result's type).
    if (typ == 2) { if (_is_mulh64_word(S, PEEKV(S)) == 1) { _lower_mulh64(S); return 0; } }
    # v6.5.17 — fncall0..fncall8 lower to the SAME sequence as `callptr`, so a
    # capturing closure reaches the callee through them too.
    #
    # Why here and not in lib/fnptr.cyr: the closure needs its env as a TRAILING
    # argument, so `fncallN` would have to re-enter at `fncall(N+1)` — and cybs, the
    # bootstrap compiler that must parse lib/fnptr.cyr on the seed chain, could not
    # parse a call with more than 6 arguments (until 6.7.6). That capped the ladder at fncall4 and
    # would have left fncall5-7 silently broken, which is exactly the half-fix shape
    # this bug already went through once. Lowering here fixes every arity at once,
    # gives the stdlib's own higher-order fns (vec_sort_by, vec_each, hashmap
    # iteration — all `fncallN(cb, …)`) closure support for free, and inherits
    # ECALLPOPS/ECALLPTR_PE's marshalling, which is strictly better than the hand
    # asm for >4 args on Win64 and >6 on SysV.
    #
    # Gated on FINDFN so a program that never included lib/fnptr.cyr still gets its
    # "undefined function" diagnostic instead of silently compiling.
    # ⛔ 6.6.16 — and NOT on being inside a fn: this gate also read `_cur_fn_ix >= 0`, so a
    # top-level fncallN fell back to lib/fnptr.cyr, which calls a capturing closure's tagged
    # value (SIGSEGV; 0 for every callee on cx). PINDIRECT_CALL now brings a micro-frame to
    # top level (see its header), so the lowering is the same at every depth — the extern-C
    # driver in tests/gates/platform/ffi_stack_protected_extern_c.sh included. CHANGELOG [6.6.16]
    if (typ == 2) { if (_IS_FNCALL_NAME(S, PEEKV(S)) == 1) {
            if (TOKTYP(S, GTI(S) + 1) == 10) { if (FINDFN(S, PEEKV(S)) >= 0) {
                    # v6.5.46: the digit in the name IS the promised arity — the same
                    # byte `_IS_FNCALL_NAME` already validated as '0'..'8'.
                    _fncall_expect = ((L64(S + 0xEC00000 + PEEKV(S)) >> 48) & 0xFF) - 48;
                    STI(S, GTI(S) + 1);   # consume fncallN
                    STI(S, GTI(S) + 1);   # consume '('
                    PINDIRECT_CALL(S);
                    return 0;
                } }
        } }
    if (typ == 1) {
        var val = PEEKV(S);
        STI(S, GTI(S) + 1);
        _cfp = GCP(S);
        EMOVI(S, val);
        # Mark as foldable for small non-negative literals. Originally
        # guarded `val > 0` because EMOVI(S, 0) emits 2 B (`xor eax, eax`)
        # vs 5 B for val > 0, and we worried const-fold rewrites assumed
        # a fixed slot size. Rewrites actually use `SCP(_cfp); EMOVI(_, v)`
        # which truncates + re-emits, so the emitted size doesn't matter
        # — any const, including 0, folds safely. Dropping the 0 exclusion
        # unblocks `syscall(0, ...)` reroute dispatch on both Mach-O and PE
        # (v5.5.14 — stdlib `lib/io.cyr` uses literal 0 for SYS_READ).
        if (val >= 0) { if (val < 0x10000) { _cfv = val; _cfo = 1; } }
        return 0;
    }
    if (typ == 2) {
        # IDENT — variable load or function call
        var noff = PEEKV(S);
        STI(S, GTI(S) + 1);
        if (_cur_iself_sid > 0) { _iself_arith_check(S, noff); }   # 6.7.0 (A4)
        if (_call_field(S) == 1) { return 0; }   # 6.6.12: `f(..).field` / `f<T>(..).field`
        # v6.3.10 (explicit): `foo<i64>(x)` explicit type-arguments. Gated on the
        # monomorph flag AND a generic-fn callee AND the `foo<...>(` lookahead shape,
        # so `a < b`, chained comparisons, and calls to non-generic fns are never
        # misread (flag-off / non-generic → byte-identical default path). v6.3.10
        # bite-1 supports i64 type-args (the base IS the i64 instance → normal call);
        # non-i64 type-args (instantiate-once) land in a follow-on bite.
        # 6.7.17 (D7): under CYRIUS_MONOMORPH=0 too — refused there by name, the base call parsed (`_eta_arm`).
        if (PEEKT(S) == 19) { if (_eta_arm(S, noff) == 1) { return 0; } }
        # Check for function call
        if (PEEKT(S) == 10) {
            PARSE_FNCALL(S, noff);
            # v6.4.55: if the callee returns scalar f64 (sentinel -9), the double is in
            # xmm0 (SysV/Win64) — bring it back into rax (cyrius's f64-boxing register)
            # and tag the expr F64_TYID so a bare +,-,*,/,compare on the call result
            # dispatches to the f64 emitters, not integer ops. EMOVQ_A_X0 = `movq rax,
            # xmm0` on x86/PE/macho, a no-op on aarch64/cx (value already in x0/r0).
            _call_ret_marks(S, FINDFN(S, noff));   # 6.6.17: + a `*T` return's pointer scale
            _cfo = 0;
            return 0;
        }
        # Check for enum.variant or struct.field access.
        # v6.3.36: `..` (range) is NOT field access — a `.` immediately followed by
        # another `.` belongs to the enclosing `for i in start..end`. Skip the
        # field-access branch so the identifier falls through to the normal scalar
        # load below (leaving `..` for the range parser). Fixes `for i in IDENT..hi`.
        if (PEEKT(S) == 41 && TOKTYP(S, GTI(S) + 1) != 41) {
            # v6.4.24 (P1 fix): `Enum.VARIANT` ignores the base and loads VARIANT (a
            # global const) whenever the field name is ALSO a global var. But that
            # over-matches `struct_var.field` when `field` SHADOWS a global var name:
            # `bc.exit_code` silently loaded the global `exit_code` (=0) instead of the
            # Container field @+72 (the size-dependent silent-wrong-read — only bites
            # when the field name happens to also be a top-level var, so small repros
            # passed). The base of an enum-variant access is a bare ENUM TYPE NAME, never
            # a variable — so if the base IS a known local/global var, `.field` is a
            # FIELD access, full stop. Guard the enum-variant branch on that.
            var _base_is_var = 0;
            if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { _base_is_var = 1; } }
            if (_base_is_var == 0) { if (FINDVAR(S, noff) >= 0) { _base_is_var = 1; } }
            # Peek: is the second ident a known global var? (enum variant)
            var dot_ti = GTI(S);
            STI(S, GTI(S) + 1);
            if (_base_is_var == 0 && PEEKT(S) == 2) {
                # 6.6.11: the base must be the variant's own enum (_enum_qual_resolve).
                var vi = _enum_qual_resolve(S, dot_ti - 1);
                if (vi >= 0) {
                    # Enum.VARIANT — load the variant's global value.
                    # v5.5.2: if this gvar was registered by PARSE_ENUM_DEF
                    # as an enum constant (GVECP presence flag set; raw
                    # value in _vecv_base), fold to EMOVI and mark _cfo=1 so
                    # callers like the syscall sc_num dispatch can read
                    # the compile-time value. (6.6.8: at any var index —
                    # the old 1024-slot cap is gone, see util.cyr GVECP.)
                    STI(S, GTI(S) + 1);
                    if (vi >= 0) {
                        if (GVECP(S, vi) == 1) {
                            var _evq = L64(_vecv_base + vi * 8);
                            _cfp = GCP(S);
                            EMOVI(S, _evq);
                            if (_evq < 0x10000) { _cfv = _evq; _cfo = 1; }
                            else { _cfo = 0; }
                            return 0;
                        }
                    }
                    EVLOAD(S, vi);
                    _cfo = 0;
                    return 0;
                }
                if (_enum_qual_said(S, vi) == 1) { return 0; }   # 6.7.16: a member of no enum, reported
            }
            # Not an enum — rewind and do struct field load
            STI(S, dot_ti);
            PARSE_FIELD_LOAD(S, noff);
            _cfo = 0;
            return 0;
        }
        if (_arr_sub_read(S, noff) == 1) { return 0; }   # 6.6.12: `a[i]` (see _arr_sub_addr)
        # Variable load — check local first if in function
        SPSC(S, 0);
        if (_cst_read_local(S, noff) == 1) { return 0; }   # 6.7.2 (B1): a local const is its value
        if (GINFN(S) == 1) {
            var li = FINDLOCAL(S, noff);
            if (li >= 0) {
                if (_slice_sub_read(S, li) == 1) { return 0; }   # v5.8.15: `s[i]` on a slice local
                var lt = _load_lt(S, li);   # 6.6.17: a typed pointer's value is a plain word
                # v6.2.19 math arc: f64/f32 locals — load the 8-byte value and tag
                # the expression f64/f32 so PEXPR/PARSE_TERM route operators to the
                # f64 builtins (skip the SPSC pointer-scale + sub-word paths below).
                if (lt == F64_TYID) { SESTYPE(S, F64_TYID); EFLLOAD(S, li); return 0; }
                # v6.4.56 (scalar-float D2): f32 now has scalar arithmetic — load the
                # 8-byte value and propagate F32_TYID so PEXPR/PARSE_TERM route +,-,*,/
                # and comparisons to EMIT_F32_BINOP / EF32_CMP (single-precision).
                if (lt == F32_TYID) { EFLLOAD(S, li); SESTYPE(S, F32_TYID); return 0; }
                _lt_spsc(S, li, lt);   # SPSC(S, lt); 6.7.8: a step-8 `*T` local's step word
                # Width-correct load for scalar types (1=i8, 2=i16, 4=i32)
                # v6.3.34: a sub-i64 SCALAR local (SLTYPE 1/2/4 for i8/i16/i32) is NOT
                # a pointer — the SPSC(S, lt) above sets a step of lt, which would make
                # `a + 2` on a plain `var a: i32` add 2*sizeof(i32). Reset for lt < 8 ONLY:
                # SLTYPE 8 is a `*i64` typed pointer (scalar i64 is SLTYPE 0), which needs
                # its step for `p + i`. 6.7.11: reset to 0, an integer's — it was 1, which
                # scales nothing but answers "a pointer" to every `> 0` test, so `w - q32`
                # was refused as a pointer difference and `var r: *u32 = w;` did not warn,
                # where an i64 local, a narrow global and a narrow parameter are integers.
                # CHANGELOG [6.7.11]
                if (lt > 0) { if (lt <= 8) {
                        if (lt < 8) { SPSC(S, 0); }
                        SEXW(S, lt);
                        # v6.3.35: a SIGNED sub-i64 local (marked by a negative slice-width
                        # sentinel) loads via movsx (negative width); unsigned stays movzx.
                        var _lw = lt;
                        if (lt < 8) { if (GSLICE_W(S, li) < 0) { _lw = 0 - lt; } }
                        EFLLOAD_W(S, li, _lw);
                        return 0;
                    } }
                # ⛔ 6.6.5 — OPERATOR OVERLOADING WORKED FOR GLOBALS AND NOT FOR LOCALS, and the
                # difference was invisible: `var a: Num; a.v = 1; ... a + b` compiled clean and
                # did an INTEGER ADD of the two struct words, while the identical top-level
                # declaration dispatched `Num_add`. Measured 3 against 102 for the same source
                # moved inside a fn. Only an INLINE local dispatches — a pointer-mode one holds
                # an address, where `+` is pointer arithmetic (the global half of this rule is
                # a few lines below). A multi-word value is passed BY ADDRESS, matching what
                # `EMIT_OP_DISPATCH` already does for a >8 B global. CHANGELOG [6.6.5]
                if (lt < 0) { if (lt > 0 - 2048) { if (_op_local_dispatches(S, li) == 1) {
                            SESTYPE(S, 0 - lt);
                            if (AGG_NSLOTS(S, lt) > 1) { SESVAR(S, 0 - 2 - li); }
                            _esv_name = 0 - 2 - li;   # 6.6.20: see `_op_operand_sv`
                        } } }
                EFLLOAD(S, li);
                if (lt == 0) { _sl_load_marks(S, li); }   # 6.6.10 the float flag, 6.6.16 the *iN mark
                return 0;
            }
        }
        # v6.3.8 — captured free variable. Inside a capturing closure body, an
        # identifier that is NOT a closure local (FINDLOCAL failed above) but IS an
        # enclosing local reads from the heap env object — the hidden first param at
        # slot `_cl_env_lidx`, captured value at env[1 + capture_index].
        if (_cl_capturing == 1) {
            if (_cl_env_lidx >= 0) {
                var cl_esl = _cl_snap_find(S, noff);
                if (cl_esl >= 0) {
                    var cl_capi = _cl_cap_find(cl_esl);
                    if (cl_capi >= 0) {
                        _CL_CAP_OPTYPE(S, cl_esl, cl_capi);              # see the fn's note
                        _CL_CAP_WORDS_RA(S, cl_capi);                    # rax = &env[woff]
                        if (_cl_cap_w128(S, cl_esl) == 1) { return 0; }   # 6.7.14: a u128 is its value
                        # 6.6.5: a multi-word capture IS those words — its value is its
                        # address, the same convention an enclosing inline aggregate has in
                        # its own frame. A single-word capture is a value; load it.
                        if (L64(&_cl_cap_w + cl_capi * 8) > 1) {
                            if (_cl_snap_arr(cl_esl) == 1) { ELOAD64(S); return 0; }   # 6.7.17: its first word
                            SPSC(S, 1);
                            return 0;
                        }
                        _cl_cap_load(S, cl_esl);                         # rax = captured value (6.7.3: + a bool's mark)
                        return 0;
                    }
                }
            }
        }
        var idx = FINDVAR(S, noff);
        if (idx >= 0) { if (_cst_read_global(S, idx) == 1) { return 0; } }   # 6.7.2: an f64 / string const
        if (idx < 0) {
            if (_slit_stray(S, noff) == 1) { return 0; }   # 6.7.14 (D12 (a)): `P { .. }` here
            # v6.5.19: under --syntax-only an unresolved read becomes the constant 0
            # and we return exactly as the sibling success paths above do, so the
            # token stream stays in sync and no cascade is invented. See _syntax_only
            # (src/common/util.cyr) for why report-and-continue was rejected here.
            _undef_read(S, noff);   # 6.7.14: once per token (ERR_UNDEF); 6.7.16: `nofn<i64>(1)` is a call (`_ugc_call`)
            return 0;
        }
        var vt = GVTYPE(S, idx);
        _gv_load_ps(S, idx, vt);
        if (vt > 0) {
            # Disambiguate scalar types from struct IDs using var_sizes:
            # Scalar i8/i16/i32 have var_sizes 1/2/4. Structs have var_sizes >= 8.
            var gvsz = L64(_vars_base + idx * 8);
            if (gvsz < 8) {
                _gv_narrow_sx(S, idx, vt, gvsz);   # 6.7.10: a struct value under 8 B dispatches
                # v6.4.23: a SIGNED sub-i64 global (i8/i16/i32) loads via movsx —
                # pass a NEGATIVE width so EVLOAD_W's _EMIT_NLOAD_RCX (x86) / signed
                # arms (aarch64) sign-extend. Unsigned (uN) stays zero-extend. Mirrors
                # the local negative-width sentinel (the local load's `_lw` above).
                var _gw = gvsz;
                if (GVSGN(S, idx) == 1) { _gw = 0 - gvsz; }
                EVLOAD_W(S, idx, _gw);
                return 0;
            }
            # 6.6.5 — ONLY AN INLINE STRUCT VALUE DISPATCHES AN OPERATOR. A pointer-mode
            # struct global (`var s: Str = 0;`) holds an ADDRESS, so `s + 8` is pointer
            # arithmetic; setting the expression's struct type here sent it to a `Str_add`
            # that does not exist and failed the COMPILE. `_var_ptrmode` is the recorded
            # layout (1 = the slot holds an address). CHANGELOG [6.6.5]
            if (GVPM(S, idx) != 1) {
                SESTYPE(S, vt);
                if (gvsz > 8) { SESVAR(S, idx); }
                _esv_name = idx;   # 6.6.20: see `_op_operand_sv`
            }
        }
        # v5.5.2: bare identifier resolving to an enum constant folds to
        # EMOVI with _cfo=1 so the syscall-reroute dispatch (and any
        # other _cfv-driven optimization) can see the value at parse
        # time. Enum registration stores the raw value in _vecv_base and
        # sets the slot's GVECP presence flag; a flagged gvar is a fold
        # candidate. (6.6.8: at any var index — the 1024-slot cap is gone,
        # see util.cyr GVECP.)
        if (idx >= 0) {
            if (GVECP(S, idx) == 1) {
                var _ev = L64(_vecv_base + idx * 8);
                _cfp = GCP(S);
                EMOVI(S, _ev);
                if (_ev < 0x10000) { _cfv = _ev; _cfo = 1; }
                else { _cfo = 0; }
                return 0;
            }
        }
        EVLOAD(S, idx);
        if (vt == 0) { _UFV_G(S, idx); }   # 6.6.10: an untyped float variable (kind 3)
        return 0;
    }
    if (typ == 10) {
        if (_paren_field(S) == 1) { return 0; }   # 6.7.14 (D24 (a)): `(s).a`, `(mk1()).a`, `(s).m()`
        STI(S, GTI(S) + 1);
        PCMPE(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        var _pfk = _paren_pre(S);
        STI(S, GTI(S) + 1);
        _paren_post(S, _pfk);   # 6.6.10: `(builtin(..))` is still its result; 6.7.3 `(a < b)` a boolean
        _cfo = 0;
        return 0;
    }
    if (typ == 27) {
        # &var or &fn — address of variable or function
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 2) { _amp_not_name(S); return 0; }   # 6.7.15: one error, the factor ends there
        var anoff = PEEKV(S);
        STI(S, GTI(S) + 1);
        # 6.7.2 (B1): a const has no address; 6.7.3: nor has an enum constant (parse/fn.cyr).
        if (_addr_lvalue_refused(S, anoff) == 1) { EMOVI(S, 0); return 0; }
        # Resolution order is local → global → function: a VALUE of a
        # given name shadows a function of the same name (correct lexical
        # scoping). Pre-v6.0.35 this checked FINDFN *first*, so a local
        # array named `argv` (shadowing stdlib `fn argv`) had `&argv`
        # resolve to the function's __TEXT code address; the subsequent
        # store wrote into __TEXT — silently masked on Linux (the load
        # segment is RWX) but a hard SIGBUS on macOS (W^X). See
        # CHANGELOG [6.0.35].
        # Local (innermost scope) wins.
        if (GINFN(S) == 1) {
            var ali = FINDLOCAL(S, anoff);
            if (ali >= 0) {
                # ⛔ 6.6.6 (bite 16 review) — `&q` ON AN ADDRESS-PASSED BY-VALUE STRUCT PARAMETER
                # IS THE STRUCT, NOT THE SLOT. `q` in `fn h(q: P3)` denotes the caller's struct
                # (that is why `q.z` already reads the caller's field), but `&q` took the
                # rbp-relative address of the word that HOLDS the pointer: `load64(&q + 16)`
                # returned 0 on 6.6.5 and on the compiler 16b shipped, where the identical code
                # on an inline local returns 9. So `&q` and `q.z` addressed two different things.
                # The slot's CONTENT already IS the struct's address — load it. No `_fn_local_addr`
                # here, deliberately: this frame's address does NOT escape (the pointer is the
                # CALLER's), so a tail call in this fn stays legal. CHANGELOG [6.6.6]
                # 6.7.9: never for a `q: *P` parameter, whose `&q` is its slot (`_addr_is_slot_content`).
                if (_addr_is_slot_content(S, ali) == 1) { EFLLOAD(S, ali); SPSC(S, 1); return 0; }
                var adisp = 0 - ((ali + 1) * 8);
                # v4.9.1: shift past all reserved callee-saved slots
                if (_cur_fn_regalloc > 0) { adisp = adisp - _cur_fn_regalloc * 8; }
                if (_cur_fn_ret_stash > 0) { adisp = adisp - _cur_fn_ret_stash; }
                # v5.11.36 path-A: dispatch lives in
                # <backend>/emit.cyr::ELOAD_LOCAL_ADDR.
                # v6.5.14: this frame's address has now escaped into a value.
                # Any tail call in this fn would free the frame before the
                # callee dereferences it — disable TCO for the rest of the fn.
                _fn_local_addr = 1;
                ELOAD_LOCAL_ADDR(S, adisp);
                # v6.5.29 — `&x` IS a pointer, so say so. This branch never set a pointer
                # scale, so `var p: *i64 = &nodes;` — the canonical address-of idiom — tripped
                # `assigning non-pointer to typed pointer`, the compiler warning about the one
                # expression form that cannot possibly be a non-pointer.
                # ⚠ Scale 1 (BYTE-addressed), deliberately, not 8. Pointer arithmetic in this
                # tree is written in BYTES at the source level (`&nodes + i * 16`), and
                # EPTR_SCALE multiplies the addend by the scale — so any value above 1 would
                # silently re-scale every existing `&x + n` site and change what compiled code
                # DOES. Scale 1 multiplies by 1 and divides by 1: arithmetic-neutral by
                # construction, which is why the self-host stays byte-identical.
                SPSC(S, 1);
                return 0;
            }
        }
        # 6.6.5 — `&name` on a CAPTURED enclosing local. A closure could not take the address
        # of an enclosing stack array at all (`&buf` inside `|a| ... load64(&buf)` reported
        # "undefined variable 'buf'"), because this ladder went local → global → fn with no
        # rung for the env object. The captured words live at `env + woff*8`.
        if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) {
                var acap_esl = _cl_snap_find(S, anoff);
                if (acap_esl >= 0) {
                    var acap_i = _cl_cap_find(acap_esl);
                    if (acap_i >= 0) {
                        _CL_CAP_WORDS_RA(S, acap_i);
                        SPSC(S, 1);
                        return 0;
                    }
                }
            } }
        # Global next.
        var aidx = FINDVAR(S, anoff);
        if (aidx >= 0) {
            EVADDR(S, aidx);
            SPSC(S, 1);   # v6.5.29 — see the note above: `&global` is a pointer too.
            return 0;
        }
        # Neither a local nor a global of this name → function pointer
        # (&fn_name), emitted as a fixup-type-3 function address.
        var fni = FINDFN(S, anoff);
        if (fni >= 0) {
            if (_amp_targs(S, fni) == 1) { return 0; }   # 6.7.17: `&g<i32>` refused by name, `&nf<i32>` stepped
            # v6.6.4: `&fn` is its own resolution path — a private fn was reachable from any
            # file by taking its address and calling through callptr/fncallN (hisab 2026-09-13).
            _callee_site_checks_here(S, fni, anoff, 1);   # 6.6.16: and `#deprecated` — `&old_f` was silent
            _gen_addr_check(S, fni, anoff);   # 6.6.10: `&g` of a stub generic reaches the stub
            var fc = GFCNT(S);
            if (fc >= 1048576) {
                _ew("error: fixup table full (1048576)\n", 34);
                _die(1);
            }
            # Register the function-address fixup (common to both
            # backends — only the placeholder bytes differ).
            var fnaddr = _fixup_base + fc * 16;
            # v5.11.36 path-A: parser-to-emit named-op refactor.
            # Dispatch + fixup record + SFCNT all live in
            # <backend>/emit.cyr::ELOAD_FN_ADDR.
            _lfa_load(S, fnaddr, fc, fni);   # 6.7.6 (FE): ELOAD_FN_ADDR, recording `f` for fncallN
            return 0;
        }
        # Nothing of this name exists in any scope.
        if (_syntax_only == 1) { if (_unp_names == 0) { EMOVI(S, 0); return 0; } }   # v6.5.19: see _syntax_only; 6.7.17 (D110)
        _undef_var_report(S, _nm_ti(S, GTI(S) - 1, anoff), anoff, "");   # 6.7.14: once per token (ERR_UNDEF)
        EMOVI(S, 0); return 0;
    }
    if (typ == 30) {
        # STRING literal
        var sval = PEEKV(S);
        STI(S, GTI(S) + 1);
        var soff = sval >> 32;
        ESADDR(S, soff);
        return 0;
    }
    # v6.6.2: callptr 111 -> 137 (was double-assigned with `stack`).
    if (typ == 137) {
        # callptr(callee, arg1, ..., argN) — v6.0.70 §0 indirect call.
        STI(S, GTI(S) + 1);                     # consume 'callptr'
        _expect_step(S, 10);                    # '(' (6.7.17: a missing one never steps a `;`)
        PINDIRECT_CALL(S);
        return 0;
    }
    # 6.7.17 — every builtin's and identifier intrinsic's `(`, `,` and `)` is `_expect_step`: a missing one is reported
    # and never steps a recovery point (6.7.14 did the `)` of most). The arms stepped the next token whatever it was, so
    # a malformed call at a block's end took the block's `;` and `}`: `var y = load8;` then `}` and `fn g` said "fn 'g'
    # is defined inside fn 'main'" and "expected '}', got end of file" (`store8(p;`, `syscall;`, `f64_sqrt;` .. the same),
    # and g's own error was never reported. CHANGELOG [6.7.17]
    if (typ == 24) {
        # syscall(args...)
        STI(S, GTI(S) + 1);
        _expect_step(S, 10);
        var argc = 0;
        var sc_num = 0 - 1;
        var scgo = 1;
        while (scgo == 1) {
            PCMPE(S);
            if (argc == 0) { if (_cfo == 1) { sc_num = _cfv; } }
            EPUSHR(S);
            argc = argc + 1;
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
            else { scgo = 0; }
        }
        _expect_step(S, 11);   # 6.7.14: a miss keeps a `;` / keyword (and see `_sc_arity_warn`)
        # Mach-O ARM target: the aarch64 ESYSXLAT chain translates the
        # BSD SVC whitelist (read, write, open, close, mmap, mprotect,
        # munmap, exit). Non-whitelisted syscalls fall through to svc with
        # a Linux number, which is either nonexistent on XNU or carries
        # different semantics — a real runtime hazard. v5.5.15 demoted
        # this from a hard parse-time error to a warning because the old
        # error rejected syscalls inside UNCALLED stdlib helpers (e.g.
        # `lib/io.cyr`'s `syscall(73)` flock wrappers) and blocked
        # cross-compiling Cyrius tool binaries whose hot paths only touch
        # the whitelist. If the warned syscall is actually reachable at
        # runtime, the resulting binary faults visibly on macOS — which
        # is a strictly better failure mode than a compile-time refusal
        # to build something that would have worked. v5.5.17 pins the
        # follow-up that adds ESYSXLAT translations or `__got` reroutes
        # for specific syscalls the tools actually exercise.
        # v6.5.43 put the x86 Mach-O half beside it; v6.6.8 made both ARITY-aware and moved them
        # into _macho_warn_unrouted (below _PE_ROUTE_PERFCOUNTER) so this fn does not grow; 6.7.10
        # wraps it with the execution-coverage exit hook (parse/cov.cyr `_sc_args_done`).
        _sc_args_done(S, sc_num, argc);
        # v6.5.51 — ELF-aarch64: a raw syscall NUMBER that is really an x86_64 number.
        # ESYSXLAT's aarch64 arm passes unmatched numbers through to the `svc` verbatim,
        # which is correct by design (native numbers must not be rewritten) — but it means
        # a stray x86_64 number is indistinguishable from an intended native one, so the
        # build succeeds and a DIFFERENT, VALID syscall runs. Filed from darshana; the
        # `var SYS_* = <x86 number>` shadow half was diagnosed at v6.5.50.
        #
        # ⛔ THIS NEEDS REAL DATA, NOT A HEURISTIC. "warn if the number is not a valid
        # SYS_* value here" catches 61 of the 71 differing syscalls and misses the 10 that
        # matter most, because those x86 numbers ARE real aarch64 syscalls: uname 63 is
        # read, kill 62 is lseek, execve 59 is pipe2, wait4 61 is getdents64. The table is
        # DERIVED (src/common/syscall_xlat.cyr, generated by programs/gen_syscall_xlat.cyr):
        # which numbers warn comes from the two stdlib peers, so it cannot drift from the
        # stdlib it describes, and what each number MEANS on ARM comes from the committed
        # kernel table, because the peer cannot name calls the stdlib has no wrapper for.
        #
        # Gated implicitly, not by a target flag: `_SYSX_MEANT` is the real table only on
        # the aarch64 backend and a `return 0;` stub on x86/PE/cx, so this costs those
        # forks nothing. `_TARGET_MACHO == 0` keeps it off the Mach-O ARM arm, which has
        # its own routing diagnostic above.
        if (_TARGET_MACHO == 0) { _sysx_raw_warn(S, sc_num); }
        # PE32+ (Windows): reroute recognised Linux syscall numbers to
        # kernel32 IAT calls so the generic `ESCPOPS` path below
        # (which would emit the x86_64 `syscall` instruction, 0F 05,
        # a Linux-only encoding) is bypassed. Mappings:
        #   syscall(0, fd, buf, len)       → GetStdHandle+ReadFile   (v5.5.1)
        #   syscall(1, fd, buf, len)       → GetStdHandle+WriteFile  (v5.4.7)
        #   syscall(2, path, flags, mode)  → CreateFileW             (v5.5.1)
        #   syscall(3, fd)                 → CloseHandle             (v5.5.1)
        #   syscall(8, fd, off, whence)    → SetFilePointerEx        (v5.5.1)
        #   syscall(9, addr, len, ...)     → VirtualAlloc            (v5.5.1)
        #   syscall(11, addr, len)         → VirtualFree(MEM_RELEASE) (6.6.20,
        #                                    via _PE_ROUTE_FLUSH — no inline arm)
        #   syscall(60, code)              → ExitProcess             (v5.4.4)
        # Other syscall numbers still fall through with a warning and
        # produce a non-functional binary; wrap them in syscalls_windows.cyr
        # shape helpers as they're needed.
        # Mach-O arm64 __got reroutes — syscalls whose libSystem equivalents
        # are bound into __DATA_CONST.__got[N] in EMITMACHO_ARM64 get short-
        # circuited here instead of falling through to ESYSXLAT+svc (which
        # needs BSD-number translation and has lingering edge cases). Slot
        # indices must match the symbol order in macho/emit_arm64.cyr's symtab +
        # bind opcodes + indirect symtab. Mirror of the PE syscall-reroute
        # block below (v5.4.4/5.4.7/5.5.1/5.5.2 bundle).
        #   syscall(0, fd, buf, len) → __got[2] = libSystem._read   (v5.5.14)
        #   syscall(1, fd, buf, len) → __got[1] = libSystem._write  (v5.5.14)
        #   syscall(60, code)        → __got[0] = libSystem._exit   (v5.5.13)
        if (_TARGET_MACHO == 2) {
            # v6.5.44 (band J phase 2): syscall(1700, &tid, attr, &start, arg) → __got[5]
            # libSystem `pthread_create`. This is the arm64-macOS thread primitive, and it is
            # here rather than in ESYSXLAT because pthread_create is NOT A SYSCALL — the
            # ≥1000 alias band so far has meant "1000 + the native BSD number", which cannot
            # spell a libSystem routine. 1700+ is therefore a distinct sub-band meaning
            # "__got-bound libSystem function"; do not read 1700 as BSD 700.
            # ⛔ bsdthread_create is NOT usable here even though v6.5.43 routed it:
            # bsdthread_register is one-shot per process and libpthread takes it first in any
            # binary linking libSystem, which every cyrius arm64 Mach-O does. Measured EINVAL
            # on real ecb. The v6.5.43 routes remain correct and are what x86-macOS (a static
            # no-libSystem binary, where registration DOES work) will use.
            if (sc_num == 1700) {
                if (argc == 5) {
                    EMACHO_PTHREAD_CREATE_ARM(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # 1701 = libSystem fork (__got[7]), the second routine in the 1700+ sub-band.
            # 6.6.13: syscall(1701) → libSystem `fork()` (errno via __got[8] ___error), so the
            # child gets libSystem's own fork handling. The raw BSD fork the clone row still
            # translates to skips it, and the child's first pthread_create then SIGSEGVs. See
            # EMACHO_FORK_ARM (src/backend/aarch64/emit.cyr). CHANGELOG [6.6.13]
            if (sc_num == 1701) {
                if (argc == 1) {
                    EMACHO_FORK_ARM(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 60) {
                if (argc == 2) {
                    EMACHO_EXIT_ARM(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 1) {
                if (argc == 4) {
                    EMACHO_WRITE_ARM(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 0) {
                if (argc == 4) {
                    EMACHO_READ_ARM(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v5.6.6: syscall(228, clock_id, _) → _clock_gettime_nsec_np
            # for CYRIUS_PROF profiling. Returns u64 ns in x0 (no
            # timespec buffer — macOS gives ns directly).
            if (sc_num == 228) {
                if (argc == 3) {
                    EMACHO_CLOCK_ARM(S);
                    _cfo = 0;
                    return 0;
                }
            }
        }
        # v6.5.16: the x86-macOS twin of the 228 reroute above. Darwin has NO
        # clock_gettime syscall on either architecture, so this cannot be an
        # EMACHO_SYSXLAT row; arm64 binds libSystem through __got, and the x86
        # Mach-O writer has no __got, so it composes ns from gettimeofday instead.
        # Same contract either way: ns in the return register. See EMACHO_CLOCK_X86
        # (src/backend/x86/emit.cyr). Without this, syscall(228) fell through to
        # ESCPOPS + an unrouted number and SIGSYS'd — five of ach's twelve failures.
        if (_TARGET_MACHO == 1) {
            if (sc_num == 228) {
                if (argc == 3) {
                    EMACHO_CLOCK_X86(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.5.16: nanosleep(35) → poll(NULL, 0, ms). Darwin has no nanosleep
            # either; the PE fork has rerouted this to Sleep() since v6.1.17 and
            # x86-macOS never got the twin, so the number reached Darwin unclassed
            # and SIGSYS'd (lib/sakshi.cyr's TSC calibration window — sakshi_full
            # on ach). See EMACHO_NANOSLEEP_X86.
            if (sc_num == 35) {
                if (argc == 3) {
                    EMACHO_NANOSLEEP_X86(S);
                    _cfo = 0;
                    return 0;
                }
            }
        }
        if (_TARGET_PE == 1) {
            if (sc_num == 60) {
                if (argc == 2) {
                    # Stack top-down: [exit_code] [syscall_nr=60]
                    EPOPR(S);                    # pop rax = exit code
                    # v5.11.35 path-A: discard syscall_nr via named op.
                    EDROPI64(S);
                    EEXIT(S);                    # emits Win64 ExitProcess call
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 1) {
                if (argc == 4) {
                    # EWRITE_PE consumes [len][buf][fd][sc_nr=1] from
                    # the stack and emits the GetStdHandle+WriteFile
                    # sequence. Registers GetStdHandle + WriteFile as
                    # pending IAT imports on first use.
                    EWRITE_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 0) {
                if (argc == 4) {
                    # syscall(0, fd, buf, len) → GetStdHandle + ReadFile.
                    EREAD_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 2) {
                if (argc == 4) {
                    # syscall(2, path, flags, mode) → CreateFileW.
                    EOPEN_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 3) {
                if (argc == 2) {
                    # syscall(3, fd) → CloseHandle.
                    ECLOSE_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 8) {
                if (argc == 4) {
                    # syscall(8, fd, offset, whence) → SetFilePointerEx.
                    ELSEEK_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 9) {
                if (argc == 7) {
                    # syscall(9, addr, len, prot, flags, fd, offset) → VirtualAlloc.
                    EMMAP_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v5.6.6: syscall(228, _, _) → GetTickCount64 for CYRIUS_PROF.
            # 3-arg form chosen to match the Linux `syscall(228,
            # CLOCK_MONOTONIC, &ts)` shape in _prof_clock_ns; the 2
            # cyrius-side args are dropped by EGETTICKS_PE before the
            # kernel32 call.
            if (sc_num == 228) {
                if (argc == 3) {
                    EGETTICKS_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.1.17: syscall(35, &req, &rem) → Sleep(req ms). nanosleep —
            # completes the v6.1.16 PE var-dispatch (35 was the routable-arity
            # gap). ENANOSLEEP_PE reads the timespec and converts to flat ms.
            if (sc_num == 35) {
                if (argc == 3) {
                    ENANOSLEEP_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v5.11.22: SYS_MKDIR (83) → CreateDirectoryW;
            # SYS_UNLINK (87) → DeleteFileW. ai-hwaccel 2.2.2
            # surfaced both via cache.cyr.
            if (sc_num == 83) {
                if (argc == 3) {
                    ECREATEDIR_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 87) {
                if (argc == 2) {
                    EDELETEF_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.0.51: PE-internal Win32 process-creation reroutes (the
            # ai-hwaccel spawn arc). 0xF00N is an out-of-band block (Linux
            # syscalls top out ~450) reserved for kernel32 calls whose arity
            # exceeds the syscall(n, ≤6) form — process_win.cyr drives them
            # via named consts (WIN_SYS_*). See lib/process_win.cyr + the
            # EWIN*_PE emit fns in backend/x86/emit.cyr.
            if (sc_num == 61441) {
                if (argc == 3) {
                    # syscall(0xF001, handle, timeout) → WaitForSingleObject.
                    EWAIT_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61442) {
                if (argc == 3) {
                    # syscall(0xF002, handle, &code) → GetExitCodeProcess.
                    EGETEXIT_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61443) {
                if (argc == 4) {
                    # syscall(0xF003, handle, mask, flags) → SetHandleInformation.
                    ESETHANDLE_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61444) {
                if (argc == 5) {
                    # syscall(0xF004, &rd, &wr, &sa, size) → CreatePipe.
                    ECREATEPIPE_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61445) {
                if (argc == 2) {
                    # syscall(0xF005, &args) → CreateProcessW (10 args from *args).
                    ECREATEPROC_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.0.54: GetCommandLineW for the Windows args.cyr branch
            # (lib/args_win.cyr) + cycc's own command-line flags. 0 args,
            # returns the UTF-16LE command-line LPWSTR in rax.
            if (sc_num == 61446) {
                if (argc == 1) {
                    # syscall(0xF006) → GetCommandLineW (no args, LPWSTR in rax).
                    EGETCMDLINE_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.0.61: real Windows threading reroutes (lib/thread_win.cyr) —
            # CreateThread + SRWLOCK mutexes (join reuses 0xF001/WaitForSingleObject
            # + syscall(3)/CloseHandle). See thread + nuances issues.
            if (sc_num == 61447) {
                if (argc == 2) {
                    # syscall(0xF007, &args6) → CreateThread (6 args via struct).
                    ECREATETHREAD_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61448) {
                if (argc == 2) {
                    # syscall(0xF008, &lock) → InitializeSRWLock.
                    EINITSRW_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61449) {
                if (argc == 2) {
                    # syscall(0xF009, &lock) → AcquireSRWLockExclusive.
                    EACQSRW_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61450) {
                if (argc == 2) {
                    # syscall(0xF00A, &lock) → ReleaseSRWLockExclusive.
                    ERELSRW_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.0.61: thread-local storage reroutes (lib/thread_local.cyr) —
            # per-thread slot block keyed off one TlsAlloc'd index + gettid.
            if (sc_num == 61451) {
                if (argc == 1) {
                    # syscall(0xF00B) → GetCurrentThreadId (no args, DWORD in rax).
                    EGETCURTID_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.3.44: syscall(0xF01C) → GetCurrentProcessId (no args, DWORD in rax).
            # Backs getpid() on Windows (lib/process_win.cyr; was a 0-stub).
            if (sc_num == 61468) {
                if (argc == 1) {
                    EGETCURPID_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.4.26: syscall(0xF01D, hProcess, uExitCode) → TerminateProcess
            # (2-arg, argc==3). The Windows timeout-kill primitive (thoth). See
            # 2026-07-08-windows-pe-surface-no-terminateprocess.md.
            if (sc_num == 61469) {
                if (argc == 3) {
                    ETERMINATE_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.4.43: syscall(0xF01E, wVersionRequested, lpWSAData) → ws2_32!WSAStartup
            # (2-arg, argc==3). Winsock init for the async IOCP backend. See
            # 2026-07-08-async-epoll-only-blocks-win-transport.md.
            if (sc_num == 61470) {
                if (argc == 3) {
                    EWSASTARTUP_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            # v6.4.43: IOCP core (kernel32) — the async reactor's completion engine.
            # 0xF01F CreateIoCompletionPort (4-arg → argc 5); 0xF020
            # GetQueuedCompletionStatus (5-arg → argc 6); 0xF021
            # PostQueuedCompletionStatus (4-arg → argc 5).
            if (sc_num == 61471) {
                if (argc == 5) {
                    ECREATEIOCP_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61472) {
                if (argc == 6) {
                    EGETQCS_PE(S);
                    _cfo = 0;
                    return 0;
                }
            }
            if (sc_num == 61473) {
                if (argc == 5) {
                    EPOSTQCS_PE(S);
                    _cfo = 0;
                    return 0;
