        # is skipped (it would byte-scan + corrupt the inline closure code). This
        # global is NOT in the save/reset set below, so it persists past the
        # closure to the enclosing fn's PARSE_FN_DEF end.
        _cur_fn_has_closure = 1;
        STI(S, GTI(S) + 1);  # consume `|` (or the whole `||` for a zero-param closure)
        # Generate a UNIQUE anonymous name __clNNNNN (5 zero-padded decimal digits
        # of the fn count). The old `__cl<clid%10>` was single-digit, so the 11th
        # closure reused __cl0 and REGFN silently MERGED it with the first.
        NPOS_GUARD(S, 16);
        var clid = GFNC(S);
        var clnoff = GNPOS(S);
        var cwp = clnoff;
        store8(S + 0xEC00000 + cwp, 95); cwp = cwp + 1;    # _
        store8(S + 0xEC00000 + cwp, 95); cwp = cwp + 1;    # _
        store8(S + 0xEC00000 + cwp, 99); cwp = cwp + 1;    # c
        store8(S + 0xEC00000 + cwp, 108); cwp = cwp + 1;   # l
        store8(S + 0xEC00000 + cwp, 48 + (clid / 10000) % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 48 + (clid / 1000) % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 48 + (clid / 100) % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 48 + (clid / 10) % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 48 + clid % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 0); cwp = cwp + 1;
        SNPOS(S, cwp);
        # Register the closure function
        var clfi = REGFN(S, clnoff);
        # Snapshot the enclosing local tables before the closure overwrites slot 0+.
        var cl_saved_flc = GFLC(S);
        var cl_locsnap = _cl_save_locals(S, cl_saved_flc);
        var cl_saved_fs_floor = _fs_floor;   # 6.6.5: the closure body's fn-static mark
        _fs_floor = _fs_n;
        # ⭐ 6.6.7 — the closure is its OWN fn: snapshot EVERY per-fn global and enter a fresh
        # fn (parse/state.cyr `_fnst_save`). This used to be a hand-kept list that had drifted — it
        # saved rp_vec by LENGTH then truncated it to 0 (an early `return` before the closure
        # lost its patch and fell through), and it never isolated the defer table (a closure's
        # `defer` zeroed an ENCLOSING slot and ran, if at all, from the enclosing epilogue). The
        # v6.3.7 regalloc leak (`|a,b| a+b` reading an unloaded rbx) was the same family.
        var cl_st = _fnst_save(S);
        _cur_fn_ix = clfi;
        # v6.3.8 — save capture state and run the free-var pre-scan BEFORE the
        # prologue/params, so the env-param decision is made in one pass. The
        # cursor is at the first param (the opening `|` was consumed above); the
        # pre-scan seeds the shadow set with params, collects captured enclosing
        # slots, and restores the cursor.
        # 6.6.17: the whole enclosing capture context, and a snapshot that also lists the
        # enclosing closure's captures (`_cl_ctx_enter`).
        var cl_ctx = _cl_ctx_enter(S, cl_locsnap, cl_saved_flc, cl_st);
        _cl_prescan_captures(S, cl_zero);
        var cl_cap_shift = 0;
        if (_cl_capturing == 1) { cl_cap_shift = 1; }
        # Emit function prologue
        var cl_jmp = EJMP0(S);
        S64(_fnt_offsets + clfi * 8, GCP(S));
        EFNPRO(S);
        # v6.3.8 — a capturing closure takes the heap env object as a HIDDEN param;
        # captured-var reads in the body load from its slot (see PARSE_FACTOR).
        # v6.5.17 — that param moved from FIRST to LAST. The frame slot is still
        # allocated here (the body needs `_cl_env_lidx` while parsing), but the
        # arg-register store is emitted after the user params, once `clpc` is known.
        # Why last: the call site cannot know at compile time whether a callee is a
        # closure, so it always passes the env — and only a TRAILING extra argument
        # is invisible to a callee that does not want it. Leading it would shift
        # every user argument of every non-closure indirect call.
        _cl_env_lidx = 0 - 1;
        var cl_env_slot = 0 - 1;
        if (_cl_capturing == 1) {
            cl_env_slot = _cl_param_slot(S, 0 - 1);   # 6.7.16: its type words reset too (parse/fn.cyr)
            SFLC(S, cl_env_slot + 1);
            _cl_env_lidx = cl_env_slot;
        }
        # Parse params until | (a zero-param `||` closure has no param list)
        # ⚠ The pair scans (parse/pair_scan.cyr `_tok_is_closure_body`) recognise a closure BODY as a `{`
        # immediately preceded by the closing `|` or by `||`. Typed params or a return annotation
        # between the bars and the body would break that predicate — move it with the grammar.
        # v6.5.46: remember the first param's local index — the deferred stack-param pass
        # below needs it, and inside the loop `cpli` is re-read each iteration.
        var cl_p0 = GFLC(S);
        var clpc = 0;
        if (cl_zero == 0 && PEEKT(S) != 35) {
            var cpgo = 1;
            while (cpgo == 1) {
                if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
                var cpnoff = PEEKV(S);
                _RSV_INTRINSIC_DECL(S, cpnoff, GTI(S), 0);   # 6.6.20: a closure param `|sizeof|`
                STI(S, GTI(S) + 1);
                _cl_param_tail(S);   # 6.7.7 (B6): D18, a default; 6.7.14: a type (parse/fn.cyr)
                var cpli = _cl_param_slot(S, cpnoff);   # 6.7.16: an untyped slot, whatever an earlier fn left
                if (clpc < 6) { ESTOREPARM(S, clpc, cpli, 0); }
                SFLC(S, cpli + 1);
                clpc = clpc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { cpgo = 0; }
            }
        }
        # v6.5.17 — the hidden env param lands in arg register `clpc`, i.e. one past
        # the user params, matching the call site's trailing push. Emitting it here
        # (rather than at slot-allocation time) is safe: every ESTOREPARM is an
        # independent arg-register → frame-slot store, so their order is free.
        # The env must land in an argument REGISTER — see the matching note in
        # PINDIRECT_CALL: under SysV an extra STACK argument would slide the stack
        # arguments of every ordinary callee, so the call site only appends the env
        # below the register ceiling. A capturing closure with more parameters than
        # that is rejected HERE, loudly, instead of receiving a garbage environment.
        # This is not a new restriction: with the env as the hidden FIRST argument
        # (v6.3.8 - v6.5.16) the user params occupied registers 1..5 and the
        # `clpc + cl_cap_shift < 6` guard dropped anything beyond, silently.
        if (_cl_capturing == 1) {
            if (clpc >= _ARG_REG_COUNT()) {
                ERR_MSG(S, "capturing closure has too many parameters — its captured environment needs one more argument register than this target has", 124);
            }
            ESTOREPARM(S, clpc, cl_env_slot, clpc + 1);
        }
        # ⛔ v6.5.46 — DEFERRED STACK-PARAM PASS. Without it a NON-capturing closure silently
        # dropped every parameter past the 6th: the in-loop `clpc < 6` guard is correct (the
        # overflow cannot be homed until the TOTAL count is known, because SysV's stack slot is
        # `16 + (pc - 6 - 1 - (pidx - 6)) * 8` — it counts DOWN from the total), but nothing ever
        # ran the second pass that `PARSE_FN` has had all along (src/frontend/parse/fn.cyr, since
        # 6.6.6 `_stkp_flush`). So the 7th+ parameter was never stored and the body read an
        # uninitialised frame slot. (A closure's params are all untyped int-class, one slot each,
        # with no retptr, so `cl_p0 + cspi` / `clpc` below ARE the slot and the total — the
        # re-derivation 6.6.6 removed from PARSE_FN_DEF's pass cannot drift here.)
        # ⚠ IT DID NOT FAIL RELIABLY, which is why it survived: measured at v6.5.46, a 7-param
        # closure returned the RIGHT answer — the argument register still happened to hold the
        # value — while an 8-param one returned garbage. An intermittent wrong answer reads as
        # "closures are fine" until someone adds one more parameter.
        # ⚠ NON-CAPTURING ONLY, and that is not an omission: a CAPTURING closure needs its env in
        # an argument register (see the note above), so it already refuses `clpc >= _ARG_REG_COUNT()`
        # LOUDLY. This pass is what the non-capturing case never had.
        # ⚠ The first attempt at this fix simply deleted the in-loop guard. That is WRONG — it
        # calls ESTOREPARM with pc = 0, so `nstack = -6` and the displacement is garbage. The
        # count has to be known first, which is the whole reason the pass is deferred.
        if (_cl_capturing == 0) {
            if (clpc > 6) {
                var cspi = 6;
                while (cspi < clpc) {
                    ESTOREPARM(S, cspi, cl_p0 + cspi, clpc);
                    cspi = cspi + 1;
                }
            }
        }
        S64(_fnt_params + clfi * 8, clpc + cl_cap_shift);
        # A `||` zero-param closure already consumed both bars as one token 54;
        # only the `|params|` form has a separate closing bar to consume.
        if (cl_zero == 0) {
            if (PEEKT(S) != 35) { ERR_EXPECT(S, 35); }
            STI(S, GTI(S) + 1);  # consume closing |
        }
        # v6.2.41 dropped ESUBRSP's 2nd arg and claimed the frame "is patched
        # later via EPATCHFRAME" — but the closure path NEVER called EPATCHFRAME
        # (closures were untested), so `sub rsp, imm32` kept its 0 placeholder. The
        # closure then ran on a 0-byte frame: the first push in the body wrote at
        # [rsp-8] == [rbp-8], clobbering param slot 0, so `|x| x` returned garbage.
        # v6.3.7 — capture the patch handle and patch the real frame size below
        # (mirrors PARSE_FN_DEF's prologue ESUBRSP → EPATCHFRAME).
        var cl_frame_patch = _cl_frame_open(S, clfi);   # 6.7.10 (P5-B): ESUBRSP, then the coverage hit
        # 6.6.7 — defer-flag init jmp, resolved at the closure's end exactly as PARSE_FN_DEF does.
        var cl_dij = EJMP0(S);
        var cl_bcp = GCP(S);
        # Parse body: { stmts } or single expression
        if (PEEKT(S) == 13) {
            STI(S, GTI(S) + 1);
            _cur_fn_has_defer = _body_has_defer(S);   # 6.6.7: as PARSE_FN_DEF (0 from the snapshot otherwise)
            PARSE_PROG(S);
            if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
            STI(S, GTI(S) + 1);
        } else {
            var cl_vb = _vop_clb;
            _vop_clb = GTI(S);   # 6.7.16 (D101): the expression body is the closure's return value
            PCMPE(S);
            _vop_clb = cl_vb;
        }
        # Defer init, return landing, defer walk, epilogue — the same shared epilogue as
        # PARSE_FN_DEF, over the closure's own ranges. CHANGELOG [6.6.7]
        _defer_emit_init(S, cl_dij, cl_bcp);
        _tcp_resolve(S);   # 6.7.3: as PARSE_FN_DEF
        _rp_patch_here(S);
        _defer_emit_walk(S);
        EFNEPI(S);
        # v6.3.7 — patch the closure frame size now that GFLC is final (param +
        # body local count) and the high-water is known: `_cl_frame_bytes`.
        var cl_fsz = _cl_frame_bytes(S);
        EPATCHFRAME(S, cl_frame_patch, cl_fsz);
        EPATCH(S, cl_jmp);
        # Restore state
        _fs_popto(S, _fs_floor);             # 6.6.5: close the closure body's fn-statics
        _fs_floor = cl_saved_fs_floor;
        _fnst_restore(S, cl_st);             # 6.6.7: every enclosing per-fn global
        # Restore the enclosing fn's local tables clobbered by the closure's slots.
        _cl_restore_locals(S, cl_locsnap, cl_saved_flc);
        # v6.3.8 — restore capture state so the enclosing context resolves
        # identifiers normally again (and nested closures see their own state).
        # 6.6.17: this closure's capture list is kept aside for its env, below.
        var cl_inner = _cl_ctx_save();
        _cl_ctx_restore(cl_ctx);
        if (cl_cap_shift == 1) {
            # v6.3.8 — CAPTURING closure: build the heap env object (the closure
            # value) — a (1+ncap)-word block with the fn pointer at [0] and the
            # captured-by-value locals at [1..]. The object pointer is left in rax.
            # Requires lib/alloc.cyr. (Dispatched via callptr: load64(obj) → fn,
            # obj passed as the hidden first arg — see the callptr handler.)
            var cl_alloc_fi = _FINDFN_CSTR(S, "alloc", 5);
            if (cl_alloc_fi < 0) {
                ERR_MSG(S, "a capturing closure needs include \"lib/alloc.cyr\" for its heap env", 66);
                # v6.6.4: ERR_MSG reports and CONTINUES (the v6.4.62 multi-error contract),
                # so falling through handed -1 to ECALLFIX — a SIGSEGV on cx after a correct
                # diagnostic. The compile is already failed; there is nothing to emit.
                return 0;
            }
            EMOVI(S, _cl_env_bytes(cl_inner));   # rax = size (6.6.5: words, not captures)
            EPUSHR(S);
            ECALLPOPS(S, 1);                 # → rdi
            ECALLFIX(S, cl_alloc_fi);        # rax = obj
            ECALLCLEAN(S, 1);                # 6.6.5: was missing (see ECALLCLEAN)
            var cl_obj_slot = GFLC(S);
            # Anonymous scratch — the name table isn't cleared per-fn, so an unnamed
            # slot would keep a STALE name from a prior fn and a later `var` with that
            # name would falsely trip the duplicate-var check.
            S64(S + 0x5D9D000 + cl_obj_slot * 8, 0 - 1);
            SLDEP(S, cl_obj_slot, 0);
            EFLSTORE(S, cl_obj_slot);        # spill the object pointer
            SFLC(S, cl_obj_slot + 1);
            # obj[0] = closure fn address
            EFLLOAD(S, cl_obj_slot);
            EPUSHR(S);                       # push dest = obj + 0
            var clfc = GFCNT(S);
            if (clfc >= 1048576) {
                _ew("error: fixup table full (1048576)\n", 34);
                _die(1);
            }
            ELOAD_FN_ADDR(S, _fixup_base + clfc * 16, clfc, clfi);   # rax = fn addr
            EPOPC(S);                        # rcx = dest
            ESTORE64(S);                     # [obj+0] = fn addr
            # obj[1+i] = captured enclosing local (cap_slots[i]); state is restored,
            # so EFLLOAD reads the enclosing fn's local — capture BY VALUE.
            # 6.6.5: an AGGREGATE capture copies all its words. Word k of an enclosing
            # inline aggregate — the word at `&base + k*8` (on the stack slot base - k; in a
            # coroutine frame not, see `_cl_emit_cap_word`) — lands at env[woff + k], so
            # `env + woff*8 + k*8` addresses field k exactly as `&base + k*8` does in the
            # enclosing frame — which is what lets the body reuse the ordinary field math.
            # 6.6.17: a capture of the enclosing closure's own capture copies from its env.
            _cl_emit_env_caps(S, cl_obj_slot, cl_inner);
            EFLLOAD(S, cl_obj_slot);          # closure value = the object pointer
            # v6.5.17 — TAG IT. Bit 63 makes the value self-identifying, so any
            # indirect call site can dispatch it (load [obj+0], pass obj as the
            # trailing env arg) without knowing where the value came from. Without
            # this bit the whole scheme is the old static SLTYPE peek, which the
            # value outlives the moment it is passed, returned or stored.
            ECLTAG(S);
        } else {
            # Non-capturing closure: a bare fn pointer (same fixup-type-3 op as
            # `&fn_name`). v6.3.7-stable path.
            var clfc = GFCNT(S);
            if (clfc >= 1048576) {
                _ew("error: fixup table full (1048576)\n", 34);
                _die(1);
            }
            var clfaddr = _fixup_base + clfc * 16;
            ELOAD_FN_ADDR(S, clfaddr, clfc, clfi);
        }
        # v6.5.17 — nothing to hand back to the enclosing var-decl any more: the
        # closure value carries its own tag (ECLTAG above), so no SLTYPE is needed.
        return 0;
    }
    ERR(S);
    return 0;
}
