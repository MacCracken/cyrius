    _consume_gt(S);                     # consume the closing `>` (or `>>` tail)
    if (_ta_refd == 1) { return _gen_call_refd(S, noff); }   # 6.7.14
    # Call the base (the all-i64 instance) only when EVERY arg is i64.
    var _ta_do = 0;
    if (_ta_conc != 0 - 8) { _ta_do = 1; }
    if (_ta_conc1 != 0 && _ta_conc1 != 0 - 8) { _ta_do = 1; }
    # A stub generic with a scalar type argument: route it to the base call, whose head refuses it.
    if (_ta_conc < 0 && _ta_conc1 <= 0) { if (_gen_stub(S, fi) != 0) { _ta_do = 0; } }
    if (_ta_do == 0) {
        _ta_explicit = 1;               # set right before the call that reads it (see below)
        PARSE_FNCALL(S, noff);          # all-i64: call the base
        _call_ret_marks(S, fi);         # 6.6.17: a `*T` return's pointer scale (6.7.9: + an f64)
        return 0;
    }
    # non-i64: monomorphize on demand + call the specialized fn.
    var _spec = _instantiate_generic_fn(S, fi, _ta_conc, _ta_conc1);
    if (_spec == 0 - 2) {
        ERR_MSG(S, "non-i64 generic fns with parameters: instantiate-once param re-emission is a follow-on bite", 91);
    }
    # ⛔ 6.6.5 — `_spec` is -2 on the error path above (and was -3 too until 6.7.1),
    # and `_fnt_names + _spec * 8` read 16/24 bytes BEFORE the
    # table: an out-of-bounds load whose garbage was then parsed
    # as a name, which is where the nonsense
    # "undefined function 'enum'" came from. ERR_MSG does not
    # exit (the multi-error contract), so the guard has to be
    # here. Arguments are still consumed, by PARSE_FNCALL on the
    # base name, so the parse stays in sync. CHANGELOG [6.6.5]
    # ⚠ `_ta_explicit` is set only NOW: the instance body just emitted makes calls of its own,
    # and the first of them would have taken the flag as its own and skipped its inference.
    _ta_explicit = 1;
    # 6.7.11: 2 = the instance's bound was refused (-4) and reported at the type the call binds: the
    # base call below only consumes the arguments, and is not judged against the base (`gb<f64>(h)`
    # also said "needs `impl Show for i64`"). CHANGELOG [6.7.11]
    if (_spec == 0 - 4) { _ta_explicit = 2; }
    if (_spec >= 0) { PARSE_FNCALL(S, L64(_fnt_names + _spec * 8)); _call_ret_marks(S, _spec); }   # 6.7.9: + an f64
    else { PARSE_FNCALL(S, noff); }
    return 0;
}
# ⛔ 6.7.14 — AN EXPLICIT CALL WHOSE OWN TYPE ARGUMENT WAS REFUSED (`g<f64v2>(b)`, `g<1>(b)`, `g<[u8]>(b)`) mints no
# instance: the refused argument read as i64 minted `g$i`, whose parse cleared the panic latch, so its arguments were
# judged against `p: *i64` too — a second error, D27's "cannot pass 'b' ... in a call to 'g$i'". The base is called the
# way 6.7.11's refused bound is (`_ta_explicit` 2: not re-inferred, not judged as a stub or a bound), its arguments
# consumed. The latch is `_ta_refd`, cleared when this call's list opens. CHANGELOG [6.7.14]
fn _gen_call_refd(S, noff): i64 {
    _ta_refd = 0;
    _ta_explicit = 2;
    var p0 = _panic;
    _panic = 1;   # the arguments are consumed, not judged: the call's one error is its type argument's
    PARSE_FNCALL(S, noff);
    _panic = p0;
    return 0;
}
# ⛔ 6.6.17 — A CALL'S RESULT CARRIED ITS LAST ARGUMENT'S POINTER SCALE. The arguments are parsed
# as expressions inside the call's factor, and nothing reset the scale the last one left, so with
# `p: *i64` the value of `f(p) + 1` was f's result + 8, as was `load64(p) + 1`, `fncall1(&f, p) + 1`
# and `callptr(cl, p) - p` (p scaled by 8 too). Silent wrong values. A call's result now scales
# only by the callee's DECLARED return type: `fn f(): *T` steps sizeof(T) (`_fn_rps`), anything
# else — every builtin, `callptr` / `fncallN` (6.7.14: but a known `&f`'s `: *T`), an untyped or scalar return —
# is a plain value.
# `ti` is the factor's first token; only a factor that IS one whole call `name(..)` /
# `name<..>(..)` / `builtin(..)` is judged — one continuing past the `)` (`mk(p).f`) sets its own.
# The method arm sets its result's scale itself (`_mcall_ret`). CHANGELOG [6.6.17]
fn _call_scale_fix(S, ti): i64 {
    var t = TOKTYP(S, ti);
    var o = 0 - 1;
    if (t == 2) { o = _gcall_open(S, ti); }
    elif (TOKTYP(S, ti + 1) == 10) {
        if (t == 137) { o = ti + 1; }                       # callptr
        elif (TOKNAME_BUILTIN(t) != 0) { o = ti + 1; }
    }
    if (o < 0) { return 0; }
    if (GTI(S) != _call_close(S, o) + 1) { return 0; }
    var ps = 0;
    if (t == 2) {
        # 6.6.20: the INSTANCE the call reaches (`gr<i32>(..)`, or `gr(pt)` inferring T), whose
        # `: *T` steps sizeof(T) — FINDFN named the template, whose T is i64. CHANGELOG [6.6.20]
        var fi = _pair_gen_inst(S, ti);
        if (fi >= 0) { if (_fn_rps != 0) { ps = L64(_fn_rps + fi * 8); } }
        _lsc_free(S, ti, o, fi);   # 6.7.6: a struct result, for a left operand
        _gcall_ret_f64(S, ti, fi);  # 6.7.9: an inferred instance's f64
    }
    if (ti == _icall_ps_beg) { ps = _icall_ps; }   # 6.7.14 (D26 (a)): a known `&f` callee's `: *T` (`_icall_scalar`)
    SPSC(S, ps);
    return 0;
}
# ⛔ 6.7.9 — AN INFERRED GENERIC CALL'S f64 RESULT WAS AN UNTYPED WORD. The call arm types a result
# from FINDFN's entry, which for a generic is its i64 BASE (`: T` an i64), while the call reaches
# the instance its arguments bind: `gid(h)` with `h: f64` calls `gid$f64`, whose `: T` is an f64
# return (`_gtype_tp_ret`). `gid(h) * 2.0` multiplied the double's bits. The instance `fi` the
# call at `ti` reached types it here, as `_call_ret_marks` does a `: f64` fn's; the explicit
# spelling `gid<f64>(h)` types its own (`_explicit_generic_call`). CHANGELOG [6.7.9]
fn _gcall_ret_f64(S, ti, fi): i64 {
    if (fi < 0) { return 0; }
    if (TOKTYP(S, ti + 1) != 10) { return 0; }
    if (GFRS(S, fi) != 0 - 9) { return 0; }
    if (GFRS(S, FINDFN(S, TOKVAL(S, ti))) == 0 - 9) { return 0; }   # the call arm typed it
    EMOVQ_A_X0(S);
    SESTYPE(S, F64_TYID);
    return 0;
}
# After a plain call `name(..)` to fn `fi` (-1: unresolved): a scalar f64 return (sentinel -9) is
# in xmm0 — bring it back into rax and type the expression F64_TYID (v6.4.55; EMOVQ_A_X0 is a no-op
# on aarch64/cx) — and a `*T` return carries T's step as the pointer scale (6.6.17).
fn _call_ret_marks(S, fi): i64 {
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) == 0 - 9) { EMOVQ_A_X0(S); SESTYPE(S, F64_TYID); }
    _call_ret_ps(S, fi);
    return 0;
}
# ⛔ 6.7.9 — A METHOD CALL'S RESULT KEPT ITS LAST ARGUMENT'S TYPE. The method arm of
# `_field_load_on` has no PARSE_FNCALL, so neither half of a free call's result typing ran: the
# arguments' expression type survived the call (`p.m(1.5) * 2` with `m: i64` multiplied bit
# patterns as doubles — 0; `p.m(p) * 10` dispatched `P_mul`), and a `: f64` method's result was
# never typed f64 (`p.area() + 1.0` added integers). Both halves now, in a free call's order:
# the reset (PARSE_FNCALL's v6.4.56 D3), then `_call_ret_marks` on the callee. CHANGELOG [6.7.9]
fn _mcall_ret(S, fi): i64 {
    SESTYPE(S, 0);
    return _call_ret_marks(S, fi);
}

# 1 = `syscall(sc_num, ..)` with `got` user arguments is a KNOWN cross-target shape, not an
# arity mismatch: the Linux x86_64 arity table below cannot see which peer a wrapper belongs
# to. Split out of _PARSE_FACTOR_IMPL (6.6.12) so the target gate on the kill shape costs that
# body no global reference.
fn _sc_arity_skip(sc_num, got): i64 {
    # Skip the warning when this is the cross-arch
    # openat shape: syscall(SYS_OPEN=2, AT_FDCWD, path,
    # flags, mode) — 4 user args instead of open()'s 3.
    # Source: arch-conditional wrappers in
    # lib/syscalls_*_linux.cyr and src/frontend/lex/lex.cyr
    # keep both open()/openat() shapes for cross-arch
    # source compatibility; the dead branch on the
    # running arch is not a bug. Open() is never called
    # legitimately with 4 user args, so the structural
    # match is unambiguous.
    var skip_warn = 0;
    if (sc_num == 2) { if (got == 4) { skip_warn = 1; } }
    # v5.8.54: same cross-arch number-reuse pattern as
    # SYS_OPEN above. Linux x86_64 SYS_SETUID = 113 (1
    # arg); Linux aarch64 SYS_CLOCK_GETTIME = 113 (2
    # args: clock_id + timespec_ptr — `syscall(113, 1,
    # &ts)` in cyrius syntax = 3 cyrius-args, got=2).
    # Surfaced by `src/backend/aarch64/fixup.cyr`'s
    # `_prof_clock_ns()` helper; warning fired on every
    # aarch64 cross-build. setuid is never legitimately
    # called with 2 user args, so the structural match
    # is unambiguous (same logic as the SYS_OPEN skip).
    if (sc_num == 113) { if (got == 2) { skip_warn = 1; } }
    # 6.6.10: Darwin's kill is kill(pid, sig, posix). lib's sys_kill passes
    # posix = 0 explicitly on macOS (a stale third register made kill(-pgid)
    # answer EPERM or ESRCH at random), and this Linux table then warned on
    # every x86-macOS build. Linux kill never takes 3 user args, so the
    # structural match is unambiguous (the 113 shape). CHANGELOG [6.6.10]
    # ⛔ 6.6.12: DARWIN ONLY. The skip had no target check, so a wrong 3-arg kill compiled
    # SILENTLY on x86-Linux from 6.6.10 on (6.6.9 warned). PE never prints this arity warning
    # (its unrouted-number warning names the call, unchanged), and arm64-macOS never reaches
    # here (_AARCH64_BACKEND).
    if (_TARGET_MACHO == 1) { if (sc_num == 62) { if (got == 3) { skip_warn = 1; } } }
    # v6.0.48: agnos uses NATIVE syscall numbers (0-33) that
    # collide with Linux numbers at different arities (agnos
    # getpid=2 vs Linux open=2/3-args; agnos exit=0 vs Linux
    # read=0/3-args; ...). This arity table is Linux-only, so
    # it false-positives on every agnos syscall;
    # lib/syscalls_x86_64_agnos.cyr is the authority.
    if (_TARGET_AGNOS == 1) { skip_warn = 1; }
    return skip_warn;
}

# `_SYSX_MEANT(n)` — the x86_64 name of a raw number that means something else on
# ELF-aarch64 — unless the call sits inside a native-aarch64 region (`#ifdef
# CYRIUS_ARCH_AARCH64`, `#ifndef CYRIUS_ARCH_X86`, ...), where the number is the native one
# by construction: the preprocessor marks those regions (PP_A64_NATIVE_AT,
# src/frontend/lex/pp/directive.cyr). Same frame rule as tests/gates/platform/
# raw_syscall_literals_routed.sh applies to lib/. The table is a `return 0` stub off the
# aarch64 backend, so the scan runs only where a warning would otherwise print.
# CHANGELOG [6.6.12]
fn _sysx_meant_here(S, n): i64 {
    var m = _SYSX_MEANT(n);
    if (m == 0) { return 0; }
    # The call's own closing `)` (the cursor is one past it): the token after it may sit
    # beyond the `#endif` that closes the region.
    if (PP_A64_NATIVE_AT(S, GTOFF(S, GTI(S) - 1)) == 1) { return 0; }
    return m;
}
