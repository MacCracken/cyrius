# `= e` / `OP= e` on a field of a call's result (`mk(3).n`, `b.mk(4).x`): refused by name, the rest
# of the statement stepped over — the parse is then in sync, so the panic latch is left as it was
# and the next statement is parsed (and reported) normally. 1.
fn _asg_temp_refused(S): i64 {
    var p0 = _panic;
    ERR_MSG(S, "cannot assign to a field of a call result: the result is a temporary", 68);
    _cst_skip_decl(S);
    _panic = p0;
    return 1;
}
# A refusal inside a statement that is then parsed to its end: reported once, and the panic latch
# left as it was, so the statement after it is parsed and reported (`_bx_refuse`'s rule). 6.7.5
fn _err_in_sync(S, msg, noff, tail): i64 {
    if (_panic == 1) { return 0; }
    if (_tn_once(S, GTI(S)) == 0) { return 0; }   # a generic base and its instances parse the same tokens: report once
    ERR_IDENT(S, msg, noff, tail, 0 - 1);
    _panic = 0;
    return 0;
}

# v6.3.10 (explicit): `foo<i64>(x)` / `foo<Pt>(p)` — cursor on the `<`. Out of
# `_PARSE_FACTOR_IMPL` since 6.6.10: that body is near cybs's per-function reference limit, and
# this path grew the stub refusal.
# ⛔ 6.6.10 — `_ta_explicit` tells the PARSE_FNCALL below not to re-infer, and a stub generic
# (it uses T as a struct) is refused by name for ANY scalar type argument: `g<i64>(5)` ran the
# `rax = 0` stub silently, and `g<i32>(5)` minted an instance that failed with "no struct type
# in scope for 'p'". A forwarded `inner<T>` in a base emission never gets here with a stub
# callee: the enclosing generic is a (transitive) stub itself, so its base body is skipped —
# which retired 6.6.8's `_call_forwarded_base` (a base call with the inline replay suppressed at
# depth 0, which existed only to keep that replay out of such a base). CHANGELOG [6.6.10]
fn _explicit_generic_call(S, noff, fi): i64 {
    if (_MONOMORPH_OK != 1) { return _egc_nomono(S, noff, fi); }   # 6.7.17 (D7)
    STI(S, GTI(S) + 1);                 # consume `<`
    _ta_pending_gt = 0;
    _ta_refd = 0;
