# PARSER — expr: unary minus on an untyped float (`_UFV_*`), a `.field` after parentheses (`_pf_*`, `_pd_*`) and after a
# call (`_call_field`), undefined callees, explicit generic calls, a call's result marks and the syscall arity skip.
# ================================================================
# Split from parse/expr.cyr at 6.7.18, unchanged; parse.cyr includes parse/expr/ in source order. CHANGELOG [6.7.18]

# ⛔ 6.6.10 — UNARY MINUS ON AN UNTYPED FLOAT VARIABLE. `var c = 1.5; -c` is an INTEGER
# negation of 1.5's bits (-3.0; `-z` of 0.0 is +0, `-n` of -2.5 is 1.75), silent, because an
# untyped var is i64-boxed (ADR-002) and nothing recorded what initialised it. WARN, the
# roadmap's agreed posture: inferring f64 would change what existing code computes.
# One byte per slot: `_lfi_base` for locals (cleared as SFLC hands a slot out, so a param or a
# later fn never inherits a stale flag; saved/restored with the closure local snapshot) and
# `_gfi_base` for globals (lazily alloc'd at the var table's hard cap — the `_var_dead`
# precedent; never on the cybs-fragile `_grow_g*` chain). Set on EVERY declaration: 1 when
# the initialiser was a float (a float literal, an f64/f32 value, a float builtin, or another
# such variable), else 0. A load of a flagged variable marks kind 3. CHANGELOG [6.6.10]
fn _UFV_L(S, li): i64 {
    if (_lfi_base == 0) { return 0; }
    if (li < 0) { return 0; }
    if (li >= 16384) { return 0; }
    if (load8(_lfi_base + li) == 1) { _FBR_MARK(S, 3); }
    return 0;
}
fn _UFV_G(S, vi): i64 {
    _vecg_refuse(S, vi);   # 6.6.17 (a3): the untyped-global read rung — a vector global's too
    if (GVBOOL(S, vi) == 1) { _BX_MARK(S); }   # 6.7.3: a bool global's read is a boolean value
    if (GVW128(S, vi) == 1) { _W128_MARK(S, 2, vi); }   # 6.7.6 (D2): a u128 global's read is the u128
    if (_gfi_base == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (load8(_gfi_base + vi) == 1) { _FBR_MARK(S, 3); }
    return 0;
}
# 1 when the expression just parsed is a float (the local-declaration test).
fn _UFV_IS_FLOAT(S): i64 {
    var t = GESTYPE(S);
    if (t == F64_TYID) { return 1; }
    if (t == F32_TYID) { return 1; }
    if (_FBR_KIND(S) != 0) { return 1; }
    return 0;
}

# ⛔ 6.7.6 (Break 1, lane D) — AN f64 VALUE INITIALIZING AN `f32` ROUNDS TO f32 (the user's decision,
# 2026-10-08), as a 6.7.4 `f32[N]` list element does: `var x: f32 = 1.5;` (a local, a global in either
# zone, a for-init) stored 1.5's binary64 bits, which every f32 read takes the low 32 of (0.0),
# silently. The value just parsed is an f64 when it is typed so (a literal, f64 const arithmetic, an
# f64 variable, field or `: f64` fn) or a float builtin marked kind 1 (`f64_sqrt(..)`); it is narrowed
# where it stands, round-to-nearest-even — what `f32_from` (and `_gai_f32` for a list) gives. An f32
# value, an integer constant (kept bits, with its warning) and an untyped word (the i64-boxed idiom)
# are untouched. `t` = the slot's float type; 1 = narrowed. CHANGELOG [6.7.6]
fn _f32_init_round(S, t): i64 {
    if (t != F32_TYID) { return 0; }
    if (GESTYPE(S) != F64_TYID) { if (_FBR_KIND(S) != 1) { return 0; } }
    EF32_FROM(S);
    return 1;
}
# A local or late-global declaration's float initializer, after PCMPE: the integer-constant warning
# (_IFS_CHECK) and the f32 rounding above, in one call from PARSE_VAR.
fn _decl_float_init(S, t, ti): i64 {
    _IFS_CHECK(S, _IFS_K(t), ti);
    _f32_init_round(S, t);
    return 0;
}

# ⛔ 6.6.10 — AN INTEGER STORED INTO AN f64 / f32 SLOT keeps its integer BITS: `var t: f64 = 1;`,
# `t = 1;`, `p.x = 1;` and `P { 1, 2 }` store 0x1, a subnormal, silently. WARN (ADR-002: a
# conversion would change existing code). Only a compile-time integer CONSTANT is judged — a
# literal, a negated literal or an enum constant, spanning the whole initialiser `[ti, end)` —
# because a runtime untyped value is the legal i64-boxed float idiom (`var x: f64 = load64(p)`
# is everywhere). 0 is exempt (its bits ARE 0.0), and so is |v| >= 2^52: an IEEE bit pattern
# written in hex (0x3FF0000000000000) is never below 2^52 unless it is a subnormal, while an
# integer COUNT essentially always is. `k` is the slot's float type (0 = not a float slot).
fn _ic_val_ok(v): i64 {
    if (v == 0) { return 0; }
    if (v < 0) { v = 0 - v; }
    if (v <= 0) { return 0; }
    if (v >= 0x10000000000000) { return 0; }
    return 1;
}
fn _IFS_SPAN(S, ti, end): i64 {
    var n = end - ti;
    if (n == 2) {
        if (TOKTYP(S, ti) != 7) { return 0; }
        if (TOKTYP(S, ti + 1) != 1) { return 0; }
        return _ic_val_ok(TOKVAL(S, ti + 1));
    }
    if (n != 1) { return 0; }
    var t = TOKTYP(S, ti);
    if (t == 1) { return _ic_val_ok(TOKVAL(S, ti)); }
    if (t != 2) { return 0; }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, TOKVAL(S, ti)) >= 0) { return 0; } }
    # _findvar_core, not FINDVAR: a warning heuristic must not raise FINDVAR's `private`
    # refusal — it also runs at global REGISTRATION (_gv_ifs), where that is an accusation.
    var vi = _findvar_core(S, TOKVAL(S, ti));
    if (vi < 0) { return 0; }
    if (GVECP(S, vi) != 1) { return 0; }
    return _ic_val_ok(L64(_vecv_base + vi * 8));
}
fn _IFS_CHECK(S, k, ti): i64 {
    if (k == 0) { return 0; }
    if (ti < 0) { return 0; }
    if (_IFS_SPAN(S, ti, GTI(S)) == 1) { _FLT_TYPE_WARN(S, 4); }
    return 0;
}
# A slot type (F64_TYID / F32_TYID / anything) as a float kind for _IFS_CHECK.
fn _IFS_K(t): i64 {
    if (t == F64_TYID) { return 1; }
    if (t == F32_TYID) { return 2; }
    return 0;
}

# A `.field` on the result of a call (fn `fi`, named `noff`) that returns no struct: refused. 6.7.7
# (B4, T5, R15): a MULTI-VALUE one is told how to read its values — bind them into a tuple first.
# 6.7.16: a method named as the source spells it (`_err_ident_fn`: `P.sc`, it printed `P_sc`), its hint the call as
# written from `beg` (the receiver's first token; -1 for a free call). CHANGELOG [6.7.16]
fn _call_fld_err(S, fi, noff, beg): i64 {
    if (fi >= 0) { if (GFRS(S, fi) == MULTIRET_SID) { return _mret_fld_err(S, fi, noff, beg); } }
    _err_ident_fn(S, "cannot take a field of the result of ", noff, fi, ": it does not return a struct", 0 - 1);
    return 0;
}
fn _mret_fld_err(S, fi, noff, beg): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(GTI(S), "_mret_fld_err", fi * 31 + noff, 1) == 1) { return 0; }   # 6.7.15: once per site
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": cannot take a field of the result of '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));   # written after the head, which may use the scratch
    PRSTR("': it returns ");
    PRNUM(GFRN(S, fi));
    PRSTR(" values - bind them first, `var t: ");
    _mret_spell(S, fi);
    PRSTR(" = ");
    if (beg >= 0) { _tok_src_pr(S, beg, _tok_open_back(S, GTI(S) - 1)); }   # a method: `p.m2`, `w.p.m2`
    else { PRSTR(S + 0xEC00000 + noff); }
    PRSTR("(..);`, then read `t.0`\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}

# ⛔ 6.7.14 — A `.field` / `.m(..)` AFTER PARENTHESES AROUND A STRUCT VALUE (the user's decision D24 (a), 2026-10-16):
# `(s).a`, `((s)).a`, `(p).a` (p a `*P1`), `(*p).a`, `(s).m()`, `(mk1()).a`, `(mk3(5)).b` read the field or call the
# method exactly as unwrapped — the wrap is transparent (guide § Parentheses, 6.7.6; 6.7.11's D35 / D44, 6.7.13's
# D16 / D17 / D19). They were "expected ';', got '.'": the parenthesised factor returned at its `)`. The inside is
# taken as its unwrapped spelling takes it: a name by the field-load route (`PARSE_FIELD_LOAD`, the receiver's first
# token the wrap's `(`, so a destination's records span it), `*E` and any `*S`-typed value through its pointer, a
# free call into a temp (`_call_field`'s convention), a method / operator / known `&f` result or a struct-typed field
# from its record; the wrap is closed and the chain goes on. A wrap around a value that is no struct (`(x + 1).a`) is
# refused by name; at top level a struct result is refused once (no frame), as unwrapped. Cursor on the factor's
# `(`: 1 = taken (the chain consumed), 0 = not `( .. ) . name` (cursor untouched). CHANGELOG [6.7.14]
fn _paren_field(S): i64 {
    var st = GTI(S);
    var k = _pf_wrap(S, st);
    if (k == 0) { return 0; }
    var e = _pf_e;
    var a = st + k;
    var ie = e - k;
    if (ie == a + 1) { if (TOKTYP(S, a) == 2) { return _pf_name(S, st, a, k); } }
    var ps = _hl_dstar_t(S, a, 11);
    if (ps > 0) { return _pf_deref(S, st, a, k, ps); }
    ps = _hl_psid(S, a, ie);
    if (ps > 0) { return _pf_ptr(S, st, a, k, ps); }
    if (_pf_iscall(S, a, ie) == 1) { return _pf_call(S, st, a, k); }
    return _pf_value(S, st, a, k);
}
# The wrap at `st` when `. name` follows it: its parentheses' count, `_pf_e` the `.`; 0 when not that shape (a tuple
# literal is no wrap).
var _pf_e = 0;
fn _pf_wrap(S, st): i64 {
    if (TOKTYP(S, st) != 10) { return 0; }
    if (TOKTYP(S, _call_close(S, st) + 1) != 41) { return 0; }   # the common case, one scan
    if (_tup_lit_at(S, st) >= 0) { return 0; }
    var pe = _pw_end;
    var k = _pwrap_k(S, st);
    _pf_e = _pw_end;
    _pw_end = pe;
    if (_mchain_at(S, _pf_e) == 0) { return 0; }
    return k;
}
# A name: `PARSE_FIELD_LOAD` on it with the cursor on the `.` after the wrap.
var _pfl_bo = 0 - 1;
fn _pfl_beg(S): i64 {
    var b = GTI(S) - 1;
    if (_pfl_bo >= 0) { b = _pfl_bo; _pfl_bo = 0 - 1; }
    return b;
}
fn _pf_name(S, st, a, k): i64 {
    STI(S, a + 1);
    _pw_close(S, k);
    _pfl_bo = st;
    PARSE_FIELD_LOAD(S, TOKVAL(S, a));
    _cfo = 0;
    return 1;
}
# `*E`, E a `*S` (`_hl_dstar_t`): E is the struct's address — parked as a pointer receiver of S.
fn _pf_deref(S, st, a, k, ps): i64 {
    var nm = _hl_dnm;
    STI(S, a + 1);
    PARSE_FACTOR(S);
    _pw_close(S, k);
    return _pf_chain(S, nm, st, _ptr_park(S, ps), ps);
}
# A value typed `*S` (`_hl_psid`: a call or a method declared `: *T`, a `*T` field, pointer arithmetic on one).
fn _pf_ptr(S, st, a, k, ps): i64 {
    var nm = _hl_pnm(S, a, _pf_e - k);
    STI(S, a);
    PCMPE(S);
    _pw_close(S, k);
    return _pf_chain(S, nm, st, _ptr_park(S, ps), ps);
}
# After the wrap (cursor on its `.`): the chain on receiver `h` of struct `sid`.
fn _pf_chain(S, noff, beg, h, sid): i64 {
    STI(S, GTI(S) + 1);   # `.`
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);   # the field / method name
    _field_load_on(S, noff, fnoff, beg, h, sid);
    _cfo = 0;
    return 1;
}
# 1 = [a, ie) is one whole free call `name(..)` / `name<..>(..)` (not a call through fncallN).
fn _pf_iscall(S, a, ie): i64 {
    if (TOKTYP(S, a) != 2) { return 0; }
    var o = _gcall_open(S, a);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 != ie) { return 0; }
    if (_icall_open_at(S, a) >= 0) { return 0; }
    return 1;
}
# A free call: into a temp, as `mk1().a` (`_call_field`): a struct over 8 B returned in rax (`Str`) is a handle.
fn _pf_call(S, st, a, k): i64 {
    var fi = _gen_resolve_call(S, a);
    if (fi < 0) { return _pf_value(S, st, a, k); }   # an undefined callee reports itself
    var sid = GFRS(S, fi);
    if (sid <= 0 || GINFN(S) != 1) {
        if (_syntax_only == 0) {
            if (sid <= 0) { _call_fld_err(S, fi, TOKVAL(S, a), 0 - 1); }
            else { _refuse_toplevel_struct_call(S, TOKVAL(S, a)); }
        }
        return _pf_skip(S);
    }
    STI(S, a);
    var h = 0;
    if (_ret_agg_class(S, fi) == 0) { if (STRUCTSZ(S, sid - 1) > 8) { h = 1; } }
    _struct_call_into(S, h);
    var t = _sci_t;
    _pw_close(S, k);
    return _pf_chain(S, TOKVAL(S, a), st, 0 - 2 - t, sid);
}
# The rest after a refusal: past the wrap, every `.name` / `(..)` of the chain.
fn _pf_skip(S): i64 {
    STI(S, _pf_e);
    _mchain_skip(S);
    _cfo = 0;
    return 1;
}
# Anything else: parsed with the struct records armed — a method / operator / known `&f` call's result
# (`_lsc_*`: a temp, or the value in rax / rax:rdx stored into one) or a whole struct-typed field (`_fla_take`:
# its address). No struct: refused by name. At top level a struct result has no frame: refused once.
fn _pf_value(S, st, a, k): i64 {
    var e = _pf_e;
    STI(S, a);
    var w = _sc_arm(S);
    var fw = _fla_want;
    _fla_want = a;
    _fla_hit = 0;
    PCMPE(S);
    _sc_want = w;
    _fla_want = fw;
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); return _pf_skip(S); }
    if (_fla_hit == 1) { return _pf_fld(S, st, k); }
    var nm = _hl_lastnm(S, a, GTI(S), TOKVAL(S, a));
    if (_sc_beg == a) { if (_sc_end == GTI(S)) { nm = _sc_fn; } }   # a method / operator / `&f` callee: its fn
    if (_pf_lsc(S, a) == 0) {
        if (_sc_rbeg == a) { if (_sc_rend == GTI(S)) { return _pf_skip(S); } }   # refused at top level (no frame)
        _pf_err(S, e);
        return _pf_skip(S);
    }
    var sid = _lsc_sid;
    if (GINFN(S) != 1) {
        if (_syntax_only == 0) { _refuse_toplevel_struct_call(S, nm); }
        return _pf_skip(S);
    }
    var t = _lsc_tmp;
    if (t < 0) {
        if (STRUCTSZ(S, sid - 1) <= 8) { t = _mchain_temp(S, sid); }
        else {
            t = _agg_temp(S, sid);
            EFLSTORE_STRUCT_INT_PAIR(S, t);
        }
    }
    _pw_close(S, k);
    return _pf_chain(S, nm, st, 0 - 2 - t, sid);
}
# 1 = the struct result stamp (`_lsc_note`) spans [a, cursor) with nothing emitted after it.
fn _pf_lsc(S, a): i64 {
    if (_lsc_beg != a) { return 0; }
    if (_lsc_end != GTI(S)) { return 0; }
    if (_lsc_cp != GCP(S)) { return 0; }
    return 1;
}
# A whole struct-typed field (`_fla_take` recorded it, loading nothing): its address, parked.
fn _pf_fld(S, st, k): i64 {
    _fla_hit = 0;
    var ft = _fla_ft;
    _fld_addr_ra(S, _fsc_fidx, _fsc_fsid, _fsc_foff, 0 - 1);
    var h = _ptr_park(S, ft);
    _pw_close(S, k);
    return _pf_chain(S, _fla_name, st, h, ft);
}
fn _pf_err(S, e): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_tn_once(S, e) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, e);
    ERR_MSG(S, "a field is read only from a struct value - the value in these parentheses is not a struct (or a pointer to one)", 111);
    STI(S, sv);
    return 0;
}
# ⛔ 6.7.14 (D24 (a)) — a STATEMENT that begins `( .. ) . name`: a method call or a read (`(s).m();`, `(mk1()).a;`)
# is parsed as unwrapped (PARSE_FACTOR's `_paren_field`, a discarded `#must_use` result warned); a store `(s).a = v;`
# / `(s).a += v;` is refused by name, the statement stepped over in sync — it was "unexpected '('" for every one.
# One call in PARSE_STMT (cybs's per-fn ceiling). 1 = the statement is consumed. CHANGELOG [6.7.14]
fn _stmt_paren_field(S): i64 {
    var st = GTI(S);
    if (_pf_wrap(S, st) == 0) { return _stmt_paren_dst(S, st, 1); }   # 6.7.15 (D19): `(*p) += 1;`
    var x = _pf_chain_end(S, _pf_e);
    if (_pf_asg_at(S, x) == 1) {
        _pf_store_err(S);
        STI(S, st);
        _cst_skip_sync(S);
        return 1;
    }
    if (_pf_read_stmt(S, st, x) == 1) { return 1; }   # 6.7.15 (D60): `(s).a;` refused as `s.a;` is
    _mcall_last = 0 - 1;
    PARSE_FACTOR(S);
    if (_mcall_last >= 0) { if (PEEKT(S) == 5) { _must_use_warn(S, L64(_fnt_names + _mcall_last * 8)); } }
    _expect_step(S, 5);
    return 1;
}
# A store through `( .. ).name` (D24 (a)), refused once at the wrap's `.` (`_pf_e`), the latch as it was; the cursor is
# left on the `.`. The statement's and (6.7.16) the classic-for step's. ⛔ 6.7.16 — under --syntax-only too: the rule
# reads no type (any `( .. ).name = v` is refused), and lint passed `(s).a = 1;` that the build refuses, where it
# refuses its D19 / D22 / D60 siblings. CHANGELOG [6.7.16]
fn _pf_store_err(S): i64 {
    if (_tn_once(S, _pf_e) == 0) { return 0; }
    var p0 = _panic;
    STI(S, _pf_e);
    ERR_MSG(S, "cannot assign to a field after parentheses - write the store without them (`s.a = v`)", 85);
    _panic = p0;
    return 0;
}
# ⛔ 6.7.16 — A CLASSIC-FOR STEP WHOSE DESTINATION IS PARENTHESISED IS REFUSED IN ITS STATEMENT'S WORDS: `(n) = 7`,
# `(*pn) += 1` (6.7.15's D19), `(pn)[0] = 2` (6.7.16's D22) and `(s).a = 3` (6.7.14's D24 (a)) were "expected '=', got
# <the token after the `(`>": `_for_step_replay` took the `(` as the destination's name, and the statement's refusals
# (`_stmt_paren_field`) never saw a step. The statement's readers run with the step's `)` as the end (`_pd_semi` and
# the chain walkers stop there): the same words, once at the same token, with no skip — PARSE_FOR puts the cursor back
# after the step. A parenthesised value (`(n + 1) = 7`), a call (`(s).m()`) or no assignment keeps "expected '='".
# Cursor on the step's `(`: 1 = refused, else 0 with the cursor untouched. CHANGELOG [6.7.16]
fn _step_paren(S): i64 {
    var st = GTI(S);
    if (_pf_wrap(S, st) == 0) { return _stmt_paren_dst(S, st, 0); }
    if (_pf_asg_at(S, _pf_chain_end(S, _pf_e)) == 0) { return 0; }
    _pf_store_err(S);
    return 1;
}
# ⛔ 6.7.15 — `(s).a;` ALONE IS REFUSED AS `s.a;` IS (the user's D60, 2026-10-18; 6.7.14's item 19): since 6.7.14's
# D24 (a) a statement `( .. ).a;` compiled as a discarded read, while the unwrapped `s.a;` is refused ("expected '='")
# and 6.7.13 refused it too ("unexpected '('"). A statement that is a field read through parentheses with NO call in it
# (`(s).a;`, `(p).a;`, `(*p).a;`, `(w).p.a;`, `((s)).a;`) is now "the field read 'a' is discarded - a statement is an
# assignment or a call", once at the field, the statement ended in sync (the latch as it was). A call anywhere keeps
# it a statement, as unwrapped: `(mk1()).a;` as `mk1().a;`, `(s).m();` as `s.m();`, `(s).me().a;` as `s.me().a;`, and a
# struct operator's result (`(x + y).b;`, its stamp `_lsc_beg` inside the statement). It is judged after the parse, so
# a read that stops short (`(s).a.b;` of a scalar a, `(s).zz;`, `(zz).a;`) or latches its own refusal (`(x + 1).a;`)
# keeps that one error. `x` = the token after the chain. 1 = the statement is consumed. CHANGELOG [6.7.15]
fn _pf_read_stmt(S, st, x): i64 {
    if (TOKTYP(S, x) != 5) { return 0; }
    if (_pf_has_call(S, st + 1, x) == 1) { return 0; }
    var p0 = _panic;
    _lsc_beg = 0 - 1;
    PARSE_FACTOR(S);
    var ok = 1;
    if (GTI(S) != x) { ok = 0; }
    if (_lsc_beg >= st) { if (_lsc_beg < x) { ok = 0; } }   # a struct operator's call
    if (_panic != p0) { ok = 0; }   # its own refusal latched (`(x + 1).a;`): left latched, not restored below
    var f = _pf_last_field(S, _pf_e, x);
    if (ok == 1) { if (f >= 0) {
            STI(S, f);
            var tl = " is discarded - a statement is an assignment or a call";
            ERR_IDENT(S, "the field read ", TOKVAL(S, f), tl, 0 - 1);
            _panic = p0;
            STI(S, x);
        } }
    _expect_step(S, 5);
    return 1;
}
# 1 = a call opens in tokens [i, e): a `(` after a name, a type-argument list's `>` or a builtin (`f(`, `.m(`,
# `g<T>(`, `load64(`) — a grouping `(` follows `(`, an operator or `*` / `&`.
fn _pf_has_call(S, i, e): i64 {
    while (i < e) {
        if (TOKTYP(S, i) == 10) {
            var pt = TOKTYP(S, i - 1);
