    # then folded to 4 by rewriting the code from that literal — the call and the load with it.
    _cfo = 0;
    return 1;
}
# ⛔ 6.7.15 — A `.field` OF AN UNDEFINED FN'S RESULT (`undefd().n += 1;`, `var x = undefd().n;`, the classic-for step
# `undefd().n += 1`) never named the fn: `_call_field` left the call to PARSE_FNCALL, which stopped at the `.`
# ("expected ';', got '.'"; the step fell to `_for_step_assign`, "expected '=', got '('"), and the fn surfaced only in
# the end-of-compile refusal. Callee token `ti` resolving to no fn (pass 1 registered every definition) is "undefined
# function 'undefd'" at its name — an ERROR, so --allow-undef cannot compile the line — once, the latch as it was;
# the call and its `.f` / `.m(..)` / `[..]` chain are stepped over unparsed (this call is not registered: only an
# earlier or later plain call to the name adds the end-of-compile refusal), rax 0, and `_tsc_n` moves, so the
# statement and the step step over their tails with no second error. `sizeof` / `mulh64`, lowered by name, keep their
# path; --syntax-only never gets here (a sibling module's fn, `_cf_unres`). 1 = consumed, 0 = not this shape.
# CHANGELOG [6.7.15]
fn _call_undef(S, ti): i64 {
    var noff = TOKVAL(S, ti);
    if (_is_ident_intrinsic(S, noff) == 1) { return 0; }
    STI(S, ti);
    _err_in_sync(S, "undefined function ", noff, 0);
    STI(S, _pf_chain_end(S, _call_close(S, _gcall_open(S, ti)) + 1));
    _tsc_n = _tsc_n + 1;
