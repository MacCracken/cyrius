        # a false "cannot subscript field 'p'". 6.7.16: whole, before the walk below — a method's explicit list
        # (`mk().mm<f64>(2.5)` at top level, `fs().mm<f64>(2.5)`) read `<` as less-than ("undefined variable 'f64'").
        # --syntax-only walks it, its arguments and index parsed. CHANGELOG [6.7.16]
        if (_syntax_only == 0) { STI(S, _pf_chain_end(S, GTI(S))); }
        _synonly_skip_chain(S);
        # a method on the refused result: its arguments too, or `(` is a second error
        if (PEEKT(S) == 10) { STI(S, _call_close(S, GTI(S)) + 1); }
        if (_syntax_only == 1) { if (_cf_unres_fn(S, ti, fi) == 1) { _cf_unres = ti; } }   # 6.7.15: a sibling module's fn (6.7.16: or struct)
        _cfo = 0;
        return 1;
    }
    STI(S, ti);
    var h = 0;
    if (_ret_agg_class(S, fi) == 0) { if (STRUCTSZ(S, sid - 1) > 8) { h = 1; } }
    _struct_call_into(S, h);
    var t = _sci_t;
    STI(S, GTI(S) + 1);                 # consume `.`
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);                 # consume the field name
    _field_load_on(S, TOKVAL(S, ti), fnoff, ti, 0 - 2 - t, sid);
