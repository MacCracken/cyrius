    if (_call_dotted(S, ti) == 0) { return 0; }
    if (_icall_open_at(S, ti) >= 0) { return _icall_stmt_chain(S, ti); }   # 6.7.13 (D16 (a)): `fncall1(&f, ..).m();`
    var fi = _gen_resolve_call(S, ti);
    var u = _call_nodef(S, ti, fi);   # 6.7.15 / 6.7.16: an undefined callee named, its chain stepped over
    if (u >= 0) { return u; }
    var sid = 0;
    if (fi >= 0) { sid = GFRS(S, fi); }
    if (sid <= 0) { if (_call_ptr_field(S, ti, fi) == 1) { return 1; } }   # 6.6.17: `: *T`
    if (sid <= 0 || GINFN(S) != 1) {
        # --syntax-only: a return type from a sibling file reads as a scalar, so stay silent.
        if (_syntax_only == 0) {
            if (sid <= 0) { _call_fld_err(S, fi, TOKVAL(S, ti), 0 - 1); }   # 6.7.7 (T5): + a multi-value one's hint
            else { _refuse_toplevel_struct_call(S, TOKVAL(S, ti)); }
