# ⛔ 6.7.16 — and a callee an EARLIER PLAIN CALL registered (`undefd(); undefd().n += 1;`): the entry resolved (fi >= 0)
# with no return struct, so the field was "cannot take a field of the result of 'undefd': it does not return a struct".
# The test is the definition, not the entry: `_fn_nodef` (no code and no owner — pass 1 owns every `fn` it scans,
# `#derive`'s text included, and a generic instance is defined before its call returns). The one definition pass 1
# registers with no owner is an enum variant's payload constructor (`Some(v)`), whose code is emitted at its enum: a
# call from a fn above the enum sees neither, so a variant's name keeps the old path (`_fn_enum_var`). -1 = a defined
# callee: go on; else `_call_field`'s answer. CHANGELOG [6.7.16]
fn _call_nodef(S, ti, fi): i64 {
    if (_syntax_only == 1) { return 0 - 1; }
    if (_fn_nodef(S, fi) == 0) { return 0 - 1; }
    if (fi >= 0) { if (_fn_enum_var(S, TOKVAL(S, ti)) == 1) { return 0 - 1; } }
    if (_call_undef(S, ti) == 1) { return 1; }
    if (fi < 0) { return 0; }
    return 0 - 1;
}
# 1 = `noff` names an enum variant (its constant's var slot carries the enum's id).
fn _fn_enum_var(S, noff): i64 {
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    if (GVENUMID(S, vi) != 0) { return 1; }
    return 0;
}

# ⛔ 6.7.15 — --syntax-only, A FIELD ASSIGNMENT ON A SIBLING MODULE'S CALL (`gp().n = 5;`, the for step `gp().n += 1`,
# with `fn gp(): *H` in another file) was "cannot assign to a field of a call result: the result is a temporary": the
# callee resolved to nothing, `_call_field` stepped over the call and its chain silently, and the statement then judged
# the `=` as if the result were known to be a struct by value. Only a KNOWN callee's result is known to be a
# temporary: `_cf_unres` is the callee token of the last call `_call_field` stepped over under --syntax-only with no
# definition in this file (`_fn_nodef`: unregistered, or registered only by an earlier call), and the statement /
# step whose callee it is parses its assignment silently (`_synonly_fld_tail`), as a field store parses one through
# a struct this file cannot see. CHANGELOG [6.7.15]
var _cf_unres = 0 - 1;
# 1 = fn `fi` (-1: none) has no definition this file shows: unregistered, or registered only by a call — pass 1
# recorded no owner for it (`_warn_undefined_prepass`'s test).
fn _fn_nodef(S, fi): i64 {
    if (fi < 0) { return 1; }
    if (L64(_fnt_offsets + fi * 8) >= 0) { return 0; }
    if (GFFI(S, fi) != 0) { return 0; }
    return 1;
}
# 1 = `_call_field` arms `_cf_unres` for callee token `ti`'s fn `fi`: no definition here (`_fn_nodef`), or (6.7.16) one
# declared `: *T` whose T this file does not declare (`_fn_ret_unk`), so no struct was recorded for it (`_hl_fn_psid`) —
# the winning definition's, of a redefined fn (the byte, not GFRS: pass 2 re-reads an earlier definition's return). A `: Foo` result by value keeps "the result is a temporary"; a `*T` whose T is declared here took
# D8 (a)'s store. An enum variant's payload constructor called above its enum has no code and no owner yet, but it is
# defined here (`_call_nodef`'s exclusion): `Some(5).n = 1;` was accepted, where the build refuses it. CHANGELOG [6.7.16]
fn _cf_unres_fn(S, ti, fi): i64 {
    if (_fn_nodef(S, fi) == 1) {
        if (fi >= 0) { if (_fn_enum_var(S, TOKVAL(S, ti)) == 1) { return 0; } }
        return 1;
    }
    if (_hl_fn_psid(fi) != 0) { return 0; }
    return _fn_ret_unk(fi);
}

# 6.6.12 — the STATEMENT form, `mk(3).total();` / `mk(3).n;`. PARSE_STMT sends `IDENT (` straight
# to PARSE_FNCALL and never reaches the factor, so `_call_field` above did not run there and the
# `.` was "expected ';'" while `var t = mk(3).total();` worked. Cursor just past the callee IDENT;
# 1 = the statement is consumed through its `;`. One call in PARSE_STMT: that body is near cybs's
# per-function reference limit. A field of a temporary is not an lvalue: refused by name.
# CHANGELOG [6.6.12]
# 6.7.5 (B8): `mk(3).n += 1;` too — refused as `= 1` is, the statement stepped over.
fn _stmt_call_field(S): i64 {
    var sv = _cpf_st;
    var st = GTI(S) - 1;
    _cpf_st = st;   # 6.7.13 (D8 (a)): a field of a `: *T` result is stored through it (`_cpf_try`)
    _cpf_done = 0 - 1;
    var tn = _tsc_n;
    var r = _call_field(S);
    _cpf_st = sv;
    if (r == 0) { return 0; }
    if (_cpf_done == st) { return 1; }   # the store ended the statement
    # 6.7.14: at top level the by-value call refused itself (`_tsc_n` moved): that is the one error, whatever
    # follows (`= v`, `OP= v`, `.p[i] = v`). CHANGELOG [6.7.14]
    if (_tsc_n != tn) { _cst_skip_decl(S); return 1; }
    if (PEEKT(S) == 28) { _stmt_call_sub(S); }   # 6.7.8 (C2-4b): `mk(4).p[i] = v;`
    elif (_asg_pair_at(S) == 1) {
        if (_cf_unres == st) { _synonly_fld_tail(S, 5); return 1; }   # 6.7.15: a sibling's call, not known
        return _asg_temp_refused(S);
    }
    _expect_step(S, 5);
    return 1;
}
# ⛔ 6.7.14 — `callptr(&gp, 5).b = 40;` WAS "expected ';', got '='": a `callptr` statement went to PCMPE, which reads
# `.b` as a value, while `fncall1(&gp, 5).b = 40;` (an IDENT) reaches the call statement's field arms — D8 (a)'s store
# through a `: *T` result, the refusal of a by-value temporary. The same known callee spelled `callptr` (6.7.13's
# D16 (a)) takes that route when the call's `)` is followed by `.name`: 1 = the statement is consumed, 0 = not that
# shape (cursor untouched). Cursor on `callptr`; one call in PARSE_STMT (cybs's per-fn ceiling). CHANGELOG [6.7.14]
fn _stmt_callptr_field(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti + 1) != 10) { return 0; }
    var c = _call_close(S, ti + 1);
    if (TOKTYP(S, c + 1) != 41) { return 0; }
    if (TOKTYP(S, c + 2) != 2) { return 0; }
    STI(S, ti + 1);
    if (_stmt_call_field(S) == 1) { return 1; }
    STI(S, ti);
