# 1 = tokens [a, ie) are a place: `* E`, or a name followed by `.name` / `[..]` steps only.
fn _pd_place(S, a, ie): i64 {
    if (a >= ie) { return 0; }
    if (TOKTYP(S, a) == 8) { return 1; }
    if (TOKTYP(S, a) != 2) { return 0; }
    var i = a + 1;
    while (i < ie) {
        var t = TOKTYP(S, i);
        if (t == 41) {
            if (TOKTYP(S, i + 1) != 2) { return 0; }
            i = i + 2;
        } elif (t == 28) {
            i = _pf_sq_close(S, i) + 1;
        } else {
            return 0;
        }
    }
    if (i == ie) { return 1; }
    return 0;
}
# The refusal at the cursor (the statement's `(`): the place [a, ie), then the operator and value from `e` to the `;`.
fn _pd_err(S, a, ie, e): i64 {
    var m = ": an assignment's destination is not parenthesised - write `";
    if (_err_once(S, (m * 31 + 61) * 8 + 4) == 0) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(m);
    _pd_src(S, GTOFF(S, a), GTOFF(S, ie));
    _pd_src(S, GTOFF(S, e - 1) + 1, GTOFF(S, _pd_semi(S, e)));   # from just past the last `)`, as written
    PRSTR("`\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# The source text from offset b to offset c (trailing blanks dropped).
fn _pd_src(S, b, c): i64 {
    while (c > b) {
        var ch = load8(S + 0x459D000 + c - 1);
        if (ch != 32 && ch != 9 && ch != 10 && ch != 13) { break; }
        c = c - 1;
    }
    if (c > b) { _ew(S + 0x459D000 + b, c - b); }
    return 0;
}
# The statement's `;` at or after token i (depth 0), or the token that ends it first (`}`, EOF).
fn _pd_semi(S, i): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return i; }
        if (t == 10 || t == 13 || t == 28) { d = d + 1; }
        if (t == 11 || t == 14 || t == 29) {
            d = d - 1;
            if (d < 0) { return i; }
        }
        if (t == 5) { if (d == 0) { return i; } }
        i = i + 1;
    }
    return n;
}
# The token after the `.name` / `.m(..)` / `.m<..>(..)` / `[..]` chain that starts at token `i`.
fn _pf_chain_end(S, i): i64 {
    var go = 1;
    while (go == 1) {
        go = 0;
        if (_mchain_at(S, i) == 1) {
            i = _mchain_targs(S, i + 2);
            if (TOKTYP(S, i) == 10) { i = _call_close(S, i) + 1; }
            go = 1;
        } elif (TOKTYP(S, i) == 28) {
            i = _pf_sq_close(S, i) + 1;
            go = 1;
        }
    }
    return i;
}
fn _pf_sq_close(S, i): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 28) { d = d + 1; }
        if (t == 29) {
            d = d - 1;
            if (d == 0) { return i; }
        }
        if (t == 5) { return i; }
        i = i + 1;
    }
    return i;
}
fn _pf_asg_at(S, i): i64 {
    if (TOKTYP(S, i) == 4) { return 1; }
    if (_is_cop_tok(TOKTYP(S, i)) == 0) { return 0; }
    if (TOKTYP(S, i + 1) == 4) { return 1; }
    return 0;
}

# ⛔ 6.6.12 — A `.field` ON A CALL RESULT (`f(mk(p).n)`, `var r = mkp(3).y;`, `mk(p).v.x + 1`)
# parsed nowhere: the factor returned straight after the call and the `.` was a syntax error in
# every expression position. Cursor just past the callee IDENT; 1 = the call and its whole field
# tail are consumed (the value in rax, typed like any field load), 0 = not that shape (cursor
# untouched). In a fn the result lands in a frame temp — the retptr / rax:rdx / rax store of
# `_struct_call_emit`, a `Str` handle in a pointer-mode slot — and the field is loaded from it
# through PARSE_FIELD_LOAD's own body (`_field_load_on`), so chains, widths, signedness, float
# kinds, a method on the result and a struct-typed field as a whole-struct source all match a
# named receiver. At top level there is no frame: refused by name. CHANGELOG [6.6.12]
fn _call_field(S): i64 {
    var ti = GTI(S) - 1;
