# The type name `f32`, whole (not `f32v4`).
fn _is_f32_name(S, noff): i64 {
    if ((L64(S + 0xEC00000 + noff) & 0xFFFFFFFF) == 0x00323366) { return 1; }
    return 0;
}
# The type name `f64`, whole (not `f64v2`).
fn _is_f64_name(S, noff): i64 {
    if ((L64(S + 0xEC00000 + noff) & 0xFFFFFFFF) == 0x00343666) { return 1; }
    return 0;
