    return 0;
}
fn _bx_falloff_fi(S, fi): i64 {
    if (_bx_fn_is_bool(S, fi) == 1) { EMOVI(S, 0); }
    return 0;
}
# An operator overload's right operand is the operator fn's parameter 1 (`p + 5` into
# `fn P_add(self, b: bool)`), as `p.add(5)` passes it — checked the same way. ⛔ 6.7.6 (FE): and
# into an `f32` parameter it ROUNDS, as `_bx_pcmpe_arg` does for `p.add(1.5)` (the decision: every
# write into an f32) — `r + 1.5` passed 1.5's f64 pattern and the callee read its low 32 bits (0).
# The operand is still in rax: `_op_rhs` calls this right after PARSE_TERM.
fn _bx_op_rhs(S, fi, rb): i64 {
    var pk = _pbool_get(fi, 1);
    if (pk == 4) { _IFS_CHECK(S, 1, rb); return 0; }   # 6.7.11: `p + 3` into `b: f64` warns, as `p.add(3)`
    if (pk == 3) { _IFS_CHECK(S, 2, rb); _f32_init_round(S, F32_TYID); return 0; }
    if (pk != 1) { return 0; }
    if (_BX_IS(S) == 1) { return 0; }
    var pn = _bx_pname(S, fi, 1);
    if (pn < 0) { return _bx_refuse(S, rb, "cannot pass a value that is not a bool to a bool parameter of ", _fn_src_name(S, fi, _bx_fname(S, fi)), 0, 0 - 1); }
    return _bx_refuse(S, rb, "cannot pass a value that is not a bool to bool parameter ", pn, " of ", _fn_src_name(S, fi, _bx_fname(S, fi)));
}
# A capture read (`env[k]`): the snapshot carries the enclosing slot's whole depth word, bit 58 too.
fn _cl_cap_load(S, esl): i64 {
    ELOAD64(S);
    if (_cl_snap == 0) { return 0; }
    if (((L64(_cl_snap + _cl_snap_n * 8 + esl * 8) >> 58) & 1) == 1) { _BX_MARK(S); }
    return 0;
}
