    elif (_is_f32_name(S, PEEKV(S)) == 1) { _pbool_set(fi, pc, 3); }   # 6.7.6 (D2): a forward call rounds too
    elif (_is_f64_name(S, PEEKV(S)) == 1) { _pbool_set(fi, pc, 4); }   # 6.7.11: a forward call warns too
