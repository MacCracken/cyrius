    var st = GTI(S) - 1;
    var dot = 0;
    if (PEEKT(S) == 41) { dot = 1; }
    elif (_call_dotted(S, st) == 0) { return 0; }
    var sv = _cpf_st;
    var svs = _cpf_step;
    _cpf_st = st;
    _cpf_step = st;
    _cpf_done = 0 - 1;
    var tn = _tsc_n;
    var r = 1;
    if (dot == 1) { _mcall_last = 0 - 1; PARSE_FIELD_LOAD(S, noff); }
    else { r = _call_field(S); }
