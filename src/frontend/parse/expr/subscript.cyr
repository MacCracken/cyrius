    if (TOKTYP(S, _call_close(S, o) + 1) != 28) { return 0; }
    if (mc == 1) { _mcall_last = 0 - 1; PARSE_FIELD_LOAD(S, noff); }
    elif (o == ti + 1) { PARSE_FNCALL(S, noff); }
    else { _explicit_generic_call(S, noff, FINDFN(S, noff)); }
    _stmt_call_sub(S);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    return 1;
}
# ⛔ 6.7.14 — THE CLASSIC-FOR STEP `gp().n += 1` / `o.gp().n = v` (a field of a call's result, cursor past the first
# name `noff`) is the statement's assignment, ending at the step's `)`: through a `: *T` result it stores through the
# pointer (6.7.13's D8 (a), `_cpf_try` armed with `_cpf_step`), a by-value result is the statement's "the result is
# a temporary", once (the top-level no-frame refusal alone, `_tsc_n`). The step fell to `_for_step_assign` and was
# "expected '=', got '('" (6.7.5's rule: every assignment a statement takes is a step). Twin of `_stmt_call_field`
# and `_stmt_method_call`. 1 = the step, stored or refused; 0 = not that shape, cursor untouched (a step with no `=`,
# `gp().n` or `o.inc()`, keeps "expected '='"). CHANGELOG [6.7.14]
fn _step_call_field(S, noff): i64 {
