        if (t != 2) { if (t != 1) { STI(S, GTI(S) + 1); return _addr_field_val(S); } }
        STI(S, GTI(S) + 2);
        if (PEEKT(S) == 10) { STI(S, _call_close(S, GTI(S)) + 1); }
    }
    return _addr_field_val(S);
}
fn _addr_field_val(S): i64 {
    EMOVI(S, 0);
    SPSC(S, 0);
    return 0;
}
fn _sub_post(S, ti0): i64 {
    var ed = 0;
    if (TOKTYP(S, ti0) == 27) {
        _psub_err(S, ": &a[i] is not supported", 0 - 1, " - write &a + i * sizeof(T) (or p + i)", "", 0);
        _tp_refd_at = GTI(S);   # 6.7.14: its `*T` destination says nothing more (`_tp_warn`)
    } elif (TOKTYP(S, GTI(S) - 1) == 29) {
        _sub_more(S);
    } else {
        var h = _sub_how(S, ti0);
        ed = _psub_ed(S, _sub_word(S, h), h, _sub_name_tok(S, h));
    }
    if (PEEKT(S) == 28) { _psub_addr(S, ed); }
    if (ed != 0) { _esub_load(S, ed); }
    else {
        EMOVI(S, 0);
        SPSC(S, 0);
        SESTYPE(S, 0);
        SEXW(S, 0);
        _cfo = 0;
    }
    _sub_more(S);
    return 0;
}
# A statement's or a step's `f(..)[i] = v`, `g<T>(..)[i] OP= v`, `o.m(..)[i] = v`, `mk(4).p[i] = v`
# (rax = the call's result or the field's value, cursor on `[`): the element's `= v` / `OP= v`, the
# terminator left to the caller.
fn _stmt_call_sub(S): i64 {
    var h = _sub_how(S, 0 - 1);
    var nt = _sub_name_tok(S, h);
    var ed = _psub_ed(S, _sub_word(S, h), h, nt);
    _psub_addr(S, ed);
    EPUSHR(S);            # the element's address
    _esub_assign(S, ed, TOKVAL(S, nt));
    return 0;
}
# The classic-for step `f(..)[i] OP= v` / `g<T>(..)[i] = v` / `o.m(..)[i] = v` (cursor past the first
# name `noff`): 1 when it is one — parsed through its `)` — else 0, cursor untouched (a bare call
# keeps "expected '='").
fn _step_call_sub(S, noff): i64 {
    var ti = GTI(S) - 1;
    var o = _gcall_open(S, ti);
    var mc = 0;
    if (o < 0) {
        if (PEEKT(S) != 41) { return 0; }
        var d = GTI(S);
        mc = _stmt_dot_chain_call(S);
        o = GTI(S);
        STI(S, d);
        if (mc == 0) { return 0; }
