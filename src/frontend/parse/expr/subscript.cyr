# 1 = the step from the cursor to the for's `)` holds an `=` outside parentheses: an assignment (`=` or `OP =`).
# Inside parentheses anything may stand (an argument's closure, its `{ .. ; }`).
fn _step_asg_at(S): i64 {
    var i = GTI(S);
    var d = 0;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 10) { d = d + 1; }
        elif (t == 11) {
            if (d == 0) { return 0; }
            d = d - 1;
        }
        elif (t == 12) { return 0; }
        elif (d == 0) {
            if (t == 4) { return 1; }
            if (t == 13 || t == 5) { return 0; }
        }
        i = i + 1;
    }
    return 0;
}

# The three factor arms below live out of _PARSE_FACTOR_IMPL, whose body sits at cybs's silent
# per-fn reference ceiling: each is one call there, so C2's subscript, `*p` and step-word work
# grows these and not the giant. Each emits exactly what its inline arm emitted; moving them out
# also took the giant under the per-fn NOP compactor's 1024-entry caps (`_nrn` / `_jsn`,
# parse/fn/def.cyr), so its last 499 NOPs are harvested (cycc .text -1,680 B). CHANGELOG [6.7.8]

# v5.8.15 §7: the slice subscript `s[i]` as a value, for the slice-typed local `li`. _slice_lw
# returns the element byte-width captured at PARSE_VAR time (v5.8.14 §6); 0 means not a slice.
# If `[` follows the ident AND this is a slice local, lower to `_slice_idx_get_W(&local, i)` —
# the bounds-checked sized load via the helper that matches the element width. 1 when consumed;
# 0 (cursor untouched) otherwise. An [i8] / [i16] / [i32] element is read by `_slice_sub_sread`.
fn _slice_sub_read(S, li): i64 {
    var sw = _slice_lw(S, li);   # 6.7.8 (C2-2a): behind the slice bit (a stale width is no slice)
    if (sw > 0) { if (PEEKT(S) == 28) {
            if (_ek_lw(_slice_led(S, li)) < 0) { return _slice_sub_sread(S, li); }   # 6.7.8 (C2-6c)
            if (_slice_rd_w(sw) == 0) { return _slice_rd_wide(S, li, sw); }   # 6.7.16: a 12- / 24-byte element
            var tb = GTI(S);
            var bk = _bck_open(S, 0 - 2);   # 6.7.8 (C2-8): the bounds check, against s.len
            STI(S, GTI(S) + 1);  # consume [
            # Push &local as first arg (helper takes slice address)
            # 6.7.8: the frame base is raw bytes on x86 (no IR node of its own), so a CYRIUS_IR=3
            # pass took rax for the index variable stored just before (`var i = 2; s[i]` passed
            # &s as the index: exit 134) — marked, as `_arr_sub_addr` marks its base. CHANGELOG [6.7.8]
            _IR_REC0(S, IR_RAW_EMIT);
            EFLADDR(S, li);
            EPUSHR(S);
            # Parse index expression — leaves idx in rax
            PCMPE(S);
            if (bk == 1) { _bck_site(S, tb, 0 - 2, li); }
            EPUSHR(S);
            # Look up and call the width-specific helper.
            # Helpers live in lib/slice.cyr; consumer must
            # `include "lib/slice.cyr"` (or pull via deps).
            var idx_fn = 0 - 1;
            if (sw == 1)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_1",  16); }
            if (sw == 2)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_2",  16); }
            if (sw == 4)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_4",  16); }
            if (sw == 8)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_8",  16); }
            if (sw == 16) { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_16", 17); }
            if (idx_fn < 0) {
                ERR_MSG(S, "slice subscript requires include \"lib/slice.cyr\" (provides _slice_idx_get_W helpers)", 84);
            }
            ECALLPOPS(S, 2);
            # ERR_MSG does not exit: -1 must not reach ECALLFIX (rc 139 on aarch64/cx
            # after the diagnostic). The pops/clean stay so push depth balances. CHANGELOG [6.6.9]
            if (idx_fn >= 0) { ECALLFIX(S, idx_fn); }
            ECALLCLEAN(S, 2);   # 6.6.5: was missing — leaked Win64's 32 B shadow
            # Result in rax. Set expression-width tracking so
            # narrowing assignment warnings work for u8/u16/u32.
            SEXW(S, sw);
            # ⛔ The element is an untyped word and the factor's whole result: what the INDEX
            # left behind must not describe it — exactly `_arr_sub_read`'s resets. A constant
            # index armed the constant folder (`_cfo`/`_cfp`), so `s[0] + 10` folded `0 + 10`
            # and rewound the code to the index's load — the helper call's fixup then patched
            # the return's jump (exit 134 / SIGSEGV); a `*T` index's step scaled `s[p] + 1`,
            # a typed index's estype could dispatch an operator. CHANGELOG [6.7.8]
            SPSC(S, 0);
            SESTYPE(S, 0);
            _cfo = 0;
            if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
            STI(S, GTI(S) + 1);  # consume ]
            return 1;
        } }
    return 0;
}
# 1 = lib/slice.cyr has a `_slice_idx_get_W` for an element of `sw` bytes.
fn _slice_rd_w(sw): i64 {
    if (sw == 1 || sw == 2 || sw == 4 || sw == 8 || sw == 16) { return 1; }
    return 0;
}
# ⛔ 6.7.16 — A SLICE ELEMENT OF ANY OTHER WIDTH IS REFUSED BY NAME. The read calls `_slice_idx_get_W`, which exists for a
# 1-, 2-, 4-, 8- and 16-byte element only, so a 12- or 24-byte one (`[P3]`; since D89 a generic instance, `[Box<Pt>]`,
# `[W<i32>]`) was the false "slice subscript requires include "lib/slice.cyr"" with the include there. Now the width is
# named at the `[` (the store's words, `_slice_sub_addr`), and the subscript stepped in sync. CHANGELOG [6.7.16]
fn _slice_rd_wide(S, li, sw): i64 {
    _sub_wide_err(S, L64(S + 0x5D9D000 + li * 8), sw);
    STI(S, GTI(S) + 1);  # consume [
    PCMPE(S);
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);  # consume ]
    SPSC(S, 0);
    SESTYPE(S, 0);
    _cfo = 0;
    return 1;
}
fn _sub_wide_err(S, noff, sw): i64 {
    if (_panic == 1) { return 0; }
    _refuse_in_sync(S);
    if (_derr_seen(GTI(S), "_sub_wide_err", noff * 31 + sw, 1) == 1) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": cannot subscript '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("': a slice subscript reads a 1-, 2-, 4-, 8- or 16-byte element - this one is ");
    PRNUM(sw);
    PRSTR(" bytes: read at slice_ptr(&s) + i * sizeof(T)\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# ⛔ 6.7.8 (C2-6c) — A SIGNED SLICE ELEMENT IS READ SIGN-EXTENDED (the user's decision, 2026-10-10).
# `s[i]` on an [i8] / [i16] / [i32] (or slice<i8> ..) slice called `_slice_idx_get_1/2/4`, whose
# load8 / load16 / load32 ZERO-extend: a stored -3 read 253 and `s[0] < 0` was false — unlike the
# same bytes in an `i8[N]` array, through a `*i8` or in an i8 field, which sign-extend. The element's
# address now comes from the store's checked call (`_slice_sub_addr`: lib/slice.cyr's
# `_slice_idx_addr(&s, i, sizeof(T))`, the same "slice bounds violation" / 134 check) and is loaded
# by `_esub_load` — EFIELD_LOAD_W at the negative width (movsx / ldrsb / shl+asr on cx, recorded for
# the IR pass) with the read's resets (C2-1b) — so `s[i] OP= v` (which loads by `_esub_assign`) and
# `s[i]` read one value. Cursor at `[` after the name; always 1. Every other element (unsigned,
# i64, f64 / f32 / bool, a pointer, u128) keeps its getter, byte for byte. CHANGELOG [6.7.8]
fn _slice_sub_sread(S, li): i64 {
    var ed = _slice_sub_addr(S, li, TOKVAL(S, GTI(S) - 1));
    if (ed != 0) { _esub_load(S, ed); }   # 0: lib/slice.cyr is missing, already reported
    return 1;
}
# ⛔ 6.7.8 (C2-6a) — A SLICE ELEMENT STORE: `s[i] = v`, `s[i] OP= v` and the classic-for step on a
# slice local (`var s: [T]` / `slice<T>`), which was refused ("cannot subscript 's'"; by name since
# C2-4a), so the spelling was `store8(slice_ptr(&s) + i, v)`. Cursor at `[` (from `_arr_sub_addr`):
# consumes `[ idx ]` and leaves rax = the element's address from lib/slice.cyr's
# `_slice_idx_addr(&s, i, sizeof(T))`, which checks i against s.len exactly as the reads do — out
# of range is "slice bounds violation", exit 134, in EVERY mode (the decision checks "slice reads
# AND writes"; an unchecked write beside the checked read would be the one unchecked slice
# operation). Returns the descriptor `_esub_assign` stores by — an f64 into an f32 element rounds,
# a bool element takes only a boolean, an integer constant into a float warns, a wider integer
# into a narrow one warns — sign included, so `OP=` loads an [i8] / [i16] / [i32] element
# sign-extended, as `s[i]` reads it (C2-6c: `_slice_sub_sread` reads through this call). 0 after a
# refusal by name: a struct / u128 element, and `OP=` on an f64 / f32 / bool element (the slice
# read is an untyped word, so a float `OP=` would disagree with `s[i] = s[i] op v`). CHANGELOG [6.7.8]
fn _slice_sub_addr(S, li, noff): i64 {
    var ed = _slice_led(S, li);
    var w = _ek_w(ed);
    var fi = 0 - 1;
    if (w == 0 || w > 8) {
        _sub_err(S, noff, ": a slice element store takes an integer, f64, f32, bool or pointer element",
          " - this one is a struct or u128: store at slice_ptr(&s) + i * sizeof(T)", 0 - 1);
        ed = 0;
    } else {
        fi = _FINDFN_CSTR(S, "_slice_idx_addr", 15);
        if (fi < 0) {
            ERR_MSG(S, "slice subscript requires include \"lib/slice.cyr\" (provides _slice_idx_get_W helpers)", 84);
            ed = 0;
        }
    }
    var tb = GTI(S);
    var bk = 0;
    if (ed != 0) { bk = _bck_open(S, 0 - 2); }   # 6.7.8 (C2-8): the bounds check, against s.len
    STI(S, GTI(S) + 1);       # consume [
    if (ed != 0) {
        _IR_REC0(S, IR_RAW_EMIT);   # the frame base is raw bytes on x86 (as the read marks it)
        EFLADDR(S, li);       # &s, then the index, then sizeof(T): the read's call pattern
        EPUSHR(S);
    }
    PCMPE(S);                 # rax = the index
    if (ed != 0) {
        if (bk == 1) { _bck_site(S, tb, 0 - 2, li); }
        EPUSHR(S);
        EMOVI(S, w);
        EPUSHR(S);
        ECALLPOPS(S, 3);
        ECALLFIX(S, fi);
        ECALLCLEAN(S, 3);     # rax = the element's address, checked
    }
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);       # consume ]
    if (_ek_fk(ed) != 0) { if (PEEKT(S) != 4) { if (_asg_pair_at(S) == 1) {
                _sub_err(S, noff, ": a compound assignment on an f64, f32 or bool slice element is not supported",
                  " - the slice read is an untyped word; write s[i] = v", 0 - 1);
                return ed;   # the operand still parses as the element's kind: nothing more is reported
            } } }
    return ed;
}

# ⛔ 6.7.8 (C2-8) — THE BOUNDS CHECK (the user's decision, 2026-10-10: "Checked under the mode: typed
# arrays a[i] against their exact N; slice reads AND writes; a *T subscript checked for a NEGATIVE
# index only (slice<T> is the checked spelling — no extent exists for a *T). Raw load*/store*(&a + e)
# stay unchecked. A constant index provably out of range WARNS in every mode and is an ERROR under the
# mode. @unsafe { } turns checks off inside it."; a violation "prints `bounds: index N out of [0,
# LEN) at <file>:<line>` to stderr and exits 134"). Every subscript the language has passes through
# one of four places — `_arr_sub_addr` (a named array or `*T`), `_psub_addr` (a `*T` field or call),
# `_slice_sub_read` and `_slice_sub_addr` (a slice) — and each asks `_bck_open` at its `[` and, when
# told to, emits `_bck_site` once the index is in rax (before it is scaled): a call into the checker
# the preprocessor injected (lex/pp/preprocess.cyr `_bnd_finish`), which hands the index back. `<line>` is the
# line of the `[` token itself, so an `#inline` replay, a `defer` replay, a generic instance and a
# classic-for step all name the line the subscript is WRITTEN on; `<file>` is the name every cycc
# diagnostic uses (`<source>` for the entry), interned once per file. `@unsafe` is LEXICAL — a `[`
# inside an `@unsafe { }` token range — so a checked `#inline` fn replayed inside one keeps its check.
# A constant index (literals, `+ - *`, parentheses, names that resolve as the factor resolves them to
# an integer const or an enum constant) is judged here with no code emitted: provably in range, no
# check; out of range, a warning in every mode — an error under the mode outside `@unsafe`. A `#naked`
# fn cannot make the call: a checked subscript in one is refused by name. With the mode off nothing
# is emitted. CHANGELOG [6.7.8]
var _bck_fi = 0 - 2;    # __cyrius_bounds_chk's fn index (-2: not looked up yet)
var _bck_fis = 0 - 2;   # __cyrius_bounds_chks's
var _bck_ur = 0;        # the `@unsafe { }` token ranges: [first, last] pairs, outermost, in order
var _bck_un = 0 - 1;    # their count (-1: not scanned yet)
var _bck_fs = 0;        # file-name offset -> string-pool offset pairs (one string per file)
var _bck_fsn = 0;
var _bck_line = 0;      # `_bck_file`'s second result: the line within the file
var _bck_cok = 0;       # `_bck_ceval`'s second result: 1 when the value is an integer constant

# The exact N of the array a named subscript resolved (k / ix as `_arr_sub_addr` resolved them):
# behind a nonzero descriptor a stack local's named slot holds `0 - 2^48 - N`, a capture's snapshot
# the same word, a global's (and a static-fallback local's) GVSGN `N << 16` (C2-3b).
fn _bck_alen(S, k, ix, noff): i64 {
    if (k == 1) { return 0 - GSLICE_W(S, ix) - 0x1000000000000; }
    if (k == 2) {
        var esl = _cl_snap_find(S, noff);
        if (esl < 0) { return 0; }
        return 0 - L64(_cl_snap + _cl_snap_n * 24 + esl * 8) - 0x1000000000000;
    }
    return (GVSGN(S, ix) >> 16) & 0xFFFFFFFF;
}
# Cursor at a subscript's `[` (`n` an array's N, -1 a `*T`, -2 a slice): 1 when a run-time check is
# to be emitted for it — the mode is on, the index is no provable constant, the `[` is outside every
# `@unsafe` block. The constant rule runs in every mode.
fn _bck_open(S, n): i64 {
    var ti = GTI(S);
    var c = _bck_cidx(S, ti, n);
    if (_bnd_mode == 0) { return 0; }
    if (c != 0) { return 0; }
    if (_bck_unsafe_at(S, ti) == 1) { return 0; }
    if (_cur_fn_naked == 1) {   # R14: by name, once (a generic instance re-parses it), no cascade
        var m14 = "the bounds check is a call, which a #naked fn cannot make - wrap the access in @unsafe { }";
        if (_tn_once(S, ti) == 1) {
            _bnd_errm_at(S, ti, m14, 90);
            _panic = 0;
        }
        return 0;
    }
    return 1;
}
# The check, with rax = the index (the `[` at token tb; `n` as above; `li` the slice local, else -1):
# `__cyrius_bounds_chk(i, n, file, line)` / `__cyrius_bounds_chks(i, &s, file, line)`, which returns
# the index — the slice read's call pattern (the pushes balanced by ECALLPOPS / ECALLCLEAN, so Win64's
# shadow space and the aarch64 / SysV alignment come from them; every emit IR-recorded).
fn _bck_site(S, tb, n, li): i64 {
    var fi = _bck_fi;
    if (li >= 0) { fi = _bck_fis; }
    if (fi == 0 - 2) {
        _bck_fi = _FINDFN_CSTR(S, "__cyrius_bounds_chk", 19);
        _bck_fis = _FINDFN_CSTR(S, "__cyrius_bounds_chks", 20);
        fi = _bck_fi;
        if (li >= 0) { fi = _bck_fis; }
    }
    if (fi < 0) { ERR_MSG(S, "the bounds-checked mode's checker is missing (an internal error)", 64); }
    EPUSHR(S);            # the index
    if (li >= 0) {
        _IR_REC0(S, IR_RAW_EMIT);   # the frame base is raw bytes on x86 (as the slice read marks it)
        EFLADDR(S, li);
    } else { EMOVI(S, n); }
    EPUSHR(S);
    ESADDR(S, _bck_file(S, tb));
    EPUSHR(S);
    EMOVI(S, _bck_line);
    EPUSHR(S);
    ECALLPOPS(S, 4);
    if (fi >= 0) { ECALLFIX(S, fi); }
    ECALLCLEAN(S, 4);     # rax = the index again
    _cfo = 0;             # a constant folder armed by the index must not rewind past the call
    _flags_reflect_rax = 0;
    return 0;
}
# The string-pool offset of the name of the file holding token tb (its line in `_bck_line`), the
# name copied into the pool once per file — the lexer is done, and every backend reads the pool at
# fixup time.
fn _bck_file(S, tb): i64 {
    var foff = FM_SITE(S, GTLINE(S, tb));
    _bck_line = _fm_site_line;
    if (_bck_fs == 0) { _bck_fs = alloc(2048 * 16); }
    var i = 0;
    while (i < _bck_fsn) {
        if (L64(_bck_fs + i * 16) == foff) { return L64(_bck_fs + i * 16 + 8); }
        i = i + 1;
    }
    var nm = "<source>";
    if (foff >= 0) { nm = S + 0x721000 + foff; }
    var n = 0;
    while (load8(nm + n) != 0) { n = n + 1; }
    var so = GSPOS(S);
    if (so + n + 1 > 2097152) {
        _ew("error: string data overflow (2MB limit)\n", 40);
        _die(1);
    }
    var k = 0;
    while (k <= n) { store8(S + 0x21A000 + so + k, load8(nm + k)); k = k + 1; }
    SSPOS(S, so + n + 1);
    if (_bck_fsn < 2048) {
        S64(_bck_fs + _bck_fsn * 16, foff);
        S64(_bck_fs + _bck_fsn * 16 + 8, so);
        _bck_fsn = _bck_fsn + 1;
    }
    return so;
}
# 1 when token ti lies inside an `@unsafe { }` block (its `@unsafe` through its `}`). The ranges are
# found once, at the first question, by pairing each `@unsafe {` with its `}`.
fn _bck_unsafe_at(S, ti): i64 {
    if (_bck_un < 0) { _bck_unsafe_scan(S); }
    var lo = 0;
    var hi = _bck_un;
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        if (ti < L64(_bck_ur + mid * 16)) { hi = mid; }
        elif (ti > L64(_bck_ur + mid * 16 + 8)) { lo = mid + 1; }
        else { return 1; }
    }
    return 0;
}
fn _bck_unsafe_scan(S): i64 {
    var n = GTCNT(S);
    var c = 0;
    var i = 0;
    while (i < n) { if (TOKTYP(S, i) == 123) { c = c + 1; } i = i + 1; }
    _bck_ur = alloc(c * 16 + 16);
    _bck_un = 0;
    i = 0;
    while (i < n) {
        if (TOKTYP(S, i) == 123) { if (TOKTYP(S, i + 1) == 13) {
                var d = 0;
                var j = i + 1;
                while (j < n) {
                    var t = TOKTYP(S, j);
                    if (t == 13) { d = d + 1; }
                    if (t == 14) { d = d - 1; if (d == 0) { break; } }
                    j = j + 1;
                }
                S64(_bck_ur + _bck_un * 16, i);
                S64(_bck_ur + _bck_un * 16 + 8, j);
                _bck_un = _bck_un + 1;
                i = j;   # a nested block lies inside this range
            } }
        i = i + 1;
    }
    return 0;
}
# The constant rule at the `[` at token ti (`n` as `_bck_open`'s): 0 the index is no provable
# constant, 1 a constant provably in range (no check — a slice's length is known at run time only),
# 2 a constant out of range, reported. Nothing is emitted and the cursor is left where it was.
fn _bck_cidx(S, ti, n): i64 {
    if (_bck_cscan(S, ti + 1) == 0) { return 0; }
    var v = _bck_ceval(S, ti + 1);
    if (_bck_cok == 0) { return 0; }
    var o = 0;
    if (v < 0) { o = 1; }
    if (n >= 0) { if (v >= n) { o = 1; } }
    if (o == 0) {
        if (n == 0 - 2) { return 0; }
        return 1;
    }
    _bck_creport(S, ti, v, n);
    return 2;
}
# 1 when the tokens from j to the subscript's `]` are only integer literals, `+ - *`, parentheses and
# names `_bck_cname` takes — a shape the const evaluator computes without reporting anything.
fn _bck_cscan(S, j): i64 {
    var n = GTCNT(S);
    var d = 0;
    var any = 0;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 29) {
            if (d == 0) { return any; }
            return 0;
        }
        if (t == 10) { d = d + 1; }
        elif (t == 11) { d = d - 1; if (d < 0) { return 0; } }
        elif (t == 1) { any = 1; }
        elif (t == 2) {
            if (_bck_cname(S, j) == 0) { return 0; }
            any = 1;
        } elif (t != 6 && t != 7 && t != 8) { return 0; }
        j = j + 1;
    }
    return 0;
}
# 1 when the name at token j resolves — in the factor's own order: a local const, a local, a capture,
# then a top-level const and an enum constant — to an integer constant.
fn _bck_cname(S, j): i64 {
    if (TOKTYP(S, j + 1) == 10) { return 0; }   # a call
    var noff = TOKVAL(S, j);
    var lc = _lc_find(S, noff);
    if (lc >= 0) {
        if (L64(_lc_tab + lc * 48 + 24) == 0) { return 1; }
        return 0;
    }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) { if (_cl_snap_find(S, noff) >= 0) { return 0; } } }
    var ci = _cst_find(S, noff);
    if (ci >= 0) {
        if (_cst_kind_peek(S, ci) == 0) { return 1; }
        return 0;
    }
    var vi = _findvar_core(S, noff);
    if (vi >= 0) { if (GVECP(S, vi) == 1) { return 1; } }
    return 0;
}
# The value of the constant index at token j (`_bck_cscan` passed it), computed by the const
# evaluator with the cursor and its latches put back; `_bck_cok` 1 when it is an integer and ends at
# the `]`.
fn _bck_ceval(S, j): i64 {
    var sv = GTI(S);
    var se = _ce_err;
    var sk = _ce_k;
    var ss = _ce_steps;
    STI(S, j);
    var v = _ce_eval_here(S);
    _bck_cok = 0;
    if (_ce_err == 0) { if (_ce_k == 0) { if (PEEKT(S) == 29) { _bck_cok = 1; } } }
    STI(S, sv);
    _ce_err = se;
    _ce_k = sk;
    _ce_steps = ss;
    return v;
}
# A constant index out of range, at its `[` (token ti): an error under the mode outside `@unsafe`,
# a warning otherwise; once per token (a generic instance and an `#inline` replay re-parse it);
# silent under --syntax-only.
fn _bck_creport(S, ti, v, n): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var er = 0;
    if (_bnd_mode == 1) { if (_bck_unsafe_at(S, ti) == 0) { er = 1; } }
    var sv = GTI(S);
    STI(S, ti);
    if (er == 1) { _ew("error:", 6); }
    else { _ew("warning:", 8); }
    _err_head(S);
    PRSTR(": index ");
    PRNUM(v);
    if (n >= 0) {
        PRSTR(" is out of range [0, ");
        PRNUM(n);
        PRSTR(") for '");
    } else { PRSTR(" is negative for '"); }
    var nt = ti - 1;
    if (TOKTYP(S, nt) == 11) { nt = _sub_name_tok(S, 2); }
    if (TOKTYP(S, nt) == 2) { PRSTR(S + 0xEC00000 + TOKVAL(S, nt)); }
    else { PRSTR(TOKNAME(TOKTYP(S, nt))); }
    PRSTR("'");
    if (er == 0) { PRSTR(" (an error under the bounds-checked mode)"); }
    else { PRSTR(" (the bounds-checked mode; inside @unsafe { } it is a warning)"); }
    _ew("\n", 1);
    _err_excerpt(S);
    STI(S, sv);
    if (er == 1) { _had_error = 1; }
    return 0;
}
