# rax = the base's value (a `*T`), cursor on `[`: consumes `[ idx ]` and leaves rax = base + idx *
# sizeof(T), the base pushed while the index is evaluated. `ed` 0 (a refused base): the index is
# only parsed. Returns ed.
fn _psub_addr(S, ed): i64 {
    var tb = GTI(S);
    var bk = 0;
    if (ed != 0) {
        EPUSHR(S);
        bk = _bck_open(S, 0 - 1);   # 6.7.8 (C2-8): a `*T` — a negative index only
    }
    STI(S, GTI(S) + 1);   # consume [
    PCMPE(S);
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);   # consume ]
    if (ed == 0) { return 0; }
    if (bk == 1) { _bck_site(S, tb, 0 - 1, 0 - 1); }
    EPTR_SCALE(S, _ek_w(ed));
    EPOPC(S);
    EADDR(S);
    return ed;
}
# A second `[` after a subscript (`a[i][j]`, `f()[i][j] = v`): refused by name, consumed.
fn _sub_more(S): i64 {
    while (PEEKT(S) == 28) {
        _psub_err(S, ": a subscript's result is an element, not an array", 0 - 1,
          " - a second [..] is not supported", "", 0);
        _psub_addr(S, 0);
    }
    return 0;
}
# The PARSE_FACTOR wrapper's postfix `[` (the factor began at token ti0): a `*T` field's or call's
# element read; every other factor refused by name — `&a[i]` (an address is no base), `a[i][j]`,
# `(expr)[i]`, a literal.
# ⛔ 6.7.13 — `&x.f` IS NOT CYRIUS: THE ADDRESS OF A FIELD IS NOT TAKEN (the user's D3 (b), 2026-10-15; issues/
# 2026-10-14-address-of-field-does-not-parse-guide-cites-it.md). The `&` factor takes `&x` and stopped at the `.`,
# so the parse failed on the token after it ("expected ')', got '.'") with no word of why. The factor at `ti0` an
# `&` with a `.` next: refused by name once, as `&a[i]` is (`_sub_post`), its `.f` / `.0` / `.m(..)` steps
# consumed so the parse stays in step; rax 0. `&E.A` keeps its own refusal (the `&` arm consumed `.A`).
fn _addr_field_post(S, ti0): i64 {
