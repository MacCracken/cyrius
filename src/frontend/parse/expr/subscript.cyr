# PARSER — expr: subscripts — `a[i]` reads, stores and addresses on arrays, pointers and slices (`_arr_sub_*`, `_sub_*`,
# `_slice_sub_*`) — and the bounds checks (`_bck_*`).
# ================================================================
# Split from parse/expr.cyr at 6.7.18, unchanged; parse.cyr includes parse/expr/ in source order. CHANGELOG [6.7.18]

# ⛔ 6.6.12 — THE ARRAY SUBSCRIPT, `a[i]`, `a[i] = v` and `a[i] OP= v`, on an INTEGER
# element-typed array `var a: T[N]` (T = i8..i64 / u8..u64), local or global, in any fn, at
# top level, in a closure (on its captured copy) and in an `async fn`. The language had no
# subscript at all: `return a[1];` was `expected ';', got '['` and `a[i] = 5;` was
# `expected '=', got '['`, so the only spelling was `store64(&a + i * 8, v)`. `a[i]` IS
# that: the element at `&a + i * sizeof(T)`, loaded sign- or zero-extended by T, stored at
# T's width. No bounds check (the opt-in checked mode is a separate item). A bare `var a[N]`
# states no element width (bytes in a fn, slots at top level), so its subscript is REFUSED by
# name rather than guessed; a slice local keeps its own bounds-checked `s[i]` (below, in the
# factor). CHANGELOG [6.6.12]
# ⛔ 6.7.8 (C2-4a) — `p[i]` ON A `*T`, AND f64 / f32 / bool ELEMENTS (the user's decision,
# 2026-10-10: "p[i] reach: integer, f64, f32 and bool elements"). A typed pointer named by a local,
# a `p: *T` parameter, a closure capture or a global subscripts as an array does — the element at
# `p + i * sizeof(T)`: the pointer's VALUE is the base where an array's address is — and `var a:
# f64[N]` / `f32[N]` / `bool[N]` (refused by name until now) take `a[i]` too. The element's
# descriptor (`_ek_*`, parse/decl/array.cyr: an array's from its declaration, a pointer's from the step
# word, `_ps_word`) types the value as a declared T would be (`_esub_load`: an f64, an f32's 4
# bytes, a boolean value, an iN sign-extended) and checks a store as a field of T is checked
# (`_esub_assign`: an f64 into an f32 rounds, a non-bool into a bool is refused, an integer
# constant into a float warns). Every other name is refused by name (`_sub_refuse`). The index is
# still evaluated first, so every existing `a[i]` emits the bytes it did. CHANGELOG [6.7.8]
#
# Cursor at `[` after NAME: consumes `[ idx ]` and leaves rax = &NAME[idx]. Returns the element's
# descriptor (`_ek_lw` the load width, negative when signed; `_ek_fk` its float / bool kind); 0
# after a diagnostic. The base is resolved as `&NAME` resolves it: a local, a closure capture,
# then a global.
fn _arr_sub_addr(S, noff): i64 {
    var k = 0;
    var ix = 0 - 1;
    var d = 0;
    var pw = 0;   # a typed pointer's step word (6.7.8), 0 for an array
    if (GINFN(S) == 1) {
        ix = FINDLOCAL(S, noff);
        if (ix >= 0) { k = 1; d = GLAEW(S, ix); pw = _slot_ptr_word(S, ix); }
    }
    if (k == 1) { if (_slice_lw(S, ix) > 0) { return _slice_sub_addr(S, ix, noff); } }   # 6.7.8 (C2-6a): a store
    if (k == 0) { if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) {
                var esl = _cl_snap_find(S, noff);
                if (esl >= 0) {
                    ix = _cl_cap_find(esl);
                    if (ix >= 0) { k = 2; d = _cl_snap_aew(esl); pw = _cl_snap_ptr_word(esl); }
                }
            } } }
    if (k == 0) {
        ix = FINDVAR(S, noff);
        if (ix >= 0) { k = 3; d = _arr_gdesc(S, ix); pw = _gv_ptr_word(S, ix); }
    }
    if (pw > 0) { d = (pw >> 40) & 0xFF; }   # a `*T`: T's descriptor rides the step word
    var aw = _ek_w(d);
    if (k == 0) {
        if (_syntax_only == 0) { if (_cst_sub_at(S, noff) == 0) { if (_sub_undef_said(S, noff) == 0) {   # 6.7.14
                    _refuse_in_sync(S);   # 6.7.16: each refusal here is in sync — the brackets are parsed on
                    _undef_ident_at(S, _nm_ti(S, GTI(S) - 1, noff), noff, " (missing include or enum?)");   # 6.7.17: at the name
                    _gv_note_blockscoped(S, noff);
                } } }   # 6.7.16: a local const (`_cst_sub_at`)
        aw = 0;
    } elif (aw == 0) {
        _sub_refuse(S, noff, k, ix, d, pw);
    } elif (aw > 8) {
        _refuse_in_sync(S);
        ERR_IDENT(S, "cannot subscript ", noff, ": a u128 element does not fit one register - use load64/store64 on its two halves", 0 - 1);
        aw = 0;
    }
    var tb = GTI(S);      # 6.7.8 (C2-8): the bounds check — an array's exact N, a `*T`'s none
    var bn = 0 - 1;
    var bk = 0;
    if (aw != 0) {
        if (pw <= 0) { bn = _bck_alen(S, k, ix, noff); }
        bk = _bck_open(S, bn);
    }
    STI(S, GTI(S) + 1);   # consume [
    PCMPE(S);             # rax = the index
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);   # consume ]
    if (aw == 0) { return 0; }
    if (bk == 1) { _bck_site(S, tb, bn, 0 - 1); }
    EPTR_SCALE(S, aw);    # rax = index * sizeof(T)
    EPUSHR(S);
    # The frame and capture bases are raw bytes on x86 (no IR node of their own); mark them so
    # a CYRIUS_IR pass cannot take rax for the scaled index across them. EVADDR records itself.
    if (k != 3) { _IR_REC0(S, IR_RAW_EMIT); }
    if (k == 1) {
        if (pw > 0) { EFLLOAD(S, ix); } else { EFLADDR(S, ix); }
    } elif (k == 2) {
        _CL_CAP_WORDS_RA(S, ix);
        if (pw > 0) { ELOAD64(S); }   # the captured pointer's value
    } else {
        if (pw > 0) { EVLOAD(S, ix); } else { EVADDR(S, ix); }
    }
    EPOPC(S);
    EADDR(S);             # rax = base + index * sizeof(T)
    return d;
}
# The refusals of `NAME[i]` for a name whose element no subscript loads (k / ix / d / pw as
# `_arr_sub_addr` resolved them): each by name at the `[`, the brackets then consumed. 6.7.8 (C2-4a)
fn _sub_refuse(S, noff, k, ix, d, pw): i64 {
    if (_ce_fld_said(S) == 1) { return 0; }   # 6.7.15: a refused const fn's body (`_ce_sub_refused`)
    if (_cst_sub_at(S, noff) == 1) { return 0; }   # 6.7.16: a top-level const's size-0 slot
    var el = ": a subscript takes an integer, f64, f32 or bool element";
    if (pw > 0) {
        var sid = _sub_ptr_sid(S, noff, k, ix);
        if (sid > 0) {
            return _sub_err(S, noff, el, " - step with p + i to an element of struct ", _ei_sid(sid));
        }
        return _sub_err(S, noff, el, " - its element is a pointer, string, enum or vector; load at p + i", 0 - 1);
    }
    if (d != 0) {
        return _sub_err(S, noff, el,
          " - its element is a struct, pointer, enum, string or vector; use &a + i * sizeof(T)", 0 - 1);
    }
    var t = " (T an integer, f64, f32 or bool), or load / store at an explicit byte offset";
    if (_sub_bare(S, noff, k, ix) == 1) {
        return _sub_err(S, noff, ": a bare `var a[N]` states no element width - declare `var a: T[N]`", t, 0 - 1);
    }
    if (k == 2) { if (_sub_cslice(S, noff) == 1) {   # 6.7.8 (C2-6a): a captured slice (R12)
            return _sub_err(S, noff, ": a slice is a fn-local - a closure cannot subscript a captured slice",
              " (pass slice_ptr(&s) / slice_len(&s) into it, or declare the slice in the closure)", 0 - 1);
        } }
    return _sub_err(S, noff, ": it is not a typed array, a *T or a slice local - declare `var a: T[N]` or `p: *T`",
      t, 0 - 1);
}
# `cannot subscript 'NAME'` + `a` + `b` (+ `'N2'` when `n2` >= 0), at the cursor — ERR_IDENT's
# line, with its tail in two literals. In sync: every caller parses the brackets on (6.7.16).
fn _sub_err(S, noff, a, b, n2): i64 {
    if (_panic == 1) { return 0; }
    _refuse_in_sync(S);
    if (_derr_seen(GTI(S), "_sub_err", ((noff * 31 + a) * 31 + b) * 31 + n2, 1) == 1) { return 0; }   # 6.7.15: once
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": cannot subscript '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("'");
    PRSTR(a);
    PRSTR(b);
    if (n2 >= 0 || n2 <= 0 - 1000) {   # 6.7.17: or a struct (`_ei_sid`)
        PRSTR("'");
        _ei_pr(S, n2);
        PRSTR("'");
    }
    _ew("\n", 1);
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# The struct a `*T` base points at (its slot / capture typed `0 - sid`, a global's `_gv_ptr_sid`), else 0.
fn _sub_ptr_sid(S, noff, k, ix): i64 {
    var t = 0;
    if (k == 1) { t = GLTYPE(S, ix); }
    if (k == 2) { t = _cl_snap_type(_cl_snap_find(S, noff)); }
    if (k == 3) { return _gv_ptr_sid(S, ix); }
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }   # a vector descriptor, no struct
    return 0 - t;
}
# 1 when the captured base is a slice local of the enclosing fn (the snapshot's bit 62, util.cyr
# GLSLICE). 6.7.8 (C2-6a)
fn _sub_cslice(S, noff): i64 {
    var esl = _cl_snap_find(S, noff);
    if (esl < 0) { return 0; }
    return (L64(_cl_snap + _cl_snap_n * 8 + esl * 8) >> 62) & 1;
}
# 1 when the base is a bare array (`var a[N]` / `stack var a[N]`): a local's / a capture's bit 61
# (util.cyr GLBARR), a global's `0x100` alone.
fn _sub_bare(S, noff, k, ix): i64 {
    if (k == 1) { return GLBARR(S, ix); }
    if (k == 3) { return _arr_gbare(S, ix); }
    var esl = _cl_snap_find(S, noff);
    if (esl < 0) { return 0; }
    return (L64(_cl_snap + _cl_snap_n * 8 + esl * 8) >> 61) & 1;
}
# Width-correct element load: rax = the element at the address in rax. `w` the load width
# (`_ek_lw`, negative = signed).
fn _arr_sub_load(S, w): i64 {
    EMOVCA(S);
    # x86's EFIELD_LOAD_W records the signed (negative) widths itself since 6.7.14, so this load
    # needs no record of its own (it took one in 6.6.12, when only 1 / 2 / 4 were). CHANGELOG [6.7.14]
    EFIELD_LOAD_W(S, w);
    # EADDR left `_flags_reflect_rax` set and a load does not write the flags: without this a
    # following `if (a[i])` would branch on the ADDRESS (see parse/ctrl.cyr ETESTAZ).
    _flags_reflect_rax = 0;
    return 0;
}
# 6.7.8 (C2-4a) — the element at the address in rax, as a VALUE of its declared type (descriptor
# `ed`): loaded at its width, then typed as a read of a declared T is — an f64 / f32 (F64_TYID /
# F32_TYID: an f32 is its 4 bytes, zero-extended, as an f32 local holds it), a bool a boolean value
# (`_BX_MARK`, last: it stamps this code pointer and token), an integer its width for the narrowing
# check. Nothing the index left behind describes it (the step, the type, the constant folder).
fn _esub_load(S, ed): i64 {
    _arr_sub_load(S, _ek_lw(ed));
    SPSC(S, 0);
    SESTYPE(S, _ek_lt(ed));
    var k = _ek_fk(ed);
    if (k == 0) { SEXW(S, _ek_w(ed)); } else { SEXW(S, 0); }
    _cfo = 0;
    if (k == 16) { _BX_MARK(S); }
    return 0;
}
# The factor: `NAME[idx]` as a value. 0 when the cursor is not at `[`, or NAME is a slice
# local (the bounds-checked slice subscript, _slice_sub_read, handles it); 1 when consumed.
fn _arr_sub_read(S, noff): i64 {
    if (PEEKT(S) != 28) { return 0; }
    if (GINFN(S) == 1) {
        var sl = FINDLOCAL(S, noff);
        if (sl >= 0) { if (_slice_lw(S, sl) > 0) { return 0; } }
    }
    var ed = _arr_sub_addr(S, noff);
    if (ed != 0) {
        _esub_load(S, ed);
        return 1;
    }
    EMOVI(S, 0);
    SPSC(S, 0);
    SESTYPE(S, 0);
    SEXW(S, 0);
    _cfo = 0;
    return 1;
}
# The assignment: `NAME[idx] = v` or `NAME[idx] OP= v` (the compound pair of _asg_compound_tok),
# stored at the element's width. Does NOT consume the `;` — the statement arm and the classic-for
# step replay (parse/ctrl.cyr) share it. 0 when the cursor is not at `[`.
fn _arr_sub_assign(S, noff): i64 {
    if (PEEKT(S) != 28) { return 0; }
    var ed = _arr_sub_addr(S, noff);
    EPUSHR(S);            # the element address
    return _esub_assign(S, ed, noff);
}
# The element's `= v` / `OP= v` with its address pushed (descriptor `ed`, 0 after a refusal: the
# value is still parsed, at word width; `nm` the base's name). `=` checks the value as a store
# into a field of T does (`_ifs_bx_el`); `OP=` loads the element at its width and combines it —
# the f64 / f32 arms for a float element (`p[0] += 0.25` stays an f32), a bool element refused as
# `b += 1` is (6.7.3) and then parsed on. A float's value has no integer width to narrow from.
fn _esub_assign(S, ed, nm): i64 {
    _sub_more(S);   # 6.7.8 (C2-4b): `a[i][j] = v` refused by name (it was "expected '='")
    var k = _ek_fk(ed);
    var cop = _asg_compound_tok(S);
    if (cop == 0) {
        if (_masg_not_plain(S, " - an element is not one") == 0) {   # 6.7.7 (T5): `a[i], b = f();`
            if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
            STI(S, GTI(S) + 1);
            _refuse_lossy_pair(S);   # 6.7.7 (T5b): `a[i] = f();` stored the tag
            var ti = GTI(S);
            _sc_beg = 0 - 1;   # 6.7.16 (D99): only this value's own struct-call record may match
            PCMPE(S);
            _dsr_esub(S, ti - 1, ti, ed);   # 6.7.16 (D99): through a `*i64`'s element; 6.7.17 (D16): an array's
            if (k != 0) { _ifs_bx_el(S, k, ti, nm); }
        }
    } else {
        if (k == 16) {
            _bx_refuse(S, GTI(S), "compound assignment to a bool element of ", nm,
              " is refused - its result is not a bool (write `b = b && c`, `b = !b`)", 0 - 1);
        }
        if (ed != 0) { _arr_sub_load(S, _ek_lw(ed)); }
        _cop_dst = ed + 8;   # 6.7.17 (D15): an element, for `_cop_sres`
        _asg_compound_op(S, cop, _ek_lt(ed));
    }
    if (k == 1 || k == 2) { SEXW(S, 0); }
    _asg_store_w(S, _ek_lw(ed));   # at the element's width (parse/decl.cyr, shared with a field's OP=)
    return 1;
}
# The statement arm (_PARSE_STMT_IMPL): the assignment and its `;`.
fn _arr_sub_stmt(S, noff): i64 {
    if (_arr_sub_assign(S, noff) == 0) { return 0; }
    _expect_step(S, 5);
    return 1;
}

# ⛔ 6.7.8 (C2-4b) — A SUBSCRIPT ON A `*T` FIELD OR ON A CALL RETURNING `*T` (the user's decision,
# 2026-10-10: "p[i] reach ... bases: named variables, fields (`h.p[i]`) and call results (`f()[i]`)").
# `h.p[i]`, `a.b.p[i]`, `self.p[i]`, `mk(4).p[i]`, `f()[i]`, `g<i32>()[i]` and `o.m()[i]` were
# `expected ';' / '=', got '['`. The base is evaluated FIRST — the field's value, the call's result —
# then the index (`_psub_addr`: rax = base + index * sizeof(T)), and the element is read and stored
# as a named `*T`'s is (`_esub_load` / `_esub_assign`). Reads: one hook in the PARSE_FACTOR wrapper
# (`_sub_post`); stores: PARSE_FIELD_STORE's `[` arm (`_fld_sub_store`), a call statement through
# `_stmt_qmark` / `_stmt_call_field` (`_stmt_call_sub`), the classic-for step (`_step_call_sub`). The
# element comes from the base's DECLARATION — a field's `_fld_ps`, a callee's `_fn_rps`, a method's
# word (`_call_ret_ps`) — never from a pointer scale an argument left behind (`mk(q).n` kept q's
# until 6.7.9).
# Every other base is refused by name at the `[`, the brackets consumed: a field that is no `*T`, a
# call returning none (a builtin, `callptr`, `fncallN`), `a[i][j]`, `&a[i]`, `(expr)[i]`, a literal;
# a field / call this file cannot resolve is consumed silently under --syntax-only. No program that
# compiled before reaches these paths: a `[` after a factor was an error. CHANGELOG [6.7.8]
# The `(` of the call whose `)` is the token before the cursor (0 when there is none).
fn _sub_open(S): i64 {
    var k = GTI(S) - 2;
    var d = 1;
    while (k > 0) {
        var t = TOKTYP(S, k);
        if (t == 11) { d = d + 1; }
        if (t == 10) { d = d - 1; if (d == 0) { return k; } }
        k = k - 1;
    }
    return 0;
}
# The callee token of the call that ends before the cursor when it is a direct `name(..)` /
# `name<..>(..)` — not a method's `.name(..)`, a builtin or `callptr` — else -1. Read from the tokens:
# in statement position the call's own parse sets no pointer scale (PARSE_FNCALL), and a statement
# inside its arguments (a closure body) would have overwritten any record of the callee.
fn _sub_callee(S): i64 {
    var c = _sub_open(S) - 1;
    if (c < 1) { return 0 - 1; }
    var t = TOKTYP(S, c);
    if (t == 20 || t == 39 || t == 152) {   # `name<..>(`: back to its `<`
        var d = 0;
        while (c > 0) {
            t = TOKTYP(S, c);
            if (t == 20) { d = d + 1; }
            if (t == 39) { d = d + 2; }
            if (t == 152) { d = d + 3; }
            if (t == 19) { d = d - 1; if (d <= 0) { break; } }
            c = c - 1;
        }
        c = c - 1;
        if (c < 1) { return 0 - 1; }
    }
    if (TOKTYP(S, c) != 2) { return 0 - 1; }
    if (TOKTYP(S, c - 1) == 41) { return 0 - 1; }   # a method, `.name(..)`
    var o = _gcall_open(S, c);
    if (o < 0) { return 0 - 1; }
    if (_call_close(S, o) + 1 != GTI(S)) { return 0 - 1; }
    return c;
}
# The base before the `[` at the cursor (`ti` the factor's first token; -1 for a statement): 1 a field
# (`.name`), 2 a call (`..)` whose `(` lies past ti), 0 anything else (`(expr)`, a literal, a name).
fn _sub_how(S, ti): i64 {
    var t = TOKTYP(S, GTI(S) - 1);
    if (t == 2) {
        if (TOKTYP(S, GTI(S) - 2) == 41) { return 1; }
        return 0;
    }
    if (t != 11) { return 0; }
    if (_sub_open(S) <= ti) { return 0; }   # `(expr)[i]`: the parenthesis is the factor itself
    return 2;
}
# The base's step word, 0 when it is no `*T`: a field's from its declaration, and only when its load
# ended at the cursor (`_flt_ti`, parse/decl/field.cyr — a slice's `.ptr` or an enum constant is read
# another way); a direct call's from the callee it reaches (`_fn_rps`, the instance's); any other
# call's from the word its call set (a method's `_call_ret_ps`, a builtin's 0).
fn _sub_word(S, h): i64 {
    if (h == 1) {
        if (_flt_ti != GTI(S)) { return 0; }
        return _fld_ps_get(S, _rlf_si, _rlf_fi);
    }
    if (h != 2) { return 0; }
    var c = _sub_callee(S);
    if (c < 0) { return GPSC(S); }
    if (c == _icall_ps_beg) { return _icall_ps; }   # 6.7.15 (D31): a known `&f` callee's, not fncallN's own
    var fi = _pair_gen_inst(S, c);
    if (fi < 0) { return 0; }
    if (_fn_rps == 0) { return 0; }
    return L64(_fn_rps + fi * 8);
}
# The token naming the base: a call's callee (the name before its `(`; a generic call's name), else
# the token before the `[`.
fn _sub_name_tok(S, h): i64 {
    if (h != 2) { return GTI(S) - 1; }
    var c = _sub_open(S) - 1;
    if (TOKTYP(S, c) != 2) { if (_sub_callee(S) >= 0) { c = _sub_callee(S); } }   # `g<T>(..)`
    return c;
}
# The struct a call base's `*T` points at (its callee's `_fn_rpsid`; a method's, the last one called),
# else 0.
fn _sub_ret_sid(S): i64 {
    var fi = _mcall_last;
    var c = _sub_callee(S);
    if (c >= 0) { fi = _pair_gen_inst(S, c); }
    if (_sub_open(S) - 1 == _icall_ps_beg) { fi = _icall_fi; }   # 6.7.15 (D31): a known `&f` callee's
    if (fi < 0) { return 0; }
    if (_fn_rpsid == 0) { return 0; }
    return L64(_fn_rpsid + fi * 8);
}
# A refusal at the `[`: `hd`, then the name token `nt` quoted (nt >= 0), `a`, `b`, and a second
# name `n2` quoted (a C string; 0 none) — ERR_IDENT's line. In sync: every caller steps the
# brackets / steps on (6.7.16).
fn _psub_err(S, hd, nt, a, b, n2): i64 {
    if (_panic == 1) { return 0; }
    _refuse_in_sync(S);
    if (_derr_seen(GTI(S), "_psub_err", (((hd * 31 + nt) * 31 + a) * 31 + b) * 31 + n2, 1) == 1) { return 0; }   # 6.7.15
    _ew("error:", 6);
    _err_head(S);
    PRSTR(hd);
    if (nt >= 0) {
        if (TOKTYP(S, nt) == 2) { PRSTR(S + 0xEC00000 + TOKVAL(S, nt)); }
        else { PRSTR(TOKNAME(TOKTYP(S, nt))); }   # a builtin's name
        PRSTR("'");
    }
    PRSTR(a);
    PRSTR(b);
    if (n2 != 0) {
        PRSTR("'");
        if (n2 <= 0 - 1000) { _ei_pr(S, n2); } else { PRSTR(n2); }   # 6.7.17: a struct (`_ei_sid`)
        PRSTR("'");
    }
    _ew("\n", 1);
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# The descriptor of the base's element (`w` its step word, h / nt as above): an integer, f64, f32 or
# bool element's; else 0 after the refusal by name — silent under --syntax-only for a field or a
# call, whose declaration may sit in another file.
fn _psub_ed(S, w, h, nt): i64 {
    var ed = 0;
    if (_ps_step(w) > 0) { ed = (w >> 40) & 0xFF; }
    var ew = _ek_w(ed);
    if (ew >= 1) { if (ew <= 8) { return ed; } }
    if (h == 0) {
        return _psub_err(S, ": a subscript's base is a name, a *T field or a call returning *T", 0 - 1,
          " - name the pointer first (var q: *T = ..; q[i])", "", 0);
    }
    if (_syntax_only == 1) { return 0; }
    var hd = ": cannot subscript the result of '";
    if (h == 1) { hd = ": cannot subscript field '"; }
    if (_ps_step(w) <= 0) {
        if (h == 1) { return _psub_err(S, hd, nt, ": it is not a *T field", "", 0); }
        return _psub_err(S, hd, nt, ": it does not return a *T", "", 0);
    }
    if (ew > 8) {
        return _psub_err(S, hd, nt, ": a u128 element does not fit one register",
          " - use load64/store64 on its two halves", 0);
    }
    var sid = 0;
    if (h == 1) { sid = _fld_ptr_sid(S, _rlf_si, _rlf_fi); }
    else { sid = _sub_ret_sid(S); }
    var el = ": a subscript takes an integer, f64, f32 or bool element";
    if (sid > 0) {
        return _psub_err(S, hd, nt, el, " - its element is struct ", _ei_sid(sid));
    }
    return _psub_err(S, hd, nt, el, " - its element is a pointer, string, enum or vector", 0);
