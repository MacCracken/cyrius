# `_step_call_field` after its call chain: the store ended the step, or the rest is refused once.
fn _step_cf_tail(S, st, tn, dot): i64 {
    if (_cpf_done == st) { return 1; }   # the store ended the step at its `)`
    if (_tsc_n != tn) { return 1; }      # the call refused itself (top level): the one error
    if (dot == 0) { if (PEEKT(S) == 28) { _stmt_call_sub(S); } }   # `mk(4).p[i] = v`, as the statement
    if (_asg_pair_at(S) == 1) {
        if (_cf_unres == st) { _synonly_fld_tail(S, 11); return 1; }   # 6.7.15: --syntax-only, a sibling's call
        if (_mcall_last < 0 || dot == 0) { _asg_temp_refused(S); return 1; }
    }
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
