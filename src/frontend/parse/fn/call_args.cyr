# ⛔ 6.7.6 — A PARENTHESISED ARGUMENT TO AN ADDRESS-PASSED PARAMETER WAS PUSHED AS ITS VALUE:
# `rd3((a))` (`p: *P3`), `rd1((s))`, `rd1((mk1(4)))` SIGSEGV'd on x86 and aarch64 (an access
# violation on PE, a guest error on cx), because every arm above keys on the argument's first token
# being the name. Parentheses that wrap the WHOLE argument (`_pwrap_k`, any depth) are transparent:
# the arms run on what they wrap — a name, a call, a field, a method or operator result — and the
# `)`s are consumed after. Any other argument that opens with `(` (`(a) + b`) is an expression, as
# one that does not is (`_push_struct_expr_arg`). Returns as the caller's arms do. CHANGELOG [6.7.6]
fn _sarg_paren(S, fi, argc, tail): i64 {
    var st = GTI(S);
    if (_tup_sarg_lit(S, fi, argc, tail) == 1) { return 1; }   # 6.7.7 (B4): a tuple literal
    var k = _pwrap_k(S, st);
    var e = TOKTYP(S, _pw_end);
    if (e != 31) { if (e != 11) {
