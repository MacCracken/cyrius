    EFLADDR(S, t);
    EPUSHR(S);
    return 1;
}
# The vector (its descriptor, negative) the WHOLE argument at token `ti` returns when it is a call declared
# to return one — by name (`_vcall_fi`; 6.7.13: an explicit instance `g<T>(..)` too, read past its `<..>`),
# `fncallN(&f, ..)` / `callptr(&f, ..)` (`_icall_rs_at`), or (6.7.13) a method `x.m(..)` (`_vmc_fi`): D27's `*V`
# rule for every call declared to return the vector — `rd(s.mv(42, 7))` pushed lane 0 as the address (139 / cx
# 253 / PE 5; issues/archived/2026-10-15-vector-value-into-other-pointer-or-byvalue-struct-and-unreceived-call-sources.md
# row 6); else 0.
fn _svc_rs(S, ti): i64 {
    var rs = _icall_rs_at(S, ti);
    var o = ti + 1;
    if (rs <= 0 - 2048) {
        _svc_k = 2;
        _svc_nm = TOKVAL(S, _icall_fti(S, ti));
    } else {
        var vf = _vcall_fi(S, ti);
        _svc_k = 1;
        _svc_nm = TOKVAL(S, ti);
        if (vf < 0) {   # 6.7.13: a method `x.m(..)` declared to return a vector (`_vmc_fi`; `_vrcv_emit` kind 3)
            vf = _vmc_fi(S, ti);
            if (vf < 0) { return 0; }
            _svc_k = 3;
            _svc_nm = TOKVAL(S, _vmc_mt);   # 6.7.15: a field chain's method too
        }
        rs = GFRS(S, vf);
        o = _vcall_o;
    }
    var nx = TOKTYP(S, _call_close(S, o) + 1);   # the whole argument: `,` or `)` follows the call
    if (nx != 31) { if (nx != 11) { return 0; } }
    return rs;
}
# 6.7.13 (D31 A): a whole vector call into an address-passed parameter that is no vector's — a `*S` / `*T` of another
# kind, a by-value struct over 8 B (`_vk_param`) — refused by name (`_vec_val_err`); 0 either way (the value push
# follows, no binary is written).
fn _svc_kind(S, fi, argc): i64 {
    var kd = _vk_param(S, fi, argc);
    if (kd == 0) { return 0; }
    if (_svc_rs(S, GTI(S)) == 0) { return 0; }
    _vec_val_err(S, 0, _svc_nm, fi, kd);
    return 0;
}
fn _svc_toplevel_err(S): i64 {
    if (_panic == 1) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": '");
    PRSTR(S + 0xEC00000 + _svc_nm);
    PRSTR("' returns a vector by value, and a vector result needs storage in a fn's frame - call it inside a fn\n");
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}
# ... at token `ti`, naming token `nt`'s name; the cursor kept. 1. 6.7.15 (D26): a top-level declaration's
# (`_vtop_ref`).
fn _svc_toplevel_at(S, ti, nt): i64 {
    var sv = GTI(S);
    STI(S, ti);
    _svc_nm = TOKVAL(S, nt);
    _vop_done = ti;   # 6.7.16 (D100): the call's one refusal
    _svc_toplevel_err(S);
    STI(S, sv);
    return 1;
}

# ⛔ 6.7.10 (ops-5) — A WHOLE DEREFERENCE AS AN ADDRESS-PASSED ARGUMENT PASSES ITS POINTER (the user's
# decision 6: `*p` is a struct value at every size). `take(*p)`, `take((*p))`, `take(*gp())`, `take(*w.ps)` into
# a by-value struct parameter over 8 B, or into a `*S` parameter of any size, pushed the word the dereference
# READ as the struct's address — SIGSEGV on x86_64 and aarch64, an access violation on PE, a guest error on
# cx — while `take(p)` passed the pointer. The `*` that starts the argument is parked (`_dro_want`: the
# pointer in a hidden temp, `_dlo_park`); when the dereference is the whole argument, nothing emitted since
# (`_dro_take`), the pointer is pushed — as `take(p)` pushes it, the callee copying a by-value parameter in
# its prologue — and its struct is checked against the parameter's (a struct value of another type is
# refused by name, as a variable is). Anything else is `_push_struct_expr_arg`'s, as before. CHANGELOG [6.7.10]
fn _sarg_deref(S, fi, argc, tail): i64 {
    var dw = _dro_want;
    var dv = _dro_vt;
    _dro_want = GTI(S);
    _dro_vt = _dro_vt_for(S, fi, argc);   # 6.7.12 (D27): a `*V` parameter takes a vector's pointer
    var r = _push_struct_expr_arg(S, fi, argc, tail);
    _dro_want = dw;
    _dro_vt = dv;
    return r;
}
# ⛔ 6.7.12 — A VECTOR DEREFERENCE INTO A `*V` PARAMETER PASSES ITS POINTER (D27, the user, 2026-10-15: B). `rd(*pb)`
# with `pb: *f64v2` and `p: *f64v2` pushed lane 0 — the word the dereference read — as the address (139 on
# x86_64 and aarch64, a cx guest fault, exit 5 on PE), as `take(*p)` did for a struct before 6.7.10's decision
# 6. The `*` that starts the argument is parked as a struct's is when parameter `argc` of `fi` is a `*V`
# (`_dlo_vec`, parse/expr.cyr: the operand's step word names its vector, `_ps_vdesc`) and pb itself is
# pushed (`_push_struct_expr_arg`); a `*` of another vector type is refused with A2's words (`_dro_check`).
# The `*` token for `_dlo_vec`, -1 when the parameter is no `*V`.
# 6.7.13 (D31 A): and for a pointer of another kind or a by-value struct (`_vk_param`), where `_dro_vcheck` refuses a
# parked `*V` dereference by name (`rp(*pb)` pushed lane 0 as the address).
fn _dro_vt_for(S, fi, argc): i64 {
    if (_pvec_param(S, fi, argc) == 0) { if (_vk_param(S, fi, argc) == 0) { return 0 - 1; } }
    return GTI(S);
}
# 1 = the dereference `_dlo_park` parked spans [b, cursor) — inside any parentheses wrapping the whole of
# it — and nothing was emitted since its load: the pointer is in `_dlo_h`.
fn _dro_take(S, b): i64 {
    if (_dlo_cp != GCP(S)) { return 0; }
    return _opd_span(S, _dlo_beg, _dlo_end, b);
}
# The taken dereference as parameter `k` of fn `fi`: its struct checked, the argument named as the source spells it
# (6.7.15, `_src_span_nm`: `*gq(pq)`; it named the operand's last name, `pq`). The caller then reloads the pointer from
# `_dlo_h` (`_HTLOAD`; the right operand's through `_opd_operand`).
fn _dro_check(S, fi, k): i64 {
    if (_dlo_sid >= 2048) { return _dro_vcheck(S, fi, k); }   # 6.7.12: a vector's (`_dlo_vec`)
    return _sarg_type_err(S, fi, k, _dlo_sid, _dro_nm(S, _dlo_beg));
}
# The taken dereference's tokens from `a` (its `*`, or past it) to its end, as the source spells them; else (6.7.11) the
# operand's last name: `*gu<U>()` names `gu`.
fn _dro_nm(S, a): i64 { return _src_span_nm(S, a, _dlo_end, _hl_lastnm(S, _dlo_beg + 1, _dlo_end, 0)); }
# The tokens [a, e) as the source spells them, else (6.7.14) their last name.
fn _svo_nm(S, a, e): i64 { return _src_span_nm(S, a, e, _hl_lastnm(S, a, e, 0)); }
fn _dro_vcheck(S, fi, k): i64 {
    var pv = _pvec_param(S, fi, k);
    if (pv == _dlo_sid) { return 0; }
    var kd = _vk_param(S, fi, k);
    if (pv == 0) { return _svo_err(S, _dlo_beg, 1, _dro_nm(S, _dlo_beg + 1), fi, kd); }   # 6.7.13 (D31)
    ERR_IDENT(S, "cannot pass ", _dro_nm(S, _dlo_beg), " to a parameter of a different vector type in a call to ", _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    return 1;
}

# ⛔ 6.7.7 (B4) — A MULTI-VALUE CALL AS A TUPLE ARGUMENT (`g(f())`, `f` declared `: (i64, i64)`, or
# undeclared with every return `(a, b)` — `_mv_callee`, CHANGELOG [6.7.13]).
# The parameter takes a tuple's ADDRESS, and the call leaves its values in the return registers —
# nothing to point at — so the value push handed the callee the first value as an address (a
# SIGSEGV, or a silent read through it). Refused by name: bind the values first. Cursor on the
# callee's name; 1 = reported (the caller then pushes the argument as before, the parse in step,
# `_had_error` withholding the binary). A whole call only: `g(f() + 1)` is an integer, which the
# struct rule passes as an address as it does any untyped value. CHANGELOG [6.7.7]
fn _tup_arg_call(S, fi, argc): i64 {
    var ps = GFPSID(S, fi, argc);
    if (_tup_is(S, ps) == 0) { return 0; }
    var ti = GTI(S);
    var o = _gcall_open(S, ti);
    if (o < 0) { return 0; }
    if (_call_dotted(S, ti) == 1) { return 0; }
    if (_call_is_whole_arg(S, o - 1) == 0) { return 0; }
    var cfi = _gen_resolve_call(S, ti);
    if (_mv_callee_any(S, cfi) == 0) { return 0; }   # declared or counted (6.7.13); a counted `: i64` too (6.7.14)
    return _tup_arg_mv_err(S, ti, ps, TOKVAL(S, ti), "(..)");
}
# ⛔ 6.7.14 — AN INTEGER LITERAL IS NO TUPLE (D44, the user's decision, 2026-10-16). `take(5)` pushed 5 as the
# tuple's address and the callee read through it (139 / 139 / 1 / 5 on x86_64 / aarch64 / cx / PE), where the
# tuple VARIABLE refuses it ("cannot initialize tuple 't' with a value that is not a tuple"). Refused by name at
# the literal — a whole argument, inside any parentheses (`_sarg_paren` peels them) — in sync: the caller pushes
# it as before and `_had_error` withholds the binary. Any other untyped word (`&t`, a name, a one-value call) is
# still the address, as for a struct parameter: a tuple has no `*T` spelling. CHANGELOG [6.7.14]
# ⛔ 6.7.15 — AN ARGUMENT MADE ONLY OF LITERALS AND OPERATORS IS NO TUPLE EITHER (D36, the user's decision,
# 2026-10-18): `take(-5)`, `take((-5))`, `take(true)` and `take(5 + 0)` compiled and the callee read through the
# value (139 / 139 / 1 / 5), because only a lone integer literal reached the check. The whole argument is scanned
# (`_tal_scan`): integer / char literals, `true` / `false`, operators and parentheses only — refused as "an
# integer", or "a bool" when its every literal is `true` / `false`. A name (a const too), a call, `&` / `*` in front
# of an operand or a string exempts it. `_tup_is` first: only a tuple parameter pays for the scan.
# 6.7.16: a boolean value — a comparison, `!x`, `&&` / `||` — is "a bool" too (`_tal_kind`).
# ⛔ 6.7.16 — A FLOAT LITERAL IS NO TUPLE (D23, the user's decision, 2026-10-19): `take(1.5)`, `take(-1.5)`,
# `take((2.0))` and `take(1.5 + 1)` compiled and the callee read through the f64's bits (139 / 139 / 1 / 5 on x86_64
# / aarch64 / cx / PE): `_tal_scan` took no float literal, so the argument was exempt. It takes one now, and an
# argument whose value is an f64 is refused as "an f64"; a float comparison (`take(1.5 < 2.0)`) is "a bool".
fn _tup_arg_lit(S, fi, argc): i64 {
    var ps = GFPSID(S, fi, argc);
    if (_tup_is(S, ps) == 0) { return 0; }
    var lk = _tal_scan(S, GTI(S));
    if (lk == 0) { return 0; }
    var o = _gen_def_open(S, fi);
    if (o > 0) { if (TOKTYP(S, o - 1) != 2) { return 0; } }   # `fn g<T>(`: its tuple parameter is refused there (R4)
    lk = _tal_kind(S, lk);
    if (lk == 0) { return 0; }   # 6.7.16: no single expression — the parse's own error, alone
    if (_dyn_ebeg(S, GTI(S)) == 0) { return 1; }
    if (lk == 2) { PRSTR("cannot pass a bool to tuple parameter "); }
    elif (lk == 3) { PRSTR("cannot pass an f64 to tuple parameter "); }
    else { PRSTR("cannot pass an integer to tuple parameter "); }
    var pn = _bx_pname(S, fi, argc);
    if (pn >= 0) {
        _dyn_pq(S, pn);
        PRSTR(" ");
    }
    _dyn_ps(S, ps);
    PRSTR(" of ");
    _dyn_pq(S, _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    PRSTR(" - it takes a tuple");
    _dyn_eend(S);
    return 1;
}
# 6.7.15 (D36) — the argument from token k to its depth-0 `,` / `)`: 1 = made only of integer / char literals,
# `true` / `false`, operators and parentheses, with an integer or char literal among them (6.7.16, D23: or a float
# literal); 2 = the same with every literal a `true` / `false`; 0 = anything else. `-` / `~` / `!` stand in front of an operand; `*` and `&` only
# between two (in front of one they read or take an address).
fn _tal_scan(S, k): i64 {
    var n = GTCNT(S);
    var d = 0;
    var ints = 0;
    var bools = 0;
    var opnd = 0;   # 1 = the token before ends an operand: a literal or a `)`
    while (k < n) {
        var t = TOKTYP(S, k);
        if (t == 31 || t == 11) {
            if (d == 0) { return _tal_end(ints, bools, opnd); }
            if (t == 31) { return 0; }
            d = d - 1;
        } elif (opnd == 1) {
            if (_tal_binop(t) == 0) { return 0; }
            opnd = 0;
        } elif (t == 1 || t == 61) {
            ints = 1;
            opnd = 1;
        } elif (t == 169 || t == 170) {
            bools = 1;
            opnd = 1;
        } elif (t == 10) { d = d + 1; }
        elif (t != 7 && t != 37 && t != 171) { return 0; }
        k = k + 1;
    }
    return 0;
}
fn _tal_end(ints, bools, opnd): i64 {
    if (opnd == 0) { return 0; }
    if (ints == 1) { return 1; }
    if (bools == 1) { return 2; }
    return 0;
}
# A binary operator `_tal_scan` takes: + - * / == != < > <= >= & % | ^ << >> && || >>> and the wrapping /
# saturating / checked +% +| +? -% -| -? *% *| *?.
fn _tal_binop(t): i64 {
    if (t >= 6 && t <= 9) { return 1; }
    if (t >= 17 && t <= 22) { return 1; }
    if (t == 27 || t == 34 || t == 35 || t == 36 || t == 38 || t == 39) { return 1; }
    if (t == 53 || t == 54 || t == 152) { return 1; }
    if (t >= 113 && t <= 121) { return 1; }
    return 0;
}
# ⛔ 6.7.16 — A COMPARISON, `!x` OR `&&` / `||` ARGUMENT IS "A BOOL". D36's words said "a bool" only when every
# literal was `true` / `false`, so `take(1 == 1)`, `take(!0)` and `take(1 < 2 && 3 > 2)` said "an integer" where
# guide § bool counts a comparison, `!x`, `&&` / `||` — or any of these in parentheses — a boolean value. The words
# follow the argument's value: 2 when every literal is `true` / `false` (D36) or the value is a boolean one; 3 an
# f64 (D23); else 1. CHANGELOG [6.7.16]
# ⛔ 6.7.16 — AND 0, NOT JUDGED, WHEN THE TOKENS ARE NO SINGLE EXPRESSION. `_tal_scan` checks the vocabulary, not the
# grammar, so `take(1 < 2 < 3)` (one comparison per operand, _PLOGIC_ATOM), `take(1 == 1 == 1)` and
# `take((1 +) - 2)` printed "cannot pass an integer to tuple parameter ..." in front of the parse's own error —
# two errors for one mistake, the first naming the wrong one. The parse reports it alone. CHANGELOG [6.7.16]
fn _tal_kind(S, lk): i64 {
    var vk = _tty_arg(S, GTI(S));
    if (vk == 0) { return 0; }
    if (lk == 2) { return 2; }
    return vk;
}
# `_tty_arg` reads a literal-only argument (`_tal_scan` has seen only literals, operators and parentheses) the way
# PCMPE parses it — `||` / `&&` links, one comparison, PEXPR's `+ - & | ^ ..`, PARSE_TERM's `* / % << ..`, a
# factor's `-` / `~` / `!` and a parenthesised expression — and answers its value's class: 2 a boolean value, 3 an
# f64, 1 an integer; 0 when the tokens are no single expression or nest past 256 parentheses. An f64 is the value
# the compiler types f64 (D23: "an f64 when the compiler sees one"): a float literal; `+ - * /` (`+% -% *%`) with
# one on EITHER side — `1 + 1.5` is an integer add of 1.5's bits, but its result keeps the f64 type (guide § f64:
# "Only `+ - * /` keep an f64 right operand's type"); `-` / `~` over one (_int_st keeps it). `& | ^ % << >> >>>` give
# an integer (6.7.13's D12), and so do the saturating / checked `+| +? -| -? *| *?` (the user's D104, 2026-10-20:
# EMIT_OVF_CALL clears the type; they kept an f64 right operand's), `!` a boolean value. CHANGELOG [6.7.16]
var _tty_k = 0;     # the cursor
var _tty_bad = 0;   # 1 = the reading failed
fn _tty_arg(S, k): i64 {
    _tty_k = k;
    _tty_bad = 0;
    var t = _tty_logic(S, 0);
    if (_tty_bad == 1) { return 0; }
    var e = TOKTYP(S, _tty_k);
    if (e != 31) { if (e != 11) { return 0; } }
    return t;
}
# `||` and `&&` (PCMPE, _PLOGIC_AND): a link of either is a boolean value.
fn _tty_logic(S, dep): i64 {
    var t = _tty_atom(S, dep);
    while (_tty_op(S, 0) > 0) {
        _tty_k = _tty_k + 1;
        _tty_atom(S, dep);
        t = 2;
    }
    return t;
}
# One comparison at most (_PLOGIC_ATOM): a boolean value.
fn _tty_atom(S, dep): i64 {
    var t = _tty_add(S, dep);
    if (_tty_op(S, 3) == 0) { return t; }
    _tty_k = _tty_k + 1;
    _tty_add(S, dep);
    return 2;
}
# PEXPR's level (`+ - & | ^`, `+% +| +? -% -| -?`), left to right.
fn _tty_add(S, dep): i64 {
    var t = _tty_mul(S, dep);
    var c = _tty_op(S, 1);
    var r = 0;
    while (c > 0) {
        _tty_k = _tty_k + 1;
        r = _tty_mul(S, dep);
        t = _tty_bin(t, c, r);
        c = _tty_op(S, 1);
    }
    return t;
}
# PARSE_TERM's level (`* / % << >> >>>`, `*% *| *?`), left to right.
fn _tty_mul(S, dep): i64 {
    var t = _tty_un(S, dep);
    var c = _tty_op(S, 2);
    var r = 0;
    while (c > 0) {
        _tty_k = _tty_k + 1;
        r = _tty_un(S, dep);
        t = _tty_bin(t, c, r);
        c = _tty_op(S, 2);
    }
    return t;
}
# A link's value from its operator's kind `c` and its operands' classes `t` / `r`: `+ - * /` (`+% -% *%`, kind 1) an
# f64 when either operand is one; everything else an integer (a saturating / checked link too: 6.7.16's D104).
fn _tty_bin(t, c, r): i64 {
    if (c == 1) {
        if (t == 3) { return 3; }
        if (r == 3) { return 3; }
    }
    return 1;
}
# The cursor's operator at a level — 0 `||` / `&&`, 1 PEXPR's, 2 PARSE_TERM's, 3 a comparison: 0 when it is none
# (or the reading has failed); at levels 1 / 2, 1 for one with an f64 form (`+ - +% -%`, `* / *%`), 2 for one whose
# value is an integer (`& | ^ % << >> >>>`, the saturating / checked `+| +? -| -? *| *?`); else 1.
fn _tty_op(S, lv): i64 {
    if (_tty_bad == 1) { return 0; }
    var t = TOKTYP(S, _tty_k);
    if (lv == 0) { if (t == 53 || t == 54) { return 1; } return 0; }
    if (lv == 3) { if (t >= 17 && t <= 22) { return 1; } return 0; }
    if (lv == 1) {
        if (t == 6 || t == 7 || t == 113 || t == 116) { return 1; }
        if (t == 27 || t == 35 || t == 36) { return 2; }
        if (t >= 113 && t <= 118) { return 2; }
        return 0;
    }
    if (t == 8 || t == 9 || t == 119) { return 1; }
    if (t == 34 || t == 38 || t == 39 || t == 152) { return 2; }
    if (t == 120 || t == 121) { return 2; }
    return 0;
}
# A factor: its prefixes, then its operand. The outermost prefix decides — `!` a boolean value; `-` / `~` an f64 over
# an f64 with no `!` beneath it (_int_st keeps the type; `!` clears it), else an integer — and with none, the
# operand's own class.
fn _tty_un(S, dep): i64 {
    if (_tty_bad == 1) { return 1; }
    var t = TOKTYP(S, _tty_k);
    var pre = t;
    var bang = 0;   # a `!` among the prefixes
    while (t == 7 || t == 37 || t == 171) {
        if (t == 171) { bang = 1; }
        _tty_k = _tty_k + 1;
        t = TOKTYP(S, _tty_k);
    }
    var v = _tty_prim(S, dep, t);
    if (pre == 171) { return 2; }
    if (pre == 7 || pre == 37) {
        if (bang == 0) { if (v == 3) { return 3; } }
        return 1;
    }
    return v;
}
# An operand: an integer / char literal, a float literal, `true` / `false`, or a parenthesised expression (its own
# class).
fn _tty_prim(S, dep, t): i64 {
    _tty_k = _tty_k + 1;
    if (t == 1) { return 1; }
    if (t == 61) { return 3; }
    if (t == 169 || t == 170) { return 2; }
    if (t != 10 || dep >= 256) {
        _tty_bad = 1;
        return 1;
    }
    var v = _tty_logic(S, dep + 1);
    if (_tty_bad == 1) { return v; }
    if (TOKTYP(S, _tty_k) != 11) {
        _tty_bad = 1;
        return v;
    }
    _tty_k = _tty_k + 1;
    return v;
}
# ... and a whole METHOD or operator call (`g(x.f())`, `g(a + b)`), after its parse: `_sc_post_small`
# stamps a multi-value result's span (`_mrc_note`, read by nothing else); one that is the whole
# argument (from `st` to the cursor) is refused the same way.
var _mrc_beg = 0 - 1;   # its first token
var _mrc_end = 0 - 1;   # the token after it
var _mrc_fn = 0;        # its name
var _mrc_fi = 0 - 1;    # 6.7.11: its fn (declared multi-value, or undeclared with a counted return)
fn _mrc_note(S, fi, noff, beg): i64 {
    _mrc_beg = beg;
    _mrc_end = GTI(S);
    _mrc_fn = noff;
    _mrc_fi = fi;
    return 0;
}
fn _tup_arg_mrc(S, fi, argc, st): i64 {
    if (_mrc_beg != st) { return 0; }
    if (_mrc_end != GTI(S)) { return 0; }
    if (_mv_callee_any(S, _mrc_fi) == 0) { return 0; }   # declared or counted (6.7.13); a counted `: i64` too (6.7.14)
    var ps = GFPSID(S, fi, argc);
    if (_tup_is(S, ps) == 0) { return 0; }
    return _tup_arg_mv_err(S, st, ps, _mrc_fn, 0);
}
# The R17 report at token `ti`: tuple `ps`, the call named `noff`; `tail` != 0 spells the call in
# the hint as `name<tail>` (a free call), 0 as `...`. 1 = refused (reported once).
var _tamv_fld = 0;   # 6.7.7 (T5): 1 = the field form, `h.p = f();` (`_tup_fsc_call`)
fn _tup_arg_mv_err(S, ti, ps, noff, tail): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 1; }
    if (_tn_once(S, ti) == 0) { return 1; }
    var sv = GTI(S);
    STI(S, ti);
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": a multi-value call '");
    PRSTR(S + 0xEC00000 + noff);
    if (_tamv_fld == 1) { PRSTR("' is not stored into a tuple field - bind it first: `var t: "); }   # 6.7.7 (T5)
    else { PRSTR("' is not a tuple argument - bind it first: `var t: "); }
    _sn_pr(S, ps);
    PRSTR(" = ");
    if (tail != 0) {
        PRSTR(S + 0xEC00000 + noff);
        PRSTR(tail);
    } else { PRSTR("..."); }
    if (_tamv_fld == 1) { PRSTR(";`, then store `t`\n"); }
    else { PRSTR(";`, then pass `t`\n"); }
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 1;
}

# ⛔ 6.7.11 — A MULTI-VALUE CALL WHERE A NAMED STRUCT IS EXPECTED (the user's decision, 2026-10-13:
# refused by name, R17's wording, at every struct size). A call returning several values leaves them
# in the return registers; a named struct is a VALUE — a by-value parameter, a local, a global, a field.
# No destination recognised the call (each keyed on the callee's struct, and a multi-value one has
# none), so its FIRST value became the struct: its address over 8 B — `take(mk(3))`, `take(b.mk(3))`,
# `var p: P = mk(3);` SIGSEGV'd on x86 and aarch64, an access violation on PE, a guest error on cx — or
# its first word (`h.p = mk(3);`, `p = mk(3);`: p.a = 3, p.b stale, silently). R17 (6.7.7) refuses
# this call into a TUPLE parameter or field; a named struct is refused the same way: bind the values
# first. A `*P` (parameter, variable) and a `Str` / `Result` / `Option` / `Tagged` handle take a word —
# the call's first value, as `var x = mk(3);` does — and are not refused. CHANGELOG [6.7.11]
#
# 1 = fn `fi` returns several values: declared `: (T1, T2[, T3])`, or undeclared with a count pass 1
# proved (`_fn_ret_arity`). Keyed on the DECLARED return: a `: P` fn's `return (x, y)` arms (the 6.7.7
# crossing) return a P.
fn _mv_callee(S, fi): i64 {
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs == MULTIRET_SID) { return 1; }
    if (rs != 0) { return 0; }
    if (_fn_ret_arity(S, fi) != 0) { return 1; }
    return 0;
}
# ⛔ 6.7.14 — ... and, for a TUPLE parameter (R17), a fn declared ONE scalar (`: i64`, `: f64`, `: bool`,
# `: i32` ..) that pass 1 counted returning several values (6.7.13's D23 B keeps it): `take(g2(3))` with
# `fn g2(a): i64 { return (a, a + 1); }` pushed the first value as the tuple's address (139 / 139 / 1 / 5).
# Refused as the undeclared callee is (D44, the user's decision, 2026-10-16). `_mv_callee` itself stays
# keyed on an undeclared return: a named struct's `: P` crossing reads it. CHANGELOG [6.7.14]
fn _mv_callee_any(S, fi): i64 {
    if (_mv_callee(S, fi) == 1) { return 1; }
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs > 0) { return 0; }        # a named struct
    if (rs < 0 - 9) { return 0; }    # a handle (Result / Option / Tagged / cstring) or a vector
    if (_fn_ret_arity(S, fi) != 0) { return 1; }
    return 0;
}
# 1 = struct `sid` (1-based) is a named plain struct: no tuple (R17's), dyn, vector or stdlib handle — but `Str` (6.7.17,
# the user's D99: a multi-value call into a `Str` slot is refused as into a struct slot). CHANGELOG [6.7.17]
fn _mv_named(S, sid): i64 {
    if (sid <= 0) { return 0; }
    if (sid >= 2048) { return 0; }
    if (_tup_is(S, sid) == 1) { return 0; }
    if (_dyn_is(S, sid) == 1) { return 0; }
    if (sid == _STR_SID(S)) { return 1; }   # 6.7.17 (D99): a `Str` slot refuses it as a struct slot does
    if (_classify_param_type(S, L64(S + 0x1A6018 + (sid - 1) * 8)) != 0) { return 0; }
    return 1;
