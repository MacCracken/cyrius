# A struct-typed declaration (`pscale` = `0 - sid`; a local or a global in either zone) whose initialiser
# [start, cursor), just parsed, is a whole multi-value call (PARSE_VAR's `_var_rhs_post`, the zone's
# `_gvi_expr`): the pointer-mode handle took the first value as the struct's address. A generic callee
# keeps the declared struct for this (`_gen_decl_check`).
fn _mv_decl_src(S, pscale, start): i64 {
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
