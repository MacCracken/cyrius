    return _mv_span(S, start, GTI(S), 0 - pscale, 2);
}
# The struct of an assignment's destination name `noff` when it is a named struct VALUE or handle — a
# local, a by-value parameter, a global — and not a `*P` (a pointer rebinds to any word); else 0.
# `*p = v` through a `*S` (`_dst_arms`: no name, the override's struct) copies what `G = v` copies (D4),
# so a multi-value call into it is refused as into `G` (D26 A, the user's decision, 2026-10-15): it
# stored the first value as the struct's word. CHANGELOG [6.7.13]
fn _mv_dst_sid(S, noff): i64 {
    if (_agc_ovr_is(noff) == 1) { return _mv_ovr_sid(S); }
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) {
            if (GLPTRP(S, li) == 1) { return 0; }
            var lt = GLTYPE(S, li);
            if (lt >= 0) { return 0; }
            if (_mv_named(S, 0 - lt) == 0) { return 0; }
            return 0 - lt;
