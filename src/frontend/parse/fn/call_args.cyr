# PARSER — fn: the call path's argument checks — the type-check switch, the callee's source name, arity, and the
# struct / vector / tuple / multi-value arguments.
# ================================================================
# Split from parse/fn.cyr at 6.7.18, unchanged; parse.cyr includes parse/fn/'s files in source order. CHANGELOG [6.7.18]

# v5.10.1 — type-check infrastructure: lazy lookup for the
# `Str` struct sid so PARSE_FNCALL can flag Str-typed args
# being passed to cstring-typed (non-`: Str`) params. The
# search shape mirrors `_STR_FROM_NOFF` in parse/expr.cyr —
# scan tok_names for the cstring "Str\0" (4 bytes:
# 0x0072_7453 little-endian), then resolve to a struct id via
# FINDSTRUCT. Returns 0 if Str isn't defined in this program
# (graceful — type checks just don't fire).
var _str_sid_cache = 0 - 1;
fn _STR_SID(S): i64 {
    if (_str_sid_cache >= 0) { return _str_sid_cache; }
    if (_str_sid_cache == 0 - 2) { return 0; }
    var npos = GNPOS(S);
    var i = 0;
    while (i < npos) {
        # "Str\0" first 4 bytes — bottom 32 bits = 0x00727453
        if (load8(S + 0xEC00000 + i)     == 83) {
            if (load8(S + 0xEC00000 + i + 1) == 116) {
                if (load8(S + 0xEC00000 + i + 2) == 114) {
                    if (load8(S + 0xEC00000 + i + 3) == 0) {
                        var sid = FINDSTRUCT(S, i);
                        if (sid > 0) {
                            _str_sid_cache = sid;
                            return sid;
                        }
                    }
                }
            }
        }
        # skip to next null terminator
        while (i < npos) { if (load8(S + 0xEC00000 + i) == 0) { i = i + 1; break; } i = i + 1; }
    }
    _str_sid_cache = 0 - 2;
    return 0;
}

# v5.10.1 — opt-in gate for the call-site type check.
# `CYRIUS_TYPE_CHECK=1` enabled warnings; default was off.
#
# v5.10.26 — DEFAULT FLIPPED ON. The v5.10.5 false-positive
# shape (Str → generic i64 param triggering false warning)
# was closed by v5.10.24's polarity inversion: the warning
# now fires only on params explicitly annotated `: cstring`
# instead of params NOT annotated `: Str`. Empirical sweep
# at v5.10.26 slot entry across 26 cyrius-application repos
# (cyrius / agnosys / hisab / kavach / abaco / aegis /
# agnostik / agnova / argonaut / ark / chakshu / cyim /
# cyim-lsp / cyrius-doom / daimon / darshana / kybernet /
# libro / majra / niyama / nous / owl / phylax / samvada /
# sandhi / shakti / sit / vyakarana / yantra / yukti)
# confirmed ZERO type-check warnings with TYPE_CHECK=1 —
# the surface is clean and the flip is safe.
#
# Set `CYRIUS_TYPE_CHECK=0` to opt OUT. Any other value
# (or env unset) keeps the check ON. The check is cheap
# (~O(args) per call site), wire-compatible across the
# v5.10.x line, and produces actionable warnings only on
# Str → cstring shape mismatches with hint catalog.
var _type_check_env_resolved = 0;
var _type_check_enabled = 1;
fn _TYPE_CHECK_ENABLED(): i64 {
    if (_type_check_env_resolved == 1) { return _type_check_enabled; }
    var v = _read_env("CYRIUS_TYPE_CHECK");
    if (v != 0) {
        if (load8(v) == 48) { _type_check_enabled = 0; }
        if (load8(v) == 49) { _type_check_enabled = 1; }
    }
    _type_check_env_resolved = 1;
    return _type_check_enabled;
}

# v5.10.25 — Phase 3 generalize retired the hardcoded
# {_PRINTLN_NOFF, _PRINTLN_STR_NOFF, _PRINTLN_INT_NOFF,
# _STRLEN_NOFF, _STR_LEN_NOFF} byte-by-byte name lookups.
# Replaced by registry-based dispatch populated at REGFN time
# from `_str` / `_int` / `_cstr` suffixes on sibling fns.
# See `_OVERLOAD_SUFFIX` + REGFN's auto-register block.

# ⛔ 6.7.14 — A CALL-SITE DIAGNOSTIC NAMES ITS CALLEE AS THE SOURCE SPELLS IT. The fn table holds a method as its
# mangled `T_m` (`T_Tr_m` when two traits give T an `m`) and a generic call as its instance `g$i32`, and the call-site
# messages printed that: "in a call to 'S_ri'", "'S_two' expects 2 arguments, got 3", "'g$i32' is deprecated",
# "undefined function 'S_nope'". The spelling to print for fn `fi`, which the site names `noff`: a method `T.m` (its
# record, GFMETH), a generic instance its base's spelling and `<..>` its type arguments (GFIC, the instance's own
# record; a struct instance among them `Box<i64>`, `_sinst`), anything else `noff` itself — and `noff` whenever the
# site names something other than fi's own name (an alias). Written at GNPOS uncommitted, as BUILD_METHOD_NAME's
# lookup scratch is: the caller prints it before anything else is minted. CHANGELOG [6.7.14]
fn _fn_src_name(S, fi, noff): i64 {
    if (fi < 0) { return noff; }
    var nm = L64(_fnt_names + fi * 8);
    if (noff != nm) { if (STREQ(S, noff, nm) == 0) { return noff; } }
    return _fsn_spell(S, nm, GFMETH(S, fi), GFIC(S, fi, 0), GFIC(S, fi, 1));
}
# The fn being parsed (`_cur_fn_ix`) as the source spells it — inside a generic instance's body, whose own records
# (GFIC, GFMETH) are written only once its parse returns (`_gen_inst_record`), from the instance being parsed:
# `mt<f64>`, `P.gm<f64>` (a refusal there printed `mt$f64`, `P_gm$f64`). CHANGELOG [6.7.16]
fn _cur_fn_src(S): i64 {
    var fi = _cur_fn_ix;
    var nm = L64(_fnt_names + fi * 8);
    if (_inst_base_fi >= 0) { if (_gen_inst_of(S, fi, _inst_base_fi) == 1) {
            return _fsn_spell(S, nm, GFMETH(S, _inst_base_fi), _inst_conc0, _inst_conc1);
        } }
    return _fn_src_name(S, fi, nm);
}
# Type `c` (a scalar code, a vector sentinel, a 1-based struct id) as the source spells it — a struct instance
# `Box<Pt>`, never the table's `Box$Pt` — at GNPOS uncommitted, as `_fn_src_name`'s. CHANGELOG [6.7.16]
fn _fsn_one(S, c): i64 {
    NPOS_GUARD(S, 1024);
    var b = GNPOS(S);
    var wp = _fsn_conc(S, b, c, b + 960, 0);
    store8(S + 0xEC00000 + wp, 0);
    return b;
}
# `_fn_src_name`'s spelling of the fn named `nm`: method record `mr` (0 none), type arguments `c0` / `c1` (0 none).
fn _fsn_spell(S, nm, mr, c0, c1): i64 {
    if (mr == 0) { if (c0 == 0) { return _fsn_dm(S, nm); } }   # 6.7.17: `B<i32>_add`
    NPOS_GUARD(S, 1024);
    var b = GNPOS(S);
    var lim = b + 960;
    var wp = b;
    if (mr != 0) {
        wp = _fsn_tn(S, wp, (mr >> 32) - 1, lim);   # 6.7.17: an instance as written
        wp = _fsn_lit(S, wp, ".", lim);
        wp = _fsn_put(S, wp, mr & 0xFFFFFFFF, lim, 1);
    } else { wp = _fsn_put(S, wp, nm, lim, 1); }
    if (c0 != 0) { wp = _fsn_targs(S, wp, c0, c1, lim, 0); }
    store8(S + 0xEC00000 + wp, 0);
    return b;
}
# The name at pool offset `noff` written at `wp` (up to its first `$` when `cut` is 1), bounded by `lim`.
fn _fsn_put(S, wp, noff, lim, cut): i64 {
    var i = 0;
    var c = load8(S + 0xEC00000 + noff);
    while (c != 0) {
        if (cut == 1) { if (c == 36) { return wp; } }
        if (wp >= lim) { return wp; }
        store8(S + 0xEC00000 + wp, c);
        wp = wp + 1;
        i = i + 1;
        c = load8(S + 0xEC00000 + noff + i);
    }
    return wp;
}
# A literal string written at `wp`, bounded by `lim`.
fn _fsn_lit(S, wp, str, lim): i64 {
    var i = 0;
    while (load8(str + i) != 0) {
        if (wp >= lim) { return wp; }
        store8(S + 0xEC00000 + wp, load8(str + i));
        wp = wp + 1;
        i = i + 1;
    }
    return wp;
}
# `<c0>` or `<c0, c1>`: an instance's type arguments as written (`depth` bounds a nested struct instance).
fn _fsn_targs(S, wp, c0, c1, lim, depth): i64 {
    wp = _fsn_lit(S, wp, "<", lim);
    wp = _fsn_conc(S, wp, c0, lim, depth);
    if (c1 != 0) {
        wp = _fsn_lit(S, wp, ", ", lim);
        wp = _fsn_conc(S, wp, c1, lim, depth);
    }
    return _fsn_lit(S, wp, ">", lim);
}
# One type argument `c` (a scalar code, a vector sentinel, a 1-based struct id) as the source spells it.
fn _fsn_conc(S, wp, c, lim, depth): i64 {
    if (c > 0) {
        var sn = L64(S + 0x1A6018 + (c - 1) * 8);
        var g = _sinst_base(c);
        if (g <= 0) { return _fsn_put(S, wp, sn, lim, 0); }
        if (depth >= 4) { return _fsn_put(S, wp, sn, lim, 0); }
        wp = _fsn_put(S, wp, sn, lim, 1);
        return _fsn_targs(S, wp, _sinst_conc(S, c, g, 0), _sinst_conc(S, c, g, 1), lim, depth + 1);
    }
    if (c <= 0 - 2048) { return _fsn_vec(S, wp, (0 - c) - 2048, lim); }
    return _fsn_lit(S, wp, _fsn_scalar(c), lim);
}
fn _fsn_scalar(c): i64 {
    if (c == 0 - 8) { return "i64"; }
    if (c == 0 - 9) { return "f64"; }
    if (c == 0 - 4) { return "i32"; }
    if (c == 0 - 2) { return "i16"; }
    if (c == 0 - 1) { return "i8"; }
    if (c == 0 - 16) { return "Result"; }
    if (c == 0 - 17) { return "Option"; }
    if (c == 0 - 18) { return "Tagged"; }
    if (c == 0 - 19) { return "cstring"; }
    return "?";
}
# A vector type from its descriptor (`_vec_desc`'s packing): f / i / u, the lane bits, `v`, the lane count.
fn _fsn_vec(S, wp, desc, lim): i64 {
    var k = "u";
    if ((desc & 1) == 1) { k = "f"; }
    elif ((desc & 2) == 2) { k = "i"; }
    wp = _fsn_lit(S, wp, k, lim);
    wp = _fsn_num(S, wp, 8 << ((desc >> 2) & 7), lim);
    wp = _fsn_lit(S, wp, "v", lim);
    return _fsn_num(S, wp, 1 << ((desc >> 5) & 7), lim);
}
# A number below 100 written in decimal.
fn _fsn_num(S, wp, n, lim): i64 {
    if (wp + 2 >= lim) { return wp; }
    if (n >= 10) { store8(S + 0xEC00000 + wp, 48 + n / 10); wp = wp + 1; }
    store8(S + 0xEC00000 + wp, 48 + n % 10);
    return wp + 1;
}
# ⛔ 6.7.15 — AN ARGUMENT IS NAMED AS THE SOURCE SPELLS IT. A refused dereference argument was quoted as `*` and its
# operand's LAST name — `ri(*gp(pb))` as '*pb', `ri(*&b)` '*b', `ri(*h.pv)` '*pv', `ri(**ppb)` '*ppb' (`_hl_lastnm`).
# The tokens [a, e) — the operand `gp(pb)`, `&b`, `h.pv`, `*ppb`, `(pb)` — written from the source at GNPOS + 1024,
# uncommitted, past `_fn_src_name`'s scratch so one message may print both: each token's own bytes, one space where
# the source has any between two (a comment or a line break is one space too). `dflt` when the tokens have no source
# spelling in order (a token the parser made). CHANGELOG [6.7.15]
fn _src_span_nm(S, a, e, dflt): i64 {
    if (e <= a) { return dflt; }
    NPOS_GUARD(S, 2048);
    var b = GNPOS(S) + 1024;
    var lim = b + 960;
    var wp = b;
    var pend = 0;
    var i = a;
    while (i < e) {
        var o = GTOFF(S, i);
        var nx = GTOFF(S, i + 1);
        if (o <= 0) { return dflt; }
        if (nx <= o) { return dflt; }
        if (nx > GBL(S)) { return dflt; }
        var q = _ssn_tok_end(S, i, o, nx);
        if (i > a) { if (o > pend) { wp = _fsn_lit(S, wp, " ", lim); } }
        while (o < q) {
            if (wp >= lim) { o = q; }
            else {
                store8(S + 0xEC00000 + wp, load8(S + 0x459D000 + o));
                wp = wp + 1;
                o = o + 1;
            }
        }
        pend = q;
        i = i + 1;
    }
    store8(S + 0xEC00000 + wp, 0);
    return b;
}
# The end of token `i`'s text, which starts at source offset `o` (the next token at `nx`): the first space, line break
# or `#` comment before `nx`; a string literal runs to its closing quote.
fn _ssn_tok_end(S, i, o, nx): i64 {
    var q = o;
    if (TOKTYP(S, i) == 30) {
        q = o + 1;
        while (q < nx) {
            var cs = load8(S + 0x459D000 + q);
            if (cs == 34) { return q + 1; }
            if (cs == 92) { q = q + 1; }
            q = q + 1;
        }
        return nx;
    }
    while (q < nx) {
        var c = load8(S + 0x459D000 + q);
        if (c == 32 || c == 9 || c == 10 || c == 13 || c == 35) { return q; }
        q = q + 1;
    }
    return q;
}
# The method record for fn `fi` just registered at a definition inside an impl (pass 1: `_impl_tnoff` is the
# impl's type, token `nti` the method's own name), or at a call `x.m(..)` of type name `tn` (`_mcall_note`).
fn _fn_meth_note(S, fi, tn, mn): i64 {
    if (fi < 0) { return 0; }
    SFMETH(S, fi, ((tn + 1) << 32) | mn);
    return 0;
}
fn _prescan_meth_note(S, fi, nti): i64 {
    if (_impl_tnoff == 0) { return 0; }
    if (TOKTYP(S, nti) != 2) { return 0; }
    return _fn_meth_note(S, fi, _impl_tnoff, TOKVAL(S, nti));
}

# 6.7.14 — 1 while a METHOD form's arity is judged (`o.m(..)`, a dyn call): `self` is no argument as written, so
# the message counts without it — "'S.two' expects 1 argument, got 2" for `s.two(1, 2)` (it said "'S_two' expects 2
# arguments, got 3"). The free spelling `S_two(&s, 1, 2)` counts its `&s`, as written; a method declaring no
# parameter at all (`o.zero()` on `fn zero()`) keeps the receiver in the count, the one extra. CHANGELOG [6.7.14]
var _ar_self = 0;
fn _check_arity_p0(S, line, noff, fi, argc, need_off, p0): i64 {
    _ar_self = p0;
    _CHECK_ARITY(S, line, noff, fi, argc, need_off);
    _ar_self = 0;
    return 0;
}

# ⭐ THE CALL-SITE ARITY CHECK (v6.2.41; an error since v6.5.1), shared by every call path — the one
# marshaller (PARSE_FNCALL, the method form, the struct-valued receives), the inline replay, the
# tail arm and the operator dispatches — so the diagnostic is one. A count mismatch is never
# intentional: there is no overloading by arity. The count must lie in min..max: max is the
# parameter count, min the first defaulted parameter's index (6.7.7; a fn without defaults has
# min = max, and the message is the v6.5.1 text, byte for byte).
# ⛔ 6.7.7 (fork F2, user 2026-10-09) — EVERY CALL TO A FN PASS 1 RECORDED IS CHECKED, A FORWARD ONE
# INCLUDED. The check used to skip any callee whose body was not yet emitted (offset -1: "pc not
# yet known"), so `g(1, 2)` to a `fn g(a)` defined further down built and dropped the 2 — on every
# path (plain, too few, a method, a tail call, a fn inside a top-level block). But pass 1 records
# every definition's parameter count (v6.3.5) and stamps its GFDS (6.6.5) before pass 2 parses any
# call; a name no definition registered (REGFN at the call, GFDS 0) keeps the skip and ends in the
# undefined-function diagnostic. VARIADICS (GFVA) take any tail; `syscall` has its own path.
# `need_off` names the path: 0 = the inline replay (its callee always has a body), 1 = a direct
# call (the marshaller fills a short call's defaults after this check), 3 = the tail arm (it never
# fills: `_tc_args_divert` sends such a call to PARSE_FNCALL), 4 = an operator dispatch (exactly two
# operands; an operator fn takes no default, D19) — `_pd_arity_mode`.
# CHANGELOG [6.2.41] [6.5.1] [6.7.7]
fn _CHECK_ARITY(S, line, noff, fi, argc, need_off): i64 {
    if (need_off != 0) { if (L64(_fnt_offsets + fi * 8) < 0) { if (GFDS(S, fi) == 0) { return 0; } } }
    if (GFVA(S, fi) != 0) { return 0; }
    var pc = L64(_fnt_params + fi * 8);
    if (_pd_row(fi) != 0) { if (_pd_arity_mode(S, line, noff, fi, argc, need_off) == 1) { return 0; } }
    if (_ar_trail(S, fi) == 1) { return 0; }   # 6.7.17: `f(1,)` / `fn f(a,)` — refused at the `,)`, no count to judge
    var mn = _pd_min(fi);
    if (argc >= mn) { if (argc <= pc) { return 0; } }
    # v6.5.1 — ERROR, not warning. A call with the wrong argument count cannot
    # produce correct code: the surplus parameter is bound to whatever happens to
    # be in the register or stack slot. This was a *warning* for its entire life and
    # cyrius emitted a binary anyway, which is how `bayan_json_v_parse(someStr)`
    # returned 0 for every input right across the ecosystem with no outward sign but
    # one easily-missed line in build output. Verified safe to escalate: the whole
    # repo — 253 .tcyr, all 7 main forks, programs/ — produces ZERO of these.
    #
    # Deliberately does NOT set `_panic`: an arity mismatch is not a token-stream
    # desync, so the parse continues normally and ONE compile reports EVERY bad call
    # site (the v6.4.62 multi-error contract). `_had_error` alone withholds the binary.
    # 6.7.15: once per call and text (`_derr_seen`, at the call's `(`) — a generic body is parsed per instance.
    if (_derr_seen(_ar_site(S), "_CHECK_ARITY", ((fi * 31 + noff) * 1024 + argc) * 2 + _ar_self, 0) == 1) { return 0; }
    _ew("error:", 6);
    FM_LOOKUP(S, line);
    _ew(": '", 3);
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));   # 6.7.14: `S.two`, `g<i32>`
    _ew("' expects ", 10);
    var sf = _ar_self;    # 6.7.14: a method form counts as written, without `self` —
    if (pc == 0) { sf = 0; }   # unless the method takes no parameter: then the receiver is the extra one
    mn = mn - sf;
    if (mn < 0) { mn = 0; }
    pc = pc - sf;
    if (mn != pc) { PRNUM(mn); _ew(" to ", 4); }   # 6.7.7: "1 to 3 arguments"
    PRNUM(pc);
    _ew(" argument", 9);
    if (pc != 1 || mn != pc) { _ew("s", 1); }
    _ew(", got ", 6);
    PRNUM(argc - sf);
    _ew("\n", 1);
    _had_error = 1;
    return 0;
}

# The token an arity report is keyed on: the `(` of the call that just closed — the cursor is past its `)` (a call,
# an inline replay) or its `)` and `;` (the tail arm), so every path that checks one call agrees — else the cursor
# (an operator's dispatch). CHANGELOG [6.7.15]
fn _ar_site(S): i64 {
    var t = GTI(S) - 1;
    if (t < 1) { return GTI(S); }
    if (TOKTYP(S, t) == 5) { t = t - 1; }
    if (TOKTYP(S, t) != 11) { return GTI(S); }
    var d = 0;
    while (t >= 0) {
        var k = TOKTYP(S, t);
        if (k == 11) { d = d + 1; }
        if (k == 10) {
            d = d - 1;
            if (d == 0) { return t; }
        }
        t = t - 1;
    }
    return GTI(S);
}

# ⛔ 6.7.3 — A STRUCT ARGUMENT WAS NEVER TYPE-CHECKED AGAINST ITS PARAMETER, except a struct-typed
# FIELD into an address-passed one (`_fla_addr`, 6.6.12). `bq(p)` with `p: Pt` and `fn bq(b: Q)`
# compiled clean and read past the 16-byte Pt (0, or 97 from a global, or SIGSEGV for an operator),
# from a local, a global, a capture, a call, a method result, a tail call, a generic, a method's
# `self` and an operator's operands alike — while `var q: Q = p;` has been refused since 6.6.6.
# The argument's STATIC struct (`asid`, 0 = untyped / scalar / unknown: accepted as ever, which
# keeps `&p`, a literal and an untyped value passing) against the parameter's recorded struct
# (GFPSID — the instance's for a generic; a by-value struct of 8 B or less and a `Str` handle are
# recorded too since 6.7.3, `_psid_plain`): when both are known and differ, refused by name, in
# the field arm's words. The argument is still pushed, so the parse stays in step and the one
# compile reports every bad site; `_had_error` withholds the binary. Returns 1 after reporting.
# CHANGELOG [6.7.3]
fn _sarg_type_err(S, fi, argc, asid, anoff): i64 { return _sarg_type_errf(S, fi, argc, asid, anoff, 0 - 1); }
# ... `anoff` the result of a call to fn `afi` (a struct-call record's `_sc_fi`; -1: a name as written), which the
# refusal names as the source spells it — a method `S2.dup`, not its fn name `S2_dup` (`_sarg_ident_err`).
# CHANGELOG [6.7.14]
fn _sarg_type_errf(S, fi, argc, asid, anoff, afi): i64 {
    if (fi < 0) { return 0; }
    if (asid <= 0) { return 0; }
    if (asid >= 2048) { return 0; }    # a vector descriptor: not this rule
    var ps = GFPSID(S, fi, argc);
    if (ps <= 0) { return _sarg_svec_err(S, fi, argc, anoff, afi); }   # 6.7.13 (D33): a `*V` records no struct
    if (ps == asid) { return 0; }
    _sarg_ident_err(S, "cannot pass ", _ess_anm(S, anoff), afi, " to a parameter of a different struct type in a call to ", fi);
    return 1;
}
# ⛔ 6.7.16 — A REFUSED DEREFERENCE ARGUMENT IS NAMED AS THE SOURCE SPELLS IT, FROM ITS `*`: `take8(*gu(pu))` is
# '*gu(pu)', as 6.7.15's address-passed arm names it (`_dro_nm`); it was the operand's last name, 'pu'. `anoff` -2 is the
# whole dereference `_ess_deref` typed last ([`_ess_da`, `_ess_de`)), rendered here, at the refusal — the span's scratch
# (`_src_span_nm`) is uncommitted, so it is never rendered before another argument's parse; else `anoff` itself.
# CHANGELOG [6.7.16]
fn _ess_anm(S, anoff): i64 {
    if (anoff != 0 - 2) { return anoff; }
    return _src_span_nm(S, _ess_da, _ess_de, _ess_nm);
}
# ERR_IDENT for an argument refusal: the argument `anoff` — the result of a call to fn `afi`, or (-1) a name — and the
# callee `fi`, each as the source spells it (`_fn_src_name`). The helper writes at one scratch, so the two names are
# printed one after the other, not passed as ERR_IDENT's two offsets. CHANGELOG [6.7.14]
fn _sarg_ident_err(S, msg, anoff, afi, tail, fi): i64 {
    var cn = L64(_fnt_names + fi * 8);
    if (afi < 0) { return ERR_IDENT(S, msg, anoff, tail, _fn_src_name(S, fi, cn)); }
    if (_err_once(S, (((msg * 31 + anoff) * 31 + tail) * 31 + cn) * 8 + 3) == 0) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": ");
    PRSTR(msg);
    PRSTR("'");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, afi, anoff));
    PRSTR("'");
    PRSTR(tail);
    PRSTR("'");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, cn));
    PRSTR("'\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# ⛔ 6.7.13 (D33 A, the user's decision, 2026-10-15) — A STRUCT VALUE INTO A `*V` PARAMETER IS REFUSED BY NAME. `rd(s)`
# with `p: *f64v2` and `s: Pt` — a local, a call result, `*ps`, a global, a closure's capture — passed the struct's
# address and the callee read its bytes as the vector (42 on every target, silently): a `*V` records no struct
# (GFPSID), so `_sarg_type_err` compared nothing. It is the mirror of 6.7.3 (another struct into `*S`), 6.7.11 A2
# (another vector into `*V`) and D27 (a vector into another pointer kind); `rd(&s)` stays the explicit conversion
# (a plain pointer converts freely). The struct argument `anoff` (every struct arm's `_sarg_type_err`) to parameter
# `argc` of `fi` that records no struct: 1 = refused (the push follows, no binary), 0 = not a `*V`. CHANGELOG [6.7.13]
# 6.7.14: `afi` as `_sarg_type_errf`'s — a method result is named `S2.dup`. CHANGELOG [6.7.14]
fn _sarg_svec_err(S, fi, argc, anoff, afi): i64 {
    if (_pvec_param(S, fi, argc) == 0) { return 0; }
    _sarg_ident_err(S, "cannot pass ", _ess_anm(S, anoff), afi, " to a parameter that is a pointer to a vector type in a call to ", fi);
    return 1;
}
# The struct a WHOLE free call `name(..)` / `name<..>(..)` at the cursor returns (the instance's,
# for a generic), or 0. Moves nothing. Resolves the call (`_gen_resolve_call`), so it is called
# only where `_arg_call_class` already resolves it, or after the argument's own parse (a dedup hit).
fn _sarg_call_sid(S, ti): i64 {
    var o = _gcall_open(S, ti);
    if (o < 0) { return 0; }
    if (_call_dotted(S, ti) == 1) { return 0; }
    if (_call_is_whole_arg(S, o - 1) == 0) { return 0; }
    return _sarg_call_rs(S, ti);
}
# ... the struct the call at `ti` returns, once it is known to be the whole argument.
fn _sarg_call_rs(S, ti): i64 {
    var cfi = _gen_resolve_call(S, ti);
    if (cfi < 0) { return 0; }
    if (_grc_err < 0) { return 0; }    # a failed instantiation refuses itself, once
    var rs = GFRS(S, cfi);
    if (rs <= 0) { return 0; }
    if (rs >= 2048) { return 0; }
    return rs;
}
# The static struct of the NAME at token `ti`: a struct-typed local (inline, pointer-mode or `*T`
# — `_sl_ptr_type` records -sid for those too), a captured struct, or a recorded aggregate global,
# looked up in the order the argument arms push them; 0 = untyped / scalar / vector / unknown.
fn _sarg_name_sid(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var nm = TOKVAL(S, ti);
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, nm);
        if (li >= 0) {
            # A typed POINTER (`u: *Pt`, a local or a `p: *T` parameter — bit 56) converts freely, as
            # `&p`, an untyped pointer and the receive path's `var q: *Q = u;` do (the user's
            # decision, 2026-10-08): only a struct VALUE of another type is refused.
            if (GLPTRP(S, li) == 1) { return 0; }
            var lt = GLTYPE(S, li);
            if (lt >= 0) { return 0; }
            if (lt <= 0 - 2048) { return 0; }
            return 0 - lt;
        }
        if (_CL_CAP_FIELD_IDX(S, nm) < 0 - 1) { return _cap_fld_sid; }
    }
    return _sarg_gv_sid(S, FINDVAR(S, nm));
}
# A global's struct: only a recorded aggregate (GVPM, `_var_ptrmode`) — GVTYPE's positive range is
# shared with scalar widths, so nothing else is read as one (see `_push_struct_addr_global`).
fn _sarg_gv_sid(S, gvi): i64 {
    if (gvi < 0) { return 0; }
    if (GVPM(S, gvi) == 0) { return 0; }
    var vt = GVTYPE(S, gvi);
    if (vt <= 0) { return 0; }
    if (vt >= 2048) { return 0; }
    return vt;
}

# v6.3.36 (issue [5]) — if callee `fi` declares param `argc` as a plain struct >8 B
# (bit set in its _fnt_structmask) AND the current arg is a bare struct-typed local
# identifier (`foo(s)`, next token `,` or `)`), push the local's ADDRESS instead of
# its first-8-bytes value: the callee derefs a >8-byte struct param as a pointer
# (v6.3.16 lf_is_ptr), so a value would be dereffed-as-address → SIGSEGV. Returns 1
# when handled (IDENT consumed); 0 leaves the cursor untouched for the normal PCMPE
# value push. The CALLEE-mask gate is the reliable discriminator — cyrius tags both
# inline structs and struct-handles (Str, str_new_a results) with SLTYPE=-sid and
# reuses the -1 slot sentinel for freed block locals, so no arg-side heuristic works;
# the callee's declared param type does. Str/Result/Option/Tagged/scalar params keep
# their mask bit clear → value-passed (fixes the str_split/toml/vec_push_a regression).
fn _try_push_struct_addr_arg(S, fi, argc, tail): i64 {
    if (fi < 0) { return 0; }
    if (_pm_struct(fi, argc) == 0) { return _sarg_vdo(S, fi, argc); }   # 6.6.17 (a10); 6.7.3 (6.7.14: `_sarg_vdo`)
    var pvf = _sarg_pe_vform(S, fi, argc, tail);   # 6.7.14: Win64's value-form vector parameter, `_sar_src`'s sources
    if (pvf >= 0) { return pvf; }
    if (_dyn_sarg(S, fi, argc, tail) == 1) { return 1; }   # 6.7.8 (D5): a dyn formed in a temp
    # 6.7.16: `gg<Str>(*p)` — an instance's `x: T` at T = Str is address-passed; `*p` passes p, the header.
    if (_sarg_istr_dx(S, fi, argc) == 1) { return 1; }   # CHANGELOG [6.7.16]
    if (PEEKT(S) == 10) { if (_vmc_phead(S, GTI(S)) < 0) { return _sarg_paren(S, fi, argc, tail); } }   # 6.7.6 (6.7.16: no `(*ps).mv()`)
    if (_sarg_vec_call(S, fi, argc, tail) == 1) { return 1; }   # 6.7.12 (D27): `rd(mkv(..))` into `*V`
    # 6.7.10 (decision 11): `take(*p + a)` — a dereference-led operator result over 8 B is a struct
    # value with a temp, as `take(w.s + a)` is; it fell to the value push (its first word as the address).
    # (ops-5) A whole dereference `take(*p)` passes its pointer (`_sarg_deref`).
    if (PEEKT(S) == 8) { return _sarg_deref(S, fi, argc, tail); }
    # 6.7.11: `take(fncall1(&mk3, 5))` — a known callee's struct result has a temp, as `take(mk3(5))`.
    if (_icall_sid_at(S, GTI(S)) > 0) { return _push_struct_expr_arg(S, fi, argc, tail); }
    if (_icall_dotted(S, GTI(S)) == 1) { return _push_struct_expr_arg(S, fi, argc, tail); }   # 6.7.16
    _tup_arg_lit(S, fi, argc);   # 6.7.14's D44 `take(5)`, 6.7.15's D36 `take(-5)`: refused, pushed as before
    if (PEEKT(S) != 2) { return 0; }
    var nx = TOKTYP(S, GTI(S) + 1);
    # 6.7.3: a whole free call's struct, checked here — where `_arg_call_class` resolves it anyway.
    if (nx == 10 || nx == 19) {
        _sarg_type_err(S, fi, argc, _sarg_call_sid(S, GTI(S)), PEEKV(S));
        if (_tup_arg_call(S, fi, argc) == 1) { return 0; }   # 6.7.7 (B4): `g(f())`, f multi-value
        if (_mv_arg_call(S, fi, argc) == 1) { return 0; }    # 6.7.11: ... into a named struct
    }
    # ⛔ 6.6.6 — a by-value struct param given a struct-valued CALL (`h(mk(1, 2))`): the callee
    # takes the struct's ADDRESS, so the result needs storage to point at. It used to be pushed
    # as a value — the first word for a rax:rdx return (the callee then dereferenced a field),
    # and for a retptr return a call with no retptr at all (SIGSEGV). Top level has no frame: a
    # retptr callee falls through to PARSE_FNCALL, which refuses it by name; a rax:rdx one is
    # refused here (as first committed it fell through too, and PARSE_FNCALL refuses only the
    # retptr class, so `hy(p2(1, 2))` compiled clean and SIGSEGV'd). CHANGELOG [6.6.6]
    if (nx == 10) { if (GINFN(S) != 1) { return _refuse_toplevel_struct_arg(S); } }
    # 6.6.20: and `h(mkg<S1>(..))` at top level (it fell to the value push).
    if (nx == 19) { if (GINFN(S) != 1) { if (_call_dotted(S, GTI(S)) == 0) {
                if (_gcall_open(S, GTI(S)) >= 0) { return _refuse_toplevel_struct_arg(S); }
            } } }
    # 6.6.10 (bite 7 review): an explicit `idp<i32>(4)` too — it fell to the value push (SIGSEGV).
    var o = 0 - 1;
    if (GINFN(S) == 1) { o = _gcall_open(S, GTI(S)); }
    if (o >= 0) {
        # 6.6.12: `take(mk(p).v)` — the argument is a FIELD of the result, taken like `take(b.v)`.
        if (_call_dotted(S, GTI(S)) == 1) { return _push_struct_expr_arg(S, fi, argc, tail); }
        if (_arg_call_class(S) == 0) { return 0; }   # 6.6.10: the instance's class
        # 6.7.6: a struct call that is only the LEFT operand (`sz(mk(1) + a)`) dispatches its
        # operator fn, whose struct result takes the operator path's temp, as `sz(a + mk(1))`.
        if (_call_is_whole_arg(S, o - 1) == 0) { return _push_struct_expr_arg(S, fi, argc, tail); }
        _sarg_escapes(fi, argc, tail);   # 6.6.20: a temp in this frame
        EFLADDR(S, _struct_call_into_temp(S));
        EPUSHR(S);
        return 1;
    }
    # 6.6.6 (bite 14 review): any other expression — a method call or an operator returning the
    # struct takes its temp's address; everything else is pushed as its value. CHANGELOG [6.6.6]
    if (nx != 31) { if (nx != 11) { return _push_struct_expr_arg(S, fi, argc, tail); } }
    var li = 0 - 1;
    if (GINFN(S) == 1) { li = FINDLOCAL(S, PEEKV(S)); }
    if (li < 0) {
        if (_sarg_vec_cap(S, fi, argc) == 1) { return 0; }   # 6.7.13 (D32): a captured vector, the local's rules
        if (_push_struct_addr_cap(S, fi, argc) == 1) { return 1; }
        return _push_struct_addr_global(S, fi, argc);
    }
    var lt = GLTYPE(S, li);
    if (lt >= 0) { return 0; }          # must be a struct-typed local (SLTYPE = -sid)
    # v6.4.31: on SysV/aarch64 a SIMD local is register-passed (XMM/V) — never
    # address-passed — so reject it here. On Win64 PE it IS address-passed (MS
    # x64 by-pointer ABI), so let it flow through: push &local as the pointer.
    # ⛔ 6.6.5 — POINTER-MODE vs INLINE. This pushed `&slot` unconditionally, which is right
    # for an inline stack struct (the slot IS the struct) and WRONG for a pointer-mode local
    # (the slot HOLDS the struct's address): the callee then deref'd a pointer-to-pointer and
    # read the address itself as field 0. Measured on 6.6.4, silent and not a crash —
    # `var b: HB = alloc(24); b.a = 10; ...; f(0, b)` printed 140545185808389 where 42 is
    # right. Same discrimination `_resolve_field_base_addr` and the method-`self` push use:
    # the -1 slot-marker predecessor plus the <=8 B single-slot rule.
    # ⚠ NOT for SIMD. A value-form SIMD local is always inline, and on PE it is address-passed
    # by the MS x64 by-pointer ABI; its SLTYPE lives in the descriptor band (<= -2048) where
    # `STRUCTSZ` has no entry, so it must skip the test entirely rather than answer it wrong.
    # CHANGELOG [6.6.5]
    var _sa_ptr = 0;
    if (_is_simd_any(S, lt) == 1) { if (_sarg_vec_ptr(S, fi, argc, lt) == 0) { return 0; } }   # 6.7.11
    else {
        if (GLPTRP(S, li) == 0) { _sarg_type_err(S, fi, argc, 0 - lt, PEEKV(S)); }   # 6.7.3 (a `*T` converts: _sarg_name_sid)
        _sa_ptr = _local_struct_is_ptr(S, li, lt);
    }
    # 6.6.20: an inline aggregate (a by-value parameter's copy too, 6.6.16 C7) is pushed as an
    # address in this frame, exactly as `&s` is — see `_sarg_escapes`.
    if (_sa_ptr == 1) { EFLLOAD(S, li); } else { _sarg_escapes(fi, argc, tail); EFLADDR(S, li); }
    EPUSHR(S);
    STI(S, GTI(S) + 1);                 # consume IDENT
    return 1;
}

# ⛔ 6.7.11 — A VECTOR PASSED TO A `*V` PARAMETER PASSES ITS ADDRESS, as a struct passed to a `*T`
# parameter does (6.6.20); a vector of ANOTHER type is refused by name, as a struct of another type is
# (6.7.3). The user's decision, 2026-10-13: (a). Vector local (SLTYPE `lt`, the cursor on its name)
# as argument `argc` of `fi`: 1 = push its address (the caller's arm), 0 = the value push. A
# value-form vector parameter is not this rule: SysV / aarch64 / cx never reach here (the SIMD
# mask routes it), nor does Win64 (6.7.14: `_sarg_pe_vform` takes it first). (A `*V` local's SLTYPE is 0: its value.)
fn _sarg_vec_ptr(S, fi, argc, lt): i64 {
    var r = _svp_rule(S, fi, argc, lt);
    if (r >= 0) { return r; }
    return _TARGET_PE;
}
# The pointer rules a vector of type `lt` meets as argument `argc` of `fi` (the cursor on its name): a `*V` of its
# type 1 (the address is passed), another vector type refused by name (A2) and 1; a pointer of another kind (D27) or
# a by-value struct (D31) refused by name, 0; -1 = no pointer parameter (a value-form vector, a word).
fn _svp_rule(S, fi, argc, lt): i64 {
    var pv = _pvec_param(S, fi, argc);
    if (pv == 0) {
        if (_pptr_param(S, fi, argc) == 1) { return _vec_kind_err(S, PEEKV(S), fi); }   # 6.7.12 (D27)
        if (_vk_param(S, fi, argc) == 2) { return _vec_val_err(S, 0, PEEKV(S), fi, 2); }   # 6.7.13 (D31): a by-value struct
        return 0 - 1;
    }
    if (pv != 0 - lt) {
        ERR_IDENT(S, "cannot pass ", PEEKV(S), " to a parameter of a different vector type in a call to ",
          _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    }
    return 1;
}
# ⛔ 6.7.13 (D32 A, the user's decision, 2026-10-15) — A CLOSURE'S CAPTURED VECTOR MEETS THE LOCAL'S ARGUMENT
# RULES. Inside a closure `|k| ri(b)` / `|k| rp(b)` (`p: *i64` / `p: *Pt`) passed the capture's address and ran (42),
# where `ri(b)` / `rp(b)` on the local are refused by name (D27): the capture never reached the vector arm
# (`_CL_CAP_FIELD_IDX` takes a struct capture only), so the value push — a multi-word capture's value is its address —
# went out unchecked. The name at the cursor, a captured vector (`_cl_cap_vec`), as argument `argc` of an
# address-passed parameter of `fi`: `_svp_rule` (a `*V` of its type, another vector type, another pointer kind, a
# by-value struct) — 1, and the caller's value push is the capture's address (`&env[woff]`, right for a `*V`; refused
# otherwise, no binary). 0 = no captured vector. CHANGELOG [6.7.13]
fn _sarg_vec_cap(S, fi, argc): i64 {
    var lt = _cl_cap_vec(S, PEEKV(S));
    if (lt == 0) { return 0; }
    _svp_rule(S, fi, argc, lt);
    return 1;
}
# The vector type (its SLTYPE, <= -2048) of the enclosing local `noff` names when a capturing closure's body has
# captured it, else 0.
fn _cl_cap_vec(S, noff): i64 {
    if (_cl_capturing != 1) { return 0; }
    if (_cl_env_lidx < 0) { return 0; }
    var esl = _cl_snap_find(S, noff);
    if (esl < 0) { return 0; }
    if (_cl_cap_find(esl) < 0) { return 0; }
    var t = _cl_snap_type(esl);
    if (_is_simd_any(S, t) == 0) { return 0; }
    return t;
}
# ⛔ 6.7.14 — ON WIN64 A VALUE-FORM VECTOR PARAMETER TAKES WHAT SYSV'S `_sar_src` TAKES. Win64 passes it by address,
# under the struct mask, so the SIMD mask's check never ran there and the struct arms took its argument: a vector local
# of another type had its address pushed unchecked (an f64v4 into `v: f64v2` exited 2, an f64v2 into `v: f32v4` 0, an
# f32v8 into `v: f64v2` 3; 6.7.13 checked the 32-byte parameters only), a struct local's two words were read as the
# lanes (42), and an identifier-led expression (`lanes(q + 1)`) pushed its VALUE as the address (5), where x86_64 /
# aarch64 / cx refuse each by name. Parameter `argc` of `fi` declared a value-form vector (`_pvf_param`), the cursor
# on its argument, before every struct arm: inside any parentheses wrapping all of it, the sources SysV takes
# (`_spv_one`: a local or a captured vector, checked by the class rule in SysV's words — `_simd_arg_typecheck`, which
# refuses a non-vector local too — and its address pushed; a `*V` dereference, its pointer; a vector call,
# `_sarg_vec_call`'s, whose refusal skips the argument as `_sar_vcall`'s does); anything else is refused by name
# (`_sar_err`), skipped to its `,` / `)` and 0 pushed — one line, no binary; a call naming no fn (6.7.14) is left to
# the value push (0), as `_sar_none` leaves it. 1 = pushed, -1 = no Win64 value-form parameter. It folds 6.7.13's
# `_sarg_pe_v32` (the 32-byte check) and `_sarg_pe_vword` (D30's word refusal).
# 6.7.14 (D33 A, the user's decision, 2026-10-16): an address-of `&w` is refused there too, with the other targets'
# words — Win64 alone passed it (the by-address ABI copied the vector it pointed at: 42), x86_64 / aarch64 / cx refuse
# it, and `var v: f64v2 = &w;` is refused on every target; `&` converts into a POINTER parameter (6.7.12's D27 B), not
# into a value. Its own-call receives route `f(&a, ..)` to `f_ptr` as PARSE_FNCALL does (`_pe_venter`).
# CHANGELOG [6.7.14]
fn _sarg_pe_vform(S, fi, argc, tail): i64 {
    if (_TARGET_PE != 1) { return 0 - 1; }
    var vf = _pvf_param(S, fi, argc);
    if (vf == 0) { return 0 - 1; }
    var ti = GTI(S);
    _sar_ti = ti;
    var c = _pwrap_in(S, ti);   # 6.7.14: inside parentheses wrapping the whole argument, as `_sar_take` reads it
    if (c < 0) { c = _vmc_phead(S, ti); }   # 6.7.16: a vector method on a parenthesised head, `(*ps).mv()`
    if (c >= 0) {
        STI(S, c);
        if (_spv_one(S, fi, argc, tail, vf) == 1) {
            _pw_close(S, c - ti);
            return 1;
        }
        STI(S, ti);
    }
    if (_vrcv_nofnw(S, ti, _arg_next(S, ti)) == 1) { return 0; }   # 6.7.14: the value push, as `_sar_none`
    _sar_err(S, ti, fi);
    return _spv_skip(S, ti);
}
# The source at the cursor, unwrapped, as `_sar_one` takes it: a local — checked by the class rule in SysV's words
# (`_simd_arg_typecheck`, reported at its end as the SysV record does) and its address pushed; (6.7.14, D31 A) a
# closure's captured vector — checked the same way, the address of its env words pushed (the callee copies them in);
# (D32 A) a whole dereference of a vector (`_sar_dsrc`) — checked the same way, its pointer pushed; a vector call —
# `_sarg_vec_call`'s (its refusal skips the source); 1 = pushed, 0 = no such source (nothing moved).
fn _spv_one(S, fi, argc, tail, vf): i64 {
    var c = GTI(S);
    var li = _spv_local(S, c);
    if (li >= 0) {
        STI(S, c + 1);
        _simd_arg_typecheck(S, _vf_cls(S, 0 - vf), GLTYPE(S, li), vf);
        _sarg_escapes(fi, argc, tail);
        EFLADDR(S, li);
        EPUSHR(S);
        return 1;
    }
    var t = _spv_cap(S, c);
    if (t != 0) {   # 6.7.14 (D31 A): a captured vector, checked as the local is; its env words' address
        STI(S, c + 1);
        _simd_arg_typecheck(S, _vf_cls(S, 0 - vf), t, vf);
        _cap_vaddr(S, TOKVAL(S, c));
        EPUSHR(S);
        return 1;
    }
    var vd = _sar_dsrc(S, fi);   # 6.7.14 (D32 A): a whole `*E` — its pointer, the address the callee copies from
    if (vd != 0 - 1) {
        if (vd > 0) { _simd_arg_typecheck(S, _vf_cls(S, 0 - vf), 0 - vd, vf); }
        else { EMOVI(S, 0); }
        EPUSHR(S);
        return 1;
    }
    if (_svc_rs(S, c) != 0) {
        if (_sarg_vec_call(S, fi, argc, tail) == 1) { return 1; }
        return _spv_skip(S, c);   # refused by `_sarg_vec_call`: another vector type, or at top level
    }
    return 0;
}
# The local a whole argument at token `ti` names (`,` or `)` after it), as `_sar_src` reads one; else -1.
fn _spv_local(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0 - 1; }
    var nx = TOKTYP(S, ti + 1);
    if (nx != 31) { if (nx != 11) { return 0 - 1; } }
    return FINDLOCAL(S, TOKVAL(S, ti));
}
# A refused argument at token `ti`: skipped to its `,` / `)` and 0 pushed, so the parse stays in step and the value
# parse adds no line of its own. 1.
fn _spv_skip(S, ti): i64 {
    STI(S, _arg_next(S, ti));
    EMOVI(S, 0);
    EPUSHR(S);
    return 1;
}
# The vector type (its descriptor sid) parameter `k` of fn `fi` points at when it is declared `*V`,
# read from the definition's tokens (a call above the definition has them too); 0 = not a `*V`.
fn _pvec_param(S, fi, k): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, k) == 0) { return 0; }
    var i = _dps_ts;
    if (TOKTYP(S, i) != 8) { return 0; }
    if (TOKTYP(S, i + 1) != 2) { return 0; }
    var tn = TOKVAL(S, i + 1);
    return _ptc_vec_sid(_classify_param_type(S, tn));
}
# The vector type (its descriptor sid) of parameter `k` of fn `fi` when it is a VALUE-form vector (`v: f64v2`), read
# from the definition's tokens as `_pvec_param` reads a `*V`; 0 = none. Win64 passes it by address, under the struct
# mask, so no SIMD mask names it there. CHANGELOG [6.7.13]
fn _pvf_param(S, fi, k): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, k) == 0) { return 0; }
    var i = _dps_ts;
    if (TOKTYP(S, i) != 2) { return 0; }
    return _ptc_vec_sid(_classify_param_type(S, TOKVAL(S, i)));
}
# 1 = parameter `k` of fn `fi` is declared a pointer (`p: *T`, `**T`, `*fn(..)`), read as `_pvec_param` reads it.
fn _pptr_param(S, fi, k): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, k) == 0) { return 0; }
    if (TOKTYP(S, _dps_ts) != 8) { return 0; }
    return 1;
}
# ⛔ 6.7.12 — A VECTOR LOCAL INTO A POINTER OF ANOTHER KIND IS REFUSED BY NAME (D27, the user, 2026-10-15: B —
# "another pointer kind refused by name"). `rp(b)` with `p: *Pt` and `ri(b)` with `p: *i64` pushed the
# vector's lane 0 as the address (139 on x86_64 and aarch64, a cx guest fault, exit 5 on PE; PE's `rp(b)`
# pushed `&b` by accident, 42): a vector is no `*Pt`, as a struct of another type is no `*S` (6.7.3). The
# name `noff` as an argument of `fi`; 0 (the value push keeps the parse in step, no binary is written).
fn _vec_kind_err(S, noff, fi): i64 {
    return _agg_kind_err(S, noff, fi, "vector");
}
# ... `kind` "vector" or "struct" (6.7.13 D5 (a), `_sarg_struct_other`).
fn _agg_kind_err(S, noff, fi, kind): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(GTI(S), "_agg_kind_err", (noff * 31 + fi) * 31 + kind, 0) == 1) { return 0; }   # 6.7.15: once
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": cannot pass '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("' to a parameter that is not a pointer to its ");
    PRSTR(kind);
    PRSTR(" type in a call to '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    PRSTR("' - pass &");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR(" for its address\n");
    _err_excerpt(S);
    _had_error = 1;   # no `_panic`: the parse is in step, so one compile reports every such argument
    return 0;
}
# ⛔ 6.7.13 (D31 A, the user's decision, 2026-10-15) — EVERY VECTOR VALUE INTO A POINTER OF ANOTHER KIND, OR INTO A
# BY-VALUE STRUCT PARAMETER, IS REFUSED BY NAME. D27 (6.7.12) refused a vector LOCAL into `*Pt` / `*i64`; a vector call
# result (`rp(mkv(42, 7))`, `ri(mkv(42, 7))`) and a `*V` dereference (`rp(*pb)`, `ri(*pb)`) are the same vector values
# D27 passes to a `*V`, and they still pushed lane 0 as the address (139 on x86_64 / aarch64, a cx guest fault, PE 5); a
# vector local into a by-value struct parameter (`bv(b)`, `p: Pt`) took lane 0 the same way off Win64, and on Win64
# passed `&b` by accident (42). Parameter `k` of fn `fi`, for a vector argument: 1 = a pointer of another kind (`*S`,
# `*i64`, `**T`, any `*T` that is no `*V`), 2 = a by-value struct (GFPSID: a plain struct of any size, a tuple),
# 0 = neither (a `*V`, a value-form vector, a word). CHANGELOG [6.7.13]
fn _vk_param(S, fi, k): i64 {
    if (_pptr_param(S, fi, k) == 1) {
        if (_pvec_param(S, fi, k) != 0) { return 0; }
        return 1;
    }
    var ps = GFPSID(S, fi, k);
    if (ps <= 0) { return 0; }
    if (ps >= 2048) { return 0; }
    return 2;
}
# The refusal of a vector value — the call or name `noff`, a dereference (`star` 1: `*noff`) — as an argument of `fi`
# whose parameter is of kind `kd` (`_vk_param`), at the cursor: D27's words for another pointer kind, "a vector is not
# a struct" for a by-value struct. No `_panic` (the value push keeps the parse in step, one compile reports every such
# argument). 0.
fn _vec_val_err(S, star, noff, fi, kd): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(GTI(S), "_vec_val_err", ((noff * 31 + fi) * 31 + kd) * 2 + star, 0) == 1) { return 0; }   # 6.7.15
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": cannot pass '");
    if (star == 1) { PRSTR("*"); }
    PRSTR(S + 0xEC00000 + noff);
    if (kd == 2) { PRSTR("' to a by-value struct parameter in a call to '"); }
    else { PRSTR("' to a parameter that is not a pointer to its vector type in a call to '"); }
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    if (kd == 2) { PRSTR("' - a vector is not a struct\n"); }
    else { PRSTR("'\n"); }
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}
# The same for a whole vector argument to parameter `argc` of `fi` that is not address-passed — a `*i64`, `*u8`,
# `**T` (D27, a LOCAL), or (6.7.13, D31) a by-value struct of 8 B or less — by its tokens: a vector local or (6.7.13,
# D32) a closure's captured vector (inside any parentheses wrapping the whole argument), or a call declared to return
# a vector (`_svc_rs`), inside any such parentheses too; a dereference is judged once parsed (6.7.14, `_sarg_vdo`).
# The cursor on the argument (`_sarg_byval_small`); nothing is consumed. 1 = refused.
fn _sarg_vec_other(S, fi, argc): i64 {
    var kd = _vk_param(S, fi, argc);
    if (kd == 0) { return 0; }
    var ti = _sarg_wname(S);
    if (ti >= 0) {
        if (GINFN(S) != 1) { return 0; }
        var li = FINDLOCAL(S, TOKVAL(S, ti));
        var lt = 0;
        if (li >= 0) { lt = GLTYPE(S, li); }
        else { lt = _cl_cap_vec(S, TOKVAL(S, ti)); }   # 6.7.13 (D32): a closure's captured vector too
        if (_is_simd_any(S, lt) == 0) { return 0; }
        if (kd == 1) { return _svo_err(S, ti, 2, TOKVAL(S, ti), fi, kd); }
        return _svo_err(S, ti, 0, TOKVAL(S, ti), fi, kd);
    }
    var c = _svo_inner(S);
    if (_svc_rs(S, c) != 0) { return _svo_err(S, c, 0, _svc_nm, fi, kd); }
    return 0;   # (6.7.14: a dereference is `_sarg_vdo`'s, once it is parsed)
}
# Report at token `ti`: `how` 2 = D27's local words (`_vec_kind_err`, with its `&` hint), 1 = a dereference, 0 = a name
# or call (`_vec_val_err`). 1.
fn _svo_err(S, ti, how, noff, fi, kd): i64 {
    var sv = GTI(S);
    STI(S, ti);
    if (how == 2) { _vec_kind_err(S, noff, fi); }
    else { _vec_val_err(S, how, noff, fi, kd); }
    STI(S, sv);
    return 1;
}
# The first token inside parentheses wrapping the whole argument at the cursor (ending at `,` / `)`), else the cursor.
fn _svo_inner(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti) != 10) { return ti; }
    var k = _pwrap_k(S, ti);
    var e = TOKTYP(S, _pw_end);
    if (e != 31) { if (e != 11) { return ti; } }
    return ti + k;
}
# ⛔ 6.7.14 — EVERY `*V` DEREFERENCE INTO A POINTER OF ANOTHER KIND OR A SMALL BY-VALUE STRUCT IS REFUSED BY NAME
# (6.7.13's D31 A: every vector value there is). `ri(**ppb)`, `ri(*gp(pb))`, `ri(*h.pv)`, `ri(*GPV)`, `ri(*(pb + 0))`,
# `ri(*&b)` into `p: *i64` (`*u8`, `**T`, a by-value struct of 8 B or less) pushed lane 0 as the address — 139 on x86_64
# / aarch64, a cx guest fault, PE 5, no diagnostic — where `rp(**ppb)` into `*Pt` and `ri(*pb)` were refused: this arm
# judged a dereference by its tokens (`* NAME` of a `*V` local, the retired `_svo_vderef`), the address-passed one by
# its operand's type once parsed (`_dlo_vec`). Parameter `argc` of `fi` not address-passed, of such a kind
# (`_vk_param`), the whole argument (inside any parentheses, `_svo_inner`) starting with `*`: that `*` is watched
# (`_dro_vo`) while `_sarg_byval_small` parses and pushes the argument as before; when its operand named a vector (the
# step word or an `&x` of one, `_dop_vd`) and ended the argument (`_dro_vnote`), the argument is refused by name —
# `cannot pass '**ppb' to a parameter that is not a pointer to its vector type in a call to 'ri'`, the argument as the
# source spells it (6.7.15, `_src_span_nm`; it was the operand's last name, '*ppb') — once, without `_panic`. A
# `*i64`'s `*ppi` and a `**Pt`'s `*pps` push their word as before. Returns as `_sarg_byval_small` does.
# CHANGELOG [6.7.14]
fn _sarg_vdo(S, fi, argc): i64 {
    var c = _svo_inner(S);
    if (TOKTYP(S, c) != 8) { return _sarg_byval_small(S, fi, argc); }
    var kd = _vk_param(S, fi, argc);
    if (kd == 0) { return _sarg_byval_small(S, fi, argc); }
    var vo = _dro_vo;
    var vd = _dro_vod;
    var ve = _dro_vend;
    _dro_vo = c;
    _dro_vod = 0;
    var r = _sarg_byval_small(S, fi, argc);
    if (_dro_vod != 0) { _svo_err(S, c, 1, _svo_nm(S, c + 1, _dro_vend), fi, kd); }
    _dro_vo = vo;
    _dro_vod = vd;
    _dro_vend = ve;
    return r;
}
# The name token of a whole argument at the cursor that is one name, inside any parentheses that wrap all of
# it, ending at `,` / `)`; -1 for any other shape.
fn _sarg_wname(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti) == 10) {
        var k = _pwrap_k(S, ti);
        var e = TOKTYP(S, _pw_end);
        if (e != 31) { if (e != 11) { return 0 - 1; } }
        ti = ti + k;
        if (TOKTYP(S, ti + 1) != 11) { return 0 - 1; }
    } else {
        var nx = TOKTYP(S, ti + 1);
        if (nx != 31) { if (nx != 11) { return 0 - 1; } }
    }
    if (TOKTYP(S, ti) != 2) { return 0 - 1; }
    return ti;
}
# ⛔ 6.7.13 — A STRUCT VALUE INTO A POINTER OF ANOTHER KIND IS REFUSED BY NAME (the user's decision D5 (a),
# 2026-10-15). `ri(s)` with `p: *i64` (`*u8`, `*f64`, `**T`, any `*T` whose T is no struct) and `s` an inline
# struct — a local, a by-value parameter, a value global, a closure's captured copy, any size — pushed s's
# first word as the address (139 on x86_64 / aarch64, a cx guest fault, exit 5 on PE): a struct is no `*i64`,
# as a vector is not (D27) and a struct of another type is no `*S` (6.7.3). The whole argument at the cursor
# (`_sarg_wname`) to parameter `argc` of `fi`, a pointer (`_pptr_param`) that is not address-passed (the
# caller, `_sarg_byval_small`) and records no struct (a `*Str` is the struct check's, 6.7.3). The name is an
# inline struct as `&` reads one (`_hl_amp_sid`): a handle, a `*T` and a `Str` (their word is the address)
# pass as before. 1 = refused: nothing consumed, the value push keeps the parse in step, no binary is
# written. CHANGELOG [6.7.13]
fn _sarg_struct_other(S, fi, argc): i64 {
    var ti = _sarg_wname(S);
    if (ti < 0) { return 0; }
    var noff = TOKVAL(S, ti);
    if (_hl_amp_sid(S, noff) <= 0) { return 0; }
    if (_pptr_param(S, fi, argc) == 0) { return 0; }
    if (GFPSID(S, fi, argc) > 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    _agg_kind_err(S, noff, fi, "struct");
    STI(S, sv);
    return 1;
}
# ⛔ 6.7.14 — EVERY STRUCT VALUE INTO A POINTER OF ANOTHER KIND IS REFUSED BY NAME, not only a name (6.7.13's D5 (a);
# its vector twin D31 refuses "at every source"). A struct-typed field `ri(w.s)`, a by-value struct call `ri(mk())`, a
# method or operator result `ri(o.m())`, a dereference `ri(*pp)` / `ri(**ppp)` of a `*S` — inside any parentheses that
# wrap the whole argument — into `p: *i64` (`*u8`, `**T`, any `*T` recording no struct) pushed the value's first word
# as the address (139 on x86_64 and aarch64, a cx guest fault, PE 5). The argument at the cursor, not a name (that is
# `_sarg_struct_other`'s), to parameter `argc` of `fi`, a pointer that is not address-passed and records no struct: it
# is parsed and pushed as the caller's fallback pushes it (PCMPE + EPUSHR, byte-identical), and refused when it is a
# plain struct value by the records `_expr_struct_sid` / `_ess_deref` read — a `*T` field, a `: *T` call or method and an
# address record none (their word is the address), and a `Str` / tuple / dyn is no plain struct. 1 = pushed.
# CHANGELOG [6.7.14]
fn _sarg_sval_ptr(S, fi, argc): i64 {
    if (_sarg_wname(S) >= 0) { return 0; }
    if (_pptr_param(S, fi, argc) == 0) { return 0; }
    if (GFPSID(S, fi, argc) > 0) { return 0; }
    var st = GTI(S);
    var sid = _expr_struct_sid(S, st);
    var star = 0;
    if (sid == 0) {
        sid = _ess_deref(S, st);
        if (sid > 0) { star = _sval_stars(S, st); }
    }
    if (sid > 0) { if (sid < 2048) { if (_dx_plain(S, sid) == 1) { _sval_kind_err(S, st, star, _ess_nm, fi); } } }
    EPUSHR(S);
    return 1;
}
# The `*`s a whole dereference argument at `st` opens with, inside the parentheses that wrap it (`**pp` 2).
fn _sval_stars(S, st): i64 {
    var a = _ie_unparen(S, st, GTI(S));
    var n = 0;
    while (TOKTYP(S, a + n) == 8) { n = n + 1; }
    return n;
}
# The refusal at token `ti` of a struct value — `noff` (a field, call or method name), behind `star` `*`s — passed to a
# pointer of another kind of `fi`: D5 (a)'s words, without the `&` hint a name gets (D31's `_vec_val_err` is its vector
# twin). No `_panic`: the parse is in step, so one compile reports every such argument. 0.
# 6.7.16: a dereference (`star` > 0, `_ess_deref`'s) is named as the source spells it — its `*`s, then its operand's
# tokens (`*gps(&s)`; it was `*` and the operand's last name, '*s') — rendered here, at the refusal; its once-key is the
# span's start, not the scratch the span is written at. CHANGELOG [6.7.16]
fn _sval_kind_err(S, ti, star, noff, fi): i64 {
    if (_panic == 1) { return 0; }
    var key = noff;
    if (star > 0) { key = _ess_da; }
    if (_derr_seen(ti, "_sval_kind_err", (key * 31 + fi) * 31 + star, 0) == 1) { return 0; }   # 6.7.15: once
    var nm = _fn_src_name(S, FINDFN(S, noff), noff);   # a method by its source name: `Pt.dup`
    if (star > 0) { nm = _src_span_nm(S, _ess_da + star, _ess_de, noff); }
    var sv = GTI(S);
    STI(S, ti);
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": cannot pass '");
    while (star > 0) { PRSTR("*"); star = star - 1; }
    PRSTR(S + 0xEC00000 + nm);
    PRSTR("' to a parameter that is not a pointer to its struct type in a call to '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    PRSTR("' - a struct value is no address\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    return 0;
}
# ⛔ 6.7.12 — A VECTOR CALL RESULT INTO A `*V` PARAMETER PASSES A TEMP'S ADDRESS (D27, the user, 2026-10-15: B).
# `rd(mkv(42, 7))` with `p: *f64v2` pushed the call's value — lane 0 — as the address: 139 on x86_64 and
# aarch64, a cx guest fault, exit 5 on PE (x86_64 refused it through 6.7.10 by the value-form path's text; the
# 6.7.11 `*V` parameter made it compile). A vector is the guide's other value-form aggregate, and a struct
# call result into `*S` is received into a frame temp whose address is passed (6.6.20): the same here. The
# whole argument at the cursor (`_sarg_paren` peels a wrap) is a call declared to return a vector — by name, or
# `fncallN(&f, ..)` / `callptr(&f, ..)` — and parameter `argc` of `fi` is a `*V`: the call is received into
# anonymous slots as a vector local is (`_vrcv_emit`: the register pair stored, on PE the slots' address its
# hidden result pointer), whose address is pushed (`_sarg_escapes`: a tail call diverts). A vector of another
# type is refused with A2's words; at top level there is no frame (a value-form vector is a local): refused by
# name, as a struct result is there. 1 = pushed; 0 = not this arm, or refused (the value push follows).
var _svc_k = 0;    # `_svc_rs`'s source kind for `_vrcv_emit`: 1 by name (an explicit instance too), 2 through `&f`, 3 a method (`_vmc_fi`; 6.7.13)
var _svc_nm = 0;   # ... and the callee's name
# 6.7.13 (D30 A): and on Win64 a VALUE-form vector parameter, which is passed by address there: the temp is the call's
# hidden result pointer and its address is what the callee copies in (`lanes(mkv(4, 2))` passed lane 0 as the
# address: exit 5); the call's vector meets the rule a local of its type meets (`_sar_vok`), as on SysV / AAPCS64 / cx.
fn _sarg_vec_call(S, fi, argc, tail): i64 {
    var pv = _pvec_param(S, fi, argc);
    var vf = 0;
    if (pv == 0) { if (_TARGET_PE == 1) { vf = _pvf_param(S, fi, argc); } }
    if (pv == 0) { if (vf == 0) { return _svc_kind(S, fi, argc); } }
    var rs = _svc_rs(S, GTI(S));
    if (rs == 0) { return 0; }
    var ok = 0;
    if (vf != 0) { ok = _sar_vok(S, _vf_cls(S, 0 - vf), rs, vf); }
    elif (0 - rs == pv) { ok = 1; }
    if (ok == 0) {
        ERR_IDENT(S, "cannot pass ", _svc_nm, " to a parameter of a different vector type in a call to ",
          _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
        return 0;
    }
    if (GINFN(S) != 1) { return _svc_toplevel_err(S); }
    _vec_desc(S, rs);
