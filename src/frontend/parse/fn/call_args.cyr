        var o = _gcall_open(S, ti);
        if (o < 0) { return 0; }
        if (_call_close(S, o) + 1 + k != GTI(S)) { return 0; }
    }
    return _sarg_call_sid(S, ti);
}

# ⛔ 6.6.20 — the CLOSURE-CAPTURE arm. A captured struct of 8 B or less is one env word holding
# the struct BY VALUE, and it was pushed as that value — harmless while only a struct over 8 B was
# address-passed (its one word holds the struct's address), fatal once a `p: *S` parameter of any
# size is: `|| rd1(s)` SIGSEGV'd where `|| rd3(a)` worked. `_CL_CAP_BASE_RA` is the address for
# every shape (the env word's own address, or the address it holds). Returns 1 when handled.
fn _push_struct_addr_cap(S, fi, argc): i64 {
    var cx = _CL_CAP_FIELD_IDX(S, PEEKV(S));
    if (cx >= 0 - 1) { return 0; }
    _sarg_type_err(S, fi, argc, _cap_fld_sid, PEEKV(S));   # 6.7.3
    _CL_CAP_BASE_RA(S, 0 - 1000000 - cx, _cap_fld_sid);
    EPUSHR(S);
    STI(S, GTI(S) + 1);                 # consume IDENT
    return 1;
}

# 6.6.5 — the GLOBAL arm of the by-value struct argument. The callee's structmask says this
# parameter is ADDRESS-passed, and there was no global branch at all: a global struct argument
# was pushed BY VALUE (its first 8 bytes), so the callee deref'd a field as a pointer and
# SIGSEGV'd — `take(G)` for a top-level `var G = P { 11, 22 };` crashed where the identical
# local worked. `_var_ptrmode` is the recorded layout: 2 = inline (push its address), 1 = the
# slot holds the address (push the slot). 0 means this global is not a recorded aggregate, so
# leave it to the ordinary value push rather than guessing from GVTYPE, whose positive range is
# shared with scalar widths. CHANGELOG [6.6.5]
fn _push_struct_addr_global(S, fi, argc): i64 {
    var gvi = FINDVAR(S, PEEKV(S));
    if (gvi < 0) { return 0; }
    var gpm = GVPM(S, gvi);
    if (gpm == 0) { return 0; }
    _sarg_type_err(S, fi, argc, _sarg_gv_sid(S, gvi), PEEKV(S));   # 6.7.3
    if (gpm == 1) { EVLOAD(S, gvi); } else { EVADDR(S, gvi); }
    EPUSHR(S);
    STI(S, GTI(S) + 1);                 # consume IDENT
    return 1;
}

# ⛔ 6.6.5 — is this struct-typed local POINTER-mode (its slot holds the struct's address) or
# INLINE (the slot IS the struct)? ONE reader, and it READS THE RECORDED BIT.
#
# This fn shipped earlier in 6.6.5 carrying the historical GUESS, which is quoted below so the
# next reader can recognise it rather than reinvent it:
#
#     if (li > 0) { if (L64(S + 0x5D9D000 + (li - 1) * 8) == 0 - 1) { is_ptr = 0; } }
#     if (_TARGET_CX == 0) { if (sid > 0) { if (STRUCTSZ(S, sid - 1) <= 8) { is_ptr = 0; } } }
#
# "the slot below is named -1" is NOT a discriminator for inline-ness. SCOPE_POP writes -1 over
# every local of a block that has closed (util.cyr), and callptr / bitset / SIMD-reserve /
# closure-env temporaries are registered -1 by construction — so a POINTER-mode struct local
# declared after any of those was read as inline and its fields came off the frame. Wrong since
# 5.8.17, silent, and measured in a shipped consumer (stiva's fleet.cyr let an undersized node
# pass its memory constraint). The `<= 8 B` half was the ABI policy stated at the wrong end: cx
# was excluded from it, so on cx two single-field struct locals aliased each other.
#
# Registration now records the answer (SLAGG / GLAGG, util.cyr), so every consumer — field
# load/store, method self, by-value argument passing, copy-init, copy-assign and the regalloc
# picker's aggregate span — asks THIS fn and they cannot disagree. CHANGELOG [6.6.5]
fn _local_struct_is_ptr(S, li, lt): i64 {
    if (GLAGG(S, li) == 1) { return 0; }
    return 1;
}

# ⛔ 6.6.6 — A BY-VALUE STRUCT PARAMETER OVER 8 BYTES IS ADDRESS-PASSED, so its slot holds a
# POINTER to the caller's struct (`_param_wants_struct_ptr` sets the callee's structmask and the
# caller pushes `&local`). Field access already went the extra indirection
# (`_resolve_field_base_addr`); the COPY and RETURN paths did not, and every one of them was
# silent or fatal. Measured at 6.6.5: `q = r` stored r's first word OVER the pointer and the next
# `q.z` SIGSEGV'd; `r = q` copied the pointer into r's field 0; `return q;` from a 9-16 B fn
# loaded the ADDRESS as the rax:rdx pair and from a >16 B fn byte-copied the pointer word.
#
# ⭐ `li < _cur_fn_pslots` IS the discriminator, and it has to be, because the OTHER pointer-mode
# struct local — `var a = str_from(x)`, a heap handle — looks identical in every recorded field.
# `a = b` between two of those must stay a POINTER REBIND (that is the Str convention the whole
# stdlib is built on), while `q = r` on a parameter must copy through. Nothing but "is it a
# parameter" separates them. CHANGELOG [6.6.6]
fn _local_is_sptr_param(S, li): i64 {
    if (li < 0) { return 0; }
    if (li >= _cur_fn_pslots) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    if (GLAGG(S, li) != 0) { return 0; }
    var lt = GLTYPE(S, li);
    if (lt >= 0) { return 0; }
    if (lt <= 0 - 2048) { return 0; }
    var sid = 0 - lt;
    if (STRUCTSZ(S, sid - 1) <= 8) { return 0; }
    # ⛔ `Str` / `Result` / `Option` / `Tagged` are 16 B structs BY NAME whose slot holds a HEAP
    # HANDLE — `_param_wants_struct_ptr` excludes them, so they are value-passed and `a = b`
    # between two of them is a pointer rebind the whole stdlib depends on. Asked through the
    # SAME classifier that built the callee's structmask, on the recorded sid's name, so the two
    # cannot disagree about which parameters are address-passed.
    if (_classify_param_type(S, L64(S + 0x1A6018 + (sid - 1) * 8)) != 0) { return 0; }
    return 1;
}
# ⛔ 6.7.9 — 1 when `&q` of slot `li` is the slot's CONTENT: an address-passed by-value struct
# parameter, whose slot holds the caller's struct's address (since 6.6.16 only a `#naked` fn's: the
# rest are copied in, and an `async fn` refuses one). A `q: *P` parameter (an untyped impl `self`) has
# the same `-sid` type and non-inline layout, so `_local_is_sptr_param` answers 1 for it, but its
# slot holds a POINTER: `&q` is the slot's address, as for a `*P` local, a `*Q` of 8 B or less, a
# `*i64` and in 6.6.5. It was the pointee (`load64(&q)` read q's first field). CHANGELOG [6.7.9]
fn _addr_is_slot_content(S, li): i64 {
    if (_is_ptr_param(S, li) == 1) { return 0; }
    return _local_is_sptr_param(S, li);
}
