# `h.p = f(..);` / `h.p = x.m(..);` into a field of named struct `ft`, cursor on the source (`_fsc_src`,
# beside R17's `_tup_fsc_call`): a whole call ending at `term`, by its tokens. 1 = refused.
fn _mv_fsc_call(S, ft, term): i64 {
    if (_mv_named(S, ft) == 0) { return 0; }
    var o = _dt_call_open(S);
    if (o < 0) { return 0; }
    if (TOKTYP(S, _call_close(S, o) + 1) != term) { return 0; }
    var fi = _dt_call_fn(S);
    if (_mv_callee(S, fi) == 0) { return 0; }
    if (_mcall_open(S, GTI(S), 0 - 1) >= 0) { return _mv_struct_err(S, GTI(S), ft, TOKVAL(S, _mco_mt), fi, 1, 2); }
    return _mv_struct_err(S, GTI(S), ft, PEEKV(S), fi, 1, 1);
