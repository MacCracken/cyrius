# `x = f(..);` / `x = b.m(..);`, the source [st, cursor) just parsed (`_pcmpe_struct_assign`, which the
# statement and a classic-for step reach once `_try_struct_call_assign` has passed the call by — it takes
# a struct-returning callee only): a refused source is typed as the destination's struct, so the
# statement does not also warn "assigning non-pointer to typed pointer".
fn _mv_asg_src(S, noff, st): i64 {
    if (TOKTYP(S, GTI(S) - 1) != 11) { return 0; }   # a call (or a wrap) ends the source
    var sid = _mv_dst_sid(S, noff);
    if (sid == 0) { return 0; }
    if (_mv_span(S, st, GTI(S), sid, 3) == 1) { _asg_ret_sid = sid; }
