    var en = _pd_value(S, fi, pi);
    if (en == 0) { EMOVI(S, 0); }   # refused, and reported at the default: the count stays right
    else {
        _cst_emit_val(S, L64(en + 24), L64(en + 32), L64(en + 40));
        if (L64(en + 24) == 1) { if (_pbool_get(fi, pi) == 3) { _f32_init_round(S, F32_TYID); } }
