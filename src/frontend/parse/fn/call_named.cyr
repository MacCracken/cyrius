# tail arm, short of max but in range: `_tc_args_divert` missed a call that fills — an internal
# error, never a `jmp` with a parameter unset. Mode 4, an operator dispatch: D19 (`_pd_d19`).
fn _pd_arity_mode(S, line, noff, fi, argc, mode): i64 {
    if (mode == 4) { return _pd_d19(S, noff, fi); }
    if (mode != 3) { return 0; }
    if (argc < _pd_min(fi)) { return 0; }
    if (argc >= L64(_fnt_params + fi * 8)) { return 0; }
    return _pd_line_err(S, line, "internal: tail call to ", noff, " reached the tail arm short of its defaults");
}
