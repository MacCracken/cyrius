# `_int` sibling, or its `&x` first argument a `<base>_ptr` one), so it never silently reaches a
# different fn than the same arguments written by position. Returns -1 (not routed).
fn _pd_route_named(S, fi, noff): i64 {
    var hit = 0;
    if (L64(_fnt_ovstr + fi * 8) > 0) { hit = 1; }
    if (L64(_fnt_ovint + fi * 8) > 0) { hit = 1; }
    if (PEEKT(S) == 27) { if (_fnc_ptr_sib(S, noff) >= 0) { hit = 1; } }
    if (hit == 0) { return 0 - 1; }
