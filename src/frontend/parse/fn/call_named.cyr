# after the definition's own refusal. A row refused already (a method of `impl Trait for T`, D13,
# or any shape refusal) says nothing more. Always 1: the dispatch's count is not judged.
# CHANGELOG [6.7.11]
fn _pd_d19(S, noff, fi): i64 {
    var row = _pd_row(fi);
    if ((L64(row + 24) & 4) != 0) { return 1; }
    var ft = _pd_first_eq(S, L64(row + 16));
    if (ft < 0) { ft = L64(row + 16); }
    if (_pd_eo(S, ft) == 0) { return 1; }
    PRSTR("operator fn ");
    _pd_q(S, noff);
    PRSTR(" declares a parameter default: an operator passes exactly its two operands");
    _pd_ec(S, ft);
    return 1;
}
# "error:<file>:<line>: <a>'<name>'<b>", the arity check's form. Returns 1.
fn _pd_line_err(S, line, a, noff, b): i64 {
    _ew("error:", 6);
    FM_LOOKUP(S, line);
    PRSTR(": ");
    PRSTR(a);
    _pd_q(S, noff);
    PRSTR(b);
    _ew("\n", 1);
    _had_error = 1;
    return 1;
}
