# tail arm must not take (`_tc_args_divert`). Its written arguments are counted by `_arg_next`,
# which steps over a closure's `|a, b|` bars — counted as two arguments, `return ap(|a, b| ..)`
# to `fn ap(c, n = 5)` would look full and jump with `n` unset.
fn _pd_call_fills(S, fi, open): i64 {
    if (_pd_named_at(S, open) == 1) { return 1; }
    var row = _pd_row(fi);
    if (row == 0) { return 0; }
    var n = 0;
    var q = open + 1;
