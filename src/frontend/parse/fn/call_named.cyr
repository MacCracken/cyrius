}
var _cam_open = 0 - 1;   # the `(` of the method call `_gs_mtp` reads, else -1
# ... where `pk` is the POSITION that passes parameter k: k on a free call, k - 1 on a method call,
# whose `self` (parameter 0) is the receiver and not in the list (`_mcall_infer`, 6.7.9).
fn _call_arg_pk(S, fi, open, k, pk): i64 {
    if (open == _OPI_OPEN) { return _opi_arg(pk); }   # 6.7.16 (D85 (a)): an operator's operand (`_op_gen_head`)
    if (_pd_named_at(S, open) == 0) { return _call_arg_start(S, open, pk); }
    var q = open + 1;
    var pc = 0;
    var n = GTCNT(S);
    while (q < n) {
        if (_pd_label_at(S, q) == 1) { break; }
        if (pc == pk) { return _call_arg_start(S, open, pk); }
        pc = pc + 1;
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0 - 1; }
        q = q + 1;
    }
    if (fi < 0) { return 0 - 1; }
    var pn = _bx_pname(S, fi, k);
    if (pn < 0) { return 0 - 1; }
    while (q < n) {
        if (_pd_label_at(S, q) == 1) { if (STREQ(S, TOKVAL(S, q), pn) == 1) { return q + 2; } }
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0 - 1; }
        q = q + 1;
    }
    return 0 - 1;
}
