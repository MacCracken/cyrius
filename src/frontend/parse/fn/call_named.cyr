        if (_pd_label_at(S, GTI(S)) == 1) { STI(S, GTI(S) + 2); }
        PCMPE(S);
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); } else { go = 0; }
    }
    return _pd_close(S);
