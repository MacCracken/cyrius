        k = k + 1;
    }
    if (load64(st + 40) == 1) { if (_cur_fn_naked == 1) {
            if (_pd_eo(S, lb) == 1) {
                PRSTR("a reordered named call needs a frame: not inside #naked fn ");
                _pd_q(S, _bx_fname(S, _cur_fn_ix));
                _pd_ec(S, lb);
