    return n;
}

# ── the call site: named arguments ──────────────────────────────────────────────────────────
# `f(1, c: 3)`: the positionals first, then `name: value` in any order, each parameter at most
# once (user, 2026-10-08). WRITTEN order is evaluation order; PARAMETER order is placement. The
# one marshaller (`_owncall_args_at`) runs the positionals and hands the cursor, on the first
# label, to `_pd_named`, which checks the whole call before it emits anything (`_pd_nscan`,
# cursor-free) and then marshals it one of two ways:
#   * IN ORDER (each name after the one before it — the common `f(1, c: 3)`): every argument where
#     it stands, a gap's defaults pushed before it (constants: no side effect, so written order
#     holds). No temporaries.
#   * REORDERED: each argument evaluated as written through its parameter's gates
#     (`_call_arg_one`), its int-class word popped into a hidden temporary (`_HTEMP`: a frame slot
#     in a fn, a dead global at top level), then every parameter pushed in parameter order — its
#     temporary, or its default. A vector is recorded at its parameter-order XMM / V ordinal
#     (`_simd_ord_at`), never pushed.
# Either way ECALLPOPS sees one int-class word per parameter, in parameter order, on every target
# (SysV 6 / Win64 4 / aarch64 8 registers, then the stack; cx). Direct calls only: fncallN /
# callptr refuse a label (C7), a builtin's undefined-name error gets a note (C14), a call that
# names an argument is never overload-routed (C10) nor inlined, and a const context binds names
# the same way (`_ce_call_named`). CHANGELOG [6.7.7]
# The marshaller's state for the named phase: st[24] the first user parameter (p0), st[32] the
# arity line, st[40] 1 = reordered, st[48] the per-call table (alloc'd, 24 B per parameter: the
# value's first token or 0 = not named, 1 = spilled, its temporary).

# The ordinal of fi's parameter named `noff`, or -1 — read from the definition's tokens.
fn _pd_index(S, fi, noff): i64 {
    var max = L64(_fnt_params + fi * 8);
    var k = 0;
    while (k < max) {
        var pn = _bx_pname(S, fi, k);
        if (pn < 0) { return 0 - 1; }
        if (STREQ(S, pn, noff) == 1) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}
# The XMM / V ordinal of fi's vector parameter pi: the widths of the vector parameters before it (a
# 32-byte vector takes two), exactly as a positional call's running ordinal reaches it.
fn _simd_ord_at(fi, pi): i64 {
    var o = 0;
    var j = 0;
    while (j < pi) {
        var c = _pm_simd(fi, j);
        if (c == 2) { o = o + 2; }
        elif (c > 0) { o = o + 1; }
        j = j + 1;
    }
    return o;
}
# The first label of the call whose argument list starts at token q (a label is always there).
fn _pd_first_label(S, q): i64 {
    var n = GTCNT(S);
    while (q < n) {
        if (_pd_label_at(S, q) == 1) { return q; }
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return q; }
        q = q + 1;
