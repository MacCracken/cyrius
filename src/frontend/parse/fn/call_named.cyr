# name, C8 `self:` in the dot form, C4 a parameter given by position and by name, C3 one named
# twice, C6 a required one missing, C13 a reordered call in a `#naked` fn. Records each named
# parameter's value token (st[48]) and whether the call is reordered (st[40]). 1 = refused, once.
fn _pd_nscan(S, fi, noff, p, st): i64 {
    var max = L64(_fnt_params + fi * 8);
    var lb = GTI(S);
    if (p > max) {
        _check_arity_p0(S, load64(st + 32), noff, fi, p + _pd_nargs(S, lb), 1, load64(st + 24));
        return 1;
    }
    var tb = alloc(max * 24 + 24);
    store64(st + 48, tb);
    store64(st + 40, 0);
    var q = lb;
    var last = 0 - 1;
    var n = GTCNT(S);
    while (q < n) {
        if (_pd_label_at(S, q) == 0) { return _pd_c5(S, q, _fn_src_name(S, fi, noff)); }
        var pi = _pd_index(S, fi, TOKVAL(S, q));
        if (pi < 0) { return _pd_c2(S, q, fi, noff, load64(st + 24)); }
        if (pi < p) { return _pd_c4(S, q, fi, noff, pi, load64(st + 24)); }
        if (load64(tb + pi * 24) != 0) { return _pd_c3(S, q, fi); }
        store64(tb + pi * 24, q + 2);
