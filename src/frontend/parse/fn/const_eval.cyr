# printed. CHANGELOG [6.7.14]
fn _ce_xpend_one(S, bt, cl): i64 {
    var sv_ti = _ce_ti; var sv_top = _ce_top; var sv_in = _ce_infn; var sv_err = _ce_err; var sv_skip = _ce_skip;
    var sv_pn = _panic;
    _panic = 0;
    _ce_ti = bt;
    _ce_top = 1;
    _ce_infn = 0;
    _ce_err = 0;
    _ce_skip = 1;
    _ce_expr(S);
