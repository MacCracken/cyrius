    if (_ce_mtargs_at(S, _ce_ti + 2) == 1) { return _ce_meth_refused(S, noff, isc); }
    if (isc == 1) { _ce_badn(S, "const ", noff, " has no fields - a const has no storage"); return 1; }
    _ce_bad(S, "a field is not in a const fn: its body takes no memory (fields, arrays, load64, &x)", 83);
    return 1;
}
fn _ce_meth_refused(S, noff, isc): i64 {
