}
fn _ce_cond(S): i64 {
    if (_ce_expect(S, 10) == 0) { return 0; }
    var c = _ce_expr(S);
    if (_ce_k == 2) { _ce_bad(S, "a string as a condition", 23); }
    _ce_expect(S, 11);
    if (c != 0) { return 1; }
    return 0;
}
# Run (or, in skip mode / an untaken arm, walk) one block.
fn _ce_arm(S, run): i64 {
    if (run == 1) { _ce_block(S); return 0; }
    _ce_skip = _ce_skip + 1;
    _ce_block(S);
    _ce_skip = _ce_skip - 1;
    return 0;
}
fn _ce_if(S): i64 {
    _ce_ti = _ce_ti + 1;
    var c = _ce_cond(S);
    var done = 0;
    var run = 0;
    if (_ce_skip == 0) { if (c == 1) { run = 1; done = 1; } }
    _ce_arm(S, run);
    var go = 1;
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        var t = TOKTYP(S, _ce_ti);
        if (t == 50) {
            _ce_ti = _ce_ti + 1;
            if (done == 1 || _ce_ret != 0) { _ce_skip = _ce_skip + 1; }
            var c2 = _ce_cond(S);
            if (done == 1 || _ce_ret != 0) { _ce_skip = _ce_skip - 1; c2 = 0; }
            run = 0;
            if (_ce_skip == 0) { if (c2 == 1) { run = 1; done = 1; } }
