    return i;
}
# A type at token ti, for a const fn's locals and parameters: 9 = f64, 8 = i64 (or untyped), 4 /
# 2 / 1 = i32 / i16 / i8; 0 = a type a const evaluation does not take.
fn _ce_type_w(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var p = S + 0xEC00000 + TOKVAL(S, ti);
    if (load8(p) == 102) { if (load8(p + 1) == 54) { if (load8(p + 2) == 52) { if (load8(p + 3) == 0) { return 9; } } } }
    if (_bx_is_bool_name(S, TOKVAL(S, ti)) == 1) { return 10; }   # 6.7.3: bool — 8 bytes, kind 3
    if (load8(p) != 105) { return 0; }
    var c1 = load8(p + 1);
    var c2 = load8(p + 2);
    if (c1 == 56) { if (c2 == 0) { return 1; } }
    if (c1 == 49) { if (c2 == 54) { if (load8(p + 3) == 0) { return 2; } } }
    if (c1 == 51) { if (c2 == 50) { if (load8(p + 3) == 0) { return 4; } } }
    if (c1 == 54) { if (c2 == 52) { if (load8(p + 3) == 0) { return 8; } } }
    return 0;
}

# ── statements (a const fn body) ─────────────────────────────────────────────────────────────────
# `_ce_ret`: 0 = normal, 1 = returned (`_ce_rv` / `_ce_rk`), 2 = break, 3 = continue.
fn _ce_block(S): i64 {
    if (_ce_expect(S, 13) == 0) { return 0; }
    var sv_sp = _ce_sp;
    while (TOKTYP(S, _ce_ti) != 14) {
        if (_ce_err == 1) { return 0; }
        if (TOKTYP(S, _ce_ti) == 12) { _ce_expect(S, 14); return 0; }
        _ce_stmt(S);
        if (_ce_ret != 0) {
            if (_ce_skip == 0) { _ce_skip_to_close(S); _ce_sp = sv_sp; return 0; }
        }
    }
    _ce_ti = _ce_ti + 1;
    _ce_sp = sv_sp;
    return 0;
}
# Leave a block early (a return / break / continue ran): to the token after its `}`.
fn _ce_skip_to_close(S): i64 {
    var d = 1;
    while (d > 0) {
        var t = TOKTYP(S, _ce_ti);
        if (t == 12) { return 0; }
        if (t == 13) { d = d + 1; }
        if (t == 14) { d = d - 1; }
        _ce_ti = _ce_ti + 1;
    }
    return 0;
}
fn _ce_stmt(S): i64 {
    _ce_step(S);
    var t = TOKTYP(S, _ce_ti);
    if (t == 3) { return _ce_var(S, 0); }
    if (t == 168) { return _ce_var(S, 1); }
    if (t == 15) { return _ce_if(S); }
    if (t == 16) { return _ce_while(S); }
    if (t == 55) { return _ce_for(S); }
    if (t == 33) { return _ce_return(S); }
    if (t == 51) { _ce_ti = _ce_ti + 1; _ce_expect(S, 5); if (_ce_skip == 0) { _ce_ret = 2; } return 0; }
    if (t == 52) { _ce_ti = _ce_ti + 1; _ce_expect(S, 5); if (_ce_skip == 0) { _ce_ret = 3; } return 0; }
    if (t == 13) { return _ce_block(S); }
    if (_ce_loopx(S, t) == 1) { return 0; }   # 6.7.5 (B5): `do`, and `loop {` before the ident arm
    if (t == 2) {
        var nt = TOKTYP(S, _ce_ti + 1);
        if (nt == 4) { return _ce_assign(S, 0); }
        var co = _ce_cop(S);
        if (co != 0) { return _ce_assign(S, co); }
        _ce_expr(S);
        _ce_expect(S, 5);
        return 0;
    }
    _ce_bad(S, "not in a const fn: its body takes var / const / assignment / if / elif / else / while / for / loop / do-while / return / break / continue and calls of const fns", 160);
    return 0;
}
# `x OP= e` at the cursor (an IDENT): the operator, or 0.
fn _ce_cop(S): i64 {
    var ct = TOKTYP(S, _ce_ti + 1);
    if (_is_cop_tok(ct) == 1) {   # 6.7.5: the runtime's own list (parse.cyr)
        if (TOKTYP(S, _ce_ti + 2) == 4) { return ct; }
    }
    return 0;
}
# `var NAME [: T] = e;` (isc 0) or `const NAME = e;` (isc 1) inside a const fn body.
fn _ce_var(S, isc): i64 {
    _ce_ti = _ce_ti + 1;
    if (TOKTYP(S, _ce_ti) != 2) { _ce_expect(S, 2); return 0; }
    var name = TOKVAL(S, _ce_ti);
    _ce_ti = _ce_ti + 1;
    var w = 8;
    var dk = 0;
    if (TOKTYP(S, _ce_ti) == 49) {
        if (isc == 1) { _ce_bad(S, "a const takes no type annotation: its type is its value's", 57); return 0; }
        if (TOKTYP(S, _ce_ti + 1) == 10) { _ce_bad(S, "a tuple in a const fn: its locals are i64, i32, i16, i8, f64 or bool", 68); return 0; }   # 6.7.7 (R5)
        w = _ce_type_w(S, _ce_ti + 1);
        if (w == 0) { _ce_badn(S, "type ", TOKVAL(S, _ce_ti + 1), " in a const fn: its locals are i64, i32, i16, i8, f64 or bool"); return 0; }
        if (w == 9) { dk = 1; w = 8; }
        if (w == 10) { dk = 3; w = 8; }
        _ce_ti = _ce_ti + 2;
    }
    if (TOKTYP(S, _ce_ti) != 4) { _ce_bad(S, "a local in a const fn needs an initial value", 44); return 0; }
    _ce_ti = _ce_ti + 1;
    var v = _ce_expr(S);
    var k = _ce_k;
    _ce_expect(S, 5);
