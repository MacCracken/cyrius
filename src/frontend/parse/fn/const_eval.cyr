    if (_ce_pend_n >= 4096) { return 0; }
    S64(_ce_pend + _ce_pend_n * 16, bt);
    S64(_ce_pend + _ce_pend_n * 16 + 8, 0);
    _ce_pend_n = _ce_pend_n + 1;
