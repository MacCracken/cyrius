fn _ce_assign_noterm(S): i64 {
    if (TOKTYP(S, _ce_ti) != 2) { _ce_bad(S, "a const fn's for-step is an assignment to one of its locals", 59); return 0; }
    var name = TOKVAL(S, _ce_ti);
