# One arm `{ expr }`: run (1) or walked in skip mode (0); its kind in `_ce_k`, its first token in
# `_ce_xbt`.
fn _ce_xarm(S, run): i64 {
    if (_ce_expect(S, 13) == 0) { return 0; }
    var bt = _ce_ti;
    var t = TOKTYP(S, _ce_ti);
    if (t == 14) { _ce_bad(S, "an if expression branch needs a value", 37); return 0; }
    if (_ie_stmt_at(S, _ce_ti) == 1) { _ce_bad(S, "an if expression branch takes one expression, not a statement - an if statement runs statements", 95); return 0; }
    if (run == 0) { _ce_skip = _ce_skip + 1; }
    var v = _ce_expr(S);
    if (run == 0) { _ce_skip = _ce_skip - 1; }
    var k = _ce_k;
    if (_ce_err == 1) { return 0; }
    if (TOKTYP(S, _ce_ti) == 5) { _ce_bad(S, "an if expression branch holds one expression, without ';' - an if statement runs statements", 91); return 0; }
    _ce_expect(S, 14);
    _ce_k = k;
    _ce_xbt = bt;
    return v;
}
# A kind as a class: 1 an integer (a bool too), 2 an f64, 3 a string, 0 unknown.
fn _ce_xcls(k): i64 {
    if (k == 1) { return 2; }
    if (k == 2) { return 3; }
    if (k == 4) { return 0; }
    return 1;
}
# Merge an arm of kind `k` (first token `bt`) into `st`: class (low byte), 256 = an arm that is not a
# bool, 512 = an arm of unknown kind was recorded.
fn _ce_xmerge(S, st, k, bt): i64 {
    if (_ce_err == 1) { return st; }
    if (k != 3) { st = st | 256; }   # an unknown arm (4) is not known to be a bool: not one
    var cl = _ce_xcls(k);
