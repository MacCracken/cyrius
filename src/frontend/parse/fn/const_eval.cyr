fn _ce_while(S): i64 {
    _ce_ti = _ce_ti + 1;
    var top = _ce_ti;
    var go = 1;
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        _ce_ti = top;
        var c = _ce_cond(S);
        var run = 0;
        if (_ce_skip == 0) { if (c == 1) { run = 1; } }
        _ce_arm(S, run);
        if (run == 0) { go = 0; }
        if (_ce_ret == 1) { go = 0; }
        if (_ce_ret == 2) { _ce_ret = 0; go = 0; }
        if (_ce_ret == 3) { _ce_ret = 0; }
        _ce_step(S);
    }
    return 0;
}
# 6.7.5 (B5): `loop { }` and `do { } while (c);` join the pure subset, under the step budget. 1 when
