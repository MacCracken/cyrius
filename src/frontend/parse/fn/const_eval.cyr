        if (TOKTYP(S, _ce_ti + 1) != 4) { _ce_bad(S, "a const fn's for-step is an assignment to one of its locals", 59); return 0; }
        _ce_ti = _ce_ti + 2;
    } else { _ce_ti = _ce_ti + 3; }
    var r = _ce_expr(S);
    var rk = _ce_k;
    if (_ce_err == 1) { return 0; }
    if (_ce_skip > 0) { return 0; }
    var lk = load64(fe + 16);
    var nv = r;
    if (cop != 0) { nv = _ce_binop(S, cop, load64(fe + 8), lk, r, rk); }
    if (lk == 0) { nv = _ce_narrow(nv, load64(fe + 24)); }
    store64(fe + 8, nv);
    return 0;
}
fn _ce_for_in(S): i64 {
    var name = TOKVAL(S, _ce_ti);
    _ce_ti = _ce_ti + 2;
    var lo = _ce_add(S);
    if (TOKTYP(S, _ce_ti) != 41 || TOKTYP(S, _ce_ti + 1) != 41) { _ce_bad(S, "a const fn's for-in takes a range `a..b` (a vec is memory)", 58); return 0; }
    _ce_ti = _ce_ti + 2;
    var hi = _ce_add(S);
    if (_ce_err == 1) { return 0; }
    var e = _ce_fr_push(S, name, lo, 0, 8);
    var body = _ce_ti;
    if (_ce_skip > 0) { _ce_arm(S, 0); return 0; }
    var i = lo;
    var go = 1;
    if (i >= hi) { go = 0; _ce_arm(S, 0); }
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        store64(_ce_st + e * 40 + 8, i);
        _ce_ti = body;
        _ce_arm(S, 1);
        if (_ce_ret == 1) { go = 0; }
        if (_ce_ret == 2) { _ce_ret = 0; go = 0; }
        if (_ce_ret == 3) { _ce_ret = 0; }
        i = i + 1;
        if (i >= hi) { go = 0; }
        _ce_step(S);
    }
    return 0;
}
fn _ce_return(S): i64 {
    _ce_ti = _ce_ti + 1;
    var v = 0;
    var k = 0;
    if (TOKTYP(S, _ce_ti) != 5) { v = _ce_expr(S); k = _ce_k; }
    _ce_expect(S, 5);
    if (_ce_skip > 0) { return 0; }
    _ce_rv = v;
    _ce_rk = k;
    _ce_ret = 1;
    return 0;
}

# ── const fn: the definition check ──────────────────────────────────────────────────────────────
# Pass 2, at the definition: the body run in SKIP mode, every arm walked and nothing executed —
# so anything the evaluator does not take is refused here, called or not. Parameters bind to 0.
fn _ce_check_fn(S, fi): i64 {
    var op = _gen_def_open(S, fi);
    if (op < 0) { return 0; }
    if (GFTP(S, fi) != 0) {
        var sv = GTI(S);
        STI(S, op);
        ERR_IDENT(S, "a const fn cannot be generic: ", L64(_fnt_names + fi * 8), " (its type parameters have no compile-time binding)", 0 - 1);
        STI(S, sv);
        return 0;
    }
    if (_ce_tup_param(S, op) == 1) { return 0; }
    var sv_ti = _ce_ti; var sv_fb = _ce_fb; var sv_sp = _ce_sp; var sv_in = _ce_infn; var sv_err = _ce_err;
    # 6.7.14: the body's own tokens, walked by `_ce_ti` — never the cursor's statement — so no latch in:
    # a refusal is printed (or was, by the sweep), which the run-time body's stand-down relies on
    # (`_ce_name_said`). 6.7.15: and none out — the caller's latch is put back, as `_ce_top_expr` does. The
    # check's own latch began the run-time body latched: its first statement's errors were swallowed and its
    # resync skipped the next statement when that opened with no keyword (`const k = 3;` unbound: a false
    # "undefined variable 'k'"). The body's repeat of the check's refusal stands down (`_ce_err_dup`, the
    # 6.7.14 stand-downs). CHANGELOG [6.7.15]
    var pw = _panic;
    _panic = 0;
    _ce_bn = 0 - 1;
    _ce_rti = 0 - 1;
    _ce_err = 0;
    _ce_fb = _ce_sp;
    _ce_infn = 1;
    _ce_skip = _ce_skip + 1;
    var np = _ce_nparams(S, op);
    var pi = 0;
    while (pi < np) { _ce_fr_push(S, 0 - 1, 0, 0, 8); pi = pi + 1; }
    var body = _ce_bind_params(S, op, _ce_fb, np, fi);
    if (body > 0) {
        _ce_ti = body;
        _ce_ret = 0;
        _ce_block(S);
    }
    _ce_skip = _ce_skip - 1;
    _ce_ret = 0;
    if (_ce_err == 1) { _ce_fn_rname = _ce_bn; _ce_fn_refd = 1; _ce_fn_rtok = _ce_rti; }   # 6.7.14 / 6.7.15: the body's
    _panic = pw;
    _ce_ti = sv_ti; _ce_fb = sv_fb; _ce_sp = sv_sp; _ce_infn = sv_in; _ce_err = sv_err;
    return 0;
}
# ⛔ 6.7.7 (B4, R5) — a const fn takes no TUPLE parameter: a compile-time evaluation binds each
# parameter to one value, and a tuple is several. It said "expected ';', got '.'" at the first `t.0`,
# and nothing at all for an unused one (callable at run time, a constant nowhere). Refused once, at the
# parameter's type, by name. 1 = refused. CHANGELOG [6.7.7]
fn _ce_tup_param(S, op): i64 {
    var i = op + 1;
    while (TOKTYP(S, i) == 2) {
        if (TOKTYP(S, i + 1) == 49) {
            if (TOKTYP(S, i + 2) == 10) {
                _tup_err(S, i + 2, "const fn parameter ", TOKVAL(S, i), " is a tuple, which a compile-time evaluation does not take - pass its elements as separate parameters");
                return 1;
            }
        }
        i = _pl_next(S, i);   # 6.7.11: the parser's walker, as `_ce_bind_params`
        if (TOKTYP(S, i) != 31) { return 0; }
        i = i + 1;
    }
    return 0;
}
# The number of parameters in the list whose `(` is token `op`, by `_pl_next` — the run-time
# arity. ⛔ 6.7.11: it counted depth-0 commas with `( )` depth only, so `p: Pair<i64, i64>` was two
# parameters in a const context: `pick(0, 7)` was refused and `pick(0, 1, 7)` bound a phantom
# parameter named `i64`, while the run-time call counted two. CHANGELOG [6.7.11]
fn _ce_nparams(S, op): i64 {
    var i = op + 1;
    var n = 0;
    while (TOKTYP(S, i) != 11) {
        if (TOKTYP(S, i) == 12) { return n; }
        n = n + 1;
        i = _pl_next(S, i);
        if (TOKTYP(S, i) == 31) { i = i + 1; }
    }
    return n;
}

# ── top-level consts ──────────────────────────────────────────────────────────────────────────────
# `_cst_tab` (8 words): name, initializer token, declaration token, var slot, state (0 new, 1
# being evaluated, 2 done, 3 refused), kind, value, float-literal index (an f64 const's, else -1).
# A refused annotation, `const K: T = e;`, is recorded too (its initializer after the `=`, the
# refusal reported once, by `_cst_record`): an unrecorded K made every read of it, above or below,
# a second error, "undefined variable 'K'". CHANGELOG [6.7.13]
fn _cst_prepass(S): i64 {
    var p = 0;
    var d = 0;
    while (TOKTYP(S, p) != 12) {
        var t = TOKTYP(S, p);
        if (d == 0) { if (t == 168) { if (TOKTYP(S, p + 1) == 2) { _cst_pre_at(S, p); } } }
        if (t == 13) { d = d + 1; }
        if (t == 14) { if (d > 0) { d = d - 1; } }
        p = p + 1;
    }
    return 0;
}
# `const NAME` at token p (depth 0): recorded when `=` follows the name, or a refused `: T` and then
# an `=`.
fn _cst_pre_at(S, p): i64 {
    if (TOKTYP(S, p + 2) == 4) { _cst_record(S, p, p + 3); return 0; }
    if (TOKTYP(S, p + 2) != 49) { return 0; }
    var q = _cst_ann_eq(S, p + 2);
    if (q > 0) { _cst_record(S, p, q + 1); }
    return 0;
}
# The `=` after a const's refused annotation (the `:` at token q): its token, or 0 when the
# statement has none (a `;`, `{`, `}` or EOF comes first) — then nothing is bound.
fn _cst_ann_eq(S, q): i64 {
    while (TOKTYP(S, q) != 12) {
        var t = TOKTYP(S, q);
        if (t == 4) { return q; }
        if (t == 5 || t == 13 || t == 14) { return 0; }
        q = q + 1;
    }
    return 0;
}
# "a const takes no type annotation" at the `:` (token q), once and in sync: the latch is left as
# it was, so the const is still bound and the statement after it reports its own errors.
fn _cst_ann_err(S, q): i64 {
    var sv = GTI(S);
    var p0 = _panic;
    STI(S, q);
    ERR_MSG(S, "a const takes no type annotation: its type is its value's", 57);
    STI(S, sv);
    if (p0 == 0) { _panic = 0; }
    return 0;
}
fn _cst_record(S, p, ini): i64 {
    if (_cst_tab == 0) { _cst_tab = alloc(16384 * 64); }
    if (_cst_n >= 16384) { _tr_cap(S, p, "too many top-level consts (max 16384)", 37); return 0; }
    var name = TOKVAL(S, p + 1);
    _RSV_INTRINSIC_DECL(S, name, p + 1, 0);
    var prior = _cst_find(S, name);
    if (prior >= 0) {
        _bnd_err_at(S, p + 1, "const ", name, " is declared twice", 0 - 1);
        return 0;
    }
    var e = _cst_tab + _cst_n * 64;
    S64(e, name);
    S64(e + 8, ini);
    S64(e + 16, p);
    if (TOKTYP(S, p + 2) == 49) { _cst_ann_err(S, p + 2); }
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, name);
    S64(_vars_base + vcnt * 8, 0);
    SVECP(S, vcnt, 2);
    SVDECL(S, vcnt, p + 1);   # 6.7.14: where it was declared (the native-region warning)
    _vcst_set(S, vcnt, _cst_n + 1);
    SVCNT(S, vcnt + 1);
    var ispub = 0;
    if (p > 0) { if (TOKTYP(S, p - 1) == 73) { ispub = 1; } }
    if (ispub == 0) {
        var fid = FM_FILEID(S, GTLINE(S, p));
        if (_PRIV_FILE(fid) == 1) { SVFI(S, vcnt, fid + 1); }
    }
    S64(e + 24, vcnt);
    S64(e + 32, 0);
    S64(e + 40, 0);
    S64(e + 48, 0);
    S64(e + 56, 0 - 1);
    _cst_n = _cst_n + 1;
    return 0;
}
fn _vcst_set(S, vi, v): i64 {
    if (_vcst == 0) { _vcst = alloc(1048576 * 4); }
    store32(_vcst + vi * 4, v);
    return 0;
}
# The `_cst_tab` index of var slot vi (a top-level const), or -1.
fn _vcst_ix(S, vi): i64 {
    if (_vcst == 0) { return 0 - 1; }
    if (vi < 0) { return 0 - 1; }
    return load32(_vcst + vi * 4) - 1;
}
fn _cst_find(S, name): i64 {
    var i = 0;
    while (i < _cst_n) {
        if (STREQ(S, L64(_cst_tab + i * 64), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# Evaluate const ci (once): its value; its kind in `_cst_kk`.
fn _cst_value(S, ci): i64 {
    var e = _cst_tab + ci * 64;
    var st = L64(e + 32);
    if (st == 1) {
        _ce_badn(S, "const ", L64(e), " is defined in terms of itself");
        S64(e + 32, 3);
        _cst_kk = 0;
        return 0;
    }
    if (st == 0) { _cst_eval(S, ci); }
    _cst_kk = L64(e + 40);
    return L64(e + 48);
}
fn _cst_kind_peek(S, ci): i64 {
    var e = _cst_tab + ci * 64;
    if (L64(e + 32) == 2) { return L64(e + 40); }
    return 4;   # 6.7.4: not evaluated yet — its kind is unknown (an if-expression re-checks it later)
}
# Evaluate the constant expression at token `ti` at the TOP context: no locals of whatever forced
# it, its own step budget (a sweep runs them back to back), every evaluator flag put back. Returns
# the value; `out` receives [0] its kind (0 i64, 1 f64, 2 string, 3 bool), [1] 1 when the evaluator
# refused it (already reported), [2] the token after it — the caller judges what may end it (a
# const's `;`; a parameter default's `,` / `)`). CHANGELOG [6.7.2] [6.7.7]
# 6.7.14 — and the cascade latch: it evaluates with `_panic` clear and puts the caller's value back.
# The tokens are a declaration's own, walked by `_ce_ti`, never the parser's cursor, so a refusal
# needs no resync; under the caller's latch every evaluation after the first refused one (the
# end-of-pass-1 sweep's next const, a default after a bad const) printed nothing. CHANGELOG [6.7.14]
fn _ce_top_expr(S, ti, out): i64 {
    var sv_ti = _ce_ti; var sv_top = _ce_top; var sv_in = _ce_infn; var sv_err = _ce_err;
    var sv_skip = _ce_skip; var sv_fb = _ce_fb; var sv_steps = _ce_steps; var sv_as = _ce_asrt;
    var sv_pn = _panic;
    _panic = 0;
    _ce_steps = 0;
    _ce_asrt = 0;
    _ce_ti = ti;
    _ce_top = 1;
    _ce_infn = 0;
    _ce_err = 0;
    _ce_skip = 0;
    var v = _ce_expr(S);
    store64(out, _ce_k);
    store64(out + 8, _ce_err);
    store64(out + 16, _ce_ti);
    _ce_ti = sv_ti; _ce_top = sv_top; _ce_infn = sv_in; _ce_err = sv_err; _ce_skip = sv_skip; _ce_fb = sv_fb;
    _ce_steps = sv_steps; _ce_asrt = sv_as;
    _panic = sv_pn;
    return v;
}
# 6.7.15 — the same, QUIET: a refusal sets `out`[1] and prints nothing, counts no error and latches nothing — the
# declaration zone's probe of a float global's initializer (parse/decl.cyr _gvk_fx), which the replay compiles as
# run-time code when the evaluator refuses it. Its tokens are pre-scanned (_gvk_fscan): only consts already
# evaluated are read, so no const's own evaluation runs under it. CHANGELOG [6.7.15]
var _ce_quiet = 0;
fn _ce_top_quiet(S, ti, out): i64 {
    var sq = _ce_quiet;
    _ce_quiet = 1;
    var v = _ce_top_expr(S, ti, out);
    _ce_quiet = sq;
    return v;
}
# Run const ci's initializer at the TOP context (no locals of whatever fn forced it).
fn _cst_eval(S, ci): i64 {
    var e = _cst_tab + ci * 64;
    S64(e + 32, 1);
    var o: i64[3];
    var v = _ce_top_expr(S, L64(e + 8), &o);
    var k = load64(&o);
    var bad = load64(&o + 8);
    if (bad == 0) {
        if (TOKTYP(S, load64(&o + 16)) != 5) {
            _cst_semi_refuse(S, load64(&o + 16));
            bad = 1;
        }
    }
    var vi = L64(e + 24);
    if (bad == 1) {
        S64(e + 32, 3); S64(e + 40, 0); S64(e + 48, 0);
        SVECP(S, vi, 1); S64(_vecv_base + vi * 8, 0);
        return 0;
    }
    S64(e + 32, 2);
    S64(e + 40, k);
    S64(e + 48, v);
    if (k == 0 || k == 3) { S64(_vecv_base + vi * 8, v); SVECP(S, vi, 1); }   # 6.7.3: a bool folds as an int
    else {
        SVECP(S, vi, 0);
        if (k == 1) { S64(e + 56, FLIT_ADD(v)); }
    }
    return 0;
}
# A const's value that does not end at its `;`: refused under `_ce_top_expr`'s latch rule (its own
# tokens, no resync), so the next const's error still prints. CHANGELOG [6.7.14]
fn _cst_semi_refuse(S, ti): i64 {
    var pw = _panic;
    _panic = 0;
    _bnd_errm_at(S, ti, "expected ';' after a const's value", 34);
    _panic = pw;
    return 0;
}
# GVECP's pending arm: var slot vi is a top-level const not yet evaluated.
fn _cst_force(S, vi): i64 {
    var ci = _vcst_ix(S, vi);
    if (ci < 0) { SVECP(S, vi, 0); return 0; }
    _cst_value(S, ci);
    return 0;
}
# Every top-level const, evaluated at the end of pass 1 — an unused one is checked too.
fn _cst_sweep(S): i64 {
    var i = 0;
    while (i < _cst_n) {
        if (L64(_cst_tab + i * 64 + 32) == 0) { _cst_value(S, i); }
        i = i + 1;
    }
    _ce_xpend_check(S);   # 6.7.4: every const is known now
    return 0;
}
# The const kind of global var slot vi: 0 = not a const, 1 = int, 2 = f64, 3 = string, 4 = bool.
fn _cst_vkind(S, vi): i64 {
    var ci = _vcst_ix(S, vi);
    if (ci < 0) { return 0; }
    _cst_value(S, ci);
    return L64(_cst_tab + ci * 64 + 40) + 1;
}

# ── local consts ──────────────────────────────────────────────────────────────────────────────────
# `_lc_tab` (6 words): name, scope depth, inline depth, kind, value, float-literal index.
fn _lc_find(S, name): i64 {
    var i = _lc_n - 1;
    while (i >= _lc_floor) {
        var e = _lc_tab + i * 48;
        if (L64(e + 16) == GIDEP(S)) { if (STREQ(S, L64(e), name) == 1) {
                # a var of the same name declared at least as deeply hides it
                if (GINFN(S) == 1) {
                    var li = FINDLOCAL(S, name);
                    if (li >= 0) { if (GLDEP(S, li) >= L64(e + 8)) { return 0 - 1; } }
                }
                return i;
            } }
        i = i - 1;
    }
    return 0 - 1;
}
fn _lc_pop(S, dep): i64 {
    while (_lc_n > _lc_floor) {
        if (L64(_lc_tab + (_lc_n - 1) * 48 + 8) < dep) { return 0; }
        _lc_n = _lc_n - 1;
    }
    return 0;
}
# 6.7.14 — the end of an `#inline` / generic body replay (PARSE_FNCALL), whose body ran one scope
# deeper than the call (`dep` + 1) with no SCOPE_POP: its local consts end with it, as a block's do,
# and the caller's depth is back. They outlived the replay, so a second call in the same scope met
# the first one's `L` at the same (scope, inline) depth: "'L' is already declared in this scope".
# A helper so PARSE_FNCALL (a cybs-ceiling fn) keeps its reference count. CHANGELOG [6.7.14]
fn _inl_scope_end(S, dep): i64 {
    _lc_pop(S, dep + 1);
    SSDEP(S, dep);
    return 0;
}
# ── the parser's side ─────────────────────────────────────────────────────────────────────────────
fn GFCFN(S, fi): i64 { if (_fnt_cfn == 0) { return 0; } if (fi < 0) { return 0; } return load8(_fnt_cfn + fi); }
fn SFCFN(S, fi, v): i64 { if (_fnt_cfn == 0) { _fnt_cfn = alloc(131072); } store8(_fnt_cfn + fi, v); return 0; }
# Cursor on an expression in a const context (an array size, `#assert`, a case label, an enum
# value, a local const): its value, its kind in `_ce_k`, `_ce_err` = 1 when it was refused
# (reported). The cursor is left after it.
fn _ce_eval_here(S): i64 {
    var sv_ti = _ce_ti; var sv_top = _ce_top; var sv_in = _ce_infn; var sv_skip = _ce_skip; var sv_fb = _ce_fb;
    _ce_ti = GTI(S);
    _ce_top = 0;
    _ce_infn = 0;
    _ce_err = 0;
    _ce_skip = 0;
    _ce_steps = 0;
    var v = _ce_expr(S);
    var k = _ce_k;
    if (k == 4) { k = 0; }   # 6.7.4: an unknown kind lives only inside skip mode
    STI(S, _ce_ti);
    _ce_ti = sv_ti; _ce_top = sv_top; _ce_infn = sv_in; _ce_skip = sv_skip; _ce_fb = sv_fb;
    _ce_k = k;
    return v;
}
# The same, for a place that takes an INTEGER (`what` names it in the refusal).
fn _ce_eval_int(S, what): i64 {
    var ti = GTI(S);
    var v = _ce_eval_here(S);
    if (_ce_err == 0) { if (_ce_k != 0 && _ce_k != 3) {   # 6.7.3: a bool is the integer 0 / 1
            _ce_err = 1;
            var sv = GTI(S);
            STI(S, ti);
            ERR_MSG(S, what, _cstr_len(what));
            STI(S, sv);
            return 0;
        } }
    return v;
}
fn _cstr_len(p): i64 {
    var n = 0;
    while (load8(p + n) != 0) { n = n + 1; }
    return n;
}
# Emit const value (kind k, value v, float-literal index fx) exactly as its literal would be.
fn _cst_emit_val(S, k, v, fx): i64 {
    _cfo = 0;
    if (k == 1) { EMIT_FLOAT_LIT(S, fx); SESTYPE(S, F64_TYID); return 0; }
    if (k == 2) { ESADDR(S, v >> 32); return 0; }
    _cfp = GCP(S);
    EMOVI(S, v);
    if (v >= 0) { if (v < 0x10000) { _cfv = v; _cfo = 1; } }
    if (k == 3) { _BX_MARK(S); }   # 6.7.3: a bool const's read is a boolean value
    return 0;
}
# The factor's reads. A local const (1 = emitted), then a top-level f64 / string const (an integer
# one is an enum-constant fold, GVECP 1, on the global path).
fn _cst_read_local(S, noff): i64 {
    if (_lc_n == 0) { return 0; }
    var lc = _lc_find(S, noff);
    if (lc < 0) { return 0; }
    var e = _lc_tab + lc * 48;
    _cst_emit_val(S, L64(e + 24), L64(e + 32), L64(e + 40));
    return 1;
}
fn _cst_read_global(S, vi): i64 {
    if (_cst_n == 0) { return 0; }
    var k = _cst_vkind(S, vi);
    if (k < 2) { return 0; }
    var ci = _vcst_ix(S, vi);
    var e = _cst_tab + ci * 64;
    _cst_emit_val(S, L64(e + 40), L64(e + 48), L64(e + 56));
    return 1;
}
# 1 iff `noff` here names a const (a local one, or a top-level one no local var hides).
fn _cst_named(S, noff): i64 {
    if (_lc_n > 0) { if (_lc_find(S, noff) >= 0) { return 1; } }
    if (_cst_n == 0) { return 0; }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    if (_vcst_ix(S, _findvar_core(S, noff)) >= 0) { return 1; }
    return 0;
}
# ⛔ 6.7.14 — `.field` on a const in run-time code (the cursor past `.field`, token `dti` its `.`): a field
# store (`st` 1) or read (0) of a top-level or local const, refused by name at the `.`, once. A top-level
# const's size-0 slot has no struct ("no struct type in scope for 'C'; ... (missing include?)"), and a local
# const has no slot at all ("undefined variable 'L'" AND the no-struct error). Asked only where the base
# resolved to nothing a field can reach (PARSE_FIELD_STORE / _LOAD's undefined and `sid == 0` arms), so
# nothing that compiles changes. A read is refused IN SYNC — its expression and statement parse on to their
# end — so the latch is that statement's alone (`_pair_sync_ti`, `_stmt_resync`): the statement after
# `var v = C.x;` was skipped, and a `const L` declared there read as "undefined variable 'L'". 1 = refused
# (or stood down in a refused const fn's body). CHANGELOG [6.7.14]
# 6.7.15 — `st` 2: a method call `C.m(..)` / `L.m(..)` (the cursor on its `(`), "const 'C' has no methods":
# a top-level const said "no struct type in scope for 'C'; a method call needs its struct declaration
# (missing include?)", a local const "undefined variable 'L'". Not in sync (the arguments are not parsed):
# the statement resyncs, as the method arm's own refusal does. CHANGELOG [6.7.15]
fn _cst_fld_at(S, noff, st, dti): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_cst_named(S, noff) == 0) { return 0; }
    if (_ce_fld_said(S) == 1) { return 1; }
    if (st == 0) { if (_panic == 0) { _pair_sync_ti = GTI(S); } }
    var sv = GTI(S);
    STI(S, dti);
    if (st == 1) { ERR_IDENT(S, "cannot assign to a field of const ", noff, " - a const has no storage", 0 - 1); }
    elif (st == 2) { ERR_IDENT(S, "const ", noff, " has no methods - a const has no storage", 0 - 1); }
    else { ERR_IDENT(S, "const ", noff, " has no fields - a const has no storage", 0 - 1); }
    STI(S, sv);
    return 1;
}
# 6.7.16 — `C[i]` / `L[i]` in run-time code (the cursor on its `[`): a top-level or local const subscripted is
# refused by name at the `[`, as its `.field` is — a top-level const's size-0 slot said "cannot subscript 'C': it is
# not a typed array, ...", a local const (no slot) "undefined variable 'L'". Asked only on `_arr_sub_addr`'s
# refusing arms (no slot; no element), so nothing that compiles changes. In sync: every caller parses the brackets
# on. 1 = refused (or stood down in a refused const fn's body). CHANGELOG [6.7.16]
fn _cst_sub_at(S, noff): i64 {
    if (_cst_named(S, noff) == 0) { return 0; }
    if (_ce_fld_said(S) == 1) { return 1; }
    _refuse_in_sync(S);
    ERR_IDENT(S, "cannot subscript const ", noff, " - a const has no storage", 0 - 1);
    return 1;
}
# A const on the left of `=` / `OP=`, or under `&`: refused by name (it has no storage).
fn _cst_lvalue_check(S, noff, what): i64 {
    if (_cst_named(S, noff) == 0) { return 0; }
    if (_ce_name_said(S, noff) == 1) { _panic = 1; return 1; }   # 6.7.15: a refused const fn's check named it
    ERR_IDENT(S, what, noff, " - a const has no storage (declare it `var` to change it)", 0 - 1);
    return 1;
}
# 6.7.3: an enum constant is not an lvalue either — `A = ..`, `A OP= ..`, `&A` and the qualified
# `E.A` spellings are refused by name, as for a const. Every read of `A` folds to the declared
# value, so a write landed only in the variant's 8-byte slot and `&A` handed that dead copy out.
# `vi` is the slot the name RESOLVED to (GVENUMID is set only by enum registration), so a local,
# a closure capture and a later top-level `var A` (last definition wins) stay variables.
# CHANGELOG [6.7.3]
fn _enum_lv_refuse(S, vi, noff, what): i64 {
    if (vi < 0) { return 0; }
    if (GVENUMID(S, vi) == 0) { return 0; }
    ERR_IDENT(S, what, noff, " - an enum constant is a fixed value, not a variable (declare a `var` to change it)", 0 - 1);
    return 1;
}
# The left of `=` / `OP=` (a statement or a classic-for step): a const, then an enum constant.
# The global lookup goes first — one hash probe — so a local's assignment never pays a second
# FINDLOCAL scan; the local only matters when the name resolves to an enum constant.
fn _asg_lvalue_refused(S, noff): i64 {
    if (_cst_n > 0 || _lc_n > 0) { if (_cst_lvalue_check(S, noff, "cannot assign to const ") == 1) { return 1; } }
    var vi = _findvar_core(S, noff);   # not FINDVAR: the store's own lookup reports `private`
    if (vi < 0) { return 0; }
    if (GVENUMID(S, vi) == 0) { return 0; }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    return _enum_lv_refuse(S, vi, noff, "cannot assign to enum constant ");
}
# ⛔ 6.7.14 — the lvalue refusal where an assignment FOLLOWS the name (`=` or an `op =` pair, nothing
# consumed). A statement or a classic-for step naming a const or an enum constant without one — `N;`,
# `N + 1;`, `N == 5;`, `GREEN;`, a step `N` — was refused "cannot assign to const 'N'" though nothing was
# assigned; it is the syntax error a variable gets there, "expected '=', got ';'", reported here so the
# caller steps the statement over as after the refusal (a local const `L;` parsed on and added
# "undefined variable 'L'"). 1 = refused. CHANGELOG [6.7.14]
fn _asg_lvalue_at(S, noff): i64 {
    if (_slit_stmt(S, noff) == 1) { return 1; }   # 6.7.14 (D12 (a)): a statement `P { .. };`
    if (_asg_pair_at(S) == 1) {
        if (_asg_lvalue_refused(S, noff) == 1) { return 1; }
        return _asg_cap_first(S, noff, GTI(S) - 1);   # 6.7.14: a captured name, at the name (parse.cyr)
    }
    if (_asg_lvalue_is(S, noff) == 0) { return 0; }
    ERR_EXPECT(S, 4);
    return 1;
}
# 1 = `noff` here is what `_asg_lvalue_refused` refuses (a const, or an enum constant no local hides),
# nothing printed. Its lookups, in its order.
fn _asg_lvalue_is(S, noff): i64 {
    if (_cst_n > 0 || _lc_n > 0) { if (_cst_named(S, noff) == 1) { return 1; } }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    if (GVENUMID(S, vi) == 0) { return 0; }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    return 1;
}
# `&name` (cursor past the name): the address-of ladder's own order — local, closure capture,
# global — then the qualified `&E.A` when no global of that name exists.
fn _addr_lvalue_refused(S, noff): i64 {
    if (_cst_n > 0 || _lc_n > 0) { if (_cst_lvalue_check(S, noff, "cannot take the address of const ") == 1) { return 1; } }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) {
            var esl = _cl_snap_find(S, noff);
            if (esl >= 0) { if (_cl_cap_find(esl) >= 0) { return 0; } }
        } }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return _enum_qual_lv_refuse(S, noff, "cannot take the address of enum constant "); }
    return _enum_lv_refuse(S, vi, noff, "cannot take the address of enum constant ");
}
# `&E.A` (cursor on the `.`, `bnoff` = E, which names no variable): refused as `&A` is when E is
# an enum declaring A, the cursor stepped past `A`. 0 otherwise, the cursor kept.
fn _enum_qual_lv_refuse(S, bnoff, what): i64 {
    if (PEEKT(S) != 41) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
    var vn = TOKVAL(S, GTI(S) + 1);
    var vi = _enum_variant_in(S, bnoff, vn);
    if (vi < 0) { return _enum_qual_lv_bad(S, bnoff, vn); }
    STI(S, GTI(S) + 2);
    return _enum_lv_refuse(S, vi, vn, what);
}
# PARSE_FIELD_STORE, base `bnoff` naming no variable, `.vn` consumed: `E.A = ..` / `E.A OP= ..` on
# a variant of an enum named E is refused as `A = ..` is, and the statement stepped over. 6.7.14: with no
# assignment after it (`E.A;`, `E.A + 1;`) it is the syntax error `A;` is, "expected '='" (it said
# "cannot assign to enum constant 'A'").
# 6.7.16: E an enum declaring no `vn` — "'vn' is not a variant of 'E'", the statement stepped — not "undefined
# variable 'E'" (issues/archived/2026-10-19-enum-qualified-unknown-member-named-as-unknown-enum.md). CHANGELOG [6.7.16]
fn _enum_qual_store_refused(S, bnoff, vn): i64 {
    var vi = _enum_variant_in(S, bnoff, vn);
    if (vi < 0) {
        if (_enum_qual_bad(S, bnoff, vn, GTI(S) - 1) == 0) { return 0; }
        _cst_skip_sync(S);
        return 1;
    }
    if (_asg_pair_at(S) == 1) { _enum_lv_refuse(S, vi, vn, "cannot assign to enum constant "); }
    else { ERR_EXPECT(S, 4); }
    _cst_skip_sync(S);   # the rest of the statement, to its `;` (6.7.14: in sync)
    return 1;
}
# 6.7.14 — a refusal at a statement's first name with the rest stepped over to its `;`: the statement ends in
# sync, so the latch is cleared there (`_pair_sync_ti`, `_stmt_resync`) instead of resyncing over the NEXT
# statement — `N = 1; GREEN = 2;` reported only `N`, every other refused statement in a row lost. A classic-for
# step's overshoot is PARSE_FOR's to undo; the `for` statement then ends at its body's `}`. CHANGELOG [6.7.14]
fn _cst_skip_sync(S): i64 {
    _cst_skip_decl(S);
    _pair_sync_ti = GTI(S) - 1;
    return 0;
}
# Cursor on a top-level `const NAME = ...;` the pre-scan recorded: step over it (no code).
# 6.7.17: and at a declaration keyword beginning a later line (`_gv_entry_cut`): a `const C = 1` missing its `;`
# stepped the fns after it to the first statement's `;`, unregistered and unparsed, their errors never reported.
# CHANGELOG [6.7.17]
fn _cst_skip_decl(S): i64 {
    _pub_pending = 0;
    var d = 0;
    var st = GTI(S);
    while (PEEKT(S) != 12) {
        var t = PEEKT(S);
        if (d <= 0) { if (_gv_entry_cut(S, st) == 1) { return 0; } }
        if (t == 10 || t == 13 || t == 28) { d = d + 1; }
        if (t == 11 || t == 14 || t == 29) { d = d - 1; }
        if (t == 5) { if (d <= 0) { STI(S, GTI(S) + 1); return 0; } }
        STI(S, GTI(S) + 1);
    }
    return 0;
}
fn _cst_is_top(S, ti): i64 {
    var i = 0;
    while (i < _cst_n) {
        if (L64(_cst_tab + i * 64 + 16) == ti) { return 1; }
        i = i + 1;
    }
    return 0;
}
# PARSE_STMT on `const`: a recorded top-level declaration is stepped over; anything else is a
# LOCAL const — evaluated here, entered in the scoped table, no code and no frame slot.
fn _cst_stmt(S): i64 {
    var ti = GTI(S);
    if (_cst_is_top(S, ti) == 1) { _cst_skip_decl(S); return 0; }
    STI(S, ti + 1);
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); return 0; }
    var name = PEEKV(S);
    _RSV_INTRINSIC_DECL(S, name, GTI(S), 0);
    STI(S, GTI(S) + 1);
    if (PEEKT(S) == 49) {   # refused, then bound as `const NAME = e;` (6.7.13: no cascade at its reads)
        var q = _cst_ann_eq(S, GTI(S));
        if (q == 0) { ERR_MSG(S, "a const takes no type annotation: its type is its value's", 57); return 0; }
        _cst_ann_err(S, GTI(S));
        STI(S, q);
    }
    if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); return 0; }
    STI(S, GTI(S) + 1);
    _lc_dup_check(S, name, ti + 1);
    var v = _ce_eval_here(S);
    var k = _ce_k;
    if (_ce_err == 1) { v = 0; k = 0; }
    _expect_step(S, 5);
    _lc_push(S, name, k, v, ti + 1);
    return 0;
}
# `nti` is the name token: its offset is where the const was DECLARED (`_lc_decl`) — an `#inline`
# replay re-parses the body's own tokens, so it stays the declaration's, never the call site's. The
# aarch64 native-region warning judges a local const by it. CHANGELOG [6.7.15]
fn _lc_push(S, name, k, v, nti): i64 {
    if (_lc_tab == 0) { _lc_tab = alloc(65536 * 48); _lc_decl = alloc(65536 * 4); }
    if (_lc_n >= 65536) { ERR_MSG(S, "too many local consts (max 65536)", 33); return 0; }
    store32(_lc_decl + _lc_n * 4, GTOFF(S, nti) + 1);
    var e = _lc_tab + _lc_n * 48;
    S64(e, name);
    S64(e + 8, GSDEP(S));
    S64(e + 16, GIDEP(S));
    S64(e + 24, k);
    S64(e + 32, v);
    var fx = 0 - 1;
    if (k == 1) { fx = FLIT_ADD(v); }
    S64(e + 40, fx);
    _lc_n = _lc_n + 1;
    return 0;
}
# A local const named like a var or const already declared in THIS scope.
fn _lc_dup_check(S, name, ti): i64 {
    var dup = 0;
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, name);
        if (li >= 0) { if (GLDEP(S, li) == GSDEP(S)) { dup = 1; } }
    }
    var i = _lc_n - 1;
    while (i >= _lc_floor) {
        var e = _lc_tab + i * 48;
        if (L64(e + 8) == GSDEP(S)) { if (L64(e + 16) == GIDEP(S)) { if (STREQ(S, L64(e), name) == 1) { dup = 1; } } }
        i = i - 1;
    }
    if (dup == 1) { _bnd_err_at(S, ti, "", name, " is already declared in this scope", 0 - 1); }
    return 0;
}
# PARSE_VAR's side: a `var` named like a local const of the same scope.
fn _lc_var_dup(S, name): i64 {
    if (_lc_n == 0) { return 0; }
    var i = _lc_n - 1;
    while (i >= _lc_floor) {
        var e = _lc_tab + i * 48;
        if (L64(e + 8) == GSDEP(S)) { if (L64(e + 16) == GIDEP(S)) { if (STREQ(S, L64(e), name) == 1) {
                    ERR_IDENT(S, "", name, " is already declared in this scope (a const)", 0 - 1);
                    return 1;
                } } }
        i = i - 1;
    }
    return 0;
}

# ── const contexts the parser reads twice: a `case` label (the switch's pre-scan, then its body
# paths) and an enum value (pass 1, then pass 2) — evaluated ONCE, replayed by token index, so a
# refusal is reported once. `_clm` (3 words): label token, value, the token after it (its `:` /
# terminator). A switch trims what it added when it ends (nested switches stack).
fn _clm_find(ti): i64 {
    var i = _clm_n - 1;
    while (i >= 0) {
        if (load64(_clm + i * 24) == ti) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}
fn _clm_add(ti, v, end): i64 {
    if (_clm == 0) { _clm = alloc(65536 * 24); }
    if (_clm_n >= 65536) { return 0; }
    var e = _clm + _clm_n * 24;
    store64(e, ti); store64(e + 8, v); store64(e + 16, end);
    _clm_n = _clm_n + 1;
    return 0;
}
# A label / value at the cursor: a plain number (followed by `stop`) as before, else an integer
# const expression. The cursor is left after it. `_case_ok` = 0 when it was refused.
fn _cst_ctx_val(S, stop, what): i64 {
    var ti = GTI(S);
    _case_ok = 1;
    if (PEEKT(S) == 1) { if (TOKTYP(S, ti + 1) == stop) { STI(S, ti + 1); return TOKVAL(S, ti); } }
    var m = _clm_find(ti);
    if (m >= 0) {
        var e = _clm + m * 24;
        STI(S, load64(e + 16));
        if (load64(e + 16) < 0) { _case_ok = 0; }
        return load64(e + 8);
    }
    var pw = _ce_ctx_open(stop);   # 6.7.15: an enum value's
    var v = _ce_eval_int(S, what);
    if (_ce_err == 1) { _case_ok = 0; }
    _cst_ctx_skip(S, stop, ti, pw);
    var end = GTI(S);
    _clm_add(ti, v, end);
    return v;
}
# An enum value the evaluator refused leaves the cursor where it stopped: on a call's NAME, the
# member loop read `h()` as a new member with a constructor, which then failed the link
# ("undefined function 'h'", "refusing to emit binary"). Past the whole expression instead, by
# the evaluator's own grammar — when that ends where a member does (`,` `;` `}`); a malformed one
# (`(1 + }`) stays where it stopped. CHANGELOG [6.7.11]
# 6.7.15: through `_ce_ctx_close`, which also puts the caller's latch back when the value ends in sync.
# 6.7.16: a case label too (`stop` its `:`), so a refused label's memo ends at its `:` (`_clm_add`) and the body
# path's replay steps there silently — it ended where the evaluator stopped, ON the label, so the body's own `:`
# check said "expected ':', got identifier 'ww'" once a body statement had cleared the latch. CHANGELOG [6.7.16]
fn _cst_ctx_skip(S, stop, ti, pw): i64 {
    if (stop >= 0) {
        _ce_ctx_close(S, ti, pw, stop, stop, stop);
        return 0;
    }
    _ce_ctx_close(S, ti, pw, 31, 5, 14);
    return 0;
}
# ⛔ 6.7.15 — A CONST CONTEXT EVALUATED IN PLACE IN PASS 1 (an enum value, a global array size) HOLDS NO LATCH
# WHEN ITS REFUSAL ENDS IN SYNC. It is evaluated with `_panic` clear (`_ce_ctx_open`), as `_ce_top_expr` has been
# since 6.7.14; a refusal whose expression ends where its context does — by the evaluator's grammar
# (`_ce_extent`), else where the evaluator stopped (`[(1 + ]`), at one of `a` / `b` / `c` (an enum member's `,` /
# `;` / `}`, an array size's `]`) — leaves the cursor there and puts the caller's latch back (`_ce_ctx_close`), so
# the next declaration reports its own error; one that ends elsewhere (`[yy zz]`) keeps the latch. Pass 1 never
# resyncs: two refused enum values or global array sizes printed only the first (`#assert`: `_assert_open`,
# parse.cyr). CHANGELOG [6.7.15]
# ⛔ 6.7.16 — AND A `case` LABEL (`stop` its `:`), which kept its statement's latch: the switch's pre-scan evaluates
# every label once and is no statement, so nothing resynced between two labels — the second refused label was
# swallowed (then misreported by the body path, above). Each label is now evaluated with the latch clear and closed
# at its `:`, the switch's own latch put back. CHANGELOG [6.7.16]
fn _ce_ctx_open(stop): i64 {
    var pw = _panic;
    _panic = 0;
    return pw;
}
fn _ce_ctx_close(S, ti, pw, a, b, c): i64 {
    if (_panic == 0) { _panic = pw; return 1; }
    var x = _ce_extent(S, ti);
    if (_ce_ctx_end(TOKTYP(S, x), a, b, c) == 0) { x = GTI(S); }   # an unclosed `(`: where the evaluator stopped
    if (_ce_ctx_end(TOKTYP(S, x), a, b, c) == 0) { return 0; }
    STI(S, x);
    _panic = pw;
    return 1;
}
fn _ce_ctx_end(t, a, b, c): i64 {
    if (t == a || t == b || t == c) { return 1; }
    return 0;
}
fn _case_val(S): i64 { return _cst_ctx_val(S, 49, "a case label must be an integer"); }
fn _enum_val(S): i64 {
    var ti = GTI(S);
    if (PEEKT(S) == 7) { if (TOKTYP(S, ti + 1) == 1) {   # `-N`, as before
            var nt = TOKTYP(S, ti + 2);
            if (nt == 5 || nt == 31 || nt == 14) { STI(S, ti + 2); return 0 - TOKVAL(S, ti + 1); }
        } }
    if (PEEKT(S) == 1) {
        var nt2 = TOKTYP(S, ti + 1);
        if (nt2 == 5 || nt2 == 31 || nt2 == 14) { STI(S, ti + 1); return TOKVAL(S, ti); }
    }
    return _cst_ctx_val(S, 0 - 1, "an enum value must be an integer");
}
# An argument scan's question (`_try_push_str_literal_arg` and its pre-scan): is token ti a
# STRING const — a whole argument, named here? It is then that string's literal.
fn _cst_str_tok(S, ti): i64 {
    if (_cst_n == 0) { if (_lc_n == 0) { return 0; } }
    if (TOKTYP(S, ti) != 2) { return 0; }
    var nt = TOKTYP(S, ti + 1);
    if (nt != 31) { if (nt != 11) { return 0; } }
    var noff = TOKVAL(S, ti);
    if (_lc_n > 0) {
        var lc = _lc_find(S, noff);
        if (lc >= 0) { if (L64(_lc_tab + lc * 48 + 24) == 2) { return 1; } return 0; }
    }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    if (_cst_vkind(S, _findvar_core(S, noff)) == 3) { return 1; }
    return 0;
}
# ⛔ 6.7.4 — PASS 1'S EXTENT OF A CONST EXPRESSION, by the evaluator's own grammar (pass 2 evaluates
# it): operand (binop operand)*, an operand being unary `-` `~` `!` before a literal, a balanced `(..)`,
# an if-expression chain (6.7.4: `if (..) {..}` `elif (..) {..}` `else {..}`), `IDENT[.IDENT][(..)]`, or a
# builtin with its `(..)`. Newlines mean nothing, as to the evaluator. The line-break heuristic it
# replaces stopped at the first operand ending a line, so `#assert 1<LF> == 1, "m";` (6.7.2) and any
# multi-line if-expression in a top-level #assert left pass 1 mid-expression — the next declaration
# was read as part of it ("undefined variable 'P'"). CHANGELOG [6.7.4]
fn _ce_extent(S, ti): i64 {
    ti = _cex_operand(S, ti);
    while (_cex_binop(TOKTYP(S, ti)) == 1) { ti = _cex_operand(S, ti + 1); }
    return ti;
}
fn _cex_binop(t): i64 {
    if (t >= 6) { if (t <= 9) { return 1; } }
    if (t >= 17) { if (t <= 22) { return 1; } }
    if (t >= 113) { if (t <= 121) { return 1; } }
    if (t == 27 || t == 34 || t == 35 || t == 36 || t == 38) { return 1; }
    if (t == 39 || t == 152 || t == 53 || t == 54) { return 1; }
    return 0;
}
fn _cex_operand(S, ti): i64 {
    var t = TOKTYP(S, ti);
    while (t == 7 || t == 37 || t == 171 || t == 27) { ti = ti + 1; t = TOKTYP(S, ti); }
    if (t == 12) { return ti; }
    if (t == 10) { return _cex_group(S, ti); }
    if (t == 15) { return _cex_ifx(S, ti); }
    if (t == 2) {
        ti = ti + 1;
        while (TOKTYP(S, ti) == 41) { if (TOKTYP(S, ti + 1) == 2) { ti = ti + 2; } else { return ti; } }
        if (TOKTYP(S, ti) == 10) { return _cex_group(S, ti); }
        return ti;
    }
    if (TOKTYP(S, ti + 1) == 10) { if (t != 1) { if (t != 61) { if (t != 30) { return _cex_group(S, ti + 1); } } } }
    return ti + 1;
}
# A balanced group from its `(` / `{` at `ti` (both kinds counted): the token after its close.
fn _cex_group(S, ti): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (ti < n) {
        var t = TOKTYP(S, ti);
        if (t == 10 || t == 13) { d = d + 1; }
        if (t == 11 || t == 14) { d = d - 1; if (d == 0) { return ti + 1; } }
        if (t == 12) { return ti; }
        ti = ti + 1;
    }
    return ti;
}
# `if (..) {..} [elif (..) {..}]* [else {..}]` from the `if` at `ti`: the token after it.
fn _cex_ifx(S, ti): i64 {
    ti = _cex_group(S, ti + 1);
    ti = _cex_group(S, ti);
    while (TOKTYP(S, ti) == 50) {
        ti = _cex_group(S, ti + 1);
        ti = _cex_group(S, ti);
    }
    if (TOKTYP(S, ti) == 23) { ti = _cex_group(S, ti + 1); }
    return ti;
}

# ── SOFTWARE BINARY64 ARITHMETIC — f64 constants computed at compile time (6.7.2) ───────────────
# WHY. A `const fn` evaluated by the compiler must give the bits the same operation gives at
# run time, on x86-64 (SSE2) and on AArch64 alike. The compiler cannot borrow the host's FPU
# for that: cybs (the seed's hand-assembly compiler, bootstrap/cybs.cyr) compiles no f64
# builtin and no float literal, so everything here is integers, and plain enough for cybs —
# no `>>>`, no unary minus, at most six parameters and six arguments, small fns (cybs fails
# SILENTLY past its per-fn limits).
#
# Values are i64 holding binary64 bits. Round to nearest, ties to even; gradual underflow
# (subnormal inputs and outputs, never flushed); overflow to infinity; IEEE signed zeros.
# NaN REFUSAL: a NaN's bit pattern is not the same on x86 and ARM (x86 makes the negative
# default NaN, ARM the positive one, and they propagate payloads differently), so no NaN is
# ever produced. A NaN operand, or an operation whose result would be one (inf - inf,
# 0 * inf, 0 / 0, inf / inf, a NaN or out-of-range conversion, a NaN compare), sets
# `_sf_err` to 1 and returns 0, for the caller to refuse the constant. `_sf_err` is never
# cleared here. `_sf_neg` / `_sf_abs` are pure sign-bit operations and never refuse.
#
# Internal form: (-1)^s * m * 2^(e - 1084), m in [2^62, 2^63) once normalized — the 53 kept
# bits are 62..10, bits 9..0 are the rounding bits, bit 0 also carries the sticky bit.
# High 64 bits of the last _sf_mul128 product.
var _sf_hi = 0;
# Exponent that goes with the last _sf_unpack significand.
var _sf_ue = 0;

# Set the refusal flag; 0 is returned in place of the value.
fn _sf_fail(): i64 {
    _sf_err = 1;
    return 0;
}

# 1 when x is a NaN (exponent all ones, fraction nonzero), either sign.
fn _sf_isnan(x): i64 {
    if ((x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { return 1; }
    return 0;
}

# The exponent field of finite x, 1 for a subnormal: value = _sf_sg(x) * 2^(_sf_ex(x) - 1075).
fn _sf_ex(x): i64 {
    var e = (x >> 52) & 0x7FF;
    if (e == 0) { return 1; }
    return e;
}

# The 53-bit significand of finite x: the fraction, plus the implicit bit when x is normal.
fn _sf_sg(x): i64 {
    var m = x & 0xFFFFFFFFFFFFF;
    if (((x >> 52) & 0x7FF) != 0) { m = m | 0x10000000000000; }
    return m;
}

# The significand of finite nonzero x scaled up into [2^52, 2^53); _sf_ue gets the exponent
# that goes with it (below 1 for a subnormal): value = result * 2^(_sf_ue - 1075).
fn _sf_unpack(x): i64 {
    var m = _sf_sg(x);
    var e = _sf_ex(x);
    while (m < 0x10000000000000) {
        m = m << 1;
        e = e - 1;
    }
    _sf_ue = e;
    return m;
}

# m >> d, every bit shifted out ORed into bit 0 (the sticky bit); m >= 0, d >= 0. A count past
# 62 is decided here: the hardware masks shift counts to 6 bits.
fn _sf_jam(m, d): i64 {
    if (d == 0) { return m; }
    if (d > 62) {
        if (m != 0) { return 1; }
        return 0;
    }
    var r = m >> d;
    if ((m & ((1 << d) - 1)) != 0) { r = r | 1; }
    return r;
}

# Bits of (-1)^s * m * 2^(e - 1084), m in [2^62, 2^63): nearest, ties to even, on bits 9..0.
# e is the biased exponent MINUS ONE, so the leading bit adds the last 1 to the exponent
# field; the same addition carries a significand that rounds up to 2^53 into the next
# exponent, a subnormal that rounds up to 2^52 into the least normal, and the largest finite
# into infinity. e < 0 is below the normal range: shifted (sticky) to e = 0, a subnormal.
fn _sf_round(s, e, m): i64 {
    var sb = s << 63;
    if (e > 0x7FD) { return sb | 0x7FF0000000000000; }
    var x = m;
    var ee = e;
    if (ee < 0) {
        x = _sf_jam(x, 0 - ee);
        ee = 0;
    }
    # m + 0x200 may pass 2^63; `>>` is logical, so the carry is kept.
    var r = (x + 0x200) >> 10;
    if ((x & 0x3FF) == 0x200) { r = r - (r & 1); }
    var bits = (ee << 52) + r;
    if (bits >= 0x7FF0000000000000) { bits = 0x7FF0000000000000; }
    return sb | bits;
}

# _sf_round of a positive m below 2^63, its leading bit first shifted up to bit 62 (exact).
fn _sf_norm(s, e, m): i64 {
    if (m <= 0) { return s << 63; }
    var x = m;
    var ee = e;
    while (x < 0x40000000) {
        x = x << 32;
        ee = ee - 32;
    }
    while (x < 0x4000000000000000) {
        x = x << 1;
        ee = ee - 1;
    }
    return _sf_round(s, ee, x);
}

# a + b for finite nonzero a, b with |a| >= |b|. Both significands get 9 spare bits; the
# smaller is aligned with a sticky shift. One rounding of that is exact for a sum (the sticky
# bit sits below every rounding bit) and for a difference: a gap of 0 or 1 shifts nothing
# out, and a gap of 2 or more loses at most one leading bit, while an inexact sticky makes
# the difference odd — strictly between the same two even neighbours as the true one.
# Exact cancellation is +0 (round to nearest).
fn _sf_addf(a, b): i64 {
    var ea = _sf_ex(a);
    var eb = _sf_ex(b);
    var ma = _sf_sg(a) << 9;
    var mb = _sf_sg(b) << 9;
    mb = _sf_jam(mb, ea - eb);
    var s = a >> 63;
    if ((a ^ b) < 0) {
        var d = ma - mb;
        if (d == 0) { return 0; }
        return _sf_norm(s, ea, d);
    }
    return _sf_norm(s, ea, ma + mb);
}

# a + b. +0 + -0 is +0, -0 + -0 is -0; inf + -inf refuses.
fn _sf_add(a, b): i64 {
    if (_sf_isnan(a) == 1) { return _sf_fail(); }
    if (_sf_isnan(b) == 1) { return _sf_fail(); }
    var ma = a & 0x7FFFFFFFFFFFFFFF;
    var mb = b & 0x7FFFFFFFFFFFFFFF;
    if (ma == 0x7FF0000000000000) {
        if (mb == 0x7FF0000000000000) {
            if ((a ^ b) < 0) { return _sf_fail(); }
        }
        return a;
    }
    if (mb == 0x7FF0000000000000) { return b; }
    if (mb == 0) {
        if (ma == 0) { return a & b; }
        return a;
    }
    if (ma == 0) { return b; }
    if (mb > ma) { return _sf_addf(b, a); }
    return _sf_addf(a, b);
}

# a - b, which IEEE 754 defines as a + (-b) (signed zeros included).
fn _sf_sub(a, b): i64 {
    var nb = b ^ (1 << 63);
    return _sf_add(a, nb);
}

# Unsigned 64 x 64 -> 128-bit product built from 32-bit halves: returns the low 64 bits and
# leaves the high 64 in _sf_hi. Each partial product is below 2^64 and its bits are right
# read as unsigned (the multiply keeps the low 64 bits; `>>` is logical).
fn _sf_mul128(x, y): i64 {
    var x0 = x & 0xFFFFFFFF;
    var x1 = x >> 32;
    var y0 = y & 0xFFFFFFFF;
    var y1 = y >> 32;
    var p00 = x0 * y0;
    var p01 = x0 * y1;
    var p10 = x1 * y0;
    var mid = (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF);
    _sf_hi = x1 * y1 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
    return (mid << 32) | (p00 & 0xFFFFFFFF);
}

# a * b for finite nonzero a, b. The product of two [2^52, 2^53) significands is in
# [2^104, 2^106); its top bits >> 43 land in [2^61, 2^63) and the 43 below become sticky.
fn _sf_mulf(a, b): i64 {
    var ma = _sf_unpack(a);
    var ea = _sf_ue;
    var mb = _sf_unpack(b);
    var e = ea + _sf_ue - 1023;
    var lo = _sf_mul128(ma, mb);
    var m = (_sf_hi << 21) | (lo >> 43);
    if ((lo & 0x7FFFFFFFFFF) != 0) { m = m | 1; }
    var s = (a ^ b) >> 63;
    return _sf_norm(s, e, m);
}

# a * b. 0 * inf refuses; a zero product keeps the sign of the operands' signs XORed.
fn _sf_mul(a, b): i64 {
    if (_sf_isnan(a) == 1) { return _sf_fail(); }
    if (_sf_isnan(b) == 1) { return _sf_fail(); }
    var sb = ((a ^ b) >> 63) << 63;
    var ma = a & 0x7FFFFFFFFFFFFFFF;
    var mb = b & 0x7FFFFFFFFFFFFFFF;
    if (ma == 0x7FF0000000000000) {
        if (mb == 0) { return _sf_fail(); }
        return sb | 0x7FF0000000000000;
    }
    if (mb == 0x7FF0000000000000) {
        if (ma == 0) { return _sf_fail(); }
        return sb | 0x7FF0000000000000;
    }
    if (ma == 0) { return sb; }
    if (mb == 0) { return sb; }
    return _sf_mulf(a, b);
}

# floor(x * 2^62 / y), bit 0 set when the remainder is nonzero; x, y in [2^52, 2^53), so the
# quotient is in (2^61, 2^63). Restoring long division, one bit per step; r stays below 2^54.
fn _sf_divsig(x, y): i64 {
    var r = x;
    var q = 0;
    var i = 0;
    while (i < 63) {
        q = q << 1;
        if (r >= y) {
            r = r - y;
            q = q | 1;
        }
        r = r << 1;
        i = i + 1;
    }
    if (r != 0) { q = q | 1; }
    return q;
}

# a / b for finite nonzero a, b.
fn _sf_divf(a, b): i64 {
    var ma = _sf_unpack(a);
    var ea = _sf_ue;
    var mb = _sf_unpack(b);
    var e = ea - _sf_ue + 1022;
    var q = _sf_divsig(ma, mb);
    var s = (a ^ b) >> 63;
    return _sf_norm(s, e, q);
}

# a / b. 0 / 0 and inf / inf refuse; nonzero / 0 is a signed infinity, finite / inf a
# signed zero.
fn _sf_div(a, b): i64 {
    if (_sf_isnan(a) == 1) { return _sf_fail(); }
    if (_sf_isnan(b) == 1) { return _sf_fail(); }
    var sb = ((a ^ b) >> 63) << 63;
    var ma = a & 0x7FFFFFFFFFFFFFFF;
    var mb = b & 0x7FFFFFFFFFFFFFFF;
    if (ma == 0x7FF0000000000000) {
        if (mb == 0x7FF0000000000000) { return _sf_fail(); }
        return sb | 0x7FF0000000000000;
    }
    if (mb == 0x7FF0000000000000) { return sb; }
    if (mb == 0) {
        if (ma == 0) { return _sf_fail(); }
        return sb | 0x7FF0000000000000;
    }
    if (ma == 0) { return sb; }
    return _sf_divf(a, b);
}

# The nearest binary64 to i (ties to even). -2^63 has no positive i64 magnitude and is
# exact: its bits are written out.
fn _sf_from_i64(i): i64 {
    if (i == 0) { return 0; }
    var lo = 1 << 63;
    if (i == lo) { return lo | 0x43E0000000000000; }
    if (i < 0) { return _sf_norm(1, 1084, 0 - i); }
    return _sf_norm(0, 1084, i);
}

# x truncated toward zero. A NaN, an infinity, or |x| >= 2^63 (exactly -2^63 excepted)
# refuses.
fn _sf_to_i64(x): i64 {
    if (_sf_isnan(x) == 1) { return _sf_fail(); }
    var k = ((x >> 52) & 0x7FF) - 1023;
    if (k < 0) { return 0; }
    var lo = 1 << 63;
    if (k > 62) {
        if (x == (lo | 0x43E0000000000000)) { return lo; }
        return _sf_fail();
    }
    var m = _sf_sg(x);
    if (k >= 52) { m = m << (k - 52); }
    else { m = m >> (52 - k); }
    if (x < 0) { return 0 - m; }
    return m;
}

# An integer that orders x like the reals: the magnitude bits, negated for a negative x
# (-0 and +0 are both 0, the infinities the extremes).
fn _sf_key(x): i64 {
    var m = x & 0x7FFFFFFFFFFFFFFF;
    if (x < 0) { return 0 - m; }
    return m;
}

# -1 / 0 / 1 as a < / == / > b; -0 == +0. A NaN refuses.
fn _sf_cmp(a, b): i64 {
    if (_sf_isnan(a) == 1) { return _sf_fail(); }
    if (_sf_isnan(b) == 1) { return _sf_fail(); }
    var ka = _sf_key(a);
    var kb = _sf_key(b);
    if (ka < kb) { return 0 - 1; }
    if (ka > kb) { return 1; }
    return 0;
}

# Sign-bit flip (a NaN keeps its payload; never refuses).
fn _sf_neg(x): i64 {
    return x ^ (1 << 63);
}

# Sign bit cleared (never refuses).
fn _sf_abs(x): i64 {
    return x & 0x7FFFFFFFFFFFFFFF;
}

# x rounded to an integer: toward zero, then one unit away from zero when `up` is 1 and x
# had a fraction. Exact: below 2^52 the unit is 2^(52 - k) in the bits, and its carry into
# the exponent field makes the next power of two. A zero result keeps x's sign.
fn _sf_rint(x, up): i64 {
    if (_sf_isnan(x) == 1) { return _sf_fail(); }
    var e = (x >> 52) & 0x7FF;
    # Already integral: |x| >= 2^52, and the infinities.
    if (e >= 1075) { return x; }
    var sb = (x >> 63) << 63;
    if (e < 1023) {
        if ((x & 0x7FFFFFFFFFFFFFFF) == 0) { return x; }
        if (up == 1) { return sb | 0x3FF0000000000000; }
        return sb;
    }
    var fm = (1 << (1075 - e)) - 1;
    if ((x & fm) == 0) { return x; }
    var t = x - (x & fm);
    if (up == 1) { t = t + fm + 1; }
    return t;
}

# Round toward zero: trunc(-0.5) is -0.
fn _sf_trunc(x): i64 {
    return _sf_rint(x, 0);
}

# Round toward -inf: floor(-0.5) is -1, floor(-0) is -0.
fn _sf_floor(x): i64 {
    var up = 0;
    if (x < 0) { up = 1; }
    return _sf_rint(x, up);
}

# Round toward +inf: ceil(-0.5) is -0, ceil(0.5) is 1.
fn _sf_ceil(x): i64 {
    var up = 0;
    if (x > 0) { up = 1; }
    return _sf_rint(x, up);
}
