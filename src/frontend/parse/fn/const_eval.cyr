# PARSER — fn: `const` and `const fn` — the compile-time evaluator (`_ce_*`, `_cst_*`) and its integer
# soft-float (`_sf_*`).
# ================================================================
# Split from parse/fn.cyr at 6.7.18, unchanged; parse.cyr includes parse/fn/'s files in source order. CHANGELOG [6.7.18]

# ⛔ 6.7.2 (B1, C1) — COMPILE-TIME CONSTANTS AND `const fn`.
# `const LIMIT = 7;`, `const PI = 3.14159;`, `const NAME = "cyrius";` — no storage; every use is the
# value, a string const its literal. `const fn f(..) { .. }` is an ordinary fn that a CONST CONTEXT
# (a const initializer, an array size, `#assert`, a `case` label, an enum value) runs at compile
# time; anywhere else it is a plain runtime call. User decisions, 2026-10-07 (roadmap.md § B / C1):
# int + f64 + string consts, top level and inside fns, const fn in const contexts only, its body
# the pure subset, checked at the definition.
#
# TOP-LEVEL consts are found by ONE pre-scan at the start of pass 1 (`_cst_prepass`) wherever they
# sit, so order does not matter, and each gets a global name slot of SIZE 0 (no storage) flagged
# PENDING (GVECP 2). Its first reader evaluates it: `GVECP` forces it (`_cst_force`), so every
# enum-constant reader — array sizes, `#assert`, the folder, the factor — takes an integer const
# unchanged (GVECP 1, the value in `_vecv_base`); an f64 or string const keeps GVECP 0 and is read
# through `_cst_vkind` by the factor, which emits it as its literal. The end of pass 1 evaluates
# every const (`_cst_sweep`), used or not, so each error is reported.
# LOCAL consts live in their own scoped table (`_lc_tab`: name, scope depth, inline depth, kind,
# value) — a const has no frame slot, so a closure sees it by NAME and never captures it; a var
# and a const of one name resolve to the more deeply declared; an inline replay sees only the
# consts it declares itself; a generic instance or another fn sees none of its encloser's.
# THE EVALUATOR (`_ce_*`) interprets tokens, mirroring the parser — `||` over `&&` over ONE
# comparison over `+ - & | ^` over `* / % << >> >>>` over unary `- ~` — and its STATIC typing: an
# operator takes its float form when its LEFT operand is f64 (the right one's bits used as they
# are, as at run time), an untyped `var` is an integer whatever it holds. f64 arithmetic is the
# integer-only `_sf_*` (cybs has no float), and a NaN is refused (its bits differ by target).
# The definition check of a const fn is the same interpreter in SKIP mode over its whole body.
# CHANGELOG [6.7.2]

# ── small helpers ───────────────────────────────────────────────────────────────────────────────
# 6.7.14 — a refusal at a token already reported (`_tn_once`) is counted, not printed again. The end
# of pass 1 runs the const fn bodies its consts call (`_cst_sweep`) and pass 2 checks each definition
# again (`_ce_check_fn`, and the parser's own refusals): the same token's error was printed twice
# once pass 2 stopped starting under pass 1's latch. Marked only when it would print. 1 = said.
fn _ce_said(S): i64 {
    if (_panic == 1) { return 0; }
    if (_tn_once(S, _ce_ti) == 1) { return 0; }
    _had_error = 1;
    _panic = 1;
    return 1;
}
fn _ce_bad(S, msg, len): i64 {
    if (_ce_err == 1) { return 0; }
    _ce_err = 1;
    if (_ce_quiet == 1) { return 0; }   # 6.7.15: _ce_top_quiet
    _ce_rti = _ce_ti;   # 6.7.15 (`_ce_err_dup`)
    if (_ce_said(S) == 1) { return 0; }   # 6.7.14
    var sv = GTI(S);
    STI(S, _ce_ti);
    ERR_MSG(S, msg, len);
    STI(S, sv);
    return 0;
}
fn _ce_badn(S, msg, noff, tail): i64 {
    if (_ce_err == 1) { return 0; }
    _ce_err = 1;
    if (_ce_quiet == 1) { return 0; }   # 6.7.15: _ce_top_quiet
    _ce_rti = _ce_ti;   # 6.7.15
    _ce_bn = noff;   # 6.7.14: the subject, for `_ce_check_fn` (see `_ce_name_said`)
    if (_ce_said(S) == 1) { return 0; }   # 6.7.14
    var sv = GTI(S);
    STI(S, _ce_ti);
    ERR_IDENT(S, msg, noff, tail, 0 - 1);
    STI(S, sv);
    return 0;
}
# ⛔ 6.7.14 — A CONST FN'S BODY IS ALSO AN ORDINARY FN, COMPILED AFTER ITS DEFINITION CHECK: an unknown
# name was refused twice, "unknown name 't' in a const context" by the check and "undefined variable 't'"
# by the run-time compile, one column on (`t = 1;`: "'t' is not a local of this const fn" and the same).
# The name the check refused (`_ce_badn`'s subject, `_ce_bn`) is kept for that body (`_ce_fn_rname`,
# scoped by PARSE_FN_DEF), and an undefined-variable report of it there is counted, not printed. Another
# name stays reported: the check stops at its first refusal, and the run-time compile still names what
# the check never reached. 1 = this report is that one. CHANGELOG [6.7.14]
var _ce_bn = 0 - 1;
var _ce_fn_rname = 0 - 1;
var _ce_fn_refd = 0;
# ⛔ 6.7.15 — AND THE TOKEN IT REFUSED (`_ce_rti`, set by `_ce_bad` / `_ce_badn` / `_ce_expect`; kept for that
# body as `_ce_fn_rtok`, scoped by PARSE_FN_DEF): the body's own report of a mistake there is the same mistake
# in the parser's words — "not a compile-time expression" then "unexpected ';'" at one `;` (`var y = n +;`).
# The run-time body began under the check's latch until 6.7.15, which hid that in its first statement only.
# `_err_once`'s repeat test: 1 = printed already, or that token in that body (counted and latched, not
# printed). CHANGELOG [6.7.15]
var _ce_rti = 0 - 1;
var _ce_fn_rtok = 0 - 1;
fn _ce_err_dup(S, id): i64 {
    if (_err_dup(S, id) == 1) { return 1; }
    if (_ce_fn_rtok < 0) { return 0; }
    if (GTI(S) != _ce_fn_rtok) { return 0; }
    return 1;
}
fn _ce_name_said(S, noff): i64 {
    if (_ce_fn_rname < 0) { return 0; }
    if (STREQ(S, _ce_fn_rname, noff) == 0) { return 0; }
    _had_error = 1;
    return 1;
}
# 6.7.14 — a field arm's refusal in the run-time body of a const fn whose definition check refused it
# (`_ce_fn_refd`): a field is never in a const fn, so the check refused this one by the subset's rule (or a
# const's), or stopped at an earlier refusal; the run-time compile said "no struct type in scope for 'a'",
# blaming a missing include. Counted as ERR_IDENT would count it (the statement resyncs), not printed.
# 1 = stood down. CHANGELOG [6.7.14]
fn _ce_fld_said(S): i64 {
    if (_ce_fn_refd == 0) { return 0; }
    _ce_mx_skip(S);   # 6.7.16: `.m<..>(..)`
    _had_error = 1;
    _panic = 1;
    return 1;
}
# A runtime fault (division by zero, NaN, overflow of a conversion) — only when executing.
fn _ce_fault(S, msg, len): i64 {
    if (_ce_skip > 0) { return 0; }
    return _ce_bad(S, msg, len);
}
fn _ce_expect(S, t): i64 {
    if (_ce_err == 1) { return 0; }
    if (TOKTYP(S, _ce_ti) == t) { _ce_ti = _ce_ti + 1; return 1; }
    if (_ce_err == 0) {
        _ce_err = 1;
        if (_ce_quiet == 1) { return 0; }   # 6.7.15: _ce_top_quiet
        _ce_rti = _ce_ti;   # 6.7.15
        if (_ce_said(S) == 1) { return 0; }   # 6.7.14
        var sv = GTI(S);
        STI(S, _ce_ti);
        ERR_EXPECT(S, t);
        STI(S, sv);
    }
    return 0;
}
fn _ce_step(S): i64 {
    if (_ce_skip > 0) { return 0; }
    _ce_steps = _ce_steps + 1;
    if (_ce_steps > 10000000) { _ce_bad(S, "compile-time evaluation exceeded 10,000,000 steps (an endless loop in a const fn?)", 82); }
    return 0;
}

# ── frames: the const fn being run (5 words): name, value, kind (0 i64, 1 f64, 2 a string),
# width (8, or 4 / 2 / 1 for a narrow integer), const (1 = a `const` inside the body) ──────────
fn _ce_fr_push(S, name, v, k, w): i64 {
    if (_ce_st == 0) { _ce_st = alloc(65536 * 40); }
    if (_ce_sp >= 65536) { _ce_bad(S, "compile-time evaluation: too many locals (max 65536)", 52); return 0 - 1; }
    var e = _ce_st + _ce_sp * 40;
    store64(e, name); store64(e + 8, v); store64(e + 16, k); store64(e + 24, w); store64(e + 32, 0);
    _ce_sp = _ce_sp + 1;
    return _ce_sp - 1;
}
fn _ce_fr_find(S, name): i64 {
    var i = _ce_sp - 1;
    while (i >= _ce_fb) {
        if (STREQ(S, load64(_ce_st + i * 40), name) == 1) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}
# Narrow a value to a local's width, sign-extending as the runtime's narrow load does.
fn _ce_narrow(v, w): i64 {
    if (w == 4) { v = v & 0xFFFFFFFF; if ((v & 0x80000000) != 0) { v = v | (0 - 0x100000000); } return v; }
    if (w == 2) { v = v & 0xFFFF; if ((v & 0x8000) != 0) { v = v | (0 - 0x10000); } return v; }
    if (w == 1) { v = v & 0xFF; if ((v & 0x80) != 0) { v = v | (0 - 0x100); } return v; }
    return v;
}

# ── expressions ─────────────────────────────────────────────────────────────────────────────────
fn _ce_expr(S): i64 {
    var v = _ce_land(S);
    while (TOKTYP(S, _ce_ti) == 54) {
        if (_ce_err == 1) { return 0; }
        _ce_ti = _ce_ti + 1;
        var lt = 0;
        if (v != 0) { lt = 1; }
        if (lt == 1) { _ce_skip = _ce_skip + 1; }
        var r = _ce_land(S);
        if (lt == 1) { _ce_skip = _ce_skip - 1; v = 1; }
        else { v = 0; if (r != 0) { v = 1; } }
        _ce_k = 3;   # 6.7.3: an || link is a bool
    }
    return v;
}
fn _ce_land(S): i64 {
    var v = _ce_atom(S);
    while (TOKTYP(S, _ce_ti) == 53) {
        if (_ce_err == 1) { return 0; }
        _ce_ti = _ce_ti + 1;
        var lf = 0;
        if (v == 0) { lf = 1; }
        if (lf == 1) { _ce_skip = _ce_skip + 1; }
        var r = _ce_atom(S);
        if (lf == 1) { _ce_skip = _ce_skip - 1; v = 0; }
        else { v = 0; if (r != 0) { v = 1; } }
        _ce_k = 3;   # 6.7.3: an && link is a bool
    }
    return v;
}
fn _ce_atom(S): i64 {
    var a = _ce_add(S);
    var op = TOKTYP(S, _ce_ti);
    if (op < 17) { return a; }
    if (op > 22) { return a; }
    var ak = _ce_k;
    _ce_ti = _ce_ti + 1;
    var b = _ce_add(S);
    var bk = _ce_k;
    _ce_k = 3;   # 6.7.3: a comparison is a bool
    if (_ce_err == 1) { return 0; }
    if (_ce_skip > 0) { return 0; }
    if (ak == 2 || bk == 2) { _ce_bad(S, "a string in a comparison: a const string is a value to pass, not to compare", 75); return 0; }
    var c = 0;
    if (ak == 1) {
        _sf_err = 0;
        c = _sf_cmp(a, b);
        if (_sf_err == 1) { _ce_fault(S, "a NaN in a compile-time comparison (its result depends on the target)", 69); return 0; }
    } else {
        if (a < b) { c = 0 - 1; }
        elif (a > b) { c = 1; }
    }
    return _ce_cmp_res(op, c);
}
fn _ce_cmp_res(op, c): i64 {
    if (op == 17) { if (c == 0) { return 1; } return 0; }
    if (op == 18) { if (c != 0) { return 1; } return 0; }
    if (op == 19) { if (c < 0) { return 1; } return 0; }
    if (op == 20) { if (c > 0) { return 1; } return 0; }
    if (op == 21) { if (c <= 0) { return 1; } return 0; }
    if (c >= 0) { return 1; }
    return 0;
}
fn _ce_add(S): i64 {
    var v = _ce_term(S);
    var go = 1;
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        var t = TOKTYP(S, _ce_ti);
        if (t == 113) { t = 6; }
        if (t == 116) { t = 7; }
        if (t == 114 || t == 115 || t == 117 || t == 118) {
            _ce_bad(S, "a saturating or checked operator (+| +? -| -?) calls lib/overflow.cyr - it is not compile-time", 94);
            return 0;
        }
        if (t == 6 || t == 7 || t == 27 || t == 35 || t == 36) {
            var vk = _ce_k;
            _ce_ti = _ce_ti + 1;
            var r = _ce_term(S);
            var rk = _ce_k;
            v = _ce_binop(S, t, v, vk, r, rk);
        } else { go = 0; }
    }
    return v;
}
fn _ce_term(S): i64 {
    var v = _ce_unary(S);
    var go = 1;
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        var t = TOKTYP(S, _ce_ti);
        if (t == 119) { t = 8; }
        if (t == 120 || t == 121) {
            _ce_bad(S, "a saturating or checked operator (*| *?) calls lib/overflow.cyr - it is not compile-time", 88);
            return 0;
        }
        if (t == 8 || t == 9 || t == 34 || t == 38 || t == 39 || t == 152) {
            var vk = _ce_k;
            _ce_ti = _ce_ti + 1;
            var r = _ce_unary(S);
            var rk = _ce_k;
            v = _ce_binop(S, t, v, vk, r, rk);
        } else { go = 0; }
    }
    return v;
}
# One binary operator, the left operand's static kind choosing int or float (as PEXPR / PARSE_TERM).
fn _ce_binop(S, t, a, ak, b, bk): i64 {
    _ce_k = 0;
    if (_ce_err == 1) { return 0; }
    if (_ce_skip > 0) {
        if (ak == 1) { if (t == 6 || t == 7 || t == 8 || t == 9) { _ce_k = 1; } }
        if (ak == 4) { if (t == 6 || t == 7 || t == 8 || t == 9) { _ce_k = 4; } }   # 6.7.4: still unknown
        return 0;
    }
    if (ak == 2 || bk == 2) { _ce_bad(S, "a string in arithmetic: a const string is a value to pass, not to compute with", 78); return 0; }
    if (ak == 1) { if (t == 6 || t == 7 || t == 8 || t == 9) { return _ce_fbin(S, t, a, b); } }
    return _ce_ibin(S, t, a, b);
}
fn _ce_fbin(S, t, a, b): i64 {
    _sf_err = 0;
    var r = 0;
    if (t == 6) { r = _sf_add(a, b); }
    elif (t == 7) { r = _sf_sub(a, b); }
    elif (t == 8) { r = _sf_mul(a, b); }
    else { r = _sf_div(a, b); }
    if (_sf_err == 1) { _ce_fault(S, "a NaN in compile-time f64 arithmetic (an operand, or 0/0, inf-inf, 0*inf): its bits depend on the target", 104); return 0; }
    _ce_k = 1;
    return r;
}
fn _ce_ibin(S, t, a, b): i64 {
    if (t == 6) { return a + b; }
    if (t == 7) { return a - b; }
    if (t == 27) { return a & b; }
    if (t == 35) { return a | b; }
    if (t == 36) { return a ^ b; }
    if (t == 8) { return a * b; }
    if (t == 38) { return a << (b & 63); }
    if (t == 39) { return a >> (b & 63); }
    if (t == 152) { return _CF_ASR(a, b); }
    if (b == 0) { _ce_fault(S, "division by zero in a compile-time evaluation", 45); return 0; }
    if (t == 9) {
        if (b == 0 - 1) { return 0 - a; }   # INT_MIN / -1 wraps, as the literal folder does (_CF_TERM)
        return a / b;
    }
    if (b == 0 - 1) { return 0; }
    return a % b;
}
fn _ce_unary(S): i64 {
    var t = TOKTYP(S, _ce_ti);
    if (t == 7) {
        _ce_ti = _ce_ti + 1;
        var v = _ce_unary(S);
        if (_ce_k == 2) { _ce_bad(S, "a string in arithmetic: a const string is a value to pass, not to compute with", 78); return 0; }
        if (_ce_k == 1) { return _sf_neg(v); }
        if (_ce_k == 3) { _ce_k = 0; }   # 6.7.3: `-ok` is an integer, as at run time
        return 0 - v;
    }
    if (t == 37) {
        _ce_ti = _ce_ti + 1;
        var w = _ce_unary(S);
        if (_ce_k == 2) { _ce_bad(S, "a string in arithmetic: a const string is a value to pass, not to compute with", 78); return 0; }
        _ce_k = 0;
        return w ^ (0 - 1);
    }
    if (t == 171) {
        # `!x` (6.7.3): 1 when the operand's word is 0 — an f64 operand is its raw bits, as at run time.
        _ce_ti = _ce_ti + 1;
        var nv = _ce_unary(S);
        if (_ce_k == 2) { _ce_bad(S, "a string in arithmetic: a const string is a value to pass, not to compute with", 78); return 0; }
        _ce_k = 3;
        if (nv == 0) { return 1; }
        return 0;
    }
    return _ce_factor(S);
}
fn _ce_factor(S): i64 {
    _ce_k = 0;
    if (_ce_err == 1) { return 0; }
    var t = TOKTYP(S, _ce_ti);
    if (t == 1) { var v = TOKVAL(S, _ce_ti); _ce_ti = _ce_ti + 1; return v; }
    if (t == 169) { _ce_ti = _ce_ti + 1; _ce_k = 3; return 1; }   # true (6.7.3) — kind 3, a bool
    if (t == 170) { _ce_ti = _ce_ti + 1; _ce_k = 3; return 0; }   # false
    if (t == 61) { var fv = FLIT_NUM(TOKVAL(S, _ce_ti)); _ce_ti = _ce_ti + 1; _ce_k = 1; return fv; }
    if (t == 30) { var sv = TOKVAL(S, _ce_ti); _ce_ti = _ce_ti + 1; _ce_k = 2; return sv; }
    if (t == 10) {
        if (_tup_commas(S, _ce_ti) > 0) {   # 6.7.7 (B4, R5): `const C = (1, 2);`, a literal in a const fn
            _ce_bad(S, "a tuple in a const context - a const is one value (take a tuple at run time: `var t = ( .. );`)", 95);
            return 0;
        }
        _ce_ti = _ce_ti + 1;
        var pv = _ce_expr(S);
        var pk = _ce_k;
        _ce_expect(S, 11);
        _ce_k = pk;
        return pv;
    }
    if (_ce_fbuiltin(t) == 1) { return _ce_fcall(S, t); }
    if (t == 2) { return _ce_name(S); }
    if (t == 15) { return _ce_ifx(S); }   # 6.7.4 (B3): an if-expression
    _ce_bad(S, "not a compile-time expression: a const context takes literals, consts, enum constants, sizeof, const fn calls and arithmetic", 124);
    return 0;
}

# The f64 builtins a const evaluation takes — exact operations only (no transcendental: its
# runtime result is the target's library's, not something to reproduce bit for bit).
fn _ce_fbuiltin(t): i64 {
    if (t >= 62) { if (t <= 71) { return 1; } }
    if (t >= 80) { if (t <= 82) { return 1; } }
    if (t >= 164) { if (t <= 166) { return 1; } }
    return 0;
}
fn _ce_fcall(S, t): i64 {
    _ce_ti = _ce_ti + 1;
    if (_ce_expect(S, 10) == 0) { return 0; }
    var a = _ce_expr(S);
    var ak = _ce_k;
    var b = 0;
    var two = 0;
    if (t >= 62) { if (t <= 65) { two = 1; } }
    if (t >= 68) { if (t <= 70) { two = 1; } }
    if (t == 164 || t == 165) { two = 1; }
    if (two == 1) {
        _ce_expect(S, 31);
        b = _ce_expr(S);
    }
    _ce_expect(S, 11);
    _ce_k = 0;
    if (_ce_err == 1) { return 0; }
    if (_ce_skip > 0) { if (_ce_fres(t) == 1) { _ce_k = 1; } return 0; }
    if (ak == 2) { _ce_bad(S, "a string passed to an f64 builtin", 33); return 0; }
    return _ce_fop(S, t, a, b);
}
# 1 iff builtin t returns an f64 (the rest return an i64: f64_to and the comparisons).
fn _ce_fres(t): i64 {
    if (t == 67) { return 0; }
    if (t >= 68) { if (t <= 70) { return 0; } }
    if (t == 164 || t == 165) { return 0; }
    return 1;
}
fn _ce_fop(S, t, a, b): i64 {
    _sf_err = 0;
    var r = 0;
    if (t == 62) { r = _sf_add(a, b); }
    elif (t == 63) { r = _sf_sub(a, b); }
    elif (t == 64) { r = _sf_mul(a, b); }
    elif (t == 65) { r = _sf_div(a, b); }
    elif (t == 66) { r = _sf_from_i64(a); }
    elif (t == 67) { r = _sf_to_i64(a); }
    elif (t == 71) { r = _sf_neg(a); }
    elif (t == 80) { r = _sf_abs(a); }
    elif (t == 81) { r = _sf_floor(a); }
    elif (t == 82) { r = _sf_ceil(a); }
    elif (t == 166) { r = _sf_trunc(a); }
    else { r = _ce_fcmpb(S, t, a, b); }
    if (_sf_err == 1) { _ce_fault(S, "a NaN, or an f64 out of the i64 range, in a compile-time f64 builtin (its result depends on the target)", 103); return 0; }
    if (_ce_fres(t) == 1) { _ce_k = 1; }
    return r;
}
fn _ce_fcmpb(S, t, a, b): i64 {
    var c = _sf_cmp(a, b);
    if (t == 68) { if (c == 0) { return 1; } return 0; }
    if (t == 69) { if (c < 0) { return 1; } return 0; }
    if (t == 70) { if (c > 0) { return 1; } return 0; }
    if (t == 164) { if (c <= 0) { return 1; } return 0; }
    if (c >= 0) { return 1; }
    return 0;
}

# ⛔ 6.7.14 — `.field` after a name the evaluator holds as a value (`_ce_ti` on the name): a const fn's local
# (`isc` 0) is refused by the pure subset's rule, a const (`isc` 1: a top-level or local const, or a `const` in a
# const fn body) by its own — at the `.`. Both said "expected ';', got '.'" (an array size "expected ']'", a const's
# value "expected ';' after a const's value"). 1 = refused. CHANGELOG [6.7.14]
# 6.7.15 — and a method call `.m(`, which said "expected ';', got '.'" too: on a const fn's local "a method
# call is not in a const fn" (it calls only const fns), on a const "const 'C' has no methods". CHANGELOG [6.7.15]
# 6.7.16 — and the explicit generic spelling `.m<..>(` (`_ce_mtargs_at`), taken as a field until now: "a field is
# not in a const fn" (a const's "has no fields"), and the run-time body then read `<i64>` as a comparison
# ("undefined variable 'i64'"; stepped over by `_ce_mx_skip`). CHANGELOG [6.7.16]
