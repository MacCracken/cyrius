    var top = _ce_ti;
    var go = 1;
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        _ce_ti = top;
        var run = 0;
        if (_ce_skip == 0) { run = 1; }
        _ce_arm(S, run);
        if (run == 0) { go = 0; }
        if (_ce_ret == 1) { go = 0; }
        if (_ce_ret == 2) { _ce_ret = 0; go = 0; }
        if (_ce_ret == 3) { _ce_ret = 0; }
        _ce_step(S);
    }
    return 0;
}
