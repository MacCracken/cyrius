}
fn _ce_assign(S, cop): i64 {
    var name = TOKVAL(S, _ce_ti);
    var fi = _ce_fr_find(S, name);
    if (fi < 0) {
        _ce_badn(S, "", name, " is not a local of this const fn - a const fn assigns only its own locals");
        return 0;
    }
    var fe = _ce_st + fi * 40;
    if (load64(fe + 32) == 1) { _ce_badn(S, "cannot assign to const ", name, ""); return 0; }
    if (cop == 0) { _ce_ti = _ce_ti + 2; } else { _ce_ti = _ce_ti + 3; }
    var r = _ce_expr(S);
    var rk = _ce_k;
    _ce_expect(S, 5);
    if (_ce_err == 1) { return 0; }
    if (_ce_skip > 0) { return 0; }
    var lk = load64(fe + 16);
    var nv = r;
    var nk = rk;
    if (cop != 0) {
        nv = _ce_binop(S, cop, load64(fe + 8), lk, r, rk);
        nk = _ce_k;
    }
    if (nk != 2) { nk = lk; if (lk == 2) { nk = 0; } }
    if (nk == 0) { nv = _ce_narrow(nv, load64(fe + 24)); }
