# The token after the `]` closing the `[` at token ti (any nesting), else ti: an unclosed one stops at `;` `{` `}`.
fn _ce_brk_end(S, ti): i64 {
    var d = 0;
    var i = ti;
    var n = GTCNT(S);
    while (i < n) {
