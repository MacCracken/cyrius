        if (t == 5 || t == 12 || t == 13 || t == 14) { return ti; }
        if (t == 28) { d = d + 1; }
        if (t == 29) {
            d = d - 1;
            if (d == 0) { return i + 1; }
        }
        i = i + 1;
    }
    return ti;
}
