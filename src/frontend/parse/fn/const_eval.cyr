# 6.7.4 (B3) — THE IF-EXPRESSION IN A CONST CONTEXT, the parser's grammar and rules: `if (c) { a }
# elif (d) { b } else { e }`, one expression per arm, `else` required; the taken arm runs and the
# others (and every later condition) are walked in skip mode, so `if (N > 0) { 10 / N } else { 0 }`
# never divides by zero. Every arm the same class — an integer (a bool included), an f64, a string —
# else refused by name, in the parser's words (outside a const fn: its body is also compiled, and the
# parser reports it there). The result is a bool when every arm is. An arm walked in skip mode that
# names a top-level const not evaluated yet (pass 1) has kind 4, unknown: it is recorded and
# re-checked when every const is known (_ce_xpend_check), so a forward const neither makes a false
# cycle nor slips a mismatch through. CHANGELOG [6.7.4]
fn _ce_ifx(S): i64 {
    var p0 = _ce_pend_n;
    _ce_ti = _ce_ti + 1;
    var c = _ce_cond(S);
    var done = 0;
    var res = 0;
    var st = 0;
    var run = 0;
    if (_ce_skip == 0) { if (c == 1) { run = 1; done = 1; } }
    var v = _ce_xarm(S, run);
    if (run == 1) { res = v; }
    st = _ce_xmerge(S, st, _ce_k, _ce_xbt);
    var go = 1;
    var els = 0;
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        var t = TOKTYP(S, _ce_ti);
        if (t == 50) {
            _ce_ti = _ce_ti + 1;
            if (done == 1) { _ce_skip = _ce_skip + 1; }
            var c2 = _ce_cond(S);
            if (done == 1) { _ce_skip = _ce_skip - 1; c2 = 0; }
            run = 0;
            if (_ce_skip == 0) { if (c2 == 1) { run = 1; done = 1; } }
            v = _ce_xarm(S, run);
            if (run == 1) { res = v; }
            st = _ce_xmerge(S, st, _ce_k, _ce_xbt);
        } elif (t == 23) {
            _ce_ti = _ce_ti + 1;
            run = 0;
            if (_ce_skip == 0) { if (done == 0) { run = 1; } }
            v = _ce_xarm(S, run);
            if (run == 1) { res = v; }
            st = _ce_xmerge(S, st, _ce_k, _ce_xbt);
            els = 1;
            go = 0;
        } else { go = 0; }
    }
