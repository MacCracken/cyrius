# ⛔ 6.7.7 (B4, R4) — A TUPLE NEVER BINDS A TYPE PARAMETER. `first(t)` with `t: (i64, i64)` inferred
# T = the tuple and minted `first$(i64, i64)` — a generic over a tuple, which the decision leaves open
# (a tuple type in a generic fn is refused; so is the explicit `first<(i64, i64)>(t)`). Refused once,
# at the argument, and T binds i64 — the base, as a refused bound's call does. That recovery calls a
# base whose body may be written for a struct T (the stub refusal, an inlined `x.0`) or whose `T`
# return a capture then declines, so the panic latch swallows the rest of the statement's cascade, as
# an ERR_IDENT refusal's does — set on every parse of the call (an inline replay re-parses it; the
# report is once per token). `--syntax-only` resolves as it did: lint's pre-pass judges no type.
# CHANGELOG [6.7.7]
fn _gen_tup_bind(S, fi, a, c): i64 {
    if (_syntax_only == 1) { return c; }
    _tup_err(S, a, "a tuple cannot bind a type parameter: ", _fn_src_name(S, fi, L64(_fnt_names + fi * 8)), " is generic - pass an element (`t.0`), or take the tuple in a fn that is not generic");
    _panic = 1;
    return 0 - 8;
}
# ⛔ 6.6.10 (bite 7 review) — only a WHOLE argument binds a type parameter: a bare name (next
# token `,` / `)`) or one whole call. The first cut read the argument's first token, so `f(p.y)`,
# `f(p.x + p.y)` and `f(p + 1)` all bound T to `Pt` and instantiated `f$Pt`, whose `v + 1` then
# needed an undefined `Pt_add` — programs 6.6.9 compiled and ran. Anything else infers i64.
# 6.7.11: and an explicit generic call `g(mk1<Pt>(p))`, whose instance's return binds as `mk1(p)`'s does.
fn _gen_arg_whole(S, a): i64 {
    if (TOKTYP(S, a) != 2) { return 1; }
    var nt = TOKTYP(S, a + 1);
    if (nt == 31 || nt == 11) { return 1; }
    if (nt == 10) { return _call_is_whole_arg(S, a); }
    if (nt != 19) { return 0; }
    var o = _gcall_open(S, a);
    if (o < 0) { return 0; }
    return _call_is_whole_arg(S, o - 1);
