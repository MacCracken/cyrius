# `&name`: an inline struct local, a by-value struct parameter (whose `&` is the caller's struct,
# 6.6.6) or an inline struct global. `&q` of a pointer or of a pointer-mode handle is the slot's
# address — a `**` — and binds nothing.
fn _gsc_addr_of(S, noff): i64 {
    var li = FINDLOCAL(S, noff);
    if (li >= 0) {
        if (GLPTRP(S, li) == 1) { return 0; }
        var lt = GLTYPE(S, li);
        if (lt >= 0) { return 0; }
        if (lt <= 0 - 2048) { return 0; }
        if (GLAGG(S, li) == 1) { return 0 - lt; }
        if (_local_is_sptr_param(S, li) == 1) { return 0 - lt; }
        return 0;
    }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    if (GVPM(S, vi) != 2) { return 0; }
    var gt = GVTYPE(S, vi);
    if (gt > 0) { return gt; }
    return 0;
}
# Per generic struct INSTANCE (1-based sid): its base's sid and its two type arguments, recorded
# when `_instantiate_generic_struct` mints it. 1024 entries: REGSTRUCT's own cap. CHANGELOG [6.7.8]
var _sinst = 0;
fn _sinst_note(S, inst, base, c0, c1): i64 {
    if (inst <= 0) { return 0; }
    if (inst > 1024) { return 0; }
    if (_sinst == 0) { _sinst = alloc(1024 * 24); }
    var e = _sinst + (inst - 1) * 24;
    S64(e, base);
    S64(e + 8, c0);
    S64(e + 16, c1);
    return 0;
