# ⛔ 6.7.15 — A GENERIC METHOD'S REFUSALS NAME IT AS THE CALL SPELLS IT. The refusals below printed the fn table's
# name, so `p.pick(5)` of a stub generic method was "generic 'P_pick' has no i64 ... instance" and `p.bm(3)` of a
# bounded one "generic 'P_bm': its type argument does not implement trait 'Show'", where every other call-site
# diagnostic names `P.pick` (6.7.14, `_fn_src_name`). `_gen_msp` is set while a call spelled as a method
# (`p.m(..)`, `p.m<..>(..)`) is judged — `_mcall_gen` / `_mcall_inst`, `_meth_xinst`, `_mcall_xquiet` — and
# `_gen_ident_err` then names the method `P.pick`; any other spelling is named as written (`P_pick(p, 9)` keeps
# `P_pick`, a free generic `g`). Cleared while an instance's body is parsed (`_instantiate_generic_fn`), whose own
# calls are judged by their own spelling. CHANGELOG [6.7.15]
var _gen_msp = 0;
# ERR_IDENT's "generic 'noff'<tail>['noff2']" for generic fi, which the site names `noff` — the method spelling
# while `_gen_msp` is set. Its identity is ERR_IDENT's on `noff`, never on the scratch the spelling is written at.
fn _gen_ident_err(S, fi, noff, tail, noff2): i64 {
    var msg = "generic ";
    if (_gen_msp == 0) { return ERR_IDENT(S, msg, noff, tail, noff2); }
    if (_fn_src_name(S, fi, noff) == noff) { return ERR_IDENT(S, msg, noff, tail, noff2); }
    if (_err_once(S, (((msg * 31 + noff) * 31 + tail) * 31 + noff2) * 8 + 3) == 0) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": generic '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));   # written after the head, which may use the scratch
    PRSTR("'");
    if (tail != 0) { PRSTR(tail); }
    if (noff2 >= 0 || noff2 <= 0 - 1000) {   # 6.7.17: or a struct (`_ei_sid`)
        PRSTR("'");
        _ei_pr(S, noff2);
        PRSTR("'");
    }
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# `_gen_ident_err` whose second name is generic fi2's, spelled as the source writes it (`P.bk`, `_fn_src_name`) and
# written after the first is printed (one GNPOS scratch). Its identity is ERR_IDENT's on the table names. CHANGELOG [6.7.16]
fn _gen_fwd_err(S, fi, noff, tail, fi2): i64 {
    var msg = "generic ";
    var noff2 = L64(_fnt_names + fi2 * 8);
    if (_err_once(S, (((msg * 31 + noff) * 31 + tail) * 31 + noff2) * 8 + 3) == 0) { return 0; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": generic '");
    if (_gen_msp == 0) { PRSTR(S + 0xEC00000 + noff); }
    else { PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff)); }
    PRSTR("'");
    PRSTR(tail);
    PRSTR("'");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi2, noff2));
    PRSTR("'\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# The refusal, by name, for a scalar call / type argument / address of a stub generic fi (the site names it `noff`).
# 6.7.16 (D1): the words name the two new shapes too, and a note names the line that needs a struct.
fn _refuse_gen_stub(S, fi, noff): i64 {
    if (_slit_arg_err(S) == 1) { return 0; }   # 6.7.17: `rdb(P { .. })` is the literal's error (parse/expr.cyr)
    _gen_ident_err(S, fi, noff, " has no i64 (or other scalar) instance: it uses its type parameter as a struct (a '.field' on a T-typed value, `&x` of one returned as a struct, or a struct result over 8 bytes stored in one — directly or in a generic it forwards T to) — pass a struct argument, or name a struct type argument", 0 - 1);
    if (_err_quiet == 0) { _gen_stub_note(S, fi); }
    return 0;
}
# ⛔ 6.7.16 (the user's D1, 2026-10-19) — THE NOTE UNDER A STUB'S REFUSAL NAMES THE LINE THAT NEEDS A STRUCT: the stub's
# own (a field, `return &n;`, a struct result stored), or, for a generic that forwards its T into a stub, the forward
# and then the line at the end of the chain. Read again from the tokens (`_gs_why_scan`). CHANGELOG [6.7.16]
fn _gen_stub_note(S, fi): i64 {
    var g = fi;
    var hops = 0;
    var said = 0;
    while (hops < 1024) {
        var m = GFGM(S, g);
        var mode = 1;
        if ((m & 1) != 0) { mode = 0; }
        elif ((m & 2) == 0) { return 0; }
        if (_gs_why_scan(S, g, mode) == 0) { return 0; }
        if (mode == 0) { _gs_note(S, g); return 0; }
        if (said == 0) { _gs_note(S, g); said = 1; }
        if (_gsw_cfi < 0) { return 0; }
        g = _gsw_cfi;
        hops = hops + 1;
    }
    return 0;
