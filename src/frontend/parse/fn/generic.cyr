# ⛔ 6.6.10 — PARSE_FNCALL's head, for a call to a GENERIC (cursor just past its `(`). Struct
# inference used to exist only inside the inline replay, positionally, where `_inl_bind_param`
# then re-applied the base's i64 param type — so `var r = g(p)` with `p: Pt` ran the dead stub
# (0), `return g(p)` too, `g(2, p)` bound T from the `2`, and an inlinable body said "no struct
# type in scope for 'p'". Now an argument that infers a struct instantiates `g$Pt` exactly as
# `g<Pt>(p)` does, and a scalar call of a stub generic is refused by name. An explicit call
# (`_ta_explicit`) has already chosen its callee and is not re-inferred. Returns the fi to call.
# CHANGELOG [6.6.10]
fn _gen_call_head(S, fi, noff): i64 {
    _gh_inf0 = 0 - 8;
    _gh_inf1 = 0 - 8;
    var ex = _ta_explicit;
    _ta_explicit = 0;
    if (_MONOMORPH_OK == 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    if (ex == 2) { return fi; }   # 6.7.11: an explicit call whose instance's bound was refused
    if (ex == 0) {
        var open = GTI(S) - 1;
        _gi_sc = 0;
        var c0 = _gen_infer_tp(S, fi, open, 0);
        var c1 = _gen_infer_tp(S, fi, open, 1);
        if (c0 > 0 || c1 > 0) { return _gen_call_struct(S, fi, noff, c0, c1); }
        if (_gen_sc_inst(S, fi) == 1) { return _gen_call_struct(S, fi, noff, c0, c1); }   # 6.7.8: `Box<i32>`
        _gh_inf0 = c0;
        _gh_inf1 = c1;
    }
    if (_bnd_base_bad(S, fi) == 1) { _refuse_bnd_base(S, fi, noff); return fi; }   # 6.7.1 (C3)
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, fi, noff); }
    return fi;
}
# ⛔ 6.7.16 — A GENERIC OPERATOR fn IS CALLED AT THE INSTANCE ITS OPERANDS BIND, as its free call is (the user's
# decision D85 (a), 2026-10-20): `b + p` with `fn P1_add<T>(l: P1, r: T): G1<T>` and p a `Pt` called the i64 base (y.v
# held p's address) where `P1_add(b, p)` calls `P1_add$Pt`. The left operand [beg, opti) is argument 0 and the right
# one (from the cursor to where PARSE_TERM ends it, `_opr_end`) argument 1, each read by the call's own readers
# (`_gen_infer_tp`, through `_call_arg_pk`'s operator arm) with its end read as the call's `)` (`_opp_on`); then the
# instance, or a scalar call of a stub or a base whose bound fails refused, as `_gen_call_head` decides — named at the
# operator. Before the dispatch decides how the result returns and the operands pass: the instance's. `fi` the
# operator fn; returns the fn to call. CHANGELOG [6.7.16]
var _OPI_OPEN = 0 - 7;   # the "`(`" an operator's binding is read at (`_call_arg_pk`): no token
var _opi_l = 0 - 1;      # the left operand's first token while the binding is read
var _opi_r = 0 - 1;      # the right operand's
# The two operand ends `_op_gen_head` reads as the call's `)` (token type 11), and their own types, put back by
# `_opp_off`. Every other read of the tokens while they are set — an instance's body (`_instantiate_generic_fn`), a
# generic's signature or body scan (`_gs_params`, `_gs_scan`) — parks them (`_opp_park` / `_opp_unpark`). A `,`, a
# `)` or the EOF token stays as it is.
var _opp_a = 0 - 1;
var _opp_at = 0;
var _opp_b = 0 - 1;
var _opp_bt = 0;
# ⛔ 6.7.11 — A GENERIC METHOD CALL `p.m(..)` REACHES THE INSTANCE ITS ARGUMENTS BIND, as the free
# spelling `P_m(p, ..)` does (`_gen_call_head`), before `self` and the arguments, with the `(` at
# `open`. 6.7.9 took only an f64 binding: a struct one called the i64 base, the dead stub when the
# body uses the type parameter as a struct — `p.pick(q)` returned 0 where `P_pick(p, q)` read q.b.
# A scalar binding of a stub (or of a base whose bound i64 fails) is refused naming the method's fn,
# as the free call is (the user's decision A, 2026-10-13): `p.pick(9)` returned 0 in silence. Only
# the emitting call reports (`emit`); a lookahead (`_var_rhs_msid`) resolves quietly. `_gi_sc` is
# the free call's and is put back. `rsid` is the receiver's struct, which a type parameter on `self`
# binds (`fn me<V>(self: V)`: `p.me()` calls `P_me$P`, as `P_me(p)` does). CHANGELOG [6.7.11]
fn _mcall_gen(S, fi, open, rsid, emit): i64 {
    if (_MONOMORPH_OK == 0) { return fi; }
    if (fi < 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    if (TOKTYP(S, open) != 10) { return fi; }
    _gen_stub(S, fi);   # records GFGM
    var sv = _gi_sc;
    _gi_sc = 0;
    var c0 = _mcall_infer(S, fi, open, 0, rsid);
    var c1 = 0;
    if (((GFTP(S, fi) >> 32) & 0xFFFFFFFF) != 0) { c1 = _mcall_infer(S, fi, open, 1, rsid); }
    var sc = _gen_sc_inst(S, fi);
    _gi_sc = sv;
    if (c0 > 0 || c1 > 0 || sc == 1) { return _mcall_inst(S, fi, c0, c1, emit); }
    if (emit == 0) { return fi; }
    var noff = L64(_fnt_names + fi * 8);
    _gen_msp = 1;   # 6.7.15: its refusals name the method `P.m`
    if (_bnd_base_bad(S, fi) == 1) { _refuse_bnd_base(S, fi, noff); }
    elif (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, fi, noff); }
    _gen_msp = 0;
    return fi;
}
fn _mcall_inst(S, fi, c0, c1, emit): i64 {
    _gen_msp = 1;   # 6.7.15: its bound's refusal names the method `P.m` (a lookahead's too: it may report first)
    var spec = _instantiate_generic_fn(S, fi, c0, c1);
    if (spec < 0) { if (emit == 1) { _refuse_gen_inst(S, fi, L64(_fnt_names + fi * 8), spec); } }
    _gen_msp = 0;
    if (spec >= 0) { return spec; }
    return fi;
}
# `_gen_infer_tp` for a method call: type parameter `which`'s carrying parameter k is passed at
# position k - 1; `self` carrying it (k == 1) binds the receiver's struct `rsid` (none: i64).
fn _mcall_infer(S, fi, open, which, rsid): i64 {
    var m = GFGM(S, fi);
    var k = (m >> (8 + which * 8)) & 255;
    if (k == 0) { return _gen_infer_ind(S, fi, open, which, 1); }
    if (k == 1) { if (rsid > 0) { return rsid; } return 0 - 8; }
    var a = _call_arg_pk(S, fi, open, k - 1, k - 2);
    if (a < 0) { return 0 - 8; }
    var c = _ic_arg(S, fi, a, k);
    if (c == 0 - 9) { _gi_sc = 1; }
    return c;
}
fn _gen_call_struct(S, fi, noff, c0, c1): i64 {
    if (((GFTP(S, fi) >> 32) & 0xFFFFFFFF) == 0) { c1 = 0; }
    var spec = _instantiate_generic_fn(S, fi, c0, c1);
    if (spec >= 0) { return spec; }
    _refuse_gen_inst(S, fi, noff, spec);
    return fi;
}
fn _refuse_gen_inst(S, fi, noff, spec): i64 {
    if (spec == 0 - 4) { return 0; }   # 6.7.1: a bound refusal, already reported
    if (spec == 0 - 5) { return 0; }   # 6.7.17: a refused list, the call's own error (`_targs_refused`)
    _gen_ident_err(S, fi, noff, ": no definition to instantiate for a struct type argument", 0 - 1);
    return 0;
}
# 6.6.10 — THE FN A CALL AT TOKEN ti (`name(` / `name<..>(`) ACTUALLY REACHES: a generic's
# instance for explicit non-i64 type arguments or an argument that infers a struct, else FINDFN's
# entry. For the call paths that emit their OWN call instead of going through PARSE_FNCALL (the
# struct receives in PARSE_VAR, `_struct_call_into_temp`) and for their lookaheads, which all
# FINDFN'd the base: `var r: Box<Pt> = mk<Pt>(p)` was sized from the base's return and then
# CALLED the base with T = i64. Instantiates when needed; FINDFN is the dedup index, so the call
# itself then finds the same instance. A stub generic with scalar type arguments resolves to its
# base — the emitting path refuses it (`_gen_own_call_check`).
fn _gen_resolve_call(S, ti): i64 {
    _grc_err = 0;
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return fi; }
    if (_MONOMORPH_OK == 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    var c0 = 0 - 8;
    var c1 = 0;
    if (TOKTYP(S, ti + 1) == 19) {
        # A list naming anything but a declared struct / plain scalar / bound type parameter is
        # left to the call's own parse, which reports it — once.
        if (_targs_refused(S, ti + 2) == 1) { return _grc_refd(fi); }   # 6.7.17: no callee to judge
        if (_targs_resolvable(S, ti + 2) == 0) { return fi; }
        var sv = GTI(S);
        var sv_gt = _ta_pending_gt;
        _ta_pending_gt = 0;
        STI(S, ti + 2);
        c0 = _parse_one_type_arg(S);
        c1 = _ta_rest_f(S, fi);   # 6.7.16 (D5): the one read of the list on a path that emits its own call
        _ta_pending_gt = sv_gt;
        STI(S, sv);
        if (c0 <= 0 && c1 <= 0) {
            if (_gen_stub(S, fi) != 0) { return fi; }
            if (c0 == 0 - 8 && (c1 == 0 || c1 == 0 - 8)) { return fi; }
        }
    } else {
        _gi_sc = 0;
        c0 = _gen_infer_tp(S, fi, ti + 1, 0);
        c1 = _gen_infer_tp(S, fi, ti + 1, 1);
        if (c0 <= 0 && c1 <= 0) { if (_gen_sc_inst(S, fi) == 0) { return fi; } }   # 6.7.8: `Box<i32>`
        if (((GFTP(S, fi) >> 32) & 0xFFFFFFFF) == 0) { c1 = 0; }
    }
    var spec = _instantiate_generic_fn(S, fi, c0, c1);
    if (spec >= 0) { return spec; }
    # ⛔ 6.6.10 (bite 7 review): the base is NOT this call's callee — `var r = mk2(p, 1)` then ran it
    # with T = i64, silently. Recorded, and refused by the emitting path (`_gen_own_call_check`).
    _grc_err = spec;
    _grc_fi = fi;
    return fi;
}
# The `(` of the call at token ti — `name(`, or an explicit generic `name<..>(` whose type-argument
# list resolves (an unresolvable one is left to the call's own parse, which reports it) — or -1.
# 6.6.10: the paths that emit their OWN struct-valued call took only `name(`, so `r = mk<Pt>(p)`,
# `return mkw<Pt>(p)` and `gs(idp<i32>(4))` fell to a scalar value path.
fn _gcall_open(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0 - 1; }
    var nt = TOKTYP(S, ti + 1);
    if (nt == 10) { return ti + 1; }
    if (nt != 19) { return 0 - 1; }
    if (_MONOMORPH_OK == 0) { return _gcall_open_fl(S, ti); }   # 6.7.17 (D7): opened, refused at its arm
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return 0 - 1; }
    if (GFTP(S, fi) == 0) { return 0 - 1; }
    if (_targs_resolvable(S, ti + 2) == 0) { return 0 - 1; }
    if (_targs_refused(S, ti + 2) == 1) { return 0 - 1; }   # 6.7.17: the call's own parse refuses it
    var e = _targs_end(S, ti + 2);
    if (TOKTYP(S, e + 1) != 10) { return 0 - 1; }
    return e + 1;
}
# The token closing the type-argument list that starts at token i (`>`, or a `>>` / `>>>` tail).
fn _targs_end(S, i): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return i; }
        i = i + 1;
    }
    return n;
}
# Does every name in the type-argument list starting at token i resolve — a declared struct, a
# plain scalar, or a type parameter bound right now? (A lookahead that parsed an unresolvable
# list would report its error a second time when the call itself is parsed.)
fn _targs_resolvable(S, i): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12 || t == 13 || t == 5 || t == 10) { return 0; }
        if (t == 2) { if (_targ_name_ok(S, TOKVAL(S, i)) == 0) { return 0; } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return 1; }
        i = i + 1;
    }
    return 0;
}
# ⛔ 6.7.17 — A REFUSED TYPE-ARGUMENT LIST IS A STATE OF ITS OWN (issues/2026-10-21-refused-source-cascades-or-names-
# the-wrong-error.md, B1). The lookaheads (`_gcall_open`, `_gen_resolve_call`) read `stb<*Pt>(33)` and
# `mkg1<Pt<i32>>(33)` as calls of the base (a `*`'s list "resolved": only its names were checked) or of the instance
# D6's reading of `Pt<i32>` as Pt mints, while the call's own parse refuses the list and calls the base, arguments
# consumed (`_gen_call_refd`): the judges then said what the refused call is not — "generic 'stb' has no i64 (or other
# scalar) instance", "cannot pass 'stb' to a parameter of a different struct type", "cannot copy 'stb' into a variable
# of a different struct/vector type", and x typed `G1<Pt>` sent `x.v + 1` to an undefined `Pt_add`. 1 = the list from
# token `i` (past its `<`, closing as a list does: `_tok_targs_close`) is one the call's parse refuses — a token that is
# no name, `,` or angle (`*Pt`, `1`, `[u8]`, `dyn ..`), or a name given type arguments it takes none of (`_ngt_tail`:
# `Pt<i32>` of a non-generic Pt, `i64<u8>`; `_tp_targs_at`: a type parameter's `T<..>`). `_gcall_open` opens no call
# there and `_gen_resolve_call` answers no callee, the state recorded (`_grc_refd`, -5) so an emitting path's
# `_gen_own_call_check` stands down; the call is the factor's, whose refusal is the one error, and the receiving
# variable stays untyped and marked (`_ini_refd`). CHANGELOG [6.7.17]
fn _targs_refused(S, i): i64 {
    var e = _tok_targs_close(S, i);
    if (e < 0) { return 0; }
    while (i < e) {
        var t = TOKTYP(S, i);
        if (t == 2) {
            if (TOKTYP(S, i + 1) == 19) {
                if (_ngt_tail(S, i) != 0) { return 1; }
                if (_tp_targs_at(S, i) == 1) { return 1; }
            }
        } elif (t != 31 && t != 19 && t != 20 && t != 39 && t != 152) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn _grc_refd(fi): i64 {
    _grc_err = 0 - 5;
    _grc_fi = fi;
    return 0 - 1;
}
# 6.6.16 (C8): the lookup is the one type-name resolver's; the subset is unchanged — a struct,
# i8..i64 or f64 (what _type_arg_leaf instantiates), or a bound type parameter.
fn _targ_name_ok(S, noff): i64 {
    if (_tp_c0 != 0) { if (_tp_resolve(S, noff) != 0) { return 1; } }
    var c = _tn_resolve(S, noff);
    var k = _tn_class(c);
    if (k == 6 || k == 1) { return 1; }
    if (k == 3) { if (_tn_val(c) == 8) { return 1; } }
    return 0;
}
# The refusal for a path that emits its own call to a stub generic's base.
fn _gen_own_call_check(S, fi, noff): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (_grc_err < 0) { if (_grc_fi == fi) {
            var e = _grc_err;
            _grc_err = 0;
            _refuse_gen_inst(S, fi, noff, e);
            return 0;
        } }
    if (_bnd_base_bad(S, fi) == 1) { _refuse_bnd_base(S, fi, noff); return 0; }   # 6.7.1 (C3)
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, fi, noff); }
    return 0;
}
# The tail path (`return g(..);`) must take PARSE_FNCALL for a generic callee that the head would
# redirect or refuse: a stub base, or an argument that infers a struct. ⚠ ONLY those — diverting
# every generic cost a scalar generic its tail call (a 20,000,000-deep `cnt<T>` then SIGSEGV'd).
fn _tc_generic_divert(S, cfi, ti_after): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (cfi < 0) { return 0; }
    if (GFTP(S, cfi) == 0) { return 0; }
    if (_gen_stub(S, cfi) != 0) { return 1; }
    if (_bnd_base_bad(S, cfi) == 1) { return 1; }   # 6.7.1 (C3): the head refuses its scalar call
    _gi_sc = 0;
    if (_gen_infer_tp(S, cfi, ti_after, 0) > 0) { return 1; }
    if (_gen_infer_tp(S, cfi, ti_after, 1) > 0) { return 1; }
    return _gi_sc;   # 6.7.8: a struct carrier's scalar (`Box<i32>`) instantiates too
}

# v6.3.10 (instantiate-once): mint a deduped specialized name `base$<tyname>` into
# tok_names for a concrete-type token, returning its noff. '$' (36) is not a legal
# identifier byte, so the name is unforgeable from source. Scalar tokens → i8/i16/
# i32/i64/f64; a struct sid (>0) → the struct's name.
# v6.3.33 (generics tail): append one concrete's name-fragment at name-pool offset
# `wp`, return the new wp. Scalar → `i8`/`i16`/`i32`/`i64`/`f64`; a struct sid → the
# struct's (possibly-already-mangled, e.g. nested `Pair$i32`) name. Extracted so
# `_mint_generic_name` can append BOTH type-args for a multi-param generic.
# The fragments never collide (the user's decision C, 2026-10-13): a scalar is `i8` / `i16` / `i32` /
# `i64` / `f64`, and a struct whose name is exactly one of those spellings (`struct f64`, which a type
# argument binds before the scalar) is marked `.f64` — '.' is no identifier byte, and not the '$' that
# `_gen_is_inst` and the coverage CLI cut at. f64 was a bare `i`, so `gen<f64>` and `gen<i>` (`struct
# i`) shared `gen$i` and the second call ran the first's body. CHANGELOG [6.7.11]
fn _conc_sname_scalar(S, snoff): i64 {
    if (_bnd_type_is(S, snoff, 0 - 8) == 1) { return 1; }
    if (_bnd_type_is(S, snoff, 0 - 4) == 1) { return 1; }
    if (_bnd_type_is(S, snoff, 0 - 2) == 1) { return 1; }
    if (_bnd_type_is(S, snoff, 0 - 1) == 1) { return 1; }
    return _bnd_type_is(S, snoff, 0 - 9);
}
fn _append_conc_name(S, wp, conc): i64 {
    if (conc < 0) {
        if (conc == 0 - 9) { store8(S + 0xEC00000 + wp, 102); wp = wp + 1; }   # 'f' (f64)
        else { store8(S + 0xEC00000 + wp, 105); wp = wp + 1; }   # 'i'
        if (conc == 0 - 8) { store8(S + 0xEC00000 + wp, 54); wp = wp + 1; store8(S + 0xEC00000 + wp, 52); wp = wp + 1; }
        elif (conc == 0 - 9) { store8(S + 0xEC00000 + wp, 54); wp = wp + 1; store8(S + 0xEC00000 + wp, 52); wp = wp + 1; }
        elif (conc == 0 - 4) { store8(S + 0xEC00000 + wp, 51); wp = wp + 1; store8(S + 0xEC00000 + wp, 50); wp = wp + 1; }
        elif (conc == 0 - 2) { store8(S + 0xEC00000 + wp, 49); wp = wp + 1; store8(S + 0xEC00000 + wp, 54); wp = wp + 1; }
        elif (conc == 0 - 1) { store8(S + 0xEC00000 + wp, 56); wp = wp + 1; }
    } else {
        var snoff = L64(S + 0x1A6018 + (conc - 1) * 8);
        if (_conc_sname_scalar(S, snoff) == 1) { store8(S + 0xEC00000 + wp, 46); wp = wp + 1; }   # '.'
        var j = 0;
        while (load8(S + 0xEC00000 + snoff + j) != 0) { store8(S + 0xEC00000 + wp, load8(S + 0xEC00000 + snoff + j)); wp = wp + 1; j = j + 1; }
    }
    return wp;
}

# ⛔ 6.7.14 (D1) — A TWO-PARAMETER NAME BRACKETS A FRAGMENT THAT IS ITSELF AN INSTANCE. A generic
# struct instance's registered name already holds '$' (`P$R`, `R$i32`), so `g2<P<R>, i32>` and
# `g2<P, R<i32>>` both minted `g2$P$R$i32` and the second call ran the first's body. The fragment
# whose name holds '$' is written `<..>` — `g2$<P$R>$i32`, `g2$P$<R$i32>` — and nothing else: every
# name that did not collide (`Two$i64$i32`, the single-parameter `Box$Pair$i32`) is unchanged.
# '<' / '>' are no identifier bytes, and not the '$' that `_gen_is_inst` and the coverage CLI cut at.
# CHANGELOG [6.7.14]
fn _conc_name_nested(S, conc): i64 {
    if (conc <= 0) { return 0; }
    var p = S + 0xEC00000 + L64(S + 0x1A6018 + (conc - 1) * 8);
    var j = 0;
    while (load8(p + j) != 0) {
        if (load8(p + j) == 36) { return 1; }
        j = j + 1;
    }
    return 0;
}
fn _append_conc_frag2(S, wp, conc): i64 {
    if (_conc_name_nested(S, conc) == 0) { return _append_conc_name(S, wp, conc); }
    store8(S + 0xEC00000 + wp, 60); wp = wp + 1;   # '<'
    wp = _append_conc_name(S, wp, conc);
    store8(S + 0xEC00000 + wp, 62); wp = wp + 1;   # '>'
    return wp;
}
# The most bytes `_append_conc_frag2` writes for `conc`: the name, its '.' mark and the brackets.
fn _conc_frag_len(S, conc): i64 {
    if (conc <= 0) { return 3; }
    var p = S + 0xEC00000 + L64(S + 0x1A6018 + (conc - 1) * 8);
    var j = 0;
    while (load8(p + j) != 0) { j = j + 1; }
    return j + 3;
}

# v6.3.33: mint `Base$<conc0>` (single param) or `Base$<conc0>$<conc1>` (two distinct
# params, conc1 != 0). The two-fragment name keeps `Two<i64,i32>` and `Two<i64,i64>`
# distinct in the FINDFN/FINDSTRUCT dedup index. Single-param (conc1 == 0) mints the
# same name as before → byte-identical dedup for the existing single-param instances.
# The guard is sized from the fragments' real lengths: a nested fragment has no fixed bound.
fn _mint_generic_name(S, base_noff, conc, conc1): i64 {
    var blen = 0;
    while (load8(S + 0xEC00000 + base_noff + blen) != 0) { blen = blen + 1; }
    NPOS_GUARD(S, blen + _conc_frag_len(S, conc) + _conc_frag_len(S, conc1) + 4);
    var wp = GNPOS(S);
    var noff = wp;
    var i = 0;
    while (i < blen) { store8(S + 0xEC00000 + wp, load8(S + 0xEC00000 + base_noff + i)); wp = wp + 1; i = i + 1; }
    store8(S + 0xEC00000 + wp, 36); wp = wp + 1;   # '$'
    if (conc1 == 0) { wp = _append_conc_name(S, wp, conc); }
    else { wp = _append_conc_frag2(S, wp, conc); }
    if (conc1 != 0) {
        store8(S + 0xEC00000 + wp, 36); wp = wp + 1;   # '$'
        wp = _append_conc_frag2(S, wp, conc1);
    }
    store8(S + 0xEC00000 + wp, 0); wp = wp + 1;
    SNPOS(S, wp);
    return noff;
}

# v6.3.35 (root cause A): the inline instance below is emitted by re-invoking
# PARSE_FN_DEF, which RESETS the per-fn jump-target table (`0x19E000`) at fn start
# (`jump_target_count = 0`). Because the instance is emitted INLINE in the enclosing
# fn's code range, that reset wipes the ENCLOSING fn's recorded jump targets — so the
# enclosing fn's LASE (`IS_JUMP_TARGET`) then mis-eliminates a load that IS a branch
# join (dropping early returns, clobbering a live local, corrupting operands). Snapshot
# the enclosing targets before the inline emit and put them back after. (jump_src /
# nop-run compaction needs no restore: the enclosing fn is always `_cur_fn_has_closure`
# here → frame-trim is skipped and no nop_runs are produced.)
# ⛔ 6.7.16 — AN INSTANCE'S CODE IS OPAQUE TO THE FNS IT IS EMITTED INSIDE, AND ITS JUMP TARGETS STAY ITS OWN. They were
# merged into the enclosing fn's table so its LASE walk would not eliminate across a branch join inside the instance —
# and every instance nested in that one merged its own: the table (1023 entries) held the whole chain's, so ~190
# generics forwarding their T, called at f64, were refused "function exceeds 1023 jump targets (x86 LASE cap) -
# split the function" over a one-line main. Now the instance's range is recorded (`_jir_push`) and `IS_JUMP_TARGET`
# answers 1 anywhere inside it: the enclosing walks change no byte the instance's own passes already settled (with
# all of its targets), and the table holds the fn's own targets only. CHANGELOG [6.7.16]
fn _jt_snapshot(S): i64 {
    var n = L64(S + 0x19E000);
    var buf = alloc((n + 3) * 8);
    store64(buf, n);
    store64(buf + 8, _jir_lo);
    store64(buf + 16, _jir_n);
    var i = 0;
    while (i < n) { store64(buf + 24 + i * 8, L64(S + 0x19E008 + i * 8)); i = i + 1; }
    _jir_lo = _jir_n;   # the instance's own ranges start here
    return buf;
}
# After the instance (`jmp` the patch offset of the jump over it, the cursor at its end): the enclosing targets back
# in place of the instance's, and the instance's range recorded.
fn _jt_merge(S, buf, jmp): i64 {
    var saved = load64(buf);
    var cur = 0;
    var i = 0;
    while (i < saved) {
        if (cur < 1023) { S64(S + 0x19E008 + cur * 8, load64(buf + 24 + i * 8)); cur = cur + 1; }
        i = i + 1;
    }
    S64(S + 0x19E000, cur);
    _jir_lo = load64(buf + 8);
    _jir_n = load64(buf + 16);
    _jir_push(jmp + 4, GCP(S));
    return 0;
}

# The code ranges [start, end) of the instances emitted inline in the fns being parsed, as a stack: the fn being
# parsed owns the pairs from `_jir_lo` up (PARSE_FN_DEF truncates to it at its start: a top-level fn to 0).
var _jir_v = 0;
var _jir_n = 0;
var _jir_cap = 0;
var _jir_lo = 0;
fn _jir_push(s, e): i64 {
    if (_jir_n >= _jir_cap) {
        var nc = _jir_cap * 2 + 64;
        var nb = alloc(nc * 16);
        var i = 0;
        while (i < _jir_n * 2) { store64(nb + i * 8, load64(_jir_v + i * 8)); i = i + 1; }
        _jir_v = nb;
        _jir_cap = nc;
    }
    store64(_jir_v + _jir_n * 16, s);
    store64(_jir_v + _jir_n * 16 + 8, e);
    _jir_n = _jir_n + 1;
    return 0;
}
# 1 when code offset `off` is inside an instance emitted in the fn being parsed.
fn _jir_in(off): i64 {
    var i = _jir_lo;
    while (i < _jir_n) {
        if (off >= load64(_jir_v + i * 16)) { if (off < load64(_jir_v + i * 16 + 8)) { return 1; } }
        i = i + 1;
    }
    return 0;
}
fn _jir_reset(): i64 {
    _jir_n = _jir_lo;
    return 0;
}

# 6.6.7 — the per-fn COMPACTION tables (jump sources, NOP runs, switch tables, the fixup and
# whole-program watermarks). A generic instance re-enters PARSE_FN_DEF, which zeroes all of
# them for itself and leaves ITS values behind: its NOP runs (already harvested from its own
# range) then drove the ENCLOSING fn's compaction over the enclosing fn's bytes — a generic
# call in a fn whose instance the register picker touched SIGSEGV'd. Copy the counts and the
# live entries out before the instance and back after it. (The enclosing fn records no NOP
# run of its own afterwards — `_cur_fn_has_closure` skips its picker and frame-trim — so its
# tables only have to be what they were.) CHANGELOG [6.6.7]
fn _tab_copy(dst, src, n): i64 {
    var i = 0;
    while (i < n) { store64(dst + i * 8, load64(src + i * 8)); i = i + 1; }
    return 0;
}
fn _tab_cap(n, cap): i64 {
    if (n > cap) { return cap; }
    return n;
}
fn _fnst_tab_save(S): i64 {
    var b = alloc(48 + 1024 * 8 + 1024 * 16 + 256 * 16);
    store64(b, L64(S + 0x1A0000));
    store64(b + 8, L64(S + 0x1A2008));
    store64(b + 16, L64(S + 0x1AC800));
    store64(b + 24, L64(S + 0x1A6010));
    store64(b + 32, _wp_fn_js0);
    store64(b + 40, _wp_fn_sw0);
    _tab_copy(b + 48, S + 0x1A0008, _tab_cap(load64(b), 1024));
    _tab_copy(b + 48 + 8192, S + 0x1A2010, _tab_cap(load64(b + 8), 1024) * 2);
    _tab_copy(b + 48 + 8192 + 16384, S + 0x1AC808, _tab_cap(load64(b + 16), 256) * 2);
    return b;
}
fn _fnst_tab_restore(S, b): i64 {
    S64(S + 0x1A0000, load64(b));
    S64(S + 0x1A2008, load64(b + 8));
    S64(S + 0x1AC800, load64(b + 16));
    S64(S + 0x1A6010, load64(b + 24));
    _wp_fn_js0 = load64(b + 32);
    _wp_fn_sw0 = load64(b + 40);
    _tab_copy(S + 0x1A0008, b + 48, _tab_cap(load64(b), 1024));
    _tab_copy(S + 0x1A2010, b + 48 + 8192, _tab_cap(load64(b + 8), 1024) * 2);
    _tab_copy(S + 0x1AC808, b + 48 + 8192 + 16384, _tab_cap(load64(b + 16), 256) * 2);
    return 0;
}

# v6.3.10 (instantiate-once): emit a deduped, monomorphized instance of generic fn
# `base_fi` for concrete-type token `conc0` (and `conc1`). Mints `base$ty`; FINDFN is
# the dedup index (hit → return the existing fi). On a miss, emits the specialized
# body ONCE — closure-style (jump-over): save the enclosing fn's per-fn codegen +
# binding state, reset, bind `T→conc`, `EJMP0` over the instance, record its offset,
# `EFNPRO`/`ESUBRSP`, replay the base body tokens (`GFBS`..) with the binding active so
# the bite-4 consults substitute, patch returns + epilogue + frame, `EPATCH` the jump,
# restore. Returns the specialized fi, or -2 for the not-yet-handled pc>0 case (the
# caller errors). pc=0 only this bite (param re-emission is the follow-on).
fn _instantiate_generic_fn(S, base_fi, conc0, conc1): i64 {
    if (_gu_noinst == 1) { _gu_miss = 1; return 0 - 4; }   # 6.7.16: never at the zone sweep (`_gu_tp`)
    if (_unp_on == 1) { return 0 - 4; }   # 6.7.17: never in a never-parsed body's read (`_unp_run`): no instance is
    # A STRUCT type argument re-emits the body with T bound to the struct sid, so a `T`
    # parameter is a by-value struct parameter and `p.x` resolves (v6.3.39, one parameter).
    # 6.7.1 (C3): on a two-parameter generic too — a struct as either argument, or both
    # (`g<Pt, i64>`, `g(5, p)`, `g(p, q)`). The refusal that stood here (-3) called the
    # combination "unproven"; nothing in the instance path depends on which slot holds the
    # struct, and tests/tcyr/crossos/generic_two_param_struct.tcyr now proves every call path
    # on every backend. CHANGELOG [6.7.1]
    # 6.7.1 (C3): every instance satisfies the generic's bounds — refused (once per pair of types)
    # before anything is minted; -4 = refused and reported.
    if (GFBND(S, base_fi) != 0) { if (_bnd_check_fn(S, base_fi, conc0, conc1) == 1) { return 0 - 4; } }
    var base_noff = L64(_fnt_names + base_fi * 8);
    var mangled = _mint_generic_name(S, base_noff, conc0, conc1);
    var spec = FINDFN(S, mangled);
    if (spec >= 0) { return spec; }                 # dedup hit
    var defstart = GFDS(S, base_fi);
    if (defstart == 0) { return 0 - 2; }            # 0 = no recorded def-start
    defstart = defstart - 1;                        # stored +1 (token index 0 is valid)
    # --- save the ENCLOSING fn's state (the fn currently being emitted) ---
    # 6.6.7 — ALL of it, through the shared snapshot (parse.cyr `_fnst_save`) plus the
    # compaction tables. The hand-kept list here saved rp_vec by LENGTH while the nested
    # PARSE_FN_DEF truncated it to 0 (an early `return` before the first `f<T>()` fell
    # through on x86/PE and hung on aarch64), and it omitted the defer table (an enclosing
    # `defer` registered before the call was DROPPED) and `_fn_local_addr` (re-opening the
    # v6.5.14 dead-stack tail call through a laundered `&local`). CHANGELOG [6.6.7]
    var sv_flc = GFLC(S);
    var sv_ti = GTI(S);
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    var locsnap = _cl_save_locals(S, sv_flc);
    # --- jump over the instance, then re-invoke PARSE_FN_DEF on the BASE's verbatim
    # tokens with the name + concrete-type overrides. PARSE_FN_DEF re-parses the full
    # signature (params/masks/return) + body and emits the specialized fn with T bound
    # to the concretes — full fidelity (params, struct args, masks) for free. ---
    var jmp = EJMP0(S);
    var jt_snap = _jt_snapshot(S);   # v6.3.35: save enclosing fn's jump targets (PARSE_FN_DEF resets them)
    var tab = _fnst_tab_save(S);
    var st = _fnst_save(S);
    STI(S, defstart);
    var sv_ibf = _inst_base_fi;
    _inst_name = mangled;
    _inst_base_fi = base_fi;
    _inst_conc0 = conc0;
    _inst_conc1 = conc1;
    var attrs = _attr_park();         # 6.6.17: a pending attribute is the next definition's
    var sv_msp = _gen_msp;            # 6.7.15: a method call's spelling names its own refusals, not the body's
    _gen_msp = 0;
    var sv_rd = _rd_inst_enter();     # 6.7.16: the instance's levels count from 0 (`_rd_enter`)
    var sv_opp = _opp_park(S);        # 6.7.16: the body parsed with no operand's end read as `)` (`_op_gen_head`)
    var sv_pn = _panic;               # 6.7.16: the enclosing statement's panic latch (`_inst_relatch`)
    PARSE_FN_DEF(S);
    _inst_relatch(sv_pn);
    _opp_unpark(S, sv_opp);
    _rd_inst_exit(sv_rd);
    _gen_msp = sv_msp;
    _attr_unpark(attrs);
    _inst_name = 0;
    _inst_base_fi = sv_ibf;   # 6.7.16: an enclosing instance's base again (`_mret_fn`), -1 outside one
    _inst_conc0 = 0;
    _inst_conc1 = 0;
    # --- restore the enclosing fn's state ---
    _fnst_restore(S, st);
    _fnst_tab_restore(S, tab);
    _jt_merge(S, jt_snap, jmp);      # v6.3.35: restore enclosing targets; 6.7.16: the instance's range, not its targets
    EPATCH(S, jmp);
    # The instance is emitted INLINE in the enclosing fn's code range (jumped over),
    # so mark the enclosing fn to skip its regalloc byte-scan post-pass (it would
    # rewrite + corrupt the instance) — same guard closures use.
    _cur_fn_has_closure = 1;
    _cl_restore_locals(S, locsnap, sv_flc);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    STI(S, sv_ti);
    spec = FINDFN(S, mangled);                       # now registered by PARSE_FN_DEF
    if (spec >= 0) { _unp_iv = _unp_mark(_unp_iv, base_fi); }   # 6.7.17: its base's body parsed (`_unp_run`)
    _gen_inst_record(S, spec, base_fi, conc0, conc1);   # 6.6.17 (a3, a5)
    _gen_inherit_dep(S, spec, base_fi);              # 6.6.16: `#deprecated` reaches instances
    return spec;
}

# The instance above is emitted by PARSE_FN_DEF itself, which consumed whatever `#must_use` /
# `#deprecated` / `#pure` / ... was armed: an attribute written before a top-level statement that
# instantiates `g<i32>` marked `g$i32` (deprecated — every call to it warned) and was gone by the
# `fn` it preceded (`#must_use` silent there). Parked around the instance and put back. The
# instance still inherits the BASE's own `#deprecated` (`_gen_inherit_dep`).
fn _attr_park(): i64 {
    var b = alloc(80);
    store64(b, _regalloc_pending);       _regalloc_pending = 0;
    store64(b + 8, _must_use_pending);   _must_use_pending = 0;
    store64(b + 16, _deprecated_pending); _deprecated_pending = 0;
    store64(b + 24, _deprecated_msg_pending); _deprecated_msg_pending = 0;
    store64(b + 32, _pure_pending);      _pure_pending = 0;
    store64(b + 40, _io_pending);        _io_pending = 0;
    store64(b + 48, _alloc_pending);     _alloc_pending = 0;
    store64(b + 56, _naked_pending);     _naked_pending = 0;
    store64(b + 64, _inline_pending);    _inline_pending = 0;
    store64(b + 72, _pub_pending);       _pub_pending = 0;
    return b;
}
fn _attr_unpark(b): i64 {
    _regalloc_pending = load64(b);
    _must_use_pending = load64(b + 8);
    _deprecated_pending = load64(b + 16);
    _deprecated_msg_pending = load64(b + 24);
    _pure_pending = load64(b + 32);
    _io_pending = load64(b + 40);
    _alloc_pending = load64(b + 48);
    _naked_pending = load64(b + 56);
    _inline_pending = load64(b + 64);
    _pub_pending = load64(b + 72);
    return 0;
}

# v6.3.10 (generic structs): instantiate `Box<conc>` → a deduped specialized struct.
# Mints `Box$ty`; FINDSTRUCT is the dedup index. On a miss, re-invokes PARSE_STRUCT_DEF
# on the base struct's verbatim tokens with the name + binding overrides so each `: T`
# field resolves to the concrete type via the field consult. No codegen (struct
# registration only) → far simpler than the fn instance: just save/restore the cursor
# + binding. Returns the 1-based instance sid, or 0 if `base_si` isn't a generic struct.
fn _instantiate_generic_struct(S, base_si, conc0, conc1): i64 {
    var base_noff = L64(S + 0x1A6018 + base_si * 8);
    var mangled = _mint_generic_name(S, base_noff, conc0, conc1);
    var existing = FINDSTRUCT(S, mangled);
    if (existing > 0) { return existing; }           # dedup hit (1-based)
    # 6.7.1 (C3): every instance satisfies the struct's bounds — 0 (the caller keeps the base).
    if (GSBND(S, base_si) != 0) { if (_bnd_check_struct(S, base_si, conc0, conc1) == 1) { return 0; } }
    var ds = GSDS(S, base_si);
    if (ds == 0) { return 0; }                       # not a generic struct
    ds = ds - 1;
    var stp = GSTP(S, base_si);
    var sv_ti = GTI(S);
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    STI(S, ds);
    _inst_name = mangled;
    var t0 = stp & 0xFFFFFFFF;
    if (t0 != 0) { _tp_bind(S, 0, t0 - 1, conc0); }
    var t1 = (stp >> 32) & 0xFFFFFFFF;
    # v6.3.33: bind the SECOND type param to conc1 (was conc0 → collapsed distinct
    # params). Single-param structs have t1 == 0 → no bind → conc1 unused.
    if (t1 != 0) { _tp_bind(S, 1, t1 - 1, conc1); }
    # 6.7.15: the re-parse's own type-argument reads reset the close the caller's list may owe (`P<P<R>>`'s `>>`,
    # minted here) — put back, or the enclosing list read the next `,` as its own. CHANGELOG [6.7.15]
    var sv_gt = _ta_pending_gt;
    PARSE_STRUCT_DEF(S);
    _ta_pending_gt = sv_gt;
    _inst_name = 0;
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    STI(S, sv_ti);
    var r = FINDSTRUCT(S, mangled);                  # 1-based instance sid
    _sinst_note(S, r, base_si + 1, conc0, conc1);    # 6.7.8: what inference reads back (_sinst_conc)
    return r;
}

# v6.3.33: consume one type-arg-list `>` close. A `>` (token 20) closes one level. A
# `>>` (token 39, the right-shift lexeme) closes THIS level AND owes one `>` to the
# enclosing level (`_ta_pending_gt`), so `Box<Pair<i32>>`'s trailing `>>` closes both
# Pair's and Box's `<`. If a close is already owed, decrement it and consume nothing.
fn _consume_gt(S): i64 {
    if (_ta_pending_gt > 0) { _ta_pending_gt = _ta_pending_gt - 1; return 0; }
    var t = PEEKT(S);
    if (t == 20) { STI(S, GTI(S) + 1); return 0; }
    if (t == 152) { STI(S, GTI(S) + 1); _ta_pending_gt = 2; return 0; }   # `>>>` owes two
    if (t == 39) { STI(S, GTI(S) + 1); _ta_pending_gt = 1; return 0; }   # `>>`
    return 0;
}
# ⛔ 6.7.15 — A `,` AFTER A TYPE ARGUMENT: the next argument of THIS list only while no close is owed. A nested argument
# closed by `>>` / `>>>` closed this list too (`_ta_pending_gt`), so the `,` is the enclosing list's: `g2<P<P<R>>, i16>`
# read `i16` as P's second argument and bound g2's B to i64, and `fn f(a: Box<Box<Pt>>, b: i64)` read `b` as a type.
# Consumes the `,` and returns 1 when it starts this list's next argument, else 0. CHANGELOG [6.7.15]
fn _ta_comma(S): i64 {
    if (_ta_pending_gt != 0) { return 0; }
    if (PEEKT(S) != 31) { return 0; }
    STI(S, GTI(S) + 1);
    return 1;
}
# ⛔ 6.7.16 (D5) — A TYPE-ARGUMENT LIST LONGER THAN ITS GENERIC DECLARES: `var b: Box<i64, i64>;` with `struct Box<T>`,
# and `g<i32, Pt>(5)` on `fn g<T>`, compiled — every reader took two arguments whatever the generic declared (a
# one-parameter generic's second into c1), and dropped the rest. Each list reader now reads the arguments its generic
# declares (`np`) through these: an argument past them — a `,` that starts another argument of THIS list, no close
# owed — is refused once, at that argument, "'Box' takes 1 type argument, 2 given" (the user's D5, 2026-10-19), and
# the rest of the list is stepped unread (`_targ_skip_arg`, the close it owes kept), so the list reads as if the
# extra arguments were deleted and nothing cascades. Quiet in a lookahead or typer (`_ta_xq`): the reader that parses
# the list reports it. CHANGELOG [6.7.16]
# After the first argument: the second when the generic declares one (else 0), then the extra check. `gk` / `gi`
# name the generic for the refusal: 1 a struct (gi its name), 2 a fn (gi its index), 0 quiet.
fn _ta_rest(S, np, gk, gi): i64 {
    var c1 = 0;
    if (np > 1) { if (_ta_comma(S) == 1) { c1 = _parse_one_type_arg(S); } }
    if (_ta_xq == 1) { gk = 0; }
    _ta_extra(S, np, gk, gi);
    return c1;
}
fn _ta_extra(S, np, gk, gi): i64 {
    if (_ta_comma(S) == 0) { return 0; }
    if (_targ_gt_n(PEEKT(S)) > 0) { _parse_one_type_arg(S); return 0; }   # `Box<i64,>`: an empty argument, as before
    var at = GTI(S);
    var n = np + 1;
    _targ_skip_arg(S);
    while (_ta_comma(S) == 1) {
        n = n + 1;
        _targ_skip_arg(S);
    }
    if (gk != 0) { _ta_xrefuse(S, at, np, n, gk, gi); }
    return 0;
}
fn _ta_xrefuse(S, at, np, n, gk, gi): i64 {
    if (_syntax_only == 1) { return 0; }   # as D6's `_ngt_refuse`
    if (_panic == 1) { return 0; }
    if (np == 2) { if (_ta_x3(S, gk, gi) == 1) { return 0; } }   # 6.7.16 (D8): refused at its declaration
    if (_tn_once(S, at) == 0) { return 0; }
    var nm = gi;
    if (gk == 2) { nm = _fn_src_name(S, gi, L64(_fnt_names + gi * 8)); }   # `g`, a method's `P.m`
    var sv = GTI(S);
    STI(S, at);
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": '");
    PRSTR(S + 0xEC00000 + nm);
    PRSTR("' takes ");
    PRNUM(np);
    PRSTR(" type argument");
    if (np != 1) { PRSTR("s"); }
    PRSTR(", ");
    PRNUM(n);
    PRSTR(" given\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    return 0;
}
# 1 when the generic a count refusal would name declares a third type parameter — refused at its declaration
# (`_ctp_third`), so its uses say nothing more (the user's D8). `gk` / `gi` as `_ta_rest`'s. CHANGELOG [6.7.16]
fn _ta_x3(S, gk, gi): i64 {
    var lt = 0 - 1;
    if (gk == 2) { if (GFDS(S, gi) > 0) { lt = GFDS(S, gi) + 1; } }
    else {
        var sid = FINDSTRUCT(S, gi);
        if (sid > 0) { if (GSDS(S, sid - 1) > 0) { lt = GSDS(S, sid - 1) + 1; } }
        else { lt = _tp_later_lt(S, gi); }
    }
    if (lt <= 0) { return 0; }
    if (TOKTYP(S, lt) != 19) { return 0; }
    if (_tp_count_at(S, lt) > 2) { return 1; }
    return 0;
}
# The type parameters generic packed names `tp` records (`GSTP` / `GFTP`): 1, or 2 when its second slot is set.
fn _tp_np(tp): i64 {
    if (((tp >> 32) & 0xFFFFFFFF) != 0) { return 2; }
    return 1;
}
# 1 when name token `k` is a generic struct whose `<..>` lists more arguments than it declares — the shape
# `_ta_extra` refuses, read off the tokens (the cursor untouched, nothing parsed): the impl check and the pair check
# know such a type as its reader's refusal (`_ty_rd_name`). Not a struct declaring a third parameter (D8: refused at
# its declaration, its uses quiet). CHANGELOG [6.7.16]
fn _ta_over(S, k): i64 {
    if (_MONOMORPH_OK != 1) { return 0; }
    if (TOKTYP(S, k + 1) != 19) { return 0; }
    var sid = FINDSTRUCT(S, TOKVAL(S, k));
    if (sid <= 0) { return 0; }
    var tp = GSTP(S, sid - 1);
    if (tp == 0) { return 0; }
    var np = _tp_np(tp);
    if (_ta_list_n(S, k + 1) <= np) { return 0; }
    if (np == 2) { if (_ta_x3(S, 1, TOKVAL(S, k)) == 1) { return 0; } }
    return 1;
}
# The arguments of the `<..>` whose `<` is token `lt`: one, and one more per `,` of the list's own depth (outside a
# `*fn( .. )`'s parentheses) that a type follows — a `,` before the close is the empty argument `_ta_extra` lets pass.
fn _ta_list_n(S, lt): i64 {
    var i = lt + 1;
    var d = 1;
    var p = 0;
    var n = 1;
    var e = GTCNT(S);
    while (i < e) {
        var t = TOKTYP(S, i);
        if (t == 13 || t == 14 || t == 5) { return n; }   # `{` `}` `;`: an unclosed list
        if (t == 19) { d = d + 1; }
        if (t == 10) { p = p + 1; }
        if (t == 11) { p = p - 1; }
        d = d - _targ_gt_n(t);
        if (d <= 0) { return n; }
        if (t == 31) { if (d == 1) { if (p == 0) { if (_targ_gt_n(TOKTYP(S, i + 1)) == 0) { n = n + 1; } } } }
        i = i + 1;
    }
    return n;
}
# `_ta_rest` for generic struct `sid` (1-based) / generic fn `fi` (a fn that is no generic, or none: two, as before).
fn _ta_rest_s(S, sid): i64 {
    return _ta_rest(S, _tp_np(GSTP(S, sid - 1)), 1, L64(S + 0x1A6018 + (sid - 1) * 8));
}
fn _ta_rest_f(S, fi): i64 {
    var tp = 0;
    if (fi >= 0) { tp = GFTP(S, fi); }
    if (tp == 0) { return _ta_rest(S, 2, 0, 0); }
    return _ta_rest(S, _tp_np(tp), 2, fi);
}
# ... for the fn named `noff` as the call spells it.
fn _ta_rest_n(S, noff): i64 { return _ta_rest_f(S, FINDFN(S, noff)); }
# ... for the generic struct named `noff`, declared further down (`_ta_late`): what its declaration lists.
fn _ta_rest_l(S, noff): i64 {
    var lt = _tp_later_lt(S, noff);
    if (lt < 0) { return _ta_rest(S, 2, 0, 0); }
    var np = _tp_count_at(S, lt);
    if (np > 2) { np = 2; }
    if (np < 1) { np = 1; }
    return _ta_rest(S, np, 1, noff);
}
# The `<` of the generic struct or union `noff` declared further down (`_declared_later_gen`'s), or -1.
fn _tp_later_lt(S, noff): i64 {
    var k = GTI(S);
    var n = GTCNT(S);
    while (k + 2 < n) {
        var t = TOKTYP(S, k);
        if (t == 40 || t == 101) {
            if (TOKTYP(S, k + 1) == 2) { if (TOKTYP(S, k + 2) == 19) {
                    if (STREQ(S, TOKVAL(S, k + 1), noff) == 1) { return k + 2; }
                } }
        }
        k = k + 1;
    }
    return 0 - 1;
}
# The type parameters a declaration's `<..>` (its `<` at token `lt`) lists, counted as `_capture_tparams` counts
# them: each name at the list's own depth that does not follow a bound's `:` or `+`.
fn _tp_count_at(S, lt): i64 {
    var n = 0;
    while (_tp_nth_at(S, lt, n) >= 0) { n = n + 1; }
    return n;
}
# 1 when the name at token `i` is a bound's trait (it follows `:` or `+`).
fn _tp_after_bound(S, i): i64 {
    var p = TOKTYP(S, i - 1);
    if (p == 49 || p == 6) { return 1; }
    return 0;
}

# v6.3.33 (generics tail — NESTED + multi-arg): consume ONE type argument at the
# cursor and return its concrete encoding (per _classify_return_type: >0 struct sid,
# -1/-2/-4/-8 scalars, -16..-21 special). A NESTED generic type-arg (`Name<...>` where
# Name is a generic struct) is RECURSIVELY parsed + instantiated → its INSTANCE sid is
# returned, so `Box<Pair<i32>>` binds Box's T to the `Pair$i32` instance (not the base
# Pair, whose i64 layout differs). Consumes the name + any nested `<...>`; leaves the
# cursor on the `,` or `>` that terminates this arg. A nested 2-param `M<A, B>` recurses
# on both. Gated by the callers (`_MONOMORPH_OK`); no default-path effect.
# v6.3.33: special/aggregate types (Result/Option/Tagged/cstring/f64v2/f64v4,
# encoded <= -16 by _classify_return_type) are NOT supported as generic type-args.
# Their monomorphized ABI is not soundly emitted (proven: a generic fn instantiated
# with f64v2/f64v4 slipped the struct guard AND miscompiled), and _append_conc_name
# only spells the plain scalars {-8,-4,-2,-1} and f64 (-9) — every special collapses to
# `Base$i`, ALIASING distinct instances in the FINDFN/FINDSTRUCT dedup. Hard-error at
# the single leaf-classify choke point (covers fn + struct + nested) instead of
# silently miscompiling. Scalars and struct type-args are unaffected.
fn _reject_special_type_arg(S, c): i64 {
    if (c <= 0 - 16) {
        _ta_refd = 1;   # 6.7.14
        if (_ta_chk_ok(S) == 0) { return 0; }
        var sv = GTI(S);
        STI(S, sv - 1);   # 6.7.16: at the name (`_targ_at_name`'s note)
        ERR_MSG(S, "generic type-args must be a scalar (i8/i16/i32/i64) or a struct; Result/Option/Tagged/cstring/f64v2/f64v4 are unsupported", 121);
        STI(S, sv);
    }
    return 0;
}

# ⛔ 6.6.8 — A TYPE-ARG NAMING THE ENCLOSING GENERIC'S OWN TYPE PARAMETER. `inner<T>(p)` inside
# `fn outer<T>` classified `T` as a TYPE NAME, found none, and got 0 — "unbound" — so the
# instance was minted with `_inst_conc0 == 0`, which PARSE_FN_DEF reads as the BASE emission:
# a field-accessing body became the `rax = 0` dead stub and `outer<Pt>(p)` returned 2 where 16
# was right, with no diagnostic. A bound type parameter resolves to its binding (T -> Pt in the
# `outer<Pt>` instance, T -> i64 in outer's own base); a name that is neither a bound parameter
# nor a type is an error — 0 is never a type. CHANGELOG [6.6.8]
fn _type_arg_leaf(S, noff): i64 {
    var _c0 = 0;
    if (_tp_c0 != 0) { _c0 = _tp_resolve(S, noff); }
    if (_c0 == 0) { _c0 = _classify_return_type(S, noff); }
    if (_c0 == 0) {
        if (_ta_chk == 1) { if (_targ_is_tp(S, noff) == 1) { _tck_nj = 1; return 0 - 8; } }   # 6.7.14: read unbound
        if (_ta_late == 1) { if (_declared_later(S, noff, 40, 101) == 1) {   # 6.7.15 (D8)
                _tck_nj = 1;
                return 0 - 8;
            } }
        _ta_refd = 1;
        if (_ta_chk_ok(S) == 1) { _targ_at_name(S, noff); }
        return 0 - 8;
    }
    # 6.7.15: a dyn, refused by the dyn pre-pass (`_dyn_targ`), is read as i64 — no `Box$dyn Show` minted to
    # cascade into a second error, and an explicit call mints no instance. CHANGELOG [6.7.15]
    if (_dyn_is(S, _c0) == 1) { _ta_refd = 1; return 0 - 8; }
    _reject_special_type_arg(S, _c0);
    return _c0;
}
# The refusal names the vocabulary: exactly the names a return type accepts (`_classify_return_type`)
# plus a bound type parameter. `u8`..`u64`, `bool`, `ptr`, `f32` and an enum name are NOT in it —
# a type argument picks a WIDTH and a layout, so an alias that silently chose one is the bug this
# replaced. An enum gets its own line: its values are i64, and "unknown type" reads as a typo.
fn _refuse_type_arg_name(S, noff): i64 {
    _ta_refd = 1;   # 6.7.14
    if (_dyn_bare_nm != 0) { if (noff == _dyn_bare_nm - 1) { return 0; } }   # 6.7.8: T3 named it
    if (_is_enum_name(S, noff) == 1) {
        ERR_IDENT(S, "", noff, " is an enum, not a type argument — enum values are i64; write i64", 0 - 1);
        return 0;
    }
    ERR_IDENT(S, "unknown type ", noff, " as a type argument (a type argument is a struct, i8/i16/i32/i64, f64, or a type parameter in scope)", 0 - 1);
    return 0;
}
fn _is_enum_name(S, noff): i64 {
    if (_enum_id_of(S, noff) > 0) { return 1; }
    if (_ta_late == 1) { if (_declared_later(S, noff, 60, 60) == 1) { return 1; } }   # 6.7.15 (D8): an enum below
    return 0;
}

# The 1-based id of the enum named `noff` (the GVENUMID of its variants), or 0. CHANGELOG [6.6.11]
fn _enum_id_of(S, noff): i64 {
    var n = GENUMC(S);
    var i = 0;
    while (i < n) {
        if (STREQ(S, GENUMNM(S, i), noff) == 1) { return i + 1; }
        i = i + 1;
    }
    return 0;
}

fn _parse_one_type_arg(S): i64 {
    if (PEEKT(S) == 10) { _tup_pos_refuse(S, "a type argument"); _ta_refd = 1; return 0 - 8; }   # 6.7.7 (R3)
    if (PEEKT(S) == 28) {   # 6.7.8 (C2-6a): `g<[u8]>` was "unknown type 'enum' as a type argument"
        _sl_err(S, GTI(S), "a slice cannot be a type argument (6.7.8: slices are fn-locals)", "");
        _ta_refd = 1;
        _sl_ann_skip(S);
        return 0 - 8;
    }
    if (PEEKT(S) != 2) { return _targ_not_name(S); }   # 6.7.14: `Box<1 + 2>`, `Box<u128>`
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);                              # consume the type-arg name
    if (PEEKT(S) != 19) {                            # no `<` → plain scalar / struct
        var _c0 = _type_arg_leaf(S, noff);
        return _c0;
    }
    var base_sid = FINDSTRUCT(S, noff);
    if (_ta_late == 1) { if (base_sid <= 0) { if (_declared_later(S, noff, 40, 101) == 1) {
                return _targ_later(S, noff);
            } } }
    if (base_sid <= 0 || GSTP(S, base_sid - 1) == 0) {
        var _c1 = _classify_return_type(S, noff);    # `<` but not a generic struct
        if (_dyn_is(S, _c1) == 1) { _ta_refd = 1; _c1 = 0 - 8; }   # 6.7.15: `dyn Show<..>`, as `_type_arg_leaf`
        _reject_special_type_arg(S, _c1);
        if (_c1 == 0) {   # 6.7.14
            if (_vec_ann_at(S, GTI(S) - 1) == 0) { return _targ_bad_gen(S, noff); }
            _targ_vec(S, GTI(S) - 1);
        }
        # 6.7.15 (D6): `Pt<..>`, `i64<..>` (its type is read). Not a Result / Option / Tagged / cstring, refused above as
        # a type argument at all: its list is not read too (6.7.16's D88).
        if (_c1 > 0 - 16) { if (_ngt_refuse(S, GTI(S) - 1) == 1) { _ta_refd = 1; } }
        # 6.6.17: and its own `<..>` (`Box<Vec<i64>>`), which was left for the enclosing list.
        _ta_pending_gt = _ta_pending_gt + _skip_targ_list(S);
        return _c1;
    }
    STI(S, GTI(S) + 1);                              # consume the nested `<`
    var lit = _targs_literal(S, GTI(S));             # 6.7.15: `Box<i64>` written out (see `_targ_inst`)
    var lv = _tck_open(S);                           # 6.7.15 (D10): under `_ta_chk`, this list's own judgement
    var in0 = _parse_one_type_arg(S);                # recurse into the inner arg(s)
    var x0 = _tck_take();                            # 6.7.16 (D10): the instance it names, if any
    var in1 = _ta_rest_s(S, base_sid);               # `,` — 6.7.16 (D5): as many as it declares
    _consume_gt(S);                                  # consume the nested `>` (or `>>`)
    if (_ta_chk == 1) {   # 6.7.14 (D5): read, not minted
        _tck_xset(x0);
        return _tck_nest(S, base_sid, in0, in1, lit, lv);
    }
    return _targ_inst(S, base_sid, in0, in1, lit);
}
# 6.7.15 (D8) — `Later<..>` in a pointer field's list read at its declaration (`_ta_late`; cursor on the `<`), Later a
# struct declared further down: a generic one's own arguments are read and checked as any list's; any other one's list
# is skipped, left to the use, which reads it under the struct (D6's `Pt<..>`). Read as i64; nothing is sized.
fn _targ_later(S, noff): i64 {
    _tck_nj = 1;   # 6.7.15 (D10): a struct declared further down is no instance to judge here
    if (_declared_later_gen(S, noff) == 0) {
        _ta_pending_gt = _ta_pending_gt + _skip_targ_list(S);
        return 0 - 8;
    }
    STI(S, GTI(S) + 1);
    _parse_one_type_arg(S);
    _ta_rest_l(S, noff);   # 6.7.16 (D5)
    _consume_gt(S);
    _tck_last = 0;
    return 0 - 8;
}
# ⛔ 6.7.15 — A NESTED `Box<i64>` IS THE BASE `Box`, as the annotation `var b: Box<i64>` declares it (the 6.6.10 rule of
# `_gen_ann_sid` / `_ret_targ_parse`): an all-i64 (or unbound) list is the base struct, anything else the deduped
# `Box$..` instance. The type argument minted `Box$i64` unconditionally, so `gx<Box<i64>>(bx)` with `bx: Box<i64>` (the
# base) was refused "cannot pass 'bx' to a parameter of a different struct type", where `gx(bx)` ran. `lit`: the list
# was written out, so the base answers for its bound (`_bnd_sbase`). CHANGELOG [6.7.15]
fn _targ_inst(S, base_sid, in0, in1, lit): i64 {
    var inst = 0;
    if (in0 != 0 - 8) { if (in0 != 0) { inst = 1; } }
    if (in1 != 0) { if (in1 != 0 - 8) { inst = 1; } }
    if (inst == 0) {
        if (lit == 1) { _bnd_sbase(S, base_sid); }
        return base_sid;
    }
    return _instantiate_generic_struct(S, base_sid - 1, in0, in1);
}

# ⛔ 6.7.14 (D2 / D3) — `Name<..>` AS A TYPE ARGUMENT, NAME NO TYPE (cursor on its `<`). It was skipped and read as
# class 0, "unbound" — the i64 BASE: `g<Nonexist<u8>>(0)` ran the base (sizeof(T) 8) and `var c: Box<Nonexist<u8>>;`
# declared the base `Box`, while `g<Nonexist>(0)` was refused by name; the built-in slice's word form `g<slice<u8>>`
# ran the base where `g<[u8]>` was refused; and `h<T<u8>>` inside a generic reached h's base, not the instance T is
# bound to. Each is refused once, at the name (the user's D2 (a) and D3 (a), 2026-10-16): the built-in slice as `[u8]`
# is, a type parameter as one, anything else as the plain unknown name. The list is skipped and the argument read as
# i64, so nothing cascades. `Vec<..>` and a generic struct do not come here. CHANGELOG [6.7.14]
fn _targ_bad_gen(S, noff): i64 {
    var nti = GTI(S) - 1;
    _ta_refd = 1;
    if (_sl_ann_at(S, nti) == 1) {
        _sl_err(S, nti, "a slice cannot be a type argument (6.7.8: slices are fn-locals)", "");
    } elif (_targ_is_tp(S, noff) == 1) {
        _dyn_err(S, nti, "a type parameter takes no type arguments: ", 0, noff, 0);
    } elif (_tn_once(S, nti) == 1) {
        STI(S, nti);
        _refuse_type_arg_name(S, noff);
        STI(S, nti + 1);
    }
    _ta_pending_gt = _ta_pending_gt + _skip_targ_list(S);
    return 0 - 8;
}
# ⛔ 6.7.14 (D4) — `Vec<..>` AS A TYPE ARGUMENT (`Box<Vec<nosuch>>`, `idv<Vec<1 + 2>>(c)`; cursor on its `<`, `vti` the
# word): its element was skipped unread (`_skip_targ_list`). Read and checked as a `var v: Vec<T>` annotation's is
# (6.7.11's D9), the cursor put back; a refusal is a refused type argument (`_ta_refd`). CHANGELOG [6.7.14]
fn _targ_vec(S, vti): i64 {
    var sv = GTI(S);
    STI(S, vti + 1);
    if (_vec_ann_list(S, 0 - 1) < 0) { _ta_refd = 1; }
    STI(S, sv);
    return 0;
}
# ⛔ 6.7.14 (D5) — A TYPE-ARGUMENT LIST READ, NOT INSTANTIATED, from its `<` at token `lt`: a Vec element's own list
# (`var w: Vec<Box<nosuch>>`, a field `more: Vec<Box<(i64, i64)>>`) was skipped unread. Each argument is read as
# `_parse_one_type_arg` reads one — every refusal of a type argument, once per token — but no generic struct is
# instantiated (`_ta_chk`: a struct definition's fields must stay contiguous in the field pool), and the cursor, the
# owed closers and a panic latch the check set are put back, so the caller consumes the list as it did. CHANGELOG [6.7.14]
fn _targ_chk(S, lt): i64 {
    var sv = GTI(S);
    var sv_gt = _ta_pending_gt;
    var sv_pn = _panic;
    var sv_ck = _ta_chk;
    _ta_chk = 1;
    _ta_pending_gt = 0;
    STI(S, lt + 1);
    _tck_last = 0;
    var c0 = _parse_one_type_arg(S);
    var x0 = _tck_take();
    var c1 = _tck_rest(S, lt - 1);   # 6.7.16 (D5)
    _tck_xset(x0);   # 6.7.16 (D10): an argument that is an instance, as `_tck_nest`'s
    _tck_c0 = c0;   # 6.7.15 (D10): what was read, for a Vec element's bound (`_vec_el_targs`)
    _tck_c1 = c1;
    _ta_chk = sv_ck;
    _ta_pending_gt = sv_gt;
    if (sv_pn == 0) { _panic = 0; }
    STI(S, sv);
    return 0;
}
# `_ta_rest` for the generic struct named at token `nti` — declared above, or further down (a late `*G<..>` field).
fn _tck_rest(S, nti): i64 {
    var sid = FINDSTRUCT(S, TOKVAL(S, nti));
    if (sid > 0) { return _ta_rest_s(S, sid); }
    return _ta_rest_l(S, TOKVAL(S, nti));
}
# ⛔ 6.7.15 (D10) — A VEC ELEMENT'S GENERIC STRUCT IS HELD TO ITS BOUNDS: `var w: Vec<Box<Pt>> = 0;` with
# `struct Box<T: Show>` and no `impl Show for Pt` compiled, where `var b: Box<Pt>;` is refused — the element's list is
# read without minting (`_targ_chk`, 6.7.14's D5), and a bound is judged where an instance is minted. While a Vec
# element's list is read (`_ta_vbnd`), the element and each generic struct nested in it is judged as `_targ_inst` would
# judge it, nothing minted: its arguments against its bounds (`_bnd_check_struct`), an all-i64 list written out by its
# base's (`_bnd_sbase`) — reported at the struct's name, once per (struct, arguments) as every bound refusal (the
# user's D10 (a), 2026-10-18). Not judged: a list with a refused argument (its refusal stands alone), one naming a
# type parameter not bound here (each instance judges its binding) or a struct declared further down, and one whose
# argument is a list refused here (as by value, where the refused instance leaves the base). Off outside a Vec
# element, so a signature's or a pointer field's `_targ_chk` judges no bound. CHANGELOG [6.7.15]
# ⛔ 6.7.16 (D10) — AN ARGUMENT THAT IS ITSELF AN INSTANCE (`Vec<Box<Box<R>>>`, `Box<T: Show>`) was not judged: only
# minting names it, so the outer list was marked unjudgeable and the line compiled, where `var b: Box<Box<R>>;` is
# refused — no `impl Show for Box<R>` can be written, so no source satisfies an outer bound on an instance. It is now
# judged as the by-value form judges it (the user's D10, 2026-10-19), nothing minted: the inner list, judged in its
# turn, stands in its enclosing list's slot as a PENDING instance (`_pn_of`, a sentinel type code), which no impl
# names, so a bounded slot holding it fails with the by-value line and note, the note spelling it as
# `_mint_generic_name` would (`impl Show for Box$R`, `_pn_pr`); an unbounded slot stays silent. CHANGELOG [6.7.16]
var _ta_vbnd = 0;   # 1 while a Vec element's list is read (`_vec_el_targs`)
var _tck_c0 = 0;    # the arguments the last `_targ_chk` read
var _tck_c1 = 0;
var _tck_nj = 0;    # 1 when the list being read cannot be judged (above)
var _tck_last = 0;  # 6.7.16 (D10): the pending instance the nested list just read is (`_tck_nest`), else 0
var _tck_x0 = 0;    # ... and those the list being judged holds in its slots 0 / 1 (`_tck_xset`)
var _tck_x1 = 0;
var _pn_tab = 0;    # the pending instances, interned: (sid, c0, c1) — 24 B each, grown (`_tab_grow`)
var _pn_n = 0;
var _pn_cap = 0;
# Under `_ta_chk`, cursor just past a nested `<`: the enclosing list's state, packed (its name token * 4, its refusal
# flag * 2, its no-judge flag), both flags cleared for this list. 0 and nothing touched outside `_ta_chk`.
fn _tck_open(S): i64 {
    if (_ta_chk == 0) { return 0; }
    var lv = (GTI(S) - 2) * 4 + _ta_refd * 2 + _tck_nj;
    _ta_refd = 0;
    _tck_nj = 0;
    _tck_last = 0;
    return lv;
}
# The pending instance the argument just read is (0 = none), taken: each argument reads its own.
fn _tck_take(): i64 {
    var v = _tck_last;
    _tck_last = 0;
    return v;
}
# The list's slot-0 pending instance `x0` (taken before its second argument was read) and its slot-1 one, for the
# judgement that follows.
fn _tck_xset(x0): i64 {
    _tck_x1 = _tck_take();
    _tck_x0 = x0;
    return 0;
}
# The nested generic struct `sid` read under `_ta_chk` (`lv` from `_tck_open`): judged inside a Vec element, the
# enclosing list's flags put back (with this list's), and read as its base — an instance its enclosing list cannot
# judge.
fn _tck_nest(S, sid, in0, in1, lit, lv): i64 {
    var nj = _tck_nj | _ta_refd;
    _ta_refd = ((lv / 2) & 1) | _ta_refd;
    _tck_nj = (lv & 1) | nj;
    var bad = 0;
    if (_ta_vbnd == 1) { if (nj == 0) { bad = _vbnd_judge(S, sid, in0, in1, lit, lv / 4); } }
    _tck_last = 0;
    if (_targ_is_inst(in0, in1) == 1) {
        if (_ta_vbnd == 0 || nj == 1 || bad == 1) { _tck_nj = 1; }   # 6.7.16 (D10): else a pending instance
        else { _tck_last = _pn_of(sid, _tck_xc(in0, _tck_x0), _tck_xc(in1, _tck_x1)); }
    }
    return sid;
}
# An argument's type code for its list's judgement: the pending instance it is (`x`), else what was read (`c`).
fn _tck_xc(c, x): i64 {
    if (x != 0) { return x; }
    return c;
}
# The pending instance (`sid` its generic struct, 1-based; `c0` / `c1` its arguments, each a type code or another
# pending instance): its sentinel type code, 0 - 1000000 - its entry (interned, so one shape is one code — a bound's
# refusal is reported once per (struct, arguments), `_bnd_memo_seen`). Never a struct: nothing is minted.
fn _pn_of(sid, c0, c1): i64 {
    var i = 0;
    while (i < _pn_n) {
        var e = _pn_tab + i * 24;
        if (load64(e) == sid) { if (load64(e + 8) == c0) { if (load64(e + 16) == c1) { return 0 - 1000000 - i; } } }
        i = i + 1;
    }
    if (_pn_tab == 0) { _pn_tab = alloc(16 * 24); _pn_cap = 16; }
    if (_pn_n >= _pn_cap) { _pn_tab = _tab_grow(_pn_tab, _pn_cap * 3); _pn_cap = _pn_cap * 2; }
    var e2 = _pn_tab + _pn_n * 24;
    store64(e2, sid);
    store64(e2 + 8, c0);
    store64(e2 + 16, c1);
    _pn_n = _pn_n + 1;
    return 0 - 999999 - _pn_n;
}
# Type code `c` as a bound refusal's memo keys it: a minted instance as the pending instance of its base and
# arguments (`_sinst`), so `var b: Box<Box<R>>;` and `Vec<Box<Box<R>>>` are one (struct, arguments) — reported once.
fn _pn_canon(c): i64 {
    var b = _sinst_base(c);
    if (b == 0) { return c; }
    var e = _sinst + (c - 1) * 24;
    return _pn_of(b, _pn_canon(L64(e + 8)), _pn_canon(L64(e + 16)));
}
# 1 when type code `c` is a pending instance's sentinel.
fn _pn_is(c): i64 {
    if (c <= 0 - 1000000) { return 1; }
    return 0;
}
# Print pending instance `c` as the source spells it (`Box<R>`, `Pair<i64, Box<R>>`): its would-be table name
# (`Box$R`) was printed until 6.7.17 (`_sn_pr`). CHANGELOG [6.7.17]
fn _pn_pr(S, c): i64 {
    var e = _pn_tab + (0 - 1000000 - c) * 24;
    var c1 = load64(e + 16);
    _sn_pr(S, load64(e));
    PRSTR("<");
    _pn_pr_arg(S, load64(e + 8));
    if (c1 != 0) {
        PRSTR(", ");
        _pn_pr_arg(S, c1);
    }
    PRSTR(">");
    return 0;
}
# One argument of it: a pending instance in full, anything else as `_sn_pr` spells it (unbound reads as i64, as the
# bound check reads it).
fn _pn_pr_arg(S, c): i64 {
    if (_pn_is(c) == 1) { return _pn_pr(S, c); }
    if (c == 0) { c = 0 - 8; }
    return _sn_pr(S, c);
}
# 1 when a list read as (c0, c1) names an instance, not the all-i64 (or unbound) base (`_targ_inst`'s rule).
fn _targ_is_inst(c0, c1): i64 {
    if (c0 != 0 - 8) { if (c0 != 0) { return 1; } }
    if (c1 != 0) { if (c1 != 0 - 8) { return 1; } }
    return 0;
}
# Generic struct `sid` read as (c0, c1) (`lit`: the list written out) judged against its bounds at token `at`, minting
# nothing — a slot holding a pending instance (`_tck_x0` / `_tck_x1`) judged as it; the panic latch a report sets is
# put back, so the list reads on. 1 = refused.
fn _vbnd_judge(S, sid, c0, c1, lit, at): i64 {
    if (_MONOMORPH_OK != 1) { return 0; }
    var sv = GTI(S);
    var sv_pn = _panic;
    var bad = 0;
    STI(S, at);
    if (_targ_is_inst(c0, c1) == 1) { bad = _bnd_check_struct(S, sid - 1, _tck_xc(c0, _tck_x0), _tck_xc(c1, _tck_x1)); }
    elif (lit == 1) { _bnd_sbase(S, sid); }
    if (sv_pn == 0) { _panic = 0; }
    STI(S, sv);
    return bad;
}
# 0 = say nothing: under `_targ_chk` a name the cursor just passed was reported already (a generic body, both passes).
fn _ta_chk_ok(S): i64 {
    if (_ta_chk == 0) { return 1; }
    return _tn_once(S, GTI(S) - 1);
}
# 1 when `noff` names a type parameter here: bound now, the current fn's, or the struct being defined's.
fn _targ_is_tp(S, noff): i64 {
    if (_tp_c0 != 0) { if (_tp_resolve(S, noff) != 0) { return 1; } }
    if (_cur_fn_ix >= 0) { if (_is_tparam_of(S, _cur_fn_ix, noff) == 1) { return 1; } }
    if (_is_own_tparam(S, noff) == 1) { return 1; }
    if (_trs_fn > 0) { if (_fn_tp_has(S, _trs_fn - 1, noff) == 1) { return 1; } }   # 6.7.15 (D7): a trait member's
    return 0;
}

# ⛔ 6.7.14 — A TYPE ARGUMENT THAT IS NO NAME (`Box<1 + 2>`, `Box<u128>`, `id<1 + 2>(3)`, `Box<"s">`). Its token's VALUE
# was read as a name-pool offset — a number's 1 named "truct", u128's keyword value "struct", a string's offset SIGSEGV'd
# the compiler — and only that token was stepped, so a call's `+ 2>(3)` was left to the statement ("expected ';'" on
# the next line, "expected '}'" at the end of the file). Refused once at the token, by what it is (u128 by its text);
# the argument's tokens are stepped to the `,` or `>` that ends it, which the caller reads as for any argument; it is
# read as i64, so nothing cascades. CHANGELOG [6.7.14]
fn _targ_not_name(S): i64 {
    var ti = GTI(S);
    var t = TOKTYP(S, ti);
    _ta_refd = 1;
    if (t == 105) {
        _dyn_err(S, ti, "u128 cannot be a type argument (a type argument is a struct, i8/i16/i32/i64, f64, or a type parameter in scope)", 0, 0 - 1, 0);
    } elif (_dyn_ebeg(S, ti) == 1) {
        PRSTR("a type argument is a type name, got ");
        PRSTR(TOKNAME(t));
        if (t == 1) { PRSTR(" "); PRNUM(TOKVAL(S, ti)); }
        _dyn_eend(S);
    }
    _targ_skip_arg(S);
    return 0 - 8;
}
# Step one type argument's tokens, the cursor left on the `,` or the `>` / `>>` / `>>>` that ends it at its own depth
# (or on a `)` / `]`, `;`, `{`, `}`, `=` or the end of the file, where the list was never closed). Inside `( .. )` or
# `[ .. ]` a `<` / `>` is a comparison, so only the `<`s outside them nest. A `>>` / `>>>` closing a nested `<` and this
# list too is paid forward to the caller's `_consume_gt`, as `_skip_targ_list`'s is (`_ta_pending_gt`).
fn _targ_skip_arg(S): i64 {
    var pd = 0;
    var ad = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        var g = _targ_gt_n(t);
        if (pd > 0) { g = 0; }
        if (t == 12 || t == 5 || t == 13 || t == 14 || t == 4) { return 0; }
        if (pd + ad == 0) { if (t == 31 || t == 11 || t == 29 || g > 0) { return 0; } }
        if (t == 10 || t == 28) { pd = pd + 1; }
        elif (t == 11 || t == 29) { if (pd > 0) { pd = pd - 1; } }
        elif (t == 19) { if (pd == 0) { ad = ad + 1; } }
        elif (g > 0) { ad = ad - g; }
        STI(S, GTI(S) + 1);
        if (ad < 0) { _ta_pending_gt = _ta_pending_gt + (0 - ad); return 0; }   # this list's close too
    }
    return 0;
}
# How many type-argument lists token `t` closes: `>` 1, `>>` 2, `>>>` 3, else 0.
fn _targ_gt_n(t): i64 {
    if (t == 20) { return 1; }
    if (t == 39) { return 2; }
    if (t == 152) { return 3; }
    return 0;
}
