# fi's scan in `mode` again, on the scan tables `_bbf_swap` keeps aside: 1 = its verdict, at `_gsw_ti` / `_gsw_k`.
fn _gs_why_scan(S, fi, mode): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    _bbf_swap();
    _gs_params(S, fi, o);
    var b = _gs_body_open(S, _gs_at);
    var r = 0;
    if (b >= 0) { r = _gs_scan(S, fi, b, mode); }
    _bbf_swap();
    return r;
}
fn _gs_note(S, g): i64 {
    PRSTR("  note: ");
    _err_head_at(S, _gsw_ti);
    PRSTR(": '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, g, L64(_fnt_names + g * 8)));
    PRSTR("'");
    if (_gsw_k == 1) { PRSTR(" takes a field of a value typed by its type parameter\n"); return 0; }
    if (_gsw_k == 2) {
        PRSTR(" returns `&");
        PRSTR(S + 0xEC00000 + TOKVAL(S, _gsw_ti + 1));
        PRSTR("` as a struct, and ");
        PRSTR(S + 0xEC00000 + TOKVAL(S, _gsw_ti + 1));
        PRSTR(" is typed by its type parameter\n");
        return 0;
    }
    if (_gsw_k == 3) {
        PRSTR(" stores a struct result over 8 bytes in '");
        PRSTR(S + 0xEC00000 + TOKVAL(S, _gsw_ti));
        PRSTR("', typed by its type parameter\n");
        return 0;
    }
    if (_gsw_k == 5) {   # 6.7.16 (D99)
        PRSTR(" stores a struct result over 8 bytes through '");
        PRSTR(S + 0xEC00000 + TOKVAL(S, _gsw_ti));
        PRSTR("', a pointer to its type parameter\n");
        return 0;
    }
    PRSTR(" forwards its type parameter to '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, _gsw_cfi, L64(_fnt_names + _gsw_cfi * 8)));
    PRSTR("'\n");
    return 0;
}
# `&g`: the address is the base's, so a stub base is refused like a scalar call.
fn _gen_addr_check(S, fi, noff): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (_bnd_base_bad(S, fi) == 1) { _refuse_bnd_base(S, fi, noff); return 0; }   # 6.7.1 (C3)
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, fi, noff); }
    return 0;
}

# ⛔ 6.7.14 — A `p: *T` PARAMETER BINDS WHAT ITS POINTER ARGUMENT POINTS AT; AN `x: T` ONE BINDS NO POINTER (the
# user's decision D8 (a), 2026-10-16). The argument at token a for fi's carrying parameter k (1-based): through
# `p: *T` a `*S` local, parameter, capture or global, a field declared `*S` reached through a chain (`w.p`,
# `wp.p`, `G.p`), a `: *S` call and `&G` / `&l` of a struct bind S — as a struct value already did (6.6.20) and
# as a `*Box<T>` carrier does (6.7.8). Only a `*S` LOCAL bound, through either shape: 6.6.17 gave it SLTYPE
# `0 - sid`, which read as a struct argument, so `gs(q)` with `var q: *S` bound S through `x: T` against the
# guide, while `gsz(&GS)`, `gsz(GP)`, `gsz(w.p)` and a `*S` parameter ran the i64 base (sizeof(T) 8). CHANGELOG [6.7.14]
