# Pass 1 (`_prescan_fn_sig`, cursor on the `(`): record fi's GFGM word. Also the lazy path for a
# definition pass 1 never saw.
fn _gen_record(S, fi, open): i64 {
    var pk = _gs_params(S, fi, open);
    var b = _gs_body_open(S, _gs_at);
    var d = 0;
    _gs_late = 0;
    if (b >= 0) { d = _gs_scan(S, fi, b, 0); }
    SFGM(S, fi, pk | 4 | d);
    _gm_gen = _gm_gen + 1;
    if (_gs_late == 1) { if (d == 0) { if (_gs_p1end == 0) {   # 6.7.16 (D1): scanned again at pass 1's end
                if (_gsl_tab == 0) { _gsl_tab = vec_new(); }
                vec_push(_gsl_tab, fi);
            } } }
    return 0;
}
# 6.7.16 (D1) — the end of pass 1 (`_tl_pass1`): every fn and struct is registered, so each generic whose scan met a
# `return &n;` or a struct result stored in a name typed by T is scanned again — a callee or a struct declared below it
# was unknown then. Only ever more stubs. CHANGELOG [6.7.16]
fn _gen_rescan(S): i64 {
    _gs_p1end = 1;
    if (_gsl_tab == 0) { return 0; }
    var n = vec_len(_gsl_tab);
    var k = 0;
    while (k < n) {
        var fi = vec_get(_gsl_tab, k);
        var o = _gen_def_open(S, fi);
        if (o >= 0) { if (GFBND(S, fi) > 1) { _bnd_sites(S, fi, o); } }   # 6.7.16 (D102): `var y = id(x);` below
        if (o >= 0) { _gen_record(S, fi, o); }
        k = k + 1;
    }
    return 0;
}
# The `(` of fi's definition, from its recorded def-start.
fn _gen_def_open(S, fi): i64 {
    var i = GFDS(S, fi) - 1;
    if (i < 0) { return 0 - 1; }
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 10) { return i; }
        if (t == 12 || t == 13) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
fn _gen_forwards(S, fi): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    _gs_params(S, fi, o);
    var b = _gs_body_open(S, _gs_at);
    if (b < 0) { return 0; }
    return _gs_scan(S, fi, b, 1);
}
fn _gen_close(S): i64 {
    if (_gm_closed == _gm_gen) { return 0; }
    var ch = 1;
    while (ch == 1) {
        ch = 0;
        var fi = 0;
        var n = GFNC(S);
        while (fi < n) {
            var m = GFGM(S, fi);
            if ((m & 7) == 4) {
                if (_gen_forwards(S, fi) == 1) { SFGM(S, fi, m | 2); ch = 1; }
            }
            fi = fi + 1;
        }
    }
