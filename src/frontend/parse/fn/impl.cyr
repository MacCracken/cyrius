    _ann_refd_bind(S, pnoff, 0 - 2 - li);   # 6.7.16: a refused annotation's stand-down is this parameter's
    return 0;
}
# ⛔ 6.7.8 (C2-6a) — A SLICE PARAMETER IS REFUSED BY NAME (the user's decision, 2026-10-10: slices
