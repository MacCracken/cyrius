    if (_classify_param_type(S, _impl_tnoff) != 0) { return 0; }
    var sid = FINDSTRUCT(S, _impl_tnoff);
    if (sid <= 0) { return 0; }
    return sid;
}
# Pass 1, parameter 0 of fn `fi` named `pnoff` with no annotation: the struct mask after it.
fn _iself_prescan(S, fi, pnoff, smask): i64 {
    var sid = _iself_sid_for(S, pnoff);
