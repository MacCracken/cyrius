# "expected a type for parameter 'a', got '+'" at token `ti` (`loud`), the type's first problem only,
# once per token (a generic's instances re-read the signature); not a panic, so the list reads on.
fn _pty_err(S, ti, loud): i64 {
    var b = _pty_bad;
    _pty_bad = 1;
    if (loud == 0) { return 0; }
    if (b == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": expected a type");
    var pn = _pty_pnoff(S);
    if (pn >= 0) {
        PRSTR(_pty_what());
        PRSTR("'");
        PRSTR(S + 0xEC00000 + pn);
        PRSTR("'");
    }
    PRSTR(", got ");
    var t = TOKTYP(S, ti);
    PRSTR(TOKNAME(t));
    if (t == 1) {
        PRSTR(" ");
        PRNUM(TOKVAL(S, ti));
    }
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}
# A return annotation the type-name path does not read (cursor on it): `: *T` (6.6.17) and, refused
# by name, a slice `[T]` / `slice<T>` (6.7.8, C2-6a: `expected identifier, got '['` / `unknown type
# 'slice'`). 1 when consumed here.
fn _ret_ann_alt(S, fi): i64 {
    if (_sl_ann_at(S, GTI(S)) == 1) {
        _sl_err(S, GTI(S), "a slice cannot be a return type (6.7.8: slices are fn-locals)",
          " - fill a slice the caller passes as &s (slice_set), or return the pointer and the length");
        _sl_ann_skip(S);
        return 1;
    }
    if (PEEKT(S) == 105) {   # 6.7.14: `: u128` refused by name (it was "expected identifier, got reserved keyword")
        _u128_refuse(S, GTI(S), "a fn return type yet");
        STI(S, GTI(S) + 1);
        return 1;
    }
    if (PEEKT(S) != 8) { return 0; }
    if (_trs_ret_fnp(S, GTI(S)) == 1) { return _fnp_ret_def(S, fi); }   # 6.7.16: `: *fn( .. )`, refused by name
    _ret_ptr_annot(S, fi, 0);
    return 1;
}
# v6.3.37 (C1) — why a fn's PARAMETERS keep it off the inline replay: 3 a struct/Str/Result/Option/
# Tagged parameter (SLTYPE = -sid), 6 a `name: *T` parameter, 0 neither. The replay re-registers a
# parameter by NAME with only the type GFIPT packs (`_inl_bind_param`) — vectors and f64/f32 —
# so a struct's SLTYPE is lost (`s.field` mis-parses) and so is a pointer's bit 56 and step mark
# (`_sl_marks`): an inlined `p + 1` stepped 1 whatever T, and on a `*f32` it was a FLOAT add of
# the pointer's bits, while the same fn out of line stepped sizeof(T) (6.6.17 b7 missed this
# site). Such a fn falls back to a call, which handles both correctly. Vectors stay inlinable.
# ⛔ 6.6.20 — this walks SLOTS 0.._cur_fn_pslots-1, not parameters 0..pc-1: a wide vector takes
# GVEC_NSLOTS slots, so after `v: f64v2` the next parameter sits at slot 2 and a by-parameter
# walk never saw it — `fn sx(v: f64v2, s: Pt)` was replayed and crashed the compiler. Fillers
# are untyped and never carry bit 56 (every registration writes SLDEP first). CHANGELOG [6.6.20]
fn _inl_param_why(S): i64 {
    var li = 0;
    while (li < _cur_fn_pslots) {
        if (GLPTRP(S, li) == 1) { return 6; }
        var t = GLTYPE(S, li);
        if (t < 0) { if (_is_simd_any(S, t) == 0) { return 3; } }
        li = li + 1;
    }
    return 0;
}

# 6.7.14 — reason 8: `#inline` on an `async fn`. The body is compiled as `f$impl` and reached only
# through its Future (`future_force`'s fn pointer); no call names `f$impl`, so the replay can never
# run — v6.5.63's contract is that an ignored `#inline` says so. `noff` is the user's name `f`.
# CHANGELOG [6.7.14]
fn _inl_async_warn(S, noff): i64 {
    _ew("warning:", 8);
    _err_head(S);
    _ew(": #inline ignored: async fn '", 29);
    PRSTR(S + 0xEC00000 + noff);
    _ew("' runs through its Future\n", 26);
    _err_excerpt(S);
    return 0;
}
# ⛔ 6.6.17 (a9) — an f64 / f32 parameter's slot tag, and the same tag for the INLINE replay. The
# replay re-registers a parameter by name with the type GFIPT recorded, which carried vector
# descriptors only, so an inlined `x: f64` was an untyped word: `#inline fn d(x: f64) { return x
# + x; }` added 1.5's bits as integers, and so did every one-statement generic instance at T = f64
# (`x: T` was untyped there too, see the parameter loop). Field `0x8001` / `0x8002` in the pack is
# f64 / f32 (`_ipt_sltype`); a vector's field is its descriptor + 1 (<= 256). CHANGELOG [6.6.17]
fn _param_float(S, li, pc, flt, pack): i64 {
    if (flt == 0) { return pack; }
    SLTYPE(S, li, flt);
    var f = 0x8001;
    if (flt == F32_TYID) { f = 0x8002; }
    if (pc == 0) { return pack | f; }
    if (pc == 1) { return pack | (f << 16); }
    return pack;
}
# ⛔ 6.7.16 (D72, the user's decision, 2026-10-20) — A NARROW PARAMETER IS NARROWED IN THE FN, LIKE A NARROW LOCAL.
# `y: u8` / `i8` / `u16` / `i16` / `u32` / `i32` (and a generic `x: T` bound to i8 / i16 / i32) types its slot as a
# narrow local's: SLTYPE the width and, signed, the negative slice-width mark (`_sl_marks`), so its reads take the
# width sign- or zero-extended and its stores (`y = v`, `y += 1`, `*(&y) = v`) write it. The ABI is unchanged — the
# whole register is homed and only its low bytes are read — so a call through a fn pointer narrows too. It was typed
# 0, the caller's whole word: `wid(0x1FF)` read 511 in a `u8`, and `y += 1` of an `i16` 32767 was 32768. The #inline
# replay carries the code in the GFIPT pack (field 0x8100 | code, `_ipt_ncode`). CHANGELOG [6.7.16]
var _pnw_pend = 0;   # the parameter being parsed: its narrow code (the width, | 8 when signed), 0 = none
# The return of the call `IDENT(` / `IDENT<..>(` at the cursor to fi: FINDFN's entry's, or for a
# generic the INSTANCE's the call reaches — an f64 (`gid(gid(h))`, 6.7.9) or a struct (6.7.11:
# `g(mk1(p))` bound T to `mk1`'s base return, the generic `Box`, and was refused against the real
# `Box<Pt>`; `g(id(p))` bound i64). Asked of the instance whatever the base records, as `_gsc_call`
# does: a base parsed below the call has no `: T` return yet (0). A narrow scalar instance keeps i64.
# 6.7.14: `ptr` 1 (a `p: *T` carrier, `_infer_conc_at`) — and a `: *S` return binds S (`_ic_rps`).
fn _ic_call_rs(S, fi, ptr): i64 {
    var r = GFRS(S, fi);
    if (_MONOMORPH_OK == 0) { return _ic_rps(S, fi, r, ptr); }
    if (GFTP(S, fi) == 0) { return _ic_rps(S, fi, r, ptr); }
    if (r < 0) { if (r != 0 - 8) { return r; } }   # a declared scalar / vector return: the instance's too
    if (_gu_noinst == 1) { return _gu_ircs(S, fi, r, ptr); }   # 6.7.16: the zone sweep makes no instance
    var ifi = _gen_call_inst(S, GTI(S));
    if (ifi < 0) { return r; }
    if (ptr == 1) { if (_fn_ret_ps(ifi) > 0) { return _ic_rps(S, ifi, r, 1); } }   # 6.7.15: a scalar pointee too
    var ir = GFRS(S, ifi);
    if (ir == 0 - 9) { return ir; }
    if (ir > 0) { return ir; }
    return r;
}
# The struct fn fi's `: *S` return points at (`_fn_rpsid`) when `ptr` is 1 — 6.7.15 (D11): a `: *i32` / `: *f64`
# return's scalar (`_ic_pscalar` of its step word) — else `r` (fi's own return). CHANGELOG [6.7.14]
fn _ic_rps(S, fi, r, ptr): i64 {
    if (ptr == 0) { return r; }
    if (_fn_rpsid != 0) {
        var ps = L64(_fn_rpsid + fi * 8);
        if (ps > 0) { return ps; }
    }
    var w = _fn_ret_ps(fi);
    if (w > 0) { return _ic_pscalar(w); }
    return r;
}
# The fn the call at token ti (`name(` / `name<..>(`) reaches — a generic's instance (`_pair_gen_inst`,
# instantiating it), else FINDFN's entry. A peek inside another call's inference: the inner resolve's
# own `_gi_sc` is not that inference's, and is put back; the cursor sits on the inner call meanwhile,
# so a refusal its instantiation reports (a bound) names that call, not the outer one. CHANGELOG [6.7.11]
fn _gen_call_inst(S, ti): i64 {
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return fi; }
    if (_MONOMORPH_OK == 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    if (_gu_noinst == 1) { _gu_miss = 1; return fi; }   # 6.7.16: the zone sweep makes no instance (`_gu_tp`)
    var sv = _gi_sc;
    var st = GTI(S);
    STI(S, ti);
    var ifi = _pair_gen_inst(S, ti);
    STI(S, st);
    _gi_sc = sv;
    return ifi;
}
# 1 = the IDENT at the cursor opens a call: `name(`, or a generic's resolvable `name<..>(` (`_gcall_open`).
fn _ic_is_call(S): i64 {
    var nt = TOKTYP(S, GTI(S) + 1);
    if (nt == 10) { return 1; }
    if (nt != 19) { return 0; }
    if (_gcall_open(S, GTI(S)) < 0) { return 0; }
    return 1;
}
# A float literal at the cursor: f64 when it is the whole argument (a `,` or the `)` follows).
fn _ic_flit(S): i64 {
    var nt = TOKTYP(S, GTI(S) + 1);
    if (nt == 31 || nt == 11) { return 0 - 9; }
    return 0 - 8;
}
fn _is_ptr_param(S, li): i64 {
    if (li < 0) { return 0; }
    if (li >= _cur_fn_pslots) { return 0; }
    return GLPTRP(S, li);
}
# 6.6.10: a struct GLOBAL argument binds its struct like a struct local does. GVTYPE alone is
# ambiguous (a narrow scalar global stores its WIDTH there, 1..7); a struct global is the one
# with a recorded layout mode (GVPM 1 or 2, 6.6.5). A PEEK: `_findvar_core`, not FINDVAR, whose
# visibility report belongs to the argument's own parse. 6.7.14: through `p: *T` (`ptr` 1) a `*S` global binds S.
fn _infer_conc_global(S, noff, ptr): i64 {
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0 - 8; }
    if (ptr == 1) {
        if (_gv_ptr_sid(S, vi) > 0) { return _gv_ptr_sid(S, vi); }
        if (_gv_ptr_word(S, vi) > 0) { return _ic_pscalar(_gv_ptr_word(S, vi)); }   # 6.7.15 (D11): a `*i32` global
    }
    if (GVTYPE(S, vi) == F64_TYID) { return 0 - 9; }   # 6.7.9: an f64 global binds f64
    if (GVPM(S, vi) == 0) { return 0 - 8; }
    var t = GVTYPE(S, vi);
    if (t > 0) { return t; }
    return 0 - 8;
}

# v6.3.9 (F-fns): populate the active T->concrete binding for a generic call.
# Unpacks the callee's packed tparam names (GFTP) and binds tparam i <- inf_i (the
# positional inference: param_i is type tparam_i). Caller _tp_clear()s after the
# instantiation/replay. No-op when the callee has no tparams.
fn _bind_generic_call(S, fi, inf0, inf1): i64 {
    var _bg = GFTP(S, fi);
    if (_bg == 0) { return 0; }
    var _bg0 = _bg & 0xFFFFFFFF;
    if (_bg0 != 0) { _tp_bind(S, 0, _bg0 - 1, inf0); }
    var _bg1 = (_bg >> 32) & 0xFFFFFFFF;
    if (_bg1 != 0) { _tp_bind(S, 1, _bg1 - 1, inf1); }
    return 0;
}

# ⛔ 6.6.17 (a3) — the binding an INLINE replay of generic fn `fi` runs under. An instance
# (`szof$i16`, `sv$i8`) is a separate fn whose body tokens are the base's, so its replay must bind
# T to the instance's OWN type arguments (recorded at instantiation, `SFIC`); it bound the call's
# inferred ones, which an explicit `f<i16>(..)` never sets (-8, i64). A one-statement generic
# body is inlinable, so `return sizeof(T);` read 8 and `var y: T` was an i64 whenever the call
# sat inside a fn — and a generic forwarding its T (`return sv<T>(x);`) lost it. CHANGELOG [6.6.17]
fn _bind_inl_generic(S, fi, inf0, inf1): i64 {
    var c0 = GFIC(S, fi, 0);
    if (c0 != 0) { return _bind_generic_call(S, fi, c0, GFIC(S, fi, 1)); }
    return _bind_generic_call(S, fi, inf0, inf1);
}

# v6.3.9 (F-fns): is `noff` one of fn `fi`'s captured type-params? Used at the
# definition to accept a `: T` return type (T isn't a concrete type, but it IS a
# valid generic return) instead of erroring.
fn _is_tparam_of(S, fi, noff): i64 {
    var _it = GFTP(S, fi);
    if (_it == 0) { return 0; }
    var _it0 = _it & 0xFFFFFFFF;
    if (_it0 != 0) { if (noff == _it0 - 1) { return 1; } }
    var _it1 = (_it >> 32) & 0xFFFFFFFF;
    if (_it1 != 0) { if (noff == _it1 - 1) { return 1; } }
    return 0;
}

# v6.5.69 — does this fn body contain an `await`? Token lookahead over the body's brace
# span, restoring the cursor. Same shape as `_body_has_defer` below.
#
# ⛔ THIS SELECTOR IS LOAD-BEARING, NOT AN OPTIMISATION. The coroutine transform moves a
# body's locals into a heap frame and treats parameter 0 as the frame base. Applying it to
# EVERY `async fn` would break the ones that already work: `tests/fixtures/async/
# async_closure_generic.cyr` has `async fn compute(n)` whose body contains no `await` at all
# — it is awaited by its CALLER — so its parameter `n` would be read as a frame pointer.
# An `async fn` with no suspend point in its body keeps exactly the v6.3.11
# deferred-then-forced semantics it has today.
# v6.5.70 — the same question asked from the SIGNATURE rather than the body: scan forward to
# the body's opening brace, then over its span. Needed because a coroutine must reserve stack
# slot 0 for its frame base BEFORE its parameters are allocated slots, and the parameters are
# parsed first.
fn _fn_body_has_await_ahead(S): i64 {
    var _sv = GTI(S);
    var _g = 0;
    while (PEEKT(S) != 13) {
        if (PEEKT(S) == 12) { STI(S, _sv); return 0; }
        if (_g > 8192) { STI(S, _sv); return 0; }
        STI(S, GTI(S) + 1);
        _g = _g + 1;
    }
    STI(S, GTI(S) + 1);
    var _r = _body_has_await(S);
    STI(S, _sv);
    return _r;
}
# 6.7.9 — reserve a coroutine's slot 0 (SELF, homed by the prologue) as an ANONYMOUS slot. The
# local tables are not cleared between fns, so reserving it by count alone (`SFLC(S, 1)`) left the
# previous fn's local 0 on it: its NAME resolved to SELF inside the coroutine (a global of that name
# read the frame's address, a local of that name was a "duplicate variable"), and its depth word's
# flag bits and its type reached the slot walkers (`_inl_param_why` named a `*T` / struct parameter
# the coroutine does not have). Name -1, depth word and type 0, as every anonymous slot; the slice
# width is trusted only behind the depth word's bit 62 and the float flag is cleared by SFLC.
# Gate: tests/gates/frontend/coroutine_fnptr_and_completion.sh rows N. CHANGELOG [6.7.9]
fn _coro_slot0_reserve(S): i64 {
    S64(S + 0x5D9D000, 0 - 1);
    SLDEP(S, 0, 0);
    SLTYPE(S, 0, 0);
    SFLC(S, 1);
    return 0;
}

fn _body_has_await(S): i64 {
    var _sv = GTI(S);
    var _bd = 1;
    var _found = 0;
    while (_bd > 0) {
        var _t = PEEKT(S);
        if (_t == 12) { _bd = 0; }                   # EOF guard
        elif (_t == 13) { _bd = _bd + 1; STI(S, GTI(S) + 1); }
        elif (_t == 14) { _bd = _bd - 1; STI(S, GTI(S) + 1); }
        elif (_t == 135) { _found = 1; STI(S, GTI(S) + 1); }
        else { STI(S, GTI(S) + 1); }
    }
    STI(S, _sv);
    return _found;
}

# 6.6.7 — does the fn body starting at the cursor (just past its `{`) contain a `defer` (106)
# or a `secret var` (108) ANYWHERE? Decides that its `return f(..);` never tail-calls
# (`_tc_frame_divert`). ⚠ Lexical over the whole brace range, so a defer inside a nested closure
# literal counts too — that costs the enclosing fn its tail calls, never correctness.
fn _body_has_defer(S): i64 {
    var i = GTI(S);
    var n = GTCNT(S);
    var bd = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0; }                   # EOF guard
        if (t == 13) { bd = bd + 1; }
        if (t == 14) { bd = bd - 1; if (bd == 0) { return 0; } }
        if (t == 106 || t == 108) { return 1; }
        i = i + 1;
    }
    return 0;
}
