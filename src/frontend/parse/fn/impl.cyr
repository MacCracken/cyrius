# PARSER — fn: PARSE_IMPL, type-parameter lists (SKIP_GENERICS, `_capture_tparams`), a call's type inference,
# parameter types (`_pty_*`) and the body scans for `await` / `defer`.
# ================================================================
# Split from parse/fn.cyr at 6.7.18, unchanged; parse.cyr includes parse/fn/'s files in source order. CHANGELOG [6.7.18]

# Parse: impl TraitName for TypeName { fn method(self) { } ... }
# Methods get mangled to TypeName_method (trait name is documentation only for now)
# ⛔ 6.7.7 (B4) — `impl ( .. ) {` / `impl Tr for ( .. ) {`: a tuple has no methods (R3). Refused by
# name at the `(`, and the whole block skipped — pass 1 skipped it too (`_impl_name_skip`), so no
# method of it is registered. CHANGELOG [6.7.7]
fn _impl_tup_refuse(S): i64 {
    _tup_err(S, GTI(S), "a tuple has no methods - `impl` on a tuple type is refused", 0 - 1, 0);
    STI(S, _call_close(S, GTI(S)) + 1);
    _skip_refused_body(S);
    return 0;
}
# Pass 1's impl skip: one name, or (6.7.7) a tuple type's whole `( .. )`, which PARSE_IMPL refuses.
fn _impl_name_skip(S): i64 {
    if (PEEKT(S) == 10) { STI(S, _call_close(S, GTI(S)) + 1); return 0; }
    STI(S, GTI(S) + 1);
    return 0;
}

fn PARSE_IMPL(S): i64 {
    # v6.6.4: a marker live here can only be STALE — `public impl` is consumed un-armed by
    # _TL_VIS, and a per-method `public fn` re-arms inside the loop below. Pass 2's `var` skip
    # never consumes, so `public var V = 7;` followed by an impl block re-exposed its FIRST
    # method.
    # ⛔ 6.6.5: that sentence used to end "(the only definition class stamped in pass 2 only)",
    # and pass 1 DID brace-skip impl bodies. It does not any more — `_prescan_impl` registers
    # and stamps every method in pass 1, which is what makes a forward `q.m()` / `Q_m(&q)` obey
    # `private` and get the right parameter ABI. See _prescan_impl. CHANGELOG [6.6.5]
    _pub_pending = 0;
    var impl_ti = GTI(S);
    STI(S, GTI(S) + 1);  # consume IMPL
    # `impl Trait for Type {` or (6.7.0, A3) the inherent `impl Type {` — methods with no trait.
    if (PEEKT(S) == 10) { return _impl_tup_refuse(S); }   # 6.7.7 (R3): `impl ( .. ) {`
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); return _impl_hdr_bad(S, impl_ti); }   # 6.7.17: the block stepped (parse/fn/def.cyr)
    var trait_noff = PEEKV(S);
    STI(S, GTI(S) + 1);  # consume the trait (or, inherent, the type) name
    var type_noff = trait_noff;
    if (PEEKT(S) == 13) { trait_noff = 0; }
    else {
        if (PEEKT(S) != 55) {
            ERR_MSG(S, "expected '{' (an inherent `impl Type {`) or 'for' (`impl Trait for Type {`)", 75);
            return _impl_hdr_bad(S, impl_ti);
        }
        STI(S, GTI(S) + 1);  # consume FOR
        if (PEEKT(S) == 10) { return _impl_tup_refuse(S); }   # 6.7.7 (R3): `impl Tr for ( .. ) {`
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); return _impl_hdr_bad(S, impl_ti); }
        type_noff = PEEKV(S);
        STI(S, GTI(S) + 1);  # consume type name
    }
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); return _impl_hdr_bad(S, impl_ti); }
    STI(S, GTI(S) + 1);  # consume {
    # Parse methods inside the impl block
    # Temporarily set module to the type name so methods get mangled
    var saved_mod = GMOD(S);
    SMOD(S, type_noff);
    var _sit = _impl_tnoff;
    _impl_tnoff = type_noff;   # 6.7.0 (A4)
    var _sitr = _impl_trait;
    _impl_trait = trait_noff;  # 6.7.0 (A3)
    var _sii = _cur_ii;
    _cur_ii = 0 - 1;
    if (_ti_n > 0) { _cur_ii = _ti_by_ti(S, impl_ti); }   # 6.7.0 (A1/A2): its trait record
    _tr_check_impl(S, _cur_ii);
    var igo = 1;
    while (igo == 1) {
        if (PEEKT(S) == 14) { igo = 0; }
        else {
            _impl_attrs(S, 1);         # 6.6.17: `#deprecated` / `#must_use` / ... on a method
            if (_TL_VIS(S) == 1) { }   # v6.5.0: `pub`/`public` on an impl method
            if (PEEKT(S) == 32) { _tr_mod_for(S); PARSE_FN_DEF(S); _tr_mod_back(S); }
            else { igo = _impl_member_bad(S, trait_noff, type_noff, 1); }   # 6.7.16
        }
    }
    _tr_defaults(S, _cur_ii, 1);       # 6.7.0 (A1): the trait's defaults this impl does not define
    _cur_ii = _sii;
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);  # consume }
    _impl_tnoff = _sit;
    _impl_trait = _sitr;
    _cur_iself_sid = 0;        # top-level code after the impl is no method body
    SMOD(S, saved_mod);
    return 0;
}

# ⛔ 6.6.17 — DIRECTIVES IN AN impl BODY. Its loop took only `pub` and `fn`, so `#deprecated("..")`
# before a method was "expected '}', got unknown" (#must_use / #pure / #io / #alloc / #inline /
# #regalloc / #naked and #assert alike). They go through THE top-level dispatcher
# (`_tl_directive`): arm 1 in pass 2 arms an attribute for the method PARSE_FN_DEF parses next;
# arm 0 in pass 1 (`_prescan_impl_body`) consumes, and records a `#deprecated` for the method it
# registers, so a call parsed before the impl warns too.
fn _impl_attrs(S, arm): i64 {
    while (_impl_dir(S, arm) == 1) { }   # 6.7.16: an #assert's line ends at the body's `}`
    return 0;
}

# Skip generic parameters <T, U, ...> if present
# ⛔ 6.6.17: NESTED. It stopped at the first `>` and knew no `>>`, so `Vec<Box<i64>>` — whose
# tail the lexer makes ONE `>>` token — ran to the end of the file (`expected '=', got end of
# file`), and `Vec<Box<i64> >` left a `>` behind. See `_skip_targ_list`.
fn SKIP_GENERICS(S): i64 {
    if (PEEKT(S) == 19) { _skip_targ_list(S); }
    return 0;
}
# Cursor on a `<`: consume through the `>` that closes it, nested lists included (`>>` / `>>>`
# close two / three levels). Returns how many levels the last closer closed BEYOND this list — an
# enclosing type-argument list's `>` the lexer folded into the same token (`Box<Vec<i64>>`'s
# `>>`, seen from `Vec`), which the caller owes to `_consume_gt` (`_ta_pending_gt`).
# v6.5.19: EOF guard. `fn f<`, `struct S<`, `enum E<` truncated here span a loop whose only exit
# was `>`; this skipper emits no diagnostic, so `_had_error` stayed 0 and the v6.4.62 watchdog
# never ticked — cycc HUNG outright. See _wd_eof_tick (src/common/util.cyr) and the include-length ifdef bug.
fn _skip_targ_list(S): i64 {
    var d = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { return 0; }
        if (t == 19) { d = d + 1; }
        elif (t == 20) { d = d - 1; }
        elif (t == 39) { d = d - 2; }
        elif (t == 152) { d = d - 3; }
        STI(S, GTI(S) + 1);
        if (d <= 0) { go = 0; }
    }
    return 0 - d;
}
# ⛔ 6.7.17 — A DECLARATION'S `<..>` (a fn's, a struct's, a union's, an enum's) CLOSED BY A `>>` / `>>>` THAT CLOSES
# MORE THAN THE LIST: `fn f<T>>(x)`, `struct B<T>> {`, `enum E<T>> {`. The extra level was dropped — they compiled under
# CYRIUS_MONOMORPH=0 and for an enum — and the default capture read on past it (`>>` closed nothing there), the
# parameters and the body taken as the list, the rest of the file with them. The cursor is left ON that closer, so the
# header's next read reports it — "expected '(', got '>>'" — as it reports `fn f<T> >(x)`'s `>`. CHANGELOG [6.7.17]
fn _tpl_skip(S): i64 {
    if (PEEKT(S) != 19) { return 0; }
    if (_skip_targ_list(S) > 0) { STI(S, GTI(S) - 1); }
    return 0;
}

# v6.3.9 (F-fns): capture a generic param list `<T, U>` at a fn signature, returning
# the names PACKED as (off0+1) | ((off1+1) << 32) (0 = no `<...>`). Consumes EXACTLY
# the tokens `_tpl_skip` would (`<` through `>`, nested; 6.7.17: a closer that closes more
# than the list left on), so the cursor advances identically in both modes.
# Default path (_MONOMORPH_OK == 0): delegates to `_tpl_skip` and returns 0. Only ≤2 params are captured (the inline
# replay's pc≤2 ceiling); extra params are consumed but not recorded.
# ⛔ 6.7.16 (D8) — and a third is REFUSED, once, at its name (`_ctp_third`): it was consumed and bound nothing, so
# `fn g3<A, B, C>` read `sizeof(C)` as 8 for a 24-byte struct argument and `struct Three<A, B, C>` laid C out as i64,
# with no diagnostic. CHANGELOG [6.7.16]
fn _capture_tparams(S): i64 {
    if (PEEKT(S) == 19) { _tpl_names(S, GTI(S)); }   # 6.7.17 (D3): an entry that is no name
    if (_MONOMORPH_OK == 0) { _tpl_skip(S); return 0; }
    if (PEEKT(S) != 19) { return 0; }
    _ctp_n0 = 0; _ctp_n1 = 0; _ctp_bad = 0;   # 6.7.1 (C3): this list's bounds
    STI(S, GTI(S) + 1);  # consume <
    var off0 = 0;
    var off1 = 0;
    var n = 0;
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) == 20) { go = 0; }
        # v6.5.19: EOF guard — the monomorph twin of `_tpl_skip`'s (`_skip_targ_list`), same hang.
        # It must consume EXACTLY what `_tpl_skip` does (see the comment on this fn),
        # so the two have to stay in lockstep.
        elif (PEEKT(S) == 12) { go = 0; }
        elif (_targ_gt_n(PEEKT(S)) > 1) { return off0 | (off1 << 32); }   # 6.7.17: `<T>>` — left for the header (`_tpl_skip`)
        else {
            if (PEEKT(S) == 2) {
                if (n == 0) { off0 = PEEKV(S) + 1; }
                if (n == 1) { off1 = PEEKV(S) + 1; }
                if (n == 2) { _ctp_third(S); }
                n = n + 1;
                STI(S, GTI(S) + 1);
                # 6.7.1 (C3): `T: Show + Eq` — a BOUND, not two more type parameters (it minted
                # `Show` as the second one). Consumed here; `_bnd_make` resolves and reports.
                if (PEEKT(S) == 49) {
                    _ctp_bounds(S, n - 1);
                    if (_ctp_closed == 1) { _ctp_closed = 0; return off0 | (off1 << 32); }   # `>>` closed it
                }
            } elif (PEEKT(S) == 19) {
                # 6.7.17: `<T<i64>>` (refused, `_tpl_names`) — the inner list stepped whole, as SKIP_GENERICS steps it:
                # its names were taken as parameters, and its `>>` read past the list
                var nx = _skip_targ_list(S);
                if (nx > 0) {
                    if (nx > 1) { STI(S, GTI(S) - 1); }
                    return off0 | (off1 << 32);
                }
            } else {
                STI(S, GTI(S) + 1);
            }
        }
    }
    # consume `>`; 6.7.17: never the end of file, as SKIP_GENERICS (`struct P<T` stepped pass 1 past it, so pass 2's
    # "expected '{', got end of file" was a second line at another token)
    if (PEEKT(S) != 12) { STI(S, GTI(S) + 1); }
    return off0 | (off1 << 32);
}

# The third type parameter of the list `_capture_tparams` reads (the cursor on its name) — "a third type parameter
# 'C': a generic takes at most two type parameters" (the user's D8, 2026-10-19: the guide's two-slot model), once per
# token, the panic latch put back so the declaration reads on. Pass 1 says it (a struct's definition, a fn's prescan,
# in source order, as the bound refusal it replaces was), never an instance's re-emit. Its uses say nothing more
# (`_ta_x3`). It needs no name resolved, so `--syntax-only` (cyrius lint) reports it too. CHANGELOG [6.7.16]
fn _ctp_third(S): i64 {
    if (_inst_name != 0) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, GTI(S)) == 0) { return 0; }
    ERR_IDENT(S, "a third type parameter ", PEEKV(S), ": a generic takes at most two type parameters", 0 - 1);
    _panic = 0;
    return 0;
}

# v6.3.9 (F-fns): infer the CANONICAL concrete-type token of the arg expression at
# the current cursor, WITHOUT consuming it. Encoding matches _tp_resolve: >0 struct
# sid, <0 -scalarwidth. `IDENT(` → callee GFRS (whose >0-sid / <0-width encoding is
# already canonical); a struct local (GLTYPE = -sid) → +sid; everything else (plain
# int, literal, complex expr) → i64 (-8). Narrow-scalar args infer as i64 — explicit
# `foo<i32>(x)` (the wired-up call form) pins those precisely.
# ⛔ 6.7.9 — an f64 argument binds f64 (-9), as an f64-returning call already did: an f64 local
# or parameter, an f64 global (`_infer_conc_global`) and a float literal, each as the WHOLE
# argument (`_gen_arg_whole`; `g(h * 2.0)` stays i64, as `g(p + 1)` does). They inferred i64, so
# `gid(h)` ran the i64 base and its result was an untyped word — `gid(h) * 2.0` multiplied the
# double's bits. An f32 is not a type argument (nor a return type): it stays i64. CHANGELOG [6.7.9]
# ⛔ 6.7.14 — `ptr` 1: the carrying parameter is `p: *T` (`_ic_arg`), where a pointer binds what it POINTS AT; 0:
# `x: T`, where no pointer binds (see `_ic_arg`). CHANGELOG [6.7.14]
# ⛔ 6.7.15 — and what it points at may be a SCALAR (the user's decision D11 (a), 2026-10-18): see `_ic_pscalar`.
fn _infer_conc_at(S, ptr): i64 {
    if (PEEKT(S) == 61) { return _ic_flit(S); }
    if (PEEKT(S) == 27) { return _ic_addr(S, ptr); }   # 6.7.14: `&G` / `&l`
    if (PEEKT(S) == 2) {
        var _ic_noff = PEEKV(S);
        if (_ic_is_call(S) == 1) {   # 6.7.11: + an explicit generic call `mk1<Pt>(p)`
            var _ic_fi = FINDFN(S, _ic_noff);
            if (_ic_fi >= 0) {
                var _ic_ret = _ic_call_rs(S, _ic_fi, ptr);   # 6.7.9: + a generic's f64 instance
                if (_ic_ret != 0) { return _ic_ret; }
            }
        } else {
            var _ic_lli = FINDLOCAL(S, _ic_noff);
            if (_ic_lli >= 0) {
                var _ic_lt = GLTYPE(S, _ic_lli);
                # 6.6.10: a vector local's SLTYPE is a descriptor sentinel (<= -2048), not a
                # struct id — it read as "struct 2093". Vectors are not type arguments.
                if (_ic_lt <= 0 - 2048) { return 0 - 8; }
                if (GLPTRP(S, _ic_lli) == 1) { return _ic_ptr_slot(S, _ic_lli, _ic_lt, ptr); }   # 6.7.14: a `*S` slot
                if (_load_lt(S, _ic_lli) == F64_TYID) { return 0 - 9; }   # 6.7.9
                if (_ic_lt < 0) { return 0 - _ic_lt; }
                return 0 - 8;
            }
            if (_cl_cap_esl(S, _ic_noff) >= 0) { return _ic_cap(S, _ic_noff, ptr); }   # 6.7.14: a captured `*S`
            return _infer_conc_global(S, _ic_noff, ptr);
        }
    }
    return 0 - 8;
}
# A typed-pointer slot `li` (a `*S` local, parameter or capture: SLTYPE `0 - sid` behind bit 56 since 6.6.17) binds S
# through `p: *T` only — 6.7.15 (D11 (a)): a scalar pointee its scalar (`_ic_pscalar`); through `x: T` it is a
# pointer, which infers i64. CHANGELOG [6.7.14]
fn _ic_ptr_slot(S, li, lt, ptr): i64 {
    if (ptr == 0) { return 0 - 8; }
    if (lt < 0) { return 0 - lt; }
    return _ic_pscalar(_slot_ptr_word(S, li));
}
# ⛔ 6.7.15 — A `p: *T` / `pp: **T` PARAMETER BINDS A SCALAR POINTEE TOO (the user's decision D11 (a), 2026-10-18).
# 6.7.14's D8 bound only a struct pointee: `second(pa)` with `pa: *i32` and `fn second<T>(p: *T)` ran the i64 base,
# whose `p + 1` stepped 8 and `*p` read 8 (over an i32 array: a[2]'s word, where `second<i32>(pa)` reads a[1]), and
# `gsz(&h)` with `h: f64` was the i64 instance. The binding a typed pointer's step word `w` names (its kind, bits 40-47,
# `_ps_word`): i8 / i16 / i32 their width, f64 -9; i64 for every other pointee — `*i64`, `*u8`..`*u64`, `*f32`,
# `*bool`, a pointer, a vector, an enum: no type argument but i64 (an f32 value binds none either). A non-i64 answer
# marks `_gi_sc`, so the call instantiates as `second<i32>(pa)` does (`_gen_sc_inst`; a stub base keeps its refusal).
# Every `p: *T` source reads its word here — a `*T` local, parameter, capture or global, a `: *T` call, a `*T` field
# chain, `&x` of a scalar local or global (`_ic_ascalar`) — and a `pp: **T` source its pin's pointee word
# (`_ic_pp_sid`, `_ic_pp_addr`). CHANGELOG [6.7.15]
fn _ic_pscalar(w): i64 {
    var r = 0 - 8;
    if (w > 0) {
        var ed = (w >> 40) & 0xFF;
        if (ed == 0x41) { r = 0 - 1; }
        elif (ed == 0x42) { r = 0 - 2; }
        elif (ed == 0x44) { r = 0 - 4; }
        elif (ed == 0x28) { r = 0 - 9; }
    }
    if (r != 0 - 8) { _gi_sc = 1; }
    return r;
}
# A name a capturing closure's body reads as a capture (`_cl_cap_esl`), through `p: *T`: its struct when the
# enclosing slot is a `*S` (its pointer mark rides the snapshot, `_cl_snap_ptrp`), 6.7.15 (D11) its scalar when it is
# a scalar pointer; 6.7.15 (D12 (a)) a captured struct VALUE its struct through either shape, as a struct local
# binds (through `p: *T` the call passes the capture's copy's address); any other capture reads as before (a global
# of its name, else i64). CHANGELOG [6.7.14]
# ⛔ 6.7.16 — a captured f64 VALUE binds f64 through either shape, as the f64 local it captures does (`_infer_conc_at`'s
# `_load_lt` rung; the user's D3, 6.7.16's, 2026-10-19: "binds f64, like the local it captures"): `|| gid(h) * 2.0`
# ran the i64 base and multiplied the double's bits. A captured `*f64` keeps its pointee rung (6.7.15's D11 (a)).
fn _ic_cap(S, noff, ptr): i64 {
    var esl = _cl_cap_esl(S, noff);
    var t = _cl_snap_type(esl);
    if (_cl_snap_ptrp(esl) == 0) { if (t < 0) { if (t > 0 - 2048) { return 0 - t; } } }
    if (_cl_snap_ptrp(esl) == 0) { if (t == F64_TYID) { return 0 - 9; } }   # CHANGELOG [6.7.16]
    if (ptr == 0) { return _infer_conc_global(S, noff, 0); }
    if (_cl_snap_ptrp(esl) == 0) { return _infer_conc_global(S, noff, 0); }
    if (t <= 0 - 2048) { return _infer_conc_global(S, noff, 0); }
    if (t < 0) { return 0 - t; }
    return _ic_pscalar(_cl_snap_ptr_word(esl));
}
# `&name` at the cursor through `p: *T`: an inline struct local, a by-value struct parameter or an inline struct
# global binds its struct (`_gsc_addr_of`, the struct carrier's reader); a pointer's `&p` is a `**`, and a tuple,
# a dyn and a capture bind nothing. 6.7.15 (D11): a scalar local or global its scalar (`_ic_ascalar`). i64 through
# `x: T`. CHANGELOG [6.7.14]
fn _ic_addr(S, ptr): i64 {
    if (ptr == 0) { return 0 - 8; }
    var i = GTI(S) + 1;
    if (_gsc_name_end(S, i) == 0) { return 0 - 8; }
    if (_cl_cap_esl(S, TOKVAL(S, i)) >= 0) { return 0 - 8; }   # a capture's copy: not `&l` / `&G`
    var s = _gsc_addr_of(S, TOKVAL(S, i));
    if (s <= 0) { return _ic_ascalar(S, TOKVAL(S, i)); }
    if (_tup_is(S, s) == 1) { return 0 - 8; }
    if (_dyn_is(S, s) == 1) { return 0 - 8; }
    return s;
}
# `&noff` of a scalar (6.7.15, D11 (a)): an i8 / i16 / i32 local, parameter or global its width — a SIGNED narrow one,
# as its load reads it (a local's negative slice-width mark, a global's GVSGN) — an f64 one f64 (marking `_gi_sc`, as
# `_ic_pscalar`); i64 for anything else (an i64 or unsigned or `bool` / `f32` scalar, a pointer — `&p` is a `**` —
# an array or other aggregate, no such name).
fn _ic_ascalar(S, noff): i64 {
    var li = FINDLOCAL(S, noff);
    if (li >= 0) {
        if (GLPTRP(S, li) == 1) { return 0 - 8; }
        if (GLAGG(S, li) == 1) { return 0 - 8; }
        var lt = _load_lt(S, li);
        if (lt == F64_TYID) { return _ic_sc_mark(0 - 9); }
        if (lt == 1 || lt == 2 || lt == 4) { if (GSLICE_W(S, li) < 0) { return _ic_sc_mark(0 - lt); } }
        return 0 - 8;
    }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0 - 8; }
    if (GVSGN(S, vi) >= 0x100) { return 0 - 8; }   # an array
    var gt = GVTYPE(S, vi);
    if (gt == F64_TYID) { return _ic_sc_mark(0 - 9); }
    if (GVPM(S, vi) != 0) { return 0 - 8; }
    if (GVSGN(S, vi) != 1) { return 0 - 8; }
    var gsz = L64(_vars_base + vi * 8);
    if (gsz == 1 || gsz == 2 || gsz == 4) { return _ic_sc_mark(0 - gsz); }
    return 0 - 8;
}
fn _ic_sc_mark(c): i64 {
    _gi_sc = 1;
    return c;
}
# 6.6.10 (bite 7 review): a `pp: *Pt` parameter. The parameter loop skips the `*`, so the slot is
# typed `Pt` like a by-value one and `pp.x` works — but it is a POINTER, and a `var q: *Pt` local
# (not struct-typed at all) infers i64, so `f(pp)` does too. It used to instantiate `f$Pt`.
# 6.6.16 (C7): the `*` is seen before the slot exists, so this only marks the slot to come;
# `_param_record` writes it onto the slot itself. It was a 64-bit mask by slot index, blind at
# slot >= 64, where a pointer then read as a by-value struct and was copied in. CHANGELOG [6.6.16]
fn _mark_ptr_param(S): i64 {
    _cur_fn_ptrp = GFLC(S) + 1;
    # 6.6.17: and its step, sizeof(T), as a mark on the slot the parameter takes next — read only
    # behind the slot's bit 56, which `_param_record` sets (see `_sl_marks`). Cursor on T; an
