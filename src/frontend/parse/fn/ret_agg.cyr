    if (load8(nm + n - 4) != 105) { return 0; }
    if (load8(nm + n - 3) != 109) { return 0; }
    if (load8(nm + n - 2) != 112) { return 0; }
    if (load8(nm + n - 1) != 108) { return 0; }
