fn _ret_tup_err(S, ti, sid, kind): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": cannot return tuple '");
    PRSTR(S + 0xEC00000 + TOKVAL(S, ti));
    PRSTR("' ");
    _sn_pr(S, sid);
    if (kind == 2) { PRSTR(" from an `async fn` - it returns one value"); }
    elif (kind == 3) {
