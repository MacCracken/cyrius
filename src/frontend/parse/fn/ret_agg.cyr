# handle passed by value), so it is zeroed first: the padding is 0, never the frame's old bytes.
# CHANGELOG [6.7.13]
fn _sptr_param_temp(S, li, sid): i64 {
    var t = _agg_temp(S, sid);
    var sz = STRUCTSZ(S, sid - 1);
    if (sz < 8) { EMOVI(S, 0); EFLSTORE(S, t); }
    _agc_copy_bytes(S, t, 0 - 1, _AGC_DREF(li), 0 - 1, sz);
    return t;
