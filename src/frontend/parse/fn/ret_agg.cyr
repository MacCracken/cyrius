        if (GFRS(S, fi) == MULTIRET_SID) { return 0; }   # 6.7.11: refused at its declaration, once
        return _ret_tup_err(S, ti, sid, 2);
    }
    if (GFRS(S, fi) != MULTIRET_SID) { return _ret_tup_err(S, ti, sid, 1); }
    var n = GETFCOUNT(S, sid - 1);
    if (GFRN(S, fi) != n) { return _ret_tup_err(S, ti, sid, 3); }
    var k = 0;
    while (k < n) {
