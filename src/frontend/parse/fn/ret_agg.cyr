        var li = FINDLOCAL(S, noff);
        if (li >= 0) {
            if (GLAGG(S, li) == 0) { return 0 - 1; }
            var lt = GLTYPE(S, li);
            if (lt >= 0) { return 0 - 1; }
            if (_tup_is(S, 0 - lt) == 0) { return 0 - 1; }
            _rtv_sid = 0 - lt;
            return 0 - 2 - li;
        }
        if (_CL_CAP_FIELD_IDX(S, noff) < 0 - 1) { return 0 - 1; }
    }
    var gi = _findvar_core(S, noff);
    if (gi < 0) { return 0 - 1; }
    if (GVPM(S, gi) != 2) { return 0 - 1; }
    if (_tup_is(S, GVTYPE(S, gi)) == 0) { return 0 - 1; }
    _rtv_sid = GVTYPE(S, gi);
