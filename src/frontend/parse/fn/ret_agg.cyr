# ⛔ 6.6.16 (C7) — A PARAMETER ANNOTATED WITH A PLAIN STRUCT IS A VALUE, AT EVERY WIDTH. Over 8 B
# the caller passes the struct's ADDRESS (the ABI above, unchanged), and nothing ever made the copy
# "by value" promises: `fn bump(p: P3) { p.x = p.x + 1; }` wrote the CALLER's struct — a named
# local, a global, a pointer-mode local's heap object, a forwarded parameter, a typed `self: T`
# receiver, a generic instance, a call through `fncall1(&bump, &p)`, and at top level a field
# (`take(BX.v)`). Only a field argument inside a fn was copied (6.6.12, caller-side, so not at top
# level). The copy is made HERE, in the callee's prologue — one site for every caller, fn pointers
# included, built from frontend emitters every backend has: after `_stkp_flush` has homed every
# parameter slot (a Win64 5th+ / SysV 7th+ pointer arrives on the stack) and before the body. Each
# such parameter's struct is copied into an inline frame aggregate (`_sptr_param_temp`), which
# takes the parameter's NAME at the parameter's depth (so a body `var p` is a duplicate exactly
# as before); the pointer slot is renamed -1. From there it is an ordinary inline local: field
# access, `q = r`, `return q`, `&q`, operators and closure captures take their inline paths.
# A `p: *T` parameter is a pointer and is never copied (`_is_ptr_param`); a `#naked` fn has no
# frame; a coroutine impl is re-entered on every resume (and an `async fn` refuses such a
# parameter, `_refuse_async_struct_param`). CHANGELOG [6.6.16]
# 6.6.20: and record which parameters are copied in, exactly, for every call parsed after this
# definition (`_pm_copies`; pass 1 predicted it for the calls before, and a generic INSTANCE, which
# pass 1 never saw, gets it here).
# ⚠ NOT for a REDEFINED fn (flag 2048, pass 1): every call to it reaches its LAST definition
# (`_fn_redirect`), whose copies pass 1 recorded, so the definition in hand is not the callee of a
# call parsed after it. Writing its record here raised a bit for `f(q: P3)` above `f(q: *P3)` (the
# signature check lets the pair through: both address-pass the same struct), and a later tail call
# kept its `jmp` while the `*P3` body held `&s` — a silent wrong value. CHANGELOG [6.6.20]
# 6.7.9: `rf` is the fn the record is written for, -1 for a redefinition (SFBVCP and `_bvhi_*` write
# nothing for it); its copies row past ordinal 61 is replaced whole, as the mask is.
fn _sptr_params_localize(S): i64 {
    var m = 0;
    var rf = _cur_fn_ix;
    if ((GFLG(S, rf) & 2048) != 0) { rf = 0 - 1; }
    _bvhi_reset(rf);
    if (_cur_fn_naked == 0) { if (_pending_coro == 0) { m = _sptr_params_copy(S, rf); } }
    SFBVCP(rf, m);
    return 0;
}
# Each parameter owns exactly ONE named slot (a vector's filler slots are -1), so a parameter's
# ordinal is the number of named slots below it — counted before `_sptr_param_localize1` renames
# the slot. Returns the copied ordinals below 62; one past 61 goes to `rf`'s copies row.
fn _sptr_params_copy(S, rf): i64 {
    var m = 0;
    var ord = 0;
    var li = 0;
    while (li < _cur_fn_pslots) {
        if (L64(S + 0x5D9D000 + li * 8) != 0 - 1) {
            if (_sptr_param_in(S, li) == 1) { m = _bvcp_bit(rf, m, ord); }
            ord = ord + 1;
        }
        li = li + 1;
    }
    return m;
}
# 1 = the parameter in slot `li` is a copy: a by-value struct over 8 B, copied in here, or a Win64
# value-form vector, which the parameter loop's ESTOREPARM_SIMD_WIN64 already copied in.
fn _sptr_param_in(S, li): i64 {
    if (_local_is_sptr_param(S, li) == 1) {
        if (_is_ptr_param(S, li) == 1) { return 0; }
        _sptr_param_localize1(S, li);
        return 1;
    }
    if (_TARGET_PE == 1) { if (GLTYPE(S, li) <= 0 - 2048) { return 1; } }
    return 0;
}
fn _sptr_param_localize1(S, li): i64 {
    var d = GSDEP(S);
    SSDEP(S, 0);
    var t = _sptr_param_temp(S, li, 0 - GLTYPE(S, li));
    SSDEP(S, d);
    S64(S + 0x5D9D000 + t * 8, L64(S + 0x5D9D000 + li * 8));
    SSLICE_W(S, t, 0);
    S64(S + 0x5D9D000 + li * 8, 0 - 1);
    return 0;
}
