# PARSER — the pair checks — the mixed-return warnings (`_warn_mixed_*`), the propagation run on demand
# (_ensure_pair_flags), a call's pair-returning callee (`_pair_callee_at`, `_mco_*`, _callee_returns_pair), and the
# lossy-context refusals (`_refuse_lossy_pair`, `_pair_vwrap`); with `_stmt_resync`.
# ================================================================
# Split from parse/parse.cyr at 6.7.18, unchanged; parse.cyr includes its pieces in source order. CHANGELOG [6.7.18]

# v6.6.0 — MIXED RETURNS IN A PAIR-RETURNING FN. The class that cost 19 silent defects in one
# stdlib during this release's own migration, and the one the compiler is the only thing that can
# see.
#
# ⛔ THE SHAPE. The pre-flip error-propagation idiom is:
#       var res = f();
#       if (is_err_result(res) == 1) { return res; }     # forwards the boxed Err
# Migrated mechanically it becomes `var res_tag, res = f(); if (is_err_result(res_tag) == 1) {
# return res; }` — and `res` is now the PAYLOAD ALONE. The tag is dropped, so the caller receives
# the error VALUE as its tag: measured, a propagated `Err(77)` arrives as tag=77, is_err=0.
# **An error that reads as success** — the v6.5.15 class, one level up, in the one code path whose
# entire job is to refuse. The correct form is `return Err(res);`.
#
# Neither half is a type error: `return res;` and `return Err(res);` are both `return <i64>;`, so
# nothing else in the compiler can distinguish them. What CAN be said is structural: **a fn that
# returns a pair on one path and a single value on another cannot be consumed correctly**, because
# its caller must either destructure (and read garbage on the single-value path) or bind one (and
# be refused). So every plain return in a pair-returning fn is reported.
#
# ⚠ A WARNING, not an error, and deliberately so: mixing was legal before the value form existed
# and the pattern may appear in code that is not a Result at all. It runs once, after parsing, so
# every fn has its final flag — the propagation pass above is order-dependent and a mid-parse
# verdict would be wrong for exactly the forward-reference case that motivated it.
#
# ⛔ READ THE CALLERS BEFORE ACTING ON IT — it reports a SHAPE, and the fix is at the callers as
# much as at the return. vani's `vani_drain` / `vani_drop` / `vani_state` returned `Err(code)` on
# the null guard and the RAW status on the live path, and were kept that way through vani 1.2.7 as
# a supposed false positive (callers `is_ok(f(x))` the guard, sign-test the status). It was a real
# defect: a two-value bind of the live path read the status as the TAG, so a device in state
# SETUP (1) read as Err. vani 1.2.8 returns a Result on every path (CHANGELOG [6.6.12]). Wrapping
# the raw path in `Ok(...)` ALONE had broken three of vani's tests in 1.2.4 because the tests
# pinned the raw value; those rows had to change with it. In yukti it was 19 real defects too.
var _mixed_warned = 0;

# Is the `return IDENT …` at token `t` a whole variant value (returns 0 = not plain) or a
# single value (1 = plain)? A variant value is a call of a pair constructor (fn flag 256),
# a call of a NULLARY stack-variant constructor (flag 512 — the tag IS the whole value),
# or a nullary variant named bare (`return None;` — the same tag, the same rax). Anything
# else — a wrapper, a local, a raw integer — is the dropped-tag class and stays plain.
# 6.6.9: the nullary cases used to be plain, so `return None();` beside `return Some(v);`
# was reported as a dropped tag and told to `return Err(x);`. CHANGELOG [6.6.9]
# 6.6.16: the call is resolved as `_tok_ret_callee` resolves it (`a` = the unit's first token),
# so `return g<i32>(..)` / `return p.m(..)` forwarding a pair is a whole variant, not a dropped
# tag, and the same spellings returning ONE value still warn. A method whose callee the tokens
# cannot resolve is UNKNOWN, and unknown is not plain: the parser may have typed that receiver and
# flagged this fn by it (PARSE_RETURN, `_pair_callee_at`), and the receiver's own NAME looked up as
# a fn — the old fallback — answered "plain" and warned on a wrapper's only return. CHANGELOG [6.6.16]
# 6.7.13: any return value's first token — a whole-call wrap is judged as its call (`_pair_unwrap`),
# anything but a name is plain. CHANGELOG [6.7.13]
fn _ret_is_variant(S, a, t): i64 {
    if (_ret_q_plain(S, t) == 1) { return 1; }   # 6.7.17: `return f(x)?;` is the unwrapped value
    t = _pair_unwrap(S, t);
    if (t < 0) { return 1; }
    if (_pc_mchain(S, t) == 1) { return _riv_chain(S, a, t); }   # 6.7.16: a method chain, any receiver
    if (_icall_open_at(S, t) >= 0) { return _riv_icall(S, a, t); }   # 6.7.17 (D26): `return callptr(&f, ..)`
    if (TOKTYP(S, t) != 2) { return 1; }
    var rf = _tok_ret_callee(S, a, t);
    var nt = 10;
    if (rf < 0) {
        if (_tok_method_open(S, t) == 1) { return 0; }   # 6.7.15: an explicit `x.m<..>(` is resolved above once
        # its receiver is typed (`_mcall_open`); unconfirmed, its shape may be a comparison (`p.n < k >> (j)`)
        rf = FINDFN(S, TOKVAL(S, t));
        nt = TOKTYP(S, t + 1);
    }
    if (rf < 0) { return 1; }
    var fl = GFLG(S, rf);
    if (nt == 10) {
        if ((fl & 256) != 0) { return 0; }
        if ((fl & 512) != 0) { return 0; }
    }
    if (nt == 5) { if ((fl & 512) != 0) { return 0; } }
    return 1;
}
# ⛔ 6.7.17 (met reviewing D26) — `return f(x)?;` RETURNS THE UNWRAPPED VALUE, ONE WORD: 1 = the return value starting
# at token t holds a `?` outside every bracket before its `;` (`return f(x)?;`, `return (f(x))?;`, `return
# callptr(&f, x)?;`, `return f(x)? + 1;`). It was read as forwarding f's pair (the call's flag), so a fn whose `?` makes
# it a pair and whose Ok path returns the unwrapped value — `fn g(): i64 { return f(4)?; }` — built silent and a
# caller's `var t, v = g();` read the value as the TAG (5, 5 where (0, 5) was meant), where `var v = f(4)?; return v;`
# warns, as the guide's `?` section says the every-path rule does. CHANGELOG [6.7.17]
fn _ret_q_plain(S, t): i64 {
    var n = GTCNT(S);
    var d = 0;
    while (t < n) {
        var k = TOKTYP(S, t);
        if (k == 10 || k == 28 || k == 13) { d = d + 1; }
        elif (k == 11 || k == 29 || k == 14) {
            if (d == 0) { return 0; }
            d = d - 1;
        } elif (d == 0) {
            if (k == 5) { return 0; }
            if (k == 124) { return 1; }
        }
        t = t + 1;
    }
    return 0;
}
# 6.7.16 — `return w.p.m(..)`, `return f(..).m(..)`, `return (*pw).m(..)`: the chain's last method as the tokens resolve
# it (`_tok_mch_fn`) — a pair, a nullary variant, else plain; unresolved, a `.m(` is unknown (not plain), and a
# `.m<..>(` may be a comparison (plain), as on a single name. CHANGELOG [6.7.16]
fn _riv_chain(S, a, t): i64 {
    var rf = _tok_mch_fn(S, a, t);
    if (rf < 0) {
        if (TOKTYP(S, _pc_shape(S, t) - 1) == 2) { return 0; }
        return 1;
    }
    var fl = GFLG(S, rf);
    if ((fl & 256) != 0) { return 0; }
    if ((fl & 512) != 0) { return 0; }
    return 1;
}
# 6.7.17 (D26) — `return callptr(&f, ..)` / `return fncallN(&f, ..)`: a whole variant when the known `&f` returns a pair
# or is a nullary variant, as `return f(..)` is; else plain (a callee held in a variable is a word). It was always
# plain, so a forwarder beside `return Ok(..)` drew the dropped-tag warning. CHANGELOG [6.7.17]
fn _riv_icall(S, a, t): i64 {
    var rf = _tok_ic_fi(S, a, t);
    if (rf < 0) { return 1; }
    var fl = GFLG(S, rf);
    if ((fl & 256) != 0) { return 0; }
    if ((fl & 512) != 0) { return 0; }
    return 1;
}

# ⛔ 6.6.16 — A CLOSURE IS A FN FOR THIS RULE. The fn walk below skips a closure body, because
# its returns are not the enclosing fn's (H2). Skipping alone took away the only warning a
# GENUINELY mixed closure had: `|x| { if (x > 0) { return h(x); } return 0; }` built silent, and
# `var t, v = fncall1(g, 0)` on it read a stale rdx — the exact hazard this warning exists for.
# So every closure body is judged as its OWN unit, at any depth (top level, an unflagged fn, a
# nested closure): it is pair-returning when its own body — nested closures and fns skipped,
# each is its own unit — says `return f(..)` or `f(..)?` with f flagged 256 (f spelled `f(`,
# `f<..>(` or `x.f(`), the two things that flag a fn 256 while it is parsed; a plain return there
# is then reported. CHANGELOG [6.6.16]

# Is the call at token t (`f(`, `g<..>(`, `x.m(` — `_tok_ret_callee`, `a` the unit's first token)
# pair-returning (flag 256)? The test PARSE_RETURN and `?`'s `_tpair` apply while parsing
# (`_pair_callee_at`), read here with FINAL flags.
fn _tok_call_is_pair(S, a, t): i64 {
    if (t < 0) { return 0; }
    var rf = _tok_ret_callee(S, a, t);
    if (rf < 0) { return 0; }
    if ((GFLG(S, rf) & 256) == 0) { return 0; }
    return 1;
}

# The `<` opening the type-argument list whose closing `>` / `>>` / `>>>` is token e, or -1.
fn _tok_targs_open(S, e): i64 {
    var d = 0;
    while (e > 0) {
        var t = TOKTYP(S, e);
        if (t == 20) { d = d + 1; }
        elif (t == 39) { d = d + 2; }
        elif (t == 152) { d = d + 3; }
        elif (t == 19) { d = d - 1; if (d <= 0) { return e; } }
        elif (t == 5 || t == 10 || t == 11 || t == 13 || t == 14) { return 0 - 1; }
        e = e - 1;
    }
    return 0 - 1;
}

# 1 = a `(` after a token of type ct opens a wrap, not a call's arguments: ct is neither a name nor
# the `>` / `>>` / `>>>` closing a type-argument list. CHANGELOG [6.7.13]
# 6.7.17 (D26): nor `callptr`, whose known `&f` is a pair asker's callee (`callptr(&f, 4)?`). CHANGELOG [6.7.17]
fn _tok_wrap_open(ct): i64 {
    if (ct == 2 || ct == 20 || ct == 39 || ct == 152) { return 0; }
    if (ct == 137) { return 0; }
    return 1;
}
# Does the `?` at token q consume a pair (`f(..)?`, `g<..>(..)?`, `x.m(..)?` — the callee flagged
# 256)? Walks back to the `(` that matches the `)` before it, then to the call's first token.
# 6.6.16: a method or explicit generic call was never a pair here, as it was not in `_tpair`;
# both now are, so both are here. CHANGELOG [6.6.16]
fn _tok_q_is_pair(S, a, q): i64 {
    if (q < 1) { return 0; }
    if (TOKTYP(S, q - 1) != 11) { return 0; }
    var d = 0;
    var p = q - 1;
    while (p > 0) {
        var t = TOKTYP(S, p);
        if (t == 11) { d = d + 1; }
        elif (t == 10) {
            d = d - 1;
            if (d == 0) {
                var c = p - 1;
                var ct = TOKTYP(S, c);
                if (_tok_wrap_open(ct) == 1) { return _tok_call_is_pair(S, a, p); }   # 6.7.13: `(f(..))?`
                if (ct == 20 || ct == 39 || ct == 152) { c = _tok_targs_open(S, c) - 1; }
                c = _tok_chain_back(S, c);   # 6.7.16: a method chain's head (`w.p.m(..)?`, `f(..).m(..)?`)
                var r = _tok_call_is_pair(S, a, c);
                return r;
            }
        }
        p = p - 1;
    }
    return 0;
}
# ⛔ 6.7.16 — the head of the method chain whose step's name is token c, back over `. name`, `. name(..)` and
# `. name<..>(..)` steps: the name, the call (its name, or `fncallN` / `callptr`) or the parenthesised head before
# the first `.`; c itself when no `.` precedes it. Through 6.7.15 only `x.m(..)?` stepped back to x, so `w.p.m(..)?`
# was judged on `p` as a single name and `f(..).m(..)?` was no method at all. CHANGELOG [6.7.16]
fn _tok_chain_back(S, c): i64 {
    while (c >= 2) {
        if (TOKTYP(S, c - 1) != 41) { return c; }
        var p = c - 2;
        if (TOKTYP(S, p) == 2) { c = p; }
        elif (TOKTYP(S, p) == 11) {
            var h = _tcb_group(S, p);
            if (h < 0) { return c; }
            if (TOKTYP(S, h) == 10) { return h; }   # a parenthesised head
            c = h;
        }
        else { return c; }
    }
    return c;
}
# ... the head of the group whose `)` is token p: a call's name (past its `<..>`), its `fncallN` / `callptr`, or a
# parenthesised head's `(`; -1 when unmatched.
fn _tcb_group(S, p): i64 {
    var op = _tok_open_back(S, p);
    if (op < 1) { return 0 - 1; }
    var ct = TOKTYP(S, op - 1);
    if (ct == 137) { return op - 1; }
    if (_tok_wrap_open(ct) == 1) { return op; }
    if (ct == 2) { return op - 1; }
    var lt = _tok_targs_open(S, op - 1);
    if (lt < 1) { return 0 - 1; }
    return lt - 1;
}

# The mixed-return warning for a CLOSURE, at its plain `return` (token k). `encl` is the name
# offset of the top-level fn whose body holds the closure, or -1 (top level, an impl method).
fn _warn_closure_mixed_at(S, k, encl): i64 {
    _ew("warning:", 8);
    _err_head_at(S, k);
    _ew(": a closure", 11);
    if (encl >= 0) {
        _ew(" in `", 5);
        PRSTR(S + 0xEC00000 + encl);
        _ew("`", 1);
    }
    _ew(" returns a `: stack` pair on another path but a SINGLE value here — the tag is dropped, so the caller reads this value as its TAG. Return a variant of the same enum on this path: `Err(x)` for a Result, `None()` for an Option.\n", 228);
    return 0;
}

# Judge ONE closure body (the `{` at token k) as its own fn; warns at most once, at its first
# plain return. Names in it resolve in the unit starting at token `a` — the top-level fn that
# encloses the closure, whose locals it captures, else k itself. Returns the index of the body's
# closing `}`.
fn _warn_closure_block(S, k, n, encl, a): i64 {
    var e = _tok_skip_block(S, k, n);
    var pair = 0;
    var plain = 0 - 1;
    var j = k + 1;
    while (j < e) {
        var t = TOKTYP(S, j);
        if (t == 13 || t == 32) {                  # a nested closure or (refused) fn — its own unit
            var sk = _skip_nested_body(S, j);
            if (sk >= 0) { j = sk; }
        }
        elif (t == 124) { if (_tok_q_is_pair(S, a, j) == 1) { pair = 1; } }
        elif (t == 33) {
            var nt = TOKTYP(S, j + 1);
            if (_ret_q_plain(S, j + 1) == 1) { if (plain < 0) { plain = j; } }   # 6.7.17: `return f(x)?;`, one value
            elif (_tok_call_is_pair(S, a, j + 1) == 1) { pair = 1; }
            elif (nt != 5) { if (_ret_is_variant(S, a, j + 1) == 1) { if (plain < 0) { plain = j; } } }
        }
        j = j + 1;
    }
    if (pair == 1) { if (plain >= 0) { _warn_closure_mixed_at(S, plain, encl); } }
    return e;
}

fn _warn_mixed_pair_returns(S): i64 {
    if (_mixed_warned == 1) { return 0; }
    _mixed_warned = 1;
    var n = GTCNT(S);
    var d = 0;
    var i = 0;
    var encl = 0 - 1;     # the top-level fn whose body the walk is in (for a closure's message)
    var ea = 0 - 1;       # ...and its `fn` token, where a closure's names resolve (captures)
    while (i < n) {
        var t0 = TOKTYP(S, i);
        if (t0 == 13) {
            # every closure body, at any depth, is its own unit (see `_warn_closure_block`)
            if (_tok_is_closure_body(S, i) == 1) {
                var ca = i;
                if (ea >= 0) { ca = ea; }
                _warn_closure_block(S, i, n, encl, ca);
            }
            d = d + 1;
        }
        elif (t0 == 14) { d = d - 1; if (d == 0) { encl = 0 - 1; ea = 0 - 1; } }
        elif (t0 == 5) { if (d == 0) { encl = 0 - 1; ea = 0 - 1; } }
        elif (t0 == 32) {
            if (d == 0) {
                if (TOKTYP(S, i + 1) == 2) {
                    encl = TOKVAL(S, i + 1);
                    ea = i;
                    _warn_mixed_fn(S, i, n);
                }
            }
        }
        i = i + 1;
    }
    _warn_mixed_impls(S);   # 6.7.15: the impl methods and the trait defaults they inherit
    return 0;
}
# The top-level fn whose `fn` token is i (its name next): judged when it is flagged 256.
fn _warn_mixed_fn(S, i, n): i64 {
    var wfi = FINDFN(S, TOKVAL(S, i + 1));
    if (wfi < 0) { return 0; }
    if ((GFLG(S, wfi) & 256) == 0) { return 0; }
    var j = i + 2;
    var lim = i + 512;
    while (j < n) {
        if (TOKTYP(S, j) == 13) { break; }
        if (TOKTYP(S, j) == 5) { break; }
        if (j > lim) { break; }
        j = j + 1;
    }
    if (j >= n) { return 0; }
    if (TOKTYP(S, j) != 13) { return 0; }
    return _warn_mixed_body(S, i, j, TOKVAL(S, i + 1), 0 - 1, 0);
}
# ONE pair-returning fn's body, the `{` at token j, of the unit whose `fn` token is a (names resolve there): the warning
# at its first plain `return`, naming the fn — `nm` (a pool offset), or for an impl method its source name (`fi` >= 0,
# `_fn_src_name`: `Pt.qm`, never the mangled `Pt_qm`; written at print time, after the token resolvers' scratch) — or,
# `tn` nonzero, a trait default an impl inherits: `tn` (the trait's name) '.' `nm` (the member's), `Dv.qd`, the code's
# home, never the first inheriting impl's `Pt.qd` (CHANGELOG [6.7.16]). A closure body is its own unit, judged by the
# outer walk; a refused nested fn is skipped. 1 = warned.
fn _warn_mixed_body(S, a, j, nm, fi, tn): i64 {
    var n = GTCNT(S);
    var bd = 0;
    var k = j;
    while (k < n) {
        var t = TOKTYP(S, k);
        if (t == 13) {
            # a closure body — its own unit, judged by the outer walk
            var sk = _skip_nested_body(S, k);
            if (sk >= 0) { k = sk; } else { bd = bd + 1; }
        }
        elif (t == 14) {
            bd = bd - 1;
            if (bd == 0) { return 0; }
        }
        elif (t == 32) { k = _skip_nested_body(S, k); }   # a refused nested fn (see `_pair_prescan`)
        elif (t == 33) {
            if (TOKTYP(S, k + 1) != 5) {
                if (_ret_is_variant(S, a, k + 1) == 1) { _warn_mixed_at(S, k, nm, fi, tn); return 1; }
            }
        }
        k = k + 1;
    }
    return 0;
}
fn _warn_mixed_at(S, k, nm, fi, tn): i64 {
    _ew("warning:", 8);
    _err_head_at(S, k);
    _ew(": `", 3);
    if (tn != 0) {
        PRSTR(S + 0xEC00000 + tn);
        _ew(".", 1);
    } elif (fi >= 0) { nm = _fn_src_name(S, fi, L64(_fnt_names + fi * 8)); }
    PRSTR(S + 0xEC00000 + nm);
    _ew("` returns a `: stack` pair on another path but a SINGLE value here — the tag is dropped, so the caller reads this value as its TAG. Return a variant of the same enum on this path: `Err(x)` for a Result, `None()` for an Option.\n", 229);
    return 0;
}
# ⛔ 6.7.15 — AN impl METHOD AND AN INHERITED TRAIT DEFAULT ARE JUDGED TOO. The walk above takes depth-0 `fn` tokens only,
# so `impl Pt { fn qm(self) { if (self.x > 0) { return Ok(self.x); } return 5; } }` — flagged 256 by
# `_pair_prescan_impls` — built silent and `var t, v = p.qm();` read 5 as the TAG (50), where the same body as a free fn
# warns; a default inherited from `trait Dv { fn qd(self) { .. } }` the same. Each impl's methods (`_impl_method_entry`,
# read only — never REGFN, the axis-13 rule) and each default it inherits are judged as a top-level fn is, an untyped
# `self` typed as the impl's struct (`_pbs_iself`, as `_pair_scan_method` does). A default inherited by several impls
# warns once (its `fn` token, `_wmd_seen`). CHANGELOG [6.7.15]
var _wmd_seen = 0;   # the trait defaults' `fn` tokens already warned about, a vec made at the first
fn _warn_mixed_impls(S): i64 {
    var ii = 0;
    while (ii < _ti_n) {
        var k = L64(_ti_tab + ii * 64 + 16);
        var e = k + L64(_ti_tab + ii * 64 + 24);
        while (k < e) {
            _warn_mixed_method(S, ii, L64(_tim_tab + k * 24), L64(_tim_tab + k * 24 + 8), 0);
            k = k + 1;
        }
        _warn_mixed_defaults(S, ii);
        ii = ii + 1;
    }
    return 0;
}
# The trait defaults impl `ii` inherits (those it does not override), as `_pair_scan_defaults` walks them.
fn _warn_mixed_defaults(S, ii): i64 {
    var tx = L64(_ti_tab + ii * 64 + 48);
    if (tx < 0) { return 0; }
    var k = L64(_tr_tab + tx * 32 + 8);
    var e = k + L64(_tr_tab + tx * 32 + 16);
    while (k < e) {
        var dt = L64(_trm_tab + k * 32 + 16);   # the default's `fn` token + 1 (0 = required)
        if (dt != 0) { _warn_mixed_default(S, ii, L64(_trm_tab + k * 32), dt - 1); }
        k = k + 1;
    }
    return 0;
}
fn _warn_mixed_default(S, ii, m, p): i64 {
    if (_tim_of(S, ii, m) >= 0) { return 0; }   # overridden: the impl's own method, judged above
    if (_wmd_seen_at(p) == 1) { return 0; }
    if (_warn_mixed_method(S, ii, m, p, L64(_ti_tab + ii * 64)) == 0) { return 0; }   # named as the trait's (6.7.16)
    if (_wmd_seen == 0) { _wmd_seen = vec_new(); }
    vec_push(_wmd_seen, p);
    return 0;
}
fn _wmd_seen_at(p): i64 {
    if (_wmd_seen == 0) { return 0; }
    var n = vec_len(_wmd_seen);
    var i = 0;
    while (i < n) {
        if (vec_get(_wmd_seen, i) == p) { return 1; }
        i = i + 1;
    }
    return 0;
}
# Impl `ii`'s method `m`, defined at `fn` token p: judged when its entry is flagged 256. 1 = warned. `tn` nonzero: p is
# the default of the trait named `tn`, which the warning names.
fn _warn_mixed_method(S, ii, m, p, tn): i64 {
    var fi = _impl_method_entry(S, ii, m, p);
    if (fi < 0) { return 0; }
    if ((GFLG(S, fi) & 256) == 0) { return 0; }
    var o = _tr_paren(S, p);
    if (o < 0) { return 0; }
    var j = _tok_body_open(S, _call_close(S, o) + 1);
    if (j < 0) { return 0; }
    _pbs_iself = 0;
    var isf = GFISELF(S, fi);
    if (isf > 0) { _pbs_iself = FINDSTRUCT(S, isf - 1); }
    var r = _warn_mixed_body(S, p, j, m, fi, tn);
    _pbs_iself = 0;
    return r;
}

# Run the propagation once, on first demand. Cheap on every call after the first.
fn _ensure_pair_flags(S): i64 {
    if (_pair_prescan_done == 1) { return 0; }
    _pair_prescan_done = 1;
    _pair_prescan(S);
    return 0;
}

# ⛔ 6.6.16 — THE ONE CALLEE RESOLVER FOR "DOES THIS CALL RETURN A PAIR". Every asker — `?`'s
# `_tpair`, the lossy-bind refusals (`var v = ..`, `x = ..`, store8/16/32/64), PARSE_RETURN's
# wrapper flag, the destructure — recognised only `name(`, so the explicit generic `g<i32>(..)`
# and the method `p.m(..)` (its `T_m`) fell through all of them: `var v = g<i32>(n, d)?;` and
# `var v = p.m(d)?;` took the BOXED `?` lowering and dereferenced the tag (rc 139), `var v =
# g<i32>(..);` / `x = p.m(..);` / `store64(&s, g<i32>(..))` kept the tag and dropped the payload
# in silence, `var a, b = g<i32>(..);` was "multi-value destructure needs a call", and `p.m(..)?;`
# was "expected ';'". The fn index of the call at token ti, or -1:
#   - `name(` / a resolvable `name<..>(` (`_gcall_open`): FINDFN's entry — the generic TEMPLATE,
#     the flag source the 6.6.12 statement form (`_stmt_explicit_generic`) reads;
#   - `x.m(` on a single name typed as a struct (`_recv_sid`, PARSE_FIELD_LOAD's order): `T_m`.
#     BUILD_METHOD_NAME writes only uncommitted scratch at GNPOS, so the peek is safe — the real
#     call path does the same.
#   - 6.7.16: a method ending a chain on any receiver the method arm takes (`_mcall_open`'s chain arm) —
#     `w.p.m(`, `f(..).m(`, `(*pw).m(`, `p.gp().m(` — its method.
# ⛔ 6.6.17 (a7): a GENERIC's call answers for the INSTANCE it reaches (`_pair_gen_inst`), not the
# template — `fn w<T>(p: T, d) { return p.div(d); }` is a pair at T = Pt (`Pt_div` returns Ok/Err)
# and one value at T = Qt, and the template, whose flag no single answer fits, left `w(p, d)?` on
# the boxed lowering (rc 139). CHANGELOG [6.6.17]
fn _pair_callee_at(S, ti): i64 {
    var o = _mcall_open(S, ti, 0 - 1);   # 6.7.15: `x.m<..>(` too, at its explicit instance
    if (o >= 0) { if (_mco_ch == 1) { return _mco_inst(S, _mco_mf, _mco_mt, o); } }   # 6.7.16: a chain's last method
    if (_gcall_open(S, ti) >= 0) {
        var fi = _pair_gen_inst(S, ti);
        return fi;
    }
    if (o < 0) { return 0 - 1; }
    var sid = _recv_sid(S, TOKVAL(S, ti));
    if (sid <= 0) { return 0 - 1; }
    var mf = _meth_fn_at(S, sid, TOKVAL(S, ti + 2), ti + 2);
    if (o != ti + 3) { mf = _mcall_xquiet(S, mf, ti + 3); }
    return mf;
}
# ⛔ 6.7.17 (D26, the user's decision, 2026-10-22) — A KNOWN `&f` CALLEE'S PAIR IS THE DIRECT CALL'S: `callptr(&f, 4)`
# and `fncall1(&f, 4)` with f returning a `: stack` pair answered no callee, so `callptr(&f, 4)?` took the boxed `?`
# and dereferenced the tag (SIGSEGV) and `var v = callptr(&f, 4);` kept the tag in silence, where `f(4)` propagates and
# is refused "bind both". The fn every pair asker judges at token ti (`_callee_returns_pair_at`): through fncallN /
# callptr, the `&f` the call reaches (`_hl_ic_fi`; -1 for a callee held in a variable, a word) — unless a method chain
# continues on its result, whose last method `_pair_callee_at` answers; else `_pair_callee_at`'s. Not in
# `_pair_callee_at` itself: its other askers (the destructure's count and f64 typing, `_dt_call_fn`) keep an
# indirect call's callee unknown. CHANGELOG [6.7.17]
fn _pair_call_fn(S, ti): i64 {
    if (_icall_open_at(S, ti) >= 0) { if (_mcall_open(S, ti, 0 - 1) < 0) { return _hl_ic_fi(S, ti); } }
    return _pair_callee_at(S, ti);
}
# The fn the call at token ti reaches (`_gen_resolve_call`: a generic's instance, instantiating it if
# needed, so its body — parsed with T bound — has set its own pair flag; else FINDFN's entry). A
# lookahead: the refusal state that resolver leaves for an emitting path is put back.
fn _pair_gen_inst(S, ti): i64 {
    var se = _grc_err;
    var sf = _grc_fi;
    var fi = _gen_resolve_call(S, ti);
    _grc_err = se;
    _grc_fi = sf;
    return fi;
}
# `IDENT . IDENT (` at token ti: a method call on a single name. 1 / 0.
fn _tok_method_open(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (TOKTYP(S, ti + 1) != 41) { return 0; }
    if (TOKTYP(S, ti + 2) != 2) { return 0; }
    if (TOKTYP(S, ti + 3) != 10) { return 0; }
    return 1;
}
# ⛔ 6.7.15 — THE EXPLICIT METHOD SPELLING IN THE `x.m(` LOOKAHEADS. 6.7.14's D7 (a) made `p.m<f64>(h)` call the f64
# instance, but every lookahead that keys a method call on the tokens `x . m (` (`_tok_method_open`, the `(` at
# ti + 3) missed it: `var a, b = p.mm<i64>(3);` was "multi-value destructure needs a call on the right-hand side",
# `var v = p.rs<i64>(3)?;` took the boxed `?` and SIGSEGV'd, `var v = p.rs<i64>(3);` kept a pair's tag in silence.
# The `(` of a method call on the single name at token t: `x.m(` (t + 3), or `x.m<..>(` when x's struct has no field
# m and a generic method m (`_mtargs_at`, the method arm's own test), so `p.n < a > (b)` stays a comparison. x is
# typed as its asker types it: by the parser's scope (`a` < 0, `_recv_sid`), or from the tokens of the unit
# starting at token a (`_tok_name_sid`; an impl's untyped `self`, `_tok_iself`). -1 otherwise. CHANGELOG [6.7.15]
# ⛔ 6.7.16 — AND A METHOD ENDING A CHAIN ON ANY RECEIVER THE METHOD ARM TAKES: a field chain `w.p.m(..)` (`w.q.m(..)`
# through a `*P` field, `h.w.p.m(..)`, `pw.p.m(..)`, `self.p.m(..)`), a method's result `p.gp().m(..)`, a call `f(..).m(..)`
# / `fncallN(&f, ..).m(..)`, a parenthesised head `(*pw).m(..)` — `_mch_open`, the vector receive's recogniser since
# 6.7.15, from the tokens of the unit at `a` when `a` >= 0 (`_mch_tok`). Every asker keyed a method call on `x . m (`
# with x one name, so `var c, d = w.p.m2();` was "multi-value destructure needs a call on the right-hand side",
# `var v = w.p.rs(3)?;` took the boxed `?` (SIGSEGV), `var v = w.p.rs(3);` kept a pair's tag in silence, `var t: (i64,
# i64) = w.p.m2();` was "not a tuple" (issues/2026-10-20-multi-value-method-on-field-chain-receiver-refused-as-destructure-
# source.md). `_mco_mt` is the answer's method name token (t + 2 on a single name) and, for a chain (`_mco_ch` 1), `_mco_rs`
# its receiver's struct and `_mco_mf` its fn — an explicit `.m<..>(` its template, as the single-name arm resolves no
# instance either, nor at any step before it (`_mch_mres`) (`_mco_inst` does, for an asker that wants it: a lookahead in
# the declaration zone's pass 1, `_gzf_elem`, must instantiate nothing — a `GW.p.mm<f64>(2.5)` instance minted there SIGSEGV'd the program under CYRIUS_COVERAGE=1):
# an asker reads them right after the call. CHANGELOG [6.7.16]
var _mco_mt = 0;
var _mco_rs = 0;
var _mco_mf = 0 - 1;
var _mco_ch = 0;
fn _mcall_open(S, t, a): i64 {
    _mco_ch = 0;
    _mco_mt = t + 2;
    if (_tok_method_open(S, t) == 1) { return _mco_one(S, t, a, t + 3); }
    if (_tok_mx_shape(S, t) == 0) { return _mco_chain(S, t, a); }
    if (t > 0) { if (TOKTYP(S, t - 1) == 41) { return 0 - 1; } }   # `a.x.m<..>(`: not a single name
    var sid = 0;
    if (a < 0) { sid = _recv_sid(S, TOKVAL(S, t)); }
    else {
        sid = _tok_name_sid(S, a, t, TOKVAL(S, t));
        if (sid == 0) { sid = _tok_iself(S, a, t); }
    }
    if (_mtargs_at(S, sid, t + 2) == 0) { return _mco_chain(S, t, a); }
    return _mco_one(S, t, a, _tok_targs_close(S, t + 4) + 1);
}
# The single name's call `(` at o — unless a chain continues past its `)` to a method (`p.gp().m(..)`): that one's.
fn _mco_one(S, t, a, o): i64 {
    if (_mchain_at(S, _call_close(S, o) + 1) == 0) { return o; }
    var x = _mco_chain(S, t, a);
    if (x >= 0) { return x; }
    return o;
}
# The chain arm: `_mch_open` at t (the parser's scope, or with `a` >= 0 the unit's tokens), `_mco_*` set from its
# answer; the vector receive's `_vmc_*` are put back (a lookahead). -1: no chain ending in a method.
var _mch_tok = 0;   # 1 = `_mch_open` types from the tokens of the unit starting at `_mch_ta` (a token pass)
var _mch_ta = 0;
# The method `mf` named at token mt, its call's `(` at o: an explicit `.m<..>(`'s instance (`_mcall_xquiet`), else mf.
fn _mco_inst(S, mf, mt, o): i64 {
    if (o == mt + 1) { return mf; }
    return _mcall_xquiet(S, mf, mt + 1);
}
fn _mco_chain(S, t, a): i64 {
    if (_mco_hgate(S, t) == 0) { return 0 - 1; }
    var m0 = _vmc_mf;
    var t0 = _vmc_mt;
    var r0 = _vmc_rs;
    var sk = _mch_tok;
    var sa = _mch_ta;
    _mch_tok = 0;
    if (a >= 0) {
        _mch_tok = 1;
        _mch_ta = a;
    }
    var o = _mch_open(S, t);
    _mch_tok = sk;
    _mch_ta = sa;
    if (o >= 0) {
        _mco_ch = 1;
        _mco_mt = _vmc_mt;
        _mco_rs = _vmc_rs;
        _mco_mf = _vmc_mf;
    }
    _vmc_mf = m0;
    _vmc_mt = t0;
    _vmc_rs = r0;
    return o;
}
# 1 = token t may head a method chain (a cheap test, before `_mch_open` scans to the head's end): a name and `.`; a call
# whose callee may return a struct or a `*S` (a generic, a struct result, a `: *S` fn, `fncallN`); `callptr`; a `(`.
fn _mco_hgate(S, t): i64 {
    var tt = TOKTYP(S, t);
    if (tt == 10) { return 1; }
    if (tt == 137) { return 1; }
    if (tt != 2) { return 0; }
    var nt = TOKTYP(S, t + 1);
    if (nt == 41) { return 1; }
    if (nt != 10) { if (nt != 19) { return 0; } }
    var fi = FINDFN(S, TOKVAL(S, t));
    if (fi < 0) { return 0; }
    if (GFTP(S, fi) != 0) { return 1; }
    if (_hl_fn_psid(fi) > 0) { return 1; }
    var rs = GFRS(S, fi);
    if (rs > 0) { if (rs < 2048) { return 1; } }
    return _IS_FNCALL_NAME(S, TOKVAL(S, t));
}
# 1 = the value at token t is a method chain ending in a call (`_pc_shape`) other than a single name's one call
# `x.m(` / `x.m<..>(` (whose arms stay the single-name ones). Tokens only.
fn _pc_mchain(S, t): i64 {
    var o = _pc_shape(S, t);
    if (o < 0) { return 0; }
    if (TOKTYP(S, t) != 2) { return 1; }
    if (TOKTYP(S, t + 1) != 41) { return 1; }
    if (o == t + 3) { return 0; }
    if (TOKTYP(S, t + 3) == 19) { if (o == _tok_targs_close(S, t + 4) + 1) { return 0; } }
    return 1;
}
# The method ending the chain at token t, resolved from the tokens of the unit starting at token a (the token passes:
# the pair flags' propagation, the mixed-return warning) — its template for an explicit `.m<..>(`, as on a single
# name; -1 when unresolved.
fn _tok_mch_fn(S, a, t): i64 {
    var o = _mcall_open(S, t, a);
    if (o < 0) { return 0 - 1; }
    if (_mco_ch == 0) { return 0 - 1; }
    return _mco_mf;
}
# 1 = the tokens at t are `x . m < .. > (` — a method call's explicit spelling, or a comparison: by its shape alone.
fn _tok_mx_shape(S, t): i64 {
    if (TOKTYP(S, t) != 2) { return 0; }
    if (TOKTYP(S, t + 1) != 41) { return 0; }
    if (TOKTYP(S, t + 2) != 2) { return 0; }
    if (TOKTYP(S, t + 3) != 19) { return 0; }
    var e = _tok_targs_close(S, t + 4);
    if (e < 0) { return 0; }
    if (TOKTYP(S, e + 1) != 10) { return 0; }
    return 1;
}
# The struct id of a method call's single-name receiver, resolved in PARSE_FIELD_LOAD's order: a
# local decides by itself, then a closure's capture of a struct, then a global (`_diag_name_sid`:
# GVTYPE where GVPM marks a struct, else an inferred global's GVDSID). 0 when untyped.
fn _recv_sid(S, noff): i64 {
    if (GINFN(S) == 1) {
        if (FINDLOCAL(S, noff) < 0) {
            if (_CL_CAP_FIELD_IDX(S, noff) < 0 - 1) { return _cap_fld_sid; }
        }
    }
    var r = _diag_name_sid(S, noff);
    return r;
}
fn _callee_returns_pair_at(S, ti): i64 {
    ti = _pair_unwrap(S, ti);
    if (ti < 0) { return 0; }
    var _cra = _pair_call_fn(S, ti);   # 6.7.17 (D26): `callptr(&f, ..)` / `fncallN(&f, ..)` too
    if (_cra < 0) { return 0; }
    _ensure_pair_flags(S);
    if ((GFLG(S, _cra) & 256) == 0) { return 0; }
    return 1;
}
# v6.6.0 — does a `?` immediately follow the call whose `(` is at token index `ti`? Scans the
# balanced parens and looks at the token after the closing one.
# ⛔ WITHOUT THIS, `var v = f()?;` is refused by the single-bind check below: the callee IS
# pair-returning, but `?` CONSUMES the pair — it propagates the Err half out of the enclosing
# function and yields the payload alone, so exactly one value reaches the binding. Refusing it
# would make the propagation operator unusable on the very type it exists for.
# 6.7.16: a method chain's `?` follows its last call (`f(..).m(..)?`, `(*pw).m(..)?`), not its head's `)`.
fn _call_is_propagated(S, ti): i64 {
    var co = _pc_shape(S, ti);
    if (co >= 0) {
        if (TOKTYP(S, _call_close(S, co) + 1) == 124) { return 1; }
        return 0;
    }
    var _d = 0;
    var _i = ti;
    var _g = 0;
    while (_g < 4096) {
        var _t = TOKTYP(S, _i);
        if (_t == 12) { return 0; }                 # EOF
        if (_t == 10) { _d = _d + 1; }
        elif (_t == 11) {
            _d = _d - 1;
            if (_d == 0) { if (TOKTYP(S, _i + 1) == 124) { return 1; } return 0; }
        }
        _i = _i + 1;
        _g = _g + 1;
    }
    return 0;
}

# v6.6.0 — THE LOSSY-CONTEXT REFUSAL, at the cursor. v6.5.67 closed exactly ONE lossy shape,
# `var x = f();`, and that was enough while `: stack` was an opt-in nobody used. Flipping
# Result/Option/Either to the value form makes every OTHER single-value context live across the
# whole ecosystem, and two of them compiled clean and dropped the payload in silence:
#
#     x = f();                 # assignment to an existing variable
#     store64(&slot, f());     # storing a Result into a slot (an array of Results is this shape)
#
# Both are the v6.5.67 defect wearing a different statement, and `store64` is the one that
# matters most: it is how every "collection of Results" is written, and the payload it drops is
# the error code. Refused here rather than in a helper, for the same reason the bind-site check
# is: `_callee_returns_pair` also feeds `_tpair`, which is what tells `?` it holds a pair.
# ⭐ ANTI-VACUOUS BY CONSTRUCTION: the flag tested is set only on `: stack` constructors, so a
# BOXED Result — still the documented idiom at thousands of sites — is untouched.
# ⛔ 6.7.7 (B4 T5b; the user's decision, 2026-10-09) — and at the other one-slot stores, which
# compiled clean and kept the tag: a field (`h.n = f();`, any field type, a slice's `.len`, the
# --syntax-only tail), an element (`a[i] = f();`), `*p = f();` and every compound `x += f();`
# (`_asg_compound_op`: a field's, an element's, `*p`'s, a for step's; a u128 place's in
# `_w128_binop`). Each call sits right before its PCMPE, where the term's own pair lookahead runs
# (a generic callee is instantiated there, inline: earlier would move its bytes). CHANGELOG [6.7.7]
# 6.7.13: the `?` is looked for from the value's first token — a wrap's `(` scans to the `)` that
# closes it, so `x = (f(7))?;` propagates (from `f` the scan stopped at the inner `)`). CHANGELOG [6.7.13]
# 6.7.14 (D46): a wrap around the whole value is transparent too — the inside is judged (`_pair_vwrap`).
fn _refuse_lossy_pair(S): i64 {
    var vi = _pair_vwrap(S, GTI(S));
    if (vi < 0) { vi = GTI(S); }
    if (_callee_returns_pair_at(S, vi) == 0) { return 0; }
    if (_call_is_propagated(S, vi) == 1) { return 0; }
    return _pair_refuse_in_sync(S);
}
# ⛔ 6.7.14 (D46, the user's decision, 2026-10-16) — PARENTHESES AROUND THE WHOLE VALUE ARE TRANSPARENT TO
# THE FIRST-CALL RULE (6.7.7: a store is judged by the call it starts with). `var v = (f(7) + 1);`,
# `h.a = (f(7) + 1);` and `x = (f(7) * 2);` kept the tag in silence where `var v = f(7) + 1;` is refused
# "bind both": 6.7.13's D19 A peeled a wrap around the call ALONE (`_pair_unwrap`). The value at token
# `st`: when q parentheses wrap all of it — the outermost closing right before what ends a value (`;`,
# `)`, `,` or `}`), no tuple literal — and the inside starts with a call, alone or in parentheses around
# it alone (`((f(7)) + 1)`), the inside's first token, which the refusal asks about (`?` scanned from
# there: `(f(7)? + 1)` propagates); else -1: `(3 + f(7))` starts with no call (the operand rule, the
# tag kept as `3 + f(7)` keeps it), `(f(7) + 1) * 2` is no whole wrap. The call by its shape, as
# `_pair_unwrap` reads it. Linear: the call's close, the run of `)` after it, one `_call_close` from
# the innermost whole wrap (the outer ones close in the run after it). Asked at the refusal sites
# only — never in `_callee_returns_pair_at`, which also feeds `_tpair`. CHANGELOG [6.7.14]
# 6.7.16: the call may end a method chain on any receiver (`_pair_lead_open`), a parenthesised one too (`_pw_lead`).
fn _pair_vwrap(S, st): i64 {
    if (TOKTYP(S, st) != 10) { return 0 - 1; }
    var a = st + _pw_lead(S, st);
    var o = 0 - 1;
    if (TOKTYP(S, a) == 10) { o = _pc_shape(S, a); }
    elif (TOKTYP(S, a) == 2 || TOKTYP(S, a) == 137) { o = _pair_lead_open(S, a); }
    if (o < 0) { return 0 - 1; }
    var e = _call_close(S, o) + 1;
    var m = a - st;
    var r = 0;
    while (r < m) {
        if (TOKTYP(S, e + r) != 11) { break; }
        r = r + 1;
    }
    if (r == m) { return 0 - 1; }   # parentheses around the call alone: 6.7.13's D19 (`_pair_unwrap`)
    return _pair_vwrap_q(S, st, m - r);
}
# ... the q outer parentheses at `st` wrap the whole value: the inside's first token, else -1.
fn _pair_vwrap_q(S, st, q): i64 {
    var x = _call_close(S, st + q - 1);
    if (_pair_unwrap_k(S, x + 1, q - 1, st) < 0) { return 0 - 1; }
    var t = TOKTYP(S, x + q);
    if (t != 5) { if (t != 11) { if (t != 31) { if (t != 14) { return 0 - 1; } } } }
    if (_tup_commas(S, st + q - 1) != 0) { return 0 - 1; }   # a tuple literal, no wrap
    return st + q;
}
# The two refusals' report. It is made IN SYNC — the statement parses on to its own end — so the
# panic latch it sets (silencing what the same statement would add about the same value: a bool
# destination's "not a bool") is the statement's alone: `_pair_sync_ti` records where, and
# PARSE_STMT's resync (`_stmt_resync`) clears it there instead of skipping the NEXT statement, its
# own error and all. 1. CHANGELOG [6.7.11]
var _pair_sync_ti = 0 - 1;
fn _pair_refuse_in_sync(S): i64 {
    if (_panic == 0) { _pair_sync_ti = GTI(S); }
    ERR_MSG(S, "a `: stack` enum returns two values — bind both: `var tag, val = f();`", 72);
    return 1;
}
# The same mark for any other refusal made in sync, called just before it latches (a repeat at the
# token latches silently, so it marks too): the subscript and `*p` refusals that parse their brackets or
# operand on (`_arr_sub_addr`, `_sub_err`, `_psub_err`, `_deref_u128_err`) — `y = pa[0]; y = zz9;` lost
# `zz9`'s error. CHANGELOG [6.7.16]
fn _refuse_in_sync(S): i64 {
    if (_panic == 0) { _pair_sync_ti = GTI(S); }
    return 0;
}
# PARSE_STMT's end with the latch set (the statement's first token `before`): skipped to the next
# recovery point — unless the latch is an in-sync refusal (`_pair_refuse_in_sync`, `_refuse_in_sync`)
# made inside this statement, which ended at its own `;` / `}`: then only the latch is cleared.
fn _stmt_resync(S, before): i64 {
    if (_pair_sync_ti >= before) { if (_pair_sync_ti < GTI(S)) {
            var t = TOKTYP(S, GTI(S) - 1);
            if (t == 5 || t == 14) { _panic = 0; return 0; }
        } }
    _resync_close(S, before);
    _sync_skip(S);
    return 0;
}
# ... first through the `}` of each `{` the statement opened (tokens [before, cursor)) and left unclosed: an error
# stepped it as a stray token (`a = 2 { 3 };`: "expected ';', got '{'"), so its `}` is the statement's, not the
# block's end — taken as the block's end, the rest of the fn parsed at top level ("unexpected ';'", "return outside a
# fn body"). Everything inside is the broken statement's. Not when the statement ended at its own `;`: then the open
# `{` is one a construct reported unclosed (`var p = P { 1, 2;`: "expected '}', got ';'"), and the `}` after is the
# block's. Never past EOF. And only to a `}` on that `{`'s own line or followed by a `;` (`P { 5 };`): a stray `{` with
# no `}` of its own (`a = g(1, {` then `return ..;` and the fn's `}`) matched the fn's end, and the fn after it was
# "defined inside" this one. CHANGELOG [6.7.17]
fn _resync_close(S, before): i64 {
    var d = 0;
    var o = before;   # the outermost `{` left open
    var i = before;
    var c = GTI(S);
    var n = GTCNT(S) - 1;   # the EOF token
    if (c > n) { c = n; }
    if (c > before) { if (TOKTYP(S, c - 1) == 5) { return 0; } }
    while (i < c) {
        var t = TOKTYP(S, i);
        if (t == 13) { if (d == 0) { o = i; } d = d + 1; }
        elif (t == 14) { if (d > 0) { d = d - 1; } }
        i = i + 1;
    }
    while (d > 0 && i < n) {
        var u = TOKTYP(S, i);
        if (u == 13) { d = d + 1; }
        elif (u == 14) { d = d - 1; }
        i = i + 1;
    }
    if (d > 0) { return 0; }
    if (i > c) { if (GTLINE(S, i - 1) == GTLINE(S, o) || TOKTYP(S, i) == 5) { STI(S, i); } }
    return 0;
}

# v6.5.67 — `var v = f();` with `f` returning a `: stack` pair (cursor on the `=`): one variable
# keeps the tag and drops the payload, so it is refused. v6.6.0: unless `?` consumes it — `var v =
# f()?;` binds ONE value by design (the operator propagates the Err half and yields the payload).
# ⚠ The `?` check goes HERE and not inside `_callee_returns_pair_at`: that also feeds `_tpair`, which
# tells `?` it holds a pair at all, and suppressing it there sends `?` down the boxed lowering that
# dereferences the tag as a pointer (measured: immediate SIGSEGV). 6.6.16: scanned from the callee's
# first token, the right start for `f(`, `g<..>(` and `x.m(` alike.
# ⛔ 6.7.6 (Break 1, lane D) — AT TOP LEVEL TOO (the user's decision, 2026-10-08). The check was gated
# on `GINFN == 1`, so a global `var v = mk();` kept the tag and lost the payload silently (`Ok(42)`
# exited 0), in the declaration zone (EMIT_GVAR_INITS' `_gvi_expr`) and after the first statement
# (PARSE_VAR) alike. The fn-body rule and wording, everywhere. CHANGELOG [6.7.6]
# 6.7.14 (D46): `var v = (f(7) + 1);` is judged by its inside, as `var v = f(7) + 1;` (`_pair_vwrap`).
fn _refuse_single_pair_bind(S): i64 {
    if (PEEKT(S) != 4) { return 0; }
    var vi = _pair_vwrap(S, GTI(S) + 1);
    if (vi < 0) { vi = GTI(S) + 1; }
    if (_callee_returns_pair_at(S, vi) == 0) { return 0; }
    if (_call_is_propagated(S, vi) == 1) { return 0; }
    return _pair_refuse_in_sync(S);
}

fn _callee_returns_pair(S): i64 {
    var _crp = _callee_returns_pair_at(S, GTI(S));
    if (_crp == 0) { return 0; }
    # ⚠ NO propagation check here either — this feeds `_tpair` in `_PARSE_TERM_IMPL`, the flag
    # that tells `?` it is holding a pair. Both helpers answer "does this callee return a pair",
    # nothing more; whether a `?` then CONSUMES that pair is the binding site's question, and it
    # is asked there (parse/decl.cyr). Putting it in either helper silently routes `?` into the
    # boxed lowering, which dereferences the tag as a pointer.
    return 1;
}
