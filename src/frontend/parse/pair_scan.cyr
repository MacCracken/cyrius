# PARSER — the pair prescan — which fns return a `(tag, payload)` pair, resolved forward over the token stream before
# the fns are parsed (`_pair_prescan`, `_pair_*`, the token-pass resolvers `_tok_*` / `_tsp_*`, `_tpl_*`) — and the
# token skips it shares.
# ================================================================
# Split from parse/parse.cyr at 6.7.18, unchanged; parse.cyr includes its pieces in source order. CHANGELOG [6.7.18]

# v6.5.67 — does the cursor sit on a call to a PAIR-RETURNING fn (fn flag 256)?
#
# A `: stack` enum constructor hands back (tag, payload) in two registers. Binding that to one
# variable keeps the tag and silently drops the payload; v6.5.55 shipped the representation with
# nothing recording which calls produce a pair, so every lossy context was silent data loss.
#
# ⚠ DELIBERATELY LOOKAHEAD, NOT A GLOBAL "last expression was a pair" FLAG. This repo has paid
# for that shape four times — the `_cfo` re-arm bug was declared fixed three times before the
# fourth occurrence turned up in a path nobody had enumerated. A flag set by one emitter and read
# by another has to be cleared correctly on every path; a peek at the cursor cannot go stale.
# Same test at an ARBITRARY token index, for sites whose cursor has not reached the call yet
# (e.g. `var x = f();` where the cursor is on `=`).
# ⚠ NO propagation check here, deliberately. This variant feeds `_tpair` in `_PARSE_TERM_IMPL`,
# which is exactly what tells `?` it is looking at a PAIR and must take the two-register path.
# Suppressing it for a propagated call sends `?` down the BOXED lowering, which dereferences the
# tag as a pointer — measured: an immediate SIGSEGV. The propagation check belongs only in the
# cursor variant below, whose caller is the single-variable bind refusal.
# v6.6.0 — FORWARD-REFERENCE RESOLUTION FOR PAIR-RETURNING CALLEES.
#
# ⛔ WHY THIS EXISTS. Flag 256 ("returns a `(tag, payload)` pair") is set on an enum constructor
# in pass 1, but on an ORDINARY fn only while its own body is parsed — at its `return Ok(x)`.
# So a caller that appears EARLIER IN THE FILE than its callee saw the flag unset, and `?` took
# the BOXED lowering: it dereferenced the tag (0 or 1) as a pointer. Compiled clean, SIGSEGV at
# run time. That is not an exotic shape — it is how every flattened dist bundle is laid out, and
# how ordinary code reads when helpers are defined below their callers.
#
# The fix is one linear propagation pass over the token stream, run lazily on first demand (by
# which time pass 1 has registered every fn and flagged every `: stack` constructor). For each
# `fn NAME (...) { ... }` whose flag is unset, look for `return IDENT (` in its OWN body where
# IDENT is already flagged (since 6.6.16 also `return IDENT<..>(` and the method `return x.m(`,
# `_tok_ret_callee`). Repeat until nothing changes, bounded — a chain of forwarding
# wrappers needs one round per link.
#
# ⚠ CLOSURE BODIES AND NESTED fn BODIES ARE SKIPPED (`_skip_nested_body`). A closure defined
# inside the body has its own `return`, and counting it would flag the OUTER fn as
# pair-returning — over-flagging is worse than under-flagging here, because it routes a non-pair
# call into the two-register receive and reads a garbage rdx. A closure literal (`|x| { .. }`,
# `|| { .. }`) has NO `fn` token, so a skip keyed on `fn` alone booked its `return h(..)` to the
# enclosing fn: a false "bind both" refusal at every single-variable bind of that fn's result, and
# the mixed-return warning aimed at its own plain return. The closure's own pair-ness is
# unaffected — its fn entry is flagged while its body is parsed — and `_warn_mixed_pair_returns`
# judges a closure's returns as its OWN unit (`_warn_closure_block`). A named fn inside a body is
# REFUSED since 6.6.16 (`_refuse_nested_fn`), so no program that compiles has one; skipping it
# stays, as diagnostic hygiene for the refused program — `_warn_mixed_pair_returns` runs at the
# end of a parse that has errors, and without the skip a refused fn's `return h(x)` would put a
# bogus mixed-return warning on the OUTER fn beside the refusal. CHANGELOG [6.6.16]
# ⚠ INVALIDATED whenever a `: stack` constructor is flagged (parse/types/enum.cyr). The prescan is
# demand-driven, and the first demand can arrive BEFORE the enum declaration has been reached —
# measured: the pass ran with a complete 3,498-token stream and flagged nothing, because no
# constructor carried the flag yet for it to propagate FROM. Re-running on each new stack enum
# is cheap (enum declarations are few) and is what makes the propagation order-independent.
var _pair_prescan_done = 0;

# Token-stream skip helpers shared by the two pair scans (`_pair_prescan`,
# `_warn_mixed_pair_returns`). Separate small fns, not inline loops: cybs (the seed-built
# bootstrap compiler) fails SILENTLY on too many references in one fn.
#
# Does the `{` at token k open a CLOSURE body? Call only when TOKTYP(S, k) == 13. Closure grammar
# is `|` IDENT (`,` IDENT)* `|` or `||`, then the body — untyped params, no return annotation
# (parse/expr/factor.cyr, the `typ == 35 || typ == 54` factor arm) — and `{` never begins an expression,
# so a `{` right after `|` (35) or `||` (54) can only be a closure block body, never `a | b` /
# `a || b`. ⚠ If closure params or a return type ever gain annotations, this must scan the param
# list instead. A brace-less closure (`|x| h(x)`) needs no skip: an expression holds no `return`.
fn _tok_is_closure_body(S, k): i64 {
    if (k < 1) { return 0; }
    var p = TOKTYP(S, k - 1);
    if (p == 35) { return 1; }
    if (p == 54) { return 1; }
    return 0;
}

# Index of the `}` that closes the first `{` at or after token k (n when the stream ends first).
fn _tok_skip_block(S, k, n): i64 {
    var d = 0;
    var started = 0;
    while (k < n) {
        var t = TOKTYP(S, k);
        if (t == 13) { d = d + 1; started = 1; }
        if (t == 14) {
            d = d - 1;
            if (d == 0) { if (started == 1) { return k; } }
        }
        k = k + 1;
    }
    return k;
}

# THE one skip of a nested unit, shared by both pair scans and by the nested-fn refusal: the
# index of the LAST token of the unit that starts at token k, or -1 when none starts there.
#   - a `{` that opens a closure body (`_tok_is_closure_body`): that brace's matching `}`;
#   - a `fn` keyword (a nested fn — refused, see `_refuse_nested_fn`; an `async` before it is
#     the caller's to step over): its header runs to the first `{` or `;` at paren depth 0, so
#     a bodiless `fn x(..);` ends at its `;` instead of swallowing the next block, and a body
#     ends at its matching `}`.
# Never past the EOF token (12, the stream's last): a truncated or unbalanced source ends there.
# ⛔ 6.7.17 (D8) — A `fn` BEHIND A `*` IS A FN-POINTER TYPE, NOT A UNIT: k itself. A local's `var c: *fn(i64): i64 =
# pick(x)?;` was stepped to its `;` as a refused nested fn, so the scans never saw the `?` in it — a caller above took
# `b(x)?` as the boxed `?` and dereferenced the tag (rc 139). CHANGELOG [6.7.17]
fn _skip_nested_body(S, k): i64 {
    var n = GTCNT(S);
    var t = TOKTYP(S, k);
    var e = 0 - 1;
    if (t == 13) {
        if (_tok_is_closure_body(S, k) == 1) { e = _tok_skip_block(S, k, n); }
    } elif (t == 32) {
        if (_tn_fnptr_kw(S, k) == 1) { return k; }
        e = n;
        var pd = 0;
        var j = k + 1;
        while (j < n) {
            var u = TOKTYP(S, j);
            if (u == 12) { e = j; j = n; }
            elif (u == 10) { pd = pd + 1; }
            elif (u == 11) { pd = pd - 1; }
            elif (pd == 0 && u == 5) { e = j; j = n; }
            elif (pd == 0 && u == 13) { e = _tok_skip_block(S, j, n); j = n; }
            j = j + 1;
        }
    }
    if (e >= n) { e = n - 1; }
    return e;
}

# ⛔ 6.6.16 — THE CALL A TOKEN PASS SEES, for the pair question. The pair scans run on the token
# stream before (prescan) or after (warnings) the fns are parsed, so no local is registered for
# them: a callee is resolved from the tokens alone, in the three spellings the parser's own
# `_pair_callee_at` resolves — `name(`, `name<..>(` and the method `x.m(`. They recognised only
# `name(`, so a wrapper `return g<i32>(..)` / `return p.m(..)` defined after its caller was never
# flagged pair-returning (`w(..)?` then dereferenced the tag: rc 139), and `return g<i32>(..)`
# beside `return Ok(5)` was reported as a dropped tag.
# ⚠ THE TOKEN ANSWER MUST BE THE PARSER'S ANSWER, OR -1. A wrong fn is worse than none. The first
# cut typed a receiver from its lexically LAST `name: T` declaration, so (measured):
#   - `var p: Qt; if (c) { var p: Pt; } return p.div(d);` resolved `Pt_div` for a `Qt` receiver:
#     the wrapper was flagged pair-returning and a plain `var v = w(..);` of it was REFUSED;
#   - `var p = Pt { .. }` / `var p = mk(n)` (PARSE_VAR types both) read as untyped, so a forward
#     wrapper `return p.div(d)` was never flagged (`w(..)?` rc 139, `var v = w(..);` dropped the
#     payload in silence) and the wrapper, flagged once parsed, drew a false mixed-return warning.
# So the receiver is found BY SCOPE and typed as the parser types it (`_tok_name_sid`: an
# annotation, a `*T` param, an initializer, a generic's bound `: T`), a name typed by nothing a
# token pass can see falls back to the one `T_m` every struct agrees on
# (`_tok_method_any`), and -1 means unknown to every reader: a missed flag, never a false one, and
# never a warning (`_ret_is_variant`). CHANGELOG [6.6.16]
#
# The `(` of `name(` or `name<..>(` at token ti, else -1.
# 6.7.13 (D19 A, the user's decision, 2026-10-15) — PARENTHESES AROUND A WHOLE PAIR CALL ARE
# TRANSPARENT to every pair check, as around a whole struct source (6.7.6, `_pwrap_k`): the first
# token inside the wrap at token ti when one call — `f(`, `g<..>(` or `x.m(` (by shape: its callee is
# the asker's to resolve) — closes right before the innermost `)`; ti itself when ti opens no wrap;
# -1 otherwise (`(a) + b`, a tuple, a call that is only part of the inside). The parser's asker
# (`_callee_returns_pair_at`) and the token passes' (`_tok_ret_callee`, `_ret_is_variant`,
# `_tok_q_is_pair`) both start here, so they agree: `(f(7))?` took the BOXED `?` (SIGSEGV), `var v =
# (f(7));`, `x = (f(7));`, `h.a = (f(7));`, `P { (f(7)), 3 }` kept the tag in silence, and `return
# (f(x));` forwarded a pair no check knew of. Reads tokens only. CHANGELOG [6.7.13]
# ⚠ LINEAR in the wrap's depth: the inside is one call, so the k `(` before it match the k `)` right
# after its close — read those, not each level's close (`_pwrap_k` scans every level to its `)`,
# quadratic, and the parser asks at every level: `return ((..((1))..));` 16384 deep ran for minutes
# before the 256-level nesting bound refused it, recursion_depth_bounded.sh). CHANGELOG [6.7.13]
fn _pair_unwrap(S, ti): i64 {
    if (TOKTYP(S, ti) != 10) { return ti; }
    var h = _pw_head(S, ti);   # 6.7.16: a parenthesised method-chain head, inside any wrap
    if (h >= 0) { return _pw_hchain(S, ti, h); }
    var a = ti;
    while (TOKTYP(S, a) == 10) { a = a + 1; }
    if (TOKTYP(S, a) != 2) { if (TOKTYP(S, a) != 137) { return 0 - 1; } }   # 6.7.16: a `callptr(..)` head's chain
    var o = _pair_lead_open(S, a);
    if (o < 0) { return 0 - 1; }
    return _pair_unwrap_k(S, _call_close(S, o) + 1, a - ti, a);
}
# The `(` of the call a value starting at the name (or `callptr`) at token a starts with, by its shape: the last call
# of a method chain on any receiver (`_pc_shape`: `x.m(`, `x.m<..>(` (6.7.15), 6.7.16 `w.p.m(`, `f(..).m(`), else
# `name(` / `name<..>(` — its callee the asker's to resolve (a comparison `p.n < a > (b)` resolves to none); else -1.
# 6.7.17 (D26): and `callptr(`, whose known `&f` the askers now resolve — `(callptr(&f, 4))?`. CHANGELOG [6.7.17]
fn _pair_lead_open(S, a): i64 {
    var o = _pc_shape(S, a);
    if (o >= 0) { return o; }
    if (TOKTYP(S, a) == 137) { return _icall_open_at(S, a); }
    if (TOKTYP(S, a) != 2) { return 0 - 1; }
    return _pair_ret_open(S, a);
}
# ⛔ 6.7.16 — A METHOD CHAIN BY ITS SHAPE: the `(` of the call ending the chain headed at token h — a name, a call
# (`f(..)`, `g<..>(..)`, `fncallN(..)`, `callptr(..)`) or a parenthesised head (`_mch_hend`), then `.name` steps, each a
# field or a call `.m(..)` / `.m<..>(..)` (`_mchain_targs`) — when its last step is a call; else -1 (no step, or a
# field ends it). Tokens only: the callee is the asker's to resolve. CHANGELOG [6.7.16]
fn _pc_shape(S, h): i64 {
    var i = _mch_hend(S, h);
    var o = 0 - 1;
    while (_mchain_at(S, i) == 1) {
        var k = _mchain_targs(S, i + 2);
        if (TOKTYP(S, k) == 10) {
            o = k;
            i = _call_close(S, k) + 1;
        } else {
            o = 0 - 1;
            i = i + 2;
        }
    }
    return o;
}
# ⛔ 6.7.16 — A PARENTHESISED RECEIVER HEADS A METHOD CHAIN, it wraps no call: `(*pw).m(..)`, `(w).p.m(..)`, and inside
# a wrap `((*pw).m(..))`. The outermost of the `(` leading the value at token ti (0 = ti itself) whose `)` a `.name`
# step follows, else -1. One pass to ti's own `)`: a leading `(` closes the first time the depth falls to its level.
# CHANGELOG [6.7.16]
fn _pw_head(S, ti): i64 {
    var k = 0;
    while (TOKTYP(S, ti + k) == 10) { k = k + 1; }
    var d = k;
    var low = k;
    var i = ti + k;
    var h = 0 - 1;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 10) { d = d + 1; }
        elif (t == 11) {
            d = d - 1;
            if (d < low) {
                low = d;
                if (_mchain_at(S, i + 1) == 1) { h = d; }
                if (d == 0) { return h; }
            }
        }
        elif (t == 12) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
# ... the chain headed at token ti + h inside the h `(` before it: its head when its last call closes right before
# their h `)`, else -1.
fn _pw_hchain(S, ti, h): i64 {
    var o = _pc_shape(S, ti + h);
    if (o < 0) { return 0 - 1; }
    return _pair_unwrap_k(S, _call_close(S, o) + 1, h, ti + h);
}
# The wrapping `(` before the value at token st: up to a parenthesised chain head (`_pw_head`), else all of them.
fn _pw_lead(S, st): i64 {
    if (TOKTYP(S, st) != 10) { return 0; }
    var h = _pw_head(S, st);
    if (h >= 0) { return h; }
    var k = 0;
    while (TOKTYP(S, st + k) == 10) { k = k + 1; }
    return k;
}
# `a` when the k tokens from e are each `)` (inside the token stream), else -1.
fn _pair_unwrap_k(S, e, k, a): i64 {
    var j = 0;
    while (j < k) {
        if (e + j >= GTCNT(S)) { return 0 - 1; }
        if (TOKTYP(S, e + j) != 11) { return 0 - 1; }
        j = j + 1;
    }
    return a;
}
fn _pair_ret_open(S, ti): i64 {
    var nt = TOKTYP(S, ti + 1);
    if (nt == 10) { return ti + 1; }
    if (nt != 19) { return 0 - 1; }
    var e = _tok_targs_close(S, ti + 2);
    if (e < 0) { return 0 - 1; }
    if (TOKTYP(S, e + 1) != 10) { return 0 - 1; }
    return e + 1;
}
# The `>` (or the `>>` / `>>>` tail) closing the type-argument list that starts at token i, just
# past its `<`, or -1. The arguments are not resolved (none are bound this early), so the list is
# bounded by shape instead: it must close before any `;` `(` `)` `{` `}` or EOF — `return n < m;`
# must not reach a `> (` in a later statement.
fn _tok_targs_close(S, i): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 5 || t == 10 || t == 11 || t == 12 || t == 13 || t == 14) { return 0 - 1; }
        if (t == 19) { d = d + 1; }
        elif (t == 20) { d = d - 1; }
        elif (t == 39) { d = d - 2; }
        elif (t == 152) { d = d - 3; }
        if (d <= 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# The struct id the name `noff` holds at token k, in the top-level unit that starts at token a (its
# `fn` keyword; a closure's own `{` when no top-level fn encloses it). Found BY SCOPE, walking back
# from k: a block closed before k (its `}` .. `{`) is stepped over whole, so no declaration inside
# it is seen, and a closure body k sits in is left for the fn around it, whose locals it
# captures — PARSE_FIELD_LOAD's order, local then capture. The first declaration reached decides
# (`_tok_decl_sid`); with none, the global's (`_glob_name_sid`, `_recv_sid`'s global arm). 0 when
# untyped. (A closure's own params are untyped, so a receiver among them never compiles.)
fn _tok_name_sid(S, a, k, noff): i64 {
    var i = _tok_name_decl(S, a, k, noff);
    if (i >= 0) { return _tok_decl_sid(S, a, i, _tok_hdr_end(S, a, k)); }
    var g = _glob_name_sid(S, noff);
    return g;
}
# The token of the declaration that name reaches at token k (the walk above), or -1 (a global, or
# none). 6.7.8: split out of `_tok_name_sid` for the struct carrier's annotation (`_tok_sc_name`).
# 6.7.18: THE LAST WALK IS REUSED. The scans call this for each use of a name in turn (`_gs_sval_big` once per
# T-typed store), and each walk went back over the unit, so a body of N uses of one name cost O(N^2): a generic fn
# of 2,000 `var vK: T = x;` 489 ms, 4,000 1,866 ms. A walk from k that reaches the last walk's start (its use
# token, `_tnd_k`) with no block left open (cd 0) and no declaration found is in the state that walk began in —
# the same unit, name and header end, tokens unchanged — so it ends where that one did. Only the tokens since
# that use are read. (tests/gates/frontend/hot_path_call_counts.sh row D.) CHANGELOG [6.7.18]
var _tnd_a = 0 - 1;   # the last walk: its unit start, name, header end, use token, answer, token count
var _tnd_noff = 0;
var _tnd_b = 0;
var _tnd_k = 0;
var _tnd_d = 0;
var _tnd_tc = 0 - 1;
fn _tok_name_decl(S, a, k, noff): i64 {
    var b = _tok_hdr_end(S, a, k);
    var stop = a;   # the walk's floor (exclusive), or the last walk's start when it can be reused
    var reuse = 0;
    if (a == _tnd_a && noff == _tnd_noff && b == _tnd_b && k >= _tnd_k && GTCNT(S) == _tnd_tc) {
        if (_tnd_k - 1 > a) { stop = _tnd_k - 1; reuse = 1; }
    }
    var cd = 0;
    var i = k - 1;
    var r = 0 - 1;
    var done = 0;
    while (done == 0) {
        if (i <= stop) {
            if (reuse == 1) {
                if (cd == 0) { r = _tnd_d; done = 1; }
                else { stop = a; reuse = 0; }   # a block left open here: the rest is walked as before
            }
            if (i <= a) { done = 1; }
        }
        if (done == 0) {
            var t = TOKTYP(S, i);
            if (t == 14) { cd = cd + 1; }
            elif (t == 13) { if (cd > 0) { cd = cd - 1; } }
            elif (cd == 0) {
                if (t == 2) {
                    if (STREQ(S, TOKVAL(S, i), noff) == 1) {
                        if (_tok_is_decl(S, i, b) == 1) { r = i; done = 1; }
                    }
                }
            }
            i = i - 1;
        }
    }
    _tnd_a = a;
    _tnd_noff = noff;
    _tnd_b = b;
    _tnd_k = k;
    _tnd_d = r;
    _tnd_tc = GTCNT(S);
    return r;
}
# The unit's body `{` (its params lie before it), or k when none precedes k.
fn _tok_hdr_end(S, a, k): i64 {
    var b = a;
    while (b < k) { if (TOKTYP(S, b) == 13) { break; } b = b + 1; }
    return b;
}
# What the name at token i is declared as: a struct id, 0 when untyped, -1 when the name there is not
# a declaration. A declaration is `var NAME`, or a param `(NAME` / `, NAME` in the header (before
# the body `{` at token b). A `: T` annotation types it — for a param also `: *T`, whose `*` the
# parameter loop skips (`_mark_ptr_param`); a `var p: *T` local is a plain pointer — and an untyped
# `var` takes its initializer's struct (`_tok_init_sid`). `a` is the unit's first token. 6.7.15:
# `_tds_ptr` 1 when the annotation is a pointer (`: *T`, a local's or a param's), for `_tok_ta_decl`.
var _tds_ptr = 0;
fn _tok_decl_sid(S, a, i, b): i64 {
    _tds_ptr = 0;
    if (_tok_is_decl(S, i, b) == 0) { return 0 - 1; }
    var pt = TOKTYP(S, i - 1);
    var r = 0;
    var nt = TOKTYP(S, i + 1);
    if (nt == 49) {
        var at = i + 2;
        if (TOKTYP(S, at) == 8) { _tds_ptr = 1; }
        if (pt != 3) { if (TOKTYP(S, at) == 8) { at = at + 1; } }
        if (TOKTYP(S, at) == 2) { r = FINDSTRUCT(S, TOKVAL(S, at)); }
    }
    elif (pt == 3) { if (nt == 4) { r = _tok_init_sid(S, a, i, i + 2); } }
    return r;
}
# 1 = the name at token i declares: `var NAME`, or a param `(NAME` / `, NAME` in the header (before
# the body `{` at token b).
fn _tok_is_decl(S, i, b): i64 {
    var pt = TOKTYP(S, i - 1);
    if (pt == 3) { return 1; }
    if (i < b) { if (pt == 10 || pt == 31) { return 1; } }
    return 0;
}
# The struct an untyped `var x = ..` (its name at token i) takes from the initializer at token j, as
# PARSE_VAR infers it (`_lit_head`, `_var_rhs_call`): a literal `Name {` / `Name<..> {` (a generic
# struct's methods are its base's), or a call `f(..)` / `g<..>(..)`, not `f(..).field`, whose fn
# declares a struct return (GFRS) — for a generic's `: T`, the struct T is bound to at this call
# (`_tok_gen_ret_sid`). 0 otherwise.
fn _tok_init_sid(S, a, i, j): i64 {
    if (TOKTYP(S, j) != 2) { return 0; }
    var e = j;
    if (TOKTYP(S, j + 1) == 19) { e = _tok_targs_close(S, j + 2); }
    if (e < 0) { return 0; }
    var nt = TOKTYP(S, e + 1);
    var r = 0;
    if (nt == 13) { r = FINDSTRUCT(S, TOKVAL(S, j)); }
    elif (nt == 10) {
        if (TOKTYP(S, _call_close(S, e + 1) + 1) == 41) { return 0; }   # `f(..).field`: the field's value
        var fi = FINDFN(S, TOKVAL(S, j));
