# ... a call `f(..)` at token at to a fn declared `: *S`: S, else 0. ⛔ 6.7.16 — a GENERIC callee declared `: *U` (U one
# of its type parameters) answers what U binds at this call (`_tok_gen_tp_dep`), as the parser types the call by the
# instance it reaches (`_ic_call_rs`): `var r = gd(gpi(&GP0)); r.pick(t)` in a generic answered 0, and the generic's
# i64 base was refused naming the stub method `P.pick`. CHANGELOG [6.7.16]
fn _tok_ta_pcall(S, a, i, at): i64 {
    var fi = FINDFN(S, TOKVAL(S, at));
    if (fi < 0) { return 0; }
    if (GFTP(S, fi) != 0) { return _tok_ta_gpcall(S, a, i, at, fi); }
    if (TOKTYP(S, at + 1) != 10) { return 0; }
    if (_fn_rpsid == 0) { return 0; }
    return L64(_fn_rpsid + fi * 8);
}
fn _tok_ta_gpcall(S, a, i, at, fi): i64 {
    var k = _tok_ret_ann(S, fi);
    if (k < 0) { return 0; }
    if (TOKTYP(S, k) != 8) { return 0; }
    var w = _tok_tp_which(S, fi, k + 1);
    if (w < 0) { return 0; }
    return _tok_gen_tp_dep(S, a, i, at, fi, w);
}
# 1 = the call `name(..)` / `name<..>(..)` at token at is the whole argument (a `,` or `)` follows it).
fn _tok_call_whole(S, at): i64 {
    var o = _pair_ret_open(S, at);
    if (o < 0) { return 0; }
    return _call_is_whole_arg(S, o - 1);
}
# 6.7.8 — the same when T is carried by a generic struct parameter (`_gs_carrier`, field
# f), answered as the parser infers it (`_gen_infer_sc`) but from the tokens: no fn-local instance
# exists yet when the pair scans run, so a name is read from its DECLARATION's annotation (`b: G<..,
# X, ..>` or `b: *G<..>`, X a plain struct name; `_tok_sc_ann`), a global or a whole call from its
# instance, `&name` as name — for either carrier (6.7.9: the by-value one too, as `_gsc_arg`). 6.7.11:
# inside a whole-argument wrap, and `*name` of a `: *G<..>` name (`_tok_sc_deref`), as `_gsc_arg`.
# Anything else answers 0 — a missed flag, never a false one.
fn _tok_gen_sc_sid(S, a, i, j, fi, f): i64 {
    if ((f & 255) == 0) { return 0; }
    var at = _call_arg_for(S, fi, j + 1, (f & 255) - 1);
    if (at < 0) { return 0; }
    var g = _gsc_g(S, fi, (f >> 10) & 1023);
    if (g <= 0) { return 0; }
    if (((f >> 9) & 1) == 1) { return _tok_sc_pp(S, a, i, at, g, f, _gsc_stars(S, fi, (f >> 10) & 1023)); }
    return _tok_sc_arg(S, a, i, at, g, f);
}
# ⛔ 6.7.16 — a `**G<..>` carrier (bit 9, `_gs_pparam`): the X in its slot of the G<X> the whole argument points through
# to with `d` stars (`_tok_pp_arg`) — an annotation walked (`_tok_ann_walk`), an instance read (`_tsp_conc`), as the
# parser binds it (`_gen_infer_sc` -> `_ic_pp_arg`). CHANGELOG [6.7.16]
fn _tok_sc_pp(S, a, i, at, g, f, d): i64 {
    var v = _tok_pp_arg(S, a, i, at, d);
    var r = 0;
    if (v > 0) { r = _tsp_conc(S, v, g, f); }
    if (v < 0) { r = _tok_ann_walk(S, 0 - v - 1, g, f); }
    if (r <= 0) { return 0; }
    if (GSTP(S, r - 1) != 0) { return 0; }
    return r;
}
# ... the X the whole argument at token at holds in the slot of G (the generic struct g) — as
# `_gsc_arg` reads it.
fn _tok_sc_arg(S, a, i, at, g, f): i64 {
    var ta = a;
    if (ta < 0) { ta = 0; }
    var cv = _acv_bind(S, at, ta, 2);   # 6.7.17 (D2): a field / method chain on any head, as `_gsc_arg` reads it
    if (_acv_is == 1) { return _tok_sc_cv(S, cv, g, f); }
    at = _pwrap_in(S, at);   # 6.7.11: `gw((w))`, as `_gsc_wrap`
    if (at < 0) { return 0; }
    if (TOKTYP(S, at) == 8) { return _tok_sc_deref(S, a, i, at + 1, g, f); }   # 6.7.11: `gw(*wp)`
    if (TOKTYP(S, at) == 27) {
        at = at + 1;
        if (TOKTYP(S, at + 1) == 10) { return 0; }   # `&f(..)`
        if (TOKTYP(S, at + 1) == 19) { return 0; }   # `&f<..>(..)` (6.7.11: the call arm takes `<`)
        f = f | (1 << 20);
    }
    if (TOKTYP(S, at) != 2) { return 0; }
    var nt = TOKTYP(S, at + 1);
    var r = 0;
    if (nt == 31 || nt == 11) { r = _tok_sc_name(S, a, i, at, g, f); }
    elif (nt == 10 || nt == 19) { if (_tok_call_whole(S, at) == 1) { r = _tok_sc_call(S, a, i, at, g, f); } }
    if (r > 0) { if (GSTP(S, r - 1) == 0) { return r; } }
    return 0;
}
# ... the X in G's slot of the struct `cv` a chain holds or points at (`_acv_bind`), else 0. CHANGELOG [6.7.17]
fn _tok_sc_cv(S, cv, g, f): i64 {
    if (cv <= 0) { return 0; }
    if (cv >= 2048) { return 0; }
    var r = _tsp_conc(S, cv, g, f);
    if (r <= 0) { return 0; }
    if (GSTP(S, r - 1) != 0) { return 0; }
    return r;
}
# ⛔ 6.7.11 — a whole call `f(..)` / `f<..>(..)` (token at): the X in T's slot of the instance it returns,
# as `_gsc_call` binds it. A GENERIC callee is read through its own type parameters: declared `: G<..,
# U, ..>` with U in that slot, what U binds at this call (`_tok_gen_tp_sid`: `unbox(mk1(p))`,
# `unbox(mk1<Pt>(p))`); declared `: U` with U carried by a `U` parameter, the X of the argument there
# (`unbox(idb(b))`). The parser now calls `unbox$Pt` in each, so a `?` above a wrapper typed through it
# needs its pair. U carried through a struct (`unbox(unbox(bb))`, a G<G<X>>) is read by PATH: see
# `_tsp_push`.
fn _tok_sc_call(S, a, i, at, g, f): i64 {
    var slot = (f >> 8) & 1;
    var r = _tsp_conc(S, _tok_init_sid(S, a, i, at), g, f);
    if (r != 0) { return r; }
    var fi = FINDFN(S, TOKVAL(S, at));
    if (fi < 0) { return 0; }
    if (GFTP(S, fi) == 0) { return 0; }
    var w = _gen_ret_targ_tp(S, fi, g, slot);
    if (w >= 0) { return _tok_sc_tpq(S, a, i, at, fi, w, f >> 32); }
    return _tok_sc_fwd(S, a, i, at, fi, g, f);
}
fn _tok_sc_fwd(S, a, i, at, fi, g, f): i64 {
    var w = _gen_ret_tp(S, fi);
    if (w < 0) { return 0; }
    return _tok_tp_byarg(S, a, i, _pair_ret_open(S, at), fi, w, g, f);
}
# ⛔ 6.7.11 — THE PAIR SCANS READ A TYPE BY PATH. `_gsc_call` binds T through a generic call's INSTANCE
# at any depth: `unbox(unbox(bb))` (`bb: Box<Box<Pt>>`) and `unbox(unbox(mk1(mk1(p))))` call `unbox$Pt`.
# A token answer is ONE struct id, so the X two carriers down — a `Box<Pt>` whose own X is wanted — named
# nothing, the scan answered 0, and a `?` above a wrapper typed through it took the boxed lowering:
# rc 139 (the review's repro). So the question carries the steps still to take after the current one:
# `f`'s bits 32+ are the head of a chain of (G, slot) steps, each a word in `_tsp` (G in bits 0-15, the
# slot bit 16, the next step's head from bit 20; heads are 1-based, 0 ends the chain). A callee that
# returns `: U` with U carried by a struct parameter (`_tok_sc_carry`) pushes the current step and asks
# that argument one level deeper; a callee declared `: G<.., U, ..>` consumes one (`_tok_sc_tpq`); an
# annotation (`_tok_sc_ann`, an explicit `<..>`: `_tok_ann_walk`) walks the rest through its tokens, an
# instance through `_sinst` (`_tsp_conc`). Pushes are popped by the frame that made them, so a live
# chain is never overwritten, and a fresh question (`_tok_init_sid`) starts with none. A full stack
# answers 0 — a missed flag, never a false one. CHANGELOG [6.7.11]
var _tsp = 0;
var _tsp_n = 0;
fn _tsp_push(g, slot, next): i64 {
    if (_tsp == 0) { _tsp = alloc(256 * 8); }
    if (_tsp_n >= 256) { return 0; }
    S64(_tsp + _tsp_n * 8, g + (slot << 16) + (next << 20));
    _tsp_n = _tsp_n + 1;
    return _tsp_n;
}
fn _tsp_pop(): i64 {
    _tsp_n = _tsp_n - 1;
    return 0;
}
fn _tsp_ent(h): i64 { return L64(_tsp + (h - 1) * 8); }
# The type argument in slot (g, f) of the struct instance c, then each step of f's chain in turn: 0
# when one is not an instance of its G.
fn _tsp_conc(S, c, g, f): i64 {
    var r = _sinst_conc(S, c, g, (f >> 8) & 1);
    var h = f >> 32;
    while (h > 0) {
        var e = _tsp_ent(h);
        r = _sinst_conc(S, r, e & 0xFFFF, (e >> 16) & 1);
        h = e >> 20;
    }
    return r;
}
# The token where the chain at head h ends, walking the type written from token k (each step's
# `G<..>` must be there), or -1.
fn _tsp_walk(S, k, h): i64 {
    while (h > 0) {
        var e = _tsp_ent(h);
        if (TOKTYP(S, k) != 2) { return 0 - 1; }
        if (FINDSTRUCT(S, TOKVAL(S, k)) != (e & 0xFFFF)) { return 0 - 1; }
        if (TOKTYP(S, k + 1) != 19) { return 0 - 1; }
        k = _tok_targ_at(S, k + 2, (e >> 16) & 1);
        if (k < 0) { return 0 - 1; }
        h = e >> 20;
    }
    return k;
}
# The first token of type argument `slot` (0 / 1) of the list whose first argument starts at token k
# (just past its `<`), or -1. An argument may nest `<..>`, closed by `>`, `>>` or `>>>`.
fn _tok_targ_at(S, k, slot): i64 {
    if (slot == 0) { return k; }
    var n = GTCNT(S);
    var d = 0;
    while (k < n) {
        var t = TOKTYP(S, k);
        if (t == 5 || t == 10 || t == 11 || t == 12 || t == 13 || t == 14) { return 0 - 1; }
        if (t == 19) { d = d + 1; }
        elif (t == 20) { d = d - 1; }
        elif (t == 39) { d = d - 2; }
        elif (t == 152) { d = d - 3; }
        elif (t == 31) { if (d == 0) { return k + 1; } }
        if (d < 0) { return 0 - 1; }
        k = k + 1;
    }
    return 0 - 1;
}
# The struct the plain type name at token k names (a closer or `,` after it), else 0.
fn _tok_plain_sid(S, k): i64 {
    if (TOKTYP(S, k) != 2) { return 0; }
    var kt = TOKTYP(S, k + 1);
    if (kt != 20 && kt != 31 && kt != 39 && kt != 152) { return 0; }   # a plain name, not `Pair<..>`
    return FINDSTRUCT(S, TOKVAL(S, k));
}
# The X at (g, f) and f's chain in the type written from token k (an explicit type argument).
fn _tok_ann_walk(S, k, g, f): i64 {
    if (TOKTYP(S, k) != 2) { return 0; }
    if (FINDSTRUCT(S, TOKVAL(S, k)) != g) { return 0; }
    if (TOKTYP(S, k + 1) != 19) { return 0; }
    k = _tok_targ_at(S, k + 2, (f >> 8) & 1);
    if (k < 0) { return 0; }
    k = _tsp_walk(S, k, f >> 32);
    if (k < 0) { return 0; }
    return _tok_plain_sid(S, k);
}
# A callee declared `: G<.., U, ..>` matched the current step: what U binds at the call at token at, or
# with steps left (head h), the X they reach in it — U's explicit `<..>` argument walked, else the
# argument carrying U.
fn _tok_sc_tpq(S, a, i, at, fi, w, h): i64 {
    if (h == 0) { return _tok_gen_tp_sid(S, a, i, at, fi, w); }
    var e = _tsp_ent(h);
    var f = (((e >> 16) & 1) << 8) | ((e >> 20) << 32);
    if (TOKTYP(S, at + 1) == 19) {
        var k = _tok_targ_at(S, at + 2, w);
        if (k < 0) { return 0; }
        return _tok_ann_walk(S, k, e & 0xFFFF, f);
    }
    return _tok_tp_byarg(S, a, i, at + 1, fi, w, e & 0xFFFF, f);
}
# The X at (g, f) in what type parameter w of fi binds at the call whose `(` is token o: through the
# argument in w's by-value position, or through its struct carrier (`_tok_sc_carry`).
fn _tok_tp_byarg(S, a, i, o, fi, w, g, f): i64 {
    var m = GFGM(S, fi);
    var pk = w + 1;
    if ((m & 4) != 0) { pk = (m >> (8 + w * 8)) & 255; }
    if (pk == 0) { return _tok_sc_carry(S, a, i, o, fi, (m >> (24 + w * 20)) & 0xFFFFF, g, f); }
    var arg = _call_arg_for(S, fi, o, pk - 1);
    if (arg < 0) { return 0; }
    return _tok_sc_arg(S, a, i, arg, g, f);
}
# U rides fi's struct carrier `b: G'<.., U, ..>` (carrier code fc, as `_tok_gen_sc_sid` reads it): the
# X at (g, f) in U is the X at (G', slot') and then (g, f) in b's argument — the current step pushed.
fn _tok_sc_carry(S, a, i, o, fi, fc, g, f): i64 {
    if ((fc & 255) == 0) { return 0; }
    var at = _call_arg_for(S, fi, o, (fc & 255) - 1);
    if (at < 0) { return 0; }
    var g2 = _gsc_g(S, fi, (fc >> 10) & 1023);
    if (g2 <= 0) { return 0; }
    var h = _tsp_push(g, (f >> 8) & 1, f >> 32);
    if (h == 0) { return 0; }
    var r = 0;
    if (((fc >> 9) & 1) == 1) { r = _tok_sc_pp(S, a, i, at, g2, fc | (h << 32), _gsc_stars(S, fi, (fc >> 10) & 1023)); }   # 6.7.16
    else { r = _tok_sc_arg(S, a, i, at, g2, fc | (h << 32)); }
    _tsp_pop();
    return r;
}
# Which type parameter (0 / 1) of the generic fi sits as the WHOLE type argument in `slot` of its
# `: G<..>` return, G the generic struct g, or -1 (another return, or a nested / concrete argument).
fn _gen_ret_targ_tp(S, fi, g, slot): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0 - 1; }
    var c = _tok_close_paren(S, o);
    if (c < 0) { return 0 - 1; }
    if (TOKTYP(S, c + 1) != 49) { return 0 - 1; }
    if (TOKTYP(S, c + 2) != 2) { return 0 - 1; }
    if (FINDSTRUCT(S, TOKVAL(S, c + 2)) != g) { return 0 - 1; }
    if (TOKTYP(S, c + 3) != 19) { return 0 - 1; }
    var k = c + 4;
    if (slot == 1) { if (TOKTYP(S, k + 1) != 31) { return 0 - 1; } k = k + 2; }
    if (TOKTYP(S, k) != 2) { return 0 - 1; }
    var kt = TOKTYP(S, k + 1);
    if (kt != 20 && kt != 31 && kt != 39 && kt != 152) { return 0 - 1; }
    var rn = TOKVAL(S, k) + 1;
    var tp = GFTP(S, fi);
    if ((tp & 0xFFFFFFFF) == rn) { return 0; }
    if (((tp >> 32) & 0xFFFFFFFF) == rn) { return 1; }
    return 0 - 1;
}
# 6.7.11 — `*name` (token `at` on the name) as a whole argument: the X of its declaration's `: *G<..,
# X, ..>` annotation, as `_gsc_deref` binds T through the pointer's pointee. A value's `*b`, a global, a
# call or a chain answers 0 — a missed flag, never a false one. CHANGELOG [6.7.11]
fn _tok_sc_deref(S, a, i, at, g, f): i64 {
    if (_gsc_name_end(S, at) == 0) { return 0; }
    var d = _tok_name_decl(S, a, i, TOKVAL(S, at));
    if (d < 0) { return 0; }
    if (TOKTYP(S, d + 1) != 49) { return 0; }
    if (TOKTYP(S, d + 2) != 8) { return 0; }
    var r = _tok_sc_ann(S, d, g, f);
    if (r <= 0) { return 0; }
    if (GSTP(S, r - 1) != 0) { return 0; }
    return r;
}
# The name at token at (scope as `_tok_name_sid`, from the declaration being typed at token i): a
# local or parameter by its annotation, an untyped `var b = f(..)` by its initializer's instance, a
# global by its instance.
fn _tok_sc_name(S, a, i, at, g, f): i64 {
    var d = _tok_name_decl(S, a, i, TOKVAL(S, at));
    if (d < 0) { return _tsp_conc(S, _glob_name_sid(S, TOKVAL(S, at)), g, f); }
    if (TOKTYP(S, d + 1) == 4) {
        if (TOKTYP(S, d - 1) != 3) { return 0; }
        var r = _tsp_conc(S, _tok_init_sid(S, a, d, d + 2), g, f);
        if (r != 0) { return r; }
        return _tok_sc_init(S, a, d, d + 2, g, f);
    }
    return _tok_sc_ann(S, d, g, f);
}
# 6.7.11 — an untyped `var b = f(..);` whose callee is generic (`var bb = mk1(mk1(p));`): PARSE_VAR
# types b by the instance the call reaches, so the X is read through the call as an argument's is.
fn _tok_sc_init(S, a, d, j, g, f): i64 {
    if (TOKTYP(S, j) != 2) { return 0; }
    var o = _pair_ret_open(S, j);
    if (o < 0) { return 0; }
    if (TOKTYP(S, _call_close(S, o) + 1) != 5) { return 0; }   # the whole initializer
    return _tok_sc_call(S, a, d, j, g, f);
}
# The type argument in T's slot of the annotation after the declared name at token d, when it is a
# plain struct name and the annotation names G: `b: G<.., X, ..>`, or `*G<..>` not reached through
# `&` (bit 20: `&bp` is a `**`) — or, with steps left in f's chain, the X they reach in that argument
# (`b: Box<Box<Pt>>`, 6.7.11). 0 otherwise.
fn _tok_sc_ann(S, d, g, f): i64 {
    if (TOKTYP(S, d + 1) != 49) { return 0; }
    var at = d + 2;
    if (TOKTYP(S, at) == 8) {
        if (((f >> 20) & 1) == 1) { return 0; }
        at = at + 1;
    }
    if (TOKTYP(S, at) != 2) { return 0; }
    if (FINDSTRUCT(S, TOKVAL(S, at)) != g) { return 0; }
    if (TOKTYP(S, at + 1) != 19) { return 0; }
    var k = at + 2;
    if (((f >> 8) & 1) == 1) { if (TOKTYP(S, k + 1) != 31) { return 0; } k = k + 2; }
    k = _tsp_walk(S, k, f >> 32);
    if (k < 0) { return 0; }
    return _tok_plain_sid(S, k);
}
# A method `x.m(` whose single-name receiver the tokens do not type — a generic fn's `p: T` param,
# bound per instance — still has ONE answer when every struct's `T_m` agrees on the pair flag: the
# receiver's struct, whichever it is, must define `T_m` or the call does not compile. That fn (the
# first), or -1 when no struct defines `_m` or two of them disagree.
fn _tok_method_any(S, mnoff): i64 {
    var sc = GSTC(S);
    var r = 0 - 1;
    var i = 0;
    while (i < sc) {
        var f = FINDFN(S, BUILD_METHOD_NAME(S, i, mnoff));
        if (f >= 0) {
            if (r < 0) { r = f; }
            elif ((GFLG(S, f) & 256) != (GFLG(S, r) & 256)) { return 0 - 1; }
        }
        i = i + 1;
    }
    return r;
}
# The fn the call at token t reaches — `name(`, `name<..>(`, or `x.m(` with x resolved at t in the
# unit starting at token a (`_tok_name_sid`; its `T_m`, else `_tok_method_any`) — or -1.
fn _tok_ret_callee(S, a, t): i64 {
    t = _pair_unwrap(S, t);   # 6.7.13: `return (f(..));` forwards as `return f(..);`
    if (t < 0) { return 0 - 1; }
    if (_pc_mchain(S, t) == 1) { return _tok_mch_fn(S, a, t); }   # 6.7.16: a method chain, any receiver
    if (_icall_open_at(S, t) >= 0) { return _tok_ic_fi(S, a, t); }   # 6.7.17 (D26): `callptr(&f, ..)` and fncallN
    if (TOKTYP(S, t) != 2) { return 0 - 1; }
    var o = _pair_ret_open(S, t);
    if (o >= 0) {
        var fi = FINDFN(S, TOKVAL(S, t));
        if (o > t + 1) { if (fi >= 0) { if (GFTP(S, fi) == 0) { fi = 0 - 1; } } }   # `<` on a generic only
        return fi;
    }
    if (_mcall_open(S, t, a) < 0) { return 0 - 1; }   # 6.7.15: `x.m<..>(` too, its template's flags
    if (t > 0) { if (TOKTYP(S, t - 1) == 41) { return 0 - 1; } }   # `a.x.m(`: not a single name
    var sid = _tok_name_sid(S, a, t, TOKVAL(S, t));
    if (sid == 0) { sid = _tok_iself(S, a, t); }   # 6.7.11
    var mf = 0 - 1;
    if (sid > 0) { mf = _meth_fn_at(S, sid, TOKVAL(S, t + 2), t + 2); }
    else { mf = _tok_method_any(S, TOKVAL(S, t + 2)); }
    return mf;
}
# 6.7.17 (D26) — the fn the call through fncallN / callptr at token t reaches when its callee is `&f` and `f`, in the
# unit starting at token a, is no local, parameter or capture (`_tok_name_decl`, the scope walk) nor a global: the
# parser's `_hl_ic_fi` read from the tokens, for the token passes (a forwarder `return callptr(&f, x);` defined below
# its caller, a `?` on it, the mixed-return warning). -1 for a callee held in a variable. CHANGELOG [6.7.17]
fn _tok_ic_fi(S, a, t): i64 {
    if (a < 0) { return _hl_ic_fi(S, t); }
    var f = _icall_fti(S, t);
    if (f < 0) { return 0 - 1; }
    var noff = TOKVAL(S, f);
    if (_tok_name_decl(S, a, f, noff) >= 0) { return 0 - 1; }
    if (_tok_cl_pname(S, a, f, noff) == 1) { return 0 - 1; }
    if (_findvar_core(S, noff) >= 0) { return 0 - 1; }
    return FINDFN(S, noff);
}
# 1 = the name `noff` at token k is a parameter of a block closure whose body encloses k, in the unit starting at token
# a (`|f| { .. &f .. }`): the scope walk (`_tok_name_decl`) reads a `var` and a fn's parameters, not a closure's, and
# the parser's `&f` is that parameter (`_hl_ic_fi`'s FINDLOCAL).
fn _tok_cl_pname(S, a, k, noff): i64 {
    var d = 0;
    var i = k - 1;
    while (i >= a) {
        var t = TOKTYP(S, i);
        if (t == 14) { d = d + 1; }
        elif (t == 13) {
            if (d > 0) { d = d - 1; }
            elif (_tok_is_closure_body(S, i) == 1) { if (_tok_cl_has(S, i - 1, noff) == 1) { return 1; } }
        }
        i = i - 1;
    }
    return 0;
}
# 1 = the closure parameter list closing at the `|` at token e names `noff` (`|a, f|`; `||` names none).
fn _tok_cl_has(S, e, noff): i64 {
    if (TOKTYP(S, e) != 35) { return 0; }
    var j = e - 1;
    while (TOKTYP(S, j) == 2) {
        if (STREQ(S, TOKVAL(S, j), noff) == 1) { return 1; }
        if (TOKTYP(S, j - 1) != 31) { return 0; }
        j = j - 2;
    }
    return 0;
}

# 6.7.11 — the receiver `self` at token t, in the unit starting at token a, when that unit is the
# impl method `_pair_scan_method` is scanning and `self` is its untyped first parameter: the impl's
# struct (`_pbs_iself`; pass 1's GFISELF — a `*T` since 6.7.0, as `_recv_sid` types it in pass 2).
# Without it `return self.div(d)` fell back to `_tok_method_any`, -1 once another struct also
# defines a `div`. 0 otherwise.
var _pbs_iself = 0;
fn _tok_iself(S, a, t): i64 {
    if (_pbs_iself <= 0) { return 0; }
    if (_noff_is(S, TOKVAL(S, t), "self", 4) == 0) { return 0; }
    var d = _tok_name_decl(S, a, t, TOKVAL(S, t));
    if (d < 0) { return 0; }
    if (TOKTYP(S, d - 1) != 10) { return 0; }   # not the first parameter
    if (TOKTYP(S, d + 1) == 49) { return 0; }   # annotated: `_tok_decl_sid` has answered
    return _pbs_iself;
}

fn _pair_prescan(S): i64 {
    var n = GTCNT(S);
    var round = 0;
    while (round < 6) {
        var changed = 0;
        var d = 0;
        var i = 0;
        while (i < n) {
            var t0 = TOKTYP(S, i);
            if (t0 == 13) { d = d + 1; }
            elif (t0 == 14) { d = d - 1; }
            elif (t0 == 32) {
                # Only TOP-LEVEL definitions. Depth > 0 is a nested/closure fn or an `impl`
                # method (whose registered name is mangled), and registering a bare name for
                # either would mint a spurious fn-table entry.
                if (d == 0) {
                    if (TOKTYP(S, i + 1) == 2) {
                        # ⛔ THIS PASS MUST NEVER REGISTER A FN, and an earlier cut of it did.
                        # `REGFN` here mints a fn-table entry that no definition ever fills in
                        # (a fn defined AFTER a top-level expression statement is registered by a
                        # different path), and the undefined-call check then reports it: bayan's
                        # zero-warning CI gate went red with 17 `undefined function` warnings for
                        # helpers that were defined right there in the file. Measured: 17 with the
                        # REGFN, 0 without, and every axis of the lossy-context gate — including
                        # the forward-reference ones this pass exists for — passes without it.
                        # The registration was never what made forward references work; the
                        # invalidation on each new `: stack` ctor is. Skip what is not registered:
                        # a fn nothing has referenced yet cannot be the subject of a pending query.
                        var pnoff = TOKVAL(S, i + 1);
                        var pfi = FINDFN(S, pnoff);
                        if (pfi >= 0) {
                            if ((GFLG(S, pfi) & 256) == 0) {
                                var j = i + 2;
                                var lim = i + 512;
                                while (j < n) {
                                    if (TOKTYP(S, j) == 13) { break; }
                                    if (TOKTYP(S, j) == 5) { break; }   # `;` — declaration only
                                    if (j > lim) { break; }
                                    j = j + 1;
                                }
                                if (j < n) {
                                    if (TOKTYP(S, j) == 13) {
                                        if (_pair_body_scan(S, i, j) == 1) {
                                            SFLG(S, pfi, GFLG(S, pfi) | 256);
                                            changed = 1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = i + 1;
        }
        if (_pair_prescan_impls(S) == 1) { changed = 1; }   # 6.7.11: the impl methods
        if (changed == 0) { round = 6; } else { round = round + 1; }
    }
    return 0;
}
# ⛔ 6.7.11 — AN impl METHOD IS A DEFINITION THIS PASS VISITS. The walk above looks at depth 0 only,
# so a pair-returning method was flagged only when pass 2 parsed its body: a caller ABOVE its impl
# took `p.div(d)?` as boxed (rc 139 — the tag dereferenced) and `var v = p.div(d);` kept the tag in
# silence, where the impl above it was refused "bind both". Every method `_tr_prepass` recorded is
# resolved to the entry ITS definition owns (`_impl_method_entry`) and scanned as a top-level fn's
# body is, in the same rounds. Returns 1 when a flag was set. CHANGELOG [6.7.11]
fn _pair_prescan_impls(S): i64 {
    var ch = 0;
    var ii = 0;
    while (ii < _ti_n) {
        var k = L64(_ti_tab + ii * 64 + 16);
        var e = k + L64(_ti_tab + ii * 64 + 24);
        while (k < e) {
            if (_pair_scan_method(S, ii, L64(_tim_tab + k * 24), L64(_tim_tab + k * 24 + 8)) == 1) { ch = 1; }
            k = k + 1;
        }
        if (_pair_scan_defaults(S, ii) == 1) { ch = 1; }   # 6.7.13: + the trait defaults it inherits
        ii = ii + 1;
    }
    return ch;
}
# ⛔ 6.7.13 — AN INHERITED TRAIT DEFAULT IS A DEFINITION TOO. A method impl `ii` takes from its trait's
# default body (`trait Dv { fn ddiv(self, d): i64 { .. } }` + `impl Dv for Pt { }`) has no `fn` in the
# impl block: `_tr_defaults` registers it per impl from the trait's `fn` token, so the walk above never
# saw it and a caller above the trait read `p.ddiv(d)?` as boxed (rc 139). Each default the impl does
# not override is scanned as the impl's own method is, under the entry registered for this impl. Read
# only (`_impl_method_entry`, never REGFN — the axis-13 rule). 1 when a flag was set. CHANGELOG [6.7.13]
fn _pair_scan_defaults(S, ii): i64 {
    var tx = L64(_ti_tab + ii * 64 + 48);
    if (tx < 0) { return 0; }
    var ch = 0;
    var k = L64(_tr_tab + tx * 32 + 8);
    var e = k + L64(_tr_tab + tx * 32 + 16);
    while (k < e) {
        var dt = L64(_trm_tab + k * 32 + 16);   # the default's `fn` token + 1 (0 = required)
        var m = L64(_trm_tab + k * 32);
        if (dt != 0) { if (_tim_of(S, ii, m) < 0) {
                if (_pair_scan_method(S, ii, m, dt - 1) == 1) { ch = 1; }
            } }
        k = k + 1;
    }
    return ch;
}
# Impl `ii`'s method `m`, defined at `fn` token p: 1 when its entry is newly flagged 256.
fn _pair_scan_method(S, ii, m, p): i64 {
    var fi = _impl_method_entry(S, ii, m, p);
    if (fi < 0) { return 0; }
    if ((GFLG(S, fi) & 256) != 0) { return 0; }
    var o = _tr_paren(S, p);
    if (o < 0) { return 0; }
    var j = _tok_body_open(S, _call_close(S, o) + 1);
    if (j < 0) { return 0; }
    _pbs_iself = 0;
    var isf = GFISELF(S, fi);
    if (isf > 0) { _pbs_iself = FINDSTRUCT(S, isf - 1); }
    var r = _pair_body_scan(S, p, j);
    _pbs_iself = 0;
    if (r == 0) { return 0; }
    SFLG(S, fi, GFLG(S, fi) | 256);
    return 1;
}
# The fn-table entry that impl `ii`'s method `m` (its `fn` token p) defines — `T_m`, or `T_Trait_m`
# on a collision (`_tr_prefix`'s cached prefix) — matched on its name AND its definition's start
# (`_fn_by_defti`), so a same-named entry of another definition is never taken. Read only: the name
# is scratch, nothing is interned or registered (the axis-13 rule above). -1 when pass 1 has not
# registered it.
fn _impl_method_entry(S, ii, m, p): i64 {
    var fi = _fn_by_defti(S, _tr_scratch(S, L64(_ti_tab + ii * 64 + 8), m, 4096), p);
    if (fi >= 0) { return fi; }
    var pf = L64(_ti_tab + ii * 64 + 40);
    if (pf == 0) { return 0 - 1; }
    return _fn_by_defti(S, _tr_scratch(S, pf, m, 4096), p);
}
# The body `{` at or after token i — before any `;` (a bodiless declaration) — or -1.
fn _tok_body_open(S, i): i64 {
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 13) { return i; }
        if (t == 5 || t == 12) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
# 1 = the body whose `{` is token j (of the fn whose `fn` token is a — the unit `_tok_ret_callee`
# resolves names in) has a `return f(..)` / `return g<..>(..)` / `return x.m(..)` whose callee is
# flagged 256: it forwards a `: stack` pair. Closure bodies are their own units, skipped, as is a
# refused nested fn. `_pair_prescan`'s scan of one fn, and (6.7.8) the dyn pair check's of a slot
# method whose body pass 2 has not reached (`_dyn_slot_pair`, parse/types/dyn_call.cyr).
# ⛔ 6.7.14 — A `?` ON A PAIR CALL IS A PAIR ROUTE TOO (`_tok_q_is_pair`): pass 2 flags the fn 256
# at its `?`, so a fn whose only pair route was a `?` was a pair only BELOW its definition — a
# caller above took `qb(x)?` as boxed (rc 139) and `var v = qb(x);` kept the tag. CHANGELOG [6.7.14]
fn _pair_body_scan(S, a, j): i64 {
    var n = GTCNT(S);
    var bd = 0;
    var k = j;
    while (k < n) {
        var t = TOKTYP(S, k);
        if (t == 13) {
            var sk = _skip_nested_body(S, k);   # a closure body — its returns are its own
            if (sk >= 0) { k = sk; } else { bd = bd + 1; }
        }
        elif (t == 14) {
            bd = bd - 1;
            if (bd == 0) { return 0; }
        }
        elif (t == 32) { k = _skip_nested_body(S, k); }   # a refused nested fn (header)
        elif (t == 33) {                  # `return`
            var rf = _tok_ret_callee(S, a, k + 1);   # `return f(`, `return g<..>(`, `return x.m(` (6.6.16)
            if (rf >= 0) { if ((GFLG(S, rf) & 256) != 0) { return 1; } }
        }
        elif (t == 124) {                 # `f(..)?` on a pair: pass 2's `?` flag, seen before the body
            if (_tok_q_is_pair(S, a, k) == 1) { return 1; }   # CHANGELOG [6.7.14]
        }
        elif (t == 35 || t == 54) {       # a brace-less closure's `?` is its own
            var ce = _tok_closure_expr_end(S, k);
            if (ce > k) { k = ce - 1; }
        }
        k = k + 1;
    }
    return 0;
}
# The token that ends the EXPRESSION body of the closure literal whose `|` / `||` is token k (its depth-0 `;`
# `,` or unmatched closer, `_tok_expr_end`), or -1: k opens no literal (`_cl_lit_pos`, `_cl_lit_end`: a bitwise
# or / logical or follows an operand), or the body is a block (`_skip_nested_body` steps over that). Since the `?`
# counts as a pair route, `fn qce(x) { var f = |a| parse(a)?; .. }` was flagged pair-returning by the closure's
# own `?` — "bind both" at `var z = qce(5);`, and a mixed-return warning at its plain `return`. CHANGELOG [6.7.14]
fn _tok_closure_expr_end(S, k): i64 {
    if (_cl_lit_pos(S, k) == 0) { return 0 - 1; }
    var b = k + 1;
    if (TOKTYP(S, k) == 35) {
        var e = _cl_lit_end(S, k);
        if (e < 0) { return 0 - 1; }
        b = e + 1;
    }
    if (TOKTYP(S, b) == 13) { return 0 - 1; }
    return _tok_expr_end(S, b);
}
