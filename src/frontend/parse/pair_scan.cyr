# The first token of fi's declared return type (past its `:`), or -1.
fn _tok_ret_ann(S, fi): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0 - 1; }
    var c = _tok_close_paren(S, o);
