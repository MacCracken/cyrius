    var c = _tok_close_paren(S, o);
    if (c < 0) { return 0 - 1; }
    if (TOKTYP(S, c + 1) != 49) { return 0 - 1; }
    if (TOKTYP(S, c + 2) != 2) { return 0 - 1; }
    var rn = TOKVAL(S, c + 2) + 1;
