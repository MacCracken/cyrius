        # Stack array (flag on): rbp-relative `lea` of the local; global array
        # (flag off, legacy): absolute `EVADDR`. Both leave the base in rax.
        if (s_stack == 1) {
            var s_disp = 0 - ((s_lidx + 1) * 8);
            if (_cur_fn_regalloc > 0) { s_disp = s_disp - _cur_fn_regalloc * 8; }
            if (_cur_fn_ret_stash > 0) { s_disp = s_disp - _cur_fn_ret_stash; }
            ELOAD_LOCAL_ADDR(S, s_disp);
