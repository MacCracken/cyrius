            if (_try_aggregate_copy_assign(S, noff, 5) == 1) { return 0; }
            if (_try_struct_call_assign(S, noff, 5) == 1) { return 0; }   # 6.6.6
            # v6.5.61 — `r = f(...)` into a VECTOR local needs the 16/32-byte receive the
            # declaration form has; without it this fell to the 8-byte EFLSTORE below.
            if (_try_vector_call_assign(S, noff, 5) == 1) { return 0; }
            # v6.6.0 — `x = f();` where f returns a `: stack` pair keeps the tag and drops the
            # payload, silently. Same refusal as the declaration form. CHANGELOG [6.6.0].
            _refuse_lossy_pair(S);
            _asg_ret_peek(S, noff);   # 6.6.17: the RHS's declared type, before PCMPE moves on
            if (_pcmpe_struct_assign(S, noff, 5) == 1) { return 0; }   # PCMPE + a method/operator struct result (6.6.6)
        }
        # Type check at assignment
        var aps = GPSC(S);
        var idx = 0 - 1;
        if (GINFN(S) == 1) {
            idx = FINDLOCAL(S, noff);
            if (idx >= 0) {
                var lt = GLTYPE(S, idx);
                # v6.5.24 — THE SIGN TEST WAS INVERTED, so this warning fired on exactly
                # the locals it should ignore and never once on the case it exists for.
                # In the local SLTYPE scheme a POSITIVE lt is a narrow width in bytes
                # (1/2/4) or a float tag (F64_TYID 0x40000001 / F32_TYID 0x40000002);
                # the pointer-like case is stored NEGATIVE, as `0 - sid`
                # (parse/decl.cyr:2490). `lt > 0` therefore meant "narrow or float".
                # Measured before the fix: `var w: i32 = 5; w = 6;` warned, `var a: f64
                # = ...; a = ...;` warned, and a struct-typed local — the actual typed
                # pointer — did NOT, i.e. the check was unreachable for its own purpose.
                # `lt < 0` is also what the GLOBAL arm of this very warning already uses
                # (`vt < 0`, ~40 lines below); the two arms had silently disagreed.
                # ⭐ Fixing the float half UNGATED the ranga/ganita f32 tier: `acc =
                # f32_op(acc, ..)` is the canonical loop body there, so every f32
                # accumulator in every consumer would have emitted a bogus warning.
                # Filed as 2026-08-13-f64-typed-binding-reassign-warns-as-pointer plus
                # the wider inverted-sign finding (roadmap Slot 1 item (d)).
                # v6.5.28 — a call whose DECLARED return sid is a struct (> 0) IS a typed
                # pointer, even though the call itself leaves the expression pointer-scale at
                # 0. Without this the warning fired on `t = str_new(..)` while the identical
                # initializer `var t = str_new(..)` was accepted — the two paths disagreeing
                # about the same expression.
                # 6.7.13 (D18 (a)): and a `*T` local / `p: *T` parameter of a scalar T (the slot's typed-pointer bit);
                # the literal 0 is a null reset, never warned (`_tp_warn`).
                # 6.7.14: never a value-form vector local — its SLTYPE is a descriptor (<= -2048), negative but no
                # `0 - sid`: `v = f64v2_splat(1.0);` with the fn undefined (the undefined-function path's since 6.7.13)
                # and `v = mk4(..)` of another vector (refused) warned "assigning non-pointer to typed pointer".
                if ((lt < 0 || GLPTRP(S, idx) == 1) && _asg_ret_sid <= 0) {
                    if (lt > 0 - 2048) { if (aps == 0) { if (_asg_tup_refd == 0) { _tp_warn(S, _asg_ti); } } }
                }
            }
        }
        if (idx >= 0) {
            var lt = GLTYPE(S, idx);
            _asg_plain_in(S, idx, 0, _asg_ti);      # 6.6.10: `t = 1` into an f64 / f32 local; 6.7.6: f32 rounds, a whole array refused
            _asg_rejudge(S, idx, lt, 0);            # 6.6.11
            _asg_store_slot(S, idx, 0);             # 6.6.12: shared with the for step
        }
        else {
            idx = FINDVAR(S, noff);
            if (idx < 0) {
                # v6.5.19: --syntax-only drops the STORE (there is nowhere to store to)
                # but must still consume the statement's `;`, exactly as the tail of
                # this fn does below. Returning without it left the `;` dangling and
                # the statement layer reported `unexpected ';'` — a FALSE ACCUSATION
                # against valid code, measured on `lib/thread_win.cyr`'s
                # `_threads_active = 1;` (a global declared in a sibling module) and
                # therefore on all 74 repos that vendor it. See _syntax_only.
                if (_syntax_only == 1) {
                    if (_unp_names == 1) { _asg_undef_report(S, noff); }   # 6.7.17 (D110): a never-parsed body's read
                    _expect_step(S, 5);
                    return 0;
                }
                _asg_undef_report(S, noff);   # 6.7.9: shared with the for step
                _expect_step(S, 5); return 0;   # 6.7.14
            }
            var vt = GVTYPE(S, idx);
            if (vt < 0) {
                if (aps == 0) { if (_asg_tup_refd == 0) { _tp_warn_gasg(S, idx, _asg_ti); } }   # 6.7.16: a `: Str` call into a `*Str`
            }
            _asg_plain_in(S, idx, 1, _asg_ti);      # 6.6.10: `G = 1` into an f64 / f32 global; 6.7.6: as the local
            _asg_rejudge(S, idx, vt, 1);            # 6.6.11
            _asg_store_slot(S, idx, 1);             # 6.6.12: shared with the for step
        }
        _expect_step(S, 5);
        return 0;
    }
    if (_refuse_nested_fn(S) == 1) { return 0; }   # 6.6.16: a `fn` / `async fn` in a fn body
    if (_stmt_paren_field(S) == 1) { return 0; }   # 6.7.14 (D24 (a)): `(s).m();`, `(s).a = v;` refused
    ERR(S);
    return 0;
}
