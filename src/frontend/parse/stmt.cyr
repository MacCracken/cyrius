        # `var buf[N]` here is registered as fn-LOCAL slots, not a global var — so detect
        # the array via FINDLOCAL + a slot-delta size and zeroise through the local
        # address (`lea [rbp-disp]`) instead of the global `EVADDR`. Off (legacy global
        # array) keeps the original VCNT/`_vars_base`/`EVADDR` path byte-identical.
        var s_name = TOKVAL(S, GTI(S) + 1);   # the array's name token (after `var`)
        var s_flc_pre = GFLC(S);
        var vcnt_pre = GVCNT(S);
        PARSE_VAR(S);
        var sidx = 0;
        var ssz = 0;
        var s_lidx = 0;
        # 6.6.5 — ASK WHERE THE ARRAY ACTUALLY WENT, not whether stack arrays are enabled.
        # An array over the per-fn budget falls back to static storage even with the flag on,
        # so the flag said "local", FINDLOCAL found nothing, and a perfectly good
        # `secret var buf[200000];` was refused with "secret requires array declaration".
        # Worse, with an outer local of the same name in scope FINDLOCAL DID find something
        # and the zeroise ran against the wrong storage — the buffer was never cleared, which
        # is the one thing `secret` exists to guarantee. The slot-count delta is the fact.
        var s_stack = 0;
        if (GFLC(S) > s_flc_pre) { s_stack = 1; }
        if (s_stack == 1) {
            s_lidx = FINDLOCAL(S, s_name);
            if (s_lidx < 0) {
                ERR_MSG(S, "secret requires array declaration: secret var buf[N];", 53);
            }
            ssz = (GFLC(S) - s_flc_pre) * 8;   # array slot count (incl. any 16-align pad) × 8
        } else {
            if (GVCNT(S) != vcnt_pre + 1) {
                ERR_MSG(S, "secret requires array declaration: secret var buf[N];", 53);
            }
