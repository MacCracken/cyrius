    # v6.4.3+ (SIMD Phase 1): f32v_add/sub/mul as statements (138-140).
    if (typ >= 138) { if (typ <= 140) { PCMPE(S); _expect_step(S, 5); return 0; } }
    # v6.4.5 (SIMD Phase 2): f32v_fmadd as a statement (141).
    if (typ == 141) { PCMPE(S); _expect_step(S, 5); return 0; }
    # v6.4.6 (Phase 3a): iv_add/iv_sub/iv_mul as statements (143-145).
    if (typ >= 143) { if (typ <= 145) { PCMPE(S); _expect_step(S, 5); return 0; } }
