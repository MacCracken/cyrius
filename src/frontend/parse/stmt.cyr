    # 6.7.14: their `;` through `_expect_step` — an unclosed `syscall(60, 0;` then a `for` stepped the `for`.
    if (typ == 24) { PCMPE(S); _expect_step(S, 5); return 0; }
    if (typ == 26) { PCMPE(S); _expect_step(S, 5); return 0; }
    if (typ == 45) { PCMPE(S); _expect_step(S, 5); return 0; }
    if (typ == 46) { PCMPE(S); _expect_step(S, 5); return 0; }
    if (typ == 47) { PCMPE(S); _expect_step(S, 5); return 0; }
