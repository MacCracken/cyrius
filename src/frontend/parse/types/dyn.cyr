# PARSER — types: checked `dyn` (`_dyn_*`): the token fold, the prepass, where a dyn may stand, its sources and vtables,
# the pair and signature checks (`_dsq_*`, `_dps_*`, `_tyn_*`), declarations, stores, arguments and returns.
# ================================================================
# Split from parse/types.cyr at 6.7.18, unchanged; parse.cyr includes parse/types/ in source order. CHANGELOG [6.7.18]

# ⛔ 6.7.8 — CHECKED `dyn` (the user's decisions, 2026-10-07): `o: dyn Show` is an ordinary 16-byte
# struct of two words {data, vtable} — ADR-002's one-word model holds. THE TOKEN FOLD: before any
# prepass records a token index, `dyn X` becomes ONE identifier token named `dyn X` (a space: no
# lexed identifier spells it, so it collides with no user name), and `_dyn_prepass` registers that
# name as a struct before any user struct. Every struct position then takes it unchanged — a
# local, a global, a parameter (pass 1's scan too), a return (the rough pair scan), a field, a
# copy checked by sid. The two words are named " data" / " vtable" (a leading space): no field
# access reaches them (decision 7 — "unknown field 'data' on struct 'dyn Show'"). Each position
# the decisions leave open is refused by name at the prepass, once per token. A unit that spells
# no `dyn` folds nothing (`_lex_dyn_n`, lex.cyr): its tokens are untouched. CHANGELOG [6.7.8]
var _dyn_ix = 0;   # the folded tokens: (index << 2) | 1 when a `+ B` after it was dropped (T2); | 2 a bare `dyn`
var _dyn_nx = 0;
var _dyn_nm = 0;   # one minted name per spelling: (X's name offset, `dyn X`'s)
var _dyn_nn = 0;
var _dyn_wd = 0;   # the word names " data" / " vtable" (name offset + 1), minted once
var _dyn_wv = 0;
var _dyn_hm = 0;   # per struct: 0 = not judged, 1 = holds no dyn, 2 = holds one (`_dyn_held`)

fn _dyn_fold(S): i64 {
    if (_lex_dyn_n == 0) { return 0; }
    _dyn_ix = alloc(_lex_dyn_n * 8);
    _dyn_nm = alloc(_lex_dyn_n * 16);
    var n = GTCNT(S);
    var r = 0;
    var w = 0;
    while (r < n) {
        if (TOKTYP(S, r) == 173) {
            if (TOKTYP(S, r + 1) == 2) {
                r = _dyn_fold1(S, r, w);
                w = w + 1;
                continue;
            }
            _dyn_note(w, 2);   # a `dyn` with no trait name after it: T3, judged by the prepass
        }
        if (w != r) { _dyn_tok_mv(S, w, r); }
        w = w + 1;
        r = r + 1;
    }
    STCNT(S, w);
    return 0;
}
# `dyn` at token `r`, the identifier X after it: ONE identifier at `w`, named `dyn X`, carrying
# `dyn`'s line word (a diagnostic's caret points at `dyn`). A `+ B` run after it is dropped, its
# reason recorded for the prepass (T2), so the parse goes on in sync. The next token to read.
fn _dyn_fold1(S, r, w): i64 {
    var lw = L64(S + 0xCC00000 + r * 8);
    var nm = _dyn_name(S, TOKVAL(S, r + 1));
    S64(S + 0x8C00000 + w * 8, 2);
    S64(S + 0xAC00000 + w * 8, nm);
    STLINE(S, w, lw);
    var q = r + 2;
    var plus = 0;
    while (TOKTYP(S, q) == 6) {
        if (TOKTYP(S, q + 1) != 2) { break; }
        q = q + 2;
        plus = 1;
    }
    _dyn_note(w, plus);
    return q;
}
fn _dyn_note(w, f): i64 {
    S64(_dyn_ix + _dyn_nx * 8, (w << 2) | f);
    _dyn_nx = _dyn_nx + 1;
    return 0;
}
fn _dyn_tok_mv(S, w, r): i64 {
    S64(S + 0x8C00000 + w * 8, TOKTYP(S, r));
    S64(S + 0xAC00000 + w * 8, TOKVAL(S, r));
    STLINE(S, w, L64(S + 0xCC00000 + r * 8));
    return 0;
}
# The name `dyn X` for X at name offset `xnoff` — one offset per spelling (LEXID already gives one
# X one offset).
fn _dyn_name(S, xnoff): i64 {
    var i = 0;
    while (i < _dyn_nn) {
        if (L64(_dyn_nm + i * 16) == xnoff) { return L64(_dyn_nm + i * 16 + 8); }
        i = i + 1;
    }
    var n = 0;
    while (load8(S + 0xEC00000 + xnoff + n) != 0) { n = n + 1; }
    var np = _dyn_mint(S, "dyn ", 4, n + 1);
    i = 0;
    while (i <= n) {
        store8(S + 0xEC00000 + np + 4 + i, load8(S + 0xEC00000 + xnoff + i));
        i = i + 1;
    }
    SNPOS(S, np + 4 + n + 1);
    S64(_dyn_nm + _dyn_nn * 16, xnoff);
    S64(_dyn_nm + _dyn_nn * 16 + 8, np);
    _dyn_nn = _dyn_nn + 1;
    return np;
}
# Write the `n` bytes of `s` at the name pool's top, `more` bytes reserved after them; the offset.
# The caller moves the pool's top (SNPOS) past what it wrote.
fn _dyn_mint(S, s, n, more): i64 {
    NPOS_GUARD(S, n + more + 1);
    var np = GNPOS(S);
    var i = 0;
    while (i < n) {
        store8(S + 0xEC00000 + np + i, load8(s + i));
        i = i + 1;
    }
    store8(S + 0xEC00000 + np + n, 0);
    return np;
}
fn _dyn_word(S, s, n): i64 {
    var np = _dyn_mint(S, s, n, 0);
    SNPOS(S, np + n + 1);
    return np + 1;
}
# The struct `dyn X` (name offset `noff`), registered on its first spelling: two 8-byte words.
fn _dyn_reg(S, noff): i64 {
    var sid = FINDSTRUCT(S, noff);
    if (sid > 0) { return sid; }
    sid = REGSTRUCT(S, noff);
    if (sid == 0) { return 0; }
    if (_dyn_wd == 0) { _dyn_wd = _dyn_word(S, " data", 5); }
    if (_dyn_wv == 0) { _dyn_wv = _dyn_word(S, " vtable", 7); }
    ADDFIELD(S, sid - 1, _dyn_wd - 1);
    ADDFIELD(S, sid - 1, _dyn_wv - 1);
    return sid;
}
# 1 = the source at token `st` is one whole call returning dyn `sid` (`;` after it) — at top level
# its own path refuses it (no frame for a 9-16 B result), so a declaration backstop stays quiet.
# 6.7.8 (D6): a method's too (`var G: dyn Show = Z.me();`, through a dyn or not).
fn _dyn_src_call(S, st, sid): i64 {
    var o = _gcall_open(S, st);
    if (o < 0) { return _dyn_src_mcall(S, st, sid); }
    if (TOKTYP(S, _call_close(S, o) + 1) != 5) { return 0; }
    var fi = _gen_resolve_call(S, st);
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != sid) { return 0; }
    return 1;
}
fn _dyn_src_mcall(S, st, sid): i64 {
    var o = _mcall_open(S, st, 0 - 1);   # 6.7.15: `x.m<..>(` too
    if (o < 0) { return 0; }
    if (TOKTYP(S, _call_close(S, o) + 1) != 5) { return 0; }
    var fi = _pair_callee_at(S, st);
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != sid) { return 0; }
    return 1;
}
# 1 = struct `sid` (1-based) is a dyn: its name starts `dyn ` (only the fold mints one).
fn _dyn_is(S, sid): i64 {
    if (_dyn_nx == 0) { return 0; }
    if (sid <= 0) { return 0; }
    if (sid > GSTC(S)) { return 0; }
    if (L64(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8)) & 0xFFFFFFFF == 0x206E7964) { return 1; }
    return 0;
}
# 1 = struct `sid` is a dyn or holds one in a field, directly or through a nested struct field
# (a generic instance's included). Judged once per struct (`_dyn_hm`): asked only of a complete one.
fn _dyn_held(S, sid): i64 {
    if (_dyn_is(S, sid) == 1) { return 1; }
    if (_dyn_nx == 0) { return 0; }
    if (sid <= 0) { return 0; }
    if (sid > GSTC(S)) { return 0; }
    if (_dyn_hm == 0) { _dyn_hm = alloc(1024); }
    var m = load8(_dyn_hm + sid - 1);
    if (m != 0) { return m - 1; }
    var r = 0;
    var fc = GETFCOUNT(S, sid - 1);
    var i = 0;
    while (i < fc) {
        var ft = GETFTYPE(S, sid - 1, i);
        if (_spi_is_nested(S, ft) == 1) { if (_dyn_held(S, ft) == 1) { r = 1; } }
        i = i + 1;
    }
    store8(_dyn_hm + sid - 1, r + 1);
    return r;
}
# ⛔ U1 / U2 — STRUCT LOCALS ARE NOT ZEROED, so `var o: dyn Show;` in a fn — or `var h: H;` /
# `var hs: H[N]` where H holds a dyn, directly or through a nested struct field — left a vtable word
# of whatever the frame held: a call through it jumps to garbage. Refused by name at the annotation
# (`ann`), the name still declared (PARSE_VAR goes on, nothing cascades). A global is zeroed (a
# zone global is refused uninitialised anyway). `_tup_var`'s first line; `noff` -1 for an array.
# 6.7.8 (D5): `var o: dyn S = src;` whose source is no dyn value is declared here, the dyn formed in
# place (`_dyn_var_init`: 1, the `;` consumed); a copy is left to PARSE_VAR's struct paths (0).
fn _dyn_var(S, noff, pscale, ann): i64 {
    if (pscale == 0) { if (ann != 0) { return _dyn_var_ann(S, ann); } }
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    if (PEEKT(S) == 5) {
        _dyn_uninit(S, 0 - pscale, ann, noff);
        return 0;
    }
    if (PEEKT(S) != 4) { return 0; }
    if (_dyn_is(S, 0 - pscale) == 0) { return 0; }
    return _dyn_var_init(S, noff, 0 - pscale);   # 6.7.8 (D5): 1 = declared, formed or refused
}
# 6.7.8 (review) — `var y: i64 = mk();` / `: u8` / `: f64` in a fn, `mk()` returning a dyn: PARSE_VAR's
# struct receive infers its struct from a whole free call for an annotation that is no struct, so y
# became the dyn its annotation says it is not (`y.area()` compiled). Refused at the call, in V4's
# words; a bool's is `_bx_decl`'s. (A method / operator initialiser is `_sc_var_receive`'s.) 0.
fn _dyn_var_ann(S, ann): i64 {
    if (_dyn_nx == 0) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    if (PEEKT(S) != 4) { return 0; }
    var a = GTI(S) + 1;
    if (TOKTYP(S, a) != 2) { return 0; }
    if (TOKTYP(S, a + 1) != 10) { return 0; }
    if (_call_dotted(S, a) == 1) { return 0; }
    if (TOKTYP(S, _call_close(S, a + 1) + 1) != 5) { return 0; }
    if (_tn_resolve_at(S, ann) == _tn_code(4, 1)) { return 0; }
    var fi = FINDFN(S, TOKVAL(S, a));
    if (fi < 0) { return 0; }
    if (_dyn_is(S, GFRS(S, fi)) == 0) { return 0; }
    _dyn_err(S, a, "a ", GFRS(S, fi), 0 - 1, " result used as a value - call one of its methods, or copy it whole into a dyn");
    return 0;
}
fn _dyn_uninit(S, sid, ann, noff): i64 {
    if (GINFN(S) != 1) { return 0; }
    if (_dyn_held(S, sid) == 0) { return 0; }
    if (_dyn_is(S, sid) == 1) { return _dyn_err(S, ann, "declare ", sid, noff, " with its value - struct locals are not zeroed, and a dyn's vtable is formed, never left to the frame"); }
    if (noff < 0) { return _dyn_err(S, ann, "an array of ", sid, 0 - 1, " in a fn is refused - its records hold a dyn, struct locals are not zeroed, and a dyn's vtable is formed, never left to the frame"); }
    return _dyn_err(S, ann, "declare ", sid, noff, " with its value - it holds a dyn, struct locals are not zeroed, and a dyn's vtable is formed, never left to the frame");
}
# T12 — the field of struct `si` typed by struct `fs` (its type token `ti`): a union cannot hold a dyn
# (another member would write its words), nor can a generic struct have a dyn field (a type
# parameter and a dyn do not combine yet: the struct `_sdef_tp_ti` is defining opens `<`).
fn _dyn_field_chk(S, si, fs, ti): i64 {
    if (_dyn_held(S, fs) == 0) { return 0; }
    if (ISUNION(S, si) == 1) { return _dyn_err(S, ti, "a union cannot hold a dyn - another member would write its words", 0, 0 - 1, 0); }
    if (_dyn_is(S, fs) == 0) { return 0; }
    if (TOKTYP(S, _sdef_tp_ti) == 19) { return _dyn_err(S, ti, "a dyn field in a generic struct is refused - a type parameter and a dyn do not combine yet", 0, 0 - 1, 0); }
    return 0;
}

# The prepass (`_tl_pass1`, right after `_tr_prepass`, so a trait name resolves): every folded
# token registers its struct — a refused one too, so its later uses do not cascade — and is
# checked where it stands. Reported through `_tup_err`'s reporter: once per token, the latch left
# alone, silent under `--syntax-only`.
fn _dyn_prepass(S): i64 {
    var i = 0;
    while (i < _dyn_nx) {
        var e = L64(_dyn_ix + i * 8);
        if ((e & 2) == 0) { _dyn_chk(S, e >> 2, e & 1); }
        else { _dyn_bare(S, e >> 2); }
        i = i + 1;
    }
    return 0;
}
# T3 — a `dyn` with no trait name after it, in a type position (after `:`, `<`, `*`, `[`, or a `,`
# inside `<..>`), where the parser took any one token as the type (`o: dyn)`, `Vec<dyn>` compiled).
# The token becomes the identifier `dyn`, so each type resolver after this refuses it at the same
# token, silently (`_tn_once`): one report. In a name position the parser names the reserved word.
var _dyn_bare_nm = 0;
fn _dyn_bare(S, ti): i64 {
    if (ti == 0) { return 0; }
    var pt = TOKTYP(S, ti - 1);
    var k = 0;
    if (pt == 49 || pt == 19 || pt == 8 || pt == 28) { k = 1; }
    if (pt == 31) { if (_dyn_opener(S, ti) == 19) { k = 1; } }
    if (k == 0) { return 0; }
    _dyn_err(S, ti, "`dyn` takes a trait's name - `dyn Show` for `trait Show`", 0, 0 - 1, 0);
    if (_dyn_bare_nm == 0) { _dyn_bare_nm = _dyn_word(S, "dyn", 3); }
    S64(S + 0x8C00000 + ti * 8, 2);
    S64(S + 0xAC00000 + ti * 8, _dyn_bare_nm - 1);
    _tnd_a = 0 - 1;   # 6.7.18: a token rewritten in place: `_tok_name_decl`'s reused walk is over
    return 0;
}
fn _dyn_chk(S, ti, plus): i64 {
    var noff = TOKVAL(S, ti);
    var sid = _dyn_reg(S, noff);
    if (_dyn_pos(S, ti, sid) == 1) { return 0; }
    if (plus == 1) { return _dyn_err(S, ti, "`dyn A + B` is refused - a dyn holds one vtable, of one trait", 0, 0 - 1, 0); }
    var nt = TOKTYP(S, ti + 1);
    if (nt == 19) { return _dyn_err(S, ti, "", sid, 0 - 1, " takes no type arguments - a trait has none"); }
    if (nt == 28) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be an array element - hold it in a record (`struct R { o: dyn ..; }`) and make an array of those"); }
    if (_tr_find(S, noff + 4) < 0) {
        if (_dl_refd_at(S, noff + 4) == 1) { _tn_once(S, ti); return 1; }   # 6.7.16: a refused (inner) trait's
        return _dyn_err(S, ti, "", 0, noff + 4, " is not a trait - `dyn` takes a declared trait's name");
    }
    return _dyn_fn_chk(S, ti);
}
# The position: a dyn type is written after a `:` (a var, a parameter, a return type, a field, a
# trait member's signature). Every other position is refused by name (1 = refused).
fn _dyn_pos(S, ti, sid): i64 {
    if (ti == 0) { return _dyn_where(S, ti, sid); }
    var pt = TOKTYP(S, ti - 1);
    if (pt == 49) { return 0; }
    if (pt == 19) {
        if (_dyn_tok_is(S, ti - 2, "slice", 5) == 1) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a slice element"); }
        return _dyn_targ(S, ti, sid);
    }
    if (pt == 31) { return _dyn_pos_comma(S, ti, sid); }
    if (pt == 8) { return _dyn_err(S, ti, "a pointer to ", sid, 0 - 1, " is refused - a dyn is a two-word value; point at a record that holds one (`struct R { o: dyn ..; }`, `*R`)"); }
    if (pt == 28) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a slice element"); }
    if (pt == 10) { return _dyn_pos_paren(S, ti, ti - 1, sid); }
    if (pt == 77) { return _dyn_err(S, ti, "`impl` takes a type that is not a dyn - implement the trait for a struct or a scalar", 0, 0 - 1, 0); }
    if (pt == 55) { if (ti >= 3) { if (TOKTYP(S, ti - 3) == 77) {
                return _dyn_err(S, ti, "`impl` takes a type that is not a dyn - implement the trait for a struct or a scalar", 0, 0 - 1, 0);
            } } }
    return _dyn_where(S, ti, sid);
}
fn _dyn_where(S, ti, sid): i64 {
    _dyn_err(S, ti, "", sid, 0 - 1, " is a type - write it after a `:` (`o: dyn Show`)");
    # As a VALUE (`= dyn Show`, `return dyn Show`, an argument) it would also be an undefined
    # variable: it becomes the number 0 there, so the refusal above is the one report.
    if (ti < 3) { return 1; }
    var pt = TOKTYP(S, ti - 1);
    var e = 0;
    if (pt == 4 || pt == 33) { e = 1; }
    if (pt == 10) { if (TOKTYP(S, ti - 2) == 2) { if (TOKTYP(S, ti - 3) != 32) { e = 1; } } }
    if (e == 1) {
        S64(S + 0x8C00000 + ti * 8, 1);
        S64(S + 0xAC00000 + ti * 8, 0);
        _tnd_a = 0 - 1;   # 6.7.18: as in `_dyn_bare`
    }
    return 1;
}
# After a `,`: the bracket it is inside decides — `<` a type argument, `(` a tuple's element (`: (`)
# or a `*fn(..)` parameter; else a name position.
fn _dyn_pos_comma(S, ti, sid): i64 {
    var t = _dyn_opener(S, ti);
    if (t == 19) { return _dyn_targ(S, ti, sid); }
    if (t == 10) { return _dyn_pos_paren(S, ti, _dyn_open_ti, sid); }
    return _dyn_where(S, ti, sid);
}
# The bracket a `,` before token `ti` sits in: its token type (`(`, `<`, `[`), `_dyn_open_ti` its
# index; 0 when a `;`, `{` or `}` comes first.
var _dyn_open_ti = 0;
fn _dyn_opener(S, ti): i64 {
    var k = ti - 2;
    var d = 0;
    while (k >= 0) {
        var t = TOKTYP(S, k);
        if (t == 5 || t == 13 || t == 14) { return 0; }
        if (t == 11 || t == 20 || t == 29) { d = d + 1; }
        elif (t == 39) { d = d + 2; }
        elif (t == 152) { d = d + 3; }
        elif (t == 10 || t == 19 || t == 28) {
            if (d == 0) {
                _dyn_open_ti = k;
                return t;
            }
            d = d - 1;
        }
        k = k - 1;
    }
    return 0;
}
# Inside the `(` at token `o`: `sizeof(`, a `*fn(..)` parameter, a tuple / multi-value element (`: (`).
fn _dyn_pos_paren(S, ti, o, sid): i64 {
    if (o >= 1) {
        if (_dyn_tok_is(S, o - 1, "sizeof", 6) == 1) { return _dyn_err(S, ti, "sizeof(", sid, 0 - 1, ") is refused - a dyn is two words, and no layout of them is promised"); }
        if (TOKTYP(S, o - 1) == 32) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a `*fn(..)` parameter - pass a record that holds one"); }
        if (TOKTYP(S, o - 1) == 49) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a tuple or multi-value element - return or hold it alone"); }
    }
    return _dyn_where(S, ti, sid);
}
fn _dyn_targ(S, ti, sid): i64 {
    return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a type argument - a collection holds pointers to records that hold a dyn");
}
# Token `ti` is the identifier spelled by the `n` bytes of `s`.
fn _dyn_tok_is(S, ti, s, n): i64 {
    if (ti < 0) { return 0; }
    if (TOKTYP(S, ti) != 2) { return 0; }
    var p = S + 0xEC00000 + TOKVAL(S, ti);
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(s + i)) { return 0; }
        i = i + 1;
    }
    if (load8(p + n) != 0) { return 0; }
    return 1;
}
# T11 — the fn whose signature or body holds the dyn: a generic, `async`, `const` or `#naked` fn is
# refused (a type parameter, a suspended frame, a compile-time evaluation and a frameless body have
# no rule with a dyn yet). Its prefix tokens are read back from its `fn`.
fn _dyn_fn_chk(S, ti): i64 {
    var k = _tok_enclosing_fn(S, ti);
    if (k < 0) { return 0; }
    if (TOKTYP(S, k + 2) == 19) { return _dyn_err(S, ti, "a dyn type in a generic fn is refused - a type parameter and a dyn do not combine yet", 0, 0 - 1, 0); }
    var t = _dyn_fn_pfx(S, k);
    if (t == 134) { return _dyn_err(S, ti, "a dyn type in an `async fn` is refused - a suspended frame and a dyn do not combine yet", 0, 0 - 1, 0); }
    if (t == 168) { return _dyn_err(S, ti, "a dyn type in a `const fn` is refused - a compile-time evaluation takes no dyn", 0, 0 - 1, 0); }
    if (t == 133) { return _dyn_err(S, ti, "a dyn type in a `#naked` fn is refused - a body with no frame takes no dyn", 0, 0 - 1, 0); }
    return 0;
}
# The prefix that makes the fn whose `fn` token is `k` an `async` (134), `const` (168) or `#naked`
# (133) one, read back over its attribute tokens; else 0.
fn _dyn_fn_pfx(S, k): i64 {
    var j = k - 1;
    while (j >= 0) {
        var t = TOKTYP(S, j);
        if (t == 134 || t == 168 || t == 133) { return t; }
        if (t != 73 && t != 153 && _tl_flag_tok(t) == 0) { return 0; }
        j = j - 1;
    }
    return 0;
}
# The one reporter for a dyn refusal (and a tuple's, `_tup_err`): at token `ti`,
# "<msg>[<struct sid's name> ]['<noff>'][<tail>]". Once per token, the panic latch left as it was
# (every refusal of a file is reported, none swallows the next statement), and silent under
# `--syntax-only` (lint's pre-pass resolves no type). 1 = reported.
fn _dyn_err(S, ti, msg, sid, noff, tail): i64 {
    if (_dyn_ebeg(S, ti) == 0) { return 0; }
    PRSTR(msg);
    if (sid > 0) {
        _dyn_ps(S, sid);
        if (noff >= 0) { _ew(" ", 1); }
    }
    if (noff >= 0 || noff <= 0 - 1000) { _dyn_pq(S, noff); }   # 6.7.17: or a struct (`_ei_sid`)
    if (tail != 0) { PRSTR(tail); }
    return _dyn_eend(S);
}
# The reporter's two halves, for a message with names in its middle: `_dyn_ebeg` (0 = say nothing:
# `--syntax-only`, the panic latch, or this token already reported) prints the head; the caller
# the words (`_dyn_ps` a struct's name, `_dyn_pn` a name, `_dyn_pq` a name quoted); `_dyn_eend` the
# excerpt, and puts the cursor back.
var _dyn_esv = 0;
fn _dyn_ebeg(S, ti): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    _err_n = _err_n + 1;   # 6.7.16: a report or a repeat (`_err_n`)
    if (_tn_once(S, ti) == 0) { return 0; }
    _dyn_esv = GTI(S);
    STI(S, ti);
    _ew("error:", 6);
    _err_head(S);
    _ew(": ", 2);
    return 1;
}
fn _dyn_eend(S): i64 {
    _ew("\n", 1);
    _err_excerpt(S);
    _had_error = 1;
    STI(S, _dyn_esv);
    return 1;
}
fn _dyn_ps(S, sid): i64 { _sn_pr(S, sid); return 0; }
fn _dyn_pn(S, noff): i64 { PRSTR(S + 0xEC00000 + noff); return 0; }
fn _dyn_pq(S, noff): i64 {
    _ew("'", 1);
    _ei_pr(S, noff);   # 6.7.17: or a struct (`_ei_sid`)
    _ew("'", 1);
    return 0;
}
# The trait a dyn struct `sid` names (`dyn Show` -> Show's index), -1 when none.
fn _dyn_tx(S, sid): i64 { return _tr_find(S, L64(S + 0x1A6018 + (sid - 1) * 8) + 4); }

# ⛔ 6.7.8 (D5) — FORMING A DYN (the user's decisions 1, 2, 4, 6, 2026-10-07). At a destination typed
# `dyn Tr` the source is classified from its TOKENS, before anything is emitted (`_dyn_src`):
#   COPY   a dyn value — a dyn name, a whole call or method returning a struct, a dyn field: the
#          struct paths take it (and refuse another struct by its sid);
#   FORM   a `*T` the compiler knows — `&p` of an inline struct (a local, a by-value parameter's
#          copy, an inline global), a `*T` local / parameter / global, an untyped impl `self`, a
#          pointer-mode handle, a `*T` field, a call or method returning `*T` — or a DECLARED
#          scalar (a local, a global or a parameter whose annotation names an integer, a float,
#          bool, an enum or a handle: its value is the data word), or a literal (i64, f64, bool);
#   REFUSED by name, at the source (F1-F11): an untyped name (it may hide a pointer, ADR-002), a
#          bare inline struct (no implicit `&`), `&` of a pointer / a scalar / a dyn, a captured
#          name, and every other expression.
# T must have `impl Tr for T` (F6). The pair (Tr, T) is checked ONCE, at its first forming
# (`_dyn_pair_chk`): each member's full signature against the trait's (A3: a parameter's or the
# return's type by its resolved name, untyped = i64), the `self` form a slot can call (decision 2:
# `self: T` of 8 B or less arrives in a register — refused, naming the method), and no async /
# #naked slot. Then its VTABLE — a hidden global, one word per trait member in declaration order,
# each T's method (or T's default instance, decision 6; `T_Trait_m` when the name collides) — is
# registered, and FILLED AT EVERY FORMING SITE (`_dyn_fill`): no target relocates a data word
# (PIE, Mach-O arm64, PE), so the table cannot be built in the image; every site writing the same
# words keeps DCE exact and a `kernel;` build independent of the late replay. A member a dyn cannot
# call (generic, no untyped `self`, variadic) has slot 0, its address never taken. The data word
# is the source's value, the vtable word the table's address; both are stored ADDRESSED into an
# inline aggregate (the declared one, or a frame temp the destination copies from). CHANGELOG [6.7.8]
var _ti_dyn = 0;    # per impl (4096 words): 0 never formed, 1 refused, else (its vtable global + 1) << 1
var _dsr_tp = 0;    # FORM: the type T's name, its bytes ...
var _dsr_tn = 0;    # ... and their count
var _dsr_tsid = 0;  # 6.7.17: ... or the struct it names (1-based), printed as written (`B<i32>`); 0 = print the bytes
var _dsr_ii = 0;    # FORM: the impl of the dyn's trait for T
var _dsr_ds = 0;    # the dyn being formed (its sid), for the refusals' words
var _dsc_tn = 0;    # per frame slot (16384 words): a declared scalar's annotation name — read only behind bit 63 (SLDSC)
var _gv_tn = 0;     # per global: its annotation's name + 1 when a declared scalar, else 0 — written by every declaration
var _gv_tnc = 0;    # its capacity
var _dsc_pend = 0;  # a parameter's annotation (name + 1), from its type token until `_param_record` stamps the slot

# The source spanning tokens [st, en) (`en` its terminator) of a dyn `dsid`: 0 COPY, 1 FORM (the
# pair checked, `_dsr_ii` its impl), 2 REFUSED (reported). Parentheses wrapping the whole source
# are transparent. `top` 1: a destination with no frame at top level (an assignment, a field, an
# argument) refuses a FORM (F11). Emits nothing; the cursor is left alone.
fn _dyn_src(S, st, en, dsid, top): i64 {
    _dsr_ds = dsid;
    var a = st;
    var b = en;
    var k = _pwrap_k(S, st);
    if (k > 0) { if (_pw_end == en) { a = st + k; b = en - k; } }
    var r = _dyn_src_in(S, a, b);
    if (r != 1) { return r; }
    if (top == 1) { if (GINFN(S) != 1) {
            _dyn_err(S, a, "a dyn formed at top level has no frame to be built in - form it inside a fn (a top-level `var G: ", dsid, 0 - 1, " = ..;` declares one)");
            return 2;
        } }
    var ii = _dyn_pair(S, dsid, a);
    if (ii < 0) { return 2; }
    _dsr_ii = ii;
    return 1;
}
fn _dyn_src_in(S, a, b): i64 {
    var t = TOKTYP(S, a);
    if (b == a + 1) {
        if (t == 2) { return _dyn_src_name(S, a); }
        if (t == 1) { return _dyn_lit("i64", 3); }
        if (t == 61) { return _dyn_lit("f64", 3); }
        if (t == 169 || t == 170) { return _dyn_lit("bool", 4); }
    }
    if (b == a + 2) {
        var t1 = TOKTYP(S, a + 1);
        if (t == 7) {
            if (t1 == 1) { return _dyn_lit("i64", 3); }
            if (t1 == 61) { return _dyn_lit("f64", 3); }
        }
        if (t == 27) { if (t1 == 2) { return _dyn_src_addr(S, a); } }
    }
    var ic = _dyn_icall(S, a, b);   # 6.7.13 (D15): `fncall1(&mkd, &q)` is `mkd(&q)`
    if (ic >= 0) { return ic; }
    var mc = _dyn_smchain(S, a, b);   # 6.7.16: a method ending a chain, `w.d.me(1)`, `(*pd).me(1)`
    if (mc >= 0) { return mc; }
    if (t == 2) {
        var c = _dyn_scall(S, a, b);
        if (c >= 0) { return c; }
        c = _dyn_schain(S, a, b);
        if (c >= 0) { return c; }
    }
    var dn = _dyn_amp_name(S, a, b);   # 6.7.16 (D70): `*(&b)` is b
    if (dn >= 0) { return _dyn_src_name(S, dn); }
    return _dyn_f5(S, a);
}
# ⛔ 6.7.16 (D70, the user's decision, 2026-10-20: "`*(&b)` of a bool is a boolean, so it takes the bool overload") —
# `*(& NAME)` / `*&NAME` (any parentheses) of a variable the dereference types as itself — a narrow integer (6.7.16's
# D21), an `f64` / `f32` / `bool` (D70): `_amp_ew` — is NAME as a dyn source, so `var o: dyn Num = *(&b);` takes
# bool's impl, `*(&f)` f64's, as `= b` / `= f` do (the data word is the value it reads). It was refused "cannot form
# dyn Num from this expression". The NAME's token, else -1. CHANGELOG [6.7.16]
fn _dyn_amp_name(S, a, b): i64 {
    if (TOKTYP(S, a) != 8) { return 0 - 1; }
    if (_amp_ew(S, a + 1, b) == 0) { return 0 - 1; }
    return _ie_unparen(S, a + 1, b) + 1;
}
fn _dyn_lit(s, n): i64 {
    _dsr_tp = s;
    _dsr_tn = n;
    _dsr_tsid = 0;
    return 1;
}
# FORM from T named at `noff` (a struct's name, or a declared scalar's annotation).
fn _dyn_tset(S, noff): i64 {
    _dsr_tp = S + 0xEC00000 + noff;
    var n = 0;
    while (load8(_dsr_tp + n) != 0) { n = n + 1; }
    _dsr_tn = n;
    _dsr_tsid = 0;
    return 1;
}
fn _dyn_sform(S, sid): i64 {
    _dyn_tset(S, L64(S + 0x1A6018 + (sid - 1) * 8));
    _dsr_tsid = sid;
    return 1;
}
# One name: a local, a closure's capture, a global.
fn _dyn_src_name(S, a): i64 {
    var nm = TOKVAL(S, a);
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, nm);
        if (li >= 0) { return _dyn_src_local(S, li, a); }
        var c = _dyn_src_cap(S, nm, a);
        if (c >= 0) { return c; }
    }
    var vi = _findvar_core(S, nm);
    if (vi >= 0) { return _dyn_src_global(S, vi, a); }
    return _dyn_f5(S, a);
}
fn _dyn_src_local(S, li, a): i64 {
    var lt = GLTYPE(S, li);
    var s = 0;
    if (lt < 0) { if (lt > 0 - 2048) { s = 0 - lt; } }
    if (GLPTRP(S, li) == 1) {   # a `*T` local or parameter, an untyped impl `self`
        if (s > 0) { return _dyn_sform(S, s); }
        return _dyn_f8p(S, a);
    }
    if (s > 0) {
        if (_dyn_is(S, s) == 1) { return 0; }
        if (GLAGG(S, li) == 0) { return _dyn_sform(S, s); }   # a handle: the slot holds the address
        return _dyn_frf(S, a, "no implicit `&`: write `&", "` (the dyn holds its address)");
    }
    if (lt <= 0 - 2048) { return _dyn_f5(S, a); }   # a vector
    if (GLDSC(S, li) == 1) { return _dyn_tset(S, L64(_dsc_tn + li * 8)); }
    return _dyn_f1(S, a);
}
# A closure's captured name (-1: not one). A captured dyn is a copy; any other capture is
# refused (F4): its declaration is not this body's.
fn _dyn_src_cap(S, nm, a): i64 {
    if (_cl_capturing != 1) { return 0 - 1; }
    if (_cl_env_lidx < 0) { return 0 - 1; }
    var esl = _cl_snap_find(S, nm);
    if (esl < 0) { return 0 - 1; }
    var t = _cl_snap_type(esl);
    if (t < 0) { if (t > 0 - 2048) { if (_dyn_is(S, 0 - t) == 1) { return 0; } } }
    return _dyn_frf(S, a, "a closure's captured name: bind it to a declared variable first (`var n: i64 = ", ";`)");
}
fn _dyn_src_global(S, vi, a): i64 {
    var pm = GVPM(S, vi);
    var gt = GVTYPE(S, vi);
    if (pm == 2) { if (gt > 0) {
            if (_dyn_is(S, gt) == 1) { return 0; }
            return _dyn_frf(S, a, "no implicit `&`: write `&", "` (the dyn holds its address)");
        } }
    if (pm == 1) { if (gt > 0) { return _dyn_sform(S, gt); } }
    var ps = _gv_ptr_sid(S, vi);
    if (ps > 0) { return _dyn_sform(S, ps); }
    if (GVVEC(S, vi) != 0) { return _dyn_f5(S, a); }
    if (gt < 0) { return _dyn_f8p(S, a); }   # a `*T` global, T no struct
    var n1 = _gv_tn_get(vi);
    if (n1 != 0) { return _dyn_tset(S, n1 - 1); }
    return _dyn_f1(S, a);
}
# `& name` at token `a`.
fn _dyn_src_addr(S, a): i64 {
    var nm = TOKVAL(S, a + 1);
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, nm);
        if (li >= 0) {
            var lt = GLTYPE(S, li);
            if (lt <= 0 - 2048) { return _dyn_f5(S, a); }   # a vector
            if (GLPTRP(S, li) == 1) { return _dyn_f3(S, a, 1); }
            if (lt < 0) {
                if (_dyn_is(S, 0 - lt) == 1) { return _dyn_f3d(S, a); }
                if (GLAGG(S, li) == 1) { return _dyn_sform(S, 0 - lt); }
                return _dyn_f3(S, a, 1);   # a handle
            }
            return _dyn_f3(S, a, 0);
        }
        var c = _dyn_src_cap(S, nm, a + 1);
        if (c == 0) { return _dyn_f3d(S, a); }
        if (c > 0) { return c; }
    }
    var vi = _findvar_core(S, nm);
    if (vi < 0) { return _dyn_f5(S, a); }
    var gt = GVTYPE(S, vi);
    if (GVPM(S, vi) == 2) { if (gt > 0) {
            if (_dyn_is(S, gt) == 1) { return _dyn_f3d(S, a); }
            return _dyn_sform(S, gt);
        } }
    if (GVPM(S, vi) == 1) { return _dyn_f3(S, a, 1); }
    if (_gv_ptr_sid(S, vi) > 0) { return _dyn_f3(S, a, 1); }
    if (gt < 0) { return _dyn_f3(S, a, 1); }
    if (GVVEC(S, vi) != 0) { return _dyn_f5(S, a); }
    return _dyn_f3(S, a, 0);
}
# 6.7.16 — a whole method call ending a chain on any receiver at token `a`, ending at `b` (`_mcall_open`'s chain arm:
# `w.d.me(1)`, `mk(1).me(1)`, `(*pd).me(1)`), as `_dyn_scall` takes `x.m(..)`; -1: not one. CHANGELOG [6.7.16]
fn _dyn_smchain(S, a, b): i64 {
    var o = _mcall_open(S, a, 0 - 1);
    if (o < 0) { return 0 - 1; }
    if (_mco_ch == 0) { return 0 - 1; }
    var mf = _mco_mf;
    var mt = _mco_mt;
    if (_call_close(S, o) != b - 1) { return 0 - 1; }
    if (mf < 0) { return 0; }   # the method reports itself
    return _dyn_sfn(S, _mco_inst(S, mf, mt, o), a);
}
# A whole call at token `a` — `f(..)`, `g<..>(..)`, `x.m(..)` — ending at `b` (-1: not one).
fn _dyn_scall(S, a, b): i64 {
    var o = _gcall_open(S, a);
    if (o >= 0) {
        if (_call_close(S, o) != b - 1) { return 0 - 1; }
        var fi = _gen_resolve_call(S, a);
        if (fi < 0) { return 0; }   # the call reports what it cannot resolve
        return _dyn_sfn(S, fi, a);
    }
    var o2 = _mcall_open(S, a, 0 - 1);   # 6.7.15: `x.m<..>(` too, at its explicit instance
    if (o2 < 0) { return 0 - 1; }
    if (_call_close(S, o2) != b - 1) { return 0 - 1; }
    var rs = _recv_sid(S, TOKVAL(S, a));
    if (rs <= 0) { return _dyn_f5(S, a); }
    var mf = _meth_fn_at(S, rs, TOKVAL(S, a + 2), a + 2);   # 6.7.8 (D6): through a dyn, its prototype
    if (mf < 0) { return 0; }   # the method reports itself
    if (o2 != a + 3) { mf = _mcall_xquiet(S, mf, a + 3); }
    return _dyn_sfn(S, mf, a);
}
# ⛔ 6.7.13 — A KNOWN `&f` CALLEE IS A DYN SOURCE AS THE DIRECT CALL IS (D15, the user, 2026-10-15). `var a: dyn Shape =
# fncall1(&mkd, &q);` with `fn mkd(p: *Sq): dyn Shape` was refused "cannot form dyn Shape from this expression" where
# `mkd(&q)` copies the dyn mkd returns: the source arms asked only for a call by name. A whole call through fncallN /
# callptr (token 137, so before the `t == 2` arm) at token `a` ending at `b`, whose first argument is `& IDENT` inside
# any parentheses (`_icall_fti`, the known callee of 6.7.11 / 6.7.13), is read as the call of that fn: a dyn (a
# struct) result is a copy — its two words travel by 6.7.11's known-callee struct result (`_icall_sret` / `_sc_post`)
# — a `*T` result forms, any other is refused. A callee held in a variable is unknown and stays refused (FP6, D31).
# -1: not one. CHANGELOG [6.7.13]
fn _dyn_icall(S, a, b): i64 {
    var o = _icall_open_at(S, a);
    if (o < 0) { return 0 - 1; }
    if (_call_close(S, o) != b - 1) { return 0 - 1; }
    var fti = _icall_fti(S, a);
    if (fti < 0) { return 0 - 1; }
    var fi = FINDFN(S, TOKVAL(S, fti));
    if (fi < 0) { return 0 - 1; }
    return _dyn_sfn(S, fi, a);
}
# A whole call of fn `fi`: a struct result is a copy (the struct paths check its type); a `*T`
# result, T a struct, forms; any other result is refused.
fn _dyn_sfn(S, fi, a): i64 {
    var rs = GFRS(S, fi);
    if (rs > 0) { if (rs < 2048) { return 0; } }
    if (_fn_rpsid != 0) { if (L64(_fn_rpsid + fi * 8) > 0) { return _dyn_sform(S, L64(_fn_rpsid + fi * 8)); } }
    return _dyn_f5(S, a);
}
# A field chain `a.f.g` at token `a` ending at `b` (-1: not one): a dyn leaf is a copy, a `*T`
# leaf (T a struct) or a `Str` field forms; every hop through an inline struct field or a `*T`
# field. A base or field that does not resolve is left to the struct paths (0), which name it.
fn _dyn_schain(S, a, b): i64 {
    if (b - a < 3) { return 0 - 1; }
    var i = a + 1;
    while (i < b) {
        if (TOKTYP(S, i) != 41) { return 0 - 1; }
        if (TOKTYP(S, i + 1) != 2) { return 0 - 1; }
        i = i + 2;
    }
    if (i != b) { return 0 - 1; }
    var sid = _dyn_base_sid(S, TOKVAL(S, a));
    if (sid <= 0) {
        if (_is_enum_name(S, TOKVAL(S, a)) == 1) { return _dyn_f5(S, a); }   # an enum constant
        return 0;
    }
    i = a + 2;
    while (i < b) {
        var fi = FINDFIELD(S, sid - 1, TOKVAL(S, i));
        if (fi < 0) { return 0; }
        var ft = GETFTYPE(S, sid - 1, fi);
        var ps = _fld_ptr_sid(S, sid - 1, fi);
        if (i + 1 == b) {
            if (ps > 0) { return _dyn_sform(S, ps); }
            if (ft > 0) {
                if (_dyn_is(S, ft) == 1) { return 0; }
                if (IS_STR_FIELD(S, ft) == 1) { return _dyn_sform(S, ft); }
            }
            return _dyn_f5(S, a);
        }
        if (ps > 0) { sid = ps; }
        elif (ft > 0) { sid = ft; }
        else { return _dyn_f5(S, a); }
        i = i + 2;
    }
    return _dyn_f5(S, a);
}
# The struct a chain's base name reads fields of (a pointer's pointee), 0 = none.
fn _dyn_base_sid(S, nm): i64 {
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, nm);
        if (li >= 0) {
            var lt = GLTYPE(S, li);
            if (lt < 0) { if (lt > 0 - 2048) { return 0 - lt; } }
            return 0;
        }
        if (_CL_CAP_FIELD_IDX(S, nm) < 0 - 1) { return _cap_fld_sid; }
    }
    var vi = _findvar_core(S, nm);
    if (vi < 0) { return 0; }
    if (GVPM(S, vi) != 0) { if (GVTYPE(S, vi) > 0) { return GVTYPE(S, vi); } }
    return _gv_ptr_sid(S, vi);
}

# The refusals of a source (each at token `a`; 2 = REFUSED).
fn _dyn_fhead(S, a): i64 {
    if (_dyn_ebeg(S, a) == 0) { return 0; }
    PRSTR("cannot form ");
    _dyn_ps(S, _dsr_ds);
    return 1;
}
# F1 — an untyped name (decision 1: under ADR-002 it is an i64 that may hide a pointer).
fn _dyn_f1(S, a): i64 {
    if (_dyn_fhead(S, a) == 0) { return 2; }
    PRSTR(" from ");
    _dyn_pq(S, TOKVAL(S, a));
    PRSTR(" - an untyped name may hold a pointer (ADR-002): pass `&");
    _dyn_pn(S, TOKVAL(S, a));
    PRSTR("` for a struct, or bind it to a declared type (`var n: i64 = ");
    _dyn_pn(S, TOKVAL(S, a));
    PRSTR(";`)");
    _dyn_eend(S);
    return 2;
}
# F2 / F4 — "cannot form dyn S from 'x' - <w1>x<w2>".
fn _dyn_frf(S, a, w1, w2): i64 {
    if (_dyn_fhead(S, a) == 0) { return 2; }
    PRSTR(" from ");
    _dyn_pq(S, TOKVAL(S, a));
    PRSTR(" - ");
    PRSTR(w1);
    _dyn_pn(S, TOKVAL(S, a));
    PRSTR(w2);
    _dyn_eend(S);
    return 2;
}
# F3 — `&x` of a pointer (`k` 1: a `*T`, a handle), of a scalar (0), of a dyn (`_dyn_f3d`).
fn _dyn_f3(S, a, k): i64 {
    if (_dyn_fhead(S, a) == 0) { return 2; }
    PRSTR(" from `&");
    _dyn_pn(S, TOKVAL(S, a + 1));
    if (k == 1) { PRSTR("` - it is a pointer already: write `"); }
    else { PRSTR("` - a dyn of a scalar holds its value: write `"); }
    _dyn_pn(S, TOKVAL(S, a + 1));
    PRSTR("`");
    _dyn_eend(S);
    return 2;
}
fn _dyn_f3d(S, a): i64 {
    if (_dyn_fhead(S, a) == 0) { return 2; }
    PRSTR(" from `&");
    _dyn_pn(S, TOKVAL(S, a + 1));
    PRSTR("` - it is a dyn: copy it whole (`= ");
    _dyn_pn(S, TOKVAL(S, a + 1));
    PRSTR("`)");
    _dyn_eend(S);
    return 2;
}
# F5 — any other expression.
fn _dyn_f5(S, a): i64 {
    if (_dyn_fhead(S, a) == 0) { return 2; }
    PRSTR(" from this expression - a dyn is formed from a `*T` the compiler knows (`&p`, a `*T` name, a pointer-mode handle, a `*T` field or call), a declared scalar or a literal: bind it to a declared variable first");
    _dyn_eend(S);
    return 2;
}
# F5 — a struct literal's element for a dyn field (`_spi_nested`) that is no whole dyn and no literal
# number (`H { 1, 2, 3, 4 }` writes the words: V8): a source the literal would have to FORM — `&p`,
# a name, a call. Refused, the element taken whole (1); `est` its first token (-1: carried in).
fn _dyn_lit_form(S, est, ft): i64 {
    if (est < 0) { return 0; }
    var t = TOKTYP(S, est);
    if (t == 1 || t == 61 || t == 7 || t == 169 || t == 170) { return 0; }
    if (_dyn_ebeg(S, est) == 0) { return 1; }
    PRSTR("a struct literal does not form a dyn - form it first (`var d: ");
    _dyn_ps(S, ft);
    PRSTR(" = ..;`) and write `d` here");
    _dyn_eend(S);
    return 1;
}
# F8 — a pointer to a scalar: a scalar's dyn holds its value.
fn _dyn_f8p(S, a): i64 {
    if (_dyn_fhead(S, a) == 0) { return 2; }
    PRSTR(" from ");
    _dyn_pq(S, TOKVAL(S, a));
    PRSTR(" - a pointer to a scalar: the dyn of a scalar holds its value (bind it: `var n: i64 = *");
    _dyn_pn(S, TOKVAL(S, a));
    PRSTR(";`)");
    _dyn_eend(S);
    return 2;
}

# ── the pair (Tr, T): its impl, its one check, its vtable ───────────────────────────────────────
# The impl of dyn `dsid`'s trait for T (`_dsr_tp` / `_dsr_tn`), checked and its vtable registered on
# its first forming, reported at token `ti`; -1 = refused (F6, or the pair's own refusal).
fn _dyn_pair(S, dsid, ti): i64 {
