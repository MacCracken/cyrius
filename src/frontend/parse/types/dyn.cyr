}
# The tokens [a, ae) as entries at `x`, a `>>` two `>` (20) and a `>>>` three: their count, -1 past 256.
fn _tyn_expand(S, a, ae, x): i64 {
    var n = 0;
    while (a < ae) {
        var t = TOKTYP(S, a);
        var r = 1;
        if (t == 39) { r = 2; t = 20; }
        if (t == 152) { r = 3; t = 20; }
        while (r > 0) {
            if (n >= 256) { return 0 - 1; }
