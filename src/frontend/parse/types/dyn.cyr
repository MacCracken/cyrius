}
fn _dyn_ty_i64(S, i, e): i64 {
    if (e == i) { return 1; }
    if (e != i + 1) { return 0; }
    if (TOKTYP(S, i) != 2) { return 0; }
    if (_tn_resolve_at(S, i) == _tn_code(1, 8)) { return 1; }
    return 0;
