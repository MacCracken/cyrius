    var n = 0;
    while (n < k) {
        q = _pl_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0; }
        q = q + 1;
        n = n + 1;
    }
    _dps_va = 0;
    _dps_nm = q;
    _dps_ts = q + 1;
    _dps_te = q + 1;
