    if (TOKTYP(S, i) == 8) {
        p = 1;
        i = i + 1;
    }
    if (e != i + 1) { return 8; }
    if (TOKTYP(S, i) != 2) { return 8; }
    if (STREQ(S, TOKVAL(S, i), tn) == 0) { return 8; }
