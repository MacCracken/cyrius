# Entry `i` a generic struct's name whose `<..>` (entry i + 1) holds only `i64`s: the entry after its `>`, else 0.
fn _tyn_i64_list(S, x, n, i): i64 {
    if (L64(x + i * 16) != 2) { return 0; }
    if (i + 1 >= n) { return 0; }
