# The `self` a slot method (`fn` token `fp`) of impl `ii` declares: 0 = one a dyn's data word
# feeds (untyped; for a struct T `self: *T` or a `self: T` over 8 B — address-passed; for a scalar
# T `self: T`); 1 = decision 2 (`self: T`, T a struct of 8 B or less); 8 `self: Q`, Q not T; 9 a
# scalar T's `self: *T`.
fn _dyn_self_ok(S, ii, fp): i64 {
    var o = _tr_paren(S, fp);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, 0) == 0) { return 0; }
    var i = _dps_ts;
    var e = _dps_te;
    if (i == e) { return 0; }
    var tn = L64(_ti_tab + ii * 64 + 8);
    var sid = FINDSTRUCT(S, tn);
