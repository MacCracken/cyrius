fn _dyn_name_eq(S, a, b): i64 {
    var ca = _tn_resolve_at(S, a);
    if (ca != 0) {
        if (ca == _tn_resolve_at(S, b)) { return 1; }
        return 0;
    }
    if (_tn_resolve_at(S, b) != 0) { return 0; }
    return STREQ(S, TOKVAL(S, a), TOKVAL(S, b));
