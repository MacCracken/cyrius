var _dsq_k = 0;   # the trait's differing parameter (its name token)
var _dsq_un = 0;  # 1 when a side of the differing type (3 / 4) is unannotated: F8's "(.. is i64)" hint applies
fn _dyn_sig_eq(S, tp, fp): i64 {
