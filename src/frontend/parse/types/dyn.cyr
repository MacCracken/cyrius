# Two types' tokens [a, ae) and [b, be): 1 = the same type. Absent is i64.
fn _dyn_ty_eq(S, a, ae, b, be): i64 {
    if (a == ae) { return _dyn_ty_i64(S, b, be); }
    if (b == be) { return _dyn_ty_i64(S, a, ae); }
    if (ae - a != be - b) { return 0; }
    while (a < ae) {
        var t = TOKTYP(S, a);
        if (t != TOKTYP(S, b)) { return 0; }
        if (t == 2) { if (_dyn_name_eq(S, a, b) == 0) { return 0; } }
        if (t == 1) { if (TOKVAL(S, a) != TOKVAL(S, b)) { return 0; } }
