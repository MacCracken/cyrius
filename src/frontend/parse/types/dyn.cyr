        PRSTR("parameter ");
        _dyn_pq(S, TOKVAL(S, _dsq_k));
        PRSTR(" has another type");
        if (_dsq_un == 1) { PRSTR(" (an untyped parameter is i64)"); }   # only when a side is untyped [6.7.16]
    }
    elif (d == 4) {
        PRSTR("the return type differs");
        if (_dsq_un == 1) { PRSTR(" (no return type is i64)"); }
    }
    elif (d == 5) { PRSTR("the parameter count differs"); }
    elif (d == 6) { PRSTR("one is generic, the other is not"); }
    elif (d == 7) { PRSTR("a variadic `...` differs"); }
    elif (d == 8) {
        PRSTR("its `self` is not ");
        _dyn_pn(S, L64(_ti_tab + ii * 64 + 8));
        PRSTR(" (declare `self` untyped)");
    }
    elif (d == 10) { PRSTR("it returns a `: stack` pair (a tag and a payload) where the trait declares one value - declare the return, in the trait and the impl, as the enum it returns (`: Result`)"); }
    else { PRSTR("`self: *T` - the dyn of a scalar holds its value, not a pointer to it (declare `self` untyped, or `self: T`)"); }
    _dyn_eend(S);
    return 0;
}
# F9 — an `async` (134) or `#naked` (133) slot method: a dyn calls a plain fn.
fn _dyn_f9(S, ti, ii, m, pf): i64 {
    if (_dyn_mhead(S, ti, ii, m) == 0) { return 0; }
    if (pf == 134) { PRSTR(" is `async`"); } else { PRSTR(" is `#naked`"); }
    PRSTR(" - a dyn calls its methods as plain fns");
    _dyn_eend(S);
    return 0;
}

# ── the emission ────────────────────────────────────────────────────────────────────────────────
# THE FILL, at every forming site (idempotent: every site writes the same words): slot k of impl
# `ii`'s vtable = its fn's address (a fixup-type-3 load, as `&f`), stored addressed. rax = the
# table's address. Every emitter is IR-recorded.
fn _dyn_fill(S, ii): i64 {
    var tx = L64(_ti_tab + ii * 64 + 48);
    var vt = (L64(_ti_dyn + ii * 8) >> 1) - 1;
    var k0 = L64(_tr_tab + tx * 32 + 8);
    var n = L64(_tr_tab + tx * 32 + 16);
    var j = 0;
    while (j < n) {
        var fi = _dyn_slot_fi(S, ii, k0 + j);
        if (fi >= 0) {
            var fc = GFCNT(S);
            if (fc >= 1048576) {
                _ew("error: fixup table full (1048576)\n", 34);
                _die(1);
            }
            ELOAD_FN_ADDR(S, _fixup_base + fc * 16, fc, fi);
            EPUSHR(S);
            EVADDR_X1(S, vt);
            if (j > 0) { EADDIMM_X1(S, j * 8); }
            EPOPR(S);
            ESTOC(S);
        }
        j = j + 1;
    }
    EVADDR(S, vt);
    return 0;
}
# The data word was pushed (the source's value): build the dyn `dsid` of impl `ii` into the inline
# aggregate `idx` (`_resolve_field_base_addr`'s encoding: `0 - 2 - slot` a frame slot, >= 0 a
# global) — word 1 the vtable, word 0 the data — through addressed stores.
fn _dyn_build(S, ii, dsid, idx): i64 {
    _dyn_fill(S, ii);
    EPUSHR(S);
    _IR_REC0(S, IR_RAW_EMIT);
    _resolve_field_base_addr(S, idx, dsid);
    EADDIMM_X1(S, 8);
    EPOPR(S);
    ESTOC(S);
    _IR_REC0(S, IR_RAW_EMIT);
    _resolve_field_base_addr(S, idx, dsid);
    EPOPR(S);
    ESTOC(S);
    return 0;
}
# The source (cursor on it) evaluated and its dyn built into aggregate `idx`. The impl is read before
# the source is parsed: a dyn formed inside it (an argument of the call that returns the `*T`) is
# classified in between.
fn _dyn_emit(S, dsid, idx): i64 {
    var ii = _dsr_ii;
    PCMPE(S);
    EPUSHR(S);
    _dyn_build(S, ii, dsid, idx);
    return 0;
}
# The terminator of a source from token `st`: its first depth-0 `term`, or the `)` / `]` / `}` that
# closes what it sits in. 6.7.17: a statement's source (`term` `;`) also ends at a depth-0 statement keyword — its
# `;` is missing there (`var o: dyn Show = &p` then `return zz;` was "cannot form dyn Show from this expression", the
# `return` and `zz` read as the source). Never at the source's first token: an `if` / `match` expression there is the
# source (refused by its own words, not "expected ';', got if"). CHANGELOG [6.7.17]
fn _dyn_ext(S, st, term): i64 {
    var k = st;
    var d = 0;
    var n = GTCNT(S);
    while (k < n) {
        var t = TOKTYP(S, k);
        if (t == 12) { return k; }
        if (d == 0) {
            if (t == term) { return k; }
            if (term == 5) { if (k > st) { if (_sync_kw_at(S, k, t) == 1) { return k; } } }
        }
        if (t == 10 || t == 28 || t == 13) { d = d + 1; }
        if (t == 11 || t == 29 || t == 14) {
            if (d == 0) { return k; }
            d = d - 1;
        }
        k = k + 1;
    }
    return k;
}

# ── the destinations (each a first-line hook in a small helper) ────────────────────────────────
# `var o: dyn S = src;` (PARSE_VAR, through `_tup_var`; cursor on `=`): 1 = declared (the `;`
# consumed); 0 = a copy, for the struct paths. In a fn the block is reserved with its span before
# the source is parsed and named after (the source reads an outer `o`); a global after the first
# statement is registered inline after its source. A refused source still declares the name.
fn _dyn_var_init(S, noff, dsid): i64 {
    var dti = GTI(S);
    var st = dti + 1;
    var en = _dyn_ext(S, st, 5);
    var c = _dyn_src(S, st, en, dsid, 0);
    if (c == 0) { return 0; }
    STI(S, st);
    if (GINFN(S) == 1) {
        var named = _tup_lres(S, noff, 2);
        if (named >= 0) {
            if (c == 1) { _dyn_emit(S, dsid, 0 - 2 - named); }
            _tup_lname(S, named, noff, dsid);
        }
    } else {
        var ii = _dsr_ii;
        if (c == 1) {
            PCMPE(S);
            EPUSHR(S);
        }
        var vc = _tup_greg(S, noff, dsid);
        if (c == 1) { _dyn_build(S, ii, dsid, vc); }
        SLVAR(S, vc);
        _GVAR_VIS(S, vc, dti);
        SVCNT(S, vc + 1);
    }
    STI(S, en);
    _expect_step(S, 5);
    return 1;
}
# The declaration zone's `var G: dyn S = src;` (EMIT_GVAR_INITS, through `_gvi_tuple`; cursor on
# the source): pass 1 registered G inline (`_gci_inline`). 1 = done (the `;` consumed).
fn _gvi_dyn(S, gi, idx, gps, sti): i64 {
    if (gps >= 0) { return 0; }
    if (gps <= 0 - 2048) { return 0; }
    var dsid = 0 - gps;
    if (_dyn_is(S, dsid) == 0) { return 0; }
    var st = GTI(S);
    var en = _dyn_ext(S, st, 5);
    var c = _dyn_src(S, st, en, dsid, 0);
    if (c == 0) { return 0; }   # a whole method's 16 B result: `_gvi_expr` refuses it (`_sc_global_pair`)
    if (c == 1) {
        if (idx >= 0) { if (GVPM(S, idx) == 2) { if (GVTYPE(S, idx) == dsid) {
                    _dyn_emit(S, dsid, idx);
                    _gv_slvar(S, idx);
                } } }
    }
    STI(S, en);
    _gvk_left(S, gi, sti, idx);
    _expect_step(S, 5);
    return 1;
}
# `o = src;` into a dyn variable (`_try_aggregate_copy_assign`'s first line; a for step's `term` 11):
# built in a frame temp, then copied in as a struct call's result is. 1 = done (`term` consumed).
fn _dyn_asg(S, noff, term): i64 {
    if (_dyn_nx == 0) { return 0; }
    var n = _agc_operand(S, noff);
    if (_agc_t >= 0) { return 0; }
    var dsid = 0 - _agc_t;
    if (_dyn_is(S, dsid) == 0) { return 0; }
    var dli = _agc_li;
    var dgv = _agc_gvi;
    if (_agc_pp != 0) { dli = _AGC_DREF(dli); }
    var st = GTI(S);
    var en = _dyn_ext(S, st, term);
    var c = _dyn_src(S, st, en, dsid, 1);
    if (c == 0) { return 0; }
    if (c == 1) {
        var t = _agg_temp(S, dsid);
        _dyn_emit(S, dsid, 0 - 2 - t);
        _agc_from_temp(S, t, dli, dgv, n, dsid);
    }
    STI(S, en);
    _expect_step(S, term);
    return 1;
}
# `h.o = src;` / `hp.o = src;` (`_fsc_src`'s first lines, `ft` the field's dyn): built in a frame
# temp recorded as the copy's source (1); a refused source leaves 0 in rax for the ordinary store
# (2, the source's first token marked reported); 0 = a copy.
fn _dyn_fsc(S, ft, term): i64 {
    var st = GTI(S);
    var en = _dyn_ext(S, st, term);
    var c = _dyn_src(S, st, en, ft, 1);
    if (c == 0) { return 0; }
    if (c == 2) {
        _tn_once(S, st);
        STI(S, en);
        EMOVI(S, 0);
        return 2;
    }
    var t = _agg_temp(S, ft);
    _dyn_emit(S, ft, 0 - 2 - t);
    _fsc_reset();
    _fsc_li = t;
    return 1;
}
# An argument to a `o: dyn S` parameter (`_try_push_struct_addr_arg`): built in a frame temp and
# its address pushed — an address in this frame, so a tail call diverts (`_sarg_escapes`). 1 =
# pushed; 0 = a copy (the struct arms).
fn _dyn_sarg(S, fi, argc, tail): i64 {
    if (_dyn_nx == 0) { return 0; }
    var ps = GFPSID(S, fi, argc);
    if (_dyn_is(S, ps) == 0) { return 0; }
    var st = GTI(S);
    var en = _arg_next(S, st);
    var c = _dyn_src(S, st, en, ps, 1);
    if (c == 0) { return 0; }
    if (c == 1) {
        var t = _agg_temp(S, ps);
        _dyn_emit(S, ps, 0 - 2 - t);
        _sarg_escapes(fi, argc, tail);
        EFLADDR(S, t);
    } else {
        STI(S, en);
        EMOVI(S, 0);
    }
    EPUSHR(S);
    return 1;
}
# `return src;` in a fn returning a dyn (`_ret_struct_pair`, after `_ret_peel`): built in a frame
# temp and loaded as the pair. 1 = done; 0 = a copy (the pair arms).
fn _dyn_ret(S): i64 {
    var rs = _cur_fn_ret_sid;
    if (_dyn_is(S, rs) == 0) { return 0; }
    var st = GTI(S);
    var en = _dyn_ext(S, st, _ret_term);
    var c = _dyn_src(S, st, en, rs, 0);
    if (c == 0) { return 0; }
    var t = 0;
    if (c == 1) {
        t = _agg_temp(S, rs);
        _dyn_emit(S, rs, 0 - 2 - t);
    }
    STI(S, en);
    _ret_end(S);
    if (c == 1) {
        EFLLOAD_STRUCT_INT_PAIR(S, t);
        var rp = EJMP0(S);
        vec_push(rp_vec, rp);
    }
    return 1;
}
