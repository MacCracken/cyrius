# ⛔ 6.7.16 — A PARAMETER TYPE ITS OWN READER REFUSES IS THAT REFUSAL ALONE, as a return is (`_dyn_ret_hand`): the
# member's reader (`_trs_type`) or the method's (PARSE_FN_DEF) already said `n: Nope`, `p: *Pt<i64>` (D7) or
# `b: *Box<i64, Pt>` (D5), and the pair check added "parameter 'p' has another type" beside it. Such a parameter is
# stepped and the rest of the signature compared, so a later parameter that differs still reports. Judged by the names
# a reader reads (`_ty_rd_scan`, a parameter's set: `s: Str`, a vector, a type parameter are types); a name inside an
# unread `Result<..>` is refused by no one and keeps the site's line. 1 = either side is such a type. CHANGELOG [6.7.16]
fn _dsq_rf_of(S, xs, xe, ys, ye): i64 {
    if (_dsq_rf_one(S, xs, xe) == 1) { return 1; }
    return _dsq_rf_one(S, ys, ye);
}
# One side: a slice behind any `*`s (`[T]`, `slice<T>`, `*[T]`) or a bare `u128` — each reader's refusal of a
# parameter (6.7.8, 6.7.14) — or a name a reader reads and refuses.
fn _dsq_rf_one(S, a, ae): i64 {
    if (a == ae) { return 0; }
    if (TOKTYP(S, a) == 105) { return 1; }   # `*u128` is a type
    var i = a;
