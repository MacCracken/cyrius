# ⛔ 6.7.15 (D4) — TWO TYPES THE SAME, HOWEVER SPELLED: `_dyn_ty_eq` after reading both spellings the way the
# annotation reader does — a `>>` / `>>>` as two / three closing `>`, and a generic struct's list holding only `i64`s
# as its base struct (`Box<i64>` IS `Box`, 6.6.10's rule; `Box<Box<i64> >` is `Box<Box>`). The impl's return check
# compared tokens, so `Box<Box<i64>>` against `Box<Box<i64> >`, and `Box<i64>` against `Box`, were "returns .., trait
# declares ..", where both compiled and ran. Nothing is minted. 1 = the same type. CHANGELOG [6.7.15]
var _tyn_buf = 0;   # four areas of 256 entries (a token's kind, then its index): each side's expanded, then folded
fn _ty_norm_eq(S, a, ae, b, be): i64 {
    if (_dyn_ty_eq(S, a, ae, b, be) == 1) { return 1; }
    if (a == ae || b == be) { return 0; }
