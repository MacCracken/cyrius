    var d = 0;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (d == 0) { if (t == 5 || t == 13) { _dps_te = i; return c + 2; } }
        d = _pl_tdepth(t, d);
        i = i + 1;
