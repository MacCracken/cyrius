# PARSER — types: a `*T`'s step (`_sl_ptr_type`, `_ps_*`), the pointer and slice marks on locals and globals (`_gv_*`),
# and the double-pointer pins (`_pp_*`).
# ================================================================
# Split from parse/types.cyr at 6.7.18, unchanged; parse.cyr includes parse/types/ in source order. CHANGELOG [6.7.18]

# ⛔ 6.6.17 — `p + n` ON A `*T` STEPS sizeof(T) ELEMENTS, AT EVERY SITE (the user's decision,
# 2026-10-05). The step used to depend on WHERE the pointer was declared: a local `*i8` / `*i16` /
# `*i32` stepped 1 and every other local `*T` 8 (so `*u8` stepped 8 and `*Pt` 8); a parameter 1
# whatever T (a `*f32` parameter was even an f32, so `p + 1` was a float add, and a `*Pt` one
# dispatched `Pt_add`); a closure-captured `*T` 1; a declaration-block global 8; a global after
# the first statement 1/2/4/8 by T; and `p += n` 1 everywhere. Measured across ~/Repos: no source
# declares a `*T` at all, so nothing relied on the old steps (drafts b7-measure).
# A `*T` slot stays a full 8-byte word (6.6.16 C8: a narrow SLTYPE truncated the pointer). The
# step is carried on the slot as a MARK in the slice-width table, `0 - 0x7E00 - step` (6.7.8: the
# step WORD, `_ps_word` — T's kind in bits 40-47, so the mark stays under 2^48 in magnitude), read only
# when bit 56 of the depth word says the slot is a typed pointer (SLPTRP — set here for a local,
# by `_param_record` for a parameter): the slice-width table is not reset for a parameter's slot,
# so a mark is only trusted behind that bit, which every slot gets fresh. A step-8 local keeps
# SLTYPE 8, the load path it always had. The mark rides the closure snapshot with the depth word
# (`_cl_snap_ptr_word`). CHANGELOG [6.6.17]
# `ps` is PARSE_VAR's pscale: > 0 a pointer's step; 0 or `0 - sid` / a vector descriptor for
# anything else, which is the SLTYPE as it stands.
# ⛔ 6.6.17 — a `*Struct` local takes dot syntax like a `p: *Struct` parameter (`p.val`,
# `p.next.val`, `p.m()`; it was "no struct type in scope"): its SLTYPE is `0 - sid` with no
# inline mark (`_sl_marks` clears one), so field access reads THROUGH the slot, while a value read
# stays a plain pointer word (`_load_lt`, behind the slot's bit 56) and `p = p.next` rebinds it.
# `ann` is the annotation's first token. A generic instance's `var t: *T` reads T under the instance's
# binding (`_ptr_ann_sid_tp`), so T bound to a struct is that struct's receiver, as `p: *T` is; a scalar
# T stays a plain pointer with T's step. CHANGELOG [6.7.15]
fn _sl_ptr_type(S, li, ps, ann): i64 {
    if (ps < 0) { _tup_ptr_refuse(S, 0 - ps, ann, L64(S + 0x5D9D000 + li * 8)); }   # 6.7.7: never a pointer-mode tuple
    if (ps > 0) {
        var sid = _ptr_ann_sid_tp(S, ann);
        if (sid > 0) { SLTYPE(S, li, 0 - sid); return 0; }
        if (ps != 8) { SLTYPE(S, li, 0); return 0; }
    }
    SLTYPE(S, li, ps);
    return 0;
}
# ⛔ 6.7.7 (B4) — A TUPLE-TYPED DECLARATION IS NEVER POINTER-MODE. A struct over 8 B declared from
# an expression (`var p: P = mk();`) leaves its slot holding an ADDRESS; no expression's value is a
# tuple's address, so such an initialiser into a tuple is refused by name — it stored one word (the
# struct first-word rule). Every source that IS a tuple (another tuple, a tuple field) takes its own
# copy path before a declaration gets here. `ti` is the annotation's `(`, where it is reported; an
# annotation with no `=` after it (`var G: (i64, i64);` at top level) is left to the "uninitialized"
# refusal its declaration gets anyway. CHANGELOG [6.7.7]
fn _tup_ptr_refuse(S, sid, ti, noff): i64 {
    if (_dyn_is(S, sid) == 1) {   # 6.7.8: nor is a dyn (`var o: dyn Show = 5;`)
        if (TOKTYP(S, ti + 1) != 4) { return 0; }
        if (_dyn_src_call(S, ti + 2, sid) == 1) { return 0; }   # a call of it judged itself (top level)
        return _dyn_err(S, ti, "cannot initialize ", sid, noff, " with a value that is not a dyn");
    }
    if (_tup_is(S, sid) == 0) { return 0; }
    if (TOKTYP(S, _call_close(S, ti) + 1) != 4) { return 0; }
    return _tup_err(S, ti, "cannot initialize tuple ", noff, " with a value that is not a tuple");
}
# Pass 1's (PARSE_GVAR_REG): a tuple annotation over a lone name, or its field chain, that is no
# global yet is left to the replay, which sees every global — a whole tuple declared below is
# `_gci_below`'s refusal (the real cause; pass 1's generic "not a tuple" came first, a second error),
# anything else the replay's R12 (`_gvi_tup_late`). CHANGELOG [6.7.11]
# 6.7.16: and so is a whole struct or tuple VALUE source of another type declared above (`_gci_src`: `var t: (i64, i64)
# = GSU;`, GSU a struct `U` or a 3-tuple global, `= GW.s`), which the replay's `_gci_init` refuses by name as a fn and
# the first statement's arm do ("cannot copy 'GSU' into a variable of a different struct/vector type: 't'") — pass 1's
# "cannot initialize tuple 't' with a value that is not a tuple" came first, a second error (and for a tuple, false).
fn _tup_svtype_p1(S, vi, sid, noff, ti): i64 {
    if (_tup_is(S, sid) == 1) { if (_tup_src_replay(S, _call_close(S, ti) + 1) == 1) {
            SVTYPE(S, vi, sid);
            return 0;
        } }
    return _tup_svtype(S, vi, sid, noff, ti);
}
# 1 when the initializer after the `=` at token `eq` is the replay's to judge: a name no global yet (`_tup_src_later`)
# or a whole struct / tuple value source (`_gci_src`).
fn _tup_src_replay(S, eq): i64 {
    if (_tup_src_later(S, eq) == 1) { return 1; }
    if (TOKTYP(S, eq) != 4) { return 0; }
    if (_gci_src(S, eq + 1) > 0) { return 1; }
    return 0;
}
# 1 when token `eq` is the `=` of `= NAME ;` / `= NAME.f ..;` (parenthesised or not) and NAME is no
# global yet.
fn _tup_src_later(S, eq): i64 {
    if (TOKTYP(S, eq) != 4) { return 0; }
    var ti = eq + 1;
    var tt = 5;
    if (TOKTYP(S, ti) == 10) {
        var k = _pwrap_k(S, ti);
        if (TOKTYP(S, _pw_end) != 5) { return 0; }
        ti = ti + k;
        tt = 11;
    }
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (TOKTYP(S, ti + 1) != tt) { if (TOKTYP(S, ti + 1) != 41) { return 0; } }
    if (_findvar_core(S, TOKVAL(S, ti)) >= 0) { return 0; }
    return 1;
}
# A global's struct type, the pointer-mode test above first (one call where SVTYPE was).
fn _tup_svtype(S, vi, sid, noff, ti): i64 {
    _tup_ptr_refuse(S, sid, ti, noff);
    SVTYPE(S, vi, sid);
    return 0;
}
# 6.7.6 (Break 1, lane D) — the LAST marks of a scalar local's / global's registration: `bool`
# (6.7.3) and declared INTEGER (`st` = the annotation's integer width, 1..8; 16 is u128 / a slice),
# which routes `println(n)` to its `_int` overload (_od_arg_kind, parse/fn/call.cyr). A global's marks are
# the last declaration's (0 clears a redeclaration's). 6.7.8 (C2-3a): and a `*T`'s element kind
# (`ann` the annotation's first token) — a global's beside GVTYPE, so it is no new shape; 6.7.8 (D5):
# and a declared scalar's annotation name, the type a dyn formed from it names.
# CHANGELOG [6.7.6]
fn _sl_last_marks(S, li, lbool, st, ann): i64 {
    SLBOOL(S, li, lbool);
    if (st >= 1) { if (st <= 8) { SLINTD(S, li); } }
    if (GLPTRP(S, li) == 1) { _sl_ptr_ed(S, li, ann); }
    _dsc_stamp(S, li, _dsc_name(S, ann));   # 6.7.8 (D5): a declared scalar a dyn is formed from
    _ann_refd_bind_l(S, li);   # 6.7.16: a refused annotation's stand-down is this slot's
    return 0;
}
fn _gv_last_marks(S, vi, b, st, ann): i64 {
    SVBOOL(S, vi, b);
    _ann_refd_bind_g(S, vi);   # 6.7.16: a refused annotation's stand-down is this global's (after the fold)
    _gv_ped_set(vi, _ek_of_ptr_ann(S, ann));
    _gv_pvd_set(vi, _ek_vd(S, ann));   # 6.7.12: a `*V`'s vector
    _gv_ppn_set(vi, _ek_pin(S, ann));  # 6.7.13: a `**T`'s pointee
    _gv_tn_set(S, vi, ann);   # 6.7.8 (D5)
    var n = 0;
    if (st >= 1) { if (st <= 8) { n = 1; } }
    SVINTD(S, vi, n);
    var w = 0;   # 6.7.6 (D2): a `u128` (a slice shares the width; `ann` is the annotation's type token)
    if (st == 16) { if (TOKTYP(S, ann) == 105) { w = 1; } }
    SVW128(S, vi, w);
    return 0;
}
fn _sl_marks(S, li, sgn, st, sw, ps): i64 {
    if (sgn == 1) { if (sw == 0) { SSLICE_W(S, li, 0 - st); } }
    if (ps > 0) {
        SSLICE_W(S, li, 0 - 0x7E00 - ps);
        SLAGG(S, li, 0);                 # a pointer is never an inline struct (MARK_SMALL_STRUCT)
        SLPTRP(S, li);
    }
    return 0;
}
# The struct a pointer annotation `*T` at token `ann` (its `*`) points at — T a struct or a
# generic instance, one `*` — else 0.
fn _ptr_ann_sid(S, ann): i64 {
    if (ann <= 0) { return 0; }
    if (TOKTYP(S, ann) != 8) { return 0; }
    return _ptr_tok_sid(S, ann + 1);
}
# ⛔ 6.7.11 — ... and a type parameter T bound to a struct (`_tp_resolve`): a generic instance's `: *T` return
# is read under the instance's binding (`_ret_ptr_annot`), where `FINDSTRUCT('T')` finds nothing — so the
# instance recorded T's step but not its struct, and `gpg<S>()` was no `*S` (issues/2026-10-13-generic-
# pointer-returning-call-as-struct-source.md). A scalar binding is no struct. The return and a `*T` local
# (`_sl_ptr_type`, 6.7.15) read it.
fn _ptr_ann_sid_tp(S, ann): i64 {
    if (ann <= 0) { return 0; }
    if (TOKTYP(S, ann) != 8) { return 0; }
    if (TOKTYP(S, ann + 1) == 2) {
        var b = _tp_resolve(S, TOKVAL(S, ann + 1));
        if (b > 0) { return b; }
        if (b < 0) { return 0; }
    }
    return _ptr_tok_sid(S, ann + 1);
}
fn _ptr_tok_sid(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var sid = FINDSTRUCT(S, TOKVAL(S, ti));
    if (sid <= 0) { return 0; }
    if (TOKTYP(S, ti + 1) != 19) { return sid; }
    if (GSTP(S, sid - 1) == 0) { return sid; }   # 6.7.15 (D6): `*Pt<..>` is refused where its annotation is read
    var sv = GTI(S);
    STI(S, ti + 1);
    var g = _gen_ann_sid(S, sid);
    STI(S, sv);
    if (g > 0) { return g; }
    return sid;
}
# A `*T` GLOBAL: its step as before (`0 - ps` in the var-type table), and T's struct, when it is
# one, in a side table — so `G.val` reads through it (`_gv_recv_sid`, `_gv_holds_addr`).
var _gv_psid = 0;
fn _gv_ptr_type(S, vi, ps, ann): i64 {
    SVTYPE(S, vi, 0 - ps);
    var sid = _ptr_ann_sid(S, ann);
    if (sid <= 0) { return 0; }
    if (_gv_psid == 0) { _gv_psid = alloc(1048576 * 8); }
    if (vi < 1048576) { S64(_gv_psid + vi * 8, sid); }
    return 0;
}
# A `*T` global's element kind (6.7.8, C2-3a; `_ps_word`): a byte per global, written with the
# last declaration's marks (`_gv_last_marks`) and NOT part of `_gv_same_shape`, so `var g: *u8`
# redeclared `var g: *i8` folds as it always did (the later declaration's kind).
var _gv_ped = 0;
fn _gv_ped_set(vi, ed): i64 {
    if (_gv_ped == 0) {
        if (ed == 0) { return 0; }
        _gv_ped = alloc(1048576);
    }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    store8(_gv_ped + vi, ed);
    return 0;
}
fn _gv_ped_get(vi): i64 {
    if (_gv_ped == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    return load8(_gv_ped + vi);
}
# 6.7.12: and a `*V` global's vector (`_ek_vd`, bits 48-55 of the step word), a byte per global the same way.
var _gv_pvd = 0;
fn _gv_pvd_set(vi, vd): i64 {
    if (vd != 0) { _vty_any = 1; }   # 6.7.17: a `*V` global (`_vval_at` reads `*GP`)
    if (_gv_pvd == 0) {
        if (vd == 0) { return 0; }
        _gv_pvd = alloc(1048576);
    }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    store8(_gv_pvd + vi, vd);
    return 0;
}
fn _gv_pvd_get(vi): i64 {
    if (_gv_pvd == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    return load8(_gv_pvd + vi);
}
# 6.7.13: and a value-form vector global's own vector (`var G: f64v2 = 0;` — GVVEC records only its words), a byte per
# global the same way (the descriptor less 2048), for `*&G` (`_name_vty`, parse/expr/deref.cyr).
var _gv_vvd = 0;
fn _gv_vvd_set(vi, vd): i64 {
    if (vd != 0) { _vty_any = 1; }   # 6.7.17: a vector global (`_vval_at` reads `*(&GW)`)
    if (_gv_vvd == 0) {
        if (vd == 0) { return 0; }
        _gv_vvd = alloc(1048576);
    }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    store8(_gv_vvd + vi, vd);
    return 0;
}
fn _gv_vvd_get(vi): i64 {
    if (_gv_vvd == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    return load8(_gv_vvd + vi);
}
# 6.7.13: and a `**T` global's pin (`_ek_pin`), the same way — 16 bits per global, as a pin is 14 bits wide (`_ps_pw`).
# CHANGELOG [6.7.14]
var _gv_ppn = 0;
fn _gv_ppn_set(vi, pn): i64 {
    if (_gv_ppn == 0) {
        if (pn == 0) { return 0; }
        _gv_ppn = alloc(2097152);
    }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    store16(_gv_ppn + vi * 2, pn);
    return 0;
}
fn _gv_ppn_get(vi): i64 {
    if (_gv_ppn == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    return load16(_gv_ppn + vi * 2);
}
# ⛔ 6.7.12 (D30) — "a declaration of global `vi` had a constant initializer", a byte per global (zero
# included). The value alone (`_vgsi_base`) could not say it: 0 there also means "none", so CHKDUPVAL took a
# prior `var a = 0;` for no constant and `var a = 0; var a = 5;` — two files' `var _shared = 0;` / `= 5;`,
# one cell — compiled with no warning, where every other differing pair warns (the user's decision D30,
# 2026-10-15). Set by PARSE_GVAR_REG beside the value; never cleared by a computed redeclaration, as the
# value is not. Lazily allocated (no heap region), as `_gv_ped`. CHANGELOG [6.7.12]
var _gv_lit = 0;
fn _gv_lit_set(vi, b): i64 {
    if (_gv_lit == 0) {
        if (b == 0) { return 0; }
        _gv_lit = alloc(1048576);
    }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    store8(_gv_lit + vi, b);
    return 0;
}
fn _gv_lit_get(vi): i64 {
    if (_gv_lit == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    return load8(_gv_lit + vi) & 1;
}
# 6.7.15 — bit 1 of the same byte: since global `vi`'s last constant, pass 1 registered an initializer it could not fold
# (a computed one, or a const- / enum-named constant only the replay folds), so a later constant's compare waits for the
# replay (_gv_dup_later, parse/decl/gvar.cyr). The next constant's `_gv_lit_set` clears it. CHANGELOG [6.7.15]
fn _gv_pend_set(vi): i64 {
    if (_gv_lit == 0) { _gv_lit = alloc(1048576); }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    store8(_gv_lit + vi, load8(_gv_lit + vi) | 2);
    return 0;
}
fn _gv_pend_get(vi): i64 {
    if (_gv_lit == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    return (load8(_gv_lit + vi) >> 1) & 1;
}
# 1 = prior global `pi` has a recorded constant (a non-zero value, or the byte above for a zero).
fn _gv_has_lit(pi): i64 {
    if (L64(_vgsi_base + pi * 8) != 0) { return 1; }
    return _gv_lit_get(pi);
}
# The step word of a `*T` global `vi` (GVTYPE = 0 - its step, 6.6.17; T's kind beside it), else 0.
fn _gv_ptr_word(S, vi): i64 {
    var vt = GVTYPE(S, vi);
    if (vt >= 0) { return 0; }
    return _ps_pw(_ps_vw(_ps_word(0 - vt, _gv_ped_get(vi)), _gv_pvd_get(vi)), _gv_ppn_get(vi));
}
fn _gv_ptr_sid(S, vi): i64 {
    if (_gv_psid == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    return L64(_gv_psid + vi * 8);
}
# The struct a global receiver `vi` names for `.field`: a `*T` global's T, else its var type.
# ⛔ 6.7.16 — A `*T` GLOBAL WHOSE T IS NO STRUCT NAMES NONE: its var type is 0 - its step (6.6.17), never a struct
# id, and the field arms took any negative id as the program's FIRST struct — `var x: *Foo = 0; x.y` (Foo refused)
# added "unknown field 'y' on struct 'var'", beside `struct P { a; }` resolved `x.a` as P's `a`, and a `*i64`
# global's `x.a` compiled and read through P. 0 here, so the `sid == 0` arms answer as for a local: the refused
# annotation's stand-down, else "no struct type in scope for 'x'". The vector band (<= -2048) is kept. CHANGELOG [6.7.16]
# ⛔ 6.7.16 (D68) — NOR DOES A SCALAR GLOBAL: an i8..u32 global's var type is its WIDTH (1 / 2 / 4) and an f64 / f32
# one's F64_TYID / F32_TYID, so `var g: i32 = 5; g.d` read g through the 4th struct's `d` and `g.a` on an f64 global
# indexed the struct tables at 2^30 (the compiler's SIGSEGV). A declared-integer global (GVINTD) and the float band
# answer 0, refused as the local is. CHANGELOG [6.7.16]
fn _gv_recv_sid(S, vi): i64 {
    var p = _gv_ptr_sid(S, vi);
    if (p > 0) { return p; }
    var t = GVTYPE(S, vi);
    if (t < 0) { if (t > 0 - 2048) { return 0; } }
    if (t >= F64_TYID) { return 0; }
    if (GVINTD(S, vi) == 1) { return 0; }
    return t;
}
# 1 = global `vi`'s slot HOLDS the struct's address: a pointer-mode struct global, or a `*T` one.
fn _gv_holds_addr(S, vi): i64 {
    if (GVPM(S, vi) == 1) { return 1; }
    if (_gv_ptr_sid(S, vi) > 0) { return 1; }
    return 0;
}
# 6.7.8 (C2-2a) — the element width of slice local `li` (sizeof(T): 1, 2, 4, 8, 16 or a struct's
# bytes, which can pass 255), 0 when `li` is no slice. Every reader that asks "is this name a
# slice?" asks here: a positive slice-width word is trusted only behind the slot's slice bit
# (GLSLICE, util.cyr), because the word goes stale on slot reuse. CHANGELOG [6.7.8]
fn _slice_lw(S, li): i64 {
    if (GLSLICE(S, li) == 0) { return 0; }
    return GSLICE_W(S, li) & 0xFFFFFFFF;
}
# 6.7.8 (C2-6a): the element descriptor of slice local `li` (`_ek_*`, parse/decl/array.cyr: an integer's
# width and sign, f64 / f32 / bool; 8 for any other word — a pointer, an enum, a cstring; 0 for a
# struct), 0 when `li` is no slice. It rides the slice word above bit 31 (`_sl_slice`): the width
# below it is sizeof(T), which passes 255 for a struct element.
fn _slice_led(S, li): i64 {
    if (GLSLICE(S, li) == 0) { return 0; }
    return (GSLICE_W(S, li) >> 32) & 0xFF;
}
# ⛔ 6.7.8 (C2-3a) — THE STEP WORD CARRIES THE ELEMENT KIND. A typed pointer's step (sizeof(T), the
# pointer-scale word GPSC while its value is in rax) says nothing about T's kind: `*u8` / `*i8` both
# step 1, `*u32` / `*f32` / `*i32` 4, `*f64` / `*bool` / `*i64` 8. So the step is stored and carried
# as ONE word, `ps | ed << 40` (ed = the element descriptor, `_ek_of_ptr_ann`, parse/decl/array.cyr):
# in the slot mark, a `name: *T` field's `_fld_ps`, a `: *T` return's `_fn_rps` (a global's GVTYPE
# is a shape key, so its kind sits beside it in `_gv_ped`). Every setter of GPSC writes the word
# and pointer arithmetic writes the operand's word back, so `p + n`, `p - n` and a parenthesised
# pointer keep the kind exactly where they keep the step. The closed list of readers that use the
# value as a NUMBER takes `_ps_step`: EPTR_SCALE, `_ptr_add`, `_add_word`, `_int_plus_ptr`, `_ptr_diff`
# (parse/expr/term.cyr) and the if-expression's merge (`_ps_merge`); every other reader tests `== 0` / `> 0`,
# which the word preserves (ed is nonzero only when the step is). Nothing reads the kind yet: the
# emitted bytes are unchanged. CHANGELOG [6.7.8] (6.7.9: `n + p` with a one-byte `*T` keeps p's
# word as `p + n` does — `_add_word`, parse/expr/term.cyr.)
fn _ps_word(ps, ed): i64 {
    if (ps <= 0) { return ps; }
    return ps | (ed << 40);
}
fn _ps_step(w): i64 {
    if (w < 0) { return w; }
    return w & 0xFFFFFFFFFF;
}
# ⛔ 6.7.12 — THE STEP WORD NAMES A VECTOR POINTEE. A `*V` (V a value-form vector) has no element kind (a vector
# is no element a subscript loads), so its word said only "step 16 / 32": a dereference of it could not be told
# from one of a `*u128` or of a 16-byte struct pointer, nor `*f64v2` from `*i32v4`. The vector's descriptor
# (`_vec_desc`'s, less 2048: 44..130) rides bits 48-55 — above the kind, so every reader that takes the step
# (`_ps_step`) or the kind (bits 40-47) is unchanged, and the slot mark's array band (`0 - 2^48 - N`) is read
# only behind an array descriptor. A `*V` local, parameter, capture, field, global and `: *V` return carry it,
# `p + n` keeps it, and `rd(*pv)` into a `*V` parameter passes pv (`_dlo_vec`, D27). The emitted bytes are
# unchanged. CHANGELOG [6.7.12]
# The vector the annotation `*V` (its `*` at token `ann`) points at, as bits 48-55 carry it; 0 otherwise.
fn _ek_vd(S, ann): i64 {
    if (ann <= 0) { return 0; }
    if (TOKTYP(S, ann) != 8) { return 0; }
    if (TOKTYP(S, ann + 1) != 2) { return 0; }
    var c = _tn_resolve_at(S, ann + 1);
    if (_tn_class(c) != 5) { return 0; }
    return _tn_val(c) - 2048;
}
fn _ps_vw(w, vd): i64 {
    if (w <= 0) { return w; }
    if (vd != 0) { _vty_any = 1; }   # 6.7.17: a `*V` (`_vval_at` reads `*pv`)
    return w | (vd << 48);
}
# The vector (its descriptor sid, >= 2048) step word `w` points at, or 0.
fn _ps_vdesc(w): i64 {
    if (w <= 0) { return 0; }
    if (_ps_pinned(w) == 1) { return 0; }   # 6.7.14: a `**T`'s word — bits 48-61 hold its pin (`_ps_pw`)
    var vd = (w >> 48) & 0xFF;
    if (vd == 0) { return 0; }
    return vd + 2048;
}
# ⛔ 6.7.13 — THE STEP WORD NAMES A POINTER POINTEE (D9 (a), the user 2026-10-15: `*pp` of a `pp: **T` is a
# `*T`). A `**T` stepped a pointer's 8 and said nothing more, so `*pp` was an untyped word: `*pp + 1` stepped one
# byte, `**pp` through a narrow T read 8 bytes and `var q: *T = *pp;` warned "assigning non-pointer to typed
# pointer". The pointee's own step word (`*T`'s: sizeof(T), T's kind, a vector) is interned in `_pp_tab` (alloc()'d,
# no heap region) and its index (the pin) rides the word above the kind (`_ps_pw`), so every reader of the step or the
# kind (40-47) is unchanged and the word stays positive. A `**T` local, parameter,
# capture, field, global and `: **T` return carry it, `pp + n` keeps it, and `_deref_read` (parse/expr/deref.cyr) gives
# `*pp` the pointee's word (`_pp_inner`). A `***T`'s pointee is a `**T` whose own pointee is pinned the same way. A
# field `**S` naming the struct being declared pins S's token (`0 - ti - 1`: its size is not known yet), sized at
# the dereference as `_fld_ps_get` sizes a late `*S`, under the field's binding. CHANGELOG [6.7.13]
var _pp_tab = 0;    # 2 words per pin (1..16383): the pointee's step word (or 0 - T's token - 1), its field entry (-1)
var _pp_n = 0;
var _pp_cap = 0;    # the pins `_pp_tab` / `_pp_sids` hold (index 0 unused), doubled as they fill
# ⛔ 6.7.14 — A PINNED WORD IS BIT 62 PLUS A 14-BIT PIN IN BITS 48-61. The pin rode bits 56-62 (126 pins), and since a
# pin carries its pointee's struct (6.7.13) two same-size structs take two pins, so 127 distinct `**S` structs were
# refused "max 126" where one pin per size had served them. A `**T`'s pointee is a pointer, so its word names no
# vector (`_ek_vd` answers 0 for it: bits 48-55 are always 0): the pin takes them too, flagged by bit 62 — below the
# sign bit, so the word stays positive and the slot mark `0 - 0x7E00 - w` fits — and `_ps_vdesc` answers 0 for a
# pinned word. CHANGELOG [6.7.14]
fn _ps_pw(w, pin): i64 {
    if (w <= 0) { return w; }
    if (pin <= 0) { return w; }
    return w | (1 << 62) | (pin << 48);
}
fn _ps_pinned(w): i64 {
    if (w <= 0) { return 0; }
    return (w >> 62) & 1;
}
fn _ps_pin(w): i64 {
    if (_ps_pinned(w) == 0) { return 0; }
    return (w >> 48) & 0x3FFF;
}
# 6.7.13: a pin also carries its pointee `*S`'s struct (`sid`, 0 for none) — the step word says only sizeof(S), so
# `**pps` of a `**S` names S through it (`_ppd_note`, parse/expr/deref.cyr): two structs of one size get two pins.
var _pp_sids = 0;   # a word per pin: the pointee's struct
# 6.7.15 — THE PIN INTERN IS HASHED. `_pp_intern` found an existing pin by scanning every pin so far, and 6.7.14
# raised the cap from 126 to 16383, so a unit with thousands of distinct `**T` pointees compiled in quadratic time
# (1024 structs each at 15 pointer depths, 15360 pins: 4.5 s). `_pp_hix` is an open-addressing index over (step word,
# field entry, struct): a pin per slot (0 empty), twice `_pp_cap` slots (a power of two, so at most half full),
# alloc()'d and rebuilt by `_pp_grow`. Pins keep their first-come numbers (a step word carries its pin).
# CHANGELOG [6.7.15]
var _pp_hix = 0;
var _pp_hmask = 0;  # the index's slots - 1
fn _pp_intern(S, v, ent, sid): i64 {
    if (v == 0) { return 0; }
    if (_pp_tab == 0) { _pp_grow(128); }
    var j = _pp_hslot(v, ent, sid);
    var i = L64(_pp_hix + j * 8);
    if (i != 0) { return i; }
    if (_pp_n >= 16383) {
        ERR_MSG(S, "too many pointer-to-pointer pointee types (max 16383)", 53);
        return 0;
    }
    if (_pp_n + 1 >= _pp_cap) {
        _pp_grow(_pp_cap * 2);
        j = _pp_hslot(v, ent, sid);
    }
    _pp_n = _pp_n + 1;
    S64(_pp_tab + _pp_n * 16, v);
    S64(_pp_tab + _pp_n * 16 + 8, ent);
    S64(_pp_sids + _pp_n * 8, sid);
    S64(_pp_hix + j * 8, _pp_n);
    return _pp_n;
}
# The index slot of the pin (v, ent, sid): the one holding it, else the empty slot its probe ends at. CHANGELOG [6.7.15]
fn _pp_hslot(v, ent, sid): i64 {
    var j = _pp_hash(v, ent, sid) & _pp_hmask;
    var i = L64(_pp_hix + j * 8);
    while (i != 0) {
        if (L64(_pp_tab + i * 16) == v) { if (L64(_pp_tab + i * 16 + 8) == ent) {
                if (L64(_pp_sids + i * 8) == sid) { return j; }
            } }
        j = (j + 1) & _pp_hmask;
        i = L64(_pp_hix + j * 8);
    }
    return j;
}
# A pin key's hash. A step word's pin and kind sit in its high bits, so each step folds the high half down before the
# multiply (which carries only upward). CHANGELOG [6.7.15]
fn _pp_hash(v, ent, sid): i64 {
    var h = (v ^ (v >> 32)) * 0x9E3779B97F4A7C15;
    h = ((h ^ (h >> 29)) ^ ent) * 0x9E3779B97F4A7C15;
    h = ((h ^ (h >> 29)) ^ sid) * 0x9E3779B97F4A7C15;
    return h ^ (h >> 32);
}
# The pin tables at `n` entries, the pins so far copied over, and (6.7.15) the index at 2n slots, rebuilt.
# CHANGELOG [6.7.14]
fn _pp_grow(n): i64 {
    var t = alloc(n * 16);
    var d = alloc(n * 8);
    var i = 1;
    while (i <= _pp_n) {
        S64(t + i * 16, L64(_pp_tab + i * 16));
        S64(t + i * 16 + 8, L64(_pp_tab + i * 16 + 8));
        S64(d + i * 8, L64(_pp_sids + i * 8));
        i = i + 1;
    }
    _pp_tab = t;
    _pp_sids = d;
    _pp_cap = n;
    _pp_hreindex(n * 2);
    return 0;
}
# The index at `m` slots (a power of two), zeroed, every pin re-inserted. CHANGELOG [6.7.15]
fn _pp_hreindex(m): i64 {
    _pp_hix = alloc(m * 8);
    _pp_hmask = m - 1;
    var j = 0;
    while (j < m) { S64(_pp_hix + j * 8, 0); j = j + 1; }
    var i = 1;
    while (i <= _pp_n) {
        j = _pp_hash(L64(_pp_tab + i * 16), L64(_pp_tab + i * 16 + 8), L64(_pp_sids + i * 8)) & _pp_hmask;
        while (L64(_pp_hix + j * 8) != 0) { j = (j + 1) & _pp_hmask; }
        S64(_pp_hix + j * 8, i);
        i = i + 1;
    }
    return 0;
}
# The pin of the pointer annotation whose first `*` is token `ann`: its pointee interned when that pointee is
# itself a pointer (`**T`, `***T`), else 0. A field passes its struct `si` and pool entry `ent` (else -1).
fn _ek_pin(S, ann): i64 { return _pp_pin_at(S, ann, 0 - 1, 0 - 1); }
fn _pp_pin_at(S, ann, si, ent): i64 {
    if (ann <= 0) { return 0; }
    if (TOKTYP(S, ann) != 8) { return 0; }
    if (TOKTYP(S, ann + 1) != 8) { return 0; }
    var v = _pp_word_at(S, ann + 1, si, ent);
    var sid = _pp_psid(S, ann + 1, si, v);   # 6.7.13: the pointee `*S`'s struct
    if (v < 0) { return _pp_intern(S, v, ent, sid); }
    return _pp_intern(S, v, 0 - 1, sid);
}
# The struct the pointee annotation `*T` at token `a` points at (`_ptr_ann_sid_tp`: a bound T too), the struct being
# declared for a late `**S` field (`v` < 0), else 0 (a scalar, a vector, a pointer). CHANGELOG [6.7.13]
fn _pp_psid(S, a, si, v): i64 {
    if (v < 0) {
        if (FINDSTRUCT(S, TOKVAL(S, a + 1)) == si + 1) { return si + 1; }
        return 0;   # 6.7.16 (D103): declared below — named at the use (`_pp_sid`)
    }
    return _ptr_ann_sid_tp(S, a);
}
# The struct pin `pin`'s pointee `*S` points at, else 0. 6.7.16 (D103): a late pin with no struct recorded (a `**B`
# field, B declared below it) names it now, under its field's binding, as `_pp_inner` sizes it.
fn _pp_sid(S, pin): i64 {
    if (pin <= 0) { return 0; }
    if (pin > _pp_n) { return 0; }
    var r = L64(_pp_sids + pin * 8);
    if (r != 0) { return r; }
    var v = L64(_pp_tab + pin * 16);
    if (v >= 0) { return 0; }
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _fld_pb_bind(S, L64(_pp_tab + pin * 16 + 8));
    r = _ptr_ann_sid_tp(S, 0 - v - 2);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    if (r < 0) { r = 0; }
    return r;
}
# 6.7.16 (D97): the struct a pointer whose pointee is pinned `pin` points through to — `**S` (the pin's `*S`), `***S`
# (one pin further), ... — as `(stars << 32) | sid`, else 0 (a pointee that is no struct pointer). CHANGELOG [6.7.16]
fn _pps_of_pin(S, pin): i64 {
    var d = 2;
    while (pin > 0) {
        if (pin > _pp_n) { return 0; }
        var s = _pp_sid(S, pin);
        if (s > 0) { return (d << 32) | s; }
        var v = L64(_pp_tab + pin * 16);
        if (v <= 0) { return 0; }
        pin = _ps_pin(v);
        d = d + 1;
    }
    return 0;
}
