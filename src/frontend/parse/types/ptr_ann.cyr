# PARSER — types: pointer annotations and their checks — a pointer argument into a `*S` / `**S` parameter (`_pa_*`,
# `_pps_*`), `**T` inference (`_ic_pp_*`), the `*T` annotation (`_tn_ptr*`, `_ptr_annot`), on fields (`_fld_ptr*`) and
# returns (`_ret_ptr*`).
# ================================================================
# Split from parse/types.cyr at 6.7.18, unchanged; parse.cyr includes parse/types/ in source order. CHANGELOG [6.7.18]

# ⛔ 6.7.16 (D97, the user's decision, 2026-10-20) — A POINTER TO ANOTHER STRUCT INTO A `*S` / `**S` PARAMETER IS
# REFUSED BY NAME, as a struct value of another type is (6.7.3). `nc1(&y)` with `y: Box<Pt>` and `p: *Box<i64>` read
# Pt's `y` as Box<i64>'s `n` (2 where 9 is right), and `nc2(&q)` (`q: *Box<Pt>`, `pp: **Box<i64>`), `nc4(&q)` (`q: Qd`,
# `p: *Pt`) and `nc4(pq)` (`pq: *Qd`) the same, silently on every target: behind a pointer nothing compared the pointee
# (6.7.3 let a typed pointer convert freely). The whole argument [a, e), just pushed, to parameter `k` of `fi`: when the
# parameter points through its stars to struct S (`_pps_param`) and the argument — by the compiler's own typing
# (`_pa_sid`) — through as many to another struct, it is refused at the argument, `&y` named `y`, once, in 6.7.3's
# words. An untyped pointer, `0` and a pointer to the declared struct pass (a pointer of another depth passed too
# through 6.7.16 — refused since, below). Every call's
# argument loop (`_arg_push_snap`: a call, a method's arguments, a named one, a tail call — a generic instance's
# parameters are its own) and an operator's right operand (`_op_arg_check`). 1 = refused. CHANGELOG [6.7.16]
# ⛔ 6.7.17 (D10 / D11, the user's decisions, 2026-10-22) — AND INTO A BY-VALUE STRUCT PARAMETER, AND AT ANOTHER DEPTH.
# `bq(u)` / `bq(&p)` (`u: *Pt`) into `b: Q` copied Pt's bytes as a Q (68), `nc4(&pq)` (a `**Pt`) into `p: *Pt` read
# pq's slot as the Pt and `nc2(pz)` (a `*Box<i64>`) into `pp: **Box<i64>` read the Box as a pointer (139): a by-value
# struct takes a pointer of ONE star to its own struct (copied through, 6.7.10's B7-1b), so another struct there is
# D97's refusal; a pointer whose stars differ from the parameter's (`_pa_derr`, both types named) is refused at every
# struct parameter. `**pps` (it passes `*pps`), an untyped pointer and `0` are typed no struct pointer: they pass.
# CHANGELOG [6.7.17]
fn _pa_chk(S, fi, k, a, e): i64 {
    var sp = _pps_param(S, fi, k);
    var dp = _pps_d;
    if (sp <= 0) { sp = _pa_bv(S, fi, k); dp = 0; }
    if (sp <= 0) { return 0; }
    var sa = _pa_sid(S, a, e);
    if (sa <= 0) { return 0; }
    if (sa >= 2048) { return 0; }
    var dw = dp;
    if (dw == 0) { dw = 1; }   # a by-value struct takes a `*S` of its own struct
    if (_pa_d != dw) { return _pa_derr(S, fi, sa, sp, dp); }
    if (sa == sp) { return 0; }
    var nm = 0;
    if (_pa_nt >= 0) { nm = TOKVAL(S, _pa_nt); }
    else { nm = _src_span_nm(S, _pa_b, _pa_e, _hl_lastnm(S, _pa_b, _pa_e, 0)); }
    var sv = GTI(S);
    STI(S, _pa_b);
    _sarg_ident_err(S, "cannot pass ", nm, 0 - 1, " to a parameter of a different struct type in a call to ", fi);
    STI(S, sv);
    return 1;
}
# The struct a BY-VALUE struct parameter `k` of `fi` is declared (its recorded GFPSID: an address-passed struct or
# tuple, one of 8 B or less, a `Str` handle — no `*`, no untyped `self`, no `dyn`: `&p` forms its object), else 0.
# CHANGELOG [6.7.17]
fn _pa_bv(S, fi, k): i64 {
    if (fi < 0) { return 0; }
    var ps = GFPSID(S, fi, k);
    if (ps <= 0) { return 0; }
    if (ps >= 2048) { return 0; }
    if (_dyn_is(S, ps) == 1) { return 0; }
    if (_pptr_param(S, fi, k) == 1) { return 0; }
    if (_pps_uself(S, fi, k) == 1) { return 0; }
    return ps;
}
# 6.7.17 (D11): the argument `_pa_sid` typed (struct `sa` behind `_pa_d` stars, the span [`_pa_b`, `_pa_e`)) meets the
# struct parameter `sp` at `dp` stars (0: by value) at another depth — refused at the argument, once, naming it as
# spelled and both types: "cannot pass '&pq', a '**Pt', to a '*Pt' parameter in a call to 'nc4' - a pointer of another
# depth". 1.
fn _pa_derr(S, fi, sa, sp, dp): i64 {
    var sv = GTI(S);
    STI(S, _pa_b);
    if (_err_once(S, ((sa * 31 + sp) * 31 + dp) * 8 + 6) == 0) { STI(S, sv); return 1; }
    _ew("error:", 6);
    _err_head(S);
    PRSTR(": cannot pass '");
    PRSTR(S + 0xEC00000 + _src_span_nm(S, _pa_b, _pa_e, TOKVAL(S, _pa_e - 1)));
    PRSTR("', a '");
    _pa_tyname(S, sa, _pa_d);
    PRSTR("', to a '");
    _pa_tyname(S, sp, dp);
    PRSTR("' parameter in a call to '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    PRSTR("' - a pointer of another depth\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    _panic = 1;
    return 1;
}
# ⛔ 6.7.17 (D107, the user's decision, 2026-10-22: "refuse it, naming both pointer types, as an argument of another
# depth is") — A POINTER OF ANOTHER DEPTH INTO A STRUCT-POINTER DECLARATION. `var u: *Pt = &h;` (h a handle: its `&` is
# the slot holding the address, a `**Pt`) held the slot, so `u.x` read the handle's word as the Pt; `var u: *Pt = pp;`
# (a `**Pt`) and `var pp: **Pt = pq;` (a `*Pt`) the same, silently. The annotation at `ann` (one or more `*`, then a
# struct: `_ppd_ann`), the initialiser [ti, e) typed as an argument is (`_pa_sid`: a name, `&x`, a field, a call,
# `*ppp`, an if-expression) at another number of stars: "cannot initialise 'u: *Pt' from '&h', a '**Pt' - a pointer of
# another depth", at the initialiser. A pointer of the annotation's depth (to any struct, as 6.7.3 left declarations),
# an untyped pointer, `0` and an inline struct (D17's address) are unchanged. PARSE_VAR in a fn and at top level
# after the first statement (cursor on the `=`), the zone replay (`_vin_zone`). 1 = refused. CHANGELOG [6.7.17]
var _ppd_d = 0;
var _ppd_asgm = 0;   # 1: an assignment's words, "cannot assign" (`_ppd_asg`)
fn _ppd_val(S, ti, e, ann, noff): i64 {
    if (_syntax_only == 1) { return 0; }
    if (e <= ti) { return 0; }
    var ds = _ppd_ann(S, ann);
    if (ds <= 0) { return 0; }
    var dd = _ppd_d;
    var sa = _pa_sid(S, ti, e);
    if (sa <= 0) { return 0; }
    if (sa >= 2048) { return 0; }
    if (_pa_d == dd) { return 0; }
    if (_tn_once(S, _pa_b) == 0) { return 1; }
    var sv = GTI(S);
    STI(S, _pa_b);
    _ew("error:", 6);
    _err_head(S);
    if (_ppd_asgm == 1) { PRSTR(": cannot assign '"); } else { PRSTR(": cannot initialise '"); }
    PRSTR(S + 0xEC00000 + noff);
    PRSTR(": ");
    _pa_tyname(S, ds, dd);
    PRSTR("' from '");
    PRSTR(S + 0xEC00000 + _src_span_nm(S, _pa_b, _pa_e, TOKVAL(S, _pa_e - 1)));
    PRSTR("', a '");
    _pa_tyname(S, sa, _pa_d);
    PRSTR("' - a pointer of another depth\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    _ptr_refd_ti = ann;
    return 1;
}
# 6.7.17 (D107, its assignment twin: the same decision) — `u = &h;`, `v = pp;`, `pp = u;` into a name declared a
# pointer to a struct (a local, a parameter, a global, a capture: `_asa_ann` finds its annotation) at another depth
# held the wrong pointer silently (`u.x + v.x` read 88 where 6 is right): "cannot assign 'u: *Pt' from '&h', a '**Pt' -
# a pointer of another depth". `_try_aggregate_copy_assign`, the cursor on the value ending at `term`, the statement's
# own `NAME =` (a dereference or field store reaches it with its operand's name: not judged); reports only, the
# statement parses on. 0. CHANGELOG [6.7.17]
fn _ppd_asg(S, noff, term): i64 {
    if (_syntax_only == 1) { return 0; }
    var ti = GTI(S);
    if (TOKTYP(S, ti - 1) != 4) { return 0; }
    if (TOKTYP(S, ti - 2) != 2) { return 0; }
    if (STREQ(S, TOKVAL(S, ti - 2), noff) == 0) { return 0; }
    var pt = TOKTYP(S, ti - 3);
    if (pt == 8 || pt == 41) { return 0; }   # `**qq = ..`, `w.pq = ..`: a store through the name, not into it
    var e = _hl_dx_end(S, ti, term);
    if (e < 0) { return 0; }
    # 6.7.17: the value's struct pointer (`_pa_sid`, its own tokens) before the destination's annotation (`_asa_ann`, a
    # walk back over every earlier statement) — the walk on every `NAME = ..` made a fn of N assignments quadratic
    # (`s = s + gN` x 10,000: 147 ms through 6.7.16, 6 s; globals_scale_linear.sh [ref]). `_ppd_val` refuses only
    # such a value, so the answer is the same.
    var sa = _pa_sid(S, ti, e);
    if (sa <= 0) { return 0; }
    if (sa >= 2048) { return 0; }
    var a = _asa_ann(S, noff, ti - 1);
    if (a <= 0) { return 0; }
    if (TOKTYP(S, a) != 8) { return 0; }
    _ppd_asgm = 1;
    _ppd_val(S, ti, e, a, noff);
    _ppd_asgm = 0;
    return 0;
}
# The struct the pointer annotation at `ann` points through to — `*S`, `**S`, `***S` (S a plain struct or an instance;
# a bound T's at one star) — `_ppd_d` its stars; else 0.
fn _ppd_ann(S, ann): i64 {
    if (ann <= 0) { return 0; }
    var d = 0;
    while (TOKTYP(S, ann + d) == 8) { d = d + 1; }
    if (d == 0) { return 0; }
    _ppd_d = d;
    var t = 0;
    if (d == 1) { t = _ptr_ann_sid_tp(S, ann); }
    else { t = _ptr_tok_sid(S, ann + d); }
    if (t <= 0) { return 0; }
    if (t >= 2048) { return 0; }
    if (_dx_plain(S, t) == 0) { if (t != _STR_SID(S)) { return 0; } }
    return t;
}
# `d` stars, then struct `sid` as the source spells it (`Box<Pt>`; a generic's base is its i64 binding, `Box<i64>`), on
# stderr.
fn _pa_tyname(S, sid, d): i64 {
    while (d > 0) {
        PRSTR("*");
        d = d - 1;
    }
    PRSTR(S + 0xEC00000 + _fsn_one(S, sid));
    if (_sinst_base(sid) > 0) { return 0; }
    var tp = GSTP(S, sid - 1);
    if (tp == 0) { return 0; }
    PRSTR("<i64");
    if ((tp >> 32) != 0) { PRSTR(", i64"); }
    PRSTR(">");
    return 0;
}
# The struct parameter `k` of `fi` points through to — a `*S` (GFPSID behind one `*`, `_pptr_param`; an untyped impl
# `self`, `_pps_uself`), a `**S` / `***S` (GFPPS) — `_pps_d` its stars; else 0 (a by-value struct, a scalar pointer).
var _pps_d = 0;
fn _pps_param(S, fi, k): i64 {
    _pps_d = 0;
    if (fi < 0) { return 0; }
    var ps = GFPSID(S, fi, k);
    if (ps > 0) {
        if (ps >= 2048) { return 0; }
        if (_pptr_param(S, fi, k) == 0) { if (_pps_uself(S, fi, k) == 0) { return 0; } }
        _pps_d = 1;
        return ps;
    }
    var w = GFPPS(S, fi, k);
    if (w <= 0) { return 0; }
    _pps_d = w >> 32;
    return w & 0xFFFFFFFF;
}
# 1 = parameter `k` of `fi` is an impl method's untyped `self` — a `*T` (6.7.0, A4): `Pt_m(&q)` calls it by name.
fn _pps_uself(S, fi, k): i64 {
    if (k != 0) { return 0; }
    if (GFISELF(S, fi) == 0) { return 0; }
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, 0) == 0) { return 0; }
    if (TOKTYP(S, _dps_nm + 1) == 49) { return 0; }
    return 1;
}
# The struct the whole argument [a, e) points through to, by the compiler's own typing: `&x` of an inline struct
# (`_hl_amp_sid`) or of a typed pointer, one star deeper (`_pa_amp`); a `**T` / `***T` name, call, method, field or
# `*ppp` by its pinned step word (`_hl_pw`); a `*T` name, call, method, field, pointer arithmetic or `*pp` of a `**T`
# (`_hl_psid`) — inside any parentheses. `_pa_d` its stars; `_pa_b` / `_pa_e` the unwrapped span, `_pa_nt` the name of
# an `&x` (else -1). 0 = untyped, a scalar pointer, or a shape the reader does not type.
var _pa_d = 0;
var _pa_b = 0;
var _pa_e = 0;
var _pa_nt = 0;
fn _pa_sid(S, a, e): i64 {
    _pa_d = 0;
    _pa_nt = 0 - 1;
    var b = _ie_unparen(S, a, e);
    var be = _ie_pe;
    _pa_b = b;
    _pa_e = be;
    if (b >= be) { return 0; }
    if (TOKTYP(S, b) == 27) { return _pa_amp(S, b + 1, be); }
    if (TOKTYP(S, b) == 15) { return _pa_ie(S, b, be); }
    var w = _hl_pw(S, b, be);
    if (_ps_pinned(w) == 1) { return _pa_wsid(S, w); }
    var s = _hl_psid(S, b, be);
    if (s <= 0) { return 0; }
    _pa_d = 1;
    return s;
}
# ... `&` of exactly one name [a, e), inside any parentheses: an inline struct (one star), or a typed pointer (its
# own stars, plus one).
fn _pa_amp(S, a, e): i64 {
    var n = _ie_unparen(S, a, e);
    if (_ie_pe != n + 1) { return 0; }
    if (TOKTYP(S, n) != 2) { return 0; }
    _pa_nt = n;
    var noff = TOKVAL(S, n);
    var t = _hl_amp_sid(S, noff);
    if (t > 0) {
        _pa_d = 1;
        return t;
    }
    t = _pa_hamp(S, noff);   # 6.7.17 (D11): `&h` of a handle is a `**S`
    if (t > 0) { return t; }
    t = _pa_aamp(S, n);   # 6.7.17: `&pa` of an array of `*S` is a `**S`
    if (t > 0) { return t; }
    var w = _hl_name_pw(S, noff);
    if (w <= 0) { return 0; }
    if (_ps_pinned(w) == 1) {
        t = _pa_wsid(S, w);
        if (t > 0) { _pa_d = _pa_d + 1; }
        return t;
    }
    t = _hl_psid(S, n, n + 1);
    if (t <= 0) { return 0; }
    _pa_d = 2;
    return t;
}
# ⛔ 6.7.17 — `&pa` OF AN ARRAY OF STRUCT POINTERS IS A POINTER ONE STAR DEEPER THAN ITS ELEMENT (met with D109's
# narrowing, the user, 2026-10-22: "fix the depth hole too"). D11 refused `ts(&hp)` (`hp: *Pt`, a `**Pt`) into
# `p: *Pt`, but `var pa: *Pt[2]; ts(&pa)` passed the array's address as the Pt and read element 0's address as its
# field (40 where 7 was stored): nothing typed `&` of an array of pointers. The array named at token n declared
# `var NAME: *..S[N]` (`_arr_elem_toks`, k stars to one struct name) types `&NAME` as S behind k + 1 stars, judged by
# D11's depth rule. An array of inline structs (`var sa: Pt[2]`: `&sa` is element 0's address) and an element that is
# no plain struct name are not typed here — unchanged. CHANGELOG [6.7.17]
fn _pa_aamp(S, n): i64 {
    if (_arr_name_at(S, n, n + 1) < 0) { return 0; }
    if (_arr_elem_toks(S, n) == 0) { return 0; }
    var i = _aet_s;
    var k = 0;
    while (i < _aet_e) {
        if (TOKTYP(S, i) != 8) { break; }
        k = k + 1;
        i = i + 1;
    }
    if (k == 0) { return 0; }
    if (i + 1 != _aet_e) { return 0; }
    if (TOKTYP(S, i) != 2) { return 0; }
    var s = FINDSTRUCT(S, TOKVAL(S, i));
    if (s <= 0) { return 0; }
    _pa_d = k + 1;
    return s;
}
# ... `&noff` of a struct name that is no `*T` and that `_hl_amp_sid` does not take: a handle (a pointer-mode local,
# parameter, capture or global; a `Str` one) — its `&` is the slot holding the address, a `**S`, `_pa_d` 2 — or an
# inline `Str` header (`_pa_d` 1). A tuple or a dyn: 0. CHANGELOG [6.7.17]
fn _pa_hamp(S, noff): i64 {
    var t = _hl_name_ty(S, noff);
    if (t <= 0) { return 0; }
    if (_hl_cp != 0) { return 0; }
    if (_tup_is(S, t) == 1) { return 0; }
    if (_dyn_is(S, t) == 1) { return 0; }
    _pa_d = 2;
    if (_hl_amp_in(S, noff, t) > 0) { _pa_d = 1; }
    return t;
}
# ... an if-expression [b, be) (`if` at b, its last `}` ending the span) whose every branch points through as many
# stars to one struct (`_pa_sid` on each branch's expression); else 0. The span `_pa_b` / `_pa_e` is the whole of it.
fn _pa_ie(S, b, be): i64 {
    var i = b;
    var d = 0 - 1;
    var s = 0;
    var go = 1;
    while (go == 1) {
        var o = i + 1;   # `if` / `elif`: `( cond ) {`
        if (TOKTYP(S, i) != 23) {
            if (TOKTYP(S, o) != 10) { return 0; }
            o = _call_close(S, o) + 1;
        }
        var e = _pa_brace(S, o);
        if (e < 0) { return 0; }
        var t = _pa_sid(S, o + 1, e);
        if (t <= 0) { return 0; }
        if (d >= 0) { if (_pa_d != d) { return 0; } if (t != s) { return 0; } }
        d = _pa_d;
        s = t;
        if (TOKTYP(S, i) == 23) { go = 0; }
        i = e + 1;
        if (go == 1) { if (TOKTYP(S, i) != 50) { if (TOKTYP(S, i) != 23) { return 0; } } }
    }
    if (i != be) { return 0; }
    _pa_d = d;
    _pa_b = b;
    _pa_e = be;
    _pa_nt = 0 - 1;
    return s;
}
# The `}` closing the `{` at token `o` (-1 when `o` is no `{`, or the stream ends first).
fn _pa_brace(S, o): i64 {
    if (TOKTYP(S, o) != 13) { return 0 - 1; }
    var n = GTCNT(S);
    var dd = 0;
    var i = o;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 13) { dd = dd + 1; }
        if (t == 14) {
            dd = dd - 1;
            if (dd == 0) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}
# ... a pinned step word `w` (a `**T`, `***T`): the struct its pins name, `_pa_d` its stars; else 0.
fn _pa_wsid(S, w): i64 {
    var v = _pps_of_pin(S, _ps_pin(w));
    if (v <= 0) { return 0; }
    _pa_d = v >> 32;
    return v & 0xFFFFFFFF;
}
# Pass 1 (`_prescan_params_scan`), parameter `pc` of `fi` whose type opens with two or more `*` at token `ann`: its
# struct behind them (`_pps_of_pin` on the pin `_param_pin` reads under the base's binding), when the pointee's name
# and `<..>` resolve here — a struct declared below is the definition's (`_pps_def_note`). CHANGELOG [6.7.16]
fn _pps_scan(S, fi, pc, ann): i64 {
    var k = ann;
    while (TOKTYP(S, k) == 8) { k = k + 1; }
    if (TOKTYP(S, k) != 2) { return 0; }
    if (FINDSTRUCT(S, TOKVAL(S, k)) <= 0) { return 0; }
    if (TOKTYP(S, k + 1) == 19) { if (_pps_targs_ok(S, fi, k + 2) == 0) { return 0; } }
    var svpn = _panic;
    var pn = _param_pin(S, ann);
    if (svpn == 0) { _panic = 0; }
    return SFPPS(S, fi, pc, _pps_of_pin(S, pn));
}
# ... 1 = the type-argument list from token `i` resolves here, a generic's own type parameters bound as its base binds
# them (T -> i64, `_ret_ptr_base_bind`): `glater<i64>(&py)` above `fn glater<T>(pp: **Box<T>)` is the base's call.
fn _pps_targs_ok(S, fi, i): i64 {
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _ret_ptr_base_bind(S, fi);
    var r = _targs_resolvable(S, i);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return r;
}
# Pass 2 (PARSE_FN_DEF), parameter `pc` of `fi` in slot `li`: the struct behind a `**S` / `***S` (its slot's pinned
# word, `_mark_ptr_param`), else 0 — a redefinition keeps pass 1's, the last definition's (as `_psid_def_note`).
fn _pps_def_note(S, fi, pc, li): i64 {
    if ((GFLG(S, fi) & 2048) != 0) { return 0; }
    var v = 0;
    if (_cur_fn_ptrp == li + 1) {
        var m = GSLICE_W(S, li);
        if (m <= 0 - 0x7E01) { v = _pps_of_pin(S, _ps_pin(0 - m - 0x7E00)); }
    }
    return SFPPS(S, fi, pc, v);
}
# The step word of the pointer type whose first `*` is token `a`, the cursor unmoved: `*T`'s as `_ptr_annot`
# reads it (quiet: the annotation itself reports an unknown T), a pointer's 8 and its own pin, 0 for a T it does
# not read (a slice, a tuple: refused by the annotation).
fn _pp_word_at(S, a, si, ent): i64 {
    var t = TOKTYP(S, a + 1);
    if (t == 8) { return _ps_pw(8, _pp_pin_at(S, a, si, ent)); }
    if (t != 2) { if (t != 105) { return 0; } }
    if (si >= 0) { if (t == 2) { if (FINDSTRUCT(S, TOKVAL(S, a + 1)) == si + 1) {
                return 0 - (a + 2);   # late: its field records the binding (`_fld_pp_one`, every `**` field's)
            } } }
