# ⛔ 6.7.17 — A VARIABLE'S `*` FOLLOWED BY NO TYPE (`var x: *+ = 0;`, `*5`, `*;`) is 6.7.14's D15 refusal, "expected a type
# for variable 'x', got '+'", as `var x: + = 0;` and a parameter's `p: *+` are; it was "expected identifier, got '+'"
# with "assigning non-pointer to typed pointer" after it. The token is stepped (not a `=` / `;`: the line reads on there,
# as D15's does). A field's (`k: *+`, as `k: +`) and a return's keep "expected identifier". CHANGELOG [6.7.17]
var _ptr_fld = 0;   # `_fld_ptr_annot` is reading a field's annotation
fn _ptr_notype(S, vnoff): i64 {
    if (_ptr_fld == 1 || vnoff < 0) { ERR_EXPECT(S, 2); return 0; }
    _tn_var_err(S, GTI(S), vnoff);
    var t = PEEKT(S);
    if (t != 4 && t != 5 && t != 12) { STI(S, GTI(S) + 1); }
    return 0;
}
# ⛔ 6.7.17 (the user's D8, 2026-10-22) — A `*fn( .. )` TYPE DECLARES A LOCAL, A GLOBAL OR A FIELD AS THE ONE POINTER
# WORD A PARAMETER'S DOES. The readers took the token after the `*` as a type name and met the keyword: `var c:
# *fn(i64): i64 = 0;` was "expected identifier, got reserved keyword 'fn'" and a cascade, so a fn pointer was held only
# untyped.
# The type (the first `*` at token `ti0`; a bare `*fn` and `**fn( .. )` too) is read by the parameter reader's grammar
# (`_pty_end`), each refusal inside its list once with the declaration's words (`what`, `vnoff`) when `quiet` is 0, and
# stepped; its step is a pointer's 8 (`_ptr_step_peek`), so `fncall1(c, 5)` / `callptr(c, 5)` read the word as they
# read a `cb: *fn( .. )` parameter. The token after the type. CHANGELOG [6.7.17]
# The parameter reader's (`_pty_*`, parse/fn/impl.cyr) words for such a declaration (" for variable "; 0 = a
# parameter's) and its name, and the token its list's missing `)` was expected at (-1 none; `_pty_rpn` 1 = nothing in
# that type reported before it, so it is reported).
var _pty_dk = 0;
var _pty_dn = 0;
var _pty_rpx = 0 - 1;
var _pty_rpn = 0;
fn _pty_what(): i64 {
    if (_pty_dk != 0) { return _pty_dk; }
    return " for parameter ";
}
fn _ptr_fnp_end(S, ti0, vnoff, quiet, what): i64 {
    var sv_b = _pty_bad;
    var sv_k = _pty_dk;
    var sv_n = _pty_dn;
    _pty_bad = 0;
    _pty_dk = what;
    _pty_dn = vnoff;
    _pty_rpx = 0 - 1;
    var e = _pty_end(S, ti0, 1 - quiet, 0);
    if (_pty_rpx >= 0) {
        if (quiet == 0) { _ptr_fnp_rp(S); }
        e = _fnp_decl_end(S, e);
    }
    _pty_bad = sv_b;
    _pty_dk = sv_k;
    _pty_dn = sv_n;
    return e;
}
# The `)` a `*fn( .. )` annotation's list lacks (`_pty_list` notes the token it was expected at): the parameter loop
# reports a parameter's; a declaration's is reported here, once, unless the type reported before it (`_pty_rpn`).
fn _ptr_fnp_rp(S): i64 {
    if (_pty_rpn == 0) { return 0; }
    if (_tn_once(S, _pty_rpx) == 0) { return 0; }
    STI(S, _pty_rpx);
    ERR_EXPECT(S, 11);
    return 0;
}
# Past such a list (`e` the token its `)` was expected at): the declaration's `=` or `;` (or a brace), so the line
# reads on from there in both passes, with nothing more to say about the type.
fn _fnp_decl_end(S, e): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (e < n) {
        var t = TOKTYP(S, e);
        if (t == 5 || t == 12 || t == 13 || t == 14) { return e; }
        if (t == 10 || t == 28) { d = d + 1; }
        elif (t == 11 || t == 29) { if (d > 0) { d = d - 1; } }
        elif (t == 4) { if (d == 0) { return e; } }
        e = e + 1;
    }
    return e;
}
# The step of `*T` with the cursor on T, which does not move: `_tn_ptr_step`, except that a
# generic struct with arguments is its INSTANCE (`*Box<i32>` steps sizeof(Box<i32>), as `var b:
# Box<i32>` declares it — it stepped the base's size), sized as `_sizeof_type` sizes it. Pass 1
# (`quiet`) sizes an instance only when its arguments resolve already. CHANGELOG [6.6.17]
fn _ptr_step_peek(S, vnoff, quiet): i64 {
    var ti = GTI(S);
    var ps = _tn_ptr_step(S, ti, vnoff, quiet);
    if (TOKTYP(S, ti) != 2) { return ps; }
    if (TOKTYP(S, ti + 1) != 19) { return ps; }
    var sid = FINDSTRUCT(S, TOKVAL(S, ti));
    if (sid <= 0) { return ps; }
    if (quiet == 1) { if (_targs_resolvable(S, ti + 2) == 0) { return ps; } }
    if (quiet == 1) { if (GSTP(S, sid - 1) == 0) { return ps; } }   # 6.7.15 (D6): pass 2 refuses `*Pt<..>`
    if (_ppk_nomint == 1) { if (GSTP(S, sid - 1) != 0) { _fld_targ_chk(S, ti); return ps; } }   # 6.7.16
    STI(S, ti + 1);
    var g = _gen_ann_sid(S, sid);
    STI(S, ti);
    if (g > 0) { if (g != sid) { ps = STRUCTSZ(S, g - 1); } }
    return ps;
}
# A `name: *T` field (cursor on its `:`): an 8-byte field whose loads carry T's step.
# ⛔ 6.6.17 (review) — a pointer to a STRUCT is sized when the field is LOADED, not when it is
# declared: inside its own definition a struct has the size of the fields so far
# (`struct Node { val; next: *Node; }` stepped 8, not 16), and a struct declared further down
# (`struct A { p: *B; }`) was refused "declared after its use", so two structs could not point
# at each other. Such a field records T's token (`0 - (ti + 1)`); `_fld_ps_get` sizes it.
var _fld_ps = 0;   # per field-pool entry: the step word of a `*T` field (or T's token), 0 otherwise
fn _add_ptr_field(S, si, fnoff): i64 {
    STI(S, GTI(S) + 1);                     # consume ':'
    var ed = _ek_of_ptr_ann(S, GTI(S));     # 6.7.8 (C2-3a): T's kind rides the step (`_ps_word`)
    var vd = _ek_vd(S, GTI(S));             # 6.7.12: a `*V`'s vector (`_ps_vdesc`)
    var ann = GTI(S);
    var ps = _fld_ptr_late(S);
    if (ps == 0) { ps = _fld_ptr_annot(S, fnoff, ann); }
    var ent = L64(S + 0x1AA018 + si * 8) + (L64(S + 0x1A8018 + si * 8) & 0x7FFFFFFFFFFFFFFF);
    var top = L64(S + 0x1AC018);
    ADDFIELD(S, si, fnoff);
    if (L64(S + 0x1AC018) == top) { return 0; }   # refused (and reported) by ADDFIELD
    if (ent >= 8192) { return 0; }
    if (_fld_ps == 0) { _fld_ps = alloc(8192 * 8); }
    S64(_fld_ps + ent * 8, _ps_vw(_ps_word(ps, ed), vd));   # a late struct T (`0 - token`) keeps its form
    if (ps < 0) { _fld_pb_note(S, ent, si); }
    _fld_pp_push(S, ann, ent, si);   # 6.7.13: a `**T`'s pointee, pinned at the struct's `}` (6.7.16)
    return 0;
}
# ⛔ 6.7.16 — A `**G<..>` FIELD MINTS ITS INSTANCE AFTER THE STRUCT'S `}`. A struct's fields fill one run of the field
# pool, and a `**Box<S16>` field minted `Box<S16>` in the middle of that run — its annotation sized the instance it
# never uses (a `**` steps 8) and its pin sized it again — so the instance's fields took the slots the struct's next
# field then overwrote: `b.v` / `b.n` of a `Box<S16>` were "unknown field" ever after (`**Box<A>` inside A also sized
# Box<A> with the A so far). The annotation now checks its type arguments without minting (`_fld_targ_chk`, as a
# `*Box<..>` field's, 6.7.15's D8), and the pin is taken at the `}` (`_fld_pp_end`), the struct whole and its run
# closed. CHANGELOG [6.7.16]
var _ppk_nomint = 0;   # `_ptr_step_peek` checks a generic's list without minting it
fn _fld_ptr_annot(S, fnoff, ann): i64 {
    if (_trs_ret_fnp(S, ann) == 1) {   # 6.7.17 (D8): `cb: *fn( .. )`, one 8-byte word (`_ptr_fnp_end`)
        STI(S, _ptr_fnp_end(S, ann, fnoff, 0, " for struct field "));
        return 8;
    }
    if (TOKTYP(S, ann + 1) != 8) {
        _ptr_fld = 1;
        var p1 = _ptr_annot(S, fnoff, 0);
        _ptr_fld = 0;
        return p1;
    }
    if (_fld_pp_late(S, ann) == 1) { return 8; }   # 6.7.16 (D103): `**B`, B declared below
    _ppk_nomint = 1;
    _ptr_fld = 1;
    var ps = _ptr_annot(S, fnoff, 0);
    _ppk_nomint = 0;
    _ptr_fld = 0;
    return ps;
}
# ⛔ 6.7.16 (the user's D103, 2026-10-20) — A `**B` / `**Box<B>` FIELD POINTS AT A STRUCT DECLARED BELOW, AS `*B` DOES.
# 6.6.17 sizes a one-star `p: *B` field at its use (`_fld_ptr_late`), so two structs can point at each other; a field
# with two stars or more read its pointee at the field — "type 'B' is declared after its use" — and its pin at the
# struct's `}` minted `Box<B>` there — "unknown type 'B' as a type argument". Such a field's annotation is now consumed
# with its type arguments checked as the late `*B` field's are (`_fld_targ_chk`, `_fld_ngt`), and its pin is late
# (`_pp_word_at`: B's token, sized at the dereference by `_pp_inner`, its struct named there by `_pp_sid`), at any depth.
# A by-value `B` field below stays refused. CHANGELOG [6.7.16]
# The field annotation whose first `*` is token `ann` (two stars or more): 1 when its pointee past the stars is a struct
# or union declared further down, or a generic one declared above whose type arguments do not resolve yet (`Box<B>`,
# or no type: `_fld_targ_chk` refuses that) — checked and consumed; else 0, the cursor untouched.
fn _fld_pp_late(S, ann): i64 {
    var ti = ann;
    while (TOKTYP(S, ti) == 8) { ti = ti + 1; }
    if (_pp_late_name(S, ti) == 0) { return 0; }
    _fld_targ_chk(S, ti);
    _fld_ngt(S, ti);
    STI(S, ti + 1);
    SKIP_GENERICS(S);
    return 1;
}
# 1 when the pointee name at token ti is a struct or union declared further down, or a generic struct declared above
# whose `<..>` after it does not resolve yet.
fn _pp_late_name(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var noff = TOKVAL(S, ti);
    var sid = FINDSTRUCT(S, noff);
    if (sid <= 0) { return _declared_later(S, noff, 40, 101); }
    if (TOKTYP(S, ti + 1) != 19) { return 0; }
    if (GSTP(S, sid - 1) == 0) { return 0; }
    if (_targs_resolvable(S, ti + 2) == 1) { return 0; }
    return 1;
}
var _fpp = 0;     # 3 words per pending pin: the annotation's first `*`, the field entry, the struct
var _fpp_n = 0;
var _fpp_cap = 0;
fn _fld_pp_push(S, ann, ent, si): i64 {
    if (TOKTYP(S, ann) != 8) { return 0; }
    if (TOKTYP(S, ann + 1) != 8) { return 0; }
    if (_fpp_n >= _fpp_cap) {
        var t = alloc((_fpp_cap * 2 + 16) * 24);
        _tab_copy(t, _fpp, _fpp_n * 3);
        _fpp = t;
        _fpp_cap = _fpp_cap * 2 + 16;
    }
    S64(_fpp + _fpp_n * 24, ann);
    S64(_fpp + _fpp_n * 24 + 8, ent);
    S64(_fpp + _fpp_n * 24 + 16, si);
    _fpp_n = _fpp_n + 1;
    return 0;
}
# At struct si's `}`: its pending pins, in field order (a pin may mint an instance, whose own run of pending pins
# above these is its own). CHANGELOG [6.7.16]
fn _fld_pp_end(S, si): i64 {
    var b = _fpp_n;
    while (b > 0) {
        if (L64(_fpp + (b - 1) * 24 + 16) != si) { break; }
        b = b - 1;
    }
    var e = _fpp_n;
    var k = b;
    while (k < e) {
        _fld_pp_one(S, si, L64(_fpp + k * 24), L64(_fpp + k * 24 + 8));
        k = k + 1;
    }
    _fpp_n = b;
    return 0;
}
# One pending pin (`ann` the field's first `*`, `ent` its entry), read under the struct's own binding as a late `*S<..>`
# field's is (`_fld_pb_note`: an instance's arguments, the definition's T -> i64): `struct W<T> { p: **Box<T>; }` read
# `Box<T>` unbound, "unknown type 'T' as a type argument". A `**S` of this struct is pinned late. CHANGELOG [6.7.16]
fn _fld_pp_one(S, si, ann, ent): i64 {
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _fld_pb_note(S, ent, si);
    _fld_pb_bind(S, ent);
    var pn = _pp_pin_at(S, ann, si, ent);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    S64(_fld_ps + ent * 8, _ps_pw(L64(_fld_ps + ent * 8), pn));
    return 0;
}
# ⛔ 6.6.20 — the binding a late `*S<..>` field is re-read under. `_fld_ps_get` / `_fld_ptr_sid`
# re-read the DEFINITION's tokens at the USE site, under whatever type parameters were bound
# there: in a plain fn `struct L<T> { next: *L<T>; }`'s T was unbound — `a.next + 1` stepped the
# base L whatever the instance, and `a.next.v` was refused "unknown type 'T'" even on L<i64> —
# and in `fn k<T>` the struct's T silently took k's binding, so `a.next.w = 9` wrote with another
# instance's layout, past the end of the struct. Recorded per entry: the struct's own parameters
# (GSTP, set before its fields parse) bound as they are now — an instance's arguments, or the i64
# base's -8 for the definition itself. Any other binding is dropped (a non-generic struct's field
# names no parameter). 4 words per entry: n0, c0, n1, c1 (`_tp_bind`'s pairs). CHANGELOG [6.6.20]
var _fld_pb = 0;
fn _fld_pb_note(S, ent, si): i64 {
    if (_fld_pb == 0) { _fld_pb = alloc(8192 * 32); }
    var b = _fld_pb + ent * 32;
    var stp = GSTP(S, si);
    var n0 = stp & 0xFFFFFFFF;
    var n1 = (stp >> 32) & 0xFFFFFFFF;
    S64(b, 0); S64(b + 8, 0); S64(b + 16, 0); S64(b + 24, 0);
    if (n0 != 0) { S64(b, n0 - 1); S64(b + 8, _tp_or_base(S, n0 - 1)); }
    if (n1 != 0) { S64(b + 16, n1 - 1); S64(b + 24, _tp_or_base(S, n1 - 1)); }
    return 0;
}
fn _tp_or_base(S, noff): i64 {
    var c = _tp_resolve(S, noff);
    if (c == 0) { return 0 - 8; }
    return c;
}
# Replace the binding in force with entry `ent`'s; the caller saved it and puts it back.
fn _fld_pb_bind(S, ent): i64 {
    _tp_clear(S);
    if (_fld_pb == 0) { return 0; }
    var b = _fld_pb + ent * 32;
    _tp_n0 = L64(b); _tp_c0 = L64(b + 8); _tp_n1 = L64(b + 16); _tp_c1 = L64(b + 24);
    return 0;
}
# Cursor on the `*` of a field's `*T`: when T (one `*`) names a struct — this one, one declared
# above, or one declared below — consume the annotation and return `0 - (ti + 1)` (T's token);
# else 0, cursor untouched. ⛔ 6.7.15 — and a generic struct's type parameter bound to a struct
# (`struct Pb<T> { p: *T; }` in its instance `Pb<Pt>`): recorded late, its binding noted per entry
# (`_fld_pb_note`), so `b.p.y` hops through it as through a `p: *Pt` field (it stopped at `b.p`:
# "expected ';', got '.'"). A scalar binding keeps the step it had. CHANGELOG [6.7.15]
fn _fld_ptr_late(S): i64 {
    var ti = GTI(S) + 1;
    if (TOKTYP(S, ti) != 2) { return 0; }
    var noff = TOKVAL(S, ti);
    if (_fld_tp_struct(S, ti) == 1) {
        STI(S, ti + 1);
        return 0 - (ti + 1);
    }
    if (FINDSTRUCT(S, noff) <= 0) { if (_declared_later(S, noff, 40, 101) == 0) { return 0; } }
    _fld_targ_chk(S, ti);
    _fld_ngt(S, ti);   # 6.7.16 (D7)
    STI(S, ti + 1);
    SKIP_GENERICS(S);
    return 0 - (ti + 1);
}
# ⛔ 6.7.15 (D8) — A LATE `p: *G<..>` FIELD'S TYPE ARGUMENTS ARE CHECKED AT THE FIELD (`ti` G's token, its `<` next,
# G a generic struct declared above or below). The list was skipped unread (6.6.17's late sizing), so
# `p: *Box<Zork>` and `p: *Box<1>` compiled while the field was unused and were refused only at a use. Read as
# `_targ_chk` reads a Vec element's list — every refusal of a type argument once, at its token, nothing
# instantiated, the cursor, the owed closers and the panic latch put back — and a struct declared further down is a
# name (`_ta_late`), so two structs pointing at each other through `*Box<B>` / `*Box<A>` are unchanged. A use
# re-reads the same tokens, so its report is the declaration's, printed once (the user's D8 (a), 2026-10-18). A
# non-generic G's list is D6's. CHANGELOG [6.7.15]
fn _fld_targ_chk(S, ti): i64 {
    if (_MONOMORPH_OK != 1) { return 0; }
    if (TOKTYP(S, ti + 1) != 19) { return 0; }
    var noff = TOKVAL(S, ti);
    var sid = FINDSTRUCT(S, noff);
    if (sid > 0) { if (GSTP(S, sid - 1) == 0) { return 0; } }
    if (sid <= 0) { if (_declared_later_gen(S, noff) == 0) { return 0; } }
    var sv_rf = _ta_refd;
    var sv_lt = _ta_late;
    _ta_late = 1;
    _targ_chk(S, ti + 1);
    _ta_late = sv_lt;
    _ta_refd = sv_rf;
    return 0;
}
# 6.7.16 (D7): a pointer field's non-generic pointee given `<..>` (`ti` its name), refused at the field, once: a struct
# declared above by `_ngt_refuse`; one declared further down (the reason this reader exists) by its declaration's
# tokens, as `_fld_targ_chk` reads a generic one. A use re-reads the same tokens silently (`_ptr_tok_sid`).
fn _fld_ngt(S, ti): i64 {
    if (TOKTYP(S, ti + 1) != 19) { return 0; }   # 6.7.17 (D102): under CYRIUS_MONOMORPH=0 too (it returned 0 there)
    if (FINDSTRUCT(S, TOKVAL(S, ti)) > 0) { return _ngt_refuse(S, ti); }
    if (_declared_later_gen(S, TOKVAL(S, ti)) == 1) { return 0; }
    return _ngt_say(S, ti, " is not a generic struct: it takes no type arguments");
}
# 1 when token `ti` is a type parameter bound to a struct right now, with no `<` after it.
fn _fld_tp_struct(S, ti): i64 {
    if (_tp_c0 == 0) { return 0; }
    if (TOKTYP(S, ti + 1) == 19) { return 0; }
    if (_tp_resolve(S, TOKVAL(S, ti)) > 0) { return 1; }
    return 0;
}
# The pointee struct of a `name: *T` field — T a struct, or a generic instance — else 0. 6.6.17
fn _fld_ptr_sid(S, si, fi): i64 {
    if (_fld_ps == 0) { return 0; }
    var ent = (L64(S + 0x1AA018 + si * 8) + fi) & 0x7FFFFFFFFFFFFFFF;
    if (ent >= 8192) { return 0; }
    var v = L64(_fld_ps + ent * 8);
    if (v >= 0) { return 0; }
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _fld_pb_bind(S, ent);
    var sid = _ptr_ann_sid_tp(S, 0 - v - 2);   # 6.7.15: on the `*`, so a bound T is its struct
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return sid;
}
# A field's step word (6.7.8: kind included; a late struct T's, sized here, has none).
fn _fld_ps_get(S, si, fi): i64 {
    if (_fld_ps == 0) { return 0; }
    var ent = (L64(S + 0x1AA018 + si * 8) + fi) & 0x7FFFFFFFFFFFFFFF;
    if (ent >= 8192) { return 0; }
    var v = L64(_fld_ps + ent * 8);
    if (v >= 0) { return v; }
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _fld_pb_bind(S, ent);
    var sv = GTI(S);
    STI(S, 0 - v - 1);
    var ps = _ptr_step_peek(S, 0 - 1, 1);
    STI(S, sv);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return ps;
}
# A `fn f(): *T` return (cursor on the `*`): recorded as an i64 return plus T's step, which a
# call to it carries (`_call_ret_ps`). `quiet` 1 in pass 1 (`_prescan_fn_sig`), which only
# records it; pass 2 (PARSE_FN_DEF) refuses an unknown T and sets the fn's return scalar.
var _fn_rps = 0;   # per fn: the step word of a `*T` return (6.7.8: + the kind, `_ps_word`), else 0
var _fn_rpsid = 0; # per fn: T's struct for a `*T` return (6.6.17, `_call_ptr_field`), else 0
# ⛔ 6.6.20 — a generic INSTANCE's `: *T` is read under the instance's binding, as `_gtype_sid`
# reads `: Box<T>`: PARSE_FN_DEF binds T only around the parameter loop and the body, and the
# return type sits between them, so every instance recorded the unbound T's i64 step (8) and
# `gr<i32>(..) + 1` stepped 8. The binding in force is put back after. CHANGELOG [6.6.20]
# ⛔ 6.7.14 — and the BASE's under the base's: T -> i64, as PARSE_FN_DEF binds the base body. Read unbound, the
# `T` of `fn mkp<T>(x: T): *Box<T>` was refused as a type argument ("unknown type 'T'"), in pass 1 and again in
# pass 2, so the definition never compiled; a bare `*T` is the i64 step either way. CHANGELOG [6.7.14]
fn _ret_ptr_base_bind(S, fi): i64 {
    if (_MONOMORPH_OK != 1) { return 0; }
    if (_inst_conc0 != 0) { return 0; }
    if (GFTP(S, fi) == 0) { return 0; }
    _bind_generic_call(S, fi, 0 - 8, 0 - 8);
    return 0;
}
