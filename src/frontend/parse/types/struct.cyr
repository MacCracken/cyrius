# PARSER — types: the struct table — a variable's struct id, REGSTRUCT / FINDSTRUCT, the fields (ADDFIELD*, GETFTYPE,
# FIELDOFF), sizes (STRUCTSZ, AGG_NSLOTS).
# ================================================================
# Split from parse/types.cyr at 6.7.18, unchanged; parse.cyr includes parse/types/ in source order. CHANGELOG [6.7.18]

# Get/set struct_id for global variable at index vi.
# v6.2.18+ math mini-arc: scalar f64/f32 reuse the var-type slot with high
# sentinel codes (distinct from struct ids, which are small positives). A var
# of these types is 8-byte-stored (the f64 bit pattern, or the f32 bits in the
# low 32) so the existing `vt>0 && size==8` value-load path applies; PEXPR /
# PARSE_TERM route operators on F64_TYID to the EMIT_F64_BINOP builtin (f32 is
# type-only — converted via f32_from/f32_to, no f32 arithmetic).
var F64_TYID = 0x40000001;
var F32_TYID = 0x40000002;
# v6.5.21 — GFRS marker for a MULTI-VALUE return signature, `fn f(): (f64, f64)`.
# The arity and element types live in GFRN / GFRT (util.cyr); this only says
# "look there". -40 sits in the gap between the scalar sentinels (-1 .. -19) and
# the SIMD descriptor band (-2092 .. -2178).
var MULTIRET_SID = 0 - 40;
# 0x40000003 was CLOSURE_TYID (v6.3.8 - v6.5.16) — RETIRED, do not reuse. A local
# holding a capturing closure was stamped with it so callptr could recognise the
# value. That only worked while the value sat in its declaring `var`, and the
# sentinel additionally leaked into SPSC as a pointer scale (`(f + 1) - f` == 2^30+3).
# v6.5.17 moved the decision to RUNTIME — bit 63 of the value itself; see ECLNORM
# in backend/x86/emit.cyr.
# v6.3.11 (G) — a value holding an async Future object `[impl_ptr, argc, args…]`
# (built by an `async fn`'s synthesized constructor). `await fut` forces it via the
# runtime's future_force. The tag is informational in v1 (await calls future_force
# on its operand directly); reserved for future await-type checking.
var FUTURE_TYID = 0x40000004;
fn GVTYPE(S, vi): i64 { return L64(_vart_base + vi * 8); }
fn SVTYPE(S, vi, v): i64 { S64(_vart_base + vi * 8, v); return 0; }
# v6.4.23: per-var signedness (1 = signed sub-i64 iN scalar global). var_size can't
# hold it (fixup.cyr SUMS it for data layout); the type table has 6 direct readers.
fn GVSGN(S, vi): i64 { return L64(_vsgn_base + vi * 8); }
fn SVSGN(S, vi, v): i64 { S64(_vsgn_base + vi * 8, v); return 0; }

# v5.7.17: dump every registered struct name to stderr. Called from
# REGSTRUCT before the cap-overflow ERR_MSG so the user sees WHICH
# structs filled the table (before the cap raise from 64, the
# diagnostic pointed at the first user-code struct line — even when
# the overflow came from auto-prepended dep dist bundles, which
# blamed the user instead of the deps. kybernet 2026-04-27 surfacing).
fn DUMP_STRUCTS(S): i64 {
    var sc = GSTC(S);
    _ew("note: ", 6);
    PRNUM(sc);
    _ew(" structs registered (deps usually fill most via auto-prepend); names follow:\n", 77);
    var i = 0;
    while (i < sc) {
        var noff = L64(S + 0x1A6018 + i * 8);
        _ew("  #", 3);
        PRNUM(i);
        _ew(" ", 1);
        var nlen = 0;
        while (load8(S + 0xEC00000 + noff + nlen) != 0) { nlen = nlen + 1; }
        _ew(S + 0xEC00000 + noff, nlen);
        _ew("\n", 1);
        i = i + 1;
    }
    return 0;
}

# Register a new struct, return index (1-based, 0 = not a struct)
# 6.6.10: returns 0 when the table is full. ERR_MSG returns (multi-error, v6.4.62), so this
# cap used to fall through into the stores at index 1024+; both callers now skip the body on
# 0 (indexing with sid - 1 = -1 would write at negative indices). DUMP_STRUCTS runs on the
# FIRST overflow only — once per refused struct made the note quadratic (600,953 lines at
# 1500 structs). CHANGELOG [6.6.10]
var _regstruct_dumped = 0;
fn REGSTRUCT(S, noff): i64 {
    var sc = GSTC(S);
    if (sc >= 1024) {
        # 6.7.16: said once — each refused declaration now ends at its own `}` (`_tl_decl1`), so every struct past the
        # cap printed it again (78 times for 1,100 structs). The rest are counted. CHANGELOG [6.7.16]
        if (_regstruct_dumped == 1) { _had_error = 1; _panic = 1; return 0; }
        DUMP_STRUCTS(S);
        _regstruct_dumped = 1;
        ERR_MSG(S, "too many struct definitions (max 1024)", 38);
        return 0;
    }
    S64(S + 0x1A6018 + sc * 8, noff);
    S64(S + 0x1A8018 + sc * 8, 0);
    S64(S + 0x1AA018 + sc * 8, L64(S + 0x1AC018));   # field_base[sc] = pooltop (v6.0.47 packed field pool)
    SSTC(S, sc + 1);
    return sc + 1;
}

# Find struct by name, return 1-based index or 0
fn FINDSTRUCT(S, noff): i64 {
    var sc = GSTC(S);
    var i = 0;
    while (i < sc) {
        var sn = L64(S + 0x1A6018 + i * 8);
        if (STREQ(S, sn, noff) == 1) { return i + 1; }
        i = i + 1;
    }
    return 0;
}

# Add field to struct (0-based struct index si), ftype = struct_id or 0 for scalar
# 6.6.11: a union keeps its flag in bit 63 of the count (PARSE_UNION_DEF), so the count is
# MASKED for the 256 cap, the pool entry and the pool top, and raw + 1 is stored back. Read raw,
# a union's count was negative (the cap never fired), and the flag rode `pooltop` into every
# later struct's field_base, so the signed 8192 test never tripped either. CHANGELOG [6.6.11]
fn ADDFIELD(S, si, fnoff): i64 {
    var raw = L64(S + 0x1A8018 + si * 8);
    var fc = raw & 0x7FFFFFFFFFFFFFFF;
    if (fc >= 256) { ERR_MSG(S, "too many struct fields (max 256)", 32); return 0; }   # 6.6.10: stop, don't store
    var ent = L64(S + 0x1AA018 + si * 8) + fc;   # packed pool: field_base[si] + fc
    if (ent >= 8192) { ERR_MSG(S, "struct field pool exhausted (8192 max)", 38); return 0; }
    S64(S + 0x92A000 + ent * 8, fnoff);
    S64(S + 0x91A000 + ent * 8, 0);
    S64(S + 0x1A8018 + si * 8, raw + 1);
    S64(S + 0x1AC018, ent + 1);   # pooltop = ent + 1 (sequential per-struct fill)
    return 0;
}

fn ADDFIELDTYPED(S, si, fnoff, ftype): i64 {
    var raw = L64(S + 0x1A8018 + si * 8);   # masked as in ADDFIELD (union flag, bit 63)
    var fc = raw & 0x7FFFFFFFFFFFFFFF;
    if (fc >= 256) { ERR_MSG(S, "too many struct fields (max 256)", 32); return 0; }   # 6.6.10: stop, don't store
    var ent = L64(S + 0x1AA018 + si * 8) + fc;   # packed pool: field_base[si] + fc
    if (ent >= 8192) { ERR_MSG(S, "struct field pool exhausted (8192 max)", 38); return 0; }
    S64(S + 0x92A000 + ent * 8, fnoff);
    S64(S + 0x91A000 + ent * 8, ftype);
    S64(S + 0x1A8018 + si * 8, raw + 1);
    S64(S + 0x1AC018, ent + 1);   # pooltop = ent + 1 (sequential per-struct fill)
    return 0;
}

# 6.6.10 — ADDFIELD, then record the field's float kind (1 = f64, 2 = f32; 0 records nothing).
# The entry is computed the way ADDFIELD computes it, and marked only when ADDFIELD actually
# stored (a refused field leaves the pool top where it was). See SFFK. CHANGELOG [6.6.10]
fn ADDFIELDFK(S, si, fnoff, k): i64 {
    var ent = L64(S + 0x1AA018 + si * 8) + (L64(S + 0x1A8018 + si * 8) & 0x7FFFFFFFFFFFFFFF);
    var top = L64(S + 0x1AC018);
    ADDFIELD(S, si, fnoff);
    if (k == 0) { if (_fld_bool == 0) { if (_fld_uns == 0) { return 0; } } }
    if (L64(S + 0x1AC018) == top) { return 0; }
    SFUNS(S, ent, 0);   # 6.7.10 (B7): not an unsigned narrow field (_add_narrow_field marks those)
    if (k == 3) { SFBOOL(S, ent, 1); return 0; }   # 6.7.3: a bool field (not a float kind)
    SFBOOL(S, ent, 0);
    if (k == 0) { return 0; }
    SFFK(S, ent, k);
    return 0;
}

fn GETFTYPE(S, si, fi): i64 {
    var b = L64(S + 0x1AA018 + si * 8);
    return L64(S + 0x91A000 + (b + fi) * 8);
}

# Get field name offset (into tok_names at S+0x60000) for struct si, field fi.
# Returns the same offset that was recorded by ADDFIELD, so direct equality
# with a parsed IDENT's PEEKV works (idents are interned by the lexer).
fn GETFNAME(S, si, fi): i64 {
    var b = L64(S + 0x1AA018 + si * 8);
    return L64(S + 0x92A000 + (b + fi) * 8);
}

# Compare two null-terminated strings in tok_names. Returns 1 if equal.
# Needed because named-field init uses the identifier buffer (S+0x60000)
# where two different source occurrences of the same name share an offset
# (dedup), but defensive equality handles the rare non-interned case too.
fn STREQTOK(S, a_off, b_off): i64 {
    if (a_off == b_off) { return 1; }
    var i = 0;
    while (1 == 1) {
        var ca = load8(S + 0xEC00000 + a_off + i);
        var cb = load8(S + 0xEC00000 + b_off + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# v5.10.7 — `: Str` field detection. A struct field whose type
# is the `Str` struct (defined in `lib/str.cyr`) is treated as
# a SINGLE 8-byte pointer slot rather than a 16-byte by-value
# inline embedding. Mirrors the v5.10.2 ≤16-byte calling-conv
# convention: Str values flow as pointers to heap-allocated
# 16-byte headers, so a Str-typed struct field is also a
# pointer slot.
#
# Pre-v5.10.7 FIELDSZ returned 16 for `: Str` fields (full
# STRUCTSZ of Str), which made PARSE_STRUCT_INIT positional
# flatten consume 2 expressions per Str field (data + len) —
# but PP_DERIVE Serialize codegen + load64-at-offset
# semantics treated Str as 1 pointer slot. The mismatch
# surfaced in the agnosys 1.1.12 follow-up: struct init like
# `var s = named_status { my_str, 42 };` errored
# `unexpected '}'` because the parser was still expecting a
# third expression for the i64 field after consuming
# `my_str`/`42` as data/len.
fn IS_STR_FIELD(S, ft): i64 {
    if (ft <= 0) { return 0; }
    var sname_off = L64(S + 0x1A6018 + (ft - 1) * 8);
    if (load8(S + 0xEC00000 + sname_off)     != 83)  { return 0; }
    if (load8(S + 0xEC00000 + sname_off + 1) != 116) { return 0; }
    if (load8(S + 0xEC00000 + sname_off + 2) != 114) { return 0; }
    if (load8(S + 0xEC00000 + sname_off + 3) != 0)   { return 0; }
    return 1;
}

# v6.4.x Pin 2 — Vec<T> array-typed struct field encoding. A Vec<T> field is
# an 8-byte pointer slot (the vec_new() handle), like a Str field, but Vec is
# not a registered struct so it cannot be name-detected. The ftype cell carries
# a far-negative sentinel: MKVEC(elem) = -0x50000 - elem, where `elem` is the
# element type in the normal field-type encoding (>0 struct sid, 0 = i64/f64,
# <0 = -width scalar). IS_VEC_FIELD tests the sentinel window BEFORE any ft>0 /
# ft<0 decode (the -2121-class OOB guard); the element type is `(0 - 0x50000) - ft`.
# The window (-0x80000, -0x40000] is disjoint from every real field ftype
# (0, sids 1..1024, -1/-2/-4 widths).
fn MKVEC(S, elem): i64 {
    return (0 - 0x50000) - elem;
}
fn IS_VEC_FIELD(S, ft): i64 {
    if (ft <= (0 - 0x40000)) {
        if (ft > (0 - 0x80000)) { return 1; }
    }
    return 0;
}

# Get byte size of a single field from its type encoding
# >0 = nested struct ID, 0 = untyped (8), <0 = sized scalar (-width)
# v5.10.7 — Str field special-case: 8 bytes (pointer slot).
# v6.4.x — Vec<T> field special-case: 8 bytes (pointer slot), guarded FIRST.
fn FIELDSZ(S, ft): i64 {
    if (IS_VEC_FIELD(S, ft) == 1) { return 8; }
    if (ft > 0) {
        if (IS_STR_FIELD(S, ft) == 1) { return 8; }
        return STRUCTSZ(S, ft - 1);
    }
    if (ft < 0) { return 0 - ft; }
    return 8;
}

# Get total size of a struct/union in bytes
fn STRUCTSZ(S, si): i64 {
    var fc = GETFCOUNT(S, si);
    var is_u = ISUNION(S, si);
    var sz = 0;
    var i = 0;
    while (i < fc) {
        var fsz = FIELDSZ(S, GETFTYPE(S, si, i));
        if (is_u == 1) {
            if (fsz > sz) { sz = fsz; }
        } else {
            sz = sz + fsz;
        }
        i = i + 1;
    }
    return sz;
}

# 6.6.5 — how many 8-byte frame slots an aggregate SLTYPE spans. `t` is the local's
# type marker: `0 - sid` for a struct, a descriptor-band sentinel (<= -2048) for a
# vector. Returns 1 for anything that is not a multi-word aggregate, so callers can use
# the count unconditionally. One definition, so the picker, the copy paths and the
# literal allocator cannot disagree about a struct's width. CHANGELOG [6.6.5]
fn AGG_NSLOTS(S, t): i64 {
    if (t >= 0) { return 1; }
    if (_vec_desc(S, t) == 1) { return GVEC_NSLOTS(S); }
    var sz = STRUCTSZ(S, (0 - t) - 1);
    if (sz <= 8) { return 1; }
    return ((sz + 7) & (0 - 8)) / 8;
}

# 6.6.5 — a struct that fits in ONE 8-byte slot is held BY VALUE, on every target. This
# is the ABI policy that used to live inside `_resolve_field_base_addr` as an inline
# `if (_TARGET_CX == 0) { if (STRUCTSZ <= 8) ... }` guess; recording it at registration
# is what lets cx answer it the same way as x86 and aarch64. Before this, cx skipped the
# rule entirely, so two `var b: B1;` single-field locals both dereferenced their own
# uninitialised slot and ALIASED each other (measured 2 where 43 is right).
# 6.7.10: a local is marked only when it holds a struct VALUE of its type (the handle line,
# `_mark_small_init`; parameters at their binding), and the size is the packed one — u8..u32 /
# f32 fields count their own bytes, so `struct C4 { r: u8; g: u8; b: u8; a: u8; }` (4 B) is held
# here, where through 6.7.9 it was 32 B. CHANGELOG [6.7.10]
fn MARK_SMALL_STRUCT(S, li, t): i64 {
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }        # SIMD descriptor band — not a struct sid
    if (STRUCTSZ(S, (0 - t) - 1) > 8) { return 0; }
    SLAGG(S, li, 1);
    return 0;
}

# Get byte offset of field fi within struct/union si
fn FIELDOFF(S, si, fi): i64 {
    if (ISUNION(S, si) == 1) { return 0; }
    var off = 0;
    var i = 0;
    while (i < fi) {
        off = off + FIELDSZ(S, GETFTYPE(S, si, i));
        i = i + 1;
    }
    return off;
}
