# PARSER — control flow: ECONDOP/ECONDOPT/ECONDCMP/ECOND/ECOND_AND/
# ECOND_OR / PATCHXP / PARSE_ELIF / PARSE_IF / PARSE_WHILE / PARSE_FOR.
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38 to keep single-file
# LOC under ~1500. Included by parse.cyr at the same textual position
# the original content lived; self-host byte-identical.

fn ECONDOP(S, op): i64 {
    if (op == 17) { return EJCC(S, 0x85); }
    if (op == 18) { return EJCC(S, 0x84); }
    if (op == 19) { return EJCC(S, 0x8D); }
    if (op == 20) { return EJCC(S, 0x8E); }
    if (op == 21) { return EJCC(S, 0x8F); }
    if (op == 22) { return EJCC(S, 0x8C); }
    ERR(S);
    return 0;
}

# Emit NON-inverted jcc (for || true-branch)
fn ECONDOPT(S, op): i64 {
    if (op == 17) { return EJCC(S, 0x84); }
    if (op == 18) { return EJCC(S, 0x85); }
    if (op == 19) { return EJCC(S, 0x8C); }
    if (op == 20) { return EJCC(S, 0x8D); }
    if (op == 21) { return EJCC(S, 0x8E); }
    if (op == 22) { return EJCC(S, 0x8F); }
    ERR(S);
    return 0;
}

# Parse one comparison: expr OP expr — emit cmp, return op token
fn ECONDCMP(S): i64 {
    PCMPE(S);
    var op = PEEKT(S);
    # If no comparison operator follows, treat value as boolean.
    # v5.6.8 O2 category 2: flag-result reuse. Pre-v5.6.8 this path
    # emitted push/xor/movca/pop/cmp (5 insns, ~10 bytes) to land a
    # `cmp rax, 0`. Strictly equivalent to `test rax, rax` (3 bytes),
    # which ETESTAZ already emits. ALSO: if the last emit-helper set
    # ZF based on rax (arith that updates rax in place — add/sub/
    # and/or/xor/not/shl/shr/xor-rax-rax/movi-zero), ZF is already
    # valid and the test itself is redundant — skip emit entirely.
    # Tracked in `_flags_reflect_rax` (see x86/emit.cyr). aarch64
    # currently emits non-S-variant add/sub so the flag never goes
    # true there; the skip becomes a no-op and ETESTAZ fires as
    # before.
    if (op < 17 || op > 22) {
        if (_flags_reflect_rax == 0) { ETESTAZ(S); }
        return 18;
    }
    EPUSHR(S);
    STI(S, GTI(S) + 1);
    PCMPE(S);
    EMOVCA(S);
    EPOPR(S);
    ECMPR(S);
    return op;
}

# Parse condition: expr OP expr [&& expr OP expr]* [|| expr OP expr]*
# Returns patch offset for false branch. Extra patches stored via ADDXP.
fn ECOND(S): i64 {
    SXPC(S, 0);
    var op = ECONDCMP(S);
    # Check for && or ||
    if (PEEKT(S) == 53) {
        return ECOND_AND(S, op);
    }
    if (PEEKT(S) == 54) {
        return ECOND_OR(S, op);
    }
    return ECONDOP(S, op);
}

fn ECOND_AND(S, op): i64 {
    var p1 = ECONDOP(S, op);
    ADDXP(S, p1);
    STI(S, GTI(S) + 1);
    var op2 = ECONDCMP(S);
    # Chain: support a && b && c
    if (PEEKT(S) == 53) {
        return ECOND_AND(S, op2);
    }
    return ECONDOP(S, op2);
}

fn ECOND_OR(S, op): i64 {
    var ptrue = ECONDOPT(S, op);
    STI(S, GTI(S) + 1);
    var op2 = ECONDCMP(S);
    # Chain: support a || b || c
    if (PEEKT(S) == 54) {
        EPATCH(S, ptrue);
        return ECOND_OR(S, op2);
    }
    var pfalse = ECONDOP(S, op2);
    EPATCH(S, ptrue);
    return pfalse;
}

# Patch all extra condition patches (from &&) to current position
fn PATCHXP(S): i64 {
    var xc = GXPC(S);
    var xi = 0;
    while (xi < xc) {
        EPATCH(S, L64(S + 0x18F848 + xi * 8));
        xi = xi + 1;
    }
    SXPC(S, 0);
    return 0;
}

# Parse: if (cond) { stmts } [else { stmts }]
# Parse elif chain as recursive: each elif is essentially else { if (...) { } ... }
# ⛔ 6.6.17 (a6): an `elif` body and the `else` after it are scopes, as the `if` arm's are
# (PARSE_IF). They had no SCOPE_PUSH / SCOPE_POP, so a `var` declared there outlived its `}`: at
# fn scope `elif { var t } else { var t }` was "duplicate variable", and at top level the name
# stayed visible after the chain. CHANGELOG [6.6.17]
fn PARSE_ELIF(S, cond_patch): i64 {
    # Emit jmp-to-end for previous branch
    var skip = EJMP0(S);
    # Patch previous condition-false to land here (+ any && extras)
    PATCHXP(S);
    EPATCH(S, cond_patch);
    # Parse new condition
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
    STI(S, GTI(S) + 1);
    var patch = ECOND(S);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    SCOPE_PUSH(S);
    PARSE_PROG(S);
    SCOPE_POP(S);
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    # Check for more elif/else
    if (PEEKT(S) == 50) {
        STI(S, GTI(S) + 1);
        PARSE_ELIF(S, patch);
    } else { if (PEEKT(S) == 23) {
            STI(S, GTI(S) + 1);
            var skip2 = EJMP0(S);
            PATCHXP(S);
            EPATCH(S, patch);
            if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
            STI(S, GTI(S) + 1);
            SCOPE_PUSH(S);
            PARSE_PROG(S);
            SCOPE_POP(S);
            if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
            STI(S, GTI(S) + 1);
            EPATCH(S, skip2);
        } else {
            PATCHXP(S);
            EPATCH(S, patch);
        } }
    # Patch our skip-to-end
    EPATCH(S, skip);
    return 0;
}

fn PARSE_IF(S): i64 {
    STI(S, GTI(S) + 1);  # consume IF
    var saved_lv = GLVAR(S);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
    STI(S, GTI(S) + 1);  # consume (
    var patch = ECOND(S);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);  # consume )
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);  # consume {
    SCOPE_PUSH(S);
    PARSE_PROG(S);
    SCOPE_POP(S);
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);  # consume }
    if (PEEKT(S) == 50) {
        # elif
        STI(S, GTI(S) + 1);
        PARSE_ELIF(S, patch);
    } else { if (PEEKT(S) == 23) {
            # else
            STI(S, GTI(S) + 1);
            var skip = EJMP0(S);
            PATCHXP(S);
            EPATCH(S, patch);
            if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
            STI(S, GTI(S) + 1);
            SCOPE_PUSH(S);
            PARSE_PROG(S);
            SCOPE_POP(S);
            if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
            STI(S, GTI(S) + 1);
            EPATCH(S, skip);
        } else {
            PATCHXP(S);
            EPATCH(S, patch);
        } }
    SLVAR(S, saved_lv);
    return 0;
}

# ⛔ 6.7.4 (B3) — THE IF-EXPRESSION. The user's decisions (2026-10-08): `if (c) { a } elif (d) { b }
# else { e }` where an expression is parsed; ONE expression per branch (no statements, no `;`), `else`
# required, only the taken branch runs; every branch the same kind — integer (pointers and bools
# included), f64, f32, or one struct type of 8 bytes or less (the result keeps it) — and a struct
# value over 8 bytes refused. At the start of a statement `if` stays the if statement (PARSE_STMT
# never reaches an expression parse there). Dispatched from PARSE_INTRIN, so both factor tiers take it
# and it binds as a factor (`if (c) {a} else {b} + 1` is `(if ..) + 1`).
# Emission is the if statement's: ECONDOP(ECONDCMP) — ECOND without its XP list, which PCMPE leaves
# empty (it consumes every && / ||) — then the branch, a jmp to the join, the next arm. The value is
# in rax / x0 / r0 on every backend. Each branch is classified right after its PCMPE, before any
# emit or token moves the result flags (the B2 stamp, the float-builtin flag), and by SHAPE for a
# struct (GESTYPE leaks from an intrinsic's last argument). At the join, flags and peephole trackers
# that describe only the LAST branch are reset (_ie_finish). CHANGELOG [6.7.4]
# Per-expression state (nesting-safe), 8 words: [0] class (0 none yet, 1 integer, 2 f64, 3 f32,
# 4 a small struct), [8] its sid, [16] every branch boolean, [24] any f64 / f32 TYPED (not only
# flagged), [32] the common float-builtin flag (-1 unset), [40] the common pointer scale (-1 unset),
# [48] the widest SEXW, [56] the expression's first token.
fn PARSE_IF_EXPR(S): i64 {
    var st = alloc(64);
    S64(st, 0);
    S64(st + 8, 0);
    S64(st + 16, 1);
    S64(st + 24, 0);
    S64(st + 32, 0 - 1);
    S64(st + 40, 0 - 1);
    S64(st + 48, 0);
    S64(st + 56, GTI(S));
    _ie_arm(S, st);
    _ie_finish(S, st);
    return 1;
}
# One `if` / `elif` arm (cursor on the keyword); recurses for `elif` the way PARSE_ELIF does.
fn _ie_arm(S, st): i64 {
    var kw = GTI(S);
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
    STI(S, GTI(S) + 1);
    var patch = ECONDOP(S, ECONDCMP(S));
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    _ie_branch(S, st);
    var skip = EJMP0(S);
    EPATCH(S, patch);
    if (PEEKT(S) == 50) { _ie_arm(S, st); }
    elif (PEEKT(S) == 23) { STI(S, GTI(S) + 1); _ie_branch(S, st); }
    else { _ie_no_else(S); EMOVI(S, 0); }
    EPATCH(S, skip);
    return 0;
}
fn _ie_no_else(S): i64 {
    ERR_MSG(S, "an if expression needs an else - its value must come from every path", 68);
    PRSTR("  note: at the start of a statement, `if` is the if statement\n");
    return 0;
}
# Tokens that open a statement, never an expression: refused first in a branch.
fn _ie_stmt_tok(t): i64 {
    if (t == 3 || t == 168 || t == 33 || t == 16 || t == 55 || t == 172) { return 1; }
    if (t == 51 || t == 52 || t == 57 || t == 75 || t == 32) { return 1; }
    if (t == 106 || t == 108 || t == 111 || t == 123 || t == 107) { return 1; }
    if (t == 40 || t == 60 || t == 48 || t == 13) { return 1; }
    return 0;
}
# ... and token `ti` opens one: those, or the contextual `loop {` (6.7.5), which is no token.
fn _ie_stmt_at(S, ti): i64 {
    if (_ie_stmt_tok(TOKTYP(S, ti)) == 1) { return 1; }
    return _TOK_IS_LOOP(S, ti);
}
# From inside a branch, to its closing `}` (the cursor left ON it) — the parse stays in step after a
# refused branch.
fn _ie_skip_block(S): i64 {
    var d = 0;
    var t = PEEKT(S);
    while (t != 12) {
        if (t == 14) { if (d == 0) { return 0; } d = d - 1; }
        if (t == 13) { d = d + 1; }
        STI(S, GTI(S) + 1);
        t = PEEKT(S);
    }
    return 0;
}
# 1 when the branch from `bti` holds `=` outside any bracket — `{ y = 1 }`, `{ y += 1 }` (`+` `=`).
fn _ie_has_assign(S, ti): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (ti < n) {
        var t = TOKTYP(S, ti);
        if (t == 10 || t == 13 || t == 28) { d = d + 1; }
        if (t == 11 || t == 14 || t == 29) { if (d == 0) { return 0; } d = d - 1; }
        if (t == 4) { if (d == 0) { return 1; } }
        if (t == 12) { return 0; }
        ti = ti + 1;
    }
    return 0;
}
# `{ expr }` — the one expression, classified before anything moves the result flags.
fn _ie_branch(S, st): i64 {
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); return 0; }
    STI(S, GTI(S) + 1);
    var bti = GTI(S);
    if (PEEKT(S) == 14) {
        ERR_MSG(S, "an if expression branch needs a value", 37);
        EMOVI(S, 0);
        STI(S, GTI(S) + 1);
        return 0;
    }
    if (_ie_stmt_at(S, GTI(S)) == 1) {
        ERR_MSG(S, "an if expression branch takes one expression, not a statement - an if statement runs statements", 95);
        _ie_skip_block(S);
        EMOVI(S, 0);
        STI(S, GTI(S) + 1);
        return 0;
    }
    if (_ie_has_assign(S, bti) == 1) {
        ERR_MSG(S, "an if expression branch holds a value, not an assignment", 56);
        _ie_skip_block(S);
        EMOVI(S, 0);
        STI(S, GTI(S) + 1);
        return 0;
    }
    _refuse_lossy_pair(S);
    var fk = _fpk_want;
    _fpk_want = bti;
    _fpk_ft = 0;
    _sc_beg = 0 - 1;   # only this branch's own struct-call record may match
    PCMPE(S);
    _fpk_want = fk;
    _ie_kind(S, st, bti);
    if (PEEKT(S) == 5) {
        ERR_MSG(S, "an if expression branch holds one expression, without ';' - an if statement runs statements", 91);
        _ie_skip_block(S);
    } elif (PEEKT(S) != 14) {
        ERR_MSG(S, "an if expression branch holds one expression - this one goes on past it", 71);
        _ie_skip_block(S);
    }
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); return 0; }
    STI(S, GTI(S) + 1);
    return 0;
}
# [a, b) with balanced outer parentheses peeled: `(p)` is `p`. Returns a; `_ie_pe` gets b.
var _ie_pe = 0;
fn _ie_unparen(S, a, b): i64 {
    while (b - a > 2) {
        if (TOKTYP(S, a) != 10) { _ie_pe = b; return a; }
        if (TOKTYP(S, b - 1) != 11) { _ie_pe = b; return a; }
        var d = 0;
        var i = a;
        var shut = 0 - 1;
        while (i < b) {
            var t = TOKTYP(S, i);
            if (t == 10) { d = d + 1; }
            if (t == 11) { d = d - 1; if (d == 0) { shut = i; i = b; } }
            i = i + 1;
        }
        if (shut != b - 1) { _ie_pe = b; return a; }
        a = a + 1;
        b = b - 1;
    }
    _ie_pe = b;
    return a;
}
# The struct type of a branch value [a, b) by SHAPE: a bare (parenthesised) name, a whole free call, a
# whole method / operator call (`_sc_whole`), a whole struct field (`_fpk_*`). 0 = not a struct value;
# -1 = a vector or u128 value (over 8 bytes, never a struct).
fn _ie_struct_sid(S, bti): i64 {
    var a = _ie_unparen(S, bti, GTI(S));
    var b = _ie_pe;
    if (b == a + 1) {
        if (TOKTYP(S, a) == 2) {
            if (_ie_wide_name(S, TOKVAL(S, a)) == 1) { return 0 - 1; }
            return _sarg_name_sid(S, a);
        }
    }
    var o = _gcall_open(S, a);
    if (o >= 0) {
        if (_call_dotted(S, a) == 0) { if (_call_close(S, o) + 1 == b) {
                var cfi = _pair_gen_inst(S, a);
                if (cfi >= 0) { if (_is_simd_any(S, GFRS(S, cfi)) == 1) { return 0 - 1; } }
                return _sarg_call_rs(S, a);
            } }
    }
    if (_sc_whole(S, bti) != 0 - 2) { return _sc_sid; }
    if (_fpk_ft > 0) { if (_fpk_end == GTI(S)) { return _fpk_ft; } }
    return 0;
}
# A vector or u128 local / global named `noff` (a value over 8 bytes that is no struct).
fn _ie_wide_name(S, noff): i64 {
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) {
            var lt = GLTYPE(S, li);
            if (_is_simd_any(S, lt) == 1) { return 1; }
            if (lt == 0) { if (GLSPAN(S, li) >= 2) { return 1; } }   # a u128 or a slice: a 2-slot pair
            return 0;
        }
    }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    if (GVVEC(S, vi) != 0) { return 1; }
    if (L64(_vars_base + vi * 8) == 16) { return 1; }
    return 0;
}
# The float kind a WHOLE call branch [a, b) returns: 1 a `: f64` fn (typed), 5 / 6 a float builtin
# (f64 / f32 flag only), 0 any other call (an integer — a name intrinsic too: GESTYPE may have leaked
# from its last argument), -1 not a whole call.
fn _ie_call_fk(S, bti): i64 {
    var a = _ie_unparen(S, bti, GTI(S));
    var b = _ie_pe;
    var t = TOKTYP(S, a);
    if (t == 2) {
        var o = _gcall_open(S, a);
        if (o < 0) { return 0 - 1; }
        if (_call_dotted(S, a) == 1) { return 0 - 1; }
        if (_call_close(S, o) + 1 != b) { return 0 - 1; }
        var cfi = _pair_gen_inst(S, a);
        if (cfi >= 0) { if (GFRS(S, cfi) == 0 - 9) { return 1; } }
        return 0;
    }
    var k = _NEG_INTRIN_KIND(t);
    if (k == 0) { return 0 - 1; }
    if (TOKTYP(S, a + 1) != 10) { return 0 - 1; }
    if (_call_close(S, a + 1) + 1 != b) { return 0 - 1; }
    return k + 4;
}
# Classify the branch just parsed (from token `bti`) and merge it into `st`.
fn _ie_kind(S, st, bti): i64 {
    var isb = _BX_IS(S);
    var fbk = _FBR_KIND(S);
    var et = GESTYPE(S);
    var ps = GPSC(S);
    var xw = GEXW(S);
    var cl = 1;
    var sid = 0;
    var typed = 0;
    if (isb == 0) {
        sid = _ie_struct_sid(S, bti);
        if (sid < 0) { _ie_big_err(S, bti, 0); return 0; }
        if (sid > 0) { if (sid == _STR_SID(S)) { sid = 0; } }   # a Str is a handle (a pointer word) by design
        if (sid > 0) {
            if (STRUCTSZ(S, sid - 1) > 8) { _ie_big_err(S, bti, sid); return 0; }
            cl = 4;
        } else {
            var ck = _ie_call_fk(S, bti);
            if (ck >= 0) {
                fbk = 0;
                if (ck == 1) { cl = 2; typed = 1; }
                if (ck == 5) { cl = 2; fbk = 1; }
                if (ck == 6) { cl = 3; fbk = 2; }
            } else {
                if (et == F64_TYID) { cl = 2; typed = 1; }
                elif (et == F32_TYID) { cl = 3; typed = 1; }
                elif (fbk == 1) { cl = 2; }
                elif (fbk == 2) { cl = 3; }
            }
        }
    }
    _ie_merge(S, st, bti, cl, sid, typed + isb * 2 + fbk * 4);
    if (L64(st + 40) == 0 - 1) { S64(st + 40, ps); } elif (L64(st + 40) != ps) { S64(st + 40, 0); }
    if (xw > L64(st + 48)) { S64(st + 48, xw); }
    return 0;
}
# Merge one branch (class `cl`, struct `sid`; `fl` packs typed | bool << 1 | float-builtin flag << 2).
fn _ie_merge(S, st, bti, cl, sid, fl): i64 {
    var typed = fl & 1;
    var isb = (fl >> 1) & 1;
    var fbk = fl >> 2;
    var ufv = 0;   # an untyped float variable on either side (the note below)
    if (fbk == 3 || L64(st + 32) == 3) { ufv = 1; }
    if (isb == 0) { S64(st + 16, 0); }
    if (typed == 1) { S64(st + 24, 1); }
    if (L64(st + 32) == 0 - 1) { S64(st + 32, fbk); } elif (L64(st + 32) != fbk) { S64(st + 32, 0); }
    var c0 = L64(st);
    if (c0 == 0) {
        S64(st, cl);
        S64(st + 8, sid);
        return 0;
    }
    if (c0 == cl) { if (cl != 4 || L64(st + 8) == sid) { return 0; } }
    if (_ie_mix_err(S, bti, c0, L64(st + 8), cl, sid) == 1) { if (ufv == 1) { _ie_ufv_note(); } }
    return 0;
}
fn _ie_ufv_note(): i64 {
    PRSTR("  note: an untyped variable that holds a float is an integer (ADR-002) - declare it `: f64`\n");
    return 0;
}
# A refusal pointed at token `ti`, reported once per token (a generic base and its instances parse the
# same tokens), skipped under --syntax-only and in an #inline replay (the definition checked itself).
fn _ie_once(S, ti): i64 {
    if (_bx_live(S) == 0) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    return 1;
}
fn _ie_kname(S, cl, sid): i64 {
    if (cl == 1) { PRSTR("an integer"); return 0; }
    if (cl == 2) { PRSTR("an f64"); return 0; }
    if (cl == 3) { PRSTR("an f32"); return 0; }
    PRSTR("struct '");
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
    PRSTR("'");
    return 0;
}
fn _ie_mix_err(S, ti, c0, s0, cl, sid): i64 {
    if (_ie_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": if expression branches differ in type: ");
    _ie_kname(S, cl, sid);
    PRSTR(" here, ");
    _ie_kname(S, c0, s0);
    PRSTR(" before it\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    if (c0 + cl == 3) { PRSTR("  note: every branch is one kind - write a float literal (2.0) or f64_from(n) for an integer\n"); }
    return 1;
}
fn _ie_big_err(S, ti, sid): i64 {
    if (_ie_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    if (sid > 0) {
        PRSTR(": an if expression branch cannot be a struct value over 8 bytes: ");
        _ie_kname(S, 4, sid);
        PRSTR(" - branch on a pointer (`&x`, or a `*T` value)\n");
    } else {
        PRSTR(": an if expression branch cannot be a vector, u128 or slice value - branch on a pointer (&x)\n");
    }
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}
# The join: every flag that describes only the LAST branch is reset, and the result's type set from
# the merge. `_flags_reflect_rax` MUST go (the then-path arrives with the condition's flags, so an
# if-expression used as a condition would skip its `test`); the peephole trackers rewind the code
# pointer, which must never cross a patched jump; `_cfo` would fold a following `+ 3` into the last
# branch. The B2 stamp goes on LAST, and only when every branch was boolean.
fn _ie_finish(S, st): i64 {
    _flags_reflect_rax = 0;
    _last_push_cp = 0 - 1;
    _last_emovca_cp = 0 - 1;
    _last_movca_popr_cp = 0 - 1;
    _cfo = 0;
    SESVAR(S, 0 - 1);
    _esv_name = 0 - 1;
    var ps = L64(st + 40);
    if (ps < 0) { ps = 0; }
    SPSC(S, ps);
    SEXW(S, L64(st + 48));
    SESTYPE(S, 0);
    _fbr_k = 0;
    var cl = L64(st);
    var fbk = L64(st + 32);
    if (cl == 2) {
        if (L64(st + 24) == 1) { SESTYPE(S, F64_TYID); } elif (fbk == 1) { _FBR_MARK(S, 1); }
    }
    if (cl == 3) {
        if (L64(st + 24) == 1) { SESTYPE(S, F32_TYID); } elif (fbk == 2) { _FBR_MARK(S, 2); }
    }
    if (cl == 1) { if (fbk == 3) { _FBR_MARK(S, 3); } }
    if (cl == 4) { _ie_struct_result(S, st); }
    if (cl == 1) { if (L64(st + 16) == 1) { _BX_MARK(S); } }
    return 0;
}
# A small-struct result keeps its type: the estype operator dispatch reads, and a `-3` struct-call
# record spanning the whole if-expression, which the receive (`var z: S = ..`) and argument checks
# read through `_sc_whole`.
fn _ie_struct_result(S, st): i64 {
    var sid = L64(st + 8);
    SESTYPE(S, sid);
    _sc_beg = L64(st + 56);
    _sc_end = GTI(S);
    _sc_tmp = 0 - 3;
    _sc_sid = sid;
    _sc_fn = L64(S + 0x1A6018 + (sid - 1) * 8);
    return 0;
}

# Parse: while (cond) { stmts }
fn PARSE_WHILE(S): i64 {
    STI(S, GTI(S) + 1);  # consume WHILE
    var saved_lv = GLVAR(S);
    # Save and set loop context for break/continue
    var saved_ltop = L64(S + 0x18F838);
    var saved_brk = L64(S + 0x18F840);
    # v6.6.3 — a `while` must DECLARE while-mode, not inherit the enclosing loop's.
    # 0x18F898 is the `continue` mode (0 = jump straight to loop top, 1 = a forward jump to
    # a `for`'s step, see `_cont_vec`). PARSE_WHILE never wrote it, so a `while` nested in a
    # `for` sent its `continue` to the FOR's step (6.6.2: 0 where 6 was right). Zeroing it
    # is safe since 6.6.20: it is no longer also the index of the pending-jump array.
    var saved_cfw = L64(S + 0x18F898);
    S64(S + 0x18F898, 0);
    var loop_top = GCP(S);
    _efl_store_cp = 0 - 1;   # v6.3.30: loop-top is a back-edge target → kill reload-elim tracker
    S64(S + 0x18F838, loop_top);
    S64(S + 0x18F840, 0);
    # v5.6.14: record IR_NOP landing pad so BB construction splits
    # the enclosing block at loop_top. Without this, JMP_BACK targets
    # land mid-BB and LASE eliminates LOAD_LOCALs whose corresponding
    # STORE_LOCAL only ran on first-entry (not loop-back iterations).
    # a1 = loop_top (non-zero → triggers BB split per ir_build_bbs).
    var _ire_lt = IR_ENABLED(S);
    if (_ire_lt >= 1) { ir_emit(S, IR_NOP, 0, loop_top, 0); }
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
    STI(S, GTI(S) + 1);
    var patch = ECOND(S);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    _loop_body(S, 1);   # 6.6.7: counts the loop for break/continue
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    EJMP(S, loop_top);
    PATCHXP(S);
    EPATCH(S, patch);
    # Patch all break jumps (linked list through codebuf rel32 fields)
    var brk_patch = L64(S + 0x18F840);
    while (brk_patch > 0) {
        var _ba = _codebuf_base + brk_patch;
        var _nb = L64(_ba) & 0xFFFFFFFF;
        EPATCH(S, brk_patch);
        brk_patch = _nb;
    }
    S64(S + 0x18F838, saved_ltop);
    S64(S + 0x18F840, saved_brk);
    S64(S + 0x18F898, saved_cfw);
    SLVAR(S, saved_lv);
    return 0;
}

# ── 6.7.5 (B5): `loop { .. }` and `do { .. } while (c);` ────────────────────────────────────────
# `loop` is `while (1)` written plainly — no condition is emitted or tested; `break` (no value) is
# its only exit besides `return`. `do` runs its body once before the first test. A statement only;
# `loop` is CONTEXTUAL (`_TOK_IS_LOOP`), `do` is reserved (token 172). One dispatch call from
# `_PARSE_STMT_IMPL`, whose body sits at cybs's per-fn reference ceiling. `_tcp_loop_end` runs
# after the WHOLE statement — a do's condition included: an `&local` taken there must still divert
# the body's in-loop tail calls (the 6.7.3 class). CHANGELOG [6.7.5]
fn _loop_stmt(S, typ): i64 {
    if (typ == 172) { PARSE_DO(S); _tcp_loop_end(); return 1; }
    if (_TOK_IS_LOOP(S, GTI(S)) == 1) { PARSE_LOOP(S); _tcp_loop_end(); return 1; }
    return 0;
}
# Every loop form DECLARES its own per-loop state at its top, and each one missed is a silent
# miscompile: the `continue` mode (0 = a direct jump to the top; a nested loop must not inherit a
# `for`'s forward mode — 6.6.3), the reload-elim tracker (the top is a back-edge target — v6.3.30)
# and the IR_NOP landing pad (the BB split at the top — v5.6.14). `_flags_reflect_rax` is reset
# too, defensively: every condition and statement emits a defining instruction first. Returns the
# loop top; the caller has saved the enclosing loop's slots.
fn _loop_open(S): i64 {
    S64(S + 0x18F898, 0);
    var top = GCP(S);
    _efl_store_cp = 0 - 1;
    _flags_reflect_rax = 0;
    S64(S + 0x18F838, top);
    S64(S + 0x18F840, 0);
    var ire = IR_ENABLED(S);
    if (ire >= 1) { ir_emit(S, IR_NOP, 0, top, 0); }
    return top;
}
# The loop's end: patch its break chain to here (the PARSE_WHILE walk — not `_brk_chain_end`, which
# also counts the switch / match pairing) and restore the enclosing loop's slots.
fn _loop_close(S, ltop, brk, cfw, lv): i64 {
    var bp = L64(S + 0x18F840);
    while (bp > 0) {
        var ba = _codebuf_base + bp;
        var nb = L64(ba) & 0xFFFFFFFF;
        EPATCH(S, bp);
        bp = nb;
    }
    S64(S + 0x18F838, ltop);
    S64(S + 0x18F840, brk);
    S64(S + 0x18F898, cfw);
    SLVAR(S, lv);
    return 0;
}
# `loop { body }`:  top: body; jmp top.
fn PARSE_LOOP(S): i64 {
    STI(S, GTI(S) + 1);   # `loop`
    var lv = GLVAR(S);
    var ltop = L64(S + 0x18F838);
    var brk = L64(S + 0x18F840);
    var cfw = L64(S + 0x18F898);
    var top = _loop_open(S);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    _loop_body(S, 1);
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    EJMP(S, top);
    _loop_close(S, ltop, brk, cfw, lv);
    return 0;
}
# `do { body } while (cond);`:  top: body; cont: cond; jfalse exit; jmp top; exit:.
# A `continue` goes to the CONDITION (the spec), so it is a FORWARD jump — a C-style `for`'s
# mechanism (`_cont_open` / `_cont_close`); jumping to the top would skip the test. The body is its
# own scope (`_loop_body(S, 1)`): the condition does not see a `var` declared in it (every braced
# body is a scope since 6.6.17). A missing `;` is reported without consuming the token after `)`.
fn PARSE_DO(S): i64 {
    STI(S, GTI(S) + 1);   # `do`
    var lv = GLVAR(S);
    var ltop = L64(S + 0x18F838);
    var brk = L64(S + 0x18F840);
    var cfw = L64(S + 0x18F898);
    var top = _loop_open(S);
    var cb = _cont_open(S);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    _loop_body(S, 1);
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    _cont_close(S, cb);   # every `continue` lands here, on the condition
    _flags_reflect_rax = 0;
    var patch = 0 - 1;
    if (PEEKT(S) == 16) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
        STI(S, GTI(S) + 1);
        patch = ECOND(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } else { ERR_EXPECT(S, 5); }
    } else { ERR_EXPECT(S, 16); }
    EJMP(S, top);
    if (patch >= 0) { PATCHXP(S); EPATCH(S, patch); }
    _loop_close(S, ltop, brk, cfw, lv);
    return 0;
}

# A `for` opens its `continue` range: forward-jump mode, its jumps appended above every
# enclosing `for`'s (see `_cont_vec`, parse.cyr). Returns its base. CHANGELOG [6.6.20]
fn _cont_open(S): i64 {
    if (_cont_vec == 0) { _cont_vec = vec_new(); }
    S64(S + 0x18F898, 1);
    return vec_len(_cont_vec);
}
# The `for`'s body ended: patch its own `continue`s (base up) to here, its step, and drop them.
fn _cont_close(S, base): i64 {
    var n = vec_len(_cont_vec);
    var i = base;
    while (i < n) { EPATCH(S, vec_get(_cont_vec, i)); i = i + 1; }
    vec_truncate(_cont_vec, base);
    S64(S + 0x18F898, 0);
    return 0;
}

# The classic-for step `x = v` / `x OP= v` on a named variable (cursor past the name).
# Compound assignment in the step: 6.6.11 — the statement arm's implementation, not a copy
# of it. The copy that stood here had no float routing (`x += 0.25` on an f64 added bit
# patterns: 2 iterations, not 4) and knew five of the ten ops. See _asg_compound_tok.
# 6.6.12: out of PARSE_FOR, next to the subscript step (cybs per-fn reference cap).
# ⛔ 6.6.20 — A PLAIN `=` STEP RUNS THE STATEMENT ARM'S WHOLE-AGGREGATE DISPATCH, in the
# statement's order (_PARSE_STMT_IMPL): 6.6.12 shared the STORE and left this dispatch out, so a
# struct or vector right-hand side stored ONE word — `for (..; ..; a = b)` on a 24-byte struct
# left a.y / a.z stale, and a call, method, field, vector call or copy did the same, silently,
# while a different-struct source and a `: stack` pair compiled clean. Each helper takes the
# terminator: the step ends at `)` (11), not `;`. 1 = the copy is done. CHANGELOG [6.6.20]
fn _for_step_aggregate(S, noff): i64 {
    if (_try_aggregate_copy_assign(S, noff, 11) == 1) { return 1; }
    if (_try_struct_call_assign(S, noff, 11) == 1) { return 1; }
    if (_try_vector_call_assign(S, noff, 11) == 1) { return 1; }
    _refuse_lossy_pair(S);
    var r = _pcmpe_struct_assign(S, noff, 11);   # PCMPE + `_asg_ufv`, as in the statement
    return r;
}
fn _for_step_assign(S, noff): i64 {
    # 6.7.3: a const or an enum constant is no lvalue in the step either — 6.7.2's const refusal
    # missed this path, and a top-level const's size-0 slot let the store overwrite a neighbour.
    # No skip: the step ends at `)` and PARSE_FOR restores the cursor. CHANGELOG [6.7.3]
    if (_asg_lvalue_refused(S, noff) == 1) { return 0; }
    var step_cop = _asg_compound_tok(S);
    if (step_cop == 0) {
        if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
        STI(S, GTI(S) + 1);
    }
    if (step_cop != 0) {
        var step_lt = _asg_compound_load(S, noff);
        _asg_compound_op(S, step_cop, step_lt);
        _asg_ufv = 0 - 1;   # a compound step keeps the kind-3 flag (see _asg_rejudge)
    } else {
        # 6.6.11: a plain step re-judges (`_asg_ufv`), as the statement does — set by
        # `_pcmpe_struct_assign`'s PCMPE.
        if (_for_step_aggregate(S, noff) == 1) { return 0; }
    }
    var idx = 0 - 1;
    if (GINFN(S) == 1) { idx = FINDLOCAL(S, noff); }
    # 6.6.12: the statement arm's width-dispatched store (_asg_store_slot), not an 8-byte copy.
    if (idx >= 0) { _asg_store_slot(S, idx, 0); _asg_rejudge(S, idx, GLTYPE(S, idx), 0); }
    else {
        idx = FINDVAR(S, noff);
        if (idx >= 0) { _asg_store_slot(S, idx, 1); _asg_rejudge(S, idx, GVTYPE(S, idx), 1); }
    }
    return 0;
}

fn PARSE_FOR(S): i64 {
    STI(S, GTI(S) + 1);
    var slv = GLVAR(S);
    SCOPE_PUSH(S);
    # Check for "for ident in start..end { }" syntax
    if (PEEKT(S) == 2) {
        var fiti = GTI(S);
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 76) {
            var finoff = TOKVAL(S, fiti);
            _RSV_INTRINSIC_DECL(S, finoff, fiti, 0);   # 6.6.20: `for sizeof in ..`
            STI(S, GTI(S) + 1);
            PCMPE(S);
            # Check: range (..) or collection?
            var is_range = 0;
            if (PEEKT(S) == 41) {
                var dot_ti = GTI(S);
                STI(S, GTI(S) + 1);
                if (PEEKT(S) == 41) {
                    STI(S, GTI(S) + 1);
                    is_range = 1;
                } else {
                    STI(S, dot_ti);
                }
            }
            if (is_range == 0) {
                # COLLECTION for-in: for item in expr { body }
                # rax has the collection (vec pointer)
                # Store collection in hidden var
                var ficol = _HTEMP(S);
                _HTSTORE(S, ficol);
                # Get length: call vec_len(collection)
                _HTLOAD(S, ficol);
                EPUSHR(S);
                ECALLPOPS(S, 1);
                var vlfi = FINDFN(S, 0);
                # Find vec_len — search by building name
                NPOS_GUARD(S, 16);
                var vlnp = GNPOS(S);
                store8(S + 0xEC00000 + vlnp, 118); store8(S + 0xEC00000 + vlnp + 1, 101);
                store8(S + 0xEC00000 + vlnp + 2, 99); store8(S + 0xEC00000 + vlnp + 3, 95);
                store8(S + 0xEC00000 + vlnp + 4, 108); store8(S + 0xEC00000 + vlnp + 5, 101);
                store8(S + 0xEC00000 + vlnp + 6, 110); store8(S + 0xEC00000 + vlnp + 7, 0);
                SNPOS(S, vlnp + 8);
                vlfi = FINDFN(S, vlnp);
                if (vlfi < 0) { vlfi = REGFN(S, vlnp); }
                var vloff = L64(_fnt_offsets + vlfi * 8);
                if (vloff >= 0) { ECALLTO(S, vloff); } else { ECALLFIX(S, vlfi); }
                ECALLCLEAN(S, 1);
                # Store length in hidden var
                var filen = _HTEMP(S);
                _HTSTORE(S, filen);
                # Index var (starts at 0)
                # 6.6.5: the collection loop's index slot was registered under the
                # USER-VISIBLE name `_i`, so a user's own `_i` read inside the loop body
                # resolved to the compiler's counter (measured 3 where 30 is right) and a
                # 3-byte identifier-pool allocation leaked per loop. It is anonymous now.
                # 6.6.8: at TOP LEVEL both are globals (no frame there) — see _HTNAMED.
                var fili = 0;
                var fiitem = 0;
                if (GINFN(S) == 1) {
                    fili = GFLC(S);
                    S64(S + 0x5D9D000 + fili * 8, 0 - 1);
                    SLDEP(S, fili, GSDEP(S));
                    SLTYPE(S, fili, 0);
                    EMOVI(S, 0);
                    EFLSTORE(S, fili);
                    SFLC(S, fili + 1);
                } else {
                    fili = _HTEMP(S);
                    EMOVI(S, 0);
                    _HTSTORE(S, fili);
                }
                # Item var
                fiitem = _HTNAMED(S, finoff);
                EMOVI(S, 0);
                _HTSTORE(S, fiitem);
                # Loop: while (idx < len)
                var fislt = L64(S + 0x18F838);
                var fisbk = L64(S + 0x18F840);
                var fiscfw = L64(S + 0x18F898);
                var fitop = GCP(S);
                _efl_store_cp = 0 - 1;   # v6.3.30: for-in loop-top back-edge → kill reload-elim tracker
                S64(S + 0x18F838, fitop);
                S64(S + 0x18F840, 0);
                var ficfwb = _cont_open(S);   # 6.6.20: see `_cont_vec`
                # v5.6.14: IR_NOP landing pad at for-in loop top.
                var _ire_fi1 = IR_ENABLED(S);
                if (_ire_fi1 >= 1) { ir_emit(S, IR_NOP, 0, fitop, 0); }
                _HTLOAD(S, fili);
                EPUSHR(S);
                _HTLOAD(S, filen);
                EMOVCA(S);
                EPOPR(S);
                ECMPR(S);
                var ficond = EJCC(S, 0x8D);
                # item = vec_get(collection, idx)
                _HTLOAD(S, ficol);
                EPUSHR(S);
                _HTLOAD(S, fili);
                EPUSHR(S);
                ECALLPOPS(S, 2);
                var vgfi = FINDFN(S, 0);
                NPOS_GUARD(S, 16);
                var vgnp = GNPOS(S);
                store8(S + 0xEC00000 + vgnp, 118); store8(S + 0xEC00000 + vgnp + 1, 101);
                store8(S + 0xEC00000 + vgnp + 2, 99); store8(S + 0xEC00000 + vgnp + 3, 95);
                store8(S + 0xEC00000 + vgnp + 4, 103); store8(S + 0xEC00000 + vgnp + 5, 101);
                store8(S + 0xEC00000 + vgnp + 6, 116); store8(S + 0xEC00000 + vgnp + 7, 0);
                SNPOS(S, vgnp + 8);
                vgfi = FINDFN(S, vgnp);
                if (vgfi < 0) { vgfi = REGFN(S, vgnp); }
                var vgoff = L64(_fnt_offsets + vgfi * 8);
                if (vgoff >= 0) { ECALLTO(S, vgoff); } else { ECALLFIX(S, vgfi); }
                ECALLCLEAN(S, 2);
                _HTSTORE(S, fiitem);
                # Body
                if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); } STI(S, GTI(S) + 1);
                _loop_body(S, 1);   # 6.6.7: counts the loop for break/continue
                if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); } STI(S, GTI(S) + 1);
                _cont_close(S, ficfwb);   # continue lands here, before the step
                # Step: idx = idx + 1
                _HTLOAD(S, fili);
                EPUSHR(S);
                EMOVI(S, 1);
                EMOVCA(S);
                EPOPR(S);
                EADDR(S);
                _HTSTORE(S, fili);
                EJMP(S, fitop);
                PATCHXP(S);
                EPATCH(S, ficond);
                var fibrk = L64(S + 0x18F840);
                while (fibrk > 0) { var _fba = _codebuf_base + fibrk; var _fnb = L64(_fba) & 0xFFFFFFFF; EPATCH(S, fibrk); fibrk = _fnb; }
                S64(S + 0x18F838, fislt);
                S64(S + 0x18F840, fisbk);
                S64(S + 0x18F898, fiscfw);
                SCOPE_POP(S);
                _HTLOOPEND(S, fiitem);
                SLVAR(S, slv);
                return 0;
            }
            # RANGE for-in (.. already consumed, is_range==1)
            # rax has start value from PEXPR above
            var fili = _HTNAMED(S, finoff);   # 6.6.8: a global at top level — see there
            _HTSTORE(S, fili);
            # End value into hidden global
            PCMPE(S);
            var fiend = _HTEMP(S);
            _HTSTORE(S, fiend);
            # Loop setup
            var fislt = L64(S + 0x18F838);
            var fisbk = L64(S + 0x18F840);
            var fiscfw = L64(S + 0x18F898);
            var fitop = GCP(S);
            _efl_store_cp = 0 - 1;   # v6.3.30: range-for loop-top back-edge → kill reload-elim tracker
            S64(S + 0x18F838, fitop);
            S64(S + 0x18F840, 0);
            var ficfwb2 = _cont_open(S);   # 6.6.20: see `_cont_vec`
            # v5.6.14: IR_NOP landing pad at range-for loop top.
            var _ire_fi2 = IR_ENABLED(S);
            if (_ire_fi2 >= 1) { ir_emit(S, IR_NOP, 0, fitop, 0); }
            # Condition: var < end
            _HTLOAD(S, fili);
            EPUSHR(S);
            _HTLOAD(S, fiend);
            EMOVCA(S);
            EPOPR(S);
            ECMPR(S);
            var ficond = EJCC(S, 0x8D);
            # Body
            if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); } STI(S, GTI(S) + 1);
            _loop_body(S, 1);   # 6.6.7: counts the loop for break/continue
            if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); } STI(S, GTI(S) + 1);
            _cont_close(S, ficfwb2);   # continue lands here, before the step
            # Step: var = var + 1
            _HTLOAD(S, fili);
            EPUSHR(S);
            EMOVI(S, 1);
            EMOVCA(S);
            EPOPR(S);
            EADDR(S);
            _HTSTORE(S, fili);
            EJMP(S, fitop);
            PATCHXP(S);
            EPATCH(S, ficond);
            var fibrk = L64(S + 0x18F840);
            while (fibrk > 0) { var _fba = _codebuf_base + fibrk; var _fnb = L64(_fba) & 0xFFFFFFFF; EPATCH(S, fibrk); fibrk = _fnb; }
            S64(S + 0x18F838, fislt);
            S64(S + 0x18F840, fisbk);
            S64(S + 0x18F898, fiscfw);
            SCOPE_POP(S);
            _HTLOOPEND(S, fili);
            SLVAR(S, slv);
            return 0;
        }
        STI(S, fiti);
    }
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
    STI(S, GTI(S) + 1);
    _PARSE_STMT_NESTED(S);   # 6.6.16: the init is inside the `for` (parse.cyr)
    var slt = L64(S + 0x18F838);
    var sbk = L64(S + 0x18F840);
    var scfw = L64(S + 0x18F898);
    var ltop = GCP(S);
    _efl_store_cp = 0 - 1;   # v6.3.30: loop-top back-edge target → kill reload-elim tracker
    S64(S + 0x18F838, ltop);
    S64(S + 0x18F840, 0);
    # A nested loop must never start over the enclosing loop's pending `continue` jumps:
    # it then OVERWROTE one, the inner `continue` was patched to the OUTER step and the
    # outer one never patched (a no-op on x86, `b .` on aarch64). v6.6.3 fixed it for a
    # `for` directly in a `for`, 6.6.20 through a `while` / closure / generic instance —
    # the base is the length of `_cont_vec` (parse.cyr). CHANGELOG [6.6.3] [6.6.20]
    var cfwb = _cont_open(S);
    # v5.6.14: IR_NOP landing pad at classic-for loop top.
    var _ire_for = IR_ENABLED(S);
    if (_ire_for >= 1) { ir_emit(S, IR_NOP, 0, ltop, 0); }
    var cpat = ECOND(S);
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    var sst = GTI(S);
    var dep = 0;
    var skg = 1;
    while (skg == 1) {
        var tok = PEEKT(S);
        if (tok == 10) { dep = dep + 1; STI(S, GTI(S) + 1); }
        else { if (tok == 11) {
                if (dep == 0) { skg = 0; }
                else { dep = dep - 1; STI(S, GTI(S) + 1); }
            }
            else { STI(S, GTI(S) + 1); } }
    }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    _loop_body(S, 0);   # 6.6.7: counts the loop (the for's scope is already open)
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    _cont_close(S, cfwb);   # continue lands here, the step expression
    # Emit step: replay as assignment or compound assignment
    var sti = GTI(S);
    STI(S, sst);
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);
    # 6.6.12: `a[i] = v` / `a[i] OP= v` is a step too, as it is a statement (_arr_sub_assign).
    if (_arr_sub_assign(S, noff) == 0) { _for_step_assign(S, noff); }
    STI(S, sti);
    EJMP(S, ltop);
    PATCHXP(S);
    EPATCH(S, cpat);
    var bpat = L64(S + 0x18F840);
    while (bpat > 0) { var _bpa = _codebuf_base + bpat; var _bnb = L64(_bpa) & 0xFFFFFFFF; EPATCH(S, bpat); bpat = _bnb; }
    SCOPE_POP(S);
    S64(S + 0x18F838, slt);
    S64(S + 0x18F840, sbk);
    S64(S + 0x18F898, scfw);
    SLVAR(S, slv);
    return 0;
}

