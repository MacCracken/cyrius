# [a, pe) is a `*` then exactly `& NAME` inside any balanced parentheses (as `_amp_ew` reads it): `_istr_name`'s answer
# for NAME, `_istr_am` 1; else 0.
fn _istr_amp(S, a, pe): i64 {
