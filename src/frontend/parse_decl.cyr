# PARSER — declarations: PARSE_ARRAY / PARSE_FIELD_LOAD /
# PARSE_FIELD_STORE / EMIT_STRUCT_FIELD_W / PARSE_STRUCT_INIT /
# PARSE_GVAR_ARR / PARSE_GVAR_REG / EMIT_GVAR_INITS / PARSE_VAR /
# PARSE_ASSIGN + BUILD_METHOD_NAME.
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38 to keep single-file
# LOC under ~1500. Included by parse.cyr at the same textual position
# the original content lived; self-host byte-identical.

# v6.5.19 (--syntax-only) — consume a trailing `.field` chain, DOT = token 41.
#
# The resolvable field paths walk a chained access (`o.inner.size`) inside
# `_resolve_leaf_field`, and the assignment path additionally consumes `= expr` AND the
# statement's `;`. A `--syntax-only` early return therefore cannot simply `return 0`:
# whatever the resolvable path would have consumed and this one does not becomes a
# DANGLING token that the statement layer reports as a syntax error the file does not
# contain. That is the same class of self-inflicted false positive as the panic-mode
# attempt described in `_syntax_only` (src/common/util.cyr) — an INVENTED error is
# indistinguishable from a real one to a message-based classifier, and it puts
# `cyrius lint` straight back to refusing valid downstream source.
# Measured while building this: without the chain walk, `return o.inner.size;` came
# back `expected ';', got '.'`; without the `;` consumption, `e.size = 7;` came back
# `unexpected ';'`. Both were gate axis 6 failures, both were pure fiction.
# 6.7.17 (met in the feg review fixes): a `.` the next `.` follows is a range's `..`, not a field — `for y in a.n..10`
# took it as a field's and said "expected identifier, got '.'", and the loop read as one over a vector (lint refused the
# file; a known struct's path stops there). CHANGELOG [6.7.17]
fn _synonly_skip_chain(S): i64 {
    var sgo = 1;
    while (sgo == 1) {
        if (PEEKT(S) != 41) { sgo = 0; }
        elif (TOKTYP(S, GTI(S) + 1) == 41) { sgo = 0; }
        else {
            STI(S, GTI(S) + 1);                                  # consume '.'
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); sgo = 0; }
            else { STI(S, GTI(S) + 1); }                         # consume field name
        }
    }
    return 0;
}

# ⛔ 6.7.14 — `--syntax-only`, A CHAIN PAST A FIELD WHOSE POINTEE THIS FILE CANNOT SEE: `a.f.g`, `a.f.g(1)`
# with `f: *Foo` and `Foo` declared in another file. The `*T` hop needs Foo's struct id, finds none and
# stops, and the leftover `.g` was reported — "expected '=', got '.'" (a store, `OP=`), "expected ';', got
# '.'" (a read, a method call) — a syntax error the file does not have, so `cyrius lint` refused valid
# source (the v6.5.19 class). The rest of the chain is walked as `_synonly_skip_chain` walks it, and each
# `(args)` in it parsed through PCMPE, so a grammar error inside one is still caught. The store's tail is
# `_synonly_fld_tail`'s. --syntax-only emits nothing: no compiled output changes. CHANGELOG [6.7.14]
# 6.7.16: and a method's explicit list (`.m<..>(`, `_synonly_mlist`) stepped before its arguments; the walk serves a
# receiver of no known struct too (`_field_load_on`'s `sid == 0` and unknown-field arms), where `x.m<i64>(1)` was
# "expected ';', got '>'" and `x.f.m(1)` "expected ';', got '('" — a bounded T bound to a scalar among them (6.7.16's D4).
fn _synonly_chain_call(S): i64 {
    var go = 1;
    while (go == 1) {
        _synonly_skip_chain(S);
        _synonly_mlist(S);
        if (PEEKT(S) == 10) { _synonly_args(S); }
        else { go = 0; }
    }
    return 0;
}
# A `<..>` at the cursor that a `(` follows and that holds names, `,` and angle brackets alone: stepped, the cursor on
# the `(` (by its shape — a file read alone cannot see the types another file declares). CHANGELOG [6.7.16]
fn _synonly_mlist(S): i64 {
    if (PEEKT(S) != 19) { return 0; }
    var e = _tok_targs_close(S, GTI(S) + 1);
    if (e < 0) { return 0; }
    if (TOKTYP(S, e + 1) != 10) { return 0; }
    var j = GTI(S) + 1;
    while (j < e) {
        var t = TOKTYP(S, j);
        if (t != 2 && t != 31 && t != 19 && t != 20 && t != 39 && t != 152) { return 0; }
        j = j + 1;
    }
    STI(S, e + 1);
    return 1;
}
# `(args)` at the cursor: each argument through PCMPE, the `)` consumed. A named argument's `name:` label is stepped
# first (`_pd_label_at`): `a.h.m(k: 2)` is valid once the struct is in scope, and was "expected ')', got ':'". CHANGELOG [6.7.16]
fn _synonly_args(S): i64 {
    STI(S, GTI(S) + 1);   # consume (
    if (PEEKT(S) != 11) {
        var go = 1;
        while (go == 1) {
            if (_pd_label_at(S, GTI(S)) == 1) { STI(S, GTI(S) + 2); }
            PCMPE(S);
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
            else { go = 0; }
        }
    }
    _expect_step(S, 11);
    return 0;
}

# ⛔ 6.6.12 — A TYPED ARRAY RECORDS ITS ELEMENT TYPE. `var a: T[N]` sized N*sizeof(T) since
# v6.2.1 but kept no record of T, so there was nothing a subscript could scale or load by and
# the language had no `a[i]` at all (read or write): `store64(&a + i*8, v)` was the only
# spelling. The descriptor is one byte: the element width (1/2/4/8, 16 for u128) | 0x40 for a
# signed element; 0 for a bare `var a[N]`, whose element width is not stated (bytes in a fn,
# slots at top level) and whose subscript is therefore refused rather than guessed. A local
# keeps it above the span in its depth word (util.cyr SLAEW); a global — and a fn-local array
# that fell back to static storage — in the per-var sign table, as `0x100 | desc`, a range
# disjoint from that table's scalar 0/1 (every scalar reader tests `== 1`). CHANGELOG [6.6.12]
fn _arr_desc(ew, sgn): i64 {
    if (ew <= 0) { return 0; }
    if (sgn == 1) { return ew | 0x40; }
    return ew;
}
# ⛔ 6.7.6 (Break 1, lane D) — 0x80 in the descriptor: the array was declared with an element TYPE
# (`var a: T[N]`, any T — f64, a struct and a vector included, which carry no integer width), so
# `a OP= v` on its name is refused by name (_asg_wide_refused, parse.cyr) — it operated on element 0.
# A bare `var a[N]` stays 0. The subscript reads only the width and the kind bits below, so the
# mark changes no load; a global keeps it under 0x100 like any descriptor. CHANGELOG [6.7.6]
fn _arr_desc_t(ew, sgn, typed): i64 {
    var d = _arr_desc(ew, sgn);
    if (typed != 0) { d = d | 0x80; }
    return d;
}
# ⛔ 6.7.8 (C2-3a) — ONE ELEMENT DESCRIPTOR `ed` FOR ARRAYS AND POINTERS. The byte above, grown by
# two kinds in its one free bit: 0x20 a FLOAT element (f64 at width 8, f32 at 4) and 0x60 a BOOL
# (width 8; float + signed is otherwise impossible). Low five bits 0 = no element a subscript can
# load (bare, struct, pointer, vector, enum, cstring). A typed array of f64 / f32 / bool records its
# kind now (`_arr_desc_k`) and a `*T` its pointee's (`_ek_of_ptr_ann`: the slot mark, `_gv_ped`,
# the field and return step words — see `_ps_word`, parse_types.cyr), so C2's `p[i]`, `a[i]` on a
# float array and `*p` at the element's width read one byte (C2-4a: `a[i]` / `p[i]` load and store
# by it — `_esub_load` / `_esub_assign`, parse_expr.cyr). The descriptor is a byte everywhere it is
# stored (SLAEW, GVSGN's low byte, the step word's bits 40-47). CHANGELOG [6.7.8]
fn _ek_w(d): i64 { return d & 0x1F; }        # the element width (1/2/4/8, 16 u128), 0 = none
fn _ek_lw(d): i64 {                          # the load width, negative when signed (sign-extends)
    if ((d & 0x60) == 0x40) { return 0 - (d & 0x1F); }
    return d & 0x1F;
}
fn _ek_fk(d): i64 {                          # `_fk_bx`'s kind: 1 f64, 2 f32, 16 bool, 0 an integer
    var k = d & 0x60;
    if (k == 0x60) { return 16; }
    if (k != 0x20) { return 0; }
    if ((d & 0x1F) == 4) { return 2; }
    return 1;
}
fn _ek_lt(d): i64 {                          # the value's type: F64_TYID / F32_TYID, 0 otherwise
    var k = _ek_fk(d);
    if (k == 1) { return F64_TYID; }
    if (k == 2) { return F32_TYID; }
    return 0;
}
# The kind of a type code (_tn_*, parse_types.cyr): iN / uN its width (| 0x40 for i8..i32), f64
# 0x28, f32 0x24, bool 0x68, a type parameter no binding resolved 8 (its i64 base); else 0.
fn _ek_of_code(c): i64 {
    var k = _tn_class(c);
    var v = _tn_val(c);
    if (k == 1) { if (v < 8) { return v | 0x40; } return v; }
    if (k == 2) { return v; }
    if (k == 3) { return v | 0x20; }
    if (k == 4) {
        if (v == 1) { return 0x68; }
        if (v == 7) { return 8; }
    }
    return 0;
}
# The kind of the type named at token `ti` — a bound type parameter through its binding, as
# `_tn_ptr_step` sizes it. Resolves only: an unknown name is 0 here and refused where it is sized.
fn _ek_at(S, ti): i64 {
    var t = TOKTYP(S, ti);
    if (t == 105) { return 16; }                 # u128: one element does not fit a register
    if (t != 2) { return 0; }
    var b = _tp_resolve(S, TOKVAL(S, ti));
    if (b != 0) { return _ek_of_code(_tn_from_rc(b)); }
    return _ek_of_code(_tn_resolve_at(S, ti));
}
# The pointee kind of a pointer annotation `*T` whose `*` is token `ti`; 0 for `**T` (a pointer
# element) and for anything that is not a `*` annotation.
fn _ek_of_ptr_ann(S, ti): i64 {
    if (ti <= 0) { return 0; }
    if (TOKTYP(S, ti) != 8) { return 0; }
    if (TOKTYP(S, ti + 1) == 8) { return 0; }
    return _ek_at(S, ti + 1);
}
# A typed array's descriptor: `_arr_desc_t`, plus the float / bool kind of an element with no
# integer width (`ann` the element's type token, 0 for a bare array).
fn _arr_desc_k(S, ew, sgn, typed, ann): i64 {
    var d = _arr_desc_t(ew, sgn, typed);
    if (ew == 0) { if (ann > 0) {
            var k = _ek_at(S, ann);
            if ((k & 0x20) != 0) { d = d | k; }
        } }
    return d;
}
# The redeclaration fold compares 6.7.6's descriptor: an f64 / f32 / bool kind maps back to the
# typed mark alone, so `f64[2]` and `f32[4]` (both 16 B) still fold as they did (_gv_same_shape).
fn _ek_legacy(g): i64 {
    if ((g & 0x20) == 0) { return g; }
    return g & 0x180;
}
# ⛔ 6.7.6 (D2): a BARE array (descriptor 0) is `0x100` alone, so its `b OP= v` can be refused by name
# (_asg_wide_refused, _arr_gbare) — a plain scalar global keeps 0. `_gv_same_shape` compares the two
# as before (_gsgn_shape).
# ⛔ 6.7.8 (C2-3b) — AN ELEMENT-TYPED ARRAY RECORDS ITS EXACT N. The bounds-checked mode checks
# `a[i]` against the N the declaration states, and no table held it: a global kept only its bytes
# (N * sizeof(T), with an 8-byte floor) and a local its slot span, so `var a: u8[5]` read as 8
# elements either way. N rides words that exist (no region, no layout change), and only behind a
# NONZERO descriptor — the test every reader makes first — so a bare array's words are unchanged and
# a stale value is never trusted:
#   a global, and a fn-local array in static storage: bits 16..47 of this word (N < 2^31 by
#     _arr_size_ok). `_arr_gdesc` reads the low byte and `_gsgn_shape` the low 16 bits, so `u8[5]`
#     and `u8[6]` (8 B each) still fold — and the folded global keeps the FIRST declaration's N, as
#     it keeps its element kind (this word is written before `_gv_fold`);
#   a stack local: its named slot's slice-width word, `0 - 2^48 - N` (`_arr_named_marks`) — a band
#     no other value of that word reaches (a pointer mark's magnitude stays under 2^48, a signed
#     narrow mark is -1 / -2 / -4), and the word's other readers never see an array's slot (they
#     ask behind the slice bit 62, the pointer bit 56, or a narrow scalar's SLTYPE). The closure
#     snapshot copies the word, so a captured array carries its N.
# Nothing reads N yet: every emitted byte is unchanged. CHANGELOG [6.7.8]
fn _arr_gsgn(S, ew, sgn, typed, ann, n): i64 {
    var d = _arr_desc_k(S, ew, sgn, typed, ann);
    if (d == 0) { return 0x100; }
    return 0x100 | d | (n << 16);
}
# A global's element descriptor, 0 when it is not an element-typed array.
fn _arr_gdesc(S, vi): i64 {
    var g = GVSGN(S, vi);
    if (g < 0x100) { return 0; }
    return g & 0xFF;
}
# 1 when global `vi` (a top-level array or a fn-local one in static storage) is a bare array.
fn _arr_gbare(S, vi): i64 {
    if (GVSGN(S, vi) == 0x100) { return 1; }
    return 0;
}
fn _gsgn_shape(g): i64 {
    if (g == 0x100) { return 0; }
    return _ek_legacy(g & 0xFFFF);   # 6.7.8: the element kinds (C2-3a) and N (C2-3b) are no new shape
}
# The named slot of an array local (PARSE_ARRAY's stack path): its element descriptor (6.6.12), a
# stale slice width at the index cleared, and (6.7.6, D2) the bare mark when it has no element type.
# 6.7.8 (C2-3b): an element-typed array's exact N `n` in that slice-width word (see `_arr_gsgn`).
fn _arr_named_marks(S, li, d, n): i64 {
    SLAEW(S, li, d);
    if (d == 0) {
        SSLICE_W(S, li, 0);
        SLBARR(S, li);
        return 0;
    }
    SSLICE_W(S, li, 0 - 0x1000000000000 - n);
    return 0;
}
# `stack var b[N]` (parse.cyr): the span, and the bare mark — it states no element type either.
fn _stk_named_marks(S, li, n): i64 {
    SLAGG(S, li, n);
    SSLICE_W(S, li, 0);
    SLBARR(S, li);
    return 0;
}

# ⛔ 6.6.13 (M2) — THE BYTES OF ONE ELEMENT, the SIZE of `var a: T[N]`. The descriptor above
# (`ew`/`sgn`) is the integer subscript's, and it was also the array's only size input, so
# every element it does not describe was sized like a bare `var a[N]`: N BYTES in a fn
# (`var a: f64[4]` and `var a: Pt[2]` held 8 bytes), N slots at top level (`Pt[2]` held 16 of
# 32), and the declaration zone's prefix ladder read `i8v16` as an i8. A write inside the
# declared bounds ran over the next local or global, silently. The size is its own value now:
#   ew > 0: i8..u64 1/2/4/8, u128 16, a slice 16 (unchanged)
#   f64 8; f32 4 (packed, as f32v4 lanes and interop buffers lay it out)
#   a vector 16/32; a struct, union or generic instance STRUCTSZ (= sizeof(T)); `*T` 8
#   bool, cstring, an enum, and the enclosing generic fn's own `T` (its i64 base) 8
#   0: a bare `var a[N]` (no annotation, ann_ti 0), which keeps its legacy sizing.
# Any other name is refused by name: `var g: P3[2];` above `struct P3` was 8 per element.
# The subscript stays integer-only, so a non-integer element keeps descriptor 0 and `a[i]` is
# refused — its stride cannot disagree with this size. CHANGELOG [6.6.13]
fn _arr_ebytes(S, ew, flt, tsc, ann_ti): i64 {
    if (ann_ti == 0) { return 0; }
    if (ew > 0) { return ew; }
    if (flt == F64_TYID) { return 8; }
    if (flt == F32_TYID) { return 4; }
    if (tsc <= 0 - 2048) {
        _vec_desc(S, tsc);
        return GVEC_NSLOTS(S) * 8;
    }
    if (tsc < 0) {
        if (_tup_is(S, 0 - tsc) == 1) { _tup_err(S, ann_ti, "a tuple type cannot be an array element", 0 - 1, 0); }   # 6.7.7 (R3)
        _dyn_uninit(S, 0 - tsc, ann_ti, 0 - 1);   # 6.7.8 (U2): a local array of records holding a dyn
        return STRUCTSZ(S, 0 - tsc - 1);
    }
    if (tsc > 0) { return 8; }
    return _arr_name_ebytes(S, ann_ti);
}
# The annotation at `ti` set no width, float, sid or vector: its size through the one type-name
# resolver (6.6.16, parse_types.cyr _tn_resolve_at) — 8 for bool, cstring, an enum (declared on
# either side — its values are i64) or a type parameter of the enclosing generic fn — else
# refused by name, reported at the name and recovered (8), so each bad array is reported.
# `--syntax-only` resolves nothing, so there it is 8 too (see `_syntax_only`, util.cyr).
# (6.6.13's `_arr_prefix_wrong` / `_arr_whole_ebytes` undid the PREFIX ladders here; since 6.6.16
# both ladders resolve the whole name, so the array path no longer has a prefix to undo.)
fn _arr_name_ebytes(S, ti): i64 {
    if (_syntax_only == 1) { return 8; }
    var noff = TOKVAL(S, ti);
    if (TOKTYP(S, ti) == 2) {
        var c = _tn_resolve_at(S, ti);
        if (c != 0) { return _tn_bytes(S, c); }
    }
    if (_panic == 1) { return 8; }
    if (_tn_once(S, ti) == 0) { return 8; }
    var sv = GTI(S);
    STI(S, ti);
    if (TOKTYP(S, ti) != 2) {
        ERR_MSG(S, "unknown array element type", 26);
    } elif (_declared_later(S, noff, 40, 101) == 1) {
        ERR_IDENT(S, "array element type ", noff, " is declared after the array; declare it above the array", 0 - 1);
    } else {
        ERR_IDENT(S, "unknown array element type ", noff, 0, 0 - 1);
        _tn_prefix_note(S, noff);
        PRSTR("  note: an element is i8..i64, u8..u64, u128, f32, f64, bool, cstring, an enum, *T, a vector type, a slice, or a struct or union declared above the array\n");
    }
    STI(S, sv);
    _panic = 0;
    return 8;
}
# Is `noff` a type parameter of the generic fn whose body holds token `ti`? The default build binds
# every T (to i64 in the base, to its argument in an instance) and PARSE_VAR's ladder resolves it,
# so this is CYRIUS_MONOMORPH=0's case, where nothing is captured or bound: read from the tokens,
# as _is_own_tparam (parse_types.cyr) does for a struct. The enclosing fn is the nearest `fn`
# before `ti` whose body spans it.
fn _arr_fn_tparam(S, ti, noff): i64 {
    if (GINFN(S) != 1) { return 0; }
    var k = ti - 1;
    while (k >= 0) {
        if (_tok_fn_kw(S, k) == 1) {   # 6.7.17 (D8): not a local's `*fn( .. )`
            if (_tok_body_spans(S, k, ti) == 1) { return _fn_tp_has(S, k, noff); }   # 6.7.17: `_tpl_has`
        }
        k = k - 1;
    }
    return 0;
}
# Does the `{ .. }` body of the fn whose `fn` keyword is token `k` contain token `ti`?
fn _tok_body_spans(S, k, ti): i64 {
    var j = k + 1;
    while (j < ti && TOKTYP(S, j) != 13) { j = j + 1; }
    if (j >= ti) { return 0; }
    var n = GTCNT(S);
    var d = 0;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 13) { d = d + 1; }
        if (t == 14) {
            d = d - 1;
            if (d == 0) {
                if (j > ti) { return 1; }
                return 0;
            }
        }
        j = j + 1;
    }
    return 1;
}
# A declaration-zone global's element size (PARSE_GVAR_REG). That ladder tests name PREFIXES, so a
# vector element (`i8v16`, `u32v4`, `i64v2`, `f64v2`, `f32v8`, ..) arrived as the scalar it starts
# with; the WHOLE name decides here, through the vocabulary a return type uses
# (`_classify_return_type`, the same vector sentinels as PARSE_VAR's ladder). PARSE_GVAR_ARR then
# drops the integer descriptor the prefix gave it (its width is not the element's size).
fn _gvar_ebytes(S, ew, flt, sid, psc, ann_ti): i64 {
    var tsc = psc;
    if (sid > 0) { tsc = 0 - sid; }
    if (ann_ti > 0) {
        if (TOKTYP(S, ann_ti) == 2) {
            var vs = _classify_return_type(S, TOKVAL(S, ann_ti));
            if (vs <= 0 - 2048) { return _arr_ebytes(S, 0, 0, vs, ann_ti); }
        }
    }
    return _arr_ebytes(S, ew, flt, tsc, ann_ti);
}
# ⛔ 6.6.13 (M2) — N * the element size must not wrap: a wrapped product is the same silent
# under-size. Over 2 GiB is refused (no backend addresses a static that large). `em` is the
# bytes per element the caller multiplies by. Returns the size to use (0 after the error).
fn _arr_size_ok(S, asz, em): i64 {
    if (em < 1) { em = 1; }
    if (asz < 0 || asz > 0x7FFFFFFF / em) {
        ERR_MSG(S, "array too large: N * sizeof(T) must stay under 2 GiB", 52);
        return 0;
    }
    return asz;
}

# `sgn` = 1 for a signed element type (i8/i16/i32). 6.6.12: `ew` and `sgn` are also RECORDED
# as the array's element descriptor, which is what `a[i]` scales and loads by (_arr_desc).
# 6.6.13: `eb` is the bytes per element (_arr_ebytes), 0 for a bare `var a[N]`.
# 6.6.16 (C1): `ann_ti` is the annotation's type token (0 bare) — a module-scope initializer's kind.
fn PARSE_ARRAY(S, noff, ew, sgn, eb, ann_ti): i64 {
    var _pa_decl_ti = GTI(S);   # v6.6.4: the `[` token — `]` and `;` are consumed below, so by the stamp the cursor may already sit in the NEXT file
    STI(S, GTI(S) + 1);  # consume [
    # v5.10.48: accept either NUM literal OR an IDENT that resolves
    # to a compile-time-known enum constant (raw value in _vecv_base,
    # GVECP presence flag set by the v5.5.2 fold registration).
    # Closes `docs/development/issues/2026-05-03-parser-cosmetic-
    # limits-...` `var_bracket_size_must_be_literal`. Plain `var
    # NAME = LITERAL;` named constants stay unsupported here —
    # cyrius has no named-constant infrastructure outside enums;
    # the idiomatic pattern is `enum Sz { BUF = 16; } var buf[BUF];`.
    var asz = 0;
    if (PEEKT(S) == 1 && TOKTYP(S, GTI(S) + 1) == 29) {
        asz = PEEKV(S);
        STI(S, GTI(S) + 1);
    } else {
        # 6.7.2 (B1, C1): a CONST CONTEXT — any integer const expression (a const, an enum
        # constant, sizeof, a const fn call, arithmetic). It took one literal or enum constant.
        asz = _ce_eval_int(S, "an array size must be an integer");
        if (_ce_err == 0) { if (asz < 0) { ERR_MSG(S, "array size must not be negative", 31); } }
    }
    var _pa_em = eb;   # 6.6.13 (M2): the bytes per element the size below multiplies by
    if (_pa_em < 1) { if (GINFN(S) != 1) { _pa_em = 8; } }
    asz = _arr_size_ok(S, asz, _pa_em);
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);  # consume ]
    # ⛔ 6.6.16 (C1): `= { .. }` after the first top-level statement means what it means before it
    # (it was `expected ';'`); refused by name inside a top-level block. A local's stays unsupported.
    var _pa_init = 0;
    if (PEEKT(S) == 4) { if (GINFN(S) != 1) { _pa_init = _gai_stmt(S, ann_ti, asz); } }
    _expect_step(S, 5);  # consume ;
    # Arrays inside functions are globals. To avoid name collisions between
    # functions (e.g. two functions both with `var buf[N]`), always register
    # a NEW global even if one with the same name exists. FINDVAR returns
    # the last match, so the current function's array shadows previous ones.
    # v6.2.1: element-typed fixed array `var a: T[N]` reserves
    # N elements of T. `ew` is the element width in bytes (from the
    # `: T` annotation: i8/u8=1 … i64/u64=8, u128=16). ew==0 is the
    # bare `var a[N]` form — keep the legacy "N bytes rounded to 8"
    # local convention. `i64[N]` (ew==8) is the unambiguous SLOT
    # spelling that fixes the address-taken-local slot-idiom footgun
    # (issue 2026-06-11; daimon). All backends inherit the byte size
    # from this 0x12A000 table. See CHANGELOG [6.2.1].
    # 6.6.13 (M2): sized by `eb`, the bytes per element (_arr_ebytes), not by the integer
    # descriptor `ew` — which is 0 for f64/f32/struct/`*T`/vector/bool/enum elements and sized
    # them like a bare array. For an integer element eb == ew, so those sizes are unchanged.
    # The integer descriptor stands only for an element of exactly that width (as PARSE_GVAR_ARR).
    if (eb != ew) { ew = 0; sgn = 0; }
    var aligned = (asz + 7) & (0 - 8);
    if (eb > 0) { aligned = (asz * eb + 7) & (0 - 8); }
    # v6.4.10 (P1 fix, kernel blocker) — a BARE top-level `var X[N]` (ew==0, NOT a
    # function-local) must size N×8 to match PARSE_GVAR_ARR (the pass-1 declaration path,
    # parse_decl.cyr ~700 `ar_ew` defaults to 8). Otherwise the IDENTICAL decl is N×8 when
    # it precedes the first bare top-level statement (pass 1) but only N bytes when it
    # follows it (pass 2, this PARSE_ARRAY) — a silent 8× under-size → BSS overflow /
    # memory corruption (agnos fpctxsw_payload ring-3 #PF). True in-function locals (GINFN
    # ==1) keep the legacy N-byte rounding; the sa_on stack-array path below is inert at
    # top level. See issues/archived/2026-07-05-toplevel-bare-array-8x-undersize.md.
    elif (GINFN(S) != 1) { aligned = (asz * 8 + 7) & (0 - 8); }
    # v6.3.13 (thread-safe array locals): a `var arr[N]` INSIDE a function goes to a
    # per-thread STACK slot block (the struct-local mechanism) instead of the shared
    # global/BSS data region, so concurrent code can't alias one global buffer. Reserve
    # ceil(aligned/8) fn-local slots: anonymous fillers (name -1) at the shallow end +
    # one NAMED slot at the deepest offset, so &arr (FINDLOCAL → ELOAD_LOCAL_ADDR =
    # `lea [rbp-disp]`) points at arr[0] and arr[i] indexes upward. Gated; default off →
    # the legacy global path below stays byte-identical. (Large arrays → heap: follow-on.)
    # v6.3.15 auto-fallback: an array that would push this fn past the per-fn frame-slot
    # budget (SFLC hard-caps at 16384; leave headroom for scalars) stays in the legacy
    # shared global data region rather than overflowing the slot table. Only pathological
    # cases hit this (>~120 KB of array in ONE fn — e.g. sigil hash_file_into's 256 KB I/O
    # scratch buffer); such arrays were global before v6.3.15 too, so it is NOT a
    # regression — every concurrency-relevant crypto fn (≤ ~5000 slots) still goes
    # per-thread. Emit a note so the dev knows this specific buffer isn't per-thread.
    var sa_on = 0;
    if (_ensure_stack_arrays(S) == 1) { if (GINFN(S) == 1) { sa_on = 1; } }
    if (sa_on == 1) {
        var sa_need = aligned / 8;
        if (sa_need < 1) { sa_need = 1; }
        if (GFLC(S) + sa_need + 1 >= 15360) {
            sa_on = 0;
            # 6.6.5: a WARNING, not a note. The consequence is a semantic one the caller has
            # to know about — ONE buffer for every call and every thread — and a `note:` line
            # reads as informational. The name is scoped like a local either way (_fs_push).
            # ⚠ `WARN_AT(_pa_decl_ti)`, not `WARN`: by here the `]` and the `;` are consumed,
            # so the cursor sits on the NEXT statement and a bare `WARN` named its line.
            WARN_AT(S, _pa_decl_ti, "array local over the per-fn frame budget gets STATIC storage: one buffer shared by all calls and all threads; use alloc() for per-call storage", 142);
        }
    }
    if (sa_on == 1) {
        var sa_nslots = aligned / 8;
        if (sa_nslots < 1) { sa_nslots = 1; }
        var sa_existing = FINDLOCAL(S, noff);
        if (sa_existing >= 0) { if (GLDEP(S, sa_existing) == GSDEP(S)) { ERRDUPVAR(S); } }
        # v6.3.15: 16-align the array base for SSE m128 operands — `pxor`/`aesenc`
        # `xmm, [arr]` (AES-NI / sigil crypto / TLS) FAULT (#GP) on an 8-aligned address.
        # Global arrays got 16-alignment via the v5.5.21 totvar pad; stack slots are only
        # 8-aligned. rbp is 16-aligned by the frame ABI, so &arr = [rbp - disp] is
        # 16-aligned iff disp ≡ 0 mod 16. The named (deepest) slot lands at
        # disp = (named+1)*8 + regalloc*8 + retstash — mirroring the &arr / arr[i]
        # FINDLOCAL disp math (parse_expr / parse_decl). Every term is a multiple of 8,
        # so disp % 16 ∈ {0, 8}; if 8, one extra anonymous filler shifts the whole array
        # 8 B deeper → 16-aligned. Only for arrays ≥ 16 B (the m128-operand candidates).
        if (aligned >= 16) {
            var sa_named0 = GFLC(S) + sa_nslots - 1;
            var sa_disp = (sa_named0 + 1) * 8;
            if (_cur_fn_regalloc > 0) { sa_disp = sa_disp + _cur_fn_regalloc * 8; }
            if (_cur_fn_ret_stash > 0) { sa_disp = sa_disp + _cur_fn_ret_stash; }
            if (sa_disp % 16 == 8) {
                var sa_pad = GFLC(S);
                S64(S + 0x5D9D000 + sa_pad * 8, 0 - 1);
                SLDEP(S, sa_pad, GSDEP(S));
                SLTYPE(S, sa_pad, 0);
                SFLC(S, sa_pad + 1);
            }
        }
        var sa_j = 0;
        while (sa_j < sa_nslots - 1) {
            var sa_li = GFLC(S);
            S64(S + 0x5D9D000 + sa_li * 8, 0 - 1);
            SLDEP(S, sa_li, GSDEP(S));
            SLTYPE(S, sa_li, 0);
            SFLC(S, sa_li + 1);
            sa_j = sa_j + 1;
        }
        var sa_named = GFLC(S);
        S64(S + 0x5D9D000 + sa_named * 8, noff);
        SLDEP(S, sa_named, GSDEP(S));
        SLAGG(S, sa_named, sa_nslots);   # 6.6.5: the slots ARE the array
        _arr_named_marks(S, sa_named, _arr_desc_k(S, ew, sgn, ann_ti, ann_ti), asz);   # 6.6.12: after SLAGG (see util.cyr SLAEW); 6.7.6: + the typed / bare marks; 6.7.8: + the kind, N
        _lav_set(S, sa_named, ann_ti);   # 6.7.17 (D103): an array of vectors
        SLTYPE(S, sa_named, 0);
        SFLC(S, sa_named + 1);
        return 0;
    }
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, noff);
    S64(_vars_base + vcnt * 8, aligned);
    SVSGN(S, vcnt, _arr_gsgn(S, ew, sgn, ann_ti, ann_ti, asz));   # 6.6.12: the element descriptor (see _arr_gsgn); 6.7.6: + the typed mark; 6.7.8: + the kind, N
    _gav_set(S, vcnt, ann_ti);   # 6.7.17 (D103): an array of vectors
    # 6.6.5 — a fn-local STATIC array is scoped to its block, not stamped as a file global.
    # The v6.6.4 stamp is what turned this shape's cross-file collision into an error naming
    # the CONSUMER's variable; scoping the name removes the collision instead of renaming it.
    # See `_fs_push` (parse.cyr) for the whole story.
    if (GINFN(S) == 1) { _fs_push(S, vcnt, noff); }
    else {
        # v6.6.4: stamp visibility — a global registered on the PARSE_PROG path (any `var` after
        # the FIRST top-level statement) skipped PARSE_GVAR_REG entirely and was never private.
        # Keyed on the `[` token, NOT the cursor: `;` is already consumed, and for the last
        # declaration of a file the cursor is in the next file (measured: unstamped).
        _GVAR_VIS(S, vcnt, _pa_decl_ti);
    }
    SVCNT(S, vcnt + 1);
    if (_pa_init > 0) { _gai_now(S, vcnt, _pa_init, ann_ti); }   # 6.6.16 (C1): the slot is registered
    # v5.11.62: accumulate the array's byte cost into the current fn's
    # attribution slot at 0x1C8000. Top-level `var foo[N]` (no enclosing
    # fn, _cur_fn_ix == -1) skip the accumulation. Read by FIXUP's
    # `large static data` warning to surface "M bytes inside N
    # unreachable fns".
    if (_cur_fn_ix >= 0) {
        SFVB(S, _cur_fn_ix, GFVB(S, _cur_fn_ix) + aligned);
    }
    return 0;
}

# Build mangled method name: StructName_method in tok_names scratch.
# Returns noff of the combined name. Uses the region AFTER current
# npos as scratch — writing past live identifiers so FINDFN's byte
# compare sees a clean name. Does NOT advance npos (this is lookup-
# only; the method fn was registered at struct-def time).
# Pre-4.7.1 this wrote to a fixed offset 30000, which silently
# corrupted real identifiers in any program with >30 KB of names.
# Bote saw the downstream mis-parse as `lib/assert.cyr:3: expected
# '=', got string` because a post-corruption token noff now pointed
# at garbled bytes.
fn BUILD_METHOD_NAME(S, si, mnoff): i64 {
    var snoff = L64(S + 0x1A6018 + si * 8);
    # v5.11.65 (the compiler heap guard-page gap): walk source lengths first so NPOS_GUARD
    # bounds the actual write — replaces the pre-v5.11.65 magic-256
    # pessimistic budget that the byte-copy loops below could exceed
    # on a long struct/method identifier. See CHANGELOG [5.11.65].
    var _snlen = 0; while (load8(S + 0xEC00000 + snoff + _snlen) != 0) { _snlen = _snlen + 1; }
    var _mnlen = 0; while (load8(S + 0xEC00000 + mnoff + _mnlen) != 0) { _mnlen = _mnlen + 1; }
    NPOS_GUARD(S, _snlen + 1 + _mnlen + 1);
    var scratch = GNPOS(S);
    var wp = scratch;
    # Copy struct name
    var ri = 0;
    var rc = load8(S + 0xEC00000 + snoff + ri);
    while (rc != 0) {
        store8(S + 0xEC00000 + wp, rc);
        wp = wp + 1;
        ri = ri + 1;
        rc = load8(S + 0xEC00000 + snoff + ri);
    }
    # Underscore separator
    store8(S + 0xEC00000 + wp, 95);
    wp = wp + 1;
    # Copy method name
    ri = 0;
    rc = load8(S + 0xEC00000 + mnoff + ri);
    while (rc != 0) {
        store8(S + 0xEC00000 + wp, rc);
        wp = wp + 1;
        ri = ri + 1;
        rc = load8(S + 0xEC00000 + mnoff + ri);
    }
    store8(S + 0xEC00000 + wp, 0);
    return scratch;
}

# --- R1 (v6.4.15): field address + leaf-retype resolution, extracted from the
# formerly-duplicated PARSE_FIELD_LOAD / PARSE_FIELD_STORE copies so a fix lands
# once (the copies had repeatedly taken the same fixes: v5.8.17 sentinel, v6.3.16
# <=8B-inline, v6.3.33 leaf-retype). Byte-identical extraction.

# Emit rcx = base address of the struct whose field is being accessed.
# idx < -1 is a local-encoded index (idx = 0 - 2 - lli); >= -1 is a global.
# 6.6.5: pointer-to-struct (mov [slot]) vs inline-struct (lea &slot) is the RECORDED
# layout — `_local_struct_is_ptr` for a local, `_var_ptrmode` for a global — not the
# -1-predecessor guess this fn carried from v5.8.17 (see `_local_struct_is_ptr`).
# 6.6.5 — resolve `name` as a CAPTURED enclosing struct inside a closure body, returning the
# capture-encoded index `-1000000 - capi` (locals use `-2 - li`, globals `>= -1`, so the band
# is free — local indices bottom out at -16386 with the 16384-slot cap). `_cap_fld_sid` is the
# second return; read it immediately. Without this rung a closure reading a field of an
# enclosing struct reported "undefined variable". CHANGELOG [6.6.5]
var _cap_fld_sid = 0;
fn _CL_CAP_FIELD_IDX(S, noff): i64 {
    _cap_fld_sid = 0;
    if (_cl_capturing != 1) { return 0 - 1; }
    if (_cl_env_lidx < 0) { return 0 - 1; }
    var _cfe = _cl_snap_find(S, noff);
    if (_cfe < 0) { return 0 - 1; }
    var _cfc = _cl_cap_find(_cfe);
    if (_cfc < 0) { return 0 - 1; }
    var _cft = _cl_snap_type(_cfe);
    if (_cft >= 0) { return 0 - 1; }
    if (_cft <= 0 - 2048) { return 0 - 1; }
    _cap_fld_sid = 0 - _cft;
    return 0 - 1000000 - _cfc;
}
# ⛔ 6.7.16 — PARSE_FIELD_LOAD / PARSE_FIELD_STORE's capture rung: a struct capture (`_CL_CAP_FIELD_IDX`), and every
# other capture of the closure too — its capture-band index with sid 0, so `x.a`, `x.a = ..` and `x.m()` on an untyped
# capture take the `sid == 0` arms an untyped local takes: "no struct type in scope for 'x'" in the field, store or
# method wording, a refused annotation's stand-down (`_ann_refd_said`), a bounded scalar T's member call. The rung
# returned -1 for them, so the name fell to the globals: "undefined variable 'x'". A captured vector reports "SIMD
# vector has no named fields" first, as a local does. A GLOBAL of the same name is shadowed by the capture, as the
# local shadows it outside the closure: the user's D96 (6.7.16, 2026-10-20) — the rung answered -1 for it, so `x.a`
# read the global's field while `x` alone read the capture. CHANGELOG [6.7.16]
fn _cl_cap_fld_any(S, noff): i64 {
    var r = _CL_CAP_FIELD_IDX(S, noff);
    if (r < 0 - 1) { return r; }
    var e = _cl_cap_esl(S, noff);
    if (e < 0) { return 0 - 1; }
    if (_cl_snap_type(e) <= 0 - 2048) { ERR_MSG(S, "SIMD vector has no named fields", 31); }
    _cap_fld_sid = 0;
    return 0 - 1000000 - _cl_cap_find(e);
}
# ⛔ 6.7.11 — A CLOSURE READS ITS CAPTURED SLICE'S `.ptr` / `.len`. The slice arm of the field read
# is a fn-local's (`_slice_lw`) and `_CL_CAP_FIELD_IDX` takes a struct capture only, so `s.len`
# inside a closure that captured `s` was "undefined variable 's'", while `slice_len(&s)` read the
# copy (6.7.9: a captured slice arrives in field order). The user's decision (a), 2026-10-13: the
# fields read the captured copy, one load from the env words (`.ptr` at +0, `.len` at +8). A store
# into them is refused by name (`_cl_cslice_store_err`): the decision covers reads. CHANGELOG [6.7.11]
# The capture index of `noff` when it names a captured slice local of the enclosing fn, else -1.
fn _cl_cslice_cap(S, noff): i64 {
    if (_cl_capturing != 1) { return 0 - 1; }
    if (_cl_env_lidx < 0) { return 0 - 1; }
    if (_sub_cslice(S, noff) != 1) { return 0 - 1; }
    return _cl_cap_find(_cl_snap_find(S, noff));
}
# The slice field `fnoff` names: 0 `.ptr`, 8 `.len`, -1 any other (refused by name).
fn _slice_fld_off(S, fnoff): i64 {
    var fname = L64(S + 0xEC00000 + fnoff) & 0xFFFFFFFF;
    if (fname == 0x00727470) { return 0; }        # "ptr\0"
    if (fname == 0x006E656C) { return 8; }        # "len\0"
    ERR_MSG(S, "slice has only .ptr and .len fields", 35);
    return 0 - 1;
}
# `s.ptr` / `s.len` on a captured slice (cursor past the field name): rax = the field; 1 when it
# was one, 0 when `noff` is no captured slice.
fn _cl_cslice_field(S, noff, fnoff): i64 {
    var capi = _cl_cslice_cap(S, noff);
    if (capi < 0) { return 0; }
    var off = _slice_fld_off(S, fnoff);
    if (off < 0) { return 1; }
    _CL_CAP_WORDS_RA(S, capi);
    if (off > 0) { EADDRA_IMM(S, off); }
    ELOAD64(S);
    return 1;
}
fn _cl_cslice_store_err(S, noff): i64 {
    ERR_IDENT(S, "a closure cannot assign a field of the captured slice ", noff,
      " - it reads .ptr / .len only (set the slice before the closure is built, or declare it in the closure)", 0 - 1);
    return 0;
}

# rax = the base address of a captured aggregate. A capture wider than one word IS those
# words, so its base is `&env[woff]`; a one-word capture of a struct over 8 B holds the
# struct's ADDRESS, so the word is loaded.
# 6.6.17 (a2): so does a captured `p: *T` PARAMETER whatever T's size — read from the PTRP bit the
# snapshot carries (`_cl_snap_ptrp`). A `*B1` (8 B) capture read the pointer itself as `p.v`.
# 6.7.10 (B7-1): and a captured HANDLE of 8 B or less (the handle line) — an enclosing slot with no
# inline span holds the address, as over 8 B; an inline one (span 1) is the struct's word.
fn _CL_CAP_BASE_RA(S, capi, sid): i64 {
    _CL_CAP_WORDS_RA(S, capi);
    if (L64(&_cl_cap_w + capi * 8) == 1) {
        if (sid > 0) {
            var esl = L64(&_cl_cap_slots + capi * 8);
            if (STRUCTSZ(S, sid - 1) > 8) { ELOAD64(S); }
            elif (_cl_snap_ptrp(esl) == 1) { ELOAD64(S); }
            elif (_cl_snap_span(esl) == 0) { ELOAD64(S); }
        }
    }
    return 0;
}

fn _resolve_field_base_addr(S, idx, sid): i64 {
    if (idx <= 0 - 1000000) {
        _CL_CAP_BASE_RA(S, 0 - 1000000 - idx, sid);
        EMOVCA(S);
        return 0;
    }
    if (idx < 0 - 1) {
        var rli = 0 - 2 - idx;
        if (_local_struct_is_ptr(S, rli, 0 - sid) == 1) {
            EFLLOAD(S, rli);
            EMOVCA(S);
        } else {
            EFLADDR_X1(S, rli);
        }
    } else {
        # A GLOBAL struct var is inline (a literal, or `var G: P;`) unless it was
        # initialised from an expression yielding an address (`var G: P = mk();`),
        # which the global path records in `_var_ptrmode`. Before 6.6.5 the global
        # branch was unconditionally inline, so `G.y` read the wrong 8 bytes (0 for 22).
        if (_gv_holds_addr(S, idx) == 1) {   # 6.6.17: a `*T` global too
            EVLOAD(S, idx);
            EMOVCA(S);
        } else { EVADDR_X1(S, idx); }
    }
    return 0;
}

# ⛔ 6.7.5 (B8) — COMPOUND ASSIGNMENT ON A FIELD, `x.f OP= e` (BACKLOG-13): it was `expected '=',
# got '+'` on every field lvalue. The field's ADDRESS is computed ONCE, BEFORE the right-hand side,
# as `a[i] OP= v` does (`_arr_sub_assign`) — the user's decision (2026-10-08). A plain `x.f = e`
# evaluates `e` first and stays so, so `GP.n += repoint()` writes the object GP named BEFORE the
# call, where `GP.n = GP.n + repoint()` writes the one it names after it.
# rax = the field's address: `_resolve_field_base_addr`'s ladder, the same base decisions (a
# capture's env, a pointer-mode or address-passed local loaded, an inline one addressed, a global
# loaded when it holds the address) — in rax, plus the offset, plus a `Str` hop (`hop >= 0`).
# ⚠ It does NOT set `_fn_local_addr`: the address never leaves the statement (a method's receiver
# does, `_load_inline_hop`). Setting it would divert every in-loop tail call of the fn.
fn _fld_addr_ra(S, idx, sid, off, hop): i64 {
    _IR_REC0(S, IR_RAW_EMIT);   # the frame / capture base is raw bytes on x86 (as `_arr_sub_addr`)
    if (idx <= 0 - 1000000) { _CL_CAP_BASE_RA(S, 0 - 1000000 - idx, sid); }
    elif (idx < 0 - 1) {
        var li = 0 - 2 - idx;
        if (_local_struct_is_ptr(S, li, 0 - sid) == 1) { EFLLOAD(S, li); } else { EFLADDR(S, li); }
    } else {
        if (_gv_holds_addr(S, idx) == 1) { EVLOAD(S, idx); } else { EVADDR(S, idx); }
    }
    if (off > 0) { EADDRA_IMM(S, off); }
    if (hop >= 0) {
        ELOAD64(S);
        if (hop > 0) { EADDRA_IMM(S, hop); }
    }
    return 0;
}
# ⛔ 6.7.10 (B7) — a field's LOAD WIDTH: its bytes, negative (sign-extend) for an i8 / i16 / i32
# field. A u8 / u16 / u32 field shares the `0 - width` ftype with i8..i32 and is told apart by its
# unsigned mark (GFUNS), an f32 (4 bytes) by its float kind (GFFK); both are read zero-extended.
# A Vec<T> field's far-negative sentinel is an 8-byte handle (FIELDSZ 8), never negated — a
# negated 8 is a 32-bit movsxd (v6.4.x Pin 2). The two field readers that negated a width by hand
# (the load and `OP=`) both read it here. CHANGELOG [6.7.10]
fn _fld_lw(S, si, fi): i64 {
    var ft = GETFTYPE(S, si, fi);
    var w = FIELDSZ(S, ft);
    if (ft >= 0) { return w; }
    if (IS_VEC_FIELD(S, ft) == 1) { return w; }
    if (GFUNS(S, si, fi) != 0) { return w; }
    if (GFFK(S, si, fi) != 0) { return w; }
    return 0 - w;
}
# `x.f OP= e` past the pair, the leaf field in `_rlf_si` / `_rlf_fi` (read here: cybs caps a fn at
# six parameters): the address once, the field loaded at its width (i8 / i16 / i32 signed, u8 /
# u16 / u32 / f32 zero-extended — `_fld_lw` —, as a read of it), `_asg_compound_op` — its float
# arm for an f64 / f32 field, its `*T` step for a pointer field — then the store at that width. A
# `bool` field is refused as `b += 1` is (B2), and a struct-typed field as a struct variable is (a
# struct value is not an integer); both still parse on, at word width. A `Str` / `Vec` / `*T` field
# is a handle: integer arithmetic on the word.
fn _fld_compound(S, idx, sid, off, hop, cop): i64 {
    var si = _rlf_si;
    var fi = _rlf_fi;
    var ft = GETFTYPE(S, si, fi);
    var w = _fld_lw(S, si, fi);
    if (ft > 0) { if (IS_STR_FIELD(S, ft) == 0) {
            _err_in_sync(S, "compound assignment to struct field ", GETFNAME(S, si, fi), " is refused - a struct value is not an integer or a float (write `a = a + b`)");
            w = 8;
        } }
    if (GFBOOL(S, si, fi) == 1) { _bx_refuse(S, GTI(S), "compound assignment to bool field ", GETFNAME(S, si, fi), " is refused - its result is not a bool (write `b = b && c`, `b = !b`)", 0 - 1); }
    var k = GFFK(S, si, fi);
    var lt = 0;
    if (k == 1) { lt = F64_TYID; }
    if (k == 2) { lt = F32_TYID; }
    var ps = _ps_step(_fld_ps_get(S, si, fi));   # 6.7.8: the step alone (the word carries T's kind)
    _fld_addr_ra(S, idx, sid, off, hop);
    EPUSHR(S);                  # the field's address
    _arr_sub_load(S, w);        # rax = the field (clears the flags tracker)
    _cop_dst = 1;               # 6.7.17 (D15): a field, for `_cop_sres`
    _cop_fd = ((si + 1) << 16) | fi;
    _asg_cstep = ps;            # last, right before the op that reads it
    _asg_compound_op(S, cop, lt);
    return _asg_store_w(S, w);
}
# The store of `_fld_compound` and `_arr_sub_assign` (`a[i] = v` / `a[i] OP= v`): rax = the value,
# the address on the stack; `w` the load width (negative = signed). Warns on a narrowing store.
fn _asg_store_w(S, w): i64 {
    var aw = w;
    if (aw < 0) { aw = 0 - aw; }
    if (aw > 0) { if (GEXW(S) > aw) { WARN(S, "narrowing assignment (value may truncate)", 41); } }
    EPOPC(S);                   # rcx = the address, rax = the value
    if (aw == 1) { ESTORE8(S); }
    elif (aw == 2) { ESTORE16(S); }
    elif (aw == 4) { ESTORE32(S); }
    else { ESTORE64(S); }
    return 0;
}

# ⛔ 6.6.5 — COPYING AN INLINE AGGREGATE WHEN EITHER SIDE IS A GLOBAL. Two facts make this
# ADDRESS-based rather than the slot-index loop the local/local path uses:
#   * A GLOBAL SLOT INDEX IS NOT A WORD INDEX. `SVCNT` advances by ONE per variable while
#     `_vars_base` holds its BYTE size, so `EVLOAD(gvi + 1)` reads the NEXT VARIABLE. Every
#     other global-aggregate consumer already goes through `EVADDR + byte offset`.
#   * A GLOBAL OCCUPIES EXACTLY ITS BYTE SIZE, and since 6.6.13 the next one starts at ITS
#     natural alignment (`_GV_ALIGN`, util.cyr: 1/2/4 for a 1/2/4-byte global, 8 otherwise), so
#     an i32 after a 12-byte struct global packs at +12. A word-granular copy of `ceil(sz/8)`
#     words would clobber 4 bytes of that neighbour — the same overrun v5.9.36 fixed for the
#     literal's own field stores. The tail is copied at 4/2/1.
# Locals address identically (`EFLADDR_X1(named) + off`), which is also what makes this work
# unchanged inside a coroutine, where `_ECORO_LEA` supplies the heap-frame base.
# CHANGELOG [6.6.5]
# ⭐ 6.6.6 — A THIRD ADDRESSING MODE, ENCODED IN THE SLOT INDEX: `0 - 1000 - li` means THE SLOT
# HOLDS THE ADDRESS (an address-passed by-value struct parameter — see `_local_is_sptr_param`),
# so the base is `[slot]`, not `&slot`. Those are the two instructions the field-access path
# already emitted for one (`_resolve_field_base_addr`).
# ⚠ Encoded in the index rather than passed as a flag because **cybs, the 29 KB bootstrap
# compiler, caps a fn at SIX parameters** and `_agc_copy_bytes` already takes six — a seventh
# is a bare `syntax error` from cybs alone, with `build/cycc` compiling it fine (the exact
# silent-cybs class the Release Gate's seed-derive step exists to catch). The band is free: a
# real slot is >= 0, "no local" is -1, and slots cap well below 1000. Same encode-in-the-index
# convention `_resolve_field_base_addr` uses for captures. CHANGELOG [6.6.6]
fn _AGC_DREF(li): i64 { return 0 - 1000 - li; }
# 6.6.11 — `li == -2` is a FOURTH source: the struct-typed FIELD recorded by `_fla_take`, so a
# variable destination (`q = b.v;`, `var p: Pt = b.v;`) takes this same byte-exact copy. `-2` is
# free: a slot is >= 0, "none" is -1 and the dereferenced band starts at -1000. CHANGELOG [6.6.11]
# 6.6.16 (C2) — `gv <= -1000` is a pointer-mode GLOBAL handle (`_agc_gvi`'s deref band, parse.cyr
# `_agc_handle_global`): its slot holds the address, so the base is `[G]` — `_fsc_src_x1`'s
# `_fsc_gdr` arm. Tested before the `li` arms, which a global operand leaves at -1. CHANGELOG [6.6.16]
fn _agc_addr_x1(S, li, gv, boff): i64 {
    if (gv >= 0) { EVADDR_X1(S, gv); }
    elif (gv <= 0 - 1000) { EVLOAD(S, 0 - 1000 - gv); EMOVCA(S); }
    elif (li == 0 - 2) { _fsc_src_x1(S, boff); return 0; }
    elif (li <= 0 - 1000) { EFLLOAD(S, 0 - 1000 - li); EMOVCA(S); }
    else { EFLADDR_X1(S, li); }
    if (boff > 0) { EADDIMM_X1(S, boff); }
    return 0;
}
fn _agc_copy_bytes(S, dli, dgv, sli, sgv, nb): i64 {
    var off = 0;
    while (off < nb) {
        var w = 8;
        var rem = nb - off;
        if (rem < 8) { w = 4; }
        if (rem < 4) { w = 2; }
        if (rem < 2) { w = 1; }
        _agc_addr_x1(S, sli, sgv, off);
        EFIELD_LOAD_W(S, w);
        EPUSHR(S);
        _agc_addr_x1(S, dli, dgv, off);
        EPOPR(S);
        if (w == 1) { ESTORE8(S); }
        elif (w == 2) { ESTORE16(S); }
        elif (w == 4) { ESTORE32(S); }
        else { ESTOC(S); }
        off = off + w;
    }
    return 0;
}

# Chained-access leaf retype: for `s.inner.field`, walk one nesting level so the
# load/store WIDTH comes from the leaf field (v6.3.33), not the intermediate
# struct. Returns the leaf ftype; writes the updated byte-offset to _rlf_off
# (the second return — read it immediately at the call site; non-reentrant).
# 6.6.10: also publishes the LEAF's struct index and field index (`_rlf_si` / `_rlf_fi`), which
# the load reads for the field's float kind (GFFK). CHANGELOG [6.6.10]
var _rlf_off = 0;
var _rlf_si = 0;
var _rlf_fi = 0;
# 6.6.17 — a `: Str` field is ONE 8-byte slot holding the Str's ADDRESS (FIELDSZ, IS_STR_FIELD),
# not an inline struct. The walk added `.len`'s offset to the slot's as if the Str were inline, so
# `h.name.len` read the NEXT field (`h.n`) and `h.name.data` read the handle itself — silently,
# for loads and stores, on a local, a global, a parameter or a call result alike. A step INTO a
# Str field now ends the inline offset at the slot (`_rlf_off`) and records the offset past the
# pointer load (`_rlf_hop`, -1 = none); `_rlf_emit_hop` emits that load. Str's fields are scalars,
# so a chain holds at most one hop. CHANGELOG [6.6.17]
var _rlf_hop = 0 - 1;
fn _rlf_emit_hop(S, hop): i64 {
    if (hop < 0) { return 0; }
    EFIELD_LOAD_W(S, 8);
    EMOVCA(S);
    if (hop > 0) { EADDIMM_X1(S, hop); }
    return 0;
}
# 1 = the chain continues: the current field is a struct (`ft > 0`) and `.ident` follows, not a
# `..` range and not a `.method(` call on the nested field. CHANGELOG [6.6.12]
fn _rlf_more(S, ft): i64 {
    if (ft <= 0) { return 0; }
    if (PEEKT(S) != 41) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
    if (TOKTYP(S, GTI(S) + 2) == 10) { return 0; }
    if (_mtargs_ng(S, ft, GTI(S) + 1) == 1) { return 0; }   # 6.7.14 (D7 (a)): `w.v.id<f64>(h)` (6.7.16: `w.v.m<i64>(h)`)
    return 1;
}
fn _resolve_leaf_field(S, si, fi, off): i64 {
    _rlf_si = si;
    _rlf_fi = fi;
    _rlf_hop = 0 - 1;
    var ft = GETFTYPE(S, si, fi);
    # 6.6.12: a `while`, not an `if` — every nested level (`n.v.v.x`), not only the first. The
    # token guards leave a `..` range and a `.method(` on a nested field to their own paths.
    while (_rlf_more(S, ft) == 1) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
        var ifnoff = PEEKV(S);
        STI(S, GTI(S) + 1);
        var isi = ft - 1;
        var ifi = FINDFIELD(S, isi, ifnoff);
        # v6.5.19: a resolution failure, not a syntax one — see ERR_IDENT in
        # src/common/util.cyr for why the message class is load-bearing.
        if (ifi < 0) {
            ERR_IDENT(S, "unknown field ", ifnoff, " on struct ", L64(S + 0x1A6018 + isi * 8));
            _rlf_off = off;
            return ft;
        }
        if (IS_STR_FIELD(S, ft) == 1) { _rlf_hop = FIELDOFF(S, isi, ifi); }   # through the pointer
        else { off = off + FIELDOFF(S, isi, ifi); }
        ft = GETFTYPE(S, isi, ifi);
        _rlf_si = isi;
        _rlf_fi = ifi;
    }
    _rlf_off = off;
    return ft;
}
# ⛔ 6.7.16 — A `.name` PAST A FIELD THAT IS NO STRUCT is refused once, at the name, in its own words: "field 'n' is not
# a struct: it has no field 'b'". `w.n.b` (n an i64, an f64, a narrow integer, a bool) read "expected ';', got '.'"
# (in a condition "expected ')'"), and `w.n.b = 1;` / `+= 1` added "undefined variable 'b'" to "expected '=', got '.'".
# The leaf `_resolve_leaf_field` published, a `*T` field's hop and a call (`.m(`, `.m<`) already taken; the rest of
# the chain is stepped and the panic latch keeps the statement to the one error. A field whose type its declaration
# refused (`p: Later`, Later declared below: `_fld_rtype`) stands down — that declaration's error is the one. Silent
# under --syntax-only (a sibling file's struct reads as no struct). 1 = refused (the caller stops). CHANGELOG [6.7.16]
fn _fld_tail_bad(S): i64 {
    if (PEEKT(S) != 41) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
    var n2 = TOKTYP(S, GTI(S) + 2);
    if (n2 == 10 || n2 == 19) { return 0; }
    if (_syntax_only == 1) { return 0; }
    var ft = GETFTYPE(S, _rlf_si, _rlf_fi);
    if (ft > 0) { if (ft < 2048) { return 0; } }
    if (_fld_ptr_sid(S, _rlf_si, _rlf_fi) > 0) { return 0; }
    var nti = GTI(S) + 1;
    var fnm = GETFNAME(S, _rlf_si, _rlf_fi);
    if (_fld_rtype_at(S, _rlf_si, fnm) == 1) {
        _panic = 1;
        _err_n = _err_n + 1;   # counted, as a report the latch swallows is (6.7.16)
    } else {
        STI(S, nti);
        ERR_IDENT(S, "field ", fnm, " is not a struct: it has no field ", TOKVAL(S, nti));
    }
    var i = nti + 1;
    while (TOKTYP(S, i) == 41) {
        if (TOKTYP(S, i + 1) != 2) { break; }
        i = i + 2;
    }
    STI(S, i);
    return 1;
}
# The fields whose declared type was refused (`_refuse_field_type`): (struct name, field name) pairs, so a `.name` past
# one stands down (`_fld_tail_bad`). CHANGELOG [6.7.16]
var _fld_rtype = 0;
fn _fld_rtype_add(S, snoff, fnoff): i64 {
    if (_fld_rtype == 0) { _fld_rtype = vec_new(); }
    vec_push(_fld_rtype, snoff);
    vec_push(_fld_rtype, fnoff);
    return 0;
}
fn _fld_rtype_at(S, si, fnoff): i64 {
    if (_fld_rtype == 0) { return 0; }
    var snoff = L64(S + 0x1A6018 + si * 8);
    var n = vec_len(_fld_rtype);
    var i = 0;
    while (i < n) {
        if (vec_get(_fld_rtype, i) == snoff) { if (vec_get(_fld_rtype, i + 1) == fnoff) { return 1; } }
        i = i + 2;
    }
    return 0;
}

# 6.7.0 (A5, BACKLOG-07) — `var u = s.clone();` where the method returns a struct of 8 B or less:
# the struct it returns, so `u.len()` resolves (it was `no struct type in scope for 'u'`, while a
# free call's 8-byte result and a method's 16 / 24-byte one were typed). The whole initialiser must
# be the call (`... );`), as `_var_rhs_call` requires of a free call. Larger results keep their
# temp-receive path (`_sc_var_receive`). 0 = not such a call.
# 6.7.9: and a `: f64` method's result (-9) types it f64, as `var x = f();` is (v6.5.21): `var a =
# p.area();` was an untyped word, so `a + 1.0` added integers — a generic method's at the instance
# its arguments reach (`_mcall_gen`: `var w = p.id(h);`; 6.7.11 a struct's, `var w = p.pick(q);`, and a
# lookahead never reports). CHANGELOG [6.7.9]
# 6.7.16: this peek runs before the initialiser is parsed, so `_mcall_last` is reset here: the method a chain ends
# with is then this initialiser's (`_var_rhs_mstr`). CHANGELOG [6.7.16]
fn _var_rhs_msid(S, ti): i64 {
    _mcall_last = 0 - 1;
    var o = _mcall_open(S, ti, 0 - 1);   # 6.7.15: `x.m<..>(` too (`_pair_callee_at` resolves its instance)
    if (o < 0) { return 0; }
    var mt = _mco_mt;   # 6.7.16: a chain's last method too (`_mco_*`)
    var rcv = _mco_rs;
    if (_mco_ch == 0) { rcv = _recv_sid(S, TOKVAL(S, ti)); }
    if (TOKTYP(S, _call_close(S, o) + 1) != 5) { return 0; }
    var mf = _pair_callee_at(S, ti);
    if (mf < 0) { return 0; }
    if (o == mt + 1) { mf = _mcall_gen(S, mf, o, rcv, 0); }
    var rs = GFRS(S, mf);
    if (rs == 0 - 9) { return rs; }
    if (rs <= 0) { return 0; }
    if (rs > 2047) { return 0; }
    if (STRUCTSZ(S, rs - 1) > 8) { return 0; }
    return rs;
}
# The untyped declaration's type, judged once its initialiser at `start` is parsed (`sid0` the type the
# peek before the parse inferred; `pscale` / `sl` its annotation, none when both are 0): a whole struct
# result of 8 B or less (`_sc_small_whole`, which wins over a leading call's type, as over 8 B), else
# `sid0`, else a `: f64` method ending a longer chain, or (6.7.16) a `: Str` one ending any (`_var_rhs_mchain`). Out
# of PARSE_VAR (a giant).
fn _var_rhs_post(S, sid0, pscale, sl, start, ann): i64 {
    if (pscale <= 0 - 2048) { _vrcv_decl_err(S, pscale, start); }   # 6.7.11
    _istr_decl(S, pscale, start, ann);   # 6.7.13 (D7 (1)): `var h: Str = t;` binds t's header; 6.7.14: `*Str`
    _spd_decl(S, pscale, start, ann);   # 6.7.17 (D17): `var p: *P = s;` takes s's address
    _mv_decl_src(S, pscale, start);   # 6.7.11: a multi-value call into a struct declaration
    if (pscale != 0) { return sid0; }
    if (sl != 0) { return sid0; }
    # 6.7.13: a leading `: f64` call's f64 only when the whole initialiser still is one (`_var_rhs_csid`).
    if (sid0 == 0 - 9) { if (GESTYPE(S) != F64_TYID) { sid0 = 0; } }
    var os = _sc_small_whole(S, start);
    if (os > 0) { return os; }
    if (_var_rhs_if64(S, start) == 1) { return 0 - 9; }   # 6.7.14 (D25 (a)): `var a = fncall0(&f);` (not fncall0's `: i64`)
    if (sid0 != 0) { return sid0; }
    return _var_rhs_mchain(S, start, GTI(S));
}
# 6.7.14 (D25 (a)) — the initialiser at `start` leads with a call through fncallN / callptr to a known `&f` whose `f`
# is declared `: f64` — inside parentheses that wrap that call alone — and the whole initialiser is still an f64: the
# f64 `var a = f();` / `var a = (f()) * 2.0;` take (`_var_rhs_csid` / `_var_rhs_wsid`'s -9). Judged after the parse,
# as their -9 is: a comparison or D12's integer operators leave an integer. CHANGELOG [6.7.14]
fn _var_rhs_if64(S, start): i64 {
    if (GESTYPE(S) != F64_TYID) { return 0; }
    var pe = _pw_end;
    var k = _pwrap_k(S, start);
    _pw_end = pe;
    var c = start + k;
    if (_icall_rs_at(S, c) != 0 - 9) { return 0; }
    if (k == 0) { return 1; }
    if (TOKTYP(S, _call_close(S, c + 1) + 1) != 11) { return 0; }
    return 1;
}
# ⛔ 6.7.10 — AN UNTYPED `var c = a + b;` WHOSE OPERATOR RETURNS A STRUCT TAKES ITS TYPE AT EVERY SIZE (the
# user's decision 12, 2026-10-12), as over 8 B, where the result's temporary BECOMES `c` (`_sc_var_receive`).
# Of 8 B or less the result is a value in rax with no temporary, so `c` was an untyped word: `c.g` was "no
# struct type in scope for 'c'" and `c + c` added integers — and 6.7.10's packed fields moved `C4 { r: u8;
# g: u8; b: u8; a: u8; }` from 32 to 4 bytes, so `var c = A + B; c.g = 1;` stopped compiling. CHANGELOG [6.7.10]
# ⛔ 6.7.11 — AND ANY WHOLE STRUCT RESULT OF 8 B OR LESS, not only an operator's (the user's decision (a),
# 2026-10-13: decision 12 extended): a method chain `var c = a.d().d();` and an if-expression of struct
# branches `var c = if (k) { mk(7) } else { mk(9) };` bound an untyped word (`c.v` refused, `c + 1` added to
# it), where a single method (6.7.0 A5) and the same chain over 8 B were typed
# (issues/archived/2026-10-13-untyped-struct-binding-beyond-operators-decision.md). The struct of the whole
# initialiser [start, cursor) when it is one recorded result of 8 B or less in rax (`_sc_whole` -3: an
# operator dispatch, a method, an if-expression; inside any wrap), else 0. A global does not read it
# (PARSE_VAR's global arm): an untyped global keeps the word at every size, as over 8 B.
fn _sc_small_whole(S, start): i64 {
    if (_sc_whole(S, start) != 0 - 3) { return 0; }
    return _sc_sid;
}
# 6.7.9 (review): and a `: f64` method ending a LONGER chain — `w.v.area()`, `self.inner.area()`,
# `p.me().area()`, `mk(1).area()`, `w.v.id(h)` at V = f64 — whose receiver no peek above resolves.
# It is judged once parsed, from the type the method arm gave the result (`_mcall_ret`): the whole
# initialiser `ti`..`end` must be one chain `name[<..>](..)?(.name((..))?)*` that ENDS in `.m(..)`,
# with `;` at `end` — `a + p.area()` and a field read (`_decl_float_copy`'s) are not. -9 (an f64
# binding) or 0. CHANGELOG [6.7.9]
# ⛔ 6.7.16 — AND A `: Str` METHOD ENDING IT, ONE CALL OR A CHAIN (`_var_rhs_mstr`): the `Str` struct, a handle binding,
# as a free `: Str` call's result is (v5.10.4, `var k = str_clone(h);`). `var k = h.clone();`, `var k = w.s.clone();`
# and `var k = h.clone().clone();` left k an untyped word, so `k.len()` was refused "no struct type in scope for 'k'"
# and `println(k)` took the cstring overload: a `Str` is 16 B, so the 8 B arm (`_var_rhs_msid`) declined it, and as a
# handle in rax it has no temp to receive (`_sc_var_receive`). CHANGELOG [6.7.16]
# ⛔ 6.7.17 — INSIDE ANY PARENTHESES WRAPPING THE WHOLE INITIALISER, as a free call's (`_var_rhs_wsid`) and an 8 B
# struct method's (`_sc_small_whole`) are: `var k = (h.clone());` left k an untyped word — `k.len` refused, `println(k)`
# the cstring overload — and `var a = (p.area());` an integer word, where the unwrapped lines are a `Str` / an f64 (the
# wrap is transparent: 6.7.11's D42, 6.7.14's D12). A fn's line and, through `_ti_inferred_sid`, a top-level one (6.7.17's
# D22). CHANGELOG [6.7.17]
fn _var_rhs_mchain(S, ti, end): i64 {
    if (TOKTYP(S, end) != 5) { return 0; }
    var a = _ie_unparen(S, ti, end);
    return _var_rhs_mch2(S, a, _ie_pe);
}
# ... the chain [ti, end), unwrapped.
fn _var_rhs_mch2(S, ti, end): i64 {
    var k = ti + 1;
    var o = _gcall_open(S, ti);
    if (o >= 0) { k = _call_close(S, o) + 1; }
    elif (TOKTYP(S, ti) != 2) { return 0; }
    var m = 0;
    while (k < end) {
        if (TOKTYP(S, k) != 41) { return 0; }
        if (TOKTYP(S, k + 1) != 2) { return 0; }
        m = 0;
        k = k + 2;
        k = _mchain_targs(S, k);   # 6.7.14 (D7 (a)): `.m<..>(`
        if (TOKTYP(S, k) == 10) { m = 1; k = _call_close(S, k) + 1; }
    }
    if (k != end) { return 0; }
    if (m == 0) { return 0; }
    if (GESTYPE(S) == F64_TYID) { return 0 - 9; }
    return _var_rhs_mstr(S);
}
# The `Str` struct when the method the chain just parsed ended with (`_mcall_last`, reset by `_var_rhs_msid` before
# the parse) is declared `: Str`, else 0.
fn _var_rhs_mstr(S): i64 {
    if (_mcall_last < 0) { return 0; }
    var ss = _STR_SID(S);
    if (ss <= 0) { return 0; }
    if (GFRS(S, _mcall_last) != ss) { return 0; }
    return ss;
}

# 6.7.14 (D7 (a)): past a method name at token k, its explicit type-argument list when `(` follows (`p.id<f64>(h)`),
# else k — a comparison `p.n < k` is no list (`_tok_targs_close` stops at its `;` / `(`).
fn _mchain_targs(S, k): i64 {
    if (TOKTYP(S, k) != 19) { return k; }
    var e = _tok_targs_close(S, k + 1);
    if (e < 0) { return k; }
    if (TOKTYP(S, e + 1) != 10) { return k; }
    return e + 1;
}

# ⛔ 6.6.10 — A STRUCT VALUE ASSIGNED INTO A STRUCT-TYPED FIELD COPIED ONE WORD. `b.v = p;` with
# `struct Box { v: Pt; n; }` parsed `p` as an ordinary value (a struct's value is its FIRST word)
# and stored it with the field's width capped at 8, so `b.v.y` kept whatever was there — and for
# an address-passed struct PARAMETER the one word was the POINTER (`r.v.x` read a stack-address
# byte). Silent on every backend. The v6.6.6 struct-copy arc covered a local, a parameter and a
# global as the destination, never a field. Now the field store copies the whole struct from:
#   a named struct (inline local, by-value parameter, pointer-mode local, inline or pointer-mode
#   global), a call / method / overloaded operator returning the struct (through a temp), or
#   another field of that struct type (`b.v = a.v`, `b.v = o.i.v`).
# A struct of a DIFFERENT type is refused by name, as the variable form has been since 6.6.6. A
# source that is not a struct (an integer, a pointer expression) keeps the one-word store.
# ⚠ The source is described, not evaluated into a register: its address is re-emitted per chunk
# (8/4/2/1 bytes, so an odd-sized struct is copied byte-exact), exactly as `_agc_copy_bytes`
# does for the variable form. CHANGELOG [6.6.10]
var _fsc_li = 0 - 1;    # source: a local's slot, or `_AGC_DREF(slot)` when the slot holds the address
var _fsc_gv = 0 - 1;    # source: a global's slot
var _fsc_gdr = 0;       # 1 = that global's slot HOLDS the struct's address (pointer-mode)
var _fsc_fidx = 0;      # source: a struct FIELD — PARSE_FIELD_LOAD's base encoding (idx, sid) ...
var _fsc_fsid = 0;
var _fsc_foff = 0 - 1;  # ... and its byte offset; >= 0 selects the field form
# PARSE_FIELD_LOAD's half: when the field access starting at `_fla_want` is the WHOLE right-hand
# side and its leaf is a struct, it records the field here and emits nothing.
var _fla_want = 0 - 1;
var _fla_hit = 0;
var _fla_ft = 0;
var _fla_name = 0;
var _fla_lit = 0 - 1;   # `_fla_want` when a struct literal armed it (6.6.12): `,` / `}` also end the source
var _fla_arg = 0 - 1;   # `_fla_want` when a by-value struct ARGUMENT armed it (6.6.12): `,` / `)`
var _fla_stp = 0 - 1;   # `_fla_want` when a classic-for STEP armed it (6.6.20): `)`
var _fla_opd = 0 - 1;   # `_fla_want` when an operator's address-passed right OPERAND armed it (6.6.20, `_op_rhs`)
var _fla_opdp = 0 - 1;  # ... and when that operand is parenthesised, `(h.p)`: it ends at its `)`

fn _fsc_reset(): i64 {
    _fsc_li = 0 - 1;
    _fsc_gv = 0 - 1;
    _fsc_gdr = 0;
    _fsc_foff = 0 - 1;
    return 0;
}

# x1 = the source struct's address + `boff`.
fn _fsc_src_x1(S, boff): i64 {
    if (_fsc_foff >= 0) {
        _resolve_field_base_addr(S, _fsc_fidx, _fsc_fsid);
        if (_fsc_foff + boff > 0) { EADDIMM_X1(S, _fsc_foff + boff); }
        return 0;
    }
    if (_fsc_gdr == 1) {
        EVLOAD(S, _fsc_gv);
        EMOVCA(S);
        if (boff > 0) { EADDIMM_X1(S, boff); }
        return 0;
    }
    _agc_addr_x1(S, _fsc_li, _fsc_gv, boff);
    return 0;
}
# 6.6.20 — 1 = the recorded FIELD source's base is an inline aggregate in this frame: the same
# question `_resolve_field_base_addr` answers when it takes `&slot` rather than loading the slot.
# A global's base, a closure capture's (the heap env) and a pointer-mode local's are not.
fn _fsc_src_in_frame(S): i64 {
    if (_fsc_fidx >= 0 - 1) { return 0; }
    if (_fsc_fidx <= 0 - 1000000) { return 0; }
    if (_local_struct_is_ptr(S, 0 - 2 - _fsc_fidx, 0 - _fsc_fsid) == 1) { return 0; }
    return 1;
}

# Copy `nb` bytes from the recorded source into the field at `off` of the struct `idx`/`sid`
# (PARSE_FIELD_STORE's encoding).
fn _fsc_copy(S, idx, sid, off, nb): i64 {
    var o = 0;
    while (o < nb) {
        var w = 8;
        var rem = nb - o;
        if (rem < 8) { w = 4; }
        if (rem < 4) { w = 2; }
        if (rem < 2) { w = 1; }
        _fsc_src_x1(S, o);
        EFIELD_LOAD_W(S, w);
        EPUSHR(S);
        _resolve_field_base_addr(S, idx, sid);
        if (off + o > 0) { EADDIMM_X1(S, off + o); }
        EPOPR(S);
        if (w == 1) { ESTORE8(S); }
        elif (w == 2) { ESTORE16(S); }
        elif (w == 4) { ESTORE32(S); }
        else { ESTOC(S); }
        o = o + w;
    }
    return 0;
}

fn _fsc_type_err(S, snoff, fnoff): i64 { return _fsc_type_errf(S, snoff, 0 - 1, fnoff); }
# ... `snoff` the result of a call to fn `sfi` (a struct-call record's `_sc_fi`; -1: a name), named as the source spells
# it: a method `Pt.dup` (`_err_ident_fn`). CHANGELOG [6.7.15]
fn _fsc_type_errf(S, snoff, sfi, fnoff): i64 {
    _err_ident_fn(S, "cannot copy ", snoff, sfi, " into a struct field of a different struct type: ", fnoff);
    return 0;
}

# A named source's struct type as `0 - sid` (the source recorded), or 0 when the name is not a
# struct operand. A vector answers its own (band) type, so the caller reports the mismatch.
fn _fsc_local_src(S, li): i64 {
    var lt = GLTYPE(S, li);
    if (lt >= 0) { return 0; }
    if (lt <= 0 - 2048) { return lt; }
    if (GLAGG(S, li) != 0) { _fsc_li = li; return lt; }   # inline: the slot IS the struct
    _fsc_li = _AGC_DREF(li);                             # a parameter or pointer-mode local
    return lt;
}
fn _fsc_global_src(S, gv): i64 {
    var gt = GVTYPE(S, gv);
    if (gt <= 0) { return 0; }
    var pm = GVPM(S, gv);
    if (pm == 0) { return 0; }   # GVTYPE's positive range is shared with scalar widths
    _fsc_gv = gv;
    if (pm == 1) { _fsc_gdr = 1; }
    return 0 - gt;
}
# ⛔ 6.6.13 — A CAPTURED STRUCT COPIED INSIDE A CLOSURE STORED ITS ADDRESS. The three name-based
# copy-source resolvers (this one, `_agc_src_operand` in parse.cyr, `_try_struct_copy_init`) went
# local, then global, with no rung for a closure CAPTURE — an enclosing local is neither inside the
# closure body — so each fell back to the capture's scalar VALUE. For an inline (multi-word)
# capture that value is `&env[woff]`, and for a one-word capture of a struct over 8 B (a
# pointer-mode local, an address-passed by-value parameter) it is the pointer: `b.v = p;` put the
# env address in `b.v.x` (80 where 34 is right), `q = p;` likewise, and `var q: Pt = p;` bound q
# INTO the env (its writes persisted across calls) or into the caller's by-value argument.
# A capture is recorded here in the FIELD form, capture-encoded index, offset 0, so every byte-exact
# copy loop addresses it through `_resolve_field_base_addr` -> `_CL_CAP_BASE_RA` — the base the
# closure's own `p.x` reads use, so a copy cannot disagree with a field read. A vector (sid 0) is
# always inline and is never loaded through. Returns the capture's type (`0 - sid`, or the vector
# descriptor) or 0 when `noff` is not a captured aggregate. Sits between the local and the global
# rung, in PARSE_FACTOR's order. CHANGELOG [6.6.13]
fn _fsc_cap_src(S, noff): i64 {
    if (_cl_capturing != 1) { return 0; }
    if (_cl_env_lidx < 0) { return 0; }
    var esl = _cl_snap_find(S, noff);
    if (esl < 0) { return 0; }
    var capi = _cl_cap_find(esl);
    if (capi < 0) { return 0; }
    var t = _cl_snap_type(esl);
    if (t >= 0) { return 0; }
    _fsc_reset();
    _fsc_fidx = 0 - 1000000 - capi;
    _fsc_fsid = 0;
    if (t > 0 - 2048) { _fsc_fsid = 0 - t; }
    _fsc_foff = 0;
    return t;
}
fn _fsc_name_src(S, noff): i64 {
    _fsc_reset();
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) { return _fsc_local_src(S, li); }
    }
    var ct = _fsc_cap_src(S, noff);   # 6.6.13: a closure capture, before the global
    if (ct != 0) { return ct; }
    var gv = FINDVAR(S, noff);
    if (gv < 0) { return 0; }
    return _fsc_global_src(S, gv);
}

# `IDENT ;` — 1 when it named a struct of type `ft` (consumed), else 0 (cursor untouched).
fn _fsc_name(S, ft, fnoff): i64 {
    var noff = PEEKV(S);
    var t = _fsc_name_src(S, noff);
    if (t == 0) { return 0; }
    if (t != 0 - ft) { _fsc_type_err(S, noff, fnoff); return 0; }
    STI(S, GTI(S) + 1);
    return 1;
}

# `IDENT ( .. ) ;` — a free fn returning a struct: the call into a temp, the temp recorded (1).
# 0 = not that shape (cursor untouched). A <= 8 B result (an odd-sized one: only those reach
# here — see `_fsc_src`) comes back in rax and is left to the byte-exact store, `_fst_odd`, at
# top level and in a fn alike.
fn _fsc_call(S, ft, fnoff, term): i64 {
    # 6.6.10 (bite 7 review): `name<..>(` too, and the fn the call REACHES — `b.v = idp(p);` sized
    # the copy from the base's i64 `T` return and stored one word.
    var o = _gcall_open(S, GTI(S));
    if (o < 0) { return 0; }
    var fi = _gen_resolve_call(S, GTI(S));
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs <= 0) { return 0; }
    if (_call_follow(S, o - 1) != term) { return 0; }
    if (rs != ft) { _fsc_type_err(S, PEEKV(S), fnoff); return 0; }
    var cls = _ret_agg_class(S, fi);
    if (cls == 0) { return 0; }
    if (GINFN(S) != 1) { _refuse_toplevel_struct_call(S, PEEKV(S)); return 0; }
    _fsc_reset();
    _fsc_li = _struct_call_into_temp(S);
    return 1;
}

# ⛔ 6.7.11 — `o.s = *p;` (a struct-typed field from a dereference of a `*S`) COPIES THE STRUCT, as `o.s = l`
# does and as the declaration `var l: S = *p;` copies it (6.7.10 decision 6: `*p` is a struct value). It was
# an expression whose first word the field store kept — `o.s.b` stale, silently (issues/2026-10-13-assignment-
# from-struct-dereference-copies-one-word.md). The source up to `term` is ONE dereference whose operand
# `_hl_dstar_t` types `*S`: its pointer is parked in a hidden temp and recorded as the copy's source (1); a
# `*U` of another struct is refused by name (0, as `_fsc_name` refuses a U); anything else is 0 (untouched).
# 6.7.16: and `*pp` of a `**S` (`_hl_dstar_x`'s twin, mode 1) — the `*S` it reads, copied through as `o.s = p` is; it
# stored the pointer word into the field's first word, the rest stale. CHANGELOG [6.7.16]
fn _fsc_dstar(S, ft, fnoff, term): i64 {
    var ps = _hl_dstar_x(S, GTI(S), term, 1);
    if (ps <= 0) { return 0; }
    if (_dx_plain(S, ps) == 0) { return 0; }
    if (ps != ft) { _fsc_type_err(S, _hl_dname(S), fnoff); return 0; }   # 6.7.16: '*qq', as written
    _fsc_hsrc(_hl_dx_src(S));
    return 1;
}
# ⛔ 6.7.11 — `o.s = GP;`, `o.s = gp();`, `o.s = w.p;` (a struct-typed field from a `*S` global, a call or
# method declared `: *S`, a `*S` field, or pointer arithmetic on a `*S`, wrapped or not) COPIES THE STRUCT,
# as the name destination does since 6.7.10 (decision 6, `_hl_psrc_copy`). The field kept the POINTER's word
# at every size, silently (issues/archived/2026-10-13-struct-field-destination-from-pointer-global-call-or-field.md).
# The source up to `term`, typed by `_hl_psrc` (a `*S` local, parameter or capture is `_fsc_name`'s), is
# parsed, its pointer parked in a hidden temp and recorded as the copy's source (1); a `*U` of another struct
# is refused by name (0); 2 = parsed but the parser's pointer step is not the struct's (the value store, as
# `_hl_psrc_copy` falls back); anything else is 0 (untouched).
fn _fsc_psrc(S, ft, fnoff, term): i64 {
    var ti = GTI(S);
    var e = _hl_dx_end(S, ti, term);
    if (e < 0) { return 0; }
    var a = _ie_unparen(S, ti, e);
    var ps = _hl_psrc(S, a, _ie_pe);
    if (ps <= 0) { return 0; }
    if (_dx_plain(S, ps) == 0) { return 0; }
    if (ps != ft) { _fsc_type_err(S, _hl_pname(S), fnoff); return 0; }   # 6.7.16: 'gq(&q)', as written
    PCMPE(S);
    if (_ps_is_sz(_ps_step(GPSC(S)), STRUCTSZ(S, ft - 1)) == 0) { return 2; }   # 6.7.13: a zero-size T steps 8
    var h = _HTEMP(S);
    _HTSTORE(S, h);
    _fsc_hsrc(h);
    return 1;
}
# Record as the copy's source the struct whose ADDRESS hidden temp `h` (`_HTEMP`) holds: a frame slot
# (the deref band), or at top level a hidden global (pointer-mode).
fn _fsc_hsrc(h): i64 {
    _fsc_reset();
    if (h >= 0) {
        _fsc_li = _AGC_DREF(h);
        return 0;
    }
    _fsc_gv = 0 - 2 - h;
    _fsc_gdr = 1;
    return 0;
}
# 1 = struct `sid` is one a dereference copies as a struct value: not a `Str` (a heap handle), a tuple or
# a dyn, which keep their own paths.
fn _dx_plain(S, sid): i64 {
    if (sid == _STR_SID(S)) { return 0; }
    if (_tup_is(S, sid) == 1) { return 0; }
    if (_dyn_is(S, sid) == 1) { return 0; }
    return 1;
}

# Any other right-hand side: parse it with the two destination arms armed. A method / operator
# call spanning it lands in a temp (1); a struct-typed field spanning it is recorded (1);
# otherwise its value is in rax (2) for the ordinary store.
fn _fsc_expr(S, ft, fnoff, term): i64 {
    var st = GTI(S);
    var sv = _fla_want;
    _fla_want = st;
    var fs = _fla_stp;
    if (term == 11) { _fla_stp = st; }   # 6.7.5: a for step's field source ends at `)`
    _fla_hit = 0;
    var w = _sc_arm(S);
    PCMPE(S);
    _sc_want = w;
    _fla_want = sv;
    _fla_stp = fs;
    var t = _sc_whole(S, st);
    if (t >= 0 || t == 0 - 1) { return _fsc_from_call(S, t, ft, fnoff); }
    # 6.6.11: a <= 8 B struct result (rax, no temp) is type-checked too, then stored. See `_sc_post`.
    if (t == 0 - 3) { if (_sc_sid != ft) { _fsc_type_errf(S, _sc_fn, _sc_fi, fnoff); } return 2; }
    if (_fla_hit == 1) {
        _fla_hit = 0;
        if (_fla_ft != ft) { _fsc_type_err(S, _fla_name, fnoff); return 2; }
        return 1;
    }
    if (_fls_whole(S, st) == 1) { if (_fls_sid != ft) { _fsc_type_err(S, _fls_name, fnoff); } }   # 6.7.6
    return 2;
}
fn _fsc_from_call(S, t, ft, fnoff): i64 {
    if (t < 0) { _refuse_toplevel_struct_call(S, _sc_fn); return 2; }
    if (_sc_sid != ft) { _fsc_type_errf(S, _sc_fn, _sc_fi, fnoff); return 2; }
    _fsc_reset();
    _fsc_li = t;
    return 1;
}

# 6.7.7 (R12) — `h.p = 5;` into a TUPLE field: the source was no whole tuple (the copy arms above
# took every one), so its value is in rax, and the store below would write one word of the tuple
# (the struct first-word rule), silently. Refused by name, at the source (`ti`). CHANGELOG [6.7.7]
fn _tup_fst_chk(S, ft, fnoff, ti): i64 {
    if (_dyn_is(S, ft) == 1) { return _dyn_err(S, ti, "cannot store a value that is not a dyn into ", ft, fnoff, " (a field)"); }   # 6.7.8
    if (_tup_is(S, ft) == 0) { return 0; }
    _tup_err(S, ti, "cannot store a value that is not a tuple into tuple field ", fnoff, 0);
    return 0;
}

# The dispatch, cursor on the right-hand side of `x.f = ` (the store ends at `term`, `;` or a for
# step's `)`, 6.7.5): 0 = not a struct copy (nothing
# parsed), 1 = the source is recorded for `_fsc_copy`, 2 = the RHS is parsed and its value is
# in rax. Every source shape is taken at every width.
# ⛔ 6.6.11 — an exact-register field (1/2/4/8 B) used to return 0 here, before the call and
# expression arms, because its one-word store was already the right COPY. It was not the right
# TYPE CHECK: `h.p = y.mq()` and `h.p = mkq8()` stored a Q8 into a P8 field with no diagnostic.
# The arms below store through the same width ladder (2) when the value is in rax. CHANGELOG [6.6.11]
fn _fsc_src(S, ft, fnoff, term): i64 {
    if (ft <= 0) { return 0; }
    if (_dyn_is(S, ft) == 1) {   # 6.7.8 (D5): a dyn formed in a temp
        var dr = _dyn_fsc(S, ft, term);
        if (dr != 0) { return dr; }
    }
    if (IS_STR_FIELD(S, ft) == 1) { return _istr_fsrc(S, fnoff, term); }   # 6.7.13 (D7 (1)): an inline `Str`; 6.7.17 (D18)
    var pr = _fsc_psrc(S, ft, fnoff, term);   # 6.7.11: `o.s = GP` / `gp()` / `w.p` / `GP + n`
    if (pr != 0) { return pr; }
    if (PEEKT(S) != 2) { if (_pc_mchain(S, GTI(S)) == 1) {   # 6.7.16: a chain's method on a `(..)` / `callptr` head
            _tup_fsc_call(S, ft, term);
            _mv_fsc_call(S, ft, term);
        } }
    if (PEEKT(S) == 10) { return _fsc_paren(S, ft, fnoff, term); }   # 6.7.6
    if (PEEKT(S) == 2) {
        if (TOKTYP(S, GTI(S) + 1) == term) { return _fsc_name(S, ft, fnoff); }
    }
    if (PEEKT(S) == 8) { if (_fsc_dstar(S, ft, fnoff, term) == 1) { return 1; } }   # 6.7.11: `o.s = *p`
    if (PEEKT(S) == 2) {
        _tup_fsc_call(S, ft, term);   # 6.7.7 (B4, T5): R17, a multi-value call into a tuple field
        _mv_fsc_call(S, ft, term);    # 6.7.11: ... into a named-struct field
        var r = _fsc_call(S, ft, fnoff, term);
        if (r != 0) { return r; }
    }
    return _fsc_expr(S, ft, fnoff, term);
}
# ⛔ 6.7.7 (B4, T5) — `h.p = f();` with `f` declared `: (i64, i64)` into a TUPLE field: the struct
# path took the call as a value and stored its FIRST word (the R12 refusal named the store, not
# the call). A capture lands in a tuple VARIABLE; a field is stored from one — refused by name, as a
# multi-value call is as a tuple argument (`_tup_arg_call`): bind it first. The value parse goes on
# (its "not a tuple" refusal at the same token stays quiet). Cursor on the source; 1 = refused.
# `_tfc_rep` = 1 once it reported, so a wrap around the call (`h.p = (two(3));`) marks its own `(`
# reported too (`_fsc_paren`): R12 points at the wrap, one token before R17. CHANGELOG [6.7.15]
var _tfc_rep = 0;
fn _tup_fsc_call(S, ft, term): i64 {
    if (_tup_is(S, ft) == 0) { return 0; }
    var o = _dt_call_open(S);
    if (o < 0) { return 0; }
    if (TOKTYP(S, _call_close(S, o) + 1) != term) { return 0; }
    var fi = _dt_call_fn(S);
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != MULTIRET_SID) { return 0; }
    _tamv_fld = 1;
    if (_mcall_open(S, GTI(S), 0 - 1) >= 0) { _tup_arg_mv_err(S, GTI(S), ft, _fn_src_name(S, fi, L64(_fnt_names + fi * 8)), 0); }
    else { _tup_arg_mv_err(S, GTI(S), ft, PEEKV(S), "(..)"); }
    _tamv_fld = 0;
    _tfc_rep = 1;
    return 1;
}

# ⛔ 6.7.6 — A PARENTHESISED SOURCE INTO A STRUCT-TYPED FIELD COPIED ONE WORD: `o.i = (z.k);` and
# `o.i = (j);` gave 72 where 78 is right (a for step's field destination too), because every arm
# above keys on the source's first token. Parentheses that wrap the whole source (`_pwrap_k`) are
# transparent: the arms run on what they wrap, which ends at its `)`, and the wrap is closed after.
# Any other `(`-led source is an expression, as before. Returns as `_fsc_src`. CHANGELOG [6.7.6]
fn _fsc_paren(S, ft, fnoff, term): i64 {
    var st = GTI(S);
    var tl = _tup_fsc_lit(S, ft, fnoff, term);   # 6.7.7 (B4): a tuple literal
    if (tl != 0) { return tl; }
    var k = _pwrap_k(S, st);
    if (TOKTYP(S, _pw_end) != term) { return _fsc_expr(S, ft, fnoff, term); }
    STI(S, st + k);
    _tfc_rep = 0;
    var r = _fsc_src(S, ft, fnoff, 11);
    if (_tfc_rep == 1) {   # 6.7.15: R17 named the wrapped call — its `(` is reported (one mistake, one error)
        _tn_once(S, st);
        _tfc_rep = 0;
    }
    if (r == 0) {
        STI(S, st);   # not a struct source: the caller parses the whole value
        return 0;
    }
    _pw_close(S, k);
    return r;
}

# ⛔ 6.7.7 (B4) — `h.p = (a, b);` into a TUPLE field: built in a frame temp and recorded as the copy's
# source (1) — `_tup_asg`'s rule, a field destination. A literal into a field of another struct type
# is refused by name, and at top level (no frame for the temp, R10); the literal is then consumed
# and 0 is the value (2), its `(` marked reported so the field's own value check stays quiet. 0 =
# not a whole literal.
fn _tup_fsc_lit(S, ft, fnoff, term): i64 {
    var st = GTI(S);
    var lp = _tup_lit_at(S, st);
    if (lp < 0) { return 0; }
    if (TOKTYP(S, _pw_end) != term) { return 0; }
    var ok = 1;
    if (_tup_is(S, ft) == 0) {
        _tup_err(S, lp, "cannot store a tuple literal into field ", fnoff, " - it is not a tuple");
        ok = 0;
    } elif (GINFN(S) != 1) {
        _tup_err(S, lp, "a tuple literal stored at top level has no frame to be built in - store it into ", fnoff, " inside a fn");
        ok = 0;
    } elif (_tup_lit_shape(S, lp, ft) == 0) { ok = 0; }
    if (ok == 0) {
        _tn_once(S, st);
        _tup_lit_skip(S, st, 0);
        EMOVI(S, 0);
        return 2;
    }
    var t = _agg_temp(S, ft);
    STI(S, lp);
    _tup_elems(S, ft, 0, t, 0);
    _pw_close(S, lp - st);
    _fsc_reset();
    _fsc_li = t;
    return 1;
}

# ⛔ 6.6.10 (bite 5 review) — A VALUE IN rax STORED INTO A 3/5/6/7-BYTE FIELD (an odd-sized
# struct: `struct Odd { a: i8; b: i16; }`) wrote EIGHT bytes — the width ladder's `else` is ESTOC
# — and silently overwrote the fields after it. Every <= 8 B struct result arrives this way (a
# method, an overloaded operator, a free call at top level), and so does a plain integer. Now
# exactly `nb` bytes: 4/2/1-byte chunks, each shifted down into place. The value is kept on the
# stack across the chunks (the field address is re-resolved per chunk and may use rax).
# CHANGELOG [6.6.10]
fn _fst_odd_sz(nb): i64 {
    if (nb == 3 || nb == 5 || nb == 6 || nb == 7) { return 1; }
    return 0;
}
fn _fst_chunk(S, idx, sid, off, o, w): i64 {
    if (o > 0) { EMOVI(S, o * 8); EMOVCA(S); }
    EPOPR(S);
    EPUSHR(S);
    if (o > 0) { ESHRCL(S); }
    EPUSHR(S);
    _resolve_field_base_addr(S, idx, sid);
    if (off + o > 0) { EADDIMM_X1(S, off + o); }
    EPOPR(S);
    if (w == 1) { ESTORE8(S); }
    elif (w == 2) { ESTORE16(S); }
    else { ESTORE32(S); }
    return 0;
}
fn _fst_odd(S, idx, sid, off, nb): i64 {
    EPUSHR(S);
    var o = 0;
    while (o < nb) {
        var w = 4;
        if (nb - o < 4) { w = 2; }
        if (nb - o < 2) { w = 1; }
        _fst_chunk(S, idx, sid, off, o, w);
        o = o + w;
    }
    EPOPR(S);
    return 0;
}

# PARSE_FIELD_LOAD's side: the access began at `_fla_want`, its leaf is a (non-Str) struct and
# `;` follows — record it for `_fsc_copy` and emit nothing. Returns 1 when taken.
# 6.6.12: a struct literal's nested-field source (`B2 { a.v, 5 }`) ends at `,` or `}`, and a
# by-value struct argument (`take(r.v, 5)`) at `,` or `)`.
# 6.6.20: an operator's right operand (a TERM) ends at any token that does not continue the term;
# a parenthesised one at its `)`, when the token after it does not continue the term either.
fn _fla_lit_end(S): i64 {
    if (_fla_arg == _fla_want) { if (PEEKT(S) == 31 || PEEKT(S) == 11) { return 1; } }
    if (_fla_stp == _fla_want) { if (PEEKT(S) == 11) { return 1; } }
    if (_fla_opd == _fla_want) { if (_op_term_cont(PEEKT(S)) == 0) { return 1; } }
    if (_fla_opdp == _fla_want) { if (PEEKT(S) == 11) {
            if (_op_term_cont(TOKTYP(S, GTI(S) + 1)) == 0) { return 1; }
        } }
    if (_fla_lit != _fla_want) { return 0; }
    if (PEEKT(S) == 31) { return 1; }
    if (PEEKT(S) == 14) { return 1; }
    return 0;
}
# ⛔ 6.7.6 — A `Str` FIELD WAS NEVER TYPED AS A STRUCT SOURCE: `bq(h.name)` with `fn bq(b: Q)` and
# `var q: Q = h.name;` compiled and read Q's fields out of the Str's 16-byte header and past it
# (silent), as did `q = h.name`, `o.q = h.name` and `q + h.name`. A `: Str` field is one slot
# holding a Str HANDLE, so the copy arms (`_fla_take`, `_fpk_note`) rightly never take it — its
# load stays the handle. It is recorded here instead, for the destinations' type checks: into a
# `Str` it is a handle as ever; into a struct VALUE of another type it is refused by name, as a
# `Str` variable is (`var q: Q = s;` has been since 6.6.6); a handle destination rebinds at any
# type (6.6.16 C2). `h.name.len` is a hop, not this. CHANGELOG [6.7.6]
fn _fls_note(S, beg, ft): i64 {
    if (ft <= 0) { return 0; }
    if (ft >= 2048) { return 0; }
    if (IS_STR_FIELD(S, ft) == 0) { return 0; }
    _fls_beg = beg;
    _fls_end = GTI(S);
    _fls_sid = ft;
    _fls_name = GETFNAME(S, _rlf_si, _rlf_fi);
    return 0;
}
# 1 = the expression [st, cursor) is one whole `Str` field read, inside any parentheses wrapping it.
fn _fls_whole(S, st): i64 {
    if (_fls_beg < st) { return 0; }
    var k = _fls_beg - st;
    if (_fls_end + k != GTI(S)) { return 0; }
    var i = 0;
    while (i < k) {
        if (TOKTYP(S, st + i) != 10) { return 0; }
        if (TOKTYP(S, _fls_end + i) != 11) { return 0; }
        i = i + 1;
    }
    return 1;
}
# A `Str` field into a struct VALUE destination of type `dt` (`0 - sid`): refused by name when `dt`
# is another struct. 1 = refused.
fn _fls_type_err(S, dt, dnoff): i64 {
    if (dt >= 0) { return 0; }
    if (dt <= 0 - 2048) { return 0; }
    return _AGG_ASSIGN_TYPE_ERR(S, dt, 0 - _fls_sid, dnoff, _fls_name);
}

# 6.7.3 — a whole struct-typed field as the argument of a parameter that is not address-passed
# (`_sarg_byval_small`, parse_fn.cyr): its struct, end token and name, recorded WITHOUT changing the
# load — the by-value word is pushed exactly as before. The reader compares the end with the cursor.
fn _fpk_note(S, ft): i64 {
    if (ft <= 0) { return 0; }
    if (ft >= 2048) { return 0; }
    if (IS_STR_FIELD(S, ft) == 1) { return 0; }
    _fpk_ft = ft;
    _fpk_end = GTI(S);
    _fpk_name = GETFNAME(S, _rlf_si, _rlf_fi);
    return 0;
}
# 6.7.6 — the field is the whole inside of the parentheses the destination stepped into
# (`var q: K = (z.k);`, `_scv_peel`): `_fla_want` follows a `(` whose `)` is the cursor.
fn _fla_inparen(S): i64 {
    var w = _fla_want;
    if (w < 1) { return 0; }
    if (PEEKT(S) != 11) { return 0; }
    if (TOKTYP(S, w - 1) != 10) { return 0; }
    if (_call_close(S, w - 1) != GTI(S)) { return 0; }
    return 1;
}
fn _fla_take(S, idx, sid, off, ft): i64 {
    if (ft <= 0) { return 0; }
    if (IS_STR_FIELD(S, ft) == 1) { return 0; }
    if (PEEKT(S) != 5) { if (_fla_lit_end(S) == 0) { if (_fla_inparen(S) == 0) { return 0; } } }
    _fla_want = 0 - 1;
    _fla_hit = 1;
    _fla_ft = ft;
    _fla_name = GETFNAME(S, _rlf_si, _rlf_fi);
    _fsc_reset();
    _fsc_fidx = idx;
    _fsc_fsid = sid;
    _fsc_foff = off;
    return 1;
}

# ⛔ 6.6.11 — A STRUCT VARIABLE ASSIGNED FROM A STRUCT-TYPED FIELD COPIED ONE WORD (`q = b.v;`,
# a local, a global and an address-passed parameter alike), and the DECLARATION `var p: Pt = b.v;`
# stored that word into a slot typed `Pt` that was not inline, so `p.x` dereferenced it: SIGSEGV
# on x86 and aarch64, a page fault on PE. 6.6.10 taught the FIELD destination (`b.v = a.v`) to
# record such a source instead of loading it (`_fla_take`); the variable destinations now arm the
# same record and copy from it byte-exact (`_agc_copy_bytes` with the `-2` source). A field of a
# DIFFERENT struct type is refused by name, as the variable-to-variable copy has been since 6.6.6.
# Armed only when the destination IS a struct, so a scalar `x = b.v;` keeps its one-word load.
# CHANGELOG [6.6.11]
fn _fla_arm(st, dt): i64 {
    _fla_hit = 0;
    if (dt >= 0) { return 0; }
    if (dt <= 0 - 2048) { return 0; }
    _fla_want = st;
    return 0;
}

# `q = b.v;` after the armed PCMPE recorded the field: 1 = copied (`term` consumed: `;`, or `)`
# for a classic-for step).
fn _fla_assign(S, noff, term): i64 {
    _fla_hit = 0;
    _agc_operand(S, noff);
    if (_asg_type_err(S, _istr_hdt(S, noff, _agc_t), 0 - _fla_ft, noff, _fla_name) == 1) { return 0; }   # 6.7.17: no warning; (D18) a `Str` handle
    var dli = _agc_li;
    if (_agc_pp != 0) { dli = _AGC_DREF(dli); }   # 6.6.16 (C2): a handle copies through it too
    _agc_copy_bytes(S, dli, _agc_gvi, 0 - 2, 0 - 1, STRUCTSZ(S, _fla_ft - 1));
    if (_agc_gvi >= 0) { SLVAR(S, _agc_gvi); }   # never a deref-band handle: G is not written
    _expect_step(S, term);   # consume the terminator
    return 1;
}

# `var p: S = b.v;` in a fn: an inline `S` named `p`, filled from the recorded field. 1 = declared.
fn _fla_var_receive(S, noff, pscale): i64 {
    _fla_hit = 0;
    if (_AGG_ASSIGN_TYPE_ERR(S, pscale, 0 - _fla_ft, noff, _fla_name) == 1) { return 0; }
    var t = _agg_temp(S, _fla_ft);
    _agc_copy_bytes(S, t, 0 - 1, 0 - 2, 0 - 1, STRUCTSZ(S, _fla_ft - 1));
    S64(S + 0x5D9D000 + t * 8, noff);
    SSLICE_W(S, t, 0);
    return 1;
}

# ⛔ 6.6.11 — rax = the receiver's VALUE, for a method whose `self: T` is a struct of 8 B or less.
# Such a `self` is passed BY VALUE (`_param_wants_struct_ptr` leaves it out of the structmask), so
# the free call `Odd_sum(x)` pushes x's value; the method arm below pushed `&x` for every `self`,
# and the callee read its fields out of the address: `x.sum()` returned garbage on every backend.
# Loaded through the same base-address resolution the field access uses, at the struct's width
# (1, 2, 4, 8); the callee reads only the declared fields. CHANGELOG [6.6.11]
# ⛔ 6.7.10 (B7 review) — a 3 / 5 / 6 / 7 B receiver was loaded rounded UP to a load (3 -> 4, 5..7 -> 8),
# reading past the object: a `*S7` (or, since the handle line, a handle) onto the last 7 bytes of a
# mapping SIGSEGV'd in `pp.sum()`. It is copied byte-exact through its address now, as every other
# by-value consumer of an odd-sized struct is (`_hl_pval_ra`). CHANGELOG [6.7.10]
fn _self_value_ra(S, idx, sid): i64 {
    var sz = STRUCTSZ(S, sid - 1);
    if (_hl_wpow(sz) == 0) {
        _fld_addr_ra(S, idx, sid, 0, 0 - 1);
        _hl_pval_ra(S, sid);
        return 0;
    }
    _resolve_field_base_addr(S, idx, sid);
    EFIELD_LOAD_W(S, sz);
    return 0;
}

# ⛔ 6.7.7 (B4) — `t.m(..)` / `t.0(..)` on a tuple: a tuple has no methods (R13). And `x.0(..)` on ANY
# receiver: since `t.N` lexes as a selector (T1), `p.0()` on a struct `P` resolved as the method `P_0`
# and CALLED a user `fn P_0(self)` — a meaning the decision never gave (it was "expected identifier,
# got number 0"). A digit-led name is an element selector, never a method. Refused by name at the
# name before the `(`, the call's `( .. )` (and any chain on it) consumed so the parse stays in
# sync. 1 = refused. CHANGELOG [6.7.7]
fn _tup_meth_chk(S, sid, fnoff): i64 {
    var c = load8(S + 0xEC00000 + fnoff);
    if (_tup_is(S, sid) == 1) {
        _tup_err(S, GTI(S) - 1, "a tuple has no methods - ", fnoff, " is not a method of a tuple");
    } elif (c >= 48 && c <= 57) {
        _tup_err(S, GTI(S) - 1, "a method name cannot start with a digit - ", fnoff, " is an element selector (`t.0` reads a tuple's element)");
    } else { return 0; }
    STI(S, _call_close(S, GTI(S)) + 1);
    _mchain_skip(S);   # and a `.field` / `.m(..)` chain on the refused call's result
    EMOVI(S, 0);
    return 1;
}
# 6.7.7 (R11) — the leaf `ft` of the field access that began at token `beg` is a tuple and is about
# to be loaded as a VALUE (no aggregate receiver took it: `_fla_take` copies, `_fpk_note` records a
# by-value argument the call checks by type): `h.p == h.q`, `print(h.p)`. Under the struct rule that
# loaded its first word, silently. Refused by name, at the field. CHANGELOG [6.7.7]
fn _tup_fld_rchk(S, ft, beg): i64 {
    if (_dyn_is(S, ft) == 1) {   # 6.7.8 (V3): a whole dyn field is not a value either
        if (_fpk_want == beg) { return 0; }
        _dyn_err(S, GTI(S) - 1, "", ft, TOKVAL(S, GTI(S) - 1), " (a field) used as a value - call one of its methods, or copy it whole into a dyn");
        SESTYPE(S, 0);
        return 0;
    }
    if (_tup_is(S, ft) == 0) { return 0; }
    if (_fpk_want == beg) { return 0; }
    _tup_err(S, GTI(S) - 1, "tuple field ", TOKVAL(S, GTI(S) - 1), " used as a value - take an element (`.0`) or copy it whole into a tuple");
    return 0;
}

# Load a struct field: ident.field → emit load from var_addr + field_offset
# Or call a method: ident.method(args) → call StructName_method(&ident, args)
fn PARSE_FIELD_LOAD(S, noff): i64 {
    var pfl_beg = _pfl_beg(S);   # the receiver IDENT — a method call's first token (6.6.6); 6.7.14: a wrap's `(`
    STI(S, GTI(S) + 1);  # consume DOT
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);

    # Find the variable and its struct type (check locals first)
    var idx = 0 - 1;
    var sid = 0;
    if (GINFN(S) == 1) {
        var lli = FINDLOCAL(S, noff);
        if (lli >= 0) {
            var lt = GLTYPE(S, lli);
            # v6.4.4: SIMD vector sentinels live in the descriptor band <= -2048
            # (f64v2 -2093, f64v4 -2125, f32v4 -2121, ...) and are NOT struct ids.
            # Without this guard `0 - lt` yields e.g. 2121 -> si=2120, which blows
            # past the 1024-entry struct tables (OOB read in BUILD_METHOD_NAME
            # / FINDFIELD). Vectors expose lanes via fN_laneK(&v), not `.field`.
            # v6.4.14: the old flat -20/-21 special-cases were removed — they
            # collided with struct-ids 20/21, wrongly rejecting `.field` on the
            # 20th/21st struct. The single band check is exact now.
            if (lt <= 0 - 2048) {
                ERR_MSG(S, "SIMD vector has no named fields", 31);
            }
            # 6.7.16: the vector band is no struct id — sid 0 (its arm stays quiet behind the latch); `0 - lt` read
            # struct 2092's tables: `v.m()` went on to "undefined function 'enum.m'" and refused the binary for it.
            if (lt < 0) { if (lt > 0 - 2048) { sid = 0 - lt; } }
            idx = 0 - 2 - lli;
            # v5.8.16 §8: slice dot-syntax field load (s.ptr / s.len).
            # A slice fn-local has GLTYPE=0 and _slice_lw>0 (per-local
            # element width set in §6). The slice occupies a 16-byte
            # 2-slot block: slot lli (canonical, lower address) holds
            # `.ptr` at offset 0; slot lli-1 (higher address allocated
            # ahead of the canonical slot per the §8 layout-flip)
            # holds `.len` at offset 8.
            #
            # Both fields lower to address-based loads (EFLADDR + add
            # + ELODC) rather than direct EFLLOAD against the slot
            # number. Reason: the regalloc post-body peephole pins
            # hot user-locals to callee-saved registers via "time-
            # sliced sharing" (parse_fn.cyr v5.6.20). The picker
            # treats any slot accessed only through `mov rax,
            # [rbp+disp]` / `mov [rbp+disp], rax` as eligible for
            # register routing — it bars `&local` (lea) accesses,
            # which is exactly the bar we want here.
            #
            # The slice's low slot (canonical) is naturally barred
            # because slice_set / slice_ptr / etc. take its address
            # via `&s`. The HIGH slot (lli-1) has no user-visible
            # name, so no `&` is ever taken against it directly —
            # but slice_set writes to it via the low-slot address
            # plus 8 bytes (a memory write the regalloc picker
            # cannot see). If §8 read the high slot via EFLLOAD
            # directly, the picker would happily allocate rbx for
            # it; the EFLLOAD would patch to `mov rax, rbx` and
            # read the stale rbx value (caller's saved rbx, never
            # updated by slice_set's memory write). Reading via
            # &s + 8 keeps the access pattern equivalent to
            # slice_len's helper-fn path and stays out of the
            # regalloc patcher's way.
            var sw = _slice_lw(S, lli);   # 6.7.8 (C2-2a): behind the slice bit
            if (sw > 0) {
                var fname = L64(S + 0xEC00000 + fnoff);
                var fld_off = 0 - 1;
                if (fname & 0xFFFFFFFF == 0x00727470) { fld_off = 0; }      # "ptr\0"
                elif (fname & 0xFFFFFFFF == 0x006E656C) { fld_off = 8; }    # "len\0"
                else { ERR_MSG(S, "slice has only .ptr and .len fields", 35); }
                EFLADDR_X1(S, lli);
                if (fld_off > 0) { EADDIMM_X1(S, fld_off); }
                ELODC(S);
                return 0;
            }
        }
    }
    if (idx == 0 - 1) {
        if (_cl_cslice_field(S, noff, fnoff) == 1) { return 0; }   # 6.7.11: a captured slice's .ptr / .len
        var _cfx = _cl_cap_fld_any(S, noff);   # 6.7.16: an untyped capture too
        if (_cfx < 0 - 1) { idx = _cfx; sid = _cap_fld_sid; }
    }
    if (idx == 0 - 1) {
        idx = FINDVAR(S, noff);
        if (idx < 0) {
            # v6.5.19: --syntax-only treats the unknown base as an opaque value; the
            # `sid == 0` arm below then consumes the field access without emitting a
            # diagnostic, keeping the stream in sync. See _syntax_only.
            if (_syntax_only == 1) { sid = 0; }
            else {
                if (_cst_fld_at(S, noff, _cst_fld_st(S), pfl_beg + 1) == 1) { return 0; }   # 6.7.14: a local const
                # 6.6.6: the `.field` base is a fourth/fifth undefined-variable site. 19a wired the
                # block-scope note into three of the five and the CHANGELOG said "all three", so
                # `tbv.a` after `if (g == 1) { var tbv = 5; }` got the bare error while the plain
                # read and the assignment got the note. See _gv_note_blockscoped. CHANGELOG [6.6.6]
                _undef_var_report(S, noff, "");   # 6.7.14: shared with the factor's (`_ce_name_said`), once per token (ERR_UNDEF)
                _panic = 1;   # 6.7.14: the base is the error — its `sid == 0` arm said "no struct type in scope" too
                return 0;
            }
        }
        else { sid = _gv_recv_sid(S, idx); }   # 6.6.17: a `*T` global's T
    }
    _field_load_on(S, noff, fnoff, pfl_beg, idx, sid);
    return 0;
}

# ⛔ 6.6.17 — A METHOD CALL'S RESULT TAKES `.field` AND `.method(..)` (`s.clone().cat(t)`,
# `p.bump().bump().sum()`, as a value or a statement). The method arm returned straight after
# the call, so the `.` was a syntax error in every position (`expected ';', got '.'`), while a
# free call's result has taken both since 6.6.12 (`_call_field`). The result goes where
# `_call_field` puts a call's: a > 16 B struct in the temp `_sc_pre` gave it, a 9-16 B one in a
# temp `_sc_pre_m` asks for when a chain follows, a <= 8 B struct in an inline temp and a `Str`
# handle in a pointer-mode one — and this body runs again on that temp, so a chain reaches any
# depth. A result that is no struct (nor a `*T`: `_mchain_ptr`), and a struct chain at top level (no
# frame), are refused by name.
# The method a `.m(..)` expression ENDED with (-1 when it ended with a field or anything else) —
# what `p.m(..);` as a statement discards, for #must_use (parse.cyr `_stmt_method_call`).
var _mcall_last = 0 - 1;
# 6.7.15 — the `.name` read past a base that resolved to nothing (PARSE_FIELD_LOAD's undefined arm, the cursor
# after the name): 2 when `(` follows — a method call, which `_cst_fld_at` names "has no methods" on a const —
# else 0, a field read. CHANGELOG [6.7.15]
# 6.7.16 — and `.m<types>(` (`_mlist_end`): a method call too, its list stepped to the `(` — `L.m<i64>(1)` on a local
# const said "has no fields" and `zq.m<i64>(1)` on an undefined name went on to read `<i64>` as a comparison ("undefined
# variable 'i64'", printed under the latch). CHANGELOG [6.7.16]
fn _cst_fld_st(S): i64 {
    if (PEEKT(S) == 10) { return 2; }
    if (_mlist_step(S) == 1) { return 2; }
    return 0;
}
# 6.7.16 — the cursor past `.m` on a receiver of no struct (an undefined name, a local const, a name of an enum that
# declares no m): a `<types>(` there (`_mlist_end` at sid 0) is a method call's list, stepped to its `(` so the call is
# refused as `.m(..)` is, not read as comparisons of the type names. 1 = stepped. CHANGELOG [6.7.16]
fn _mlist_step(S): i64 {
    var e = _mlist_end(S, 0, GTI(S) - 1);
    if (e < 0) { return 0; }
    STI(S, e + 1);
    return 1;
}
# 6.7.15 — the method arm's `sid == 0` refusal ("no struct type in scope for 'a'"), out of `_field_load_on`
# (a cybs-ceiling fn): a const receiver is "const 'C' has no methods" (`_cst_fld_at`), and in the run-time body
# of a const fn whose definition check refused (`_ce_fld_said`) it stands down — a method call is never in a
# const fn, and the check named it ("a method call is not in a const fn") or stopped earlier. 1 = said.
# CHANGELOG [6.7.15]
fn _meth_sid0_said(S, noff, pfl_beg, idx): i64 {
    if (_cst_fld_at(S, noff, 2, pfl_beg + 1) == 1) { return 1; }
    return _fld_sid0_said(S, noff, idx);
}
# The `sid == 0` arms' stand-downs (the method call, the `.field` read and store; out of their cybs-ceiling fns): a
# refused const fn's run-time body (`_ce_fld_said`, 6.7.14), and 6.7.15 a variable `noff` (resolved to `idx`)
# whose annotation named a type a refused declaration declared (`_ann_refd_said`, parse_fn_def.cyr). 1 = said.
fn _fld_sid0_said(S, noff, idx): i64 {
    if (_ce_fld_said(S) == 1) { return 1; }
    return _ann_refd_said(S, noff, idx);
}
fn _mchain_at(S, k): i64 {
    if (TOKTYP(S, k) != 41) { return 0; }
    if (TOKTYP(S, k + 1) != 2) { return 0; }
    return 1;
}
# `_sc_pre` for the method arm (cursor on the call's `(`): a 9-16 B result followed by a chain
# needs its temp as much as one a destination asked for.
fn _sc_pre_m(S, fi, noff, beg): i64 { return _sc_pre_c(S, fi, noff, beg, GTI(S)); }
# ... with the call's `(` at token `o` (6.7.13: `_icall_sret`, whose cursor is past the callee).
fn _sc_pre_c(S, fi, noff, beg, o): i64 {
    if (_mchain_at(S, _call_close(S, o) + 1) == 0) { return _sc_pre(S, fi, noff, beg); }
    var w = _sc_want;
    _sc_want = beg;
    var t = _sc_pre(S, fi, noff, beg);
    _sc_want = w;
    return t;
}
# After the method call `fi` (`t` = its temp, -1 for none; cursor past its `)`): 1 = a chain on
# its result was parsed (rax = its value), 0 = none follows.
fn _method_chain(S, fi, noff, beg, t): i64 {
    if (_mchain_at(S, GTI(S)) == 0) { return 0; }
    _mcall_last = 0 - 1;                # the chain's own last method, if it ends with one
    var sid = 0;
    if (fi >= 0) { sid = GFRS(S, fi); }
    if (sid <= 0) {
        if (_hl_fn_psid(fi) > 0) { return _mchain_ptr(S, noff, beg, _hl_fn_psid(fi)); }
        if (_syntax_only == 0) { _call_fld_err(S, fi, noff, beg); }   # 6.7.7 (T5): + a multi-value one's hint
        _mchain_skip(S);
        return 1;
    }
    if (GINFN(S) != 1) {
        # 6.7.14: a result over 16 B was refused by the call's own `_sc_pre` (every caller asks it first: the
        # method arm, `_dyn_call_in`, `_icall_sret`) — a top-level `b.mk().b` said it twice. CHANGELOG [6.7.14]
        if (_syntax_only == 0) { if (_ret_agg_class(S, fi) != 2) { _refuse_toplevel_struct_call(S, noff); } }
        _mchain_skip(S);
        # 6.7.15: and a `[..]` on its last field with the chain past it (`o.mk().p[0] = 5;` added a false "cannot
        # subscript field 'p': it is not a *T field": the field was never typed). --syntax-only parses the index.
        if (_syntax_only == 0) { STI(S, _pf_chain_end(S, GTI(S))); }
        return 1;
    }
    if (t < 0) { t = _mchain_temp(S, sid); }
