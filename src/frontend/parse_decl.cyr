    var r = _pe_vroute(S, fi, ti);
    if (r == fi) {
        _vcall_enter(S, fi);
        return fi;
    }
    _callee_site_checks_here(S, r, L64(_fnt_names + r * 8), 0);
    STI(S, ti + 2);
    return r;
