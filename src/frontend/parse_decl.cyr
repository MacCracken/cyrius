    if (ti <= 0) { return 0; }
    if (sid <= 0) { return 0; }
    if (sid >= 2048) { return 0; }
    if (STRUCTSZ(S, sid - 1) > 8) { return 0; }
    if (_tup_is(S, sid) == 1) { return 0; }
    if (lit == 1) { ti = 0 - ti; }
    if (_gz_v == 0) { _gz_v = vec_new(); }
    vec_push(_gz_v, gvi);
    vec_push(_gz_v, ti);
