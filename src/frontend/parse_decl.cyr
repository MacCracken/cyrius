            # v6.3.10 (generic structs): `var x: Box<conc>` — if Box is a generic
            # struct and `<...>` follows with a non-i64 type-arg, instantiate `Box$ty`
            # (deduped) and retarget the local to the instance sid. i64 / non-generic
            # → the existing SKIP_GENERICS (the base struct IS the i64 instance).
            if (_MONOMORPH_OK == 1 && _gs_sid > 0 && PEEKT(S) == 19 && GSTP(S, _gs_sid - 1) != 0) {
                STI(S, GTI(S) + 1);                 # consume `<`
                _ta_pending_gt = 0;
                # v6.3.33: parse conc0 [, conc1] via _parse_one_type_arg (handles a
                # NESTED generic type-arg by instantiating it → its instance sid).
                var _gstc = _parse_one_type_arg(S);
                var _gstc1 = 0;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); _gstc1 = _parse_one_type_arg(S); }  # `,`
                _consume_gt(S);                       # consume the closing `>` (or `>>` tail)
                # Use the base (the all-i64 instance) only when EVERY arg is i64; any
                # non-i64 arg (incl. a distinct second param) needs a real instance.
                var _do_inst = 0;
                # v6.3.37 (B1 half-A): _gstc==0 = an UNRESOLVED type-parameter (`var p:
                # Pair<T>` inside a generic body emitted base-as-i64) — it is the base
                # all-i64 instance, exactly as the return-type classification treats it,
                # so the local keeps the base struct sid and matches _cur_fn_ret_sid (the
                # int-pair/retptr return path then fires). Without this, `_gstc==0 != -8`
                # instantiated a bogus struct → local sid != ret sid → struct-return
