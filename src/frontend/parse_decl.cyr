# field of that name still wins (`p.n < k`). CHANGELOG [6.7.14]
var _mx_fi = 0 - 1;   # the method arm's callee, set by `_meth_targs` for the arm it enters (-1: none)
var _mx_ti = 0 - 1;   # ... and the method's name token
var _mx_qt = 0;       # ... 1 = a type argument was refused: the arm consumes the arguments, judging none
# 1 = token nt is a method name `m` followed by `<..>(`, with m no field of struct `sid` and a generic method of it.
# 6.7.16: at a scalar receiver, a bounded site's (`_mtargs_bs`).
fn _mtargs_at(S, sid, nt): i64 {
