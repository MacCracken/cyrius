# ... a generic method's `: *..*U` of exactly d stars (as `_tpl_call` reads a free one): the struct U binds there.
fn _acv_ppg(S, mf, rs, nt, o, d): i64 {
    var k = _tok_ret_ann(S, mf);
    if (k < 0) { return 0 - 8; }
    var n = 0;
    while (TOKTYP(S, k) == 8) {
        n = n + 1;
        k = k + 1;
    }
    if (n != d) { return 0 - 8; }
    var w = _tok_tp_which(S, mf, k);
    if (w < 0) { return 0 - 8; }
    var c = _gu_okc(_mch_bind(S, mf, rs, nt, o, w));
    if (c <= 0) { return 0 - 8; }
    return c;
}
# The struct method mf returns by value at the step whose name is token nt (its `(` at o, on struct rs) — a generic's
# `: T` the struct T binds there, its `: G<..>` the instance that binding names (`_mch_bind`, `_mch_gres`: read, never
# minted), as `_mch_mres` reads a step; else 0.
fn _acv_mval(S, mf, rs, nt, o): i64 {
    var t = GFRS(S, mf);
    if (GFTP(S, mf) != 0) {
        var w = _gen_ret_tparam(S, mf);
        if (w >= 0) { return _gu_okc(_mch_bind(S, mf, rs, nt, o, w)); }
        if (_gz_gbase(S, t) == 1) { return _mch_gres(S, mf, rs, nt, o, t); }
    }
    if (t <= 0) { return 0; }
    if (t >= 2048) { return 0; }
    return t;
}
# ... the struct a `: *S` method points at — a generic's `: *T` the struct T binds there; else 0.
fn _acv_mptr(S, mf, rs, nt, o): i64 {
    if (GFTP(S, mf) != 0) {
        var k = _tok_ret_ann(S, mf);
        if (k >= 0) { if (TOKTYP(S, k) == 8) {
                var w = _tok_tp_which(S, mf, k + 1);
                if (w >= 0) { return _gu_okc(_mch_bind(S, mf, rs, nt, o, w)); }
            } }
    }
    return _hl_fn_psid(mf);
}
# The cursor on the call `fi` (`_vcall_fi`'s): its checks — and an explicit instance's own (`_gen_own_call_check`) —
# then past its name, `<..>` and `(`, for a path that emits the call itself (Win64's hidden result pointer).
fn _vcall_enter(S, fi): i64 {
    var noff = PEEKV(S);
    var o = _gcall_open(S, GTI(S));
    if (o != GTI(S) + 1) { _gen_own_call_check(S, fi, noff); }
    _callee_site_checks_here(S, fi, noff, 0);
    STI(S, o + 1);
    return 0;
