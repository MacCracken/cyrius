    elif (_vrcv_byname(S, c, ty) == 1) {
        r = 1;   # unwrapped: the receives below, as ever (`_vrcv_g`: an explicit instance) — 6.7.16 (D24), the whole source only
        o = _vcall_o;   # 6.7.13: past `<..>`
