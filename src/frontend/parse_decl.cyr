# ⛔ 6.7.10 (B7 review) — `var q: T = <* E>;` in a fn for ANY dereference whose operand E is typed `*T`
# (`_hl_dstar_x`): `(*p)`, `*(p + i)`, `*h.p`, `*gp()`, `*w.m().p`, `(*self)`. `*p` is a struct VALUE at every
# size (the user's decision 6, 2026-10-12), and only `* IDENT ;` was recognised: every other spelling
# fell to the scalar init, so at 8 B or less q became a HANDLE holding the word the dereference read
# (inline through 6.7.9) and its first `q.v = 9` SIGSEGV'd; over 8 B it was that garbage handle on 6.7.9
# too. E is evaluated once into a hidden temp and the struct is copied through it byte-exact into an
# inline q, as `* IDENT` copies. A `*U` of another struct is refused by name, as `*pu` is; an untyped
# operand (`*x`) is no struct value (decision 1: a handle). 1 = declared (`;` consumed). CHANGELOG [6.7.10]
# 6.7.15: and `*pp` / `(*pp)` of a `**S` (`_hl_dstar_x`'s twin), copied through the `*S` it reads, as `var t: S = p;`
# copies — it bound t to the struct as a handle. CHANGELOG [6.7.15]
fn _sci_dexpr(S, noff, pscale): i64 {
    if (pscale <= 0 - 2048) { return 0; }
    var ps = _hl_dstar_x(S, GTI(S) + 1, 5, 1);
    if (ps <= 0) { return 0; }
    if (_agg_dx_err(S, pscale, 0 - ps, noff) == 1) { return 0; }
    STI(S, GTI(S) + 1);   # consume '='
    var h = _hl_dx_src(S);
    var sz = STRUCTSZ(S, ps - 1);
    var named = _sci_slots(S, noff, pscale, (sz + 7) / 8);
    _agc_copy_bytes(S, named, 0 - 1, _AGC_DREF(h), 0 - 1, sz);
    _expect_step(S, 5);   # consume ';'
    return 1;
}
# 1 = the initialiser after the `=` at the cursor is `*pp` of a `**S` (`_hl_dstar_x`'s twin), for
# `_sci_dexpr` — `* IDENT ;` would take the `*p` name arm, whose `**S` IDENT is no `*T`. CHANGELOG [6.7.15]
fn _sci_dpp(S, pscale): i64 {
    if (pscale <= 0 - 2048) { return 0; }
    if (_hl_dstar_x(S, GTI(S) + 1, 5, 1) <= 0) { return 0; }
    return _hl_dpp;
}
# ⛔ 6.7.6 — the name source of `var v: K = <src>;` at token `ti`: 0 for `IDENT ;`, `k` for the
# name inside `k` parentheses that wrap it up to the `;` (`_pwrap_k`), -1 for anything else.
# `var v: K = (j);` was the value of j's first word in a pointer-mode K: `v.a` SIGSEGV'd.
fn _sci_pname(S, ti): i64 {
    if (TOKTYP(S, ti) == 2) {
        if (TOKTYP(S, ti + 1) == 5) { return 0; }
        return 0 - 1;
    }
    if (TOKTYP(S, ti) != 10) { return 0 - 1; }
    var k = _pwrap_k(S, ti);
    if (TOKTYP(S, _pw_end) != 5) { return 0 - 1; }
    if (TOKTYP(S, ti + k) != 2) { return 0 - 1; }
    if (TOKTYP(S, ti + k + 1) != 11) { return 0 - 1; }
    return k;
}

# v6.5.61 — `r = f(...);` where `r` is a VECTOR local and `f` returns that vector.
#
# The DECLARATION form `var r: f64v2 = f(...)` has had a 16/32-byte receive since v5.10.28
# (the `_is_simd128` / `_is_simd256` paths in PARSE_VAR below). The ASSIGNMENT form never got
# one: it fell through to the generic `EFLSTORE(S, idx)` in parse.cyr, an 8-BYTE store, so a
# correctly-declared `var r: f64v2;` followed by `r = f64v2_add(a, b);` kept at most the low
# half and read back as zero — with only a misleading "assigning non-pointer to typed pointer"
# warning to show for it.
#
# ⭐ EXACTLY THE SPLIT v6.5.57 CLOSED FOR STRUCTS ("the assignment path gets the multi-word copy
# the declaration path has had"), one type-class over. That fix added
# `_try_aggregate_copy_assign` for the local-to-local shape `c = a`; the CALL-RHS shape was
# still uncovered for structs' vector siblings. When a receive path is added to declarations,
# the assignment path is not a separate feature — it is the other half of the same statement.
#
# Mirrors PARSE_VAR's receive exactly, including the Win64 retptr branch: on PE a 16/32-byte
# return is written through a hidden pointer, so the destination address is pushed as arg 0
# rather than a pair being stored after the call.
fn _try_vector_call_assign(S, noff, term): i64 {
    if (GINFN(S) != 1) { return _vasg_gtop(S, noff, term); }   # 6.7.16: a top-level assignment
    var vo = _vrcv_asg(S, noff, term);   # 6.7.11
    if (vo >= 0) { return vo; }
    var dst_li = FINDLOCAL(S, noff);
    var vfi = 0 - 1;
    if (dst_li >= 0) { if (_gcall_open(S, GTI(S)) >= 0) { vfi = _vcall_fi(S, GTI(S)); } }   # 6.7.13: `g<T>(..)` too
    # Not a by-name vector call into a local: 6.7.14 (D38) `x = s.mv();`; 6.7.15 a global, `x = fncallN(&f, ..)`.
    if (vfi < 0) { return _vasg_mscal(S, noff, term); }
    var vrs = GFRS(S, vfi);
    var lt = GLTYPE(S, dst_li);
    # Destination is not the vector the callee returns. Diagnose rather than fall through to
    # the 8-byte store, which is what made every form of this silent (see the header above).
    if (lt != vrs) {
        _refuse_in_sync(S);   # 6.7.16: the statement parses on; the next one keeps its errors
        ERR_MSG(S, "vector return type does not match the assigned variable", 55);
        return 0;
    }
    if (_vec_desc(S, lt) != 1) { return 0; }
    var vns = GVEC_NSLOTS(S);
    if (vns <= 1) { return 0; }
    if (_TARGET_PE == 1) {
        var vnoff = PEEKV(S);
        vfi = _pe_venter(S, vfi);   # v6.6.4: PE retptr receive emits its own call (6.7.13: past `<..>`; 6.7.14: routed)
        EFLADDR(S, dst_li);
        EPUSHR(S);
        # 6.6.6: the arguments through `_owncall_args` — the gates AND the arity check, which
        # this PE-only loop never had (`v = f(3)` on a 2-param `f` built clean). CHANGELOG [6.6.6]
        var vargc = _owncall_args(S, vfi, vnoff, 1);
        var vtarget = L64(_fnt_offsets + vfi * 8);
        if (vtarget >= 0) { ECALLTO(S, vtarget); }
        else { ECALLFIX(S, vfi); }
        ECALLCLEAN(S, vargc);
    } else {
        PCMPE(S);
        if (vns == 4) { EFLSTORE_F64V4_PAIR(S, dst_li); }
        else { EFLSTORE_F64V2_PAIR(S, dst_li); }
    }
    _expect_step(S, term);   # consume the terminator
    return 1;
}

# ⛔ 6.7.11 — A VALUE-FORM VECTOR LOCAL TAKES A VECTOR, OR NOTHING. A vector local gets its 16 / 32 bytes
# — the register pair stored, or on PE the callee's hidden result pointer passed — only from a source
# that IS that vector: a local of its type (`_try_struct_copy_init`, `_try_aggregate_copy_assign`), a
# by-name call declared to return it, that call inside parentheses, and `fncallN(&f, ..)` /
# `callptr(&f, ..)` with `f` declared to return it (`_icall_vret` on PE). Any other source was stored
# as ONE word with the high lanes stale, and on PE a call returning the vector wrote through its first
# argument: refused by name, in the declaration and the assignment (the user's decision, 2026-10-13),
# as the same sources are as a vector RETURN (6.6.6). CHANGELOG [6.7.11]
var _vrcv_k = 0;    # the parentheses `_vrcv_src` found around the source
var _vrcv_g = 0;    # 1 = the by-name source `_vrcv_byname` took is an explicit instance (`g<T>(..)`)
