# dyn, a vector global, and any declaration at top level (an untyped global keeps the word). 6.7.13 (D6 (b)): and
# an inline struct global (`_uci_glob`). CHANGELOG [6.7.12]
# ⛔ 6.7.17 (D95, the user's decision, 2026-10-22: "in a fn, copy the vector") — AND A VECTOR VALUE THAT IS NO CALL: a
# value-form vector local, a by-value vector parameter or a closure's captured vector (`_vnm_lty`, D24's names) answers
# its descriptor, so `var x = w;` copies as `var x: f64v2 = w;` does — as `var v = *p;` (6.7.14's D36) and a struct's
# `var q = s;` do. It bound one word, lane 0: `fn r(): i64 { var w: f64v2 = mk2(4, 7); var x = w; return rd(&x); }` 44
# on every target where the copy reads 47, `lanes(x)` refused, a capture's word garbage. At top level the same value is
# refused (`_vtop_vval`). CHANGELOG [6.7.17]
fn _uci_ps(S): i64 {
    if (GINFN(S) != 1) { return 0; }
    if (PEEKT(S) != 4) { return 0; }
    var pk = _sci_pname(S, GTI(S) + 1);
    if (pk < 0) { return _uci_samp(S); }
    var snoff = TOKVAL(S, GTI(S) + 1 + pk);
    var vt = _vnm_lty(S, snoff);   # 6.7.17 (D95): `var x = w;`, `var x = (w);`
    if (vt != 0) { return vt; }
