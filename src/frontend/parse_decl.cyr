# 6.7.16 (D71): `var h = *(&t);` of an inline `Str` t is `var h = t;` — typed `Str`, a handle on t's header.
fn _uci_samp(S): i64 {
    if (_istr_samp(S, GTI(S) + 1) == 0) { return 0; }
    return 0 - _STR_SID(S);
}
# `t` (a slot's type) names a struct a name copy takes: not a vector, a tuple or a dyn. 1 / 0.
fn _uci_sid_ok(S, t): i64 {
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }
    if (_tup_is(S, 0 - t) == 1) { return 0; }
    if (_dyn_is(S, 0 - t) == 1) { return 0; }
    return 1;
