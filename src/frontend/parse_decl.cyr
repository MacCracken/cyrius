    vec_set(_gu_v, i + 2, sid);
    if (sid > 0) {
        _gu_type(S, gvi, sid);
        if (_gu_hdl == 1) { SVPM(S, gvi, 1); }
        return 0;
    }
    SVTYPE(S, gvi, 0);
    SVPM(S, gvi, 0);
    return 0;
