    elif (_vasg_gnv(S, noff) == 0) { return 0; }
    var mt = _vasg_vt(S, GTI(S), term);
    if (mt == 0) { return _vasg_vval(S, dt, li, term); }   # 6.7.17 (D24): `x = w;`, `x = *pv;`
    if (mt == dt) { return 0; }
    _vrcv_tyerr(S, _vcv_a, 1);
    return 0;
}
# ⛔ 6.7.16 — AND AT TOP LEVEL: `G = mkv(41, 7);` / `G = s.mv();` (after the first statement, or in a top-level for
# step) into a global that is no vector stored one word, silently — x86_64 / aarch64 0, cx / PE 41 — where the same
# assignment in a fn is refused (6.7.15) and the top-level declaration is too (6.7.15's D26 / D27):
# `_try_vector_call_assign` returned before any check outside a fn. The global's arm of `_vasg_mscal`, read with no
# local table (there is none at top level, and the last fn's locals are still in it): a call declared to return a
# vector, of any spelling `_vasg_vt` reads, is refused with the in-fn assignment's words and nothing is emitted. A
# vector global keeps its own refusal (`_vecg_refuse`). 0. CHANGELOG [6.7.16]
fn _vasg_gtop(S, noff, term): i64 {
    if (_vasg_gnv(S, noff) == 0) { return 0; }
    if (_vasg_vt(S, GTI(S), term) == 0) { return _vasg_vval(S, 0, 0 - 1, term); }   # 6.7.17 (D24): `G = *GP;`
    _vrcv_tyerr(S, _vcv_a, 1);
    return 0;
}
# 1 = `noff` names a global that is no vector.
fn _vasg_gnv(S, noff): i64 {
    var gi = _findvar_core(S, noff);
    if (gi < 0) { return 0; }
    if (GVVEC(S, gi) != 0) { return 0; }
    return 1;
}
# The vector the right-hand side at token `ti` (ended by `term`) declares: a by-name call that starts it
# (`_vcall_fi`, as the local's arm reads it), else a call of any spelling that starts it (`_vcall_vt`); 0 = none.
# `_vcv_a` the call.
# ⛔ 6.7.16 (D25 A, the user's decision, 2026-10-19) — A METHOD OR `callptr(&f, ..)` THAT STARTS AN ASSIGNMENT'S
# RIGHT-HAND SIDE IS REFUSED, AS THE BY-NAME CALL IS (6.7.14's D27 (a): one rule for a declaration and an assignment;
# 6.7.15's D29 refused it starting an initialiser): `x = s.m2() + 1;` and `x = callptr(&mk2, 41, 7) + 1;` stored the
# result's word plus 1 (x86_64 / aarch64 1, cx / PE 42) where `x = mk2(41, 7) + 1;` is "vector return type does not
# match the assigned variable" — `start` 1, as the declaration's `_vrcv_mscal` reads it (and D26: wrapped too).
# CHANGELOG [6.7.16]
fn _vasg_vt(S, ti, term): i64 {
    var fi = _vcall_fi(S, ti);
    if (fi < 0) { return _vcall_vt(S, ti, term, 1); }
    _vcv_a = ti;
    return GFRS(S, fi);
}
# PARSE_VAR in a fn, the initialiser [start, cursor) of a value-form vector declaration parsed by the
# scalar path, so not a source the receives take: refused by name, once — not after the initialiser
# refused itself (`_scv_err`; `_panic` in `_vrcv_err`), nor for a by-name call declared to return
# another vector (refused before the parse), nor (6.7.13) for a call naming no fn (`_vrcv_nofn`; 6.7.14: wrapped too).
fn _vrcv_decl_err(S, pscale, start): i64 {
    if (GINFN(S) != 1) { return 0; }
    if (_vrcv_vec(S, pscale) == 0) { return 0; }
    if (_scv_err == 1) { return 0; }
    if (_vrcv_vcall(S, start, pscale, 5) == 1) { return 0; }   # 6.7.16 (D24): not `pscale`'s call that starts it
    if (_vrcv_nofnw(S, start, GTI(S)) == 1) { return 0; }   # 6.7.13: the undefined-function path's (6.7.14: wrapped)
    return _vrcv_err(S, start, "initialised", _vrcv_fptr(S, start, GTI(S)));
}
# `v = <src>` with `v` a local (cursor on the source, `term` ending it): into a value-form vector, an
# accepted source the by-name path below does not take, emitted (1), or any source that is no
# vector, parsed and refused by name (1); -1 = the path below decides (the unwrapped by-name call,
# a mismatched one included, or a destination that is no vector).
fn _vrcv_asg(S, noff, term): i64 {
    var li = FINDLOCAL(S, noff);
    if (li < 0) { return 0 - 1; }
    var lt = GLTYPE(S, li);
    if (_vrcv_vec(S, lt) == 0) { return 0 - 1; }
    var k = _vrcv_src(S, GTI(S), lt, term);
    if (k == 0) {
        _vrcv_bad(S, GTI(S), lt, term, 1);   # a call of another vector, wrapped or not
        return _vrcv_other(S, term, lt);
    }
    if (_vrcv_k == 0) { if (k == 1) { return 0 - 1; } }   # (6.7.13: `g<T>(..)` too — `_vcall_fi` there)
    if (k == 4) { _vrcv_demit(S, li, lt, "assigned", noff); }   # 6.7.13 (D34): `*p`
    else { _vrcv_emit(S, li, lt, k); }
    _expect_step(S, term);
    return 1;
}
# The assigned source that is no vector of type `lt`: a by-name call declared to return one the path below takes or
# refuses (`_vrcv_vcall`; 6.7.16, D24: not `lt`'s call that only starts the source), and (6.7.13) a call naming no fn
# (`_vrcv_nofn`), are the path below's (-1); anything else is parsed and refused by name
# — once: not when its own parse reported (a vector global's read, `_vecg_refuse`), nor (6.7.14) for a wrapped call
# naming no fn, which the parse registered — and the statement consumed (1).
fn _vrcv_other(S, term, lt): i64 {
    var ti = GTI(S);
    if (_vrcv_vcall(S, ti, lt, term) == 1) { return 0 - 1; }
    if (_vrcv_nofn(S, ti) == 1) { return 0 - 1; }   # 6.7.13: the undefined-function path names it
    var he = _had_error;
    var en = _err_n;
    var vd = _vop_vd;
    _vop_vd = 1;   # 6.7.16 (D100): a vector call operand in it is this refusal's
    PCMPE(S);
    _vop_vd = vd;
    if (_own_err(en, he) == 1) { he = 2; }   # 6.7.17: after an earlier error too
    if (_vrcv_nofnw(S, ti, GTI(S)) == 1) { he = 2; }   # 6.7.14: wrapped, the parse registered it
    if (he != 2) { _vrcv_err(S, ti, "assigned", _vrcv_fptr(S, ti, GTI(S))); }
    _expect_step(S, term);
    return 1;
}
# ⛔ 6.7.13 — THE REFUSAL NAMES WHAT IT REFUSES, AND ITS ADVICE FITS THE SOURCE. Since 6.7.11 the text ended
# "; through a fn pointer held in a variable, give the target an out-pointer" for every source (`= 5`,
# `= load64(&w)`, `= &w`), and a call to a fn that does not exist — `var v: f64v2 = f64v2_splat(1.0);` with
# lib/simd.cyr not included — was reported as a refused source ("got `f64v2_splat`") ahead of the
# undefined-function warnings. The hint now follows a callee held in a variable only (`_vrcv_fptr`), a call
# naming no fn is left to the undefined-function path (`_vrcv_nofn`: "undefined function 'f64v2_splat'",
# then "refusing to emit binary"; under --allow-undef it builds and traps at the call, as through 6.7.10),
# and the accepted list names `*p` (D34). CHANGELOG [6.7.13]
# The refusal at token `ti`, `verb` "initialised" / "assigned"; `fp` 1 = the source is a call through a fn
# pointer held in a variable (the out-pointer hint). 0.
fn _vrcv_err(S, ti, verb, fp): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(ti, "_vrcv_err", verb * 2 + fp, 0) == 1) { return 0; }   # 6.7.15: once per site
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": a value-form vector local is ");
    PRSTR(verb);
    PRSTR(" only from a local of its type, a call declared to return it (by name, a method, or fncallN / callptr with the callee written `&f`) or a dereference of a pointer to its type (`*p`) - got `");
    _vrcv_offender(S, ti);
    if (fp == 1) { PRSTR("`; through a fn pointer held in a variable, give the target an out-pointer\n"); }
    else { PRSTR("`\n"); }
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}
# 1 = the source at token `ti` starts with a call `name(` naming no fn: FINDFN finds none, or only the entry an
# earlier such call registered (no definition — `GFDS` 0, the prescan stamps every fn — and no code); not
# `sizeof` / `mulh64`, intrinsics read by name. Before the parse or after it (the call registers the name).
fn _vrcv_nofn(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (TOKTYP(S, ti + 1) != 10) { return 0; }
    var n = TOKVAL(S, ti);
    if (_is_sizeof_word(S, n) == 1) { return 0; }
    if (_is_mulh64_word(S, n) == 1) { return 0; }
    var fi = FINDFN(S, n);
    if (fi < 0) { return 1; }
    if (GFDS(S, fi) != 0) { return 0; }
    if (L64(_fnt_offsets + fi * 8) != 0 - 1) { return 0; }
    return 1;
}
# ⛔ 6.7.14 — A CALL NAMING NO FN IS THE UNDEFINED-FUNCTION PATH'S AT EVERY VECTOR DESTINATION, inside parentheses too.
# 6.7.13 left `var v: f64v2 = f64v2_splat(1.0);` (no include) to that path, but the wrapped `= (f64v2_splat(1.0))`,
# `return f64v2_splat(1.0);` from a vector fn and the value-form argument `lanes(f64v2_splat(1.0))` were reported as a
# refused source of their own ("got `(...)`" / "got `f64v2_splat`") ahead of the undefined-function lines — the argument
# instead of them, so the missing include was never named. 1 = the source [a, b), inside any parentheses wrapping all
# of it (`_ie_unparen`), starts with such a call (`_vrcv_nofn`). CHANGELOG [6.7.14]
fn _vrcv_nofnw(S, a, b): i64 {
    return _vrcv_nofn(S, _ie_unparen(S, a, b));
}
# 1 = the source [ti, e), inside any parentheses, is one whole call through fncallN / callptr (`_icall_open_at`)
# whose callee is not written `&f` (`_icall_fti`: `&f` inside any parentheses is the known callee) — a fn pointer
# held in a variable, the one source an out-pointer is the answer for.
fn _vrcv_fptr(S, ti, e): i64 {
    var a = _ie_unparen(S, ti, e);
    var o = _icall_open_at(S, a);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 != _ie_pe) { return 0; }
    if (_icall_fti(S, a) >= 0) { return 0; }
    return 1;
}
# The refused source at token `ti`, as written: a name, a builtin (`callptr`, `load64`), a number,
# `&x` / `*x`, `(...)`.
fn _vrcv_offender(S, ti): i64 {
    var t = TOKTYP(S, ti);
    if (IS_KEYWORD_TOK(t) == 1) { PRSTR(TOKNAME(t)); return 0; }
    if (t == 1) { PRNUM(TOKVAL(S, ti)); return 0; }
    if (t == 10) { PRSTR("(...)"); return 0; }
    if (t == 27 || t == 8) {
        if (t == 27) { PRSTR("&"); } else { PRSTR("*"); }
        if (TOKTYP(S, ti + 1) == 2) { PRSTR(S + 0xEC00000 + TOKVAL(S, ti + 1)); }
        else { PRSTR("..."); }
        return 0;
    }
    if (t == 2) { PRSTR(S + 0xEC00000 + TOKVAL(S, ti)); return 0; }
    PRSTR("this expression");
    return 0;
}

# The right-hand side at token `ti` is a call — `IDENT (` or a generic `IDENT < .. > (` — whose
# RESULT is the value, i.e. not followed by `.field`. PARSE_VAR sizes a struct receive and infers
# an untyped local's struct type from such a call; a field of the result (`var r = mkp(3).y;`)
# is the field's value, not the struct. CHANGELOG [6.6.12]
fn _var_rhs_call(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var c = 0;
    if (TOKTYP(S, ti + 1) == 10) { c = 1; }
    if (c == 0) { if (_MONOMORPH_OK == 1) { if (TOKTYP(S, ti + 1) == 19) {
                var gfi = FINDFN(S, TOKVAL(S, ti));
                if (gfi >= 0) { if (GFTP(S, gfi) != 0) { c = 1; } }
            } } }
    if (c == 1) { if (_call_dotted(S, ti) == 1) { c = 0; } }
    return c;
}
# ⛔ 6.7.11 — THE TYPE AN UNTYPED `var x = f(..) ...;` TAKES FROM ITS LEADING CALL `f` at `ti` (6.6.10:
# the instance the call reaches): its return annotation's GFRS. A STRUCT only when the call ENDS the
# initialiser (`_call_ends_at`, as the receive asks): `var r = mk3(4) - s;` with an integer-returning
# `P3_sub` was typed P3, so `r.x` dereferenced -5 and `var r = mk2(1) == p; return r;` returned a 16-byte
# struct from an 8-byte slot (SIGSEGV, 6.7.6 - 6.7.10). An operator's struct result types the binding
# after the parse (`_var_rhs_post`); any other value leaves it untyped. A `: f64` call's f64 (-9) is judged
# there too (6.7.13): kept when the whole initialiser's type is still f64 — `var x = f() * 2.0;`, the f64
# arithmetic the leading call drives — and dropped for a comparison or an `&&` / `||` (`var c = f() < 1.0;`
# is 0 / 1: it was typed f64, so `-c` flipped the sign bit). CHANGELOG [6.7.11] [6.7.13]
fn _var_rhs_csid(S, ti): i64 {
    var fi = _gen_resolve_call(S, ti);
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs <= 0) { return rs; }
    if (_call_ends_at(S, ti, 5) == 0) { return 0; }
    return rs;
}
# ⛔ 6.7.13 — `var x = (mk1());` WITH AN 8 B STRUCT RESULT INFERRED NOTHING: the peek above wants `IDENT (`
# first, so x was an untyped word and `x.a` was "no struct type in scope for 'x'" (decision 12 / 6.7.11 D42:
# a whole struct result binds the struct at every size, the wrap transparent). The type of a WHOLE free
# call inside parentheses that wrap the whole untyped initialiser at `ti` (`_pwrap_name` up to the `;`,
# `_rcv_iscall`): a struct of 8 B or less (over 8 B the receive takes it, `_rcv_peel`; a dyn, 16 B, keeps
# 6.7.8 V4d's refusal), or a `: f64` call's -9 (judged after the parse, as `var x = f();` is); else 0.
# CHANGELOG [6.7.13]
# 6.7.14 — and a `Str` handle, as `var t = mks();` is typed (v5.10.4): the wrapped one was an untyped word, so
# `println(s)` took the integer overload and `s.len()` was refused. And a `: f64` call's -9 whatever follows the
# wrap: `var a = (f()) * 2.0;` was an untyped word, where `f() * 2.0` is an f64 — `_var_rhs_post` drops it when
# the whole initialiser is no longer an f64 (a comparison, `&&`, `& | ^ % << >>`); a struct still needs the `;`.
# CHANGELOG [6.7.14]
fn _var_rhs_wsid(S, ti): i64 {
    var k = _pwrap_name(S, ti);
    if (k == 0) { return 0; }
    var e = TOKTYP(S, _pw_end);
    if (_rcv_iscall(S, ti + k, k) == 0) { return 0; }
    var fi = _gen_resolve_call(S, ti + k);
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs == 0 - 9) { return rs; }
    if (e != 5) { return 0; }
    if (rs <= 0) { return 0; }
    if (rs > 2047) { return 0; }
    if (rs == _STR_SID(S)) { return rs; }
    if (STRUCTSZ(S, rs - 1) > 8) { return 0; }
    return rs;
}

# ⛔ 6.7.11 — PARSE_VAR's struct receive looked for `IDENT (` right after `=`, so `var x = (mk());`
# with `mk` returning a struct over 8 B inferred nothing: x held the FIRST word, and `dq(x)` into a
# by-value struct parameter passed it as the struct's address (SIGSEGV; cx / PE a guest error). The
# number of parentheses that wrap the whole untyped initialiser at `ti` (`_pwrap_k`, up to the `;`),
# 0 for none: the receive then judges the call inside, and the typed path takes it through
# `_scv_peel`, exactly as for `var x: Q = (mk());`. A struct annotation peels for itself; a tuple
# literal is no wrap; a dyn result keeps its own refusals (6.7.8 V4d). CHANGELOG [6.7.11]
fn _rcv_peel(S, ti, pscale): i64 {
    if (pscale != 0) { return 0; }
    var k = _pwrap_name(S, ti);
    if (k == 0) { return 0; }
    if (TOKTYP(S, _pw_end) != 5) { return 0; }
    var fi = FINDFN(S, TOKVAL(S, ti + k));
    if (fi >= 0) { if (_dyn_is(S, GFRS(S, fi)) == 1) { return 0; } }
    return k;
}
# The parentheses at token `ti` that wrap one whole value whose inside starts with a name (`(mk())`,
# `((g<P>(1)))`): their count, with `_pw_end` the token after the outermost `)` for the caller's
# terminator; 0 for none. A tuple literal is no wrap. The peel of the receive above and of a struct
# literal's element (`_spi_pcall`), each then judging the call inside. CHANGELOG [6.7.11]
fn _pwrap_name(S, ti): i64 {
    if (TOKTYP(S, ti) != 10) { return 0; }
    if (_tup_lit_at(S, ti) >= 0) { return 0; }
    var k = _pwrap_k(S, ti);
    if (TOKTYP(S, ti + k) != 2) { return 0; }
    return k;
}
# The call at `ti` is the whole initialiser: followed by the `;`, or by the wrap's `)` (`pk` > 0).
fn _rcv_iscall(S, ti, pk): i64 {
    if (_var_rhs_call(S, ti) == 0) { return 0; }
    if (pk > 0) { return _call_ends_at(S, ti, 11); }
    return _call_ends_at(S, ti, 5);
}
# ⛔ 6.7.11 — `var x: i64 = mkp();` (`: u8`, `: f64`, `: bool`, any annotation that names no struct)
# with `mkp` returning a struct over 8 B: the receive inferred the struct OVER the annotation, so x
# became a P2 (`x.b` compiled) and a `u8` held 333 — or, for a bool, the bool check refused it as
# "not a bool". Refused by name at the call (the user's decision, 2026-10-13: refuse); 1 = refused,
# and the variable parses on as its annotation says, with no struct receive (a bool's own check is
# dropped: it would refuse the same initialiser twice). A struct of 8 B or less and a `Str` handle
# are one word, which the scalar keeps; a dyn's is `_dyn_var_ann`'s. `ann` is the annotation's first
# token, the cursor its `=`. CHANGELOG [6.7.11]
fn _rcv_scalar_ann(S, ti, sid, pscale, ann, noff): i64 {
    if (pscale != 0) { return 0; }
    return _rcv_ann_refuse(S, ti, TOKVAL(S, ti), sid, 0, ann, noff);
}
# 1 = D24 refuses the struct `sid` into the annotation at `ann`: a struct over 8 B, not a `Str` handle, not a
# dyn (`_dyn_var_ann`'s), and not a generic base's `T` (`_rcv_tp_base`).
fn _rcv_ann_hit(S, sid, ann): i64 {
    if (ann <= 0) { return 0; }
    if (_rcv_big(S, sid) == 0) { return 0; }
    if (_rcv_tp_base(S, ann) == 1) { return 0; }
    return 1;
}
# 1 = struct `sid` is a value D24 refuses into no struct: over 8 B, not a `Str` handle, not a dyn.
fn _rcv_big(S, sid): i64 {
    if (sid <= 0) { return 0; }
    if (_dyn_is(S, sid) == 1) { return 0; }
    var sz = STRUCTSZ(S, sid - 1);
    if (sz <= 8) { return 0; }
    if (sz <= 16) { if (sid == _STR_SID(S)) { return 0; } }
    return 1;
}
# ⛔ 6.7.13 — D24's one refusal, shared by every path that reaches it: the free call (`_rcv_scalar_ann`), the known
# `&f` call (`_scv_icall_ann`), the top-level call (`_scv_gcall_ann`) and a method or operator result
# (`_scv_rec_ann`, D13). Reported at token `ti`, naming the fn `fnoff`; `pscale` > 0 is a pointer annotation, whose
# remedy is D14's (`declare 'x: P2' and take `&x``). 1 = refused (or already reported at `ti`). The cursor is the
# declaration's `=`. CHANGELOG [6.7.13]
fn _rcv_ann_refuse(S, ti, fnoff, sid, pscale, ann, noff): i64 {
    if (_rcv_ann_hit(S, sid, ann) == 0) { return 0; }
    return _rcv_say(S, ti, fnoff, sid, pscale, ann, noff);
}
# ⛔ 6.7.15 — D27 AT AN UNTYPED ASSIGNMENT DESTINATION (the user's decision D33 (a), 2026-10-18): `x = mkp();` with
# `x` an untyped `var x = 0;`, an untyped parameter or global, or a destructure name kept the struct's first word (333
# — the filed repro exited 77), silently, where `x: i64` is refused (6.7.14's D27) and 6.7.10's decision 12 never gives
# an untyped receive a struct's first word. Refused with D27's words minus the annotation (`_asa_refuse`, parse.cyr):
# "cannot assign 'x' from 'mkp', which returns the struct 'Q' - declare 'x: Q' or bind a field". A struct of 8 B or
# less, a `Str` and a dyn keep their word, as D27 keeps them. 1 = refused. CHANGELOG [6.7.15]
fn _rcv_unt_refuse(S, ti, fnoff, sid, noff): i64 {
    if (_rcv_big(S, sid) == 0) { return 0; }
    return _rcv_say(S, ti, fnoff, sid, 0, 0, noff);
}
# The report itself, once at token `ti`; `ann` 0 = the destination has no annotation (D33). 1 = refused.
fn _rcv_say(S, ti, fnoff, sid, pscale, ann, noff): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 1; }
    if (ann > 0) { if (_rcv_ann_refd(S, ann) == 1) { return 1; } }   # 6.7.14: the annotation itself was refused
    if (_tn_once(S, ti) == 0) { return 1; }
    var eq = GTI(S);
    var ae = eq;
    if (_rcv_asg_e >= 0) { ae = _rcv_asg_e; }
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(_rcv_head());
    PRSTR(S + 0xEC00000 + noff);
    if (ann > 0) {
        PRSTR(": ");
        _rcv_ann_pr(S, ann, ae);
    }
    PRSTR("' from '");
    if (_rcv_isv == 1) {   # 6.7.17 (D106): a struct value that is no call, named as written
        _ssv_pr(S);
        PRSTR("', which is the struct '");
    } else {
        PRSTR(S + 0xEC00000 + _fn_src_name(S, _rcv_fi, fnoff));
        PRSTR("', which returns the struct '");
    }
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
    PRSTR("' - declare '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR(": ");
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
    _rcv_ann_tail(S, pscale, noff);
    _err_excerpt(S);
    _had_error = 1;
    STI(S, eq);
    return 1;
}
# ⛔ 6.7.14 — 1 = the annotation at `ann` (its type name, past any `*`) was refused at that name already: an unknown
# type (`_tn_refuse`) or another refusal there (`_tn_once`). `var x: Foo = b.mk();` reported "unknown type 'Foo'" and
# then D24's "cannot initialise 'x: Foo' from 'Q_mk'" for the same line (the free call, the `&f` call, a method, an
# operator and `*Foo` alike). D24 says nothing more: the line is refused, and the declaration parses on as the
# annotation's refusal left it (a plain i64, no struct receive). CHANGELOG [6.7.14]
fn _rcv_ann_refd(S, ann): i64 {
    var t = ann;
