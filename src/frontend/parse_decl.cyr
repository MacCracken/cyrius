# A captured source, as `_sci_cap_src` takes one: the capture's words, or a captured address-passed
# parameter's (`_cl_snap_is_sptr`) — never a captured `*T` or handle.
fn _uci_cap(S, snoff): i64 {
    if (_cl_capturing != 1) { return 0; }
    if (_cl_env_lidx < 0) { return 0; }
    var esl = _cl_snap_find(S, snoff);
    if (esl < 0) { return 0; }
    if (_cl_cap_find(esl) < 0) { return 0; }
    var t = _cl_snap_type(esl);
    if (_uci_sid_ok(S, t) == 0) { return 0; }
    if (_cl_snap_ptrp(esl) == 1) { return 0; }
    if (_cl_snap_span(esl) >= 1) { return t; }
    if (_cl_snap_is_sptr(S, esl) == 1) { return t; }
