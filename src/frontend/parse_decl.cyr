fn _pe_vroute(S, fi, ti): i64 {
    if (TOKTYP(S, ti + 1) != 10) { return fi; }
    if (TOKTYP(S, ti + 2) != 27) { return fi; }
    var p = _fnc_ptr_sib(S, TOKVAL(S, ti));
    if (p < 0) { return fi; }
    if (GFRS(S, p) != GFRS(S, fi)) { return fi; }
    return p;
}
# 1 = local type `ty` is a value-form vector of 16 / 32 bytes.
fn _vrcv_vec(S, ty): i64 {
    if (ty > 0 - 2048) { return 0; }
    if (_vec_desc(S, ty) != 1) { return 0; }
    if (GVEC_NSLOTS(S) <= 1) { return 0; }
    return 1;
}
# The source at token `ti` of a vector of type `ty`, ended by `term`, when it is that vector: 1 = a
# by-name call to a fn declared `: ty`, 2 = `fncallN(&f, ..)` / `callptr(&f, ..)` with `f` declared
# `: ty`, 3 = (6.7.13, D29) a method call `x.m(..)` declared `: ty` (`_vmc_fi`) — inside `_vrcv_k`
# parentheses, the call alone in them; 4 = (6.7.13, D34) a whole dereference `*E` (`_vrcv_dsrc`: its operand's
