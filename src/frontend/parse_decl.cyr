        } elif (_fn_self_byval(mfi) == 1) {
            _self_value_ra(S, idx, sid);                   # 6.6.11: a <= 8 B `self: T` is by value
        } elif (idx <= 0 - 1000000) {
            _CL_CAP_BASE_RA(S, 0 - 1000000 - idx, sid);   # 6.6.5: `self` from a closure capture
        } elif (idx < 0 - 1) {
            var mli = 0 - idx - 2;
            # 6.6.5: the recorded layout, same reader as field access (see _local_struct_is_ptr).
            # 6.6.20: an inline receiver's `self` is an address in this frame, as `&s` is: a method
            # may hand it back — unless it copies a by-value `self: T` (`_sarg_escapes`).
            if (_local_struct_is_ptr(S, mli, 0 - sid) == 1) { EFLLOAD(S, mli); } else { _sarg_escapes(mfi, 0, 0); EFLADDR(S, mli); }
        } else {
            if (_gv_holds_addr(S, idx) == 1) { EVLOAD(S, idx); } else { EVADDR(S, idx); }
        }
        # 6.7.3: `self` is ARGUMENT 0 — `impl Pt { fn weird(self: Q) }` with `p.weird()` read a Pt as
        # a Q (see `_sarg_type_err`). An untyped `self` records the impl's own struct.
        if (sid > 0) { _sarg_type_err(S, mfi, 0, sid, noff); }
        EPUSHR(S);
        _self_snap(S, mfi, sid);   # 6.7.7: a by-value `self` an argument may write is copied here
        # The arguments: PARSE_FNCALL's own marshaller, `self` as parameter 0 (p0 = 1) and int
        # arg `m_n0` (after the retptr `_sc_pre` pushed). ⛔ This path had its own loop with NONE of
        # PARSE_FNCALL's callee-mask gates and no arity check until 6.6.5 — the history is at
        # `_owncall_args_at`; it shares that loop since 6.7.7. The arity message names the `(`.
        # CHANGELOG [6.6.5] [6.7.7]
        var m_ti = GTI(S);           # the `(`; the method's NAME is the token before it
        var m_line = GTLINE(S, m_ti);
        STI(S, GTI(S) + 1);  # consume (
        var m_int_argc = _owncall_args_at(S, mfi, mname, 1 + m_n0, 1, m_line);
        _sc_x8(S, mfi, m_rt);        # 6.6.6: aarch64's retptr register
        _callee_site_checks(S, mfi, mname, m_nt);   # v6.6.4: `s.method()` is its own call path
        _pure_effect_warn(S, mfi, mname);               # 6.6.17: and #pure's #io / #alloc check
        var mfoff = L64(_fnt_offsets + mfi * 8);
        if (mfoff >= 0) { ECALLTO(S, mfoff); }
        else { ECALLFIX(S, mfi); }
        ECALLCLEAN(S, m_int_argc);
        _sc_post(S, mfi, mname, pfl_beg, m_rt);   # 6.6.6: the pair store / value, and the record
        _mcall_ret(S, mfi);                       # 6.7.9: typed as a free call's result (6.6.17: + a `*T` step)
        _mcall_last = mfi;                             # 6.6.17: for a statement's #must_use
        _method_chain(S, mfi, mname, pfl_beg, m_rt);   # 6.6.17: `.field` / `.m(..)` on the result
        return 0;
    }

    # v6.5.19: `e.size` where `e`'s struct is declared in a sibling file — a
    # resolution failure, reported as one. See ERR_IDENT (src/common/util.cyr).
    if (sid == 0) {
        # v6.5.19 --syntax-only: silent, no _panic — but walk any chained `.field`
        # tail first (see _synonly_skip_chain) so nothing is left dangling.
        if (_syntax_only == 1) { _synonly_chain_call(S); return 0; }   # 6.7.16: a call in the chain, `.m<..>(` too
        if (_meth_targs(S, noff, fnoff, pfl_beg, idx, sid) == 1) { return 0; }   # 6.7.16 (D4): a scalar T's `t.m<..>(`
        if (_meth_ngt0(S, noff, fnoff, pfl_beg, idx, sid) == 1) { return 0; }   # 6.7.16: `q.m<i64>(1)` / `C.m<i64>(1)`, as `.m(1)`
        if (_cst_fld_at(S, noff, 0, pfl_beg + 1) == 1) { return 0; }   # 6.7.14: a top-level const
        if (_fld_sid0_said(S, noff, idx) == 1) { return 0; }           # 6.7.14 a refused const fn, 6.7.15 type
        ERR_IDENT(S, "no struct type in scope for ", noff, "; a '.field' access needs its struct declaration (missing include?)", 0 - 1);
        return 0;
    }
    var fi = FINDFIELD(S, si, fnoff);
    if (fi < 0) {
        if (_meth_targs(S, noff, fnoff, pfl_beg, idx, sid) == 1) { return 0; }   # 6.7.14 (D7 (a)): `p.id<f64>(h)`
        if (_meth_ngt(S, noff, fnoff, pfl_beg, idx, sid) == 1) { return 0; }   # 6.7.16: `p.m<i64>(1)`, as `p.m(1)`
        # v6.5.19 --syntax-only: a wrong field NAME is not a grammar error, so stay
        # silent and do not _panic (which would swallow the next real syntax error).
        if (_syntax_only == 1) { _synonly_chain_call(S); return 0; }   # 6.7.16: a call in the chain
        ERR_IDENT(S, "unknown field ", fnoff, " on struct ", L64(S + 0x1A6018 + si * 8));
        return 0;
    }
    var off = FIELDOFF(S, si, fi);
    # Check for chained access: s.inner.field — leaf retype (R1, v6.4.15).
    var ft = _resolve_leaf_field(S, si, fi, off);
    off = _rlf_off;
    var hop = _rlf_hop;
    if (_fld_hop_sid(S) > 0) { return _load_hop(S, noff, pfl_beg, idx, sid, off); }   # 6.6.17
    if (hop < 0) { if (_fld_meth_inline(S, ft) == 1) { return _load_inline_hop(S, noff, pfl_beg, idx, sid, off); } }   # 6.7.0 (A5)
    # 6.7.14: --syntax-only, a `.name` / `.m(..)` left past a `*T` field whose T this file does not declare.
    if (_syntax_only == 1) { if (_mchain_at(S, GTI(S)) == 1) { return _synonly_chain_call(S); } }
    if (_fld_tail_bad(S) == 1) { return 0; }   # 6.7.16: `w.n.b`, n no struct
    if (hop < 0) { if (_fpk_want == pfl_beg) { _fpk_note(S, ft); } }   # 6.7.3: passive, emits nothing
    if (hop < 0) { _fls_note(S, pfl_beg, ft); }   # 6.7.6: passive, emits nothing
    if (hop < 0) { if (_fla_want == pfl_beg) { if (_fla_take(S, idx, sid, off, ft) == 1) { return 0; } } }   # 6.6.10
    if (hop < 0) { _tup_fld_rchk(S, ft, pfl_beg); }   # 6.7.7 (R11): a whole tuple field is not a value
    # Load variable address + field offset, then load value (width-correct).
    # Pointer-vs-inline struct-base resolution: v5.5.36 local-encoded idx
    # (lea rcx,[rbp-disp] via EFLADDR_X1 vs global EVADDR_X1), v5.8.17 -1-sentinel
    # predecessor test, v6.3.16 <=8B-single-slot-inline rule (not on cx — it boxes).
    _resolve_field_base_addr(S, idx, sid);
    if (off > 0) { EADDIMM_X1(S, off); }
    _rlf_emit_hop(S, hop);   # 6.6.17: `h.name.len` — through the Str field's pointer
    return _fld_leaf_load(S, pfl_beg, idx, sid);   # 6.7.10: the leaf at its width and signedness, typed
}

# The leaf field `_resolve_leaf_field` published (`_rlf_si` / `_rlf_fi`), its address in x1: loaded
# through the per-backend `EFIELD_LOAD_W` (v5.9.40) at its width — negative (movsx) for an i8 / i16 /
# i32 field, zero-extended for u8 / u16 / u32 / f32 (`_fld_lw`; through 6.7.9 a negative ftype was
# always signed) — then typed (`_field_load_type`). Out of `_field_load_on`, a giant at cybs's per-fn
# reference ceiling. CHANGELOG [6.7.10]
fn _fld_leaf_load(S, beg, idx, sid): i64 {
    if (_fld_sval_ra(S, idx, sid) == 0) { EFIELD_LOAD_W(S, _fld_lw(S, _rlf_si, _rlf_fi)); }
    _field_load_type(S, _rlf_si, _rlf_fi);
    _flo_note(S, beg, idx, sid);   # 6.7.10: an operator's left operand, maybe
    return 0;
}
# ⛔ 6.7.13 — A WHOLE STRUCT-TYPED FIELD OF 3, 5, 6 OR 7 BYTES AS A VALUE READS THE STRUCT, NO BYTE PAST IT
# (issues/archived/2026-10-14-small-struct-field-value-reads-past-the-object.md), as a dereference does since 6.7.11.
# Its leaf load read the 8-byte word at the field's address, so `take(w.s)`, `return w.s`, `w.s + a` and a
# top-level `var G: S3 = GW.s` read up to 5 bytes past the object — SIGSEGV when it ended a mapping. The leaf
# `_resolve_leaf_field` published, of base `idx` / `sid` at `_rlf_off`, no `Str` hop: a plain struct of 3 / 5
# / 6 / 7 bytes — rax becomes it read through its address byte-exact, its padding 0 (`_hl_pval_ra`); a
# zero-size one reads no byte (rax 0). 1 = rax holds it; 0 = the word load (1 / 2 / 4 / 8 B are one load).
# The `x1` address `_field_load_on` computed goes unused here. CHANGELOG [6.7.13]
fn _fld_sval_ra(S, idx, sid): i64 {
    if (_rlf_hop >= 0) { return 0; }
    var ft = GETFTYPE(S, _rlf_si, _rlf_fi);
    if (ft <= 0) { return 0; }
    if (ft >= 2048) { return 0; }
    if (_dx_plain(S, ft) == 0) { return 0; }
    var sz = STRUCTSZ(S, ft - 1);
    if (sz == 0) { EMOVI(S, 0); return 1; }
    if (_fst_odd_sz(sz) == 0) { return 0; }
    _fld_addr_ra(S, idx, sid, _rlf_off, 0 - 1);
    _hl_pval_ra(S, ft);
    return 1;
}
# ⛔ 6.7.10 — A STRUCT-TYPED FIELD AS AN OPERATOR'S LEFT OPERAND DISPATCHES (the user's decision 11,
# 2026-10-12): `w.s + a`, `p.s + a` through a `*T`, `f().s + a`, `(w.s) + a`, `self.s * a`, at every size,
# exactly as a struct variable does. Only a variable or a struct result typed the left operand, so the
# field's first word was combined with the right operand's and no operator fn was called — silently, at
# every size, since operators existed (issues/archived/2026-10-08-struct-field-left-operand-never-dispatches.md:
# `h.p - s` gave 250, 3 - 9, where `P2_sub` gives 139). The whole field just loaded — chain start `beg`,
# its base (`idx`, `sid`) and its offset (`_rlf_off`, the leaf `_resolve_leaf_field` published) — is
# stamped with the code pointer after its load; `_op_lst` takes it when it is the whole left operand
# and nothing was emitted since. A `Str` field is a handle, a tuple or dyn field is refused as a value,
# and a `*T` field is a pointer: none is stamped. CHANGELOG [6.7.10]
fn _flo_note(S, beg, idx, sid): i64 {
    if (_rlf_hop >= 0) { return 0; }
    var ft = GETFTYPE(S, _rlf_si, _rlf_fi);
    if (ft <= 0) { return 0; }
    if (ft >= 2048) { return 0; }
    if (IS_STR_FIELD(S, ft) == 1) { return 0; }
    if (_tup_is(S, ft) == 1) { return 0; }
    if (_dyn_is(S, ft) == 1) { return 0; }
    _flo_beg = beg;
    _flo_end = GTI(S);
    _flo_cp = GCP(S);
    _flo_sid = ft;
    _flo_idx = idx;
    _flo_bsid = sid;
    _flo_off = _rlf_off;
    return 0;
}
# rax = the address of the field `_flo_note` stamped, as operand 0 of operator fn `fi` (`_fld_addr_ra`,
# the `OP=` path's — its base is raw bytes to CYRIUS_IR=3): an inline aggregate's field in this frame is
# an address in it, which the operator fn may keep (`_sarg_escapes`).
fn _flo_addr_ra(S, fi): i64 {
    if (_flo_idx < 0 - 1) { if (_flo_idx > 0 - 1000000) {
            if (_local_struct_is_ptr(S, 0 - 2 - _flo_idx, 0 - _flo_bsid) == 0) { _sarg_escapes(fi, 0, 0); }
        } }
    _fld_addr_ra(S, _flo_idx, _flo_bsid, _flo_off, 0 - 1);
    return 0;
}

# ⛔ 6.6.10 — AN f64 / f32 FIELD LOADED UNTYPED, so every operator on it took its INTEGER arm:
# with `struct P { x: f64; y: f64; }`, `p.x + p.y` added two bit patterns (NaN for 1.5 + 2.0),
# `p.x * p.y` and `p.x / p.y` gave 0, `-p.x` negated the integer, and `p.x < p.y` compared the
# bits — wrong for negatives — all silent, through a local, a parameter, a global, a chain, a
# union, a method's `self` and `Pair<f64>` alike. And correct code (`2.0 * p.x`, `t + p.y`)
# drew a false kind-1 warning. The load now types the value from the field's recorded kind.
# ⚠ `#derive(accessors)` getters stay UNTYPED on purpose (`P_x(&p)` is `load64`): 21 bit-exact
# `==` / `!=` compares of such getters in svara/samay would become float compares (NaN, ±0).
# So `p.x + p.y` is a float add and `P_x(&p) + P_y(&p)` an integer one; the guide says so.
# CHANGELOG [6.6.10]
var _flt_ti = 0 - 1;   # 6.7.8 (C2-4b): the cursor where the last field load ended (`_sub_word`)
fn _field_load_type(S, si, fi): i64 {
    _flt_ti = GTI(S);
    var k = GFFK(S, si, fi);
    if (k == 1) { SESTYPE(S, F64_TYID); }
    if (k == 2) { SESTYPE(S, F32_TYID); }
    var ps = _fld_ps_get(S, si, fi);   # 6.6.17: a `name: *T` field is a pointer (_add_ptr_field)
    if (ps > 0) { SPSC(S, ps); }
    else { SPSC(S, 0); }   # 6.7.9: no other field has a step (`mk(q).n` kept q's; _pexpr_bit_ps)
    if (GFBOOL(S, si, fi) == 1) { _BX_MARK(S); }   # 6.7.3: a bool field's load is a boolean value
    return 0;
}

# 6.7.3 (B2) — a field's kind for the store checks: the float kind (low bits, _IFS_CHECK's) + 16 for
# a bool. `_ifs_bx` runs both checks on the value just parsed, `fnoff` the field named in a refusal.
fn _fk_bx(S, si, fi): i64 { return GFFK(S, si, fi) + 16 * GFBOOL(S, si, fi); }
fn _ifs_bx(S, k, ti, fnoff): i64 {
    _IFS_CHECK(S, k & 15, ti);
    if ((k & 15) == 2) { _f32_init_round(S, F32_TYID); }   # 6.7.6 (D2): an f64 into an f32 field rounds
    if (k < 16) { return 0; }
    if (_BX_IS(S) == 1) { return 0; }
    return _bx_refuse(S, ti, "cannot store a value that is not a bool into bool field ", fnoff, 0, 0 - 1);
}
# 6.7.8 (C2-4a): the same checks for a subscript's element (`p[i] = v`, `a[i] = v`; `nm` the base's
# name, `k` = `_ek_fk`): an integer constant into an f64 / f32 element warns, an f64 into an f32
# element rounds, and only a bool goes into a bool element.
fn _ifs_bx_el(S, k, ti, nm): i64 {
    if (k < 16) { return _ifs_bx(S, k, ti, nm); }
    if (_BX_IS(S) == 1) { return 0; }
    return _bx_refuse(S, ti, "cannot store a value that is not a bool into a bool element of ", nm, 0, 0 - 1);
}

# 6.7.8 (C2-4b) — `h.p[i] = v` / `h.p[i] OP= v` (the statement and the classic-for step): the leaf
# field (`_rlf_si` / `_rlf_fi`) a `*T`, its VALUE loaded from the field's address (`_fld_addr_ra`),
# then the element addressed and stored as a named `*T`'s (parse_expr.cyr `_psub_addr`,
# `_esub_assign`). A field that is no `*T` is refused by name, the statement parsed on.
fn _fld_sub_store(S, idx, sid, off, hop, term): i64 {
    var fnm = GETFNAME(S, _rlf_si, _rlf_fi);
    var ed = _psub_ed(S, _fld_ps_get(S, _rlf_si, _rlf_fi), 1, GTI(S) - 1);
    if (ed != 0) {
        _fld_addr_ra(S, idx, sid, off, hop);
        ELOAD64(S);           # the field's value: the pointer
    }
    _psub_addr(S, ed);
    EPUSHR(S);                # the element's address
    _esub_assign(S, ed, fnm);
    return _fst_end(S, term);
}
# The field store's end: its terminator — `;`, or a classic-for step's `)` — consumed. 6.7.5
# 6.7.17 (D14): `w.pq = v` with pq a `*S` field (one `*`, S a plain struct) and v no provable non-struct (`_psv_not`)
# nor another struct's whole call (`_psv_other`): the field's address in rax, then `_psl_store` (parse.cyr) — a struct
# value of S copies into the S pq points at, a handle or a `*S` rebinds pq. The leaf field `_rlf_si` / `_rlf_fi` (read
# before the value), the cursor past the `=`. 1 = done (`term` consumed). CHANGELOG [6.7.17]
fn _fst_pslot(S, idx, sid, off, hop, term): i64 {
    var ps = _fld_ptr_sid(S, _rlf_si, _rlf_fi);
    if (ps <= 0) { return 0; }
    if (_dx_plain(S, ps) == 0) { return 0; }
    if (_psv_not(S, GTI(S), term) == 1) { return 0; }
    if (_psv_other(S, GTI(S), term, ps) == 1) { return 0; }
    var nm = GETFNAME(S, _rlf_si, _rlf_fi);
    _fld_addr_ra(S, idx, sid, off, hop);
    return _psl_store(S, term, ps, nm);
}
fn _fst_end(S, term): i64 {
    _expect_step(S, term);
    return 0;
}
# v6.5.19 --syntax-only, a `.field` store whose struct or field this file cannot see: silent, no
# _panic, and the tail parsed as the resolvable path parses it (`= e` or 6.7.5's `OP= e`), or the
# leftover token is reported as a syntax error the file does not have. See `_synonly_skip_chain`.
fn _synonly_fld_tail(S, term): i64 {
    _synonly_skip_chain(S);
    if (PEEKT(S) == 28) { _psub_addr(S, 0); }   # 6.7.8 (C2-4b): `e.p[i] = v`, the index parsed
    if (_asg_compound_tok(S) == 0) {
        if (_masg_not_plain(S, " - a field is not one") == 1) { return _fst_end(S, term); }   # 6.7.7 (T5)
        if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
        STI(S, GTI(S) + 1);
    }
    _refuse_lossy_pair(S);   # 6.7.7 (T5b): as the resolvable store refuses it
    PCMPE(S);
    return _fst_end(S, term);
}
# v5.8.16 §8 — `s.ptr = e;` / `s.len = e;` on a slice local `lli`, through the slot's ADDRESS (see
# PARSE_FIELD_STORE). 6.7.5 (B8): and `s.len OP= e`, the address first — a plain word, as
# PARSE_FIELD_LOAD reads `.ptr` / `.len`.
fn _slice_fld_store(S, lli, fnoff, term): i64 {
    var fname = L64(S + 0xEC00000 + fnoff);
    var fld_off = 0 - 1;
    if (fname & 0xFFFFFFFF == 0x00727470) { fld_off = 0; }      # "ptr\0"
    elif (fname & 0xFFFFFFFF == 0x006E656C) { fld_off = 8; }    # "len\0"
    else { ERR_MSG(S, "slice has only .ptr and .len fields", 35); }
    var cop = _asg_compound_tok(S);
    if (cop != 0) {
        _IR_REC0(S, IR_RAW_EMIT);
        EFLADDR(S, lli);
        if (fld_off > 0) { EADDRA_IMM(S, fld_off); }
        EPUSHR(S);
        _arr_sub_load(S, 8);
        _cop_dst = 2;   # 6.7.17 (D15): a slice's field, for `_cop_sres`
        _asg_compound_op(S, cop, 0);
        _asg_store_w(S, 8);
        return _fst_end(S, term);
    }
    if (_masg_not_plain(S, " - a field is not one") == 1) { return _fst_end(S, term); }   # 6.7.7 (T5): `s.len, b = f();`
    if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
    STI(S, GTI(S) + 1);
    _refuse_lossy_pair(S);   # 6.7.7 (T5b): `s.len = f();` stored the tag
    var ti = GTI(S);
    PCMPE(S);
    _dsr_slf(S, ti, ti - 1);   # 6.7.17 (D16): a struct result over 8 B into `.ptr` / `.len`
    EPUSHR(S);
    EFLADDR_X1(S, lli);
    if (fld_off > 0) { EADDIMM_X1(S, fld_off); }
    EPOPR(S);
    ESTOC(S);
    return _fst_end(S, term);
}

# Store to a struct field: ident.field = expr; or ident.inner.field = expr; — ending at `term`: `;`
# for a statement, `)` for a classic-for step (6.7.5, `_for_step_replay`). The terminator reaches
# the struct-copy sources (`_fsc_src`), or a struct-valued step copied ONE word (the 6.6.20 class).
fn PARSE_FIELD_STORE(S, noff, term): i64 {
    STI(S, GTI(S) + 1);  # consume DOT
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);
    # Find the variable and its struct type (check locals first — mirror
    # of PARSE_FIELD_LOAD's lookup so v5.5.36's stack-local structs route
    # through EFLADDR_X1 instead of the global-var EVADDR_X1 + fixup).
    var idx = 0 - 1;
    var sid = 0;
    if (GINFN(S) == 1) {
        var lli = FINDLOCAL(S, noff);
        if (lli >= 0) {
            var lt = GLTYPE(S, lli);
            # v6.4.4: SIMD vector sentinels (band <= -2048) are not struct ids —
            # reject `.field` before `0 - lt` escapes the 1024-entry struct
            # tables. See the mirror guard in PARSE_FIELD_LOAD. v6.4.14 dropped
            # the flat -20/-21 cases (they collided with struct-ids 20/21).
            if (lt <= 0 - 2048) {
                ERR_MSG(S, "SIMD vector has no named fields", 31);
            }
            if (lt < 0) { if (lt > 0 - 2048) { sid = 0 - lt; } }   # 6.7.16: as the load's (no struct 2092)
            idx = 0 - 2 - lli;
            # v5.8.16 §8: slice dot-syntax field store (s.ptr = expr;
            # s.len = expr;). Mirror of the slice-load path in
            # PARSE_FIELD_LOAD — both fields use the address-based
            # store (EFLADDR + add + ESTOC) rather than direct
            # EFLSTORE against the slot number. See PARSE_FIELD_LOAD
            # for the regalloc-picker explanation: routing the high
            # slot through EFLSTORE would let the picker allocate a
            # callee-saved register for it, and the s.len store would
            # land in the register only — invisible to slice_set's
            # subsequent memory reads. Address-based store keeps the
            # memory write authoritative.
            if (_slice_lw(S, lli) > 0) { return _slice_fld_store(S, lli, fnoff, term); }
        }
    }
    if (idx == 0 - 1) {
        if (_cl_cslice_cap(S, noff) >= 0) { return _cl_cslice_store_err(S, noff); }   # 6.7.11
        var _cfx = _cl_cap_fld_any(S, noff);   # 6.7.16: an untyped capture too
        if (_cfx < 0 - 1) { idx = _cfx; sid = _cap_fld_sid; }
    }
    if (idx == 0 - 1) {
        idx = FINDVAR(S, noff);
        if (idx < 0) {
            if (_enum_qual_store_refused(S, noff, fnoff) == 1) { return 0; }   # 6.7.3: `E.A = ..`
            # v6.5.19: --syntax-only treats the unknown base as an opaque value; the
            # `sid == 0` arm below then consumes the field access without emitting a
            # diagnostic, keeping the stream in sync. See _syntax_only.
            if (_syntax_only == 1) { sid = 0; }
            else {
                if (_cst_fld_at(S, noff, 1, GTI(S) - 2) == 1) { return 0; }   # 6.7.14: a local const
                # 6.6.6: the `.field` base is a fourth/fifth undefined-variable site. 19a wired the
                # block-scope note into three of the five and the CHANGELOG said "all three", so
                # `tbv.a` after `if (g == 1) { var tbv = 5; }` got the bare error while the plain
                # read and the assignment got the note. See _gv_note_blockscoped. CHANGELOG [6.6.6]
                _undef_var_report(S, noff, "");   # 6.7.14: shared with the factor's (`_ce_name_said`), once per token (ERR_UNDEF)
                _panic = 1;   # 6.7.14: the base is the error — its `sid == 0` arm said "no struct type in scope" too
                return 0;
            }
        }
        else { sid = _gv_recv_sid(S, idx); }   # 6.6.17: a `*T` global's T
    }
    # v6.5.19: the assignment side of the same class — `e.size = 1;` with the
    # struct declared elsewhere. See ERR_IDENT (src/common/util.cyr).
    if (sid == 0) {
        # v6.5.19 --syntax-only: silent, no _panic — but the `= expr` tail has NOT been
        # consumed at this point, so it must be parsed exactly as the resolvable path
        # below does or the leftover `=` becomes an INVENTED syntax error.
        if (_syntax_only == 1) { return _synonly_fld_tail(S, term); }
        if (_cst_fld_at(S, noff, 1, GTI(S) - 2) == 1) { return 0; }   # 6.7.14: a top-level const
        if (_fld_sid0_said(S, noff, idx) == 1) { return 0; }          # 6.7.14 a refused const fn, 6.7.15 type
        ERR_IDENT(S, "no struct type in scope for ", noff, "; a '.field' assignment needs its struct declaration (missing include?)", 0 - 1);
        return 0;
    }
    return _fst_on(S, noff, fnoff, idx, sid, term);
}
# PARSE_FIELD_STORE past the base: the receiver resolved to (idx, sid) in PARSE_FIELD_LOAD's encoding (a local,
# a capture, a global, a parked pointer), the cursor just past `.name` (`fnoff`): a nested chain, a `*T` hop,
# `[i]`, `= e` or `OP= e`, stored at the leaf's width, the statement ended at `term`. 6.7.13: a separate entry so
# a `: *T` call's or method's parked result takes the same body (`_cpf_try`). CHANGELOG [6.7.13]
fn _fst_on(S, noff, fnoff, idx, sid, term): i64 {
    var si = sid - 1;
    var fi = FINDFIELD(S, si, fnoff);
    if (fi < 0) {
        # v6.5.19 --syntax-only: silent, no _panic — and consume the `= expr` tail, or
        # the leftover `=` is reported as a syntax error this file does not have.
        if (_syntax_only == 1) { return _synonly_fld_tail(S, term); }
        ERR_IDENT(S, "unknown field ", fnoff, " on struct ", L64(S + 0x1A6018 + si * 8));
        return 0;
    }
    var off = FIELDOFF(S, si, fi);
    # Check for chained access: s.inner.field = expr — leaf retype (R1, v6.4.15).
    var ft = _resolve_leaf_field(S, si, fi, off);
    off = _rlf_off;
    while (_fld_hop_sid(S) > 0) {           # 6.6.17: `.name` through a `*T` field (_store_hop)
        ft = _store_hop(S, noff, idx, sid, off);
        if (ft == 0 - 1000) { return 0; }
        idx = _hop_idx;
        sid = _hop_sid;
        off = _rlf_off;
    }
    # 6.7.14: --syntax-only, a `.name` left past a `*T` field whose T this file does not declare.
    if (_syntax_only == 1) { if (_mchain_at(S, GTI(S)) == 1) { return _synonly_fld_tail(S, term); } }
    if (_fld_tail_bad(S) == 1) { return 0; }   # 6.7.16: `w.n.b = v`, n no struct
    var hop = _rlf_hop;   # 6.6.17: saved before the RHS can re-resolve a field
    if (PEEKT(S) == 28) { return _fld_sub_store(S, idx, sid, off, hop, term); }   # 6.7.8: `h.p[i] = v`
    var lfn = GETFNAME(S, _rlf_si, _rlf_fi);
    var lfk = _fk_bx(S, _rlf_si, _rlf_fi);   # 6.6.10: read before the RHS can re-resolve a field (6.7.3: + bool)
    var lps = _istr_pfs(S, _rlf_si, _rlf_fi);   # 6.7.16 (D19): a `*Str` field, read before the RHS too
    var lfd = ((_rlf_si + 1) << 16) | _rlf_fi;   # 6.7.17 (D16): the field, for `_dsr_fld`
    var fcop = _asg_compound_tok(S);   # 6.7.5 (B8): `x.f OP= e`, the address first (_fld_compound)
    if (fcop != 0) { _fld_compound(S, idx, sid, off, hop, fcop); return _fst_end(S, term); }
    if (_masg_not_plain(S, " - a field is not one") == 1) { return _fst_end(S, term); }   # 6.7.7 (T5): `h.x, b = f();`
    if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
    STI(S, GTI(S) + 1);
    _refuse_lossy_pair(S);   # 6.7.7 (T5b): `h.n = f();` stored the tag, into any field type
    if (_fst_pslot(S, idx, sid, off, hop, term) == 1) { return 0; }   # 6.7.17 (D14): `w.pq = r` copies through pq
    # 6.6.10: a struct VALUE into a struct-typed field copies the whole struct. See `_fsc_src`.
    var fsrc = GTI(S);   # 6.7.7: the source's first token (where a tuple field's refusal points)
    var fsc = _fsc_src(S, ft, lfn, term);   # 6.7.5: `term` — a for step's source ends at `)`
    if (fsc == 1) {
        _fsc_copy(S, idx, sid, off, STRUCTSZ(S, ft - 1));
        return _fst_end(S, term);
    }
    if (fsc == 0) {
        var fst_ti = GTI(S);
        if (_istr_pfdx(S, lps, term) == 0) {   # 6.7.16 (D73): `w.p = *p` into a `*Str` field is p
            PCMPE(S);
            _ifs_bx(S, lfk, fst_ti, lfn);   # 6.6.10: `p.x = 1` into an f64 / f32 field; 6.7.3 into a bool
            _istr_pfld(S, lps, fst_ti);   # 6.7.16 (D19): an inline `Str` into a `*Str` field
            _dsr_fld(S, fst_ti, fst_ti - 1, lfd);   # 6.7.17 (D16): a struct result over 8 B into a scalar field
        }
    }
    _tup_fst_chk(S, ft, lfn, fsrc);   # 6.7.7 (R12): a value in rax is never a tuple
    var fst_sz = FIELDSZ(S, ft);
    if (fst_sz == 0) { return _fst_end(S, term); }   # 6.7.13: a zero-size struct field stores no byte
    if (_fst_odd_sz(fst_sz) == 1) {
        _fst_odd(S, idx, sid, off, fst_sz);
        return _fst_end(S, term);
    }
    # Store value to struct field (width-correct). Route to local or
    # global addr-emit based on idx encoding (same convention as
    # PARSE_FIELD_LOAD; v5.5.36 Phase 2). v5.8.17 §9: same
    # pointer-vs-inline disambiguation as PARSE_FIELD_LOAD —
    # see that fn for the sentinel-based detection rationale.
    EPUSHR(S);
    _resolve_field_base_addr(S, idx, sid);
    if (off > 0) { EADDIMM_X1(S, off); }
    _rlf_emit_hop(S, hop);   # 6.6.17: `h.name.len = n;` — through the Str field's pointer
    EPOPR(S);
    if (fst_sz == 1) { ESTORE8(S); }
    elif (fst_sz == 2) { ESTORE16(S); }
    elif (fst_sz == 4) { ESTORE32(S); }
    else { ESTOC(S); }
    return _fst_end(S, term);
}

# Parse struct init: var name = StructName { expr, expr, ... };
# sid is 1-based struct id, noff is var name offset.
# v5.9.36: width param picks the matching storeN encoding so
# narrow-typed fields (i8/i16/i32) write only their declared
# width — pre-fix the always-store64 path overflowed past
# `STRUCTSZ`-allocated storage at global scope (e.g. `var p32 =
# point_i32 { 100, 200, 300 }` allocated 12 bytes per
# STRUCTSZ but the literal wrote 24, clobbering the next gvar).
# `width = 8` keeps the legacy store64 path; the `width = 1/2/4`
# branches mirror the existing PARSE_FIELD_STORE narrow-store
# encodings.
# 6.6.5 — the struct-literal field stores now serve BOTH a global slot and a FRAME slot.
# `_sl_base_li` is the frame slot when >= 0, and it is captured BEFORE `PCMPE` because an
# initialiser expression can contain a closure whose body declares its own literal and would
# otherwise leave the wrong base in place for the rest of this literal's fields.
var _sl_base_li = 0 - 1;
# 6.6.10: the float kind of the field EMIT_STRUCT_FIELD_W is about to initialise (1 = f64,
# 2 = f32), set by its callers and consumed on entry, so `P { 1, 2 }` into f64 fields warns.
var _sfw_fk = 0;
var _sfw_fn = 0;   # 6.7.3: that field's name (a bool field's refusal names it); _sfw_fk + 16 = a bool
var _sfw_ft = 0;   # 6.7.13: the field's type, for an inline `Str` element (`_istr_lit`)
var _sfw_pf = 0;   # 6.7.16: 1 = the field is a `*Str` (`_istr_pfs`), for an inline `Str` element (`_istr_pfld`)
var _sfw_si = 0 - 1;   # 6.7.17 (D16): the field's struct and index, for `_dsr_lit`
var _sfw_fi = 0;
fn _sfw_set(S, si, fi): i64 {
    _sfw_si = si;
    _sfw_fi = fi;
    _sfw_fk = _fk_bx(S, si, fi);
    _sfw_fn = GETFNAME(S, si, fi);
    _sfw_ft = GETFTYPE(S, si, fi);
    _sfw_pf = _istr_pfs(S, si, fi);
    return 0;
}
# 6.6.12: 1 = the value is already in rax (a nested-literal walk parsed it), consumed on entry.
var _sfw_have = 0;
fn EMIT_STRUCT_FIELD_W(S, vcnt, boff, width): i64 {
    var sl_li = _sl_base_li;
    var fk = _sfw_fk;
    _sfw_fk = 0;
    var ft = _sfw_ft;
    _sfw_ft = 0;
    var pf = _sfw_pf;
    _sfw_pf = 0;
    var lsi = _sfw_si;   # 6.7.17 (D16)
    _sfw_si = 0 - 1;
    if (_sfw_have == 1) { _sfw_have = 0; }
    else {
        # An element is a one-slot store: a `: stack` pair here kept the tag and dropped the payload
        # (`P { f(7), 3 }`, named, a global's), so it is refused as every other store is; `f(7)?`
        # consumes the pair. Right before the PCMPE, as T5b's sites. CHANGELOG [6.7.11]
        _refuse_lossy_pair(S);
        var t0 = GTI(S);
        if (_istr_ldx(S, ft, pf) == 0) {   # 6.7.16: `V { *p, 1 }`, a `*Str`'s `*p` into a `Str` / `*Str` field, is p
            _istr_lsv(S, ft, t0, _sfw_fn);   # PCMPE; 6.7.17 (D18): a struct value of another type into a `Str` field
            _ifs_bx(S, fk, t0, _sfw_fn);
            _istr_lit(S, ft, t0);   # 6.7.13 (D7 (1)): an inline `Str` into a `Str` field
            _istr_pfld(S, pf, t0);   # 6.7.16 (D19): ... and into a `*Str` field (`W { gt, 1 }`)
            _dsr_lit(S, t0, lsi, _sfw_fi);   # 6.7.17 (D16): a struct result over 8 B into a scalar field
        }
    }
    EPUSHR(S);
    # Load variable address into x1/rcx via fixup
    if (sl_li >= 0) { EFLADDR_X1(S, sl_li); }
    else { EVADDR_X1(S, vcnt); }
    if (boff > 0) {
        EADDIMM_X1(S, boff);
    }
    EPOPR(S);
    if (width == 1) { ESTORE8(S); }
    elif (width == 2) { ESTORE16(S); }
    elif (width == 4) { ESTORE32(S); }
    else { ESTOC(S); }
    _slit_sep(S);   # 6.7.15 (D1 (a)): the `,` after the element is required
    return 0;
}
# The token ending the struct literal element at `ti`: its depth-0 `,` or `}`; -1 at anything else. CHANGELOG [6.7.16]
fn _slit_eend(S, ti): i64 {
    var d = 0;
    var i = ti;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 10 || t == 13 || t == 28) { d = d + 1; }
        elif (t == 11 || t == 14 || t == 29) {
            if (d == 0) {
                if (t == 14) { return i; }
                return 0 - 1;
            }
            d = d - 1;
        }
        elif (t == 31) { if (d == 0) { return i; } }
        elif (t == 5 || t == 12) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
# A tuple literal's elements store through the same EMIT_STRUCT_FIELD_W: `_tup_elems` sets `_slit_tup` around each
# element's store, so `(1, 2 3)` names a tuple literal. CHANGELOG [6.7.16]
var _slit_tup = 0;
# ⛔ 6.7.15 — A STRUCT LITERAL'S ELEMENTS ARE SEPARATED BY COMMAS (the user's decision D1 (a), 2026-10-18). After an
# element (cursor past it): a `,` is stepped; the literal's `}` (a tuple literal's `)`, which shares the store) is
# left, so a trailing comma stays valid; a token that can open another element is "expected ',' between struct
# literal elements", at it, once (the statement latched), and the walk reads that element from there. Every element's
# store steps here (positional, named, a nested struct's leaves, generic, in a fn and in both zones; a whole nested
# value is taken only when a `,` / `}` follows it, `_spi_follow`). The declaration zone's bake folds a leaf only when
# its `,` / `}` follows (`_CF_TRY`, `_gai_flit`), so a commaless literal is left to the replay's store, which reports
# it — a kernel build's too. `P { 3 4 }` and `P { b: 1 a: 2 }` compiled, the values landing where the commas put them
# (issues/archived/2026-10-16-struct-literal-elements-need-no-comma.md). A `;` / `)` / `]` / end of file after an element is
# an unclosed literal, left to its own "expected '}'". CHANGELOG [6.7.15]
fn _slit_sep(S): i64 {
    var t = PEEKT(S);
    if (t == 31) { STI(S, GTI(S) + 1); return 0; }
    if (t == 14 || t == 11 || t == 5 || t == 12 || t == 29) { return 0; }
    if (_slit_tup == 1) {
        ERR_MSG(S, "expected ',' between tuple literal elements", 43);
        return 0;
    }
    ERR_MSG(S, "expected ',' between struct literal elements", 44);
    return 0;
}

# The value the walk is carrying into a nested field, parsed but not yet stored:
#   0 none; 1 a struct recorded for `_fsc_src_x1` (named, a field, or a call in a temp);
#   2 a scalar in rax — the next leaf's value; 3 a struct of <= 8 B in rax; 4 a struct call
#   already refused (top level, > 8 B): the whole field is consumed and nothing is stored, so
#   the walk does not descend and invent `unexpected '}'` for the values it would be short.
# `_spi_ps` is the struct type of kinds 1 and 3, `_spi_pn` the source's name for a refusal.
var _spi_pk = 0;
var _spi_ps = 0;
var _spi_pn = 0;
var _spi_pfi = 0 - 1;   # 6.7.15: ... the fn `_spi_pn` is the result of (a method's record, `Pt.dup`), else -1

# R5 (v6.4.15): positional struct-literal init, extracted from the two formerly-parallel
# copies in PARSE_STRUCT_INIT and EMIT_GVAR_INITS (the .44 Str-field fix had to be applied to
# both separately — the exact repeat-fix bug class this kills). target_idx is the global slot
# receiving it (`_sl_base_li` >= 0 selects a frame slot instead).
# ⛔ 6.6.12 — A NESTED STRUCT FIELD WAS FLATTENED AS 8 BYTES PER INNER FIELD, whatever the inner
# fields' widths, and never recursed. `struct HO { o: Odd; t: i8; u: i32; }` (8 B, Odd = i8+i16)
# took its four values at +0, +8, +16, +17 — 13 bytes past the object, over the next global (a
# string's bytes) or, fn-local, over the frame: wrong on x86, aarch64, PE and cx alike. And a
# struct nested TWO levels deep was never descended, so `N { m; v: B { p: Pt; n; } }` stored
# `n` over `m`'s neighbour. Now every leaf is written at its real FIELDOFF and FIELDSZ, the
# walk recursing through each nested struct (a Str field stays ONE 8-byte pointer slot,
# v5.10.7/v6.3.44). Byte-identical for an all-i64 nesting, where 8 was always the width.
# ⭐ 6.6.12 — A NESTED STRUCT FIELD ALSO TAKES A WHOLE STRUCT VALUE: `B2 { p, 5 }` with `p: Pt`
# (a local, a parameter, a global, a struct-typed field, a call / method / operator returning
# Pt) is copied byte-exact, where it used to be `unexpected '}'` because the literal wanted
# `p`'s two words flattened. A struct value of a type found further down the nested field's
# FIRST-field chain fills that inner struct (`N { 1, p, 5 }` with `v: B { p: Pt; n; }`); any
# other struct type is refused by name. An expression that is not a struct value is the first
# LEAF of the nested field, exactly as before. CHANGELOG [6.6.12]
fn _emit_struct_positional_init(S, target_idx, sid): i64 {
    _spi_pk = 0;
    _spi_fields(S, target_idx, _sl_base_li, sid - 1, 0);
    _spi_pk = 0;
    return 0;
}

# Every field of struct `si`, based `base` bytes into the literal's object. `li` is the frame
# slot captured at entry (-1 for a global), since an initialiser can hold a closure with its own.
fn _spi_fields(S, tidx, li, si, base): i64 {
    var fc = GETFCOUNT(S, si);
    var fi = 0;
    while (fi < fc) {
        var ft = GETFTYPE(S, si, fi);
        var off = base + FIELDOFF(S, si, fi);
        if (_spi_is_nested(S, ft) == 1) { _spi_nested(S, tidx, li, si, fi, off); }
        else { _spi_leaf(S, tidx, si, fi, off); }
        fi = fi + 1;
    }
    return 0;
}
fn _spi_is_nested(S, ft): i64 {
    if (ft <= 0) { return 0; }
    if (IS_STR_FIELD(S, ft) == 1) { return 0; }
    return 1;
}

# A scalar / pointer / Str / Vec leaf: its own width, at its own offset. A carried scalar
# (kind 2) is its value, already in rax.
fn _spi_leaf(S, tidx, si, fi, off): i64 {
    if (_spi_pk != 2) { if (PEEKT(S) == 14) { return _spi_short(S); } }   # 6.7.16
    if (_spi_pk == 2) { _sfw_have = 1; }
    _spi_pk = 0;
    _sfw_set(S, si, fi);
    EMIT_STRUCT_FIELD_W(S, tidx, off, FIELDSZ(S, GETFTYPE(S, si, fi)));
    return 0;
}

# A nested struct field of type `ft`: a whole struct value of that type is stored here; one of
# a type on its first-field chain, or a scalar, is carried down into it.
fn _spi_nested(S, tidx, li, si, fi, off): i64 {
    var ft = GETFTYPE(S, si, fi);
    var est = 0 - 1;   # the element's first token, when it starts here
    if (_spi_pk == 0) {
        if (PEEKT(S) == 14) { return _spi_short(S); }   # 6.7.16
        est = GTI(S);
        _spi_pfi = 0 - 1;
        _spi_pk = _spi_src(S, ft, GETFNAME(S, si, fi));
    }
    if (_spi_pk == 4) { return _spi_took(S); }
    if (_spi_pk == 1 || _spi_pk == 3) {
        if (_spi_ps == ft) {
            if (_spi_pk == 1) { _spi_copy(S, tidx, li, off, STRUCTSZ(S, ft - 1)); }
            else { _spi_store_rax(S, tidx, li, off, STRUCTSZ(S, ft - 1)); }
            return _spi_took(S);
        }
        if (_spi_chain_has(S, ft, _spi_ps) == 0) {
            _fsc_type_errf(S, _spi_pn, _spi_pfi, GETFNAME(S, si, fi));
            return _spi_took(S);
        }
    }
    # 6.7.8 (V8): a dyn field takes a whole dyn (a copy, above); descending would write its two words
    # from the literal's values. Refused by name; the walk goes on so the literal stays in sync.
    if (_dyn_is(S, ft) == 1) {
        if (_dyn_lit_form(S, est, ft) == 1) { return _spi_took(S); }   # 6.7.8 (D5): F5, the element taken whole
        _dyn_err(S, GTI(S), "", ft, GETFNAME(S, si, fi), " (a field) is set from a whole dyn - a struct literal cannot write its words");
    }
    _spi_fields(S, tidx, li, ft - 1, off);
    return 0;
}

# ⛔ 6.7.16 — A POSITIONAL LITERAL SHORT OF A FIELD (`P { 2 }` for `struct P { a; b; }`) is "missing struct field in
# initializer" at its `}`, as the named form short of one is: the walk parsed the `}` as the next leaf's value,
# "unexpected '}'", naming no rule. Once (the statement latched, in sync), nothing stored for the leaves left.
# CHANGELOG [6.7.16]
fn _spi_short(S): i64 {
    _refuse_in_sync(S);
    ERR_MSG(S, "missing struct field in initializer", 35);
    return 0;
}
# The carried value was this whole field (stored, or refused by name): drop it, eat its `,`.
fn _spi_took(S): i64 {
    _spi_pk = 0;
    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    return 0;
}

# Is struct `want` the type of a nested struct reached through `ft`'s FIRST fields?
fn _spi_chain_has(S, ft, want): i64 {
    var t = ft;
    while (_spi_is_nested(S, t) == 1) {
        if (t == want) { return 1; }
        if (GETFCOUNT(S, t - 1) == 0) { return 0; }
        t = GETFTYPE(S, t - 1, 0);
    }
    return 0;
}

# The float kind of the leaf a scalar carried into nested struct `ft` lands on (its first leaf).
var _spi_first_fn = 0;   # 6.7.3: that leaf's field name
fn _spi_first_fk(S, ft): i64 {
    var t = ft;
    while (_spi_is_nested(S, t) == 1) {
        if (GETFCOUNT(S, t - 1) == 0) { return 0; }
        var t2 = GETFTYPE(S, t - 1, 0);
        if (_spi_is_nested(S, t2) == 0) { _spi_first_fn = GETFNAME(S, t - 1, 0); return _fk_bx(S, t - 1, 0); }
        t = t2;
    }
    return 0;
}

# The initialiser at the cursor, for a nested struct field of type `ft` (named `fnm`). Returns the kind
# (see `_spi_pk`); 0 = nothing parsed (the leaves parse it).
fn _spi_src(S, ft, fnm): i64 {
    if (_spi_strnm(S, ft) == 1) { return 0; }   # 6.7.17 (D98): a `Str` name, taken by the nested `Str` leaf
    if (PEEKT(S) == 2) {
        var nx = TOKTYP(S, GTI(S) + 1);
        if (nx == 31 || nx == 14) { return _spi_name(S); }
        var r = _spi_call(S, 0);
        if (r != 0) { return r; }
    }
    if (PEEKT(S) == 10) {
        if (_spi_pname(S) == 1) { return 1; }
        var rp = _spi_pcall(S);
        if (rp != 0) { return rp; }
    }
    var rd = _spi_dsrc(S, ft, fnm);   # 6.7.17: a dereference `*pq`
    if (rd != 0) { return rd; }
    return _spi_expr(S, ft);
}
# ⛔ 6.7.17 — A `Str` NAME AS A NESTED STRUCT FIELD'S ELEMENT REACHING A `Str` FIRST LEAF IS THAT LEAF'S VALUE (the user's
# D98, 2026-10-22), as D19 stores `O { *p, 1, 2 }`'s p and the direct literal `WS { a, 1 }` stores a: `O { a, 1, 2 }` /
# `O { gt, 1, 2 }` with O's first field a `WS { s: Str; n; }` were refused as a struct of another type ("cannot copy 'a'
# into a struct field of a different struct type: 'v'") — a `Str` field is one handle slot, not a nested struct. The
# element (inside any wrap) is left to the leaf (0: nothing parsed), which takes it as a positional `Str` field does: a
# handle's word, an inline `Str`'s header address (`*(&t)` is t, 6.7.16's D71), a frame's inline `Str` refused as
# would-dangle (D7 (1)). A `*Str` name is a pointer, no `Str` value: it keeps its refusal. CHANGELOG [6.7.17]
# 1 = the element at the cursor is such a name (a `Str` handle local, parameter, capture or global; an inline `Str`, or
# `*(&NAME)` of one) — or a whole multi-value call, which the leaf refuses (D99) — and nested struct `ft`'s first leaf
# is a `Str`.
fn _spi_strnm(S, ft): i64 {
    var ss = _STR_SID(S);
    if (ss <= 0) { return 0; }
    if (_spi_first_str(S, ft) == 0) { return 0; }
    var st = GTI(S);
    var e = _slit_eend(S, st);
    if (e < 0) { return 0; }
    if (_istr_at(S, st, e) != 0) { return 1; }
    var a = _ie_unparen(S, st, e);
    if (_spi_mvc(S, a, _ie_pe) == 1) { return 1; }   # D99: a multi-value call, refused by the leaf (`_istr_lsv`)
    if (_ie_pe != a + 1) { return 0; }
    if (TOKTYP(S, a) != 2) { return 0; }
    var noff = TOKVAL(S, a);
    if (_fsc_name_src(S, noff) != 0 - ss) { return 0; }
    _fsc_reset();
    if (_spi_nptr(S, noff) == 1) { return 0; }
    return 1;
}
# ⛔ 6.7.17 — A MULTI-VALUE CALL INTO A `Str` PARAMETER IS REFUSED AS INTO A STRUCT PARAMETER (the user's D99,
# 2026-10-22: a `Str` slot refuses it as a struct slot; `_mv_named` admits `Str`): `fs(two())` with `s: Str` passed the
# first value as the header's address. A `Str` parameter is a handle the callee does not copy in (`_pm_copies` 0), yet
# no `*P` — and a generic's `x: T` at `T = Str` is address-passed — so it is judged here: 1 = parameter `argc` of `fi`
# is a `Str` by value (`GFPSID` the `Str`, not declared a pointer). A `*Str` / `**Str` parameter takes the first
# value as a pointer, as a `*P` does (`_mv_pstr` 1). CHANGELOG [6.7.17]
fn _mv_sarg(S, fi, argc): i64 {
    var ss = _STR_SID(S);
    if (ss <= 0) { return 0; }
    if (GFPSID(S, fi, argc) != ss) { return 0; }
    if (_pptr_param(S, fi, argc) == 1) { return 0; }
    return 1;
}
fn _mv_pstr(S, fi, argc): i64 {
    var ss = _STR_SID(S);
    if (ss <= 0) { return 0; }
    if (GFPSID(S, fi, argc) != ss) { return 0; }
    return _pptr_param(S, fi, argc);
}
# 1 = [a, pe) is a whole call (free or method, `_dt_call_open`'s reading) of a fn returning several values (6.7.17, the
# user's D99: a multi-value call into a `Str` slot is refused as into a struct slot — the leaf's `Str` field refuses it).
fn _spi_mvc(S, a, pe): i64 {
    var sv = GTI(S);
    STI(S, a);
    var fi = 0 - 1;
    var o = _dt_call_open(S);
    if (o >= 0) { fi = _dt_call_fn(S); }
    STI(S, sv);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 != pe) { return 0; }
    return _mv_callee(S, fi);
}
# 1 = name `noff`, resolved as the factor resolves it (a local, a capture, a global), is declared a pointer (`*Str`,
# `**Str`): its word is no `Str` value.
fn _spi_nptr(S, noff): i64 {
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) { return GLPTRP(S, li); }
        if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) {
                var esl = _cl_snap_find(S, noff);
                if (esl >= 0) { return _cl_snap_ptrp(esl); }
            } }
    }
    if (_gv_ptr_sid(S, _findvar_core(S, noff)) > 0) { return 1; }
    return 0;
}
# ⛔ 6.7.17 — A DEREFERENCE AS A NESTED STRUCT FIELD'S ELEMENT IS THE STRUCT IT READS (6.7.10's decision 6: `*p` is a
# struct value at every size), as the name it points at is (6.6.12): `O { *pq, 5 }` with `pq: *Q2` into `v: Q2` copies
# `*pq`, a struct on the field's first-field chain fills that inner struct, and another struct is refused by name
# (*cannot copy '*pq' into a struct field of a different struct type: 'v'*). It was a word read carried into the nested
# field's first leaf: a 16-byte element was "missing struct field in initializer" (its second word taken from the next
# element) and another struct's word filled the leaf, silently. `*pp` of a `**S` is the `*S` it reads, copied through
# as a `*S` name is. CHANGELOG [6.7.17]
# The element at the cursor (up to its `,` / `}`) is one dereference `* E` inside any wrap, E typed `*U` (U a plain
# struct; `_hl_dstar_e`'s mode 1): 1 = its pointer parked and recorded (`_spi_ps` U), 4 = refused (the element parsed);
# else 0, nothing moved.
fn _spi_dsrc(S, ft, fnm): i64 {
    var ti = GTI(S);
    var e = _slit_eend(S, ti);
    if (e < 0) { return 0; }
    if (_istr_at(S, ti, e) != 0) { return _spi_dref_t(S, fnm); }   # 6.7.16's D71: `*(&t)` is t
    var ps = _hl_dstar_e(S, ti, e, 1);
    if (ps <= 0) { return 0; }
    if (ps == _STR_SID(S)) { return _spi_dstr(S, ft, ti, e, fnm); }   # 6.7.17 (D19)
    if (_dx_plain(S, ps) == 0) { return 0; }
    if (ps != ft) { if (_spi_chain_has(S, ft, ps) == 0) { return _spi_dref(S, fnm); } }
    _fsc_hsrc(_hl_dx_src(S));
    _spi_ps = ps;
    _spi_pn = 0;
    return 1;
}
# ⛔ 6.7.17 — `*(&t)` OF AN INLINE `Str` t AS A NESTED STRUCT FIELD'S ELEMENT IS t (6.7.16's D71: `*(&t)` is t wherever a
# `Str` value is taken): into a field whose first leaf is no `Str` it is refused by name as `O2 { t, 1, 2 }` is (*cannot
# copy 't' into a struct field of a different struct type: 'v'*); it was t's data word carried into the field's first
# leaf, silently. (A `Str` first leaf takes it as t, D98: `_spi_strnm`. Only the `*(&NAME)` form reaches here: a name is
# `_spi_name`'s.)
fn _spi_dref_t(S, fnm): i64 {
    _fsc_type_err(S, TOKVAL(S, _istr_ti), fnm);
    PCMPE(S);
    return 4;
}
# ... refused by name, the element parsed (4: the whole field).
fn _spi_dref(S, fnm): i64 {
    _fsc_type_err(S, _hl_dname(S), fnm);
    PCMPE(S);
    return 4;
}
# ⛔ 6.7.17 — `*p` OF A `*Str` CARRIED TO A NESTED STRUCT'S `Str` FIRST LEAF IS p (the user's D19, 2026-10-22), as the
# direct literal `WS { *p, 1 }` stores it (6.7.16's SS-8, D20 carried to a literal's `Str` field): `O { *p, 1, 2 }` with
# O's first field a `WS` whose first field is `s: Str` stored the header's data word in `o.v.s`. A `Str` value whose
# nested field does not open with a `Str` leaf is refused by name, as a `Str` name there is (`O2 { a, 1, 2 }`). `*pp` of
# a `**Str` reads the `*Str` itself: a word, carried as before (0). 2 = E parsed (rax = p), carried to the leaf.
fn _spi_dstr(S, ft, ti, e, fnm): i64 {
    if (_hl_dpp != 0) { return 0; }
    if (_spi_first_str(S, ft) == 0) { return _spi_dref(S, fnm); }
    _istr_vdx(S, ti, e);
    return 2;
}
# 1 = the first leaf of nested struct `ft` (down its first fields) is a `Str` field.
fn _spi_first_str(S, ft): i64 {
    var t = ft;
    while (_spi_is_nested(S, t) == 1) {
        if (GETFCOUNT(S, t - 1) == 0) { return 0; }
        t = GETFTYPE(S, t - 1, 0);
    }
    return IS_STR_FIELD(S, t);
}
# 6.7.14 — a named struct in parentheses that wrap the whole element (`HE { 7, (q0), 8 }`, `((q0))`) is the
# element the unwrapped name is (guide § Parentheses; 6.7.11's D44). It was an expression whose word went into
# the nested struct's first leaf and the next element into its second: "unexpected '}'". The wrap is stepped
# into, `_spi_name` takes the name (a struct of another type then meets its refusal by name), and the wrap is
# closed; 0 = not that shape (cursor untouched). CHANGELOG [6.7.14]
fn _spi_pname(S): i64 {
    var st = GTI(S);
    var k = _spi_epk(S, st);
    if (k == 0) { return 0; }
    if (TOKTYP(S, st + k) != 2) { return 0; }
    if (TOKTYP(S, st + k + 1) != 11) { return 0; }
    STI(S, st + k);
    if (_spi_name(S) == 0) {
        STI(S, st);
        return 0;
    }
    _pw_close(S, k);
    return 1;
}

# `IDENT ,` / `IDENT }`: a named struct (recorded, consumed) or 0 (cursor untouched).
fn _spi_name(S): i64 {
    var noff = PEEKV(S);
    var t = _fsc_name_src(S, noff);
    if (t == 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }   # a vector: not a struct, the leaf takes it as ever
    _spi_ps = 0 - t;
    _spi_pn = noff;
    STI(S, GTI(S) + 1);
    return 1;
}

# `f(..)` / `f<..>(..)` followed by `,` or `}` (`pk` > 0: by the `)` of the wrap `_spi_pcall` stepped
# into), `f` returning a struct: > 8 B into a temp (1), <= 8 B in rax (3). 0 = not that shape (cursor
# untouched). At top level there is no frame for a > 8 B result: refused by name (here for rax:rdx,
# by the call itself for a retptr one) and taken as the whole field (4), so that refusal is the only
# error.
fn _spi_call(S, pk): i64 {
    var o = _gcall_open(S, GTI(S));
    if (o < 0) { return 0; }
    if (_spi_follow(S, o, pk) == 0) { return 0; }
    var fi = _gen_resolve_call(S, GTI(S));
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs <= 0) { return 0; }
    if (rs == _STR_SID(S)) { return 0; }
    var noff = PEEKV(S);
    var k = 1;
    if (STRUCTSZ(S, rs - 1) <= 8) { PCMPE(S); k = 3; }
    elif (GINFN(S) != 1) {
        if (_ret_agg_class(S, fi) == 1) { _spi_top_ref(S, noff); }
        PCMPE(S);
        return 4;
    } else {
        var t = _struct_call_into_temp(S);
        _fsc_reset();
        _fsc_li = t;
    }
    # Recorded AFTER the call is parsed: an argument may hold a closure with a literal of its own.
    _spi_ps = rs;
    _spi_pn = noff;
    return k;
}

# ... that refusal, the call's token marked reported, so a dyn result's V4 refusal at the same call ("a dyn Show
# result used as a value") is not a second report (6.7.13, D17 (a)'s top-level row). CHANGELOG [6.7.13]
fn _spi_top_ref(S, noff): i64 {
    _refuse_toplevel_struct_call(S, noff);
    _tn_once(S, GTI(S));
    return 0;
}
# The call whose `(` is token `o` ends the element: `,` / `}`, or the wrap's `)` (`pk` > 0).
fn _spi_follow(S, o, pk): i64 {
    var nx = _call_follow(S, o - 1);
    if (pk > 0) {
        if (nx == 11) { return 1; }
        return 0;
    }
    if (nx == 31) { return 1; }
    if (nx == 14) { return 1; }
    return 0;
}
# ⛔ 6.7.11 — A FREE STRUCT CALL IN PARENTHESES THAT WRAP THE WHOLE ELEMENT (`H { 7, (mkq(4, 9)), 8 }`,
# `((mk<Pt>(1)))`) is the element the unwrapped call is — 6.7.6's transparency, which a wrapped method or
# operator result has too (`_spi_epk`, 6.7.13). It was an expression whose rax went into the nested
# struct's first leaf and the next element into its second: "unexpected '}'" at 16 / 24 B and at 8 B with several
# leaves, a one-leaf struct's word unchecked (issues/2026-10-10-paren-wrapped-struct-call-as-nested-literal-
# element-refused.md; the user's decision (a), 2026-10-13). The wrap is stepped into, `_spi_call` takes the
# call (its refusals — another struct, no frame at top level — the unwrapped call's), and the wrap is
# closed. 0 = not that shape (cursor untouched). CHANGELOG [6.7.11]
# 6.7.13: a dyn-returning call too (`H { 7, (pass(o)), 8 }`, the user's decision D17 (a), 2026-10-15) — it was
# refused twice ("a dyn Show result used as a value", then `_dyn_lit_form`'s). CHANGELOG [6.7.13]
fn _spi_pcall(S): i64 {
    var st = GTI(S);
    var k = _pwrap_name(S, st);
    if (k == 0) { return 0; }
    var e = TOKTYP(S, _pw_end);
    if (e != 31) { if (e != 14) { return 0; } }
    STI(S, st + k);
    var r = _spi_call(S, k);
    if (r == 0) {
        STI(S, st);
        return 0;
    }
    _pw_close(S, k);
    return r;
}

# Any other initialiser, parsed with the struct-source arms up (a struct-typed field, a
# method / operator call returning a struct). A scalar is left in rax (2) for the first leaf.
# A struct call refused at top level (no frame) is the whole field (4), so its refusal is the
# only error.
# `_spi_tup_refd` (6.7.16): an element in which the factor refused a tuple literal (R9: `W { (1, 2), 3 }` for a tuple
# or struct field, `(1, 2) + 1`, `g((1, 2))`, any wrap) is the whole field too, as 6.6.12's refused value: the walk
# carried the element into the field's first leaf, wanted one value more and met the `}` — "unexpected '}'" after
# the literal's own error (alone under --syntax-only, where R9 says nothing: an invented syntax error)
# (issues/archived/2026-10-19-tuple-literal-struct-literal-element-cascades-unexpected-brace.md). CHANGELOG [6.7.16]
fn _spi_expr(S, ft): i64 {
    var st = GTI(S);
    var tl0 = _tls_n;
    var pk = _spi_epk(S, st);   # 6.7.13: the arms below run inside a wrap of the whole element
    var sv = _fla_want;
    var svl = _fla_lit;
    _fla_want = st + pk;
    _fla_lit = st + pk;
    _fla_hit = 0;
    _sc_rbeg = 0 - 1;
    _refuse_lossy_pair(S);   # a scalar carried into a nested field's first leaf is an element too (at its first token). CHANGELOG [6.7.11]
    STI(S, st + pk);
    var w = _sc_arm(S);
    PCMPE(S);
    var bx = _BX_IS(S);   # 6.7.3: the stamp, before anything below can move the cursor
    _pw_close(S, pk);
    _sc_want = w;
    _fla_want = sv;
    _fla_lit = svl;
    if (_spi_refused(S, st, pk) == 1) { return 4; }
    if (_slit_whole(S, st + pk, pk) == 1) { return 4; }   # 6.7.14 (D12 (a)): a refused `P { .. }` is the field
    if (_tls_n != tl0) { return 4; }   # 6.7.16: a tuple literal R9 refused in the element (`_spi_tup_refd`)
    var t = _sc_whole(S, st);
    if (t >= 0) {
        _fsc_reset();
        _fsc_li = t;
        _spi_ps = _sc_sid;
        _spi_pn = _sc_fn;
        _spi_pfi = _sc_fi;
        return 1;
    }
    if (t == 0 - 1) { _refuse_toplevel_struct_call(S, _sc_fn); return 4; }
    if (t == 0 - 3) { _spi_ps = _sc_sid; _spi_pn = _sc_fn; _spi_pfi = _sc_fi; return 3; }
    if (_fla_hit == 1) {
        _fla_hit = 0;
        _spi_ps = _fla_ft;
        _spi_pn = _fla_name;
        return 1;
    }
    _spi_leaf_check(S, _spi_first_fk(S, ft), st, bx);
    return 2;
}
# ⛔ 6.7.13 — A 9-16 B METHOD OR OPERATOR RESULT IN PARENTHESES AS A NESTED-STRUCT LITERAL ELEMENT
# (`HE { 7, (q0.dupe()), 8 }`, `(q0 + q1)`) was refused "unexpected '}'": the struct-call destination was
# armed at the `(`, so the call inside got no frame temp (`_sc_pre` wants `_sc_want` at the call), the
# element was a scalar for the nested struct's first leaf and the next element its second. At 8 B and
# 24 B it worked by accident (rax; the retptr temp). Every other destination steps a whole wrap before it
# arms (`_scv_peel`, `_rcv_peel`, `_ret_peel`); the element now does too: the parentheses wrapping the
# whole element at `st` (up to its `,` / `}`; a tuple literal is no wrap), 0 for none. `_pw_end` is kept.
# CHANGELOG [6.7.13]
fn _spi_epk(S, st): i64 {
    if (TOKTYP(S, st) != 10) { return 0; }
    var pe = _pw_end;
    var k = 0;
    if (_tup_lit_at(S, st) < 0) { k = _pwrap_k(S, st); }
    var e = TOKTYP(S, _pw_end);
    _pw_end = pe;
    if (k == 0) { return 0; }
    if (e != 31) { if (e != 14) { return 0; } }
    return k;
}
# A scalar carried into a nested struct lands on its first leaf: the float warning, and (6.7.3) a
# bool leaf's check — `bx` the stamp taken right after the value was parsed.
fn _spi_leaf_check(S, k, st, bx): i64 {
    _IFS_CHECK(S, k & 15, st);
    if ((k & 15) == 2) { _f32_init_round(S, F32_TYID); }   # 6.7.6 (D2): as _ifs_bx
    if (k < 16) { return 0; }
    if (bx == 1) { return 0; }
    return _bx_refuse(S, st, "cannot store a value that is not a bool into bool field ", _spi_first_fn, 0, 0 - 1);
}

# The whole value (up to its `,` / `}`; inside its `pk` parentheses, 6.7.13) was a > 16 B method /
# operator call `_sc_pre` refused at top level.
fn _spi_refused(S, st, pk): i64 {
    if (_sc_rbeg != st + pk) { return 0; }
    if (_sc_rend + pk != GTI(S)) { return 0; }
    if (PEEKT(S) == 31) { return 1; }
    if (PEEKT(S) == 14) { return 1; }
    return 0;
}

# x1 = the literal's object + `off`.
fn _spi_dst_x1(S, tidx, li, off): i64 {
    if (li >= 0) { EFLADDR_X1(S, li); }
    else { EVADDR_X1(S, tidx); }
    if (off > 0) { EADDIMM_X1(S, off); }
    return 0;
}
fn _spi_store_w(S, w): i64 {
    if (w == 1) { ESTORE8(S); }
    elif (w == 2) { ESTORE16(S); }
    elif (w == 4) { ESTORE32(S); }
    else { ESTOC(S); }
    return 0;
}
fn _spi_w(rem): i64 {
    if (rem >= 8) { return 8; }
    if (rem >= 4) { return 4; }
    if (rem >= 2) { return 2; }
    return 1;
}

# `nb` bytes from the recorded source into the literal at `off` (8/4/2/1-byte chunks).
fn _spi_copy(S, tidx, li, off, nb): i64 {
    var o = 0;
    while (o < nb) {
        var w = _spi_w(nb - o);
        _fsc_src_x1(S, o);
        EFIELD_LOAD_W(S, w);
        EPUSHR(S);
        _spi_dst_x1(S, tidx, li, off + o);
        EPOPR(S);
        _spi_store_w(S, w);
        o = o + w;
    }
    return 0;
}

# A struct of `nb` <= 8 bytes in rax, into the literal at `off`: exactly `nb` bytes, each chunk
# shifted down into place (the value kept on the stack; the address may use rax).
fn _spi_store_rax(S, tidx, li, off, nb): i64 {
    EPUSHR(S);
    var o = 0;
    while (o < nb) {
        var w = _spi_w(nb - o);
        if (o > 0) { EMOVI(S, o * 8); EMOVCA(S); }
        EPOPR(S);
        EPUSHR(S);
        if (o > 0) { ESHRCL(S); }
        EPUSHR(S);
        _spi_dst_x1(S, tidx, li, off + o);
        EPOPR(S);
        _spi_store_w(S, w);
        o = o + w;
    }
    EPOPR(S);
    return 0;
}

# ⛔ 6.7.17 — A NAMED `Str` FIELD IS ONE HANDLE SLOT, NOT A NESTED STRUCT (the user's D21, 2026-10-22): `V { s: a, n: 1
# }` was "named init not supported for nested struct fields — use positional", where the positional `V { a, 1 }`
# compiles. The element goes through the positional `Str` field's checks (EMIT_STRUCT_FIELD_W): an inline `Str`'s header
# address (`_istr_lit`; a frame's refused as would-dangle), `*p` of a `*Str` is p (`_istr_ldx`), another struct refused
# (`_istr_lsv`). 1 = field type `ft` is a struct the named form cannot take (a nested one). CHANGELOG [6.7.17]
fn _sl_named_nest(S, ft): i64 {
    if (ft <= 0) { return 0; }
    if (IS_STR_FIELD(S, ft) == 1) { return 0; }
    return 1;
}
# 6.6.5 — the initialiser body of a struct literal, EXTRACTED so the top-level form and the
# new fn-local form share one parser. Writes through `target_idx` (a global slot) or, when
# `_sl_base_li >= 0`, through that frame slot. CHANGELOG [6.6.5]
fn _STRUCT_INIT_BODY(S, target_idx, sid): i64 {
    var si = sid - 1;
    var fc = GETFCOUNT(S, si);
    # Detect named-field syntax: next token is IDENT (2) followed by ':' (49).
    # Empty struct literal `{}` falls through to positional branch as a no-op.
    var named = 0;
    if (PEEKT(S) == 2) {
        if (TOKTYP(S, GTI(S) + 1) == 49) { named = 1; }
    }
    if (named == 1) {
        # Named init: `StructName { field: expr, field: expr }`.
        # Each field must appear exactly once; any order. Nested struct
        # fields are not supported in named form — use positional for those.
        var initialized = 0;
        while (PEEKT(S) != 14) {
            if (PEEKT(S) == 12) { break; }   # v6.4.61: EOF guard (multi-error recovery safety)
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var fname_off = PEEKV(S);
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
            STI(S, GTI(S) + 1);
            var found = 0 - 1;
            var fi = 0;
            while (fi < fc) {
                if (STREQTOK(S, GETFNAME(S, si, fi), fname_off) == 1) { found = fi; fi = fc; }
                else { fi = fi + 1; }
            }
            if (found < 0) { ERR_MSG(S, "unknown struct field in initializer", 35); }
            var ft = GETFTYPE(S, si, found);
            if (_sl_named_nest(S, ft) == 1) { ERR_MSG(S, "named init not supported for nested struct fields — use positional", 68); }
            var bit = 1 << found;
            if ((initialized & bit) != 0) { ERR_MSG(S, "struct field initialized twice", 30); }
            initialized = initialized | bit;
            var boff = FIELDOFF(S, si, found);
            # v5.9.36: width-correct store. Pre-fix this always
            # store64'd, which clobbered up to 7 bytes past the
            # field for narrow types — happened to work because
            # subsequent stores overwrote the high bytes, but
            # broke for the LAST narrow field at end-of-struct
            # (which would overflow the struct's allocation).
            var nf_w = FIELDSZ(S, ft);
            if (found >= 0) { _sfw_set(S, si, found); }
            EMIT_STRUCT_FIELD_W(S, target_idx, boff, nf_w);
        }
        # Require every field to be set — no implicit zero defaults (yet).
        var fi2 = 0;
        while (fi2 < fc) {
            if ((initialized & (1 << fi2)) == 0) { ERR_MSG(S, "missing struct field in initializer", 35); }
            fi2 = fi2 + 1;
        }
    } else {
        # Positional init — emit each scalar field in declaration order,
        # flattening nested structs.
        # v5.9.36: width-aware boff advance + width-correct store. Pre-
        # fix `boff += 8` per field forced 8-byte stride, but STRUCTSZ
        # used width-aware FIELDSZ summing to <8 per narrow field
        # (i32 → 4) — net `var p32 = point_i32 {...}` allocated 12
        # bytes per STRUCTSZ but the literal wrote 24, clobbering the
        # next gvar. Now: each field advances by its declared width
        # (FIELDSZ) and writes only that many bytes. Untyped fields
        # (`a; b; c;`) keep the 8-byte stride; nested-struct fields
        # flatten into 8-byte slots per inner field (existing
        # behavior preserved).
        _emit_struct_positional_init(S, target_idx, sid);
    }
    return 0;
}

# ⛔ 6.7.16 — AN INLINE LITERAL GLOBAL HOLDS ITS INDEX WHILE ITS ELEMENTS ARE PARSED. A struct or tuple literal global
# after the first statement registered its slot at the next index and bumped the count only after its elements, so the
# name stayed hidden from them (`var cfg = P { cfg, 2 };` reads the outer cfg) — but an element that made a hidden
# global temporary (`_HTEMP`: on PE a vector call's result storage, 6.7.12) took that same index and overwrote the
# slot, and the literal's own count bump then cut the temporary off: `var GP = Pt { mk2(41, 7), 1 };`, `var GT = (3, 1 +
# mk2(41, 7));` printed their refusal and then "undefined variable 'GP'" at the next use (through 6.7.15 that wrong
# error alone, the refusal never printed). Now the slot is counted at once, marked dead — invisible to every lookup
# (`_findvar_core`), so the outer name still answers inside — and made live after the elements. CHANGELOG [6.7.16]
fn _glit_hold(S, vcnt): i64 {
    SVDEAD(S, vcnt, 1);
    SVCNT(S, vcnt + 1);
    return 0;
}
fn PARSE_STRUCT_INIT(S, noff, sid): i64 {
    var si = sid - 1;
    var _ps_decl_ti = GTI(S);   # v6.6.4: the type-name token, for the visibility stamp (see PARSE_ARRAY)
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    var sz = STRUCTSZ(S, si);
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, noff);
    S64(_vars_base + vcnt * 8, sz);
    SVTYPE(S, vcnt, sid);
    SVPM(S, vcnt, 2);   # 6.6.5: a top-level literal is INLINE — STRUCTSZ bytes of .bss
    _glit_hold(S, vcnt);   # 6.7.16: its index held, its name withheld, while the fields are parsed
    var _ps_sv = _sl_base_li;
    _sl_base_li = 0 - 1;
    _STRUCT_INIT_BODY(S, vcnt, sid);
    _sl_base_li = _ps_sv;
    _slit_rbrace(S);   # 6.7.17: elements past the last field, one error
    _slit_unwrap(S);   # 6.7.14: a wrap's `)`s
    SLVAR(S, vcnt);
    _GVAR_VIS(S, vcnt, _ps_decl_ti);   # v6.6.4: PARSE_PROG-path struct-literal global (see PARSE_ARRAY)
    SVDEAD(S, vcnt, 0);   # 6.7.16: the name visible from here (`_glit_hold`)
    _expect_step(S, 5);
    return 0;
}

# ⛔ 6.6.5 — `var p = T { ... }` INSIDE A FN IS A PER-CALL FRAME OBJECT.
#
# It used to register a GLOBAL slot (GVCNT) even with GINFN == 1, which made it three
# different bugs at once, none of them needing a name collision:
#   * RECURSION shared it. `rec(3)` with a literal returned 0 where 9 is right.
#   * THREADS shared it. Eight threads building one returned a wrong exit code on every run,
#     while the identical `var q: T;` + field stores were clean on every run.
#   * FINDVAR is one flat last-match table, so the slot was visible to EVERY later file. A
#     global and a fn-local literal of the same name resolved to the literal — returning 2
#     where 6 is right, in ONE file, silently.
# v6.6.4 made the cross-file case a DIAGNOSTIC for `private` files only, and it named the
# consumer's own variable. Making the storage right is what removes all four.
#
# ⚠ THE NAME IS WITHHELD UNTIL THE INITIALISERS ARE PARSED, which is not a detail: the
# global path bumped GVCNT only at the end, so `var cfg = P { cfg, 2 };` saw the OUTER `cfg`.
# The slots are reserved first (the emitters address them by index, not by GFLC), and the
# name lands last, so the local form keeps that order exactly.
#
# ⚠ EVERY store is ADDRESSED (`lea` + `mov [rcx]`), never EFLSTORE. The regalloc picker
# rewrites `mov [rbp+disp], rax` into a register move; an aggregate's words are then read back
# through an address the register never reaches. Registration also records the span, which
# bars the picker from the slots outright — the addressed stores are the second lock.
#
# ⛔ 6.6.5 (review round 2) — ADDRESS THE BLOCK FROM ITS NAMED SLOT + k*8, NEVER SLOT-BY-SLOT.
# This loop used to `EFLADDR_X1(named - k)`, which is the same address on the STACK (a higher
# slot index is a LOWER address) but NOT in a coroutine's heap frame, where `_ECORO_AGG_OFF`
# answers a whole aggregate from its span. One base + a byte offset is exactly what
# `EMIT_STRUCT_FIELD_W` does for the field stores, so both halves of the literal now ask the
# same question and cannot disagree. CHANGELOG [6.6.5]
fn _sl_zero_slots(S, named, nslots): i64 {
    EMOVI(S, 0);
    var k = 0;
    while (k < nslots) {
        EFLADDR_X1(S, named);
        if (k > 0) { EADDIMM_X1(S, k * 8); }
        ESTOC(S);
        k = k + 1;
    }
    return 0;
}

fn _STRUCT_LIT_LOCAL(S, noff, sid): i64 {
    var si = sid - 1;
    STI(S, GTI(S) + 1);                          # consume the type name
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);                          # consume '{'
    var sz = STRUCTSZ(S, si);
    if (sz < 8) { sz = 8; }
    var nslots = ((sz + 7) & (0 - 8)) / 8;
    var existing = FINDLOCAL(S, noff);
    if (existing >= 0) { if (GLDEP(S, existing) == GSDEP(S)) { ERRDUPVAR(S); } }
    # ⚠ `ERR_MSG` IS NOT A TERMINATOR — it sets `_had_error`/`_panic` (v6.4.62 panic mode) and
    # returns. Without the `return` the allocation loop below ran anyway and was stopped only
    # by `SFLC`'s own `syscall(SYS_EXIT, 1)` at 16384 slots, which REPLACED this precise
    # message with the generic "too many stack slots in one function". Panic mode swallows the
    # cascade, so returning here loses nothing. CHANGELOG [6.6.5]
    if (GFLC(S) + nslots + 1 >= 15360) {
        ERR_MSG(S, "struct literal exceeds the per-fn stack-slot budget; build it through alloc() instead", 85);
        return 0;
    }
    var k = 0;
    while (k < nslots - 1) {
        var fl = GFLC(S);
        S64(S + 0x5D9D000 + fl * 8, 0 - 1);
        SLDEP(S, fl, GSDEP(S));
        SLTYPE(S, fl, 0);
        SSLICE_W(S, fl, 0);
        SFLC(S, fl + 1);
        k = k + 1;
    }
    var named = GFLC(S);
    S64(S + 0x5D9D000 + named * 8, 0 - 1);       # anonymous until the initialisers are parsed
    SLDEP(S, named, GSDEP(S));
    SLTYPE(S, named, 0);
    SSLICE_W(S, named, 0);
    # ⛔ 6.6.5 (review round 2) — THE SPAN MUST BE RECORDED BEFORE A SINGLE BYTE IS EMITTED.
    # It used to land only at the bottom of this fn, after the initialisers. On the stack that
    # is invisible; inside a coroutine it SPLIT THE VARIABLE IN HALF, because `_ECORO_AGG_OFF`
    # reads `GLSPAN` and so answered `named` while the span was still 0 and `named-nslots+1`
    # afterwards. Measured on a suspending `async fn`: `var p = P2{5,6}; await ...; p.x*10+p.y`
    # returned 5 where 56 is right (6.6.4 answered 56) — and the field stores ran up to
    # `nslots-1` slots PAST the block, over whatever local follows. `SLDEP` below overwrites
    # the whole depth word, which is why the trailing `SLAGG` stays. CHANGELOG [6.6.5]
    SLAGG(S, named, nslots);
    SFLC(S, named + 1);
    # Zero every word first: a global literal lands in .bss, so the padding of a struct whose
    # size is not a multiple of 8 reads as zero. A frame slot holds the last call's bytes.
    _sl_zero_slots(S, named, nslots);
    var sv_base = _sl_base_li;
    _sl_base_li = named;
    _STRUCT_INIT_BODY(S, 0, sid);
    _sl_base_li = sv_base;
    _slit_rbrace(S);                             # consume '}' (6.7.17: elements past the last field, one error)
    _slit_unwrap(S);                             # 6.7.14: a wrap's `)`s
    S64(S + 0x5D9D000 + named * 8, noff);
    SLDEP(S, named, GSDEP(S));
    SLAGG(S, named, nslots);
    SLTYPE(S, named, 0 - sid);
    _expect_step(S, 5);                          # consume ';'
    return 0;
}

# ⛔ 6.7.7 (B4) — THE TUPLE LITERAL `(a, b)` (the user's decision, 2026-10-08): a value laid out as an
# anonymous struct of 8-byte slots. It is taken in FIVE positions, each claiming it before an
# expression is parsed — a `var` initializer (`_tup_var`: a local, a global in either zone), an
# assignment to a tuple variable (`_tup_asg`) or tuple field (`_tup_fsc_lit`), a tuple argument
# (`_tup_sarg_lit`), and `return`'s multi-value arm — so a factor that opens one anywhere else is
# refused by name (`_tup_lit_stray`). Parentheses wrapping the whole literal are transparent
# (6.7.6). An annotated literal's elements take the annotation's types and the struct literal's
# checks (an integer into an f64 element keeps its bits, warned; a bool element takes a bool); an
# UN-annotated one is `(i64, .., i64)`, and a float element there is refused (ADR-002: an untyped
# float is an integer — the user's decision, 2026-10-09: declare the tuple's type). A struct, tuple,
# u128, vector or slice element is refused by name. The elements are evaluated and stored in order
# through ADDRESSED stores from the block's named slot (EMIT_STRUCT_FIELD_W; `_STRUCT_LIT_LOCAL`'s
# discipline: the span recorded before a byte is emitted, the name withheld until the elements are
# parsed, so `var t = (t.1, 1);` reads the OUTER t). An assignment, a field store and an argument
# build into a frame temp first, so `t = (t.1, t.0);` swaps. CHANGELOG [6.7.7]

# After a refused literal whose outermost wrap opens at `st`: the cursor past its `)`, and `term`
# consumed when it follows (0: left for the caller). 1.
fn _tup_lit_skip(S, st, term): i64 {
    STI(S, _call_close(S, st) + 1);
    if (term != 0) { if (PEEKT(S) == term) { STI(S, GTI(S) + 1); } }
    return 1;
}
# R2 and the arity, from the tokens of the literal whose `(` is `lp`: an empty element, a trailing
# comma and more than 256 elements are refused; for a type `sid` (> 0) the count must be its arity.
# Returns the count, or 0 after a refusal (reported).
fn _tup_lit_shape(S, lp, sid): i64 {
    var n = 0;
    var q = lp + 1;
    var go = 1;
    while (go == 1) {
        var t = TOKTYP(S, q);
        if (t == 31) { _tup_err(S, q, "an empty element in a tuple literal", 0 - 1, 0); return 0; }
        if (t == 11) { _tup_err(S, q - 1, "a trailing comma in a tuple literal", 0 - 1, 0); return 0; }
        n = n + 1;
        q = _arg_next(S, q);
        go = 0;
        if (TOKTYP(S, q) == 31) { q = q + 1; go = 1; }
    }
    if (n > 256) { _tup_err(S, lp, "a tuple literal has at most 256 elements", 0 - 1, 0); return 0; }
    if (sid <= 0) { return n; }
    if (n == GETFCOUNT(S, sid - 1)) { return n; }
    _tup_arity_err(S, lp, sid, n);
    return 0;
}
fn _tup_arity_err(S, ti, sid, n): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": tuple ");
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
    PRSTR(" has ");
    PRNUM(GETFCOUNT(S, sid - 1));
    PRSTR(" elements - this literal has ");
    PRNUM(n);
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 1;
}
# A bare name that is no i64 / f64 / bool value: 1 a vector, 2 a slice, 3 a u128 (a local's 2-slot
# pair, a 16-byte global); else 0. Lookups only (the factor resolved and reported the name).
fn _tup_wide_name(S, nm): i64 {
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, nm);
        if (li >= 0) {
            var lt = GLTYPE(S, li);
            if (lt <= 0 - 2048) { return 1; }
            if (lt != 0) { return 0; }
            if (GLSPAN(S, li) != 2) { return 0; }
            if (_slice_lw(S, li) > 0) { return 2; }
            return 3;
        }
    }
    var gv = _findvar_core(S, nm);
    if (gv < 0) { return 0; }
    if (GVVEC(S, gv) != 0) { return 1; }
    if (GVW128(S, gv) == 1) { return 3; }
    if (GVPM(S, gv) != 0) { return 0; }
    if (L64(_vars_base + gv * 8) == 16) { return 2; }
    return 0;
}
# R8 — the element just parsed (from token `t0`, its static struct `asid`) is a struct value (a heap
# handle — `Str`, `Result`, `Option`, `Tagged` — is a pointer, an i64), a u128, a vector or a slice:
# refused by name. (A whole tuple was refused at its factor, `_tup_rchk`, at the same token.)
fn _tup_elem_bad(S, t0, asid): i64 {
    if (asid > 0) {
        if (asid < 2048) {
            var nm = L64(S + 0x1A6018 + (asid - 1) * 8);
            var c = _classify_param_type(S, nm);
            if (c == 1 || c == 3 || c == 4 || c == 5) { return 0; }
            _tup_err(S, t0, "a tuple element is i64, f64 or bool, not struct ", nm, 0);
            return 1;
        }
    }
    var w = 0;
    if (_W128_IS(S) == 1) { w = 3; }
    if (w == 0) {
        if (TOKTYP(S, t0) == 2) { if (GTI(S) == t0 + 1) { w = _tup_wide_name(S, TOKVAL(S, t0)); } }
    }
    if (w != 1) { if (_vval_at(S, t0, GTI(S)) != 0) {   # 6.7.17 (D24): `((w), 3)`, `(*pv, 3)`
            w = 1;
            if (_vvl_arr == 1) { w = 4; }   # 6.7.17 (D103): `(wa, 3)` (an f64v2[1] read as a u128 pair before)
        } }
    if (w == 0) { return 0; }
    if (w == 1) { _tup_err(S, t0, "a tuple element is i64, f64 or bool, not a vector", 0 - 1, 0); }
    elif (w == 4) { _tup_err(S, t0, "a tuple element is i64, f64 or bool, not an array of vectors", 0 - 1, 0); }
    elif (w == 2) { _tup_err(S, t0, "a tuple element is i64, f64 or bool, not a slice", 0 - 1, 0); }
    else { _tup_err(S, t0, "a tuple element is i64, f64 or bool, not u128", 0 - 1, 0); }
    return 1;
}
# Element `k` of a literal of type `sid`, cursor on its first token: parsed (the value in rax) and
# judged — R8; un-annotated (`infer`), R7: a float is refused, its type must be declared; typed, the
# struct literal's field checks (`_ifs_bx`: an integer into f64 warned, a bool element a bool).
# An element is a one-slot store: a `: stack` pair there kept the tag and dropped the payload
# (`var t = (f(7), 3);`), so it is refused as at every other one (T5b; `f(7)?` consumes the pair).
fn _tup_elem_val(S, sid, k, infer): i64 {
    _refuse_lossy_pair(S);   # 6.7.7 (B4 review)
    var t0 = GTI(S);
    var asid = _expr_struct_sid(S, t0);
    # 6.7.13 (D2 (a), 2026-10-15): a whole dereference `*ps` of a `*S` is a struct value (6.7.10 decision 6),
    # refused by name as `(s, 1)` is, through the argument's arm (`_ess_deref`) — it stored S's first word.
    if (asid == 0) { asid = _ess_deref(S, t0); }
    if (_tup_elem_bad(S, t0, asid) == 1) { return 0; }
    if (infer == 1) {
        if (_UFV_IS_FLOAT(S) == 1) {
            _tup_err(S, t0, "a float element needs the tuple's type declared - an un-annotated tuple literal's elements are i64 (declare the tuple's type: `var t: (i64, f64) = ( .. );`)", 0 - 1, 0);
        }
        return 0;
    }
    _ifs_bx(S, _fk_bx(S, sid - 1, k), t0, _tup_fname(S, k));
    return 0;
}
# THE ELEMENT LOOP, shared by every position: the literal whose `(` is the cursor (its shape vetted,
# `_tup_lit_shape`) stored into tuple `sid` — frame slot `li` (>= 0: a local, a temp; field 0 is that
# slot) or global `gidx` (`li` -1). The cursor is left past its `)`.
fn _tup_elems(S, sid, gidx, li, infer): i64 {
    var sv = _sl_base_li;
    STI(S, GTI(S) + 1);   # consume (
    var n = GETFCOUNT(S, sid - 1);
    var k = 0;
    while (k < n) {
        _tup_elem_val(S, sid, k, infer);
        _sl_base_li = li;   # read by EMIT_STRUCT_FIELD_W: set after the element (a closure in it may declare its own)
        _sfw_have = 1;
        var st = _slit_tup;
        _slit_tup = 1;   # `_slit_sep` names a tuple literal
        EMIT_STRUCT_FIELD_W(S, gidx, k * 8, 8);   # consumes the `,` after the element
        _slit_tup = st;
        k = k + 1;
    }
    _sl_base_li = sv;
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    return 0;
}
# `var t[: T] = ( .. );` in a fn, cursor on the literal's own `(`: the block reserved with its span
# recorded and its name withheld, the elements stored, then the name.
fn _tup_lit_local(S, noff, sid, infer): i64 {
    var named = _tup_lres(S, noff, GETFCOUNT(S, sid - 1));
    if (named < 0) {
        STI(S, _call_close(S, GTI(S)) + 1);
        return 0;
    }
    _tup_elems(S, sid, 0, named, infer);
    _tup_lname(S, named, noff, sid);
    return 0;
}
# A tuple `var`'s block in a fn (a literal's, a capture's): the duplicate check, then `nslots` frame
# slots — the fillers, then the named slot, left ANONYMOUS (the initializer reads an outer name) with
# its span recorded BEFORE a byte is emitted (a coroutine frame). Returns the named slot; -1 past the
# per-fn slot budget (refused by name).
fn _tup_lres(S, noff, nslots): i64 {
    var existing = FINDLOCAL(S, noff);
    if (existing >= 0) { if (GLDEP(S, existing) == GSDEP(S)) { ERRDUPVAR(S); } }
    if (GFLC(S) + nslots + 1 >= 15360) {
        ERR_MSG(S, "struct literal exceeds the per-fn stack-slot budget; build it through alloc() instead", 85);
        return 0 - 1;
    }
    var k = 0;
    while (k < nslots - 1) {
        var fl = GFLC(S);
        S64(S + 0x5D9D000 + fl * 8, 0 - 1);
        SLDEP(S, fl, GSDEP(S));
        SLTYPE(S, fl, 0);
        SSLICE_W(S, fl, 0);
        SFLC(S, fl + 1);
        k = k + 1;
    }
    var named = GFLC(S);
    S64(S + 0x5D9D000 + named * 8, 0 - 1);   # anonymous until the initializer is parsed
    SLDEP(S, named, GSDEP(S));
    SLTYPE(S, named, 0);
    SSLICE_W(S, named, 0);
    SLAGG(S, named, nslots);                  # the span BEFORE a byte is emitted (a coroutine frame)
    SFLC(S, named + 1);
    return named;
}
# ... and its name and type, once the block is filled.
fn _tup_lname(S, named, noff, sid): i64 {
    S64(S + 0x5D9D000 + named * 8, noff);
    SLDEP(S, named, GSDEP(S));
    SLAGG(S, named, GETFCOUNT(S, sid - 1));
    SLTYPE(S, named, 0 - sid);
    return 0;
}
# A tuple global after the first statement, registered INLINE (8n bytes, the slot IS the tuple) at
# the next index, its count not yet bumped — so the name is not visible until the caller's SVCNT.
fn _tup_greg(S, noff, sid): i64 {
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, noff);
    S64(_vars_base + vcnt * 8, STRUCTSZ(S, sid - 1));
    SVTYPE(S, vcnt, sid);
    SVPM(S, vcnt, 2);
    return vcnt;
}
# ... a global after the first statement (PARSE_STRUCT_INIT's shape: inline, its name registered
# after the elements); `dti` the declaration's token, for its visibility.
fn _tup_lit_global(S, noff, sid, infer, dti): i64 {
    var vcnt = _tup_greg(S, noff, sid);
    _glit_hold(S, vcnt);   # 6.7.16: held while the elements are parsed (an element's hidden temporary)
    _tup_elems(S, sid, vcnt, 0 - 1, infer);
    SLVAR(S, vcnt);
    _GVAR_VIS(S, vcnt, dti);
    SVDEAD(S, vcnt, 0);
    return 0;
}
# PARSE_VAR's arm, where its `: stack` pair refusal stood (cursor on `=`): a literal initializer —
# the whole of it, up to the `;` — declares the tuple (1, the `;` consumed). Anything else is not
# this arm's: the pair refusal runs and PARSE_VAR goes on (0). `ann` is the annotation's first token
# (0: none), `pscale` PARSE_VAR's. A refused literal still lets the name be declared, so its later
# uses do not cascade: under a non-tuple annotation PARSE_VAR parses on (0; the literal's factor
# refusal is the one already reported, at the same token); a tuple-typed one whose literal has the
# wrong shape is skipped and declared as `var t: T;` is (0, cursor on the `;`).
fn _tup_var(S, noff, pscale, ann): i64 {
    if (_dyn_var(S, noff, pscale, ann) == 1) { return 1; }   # 6.7.8: U1/U2; (D5) a dyn formed in place
    if (PEEKT(S) == 4) {
        var lp = _tup_lit_at(S, GTI(S) + 1);
        if (lp >= 0) { if (TOKTYP(S, _pw_end) == 5) { return _tup_var_lit(S, noff, pscale, ann, lp); } }
        if (_tup_var_cap(S, noff, pscale) == 1) { return 1; }   # 6.7.7 (B4, T5): `var t: T = f();`
    }
    _refuse_single_pair_bind(S);
    return 0;
}
# A literal refused for its SHAPE (an empty element, a trailing comma, more than 256 elements, the
# wrong arity) still declares its name, so its later uses do not cascade ("undefined variable",
# "no struct type in scope"): as the annotation's tuple `sid`, else as the `(i64 x n)` its commas
# give (at most 256) — in a fn a local (its block reserved, nothing stored), at top level an inline
# global. A tuple-annotated local is PARSE_VAR's (`var t: T;`). CHANGELOG [6.7.11]
fn _tup_var_refd(S, noff, sid, lp, st): i64 {
    if (sid <= 0) {
        var n = _tup_commas(S, lp) + 1;
        if (n > 256) { n = 256; }
        sid = _tup_ints(S, n);
    }
    if (GINFN(S) == 1) {
        var named = _tup_lres(S, noff, GETFCOUNT(S, sid - 1));
        if (named >= 0) { _tup_lname(S, named, noff, sid); }
        return 0;
    }
    var vcnt = _tup_greg(S, noff, sid);
    _GVAR_VIS(S, vcnt, st);
    SVCNT(S, vcnt + 1);
    return 0;
}
fn _tup_var_lit(S, noff, pscale, ann, lp): i64 {
    var st = GTI(S) + 1;
    var sid = 0;
    var infer = 0;
    if (ann == 0) { infer = 1; }
    elif (pscale < 0) { if (pscale > 0 - 2048) { if (_tup_is(S, 0 - pscale) == 1) { sid = 0 - pscale; } } }
    if (infer == 0) {
        if (sid == 0) {   # R9: a scalar, struct, bool, slice, vector or pointer annotation
            _tup_r9(S, lp, noff, ann);   # 6.7.16: not after a refused annotation
            return 0;
        }
    }
    var n = _tup_lit_shape(S, lp, sid);
    if (n == 0) {
        if (infer == 0) { if (GINFN(S) == 1) { _tup_lit_skip(S, st, 0); return 0; } }
        _tup_var_refd(S, noff, sid, lp, st);   # 6.7.11: declared all the same
        return _tup_lit_skip(S, st, 5);
    }
    if (infer == 1) {
        _tup_gen_chk(S, lp);   # R4: an un-annotated literal mints its type, in a generic fn too
        sid = _tup_ints(S, n);
    }
    STI(S, lp);
    if (GINFN(S) == 1) { _tup_lit_local(S, noff, sid, infer); }
    else { _tup_lit_global(S, noff, sid, infer, st); }
    _pw_close(S, lp - st);
    _expect_step(S, 5);
    return 1;
}

# ⛔ 6.7.16 — R9 IS NOT SAID AFTER A REFUSED ANNOTATION: `var b: Nonexist = (1, 2);` (and `var b: 1 =`, `var b: =`, a
# refused late struct's `var b: Q =`, in a fn, the declaration zone and after the first statement) added "a tuple
# literal cannot initialize 'b' - its declared type is not a tuple" after the annotation's error — the refusal left
# no type (pscale / gps 0), which R9 read as a declared non-tuple. The literal at `lp` stands down, counted: its token
# is marked reported (`_tn_once`), so the factor's refusal of the literal PARSE_VAR parses on to stands down too, and
# the declaration is what the refused annotation left — a plain word whose uses the annotation's mark stands down.
# Annotation token `ann` (`_tup_ann_refd`). A type the annotation still names keeps R9: `var b: i64 =`, `var b: *Nope
# =` (a pointer), `var b: i64<u8> =` (i64; its type arguments refused). CHANGELOG [6.7.16]
fn _tup_r9(S, lp, noff, ann): i64 {
    if (_tup_ann_refd(S, ann) == 1) {
        _tn_once(S, lp);
        _had_error = 1;
        return 0;
    }
    _tup_err(S, lp, "a tuple literal cannot initialize ", noff, " - its declared type is not a tuple");
    _tp_refd_at = lp;   # 6.7.16: and a `*T` declaration's "assigning non-pointer to typed pointer" is not said about it
    return 0;
}
# 1 = the annotation whose first token is `ann` was refused and names no type: a name no type answers that was
# reported (`_tn_seen_at`) or that a refused declaration declared (`_dl_refd_at`), or a token that is no type at all
# (6.7.14's D15: a number, an operator; 6.7.15: a missing type, the `=` / `;`), reported there. A name that resolves
# (`i64` of a refused `i64<u8>`, a type parameter) and a `*` / `[` / `(` head are declared types. CHANGELOG [6.7.16]
fn _tup_ann_refd(S, ann): i64 {
    if (ann <= 0) { return 0; }
    var t = TOKTYP(S, ann);
    if (t == 8 || t == 28 || t == 10) { return 0; }
    if (t == 2) {
        if (_tn_resolve_at(S, ann) != 0) { return 0; }
        if (_dl_refd_at(S, TOKVAL(S, ann)) == 1) { return 1; }
    }
    return _tn_seen_at(S, ann);
}
# ⛔ 6.7.7 (B4, T5) — THE BRIDGE: A TUPLE CAPTURES A MULTI-VALUE CALL BY ITS TYPE (the user's decision,
# 2026-10-08): `var t: (i64, f64) = f();`, `t = f();` into an existing tuple (a for step too), `G =
# f();` at top level and the declaration zone's `var G: T = f();`. It takes the right-hand sides the
# destructure `var a, b = f();` takes: ONE whole call — `f(`, `g<..>(` or `x.m(` — ending at the
# terminator, reaching a declared `: (T1, T2[, T3])` fn (its arity and each element's CLASS checked
# against the tuple's: an f64 element takes an f64 value, a bool element a declared bool, an i64
# element any integer-class value, a bool included), an undeclared `return (a, b)` / `ret2` fn, a
# `: stack` pair, a Result / Option / Tagged pair or a `: f64` fn (every element f64) — those
# unchecked, as the destructure leaves them, except that a bool element needs a declared bool. A
# struct- or vector-returning callee is refused by name (it is no tuple), as are more than 3
# elements (the return registers). A provably one-value callee, a wrapped `(f())`, `f()?`, `callptr`
# and any other value are no capture: the tuple's "not a tuple" refusal (R12). Nothing that compiled
# changes: each of these was refused (R12) or, for a `: stack` pair, "bind both". CHANGELOG [6.7.7]
# A tuple's element `k` by class: 1 f64, 3 bool, 0 i64.
fn _tup_ek(S, sid, k): i64 {
    if (GFBOOL(S, sid - 1, k) == 1) { return 3; }
    if (GFFK(S, sid - 1, k) == 1) { return 1; }
    return 0;
}
# Element `k` of multi-value fn `fi`'s declared return, by class: 1 f64, 3 bool, 0 an integer-class
# value (i8..i64, `*T`, cstring, a `Str` / Result / Option / Tagged handle), 9 a struct value or a
# vector (no tuple element holds one).
fn _mret_ek(S, fi, k): i64 {
    if ((GFLG(S, fi) & (8192 << k)) != 0) { return 3; }
    var c = GFRT(S, fi, k);
    if (c == 0 - 9) { return 1; }
    if (c <= 0 - 2048) { return 9; }
    if (c > 0) {
        var cl = _classify_param_type(S, L64(S + 0x1A6018 + (c - 1) * 8));
        if (cl == 1 || cl == 3 || cl == 4 || cl == 5) { return 0; }
        return 9;
    }
    return 0;
}
# Prints fn `fi`'s declared values by class, `(i64, f64)` (a struct element by its name).
fn _mret_spell(S, fi): i64 {
    PRSTR("(");
    var n = GFRN(S, fi);
    var k = 0;
    while (k < n) {
        if (k > 0) { PRSTR(", "); }
        var e = _mret_ek(S, fi, k);
        if (e == 1) { PRSTR("f64"); }
        elif (e == 3) { PRSTR("bool"); }
        elif (e == 0) { PRSTR("i64"); }
        elif (GFRT(S, fi, k) > 0) { PRSTR(S + 0xEC00000 + _fsn_one(S, GFRT(S, fi, k))); }   # 6.7.16: `Box<Pt>`, not `Box$Pt`
        else { PRSTR("a vector"); }
        k = k + 1;
    }
    PRSTR(")");
    return 0;
}
# 1 = fn `fi` provably returns ONE value — the destructure's one-value test (`_dt_arity_check`): pass
# 1's GFLG bit 1024, unless the fn declares several or returns a `: stack` / Result / Option / Tagged
# pair, which carry a second word.
fn _tup_cap_single(S, fi): i64 {
    var fl = GFLG(S, fi);
    if ((fl & 1024) == 0) { return 0; }
    if ((fl & 256) != 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs == MULTIRET_SID) { return 0; }
    if (rs <= 0 - 16) { if (rs >= 0 - 18) { return 0; } }
    return 1;
}
# THE CAPTURE'S CONTRACT, cursor on the right-hand side of a value of tuple `sid`, which ends at
# `term`: 0 = no capture (not one whole call, or a provably one-value callee — the caller's R12;
# cursor kept); 1 = a capture (the call is the cursor's); 2 = a refused one, reported and the call
# skipped (cursor on `term`), so the caller still declares / leaves the tuple and the parse goes on.
# 6.7.14 (D45): the call may sit inside parentheses that wrap the whole value (`_dt_wrap_k`): for a
# capture the cursor is stepped onto it and `_tcap_k` holds the k `)` the caller closes (`_pw_close`)
# once the call is parsed — read right after this returns, before anything is parsed. CHANGELOG [6.7.14]
var _tcap_k = 0;
fn _tup_cap_check(S, sid, term): i64 {
    _tcap_k = 0;
    var k = _dt_wrap_in(S, term);
    var r = _tup_cap_in(S, sid, _dt_wterm(k, term));
    if (r == 0) { STI(S, GTI(S) - k); }   # cursor kept: on the wrap's first `(`
    elif (r == 2) { STI(S, GTI(S) + k); }   # past the wrap's `)`s, on `term`
    else { _tcap_k = k; }
    return r;
}
fn _tup_cap_in(S, sid, term): i64 {
    var o = _dt_call_open_cp(S);   # 6.7.14: `callptr(..)` too. CHANGELOG [6.7.14]
    if (o < 0) { return 0; }
    var e = _call_close(S, o) + 1;
    if (TOKTYP(S, e) != term) { return 0; }
    var fi = _dt_call_fn(S);
    var r = 2;   # 6.7.7 (T6): resolving the callee refused it (R4, `id(t)`): the tuple kept, the call skipped
    if (_panic == 0) { r = _tup_cap_class(S, sid, fi); }
    if (r == 2) { STI(S, e); }
    return r;
}
fn _tup_cap_class(S, sid, fi): i64 {
    var rs = 0;
    if (fi >= 0) { rs = GFRS(S, fi); }
    if (rs > 0) { return _tup_cap_err(S, sid, fi, 2, 0); }
    if (rs <= 0 - 2048) { return _tup_cap_err(S, sid, fi, 3, 0); }
    if (fi >= 0) { if (_tup_cap_single(S, fi) == 1) { return 0; } }
    var n = GETFCOUNT(S, sid - 1);
    if (n > 3) { return _tup_cap_err(S, sid, fi, 1, 0); }
    if (rs == MULTIRET_SID) { if (GFRN(S, fi) != n) { return _tup_cap_err(S, sid, fi, 4, 0); } }
    var ar = 0;   # 6.7.11: an undeclared callee's provable count, as the destructure checks it
    if (fi >= 0) { ar = _fn_ret_arity(S, fi); }
    if (ar != 0) { if (ar != n) { return _tup_cap_err(S, sid, fi, 7, ar); } }
    var k = 0;
    while (k < n) {
        var c = _tup_cap_elem(S, sid, fi, rs, k);
        if (c != 0) { return _tup_cap_err(S, sid, fi, c, k); }
        k = k + 1;
    }
    return 1;
}
# Element `k`'s agreement: 0, or the refusal's kind (`_tup_cap_err`).
fn _tup_cap_elem(S, sid, fi, rs, k): i64 {
    var te = _tup_ek(S, sid, k);
    if (rs == MULTIRET_SID) {
        var fe = _mret_ek(S, fi, k);
        if (fe == te) { return 0; }
        if (te == 0) { if (fe == 3) { return 0; } }
        return 4;
    }
    if (rs == 0 - 9) {
        if (te == 1) { return 0; }
        return 5;
    }
    if (te == 3) { return 6; }
    return 0;
}
# A refused capture (cursor on its right-hand side), once per token, in sync. Returns 2. `sid` 0: the
# callee of a multi-value assignment `a, b = f();` (`_masg_callee`; kinds 2 and 3).
fn _tup_cap_err(S, sid, fi, kind, k): i64 {
    if (_syntax_only == 1) { return 2; }
    if (_panic == 1) { return 2; }
    var st = GTI(S);
    if (sid != 0) { if (_vrcv_annbad(S, st) == 1) { return 2; } }   # 6.7.16: a refused annotation's one error
    if (_tn_once(S, st) == 0) { return 2; }
    var ct = st;
    if (_mcall_open(S, st, 0 - 1) >= 0) { ct = _mco_mt; }   # 6.7.15: `x.m<..>(` names m too; 6.7.16: a chain's
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    var w = "a tuple";
    if (sid == 0) {
        w = "multiple values";
        PRSTR(": cannot re-assign from '");
        _tcap_callee_pr(S, ct);
        PRSTR("'");
    } else {
        PRSTR(": cannot capture '");
        _tcap_callee_pr(S, ct);
        PRSTR("' into tuple ");
        PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
    }
    if (kind == 1) { PRSTR(" - a call returns at most 3 values (its return registers)"); }
    elif (kind == 2) {
        PRSTR(" - it returns struct '");
        PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (GFRS(S, fi) - 1) * 8));
        PRSTR("', not ");
        PRSTR(w);
    }
    elif (kind == 3) {
        PRSTR(" - it returns a vector, not ");
        PRSTR(w);
    }
    elif (kind == 4) {
        PRSTR(" - it returns ");
        PRNUM(GFRN(S, fi));
        PRSTR(" values, ");
        _mret_spell(S, fi);
    }
    elif (kind == 5) { PRSTR(" - it is declared `: f64`, so every value it returns is an f64"); }
    elif (kind == 7) {   # 6.7.11: an undeclared callee's count (`_fn_ret_arity`), `k`
        PRSTR(" - it returns ");
        PRNUM(k);
        PRSTR(" values");
    }
    else {
        PRSTR(" - element ");
        PRNUM(k);
        PRSTR(" is a bool, and the call does not declare that value bool");
    }
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    return 2;
}
# The capture's callee as written: its name, or `callptr` (6.7.14: a builtin token, no name).
fn _tcap_callee_pr(S, ct): i64 {
    if (TOKTYP(S, ct) == 137) { PRSTR("callptr"); return 0; }
    PRSTR(S + 0xEC00000 + TOKVAL(S, ct));
    return 0;
}
# THE DRAIN, right after the call (its first value in rax): every value pushed BEFORE any store — rax,
# rdx, then r3 for a third (`EMOVRA_RDX` leaves r3 intact) — so nothing clobbers rdx / r3 first.
fn _tup_drain_push(S, n): i64 {
    EPUSHR(S);
    EMOVRA_RDX(S);
    EPUSHR(S);
    if (n == 3) {
        EMOVRA_R3(S);
        EPUSHR(S);
    }
    return 0;
}
# ... then popped into tuple `sid`'s slots, the last first, through ADDRESSED stores (the regalloc
# picker never sees an EFLSTORE of an aggregate slot): `idx` a frame slot as
# `_resolve_field_base_addr` takes it (`0 - 2 - li`), or a global (>= 0).
fn _tup_drain_store(S, n, idx, sid): i64 {
    var k = n - 1;
    while (k >= 0) {
        _IR_REC0(S, IR_RAW_EMIT);
        _resolve_field_base_addr(S, idx, sid);
        if (k > 0) { EADDIMM_X1(S, k * 8); }
        EPOPR(S);
        ESTOC(S);
        k = k - 1;
    }
    return 0;
}
# PARSE_VAR's capture arm (cursor on `=`), after the literal's: `var t: T = f();` — 1 = declared (the
# `;` consumed), 0 = no capture (cursor kept). In a fn the block is reserved with its span before the
# call is parsed and named after its values are stored (an argument reads an OUTER `t`); a global
# after the first statement is registered after the call, inline.
fn _tup_var_cap(S, noff, pscale): i64 {
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    var sid = 0 - pscale;
    if (_tup_is(S, sid) == 0) { return 0; }
    var dti = GTI(S);
    STI(S, dti + 1);   # `=`
    var c = _tup_cap_check(S, sid, 5);
    if (c == 0) {
        STI(S, dti);
        return 0;
    }
    var k = _tcap_k;
    if (GINFN(S) == 1) { _tup_cap_local(S, noff, sid, c); }
    else { _tup_cap_global(S, noff, sid, c, dti); }
    _pw_close(S, k);   # 6.7.14 (D45): `= (two(3));`
    _expect_step(S, 5);
    return 1;
}
fn _tup_cap_local(S, noff, sid, c): i64 {
    var n = GETFCOUNT(S, sid - 1);
    var named = _tup_lres(S, noff, n);
    if (named < 0) {
        _masg_skip(S);
        return 0;
    }
    if (c == 1) {
        PCMPE(S);
        _tup_drain_push(S, n);
        _tup_drain_store(S, n, 0 - 2 - named, sid);
    }
    _tup_lname(S, named, noff, sid);
    return 0;
}
fn _tup_cap_global(S, noff, sid, c, dti): i64 {
    var n = GETFCOUNT(S, sid - 1);
    if (c == 1) {
        PCMPE(S);
        _tup_drain_push(S, n);
    }
    var vcnt = _tup_greg(S, noff, sid);   # after the call: a registration inside it takes its own index
    SVCNT(S, vcnt + 1);
    if (c == 1) { _tup_drain_store(S, n, vcnt, sid); }
    SLVAR(S, vcnt);
    _GVAR_VIS(S, vcnt, dti);
    return 0;
}
# The declaration zone's replay (EMIT_GVAR_INITS, cursor on the right-hand side): `var G: T = f();`,
# registered inline by pass 1 for a whole call (`_tup_gci`). 1 = done (the `;` consumed); 0 = not a
# whole call (the replay goes on: a named tuple or field source, or a value pass 1 refused). A whole
# call that is no capture (a one-value callee) is refused here — pass 1 could not know its callee.
fn _gvi_tup_cap(S, gi, idx, gps, sti, noff): i64 {
    if (gps >= 0) { return 0; }
    if (gps <= 0 - 2048) { return 0; }
    var sid = 0 - gps;
    if (_tup_is(S, sid) == 0) { return 0; }
    if (_tup_gci_call(S, sid) < 0) { return 0; }
    var c = _tup_cap_check(S, sid, 5);
    if (c == 0) {
        _tup_err(S, sti + 3, "cannot initialize tuple ", noff, " with a value that is not a tuple");
        _masg_skip(S);
    } elif (c == 1) {
        var k = _tcap_k;
        PCMPE(S);
        _pw_close(S, k);   # 6.7.14 (D45)
        if (idx >= 0) {
            var n = GETFCOUNT(S, sid - 1);
            _tup_drain_push(S, n);
            _tup_drain_store(S, n, idx, sid);
            _gv_slvar(S, idx);
        }
    }
    _gvk_left(S, gi, sti, idx);   # a `kernel;` build names what stays late
    _expect_step(S, 5);
    return 1;
}

# 6.6.13 (M2): `eb` is the bytes per element (_arr_ebytes), 0 for a bare `var g[N]`.
fn PARSE_GVAR_ARR(S, noff, sti, ew, sgn, eb): i64 {
    STI(S, GTI(S) + 1);
    # v5.10.48: top-level array-size NUM-or-enum-const-ident — same
    # rule as the in-fn PARSE_ARRAY above. Closes the var-bracket
    # parser-cosmetic-limit at top-level too. Without this mirror
    # fix, `enum Sz { N = 16; } var buf[N];` at top level still
    # errored even after the in-fn fix landed.
    var sz_raw = 0;
    var gs_ti = GTI(S);                  # 6.7.15: the size, refused in sync (`_ce_ctx_close` below)
    var gs_pw = _ce_ctx_open(0 - 1);
    if (PEEKT(S) == 1 && TOKTYP(S, GTI(S) + 1) == 29) {
        sz_raw = PEEKV(S);
        STI(S, GTI(S) + 1);
    } else {
        # 6.7.2 (B1, C1): a CONST CONTEXT — any integer const expression (as the in-fn site).
        sz_raw = _ce_eval_int(S, "an array size must be an integer");
        if (_ce_err == 0) { if (sz_raw < 0) { ERR_MSG(S, "array size must not be negative", 31); } }
    }
    # v6.2.1: element-typed top-level array `var g: T[N]` reserves
    # N * sizeof(T) bytes. `ew` is the element width from the `: T`
    # annotation (ann_scalar). ew==0 is the bare `var g[N]` form —
    # keep the legacy N-i64-SLOTS top-level convention (ew=8). So
    # `var g: u8[N]` = N bytes, `var g: i64[N]` = 8N, bare = 8N.
    # The byte-list `= {..}` cap below stays in bytes (= sz).
    # 6.6.13 (M2): the size multiplies by `eb`, not the integer descriptor `ew` — an f32 / struct
    # / vector element was 8 bytes (`Pt[2]` 16 of 32, `i8v16[2]` 8 of 32). The 8-byte floor stays.
    var ar_ew = eb;
    if (ar_ew < 1) { ar_ew = 8; }
    # The integer descriptor stands only for an element of exactly that width: a vector element
    # the prefix ladder read as its leading scalar (`i8v16` as i8) has none, so `g[i]` is refused.
    if (eb != ew) { ew = 0; sgn = 0; }
    sz_raw = _arr_size_ok(S, sz_raw, ar_ew);
    _ce_ctx_close(S, gs_ti, gs_pw, 29, 29, 29);
    var sz = sz_raw * ar_ew;
    if (sz < 8) { sz = 8; }
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);
    var vc0 = GVCNT(S);
    S64(_varn_base + vc0 * 8, noff);
    S64(_vars_base + vc0 * 8, sz);
    SVSGN(S, vc0, _arr_gsgn(S, ew, sgn, eb, _gai_ann(S, sti), sz_raw));   # 6.6.12: before the fold, so a redeclaration compares it; 6.7.6: + the typed mark; 6.7.8: + the kind, N
    var vc = _gv_fold(S, vc0, sti);   # 6.6.6: a redeclaration reuses the global's slot
    _gav_set(S, vc, _gai_ann(S, sti));   # 6.7.17 (D103): an array of vectors
    SLVAR(S, vc);
    # v6.6.4: stamp visibility here too. PARSE_GVAR_REG returns into this fn BEFORE its
    # own `_GVAR_VIS` (whose comment claims to be "the one point EVERY global var
    # reaches"), so a top-level array in a `private` file was never private — readable
    # and addressable from any file — and a `public var arr[N]` never CONSUMED the
    # marker, re-exposing the next declaration instead.
    _GVAR_VIS(S, vc, sti);
    if (vc == vc0) { SVCNT(S, vc0 + 1); }
    # v5.11.51: the optional initializer `var foo[N] = { .. };` (issue 2026-05-13-gnoboot-byte-
    # array-literal.md). Pass 1 checks the element type and the count and registers the deferred
    # entry; the replay evaluates it into the slot's image blob. ⛔ 6.6.16 (C1): it was a BYTE list
    # whatever the element type, stored at run time — see "Global array initializers" above.
    # CHANGELOG [6.6.16]
    if (PEEKT(S) == 4) {
        STI(S, GTI(S) + 1);
        _gai_decl(S, _gai_ann(S, sti), sz_raw, sz);
        if (vc != vc0) { _gv_supersede(S, noff, 1); }   # 6.6.16: a list is the value from start
        _gv_defer(S, sti, vc + 1);   # 6.6.6: vc + 1 = the slot this entry declared
    }
    _expect_step(S, 5);
    return 0;
}

# Register a global var in declaration zone (no codegen, deferred init)
# ================================================================
# Module-scope initializer constant folder (v6.4.74)
# ================================================================
# WHY THIS EXISTS. v5.11.64 added a static-init path so a module-scope
# `var X = <non-zero NUM> ;` is pre-written into the var area at FIXUP time and
# is therefore correct on FIRST READ. It deliberately recognised ONLY a bare
# integer literal ("Conservative on purpose"), and everything else — `-5`,
# `0 - 61`, `512 * 2`, `1 << 4` — fell through to the deferred runtime-store
# path in EMIT_GVAR_INITS.
#
# In kmode (`_init_km == 1`) on the x86_64 ELF fork ONLY, main.cyr emits
# PARSE_PROG FIRST and EMIT_GVAR_INITS AFTER it (the v5.7.19 multiboot
# invariant: top-level asm must run before 64-bit gvar inits — agnos depends on
# this and the filing explicitly asks us NOT to change the order). agnos's
# top-level program IS the whole boot and ends in `arch_halt()`, so it never
# returns and that deferred block is DEAD CODE. Result: every computed
# module-scope initializer read as 0 for the life of the kernel, with no
# warning and no error — it built clean, formatted clean, and produced a 4/4
# PASS selftest that was comparing 0 against 0.
#
# The fix is to widen what counts as statically-initialisable, so foldable
# expressions get baked into the image exactly like plain literals. No ordering
# change, no risk to the multiboot invariant.
# (issues/archived/2026-07-23-cyrius-module-scope-var-expr-initializer-zero.md)
#
# PRECEDENCE IS LOAD-BEARING AND IS *NOT* C's. This folder must agree with
# PEXPR/PARSE_TERM exactly, or it would bake in a different value than the
# runtime path computes — the same silent-wrong-value class we are fixing.
# Verified empirically against the running compiler at 6.4.73:
#   PARSE_TERM tier (binds tighter): *  /  %  <<  >>  >>>     (8 9 34 38 39 152)
#   PEXPR tier:                      +  -  &  |  ^            (6 7 27 35 36)
# so `&`, `|`, `^` sit at the SAME precedence as `+`/`-`, left-associative —
# NOT C, where they bind looser. Probes: `1 | 2 + 1` == 4 (i.e. `(1|2)+1`, not
# `1|(2+1)` == 3) and `5 & 3 + 1` == 2. Both tiers are left-associative
# (`100 - 10 - 5` == 85).
#
# Shift semantics mostly come free: this folder is itself written in cyrius and
# compiled by cycc, so its `<<` / `>>` are the same shifts the emitted code
# uses, with the same backend count-masking — self-consistent by construction
# rather than by a second implementation of the rules. The ONE exception is
# `>>>`, which cybs cannot lex; see _CF_ASR below for why and how.
#
# CONSERVATISM: any construct that is not a pure integer-literal expression
# (an identifier, a call, a string, a float) clears `_cf_ok` and the caller
# falls straight back to today's runtime-store path. Division/modulo by zero
# also bails rather than folding, so the runtime keeps whatever trap behaviour
# it has today. The one exception is a -1 divisor: it FOLDS, as the wrapping
# negation for `/` and 0 for `%`, so INT_MIN / -1 bakes INT_MIN where a runtime
# idiv on the same operands would trap (CHANGELOG [6.6.20]). `_CF_TRY`
# additionally requires the fold to land EXACTLY on the terminating `;`, which
# makes a partial fold impossible.
var _cf_ok = 0;
var _cf_ti = 0;
var _cf_enum = 0;   # 6.6.16 (C1): 1 = enum constants fold (see _CF_ENUM)

# Arithmetic (sign-propagating) right shift, spelled WITHOUT the `>>>` operator.
#
# THE SEED CEILING, NOT A STYLE CHOICE: the first cut of this folder wrote the
# obvious `v >>> _CF_FACTOR(S)` and self-hosted + fixpointed cleanly on
# build/cycc — then `seed-derive-cycc.sh` failed at step [3/5] with a bare
# `syntax error`. **cybs cannot lex `>>>`**: its lexer (bootstrap/cybs.cyr
# `lexer_shr`) knows only `>` / `>=` / `>>` (token 39) and has no three-char
# form, so it tokenised `>>` `>` and the parse died. `build/cycc` compiled it
# happily, which is precisely why the cycc fixpoint does NOT substitute for the
# seed gate. See CLAUDE.md's Release Gate item 2.
#
# Semantics verified empirically against the running compiler rather than taken
# from the doc: `((0-16) >> 2) >> 56` == 63 (zero-filled ⇒ `>>` is LOGICAL) and
# `((0-16) >>> 2) >> 56` == 255 (sign-filled ⇒ `>>>` is ARITHMETIC) — the
# reverse of JS/Java, as CLAUDE.md warns.
#
# The `& 63` matches the backend: x86 `sar r64, cl` masks the count to 6 bits,
# so `v >>> 64` is `v`, not 0/-1. With sh in 1..63, `64 - sh` is 1..63 and the
# mask shift is always in range.
fn _CF_ASR(v, n): i64 {
    var sh = n & 63;
    if (sh == 0) { return v; }
    var r = v >> sh;
    if (v < 0) { r = r | ((0 - 1) << (64 - sh)); }
    return r;
}

fn _CF_FACTOR(S): i64 {
    var t = TOKTYP(S, _cf_ti);
    if (t == 1) { var v = TOKVAL(S, _cf_ti); _cf_ti = _cf_ti + 1; return v; }
    if (t == 7) { _cf_ti = _cf_ti + 1; return 0 - _CF_FACTOR(S); }
    if (t == 169) { _cf_ti = _cf_ti + 1; return 1; }   # true (6.7.3) — `!` is not folded
    if (t == 170) { _cf_ti = _cf_ti + 1; return 0; }   # false
    if (t == 10) {
        _cf_ti = _cf_ti + 1;
        var pv = _CF_EXPR(S);
        if (_cf_ok == 0) { return 0; }
        if (TOKTYP(S, _cf_ti) != 11) { _cf_ok = 0; return 0; }
        _cf_ti = _cf_ti + 1;
        return pv;
    }
    if (t == 2) { if (_cf_enum == 1) { return _CF_ENUM(S); } }
    if (t == 15) { if (_cf_enum == 1) { return _CF_IFX(S); } }   # 6.7.4: a constant-condition if-expression
    _cf_ok = 0;
    return 0;
}

# 6.7.4 (B3) — an if-expression, where the folder's enum arm is on (a kernel build's static bake, a
# baked struct literal): every condition a folder expression with at most one comparison, every arm a
# folder expression, `else` present — anything else is `_cf_ok = 0`, QUIET, and the runtime store
# the replay emits stays the value (it runs only the taken arm; the folder walks them all, so an
# untaken `1 / 0` just declines to fold). CHANGELOG [6.7.4]
fn _CF_IFX(S): i64 {
    _cf_ti = _cf_ti + 1;
    var done = 0;
    var res = 0;
    var go = 1;
    while (go == 1) {
        if (_CF_TOK(S, 10) == 0) { return 0; }
        var c = _CF_COND(S);
        if (_CF_TOK(S, 11) == 0) { return 0; }
        var v = _CF_ARMV(S);
        if (_cf_ok == 0) { return 0; }
        if (done == 0) { if (c != 0) { res = v; done = 1; } }
        var t = TOKTYP(S, _cf_ti);
        if (t == 50) { _cf_ti = _cf_ti + 1; }
        elif (t == 23) {
            _cf_ti = _cf_ti + 1;
            var e = _CF_ARMV(S);
            if (_cf_ok == 0) { return 0; }
            if (done == 0) { res = e; }
            return res;
        } else { _cf_ok = 0; return 0; }
    }
    return res;
}
fn _CF_TOK(S, t): i64 {
    if (_cf_ok == 0) { return 0; }
    if (TOKTYP(S, _cf_ti) != t) { _cf_ok = 0; return 0; }
    _cf_ti = _cf_ti + 1;
    return 1;
}
fn _CF_ARMV(S): i64 {
    if (_CF_TOK(S, 13) == 0) { return 0; }
    var v = _CF_EXPR(S);
    if (_CF_TOK(S, 14) == 0) { return 0; }
    return v;
}
fn _CF_COND(S): i64 {
    var a = _CF_EXPR(S);
    if (_cf_ok == 0) { return 0; }
    var op = TOKTYP(S, _cf_ti);
    if (op < 17 || op > 22) { return a; }
    _cf_ti = _cf_ti + 1;
    var b = _CF_EXPR(S);
    if (op == 17) { if (a == b) { return 1; } return 0; }
    if (op == 18) { if (a != b) { return 1; } return 0; }
    if (op == 19) { if (a < b) { return 1; } return 0; }
    if (op == 20) { if (a > b) { return 1; } return 0; }
    if (op == 21) { if (a <= b) { return 1; } return 0; }
    if (a >= b) { return 1; }
    return 0;
}

# ⛔ 6.6.16 (C1) — THE ENUM ARM, ON ONLY WHERE NAMES RESOLVE AS THE RUNTIME DOES. An enum constant
# (`A`, `E.A`) folds to its value when `_cf_enum == 1`, which only an evaluation at the REPLAY or
# after the first top-level statement sets: by then every name is registered, so a forward enum and
# a later global that shadows the name resolve exactly as a runtime read of them would. Pass 1's
# call (PARSE_GVAR_REG) leaves it 0 — there it would miss a forward enum and fold 3 where the program
# reads a shadowing `var A = 9;` as 9. QUIET: no error, no cursor move; a name it cannot fold clears
# `_cf_ok` and the caller reports (a qualified base that is a variable is a field access). An enum
# constant carries no `private` stamp (PARSE_ENUM_DEF sets none), so a fold has no visibility to
# check. The value is the raw i64 (_vecv_base, the presence flag in GVECP). CHANGELOG [6.6.16]
fn _CF_ENUM(S): i64 {
    var ti = _cf_ti;
    var vi = 0 - 1;
    if (TOKTYP(S, ti + 1) == 41) {
        if (TOKTYP(S, ti + 2) != 2) { _cf_ok = 0; return 0; }
        if (_findvar_core(S, TOKVAL(S, ti)) >= 0) { _cf_ok = 0; return 0; }
        vi = _enum_variant_in(S, TOKVAL(S, ti), TOKVAL(S, ti + 2));
        ti = ti + 2;
    } else {
        vi = _findvar_core(S, TOKVAL(S, ti));
    }
    if (GVECP(S, vi) != 1) { _cf_ok = 0; return 0; }
    _cf_ti = ti + 1;
    return L64(_vecv_base + vi * 8);
}

fn _CF_TERM(S): i64 {
    var v = _CF_FACTOR(S);
    var go = 1;
    while (go == 1) {
        if (_cf_ok == 0) { return 0; }
        var t = TOKTYP(S, _cf_ti);
        if (t == 8) { _cf_ti = _cf_ti + 1; v = v * _CF_FACTOR(S); }
        elif (t == 9) {
            _cf_ti = _cf_ti + 1;
            var d = _CF_FACTOR(S);
            if (d == 0) { _cf_ok = 0; return 0; }
            # A -1 divisor folds as the wrapping negation: idiv traps (SIGFPE) on INT_MIN / -1 and
            # took the compiler down; for every other value it is the same quotient. CHANGELOG [6.6.20]
            if (d == 0 - 1) { v = 0 - v; }
            else { v = v / d; }
        }
        elif (t == 34) {
            _cf_ti = _cf_ti + 1;
            var m = _CF_FACTOR(S);
            if (m == 0) { _cf_ok = 0; return 0; }
            if (m == 0 - 1) { v = 0; }
            else { v = v % m; }
        }
        elif (t == 38) { _cf_ti = _cf_ti + 1; v = v << _CF_FACTOR(S); }
        elif (t == 39) { _cf_ti = _cf_ti + 1; v = v >> _CF_FACTOR(S); }
        elif (t == 152) { _cf_ti = _cf_ti + 1; v = _CF_ASR(v, _CF_FACTOR(S)); }
        else { go = 0; }
    }
    return v;
}

fn _CF_EXPR(S): i64 {
    var v = _CF_TERM(S);
    var go = 1;
    while (go == 1) {
        if (_cf_ok == 0) { return 0; }
        var t = TOKTYP(S, _cf_ti);
        if (t == 6) { _cf_ti = _cf_ti + 1; v = v + _CF_TERM(S); }
        elif (t == 7) { _cf_ti = _cf_ti + 1; v = v - _CF_TERM(S); }
        elif (t == 27) { _cf_ti = _cf_ti + 1; v = v & _CF_TERM(S); }
        elif (t == 35) { _cf_ti = _cf_ti + 1; v = v | _CF_TERM(S); }
        elif (t == 36) { _cf_ti = _cf_ti + 1; v = v ^ _CF_TERM(S); }
        else { go = 0; }
    }
    return v;
}

# Fold the initializer expression starting at token `ti`. On success sets
# _cf_ok = 1 and returns the value; on ANY doubt sets _cf_ok = 0 and the caller
# keeps today's behaviour. Requires the expression to end exactly on its
# terminator so a partially-consumed initializer can never be mistaken for a
# folded one: `term` 5 is a declaration's `;`, 31 an array element's `,` or `}`
# (6.6.16). On success `_cf_ti` is the terminator's token.
fn _CF_TRY(S, ti, term): i64 {
    _cf_ok = 1;
    _cf_ti = ti;
    var v = _CF_EXPR(S);
    if (_cf_ok == 0) { return 0; }
    var t = TOKTYP(S, _cf_ti);
    if (t == term) { return v; }
    if (term == 31) { if (t == 14) { return v; } }
    _cf_ok = 0;
    return 0;
}

# ================================================================
# Global array initializers (6.6.16, C1)
# ================================================================
# ⛔ WHY. `var X: T[N] = { .. }` meant BYTES whatever T was: the list went into the first bytes
# of the array one byte per element, so `var T: i64[3] = {1, 2, 42};` read T[0] = 0x2A0201 and
# T[1] = T[2] = 0, on every target (an i8 list read right only because its element IS a byte).
# A value over 255 was "byte-array literal value must be in [0, 255]", `-3` and `1.5` were
# syntax errors, an enum constant was "expected number", and `Pt[2]` / `i8v16[2]` / `bool[2]`
# lists compiled silently as bytes. The element type sized the array and was never consulted
# again. And the list was STORED AT RUN TIME by the deferred replay, which a `kernel;` build runs
# after the top-level program — so in a kernel that never returns every array literal read 0.
#
# NOW. `var X: T[N] = { .. }` is N elements of T, baked into the image:
#   * Pass 1 (PARSE_GVAR_ARR) checks the element type — refused BY NAME where a list of
#     constants cannot fill it — and the element count, and records the deferred entry. It does
#     NOT evaluate: an element may name an enum declared further down.
#   * The replay (EMIT_GVAR_INITS -> _gai_replay) evaluates each element with the constant folder,
#     its enum arm on (_CF_ENUM), into the slot's blob (_vgai_base, util.cyr). Names resolve there
#     exactly as a runtime read of them would.
#   * Every target copies the blob into the var area (_gai_bake, from _EMIT_GVAR_STATIC_INITS,
#     and main_cx.cyr's var-data write: a .cyx carries its var data too) and emits NO code.
#   * The same declaration after the first top-level statement (PARSE_ARRAY) is evaluated at once
#     — at true module scope only (_gai_stmt): a global's meaning does not depend on where it is.
# Values: an integer element takes -2^(8w-1) .. 2^(8w)-1 (so `0xFF` into i8 and `-1` into u8 are
# bit patterns, while a value that would be TRUNCATED is refused); i64 / u64 / bool / an enum /
# `*T` take any i64; the bare byte list keeps [0, 255]; u128 is the value in its low 8 bytes; f64
# is a float literal's bits; f32 the literal narrowed to binary32, round-to-nearest-even
# (_gai_f32). An integer in an f64 / f32 element keeps its bits, with the warning a scalar gives.
# CHANGELOG [6.6.16]
var _gai_w = 0;        # the element bytes _gai_kind found
var _gai_isbool = 0;   # 6.7.3 / 6.7.4: the list being evaluated fills a `bool[N]` (each element a bool)
var _gai_ok = 0;       # _gai_val: 1 = the element is a constant
var _pp_depth = 0;     # PARSE_PROG nesting: 1 = module scope (see _gai_stmt)

# A leading-block declaration at `sti` (its `var`): the annotation's type token, 0 for a bare
# `var b[N]` — `var NAME : T`, so the token after the `:`.
fn _gai_ann(S, sti): i64 {
    if (TOKTYP(S, sti + 2) == 49) { return sti + 3; }
    return 0;
}

# The element kind of an array annotated at `ann_ti` (0 = a bare `var b[N]`), its bytes in
# `_gai_w`: 1 an integer (iN / uN, bool, an enum, `*T`), 2 the bare byte list, 3 u128, 4 f64,
# 5 f32. 0 = an element no list of constants fills (a struct or union, a vector, a slice,
# cstring, Result / Option / Tagged, Vec); -1 = a name that is no type, which _arr_name_ebytes has
# already refused at the name. The type comes from the one resolver (_tn_resolve_at).
fn _gai_kind(S, ann_ti): i64 {
    _gai_w = 1;
    if (ann_ti == 0) { return 2; }
    var t = TOKTYP(S, ann_ti);
    _gai_w = 8;
    if (t == 8) { return 1; }
    if (t == 105) { _gai_w = 16; return 3; }
    if (t != 2) { return 0; }
    var c = _tn_resolve_at(S, ann_ti);
    if (c == 0) { return 0 - 1; }
    var f = _tn_flt(c);
    if (f == F64_TYID) { return 4; }
    if (f == F32_TYID) { _gai_w = 4; return 5; }
    _gai_w = _tn_init_w(c);
    if (_gai_w > 0) { return 1; }
    return 0;
}

# A diagnostic at token `ti`, the cursor put back. Each is reported once and the latch it set is
# cleared, so every bad array of a file is reported; an error already holding it is left alone.
fn _gai_err(S, ti, msg): i64 {
    if (_panic == 1) { return 0; }
    var n = 0;
    while (load8(msg + n) != 0) { n = n + 1; }
    var sv = GTI(S);
    STI(S, ti);
    ERR_MSG(S, msg, n);
    STI(S, sv);
    _panic = 0;
    return 0;
}
fn _gai_type_err(S, ti): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (TOKTYP(S, ti) != 2) {
        _gai_err(S, ti, "an initializer list is not supported for this array's element type; store the elements explicitly");
        return 0;
    }
    var sv = GTI(S);
    STI(S, ti);
    ERR_IDENT(S, "an initializer list for an array of ", TOKVAL(S, ti), " is not supported; store the elements explicitly (a list fills integer, bool, enum, pointer, u128, f64 and f32 elements)", 0 - 1);
    STI(S, sv);
    _panic = 0;
    return 0;
}
# More elements than the array holds: the bare list keeps its message (it counts BYTES).
fn _gai_cap_err(S, cap, bare): i64 {
    if (bare == 1) {
        _gai_err(S, GTI(S), "byte-array literal has more bytes than the array's declared capacity (cap is [N]*8 bytes)");
        return 0;
    }
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": array initializer has more elements than the array holds (");
    PRNUM(cap);
    PRSTR(")\n");
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}

# Step over one element: to its `,` or `}` outside parentheses. A `;` or EOF stops it (the caller
# reports the missing `}`). An empty element is `expected number`, as it always was — unless
# `quiet` (the evaluation, after the walk has reported).
fn _gai_skip(S, quiet): i64 {
    var t = PEEKT(S);
    if (t == 31 || t == 14) {
        if (quiet == 0) { ERR_EXPECT(S, 1); }
        return 0;
    }
    var d = 0;
    while (t != 5 && t != 12) {
        if (d == 0) { if (t == 31 || t == 14) { return 0; } }
        if (t == 10 || t == 13) { d = d + 1; }   # 6.7.4: an if-expression element's braces
        if (t == 11 || t == 14) { d = d - 1; }
        STI(S, GTI(S) + 1);
        t = PEEKT(S);
    }
    return 0;
}
# The walk of `{ e, e, .. }`, cursor on `{` and left past `}`: the element count against `cap`
# (elements; the bare list's bytes), reported at the first element past it. No value is looked at.
fn _gai_walk(S, cap, bare): i64 {
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); return 0; }
    STI(S, GTI(S) + 1);
    var n = 0;
    while (PEEKT(S) != 14) {
        var t = PEEKT(S);
        if (t == 5 || t == 12) { ERR_EXPECT(S, 14); return n; }
        if (n == cap) { _gai_cap_err(S, cap, bare); }
        _gai_skip(S, 0);
        n = n + 1;
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    }
    STI(S, GTI(S) + 1);
    return n;
}
# The declaration's half (pass 1, and _gai_stmt): the element type, then the walk. `n` the
# declared element count, `sz` the slot's bytes (the bare list's cap). Cursor on `{`.
fn _gai_decl(S, ann_ti, n, sz): i64 {
    var bare = 0;
    if (ann_ti == 0) { bare = 1; n = sz; }
    if (_gai_kind(S, ann_ti) == 0) { _gai_type_err(S, ann_ti); }
    _gai_walk(S, n, bare);
    return 0;
}

# After the first top-level statement (PARSE_ARRAY, GINFN != 1, cursor on `=`). At module scope
# the declaration is the leading block's, evaluated once the slot is registered (_gai_now) — by
# then every name is. In a top-level block (`while`, `if` / `elif` / `else`, `for` and its init,
# `switch` arms, `match`, `@unsafe`, a bare `{ }`) it is REFUSED: a baked list would hold its
# values once, where a scalar's initializer runs each time the block does (that shape never
# compiled — `expected ';'`).
# PARSE_PROG counts its nesting in `_pp_depth`, and _PARSE_STMT_NESTED (parse.cyr) the statements
# parsed with no PARSE_PROG body — a `switch` case / default arm, `@unsafe { }`, a `for`'s init;
# scope depth cannot tell, an `elif` body opens no scope. Returns the `{` token, or 0.
fn _gai_stmt(S, ann_ti, n): i64 {
    var eq = GTI(S);
    STI(S, eq + 1);
    var bare = 0;
    if (ann_ti == 0) { bare = 1; }
    if (_pp_depth != 1) {
        _gai_err(S, eq, "an array initializer is allowed only at module scope: in a block it would hold its values once, not each time the block runs; assign the elements in the block");
        _gai_walk(S, 0 - 1, bare);
        return 0;
    }
    var lb = GTI(S);
    _gai_decl(S, ann_ti, n, n * 8);
    return lb;
}
fn _gai_now(S, vi, lb, ann_ti): i64 {
    var sv = GTI(S);
    STI(S, lb);
    _gai_eval(S, vi, ann_ti, GVSI(S, vi));
    STI(S, sv);
    return 0;
}

# The replay of a leading-block array initializer (EMIT_GVAR_INITS, cursor on `[`). An entry a
# later constant declaration superseded (_gv_supersede) is evaluated for its errors and writes
# nothing: the later declaration is the value, and no blob of this one may land over it.
fn _gai_replay(S, gi, noff, gsup, sti): i64 {
    while (PEEKT(S) != 13) {
        var t = PEEKT(S);
        if (t == 5 || t == 12) { ERR_EXPECT(S, 13); return 0; }
        STI(S, GTI(S) + 1);
    }
    var ann = _gai_ann(S, sti);
    var vi = _gv_ent_slot(S, gi, 0, noff);
    if ((gsup & 1) != 0) { vi = 0 - 1; }
    var seed = 0;
    if (vi >= 0) { seed = _gai_seed(S, gi, vi, noff); }
    _gai_eval(S, vi, ann, seed);
    _expect_step(S, 5);
    return 0;
}

# Evaluate `{ e, e, .. }` (cursor on `{`, left past `}`) into slot `vi`'s blob (vi < 0: errors
# only; `seed` a new blob's first word, _gai_blob). The walk has reported the shape; this reports the values.
fn _gai_eval(S, vi, ann, seed): i64 {
    var k = _gai_kind(S, ann);
    var eb = _gai_w;
    _gai_isbool = 0;
    if (ann > 0) { if (TOKTYP(S, ann) == 2) { _gai_isbool = _bx_is_bool_name(S, TOKVAL(S, ann)); } }
    if (_syntax_only == 1) { k = 0; }
    var b = 0;
    if (k > 0) { b = _gai_blob(S, vi, eb, k, seed); }
    STI(S, GTI(S) + 1);
    var off = 0;
    while (PEEKT(S) != 14) {
        var t = PEEKT(S);
        if (t == 5 || t == 12) { return 0; }
        var ti = GTI(S);
        if (k > 0) { _gai_one(S, b, off, eb, k, ti); }
        STI(S, ti);
        _gai_skip(S, 1);
        off = off + eb;
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    }
    STI(S, GTI(S) + 1);
    return 0;
}

# Slot `vi`'s blob, made on first use: zeroed, then seeded with `seed`, the scalar constant this slot
# held (a bare `var B[1]` redeclaring `var B = 5;` keeps the bytes it does not list, as the replayed
# stores did; _gai_seed). A later declaration of the slot reuses it, so the overlay order is the old
# store order. 0 for `vi < 0`.
fn _gai_blob(S, vi, eb, k, seed): i64 {
    if (vi < 0) { return 0; }
    var b = GVGAI(S, vi);
    if (b == 0) {
        var sz = L64(_vars_base + vi * 8);
        b = alloc(sz + 24);
        store64(b, sz);
        if (sz >= 8) { store64(b + 16, seed); }
        SVGAI(S, vi, b);
    }
    store64(b + 8, eb | (k << 8));
    return b;
}
# ⛔ 6.7.16 — THE SEED IS THE SLOT'S LAST SCALAR CONSTANT BEFORE THE LIST, HOWEVER IT IS SPELLED
# (issues/archived/2026-10-18-list-redeclaration-over-named-scalar-constant-loses-unlisted-bytes.md). It was the static init,
# which only a pass-1 literal writes: a const- or enum-named scalar (`var a = C; var a[1] = {9};`) is a deferred entry
# the list supersedes (_gvk_one's bk 4: folded, not baked), so the list dropped its bytes (0x0009, where `var a =
# 0x0506;` gives 0x0509), and `var a = 0x0506; var a = C;` seeded the stale literal. Now the nearest earlier entry
# of slot `vi` that folded to an integer (`_gvk_ik` 1; a computed one is no constant and is stepped past, as the
# literal's static init outlives it) is the seed, unless a pass-1 constant redeclaration came after it
# (_gv_supersede's bit 43): then that literal, the static init, is. A FLOAT constant is a constant too (`_gvk_ik` 2,
# its bits; the user's D86 (a), 2026-10-20): a list over `var K = 1.5;` keeps 1.5's bytes it does not list
# (0x3FF8000000000009), as the integer spelling of those bits does — it seeded the static init (the float is a
# deferred entry the list supersedes: no bake), so 1.5's bytes were dropped, and a pass-1 literal before the float
# read through (`var a = 0x0506; var a = 1.5; var a[1] = {9};` 0x0509). A struct / tuple literal of constants
# (`_gvk_ik` 3) stops the walk at the static init. `gi` = the list's entry, `noff` its name. CHANGELOG [6.7.16]
fn _gai_seed(S, gi, vi, noff): i64 {
    if (_gvx_m == 0) { return GVSI(S, vi); }
    var e = _nm_get(S, _gvx_m, noff);
    while (e != 0) {
        var r = load64(_gvx_rec + (e - 1) * 8);
        var g = r >> 2;
        var sk = 0;
        if (g < gi) { if ((r & 3) == 0) { sk = _gai_seed_ent(S, g, vi); } }
        if (sk == 2) { return GVSI(S, vi); }
        if (sk == 1) {
            if ((_gv_sup(L64(_gvt(S) + g * 8)) & 8) != 0) { return GVSI(S, vi); }
            return load64(_gvk_v + g * 8);
        }
        e = load64(_gvx_nxt + (e - 1) * 8);
    }
    return GVSI(S, vi);
}
# Entry `g` against slot `vi`: 1 = it declared the slot and _gvk_pre folded its initializer to a scalar constant
# (`_gvk_ik` 1, an integer; 2, a float's bits, D86 (a)), its value in `_gvk_v`; 2 = it declared the slot with a
# struct / tuple literal of constants (`_gvk_ik` 3), which stops _gai_seed's walk; 0 = neither (another slot, a
# computed initializer).
fn _gai_seed_ent(S, g, vi): i64 {
    if (g >= _gv_ent_cap) { return 0; }
    if ((load64(_gv_ent_base + g * 8) & 0x1FFFFF) - 1 != vi) { return 0; }
    var ik = load8(_gvk_ik + g);
    if (ik == 0) { return 0; }
    if (ik == 3) { return 2; }
    return 1;
}

# One element at token `ti`, written at byte `off` of blob `b` (b == 0: checked only). An empty
# element, and one past the declared count, were reported by the walk.
fn _gai_one(S, b, off, eb, k, ti): i64 {
    var t = TOKTYP(S, ti);
    if (t == 31 || t == 14) { return 0; }
    var v = _gai_val(S, ti, k, eb);
    if (_gai_ok != 1) { _gai_bad_k(S, ti); return 0; }
    if (b == 0) { return 0; }
    if (off + eb > load64(b)) { return 0; }
    _gai_put(b + 16 + off, eb, v);
    return 0;
}
fn _gai_put(d, eb, v): i64 {
    if (eb == 1) { store8(d, v); return 0; }
    if (eb == 2) { store16(d, v); return 0; }
    if (eb == 4) { store32(d, v); return 0; }
    store64(d, v);
    if (eb == 16) { store64(d + 8, 0); }
    return 0;
}

# ⛔ 6.7.4 — THE VALUE OF THE ELEMENT AT `ti`, from the compile-time evaluator: a list element is
# a const context, as 6.7.2 made every other compile-time value (the user's decision, 2026-10-08:
# one evaluator for every site). It was the integer folder, so a comparison, `&&` / `||`, `!`, a
# const fn call, f64 const arithmetic and the if-expression were "not a constant". `_gai_ok`: 1 a
# value; 0 not a constant (a string, a trailing token); 2 the evaluator already said why; 3 a
# `bool[N]` element that is not a bool; 4 an f64 into an integer element. An f64 element takes an
# f64 value's bits (an f32 element narrows them, _gai_f32) and an integer's bits with the warning
# `var G: f64 = 2;` gives; an integer element is range-checked as before. CHANGELOG [6.7.4]
fn _gai_val(S, ti, k, eb): i64 {
    _gai_ok = 1;
    var sv = GTI(S);
    STI(S, ti);
    var v = _ce_eval_here(S);
    var kk = _ce_k;
    var e = GTI(S);
    STI(S, sv);
    if (_ce_err == 1) { _panic = 0; _gai_ok = 2; return 0; }
    var et = TOKTYP(S, e);
    if (et != 31) { if (et != 14) { _gai_ok = 0; return 0; } }
    if (kk == 2) { _gai_ok = 0; return 0; }
    if (_gai_isbool == 1) { if (kk != 3) { _gai_ok = 3; return 0; } }
    if (k >= 4) {
        if (kk != 1) { _gai_ifs(S, ti, e); }
        if (k == 5) { if (kk == 1) { return _gai_f32(v); } return v & 0xFFFFFFFF; }
        return v;
    }
    if (kk == 1) { _gai_ok = 4; return 0; }
    _gai_range(S, ti, v, eb, k);
    return v;
}
fn _gai_bad_k(S, ti): i64 {
    if (_gai_ok == 2) { return 0; }
    if (_gai_ok == 3) {
        _gai_err(S, ti, "a bool array's element takes a boolean value: true, false, a comparison or a bool const");
        return 0;
    }
    if (_gai_ok == 4) {
        var t = TOKTYP(S, ti);
        if (t == 7) { t = TOKTYP(S, ti + 1); }
        if (t == 61) { _gai_err(S, ti, "a float literal initializes only an f64 or f32 array element"); return 0; }
        _gai_err(S, ti, "an f64 value initializes only an f64 or f32 array element");
        return 0;
    }
    return _gai_bad(S, ti);
}
# `-`? FLOAT, then the element's end: the literal's binary64 bits, the sign bit flipped for `-`
# (the struct-literal baker's float leaf, _spc_leaf).
fn _gai_flit(S, ti): i64 {
    var neg = 0;
    if (TOKTYP(S, ti) == 7) { neg = 1; ti = ti + 1; }
    _gai_ok = 0;
    if (TOKTYP(S, ti) != 61) { return 0; }
    var e = TOKTYP(S, ti + 1);
    if (e != 31) { if (e != 14) { if (e != _spc_cl) { return 0; } } }   # 6.7.7: a tuple's `)`
    _gai_ok = 1;
    var bits = FLIT_NUM(TOKVAL(S, ti));
    if (neg == 1) { bits = bits ^ (1 << 63); }
    return bits;
}
# An integer in an f64 / f32 element: the warning `var G: f64 = 2;` gives (_IFS_SPAN's shapes).
fn _gai_ifs(S, ti, e): i64 {
    if (_IFS_SPAN(S, ti, e) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    _FLT_TYPE_WARN(S, 4);
    STI(S, sv);
    return 0;
}
# One window per width, -2^(8w-1) .. 2^(8w)-1: a bit-pattern spelling is taken, a value that would
# be truncated is refused. The bare byte list keeps [0, 255].
fn _gai_range(S, ti, v, eb, k): i64 {
    if (k == 2) {
        if (v < 0 || v > 255) { _gai_err(S, ti, "byte-array literal value must be in [0, 255]"); }
        return 0;
    }
    if (k != 1) { return 0; }
    if (eb >= 8) { return 0; }
    var hi = (1 << (eb * 8)) - 1;
    var lo = 0 - (1 << (eb * 8 - 1));
    if (v < lo || v > hi) { _gai_range_err(S, ti, v, eb, lo, hi); }
    return 0;
}
fn _gai_range_err(S, ti, v, eb, lo, hi): i64 {
    if (_panic == 1) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": array initializer value ");
    PRNUM(v);
    PRSTR(" does not fit a ");
    PRNUM(eb);
    PRSTR("-byte element (");
    PRNUM(lo);
    PRSTR(" .. ");
    PRNUM(hi);
    PRSTR(")\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    return 0;
}
# An element that is not a constant. A name gets the report a reference to it would give (a variant
# named through the wrong enum, a global another file keeps `private`); otherwise one message.
fn _gai_bad(S, ti): i64 {
    if (_panic == 1) { return 0; }
    var e0 = _had_error;
    _had_error = 0;
    var sv = GTI(S);
    STI(S, ti);
    var t = TOKTYP(S, ti);
    if (t == 2) {
        var vn = TOKVAL(S, ti);
        if (TOKTYP(S, ti + 1) == 41) {
            if (_findvar_core(S, vn) < 0) { _enum_qual_resolve(S, ti); }
        } else {
            var vi = _findvar_core(S, vn);
            if (vi >= 0) { _vis_check_var(S, vi, vn); }
        }
    }
    var said = _had_error;
    _had_error = _had_error | e0;
    _panic = 0;
    STI(S, sv);
    if (said != 0) { return 0; }
    if (t == 7) { t = TOKTYP(S, ti + 1); }
    if (t == 61) {
        _gai_err(S, ti, "a float literal initializes only an f64 or f32 array element");
        return 0;
    }
    _gai_err(S, ti, "array initializer elements must be constants: integers, enum constants and constant expressions (float literals in an f64 or f32 array)");
    return 0;
}

# The binary32 bits of binary64 `d`, round-to-nearest-even — what cvtsd2ss / fcvt give — in
# integers only (cybs compiles no float builtin, and src/ uses none). A result below f32's least
# subnormal is a signed zero, one past its range infinity; a NaN stays a quiet NaN (its top
# payload bits). `(x - 1) << 23 + r` makes both carries by addition: a significand that rounds up
# to 2^24 bumps the exponent, and a subnormal that rounds up to 2^23 is the least normal.
fn _gai_f32(d): i64 {
    var s = (d >> 63) << 31;
    var e = (d >> 52) & 0x7FF;
    var m = d & 0xFFFFFFFFFFFFF;
    if (e == 0x7FF) {
        if (m == 0) { return s | 0x7F800000; }
        return s | 0x7FC00000 | (m >> 29);
    }
    if (e == 0) { return s; }
    m = m | (1 << 52);
    var x = e - 896;
    var sh = 29;
    if (x < 1) { sh = 30 - x; x = 1; }
    if (sh >= 54) { return s; }
    var r = m >> sh;
    var rem = m & ((1 << sh) - 1);
    var half = 1 << (sh - 1);
    if (rem > half) { r = r + 1; }
    elif (rem == half) { if ((r & 1) == 1) { r = r + 1; } }
    var bits = ((x - 1) << 23) + r;
    if (bits >= 0x7F800000) { return s | 0x7F800000; }
    return s | bits;
}

# A deferred entry (`sti` = its `var`) that is an array list — the replay's own test
# (EMIT_GVAR_INITS): `var NAME [`, or `var NAME : <annotation> [`. The cursor is put back.
fn _gai_is_list(S, sti): i64 {
    var sv = GTI(S);
    STI(S, sti + 2);
    if (PEEKT(S) == 49) { _gvi_ann(S, 0 - 1); }
    var r = 0;
    if (PEEKT(S) == 28) { r = 1; }
    STI(S, sv);
    return r;
}

# cx (_gv_cx_prestore): make the blob of every slot a live leading-block list writes — the replay
# fills it — so the prestore leaves that slot to the var data. The blob is seeded with the scalar
# constant the slot held (_gai_seed, as the replay seeds it); storing the scalar at run time would
# land over the baked list.
fn _gai_cx_blobs(S): i64 {
    var gc = L64(S + 0x19A000);
    var gi = 0;
    while (gi < gc) {
        var graw = L64(_gvt(S) + gi * 8);
        var sti = _gv_tok(graw);
        if ((_gv_sup(graw) & 1) == 0) {
            if (_gai_is_list(S, sti) == 1) { _gai_cx_blob(S, gi, TOKVAL(S, sti + 1)); }
        }
        gi = gi + 1;
    }
    return 0;
}
fn _gai_cx_blob(S, gi, noff): i64 {
    var vi = _gv_ent_slot(S, gi, 0, noff);
    if (vi < 0) { return 0; }
    _gai_blob(S, vi, 0, 0, _gai_seed(S, gi, vi, noff));
    return 0;
}

# ================================================================
# One global per top-level name (6.6.6)
# ================================================================
# WHY. A top-level name declared twice used to get a SECOND storage slot, and FINDVAR's
# last-match then bound some references to one slot and the rest to the other. The first
# declaration's static-init value went into a slot nothing read (`var a = 5; var b = a;
# var a = 5;` gave b 0, and `var a = 7` on the third line gave 0 too, under a warning that
# promised "last definition wins"). A redeclaration in the DECLARATION ZONE (before the first
# top-level statement) now REUSES the slot, so every reference names one global. The value
# rule that goes with it is at _gv_supersede. After the first top-level statement a `var` is
# a statement and a redeclaration there is still a NEW variable for the code after it
# (PARSE_VAR; unchanged, and documented in the guide). CHANGELOG [6.6.6]

# The visibility owner a declaration at token `ti` WILL get — _GVAR_VIS's rule, without
# consuming the pending `public`.
fn _gv_owner(S, ti): i64 {
    if (_pub_pending != 0) { return 0; }
    var fid = FM_FILEID(S, GTLINE(S, ti));
    if (_PRIV_FILE(fid) == 1) { return fid + 1; }
    return 0;
}

# The live, plain global below index `below` that a top-level redeclaration of `noff` must
# reuse, or -1. An enum constant has no storage to share (CHK_ENUM_SHADOW / CHKDUPVAL own
# that case), and a prior with a different visibility owner is a different global.
# 6.6.9: walks only the slots of this name, through the name index (_fvh_head, parse_types.cyr)
# — it used to STREQ every global below `below`, the second of the two O(N) walks each
# registration paid. CHANGELOG [6.6.9]
fn _gv_prior(S, noff, below, owner): i64 {
    var e = _fvh_head(S, noff);
    while (e != 0) {
        var vi = e - 1;
        if (vi < below) { if (GVDEAD(S, vi) == 0) {
                if (GVENUMID(S, vi) != 0) { return 0 - 1; }
                if (_vcst_ix(S, vi) >= 0) { return 0 - 1; }   # 6.7.2: a const is not a global to share (refused by name)
                if (GVFI(S, vi) != owner) { return 0 - 1; }
                return vi;
            } }
        e = _fvh_next(vi);
    }
    return 0 - 1;
}

# Same storage: width, type marker, layout mode, signedness — and the two side tables a
# global's type also lives in: a `*T` global's T (`_gv_psid`; `*M` and `*Q` of one size share
# GVTYPE) and the vector mark (SVVEC; f64v2 and u128 share GVTYPE 0 and width 16). CHANGELOG [6.6.20]
# ⛔ 6.7.14 — AND `bool` (the user's decision D9 (a), 2026-10-16): bool-ness is part of a global's type. The mark was
# the LAST declaration's, per slot, so `var G = 5; var G: bool = G;` read G under its own bool mark and built a bool
# holding 5, and `var G = 5; var G: bool = true;` made the integer declaration's storage a bool (6.7.3 (B2): a bool
# reads 0 or 1). A redeclaration that changes it is "redeclared with a different type or size", both ways
# (issues/archived/2026-10-08-redeclared-global-bool-reads-own-stamp.md). PARSE_GVAR_REG marks its registration before the
# fold (_gv_fold_b); a destructure target and an array never carry the mark. CHANGELOG [6.7.14]
fn _gv_same_shape(S, a, b): i64 {
    if (L64(_vars_base + a * 8) != L64(_vars_base + b * 8)) { return 0; }
    if (GVTYPE(S, a) != GVTYPE(S, b)) { return 0; }
    if (GVPM(S, a) != GVPM(S, b)) { return 0; }
    if (_gsgn_shape(GVSGN(S, a)) != _gsgn_shape(GVSGN(S, b))) { return 0; }   # 6.7.6: a bare array's 0x100 is no new shape
    if (_gv_ptr_sid(S, a) != _gv_ptr_sid(S, b)) { return 0; }
    if (GVVEC(S, a) != GVVEC(S, b)) { return 0; }
    if (GVBOOL(S, a) != GVBOOL(S, b)) { return 0; }   # 6.7.14 (D9 (a))
    return 1;
}
# A scalar declaration's registration `vi` (count not bumped) folded as _gv_fold does, its bool mark `b` written
# first so the fold compares it (_gv_same_shape). A fold clears it (_gv_clear); a new global keeps it.
fn _gv_fold_b(S, vi, ti, b): i64 {
    SVBOOL(S, vi, b);
    return _gv_fold(S, vi, ti);
}

# Forget a written-but-uncounted registration so the next one at this index starts clean.
# (Its name needs no reset: every registration writes the name first, and nothing reads an
# index at or above the count.)
fn _gv_clear(S, vi): i64 {
    S64(_vars_base + vi * 8, 0);
    SVTYPE(S, vi, 0);
    SVSGN(S, vi, 0);
    S64(_vgsi_base + vi * 8, 0);
    _gv_lit_set(vi, 0);   # 6.7.12 (D30)
    SVGAI(S, vi, 0);   # 6.6.16 (C1): an array initializer's blob
    if (GVPM(S, vi) != 0) { SVPM(S, vi, 0); }
    if (GVFI(S, vi) != 0) { SVFI(S, vi, 0); }
    # The side tables too, or the next global at this index inherits a `*T`'s struct or the
    # vector mark (a struct global then read through its first word). CHANGELOG [6.6.20]
    if (GVVEC(S, vi) != 0) { SVVEC(S, vi, 0); }
    if (_gv_ptr_sid(S, vi) != 0) { S64(_gv_psid + vi * 8, 0); }
    if (GVBOOL(S, vi) != 0) { SVBOOL(S, vi, 0); }   # 6.7.3
    if (GVINTD(S, vi) != 0) { SVINTD(S, vi, 0); }   # 6.7.6
    if (GVW128(S, vi) != 0) { SVW128(S, vi, 0); }   # 6.7.6 (D2)
    return 0;
}

# One global cannot have two shapes: code compiled against the first would read the second.
fn _gv_shape_err(S, noff): i64 {
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": global '", 10);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' redeclared with a different type or size (a global has one definition; rename one)\n", 85);
    _had_error = 1;
    return 0;
}

# Registration `vi` (tables written, count NOT yet bumped) -> the slot this top-level
# declaration uses: the existing global's when the name is already declared, else `vi`.
# The caller bumps the count only when `vi` comes back. `ti` = the declaration's token.
fn _gv_fold(S, vi, ti): i64 {
    var noff = L64(_varn_base + vi * 8);
    var pi = _gv_prior(S, noff, vi, _gv_owner(S, ti));
    if (pi < 0) { return vi; }
    if (_gv_same_shape(S, pi, vi) == 0) {
        _gv_shape_err(S, noff);
        _gvr_add(vi, ti);   # 6.7.15
        return vi;
    }
    _gv_clear(S, vi);
    _gu_drop(pi);   # 6.7.17: the sweep reads only the last declaration's initialiser
    return pi;
}
# ⛔ 6.7.15 — A REFUSED TYPE CHANGE IS ONE ERROR (issues/2026-10-16-global-type-change-refusal-cascades-into-earlier-
# reader.md). The refused declaration keeps its own registration (its replay stores there), a second global of the
# name, and the replay runs after pass 1 — so an initializer BETWEEN the two declarations resolved the name (FINDVAR,
# last match) to the refused one, in its other shape: `var G: bool = true; var X: bool = G; var G: i32 = 5;` added
# "cannot initialize bool 'X'", a struct G's `var X = G.b;` "no struct type in scope for 'G'". The replay now hides
# each refused registration while an entry declared before it runs (_gvr_hide), so a reader sees what the source
# says at its place: the first declaration before the refused one, the refused one after it (as through 6.7.14 —
# code after it is written for either shape, and reading the first there would cascade the other way).
var _gvr_rec = 0;   # pairs: the refused slot, its declaration's `var` token
var _gvr_n = 0;
var _gvr_cap = 0;   # in words
fn _gvr_add(vi, ti): i64 {
    if (_gvr_n * 2 + 2 > _gvr_cap) {
        if (_gvr_cap == 0) { _gvr_rec = alloc(64 * 8); _gvr_cap = 64; }
        else { _gvr_rec = _grow_one(_gvr_rec, _gvr_cap); _gvr_cap = _gvr_cap * 2; }
    }
    store64(_gvr_rec + _gvr_n * 16, vi);
    store64(_gvr_rec + _gvr_n * 16 + 8, ti);
    _gvr_n = _gvr_n + 1;
    return 0;
}
# Before replaying the entry at token `sti`: a refused registration declared after it is hidden (dead), the rest
# visible. EMIT_GVAR_INITS ends with every one visible again.
fn _gvr_hide(S, sti): i64 {
    var i = 0;
    while (i < _gvr_n) {
        var d = 0;
        if (load64(_gvr_rec + i * 16 + 8) > sti) { d = 1; }
        SVDEAD(S, load64(_gvr_rec + i * 16), d);
        i = i + 1;
    }
    return 0;
}
# The prior that scalar registration `vi` (written, uncounted; bool mark `b`, as _gv_fold_b writes it) folds into:
# its slot, -1 none, -2 a shape the fold refuses. Asked before the fold, so the value compare can stand down.
fn _gv_fold_peek(S, vi, ti, b): i64 {
    SVBOOL(S, vi, b);
    var pi = _gv_prior(S, L64(_varn_base + vi * 8), vi, _gv_owner(S, ti));
    if (pi < 0) { return 0 - 1; }
    if (_gv_same_shape(S, pi, vi) == 0) { return 0 - 2; }
    return pi;
}

# Register one untyped-or-`ty` 8-byte top-level global (a destructure target) through the
# fold, stamp it and count it. Returns the slot.
fn _gv_reg8(S, noff, ty, ti): i64 {
    var vi = GVCNT(S);
    S64(_varn_base + vi * 8, noff);
    S64(_vars_base + vi * 8, 8);
    if (ty != 0) { SVTYPE(S, vi, ty); }
    var gi = _gv_fold(S, vi, ti);
    _GVAR_VIS(S, gi, ti);
    if (gi == vi) { SVCNT(S, vi + 1); }
    return gi;
}

# THE VALUE RULE — "last definition wins", which the collision warning (CHKDUPVAL) has always
# promised and which is how duplicate fns resolve. In the declaration zone (before the first
# top-level statement) a redeclaration whose initializer folds to an integer constant is not
# code, it is the global's value FROM PROGRAM START: every read sees it, including an
# initializer that sits between the two declarations. So an earlier deferred initializer of
# the name must no longer assign — it still RUNS (its side effects are kept), into a
# discarded sink (_gv_target). A computed redeclaration runs in declaration order like every
# deferred initializer. The flag lives above the 40-bit token index in the gvar_toks entry:
# bit 40+k = target k of that entry (k = 1, 2 for a destructure's later names).
#
# 6.6.9: the entries naming `noff` come from a per-name list built at registration
# (_gvx_note), not from a scan of every deferred entry. The scan was O(entries) per constant
# redeclaration, bounded only by the 4096-entry cap this release lifted — past it, a unit of
# redeclared constants would have been the next quadratic shape. The list records the same
# names the scan compared (target 0 always; targets 1 and 2 only behind a `,`), so the same
# bits get set. CHANGELOG [6.6.9]
#
# 6.6.16 (C1): an array list is a constant initializer too — baked, the value from program start —
# so a list redeclaring a slot supersedes the name's earlier deferred initializers the same way
# (`lists` = 1): `var a = 0; var a[1] = {0, 3};` is 0x300, and `var a = f(); var a[1] = {7};`
# runs f() into a sink. An earlier LIST is left alone (two lists overlay in order, the shared
# blob). A constant scalar redeclaration (`lists` = 0) supersedes every earlier entry, lists
# included: it wins whole. CHANGELOG [6.6.16]
# 6.7.16: and marks it with bit 43 — a scalar constant came after it, so a later list's seed is that
# constant's static init, not this entry's fold (_gai_seed). CHANGELOG [6.7.16]
fn _gv_supersede(S, noff, lists): i64 {
    if (_gvx_m == 0) { return 0; }
    var e = _nm_get(S, _gvx_m, noff);
    while (e != 0) {
        var v = load64(_gvx_rec + (e - 1) * 8);
        var a = _gvt(S) + (v >> 2) * 8;
        var keep = 0;
        if (lists == 1) { keep = _gai_is_list(S, _gv_tok(L64(a))); }
        if (keep == 0) { S64(a, L64(a) | ((1 << (v & 3)) << 40)); }
        if (lists == 0) { S64(a, L64(a) | (8 << 40)); }
        e = load64(_gvx_nxt + (e - 1) * 8);
    }
    return 0;
}

# The per-name list of deferred-entry targets: name -> newest record + 1 (a name map, see
# _nm_new in parse_types.cyr); record r = entry * 4 + target, chained through _gvx_nxt.
var _gvx_m = 0;
var _gvx_rec = 0;
var _gvx_nxt = 0;
var _gvx_n = 0;
var _gvx_cap = 0;
fn _gvx_grow(): i64 {
    if (_gvx_cap == 0) {
        _gvx_m = _nm_new(4096);
        _gvx_cap = 4096;
        _gvx_rec = alloc(4096 * 8);
        _gvx_nxt = alloc(4096 * 8);
        return 0;
    }
    _gvx_rec = _grow_one(_gvx_rec, _gvx_cap);
    _gvx_nxt = _grow_one(_gvx_nxt, _gvx_cap);
    _gvx_cap = _gvx_cap * 2;
    return 0;
}
fn _gvx_rec1(S, gi, k, noff): i64 {
    if (_gvx_n >= _gvx_cap) { _gvx_grow(); }
    var r = _gvx_n;
    store64(_gvx_rec + r * 8, gi * 4 + k);
    store64(_gvx_nxt + r * 8, _nm_get(S, _gvx_m, noff));
    _nm_put(S, _gvx_m, noff, r + 1);
    _gvx_n = r + 1;
    return 0;
}
# Record the names deferred entry `gi` (at `sti`, the `var` token) assigns.
fn _gvx_note(S, gi, sti): i64 {
    _gvx_rec1(S, gi, 0, TOKVAL(S, sti + 1));
    if (TOKTYP(S, sti + 2) == 31) {
        _gvx_rec1(S, gi, 1, TOKVAL(S, sti + 3));
        if (TOKTYP(S, sti + 4) == 31) { _gvx_rec1(S, gi, 2, TOKVAL(S, sti + 5)); }
    }
    return 0;
}

fn _gv_tok(raw): i64 { return raw & ((1 << 40) - 1); }
fn _gv_sup(raw): i64 { return raw >> 40; }

# The slot a replayed initializer stores into: its global, or — when a later constant
# declaration superseded target `k` — a fresh dead sink of the same shape, so the
# initializer still runs and its result is discarded. The sink is an _HTEMP slot (the
# replay runs at top level, where _HTEMP registers a dead, unnamed global) resized to the
# global's shape.
fn _gv_target(S, idx, sup, k): i64 {
    if (idx < 0) { return idx; }
    if (((sup >> k) & 1) == 0) { return idx; }
    var vi = 0 - 2 - _HTEMP(S);
    S64(_vars_base + vi * 8, L64(_vars_base + idx * 8));
    SVTYPE(S, vi, GVTYPE(S, idx));
    SVSGN(S, vi, GVSGN(S, idx));
    if (GVPM(S, idx) != 0) { SVPM(S, vi, GVPM(S, idx)); }
    return vi;
}

# SLVAR for a replayed initializer — never a sink (the no-main exit value reads "last var").
fn _gv_slvar(S, idx): i64 {
    if (GVDEAD(S, idx) == 0) { SLVAR(S, idx); }
    return 0;
}

# The slot(s) each deferred entry DECLARED, recorded when it is registered and read back by
# the replay — which used to re-resolve the name with FINDVAR at replay time and so could
# land on a LATER declaration of it (a kernel build replays after the top-level program has
# registered its own globals). Packed as slot+1 in 21-bit fields, target k at bit 21*k
# (0 = unrecorded -> FINDVAR). Parallel to gvar_toks, allocated on first use.
# 6.6.9: grown with gvar_toks (2x by alloc + copy), no longer fixed at 4096 entries. A slot
# field is 21 bits and the var table's hard cap is 2^20 slots, so slot+1 always fits.
var _gv_ent_base = 0;
var _gv_ent_cap = 0;
fn _gv_ent_set(gc, packed): i64 {
    if (_gv_ent_base == 0) { _gv_ent_base = alloc(4096 * 8); _gv_ent_cap = 4096; }
    if (gc >= _gv_ent_cap) { _gv_ent_base = _grow_one(_gv_ent_base, _gv_ent_cap); _gv_ent_cap = _gv_ent_cap * 2; }
    store64(_gv_ent_base + gc * 8, packed);
    return 0;
}
fn _gv_ent_slot(S, gi, k, noff): i64 {
    var w = 0;
    if (gi < _gv_ent_cap) { w = (load64(_gv_ent_base + gi * 8) >> (21 * k)) & 0x1FFFFF; }
    if (w == 0) { return FINDVAR(S, noff); }
    return w - 1;
}

# Hide the top-level program's globals from FINDVAR while the replay runs (on = 1) or stop
# (on = 0). Only a kernel build sets _gv_zone_top (main.cyr): every other build replays before
# the program has registered anything. Globals the replay itself registers (sinks, hidden
# temps) sit above the range and stay visible. See _fv_hidden (parse_types.cyr).
fn _gv_hide_program(S, on): i64 {
    _fv_hide_lo = 0;
    _fv_hide_hi = 0;
    if (on == 1) { if (_gv_zone_top > 0) { _fv_hide_lo = _gv_zone_top; _fv_hide_hi = GVCNT(S); } }
    return 0;
}

# The store of a replayed global initializer (and of cx's prestore), at the slot's width.
# Narrow scalar globals are PACKED in the var area, so the 8-byte EVSTORE both sites used
# wrote the value's upper bytes over the next 7/6/4 bytes of globals: `var a: u8 = 0;
# var b: u8 = 7;` read b as 0, because b's image value was laid down before the program ran
# and a's replayed store then zeroed it. Sign does not matter here; the load side sign-extends
# (GVSGN). Not _asg_store_slot: that warns on narrowing, which a declaration does not, and SLVARs
# again. CHANGELOG [6.6.13]
# 6.7.7 — every width under 8 goes to EVSTORE_W, which stores a 3 / 5 / 6 / 7-byte width exactly now
# (`_ESTORE_ODD_RCX`) where it fell back to the 8-byte store. No declaration reaches here at such a
# width today (a struct global initialised from an expression is registered at 8 bytes; a literal is
# laid down field by field), so this keeps "at the slot's width" true for every width. CHANGELOG [6.7.7]
fn _gv_store(S, vi): i64 {
    var w = L64(_vars_base + vi * 8);
    if (w > 0) { if (w < 8) { EVSTORE_W(S, vi, w); return 0; } }
    EVSTORE(S, vi);
    return 0;
}
# The declaration-zone replay's store of an initializer just parsed (EMIT_GVAR_INITS): an f64 value
# into an `f32` global rounds first (_f32_init_round, parse_expr.cyr). Not in `_gv_store`, whose cx
# constant prestore runs with no expression parsed. CHANGELOG [6.7.6]
fn _gvi_store(S, vi): i64 {
    if (GVW128(S, vi) == 1) { _w128_init_place(S, 2, vi); _gv_slvar(S, vi); return 0; }   # 6.7.6 (D2)
    _f32_init_round(S, GVTYPE(S, vi));
    _gv_store(S, vi);
    _gv_slvar(S, vi);
    return 0;
}

# The initial value of a 16-byte LOCAL (PARSE_VAR; canonical slot `lc`, the high half in the slot
# above it; `ann` = the annotation's type token). ⛔ 6.7.6 (Break 1, D2) — a `u128` takes the whole
# value (_w128_init_place): a u128 source (a u128 variable, a `+` / `-` result) all 16 bytes, an
# integer zero-extended. It stored the value into BOTH halves — `var a: u128 = 5;` had a high word
# of 5, `var a: u128 = c;` c's low word twice — while a global got 0 (the high half). The slot is
# marked (SLW128) last, after the registration's SLAGG. A slice keeps its store: the value into
# both words (`var s: [u8] = 0;`).
# Both halves are written through the ADDRESS (`&canonical + 8` is the high half): the regalloc
# picker counts `mov [rbp+disp32], rax` per slot to decide what to pin to a callee-saved register,
# and the nameless high half has no other reference — an EFLSTORE to it would be patched into a
# register move and leave the stack slot unwritten. A `lea` keeps a slot in memory.
fn _w16_local_init(S, lc, ann): i64 {
    _ann_refd_bind_l(S, lc);   # 6.7.16: a refused slice element's stand-down is this slot's
    if (TOKTYP(S, ann) == 105) {
        _w128_init_place(S, 1, lc);
        SLW128(S, lc);
        return 0;
    }
    EPUSHR(S);                 # the value
    EFLADDR_X1(S, lc);         # rcx = &slice
    EADDIMM_X1(S, 8);          # rcx = &slice + 8 (the high half)
    EPOPR(S);
    ESTOC(S);
    EFLSTORE(S, lc);           # the canonical slot (.ptr) — address-taken by slice_set / slice_ptr
    return 0;
}
# The same for a 16-byte GLOBAL after the first top-level statement (PARSE_VAR): a u128 whole, a
# slice's first word (its high half is zero in the image). 6.7.6 (D2)
fn _w16_global_init(S, vi, st, ann): i64 {
    if (st == 16) { if (TOKTYP(S, ann) == 105) {
            _w128_init_place(S, 2, vi);
            return 0;
        } }
    EVSTORE(S, vi);
    return 0;
}

# cx bakes no scalar into its .cyx var data (cxvm copies it into the guest; only 6.6.16's array
# lists are written there, main_cx.cyr), so the static-init value every constant global records in
# gvar_initval (_vgsi_base) is stored HERE, at startup, ahead of every deferred initializer — the
# "from program start" the file image gives the other five targets. That covers a plain constant
# global (PARSE_GVAR_REG's static-init path, which cx takes like every target since 6.7.9), a
# constant redeclaration or shadow, and the enum-named scalars _gvk_pre folds (since 6.7.14 not
# replayed where the image value is theirs, _gvk_quiet, on every target). A forward read agrees with
# the image targets
#
#     var b = a;      # 5 on every target
#     var a = 5;
#
# and a static-init value is never computed again at run time (`var Q = INT_MIN / -1;` trapped
# in cxvm's `idiv` while cx alone replayed it). CHANGELOG [6.6.6] [6.7.9]
#
# 6.6.16 (C1): a slot a leading-block array list writes is left to the .cyx var data, where the
# list is baked (main_cx.cyr) — its blob was seeded with this constant (_gai_cx_blobs).
fn _gv_cx_prestore(S): i64 {
    _gai_cx_blobs(S);
    var n = GVCNT(S);
    var vi = 0;
    while (vi < n) {
        var v = L64(_vgsi_base + vi * 8);
        if (v != 0) { if (GVGAI(S, vi) == 0) { EMOVI(S, v); _gv_store(S, vi); } }
        vi = vi + 1;
    }
    return 0;
}

# 6.6.9 — gvar_toks, the deferred-initializer table, GROWS. It was the last fixed table of the
# var family: 4096 entries at 0x729000, refused past that with "too many initialized globals
# (max 4096)". The message was wrong about what it counted — every global that does not take
# the static-init path registers here, which is not only a computed initializer but also a
# bare `var x;`, `var x = 0;` and a string literal (static init takes a NONZERO constant only,
# because gvar_initval uses 0 as "no value") — and the cap stood between the filed 20,000-
# global repro and passing. The region at 0x729000 is still the first 4096 entries (no layout
# change); the 4097th moves the table to alloc'd storage and it doubles from there, the
# _grow_one shape. (6.6.6's "the cap error stores anyway" defect has no cap left to overrun.)
# CHANGELOG [6.6.9]
var _gvt_base = 0;
var _gvt_cap = 0;
fn _gvt(S): i64 {
    if (_gvt_base == 0) { _gvt_base = S + 0x729000; _gvt_cap = 4096; }
    return _gvt_base;
}
# Register a deferred initializer: `sti` is its `var` token, `packed` the slot(s) it declares
# (see _gv_ent_set). Every registration site goes through here.
fn _gv_defer(S, sti, packed): i64 {
    var gc = L64(S + 0x19A000);
    var b = _gvt(S);
    if (gc >= _gvt_cap) { b = _grow_one(b, _gvt_cap); _gvt_base = b; _gvt_cap = _gvt_cap * 2; }
    S64(b + gc * 8, sti);
    _gv_ent_set(gc, packed);
    _gvx_note(S, gc, sti);
    S64(S + 0x19A000, gc + 1);
    return 0;
}

# Skip ONE top-level `var` declaration: consume through the `;` that ENDS it, which is the
# first `;` outside every `{ }`. A declaration-zone `var` is only registered by pass 1 and
# stepped over by pass 2 — its initializer is compiled later by EMIT_GVAR_INITS — so both
# passes need to know where it stops. They used to stop at the FIRST `;`, and a block-bodied
# closure `var f = |x| { return 7; };` carries one inside its body: both passes then stopped
# in the middle of the closure, at its `}`, which ends every top-level loop — so every
# statement after the declaration vanished from the binary with no diagnostic. Only BRACE
# depth counts: a `;` inside parens or brackets alone is never valid, and stopping there keeps
# a malformed `var x = f(1;` from swallowing the rest of the file. EOF stops the walk.
# CHANGELOG [6.6.6]
# ⛔ 6.7.17 — AND AT A DECLARATION THE ENTRY'S `;` IS MISSING BEFORE (`_gv_entry_cut`): `var g = 1` then `fn f1() ..`
# stepped to the `;` of the first statement, so f1 and f2 were never registered or parsed and their errors never
# reported, and `var h = zz;` after it was no entry of its own. The replay reports the `;` there. `sti` is the entry's
# own `var`. CHANGELOG [6.7.17]
fn _skip_gvar_decl(S, sti): i64 {
    var bd = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { return 0; }
        if (bd <= 0) { if (_gv_entry_cut(S, sti) == 1) { return 0; } }
        STI(S, GTI(S) + 1);
        if (t == 13) { bd = bd + 1; }
        elif (t == 14) { bd = bd - 1; }
        elif (t == 5) { if (bd <= 0) { go = 0; } }
    }
    return 0;
}
# 1 = the cursor, at depth 0 in the zone `var` entry from token `sti` (or a const's, `_cst_skip_decl`), ends it: a
# declaration keyword that begins a later line than the token before it — fn (not a `*fn(` type's), async fn, var,
# const, struct, enum, union, impl, trait, mod, use, pub, private, or a top-level directive (#assert, #pe_import, the
# fn attributes, `#deprecated(".."`). None of them is ever inside an initializer at depth 0 (a closure's body is depth
# 1), so a valid entry never ends early. CHANGELOG [6.7.17]
fn _gv_entry_cut(S, sti): i64 {
    var ti = GTI(S);
    if (ti <= sti) { return 0; }
    if (GTLINE(S, ti) <= GTLINE(S, ti - 1)) { return 0; }
    var t = TOKTYP(S, ti);
    if (t == 3 || t == 168 || t == 40 || t == 60 || t == 101) { return 1; }
    if (t == 77 || t == 167 || t == 72 || t == 74 || t == 73 || t == 153) { return 1; }
    if (t == 32) { return _tok_fn_kw(S, ti); }
    if (t == 134) { if (TOKTYP(S, ti + 1) == 32) { return 1; } }
    if (t == 107 || t == 110 || _tl_flag_tok(t) == 1) { return 1; }
    if (t == 124) { if (TOKTYP(S, ti + 1) == 10) { if (TOKTYP(S, ti + 2) == 30) { return 1; } } }   # `?` shares it
    return 0;
}

# 6.6.10 — the untyped-float flag for a global registered here (see _UFV_G, parse_expr.cyr).
# No code is emitted for the initialiser yet, so its SHAPE decides: after any leading `-` / `(`,
# a float literal, a float builtin, a call to a `: f64` fn, or a lone f64 / f32 / flagged
# global. `typed` is the sum of the declaration's (non-negative) annotation channels.
fn _gv_ufv(S, sti, typed): i64 {
    if (typed != 0) { return 0; }
    if (TOKTYP(S, sti + 2) != 4) { return 0; }
    var ti = sti + 3;
    while (TOKTYP(S, ti) == 7 || TOKTYP(S, ti) == 10) { ti = ti + 1; }
    var t = TOKTYP(S, ti);
    if (t == 61) { return 1; }
    if (_NEG_INTRIN_KIND(t) != 0) { return 1; }
    if (t != 2) { return 0; }
    if (TOKTYP(S, ti + 1) == 10) {
        var fi = FINDFN(S, TOKVAL(S, ti));
        if (fi < 0) { return 0; }
        if (GFRS(S, fi) == 0 - 9) { return 1; }
        return 0;
    }
    if (TOKTYP(S, ti + 1) != 5) { if (TOKTYP(S, ti + 1) != 11) { return 0; } }
    # ⚠ _findvar_core, NOT FINDVAR: this is a DECLARATION-time peek, and FINDVAR's cross-file
    # `private` check turns it into an accusation (private_does_not_block_own_declaration.sh).
    var vi = _findvar_core(S, TOKVAL(S, ti));
    if (vi < 0) { return 0; }
    var gt = GVTYPE(S, vi);
    if (gt == F64_TYID) { return 1; }
    if (gt == F32_TYID) { return 1; }
    if (_gfi_base == 0) { return 0; }
    return load8(_gfi_base + vi);
}
# ⛔ 6.6.11 — AN UNTYPED `var` COPIED FROM A DECLARED f64 / f32 VALUE STAYED i64. `var t = p.y;`
# (p.y an f64 field), `var t = y;` (y an f64 local or param) and `var t = G;` (G an f64 global)
# left `t` untyped, so `t + t` was an INTEGER add of two bit patterns — silent; only `-t` drew
# kind 3. The v6.5.21 rule (`var t = f();` with f `: f64` types t) now reaches a pure COPY of a
# declared float: the initialiser is exactly `IDENT` or `IDENT(.IDENT)+` and its value is typed
# F64/F32. Deliberately NARROW: a literal (`var z = 0.0;`), a float builtin (`f64_sqrt(u)`) and
# any arithmetic stay untyped — inferring those would turn `==` / `<` on existing code into
# float compares (NaN, ±0). Returns the type to stamp, else 0. CHANGELOG [6.6.11]
fn _decl_float_copy(S, ti, end): i64 {
    var t = GESTYPE(S);
    if (t != F64_TYID) { if (t != F32_TYID) { return 0; } }
    if (TOKTYP(S, ti) != 2) { return 0; }
    ti = ti + 1;
    while (ti < end) {
        if (TOKTYP(S, ti) != 41) { return 0; }
        if (TOKTYP(S, ti + 1) != 2) { return 0; }
        ti = ti + 2;
    }
    if (ti != end) { return 0; }
    return t;
}
# The same judgement for a global at REGISTRATION, where no code has been emitted and the shape
# decides: `= G ;` with G an f64 / f32 global, or `= G.f(.f)* ;` through a struct global whose
# leaf field is declared f64 / f32. Stamps the type (and clears the untyped-float flag) on a
# NEW slot only — a redeclaration keeps the slot it folded onto. CHANGELOG [6.6.11]
fn _gv_float_copy(S, gvi, sti, typed): i64 {
    if (typed != 0) { return 0; }
    if (gvi != GVCNT(S)) { return 0; }
    if (TOKTYP(S, sti + 2) != 4) { return 0; }
    var ti = sti + 3;
    if (TOKTYP(S, ti) != 2) { return 0; }
    var vi = _findvar_core(S, TOKVAL(S, ti));
    if (vi < 0) { return 0; }
    var t = GVTYPE(S, vi);
    if (TOKTYP(S, ti + 1) == 41) { t = _gv_field_chain(S, vi, ti + 1); ti = _gfc_end; }
    else { ti = ti + 1; }
    if (TOKTYP(S, ti) != 5) { return 0; }
    if (t != F64_TYID) { if (t != F32_TYID) { return 0; } }
    SVTYPE(S, gvi, t);
    SGFI(S, gvi, 0);
    return 0;
}
# `.f(.f)*` from token `ti` on struct global `vi`: the leaf's float type (F64_TYID / F32_TYID)
# or 0; `_gfc_end` is the token after the chain.
var _gfc_end = 0;
fn _gv_field_chain(S, vi, ti): i64 {
    _gfc_end = ti;
    if (GVPM(S, vi) == 0) { return 0; }
    var si = GVTYPE(S, vi) - 1;
    if (si < 0) { return 0; }
    var k = 0;
    while (TOKTYP(S, ti) == 41) {
        if (TOKTYP(S, ti + 1) != 2) { return 0; }
        if (k != 0) { return 0; }   # a float field is a leaf
        if (si < 0) { return 0; }
        var fi = FINDFIELD(S, si, TOKVAL(S, ti + 1));
        if (fi < 0) { return 0; }
        k = GFFK(S, si, fi);
        si = GETFTYPE(S, si, fi) - 1;
        ti = ti + 2;
    }
    _gfc_end = ti;
    if (k == 1) { return F64_TYID; }
    if (k == 2) { return F32_TYID; }
    return 0;
}
# 6.6.10 — `var G: f64 = 1;` at registration: the same integer-constant judgement as a local
# (_IFS_CHECK), over `= <expr> ;`, reported at the initialiser. The cursor is restored.
fn _gv_ifs(S, sti, ann_float): i64 {
    var ti = sti + 5;
    if (TOKTYP(S, ti - 1) != 4) { return 0; }
    var end = ti + 1;
    if (TOKTYP(S, end) != 5) { end = ti + 2; }
    if (TOKTYP(S, end) != 5) { return 0; }
    var g = GTI(S);
    STI(S, end);
    _IFS_CHECK(S, _IFS_K(ann_float), ti);
    STI(S, g);
    return 0;
}

# The token after a struct annotation's name: `<...>` on a GENERIC struct is parsed and the
# instance `Box$ty` instantiated (deduped), and its sid returned; the base `sid` when every arg
# is i64 or unresolved (the base IS the all-i64 instance), or when there is no `<`, or when the
# struct is not generic (SKIP_GENERICS). `sid` <= 0 skips the args and returns it. A `<..>` on a
# non-generic struct or a scalar is refused at the name first (6.7.15 D6, `_ngt_refuse`).
# v6.3.10 in PARSE_VAR; ⛔ 6.6.11 PARSE_GVAR_REG and the EMIT_GVAR_INITS replay share it — the
# declaration-zone global registered `var G: W1<Pt>` as the 8 B BASE, so `G.v.x` did not parse
# and `w1s(G)` read the wrong storage. CHANGELOG [6.6.11]
fn _gen_ann_sid(S, sid): i64 {
    if (sid <= 0) { _vec_ann_chk(S, GTI(S) - 1, _vec_ann_vn(S, GTI(S) - 1)); }   # 6.7.11: `Vec<T>` reads T
    if (_MONOMORPH_OK != 1) { _ngt_refuse(S, GTI(S) - 1); SKIP_GENERICS(S); return sid; }   # 6.7.17 (D6, D102): `U<i8>`, `Pt<i64>`
    if (sid <= 0) { _ngt_refuse(S, GTI(S) - 1); SKIP_GENERICS(S); return sid; }   # 6.7.15 (D6): `i64<..>`
    if (PEEKT(S) != 19) {
        if (GSTP(S, sid - 1) != 0) { _bnd_sbase(S, sid); }   # 6.7.1 (C3): a bare `Box` is its i64 base
        return sid;
    }
    if (GSTP(S, sid - 1) == 0) { _ngt_refuse(S, GTI(S) - 1); SKIP_GENERICS(S); return sid; }   # 6.7.15 (D6): `Pt<..>`
    var lit = 1;
    if (_bnd_quiet == 0) { lit = _targs_literal(S, GTI(S) + 1); }   # 6.7.1 (C3): `Box<i64>` written out
    STI(S, GTI(S) + 1);                 # consume `<`
    _ta_pending_gt = 0;
    # v6.3.33: conc0 [, conc1] via _parse_one_type_arg (a NESTED generic type-arg is
    # instantiated → its instance sid).
    var c0 = _parse_one_type_arg(S);
    var c1 = _ta_rest_s(S, sid);          # `,` — 6.7.16 (D5): as many as the struct declares
    _consume_gt(S);                       # the closing `>` (or `>>` tail)
    # v6.3.37 (B1 half-A): c0 == 0 is an UNRESOLVED type parameter (`var p: Pair<T>` in a
    # generic body) = the base all-i64 instance, as the return-type classification treats it,
    # so the local keeps the base sid and matches _cur_fn_ret_sid. -8 is i64.
    var inst = 0;
    if (c0 != 0 - 8) { if (c0 != 0) { inst = 1; } }
    if (c1 != 0) { if (c1 != 0 - 8) { inst = 1; } }
    if (inst == 0) {
        if (lit == 1) { _bnd_sbase(S, sid); }   # 6.7.1 (C3)
        return sid;
    }
    var g = _instantiate_generic_struct(S, sid - 1, c0, c1);
    if (g > 0) { return g; }
    return sid;
}

# ⛔ 6.6.12 — THE STRUCT LITERAL HEAD, `Name {` or `Name<args> {`. A generic struct's literal
# (`Box<Pt> { p, 5 }`, `Box<i64> { 7, 5 }`) was never recognised: the three heads (PARSE_VAR,
# PARSE_GVAR_REG's lookahead, the EMIT_GVAR_INITS replay) committed only on `IDENT {`, so it
# parsed as an expression and failed with "undefined variable 'Box'". Cursor on the name: the
# struct id — the INSTANCE for `<args>`, resolved by `_gen_ann_sid` exactly as the annotation
# `var b: Box<Pt>` is, so the two compare equal — with the cursor on the head's LAST token (the
# name, or the closing `>`) so the caller's one-token step lands on `{`. 0 = not a literal head,
# cursor untouched. (`{` cannot follow an expression, so `Name < a > {` is never a comparison.)
# CHANGELOG [6.6.12]
fn _lit_head(S): i64 {
    if (PEEKT(S) != 2) { return 0; }
    var sid = FINDSTRUCT(S, PEEKV(S));
    if (sid <= 0) { return 0; }
    var ti = GTI(S);
    if (TOKTYP(S, ti + 1) == 13) { return sid; }
    if (TOKTYP(S, ti + 1) != 19) { return 0; }
    var e = _targs_end(S, ti + 2);
    if (TOKTYP(S, e + 1) != 13) { return 0; }
    STI(S, ti + 1);
    sid = _gen_ann_sid(S, sid);
    STI(S, e);
    return sid;
}
# ⛔ 6.7.14 — PARENTHESES AROUND A WHOLE STRUCT LITERAL INITIALIZER ARE TRANSPARENT (the user's decision D12 (a),
# 2026-10-16; 6.7.6's rule for a whole struct source, 6.7.13's D19): `var q: P = (P { 5, 6 });` is the literal
# initializer, in a fn and in either zone. It was "undefined variable 'P'" and "expected ')'" (four errors in a
# fn). `_lit_head` after stepping a wrap that holds exactly the literal and ends at the `;` (`_slit_wrap_k`):
# `_slit_pk` is its `(` count, closed by `_slit_unwrap` before the `;`; with no literal the cursor is put back.
# CHANGELOG [6.7.14]
var _slit_pk = 0;
fn _lit_head_w(S): i64 {
    _slit_pk = 0;
    if (PEEKT(S) != 10) { return _lit_head(S); }
    var st = GTI(S);
    var k = _slit_wrap_k(S, st);
    if (k == 0) { return 0; }
    STI(S, st + k);
    var sid = _lit_head(S);
    if (sid <= 0) { STI(S, st); return 0; }
    _slit_pk = k;
    return sid;
}
# 1 = the cursor can open a literal head: a name, or a wrap's `(`.
fn _lit_head_tok(S): i64 {
    if (PEEKT(S) == 2) { return 1; }
    if (PEEKT(S) == 10) { return 1; }
    return 0;
}
# The same, a peek: the cursor and `_slit_pk` are left as they were (pass 1's registration).
fn _lit_head_p(S): i64 {
    var st = GTI(S);
    var sid = _lit_head_w(S);
    _slit_pk = 0;
    STI(S, st);
    return sid;
}
# The `(` count of the wrap at token `st` when it holds exactly a literal `Name { .. }` / `Name<..> { .. }`
# and ends at a `;`; 0 otherwise (a tuple literal is no wrap). `_pw_end` is kept. Reads tokens only.
fn _slit_wrap_k(S, st): i64 {
    if (_tup_lit_at(S, st) >= 0) { return 0; }
    var pe = _pw_end;
    var k = _pwrap_k(S, st);
    var e = _pw_end;
    _pw_end = pe;
    if (TOKTYP(S, e) != 5) { return 0; }
    if (TOKTYP(S, st + k) != 2) { return 0; }
    var o = st + k + 1;
    if (TOKTYP(S, o) == 19) { o = _targs_end(S, o + 1) + 1; }
    if (TOKTYP(S, o) != 13) { return 0; }
    if (_slit_close(S, o) != e - k - 1) { return 0; }
    return k;
}
# ⛔ 6.7.17 — A STRUCT LITERAL WITH ELEMENTS PAST ITS LAST FIELD IS ONE ERROR (met in issues/2026-10-21-str-shapes-beyond-
# d19-d20-d71-d73.md, D98's probes): `P2 { 1, 2, 3, 4 }` was "expected '}', got number 3" and then, the close having
# taken the `3` for its `}` and the declaration the `,` for its `;`, the literal's own `}` closed the fn — "unexpected
# ';'" and "return outside a fn body" (one element too many happened to land on the `}`; a refused element ahead of
# them, `OP { q, 1, 2, 3 }`, the same two). The literal's body parsed, the cursor on its `}`: consumed. Else the report,
# and a skip to the `}` that closes the literal (nesting counted, never past a `;` at depth 0), consumed. CHANGELOG [6.7.17]
fn _slit_rbrace(S): i64 {
    if (PEEKT(S) != 14) {
        ERR_EXPECT(S, 14);
        var d = 0;
        while (PEEKT(S) != 12) {
            var t = PEEKT(S);
            if (d == 0) { if (t == 14 || t == 5) { break; } }
            if (t == 10 || t == 13) { d = d + 1; }
            if (t == 11 || t == 14) { d = d - 1; }
            STI(S, GTI(S) + 1);
        }
        if (PEEKT(S) != 14) { return 0; }
    }
    STI(S, GTI(S) + 1);
    return 0;
}
# The literal's body was parsed: its wrap's `)`s, before the declaration's `;`.
fn _slit_unwrap(S): i64 {
    var k = _slit_pk;
    _slit_pk = 0;
    if (k > 0) { _pw_close(S, k); }
    return 0;
}
# An annotated `var p: T = U { .. }` must agree (`pscale` = `0 - sid` for a struct annotation).
# 6.6.5 in PARSE_VAR; 6.6.12 the declaration-zone global too, which ignored the annotation.
fn _lit_ann_check(S, pscale, sid, isbool): i64 {
    if (isbool == 1) {   # 6.7.3: `var b: bool = P { .. };` — a struct is not a boolean value
        ERR_MSG(S, "a struct literal cannot initialize a bool (a bool takes true / false, a comparison, !x, && / || or another bool)", 112);
        return 0;
    }
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    if ((0 - pscale) == sid) { return 0; }
    ERR_MSG(S, "struct literal type does not match the declared type of this variable", 69);
    return 0;
}

# ⛔ 6.6.17 (a3) — A VECTOR-TYPED GLOBAL OWNS THE VECTOR. `var g: f64v2 = 0;` (either zone) was ONE
# 8-byte slot: `f64v2_add(&g, &h)` wrote its 16 bytes over the next global, and `g = f64v2_make(..)`,
# `var v: f64v2 = g;` and `g = v;` each moved one word of it, silently. The global now takes the
# vector's 16 / 32 bytes and is marked (SVVEC). It is used through its ADDRESS — `&g` with the
# `*_ptr` forms, which the parser already routes `f64v2_add(&g, &h)` to; a value-form read or
# write of it would carry one 8-byte word, so each is refused by name (`_vecg_refuse`), as a
# value-form vector ARGUMENT is ("must be a local IDENT"). `desc` <= -2048 is a vector descriptor;
# anything else keeps the 8-byte slot. CHANGELOG [6.6.17]
fn _vecg_size(S, vi, desc): i64 {
    S64(_vars_base + vi * 8, 8);
    if (desc > 0 - 2048) { return 0; }
    _vec_desc(S, desc);
    var n = GVEC_NSLOTS(S);
    if (n < 1) { return 0; }
    S64(_vars_base + vi * 8, n * 8);
    SVVEC(S, vi, n);
    _gv_vvd_set(vi, 0 - desc - 2048);   # 6.7.13: its vector, for `*&G`
    return 0;
}
# The initializer of a vector global: only a constant 0 (the image is zero) — any other value
# would be stored as one word. `has` / `v` = the declaration's constant fold (PARSE_GVAR_REG).
# 6.7.16: `rhs` its first token, 0 with no `=` — `var c: f64v2;` has none to refuse: it is the one "uninitialized
# variable not allowed" (it added "takes no initializer but 0" first). CHANGELOG [6.7.16]
fn _vecg_init_ok(S, has, v, noff, rhs): i64 {
    if (rhs == 0) { return 0; }
    if (has == 1) { if (v == 0) { return 0; } }
    ERR_IDENT(S, "vector global ", noff, " takes no initializer but 0; set it through its address (`&g` with a `*_ptr` form)", 0 - 1);
    return 0;
}
# A value-form read or write of global `vi`: refused when it is a vector global (see above).
fn _vecg_refuse(S, vi): i64 {
    if (GVVEC(S, vi) == 0) { return 0; }
    ERR_IDENT(S, "vector global ", L64(_varn_base + vi * 8), " is read and written through its address (`&g` with a `*_ptr` form); a value-form vector is a local", 0 - 1);
    return 1;
}
# ⛔ 6.7.16 — `var c: S;` AT TOP LEVEL (PARSE_VAR, after the first statement; an uninitialized struct or vector, which
# only a fn's frame holds) is refused IN SYNC, at its `;` — the refusal latched with no mark, so the resync skipped
# the next statement — and declares nothing: it registered a fn-local slot no top-level use reads, so each use of
# `c` added "undefined variable 'c'". `c` is entered as reported (`_dl_var_refd_add`): its uses stand down. The `;`
# is stepped. CHANGELOG [6.7.16]
fn _usl_top(S, noff): i64 {
    _refuse_in_sync(S);
    ERR_MSG(S, "uninitialized struct locals only allowed inside a function", 58);
    _dl_var_refd_add(S, noff);
    STI(S, GTI(S) + 1);
    return 0;
}
# The declaration ladder's named-type head (`_tn_head`, cursor on the annotation). 6.7.8 (C2-6a): a
# slice is refused by name (the user's decision, 2026-10-10: "a slice declared in the declaration
# zone" — `var GS: [u8] = 0;` was `expected '=', got identifier 'u8'`, `slice<u8>` "unknown type
# 'slice'") and consumed to its last token, which the ladder steps past: the global is a plain word,
# so its uses do not cascade. A top-level slice AFTER the first statement is PARSE_VAR's and keeps
# compiling (used through slice_ptr(&GS) / slice_len(&GS)).
fn _gvar_ann_head(S, noff): i64 {
    var ti = GTI(S);
    if (_sl_ann_at(S, ti) == 0) { return _tn_head_var(S, noff); }   # 6.7.14 (D15 (a)): a non-type refused
    _sl_err(S, ti, "a slice cannot be declared in the declaration zone (6.7.8: slices are fn-locals)",
      " - declare it in a fn; a top-level slice after the first statement is used through slice_ptr / slice_len");
    _sl_ann_skip(S);
    STI(S, GTI(S) - 1);
    return 0;
}
# A declaration with no `=` where its initializer belongs (the cursor there; PARSE_VAR, EMIT_GVAR_INITS): a bare
# `var X;` is "uninitialized variable not allowed", any other token "expected '='". A `;` the annotation reported
# already (`var b: ;`, `_tn_head_var`) is that one error: the statement is latched quietly, as the refusal latches it.
# CHANGELOG [6.7.15]
# 6.7.16: at a `;` the refusal is in sync — PARSE_VAR ends the declaration at that `;` (`_var_eq_step`) — so it marks
# where (`_pair_sync_ti`, read by `_stmt_resync`); the annotation's own report at the `;` latched already, so that arm
# marks unconditionally. CHANGELOG [6.7.16]
# ⛔ 6.7.16 — AND NOT AFTER A REFUSED ANNOTATION: `var q: Q;` (Q a refused late struct) and `var q: Foo;` added
# "uninitialized variable not allowed" to the annotation's error — the refusal left the variable a plain word, which
# the rule reads as a scalar with no value; a struct local takes no initializer. The annotation was refused and names
# no type (`_decl_ann_refd`): latched quietly, in sync, as the `var c: ;` arm is; the declaration registers (its uses
# stand down through the annotation's mark). A type the annotation still names keeps the error (`var q: i64;`, `var
# q: *Foo;` — a pointer needs its value either way). CHANGELOG [6.7.16]
fn _decl_eq_err(S): i64 {
    if (PEEKT(S) == 5) {
        if (_tn_seen_at(S, GTI(S)) == 1) { _pair_sync_ti = GTI(S); _panic = 1; return 0; }
        if (_decl_ann_refd(S) == 1) { _pair_sync_ti = GTI(S); _panic = 1; return 0; }
        _refuse_in_sync(S);
        ERR_MSG(S, "uninitialized variable not allowed; use `var X = 0;` or initial value", 69);
    }
    ERR_EXPECT(S, 4);
    return 0;
}
# 1 = the declaration whose `;` is at the cursor is `var NAME: T .. ;` and its annotation T was refused and names no
# type (`_tup_ann_refd`: a name no type answers that was reported or that a refused declaration declared, or a token
# that is no type, reported). Walked back to its `var` (a `;` / `{` / `}` first: not this shape).
fn _decl_ann_refd(S): i64 {
    var k = GTI(S) - 1;
    var go = 1;
    while (go == 1) {
        if (k < 0) { return 0; }
        var t = TOKTYP(S, k);
        if (t == 3) { go = 0; }
        elif (t == 5 || t == 13 || t == 14) { return 0; }
        else { k = k - 1; }
    }
    if (TOKTYP(S, k + 1) != 2) { return 0; }
    if (TOKTYP(S, k + 2) != 49) { return 0; }
    if (k + 3 >= GTI(S)) { return 0; }
    if (_tup_ann_refd(S, k + 3) == 0) { return 0; }
    _had_error = 1;
    return 1;
}
# ⛔ 6.7.16 — A BARE `var c;` / `var c: ;` ENDS AT ITS OWN `;`. PARSE_VAR's `=` step (the cursor where the `=` belongs)
# stepped the `;` after the refusal and read the NEXT statement as the initializer; the resync then dropped that
# statement, so `var c; var d = 9; return d;` added "undefined variable 'd'" and `c = 4;` "undefined variable 'c'".
# Now the `;` is left for the declaration's own end, the value is a 0 (`_var_value`: no struct-literal, inference or
# expression read — each needs a token the `;` is not) and the name is registered. Out of PARSE_VAR (a cybs-ceiling
# fn). Any other token is "expected '='" and stepped, as before. CHANGELOG [6.7.16]
var _var_bare_at = 0 - 1;
fn _var_eq_step(S): i64 {
    if (PEEKT(S) == 4) { STI(S, GTI(S) + 1); return 0; }
    if (_synonly_sib_local(S) == 0) { _decl_eq_err(S); }   # 6.7.16: `var a: Foo;`, Foo a sibling's (lint)
    if (PEEKT(S) == 5) { _var_bare_at = GTI(S); return 1; }
    STI(S, GTI(S) + 1);
    return 0;
}
# ⛔ 6.7.16 — `--syntax-only` (cyrius lint), A LOCAL OF A SIBLING MODULE'S STRUCT: `var a: Foo;` / `var b: Box<i64>;`
# with Foo / Box declared in another file. A struct local takes no initializer, but here the name answers no type, its
# annotation's refusal is silent under the flag, and the bare-declaration rule read a word with no value: "uninitialized
# variable not allowed", which lint does not count as context (`_lint_msg_is_context`), so lint refused the file —
# the ordinary layout of a manifest that concatenates modules (the v6.5.19 class). 1 = the declaration whose `;` is at
# the cursor is `var NAME: X;` or `var NAME: X<..>;` with X a name no type answers here: accepted, as the unit's build
# accepts it. `var p: *Foo;` (a pointer needs its value), `var x: i64;` and a type this file declares keep the
# refusal. CHANGELOG [6.7.16]
fn _synonly_sib_local(S): i64 {
    if (_syntax_only != 1) { return 0; }
    if (PEEKT(S) != 5) { return 0; }
    var k = GTI(S) - 1;
    var go = 1;
    while (go == 1) {
        if (k < 0) { return 0; }
        var t = TOKTYP(S, k);
        if (t == 3) { go = 0; }
        elif (t == 5 || t == 13 || t == 14) { return 0; }
        else { k = k - 1; }
    }
    if (TOKTYP(S, k + 1) != 2) { return 0; }
    if (TOKTYP(S, k + 2) != 49) { return 0; }
    var a = k + 3;
    if (TOKTYP(S, a) != 2) { return 0; }
    if (a + 1 != GTI(S)) {
        if (TOKTYP(S, a + 1) != 19) { return 0; }
        if (_tok_targs_close(S, a + 2) != GTI(S) - 1) { return 0; }
    }
    if (_tn_resolve_at(S, a) != 0) { return 0; }
    return 1;
}
# PARSE_VAR's value: the expression, or a bare declaration's 0 (an untyped word) at its `;` — refused, so a `*T`
# declaration says nothing more about it (`_tp_refd_at`, `_tp_warn`).
fn _var_value(S): i64 {
    if (_var_bare_at != GTI(S)) {
        if (_istr_pvd(S) == 1) { return 0; }   # 6.7.16 (D73): `var y: *Str = *p;` is p
        _var_value_pc(S);
        return 0;
    }
    _var_bare_at = 0 - 1;
    _tp_refd_at = GTI(S);
    EMOVI(S, 0);
    SPSC(S, 0);
    SESTYPE(S, 0);
    SEXW(S, 0);
    return 0;
}
# ⛔ 6.7.16 — AN UNTYPED `var t = ( .. );` WHOSE INITIALIZER WAS REFUSED STANDS DOWN AS A REFUSED ANNOTATION'S DOES.
# `var t = (1 2);` (no `,`: not a tuple literal, so the parenthesised expression `(1`, refused at `2`) declared t a
# scalar, and `t.1` added "no struct type in scope for 't'" after "expected ')', got number 2"
# (issues/archived/2026-10-19-commaless-two-element-tuple-leaves-name-untyped.md); `(1 + )` the same. The initializer the
# latch went up in (0 -> 1), a `(` group after an untyped `var NAME =`, marks NAME (`_ann_refd_mark`: the
# registration binds it), so `t.1`, `t.0 = 5` and `t.m()` are counted, not reported. An initializer that is no `(`
# group (`var t = zz;`) keeps its uses' reports. CHANGELOG [6.7.16]
fn _var_value_pc(S): i64 {
    var p0 = _panic;
    var st = GTI(S);
    PCMPE(S);
    if (p0 == 0) { if (_var_val_refd(S) == 1) { _var_paren_refd(S, st); } }
    return 0;
}
# 1 = the value just parsed was refused: the latch is up, or the wrap the untyped peel stepped into (`_scv_peel`, in
# a fn) is not closed where the value stopped — its close (`_scv_disarm`'s `_pw_close`) will refuse it there:
# `var t = (1 2);` stops at `2` inside the peeled `( .. )`.
fn _var_val_refd(S): i64 {
    if (_panic == 1) { return 1; }
    var i = 0;
    while (i < _scv_pk) {
        if (TOKTYP(S, GTI(S) + i) != 11) { return 1; }
        i = i + 1;
    }
    return 0;
}
# The value parsed from token `st` — inside the wrap the untyped peel stepped into (`_scv_un_peel`), if any — began
# at a `(` right after an untyped `var NAME =`: NAME marked.
fn _var_paren_refd(S, st): i64 {
    var b = st;
    while (TOKTYP(S, b - 1) == 10) { b = b - 1; }
    if (TOKTYP(S, b) != 10) { return 0; }
    if (TOKTYP(S, b - 1) != 4) { return 0; }
    if (TOKTYP(S, b - 2) != 2) { return 0; }
    if (TOKTYP(S, b - 3) != 3) { return 0; }
    _ann_refd_mark(S, TOKVAL(S, b - 2));
    return 0;
}
# ⛔ 6.7.14 — A REDECLARATION WHOSE INITIALIZER FOLDS (`= 2 + 1`, `= -5`, `= (7)`) IS COMPARED as a literal one is
# (CHKDUPVAL: "redefined with conflicting value", a same value silent). Only the exact `= NUM ;` was, so `var a = 5;
# var a = 2 + 1;` compiled silently while the prior side compared any folded constant
# (issues/archived/2026-10-15-redeclared-global-folded-later-value-not-compared.md). Not over an enum constant (CHK_ENUM_SHADOW's
# hard error is the one report there) nor a top-level const (refused at the name), and `chk_has` stays 0: it also gates
# CHK_ENUM_SHADOW. `has` / `v` = the declaration's fold. CHANGELOG [6.7.14]
fn _gv_dup_folded(S, noff, has, v, is_struct): i64 {
    if (has == 0) { return 0; }
    if (is_struct != 0) { return 0; }
    var pi = _findvar_core(S, noff);
    if (pi < 0) { return 0; }
    if (GVENUMID(S, pi) != 0) { return 0; }
    if (_vcst_ix(S, pi) >= 0) { return 0; }
    return CHKDUPVAL(S, noff, v);
}
# ⛔ 6.7.15 — A CONST- OR ENUM-NAMED REDECLARATION IS COMPARED (issues/2026-10-17-redeclared-global-named-constant-value-
# never-compared.md). Pass 1 folds no name, so `var a = 3; var a = C;`, `var a = C; var a = 3;`, `= E.B` and `var a =
# D; var a = C;` were never compared. The compare of a pair whose either side folds only at the replay is made there
# (_gvk_chain), in declaration order: pass 1 records what it knows in `_gvc_rec`, 4 words a record —
#   kind 0 (`_gvc_unfolded`): an initializer pass 1 cannot fold follows the slot's constant (`has`, value): the
#     chain's state before it;
#   kind 1 (`_gv_dup_later`): a constant after such an initializer — its compare, at its `=`, is the replay's;
# word 1 = the deferred entry the record precedes (the entry count when it was made). Every other pair is compared
# in pass 1, as before. CHANGELOG [6.7.15]
var _gvc_rec = 0;
var _gvc_n = 0;
var _gvc_cap = 0;   # in words
fn _gvc_add(S, kind, slot, v, x): i64 {
    if (_gvc_n * 4 + 4 > _gvc_cap) { _gvc_grow(); }
    var r = _gvc_rec + _gvc_n * 32;
    store64(r, kind + slot * 2);
    store64(r + 8, L64(S + 0x19A000));
    store64(r + 16, v);
    store64(r + 24, x);
    _gvc_n = _gvc_n + 1;
    return 0;
}
fn _gvc_grow(): i64 {
    if (_gvc_cap == 0) {
        _gvc_rec = alloc(256 * 8);
        _gvc_cap = 256;
        return 0;
    }
    _gvc_rec = _grow_one(_gvc_rec, _gvc_cap);
    _gvc_cap = _gvc_cap * 2;
    return 0;
}
# A deferred scalar entry of slot `gvi` that pass 1 did not fold (`k` = cf_has + is_struct, 0): the slot's constant
# so far is the chain's state before it, recorded once per run of such entries.
fn _gvc_unfolded(S, gvi, k): i64 {
    if (k != 0) { return 0; }
    if (_gv_pend_get(gvi) == 0) { if (_gv_has_lit(gvi) == 1) { _gvc_add(S, 0, gvi, L64(_vgsi_base + gvi * 8), 1); } }
    _gv_pend_set(gvi);
    return 0;
}
# 1 = pass 1 makes no value compare for this declaration (prior `gpi` from _gv_fold_peek; `has` / `v` its constant):
# its shape is refused — the type change is the one report, not also "conflicting value"
# (issues/archived/2026-10-16-global-type-change-refusal-cascades-into-earlier-reader.md) — or the prior's last declaration is
# one pass 1 did not fold, and the compare is recorded for the replay (kind 1, at the cursor: the `=`).
fn _gv_dup_later(S, gpi, has, v): i64 {
    if (gpi == 0 - 2) { return 1; }
    if (gpi < 0) { return 0; }
    if (has == 0) { return 0; }
    if (_gv_pend_get(gpi) == 0) { return 0; }
    _gvc_add(S, 1, gpi, v, GTI(S));
    return 1;
}
fn PARSE_GVAR_REG(S): i64 {
    var sti = GTI(S);
    STI(S, GTI(S) + 1);  # consume VAR
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var noff = PEEKV(S);
    _RSV_INTRINSIC_DECL(S, noff, GTI(S), 0);   # 6.6.20: a global `var sizeof` / `mulh64` / `fncallN`
    # 6.7.2 (B1): one top-level name is a const OR a global, never both.
    if (_cst_n > 0) { if (_cst_find(S, noff) >= 0) { ERR_IDENT(S, "", noff, " is already declared as a top-level const", 0 - 1); } }
    STI(S, GTI(S) + 1);
    _dt_ann1(S);   # 6.7.17: `var a: i64, b = f();` refused, its annotation stepped
    # v6.6.0 — TOP-LEVEL DESTRUCTURE, pass 1. `var t, v = f();` is the only correct way to
    # receive a `: stack` enum, so once Result went to the value form a top-level Result bind
    # had no legal spelling at all: this parser reached the annotation check with a `,` in hand
    # and reported `expected '=', got ','`. Registration is all pass 1 owes — the initializer is
    # replayed by EMIT_GVAR_INITS, which carries the matching branch. Handled inline and
    # returned early so none of the annotation / struct / static-init logic below has to learn
    # about multi-name declarations. CHANGELOG [6.6.0].
    if (PEEKT(S) == 31) {
        STI(S, GTI(S) + 1);   # consume ,
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
        var dg2 = PEEKV(S);
        _RSV_INTRINSIC_DECL(S, dg2, GTI(S), 0);
        STI(S, GTI(S) + 1);
        _dt_annk(S);
        var dg3 = 0;
        var dgn = 2;
        if (PEEKT(S) == 31) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            dg3 = PEEKV(S);
            _RSV_INTRINSIC_DECL(S, dg3, GTI(S), 0);
            STI(S, GTI(S) + 1);
            _dt_annk(S);
            dgn = 3;
        }
        # v6.6.4: ONE `public` covers EVERY name of the declaration. _GVAR_VIS clears the
        # marker after each stamp, so `public var A, B = f();` exposed A and stamped B
        # (and C) private. Restore it before each later name; the last stamp leaves it
        # cleared so nothing leaks past the declaration.
        # 6.6.6: each name goes through the one-global-per-name fold (_gv_fold).
        var _dg_pub = _pub_pending;
        var dgs1 = _gv_reg8(S, noff, 0, sti);
        _pub_pending = _dg_pub;
        var dgs2 = _gv_reg8(S, dg2, 0, sti);
        var dgs3 = 0 - 1;
        if (dgn == 3) {
            _pub_pending = _dg_pub;
            dgs3 = _gv_reg8(S, dg3, 0, sti);
        }
        _gzf_dt_reg(S, dgs1, dgs2, dgs3);   # 6.7.16 (D98): its f64 elements, typed at the end of pass 1
        _gv_defer(S, sti, (dgs1 + 1) | ((dgs2 + 1) << 21) | ((dgs3 + 1) << 42));
        _skip_gvar_decl(S, sti);   # 6.6.6: through the `;` outside every `{ }` (see there)
        return 0;
    }
    # Optional type annotation — check scalar types, pointer types, or struct names
    var psc = 0;
    var ann_sid = 0;
    var ann_scalar = 0;
    var ann_signed = 0;  # v6.4.23: 1 for a SIGNED sub-i64 (i8/i16/i32) global scalar → sign-extend on load
    var ann_float = 0;   # v6.2.19 math arc: F64_TYID / F32_TYID for `var x: f64`/`f32`
    var ann_ti = 0;      # 6.6.13 (M2): the annotation's type token (an array's element size)
    var ann_vec = 0;     # 6.6.17 (a3): a vector annotation's descriptor (<= -2048), else 0
    var ann_bool = 0;    # 6.7.3 (B2): `var g: bool` — its initializer is checked
    if (PEEKT(S) == 49) {
        STI(S, GTI(S) + 1);
        ann_ti = GTI(S);
        # 6.6.16 (C8): `*T` names a type (T resolved whole, an unknown T refused). 6.6.17: its
        # scale is sizeof(T), as at every other site (it was 8 here whatever T was).
        if (PEEKT(S) == 8) { psc = _ptr_annot(S, noff, 0); }
        elif (PEEKT(S) == 105) { ann_scalar = 16; STI(S, GTI(S) + 1); }
        else {
            if (_gvar_ann_head(S, noff) == 1) {   # 6.7.7 (B4): or a tuple type's `(`; 6.7.8: a slice refused
                # ⛔ 6.6.16 (C8): the one type-name resolver, as PARSE_VAR's ladder. This one
                # matched PREFIXES before the struct lookup (`var g: i8x = 300` was an i8 global,
                # `var g: u8pair;` a u8 scalar, `var g: f64v2` an f64) and read an unknown name as
                # a silent i64. A vector is a plain 8-byte global here, as it is after the first
                # statement (PARSE_VAR's global arm). CHANGELOG [6.6.16]
                var ann_c = _tn_ann(S, GTI(S), noff);
                ann_vec = _tn_vec(ann_c);   # 6.6.17 (a3): see _vecg_size
                ann_scalar = _tn_iw(ann_c);
                ann_signed = _tn_sgn(ann_c);
                ann_float = _tn_flt(ann_c);
                ann_sid = _tn_sid(ann_c);
                ann_bool = _tn_bool(ann_c);
            }
            STI(S, GTI(S) + 1);
            ann_sid = _gen_ann_sid(S, ann_sid);   # 6.6.11: `W1<Pt>` is the instance, not the base
        }
    }
    # Array: register with size. v5.11.51 — when the array has a
    # `= { byte-list };` initializer, PARSE_GVAR_ARR saves sti to
    # gvar_toks so EMIT_GVAR_INITS replays it at top-level emit time
    # (pass-1 emits get skipped by the entry-jmp patch).
    if (PEEKT(S) == 28) {
        var ann_eb = _gvar_ebytes(S, ann_scalar, ann_float, ann_sid, psc, ann_ti);   # 6.6.13 (M2)
        PARSE_GVAR_ARR(S, noff, sti, ann_scalar, ann_signed, ann_eb);
        return 0;
    }
    # Check for struct init after =: var p = StructName { ... }
    # Peek ahead: skip to = then check if next is IDENT matching a struct
    var save_peek = GTI(S);
    # We're past the type annotation, at = or the token before it
    # Find the = sign
    var pgo = 1;
    while (pgo == 1) {
        if (PEEKT(S) == 4) { pgo = 0; }
        else { if (PEEKT(S) == 5) { pgo = 0; }
            else { if (PEEKT(S) == 12) { pgo = 0; }
                else { STI(S, GTI(S) + 1); } } }
    }
    var is_struct = 0;
    var ssid = 0;
    # v5.11.64: detect `var X = INT_LITERAL ;` shape for static init.
    # Non-zero literals get pre-written into the var area at FIXUP time
    # so the value is correct on FIRST READ — fixes the kmode-entry
    # init-order bug where gvar reads before the post-PROG EMIT_GVAR_INITS
    # block returned 0. Zero literals fall through to the existing
    # runtime-store path (BSS-zero is already correct for them).
    # See CHANGELOG [5.11.64] + the filed issue.
    #
    # 6.6.6: a REDECLARATION reuses the global's slot (_gv_fold) and a constant one is
    # static too — the old shadow opt-out sent it to the runtime-store path while the FIRST
    # declaration's static value sat in a slot nothing read (b = 0 in `var a = 5; var b = a;
    # var a = 5;`). An earlier deferred store is now superseded rather than clobbering
    # (_gv_supersede), which is the hazard the opt-out existed for (mabda `var F64_TWO = 0;`
    # shadowed by math `var F64_TWO = 0x4000...;`). A declaration that shadows a global it does
    # NOT fold into — an enum constant, or a global with another visibility owner — is static
    # as well: each replay entry now stores into the slot it recorded (_gv_ent_slot), so an
    # earlier deferred store can no longer land on this one, and the enum's startup store skips
    # a slot that is not an enum constant's (PARSE_ENUM_DEF). CHANGELOG [6.6.6]
    var sit_lit = 0;
    var sit_val = 0;
    var sit_shadow = 0;
    var rhs_ti = 0;     # 6.7.3: the initializer's first token (a static bool is judged by its shape)
    var cf_has = 0;     # 6.6.6: the initializer folded to a constant (any target, any value)
    var cf_val = 0;
    var chk_lit = 0;    # v6.2.11: `= NUM ;` literal for the collision guardrail
    var chk_has = 0;
    # 6.6.6: _findvar_core, not FINDVAR — "does this name already exist?" asked while
    # REGISTERING this global is not a reference to the prior one, and running the cross-file
    # `private` check here refused a file its own re-declaration. See _findvar_core.
    if (_findvar_core(S, noff) >= 0) { sit_shadow = 1; }
    if (PEEKT(S) == 4) {
        STI(S, GTI(S) + 1);
