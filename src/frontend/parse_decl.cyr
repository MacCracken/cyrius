    SLTYPE(S, t, 0);
    SFLC(S, t + 1);
    if (t + 1 > _flc_hwm) { _flc_hwm = t + 1; }
    EFLSTORE(S, t);
    STI(S, GTI(S) + 1);                 # `.`
    var mnoff = PEEKV(S);
    STI(S, GTI(S) + 1);                 # the method name
    return _field_load_on(S, noff, mnoff, beg, 0 - 2 - t, 0);
