                # excluded by its `!= 0` guard below — same "unresolved = base" rule.)
                if (_gstc != 0 - 8 && _gstc != 0) { _do_inst = 1; }
                if (_gstc1 != 0 && _gstc1 != 0 - 8) { _do_inst = 1; }
