    if (gvi < 0) { return 0; }
    var k = gvi * 2 + w;
    if (k >= vec_len(_gu_cutv)) { return 0; }
    if (i < vec_get(_gu_cutv, k)) { return 1; }
    return 0;
}
# Note `i`'s global takes struct `sid` (`_gu_type`; a handle for a refused type-argument list, `_gu_hdl`), or with 0 is
# untyped as it was registered.
fn _gu_set(S, i, sid): i64 {
