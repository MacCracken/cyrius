              " from a fn returning *Str - its header lives in this frame and would dangle (return a handle: str_new(data, len))");
        }
        return _istr_esc(S, "cannot return the inline Str ",
          " from a fn returning Str - its header lives in this frame and would dangle (return a handle: str_new(data, len))");
    }
    return _istr_ra(S, r);
