    elif (_vcall_more(S, x, term) == 1) { return 0; }   # 6.7.16: a stray token is the parse's
    return r;
}
# ⛔ 6.7.13 (D34 A, the user's decision, 2026-10-15) — `var v: V = *p;` / `v = *p;` WITH `p: *V` COPY THE VECTOR
# THROUGH THE POINTER, as `var q: T = *p;` copies a struct (6.7.10 decision 6) and as `rd(*pv)` passes pv (D27): `*pv`
# has one meaning at every destination. Refused since 6.7.11 (the source is no local or call), and through 6.7.10 it
# stored one word with the high lanes stale (x86_64 210, aarch64 74, cx 98, PE 146 where 161 is right). Kind 4 of
# `_vrcv_src`: the source at token `ti`, ended by `term`, is ONE dereference `* E` inside any balanced parentheses
# (`_vrcv_k` of them) and nothing after it — `*p + q` is an operator's operand — by its tokens, as the struct
# declaration's `_hl_dstar_t` reads it. E's type is read once it is parsed (`_vrcv_demit`). CHANGELOG [6.7.13]
fn _vrcv_dsrc(S, ti, term): i64 {
