# 6.7.16: 0 = no call of `_vcall_vt`'s spellings can start the source at token `ti` — it opens with neither `(`,
# `callptr`, nor a name followed by `(` / `<` / `.` — so the scans are skipped (every declaration and assignment asks).
fn _vcv_maybe(S, ti): i64 {
    var t = TOKTYP(S, ti);
    if (t == 10) { return 1; }
    if (t == 137) { return 1; }
    if (t != 2) { return 0; }
    t = TOKTYP(S, ti + 1);
    if (t == 10) { return 1; }
    if (t == 19) { return 1; }
    if (t == 41) { return 1; }
    return 0;
