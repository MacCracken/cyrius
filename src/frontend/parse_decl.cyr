# The method `mf` named at token mt on struct `rs`, its call's `(` at o: the instance an inferred generic's arguments
# bind (`_mcall_gen`, quiet), an explicit one's (`_mco_inst`).
fn _dt_mfn(S, o, mf, mt, rs): i64 {
    if (mf < 0) { return mf; }
    if (o != mt + 1) { return _mco_inst(S, mf, mt, o); }
    return _mcall_gen(S, mf, o, rs, 0);
