# ⛔ 6.7.13 — D29 REACHES A STRUCT GLOBAL (the user's decision D6 (b), 2026-10-15: "the global copies; the handle
# keeps the word"). `var q = G;` in a fn with `G` an inline struct global (`var G: P = P { 3, 4 };`, GVPM 2: its slot
# IS the struct, as `_sci_global_src` reads it) took G's first word: `q.y` was "no struct type in scope for 'q'" and
# `tk(q)` passed the word as the struct's address (139). The global is a struct VALUE, so q is a copy of it, as
# `var q: P = G;` is (6.6.5) — at every size, in a fn and inside a closure. A name an enclosing fn's local shadows
# (a closure's snapshot) is not the global; a handle global (GVPM 1), a `*T` global, a tuple, a dyn and a vector
# keep the word, and at top level nothing changes (`_uci_ps`). CHANGELOG [6.7.13]
fn _uci_glob(S, snoff): i64 {
    if (_cl_capturing == 1) { if (_cl_snap_find(S, snoff) >= 0) { return 0; } }
    var gvi = FINDVAR(S, snoff);
    if (gvi < 0) { return 0; }
    if (GVPM(S, gvi) != 2) { return 0; }
    var t = GVTYPE(S, gvi);
    if (t <= 0) { return 0; }
    if (_uci_sid_ok(S, 0 - t) == 0) { return 0; }
