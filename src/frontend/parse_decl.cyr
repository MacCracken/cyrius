# 6.7.14: 1 = the `.m(` at the cursor is a bounded site recorded on a struct carrier's T field (`_bnd_fsite`,
# parse_fn.cyr) — `b.v.show()` with `b: Box<T>`, T bound here to a scalar.
fn _fld_bs_site(S): i64 {
    if (_bs_n == 0) { return 0; }
    if (_bs_find(S, GTI(S) + 1) < 0) { return 0; }
    return 1;
}
# ⛔ 6.7.14 — A BOUNDED CALL ON A CARRIER'S T FIELD AT A SCALAR T: `b.v.show()` with `b: Box<T>`, T = i64. A
# method on a scalar field leaf had no path at all ("expected ';', got '.'"); the bound's impl now takes the
# field's VALUE as `self`, as `t.show()` on a scalar `t: T` takes t's (`_bs_scalar_self`): the field loaded at
# its width (`_fld_leaf_load`), parked in an anonymous frame slot, and the method arm entered on that slot with
# no struct. A struct T keeps `_load_inline_hop`'s address. CHANGELOG [6.7.14]
fn _load_bs_field(S, noff, beg, idx, sid, off): i64 {
    _resolve_field_base_addr(S, idx, sid);
