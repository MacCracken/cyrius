# The drop is a cut per slot — each vector's length at the fold, below which the slot's notes read as dropped — not a
# scan of every note: a scan per redeclaration made the zone quadratic in its redeclared globals (globals_scale_linear's
# redecl row, 10k -> 20k 3.7x; 10k 1,211 ms where 6.7.16 took 167). CHANGELOG [6.7.17]
var _gu_cutv = 0;   # per global slot `vi`: [vi * 2] the `_gu_v` length, [vi * 2 + 1] the `_gzf_v` length at its last fold
fn _gu_drop(vi): i64 {
    if (_gu_cutv == 0) { _gu_cutv = vec_new(); }
    while (vec_len(_gu_cutv) <= vi * 2 + 1) { vec_push(_gu_cutv, 0); }
    var n = 0;
    if (_gu_v != 0) { n = vec_len(_gu_v); }
    vec_set(_gu_cutv, vi * 2, n);
    n = 0;
    if (_gzf_v != 0) { n = vec_len(_gzf_v); }
    vec_set(_gu_cutv, vi * 2 + 1, n);
    return 0;
}
# 1 = the note at word `i` of slot `gvi` is one a redeclaration dropped (`w` 0: `_gu_v`, 1: `_gzf_v`).
fn _gu_cut_at(gvi, w, i): i64 {
