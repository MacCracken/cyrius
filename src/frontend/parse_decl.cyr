        var asv_sz = STRUCTSZ(S, asv_sid - 1);
        if (asv_sz < 8) { asv_sz = 8; }
        var asv_aligned = (asv_sz + 7) & (0 - 8);
        var asv_nslots = asv_aligned / 8;
        # Duplicate-name check
        var asv_existing = FINDLOCAL(S, noff);
        if (asv_existing >= 0) {
            if (GLDEP(S, asv_existing) == GSDEP(S)) { ERRDUPVAR(S); }
        }
        # Reserve ceil(sz/8) fn-local slots; name the last (see Phase 2a for
        # the anonymous-filler + named-last trick).
        var asv_j = 0;
        while (asv_j < asv_nslots - 1) {
            var asv_li = GFLC(S);
            S64(S + 0x5D9D000 + asv_li * 8, 0 - 1);
            SLDEP(S, asv_li, GSDEP(S));
            SLTYPE(S, asv_li, 0);
            SFLC(S, asv_li + 1);
            asv_j = asv_j + 1;
        }
        var asv_named = GFLC(S);
        S64(S + 0x5D9D000 + asv_named * 8, noff);
        SLDEP(S, asv_named, GSDEP(S));
        SLTYPE(S, asv_named, 0 - asv_sid);
        SFLC(S, asv_named + 1);
        # Now `got` is allocated. Parse `= IDENT(args);`.
        STI(S, GTI(S) + 1);                         # consume '='
        if (PEEKT(S) != 2) {
            ERR_MSG(S, "struct-valued assignment RHS must be a fn call", 47);
        }
        var asv_fnoff = PEEKV(S);
        STI(S, GTI(S) + 1);                         # consume fn-name IDENT
        # v6.3.37 (B1 half-B): skip a monomorph `<typeargs>` list between the fn-name
        # and `(` so `var p: Pair<i64> = mk<i64>(...)` reaches the retptr-receive path.
        if (_MONOMORPH_OK == 1) { if (PEEKT(S) == 19) {
            STI(S, GTI(S) + 1);   # consume `<`
            _ta_pending_gt = 0;
            _parse_one_type_arg(S);
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); _parse_one_type_arg(S); }
            _consume_gt(S);
        } }
        if (PEEKT(S) != 10) {
            ERR_MSG(S, "struct-valued assignment RHS must be a fn call", 47);
        }
        var asv_fi = FINDFN(S, asv_fnoff);
        if (asv_fi < 0) { asv_fi = REGFN(S, asv_fnoff); }
        var asv_callee_sid = GFRS(S, asv_fi);
        if (asv_callee_sid == 0) {
            ERR_MSG(S, "fn does not declare a struct return type", 40);
        }
        if (asv_callee_sid != asv_sid) {
            ERR_MSG(S, "fn return struct-id differs from declared var type", 51);
        }
        STI(S, GTI(S) + 1);                         # consume '('
        # Push hidden retptr as first arg on x86 (SysV: RDI, Win64:
        # RCX) — ECALLPOPS / EPOPARG reverse-pops the stack into
        # arg regs in user-arg order, with retptr counted as arg 0.
        # On aarch64 (v5.9.26), the retptr lives in X8 (dedicated
        # indirect-result register, AAPCS64 §6.9), separate from the
        # X0..X7 user-arg sequence. Skip the stack push here; load
        # X8 directly via EFLADDR_X8 AFTER the regular args are
        # popped into X0..X5, so the cross-call register state is:
        #   x86:     [RDI=retptr, RSI=arg0, RDX=arg1, ...]
        #   aarch64: [X0=arg0, X1=arg1, ..., X8=retptr]
        var asv_argc = 0;
        if (_AARCH64_BACKEND == 0) {
            EFLADDR(S, asv_named);
            EPUSHR(S);
            asv_argc = 1;
        }
        if (PEEKT(S) != 11) {
            var asv_go = 1;
            while (asv_go == 1) {
                PCMPE(S);
                EPUSHR(S);
                asv_argc = asv_argc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { asv_go = 0; }
            }
        }
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        STI(S, GTI(S) + 1);                         # consume ')'
        ECALLPOPS(S, asv_argc);
        if (_AARCH64_BACKEND == 1) {
            EFLADDR_X8(S, asv_named);
        }
        var asv_fn_target = L64(_fnt_offsets + asv_fi * 8);
        if (asv_fn_target >= 0) { ECALLTO(S, asv_fn_target); }
        else { ECALLFIX(S, asv_fi); }
        ECALLCLEAN(S, asv_argc);
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);                         # consume ';'
        return 0;
    }
    # v5.10.45 Phase 1 — asv_pair path for 9-16B int-class non-Str
    # struct returns. Caller-side mirror of parse_fn.cyr's pair-
    # return branch: allocate multi-slot for the receiver, call the
    # fn normally (no retptr arg), receive rax+rdx into the slots
    # via EFLSTORE_STRUCT_INT_PAIR. Same allocation shape as asv_try
    # (multi-slot named-last + filler-above sentinel) so dot-syntax
    # field access works.
    if (asv_pair == 1) {
        var asp_sid = 0 - pscale;
        var asp_sz = STRUCTSZ(S, asp_sid - 1);
        var asp_aligned = (asp_sz + 7) & (0 - 8);
        var asp_nslots = asp_aligned / 8;
        # Duplicate-name check
        var asp_existing = FINDLOCAL(S, noff);
        if (asp_existing >= 0) {
            if (GLDEP(S, asp_existing) == GSDEP(S)) { ERRDUPVAR(S); }
        }
        # Reserve ceil(sz/8) fn-local slots; name the last (deepest).
        var asp_j = 0;
        while (asp_j < asp_nslots - 1) {
            var asp_li = GFLC(S);
            S64(S + 0x5D9D000 + asp_li * 8, 0 - 1);
            SLDEP(S, asp_li, GSDEP(S));
            SLTYPE(S, asp_li, 0);
            SFLC(S, asp_li + 1);
            asp_j = asp_j + 1;
        }
        var asp_named = GFLC(S);
        S64(S + 0x5D9D000 + asp_named * 8, noff);
        SLDEP(S, asp_named, GSDEP(S));
        SLTYPE(S, asp_named, 0 - asp_sid);
        SFLC(S, asp_named + 1);
        # Parse `= IDENT(args);`
        STI(S, GTI(S) + 1);                         # consume '='
        if (PEEKT(S) != 2) {
            ERR_MSG(S, "struct-valued assignment RHS must be a fn call", 47);
        }
        var asp_fnoff = PEEKV(S);
        STI(S, GTI(S) + 1);                         # consume fn-name IDENT
        # v6.3.37 (B1 half-B): skip a monomorph `<typeargs>` list (see asv_try above).
        if (_MONOMORPH_OK == 1) { if (PEEKT(S) == 19) {
            STI(S, GTI(S) + 1);   # consume `<`
            _ta_pending_gt = 0;
            _parse_one_type_arg(S);
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); _parse_one_type_arg(S); }
            _consume_gt(S);
        } }
        if (PEEKT(S) != 10) {
            ERR_MSG(S, "struct-valued assignment RHS must be a fn call", 47);
        }
        var asp_fi = FINDFN(S, asp_fnoff);
        if (asp_fi < 0) { asp_fi = REGFN(S, asp_fnoff); }
        var asp_callee_sid = GFRS(S, asp_fi);
        if (asp_callee_sid == 0) {
            ERR_MSG(S, "fn does not declare a struct return type", 40);
        }
        if (asp_callee_sid != asp_sid) {
            ERR_MSG(S, "fn return struct-id differs from declared var type", 51);
        }
        STI(S, GTI(S) + 1);                         # consume '('
        # NO hidden retptr — pair-return uses rax/rdx, not RDI.
        var asp_argc = 0;
        if (PEEKT(S) != 11) {
            var asp_go = 1;
            while (asp_go == 1) {
                PCMPE(S);
                EPUSHR(S);
                asp_argc = asp_argc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { asp_go = 0; }
            }
        }
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        STI(S, GTI(S) + 1);                         # consume ')'
        ECALLPOPS(S, asp_argc);
        var asp_fn_target = L64(_fnt_offsets + asp_fi * 8);
        if (asp_fn_target >= 0) { ECALLTO(S, asp_fn_target); }
        else { ECALLFIX(S, asp_fi); }
        ECALLCLEAN(S, asp_argc);
        # Receive rax+rdx into the 2-slot local.
        EFLSTORE_STRUCT_INT_PAIR(S, asp_named);
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);                         # consume ';'
        return 0;
    }
    # Check for array: var buf[N];  (v6.2.1: `var buf: T[N]` passes the
    # element width via scalar_type so i64[N] reserves N slots, etc.;
    # bare `var buf[N]` has scalar_type==0 → legacy byte sizing.)
    if (PEEKT(S) == 28) {
        PARSE_ARRAY(S, noff, scalar_type);
        return 0;
    }
    # expect EQ
    # v5.8.42: special-case the bare-decl `var X;` shape with a
    # specific diagnostic. Pre-fix the generic ERR_EXPECT emitted
    # "expected '=', got ';'" which doesn't tell the user what
    # to do. Mabda C1 surfacing — devs ported from C/Go expected
    # `var X;` to declare a zero-init slot and got the cryptic
    # generic message. Now: a clear "uninitialized variable not
    # allowed; use `var X = 0;` or initial value" pointing at
    # the specific fix.
    if (PEEKT(S) != 4) {
        if (PEEKT(S) == 5) {
            ERR_MSG(S, "uninitialized variable not allowed; use `var X = 0;` or initial value", 70);
        }
        ERR_EXPECT(S, 4);
    }
    STI(S, GTI(S) + 1);
    # Check for struct init: var p = StructName { expr, expr, ... };
    # v5.9.33 (agnosys 1.1.12 follow-up): require the next-next token to be
    # `{` before committing to the struct-init path. A bare ident reference
    # like `var sig = status & 0x7F;` (where `status` is also defined as a
    # struct name elsewhere in the file) must fall through to the scalar
    # expression branch — NOT enter PARSE_STRUCT_INIT and error on the
    # missing `{`. Surfaced on aarch64 because aarch64's larger syscalls
    # file pushes WIFSIGNALED's name offset past the 64 KB DCE bitmap
    # window so the fn body is parsed even when unreferenced; on x86 the
    # same fn DCE's away and masks the bug.
    if (PEEKT(S) == 2) {
        var sn = PEEKV(S);
        var sid = FINDSTRUCT(S, sn);
        if (sid > 0) {
            if (TOKTYP(S, GTI(S) + 1) == 13) {
                PARSE_STRUCT_INIT(S, noff, sid);
                return 0;
            }
        }
    }
    # v5.10.4 — type inference at var-decl. Peek the RHS shape
    # BEFORE PCMPE evaluates it: if the RHS is a fn call
    # `IDENT(...)` and the fn has a known return-struct-id
    # (via GFRS — set by the fn's `: ReturnType` annotation), we
    # capture the inferred sid here and apply it as SLTYPE later.
    # Closes the agnosys-shape `var out = str_builder_build(sb);
    # println(out);` pattern: post-v5.10.4, `out` inherits Str
    # type from str_builder_build's `: Str` annotation, then the
    # v5.10.3 overload dispatch routes `println(out)` to
    # `println_str` correctly. Only fires when no explicit type
    # annotation is present (pscale == 0 && scalar_type == 0 —
    # both are SET when `: Type` is parsed earlier in this fn).
    var _ti_inferred_sid = 0;
    if (pscale == 0) { if (scalar_type == 0) {
        if (PEEKT(S) == 2) {
            # v6.3.37 (B2): infer the local's struct type from BOTH a plain `IDENT (`
            # and a monomorph generic `IDENT < ... > (` call — so `var b = mk<i32>(...)`
            # types `b` as the struct (its GFRS return sid) and `b.x`/`b.w` parse.
            var _ti_iscall = 0;
            if (TOKTYP(S, GTI(S) + 1) == 10) { _ti_iscall = 1; }
            if (_ti_iscall == 0) { if (_MONOMORPH_OK == 1) { if (TOKTYP(S, GTI(S) + 1) == 19) {
                var _ti_gfi = FINDFN(S, PEEKV(S));
                if (_ti_gfi >= 0) { if (GFTP(S, _ti_gfi) != 0) { _ti_iscall = 1; } }
            } } }
            if (_ti_iscall == 1) {
                var _ti_noff = PEEKV(S);
                var _ti_fi = FINDFN(S, _ti_noff);
                if (_ti_fi >= 0) {
                    _ti_inferred_sid = GFRS(S, _ti_fi);
                }
            }
        }
    } }
    # v6.3.36: `var g = f;` where f is a CLOSURE_TYID local copies the closure's
    # heap-object pointer — propagate the tag so callptr(g,…) auto-dispatches
    # (load fn_ptr from [g], pass g as env) instead of jumping into the object
    # (undispatched → SIGSEGV). Only when the RHS is EXACTLY the identifier
    # (next token `;` = 5), never part of an expression like `f + 0`.
    var _ti_closure_copy = 0;
    if (pscale == 0) { if (scalar_type == 0) {
        if (PEEKT(S) == 2) { if (TOKTYP(S, GTI(S) + 1) == 5) {
            var _cc_fi = FINDLOCAL(S, PEEKV(S));
            if (_cc_fi >= 0) { if (GLTYPE(S, _cc_fi) == CLOSURE_TYID) { _ti_closure_copy = 1; } }
        } }
    } }
    # parse expression (scalar) — use PCMPE for comparisons and &&/||
    _expr_closure_obj = 0;   # v6.3.8 — fresh; the RHS closure sets it if capturing
    PCMPE(S);
    # Type check: warn if pointer/scalar mismatch
    var expr_ps = GPSC(S);
    if (pscale > 0) {
        if (expr_ps == 0) { WARN(S, "assigning non-pointer to typed pointer", 38); }
    }
    # Check if inside function → local variable
    if (GINFN(S) == 1) {
        # Reject duplicate local var names
        # Allow same name in different scope (shadowing)
        var existing = FINDLOCAL(S, noff);
        if (existing >= 0) {
            if (GLDEP(S, existing) == GSDEP(S)) { ERRDUPVAR(S); }
        }
        var li = GFLC(S);
        # v5.8.16 §8: 16-byte locals (slice, u128) layout-flip.
        # The slice convention puts ptr@offset 0 and len@offset 8
        # (slice_set / slice_ptr / slice_len all assume this).
        # On the stack, slot N+1 sits at a LOWER address than slot
        # N (locals grow down). Pre-fix we wrote the slice's ptr
        # field to slot li (the higher address) and treated slot
        # li+1 (the lower address) as the unused "high half" — but
        # then `slice_set(&s, ...)` issued `store64(&s + 8, len)`,
        # which lands at saved-rbp position rather than slot li+1.
        # §7 indexing tests passed by luck — they wrote and read
        # the corrupted location consistently and exited before
        # the corrupted rbp surfaced. §8 dot-field access made the
        # mismatch impossible to ignore (`s.len` reads from a
        # location slice_set never wrote to).
        #
        # Fix: for scalar_type==16, allocate the HIGH-HALF slot
        # FIRST (slot li, higher address) and the CANONICAL slot
        # SECOND (slot li+1, lower address). The name + meta live
        # on slot li+1 so FINDLOCAL returns it; EFLADDR(li+1)
        # yields the lower address; EFLADDR(li+1) + 8 lands on
        # slot li (higher address) = the second 8 bytes the
        # convention expects. Now slice_set / slice_ptr /
        # slice_len work correctly on fn-local slices, no rbp
        # corruption, no consumer changes.
        if (scalar_type == 16) {
            # High-half slot (allocated first, higher address) —
            # nameless, tracks no scope. This is where addr+8
            # lands once we install the canonical slot below.
            S64(S + 0x5D9D000 + li * 8, 0);
            SLDEP(S, li, 0);
            SLTYPE(S, li, 0);
            SSLICE_W(S, li, 0);
            # Canonical (lower-address) slot — this is what the
            # name resolves to; EFLADDR returns its address.
            var li_canon = li + 1;
            S64(S + 0x5D9D000 + li_canon * 8, noff);
            SLDEP(S, li_canon, GSDEP(S));
            SLTYPE(S, li_canon, 0);
            SSLICE_W(S, li_canon, slice_elt_w);
            # Init the high half (slice .len / u128 high u64) via
            # ADDRESS-based memory store rather than EFLSTORE(li).
            # Reason: the regalloc post-body peephole counts
            # `mov [rbp+disp32], rax` patterns per slot to decide
            # which locals to pin to callee-saved regs. The high
            # half has no user-visible name, so nothing else takes
            # its address via `&<ident>` — without addressing it
            # via &canonical+8 here, the only reference would be
            # an EFLSTORE the picker would patch to `mov rbx, rax`,
            # leaving the actual stack slot uninitialized. Address-
            # based init writes through [rcx], which the picker
            # doesn't count, so the high slot stays in memory and
            # subsequent &s+8 reads (slice_len, .len dot-syntax)
            # see the right value.
            #
            # rax holds the RHS expr value at this point (0 for the
            # canonical `var s: [u8] = 0;` form). PCMPE already
            # parsed it; EPUSHR / EPOPR around the addr setup keeps
            # the value while rcx is loaded.
            EPUSHR(S);                 # save RHS value (rax)
            EFLADDR_X1(S, li_canon);   # rcx = &slice (canonical slot address)
            EADDIMM_X1(S, 8);          # rcx = &slice + 8 (high half)
            EPOPR(S);                  # restore RHS value to rax
            ESTOC(S);                  # store rax to [rcx] = high half
            EFLSTORE(S, li_canon);     # init canonical slot (slice .ptr / u128 low u64) — safe from regalloc patching because slice_set / slice_ptr take &s via EFLADDR, marking the canonical slot address-taken
            SFLC(S, li_canon + 1);
        } else {
            S64(S + 0x5D9D000 + li * 8, noff);
            SLDEP(S, li, GSDEP(S));
            if (lfloat != 0) {
                # f64/f32 local: tag the slot's type so access SESTYPEs it; store
                # the 8-byte value (f64 bits, or f32 bits in the low 32).
                SLTYPE(S, li, lfloat);
                EFLSTORE(S, li);
            } elif (scalar_type > 0) {
                if (scalar_type < 8) {
                    SLTYPE(S, li, scalar_type);
                    EFLSTORE_W(S, li, scalar_type);
                } else {
                    SLTYPE(S, li, 0);
                    EFLSTORE(S, li);
                }
            } else {
                # v5.10.4 — fold inferred sid (peeked pre-PCMPE) into
                # the no-annotation branch so `var x = f();` picks
                # up f's `: ReturnType` annotation as x's SLTYPE.
                # NOTE: scalar return inference (negative GFRS, i.e.
                # `var n = strlen(s);` where strlen is `: i64`) was
                # tried at v5.10.5 with SLTYPE = positive width
                # (8 for i64), but that encoding tripped the
                # parse_expr.cyr:263 width-aware load path which
                # SEXW(S, 8) marks expr_width = 8 and downstream
                # arithmetic emit narrowed incorrectly (`hlen -
                # nlen` returned -29 instead of 6 in the tcyr
                # strstr regression). Reverted: scalar-return
                # inference deferred to the future slot pinned at
                # `CYRIUS_TYPE_CHECK` default-on flip — same root
                # cause (need scalar-vs-pointer per-param distinction
                # before tracking i64-as-i64 vs i64-as-pointer).
                if (_expr_closure_obj == 1) {
                    # v6.3.8 — RHS is a capturing closure object; tag so callptr
                    # auto-dispatches (load fn_ptr from [obj], pass obj as env).
                    SLTYPE(S, li, CLOSURE_TYID);
                } elif (_ti_closure_copy == 1) {
                    # v6.3.36 — RHS is a copy of an existing closure local
                    # (`var g = f`); carry the tag so callptr(g,…) dispatches.
                    SLTYPE(S, li, CLOSURE_TYID);
                } elif (_ti_inferred_sid > 0) {
                    SLTYPE(S, li, 0 - _ti_inferred_sid);
                } else {
                    SLTYPE(S, li, pscale);
                }
                EFLSTORE(S, li);
            }
            # v5.8.14 §6: per-local slice element width (0 = not a slice).
            SSLICE_W(S, li, slice_elt_w);
            # v6.3.35: mark a SIGNED sub-i64 scalar local with a NEGATIVE sentinel in the
            # (otherwise-0-for-scalars) slice-width table — slice-logic only checks `>0`, so
            # the sentinel is invisible to it. The load reads it to sign-extend (movsx).
            if (scalar_signed == 1) { if (slice_elt_w == 0) { SSLICE_W(S, li, 0 - scalar_type); } }
            SFLC(S, li + 1);
        }
    } else {
        var vcnt = GVCNT(S);
        S64(_varn_base + vcnt * 8, noff);
        if (lfloat != 0) {
            # f64/f32 local: 8-byte slot + float type marker → PEXPR/PARSE_TERM
            # route operators to EMIT_F64_BINOP (f32 type-only, converted via f32_*).
            S64(_vars_base + vcnt * 8, 8);
            SVTYPE(S, vcnt, lfloat);
            EVSTORE(S, vcnt);
        } elif (scalar_type > 0) {
            if (scalar_type < 8) {
                S64(_vars_base + vcnt * 8, scalar_type);
                SVTYPE(S, vcnt, scalar_type);
                EVSTORE_W(S, vcnt, scalar_type);
            } else {
                # 8 (i64 explicit) or 16 (u128) — allocate the full width.
                # Pre-4.8.0-alpha3 this hardcoded 8, truncating u128 vars
                # declared in the PARSE_PROG path (e.g. after a top-level
                # expression statement like `alloc_init();` that stops
                # pass 1 — see main.cyr's pass-1 loop termination).
                S64(_vars_base + vcnt * 8, scalar_type);
                EVSTORE(S, vcnt);
            }
        } else {
            S64(_vars_base + vcnt * 8, 8);
            if (pscale > 0) { SVTYPE(S, vcnt, 0 - pscale); }
            EVSTORE(S, vcnt);
        }
        SLVAR(S, vcnt);
        SVCNT(S, vcnt + 1);
    }
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    return 0;
}

# PARSE_ASSIGN removed v5.5.40 closeout — assignment is handled inline
# by PARSE_STMT's expression path (assignment-as-expression). The fn
# was orphaned across every main_*.cyr entry point per the DCE audit.
