    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);                 # consume the field / method name
    _field_load_on(S, noff, fnoff, beg, 0 - 2 - t, sid);
    _cfo = 0;
    return 1;
}
# A method declared `: *T`, T a struct (`psid`): its result (rax) is parked as a pointer receiver and
# the chain continues through it — a field, a method, a deeper chain — in a fn and at top level, as a
# free call's `*T` result does (`_call_ptr_field`). It was refused with "it does not return a struct"
# (issues/archived/2026-10-10-field-of-method-pointer-result-refused.md). CHANGELOG [6.7.11]
fn _mchain_ptr(S, noff, beg, psid): i64 {
    var h = _ptr_park(S, psid);
    if (_cpf_try(S, noff, beg, h, psid) == 1) { _cfo = 0; return 1; }   # 6.7.13 (D8 (a)): `o.gp().n = v;`
    STI(S, GTI(S) + 1);                 # `.`
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);                 # the field / method name
    _field_load_on(S, noff, fnoff, beg, h, psid);
    _cfo = 0;
    return 1;
}
# rax = a struct result returned in rax (a <= 8 B struct's bytes, or a `Str` handle): stored in a
# fresh temp laid out as `_struct_call_emit` lays out a class-0 result. Returns the temp's slot.
fn _mchain_temp(S, sid): i64 {
    var t = 0;
    if (STRUCTSZ(S, sid - 1) > 8) { t = _ptr_temp(S, sid); }
    else { t = _agg_temp(S, sid); }
    EFLSTORE(S, t);
    return t;
}
# The rest of a refused chain: every `.name`, `<..>` list (`_mchain_targs`) and `(..)`. 6.7.16: a method's explicit
# list too — `var gx = GP.q().mm<f64>(2.5);` at top level read its `<` as less-than after the refusal ("undefined
# variable 'f64'", "expected ';', got '>'"). CHANGELOG [6.7.16]
fn _mchain_skip(S): i64 {
    while (_mchain_at(S, GTI(S)) == 1) {
        STI(S, _mchain_targs(S, GTI(S) + 2));
        if (PEEKT(S) == 10) { STI(S, _call_close(S, GTI(S)) + 1); }
    }
    return 0;
}

# ⛔ 6.6.17 — A FIELD CHAIN THROUGH A POINTER FIELD. `struct Node { val; next: *Node; }`:
# `n.next.val` was `expected ';', got '.'` (a `*T` field is an untyped word to the chain resolver,
# which walks only INLINE struct fields), while a `*Node` local or parameter takes `p.val` —
# pointer-to-struct dot syntax. Now when the leaf of a chain is a `*T` field, T a struct, and
# `.name` follows, the field's VALUE (the pointer) is loaded and parked as a pointer-mode
# receiver (`_ptr_hop`), and the chain continues from it exactly as from a `*T` local: fields,
# nested fields, further hops (`n.next.next.val`), a method (`n.next.m()`), reads and writes,
# from a local, global, parameter, capture, call result or field chain, in a fn and at top level.
# The pointee struct of the leaf field `_rlf_si` / `_rlf_fi` when `.name` follows it, else 0.
fn _fld_hop_sid(S): i64 {
    if (_mchain_at(S, GTI(S)) == 0) { return 0; }
    return _fld_ptr_sid(S, _rlf_si, _rlf_fi);
}
# rax = the field at `off` of receiver (idx, sid) — the pointer — then park it: a frame slot in a
# fn, a dead pointer-mode global at top level (`_HTEMP`). Returns the receiver's encoding.
fn _ptr_hop(S, idx, sid, off, psid): i64 {
    _resolve_field_base_addr(S, idx, sid);
    if (off > 0) { EADDIMM_X1(S, off); }
    EFIELD_LOAD_W(S, 8);
    return _ptr_park(S, psid);
}
# rax = a pointer to struct `psid`: park it as a pointer-mode receiver (see `_ptr_hop`).
fn _ptr_park(S, psid): i64 {
    if (GINFN(S) == 1) {
        var t = _ptr_temp(S, psid);
        EFLSTORE(S, t);
        return 0 - 2 - t;
    }
    var vi = 0 - 2 - _HTEMP(S);
    SVTYPE(S, vi, psid);
    SVPM(S, vi, 1);
    EVSTORE(S, vi);
    return vi;
}
# ⛔ 6.7.0 (A5) — A METHOD ON A NESTED INLINE FIELD: `b.v.sum()`, `p.v.sum()`, `mk(3).v.sum()`. The
# leaf walk (`_resolve_leaf_field`) stops before a `.method(` on a struct-typed field, and nothing
# took it from there: `expected ';', got '.'`. The field's ADDRESS (the base's, as a method's `self`
# is computed, plus the field's offset) is parked as a pointer receiver of the field's struct and the
# call continues from it, as `_ptr_hop` continues from a `*T` field's value. An address inside this
# frame is handed to the callee, so the fn is marked as escaping one (`_fn_local_addr`, the v6.5.14
# tail-call guard) whenever the base is an inline local. CHANGELOG [6.7.0]
fn _fld_meth_inline(S, ft): i64 {
    if (PEEKT(S) != 41) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
    if (TOKTYP(S, GTI(S) + 2) != 10) { return _mtargs_ng(S, ft, GTI(S) + 1); }   # 6.7.14 (D7 (a)): `.m<..>(`
    if (ft <= 0) { return _fld_bs_site(S); }   # 6.7.14: a bounded call on a scalar T field
    return 1;   # 6.7.15: a `Str` field too — `_load_inline_hop` passes its value (`_load_str_hop`)
}
# ⛔ 6.7.15 — A METHOD ON A `Str` FIELD: `w.s.len()`, `w.s.clone()`, `w.s.eq(x)`, `p.s.len()` through a `*W`,
# `mk().s.len()`, `w.s.print();` as a statement (issues/archived/2026-10-17-method-call-on-str-field-does-not-parse.md). A
# `Str` field is one pointer slot holding the header's address (6.6.17), so the walk stopped before the `.m(` and
# nothing took it: "expected ';', got '.'". The receiver is the field's VALUE — the header, as `h.len()` passes a
# handle's value and `str_len(w.s)` passes the field — loaded and parked as a `*Str` receiver (`_ptr_hop`), as a
# `*T` field's method continues (`_load_hop`); never the field's address, which the inline arm passes. CHANGELOG
# [6.7.15]
fn _load_str_hop(S, noff, beg, idx, sid, off): i64 {
    var ft = GETFTYPE(S, _rlf_si, _rlf_fi);
    var h = _ptr_hop(S, idx, sid, off, ft);
    STI(S, GTI(S) + 1);                 # `.`
    var mnoff = PEEKV(S);
    STI(S, GTI(S) + 1);                 # the method name
    return _field_load_on(S, noff, mnoff, beg, h, ft);
