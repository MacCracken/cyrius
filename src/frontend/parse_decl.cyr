                            STI(S, GTI(S) + 1);  # consume ')'
                            ECALLPOPS(S, _f2w_argc);
                            var _f2w_target = L64(_fnt_offsets + _f2c_look_fi * 8);
                            if (_f2w_target >= 0) { ECALLTO(S, _f2w_target); }
                            else { ECALLFIX(S, _f2c_look_fi); }
