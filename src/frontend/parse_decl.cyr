var _istr_ti = 0 - 1;   # ... and `_istr_at`'s name token
var _istr_am = 0;       # 6.7.16: 1 = `_istr_at` read the name through `*(& NAME)` (`_istr_amp`)
# The whole expression [b, e), inside any balanced parentheses, is one name `_istr_name` answers: 1 an inline
# `Str` local of this frame, 2 an inline `Str` global, 3 a closure's captured copy of one; else 0.
# 6.7.16 (D71): or `*(& NAME)` / `*&NAME` of one (`_istr_amp`).
fn _istr_at(S, b, e): i64 {
    var a = _ie_unparen(S, b, e);
    if (_ie_pe != a + 1) { return _istr_amp(S, a, _ie_pe); }
    if (TOKTYP(S, a) != 2) { return 0; }
    _istr_ti = a;
