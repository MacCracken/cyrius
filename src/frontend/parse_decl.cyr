# The method arm's name token: `_meth_targs`'s, taken once, else the token before the cursor's `(`.
fn _mx_take(S): i64 {
    if (_mx_ti < 0) { return GTI(S) - 1; }
    var t = _mx_ti;
    _mx_ti = 0 - 1;
    return t;
