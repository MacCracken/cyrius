# PARSER — declarations: PARSE_ARRAY / PARSE_FIELD_LOAD /
# PARSE_FIELD_STORE / EMIT_STRUCT_FIELD_W / PARSE_STRUCT_INIT /
# PARSE_GVAR_ARR / PARSE_GVAR_REG / EMIT_GVAR_INITS / PARSE_VAR /
# PARSE_ASSIGN + BUILD_METHOD_NAME.
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38 to keep single-file
# LOC under ~1500. Included by parse.cyr at the same textual position
# the original content lived; self-host byte-identical.

fn PARSE_ARRAY(S, noff, ew): i64 {
    STI(S, GTI(S) + 1);  # consume [
    # v5.10.48: accept either NUM literal OR an IDENT that resolves
    # to a compile-time-known enum constant (via enum_const_val at
    # 0x1D8000, marker bit 63 set per v5.5.2 fold registration).
    # Closes `docs/development/issues/2026-05-03-parser-cosmetic-
    # limits-...` `var_bracket_size_must_be_literal`. Plain `var
    # NAME = LITERAL;` named constants stay unsupported here —
    # cyrius has no named-constant infrastructure outside enums;
    # the idiomatic pattern is `enum Sz { BUF = 16; } var buf[BUF];`.
    var asz = 0;
    if (PEEKT(S) == 1) {
        asz = PEEKV(S);
        STI(S, GTI(S) + 1);
    } else {
        if (PEEKT(S) == 2) {
            var as_noff = PEEKV(S);
            var as_idx = FINDVAR(S, as_noff);
            if (as_idx >= 0 && as_idx < 1024) {
                var as_ecv = L64(_vecv_base + as_idx * 8);
                if (as_ecv < 0) {
                    asz = as_ecv & 0x7FFFFFFFFFFFFFFF;
                    STI(S, GTI(S) + 1);
                } else {
                    ERR_MSG(S, "array size identifier must be an enum constant (compile-time literal); use `enum Sz { N = 16; } var buf[N];`", 113);
                }
            } else {
                ERR_MSG(S, "array size identifier must be an enum constant (compile-time literal); use `enum Sz { N = 16; } var buf[N];`", 113);
            }
        } else {
            ERR_EXPECT(S, 1);
        }
    }
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);  # consume ]
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);  # consume ;
    # Arrays inside functions are globals. To avoid name collisions between
    # functions (e.g. two functions both with `var buf[N]`), always register
    # a NEW global even if one with the same name exists. FINDVAR returns
    # the last match, so the current function's array shadows previous ones.
    # v6.2.1: element-typed fixed array `var a: T[N]` reserves
    # N elements of T. `ew` is the element width in bytes (from the
    # `: T` annotation: i8/u8=1 … i64/u64=8, u128=16). ew==0 is the
    # bare `var a[N]` form — keep the legacy "N bytes rounded to 8"
    # local convention. `i64[N]` (ew==8) is the unambiguous SLOT
    # spelling that fixes the address-taken-local slot-idiom footgun
    # (issue 2026-06-11; daimon). All backends inherit the byte size
    # from this 0x12A000 table. See CHANGELOG [6.2.1].
    var aligned = (asz + 7) & (0 - 8);
    if (ew > 0) { aligned = (asz * ew + 7) & (0 - 8); }
    # v6.3.13 (thread-safe array locals): a `var arr[N]` INSIDE a function goes to a
    # per-thread STACK slot block (the struct-local mechanism) instead of the shared
    # global/BSS data region, so concurrent code can't alias one global buffer. Reserve
    # ceil(aligned/8) fn-local slots: anonymous fillers (name -1) at the shallow end +
    # one NAMED slot at the deepest offset, so &arr (FINDLOCAL → ELOAD_LOCAL_ADDR =
    # `lea [rbp-disp]`) points at arr[0] and arr[i] indexes upward. Gated; default off →
    # the legacy global path below stays byte-identical. (Large arrays → heap: follow-on.)
    # v6.3.15 auto-fallback: an array that would push this fn past the per-fn frame-slot
    # budget (SFLC hard-caps at 16384; leave headroom for scalars) stays in the legacy
    # shared global data region rather than overflowing the slot table. Only pathological
    # cases hit this (>~120 KB of array in ONE fn — e.g. sigil hash_file_into's 256 KB I/O
    # scratch buffer); such arrays were global before v6.3.15 too, so it is NOT a
    # regression — every concurrency-relevant crypto fn (≤ ~5000 slots) still goes
    # per-thread. Emit a note so the dev knows this specific buffer isn't per-thread.
    var sa_on = 0;
    if (_ensure_stack_arrays(S) == 1) { if (GINFN(S) == 1) { sa_on = 1; } }
    if (sa_on == 1) {
        var sa_need = aligned / 8;
        if (sa_need < 1) { sa_need = 1; }
        if (GFLC(S) + sa_need + 1 >= 15360) {
            sa_on = 0;
            syscall(SYS_WRITE, 2, "note: oversized array local kept in shared global (not per-thread) - exceeds per-fn stack budget; use alloc()\n", 110);
        }
    }
    if (sa_on == 1) {
        var sa_nslots = aligned / 8;
        if (sa_nslots < 1) { sa_nslots = 1; }
        var sa_existing = FINDLOCAL(S, noff);
        if (sa_existing >= 0) { if (GLDEP(S, sa_existing) == GSDEP(S)) { ERRDUPVAR(S); } }
        # v6.3.15: 16-align the array base for SSE m128 operands — `pxor`/`aesenc`
        # `xmm, [arr]` (AES-NI / sigil crypto / TLS) FAULT (#GP) on an 8-aligned address.
        # Global arrays got 16-alignment via the v5.5.21 totvar pad; stack slots are only
        # 8-aligned. rbp is 16-aligned by the frame ABI, so &arr = [rbp - disp] is
        # 16-aligned iff disp ≡ 0 mod 16. The named (deepest) slot lands at
        # disp = (named+1)*8 + regalloc*8 + retstash — mirroring the &arr / arr[i]
        # FINDLOCAL disp math (parse_expr / parse_decl). Every term is a multiple of 8,
        # so disp % 16 ∈ {0, 8}; if 8, one extra anonymous filler shifts the whole array
        # 8 B deeper → 16-aligned. Only for arrays ≥ 16 B (the m128-operand candidates).
        if (aligned >= 16) {
            var sa_named0 = GFLC(S) + sa_nslots - 1;
            var sa_disp = (sa_named0 + 1) * 8;
            if (_cur_fn_regalloc > 0) { sa_disp = sa_disp + _cur_fn_regalloc * 8; }
            if (_cur_fn_ret_stash > 0) { sa_disp = sa_disp + _cur_fn_ret_stash; }
            if (sa_disp % 16 == 8) {
                var sa_pad = GFLC(S);
                S64(S + 0x5D9D000 + sa_pad * 8, 0 - 1);
                SLDEP(S, sa_pad, GSDEP(S));
                SLTYPE(S, sa_pad, 0);
                SFLC(S, sa_pad + 1);
            }
        }
        var sa_j = 0;
        while (sa_j < sa_nslots - 1) {
            var sa_li = GFLC(S);
            S64(S + 0x5D9D000 + sa_li * 8, 0 - 1);
            SLDEP(S, sa_li, GSDEP(S));
            SLTYPE(S, sa_li, 0);
            SFLC(S, sa_li + 1);
            sa_j = sa_j + 1;
        }
        var sa_named = GFLC(S);
        S64(S + 0x5D9D000 + sa_named * 8, noff);
        SLDEP(S, sa_named, GSDEP(S));
        SLTYPE(S, sa_named, 0);
        SFLC(S, sa_named + 1);
        return 0;
    }
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, noff);
    S64(_vars_base + vcnt * 8, aligned);
    SVCNT(S, vcnt + 1);
    # v5.11.62: accumulate the array's byte cost into the current fn's
    # attribution slot at 0x1C8000. Top-level `var foo[N]` (no enclosing
    # fn, _cur_fn_ix == -1) skip the accumulation. Read by FIXUP's
    # `large static data` warning to surface "M bytes inside N
    # unreachable fns".
    if (_cur_fn_ix >= 0) {
        S64(S + 0x1C8000 + _cur_fn_ix * 8,
            L64(S + 0x1C8000 + _cur_fn_ix * 8) + aligned);
    }
    return 0;
}

# Build mangled method name: StructName_method in tok_names scratch.
# Returns noff of the combined name. Uses the region AFTER current
# npos as scratch — writing past live identifiers so FINDFN's byte
# compare sees a clean name. Does NOT advance npos (this is lookup-
# only; the method fn was registered at struct-def time).
# Pre-4.7.1 this wrote to a fixed offset 30000, which silently
# corrupted real identifiers in any program with >30 KB of names.
# Bote saw the downstream mis-parse as `lib/assert.cyr:3: expected
# '=', got string` because a post-corruption token noff now pointed
# at garbled bytes.
fn BUILD_METHOD_NAME(S, si, mnoff): i64 {
    var snoff = L64(S + 0x1A6018 + si * 8);
    # v5.11.65 (CVE-05): walk source lengths first so NPOS_GUARD
    # bounds the actual write — replaces the pre-v5.11.65 magic-256
    # pessimistic budget that the byte-copy loops below could exceed
    # on a long struct/method identifier. See CHANGELOG [5.11.65].
    var _snlen = 0; while (load8(S + 0x60000 + snoff + _snlen) != 0) { _snlen = _snlen + 1; }
    var _mnlen = 0; while (load8(S + 0x60000 + mnoff + _mnlen) != 0) { _mnlen = _mnlen + 1; }
    NPOS_GUARD(S, _snlen + 1 + _mnlen + 1);
    var scratch = GNPOS(S);
    var wp = scratch;
    # Copy struct name
    var ri = 0;
    var rc = load8(S + 0x60000 + snoff + ri);
    while (rc != 0) {
        store8(S + 0x60000 + wp, rc);
        wp = wp + 1;
        ri = ri + 1;
        rc = load8(S + 0x60000 + snoff + ri);
    }
    # Underscore separator
    store8(S + 0x60000 + wp, 95);
    wp = wp + 1;
    # Copy method name
    ri = 0;
    rc = load8(S + 0x60000 + mnoff + ri);
    while (rc != 0) {
        store8(S + 0x60000 + wp, rc);
        wp = wp + 1;
        ri = ri + 1;
        rc = load8(S + 0x60000 + mnoff + ri);
    }
    store8(S + 0x60000 + wp, 0);
    return scratch;
}

# Load a struct field: ident.field → emit load from var_addr + field_offset
# Or call a method: ident.method(args) → call StructName_method(&ident, args)
fn PARSE_FIELD_LOAD(S, noff): i64 {
    STI(S, GTI(S) + 1);  # consume DOT
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);

    # Find the variable and its struct type (check locals first)
    var idx = 0 - 1;
    var sid = 0;
    if (GINFN(S) == 1) {
        var lli = FINDLOCAL(S, noff);
        if (lli >= 0) {
            var lt = GLTYPE(S, lli);
            # v6.4.4: SIMD vector sentinels (f64v2 -20, f64v4 -21, and the
            # descriptor band <= -2048, e.g. f32v4 -2121) are NOT struct ids.
            # Without this guard `0 - lt` yields 2121 -> si=2120, which blows
            # past the 1024-entry struct tables (OOB read in BUILD_METHOD_NAME
            # / FINDFIELD). Vectors expose lanes via fN_laneK(&v), not `.field`.
            if (lt == 0 - 20 || lt == 0 - 21 || lt <= 0 - 2048) {
                ERR_MSG(S, "SIMD vector has no named fields", 31);
            }
            if (lt < 0) { sid = 0 - lt; }
            idx = 0 - 2 - lli;
            # v5.8.16 §8: slice dot-syntax field load (s.ptr / s.len).
            # A slice fn-local has GLTYPE=0 and GSLICE_W>0 (per-local
            # element width set in §6). The slice occupies a 16-byte
            # 2-slot block: slot lli (canonical, lower address) holds
            # `.ptr` at offset 0; slot lli-1 (higher address allocated
            # ahead of the canonical slot per the §8 layout-flip)
            # holds `.len` at offset 8.
            #
            # Both fields lower to address-based loads (EFLADDR + add
            # + ELODC) rather than direct EFLLOAD against the slot
            # number. Reason: the regalloc post-body peephole pins
            # hot user-locals to callee-saved registers via "time-
            # sliced sharing" (parse_fn.cyr v5.6.20). The picker
            # treats any slot accessed only through `mov rax,
            # [rbp+disp]` / `mov [rbp+disp], rax` as eligible for
            # register routing — it bars `&local` (lea) accesses,
            # which is exactly the bar we want here.
            #
            # The slice's low slot (canonical) is naturally barred
            # because slice_set / slice_ptr / etc. take its address
            # via `&s`. The HIGH slot (lli-1) has no user-visible
            # name, so no `&` is ever taken against it directly —
            # but slice_set writes to it via the low-slot address
            # plus 8 bytes (a memory write the regalloc picker
            # cannot see). If §8 read the high slot via EFLLOAD
            # directly, the picker would happily allocate rbx for
            # it; the EFLLOAD would patch to `mov rax, rbx` and
            # read the stale rbx value (caller's saved rbx, never
            # updated by slice_set's memory write). Reading via
            # &s + 8 keeps the access pattern equivalent to
            # slice_len's helper-fn path and stays out of the
            # regalloc patcher's way.
            var sw = GSLICE_W(S, lli);
            if (sw > 0) {
                var fname = L64(S + 0x60000 + fnoff);
                var fld_off = 0 - 1;
                if (fname & 0xFFFFFFFF == 0x00727470) { fld_off = 0; }      # "ptr\0"
                elif (fname & 0xFFFFFFFF == 0x006E656C) { fld_off = 8; }    # "len\0"
                else { ERR_MSG(S, "slice has only .ptr and .len fields", 36); }
                EFLADDR_X1(S, lli);
                if (fld_off > 0) { EADDIMM_X1(S, fld_off); }
                ELODC(S);
                return 0;
            }
        }
    }
    if (idx == 0 - 1) {
        idx = FINDVAR(S, noff);
        if (idx < 0) {
            syscall(SYS_WRITE, 2, "error:", 6); FM_LOOKUP(S, GTLINE(S, GTI(S))); syscall(SYS_WRITE, 2, ": undefined variable '", 22);
            PRSTR(S + 0x60000 + noff); syscall(SYS_WRITE, 2, "'\n", 2); syscall(SYS_EXIT, 1);
        }
        sid = GVTYPE(S, idx);
    }
    var si = 0;
    if (sid > 0) { si = sid - 1; }

    # Method call: ident.method(args)
    if (PEEKT(S) == 10) {
        if (sid == 0) { ERR(S); }
        var mname = BUILD_METHOD_NAME(S, si, fnoff);
        # Push &var as first arg (self) — handle locals and globals
        if (idx < 0 - 1) {
            var mli = 0 - idx - 2;
            EFLLOAD(S, mli);
        } else {
            EVADDR(S, idx);
        }
        EPUSHR(S);
        # Parse remaining args
        STI(S, GTI(S) + 1);  # consume (
        var argc = 1;
        if (PEEKT(S) != 11) {
            var mgo = 1;
            while (mgo == 1) {
                PCMPE(S);
                EPUSHR(S);
                argc = argc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { mgo = 0; }
            }
        }
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        STI(S, GTI(S) + 1);  # consume )
        ECALLPOPS(S, argc);
        var mfi = FINDFN(S, mname);
        if (mfi < 0) { mfi = REGFN(S, mname); }
        var mfoff = L64(_fnt_offsets + mfi * 8);
        if (mfoff >= 0) { ECALLTO(S, mfoff); }
        else { ECALLFIX(S, mfi); }
        ECALLCLEAN(S, argc);
        return 0;
    }

    if (sid == 0) { ERR(S); }
    var fi = FINDFIELD(S, si, fnoff);
    if (fi < 0) { ERR(S); }
    var off = FIELDOFF(S, si, fi);
    # Check for chained access: s.inner.field
    var ft = GETFTYPE(S, si, fi);
    if (ft > 0) { if (PEEKT(S) == 41) {
            # Nested struct — chain the dot access
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var ifnoff = PEEKV(S);
            STI(S, GTI(S) + 1);
            var isi = ft - 1;
            var ifi = FINDFIELD(S, isi, ifnoff);
            if (ifi < 0) { ERR(S); }
            off = off + FIELDOFF(S, isi, ifi);
            # v6.3.33: the load width must come from the LEAF field, not the
            # intermediate struct. Pre-fix `ft` stayed the inner struct sid, so
            # FIELDSZ returned its size (e.g. 8 for a 2×i32 Pair) → a 64-bit load
            # that ignored a sub-i64 leaf (`x.y.z` with z: i8/i16/i32 read wide).
            # Re-point `ft` at the leaf so FIELDSZ/EFIELD_LOAD_W pick the true width
            # (leaf i64 → 0 → 8; leaf struct → its size — both unchanged).
            ft = GETFTYPE(S, isi, ifi);
        } }
    # Load variable address + field offset, then load value (width-correct).
    # idx < -1 is a local-encoded index from the struct-local branch above
    # (idx = 0 - 2 - lli, so lli = 0 - 2 - idx). v5.5.36 Phase 2: route
    # through EFLADDR_X1 (lea rcx, [rbp - disp]) instead of the global
    # EVADDR_X1 (movabs rcx, abs64 + fixup), which would register a bogus
    # global fixup for the local-encoded negative idx.
    #
    # v5.8.17 §9: distinguish pointer-to-struct from inline-struct
    # locals. The v5.5.36 inline path reserves ceil(STRUCTSZ/8)
    # consecutive slots and tags all but the last (named) slot
    # with the sentinel name `-1`. A pointer-to-struct local
    # (e.g., `var s: Str = str_from(...)` where the RHS returns
    # a heap pointer) takes a single slot whose value IS the
    # pointer. The two patterns reach this branch with the same
    # GLTYPE encoding (`-sid`) but need different addressing:
    #   inline:  rcx = &slot (lea — slot IS the struct's bytes)
    #   pointer: rcx = [slot] (mov — slot HOLDS the struct's pointer)
    # Disambiguate by checking the previous slot: if it carries
    # the sentinel name -1, this slot is the named tail of an
    # inline allocation; otherwise it's a single-slot pointer.
    # Slot 0 has no predecessor, so it's pointer-mode by
    # construction (inline structs always reserve at least one
    # filler slot before the named slot when STRUCTSZ > 8).
    if (idx < 0 - 1) {
        var lf_lli = 0 - 2 - idx;
        var lf_is_ptr = 1;
        if (lf_lli > 0) {
            if (L64(S + 0x5D9D000 + (lf_lli - 1) * 8) == 0 - 1) { lf_is_ptr = 0; }
        }
        # v6.3.16: a struct-local whose type fits in <= 8 bytes occupies exactly ONE
        # slot that HOLDS THE VALUE (inline) — never a pointer — so it must use
        # `lea &slot`, not `mov [slot]`. The sentinel-predecessor test above can't see
        # this: a single-slot inline struct has no -1 filler, so it was mislabelled a
        # pointer-to-struct → `mov [slot]` dereferenced the garbage value → SIGSEGV on
        # x86 + aarch64 (cx was already correct). Only STRUCTSZ > 8 single-slot locals
        # are genuine pointers (Str, 16 B via rax). Closes single-field-struct-segfaults.
        # NOT on cx: the cx backend BOXES structs (the slot always holds a pointer, even
        # for uninit / by-value ≤8B), so pointer mode is correct there — forcing inline
        # would break the cx struct-byval parity test. Gate on the inline-struct targets.
        if (_TARGET_CX == 0) { if (sid > 0) { if (STRUCTSZ(S, sid - 1) <= 8) { lf_is_ptr = 0; } } }
        if (lf_is_ptr == 1) {
            # Pointer-to-struct: load the slot's value into rax,
            # then move into rcx as the struct's base pointer.
            EFLLOAD(S, lf_lli);
            EMOVCA(S);
        } else {
            # Inline struct: take the slot's address as the
            # struct's base.
            EFLADDR_X1(S, lf_lli);
        }
    } else { EVADDR_X1(S, idx); }
    if (off > 0) { EADDIMM_X1(S, off); }
    var fld_sz = FIELDSZ(S, ft);
    # v5.9.40 — sub-byte struct field load now goes through the
    # per-backend `EFIELD_LOAD_W` helper. Closes Phase 2c #2 (cx
    # was the only remaining ERR_MSG path; aarch64 had landed at
    # v5.9.27, x86 has been there since v5.6.12). Each backend's
    # helper handles widths 1/2/4 with its native sub-byte load
    # encoding and falls through to ELODC for width 8.
    # v6.3.35: a sub-i64 struct field (ft = -width, i.e. -1/-2/-4) is SIGNED — the
    # struct-def only recognizes i8/i16/i32 (never u8/u16/u32) into the -width encoding,
    # so a negative ftype is always signed. Pass a negative width → sign-extend (movsx).
    if (ft < 0) { fld_sz = 0 - fld_sz; }
    EFIELD_LOAD_W(S, fld_sz);
    return 0;
}

# Store to a struct field: ident.field = expr; or ident.inner.field = expr;
fn PARSE_FIELD_STORE(S, noff): i64 {
    STI(S, GTI(S) + 1);  # consume DOT
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);
    # Find the variable and its struct type (check locals first — mirror
    # of PARSE_FIELD_LOAD's lookup so v5.5.36's stack-local structs route
    # through EFLADDR_X1 instead of the global-var EVADDR_X1 + fixup).
    var idx = 0 - 1;
    var sid = 0;
    if (GINFN(S) == 1) {
        var lli = FINDLOCAL(S, noff);
        if (lli >= 0) {
            var lt = GLTYPE(S, lli);
            # v6.4.4: SIMD vector sentinels are not struct ids — reject `.field`
            # before `0 - lt` escapes the 1024-entry struct tables. See the
            # mirror guard in PARSE_FIELD_LOAD.
            if (lt == 0 - 20 || lt == 0 - 21 || lt <= 0 - 2048) {
                ERR_MSG(S, "SIMD vector has no named fields", 31);
            }
            if (lt < 0) { sid = 0 - lt; }
            idx = 0 - 2 - lli;
            # v5.8.16 §8: slice dot-syntax field store (s.ptr = expr;
            # s.len = expr;). Mirror of the slice-load path in
            # PARSE_FIELD_LOAD — both fields use the address-based
            # store (EFLADDR + add + ESTOC) rather than direct
            # EFLSTORE against the slot number. See PARSE_FIELD_LOAD
            # for the regalloc-picker explanation: routing the high
            # slot through EFLSTORE would let the picker allocate a
            # callee-saved register for it, and the s.len store would
            # land in the register only — invisible to slice_set's
            # subsequent memory reads. Address-based store keeps the
            # memory write authoritative.
            var sw = GSLICE_W(S, lli);
            if (sw > 0) {
                var fname = L64(S + 0x60000 + fnoff);
                var fld_off = 0 - 1;
                if (fname & 0xFFFFFFFF == 0x00727470) { fld_off = 0; }      # "ptr\0"
                elif (fname & 0xFFFFFFFF == 0x006E656C) { fld_off = 8; }    # "len\0"
                else { ERR_MSG(S, "slice has only .ptr and .len fields", 36); }
                if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
                STI(S, GTI(S) + 1);
                PCMPE(S);
                EPUSHR(S);
                EFLADDR_X1(S, lli);
                if (fld_off > 0) { EADDIMM_X1(S, fld_off); }
                EPOPR(S);
                ESTOC(S);
                if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                STI(S, GTI(S) + 1);
                return 0;
            }
        }
    }
    if (idx == 0 - 1) {
        idx = FINDVAR(S, noff);
        if (idx < 0) {
            syscall(SYS_WRITE, 2, "error:", 6); FM_LOOKUP(S, GTLINE(S, GTI(S))); syscall(SYS_WRITE, 2, ": undefined variable '", 22);
            PRSTR(S + 0x60000 + noff); syscall(SYS_WRITE, 2, "'\n", 2); syscall(SYS_EXIT, 1);
        }
        sid = GVTYPE(S, idx);
    }
    if (sid == 0) { ERR(S); }
    var si = sid - 1;
    var fi = FINDFIELD(S, si, fnoff);
    if (fi < 0) { ERR(S); }
    var off = FIELDOFF(S, si, fi);
    # Check for chained access: s.inner.field = expr;
    var ft = GETFTYPE(S, si, fi);
    if (ft > 0) { if (PEEKT(S) == 41) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var ifnoff = PEEKV(S);
            STI(S, GTI(S) + 1);
            var isi = ft - 1;
            var ifi = FINDFIELD(S, isi, ifnoff);
            if (ifi < 0) { ERR(S); }
            off = off + FIELDOFF(S, isi, ifi);
            # v6.3.33: mirror of PARSE_FIELD_LOAD — the store width must come from
            # the LEAF field. Pre-fix `ft` stayed the inner struct sid, so a nested
            # `x.y.z = v` (z: i8/i16/i32) took the else/ESTOC 64-bit store, writing 8
            # bytes over a 4-byte leaf (truncation lost + neighbor clobber).
            ft = GETFTYPE(S, isi, ifi);
        } }
    if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
    STI(S, GTI(S) + 1);
    PCMPE(S);
    # Store value to struct field (width-correct). Route to local or
    # global addr-emit based on idx encoding (same convention as
    # PARSE_FIELD_LOAD; v5.5.36 Phase 2). v5.8.17 §9: same
    # pointer-vs-inline disambiguation as PARSE_FIELD_LOAD —
    # see that fn for the sentinel-based detection rationale.
    EPUSHR(S);
    if (idx < 0 - 1) {
        var fs_lli = 0 - 2 - idx;
        var fs_is_ptr = 1;
        if (fs_lli > 0) {
            if (L64(S + 0x5D9D000 + (fs_lli - 1) * 8) == 0 - 1) { fs_is_ptr = 0; }
        }
        # v6.3.16: <=8-byte struct-local is inline (holds the value in its one slot),
        # never a pointer → lea &slot, not mov [slot]. Mirror of PARSE_FIELD_LOAD; see
        # there. Fixes single-field struct field STORE segfault on x86 + aarch64. Not on
        # cx (boxes structs — pointer mode is correct there).
        if (_TARGET_CX == 0) { if (sid > 0) { if (STRUCTSZ(S, sid - 1) <= 8) { fs_is_ptr = 0; } } }
        if (fs_is_ptr == 1) {
            EFLLOAD(S, fs_lli);
            EMOVCA(S);
        } else {
            EFLADDR_X1(S, fs_lli);
        }
    } else { EVADDR_X1(S, idx); }
    if (off > 0) { EADDIMM_X1(S, off); }
    EPOPR(S);
    var fst_sz = FIELDSZ(S, ft);
    if (fst_sz == 1) { ESTORE8(S); }
    elif (fst_sz == 2) { ESTORE16(S); }
    elif (fst_sz == 4) { ESTORE32(S); }
    else { ESTOC(S); }
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    return 0;
}

# Parse struct init: var name = StructName { expr, expr, ... };
# sid is 1-based struct id, noff is var name offset.
# v5.9.36: width param picks the matching storeN encoding so
# narrow-typed fields (i8/i16/i32) write only their declared
# width — pre-fix the always-store64 path overflowed past
# `STRUCTSZ`-allocated storage at global scope (e.g. `var p32 =
# point_i32 { 100, 200, 300 }` allocated 12 bytes per
# STRUCTSZ but the literal wrote 24, clobbering the next gvar).
# `width = 8` keeps the legacy store64 path; the `width = 1/2/4`
# branches mirror the existing PARSE_FIELD_STORE narrow-store
# encodings.
fn EMIT_STRUCT_FIELD_W(S, vcnt, boff, width): i64 {
    PCMPE(S);
    EPUSHR(S);
    # Load variable address into x1/rcx via fixup
    EVADDR_X1(S, vcnt);
    if (boff > 0) {
        EADDIMM_X1(S, boff);
    }
    EPOPR(S);
    if (width == 1) { ESTORE8(S); }
    elif (width == 2) { ESTORE16(S); }
    elif (width == 4) { ESTORE32(S); }
    else { ESTOC(S); }
    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    return 0;
}

fn PARSE_STRUCT_INIT(S, noff, sid): i64 {
    var si = sid - 1;
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    var sz = STRUCTSZ(S, si);
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, noff);
    S64(_vars_base + vcnt * 8, sz);
    SVTYPE(S, vcnt, sid);
    var fc = GETFCOUNT(S, si);
    # Detect named-field syntax: next token is IDENT (2) followed by ':' (49).
    # Empty struct literal `{}` falls through to positional branch as a no-op.
    var named = 0;
    if (PEEKT(S) == 2) {
        if (TOKTYP(S, GTI(S) + 1) == 49) { named = 1; }
    }
    if (named == 1) {
        # Named init: `StructName { field: expr, field: expr }`.
        # Each field must appear exactly once; any order. Nested struct
        # fields are not supported in named form — use positional for those.
        var initialized = 0;
        while (PEEKT(S) != 14) {
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var fname_off = PEEKV(S);
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 49) { ERR_EXPECT(S, 49); }
            STI(S, GTI(S) + 1);
            var found = 0 - 1;
            var fi = 0;
            while (fi < fc) {
                if (STREQTOK(S, GETFNAME(S, si, fi), fname_off) == 1) { found = fi; fi = fc; }
                else { fi = fi + 1; }
            }
            if (found < 0) { ERR_MSG(S, "unknown struct field in initializer", 35); }
            var ft = GETFTYPE(S, si, found);
            if (ft > 0) { ERR_MSG(S, "named init not supported for nested struct fields — use positional", 66); }
            var bit = 1 << found;
            if ((initialized & bit) != 0) { ERR_MSG(S, "struct field initialized twice", 30); }
            initialized = initialized | bit;
            var boff = FIELDOFF(S, si, found);
            # v5.9.36: width-correct store. Pre-fix this always
            # store64'd, which clobbered up to 7 bytes past the
            # field for narrow types — happened to work because
            # subsequent stores overwrote the high bytes, but
            # broke for the LAST narrow field at end-of-struct
            # (which would overflow the struct's allocation).
            var nf_w = FIELDSZ(S, ft);
            EMIT_STRUCT_FIELD_W(S, vcnt, boff, nf_w);
        }
        # Require every field to be set — no implicit zero defaults (yet).
        var fi2 = 0;
        while (fi2 < fc) {
            if ((initialized & (1 << fi2)) == 0) { ERR_MSG(S, "missing struct field in initializer", 35); }
            fi2 = fi2 + 1;
        }
    } else {
        # Positional init — emit each scalar field in declaration order,
        # flattening nested structs.
        # v5.9.36: width-aware boff advance + width-correct store. Pre-
        # fix `boff += 8` per field forced 8-byte stride, but STRUCTSZ
        # used width-aware FIELDSZ summing to <8 per narrow field
        # (i32 → 4) — net `var p32 = point_i32 {...}` allocated 12
        # bytes per STRUCTSZ but the literal wrote 24, clobbering the
        # next gvar. Now: each field advances by its declared width
        # (FIELDSZ) and writes only that many bytes. Untyped fields
        # (`a; b; c;`) keep the 8-byte stride; nested-struct fields
        # flatten into 8-byte slots per inner field (existing
        # behavior preserved).
        var boff = 0;
        var fi = 0;
        while (fi < fc) {
            var ft = GETFTYPE(S, si, fi);
            if (ft > 0) {
                # v5.10.7 — Str field is a single 8-byte pointer slot,
                # not a flattened 2-field by-value embedding. Mirrors
                # FIELDSZ's Str special-case + PP_DERIVE Serialize
                # codegen which uses load64(ptr+offset) to read the
                # Str pointer. Pre-fix this branch always flattened,
                # producing `unexpected '}'` on `Outer { my_str, x }`
                # because the parser was waiting for a second
                # expression for the Str field's `len`.
                if (IS_STR_FIELD(S, ft) == 1) {
                    EMIT_STRUCT_FIELD_W(S, vcnt, boff, 8);
                    boff = boff + 8;
                } else {
                    var ifc = GETFCOUNT(S, ft - 1);
                    var ifi = 0;
                    while (ifi < ifc) {
                        EMIT_STRUCT_FIELD_W(S, vcnt, boff, 8);
                        boff = boff + 8;
                        ifi = ifi + 1;
                    }
                }
            } else {
                var pf_w = FIELDSZ(S, ft);
                EMIT_STRUCT_FIELD_W(S, vcnt, boff, pf_w);
                boff = boff + pf_w;
            }
            fi = fi + 1;
        }
    }
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    SLVAR(S, vcnt);
    SVCNT(S, vcnt + 1);
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    return 0;
}

fn PARSE_GVAR_ARR(S, noff, sti, ew): i64 {
    STI(S, GTI(S) + 1);
    # v5.10.48: top-level array-size NUM-or-enum-const-ident — same
    # rule as the in-fn PARSE_ARRAY above. Closes the var-bracket
    # parser-cosmetic-limit at top-level too. Without this mirror
    # fix, `enum Sz { N = 16; } var buf[N];` at top level still
    # errored even after the in-fn fix landed.
    var sz_raw = 0;
    if (PEEKT(S) == 1) {
        sz_raw = PEEKV(S);
        STI(S, GTI(S) + 1);
    } else {
        if (PEEKT(S) == 2) {
            var gas_noff = PEEKV(S);
            var gas_idx = FINDVAR(S, gas_noff);
            if (gas_idx >= 0 && gas_idx < 1024) {
                var gas_ecv = L64(_vecv_base + gas_idx * 8);
                if (gas_ecv < 0) {
                    sz_raw = gas_ecv & 0x7FFFFFFFFFFFFFFF;
                    STI(S, GTI(S) + 1);
                } else {
                    ERR_MSG(S, "array size identifier must be an enum constant (compile-time literal); use `enum Sz { N = 16; } var buf[N];`", 113);
                }
            } else {
                ERR_MSG(S, "array size identifier must be an enum constant (compile-time literal); use `enum Sz { N = 16; } var buf[N];`", 113);
            }
        } else {
            ERR_EXPECT(S, 1);
        }
    }
    # v6.2.1: element-typed top-level array `var g: T[N]` reserves
    # N * sizeof(T) bytes. `ew` is the element width from the `: T`
    # annotation (ann_scalar). ew==0 is the bare `var g[N]` form —
    # keep the legacy N-i64-SLOTS top-level convention (ew=8). So
    # `var g: u8[N]` = N bytes, `var g: i64[N]` = 8N, bare = 8N.
    # The byte-list `= {..}` cap below stays in bytes (= sz).
    var ar_ew = ew;
    if (ar_ew < 1) { ar_ew = 8; }
    var sz = sz_raw * ar_ew;
    if (sz < 8) { sz = 8; }
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);
    var vc = GVCNT(S);
    S64(_varn_base + vc * 8, noff);
    S64(_vars_base + vc * 8, sz);
    SLVAR(S, vc);
    SVCNT(S, vc + 1);
    # v5.11.51: optional byte-list initializer
    # `var foo[N] = { 0x.., 0x.., ... };` emits store8 calls equivalent
    # to the user typing them by hand. Each byte must be a NUM in [0, 255];
    # at most `sz` bytes (the array's declared capacity in bytes, =
    # sz_raw * 8). Bytes beyond the brace-list count stay zero (cyrius
    # default for .bss / gvar storage). Token IDs: 4 = `=`, 13 = `{`,
    # 14 = `}`, 31 = `,`, 5 = `;`. See issue 2026-05-13-gnoboot-byte-array-literal.md
    # and CHANGELOG [5.11.51] for the consumer-side rationale.
    #
    # The actual codegen (per-byte EVADDR + EADDRA_IMM + EPUSHR + EMOVI
    # + EPOPC + ESTORE8) happens in `EMIT_GVAR_INITS` at pass-2 emit
    # time. Pass 1 (where we are now) only registers the var and saves
    # sti to gvar_toks so the replay can find the byte list. Emitting
    # inline here would land in dead code (skipped by the entry-jmp).
    if (PEEKT(S) == 4) {
        # Validate the brace-list shape + byte values, but DON'T emit
        # codegen. Walk the tokens to (a) error on bad syntax / bad
        # values early, (b) leave the token-stream cursor past the `;`.
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
        STI(S, GTI(S) + 1);
        var bi = 0;
        var go = 1;
        while (go == 1) {
            if (PEEKT(S) == 14) { go = 0; }
            else {
                if (PEEKT(S) != 1) { ERR_EXPECT(S, 1); }
                var bv = PEEKV(S);
                if (bv < 0 || bv > 255) {
                    ERR_MSG(S, "byte-array literal value must be in [0, 255]", 47);
                }
                if (bi >= sz) {
                    ERR_MSG(S, "byte-array literal has more bytes than the array's declared capacity (cap is [N]*8 bytes)", 95);
                }
                STI(S, GTI(S) + 1);
                bi = bi + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
            }
        }
        STI(S, GTI(S) + 1);
        # Register for deferred emit. EMIT_GVAR_INITS replays from sti;
        # the replay path detects the `[N] = { ... };` shape and emits
        # store8 calls per byte.
        var gc = L64(S + 0x19A000);
        if (gc >= 4096) {
            ERR_MSG(S, "too many initialized globals (max 4096)", 39);
        }
        S64(S + 0x729000 + gc * 8, sti);
        S64(S + 0x19A000, gc + 1);
    }
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    return 0;
}

# Register a global var in declaration zone (no codegen, deferred init)
fn PARSE_GVAR_REG(S): i64 {
    var sti = GTI(S);
    STI(S, GTI(S) + 1);  # consume VAR
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);
    # Optional type annotation — check scalar types, pointer types, or struct names
    var psc = 0;
    var ann_sid = 0;
    var ann_scalar = 0;
    var ann_float = 0;   # v6.2.19 math arc: F64_TYID / F32_TYID for `var x: f64`/`f32`
    if (PEEKT(S) == 49) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 8) { STI(S, GTI(S) + 1); psc = 8; STI(S, GTI(S) + 1); SKIP_GENERICS(S); }
        elif (PEEKT(S) == 105) { ann_scalar = 16; STI(S, GTI(S) + 1); }
        else {
            if (PEEKT(S) == 2) {
                var ann_sn = PEEKV(S);
                var ann_tn = L64(S + 0x60000 + ann_sn);
                # v6.2.1: unsigned widths (u8/u16/u32/u64) added alongside
                # the signed ones so top-level `var g: u64[N]` element-sizes
                # like the in-fn path. u128 = 0x38323175.
                if (ann_tn & 0xFFFF == 0x3869) { ann_scalar = 1; }
                elif (ann_tn & 0xFFFF == 0x3875) { ann_scalar = 1; }
                elif (ann_tn & 0xFFFFFF == 0x363169) { ann_scalar = 2; }
                elif (ann_tn & 0xFFFFFF == 0x363175) { ann_scalar = 2; }
                elif (ann_tn & 0xFFFFFF == 0x323369) { ann_scalar = 4; }
                elif (ann_tn & 0xFFFFFF == 0x323375) { ann_scalar = 4; }
                elif (ann_tn & 0xFFFFFF == 0x343669) { ann_scalar = 8; }
                elif (ann_tn & 0xFFFFFF == 0x343675) { ann_scalar = 8; }
                elif (ann_tn & 0xFFFFFF == 0x343666) { ann_float = F64_TYID; }
                elif (ann_tn & 0xFFFFFF == 0x323366) { ann_float = F32_TYID; }
                elif (ann_tn & 0xFFFFFFFF == 0x38323175) { ann_scalar = 16; }
                else { ann_sid = FINDSTRUCT(S, ann_sn); }
            }
            STI(S, GTI(S) + 1); SKIP_GENERICS(S);
        }
    }
    # Array: register with size. v5.11.51 — when the array has a
    # `= { byte-list };` initializer, PARSE_GVAR_ARR saves sti to
    # gvar_toks so EMIT_GVAR_INITS replays it at top-level emit time
    # (pass-1 emits get skipped by the entry-jmp patch).
    if (PEEKT(S) == 28) {
        PARSE_GVAR_ARR(S, noff, sti, ann_scalar);
        return 0;
    }
    # Check for struct init after =: var p = StructName { ... }
    # Peek ahead: skip to = then check if next is IDENT matching a struct
    var save_peek = GTI(S);
    # We're past the type annotation, at = or the token before it
    # Find the = sign
    var pgo = 1;
    while (pgo == 1) {
        if (PEEKT(S) == 4) { pgo = 0; }
        else { if (PEEKT(S) == 5) { pgo = 0; }
            else { if (PEEKT(S) == 12) { pgo = 0; }
                else { STI(S, GTI(S) + 1); } } }
    }
    var is_struct = 0;
    var ssid = 0;
    # v5.11.64: detect `var X = INT_LITERAL ;` shape for static init.
    # Non-zero literals get pre-written into the var area at FIXUP time
    # so the value is correct on FIRST READ — fixes the kmode-entry
    # init-order bug where gvar reads before the post-PROG EMIT_GVAR_INITS
    # block returned 0. Zero literals fall through to the existing
    # runtime-store path (BSS-zero is already correct for them).
    # See CHANGELOG [5.11.64] + the filed issue.
    #
    # Shadow-declaration opt-out: if FINDVAR already returns a match
    # for this var name (i.e., an earlier top-level `var X = ...;`
    # was registered before this one), skip static-init and fall
    # through to the runtime-store path. Reason: EMIT_GVAR_INITS
    # replays init tokens through FINDVAR which returns last-match —
    # an earlier shadow's runtime store would end up targeting THIS
    # var's address, clobbering our static-init bytes (mabda.cyr's
    # `var F64_TWO = 0;` shadowed by math.cyr's `var F64_TWO =
    # 0x4000_0000_0000_0000;` was the failing case during v5.11.64
    # bring-up). The shadow case is rare enough that always falling
    # back to runtime-store keeps the fix narrow.
    var sit_lit = 0;
    var sit_val = 0;
    var sit_shadow = 0;
    var chk_lit = 0;    # v6.2.11: `= NUM ;` literal for the collision guardrail
    var chk_has = 0;
    if (FINDVAR(S, noff) >= 0) { sit_shadow = 1; }
    if (PEEKT(S) == 4) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 2) {
            var sn = PEEKV(S);
            ssid = FINDSTRUCT(S, sn);
            # v5.9.33: only treat this as a struct-typed gvar if the
            # next-next token is `{` — i.e. the RHS is a real struct
            # literal `var p = Point { ... };`. A bare ident reference
            # like `var x = MASK & 0xF;` (where MASK is also a struct
            # name) must allocate a scalar slot, not STRUCTSZ bytes.
            if (ssid > 0 && TOKTYP(S, GTI(S) + 1) == 13) { is_struct = 1; }
        }
        # Static-init detection: shape is exactly `= NUM ;`. Negative
        # literals (`= - NUM ;`), hex-as-expr, parenthesized literals,
        # and arithmetic RHS all fall through to the runtime-store
        # path. Conservative on purpose — no false positives means no
        # silent value drift versus today's behavior.
        #
        # cx-mode opt-out: the cx bytecode backend has no file-image
        # var area; its gvars live in cxvm-allocated memory zeroed at
        # cxvm startup. Skipping the runtime store would leave them
        # zero. Keep the runtime-store path for cx; static-init is
        # an x86 / aarch64 / MachO / PE optimization.
        # v6.2.11: capture a `= NUM ;` literal for the collision guardrail,
        # INDEPENDENT of the static-init opt below (which deliberately skips
        # shadowing redefinitions — but a collision warning must fire EXACTLY on
        # those). Read-only (PEEKV, no STI advance); does not affect codegen.
        if (PEEKT(S) == 1 && TOKTYP(S, GTI(S) + 1) == 5) { chk_lit = PEEKV(S); chk_has = 1; }
        if (_TARGET_CX != 1 && sit_shadow == 0 && PEEKT(S) == 1 && TOKTYP(S, GTI(S) + 1) == 5) {
            var lit = PEEKV(S);
            if (lit != 0) {
                sit_lit = 1;
                sit_val = lit;
            }
        }
    }
    STI(S, save_peek);  # restore
    # v6.2.11: flag a conflicting-value redefinition (issue 2026-06-14) when this
    # global has a `= NUM ;` literal AND shadows a prior def, BEFORE it's
    # registered so FINDVAR sees only prior defs. Mirrors the enum-member site in
    # parse_types.cyr. Gated on the shadow so the common non-colliding case skips
    # the scan; CHKDUPVAL itself is value-conflict-only (identical = silent).
    if (chk_has == 1 && sit_shadow == 1) { CHKDUPVAL(S, noff, chk_lit); }
    # v6.3.24: a NON-int-literal global (string / expr / struct / array init →
    # chk_has==0) that shadows an enum constant is the dangerous silent-miscompile
    # case — a pointer/expr can never be a benign same-value alias of an int enum
    # fold, and once registered every later reference to the name rebinds to the
    # var, INCLUDING inside already-parsed library code that uses the constant as an
    # ABI offset (patra `DbOff.DB_PATH`). Hard-error. An int-literal shadow stays a
    # CHKDUPVAL warning above (e.g. chrono's harmless `var CLOCK_MONOTONIC = 1`
    # aliasing the syscall enum, same value). See CHK_ENUM_SHADOW in parse_types.cyr.
    if (chk_has == 0) { CHK_ENUM_SHADOW(S, noff); }
    # Register
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, noff);
    if (is_struct == 1) {
        S64(_vars_base + vcnt * 8, STRUCTSZ(S, ssid - 1));
        SVTYPE(S, vcnt, ssid);
    } else {
        if (ann_float != 0) {
            # f64/f32: 8-byte slot (f64 bit pattern, or f32 bits in the low 32);
            # SVTYPE marks it so PEXPR/PARSE_TERM route operators to EMIT_F64_BINOP.
            S64(_vars_base + vcnt * 8, 8);
            SVTYPE(S, vcnt, ann_float);
        } elif (ann_scalar > 0) {
            if (ann_scalar < 8) {
                S64(_vars_base + vcnt * 8, ann_scalar);
                SVTYPE(S, vcnt, ann_scalar);
            } else {
                # 8 (i64) or 16 (u128) — allocate the full width.
                # No type marker for now: u128 bytes live in the slot,
                # scalar ops touch the low 64 bits until alpha3 lands
                # proper arithmetic.
                S64(_vars_base + vcnt * 8, ann_scalar);
            }
        } else {
            S64(_vars_base + vcnt * 8, 8);
            if (ann_sid > 0) { SVTYPE(S, vcnt, ann_sid); }
            elif (psc > 0) { SVTYPE(S, vcnt, 0 - psc); }
        }
    }
    SVCNT(S, vcnt + 1);
    # v5.11.64: static-init path — record literal value, skip gvar_toks
    # registration so EMIT_GVAR_INITS won't replay the (now redundant)
    # runtime store. FIXUP's var-area writer reads gvar_initval and
    # writes the literal into the file image at the var's offset.
    #
    # SLVAR(vcnt) keeps the "last var" pointer in sync with the runtime-
    # store path (which SLVAR's inside EMIT_GVAR_INITS's replay loop —
    # see line ~900). Programs like `var x = 42;` with no main rely on
    # the entry-trailing `EVLOAD(GLVAR())` → EEXIT to use the last var
    # as the exit code (aarch64 ci's literal-only test cases hit this
    # exact shape: `var x = 42;` expects exit 42). Without this call,
    # static-init vars would silently fall out of the last-var chain
    # and the binary would exit with whatever rax held — exit-code
    # corruption the runtime-store path can't reproduce.
    if (sit_lit == 1) {
        S64(_vgsi_base + vcnt * 8, sit_val);
        SLVAR(S, vcnt);
    } else {
        # Save token index for deferred init
        var gc = L64(S + 0x19A000);
        if (gc >= 4096) {
            ERR_MSG(S, "too many initialized globals (max 4096)", 39);
        }
        S64(S + 0x729000 + gc * 8, sti);
        S64(S + 0x19A000, gc + 1);
    }
    # Skip to semicolon
    var skg = 1;
    while (skg == 1) {
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); skg = 0; }
        else { if (PEEKT(S) == 12) { skg = 0; }
            else { STI(S, GTI(S) + 1); } }
    }
    return 0;
}

# Emit deferred global var inits (replays saved token positions)
fn EMIT_GVAR_INITS(S): i64 {
    var gc = L64(S + 0x19A000);
    var gi = 0;
    while (gi < gc) {
        var sti = L64(S + 0x729000 + gi * 8);
        STI(S, sti);
        STI(S, GTI(S) + 1);  # consume VAR
        var noff = PEEKV(S);
        STI(S, GTI(S) + 1);  # consume IDENT
        if (PEEKT(S) == 49) { STI(S, GTI(S) + 1); if (PEEKT(S) == 8) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); SKIP_GENERICS(S); }
        # v5.11.51: byte-array literal `var foo[N] = { 0x.., ... };`
        # After IDENT (+ optional `:type`) the next token is `[` for
        # array-typed gvar inits. PARSE_GVAR_ARR registered the var in
        # pass 1; here we walk past `[N]=` then emit a per-byte store8
        # sequence into the live codebuf (this is pass-2 emit time —
        # the code runs at top-level entry, post EPATCH).
        if (PEEKT(S) == 28) {
            STI(S, GTI(S) + 1);              # consume `[`
            # Skip size — already enforced in pass 1 (num or enum-const ident).
            if (PEEKT(S) == 1 || PEEKT(S) == 2) { STI(S, GTI(S) + 1); }
            if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
            STI(S, GTI(S) + 1);              # consume `]`
            if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
            STI(S, GTI(S) + 1);              # consume `=`
            if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
            STI(S, GTI(S) + 1);              # consume `{`
            var b_vidx = FINDVAR(S, noff);
            # v6.0.88 peephole: hoist &var into rcx/x1/r1 ONCE (via _EVRCX),
            # then emit a single direct byte-store per element (ESTOREB_IMM) instead
            # of the ~7-op EVADDR/EADDRA_IMM/PUSH/MOVI/POPC/STORE8/XORAA
            # chain per byte. ~5× emit compression + one fixup per array
            # (was one per byte). Cross-arch: x86 `mov byte [rcx+d],imm8`,
            # aarch64 `strb w0,[x1,#d]`, cx `store8 [r1(+d)],r0`.
            # IR recording (CYRIUS_IR=1|2, opt-in) keeps the legacy
            # IR-aware sequence so the IR stream is unchanged; the default
            # (IR-off) path — every consumer build + self-host — gets the
            # peephole. See CHANGELOG [6.0.88].
            var b_vidx_ir = IR_ENABLED(S);
            # _EVRCX (not EVADDR_X1): obj-aware base load. x86 EVADDR_X1 is
            # absolute-mov only, which stores to the wrong address under
            # x86-Mach-O PIE (caught on real ach hardware, v6.0.88). _EVRCX
            # emits rip-relative LEA when _IS_OBJ; aarch64/cx alias to their
            # already-correct EVADDR_X1.
            if (b_vidx_ir == 0) { _EVRCX(S, b_vidx); }
            var b_i = 0;
            var b_go = 1;
            while (b_go == 1) {
                if (PEEKT(S) == 14) { b_go = 0; }
                else {
                    var b_v = PEEKV(S);
                    STI(S, GTI(S) + 1);
                    # b_legacy = 1 → emit the legacy per-byte chain. Used
                    # under IR recording, and when the peephole reports the
                    # disp is out of the arch's direct-store range
                    # (ESTOREB_IMM returns non-zero, e.g. aarch64 >= 4096).
                    var b_legacy = 1;
                    if (b_vidx_ir == 0) {
                        b_legacy = ESTOREB_IMM(S, b_i, b_v);
                    }
                    if (b_legacy != 0) {
                        # legacy `store8(&var + b_i, b_v)`:
                        EVADDR(S, b_vidx);
                        if (b_i > 0) { EADDRA_IMM(S, b_i); }
                        EPUSHR(S);
                        EMOVI(S, b_v);
                        EPOPC(S);
                        ESTORE8(S);
                        EXORAA(S);
                    }
                    b_i = b_i + 1;
                    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                }
            }
            STI(S, GTI(S) + 1);              # consume `}`
            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
            STI(S, GTI(S) + 1);              # consume `;`
            gi = gi + 1;
            continue;
        }
        # v5.8.42: same bare-decl `var X;` improvement as PARSE_VAR.
        # Top-level vars hit this path; mirror the diagnostic so the
        # error text doesn't depend on where the bare-decl appears.
        if (PEEKT(S) != 4) {
            if (PEEKT(S) == 5) {
                ERR_MSG(S, "uninitialized variable not allowed; use `var X = 0;` or initial value", 70);
            }
            ERR_EXPECT(S, 4);
        }
        STI(S, GTI(S) + 1);  # consume =
        # Check for struct init: StructName { ... }
        # v5.9.33: same lookahead guard as PARSE_VAR — require `{` after
        # the struct-named ident to commit to struct-init; otherwise fall
        # through to scalar expr (e.g. `var x = MASK & 0xF;` where MASK
        # is also a struct name).
        var idx = FINDVAR(S, noff);
        var did_struct = 0;
        if (PEEKT(S) == 2) {
            var sn = PEEKV(S);
            var sid = FINDSTRUCT(S, sn);
            if (sid > 0 && TOKTYP(S, GTI(S) + 1) == 13) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
                STI(S, GTI(S) + 1);
                # v5.9.36: width-aware boff advance + width-correct
                # store, mirroring PARSE_STRUCT_INIT's positional path.
                # See that fn for the full rationale.
                var fc = GETFCOUNT(S, sid - 1);
                var boff = 0;
                var fii = 0;
                while (fii < fc) {
                    var fft = GETFTYPE(S, sid - 1, fii);
                    if (fft > 0) {
                        # v6.3.44: a Str field is a SINGLE 8-byte pointer slot,
                        # not a flattened 2-field by-value embedding — mirror
                        # PARSE_STRUCT_INIT's positional Str branch (v5.10.7).
                        # This global-init REPLAY is a parallel copy of that
                        # positional loop that never got the Str fix, so it fell
                        # into the nested-struct flatten below, PCMPE'd a 2nd
                        # (nonexistent) expression for the Str's `len`, and hit
                        # `}` → `unexpected '}'`. Only bit at GLOBAL scope: an
                        # in-fn `var s = T { .. }` goes through PARSE_STRUCT_INIT
                        # which already handles Str. (Issue 2026-07-03-derive-
                        # serialize-str-field-global-scope-parse-error — filed as
                        # a derive bug, but #derive-independent: any plain struct
                        # with a Str field + a global struct-literal reproduced.)
                        if (IS_STR_FIELD(S, fft) == 1) {
                            EMIT_STRUCT_FIELD_W(S, idx, boff, 8);
                            boff = boff + 8;
                        } else {
                            var ifc = GETFCOUNT(S, fft - 1);
                            var ifi = 0;
                            while (ifi < ifc) {
                                EMIT_STRUCT_FIELD_W(S, idx, boff, 8);
                                boff = boff + 8;
                                ifi = ifi + 1;
                            }
                        }
                    } else {
                        var gf_w = FIELDSZ(S, fft);
                        EMIT_STRUCT_FIELD_W(S, idx, boff, gf_w);
                        boff = boff + gf_w;
                    }
                    fii = fii + 1;
                }
                if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
                STI(S, GTI(S) + 1);
                SLVAR(S, idx);
                if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                STI(S, GTI(S) + 1);
                did_struct = 1;
            }
        }
        if (did_struct == 0) {
            PCMPE(S);
            if (idx >= 0) { EVSTORE(S, idx); SLVAR(S, idx); }
            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
            STI(S, GTI(S) + 1);
        }
        gi = gi + 1;
    }
    return 0;
}

# v6.3.36 (issue [6]) — `var b: P = a;` copy-init from another struct VARIABLE.
# Allocate b as an INLINE struct (ceil(STRUCTSZ/8) slots, filler(s) + named — the
# same slot-trick as the uninitialized `var b: P;` path) and COPY all STRUCTSZ
# bytes from the source local `a`, word by word. Word i of a struct lives at slot
# (named - i): field 0 is the named slot (the struct base) and each +8 byte offset
# is one lower slot index (higher stack address). Previously this fell through to
# scalar init: b got a SINGLE slot holding a's first 8 bytes (truncated) AND was
# marked pointer-mode, so `b.x` dereferenced 42-as-address → SIGSEGV.
#
# Scoped tight: (a) struct type annotation (pscale < 0), (b) inside a fn,
# (c) `= IDENT ;` with IDENT a struct LOCAL of the SAME sid, (d) STRUCTSZ > 8.
# Returns 1 when handled (caller returns), 0 to fall through. `= IDENT (` (fn-call
# RHS) is handled by the asv paths; global-source / ≤8B / mismatched-type copies
# fall through unchanged.
fn _try_struct_copy_init(S, noff, pscale): i64 {
    if (pscale >= 0) { return 0; }
    if (PEEKT(S) != 4) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    var ci_ti = GTI(S) + 1;
    if (TOKTYP(S, ci_ti) != 2) { return 0; }
    if (TOKTYP(S, ci_ti + 1) != 5) { return 0; }
    var src_li = FINDLOCAL(S, TOKVAL(S, ci_ti));
    if (src_li < 0) { return 0; }
    if (GLTYPE(S, src_li) != pscale) { return 0; }   # same struct sid as b
    var dst_sid = 0 - pscale;
    var sz = STRUCTSZ(S, dst_sid - 1);
    if (sz <= 8) { return 0; }
    var aligned = (sz + 7) & (0 - 8);
    var nslots = aligned / 8;
    var existing = FINDLOCAL(S, noff);
    if (existing >= 0) { if (GLDEP(S, existing) == GSDEP(S)) { ERRDUPVAR(S); } }
    # Reserve filler slots (sentinel name -1), then the named slot (SLTYPE = -sid).
    var k = 0;
    while (k < nslots - 1) {
        var fill = GFLC(S);
        S64(S + 0x5D9D000 + fill * 8, 0 - 1);
        SLDEP(S, fill, GSDEP(S));
        SLTYPE(S, fill, 0);
        SFLC(S, fill + 1);
        k = k + 1;
    }
    var named = GFLC(S);
    S64(S + 0x5D9D000 + named * 8, noff);
    SLDEP(S, named, GSDEP(S));
    SLTYPE(S, named, 0 - dst_sid);
    SFLC(S, named + 1);
    # Word-by-word copy: a's word i (slot src_li - i) → b's word i (slot named - i).
    var i = 0;
    while (i < nslots) {
        EFLLOAD(S, src_li - i);
        EFLSTORE(S, named - i);
        i = i + 1;
    }
    STI(S, GTI(S) + 1);   # consume '='
    STI(S, GTI(S) + 1);   # consume IDENT
    STI(S, GTI(S) + 1);   # consume ';'
    return 1;
}

# Parse: var IDENT = expr ;
fn PARSE_VAR(S): i64 {
    STI(S, GTI(S) + 1);  # consume VAR
    # expect IDENT
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);
    # Multi-var destructure: var x, y = fn()
    if (PEEKT(S) == 31) {
        STI(S, GTI(S) + 1);  # consume ,
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
        var noff2 = PEEKV(S);
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
        STI(S, GTI(S) + 1);  # consume =
        PCMPE(S);
        # rax = first value, rdx = second value (from ret2/return (a,b))
        if (GINFN(S) == 1) {
            # Register first local
            var li1 = GFLC(S);
            S64(S + 0x5D9D000 + li1 * 8, noff);
            SLDEP(S, li1, GSDEP(S));
            SLTYPE(S, li1, 0);
            EFLSTORE(S, li1);
            SFLC(S, li1 + 1);
            # mov rax, rdx (get second return value)
            EMOVRA_RDX(S);
            # Register second local
            var li2 = GFLC(S);
            S64(S + 0x5D9D000 + li2 * 8, noff2);
            SLDEP(S, li2, GSDEP(S));
            SLTYPE(S, li2, 0);
            EFLSTORE(S, li2);
            SFLC(S, li2 + 1);
        } else {
            ERR_MSG(S, "multi-var destructure only supported inside functions", 52);
        }
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);
        return 0;
    }
    # Optional type annotation: var x: type = ... or var x: *type = ...
    var pscale = 0;
    var scalar_type = 0;
    var scalar_signed = 0;   # v6.3.35: 1 for a SIGNED sub-i64 (iN) local, 0 for uN/other
    var lfloat = 0;   # v6.2.19 math arc: F64_TYID / F32_TYID for local `var x: f64`/`f32`
    var slice_elt_w = 0;  # v5.8.14 §6: element width for slice<T>/[T] (0 = not a slice)
    if (PEEKT(S) == 49) {
        STI(S, GTI(S) + 1);  # consume :
        if (PEEKT(S) == 8) {
            # Pointer type: *i64, *i32, *i16, *i8
            STI(S, GTI(S) + 1);  # consume *
            var tnoff = PEEKV(S);
            var tname = L64(S + 0x60000 + tnoff);
            if (tname & 0xFFFFFF == 0x343669) { pscale = 8; }
            if (tname & 0xFFFFFF == 0x323369) { pscale = 4; }
            if (tname & 0xFFFFFF == 0x363169) { pscale = 2; }
            if (tname & 0xFFFF == 0x3869) { pscale = 1; }
            if (pscale == 0) { pscale = 8; }
            STI(S, GTI(S) + 1);
            SKIP_GENERICS(S);
        } elif (PEEKT(S) == 28) {
            # v5.8.9 §1: `[T]` slice type sugar — `var x: [u8] = ...`.
            # v5.8.10 §2: 16-byte {ptr, len} slot (u128 path).
            # v5.8.14 §6: capture element width for §7 sized indexing.
            STI(S, GTI(S) + 1);  # consume [
            if (PEEKT(S) == 8) {
                # Pointer element: [*T] — width = 8 (pointer size)
                STI(S, GTI(S) + 1);  # consume *
                slice_elt_w = 8;
                if (PEEKT(S) == 2) { STI(S, GTI(S) + 1); }  # consume ident
            } elif (PEEKT(S) == 2) {
                # Scalar/struct element: [u8], [i32], [Foo]
                var elt_noff = PEEKV(S);
                var elt_name = L64(S + 0x60000 + elt_noff);
                # v6.3.9 (F-fns): `[T]` element under a generic binding (inert default).
                var _etc = 0;
                if (_tp_c0 != 0) { _etc = _tp_resolve(S, elt_noff); }
                if (_etc != 0) { if (_etc < 0) { slice_elt_w = 0 - _etc; } else { slice_elt_w = STRUCTSZ(S, _etc - 1); } }
                elif (elt_name & 0xFFFF == 0x3875)        { slice_elt_w = 1; }   # u8
                elif (elt_name & 0xFFFF == 0x3869)      { slice_elt_w = 1; }   # i8
                elif (elt_name & 0xFFFFFF == 0x363175)  { slice_elt_w = 2; }   # u16
                elif (elt_name & 0xFFFFFF == 0x363169)  { slice_elt_w = 2; }   # i16
                elif (elt_name & 0xFFFFFF == 0x323375)  { slice_elt_w = 4; }   # u32
                elif (elt_name & 0xFFFFFF == 0x323369)  { slice_elt_w = 4; }   # i32
                elif (elt_name & 0xFFFFFF == 0x343675)  { slice_elt_w = 8; }   # u64
                elif (elt_name & 0xFFFFFF == 0x343669)  { slice_elt_w = 8; }   # i64
                else {
                    var elt_sid = FINDSTRUCT(S, elt_noff);
                    if (elt_sid > 0) { slice_elt_w = STRUCTSZ(S, elt_sid - 1); }
                    else { slice_elt_w = 8; }  # default to i64-width for unknown
                }
                STI(S, GTI(S) + 1);
            } elif (PEEKT(S) == 105) {
                slice_elt_w = 16;  # u128 element
                STI(S, GTI(S) + 1);
            }
            if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
            STI(S, GTI(S) + 1);  # consume ]
            SKIP_GENERICS(S);
            scalar_type = 16;
        } elif (PEEKT(S) == 105) {
            # u128 type
            scalar_type = 16;
            STI(S, GTI(S) + 1);
        } elif (PEEKT(S) == 2 && (L64(S + 0x60000 + PEEKV(S)) & 0xFFFFFFFFFF) == 0x6563696C73) {
            # v5.8.10 §2: `slice<T>` ident form — 16-byte {ptr,len} slot.
            # v5.8.14 §6: extract element width from <T> for §7 indexing.
            # Bytes for "slice" = 0x6563696C73 (little-endian load64
            # lower 5 bytes; 's'=0x73 'l'=0x6C 'i'=0x69 'c'=0x63 'e'=0x65).
            # Manual <T> parsing replaces SKIP_GENERICS so we can capture T.
            scalar_type = 16;
            STI(S, GTI(S) + 1);  # consume "slice"
            if (PEEKT(S) == 19) {  # `<`
                STI(S, GTI(S) + 1);  # consume <
                if (PEEKT(S) == 8) {
                    STI(S, GTI(S) + 1);  # consume *
                    slice_elt_w = 8;
                    if (PEEKT(S) == 2) { STI(S, GTI(S) + 1); }
                } elif (PEEKT(S) == 2) {
                    var gtt_noff = PEEKV(S);
                    var gtt_name = L64(S + 0x60000 + gtt_noff);
                    # v6.3.9 (F-fns): `slice<T>` element under a generic binding —
                    # canonical token → width (<0 -width, >0 STRUCTSZ). Inert default.
                    var _gtc = 0;
                    if (_tp_c0 != 0) { _gtc = _tp_resolve(S, gtt_noff); }
                    if (_gtc != 0) { if (_gtc < 0) { slice_elt_w = 0 - _gtc; } else { slice_elt_w = STRUCTSZ(S, _gtc - 1); } }
                    elif (gtt_name & 0xFFFF == 0x3875)        { slice_elt_w = 1; }   # u8
                    elif (gtt_name & 0xFFFF == 0x3869)      { slice_elt_w = 1; }   # i8
                    elif (gtt_name & 0xFFFFFF == 0x363175)  { slice_elt_w = 2; }   # u16
                    elif (gtt_name & 0xFFFFFF == 0x363169)  { slice_elt_w = 2; }   # i16
                    elif (gtt_name & 0xFFFFFF == 0x323375)  { slice_elt_w = 4; }   # u32
                    elif (gtt_name & 0xFFFFFF == 0x323369)  { slice_elt_w = 4; }   # i32
                    elif (gtt_name & 0xFFFFFF == 0x343675)  { slice_elt_w = 8; }   # u64
                    elif (gtt_name & 0xFFFFFF == 0x343669)  { slice_elt_w = 8; }   # i64
                    else {
                        var gtt_sid = FINDSTRUCT(S, gtt_noff);
                        if (gtt_sid > 0) { slice_elt_w = STRUCTSZ(S, gtt_sid - 1); }
                        else { slice_elt_w = 8; }
                    }
                    STI(S, GTI(S) + 1);
                } elif (PEEKT(S) == 105) {
                    slice_elt_w = 16;
                    STI(S, GTI(S) + 1);
                }
                if (PEEKT(S) == 20) { STI(S, GTI(S) + 1); }  # consume >
            }
        } else {
            var _gs_sid = 0;   # v6.3.10: base sid if `: StructName` resolved (for generic-struct instantiation below)
            if (PEEKT(S) == 2) {
                var lann = PEEKV(S);
                # Check scalar types: i8/u8, i16/u16, i32/u32, i64/u64.
                # v6.2.1: unsigned widths added so element-typed arrays
                # `var a: u64[N]` size correctly (8N) instead of silently
                # under-reserving as bytes — the same footgun class this
                # slot closes. u-bytes: u8=0x3875 u16=0x363175 u32=0x323375
                # u64=0x343675 (LE name load; see the slice-elt detector
                # above). Zero existing u-scalar usage → self-host neutral.
                var ltname = L64(S + 0x60000 + lann);
                # v6.3.9 (F-fns): generic `: T` substitution. When a binding is
                # active and `lann` is a bound type-param, the canonical token
                # drives scalar_type (<0 → -width) or pscale (>0 → -sid), skipping
                # the scalar/struct chain. Inert when _tp_c0==0 (_ltc stays 0) →
                # byte-identical default path.
                var _ltc = 0;
                if (_tp_c0 != 0) { _ltc = _tp_resolve(S, lann); }
                if (_ltc != 0) { if (_ltc < 0) { scalar_type = 0 - _ltc; } else { pscale = 0 - _ltc; } }
                # v6.4.6 (Phase 3a) — integer vector types (128-bit). MUST precede the
                # scalar int checks below: "i8v16" & 0xFFFF == "i8" (0x3869) etc. The
                # 6-byte packed name selects the structured-descriptor sentinel
                # (util.cyr: desc = signed<<1 | lane_log2<<2 | lanes_log2<<5; signed
                # bit set for i*, clear for u*). All are 16 B / 2 slots / 1 XMM.
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x003631763869) { pscale = 0 - 2178; }  # i8v16  (signed,  1B×16)
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x003631763875) { pscale = 0 - 2176; }  # u8v16  (unsigned)
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x003876363169) { pscale = 0 - 2150; }  # i16v8  (signed,  2B×8)
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x003876363175) { pscale = 0 - 2148; }  # u16v8  (unsigned)
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x003476323369) { pscale = 0 - 2122; }  # i32v4  (signed,  4B×4)
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x003476323375) { pscale = 0 - 2120; }  # u32v4  (unsigned)
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x003276343669) { pscale = 0 - 2094; }  # i64v2  (signed,  8B×2)
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x003276343675) { pscale = 0 - 2092; }  # u64v2  (unsigned)
                elif (ltname & 0xFFFF == 0x3869) { scalar_type = 1; }
                elif (ltname & 0xFFFF == 0x3875) { scalar_type = 1; }
                elif (ltname & 0xFFFFFF == 0x363169) { scalar_type = 2; }
                elif (ltname & 0xFFFFFF == 0x363175) { scalar_type = 2; }
                elif (ltname & 0xFFFFFF == 0x323369) { scalar_type = 4; }
                elif (ltname & 0xFFFFFF == 0x323375) { scalar_type = 4; }
                elif (ltname & 0xFFFFFF == 0x343669) { scalar_type = 8; }
                elif (ltname & 0xFFFFFF == 0x343675) { scalar_type = 8; }
                # v6.3.35: a sub-i64 SIGNED type name ends in 'i' (low byte 0x69, e.g.
                # "i8"/"i16"/"i32"); unsigned ends in 'u' (0x75). Mark signed so the
                # load sign-extends (movsx). i64/u64 (width 8) load full-width — no mark.
                if (scalar_type >= 1) { if (scalar_type <= 4) { if (ltname & 0xFF == 0x69) { scalar_signed = 1; } } }
                # v5.10.28 — `f64v2` value type (16-byte). Detected
                # here at var-decl parsing so `var v: f64v2;` triggers
                # the 2-slot stack-local allocation path below. Encoded
                # as pscale = -20 (sentinel below STRUCT sid range —
                # struct sids start at 1 so -20 is safe). The branch
                # at line ~873 (`pscale < 0 && PEEKT == 5`) routes
                # uninitialized f64v2 locals through the 2-slot
                # filler+named allocation; the named slot's SLTYPE
                # gets -20 (via `0 - sv_sid` where sv_sid = 20).
                # bytes for "f64v2\0" — 5 chars + nul, packed in 6 bytes
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x00003276343666) {
                    pscale = 0 - 20;
                }
