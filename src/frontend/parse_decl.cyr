                        SLDEP(S, _f2c_fill, GSDEP(S));
                        SLTYPE(S, _f2c_fill, 0);
                        SFLC(S, _f2c_fill + 1);
                        # Named slot (lo half = &x+0)
                        var _f2c_named = GFLC(S);
                        S64(S + 0x5D9D000 + _f2c_named * 8, noff);
                        SLDEP(S, _f2c_named, GSDEP(S));
