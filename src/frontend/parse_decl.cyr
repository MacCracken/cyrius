    if (e < 0) { return 0; }
    var a = _ie_unparen(S, ti, e);
    var pe = _ie_pe;
    if (pe - a < 2) { return 0; }
    if (TOKTYP(S, a) != 8) { return 0; }
    if (_gz_split(S, a, pe) != 0 - 1) { return 0; }
    _vrcv_k = a - ti;
    return 4;
