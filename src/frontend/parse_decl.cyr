# ... at method-name token nt: at a site the bound's contract refused (`_bnd_site_refuse`) nothing is minted — the arm
# consumes the call quietly, as the inferred spelling's (a mint could report the instance's own errors). CHANGELOG
# [6.7.16]
fn _meth_xsite(S, mf, c0, c1, nt): i64 {
