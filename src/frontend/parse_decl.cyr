        if (_istr_at(S, GTI(S), _gz_end(S, GTI(S))) != 2) { return 0; }
        return 1;
    }
    if (_istr_name(S, TOKVAL(S, GTI(S) + pk)) != 2) { return 0; }
    return 1;
}
# The zone replay, cursor on the RHS (`gps` the annotation's; a `*Str` reads 0, so its tokens are asked): such a
# `Str` / `*Str` declaration stores the global's static address into `dgv` (1, the cursor left on the `;`); else 0.
# A gt declared BELOW H binds too (the user's D17, 2026-10-18): its address is static, so the bind needs no layout pass
# 1 could not see — the reason `_gci_below` refuses a COPY from below. CHANGELOG [6.7.15]
fn _istr_gz(S, dgv, gps): i64 {
    var ss = _STR_SID(S);
    if (ss <= 0) { return 0; }
    if (gps != 0 - ss) {
        if (gps != 0) { return 0; }
        if (TOKTYP(S, GTI(S) - 4) != 49) { return 0; }
        if (_istr_pann(S, GTI(S) - 3) == 0) { return 0; }
        if (_istr_gzdx(S, dgv) == 1) { return 1; }   # 6.7.16 (D73): `var P: *Str = *GP;`
    }
