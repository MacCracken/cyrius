# A local source: an inline struct (a by-value parameter copied in included), or an address-passed
# by-value parameter (`_addr_is_slot_content`: a `#naked` fn's, never a `*T`).
fn _uci_local(S, li): i64 {
    var t = GLTYPE(S, li);
