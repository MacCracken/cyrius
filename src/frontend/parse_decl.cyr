                # as f64v2 but 4-slot allocation. Encoded as -21.
                # bytes for "f64v4\0": 'f' 0x66, '6' 0x36, '4' 0x34,
                # 'v' 0x76, '4' 0x34, NUL 0x00 — packed LE = 0x00_34_76_34_36_66.
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x00003476343666) {
                    pscale = 0 - 21;
                }
