# The `>` closing `.m<..>(`'s list at method-name token nt when it is a type list (`_tylist_at`) followed by `(` and m
# no field of struct sid (sid <= 0: a receiver of no known struct); else -1.
fn _mlist_end(S, sid, nt): i64 {
    if (TOKTYP(S, nt) != 2) { return 0 - 1; }
    if (TOKTYP(S, nt + 1) != 19) { return 0 - 1; }
