                # = 128-bit = same footprint as f64v2 (2 slots), distinguished by the
                # structured descriptor sentinel -2121 (see util.cyr _vec_desc). MUST
                # precede the 3-byte `f32` scalar check below — f32v4's low 3 bytes
                # ARE "f32". bytes "f32v4\0": 'f' 0x66, '3' 0x33, '2' 0x32, 'v' 0x76,
                # '4' 0x34, NUL 0x00 — packed LE = 0x00_34_76_32_33_66.
                elif ((ltname & 0xFFFFFFFFFFFF) == 0x00003476323366) {
                    pscale = 0 - 2121;
                }
