# PARSER — expression parsing: PARSE_FACTOR / PARSE_TERM / PEXPR /
# PCMPE + helpers (_SC_ARITY, _STR_FROM_NOFF, PF64BIN, PF64CMP,
# PARSE_SIMD_EXT, EPTR_SCALE, BUILD_OP_NAME, EMIT_OP_DISPATCH).
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38 to keep single-file
# LOC under ~1500. Included by parse.cyr at the same textual position
# the original content lived. No logical change from the original
# inline version; self-host byte-identical by construction.

fn _SC_ARITY(n): i64 {
    if (n == 0) { return 3; }    # read(fd, buf, count)
    if (n == 1) { return 3; }    # write(fd, buf, count)
    if (n == 2) { return 3; }    # open(path, flags, mode)
    if (n == 3) { return 1; }    # close(fd)
    if (n == 4) { return 2; }    # stat(path, buf)
    if (n == 5) { return 2; }    # fstat(fd, buf)
    if (n == 8) { return 3; }    # lseek(fd, off, whence)
    if (n == 9) { return 6; }    # mmap(addr, len, prot, flags, fd, off)
    if (n == 10) { return 3; }   # mprotect(addr, len, prot)
    if (n == 11) { return 2; }   # munmap(addr, len)
    if (n == 12) { return 1; }   # brk(addr)
    if (n == 16) { return 3; }   # ioctl(fd, req, arg)
    if (n == 21) { return 2; }   # access(path, mode)
    if (n == 22) { return 1; }   # pipe(fds)
    if (n == 32) { return 1; }   # dup(fd)
    if (n == 33) { return 2; }   # dup2(old, new)
    if (n == 39) { return 0; }   # getpid()
    if (n == 56) { return 5; }   # clone(flags, stack, ptid, ctid, tls)
    if (n == 57) { return 0; }   # fork()
    if (n == 59) { return 3; }   # execve(path, argv, envp)
    if (n == 60) { return 1; }   # exit(code)
    if (n == 61) { return 4; }   # wait4(pid, status, opts, rusage)
    if (n == 62) { return 2; }   # kill(pid, sig)
    if (n == 63) { return 1; }   # uname(buf)
    if (n == 72) { return 3; }   # fcntl(fd, cmd, arg)
    if (n == 79) { return 2; }   # getcwd(buf, size)
    if (n == 262) { return 4; }  # newfstatat(dirfd, path, buf, flags) — at-family stat (v6.1.3)
    if (n == 280) { return 4; }  # utimensat(dirfd, path, times, flags) (v6.1.3)
    if (n == 80) { return 1; }   # chdir(path)
    if (n == 83) { return 2; }   # mkdir(path, mode)
    if (n == 84) { return 1; }   # rmdir(path)
    if (n == 87) { return 1; }   # unlink(path)
    if (n == 90) { return 2; }   # chmod(path, mode)
    if (n == 102) { return 0; }  # getuid()
    if (n == 104) { return 0; }  # getgid()
    if (n == 107) { return 0; }  # geteuid()
    if (n == 108) { return 0; }  # getegid()
    if (n == 112) { return 0; }  # setsid() takes 0 args
    if (n == 113) { return 1; }  # setuid(uid)
    if (n == 116) { return 2; }  # setgroups(size, list)
    if (n == 165) { return 5; }  # mount(src, tgt, fs, flags, data)
    if (n == 166) { return 2; }  # umount2(target, flags)
    if (n == 169) { return 4; }  # reboot(magic1, magic2, cmd, arg)
    return 0 - 1;
}

# Cache for str_from function index (auto-coercion).
# Lazily resolved on first use — returns the tok_names offset for "str_from".
var _str_from_cache = 0 - 1;
fn _STR_FROM_NOFF(S): i64 {
    if (_str_from_cache >= 0) { return _str_from_cache; }
    # Search tok_names for "str_from\0" = 0x006D6F72665F727473
    var npos = GNPOS(S);
    var i = 0;
    while (i < npos) {
        if (L64(S + 0x60000 + i) == 0x6D6F72665F727473) {
            if (load8(S + 0x60000 + i + 8) == 0) {
                _str_from_cache = i;
                return i;
            }
        }
        # Skip to next null terminator
        while (i < npos) { if (load8(S + 0x60000 + i) == 0) { i = i + 1; break; } i = i + 1; }
    }
    return 0 - 1;
}

# v6.3.7 — closure local-table isolation. A closure is its own fn but reuses the
# SHARED per-fn local tables (names 0x5D9D000 / depths 0x5DBD000 / types 0x5DDD000
# / slice-widths 0x5DFD000), starting at slot 0 after SFLC(0). Its params/locals
# therefore OVERWRITE the enclosing fn's locals at slots [0, closure_flc) — so an
# enclosing `var c0` shadowed by a later closure's `|x|` param became "undefined".
# Snapshot the enclosing range before the closure and restore it after, so the
# enclosing fn's locals survive. (n is the enclosing fn's GFLC at the closure site.)
fn _cl_save_locals(S, n): i64 {
    if (n <= 0) { return 0; }
    var buf = alloc(n * 32);
    var i = 0;
    while (i < n) {
        S64(buf + i * 8,          L64(S + 0x5D9D000 + i * 8));
        S64(buf + n * 8 + i * 8,  L64(S + 0x5DBD000 + i * 8));
        S64(buf + n * 16 + i * 8, L64(S + 0x5DDD000 + i * 8));
        S64(buf + n * 24 + i * 8, L64(S + 0x5DFD000 + i * 8));
        i = i + 1;
    }
    return buf;
}
fn _cl_restore_locals(S, buf, n): i64 {
    if (n <= 0) { return 0; }
    var i = 0;
    while (i < n) {
        S64(S + 0x5D9D000 + i * 8, L64(buf + i * 8));
        S64(S + 0x5DBD000 + i * 8, L64(buf + n * 8 + i * 8));
        S64(S + 0x5DDD000 + i * 8, L64(buf + n * 16 + i * 8));
        S64(S + 0x5DFD000 + i * 8, L64(buf + n * 24 + i * 8));
        i = i + 1;
    }
    return 0;
}

# v6.3.8 — lexical-capture helpers. The enclosing-locals NAME snapshot is the
# first segment of the v6.3.7 snapshot buffer (buf[0..n)); `_cl_snap_find` returns
# the enclosing slot whose name matches `noff`, searching backward so an inner
# scope shadows an outer (same convention as FINDLOCAL). -1 if not an enclosing
# local.
fn _cl_snap_find(S, noff): i64 {
    if (_cl_snap == 0) { return 0 - 1; }
    var i = _cl_snap_n - 1;
    while (i >= 0) {
        var sn = L64(_cl_snap + i * 8);
        if (sn >= 0) { if (STREQ(S, sn, noff) == 1) { return i; } }
        i = i - 1;
    }
    return 0 - 1;
}
# Capture index of enclosing slot `esl`, or -1 if not yet captured.
fn _cl_cap_find(esl): i64 {
    var i = 0;
    while (i < _cl_ncap) {
        if (L64(&_cl_cap_slots + i * 8) == esl) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# Record enclosing slot `esl` as a capture (dedup); returns its capture index.
fn _cl_cap_add(esl): i64 {
    var c = _cl_cap_find(esl);
    if (c >= 0) { return c; }
    if (_cl_ncap >= 64) { return 0 - 1; }
    S64(&_cl_cap_slots + _cl_ncap * 8, esl);
    var idx = _cl_ncap;
    _cl_ncap = _cl_ncap + 1;
    return idx;
}
fn _cl_shadow_add(S, noff): i64 {
    if (_cl_nshadow >= 64) { return 0; }
    S64(&_cl_shadow + _cl_nshadow * 8, noff);
    _cl_nshadow = _cl_nshadow + 1;
    return 0;
}
fn _cl_shadow_find(S, noff): i64 {
    var i = 0;
    while (i < _cl_nshadow) {
        if (STREQ(S, L64(&_cl_shadow + i * 8), noff) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# Pre-scan the closure body (cursor at the body start: `{` for a block, else the
# expression) to collect which enclosing locals it references as free variables.
# A free var is an identifier that is NOT a closure param/local (FINDLOCAL), NOT a
# body-local `var` (the shadow set), NOT a call name (`IDENT(`), and IS an
# enclosing local (in the snapshot). Restores the cursor; populates _cl_cap_slots
# + sets _cl_capturing. This runs BEFORE the closure prologue so the env-param
# decision (capturing → hidden arg0) can be made in one pass.
fn _cl_prescan_captures(S, cl_zero): i64 {
    _cl_ncap = 0;
    _cl_nshadow = 0;
    var save_ti = GTI(S);
    # The pre-scan runs BEFORE the param loop registers the params, so the params
    # aren't in the live local table yet — seed the shadow set with them (closure
    # params are not free variables). The cursor enters at the first param.
    if (cl_zero == 0) {
        while (PEEKT(S) != 35) {
            if (PEEKT(S) == 12) { break; }
            if (PEEKT(S) == 2) { _cl_shadow_add(S, PEEKV(S)); }
            STI(S, GTI(S) + 1);
        }
        if (PEEKT(S) == 35) { STI(S, GTI(S) + 1); }   # consume closing |
    }
    var is_block = 0;
    if (PEEKT(S) == 13) { is_block = 1; STI(S, GTI(S) + 1); }
    var depth = 0;
    var prev_var = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { go = 0; }
        elif (is_block == 1) {
            if (t == 13) { depth = depth + 1; }
            elif (t == 14) { if (depth == 0) { go = 0; } else { depth = depth - 1; } }
        }
        else {
            if (t == 10 || t == 28) { depth = depth + 1; }
            elif (t == 11 || t == 29) { if (depth == 0) { go = 0; } else { depth = depth - 1; } }
            elif (t == 5 && depth == 0) { go = 0; }
            elif (t == 31 && depth == 0) { go = 0; }
            elif (t == 14 && depth == 0) { go = 0; }
        }
        if (go == 1) {
            if (t == 3) { prev_var = 1; }
            elif (t == 2) {
                var noff = PEEKV(S);
                if (prev_var == 1) { _cl_shadow_add(S, noff); prev_var = 0; }
                else {
                    var is_call = 0;
                    if (TOKTYP(S, GTI(S) + 1) == 10) { is_call = 1; }
                    if (is_call == 0) {
                        if (FINDLOCAL(S, noff) < 0) {
                            if (_cl_shadow_find(S, noff) < 0) {
                                var esl = _cl_snap_find(S, noff);
                                if (esl >= 0) { _cl_cap_add(esl); }
                            }
                        }
                    }
                }
            }
            else { prev_var = 0; }
            STI(S, GTI(S) + 1);
        }
    }
    STI(S, save_ti);
    _cl_capturing = 0;
    if (_cl_ncap > 0) { _cl_capturing = 1; }
    return 0;
}

# v6.3.10 (F-structs/explicit): non-consuming lookahead from a `<` (token 19) at the
# current cursor. Returns 1 iff the `<...>` is a TYPE-ARGUMENT list immediately
# followed by `(` — i.e. the `foo<T,...>(` shape. Depth-tracks `<`/`>`; bails (→ 0,
# meaning "this is a comparison, not type-args") on `;`(5), `{`(13), or `(`(10) seen
# INSIDE the brackets (those mark a comparison like `a < foo()`). Bounded 64-token
# scan; never mutates GTI. The caller additionally gates on the flag + a generic-fn
# callee, so `a < b` and non-generic `<` are never misread.
fn LOOKAHEAD_IS_TYPE_ARG_CALL(S): i64 {
    var i = GTI(S);
    var n = GTCNT(S);
    var cap = i + 64;
    if (cap > n) { cap = n; }
    var depth = 0;
    while (i < cap) {
        var t = TOKTYP(S, i);
        if (t == 19) { depth = depth + 1; }
        elif (t == 20) {
            depth = depth - 1;
            if (depth == 0) {
                if (i + 1 < n) { if (TOKTYP(S, i + 1) == 10) { return 1; } }
                return 0;
            }
        } elif (t == 5) { return 0; }
        elif (t == 13) { return 0; }
        elif (t == 10) { return 0; }
        i = i + 1;
    }
    return 0;
}

fn PARSE_FACTOR(S): i64 {
    var typ = PEEKT(S);
    SPSC(S, 0);
    SESTYPE(S, 0);
    SESVAR(S, 0 - 1);
    SEXW(S, 0);
    # Unary minus: -expr
    if (typ == 7) {
        STI(S, GTI(S) + 1);
        # Optimization: -NUM → emit negated constant
        if (PEEKT(S) == 1) {
            EMOVI(S, 0 - PEEKV(S));
            STI(S, GTI(S) + 1);
            return 0;
        }
        # General: parse factor, emit 0-rax via push/sub
        EMOVI(S, 0);
        EPUSHR(S);
        PARSE_FACTOR(S);
        EMOVCA(S);
        EPOPR(S);
        ESUBR(S);
        return 0;
    }
    # Unary bitwise NOT: ~expr
    if (typ == 37) {
        STI(S, GTI(S) + 1);
        PARSE_FACTOR(S);
        ENOTR(S);
        return 0;
    }
    if (typ == 61) { var fval = PEEKV(S); STI(S, GTI(S) + 1); EMIT_FLOAT_LIT(S, fval); SESTYPE(S, F64_TYID); return 0; }
    # sizeof(Type) — compile-time constant (detected as IDENT "sizeof")
    if (typ == 2) { if (L64(S + 0x60000 + PEEKV(S)) & 0xFFFFFFFFFFFF == 0x666F657A6973) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
            STI(S, GTI(S) + 1);
            var szval = 0;
            if (PEEKT(S) == 105) {
                # sizeof(u128) = 16
                szval = 16;
                STI(S, GTI(S) + 1);
            } else {
                if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
                var szn = PEEKV(S);
                STI(S, GTI(S) + 1);
                var szname = L64(S + 0x60000 + szn);
                # v6.3.9 (F-fns): sizeof(T) under a generic binding → canonical token
                # → size (<0 -width, >0 STRUCTSZ). Inert when _tp_c0==0 (byte-identical).
                var _szc = 0;
                if (_tp_c0 != 0) { _szc = _tp_resolve(S, szn); }
                if (_szc != 0) { if (_szc < 0) { szval = 0 - _szc; } else { szval = STRUCTSZ(S, _szc - 1); } }
                elif (szname & 0xFFFF == 0x3869) { szval = 1; }
                elif (szname & 0xFFFFFF == 0x363169) { szval = 2; }
                elif (szname & 0xFFFFFF == 0x323369) { szval = 4; }
                elif (szname & 0xFFFFFF == 0x343669) { szval = 8; }
                else {
                    var szsid = FINDSTRUCT(S, szn);
                    if (szsid > 0) { szval = STRUCTSZ(S, szsid - 1); }
                    else { ERR_MSG(S, "sizeof: unknown type", 20); }
                }
            }
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
            STI(S, GTI(S) + 1);
            EMOVI(S, szval);
            return 0;
        } }
    # mulh64(a, b) — high 64 bits of a 64×64 unsigned multiply
    # Packed LE encoding of "mulh64" = 0x3436686C756D.
    if (typ == 2) { if (L64(S + 0x60000 + PEEKV(S)) & 0xFFFFFFFFFFFF == 0x3436686C756D) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
            STI(S, GTI(S) + 1);
            PCMPE(S); EPUSHR(S);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); }
            STI(S, GTI(S) + 1);
            PCMPE(S); EPOPC(S); EMULH(S);
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
            STI(S, GTI(S) + 1);
            _cfo = 0;
            return 0;
        } }
    if (typ == 1) {
        var val = PEEKV(S);
        STI(S, GTI(S) + 1);
        _cfp = GCP(S);
        EMOVI(S, val);
        # Mark as foldable for small non-negative literals. Originally
        # guarded `val > 0` because EMOVI(S, 0) emits 2 B (`xor eax, eax`)
        # vs 5 B for val > 0, and we worried const-fold rewrites assumed
        # a fixed slot size. Rewrites actually use `SCP(_cfp); EMOVI(_, v)`
        # which truncates + re-emits, so the emitted size doesn't matter
        # — any const, including 0, folds safely. Dropping the 0 exclusion
        # unblocks `syscall(0, ...)` reroute dispatch on both Mach-O and PE
        # (v5.5.14 — stdlib `lib/io.cyr` uses literal 0 for SYS_READ).
        if (val >= 0) { if (val < 0x10000) { _cfv = val; _cfo = 1; } }
        return 0;
    }
    if (typ == 2) {
        # IDENT — variable load or function call
        var noff = PEEKV(S);
        STI(S, GTI(S) + 1);
        # v6.3.10 (explicit): `foo<i64>(x)` explicit type-arguments. Gated on the
        # monomorph flag AND a generic-fn callee AND the `foo<...>(` lookahead shape,
        # so `a < b`, chained comparisons, and calls to non-generic fns are never
        # misread (flag-off / non-generic → byte-identical default path). v6.3.10
        # bite-1 supports i64 type-args (the base IS the i64 instance → normal call);
        # non-i64 type-args (instantiate-once) land in a follow-on bite.
        if (_MONOMORPH_OK == 1) { if (PEEKT(S) == 19) {
            var _eta_fi = FINDFN(S, noff);
            if (_eta_fi >= 0) { if (GFTP(S, _eta_fi) != 0) {
                if (LOOKAHEAD_IS_TYPE_ARG_CALL(S) == 1) {
                    STI(S, GTI(S) + 1);                 # consume `<`
                    var _ta_conc = _classify_return_type(S, PEEKV(S));
                    var _ta_d = 1;                      # consume the type-arg list incl. matching `>`
                    while (_ta_d > 0) {
                        var _tat = PEEKT(S);
                        if (_tat == 19) { _ta_d = _ta_d + 1; }
                        if (_tat == 20) { _ta_d = _ta_d - 1; }
                        STI(S, GTI(S) + 1);
                    }
                    if (_ta_conc == 0 - 8) {
                        PARSE_FNCALL(S, noff);          # i64: call the base (the i64 instance)
                    } else {
                        # non-i64: monomorphize on demand + call the specialized fn.
                        var _spec = _instantiate_generic_fn(S, _eta_fi, _ta_conc, 0);
                        if (_spec == 0 - 2) {
                            ERR_MSG(S, "non-i64 generic fns with parameters: instantiate-once param re-emission is a follow-on bite", 92);
                        }
                        PARSE_FNCALL(S, L64(_fnt_names + _spec * 8));
                    }
                    _cfo = 0;
                    return 0;
                }
            } }
        } }
        # Check for function call
        if (PEEKT(S) == 10) {
            PARSE_FNCALL(S, noff);
            _cfo = 0;
            return 0;
        }
        # Check for enum.variant or struct.field access
        if (PEEKT(S) == 41) {
            # Peek: is the second ident a known global var? (enum variant)
            var dot_ti = GTI(S);
            STI(S, GTI(S) + 1);
            if (PEEKT(S) == 2) {
                var vn = PEEKV(S);
                var vi = FINDVAR(S, vn);
                if (vi >= 0) {
                    # Enum.VARIANT — load the variant's global value.
                    # v5.5.2: if this gvar was registered by PARSE_ENUM_DEF
                    # as an enum constant (marker bit 63 set in the
                    # 0x1D8000 table), fold to EMOVI and mark _cfo=1 so
                    # callers like the syscall sc_num dispatch can read
                    # the compile-time value. Falls through to EVLOAD if
                    # the idx is out of the 1024-slot cap.
                    STI(S, GTI(S) + 1);
                    if (vi < 1024) {
                        var _ecvq = L64(_vecv_base + vi * 8);
                        if (_ecvq < 0) {
                            var _evq = _ecvq & 0x7FFFFFFFFFFFFFFF;
                            _cfp = GCP(S);
                            EMOVI(S, _evq);
                            if (_evq < 0x10000) { _cfv = _evq; _cfo = 1; }
                            else { _cfo = 0; }
                            return 0;
                        }
                    }
                    EVLOAD(S, vi);
                    _cfo = 0;
                    return 0;
                }
            }
            # Not an enum — rewind and do struct field load
            STI(S, dot_ti);
            PARSE_FIELD_LOAD(S, noff);
            _cfo = 0;
            return 0;
        }
        # Variable load — check local first if in function
        SPSC(S, 0);
        if (GINFN(S) == 1) {
            var li = FINDLOCAL(S, noff);
            if (li >= 0) {
                # v5.8.15 §7: slice subscript `s[i]` for slice-typed
                # locals. GSLICE_W returns the element byte-width
                # captured at PARSE_VAR time (v5.8.14 §6); 0 means
                # not a slice. If `[` follows the ident AND this is
                # a slice local, lower to `_slice_idx_get_W(&local, i)`
                # — bounds-checked sized load via the helper that
                # matches the element width.
                var sw = GSLICE_W(S, li);
                if (sw > 0) { if (PEEKT(S) == 28) {
                    STI(S, GTI(S) + 1);  # consume [
                    # Push &local as first arg (helper takes slice address)
                    EFLADDR(S, li);
                    EPUSHR(S);
                    # Parse index expression — leaves idx in rax
                    PCMPE(S);
                    EPUSHR(S);
                    # Look up and call the width-specific helper.
                    # Helpers live in lib/slice.cyr; consumer must
                    # `include "lib/slice.cyr"` (or pull via deps).
                    var idx_fn = 0 - 1;
                    if (sw == 1)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_1",  16); }
                    if (sw == 2)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_2",  16); }
                    if (sw == 4)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_4",  16); }
                    if (sw == 8)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_8",  16); }
                    if (sw == 16) { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_16", 17); }
                    if (idx_fn < 0) {
                        ERR_MSG(S, "slice subscript requires include \"lib/slice.cyr\" (provides _slice_idx_get_W helpers)", 92);
                    }
                    ECALLPOPS(S, 2);
                    ECALLFIX(S, idx_fn);
                    # Result in rax. Set expression-width tracking so
                    # narrowing assignment warnings work for u8/u16/u32.
                    SEXW(S, sw);
                    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
                    STI(S, GTI(S) + 1);  # consume ]
                    return 0;
                } }
                var lt = GLTYPE(S, li);
                # v6.2.19 math arc: f64/f32 locals — load the 8-byte value and tag
                # the expression f64/f32 so PEXPR/PARSE_TERM route operators to the
                # f64 builtins (skip the SPSC pointer-scale + sub-word paths below).
                if (lt == F64_TYID) { SESTYPE(S, F64_TYID); EFLLOAD(S, li); return 0; }
                # f32 is type-only: load the 8-byte value but DON'T propagate F32 as
                # an expr-type (no f32 arithmetic — convert via f32_to to f64 first).
                # Leaving it untyped (0) keeps F32 out of the operator dispatch.
                if (lt == F32_TYID) { EFLLOAD(S, li); SESTYPE(S, 0); return 0; }
                SPSC(S, lt);
                # Width-correct load for scalar types (1=i8, 2=i16, 4=i32)
