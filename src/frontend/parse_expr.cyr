                # adjacent to ESYSXLAT in src/backend/aarch64/emit.cyr) instead of
                # a parallel hardcoded list that drifted out of sync (it had only
                # 0,1,2,3,9,10,11,60,228 while ESYSXLAT routes ~40, drowning the log).
                var sc_ok = _macho_arm_routes(sc_num);
