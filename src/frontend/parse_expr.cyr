            syscall(SYS_WRITE, 2, "' (missing include or enum?)\n", 29);
            _err_excerpt(S);   # v6.5.39: excerpt+caret, like every syntax error
            _gv_note_blockscoped(S, noff);   # 6.6.6: see there
