        # value is the heap env object, so dispatch as (*obj)(obj, args…) — load the
        # fn pointer from [obj+0] and pass obj as the hidden first (env) arg.
        var cp_is_closure = 0;
        if (PEEKT(S) == 2) {
            var cp_cli = FINDLOCAL(S, PEEKV(S));
            if (cp_cli >= 0) { if (GLTYPE(S, cp_cli) == CLOSURE_TYID) { cp_is_closure = 1; } }
        }
        if (cp_is_closure == 1) {
            if (_TARGET_PE == 1) {
                ERR_MSG(S, "capturing closures not yet supported on Windows PE — use a non-capturing closure + explicit args", 100);
            }
        }
        PCMPE(S);                               # eval callee → rax (the env object if closure)
        # v6.0.86: on PE the callee goes on the STACK (pushed FIRST, below the
        # args), NOT a frame slot — a GFLC slot could alias a `&`-taken local
        # (the COM-out-param AV; see ECALLPTR_PE). Non-PE keeps the frame-slot
        # spill (its ECALLPOPS shadow would otherwise bury a stack-pushed callee).
