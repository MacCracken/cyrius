            SLDEP(S, cp_idx, 0);
            SFLC(S, cp_idx + 1);
            EFLSTORE(S, cp_idx);                # spill fn pointer (the callee)
            EFLLOAD(S, cp_obj_slot);            # rax = obj
            EPUSHR(S);                          # push obj as arg 1 (env)
