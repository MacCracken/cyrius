        _cl_restore_locals(S, cl_locsnap, cl_saved_flc);
        # v6.3.8 — restore capture state so the enclosing context resolves
        # identifiers normally again (and nested closures see their own state).
        _cl_capturing = cl_saved_capturing;
        _cl_env_lidx = cl_saved_env_lidx;
        _cl_snap = cl_saved_snap;
        _cl_snap_n = cl_saved_snap_n;
        if (cl_cap_shift == 1) {
            # v6.3.8 — CAPTURING closure: build the heap env object (the closure
            # value) — a (1+ncap)-word block with the fn pointer at [0] and the
            # captured-by-value locals at [1..]. The object pointer is left in rax.
            # Requires lib/alloc.cyr. (Dispatched via callptr: load64(obj) → fn,
            # obj passed as the hidden first arg — see the callptr handler.)
            var cl_alloc_fi = _FINDFN_CSTR(S, "alloc", 5);
            if (cl_alloc_fi < 0) {
                ERR_MSG(S, "a capturing closure needs include \"lib/alloc.cyr\" for its heap env", 64);
            }
            EMOVI(S, (1 + _cl_ncap) * 8);   # rax = size
            EPUSHR(S);
            ECALLPOPS(S, 1);                 # → rdi
            ECALLFIX(S, cl_alloc_fi);        # rax = obj
            var cl_obj_slot = GFLC(S);
            # Anonymous scratch — the name table isn't cleared per-fn, so an unnamed
            # slot would keep a STALE name from a prior fn and a later `var` with that
            # name would falsely trip the duplicate-var check.
            S64(S + 0x5D9D000 + cl_obj_slot * 8, 0 - 1);
            SLDEP(S, cl_obj_slot, 0);
            EFLSTORE(S, cl_obj_slot);        # spill the object pointer
            SFLC(S, cl_obj_slot + 1);
            # obj[0] = closure fn address
            EFLLOAD(S, cl_obj_slot);
            EPUSHR(S);                       # push dest = obj + 0
            var clfc = GFCNT(S);
            if (clfc >= 1048576) {
                syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
                syscall(SYS_EXIT, 1);
            }
            ELOAD_FN_ADDR(S, _fixup_base + clfc * 16, clfc, clfi);   # rax = fn addr
            EPOPC(S);                        # rcx = dest
            ESTORE64(S);                     # [obj+0] = fn addr
            # obj[1+i] = captured enclosing local (cap_slots[i]); state is restored,
            # so EFLLOAD reads the enclosing fn's local — capture BY VALUE.
            var cl_ci = 0;
            while (cl_ci < _cl_ncap) {
                EFLLOAD(S, cl_obj_slot);
                EADDRA_IMM(S, (1 + cl_ci) * 8);   # rax = obj + (1+ci)*8 (dest)
                EPUSHR(S);
                EFLLOAD(S, L64(&_cl_cap_slots + cl_ci * 8));   # rax = captured value
                EPOPC(S);                          # rcx = dest
                ESTORE64(S);
                cl_ci = cl_ci + 1;
            }
            EFLLOAD(S, cl_obj_slot);          # closure value = the object pointer
        } else {
            # Non-capturing closure: a bare fn pointer (same fixup-type-3 op as
            # `&fn_name`). v6.3.7-stable path.
            var clfc = GFCNT(S);
            if (clfc >= 1048576) {
                syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
                syscall(SYS_EXIT, 1);
            }
            var clfaddr = _fixup_base + clfc * 16;
            ELOAD_FN_ADDR(S, clfaddr, clfc, clfi);
        }
        # v6.3.8 — flag a capturing closure so the enclosing var-decl tags the var
        # CLOSURE_TYID (callptr auto-dispatch). Non-capturing → 0 (bare fn pointer).
        _expr_closure_obj = cl_cap_shift;
        return 0;
    }
    ERR(S);
    return 0;
}
# f64 binary ops
fn PF64BIN(S, tok): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
    PCMPE(S); EPUSHR(S);
    if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
    PCMPE(S);
    EMIT_F64_BINOP(S, tok - 62);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
    return 0;
}
# f64 compare ops
fn PF64CMP(S, tok): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
    PCMPE(S); EPUSHR(S);
    if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
    PCMPE(S);
    EPOPC(S); EPUSHR(S);
    # At this point x1 = a, stack = [b], x0 (/ rax on x86) = b.
    # v5.6.12: f64 compare — per-arch raw FCMP/UCOMISD + SETcc chain.
    _IR_REC0(S, IR_RAW_EMIT);
    # v5.11.38 path-A: f64 cmp dispatch lives in <backend>/emit.cyr.
    EF64_CMP(S, tok);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
    return 0;
}

# Constant folding state (codegen-level, same EMOVI size only)
# Handle extended SIMD builtins (tokens 93-96) in separate function
# v5.10.35 — stash arg value at slot AND mark locname[idx] = -1
# (anonymous), so subsequent FINDLOCAL("r") inside the enclosing
# fn doesn't pick up this stash slot as a named local.
#
# Pre-v5.10.35 bug: cyrius's locname table at S+0x191000 is shared
# across all fn body parses (FLC resets to 0 at fn entry, but stale
# locname entries from PRIOR fns persist at higher indices). Plain
# EFLSTORE writes the value but not the name slot. So if a prior fn
# had a local named "r" at idx N, AND the current fn's f64v_abs
# (or any other PARSE_SIMD_EXT intrinsic) places its arg-stash at
# idx N, then FINDLOCAL("r") AFTER the intrinsic call returns N (the
# stash slot with stale "r" name) instead of the real `var r` slot
# at a lower idx. Consequence: `return r;` post-call reads from the
# stash (which contained the stored &r pointer-VALUE at the time of
# the call), so the caller gets a stack address back instead of the
# absed/sqrt'd bytes.
#
# The bug surfaced through the v5.10.33 typed-wrapper layer (sandhi
# / hisab consumers using `fn f64v2_abs(p): f64v2 { var r; f64v_abs(&r,p,2);
# return r; }`). 4-arg intrinsics (add/sub/mul/div/scale/axpy/fmadd)
# happened to dodge it because their stash slot range usually didn't
# overlap stale "r" entries in real consumer code; 3-arg
# (abs/sqrt/dot) hit the +1 offset that did.
#
# Fix is independent of arity: every stash store anonymises the slot.
fn _SIMD_STASH(S, idx): i64 {
    EFLSTORE(S, idx);
    S64(S + 0x5D9D000 + idx * 8, 0 - 1);
    return 0;
}

fn PARSE_SIMD_EXT(S, ptyp): i64 {
    # f64v_div(dst, a, b, n)
    if (ptyp == 93) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        SFLC(S, vbase + 3);
        EMIT_F64V_LOOP(S, 3, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # f64v_sqrt(dst, src, n)
    if (ptyp == 94) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        SFLC(S, vbase + 2);
        EMIT_F64V_UNARY(S, 0, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # f64v_abs(dst, src, n)
    if (ptyp == 95) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        SFLC(S, vbase + 2);
        EMIT_F64V_UNARY(S, 1, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # f64v_fmadd(dst, a, b, c, n)
    if (ptyp == 96) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 3);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        SFLC(S, vbase + 4);
        EMIT_F64V_FMADD(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v5.10.17: f64v_dot(a, b, n) → f64 in rax/x0 (sum of a[i]*b[i])
    if (ptyp == 128) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        SFLC(S, vbase + 2);
        EMIT_F64V_DOT(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v5.10.17: f64v_scale(dst, a, scalar, n) — dst[i] = a[i] * scalar
    if (ptyp == 129) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        SFLC(S, vbase + 3);
        EMIT_F64V_SCALE(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v5.10.17: f64v_axpy(y, x, alpha, n) — y[i] += alpha * x[i]
    if (ptyp == 130) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        SFLC(S, vbase + 3);
        EMIT_F64V_AXPY(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # ret2(a, b) — return two values in rax:rdx
    if (ptyp == 97) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S);
        EPUSHR(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        # rax = b, stack = a → mov rdx, rax; pop rax
        EMOVRDXRAX(S);
        EPOPR(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        # Don't consume ; here — PARSE_STMT handles it via expression statement path
        var rp = EJMP0(S);
        vec_push(rp_vec, rp);
        return 0;
    }
    # f64_atan(x) — v5.11.37 path-A: dispatch lives in <backend>/emit.cyr.
    if (ptyp == 99) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_ATAN(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # rethi() — read rdx from last function call (mov rax, rdx)
    if (ptyp == 98) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        EMOVRA_RDX(S);
        return 0;
    }
    # bitget(val, offset, width) → (val >> offset) & ((1 << width) - 1)
    if (ptyp == 102) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S); ESPILL(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        # rax = offset, stack = val. Shift val >> offset
        EMOVCA(S); EUNSPILL(S); ESHRCL(S);
        # Now rax = val >> offset. Need to mask with (1 << width) - 1
        ESPILL(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        # rax = width. Compute mask: (1 << width) - 1
        EMOVCA(S); EMOVI(S, 1); ESHLCL(S);
        # rax = 1 << width. Subtract 1.
        ESPILL(S); EMOVI(S, 1); EMOVCA(S); EUNSPILL(S); ESUBR(S);
        # rax = mask. AND with shifted val.
        EMOVCA(S); EUNSPILL(S); EANDR(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # bitset(val, offset, width, new) → (val & ~(mask << offset)) | ((new & mask) << offset)
    if (ptyp == 103) {
        if (GINFN(S) == 0) { ERR_MSG(S, "bitset must be called inside a function", 39); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var bsb = GFLC(S);
        SFLC(S, bsb + 5);
        # v5.10.35 — anonymise stash slots up front (s4 = mask filled
        # below) so stale locname entries from prior fn-body parses
        # can't be picked up by post-call FINDLOCal lookups. Same fix
        # shape as _SIMD_STASH used by f64v_* intrinsics.
        S64(S + 0x5D9D000 + bsb * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bsb + 1) * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bsb + 2) * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bsb + 3) * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bsb + 4) * 8, 0 - 1);
        PCMPE(S); EFLSTORE(S, bsb);              # s0 = val
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bsb + 1);          # s1 = offset
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bsb + 2);          # s2 = width
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bsb + 3);          # s3 = new_val
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        # mask = (1 << width) - 1
        EFLLOAD(S, bsb + 2); EMOVCA(S); EMOVI(S, 1); ESHLCL(S);
        ESPILL(S); EMOVI(S, 1); EMOVCA(S); EUNSPILL(S); ESUBR(S);
        EFLSTORE(S, bsb + 4);                    # s4 = mask
        # cleared = val & ~(mask << offset)
        EFLLOAD(S, bsb + 4); ESPILL(S);
        EFLLOAD(S, bsb + 1); EMOVCA(S); EUNSPILL(S); ESHLCL(S);
        ENOTR(S); ESPILL(S);
        EFLLOAD(S, bsb); EMOVCA(S); EUNSPILL(S); EANDR(S);
        EFLSTORE(S, bsb);                        # s0 = cleared
        # insert = (new_val & mask) << offset
        EFLLOAD(S, bsb + 3); ESPILL(S);
        EFLLOAD(S, bsb + 4); EMOVCA(S); EUNSPILL(S); EANDR(S);
        ESPILL(S);
        EFLLOAD(S, bsb + 1); EMOVCA(S); EUNSPILL(S); ESHLCL(S);
        # result = cleared | insert
        ESPILL(S); EFLLOAD(S, bsb); EMOVCA(S); EUNSPILL(S); EORR(S);
        return 0;
    }
    # bitclr(val, offset, width) → val & ~(((1 << width) - 1) << offset)
    if (ptyp == 104) {
        if (GINFN(S) == 0) { ERR_MSG(S, "bitclr must be called inside a function", 39); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var bcb = GFLC(S);
        SFLC(S, bcb + 3);
        # v5.10.35 — anonymise stash slots (see bitset comment above).
        S64(S + 0x5D9D000 + bcb * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bcb + 1) * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bcb + 2) * 8, 0 - 1);
        PCMPE(S); EFLSTORE(S, bcb);              # s0 = val
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bcb + 1);          # s1 = offset
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bcb + 2);          # s2 = width
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        # mask = (1 << width) - 1
        EFLLOAD(S, bcb + 2); EMOVCA(S); EMOVI(S, 1); ESHLCL(S);
        ESPILL(S); EMOVI(S, 1); EMOVCA(S); EUNSPILL(S); ESUBR(S);
        # mask << offset
        ESPILL(S); EFLLOAD(S, bcb + 1); EMOVCA(S); EUNSPILL(S); ESHLCL(S);
        # ~(mask << offset) & val
        ENOTR(S); ESPILL(S);
        EFLLOAD(S, bcb); EMOVCA(S); EUNSPILL(S); EANDR(S);
        return 0;
    }
    return 0;
}

var _cfv = 0;
var _cfp = 0;
var _cfo = 0;

# v5.6.7 O2 strength-reduction helper: if the next token is an
# integer literal whose value is a positive power of two (2, 4, 8,
# …, 2^63 — well, up to 2^62 since 2^63 is signed-negative), emit
# `shl` by the shift amount instead of a full `imul`. Both backends
# have ESHLIMM (x86 `shl rax, n`; aarch64 `lsl x0, x0, #n`). Assumes
# ESPILL has already pushed the LHS; on hit, EUNSPILL pops it back
# into rax / x0 before the shift.
# Returns 1 on peephole hit (mul replaced with shl), 0 on miss
# (caller falls through to the standard PARSE_FACTOR + EIMUL path).
fn _TRY_MUL_BY_POW2(S): i64 {
    if (PEEKT(S) != 1) { return 0; }
    var pv = PEEKV(S);
    if (pv < 2) { return 0; }
    if ((pv & (pv - 1)) != 0) { return 0; }
    var shift = 0;
    var v = pv;
    while (v > 1) { v = v >> 1; shift = shift + 1; }
    STI(S, GTI(S) + 1);      # consume the literal
    EUNSPILL(S);             # pop LHS back into rax / x0
    ESHLIMM(S, shift);
    return 1;
}

fn PARSE_TERM(S): i64 {
    _cfo = 0;
    # Extended builtins — checked first
    var ptyp = PEEKT(S);
    if (ptyp >= 93) { if (ptyp <= 99) { return PARSE_SIMD_EXT(S, ptyp); } }
    if (ptyp >= 100) { if (ptyp <= 104) { return PARSE_SIMD_EXT(S, ptyp); } }
    # v5.10.17 — f64v_dot/scale/axpy
    if (ptyp >= 128) { if (ptyp <= 130) { return PARSE_SIMD_EXT(S, ptyp); } }
    # f64 builtins — check before PARSE_FACTOR dispatches.
    # v5.11.37 path-A: each ptyp dispatches to its named op in
    # <backend>/emit.cyr — x86 emits SSE2/x87, aarch64 emits FNEG /
    # polyfill-call / hard-error, cx is no-op. parse_expr.cyr is
    # arch-agnostic for these ops.
    if (ptyp >= 62) { if (ptyp <= 65) { PF64BIN(S, ptyp); return 0; } }
    if (ptyp == 66) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EI2F(S); EMOVQ_A_X0(S); SESTYPE(S, F64_TYID); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp == 67) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EMOVQ_X0_A(S); EF2I(S); SESTYPE(S, 0); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp >= 68) { if (ptyp <= 70) { PF64CMP(S, ptyp); return 0; } }
    if (ptyp == 71) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_NEG(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # f64_sqrt(x) — sqrtsd xmm0, xmm0
    if (ptyp == 79) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EMOVQ_X0_A(S); EF64SQRT(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # f64_abs(x) — v5.11.40 path-A peephole. Dispatch lives in
    # <backend>/emit.cyr::EF64_ABS: x86 movabs+and (saves 5 B vs
    # the prior 5-instr push/movabs/movca/pop/and = 18 B); aarch64
    # native fabs via fmov/fabs/fmov (saves 20 B vs the prior
    # MOVK-chain + shuttle); cx no-op stub. See CHANGELOG [5.11.40].
    if (ptyp == 80) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_ABS(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # f64_floor(x) — roundsd xmm0, xmm0, 1 (SSE4.1)
    if (ptyp == 81) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EMOVQ_X0_A(S); EF64FLOOR(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # f64_ceil(x) — roundsd xmm0, xmm0, 2 (SSE4.1)
    if (ptyp == 82) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EMOVQ_X0_A(S); EF64CEIL(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # f64_round(x) — roundsd xmm0, xmm0, 0 (round to nearest)
    if (ptyp == 92) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EMOVQ_X0_A(S); EF64ROUND(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # f32_from(x): f64 → f32 bit pattern (cvtsd2ss). f32_to(x): f32 → f64 (cvtss2sd).
    # v6.2.18 native-float math arc. Backend emit takes the value in rax, returns
    # the converted bits in rax (full move/cvt/move sequence lives per-arch).
    if (ptyp == 131) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF32_FROM(S); SESTYPE(S, 0); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp == 132) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF32_TO(S); SESTYPE(S, F64_TYID); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp == 83) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_SIN(S);  if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp == 84) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_COS(S);  if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp == 85) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_EXP(S);  if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp == 86) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_LN(S);   if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp == 87) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_LOG2(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    if (ptyp == 88) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_EXP2(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # f64v_add/sub/mul(dst, a, b, n) — SSE2 packed f64 batch operations.
    # v5.10.39 — route through _SIMD_STASH (was bare EFLSTORE pre-fix).
    # The v5.10.35 locname-staleness fix covered f64v_div/sqrt/abs/
    # fmadd/dot/scale/axpy in PARSE_SIMD_EXT but missed this separate
    # f64v_add/sub/mul path at ptyp 89-91 — stash slots weren't
    # anonymised, and stale `r` entries from a prior fn parse caused
    # `return r;` after f64v_add inside a wrapper to load the stash
    # slot (containing &r pointer-VALUE) instead of the real var r.
    # Surfaced at v5.10.39 when adding value-form siblings to
    # lib/simd.cyr made the stale-collision reliable.
    if (ptyp >= 89) { if (ptyp <= 91) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
            var vbase = GFLC(S);
            PCMPE(S); _SIMD_STASH(S, vbase);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vbase + 1);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vbase + 2);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S);
            SFLC(S, vbase + 3);
            EMIT_F64V_LOOP(S, ptyp - 89, vbase);
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
            return 0;
        } }
    PARSE_FACTOR(S);
    # v5.8.29 — postfix `?` propagation operator. After the primary
    # factor evaluates (rax = Result heap pointer), `?` desugars to:
    #   tag = load64(rax)
    #   if (tag != Ok) { return rax; }   # Err path: short-circuit
    #   rax = load64(rax + 8)            # Ok path: unwrap payload
    # Highest precedence — binds tighter than `*`/`/` (handled below)
    # so `foo()? * bar` is `(foo()?) * bar`. Outside a fn body is a
    # parse-time error (the early-return jump would have nowhere to
    # land). The acceptance gate "outside Result-returning fn is type
    # error" is enforced in this slot at the coarser "outside any fn
    # body" granularity — strict ret-type tracking is a future slot.
    if (PEEKT(S) == 124) {
        STI(S, GTI(S) + 1);
        if (GINFN(S) == 0) {
            ERR_MSG(S, "?: '?' propagation operator only valid inside a fn body", 56);
        }
        # Hidden temp slot to hold the Result ptr across the
        # tag-check / unwrap branches (same idiom as PARSE_MATCH).
        var qidx = GVCNT(S);
        S64(_varn_base + qidx * 8, 0);
        S64(_vars_base + qidx * 8, 8);
        SVCNT(S, qidx + 1);
        EVSTORE(S, qidx);                 # save result_ptr
        # Load tag and compare to 0 (Ok = 0, Err = 1)
        EVLOAD(S, qidx);                  # rax = result_ptr
        ELOAD64(S);                       # rax = [rax] = tag
        EPUSHR(S);
        EMOVI(S, 0);
        EMOVCA(S);                        # rcx = 0 (Ok)
        EPOPR(S);                         # rax = tag
        ECMPR(S);                         # cmp rax, rcx
        var qjcc_ok = EJCC(S, 0x84);      # JE → skip Err branch if Ok
        # Err path: rax = result_ptr, jmp to fn epilogue (RPC table)
        EVLOAD(S, qidx);
        var qrp = EJMP0(S);
        vec_push(rp_vec, qrp);
        # Ok path landing: rax = [result_ptr + 8] (payload)
        EPATCH(S, qjcc_ok);
        EVLOAD(S, qidx);                  # rax = result_ptr
        EPUSHR(S);
        EMOVI(S, 8);
        EMOVCA(S);                        # rcx = 8
        EPOPR(S);                         # rax = result_ptr
        EADDR(S);                         # rax = result_ptr + 8
        ELOAD64(S);                       # rax = [result_ptr + 8] = payload
        _cfo = 0;                         # invalidate const-fold tracking
    }
    var go = 1;
    while (go == 1) {
        var typ = PEEKT(S);
        # v5.6.2: `*%` is identical to bare `*` (wrapping default on
        # 2's-complement). Collapse the token ID.
        if (typ == 119) { typ = 8; }
        if (typ == 8) {
            var mulst = GESTYPE(S);
            STI(S, GTI(S) + 1);
            if (mulst == F64_TYID) { ESPILL(S); PARSE_FACTOR(S); EMIT_F64_BINOP(S, 2); SESTYPE(S, F64_TYID); _cfo = 0; }
            elif (mulst > 0) { EMIT_OP_DISPATCH(S, mulst, "mul", 3); }
            else {
                # Constant fold: NUM * NUM where both and result are small positive
                if (_cfo == 1) {
                    if (PEEKT(S) == 1) {
                        var crv = PEEKV(S);
                        if (crv == 0) { STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, 0); _cfv = 0; }
                        elif (crv == 1) { STI(S, GTI(S) + 1); }
                        elif (crv > 0) {
                            var cfr = _cfv * crv;
                            if (cfr >= 0) {
                                STI(S, GTI(S) + 1);
                                SCP(S, _cfp);
                                EMOVI(S, cfr);
                                _cfv = cfr;
                            } else {
                                # v5.6.7 O2: cfr overflowed — try shl
                                # strength-reduction before falling to imul.
                                # (v6.1.37: also clear _cfo AFTER — PARSE_FACTOR
                                # may re-arm it on a const RHS.)
                                _cfo = 0;
                                ESPILL(S);
                                if (_TRY_MUL_BY_POW2(S) == 1) { _cfo = 0; }
                                else { PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); EIMUL(S); _cfo = 0; }
                            }
                        }
                        else {
                            _cfo = 0;
                            ESPILL(S);
                            if (_TRY_MUL_BY_POW2(S) == 1) { _cfo = 0; }
                            else { PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); EIMUL(S); _cfo = 0; }
                        }
                    } else {
                        # The RHS may itself be an enum/NUM const — PARSE_FACTOR
                        # re-arms const-fold tracking (_cfo/_cfp/_cfv). After this
                        # runtime EIMUL we MUST re-clear _cfo, or the NEXT `*`
                        # const-folds off the stale RHS and rewinds the code,
                        # DROPPING this product (`A * B * 4` → `B * 4` = 800).
                        # Mirrors the outer-else path. See issue 2026-06-11
                        # agnos-const-3operand-multiply-miscompile (all targets).
                        _cfo = 0;
                        ESPILL(S);
                        if (_TRY_MUL_BY_POW2(S) == 1) { _cfo = 0; }
                        else { PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); EIMUL(S); _cfo = 0; }
                    }
                } else {
                    # v5.6.7 O2: ESPILL LHS, then try strength-reduction
                    # (literal power-of-2 RHS → shl) before emitting the
                    # general `PARSE_FACTOR + EIMUL` sequence.
                    ESPILL(S);
                    if (_TRY_MUL_BY_POW2(S) == 1) { _cfo = 0; }
                    else { PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); EIMUL(S); _cfo = 0; }
                }
            }
        }
        else { if (typ == 9) {
                var divst = GESTYPE(S);
                STI(S, GTI(S) + 1);
                if (divst == F64_TYID) { ESPILL(S); PARSE_FACTOR(S); EMIT_F64_BINOP(S, 3); SESTYPE(S, F64_TYID); _cfo = 0; }
                elif (divst > 0) { EMIT_OP_DISPATCH(S, divst, "div", 3); }
                else {
                    if (_cfo == 1) { if (PEEKT(S) == 1) {
                            var crv = PEEKV(S);
                            if (crv > 0) { if (crv < 0x10000) {
                                    var cfr = _cfv / crv;
                                    if (cfr > 0) { if (cfr < 0x10000) {
                                            STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                        } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); } }
                                    else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); }
                                } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); } }
                            else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); }
                        } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); } }
                    else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); _cfo = 0; }
                }
            }
            else { if (typ == 34) {
                    STI(S, GTI(S) + 1); _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); EMOVDR(S); _cfo = 0;
                }
                else { if (typ == 38) {
                        STI(S, GTI(S) + 1);
                        if (_cfo == 1) { if (PEEKT(S) == 1) {
                                var crv = PEEKV(S);
                                if (crv > 0) { if (crv < 0x10000) {
                                        var cfr = _cfv << crv;
                                        if (cfr > 0) { if (cfr < 0x10000) {
                                                STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                            } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); } }
                                        else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); }
                                    } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); } }
                                else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); }
                            } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); } }
                        else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); _cfo = 0; }
                    }
                    else { if (typ == 39) {
                            STI(S, GTI(S) + 1);
                            if (_cfo == 1) { if (PEEKT(S) == 1) {
                                    var crv = PEEKV(S);
                                    if (crv > 0) { if (crv < 0x10000) {
                                            var cfr = _cfv >> crv;
                                            if (cfr > 0) { if (cfr < 0x10000) {
                                                    STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                                } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); } }
                                            else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); }
                                        } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); } }
                                    else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); }
                                } else { _cfo = 0; ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); } }
                            else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); _cfo = 0; }
                        }
                        # v5.6.2: *| / *? — saturating / checked mul. Calls into
                        # lib/overflow.cyr. Matches the +|/+? pattern at PEXPR.
                        else { if (typ == 120) {
                                STI(S, GTI(S) + 1);
                                EPUSHR(S);
                                PARSE_FACTOR(S);
                                EPUSHR(S);
                                EMIT_OVF_CALL(S, "_sat_mul_i64");
                                _cfo = 0;
                            }
                            else { if (typ == 121) {
                                    STI(S, GTI(S) + 1);
                                    EPUSHR(S);
                                    PARSE_FACTOR(S);
                                    EPUSHR(S);
                                    EMIT_OVF_CALL(S, "_chk_mul_i64");
                                    _cfo = 0;
                                }
                                else { go = 0; }
                            } } } } } }
    }
    return 0;
}

fn EPTR_SCALE(S, ps): i64 {
    # rax has the offset value; multiply by pointer scale
    # mov rcx, rax; mov rax, ps; imul rcx → rax = offset * scale
    if (ps > 1) { EMOVCA(S); EMOVI(S, ps); EIMUL(S); }
    return 0;
}

# Build operator function name: StructName_op in tok_names
# op_name is a short string like "add", "sub", "mul", "div"
fn BUILD_OP_NAME(S, stype, op_str, op_len): i64 {
    var si = stype - 1;
    var snoff = L64(S + 0x1A6018 + si * 8);
    # v5.11.65 (CVE-05): bound against actual struct-name length + op
    # suffix; was magic-256 pessimistic budget. See CHANGELOG [5.11.65].
    var _snlen = 0; while (load8(S + 0x60000 + snoff + _snlen) != 0) { _snlen = _snlen + 1; }
    NPOS_GUARD(S, _snlen + 1 + op_len + 1);
    var owp = GNPOS(S);
    var onoff = owp;
    var ori = 0;
    var orc = load8(S + 0x60000 + snoff + ori);
    while (orc != 0) { store8(S + 0x60000 + owp, orc); owp = owp + 1; ori = ori + 1; orc = load8(S + 0x60000 + snoff + ori); }
    store8(S + 0x60000 + owp, 95); owp = owp + 1;
    var oci = 0;
    while (oci < op_len) { store8(S + 0x60000 + owp + oci, load8(op_str + oci)); oci = oci + 1; }
    owp = owp + op_len;
    store8(S + 0x60000 + owp, 0); owp = owp + 1;
    SNPOS(S, owp);
    return onoff;
}

# Emit operator dispatch: push lhs, parse rhs, call StructName_op(lhs, rhs)
fn EMIT_OP_DISPATCH(S, stype, op_str, op_len): i64 {
    # For struct vars, push address instead of value
    var svar = GESVAR(S);
    if (svar >= 0) { EVADDR(S, svar); }
    EPUSHR(S);
    PARSE_TERM(S);
    # rhs: check if it also has a struct var
    var rsvar = GESVAR(S);
    if (rsvar >= 0) { EVADDR(S, rsvar); }
    EPUSHR(S);
    var opnoff = BUILD_OP_NAME(S, stype, op_str, op_len);
    ECALLPOPS(S, 2);
    var ofi = FINDFN(S, opnoff);
    if (ofi < 0) { ofi = REGFN(S, opnoff); }
    var ofoff = L64(_fnt_offsets + ofi * 8);
    if (ofoff >= 0) { ECALLTO(S, ofoff); }
    else { ECALLFIX(S, ofi); }
    ECALLCLEAN(S, 2);
    SESTYPE(S, 0);
    return 0;
}

# v5.6.2: emit a binop as a call to a named stdlib helper fn
# (`_sat_add_i64` / `_chk_sub_i64` / etc. — see `lib/overflow.cyr`).
# Assumes lhs is already pushed and rhs is pushed right before the call
# (ECALLPOPS consumes 2 stack args). If the helper isn't defined at
# link time the standard "undefined function" diagnostic fires on the
# generated call — with the v5.6.0 `--strict` flag that's a hard-error.
fn EMIT_OVF_CALL(S, fname_str): i64 {
    var flen = 0;
    while (load8(fname_str + flen) != 0) { flen = flen + 1; }
    NPOS_GUARD(S, flen + 1);
    var np = GNPOS(S);
    var i = 0;
    while (i < flen) {
        store8(S + 0x60000 + np + i, load8(fname_str + i));
        i = i + 1;
    }
    store8(S + 0x60000 + np + flen, 0);
    SNPOS(S, np + flen + 1);
    var fi = FINDFN(S, np);
    if (fi < 0) { fi = REGFN(S, np); }
    ECALLPOPS(S, 2);
    var foff = L64(_fnt_offsets + fi * 8);
    if (foff >= 0) { ECALLTO(S, foff); }
    else { ECALLFIX(S, fi); }
    ECALLCLEAN(S, 2);
    return 0;
}

fn PEXPR(S): i64 {
    PARSE_TERM(S);
    var ps = GPSC(S);
    var go = 1;
    while (go == 1) {
        var typ = PEEKT(S);
        # v5.6.2: `+%` / `-%` are semantically identical to bare `+` /
        # `-` (wrapping is the default on 2's-complement); collapse
        # token IDs so the existing dispatch below handles them.
        if (typ == 113) { typ = 6; }
        elif (typ == 116) { typ = 7; }
        # `+|` / `+?` / `-|` / `-?` compile to a call to the
        # corresponding `lib/overflow.cyr` helper. Handled in their own
        # branches below so the constant-fold paths don't fire on them.
        if (typ == 6) {
            var addst = GESTYPE(S);
            STI(S, GTI(S) + 1);
            if (addst == F64_TYID) { ESPILL(S); PARSE_TERM(S); EMIT_F64_BINOP(S, 0); SESTYPE(S, F64_TYID); _cfo = 0; }
            elif (addst > 0) { EMIT_OP_DISPATCH(S, addst, "add", 3); _cfo = 0; }
            else {
                # Fold only if right side is a plain literal (not followed by * / % << >>)
                var add_can_fold = 0;
                if (_cfo == 1) { if (PEEKT(S) == 1) {
                        var nt = TOKTYP(S, GTI(S) + 1);
                        if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                            add_can_fold = 1;
                                        } } } } }
                    } }
                if (add_can_fold == 1) {
                    var crv = PEEKV(S);
                    if (crv == 0) { STI(S, GTI(S) + 1); }
                    elif (crv > 0) {
                        var cfr = _cfv + crv;
                        if (cfr >= 0) {
                            STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                        } else { _cfo = 0; ESPILL(S); SPSC(S, 0); PARSE_TERM(S); EPTR_SCALE(S, ps); EMOVCA(S); EUNSPILL(S); EADDR(S); SPSC(S, ps); }
                    }
                    else { _cfo = 0; ESPILL(S); SPSC(S, 0); PARSE_TERM(S); EPTR_SCALE(S, ps); EMOVCA(S); EUNSPILL(S); EADDR(S); SPSC(S, ps); }
                } else { ESPILL(S); SPSC(S, 0); PARSE_TERM(S); EPTR_SCALE(S, ps); EMOVCA(S); EUNSPILL(S); EADDR(S); SPSC(S, ps); _cfo = 0; }
            }
        }
        else { if (typ == 7) {
                var subst = GESTYPE(S);
                STI(S, GTI(S) + 1);
                if (subst == F64_TYID) { ESPILL(S); PARSE_TERM(S); EMIT_F64_BINOP(S, 1); SESTYPE(S, F64_TYID); _cfo = 0; }
                elif (subst > 0) { EMIT_OP_DISPATCH(S, subst, "sub", 3); _cfo = 0; }
                else {
                    var sub_can_fold = 0;
                    if (_cfo == 1) { if (PEEKT(S) == 1) {
                            var nt = TOKTYP(S, GTI(S) + 1);
                            if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                                sub_can_fold = 1;
                                            } } } } }
                        } }
                    if (sub_can_fold == 1) {
                        var crv = PEEKV(S);
                        if (crv == 0) { STI(S, GTI(S) + 1); }
                        elif (crv > 0) {
                            var cfr = _cfv - crv;
                            if (cfr >= 0) {
                                STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                            } else { _cfo = 0; EPUSHR(S); SPSC(S, 0); PARSE_TERM(S); EPTR_SCALE(S, ps); EMOVCA(S); EPOPR(S); ESUBR(S); SPSC(S, ps); }
                        }
                        else { _cfo = 0; EPUSHR(S); SPSC(S, 0); PARSE_TERM(S); EPTR_SCALE(S, ps); EMOVCA(S); EPOPR(S); ESUBR(S); SPSC(S, ps); }
                    } else { EPUSHR(S); SPSC(S, 0); PARSE_TERM(S); EPTR_SCALE(S, ps); EMOVCA(S); EPOPR(S); ESUBR(S); SPSC(S, ps); _cfo = 0; }
                }
            }
            # v5.6.2: +| / +? / -| / -? — saturating / checked add/sub.
            # Compiles to a call into lib/overflow.cyr. No constant-fold
            # path; let the helper handle any corner cases. SPSC(0) during
            # PARSE_TERM so pointer scaling doesn't apply (overflow ops
            # are defined on integers only).
            else { if (typ == 114) {
                    STI(S, GTI(S) + 1);
                    EPUSHR(S);
                    SPSC(S, 0);
                    PARSE_TERM(S);
                    EPUSHR(S);
                    EMIT_OVF_CALL(S, "_sat_add_i64");
                    SPSC(S, ps);
                    _cfo = 0;
                }
                else { if (typ == 115) {
                        STI(S, GTI(S) + 1);
                        EPUSHR(S);
                        SPSC(S, 0);
                        PARSE_TERM(S);
                        EPUSHR(S);
                        EMIT_OVF_CALL(S, "_chk_add_i64");
                        SPSC(S, ps);
                        _cfo = 0;
                    }
                    else { if (typ == 117) {
                            STI(S, GTI(S) + 1);
                            EPUSHR(S);
                            SPSC(S, 0);
                            PARSE_TERM(S);
                            EPUSHR(S);
                            EMIT_OVF_CALL(S, "_sat_sub_i64");
                            SPSC(S, ps);
                            _cfo = 0;
                        }
                        else { if (typ == 118) {
                                STI(S, GTI(S) + 1);
                                EPUSHR(S);
                                SPSC(S, 0);
                                PARSE_TERM(S);
                                EPUSHR(S);
                                EMIT_OVF_CALL(S, "_chk_sub_i64");
                                SPSC(S, ps);
                                _cfo = 0;
                            }
                            else { if (typ == 27) {
                                    # AMPERSAND — binary AND
                                    STI(S, GTI(S) + 1);
                                    var and_can_fold = 0;
                                    if (_cfo == 1) { if (PEEKT(S) == 1) {
                                            var nt = TOKTYP(S, GTI(S) + 1);
                                            if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                                                and_can_fold = 1;
                                                            } } } } }
                                        } }
                                    if (and_can_fold == 1) {
                                        var crv = PEEKV(S);
                                        if (crv > 0) { if (crv < 0x10000) {
                                                var cfr = _cfv & crv;
                                                if (cfr > 0) { if (cfr < 0x10000) {
                                                        STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                                    } else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); } }
                                                else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); }
                                            } else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); } }
                                        else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); }
                                    } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); _cfo = 0; }
                                }
                                else { if (typ == 35) {
                                        # PIPE — binary OR
                                        STI(S, GTI(S) + 1);
                                        var or_can_fold = 0;
                                        if (_cfo == 1) { if (PEEKT(S) == 1) {
                                                var nt = TOKTYP(S, GTI(S) + 1);
                                                if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                                                    or_can_fold = 1;
                                                                } } } } }
                                            } }
                                        if (or_can_fold == 1) {
                                            var crv = PEEKV(S);
                                            if (crv > 0) { if (crv < 0x10000) {
                                                    var cfr = _cfv | crv;
                                                    if (cfr > 0) { if (cfr < 0x10000) {
                                                            STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                                        } else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); } }
                                                    else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); }
                                                } else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); } }
                                            else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); }
                                        } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); _cfo = 0; }
                                    }
                                    else { if (typ == 36) {
                                            # CARET — binary XOR
                                            STI(S, GTI(S) + 1);
                                            var xor_can_fold = 0;
                                            if (_cfo == 1) { if (PEEKT(S) == 1) {
                                                    var nt = TOKTYP(S, GTI(S) + 1);
                                                    if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                                                        xor_can_fold = 1;
                                                                    } } } } }
                                                } }
                                            if (xor_can_fold == 1) {
                                                var crv = PEEKV(S);
                                                if (crv > 0) { if (crv < 0x10000) {
                                                        var cfr = _cfv ^ crv;
                                                        if (cfr > 0) { if (cfr < 0x10000) {
                                                                STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                                            } else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); } }
                                                        else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); }
                                                    } else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); } }
                                                else { _cfo = 0; EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); }
                                            } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); _cfo = 0; }
                                        }
                                        else { go = 0; }
                                    } } } } } } } }
    }
    return 0;
}

# Parse comparison expression: expr [cmp_op expr] [&& || cmp_expr]*
# Returns value in rax (0 or 1 for comparisons).
# Supports && (53) and || (54) as expression-level logical operators.
fn PCMPE(S): i64 {
    PEXPR(S);
    var op = PEEKT(S);
    if (op >= 17) {
        if (op <= 22) {
            # v6.2.19: f64 comparison-operator sugar. Capture the lhs type BEFORE
            # parsing the rhs (PEXPR(rhs) overwrites the expr-state-type). For an
            # f64 lhs, route to EF64_CMP (ucomisd/fcmp + setcc) instead of the
            # integer ESETCC; the operand setup (lhs→rcx, rhs on stack + in rax)
            # mirrors PF64CMP's. Result is an i64 boolean (SESTYPE 0).
            var cmpst = GESTYPE(S);
            STI(S, GTI(S) + 1);
            _cfo = 0;
            EPUSHR(S);
            PEXPR(S);
            if (cmpst == F64_TYID) {
                EPOPC(S); EPUSHR(S);
                EF64_CMP(S, op);
                SESTYPE(S, 0);
            } else {
                EMOVCA(S);
                EPOPR(S);
                ESETCC(S, op);
            }
            _cfo = 0;
        }
    }
    # Short-circuit && and || chains (fixed in 4.4.1 — docs always claimed
    # short-circuit but the prior bitwise AND/OR impl evaluated both sides
    # unconditionally, causing silent miscompiles on guarded null checks
    # like `if (p != 0 && vec_len(p) > 0)` — bote feedback item 2).
    #
    # && codegen: eval left, cmp 0, je skip_right, eval right, cmp 0, setne al,
    #             jmp end, skip_right: xor rax, rax, end:
    # || codegen: eval left, cmp 0, jne skip_right, eval right, cmp 0, setne al,
    #             jmp end, skip_right: mov rax, 1, end:
    var lop = PEEKT(S);
    while (lop == 53 || lop == 54) {
        # Normalize left into boolean (0 or 1) already in rax. If a comparison
        # op preceded, ESETCC already did this; otherwise cmp rax,0; setne al.
        # But after the top block, rax already holds either a boolean (from
        # ESETCC) or an integer value — we short-circuit on "rax == 0" either
        # way, so we just need to cmp rax, 0 and branch.
        # cmp rax, 0
        EPUSHR(S);
        EMOVI(S, 0);
        EMOVCA(S);
        EPOPR(S);
        ECMPR(S);
        # For && : skip right side when left is 0 (false), jumping to the
        #          "write 0 to rax" tail. je rel32.
        # For || : skip right side when left is NOT 0 (true), jumping to the
        #          "write 1 to rax" tail. jne rel32.
        var is_and = 0;
        if (lop == 53) { is_and = 1; }
        var p_skip = 0;
        if (is_and == 1) { p_skip = EJCC(S, 0x84); }
        else { p_skip = EJCC(S, 0x85); }
        # Consume the operator token
        STI(S, GTI(S) + 1);
        # Evaluate the right operand (expression + optional comparison)
        PEXPR(S);
        var rop = PEEKT(S);
        if (rop >= 17) {
            if (rop <= 22) {
                STI(S, GTI(S) + 1);
                EPUSHR(S);
                PEXPR(S);
                EMOVCA(S);
                EPOPR(S);
                ESETCC(S, rop);
            }
        }
        # Normalize right side to boolean (cmp 0; setne al; movzx)
        EPUSHR(S);
        EMOVI(S, 0);
        EMOVCA(S);
        EPOPR(S);
        ECMPR(S);
        ESETCC(S, 18);  # 18 is !=, emits setne + movzx
        # jmp over the short-circuit tail
        var p_end = EJMP0(S);
        # skip_right lands here: write the short-circuit result
        EPATCH(S, p_skip);
        if (is_and == 1) {
            # && short-circuited because left was 0 → result is 0
            EMOVI(S, 0);
        } else {
            # || short-circuited because left was non-zero → result is 1
            EMOVI(S, 1);
        }
        EPATCH(S, p_end);
        lop = PEEKT(S);
    }
    return 0;
}
