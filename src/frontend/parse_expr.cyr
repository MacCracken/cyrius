            # struct global (`var s: Str = 0;`) holds an ADDRESS, so `s + 8` is pointer
            # arithmetic; setting the expression's struct type here sent it to a `Str_add`
            # that does not exist and failed the COMPILE. `_var_ptrmode` is the recorded
            # layout (1 = the slot holds an address). CHANGELOG [6.6.5]
            if (GVPM(S, idx) != 1) {
