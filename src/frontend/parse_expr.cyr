    if (typ == 10) {
        STI(S, GTI(S) + 1);
        PCMPE(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        STI(S, GTI(S) + 1);
        _cfo = 0;
        return 0;
    }
    if (typ == 27) {
        # &var or &fn — address of variable or function
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
        var anoff = PEEKV(S);
        STI(S, GTI(S) + 1);
        # Resolution order is local → global → function: a VALUE of a
        # given name shadows a function of the same name (correct lexical
        # scoping). Pre-v6.0.35 this checked FINDFN *first*, so a local
        # array named `argv` (shadowing stdlib `fn argv`) had `&argv`
        # resolve to the function's __TEXT code address; the subsequent
        # store wrote into __TEXT — silently masked on Linux (the load
        # segment is RWX) but a hard SIGBUS on macOS (W^X). See
        # CHANGELOG [6.0.35].
        # Local (innermost scope) wins.
        if (GINFN(S) == 1) {
            var ali = FINDLOCAL(S, anoff);
            if (ali >= 0) {
                var adisp = 0 - ((ali + 1) * 8);
                # v4.9.1: shift past all reserved callee-saved slots
                if (_cur_fn_regalloc > 0) { adisp = adisp - _cur_fn_regalloc * 8; }
                if (_cur_fn_ret_stash > 0) { adisp = adisp - _cur_fn_ret_stash; }
                # v5.11.36 path-A: dispatch lives in
                # <backend>/emit.cyr::ELOAD_LOCAL_ADDR.
                ELOAD_LOCAL_ADDR(S, adisp);
                return 0;
            }
        }
