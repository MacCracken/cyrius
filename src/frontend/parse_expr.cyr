    }
    if (typ == 10) {
        STI(S, GTI(S) + 1);
        PCMPE(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
        var _pfk = _FBR_KIND(S);
        STI(S, GTI(S) + 1);
        if (_pfk != 0) { _fbr_ti = GTI(S); }   # 6.6.10: `(builtin(..))` is still its result
