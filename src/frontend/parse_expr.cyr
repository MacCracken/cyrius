        # (sakshi `2026-04-30-cyrius-lang-blockers.md`, phylax
        # `2026-04-30-cyrius-stdlib-issues.md` §3). Same fix shape as
        # v5.7.8 SYS_SETSID 1→0 in spirit: pin the check to the arch
        # the table actually describes. Hand-written aarch64 syscalls
        # with wrong arity now get the runtime error rather than a
        # compile warning — acceptable tradeoff; the warning was
        # best-effort, not load-bearing.
        if (sc_num >= 0) { if (_AARCH64_BACKEND == 0) {
                var expect = _SC_ARITY(sc_num);
                if (expect >= 0) {
                    var got = argc - 1;
                    if (got != expect) {
                        # The cross-arch number-reuse shapes that are not a mismatch: see
                        # _sc_arity_skip (out of this fn: the cybs per-fn cap). CHANGELOG [6.6.12]
                        if (_sc_arity_skip(sc_num, got) == 0) {
                            WARN(S, "syscall arity mismatch", 22);
                        }
                    }
                }
            } }
        return 0;
    }
    if (typ == 25) {
        # load8(addr)
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        ELOAD8(S);
        return 0;
    }
    if (typ == 42) {
        # load16(addr)
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        ELOAD16(S);
        return 0;
    }
    if (typ == 43) {
        # load32(addr)
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        ELOAD32(S);
        return 0;
    }
    if (typ == 44) {
        # load64(addr)
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        ELOAD64(S);
        return 0;
    }
    if (typ == 26) {
        # store8(addr, val)
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S); EPUSHR(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        _refuse_lossy_pair(S);
        PCMPE(S); EPOPC(S); ESTORE8(S); EXORAA(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    if (typ == 45) {
        # store16(addr, val)
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S); EPUSHR(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        _refuse_lossy_pair(S);
        PCMPE(S); EPOPC(S); ESTORE16(S); EXORAA(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    if (typ == 46) {
        # store32(addr, val)
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S); EPUSHR(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        _refuse_lossy_pair(S);
        PCMPE(S); EPOPC(S); ESTORE32(S); EXORAA(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    if (typ == 47) {
        # store64(addr, val)
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S); EPUSHR(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        _refuse_lossy_pair(S);
        PCMPE(S); EPOPC(S); ESTORE64(S); EXORAA(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    if (typ == 8) {
        # *expr — dereference (load64 through address)
        STI(S, GTI(S) + 1);
        PARSE_FACTOR(S);
        ELOAD64(S);
        SPSC(S, 0);
        return 0;
    }
    if (typ == 37) {
        # ~ bitwise NOT
        STI(S, GTI(S) + 1);
        PARSE_FACTOR(S);
        ENOTR(S);
        return 0;
    }
    if (typ == 135) {
        # v6.3.11 (G): await e — force a Future to its value. Lowers to
        # future_force(e): eval the operand factor (→ rax = the Future object built
        # by an async-fn constructor), then call the runtime forcer. Binds tightly
        # (factor-level prefix), so `await f() + 1` is `(await f()) + 1`. Gated on
        # _ASYNC_OK; needs lib/async.cyr (future_force).
        _ensure_async_gate(S);
        # A refused `await` still parses its operand (so the next token is where the caller
        # expects it) and emits no call: ERR_MSG does not exit, and falling through reached
        # either a second, misleading "needs lib/async.cyr" or ECALLFIX(-1) — rc 139 on
        # aarch64/cx after the correct diagnostic. Same for a missing future_force. CHANGELOG [6.6.9]
        if (_ASYNC_OK == 0) {
            ERR_MSG(S, "await requires CYRIUS_ASYNC=1 (async/await are gated)", 53);
            STI(S, GTI(S) + 1);
            PARSE_FACTOR(S);
            return 0;
        }
        STI(S, GTI(S) + 1);                       # consume `await`
        # v6.5.69 — INSIDE A COROUTINE, `await e` IS A SUSPEND POINT, not a force.
        # ⛔ It used to be a force here too, and that is the defect this release closes: a
        # body that awaited mid-loop compiled clean, ran its awaited call to completion, and
        # on the next reactor turn re-entered FROM THE TOP with every local reset. Measured on
        # the shipped compiler, a two-direction TTY relay written that way relays ZERO bytes
        # and hangs — a shipped syntax with nothing behind it, the v6.5.63 `#inline` class.
        # Now: evaluate the operand (the park call), stamp the resume state into the coroutine
        # object, and return through the shared epilogue. The landing pad recorded here is
        # where the fn-end dispatch will send the next entry. CHANGELOG [6.5.69]
        if (_cur_fn_coro == 1) {
            var _aw_ti = GTI(S);
            PARSE_FACTOR(S);                      # evaluate the operand
            var _sk = _coro_nsusp + 1;
            if (_sk >= _CORO_MAX_SUSP) {
                # ERR_MSG returns (multi-error, v6.4.62), so the cap must stop here itself: the
                # stores below indexed _coro_rcp past its bound. CHANGELOG [6.6.10]
                ERR_MSG(S, "too many `await` suspend points in one `async fn` (max 63)", 58);
                return 0;
            }
            _await_coro_suspend(S, _sk, _await_operand_is_future(S, _aw_ti));
            return 0;
        }
        var _aw_ff = _FINDFN_CSTR(S, "future_force", 12);
        if (_aw_ff < 0) {
            ERR_MSG(S, "await needs include \"lib/async.cyr\" for future_force", 52);
            PARSE_FACTOR(S);
            return 0;
        }
        PARSE_FACTOR(S);                          # rax = the Future object
        EPUSHR(S);                                # push the future as the sole arg
        ECALLPOPS(S, 1);                          # marshal into arg-reg 0
        ECALLFIX(S, _aw_ff);                      # rax = future_force(future)
        ECALLCLEAN(S, 1);                         # 6.6.5: was missing (see ECALLCLEAN)
        return 0;
    }
    # |params| body / || body — closure/lambda. v6.3.7 makes the non-capturing
    # base actually work (param passing, zero-param, unique naming); lexical
    # capture is the follow-up slot.
    if (typ == 35 || typ == 54) {
        # token 54 is `||`. At a factor position (no left operand) it is a
        # zero-param closure `|| body`; binary `a || b` is consumed at the
        # expression level and never reaches here as a leading token.
        var cl_zero = 0;
        if (typ == 54) { cl_zero = 1; }
        # Mark the ENCLOSING fn as containing a closure so its regalloc post-pass
        # is skipped (it would byte-scan + corrupt the inline closure code). This
        # global is NOT in the save/reset set below, so it persists past the
        # closure to the enclosing fn's PARSE_FN_DEF end.
        _cur_fn_has_closure = 1;
        STI(S, GTI(S) + 1);  # consume `|` (or the whole `||` for a zero-param closure)
        # Generate a UNIQUE anonymous name __clNNNNN (5 zero-padded decimal digits
        # of the fn count). The old `__cl<clid%10>` was single-digit, so the 11th
        # closure reused __cl0 and REGFN silently MERGED it with the first.
        NPOS_GUARD(S, 16);
        var clid = GFNC(S);
        var clnoff = GNPOS(S);
        var cwp = clnoff;
        store8(S + 0xEC00000 + cwp, 95); cwp = cwp + 1;    # _
        store8(S + 0xEC00000 + cwp, 95); cwp = cwp + 1;    # _
        store8(S + 0xEC00000 + cwp, 99); cwp = cwp + 1;    # c
        store8(S + 0xEC00000 + cwp, 108); cwp = cwp + 1;   # l
        store8(S + 0xEC00000 + cwp, 48 + (clid / 10000) % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 48 + (clid / 1000) % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 48 + (clid / 100) % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 48 + (clid / 10) % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 48 + clid % 10); cwp = cwp + 1;
        store8(S + 0xEC00000 + cwp, 0); cwp = cwp + 1;
        SNPOS(S, cwp);
        # Register the closure function
        var clfi = REGFN(S, clnoff);
        # Snapshot the enclosing local tables before the closure overwrites slot 0+.
        var cl_saved_flc = GFLC(S);
        var cl_locsnap = _cl_save_locals(S, cl_saved_flc);
        var cl_saved_fs_floor = _fs_floor;   # 6.6.5: the closure body's fn-static mark
        _fs_floor = _fs_n;
        # ⭐ 6.6.7 — the closure is its OWN fn: snapshot EVERY per-fn global and enter a fresh
        # fn (parse.cyr `_fnst_save`). This used to be a hand-kept list that had drifted — it
        # saved rp_vec by LENGTH then truncated it to 0 (an early `return` before the closure
        # lost its patch and fell through), and it never isolated the defer table (a closure's
        # `defer` zeroed an ENCLOSING slot and ran, if at all, from the enclosing epilogue). The
        # v6.3.7 regalloc leak (`|a,b| a+b` reading an unloaded rbx) was the same family.
        var cl_st = _fnst_save(S);
        _cur_fn_ix = clfi;
        # v6.3.8 — save capture state and run the free-var pre-scan BEFORE the
        # prologue/params, so the env-param decision is made in one pass. The
        # cursor is at the first param (the opening `|` was consumed above); the
        # pre-scan seeds the shadow set with params, collects captured enclosing
        # slots, and restores the cursor.
        # 6.6.17: the whole enclosing capture context, and a snapshot that also lists the
        # enclosing closure's captures (`_cl_ctx_enter`).
        var cl_ctx = _cl_ctx_enter(S, cl_locsnap, cl_saved_flc);
        _cl_prescan_captures(S, cl_zero);
        var cl_cap_shift = 0;
        if (_cl_capturing == 1) { cl_cap_shift = 1; }
        # Emit function prologue
        var cl_jmp = EJMP0(S);
        S64(_fnt_offsets + clfi * 8, GCP(S));
        EFNPRO(S);
        # v6.3.8 — a capturing closure takes the heap env object as a HIDDEN param;
        # captured-var reads in the body load from its slot (see PARSE_FACTOR).
        # v6.5.17 — that param moved from FIRST to LAST. The frame slot is still
        # allocated here (the body needs `_cl_env_lidx` while parsing), but the
        # arg-register store is emitted after the user params, once `clpc` is known.
        # Why last: the call site cannot know at compile time whether a callee is a
        # closure, so it always passes the env — and only a TRAILING extra argument
        # is invisible to a callee that does not want it. Leading it would shift
        # every user argument of every non-closure indirect call.
        _cl_env_lidx = 0 - 1;
        var cl_env_slot = 0 - 1;
        if (_cl_capturing == 1) {
            cl_env_slot = GFLC(S);
            S64(S + 0x5D9D000 + cl_env_slot * 8, 0 - 1);
            SLDEP(S, cl_env_slot, 0);
            SFLC(S, cl_env_slot + 1);
            _cl_env_lidx = cl_env_slot;
        }
        # Parse params until | (a zero-param `||` closure has no param list)
        # ⚠ The pair scans (parse.cyr `_tok_is_closure_body`) recognise a closure BODY as a `{`
        # immediately preceded by the closing `|` or by `||`. Typed params or a return annotation
        # between the bars and the body would break that predicate — move it with the grammar.
        # v6.5.46: remember the first param's local index — the deferred stack-param pass
        # below needs it, and inside the loop `cpli` is re-read each iteration.
        var cl_p0 = GFLC(S);
        var clpc = 0;
        if (cl_zero == 0 && PEEKT(S) != 35) {
            var cpgo = 1;
            while (cpgo == 1) {
                if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
                var cpnoff = PEEKV(S);
                STI(S, GTI(S) + 1);
                var cpli = GFLC(S);
                S64(S + 0x5D9D000 + cpli * 8, cpnoff);
                SLDEP(S, cpli, 0);
                if (clpc < 6) { ESTOREPARM(S, clpc, cpli, 0); }
                SFLC(S, cpli + 1);
                clpc = clpc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { cpgo = 0; }
            }
        }
        # v6.5.17 — the hidden env param lands in arg register `clpc`, i.e. one past
        # the user params, matching the call site's trailing push. Emitting it here
        # (rather than at slot-allocation time) is safe: every ESTOREPARM is an
        # independent arg-register → frame-slot store, so their order is free.
        # The env must land in an argument REGISTER — see the matching note in
        # PINDIRECT_CALL: under SysV an extra STACK argument would slide the stack
        # arguments of every ordinary callee, so the call site only appends the env
        # below the register ceiling. A capturing closure with more parameters than
        # that is rejected HERE, loudly, instead of receiving a garbage environment.
        # This is not a new restriction: with the env as the hidden FIRST argument
        # (v6.3.8 - v6.5.16) the user params occupied registers 1..5 and the
        # `clpc + cl_cap_shift < 6` guard dropped anything beyond, silently.
        if (_cl_capturing == 1) {
            if (clpc >= _ARG_REG_COUNT()) {
                ERR_MSG(S, "capturing closure has too many parameters — its captured environment needs one more argument register than this target has", 124);
            }
            ESTOREPARM(S, clpc, cl_env_slot, clpc + 1);
        }
        # ⛔ v6.5.46 — DEFERRED STACK-PARAM PASS. Without it a NON-capturing closure silently
        # dropped every parameter past the 6th: the in-loop `clpc < 6` guard is correct (the
        # overflow cannot be homed until the TOTAL count is known, because SysV's stack slot is
        # `16 + (pc - 6 - 1 - (pidx - 6)) * 8` — it counts DOWN from the total), but nothing ever
        # ran the second pass that `PARSE_FN` has had all along (src/frontend/parse_fn.cyr, since
        # 6.6.6 `_stkp_flush`). So the 7th+ parameter was never stored and the body read an
        # uninitialised frame slot. (A closure's params are all untyped int-class, one slot each,
        # with no retptr, so `cl_p0 + cspi` / `clpc` below ARE the slot and the total — the
        # re-derivation 6.6.6 removed from PARSE_FN_DEF's pass cannot drift here.)
        # ⚠ IT DID NOT FAIL RELIABLY, which is why it survived: measured at v6.5.46, a 7-param
        # closure returned the RIGHT answer — the argument register still happened to hold the
        # value — while an 8-param one returned garbage. An intermittent wrong answer reads as
        # "closures are fine" until someone adds one more parameter.
        # ⚠ NON-CAPTURING ONLY, and that is not an omission: a CAPTURING closure needs its env in
        # an argument register (see the note above), so it already refuses `clpc >= _ARG_REG_COUNT()`
        # LOUDLY. This pass is what the non-capturing case never had.
        # ⚠ The first attempt at this fix simply deleted the in-loop guard. That is WRONG — it
        # calls ESTOREPARM with pc = 0, so `nstack = -6` and the displacement is garbage. The
        # count has to be known first, which is the whole reason the pass is deferred.
        if (_cl_capturing == 0) {
            if (clpc > 6) {
                var cspi = 6;
                while (cspi < clpc) {
                    ESTOREPARM(S, cspi, cl_p0 + cspi, clpc);
                    cspi = cspi + 1;
                }
            }
        }
        S64(_fnt_params + clfi * 8, clpc + cl_cap_shift);
        # A `||` zero-param closure already consumed both bars as one token 54;
        # only the `|params|` form has a separate closing bar to consume.
        if (cl_zero == 0) {
            if (PEEKT(S) != 35) { ERR_EXPECT(S, 35); }
            STI(S, GTI(S) + 1);  # consume closing |
        }
        # v6.2.41 dropped ESUBRSP's 2nd arg and claimed the frame "is patched
        # later via EPATCHFRAME" — but the closure path NEVER called EPATCHFRAME
        # (closures were untested), so `sub rsp, imm32` kept its 0 placeholder. The
        # closure then ran on a 0-byte frame: the first push in the body wrote at
        # [rsp-8] == [rbp-8], clobbering param slot 0, so `|x| x` returned garbage.
        # v6.3.7 — capture the patch handle and patch the real frame size below
        # (mirrors PARSE_FN_DEF's prologue ESUBRSP → EPATCHFRAME).
        var cl_frame_patch = ESUBRSP(S);
        # 6.6.7 — defer-flag init jmp, resolved at the closure's end exactly as PARSE_FN_DEF does.
        var cl_dij = EJMP0(S);
        var cl_bcp = GCP(S);
        # Parse body: { stmts } or single expression
        if (PEEKT(S) == 13) {
            STI(S, GTI(S) + 1);
            _cur_fn_has_defer = _body_has_defer(S);   # 6.6.7: as PARSE_FN_DEF (0 from the snapshot otherwise)
            PARSE_PROG(S);
            if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
            STI(S, GTI(S) + 1);
        } else {
            PCMPE(S);
        }
        # Defer init, return landing, defer walk, epilogue — the same shared epilogue as
        # PARSE_FN_DEF, over the closure's own ranges. CHANGELOG [6.6.7]
        _defer_emit_init(S, cl_dij, cl_bcp);
        _rp_patch_here(S);
        _defer_emit_walk(S);
        EFNEPI(S);
        # v6.3.7 — patch the closure frame size now that GFLC is final (param +
        # body local count). Closures take no `#regalloc`/struct-ret stash, so the
        # size is just the slot count rounded to 16 — same formula as PARSE_FN_DEF.
        var cl_fsz = (GFLC(S) * 8 + 15) & (0 - 16);
        EPATCHFRAME(S, cl_frame_patch, cl_fsz);
        EPATCH(S, cl_jmp);
        # Restore state
        _fs_popto(S, _fs_floor);             # 6.6.5: close the closure body's fn-statics
        _fs_floor = cl_saved_fs_floor;
        _fnst_restore(S, cl_st);             # 6.6.7: every enclosing per-fn global
        # Restore the enclosing fn's local tables clobbered by the closure's slots.
        _cl_restore_locals(S, cl_locsnap, cl_saved_flc);
        # v6.3.8 — restore capture state so the enclosing context resolves
        # identifiers normally again (and nested closures see their own state).
        # 6.6.17: this closure's capture list is kept aside for its env, below.
        var cl_inner = _cl_ctx_save();
        _cl_ctx_restore(cl_ctx);
        if (cl_cap_shift == 1) {
            # v6.3.8 — CAPTURING closure: build the heap env object (the closure
            # value) — a (1+ncap)-word block with the fn pointer at [0] and the
            # captured-by-value locals at [1..]. The object pointer is left in rax.
            # Requires lib/alloc.cyr. (Dispatched via callptr: load64(obj) → fn,
            # obj passed as the hidden first arg — see the callptr handler.)
            var cl_alloc_fi = _FINDFN_CSTR(S, "alloc", 5);
            if (cl_alloc_fi < 0) {
                ERR_MSG(S, "a capturing closure needs include \"lib/alloc.cyr\" for its heap env", 66);
                # v6.6.4: ERR_MSG reports and CONTINUES (the v6.4.62 multi-error contract),
                # so falling through handed -1 to ECALLFIX — a SIGSEGV on cx after a correct
                # diagnostic. The compile is already failed; there is nothing to emit.
                return 0;
            }
            EMOVI(S, _cl_env_bytes(cl_inner));   # rax = size (6.6.5: words, not captures)
            EPUSHR(S);
            ECALLPOPS(S, 1);                 # → rdi
            ECALLFIX(S, cl_alloc_fi);        # rax = obj
            ECALLCLEAN(S, 1);                # 6.6.5: was missing (see ECALLCLEAN)
            var cl_obj_slot = GFLC(S);
            # Anonymous scratch — the name table isn't cleared per-fn, so an unnamed
            # slot would keep a STALE name from a prior fn and a later `var` with that
            # name would falsely trip the duplicate-var check.
            S64(S + 0x5D9D000 + cl_obj_slot * 8, 0 - 1);
            SLDEP(S, cl_obj_slot, 0);
            EFLSTORE(S, cl_obj_slot);        # spill the object pointer
            SFLC(S, cl_obj_slot + 1);
            # obj[0] = closure fn address
            EFLLOAD(S, cl_obj_slot);
            EPUSHR(S);                       # push dest = obj + 0
            var clfc = GFCNT(S);
            if (clfc >= 1048576) {
                syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
                syscall(SYS_EXIT, 1);
            }
            ELOAD_FN_ADDR(S, _fixup_base + clfc * 16, clfc, clfi);   # rax = fn addr
            EPOPC(S);                        # rcx = dest
            ESTORE64(S);                     # [obj+0] = fn addr
            # obj[1+i] = captured enclosing local (cap_slots[i]); state is restored,
            # so EFLLOAD reads the enclosing fn's local — capture BY VALUE.
            # 6.6.5: an AGGREGATE capture copies all its words. Word k of an enclosing
            # inline aggregate lives at slot (base - k) and lands at env[woff + k], so
            # `env + woff*8 + k*8` addresses field k exactly as `&base + k*8` does in the
            # enclosing frame — which is what lets the body reuse the ordinary field math.
            # 6.6.17: a capture of the enclosing closure's own capture copies from its env.
            _cl_emit_env_caps(S, cl_obj_slot, cl_inner);
            EFLLOAD(S, cl_obj_slot);          # closure value = the object pointer
            # v6.5.17 — TAG IT. Bit 63 makes the value self-identifying, so any
            # indirect call site can dispatch it (load [obj+0], pass obj as the
            # trailing env arg) without knowing where the value came from. Without
            # this bit the whole scheme is the old static SLTYPE peek, which the
            # value outlives the moment it is passed, returned or stored.
            ECLTAG(S);
        } else {
            # Non-capturing closure: a bare fn pointer (same fixup-type-3 op as
            # `&fn_name`). v6.3.7-stable path.
            var clfc = GFCNT(S);
            if (clfc >= 1048576) {
                syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
                syscall(SYS_EXIT, 1);
            }
            var clfaddr = _fixup_base + clfc * 16;
            ELOAD_FN_ADDR(S, clfaddr, clfc, clfi);
        }
        # v6.5.17 — nothing to hand back to the enclosing var-decl any more: the
        # closure value carries its own tag (ECLTAG above), so no SLTYPE is needed.
        return 0;
    }
    ERR(S);
    return 0;
}
# f64 binary ops
fn PF64BIN(S, tok): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
    PCMPE(S); EPUSHR(S);
    if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
    PCMPE(S);
    EMIT_F64_BINOP(S, tok - 62);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
    return 0;
}
# f64 compare ops
fn PF64CMP(S, tok): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
    PCMPE(S); EPUSHR(S);
    if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
    PCMPE(S);
    EPOPC(S); EPUSHR(S);
    # At this point x1 = a, stack = [b], x0 (/ rax on x86) = b.
    # v5.6.12: f64 compare — per-arch raw FCMP/UCOMISD + SETcc chain.
    _IR_REC0(S, IR_RAW_EMIT);
    # v5.11.38 path-A: f64 cmp dispatch lives in <backend>/emit.cyr.
    EF64_CMP(S, tok);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
    # v6.4.56 D3 — the result is an i64 BOOLEAN, not a float. Without this the
    # builtin leaked its last operand's F64_TYID, mis-routing an outer
    # `f64_lt(..) == 1` through the f64-compare path.
    SESTYPE(S, 0);
    return 0;
}

# Constant folding state (codegen-level, same EMOVI size only)
# Handle extended SIMD builtins (tokens 93-96) in separate function
# v5.10.35 — stash arg value at slot AND mark locname[idx] = -1
# (anonymous), so subsequent FINDLOCAL("r") inside the enclosing
# fn doesn't pick up this stash slot as a named local.
#
# Pre-v5.10.35 bug: cyrius's locname table at S+0x191000 is shared
# across all fn body parses (FLC resets to 0 at fn entry, but stale
# locname entries from PRIOR fns persist at higher indices). Plain
# EFLSTORE writes the value but not the name slot. So if a prior fn
# had a local named "r" at idx N, AND the current fn's f64v_abs
# (or any other PARSE_SIMD_EXT intrinsic) places its arg-stash at
# idx N, then FINDLOCAL("r") AFTER the intrinsic call returns N (the
# stash slot with stale "r" name) instead of the real `var r` slot
# at a lower idx. Consequence: `return r;` post-call reads from the
# stash (which contained the stored &r pointer-VALUE at the time of
# the call), so the caller gets a stack address back instead of the
# absed/sqrt'd bytes.
#
# The bug surfaced through the v5.10.33 typed-wrapper layer (sandhi
# / hisab consumers using `fn f64v2_abs(p): f64v2 { var r; f64v_abs(&r,p,2);
# return r; }`). 4-arg intrinsics (add/sub/mul/div/scale/axpy/fmadd)
# happened to dodge it because their stash slot range usually didn't
# overlap stale "r" entries in real consumer code; 3-arg
# (abs/sqrt/dot) hit the +1 offset that did.
#
# Fix is independent of arity: every stash store anonymises the slot.
# v6.6.2 — RESERVE the stash slots BEFORE any argument is parsed.
#
# ⛔ THE BUG THIS FIXES, AND WHY IT LOOKED LIKE A DERIVE REGRESSION. Every f64v_*/f32v_*/iv_*
# handler took `var vbase = GFLC(S);` and did not raise GFLC until AFTER all arguments had been
# parsed. So while argument N was being parsed, GFLC still pointed AT the destination stash slot.
# Any argument expression that allocates a frame local therefore binds it to the intrinsic's own
# operand slot: the inline replay's `var saved_flc = GFLC(S);` (parse_fn.cyr:1717) returned
# `vbase` itself, laid its parameter locals over the stash, and raised GFLC past them — and then
# the handler's trailing `SFLC(S, vbase + N)` LOWERED GFLC BACK DOWN over live slots. The loop
# then read its destination pointer from a slot no instruction ever wrote:
#   `mov -0x50(%rbp),%rdx` / `movupd %xmm0,(%rdx,%rsi,8)` through garbage.
#
# ⭐ IT IS NOT A 6.5.71 REGRESSION, THOUGH IT WAS FILED AS ONE. 6.5.71 only routed
# `#derive(accessors)` getters through the inline-replay path; before that the getter was a real
# CALL, and the call incidentally forced the surrounding values to be spilled. Removing the call
# removed a spill the expansion had been silently depending on. The same shape is reachable via
# `callptr` since 6.0.70 and via `#inline` since 6.5.63 — so the filing's "6.5.71+" range and its
# "derive" framing both understate it.
#
# ⭐ THE CORRECT PATTERN WAS ALREADY IN THIS FILE, one screen below: `bitset`/`bitclr` reserve
# and anonymise up front (v5.10.35) for exactly this reason. 21 handlers had the other order.
# Factored into one helper so 21 copies cannot drift apart again.
#
# Raising GFLC is a MAX, never an assignment: an argument's own parse may legitimately have
# pushed the frame higher, and lowering it back is what corrupted live slots.
# Anonymising (name = -1) matches _SIMD_STASH: stale locname entries from a prior fn-body parse
# must not be picked up by a post-call FINDLOCal lookup.
fn _SIMD_RESERVE(S, base, n): i64 {
    # ⛔ v6.6.2 — REFUSE AT TOP LEVEL instead of emitting a program that SIGSEGVs.
    # These intrinsics stash their operands in FRAME slots, and top-level code has no frame:
    # `f64v_scale(r, m + 0, f64_from(2), 4);` outside any function compiled clean on every
    # release checked and segfaulted at run time, with or without the operand-slot fix above —
    # a silent crash, not a diagnostic. `bitset`/`bitclr` one screen below already refuse this
    # exact way (v5.10.35); the SIMD band never got the same guard.
    # This is the single choke point: all 21 handlers call _SIMD_RESERVE before emitting
    # anything, so one guard here covers the whole band rather than 21 copies that can drift.
    if (GINFN(S) == 0) { ERR_MSG(S, "SIMD intrinsics must be called inside a function", 48); }
    if (base + n > GFLC(S)) { SFLC(S, base + n); }
    var i = 0;
    while (i < n) {
        S64(S + 0x5D9D000 + (base + i) * 8, 0 - 1);
        i = i + 1;
    }
    return 0;
}

fn _SIMD_STASH(S, idx): i64 {
    EFLSTORE(S, idx);
    S64(S + 0x5D9D000 + idx * 8, 0 - 1);
    return 0;
}

# v6.5.64 — DIRECT FORM for a fixed-lane vector binary op on three `&local` operands.
#
# `f32v_add(&r, &a, &b, 4)` / `f64v_add(&r, &a, &b, 2)` — the shape EVERY value-form wrapper in
# lib/simd.cyr expands to — needs no pointers and no loop: the addresses are known frame
# displacements and the "loop" runs exactly one iteration. Measured at 6.5.63, one such link cost
# 28 real instructions and ~15 memory ops for ONE packed op.
#
# ⛔ REMOVING THOSE INSTRUCTIONS IS WORTH ZERO ON ITS OWN, AND THAT WAS MEASURED BEFORE THIS WAS
# BUILT. The critical path of a chained expression is 16-byte STORE-TO-LOAD FORWARDS and the
# pointer machinery is not on it: a hand-written replica removing exactly this scaffolding and
# nothing else ran 33.99 ms against 33.96 ms. What pays is that the direct form leaves the result
# store and the `return r` reload ADJACENT, which lets the v6.5.53 SLASE peephole collapse them —
# that pair previously sat ~0x31 bytes apart and SLASE's own comment recorded it deleting nothing.
# Measured end to end: latency-bound 33.36 -> 22.59 ms (1.48x), throughput-bound 20.90 -> 13.07 ms
# (1.60x).
#
# ⛔ THE DECISION IS PURE LOOKAHEAD — NOTHING IS CONSUMED OR EMITTED UNTIL IT SUCCEEDS. The fast
# path swallows 11 tokens unevaluated, allocates no stash slots and never leaves `n` in rax, so a
# per-backend stubbed emitter CANNOT undo it; the gate has to be on the PARSER. parse.cyr:518-529
# records that exact failure for the switch jump-table path ("a stranded `ja default` in cx output").
#
# ⚠ `_AARCH64_BACKEND == 0` IS NOT AN x86 TEST — cx sets it to 0 as well, which is why the
# byte-pattern passes already run on cx. Both tests are required. PE and Mach-O are x86-64 with
# the same rbp frame and share x86/float.cyr, so they take this path with no target-specific code.
fn _try_vec_direct(S, op, dbl, lanes): i64 {
    if (_AARCH64_BACKEND != 0) { return 0; }
    if (_TARGET_CX != 0) { return 0; }
    var d_t = GTI(S);
    if (TOKTYP(S, d_t) != 27) { return 0; }
    if (TOKTYP(S, d_t + 1) != 2) { return 0; }
    if (TOKTYP(S, d_t + 2) != 31) { return 0; }
    if (TOKTYP(S, d_t + 3) != 27) { return 0; }
    if (TOKTYP(S, d_t + 4) != 2) { return 0; }
    if (TOKTYP(S, d_t + 5) != 31) { return 0; }
    if (TOKTYP(S, d_t + 6) != 27) { return 0; }
    if (TOKTYP(S, d_t + 7) != 2) { return 0; }
    if (TOKTYP(S, d_t + 8) != 31) { return 0; }
    if (TOKTYP(S, d_t + 9) != 1) { return 0; }
    if (TOKTYP(S, d_t + 10) != 11) { return 0; }
    # The lane count must be exactly the 16 bytes one xmm holds. Anything else is a real batch
    # and must keep the loop.
    if (TOKVAL(S, d_t + 9) != lanes) { return 0; }
    var d_r = FINDLOCAL(S, TOKVAL(S, d_t + 1));
    var d_a = FINDLOCAL(S, TOKVAL(S, d_t + 4));
    var d_b = FINDLOCAL(S, TOKVAL(S, d_t + 7));
    if (d_r < 0) { return 0; }
    if (d_a < 0) { return 0; }
    if (d_b < 0) { return 0; }
    # v6.5.65 — READ THROUGH THE INLINE-PARAM COPY. When the replay bound this operand it copied
    # 16 bytes from a caller local into a fresh param slot; loading that slot here is a 16-byte
    # store-to-load FORWARD two instructions after the store, and forwards are the critical path
    # (measured `.64`: removing instructions without removing a forward bought 1.00x). Reading the
    # caller's local instead removes both remaining forwards per chain link. Provenance is dropped
    # by `_prov_kill` on ANY store to the slot, so a body that assigns to its param falls back to
    # the copy rather than reading a stale value.
    # ⚠ SOURCES ONLY. The destination is the callee's own scratch, never a bound param, and
    # redirecting a WRITE would scribble on the caller's variable.
    d_a = _prov_src(d_a);
    d_b = _prov_src(d_b);
    # ⚠ ALL THREE must be 128-bit vector locals. The loop form is bounded by `n` and merely
    # over-reads a too-small slot; the direct form writes 16 bytes UNCONDITIONALLY, so a 1-slot
    # i64 local would smash its neighbour.
    if (_is_simd128(S, GLTYPE(S, d_r)) == 0) { return 0; }
    if (_is_simd128(S, GLTYPE(S, d_a)) == 0) { return 0; }
    if (_is_simd128(S, GLTYPE(S, d_b)) == 0) { return 0; }
    EMIT_VEC_DIRECT(S, op, d_r, d_a, d_b, dbl);
    STI(S, d_t + 11);   # consume `&r , &a , &b , N )`
    return 1;
}

fn PARSE_SIMD_EXT(S, ptyp): i64 {
    # f64v_div(dst, a, b, n)
    if (ptyp == 93) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        if (_try_vec_direct(S, 3, 1, 2) == 1) { return 0; }
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 3);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 3);   # max, never a lowering assignment
        EMIT_F64V_LOOP(S, 3, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # f64v_sqrt(dst, src, n)
    if (ptyp == 94) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 2);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 2);   # max, never a lowering assignment
        EMIT_F64V_UNARY(S, 0, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # f64v_abs(dst, src, n)
    if (ptyp == 95) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 2);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 2);   # max, never a lowering assignment
        EMIT_F64V_UNARY(S, 1, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # f64v_fmadd(dst, a, b, c, n)
    if (ptyp == 96) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 4);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 3);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 4);   # max, never a lowering assignment
        EMIT_F64V_FMADD(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v5.10.17: f64v_dot(a, b, n) → f64 in rax/x0 (sum of a[i]*b[i])
    if (ptyp == 128) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 2);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 2);   # max, never a lowering assignment
        EMIT_F64V_DOT(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v6.4.5 (SIMD Phase 2): f32v_fmadd(dst, a, b, c, n) — dst[i]=a[i]*b[i]+c[i]
    # (packed single). Mirror of the f64v_fmadd(96) handler → EMIT_F32V_FMADD.
    if (ptyp == 141) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 4);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 3);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 4);   # max, never a lowering assignment
        EMIT_F32V_FMADD(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v6.4.5 (SIMD Phase 2): f32v_dot(a, b, n) → f32 bit pattern in rax (sum of
    # a[i]*b[i]). Mirror of the f64v_dot(128) handler → EMIT_F32V_DOT.
    if (ptyp == 142) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 2);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 2);   # max, never a lowering assignment
        EMIT_F32V_DOT(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v6.4.6 (Phase 3a): iv_add/iv_sub/iv_mul(dst, a, b, n, w) — packed integer
    # dst[i] = a[i] OP b[i]. The 5th arg `w` is the lane byte-width, a compile-time
    # NUMBER literal (1/2/4/8) that selects padd/psub/pmul{b,w,d,q}. op = ptyp-143.
    if (ptyp >= 143) { if (ptyp <= 145) {
            var ivop = ptyp - 143;
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
            var ivbase = GFLC(S);
            _SIMD_RESERVE(S, ivbase, 3);
            PCMPE(S); _SIMD_STASH(S, ivbase);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, ivbase + 1);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, ivbase + 2);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S);
            _SIMD_RESERVE(S, ivbase, 3);   # max, never a lowering assignment
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            if (PEEKT(S) != 1) { ERR_MSG(S, "iv width arg must be a literal 1/2/4/8", 38); }
            var ivw = PEEKV(S);
            if (ivw != 1) { if (ivw != 2) { if (ivw != 4) { if (ivw != 8) { ERR_MSG(S, "iv width must be 1/2/4/8", 24); } } } }
            STI(S, GTI(S) + 1);
            EMIT_IVEC_BINOP(S, ivop, ivw, ivbase);
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
            return 0;
        } }
    # v6.4.7 (Phase 3b): iv_dp8(a, b, n) → i32 widening int8 dot in rax (a=u8, b=i8).
    # 3-arg scalar-return, mirrors the f32v_dot(142) handler → EMIT_IVEC_DP8.
    if (ptyp == 146) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var dpbase = GFLC(S);
        _SIMD_RESERVE(S, dpbase, 2);
        PCMPE(S); _SIMD_STASH(S, dpbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, dpbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, dpbase, 2);   # max, never a lowering assignment
        EMIT_IVEC_DP8(S, dpbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v6.4.9 (Phase 4 R2): f32v8_fma(dst, a, b, c, n) — 256-bit AVX2 fused multiply-add
    # (vfmadd231ps ymm). 5-arg stmt, mirrors the f32v_fmadd(141) handler → EMIT_F32V8_FMADD.
    if (ptyp == 150) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var fmbase = GFLC(S);
        _SIMD_RESERVE(S, fmbase, 4);
        PCMPE(S); _SIMD_STASH(S, fmbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, fmbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, fmbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, fmbase + 3);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, fmbase, 4);   # max, never a lowering assignment
        EMIT_F32V8_FMADD(S, fmbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v6.4.9 (Phase 4 R2): f32v8_dot(a, b, n) → f32 bit pattern in rax (sum a[i]*b[i]
    # over 8 lanes). 3-arg scalar-return, mirrors f32v_dot(142) → EMIT_F32V8_DOT.
    if (ptyp == 151) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var d8base = GFLC(S);
        _SIMD_RESERVE(S, d8base, 2);
        PCMPE(S); _SIMD_STASH(S, d8base);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, d8base + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, d8base, 2);   # max, never a lowering assignment
        EMIT_F32V8_DOT(S, d8base);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v5.10.17: f64v_scale(dst, a, scalar, n) — dst[i] = a[i] * scalar
    if (ptyp == 129) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 3);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 3);   # max, never a lowering assignment
        EMIT_F64V_SCALE(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # v5.10.17: f64v_axpy(y, x, alpha, n) — y[i] += alpha * x[i]
    if (ptyp == 130) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbase = GFLC(S);
        _SIMD_RESERVE(S, vbase, 3);
        PCMPE(S); _SIMD_STASH(S, vbase);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbase + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbase, 3);   # max, never a lowering assignment
        EMIT_F64V_AXPY(S, vbase);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # ret2(a, b) — return two values in rax:rdx
    if (ptyp == 97) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S);
        EPUSHR(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        # rax = b, stack = a → mov rdx, rax; pop rax
        EMOVRDXRAX(S);
        EPOPR(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        # Don't consume ; here — PARSE_STMT handles it via expression statement path
        var rp = EJMP0(S);
        vec_push(rp_vec, rp);
        return 0;
    }
    # f64_atan(x) — v5.11.37 path-A: dispatch lives in <backend>/emit.cyr.
    if (ptyp == 99) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_ATAN(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 0; }
    # rethi() — read rdx from last function call (mov rax, rdx)
    if (ptyp == 98) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        EMOVRA_RDX(S);
        return 0;
    }
    # bitget(val, offset, width) → (val >> offset) & ((1 << width) - 1)
    if (ptyp == 102) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        PCMPE(S); ESPILL(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        # rax = offset, stack = val. Shift val >> offset
        EMOVCA(S); EUNSPILL(S); ESHRCL(S);
        # Now rax = val >> offset. Need to mask with (1 << width) - 1
        ESPILL(S);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        # rax = width. Compute mask: (1 << width) - 1
        EMOVCA(S); EMOVI(S, 1); ESHLCL(S);
        # rax = 1 << width. Subtract 1.
        ESPILL(S); EMOVI(S, 1); EMOVCA(S); EUNSPILL(S); ESUBR(S);
        # rax = mask. AND with shifted val.
        EMOVCA(S); EUNSPILL(S); EANDR(S);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 0;
    }
    # bitset(val, offset, width, new) → (val & ~(mask << offset)) | ((new & mask) << offset)
    if (ptyp == 103) {
        if (GINFN(S) == 0) { ERR_MSG(S, "bitset must be called inside a function", 39); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var bsb = GFLC(S);
        SFLC(S, bsb + 5);
        # v5.10.35 — anonymise stash slots up front (s4 = mask filled
        # below) so stale locname entries from prior fn-body parses
        # can't be picked up by post-call FINDLOCal lookups. Same fix
        # shape as _SIMD_STASH used by f64v_* intrinsics.
        S64(S + 0x5D9D000 + bsb * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bsb + 1) * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bsb + 2) * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bsb + 3) * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bsb + 4) * 8, 0 - 1);
        PCMPE(S); EFLSTORE(S, bsb);              # s0 = val
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bsb + 1);          # s1 = offset
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bsb + 2);          # s2 = width
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bsb + 3);          # s3 = new_val
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        # mask = (1 << width) - 1
        EFLLOAD(S, bsb + 2); EMOVCA(S); EMOVI(S, 1); ESHLCL(S);
        ESPILL(S); EMOVI(S, 1); EMOVCA(S); EUNSPILL(S); ESUBR(S);
        EFLSTORE(S, bsb + 4);                    # s4 = mask
        # cleared = val & ~(mask << offset)
        EFLLOAD(S, bsb + 4); ESPILL(S);
        EFLLOAD(S, bsb + 1); EMOVCA(S); EUNSPILL(S); ESHLCL(S);
        ENOTR(S); ESPILL(S);
        EFLLOAD(S, bsb); EMOVCA(S); EUNSPILL(S); EANDR(S);
        EFLSTORE(S, bsb);                        # s0 = cleared
        # insert = (new_val & mask) << offset
        EFLLOAD(S, bsb + 3); ESPILL(S);
        EFLLOAD(S, bsb + 4); EMOVCA(S); EUNSPILL(S); EANDR(S);
        ESPILL(S);
        EFLLOAD(S, bsb + 1); EMOVCA(S); EUNSPILL(S); ESHLCL(S);
        # result = cleared | insert
        ESPILL(S); EFLLOAD(S, bsb); EMOVCA(S); EUNSPILL(S); EORR(S);
        return 0;
    }
    # bitclr(val, offset, width) → val & ~(((1 << width) - 1) << offset)
    if (ptyp == 104) {
        if (GINFN(S) == 0) { ERR_MSG(S, "bitclr must be called inside a function", 39); }
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var bcb = GFLC(S);
        SFLC(S, bcb + 3);
        # v5.10.35 — anonymise stash slots (see bitset comment above).
        S64(S + 0x5D9D000 + bcb * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bcb + 1) * 8, 0 - 1);
        S64(S + 0x5D9D000 + (bcb + 2) * 8, 0 - 1);
        PCMPE(S); EFLSTORE(S, bcb);              # s0 = val
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bcb + 1);          # s1 = offset
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); EFLSTORE(S, bcb + 2);          # s2 = width
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        # mask = (1 << width) - 1
        EFLLOAD(S, bcb + 2); EMOVCA(S); EMOVI(S, 1); ESHLCL(S);
        ESPILL(S); EMOVI(S, 1); EMOVCA(S); EUNSPILL(S); ESUBR(S);
        # mask << offset
        ESPILL(S); EFLLOAD(S, bcb + 1); EMOVCA(S); EUNSPILL(S); ESHLCL(S);
        # ~(mask << offset) & val
        ENOTR(S); ESPILL(S);
        EFLLOAD(S, bcb); EMOVCA(S); EUNSPILL(S); EANDR(S);
        return 0;
    }
    return 0;
}

var _cfv = 0;
var _cfp = 0;
var _cfo = 0;

# v5.6.7 O2 strength-reduction helper: if the next token is an
# integer literal whose value is a positive power of two (2, 4, 8,
# …, 2^63 — well, up to 2^62 since 2^63 is signed-negative), emit
# `shl` by the shift amount instead of a full `imul`. Both backends
# have ESHLIMM (x86 `shl rax, n`; aarch64 `lsl x0, x0, #n`). Assumes
# ESPILL has already pushed the LHS; on hit, EUNSPILL pops it back
# into rax / x0 before the shift.
# Returns 1 on peephole hit (mul replaced with shl), 0 on miss
# (caller falls through to the standard PARSE_FACTOR + EIMUL path).
fn _TRY_MUL_BY_POW2(S): i64 {
    if (PEEKT(S) != 1) { return 0; }
    var pv = PEEKV(S);
    if (pv < 2) { return 0; }
    if ((pv & (pv - 1)) != 0) { return 0; }
    var shift = 0;
    var v = pv;
    while (v > 1) { v = v >> 1; shift = shift + 1; }
    STI(S, GTI(S) + 1);      # consume the literal
    EUNSPILL(S);             # pop LHS back into rax / x0
    ESHLIMM(S, shift);
    return 1;
}

# v6.4.83 — the intrinsic dispatch, extracted out of PARSE_TERM's head so BOTH tiers
# can reach it. Returns 1 if it consumed an intrinsic call, 0 if `ptyp` is not one.
#
# THE BUG THIS FIXES: these arms used to sit inline at the top of PARSE_TERM, each
# ending in an early `return`. So an intrinsic could not FLANK a TERM-tier operator
# from either side:
#   `f64_from(2) * a`  -> as a LEFT operand the early return exited PARSE_TERM before
#                         its own `*` loop, so the `*` was unexpected
#   `a * f64_from(2)`  -> as a RIGHT operand that loop calls PARSE_FACTOR one tier
#                         DOWN, which never knew these tokens
# Both were hard syntax errors on `* / % << >> >>>`, while `+ - & | ^` worked (those
# live one tier up in PEXPR). It hit every f64_*/f32_*/f64v_*/f32v_*/iv_* name plus
# bitget/bitset/bitclr, store8/16/32/64, u128 and ret2/rethi — but NOT load8/16/32/64
# or ordinary calls, which is why it read as arbitrary. Pre-existing since the dispatch
# was built up (v5.10.17 / v6.4.5 / .6 / .9); found by the v6.4.82 closeout vidya sweep
# by RUNNING the compiler against a documented claim rather than re-reading the doc.
#
# ⚠ EVERY `return 1` below means HANDLED (the token was consumed). The single
# `return 0` at the bottom means NOT AN INTRINSIC. Getting that inverted makes the
# caller re-parse an already-consumed token — which is exactly how the first cut of
# this fix broke every intrinsic call in the tree.
#
# ⚠ `_cfo` DISCIPLINE. An intrinsic result is never a const-foldable literal, so both
# callers clear `_cfo` after a handled dispatch. Getting this wrong is the `_cfo`
# rewind class (four occurrences: 2026-06-11, v6.4.74, .80, .81), whose failure mode
# is SILENT WRONG CODE rather than a syntax error. Do not simplify those clears away.
# v6.5.38 — shared body for f64v256_abs / f64v256_sqrt (tokens 161/162). Both are
# (dst, src, n) and differ only in the op index handed to EMIT_F64V4_UNARY, so the arm is
# factored out rather than duplicated; `op` is passed in, never derived from the token.
fn _PARSE_F64V4_UNARY(S, op): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
    var vbu = GFLC(S);
    _SIMD_RESERVE(S, vbu, 2);
    PCMPE(S); _SIMD_STASH(S, vbu);
    if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
    PCMPE(S); _SIMD_STASH(S, vbu + 1);
    if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
    PCMPE(S);
    _SIMD_RESERVE(S, vbu, 2);   # max, never a lowering assignment
    EMIT_F64V4_UNARY(S, op, vbu);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
    return 1;
}

# 6.6.10 — every builtin dispatch goes through here, so the float-builtin RESULT flag is
# cleared for any other intrinsic and set for a float-returning one (_NEG_INTRIN_KIND), in
# ONE place for both tiers that dispatch intrinsics. See _FBR_MARK. CHANGELOG [6.6.10]
fn PARSE_INTRIN(S, ptyp): i64 {
    _fbr_k = 0;
    var r = _PARSE_INTRIN_IMPL(S, ptyp);
    if (r != 1) { return r; }
    var k = _NEG_INTRIN_KIND(ptyp);
    if (k != 0) { _FBR_MARK(S, k); }
    return r;
}

fn _PARSE_INTRIN_IMPL(S, ptyp): i64 {
    if (ptyp >= 93) { if (ptyp <= 99) { PARSE_SIMD_EXT(S, ptyp); return 1; } }
    if (ptyp >= 100) { if (ptyp <= 104) { PARSE_SIMD_EXT(S, ptyp); return 1; } }
    # v5.10.17 — f64v_dot/scale/axpy
    if (ptyp >= 128) { if (ptyp <= 130) { PARSE_SIMD_EXT(S, ptyp); return 1; } }
    # v6.4.5 (SIMD Phase 2): f32v_fmadd (141) + f32v_dot (142) → PARSE_SIMD_EXT.
    if (ptyp >= 141) { if (ptyp <= 142) { PARSE_SIMD_EXT(S, ptyp); return 1; } }
    # v6.4.6 (Phase 3a): iv_add/iv_sub/iv_mul (143-145) → PARSE_SIMD_EXT.
    if (ptyp >= 143) { if (ptyp <= 146) { PARSE_SIMD_EXT(S, ptyp); return 1; } }
    # v6.4.9 (Phase 4 R2): f32v8_fma (150) + f32v8_dot (151) → PARSE_SIMD_EXT.
    if (ptyp >= 150) { if (ptyp <= 151) { PARSE_SIMD_EXT(S, ptyp); return 1; } }
    # f64 builtins — check before PARSE_FACTOR dispatches.
    # v5.11.37 path-A: each ptyp dispatches to its named op in
    # <backend>/emit.cyr — x86 emits SSE2/x87, aarch64 emits FNEG /
    # polyfill-call / hard-error, cx is no-op. parse_expr.cyr is
    # arch-agnostic for these ops.
    if (ptyp >= 62) { if (ptyp <= 65) { PF64BIN(S, ptyp); return 1; } }
    if (ptyp == 66) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); _IR_REC0(S, IR_RAW_EMIT); EI2F(S); EMOVQ_A_X0(S); SESTYPE(S, F64_TYID); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp == 67) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); _IR_REC0(S, IR_RAW_EMIT); EMOVQ_X0_A(S); EF2I(S); SESTYPE(S, 0); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp >= 68) { if (ptyp <= 70) { PF64CMP(S, ptyp); return 1; } }
    # 6.6.13 — f64_le / f64_ge lower through the `<=` / `>=` operator compare (tok 21 / 22),
    # NaN-false on every backend; they were lib/math.cyr calls (lt, then eq). CHANGELOG [6.6.13]
    if (ptyp == 164) { PF64CMP(S, 21); return 1; }
    if (ptyp == 165) { PF64CMP(S, 22); return 1; }
    if (ptyp == 71) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_NEG(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    # f64_sqrt(x) — sqrtsd xmm0, xmm0
    # v6.6.2: f64_sqrt 79 -> 136 (was double-assigned with `object`).
    if (ptyp == 136) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); _IR_REC0(S, IR_RAW_EMIT); EMOVQ_X0_A(S); EF64SQRT(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    # f64_abs(x) — v5.11.40 path-A peephole. Dispatch lives in
    # <backend>/emit.cyr::EF64_ABS: x86 movabs+and (saves 5 B vs
    # the prior 5-instr push/movabs/movca/pop/and = 18 B); aarch64
    # native fabs via fmov/fabs/fmov (saves 20 B vs the prior
    # MOVK-chain + shuttle); cx no-op stub. See CHANGELOG [5.11.40].
    if (ptyp == 80) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_ABS(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    # f64_floor(x) — roundsd xmm0, xmm0, 1 (SSE4.1)
    if (ptyp == 81) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); _IR_REC0(S, IR_RAW_EMIT); EMOVQ_X0_A(S); EF64FLOOR(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    # f64_ceil(x) — roundsd xmm0, xmm0, 2 (SSE4.1)
    if (ptyp == 82) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); _IR_REC0(S, IR_RAW_EMIT); EMOVQ_X0_A(S); EF64CEIL(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    # f64_trunc(x) — roundsd xmm0, xmm0, 3 / frintz (toward zero). 6.6.13, was a lib/math.cyr fn.
    if (ptyp == 166) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); _IR_REC0(S, IR_RAW_EMIT); EMOVQ_X0_A(S); EF64TRUNC(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    # f64_round(x) — roundsd xmm0, xmm0, 0 (round to nearest)
    if (ptyp == 92) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); _IR_REC0(S, IR_RAW_EMIT); EMOVQ_X0_A(S); EF64ROUND(S); EMOVQ_A_X0(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    # f32_from(x): f64 → f32 bit pattern (cvtsd2ss). f32_to(x): f32 → f64 (cvtss2sd).
    # v6.2.18 native-float math arc. Backend emit takes the value in rax, returns
    # the converted bits in rax (full move/cvt/move sequence lives per-arch).
    if (ptyp == 131) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF32_FROM(S); SESTYPE(S, 0); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp == 132) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF32_TO(S); SESTYPE(S, F64_TYID); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp == 83) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_SIN(S);  if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp == 84) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_COS(S);  if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp == 85) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_EXP(S);  if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp == 86) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_LN(S);   if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp == 87) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_LOG2(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    if (ptyp == 88) { STI(S, GTI(S) + 1); if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1); PCMPE(S); EF64_EXP2(S); if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1); return 1; }
    # f64v_add/sub/mul(dst, a, b, n) — SSE2 packed f64 batch operations.
    # v5.10.39 — route through _SIMD_STASH (was bare EFLSTORE pre-fix).
    # The v5.10.35 locname-staleness fix covered f64v_div/sqrt/abs/
    # fmadd/dot/scale/axpy in PARSE_SIMD_EXT but missed this separate
    # f64v_add/sub/mul path at ptyp 89-91 — stash slots weren't
    # anonymised, and stale `r` entries from a prior fn parse caused
    # `return r;` after f64v_add inside a wrapper to load the stash
    # slot (containing &r pointer-VALUE) instead of the real var r.
    # Surfaced at v5.10.39 when adding value-form siblings to
    # lib/simd.cyr made the stale-collision reliable.
    if (ptyp >= 89) { if (ptyp <= 91) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
            if (_try_vec_direct(S, ptyp - 89, 1, 2) == 1) { return 1; }
            var vbase = GFLC(S);
            _SIMD_RESERVE(S, vbase, 3);
            PCMPE(S); _SIMD_STASH(S, vbase);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vbase + 1);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vbase + 2);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S);
            _SIMD_RESERVE(S, vbase, 3);   # max, never a lowering assignment
            EMIT_F64V_LOOP(S, ptyp - 89, vbase);
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
            return 1;
        } }
    # v6.4.3+ (SIMD Phase 1) — f32v_add/sub/mul(dst, a, b, n) — SSE2 packed f32
    # (addps/subps/mulps), the f64v path minus the 66 prefix. Same 4-arg stash shape.
    if (ptyp >= 138) { if (ptyp <= 140) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
            if (_try_vec_direct(S, ptyp - 138, 0, 4) == 1) { return 1; }
            var vbf = GFLC(S);
            _SIMD_RESERVE(S, vbf, 3);
            PCMPE(S); _SIMD_STASH(S, vbf);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vbf + 1);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vbf + 2);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S);
            _SIMD_RESERVE(S, vbf, 3);   # max, never a lowering assignment
            EMIT_F32V_LOOP(S, ptyp - 138, vbf);
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
            return 1;
        } }
    # v6.4.8 (SIMD Phase 4 R1) — f32v8_add/sub/mul(dst, a, b, n) — 256-bit AVX2 packed
    # f32 (vaddps/vsubps/vmulps ymm). Identical 4-arg stash to f32v_add; EMIT_F32V8_LOOP.
    if (ptyp >= 147) { if (ptyp <= 149) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
            var vbf8 = GFLC(S);
            _SIMD_RESERVE(S, vbf8, 3);
            PCMPE(S); _SIMD_STASH(S, vbf8);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vbf8 + 1);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vbf8 + 2);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S);
            _SIMD_RESERVE(S, vbf8, 3);   # max, never a lowering assignment
            EMIT_F32V8_LOOP(S, ptyp - 147, vbf8);
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
            return 1;
        } }
    # v6.5.24 (ymm widening) — f64v256_add/sub/mul/div(dst, a, b, n): 256-bit AVX2 packed
    # DOUBLE (vaddpd/vsubpd/vmulpd/vdivpd ymm). Identical 4-arg stash shape to the f32v8
    # arm above; tokens 154-157 are consecutive so `ptyp - 154` is the op index.
    # ⚠ n MUST be a multiple of 4 — EMIT_F64V4_LOOP strides rsi by 4, so a 2-element
    # vector here would walk off the end. Only the AVX2-gated f64v4 lib wrappers (n=4)
    # reach this; f64v2 keeps tokens 89-91 → EMIT_F64V_LOOP. See the emitter's own
    # warning in src/backend/x86/float.cyr.
    if (ptyp >= 154) { if (ptyp <= 157) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
            var vb256 = GFLC(S);
            _SIMD_RESERVE(S, vb256, 3);
            PCMPE(S); _SIMD_STASH(S, vb256);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vb256 + 1);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S); _SIMD_STASH(S, vb256 + 2);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
            PCMPE(S);
            _SIMD_RESERVE(S, vb256, 3);   # max, never a lowering assignment
            EMIT_F64V4_LOOP(S, ptyp - 154, vb256);
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
            return 1;
        } }

    # v6.5.38 — f64v256_fmadd(dst, a, b, c, n): 256-bit fused-shape multiply-add, token 158.
    # FIVE stash slots (dst, a, b, c) + n, mirroring f64v_fmadd (token 96) in PARSE_SIMD_EXT;
    # the 154-157 arm above takes four. Kept HERE rather than beside token 96 so the whole
    # f64v256_ family dispatches from one place.
    # ⚠ Same multiple-of-4 requirement as its siblings — EMIT_F64V4_FMADD strides rsi by 4.
    if (ptyp == 158) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbf = GFLC(S);
        _SIMD_RESERVE(S, vbf, 4);
        PCMPE(S); _SIMD_STASH(S, vbf);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbf + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbf + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbf + 3);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbf, 4);   # max, never a lowering assignment
        EMIT_F64V4_FMADD(S, vbf);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 1;
    }

    # v6.5.38 — f64v256_dot(a, b, n): THREE args and the only member of the family that
    # produces a value (f64 bits in rax), so no dst slot; mirrors f64v_dot (token 128).
    if (ptyp == 159) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbd = GFLC(S);
        _SIMD_RESERVE(S, vbd, 2);
        PCMPE(S); _SIMD_STASH(S, vbd);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbd + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbd, 2);   # max, never a lowering assignment
        EMIT_F64V4_DOT(S, vbd);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 1;
    }

    # v6.5.38 — f64v256_scale(dst, a, s, n): four args, but arg 3 is a SCALAR f64 bit
    # pattern, not a pointer — EMIT_F64V4_SCALE broadcasts it with vbroadcastsd.
    if (ptyp == 160) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); } STI(S, GTI(S) + 1);
        var vbs = GFLC(S);
        _SIMD_RESERVE(S, vbs, 3);
        PCMPE(S); _SIMD_STASH(S, vbs);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbs + 1);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S); _SIMD_STASH(S, vbs + 2);
        if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
        PCMPE(S);
        _SIMD_RESERVE(S, vbs, 3);   # max, never a lowering assignment
        EMIT_F64V4_SCALE(S, vbs);
        if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);
        return 1;
    }

    # v6.5.38 — f64v256_abs(dst, a, n) / f64v256_sqrt(dst, a, n): three args, one shared
    # arm. EMIT_F64V4_UNARY takes op 0 = sqrt, 1 = abs — matching EMIT_F64V_UNARY, so the
    # op index is NOT `ptyp - 161` (that would map abs->0 = sqrt). Spelled out explicitly.
    if (ptyp == 161) { return _PARSE_F64V4_UNARY(S, 1); }
    if (ptyp == 162) { return _PARSE_F64V4_UNARY(S, 0); }
    return 0;
}

# v6.5.19 (CVE-40): the unary/term tier needs its OWN depth entry — PEXPR's wrapper does
# not cover it. A `-`/`!` chain and a `g(g(g(...)))` call chain recurse INSIDE this tier
# without ever returning to PEXPR, so `- - - … 1` at 16384 deep still SIGSEGV'd with the
# PEXPR bound in place. Same wrapper shape as PARSE_STMT/PEXPR; the return value is
# propagated because callers read it. See _rd_enter (src/common/util.cyr).
fn PARSE_TERM(S): i64 {
    _rd_enter(S);
    var _xd0 = _xdepth;
    var _rt = _PARSE_TERM_IMPL(S);
    _rd_exit();
    _xd_check(S, _xd0, "expression term");
    return _rt;
}

fn _PARSE_TERM_IMPL(S): i64 {
    var _tbeg = GTI(S);   # the term's first token: a `*` / `/` dispatch's lhs starts here (6.6.6)
    _cfo = 0;
    # Extended builtins — checked first
    var ptyp = PEEKT(S);
    # v6.5.67 — note BEFORE the factor is consumed whether it is a call to a pair-returning
    # (`: stack` enum) constructor, so the `?` handler below can refuse it. `?` dereferences its
    # operand, so on a pair it reads the TAG (0 or 1) as a pointer: today that compiles with rc=0,
    # no diagnostic, and SIGSEGVs at run time. The guide already states `?` does not apply to the
    # stack form (docs/guides/cyrius-guide.md) — it just never said so to the compiler.
    # ⚠ A LOCAL, captured before the operand is parsed. By the time `?` is seen the cursor is past
    # the call, so this cannot be a peek at that point; and a global would be the `_cfo` re-arm
    # shape, which this codebase has been bitten by four times.
    var _tpair = _callee_returns_pair(S);
    if (PARSE_INTRIN(S, ptyp) == 1) { _cfo = 0; }
    else { PARSE_FACTOR(S); }
    # v5.8.29 — postfix `?` propagation operator. After the primary
    # factor evaluates (rax = Result heap pointer), `?` desugars to:
    #   tag = load64(rax)
    #   if (tag != Ok) { return rax; }   # Err path: short-circuit
    #   rax = load64(rax + 8)            # Ok path: unwrap payload
    # Highest precedence — binds tighter than `*`/`/` (handled below)
    # so `foo()? * bar` is `(foo()?) * bar`. Outside a fn body is a
    # parse-time error (the early-return jump would have nowhere to
    # land). The acceptance gate "outside Result-returning fn is type
    # error" is enforced in this slot at the coarser "outside any fn
    # body" granularity — strict ret-type tracking is a future slot.
    if (PEEKT(S) == 124) {
        var _qpair_done = 0;
        STI(S, GTI(S) + 1);
        if (GINFN(S) == 0) {
            ERR_MSG(S, "?: '?' propagation operator only valid inside a fn body", 55);
        }
        # v6.6.0 — `?` ON A VALUE-FORM (`: stack`) ENUM. The pair is (rax = tag, rdx = payload).
        # ⛔ v6.5.67 made this a hard error because `?` dereferenced its operand and so read the
        # TAG as a pointer — compiling clean and then SIGSEGV'ing. Refusing was the right stopgap;
        # the fix is to lower it properly, because `Result` is the value form now.
        #
        # ⭐ THE ERR PATH MUST RE-EMIT **BOTH** HALVES. The one-line framing this arc carried for
        # a year — "teach `?` to accept a pair" — omitted that, and it is the whole difficulty:
        # propagating a Result out of the enclosing fn means returning a PAIR, so rdx has to be
        # reloaded on the way out. Restoring only rax hands the caller a correct tag with a stale
        # payload, which is the v6.5.67 silent-payload-loss class one level up.
        if (_tpair == 1) {
            var qtag = _HTEMP(S);
            var qval = _HTEMP(S);
            _HTSTORE(S, qtag);                # tag  (rax as returned)
            EMOVRA_RDX(S);                    # rax = rdx = payload
            _HTSTORE(S, qval);
            # if (tag != Ok) -> return (tag, payload)
            _HTLOAD(S, qtag);
            EPUSHR(S);
            EMOVI(S, 0);
            EMOVCA(S);                        # rcx = 0 (Ok)
            EPOPR(S);                         # rax = tag
            ECMPR(S);
            var qjok = EJCC(S, 0x84);         # JE -> Ok, skip the propagate
            _HTLOAD(S, qval);
            EMOVRDXRAX(S);                    # rdx = payload
            _HTLOAD(S, qtag);                 # rax = tag
            var qrp2 = EJMP0(S);
            vec_push(rp_vec, qrp2);
            EPATCH(S, qjok);
            _HTLOAD(S, qval);                 # Ok path: rax = payload
            _cfo = 0;
            # The enclosing fn now returns a pair on its Err path, so mark it pair-returning —
            # exactly as an explicit `return SomeCtor(x)` does (parse_fn.cyr's PARSE_RETURN).
            if (_cur_fn_ix >= 0) { SFLG(S, _cur_fn_ix, GFLG(S, _cur_fn_ix) | 256); }
            _qpair_done = 1;
        }
        if (_qpair_done == 0) {
            # Hidden temp slot to hold the Result ptr across the
            # tag-check / unwrap branches (same idiom as PARSE_MATCH).
            var qidx = _HTEMP(S);
            _HTSTORE(S, qidx);                # save result_ptr
            # Load tag and compare to 0 (Ok = 0, Err = 1)
            _HTLOAD(S, qidx);                  # rax = result_ptr
            ELOAD64(S);                       # rax = [rax] = tag
            EPUSHR(S);
            EMOVI(S, 0);
            EMOVCA(S);                        # rcx = 0 (Ok)
            EPOPR(S);                         # rax = tag
            ECMPR(S);                         # cmp rax, rcx
            var qjcc_ok = EJCC(S, 0x84);      # JE → skip Err branch if Ok
            # Err path: rax = result_ptr, jmp to fn epilogue (RPC table)
            _HTLOAD(S, qidx);
            var qrp = EJMP0(S);
            vec_push(rp_vec, qrp);
            # Ok path landing: rax = [result_ptr + 8] (payload)
            EPATCH(S, qjcc_ok);
            _HTLOAD(S, qidx);                  # rax = result_ptr
            EPUSHR(S);
            EMOVI(S, 8);
            EMOVCA(S);                        # rcx = 8
            EPOPR(S);                         # rax = result_ptr
            EADDR(S);                         # rax = result_ptr + 8
            ELOAD64(S);                       # rax = [result_ptr + 8] = payload
            _cfo = 0;                         # invalidate const-fold tracking
        }
    }
    var go = 1;
    while (go == 1) {
        var typ = PEEKT(S);
        # v5.6.2: `*%` is identical to bare `*` (wrapping default on
        # 2's-complement). Collapse the token ID.
        if (typ == 119) { typ = 8; }
        if (typ == 8) {
            var mulst = _FBR_ST(S);   # 6.6.10: a float builtin's result is a float left operand
            STI(S, GTI(S) + 1);
            if (mulst == F64_TYID) { ESPILL(S); PARSE_FACTOR(S); if (_FBR_ST(S) != F64_TYID) { _FLT_TYPE_WARN(S, 1); } EMIT_F64_BINOP(S, 2); SESTYPE(S, F64_TYID); _cfo = 0; }
            elif (mulst == F32_TYID) { ESPILL(S); PARSE_FACTOR(S); if (_FBR_ST(S) != F32_TYID) { _FLT_TYPE_WARN(S, 5); } EMIT_F32_BINOP(S, 2); SESTYPE(S, F32_TYID); _cfo = 0; }
            elif (mulst > 0) { EMIT_OP_DISPATCH(S, mulst, "mul", 3, _tbeg); _cfo = 0; }
            else {
                # Constant fold: NUM * NUM where both and result are small positive
                if (_cfo == 1) {
                    if (PEEKT(S) == 1) {
                        var crv = PEEKV(S);
                        if (crv == 0) { STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, 0); _cfv = 0; }
                        elif (crv == 1) { STI(S, GTI(S) + 1); }
                        elif (crv > 0) {
                            var cfr = _cfv * crv;
                            if (cfr >= 0) {
                                STI(S, GTI(S) + 1);
                                SCP(S, _cfp);
                                EMOVI(S, cfr);
                                _cfv = cfr;
                            } else {
                                # v5.6.7 O2: cfr overflowed — try shl
                                # strength-reduction before falling to imul.
                                # (v6.1.37: also clear _cfo AFTER — PARSE_FACTOR
                                # may re-arm it on a const RHS.)
                                _cfo = 0;
                                ESPILL(S);
                                if (_TRY_MUL_BY_POW2(S) == 1) { _cfo = 0; }
                                else { _RHS_F(S); EMOVCA(S); EUNSPILL(S); EIMUL(S); _cfo = 0; }
                            }
                        }
                        else {
                            _cfo = 0;
                            ESPILL(S);
                            if (_TRY_MUL_BY_POW2(S) == 1) { _cfo = 0; }
                            else { _RHS_F(S); EMOVCA(S); EUNSPILL(S); EIMUL(S); _cfo = 0; }
                        }
                    } else {
                        # The RHS may itself be an enum/NUM const — PARSE_FACTOR
                        # re-arms const-fold tracking (_cfo/_cfp/_cfv). After this
                        # runtime EIMUL we MUST re-clear _cfo, or the NEXT `*`
                        # const-folds off the stale RHS and rewinds the code,
                        # DROPPING this product (`A * B * 4` → `B * 4` = 800).
                        # Mirrors the outer-else path. See issue 2026-06-11
                        # agnos-const-3operand-multiply-miscompile (all targets).
                        _cfo = 0;
                        ESPILL(S);
                        if (_TRY_MUL_BY_POW2(S) == 1) { _cfo = 0; }
                        else { _RHS_F(S); EMOVCA(S); EUNSPILL(S); EIMUL(S); _cfo = 0; }
                    }
                } else {
                    # v5.6.7 O2: ESPILL LHS, then try strength-reduction
                    # (literal power-of-2 RHS → shl) before emitting the
                    # general `PARSE_FACTOR + EIMUL` sequence.
                    ESPILL(S);
                    if (_TRY_MUL_BY_POW2(S) == 1) { _cfo = 0; }
                    else { _RHS_F(S); EMOVCA(S); EUNSPILL(S); EIMUL(S); _cfo = 0; }
                }
            }
            if (mulst <= 0) { _INT_F64_MIX(S); }
        }
        else { if (typ == 9) {
                var divst = _FBR_ST(S);   # 6.6.10: a float builtin's result is a float left operand
                STI(S, GTI(S) + 1);
                if (divst == F64_TYID) { ESPILL(S); PARSE_FACTOR(S); if (_FBR_ST(S) != F64_TYID) { _FLT_TYPE_WARN(S, 1); } EMIT_F64_BINOP(S, 3); SESTYPE(S, F64_TYID); _cfo = 0; }
                elif (divst == F32_TYID) { ESPILL(S); PARSE_FACTOR(S); if (_FBR_ST(S) != F32_TYID) { _FLT_TYPE_WARN(S, 5); } EMIT_F32_BINOP(S, 3); SESTYPE(S, F32_TYID); _cfo = 0; }
                elif (divst > 0) { EMIT_OP_DISPATCH(S, divst, "div", 3, _tbeg); _cfo = 0; }
                else {
                    if (_cfo == 1) { if (PEEKT(S) == 1) {
                            var crv = PEEKV(S);
                            if (crv > 0) { if (crv < 0x10000) {
                                    var cfr = _cfv / crv;
                                    if (cfr > 0) { if (cfr < 0x10000) {
                                            STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                        } else { ESPILL(S); _RHS_F(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); _cfo = 0; } }
                                    else { ESPILL(S); _RHS_F(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); _cfo = 0; }
                                } else { ESPILL(S); _RHS_F(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); _cfo = 0; } }
                            else { ESPILL(S); _RHS_F(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); _cfo = 0; }
                        } else { ESPILL(S); _RHS_F(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); _cfo = 0; } }
                    else { ESPILL(S); _RHS_F(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); _cfo = 0; }
                }
                if (divst <= 0) { _INT_F64_MIX(S); }
            }
            else { if (typ == 34) {
                    STI(S, GTI(S) + 1); ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ECQO(S); EIDIV(S); _cfo = 0; EMOVDR(S); _cfo = 0;
                }
                else { if (typ == 38) {
                        STI(S, GTI(S) + 1);
                        if (_cfo == 1) { if (PEEKT(S) == 1) {
                                var crv = PEEKV(S);
                                if (crv > 0) { if (crv < 0x10000) {
                                        var cfr = _cfv << crv;
                                        if (cfr > 0) { if (cfr < 0x10000) {
                                                STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                            } else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); _cfo = 0; } }
                                        else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); _cfo = 0; }
                                    } else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); _cfo = 0; } }
                                else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); _cfo = 0; }
                            } else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); _cfo = 0; } }
                        else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHLCL(S); _cfo = 0; }
                    }
                    else { if (typ == 39) {
                            STI(S, GTI(S) + 1);
                            if (_cfo == 1) { if (PEEKT(S) == 1) {
                                    var crv = PEEKV(S);
                                    if (crv > 0) { if (crv < 0x10000) {
                                            var cfr = _cfv >> crv;
                                            if (cfr > 0) { if (cfr < 0x10000) {
                                                    STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                                } else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); _cfo = 0; } }
                                            else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); _cfo = 0; }
                                        } else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); _cfo = 0; } }
                                    else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); _cfo = 0; }
                                } else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); _cfo = 0; } }
                            else { ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); ESHRCL(S); _cfo = 0; }
                        }
                        else { if (typ == 152) {
                                # `>>>` arithmetic (sign-preserving) right shift. Always runtime:
                                # the parser fast-path fold uses logical `>>`, wrong for negative
                                # operands; EASHRCL (sar/asrv) is correct. CHANGELOG [6.4.46].
                                #
                                # v6.4.74 — `_cfo = 0` MOVED TO AFTER the emit (17 sites across
                                # `/ % << >> >>>`). Clearing the const-fold flag BEFORE
                                # `PARSE_FACTOR(S)` does not work: PARSE_FACTOR *re-arms* it for a
                                # bare NUM (parse_expr.cyr:358/368 set `_cfp = GCP(S)` then
                                # `_cfv = val; _cfo = 1`). PEXPR then saw a live fold, folded the
                                # RHS literal with the next operator, and `SCP(S, _cfp)` REWOUND
                                # the code pointer over the entire shift/div sequence — silently
                                # emitting just the folded constant. Measured before the fix:
                                # `100 >>> 1 + 1` == 2 (want 51), `100 >> 0 + 1` == 1 (want 101),
                                # `100 << 0 + 1` == 1 (want 101). `>>` and `<<` mostly escaped only
                                # because their own fold path normally handles a literal RHS and
                                # keeps `_cfv` correct; the bug bit exactly where that fold could
                                # not apply (count 0, or out of the 0x10000 window). A
                                # parenthesised RHS also masked it (`100 >>> (1) + 1` == 51) since
                                # the paren path never re-arms. Found while building the v6.4.74
                                # module-scope initializer folder, which must agree with this path
                                # exactly — encoding the defect into the folder instead would be
                                # the "codegen bug written down as a language rule" antipattern.
                                STI(S, GTI(S) + 1);
                                ESPILL(S); PARSE_FACTOR(S); EMOVCA(S); EUNSPILL(S); EASHRCL(S); _cfo = 0;
                            }
                            # v5.6.2: *| / *? — saturating / checked mul. Calls into
                            # lib/overflow.cyr. Matches the +|/+? pattern at PEXPR.
                            else { if (typ == 120) {
                                    STI(S, GTI(S) + 1);
                                    EPUSHR(S);
                                    PARSE_FACTOR(S);
                                    EPUSHR(S);
                                    EMIT_OVF_CALL(S, "_sat_mul_i64");
                                    _cfo = 0;
                                }
                                else { if (typ == 121) {
                                        STI(S, GTI(S) + 1);
                                        EPUSHR(S);
                                        PARSE_FACTOR(S);
                                        EPUSHR(S);
                                        EMIT_OVF_CALL(S, "_chk_mul_i64");
                                        _cfo = 0;
                                    }
                                    else { go = 0; }
                                } } } } } } }
    }
    return 0;
}

# ⛔ 6.6.17 — POINTER ARITHMETIC BY THE C RULES, on both operand orders. `+` / `-` scaled the RIGHT
# operand by the LEFT one's step whatever the right one was, so with `p, q: *i16` the difference
# `q - p` was `q - 2p`'s bits (`var q: *i16 = p + 3; q - p` read -4090 where 3 is right), and
# `n + p` with the integer on the left stepped 1 where `p + n` steps sizeof(T). Now (ps = the
# left operand's step, rs = the right one's, both 0 for a plain value):
#   p + n, p - n      the integer steps ps (unchanged)
#   n + p             the integer steps rs — `+` commutes (`_int_plus_ptr`)
#   p - q             the ELEMENT count (p - q) / ps when ps == rs; a NAMED ERROR when the steps
#                     differ (`*i64 - *u8`, `*Pt - &buf`) — the result has no honest unit. Two
#                     pointers to different types of the same size cannot be told apart: the step
#                     is all a pointer value carries. Plain addresses (`&a - &b`, step 1 each) stay
#                     a byte difference, as they always were.
# CHANGELOG [6.6.17]
fn _ptr_add(S, ps): i64 {
    var rs = GPSC(S);
    if (ps == 0) { if (rs > 1) { return _int_plus_ptr(S, rs); } }
    EPTR_SCALE(S, ps);
    EMOVCA(S);
    EUNSPILL(S);
    EADDR(S);
    SPSC(S, ps);
    return 0;
}
# Stack = n, rax = p: rax = n * rs + p (EIMUL clobbers rcx, so n goes round the stack).
fn _int_plus_ptr(S, rs): i64 {
    EMOVCA(S);           # rcx = p
    EUNSPILL(S);         # rax = n
    EPUSHR(S);           # push n
    EMOVI(S, 0);
    EADDR(S);            # rax = p
    EPOPC(S);            # rcx = n
    EPUSHR(S);           # push p
    EMOVI(S, rs);
    EIMUL(S);            # rax = n * rs
    EPOPC(S);            # rcx = p
    EADDR(S);
    SPSC(S, rs);
    return 0;
}
fn _ptr_sub(S, ps): i64 {
    var rs = GPSC(S);
    if (ps > 0) { if (rs > 0) { return _ptr_diff(S, ps, rs); } }
    EPTR_SCALE(S, ps);
    EMOVCA(S);
    EPOPR(S);
    ESUBR(S);
    SPSC(S, ps);
    return 0;
}
fn _ptr_diff(S, ps, rs): i64 {
    if (rs != ps) {
        ERR_MSG(S, "pointer difference of pointers with different element sizes; for a byte count subtract plain addresses (`var a = p;`)", 117);
    }
    EMOVCA(S);
    EPOPR(S);
    ESUBR(S);            # rax = p - q, in bytes
    if (ps > 1) {
        EPUSHR(S);
        EMOVI(S, ps);
        EMOVCA(S);
        EPOPR(S);
        ECQO(S);
        EIDIV(S);        # / sizeof(T)
    }
    SPSC(S, 0);
    return 0;
}

fn EPTR_SCALE(S, ps): i64 {
    # rax has the offset value; multiply by pointer scale
    # mov rcx, rax; mov rax, ps; imul rcx → rax = offset * scale
    if (ps > 1) { EMOVCA(S); EMOVI(S, ps); EIMUL(S); }
    return 0;
}

# Build operator function name: StructName_op in tok_names
# op_name is a short string like "add", "sub", "mul", "div"
fn BUILD_OP_NAME(S, stype, op_str, op_len): i64 {
    var si = stype - 1;
    var snoff = L64(S + 0x1A6018 + si * 8);
    # v5.11.65 (CVE-05): bound against actual struct-name length + op
    # suffix; was magic-256 pessimistic budget. See CHANGELOG [5.11.65].
    var _snlen = 0; while (load8(S + 0xEC00000 + snoff + _snlen) != 0) { _snlen = _snlen + 1; }
    NPOS_GUARD(S, _snlen + 1 + op_len + 1);
    var owp = GNPOS(S);
    var onoff = owp;
    var ori = 0;
    var orc = load8(S + 0xEC00000 + snoff + ori);
    while (orc != 0) { store8(S + 0xEC00000 + owp, orc); owp = owp + 1; ori = ori + 1; orc = load8(S + 0xEC00000 + snoff + ori); }
    store8(S + 0xEC00000 + owp, 95); owp = owp + 1;
    var oci = 0;
    while (oci < op_len) { store8(S + 0xEC00000 + owp + oci, load8(op_str + oci)); oci = oci + 1; }
    owp = owp + op_len;
    store8(S + 0xEC00000 + owp, 0); owp = owp + 1;
    SNPOS(S, owp);
    return onoff;
}

# ⛔ 6.6.6 (bite 16 review) — DOES A STRUCT-TYPED LOCAL IN LHS POSITION DISPATCH ITS OPERATOR?
# The 6.6.5 rule (see the identifier-load site above) is "only an INLINE local dispatches — a
# pointer-mode one holds an address, where `+` is pointer arithmetic", and that rule is still
# right for `var p: P3 = alloc(24)` and for a `Str` handle. But an ADDRESS-PASSED BY-VALUE
# PARAMETER is neither: `q` in `fn h(q: P3)` denotes the caller's STRUCT, which is why `q.z`
# already reaches it. Keyed on `GLAGG == 1` alone, such a parameter set no expr-state type at
# all, so `q + w` never dispatched and SILENTLY ADDED THE TWO POINTERS — measured at 6.6.5 and
# on the compiler 16b shipped: 104 (and 72, 81 for other frames) where 9 is right, exit 0, no
# diagnostic, while the identical expression on two inline LOCALS dispatched and gave 9, and
# `var c: P3 = q + w` SIGSEGV'd. Same root cause as the rest of bite 16: the parameter slot
# holds a pointer and every predicate keyed on inline-ness answers "not an aggregate".
# CHANGELOG [6.6.6]
fn _op_local_dispatches(S, li): i64 {
    if (GLAGG(S, li) == 1) { return 1; }
    return _local_is_sptr_param(S, li);
}

# 6.6.6 (bite 16 review) — the LOCAL arm of `_OP_OPERAND_ADDR`, split out so the two modes are
# one decision. An inline local IS the struct, so its address is `&slot`; an address-passed
# by-value parameter's slot HOLDS the struct's address, so the operand is the slot's CONTENT.
# Passing `&slot` there handed the operator fn a pointer-to-pointer. CHANGELOG [6.6.6]
fn _op_operand_local(S, li): i64 {
    if (_local_is_sptr_param(S, li) == 1) { EFLLOAD(S, li); return 0; }
    EFLADDR(S, li);
    return 0;
}

# Emit operator dispatch: push lhs, parse rhs, call StructName_op(lhs, rhs)
# 6.6.5 — the operand address for an overloaded operator. `svar >= 0` is a global slot;
# `svar <= -2` is the LOCAL encoding `-2 - li` (the same one PARSE_FIELD_LOAD uses), added so
# a multi-word struct LOCAL can be passed by address exactly as a global already was.
fn _OP_OPERAND_ADDR(S, svar): i64 {
    # 6.6.5 — the CAPTURE band (`-1000000 - capi`) is tested FIRST: it is also `<= -2`, so the
    # local arm below would read it as a nonsense slot index. `_CL_CAP_OPTYPE` only ever puts a
    # MULTI-WORD capture here, and those words ARE the aggregate, so `&env[woff]` is its
    # address with no load — the same convention `_CL_CAP_BASE_RA` uses. CHANGELOG [6.6.5]
    if (svar <= 0 - 1000000) { _CL_CAP_WORDS_RA(S, 0 - 1000000 - svar); return 0; }
    if (svar >= 0) { EVADDR(S, svar); return 0; }
    if (svar <= 0 - 2) { _op_operand_local(S, 0 - 2 - svar); }
    return 0;
}

fn EMIT_OP_DISPATCH(S, stype, op_str, op_len, beg): i64 {
    # 6.6.6 (bite 14 review): an operator fn returning a struct BY VALUE takes its own path, so
    # every other dispatch below stays byte-identical. `beg` = the lhs's first token.
    if (_ret_agg_class(S, _op_fn_peek(S, stype, op_str, op_len)) != 0) {
        return _EMIT_OP_DISPATCH_AGG(S, stype, op_str, op_len, beg);
    }
    var opti = GTI(S) - 1;   # the operator, just consumed — the call the warning names (6.6.16)
    # For struct vars, push address instead of value
    var svar = GESVAR(S);
    _OP_OPERAND_ADDR(S, svar);
    EPUSHR(S);
    PARSE_TERM(S);
    # rhs: check if it also has a struct var
    var rsvar = GESVAR(S);
    _OP_OPERAND_ADDR(S, rsvar);
    EPUSHR(S);
    var opnoff = BUILD_OP_NAME(S, stype, op_str, op_len);
    ECALLPOPS(S, 2);
    var ofi = FINDFN(S, opnoff);
    if (ofi < 0) { ofi = REGFN(S, opnoff); }
    _callee_site_checks(S, ofi, opnoff, opti);   # v6.5.0: operator overloading is its own call path
    # ⛔ 6.6.6 (bite 14 review) — OPERATOR DISPATCH NEVER CHECKED THE OPERATOR FN'S ARITY. An
    # operator always passes exactly two operands, so `fn V2_add(a, b, c)` bound `c` to whatever
    # happened to be in the third argument register: `a + b` compiled clean and computed with
    # garbage. Every OTHER call position has had a hard arity error since v6.5.1 (`_CHECK_ARITY`)
    # — this one was simply never wired to it. The line is the LHS's first token, not the cursor,
    # which by here has walked past the whole expression. CHANGELOG [6.6.6]
    _CHECK_ARITY(S, GTLINE(S, beg), opnoff, ofi, 2, 1);
    var ofoff = L64(_fnt_offsets + ofi * 8);
    if (ofoff >= 0) { ECALLTO(S, ofoff); }
    else { ECALLFIX(S, ofi); }
    ECALLCLEAN(S, 2);
    SESTYPE(S, 0);
    _sc_post_small(S, ofi, opnoff, beg);   # 6.6.11: a <= 8 B struct result, for the destination's type check
    return 0;
}

# The operator fn `StructName_op`, looked up WITHOUT committing its name: EMIT_OP_DISPATCH builds
# it again at its old place, so the name pool and the fn table grow exactly as they always did.
# -1 when there is no such fn yet. CHANGELOG [6.6.6]
fn _op_fn_peek(S, stype, op_str, op_len): i64 {
    var np = GNPOS(S);
    var fi = FINDFN(S, BUILD_OP_NAME(S, stype, op_str, op_len));
    SNPOS(S, np);
    return fi;
}

# ⛔ 6.6.6 (bite 14 review) — EMIT_OP_DISPATCH for an operator fn returning a struct BY VALUE
# (`fn V3_add(a, b): V3`). `var c: V3 = a + b` SIGSEGV'd on every target: the dispatch passed no
# retptr, so the callee wrote its result through the lhs address. The same dispatch, bracketed by
# `_sc_pre` / `_sc_x8` / `_sc_post` (parse_fn.cyr) — the temp, the retptr (int arg 0 on x86/cx,
# X8 on aarch64) and the record a destination takes. One wrinkle: a <= 8 B lhs is passed BY
# VALUE (there is no struct var to re-address), it is already in rax when the operator is seen,
# and on x86/cx the retptr must go BELOW it — so it is parked in a frame word first.
fn _EMIT_OP_DISPATCH_AGG(S, stype, op_str, op_len, beg): i64 {
    var opti = GTI(S) - 1;   # the operator (see EMIT_OP_DISPATCH)
    var svar = GESVAR(S);
    var opnoff = BUILD_OP_NAME(S, stype, op_str, op_len);
    var ofi = FINDFN(S, opnoff);
    if (ofi < 0) { ofi = REGFN(S, opnoff); }
    var park = 0 - 1;
    if (svar == 0 - 1) { park = _op_park_lhs(S, ofi); }
    var t = _sc_pre(S, ofi, opnoff, beg);
    var n = 2 + _sc_n0;
    if (park >= 0) { EFLLOAD(S, park); } else { _OP_OPERAND_ADDR(S, svar); }
    EPUSHR(S);
    PARSE_TERM(S);
    var rsvar = GESVAR(S);
    _OP_OPERAND_ADDR(S, rsvar);
    EPUSHR(S);
    ECALLPOPS(S, n);
    _sc_x8(S, ofi, t);
    _callee_site_checks(S, ofi, opnoff, opti);
    # 6.6.6 — same arity check as the scalar dispatch above. The retptr/X8 the struct-returning
    # form adds is NOT a declared parameter, so the expected count is still exactly 2.
    _CHECK_ARITY(S, GTLINE(S, beg), opnoff, ofi, 2, 1);
    var ofoff = L64(_fnt_offsets + ofi * 8);
    if (ofoff >= 0) { ECALLTO(S, ofoff); }
    else { ECALLFIX(S, ofi); }
    ECALLCLEAN(S, n);
    SESTYPE(S, 0);
    _sc_post(S, ofi, opnoff, beg, t);
    return 0;
}

# Park a by-value lhs (rax) in an anonymous frame word when `_sc_pre` is about to push a retptr
# (x86/cx, >16 B result, in a fn). Returns the slot, or -1 when nothing needs parking.
fn _op_park_lhs(S, fi): i64 {
    if (_ret_agg_class(S, fi) != 2) { return 0 - 1; }
    if (_AARCH64_BACKEND == 1) { return 0 - 1; }
    if (GINFN(S) != 1) { return 0 - 1; }
    var w = GFLC(S);
    S64(S + 0x5D9D000 + w * 8, 0 - 1);
    SLDEP(S, w, GSDEP(S));
    SLTYPE(S, w, 0);
    SFLC(S, w + 1);
    if (w + 1 > _flc_hwm) { _flc_hwm = w + 1; }
    EFLSTORE(S, w);
    return w;
}

# v5.6.2: emit a binop as a call to a named stdlib helper fn
# (`_sat_add_i64` / `_chk_sub_i64` / etc. — see `lib/overflow.cyr`).
# Assumes lhs is already pushed and rhs is pushed right before the call
# (ECALLPOPS consumes 2 stack args). If the helper isn't defined at
# link time the standard "undefined function" diagnostic fires on the
# generated call — with the v5.6.0 `--strict` flag that's a hard-error.
fn EMIT_OVF_CALL(S, fname_str): i64 {
    var flen = 0;
    while (load8(fname_str + flen) != 0) { flen = flen + 1; }
    NPOS_GUARD(S, flen + 1);
    var np = GNPOS(S);
    var i = 0;
    while (i < flen) {
        store8(S + 0xEC00000 + np + i, load8(fname_str + i));
        i = i + 1;
    }
    store8(S + 0xEC00000 + np + flen, 0);
    SNPOS(S, np + flen + 1);
    var fi = FINDFN(S, np);
    if (fi < 0) { fi = REGFN(S, np); }
    ECALLPOPS(S, 2);
    var foff = L64(_fnt_offsets + fi * 8);
    if (foff >= 0) { ECALLTO(S, foff); }
    else { ECALLFIX(S, fi); }
    ECALLCLEAN(S, 2);
    return 0;
}

# v6.5.19 (CVE-40): the expression-tier depth chokepoint, shaped exactly like the
# PARSE_STMT wrapper in parse.cyr (v6.4.62) so there is one pattern, not two. PARSE_STMT
# alone does NOT cover the expression vectors — nested parens, unary-minus chains and
# call chains recurse through PEXPR/PARSE_TERM without ever re-entering a statement — so
# a bound placed only on statements would have left three of the six crashing shapes
# live. See _rd_enter (src/common/util.cyr).
fn PEXPR(S): i64 {
    _rd_enter(S);
    var _xd0 = _xdepth;
    _PEXPR_IMPL(S);
    _rd_exit();
    _xd_check(S, _xd0, "expression");
    return 0;
}

fn _PEXPR_IMPL(S): i64 {
    var _xbeg = GTI(S);   # every `+` / `-` dispatch's lhs starts here (left-assoc) (6.6.6)
    PARSE_TERM(S);
    var ps = GPSC(S);
    var go = 1;
    while (go == 1) {
        var typ = PEEKT(S);
        # v5.6.2: `+%` / `-%` are semantically identical to bare `+` /
        # `-` (wrapping is the default on 2's-complement); collapse
        # token IDs so the existing dispatch below handles them.
        if (typ == 113) { typ = 6; }
        elif (typ == 116) { typ = 7; }
        # `+|` / `+?` / `-|` / `-?` compile to a call to the
        # corresponding `lib/overflow.cyr` helper. Handled in their own
        # branches below so the constant-fold paths don't fire on them.
        if (typ == 6) {
            var addst = _FBR_ST(S);   # 6.6.10: a float builtin's result is a float left operand
            STI(S, GTI(S) + 1);
            if (addst == F64_TYID) { ESPILL(S); PARSE_TERM(S); if (_FBR_ST(S) != F64_TYID) { _FLT_TYPE_WARN(S, 1); } EMIT_F64_BINOP(S, 0); SESTYPE(S, F64_TYID); _cfo = 0; }
            elif (addst == F32_TYID) { ESPILL(S); PARSE_TERM(S); if (_FBR_ST(S) != F32_TYID) { _FLT_TYPE_WARN(S, 5); } EMIT_F32_BINOP(S, 0); SESTYPE(S, F32_TYID); _cfo = 0; }
            elif (addst > 0) { EMIT_OP_DISPATCH(S, addst, "add", 3, _xbeg); _cfo = 0; }
            else {
                # Fold only if right side is a plain literal (not followed by * / % << >>)
                var add_can_fold = 0;
                if (_cfo == 1) { if (PEEKT(S) == 1) {
                        var nt = TOKTYP(S, GTI(S) + 1);
                        if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                            add_can_fold = 1;
                                        } } } } }
                    } }
                if (add_can_fold == 1) {
                    var crv = PEEKV(S);
                    if (crv == 0) { STI(S, GTI(S) + 1); }
                    elif (crv > 0) {
                        var cfr = _cfv + crv;
                        if (cfr >= 0) {
                            STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                        } else { ESPILL(S); SPSC(S, 0); _RHS_T(S); _ptr_add(S, ps); ps = GPSC(S); _cfo = 0; }
                    }
                    else { ESPILL(S); SPSC(S, 0); _RHS_T(S); _ptr_add(S, ps); ps = GPSC(S); _cfo = 0; }
                } else { ESPILL(S); SPSC(S, 0); _RHS_T(S); _ptr_add(S, ps); ps = GPSC(S); _cfo = 0; }
            }
            if (addst <= 0) { _INT_F64_MIX(S); }
        }
        else { if (typ == 7) {
                var subst = _FBR_ST(S);   # 6.6.10: a float builtin's result is a float left operand
                STI(S, GTI(S) + 1);
                if (subst == F64_TYID) { ESPILL(S); PARSE_TERM(S); if (_FBR_ST(S) != F64_TYID) { _FLT_TYPE_WARN(S, 1); } EMIT_F64_BINOP(S, 1); SESTYPE(S, F64_TYID); _cfo = 0; }
                elif (subst == F32_TYID) { ESPILL(S); PARSE_TERM(S); if (_FBR_ST(S) != F32_TYID) { _FLT_TYPE_WARN(S, 5); } EMIT_F32_BINOP(S, 1); SESTYPE(S, F32_TYID); _cfo = 0; }
                elif (subst > 0) { EMIT_OP_DISPATCH(S, subst, "sub", 3, _xbeg); _cfo = 0; }
                else {
                    var sub_can_fold = 0;
                    if (_cfo == 1) { if (PEEKT(S) == 1) {
                            var nt = TOKTYP(S, GTI(S) + 1);
                            if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                                sub_can_fold = 1;
                                            } } } } }
                        } }
                    if (sub_can_fold == 1) {
                        var crv = PEEKV(S);
                        if (crv == 0) { STI(S, GTI(S) + 1); }
                        elif (crv > 0) {
                            var cfr = _cfv - crv;
                            if (cfr >= 0) {
                                STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                            } else { EPUSHR(S); SPSC(S, 0); _RHS_T(S); _ptr_sub(S, ps); ps = GPSC(S); _cfo = 0; }
                        }
                        else { EPUSHR(S); SPSC(S, 0); _RHS_T(S); _ptr_sub(S, ps); ps = GPSC(S); _cfo = 0; }
                    } else { EPUSHR(S); SPSC(S, 0); _RHS_T(S); _ptr_sub(S, ps); ps = GPSC(S); _cfo = 0; }
                }
                if (subst <= 0) { _INT_F64_MIX(S); }
            }
            # v5.6.2: +| / +? / -| / -? — saturating / checked add/sub.
            # Compiles to a call into lib/overflow.cyr. No constant-fold
            # path; let the helper handle any corner cases. SPSC(0) during
            # PARSE_TERM so pointer scaling doesn't apply (overflow ops
            # are defined on integers only).
            else { if (typ == 114) {
                    STI(S, GTI(S) + 1);
                    EPUSHR(S);
                    SPSC(S, 0);
                    PARSE_TERM(S);
                    EPUSHR(S);
                    EMIT_OVF_CALL(S, "_sat_add_i64");
                    SPSC(S, ps);
                    _cfo = 0;
                }
                else { if (typ == 115) {
                        STI(S, GTI(S) + 1);
                        EPUSHR(S);
                        SPSC(S, 0);
                        PARSE_TERM(S);
                        EPUSHR(S);
                        EMIT_OVF_CALL(S, "_chk_add_i64");
                        SPSC(S, ps);
                        _cfo = 0;
                    }
                    else { if (typ == 117) {
                            STI(S, GTI(S) + 1);
                            EPUSHR(S);
                            SPSC(S, 0);
                            PARSE_TERM(S);
                            EPUSHR(S);
                            EMIT_OVF_CALL(S, "_sat_sub_i64");
                            SPSC(S, ps);
                            _cfo = 0;
                        }
                        else { if (typ == 118) {
                                STI(S, GTI(S) + 1);
                                EPUSHR(S);
                                SPSC(S, 0);
                                PARSE_TERM(S);
                                EPUSHR(S);
                                EMIT_OVF_CALL(S, "_chk_sub_i64");
                                SPSC(S, ps);
                                _cfo = 0;
                            }
                            else { if (typ == 27) {
                                    # AMPERSAND — binary AND
                                    STI(S, GTI(S) + 1);
                                    var and_can_fold = 0;
                                    if (_cfo == 1) { if (PEEKT(S) == 1) {
                                            var nt = TOKTYP(S, GTI(S) + 1);
                                            if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                                                and_can_fold = 1;
                                                            } } } } }
                                        } }
                                    if (and_can_fold == 1) {
                                        var crv = PEEKV(S);
                                        if (crv > 0) { if (crv < 0x10000) {
                                                var cfr = _cfv & crv;
                                                if (cfr > 0) { if (cfr < 0x10000) {
                                                        STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                                    } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); _cfo = 0; } }
                                                else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); _cfo = 0; }
                                            } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); _cfo = 0; } }
                                        else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); _cfo = 0; }
                                    } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EANDR(S); _cfo = 0; }
                                }
                                else { if (typ == 35) {
                                        # PIPE — binary OR
                                        STI(S, GTI(S) + 1);
                                        var or_can_fold = 0;
                                        if (_cfo == 1) { if (PEEKT(S) == 1) {
                                                var nt = TOKTYP(S, GTI(S) + 1);
                                                if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                                                    or_can_fold = 1;
                                                                } } } } }
                                            } }
                                        if (or_can_fold == 1) {
                                            var crv = PEEKV(S);
                                            if (crv > 0) { if (crv < 0x10000) {
                                                    var cfr = _cfv | crv;
                                                    if (cfr > 0) { if (cfr < 0x10000) {
                                                            STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                                        } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); _cfo = 0; } }
                                                    else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); _cfo = 0; }
                                                } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); _cfo = 0; } }
                                            else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); _cfo = 0; }
                                        } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EORR(S); _cfo = 0; }
                                    }
                                    else { if (typ == 36) {
                                            # CARET — binary XOR
                                            STI(S, GTI(S) + 1);
                                            var xor_can_fold = 0;
                                            if (_cfo == 1) { if (PEEKT(S) == 1) {
                                                    var nt = TOKTYP(S, GTI(S) + 1);
                                                    if (nt != 8) { if (nt != 9) { if (nt != 34) { if (nt != 38) { if (nt != 39) {
                                                                        xor_can_fold = 1;
                                                                    } } } } }
                                                } }
                                            if (xor_can_fold == 1) {
                                                var crv = PEEKV(S);
                                                if (crv > 0) { if (crv < 0x10000) {
                                                        var cfr = _cfv ^ crv;
                                                        if (cfr > 0) { if (cfr < 0x10000) {
                                                                STI(S, GTI(S) + 1); SCP(S, _cfp); EMOVI(S, cfr); _cfv = cfr;
                                                            } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); _cfo = 0; } }
                                                        else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); _cfo = 0; }
                                                    } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); _cfo = 0; } }
                                                else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); _cfo = 0; }
                                            } else { EPUSHR(S); PARSE_TERM(S); EMOVCA(S); EPOPR(S); EXORR(S); _cfo = 0; }
                                        }
                                        else { go = 0; }
                                    } } } } } } } }
    }
    return 0;
}

# v6.4.56 D3 — stricter scalar-float typecheck (WARN-only, gated on the default-on
# CYRIUS_TYPE_CHECK flag). WARN not ERROR: an error would break the legal i64-boxed
# float idiom (ADR-002) — f64_add/f64_lt on untyped vars never reach an F64_TYID arm,
# so they're untouched. kind 1 (arithmetic mix) is live: a plain `+`/`-`/`*`/`/` on an
# F64_TYID value with a non-f64 RHS is the exact trap where `x + 1` silently means
# `x + <int-1-as-denormal>`, not `x + 1.0`. kind 0 (comparison mix) is live as of v6.4.57:
# wired in the _PLOGIC_ATOM compare arm WITH literal-0 suppression — `if (x > 0)` on an f64
# does NOT warn (the int literal 0's bits ARE 0.0, so the compare is exact), but `if (x > 5)`
# / `if (x > y)` DO (5's int bits ≠ 5.0's f64 bits — a denormal compare). stderr (fd 2).
# kind 2 (6.6.8) is the int-left mirror of kind 1 (see _INT_F64_MIX); kinds 3 and 4 (6.6.10)
# are unary minus on an untyped float variable (_UFV_L) and an integer constant stored into an
# f64 / f32 slot (_IFS_CHECK). kind 5 (6.6.11) is kind 1 for the f32 arms: EMIT_F32_BINOP takes
# the right operand's LOW 32 BITS, so an f64 literal (`x * 2.0` → 0) or an integer is silently
# reinterpreted. Warn-only, the same ADR-002 posture as kind 1. CHANGELOG [6.6.11]
fn _FLT_TYPE_WARN(S, kind): i64 {
    if (_TYPE_CHECK_ENABLED() != 1) { return 0; }
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head(S);
    if (kind == 0) {
        syscall(SYS_WRITE, 2, ": comparison mixes f64 and integer operands\n", 44);
    } elif (kind == 2) {
        syscall(SYS_WRITE, 2, ": integer arithmetic with an f64 right operand\n", 47);
    } elif (kind == 3) {
        syscall(SYS_WRITE, 2, ": unary minus on an untyped variable holding a float is integer negation (declare it f64)\n", 90);
    } elif (kind == 4) {
        syscall(SYS_WRITE, 2, ": an integer stored into an f64/f32 slot keeps its integer bits (write a float literal)\n", 88);
    } elif (kind == 5) {
        syscall(SYS_WRITE, 2, ": f32 arithmetic with a non-f32 right operand\n", 46);
    } else {
        syscall(SYS_WRITE, 2, ": f64 arithmetic with a non-f64 right operand\n", 46);
    }
    return 0;
}

# kind 2 (6.6.8) — the mirror of kind 1: an INT-left `+ - * /` whose right operand is f64
# (`0 - 1.5`, `2 * x`) is integer arithmetic on the float's bits, silently (`0 - 1.5` is
# -3.0). WARN only, the same ADR-002 posture as kind 1: the result type is left as it was.
# Called after the int arm has parsed its right operand; a folded literal RHS never set
# the type, so it cannot fire. CHANGELOG [6.6.8]
# 6.6.10: a float builtin's result on the right (`2 * f64_sqrt(u)`) is an f64 operand too; its
# flag was captured by _RHS_F / _RHS_T before the integer op was emitted, and is consumed here.
fn _INT_F64_MIX(S): i64 {
    var fr = _fbr_rhs;
    _fbr_rhs = 0;
    if (GESTYPE(S) == F64_TYID) { _FLT_TYPE_WARN(S, 2); return 0; }
    if (fr == 1) { _FLT_TYPE_WARN(S, 2); }
    return 0;
}

# One comparison "atom" for the logical-operator precedence levels: a value
# expression plus an optional trailing comparison. v6.3.36 extracted this from
# the old PCMPE prologue so EVERY && / || operand parses comparisons the same
# way (previously only the first operand had the f64 comparison sugar; && and ||
# right operands used a reduced int-only path — see issue [3]).
fn _PLOGIC_ATOM(S): i64 {
    PEXPR(S);
    var op = PEEKT(S);
    if (op >= 17) {
        if (op <= 22) {
            # v6.2.19: f64 comparison-operator sugar. Capture the lhs type BEFORE
            # parsing the rhs (PEXPR(rhs) overwrites the expr-state-type). For an
            # f64 lhs, route to EF64_CMP (ucomisd/fcmp + setcc) instead of the
            # integer ESETCC; the operand setup (lhs→rcx, rhs on stack + in rax)
            # mirrors PF64CMP's. Result is an i64 boolean (SESTYPE 0).
            var cmpst = GESTYPE(S);
            STI(S, GTI(S) + 1);
            # v6.4.57 (kind-0 compare-mix warn): peek the rhs FIRST token before it's
            # parsed. Suppress the warning when the non-float operand is the integer
            # LITERAL 0 (token type 1, value 0) — `if (x > 0)` is exact since 0's int
            # bits ARE 0.0. `if (x > 5)` / `if (x > y)` are NOT suppressed and warn.
            var _rhs_lit0 = 0;
            if (PEEKT(S) == 1) { if (PEEKV(S) == 0) { _rhs_lit0 = 1; } }
            _cfo = 0;
            EPUSHR(S);
            PEXPR(S);
            if (cmpst == F64_TYID) {
                if (GESTYPE(S) != F64_TYID) { if (_rhs_lit0 == 0) { _FLT_TYPE_WARN(S, 0); } }
                EPOPC(S); EPUSHR(S);
                EF64_CMP(S, op);
                SESTYPE(S, 0);
            } elif (cmpst == F32_TYID) {
                # v6.4.56 (scalar-float D2): f32 comparison sugar → EF32_CMP
                # (ucomiss / fcmp s-reg). Same operand setup as f64.
                EPOPC(S); EPUSHR(S);
                EF32_CMP(S, op);
                SESTYPE(S, 0);
            } else {
                if (GESTYPE(S) == F64_TYID) { if (_rhs_lit0 == 0) { _FLT_TYPE_WARN(S, 0); } }
                EMOVCA(S);
                EPOPR(S);
                ESETCC(S, op);
            }
            _cfo = 0;
        }
    }
    return 0;
}

# && precedence level (binds TIGHTER than ||): _PLOGIC_ATOM (&& _PLOGIC_ATOM)*
# with short-circuit codegen. Result normalized to a 0/1 boolean in rax when the
# chain has >1 operand. Short-circuit (fixed 4.4.1 — the prior bitwise impl
# evaluated both sides, miscompiling guards like `if (p != 0 && vec_len(p) > 0)`):
#   eval left, cmp 0, je skip_right, eval right, cmp 0, setne al,
#   jmp end, skip_right: xor rax,rax (0), end:
fn _PLOGIC_AND(S): i64 {
    _PLOGIC_ATOM(S);
    var lop = PEEKT(S);
    while (lop == 53) {
        # cmp rax, 0 ; je skip  — short-circuit && when the left side is false.
        EPUSHR(S);
        EMOVI(S, 0);
        EMOVCA(S);
        EPOPR(S);
        ECMPR(S);
        var p_skip = EJCC(S, 0x84);
        STI(S, GTI(S) + 1);          # consume &&
        _PLOGIC_ATOM(S);             # right operand
        # normalize right side to boolean (cmp 0; setne al; movzx)
        EPUSHR(S);
        EMOVI(S, 0);
        EMOVCA(S);
        EPOPR(S);
        ECMPR(S);
        ESETCC(S, 18);               # 18 is !=, emits setne + movzx
        var p_end = EJMP0(S);
        EPATCH(S, p_skip);
        EMOVI(S, 0);                 # short-circuited (left false) → result 0
        EPATCH(S, p_end);
        lop = PEEKT(S);
    }
    return 0;
}

# Parse comparison expression: the || precedence level (binds LOOSER than &&).
# _PLOGIC_AND (|| _PLOGIC_AND)* — so `a || b && c` parses as `a || (b && c)`
# (v6.3.36 issue [3]: previously && and || shared one flat left-associative loop,
# giving them equal precedence and mis-parsing this as `(a || b) && c`).
# Returns value in rax (0 or 1 for comparisons).
#   || codegen: eval left, cmp 0, jne skip_right, eval right, cmp 0, setne al,
#               jmp end, skip_right: mov rax,1, end:
fn PCMPE(S): i64 {
    _PLOGIC_AND(S);
    var lop = PEEKT(S);
    while (lop == 54) {
        # cmp rax, 0 ; jne skip  — short-circuit || when the left side is true.
        EPUSHR(S);
        EMOVI(S, 0);
        EMOVCA(S);
        EPOPR(S);
        ECMPR(S);
        var p_skip = EJCC(S, 0x85);
        STI(S, GTI(S) + 1);          # consume ||
        _PLOGIC_AND(S);              # right operand: a full && chain (tighter)
        # normalize right side to boolean (cmp 0; setne al; movzx)
        EPUSHR(S);
        EMOVI(S, 0);
        EMOVCA(S);
        EPOPR(S);
        ECMPR(S);
        ESETCC(S, 18);               # 18 is !=, emits setne + movzx
        var p_end = EJMP0(S);
        EPATCH(S, p_skip);
        EMOVI(S, 1);                 # short-circuited (left true) → result 1
        EPATCH(S, p_end);
        lop = PEEKT(S);
    }
    return 0;
}
