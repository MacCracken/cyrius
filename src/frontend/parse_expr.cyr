# PARSER — expression parsing: PARSE_FACTOR / PARSE_TERM / PEXPR /
# PCMPE + helpers (_SC_ARITY, _STR_FROM_NOFF, PF64BIN, PF64CMP,
# PARSE_SIMD_EXT, EPTR_SCALE, BUILD_OP_NAME, EMIT_OP_DISPATCH).
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38 to keep single-file
# LOC under ~1500. Included by parse.cyr at the same textual position
# the original content lived. No logical change from the original
# inline version; self-host byte-identical by construction.

fn _SC_ARITY(n): i64 {
    if (n == 0) { return 3; }    # read(fd, buf, count)
    if (n == 1) { return 3; }    # write(fd, buf, count)
    if (n == 2) { return 3; }    # open(path, flags, mode)
    if (n == 3) { return 1; }    # close(fd)
    if (n == 4) { return 2; }    # stat(path, buf)
    if (n == 5) { return 2; }    # fstat(fd, buf)
    if (n == 8) { return 3; }    # lseek(fd, off, whence)
    if (n == 9) { return 6; }    # mmap(addr, len, prot, flags, fd, off)
    if (n == 10) { return 3; }   # mprotect(addr, len, prot)
    if (n == 11) { return 2; }   # munmap(addr, len)
    if (n == 12) { return 1; }   # brk(addr)
    if (n == 16) { return 3; }   # ioctl(fd, req, arg)
    if (n == 21) { return 2; }   # access(path, mode)
    if (n == 22) { return 1; }   # pipe(fds)
    if (n == 32) { return 1; }   # dup(fd)
    if (n == 33) { return 2; }   # dup2(old, new)
    if (n == 39) { return 0; }   # getpid()
    if (n == 56) { return 5; }   # clone(flags, stack, ptid, ctid, tls)
    if (n == 57) { return 0; }   # fork()
    if (n == 59) { return 3; }   # execve(path, argv, envp)
    if (n == 60) { return 1; }   # exit(code)
    if (n == 61) { return 4; }   # wait4(pid, status, opts, rusage)
    if (n == 62) { return 2; }   # kill(pid, sig)
    if (n == 63) { return 1; }   # uname(buf)
    if (n == 72) { return 3; }   # fcntl(fd, cmd, arg)
    if (n == 79) { return 2; }   # getcwd(buf, size)
    if (n == 262) { return 4; }  # newfstatat(dirfd, path, buf, flags) — at-family stat (v6.1.3)
    if (n == 280) { return 4; }  # utimensat(dirfd, path, times, flags) (v6.1.3)
    if (n == 80) { return 1; }   # chdir(path)
    if (n == 83) { return 2; }   # mkdir(path, mode)
    if (n == 84) { return 1; }   # rmdir(path)
    if (n == 87) { return 1; }   # unlink(path)
    if (n == 90) { return 2; }   # chmod(path, mode)
    if (n == 102) { return 0; }  # getuid()
    if (n == 104) { return 0; }  # getgid()
    if (n == 107) { return 0; }  # geteuid()
    if (n == 108) { return 0; }  # getegid()
    if (n == 112) { return 0; }  # setsid() takes 0 args
    if (n == 113) { return 1; }  # setuid(uid)
    if (n == 116) { return 2; }  # setgroups(size, list)
    if (n == 165) { return 5; }  # mount(src, tgt, fs, flags, data)
    if (n == 166) { return 2; }  # umount2(target, flags)
    if (n == 169) { return 4; }  # reboot(magic1, magic2, cmd, arg)
    return 0 - 1;
}

# Cache for str_from function index (auto-coercion).
# Lazily resolved on first use — returns the tok_names offset for "str_from".
var _str_from_cache = 0 - 1;
fn _STR_FROM_NOFF(S): i64 {
    if (_str_from_cache >= 0) { return _str_from_cache; }
    # Search tok_names for "str_from\0" = 0x006D6F72665F727473
    var npos = GNPOS(S);
    var i = 0;
    while (i < npos) {
        if (L64(S + 0xEC00000 + i) == 0x6D6F72665F727473) {
            if (load8(S + 0xEC00000 + i + 8) == 0) {
                _str_from_cache = i;
                return i;
            }
        }
        # Skip to next null terminator
        while (i < npos) { if (load8(S + 0xEC00000 + i) == 0) { i = i + 1; break; } i = i + 1; }
    }
    return 0 - 1;
}

# v6.3.7 — closure local-table isolation. A closure is its own fn but reuses the
# SHARED per-fn local tables (names 0x5D9D000 / depths 0x5DBD000 / types 0x5DDD000
# / slice-widths 0x5DFD000), starting at slot 0 after SFLC(0). Its params/locals
# therefore OVERWRITE the enclosing fn's locals at slots [0, closure_flc) — so an
# enclosing `var c0` shadowed by a later closure's `|x|` param became "undefined".
# Snapshot the enclosing range before the closure and restore it after, so the
# enclosing fn's locals survive. (n is the enclosing fn's GFLC at the closure site.)
# 6.6.10: a fifth segment, n BYTES at buf + n*32, carries the untyped-float flags (_lfi_base),
# so a closure's locals cannot leave the enclosing fn's `-c` warning wrong. CHANGELOG [6.6.10]
# 6.6.13: an 8-aligned trailer WORD after them (`_cl_snap_ps_off`) holds the enclosing fn's
# `_cur_fn_pslots`, read here because `_fnst_save` zeroes it right after. See `_cl_snap_is_sptr`.
# CHANGELOG [6.6.13]
fn _cl_snap_ps_off(n): i64 { return (n * 33 + 7) & (0 - 8); }
fn _cl_save_locals(S, n): i64 {
    if (n <= 0) { return 0; }
    var buf = alloc(_cl_snap_ps_off(n) + 8);
    S64(buf + _cl_snap_ps_off(n), _cur_fn_pslots);
    var i = 0;
    while (i < n) {
        S64(buf + i * 8,          L64(S + 0x5D9D000 + i * 8));
        S64(buf + n * 8 + i * 8,  L64(S + 0x5DBD000 + i * 8));
        S64(buf + n * 16 + i * 8, L64(S + 0x5DDD000 + i * 8));
        S64(buf + n * 24 + i * 8, L64(S + 0x5DFD000 + i * 8));
        i = i + 1;
    }
    _cl_lfi_copy(buf + n * 32, _lfi_base, n);
    return buf;
}
fn _cl_restore_locals(S, buf, n): i64 {
    if (n <= 0) { return 0; }
    var i = 0;
    while (i < n) {
        S64(S + 0x5D9D000 + i * 8, L64(buf + i * 8));
        S64(S + 0x5DBD000 + i * 8, L64(buf + n * 8 + i * 8));
        S64(S + 0x5DDD000 + i * 8, L64(buf + n * 16 + i * 8));
        S64(S + 0x5DFD000 + i * 8, L64(buf + n * 24 + i * 8));
        i = i + 1;
    }
    _cl_lfi_copy(_lfi_base, buf + n * 32, n);
    return 0;
}
fn _cl_lfi_copy(dst, src, n): i64 {
    if (_lfi_base == 0) { return 0; }
    var i = 0;
    while (i < n) { store8(dst + i, load8(src + i)); i = i + 1; }
    return 0;
}

# v6.3.8 — lexical-capture helpers. The enclosing-locals NAME snapshot is the
# first segment of the v6.3.7 snapshot buffer (buf[0..n)); `_cl_snap_find` returns
# the enclosing slot whose name matches `noff`, searching backward so an inner
# scope shadows an outer (same convention as FINDLOCAL). -1 if not an enclosing
# local.
fn _cl_snap_find(S, noff): i64 {
    if (_cl_snap == 0) { return 0 - 1; }
    # 6.6.17: the enclosing fn's locals first — one of them shadows a capture of the same name —
    # then the enclosing closure's captures (`_cl_snap_nl`).
    var r = _cl_snap_find_in(S, noff, 0, _cl_snap_nl);
    if (r < 0) { r = _cl_snap_find_in(S, noff, _cl_snap_nl, _cl_snap_n); }
    return r;
}
fn _cl_snap_find_in(S, noff, lo, hi): i64 {
    var i = hi - 1;
    while (i >= lo) {
        var sn = L64(_cl_snap + i * 8);
        if (sn >= 0) { if (STREQ(S, sn, noff) == 1) { return i; } }
        i = i - 1;
    }
    return 0 - 1;
}
# Capture index of enclosing slot `esl`, or -1 if not yet captured.
fn _cl_cap_find(esl): i64 {
    var i = 0;
    while (i < _cl_ncap) {
        if (L64(&_cl_cap_slots + i * 8) == esl) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# 6.6.5 — the enclosing slot's recorded metadata, read from the SNAPSHOT rather than the live
# tables: by the time the closure body is parsed the live slot tables hold the CLOSURE's own
# locals, so index `esl` no longer means the enclosing variable. `_cl_save_locals` lays the
# snapshot out as [names | depths | types | slice_widths], each `n` words.
fn _cl_snap_span(esl): i64 {
    if (_cl_snap == 0) { return 0; }
    return (L64(_cl_snap + _cl_snap_n * 8 + esl * 8) >> 32) & 0xFFFF;
}
# The enclosing slot's array ELEMENT descriptor (util.cyr GLAEW), from the same word. 6.6.12
fn _cl_snap_aew(esl): i64 {
    if (_cl_snap == 0) { return 0; }
    return (L64(_cl_snap + _cl_snap_n * 8 + esl * 8) >> 48) & 0xFF;
}
# The enclosing slot's `p: *T` mark (util.cyr GLPTRP, bit 56 of the same word). 6.6.17
fn _cl_snap_ptrp(esl): i64 {
    if (_cl_snap == 0) { return 0; }
    if (esl < 0) { return 0; }
    return (L64(_cl_snap + _cl_snap_n * 8 + esl * 8) >> 56) & 1;
}
fn _cl_snap_type(esl): i64 {
    if (_cl_snap == 0) { return 0; }
    return L64(_cl_snap + _cl_snap_n * 16 + esl * 8);
}
# 6.6.13 — 1 when enclosing slot `esl` is an ADDRESS-PASSED by-value struct parameter of the
# enclosing fn: its one captured word is the caller's struct's address, which a copy-init must
# copy THROUGH, where a pointer-mode local's word (`var a: Pt = mk();`, a Str handle) is rebound.
# The same discriminator as `_local_is_sptr_param` (parse_fn.cyr) — "slot below the enclosing
# fn's parameter span" — asked of the snapshot, whose trailer word carries that span.
# CHANGELOG [6.6.13]
fn _cl_snap_is_sptr(S, esl): i64 {
    if (_cl_snap == 0) { return 0; }
    if (esl < 0) { return 0; }
    # 6.6.17: an enclosing closure's capture carries the answer its own snapshot gave (bit 57 of
    # the entry's word, `_cl_snap_extend`) — the parameter span is that closure's, not the fn's.
    if (esl >= _cl_snap_nl) { return (L64(_cl_snap + _cl_snap_n * 8 + esl * 8) >> 57) & 1; }
    if (esl >= L64(_cl_snap + _cl_snap_ps_off(_cl_snap_n))) { return 0; }
    if (_cl_snap_span(esl) != 0) { return 0; }
    var t = _cl_snap_type(esl);
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }
    var sid = 0 - t;
    if (STRUCTSZ(S, sid - 1) <= 8) { return 0; }
    if (_classify_param_type(S, L64(S + 0x1A6018 + (sid - 1) * 8)) != 0) { return 0; }
    return 1;
}
# 6.6.17 — the step of enclosing slot `esl` when it is a typed pointer (`_slot_ptr_step`, read
# from the snapshot: bit 56 of its depth word, the mark in its slice-width word), else 0. A
# capture of one loaded with scale 0, so `p + 1` stepped 1 and `var q: *T = p;` warned.
fn _cl_snap_ptr_step(esl): i64 {
    if (_cl_snap == 0) { return 0; }
    if (((L64(_cl_snap + _cl_snap_n * 8 + esl * 8) >> 56) & 1) == 0) { return 0; }
    var w = L64(_cl_snap + _cl_snap_n * 24 + esl * 8);
    if (w <= 0 - 0x7E01) { return 0 - w - 0x7E00; }
    return 8;
}
# Word offset of capture `capi` inside the env object (slot 0 is the fn pointer).
fn _cl_cap_woff(capi): i64 {
    var off = 1;
    var i = 0;
    while (i < capi) {
        off = off + L64(&_cl_cap_w + i * 8);
        i = i + 1;
    }
    return off;
}
# rax = `&env[woff]` — the address of capture `capi`'s WORDS inside the env object. One
# definition, so the four sites that need it (the value read, `&name`, the field/method base
# in `_CL_CAP_BASE_RA`, and the operator-dispatch operand) cannot drift apart.
fn _CL_CAP_WORDS_RA(S, capi): i64 {
    EFLLOAD(S, _cl_env_lidx);
    EADDRA_IMM(S, _cl_cap_woff(capi) * 8);
    return 0;
}
# ⛔ 6.6.5 (review round 2) — A CAPTURED INLINE AGGREGATE DISPATCHES ITS OPERATOR OVERLOAD.
# Once `var a = Num{1}` became a frame local (this bite), `|x| a + x` inside a closure stopped
# going through the local rung below and reached the capture rung, which never called
# `SESTYPE` — so `a + x` compiled to an INTEGER ADD of the captured word and answered 2 where
# 102 is right. Worse than wrong: with `Num_add` DELETED the same source compiled clean, where
# 6.6.4 refused it as an undefined function. The span comes from the SNAPSHOT (the live slot
# tables hold the closure's own locals by now), and only a span-marked — i.e. inline —
# aggregate dispatches, exactly as the enclosing-local and global rungs decide it.
# CHANGELOG [6.6.5]
fn _CL_CAP_OPTYPE(S, esl, capi): i64 {
    var ps = _cl_snap_ptr_step(esl);   # 6.6.17: a captured typed pointer carries its step
    if (ps > 0) { SPSC(S, ps); return 0; }
    if (_cl_snap_span(esl) < 1) { return 0; }
    var t = _cl_snap_type(esl);
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }
    SESTYPE(S, 0 - t);
    if (L64(&_cl_cap_w + capi * 8) > 1) { SESVAR(S, 0 - 1000000 - capi); }
    return 0;
}
# Record enclosing slot `esl` as a capture (dedup); returns its capture index.
fn _cl_cap_add(S, esl): i64 {
    var c = _cl_cap_find(esl);
    if (c >= 0) { return c; }
    if (_cl_ncap >= 64) { return 0 - 1; }
    S64(&_cl_cap_slots + _cl_ncap * 8, esl);
    var w = _cl_snap_span(esl);
    if (w < 1) { w = 1; }
    S64(&_cl_cap_w + _cl_ncap * 8, w);
    var idx = _cl_ncap;
    _cl_ncap = _cl_ncap + 1;
    return idx;
}
fn _cl_shadow_add(S, noff): i64 {
    if (_cl_nshadow >= 64) { return 0; }
    S64(&_cl_shadow + _cl_nshadow * 8, noff);
    _cl_nshadow = _cl_nshadow + 1;
    return 0;
}
fn _cl_shadow_find(S, noff): i64 {
    var i = 0;
    while (i < _cl_nshadow) {
        if (STREQ(S, L64(&_cl_shadow + i * 8), noff) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# Pre-scan the closure body (cursor at the body start: `{` for a block, else the
# expression) to collect which enclosing locals it references as free variables.
# A free var is an identifier that is NOT a closure param/local (FINDLOCAL), NOT a
# body-local `var` (the shadow set), NOT a call name (`IDENT(`), and IS an
# enclosing local (in the snapshot). Restores the cursor; populates _cl_cap_slots
# + sets _cl_capturing. This runs BEFORE the closure prologue so the env-param
# decision (capturing → hidden arg0) can be made in one pass.
# 6.6.17: the walk covers every NESTED closure's body too, so a name a nested closure reads is
# captured here first and is there for it to capture in turn (`_cl_ctx_enter`).
fn _cl_prescan_captures(S, cl_zero): i64 {
    _cl_ncap = 0;
    _cl_nshadow = 0;
    var save_ti = GTI(S);
    # The pre-scan runs BEFORE the param loop registers the params, so the params
    # aren't in the live local table yet — seed the shadow set with them (closure
    # params are not free variables). The cursor enters at the first param.
    if (cl_zero == 0) {
        while (PEEKT(S) != 35) {
            if (PEEKT(S) == 12) { break; }
            if (PEEKT(S) == 2) { _cl_shadow_add(S, PEEKV(S)); }
            STI(S, GTI(S) + 1);
        }
        if (PEEKT(S) == 35) { STI(S, GTI(S) + 1); }   # consume closing |
    }
    var is_block = 0;
    if (PEEKT(S) == 13) { is_block = 1; STI(S, GTI(S) + 1); }
    _cl_prescan_body(S, is_block);
    STI(S, save_ti);
    _cl_capturing = 0;
    if (_cl_ncap > 0) { _cl_capturing = 1; }
    return 0;
}
# Walk one closure body from the cursor: a block body (`is_block` 1) to its closing `}`, an
# expression body (0) to the `;` / `,` / unmatched `)` `]` `}` that ends it, a parenthesised group
# (2, a `for` header) to its unmatched `)`; the cursor is left AT that token. Every `{` is walked
# as its own scope (`_cl_prescan_nested`).
# ⛔ 6.6.17 — A NESTED CLOSURE'S BLOCK BODY IS ITS OWN SCOPE. It is walked by a recursive call
# and the `var` names it declares leave the shadow set when it ends: they used to stay, so
# `|x| { var k = |y| { var b = y; return b; }; return b + x; }` stopped capturing the enclosing
# `b` the outer body reads. An expression body counts `{ }` as nesting too — a nested block
# body (`|x| |y| { var t = y; return t + b; }`) or a struct literal holds `;` / `,` that do not
# end the expression, and stopping there dropped every capture after it. CHANGELOG [6.6.17]
fn _cl_prescan_body(S, is_block): i64 {
    var depth = 0;
    var prev_var = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { go = 0; }
        elif (t == 13) {
            _cl_prescan_nested(S);             # any block is a scope (6.6.17)
            t = 0 - 1;                         # consumed through its `}`
        }
        elif (t == 14) { go = 0; }
        elif (t == 55) {
            if (TOKTYP(S, GTI(S) + 1) == 10) { _cl_prescan_for(S); t = 0 - 1; }
        }
        elif (is_block != 1) {
            if (t == 10 || t == 28) { depth = depth + 1; }
            elif (t == 11 || t == 29) { if (depth == 0) { go = 0; } else { depth = depth - 1; } }
            elif (t == 5 && depth == 0) { if (is_block == 0) { go = 0; } }
            elif (t == 31 && depth == 0) { if (is_block == 0) { go = 0; } }
        }
        if (go == 1) {
            if (t == 3) { prev_var = 1; }
            elif (t == 2) {
                var noff = PEEKV(S);
                if (prev_var == 1) { _cl_shadow_add(S, noff); prev_var = 0; }
                else { _cl_prescan_ident(S, noff); }
            }
            else { prev_var = 0; }
            if (t != 0 - 1) { STI(S, GTI(S) + 1); }
        }
    }
    return 0;
}
# Cursor at `for (`: the header's `var` and the loop body are one scope (the for statement's
# own SCOPE_PUSH) — walked with `is_block` 2 (a parenthesised group: only its `)` ends it), then
# the body block. Leaves the cursor past the body. CHANGELOG [6.6.17]
fn _cl_prescan_for(S): i64 {
    var mk = _cl_nshadow;
    STI(S, GTI(S) + 2);                  # `for (`
    _cl_prescan_body(S, 2);
    if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); }
    if (PEEKT(S) == 13) { _cl_prescan_nested(S); }
    _cl_nshadow = mk;
    return 0;
}
# Cursor at a block's `{` — a nested closure's body or any other block (6.6.17: a block's `var`
# shadows an enclosing name only inside it; it used to hide the name for the WHOLE closure
# body, so a read after the block took a GLOBAL of that name, silently): walk it, leave the
# cursor past its `}`, and drop the names it declared from the shadow set.
fn _cl_prescan_nested(S): i64 {
    var mk = _cl_nshadow;
    STI(S, GTI(S) + 1);
    _cl_prescan_body(S, 1);
    _cl_nshadow = mk;
    if (PEEKT(S) == 14) { STI(S, GTI(S) + 1); }
    return 0;
}
# One identifier read in a closure body: capture it when it is a free variable.
fn _cl_prescan_ident(S, noff): i64 {
    if (TOKTYP(S, GTI(S) + 1) == 10) { return 0; }   # a call name
    if (FINDLOCAL(S, noff) >= 0) { return 0; }
    if (_cl_shadow_find(S, noff) >= 0) { return 0; }
    var esl = _cl_snap_find(S, noff);
    if (esl >= 0) { _cl_cap_add(S, esl); }
    return 0;
}

# ⛔ 6.6.17 — A CLOSURE NESTED IN A CAPTURING CLOSURE CAPTURES THROUGH IT. The capture tables
# (`_cl_ncap`, `_cl_cap_slots`, `_cl_cap_w`) were one global set that a nested closure literal
# overwrote, and its snapshot held only the enclosing closure's own LOCALS. So the inner closure
# could not see a variable the outer one had captured (`fn mk(b) { |x| { |y| y + b } }` was
# refused `undefined variable 'b'`; the guide wrote it down as "captured closures are flat"),
# and the outer closure, once a nested one had been parsed, lost its own captures: it was
# refused the same way, and its env was sized from the INNER closure's list.
# Now each closure literal saves the enclosing CAPTURE CONTEXT as one block and puts it back
# after its own env is built, and its snapshot gets one extra entry per enclosing capture
# (`_cl_snap_nl` marks where they start). Capturing such an entry copies the word(s) out of the
# enclosing closure's env (`_cl_emit_cap_word`) — by value, at construction, like any capture.
# Block layout: [0] _cl_capturing, [8] _cl_env_lidx, [16] _cl_snap, [24] _cl_snap_n,
# [32] _cl_snap_nl, [40] _cl_ncap, then _cl_ncap slots, then _cl_ncap widths. CHANGELOG [6.6.17]
fn _cl_ctx_save(): i64 {
    var b = alloc(48 + _cl_ncap * 16);
    store64(b, _cl_capturing);
    store64(b + 8, _cl_env_lidx);
    store64(b + 16, _cl_snap);
    store64(b + 24, _cl_snap_n);
    store64(b + 32, _cl_snap_nl);
    store64(b + 40, _cl_ncap);
    var i = 0;
    while (i < _cl_ncap) {
        store64(b + 48 + i * 8, L64(&_cl_cap_slots + i * 8));
        store64(b + 48 + _cl_ncap * 8 + i * 8, L64(&_cl_cap_w + i * 8));
        i = i + 1;
    }
    return b;
}
fn _cl_ctx_restore(b): i64 {
    _cl_capturing = load64(b);
    _cl_env_lidx = load64(b + 8);
    _cl_snap = load64(b + 16);
    _cl_snap_n = load64(b + 24);
    _cl_snap_nl = load64(b + 32);
    _cl_ncap = load64(b + 40);
    var i = 0;
    while (i < _cl_ncap) {
        S64(&_cl_cap_slots + i * 8, load64(b + 48 + i * 8));
        S64(&_cl_cap_w + i * 8, load64(b + 48 + _cl_ncap * 8 + i * 8));
        i = i + 1;
    }
    return 0;
}
fn _cl_ctx_slot(b, i): i64 { return load64(b + 48 + i * 8); }
fn _cl_ctx_w(b, i): i64 { return load64(b + 48 + load64(b + 40) * 8 + i * 8); }
# Word offset of capture `capi` in the env a saved context describes (`_cl_cap_woff`'s twin).
fn _cl_ctx_woff(b, capi): i64 {
    var off = 1;
    var i = 0;
    while (i < capi) {
        off = off + _cl_ctx_w(b, i);
        i = i + 1;
    }
    return off;
}
# Enter a closure literal: save the enclosing capture context (returned, for `_cl_ctx_restore`)
# and install the closure's snapshot — the enclosing locals `locsnap` (n entries), extended by
# the enclosing closure's captures when it has any.
fn _cl_ctx_enter(S, locsnap, n): i64 {
    var b = _cl_ctx_save();
    var m = 0;
    if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) { m = _cl_ncap; } }
    var x = locsnap;
    if (m > 0) { x = _cl_snap_extend(S, locsnap, n, m); }
    _cl_snap = x;
    _cl_snap_n = n + m;
    _cl_snap_nl = n;
    return b;
}
# A copy of snapshot `ls` (n entries, `_cl_save_locals`' layout) with one entry appended per
# capture of the enclosing closure (m of them), each carrying the name and metadata of the slot
# it captured — read from the ENCLOSING snapshot, which is still installed. Depth 0; bit 57 of
# the word records `_cl_snap_is_sptr` (the parameter span it is judged by is not this one's).
fn _cl_snap_extend(S, ls, n, m): i64 {
    var t = n + m;
    var x = alloc(_cl_snap_ps_off(t) + 8);
    var i = 0;
    while (i < n) {
        _cl_snap_cp(x, t, i, ls, n, i);
        i = i + 1;
    }
    var j = 0;
    while (j < m) {
        var e = L64(&_cl_cap_slots + j * 8);
        _cl_snap_cp(x, t, n + j, _cl_snap, _cl_snap_n, e);
        var dw = L64(_cl_snap + _cl_snap_n * 8 + e * 8) & (0 - 4294967296);
        if (_cl_snap_is_sptr(S, e) == 1) { dw = dw | (1 << 57); }
        S64(x + t * 8 + (n + j) * 8, dw);
        j = j + 1;
    }
    if (n > 0) { S64(x + _cl_snap_ps_off(t), L64(ls + _cl_snap_ps_off(n))); }
    return x;
}
# Entry `si` of snapshot `src` (`sn` entries) into entry `i` of snapshot `x` (`t` entries).
fn _cl_snap_cp(x, t, i, src, sn, si): i64 {
    S64(x + i * 8, L64(src + si * 8));
    S64(x + t * 8 + i * 8, L64(src + sn * 8 + si * 8));
    S64(x + t * 16 + i * 8, L64(src + sn * 16 + si * 8));
    S64(x + t * 24 + i * 8, L64(src + sn * 24 + si * 8));
    store8(x + t * 32 + i, load8(src + sn * 32 + si));
    return 0;
}
# The env object of the closure just parsed: its size in bytes, and the copy of each capture's
# words into it (`ib` = that closure's saved context; the ENCLOSING context is live again).
fn _cl_env_bytes(ib): i64 { return _cl_ctx_woff(ib, load64(ib + 40)) * 8; }
fn _cl_emit_env_caps(S, obj_slot, ib): i64 {
    var nl = load64(ib + 32);
    var ci = 0;
    while (ci < load64(ib + 40)) {
        var w = _cl_ctx_w(ib, ci);
        var wo = _cl_ctx_woff(ib, ci);
        var base = _cl_ctx_slot(ib, ci);
        var k = 0;
        while (k < w) {
            EFLLOAD(S, obj_slot);
            EADDRA_IMM(S, (wo + k) * 8);   # rax = &env[woff+k] (dest)
            EPUSHR(S);
            _cl_emit_cap_word(S, base, nl, k);
            EPOPC(S);                      # rcx = dest
            ESTORE64(S);
            k = k + 1;
        }
        ci = ci + 1;
    }
    return 0;
}
# rax = word k of the captured slot `base`: an enclosing local's (6.6.5: word k of an inline
# aggregate lives at slot base - k), or — for an entry past `nl` — the enclosing closure's own
# capture `base - nl`, read from that closure's env.
fn _cl_emit_cap_word(S, base, nl, k): i64 {
    if (base < nl) { EFLLOAD(S, base - k); return 0; }
    _CL_CAP_WORDS_RA(S, base - nl);
    if (k > 0) { EADDRA_IMM(S, k * 8); }
    ELOAD64(S);
    return 0;
}

# v6.3.10 (F-structs/explicit): non-consuming lookahead from a `<` (token 19) at the
# current cursor. Returns 1 iff the `<...>` is a TYPE-ARGUMENT list immediately
# followed by `(` — i.e. the `foo<T,...>(` shape. Depth-tracks `<`/`>`; bails (→ 0,
# meaning "this is a comparison, not type-args") on `;`(5), `{`(13), or `(`(10) seen
# INSIDE the brackets (those mark a comparison like `a < foo()`). Bounded 64-token
# scan; never mutates GTI. The caller additionally gates on the flag + a generic-fn
# callee, so `a < b` and non-generic `<` are never misread.
fn LOOKAHEAD_IS_TYPE_ARG_CALL(S): i64 {
    var i = GTI(S);
    var n = GTCNT(S);
    var cap = i + 64;
    if (cap > n) { cap = n; }
    var depth = 0;
    while (i < cap) {
        var t = TOKTYP(S, i);
        if (t == 19) { depth = depth + 1; }
        elif (t == 20) {
            depth = depth - 1;
            if (depth == 0) {
                if (i + 1 < n) { if (TOKTYP(S, i + 1) == 10) { return 1; } }
                return 0;
            }
        } elif (t == 152) {
            # `>>>` (arith-shift lexeme) closes THREE type-arg levels (A<B<C<T>>>).
            depth = depth - 3;
            if (depth <= 0) {
                if (i + 1 < n) { if (TOKTYP(S, i + 1) == 10) { return 1; } }
                return 0;
            }
        } elif (t == 39) {
            # v6.3.33: `>>` (right-shift lexeme) closes TWO type-arg levels — the tail
            # of a nested `Outer<Inner<T>>`. If that lands us at (or past) depth 0, this
            # is a type-arg call iff a `(` follows; else it's a real `a < b >> c` shift.
            depth = depth - 2;
            if (depth <= 0) {
                if (i + 1 < n) { if (TOKTYP(S, i + 1) == 10) { return 1; } }
                return 0;
            }
        } elif (t == 5) { return 0; }
        elif (t == 13) { return 0; }
        elif (t == 10) { return 0; }
        i = i + 1;
    }
    return 0;
}

# v6.5.17 — how many arguments this target passes in registers. SysV and AAPCS64
# use six (cyrius's own subset of AAPCS64's eight); Win64 uses four. The closure
# ABI needs it in two places that MUST agree: the call site, which appends the
# hidden env argument only when it lands in a register, and the closure prologue,
# which reads it from that same index.
fn _ARG_REG_COUNT(): i64 {
    if (_TARGET_PE == 1) { return 4; }
    return 6;
}

# v6.5.17 — is `noff` the name `fncall0` … `fncall8`? Packed little-endian u64
# compare, the same 8-byte trick the `sizeof` / `mulh64` intrinsics use below:
# 'f','n','c','a','l','l' occupy the low 48 bits (0x6C6C61636E66), the ASCII digit
# sits at byte 6, and byte 7 must be NUL so `fncall2x` cannot match.
# v6.5.46 — the arity `fncallN` promises, or -1 for `callptr`, which is variadic BY DESIGN
# (its callee's arity is not knowable at the call site). Set immediately before PINDIRECT_CALL
# and cleared by it, so the check cannot leak into the callptr path.
var _fncall_expect = 0 - 1;

fn _IS_FNCALL_NAME(S, noff): i64 {
    var w = L64(S + 0xEC00000 + noff);
    if ((w & 0xFFFFFFFFFFFF) != 0x6C6C61636E66) { return 0; }
    if (((w >> 56) & 0xFF) != 0) { return 0; }
    var d = (w >> 48) & 0xFF;
    if (d < 48) { return 0; }
    if (d > 56) { return 0; }
    return 1;
}

# v6.5.17 — the shared indirect-call lowering behind BOTH `callptr(callee, …)` and
# `fncall0(callee)` … `fncall8(callee, …)`. The cursor enters just past the `(` and
# leaves just past the `)`; the callee's return lands in rax/x0 like any call.
#
# Evaluate the callee FIRST and spill it to a FRESH frame slot (re-entrant: nested
# indirect calls get distinct slots) so it survives ECALLPOPS — which on Win64
# `sub`s rsp for the 32 B shadow home and would bury a stack-pushed callee. Then
# push args, marshal, and call through the slot via ECALLIND (`call [rbp-disp]` /
# `ldur x6; blr x6`). The spill is a frame local, so the call needs a frame.
#
# ⛔ 6.6.16 — AT TOP LEVEL THE CALL BRINGS ITS OWN FRAME. Top-level code has none (its
# vars are globals; rbp / x29 / cx fp hold whatever the loader left), and this used to
# be answered two ways at once: `callptr` was refused ("must be inside a function"),
# while `fncallN` was simply NOT LOWERED there (both gates below were `_cur_fn_ix >= 0`)
# and fell through to lib/fnptr.cyr, whose asm calls the raw value. A capturing
# closure's value is its env object with bit 63 set, so every top-level fncallN on a
# closure that ESCAPED a fn (returned, stashed in a global, round-tripped through
# memory) jumped to a non-canonical address: SIGSEGV on x86_64/aarch64/Mach-O,
# 0xC0000005 on Windows, and on cx — where lib/fnptr.cyr has no arm — EVERY top-level
# fncallN returned 0, plain fn pointers included. Now `PINDIRECT_CALL` wraps a top-level
# call in a per-call-site MICRO-FRAME (`ETLFRAME_OPEN` / `ETLFRAME_CLOSE` in each
# backend), sized at the close from the slots the call actually used, so fncall0..8
# and callptr take the same closure-aware lowering everywhere. Inside a fn nothing
# changes: the wrapper calls `_PINDIRECT_CALL_IN` directly. See
# 2026-10-03-hisab-toplevel-fncall-capturing-closure-segv.md. CHANGELOG [6.6.16]
#
# RUNTIME CLOSURE DISPATCH. The spilled callee value is read TWICE: once through
# ECLENV for the hidden env argument, once through ECLNORM for the real code
# address. A capturing closure carries its heap env object with BIT 63 SET, so both
# reads answer correctly no matter where the value came from.
#
# This REPLACES a compile-time test (v6.3.8/v6.3.36) that peeked at the declaring
# local's CLOSURE_TYID SLTYPE. That test could only see a closure while it was still
# sitting in the `var` it was built in: pass it to a fn, return it, stash it in a
# global, round-trip it through store64/load64, or even copy it with `g = f` (as
# opposed to `var g = f`) and the tag was gone — so the value was dispatched as a
# bare fn pointer, i.e. a jump INTO the env object and a SIGSEGV on the NX heap,
# with no diagnostic. It was wrong in the other direction too: `callptr(f + 0, …)`
# still looked like a closure. See
# hisab-capturing-closure-segv-across-fn-boundary.md.
#
# THE ENV ARGUMENT IS ALWAYS PUSHED, AND ALWAYS LAST. Passing it last (rather than
# as the hidden FIRST arg it used to be) is what lets ONE marshalling sequence serve
# both cases: a plain fn pointer or non-capturing closure simply ignores one extra
# register argument, which every ABI we emit for (SysV, Win64, AAPCS64) permits
# because the CALLER cleans the argument area. Leading it would shift every user
# argument of every non-closure indirect call.
#
# THE TOP-LEVEL MICRO-FRAME. Slot numbering restarts at 0 inside it (nothing at top level
# lives in a frame slot — hidden temps there are globals, and every other frame-slot
# user refuses top level or is gated on GINFN), and the frame is sized from the larger
# of the final GFLC and the `_flc_hwm` high-water, because hidden temps and the inline
# replay release GFLC back down after use. Both are restored afterwards, so the
# enclosing top-level state is untouched; a nested top-level indirect call (one in
# another's arguments) opens its own frame inside this one. The result stays in
# rax / x0 / r0 across the close. Kept a SMALL separate fn with no tail call: cybs,
# which builds this file on the seed chain, has a per-fn reference ceiling.
fn PINDIRECT_CALL(S): i64 {
    if (_cur_fn_ix >= 0) { _PINDIRECT_CALL_IN(S); return 0; }
    var tl_flc = GFLC(S);
    var tl_hwm = _flc_hwm;
    SFLC(S, 0);
    _flc_hwm = 0;
    var tl_patch = ETLFRAME_OPEN(S);
    _PINDIRECT_CALL_IN(S);
    var tl_n = GFLC(S);
    if (_flc_hwm > tl_n) { tl_n = _flc_hwm; }
    ETLFRAME_CLOSE(S, tl_patch, tl_n);
    SFLC(S, tl_flc);
    _flc_hwm = tl_hwm;
    return 0;
}

fn _PINDIRECT_CALL_IN(S): i64 {
    PCMPE(S);                               # eval callee → rax
    var cp_v = GFLC(S);
    S64(S + 0x5D9D000 + cp_v * 8, 0 - 1);   # anonymous (stale-name guard)
    SLDEP(S, cp_v, 0);
    SFLC(S, cp_v + 1);
    EFLSTORE(S, cp_v);                      # spill the callee VALUE
    var cp_idx = 0;
    var cp_argc = 0;
    # v6.0.86: on PE the callee goes on the STACK (pushed FIRST, below the args),
    # NOT a frame slot — a GFLC slot could alias a `&`-taken local (the COM
    # out-param AV; see ECALLPTR_PE). Non-PE keeps the frame-slot spill (its
    # ECALLPOPS shadow would otherwise bury a stack-pushed callee).
    if (_TARGET_PE == 1) {
        EFLLOAD(S, cp_v);
        ECLNORM(S, cp_v);                   # rax = real code address
        EPUSHR(S);                          # push callee (consumed by ECALLPTR_PE)
    }
    while (PEEKT(S) == 31) {                # ',' → another arg
        STI(S, GTI(S) + 1);                 # consume ','
        PCMPE(S);                           # eval arg → rax
        EPUSHR(S);                          # push arg
        cp_argc = cp_argc + 1;
    }
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);                     # consume ')'
    # ⛔ v6.5.46 — THE `fncallN` FAMILY WAS EXEMPT FROM THE CALL-ARITY CHECK that ordinary calls
    # have enforced as a hard error since v6.5.1. `fncall3(f, a, b)` and `fncall1(f, a, b, c)`
    # both compiled: the name says how many arguments follow, `cp_argc` counts how many did, and
    # the two were never compared. The result is not a miscompile of correct code — it is the
    # ABSENCE of a diagnostic, so a caller that miscounts gets a callee reading an argument slot
    # nobody wrote (too few) or silently ignoring a value (too many), with no message either way.
    # ⚠ `callptr` is deliberately NOT checked: its callee is a runtime value whose arity the call
    # site cannot know. That is why the expectation is carried in `_fncall_expect` rather than
    # derived here — the two callers of this function want different rules.
    var _fe = _fncall_expect;
    _fncall_expect = 0 - 1;
    if (_fe >= 0) {
        if (cp_argc != _fe) {
            ERR_MSG(S, "fncallN argument count does not match the N in its name", 55);
        }
    }
    # The env rides in an argument REGISTER or not at all. Under SysV the caller
    # places stack arguments anchored on the LAST one (ECALLPOPS puts a_n at
    # [rsp+0]) and the callee reads them back the same way (ESTORESTACKPARM's
    # `si = nstack - 1 - (pidx - 6)`), so a trailing extra argument slides every
    # stack argument of an ordinary callee by 8 bytes. Measured, not reasoned:
    # `callptr(&nargs7, 1,2,3,4,5,6,21)` in tests/tcyr/codegen/callptr.tcyr returned
    # a code address instead of 42, because nargs7's 7th parameter read the env.
    # Below the register ceiling nothing moves, so the extra argument is free — and
    # a capturing closure that needs more parameters than that is rejected where it
    # is DEFINED (see the closure prologue), not silently miscompiled here.
    if (cp_argc < _ARG_REG_COUNT()) {
        EFLLOAD(S, cp_v);
        ECLENV(S);                          # rax = env pointer (no-op on a bare fn ptr)
        EPUSHR(S);                          # push the hidden env arg — LAST
        cp_argc = cp_argc + 1;
    }
    # v6.0.71: on PE/Win64, an indirect call can target a REAL Win64 callee (a COM
    # vtable method) whose aligned SSE spills need rsp ≡ 0 at the `call`. The generic
    # marshal+call below runs at cyrius's constant body alignment, which lands callees
    # at ≡ 0 entry (off by 8) — fine for cyrius callees (no SSE), fatal for real Win64
    # ones. ECALLPTR_PE force-aligns the call with an rbx-anchored `and rsp,-16` (the
    # kernel32-reroute pattern), so the callee is entered ABI-correct regardless of
    # caller alignment. See
    # 2026-06-05-windows-com-vtable-real-callee-frame-corruption.md.
    if (_TARGET_PE == 1) {
        # v6.4.26/v6.5.17: capturing and non-capturing callees share one path on PE —
        # cp_argc counts the user args PLUS the trailing env, and the already-
        # normalized code address was pushed as the callee (deepest).
        ECALLPTR_PE(S, cp_argc);            # pop args + pop callee (rax) + call rax
    } else {
        EFLLOAD(S, cp_v);
        ECLNORM(S, cp_v);                   # rax = real code address
        cp_idx = GFLC(S);                   # fresh frame slot for the callee ptr
        S64(S + 0x5D9D000 + cp_idx * 8, 0 - 1);   # anonymous (stale-name guard)
        SLDEP(S, cp_idx, 0);
        SFLC(S, cp_idx + 1);
        EFLSTORE(S, cp_idx);                # spill callee → [rbp-disp(cp_idx)]
        ECALLPOPS(S, cp_argc);              # marshal args into arg regs (+ Win64 shadow)
        ECALLIND(S, cp_idx);                # load callee from the slot + call/blr
        ECALLCLEAN(S, cp_argc);             # unwind the arg frame
    }
    _cfo = 0;
    return 0;
}

# v6.6.5 — the Windows MONOTONIC-clock reroutes, 0xF038 QueryPerformanceCounter and
# 0xF039 QueryPerformanceFrequency, both `BOOL f(LARGE_INTEGER*)` → argc==2.
#
# ⚠ THEY LIVE IN THEIR OWN FUNCTION ON PURPOSE. The PE reroute chain inside
# `_PARSE_FACTOR_IMPL` is the longest one in this file, and **cybs** — the hand-assembly
# bootstrap compiler the 29 KB seed assembles, which must compile this file on the way to
# cycc — fails SILENTLY past its per-function limit on global and call references. Adding
# two more inline arms there risks losing the seed→cybs→cycc chain, which is days of
# repair; one call ref does not. Returns 1 if it routed.
#
# The var-number switch (`EPE_SYSCALL_DYNAMIC`) is deliberately NOT extended for these:
# every caller spells the number as a literal (lib/syscalls_windows.cyr's `sys_qpc`/
# `sys_qpf`, and lib/chrono.cyr's `_chrono_qpc_ns` / lib/bench.cyr's `_bench_qpc_ns`,
# which spell them raw to stay self-sufficient), and a non-literal number degrades to an
# honest -38/-ENOSYS. ⚠ WITHOUT a compile-time warning at argc 2: the var-number warning
# fires only for an arity with NO routable member, and argc 2 has several (the value is
# known only at run time). Corrected 6.6.9; the claim that stood here said it warned.
fn _PE_ROUTE_PERFCOUNTER(S, sc_num, argc): i64 {
    if (argc != 2) { return 0; }
    if (sc_num == 61496) { EQPC_PE(S); return 1; }
    if (sc_num == 61497) { EQPF_PE(S); return 1; }
    return 0;
}

# v6.6.8 — the arity each Mach-O PARSE-TIME reroute fires at, or 0 if `n` is not one. `argc`
# counts the number itself, as the reroute blocks in the syscall() parse do: 228 (clock) and 35
# (nanosleep) at 3, 1700 (pthread_create, arm64 only) at 5, and 1701 (libSystem fork, arm64
# only; 6.6.13) at 1. MUST mirror those blocks; the
# Darwin syscall gate probes every in-tree literal site at its real argc through this diagnostic.
# 6.6.10: 35 on BOTH backends. arm64 reroutes it inside ESYSXLAT (EMACHO_NANOSLEEP_ARM), which
# used to fire at ANY arity — at argc 1 it dereferenced x0 = the number (SIGSEGV, no warning) —
# and now fires at argc 3 only, so every other arity is SIGSYS, as on x86-macOS and PE.
fn _macho_reroute_argc(tgt, n): i64 {
    if (n == 228) { return 3; }
    if (n == 35) { return 3; }
    if (tgt == 2) { if (n == 1700) { return 5; } }
    if (tgt == 2) { if (n == 1701) { return 1; } }
    return 0;
}

# 6.6.10 — the MINIMUM arity of the Mach-O pipe emulations, or 0. Darwin pipe returns both fds in
# registers and the backend stores them through the caller's fds pointer, so a call that passes
# no pointer (argc 1) has nothing to store through: the backend now emits no row for it
# (x86 `_msx_short`, arm64 `_esx_short`) and the call is SIGSYS. Before, x86-macOS stored the
# fds through a STALE rdi — a silent 8-byte write — and arm64-macOS through x0 = 59 (SIGSEGV).
# pipe is 22 on the x86 peer and pipe2 59 on the aarch64 peer.
fn _macho_min_argc(tgt, n): i64 {
    if (tgt == 1) { if (n == 22) { return 2; } }
    if (tgt == 2) { if (n == 59) { return 2; } }
    return 0;
}

# Warns and returns 1 when `sc_num` is below its Mach-O emulation's minimum arity. Its own fn so
# _macho_warn_unrouted does not grow past cybs's per-function reference limit. CHANGELOG [6.6.10]
fn _macho_warn_short(sc_num, argc): i64 {
    var need = _macho_min_argc(_TARGET_MACHO, sc_num);
    if (need == 0) { return 0; }
    if (argc >= need) { return 0; }
    syscall(SYS_WRITE, 2, "warning: syscall ", 17);
    PRNUM(sc_num);
    syscall(SYS_WRITE, 2, " not routed at this arity: its Mach-O emulation stores through a pointer argument and this call passes none; it will SIGSYS on macOS. Pass the fds buffer, or use the stdlib wrapper.\n", 182);
    return 1;
}

# 6.6.10 — the PE "unrouted literal syscall" warning names the NUMBER and the SITE. It was one
# 1,471-byte line naming neither, so the warnings left in a PE compiler build could not be
# attributed to a call. The cursor is past the call's `)`; walk back over the balanced
# parentheses to its `syscall` token so the site is the call, not the `;` after it. The
# routed-number list is a note printed ONCE per compile, not once per site.
var _pe_unrouted_noted = 0;
fn _pe_warn_unrouted(S, sc_num, argc): i64 {
    var ti = GTI(S) - 1;
    var depth = 0;
    while (ti > 0) {
        var t = TOKTYP(S, ti);
        if (t == 11) { depth = depth + 1; }
        if (t == 10) {
            depth = depth - 1;
            if (depth == 0) { break; }
        }
        ti = ti - 1;
    }
    if (ti > 0) { ti = ti - 1; }
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": syscall ", 10);
    PRNUM(sc_num);
    syscall(SYS_WRITE, 2, " with ", 6);
    PRNUM(argc - 1);
    syscall(SYS_WRITE, 2, " argument(s) is not routed on CYRIUS_TARGET_WIN=1; it returns -38 (-ENOSYS) on Windows. Guard the call with #ifdef CYRIUS_TARGET_WIN, use the stdlib wrapper, or add a PE reroute.\n", 179);
    if (_pe_unrouted_noted == 1) { return 0; }
    _pe_unrouted_noted = 1;
    syscall(SYS_WRITE, 2,
      "  note: CYRIUS_TARGET_WIN=1 routes, each at its own arity, n=0,1,2,3,8,9,35,60,74,75,83,87,228 + 0xF001-0xF005 (process creation) + 0xF006 (cmdline) + 0xF007-0xF00A (threading) + 0xF00B-0xF00E (thread-local) + 0xF00F (sleep) + 0xF010-0xF011 (CommandLineToArgvW/LocalFree) + 0xF012 (CreateDXGIFactory1) + 0xF013-0xF015 (GetModuleHandleA/GetProcAddress/GetEnvironmentVariableA) + 0xF016-0xF019 (FindFirstFileW/FindNextFileW/FindClose/GetFileAttributesW) + 0xF01A (ProcessPrng CSPRNG) + 0xF01B (GetSystemTimeAsFileTime) + 0xF01C (GetCurrentProcessId) + 0xF01D (TerminateProcess) + 0xF01E (WSAStartup) + 0xF01F-0xF021 (IOCP: CreateIoCompletionPort/GetQueuedCompletionStatus/PostQueuedCompletionStatus) + 0xF022-0xF02C (ws2_32: WSASocketW/closesocket/WSAGetLastError/bind/getsockopt/WSAIoctl/connect/WSARecv/WSASend/getaddrinfo/freeaddrinfo) + 0xF02D-0xF032 (kernel32/ws2_32: RegisterWaitForSingleObject/CreateWaitableTimerW/SetWaitableTimer/UnregisterWaitEx/CancelIoEx/setsockopt) + 0xF033 (ws2_32: listen) + 0xF034 (kernel32: MoveFileExW) + 0xF035 (kernel32: DeleteFileW) + 0xF036-0xF037 (ws2_32: getpeername/getsockname) + 0xF038-0xF039 (kernel32: QueryPerformanceCounter/QueryPerformanceFrequency) + 0xF03A-0xF03B (kernel32: GetModuleFileNameW/RemoveDirectoryW) + 0xF03D-0xF03F (kernel32: GetFileInformationByHandleEx/CreateSymbolicLinkW/SetEndOfFile) + 0xF040-0xF044 (kernel32: CreateJobObjectW/AssignProcessToJobObject/TerminateJobObject/ResumeThread/SetInformationJobObject) + 0xF045-0xF04A (ws2_32: accept/shutdown/send/recv/ioctlsocket/WSAPoll) + 0xF04B (kernel32: GetLastError).\n",
      1584);
    return 0;
}

# The Mach-O "syscall not routed" diagnostic — both backends, one source of truth each
# (_macho_x86_routes replays EMACHO_SYSXLAT's rows, _macho_arm_routes replays ESYSXLAT's).
# ⛔ v6.6.8 — IT WAS BLIND TO ARITY. The route queries answer by NUMBER, but the parse-time
# reroutes (228/35 on x86-macOS, 228/1700 on arm64-macOS) fire only at one argc, so a
# wrong-arity `syscall(228, id)` or `syscall(35, &ts)` was neither rerouted NOR warned: it fell
# through to the chain and faulted at run time from a clean build. Such a call is now reported
# with the arity the reroute wants. Also since v6.6.8 the arm64 wording says SIGSYS, which it
# now is — ESYSXLAT's chain head defaults x16 to an invalid number; before that an unrouted
# arm64 number silently re-ran the previous syscall and "will fault" was false.
# v6.5.43: the x86 Mach-O half. _TARGET_MACHO==1 had NO unrouted diagnostic at all, so a
# missing _msx row was silent at compile time and a SIGSYS at runtime — the shape that let
# `ioctl` sit unrouted until v6.5.36 and that macho_route_parity.sh exists to catch.
fn _macho_warn_unrouted(sc_num, argc): i64 {
    if (sc_num < 0) { return 0; }
    if (_TARGET_MACHO != 1) { if (_TARGET_MACHO != 2) { return 0; } }
    var shw = _macho_warn_short(sc_num, argc);
    if (shw == 1) { return 0; }
    var want = _macho_reroute_argc(_TARGET_MACHO, sc_num);
    if (want > 0) {
        if (argc != want) {
            syscall(SYS_WRITE, 2, "warning: syscall ", 17);
            PRNUM(sc_num);
            syscall(SYS_WRITE, 2, " not routed at this arity: its Mach-O reroute takes the number plus ", 68);
            PRNUM(want - 1);
            syscall(SYS_WRITE, 2, " argument(s) and this call passes ", 34);
            PRNUM(argc - 1);
            syscall(SYS_WRITE, 2, "; it will SIGSYS on macOS. Pass the full argument list, or use the stdlib wrapper.\n", 83);
            return 0;
        }
    }
    if (_TARGET_MACHO == 1) {
        var sx_ok = _macho_x86_routes(sc_num);
        if (sx_ok == 0) {
            syscall(SYS_WRITE, 2, "warning: syscall ", 17);
            PRNUM(sc_num);
            syscall(SYS_WRITE, 2,
              " not routed by the Mach-O x86 translation (EMACHO_SYSXLAT); will SIGSYS on macOS. Add an _msx row or use a stdlib wrapper.\n",
              123);
        }
    }
    if (_TARGET_MACHO == 2) {
        # v6.0.65: query the single source of truth (_macho_arm_routes, adjacent to ESYSXLAT)
        # instead of a parallel hardcoded list that drifted out of sync.
        var sc_ok = _macho_arm_routes(sc_num);
        if (sc_ok == 0) {
            # v6.5.43: NAME the number. This warned 470 times during cycc's own build and never
            # once said which syscall — so it read as noise and was scrolled past.
            syscall(SYS_WRITE, 2, "warning: syscall ", 17);
            PRNUM(sc_num);
            syscall(SYS_WRITE, 2,
              " not routed by the Mach-O ARM translation (ESYSXLAT/__got); will SIGSYS on macOS. Add an ESYSXLAT entry or use a stdlib wrapper.\n",
              129);
        }
    }
    return 0;
}

# v6.6.6 — 0xF03A GetModuleFileNameW(NULL, wbuf, cch) → argc == 3. The Windows source
# for "the full path of THIS executable"; the cyrius-side wrapper is `sys_self_exe_w`
# (lib/syscalls_windows.cyr), whose caller narrows the UTF-16 result with `_args_w2u8`.
# Its own function for the same reason as _PE_ROUTE_PERFCOUNTER above — the inline PE
# chain in `_PARSE_FACTOR_IMPL` is already near cybs's per-function global/call-reference
# limit, past which cybs fails SILENTLY and the seed→cybs→cycc chain is lost. Returns 1
# if it routed. Literal-only, like the perfcounter pair: the one caller spells the number
# as a literal, and a non-literal degrades to an honest -38 with a warning.
fn _PE_ROUTE_MODULEPATH(S, sc_num, argc): i64 {
    if (argc != 3) { return 0; }
    if (sc_num == 61498) { EGETMODFILENAME_PE(S); return 1; }
    return 0;
}

# v6.6.7 — Linux fsync (74) / fdatasync (75), argc == 2 → kernel32!FlushFileBuffers
# (EFLUSHFB_PE). The LINUX numbers are routed, not a new 0xF0xx id — the precedent of
# 83 → CreateDirectoryW and 87 → DeleteFileW — so every caller that already spells
# `syscall(SYS_FSYNC/SYS_FDATASYNC, fd)` (the vendored patra fold's raw fdatasync, which
# was a loud -38 on Windows) flushes with no source change, and the Windows peer can
# define sys_fsync/sys_fdatasync the way every other peer does. Windows has one flush for
# data + metadata, so both numbers make the same call. Its own function for the cybs
# per-function reference limit (see _PE_ROUTE_PERFCOUNTER). A number held in a var reaches
# EPE_SYSCALL_DYNAMIC's argc-2 switch (`_pe_dyn_arity2`), which routes 74/75 the same way
# since 6.6.9 — before that it carried 3/60/87 only, so `var n = 74; syscall(n, fd)` got
# -38 with no warning while the literal flushed. CHANGELOG [6.6.7], [6.6.9]
fn _PE_ROUTE_FLUSH(S, sc_num, argc): i64 {
    if (argc == 2) {
        if (sc_num == 74) { EFLUSHFB_PE(S); return 1; }
        if (sc_num == 75) { EFLUSHFB_PE(S); return 1; }
    }
    # 6.6.9: the file-handle table is reached THROUGH this helper, so the inline chain in
    # `_PARSE_FACTOR_IMPL` gains no reference (see _PE_ROUTE_PERFCOUNTER on the cybs limit).
    # Held in a var, not `return f(...)`: cybs miscompiles a tail call silently.
    var fh = _PE_ROUTE_FILEHANDLE(S, sc_num, argc);
    return fh;
}

# 6.6.9 — the reroutes behind POSIX open semantics on PE (lib/syscalls_windows.cyr):
#   0xF03D GetFileInformationByHandleEx(h, class, buf, size) → argc 5 — sys_open's verify of
#          the OPENED handle (name-surrogate reparse point → -ELOOP, O_DIRECTORY on a file →
#          -ENOTDIR);
#   0xF03E CreateSymbolicLinkW(wlink, wtarget, flags) → argc 4 — sys_symlink / xsymlink;
#   0xF03F SetEndOfFile(h) → argc 2 — O_TRUNC|O_NOFOLLOW truncates only after the verify, and
#          sys_ftruncate.
# Literal-only, like every 0xF0xx id: a number held in a var reaches EPE_SYSCALL_DYNAMIC,
# which routes Linux numbers only and returns -38 for anything else. CHANGELOG [6.6.9]
fn _PE_ROUTE_FILEHANDLE(S, sc_num, argc): i64 {
    if (sc_num == 61501) { if (argc == 5) { EGETFINFO_PE(S); return 1; } }
    if (sc_num == 61502) { if (argc == 4) { ESYMLINKW_PE(S); return 1; } }
    if (sc_num == 61503) { if (argc == 2) { ESETEOF_PE(S); return 1; } }
    # 6.6.10: the Job-object table is reached THROUGH this helper, so the inline chain in
    # `_PARSE_FACTOR_IMPL` gains no reference (cybs's per-function limit — see
    # _PE_ROUTE_PERFCOUNTER). Held in a var, not `return f(...)`: cybs miscompiles a tail call.
    var jb = _PE_ROUTE_JOB(S, sc_num, argc);
    return jb;
}

# 6.6.10 — the reroutes behind a Windows process TREE (lib/process_win.cyr, lib/async_win.cyr,
# cbt's `_win_run_timed`): a child starts CREATE_SUSPENDED, joins a KILL_ON_JOB_CLOSE Job
# object, then resumes, and a deadline ends the job — before, it could TerminateProcess the
# direct child only, so a grandchild holding the capture pipe outlived the bound.
#   0xF040 CreateJobObjectW(attrs, name)             → argc 3
#   0xF041 AssignProcessToJobObject(job, hProcess)   → argc 3
#   0xF042 TerminateJobObject(job, code)             → argc 3
#   0xF043 ResumeThread(hThread)                     → argc 2
#   0xF044 SetInformationJobObject(job, class, info, len) → argc 5
# Literal-only, like every 0xF0xx id. The emitters are ECREATEJOB_PE … ESETJOBINFO_PE
# (x86/emit.cyr; stubs on the aarch64 and cx backends). CHANGELOG [6.6.10]
fn _PE_ROUTE_JOB(S, sc_num, argc): i64 {
    if (sc_num == 61504) { if (argc == 3) { ECREATEJOB_PE(S); return 1; } }
    if (sc_num == 61505) { if (argc == 3) { EASSIGNJOB_PE(S); return 1; } }
    if (sc_num == 61506) { if (argc == 3) { ETERMJOB_PE(S); return 1; } }
    if (sc_num == 61507) { if (argc == 2) { ERESUMETHREAD_PE(S); return 1; } }
    if (sc_num == 61508) { if (argc == 5) { ESETJOBINFO_PE(S); return 1; } }
    # 6.6.11: the ws2_32 socket table is reached THROUGH this helper, so the inline chain in
    # `_PARSE_FACTOR_IMPL` gains no reference (cybs's per-function limit — see
    # _PE_ROUTE_PERFCOUNTER). Held in a var, not `return f(...)`: cybs miscompiles a tail call.
    var sk = _PE_ROUTE_SOCK(S, sc_num, argc);
    return sk;
}

# 6.6.11 — the blocking ws2_32 verbs behind lib/net.cyr's PE arms (before them every net.cyr
# socket verb returned -38 on Windows, so http_* and sandhi's v4 path could not work):
#   0xF045 accept(s, addr, addrlen)       → argc 4
#   0xF046 shutdown(s, how)               → argc 3
#   0xF047 send(s, buf, len, flags)       → argc 5
#   0xF048 recv(s, buf, len, flags)       → argc 5
#   0xF049 ioctlsocket(s, cmd, argp)      → argc 4
#   0xF04A WSAPoll(fds, nfds, timeout)    → argc 4
# Literal-only, like every 0xF0xx id. The emitters are EACCEPT_PE … EWSAPOLL_PE
# (x86/emit.cyr; stubs on the aarch64 and cx backends). CHANGELOG [6.6.11]
fn _PE_ROUTE_SOCK(S, sc_num, argc): i64 {
    if (sc_num == 61509) { if (argc == 4) { EACCEPT_PE(S); return 1; } }
    if (sc_num == 61510) { if (argc == 3) { ESHUTDOWN_PE(S); return 1; } }
    if (sc_num == 61511) { if (argc == 5) { ESEND_PE(S); return 1; } }
    if (sc_num == 61512) { if (argc == 5) { ERECV_PE(S); return 1; } }
    if (sc_num == 61513) { if (argc == 4) { EIOCTLSOCK_PE(S); return 1; } }
    if (sc_num == 61514) { if (argc == 4) { EWSAPOLL_PE(S); return 1; } }
    # 6.6.12: 0xF04B kernel32!GetLastError() → argc 1, the kernel32 peer of 0xF024 (lib/fs_win.cyr
    # reads it after FindNextFileW returns 0). Routed HERE, at the end of the chain, so the inline
    # chain in `_PARSE_FACTOR_IMPL` gains no reference (cybs's per-function limit). CHANGELOG [6.6.12]
    if (sc_num == 61515) { if (argc == 1) { EGETLASTERR_PE(S); return 1; } }
    return 0;
}

# v6.5.19 (CVE-40): the bottom expression tier, and the last of the five chokepoints.
# Unary `-` recurses HERE, not in PARSE_TERM — `- - - … 1` compiled fine at 1024 with the
# PEXPR and PARSE_TERM bounds in place and still SIGSEGV'd at 16384, because a unary
# operand descends straight back into this tier. Guarding PEXPR/PARSE_TERM/PARSE_FACTOR
# together covers the whole expression ladder named in this file's header comment.
# See _rd_enter (src/common/util.cyr).
# 6.6.10 — WHAT `await e` YIELDS INSIDE A COROUTINE. The suspend used to keep nothing: the
# operand was evaluated, the state stamped, and at the landing rax held whatever the resume
# dispatch left there — C[state], the suspend INDEX. `var s = await five();` x3 returned 123 for
# 555, and `var v = await inner(a);` never ran inner's body at all.
# The operand now goes to a coroutine-frame word (which survives the suspend) and the landing
# reloads it. What the landing does with it depends on the operand's SHAPE:
#   * a call to an `async fn` (`await inner(a)`), or a bare variable (`await F` — the operand of
#     `await` is a Future by definition, as it is outside a coroutine): FORCE it with
#     future_force, and while it is a coroutine Future that has not completed (future_pending),
#     suspend again at the same point, so a nested coroutine is driven to its value;
#   * anything else — a call to a plain fn, the park idiom `await async_wait_fd(rt, fd)`: the
#     operand's own value.
# Pass 1 marks every `async fn` (`_prescan_fn_sig`), so a callee defined later still classifies.
# The shape test looks through balanced enclosing parentheses: `await (inner(a))` is the same
# operand as `await inner(a)` and forces too (it yielded the raw Future pointer). Any OTHER road
# to a Future — a field, `vec_get`, an index — is "anything else": bind it to a variable first.
fn _await_operand_is_future(S, ti0): i64 {
    var te = GTI(S);
    while (_await_paren_wraps(S, ti0, te) == 1) {
        ti0 = ti0 + 1;
        te = te - 1;
    }
    if (TOKTYP(S, ti0) != 2) { return 0; }
    if (te == ti0 + 1) { return 1; }                      # a bare variable
    if (TOKTYP(S, ti0 + 1) != 10) { return 0; }           # not `name(`
    if (TOKTYP(S, te - 1) != 11) { return 0; }            # the factor is more than the call
    if (_await_paren_wraps(S, ti0 + 1, te) == 0) { return 0; }   # `f(a)(b)`, `f(a).x`
    var fi = FINDFN(S, TOKVAL(S, ti0));
    if (fi < 0) { return 0; }
    return GFAS(S, fi);
}
# 1 when the token at `ti` is a `(` whose matching `)` is the last token before `te`.
fn _await_paren_wraps(S, ti, te): i64 {
    if (te - ti < 2) { return 0; }
    if (TOKTYP(S, ti) != 10) { return 0; }
    var depth = 0;
    var i = ti;
    while (i < te) {
        var t = TOKTYP(S, i);
        if (t == 10) { depth = depth + 1; }
        if (t == 11) {
            depth = depth - 1;
            if (depth == 0) {
                if (i == te - 1) { return 1; }
                return 0;
            }
        }
        i = i + 1;
    }
    return 0;
}
# The suspend and its landing. rax = the operand on entry; rax = the `await` value on exit.
# ⛔ THE EXPRESSION STACK DOES NOT SURVIVE A SUSPEND. The suspend returns through the fn end and
# the resume re-enters from the top, so every word the enclosing expression had pushed before
# the await was reached — `b` in `b + await f()`, `1000` in `add(1000, await f())`, the address
# in `store64(m + 8, await f())` — was gone at the landing, and the parser's pending pop took
# whatever sat at the new rsp: `b + await five()` gave 5, and the store64 form SIGSEGV'd.
# `_xdepth` is exact on the x86 family, the only one with a coroutine frame (parse_fn.cyr
# refuses aarch64 and cx), so those `_xdepth` words are popped into coroutine-frame words
# before the suspend and pushed back, in order, at the landing. CHANGELOG [6.6.10]
fn _await_coro_suspend(S, sk, fut): i64 {
    var ff = 0;
    var fpend = 0;
    if (fut == 1) {
        ff = _FINDFN_CSTR(S, "future_force", 12);
        fpend = _FINDFN_CSTR(S, "future_pending", 14);
        if (ff < 0 || fpend < 0) {
            ERR_MSG(S, "await needs include \"lib/async.cyr\" for future_force and future_pending", 71);
            return 0;
        }
    }
    var slot = _HTEMP(S);                 # a coroutine-frame word: it survives the suspend
    EFLSTORE(S, slot);
    var d = _xdepth;                      # the enclosing expression's pending pushes
    var s0 = _await_spill(S, d);
    EFLLOAD(S, _coro_base);               # rax = C (slot < _coro_lo: the stack path)
    EADDRA_IMM(S, _CORO_STATE_OFF);
    EPUSHR(S);
    EMOVI(S, sk);
    EPOPC(S);
    ESTORE64(S);                          # C[state] = sk
    var again = GCP(S);                   # a still-pending coroutine Future suspends from here
    EMOVI(S, 0);                          # a suspended task returns 0
    _coro_suspend_jmp(S, sk);             # jump to the fn end, past the defer walker (6.6.7)
    S64(&_coro_rcp + sk * 8, GCP(S));     # the resume label for state sk
    _coro_nsusp = sk;
    var vslot = slot;
    if (fut == 1) { vslot = _await_coro_force(S, slot, ff, fpend, again); }
    _await_unspill(S, s0, d);
    EFLLOAD(S, vslot);
    return 0;
}
# Pop `d` pending expression words into consecutive fresh coroutine-frame words (top of stack
# first); returns the first word's slot. The landing's `_await_unspill` pushes them back.
fn _await_spill(S, d): i64 {
    var s0 = 0;
    var i = 0;
    while (i < d) {
        var s = _HTEMP(S);
        if (i == 0) { s0 = s; }
        EPOPR(S);
        EFLSTORE(S, s);
        i = i + 1;
    }
    return s0;
}
fn _await_unspill(S, s0, d): i64 {
    var i = d;
    while (i > 0) {
        i = i - 1;
        EFLLOAD(S, s0 + i);
        EPUSHR(S);
    }
    return 0;
}
# The landing of a Future operand: force it, and while it is a coroutine Future that has not
# completed, suspend again from `again`. Returns the slot holding the forced value.
fn _await_coro_force(S, slot, ff, fpend, again): i64 {
    EFLLOAD(S, slot);
    _await_call1(S, ff);                  # rax = future_force(operand)
    var vslot = _HTEMP(S);
    EFLSTORE(S, vslot);
    EFLLOAD(S, slot);
    _await_call1(S, fpend);               # rax = future_pending(operand)
    EPUSHR(S);
    EMOVI(S, 0);
    EPOPC(S);
    ECMPR(S);
    var done = EJCC(S, 0x84);             # je -> completed
    EJMP(S, again);
    EPATCH(S, done);
    return vslot;
}
fn _await_call1(S, fi): i64 {
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, fi);
    ECALLCLEAN(S, 1);
    return 0;
}

fn PARSE_FACTOR(S): i64 {
    _rd_enter(S);
    var _xd0 = _xdepth;
    var _xt0 = PEEKT(S);
    var _ti0 = GTI(S);
    var _rc = _PARSE_FACTOR_IMPL(S);
    _call_scale_fix(S, _ti0);   # 6.6.17: a call's result scales by its declared return only
    _rd_exit();
    # 6.6.5 — `syscall(…)` (token 24) is stack-NEUTRAL by construction: it pushes its
    # arguments and every backend's emitter consumes exactly those, leaving the result in
    # rax. But the PE reroutes consume them with RAW pops, and `EPE_SYSCALL_DYNAMIC` emits
    # several MUTUALLY-EXCLUSIVE arms over the SAME pushed args — a linear counter cannot
    # follow that, and pretending otherwise would make every reroute frame parity wrong.
    # So the one construct whose net effect is known exactly is re-synced from the outside,
    # here, rather than at the ~20 early returns inside the builtin. See `_xdepth`.
    if (_xt0 == 24) { _xdepth = _xd0; }
    _xd_check(S, _xd0, "expression factor");
    return _rc;
}

# Unary minus on an f32 value (bits in the low 32 of rax, the pushed 0 still on the stack):
# flip bit 31. Composed from the generic emitters so every backend has it. CHANGELOG [6.6.8]
fn _NEG_F32(S): i64 {
    EPOPC(S);
    EPUSHR(S);
    EMOVI(S, 0x80000000);
    EMOVCA(S);
    EPOPR(S);
    EXORR(S);
    return 0;
}

# _NEG_INTRIN_KIND — 1 when token `t` is a builtin whose RESULT is a scalar f64, 2 when it is
# a scalar f32 bit pattern, else 0. Those builtins inherit their ARGUMENT's estype (the
# i64-boxed idiom leaves it 0), so GESTYPE alone negated `-f64_exp(u)` as an integer (-4.0 for
# -1.0). The compiler knows these calls return a float, whatever the argument was typed.
# f64_to/eq/lt/gt return integers and are absent. Since 6.6.10 it drives the float-builtin
# RESULT flag (PARSE_INTRIN, _FBR_MARK), which unary minus reads through _FBR_ST.
# Kept a flat compare chain: cybs compiles this file. CHANGELOG [6.6.8] [6.6.10]
fn _NEG_INTRIN_KIND(t): i64 {
    if (t >= 62) { if (t <= 66) { return 1; } }     # f64_add/sub/mul/div, f64_from
    if (t == 71) { return 1; }                       # f64_neg
    if (t >= 80) { if (t <= 88) { return 1; } }     # f64_abs..f64_exp2
    if (t == 92) { return 1; }                       # f64_round
    if (t == 99) { return 1; }                       # f64_atan
    if (t == 128) { return 1; }                      # f64v_dot
    if (t == 132) { return 1; }                      # f32_to
    if (t == 136) { return 1; }                      # f64_sqrt
    if (t == 159) { return 1; }                      # f64v256_dot
    if (t == 166) { return 1; }                      # f64_trunc (6.6.13; f64_le/ge are kind 0)
    if (t == 131) { return 2; }                      # f32_from
    if (t == 142) { return 2; }                      # f32v_dot
    if (t == 151) { return 2; }                      # f32v8_dot
    return 0;
}

# ⛔ 6.6.10 — THE FLOAT-BUILTIN RESULT FLAG (option D). A float-returning builtin left the
# estype of its LAST ARGUMENT (0 under the i64-boxed idiom), so every `+ - * /` on its result
# took the INTEGER arm, silently: `f64_sqrt(u) * f64_sqrt(u)` was 0, `f64_sin(0) - f64_cos(0)`
# was -4.0, `f64_mul(u, v) / v` was 1, and `f64_add(p, u) * 2.0` differed from
# `f64_add(u, p) * 2.0` because the argument ORDER leaked the type.
# The result is marked instead of typed: `_fbr_k` (1 = f64, 2 = f32) stamped with the code
# pointer and token index at the end of the call. It reads as valid (_FBR_KIND) only while
# NOTHING has been emitted or consumed since — so it survives a parenthesised factor (whose
# `)` re-stamps the token index) and unary minus (which re-marks), and dies at any other
# operator. The `+ - * /` arms read their LEFT operand through _FBR_ST, the kind-1 check its
# RIGHT operand, and the kind-2 check (_INT_F64_MIX) the right operand captured by _RHS_F /
# _RHS_T before the integer op is emitted.
# ⚠ WHY NOT TYPE THE RESULT F64 (option A): that also turns ORDERED and equality compares of
# builtin results into float compares, and 41 ecosystem sites compare those bit patterns on
# purpose (hex constants, hisab's -0 check, ganita's `f64_floor(v) == v`) — NaN and ±0 would
# change meaning. So a builtin-vs-builtin `<` stays an INTEGER compare (wrong for negative
# values); the guide says so. A leaked argument estype that is not the builtin's own float
# type is dropped (a struct id there dispatched an operator overload; an f32 one an f32 op).
# Kind 3 is the untyped-float-variable load marker (_UFV_*), which types nothing: it only
# lets unary minus warn. CHANGELOG [6.6.10]
var _fbr_k = 0;
var _fbr_cp = 0;
var _fbr_ti = 0;
var _fbr_rhs = 0;
fn _FBR_MARK(S, k): i64 {
    if (k == 1) { if (GESTYPE(S) != F64_TYID) { SESTYPE(S, 0); } }
    if (k == 2) { if (GESTYPE(S) != F32_TYID) { SESTYPE(S, 0); } }
    _fbr_k = k;
    _fbr_cp = GCP(S);
    _fbr_ti = GTI(S);
    return 0;
}
fn _FBR_KIND(S): i64 {
    if (_fbr_k == 0) { return 0; }
    if (GCP(S) != _fbr_cp) { return 0; }
    if (GTI(S) != _fbr_ti) { return 0; }
    return _fbr_k;
}
# The operand's effective type: its estype, else the builtin-result flag's.
fn _FBR_ST(S): i64 {
    var t = GESTYPE(S);
    if (t != 0) { return t; }
    var k = _FBR_KIND(S);
    if (k == 1) { return F64_TYID; }
    if (k == 2) { return F32_TYID; }
    return 0;
}
# The integer arms' right operand: parse it, then capture the flag BEFORE the op is emitted.
fn _RHS_F(S): i64 { PARSE_FACTOR(S); _fbr_rhs = _FBR_KIND(S); return 0; }
fn _RHS_T(S): i64 { PARSE_TERM(S); _fbr_rhs = _FBR_KIND(S); return 0; }

# ⛔ 6.6.10 — UNARY MINUS ON AN UNTYPED FLOAT VARIABLE. `var c = 1.5; -c` is an INTEGER
# negation of 1.5's bits (-3.0; `-z` of 0.0 is +0, `-n` of -2.5 is 1.75), silent, because an
# untyped var is i64-boxed (ADR-002) and nothing recorded what initialised it. WARN, the
# roadmap's agreed posture: inferring f64 would change what existing code computes.
# One byte per slot: `_lfi_base` for locals (cleared as SFLC hands a slot out, so a param or a
# later fn never inherits a stale flag; saved/restored with the closure local snapshot) and
# `_gfi_base` for globals (lazily alloc'd at the var table's hard cap — the `_var_dead`
# precedent; never on the cybs-fragile `_grow_g*` chain). Set on EVERY declaration: 1 when
# the initialiser was a float (a float literal, an f64/f32 value, a float builtin, or another
# such variable), else 0. A load of a flagged variable marks kind 3. CHANGELOG [6.6.10]
fn _UFV_L(S, li): i64 {
    if (_lfi_base == 0) { return 0; }
    if (li < 0) { return 0; }
    if (li >= 16384) { return 0; }
    if (load8(_lfi_base + li) == 1) { _FBR_MARK(S, 3); }
    return 0;
}
fn _UFV_G(S, vi): i64 {
    _vecg_refuse(S, vi);   # 6.6.17 (a3): the untyped-global read rung — a vector global's too
    if (_gfi_base == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (load8(_gfi_base + vi) == 1) { _FBR_MARK(S, 3); }
    return 0;
}
# 1 when the expression just parsed is a float (the local-declaration test).
fn _UFV_IS_FLOAT(S): i64 {
    var t = GESTYPE(S);
    if (t == F64_TYID) { return 1; }
    if (t == F32_TYID) { return 1; }
    if (_FBR_KIND(S) != 0) { return 1; }
    return 0;
}

# ⛔ 6.6.10 — AN INTEGER STORED INTO AN f64 / f32 SLOT keeps its integer BITS: `var t: f64 = 1;`,
# `t = 1;`, `p.x = 1;` and `P { 1, 2 }` store 0x1, a subnormal, silently. WARN (ADR-002: a
# conversion would change existing code). Only a compile-time integer CONSTANT is judged — a
# literal, a negated literal or an enum constant, spanning the whole initialiser `[ti, end)` —
# because a runtime untyped value is the legal i64-boxed float idiom (`var x: f64 = load64(p)`
# is everywhere). 0 is exempt (its bits ARE 0.0), and so is |v| >= 2^52: an IEEE bit pattern
# written in hex (0x3FF0000000000000) is never below 2^52 unless it is a subnormal, while an
# integer COUNT essentially always is. `k` is the slot's float type (0 = not a float slot).
fn _ic_val_ok(v): i64 {
    if (v == 0) { return 0; }
    if (v < 0) { v = 0 - v; }
    if (v <= 0) { return 0; }
    if (v >= 0x10000000000000) { return 0; }
    return 1;
}
fn _IFS_SPAN(S, ti, end): i64 {
    var n = end - ti;
    if (n == 2) {
        if (TOKTYP(S, ti) != 7) { return 0; }
        if (TOKTYP(S, ti + 1) != 1) { return 0; }
        return _ic_val_ok(TOKVAL(S, ti + 1));
    }
    if (n != 1) { return 0; }
    var t = TOKTYP(S, ti);
    if (t == 1) { return _ic_val_ok(TOKVAL(S, ti)); }
    if (t != 2) { return 0; }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, TOKVAL(S, ti)) >= 0) { return 0; } }
    # _findvar_core, not FINDVAR: a warning heuristic must not raise FINDVAR's `private`
    # refusal — it also runs at global REGISTRATION (_gv_ifs), where that is an accusation.
    var vi = _findvar_core(S, TOKVAL(S, ti));
    if (vi < 0) { return 0; }
    if (GVECP(S, vi) != 1) { return 0; }
    return _ic_val_ok(L64(_vecv_base + vi * 8));
}
fn _IFS_CHECK(S, k, ti): i64 {
    if (k == 0) { return 0; }
    if (ti < 0) { return 0; }
    if (_IFS_SPAN(S, ti, GTI(S)) == 1) { _FLT_TYPE_WARN(S, 4); }
    return 0;
}
# A slot type (F64_TYID / F32_TYID / anything) as a float kind for _IFS_CHECK.
fn _IFS_K(t): i64 {
    if (t == F64_TYID) { return 1; }
    if (t == F32_TYID) { return 2; }
    return 0;
}

# ⛔ 6.6.12 — A `.field` ON A CALL RESULT (`f(mk(p).n)`, `var r = mkp(3).y;`, `mk(p).v.x + 1`)
# parsed nowhere: the factor returned straight after the call and the `.` was a syntax error in
# every expression position. Cursor just past the callee IDENT; 1 = the call and its whole field
# tail are consumed (the value in rax, typed like any field load), 0 = not that shape (cursor
# untouched). In a fn the result lands in a frame temp — the retptr / rax:rdx / rax store of
# `_struct_call_emit`, a `Str` handle in a pointer-mode slot — and the field is loaded from it
# through PARSE_FIELD_LOAD's own body (`_field_load_on`), so chains, widths, signedness, float
# kinds, a method on the result and a struct-typed field as a whole-struct source all match a
# named receiver. At top level there is no frame: refused by name. CHANGELOG [6.6.12]
fn _call_field(S): i64 {
    var ti = GTI(S) - 1;
    if (_call_dotted(S, ti) == 0) { return 0; }
    var fi = _gen_resolve_call(S, ti);
    if (fi < 0) { if (_syntax_only == 0) { return 0; } }   # an undefined callee reports itself
    var sid = 0;
    if (fi >= 0) { sid = GFRS(S, fi); }
    if (sid <= 0 || GINFN(S) != 1) {
        # --syntax-only: a return type from a sibling file reads as a scalar, so stay silent.
        if (_syntax_only == 0) {
            if (sid <= 0) { ERR_IDENT(S, "cannot take a field of the result of ", TOKVAL(S, ti), ": it does not return a struct", 0 - 1); }
            else { _refuse_toplevel_struct_call(S, TOKVAL(S, ti)); }
        }
        # --syntax-only still parses a plain call's arguments, for the grammar errors in them.
        if (_syntax_only == 1 && TOKTYP(S, ti + 1) == 10) { PARSE_FNCALL(S, TOKVAL(S, ti)); }
        else { STI(S, _call_close(S, _gcall_open(S, ti)) + 1); }
        _synonly_skip_chain(S);
        # a method on the refused result: its arguments too, or `(` is a second error
        if (PEEKT(S) == 10) { STI(S, _call_close(S, GTI(S)) + 1); }
        _cfo = 0;
        return 1;
    }
    STI(S, ti);
    var h = 0;
    if (_ret_agg_class(S, fi) == 0) { if (STRUCTSZ(S, sid - 1) > 8) { h = 1; } }
    _struct_call_into(S, h);
    var t = _sci_t;
    STI(S, GTI(S) + 1);                 # consume `.`
    var fnoff = PEEKV(S);
    STI(S, GTI(S) + 1);                 # consume the field name
    _field_load_on(S, TOKVAL(S, ti), fnoff, ti, 0 - 2 - t, sid);
    # AFTER the call: a literal argument (`mkp(3)`) left itself foldable, and `mkp(3).y + 1`
    # then folded to 4 by rewriting the code from that literal — the call and the load with it.
    _cfo = 0;
    return 1;
}

# 6.6.12 — the STATEMENT form, `mk(3).total();` / `mk(3).n;`. PARSE_STMT sends `IDENT (` straight
# to PARSE_FNCALL and never reaches the factor, so `_call_field` above did not run there and the
# `.` was "expected ';'" while `var t = mk(3).total();` worked. Cursor just past the callee IDENT;
# 1 = the statement is consumed through its `;`. One call in PARSE_STMT: that body is near cybs's
# per-function reference limit. A field of a temporary is not an lvalue: refused by name.
# CHANGELOG [6.6.12]
fn _stmt_call_field(S): i64 {
    if (_call_field(S) == 0) { return 0; }
    if (PEEKT(S) == 4) { ERR_MSG(S, "cannot assign to a field of a call result: the result is a temporary", 68); }
    else { if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } }
    STI(S, GTI(S) + 1);
    return 1;
}

# v6.3.10 (explicit): `foo<i64>(x)` / `foo<Pt>(p)` — cursor on the `<`. Out of
# `_PARSE_FACTOR_IMPL` since 6.6.10: that body is near cybs's per-function reference limit, and
# this path grew the stub refusal.
# ⛔ 6.6.10 — `_ta_explicit` tells the PARSE_FNCALL below not to re-infer, and a stub generic
# (it uses T as a struct) is refused by name for ANY scalar type argument: `g<i64>(5)` ran the
# `rax = 0` stub silently, and `g<i32>(5)` minted an instance that failed with "no struct type
# in scope for 'p'". A forwarded `inner<T>` in a base emission never gets here with a stub
# callee: the enclosing generic is a (transitive) stub itself, so its base body is skipped —
# which retired 6.6.8's `_call_forwarded_base` (a base call with the inline replay suppressed at
# depth 0, which existed only to keep that replay out of such a base). CHANGELOG [6.6.10]
fn _explicit_generic_call(S, noff, fi): i64 {
    STI(S, GTI(S) + 1);                 # consume `<`
    _ta_pending_gt = 0;
    # v6.3.33: parse conc0 [, conc1] via _parse_one_type_arg (nested
    # type-args instantiate → their instance sid; `>>` tail handled).
    var _ta_conc = _parse_one_type_arg(S);
    var _ta_conc1 = 0;
    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); _ta_conc1 = _parse_one_type_arg(S); }  # `,`
    _consume_gt(S);                     # consume the closing `>` (or `>>` tail)
    # Call the base (the all-i64 instance) only when EVERY arg is i64.
    var _ta_do = 0;
    if (_ta_conc != 0 - 8) { _ta_do = 1; }
    if (_ta_conc1 != 0 && _ta_conc1 != 0 - 8) { _ta_do = 1; }
    # A stub generic with a scalar type argument: route it to the base call, whose head refuses it.
    if (_ta_conc < 0 && _ta_conc1 <= 0) { if (_gen_stub(S, fi) != 0) { _ta_do = 0; } }
    if (_ta_do == 0) {
        _ta_explicit = 1;               # set right before the call that reads it (see below)
        PARSE_FNCALL(S, noff);          # all-i64: call the base
        _call_ret_ps(S, fi);            # 6.6.17: a `*T` return's pointer scale
        return 0;
    }
    # non-i64: monomorphize on demand + call the specialized fn.
    var _spec = _instantiate_generic_fn(S, fi, _ta_conc, _ta_conc1);
    if (_spec == 0 - 2) {
        ERR_MSG(S, "non-i64 generic fns with parameters: instantiate-once param re-emission is a follow-on bite", 91);
    }
    if (_spec == 0 - 3) {
        ERR_MSG(S, "generic fns with STRUCT type-arguments are a follow-on (monomorphized struct-ABI); use a generic struct or scalar type-args", 123);
    }
    # ⛔ 6.6.5 — `_spec` is -2 / -3 on the two error paths above,
    # and `_fnt_names + _spec * 8` read 16/24 bytes BEFORE the
    # table: an out-of-bounds load whose garbage was then parsed
    # as a name, which is where the nonsense
    # "undefined function 'enum'" came from. ERR_MSG does not
    # exit (the multi-error contract), so the guard has to be
    # here. Arguments are still consumed, by PARSE_FNCALL on the
    # base name, so the parse stays in sync. CHANGELOG [6.6.5]
    # ⚠ `_ta_explicit` is set only NOW: the instance body just emitted makes calls of its own,
    # and the first of them would have taken the flag as its own and skipped its inference.
    _ta_explicit = 1;
    if (_spec >= 0) { PARSE_FNCALL(S, L64(_fnt_names + _spec * 8)); _call_ret_ps(S, _spec); }
    else { PARSE_FNCALL(S, noff); }
    return 0;
}
# ⛔ 6.6.17 — A CALL'S RESULT CARRIED ITS LAST ARGUMENT'S POINTER SCALE. The arguments are parsed
# as expressions inside the call's factor, and nothing reset the scale the last one left, so with
# `p: *i64` the value of `f(p) + 1` was f's result + 8, as was `load64(p) + 1`, `fncall1(&f, p) + 1`
# and `callptr(cl, p) - p` (p scaled by 8 too). Silent wrong values. A call's result now scales
# only by the callee's DECLARED return type: `fn f(): *T` steps sizeof(T) (`_fn_rps`), anything
# else — every builtin, `callptr` / `fncallN`, an untyped or scalar return — is a plain value.
# `ti` is the factor's first token; only a factor that IS one whole call `name(..)` /
# `name<..>(..)` / `builtin(..)` is judged — one continuing past the `)` (`mk(p).f`) sets its own.
# The method arm sets its result's scale itself (`_call_ret_ps`). CHANGELOG [6.6.17]
fn _call_scale_fix(S, ti): i64 {
    var t = TOKTYP(S, ti);
    var o = 0 - 1;
    if (t == 2) { o = _gcall_open(S, ti); }
    elif (TOKTYP(S, ti + 1) == 10) {
        if (t == 137) { o = ti + 1; }                       # callptr
        elif (TOKNAME_BUILTIN(t) != 0) { o = ti + 1; }
    }
    if (o < 0) { return 0; }
    if (GTI(S) != _call_close(S, o) + 1) { return 0; }
    var ps = 0;
    if (t == 2) {
        var fi = FINDFN(S, TOKVAL(S, ti));
        if (fi >= 0) { if (_fn_rps != 0) { ps = L64(_fn_rps + fi * 8); } }
    }
    SPSC(S, ps);
    return 0;
}
# After a plain call `name(..)` to fn `fi` (-1: unresolved): a scalar f64 return (sentinel -9) is
# in xmm0 — bring it back into rax and type the expression F64_TYID (v6.4.55; EMOVQ_A_X0 is a no-op
# on aarch64/cx) — and a `*T` return carries T's step as the pointer scale (6.6.17).
fn _call_ret_marks(S, fi): i64 {
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) == 0 - 9) { EMOVQ_A_X0(S); SESTYPE(S, F64_TYID); }
    _call_ret_ps(S, fi);
    return 0;
}

# 1 = `syscall(sc_num, ..)` with `got` user arguments is a KNOWN cross-target shape, not an
# arity mismatch: the Linux x86_64 arity table below cannot see which peer a wrapper belongs
# to. Split out of _PARSE_FACTOR_IMPL (6.6.12) so the target gate on the kill shape costs that
# body no global reference.
fn _sc_arity_skip(sc_num, got): i64 {
    # Skip the warning when this is the cross-arch
    # openat shape: syscall(SYS_OPEN=2, AT_FDCWD, path,
    # flags, mode) — 4 user args instead of open()'s 3.
    # Source: arch-conditional wrappers in
    # lib/syscalls_*_linux.cyr and src/frontend/lex.cyr
    # keep both open()/openat() shapes for cross-arch
    # source compatibility; the dead branch on the
    # running arch is not a bug. Open() is never called
    # legitimately with 4 user args, so the structural
    # match is unambiguous.
    var skip_warn = 0;
    if (sc_num == 2) { if (got == 4) { skip_warn = 1; } }
    # v5.8.54: same cross-arch number-reuse pattern as
    # SYS_OPEN above. Linux x86_64 SYS_SETUID = 113 (1
    # arg); Linux aarch64 SYS_CLOCK_GETTIME = 113 (2
    # args: clock_id + timespec_ptr — `syscall(113, 1,
    # &ts)` in cyrius syntax = 3 cyrius-args, got=2).
    # Surfaced by `src/backend/aarch64/fixup.cyr`'s
    # `_prof_clock_ns()` helper; warning fired on every
    # aarch64 cross-build. setuid is never legitimately
    # called with 2 user args, so the structural match
    # is unambiguous (same logic as the SYS_OPEN skip).
    if (sc_num == 113) { if (got == 2) { skip_warn = 1; } }
    # 6.6.10: Darwin's kill is kill(pid, sig, posix). lib's sys_kill passes
    # posix = 0 explicitly on macOS (a stale third register made kill(-pgid)
    # answer EPERM or ESRCH at random), and this Linux table then warned on
    # every x86-macOS build. Linux kill never takes 3 user args, so the
    # structural match is unambiguous (the 113 shape). CHANGELOG [6.6.10]
    # ⛔ 6.6.12: DARWIN ONLY. The skip had no target check, so a wrong 3-arg kill compiled
    # SILENTLY on x86-Linux from 6.6.10 on (6.6.9 warned). PE never prints this arity warning
    # (its unrouted-number warning names the call, unchanged), and arm64-macOS never reaches
    # here (_AARCH64_BACKEND).
    if (_TARGET_MACHO == 1) { if (sc_num == 62) { if (got == 3) { skip_warn = 1; } } }
    # v6.0.48: agnos uses NATIVE syscall numbers (0-33) that
    # collide with Linux numbers at different arities (agnos
    # getpid=2 vs Linux open=2/3-args; agnos exit=0 vs Linux
    # read=0/3-args; ...). This arity table is Linux-only, so
    # it false-positives on every agnos syscall;
    # lib/syscalls_x86_64_agnos.cyr is the authority.
    if (_TARGET_AGNOS == 1) { skip_warn = 1; }
    return skip_warn;
}

# `_SYSX_MEANT(n)` — the x86_64 name of a raw number that means something else on
# ELF-aarch64 — unless the call sits inside a native-aarch64 region (`#ifdef
# CYRIUS_ARCH_AARCH64`, `#ifndef CYRIUS_ARCH_X86`, ...), where the number is the native one
# by construction: the preprocessor marks those regions (PP_A64_NATIVE_AT,
# src/frontend/lex_pp.cyr). Same frame rule as tests/gates/platform/
# raw_syscall_literals_routed.sh applies to lib/. The table is a `return 0` stub off the
# aarch64 backend, so the scan runs only where a warning would otherwise print.
# CHANGELOG [6.6.12]
fn _sysx_meant_here(S, n): i64 {
    var m = _SYSX_MEANT(n);
    if (m == 0) { return 0; }
    # The call's own closing `)` (the cursor is one past it): the token after it may sit
    # beyond the `#endif` that closes the region.
    if (PP_A64_NATIVE_AT(S, GTOFF(S, GTI(S) - 1)) == 1) { return 0; }
    return m;
}

# ⛔ 6.6.12 — THE ARRAY SUBSCRIPT, `a[i]`, `a[i] = v` and `a[i] OP= v`, on an INTEGER
# element-typed array `var a: T[N]` (T = i8..i64 / u8..u64), local or global, in any fn, at
# top level, in a closure (on its captured copy) and in an `async fn`. The language had no
# subscript at all: `return a[1];` was `expected ';', got '['` and `a[i] = 5;` was
# `expected '=', got '['`, so the only spelling was `store64(&a + i * 8, v)`. `a[i]` IS
# that: the element at `&a + i * sizeof(T)`, loaded sign- or zero-extended by T, stored at
# T's width. No bounds check (the opt-in checked mode is a separate item). A bare `var a[N]`
# states no element width (bytes in a fn, slots at top level), so its subscript is REFUSED by
# name rather than guessed, as is a float, bool or struct element (it records no integer
# descriptor, so it reads as bare); a slice local keeps its own bounds-checked `s[i]` (below,
# in the factor). CHANGELOG [6.6.12]
#
# Cursor at `[` after NAME: consumes `[ idx ]` and leaves rax = &NAME[idx]. Returns the element
# width, NEGATIVE for a signed element (the EFIELD_LOAD_W convention); 0 after a diagnostic.
# The base is resolved as `&NAME` resolves it: a local, a closure capture, then a global.
fn _arr_sub_addr(S, noff): i64 {
    var k = 0;
    var ix = 0 - 1;
    var d = 0;
    if (GINFN(S) == 1) {
        ix = FINDLOCAL(S, noff);
        if (ix >= 0) { k = 1; d = GLAEW(S, ix); }
    }
    if (k == 0) { if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) {
                var esl = _cl_snap_find(S, noff);
                if (esl >= 0) {
                    ix = _cl_cap_find(esl);
                    if (ix >= 0) { k = 2; d = _cl_snap_aew(esl); }
                }
            } } }
    if (k == 0) {
        ix = FINDVAR(S, noff);
        if (ix >= 0) { k = 3; d = _arr_gdesc(S, ix); }
    }
    var aw = d & 0x3F;
    if (k == 0) {
        if (_syntax_only == 0) {
            ERR_IDENT(S, "undefined variable ", noff, " (missing include or enum?)", 0 - 1);
            _gv_note_blockscoped(S, noff);
        }
        aw = 0;
    } elif (aw == 0) {
        ERR_IDENT(S, "cannot subscript ", noff, ": `a[i]` needs an integer element-typed array `var a: T[N]` with T one of i8..i64, u8..u64 - a bare `var a[N]` states no element width, an f64, f32, bool or struct element is not supported, and a pointer or scalar is not an array; use load/store at an explicit byte offset", 0 - 1);
    } elif (aw > 8) {
        ERR_IDENT(S, "cannot subscript ", noff, ": a u128 element does not fit one register - use load64/store64 on its two halves", 0 - 1);
        aw = 0;
    }
    STI(S, GTI(S) + 1);   # consume [
    PCMPE(S);             # rax = the index
    if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
    STI(S, GTI(S) + 1);   # consume ]
    if (aw == 0) { return 0; }
    EPTR_SCALE(S, aw);    # rax = index * sizeof(T)
    EPUSHR(S);
    # The frame and capture bases are raw bytes on x86 (no IR node of their own); mark them so
    # a CYRIUS_IR pass cannot take rax for the scaled index across them. EVADDR records itself.
    if (k != 3) { _IR_REC0(S, IR_RAW_EMIT); }
    if (k == 1) { EFLADDR(S, ix); }
    elif (k == 2) { _CL_CAP_WORDS_RA(S, ix); }
    else { EVADDR(S, ix); }
    EPOPC(S);
    EADDR(S);             # rax = &NAME + index * sizeof(T)
    if ((d & 0x40) != 0) { aw = 0 - aw; }
    return aw;
}
# Width-correct element load: rax = the element at the address in rax. `w` from _arr_sub_addr.
fn _arr_sub_load(S, w): i64 {
    EMOVCA(S);
    # x86's EFIELD_LOAD_W records its raw bytes for widths 1/2/4 only, so a signed (negative)
    # width reached the IR unrecorded and CYRIUS_IR=3 rewrote around it (`b[2]` of an i8 read
    # wrong). Record it here; a second record for the other backends is harmless.
    if (w < 0) { _IR_REC0(S, IR_RAW_EMIT); }
    EFIELD_LOAD_W(S, w);
    # EADDR left `_flags_reflect_rax` set and a load does not write the flags: without this a
    # following `if (a[i])` would branch on the ADDRESS (see parse_ctrl.cyr ETESTAZ).
    _flags_reflect_rax = 0;
    return 0;
}
# The factor: `NAME[idx]` as a value. 0 when the cursor is not at `[`, or NAME is a slice
# local (the bounds-checked slice subscript below handles it); 1 when consumed.
fn _arr_sub_read(S, noff): i64 {
    if (PEEKT(S) != 28) { return 0; }
    if (GINFN(S) == 1) {
        var sl = FINDLOCAL(S, noff);
        if (sl >= 0) { if (GSLICE_W(S, sl) > 0) { return 0; } }
    }
    var w = _arr_sub_addr(S, noff);
    if (w != 0) { _arr_sub_load(S, w); }
    else { EMOVI(S, 0); }
    var aw = w;
    if (aw < 0) { aw = 0 - aw; }
    SPSC(S, 0);
    SESTYPE(S, 0);
    SEXW(S, aw);
    _cfo = 0;
    return 1;
}
# The assignment: `NAME[idx] = v` or `NAME[idx] OP= v` (the compound pair of _asg_compound_tok),
# stored at the element's width. Does NOT consume the `;` — the statement arm and the classic-for
# step replay (parse_ctrl.cyr) share it. 0 when the cursor is not at `[`.
fn _arr_sub_assign(S, noff): i64 {
    if (PEEKT(S) != 28) { return 0; }
    var w = _arr_sub_addr(S, noff);
    EPUSHR(S);            # the element address
    var cop = _asg_compound_tok(S);
    if (cop == 0) {
        if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); }
        STI(S, GTI(S) + 1);
        PCMPE(S);
    } else {
        if (w != 0) { _arr_sub_load(S, w); }
        _asg_compound_op(S, cop, 0);
    }
    var aw = w;
    if (aw < 0) { aw = 0 - aw; }
    if (aw > 0) { if (GEXW(S) > aw) { WARN(S, "narrowing assignment (value may truncate)", 41); } }
    EPOPC(S);             # rcx = the element address, rax = the value
    if (aw == 1) { ESTORE8(S); }
    elif (aw == 2) { ESTORE16(S); }
    elif (aw == 4) { ESTORE32(S); }
    else { ESTORE64(S); }
    return 1;
}
# The statement arm (_PARSE_STMT_IMPL): the assignment and its `;`.
fn _arr_sub_stmt(S, noff): i64 {
    if (_arr_sub_assign(S, noff) == 0) { return 0; }
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    return 1;
}

fn _PARSE_FACTOR_IMPL(S): i64 {
    var typ = PEEKT(S);
    SPSC(S, 0);
    SESTYPE(S, 0);
    SESVAR(S, 0 - 1);
    SEXW(S, 0);
    _fbr_k = 0;   # 6.6.10: a new factor's value is not the last builtin's (see _FBR_MARK)
    # v6.4.83 — the RIGHT-operand half of the intrinsic-flanking fix. PARSE_TERM's
    # `* / % << >> >>>` loop parses its right operand with PARSE_FACTOR, one tier DOWN
    # from where the intrinsics were dispatched, so `a * f64_from(2)` was a syntax
    # error. Routing through the same shared PARSE_INTRIN the TERM tier uses means
    # there is exactly ONE list of intrinsic tokens, so the two tiers cannot drift
    # apart again. Placed AFTER the four state resets above so a dispatched intrinsic
    # starts from the same clean slate as any other factor.
    # `_cfo = 0`: an intrinsic result is never a const-foldable literal — see the
    # `_cfo` discipline note on PARSE_INTRIN.
    if (PARSE_INTRIN(S, typ) == 1) { _cfo = 0; return 0; }
    # Unary minus: -expr
    if (typ == 7) {
        STI(S, GTI(S) + 1);
        # Optimization: -NUM → emit negated constant
        if (PEEKT(S) == 1) {
            EMOVI(S, 0 - PEEKV(S));
            STI(S, GTI(S) + 1);
            return 0;
        }
        # General: parse factor, emit 0-rax via push/sub.
        # ⛔ A FLOAT operand (a float literal, an f64/f32-typed value) is negated by flipping
        # its SIGN BIT, never by integer `0 - bits`: that computed `-1.0` as -4.0, `-0.0` as
        # +0 and `-x` on an f64 likewise, on every target. The operand's type is known only
        # after it is parsed, so the integer prologue is shared and a float operand discards
        # its pushed 0 (EF64_NEG is exact for every value, -0.0 and NaN included). CHANGELOG [6.6.8]
        # A float-returning BUILTIN is recognised through the result flag (_FBR_ST), which also
        # reaches one inside parentheses (`-(f64_sqrt(v))` negated the integer until 6.6.10); the
        # negation re-marks it, so `-f64_sqrt(u) * 2.0` is still a float multiply. An untyped
        # variable that holds a float (kind 3) is negated as an integer and WARNS. CHANGELOG [6.6.10]
        EMOVI(S, 0);
        EPUSHR(S);
        PARSE_FACTOR(S);
        var _ngt = _FBR_ST(S);
        if (_ngt == F64_TYID) { EPOPC(S); EF64_NEG(S); _FBR_MARK(S, 1); _cfo = 0; return 0; }
        if (_ngt == F32_TYID) { _NEG_F32(S); _FBR_MARK(S, 2); _cfo = 0; return 0; }
        if (_FBR_KIND(S) == 3) { _FLT_TYPE_WARN(S, 3); }
        EMOVCA(S);
        EPOPR(S);
        ESUBR(S);
        return 0;
    }
    # Unary bitwise NOT: ~expr
    if (typ == 37) {
        STI(S, GTI(S) + 1);
        PARSE_FACTOR(S);
        ENOTR(S);
        return 0;
    }
    if (typ == 61) { var fval = PEEKV(S); STI(S, GTI(S) + 1); EMIT_FLOAT_LIT(S, fval); SESTYPE(S, F64_TYID); return 0; }
    # sizeof(Type) — compile-time constant (detected as IDENT "sizeof")
    # 6.6.11: the WHOLE name (_is_sizeof_word); a 6-byte prefix took `sizeofzz(..)` too.
    if (typ == 2) { if (_is_sizeof_word(S, PEEKV(S)) == 1) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
            STI(S, GTI(S) + 1);
            var szval = 0;
            if (PEEKT(S) == 105) {
                # sizeof(u128) = 16
                szval = 16;
                STI(S, GTI(S) + 1);
            } else {
                if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
                # 6.6.16 (C8): the one type-name resolver — a bound type parameter its argument's
                # size, else the WHOLE name (u8..u64, f32, f64, bool, cstring, an enum, a vector, a
                # struct), else refused by name. sizeof(f64) / sizeof(u8) did not compile. CHANGELOG [6.6.16]
                szval = _sizeof_type(S, 0);   # 6.6.17: + `<..>` (_sizeof_type)
            }
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
            STI(S, GTI(S) + 1);
            EMOVI(S, szval);
            return 0;
        } }
    # mulh64(a, b) — high 64 bits of a 64×64 unsigned multiply
    # The WHOLE name (_is_mulh64_word): a 6-byte prefix compiled a user fn `mulh64x(..)` as
    # this intrinsic. CHANGELOG [6.6.11]
    if (typ == 2) { if (_is_mulh64_word(S, PEEKV(S)) == 1) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
            STI(S, GTI(S) + 1);
            PCMPE(S); EPUSHR(S);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); }
            STI(S, GTI(S) + 1);
            PCMPE(S); EPOPC(S); EMULH(S);
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
            STI(S, GTI(S) + 1);
            _cfo = 0;
            return 0;
        } }
    # v6.5.17 — fncall0..fncall8 lower to the SAME sequence as `callptr`, so a
    # capturing closure reaches the callee through them too.
    #
    # Why here and not in lib/fnptr.cyr: the closure needs its env as a TRAILING
    # argument, so `fncallN` would have to re-enter at `fncall(N+1)` — and cybs, the
    # bootstrap compiler that must parse lib/fnptr.cyr on the seed chain, cannot
    # parse a call with more than 6 arguments. That caps the ladder at fncall4 and
    # would have left fncall5-7 silently broken, which is exactly the half-fix shape
    # this bug already went through once. Lowering here fixes every arity at once,
    # gives the stdlib's own higher-order fns (vec_sort_by, vec_each, hashmap
    # iteration — all `fncallN(cb, …)`) closure support for free, and inherits
    # ECALLPOPS/ECALLPTR_PE's marshalling, which is strictly better than the hand
    # asm for >4 args on Win64 and >6 on SysV.
    #
    # Gated on FINDFN so a program that never included lib/fnptr.cyr still gets its
    # "undefined function" diagnostic instead of silently compiling.
    # ⛔ 6.6.16 — and NOT on being inside a fn: this gate also read `_cur_fn_ix >= 0`, so a
    # top-level fncallN fell back to lib/fnptr.cyr, which calls a capturing closure's tagged
    # value (SIGSEGV; 0 for every callee on cx). PINDIRECT_CALL now brings a micro-frame to
    # top level (see its header), so the lowering is the same at every depth — the extern-C
    # driver in tests/gates/platform/ffi_stack_protected_extern_c.sh included. CHANGELOG [6.6.16]
    if (typ == 2) { if (_IS_FNCALL_NAME(S, PEEKV(S)) == 1) {
            if (TOKTYP(S, GTI(S) + 1) == 10) { if (FINDFN(S, PEEKV(S)) >= 0) {
                    # v6.5.46: the digit in the name IS the promised arity — the same
                    # byte `_IS_FNCALL_NAME` already validated as '0'..'8'.
                    _fncall_expect = ((L64(S + 0xEC00000 + PEEKV(S)) >> 48) & 0xFF) - 48;
                    STI(S, GTI(S) + 1);   # consume fncallN
                    STI(S, GTI(S) + 1);   # consume '('
                    PINDIRECT_CALL(S);
                    return 0;
                } }
        } }
    if (typ == 1) {
        var val = PEEKV(S);
        STI(S, GTI(S) + 1);
        _cfp = GCP(S);
        EMOVI(S, val);
        # Mark as foldable for small non-negative literals. Originally
        # guarded `val > 0` because EMOVI(S, 0) emits 2 B (`xor eax, eax`)
        # vs 5 B for val > 0, and we worried const-fold rewrites assumed
        # a fixed slot size. Rewrites actually use `SCP(_cfp); EMOVI(_, v)`
        # which truncates + re-emits, so the emitted size doesn't matter
        # — any const, including 0, folds safely. Dropping the 0 exclusion
        # unblocks `syscall(0, ...)` reroute dispatch on both Mach-O and PE
        # (v5.5.14 — stdlib `lib/io.cyr` uses literal 0 for SYS_READ).
        if (val >= 0) { if (val < 0x10000) { _cfv = val; _cfo = 1; } }
        return 0;
    }
    if (typ == 2) {
        # IDENT — variable load or function call
        var noff = PEEKV(S);
        STI(S, GTI(S) + 1);
        if (_call_field(S) == 1) { return 0; }   # 6.6.12: `f(..).field` / `f<T>(..).field`
        # v6.3.10 (explicit): `foo<i64>(x)` explicit type-arguments. Gated on the
        # monomorph flag AND a generic-fn callee AND the `foo<...>(` lookahead shape,
        # so `a < b`, chained comparisons, and calls to non-generic fns are never
        # misread (flag-off / non-generic → byte-identical default path). v6.3.10
        # bite-1 supports i64 type-args (the base IS the i64 instance → normal call);
        # non-i64 type-args (instantiate-once) land in a follow-on bite.
        if (_MONOMORPH_OK == 1) { if (PEEKT(S) == 19) {
                var _eta_fi = FINDFN(S, noff);
                if (_eta_fi >= 0) { if (GFTP(S, _eta_fi) != 0) {
                        if (LOOKAHEAD_IS_TYPE_ARG_CALL(S) == 1) {
                            _explicit_generic_call(S, noff, _eta_fi);
                            _cfo = 0;
                            return 0;
                        }
                    } }
            } }
        # Check for function call
        if (PEEKT(S) == 10) {
            PARSE_FNCALL(S, noff);
            # v6.4.55: if the callee returns scalar f64 (sentinel -9), the double is in
            # xmm0 (SysV/Win64) — bring it back into rax (cyrius's f64-boxing register)
            # and tag the expr F64_TYID so a bare +,-,*,/,compare on the call result
            # dispatches to the f64 emitters, not integer ops. EMOVQ_A_X0 = `movq rax,
            # xmm0` on x86/PE/macho, a no-op on aarch64/cx (value already in x0/r0).
            _call_ret_marks(S, FINDFN(S, noff));   # 6.6.17: + a `*T` return's pointer scale
            _cfo = 0;
            return 0;
        }
        # Check for enum.variant or struct.field access.
        # v6.3.36: `..` (range) is NOT field access — a `.` immediately followed by
        # another `.` belongs to the enclosing `for i in start..end`. Skip the
        # field-access branch so the identifier falls through to the normal scalar
        # load below (leaving `..` for the range parser). Fixes `for i in IDENT..hi`.
        if (PEEKT(S) == 41 && TOKTYP(S, GTI(S) + 1) != 41) {
            # v6.4.24 (P1 fix): `Enum.VARIANT` ignores the base and loads VARIANT (a
            # global const) whenever the field name is ALSO a global var. But that
            # over-matches `struct_var.field` when `field` SHADOWS a global var name:
            # `bc.exit_code` silently loaded the global `exit_code` (=0) instead of the
            # Container field @+72 (the size-dependent silent-wrong-read — only bites
            # when the field name happens to also be a top-level var, so small repros
            # passed). The base of an enum-variant access is a bare ENUM TYPE NAME, never
            # a variable — so if the base IS a known local/global var, `.field` is a
            # FIELD access, full stop. Guard the enum-variant branch on that.
            var _base_is_var = 0;
            if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { _base_is_var = 1; } }
            if (_base_is_var == 0) { if (FINDVAR(S, noff) >= 0) { _base_is_var = 1; } }
            # Peek: is the second ident a known global var? (enum variant)
            var dot_ti = GTI(S);
            STI(S, GTI(S) + 1);
            if (_base_is_var == 0 && PEEKT(S) == 2) {
                # 6.6.11: the base must be the variant's own enum (_enum_qual_resolve).
                var vi = _enum_qual_resolve(S, dot_ti - 1);
                if (vi >= 0) {
                    # Enum.VARIANT — load the variant's global value.
                    # v5.5.2: if this gvar was registered by PARSE_ENUM_DEF
                    # as an enum constant (GVECP presence flag set; raw
                    # value in _vecv_base), fold to EMOVI and mark _cfo=1 so
                    # callers like the syscall sc_num dispatch can read
                    # the compile-time value. (6.6.8: at any var index —
                    # the old 1024-slot cap is gone, see util.cyr GVECP.)
                    STI(S, GTI(S) + 1);
                    if (vi >= 0) {
                        if (GVECP(S, vi) == 1) {
                            var _evq = L64(_vecv_base + vi * 8);
                            _cfp = GCP(S);
                            EMOVI(S, _evq);
                            if (_evq < 0x10000) { _cfv = _evq; _cfo = 1; }
                            else { _cfo = 0; }
                            return 0;
                        }
                    }
                    EVLOAD(S, vi);
                    _cfo = 0;
                    return 0;
                }
            }
            # Not an enum — rewind and do struct field load
            STI(S, dot_ti);
            PARSE_FIELD_LOAD(S, noff);
            _cfo = 0;
            return 0;
        }
        if (_arr_sub_read(S, noff) == 1) { return 0; }   # 6.6.12: `a[i]` (see _arr_sub_addr)
        # Variable load — check local first if in function
        SPSC(S, 0);
        if (GINFN(S) == 1) {
            var li = FINDLOCAL(S, noff);
            if (li >= 0) {
                # v5.8.15 §7: slice subscript `s[i]` for slice-typed
                # locals. GSLICE_W returns the element byte-width
                # captured at PARSE_VAR time (v5.8.14 §6); 0 means
                # not a slice. If `[` follows the ident AND this is
                # a slice local, lower to `_slice_idx_get_W(&local, i)`
                # — bounds-checked sized load via the helper that
                # matches the element width.
                var sw = GSLICE_W(S, li);
                if (sw > 0) { if (PEEKT(S) == 28) {
                        STI(S, GTI(S) + 1);  # consume [
                        # Push &local as first arg (helper takes slice address)
                        EFLADDR(S, li);
                        EPUSHR(S);
                        # Parse index expression — leaves idx in rax
                        PCMPE(S);
                        EPUSHR(S);
                        # Look up and call the width-specific helper.
                        # Helpers live in lib/slice.cyr; consumer must
                        # `include "lib/slice.cyr"` (or pull via deps).
                        var idx_fn = 0 - 1;
                        if (sw == 1)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_1",  16); }
                        if (sw == 2)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_2",  16); }
                        if (sw == 4)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_4",  16); }
                        if (sw == 8)  { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_8",  16); }
                        if (sw == 16) { idx_fn = _FINDFN_CSTR(S, "_slice_idx_get_16", 17); }
                        if (idx_fn < 0) {
                            ERR_MSG(S, "slice subscript requires include \"lib/slice.cyr\" (provides _slice_idx_get_W helpers)", 84);
                        }
                        ECALLPOPS(S, 2);
                        # ERR_MSG does not exit: -1 must not reach ECALLFIX (rc 139 on aarch64/cx
                        # after the diagnostic). The pops/clean stay so push depth balances. CHANGELOG [6.6.9]
                        if (idx_fn >= 0) { ECALLFIX(S, idx_fn); }
                        ECALLCLEAN(S, 2);   # 6.6.5: was missing — leaked Win64's 32 B shadow
                        # Result in rax. Set expression-width tracking so
                        # narrowing assignment warnings work for u8/u16/u32.
                        SEXW(S, sw);
                        if (PEEKT(S) != 29) { ERR_EXPECT(S, 29); }
                        STI(S, GTI(S) + 1);  # consume ]
                        return 0;
                    } }
                var lt = _load_lt(S, li);   # 6.6.17: a typed pointer's value is a plain word
                # v6.2.19 math arc: f64/f32 locals — load the 8-byte value and tag
                # the expression f64/f32 so PEXPR/PARSE_TERM route operators to the
                # f64 builtins (skip the SPSC pointer-scale + sub-word paths below).
                if (lt == F64_TYID) { SESTYPE(S, F64_TYID); EFLLOAD(S, li); return 0; }
                # v6.4.56 (scalar-float D2): f32 now has scalar arithmetic — load the
                # 8-byte value and propagate F32_TYID so PEXPR/PARSE_TERM route +,-,*,/
                # and comparisons to EMIT_F32_BINOP / EF32_CMP (single-precision).
                if (lt == F32_TYID) { EFLLOAD(S, li); SESTYPE(S, F32_TYID); return 0; }
                SPSC(S, lt);
                # Width-correct load for scalar types (1=i8, 2=i16, 4=i32)
                # v6.3.34: a sub-i64 SCALAR local (SLTYPE 1/2/4 for i8/i16/i32) is NOT
                # a pointer — its scale for `+`/`-` arithmetic must be 1, not its byte
                # width. The SPSC(S, lt) above sets scale=lt, which is only correct for a
                # pointer-to-lt element; a plain `var a: i32` then made `a + 2` add
                # 2*sizeof(i32). Reset to 1 for lt < 8 ONLY: SLTYPE 8 is a `*i64` typed
                # pointer (scalar i64 is SLTYPE 0), which genuinely needs scale 8 for
                # `p + i`. No sub-i64 typed pointers exist, so 1/2/4 are always scalars.
                if (lt > 0) { if (lt <= 8) {
                        if (lt < 8) { SPSC(S, 1); }
                        SEXW(S, lt);
                        # v6.3.35: a SIGNED sub-i64 local (marked by a negative slice-width
                        # sentinel) loads via movsx (negative width); unsigned stays movzx.
                        var _lw = lt;
                        if (lt < 8) { if (GSLICE_W(S, li) < 0) { _lw = 0 - lt; } }
                        EFLLOAD_W(S, li, _lw);
                        return 0;
                    } }
                # ⛔ 6.6.5 — OPERATOR OVERLOADING WORKED FOR GLOBALS AND NOT FOR LOCALS, and the
                # difference was invisible: `var a: Num; a.v = 1; ... a + b` compiled clean and
                # did an INTEGER ADD of the two struct words, while the identical top-level
                # declaration dispatched `Num_add`. Measured 3 against 102 for the same source
                # moved inside a fn. Only an INLINE local dispatches — a pointer-mode one holds
                # an address, where `+` is pointer arithmetic (the global half of this rule is
                # a few lines below). A multi-word value is passed BY ADDRESS, matching what
                # `EMIT_OP_DISPATCH` already does for a >8 B global. CHANGELOG [6.6.5]
                if (lt < 0) { if (lt > 0 - 2048) { if (_op_local_dispatches(S, li) == 1) {
                            SESTYPE(S, 0 - lt);
                            if (AGG_NSLOTS(S, lt) > 1) { SESVAR(S, 0 - 2 - li); }
                        } } }
                EFLLOAD(S, li);
                if (lt == 0) { _sl_load_marks(S, li); }   # 6.6.10 the float flag, 6.6.16 the *iN mark
                return 0;
            }
        }
        # v6.3.8 — captured free variable. Inside a capturing closure body, an
        # identifier that is NOT a closure local (FINDLOCAL failed above) but IS an
        # enclosing local reads from the heap env object — the hidden first param at
        # slot `_cl_env_lidx`, captured value at env[1 + capture_index].
        if (_cl_capturing == 1) {
            if (_cl_env_lidx >= 0) {
                var cl_esl = _cl_snap_find(S, noff);
                if (cl_esl >= 0) {
                    var cl_capi = _cl_cap_find(cl_esl);
                    if (cl_capi >= 0) {
                        _CL_CAP_OPTYPE(S, cl_esl, cl_capi);              # see the fn's note
                        _CL_CAP_WORDS_RA(S, cl_capi);                    # rax = &env[woff]
                        # 6.6.5: a multi-word capture IS those words — its value is its
                        # address, the same convention an enclosing inline aggregate has in
                        # its own frame. A single-word capture is a value; load it.
                        if (L64(&_cl_cap_w + cl_capi * 8) > 1) { SPSC(S, 1); return 0; }
                        ELOAD64(S);                                      # rax = captured value
                        return 0;
                    }
                }
            }
        }
        var idx = FINDVAR(S, noff);
        if (idx < 0) {
            # v6.5.19: under --syntax-only an unresolved read becomes the constant 0
            # and we return exactly as the sibling success paths above do, so the
            # token stream stays in sync and no cascade is invented. See _syntax_only
            # (src/common/util.cyr) for why report-and-continue was rejected here.
            if (_syntax_only == 1) { EMOVI(S, 0); return 0; }
            syscall(SYS_WRITE, 2, "error:", 6);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": undefined variable '", 22);
