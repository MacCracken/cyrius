        PRSTR(S + 0xEC00000 + anoff); syscall(SYS_WRITE, 2, "'\n", 2);
        _err_excerpt(S);   # v6.5.39: excerpt+caret, like every syntax error
        _gv_note_blockscoped(S, anoff);   # 6.6.6: see there
        _had_error = 1; EMOVI(S, 0); return 0;
