            syscall(SYS_WRITE, 2, "error: callptr() must be used inside a function, not at top level\n", 66);
            syscall(SYS_EXIT, 1);
        }
        STI(S, GTI(S) + 1);                     # consume 'callptr'
        if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
        STI(S, GTI(S) + 1);                     # consume '('
