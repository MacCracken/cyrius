        # identifier that is NOT a closure local (FINDLOCAL failed above) but IS an
        # enclosing local reads from the heap env object — the hidden first param at
        # slot `_cl_env_lidx`, captured value at env[1 + capture_index].
        if (_cl_capturing == 1) {
            if (_cl_env_lidx >= 0) {
                var cl_esl = _cl_snap_find(S, noff);
                if (cl_esl >= 0) {
                    var cl_capi = _cl_cap_find(cl_esl);
                    if (cl_capi >= 0) {
                        EFLLOAD(S, _cl_env_lidx);          # rax = env object
                        EADDRA_IMM(S, (1 + cl_capi) * 8);  # rax = &env[1+capi]
                        ELOAD64(S);                        # rax = captured value
                        return 0;
                    }
                }
