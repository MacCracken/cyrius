# PARSER — fn definitions, calls, returns, impls:
# REGFN / FINDFN / FINDLOCAL / PARSE_RETURN / PARSE_FNCALL /
# PARSE_IMPL / SKIP_GENERICS / DSE_PASS / IS_JUMP_TARGET /
# PARSE_FN_DEF.
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38. Consumes the state
# vars _cur_fn_regalloc / _cur_fn_ret_stash / _cur_fn_ret_sid defined
# at the top of parse.cyr. Included by parse.cyr at the same textual
# position the original content lived; self-host byte-identical.


# v5.5.38: control-flow fns (if/while/for + cond helpers) extracted.
include "src/frontend/parse_ctrl.cyr"
# 6.7.10 (P5-B): the execution-coverage mode — its switch, the per-fn counters, the map and the dump.
include "src/frontend/parse_cov.cyr"

# ================================================================
# FUNCTION TABLE + CODEGEN
# ================================================================

# v5.6.5 O1: FNV-1a over the null-terminated ident at S+0x60000+noff.
# Returns the 64-bit hash. Caller masks with (table_size - 1) to land
# a slot. Constants are the standard FIPS-spec 64-bit FNV-1a values
# (offset basis + prime). Cyrius multiplies wrap on 2's-complement so
# the natural u64 arithmetic this algorithm assumes works directly.
# v6.5.52 — inline-replay param binding for WIDE (vector) params.
#
# The replay used to bind both params to adjacent SINGLE 8-byte slots and store each with an
# 8-byte EFLSTORE. A 16-byte f32v4/f64v2 (or 32-byte f64v4) therefore overran its neighbour:
# ONE SIMD param inlined correctly, TWO crashed the compiler outright. These two helpers make
# the binding width-driven and type-carrying, mirroring exactly what PARSE_FN_DEF does for a
# real (non-inlined) SIMD param: (nslots-1) anonymous filler slots first, then the NAMED slot
# last at the deepest displacement — which is where `&v` and lane access resolve.
# v6.5.52 — bind ONE value-form SIMD argument on the inline-replay path.
#
# ⛔ WHY THIS EXISTS INSTEAD OF `PCMPE` + STORE. `PCMPE` does not materialise a value-form
# SIMD operand at all — the normal call path routes those in TWO PASSES for a stated reason:
# the arg "MUST be a local", is recorded to a scratch table, and the XMM load is emitted
# AFTER the int args "so int-arg eval (which may clobber XMM during PCMPE) doesn't trample
# SIMD state". Without that, the replay's store wrote whatever XMM0 last held — measured on a
# 2-param call as three consecutive `movupd %xmm0, ...` with no load between them, so both
# params took the previous local's value (f32v4_dot returned 36.0 for an 8.0 case).
#
# The inline path needs no XMM ordinal — the destination is a frame slot, not an ABI register
# — so this copies memory-to-memory and sidesteps the clobber problem entirely: the load and
# the store are ADJACENT instructions, leaving no window for anything to touch XMM0.
#
# Mirrors the normal path's checks: the arg must be an IDENT naming a local whose SLTYPE
# matches the param's class (size-class for 16-byte vectors, exact for f32v4/f64v4), so a
# mismatched vector is rejected rather than silently reinterpreted.
# v6.5.66 — the plain copy, with no provenance recorded. Used by every non-x86 fork, where
# `_F64V_DISP` does not exist and the direct-form/harvest machinery is inert.
fn _inl_simd_arg_copy(S, alli, dst_slot, w): i64 {
    if (w == 4) {
        EFLLOAD_F64V4_PAIR(S, alli);
        EFLSTORE_F64V4_PAIR(S, dst_slot);
        return 0;
    }
    EFLLOAD_F64V2_PAIR(S, alli);
    EFLSTORE_F64V2_PAIR(S, dst_slot);
    return 0;
}

# 6.7.13 (D30 A): a call declared to return the vector is received straight into the parameter's slots, and any
# other source that is no local is refused by name once and skipped (`_sar_vcall` / `_sar_err`, the call path's).
# 6.7.14: the call path's sources, through its `_sar_take` (inside any parentheses wrapping the whole argument), a
# local checked by its class rule there (`_simd_arg_typecheck`: the words this replay's own checks printed).
var _sar_lcl = 0;   # 1 = `_sar_take` took a local: its own slot, nothing copied
fn _inl_simd_arg(S, dst_slot, w, want_t, fi): i64 {
    var ti = GTI(S);
    var alli = _sar_take(S, fi, _vf_cls(S, want_t), 0 - want_t, dst_slot);
    if (alli == 0 - 2) { return _sar_none(S, ti, fi); }
    if (_sar_lcl == 0) { return 0; }   # received into the slot, or refused
    # v6.5.66 — bracket the copy so it can be NOP'd out later if nothing reads the slot.
    #
    # ⛔ x86 ONLY, AND BOTH HALVES OF THAT GATE MATTER. `_F64V_DISP` lives in
    # backend/x86/float.cyr, which ONLY main.cyr / main_win.cyr / main_x86_macho.cyr include — the
    # three aarch64 forks and main_cx.cyr do not, and an undefined fn has been a hard error since
    # v6.3.2. Recording provenance unconditionally broke the aarch64-Mach-O fork outright
    # (rc=256), which is the v6.4.26 trap: a shared parse_fn/parse_expr call needs a peer in every
    # fork. A stub would be worse than useless here — `_prov_harvest` runs in SHARED code, so a
    # stub returning 0 would have it scanning every non-x86 build for displacement 0 and
    # potentially NOP-filling live bytes. Do not record at all off x86.
    if (_AARCH64_BACKEND != 0) { return _inl_simd_arg_copy(S, alli, dst_slot, w); }
    if (_TARGET_CX != 0) { return _inl_simd_arg_copy(S, alli, dst_slot, w); }
    var _pcs = GCP(S);
    if (w == 4) {
        EFLLOAD_F64V4_PAIR(S, alli);
        EFLSTORE_F64V4_PAIR(S, dst_slot);
        _prov_record(dst_slot, alli, _pcs, GCP(S), _F64V_DISP(dst_slot), 4);
        return 0;
    }
    EFLLOAD_F64V2_PAIR(S, alli);
    EFLSTORE_F64V2_PAIR(S, dst_slot);
    # v6.5.65 — record AFTER the store: the store itself invalidates the slot, so recording first
    # would immediately undo it.
    _prov_record(dst_slot, alli, _pcs, GCP(S), _F64V_DISP(dst_slot), 2);
    return 0;
}

fn _inl_store_arg(S, slot, w): i64 {
    if (w == 2) { EFLSTORE_F64V2_PAIR(S, slot); return 0; }
    if (w == 4) { EFLSTORE_F64V4_PAIR(S, slot); return 0; }
    EFLSTORE(S, slot);
    return 0;
}

fn _inl_bind_param(S, base, w, named, noff, t): i64 {
    var j = 0;
    while (j < w - 1) {
        S64(S + 0x5D9D000 + (base + j) * 8, 0 - 1);   # anon filler
        SLDEP(S, base + j, 0);
        SLTYPE(S, base + j, 0);
        j = j + 1;
    }
    S64(S + 0x5D9D000 + named * 8, noff);
    SLDEP(S, named, GSDEP(S));
    # 6.6.5: an inline-replay param wider than one slot IS the aggregate (the replay copies
    # the caller's words into it); a single-slot small struct is a value too.
    if (w > 1) { SLAGG(S, named, w); }
    else { MARK_SMALL_STRUCT(S, named, t); }
    # ⚠ Re-apply the param TYPE. Without this the param is untyped inside the inlined body,
    # which surfaces as a bogus "value-form SIMD arg type mismatch" at its first use — the
    # second of the two defects, independent of the slot-width one above.
    SLTYPE(S, named, t);
    return 0;
}

fn FNV1A_NOFF(S, noff): i64 {
    var h = 0xcbf29ce484222325;
    var i = 0;
    var c = load8(S + 0xEC00000 + noff + i);
    while (c != 0) {
        h = h ^ c;
        h = h * 0x100000001b3;
        i = i + 1;
        c = load8(S + 0xEC00000 + noff + i);
    }
    return h;
}

# v5.6.5 O1: insert (noff → fi) into fn_name_hash at 0x110000 via
# linear probing. Stored value is fi+1 so 0 marks empty (zero-init
# heap gives us free initialization). Called from REGFN after the
# fn_names entry is written. Load factor 0.5 at 4096-fn cap means
# avg ~1.5 probes to insert.
# v6.5.51 — fn-name-hash health, computed ON DEMAND for `CYRIUS_STATS=1` by walking the
# table once. Deliberately NOT a counter incremented inside _REGFN_HASH: that is the hot
# path, and this must cost nothing when the meter is off.
#
# ⭐ IT REPORTS maxprobe, NOT JUST LOAD, because maxprobe is the PROPERTY and load is only
# the mechanism. A gate pinning load alone would pass any future scheme that keeps load low
# while still clustering — the v6.5.36 lesson (an enum gate stayed green through five bad
# releases because it pinned the mechanism, and the mechanism was the thing that was wrong).
# What costs time is displacement from the home slot, so that is what is measured: for every
# occupied slot, re-derive the entry's home slot and report the largest wrap-adjusted
# distance. Measured on a 120,000-fn unit: 65,263 before v6.5.51, 38 after.
fn _fnhash_health(S): i64 {
    var slots = _fnt_hash_mask + 1;
    var used = 0;
    var maxd = 0;
    var sl = 0;
    while (sl < slots) {
        var e = load32(_fnt_namehash + sl * 4);
        if (e != 0) {
            used = used + 1;
            var noff = L64(_fnt_names + (e - 1) * 8);
            var hh = FNV1A_NOFF(S, noff);
            var home = (hh & _fnt_hash_mask);
            var d = ((sl - home) & _fnt_hash_mask);
            if (d > maxd) { maxd = d; }
        }
        sl = sl + 1;
    }
    syscall(SYS_WRITE, 2, "  fn_name_hash: ", 16);
    PRNUM(used);
    syscall(SYS_WRITE, 2, " / ", 3);
    PRNUM(slots);
    syscall(SYS_WRITE, 2, " slots, maxprobe ", 17);
    PRNUM(maxd);
    syscall(SYS_WRITE, 2, "\n", 1);
    return maxd;
}

fn _REGFN_HASH(S, noff, fi): i64 {
    var h = FNV1A_NOFF(S, noff);
    var slot = h & _fnt_hash_mask;
    while (load32(_fnt_namehash + slot * 4) != 0) {
        slot = (slot + 1) & _fnt_hash_mask;
    }
    store32(_fnt_namehash + slot * 4, fi + 1);
    return 0;
}

# v5.10.25 — Phase 3 generalize: detect _str/_int/_cstr suffix on
# the fn name at noff. Used by REGFN to auto-register an overload
# entry in fn_overload_{str,int,cstr} when the base name is also
# defined. Returns:
#   1 = _str  suffix (4 chars)
#   2 = _int  suffix (4 chars)
#   3 = _cstr suffix (5 chars)
#   0 = no recognized suffix
fn _OVERLOAD_SUFFIX(S, noff): i64 {
    var p = S + 0xEC00000 + noff;
    var len = 0;
    while (load8(p + len) != 0) { len = len + 1; }
    if (len > 4) {
        if (load8(p + len - 4) == 95) {
            if (load8(p + len - 3) == 115) {
                if (load8(p + len - 2) == 116) {
                    if (load8(p + len - 1) == 114) { return 1; }
                }
            }
            if (load8(p + len - 3) == 105) {
                if (load8(p + len - 2) == 110) {
                    if (load8(p + len - 1) == 116) { return 2; }
                }
            }
        }
    }
    if (len > 5) {
        if (load8(p + len - 5) == 95) {
            if (load8(p + len - 4) == 99) {
                if (load8(p + len - 3) == 115) {
                    if (load8(p + len - 2) == 116) {
                        if (load8(p + len - 1) == 114) { return 3; }
                    }
                }
            }
        }
    }
    return 0;
}

# Grow the fn-table family 2x: realloc + copy all 16 parallel 8 B/slot tables,
# realloc the start-hash (rebuilt each fixup, so no copy needed), then rebuild
# the name-hash at the new size and re-insert every live entry. Old buffers leak
# (cycc is short-lived). Ceiling 131072 since v6.5.40 (it was 32768 while the
# hash slots were 2 B: they store fi+1, so the index had to stay < 65536); the
# slots are 4 B now (the note below). v6.2.0 Phase 0 / AR-03. See util.cyr for the
# gvar family.
fn _fnt_grow(S): i64 {
    var nc = _fnt_cap * 2;
    if (nc > 131072) {
        syscall(SYS_WRITE, 2, "error: too many functions (max 131072)\n", 39);
        syscall(SYS_EXIT, 1);
    }
    var oc = _fnt_cap;
    _fnt_cstrmask  = _fnt_copy_table(_fnt_cstrmask,  oc, nc);
    _fnt_resmask   = _fnt_copy_table(_fnt_resmask,   oc, nc);
    _fnt_optmask   = _fnt_copy_table(_fnt_optmask,   oc, nc);
    _fnt_tagmask   = _fnt_copy_table(_fnt_tagmask,   oc, nc);
    _fnt_ovstr     = _fnt_copy_table(_fnt_ovstr,     oc, nc);
    _fnt_ovint     = _fnt_copy_table(_fnt_ovint,     oc, nc);
    _fnt_ovcstr    = _fnt_copy_table(_fnt_ovcstr,    oc, nc);
    _fnt_simdmask  = _fnt_copy_table(_fnt_simdmask,  oc, nc);
    _fnt_names     = _fnt_copy_table(_fnt_names,     oc, nc);
    _fnt_offsets   = _fnt_copy_table(_fnt_offsets,   oc, nc);
    _fnt_params    = _fnt_copy_table(_fnt_params,    oc, nc);
    _fnt_bodystart = _fnt_copy_table(_fnt_bodystart, oc, nc);
    _fnt_bodyend   = _fnt_copy_table(_fnt_bodyend,   oc, nc);
    _fnt_inline    = _fnt_copy_table(_fnt_inline,    oc, nc);
    _fnt_strmask   = _fnt_copy_table(_fnt_strmask,   oc, nc);
    _fnt_codeend   = _fnt_copy_table(_fnt_codeend,   oc, nc);
    _fnt_structmask = _fnt_copy_table(_fnt_structmask, oc, nc);
    # start-hash is rebuilt from scratch each fixup pass — just give it a
    # cap-sized buffer (contents irrelevant; the fixup clear loop zeroes it).
    # v6.5.51 — TWO hash slots per fn-table entry, so the open-addressed tables never
    # exceed 50 % load. They used to be nc slots for an nc-entry table, and REGFN only
    # grows once `fc >= _fnt_cap`, so the name hash filled to EXACTLY 100 % before every
    # doubling. Linear probing at that load degenerates into a full-table scan: measured
    # max probe 65,263 on a 131,072-slot table, 31.5 MILLION probes for one 120,000-fn
    # compile. Two slots per entry caps the load at 50 %, where the measured max probe is
    # 38 and the total is 131,892 — a 239x reduction that removes the superlinearity
    # outright (5.3 us/fn, flat from 34k to 120k fns).
    # Only these TWO tables double; the 17 payload tables above are untouched, so the cost
    # is ~2 MB at the 131,072 ceiling. Output is byte-identical: the hash is a lookup
    # accelerator whose probe ORDER changes but whose answers do not.
    _fnt_starthash = alloc(nc * 8);  # nc*2 slots x 4 B
    _fnt_namehash  = alloc(nc * 8);  # nc*2 slots x 4 B
    _fnt_hash_mask = nc * 2 - 1;
    _fnt_cap = nc;
    var i = 0;
    while (i < oc) {
        _REGFN_HASH(S, L64(_fnt_names + i * 8), i);
        i = i + 1;
    }
    return 0;
}

# Register new function, return index
# ⚡ v6.5.42 — HASH LOOKUP FOR `<name>_str` / `_int` / `_cstr`, replacing an O(n^2) scan.
#
# REGFN's REVERSE overload registration walked EVERY already-registered fn for every new one,
# looking for a sibling named `<my_name>_<suffix>`. That is quadratic in fn count by
# construction: at 60,000 fns it is ~1.8x10^9 name comparisons. MEASURED on the 60k fixture —
# 43.5 s with the scan, 23.6 s with it disabled, so it was **46 % of total compile time**, and
# the share grows with the square. (Filed as `2026-09-02-compile-time-superlinear-in-fn-count`,
# which named this as the strongest candidate; the measurement confirms it. ⚠ 23.6 s is still
# slow for 60k fns, so a SECOND quadratic contributor remains — see that filing.)
#
# The replacement is exactly equivalent, not an approximation: the scan was looking for a fn
# whose name is the concatenation `<my_name>` + `<suffix>`, so three direct lookups of those
# three names find precisely the same set. Equivalence is verifiable rather than argued —
# cycc's output must stay BYTE-IDENTICAL, and it does.
#
# ⚠ `_FINDFN_CSTR` cannot be used here: it is itself a linear scan, so three calls would make
# the cost WORSE, not better. This probes the hash table directly.
#
# ⚠ Hash slots are 4 BYTES since v6.5.40 (the fn ceiling went 32768 -> 131072, which required
# widening them from 2). Reading them as 2 would silently find the wrong entries.

# FNV-1a over the NUL-terminated name at `noff`, continued over `suflen` bytes at `suf`.
fn _fnv_noff_suffix(S, noff, suf, suflen): i64 {
    var h = 0xcbf29ce484222325;
    var i = 0;
    var c = load8(S + 0xEC00000 + noff + i);
    while (c != 0) {
        h = h ^ c;
        h = h * 0x100000001b3;
        i = i + 1;
        c = load8(S + 0xEC00000 + noff + i);
    }
    var j = 0;
    while (j < suflen) {
        h = h ^ load8(suf + j);
        h = h * 0x100000001b3;
        j = j + 1;
    }
    return h;
}

# 1 if the name at `sn` is exactly `<name at noff>` ++ `<suflen bytes at suf>`.
fn _name_is_noff_suffix(S, sn, noff, suf, suflen): i64 {
    var i = 0;
    var c = load8(S + 0xEC00000 + noff + i);
    while (c != 0) {
        if (load8(S + 0xEC00000 + sn + i) != c) { return 0; }
        i = i + 1;
        c = load8(S + 0xEC00000 + noff + i);
    }
    var j = 0;
    while (j < suflen) {
        if (load8(S + 0xEC00000 + sn + i + j) != load8(suf + j)) { return 0; }
        j = j + 1;
    }
    # must END there — otherwise `foo_string` would match a lookup for `foo_str`.
    if (load8(S + 0xEC00000 + sn + i + suflen) != 0) { return 0; }
    return 1;
}

# fn index of `<name at noff><suffix>`, or -1.
fn _findfn_noff_suffix(S, noff, suf, suflen): i64 {
    var h = _fnv_noff_suffix(S, noff, suf, suflen);
    var slot = h & _fnt_hash_mask;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_namehash + slot * 4);
        if (stored == 0) { probes = _fnt_cap; }
        else {
            var fi = stored - 1;
            var sn = L64(_fnt_names + fi * 8);
            if (_name_is_noff_suffix(S, sn, noff, suf, suflen) == 1) { return fi; }
            slot = (slot + 1) & _fnt_hash_mask;
            probes = probes + 1;
        }
    }
    return 0 - 1;
}

fn REGFN(S, noff): i64 {
    var fc = GFNC(S);
    # Grow the fn-table family the moment the count would exceed the cap (the
    # writes below append slot fc). _fnt_cap==0 guards any pre-init call.
    if (_fnt_cap != 0 && fc >= _fnt_cap) { _fnt_grow(S); }
    S64(_fnt_names + fc * 8, noff);
    S64(_fnt_offsets + fc * 8, 0 - 1);
    S64(_fnt_params + fc * 8, 0);
    SFNC(S, fc + 1);
    _REGFN_HASH(S, noff, fc);
    # v5.10.25 — auto-register overload mapping in BOTH directions
    # so include-order doesn't matter:
    #   FORWARD: this fn ends with `_str`/`_int`/`_cstr` AND base
    #            fn already registered → register fc as that base's
    #            overload target.
    #   REVERSE: this fn is a base AND a sibling already-registered
    #            fn matches `<this_name>_str`/`_int`/`_cstr` → register
    #            that sibling as fc's overload target.
    # Without bidirection, lib/str.cyr's `println_str` defined BEFORE
    # lib/string.cyr's `println` would never get registered.
    var _ov_p = S + 0xEC00000 + noff;
    var _ov_my_len = 0;
    while (load8(_ov_p + _ov_my_len) != 0) { _ov_my_len = _ov_my_len + 1; }
    # FORWARD direction
    var _ov_kind = _OVERLOAD_SUFFIX(S, noff);
    if (_ov_kind > 0) {
        var _ov_suffix_len = 4;
        if (_ov_kind == 3) { _ov_suffix_len = 5; }
        var _ov_base_len = _ov_my_len - _ov_suffix_len;
        var _ov_base_fi = _FINDFN_CSTR(S, _ov_p, _ov_base_len);
        if (_ov_base_fi >= 0) {
            # v6.4.75 — write through the RELOCATABLE table pointer, not the fixed
            # pre-grow base. _fnt_ovstr/ovint/ovcstr are in the _fnt_grow copy list
            # (they DO grow past 8192), but this forward-registration site alone
            # still wrote `S + 0x97A000 + ...`; once _fnt_grow relocated the table
            # off that fixed base, a forward-registered overload landed in the
            # abandoned region while every reader (parse_fn.cyr:1083/1109) looked at
            # the grown _fnt_ovstr — so overloads registered after a grow silently
            # went missing. The REVERSE-direction writes below already used the
            # pointers; this matches them.
            var _ov_tab = _fnt_ovstr;
            if (_ov_kind == 2) { _ov_tab = _fnt_ovint; }
            if (_ov_kind == 3) { _ov_tab = _fnt_ovcstr; }
            S64(_ov_tab + _ov_base_fi * 8, fc + 1);
        }
    }
    # REVERSE direction — find any already-registered `<my_name>_<suffix>` sibling.
    # ⚡ v6.5.42: three hash lookups, replacing a full walk of every registered fn. See
    # `_findfn_noff_suffix` above for the measurement and the equivalence argument.
    if (_ov_kind == 0) {
        var _rv_s = _findfn_noff_suffix(S, noff, "_str", 4);
        if (_rv_s >= 0) { S64(_fnt_ovstr + fc * 8, _rv_s + 1); }
        var _rv_i = _findfn_noff_suffix(S, noff, "_int", 4);
        if (_rv_i >= 0) { S64(_fnt_ovint + fc * 8, _rv_i + 1); }
        var _rv_c = _findfn_noff_suffix(S, noff, "_cstr", 5);
        if (_rv_c >= 0) { S64(_fnt_ovcstr + fc * 8, _rv_c + 1); }
    }
    return fc;
}

# Find function by name, return index or -1. v5.6.5 O1: hash-table
# fast path first (FNV-1a at 0x110000). Open-addressing with linear
# probing; stop on empty slot or content match via STREQ. Fall through
# to the use-alias linear scan only on hash miss — direct fn-name
# lookups (the >99% hot path) hit the hash and return immediately.
# v6.5.38 — resolve a name that has MULTIPLE definitions, at least one private.
#
# ⭐ THIS IS WHAT MAKES `private` A REAL BOUNDARY. Before this, the fn table held exactly
# one entry per NAME and a second definition overwrote the first ("last definition wins"),
# so a private helper was silently replaced by any same-named fn in any other file —
# INCLUDING for its own file's internal calls. Declaring `private` on both sides did not
# help, because visibility was enforced only at the REFERENCE site, on top of an unchanged
# global symbol table. Filed from owl 1.4.7, where vyakarana and sankoch each define a
# private `_stream_grow` disagreeing about arity, buffer offsets AND return polarity — a
# wrong binding there reports every successful buffer grow as a FAILURE, inside a
# tokenizer, on file content. v6.5.37 closed only the arity-differing case, as an error.
#
# The caller's file comes from the CURRENT TOKEN, not from `_cur_fn_ix` — the same choice
# `_vis_check` documents and for the same reason: the inline-replay path re-parses a
# callee's body while `_cur_fn_ix` still names the enclosing fn, so the fn table would
# answer for the wrong file.
#
# Preference order, and each arm matters:
#   1. a definition PRIVATE TO THE CALLER'S OWN FILE — the file's own helper always wins
#      inside that file, which is precisely what §1 of the filing got wrong;
#   2. otherwise the first NON-private definition — a public fn stays reachable from
#      everywhere, so splitting a name does not hide an ordinary API;
#   3. otherwise the first match, so the caller is referencing someone else's private fn
#      and `_vis_check` produces the existing "is private to its file" error. Returning -1
#      here instead would turn a precise diagnostic into "undefined function".
fn _findfn_scoped(S, noff, slot, first): i64 {
    var caller = FM_FILEID(S, GTLINE(S, GTI(S)));
    var pub_pick = 0 - 1;
    var s2 = slot;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_namehash + s2 * 4);
        if (stored == 0) { probes = _fnt_cap; }
        else {
            var fi = stored - 1;
            var sn = L64(_fnt_names + fi * 8);
            if (STREQ(S, sn, noff) == 1) {
                if ((GFLG(S, fi) & 64) != 0) {
                    var owner = GFFI(S, fi) - 1;      # GFFI stores fid+1; 0 = unknown
                    if (owner >= 0) { if (owner == caller) { return fi; } }
                }
                else { if (pub_pick < 0) { pub_pick = fi; } }
            }
            s2 = (s2 + 1) & _fnt_hash_mask;
            probes = probes + 1;
        }
    }
    if (pub_pick >= 0) { return pub_pick; }
    return first;
}

fn FINDFN(S, noff): i64 {
    var h = FNV1A_NOFF(S, noff);
    var slot = h & _fnt_hash_mask;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_namehash + slot * 4);
        if (stored == 0) { probes = _fnt_cap; }
        else {
            var fi = stored - 1;
            var sn = L64(_fnt_names + fi * 8);
            if (STREQ(S, sn, noff) == 1) {
                # v6.5.38 — bit 7 (128) = "this NAME has more than one definition, and at
                # least one of them is private". Set only by the split in PARSE_FN_DEF, so
                # it is clear for every fn in a normal program: the common path still
                # returns on the first match with no extra work and no file-map lookup.
                if ((GFLG(S, fi) & 128) != 0) { return _findfn_scoped(S, noff, slot, fi); }
                return fi;
            }
            slot = (slot + 1) & _fnt_hash_mask;
            probes = probes + 1;
        }
    }
    # Check use aliases: if noff matches a use_from, look up use_to
    var uc = GUSEC(S);
    var i = 0;
    while (i < uc) {
        var ufrom = L64(S + 0x18FFD0 + i * 8);
        if (STREQ(S, ufrom, noff) == 1) {
            var uto = L64(S + 0x1901D0 + i * 8);
            return FINDFN(S, uto);
        }
        i = i + 1;
    }
    # 6.7.0 (A2): `T_Trait_m`, and an ambiguous `T_m` (reported; -1). See `_tr_fallback`.
    if (_ti_n > 0) {
        var _tq = _tr_fallback(S, noff);
        if (_tq >= 0) { return _tq; }
        if (_tq == 0 - 2) { return 0 - 1; }
    }
    # v6.4.3: f64v2(...) / f64v4(...) constructor sugar. An f64v2/f64v4 call
    # name that is NOT a real fn resolves to the lib constructor f64v2_make /
    # f64v4_make (lib/simd.cyr) — the natural `type(...)` spelling over the
    # proven make (agnos FP issue §2). Only fires as a fallback: a real fn
    # named f64v2 is found by the hash probe above and takes precedence.
    var _cp = S + 0xEC00000 + noff;
    if (load8(_cp) == 0x66) {                 # 'f'
        if (load8(_cp + 1) == 0x36) {         # '6'
            if (load8(_cp + 2) == 0x34) {     # '4'
                if (load8(_cp + 3) == 0x76) { # 'v'
                    var _cd = load8(_cp + 4);
                    if (load8(_cp + 5) == 0) {          # exactly "f64vN"
                        if (_cd == 0x32) {              # '2'
                            var _mk2 = _FINDFN_CSTR(S, "f64v2_make", 10);
                            if (_mk2 >= 0) { return _mk2; }
                        }
                        if (_cd == 0x34) {              # '4'
                            var _mk4 = _FINDFN_CSTR(S, "f64v4_make", 10);
                            if (_mk4 >= 0) { return _mk4; }
                        }
                    }
                }
            }
        }
    }
    return 0 - 1;
}

# v5.7.31: find fn index by literal c-string name (str_ptr / str_len).
# Used by parse_expr.cyr's aarch64 polyfill dispatch for f64_exp /
# f64_ln, where the lookup target is a fixed compiler-internal name
# rather than a user IDENT (whose noff would be available via
# PEEKV). Linear scan over GFCNT(S) entries; the str_data names are
# NUL-terminated, so we match str_len bytes AND verify the trailing
# NUL to avoid prefix matches. Returns fn index or -1.
# v5.11.37: _FINDFN_CSTR relocated to src/common/util.cyr so backend
# emit.cyr files can resolve polyfill fn indices without forward refs.
# See util.cyr for the definition.

# NOTE: Arch-specific function emit functions (EFNPRO, ESUBRSP, EFNEPI,
# ECALLTO, ECALLFIX, EPOPARG, ECALLPOPS, ECALLCLEAN, ESTOREREGPARM,
# ESTORESTACKPARM, ESTOREPARM, EFLLOAD, EFLSTORE) are in the
# arch-specific emit files (EDISP32 is x86-only):
#   x86_64:  src/backend/x86/emit.cyr
#   aarch64: src/backend/aarch64/emit.cyr

# Find fn local variable by name
fn FINDLOCAL(S, noff): i64 {
    var lc = GFLC(S);
    var i = lc - 1;
    # Search backward so inner scope shadows outer
    while (i >= 0) {
        var sn = L64(S + 0x5D9D000 + i * 8);
        if (sn >= 0) { if (STREQ(S, sn, noff) == 1) { return i; } }
        i = i - 1;
    }
    return 0 - 1;
}

# ================================================================
# PARSER — STATEMENT DISPATCH + FUNCTION SUPPORT
# ================================================================

# ⭐ 6.6.7 — THE TAIL ARM'S DIVERT LIST, IN ONE PLACE. `return IDENT(args);` is lowered to
# epilogue + `jmp` (ETAILJMP; the same shape on cx since 6.6.12), which reaches NOTHING the normal
# return does: not the return landing, not the defer walker, not PARSE_FNCALL. Every obligation
# PARSE_FNCALL or the epilogue carries therefore had to be re-discovered here, one silent wrong
# value at a time, and bolted on as its own `tc_has_addr = 1` line — fifteen diverts by 6.6.7
# (plus checks copied into the emission itself: arity, #pure, #deprecated and the Win64 argument
# ceiling — a fifth, SIMD_TC, was unreachable behind `_tc_callee_divert`'s SIMD lines and went in
# 6.6.20), spread over two hundred lines, while the standing note and a code comment each counted
# four. The diverts live in these four predicates now; a new obligation is
# a new line HERE. 1 = take the normal
# call path. ⚠ Every test is read-only (FINDFN, masks, token peeks) — order is free.
# ⚠ Over-diverting is NOT free: it costs the tail call, and a self-recursive tail call that
# loses it grows the stack (6.6.5 measured a correct program turned into rc 139). Each test is
# the exact question of the thing it protects, never an approximation. CHANGELOG [6.6.7]
fn _tc_must_divert(S, cfi, ti_after): i64 {
    if (_tc_frame_divert(S, cfi) == 1) { return 1; }
    if (_tc_callee_divert(S, cfi) == 1) { return 1; }
    if (_tc_args_divert(S, cfi, ti_after) == 1) { return 1; }
    if (_tc_generic_divert(S, cfi, ti_after) == 1) { return 1; }   # 6.6.10
    return 0;
}
# What THIS fn must still do after the callee returns, or what its frame must outlive.
fn _tc_frame_divert(S, cfi): i64 {
    # 6.6.7 — a fn with a `defer` or `secret var` ANYWHERE in its body: the jmp skipped the walker,
    # so the block never ran and a secret was never zeroised (the tail-call secret-var wipe gap). The WHOLE body,
    # prescanned
    # at its `{` (`_body_has_defer`) — a registered-so-far count misses a loop whose tail return
    # lexically precedes the defer. Such a fn never tail-calls; a deep self-recursion needs a loop.
    if (_cur_fn_has_defer == 1) { return 1; }
    # 6.6.7 — a tail call pushes nothing onto rp_vec, which is how _PARSE_DEFER refuses a
    # `return` inside a defer body. (Subsumed by the line above; kept as the defer arm's own rule.)
    if (_in_defer == 1) { return 1; }
    # 6.6.8 — a coroutine's completion (`_coro_mark_done`: state DONE + the stored result) lives
    # in the epilogue a `jmp` skips, so a tail-shaped `return f(x);` left it resumable and every
    # later force re-ran the tail. CHANGELOG [6.6.8]
    if (_cur_fn_coro == 1) { return 1; }
    # v6.5.14 — a pointer to a local laundered through a variable (`var p = &buf; return f(p);`):
    # the epilogue frees the frame the callee reads. Set wherever this fn materialises `&local`,
    # and since 6.6.20 wherever such an address escapes implicitly (`_sarg_escapes`; rule 1
    # above `_tc_after_args_divert`). Set SO FAR: inside a loop, a 0 here is not yet the answer
    # — the call waits for the end of its outermost loop (`_tcp_site`). CHANGELOG [6.7.3]
    if (_fn_local_addr == 1) { return 1; }
    # 6.6.6 — a struct-returning CALLER copies into its own retptr, which a `jmp` cannot do.
    if (_cur_fn_ret_sid > 0) { if (_cur_fn_ret_stash > 0) { return 1; } }
    # 6.6.6 — the rax:rdx PAIR and the VECTOR classes: a `jmp` hands the callee's return
    # convention straight to OUR caller, right only when the callee returns this same type the
    # same way (`return s2b(1);` from a `: P2` fn left rdx unwritten). The normal path is where
    # `_refuse_pair_return` / `_refuse_simd_return` see the shape.
    if (_cur_fn_ret_pair == 1) { if (_pair_ret_call_ok(S) == 0) { return 1; } }
    if (_cur_fn_returns_vector(S) == 1) { if (_simd_ret_call_ok(S) == 0) { return 1; } }
    if (_tc_small_sret_divert(S, cfi) == 1) { return 1; }   # 6.7.11: the struct class of 8 B or less
    if (_tc_f64_ret_divert(S, cfi) == 1) { return 1; }   # 6.6.20: the scalar f64 class
    # v6.4.31 — a SIMD-returning fn on Win64 returns through a hidden retptr in RCX, which the tail
    # path's argument marshalling overwrites (`return f32v4_make(...)` SIGSEGV'd).
    if (_TARGET_PE == 1) {
        if (_cur_fn_ret_stash > 0) {
            if (_cur_fn_returns_vector(S) == 1) { return 1; }
        }
    }
    return 0;
}
# 6.7.11 — the struct class of 8 B or less, the same rule as the pair line above: a `jmp` hands our
# caller the callee's rax as this fn's struct, right only when the callee returns this same struct
# (or an untyped word). `return mk();` with `fn mk(): U8` from a `: S8` fn returned U8's bytes as an
# S8, unchecked — the normal path is where `_ret_small_val` refuses it by name; and `return gp();` with
# `fn gp(): *S8` handed back the POINTER as the struct — the normal path copies the struct it points at
# (`_ret_small_ptr`). CHANGELOG [6.7.11]
fn _tc_small_sret_divert(S, cfi): i64 {
    if (cfi < 0) { return 0; }
    if (_ret_small_cls(S) == 0) { return 0; }
    var rs = GFRS(S, cfi);
    if (_hl_fn_psid(cfi) > 0) { return 1; }   # a `: *X` callee: its struct is copied (or refused)
    if (rs <= 0) { return 0; }
    if (rs >= 2048) { return 0; }
    if (rs != _cur_fn_ret_sid) { return 1; }
    return 0;
}
# 6.6.20 — the SCALAR f64 class, the same rule as the pair / vector lines above. On the x86
# family a `: f64` fn hands its result back in xmm0 (`_ret_box_f64` at the return landing) and
# every call site reads xmm0 (`_call_ret_marks`), so a `jmp` is right only into a callee that
# boxes too: `return f64_max(a, b);` from a `: f64` fn returned the operand the last compare
# left in xmm0 — the SMALLER one — exit 0. A `: f64` callee keeps its tail call, so self- and
# mutual f64 recursion stay TCO (the prescan records GFRS for a fn declared below). aarch64 and
# cx return an f64 in x0 / r0, the integer register, so there is nothing to divert for.
fn _tc_f64_ret_divert(S, cfi): i64 {
    if (_cur_fn_ret_scalar != 0 - 9) { return 0; }
    if (_AARCH64_BACKEND != 0) { return 0; }
    if (_TARGET_CX != 0) { return 0; }
    if (cfi < 0) { return 1; }
    if (GFRS(S, cfi) != 0 - 9) { return 1; }
    return 0;
}
# What the CALLEE needs from PARSE_FNCALL that the tail path's plain argument loop never does.
fn _tc_callee_divert(S, cfi): i64 {
    # v6.5.17 — fncall0..8 are INDIRECT calls; `jmp fncallN` skipped the closure dispatch.
    if (_IS_FNCALL_NAME(S, PEEKV(S)) == 1) { return 1; }
    # 6.6.11 — `sizeof` / `mulh64` are lowered inline by PARSE_FACTOR; there is no fn to jump to.
    if (_is_ident_intrinsic(S, PEEKV(S)) == 1) { return 1; }
    # 6.6.6 — a >16 B struct-returning callee writes through a retptr the tail path never passes.
    if (_ret_agg_class(S, cfi) == 2) { return 1; }
    if (cfi < 0) { return 0; }
    # 6.7.8 — a dyn-returning callee from a fn that does not return that dyn: the `jmp` handed our
    # caller the dyn's DATA word as this fn's value (`return mk();` in an i64, untyped, `*T` or
    # closure body) — the normal path is where V4 refuses it.
    if (_dyn_is(S, GFRS(S, cfi)) == 1) { if (_cur_fn_ret_sid != GFRS(S, cfi)) { return 1; } }
    # (v6.3.36's "any address-passed param diverts" is replaced since 6.6.20 by the rules above
    # `_tc_after_args_divert`.)
    # v6.4.53 — value-form SIMD params travel in vector registers; the tail path loads only the
    # integer ones (`return f32v4_add(v, v)` returned v). These two lines also make PARSE_FNCALL's
    # SIMD argument class check the only one a tail-shaped call needs (6.6.20).
    if (L64(_fnt_simdmask + cfi * 8) != 0) { return 1; }
    if (_pm_row_any(cfi, 0xC0) != 0) { return 1; }   # 6.6.17 (a10)
    # v6.5.1 — an overload-suffix sibling: the `_str`/`_int` dispatch lives only in PARSE_FNCALL
    # (`return println(myStr);` silently called the cstr base).
    if (L64(_fnt_ovstr + cfi * 8) != 0) { return 1; }
    if (L64(_fnt_ovint + cfi * 8) != 0) { return 1; }
    return 0;
}
# What the ARGUMENT LIST needs. The scan runs to the call's matching `)`.
fn _tc_args_divert(S, cfi, ti_after): i64 {
    # 6.7.7 (B6) — a call that fills a parameter default or names an argument is PARSE_FNCALL's: the
    # one marshaller is the only site that fills (the tail arm's `_CHECK_ARITY` mode 3 makes a miss
    # here loud). A full-arity positional call to a defaulted fn keeps its `jmp`. CHANGELOG [6.7.7]
    if (_pd_call_fills(S, cfi, ti_after) == 1) { return 1; }
    var has_lit = 0;
    var depth = 1;
    var i = ti_after + 1;
    while (i < GTCNT(S)) {
        var t = TOKTYP(S, i);
        if (t == 10) { depth = depth + 1; }
        if (t == 11) { depth = depth - 1; if (depth == 0) { break; } }
        # v5.8.16 — `&local` spelled in the arg list: the callee reads the frame the jmp frees.
        if (t == 27) { return 1; }
        if (t == 1) { has_lit = 1; }
        i = i + 1;
    }
    if (cfi < 0) { return 0; }
    # v6.5.2 — an integer literal into a `: cstring` param is refused by PARSE_FNCALL only.
    if (has_lit == 1) { if (L64(_fnt_cstrmask + cfi * 8) != 0) { return 1; } }
    if (has_lit == 1) { if (_pm_row_any(cfi, 4) != 0) { return 1; } }   # 6.6.17 (a10)
    # 6.6.5 — a string literal into a `: Str` param is `str_from`-wrapped by PARSE_FNCALL only.
    # `_tc_str_literal_arg` asks PARSE_FNCALL's exact question (the literal is that argument's
    # FIRST token AND that argument's mask bit is set): looser forms were measured to cost a
    # self-recursive tail call its TCO.
    if (_tc_str_literal_arg(S, ti_after, cfi) == 1) { return 1; }
    return 0;
}
# ⛔ 6.6.20 — AN ADDRESS-PASSED PARAMETER NO LONGER COSTS EVERY TAIL CALL. Any address-passed
# parameter (a struct over 8 B as `p: T` or `p: *T`, a Win64 value-form vector) used to divert EVERY
# tail call to its fn, so a `p: *Node` list walk, `return walk(p.next, acc + p.v);`, recursed with
# `call` and a 2,000,000-node list overflowed the stack — a pointer argument carries no frame
# address. The tail arm now pushes each argument exactly as PARSE_FNCALL does
# (`_try_push_struct_addr_arg`), so the one hazard left is the one a `jmp` adds: an address IN THIS
# FRAME reaching the callee, directly or laundered through a value (`var x = idp(s); return dP(x, k);`
# — the pointer `idp` hands back is `&s`). Three rules close it, none a guess at an argument's shape:
#   1. `_fn_local_addr` (`_tc_frame_divert`) is set wherever an address in this fn's own frame
#      escapes: `&local`, and every implicit push of one (`_sarg_escapes`) — an inline aggregate
#      argument (a by-value parameter's copy included), a struct call's or method's temp, a field of
#      a frame aggregate, a method's `self`, an operator's operand — UNLESS it is pushed to an
#      ordinary call whose callee copies that parameter in its prologue (`_pm_copies`: a `p: T`
#      over 8 B, a Win64 vector), which holds nothing once the call returns. So passing an inline
#      struct to a `*T` or untyped parameter, a `*T` / untyped `self`, an untyped operator or a
#      `#naked` fn before a tail call costs that tail call (the callee may keep the pointer);
#      passing it by value does not.
#   2. That flag is set-SO-FAR, which is the whole question only where nothing after the return can
#      run before it: outside every loop (the only backward jumps; a `defer` body and a coroutine
#      already divert). Inside a loop a later `x = &s;` runs before the next iteration's return, so
#      there the call waits for the flag at the end of its OUTERMOST loop (`_tcp_site`). 6.6.20
#      diverted an address-passed callee there always and every other callee never — a wrong
#      value for the second, a lost `jmp` for the first. CHANGELOG [6.7.3]
#   3. The call's OWN arguments can create such an address after this decision (`dQ(G, s.me())`,
#      `dP(idu(idp(s)), k)`): the arm emits an ordinary call when they did (`_tc_after_args_divert`).
#      An address pushed AS one of its arguments always counts, by-value callee or not
#      (`return dV(s, k);`): the `jmp` frees the frame before the callee's copy runs.
# CHANGELOG [6.6.20]
# Once the tail arm has evaluated its arguments into their registers: 1 = emit an ordinary call
# instead of the `jmp`. Over the register ceiling the epilogue would free the stack arguments
# ECALLPOPS wrote (6.6.5); and when evaluating an argument took an address in this frame
# (`_fn_local_addr`, 0 when the arm began — `_tc_frame_divert`), it would free what that address
# points at. CHANGELOG [6.6.20]
# 6.7.7 — 1 when THIS tail arm copied a by-value argument into its frame (`_sarg_snap`): the call
# is an ordinary one, but only this one. The copy is read by the callee's prologue during that
# call and by nothing after it, so it is not `_fn_local_addr`, which costs every later tail call
# in the fn (and every pending one in an enclosing loop) its `jmp`. Cleared where the arm starts
# its arguments and restored after its verdict: a closure literal or a generic instance among
# those arguments runs its own arms. CHANGELOG [6.7.7]
var _tc_snap_div = 0;
fn _tc_after_args_divert(argc): i64 {
    if (argc > _ARG_REG_COUNT()) { return 1; }
    if (_fn_local_addr == 1) { return 1; }
    if (_tc_snap_div == 1) { return 1; }
    return 0;
}
# The ordinary call the tail arm takes instead of the `jmp`, its arguments already in their
# registers: call, clean up, and jump to the return landing like any other `return`.
fn _tc_emit_call(S, fi, argc): i64 {
    var foff = L64(_fnt_offsets + fi * 8);
    if (foff >= 0) { ECALLTO(S, foff); }
    else { ECALLFIX(S, fi); }
    ECALLCLEAN(S, argc);
    vec_push(rp_vec, EJMP0(S));
    return 0;
}
# ⛔ 6.7.3 — A TAIL CALL INSIDE A LOOP WAITS FOR ITS VERDICT. `_fn_local_addr` is set SO FAR, so
# a `return f(..);` that comes EARLIER in a loop body than the statement taking a frame address
# (`while (..) { if (i == 1) { return rd(x, k); } x = &s; .. }`) found it 0, kept its `jmp`, and
# on the next iteration handed `rd` a pointer into the frame the `jmp` had just freed: a silent
# wrong value on every backend since 6.5.14, through `&s` and through each implicit address
# 6.6.20 flags (a method's `self`, an operator's operand, a field of an inline aggregate, ..).
# A prescan cannot answer it — since 6.6.20 most of what sets the flag depends on types and on
# the callee's signature — and bodies are parsed once. So the site is emitted with a SELECTOR
# `jmp` in front of the tail sequence, and decided once the flag is final for it: when its
# OUTERMOST enclosing loop ends (`_tcp_loop_end`, after the whole loop statement, a C-style
# `for`'s step included). Nothing after that loop can run before the call again (cyrius has no
# goto; its only back-edges are loops), and an address taken BEFORE the loop already diverted
# the call (`_tc_frame_divert`), so the flag then is exactly "an address was taken in this
# loop". A fn that takes an address only AFTER the loop keeps its `jmp`. Every nested body (a
# closure, a generic instance) has its own range of sites (`_tcp_base`, in the `_fnst_save`
# snapshot) and its own flag. Record (64 B): +0 the selector, +8 the tail sequence's start,
# +16 the callee, +24 argc, +32/+40/+48 `_xdepth` / `_xcall_pad` / `_xcall_d` (ETAILJMP consumes
# what ECALLCLEAN needs), +56 the verdict: 0 = open, 1 = keep, 2 = divert. CHANGELOG [6.7.3]
fn _tcp_len(): i64 {
    if (_tcp_vec == 0) { return 0; }
    return vec_len(_tcp_vec);
}
fn _tcp_site(S, fi, argc): i64 {
    if (_tcp_vec == 0) { _tcp_vec = vec_new(); }
    var r = alloc(64);
    store64(r, EJMP0(S));
    store64(r + 8, GCP(S));
    store64(r + 16, fi);
    store64(r + 24, argc);
    store64(r + 32, _xdepth);
    store64(r + 40, _xcall_pad);
    store64(r + 48, _xcall_d);
    store64(r + 56, 0);
    vec_push(_tcp_vec, r);
    ETAILJMP(S, fi);
    return 0;
}
# Called after every loop statement: when it was an outermost one, every site still open in
# this fn was inside it, and the flag now covers that whole loop. Not inside a `defer` body,
# which runs at the fn end (its loop depth restarts at 0 while the loop it sits in is still
# open); a fn with a `defer` never tail-calls anyway (`_cur_fn_has_defer`).
fn _tcp_loop_end(): i64 {
    if (_loop_depth != 0) { return 0; }
    if (_in_defer != 0) { return 0; }
    var n = _tcp_len();
    var i = _tcp_base;
    while (i < n) {
        var r = vec_get(_tcp_vec, i);
        if (load64(r + 56) == 0) { store64(r + 56, 1 + _fn_local_addr); }
        i = i + 1;
    }
    return 0;
}
# A diverted site's ordinary call, emitted out of line at the fn end with the call state its
# arguments were marshalled under.
fn _tcp_stub(S, r): i64 {
    var xd = _xdepth;
    var xc = _xcall_d;
    _xdepth = load64(r + 32);
    _xcall_pad = load64(r + 40);
    _xcall_d = load64(r + 48);
    _tc_emit_call(S, load64(r + 16), load64(r + 24));
    _xdepth = xd;
    _xcall_pad = 0;
    _xcall_d = xc;
    return 0;
}
# At the body's end (PARSE_FN_DEF and the closure path, before the return landing): a kept
# site's selector becomes a jump to the next instruction (the SCP trick `_defer_emit_init`
# plays on the fn-entry jmp); a diverted one's jumps to its stub. The body's fall-through is
# routed round the stubs. An open site is impossible (its loop ended inside this body); it
# would take the whole fn's flag, which is sound.
fn _tcp_resolve(S): i64 {
    var n = _tcp_len();
    var i = _tcp_base;
    var routed = 0;
    while (i < n) {
        var r = vec_get(_tcp_vec, i);
        var v = load64(r + 56);
        if (v == 0) { v = 1 + _fn_local_addr; }
        if (v == 2) {
            if (routed == 0) { vec_push(rp_vec, EJMP0(S)); routed = 1; }
            EPATCH(S, load64(r));
            _tcp_stub(S, r);
        } else {
            var cp = GCP(S);
            SCP(S, load64(r + 8));
            EPATCH(S, load64(r));
            SCP(S, cp);
        }
        i = i + 1;
    }
    if (n > _tcp_base) { vec_truncate(_tcp_vec, _tcp_base); }
    return 0;
}
# Leaving or entering a body with sites still pending means a body emitter skipped
# `_tcp_resolve`: the selector would stay a `jmp +0` (the old wrong value, x86) or a branch to
# itself (aarch64, cx). Loud, unless an error already stopped the compile.
fn _tcp_drop(S): i64 {
    var n = _tcp_len();
    if (n <= _tcp_base) { return 0; }
    if (_had_error == 0) { ERR_MSG(S, "internal: an in-loop tail call was never resolved", 49); }
    vec_truncate(_tcp_vec, _tcp_base);
    return 0;
}

# ⛔ 6.7.7 — THE LANDING OF A MULTI-VALUE RETURN: `return (a, b[, c]);` and `ret2(a, b)`, values in
# the multi-value registers (rax, rdx[, r3]), then the jump to the epilogue. No struct fn's value
# lands here: the tuple literal is refused there (6.7.11, `_refuse_struct_tuple_return`) and `ret2`
# too (6.7.13, `_ret2_in_struct`), so the aarch64 sync of the pair's x1 from the multi-value x2 that
# stood here (ESTRUCT_PAIR_HI_SYNC, 6.7.7) lost its last producer and went; an #inline replay's
# landing inside a struct fn is that call's value, read from x0 / x2. The other direction — a
# `return p;` read by `var a, b = f();` / `rethi()` — is EFLLOAD_STRUCT_INT_PAIR writing x2 too.
# CHANGELOG [6.7.7], [6.7.13]
fn _mret_land(S): i64 {
    if (_dyn_is(S, _cur_fn_ret_sid) == 1) {   # 6.7.8 (V7): a dyn is returned whole, never built from values
        _dyn_err(S, GTI(S) - 1, "a fn returning ", _cur_fn_ret_sid, 0 - 1, " returns a whole dyn - `return (a, b)` / `ret2` would write its words");
    }
    var rp = EJMP0(S);
    vec_push(rp_vec, rp);
    return 0;
}
# ⛔ 6.7.13 — OFF THE END OF A FN DECLARED `: (T1, T2[, T3])` EVERY VALUE IS 0 (D28 C, the user's
# decision, 2026-10-15), the multi-value twin of a bool fn's `false` (6.7.3, `_bx_falloff`): rax, rdx[,
# r3] = 0 on the fall-through path only — every `return` jumps past it to the landing. A body that
# reached its `}` handed the caller's `var a, b = f(0);` whatever an earlier call left in the second
# (and third) register. The #inline replay of such a callee lands the same way (`_mret_falloff_fi`, the
# CALLEE's fi); a #naked body is its own exit. CHANGELOG [6.7.13]
fn _mret_falloff(S): i64 {
    if (_cur_fn_ret_scalar != MULTIRET_SID) { return 0; }
    if (_cur_fn_naked == 1) { return 0; }
    return _mret_zero(S, _cur_fn_ix);
}
fn _mret_falloff_fi(S, fi): i64 {
    if (GFRS(S, fi) != MULTIRET_SID) { return 0; }
    return _mret_zero(S, fi);
}
fn _mret_zero(S, fi): i64 {
    if (fi < 0) { return 0; }
    EMOVI(S, 0);
    if (GFRN(S, fi) == 3) { EMOVR3RAX(S); }
    EMOVRDXRAX(S);
    return 0;
}

# ⛔ 6.7.13 — `ret2(a, b)` LANDS AS `return (a, b);` DOES, so it is judged where that is. Outside every
# fn body — at top level or in a top-level block (GINFN 0) — it is refused by name, as a top-level
# `return` is (6.7.11, `_ret_toplevel`; D20 A, the user's decision, 2026-10-15): the top level has no
# epilogue, so the jump `_mret_land` records was never patched — x86_64 / PE fell through into the next
# statement, aarch64 / cx branched to itself (a hang). Reported once (`_tn_once`: a global initializer
# is parsed in two zones) and in sync: the arguments are parsed on and the panic latch is left as it
# was, so the next statement reports its own errors. 1 = refused: no landing. CHANGELOG [6.7.13]
# In a fn declared `: (T1, T2, T3)` it writes two of the three values — the caller's third read what
# an earlier call left in r3 — so it is refused as a two-value `return (a, b);` is there (6.7.11, D17;
# D21 A, the user's decision, 2026-10-15): "'f' returns 3 values - return (a, b, c)", at the ret2,
# once (a generic's body is parsed per instance), in sync. The landing is kept (no binary is written).
# In a fn declared to return a named struct it is refused in every class, as the tuple literal is (D39,
# `_refuse_struct_tuple_return`; D22 A, the user's decision, 2026-10-15): over 16 B the result pointer
# was never written, at 8 B or less the second value was dropped, at 9-16 B the words came back by ABI
# coincidence only. `_ret2_in_struct`, once and in sync; a dyn keeps `_mret_land`'s V7 text.
fn _ret2_ctx(S, ti): i64 {
    if (GINFN(S) == 1) {
        _ret2_in_struct(S, ti);
        _ret2_in_vector(S, ti);   # 6.7.14 (D43)
        return _ret2_in3(S, ti);
    }
    if (_tn_once(S, ti) == 0) { return 1; }
    var p0 = _panic;
    ERR_MSG(S, "ret2 outside a fn body", 22);
    if (p0 == 0) { _panic = 0; }
    return 1;
}
fn _ret2_in3(S, ti): i64 {
    if (_cur_fn_ret_scalar != MULTIRET_SID) { return 0; }
    if (GIDEP(S) != 0) { return 0; }   # an #inline replay: its definition judged itself
    if (_cur_fn_ix < 0) { return 0; }
    if (_syntax_only == 1) { return 0; }
    if (GFRN(S, _cur_fn_ix) != 3) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var p0 = _panic;
    _mret_ret_err(S, ti);
    if (p0 == 0) { _panic = 0; }
    return 0;
}
# ... in a fn declared `: S` (not `Str`, a tuple or a dyn: `_dx_plain`, D39's own test): the
# struct is the value it returns, never two words. CHANGELOG [6.7.13]
fn _ret2_in_struct(S, ti): i64 {
    if (_cur_fn_ret_sid <= 0) { return 0; }
    if (GIDEP(S) != 0) { return 0; }   # an #inline replay: the ret2 is the callee's, not this fn's
    if (_dx_plain(S, _cur_fn_ret_sid) == 0) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": a fn returning the struct `");
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (_cur_fn_ret_sid - 1) * 8));
    PRSTR("` returns that struct — `ret2` writes two values\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;   # the latch is left as it was: the arguments parse on, in sync
    return 0;
}

# ... in a fn declared to return a vector (`: f64v2`, `f32v4`, `f64v4`, `i32v4`, ..): its result is the vector
# registers (on Win64 the result pointer), never rax:rdx, so it is refused by the 6.6.6 vector rule's text, as
# `return (a, b);` and `return ret2(..);` there are (D43, the user's decision, 2026-10-16) — the caller read the
# vector registers' leftovers (0; 41 on cx). Named `ret2` (`_refuse_simd_return` names the cursor's token), at
# the ret2, once, in sync. `return ret2(..);` is that return's own refusal; a closure's ret2 is the closure's,
# an #inline replay's its callee's. CHANGELOG [6.7.14]
fn _ret2_in_vector(S, ti): i64 {
    if (_cur_fn_returns_vector(S) == 0) { return 0; }
    if (GIDEP(S) != 0) { return 0; }
    if (_panic == 1) { return 0; }
    if (TOKTYP(S, ti - 1) == 33) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": a vector-returning fn carries its result in a fixed register pair, so `return` takes a local of that vector type or a call to a fn declared to return the same one — got `ret2`\n");
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;   # the latch is left as it was: the arguments parse on, in sync
    return 0;
}

# ⛔ 6.7.11 — A FN DECLARED `: (T1, T2[, T3])` RETURNS ITS VALUES (the user's decision, 2026-10-13).
# Three spellings write every return register: `return (a, b[, c]);` of the declared arity, `return
# t;` of a tuple (its arm judges the arity and classes, `_ret_tup_ok`), and a whole call — parentheses
# around it transparent — whose callee returns as many values (declared, or recorded in pass 1,
# `_fn_ret_arity`) or cannot be judged (a fn pointer, a callee that may forward a pair). Anything else
# set rax alone and the caller's `b` / `c` read whatever an earlier call left in rdx / r3, silently:
# `return 5;`, `return p;` of a struct local (its first word), a bare `return;`, a literal of another
# arity, a call to a provably one-value, struct, vector or dyn callee or to one of another arity.
# Refused by name at the expression (token `st`), on every target, the tail-call arm included. Judged
# before the arms parse it and reported after them (PARSE_RETURN), so a refusal of their own — `return
# h.p;`'s tuple field, an undefined name — speaks first; in a file that has already failed it is
# reported up front, where the panic latch keeps the statement to one error. An #inline replay parses
# the callee's body in the caller's context: its definition checked itself. Under --syntax-only a
# sibling file's tuple or callee is unknown: silent. 1 = refused, to report after the arms.
# CHANGELOG [6.7.11]
fn _mret_ret_check(S, st): i64 {
    if (_cur_fn_ret_scalar != MULTIRET_SID) { return 0; }
    if (GIDEP(S) != 0) { return 0; }
    if (_cur_fn_ix < 0) { return 0; }
    if (_syntax_only == 1) { return 0; }
    var sv = GTI(S);
    STI(S, st);
    var ok = _mret_ret_ok(S, GFRN(S, _cur_fn_ix));
    STI(S, sv);
    if (ok == 1) { return 0; }
    if (_had_error == 0) { return 1; }
    _mret_ret_err(S, st);
    return 0;
}
# "'f' returns 2 values - return (a, b)" at token `st`, the cursor kept.
fn _mret_ret_err(S, st): i64 {
    var tail = " returns 2 values - return (a, b)";
    if (GFRN(S, _cur_fn_ix) == 3) { tail = " returns 3 values - return (a, b, c)"; }
    var sv = GTI(S);
    STI(S, st);
    ERR_IDENT(S, "", L64(_fnt_names + _cur_fn_ix * 8), tail, 0 - 1);
    STI(S, sv);
    return 0;
}
# ... after the arms: reported unless one of them refused something of its own. The statement is
# whole, so the panic latch is cleared (nothing to resync — the next statement is reported too).
fn _mret_ret_late(S, st, he): i64 {
    if (he != 0) { return 0; }
    if (_had_error != 0) { return 0; }
    _mret_ret_err(S, st);
    _panic = 0;
    return 0;
}
# 1 = the return expression at the cursor writes `want` values (or, a tuple, its own arm judges it).
fn _mret_ret_ok(S, want): i64 {
    var st = GTI(S);
    if (TOKTYP(S, st) == 10) {
        var c = _tup_commas(S, st);
        if (c > 0) {   # the multi-value arm's literal
            if (c + 1 == want) { return 1; }
            return 0;
        }
    }
    var h = _hl_ret_k(S);
    if (h >= 0) {
        if (_ret_tup_idx(S, TOKVAL(S, st + h)) != 0 - 1) { return 1; }
    }
    var k = 0;
    while (TOKTYP(S, st + k) == 10) { k = k + 1; }
    return _mret_call_ok(S, st, k, want);
}
# ... a whole call `g(..)`, `g<..>(..)`, `x.m(..)` or `callptr(..)` (its callee unknown) inside the
# `k` parentheses at `st`, then `;`: 1 = its callee returns `want` values or cannot be judged; 0 = no
# such call, or another count.
fn _mret_call_ok(S, st, k, want): i64 {
    var fi = _ret_whole_call(S, st, k);
    if (fi == 0 - 2) { return 0; }
    return _mret_fwd_ok(S, fi, want);
}
# ... that whole call's fn (-1: unresolved, `callptr(..)` included); -2 = no such call. The cursor is
# kept. Shared with `_ret_mv_fwd` (6.7.13). A generic callee is instantiated here, as the arms would.
fn _ret_whole_call(S, st, k): i64 {
    var sv = GTI(S);
    STI(S, st + k);
    var o = 0 - 1;
    var fi = 0 - 1;
    if (PEEKT(S) == 137) {
        if (TOKTYP(S, st + k + 1) == 10) { o = st + k + 1; }
    } else {
        o = _dt_call_open(S);
        if (o >= 0) { fi = _dt_call_fn(S); }
    }
    STI(S, sv);
    if (o < 0) { return 0 - 2; }
    var e = _call_close(S, o) + 1;
    var j = 0;
    while (j < k) {
        if (TOKTYP(S, e + j) != 11) { return 0 - 2; }
        j = j + 1;
    }
    if (TOKTYP(S, e + k) != 5) { return 0 - 2; }
    return fi;
}
# A forwarded callee `fi` (-1: unresolved): 1 = it returns `want` values, or its count is unknown.
fn _mret_fwd_ok(S, fi, want): i64 {
    if (fi < 0) { return 1; }
    var rs = GFRS(S, fi);
    if (_dyn_is(S, rs) == 1) { return 0; }
    if (rs == MULTIRET_SID) {
        if (GFRN(S, fi) == want) { return 1; }
        return 0;
    }
    if (rs > 0) { return 0; }
    if (rs <= 0 - 2048) { return 0; }
    var ar = _fn_ret_arity(S, fi);
    if (ar != 0) {
        if (ar == want) { return 1; }
        return 0;
    }
    if (_tup_cap_single(S, fi) == 1) { return 0; }
    return 1;
}

# Parse return expr ;  (uses PCMPE so return a == b; works)
# 6.7.11: a fn declared `: (T1, T2[, T3])` returns its values — judged before the arms
# (`_mret_ret_check`), reported after them.
fn PARSE_RETURN(S): i64 {
    if (_ret_toplevel(S) == 1) { return 0; }   # 6.7.11: outside a fn body, refused
    var st = GTI(S) + 1;
    _async_mv_ret(S, st);   # 6.7.11: `return (a, b);` in an async fn
    _ret_mv_fwd(S, st);     # 6.7.13: `return h(..);` of a multi-value call there, or in a <= 8 B struct fn
    var bad = _mret_ret_check(S, st);
    var he = _had_error;
    _PARSE_RETURN_ARMS(S);
    if (bad == 1) { _mret_ret_late(S, st, he); }
    return 0;
}
# The return's arms, each a spelling it emits and leaves by (the 6.6.6 note below).
# Tail call optimization: return fn(args); → epilogue + jmp fn
fn _PARSE_RETURN_ARMS(S): i64 {
    # v6.2.27 (review P2): a #naked fn emits no epilogue, so a `return` would jump
    # to a non-existent epilogue and fall through into the next fn. A naked ISR
    # must self-terminate in asm (iretq/eret) — reject `return` in its body.
    if (_cur_fn_naked == 1) {
        ERR_MSG(S, "return is not allowed in a #naked fn (body must end in asm: iretq/eret)", 71);
    }
    STI(S, GTI(S) + 1);
    # v6.5.67 — PROPAGATE PAIR-RETURNING-NESS. `fn mk(x) { return SOk(x); }` forwards a `: stack`
    # enum's (tag, payload) pair, so `mk` is itself pair-returning and binding ITS result to one
    # variable loses the payload just as surely. Marking the enclosing fn here is what makes the
    # diagnostic reach the idiomatic wrapper shape rather than only the bare constructor.
    # ⚠ Order-dependent by construction: a caller parsed BEFORE the callee's body will not see the
    # flag and degrades to the pre-v6.5.67 behaviour. That is the safe direction for a diagnostic —
    # a missed warning, never a false one.
    # 6.7.13: not inside an inline replay (GIDEP > 0) — `_cur_fn_ix` is still the CALLER there, and the
    # replayed `return` is the call's value, not the caller's (its jump lands at the replay's end); the
    # replayed fn's own entry carries its flag. The two `?` arms are guarded the same way. CHANGELOG [6.7.13]
    if (_cur_fn_ix >= 0) { if (GIDEP(S) == 0) {
            if (_callee_returns_pair(S) == 1) { SFLG(S, _cur_fn_ix, GFLG(S, _cur_fn_ix) | 256); }
        } }
    # Check for tail call: return IDENT(args);
    # Pattern: next token is IDENT, followed by LPAREN
    # Disabled inside inline replay (would emit caller's epilogue)
    if (GINFN(S) == 1) { if (GIDEP(S) == 0) {
            if (PEEKT(S) == 2) {
                var ti_after = GTI(S) + 1;
                if (ti_after < GTCNT(S)) {
                    if (TOKTYP(S, ti_after) == 10) {
                        # Verify it's actually a tail call: find matching ) and check for ;
                        var tc_scan = ti_after + 1;
                        var tc_depth = 1;
                        var tc_is_tail = 0;
                        while (tc_scan < GTCNT(S)) {
                            if (TOKTYP(S, tc_scan) == 10) { tc_depth = tc_depth + 1; }
                            if (TOKTYP(S, tc_scan) == 11) { tc_depth = tc_depth - 1; if (tc_depth == 0) { break; } }
                            tc_scan = tc_scan + 1;
                        }
                        if (tc_scan + 1 < GTCNT(S)) {
                            if (TOKTYP(S, tc_scan + 1) == 5) { tc_is_tail = 1; }
                        }
                        # Every reason to take the normal call path instead is in ONE predicate (above
                        # PARSE_RETURN). CHANGELOG [6.6.7]
                        if (tc_is_tail == 1) {
                            if (_tc_must_divert(S, FINDFN(S, PEEKV(S)), ti_after) == 1) { tc_is_tail = 0; }
                        }
                        if (tc_is_tail == 1) {
                            # Tail call: return fn(args); → evaluate args, epilogue, jmp fn
                            var tcnoff = PEEKV(S);
                            # v6.2.41 — capture call-site line for the arity check.
                            var _tc_line = GTLINE(S, GTI(S));
                            STI(S, GTI(S) + 1);
                            # Parse args (same as PARSE_FNCALL arg handling)
                            STI(S, GTI(S) + 1);  # consume (
                            # 6.6.16 — the token the call's warnings name (PARSE_FNCALL's
                            # convention: the first token after `(`). By the time they fire the
                            # cursor is past `);`, on the NEXT statement. CHANGELOG [6.6.16]
                            var _tc_wti = GTI(S);
                            var tcargc = 0;
                            # The callee's param masks, read up-front (FINDFN is read-only — the
                            # FINDFN/REGFN registration below is unchanged). A callee with a
                            # value-form SIMD param never gets here: `_tc_callee_divert` sends it to
                            # PARSE_FNCALL, whose class check is the only one (the v6.4.15 SIMD_TC
                            # copy that stood here was unreachable; removed 6.6.20).
                            var _tc_prefi = FINDFN(S, tcnoff);
                            var _tc_sd0 = _tc_snap_div;   # 6.7.7: this arm's own copy flag
                            _tc_snap_div = 0;
                            if (PEEKT(S) != 11) {
                                var tcgo = 1;
                                while (tcgo == 1) {
                                    _check_str_cstring_arg(S, _tc_prefi, tcargc, tcnoff);   # 6.6.13 I11
                                    # 6.6.20: an address-passed argument is pushed as PARSE_FNCALL
                                    # pushes it; one that takes an address in this frame sets
                                    # `_fn_local_addr`, read by `_tc_after_args_divert` below.
                                    # 6.7.7: and a by-value argument a later one may write is copied
                                    # where it stands (`_arg_push_snap`) — a frame address: no `jmp`.
                                    _arg_push_snap(S, _tc_prefi, tcargc, tcnoff, 1);   # PCMPE + 6.7.3's bool check
                                    tcargc = tcargc + 1;
                                    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                                    else { tcgo = 0; }
                                }
                            }
                            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
                            STI(S, GTI(S) + 1);  # consume )
                            # Pop args into registers
                            ECALLPOPS(S, tcargc);
                            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                            STI(S, GTI(S) + 1);
                            # Look up function
                            var tcfi = FINDFN(S, tcnoff);
                            if (tcfi < 0) { tcfi = REGFN(S, tcnoff); }
                            _callee_site_checks(S, tcfi, tcnoff, _tc_wti);   # v6.6.4: tail calls warned nothing
                            _bx_tc_ret(S, tcfi, _tc_wti - 2, tcnoff);        # 6.7.3: a bool fn tail-calls a bool fn
                            # v5.8.20: #pure enforcement on the tail-call path —
                            # `return helper(args);` bypasses PARSE_FNCALL but
                            # still needs the #io / #alloc check.
                            if (_cur_fn_is_pure == 1) {
                                var _tcf = GFLG(S, tcfi);
                                if (_tcf & 16 != 0) {
                                    syscall(SYS_WRITE, 2, "warning:", 8);
                                    _err_head_at(S, _tc_wti);
                                    syscall(SYS_WRITE, 2, ": #pure fn calls #io fn '", 25);
                                    PRSTR(S + 0xEC00000 + _fn_src_name(S, tcfi, tcnoff));
                                    syscall(SYS_WRITE, 2, "'\n", 2);
                                }
                                if (_tcf & 32 != 0) {
                                    syscall(SYS_WRITE, 2, "warning:", 8);
                                    _err_head_at(S, _tc_wti);
                                    syscall(SYS_WRITE, 2, ": #pure fn calls #alloc fn '", 28);
                                    PRSTR(S + 0xEC00000 + _fn_src_name(S, tcfi, tcnoff));
                                    syscall(SYS_WRITE, 2, "'\n", 2);
                                }
                            }
                            # v6.2.41 — arity check on the tail-call path
                            # (`return f(args);`). Mutually exclusive with
                            # PARSE_FNCALL (no double-fire); the most common call
                            # form, so covering it closes the bulk of the hole.
                            _CHECK_ARITY(S, _tc_line, tcnoff, tcfi, tcargc, 3);
                            # ⛔ 6.6.5 — this said `tcargc > 6`, the SysV register ceiling, on
                            # every target. On Win64 the ceiling is 4, so `return f5(...)` and
                            # `return f6(...)` took the TAIL-CALL branch: ETAILJMP's `mov rsp,rbp`
                            # tore down the frame ECALLPOPS had just written the stack arguments
                            # into, and the callee read whatever was above the old frame. Silent
                            # wrong values on real Windows (measured: 0 where 3 was right), and
                            # the reason frontend/expr_in_fn_args and stdlib/flags failed as PE.
                            # `_ARG_REG_COUNT()` is the same function the closure ABI uses, so
                            # the two cannot drift. CHANGELOG [6.6.5]
                            # A normal call: over the register ceiling (the tail-call epilogue
                            # would clobber the stack args), or an argument took an address in
                            # this frame (6.6.20). Inside a loop the `jmp` waits for the loop's
                            # end (`_tcp_site`, 6.7.3); elsewhere it is the epilogue + `jmp`.
                            if (_tc_after_args_divert(tcargc) == 1) { _tc_emit_call(S, tcfi, tcargc); }
                            elif (_loop_depth > 0) { _tcp_site(S, tcfi, tcargc); }
                            else { ETAILJMP(S, tcfi); }
                            _tc_snap_div = _tc_sd0;
                            return 0;
                        } }
                }
            }
        } }
    # Check for multi-return: return (a, b) → ret2(a, b)
    if (PEEKT(S) == 10) {
        # The group's own commas tell (a, b) from (a + b) — v6.5.21: COUNTED, so `return (a, b, c);`
        # is arity 3. 6.7.7 (B4): the tuple literal's detector, which steps a closure's `|a, b|` and a
        # generic call's `<A, B>` (`return (|a, b| a + b);` was taken for a multi-value return).
        var mr_commas = _tup_commas(S, GTI(S));
        var mr_is_tuple = 0;
        if (mr_commas > 0) { mr_is_tuple = 1; }
        # ⛔ 6.6.6 — A TUPLE RETURN IS A THIRD SPELLING THE VECTOR REFUSAL BELOW NEVER SEES.
        # Both arms below hand the values back in the ret2/ret3 INT register convention
        # (rax:rdx[:r3]) and `return 0` out of PARSE_RETURN, so they run in front of the
        # `_cur_fn_returns_vector` refusal ~330 lines down exactly the way the tail-call path
        # does. A vector return is a different convention on every target (XMM0/XMM1, V0/V1,
        # four cx R-regs, a PE retptr), so `fn bad(): f64v2 { return (41, 7); }` built clean
        # and the caller read 0 — measured on f64v2, f32v4, i64v2 and the arity-3 form into
        # f64v4. The PAIR class is untouched: rax:rdx IS its ABI. Refuse here and let the arms
        # below parse the tuple anyway, so the token stream stays in sync for the rest of the
        # body. See `_refuse_simd_return`. CHANGELOG [6.6.6]
        if (mr_is_tuple == 1) { _refuse_vector_tuple_return(S); }
        if (mr_is_tuple == 1) { if (mr_commas > 1) {
                # --- arity 3 ---------------------------------------------------
                # Push each value but the last, leave the last in rax, then unwind
                # into the return registers back-to-front. Generalises the arity-2
                # sequence below; nothing here is arity-2-specific.
                if (mr_commas > 2) {
                    ERR_MSG(S, "multi-value return needs 2 or 3 types", 37);
                }
                STI(S, GTI(S) + 1);  # consume (
                _bx_pcmpe_mret(S, 0);   # PCMPE + 6.7.3's bool element check, each element
                EPUSHR(S);                                                          # push a
                if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
                _bx_pcmpe_mret(S, 1);
                EPUSHR(S);                                                          # push b
                if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
                _bx_pcmpe_mret(S, 2);                                               # rax = c
                EMOVR3RAX(S);                                                       # ret3 = c
                EPOPR(S);                                                           # rax = b
                EMOVRDXRAX(S);                                                      # rdx = b
                EPOPR(S);                                                           # rax = a
                if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);  # consume )
                if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1);    # consume ;
                _mret_land(S);
                return 0;
            } }
        if (mr_is_tuple == 1) {
            # Multi-return: return (a, b) → same codegen as ret2(a, b)
            STI(S, GTI(S) + 1);  # consume (
            _bx_pcmpe_mret(S, 0);   # PCMPE + 6.7.3's bool element check
            EPUSHR(S);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);  # consume ,
            _bx_pcmpe_mret(S, 1);
            # rax = b, stack = a → mov rdx, rax; pop rax
            EMOVRDXRAX(S);
            EPOPR(S);
            # A `: f64` fn's first value is boxed into xmm0 at the return landing
            # (`_ret_box_f64`), not here; rdx carries the second. CHANGELOG [6.5.21], [6.6.20]
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);  # consume )
            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1);  # consume ;
            _mret_land(S);
            return 0;
        }
    }
    # v5.5.36 Phase 2b — struct return by value. When the current fn
    # has `: StructName` on its signature, `return IDENT;` (where IDENT
    # is a struct-typed local matching the fn's ret_sid) is emitted as
    # a byte copy from &IDENT into the hidden retptr stashed at fn
    # entry. rax is set to the retptr (standard Win64/SysV convention
    # — caller may read rax to chain the value, though usually ignored
    # in favor of the caller-allocated destination).
    #
    # Only the simple `return IDENT;` form is supported; nested
    # expressions that produce structs (`return make_other();` etc.)
    # land in Phase 2c once call-site rewriting exists.
    # v5.10.2: only the BIG-struct path (stash > 0) uses the
    # byte-copy machinery. ≤16-byte struct returns (Str etc.) get
    # stash = 0 from the rough-scan up-front check; fall through
    # to the scalar return path which treats the local as a
    # pointer value and returns it via rax (matching the existing
    # stdlib convention: `Str` values are 16-byte heap structs
    # passed around as pointers, not by-value).
    if (_cur_fn_ret_sid > 0 && _cur_fn_ret_stash > 0) { return _ret_struct_big(S); }   # 6.7.6: out of this body
    # v5.10.45 Phase 1 — int-class 16B struct pair-return.
    # Fires when the current fn is annotated `: StructName` with
    # STRUCTSZ in [9,16] AND the struct sid != Str's sid AND the
    # return form is `return IDENT;` where IDENT is a 2-slot typed
    # local matching the declared return type. Emits the int-class
    # pair load `mov rax, [&v+0]; mov rdx, [&v+8]` via
    # `EFLLOAD_STRUCT_INT_PAIR` then jumps to the epilogue.
    # Falls through to scalar PCMPE for non-IDENT shapes (those
    # land on a follow-up slot — same staging as f64v2's v5.10.28
    # Phase 1 left non-IDENT to a follow-up).
    if (_cur_fn_ret_pair == 1) { if (_ret_struct_pair(S) == 1) { return 0; } }   # 6.7.6: out of this body
    if (_ret_var_forms(S) == 1) { return 0; }   # 6.7.7 (T5): `return t;`, a tuple; 6.6.17 (a1 review): `return p;`, p: *T, T <= 8 B
    # v5.10.28 — f64v2 multi-register pair return ABI.
    # When the current fn is annotated `: f64v2` (encoding -2093 in
    # _cur_fn_ret_scalar; v6.4.14 moved it off the flat -20) AND the
    # return form is `return IDENT;`
    # where IDENT is a 2-slot stack-local f64v2 var, emit the pair
    # load: rax = lo (named slot, &v+0), rdx = hi (filler slot,
    # &v+8). This is x86 SysV's 16-byte int-class struct return
    # ABI. Falls through to the scalar PCMPE path for non-IDENT
    # f64v2 returns (e.g. fn-call returning f64v2) — those land
    # on a follow-up slot.
    #
    # v5.10.31 — Win64 PE branch (`_cur_fn_ret_stash > 0` for
    # f64v2 set by the rough-scan when _TARGET_PE == 1): emit
    # byte-copy from &v into the retptr stash (size 16, aligned).
    # Win64 PCS for ≤16B composite returns uses retptr-style
    # (caller passes hidden buffer ptr in RCX), NOT pair register.
    # Mirror of the existing big-struct retptr return at line ~447.
    if (_is_simd128(S, _cur_fn_ret_scalar) == 1) {  # any 16B/1-XMM vector (f64v2/f32v4/i32v4/i16v8/i8v16/i64v2)
        if (PEEKT(S) == 2) {
            if (TOKTYP(S, GTI(S) + 1) == 5) {
                var _f2_noff = PEEKV(S);
                var _f2_lli = FINDLOCAL(S, _f2_noff);
                if (_f2_lli >= 0) {
                    var _f2_lt = GLTYPE(S, _f2_lli);
                    if (_is_simd128(S, _f2_lt) == 1) {
                        STI(S, GTI(S) + 1);  # consume IDENT
                        STI(S, GTI(S) + 1);  # consume ';'
                        if (_cur_fn_ret_stash > 0) {
                            # Win64 PE retptr-style return — byte-copy
                            # from &v (size 16) into the retptr stash
                            # at [rbp - regalloc*8 - 8]. ESTRUCT_BYVAL_COPY
                            # handles the rep movsb on x86 / LDRB/STRB
                            # loop on aarch64. Aarch64 stash isn't used
                            # by Win64 (Win64 is x86-only), but the
                            # helper is arch-agnostic and works through
                            # the same ABI helper either way.
                            var _f2w_src_disp = 0 - ((_f2_lli + 1) * 8);
                            if (_cur_fn_regalloc > 0) { _f2w_src_disp = _f2w_src_disp - _cur_fn_regalloc * 8; }
                            if (_cur_fn_ret_stash > 0) { _f2w_src_disp = _f2w_src_disp - _cur_fn_ret_stash; }
                            var _f2w_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
                            ESTRUCT_BYVAL_COPY(S, _f2w_src_disp, _f2w_stash_disp, 16);
                        } else {
                            # SysV/aarch64/cx pair-register return.
                            EFLLOAD_F64V2_PAIR(S, _f2_lli);
                        }
                        var _f2_rp = EJMP0(S);
                        vec_push(rp_vec, _f2_rp);
                        return 0;
                    }
                }
            }
        }
    }
    # v5.10.37 — f64v4 pair-quad return ABI. Mirror of v5.10.28's
    # f64v2 pair-return path, but 32-byte composite + 4-slot stack-
    # local. SysV/aarch64/cx: pair-quad register return (two
    # MOVUPDs on x86 / two LDR Q on aarch64 / four R-regs on cx
    # via EFLLOAD_F64V4_PAIR). Win64 PE: retptr-style with size 32.
    # v6.4.8 (SIMD Phase 4) — generalized from the exact -21 (f64v4) check to
    # _is_simd256 so f32v8 (-2153) shares the identical 32-byte / 2×128-XMM return
    # ABI. Byte-identical for f64v4 (_is_simd256(-21)==1); f32v8 is new. The return
    # value's byte layout is the same 32 bytes regardless of float lane width.
    if (_is_simd256(S, _cur_fn_ret_scalar) == 1) {
        if (PEEKT(S) == 2) {
            if (TOKTYP(S, GTI(S) + 1) == 5) {
                var _f4_noff = PEEKV(S);
                var _f4_lli = FINDLOCAL(S, _f4_noff);
                if (_f4_lli >= 0) {
                    var _f4_lt = GLTYPE(S, _f4_lli);
                    if (_is_simd256(S, _f4_lt) == 1) {
                        STI(S, GTI(S) + 1);  # consume IDENT
                        STI(S, GTI(S) + 1);  # consume ';'
                        if (_cur_fn_ret_stash > 0) {
                            # Win64 PE retptr-style — byte-copy size 32.
                            var _f4w_src_disp = 0 - ((_f4_lli + 1) * 8);
                            if (_cur_fn_regalloc > 0) { _f4w_src_disp = _f4w_src_disp - _cur_fn_regalloc * 8; }
                            if (_cur_fn_ret_stash > 0) { _f4w_src_disp = _f4w_src_disp - _cur_fn_ret_stash; }
                            var _f4w_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
                            ESTRUCT_BYVAL_COPY(S, _f4w_src_disp, _f4w_stash_disp, 32);
                        } else {
                            EFLLOAD_F64V4_PAIR(S, _f4_lli);
                        }
                        var _f4_rp = EJMP0(S);
                        vec_push(rp_vec, _f4_rp);
                        return 0;
                    }
                }
            }
        }
    }
    # 6.6.6 — EVERYTHING THAT REACHES HERE. The two branches above take `return IDENT;` for a
    # local of the matching vector class and return outright; the only other shape the vector
    # return ABI can carry is a call to a fn declared to return the SAME vector type (a register
    # passthrough on SysV/aarch64/cx, the retptr marshalling arm below on PE). Anything else
    # used to fall through to the scalar PCMPE path and hand back a half-written register pair,
    # silently.
    # ⛔ THIS SITE IS ONE OF THREE, AND THE OTHER TWO ARE ABOVE IT — this comment read
    # "EVERYTHING ELSE" when first written and that was FALSE, which is how `return (a, b);`
    # shipped unrefused. PARSE_RETURN is a SEQUENCE OF ARMS, each of which recognises a return
    # spelling, emits it, and `return 0`s out of this function; a check placed here is a check
    # only for the spellings that fall through every arm above to reach it. The two that do not:
    # the TAIL-CALL arm (~line 613, diverted by `_cur_fn_returns_vector` + `_simd_ret_call_ok`)
    # and the MULTI-RETURN arm (~line 909, `_refuse_vector_tuple_return`). Before adding a
    # fourth check here, enumerate the early returns above it again — they are the paths this
    # one cannot see. See `_refuse_simd_return`. CHANGELOG [6.6.6]
    _ret_vec_rule(S);
    if (_ret_vec_take(S) == 1) { return 0; }   # 6.7.13 (D29): `return callptr(&f, ..);` on Win64; 6.7.14 (D35): `*p`
    # v6.4.31: `return <simd_call>(args);` on Win64 PE — a SIMD-returning fn
    # whose return expression is itself a SIMD-returning call (e.g.
    # `f32v4_splat` → `return f32v4_make(x,x,x,x);`). The callee writes its
    # 16/32-byte result via a retptr; the generic PCMPE path can't set that up.
    # Marshal the inner call into an anon temp local (retptr = &temp, args via
    # the same struct-ptr path parse_decl uses), then byte-copy the temp into
    # THIS fn's retptr stash — the exact shape of the `return IDENT;` handler
    # above, just with a fresh call-result temp. SysV/aarch64 keep the generic
    # register-return path (ret_stash == 0). See [[project_v6431_win64_valueform_simd]].
    if (_TARGET_PE == 1) {
        if (_cur_fn_ret_stash > 0) {
            var _rc_is128 = _is_simd128(S, _cur_fn_ret_scalar);
            var _rc_is256 = _is_simd256(S, _cur_fn_ret_scalar);
            if (_rc_is128 == 1 || _rc_is256 == 1) {
                if (PEEKT(S) == 2) {
                    if (_gcall_open(S, GTI(S)) >= 0) {   # IDENT '(' → a call (6.7.13: or `g<T>(`)
                        var _rc_noff = PEEKV(S);
                        var _rc_fi = _vcall_fi(S, GTI(S));
                        if (_rc_fi >= 0) {
                            if (GFRS(S, _rc_fi) == _cur_fn_ret_scalar) {
                                # Allocate anon temp (filler(s) + named lo slot).
                                var _rc_slots = 2;
                                if (_rc_is256 == 1) { _rc_slots = 4; }
                                var _rc_j = 0;
                                while (_rc_j < _rc_slots - 1) {
                                    var _rc_fill = GFLC(S);
                                    S64(S + 0x5D9D000 + _rc_fill * 8, 0 - 1);
                                    SLDEP(S, _rc_fill, GSDEP(S));
                                    SLTYPE(S, _rc_fill, 0);
                                    SFLC(S, _rc_fill + 1);
                                    _rc_j = _rc_j + 1;
                                }
                                var _rc_named = GFLC(S);
                                S64(S + 0x5D9D000 + _rc_named * 8, 0 - 1);
                                SLDEP(S, _rc_named, GSDEP(S));
                                SLTYPE(S, _rc_named, _cur_fn_ret_scalar);
                                # 6.6.5: the retptr callee writes THROUGH these slots, so the
                                # span has to be recorded like every other multi-slot receive —
                                # this was the ONE negative-SLTYPE registration in the tree
                                # without a SLAGG mark, and the picker's aggregate pass (now
                                # keyed on GLAGG rather than the vector descriptor) would have
                                # spanned it as 1 slot and left the fillers out of ra_unsafe.
                                SLAGG(S, _rc_named, _rc_slots);
                                SFLC(S, _rc_named + 1);
                                if (_rc_named + 1 > _flc_hwm) { _flc_hwm = _rc_named + 1; }
                                # Marshal the inner call: retptr = &temp, then args.
                                _rc_fi = _pe_venter(S, _rc_fi);   # v6.6.4: PE SIMD-return call emits its own call (6.7.13: past `<..>`; 6.7.14: routed)
                                EFLADDR(S, _rc_named);
                                EPUSHR(S);
                                # 6.6.6: `_owncall_args` — the gates plus the arity check this
                                # PE-only loop never had (`return f(a);` on a 2-param vector `f`
                                # built clean). CHANGELOG [6.6.6]
                                var _rc_argc = _owncall_args(S, _rc_fi, _rc_noff, 1);
                                if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                                STI(S, GTI(S) + 1);   # consume ';'
                                var _rc_target = L64(_fnt_offsets + _rc_fi * 8);
                                if (_rc_target >= 0) { ECALLTO(S, _rc_target); }
                                else { ECALLFIX(S, _rc_fi); }
                                ECALLCLEAN(S, _rc_argc);
                                # Byte-copy temp → our retptr stash (mirror return-IDENT).
                                var _rc_src_disp = 0 - ((_rc_named + 1) * 8);
                                if (_cur_fn_regalloc > 0) { _rc_src_disp = _rc_src_disp - _cur_fn_regalloc * 8; }
                                _rc_src_disp = _rc_src_disp - _cur_fn_ret_stash;
                                var _rc_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
                                var _rc_bytes = 16;
                                if (_rc_is256 == 1) { _rc_bytes = 32; }
                                ESTRUCT_BYVAL_COPY(S, _rc_src_disp, _rc_stash_disp, _rc_bytes);
                                var _rc_rp = EJMP0(S);
                                vec_push(rp_vec, _rc_rp);
                                return 0;
                            }
                        }
                    }
                }
            }
        }
    }
    # v5.10.48: bare `return;` synthesizes `return 0;` per cyrius's
    # int-only return convention. Closes
    # `docs/development/issues/2026-05-03-parser-cosmetic-limits-...`
    # `bare_return_in_if_block_rejected`. Pre-fix `if (...) { return;
    # }` errored with "unexpected ';'" because PCMPE was called
    # unconditionally and rejected an empty expression. Now: peek for
    # `;` BEFORE calling PCMPE; if present, emit `mov rax, 0` + jump
    # to epilogue (matches `return 0;` codegen byte-for-byte at this
    # position — in a `: f64` fn too, since 6.6.20 boxes rax into xmm0
    # once at the landing for every arm, `_ret_box_f64`).
    if (PEEKT(S) == 5) {
        _bx_bare_ret(S);   # 6.7.3: refused in a bool fn
        EMOVI(S, 0);
        STI(S, GTI(S) + 1);                             # consume ';'
        var br_rp = EJMP0(S);
        vec_push(rp_vec, br_rp);
        return 0;
    }
    _bx_pcmpe_ret(S);   # PCMPE, then (6.7.3) a bool fn's value is checked
    # v6.4.55: scalar f64 return (sentinel -9) — the rax→xmm0 move SysV/Win64 want is emitted
    # once at the return landing since 6.6.20 (`_ret_box_f64`), so it covers every arm.
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    # Emit jmp to epilogue (record as return patch)
    var rp = EJMP0(S);
    vec_push(rp_vec, rp);
    return 0;
}

# v5.10.1 — type-check infrastructure: lazy lookup for the
# `Str` struct sid so PARSE_FNCALL can flag Str-typed args
# being passed to cstring-typed (non-`: Str`) params. The
# search shape mirrors `_STR_FROM_NOFF` in parse_expr.cyr —
# scan tok_names for the cstring "Str\0" (4 bytes:
# 0x0072_7453 little-endian), then resolve to a struct id via
# FINDSTRUCT. Returns 0 if Str isn't defined in this program
# (graceful — type checks just don't fire).
var _str_sid_cache = 0 - 1;
fn _STR_SID(S): i64 {
    if (_str_sid_cache >= 0) { return _str_sid_cache; }
    if (_str_sid_cache == 0 - 2) { return 0; }
    var npos = GNPOS(S);
    var i = 0;
    while (i < npos) {
        # "Str\0" first 4 bytes — bottom 32 bits = 0x00727453
        if (load8(S + 0xEC00000 + i)     == 83) {
            if (load8(S + 0xEC00000 + i + 1) == 116) {
                if (load8(S + 0xEC00000 + i + 2) == 114) {
                    if (load8(S + 0xEC00000 + i + 3) == 0) {
                        var sid = FINDSTRUCT(S, i);
                        if (sid > 0) {
                            _str_sid_cache = sid;
                            return sid;
                        }
                    }
                }
            }
        }
        # skip to next null terminator
        while (i < npos) { if (load8(S + 0xEC00000 + i) == 0) { i = i + 1; break; } i = i + 1; }
    }
    _str_sid_cache = 0 - 2;
    return 0;
}

# v5.10.1 — opt-in gate for the call-site type check.
# `CYRIUS_TYPE_CHECK=1` enabled warnings; default was off.
#
# v5.10.26 — DEFAULT FLIPPED ON. The v5.10.5 false-positive
# shape (Str → generic i64 param triggering false warning)
# was closed by v5.10.24's polarity inversion: the warning
# now fires only on params explicitly annotated `: cstring`
# instead of params NOT annotated `: Str`. Empirical sweep
# at v5.10.26 slot entry across 26 cyrius-application repos
# (cyrius / agnosys / hisab / kavach / abaco / aegis /
# agnostik / agnova / argonaut / ark / chakshu / cyim /
# cyim-lsp / cyrius-doom / daimon / darshana / kybernet /
# libro / majra / niyama / nous / owl / phylax / samvada /
# sandhi / shakti / sit / vyakarana / yantra / yukti)
# confirmed ZERO type-check warnings with TYPE_CHECK=1 —
# the surface is clean and the flip is safe.
#
# Set `CYRIUS_TYPE_CHECK=0` to opt OUT. Any other value
# (or env unset) keeps the check ON. The check is cheap
# (~O(args) per call site), wire-compatible across the
# v5.10.x line, and produces actionable warnings only on
# Str → cstring shape mismatches with hint catalog.
var _type_check_env_resolved = 0;
var _type_check_enabled = 1;
fn _TYPE_CHECK_ENABLED(): i64 {
    if (_type_check_env_resolved == 1) { return _type_check_enabled; }
    var v = _read_env("CYRIUS_TYPE_CHECK");
    if (v != 0) {
        if (load8(v) == 48) { _type_check_enabled = 0; }
        if (load8(v) == 49) { _type_check_enabled = 1; }
    }
    _type_check_env_resolved = 1;
    return _type_check_enabled;
}

# v5.10.25 — Phase 3 generalize retired the hardcoded
# {_PRINTLN_NOFF, _PRINTLN_STR_NOFF, _PRINTLN_INT_NOFF,
# _STRLEN_NOFF, _STR_LEN_NOFF} byte-by-byte name lookups.
# Replaced by registry-based dispatch populated at REGFN time
# from `_str` / `_int` / `_cstr` suffixes on sibling fns.
# See `_OVERLOAD_SUFFIX` + REGFN's auto-register block.

# ⛔ 6.7.14 — A CALL-SITE DIAGNOSTIC NAMES ITS CALLEE AS THE SOURCE SPELLS IT. The fn table holds a method as its
# mangled `T_m` (`T_Tr_m` when two traits give T an `m`) and a generic call as its instance `g$i32`, and the call-site
# messages printed that: "in a call to 'S_ri'", "'S_two' expects 2 arguments, got 3", "'g$i32' is deprecated",
# "undefined function 'S_nope'". The spelling to print for fn `fi`, which the site names `noff`: a method `T.m` (its
# record, GFMETH), a generic instance its base's spelling and `<..>` its type arguments (GFIC, the instance's own
# record; a struct instance among them `Box<i64>`, `_sinst`), anything else `noff` itself — and `noff` whenever the
# site names something other than fi's own name (an alias). Written at GNPOS uncommitted, as BUILD_METHOD_NAME's
# lookup scratch is: the caller prints it before anything else is minted. CHANGELOG [6.7.14]
fn _fn_src_name(S, fi, noff): i64 {
    if (fi < 0) { return noff; }
    var nm = L64(_fnt_names + fi * 8);
    if (noff != nm) { if (STREQ(S, noff, nm) == 0) { return noff; } }
    var mr = GFMETH(S, fi);
    var c0 = GFIC(S, fi, 0);
    if (mr == 0) { if (c0 == 0) { return noff; } }
    NPOS_GUARD(S, 1024);
    var b = GNPOS(S);
    var lim = b + 960;
    var wp = b;
    if (mr != 0) {
        wp = _fsn_put(S, wp, (mr >> 32) - 1, lim, 1);
        wp = _fsn_lit(S, wp, ".", lim);
        wp = _fsn_put(S, wp, mr & 0xFFFFFFFF, lim, 1);
    } else { wp = _fsn_put(S, wp, nm, lim, 1); }
    if (c0 != 0) { wp = _fsn_targs(S, wp, c0, GFIC(S, fi, 1), lim, 0); }
    store8(S + 0xEC00000 + wp, 0);
    return b;
}
# The name at pool offset `noff` written at `wp` (up to its first `$` when `cut` is 1), bounded by `lim`.
fn _fsn_put(S, wp, noff, lim, cut): i64 {
    var i = 0;
    var c = load8(S + 0xEC00000 + noff);
    while (c != 0) {
        if (cut == 1) { if (c == 36) { return wp; } }
        if (wp >= lim) { return wp; }
        store8(S + 0xEC00000 + wp, c);
        wp = wp + 1;
        i = i + 1;
        c = load8(S + 0xEC00000 + noff + i);
    }
    return wp;
}
# A literal string written at `wp`, bounded by `lim`.
fn _fsn_lit(S, wp, str, lim): i64 {
    var i = 0;
    while (load8(str + i) != 0) {
        if (wp >= lim) { return wp; }
        store8(S + 0xEC00000 + wp, load8(str + i));
        wp = wp + 1;
        i = i + 1;
    }
    return wp;
}
# `<c0>` or `<c0, c1>`: an instance's type arguments as written (`depth` bounds a nested struct instance).
fn _fsn_targs(S, wp, c0, c1, lim, depth): i64 {
    wp = _fsn_lit(S, wp, "<", lim);
    wp = _fsn_conc(S, wp, c0, lim, depth);
    if (c1 != 0) {
        wp = _fsn_lit(S, wp, ", ", lim);
        wp = _fsn_conc(S, wp, c1, lim, depth);
    }
    return _fsn_lit(S, wp, ">", lim);
}
# One type argument `c` (a scalar code, a vector sentinel, a 1-based struct id) as the source spells it.
fn _fsn_conc(S, wp, c, lim, depth): i64 {
    if (c > 0) {
        var sn = L64(S + 0x1A6018 + (c - 1) * 8);
        var g = _sinst_base(c);
        if (g <= 0) { return _fsn_put(S, wp, sn, lim, 0); }
        if (depth >= 4) { return _fsn_put(S, wp, sn, lim, 0); }
        wp = _fsn_put(S, wp, sn, lim, 1);
        return _fsn_targs(S, wp, _sinst_conc(S, c, g, 0), _sinst_conc(S, c, g, 1), lim, depth + 1);
    }
    if (c <= 0 - 2048) { return _fsn_vec(S, wp, (0 - c) - 2048, lim); }
    return _fsn_lit(S, wp, _fsn_scalar(c), lim);
}
fn _fsn_scalar(c): i64 {
    if (c == 0 - 8) { return "i64"; }
    if (c == 0 - 9) { return "f64"; }
    if (c == 0 - 4) { return "i32"; }
    if (c == 0 - 2) { return "i16"; }
    if (c == 0 - 1) { return "i8"; }
    if (c == 0 - 16) { return "Result"; }
    if (c == 0 - 17) { return "Option"; }
    if (c == 0 - 18) { return "Tagged"; }
    if (c == 0 - 19) { return "cstring"; }
    return "?";
}
# A vector type from its descriptor (`_vec_desc`'s packing): f / i / u, the lane bits, `v`, the lane count.
fn _fsn_vec(S, wp, desc, lim): i64 {
    var k = "u";
    if ((desc & 1) == 1) { k = "f"; }
    elif ((desc & 2) == 2) { k = "i"; }
    wp = _fsn_lit(S, wp, k, lim);
    wp = _fsn_num(S, wp, 8 << ((desc >> 2) & 7), lim);
    wp = _fsn_lit(S, wp, "v", lim);
    return _fsn_num(S, wp, 1 << ((desc >> 5) & 7), lim);
}
# A number below 100 written in decimal.
fn _fsn_num(S, wp, n, lim): i64 {
    if (wp + 2 >= lim) { return wp; }
    if (n >= 10) { store8(S + 0xEC00000 + wp, 48 + n / 10); wp = wp + 1; }
    store8(S + 0xEC00000 + wp, 48 + n % 10);
    return wp + 1;
}
# The method record for fn `fi` just registered at a definition inside an impl (pass 1: `_impl_tnoff` is the
# impl's type, token `nti` the method's own name), or at a call `x.m(..)` of type name `tn` (`_mcall_note`).
fn _fn_meth_note(S, fi, tn, mn): i64 {
    if (fi < 0) { return 0; }
    SFMETH(S, fi, ((tn + 1) << 32) | mn);
    return 0;
}
fn _prescan_meth_note(S, fi, nti): i64 {
    if (_impl_tnoff == 0) { return 0; }
    if (TOKTYP(S, nti) != 2) { return 0; }
    return _fn_meth_note(S, fi, _impl_tnoff, TOKVAL(S, nti));
}

# 6.7.14 — 1 while a METHOD form's arity is judged (`o.m(..)`, a dyn call): `self` is no argument as written, so
# the message counts without it — "'S.two' expects 1 argument, got 2" for `s.two(1, 2)` (it said "'S_two' expects 2
# arguments, got 3"). The free spelling `S_two(&s, 1, 2)` counts its `&s`, as written; a method declaring no
# parameter at all (`o.zero()` on `fn zero()`) keeps the receiver in the count, the one extra. CHANGELOG [6.7.14]
var _ar_self = 0;
fn _check_arity_p0(S, line, noff, fi, argc, need_off, p0): i64 {
    _ar_self = p0;
    _CHECK_ARITY(S, line, noff, fi, argc, need_off);
    _ar_self = 0;
    return 0;
}

# ⭐ THE CALL-SITE ARITY CHECK (v6.2.41; an error since v6.5.1), shared by every call path — the one
# marshaller (PARSE_FNCALL, the method form, the struct-valued receives), the inline replay, the
# tail arm and the operator dispatches — so the diagnostic is one. A count mismatch is never
# intentional: there is no overloading by arity. The count must lie in min..max: max is the
# parameter count, min the first defaulted parameter's index (6.7.7; a fn without defaults has
# min = max, and the message is the v6.5.1 text, byte for byte).
# ⛔ 6.7.7 (fork F2, user 2026-10-09) — EVERY CALL TO A FN PASS 1 RECORDED IS CHECKED, A FORWARD ONE
# INCLUDED. The check used to skip any callee whose body was not yet emitted (offset -1: "pc not
# yet known"), so `g(1, 2)` to a `fn g(a)` defined further down built and dropped the 2 — on every
# path (plain, too few, a method, a tail call, a fn inside a top-level block). But pass 1 records
# every definition's parameter count (v6.3.5) and stamps its GFDS (6.6.5) before pass 2 parses any
# call; a name no definition registered (REGFN at the call, GFDS 0) keeps the skip and ends in the
# undefined-function diagnostic. VARIADICS (GFVA) take any tail; `syscall` has its own path.
# `need_off` names the path: 0 = the inline replay (its callee always has a body), 1 = a direct
# call (the marshaller fills a short call's defaults after this check), 3 = the tail arm (it never
# fills: `_tc_args_divert` sends such a call to PARSE_FNCALL), 4 = an operator dispatch (exactly two
# operands; an operator fn takes no default, D19) — `_pd_arity_mode`.
# CHANGELOG [6.2.41] [6.5.1] [6.7.7]
fn _CHECK_ARITY(S, line, noff, fi, argc, need_off): i64 {
    if (need_off != 0) { if (L64(_fnt_offsets + fi * 8) < 0) { if (GFDS(S, fi) == 0) { return 0; } } }
    if (GFVA(S, fi) != 0) { return 0; }
    var pc = L64(_fnt_params + fi * 8);
    if (_pd_row(fi) != 0) { if (_pd_arity_mode(S, line, noff, fi, argc, need_off) == 1) { return 0; } }
    var mn = _pd_min(fi);
    if (argc >= mn) { if (argc <= pc) { return 0; } }
    # v6.5.1 — ERROR, not warning. A call with the wrong argument count cannot
    # produce correct code: the surplus parameter is bound to whatever happens to
    # be in the register or stack slot. This was a *warning* for its entire life and
    # cyrius emitted a binary anyway, which is how `bayan_json_v_parse(someStr)`
    # returned 0 for every input right across the ecosystem with no outward sign but
    # one easily-missed line in build output. Verified safe to escalate: the whole
    # repo — 253 .tcyr, all 7 main forks, programs/ — produces ZERO of these.
    #
    # Deliberately does NOT set `_panic`: an arity mismatch is not a token-stream
    # desync, so the parse continues normally and ONE compile reports EVERY bad call
    # site (the v6.4.62 multi-error contract). `_had_error` alone withholds the binary.
    # 6.7.15: once per call and text (`_derr_seen`, at the call's `(`) — a generic body is parsed per instance.
    if (_derr_seen(_ar_site(S), "_CHECK_ARITY", ((fi * 31 + noff) * 1024 + argc) * 2 + _ar_self, 0) == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    FM_LOOKUP(S, line);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));   # 6.7.14: `S.two`, `g<i32>`
    syscall(SYS_WRITE, 2, "' expects ", 10);
    var sf = _ar_self;    # 6.7.14: a method form counts as written, without `self` —
    if (pc == 0) { sf = 0; }   # unless the method takes no parameter: then the receiver is the extra one
    mn = mn - sf;
    if (mn < 0) { mn = 0; }
    pc = pc - sf;
    if (mn != pc) { PRNUM(mn); syscall(SYS_WRITE, 2, " to ", 4); }   # 6.7.7: "1 to 3 arguments"
    PRNUM(pc);
    syscall(SYS_WRITE, 2, " argument", 9);
    if (pc != 1 || mn != pc) { syscall(SYS_WRITE, 2, "s", 1); }
    syscall(SYS_WRITE, 2, ", got ", 6);
    PRNUM(argc - sf);
    syscall(SYS_WRITE, 2, "\n", 1);
    _had_error = 1;
    return 0;
}

# The token an arity report is keyed on: the `(` of the call that just closed — the cursor is past its `)` (a call,
# an inline replay) or its `)` and `;` (the tail arm), so every path that checks one call agrees — else the cursor
# (an operator's dispatch). CHANGELOG [6.7.15]
fn _ar_site(S): i64 {
    var t = GTI(S) - 1;
    if (t < 1) { return GTI(S); }
    if (TOKTYP(S, t) == 5) { t = t - 1; }
    if (TOKTYP(S, t) != 11) { return GTI(S); }
    var d = 0;
    while (t >= 0) {
        var k = TOKTYP(S, t);
        if (k == 11) { d = d + 1; }
        if (k == 10) {
            d = d - 1;
            if (d == 0) { return t; }
        }
        t = t - 1;
    }
    return GTI(S);
}

# ⛔ 6.7.3 — A STRUCT ARGUMENT WAS NEVER TYPE-CHECKED AGAINST ITS PARAMETER, except a struct-typed
# FIELD into an address-passed one (`_fla_addr`, 6.6.12). `bq(p)` with `p: Pt` and `fn bq(b: Q)`
# compiled clean and read past the 16-byte Pt (0, or 97 from a global, or SIGSEGV for an operator),
# from a local, a global, a capture, a call, a method result, a tail call, a generic, a method's
# `self` and an operator's operands alike — while `var q: Q = p;` has been refused since 6.6.6.
# The argument's STATIC struct (`asid`, 0 = untyped / scalar / unknown: accepted as ever, which
# keeps `&p`, a literal and an untyped value passing) against the parameter's recorded struct
# (GFPSID — the instance's for a generic; a by-value struct of 8 B or less and a `Str` handle are
# recorded too since 6.7.3, `_psid_plain`): when both are known and differ, refused by name, in
# the field arm's words. The argument is still pushed, so the parse stays in step and the one
# compile reports every bad site; `_had_error` withholds the binary. Returns 1 after reporting.
# CHANGELOG [6.7.3]
fn _sarg_type_err(S, fi, argc, asid, anoff): i64 { return _sarg_type_errf(S, fi, argc, asid, anoff, 0 - 1); }
# ... `anoff` the result of a call to fn `afi` (a struct-call record's `_sc_fi`; -1: a name as written), which the
# refusal names as the source spells it — a method `S2.dup`, not its fn name `S2_dup` (`_sarg_ident_err`).
# CHANGELOG [6.7.14]
fn _sarg_type_errf(S, fi, argc, asid, anoff, afi): i64 {
    if (fi < 0) { return 0; }
    if (asid <= 0) { return 0; }
    if (asid >= 2048) { return 0; }    # a vector descriptor: not this rule
    var ps = GFPSID(S, fi, argc);
    if (ps <= 0) { return _sarg_svec_err(S, fi, argc, anoff, afi); }   # 6.7.13 (D33): a `*V` records no struct
    if (ps == asid) { return 0; }
    _sarg_ident_err(S, "cannot pass ", anoff, afi, " to a parameter of a different struct type in a call to ", fi);
    return 1;
}
# ERR_IDENT for an argument refusal: the argument `anoff` — the result of a call to fn `afi`, or (-1) a name — and the
# callee `fi`, each as the source spells it (`_fn_src_name`). The helper writes at one scratch, so the two names are
# printed one after the other, not passed as ERR_IDENT's two offsets. CHANGELOG [6.7.14]
fn _sarg_ident_err(S, msg, anoff, afi, tail, fi): i64 {
    var cn = L64(_fnt_names + fi * 8);
    if (afi < 0) { return ERR_IDENT(S, msg, anoff, tail, _fn_src_name(S, fi, cn)); }
    if (_err_once(S, (((msg * 31 + anoff) * 31 + tail) * 31 + cn) * 8 + 3) == 0) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": ");
    PRSTR(msg);
    PRSTR("'");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, afi, anoff));
    PRSTR("'");
    PRSTR(tail);
    PRSTR("'");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, cn));
    PRSTR("'\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# ⛔ 6.7.13 (D33 A, the user's decision, 2026-10-15) — A STRUCT VALUE INTO A `*V` PARAMETER IS REFUSED BY NAME. `rd(s)`
# with `p: *f64v2` and `s: Pt` — a local, a call result, `*ps`, a global, a closure's capture — passed the struct's
# address and the callee read its bytes as the vector (42 on every target, silently): a `*V` records no struct
# (GFPSID), so `_sarg_type_err` compared nothing. It is the mirror of 6.7.3 (another struct into `*S`), 6.7.11 A2
# (another vector into `*V`) and D27 (a vector into another pointer kind); `rd(&s)` stays the explicit conversion
# (a plain pointer converts freely). The struct argument `anoff` (every struct arm's `_sarg_type_err`) to parameter
# `argc` of `fi` that records no struct: 1 = refused (the push follows, no binary), 0 = not a `*V`. CHANGELOG [6.7.13]
# 6.7.14: `afi` as `_sarg_type_errf`'s — a method result is named `S2.dup`. CHANGELOG [6.7.14]
fn _sarg_svec_err(S, fi, argc, anoff, afi): i64 {
    if (_pvec_param(S, fi, argc) == 0) { return 0; }
    _sarg_ident_err(S, "cannot pass ", anoff, afi, " to a parameter that is a pointer to a vector type in a call to ", fi);
    return 1;
}
# The struct a WHOLE free call `name(..)` / `name<..>(..)` at the cursor returns (the instance's,
# for a generic), or 0. Moves nothing. Resolves the call (`_gen_resolve_call`), so it is called
# only where `_arg_call_class` already resolves it, or after the argument's own parse (a dedup hit).
fn _sarg_call_sid(S, ti): i64 {
    var o = _gcall_open(S, ti);
    if (o < 0) { return 0; }
    if (_call_dotted(S, ti) == 1) { return 0; }
    if (_call_is_whole_arg(S, o - 1) == 0) { return 0; }
    return _sarg_call_rs(S, ti);
}
# ... the struct the call at `ti` returns, once it is known to be the whole argument.
fn _sarg_call_rs(S, ti): i64 {
    var cfi = _gen_resolve_call(S, ti);
    if (cfi < 0) { return 0; }
    if (_grc_err < 0) { return 0; }    # a failed instantiation refuses itself, once
    var rs = GFRS(S, cfi);
    if (rs <= 0) { return 0; }
    if (rs >= 2048) { return 0; }
    return rs;
}
# The static struct of the NAME at token `ti`: a struct-typed local (inline, pointer-mode or `*T`
# — `_sl_ptr_type` records -sid for those too), a captured struct, or a recorded aggregate global,
# looked up in the order the argument arms push them; 0 = untyped / scalar / vector / unknown.
fn _sarg_name_sid(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var nm = TOKVAL(S, ti);
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, nm);
        if (li >= 0) {
            # A typed POINTER (`u: *Pt`, a local or a `p: *T` parameter — bit 56) converts freely, as
            # `&p`, an untyped pointer and the receive path's `var q: *Q = u;` do (the user's
            # decision, 2026-10-08): only a struct VALUE of another type is refused.
            if (GLPTRP(S, li) == 1) { return 0; }
            var lt = GLTYPE(S, li);
            if (lt >= 0) { return 0; }
            if (lt <= 0 - 2048) { return 0; }
            return 0 - lt;
        }
        if (_CL_CAP_FIELD_IDX(S, nm) < 0 - 1) { return _cap_fld_sid; }
    }
    return _sarg_gv_sid(S, FINDVAR(S, nm));
}
# A global's struct: only a recorded aggregate (GVPM, `_var_ptrmode`) — GVTYPE's positive range is
# shared with scalar widths, so nothing else is read as one (see `_push_struct_addr_global`).
fn _sarg_gv_sid(S, gvi): i64 {
    if (gvi < 0) { return 0; }
    if (GVPM(S, gvi) == 0) { return 0; }
    var vt = GVTYPE(S, gvi);
    if (vt <= 0) { return 0; }
    if (vt >= 2048) { return 0; }
    return vt;
}

# v6.3.36 (issue [5]) — if callee `fi` declares param `argc` as a plain struct >8 B
# (bit set in its _fnt_structmask) AND the current arg is a bare struct-typed local
# identifier (`foo(s)`, next token `,` or `)`), push the local's ADDRESS instead of
# its first-8-bytes value: the callee derefs a >8-byte struct param as a pointer
# (v6.3.16 lf_is_ptr), so a value would be dereffed-as-address → SIGSEGV. Returns 1
# when handled (IDENT consumed); 0 leaves the cursor untouched for the normal PCMPE
# value push. The CALLEE-mask gate is the reliable discriminator — cyrius tags both
# inline structs and struct-handles (Str, str_new_a results) with SLTYPE=-sid and
# reuses the -1 slot sentinel for freed block locals, so no arg-side heuristic works;
# the callee's declared param type does. Str/Result/Option/Tagged/scalar params keep
# their mask bit clear → value-passed (fixes the str_split/toml/vec_push_a regression).
fn _try_push_struct_addr_arg(S, fi, argc, tail): i64 {
    if (fi < 0) { return 0; }
    if (_pm_struct(fi, argc) == 0) { return _sarg_vdo(S, fi, argc); }   # 6.6.17 (a10); 6.7.3 (6.7.14: `_sarg_vdo`)
    var pvf = _sarg_pe_vform(S, fi, argc, tail);   # 6.7.14: Win64's value-form vector parameter, `_sar_src`'s sources
    if (pvf >= 0) { return pvf; }
    if (_dyn_sarg(S, fi, argc, tail) == 1) { return 1; }   # 6.7.8 (D5): a dyn formed in a temp
    if (PEEKT(S) == 10) { return _sarg_paren(S, fi, argc, tail); }   # 6.7.6
    if (_sarg_vec_call(S, fi, argc, tail) == 1) { return 1; }   # 6.7.12 (D27): `rd(mkv(..))` into `*V`
    # 6.7.10 (decision 11): `take(*p + a)` — a dereference-led operator result over 8 B is a struct
    # value with a temp, as `take(w.s + a)` is; it fell to the value push (its first word as the address).
    # (ops-5) A whole dereference `take(*p)` passes its pointer (`_sarg_deref`).
    if (PEEKT(S) == 8) { return _sarg_deref(S, fi, argc, tail); }
    # 6.7.11: `take(fncall1(&mk3, 5))` — a known callee's struct result has a temp, as `take(mk3(5))`.
    if (_icall_sid_at(S, GTI(S)) > 0) { return _push_struct_expr_arg(S, fi, argc, tail); }
    if (PEEKT(S) == 1) { _tup_arg_lit(S, fi, argc); }   # 6.7.14 (D44): `take(5)`, refused; pushed as before
    if (PEEKT(S) != 2) { return 0; }
    var nx = TOKTYP(S, GTI(S) + 1);
    # 6.7.3: a whole free call's struct, checked here — where `_arg_call_class` resolves it anyway.
    if (nx == 10 || nx == 19) {
        _sarg_type_err(S, fi, argc, _sarg_call_sid(S, GTI(S)), PEEKV(S));
        if (_tup_arg_call(S, fi, argc) == 1) { return 0; }   # 6.7.7 (B4): `g(f())`, f multi-value
        if (_mv_arg_call(S, fi, argc) == 1) { return 0; }    # 6.7.11: ... into a named struct
    }
    # ⛔ 6.6.6 — a by-value struct param given a struct-valued CALL (`h(mk(1, 2))`): the callee
    # takes the struct's ADDRESS, so the result needs storage to point at. It used to be pushed
    # as a value — the first word for a rax:rdx return (the callee then dereferenced a field),
    # and for a retptr return a call with no retptr at all (SIGSEGV). Top level has no frame: a
    # retptr callee falls through to PARSE_FNCALL, which refuses it by name; a rax:rdx one is
    # refused here (as first committed it fell through too, and PARSE_FNCALL refuses only the
    # retptr class, so `hy(p2(1, 2))` compiled clean and SIGSEGV'd). CHANGELOG [6.6.6]
    if (nx == 10) { if (GINFN(S) != 1) { return _refuse_toplevel_struct_arg(S); } }
    # 6.6.20: and `h(mkg<S1>(..))` at top level (it fell to the value push).
    if (nx == 19) { if (GINFN(S) != 1) { if (_call_dotted(S, GTI(S)) == 0) {
                if (_gcall_open(S, GTI(S)) >= 0) { return _refuse_toplevel_struct_arg(S); }
            } } }
    # 6.6.10 (bite 7 review): an explicit `idp<i32>(4)` too — it fell to the value push (SIGSEGV).
    var o = 0 - 1;
    if (GINFN(S) == 1) { o = _gcall_open(S, GTI(S)); }
    if (o >= 0) {
        # 6.6.12: `take(mk(p).v)` — the argument is a FIELD of the result, taken like `take(b.v)`.
        if (_call_dotted(S, GTI(S)) == 1) { return _push_struct_expr_arg(S, fi, argc, tail); }
        if (_arg_call_class(S) == 0) { return 0; }   # 6.6.10: the instance's class
        # 6.7.6: a struct call that is only the LEFT operand (`sz(mk(1) + a)`) dispatches its
        # operator fn, whose struct result takes the operator path's temp, as `sz(a + mk(1))`.
        if (_call_is_whole_arg(S, o - 1) == 0) { return _push_struct_expr_arg(S, fi, argc, tail); }
        _sarg_escapes(fi, argc, tail);   # 6.6.20: a temp in this frame
        EFLADDR(S, _struct_call_into_temp(S));
        EPUSHR(S);
        return 1;
    }
    # 6.6.6 (bite 14 review): any other expression — a method call or an operator returning the
    # struct takes its temp's address; everything else is pushed as its value. CHANGELOG [6.6.6]
    if (nx != 31) { if (nx != 11) { return _push_struct_expr_arg(S, fi, argc, tail); } }
    var li = 0 - 1;
    if (GINFN(S) == 1) { li = FINDLOCAL(S, PEEKV(S)); }
    if (li < 0) {
        if (_sarg_vec_cap(S, fi, argc) == 1) { return 0; }   # 6.7.13 (D32): a captured vector, the local's rules
        if (_push_struct_addr_cap(S, fi, argc) == 1) { return 1; }
        return _push_struct_addr_global(S, fi, argc);
    }
    var lt = GLTYPE(S, li);
    if (lt >= 0) { return 0; }          # must be a struct-typed local (SLTYPE = -sid)
    # v6.4.31: on SysV/aarch64 a SIMD local is register-passed (XMM/V) — never
    # address-passed — so reject it here. On Win64 PE it IS address-passed (MS
    # x64 by-pointer ABI), so let it flow through: push &local as the pointer.
    # ⛔ 6.6.5 — POINTER-MODE vs INLINE. This pushed `&slot` unconditionally, which is right
    # for an inline stack struct (the slot IS the struct) and WRONG for a pointer-mode local
    # (the slot HOLDS the struct's address): the callee then deref'd a pointer-to-pointer and
    # read the address itself as field 0. Measured on 6.6.4, silent and not a crash —
    # `var b: HB = alloc(24); b.a = 10; ...; f(0, b)` printed 140545185808389 where 42 is
    # right. Same discrimination `_resolve_field_base_addr` and the method-`self` push use:
    # the -1 slot-marker predecessor plus the <=8 B single-slot rule.
    # ⚠ NOT for SIMD. A value-form SIMD local is always inline, and on PE it is address-passed
    # by the MS x64 by-pointer ABI; its SLTYPE lives in the descriptor band (<= -2048) where
    # `STRUCTSZ` has no entry, so it must skip the test entirely rather than answer it wrong.
    # CHANGELOG [6.6.5]
    var _sa_ptr = 0;
    if (_is_simd_any(S, lt) == 1) { if (_sarg_vec_ptr(S, fi, argc, lt) == 0) { return 0; } }   # 6.7.11
    else {
        if (GLPTRP(S, li) == 0) { _sarg_type_err(S, fi, argc, 0 - lt, PEEKV(S)); }   # 6.7.3 (a `*T` converts: _sarg_name_sid)
        _sa_ptr = _local_struct_is_ptr(S, li, lt);
    }
    # 6.6.20: an inline aggregate (a by-value parameter's copy too, 6.6.16 C7) is pushed as an
    # address in this frame, exactly as `&s` is — see `_sarg_escapes`.
    if (_sa_ptr == 1) { EFLLOAD(S, li); } else { _sarg_escapes(fi, argc, tail); EFLADDR(S, li); }
    EPUSHR(S);
    STI(S, GTI(S) + 1);                 # consume IDENT
    return 1;
}

# ⛔ 6.7.11 — A VECTOR PASSED TO A `*V` PARAMETER PASSES ITS ADDRESS, as a struct passed to a `*T`
# parameter does (6.6.20); a vector of ANOTHER type is refused by name, as a struct of another type is
# (6.7.3). The user's decision, 2026-10-13: (a). Vector local (SLTYPE `lt`, the cursor on its name)
# as argument `argc` of `fi`: 1 = push its address (the caller's arm), 0 = the value push. A
# value-form vector parameter is not this rule: SysV / aarch64 / cx never reach here (the SIMD
# mask routes it), nor does Win64 (6.7.14: `_sarg_pe_vform` takes it first). (A `*V` local's SLTYPE is 0: its value.)
fn _sarg_vec_ptr(S, fi, argc, lt): i64 {
    var r = _svp_rule(S, fi, argc, lt);
    if (r >= 0) { return r; }
    return _TARGET_PE;
}
# The pointer rules a vector of type `lt` meets as argument `argc` of `fi` (the cursor on its name): a `*V` of its
# type 1 (the address is passed), another vector type refused by name (A2) and 1; a pointer of another kind (D27) or
# a by-value struct (D31) refused by name, 0; -1 = no pointer parameter (a value-form vector, a word).
fn _svp_rule(S, fi, argc, lt): i64 {
    var pv = _pvec_param(S, fi, argc);
    if (pv == 0) {
        if (_pptr_param(S, fi, argc) == 1) { return _vec_kind_err(S, PEEKV(S), fi); }   # 6.7.12 (D27)
        if (_vk_param(S, fi, argc) == 2) { return _vec_val_err(S, 0, PEEKV(S), fi, 2); }   # 6.7.13 (D31): a by-value struct
        return 0 - 1;
    }
    if (pv != 0 - lt) {
        ERR_IDENT(S, "cannot pass ", PEEKV(S), " to a parameter of a different vector type in a call to ",
          _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    }
    return 1;
}
# ⛔ 6.7.13 (D32 A, the user's decision, 2026-10-15) — A CLOSURE'S CAPTURED VECTOR MEETS THE LOCAL'S ARGUMENT
# RULES. Inside a closure `|k| ri(b)` / `|k| rp(b)` (`p: *i64` / `p: *Pt`) passed the capture's address and ran (42),
# where `ri(b)` / `rp(b)` on the local are refused by name (D27): the capture never reached the vector arm
# (`_CL_CAP_FIELD_IDX` takes a struct capture only), so the value push — a multi-word capture's value is its address —
# went out unchecked. The name at the cursor, a captured vector (`_cl_cap_vec`), as argument `argc` of an
# address-passed parameter of `fi`: `_svp_rule` (a `*V` of its type, another vector type, another pointer kind, a
# by-value struct) — 1, and the caller's value push is the capture's address (`&env[woff]`, right for a `*V`; refused
# otherwise, no binary). 0 = no captured vector. CHANGELOG [6.7.13]
fn _sarg_vec_cap(S, fi, argc): i64 {
    var lt = _cl_cap_vec(S, PEEKV(S));
    if (lt == 0) { return 0; }
    _svp_rule(S, fi, argc, lt);
    return 1;
}
# The vector type (its SLTYPE, <= -2048) of the enclosing local `noff` names when a capturing closure's body has
# captured it, else 0.
fn _cl_cap_vec(S, noff): i64 {
    if (_cl_capturing != 1) { return 0; }
    if (_cl_env_lidx < 0) { return 0; }
    var esl = _cl_snap_find(S, noff);
    if (esl < 0) { return 0; }
    if (_cl_cap_find(esl) < 0) { return 0; }
    var t = _cl_snap_type(esl);
    if (_is_simd_any(S, t) == 0) { return 0; }
    return t;
}
# ⛔ 6.7.14 — ON WIN64 A VALUE-FORM VECTOR PARAMETER TAKES WHAT SYSV'S `_sar_src` TAKES. Win64 passes it by address,
# under the struct mask, so the SIMD mask's check never ran there and the struct arms took its argument: a vector local
# of another type had its address pushed unchecked (an f64v4 into `v: f64v2` exited 2, an f64v2 into `v: f32v4` 0, an
# f32v8 into `v: f64v2` 3; 6.7.13 checked the 32-byte parameters only), a struct local's two words were read as the
# lanes (42), and an identifier-led expression (`lanes(q + 1)`) pushed its VALUE as the address (5), where x86_64 /
# aarch64 / cx refuse each by name. Parameter `argc` of `fi` declared a value-form vector (`_pvf_param`), the cursor
# on its argument, before every struct arm: inside any parentheses wrapping all of it, the sources SysV takes
# (`_spv_one`: a local or a captured vector, checked by the class rule in SysV's words — `_simd_arg_typecheck`, which
# refuses a non-vector local too — and its address pushed; a `*V` dereference, its pointer; a vector call,
# `_sarg_vec_call`'s, whose refusal skips the argument as `_sar_vcall`'s does); anything else is refused by name
# (`_sar_err`), skipped to its `,` / `)` and 0 pushed — one line, no binary; a call naming no fn (6.7.14) is left to
# the value push (0), as `_sar_none` leaves it. 1 = pushed, -1 = no Win64 value-form parameter. It folds 6.7.13's
# `_sarg_pe_v32` (the 32-byte check) and `_sarg_pe_vword` (D30's word refusal).
# 6.7.14 (D33 A, the user's decision, 2026-10-16): an address-of `&w` is refused there too, with the other targets'
# words — Win64 alone passed it (the by-address ABI copied the vector it pointed at: 42), x86_64 / aarch64 / cx refuse
# it, and `var v: f64v2 = &w;` is refused on every target; `&` converts into a POINTER parameter (6.7.12's D27 B), not
# into a value. Its own-call receives route `f(&a, ..)` to `f_ptr` as PARSE_FNCALL does (`_pe_venter`).
# CHANGELOG [6.7.14]
fn _sarg_pe_vform(S, fi, argc, tail): i64 {
    if (_TARGET_PE != 1) { return 0 - 1; }
    var vf = _pvf_param(S, fi, argc);
    if (vf == 0) { return 0 - 1; }
    var ti = GTI(S);
    _sar_ti = ti;
    var c = _pwrap_in(S, ti);   # 6.7.14: inside parentheses wrapping the whole argument, as `_sar_take` reads it
    if (c >= 0) {
        STI(S, c);
        if (_spv_one(S, fi, argc, tail, vf) == 1) {
            _pw_close(S, c - ti);
            return 1;
        }
        STI(S, ti);
    }
    if (_vrcv_nofnw(S, ti, _arg_next(S, ti)) == 1) { return 0; }   # 6.7.14: the value push, as `_sar_none`
    _sar_err(S, ti, fi);
    return _spv_skip(S, ti);
}
# The source at the cursor, unwrapped, as `_sar_one` takes it: a local — checked by the class rule in SysV's words
# (`_simd_arg_typecheck`, reported at its end as the SysV record does) and its address pushed; (6.7.14, D31 A) a
# closure's captured vector — checked the same way, the address of its env words pushed (the callee copies them in);
# (D32 A) a whole dereference of a vector (`_sar_dsrc`) — checked the same way, its pointer pushed; a vector call —
# `_sarg_vec_call`'s (its refusal skips the source); 1 = pushed, 0 = no such source (nothing moved).
fn _spv_one(S, fi, argc, tail, vf): i64 {
    var c = GTI(S);
    var li = _spv_local(S, c);
    if (li >= 0) {
        STI(S, c + 1);
        _simd_arg_typecheck(S, _vf_cls(S, 0 - vf), GLTYPE(S, li), vf);
        _sarg_escapes(fi, argc, tail);
