# The local a whole argument at token `ti` names (`,` or `)` after it), as `_sar_src` reads one; else -1.
fn _spv_local(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0 - 1; }
    var nx = TOKTYP(S, ti + 1);
    if (nx != 31) { if (nx != 11) { return 0 - 1; } }
    return FINDLOCAL(S, TOKVAL(S, ti));
}
# A refused argument at token `ti`: skipped to its `,` / `)` and 0 pushed, so the parse stays in step and the value
# parse adds no line of its own. 1.
fn _spv_skip(S, ti): i64 {
    STI(S, _arg_next(S, ti));
    EMOVI(S, 0);
    EPUSHR(S);
    return 1;
}
# The vector type (its descriptor sid) parameter `k` of fn `fi` points at when it is declared `*V`,
# read from the definition's tokens (a call above the definition has them too); 0 = not a `*V`.
fn _pvec_param(S, fi, k): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, k) == 0) { return 0; }
    var i = _dps_ts;
    if (TOKTYP(S, i) != 8) { return 0; }
    if (TOKTYP(S, i + 1) != 2) { return 0; }
    var tn = TOKVAL(S, i + 1);
    return _ptc_vec_sid(_classify_param_type(S, tn));
}
# The vector type (its descriptor sid) of parameter `k` of fn `fi` when it is a VALUE-form vector (`v: f64v2`), read
# from the definition's tokens as `_pvec_param` reads a `*V`; 0 = none. Win64 passes it by address, under the struct
# mask, so no SIMD mask names it there. CHANGELOG [6.7.13]
fn _pvf_param(S, fi, k): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, k) == 0) { return 0; }
    var i = _dps_ts;
    if (TOKTYP(S, i) != 2) { return 0; }
    return _ptc_vec_sid(_classify_param_type(S, TOKVAL(S, i)));
}
# 1 = parameter `k` of fn `fi` is declared a pointer (`p: *T`, `**T`, `*fn(..)`), read as `_pvec_param` reads it.
fn _pptr_param(S, fi, k): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, k) == 0) { return 0; }
    if (TOKTYP(S, _dps_ts) != 8) { return 0; }
    return 1;
}
# ⛔ 6.7.12 — A VECTOR LOCAL INTO A POINTER OF ANOTHER KIND IS REFUSED BY NAME (D27, the user, 2026-10-15: B —
# "another pointer kind refused by name"). `rp(b)` with `p: *Pt` and `ri(b)` with `p: *i64` pushed the
# vector's lane 0 as the address (139 on x86_64 and aarch64, a cx guest fault, exit 5 on PE; PE's `rp(b)`
# pushed `&b` by accident, 42): a vector is no `*Pt`, as a struct of another type is no `*S` (6.7.3). The
# name `noff` as an argument of `fi`; 0 (the value push keeps the parse in step, no binary is written).
fn _vec_kind_err(S, noff, fi): i64 {
    return _agg_kind_err(S, noff, fi, "vector");
}
# ... `kind` "vector" or "struct" (6.7.13 D5 (a), `_sarg_struct_other`).
fn _agg_kind_err(S, noff, fi, kind): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(GTI(S), "_agg_kind_err", (noff * 31 + fi) * 31 + kind, 0) == 1) { return 0; }   # 6.7.15: once
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": cannot pass '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("' to a parameter that is not a pointer to its ");
    PRSTR(kind);
    PRSTR(" type in a call to '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    PRSTR("' - pass &");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR(" for its address\n");
    _err_excerpt(S);
    _had_error = 1;   # no `_panic`: the parse is in step, so one compile reports every such argument
    return 0;
}
# ⛔ 6.7.13 (D31 A, the user's decision, 2026-10-15) — EVERY VECTOR VALUE INTO A POINTER OF ANOTHER KIND, OR INTO A
# BY-VALUE STRUCT PARAMETER, IS REFUSED BY NAME. D27 (6.7.12) refused a vector LOCAL into `*Pt` / `*i64`; a vector call
# result (`rp(mkv(42, 7))`, `ri(mkv(42, 7))`) and a `*V` dereference (`rp(*pb)`, `ri(*pb)`) are the same vector values
# D27 passes to a `*V`, and they still pushed lane 0 as the address (139 on x86_64 / aarch64, a cx guest fault, PE 5); a
# vector local into a by-value struct parameter (`bv(b)`, `p: Pt`) took lane 0 the same way off Win64, and on Win64
# passed `&b` by accident (42). Parameter `k` of fn `fi`, for a vector argument: 1 = a pointer of another kind (`*S`,
# `*i64`, `**T`, any `*T` that is no `*V`), 2 = a by-value struct (GFPSID: a plain struct of any size, a tuple),
# 0 = neither (a `*V`, a value-form vector, a word). CHANGELOG [6.7.13]
fn _vk_param(S, fi, k): i64 {
    if (_pptr_param(S, fi, k) == 1) {
        if (_pvec_param(S, fi, k) != 0) { return 0; }
        return 1;
    }
    var ps = GFPSID(S, fi, k);
    if (ps <= 0) { return 0; }
    if (ps >= 2048) { return 0; }
    return 2;
}
# The refusal of a vector value — the call or name `noff`, a dereference (`star` 1: `*noff`) — as an argument of `fi`
# whose parameter is of kind `kd` (`_vk_param`), at the cursor: D27's words for another pointer kind, "a vector is not
# a struct" for a by-value struct. No `_panic` (the value push keeps the parse in step, one compile reports every such
# argument). 0.
fn _vec_val_err(S, star, noff, fi, kd): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(GTI(S), "_vec_val_err", ((noff * 31 + fi) * 31 + kd) * 2 + star, 0) == 1) { return 0; }   # 6.7.15
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": cannot pass '");
    if (star == 1) { PRSTR("*"); }
    PRSTR(S + 0xEC00000 + noff);
    if (kd == 2) { PRSTR("' to a by-value struct parameter in a call to '"); }
    else { PRSTR("' to a parameter that is not a pointer to its vector type in a call to '"); }
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    if (kd == 2) { PRSTR("' - a vector is not a struct\n"); }
    else { PRSTR("'\n"); }
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}
# The same for a whole vector argument to parameter `argc` of `fi` that is not address-passed — a `*i64`, `*u8`,
# `**T` (D27, a LOCAL), or (6.7.13, D31) a by-value struct of 8 B or less — by its tokens: a vector local or (6.7.13,
# D32) a closure's captured vector (inside any parentheses wrapping the whole argument), or a call declared to return
# a vector (`_svc_rs`), inside any such parentheses too; a dereference is judged once parsed (6.7.14, `_sarg_vdo`).
# The cursor on the argument (`_sarg_byval_small`); nothing is consumed. 1 = refused.
fn _sarg_vec_other(S, fi, argc): i64 {
    var kd = _vk_param(S, fi, argc);
    if (kd == 0) { return 0; }
    var ti = _sarg_wname(S);
    if (ti >= 0) {
        if (GINFN(S) != 1) { return 0; }
        var li = FINDLOCAL(S, TOKVAL(S, ti));
        var lt = 0;
        if (li >= 0) { lt = GLTYPE(S, li); }
        else { lt = _cl_cap_vec(S, TOKVAL(S, ti)); }   # 6.7.13 (D32): a closure's captured vector too
        if (_is_simd_any(S, lt) == 0) { return 0; }
        if (kd == 1) { return _svo_err(S, ti, 2, TOKVAL(S, ti), fi, kd); }
        return _svo_err(S, ti, 0, TOKVAL(S, ti), fi, kd);
    }
    var c = _svo_inner(S);
    if (_svc_rs(S, c) != 0) { return _svo_err(S, c, 0, _svc_nm, fi, kd); }
    return 0;   # (6.7.14: a dereference is `_sarg_vdo`'s, once it is parsed)
}
# Report at token `ti`: `how` 2 = D27's local words (`_vec_kind_err`, with its `&` hint), 1 = a dereference, 0 = a name
# or call (`_vec_val_err`). 1.
fn _svo_err(S, ti, how, noff, fi, kd): i64 {
    var sv = GTI(S);
    STI(S, ti);
    if (how == 2) { _vec_kind_err(S, noff, fi); }
    else { _vec_val_err(S, how, noff, fi, kd); }
    STI(S, sv);
    return 1;
}
# The first token inside parentheses wrapping the whole argument at the cursor (ending at `,` / `)`), else the cursor.
fn _svo_inner(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti) != 10) { return ti; }
    var k = _pwrap_k(S, ti);
    var e = TOKTYP(S, _pw_end);
    if (e != 31) { if (e != 11) { return ti; } }
    return ti + k;
}
# ⛔ 6.7.14 — EVERY `*V` DEREFERENCE INTO A POINTER OF ANOTHER KIND OR A SMALL BY-VALUE STRUCT IS REFUSED BY NAME
# (6.7.13's D31 A: every vector value there is). `ri(**ppb)`, `ri(*gp(pb))`, `ri(*h.pv)`, `ri(*GPV)`, `ri(*(pb + 0))`,
# `ri(*&b)` into `p: *i64` (`*u8`, `**T`, a by-value struct of 8 B or less) pushed lane 0 as the address — 139 on x86_64
# / aarch64, a cx guest fault, PE 5, no diagnostic — where `rp(**ppb)` into `*Pt` and `ri(*pb)` were refused: this arm
# judged a dereference by its tokens (`* NAME` of a `*V` local, the retired `_svo_vderef`), the address-passed one by
# its operand's type once parsed (`_dlo_vec`). Parameter `argc` of `fi` not address-passed, of such a kind
# (`_vk_param`), the whole argument (inside any parentheses, `_svo_inner`) starting with `*`: that `*` is watched
# (`_dro_vo`) while `_sarg_byval_small` parses and pushes the argument as before; when its operand named a vector (the
# step word or an `&x` of one, `_dop_vd`) and ended the argument (`_dro_vnote`), the argument is refused by name —
# `cannot pass '*ppb' to a parameter that is not a pointer to its vector type in a call to 'ri'`, the operand's last
# name as the address-passed arm names it — once, without `_panic`. A `*i64`'s `*ppi` and a `**Pt`'s `*pps` push their
# word as before. Returns as `_sarg_byval_small` does. CHANGELOG [6.7.14]
