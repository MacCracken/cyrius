    vec_push(rp_vec, rp);
    return 1;
}
# 6.7.10 (B7-1) — `return IDENT;` inside `k` balanced parentheses (`return ((p));`): k, or -1 for any
# other shape. Read in one linear pass, as `_ret_tuple_var` reads it (a `_pwrap_k` peel is quadratic).
fn _hl_ret_k(S): i64 {
    var st = GTI(S);
    var k = 0;
    while (TOKTYP(S, st + k) == 10) { k = k + 1; }
    if (TOKTYP(S, st + k) != 2) { return 0 - 1; }
    var j = 1;
    while (j <= k) {
        if (TOKTYP(S, st + k + j) != 11) { return 0 - 1; }
        j = j + 1;
    }
    if (TOKTYP(S, st + k + j) != 5) { return 0 - 1; }
    return k;
}
# ⛔ 6.7.11 — THE VALUE A FN RETURNING A STRUCT OF 8 B OR LESS RETURNS IS CHECKED BY ITS STRUCT, as the
# 9-16 B (`_refuse_pair_return`) and > 16 B ("identifier type != fn ret_sid") classes check theirs (6.7.10
# decision 6: struct rules are size-independent). This class returns one word in rax, and its scalar
# tail loaded whatever word the expression had: another struct's local, by-value parameter, global,
# parenthesised name, call, field, method or operator result, a handle of another struct or a dereference
# of a `*U` handed back U's bytes as S's (`return u;` exit 3, no diagnostic), and a `*S` LOCAL handed
# back the ADDRESS (an address byte where 8 was right), while a `p: *S` parameter copied (6.6.17)
# (issues/archived/2026-10-12-small-struct-return-takes-another-structs-value.md). The user's decision
# (2026-10-13): every other-struct shape is refused by name. The expression at `st` is parsed with the
# argument check's records armed (`_ret_expr_sid`, `_ess_deref`: the parse and its emission are
# unchanged): a value of another struct is refused; an expression typed `*S` (`_ret_small_ptr`) is the
# struct it points at, read byte-exact with its padding 0 (`_hl_pval_ra`); a `*U` is refused. An untyped
# value stays the struct's word. CHANGELOG [6.7.11]
# Not inside an inline replay (GIDEP): a replayed `return` is the CALLEE's (a generic straight-line body),
# whose class is not the enclosing fn's (staged: the inline replay judges it by the caller's class).
fn _ret_small_cls(S): i64 {
    if (GIDEP(S) != 0) { return 0; }
    if (_cur_fn_ret_sid <= 0) { return 0; }
    if (_cur_fn_ret_stash > 0) { return 0; }
    if (_cur_fn_ret_pair == 1) { return 0; }
    if (STRUCTSZ(S, _cur_fn_ret_sid - 1) > 8) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    return _dx_plain(S, _cur_fn_ret_sid);
}
fn _ret_small_val(S, st): i64 {
    var asid = _ret_expr_sid(S, st);
    var kind = 0;
    if (asid == 0) {
        asid = _ess_deref(S, st);
        kind = 2;
    }
    if (asid > 0) {
        if (asid >= 2048) { return 0; }
        if (_dyn_is(S, asid) == 1) { return 0; }   # refused at its own site (6.7.8 V4), once
        if (asid != _cur_fn_ret_sid) { _ret_sid_refuse(S, st, _ess_nm, _ess_fi, asid, kind); }
        return 0;
    }
    return _ret_small_ptr(S, st);
}
# `_expr_struct_sid` for a value that ends at the return's `;` (an argument's ends at `,` / `)`): the
# expression at `st` parsed (PCMPE) with the static-struct records armed — a bare name, a whole free
# call (resolved after the parse), a whole method / operator result, a whole struct-typed or `Str`
# field, inside any parentheses — its struct, `_ess_nm` the name a refusal names; 0 = untyped /
# scalar / unknown.
fn _ret_expr_sid(S, st): i64 {
    var k = 0;
    if (TOKTYP(S, st) == 10) {
        k = _pwrap_k(S, st);
        if (TOKTYP(S, _pw_end) != 5) { k = 0; }
    }
    var ist = st + k;
    var fk = _fpk_want;
    _fpk_want = ist;
    _fpk_ft = 0;
    _sc_beg = 0 - 1;                   # only this value's own record may match
    PCMPE(S);
    _fpk_want = fk;
    var asid = 0;
    var nm = 0;
    _ess_fi = 0 - 1;
    if (TOKTYP(S, ist) == 2) {
        nm = TOKVAL(S, ist);
        var ie = GTI(S) - k;
        var o = _gcall_open(S, ist);
        if (ie == ist + 1) { asid = _sarg_name_sid(S, ist); }
        elif (o > ist) { if (_call_close(S, o) + 1 == ie) { asid = _sarg_call_rs(S, ist); } }
    }
    if (asid == 0) {
        if (_sc_whole(S, st) != 0 - 2) { asid = _sc_sid; nm = _sc_fn; _ess_fi = _sc_fi; }   # 6.7.15: `Pt.dup`
        elif (_fpk_ft > 0) { if (_fpk_end + k == GTI(S)) { asid = _fpk_ft; nm = _fpk_name; } }
        elif (_fls_whole(S, st) == 1) { asid = _fls_sid; nm = _fls_name; }
