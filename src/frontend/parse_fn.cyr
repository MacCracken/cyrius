                # named slot (deepest = lo half, where &v points).
                # Mirror of the v5.10.28 var-decl multi-slot pattern.
                var simd_j = 0;
                while (simd_j < simd_slots - 1) {
                    var simd_fi = GFLC(S);
                    S64(S + 0x5D9D000 + simd_fi * 8, 0 - 1);  # anon
                    SLDEP(S, simd_fi, 0);
                    SLTYPE(S, simd_fi, 0);
                    SFLC(S, simd_fi + 1);
                    simd_j = simd_j + 1;
                }
                # Named slot (deepest disp; where &v resolves).
                var simd_named = GFLC(S);
                S64(S + 0x5D9D000 + simd_named * 8, pnoff);
                SLDEP(S, simd_named, 0);
                SLTYPE(S, simd_named, 0 - simd_sid);
                SFLC(S, simd_named + 1);
