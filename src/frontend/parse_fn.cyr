                # LTYPE table at S+0x192200 isn't cleared per-fn (only
                # FLC resets), so a fresh param slot can inherit a stale
                # `0 - sid` value from a prior fn's local in the same
                # slot index. Surfaced when v5.10.1 added the call-site
                # type-check: untyped `alloc` param of `str_cat_a` was
                # falsely flagged Str-typed because the previous fn
                # (using slot 0 for a Str-annotated local) left SLTYPE
                # = -STR_SID. Belt-and-braces: zero first, then set to
                # `-pt_sid` only if explicitly annotated.
                SLTYPE(S, li, 0);
                if (pt_sid > 0) { SLTYPE(S, li, 0 - pt_sid); }
                _psid_note(S, fi, pc, pt_sid, struct_mask);   # 6.6.12: see SFPSID (util.cyr)
                # v6.4.57 (Gap A) — a scalar f64/f32 param gets the same positive
