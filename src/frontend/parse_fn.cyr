                            syscall(SYS_WRITE, 2, "' to '", 6);
                            PRSTR(S + 0x60000 + noff);
                            syscall(SYS_WRITE, 2, "' which expects a cstring\n  hint: use str_data(", 47);
                            PRSTR(S + 0x60000 + _tc_arg_noff);
