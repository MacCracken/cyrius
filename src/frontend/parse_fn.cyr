fn _ret_slot_refuse(S, ti, noff): i64 {
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }   # a generic base and its instances: once
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    PRSTR(": a fn returning the struct `");
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (_cur_fn_ret_sid - 1) * 8));
    PRSTR("` takes a value of that struct, or a pointer to one — `&");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("` is the address of ");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("'s slot, not a struct — return ");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("\n");
