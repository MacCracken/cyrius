                    if (_param_wants_struct_ptr(S, tnoff) == 1) { struct_mask = struct_mask | (1 << pc); }
                    # v6.3.39 (B3) — record params whose declared type is a type-param, so
                    # the i64 BASE emission can skip the body when such a param is field-
                    # accessed as a struct (no valid i64 form). Gated; default byte-identical.
                    if (_MONOMORPH_OK == 1) { if (_is_tparam_of(S, fi, tnoff) == 1) { _cur_fn_tp_pmask = _cur_fn_tp_pmask | (1 << pc); } }
                    pt_sid = FINDSTRUCT(S, tnoff);
