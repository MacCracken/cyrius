                                        if (load8(S + 0x60000 + _rs_rt_noff + 5) == 116) {
                                            if (load8(S + 0x60000 + _rs_rt_noff + 6) == 0) {
                                                _rs_is_scalar = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (_rs_b0 == 79) {
                        if (_rs_b1 == 112) {
                            if (_rs_b2 == 116) {
                                if (_rs_b3 == 105) {
                                    if (load8(S + 0x60000 + _rs_rt_noff + 4) == 111) {
                                        if (load8(S + 0x60000 + _rs_rt_noff + 5) == 110) {
                                            if (load8(S + 0x60000 + _rs_rt_noff + 6) == 0) {
                                                _rs_is_scalar = 1;
                                            }
                                        }
