                    # so the rough-scan doesn't default to retptr-stash
                    # for them. Mirrors the post-param-list scalar path
                    # that encodes negative values into fn_ret_sid.
                    # v5.10.23 — extended to recognize Result / Option /
                    # Tagged / cstring as i64-shape scalars (all return
                    # raw pointers — heap handle for Result/Option/Tagged,
                    # null-terminated byte ptr for cstring; rax-via-i64
                    # ABI not retptr-stash). Without this addition, fns
                    # annotated with the new types would silently get
                    # retptr/X8 calling convention and corrupt the
                    # is_ok/result_unwrap semantics in callers.
                    var _rs_b0 = load8(S + 0xEC00000 + _rs_rt_noff);
                    var _rs_b1 = load8(S + 0xEC00000 + _rs_rt_noff + 1);
                    var _rs_b2 = load8(S + 0xEC00000 + _rs_rt_noff + 2);
                    var _rs_b3 = load8(S + 0xEC00000 + _rs_rt_noff + 3);
                    var _rs_is_scalar = 0;
