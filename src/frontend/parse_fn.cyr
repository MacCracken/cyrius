# argument (from `st` to the cursor) is refused the same way.
var _mrc_beg = 0 - 1;   # its first token
var _mrc_end = 0 - 1;   # the token after it
var _mrc_fn = 0;        # its name
var _mrc_fi = 0 - 1;    # 6.7.11: its fn (declared multi-value, or undeclared with a counted return)
fn _mrc_note(S, fi, noff, beg): i64 {
