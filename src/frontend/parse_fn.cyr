    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    # v6.5.62 — THE PICKER EXCLUDED PARAMS BY PARAM *COUNT* WHILE THE SLOT MAP IS BY *SLOT*.
    #
    # A by-value vector param occupies `nslots` frame slots — (nslots-1) anonymous fillers and
    # then its NAMED slot — so in `fn f(v: f64v4, s)` the scalar `s` lives at slot 4 while `pc`
