# ⛔ 6.7.11 — A MULTI-VALUE CALL WHERE A NAMED STRUCT IS EXPECTED (the user's decision, 2026-10-13:
# refused by name, R17's wording, at every struct size). A call returning several values leaves them
# in the return registers; a named struct is a VALUE — a by-value parameter, a local, a global, a field.
# No destination recognised the call (each keyed on the callee's struct, and a multi-value one has
# none), so its FIRST value became the struct: its address over 8 B — `take(mk(3))`, `take(b.mk(3))`,
# `var p: P = mk(3);` SIGSEGV'd on x86 and aarch64, an access violation on PE, a guest error on cx — or
# its first word (`h.p = mk(3);`, `p = mk(3);`: p.a = 3, p.b stale, silently). R17 (6.7.7) refuses
# this call into a TUPLE parameter or field; a named struct is refused the same way: bind the values
# first. A `*P` (parameter, variable) and a `Str` / `Result` / `Option` / `Tagged` handle take a word —
# the call's first value, as `var x = mk(3);` does — and are not refused. CHANGELOG [6.7.11]
#
# 1 = fn `fi` returns several values: declared `: (T1, T2[, T3])`, or undeclared with a count pass 1
# proved (`_fn_ret_arity`). Keyed on the DECLARED return: a `: P` fn's `return (x, y)` arms (the 6.7.7
# crossing) return a P.
fn _mv_callee(S, fi): i64 {
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs == MULTIRET_SID) { return 1; }
    if (rs != 0) { return 0; }
    if (_fn_ret_arity(S, fi) != 0) { return 1; }
    return 0;
}
# ⛔ 6.7.14 — ... and, for a TUPLE parameter (R17), a fn declared ONE scalar (`: i64`, `: f64`, `: bool`,
# `: i32` ..) that pass 1 counted returning several values (6.7.13's D23 B keeps it): `take(g2(3))` with
# `fn g2(a): i64 { return (a, a + 1); }` pushed the first value as the tuple's address (139 / 139 / 1 / 5).
# Refused as the undeclared callee is (D44, the user's decision, 2026-10-16). `_mv_callee` itself stays
# keyed on an undeclared return: a named struct's `: P` crossing reads it. CHANGELOG [6.7.14]
fn _mv_callee_any(S, fi): i64 {
    if (_mv_callee(S, fi) == 1) { return 1; }
    if (fi < 0) { return 0; }
    var rs = GFRS(S, fi);
    if (rs > 0) { return 0; }        # a named struct
    if (rs < 0 - 9) { return 0; }    # a handle (Result / Option / Tagged / cstring) or a vector
    if (_fn_ret_arity(S, fi) != 0) { return 1; }
    return 0;
}
# 1 = struct `sid` (1-based) is a named plain struct: no tuple (R17's), dyn, vector or stdlib handle.
fn _mv_named(S, sid): i64 {
    if (sid <= 0) { return 0; }
    if (sid >= 2048) { return 0; }
    if (_tup_is(S, sid) == 1) { return 0; }
    if (_dyn_is(S, sid) == 1) { return 0; }
    if (_classify_param_type(S, L64(S + 0x1A6018 + (sid - 1) * 8)) != 0) { return 0; }
    return 1;
}
# The report at token `ti`: struct `sid`, the call named `noff` (fn `fi`, its count in the hint); `kind`
# 0 an argument, 1 a field, 2 a declaration, 3 an assignment, 4 a return (6.7.13); `free` spells the hint: 1 `noff(..)`, 2
# `x.noff(..)` (a method on the name at `ti`), 0 `...`. Once per token (a generic body is parsed per instance); the parse goes on and
# `_had_error` withholds the binary, as R17's. 1 = refused.
fn _mv_struct_err(S, ti, sid, noff, fi, kind, free): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 1; }
    if (_tn_once(S, ti) == 0) { return 1; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": a multi-value call '");
    PRSTR(S + 0xEC00000 + noff);
    if (kind == 1) { PRSTR("' is not stored into a struct '"); }
    elif (kind == 2) { PRSTR("' does not initialize struct '"); }
    elif (kind == 3) { PRSTR("' is not assigned to struct '"); }
    elif (kind == 4) { PRSTR("' is not returned as struct '"); }
    else { PRSTR("' is not a struct '"); }
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
    if (kind == 0) { PRSTR("' argument"); }
    elif (kind == 1) { PRSTR("' field"); }
    else { PRSTR("'"); }
    PRSTR(" - bind it first: `var a, b");
    if (_mv_count(S, fi) == 3) { PRSTR(", c"); }
    PRSTR(" = ");
    if (free == 0) { PRSTR("..."); }
    else {
        if (free == 2) {
            PRSTR(S + 0xEC00000 + TOKVAL(S, ti));
            PRSTR(".");
        }
        PRSTR(S + 0xEC00000 + noff);
        PRSTR("(..)");
    }
    PRSTR(";`\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 1;
}
fn _mv_count(S, fi): i64 {
    if (GFRS(S, fi) == MULTIRET_SID) { return GFRN(S, fi); }
    return _fn_ret_arity(S, fi);
}
# The source [a, b) just parsed, wrapping parentheses peeled: a whole method call (`_mrc_note`'s record)
# or a whole free call `name(..)` / `name<..>(..)` to a multi-value fn — reported as `kind` into struct
# `sid`. 1 = refused.
fn _mv_span(S, a, b, sid, kind): i64 {
    a = _ie_unparen(S, a, b);
    b = _ie_pe;
    if (_mrc_beg == a) { if (_mrc_end == b) { if (_mv_callee(S, _mrc_fi) == 1) {
                if (_mcall_open(S, a, 0 - 1) >= 0) { return _mv_struct_err(S, a, sid, TOKVAL(S, a + 2), _mrc_fi, kind, 2); }
                return _mv_struct_err(S, a, sid, _mrc_fn, _mrc_fi, kind, 0);   # a longer chain: the method's fn
            } } }
    var o = _gcall_open(S, a);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 != b) { return 0; }
    var cfi = _gen_resolve_call(S, a);
    if (_mv_callee(S, cfi) == 0) { return 0; }
    return _mv_struct_err(S, a, sid, TOKVAL(S, a), cfi, kind, 1);
}
# The argument at the cursor into parameter `argc` of `fi`, a named struct passed BY VALUE: a whole free
# call to a multi-value fn (cursor on its name, before its parse). An address-passed parameter the callee
# does not copy in (`_pm_copies`) is a `*P`, which takes the first value as a pointer.
fn _mv_arg_call(S, fi, argc): i64 {
    var ps = GFPSID(S, fi, argc);
    if (_mv_named(S, ps) == 0) { return 0; }
    if (_pm_copies(fi, argc) == 0) { return 0; }
    var ti = GTI(S);
    var o = _gcall_open(S, ti);
    if (o < 0) { return 0; }
    if (_call_dotted(S, ti) == 1) { return 0; }
    if (_call_is_whole_arg(S, o - 1) == 0) { return 0; }
    var cfi = _gen_resolve_call(S, ti);
    if (_mv_callee(S, cfi) == 0) { return 0; }
    return _mv_struct_err(S, ti, ps, TOKVAL(S, ti), cfi, 0, 1);
}
# ... a whole method (or wrapped) call, judged after the argument's parse from `st` (`_push_struct_expr_arg`).
fn _mv_arg_mrc(S, fi, argc, st): i64 {
    var ps = GFPSID(S, fi, argc);
    if (_mv_named(S, ps) == 0) { return 0; }
    if (_pm_copies(fi, argc) == 0) { return 0; }
    return _mv_span(S, st, GTI(S), ps, 0);
}
# ... and a by-value parameter of 8 B or less (`_sarg_byval_small`: one word, never address-passed).
fn _mv_small_arg(S, fi, argc, st): i64 {
    var ps = GFPSID(S, fi, argc);
    if (_mv_named(S, ps) == 0) { return 0; }
    return _mv_span(S, st, GTI(S), ps, 0);
}
# A struct-typed declaration (`pscale` = `0 - sid`; a local or a global in either zone) whose initialiser
# [start, cursor), just parsed, is a whole multi-value call (PARSE_VAR's `_var_rhs_post`, the zone's
# `_gvi_expr`): the pointer-mode handle took the first value as the struct's address. A generic callee
# keeps the declared struct for this (`_gen_decl_check`).
fn _mv_decl_src(S, pscale, start): i64 {
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    if (_mv_named(S, 0 - pscale) == 0) { return 0; }
    return _mv_span(S, start, GTI(S), 0 - pscale, 2);
}
# The struct of an assignment's destination name `noff` when it is a named struct VALUE or handle — a
# local, a by-value parameter, a global — and not a `*P` (a pointer rebinds to any word); else 0.
# `*p = v` through a `*S` (`_dst_arms`: no name, the override's struct) copies what `G = v` copies (D4),
# so a multi-value call into it is refused as into `G` (D26 A, the user's decision, 2026-10-15): it
# stored the first value as the struct's word. CHANGELOG [6.7.13]
fn _mv_dst_sid(S, noff): i64 {
    if (_agc_ovr_is(noff) == 1) { return _mv_ovr_sid(S); }
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) {
            if (GLPTRP(S, li) == 1) { return 0; }
            var lt = GLTYPE(S, li);
            if (lt >= 0) { return 0; }
            if (_mv_named(S, 0 - lt) == 0) { return 0; }
            return 0 - lt;
        }
    }
    var gvi = FINDVAR(S, noff);
    if (gvi < 0) { return 0; }
    if (GVPM(S, gvi) == 0) { return 0; }
    if (_gv_ptr_sid(S, gvi) > 0) { return 0; }
    var gt = GVTYPE(S, gvi);
    if (_mv_named(S, gt) == 0) { return 0; }
    return gt;
}
fn _mv_ovr_sid(S): i64 {
    if (_mv_named(S, 0 - _agc_ovr_t) == 1) { return 0 - _agc_ovr_t; }
    return 0;
}
# `x = f(..);` / `x = b.m(..);`, the source [st, cursor) just parsed (`_pcmpe_struct_assign`, which the
# statement and a classic-for step reach once `_try_struct_call_assign` has passed the call by — it takes
# a struct-returning callee only): a refused source is typed as the destination's struct, so the
# statement does not also warn "assigning non-pointer to typed pointer".
fn _mv_asg_src(S, noff, st): i64 {
    if (TOKTYP(S, GTI(S) - 1) != 11) { return 0; }   # a call (or a wrap) ends the source
    var sid = _mv_dst_sid(S, noff);
    if (sid == 0) { return 0; }
    if (_mv_span(S, st, GTI(S), sid, 3) == 1) { _asg_ret_sid = sid; }
    return 0;
}
# `h.p = f(..);` / `h.p = x.m(..);` into a field of named struct `ft`, cursor on the source (`_fsc_src`,
# beside R17's `_tup_fsc_call`): a whole call ending at `term`, by its tokens. 1 = refused.
fn _mv_fsc_call(S, ft, term): i64 {
    if (_mv_named(S, ft) == 0) { return 0; }
    var o = _dt_call_open(S);
    if (o < 0) { return 0; }
    if (TOKTYP(S, _call_close(S, o) + 1) != term) { return 0; }
    var fi = _dt_call_fn(S);
    if (_mv_callee(S, fi) == 0) { return 0; }
    if (_mcall_open(S, GTI(S), 0 - 1) >= 0) { return _mv_struct_err(S, GTI(S), ft, TOKVAL(S, GTI(S) + 2), fi, 1, 2); }
    return _mv_struct_err(S, GTI(S), ft, PEEKV(S), fi, 1, 1);
}

# ⛔ 6.7.6 — A PARENTHESISED ARGUMENT TO AN ADDRESS-PASSED PARAMETER WAS PUSHED AS ITS VALUE:
# `rd3((a))` (`p: *P3`), `rd1((s))`, `rd1((mk1(4)))` SIGSEGV'd on x86 and aarch64 (an access
# violation on PE, a guest error on cx), because every arm above keys on the argument's first token
# being the name. Parentheses that wrap the WHOLE argument (`_pwrap_k`, any depth) are transparent:
# the arms run on what they wrap — a name, a call, a field, a method or operator result — and the
# `)`s are consumed after. Any other argument that opens with `(` (`(a) + b`) is an expression, as
# one that does not is (`_push_struct_expr_arg`). Returns as the caller's arms do. CHANGELOG [6.7.6]
fn _sarg_paren(S, fi, argc, tail): i64 {
    var st = GTI(S);
    if (_tup_sarg_lit(S, fi, argc, tail) == 1) { return 1; }   # 6.7.7 (B4): a tuple literal
    var k = _pwrap_k(S, st);
    var e = TOKTYP(S, _pw_end);
    if (e != 31) { if (e != 11) { return _push_struct_expr_arg(S, fi, argc, tail); } }
    STI(S, st + k);
    if (_try_push_struct_addr_arg(S, fi, argc, tail) == 0) {
        STI(S, st);   # not a struct source: the caller pushes the whole argument's value
        return 0;
    }
    _pw_close(S, k);
    return 1;
}

# ⛔ 6.7.7 (B4) — a tuple LITERAL as an address-passed argument (`take((1, 2))`, any wrap; every
# argument loop, the tail arm with `tail` 1): into a TUPLE parameter it is built in a frame temp and
# the temp's address pushed — an address in this frame, so a tail call diverts (`_sarg_escapes`).
# Into any other struct parameter it is refused by name, and at top level (no frame for the temp,
# R10); the literal is then consumed and 0 pushed, the parse in step. 1 = handled; 0 = not a whole
# literal argument. (An untyped parameter's literal is the stray refusal at its factor.)
fn _tup_sarg_lit(S, fi, argc, tail): i64 {
    var st = GTI(S);
    var lp = _tup_lit_at(S, st);
    if (lp < 0) { return 0; }
    var e = TOKTYP(S, _pw_end);
    if (e != 31) { if (e != 11) { return 0; } }
    var ps = GFPSID(S, fi, argc);
    var ok = 1;
    if (_tup_is(S, ps) == 0) {
        _tup_err(S, lp, "a tuple literal is passed only to a tuple parameter - this parameter of ", _fn_src_name(S, fi, L64(_fnt_names + fi * 8)), " is not a tuple");
        ok = 0;
    } elif (GINFN(S) != 1) {
        _tup_err(S, lp, "a tuple literal argument at top level has no frame to be built in - call ", _fn_src_name(S, fi, L64(_fnt_names + fi * 8)), " inside a fn");
        ok = 0;
    } elif (_tup_lit_shape(S, lp, ps) == 0) { ok = 0; }
    if (ok == 0) {
        _tup_lit_skip(S, st, 0);
        EMOVI(S, 0);
        EPUSHR(S);
        return 1;
    }
    var t = _agg_temp(S, ps);
    STI(S, lp);
    _tup_elems(S, ps, 0, t, 0);
    _pw_close(S, lp - st);
    _sarg_escapes(fi, argc, tail);
    EFLADDR(S, t);
    EPUSHR(S);
    return 1;
}

# ⛔ 6.7.3 — a parameter that records a struct but is NOT address-passed: a plain struct of 8 B or
# less (BY VALUE, one word) or a `Str` handle. It has no struct-mask bit, so it never reached the
# arms above and nothing compared its argument — `bs1(t)` with `t: T1` into `b: S1` compiled clean.
# The argument is parsed and pushed exactly as the caller's own fallback pushes it (PCMPE +
# EPUSHR: byte-identical), and its static struct is checked: a bare name; a whole free call,
# resolved AFTER the parse (a dedup hit — resolving it first would move a generic's instantiation);
# a whole method / operator result (`_sc_post`'s record); a whole struct-typed field (the passive
# `_fpk` record, parse_decl.cyr). Returns 1 (consumed) only for such a parameter; 0 leaves every
# other one to the caller. All three argument loops reach it. CHANGELOG [6.7.3]
# 6.7.10 (B7-1): a HANDLE of 8 B or less (`take(a)`, `take((a))`) passes the struct it points at, as
# one over 8 B does (`_hl_bare_val`) — the handle's address was the argument. (B7-1b) so does a typed
# POINTER or `&s` (`_hl_byval_arg`, the user's decision 7). CHANGELOG [6.7.10]
fn _sarg_byval_small(S, fi, argc): i64 {
    if (_sarg_vec_other(S, fi, argc) == 0) {   # 6.7.12 (D27): a vector local into `*i64` / `*u8` / `**T`
        if (_sarg_struct_other(S, fi, argc) == 0) {   # 6.7.13 (D5 (a)): ... and a struct value
            if (_sarg_sval_ptr(S, fi, argc) == 1) { return 1; }   # 6.7.14: a field, call or dereference too
        }
    }
    if (GFPSID(S, fi, argc) <= 0) { return 0; }
    var st = GTI(S);
    var asid = _expr_struct_sid(S, st);
    var ps = GPSC(S);
    if (asid == 0) { asid = _ess_deref(S, st); }   # 6.7.11: `take8(*pu)`
    _mv_small_arg(S, fi, argc, st);   # 6.7.11: a multi-value call is no struct value
    _sarg_type_errf(S, fi, argc, asid, _ess_nm, _ess_fi);
    if (_hl_byval(S, fi, argc) == 1) { _hl_byval_arg(S, fi, argc, st, ps); }
    else { _istr_arg(S, fi, argc, st); }   # 6.7.13 (D7 (1)): an inline `Str` into `s: Str` passes its header
    EPUSHR(S);
    return 1;
}
# The expression at the cursor (token `st`) parsed with its static-struct records armed — a bare
# name; a whole free call, resolved AFTER the parse; a whole method / operator result; a whole
# struct-typed field; a whole `Str` field — returning that struct (0 = untyped / scalar / unknown),
# `_ess_nm` the name a refusal names. Extracted from `_sarg_byval_small` (6.7.7) for the tuple
# literal's elements (`_tup_elem_val`), which are refused when they are struct values.
# ⛔ 6.7.11 — parentheses wrapping the WHOLE expression (`_pwrap_k`, any depth) are transparent here
# too, as 6.7.6 made them for an address-passed parameter (`_sarg_paren`): `bs1((t))`, `bs1(((t)))`,
# `bs1((mk(7)))` and `bs1((w.t))` into a by-value struct of 8 B or less read the name, call or field
# they wrap — they compiled with another struct's word, where `bs1(t)` was refused by name (the user's
# decision, 2026-10-13: refuse by name). The parse and its emission are unchanged. CHANGELOG [6.7.11]
var _ess_nm = 0;
var _ess_fi = 0 - 1;   # 6.7.14: ... the fn whose result it names (a method's record), else -1
fn _expr_struct_sid(S, st): i64 {
    var asid = 0;
    var nm = 0;
    var call = 0;
    var ist = _ess_wrap(S, st);
    var k = _ess_k;
    if (TOKTYP(S, ist) == 2) {
        nm = TOKVAL(S, ist);
        var nx = TOKTYP(S, ist + 1);
        if (k > 0) {
            if (ist + 1 == _ess_ie) { asid = _sarg_name_sid(S, ist); }
            elif (nx == 10 || nx == 19) { call = 1; }
        }
        elif (nx == 31 || nx == 11) { asid = _sarg_name_sid(S, st); }
        elif (nx == 10 || nx == 19) { call = 1; }
    }
    var fk = _fpk_want;
    _fpk_want = ist;
    _fpk_ft = 0;
    _sc_beg = 0 - 1;                   # only this argument's own record may match
    PCMPE(S);
    _fpk_want = fk;
    _ess_fi = 0 - 1;
    if (call == 1) { asid = _ess_call(S, ist, k); }
    if (asid == 0) {
        if (_sc_whole(S, st) != 0 - 2) { asid = _sc_sid; nm = _sc_fn; _ess_fi = _sc_fi; }
        elif (_fpk_ft > 0) { if (_fpk_end + k == GTI(S)) { asid = _fpk_ft; nm = _fpk_name; } }
        elif (_fls_whole(S, st) == 1) { asid = _fls_sid; nm = _fls_name; }   # 6.7.6: a `Str` field
    }
    _ess_nm = nm;
    return asid;
}
# The first token inside the parentheses that wrap the whole expression at `st` up to its `,` / `)`
# (`_ess_k` of them, `_ess_ie` the innermost `)`), else `st` with `_ess_k` 0. Moves nothing.
var _ess_k = 0;
var _ess_ie = 0 - 1;
fn _ess_wrap(S, st): i64 {
    _ess_k = 0;
    _ess_ie = 0 - 1;
    if (TOKTYP(S, st) != 10) { return st; }
    var k = _pwrap_k(S, st);
    var e = TOKTYP(S, _pw_end);
    if (e != 31) { if (e != 11) { return st; } }
    _ess_k = k;
    _ess_ie = _pw_end - k;
    return st + k;
}
# ⛔ 6.7.11 — A WHOLE DEREFERENCE INTO A BY-VALUE STRUCT OF 8 B OR LESS IS CHECKED BY ITS STRUCT, as
# over 8 B (`_dro_check`) and in a declaration (`_hl_dstar`): `*p` is a struct VALUE at every size (6.7.10,
# decision 6), so `take8(*pu)` with `pu: *U8` into `s: S8` is refused by name, as `take8(u)` is — it
# compiled and passed U8's bytes (the user's decision, 2026-10-13: refuse by name; `take8(pu)` keeps the
# 2026-10-08 pointer rule). After the argument's parse, [st, cursor) is one `* E` inside any balanced
# parentheses, nothing after it (`*pu + a` is an operator's operand), E typed `*U` by the compiler's own
# typing (`_hl_dpsid`): U, `_ess_nm` the operand's last name (`*gp()` -> `gp`, `*w.pu` -> `pu`); else 0.
# Reads tokens only: the emission is unchanged. CHANGELOG [6.7.11]
fn _ess_deref(S, st): i64 {
    var a = _ie_unparen(S, st, GTI(S));
    var pe = _ie_pe;
    if (pe - a < 2) { return 0; }
    if (TOKTYP(S, a) != 8) { return 0; }
    if (_gz_split(S, a, pe) != 0 - 1) { return 0; }
    var u = _hl_dpsid(S, a + 1, pe);
    if (u <= 0) { return 0; }
    _ess_nm = _hl_lastnm(S, a + 1, pe, TOKVAL(S, a + 1));   # 6.7.11: `*gu<U>()` names `gu`
    return u;
}
# The struct a whole free call at `ti` returns (`_sarg_call_sid`), after the parse; inside `k`
# wrapping parentheses it must end at the innermost `)` (`(mk(7) + a)`, `(mk(7), a)` are not it).
fn _ess_call(S, ti, k): i64 {
    if (k > 0) {
        var o = _gcall_open(S, ti);
        if (o < 0) { return 0; }
        if (_call_close(S, o) + 1 + k != GTI(S)) { return 0; }
    }
    return _sarg_call_sid(S, ti);
}

# ⛔ 6.6.20 — the CLOSURE-CAPTURE arm. A captured struct of 8 B or less is one env word holding
# the struct BY VALUE, and it was pushed as that value — harmless while only a struct over 8 B was
# address-passed (its one word holds the struct's address), fatal once a `p: *S` parameter of any
# size is: `|| rd1(s)` SIGSEGV'd where `|| rd3(a)` worked. `_CL_CAP_BASE_RA` is the address for
# every shape (the env word's own address, or the address it holds). Returns 1 when handled.
fn _push_struct_addr_cap(S, fi, argc): i64 {
    var cx = _CL_CAP_FIELD_IDX(S, PEEKV(S));
    if (cx >= 0 - 1) { return 0; }
    _sarg_type_err(S, fi, argc, _cap_fld_sid, PEEKV(S));   # 6.7.3
    _CL_CAP_BASE_RA(S, 0 - 1000000 - cx, _cap_fld_sid);
    EPUSHR(S);
    STI(S, GTI(S) + 1);                 # consume IDENT
    return 1;
}

# 6.6.5 — the GLOBAL arm of the by-value struct argument. The callee's structmask says this
# parameter is ADDRESS-passed, and there was no global branch at all: a global struct argument
# was pushed BY VALUE (its first 8 bytes), so the callee deref'd a field as a pointer and
# SIGSEGV'd — `take(G)` for a top-level `var G = P { 11, 22 };` crashed where the identical
# local worked. `_var_ptrmode` is the recorded layout: 2 = inline (push its address), 1 = the
# slot holds the address (push the slot). 0 means this global is not a recorded aggregate, so
# leave it to the ordinary value push rather than guessing from GVTYPE, whose positive range is
# shared with scalar widths. CHANGELOG [6.6.5]
fn _push_struct_addr_global(S, fi, argc): i64 {
    var gvi = FINDVAR(S, PEEKV(S));
    if (gvi < 0) { return 0; }
    var gpm = GVPM(S, gvi);
    if (gpm == 0) { return 0; }
    _sarg_type_err(S, fi, argc, _sarg_gv_sid(S, gvi), PEEKV(S));   # 6.7.3
    if (gpm == 1) { EVLOAD(S, gvi); } else { EVADDR(S, gvi); }
    EPUSHR(S);
    STI(S, GTI(S) + 1);                 # consume IDENT
    return 1;
}

# ⛔ 6.6.5 — is this struct-typed local POINTER-mode (its slot holds the struct's address) or
# INLINE (the slot IS the struct)? ONE reader, and it READS THE RECORDED BIT.
#
# This fn shipped earlier in 6.6.5 carrying the historical GUESS, which is quoted below so the
# next reader can recognise it rather than reinvent it:
#
#     if (li > 0) { if (L64(S + 0x5D9D000 + (li - 1) * 8) == 0 - 1) { is_ptr = 0; } }
#     if (_TARGET_CX == 0) { if (sid > 0) { if (STRUCTSZ(S, sid - 1) <= 8) { is_ptr = 0; } } }
#
# "the slot below is named -1" is NOT a discriminator for inline-ness. SCOPE_POP writes -1 over
# every local of a block that has closed (util.cyr), and callptr / bitset / SIMD-reserve /
# closure-env temporaries are registered -1 by construction — so a POINTER-mode struct local
# declared after any of those was read as inline and its fields came off the frame. Wrong since
# 5.8.17, silent, and measured in a shipped consumer (stiva's fleet.cyr let an undersized node
# pass its memory constraint). The `<= 8 B` half was the ABI policy stated at the wrong end: cx
# was excluded from it, so on cx two single-field struct locals aliased each other.
#
# Registration now records the answer (SLAGG / GLAGG, util.cyr), so every consumer — field
# load/store, method self, by-value argument passing, copy-init, copy-assign and the regalloc
# picker's aggregate span — asks THIS fn and they cannot disagree. CHANGELOG [6.6.5]
fn _local_struct_is_ptr(S, li, lt): i64 {
    if (GLAGG(S, li) == 1) { return 0; }
    return 1;
}

# ⛔ 6.6.6 — A BY-VALUE STRUCT PARAMETER OVER 8 BYTES IS ADDRESS-PASSED, so its slot holds a
# POINTER to the caller's struct (`_param_wants_struct_ptr` sets the callee's structmask and the
# caller pushes `&local`). Field access already went the extra indirection
# (`_resolve_field_base_addr`); the COPY and RETURN paths did not, and every one of them was
# silent or fatal. Measured at 6.6.5: `q = r` stored r's first word OVER the pointer and the next
# `q.z` SIGSEGV'd; `r = q` copied the pointer into r's field 0; `return q;` from a 9-16 B fn
# loaded the ADDRESS as the rax:rdx pair and from a >16 B fn byte-copied the pointer word.
#
# ⭐ `li < _cur_fn_pslots` IS the discriminator, and it has to be, because the OTHER pointer-mode
# struct local — `var a = str_from(x)`, a heap handle — looks identical in every recorded field.
# `a = b` between two of those must stay a POINTER REBIND (that is the Str convention the whole
# stdlib is built on), while `q = r` on a parameter must copy through. Nothing but "is it a
# parameter" separates them. CHANGELOG [6.6.6]
fn _local_is_sptr_param(S, li): i64 {
    if (li < 0) { return 0; }
    if (li >= _cur_fn_pslots) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    if (GLAGG(S, li) != 0) { return 0; }
    var lt = GLTYPE(S, li);
    if (lt >= 0) { return 0; }
    if (lt <= 0 - 2048) { return 0; }
    var sid = 0 - lt;
    if (STRUCTSZ(S, sid - 1) <= 8) { return 0; }
    # ⛔ `Str` / `Result` / `Option` / `Tagged` are 16 B structs BY NAME whose slot holds a HEAP
    # HANDLE — `_param_wants_struct_ptr` excludes them, so they are value-passed and `a = b`
    # between two of them is a pointer rebind the whole stdlib depends on. Asked through the
    # SAME classifier that built the callee's structmask, on the recorded sid's name, so the two
    # cannot disagree about which parameters are address-passed.
    if (_classify_param_type(S, L64(S + 0x1A6018 + (sid - 1) * 8)) != 0) { return 0; }
    return 1;
}
# ⛔ 6.7.9 — 1 when `&q` of slot `li` is the slot's CONTENT: an address-passed by-value struct
# parameter, whose slot holds the caller's struct's address (since 6.6.16 only a `#naked` fn's: the
# rest are copied in, and an `async fn` refuses one). A `q: *P` parameter (an untyped impl `self`) has
# the same `-sid` type and non-inline layout, so `_local_is_sptr_param` answers 1 for it, but its
# slot holds a POINTER: `&q` is the slot's address, as for a `*P` local, a `*Q` of 8 B or less, a
# `*i64` and in 6.6.5. It was the pointee (`load64(&q)` read q's first field). CHANGELOG [6.7.9]
fn _addr_is_slot_content(S, li): i64 {
    if (_is_ptr_param(S, li) == 1) { return 0; }
    return _local_is_sptr_param(S, li);
}

# 6.6.6 — materialise an address-passed struct parameter as an INLINE frame aggregate, so the
# `return` paths (which address a local's slots directly) read the struct and not the pointer.
# Returns the temp's field-0 slot. CHANGELOG [6.6.6]
# ⛔ 6.6.17 (a1) — the local a `return x;` from a by-value struct fn reads, made INLINE. Both
# return arms address the local's SLOTS (the >16 B byte copy, the 9-16 B rax:rdx load), so a slot
# that HOLDS the struct's address handed back the pointer: an address-passed parameter (above) and
# a HANDLE — a pointer-mode local (`var p: Pt = alloc(16); .. return p;`), which 6.6.16 C2 made
# copy on `=` but not on `return` (the caller's `q.x` read a heap address, on every backend).
# Either is copied through its address into an inline temp. A struct of 8 B or less returns in rax
# (`_ret_small_ptrp` copies a handle's, 6.7.10), and `Str` / `Result` / `Option` / `Tagged` slots are
# handles by convention (`_agc_plain_big`): both untouched. CHANGELOG [6.6.17]
fn _ret_local_inline(S, li): i64 {
    if (_local_is_sptr_param(S, li) == 1) { return _sptr_param_temp(S, li, _cur_fn_ret_sid); }
    if (GLAGG(S, li) != 0) { return li; }
    if (_agc_plain_big(S, GLTYPE(S, li)) == 0) { return li; }
    return _sptr_param_temp(S, li, _cur_fn_ret_sid);
}
# ⛔ 6.7.6 — `return (j);`, `return (mk3(v));`, `return (a + b);` in a fn returning a struct over 8 B
# were refused ("return must be a bare local identifier, or a call ..." / "... got `(...)`"): the
# struct return took its shape from the first token. Parentheses wrapping the WHOLE return value are
# transparent, as for every other struct destination (`_pwrap_k`): `_ret_peel` steps inside them
# and makes `)` the value's terminator (`_ret_term`), `_ret_end` closes them before the `;`, and a
# call the rax:rdx class passes straight through is handed back to the scalar path wrap and all
# (`_ret_unpeel`). The two class bodies moved out of PARSE_RETURN (cybs's per-fn reference
# ceiling). CHANGELOG [6.7.6]
var _ret_pk = 0;     # the parentheses `_ret_peel` stepped into
var _ret_term = 5;   # the token that ends the return value: `;`, or the wrap's first `)`
fn _ret_peel(S): i64 {
    _ret_pk = 0;
    _ret_term = 5;
    if (PEEKT(S) != 10) { return 0; }
    if (_tup_lit_at(S, GTI(S)) >= 0) { return 0; }   # 6.7.7: `return ((a, b));` — a literal, not a wrap
    var k = _pwrap_k(S, GTI(S));
    if (TOKTYP(S, _pw_end) != 5) { return 0; }
    STI(S, GTI(S) + k);
    _ret_pk = k;
    _ret_term = 11;
    return 0;
}
fn _ret_unpeel(S): i64 {
    STI(S, GTI(S) - _ret_pk);
    _ret_pk = 0;
    _ret_term = 5;
    return 0;
}
fn _ret_end(S): i64 {
    _pw_close(S, _ret_pk);
    _ret_pk = 0;
    _ret_term = 5;
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    return 0;
}
# The retptr class (`_cur_fn_ret_stash` > 0): the value copied into our caller's buffer.
fn _ret_struct_big(S): i64 {
    _ret_peel(S);
    # 6.6.6: `return f(..);` where `f` returns this same struct — emitted into a temp, then
    # copied into our retptr like `return IDENT;`. It used to take the tail path and crash.
    var srn_lli = _ret_ptr_src(S);   # 6.7.11: a `*S` (global, `: *S` call, field, ..) or `*E`
    if (srn_lli < 0) { srn_lli = _return_struct_call(S); }
    if (srn_lli < 0) { srn_lli = _return_struct_expr(S); }   # a method / operator (bite 14 review)
    if (srn_lli < 0) { srn_lli = _slit_ret(S); }   # 6.7.14 (D12 (a)): `return P { .. };`, by name
    if (srn_lli < 0) {
        if (PEEKT(S) != 2) {
            ERR_MSG(S, "struct-return fn: return must be a bare local identifier, or a call to a fn returning the same struct", 101);
        }
        var srn_noff = PEEKV(S);
        if (TOKTYP(S, GTI(S) + 1) != _ret_term) {
            ERR_MSG(S, "struct-return fn: return must be a bare local identifier, or a call to a fn returning the same struct", 101);
        }
        srn_lli = FINDLOCAL(S, srn_noff);
        if (srn_lli < 0) {
            ERR_MSG(S, "struct-return: identifier is not a local", 40);
        }
        var srn_lt = GLTYPE(S, srn_lli);
        if (srn_lt >= 0) {
            ERR_MSG(S, "struct-return: identifier is not struct-typed", 45);
        }
        if ((0 - srn_lt) != _cur_fn_ret_sid) {
            ERR_MSG(S, "struct-return: identifier type != fn ret_sid", 44);
        }
        STI(S, GTI(S) + 1);            # consume IDENT
    }
    _ret_end(S);                   # 6.7.6: a wrap's `)`, then `;`
    # 6.6.6 — `return q;` where `q` is a by-value struct PARAMETER: its slot holds the
    # caller's ADDRESS, so the byte-copy below would copy the pointer word. Materialise the
    # struct into an inline temp and return THAT. See `_local_is_sptr_param`.
    # 6.6.17 (a1): and a HANDLE (a pointer-mode local). See `_ret_local_inline`.
    srn_lli = _ret_local_inline(S, srn_lli);
    # Byte-copy size (aligned up to 8 — the retptr slot is already
    # 8-aligned so padded copies are safe)
    var srn_sz = STRUCTSZ(S, _cur_fn_ret_sid - 1);
    var srn_aligned = (srn_sz + 7) & (0 - 8);
    # Source disp: &IDENT (bottom of struct) in the fn's frame
    var srn_src_disp = 0 - ((srn_lli + 1) * 8);
    if (_cur_fn_regalloc > 0) { srn_src_disp = srn_src_disp - _cur_fn_regalloc * 8; }
    if (_cur_fn_ret_stash > 0) { srn_src_disp = srn_src_disp - _cur_fn_ret_stash; }
    # Retptr stash disp: [rbp - regalloc*8 - 8]
    var srn_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
    # v5.9.26 Phase 2b-aarch64 (LDRB/STRB byte-copy loop):
    # cx bytecode still has no struct-return opcode → ERR_MSG;
    # aarch64 emits the LDRB/STRB analog of x86's `rep movsb`.
    # Encoding plan (3-instr loop body + setup + tail):
    #   movz/sub  x9, x29, #|src_disp|         ; via _EFP_ADDR_X9
    #   ldur      x10, [x29, #stash_disp]      ; retptr
    #   movz      x11, #aligned_byte_count
    # loop:
    #   ldrb      w12, [x9], #1                ; post-inc source
    #   strb      w12, [x10], #1               ; post-inc dest
    #   subs      x11, x11, #1
    #   b.ne      loop                         ; -3 instructions back
    #   ldur      x0, [x29, #stash_disp]       ; reload retptr
    # Constraints:
    #   - aligned size must fit MOVZ imm16 (< 65536). Cyrius
    #     struct sizes are bounded well below this in practice;
    #     guard error fires for the implausible large case.
    #   - stash_disp = -(regalloc*8 + 8). With regalloc cap of
    #     5, stash_disp in [-48,-8] always fits LDUR's signed
    #     9-bit immediate (-256..+255). Defensive guard checks.
    # v5.9.40 — struct-by-value return now goes through each
    # backend's `ESTRUCT_BYVAL_COPY` helper. Closes Phase 2c #1
    # (cx was the last remaining ERR_MSG path; aarch64 landed
    # at v5.9.26, x86 has been there since v5.6.12). Each
    # backend chooses its own copy strategy:
    #   x86      — push rsi/rdi + lea/mov + `rep movsb` (3 B)
    #   aarch64  — LDRB/STRB byte-loop with post-increment
    #   cx       — load8/store8 byte-loop with explicit
    #              add r9/r10/r11 + jnz back-jump (cxvm has
    #              no rep/post-incr semantics).
    # Constraints (apply to all backends in practice; named
    # at this call site for clarity since they are real
    # encoding limits, not invariants of the helper):
    #   - aligned byte count must fit MOVZ imm16 (< 65536) on
    #     aarch64. Cyrius struct sizes are bounded well below
    #     this; guard fires for the implausible large case.
    #   - stash_disp = -(regalloc*8 + 8) on aarch64 must fit
    #     LDUR's signed 9-bit immediate (-256..+255). With
    #     regalloc cap of 5, stash_disp is in [-48,-8] — safe.
    if (_AARCH64_BACKEND == 1) {
        if (srn_aligned > 65535) {
            ERR_MSG(S, "struct return by value: struct >= 64 KB pending Phase 2c (movz/movk chain)", 74);
        }
        if (srn_stash_disp < 0 - 256) {
            ERR_MSG(S, "struct return by value: stash_disp out of LDUR imm9 range — increase regalloc-aware fallback", 94);
        }
    }
    ESTRUCT_BYVAL_COPY(S, srn_src_disp, srn_stash_disp, srn_aligned);
    # jmp to epilogue (regular return-patch path)
    var srn_rp = EJMP0(S);
    vec_push(rp_vec, srn_rp);
    return 0;
}
# The rax:rdx class (9-16 B): 1 = the return was emitted; 0 = a call returning this struct in the
# same two registers (or a refused shape) left for the scalar path, the cursor at the value.
fn _ret_struct_pair(S): i64 {
    _ret_peel(S);
    if (_dyn_ret(S) == 1) { return 1; }   # 6.7.8 (D5): a dyn formed in a temp
    if (_ret_ptr_pair(S) == 1) { return 1; }   # 6.7.11: a `*S` (global, `: *S` call, field, ..) or `*E`
    if (PEEKT(S) == 2) {
        if (TOKTYP(S, GTI(S) + 1) == _ret_term) {
            var _ip_noff = PEEKV(S);
            var _ip_lli = FINDLOCAL(S, _ip_noff);
            if (_ip_lli >= 0) {
                var _ip_lt = GLTYPE(S, _ip_lli);
                # Multi-slot typed local: lt < 0 AND -lt == ret_sid.
                # Single-slot heap-handle pattern (e.g. `var s = alloc(...)`
                # in a fn returning : Str) falls through to scalar PCMPE.
                if (_ip_lt < 0) {
                    if ((0 - _ip_lt) == _cur_fn_ret_sid) {
                        STI(S, GTI(S) + 1);     # consume IDENT
                        _ret_end(S);            # 6.7.6: a wrap's `)`, then `;`
                        # 6.6.6 — an address-passed parameter holds the caller's pointer,
                        # not the pair. Materialise it inline first.
                        # 6.6.17 (a1): and a HANDLE. See `_ret_local_inline`.
                        _ip_lli = _ret_local_inline(S, _ip_lli);
                        EFLLOAD_STRUCT_INT_PAIR(S, _ip_lli);
                        var _ip_rp = EJMP0(S);
                        vec_push(rp_vec, _ip_rp);
                        return 1;
                    }
                }
            }
        }
    }
    # 6.6.6 — EVERYTHING ELSE. A method / overloaded operator returning this same struct is
    # landed in a frame temp and loaded as the pair; a call returning it in the same two
    # registers passes straight through PCMPE; anything else cannot be carried and is
    # refused by name instead of silently handing back rax plus an unwritten rdx.
    # See `_refuse_pair_return`.
    if (_pair_ret_expr_shape(S) == 1) {
        var _pe_t = _return_struct_expr(S);
        EFLLOAD_STRUCT_INT_PAIR(S, _pe_t);
        _ret_end(S);            # 6.7.6: a wrap's `)`, then `;`
        var _pe_rp = EJMP0(S);
        vec_push(rp_vec, _pe_rp);
        return 1;
    }
    if (_pair_ret_call_ok(S) == 0) {   # 6.7.7: a tuple literal's own refusal is its factor's
        if (_tup_lit_at(S, GTI(S)) < 0) { if (PEEKT(S) != 97) { _refuse_pair_return(S); } }   # 6.7.13: and ret2's
    }
    _ret_unpeel(S);   # 6.7.6: a call passes through the scalar path, wrap and all
    _dyn_ret_arm(S);  # 6.7.8: and a dyn-returning call is this return's value, not a use of one
    return 0;
}
# ⛔ 6.7.11 — `return E;` IN A FN RETURNING THE STRUCT S, WITH E A `*S` OR A DEREFERENCE OF ONE, IS THE STRUCT
# E POINTS AT, AT EVERY SIZE (the user's decision, 2026-10-13, (a): decision 6's rule on the `return` side —
# `l = GP`, `l = gp()`, `l = w.p` copy the pointee at every size, and a `*S` local returns it over 8 B since
# 6.6.6). Over 8 B `return GP;`, `return gp();`, `return w.p;` and `return *GP;` were refused ("... got `GP`",
# "identifier is not a local", "return must be a bare local identifier ..."); at 8 B or less the first three
# returned the POINTER (`_ret_small_ptr` there) (issues/2026-10-13-small-struct-return-of-pointer-global-
# or-call-decision.md). The value — `_ret_peel` stepped into its wrap — is ONE dereference `* E` of a `*X`
# (`_hl_dstar_t`), or an expression the compiler's own typing (`_hl_psid`) types `*X`: a `*X` global, a call or
# method declared `: *X`, a `*X` field, pointer arithmetic, a `*X` local or parameter (the bare name of one of
# S stays on the local arms: `_ret_local_inline` copies it, 6.6.6 / 6.6.17). X another struct is refused by
# name; else the value is parsed, its pointer parked (`_HTEMP`) and S's bytes copied through it into a frame
# temp — returned, the cursor on `_ret_term`. -1 = not this shape (cursor kept). Never inside an inline
# replay, as `_ret_small_cls`. CHANGELOG [6.7.11]
# ⛔ 6.7.13 — `return &s;` IS `return s;` (the user's decision D4 (a), 2026-10-15): the value is typed by the
# dereference operand typer (`_hl_dpsid`), so `& IDENT` of an inline struct — a local, a by-value parameter,
# a value global, a captured copy — is the struct it points at, as `bs(&s)` into a by-value parameter is
# (6.7.10 decision 7): over 8 B it was refused in other words ("... two registers ...", "return must be a
# bare local identifier ..."), at 8 B or less (`_ret_small_ptr`) the ADDRESS of a dead frame was the
# struct's word. `&u` of another struct is refused by name (kind 3). A handle's / `*T`'s `&h` is its slot,
# untyped here. CHANGELOG [6.7.13]
fn _ret_ptr_src(S): i64 {
    if (GIDEP(S) != 0) { return 0 - 1; }
    if (_dx_plain(S, _cur_fn_ret_sid) == 0) { return 0 - 1; }   # a dyn / tuple / Str fn: its own arms
    var st = GTI(S);
    var ds = _hl_dstar_t(S, st, _ret_term);
    if (ds > 0) {
        if (_dx_plain(S, ds) == 0) { return 0 - 1; }
        if (ds != _cur_fn_ret_sid) { _ret_sid_refuse(S, st, _hl_dnm, 0 - 1, ds, 2); }
        return _ret_ptr_copy(S, _hl_dx_src(S));
    }
    var e = _hl_dx_end(S, st, _ret_term);
    if (e < 0) { return 0 - 1; }
    var a = _ie_unparen(S, st, e);
    var pe = _ie_pe;
    var af = _ret_addr_field(S, a);   # 6.7.13 (D3 (b)): `&w.s`, refused once
    if (af >= 0) { return af; }
    if (_ret_slot_amp(S, a, pe) == 1) { return _ret_park_copy(S); }   # 6.7.14 (D19 (a)): `&h`, a slot
    var ps = _hl_dpsid(S, a, pe);   # 6.7.13 (D4 (a)): `& IDENT` of an inline struct too
    var kind = 1 + 2 * _hl_damp;
    if (ps <= 0) { return 0 - 1; }
    if (_dx_plain(S, ps) == 0) { return 0 - 1; }
    if (ps == _cur_fn_ret_sid) { if (pe == a + 1) { if (FINDLOCAL(S, TOKVAL(S, a)) >= 0) { return 0 - 1; } } }
    if (ps != _cur_fn_ret_sid) { _ret_sid_refuse(S, st, _hl_pnm(S, a, pe), 0 - 1, ps, kind); }
    PCMPE(S);
    var h = _HTEMP(S);
    _HTSTORE(S, h);
    return _ret_ptr_copy(S, h);
}
# `return &w.s;` (`a` the value's `&`, a `.` two tokens on): the address of a field, which D3 (b) refuses by
# name — parsed here (`_addr_field_post`: once, the parse in step), so the pair class's "two registers" and the
# retptr class's "bare local identifier" refusals never run beside it or in its place (8 B and less parse it in
# PCMPE already). Handled as a pointer value; no binary follows the error. -1 = not this shape. CHANGELOG [6.7.13]
fn _ret_addr_field(S, a): i64 {
    if (TOKTYP(S, a) != 27) { return 0 - 1; }
    if (TOKTYP(S, a + 2) != 41) { return 0 - 1; }
    return _ret_park_copy(S);
}
# The value parsed as a pointer, parked (`_HTEMP`) and the fn's struct copied through it into a temp: the temp.
fn _ret_park_copy(S): i64 {
    PCMPE(S);
    var h = _HTEMP(S);
    _HTSTORE(S, h);
    return _ret_ptr_copy(S, h);
}
# ⛔ 6.7.14 — `return &q;` IN A FN RETURNING THE STRUCT S, WITH q A HANDLE, A `*T` OR AN UNTYPED `self`, IS REFUSED
# BY NAME AT EVERY SIZE (the user's D19 (a), 2026-10-16; issues/2026-10-15-return-address-of-handle-or-pointer-in-
# struct-fn.md): `&q` is the address of q's own slot (the handle line, 6.7.10 decision 5), no pointer to a struct —
# 6.7.13's D4 (a) reads `&s` as the struct only for an inline s (`_hl_amp_sid`). At 8 B or less the slot's address
# was the struct's word (the caller read a dead frame's address as its field); over 8 B the class's own refusal ran,
# naming nothing. The value [a, pe), inside any parentheses, exactly `& IDENT` with IDENT a struct-typed local,
# parameter, capture or global whose `&` is its slot — a `*T` (an untyped `self` is one), or a handle of a plain
# struct: refused at the `&`, once (`_ret_slot_refuse`), before the classes' refusals. 1 = refused. CHANGELOG [6.7.14]
fn _ret_slot_amp(S, a, pe): i64 {
    if (pe != a + 2) { return 0; }
    if (TOKTYP(S, a) != 27) { return 0; }
    if (TOKTYP(S, a + 1) != 2) { return 0; }
    var noff = TOKVAL(S, a + 1);
    var t = _hl_name_ty(S, noff);
