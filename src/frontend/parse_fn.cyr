                    # POINTER in a positional int arg reg (rcx/rdx/r8/r9, then
                    # stack). Set struct_mask (drives the caller's &local push)
                    # and copy the pointed-to bytes into the same multi-slot
                    # frame the SysV path uses, so downstream &v/lanes match.
                    # The vector consumes ONE integer arg reg (int_pc), NOT XMM —
                    # positional with any int params, +1 for a retptr-return fn.
                    struct_mask = _pmw(struct_mask, pc, 1);
                    var _pe_shift = 0;
                    if (_cur_fn_ret_stash > 0) { _pe_shift = 1; }
                    var _pe_bytes = 16;
                    if (pt_simd_class == 2) { _pe_bytes = 32; }
                    if (_cur_fn_naked == 0) {
