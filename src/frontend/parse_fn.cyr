                    var _rs_b1 = load8(S + 0x60000 + _rs_rt_noff + 1);
                    var _rs_b2 = load8(S + 0x60000 + _rs_rt_noff + 2);
                    var _rs_b3 = load8(S + 0x60000 + _rs_rt_noff + 3);
                    var _rs_is_scalar = 0;
