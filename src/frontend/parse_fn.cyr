                if (PEEKT(S) != 11) {
                    var iago = 1;
                    while (iago == 1) {
                        if (iargc == 0) { _ginf0 = _infer_conc_at_cursor(S); }
                        if (iargc == 1) { _ginf1 = _infer_conc_at_cursor(S); }
                        PCMPE(S);
                        if (iargc == 0) { EFLSTORE(S, p0_slot); }
                        if (iargc == 1) { EFLSTORE(S, p1_slot); }
                        iargc = iargc + 1;
                        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                        else { iago = 0; }
