    if (t == 2) { return _ce_name(S); }
    if (t == 15) { return _ce_ifx(S); }   # 6.7.4 (B3): an if-expression
    _ce_bad(S, "not a compile-time expression: a const context takes literals, consts, enum constants, sizeof, const fn calls and arithmetic", 124);
    return 0;
}

# The f64 builtins a const evaluation takes — exact operations only (no transcendental: its
# runtime result is the target's library's, not something to reproduce bit for bit).
fn _ce_fbuiltin(t): i64 {
    if (t >= 62) { if (t <= 71) { return 1; } }
    if (t >= 80) { if (t <= 82) { return 1; } }
    if (t >= 164) { if (t <= 166) { return 1; } }
    return 0;
}
fn _ce_fcall(S, t): i64 {
    _ce_ti = _ce_ti + 1;
    if (_ce_expect(S, 10) == 0) { return 0; }
    var a = _ce_expr(S);
    var ak = _ce_k;
    var b = 0;
    var two = 0;
    if (t >= 62) { if (t <= 65) { two = 1; } }
    if (t >= 68) { if (t <= 70) { two = 1; } }
    if (t == 164 || t == 165) { two = 1; }
    if (two == 1) {
        _ce_expect(S, 31);
        b = _ce_expr(S);
    }
    _ce_expect(S, 11);
    _ce_k = 0;
    if (_ce_err == 1) { return 0; }
    if (_ce_skip > 0) { if (_ce_fres(t) == 1) { _ce_k = 1; } return 0; }
    if (ak == 2) { _ce_bad(S, "a string passed to an f64 builtin", 33); return 0; }
    return _ce_fop(S, t, a, b);
}
# 1 iff builtin t returns an f64 (the rest return an i64: f64_to and the comparisons).
fn _ce_fres(t): i64 {
    if (t == 67) { return 0; }
    if (t >= 68) { if (t <= 70) { return 0; } }
    if (t == 164 || t == 165) { return 0; }
    return 1;
}
fn _ce_fop(S, t, a, b): i64 {
    _sf_err = 0;
    var r = 0;
    if (t == 62) { r = _sf_add(a, b); }
    elif (t == 63) { r = _sf_sub(a, b); }
    elif (t == 64) { r = _sf_mul(a, b); }
    elif (t == 65) { r = _sf_div(a, b); }
    elif (t == 66) { r = _sf_from_i64(a); }
    elif (t == 67) { r = _sf_to_i64(a); }
    elif (t == 71) { r = _sf_neg(a); }
    elif (t == 80) { r = _sf_abs(a); }
