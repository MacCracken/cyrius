    if (_mrc_end != GTI(S)) { return 0; }
    if (_mv_callee_any(S, _mrc_fi) == 0) { return 0; }   # declared or counted (6.7.13); a counted `: i64` too (6.7.14)
    var ps = GFPSID(S, fi, argc);
