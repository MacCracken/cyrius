                    # f32v4 + integer vectors i8v16..u64v2) returns register-class
                    # (SysV pair / XMM0), NOT via retptr. Catch them ALL uniformly
                    # through the shared classifier so a new vector type can never
                    # silently default to the retptr-stash — the Phase-1 f32v4
                    # SIGSEGV class. (Scalars classify non-vector → _is_simd_any 0;
                    # structs classify to a +sid → 0. So this only fires for vectors,
                    # byte-identical for every existing return type.)
                    # v6.4.31: gate to _TARGET_PE == 0. On Win64 PE a SIMD vector
                    # returns via the retptr-stash (MS x64: >8B composite by hidden
                    # pointer in RCX), so it must fall through to _cur_fn_ret_stash=8
                    # like the per-type scans below (2820-2871) intend. Before this
                    # gate, the uniform catch-all set _rs_is_scalar=1 on PE too,
                    # forcing stash=0 → the callee returned in XMM0 while the caller
                    # allocated a retptr → PE value-form SIMD returns were broken
                    # since v6.4.6. See [[project_v6431_win64_valueform_simd]].
                    if (_TARGET_PE == 0) { if (_is_simd_any(S, _classify_return_type(S, _rs_rt_noff)) == 1) { _rs_is_scalar = 1; } }
                    # v6.4.55: scalar f64 ('f','6','4',0) returns in xmm0 on SysV AND
                    # Win64 (a single double is NOT a >8B composite → no retptr, so
                    # UNGATED unlike the f64v2/f64v4 SIMD catch above). stash=0.
                    if (_rs_b0 == 102) { if (_rs_b1 == 54) { if (_rs_b2 == 52) { if (_rs_b3 == 0) { _rs_is_scalar = 1; } } } }
                    if (_rs_b0 == 105) {
                        if (_rs_b1 == 56) {
                            if (_rs_b2 == 0) { _rs_is_scalar = 1; }
                        }
                        if (_rs_b1 == 49) {
                            if (_rs_b2 == 54) {
                                if (_rs_b3 == 0) { _rs_is_scalar = 1; }
                            }
                        }
                        if (_rs_b1 == 51) {
                            if (_rs_b2 == 50) {
                                if (_rs_b3 == 0) { _rs_is_scalar = 1; }
                            }
                        }
                        if (_rs_b1 == 54) {
                            if (_rs_b2 == 52) {
                                if (_rs_b3 == 0) { _rs_is_scalar = 1; }
                            }
                        }
                    }
                    # v5.10.23: Result / Option / Tagged / cstring
                    if (_rs_b0 == 82) {
                        if (_rs_b1 == 101) {
                            if (_rs_b2 == 115) {
                                if (_rs_b3 == 117) {
                                    if (load8(S + 0xEC00000 + _rs_rt_noff + 4) == 108) {
                                        if (load8(S + 0xEC00000 + _rs_rt_noff + 5) == 116) {
                                            if (load8(S + 0xEC00000 + _rs_rt_noff + 6) == 0) {
                                                _rs_is_scalar = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (_rs_b0 == 79) {
                        if (_rs_b1 == 112) {
                            if (_rs_b2 == 116) {
                                if (_rs_b3 == 105) {
                                    if (load8(S + 0xEC00000 + _rs_rt_noff + 4) == 111) {
                                        if (load8(S + 0xEC00000 + _rs_rt_noff + 5) == 110) {
                                            if (load8(S + 0xEC00000 + _rs_rt_noff + 6) == 0) {
                                                _rs_is_scalar = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (_rs_b0 == 84) {
                        if (_rs_b1 == 97) {
                            if (_rs_b2 == 103) {
                                if (_rs_b3 == 103) {
                                    if (load8(S + 0xEC00000 + _rs_rt_noff + 4) == 101) {
                                        if (load8(S + 0xEC00000 + _rs_rt_noff + 5) == 100) {
