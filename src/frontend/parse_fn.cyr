# The name token of a whole argument at the cursor that is one name, inside any parentheses that wrap all of
# it, ending at `,` / `)`; -1 for any other shape.
fn _sarg_wname(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti) == 10) {
