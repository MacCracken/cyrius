    # below is skipped (the body is the raw ISR). Reset at PARSE_FN_DEF end.
    if (_naked_pending == 1) {
        _cur_fn_naked = 1;
        _naked_pending = 0;
    }
    else { _cur_fn_naked = 0; }
    # v6.5.63: #inline — consume the pending flag into a LOCAL, not a global. A definition
    # emitted mid-body (a generic instance) re-enters this fn, and a global would let the inner
    # fn inherit or clear the outer one's request (the shape `_cur_fn_naked` needs an explicit
    # save/restore for).
    var _fn_inline_req = 0;
    if (_inline_pending == 1) {
        _fn_inline_req = 1;
        _inline_pending = 0;
    }
    # v6.5.71: `#derive(accessors)` asks for its generated getters/setters to be inlined
    # through a side channel rather than by emitting `#inline` — derive bodies are flattened
    # onto one line and `#` opens a comment, so the text route swallows the next `#derive`.
    if (_fn_inline_req == 0) {
