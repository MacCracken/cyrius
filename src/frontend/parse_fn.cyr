    # a refusal is printed (or was, by the sweep), which the run-time body's stand-down relies on
    # (`_ce_name_said`). 6.7.15: and none out — the caller's latch is put back, as `_ce_top_expr` does. The
    # check's own latch began the run-time body latched: its first statement's errors were swallowed and its
    # resync skipped the next statement when that opened with no keyword (`const k = 3;` unbound: a false
    # "undefined variable 'k'"). The body's repeat of the check's refusal stands down (`_ce_err_dup`, the
    # 6.7.14 stand-downs). CHANGELOG [6.7.15]
    var pw = _panic;
    _panic = 0;
    _ce_bn = 0 - 1;
    _ce_rti = 0 - 1;
    _ce_err = 0;
    _ce_fb = _ce_sp;
    _ce_infn = 1;
    _ce_skip = _ce_skip + 1;
    var np = _ce_nparams(S, op);
    var pi = 0;
    while (pi < np) { _ce_fr_push(S, 0 - 1, 0, 0, 8); pi = pi + 1; }
    var body = _ce_bind_params(S, op, _ce_fb, np, fi);
    if (body > 0) {
        _ce_ti = body;
        _ce_ret = 0;
        _ce_block(S);
    }
    _ce_skip = _ce_skip - 1;
    _ce_ret = 0;
    if (_ce_err == 1) { _ce_fn_rname = _ce_bn; _ce_fn_refd = 1; _ce_fn_rtok = _ce_rti; }   # 6.7.14 / 6.7.15: the body's
    _panic = pw;
    _ce_ti = sv_ti; _ce_fb = sv_fb; _ce_sp = sv_sp; _ce_infn = sv_in; _ce_err = sv_err;
    return 0;
}
# ⛔ 6.7.7 (B4, R5) — a const fn takes no TUPLE parameter: a compile-time evaluation binds each
# parameter to one value, and a tuple is several. It said "expected ';', got '.'" at the first `t.0`,
# and nothing at all for an unused one (callable at run time, a constant nowhere). Refused once, at the
# parameter's type, by name. 1 = refused. CHANGELOG [6.7.7]
fn _ce_tup_param(S, op): i64 {
    var i = op + 1;
    while (TOKTYP(S, i) == 2) {
        if (TOKTYP(S, i + 1) == 49) {
            if (TOKTYP(S, i + 2) == 10) {
                _tup_err(S, i + 2, "const fn parameter ", TOKVAL(S, i), " is a tuple, which a compile-time evaluation does not take - pass its elements as separate parameters");
                return 1;
            }
        }
        i = _pl_next(S, i);   # 6.7.11: the parser's walker, as `_ce_bind_params`
        if (TOKTYP(S, i) != 31) { return 0; }
        i = i + 1;
    }
    return 0;
}
# The number of parameters in the list whose `(` is token `op`, by `_pl_next` — the run-time
# arity. ⛔ 6.7.11: it counted depth-0 commas with `( )` depth only, so `p: Pair<i64, i64>` was two
# parameters in a const context: `pick(0, 7)` was refused and `pick(0, 1, 7)` bound a phantom
# parameter named `i64`, while the run-time call counted two. CHANGELOG [6.7.11]
fn _ce_nparams(S, op): i64 {
    var i = op + 1;
    var n = 0;
    while (TOKTYP(S, i) != 11) {
        if (TOKTYP(S, i) == 12) { return n; }
        n = n + 1;
        i = _pl_next(S, i);
        if (TOKTYP(S, i) == 31) { i = i + 1; }
    }
    return n;
}

# ── top-level consts ──────────────────────────────────────────────────────────────────────────────
# `_cst_tab` (8 words): name, initializer token, declaration token, var slot, state (0 new, 1
# being evaluated, 2 done, 3 refused), kind, value, float-literal index (an f64 const's, else -1).
# A refused annotation, `const K: T = e;`, is recorded too (its initializer after the `=`, the
# refusal reported once, by `_cst_record`): an unrecorded K made every read of it, above or below,
# a second error, "undefined variable 'K'". CHANGELOG [6.7.13]
fn _cst_prepass(S): i64 {
    var p = 0;
    var d = 0;
    while (TOKTYP(S, p) != 12) {
        var t = TOKTYP(S, p);
        if (d == 0) { if (t == 168) { if (TOKTYP(S, p + 1) == 2) { _cst_pre_at(S, p); } } }
        if (t == 13) { d = d + 1; }
        if (t == 14) { if (d > 0) { d = d - 1; } }
        p = p + 1;
    }
    return 0;
}
# `const NAME` at token p (depth 0): recorded when `=` follows the name, or a refused `: T` and then
# an `=`.
fn _cst_pre_at(S, p): i64 {
    if (TOKTYP(S, p + 2) == 4) { _cst_record(S, p, p + 3); return 0; }
    if (TOKTYP(S, p + 2) != 49) { return 0; }
    var q = _cst_ann_eq(S, p + 2);
    if (q > 0) { _cst_record(S, p, q + 1); }
    return 0;
}
# The `=` after a const's refused annotation (the `:` at token q): its token, or 0 when the
# statement has none (a `;`, `{`, `}` or EOF comes first) — then nothing is bound.
fn _cst_ann_eq(S, q): i64 {
    while (TOKTYP(S, q) != 12) {
        var t = TOKTYP(S, q);
        if (t == 4) { return q; }
        if (t == 5 || t == 13 || t == 14) { return 0; }
        q = q + 1;
    }
    return 0;
}
# "a const takes no type annotation" at the `:` (token q), once and in sync: the latch is left as
# it was, so the const is still bound and the statement after it reports its own errors.
fn _cst_ann_err(S, q): i64 {
    var sv = GTI(S);
    var p0 = _panic;
    STI(S, q);
    ERR_MSG(S, "a const takes no type annotation: its type is its value's", 57);
    STI(S, sv);
    if (p0 == 0) { _panic = 0; }
    return 0;
}
fn _cst_record(S, p, ini): i64 {
    if (_cst_tab == 0) { _cst_tab = alloc(16384 * 64); }
    if (_cst_n >= 16384) { _tr_cap(S, p, "too many top-level consts (max 16384)", 37); return 0; }
    var name = TOKVAL(S, p + 1);
    _RSV_INTRINSIC_DECL(S, name, p + 1, 0);
    var prior = _cst_find(S, name);
    if (prior >= 0) {
        _bnd_err_at(S, p + 1, "const ", name, " is declared twice", 0 - 1);
        return 0;
    }
    var e = _cst_tab + _cst_n * 64;
    S64(e, name);
    S64(e + 8, ini);
    S64(e + 16, p);
    if (TOKTYP(S, p + 2) == 49) { _cst_ann_err(S, p + 2); }
    var vcnt = GVCNT(S);
    S64(_varn_base + vcnt * 8, name);
    S64(_vars_base + vcnt * 8, 0);
    SVECP(S, vcnt, 2);
    SVDECL(S, vcnt, p + 1);   # 6.7.14: where it was declared (the native-region warning)
    _vcst_set(S, vcnt, _cst_n + 1);
    SVCNT(S, vcnt + 1);
    var ispub = 0;
    if (p > 0) { if (TOKTYP(S, p - 1) == 73) { ispub = 1; } }
    if (ispub == 0) {
        var fid = FM_FILEID(S, GTLINE(S, p));
        if (_PRIV_FILE(fid) == 1) { SVFI(S, vcnt, fid + 1); }
    }
    S64(e + 24, vcnt);
    S64(e + 32, 0);
    S64(e + 40, 0);
    S64(e + 48, 0);
    S64(e + 56, 0 - 1);
    _cst_n = _cst_n + 1;
    return 0;
}
fn _vcst_set(S, vi, v): i64 {
    if (_vcst == 0) { _vcst = alloc(1048576 * 4); }
    store32(_vcst + vi * 4, v);
    return 0;
}
# The `_cst_tab` index of var slot vi (a top-level const), or -1.
fn _vcst_ix(S, vi): i64 {
    if (_vcst == 0) { return 0 - 1; }
    if (vi < 0) { return 0 - 1; }
    return load32(_vcst + vi * 4) - 1;
}
fn _cst_find(S, name): i64 {
    var i = 0;
    while (i < _cst_n) {
        if (STREQ(S, L64(_cst_tab + i * 64), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# Evaluate const ci (once): its value; its kind in `_cst_kk`.
fn _cst_value(S, ci): i64 {
    var e = _cst_tab + ci * 64;
    var st = L64(e + 32);
    if (st == 1) {
        _ce_badn(S, "const ", L64(e), " is defined in terms of itself");
        S64(e + 32, 3);
        _cst_kk = 0;
        return 0;
    }
    if (st == 0) { _cst_eval(S, ci); }
    _cst_kk = L64(e + 40);
    return L64(e + 48);
}
fn _cst_kind_peek(S, ci): i64 {
    var e = _cst_tab + ci * 64;
    if (L64(e + 32) == 2) { return L64(e + 40); }
    return 4;   # 6.7.4: not evaluated yet — its kind is unknown (an if-expression re-checks it later)
}
# Evaluate the constant expression at token `ti` at the TOP context: no locals of whatever forced
# it, its own step budget (a sweep runs them back to back), every evaluator flag put back. Returns
# the value; `out` receives [0] its kind (0 i64, 1 f64, 2 string, 3 bool), [1] 1 when the evaluator
# refused it (already reported), [2] the token after it — the caller judges what may end it (a
# const's `;`; a parameter default's `,` / `)`). CHANGELOG [6.7.2] [6.7.7]
# 6.7.14 — and the cascade latch: it evaluates with `_panic` clear and puts the caller's value back.
# The tokens are a declaration's own, walked by `_ce_ti`, never the parser's cursor, so a refusal
# needs no resync; under the caller's latch every evaluation after the first refused one (the
# end-of-pass-1 sweep's next const, a default after a bad const) printed nothing. CHANGELOG [6.7.14]
fn _ce_top_expr(S, ti, out): i64 {
    var sv_ti = _ce_ti; var sv_top = _ce_top; var sv_in = _ce_infn; var sv_err = _ce_err;
    var sv_skip = _ce_skip; var sv_fb = _ce_fb; var sv_steps = _ce_steps; var sv_as = _ce_asrt;
    var sv_pn = _panic;
    _panic = 0;
    _ce_steps = 0;
    _ce_asrt = 0;
    _ce_ti = ti;
    _ce_top = 1;
    _ce_infn = 0;
    _ce_err = 0;
    _ce_skip = 0;
    var v = _ce_expr(S);
    store64(out, _ce_k);
    store64(out + 8, _ce_err);
    store64(out + 16, _ce_ti);
    _ce_ti = sv_ti; _ce_top = sv_top; _ce_infn = sv_in; _ce_err = sv_err; _ce_skip = sv_skip; _ce_fb = sv_fb;
    _ce_steps = sv_steps; _ce_asrt = sv_as;
    _panic = sv_pn;
    return v;
}
# 6.7.15 — the same, QUIET: a refusal sets `out`[1] and prints nothing, counts no error and latches nothing — the
# declaration zone's probe of a float global's initializer (parse_decl.cyr _gvk_fx), which the replay compiles as
# run-time code when the evaluator refuses it. Its tokens are pre-scanned (_gvk_fscan): only consts already
# evaluated are read, so no const's own evaluation runs under it. CHANGELOG [6.7.15]
var _ce_quiet = 0;
fn _ce_top_quiet(S, ti, out): i64 {
    var sq = _ce_quiet;
    _ce_quiet = 1;
    var v = _ce_top_expr(S, ti, out);
    _ce_quiet = sq;
    return v;
}
# Run const ci's initializer at the TOP context (no locals of whatever fn forced it).
fn _cst_eval(S, ci): i64 {
    var e = _cst_tab + ci * 64;
    S64(e + 32, 1);
    var o: i64[3];
    var v = _ce_top_expr(S, L64(e + 8), &o);
    var k = load64(&o);
    var bad = load64(&o + 8);
    if (bad == 0) {
        if (TOKTYP(S, load64(&o + 16)) != 5) {
            _cst_semi_refuse(S, load64(&o + 16));
            bad = 1;
        }
    }
    var vi = L64(e + 24);
    if (bad == 1) {
        S64(e + 32, 3); S64(e + 40, 0); S64(e + 48, 0);
        SVECP(S, vi, 1); S64(_vecv_base + vi * 8, 0);
        return 0;
    }
    S64(e + 32, 2);
    S64(e + 40, k);
    S64(e + 48, v);
    if (k == 0 || k == 3) { S64(_vecv_base + vi * 8, v); SVECP(S, vi, 1); }   # 6.7.3: a bool folds as an int
    else {
        SVECP(S, vi, 0);
        if (k == 1) { S64(e + 56, FLIT_ADD(v)); }
    }
    return 0;
}
# A const's value that does not end at its `;`: refused under `_ce_top_expr`'s latch rule (its own
# tokens, no resync), so the next const's error still prints. CHANGELOG [6.7.14]
fn _cst_semi_refuse(S, ti): i64 {
    var pw = _panic;
    _panic = 0;
    _bnd_errm_at(S, ti, "expected ';' after a const's value", 34);
    _panic = pw;
    return 0;
}
# GVECP's pending arm: var slot vi is a top-level const not yet evaluated.
fn _cst_force(S, vi): i64 {
    var ci = _vcst_ix(S, vi);
    if (ci < 0) { SVECP(S, vi, 0); return 0; }
    _cst_value(S, ci);
    return 0;
}
# Every top-level const, evaluated at the end of pass 1 — an unused one is checked too.
fn _cst_sweep(S): i64 {
    var i = 0;
    while (i < _cst_n) {
        if (L64(_cst_tab + i * 64 + 32) == 0) { _cst_value(S, i); }
        i = i + 1;
    }
    _ce_xpend_check(S);   # 6.7.4: every const is known now
    return 0;
}
# The const kind of global var slot vi: 0 = not a const, 1 = int, 2 = f64, 3 = string, 4 = bool.
fn _cst_vkind(S, vi): i64 {
    var ci = _vcst_ix(S, vi);
    if (ci < 0) { return 0; }
    _cst_value(S, ci);
    return L64(_cst_tab + ci * 64 + 40) + 1;
}

# ── local consts ──────────────────────────────────────────────────────────────────────────────────
# `_lc_tab` (6 words): name, scope depth, inline depth, kind, value, float-literal index.
fn _lc_find(S, name): i64 {
    var i = _lc_n - 1;
    while (i >= _lc_floor) {
        var e = _lc_tab + i * 48;
        if (L64(e + 16) == GIDEP(S)) { if (STREQ(S, L64(e), name) == 1) {
                # a var of the same name declared at least as deeply hides it
                if (GINFN(S) == 1) {
                    var li = FINDLOCAL(S, name);
                    if (li >= 0) { if (GLDEP(S, li) >= L64(e + 8)) { return 0 - 1; } }
                }
                return i;
            } }
        i = i - 1;
    }
    return 0 - 1;
}
fn _lc_pop(S, dep): i64 {
    while (_lc_n > _lc_floor) {
        if (L64(_lc_tab + (_lc_n - 1) * 48 + 8) < dep) { return 0; }
        _lc_n = _lc_n - 1;
    }
    return 0;
}
# 6.7.14 — the end of an `#inline` / generic body replay (PARSE_FNCALL), whose body ran one scope
# deeper than the call (`dep` + 1) with no SCOPE_POP: its local consts end with it, as a block's do,
# and the caller's depth is back. They outlived the replay, so a second call in the same scope met
# the first one's `L` at the same (scope, inline) depth: "'L' is already declared in this scope".
# A helper so PARSE_FNCALL (a cybs-ceiling fn) keeps its reference count. CHANGELOG [6.7.14]
fn _inl_scope_end(S, dep): i64 {
    _lc_pop(S, dep + 1);
    SSDEP(S, dep);
    return 0;
}
# ── the parser's side ─────────────────────────────────────────────────────────────────────────────
fn GFCFN(S, fi): i64 { if (_fnt_cfn == 0) { return 0; } if (fi < 0) { return 0; } return load8(_fnt_cfn + fi); }
fn SFCFN(S, fi, v): i64 { if (_fnt_cfn == 0) { _fnt_cfn = alloc(131072); } store8(_fnt_cfn + fi, v); return 0; }
# Cursor on an expression in a const context (an array size, `#assert`, a case label, an enum
# value, a local const): its value, its kind in `_ce_k`, `_ce_err` = 1 when it was refused
# (reported). The cursor is left after it.
fn _ce_eval_here(S): i64 {
    var sv_ti = _ce_ti; var sv_top = _ce_top; var sv_in = _ce_infn; var sv_skip = _ce_skip; var sv_fb = _ce_fb;
    _ce_ti = GTI(S);
    _ce_top = 0;
    _ce_infn = 0;
    _ce_err = 0;
    _ce_skip = 0;
    _ce_steps = 0;
    var v = _ce_expr(S);
    var k = _ce_k;
    if (k == 4) { k = 0; }   # 6.7.4: an unknown kind lives only inside skip mode
    STI(S, _ce_ti);
    _ce_ti = sv_ti; _ce_top = sv_top; _ce_infn = sv_in; _ce_skip = sv_skip; _ce_fb = sv_fb;
    _ce_k = k;
    return v;
}
# The same, for a place that takes an INTEGER (`what` names it in the refusal).
fn _ce_eval_int(S, what): i64 {
    var ti = GTI(S);
    var v = _ce_eval_here(S);
    if (_ce_err == 0) { if (_ce_k != 0 && _ce_k != 3) {   # 6.7.3: a bool is the integer 0 / 1
            _ce_err = 1;
            var sv = GTI(S);
            STI(S, ti);
            ERR_MSG(S, what, _cstr_len(what));
            STI(S, sv);
            return 0;
        } }
    return v;
}
fn _cstr_len(p): i64 {
    var n = 0;
    while (load8(p + n) != 0) { n = n + 1; }
    return n;
}
# Emit const value (kind k, value v, float-literal index fx) exactly as its literal would be.
fn _cst_emit_val(S, k, v, fx): i64 {
    _cfo = 0;
    if (k == 1) { EMIT_FLOAT_LIT(S, fx); SESTYPE(S, F64_TYID); return 0; }
    if (k == 2) { ESADDR(S, v >> 32); return 0; }
    _cfp = GCP(S);
    EMOVI(S, v);
    if (v >= 0) { if (v < 0x10000) { _cfv = v; _cfo = 1; } }
    if (k == 3) { _BX_MARK(S); }   # 6.7.3: a bool const's read is a boolean value
    return 0;
}
# The factor's reads. A local const (1 = emitted), then a top-level f64 / string const (an integer
# one is an enum-constant fold, GVECP 1, on the global path).
fn _cst_read_local(S, noff): i64 {
    if (_lc_n == 0) { return 0; }
    var lc = _lc_find(S, noff);
    if (lc < 0) { return 0; }
    var e = _lc_tab + lc * 48;
    _cst_emit_val(S, L64(e + 24), L64(e + 32), L64(e + 40));
    return 1;
}
fn _cst_read_global(S, vi): i64 {
    if (_cst_n == 0) { return 0; }
    var k = _cst_vkind(S, vi);
    if (k < 2) { return 0; }
    var ci = _vcst_ix(S, vi);
    var e = _cst_tab + ci * 64;
    _cst_emit_val(S, L64(e + 40), L64(e + 48), L64(e + 56));
    return 1;
}
# 1 iff `noff` here names a const (a local one, or a top-level one no local var hides).
fn _cst_named(S, noff): i64 {
    if (_lc_n > 0) { if (_lc_find(S, noff) >= 0) { return 1; } }
    if (_cst_n == 0) { return 0; }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    if (_vcst_ix(S, _findvar_core(S, noff)) >= 0) { return 1; }
    return 0;
}
# ⛔ 6.7.14 — `.field` on a const in run-time code (the cursor past `.field`, token `dti` its `.`): a field
# store (`st` 1) or read (0) of a top-level or local const, refused by name at the `.`, once. A top-level
# const's size-0 slot has no struct ("no struct type in scope for 'C'; ... (missing include?)"), and a local
# const has no slot at all ("undefined variable 'L'" AND the no-struct error). Asked only where the base
# resolved to nothing a field can reach (PARSE_FIELD_STORE / _LOAD's undefined and `sid == 0` arms), so
# nothing that compiles changes. A read is refused IN SYNC — its expression and statement parse on to their
# end — so the latch is that statement's alone (`_pair_sync_ti`, `_stmt_resync`): the statement after
# `var v = C.x;` was skipped, and a `const L` declared there read as "undefined variable 'L'". 1 = refused
# (or stood down in a refused const fn's body). CHANGELOG [6.7.14]
# 6.7.15 — `st` 2: a method call `C.m(..)` / `L.m(..)` (the cursor on its `(`), "const 'C' has no methods":
# a top-level const said "no struct type in scope for 'C'; a method call needs its struct declaration
# (missing include?)", a local const "undefined variable 'L'". Not in sync (the arguments are not parsed):
# the statement resyncs, as the method arm's own refusal does. CHANGELOG [6.7.15]
fn _cst_fld_at(S, noff, st, dti): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_cst_named(S, noff) == 0) { return 0; }
    if (_ce_fld_said(S) == 1) { return 1; }
    if (st == 0) { if (_panic == 0) { _pair_sync_ti = GTI(S); } }
    var sv = GTI(S);
    STI(S, dti);
    if (st == 1) { ERR_IDENT(S, "cannot assign to a field of const ", noff, " - a const has no storage", 0 - 1); }
    elif (st == 2) { ERR_IDENT(S, "const ", noff, " has no methods - a const has no storage", 0 - 1); }
    else { ERR_IDENT(S, "const ", noff, " has no fields - a const has no storage", 0 - 1); }
    STI(S, sv);
    return 1;
}
# A const on the left of `=` / `OP=`, or under `&`: refused by name (it has no storage).
fn _cst_lvalue_check(S, noff, what): i64 {
    if (_cst_named(S, noff) == 0) { return 0; }
    if (_ce_name_said(S, noff) == 1) { _panic = 1; return 1; }   # 6.7.15: a refused const fn's check named it
    ERR_IDENT(S, what, noff, " - a const has no storage (declare it `var` to change it)", 0 - 1);
    return 1;
}
# 6.7.3: an enum constant is not an lvalue either — `A = ..`, `A OP= ..`, `&A` and the qualified
# `E.A` spellings are refused by name, as for a const. Every read of `A` folds to the declared
# value, so a write landed only in the variant's 8-byte slot and `&A` handed that dead copy out.
# `vi` is the slot the name RESOLVED to (GVENUMID is set only by enum registration), so a local,
# a closure capture and a later top-level `var A` (last definition wins) stay variables.
# CHANGELOG [6.7.3]
fn _enum_lv_refuse(S, vi, noff, what): i64 {
    if (vi < 0) { return 0; }
    if (GVENUMID(S, vi) == 0) { return 0; }
    ERR_IDENT(S, what, noff, " - an enum constant is a fixed value, not a variable (declare a `var` to change it)", 0 - 1);
    return 1;
}
# The left of `=` / `OP=` (a statement or a classic-for step): a const, then an enum constant.
# The global lookup goes first — one hash probe — so a local's assignment never pays a second
# FINDLOCAL scan; the local only matters when the name resolves to an enum constant.
fn _asg_lvalue_refused(S, noff): i64 {
    if (_cst_n > 0 || _lc_n > 0) { if (_cst_lvalue_check(S, noff, "cannot assign to const ") == 1) { return 1; } }
    var vi = _findvar_core(S, noff);   # not FINDVAR: the store's own lookup reports `private`
    if (vi < 0) { return 0; }
    if (GVENUMID(S, vi) == 0) { return 0; }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    return _enum_lv_refuse(S, vi, noff, "cannot assign to enum constant ");
}
# ⛔ 6.7.14 — the lvalue refusal where an assignment FOLLOWS the name (`=` or an `op =` pair, nothing
# consumed). A statement or a classic-for step naming a const or an enum constant without one — `N;`,
# `N + 1;`, `N == 5;`, `GREEN;`, a step `N` — was refused "cannot assign to const 'N'" though nothing was
# assigned; it is the syntax error a variable gets there, "expected '=', got ';'", reported here so the
# caller steps the statement over as after the refusal (a local const `L;` parsed on and added
# "undefined variable 'L'"). 1 = refused. CHANGELOG [6.7.14]
fn _asg_lvalue_at(S, noff): i64 {
    if (_slit_stmt(S, noff) == 1) { return 1; }   # 6.7.14 (D12 (a)): a statement `P { .. };`
    if (_asg_pair_at(S) == 1) {
        if (_asg_lvalue_refused(S, noff) == 1) { return 1; }
        return _asg_cap_first(S, noff, GTI(S) - 1);   # 6.7.14: a captured name, at the name (parse.cyr)
    }
    if (_asg_lvalue_is(S, noff) == 0) { return 0; }
    ERR_EXPECT(S, 4);
    return 1;
}
# 1 = `noff` here is what `_asg_lvalue_refused` refuses (a const, or an enum constant no local hides),
# nothing printed. Its lookups, in its order.
fn _asg_lvalue_is(S, noff): i64 {
    if (_cst_n > 0 || _lc_n > 0) { if (_cst_named(S, noff) == 1) { return 1; } }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    if (GVENUMID(S, vi) == 0) { return 0; }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    return 1;
}
# `&name` (cursor past the name): the address-of ladder's own order — local, closure capture,
# global — then the qualified `&E.A` when no global of that name exists.
fn _addr_lvalue_refused(S, noff): i64 {
    if (_cst_n > 0 || _lc_n > 0) { if (_cst_lvalue_check(S, noff, "cannot take the address of const ") == 1) { return 1; } }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) {
            var esl = _cl_snap_find(S, noff);
            if (esl >= 0) { if (_cl_cap_find(esl) >= 0) { return 0; } }
        } }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return _enum_qual_lv_refuse(S, noff, "cannot take the address of enum constant "); }
    return _enum_lv_refuse(S, vi, noff, "cannot take the address of enum constant ");
}
# `&E.A` (cursor on the `.`, `bnoff` = E, which names no variable): refused as `&A` is when E is
# an enum declaring A, the cursor stepped past `A`. 0 otherwise, the cursor kept.
fn _enum_qual_lv_refuse(S, bnoff, what): i64 {
    if (PEEKT(S) != 41) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
    var vn = TOKVAL(S, GTI(S) + 1);
    var vi = _enum_variant_in(S, bnoff, vn);
    if (vi < 0) { return 0; }
    STI(S, GTI(S) + 2);
    return _enum_lv_refuse(S, vi, vn, what);
}
# PARSE_FIELD_STORE, base `bnoff` naming no variable, `.vn` consumed: `E.A = ..` / `E.A OP= ..` on
# a variant of an enum named E is refused as `A = ..` is, and the statement stepped over. 6.7.14: with no
# assignment after it (`E.A;`, `E.A + 1;`) it is the syntax error `A;` is, "expected '='" (it said
# "cannot assign to enum constant 'A'").
fn _enum_qual_store_refused(S, bnoff, vn): i64 {
    var vi = _enum_variant_in(S, bnoff, vn);
    if (vi < 0) { return 0; }
    if (_asg_pair_at(S) == 1) { _enum_lv_refuse(S, vi, vn, "cannot assign to enum constant "); }
    else { ERR_EXPECT(S, 4); }
    _cst_skip_sync(S);   # the rest of the statement, to its `;` (6.7.14: in sync)
    return 1;
}
# 6.7.14 — a refusal at a statement's first name with the rest stepped over to its `;`: the statement ends in
# sync, so the latch is cleared there (`_pair_sync_ti`, `_stmt_resync`) instead of resyncing over the NEXT
# statement — `N = 1; GREEN = 2;` reported only `N`, every other refused statement in a row lost. A classic-for
# step's overshoot is PARSE_FOR's to undo; the `for` statement then ends at its body's `}`. CHANGELOG [6.7.14]
fn _cst_skip_sync(S): i64 {
    _cst_skip_decl(S);
    _pair_sync_ti = GTI(S) - 1;
    return 0;
}
# Cursor on a top-level `const NAME = ...;` the pre-scan recorded: step over it (no code).
fn _cst_skip_decl(S): i64 {
    _pub_pending = 0;
    var d = 0;
    while (PEEKT(S) != 12) {
        var t = PEEKT(S);
        if (t == 10 || t == 13 || t == 28) { d = d + 1; }
        if (t == 11 || t == 14 || t == 29) { d = d - 1; }
        if (t == 5) { if (d <= 0) { STI(S, GTI(S) + 1); return 0; } }
        STI(S, GTI(S) + 1);
    }
    return 0;
}
fn _cst_is_top(S, ti): i64 {
    var i = 0;
    while (i < _cst_n) {
        if (L64(_cst_tab + i * 64 + 16) == ti) { return 1; }
        i = i + 1;
    }
    return 0;
}
# PARSE_STMT on `const`: a recorded top-level declaration is stepped over; anything else is a
# LOCAL const — evaluated here, entered in the scoped table, no code and no frame slot.
fn _cst_stmt(S): i64 {
    var ti = GTI(S);
    if (_cst_is_top(S, ti) == 1) { _cst_skip_decl(S); return 0; }
    STI(S, ti + 1);
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); return 0; }
    var name = PEEKV(S);
    _RSV_INTRINSIC_DECL(S, name, GTI(S), 0);
    STI(S, GTI(S) + 1);
    if (PEEKT(S) == 49) {   # refused, then bound as `const NAME = e;` (6.7.13: no cascade at its reads)
        var q = _cst_ann_eq(S, GTI(S));
        if (q == 0) { ERR_MSG(S, "a const takes no type annotation: its type is its value's", 57); return 0; }
        _cst_ann_err(S, GTI(S));
        STI(S, q);
    }
    if (PEEKT(S) != 4) { ERR_EXPECT(S, 4); return 0; }
    STI(S, GTI(S) + 1);
    _lc_dup_check(S, name, ti + 1);
    var v = _ce_eval_here(S);
    var k = _ce_k;
    if (_ce_err == 1) { v = 0; k = 0; }
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    else { STI(S, GTI(S) + 1); }
    _lc_push(S, name, k, v, ti + 1);
    return 0;
}
# `nti` is the name token: its offset is where the const was DECLARED (`_lc_decl`) — an `#inline`
# replay re-parses the body's own tokens, so it stays the declaration's, never the call site's. The
# aarch64 native-region warning judges a local const by it. CHANGELOG [6.7.15]
fn _lc_push(S, name, k, v, nti): i64 {
    if (_lc_tab == 0) { _lc_tab = alloc(65536 * 48); _lc_decl = alloc(65536 * 4); }
    if (_lc_n >= 65536) { ERR_MSG(S, "too many local consts (max 65536)", 33); return 0; }
    store32(_lc_decl + _lc_n * 4, GTOFF(S, nti) + 1);
    var e = _lc_tab + _lc_n * 48;
    S64(e, name);
    S64(e + 8, GSDEP(S));
    S64(e + 16, GIDEP(S));
    S64(e + 24, k);
    S64(e + 32, v);
    var fx = 0 - 1;
    if (k == 1) { fx = FLIT_ADD(v); }
    S64(e + 40, fx);
    _lc_n = _lc_n + 1;
    return 0;
}
# A local const named like a var or const already declared in THIS scope.
fn _lc_dup_check(S, name, ti): i64 {
    var dup = 0;
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, name);
        if (li >= 0) { if (GLDEP(S, li) == GSDEP(S)) { dup = 1; } }
    }
    var i = _lc_n - 1;
    while (i >= _lc_floor) {
        var e = _lc_tab + i * 48;
        if (L64(e + 8) == GSDEP(S)) { if (L64(e + 16) == GIDEP(S)) { if (STREQ(S, L64(e), name) == 1) { dup = 1; } } }
        i = i - 1;
    }
    if (dup == 1) { _bnd_err_at(S, ti, "", name, " is already declared in this scope", 0 - 1); }
    return 0;
}
# PARSE_VAR's side: a `var` named like a local const of the same scope.
fn _lc_var_dup(S, name): i64 {
    if (_lc_n == 0) { return 0; }
    var i = _lc_n - 1;
    while (i >= _lc_floor) {
        var e = _lc_tab + i * 48;
        if (L64(e + 8) == GSDEP(S)) { if (L64(e + 16) == GIDEP(S)) { if (STREQ(S, L64(e), name) == 1) {
                    ERR_IDENT(S, "", name, " is already declared in this scope (a const)", 0 - 1);
                    return 1;
                } } }
        i = i - 1;
    }
    return 0;
}

# ── const contexts the parser reads twice: a `case` label (the switch's pre-scan, then its body
# paths) and an enum value (pass 1, then pass 2) — evaluated ONCE, replayed by token index, so a
# refusal is reported once. `_clm` (3 words): label token, value, the token after it (its `:` /
# terminator). A switch trims what it added when it ends (nested switches stack).
fn _clm_find(ti): i64 {
    var i = _clm_n - 1;
    while (i >= 0) {
        if (load64(_clm + i * 24) == ti) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}
fn _clm_add(ti, v, end): i64 {
    if (_clm == 0) { _clm = alloc(65536 * 24); }
    if (_clm_n >= 65536) { return 0; }
    var e = _clm + _clm_n * 24;
    store64(e, ti); store64(e + 8, v); store64(e + 16, end);
    _clm_n = _clm_n + 1;
    return 0;
}
# A label / value at the cursor: a plain number (followed by `stop`) as before, else an integer
# const expression. The cursor is left after it. `_case_ok` = 0 when it was refused.
fn _cst_ctx_val(S, stop, what): i64 {
    var ti = GTI(S);
    _case_ok = 1;
    if (PEEKT(S) == 1) { if (TOKTYP(S, ti + 1) == stop) { STI(S, ti + 1); return TOKVAL(S, ti); } }
    var m = _clm_find(ti);
    if (m >= 0) {
        var e = _clm + m * 24;
        STI(S, load64(e + 16));
        if (load64(e + 16) < 0) { _case_ok = 0; }
        return load64(e + 8);
    }
    var pw = _ce_ctx_open(stop);   # 6.7.15: an enum value's
    var v = _ce_eval_int(S, what);
    if (_ce_err == 1) { _case_ok = 0; }
    _cst_ctx_skip(S, stop, ti, pw);
    var end = GTI(S);
    _clm_add(ti, v, end);
    return v;
}
# An enum value the evaluator refused leaves the cursor where it stopped: on a call's NAME, the
# member loop read `h()` as a new member with a constructor, which then failed the link
# ("undefined function 'h'", "refusing to emit binary"). Past the whole expression instead, by
# the evaluator's own grammar — when that ends where a member does (`,` `;` `}`); a malformed one
# (`(1 + }`) stays where it stopped. A case label resyncs at its `:` already. CHANGELOG [6.7.11]
# 6.7.15: through `_ce_ctx_close`, which also puts the caller's latch back when the value ends in sync.
fn _cst_ctx_skip(S, stop, ti, pw): i64 {
    if (stop >= 0) { return 0; }
    _ce_ctx_close(S, ti, pw, 31, 5, 14);
    return 0;
}
# ⛔ 6.7.15 — A CONST CONTEXT EVALUATED IN PLACE IN PASS 1 (an enum value, a global array size) HOLDS NO LATCH
# WHEN ITS REFUSAL ENDS IN SYNC. It is evaluated with `_panic` clear (`_ce_ctx_open`), as `_ce_top_expr` has been
# since 6.7.14; a refusal whose expression ends where its context does — by the evaluator's grammar
# (`_ce_extent`), else where the evaluator stopped (`[(1 + ]`), at one of `a` / `b` / `c` (an enum member's `,` /
# `;` / `}`, an array size's `]`) — leaves the cursor there and puts the caller's latch back (`_ce_ctx_close`), so
# the next declaration reports its own error; one that ends elsewhere (`[yy zz]`) keeps the latch. Pass 1 never
# resyncs: two refused enum values or global array sizes printed only the first (`#assert`: `_assert_open`,
# parse.cyr). CHANGELOG [6.7.15]
fn _ce_ctx_open(stop): i64 {
    var pw = _panic;
    if (stop < 0) { _panic = 0; }   # a case label (`stop` the `:`) keeps its statement's latch
    return pw;
}
fn _ce_ctx_close(S, ti, pw, a, b, c): i64 {
    if (_panic == 0) { _panic = pw; return 1; }
    var x = _ce_extent(S, ti);
    if (_ce_ctx_end(TOKTYP(S, x), a, b, c) == 0) { x = GTI(S); }   # an unclosed `(`: where the evaluator stopped
    if (_ce_ctx_end(TOKTYP(S, x), a, b, c) == 0) { return 0; }
    STI(S, x);
    _panic = pw;
    return 1;
}
fn _ce_ctx_end(t, a, b, c): i64 {
    if (t == a || t == b || t == c) { return 1; }
    return 0;
}
fn _case_val(S): i64 { return _cst_ctx_val(S, 49, "a case label must be an integer"); }
fn _enum_val(S): i64 {
    var ti = GTI(S);
    if (PEEKT(S) == 7) { if (TOKTYP(S, ti + 1) == 1) {   # `-N`, as before
            var nt = TOKTYP(S, ti + 2);
            if (nt == 5 || nt == 31 || nt == 14) { STI(S, ti + 2); return 0 - TOKVAL(S, ti + 1); }
        } }
    if (PEEKT(S) == 1) {
        var nt2 = TOKTYP(S, ti + 1);
        if (nt2 == 5 || nt2 == 31 || nt2 == 14) { STI(S, ti + 1); return TOKVAL(S, ti); }
    }
    return _cst_ctx_val(S, 0 - 1, "an enum value must be an integer");
}
# An argument scan's question (`_try_push_str_literal_arg` and its pre-scan): is token ti a
# STRING const — a whole argument, named here? It is then that string's literal.
fn _cst_str_tok(S, ti): i64 {
    if (_cst_n == 0) { if (_lc_n == 0) { return 0; } }
    if (TOKTYP(S, ti) != 2) { return 0; }
    var nt = TOKTYP(S, ti + 1);
    if (nt != 31) { if (nt != 11) { return 0; } }
    var noff = TOKVAL(S, ti);
    if (_lc_n > 0) {
        var lc = _lc_find(S, noff);
        if (lc >= 0) { if (L64(_lc_tab + lc * 48 + 24) == 2) { return 1; } return 0; }
    }
    if (GINFN(S) == 1) { if (FINDLOCAL(S, noff) >= 0) { return 0; } }
    if (_cst_vkind(S, _findvar_core(S, noff)) == 3) { return 1; }
    return 0;
}
# ⛔ 6.7.4 — PASS 1'S EXTENT OF A CONST EXPRESSION, by the evaluator's own grammar (pass 2 evaluates
# it): operand (binop operand)*, an operand being unary `-` `~` `!` before a literal, a balanced `(..)`,
# an if-expression chain (6.7.4: `if (..) {..}` `elif (..) {..}` `else {..}`), `IDENT[.IDENT][(..)]`, or a
# builtin with its `(..)`. Newlines mean nothing, as to the evaluator. The line-break heuristic it
# replaces stopped at the first operand ending a line, so `#assert 1<LF> == 1, "m";` (6.7.2) and any
# multi-line if-expression in a top-level #assert left pass 1 mid-expression — the next declaration
# was read as part of it ("undefined variable 'P'"). CHANGELOG [6.7.4]
fn _ce_extent(S, ti): i64 {
    ti = _cex_operand(S, ti);
    while (_cex_binop(TOKTYP(S, ti)) == 1) { ti = _cex_operand(S, ti + 1); }
    return ti;
}
fn _cex_binop(t): i64 {
    if (t >= 6) { if (t <= 9) { return 1; } }
    if (t >= 17) { if (t <= 22) { return 1; } }
    if (t >= 113) { if (t <= 121) { return 1; } }
    if (t == 27 || t == 34 || t == 35 || t == 36 || t == 38) { return 1; }
    if (t == 39 || t == 152 || t == 53 || t == 54) { return 1; }
    return 0;
}
fn _cex_operand(S, ti): i64 {
    var t = TOKTYP(S, ti);
    while (t == 7 || t == 37 || t == 171 || t == 27) { ti = ti + 1; t = TOKTYP(S, ti); }
    if (t == 12) { return ti; }
    if (t == 10) { return _cex_group(S, ti); }
    if (t == 15) { return _cex_ifx(S, ti); }
    if (t == 2) {
        ti = ti + 1;
        while (TOKTYP(S, ti) == 41) { if (TOKTYP(S, ti + 1) == 2) { ti = ti + 2; } else { return ti; } }
        if (TOKTYP(S, ti) == 10) { return _cex_group(S, ti); }
        return ti;
    }
    if (TOKTYP(S, ti + 1) == 10) { if (t != 1) { if (t != 61) { if (t != 30) { return _cex_group(S, ti + 1); } } } }
    return ti + 1;
}
# A balanced group from its `(` / `{` at `ti` (both kinds counted): the token after its close.
fn _cex_group(S, ti): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (ti < n) {
        var t = TOKTYP(S, ti);
        if (t == 10 || t == 13) { d = d + 1; }
        if (t == 11 || t == 14) { d = d - 1; if (d == 0) { return ti + 1; } }
        if (t == 12) { return ti; }
        ti = ti + 1;
    }
    return ti;
}
# `if (..) {..} [elif (..) {..}]* [else {..}]` from the `if` at `ti`: the token after it.
fn _cex_ifx(S, ti): i64 {
    ti = _cex_group(S, ti + 1);
    ti = _cex_group(S, ti);
    while (TOKTYP(S, ti) == 50) {
        ti = _cex_group(S, ti + 1);
        ti = _cex_group(S, ti);
    }
    if (TOKTYP(S, ti) == 23) { ti = _cex_group(S, ti + 1); }
    return ti;
}

# ── SOFTWARE BINARY64 ARITHMETIC — f64 constants computed at compile time (6.7.2) ───────────────
# WHY. A `const fn` evaluated by the compiler must give the bits the same operation gives at
# run time, on x86-64 (SSE2) and on AArch64 alike. The compiler cannot borrow the host's FPU
# for that: cybs (the seed's hand-assembly compiler, bootstrap/cybs.cyr) compiles no f64
# builtin and no float literal, so everything here is integers, and plain enough for cybs —
# no `>>>`, no unary minus, at most six parameters and six arguments, small fns (cybs fails
# SILENTLY past its per-fn limits).
#
# Values are i64 holding binary64 bits. Round to nearest, ties to even; gradual underflow
# (subnormal inputs and outputs, never flushed); overflow to infinity; IEEE signed zeros.
# NaN REFUSAL: a NaN's bit pattern is not the same on x86 and ARM (x86 makes the negative
# default NaN, ARM the positive one, and they propagate payloads differently), so no NaN is
# ever produced. A NaN operand, or an operation whose result would be one (inf - inf,
# 0 * inf, 0 / 0, inf / inf, a NaN or out-of-range conversion, a NaN compare), sets
# `_sf_err` to 1 and returns 0, for the caller to refuse the constant. `_sf_err` is never
# cleared here. `_sf_neg` / `_sf_abs` are pure sign-bit operations and never refuse.
#
# Internal form: (-1)^s * m * 2^(e - 1084), m in [2^62, 2^63) once normalized — the 53 kept
# bits are 62..10, bits 9..0 are the rounding bits, bit 0 also carries the sticky bit.
# High 64 bits of the last _sf_mul128 product.
var _sf_hi = 0;
# Exponent that goes with the last _sf_unpack significand.
var _sf_ue = 0;

# Set the refusal flag; 0 is returned in place of the value.
fn _sf_fail(): i64 {
    _sf_err = 1;
    return 0;
}

# 1 when x is a NaN (exponent all ones, fraction nonzero), either sign.
fn _sf_isnan(x): i64 {
    if ((x & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { return 1; }
    return 0;
}

# The exponent field of finite x, 1 for a subnormal: value = _sf_sg(x) * 2^(_sf_ex(x) - 1075).
fn _sf_ex(x): i64 {
    var e = (x >> 52) & 0x7FF;
    if (e == 0) { return 1; }
    return e;
}

# The 53-bit significand of finite x: the fraction, plus the implicit bit when x is normal.
fn _sf_sg(x): i64 {
    var m = x & 0xFFFFFFFFFFFFF;
    if (((x >> 52) & 0x7FF) != 0) { m = m | 0x10000000000000; }
    return m;
}

# The significand of finite nonzero x scaled up into [2^52, 2^53); _sf_ue gets the exponent
# that goes with it (below 1 for a subnormal): value = result * 2^(_sf_ue - 1075).
fn _sf_unpack(x): i64 {
    var m = _sf_sg(x);
    var e = _sf_ex(x);
    while (m < 0x10000000000000) {
        m = m << 1;
        e = e - 1;
    }
    _sf_ue = e;
    return m;
}

# m >> d, every bit shifted out ORed into bit 0 (the sticky bit); m >= 0, d >= 0. A count past
# 62 is decided here: the hardware masks shift counts to 6 bits.
fn _sf_jam(m, d): i64 {
    if (d == 0) { return m; }
    if (d > 62) {
        if (m != 0) { return 1; }
        return 0;
    }
    var r = m >> d;
    if ((m & ((1 << d) - 1)) != 0) { r = r | 1; }
    return r;
}

# Bits of (-1)^s * m * 2^(e - 1084), m in [2^62, 2^63): nearest, ties to even, on bits 9..0.
# e is the biased exponent MINUS ONE, so the leading bit adds the last 1 to the exponent
# field; the same addition carries a significand that rounds up to 2^53 into the next
# exponent, a subnormal that rounds up to 2^52 into the least normal, and the largest finite
# into infinity. e < 0 is below the normal range: shifted (sticky) to e = 0, a subnormal.
fn _sf_round(s, e, m): i64 {
    var sb = s << 63;
    if (e > 0x7FD) { return sb | 0x7FF0000000000000; }
    var x = m;
    var ee = e;
    if (ee < 0) {
        x = _sf_jam(x, 0 - ee);
        ee = 0;
    }
    # m + 0x200 may pass 2^63; `>>` is logical, so the carry is kept.
    var r = (x + 0x200) >> 10;
    if ((x & 0x3FF) == 0x200) { r = r - (r & 1); }
    var bits = (ee << 52) + r;
    if (bits >= 0x7FF0000000000000) { bits = 0x7FF0000000000000; }
    return sb | bits;
}

# _sf_round of a positive m below 2^63, its leading bit first shifted up to bit 62 (exact).
fn _sf_norm(s, e, m): i64 {
    if (m <= 0) { return s << 63; }
    var x = m;
    var ee = e;
    while (x < 0x40000000) {
        x = x << 32;
        ee = ee - 32;
    }
    while (x < 0x4000000000000000) {
        x = x << 1;
        ee = ee - 1;
    }
    return _sf_round(s, ee, x);
}

# a + b for finite nonzero a, b with |a| >= |b|. Both significands get 9 spare bits; the
# smaller is aligned with a sticky shift. One rounding of that is exact for a sum (the sticky
# bit sits below every rounding bit) and for a difference: a gap of 0 or 1 shifts nothing
# out, and a gap of 2 or more loses at most one leading bit, while an inexact sticky makes
# the difference odd — strictly between the same two even neighbours as the true one.
# Exact cancellation is +0 (round to nearest).
fn _sf_addf(a, b): i64 {
    var ea = _sf_ex(a);
    var eb = _sf_ex(b);
    var ma = _sf_sg(a) << 9;
    var mb = _sf_sg(b) << 9;
    mb = _sf_jam(mb, ea - eb);
    var s = a >> 63;
    if ((a ^ b) < 0) {
        var d = ma - mb;
        if (d == 0) { return 0; }
        return _sf_norm(s, ea, d);
    }
    return _sf_norm(s, ea, ma + mb);
}

# a + b. +0 + -0 is +0, -0 + -0 is -0; inf + -inf refuses.
fn _sf_add(a, b): i64 {
    if (_sf_isnan(a) == 1) { return _sf_fail(); }
    if (_sf_isnan(b) == 1) { return _sf_fail(); }
    var ma = a & 0x7FFFFFFFFFFFFFFF;
    var mb = b & 0x7FFFFFFFFFFFFFFF;
    if (ma == 0x7FF0000000000000) {
        if (mb == 0x7FF0000000000000) {
            if ((a ^ b) < 0) { return _sf_fail(); }
        }
        return a;
    }
    if (mb == 0x7FF0000000000000) { return b; }
    if (mb == 0) {
        if (ma == 0) { return a & b; }
        return a;
    }
    if (ma == 0) { return b; }
    if (mb > ma) { return _sf_addf(b, a); }
    return _sf_addf(a, b);
}

# a - b, which IEEE 754 defines as a + (-b) (signed zeros included).
fn _sf_sub(a, b): i64 {
    var nb = b ^ (1 << 63);
    return _sf_add(a, nb);
}

# Unsigned 64 x 64 -> 128-bit product built from 32-bit halves: returns the low 64 bits and
# leaves the high 64 in _sf_hi. Each partial product is below 2^64 and its bits are right
# read as unsigned (the multiply keeps the low 64 bits; `>>` is logical).
fn _sf_mul128(x, y): i64 {
    var x0 = x & 0xFFFFFFFF;
    var x1 = x >> 32;
    var y0 = y & 0xFFFFFFFF;
    var y1 = y >> 32;
    var p00 = x0 * y0;
    var p01 = x0 * y1;
    var p10 = x1 * y0;
    var mid = (p00 >> 32) + (p01 & 0xFFFFFFFF) + (p10 & 0xFFFFFFFF);
    _sf_hi = x1 * y1 + (p01 >> 32) + (p10 >> 32) + (mid >> 32);
    return (mid << 32) | (p00 & 0xFFFFFFFF);
}

# a * b for finite nonzero a, b. The product of two [2^52, 2^53) significands is in
# [2^104, 2^106); its top bits >> 43 land in [2^61, 2^63) and the 43 below become sticky.
fn _sf_mulf(a, b): i64 {
    var ma = _sf_unpack(a);
    var ea = _sf_ue;
    var mb = _sf_unpack(b);
    var e = ea + _sf_ue - 1023;
    var lo = _sf_mul128(ma, mb);
    var m = (_sf_hi << 21) | (lo >> 43);
    if ((lo & 0x7FFFFFFFFFF) != 0) { m = m | 1; }
    var s = (a ^ b) >> 63;
    return _sf_norm(s, e, m);
}

# a * b. 0 * inf refuses; a zero product keeps the sign of the operands' signs XORed.
fn _sf_mul(a, b): i64 {
    if (_sf_isnan(a) == 1) { return _sf_fail(); }
    if (_sf_isnan(b) == 1) { return _sf_fail(); }
    var sb = ((a ^ b) >> 63) << 63;
    var ma = a & 0x7FFFFFFFFFFFFFFF;
    var mb = b & 0x7FFFFFFFFFFFFFFF;
    if (ma == 0x7FF0000000000000) {
        if (mb == 0) { return _sf_fail(); }
        return sb | 0x7FF0000000000000;
    }
    if (mb == 0x7FF0000000000000) {
        if (ma == 0) { return _sf_fail(); }
        return sb | 0x7FF0000000000000;
    }
    if (ma == 0) { return sb; }
    if (mb == 0) { return sb; }
    return _sf_mulf(a, b);
}

# floor(x * 2^62 / y), bit 0 set when the remainder is nonzero; x, y in [2^52, 2^53), so the
# quotient is in (2^61, 2^63). Restoring long division, one bit per step; r stays below 2^54.
fn _sf_divsig(x, y): i64 {
    var r = x;
    var q = 0;
    var i = 0;
    while (i < 63) {
        q = q << 1;
        if (r >= y) {
            r = r - y;
            q = q | 1;
        }
        r = r << 1;
        i = i + 1;
    }
    if (r != 0) { q = q | 1; }
    return q;
}

# a / b for finite nonzero a, b.
fn _sf_divf(a, b): i64 {
    var ma = _sf_unpack(a);
    var ea = _sf_ue;
    var mb = _sf_unpack(b);
    var e = ea - _sf_ue + 1022;
    var q = _sf_divsig(ma, mb);
    var s = (a ^ b) >> 63;
    return _sf_norm(s, e, q);
}

# a / b. 0 / 0 and inf / inf refuse; nonzero / 0 is a signed infinity, finite / inf a
# signed zero.
fn _sf_div(a, b): i64 {
    if (_sf_isnan(a) == 1) { return _sf_fail(); }
    if (_sf_isnan(b) == 1) { return _sf_fail(); }
    var sb = ((a ^ b) >> 63) << 63;
    var ma = a & 0x7FFFFFFFFFFFFFFF;
    var mb = b & 0x7FFFFFFFFFFFFFFF;
    if (ma == 0x7FF0000000000000) {
        if (mb == 0x7FF0000000000000) { return _sf_fail(); }
        return sb | 0x7FF0000000000000;
    }
    if (mb == 0x7FF0000000000000) { return sb; }
    if (mb == 0) {
        if (ma == 0) { return _sf_fail(); }
        return sb | 0x7FF0000000000000;
    }
    if (ma == 0) { return sb; }
    return _sf_divf(a, b);
}

# The nearest binary64 to i (ties to even). -2^63 has no positive i64 magnitude and is
# exact: its bits are written out.
fn _sf_from_i64(i): i64 {
    if (i == 0) { return 0; }
    var lo = 1 << 63;
    if (i == lo) { return lo | 0x43E0000000000000; }
    if (i < 0) { return _sf_norm(1, 1084, 0 - i); }
    return _sf_norm(0, 1084, i);
}

# x truncated toward zero. A NaN, an infinity, or |x| >= 2^63 (exactly -2^63 excepted)
# refuses.
fn _sf_to_i64(x): i64 {
    if (_sf_isnan(x) == 1) { return _sf_fail(); }
    var k = ((x >> 52) & 0x7FF) - 1023;
    if (k < 0) { return 0; }
    var lo = 1 << 63;
    if (k > 62) {
        if (x == (lo | 0x43E0000000000000)) { return lo; }
        return _sf_fail();
    }
    var m = _sf_sg(x);
    if (k >= 52) { m = m << (k - 52); }
    else { m = m >> (52 - k); }
    if (x < 0) { return 0 - m; }
    return m;
}

# An integer that orders x like the reals: the magnitude bits, negated for a negative x
# (-0 and +0 are both 0, the infinities the extremes).
fn _sf_key(x): i64 {
    var m = x & 0x7FFFFFFFFFFFFFFF;
    if (x < 0) { return 0 - m; }
    return m;
}

# -1 / 0 / 1 as a < / == / > b; -0 == +0. A NaN refuses.
fn _sf_cmp(a, b): i64 {
    if (_sf_isnan(a) == 1) { return _sf_fail(); }
    if (_sf_isnan(b) == 1) { return _sf_fail(); }
    var ka = _sf_key(a);
    var kb = _sf_key(b);
    if (ka < kb) { return 0 - 1; }
    if (ka > kb) { return 1; }
    return 0;
}

# Sign-bit flip (a NaN keeps its payload; never refuses).
fn _sf_neg(x): i64 {
    return x ^ (1 << 63);
}

# Sign bit cleared (never refuses).
fn _sf_abs(x): i64 {
    return x & 0x7FFFFFFFFFFFFFFF;
}

# x rounded to an integer: toward zero, then one unit away from zero when `up` is 1 and x
# had a fraction. Exact: below 2^52 the unit is 2^(52 - k) in the bits, and its carry into
# the exponent field makes the next power of two. A zero result keeps x's sign.
fn _sf_rint(x, up): i64 {
    if (_sf_isnan(x) == 1) { return _sf_fail(); }
    var e = (x >> 52) & 0x7FF;
    # Already integral: |x| >= 2^52, and the infinities.
    if (e >= 1075) { return x; }
    var sb = (x >> 63) << 63;
    if (e < 1023) {
        if ((x & 0x7FFFFFFFFFFFFFFF) == 0) { return x; }
        if (up == 1) { return sb | 0x3FF0000000000000; }
        return sb;
    }
    var fm = (1 << (1075 - e)) - 1;
    if ((x & fm) == 0) { return x; }
    var t = x - (x & fm);
    if (up == 1) { t = t + fm + 1; }
    return t;
}

# Round toward zero: trunc(-0.5) is -0.
fn _sf_trunc(x): i64 {
    return _sf_rint(x, 0);
}

# Round toward -inf: floor(-0.5) is -1, floor(-0) is -0.
fn _sf_floor(x): i64 {
    var up = 0;
    if (x < 0) { up = 1; }
    return _sf_rint(x, up);
}

# Round toward +inf: ceil(-0.5) is -0, ceil(0.5) is 1.
fn _sf_ceil(x): i64 {
    var up = 0;
    if (x > 0) { up = 1; }
    return _sf_rint(x, up);
}

# Parse: impl TraitName for TypeName { fn method(self) { } ... }
# Methods get mangled to TypeName_method (trait name is documentation only for now)
# ⛔ 6.7.7 (B4) — `impl ( .. ) {` / `impl Tr for ( .. ) {`: a tuple has no methods (R3). Refused by
# name at the `(`, and the whole block skipped — pass 1 skipped it too (`_impl_name_skip`), so no
# method of it is registered. CHANGELOG [6.7.7]
fn _impl_tup_refuse(S): i64 {
    _tup_err(S, GTI(S), "a tuple has no methods - `impl` on a tuple type is refused", 0 - 1, 0);
    STI(S, _call_close(S, GTI(S)) + 1);
    _skip_refused_body(S);
    return 0;
}
# Pass 1's impl skip: one name, or (6.7.7) a tuple type's whole `( .. )`, which PARSE_IMPL refuses.
fn _impl_name_skip(S): i64 {
    if (PEEKT(S) == 10) { STI(S, _call_close(S, GTI(S)) + 1); return 0; }
    STI(S, GTI(S) + 1);
    return 0;
}

fn PARSE_IMPL(S): i64 {
    # v6.6.4: a marker live here can only be STALE — `public impl` is consumed un-armed by
    # _TL_VIS, and a per-method `public fn` re-arms inside the loop below. Pass 2's `var` skip
    # never consumes, so `public var V = 7;` followed by an impl block re-exposed its FIRST
    # method.
    # ⛔ 6.6.5: that sentence used to end "(the only definition class stamped in pass 2 only)",
    # and pass 1 DID brace-skip impl bodies. It does not any more — `_prescan_impl` registers
    # and stamps every method in pass 1, which is what makes a forward `q.m()` / `Q_m(&q)` obey
    # `private` and get the right parameter ABI. See _prescan_impl. CHANGELOG [6.6.5]
    _pub_pending = 0;
    var impl_ti = GTI(S);
    STI(S, GTI(S) + 1);  # consume IMPL
    # `impl Trait for Type {` or (6.7.0, A3) the inherent `impl Type {` — methods with no trait.
    if (PEEKT(S) == 10) { return _impl_tup_refuse(S); }   # 6.7.7 (R3): `impl ( .. ) {`
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var trait_noff = PEEKV(S);
    STI(S, GTI(S) + 1);  # consume the trait (or, inherent, the type) name
    var type_noff = trait_noff;
    if (PEEKT(S) == 13) { trait_noff = 0; }
    else {
        if (PEEKT(S) != 55) { ERR_MSG(S, "expected '{' (an inherent `impl Type {`) or 'for' (`impl Trait for Type {`)", 75); }
        STI(S, GTI(S) + 1);  # consume FOR
        if (PEEKT(S) == 10) { return _impl_tup_refuse(S); }   # 6.7.7 (R3): `impl Tr for ( .. ) {`
        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
        type_noff = PEEKV(S);
        STI(S, GTI(S) + 1);  # consume type name
    }
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);  # consume {
    # Parse methods inside the impl block
    # Temporarily set module to the type name so methods get mangled
    var saved_mod = GMOD(S);
    SMOD(S, type_noff);
    var _sit = _impl_tnoff;
    _impl_tnoff = type_noff;   # 6.7.0 (A4)
    var _sitr = _impl_trait;
    _impl_trait = trait_noff;  # 6.7.0 (A3)
    var _sii = _cur_ii;
    _cur_ii = 0 - 1;
    if (_ti_n > 0) { _cur_ii = _ti_by_ti(S, impl_ti); }   # 6.7.0 (A1/A2): its trait record
    _tr_check_impl(S, _cur_ii);
    var igo = 1;
    while (igo == 1) {
        if (PEEKT(S) == 14) { igo = 0; }
        else {
            _impl_attrs(S, 1);         # 6.6.17: `#deprecated` / `#must_use` / ... on a method
            if (_TL_VIS(S) == 1) { }   # v6.5.0: `pub`/`public` on an impl method
            if (PEEKT(S) == 32) { _tr_mod_for(S); PARSE_FN_DEF(S); _tr_mod_back(S); }
            else { igo = 0; }
        }
    }
    _tr_defaults(S, _cur_ii, 1);       # 6.7.0 (A1): the trait's defaults this impl does not define
    _cur_ii = _sii;
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);  # consume }
    _impl_tnoff = _sit;
    _impl_trait = _sitr;
    _cur_iself_sid = 0;        # top-level code after the impl is no method body
    SMOD(S, saved_mod);
    return 0;
}

# ⛔ 6.6.17 — DIRECTIVES IN AN impl BODY. Its loop took only `pub` and `fn`, so `#deprecated("..")`
# before a method was "expected '}', got unknown" (#must_use / #pure / #io / #alloc / #inline /
# #regalloc / #naked and #assert alike). They go through THE top-level dispatcher
# (`_tl_directive`): arm 1 in pass 2 arms an attribute for the method PARSE_FN_DEF parses next;
# arm 0 in pass 1 (`_prescan_impl_body`) consumes, and records a `#deprecated` for the method it
# registers, so a call parsed before the impl warns too.
fn _impl_attrs(S, arm): i64 {
    while (_tl_directive(S, arm) == 1) { }
    return 0;
}

# Skip generic parameters <T, U, ...> if present
# ⛔ 6.6.17: NESTED. It stopped at the first `>` and knew no `>>`, so `Vec<Box<i64>>` — whose
# tail the lexer makes ONE `>>` token — ran to the end of the file (`expected '=', got end of
# file`), and `Vec<Box<i64> >` left a `>` behind. See `_skip_targ_list`.
fn SKIP_GENERICS(S): i64 {
    if (PEEKT(S) == 19) { _skip_targ_list(S); }
    return 0;
}
# Cursor on a `<`: consume through the `>` that closes it, nested lists included (`>>` / `>>>`
# close two / three levels). Returns how many levels the last closer closed BEYOND this list — an
# enclosing type-argument list's `>` the lexer folded into the same token (`Box<Vec<i64>>`'s
# `>>`, seen from `Vec`), which the caller owes to `_consume_gt` (`_ta_pending_gt`).
# v6.5.19: EOF guard. `fn f<`, `struct S<`, `enum E<` truncated here span a loop whose only exit
# was `>`; this skipper emits no diagnostic, so `_had_error` stayed 0 and the v6.4.62 watchdog
# never ticked — cycc HUNG outright. See _wd_eof_tick (src/common/util.cyr) and the include-length ifdef bug.
fn _skip_targ_list(S): i64 {
    var d = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { return 0; }
        if (t == 19) { d = d + 1; }
        elif (t == 20) { d = d - 1; }
        elif (t == 39) { d = d - 2; }
        elif (t == 152) { d = d - 3; }
        STI(S, GTI(S) + 1);
        if (d <= 0) { go = 0; }
    }
    return 0 - d;
}

# v6.3.9 (F-fns): capture a generic param list `<T, U>` at a fn signature, returning
# the names PACKED as (off0+1) | ((off1+1) << 32) (0 = no `<...>`). Consumes EXACTLY
# the tokens SKIP_GENERICS would (`<` through `>`), so the cursor advances identically.
# Default path (_MONOMORPH_OK == 0): delegates to SKIP_GENERICS verbatim and returns 0
# — byte-identical to the pre-v6.3.9 skip. Only ≤2 params are captured (the inline
# replay's pc≤2 ceiling); extra params are consumed but not recorded.
fn _capture_tparams(S): i64 {
    if (_MONOMORPH_OK == 0) { SKIP_GENERICS(S); return 0; }
    if (PEEKT(S) != 19) { return 0; }
    _ctp_n0 = 0; _ctp_n1 = 0; _ctp_bad = 0;   # 6.7.1 (C3): this list's bounds
    STI(S, GTI(S) + 1);  # consume <
    var off0 = 0;
    var off1 = 0;
    var n = 0;
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) == 20) { go = 0; }
        # v6.5.19: EOF guard — the monomorph twin of SKIP_GENERICS above, same hang.
        # It must consume EXACTLY what SKIP_GENERICS does (see the comment on this fn),
        # so the two guards have to stay in lockstep.
        elif (PEEKT(S) == 12) { go = 0; }
        else {
            if (PEEKT(S) == 2) {
                if (n == 0) { off0 = PEEKV(S) + 1; }
                if (n == 1) { off1 = PEEKV(S) + 1; }
                n = n + 1;
                STI(S, GTI(S) + 1);
                # 6.7.1 (C3): `T: Show + Eq` — a BOUND, not two more type parameters (it minted
                # `Show` as the second one). Consumed here; `_bnd_make` resolves and reports.
                if (PEEKT(S) == 49) {
                    _ctp_bounds(S, n - 1);
                    if (_ctp_closed == 1) { _ctp_closed = 0; return off0 | (off1 << 32); }   # `>>` closed it
                }
            } else {
                STI(S, GTI(S) + 1);
            }
        }
    }
    STI(S, GTI(S) + 1);  # consume >
    return off0 | (off1 << 32);
}

# v6.3.9 (F-fns): infer the CANONICAL concrete-type token of the arg expression at
# the current cursor, WITHOUT consuming it. Encoding matches _tp_resolve: >0 struct
# sid, <0 -scalarwidth. `IDENT(` → callee GFRS (whose >0-sid / <0-width encoding is
# already canonical); a struct local (GLTYPE = -sid) → +sid; everything else (plain
# int, literal, complex expr) → i64 (-8). Narrow-scalar args infer as i64 — explicit
# `foo<i32>(x)` (the wired-up call form) pins those precisely.
# ⛔ 6.7.9 — an f64 argument binds f64 (-9), as an f64-returning call already did: an f64 local
# or parameter, an f64 global (`_infer_conc_global`) and a float literal, each as the WHOLE
# argument (`_gen_arg_whole`; `g(h * 2.0)` stays i64, as `g(p + 1)` does). They inferred i64, so
# `gid(h)` ran the i64 base and its result was an untyped word — `gid(h) * 2.0` multiplied the
# double's bits. An f32 is not a type argument (nor a return type): it stays i64. CHANGELOG [6.7.9]
# ⛔ 6.7.14 — `ptr` 1: the carrying parameter is `p: *T` (`_ic_arg`), where a pointer binds what it POINTS AT; 0:
# `x: T`, where no pointer binds (see `_ic_arg`). CHANGELOG [6.7.14]
# ⛔ 6.7.15 — and what it points at may be a SCALAR (the user's decision D11 (a), 2026-10-18): see `_ic_pscalar`.
fn _infer_conc_at(S, ptr): i64 {
    if (PEEKT(S) == 61) { return _ic_flit(S); }
    if (PEEKT(S) == 27) { return _ic_addr(S, ptr); }   # 6.7.14: `&G` / `&l`
    if (PEEKT(S) == 2) {
        var _ic_noff = PEEKV(S);
        if (_ic_is_call(S) == 1) {   # 6.7.11: + an explicit generic call `mk1<Pt>(p)`
            var _ic_fi = FINDFN(S, _ic_noff);
            if (_ic_fi >= 0) {
                var _ic_ret = _ic_call_rs(S, _ic_fi, ptr);   # 6.7.9: + a generic's f64 instance
                if (_ic_ret != 0) { return _ic_ret; }
            }
        } else {
            var _ic_lli = FINDLOCAL(S, _ic_noff);
            if (_ic_lli >= 0) {
                var _ic_lt = GLTYPE(S, _ic_lli);
                # 6.6.10: a vector local's SLTYPE is a descriptor sentinel (<= -2048), not a
                # struct id — it read as "struct 2093". Vectors are not type arguments.
                if (_ic_lt <= 0 - 2048) { return 0 - 8; }
                if (GLPTRP(S, _ic_lli) == 1) { return _ic_ptr_slot(S, _ic_lli, _ic_lt, ptr); }   # 6.7.14: a `*S` slot
                if (_load_lt(S, _ic_lli) == F64_TYID) { return 0 - 9; }   # 6.7.9
                if (_ic_lt < 0) { return 0 - _ic_lt; }
                return 0 - 8;
            }
            if (_cl_cap_esl(S, _ic_noff) >= 0) { return _ic_cap(S, _ic_noff, ptr); }   # 6.7.14: a captured `*S`
            return _infer_conc_global(S, _ic_noff, ptr);
        }
    }
    return 0 - 8;
}
# A typed-pointer slot `li` (a `*S` local, parameter or capture: SLTYPE `0 - sid` behind bit 56 since 6.6.17) binds S
# through `p: *T` only — 6.7.15 (D11 (a)): a scalar pointee its scalar (`_ic_pscalar`); through `x: T` it is a
# pointer, which infers i64. CHANGELOG [6.7.14]
fn _ic_ptr_slot(S, li, lt, ptr): i64 {
    if (ptr == 0) { return 0 - 8; }
    if (lt < 0) { return 0 - lt; }
    return _ic_pscalar(_slot_ptr_word(S, li));
}
# ⛔ 6.7.15 — A `p: *T` / `pp: **T` PARAMETER BINDS A SCALAR POINTEE TOO (the user's decision D11 (a), 2026-10-18).
# 6.7.14's D8 bound only a struct pointee: `second(pa)` with `pa: *i32` and `fn second<T>(p: *T)` ran the i64 base,
# whose `p + 1` stepped 8 and `*p` read 8 (over an i32 array: a[2]'s word, where `second<i32>(pa)` reads a[1]), and
# `gsz(&h)` with `h: f64` was the i64 instance. The binding a typed pointer's step word `w` names (its kind, bits 40-47,
# `_ps_word`): i8 / i16 / i32 their width, f64 -9; i64 for every other pointee — `*i64`, `*u8`..`*u64`, `*f32`,
# `*bool`, a pointer, a vector, an enum: no type argument but i64 (an f32 value binds none either). A non-i64 answer
# marks `_gi_sc`, so the call instantiates as `second<i32>(pa)` does (`_gen_sc_inst`; a stub base keeps its refusal).
# Every `p: *T` source reads its word here — a `*T` local, parameter, capture or global, a `: *T` call, a `*T` field
# chain, `&x` of a scalar local or global (`_ic_ascalar`) — and a `pp: **T` source its pin's pointee word
# (`_ic_pp_sid`, `_ic_pp_addr`). CHANGELOG [6.7.15]
fn _ic_pscalar(w): i64 {
    var r = 0 - 8;
    if (w > 0) {
        var ed = (w >> 40) & 0xFF;
        if (ed == 0x41) { r = 0 - 1; }
        elif (ed == 0x42) { r = 0 - 2; }
        elif (ed == 0x44) { r = 0 - 4; }
        elif (ed == 0x28) { r = 0 - 9; }
    }
    if (r != 0 - 8) { _gi_sc = 1; }
    return r;
}
# A name a capturing closure's body reads as a capture (`_cl_cap_esl`), through `p: *T`: its struct when the
# enclosing slot is a `*S` (its pointer mark rides the snapshot, `_cl_snap_ptrp`), 6.7.15 (D11) its scalar when it is
# a scalar pointer; 6.7.15 (D12 (a)) a captured struct VALUE its struct through either shape, as a struct local
# binds (through `p: *T` the call passes the capture's copy's address); any other capture reads as before (a global
# of its name, else i64). CHANGELOG [6.7.14]
fn _ic_cap(S, noff, ptr): i64 {
    var esl = _cl_cap_esl(S, noff);
    var t = _cl_snap_type(esl);
    if (_cl_snap_ptrp(esl) == 0) { if (t < 0) { if (t > 0 - 2048) { return 0 - t; } } }
    if (ptr == 0) { return _infer_conc_global(S, noff, 0); }
    if (_cl_snap_ptrp(esl) == 0) { return _infer_conc_global(S, noff, 0); }
    if (t <= 0 - 2048) { return _infer_conc_global(S, noff, 0); }
    if (t < 0) { return 0 - t; }
    return _ic_pscalar(_cl_snap_ptr_word(esl));
}
# `&name` at the cursor through `p: *T`: an inline struct local, a by-value struct parameter or an inline struct
# global binds its struct (`_gsc_addr_of`, the struct carrier's reader); a pointer's `&p` is a `**`, and a tuple,
# a dyn and a capture bind nothing. 6.7.15 (D11): a scalar local or global its scalar (`_ic_ascalar`). i64 through
# `x: T`. CHANGELOG [6.7.14]
fn _ic_addr(S, ptr): i64 {
    if (ptr == 0) { return 0 - 8; }
    var i = GTI(S) + 1;
    if (_gsc_name_end(S, i) == 0) { return 0 - 8; }
    if (_cl_cap_esl(S, TOKVAL(S, i)) >= 0) { return 0 - 8; }   # a capture's copy: not `&l` / `&G`
    var s = _gsc_addr_of(S, TOKVAL(S, i));
    if (s <= 0) { return _ic_ascalar(S, TOKVAL(S, i)); }
    if (_tup_is(S, s) == 1) { return 0 - 8; }
    if (_dyn_is(S, s) == 1) { return 0 - 8; }
    return s;
}
# `&noff` of a scalar (6.7.15, D11 (a)): an i8 / i16 / i32 local, parameter or global its width — a SIGNED narrow one,
# as its load reads it (a local's negative slice-width mark, a global's GVSGN) — an f64 one f64 (marking `_gi_sc`, as
# `_ic_pscalar`); i64 for anything else (an i64 or unsigned or `bool` / `f32` scalar, a pointer — `&p` is a `**` —
# an array or other aggregate, no such name).
fn _ic_ascalar(S, noff): i64 {
    var li = FINDLOCAL(S, noff);
    if (li >= 0) {
        if (GLPTRP(S, li) == 1) { return 0 - 8; }
        if (GLAGG(S, li) == 1) { return 0 - 8; }
        var lt = _load_lt(S, li);
        if (lt == F64_TYID) { return _ic_sc_mark(0 - 9); }
        if (lt == 1 || lt == 2 || lt == 4) { if (GSLICE_W(S, li) < 0) { return _ic_sc_mark(0 - lt); } }
        return 0 - 8;
    }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0 - 8; }
    if (GVSGN(S, vi) >= 0x100) { return 0 - 8; }   # an array
    var gt = GVTYPE(S, vi);
    if (gt == F64_TYID) { return _ic_sc_mark(0 - 9); }
    if (GVPM(S, vi) != 0) { return 0 - 8; }
    if (GVSGN(S, vi) != 1) { return 0 - 8; }
    var gsz = L64(_vars_base + vi * 8);
    if (gsz == 1 || gsz == 2 || gsz == 4) { return _ic_sc_mark(0 - gsz); }
    return 0 - 8;
}
fn _ic_sc_mark(c): i64 {
    _gi_sc = 1;
    return c;
}
# 6.6.10 (bite 7 review): a `pp: *Pt` parameter. The parameter loop skips the `*`, so the slot is
# typed `Pt` like a by-value one and `pp.x` works — but it is a POINTER, and a `var q: *Pt` local
# (not struct-typed at all) infers i64, so `f(pp)` does too. It used to instantiate `f$Pt`.
# 6.6.16 (C7): the `*` is seen before the slot exists, so this only marks the slot to come;
# `_param_record` writes it onto the slot itself. It was a 64-bit mask by slot index, blind at
# slot >= 64, where a pointer then read as a by-value struct and was copied in. CHANGELOG [6.6.16]
fn _mark_ptr_param(S): i64 {
    _cur_fn_ptrp = GFLC(S) + 1;
    # 6.6.17: and its step, sizeof(T), as a mark on the slot the parameter takes next — read only
    # behind the slot's bit 56, which `_param_record` sets (see `_sl_marks`). Cursor on T; an
    # unknown T is refused by `_tn_param_check`, so this is quiet. `**T` steps a pointer's 8.
    # 6.7.8 (C2-3a): and T's kind with it (`_ps_word`, parse_types.cyr), under the same binding.
    var ps = 8;
    var ed = 0;
    if (PEEKT(S) != 8) {
        ps = _ptr_step_peek(S, 0 - 1, 1);
        ed = _ek_at(S, GTI(S));
    }
    var pw = _ps_vw(_ps_word(ps, ed), _ek_vd(S, GTI(S) - 1));   # 6.7.12: a `*V`'s vector
    SSLICE_W(S, GFLC(S), 0 - 0x7E00 - _ps_pw(pw, _ek_pin(S, GTI(S) - 1)));   # 6.7.13: a `**T`'s pointee
    return 0;
}
# ⛔ 6.7.0 (A4) — AN UNTYPED `self` IN AN `impl … for T` IS A `*T`. It was a bare address: `self.x`
# was "no struct type in scope for 'self'" (every body read `load64(self)`), and the direct call
# `T_m(o)` passed o's VALUE where `o.m()` passed `&o` — on an 8-byte struct the method then loaded
# through the value (SIGSEGV). Typed `*T` it reads fields like a `p: *T` parameter, and 6.6.20's
# rule that a bare struct passed to a `*T` parameter passes its address makes `T_m(o)` agree with
# `o.m()`. ⚠ A `*T` steps sizeof(T) under `+` / `-`, so `load64(self + 8)` would have changed
# meaning silently: arithmetic on an untyped `self` is REFUSED instead (the user's decision,
# 2026-10-07; `_iself_arith_check`). An explicit `self: *T` or `self: T` is untouched, and only a
# plain struct T qualifies (an impl for Str / Result / a vector keeps `self` untyped).
# Pass 1 records the impl's type on the fn (SFISELF) and marks the ABI exactly as `self: *T` does —
# `_param_wants_struct_ptr` is 1 for any `*Struct`, and `_bvcp_note` never copies a pointer in.
# Pass 2 reads the record by fn (a generic instance by its BASE), so it does not depend on being
# inside the impl when it parses. CHANGELOG [6.7.0]
fn _iself_sid_for(S, pnoff): i64 {
    if (_impl_tnoff == 0) { return 0; }
    if (_noff_is(S, pnoff, "self", 4) == 0) { return 0; }
    if (_classify_param_type(S, _impl_tnoff) != 0) { return 0; }
    var sid = FINDSTRUCT(S, _impl_tnoff);
    if (sid <= 0) { return 0; }
    return sid;
}
# Pass 1, parameter 0 of fn `fi` named `pnoff` with no annotation: the struct mask after it.
fn _iself_prescan(S, fi, pnoff, smask): i64 {
    var sid = _iself_sid_for(S, pnoff);
    if (sid <= 0) { return smask; }
    SFISELF(S, fi, _impl_tnoff + 1);
    _psid_scan(S, fi, 0, sid, _pmw(smask, 0, 1), 1);
    return _psid_mask;
}
# Pass 2, the same parameter: its struct (0 = not an untyped impl `self`). Marks the slot it takes
# next as a `*T` (`_mark_ptr_param`'s two writes) and sets `_cur_iself_sid`; `_iself_pt` is the
# parameter's sid after `_gtype_sid`, and the return value's caller reads it.
var _iself_pt = 0;
fn _iself_def_sid(S, fi, pnoff): i64 {
    # Only an IDENT's value is a name offset: the loop has reported a non-IDENT parameter
    # (`fn f(140737488355327)`) and carries on, and reading its NUMBER as an offset faulted.
    if (TOKTYP(S, GTI(S) - 1) != 2) { return 0; }
    if (_noff_is(S, pnoff, "self", 4) == 0) { return 0; }
    var t = GFISELF(S, fi);
    if (_inst_name != 0) { t = GFISELF(S, _inst_base_fi); }
    if (t == 0) { return 0; }
    var sid = FINDSTRUCT(S, t - 1);
    if (sid <= 0) { return 0; }
    _cur_iself_sid = sid;
    _cur_fn_ptrp = GFLC(S) + 1;
    var ps = STRUCTSZ(S, sid - 1);
    if (ps < 1) { ps = 8; }
    SSLICE_W(S, GFLC(S), 0 - 0x7E00 - ps);
    _iself_pt = _gtype_sid(S, fi, sid);
    return sid;
}
fn _iself_def_mask(S, fi, smask, sid): i64 {
    return _gtype_param_mask(S, _pmw(smask, 0, 1), 0, sid, _iself_pt, 1);
}
# The arithmetic refusal: `self` was just consumed as an identifier (cursor past it) in a method
# whose `self` is untyped. Refused when an arithmetic operator follows it (`self + 8`, `self - n`,
# the `%` / `|` / `?` forms) or precedes it (`8 + self`), or a subscript follows (`self[i]` steps
# elements too). A field read, a method call, a comparison and `load64(self)` are untouched.
fn _iself_arith_check(S, noff): i64 {
    if (_cur_iself_sid <= 0) { return 0; }
    if (_noff_is(S, noff, "self", 4) == 0) { return 0; }
    if (PEEKT(S) == 41) { return 0; }   # `self.field` / `self.m()` — a field, not the pointer
    var bad = _iself_arith_tok(PEEKT(S));
    if (PEEKT(S) == 28) { bad = 1; }
    if (GTI(S) >= 2) { if (_iself_arith_tok(TOKTYP(S, GTI(S) - 2)) == 1) { bad = 1; } }
    if (bad == 0) { return 0; }
    ERR_IDENT(S, "arithmetic on an untyped `self` is refused - in an impl it points at ", L64(S + 0x1A6018 + (_cur_iself_sid - 1) * 8), ": read fields with `self.field`, or declare `self: *T` to step whole elements of ", L64(S + 0x1A6018 + (_cur_iself_sid - 1) * 8));
    return 1;
}
fn _iself_arith_tok(t): i64 {
    if (t == 6 || t == 7) { return 1; }
    if (t >= 113) { if (t <= 118) { return 1; } }
    return 0;
}
# 6.6.16 (C7) — an int-class parameter's slot facts, once its SLTYPE is set: an `async fn` refuses
# a struct by value (it reads the pending `*` mark, so first); a struct of 8 B or less is inline
# (MARK_SMALL_STRUCT); a `*T` is marked on its own slot — LAST, because MARK_SMALL_STRUCT's SLAGG
# rewrites the word's high half. One call from the parameter loop. CHANGELOG [6.6.16]
# ⛔ 6.6.17 (a2) — only a BY-VALUE struct parameter is a small struct. A `p: *T` is always an 8-byte
# pointer, whatever T's size; marking it inline when T was 8 B or less made `p.v` read and write
# the pointer's own slot (the caller's struct never moved). CHANGELOG [6.6.17]
fn _param_record(S, li, pnoff, is_async): i64 {
    if (is_async == 1) { _refuse_async_struct_param(S, li, pnoff); }
    if (_cur_fn_ptrp != li + 1) { MARK_SMALL_STRUCT(S, li, GLTYPE(S, li)); }
    if (_cur_fn_ptrp == li + 1) { SLPTRP(S, li); }
    _cur_fn_ptrp = 0;
    if (_cur_fn_slp == li + 1) { SLSLICE(S, li, 8 | (8 << 32)); }   # 6.7.8 (C2-6a): see _sl_param_refuse
    _cur_fn_slp = 0;
    _dsc_param_slot(S, li);   # 6.7.8 (D5): last
    return 0;
}
# ⛔ 6.7.8 (C2-6a) — A SLICE PARAMETER IS REFUSED BY NAME (the user's decision, 2026-10-10: slices
# stay locals; "a slice PARAMETER ... refused BY NAME"). `fn f(s: [u8])` was `expected ')', got
# identifier 'u8'` (with `s.len` in the body a second error, and pass 1's count stopped at the `[`,
# so a forward call met an arity error), `s: slice<u8>` "unknown type 'slice'". Token `ti` is the
# slice's first token: `p: *[T]` is a pointer parameter (its own text); a slice parameter's slot is
# marked a slice for the body (`_param_record`: `s.len`, `s[i]`, `s[i] = v` report nothing more —
# the program does not build).
var _cur_fn_slp = 0;   # the refused slice parameter's slot + 1 (the slot to come), 0 = none
fn _sl_param_refuse(S, ti): i64 {
    if (TOKTYP(S, ti - 1) == 8) { return _sl_err_ptr(S, ti); }
    _cur_fn_slp = GFLC(S) + 1;
    return _sl_err(S, ti, "a slice cannot be a parameter (6.7.8: slices are fn-locals)",
      " - pass &s and read slice_ptr / slice_len, or the pointer and the length");
}
# ⛔ 6.7.11 — A PARAMETER'S TYPE IS READ WHOLE, BY ONE GRAMMAR IN BOTH PASSES: the trait-signature
# reader's (`_trs_type`, 6.7.8) — any number of `*`, then `u128`, a tuple, `*fn( .. )` with an optional
# `: T`, a bare `*fn` (accepted since 6.7.7), or a name with its `<..>`; anything else is refused by
# name, once (the user's decision, 2026-10-13: (b)). Both passes stepped ONE token after at most one
# `*`, so `fn f(p: **i64)` met "expected ')'", and `fn f(a: 5)` / `(a: +)` / `(a: "s")` compiled with
# the token skipped. Pass 2 keeps its arms for a name, a tuple and a slice behind one `*`; the reader
# takes the rest (`_param_type_step`), and pass 1 the same span quietly (`_param_type_step_q`), so the
# two count the same parameters (`_pd_pc_check`). CHANGELOG [6.7.11]
var _pty_ts = 0;    # pass 2: the parameter type's first token (just past its `:`)
var _pty_bad = 0;   # the type being read has reported (it reports nothing more)
# Pass 2, cursor just past a parameter's `:`: the type's start recorded, and a first `*` consumed and
# marked on the slot to come (`_mark_ptr_param`; a second `*` makes the step 8).
fn _param_ptr_head(S): i64 {
    _pty_ts = GTI(S);
    if (PEEKT(S) != 8) { return 0; }
    STI(S, GTI(S) + 1);
    _mark_ptr_param(S);
    return 0;
}
# Pass 1's (quiet), cursor on a type token its arms do not take (a `*` after the first, `fn`, `u128`,
# a slice, or no type at all): the cursor left past the type, as pass 2 leaves it.
fn _param_type_step_q(S): i64 {
    _pty_bad = 0;
    STI(S, _pty_end(S, GTI(S), 0, 0));
    return 0;
}
# The parameter loop's "consume type" (pass 2): a name its type-name arm took is stepped (the loop's
# SKIP_GENERICS takes the `<..>`); anything else is read from the type's start, and refused by name
# when it is not a type (a slice `[T]` by its own text, 6.7.8 C2-6a).
fn _param_type_step(S): i64 {
    if (PEEKT(S) == 2) {
        STI(S, GTI(S) + 1);
        _vec_ann_chk(S, GTI(S) - 1, _pty_pnoff(S));   # 6.7.11: `v: Vec<T>` / `v: *Vec<T>` read T
        return 0;
    }
    _pty_bad = 0;
    STI(S, _pty_end(S, _pty_ts, 1, 0));
    return 0;
}
# The token after the type that starts at token `i` — a function of the tokens alone, so the passes
# agree even on a refused type. `loud` 1 (pass 2) reports, the first problem of each type once;
# `inner` 1 inside a `*fn( .. )`, whose names no other arm checks. At the top level pass 2's arms took
# a name, a tuple and a `slice<T>` behind at most one `*`, so the reader checks those only behind two.
fn _pty_end(S, i, loud, inner): i64 {
    var n = 0;
    while (TOKTYP(S, i) == 8) {
        i = i + 1;
        n = n + 1;
    }
    var own = loud;
    if (inner == 0) { if (n < 2) { own = 0; } }
    if (_sl_ann_at(S, i) == 1) {
        if (TOKTYP(S, i) == 28) { own = loud; }
        return _pty_slice(S, i, own, inner);
    }
    var t = TOKTYP(S, i);
    if (t == 105) { return _pty_u128(S, i, loud, inner, n); }   # u128 (6.7.14: not a parameter type yet)
    if (t == 10) { return _pty_tuple(S, i, own, loud); }
    if (t == 32) { return _pty_fn(S, i, loud, n); }
    if (t == 2) {
        if (own == 1) { _pty_name(S, i); }
        return _pty_gen_end(S, i + 1);
    }
    _pty_err(S, i, loud);
    return _pty_skip(S, i);
}
# ⛔ 6.7.14 — A `u128` PARAMETER IS REFUSED BY NAME UNTIL u128 IS CARRIED AS A 16-BYTE VALUE (the user's decision
# D10 (a), 2026-10-16; 6.7.6's D2 rule: a u128 shape not carried is refused by name). `fn big(v: u128)` got one 8-byte
# slot holding the caller's low word and no u128 mark, so `v > 0xFFFFFFFFFFFFFFFF` was a SIGNED 64-bit compare (`big(0)`
# was 1) and `load64(&v + 8)` read the next frame slot. A `*u128` (`n` > 0) and a `*fn(u128)` type's own list (`inner`)
# are unchanged. The token after the type, as before (pass 1 and the default reader agree: `_pty_bad`).
# CHANGELOG [6.7.14]
fn _pty_u128(S, i, loud, inner, n): i64 {
    if (n == 0) { if (inner == 0) {
            var b = _pty_bad;
            _pty_bad = 1;
            if (loud == 1) { if (b == 0) { _u128_refuse(S, i, "a parameter type yet - pass `*u128`"); } }
        } }
    return i + 1;
}
# "`u128` is not supported as <what>" at token `ti`, once per token (a generic's instances and an #inline replay
# re-read a signature); --syntax-only too (the return / field shapes were the syntax error "expected identifier, got
# reserved keyword 'u128'"). Not a panic: the declaration reads on.
fn _u128_refuse(S, ti, what): i64 {
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": `u128` is not supported as ");
    PRSTR(what);
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}
# Past a refused token `i`, to the parameter's (or the list element's) end: the next `,` / `)` /
# `=` at its depth, so `a: -1` / `a: 5 + 3` report once. A token that ends a parameter, and a
# brace, `;` or the end of file after it, are not crossed.
fn _pty_skip(S, i): i64 {
    var t = TOKTYP(S, i);
    if (t == 11 || t == 31 || t == 4 || t == 12 || t == 13 || t == 14) { return i; }
    i = i + 1;
    var d = 0;
    var n = GTCNT(S);
    while (i < n) {
        t = TOKTYP(S, i);
        if (t == 12 || t == 13 || t == 14 || t == 5) { return i; }
        if (d == 0) { if (t == 11 || t == 31 || t == 4) { return i; } }
        if (t == 10 || t == 28) { d = d + 1; }
        if (t == 11 || t == 29) { d = d - 1; }
        i = i + 1;
    }
    return i;
}
# A slice at token `i`, consumed whole; refused by name when `rep` (behind a `*`: its own text).
fn _pty_slice(S, i, rep, inner): i64 {
    if (rep == 1) {
        if (inner == 0) { _sl_param_refuse(S, i); }
        elif (TOKTYP(S, i - 1) == 8) { _sl_err_ptr(S, i); }
        else {
            _sl_err(S, i, "a slice cannot be a parameter (6.7.8: slices are fn-locals)",
              " - pass &s and read slice_ptr / slice_len, or the pointer and the length");
        }
    }
    var sv = GTI(S);
    STI(S, i);
    _sl_ann_skip(S);
    var e = GTI(S);
    STI(S, sv);
    return e;
}
# A tuple at token `i` (its `(`): the token after its `)`. Behind one `*` or none, pass 2's
# `_tup_param` took it; behind two it is a pointer target, refused as `*( .. )` is. Inside a
# `*fn( .. )` its elements are types.
fn _pty_tuple(S, i, own, loud): i64 {
    var c = _call_close(S, i);
    if (own == 0) { return c + 1; }
    if (TOKTYP(S, i - 1) != 8) {
        _pty_list(S, i + 1, loud);
        return c + 1;
    }
    if (_pty_bad == 0) {
        var sv = GTI(S);
        STI(S, i);
        _tup_pos_refuse(S, "a pointer target `*( .. )`");
        STI(S, sv);
    }
    _pty_bad = 1;
    return c + 1;
}
# `fn` at token `i` (`n` the `*`s before it): `fn( .. )` with an optional `: T`, or a bare `fn`
# (6.7.7). A type only behind a `*`.
fn _pty_fn(S, i, loud, n): i64 {
    if (n == 0) { _pty_err(S, i, loud); }
    i = i + 1;
    if (TOKTYP(S, i) != 10) { return i; }
    i = _pty_list(S, i + 1, loud);
    if (TOKTYP(S, i) == 49) { i = _pty_end(S, i + 1, loud, 1); }
    return i;
}
# The types of a `( .. )` from token `i` (just past its `(`), comma-separated: the token after its
# `)`, or the token a `)` was expected at.
fn _pty_list(S, i, loud): i64 {
    if (TOKTYP(S, i) == 11) { return i + 1; }
    var go = 1;
    while (go == 1) {
        var j = _pty_end(S, i, loud, 1);
        if (j == i) { go = 0; }
        elif (TOKTYP(S, j) == 31) { j = j + 1; }
        else { go = 0; }
        i = j;
    }
    if (TOKTYP(S, i) == 11) { return i + 1; }
    _pty_bad = 1;   # the parameter loop reports the `)` it expects here
    return i;
}
# A name at token `i` no other arm checks: refused by name unless it is a type (the type-name arm's
# set, `_tn_param_check`: a by-name handle or vector, a resolved type, the fn's own type parameter).
fn _pty_name(S, i): i64 {
    _vec_ann_chk(S, i, _pty_pnoff(S));   # 6.7.11: `p: **Vec<T>`, a `*fn(Vec<T>)` parameter
    _pty_targs(S, i);                    # 6.7.15 (D7): `cb: *fn(Box<Zork>): i64`
    var nm = TOKVAL(S, i);
    if (_classify_param_type(S, nm) != 0) { return 0; }
    if (_tn_resolve_at(S, i) != 0) { return 0; }
    if (_cur_fn_ix >= 0) { if (_is_tparam_of(S, _cur_fn_ix, nm) == 1) { return 0; } }
    _tn_refuse(S, i, " for parameter ", _pty_pnoff(S));
    return 0;
}
# ⛔ 6.7.15 (D7) — A GENERIC STRUCT'S TYPE ARGUMENTS INSIDE A `*fn( .. )` PARAMETER TYPE (and behind two `*`; `i` the
# name, `<` next) are read at the definition, as the parameter's own `m: Box<Zork>` is since 6.7.14: the list was
# skipped (`_pty_gen_end`), so `cb: *fn(Box<Zork>): i64` compiled. `_targ_chk`: every refusal once at its token,
# nothing instantiated; the fn's own type parameters stay names (the user's D7 (a), 2026-10-18). CHANGELOG [6.7.15]
fn _pty_targs(S, i): i64 {
    if (_MONOMORPH_OK != 1) { return 0; }
    if (TOKTYP(S, i + 1) != 19) { return 0; }
    var sid = FINDSTRUCT(S, TOKVAL(S, i));
    if (sid <= 0) { return 0; }
    if (GSTP(S, sid - 1) == 0) { return 0; }
    var sv_rf = _ta_refd;
    _targ_chk(S, i + 1);
    _ta_refd = sv_rf;
    return 0;
}
# Token `i` past a name: past its `<..>` when one follows.
fn _pty_gen_end(S, i): i64 {
    if (TOKTYP(S, i) != 19) { return i; }
    var sv = GTI(S);
    STI(S, i);
    SKIP_GENERICS(S);
    var e = GTI(S);
    STI(S, sv);
    return e;
}
# The parameter's name (the token before its `:`), or -1.
fn _pty_pnoff(S): i64 {
    if (TOKTYP(S, _pty_ts - 2) != 2) { return 0 - 1; }
    if (TOKTYP(S, _pty_ts - 1) != 49) { return 0 - 1; }
    return TOKVAL(S, _pty_ts - 2);
}
# "expected a type for parameter 'a', got '+'" at token `ti` (`loud`), the type's first problem only,
# once per token (a generic's instances re-read the signature); not a panic, so the list reads on.
fn _pty_err(S, ti, loud): i64 {
    var b = _pty_bad;
    _pty_bad = 1;
    if (loud == 0) { return 0; }
    if (b == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": expected a type");
    var pn = _pty_pnoff(S);
    if (pn >= 0) {
        PRSTR(" for parameter '");
        PRSTR(S + 0xEC00000 + pn);
        PRSTR("'");
    }
    PRSTR(", got ");
    var t = TOKTYP(S, ti);
    PRSTR(TOKNAME(t));
    if (t == 1) {
        PRSTR(" ");
        PRNUM(TOKVAL(S, ti));
    }
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}
# A return annotation the type-name path does not read (cursor on it): `: *T` (6.6.17) and, refused
# by name, a slice `[T]` / `slice<T>` (6.7.8, C2-6a: `expected identifier, got '['` / `unknown type
# 'slice'`). 1 when consumed here.
fn _ret_ann_alt(S, fi): i64 {
    if (_sl_ann_at(S, GTI(S)) == 1) {
        _sl_err(S, GTI(S), "a slice cannot be a return type (6.7.8: slices are fn-locals)",
          " - fill a slice the caller passes as &s (slice_set), or return the pointer and the length");
        _sl_ann_skip(S);
        return 1;
    }
    if (PEEKT(S) == 105) {   # 6.7.14: `: u128` refused by name (it was "expected identifier, got reserved keyword")
        _u128_refuse(S, GTI(S), "a fn return type yet");
        STI(S, GTI(S) + 1);
        return 1;
    }
    if (PEEKT(S) != 8) { return 0; }
    _ret_ptr_annot(S, fi, 0);
    return 1;
}
# v6.3.37 (C1) — why a fn's PARAMETERS keep it off the inline replay: 3 a struct/Str/Result/Option/
# Tagged parameter (SLTYPE = -sid), 6 a `name: *T` parameter, 0 neither. The replay re-registers a
# parameter by NAME with only the type GFIPT packs (`_inl_bind_param`) — vectors and f64/f32 —
# so a struct's SLTYPE is lost (`s.field` mis-parses) and so is a pointer's bit 56 and step mark
# (`_sl_marks`): an inlined `p + 1` stepped 1 whatever T, and on a `*f32` it was a FLOAT add of
# the pointer's bits, while the same fn out of line stepped sizeof(T) (6.6.17 b7 missed this
# site). Such a fn falls back to a call, which handles both correctly. Vectors stay inlinable.
# ⛔ 6.6.20 — this walks SLOTS 0.._cur_fn_pslots-1, not parameters 0..pc-1: a wide vector takes
# GVEC_NSLOTS slots, so after `v: f64v2` the next parameter sits at slot 2 and a by-parameter
# walk never saw it — `fn sx(v: f64v2, s: Pt)` was replayed and crashed the compiler. Fillers
# are untyped and never carry bit 56 (every registration writes SLDEP first). CHANGELOG [6.6.20]
fn _inl_param_why(S): i64 {
    var li = 0;
    while (li < _cur_fn_pslots) {
        if (GLPTRP(S, li) == 1) { return 6; }
        var t = GLTYPE(S, li);
        if (t < 0) { if (_is_simd_any(S, t) == 0) { return 3; } }
        li = li + 1;
    }
    return 0;
}

# 6.7.14 — reason 8: `#inline` on an `async fn`. The body is compiled as `f$impl` and reached only
# through its Future (`future_force`'s fn pointer); no call names `f$impl`, so the replay can never
# run — v6.5.63's contract is that an ignored `#inline` says so. `noff` is the user's name `f`.
# CHANGELOG [6.7.14]
fn _inl_async_warn(S, noff): i64 {
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": #inline ignored: async fn '", 29);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' runs through its Future\n", 26);
    _err_excerpt(S);
    return 0;
}
# ⛔ 6.6.17 (a9) — an f64 / f32 parameter's slot tag, and the same tag for the INLINE replay. The
# replay re-registers a parameter by name with the type GFIPT recorded, which carried vector
# descriptors only, so an inlined `x: f64` was an untyped word: `#inline fn d(x: f64) { return x
# + x; }` added 1.5's bits as integers, and so did every one-statement generic instance at T = f64
# (`x: T` was untyped there too, see the parameter loop). Field `0x8001` / `0x8002` in the pack is
# f64 / f32 (`_ipt_sltype`); a vector's field is its descriptor + 1 (<= 256). CHANGELOG [6.6.17]
fn _param_float(S, li, pc, flt, pack): i64 {
    if (flt == 0) { return pack; }
    SLTYPE(S, li, flt);
    var f = 0x8001;
    if (flt == F32_TYID) { f = 0x8002; }
    if (pc == 0) { return pack | f; }
    if (pc == 1) { return pack | (f << 16); }
    return pack;
}
# The return of the call `IDENT(` / `IDENT<..>(` at the cursor to fi: FINDFN's entry's, or for a
# generic the INSTANCE's the call reaches — an f64 (`gid(gid(h))`, 6.7.9) or a struct (6.7.11:
# `g(mk1(p))` bound T to `mk1`'s base return, the generic `Box`, and was refused against the real
# `Box<Pt>`; `g(id(p))` bound i64). Asked of the instance whatever the base records, as `_gsc_call`
# does: a base parsed below the call has no `: T` return yet (0). A narrow scalar instance keeps i64.
# 6.7.14: `ptr` 1 (a `p: *T` carrier, `_infer_conc_at`) — and a `: *S` return binds S (`_ic_rps`).
fn _ic_call_rs(S, fi, ptr): i64 {
    var r = GFRS(S, fi);
    if (_MONOMORPH_OK == 0) { return _ic_rps(S, fi, r, ptr); }
    if (GFTP(S, fi) == 0) { return _ic_rps(S, fi, r, ptr); }
    if (r < 0) { if (r != 0 - 8) { return r; } }   # a declared scalar / vector return: the instance's too
    var ifi = _gen_call_inst(S, GTI(S));
    if (ifi < 0) { return r; }
    if (ptr == 1) { if (_fn_ret_ps(ifi) > 0) { return _ic_rps(S, ifi, r, 1); } }   # 6.7.15: a scalar pointee too
    var ir = GFRS(S, ifi);
    if (ir == 0 - 9) { return ir; }
    if (ir > 0) { return ir; }
    return r;
}
# The struct fn fi's `: *S` return points at (`_fn_rpsid`) when `ptr` is 1 — 6.7.15 (D11): a `: *i32` / `: *f64`
# return's scalar (`_ic_pscalar` of its step word) — else `r` (fi's own return). CHANGELOG [6.7.14]
fn _ic_rps(S, fi, r, ptr): i64 {
    if (ptr == 0) { return r; }
    if (_fn_rpsid != 0) {
        var ps = L64(_fn_rpsid + fi * 8);
        if (ps > 0) { return ps; }
    }
    var w = _fn_ret_ps(fi);
    if (w > 0) { return _ic_pscalar(w); }
    return r;
}
# The fn the call at token ti (`name(` / `name<..>(`) reaches — a generic's instance (`_pair_gen_inst`,
# instantiating it), else FINDFN's entry. A peek inside another call's inference: the inner resolve's
# own `_gi_sc` is not that inference's, and is put back; the cursor sits on the inner call meanwhile,
# so a refusal its instantiation reports (a bound) names that call, not the outer one. CHANGELOG [6.7.11]
fn _gen_call_inst(S, ti): i64 {
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return fi; }
    if (_MONOMORPH_OK == 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    var sv = _gi_sc;
    var st = GTI(S);
    STI(S, ti);
    var ifi = _pair_gen_inst(S, ti);
    STI(S, st);
    _gi_sc = sv;
    return ifi;
}
# 1 = the IDENT at the cursor opens a call: `name(`, or a generic's resolvable `name<..>(` (`_gcall_open`).
fn _ic_is_call(S): i64 {
    var nt = TOKTYP(S, GTI(S) + 1);
    if (nt == 10) { return 1; }
    if (nt != 19) { return 0; }
    if (_gcall_open(S, GTI(S)) < 0) { return 0; }
    return 1;
}
# A float literal at the cursor: f64 when it is the whole argument (a `,` or the `)` follows).
fn _ic_flit(S): i64 {
    var nt = TOKTYP(S, GTI(S) + 1);
    if (nt == 31 || nt == 11) { return 0 - 9; }
    return 0 - 8;
}
fn _is_ptr_param(S, li): i64 {
    if (li < 0) { return 0; }
    if (li >= _cur_fn_pslots) { return 0; }
    return GLPTRP(S, li);
}
# 6.6.10: a struct GLOBAL argument binds its struct like a struct local does. GVTYPE alone is
# ambiguous (a narrow scalar global stores its WIDTH there, 1..7); a struct global is the one
# with a recorded layout mode (GVPM 1 or 2, 6.6.5). A PEEK: `_findvar_core`, not FINDVAR, whose
# visibility report belongs to the argument's own parse. 6.7.14: through `p: *T` (`ptr` 1) a `*S` global binds S.
fn _infer_conc_global(S, noff, ptr): i64 {
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0 - 8; }
    if (ptr == 1) {
        if (_gv_ptr_sid(S, vi) > 0) { return _gv_ptr_sid(S, vi); }
        if (_gv_ptr_word(S, vi) > 0) { return _ic_pscalar(_gv_ptr_word(S, vi)); }   # 6.7.15 (D11): a `*i32` global
    }
    if (GVTYPE(S, vi) == F64_TYID) { return 0 - 9; }   # 6.7.9: an f64 global binds f64
    if (GVPM(S, vi) == 0) { return 0 - 8; }
    var t = GVTYPE(S, vi);
    if (t > 0) { return t; }
    return 0 - 8;
}

# v6.3.9 (F-fns): populate the active T->concrete binding for a generic call.
# Unpacks the callee's packed tparam names (GFTP) and binds tparam i <- inf_i (the
# positional inference: param_i is type tparam_i). Caller _tp_clear()s after the
# instantiation/replay. No-op when the callee has no tparams.
fn _bind_generic_call(S, fi, inf0, inf1): i64 {
    var _bg = GFTP(S, fi);
    if (_bg == 0) { return 0; }
    var _bg0 = _bg & 0xFFFFFFFF;
    if (_bg0 != 0) { _tp_bind(S, 0, _bg0 - 1, inf0); }
    var _bg1 = (_bg >> 32) & 0xFFFFFFFF;
    if (_bg1 != 0) { _tp_bind(S, 1, _bg1 - 1, inf1); }
    return 0;
}

# ⛔ 6.6.17 (a3) — the binding an INLINE replay of generic fn `fi` runs under. An instance
# (`szof$i16`, `sv$i8`) is a separate fn whose body tokens are the base's, so its replay must bind
# T to the instance's OWN type arguments (recorded at instantiation, `SFIC`); it bound the call's
# inferred ones, which an explicit `f<i16>(..)` never sets (-8, i64). A one-statement generic
# body is inlinable, so `return sizeof(T);` read 8 and `var y: T` was an i64 whenever the call
# sat inside a fn — and a generic forwarding its T (`return sv<T>(x);`) lost it. CHANGELOG [6.6.17]
fn _bind_inl_generic(S, fi, inf0, inf1): i64 {
    var c0 = GFIC(S, fi, 0);
    if (c0 != 0) { return _bind_generic_call(S, fi, c0, GFIC(S, fi, 1)); }
    return _bind_generic_call(S, fi, inf0, inf1);
}

# v6.3.9 (F-fns): is `noff` one of fn `fi`'s captured type-params? Used at the
# definition to accept a `: T` return type (T isn't a concrete type, but it IS a
# valid generic return) instead of erroring.
fn _is_tparam_of(S, fi, noff): i64 {
    var _it = GFTP(S, fi);
    if (_it == 0) { return 0; }
    var _it0 = _it & 0xFFFFFFFF;
    if (_it0 != 0) { if (noff == _it0 - 1) { return 1; } }
    var _it1 = (_it >> 32) & 0xFFFFFFFF;
    if (_it1 != 0) { if (noff == _it1 - 1) { return 1; } }
    return 0;
}

# v6.5.69 — does this fn body contain an `await`? Token lookahead over the body's brace
# span, restoring the cursor. Same shape as `_body_has_defer` below.
#
# ⛔ THIS SELECTOR IS LOAD-BEARING, NOT AN OPTIMISATION. The coroutine transform moves a
# body's locals into a heap frame and treats parameter 0 as the frame base. Applying it to
# EVERY `async fn` would break the ones that already work: `tests/fixtures/async/
# async_closure_generic.cyr` has `async fn compute(n)` whose body contains no `await` at all
# — it is awaited by its CALLER — so its parameter `n` would be read as a frame pointer.
# An `async fn` with no suspend point in its body keeps exactly the v6.3.11
# deferred-then-forced semantics it has today.
# v6.5.70 — the same question asked from the SIGNATURE rather than the body: scan forward to
# the body's opening brace, then over its span. Needed because a coroutine must reserve stack
# slot 0 for its frame base BEFORE its parameters are allocated slots, and the parameters are
# parsed first.
fn _fn_body_has_await_ahead(S): i64 {
    var _sv = GTI(S);
    var _g = 0;
    while (PEEKT(S) != 13) {
        if (PEEKT(S) == 12) { STI(S, _sv); return 0; }
        if (_g > 8192) { STI(S, _sv); return 0; }
        STI(S, GTI(S) + 1);
        _g = _g + 1;
    }
    STI(S, GTI(S) + 1);
    var _r = _body_has_await(S);
    STI(S, _sv);
    return _r;
}
# 6.7.9 — reserve a coroutine's slot 0 (SELF, homed by the prologue) as an ANONYMOUS slot. The
# local tables are not cleared between fns, so reserving it by count alone (`SFLC(S, 1)`) left the
# previous fn's local 0 on it: its NAME resolved to SELF inside the coroutine (a global of that name
# read the frame's address, a local of that name was a "duplicate variable"), and its depth word's
# flag bits and its type reached the slot walkers (`_inl_param_why` named a `*T` / struct parameter
# the coroutine does not have). Name -1, depth word and type 0, as every anonymous slot; the slice
# width is trusted only behind the depth word's bit 62 and the float flag is cleared by SFLC.
# Gate: tests/gates/frontend/coroutine_fnptr_and_completion.sh rows N. CHANGELOG [6.7.9]
fn _coro_slot0_reserve(S): i64 {
    S64(S + 0x5D9D000, 0 - 1);
    SLDEP(S, 0, 0);
    SLTYPE(S, 0, 0);
    SFLC(S, 1);
    return 0;
}

fn _body_has_await(S): i64 {
    var _sv = GTI(S);
    var _bd = 1;
    var _found = 0;
    while (_bd > 0) {
        var _t = PEEKT(S);
        if (_t == 12) { _bd = 0; }                   # EOF guard
        elif (_t == 13) { _bd = _bd + 1; STI(S, GTI(S) + 1); }
        elif (_t == 14) { _bd = _bd - 1; STI(S, GTI(S) + 1); }
        elif (_t == 135) { _found = 1; STI(S, GTI(S) + 1); }
        else { STI(S, GTI(S) + 1); }
    }
    STI(S, _sv);
    return _found;
}

# 6.6.7 — does the fn body starting at the cursor (just past its `{`) contain a `defer` (106)
# or a `secret var` (108) ANYWHERE? Decides that its `return f(..);` never tail-calls
# (`_tc_frame_divert`). ⚠ Lexical over the whole brace range, so a defer inside a nested closure
# literal counts too — that costs the enclosing fn its tail calls, never correctness.
fn _body_has_defer(S): i64 {
    var i = GTI(S);
    var n = GTCNT(S);
    var bd = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0; }                   # EOF guard
        if (t == 13) { bd = bd + 1; }
        if (t == 14) { bd = bd - 1; if (bd == 0) { return 0; } }
        if (t == 106 || t == 108) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ⛔ 6.6.10 — A GENERIC THAT USES T AS A STRUCT HAS NO SCALAR INSTANCE, AND EVERY CALL SITE HAS TO
# KNOW IT. `fn g<T>(p: T) { .. p.y .. }` has no valid i64 form, so its base (the i64 instance) is
# emitted as a `rax = 0` dead stub (v6.3.39 B3). That decision was made only WHILE the base was
# being emitted and recorded nowhere, so `g<i64>(5)`, `g(5)`, `return g(5);`, `outer<i64>(5)`
# forwarding to it, and `&g` all reached the stub and returned 0 with no diagnostic — and a body
# small enough to inline gave a misleading "no struct type in scope for 'p'" instead.
#
# The facts are now recorded per fn (GFGM, util.cyr) in PASS 1, BY NAME over the tokens, so a call
# preceding the definition asks the same question as one following it:
#   _gen_record  a generic's T-typed parameters (and which parameter carries each type parameter,
#                for inference) plus whether a T-typed name — a parameter OR a `var x: T` local —
#                is used as a struct (`x.f`; `x..y` is a range, not a field).
#   _gen_close   the transitive half: a generic that forwards a T-typed value (`g(p)`) or T itself
#                (`g<T>(p)`) into a generic with a stub base has a stub base too. Iterated to a
#                fixpoint, so the order the two are defined in does not matter.
# ⚠ The scan is lexical and so approximate. It can only err toward MORE stubs, and a stub is
# refused loudly at every scalar call — never the other way round, which was the silent bug.
# CHANGELOG [6.6.10]
var _gsn = 0;           # the T-typed names of the fn being scanned (params, then `var x: T`)
var _gsn_n = 0;
var _gs_at = 0;         # _gs_params: the token just past the parameter list
var _gs_open = 0;       # _gs_params: its `(` (a struct carrier records G's name as an offset from it)
var _gi_sc = 0;         # _gen_infer_sc: a struct carrier bound T to a scalar other than i64 (6.7.9: or f64 did)
var _gm_gen = 0;        # bumped on every record, so the closure below knows to recompute
var _gm_closed = 0 - 1;

# ⛔ 6.7.14 — THE STUB SCAN'S PER-FN TABLES GROW: `_gsn` (the T-typed names), `_gcr` (the struct
# carriers) and `_bnr_tab` (the bounded receivers) held 64 entries and dropped the 65th without a word,
# so every later name, carrier or receiver of that generic was invisible to the scan and its use failed to
# parse ("no struct type in scope for 'z'", "expected ';', got '.'"). A full table is copied into one
# twice its size; they are alloc'd, so no heap region moves. CHANGELOG [6.7.14]
var _gsn_cap = 0;
var _gcr_cap = 0;
# The `words` 8-byte words at `tab`, copied into a table of twice as many; the new table.
fn _tab_grow(tab, words): i64 {
    var t = alloc(words * 16);
    _tab_copy(t, tab, words);
    return t;
}
fn _gsn_add(noff): i64 {
    if (_gsn == 0) { _gsn = alloc(64 * 8); _gsn_cap = 64; }
    if (_gsn_n >= _gsn_cap) { _gsn = _tab_grow(_gsn, _gsn_cap); _gsn_cap = _gsn_cap * 2; }
    store64(_gsn + _gsn_n * 8, noff);
    _gsn_n = _gsn_n + 1;
    return 0;
}
fn _gsn_has(noff): i64 {
    var i = 0;
    while (i < _gsn_n) {
        if (load64(_gsn + i * 8) == noff) { return 1; }
        i = i + 1;
    }
    return 0;
}
# ⛔ 6.7.11 — THE STRUCT CARRIERS of the fn being scanned: a parameter or a `var x` typed `G<.., T, ..>` /
# `*G<.., T, ..>` (T one of the fn's type parameters, a WHOLE argument at depth 1), one entry per slot
# T takes: (name, G's name, slot). `fn gy<T>(b: Box<T>) { return b.v.y; }` reads `b.v` — Box's `v: T` —
# as a struct, so it has no i64 instance; the scan saw only T-typed NAMES, so its base was parsed with
# `b.v` an i64 and the definition failed ("expected ';', got '.'"), called or not (`_gs_cfield`).
var _gcr = 0;
var _gcr_n = 0;
fn _gcr_add(noff, gnoff, slot): i64 {
    if (_gcr == 0) { _gcr = alloc(64 * 24); _gcr_cap = 64; }
    if (_gcr_n >= _gcr_cap) { _gcr = _tab_grow(_gcr, _gcr_cap * 3); _gcr_cap = _gcr_cap * 2; }
    store64(_gcr + _gcr_n * 24, noff);
    store64(_gcr + _gcr_n * 24 + 8, gnoff);
    store64(_gcr + _gcr_n * 24 + 16, slot);
    _gcr_n = _gcr_n + 1;
    return 0;
}
# 1 = `noff` is a struct carrier of the fn being scanned.
fn _gcr_has(noff): i64 {
    var e = 0;
    while (e < _gcr_n) {
        if (load64(_gcr + e * 24) == noff) { return 1; }
        e = e + 1;
    }
    return 0;
}
# 6.7.14: `_bbs_fwd_bad`'s scan of fi (mode 2) runs on its own tables, swapped in and back out, so a scan
# in progress keeps its own (`_bnd_base_bad` is called from the call paths, not from a scan, today).
fn _bbf_scan(S, fi): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    _bbf_swap();
    _gs_params(S, fi, o);
    var b = _gs_body_open(S, _gs_at);
    if (b >= 0) { _gs_scan(S, fi, b, 2); }
    _bbf_swap();
    return 0;
}
fn _bbf_swap(): i64 {
    if (_bbf_t == 0) { _bbf_t = alloc(64); var z = 0; while (z < 8) { S64(_bbf_t + z * 8, 0); z = z + 1; } }
    var a = _gsn; _gsn = L64(_bbf_t); S64(_bbf_t, a);
    a = _gsn_n; _gsn_n = L64(_bbf_t + 8); S64(_bbf_t + 8, a);
    a = _gsn_cap; _gsn_cap = L64(_bbf_t + 16); S64(_bbf_t + 16, a);
    a = _gcr; _gcr = L64(_bbf_t + 24); S64(_bbf_t + 24, a);
    a = _gcr_n; _gcr_n = L64(_bbf_t + 32); S64(_bbf_t + 32, a);
    a = _gcr_cap; _gcr_cap = L64(_bbf_t + 40); S64(_bbf_t + 40, a);
    a = _gs_open; _gs_open = L64(_bbf_t + 48); S64(_bbf_t + 48, a);
    a = _gs_at; _gs_at = L64(_bbf_t + 56); S64(_bbf_t + 56, a);
    return 0;
}
# A carrier `name: [*]G<..>` (token ti on G's name): its entries, one per slot a type parameter of fi
# takes whole.
fn _gcr_note(S, fi, noff, ti): i64 {
    var j = ti + 2;
    var slot = 0;
    var d = 1;
    var n = GTCNT(S);
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 12 || t == 10 || t == 11 || t == 13 || t == 5) { return 0; }
        if (d == 1) { if (_gs_targ_whole(S, j) == 1) { if (_is_tparam_of(S, fi, TOKVAL(S, j)) == 1) {
                    _gcr_add(noff, TOKVAL(S, ti), slot);
                } } }
        if (t == 31) { if (d == 1) { slot = slot + 1; } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return 0; }
        j = j + 1;
    }
    return 0;
}
# Mode 0 at `x.f.g` (token i on x): 1 when x is a carrier and G's field f is declared with G's own type
# parameter in a slot the carrier gives T (`f: T` / `f: *T`) — a struct use of T, as `t.g` on a `t: T`
# is. One hop: `b.inner.v.y` through a field typed `Box<T>` is not followed (bind `var t: T = b.inner.v;`).
fn _gs_cfield(S, i): i64 {
    if (_gcr_n == 0) { return 0; }
    if (TOKTYP(S, i + 2) != 2) { return 0; }
    if (TOKTYP(S, i + 3) != 41) { return 0; }
    if (TOKTYP(S, i + 4) != 2) { return 0; }
    var noff = TOKVAL(S, i);
    var e = 0;
    while (e < _gcr_n) {
        if (load64(_gcr + e * 24) == noff) {
            if (_gs_gfield_tp(S, load64(_gcr + e * 24 + 8), load64(_gcr + e * 24 + 16), TOKVAL(S, i + 2)) == 1) { return 1; }
        }
        e = e + 1;
    }
    return 0;
}
# 1 = generic struct G's field `fnoff` is declared `fnoff: P` / `fnoff: *P`, P G's type parameter in
# `slot`. G's definition is read from the tokens: pass 1 records a generic before a struct declared
# below it is registered (`_gs_gdef`).
fn _gs_gfield_tp(S, gnoff, slot, fnoff): i64 {
    if (_gs_gfield_at(S, gnoff, slot, fnoff) >= 0) { return 1; }
    return 0;
}
# ... the token of that field's type (its `*` for `fnoff: *P`), or -1 (6.7.14, `_bnd_fslot`).
fn _gs_gfield_at(S, gnoff, slot, fnoff): i64 {
    var lt = _gs_gdef(S, gnoff);
    if (lt < 0) { return 0 - 1; }
    var tpn = _gs_gtp(S, lt, slot);
    if (tpn < 0) { return 0 - 1; }
    var n = GTCNT(S);
    var j = lt;
    while (j < n) {
        var t0 = TOKTYP(S, j);
        if (t0 == 13) { break; }
        if (t0 == 5 || t0 == 12) { return 0 - 1; }
        j = j + 1;
    }
    var d = 0;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 12) { return 0 - 1; }
        if (t == 13) { d = d + 1; }
        if (t == 14) { d = d - 1; if (d == 0) { return 0 - 1; } }
        if (d == 1) { if (t == 2) { if (TOKTYP(S, j + 1) == 49) { if (STREQ(S, TOKVAL(S, j), fnoff) == 1) {
                        if (_gs_tok_names(S, j + 2, tpn) == 1) { return j + 2; }
                        return 0 - 1;
                    } } } }
        j = j + 1;
    }
    return 0 - 1;
}
# 6.7.14: mode 0 at `x.f.m(` (token i on x): 1 = a bounded site was recorded at m on a carrier's T field
# (`_bnd_fsite`) — a trait use, as the name site `t.m(` is.
fn _gs_bfield(S, i): i64 {
    if (_bs_n == 0) { return 0; }
    if (TOKTYP(S, i + 3) != 41) { return 0; }
    if (TOKTYP(S, i + 5) != 10) { return 0; }
    var b = _bs_find(S, i + 4);
    if (b < 0) { return 0; }
    if (L64(_bs_tab + b * 32 + 8) < 0) { return 0; }
    if (L64(_bs_tab + b * 32 + 24) != 0) { return 0; }
    return 1;
}
# 1 = the type at token a (past a `*`) is the bare name tpn.
fn _gs_tok_names(S, a, tpn): i64 {
    if (TOKTYP(S, a) == 8) { a = a + 1; }
    if (TOKTYP(S, a) != 2) { return 0; }
    if (TOKTYP(S, a + 1) == 19) { return 0; }
    return STREQ(S, TOKVAL(S, a), tpn);
}
# The `<` of generic struct G's definition (`struct G<`), or -1: its recorded def-start when pass 1
# has registered it, else found in the tokens.
fn _gs_gdef(S, gnoff): i64 {
    var g = FINDSTRUCT(S, gnoff);
    if (g > 0) {
        var ds = GSDS(S, g - 1);
        if (ds > 0) { if (TOKTYP(S, ds + 1) == 19) { return ds + 1; } }
    }
    var n = GTCNT(S);
    var j = 0;
    while (j < n) {
        if (TOKTYP(S, j) == 40) { if (TOKTYP(S, j + 1) == 2) { if (TOKTYP(S, j + 2) == 19) {
                    if (STREQ(S, TOKVAL(S, j + 1), gnoff) == 1) { return j + 2; }
                } } }
        j = j + 1;
    }
    return 0 - 1;
}
# The name of the type parameter in `slot` of the list whose `<` is token lt, or -1.
fn _gs_gtp(S, lt, slot): i64 {
    var j = lt + 1;
    var k = 0;
    var n = GTCNT(S);
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 2) { if (k == slot) { if (TOKTYP(S, j - 1) == 19 || TOKTYP(S, j - 1) == 31) { return TOKVAL(S, j); } } }
        if (t == 31) { k = k + 1; }
        if (t == 20 || t == 39 || t == 152 || t == 13 || t == 12 || t == 5) { return 0 - 1; }
        j = j + 1;
    }
    return 0 - 1;
}

# The parameter list at token `open` (its `(`): collect the T-typed parameter names and return the
# 1-based index of the first parameter carrying each type parameter, packed as GFGM bits 8-23.
fn _gs_params(S, fi, open): i64 {
    _gsn_n = 0;
    _gcr_n = 0;
    _gs_open = open;
    var i = open + 1;
    var n = GTCNT(S);
    var pk = 0;
    var pc = 0;
    var d = 0;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { break; }
        if (d == 0) {
            if (t == 11) { i = i + 1; break; }
            if (t == 4) { i = _pl_dflt_end(S, i); continue; }   # 6.7.7: a default (`<` is an operator there)
            if (t == 31) { pc = pc + 1; }
            if (t == 2) { pk = _gs_param(S, fi, i, pc, pk); }
        }
        if (t == 10 || t == 19 || t == 28) { d = d + 1; }
        if (t == 11 || t == 20 || t == 29) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d < 0) { d = 0; }
        i = i + 1;
    }
    _gs_at = i;
    return pk;
}
# One `name: [*]Type` parameter at token i (parameter index pc).
fn _gs_param(S, fi, i, pc, pk): i64 {
    if (TOKTYP(S, i + 1) != 49) { return pk; }
    var ti = i + 2;
    if (TOKTYP(S, ti) == 8) { ti = ti + 1; }
    if (TOKTYP(S, ti) != 2) { return pk; }
    if (pc > 254) { return pk; }
    var tp = GFTP(S, fi);
    var tn = TOKVAL(S, ti);
    if (tn == (tp & 0xFFFFFFFF) - 1) {
        _gsn_add(TOKVAL(S, i));
        if ((pk & 0xFF00) == 0) { pk = pk | ((pc + 1) << 8); }
    }
    if (tn == ((tp >> 32) & 0xFFFFFFFF) - 1) {
        _gsn_add(TOKVAL(S, i));
        if ((pk & 0xFF0000) == 0) { pk = pk | ((pc + 1) << 16); }
    }
    if (TOKTYP(S, ti + 1) == 19) {
        _gcr_note(S, fi, TOKVAL(S, i), ti);   # 6.7.11: `b.v.y` (`_gs_cfield`)
        pk = _gs_carrier(S, fi, ti, pc, pk);   # 6.7.8: `G<..T..>`
    }
    return pk;
}
# ⛔ 6.7.8 — A STRUCT CARRIER. `fn gx<T>(b: Box<T>)` gave T no carrying parameter, so
# `gx(b)` with `b: Box<Pt>` inferred i64 and called the base (`b: Box`) — refused as a struct
# mismatch since 6.7.3; and through `*Box<T>`, `gx(&b)` compiled and read `b.n` at the base's
# offset (4 for 8). A parameter typed `G<.., T, ..>` or `*G<.., T, ..>` (cursor `ti` on G's name),
# T a WHOLE type argument at depth 1, now carries T through G's slot — both alike: a value or a
# pointer argument binds T (`_gsc_arg`; 6.7.9 the by-value carrier's pointer too).
# Per type parameter w, a 20-bit field of GFGM at bit 24 + 20w (bits 0-23 keep their meaning):
#   bits 0-7 the parameter's index + 1 · bit 8 T's slot in G · bit 9 unused (6.7.8's `*`) ·
#   bits 10-19 G's name token as an offset from the list's `(` — G is looked up when a call
#   infers, so a struct declared below the fn is found.
# The first carrying parameter wins, as for a direct carrier; a direct carrier wins over this one
# (`_gen_infer_tp`). `Box<Pair<T>>` (T nested) records nothing — its refusal stands.
# CHANGELOG [6.7.8]
fn _gs_carrier(S, fi, ti, pc, pk): i64 {
    var off = ti - _gs_open;
    if (off > 1023) { return pk; }
    var tp = GFTP(S, fi);
    var j = ti + 2;
    var slot = 0;
    var d = 1;
    var n = GTCNT(S);
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 12 || t == 10 || t == 11 || t == 13 || t == 5) { return pk; }
        if (d == 1) { if (slot < 2) { if (_gs_targ_whole(S, j) == 1) {
                    pk = _gs_sc_rec(pk, TOKVAL(S, j), tp, (pc + 1) | (slot << 8) | (off << 10));
                } } }
        if (t == 31) { if (d == 1) { slot = slot + 1; } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return pk; }
        j = j + 1;
    }
    return pk;
}
# 1 = the token at j is a whole type argument: a name between `<` / `,` and `,` / a closing `>`.
fn _gs_targ_whole(S, j): i64 {
    if (TOKTYP(S, j) != 2) { return 0; }
    var pt = TOKTYP(S, j - 1);
    if (pt != 19 && pt != 31) { return 0; }
    var nt = TOKTYP(S, j + 1);
    if (nt == 31 || nt == 20 || nt == 39 || nt == 152) { return 1; }
    return 0;
}
fn _gs_sc_rec(pk, tn, tp, f): i64 {
    if (tn == (tp & 0xFFFFFFFF) - 1) { if (((pk >> 24) & 255) == 0) { pk = pk | (f << 24); } }
    if (tn == ((tp >> 32) & 0xFFFFFFFF) - 1) { if (((pk >> 44) & 255) == 0) { pk = pk | (f << 44); } }
    return pk;
}
# From token i (past the parameter list) to the token after the body's `{`, or -1 (no body).
fn _gs_body_open(S, i): i64 {
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 13) { return i + 1; }
        if (t == 12 || t == 5) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
# Walk the body from token i (just past its `{`) to the matching `}`. mode 0: 1 iff a T-typed name
# is used as a struct. mode 1: 1 iff the body forwards a T-typed value, or T, to a stub generic.
# mode 2 (6.7.14): every generic the body forwards its T to, pushed for `_bbs_fwd_bad`; answers 0.
fn _gs_scan(S, fi, i, mode): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0; }
        if (t == 13) { d = d + 1; }
        if (t == 14) { d = d - 1; if (d == 0) { return 0; } }
        if (t == 3) { _gs_var(S, fi, i); }
        if (t == 2) { if (_gs_use(S, fi, i, mode) == 1) { return 1; } }
        i = i + 1;
    }
    return 0;
}
# `var x: T` / `var x: *T` at token i: x is T-typed from here on. 6.7.11: `var x: [*]G<..T..>` is a
# carrier (`_gcr_note`).
fn _gs_var(S, fi, i): i64 {
    if (TOKTYP(S, i + 1) != 2) { return 0; }
    if (TOKTYP(S, i + 2) != 49) { return 0; }
    var ti = i + 3;
    if (TOKTYP(S, ti) == 8) { ti = ti + 1; }
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (_is_tparam_of(S, fi, TOKVAL(S, ti)) == 1) { _gsn_add(TOKVAL(S, i + 1)); }
    if (TOKTYP(S, ti + 1) == 19) { _gcr_note(S, fi, TOKVAL(S, i + 1), ti); }
    return 0;
}
fn _gs_use(S, fi, i, mode): i64 {
    var nx = TOKTYP(S, i + 1);
    if (mode == 0) {
        if (nx != 41) { return 0; }
        if (TOKTYP(S, i + 2) == 41) { return 0; }
        # 6.7.1 (C3): a by-value bounded method call is a TRAIT use, never a struct use — whatever i64
        # implements. Whether the i64 base is valid is `_bnd_base_bad`'s judgment (the base skipped, a
        # scalar call refused naming i64); counting the site a struct use made the base the dead stub,
        # which has no scalar instance, so `gb(h)` / `gb<f64>(h)` with only `impl Show for f64` were
        # refused naming i64. CHANGELOG [6.7.11]
        if (_bs_n > 0) { if (TOKTYP(S, i + 3) == 10) {
                var bsi = _bs_find(S, i + 2);
                if (bsi >= 0) { if (L64(_bs_tab + bsi * 32 + 8) >= 0) { if (L64(_bs_tab + bsi * 32 + 24) == 0) { return 0; } } }
            } }
        if (_gsn_has(TOKVAL(S, i)) == 1) { return 1; }
        if (_gs_bfield(S, i) == 1) { return 0; }   # 6.7.14: `b.v.show()`, a bounded site, is a trait use
        return _gs_cfield(S, i);   # 6.7.11: `b.v.y` through a struct carrier
    }
    if (nx != 19 && nx != 10) { return 0; }
    if (_gs_mfwd(S, fi, i, mode) == 1) { return 1; }   # 6.7.11: `p.pick(t)` (6.7.14: `p.pick<T>(t)`)
    var cfi = FINDFN(S, TOKVAL(S, i));
    if (cfi < 0 || cfi == fi) { return 0; }
    if (GFTP(S, cfi) == 0) { return 0; }
    # 6.7.14: only a STUB callee makes the forwarder a stub; one whose base is bad only for its bound
    # (6.7.1 counted it too) makes the forwarder's base bad at i64 alone — `_bnd_base_bad`, mode 2.
    if (mode == 1) { if ((GFGM(S, cfi) & 3) == 0) { return 0; } }
    var f = 0;
    if (nx == 19) { f = _gs_targs_fwd(S, fi, i + 2); }
    else { f = _gs_fwd_any(S, fi, cfi, i + 1, 0); }
    if (mode == 2) { if (f == 1) { _bbf_push(cfi); } return 0; }
    return f;
}
# 1 iff the call to cfi whose `(` is at `open` passes fi's T: a bare T-typed name in a direct carrying
# position (`_gs_arg_named`), or a carrier in a struct-carrier position (`_gs_fwd_carr`, 6.7.14).
fn _gs_fwd_any(S, fi, cfi, open, mth): i64 {
    var m = GFGM(S, cfi);
    if (_gs_arg_named(S, cfi, open, (m >> 8) & 255, mth) == 1) { return 1; }
    if (_gs_arg_named(S, cfi, open, (m >> 16) & 255, mth) == 1) { return 1; }
    return _gs_fwd_carr(S, fi, cfi, open, mth);   # 6.7.14: `gx(b)`, `gx(mk1(x))`
}
# ⛔ 6.7.14 — A FORWARD THROUGH A STRUCT CARRIER. Mode 1 followed a T-typed name only in a callee's DIRECT
# carrying position, so a body passing its T inside a carrier into a stub `fn gx<T>(b: Box<T>)` — `gx(b)` with
# `b: Box<T>`, or `gx(mk1(x))` — kept an i64 base, whose `gx(..)` binds T = i64 and was refused at the
# definition, called or not. The callee's struct-carrier positions (GFGM bits 24 + 20w, low 8 bits = the
# parameter's index + 1, `_gs_carrier`) are followed too, given a whole argument that carries fi's T
# (`_gs_carries`). `mth` 1: a method call, whose list starts at parameter 1. CHANGELOG [6.7.14]
fn _gs_fwd_carr(S, fi, cfi, open, mth): i64 {
    var m = GFGM(S, cfi);
    if (_gs_arg_carries(S, fi, cfi, open, (m >> 24) & 255, mth) == 1) { return 1; }
    return _gs_arg_carries(S, fi, cfi, open, (m >> 44) & 255, mth);
}
fn _gs_arg_carries(S, fi, cfi, open, k, mth): i64 {
    if (k <= mth) { return 0; }
    var a = _call_arg_pk(S, cfi, open, k - 1, k - 1 - mth);
    if (a < 0) { return 0; }
    return _gs_carries(S, fi, a, 0);
}
# 1 iff the whole argument at token a carries fi's T: a struct carrier's name (`_gcr`), a T-typed name, or a
# whole generic call `g(..)` / `g<..>(..)` whose type-argument list names T or one of whose whole arguments is
# such an argument (8 deep). A T-typed name whole in the carrier position (`gx(x)`, `x: T`) carries T when T is
# itself a carrier instance (`outer(b)`, `b: Box<Pt>`), so the forwarder is a stub as `gx` is. CHANGELOG [6.7.15]
fn _gs_carries(S, fi, a, dep): i64 {
    if (dep > 8) { return 0; }
    if (TOKTYP(S, a) != 2) { return 0; }
    var nt = TOKTYP(S, a + 1);
    if (nt == 31 || nt == 11) {
        if (_gcr_has(TOKVAL(S, a)) == 1) { return 1; }
        return _gsn_has(TOKVAL(S, a));
    }
    if (nt != 10 && nt != 19) { return 0; }
    var g = FINDFN(S, TOKVAL(S, a));
    if (g < 0) { return 0; }
    if (GFTP(S, g) == 0) { return 0; }
    var o = a + 1;
    if (nt == 19) { o = _targs_end(S, a + 2) + 1; }
    if (TOKTYP(S, o) != 10) { return 0; }
    var ct = TOKTYP(S, _call_close(S, o) + 1);
    if (ct != 31 && ct != 11) { return 0; }   # the call is the whole argument
    if (nt == 19) { if (_gs_targs_fwd(S, fi, a + 2) == 1) { return 1; } }
    var q = o + 1;
    if (TOKTYP(S, q) == 11) { return 0; }
    var n = GTCNT(S);
    while (q < n) {
        if (_gs_carries(S, fi, q, dep + 1) == 1) { return 1; }
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0; }
        q = q + 1;
    }
    return 0;
}
# ⛔ 6.7.11 — mode 1 at a METHOD call `x.m(..)` (token i the method's name, x one name): a body that
# forwards a T-typed name into a stub generic METHOD (`p.pick(t)`, `self.pick(w)`) has a stub base too,
# as the free spelling `P_pick(p, t)` makes it. The method arm now refuses a scalar binding of a stub
# (`_mcall_gen`), so the forwarding generic's i64 base — emitted eagerly — was refused at its definition,
# however it was called. The callee is the parser's (`_meth_fn_at`) for x's struct, typed by scope from
# the tokens (`_tok_name_sid`; an untyped impl `self` by pass 1's GFISELF). CHANGELOG [6.7.11]
fn _gs_mfwd(S, fi, i, mode): i64 {
    var cfi = _gs_mcallee(S, fi, i);
    if (cfi < 0 || cfi == fi) { return 0; }
    if (GFTP(S, cfi) == 0) { return 0; }
    if (mode == 1) { if ((GFGM(S, cfi) & 3) == 0) { return 0; } }   # 6.7.14: a stub only (`_gs_use`)
    var f = 0;
    if (TOKTYP(S, i + 1) == 19) { f = _gs_targs_fwd(S, fi, i + 2); }   # 6.7.14 (D7 (a)): `p.pick<T>(t)`
    else { f = _gs_fwd_any(S, fi, cfi, i + 1, 1); }   # 6.7.14: and `p.pick(b)`, `b: Box<T>`
    if (mode == 2) { if (f == 1) { _bbf_push(cfi); } return 0; }
    return f;
}
# The fn a method call `x.m(` reaches, its name at token i, or -1. x is a single name, a field chain
# `h.p` / `h.q.p` or a call result `mk()` / `h.gp()` (`_gs_recv_sid`): a forwarder `h.p.pick(t)` /
# `mk().pick(t)` untyped here kept its i64 base, which met the scalar-binding refusal at its own
# definition, called or not (the 6.7.11 review; the free spelling `P_pick(h.p, t)` was a stub).
fn _gs_mcallee(S, fi, i): i64 {
    if (TOKTYP(S, i - 1) != 41) { return 0 - 1; }
    var a = GFDS(S, fi) - 1;
    if (a < 0) { return 0 - 1; }
    var sid = _gs_recv_sid(S, fi, a, i - 2, 0);
    if (sid <= 0) { return 0 - 1; }
    return _meth_fn_at(S, sid, TOKVAL(S, i), i);
}
# The struct the receiver ending at token r holds, from the tokens of fi's unit (its first token a), or
# 0: a single name by scope (`_tok_name_sid`; an untyped impl `self` by GFISELF), `x.f` through the
# field f that x's struct declares (`_gs_fld_sid`), or a call's result (`_gs_recv_call`). CHANGELOG [6.7.11]
fn _gs_recv_sid(S, fi, a, r, dep): i64 {
    if (dep > 32) { return 0; }
    var t = TOKTYP(S, r);
    if (t == 11) { return _gs_recv_call(S, fi, a, r, dep); }
    if (t != 2) { return 0; }
    if (TOKTYP(S, r - 1) == 41) {
        var bs = _gs_recv_sid(S, fi, a, r - 2, dep + 1);
        if (bs <= 0) { return 0; }
        return _gs_fld_sid(S, bs, TOKVAL(S, r));
    }
    var sid = _tok_name_sid(S, a, r, TOKVAL(S, r));
    if (sid == 0) { sid = _gs_iself(S, fi, a, r); }
    return sid;
}
# The struct field `noff` of struct sid holds: an inline struct field's type, a `*T` field's T, else 0
# (`_gsc_chain`'s hop).
fn _gs_fld_sid(S, sid, noff): i64 {
    var fx = FINDFIELD(S, sid - 1, noff);
    if (fx < 0) { return 0; }
    var ps = _fld_ptr_sid(S, sid - 1, fx);
    if (ps > 0) { return ps; }
    var ft = GETFTYPE(S, sid - 1, fx);
    if (ft > 0) { return ft; }
    return 0;
}
# The `)` at token r closes a call: `f(..)` or a method call `x.f(..)` (x typed as a receiver is); the
# struct the callee returns whatever it binds (`_gs_ret_sid`). Anything else (a parenthesised value, a
# subscript) 0.
fn _gs_recv_call(S, fi, a, r, dep): i64 {
    var o = _tok_open_back(S, r);
    if (o < 2) { return 0; }
    if (TOKTYP(S, o - 1) != 2) { return 0; }
    var cfi = 0 - 1;
    if (TOKTYP(S, o - 2) == 41) {
        var xs = _gs_recv_sid(S, fi, a, o - 3, dep + 1);
        if (xs <= 0) { return 0; }
        cfi = _meth_fn_at(S, xs, TOKVAL(S, o - 1), o - 1);
    } else { cfi = FINDFN(S, TOKVAL(S, o - 1)); }
    if (cfi < 0) { return 0; }
    return _gs_ret_sid(S, cfi);
}
# The struct every call of cfi returns: its declared struct return or a `: *S` return's S; for a
# generic only a plain `: S` whose S is no type parameter and not generic (a binding changes nothing).
fn _gs_ret_sid(S, cfi): i64 {
    if (GFTP(S, cfi) != 0) {
        if (_gen_ret_tp(S, cfi) >= 0) { return 0; }
        var o = _gen_def_open(S, cfi);
        if (o < 0) { return 0; }
        var c = _tok_close_paren(S, o);
        if (c < 0) { return 0; }
        if (TOKTYP(S, c + 1) != 49) { return 0; }
        if (TOKTYP(S, c + 2) != 2) { return 0; }
        if (TOKTYP(S, c + 3) != 13) { return 0; }   # `: S {` — no `<..>`, no `*`
        var gs = FINDSTRUCT(S, TOKVAL(S, c + 2));
        if (gs <= 0) { return 0; }
        if (GSTP(S, gs - 1) != 0) { return 0; }
        return gs;
    }
    var rs = GFRS(S, cfi);
    if (rs > 0) { return rs; }
    if (_fn_rpsid != 0) {
        var ps = L64(_fn_rpsid + cfi * 8);
        if (ps > 0) { return ps; }
    }
    return 0;
}
# The `(` matching the `)` at token r, or -1 (a brace or `;` first: a closure argument is not walked).
fn _tok_open_back(S, r): i64 {
    var d = 0;
    var k = r;
    while (k > 0) {
        var t = TOKTYP(S, k);
        if (t == 11) { d = d + 1; }
        elif (t == 10) {
            d = d - 1;
            if (d == 0) { return k; }
        }
        elif (t == 5 || t == 13 || t == 14) { return 0 - 1; }
        k = k - 1;
    }
    return 0 - 1;
}
# An untyped impl `self` (the first parameter, no annotation) at token r: its impl's struct.
fn _gs_iself(S, fi, a, r): i64 {
    if (_noff_is(S, TOKVAL(S, r), "self", 4) == 0) { return 0; }
    var d = _tok_name_decl(S, a, r, TOKVAL(S, r));
    if (d < 0) { return 0; }
    if (TOKTYP(S, d - 1) != 10) { return 0; }
    if (TOKTYP(S, d + 1) == 49) { return 0; }
    var t = GFISELF(S, fi);
    if (t == 0) { return 0; }
    return FINDSTRUCT(S, t - 1);
}
# `callee<...>(`: 1 iff a type argument names one of fi's own type parameters.
fn _gs_targs_fwd(S, fi, j): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 12 || t == 10 || t == 5) { return 0; }
        if (t == 2) { if (_is_tparam_of(S, fi, TOKVAL(S, j)) == 1) { return 1; } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return 0; }
        j = j + 1;
    }
    return 0;
}
# 1 iff the argument for parameter k-1 (k is 1-based; 0 = none) of the call to cfi whose `(` is at
# `open` is a bare T-typed name (6.7.7: by name too, `_call_arg_for`). `mth` 1: a method call, whose
# list starts at parameter 1 (6.7.11).
fn _gs_arg_named(S, cfi, open, k, mth): i64 {
    if (k <= mth) { return 0; }
    var a = _call_arg_pk(S, cfi, open, k - 1, k - 1 - mth);
    if (a < 0) { return 0; }
    if (TOKTYP(S, a) != 2) { return 0; }
    var nt = TOKTYP(S, a + 1);
    if (nt != 31 && nt != 11) { return 0; }
    return _gsn_has(TOKVAL(S, a));
}
# The first token of argument k (0-based) of the call whose `(` is at `open`, or -1. The arguments
# are stepped over by `_arg_next`: ⛔ 6.7.7 — this scan counted a closure's `|a, b|` comma, so in
# `gx(|a, b| a + b, p)` it read the closure's `b` as argument 1, inferred T from a scalar and refused
# the call. CHANGELOG [6.7.7]
fn _call_arg_start(S, open, k): i64 {
    var i = open + 1;
    if (TOKTYP(S, i) == 11) { return 0 - 1; }
    var c = 0;
    var n = GTCNT(S);
    while (i < n) {
        if (c == k) { return i; }
        i = _arg_next(S, i);
        if (TOKTYP(S, i) != 31) { return 0 - 1; }   # the call's `)`, or EOF
        i = i + 1;
        c = c + 1;
    }
    return 0 - 1;
}

# Pass 1 (`_prescan_fn_sig`, cursor on the `(`): record fi's GFGM word. Also the lazy path for a
# definition pass 1 never saw.
fn _gen_record(S, fi, open): i64 {
    var pk = _gs_params(S, fi, open);
    var b = _gs_body_open(S, _gs_at);
    var d = 0;
    if (b >= 0) { d = _gs_scan(S, fi, b, 0); }
    SFGM(S, fi, pk | 4 | d);
    _gm_gen = _gm_gen + 1;
    return 0;
}
# The `(` of fi's definition, from its recorded def-start.
fn _gen_def_open(S, fi): i64 {
    var i = GFDS(S, fi) - 1;
    if (i < 0) { return 0 - 1; }
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 10) { return i; }
        if (t == 12 || t == 13) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
fn _gen_forwards(S, fi): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    _gs_params(S, fi, o);
    var b = _gs_body_open(S, _gs_at);
    if (b < 0) { return 0; }
    return _gs_scan(S, fi, b, 1);
}
fn _gen_close(S): i64 {
    if (_gm_closed == _gm_gen) { return 0; }
    var ch = 1;
    while (ch == 1) {
        ch = 0;
        var fi = 0;
        var n = GFNC(S);
        while (fi < n) {
            var m = GFGM(S, fi);
            if ((m & 7) == 4) {
                if (_gen_forwards(S, fi) == 1) { SFGM(S, fi, m | 2); ch = 1; }
            }
            fi = fi + 1;
        }
    }
    _gm_closed = _gm_gen;
    return 0;
}
# 1 iff fi's name is a minted instance (`base$Pt`): '$' is never a source identifier byte.
fn _gen_is_inst(S, fi): i64 {
    var p = S + 0xEC00000 + L64(_fnt_names + fi * 8);
    var i = 0;
    while (load8(p + i) != 0) {
        if (load8(p + i) == 36) { return 1; }
        i = i + 1;
    }
    return 0;
}
# Nonzero iff fi is a generic whose base (every scalar binding) is the dead stub: 1 direct,
# 2 transitive. An instance is never a stub.
fn _gen_stub(S, fi): i64 {
    if (fi < 0) { return 0; }
    if (GFTP(S, fi) == 0) { return 0; }
    if ((GFGM(S, fi) & 4) == 0) {
        if (_gen_is_inst(S, fi) == 1) { return 0; }
        var o = _gen_def_open(S, fi);
        if (o >= 0) { _gen_record(S, fi, o); }
    }
    _gen_close(S);
    return GFGM(S, fi) & 3;
}
# ⛔ 6.7.15 — A GENERIC METHOD'S REFUSALS NAME IT AS THE CALL SPELLS IT. The refusals below printed the fn table's
# name, so `p.pick(5)` of a stub generic method was "generic 'P_pick' has no i64 ... instance" and `p.bm(3)` of a
# bounded one "generic 'P_bm': its type argument does not implement trait 'Show'", where every other call-site
# diagnostic names `P.pick` (6.7.14, `_fn_src_name`). `_gen_msp` is set while a call spelled as a method
# (`p.m(..)`, `p.m<..>(..)`) is judged — `_mcall_gen` / `_mcall_inst`, `_meth_xinst`, `_mcall_xquiet` — and
# `_gen_ident_err` then names the method `P.pick`; any other spelling is named as written (`P_pick(p, 9)` keeps
# `P_pick`, a free generic `g`). Cleared while an instance's body is parsed (`_instantiate_generic_fn`), whose own
# calls are judged by their own spelling. CHANGELOG [6.7.15]
var _gen_msp = 0;
# ERR_IDENT's "generic 'noff'<tail>['noff2']" for generic fi, which the site names `noff` — the method spelling
# while `_gen_msp` is set. Its identity is ERR_IDENT's on `noff`, never on the scratch the spelling is written at.
fn _gen_ident_err(S, fi, noff, tail, noff2): i64 {
    var msg = "generic ";
    if (_gen_msp == 0) { return ERR_IDENT(S, msg, noff, tail, noff2); }
    if (_fn_src_name(S, fi, noff) == noff) { return ERR_IDENT(S, msg, noff, tail, noff2); }
    if (_err_once(S, (((msg * 31 + noff) * 31 + tail) * 31 + noff2) * 8 + 3) == 0) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": generic '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));   # written after the head, which may use the scratch
    PRSTR("'");
    if (tail != 0) { PRSTR(tail); }
    if (noff2 >= 0) {
        PRSTR("'");
        PRSTR(S + 0xEC00000 + noff2);
        PRSTR("'");
    }
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    _panic = 1;
    return 0;
}
# The refusal, by name, for a scalar call / type argument / address of a stub generic fi (the site names it `noff`).
fn _refuse_gen_stub(S, fi, noff): i64 {
    _gen_ident_err(S, fi, noff, " has no i64 (or other scalar) instance: it uses its type parameter as a struct (a '.field' on a T-typed value, directly or in a generic it forwards T to) — pass a struct argument, or name a struct type argument", 0 - 1);
    return 0;
}
# `&g`: the address is the base's, so a stub base is refused like a scalar call.
fn _gen_addr_check(S, fi, noff): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (_bnd_base_bad(S, fi) == 1) { _refuse_bnd_base(S, fi, noff); return 0; }   # 6.7.1 (C3)
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, fi, noff); }
    return 0;
}

# ⛔ 6.7.14 — A `p: *T` PARAMETER BINDS WHAT ITS POINTER ARGUMENT POINTS AT; AN `x: T` ONE BINDS NO POINTER (the
# user's decision D8 (a), 2026-10-16). The argument at token a for fi's carrying parameter k (1-based): through
# `p: *T` a `*S` local, parameter, capture or global, a field declared `*S` reached through a chain (`w.p`,
# `wp.p`, `G.p`), a `: *S` call and `&G` / `&l` of a struct bind S — as a struct value already did (6.6.20) and
# as a `*Box<T>` carrier does (6.7.8). Only a `*S` LOCAL bound, through either shape: 6.6.17 gave it SLTYPE
# `0 - sid`, which read as a struct argument, so `gs(q)` with `var q: *S` bound S through `x: T` against the
# guide, while `gsz(&GS)`, `gsz(GP)`, `gsz(w.p)` and a `*S` parameter ran the i64 base (sizeof(T) 8). CHANGELOG [6.7.14]
# ⛔ 6.7.15 — THE TWO SPELLINGS A STRUCT CARRIER READS THROUGH (6.7.11, `_gsc_wrap` / `_gsc_deref`) BIND THROUGH A PLAIN
# `x: T` / `p: *T` TOO (the user's decision D12 (a), 2026-10-18): parentheses around the WHOLE argument carry what they
# wrap (`_pwrap_in`) — `gs((l))`, `gsz((p))`, `gsz((&GS))` — and through `x: T` a whole dereference of a `*S` is the
# struct value S (`_ic_deref`) — `gs(*p)`. They ran the i64 base (`sizeof(T)` 8 for a 24-byte S), as did a closure's
# captured struct (`_ic_cap`). A tuple literal binds nothing. CHANGELOG [6.7.15]
fn _ic_arg(S, fi, a, k): i64 {
    var ptr = _ic_ptr_param(S, fi, k - 1);
    a = _pwrap_in(S, a);
    if (a < 0) { return 0 - 8; }
    if (ptr == 1) {
        if (TOKTYP(S, a) == 2) { if (TOKTYP(S, a + 1) == 41) { return _ic_chain(S, a); } }
    }
    if (ptr == 0) { if (TOKTYP(S, a) == 8) { return _ic_deref(S, a); } }
    if (_gen_arg_whole(S, a) == 0) { return 0 - 8; }
    var sv = GTI(S);
    STI(S, a);
    var c = _infer_conc_at(S, ptr);
    STI(S, sv);
    return c;
}
# A whole dereference `*E` (its `*` at token a, the whole argument) through `x: T`: the struct E points at, as a
# struct carrier reads it (`_gsc_deref`: a `*S` name, field, call, `p + n`, `*&l`); i64 otherwise. CHANGELOG [6.7.15]
fn _ic_deref(S, a): i64 {
    var s = _gsc_deref(S, a);
    if (s > 0) { return s; }
    return 0 - 8;
}
# A field chain `w.p` (the whole argument at token a) through `p: *T`: what its leaf field declared `*S` points at
# (`_gsc_chain`) — 6.7.15 (D11): a leaf declared `*i32` / `*f64` its scalar (`_ic_pscalar` of the leaf's step word,
# `_ic_pp_chain`); i64 otherwise (an inline field, no whole chain). CHANGELOG [6.7.14]
fn _ic_chain(S, a): i64 {
    var cs = _gsc_chain(S, a);
    if (cs > 0) { return cs; }
    return _ic_pscalar(_ic_pp_chain(S, a));
}
# 1 = parameter k (0-based) of generic fi is declared `*T` (`_pptr_param`), with `_dps_param`'s cursor put back.
fn _ic_ptr_param(S, fi, k): i64 {
    var s0 = _dps_ts; var s1 = _dps_te; var s2 = _dps_va; var s3 = _dps_nm;
    var r = _pptr_param(S, fi, k);
    _dps_ts = s0; _dps_te = s1; _dps_va = s2; _dps_nm = s3;
    return r;
}
# Infer the concrete type of type parameter `which` (0|1) for a call to generic fi whose `(` is
# at token `open`, from the argument in the parameter position that carries it. A generic pass 1
# never recorded binds positionally, as before. No carrying parameter -> i64.
fn _gen_infer_tp(S, fi, open, which): i64 {
    var m = GFGM(S, fi);
    var k = which + 1;
    if ((m & 4) != 0) { k = (m >> (8 + which * 8)) & 255; }
    if (k == 0) { return _gen_infer_ind(S, fi, open, which, 0); }   # 6.7.8: a struct carrier; 6.7.14: a `**T`
    var a = _call_arg_for(S, fi, open, k - 1);   # 6.7.7: or the argument naming it
    if (a < 0) { return 0 - 8; }
    var c = _ic_arg(S, fi, a, k);
    if (_tup_is(S, c) == 1) { return _gen_tup_bind(S, fi, a, c); }
    if (c == 0 - 9) { _gi_sc = 1; }   # 6.7.9: an f64 binding calls its instance, as `g<f64>(..)` does
    return c;
}
# ⛔ 6.7.8 — T through its STRUCT CARRIER (`_gs_carrier`; T has no direct one). The WHOLE
# argument in the carrying position must be (or point at) an instance of the parameter's G
# (`_gsc_arg`), and T is that instance's type argument in T's slot (`_sinst_conc`): `gx(b)` with
# `b: Box<Pt>` binds Pt and calls `gx$Pt`, exactly as `gx<Pt>(b)` does. Anything else infers i64
# — today's base, and its refusal. A scalar other than i64 (`b: Box<i32>`) marks `_gi_sc`, so the
# call instantiates `gx$i32` as `gx<i32>(b)` does (its base takes a `Box`: a different layout).
# `mth` 1: a method call, whose list starts at parameter 1 (`_mcall_infer`, 6.7.11). CHANGELOG [6.7.8]
fn _gen_infer_sc(S, fi, open, f, mth): i64 {
    var k = f & 255;
    if (k <= mth) { return 0 - 8; }
    var a = _call_arg_pk(S, fi, open, k - 1, k - 1 - mth);
    if (a < 0) { return 0 - 8; }
    var c = _gsc_arg(S, a);
    var r = _sinst_conc(S, c, _gsc_g(S, fi, f >> 10), (f >> 8) & 1);
    if (r == 0) { return 0 - 8; }
    if (r < 0) { if (r != 0 - 8) { _gi_sc = 1; } }
    return r;
}
# 1 = the inference just run bound a struct carrier's T to a scalar other than i64, and fi has a
# scalar instance (a stub generic keeps its refusal, as `gs<i32>(b)` does): the call instantiates.
fn _gen_sc_inst(S, fi): i64 {
    if (_gi_sc == 0) { return 0; }
    if (_gen_stub(S, fi) != 0) { return 0; }
    return 1;
}
# The generic struct G a struct carrier names: its name token is `off` past fi's `(`. 0 when it is
# not a generic struct.
fn _gsc_g(S, fi, off): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (TOKTYP(S, o + off) != 2) { return 0; }
    var g = FINDSTRUCT(S, TOKVAL(S, o + off));
    if (g <= 0) { return 0; }
    if (GSTP(S, g - 1) == 0) { return 0; }
    return g;
}
# The struct a struct carrier's WHOLE argument at token a holds or points at, 0 when none (the
# call then infers i64): a G<X> VALUE — a name, a struct global, a call returning it — or what a
# pointer POINTS AT — `&b` of an inline struct or a by-value parameter, a `*G<X>` name, field chain
# or `*G<X>`-returning call. Both carriers read it alike: `b: *G<T>` is passed a G<X> value's
# address (6.6.20), and `b: G<T>` an address-passed G<X>'s pointer as the struct (a typed pointer
# converts, 6.7.3) — so `gx(&b)` / `gx(bp)` call `gx$Pt`, as `gx<Pt>(&b)` does. 6.7.8 bound nothing
# for the by-value carrier's pointer: the i64 base ran on `Box<i64>`'s layout (b.n read as b.v.y,
# 4 for 8). A GENERIC call is typed by the instance it reaches (`_gsc_call`), explicit or inferred.
# CHANGELOG [6.7.8], [6.7.9]
fn _gsc_arg(S, a): i64 {
    var t = TOKTYP(S, a);
    if (t == 10) { return _gsc_wrap(S, a); }    # 6.7.11: `gw((w))`
    if (t == 8) { return _gsc_deref(S, a); }    # 6.7.11: `gw(*wp)`
    if (t == 27) {
        if (_gsc_name_end(S, a + 1) == 0) { return 0; }
        return _gsc_addr_of(S, TOKVAL(S, a + 1));
    }
    if (t != 2) { return 0; }
    var nt = TOKTYP(S, a + 1);
    if (nt == 10 || nt == 19) { return _gsc_call(S, a); }   # 6.7.11: + `gx(mk1<Pt>(p))`
    if (nt == 41) { return _gsc_chain(S, a); }
    if (_gsc_name_end(S, a) == 0) { return 0; }
    return _gsc_name(S, TOKVAL(S, a));
}
# ⛔ 6.7.11 — the two spellings the by-value struct check reads THROUGH bind T as their plain ones do:
# parentheses wrapping the WHOLE argument (`_ess_wrap`) carry what they wrap — `gw((w))`, `gw((mkw(6)))`
# — and a whole dereference (`_ess_deref`) what its pointer points at, as `gw(wp)` binds it — `gw(*wp)`.
# Both reached the base, whose `W1` the instance `W1<i32>` is not: refused "a different struct type"
# (through 6.7.10 at 8 B or less they compiled and read the struct with the base's layout). A tuple
# literal (`gw((w, 3))`) and an operator's operand (`gw(*wp + 1)`) bind nothing. The pair scans read
# both alike (`_tok_gen_sc_sid`), or a `?` above a wrapper typed through them misses its pair.
# CHANGELOG [6.7.11]
fn _gsc_wrap(S, a): i64 {
    var p = _pwrap_in(S, a);
    if (p < 0) { return 0; }
    return _gsc_arg(S, p);
}
fn _gsc_deref(S, a): i64 {
    var e = _arg_next(S, a);
    if (_gz_split(S, a, e) != 0 - 1) { return 0; }
    return _hl_dpsid(S, a + 1, e);
}
# A struct carrier given a field chain `h.bp` / `hp.bp` / `self.bp` / `GH.k.bp` (the whole argument):
# what its LEAF field points at when it is declared `*G<X>` — each hop through an inline struct field
# or a `*T` field, the head a local, a parameter, a capture or a global (`_dyn_base_sid`). It ran the
# i64 base, `Box<i64>`'s layout, silently (4 for 8). Any other leaf binds nothing (an inline `G<X>`
# field keeps the base's own refusal). The walk is `_chain_leaf` (parse_types.cyr). CHANGELOG [6.7.8]
fn _gsc_chain(S, a): i64 {
    var l = _chain_leaf(S, a);
    if (l == 0) { return 0; }
    var ps = _fld_ptr_sid(S, (l >> 32) - 1, l & 0xFFFFFFFF);
    if (ps > 0) { return ps; }
    return 0;
}
fn _gsc_name_end(S, a): i64 {
    if (TOKTYP(S, a) != 2) { return 0; }
    var nt = TOKTYP(S, a + 1);
    if (nt == 31 || nt == 11) { return 1; }
    return 0;
}
# ⛔ 6.7.11 — a whole call `f(..)` / `f<..>(..)`: the struct its callee returns, or points at. A GENERIC
# callee is the INSTANCE the call reaches (`_gen_call_inst`): `gx(mk1(p))` read `mk1`'s BASE return, the
# generic `Box`, which is no instance, so T inferred i64 and the base was refused "a different struct
# type" against the real `Box<Pt>` — now it calls `gx$Pt`, as `gx<Pt>(mk1(p))` does (the user's decision
# A, 2026-10-13). CHANGELOG [6.7.11]
fn _gsc_call(S, a): i64 {
    var o = _gcall_open(S, a);
    if (o < 0) { return 0; }
    if (_call_is_whole_arg(S, o - 1) == 0) { return 0; }
    var fi = _gen_call_inst(S, a);
    if (fi < 0) { return 0; }
    if (_fn_rpsid != 0) {
        var ps = L64(_fn_rpsid + fi * 8);
        if (ps > 0) { return ps; }
    }
    var r = GFRS(S, fi);
    if (r > 0) { return r; }
    return 0;
}
fn _gsc_name(S, noff): i64 {
    var li = FINDLOCAL(S, noff);
    if (li >= 0) {
        var lt = GLTYPE(S, li);
        if (lt >= 0) { return 0; }
        if (lt <= 0 - 2048) { return 0; }
        return 0 - lt;
    }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    var ps = _gv_ptr_sid(S, vi);
    if (ps > 0) { return ps; }
    if (GVPM(S, vi) == 0) { return 0; }
    var gt = GVTYPE(S, vi);
    if (gt > 0) { return gt; }
    return 0;
}
# `&name`: an inline struct local, a by-value struct parameter (whose `&` is the caller's struct,
# 6.6.6) or an inline struct global. `&q` of a pointer or of a pointer-mode handle is the slot's
# address — a `**` — and binds nothing.
fn _gsc_addr_of(S, noff): i64 {
    var li = FINDLOCAL(S, noff);
    if (li >= 0) {
        if (GLPTRP(S, li) == 1) { return 0; }
        var lt = GLTYPE(S, li);
        if (lt >= 0) { return 0; }
        if (lt <= 0 - 2048) { return 0; }
        if (GLAGG(S, li) == 1) { return 0 - lt; }
        if (_local_is_sptr_param(S, li) == 1) { return 0 - lt; }
        return 0;
    }
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    if (GVPM(S, vi) != 2) { return 0; }
    var gt = GVTYPE(S, vi);
    if (gt > 0) { return gt; }
    return 0;
}
# Per generic struct INSTANCE (1-based sid): its base's sid and its two type arguments, recorded
# when `_instantiate_generic_struct` mints it. 1024 entries: REGSTRUCT's own cap. CHANGELOG [6.7.8]
var _sinst = 0;
fn _sinst_note(S, inst, base, c0, c1): i64 {
    if (inst <= 0) { return 0; }
    if (inst > 1024) { return 0; }
    if (_sinst == 0) { _sinst = alloc(1024 * 24); }
    var e = _sinst + (inst - 1) * 24;
    S64(e, base);
    S64(e + 8, c0);
    S64(e + 16, c1);
    return 0;
}
# The generic struct whose instance struct `c` is (its 1-based id, as `_sinst_conc` takes it), else 0.
fn _sinst_base(c): i64 {
    if (c <= 0) { return 0; }
    if (c > 1024) { return 0; }
    if (_sinst == 0) { return 0; }
    return L64(_sinst + (c - 1) * 24);
}
# The type argument in `slot` of struct c when c is an instance of the generic struct g, else 0.
fn _sinst_conc(S, c, g, slot): i64 {
    if (c <= 0) { return 0; }
    if (c > 1024) { return 0; }
    if (g <= 0) { return 0; }
    if (_sinst == 0) { return 0; }
    var e = _sinst + (c - 1) * 24;
    if (L64(e) != g) { return 0; }
    return L64(e + 8 + slot * 8);
}
# ⛔ 6.7.7 (B4, R4) — A TUPLE NEVER BINDS A TYPE PARAMETER. `first(t)` with `t: (i64, i64)` inferred
# T = the tuple and minted `first$(i64, i64)` — a generic over a tuple, which the decision leaves open
# (a tuple type in a generic fn is refused; so is the explicit `first<(i64, i64)>(t)`). Refused once,
# at the argument, and T binds i64 — the base, as a refused bound's call does. That recovery calls a
# base whose body may be written for a struct T (the stub refusal, an inlined `x.0`) or whose `T`
# return a capture then declines, so the panic latch swallows the rest of the statement's cascade, as
# an ERR_IDENT refusal's does — set on every parse of the call (an inline replay re-parses it; the
# report is once per token). `--syntax-only` resolves as it did: lint's pre-pass judges no type.
# CHANGELOG [6.7.7]
fn _gen_tup_bind(S, fi, a, c): i64 {
    if (_syntax_only == 1) { return c; }
    _tup_err(S, a, "a tuple cannot bind a type parameter: ", _fn_src_name(S, fi, L64(_fnt_names + fi * 8)), " is generic - pass an element (`t.0`), or take the tuple in a fn that is not generic");
    _panic = 1;
    return 0 - 8;
}
# ⛔ 6.6.10 (bite 7 review) — only a WHOLE argument binds a type parameter: a bare name (next
# token `,` / `)`) or one whole call. The first cut read the argument's first token, so `f(p.y)`,
# `f(p.x + p.y)` and `f(p + 1)` all bound T to `Pt` and instantiated `f$Pt`, whose `v + 1` then
# needed an undefined `Pt_add` — programs 6.6.9 compiled and ran. Anything else infers i64.
# 6.7.11: and an explicit generic call `g(mk1<Pt>(p))`, whose instance's return binds as `mk1(p)`'s does.
fn _gen_arg_whole(S, a): i64 {
    if (TOKTYP(S, a) != 2) { return 1; }
    var nt = TOKTYP(S, a + 1);
    if (nt == 31 || nt == 11) { return 1; }
    if (nt == 10) { return _call_is_whole_arg(S, a); }
    if (nt != 19) { return 0; }
    var o = _gcall_open(S, a);
    if (o < 0) { return 0; }
    return _call_is_whole_arg(S, o - 1);
}
# ⛔ 6.6.10 — PARSE_FNCALL's head, for a call to a GENERIC (cursor just past its `(`). Struct
# inference used to exist only inside the inline replay, positionally, where `_inl_bind_param`
# then re-applied the base's i64 param type — so `var r = g(p)` with `p: Pt` ran the dead stub
# (0), `return g(p)` too, `g(2, p)` bound T from the `2`, and an inlinable body said "no struct
# type in scope for 'p'". Now an argument that infers a struct instantiates `g$Pt` exactly as
# `g<Pt>(p)` does, and a scalar call of a stub generic is refused by name. An explicit call
# (`_ta_explicit`) has already chosen its callee and is not re-inferred. Returns the fi to call.
# CHANGELOG [6.6.10]
fn _gen_call_head(S, fi, noff): i64 {
    _gh_inf0 = 0 - 8;
    _gh_inf1 = 0 - 8;
    var ex = _ta_explicit;
    _ta_explicit = 0;
    if (_MONOMORPH_OK == 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    if (ex == 2) { return fi; }   # 6.7.11: an explicit call whose instance's bound was refused
    if (ex == 0) {
        var open = GTI(S) - 1;
        _gi_sc = 0;
        var c0 = _gen_infer_tp(S, fi, open, 0);
        var c1 = _gen_infer_tp(S, fi, open, 1);
        if (c0 > 0 || c1 > 0) { return _gen_call_struct(S, fi, noff, c0, c1); }
        if (_gen_sc_inst(S, fi) == 1) { return _gen_call_struct(S, fi, noff, c0, c1); }   # 6.7.8: `Box<i32>`
        _gh_inf0 = c0;
        _gh_inf1 = c1;
    }
    if (_bnd_base_bad(S, fi) == 1) { _refuse_bnd_base(S, fi, noff); return fi; }   # 6.7.1 (C3)
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, fi, noff); }
    return fi;
}
# ⛔ 6.7.11 — A GENERIC METHOD CALL `p.m(..)` REACHES THE INSTANCE ITS ARGUMENTS BIND, as the free
# spelling `P_m(p, ..)` does (`_gen_call_head`), before `self` and the arguments, with the `(` at
# `open`. 6.7.9 took only an f64 binding: a struct one called the i64 base, the dead stub when the
# body uses the type parameter as a struct — `p.pick(q)` returned 0 where `P_pick(p, q)` read q.b.
# A scalar binding of a stub (or of a base whose bound i64 fails) is refused naming the method's fn,
# as the free call is (the user's decision A, 2026-10-13): `p.pick(9)` returned 0 in silence. Only
# the emitting call reports (`emit`); a lookahead (`_var_rhs_msid`) resolves quietly. `_gi_sc` is
# the free call's and is put back. `rsid` is the receiver's struct, which a type parameter on `self`
# binds (`fn me<V>(self: V)`: `p.me()` calls `P_me$P`, as `P_me(p)` does). CHANGELOG [6.7.11]
fn _mcall_gen(S, fi, open, rsid, emit): i64 {
    if (_MONOMORPH_OK == 0) { return fi; }
    if (fi < 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    if (TOKTYP(S, open) != 10) { return fi; }
    _gen_stub(S, fi);   # records GFGM
    var sv = _gi_sc;
    _gi_sc = 0;
    var c0 = _mcall_infer(S, fi, open, 0, rsid);
    var c1 = 0;
    if (((GFTP(S, fi) >> 32) & 0xFFFFFFFF) != 0) { c1 = _mcall_infer(S, fi, open, 1, rsid); }
    var sc = _gen_sc_inst(S, fi);
    _gi_sc = sv;
    if (c0 > 0 || c1 > 0 || sc == 1) { return _mcall_inst(S, fi, c0, c1, emit); }
    if (emit == 0) { return fi; }
    var noff = L64(_fnt_names + fi * 8);
    _gen_msp = 1;   # 6.7.15: its refusals name the method `P.m`
    if (_bnd_base_bad(S, fi) == 1) { _refuse_bnd_base(S, fi, noff); }
    elif (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, fi, noff); }
    _gen_msp = 0;
    return fi;
}
fn _mcall_inst(S, fi, c0, c1, emit): i64 {
    _gen_msp = 1;   # 6.7.15: its bound's refusal names the method `P.m` (a lookahead's too: it may report first)
    var spec = _instantiate_generic_fn(S, fi, c0, c1);
    if (spec < 0) { if (emit == 1) { _refuse_gen_inst(S, fi, L64(_fnt_names + fi * 8), spec); } }
    _gen_msp = 0;
    if (spec >= 0) { return spec; }
    return fi;
}
# `_gen_infer_tp` for a method call: type parameter `which`'s carrying parameter k is passed at
# position k - 1; `self` carrying it (k == 1) binds the receiver's struct `rsid` (none: i64).
fn _mcall_infer(S, fi, open, which, rsid): i64 {
    var m = GFGM(S, fi);
    var k = (m >> (8 + which * 8)) & 255;
    if (k == 0) { return _gen_infer_ind(S, fi, open, which, 1); }
    if (k == 1) { if (rsid > 0) { return rsid; } return 0 - 8; }
    var a = _call_arg_pk(S, fi, open, k - 1, k - 2);
    if (a < 0) { return 0 - 8; }
    var c = _ic_arg(S, fi, a, k);
    if (c == 0 - 9) { _gi_sc = 1; }
    return c;
}
fn _gen_call_struct(S, fi, noff, c0, c1): i64 {
    if (((GFTP(S, fi) >> 32) & 0xFFFFFFFF) == 0) { c1 = 0; }
    var spec = _instantiate_generic_fn(S, fi, c0, c1);
    if (spec >= 0) { return spec; }
    _refuse_gen_inst(S, fi, noff, spec);
    return fi;
}
fn _refuse_gen_inst(S, fi, noff, spec): i64 {
    if (spec == 0 - 4) { return 0; }   # 6.7.1: a bound refusal, already reported
    _gen_ident_err(S, fi, noff, ": no definition to instantiate for a struct type argument", 0 - 1);
    return 0;
}
# 6.6.10 — THE FN A CALL AT TOKEN ti (`name(` / `name<..>(`) ACTUALLY REACHES: a generic's
# instance for explicit non-i64 type arguments or an argument that infers a struct, else FINDFN's
# entry. For the call paths that emit their OWN call instead of going through PARSE_FNCALL (the
# struct receives in PARSE_VAR, `_struct_call_into_temp`) and for their lookaheads, which all
# FINDFN'd the base: `var r: Box<Pt> = mk<Pt>(p)` was sized from the base's return and then
# CALLED the base with T = i64. Instantiates when needed; FINDFN is the dedup index, so the call
# itself then finds the same instance. A stub generic with scalar type arguments resolves to its
# base — the emitting path refuses it (`_gen_own_call_check`).
fn _gen_resolve_call(S, ti): i64 {
    _grc_err = 0;
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return fi; }
    if (_MONOMORPH_OK == 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    var c0 = 0 - 8;
    var c1 = 0;
    if (TOKTYP(S, ti + 1) == 19) {
        # A list naming anything but a declared struct / plain scalar / bound type parameter is
        # left to the call's own parse, which reports it — once.
        if (_targs_resolvable(S, ti + 2) == 0) { return fi; }
        var sv = GTI(S);
        var sv_gt = _ta_pending_gt;
        _ta_pending_gt = 0;
        STI(S, ti + 2);
        c0 = _parse_one_type_arg(S);
        if (_ta_comma(S) == 1) { c1 = _parse_one_type_arg(S); }
        _ta_pending_gt = sv_gt;
        STI(S, sv);
        if (c0 <= 0 && c1 <= 0) {
            if (_gen_stub(S, fi) != 0) { return fi; }
            if (c0 == 0 - 8 && (c1 == 0 || c1 == 0 - 8)) { return fi; }
        }
    } else {
        _gi_sc = 0;
        c0 = _gen_infer_tp(S, fi, ti + 1, 0);
        c1 = _gen_infer_tp(S, fi, ti + 1, 1);
        if (c0 <= 0 && c1 <= 0) { if (_gen_sc_inst(S, fi) == 0) { return fi; } }   # 6.7.8: `Box<i32>`
        if (((GFTP(S, fi) >> 32) & 0xFFFFFFFF) == 0) { c1 = 0; }
    }
    var spec = _instantiate_generic_fn(S, fi, c0, c1);
    if (spec >= 0) { return spec; }
    # ⛔ 6.6.10 (bite 7 review): the base is NOT this call's callee — `var r = mk2(p, 1)` then ran it
    # with T = i64, silently. Recorded, and refused by the emitting path (`_gen_own_call_check`).
    _grc_err = spec;
    _grc_fi = fi;
    return fi;
}
# The `(` of the call at token ti — `name(`, or an explicit generic `name<..>(` whose type-argument
# list resolves (an unresolvable one is left to the call's own parse, which reports it) — or -1.
# 6.6.10: the paths that emit their OWN struct-valued call took only `name(`, so `r = mk<Pt>(p)`,
# `return mkw<Pt>(p)` and `gs(idp<i32>(4))` fell to a scalar value path.
fn _gcall_open(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0 - 1; }
    var nt = TOKTYP(S, ti + 1);
    if (nt == 10) { return ti + 1; }
    if (nt != 19) { return 0 - 1; }
    if (_MONOMORPH_OK == 0) { return 0 - 1; }
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return 0 - 1; }
    if (GFTP(S, fi) == 0) { return 0 - 1; }
    if (_targs_resolvable(S, ti + 2) == 0) { return 0 - 1; }
    var e = _targs_end(S, ti + 2);
    if (TOKTYP(S, e + 1) != 10) { return 0 - 1; }
    return e + 1;
}
# The token closing the type-argument list that starts at token i (`>`, or a `>>` / `>>>` tail).
fn _targs_end(S, i): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return i; }
        i = i + 1;
    }
    return n;
}
# Does every name in the type-argument list starting at token i resolve — a declared struct, a
# plain scalar, or a type parameter bound right now? (A lookahead that parsed an unresolvable
# list would report its error a second time when the call itself is parsed.)
fn _targs_resolvable(S, i): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12 || t == 13 || t == 5 || t == 10) { return 0; }
        if (t == 2) { if (_targ_name_ok(S, TOKVAL(S, i)) == 0) { return 0; } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return 1; }
        i = i + 1;
    }
    return 0;
}
# 6.6.16 (C8): the lookup is the one type-name resolver's; the subset is unchanged — a struct,
# i8..i64 or f64 (what _type_arg_leaf instantiates), or a bound type parameter.
fn _targ_name_ok(S, noff): i64 {
    if (_tp_c0 != 0) { if (_tp_resolve(S, noff) != 0) { return 1; } }
    var c = _tn_resolve(S, noff);
    var k = _tn_class(c);
    if (k == 6 || k == 1) { return 1; }
    if (k == 3) { if (_tn_val(c) == 8) { return 1; } }
    return 0;
}
# The refusal for a path that emits its own call to a stub generic's base.
fn _gen_own_call_check(S, fi, noff): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (_grc_err < 0) { if (_grc_fi == fi) {
            var e = _grc_err;
            _grc_err = 0;
            _refuse_gen_inst(S, fi, noff, e);
            return 0;
        } }
    if (_bnd_base_bad(S, fi) == 1) { _refuse_bnd_base(S, fi, noff); return 0; }   # 6.7.1 (C3)
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, fi, noff); }
    return 0;
}
# The tail path (`return g(..);`) must take PARSE_FNCALL for a generic callee that the head would
# redirect or refuse: a stub base, or an argument that infers a struct. ⚠ ONLY those — diverting
# every generic cost a scalar generic its tail call (a 20,000,000-deep `cnt<T>` then SIGSEGV'd).
fn _tc_generic_divert(S, cfi, ti_after): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (cfi < 0) { return 0; }
    if (GFTP(S, cfi) == 0) { return 0; }
    if (_gen_stub(S, cfi) != 0) { return 1; }
    if (_bnd_base_bad(S, cfi) == 1) { return 1; }   # 6.7.1 (C3): the head refuses its scalar call
    _gi_sc = 0;
    if (_gen_infer_tp(S, cfi, ti_after, 0) > 0) { return 1; }
    if (_gen_infer_tp(S, cfi, ti_after, 1) > 0) { return 1; }
    return _gi_sc;   # 6.7.8: a struct carrier's scalar (`Box<i32>`) instantiates too
}

# v6.3.10 (instantiate-once): mint a deduped specialized name `base$<tyname>` into
# tok_names for a concrete-type token, returning its noff. '$' (36) is not a legal
# identifier byte, so the name is unforgeable from source. Scalar tokens → i8/i16/
# i32/i64/f64; a struct sid (>0) → the struct's name.
# v6.3.33 (generics tail): append one concrete's name-fragment at name-pool offset
# `wp`, return the new wp. Scalar → `i8`/`i16`/`i32`/`i64`/`f64`; a struct sid → the
# struct's (possibly-already-mangled, e.g. nested `Pair$i32`) name. Extracted so
# `_mint_generic_name` can append BOTH type-args for a multi-param generic.
# The fragments never collide (the user's decision C, 2026-10-13): a scalar is `i8` / `i16` / `i32` /
# `i64` / `f64`, and a struct whose name is exactly one of those spellings (`struct f64`, which a type
# argument binds before the scalar) is marked `.f64` — '.' is no identifier byte, and not the '$' that
# `_gen_is_inst` and the coverage CLI cut at. f64 was a bare `i`, so `gen<f64>` and `gen<i>` (`struct
# i`) shared `gen$i` and the second call ran the first's body. CHANGELOG [6.7.11]
fn _conc_sname_scalar(S, snoff): i64 {
    if (_bnd_type_is(S, snoff, 0 - 8) == 1) { return 1; }
    if (_bnd_type_is(S, snoff, 0 - 4) == 1) { return 1; }
    if (_bnd_type_is(S, snoff, 0 - 2) == 1) { return 1; }
    if (_bnd_type_is(S, snoff, 0 - 1) == 1) { return 1; }
    return _bnd_type_is(S, snoff, 0 - 9);
}
fn _append_conc_name(S, wp, conc): i64 {
    if (conc < 0) {
        if (conc == 0 - 9) { store8(S + 0xEC00000 + wp, 102); wp = wp + 1; }   # 'f' (f64)
        else { store8(S + 0xEC00000 + wp, 105); wp = wp + 1; }   # 'i'
        if (conc == 0 - 8) { store8(S + 0xEC00000 + wp, 54); wp = wp + 1; store8(S + 0xEC00000 + wp, 52); wp = wp + 1; }
        elif (conc == 0 - 9) { store8(S + 0xEC00000 + wp, 54); wp = wp + 1; store8(S + 0xEC00000 + wp, 52); wp = wp + 1; }
        elif (conc == 0 - 4) { store8(S + 0xEC00000 + wp, 51); wp = wp + 1; store8(S + 0xEC00000 + wp, 50); wp = wp + 1; }
        elif (conc == 0 - 2) { store8(S + 0xEC00000 + wp, 49); wp = wp + 1; store8(S + 0xEC00000 + wp, 54); wp = wp + 1; }
        elif (conc == 0 - 1) { store8(S + 0xEC00000 + wp, 56); wp = wp + 1; }
    } else {
        var snoff = L64(S + 0x1A6018 + (conc - 1) * 8);
        if (_conc_sname_scalar(S, snoff) == 1) { store8(S + 0xEC00000 + wp, 46); wp = wp + 1; }   # '.'
        var j = 0;
        while (load8(S + 0xEC00000 + snoff + j) != 0) { store8(S + 0xEC00000 + wp, load8(S + 0xEC00000 + snoff + j)); wp = wp + 1; j = j + 1; }
    }
    return wp;
}

# ⛔ 6.7.14 (D1) — A TWO-PARAMETER NAME BRACKETS A FRAGMENT THAT IS ITSELF AN INSTANCE. A generic
# struct instance's registered name already holds '$' (`P$R`, `R$i32`), so `g2<P<R>, i32>` and
# `g2<P, R<i32>>` both minted `g2$P$R$i32` and the second call ran the first's body. The fragment
# whose name holds '$' is written `<..>` — `g2$<P$R>$i32`, `g2$P$<R$i32>` — and nothing else: every
# name that did not collide (`Two$i64$i32`, the single-parameter `Box$Pair$i32`) is unchanged.
# '<' / '>' are no identifier bytes, and not the '$' that `_gen_is_inst` and the coverage CLI cut at.
# CHANGELOG [6.7.14]
fn _conc_name_nested(S, conc): i64 {
    if (conc <= 0) { return 0; }
    var p = S + 0xEC00000 + L64(S + 0x1A6018 + (conc - 1) * 8);
    var j = 0;
    while (load8(p + j) != 0) {
        if (load8(p + j) == 36) { return 1; }
        j = j + 1;
    }
    return 0;
}
fn _append_conc_frag2(S, wp, conc): i64 {
    if (_conc_name_nested(S, conc) == 0) { return _append_conc_name(S, wp, conc); }
    store8(S + 0xEC00000 + wp, 60); wp = wp + 1;   # '<'
    wp = _append_conc_name(S, wp, conc);
    store8(S + 0xEC00000 + wp, 62); wp = wp + 1;   # '>'
    return wp;
}
# The most bytes `_append_conc_frag2` writes for `conc`: the name, its '.' mark and the brackets.
fn _conc_frag_len(S, conc): i64 {
    if (conc <= 0) { return 3; }
    var p = S + 0xEC00000 + L64(S + 0x1A6018 + (conc - 1) * 8);
    var j = 0;
    while (load8(p + j) != 0) { j = j + 1; }
    return j + 3;
}

# v6.3.33: mint `Base$<conc0>` (single param) or `Base$<conc0>$<conc1>` (two distinct
# params, conc1 != 0). The two-fragment name keeps `Two<i64,i32>` and `Two<i64,i64>`
# distinct in the FINDFN/FINDSTRUCT dedup index. Single-param (conc1 == 0) mints the
# same name as before → byte-identical dedup for the existing single-param instances.
# The guard is sized from the fragments' real lengths: a nested fragment has no fixed bound.
fn _mint_generic_name(S, base_noff, conc, conc1): i64 {
    var blen = 0;
    while (load8(S + 0xEC00000 + base_noff + blen) != 0) { blen = blen + 1; }
    NPOS_GUARD(S, blen + _conc_frag_len(S, conc) + _conc_frag_len(S, conc1) + 4);
    var wp = GNPOS(S);
    var noff = wp;
    var i = 0;
    while (i < blen) { store8(S + 0xEC00000 + wp, load8(S + 0xEC00000 + base_noff + i)); wp = wp + 1; i = i + 1; }
    store8(S + 0xEC00000 + wp, 36); wp = wp + 1;   # '$'
    if (conc1 == 0) { wp = _append_conc_name(S, wp, conc); }
    else { wp = _append_conc_frag2(S, wp, conc); }
    if (conc1 != 0) {
        store8(S + 0xEC00000 + wp, 36); wp = wp + 1;   # '$'
        wp = _append_conc_frag2(S, wp, conc1);
    }
    store8(S + 0xEC00000 + wp, 0); wp = wp + 1;
    SNPOS(S, wp);
    return noff;
}

# v6.3.35 (root cause A): the inline instance below is emitted by re-invoking
# PARSE_FN_DEF, which RESETS the per-fn jump-target table (`0x19E000`) at fn start
# (`jump_target_count = 0`). Because the instance is emitted INLINE in the enclosing
# fn's code range, that reset wipes the ENCLOSING fn's recorded jump targets — so the
# enclosing fn's LASE (`IS_JUMP_TARGET`) then mis-eliminates a load that IS a branch
# join (dropping early returns, clobbering a live local, corrupting operands). Snapshot
# the enclosing targets before the inline emit and merge them back after, so the
# enclosing LASE sees BOTH the instance's targets (already emitted in-range) and its
# own. (jump_src / nop-run compaction needs no restore: the enclosing fn is always
# `_cur_fn_has_closure` here → frame-trim is skipped and no nop_runs are produced.)
fn _jt_snapshot(S): i64 {
    var n = L64(S + 0x19E000);
    var buf = alloc((n + 1) * 8);
    store64(buf, n);
    var i = 0;
    while (i < n) { store64(buf + 8 + i * 8, L64(S + 0x19E008 + i * 8)); i = i + 1; }
    return buf;
}
fn _jt_merge(S, buf): i64 {
    var saved = load64(buf);
    var cur = L64(S + 0x19E000);
    var i = 0;
    while (i < saved) {
        if (cur < 1023) { S64(S + 0x19E008 + cur * 8, load64(buf + 8 + i * 8)); cur = cur + 1; }
        i = i + 1;
    }
    S64(S + 0x19E000, cur);
    return 0;
}

# 6.6.7 — the per-fn COMPACTION tables (jump sources, NOP runs, switch tables, the fixup and
# whole-program watermarks). A generic instance re-enters PARSE_FN_DEF, which zeroes all of
# them for itself and leaves ITS values behind: its NOP runs (already harvested from its own
# range) then drove the ENCLOSING fn's compaction over the enclosing fn's bytes — a generic
# call in a fn whose instance the register picker touched SIGSEGV'd. Copy the counts and the
# live entries out before the instance and back after it. (The enclosing fn records no NOP
# run of its own afterwards — `_cur_fn_has_closure` skips its picker and frame-trim — so its
# tables only have to be what they were.) CHANGELOG [6.6.7]
fn _tab_copy(dst, src, n): i64 {
    var i = 0;
    while (i < n) { store64(dst + i * 8, load64(src + i * 8)); i = i + 1; }
    return 0;
}
fn _tab_cap(n, cap): i64 {
    if (n > cap) { return cap; }
    return n;
}
fn _fnst_tab_save(S): i64 {
    var b = alloc(48 + 1024 * 8 + 1024 * 16 + 256 * 16);
    store64(b, L64(S + 0x1A0000));
    store64(b + 8, L64(S + 0x1A2008));
    store64(b + 16, L64(S + 0x1AC800));
    store64(b + 24, L64(S + 0x1A6010));
    store64(b + 32, _wp_fn_js0);
    store64(b + 40, _wp_fn_sw0);
    _tab_copy(b + 48, S + 0x1A0008, _tab_cap(load64(b), 1024));
    _tab_copy(b + 48 + 8192, S + 0x1A2010, _tab_cap(load64(b + 8), 1024) * 2);
    _tab_copy(b + 48 + 8192 + 16384, S + 0x1AC808, _tab_cap(load64(b + 16), 256) * 2);
    return b;
}
fn _fnst_tab_restore(S, b): i64 {
    S64(S + 0x1A0000, load64(b));
    S64(S + 0x1A2008, load64(b + 8));
    S64(S + 0x1AC800, load64(b + 16));
    S64(S + 0x1A6010, load64(b + 24));
    _wp_fn_js0 = load64(b + 32);
    _wp_fn_sw0 = load64(b + 40);
    _tab_copy(S + 0x1A0008, b + 48, _tab_cap(load64(b), 1024));
    _tab_copy(S + 0x1A2010, b + 48 + 8192, _tab_cap(load64(b + 8), 1024) * 2);
    _tab_copy(S + 0x1AC808, b + 48 + 8192 + 16384, _tab_cap(load64(b + 16), 256) * 2);
    return 0;
}

# v6.3.10 (instantiate-once): emit a deduped, monomorphized instance of generic fn
# `base_fi` for concrete-type token `conc0` (and `conc1`). Mints `base$ty`; FINDFN is
# the dedup index (hit → return the existing fi). On a miss, emits the specialized
# body ONCE — closure-style (jump-over): save the enclosing fn's per-fn codegen +
# binding state, reset, bind `T→conc`, `EJMP0` over the instance, record its offset,
# `EFNPRO`/`ESUBRSP`, replay the base body tokens (`GFBS`..) with the binding active so
# the bite-4 consults substitute, patch returns + epilogue + frame, `EPATCH` the jump,
# restore. Returns the specialized fi, or -2 for the not-yet-handled pc>0 case (the
# caller errors). pc=0 only this bite (param re-emission is the follow-on).
fn _instantiate_generic_fn(S, base_fi, conc0, conc1): i64 {
    # A STRUCT type argument re-emits the body with T bound to the struct sid, so a `T`
    # parameter is a by-value struct parameter and `p.x` resolves (v6.3.39, one parameter).
    # 6.7.1 (C3): on a two-parameter generic too — a struct as either argument, or both
    # (`g<Pt, i64>`, `g(5, p)`, `g(p, q)`). The refusal that stood here (-3) called the
    # combination "unproven"; nothing in the instance path depends on which slot holds the
    # struct, and tests/tcyr/crossos/generic_two_param_struct.tcyr now proves every call path
    # on every backend. CHANGELOG [6.7.1]
    # 6.7.1 (C3): every instance satisfies the generic's bounds — refused (once per pair of types)
    # before anything is minted; -4 = refused and reported.
    if (GFBND(S, base_fi) != 0) { if (_bnd_check_fn(S, base_fi, conc0, conc1) == 1) { return 0 - 4; } }
    var base_noff = L64(_fnt_names + base_fi * 8);
    var mangled = _mint_generic_name(S, base_noff, conc0, conc1);
    var spec = FINDFN(S, mangled);
    if (spec >= 0) { return spec; }                 # dedup hit
    var defstart = GFDS(S, base_fi);
    if (defstart == 0) { return 0 - 2; }            # 0 = no recorded def-start
    defstart = defstart - 1;                        # stored +1 (token index 0 is valid)
    # --- save the ENCLOSING fn's state (the fn currently being emitted) ---
    # 6.6.7 — ALL of it, through the shared snapshot (parse.cyr `_fnst_save`) plus the
    # compaction tables. The hand-kept list here saved rp_vec by LENGTH while the nested
    # PARSE_FN_DEF truncated it to 0 (an early `return` before the first `f<T>()` fell
    # through on x86/PE and hung on aarch64), and it omitted the defer table (an enclosing
    # `defer` registered before the call was DROPPED) and `_fn_local_addr` (re-opening the
    # v6.5.14 dead-stack tail call through a laundered `&local`). CHANGELOG [6.6.7]
    var sv_flc = GFLC(S);
    var sv_ti = GTI(S);
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    var locsnap = _cl_save_locals(S, sv_flc);
    # --- jump over the instance, then re-invoke PARSE_FN_DEF on the BASE's verbatim
    # tokens with the name + concrete-type overrides. PARSE_FN_DEF re-parses the full
    # signature (params/masks/return) + body and emits the specialized fn with T bound
    # to the concretes — full fidelity (params, struct args, masks) for free. ---
    var jmp = EJMP0(S);
    var jt_snap = _jt_snapshot(S);   # v6.3.35: save enclosing fn's jump targets (PARSE_FN_DEF resets them)
    var tab = _fnst_tab_save(S);
    var st = _fnst_save(S);
    STI(S, defstart);
    _inst_name = mangled;
    _inst_base_fi = base_fi;
    _inst_conc0 = conc0;
    _inst_conc1 = conc1;
    var attrs = _attr_park();         # 6.6.17: a pending attribute is the next definition's
    var sv_msp = _gen_msp;            # 6.7.15: a method call's spelling names its own refusals, not the body's
    _gen_msp = 0;
    PARSE_FN_DEF(S);
    _gen_msp = sv_msp;
    _attr_unpark(attrs);
    _inst_name = 0;
    _inst_base_fi = 0 - 1;
    _inst_conc0 = 0;
    _inst_conc1 = 0;
    # --- restore the enclosing fn's state ---
    _fnst_restore(S, st);
    _fnst_tab_restore(S, tab);
    _jt_merge(S, jt_snap);           # v6.3.35: restore enclosing targets (alongside the instance's)
    EPATCH(S, jmp);
    # The instance is emitted INLINE in the enclosing fn's code range (jumped over),
    # so mark the enclosing fn to skip its regalloc byte-scan post-pass (it would
    # rewrite + corrupt the instance) — same guard closures use.
    _cur_fn_has_closure = 1;
    _cl_restore_locals(S, locsnap, sv_flc);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    STI(S, sv_ti);
    spec = FINDFN(S, mangled);                       # now registered by PARSE_FN_DEF
    _gen_inst_record(S, spec, base_fi, conc0, conc1);   # 6.6.17 (a3, a5)
    _gen_inherit_dep(S, spec, base_fi);              # 6.6.16: `#deprecated` reaches instances
    return spec;
}

# ⛔ 6.6.17 — A PENDING fn ATTRIBUTE BELONGS TO THE DEFINITION IT PRECEDES, NOT TO AN INSTANCE.
# The instance above is emitted by PARSE_FN_DEF itself, which consumed whatever `#must_use` /
# `#deprecated` / `#pure` / ... was armed: an attribute written before a top-level statement that
# instantiates `g<i32>` marked `g$i32` (deprecated — every call to it warned) and was gone by the
# `fn` it preceded (`#must_use` silent there). Parked around the instance and put back. The
# instance still inherits the BASE's own `#deprecated` (`_gen_inherit_dep`).
fn _attr_park(): i64 {
    var b = alloc(80);
    store64(b, _regalloc_pending);       _regalloc_pending = 0;
    store64(b + 8, _must_use_pending);   _must_use_pending = 0;
    store64(b + 16, _deprecated_pending); _deprecated_pending = 0;
    store64(b + 24, _deprecated_msg_pending); _deprecated_msg_pending = 0;
    store64(b + 32, _pure_pending);      _pure_pending = 0;
    store64(b + 40, _io_pending);        _io_pending = 0;
    store64(b + 48, _alloc_pending);     _alloc_pending = 0;
    store64(b + 56, _naked_pending);     _naked_pending = 0;
    store64(b + 64, _inline_pending);    _inline_pending = 0;
    store64(b + 72, _pub_pending);       _pub_pending = 0;
    return b;
}
fn _attr_unpark(b): i64 {
    _regalloc_pending = load64(b);
    _must_use_pending = load64(b + 8);
    _deprecated_pending = load64(b + 16);
    _deprecated_msg_pending = load64(b + 24);
    _pure_pending = load64(b + 32);
    _io_pending = load64(b + 40);
    _alloc_pending = load64(b + 48);
    _naked_pending = load64(b + 56);
    _inline_pending = load64(b + 64);
    _pub_pending = load64(b + 72);
    return 0;
}

# v6.3.10 (generic structs): instantiate `Box<conc>` → a deduped specialized struct.
# Mints `Box$ty`; FINDSTRUCT is the dedup index. On a miss, re-invokes PARSE_STRUCT_DEF
# on the base struct's verbatim tokens with the name + binding overrides so each `: T`
# field resolves to the concrete type via the field consult. No codegen (struct
# registration only) → far simpler than the fn instance: just save/restore the cursor
# + binding. Returns the 1-based instance sid, or 0 if `base_si` isn't a generic struct.
fn _instantiate_generic_struct(S, base_si, conc0, conc1): i64 {
    var base_noff = L64(S + 0x1A6018 + base_si * 8);
    var mangled = _mint_generic_name(S, base_noff, conc0, conc1);
    var existing = FINDSTRUCT(S, mangled);
    if (existing > 0) { return existing; }           # dedup hit (1-based)
    # 6.7.1 (C3): every instance satisfies the struct's bounds — 0 (the caller keeps the base).
    if (GSBND(S, base_si) != 0) { if (_bnd_check_struct(S, base_si, conc0, conc1) == 1) { return 0; } }
    var ds = GSDS(S, base_si);
    if (ds == 0) { return 0; }                       # not a generic struct
    ds = ds - 1;
    var stp = GSTP(S, base_si);
    var sv_ti = GTI(S);
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    STI(S, ds);
    _inst_name = mangled;
    var t0 = stp & 0xFFFFFFFF;
    if (t0 != 0) { _tp_bind(S, 0, t0 - 1, conc0); }
    var t1 = (stp >> 32) & 0xFFFFFFFF;
    # v6.3.33: bind the SECOND type param to conc1 (was conc0 → collapsed distinct
    # params). Single-param structs have t1 == 0 → no bind → conc1 unused.
    if (t1 != 0) { _tp_bind(S, 1, t1 - 1, conc1); }
    # 6.7.15: the re-parse's own type-argument reads reset the close the caller's list may owe (`P<P<R>>`'s `>>`,
    # minted here) — put back, or the enclosing list read the next `,` as its own. CHANGELOG [6.7.15]
    var sv_gt = _ta_pending_gt;
    PARSE_STRUCT_DEF(S);
    _ta_pending_gt = sv_gt;
    _inst_name = 0;
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    STI(S, sv_ti);
    var r = FINDSTRUCT(S, mangled);                  # 1-based instance sid
    _sinst_note(S, r, base_si + 1, conc0, conc1);    # 6.7.8: what inference reads back (_sinst_conc)
    return r;
}

# v6.3.33: consume one type-arg-list `>` close. A `>` (token 20) closes one level. A
# `>>` (token 39, the right-shift lexeme) closes THIS level AND owes one `>` to the
# enclosing level (`_ta_pending_gt`), so `Box<Pair<i32>>`'s trailing `>>` closes both
# Pair's and Box's `<`. If a close is already owed, decrement it and consume nothing.
fn _consume_gt(S): i64 {
    if (_ta_pending_gt > 0) { _ta_pending_gt = _ta_pending_gt - 1; return 0; }
    var t = PEEKT(S);
    if (t == 20) { STI(S, GTI(S) + 1); return 0; }
    if (t == 152) { STI(S, GTI(S) + 1); _ta_pending_gt = 2; return 0; }   # `>>>` owes two
    if (t == 39) { STI(S, GTI(S) + 1); _ta_pending_gt = 1; return 0; }   # `>>`
    return 0;
}
# ⛔ 6.7.15 — A `,` AFTER A TYPE ARGUMENT: the next argument of THIS list only while no close is owed. A nested argument
# closed by `>>` / `>>>` closed this list too (`_ta_pending_gt`), so the `,` is the enclosing list's: `g2<P<P<R>>, i16>`
# read `i16` as P's second argument and bound g2's B to i64, and `fn f(a: Box<Box<Pt>>, b: i64)` read `b` as a type.
# Consumes the `,` and returns 1 when it starts this list's next argument, else 0. CHANGELOG [6.7.15]
fn _ta_comma(S): i64 {
    if (_ta_pending_gt != 0) { return 0; }
    if (PEEKT(S) != 31) { return 0; }
    STI(S, GTI(S) + 1);
    return 1;
}

# v6.3.33 (generics tail — NESTED + multi-arg): consume ONE type argument at the
# cursor and return its concrete encoding (per _classify_return_type: >0 struct sid,
# -1/-2/-4/-8 scalars, -16..-21 special). A NESTED generic type-arg (`Name<...>` where
# Name is a generic struct) is RECURSIVELY parsed + instantiated → its INSTANCE sid is
# returned, so `Box<Pair<i32>>` binds Box's T to the `Pair$i32` instance (not the base
# Pair, whose i64 layout differs). Consumes the name + any nested `<...>`; leaves the
# cursor on the `,` or `>` that terminates this arg. A nested 2-param `M<A, B>` recurses
# on both. Gated by the callers (`_MONOMORPH_OK`); no default-path effect.
# v6.3.33: special/aggregate types (Result/Option/Tagged/cstring/f64v2/f64v4,
# encoded <= -16 by _classify_return_type) are NOT supported as generic type-args.
# Their monomorphized ABI is not soundly emitted (proven: a generic fn instantiated
# with f64v2/f64v4 slipped the struct guard AND miscompiled), and _append_conc_name
# only spells the plain scalars {-8,-4,-2,-1} and f64 (-9) — every special collapses to
# `Base$i`, ALIASING distinct instances in the FINDFN/FINDSTRUCT dedup. Hard-error at
# the single leaf-classify choke point (covers fn + struct + nested) instead of
# silently miscompiling. Scalars and struct type-args are unaffected.
fn _reject_special_type_arg(S, c): i64 {
    if (c <= 0 - 16) {
        _ta_refd = 1;   # 6.7.14
        if (_ta_chk_ok(S) == 0) { return 0; }
        ERR_MSG(S, "generic type-args must be a scalar (i8/i16/i32/i64) or a struct; Result/Option/Tagged/cstring/f64v2/f64v4 are unsupported", 121);
    }
    return 0;
}

# ⛔ 6.6.8 — A TYPE-ARG NAMING THE ENCLOSING GENERIC'S OWN TYPE PARAMETER. `inner<T>(p)` inside
# `fn outer<T>` classified `T` as a TYPE NAME, found none, and got 0 — "unbound" — so the
# instance was minted with `_inst_conc0 == 0`, which PARSE_FN_DEF reads as the BASE emission:
# a field-accessing body became the `rax = 0` dead stub and `outer<Pt>(p)` returned 2 where 16
# was right, with no diagnostic. A bound type parameter resolves to its binding (T -> Pt in the
# `outer<Pt>` instance, T -> i64 in outer's own base); a name that is neither a bound parameter
# nor a type is an error — 0 is never a type. CHANGELOG [6.6.8]
fn _type_arg_leaf(S, noff): i64 {
    var _c0 = 0;
    if (_tp_c0 != 0) { _c0 = _tp_resolve(S, noff); }
    if (_c0 == 0) { _c0 = _classify_return_type(S, noff); }
    if (_c0 == 0) {
        if (_ta_chk == 1) { if (_targ_is_tp(S, noff) == 1) { _tck_nj = 1; return 0 - 8; } }   # 6.7.14: read unbound
        if (_ta_late == 1) { if (_declared_later(S, noff, 40, 101) == 1) {   # 6.7.15 (D8)
                _tck_nj = 1;
                return 0 - 8;
            } }
        _ta_refd = 1;
        if (_ta_chk_ok(S) == 1) { _refuse_type_arg_name(S, noff); }
        return 0 - 8;
    }
    # 6.7.15: a dyn, refused by the dyn pre-pass (`_dyn_targ`), is read as i64 — no `Box$dyn Show` minted to
    # cascade into a second error, and an explicit call mints no instance. CHANGELOG [6.7.15]
    if (_dyn_is(S, _c0) == 1) { _ta_refd = 1; return 0 - 8; }
    _reject_special_type_arg(S, _c0);
    return _c0;
}
# The refusal names the vocabulary: exactly the names a return type accepts (`_classify_return_type`)
# plus a bound type parameter. `u8`..`u64`, `bool`, `ptr`, `f32` and an enum name are NOT in it —
# a type argument picks a WIDTH and a layout, so an alias that silently chose one is the bug this
# replaced. An enum gets its own line: its values are i64, and "unknown type" reads as a typo.
fn _refuse_type_arg_name(S, noff): i64 {
    _ta_refd = 1;   # 6.7.14
    if (_dyn_bare_nm != 0) { if (noff == _dyn_bare_nm - 1) { return 0; } }   # 6.7.8: T3 named it
    if (_is_enum_name(S, noff) == 1) {
        ERR_IDENT(S, "", noff, " is an enum, not a type argument — enum values are i64; write i64", 0 - 1);
        return 0;
    }
    ERR_IDENT(S, "unknown type ", noff, " as a type argument (a type argument is a struct, i8/i16/i32/i64, f64, or a type parameter in scope)", 0 - 1);
    return 0;
}
fn _is_enum_name(S, noff): i64 {
    if (_enum_id_of(S, noff) > 0) { return 1; }
    if (_ta_late == 1) { if (_declared_later(S, noff, 60, 60) == 1) { return 1; } }   # 6.7.15 (D8): an enum below
    return 0;
}

# The 1-based id of the enum named `noff` (the GVENUMID of its variants), or 0. CHANGELOG [6.6.11]
fn _enum_id_of(S, noff): i64 {
    var n = GENUMC(S);
    var i = 0;
    while (i < n) {
        if (STREQ(S, GENUMNM(S, i), noff) == 1) { return i + 1; }
        i = i + 1;
    }
    return 0;
}

fn _parse_one_type_arg(S): i64 {
    if (PEEKT(S) == 10) { _tup_pos_refuse(S, "a type argument"); _ta_refd = 1; return 0 - 8; }   # 6.7.7 (R3)
    if (PEEKT(S) == 28) {   # 6.7.8 (C2-6a): `g<[u8]>` was "unknown type 'enum' as a type argument"
        _sl_err(S, GTI(S), "a slice cannot be a type argument (6.7.8: slices are fn-locals)", "");
        _ta_refd = 1;
        _sl_ann_skip(S);
        return 0 - 8;
    }
    if (PEEKT(S) != 2) { return _targ_not_name(S); }   # 6.7.14: `Box<1 + 2>`, `Box<u128>`
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);                              # consume the type-arg name
    if (PEEKT(S) != 19) {                            # no `<` → plain scalar / struct
        var _c0 = _type_arg_leaf(S, noff);
        return _c0;
    }
    var base_sid = FINDSTRUCT(S, noff);
    if (_ta_late == 1) { if (base_sid <= 0) { if (_declared_later(S, noff, 40, 101) == 1) {
                return _targ_later(S, noff);
            } } }
    if (base_sid <= 0 || GSTP(S, base_sid - 1) == 0) {
        var _c1 = _classify_return_type(S, noff);    # `<` but not a generic struct
        if (_dyn_is(S, _c1) == 1) { _ta_refd = 1; _c1 = 0 - 8; }   # 6.7.15: `dyn Show<..>`, as `_type_arg_leaf`
        _reject_special_type_arg(S, _c1);
        if (_c1 == 0) {   # 6.7.14
            if (_vec_ann_at(S, GTI(S) - 1) == 0) { return _targ_bad_gen(S, noff); }
            _targ_vec(S, GTI(S) - 1);
        }
        if (_ngt_refuse(S, GTI(S) - 1) == 1) { _ta_refd = 1; }   # 6.7.15 (D6): `Pt<..>`, `i64<..>` (its type is read)
        # 6.6.17: and its own `<..>` (`Box<Vec<i64>>`), which was left for the enclosing list.
        _ta_pending_gt = _ta_pending_gt + _skip_targ_list(S);
        return _c1;
    }
    STI(S, GTI(S) + 1);                              # consume the nested `<`
    var lit = _targs_literal(S, GTI(S));             # 6.7.15: `Box<i64>` written out (see `_targ_inst`)
    var lv = _tck_open(S);                           # 6.7.15 (D10): under `_ta_chk`, this list's own judgement
    var in0 = _parse_one_type_arg(S);                # recurse into the inner arg(s)
    var in1 = 0;
    if (_ta_comma(S) == 1) { in1 = _parse_one_type_arg(S); }   # `,`
    _consume_gt(S);                                  # consume the nested `>` (or `>>`)
    if (_ta_chk == 1) { return _tck_nest(S, base_sid, in0, in1, lit, lv); }   # 6.7.14 (D5): read, not minted
    return _targ_inst(S, base_sid, in0, in1, lit);
}
# 6.7.15 (D8) — `Later<..>` in a pointer field's list read at its declaration (`_ta_late`; cursor on the `<`), Later a
# struct declared further down: a generic one's own arguments are read and checked as any list's; any other one's list
# is skipped, left to the use, which reads it under the struct (D6's `Pt<..>`). Read as i64; nothing is sized.
fn _targ_later(S, noff): i64 {
    _tck_nj = 1;   # 6.7.15 (D10): a struct declared further down is no instance to judge here
    if (_declared_later_gen(S, noff) == 0) {
        _ta_pending_gt = _ta_pending_gt + _skip_targ_list(S);
        return 0 - 8;
    }
    STI(S, GTI(S) + 1);
    _parse_one_type_arg(S);
    if (_ta_comma(S) == 1) { _parse_one_type_arg(S); }
    _consume_gt(S);
    return 0 - 8;
}
# ⛔ 6.7.15 — A NESTED `Box<i64>` IS THE BASE `Box`, as the annotation `var b: Box<i64>` declares it (the 6.6.10 rule of
# `_gen_ann_sid` / `_ret_targ_parse`): an all-i64 (or unbound) list is the base struct, anything else the deduped
# `Box$..` instance. The type argument minted `Box$i64` unconditionally, so `gx<Box<i64>>(bx)` with `bx: Box<i64>` (the
# base) was refused "cannot pass 'bx' to a parameter of a different struct type", where `gx(bx)` ran. `lit`: the list
# was written out, so the base answers for its bound (`_bnd_sbase`). CHANGELOG [6.7.15]
fn _targ_inst(S, base_sid, in0, in1, lit): i64 {
    var inst = 0;
    if (in0 != 0 - 8) { if (in0 != 0) { inst = 1; } }
    if (in1 != 0) { if (in1 != 0 - 8) { inst = 1; } }
    if (inst == 0) {
        if (lit == 1) { _bnd_sbase(S, base_sid); }
        return base_sid;
    }
    return _instantiate_generic_struct(S, base_sid - 1, in0, in1);
}

# ⛔ 6.7.14 (D2 / D3) — `Name<..>` AS A TYPE ARGUMENT, NAME NO TYPE (cursor on its `<`). It was skipped and read as
# class 0, "unbound" — the i64 BASE: `g<Nonexist<u8>>(0)` ran the base (sizeof(T) 8) and `var c: Box<Nonexist<u8>>;`
# declared the base `Box`, while `g<Nonexist>(0)` was refused by name; the built-in slice's word form `g<slice<u8>>`
# ran the base where `g<[u8]>` was refused; and `h<T<u8>>` inside a generic reached h's base, not the instance T is
# bound to. Each is refused once, at the name (the user's D2 (a) and D3 (a), 2026-10-16): the built-in slice as `[u8]`
# is, a type parameter as one, anything else as the plain unknown name. The list is skipped and the argument read as
# i64, so nothing cascades. `Vec<..>` and a generic struct do not come here. CHANGELOG [6.7.14]
fn _targ_bad_gen(S, noff): i64 {
    var nti = GTI(S) - 1;
    _ta_refd = 1;
    if (_sl_ann_at(S, nti) == 1) {
        _sl_err(S, nti, "a slice cannot be a type argument (6.7.8: slices are fn-locals)", "");
    } elif (_targ_is_tp(S, noff) == 1) {
        _dyn_err(S, nti, "a type parameter takes no type arguments: ", 0, noff, 0);
    } elif (_tn_once(S, nti) == 1) {
        STI(S, nti);
        _refuse_type_arg_name(S, noff);
        STI(S, nti + 1);
    }
    _ta_pending_gt = _ta_pending_gt + _skip_targ_list(S);
    return 0 - 8;
}
# ⛔ 6.7.14 (D4) — `Vec<..>` AS A TYPE ARGUMENT (`Box<Vec<nosuch>>`, `idv<Vec<1 + 2>>(c)`; cursor on its `<`, `vti` the
# word): its element was skipped unread (`_skip_targ_list`). Read and checked as a `var v: Vec<T>` annotation's is
# (6.7.11's D9), the cursor put back; a refusal is a refused type argument (`_ta_refd`). CHANGELOG [6.7.14]
fn _targ_vec(S, vti): i64 {
    var sv = GTI(S);
    STI(S, vti + 1);
    if (_vec_ann_list(S, 0 - 1) < 0) { _ta_refd = 1; }
    STI(S, sv);
    return 0;
}
# ⛔ 6.7.14 (D5) — A TYPE-ARGUMENT LIST READ, NOT INSTANTIATED, from its `<` at token `lt`: a Vec element's own list
# (`var w: Vec<Box<nosuch>>`, a field `more: Vec<Box<(i64, i64)>>`) was skipped unread. Each argument is read as
# `_parse_one_type_arg` reads one — every refusal of a type argument, once per token — but no generic struct is
# instantiated (`_ta_chk`: a struct definition's fields must stay contiguous in the field pool), and the cursor, the
# owed closers and a panic latch the check set are put back, so the caller consumes the list as it did. CHANGELOG [6.7.14]
fn _targ_chk(S, lt): i64 {
    var sv = GTI(S);
    var sv_gt = _ta_pending_gt;
    var sv_pn = _panic;
    var sv_ck = _ta_chk;
    _ta_chk = 1;
    _ta_pending_gt = 0;
    STI(S, lt + 1);
    var c0 = _parse_one_type_arg(S);
    var c1 = 0;
    if (_ta_comma(S) == 1) { c1 = _parse_one_type_arg(S); }
    _tck_c0 = c0;   # 6.7.15 (D10): what was read, for a Vec element's bound (`_vec_el_targs`)
    _tck_c1 = c1;
    _ta_chk = sv_ck;
    _ta_pending_gt = sv_gt;
    if (sv_pn == 0) { _panic = 0; }
    STI(S, sv);
    return 0;
}
# ⛔ 6.7.15 (D10) — A VEC ELEMENT'S GENERIC STRUCT IS HELD TO ITS BOUNDS: `var w: Vec<Box<Pt>> = 0;` with
# `struct Box<T: Show>` and no `impl Show for Pt` compiled, where `var b: Box<Pt>;` is refused — the element's list is
# read without minting (`_targ_chk`, 6.7.14's D5), and a bound is judged where an instance is minted. While a Vec
# element's list is read (`_ta_vbnd`), the element and each generic struct nested in it is judged as `_targ_inst` would
# judge it, nothing minted: its arguments against its bounds (`_bnd_check_struct`), an all-i64 list written out by its
# base's (`_bnd_sbase`) — reported at the struct's name, once per (struct, arguments) as every bound refusal (the
# user's D10 (a), 2026-10-18). Not judged: a list with a refused argument (its refusal stands alone), one naming a
# type parameter not bound here (each instance judges its binding) or a struct declared further down, and one whose
# argument is itself an instance (only minting it names it; that struct's own bound is judged in its turn). Off
# outside a Vec element, so a signature's or a pointer field's `_targ_chk` judges no bound. CHANGELOG [6.7.15]
var _ta_vbnd = 0;   # 1 while a Vec element's list is read (`_vec_el_targs`)
var _tck_c0 = 0;    # the arguments the last `_targ_chk` read
var _tck_c1 = 0;
var _tck_nj = 0;    # 1 when the list being read cannot be judged (above)
# Under `_ta_chk`, cursor just past a nested `<`: the enclosing list's state, packed (its name token * 4, its refusal
# flag * 2, its no-judge flag), both flags cleared for this list. 0 and nothing touched outside `_ta_chk`.
fn _tck_open(S): i64 {
    if (_ta_chk == 0) { return 0; }
    var lv = (GTI(S) - 2) * 4 + _ta_refd * 2 + _tck_nj;
    _ta_refd = 0;
    _tck_nj = 0;
    return lv;
}
# The nested generic struct `sid` read under `_ta_chk` (`lv` from `_tck_open`): judged inside a Vec element, the
# enclosing list's flags put back (with this list's), and read as its base — an instance its enclosing list cannot
# judge.
fn _tck_nest(S, sid, in0, in1, lit, lv): i64 {
    var nj = _tck_nj | _ta_refd;
    _ta_refd = ((lv / 2) & 1) | _ta_refd;
    _tck_nj = (lv & 1) | nj;
    if (_ta_vbnd == 1) { if (nj == 0) { _vbnd_judge(S, sid, in0, in1, lit, lv / 4); } }
    if (_targ_is_inst(in0, in1) == 1) { _tck_nj = 1; }
    return sid;
}
# 1 when a list read as (c0, c1) names an instance, not the all-i64 (or unbound) base (`_targ_inst`'s rule).
fn _targ_is_inst(c0, c1): i64 {
    if (c0 != 0 - 8) { if (c0 != 0) { return 1; } }
    if (c1 != 0) { if (c1 != 0 - 8) { return 1; } }
    return 0;
}
# Generic struct `sid` read as (c0, c1) (`lit`: the list written out) judged against its bounds at token `at`, minting
# nothing; the panic latch a report sets is put back, so the list reads on.
fn _vbnd_judge(S, sid, c0, c1, lit, at): i64 {
    if (_MONOMORPH_OK != 1) { return 0; }
    var sv = GTI(S);
    var sv_pn = _panic;
    STI(S, at);
    if (_targ_is_inst(c0, c1) == 1) { _bnd_check_struct(S, sid - 1, c0, c1); }
    elif (lit == 1) { _bnd_sbase(S, sid); }
    if (sv_pn == 0) { _panic = 0; }
    STI(S, sv);
    return 0;
}
# 0 = say nothing: under `_targ_chk` a name the cursor just passed was reported already (a generic body, both passes).
fn _ta_chk_ok(S): i64 {
    if (_ta_chk == 0) { return 1; }
    return _tn_once(S, GTI(S) - 1);
}
# 1 when `noff` names a type parameter here: bound now, the current fn's, or the struct being defined's.
fn _targ_is_tp(S, noff): i64 {
    if (_tp_c0 != 0) { if (_tp_resolve(S, noff) != 0) { return 1; } }
    if (_cur_fn_ix >= 0) { if (_is_tparam_of(S, _cur_fn_ix, noff) == 1) { return 1; } }
    if (_is_own_tparam(S, noff) == 1) { return 1; }
    if (_trs_fn > 0) { if (_fn_tp_has(S, _trs_fn - 1, noff) == 1) { return 1; } }   # 6.7.15 (D7): a trait member's
    return 0;
}

# ⛔ 6.7.14 — A TYPE ARGUMENT THAT IS NO NAME (`Box<1 + 2>`, `Box<u128>`, `id<1 + 2>(3)`, `Box<"s">`). Its token's VALUE
# was read as a name-pool offset — a number's 1 named "truct", u128's keyword value "struct", a string's offset SIGSEGV'd
# the compiler — and only that token was stepped, so a call's `+ 2>(3)` was left to the statement ("expected ';'" on
# the next line, "expected '}'" at the end of the file). Refused once at the token, by what it is (u128 by its text);
# the argument's tokens are stepped to the `,` or `>` that ends it, which the caller reads as for any argument; it is
# read as i64, so nothing cascades. CHANGELOG [6.7.14]
fn _targ_not_name(S): i64 {
    var ti = GTI(S);
    var t = TOKTYP(S, ti);
    _ta_refd = 1;
    if (t == 105) {
        _dyn_err(S, ti, "u128 cannot be a type argument (a type argument is a struct, i8/i16/i32/i64, f64, or a type parameter in scope)", 0, 0 - 1, 0);
    } elif (_dyn_ebeg(S, ti) == 1) {
        PRSTR("a type argument is a type name, got ");
        PRSTR(TOKNAME(t));
        if (t == 1) { PRSTR(" "); PRNUM(TOKVAL(S, ti)); }
        _dyn_eend(S);
    }
    _targ_skip_arg(S);
    return 0 - 8;
}
# Step one type argument's tokens, the cursor left on the `,` or the `>` / `>>` / `>>>` that ends it at its own depth
# (or on a `)` / `]`, `;`, `{`, `}`, `=` or the end of the file, where the list was never closed). Inside `( .. )` or
# `[ .. ]` a `<` / `>` is a comparison, so only the `<`s outside them nest. A `>>` / `>>>` closing a nested `<` and this
# list too is paid forward to the caller's `_consume_gt`, as `_skip_targ_list`'s is (`_ta_pending_gt`).
fn _targ_skip_arg(S): i64 {
    var pd = 0;
    var ad = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        var g = _targ_gt_n(t);
        if (pd > 0) { g = 0; }
        if (t == 12 || t == 5 || t == 13 || t == 14 || t == 4) { return 0; }
        if (pd + ad == 0) { if (t == 31 || t == 11 || t == 29 || g > 0) { return 0; } }
        if (t == 10 || t == 28) { pd = pd + 1; }
        elif (t == 11 || t == 29) { if (pd > 0) { pd = pd - 1; } }
        elif (t == 19) { if (pd == 0) { ad = ad + 1; } }
        elif (g > 0) { ad = ad - g; }
        STI(S, GTI(S) + 1);
        if (ad < 0) { _ta_pending_gt = _ta_pending_gt + (0 - ad); return 0; }   # this list's close too
    }
    return 0;
}
# How many type-argument lists token `t` closes: `>` 1, `>>` 2, `>>>` 3, else 0.
fn _targ_gt_n(t): i64 {
    if (t == 20) { return 1; }
    if (t == 39) { return 2; }
    if (t == 152) { return 3; }
    return 0;
}

# Parse fn name<T>(params) { body }
# Dead store elimination: scan codebuf for consecutive stores to the same
# [rbp-N] offset, NOP out the first store when redundant.
# Pattern: store [rbp-N] (7) + load_imm (2/5/10) + store [rbp-N] (7) → NOP first store.
fn DSE_PASS(S, fn_start): i64 {
    var dse_cp = GCP(S);
    var dse_i = fn_start;
    while (dse_i + 14 < dse_cp) {
        if (load8(_codebuf_base + dse_i) == 0x48) {
            if (load8(_codebuf_base + dse_i + 1) == 0x89) {
                if (load8(_codebuf_base + dse_i + 2) == 0x85) {
                    var dse_off = load32(_codebuf_base + dse_i + 3);
                    var dse_j = dse_i + 7;
                    var dse_skip = 0;
                    if (load8(_codebuf_base + dse_j) == 0x31) { dse_skip = 2; }
                    elif (load8(_codebuf_base + dse_j) == 0xB8) { dse_skip = 5; }
                    elif (load8(_codebuf_base + dse_j) == 0x48) {
                        if (load8(_codebuf_base + dse_j + 1) == 0xB8) { dse_skip = 10; }
                    }
                    if (dse_skip > 0) {
                        var dse_next = dse_j + dse_skip;
                        if (dse_next + 7 <= dse_cp) {
                            if (load8(_codebuf_base + dse_next) == 0x48) {
                                if (load8(_codebuf_base + dse_next + 1) == 0x89) {
                                    if (load8(_codebuf_base + dse_next + 2) == 0x85) {
                                        if (load32(_codebuf_base + dse_next + 3) == dse_off) {
                                            var dse_ni = dse_i;
                                            while (dse_ni < dse_j) {
                                                store8(_codebuf_base + dse_ni, 0x90);
                                                dse_ni = dse_ni + 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        dse_i = dse_i + 1;
    }
    return 0;
}

# Check if a codebuf offset is a jump target (recorded by EPATCH)
fn IS_JUMP_TARGET(S, off): i64 {
    var jtc = L64(S + 0x19E000);
    # AR-03 (v6.1.38): only 1023 slots are valid (0x19E008..0x1A0000); EJMP's
    # overflow path bumps the count to the 1024 sentinel, so clamp before reading
    # — slot 1023 is jump_src_cnt, not a recorded target.
    if (jtc > 1023) { jtc = 1023; }
    var i = 0;
    while (i < jtc) {
        if (L64(S + 0x19E008 + i * 8) == off) { return 1; }
        i += 1;
    }
    return 0;
}

# v6.5.20 — shift helper for the NOP-harvest compactor: total bytes deleted BEFORE
# code position `p`. Same linear scan the jump/fixup/target stages run inline (runs
# are emit-order, not CP-sorted, at the point these stages execute).
fn _nop_shift_at(S, nrn, p): i64 {
    var sh = 0;
    var i = 0;
    while (i < nrn) {
        if (L64(S + 0x1A2010 + i * 16) < p) { sh = sh + L64(S + 0x1A2010 + i * 16 + 8); }
        i = i + 1;
    }
    return sh;
}

# v6.5.20 — compaction stage 3b: repair switch jump-table entries.
#
# THE P1 SILENT MISCOMPILE. A table-regime `switch` embeds a (range+1) x 4 byte
# table of `target_cp - table_cp` displacements, dispatched by
# `movsxd rax,[rcx+rax*4] ; add rax,rcx ; jmp rax`. The v5.6.27 compactor deletes
# the 4-byte NOPs the regalloc picker leaves behind and repairs jump disp32s, fixup
# CPs and jump-target CPs — but it never knew about this table. Every NOP harvested
# between the table and a case body therefore left that body's entry pointing 4 bytes
# too far, cumulatively: `case 0` (offset 0 deletions) stayed correct while every
# later case landed mid-instruction. With a `default:` that is a SIGSEGV; without one
# the strayed target fell off the end of the switch and the program returned the wrong
# answer with no diagnostic. Only bodies that assign a register-allocated local produce
# NOPs, which is exactly why a corpus of `case N: { return N; }` bodies never saw it.
#
# Runs BEFORE stage 4 (the byte copy) and reads pre-compaction CPs, like every other
# stage. Both ends move independently, so each entry is recomputed from scratch rather
# than adjusted by a single delta. x86-family only — parse.cyr forces the chain path
# for aarch64/cx, so `swn` is 0 there and this is a no-op. CHANGELOG [6.5.20]
# v6.5.20 — does the 4-byte window at code position `p` touch any switch jump TABLE?
# The tables live in the code stream as DATA (`nent` × 4-byte displacements, jumped over
# by the dispatch), so any byte-pattern scan over a fn's range walks them as if they were
# instructions. Used by _ra_frame_trim to refuse a match that overlaps table bytes.
fn _sw_tbl_hits(S, swn, p): i64 {
    var si = 0;
    while (si < swn) {
        var tcp = L64(S + 0x1AC808 + si * 16);
        if (p + 3 >= tcp) {
            if (p < tcp + L64(S + 0x1AC808 + si * 16 + 8) * 4) { return 1; }
        }
        si = si + 1;
    }
    return 0;
}

fn _sw_tbl_repair(S, nrn, swn): i64 {
    var si = 0;
    while (si < swn) {
        var tcp = L64(S + 0x1AC808 + si * 16);
        var nent = L64(S + 0x1AC808 + si * 16 + 8);
        var new_tcp = tcp - _nop_shift_at(S, nrn, tcp);
        var ei = 0;
        while (ei < nent) {
            var ea = _codebuf_base + tcp + ei * 4;
            var rel = load8(ea) | (load8(ea + 1) << 8) | (load8(ea + 2) << 16) | (load8(ea + 3) << 24);
            if (rel >= 0x80000000) { rel = rel - 0x100000000; }
            var tgt = tcp + rel;
            var nrel = tgt - _nop_shift_at(S, nrn, tgt) - new_tcp;
            store8(ea + 0, nrel & 0xFF);
            store8(ea + 1, (nrel >> 8) & 0xFF);
            store8(ea + 2, (nrel >> 16) & 0xFF);
            store8(ea + 3, (nrel >> 24) & 0xFF);
            ei = ei + 1;
        }
        si = si + 1;
    }
    return 0;
}

# v6.3.29 callee-saved frame-trim (CYRIUS_FRAMETRIM). A #regalloc fn's prologue/epilogue
# save+restore ALL _cur_fn_regalloc callee-saved regs (rbx,r12-r15), but the linear-scan
# picker used only _ra_used_n of them (it allocates lowest-first → the used set is the
# prefix {0.._ra_used_n-1}). Callee-saved regs are written ONLY by the picker, so the
# saves/restores for the unused [_ra_used_n, _cur_fn_regalloc) regs are DEAD. Record them
# as nop_runs → PARSE_FN_DEF's existing compactor (below) deletes them with full jump/
# fixup/target repair. Saves are 4 B each at _ra_save_cp+k*4 (order rbx=0..r15=4); the
# restore sequence emits REVERSE (r15 first), so reg k sits at
# _ra_restore_cp+(_cur_fn_regalloc-1-k)*4. Frame size is unchanged (the reserved slot
# stays, just unused; disps don't shift) → reloc-safe. x86-only; gated CYRIUS_FRAMETRIM.
# v6.5.35 — loop-aware live-interval extension.
#
# A value live anywhere inside a loop body must stay live for the WHOLE body, or the
# picker may hand its register to a later interval and a backward edge will then re-read
# the register expecting the earlier value. That is the exact v5.6.22 miscompile which
# forced every interval's end to the function end (see RA_SCAN_LOOPS in
# src/backend/x86/decode.cyr for the full account).
#
# Given the backward edges as (target, branch) pairs, an interval [first, last] that
# overlaps a loop body [t, s] extends to `s`. Extending can pull an interval into a loop
# it did not previously overlap — an outer loop enclosing an inner one — so this iterates
# to a fixpoint rather than making one pass. Nesting depth is small; the cap is a belt.
#
# CONSERVATIVE BY CONSTRUCTION: it only ever moves `last` LATER, never earlier, so the
# result is always at least as live as the real interval and never shorter than what the
# picker needs. The worst case degenerates to `hi`, which is the pre-v6.5.35 behaviour.
fn _ra_loop_extend(be_t, be_s, be_n, first, last, hi): i64 {
    var out = last;
    var iter = 0;
    while (iter < 16) {
        var changed = 0;
        var i = 0;
        while (i < be_n) {
            var t = load64(be_t + i * 8);
            var sbr = load64(be_s + i * 8);
            # [first, out] overlaps the loop body [t, sbr]?
            if (first <= sbr) {
                if (out >= t) {
                    if (sbr > out) { out = sbr; changed = 1; }
                }
            }
            i = i + 1;
        }
        if (changed == 0) { break; }
        iter = iter + 1;
    }
    if (out > hi) { out = hi; }
    return out;
}

# THE ONE DEFINITION OF "A FRAME REFERENCE THE REGISTER PICKER CAN REWRITE".
#
# Returns the opcode (0x8B = load, 0x89 = store) when the bytes at codebuf offset `p` are
# `48 8B 85 d32` / `48 89 85 d32` — a 64-bit move between RAX and [rbp+disp32] — and 0 for
# anything else. All three picker stages ask this one function: the use scan counts only what
# it accepts, the unsafe scan disqualifies a slot for ANY [rbp+disp32] reference it rejects,
# and the patch pass rewrites only what it accepts. So a promoted slot keeps no reference to
# its stack home, by construction.
#
# ⛔ The stages used to spell this test separately, and disagreed: the unsafe scan exempted
# every `48 8B` / `48 89` without reading the ModRM REG field, so a SIMD kernel's operand read
# `mov rdx,[rbp+disp32]` (48 8B 95, `_EMIT_LOAD_RDX_FROM_LOCAL`) passed as a rewritable move
# that the patch pass (exact 0x85) never rewrote. The slot was promoted, its rax store became a
# register move, and the kernel read a slot nothing wrote — silent wrong code or a SIGSEGV
# through every batch intrinsic. A byte pattern the pass cannot rewrite must DISQUALIFY; it may
# never be waved through by opcode alone. CHANGELOG [6.6.5]
fn _ra_plain_slot_mov(p): i64 {
    var b = _codebuf_base + p;
    if (load8(b) != 0x48) { return 0; }
    if (load8(b + 2) != 0x85) { return 0; }
    var op = load8(b + 1);
    if (op == 0x8B) { return 0x8B; }
    if (op == 0x89) { return 0x89; }
    return 0;
}

fn _ra_frame_trim(S, fn_start, fi): i64 {
    # v6.3.29: the trim's invariant is that the regalloc PICKER ran and its
    # lowest-first assignment is faithfully tracked in `_ra_used_n`. Two paths break
    # that, so skip them:
    #  - `_cur_fn_has_closure`: the fn emitted an INLINE closure/generic instance in
    #    its own range; the picker is skipped and the range holds a foreign frame.
    #  - `_MONOMORPH_OK` (CYRIUS_MONOMORPH=1, experimental/opt-in/default-off): generic
    #    instances are emitted by token-replaying PARSE_FN_DEF with the picker skipped,
    #    so `_ra_used_n` (0) understates the instance's real callee-saved use → a trim
    #    would drop a live save. The trim is a DEFAULT-path optimization; the replay
    #    path is out of its scope.
    if (_cur_fn_has_closure != 0) { return 0; }
    # v6.4.0: skip the frame-trim only for GENERIC fns under the flag (base + every
    # token-replayed instance share the generic fn's `fi`, so GFTP != 0 covers all the
    # picker-skipped cases), NOT the v6.3.29 broad `_MONOMORPH_OK != 0` blanket that
    # disabled the trim for EVERY fn under the flag (+16 KB the moment it flips default-on).
    # cycc has zero generic fns → every fn trims → byte-identical under the flag.
    if (_MONOMORPH_OK == 1 && GFTP(S, fi) != 0) { return 0; }
    if (_cur_fn_regalloc <= 0) { return 0; }
    if (_ra_used_n >= _cur_fn_regalloc) { return 0; }
    var cb = _codebuf_base;
    var lim = GCP(S) - 4;
    # v6.5.20 — switch jump tables emitted by THIS fn (see _sw_tbl_hits). The scan below
    # is an UNALIGNED byte-pattern walk of the whole fn range, and since v6.5.20 that
    # range can contain table DATA as well as instructions; a 4-byte window landing on
    # table bytes must not be recorded as a NOP run. Clamped to the 256-record cap for
    # the same reason the compaction gate tests it — past that the tail is unrecorded.
    var _swtn = L64(S + 0x1AC800);
    if (_swtn > 256) { _swtn = 256; }
    var k = _ra_used_n;
    while (k < _cur_fn_regalloc) {
        # Per-reg save/restore bytes: [rex, 89(save)/8B(restore), modrm, disp8].
        # k: 0=rbx 1=r12 2=r13 3=r14 4=r15. An UNUSED reg (k>=_ra_used_n) is never
        # touched by the body (only the picker writes callee-saved regs, and it didn't
        # assign this one), so among the EMITTED INSTRUCTIONS these 4-byte patterns
        # appear ONLY as its real prologue save + epilogue restore(s) — pattern-scanning
        # finds ALL of them (handles multiple epilogues) with no body false-match.
        #
        # ⚠ v6.5.20 — that argument is about EMITTED INSTRUCTIONS and says nothing about
        # anything else in the range, and since v6.5.20 the range is no longer all
        # instructions: a table-regime `switch` embeds its jump table INLINE as `nent`
        # 4-byte displacements. This walk is UNALIGNED, so it reads those displacement
        # bytes as opcodes, and the four-byte window can straddle an entry pair or the
        # code/table boundary. Nothing about the picker constrains data. The near miss is
        # concrete: `4C 89 | 6D E8` is an exact `mov [rbp-8],r13` window whose second half
        # is the low 16 bits of displacement −6035, an entirely ordinary backward offset
        # from a table to a case body. A match would record a phantom 4-byte NOP run and
        # the compactor would DELETE FOUR BYTES OF THE TABLE — the same silent-miscompile
        # class stage 3b (_sw_tbl_repair) exists to close.
        #
        # An impossibility proof is available in principle — it turns on displacement
        # magnitudes keeping bytes 2-3 at 0x00/0xFF and on which bytes precede each table
        # — but it would have to be re-derived every time either emitter's layout moves,
        # which is precisely the kind of standing obligation that rots. Excluding the
        # range costs one comparison per window and retires the question:
        # `_sw_tbl_hits` refuses any window touching a table. Refusing is safe in the
        # other direction too — a genuine save/restore cannot overlap a table (the
        # dispatch jumps over it), so no real save is ever skipped.
        var rex = 0x4C;   if (k == 0) { rex = 0x48; }
        var modrm = 0x5D; if (k == 1) { modrm = 0x65; }
        if (k == 2) { modrm = 0x6D; }
        if (k == 3) { modrm = 0x75; }
        if (k == 4) { modrm = 0x7D; }
        var disp = 0xF8;  if (k == 1) { disp = 0xF0; }
        if (k == 2) { disp = 0xE8; }
        if (k == 3) { disp = 0xE0; }
        if (k == 4) { disp = 0xD8; }
        var p = fn_start;
        while (p <= lim) {
            var hit = 0;
            if (_swtn == 0 || _sw_tbl_hits(S, _swtn, p) == 0) {
                if (load8(cb + p) == rex) {
                    if (load8(cb + p + 2) == modrm) {
                        if (load8(cb + p + 3) == disp) {
                            var op = load8(cb + p + 1);
                            if (op == 0x89) { hit = 1; }
                            if (op == 0x8B) { hit = 1; }
                            if (hit == 1) {
                                var nc = L64(S + 0x1A2008);
                                if (nc < 1024) {
                                    S64(S + 0x1A2010 + nc * 16, p);
                                    S64(S + 0x1A2010 + nc * 16 + 8, 4);
                                    S64(S + 0x1A2008, nc + 1);
                                }
                            }
                        }
                    }
                }
            }
            if (hit == 1) { p = p + 4; } else { p = p + 1; }
        }
        k = k + 1;
    }
    return 0;
}

# ⛔ 6.7.14 — `Result` / `Option` / `Tagged` are handle classes by NAME only while the program declares no
# struct of that name (lib/result.cyr's and lib/tagged.cyr's are `: stack` enums, which the struct table never
# holds). A program's own `struct Result { a; b; }` is a plain struct, as `_classify_return_type` has always read
# it (FINDSTRUCT first): as a handle its by-value parameter was one word and the caller pushed the first field
# (SIGSEGV on every target). `Str` stays a handle by name (settled). CHANGELOG [6.7.14]
fn _cpt_byname(S, tnoff, c): i64 {
    if (FINDSTRUCT(S, tnoff) > 0) { return 0; }
    return c;
}

# v6.3.5 CO-01 — single source of truth for param-type-name classification.
# Returns the param-type class for a type name at tok_names offset `tnoff`:
#   0 = int / struct / other (no special ABI mask)
#   1 = Str       2 = cstring   3 = Result   4 = Option
#   5 = Tagged    6 = f64v2     7 = f64v4     8 = f32v4     10 = f32v8
#   (9 is `_param_class`'s `*V`; an integer 128-bit vector is its negative descriptor, below)
# Byte-compares over the name pool plus one FINDSTRUCT for the three by-name handles
# (`_cpt_byname`, 6.7.14) and the program's own struct declarations for a vector name (`_cpt_vec`, 6.7.14).
# Extracted verbatim from the PARSE_FN_DEF param loop so the pass-1 signature
# prescan (_prescan_fn_sig) and the pass-2 definition agree byte-for-byte.
fn _classify_param_type(S, tnoff): i64 {
    # Str → "Str\0" (low 32 bits = 0x00727453, little-endian)
    if (L64(S + 0xEC00000 + tnoff) & 0xFFFFFFFF == 0x00727453) { return 1; }
    var b0 = load8(S + 0xEC00000 + tnoff);
    var b1 = load8(S + 0xEC00000 + tnoff + 1);
    var b2 = load8(S + 0xEC00000 + tnoff + 2);
    var b3 = load8(S + 0xEC00000 + tnoff + 3);
    var b4 = load8(S + 0xEC00000 + tnoff + 4);
    var b5 = load8(S + 0xEC00000 + tnoff + 5);
    var b6 = load8(S + 0xEC00000 + tnoff + 6);
    var b7 = load8(S + 0xEC00000 + tnoff + 7);
    # cstring → 'c','s','t','r','i','n','g',0
    if (b0 == 99) { if (b1 == 115) { if (b2 == 116) { if (b3 == 114) {
                    if (b4 == 105) { if (b5 == 110) { if (b6 == 103) { if (b7 == 0) {
                                    return 2;
                                } } } } } } } }
    # Result → 'R','e','s','u','l','t',0
    if (b0 == 82) { if (b1 == 101) { if (b2 == 115) { if (b3 == 117) {
                    if (b4 == 108) { if (b5 == 116) { if (b6 == 0) {
                                return _cpt_byname(S, tnoff, 3);
                            } } } } } } }
    # Option → 'O','p','t','i','o','n',0
    if (b0 == 79) { if (b1 == 112) { if (b2 == 116) { if (b3 == 105) {
                    if (b4 == 111) { if (b5 == 110) { if (b6 == 0) {
                                return _cpt_byname(S, tnoff, 4);
                            } } } } } } }
    # Tagged → 'T','a','g','g','e','d',0
    if (b0 == 84) { if (b1 == 97) { if (b2 == 103) { if (b3 == 103) {
                    if (b4 == 101) { if (b5 == 100) { if (b6 == 0) {
                                return _cpt_byname(S, tnoff, 5);
                            } } } } } } }
    var v = _cpt_vname(S, tnoff);
    if (v == 0) { return 0; }
    return _cpt_vec(S, v);
}

# The vector class of the name at `tnoff` as `_classify_param_type` answers it (f64v2 6, f64v4 7, f32v4 8, f32v8 10, an
# integer 128-bit vector its negative descriptor), by its bytes alone; 0 for any other name.
fn _cpt_vname(S, tnoff): i64 {
    var b0 = load8(S + 0xEC00000 + tnoff);
    var b1 = load8(S + 0xEC00000 + tnoff + 1);
    var b2 = load8(S + 0xEC00000 + tnoff + 2);
    var b3 = load8(S + 0xEC00000 + tnoff + 3);
    var b4 = load8(S + 0xEC00000 + tnoff + 4);
    var b5 = load8(S + 0xEC00000 + tnoff + 5);
    # f64v2 / f64v4 → 'f','6','4','v', '2'|'4', 0
    if (b0 == 102) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) {
                    if (b4 == 50) { if (b5 == 0) { return 6; } }
                    if (b4 == 52) { if (b5 == 0) { return 7; } }
                } } } }
    # f32v4 → 'f','3','2','v','4', 0 — 128-bit; class 8 reuses f64v2's XMM/2-slot ABI
    # (pt_simd_class 1) but tags the param SLTYPE -2121 for op-width dispatch.
    # ⛔ 6.7.13 — f32v8 → 'f','3','2','v','8', 0 — 256-bit; class 10 is f64v4's 32-byte ABI (pt_simd_class 2: two
    # XMM / V registers, mask code 2, a 32-byte copy-in on Win64), its SLTYPE -2153. With no class, `v: f32v8` was a
    # one-word integer parameter and the caller pushed lane 0's word (`load32(&v + 8)` read 0 on every target). The
    # mask code is f64v4's, so the argument check reads the parameter's own type (`_pv32_param`). CHANGELOG [6.7.13]
    if (b0 == 102) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) {
                    if (b4 == 52) { if (b5 == 0) { return 8; } }
                    if (b4 == 56) { if (b5 == 0) { return 10; } }
                } } } }
    # v6.4.7 (Phase 3b) — integer vector value-form params: return the NEGATIVE
    # descriptor sentinel (≤ -2048), distinct from the small positive codes 1-8.
    # The prescan + def-fold detect `c <= -2048` → 16-byte/1-XMM routing (mask 1),
    # SLTYPE = the sentinel. 'i'=105 'u'=117 'v'=118.
    if (b0 == 105) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) { if (b4 == 52) { if (b5 == 0) { return 0 - 2122; } } } } } }  # i32v4
    if (b0 == 117) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) { if (b4 == 52) { if (b5 == 0) { return 0 - 2120; } } } } } }  # u32v4
    if (b0 == 105) { if (b1 == 49) { if (b2 == 54) { if (b3 == 118) { if (b4 == 56) { if (b5 == 0) { return 0 - 2150; } } } } } }  # i16v8
    if (b0 == 117) { if (b1 == 49) { if (b2 == 54) { if (b3 == 118) { if (b4 == 56) { if (b5 == 0) { return 0 - 2148; } } } } } }  # u16v8
    if (b0 == 105) { if (b1 == 56) { if (b2 == 118) { if (b3 == 49) { if (b4 == 54) { if (b5 == 0) { return 0 - 2178; } } } } } }  # i8v16
    if (b0 == 117) { if (b1 == 56) { if (b2 == 118) { if (b3 == 49) { if (b4 == 54) { if (b5 == 0) { return 0 - 2176; } } } } } }  # u8v16
    if (b0 == 105) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) { if (b4 == 50) { if (b5 == 0) { return 0 - 2094; } } } } } }  # i64v2
    if (b0 == 117) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) { if (b4 == 50) { if (b5 == 0) { return 0 - 2092; } } } } } }  # u64v2
    return 0;
}
# v6.3.5 CO-01 — single source of truth for return-type classification.
# Returns the fn_ret_sid encoding for a return-type name at `rt_noff`:
#   > 0  : struct sid (FINDSTRUCT)
#   -1/-2/-4/-8        : scalar i8 / i16 / i32 / i64
#   -16/-17/-18/-19    : Result / Option / Tagged / cstring
#   -20/-21            : f64v2 / f64v4
#   0    : unrecognized (caller raises the "return type must be ..." error)
# Mirrors the param classifier (one FINDSTRUCT call + byte-compares, no other
# global-var refs → cybs-safe). Extracted verbatim from PARSE_FN_DEF so the
# pass-1 _prescan_fn_sig writes the same struct-return / scalar ABI that the
# pass-2 definition does — forward calls to struct-returning fns then emit the
# hidden retptr correctly instead of reading SFRS=0.
# v6.5.21 — parse a MULTI-VALUE return annotation `: (T1, T2[, T3])` and record
# it on the fn. Leaves GTI just past the closing ')'; returns the arity.
# `quiet` = 1 for the pass-1 prescan, which only harvests metadata — PARSE_FN_DEF
# re-parses the same tokens in pass 2 and is where diagnostics fire, so reporting
# in both would double every message.
# Arity is recorded at the DECLARATION on purpose: a fn may mix `return 5;` with
# `return (a, b);` across branches, and a forward call has no body yet, so a
# body-scan could never answer the call site. See GFRN/GFRT in common/util.cyr.
fn _parse_multiret_sig(S, fi, quiet): i64 {
    STI(S, GTI(S) + 1);                     # consume '('
    var n = 0;
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) != 2) { if (PEEKT(S) != 8) { if (PEEKT(S) != 10) { if (PEEKT(S) != 28) {   # 6.7.7: `(`, 6.7.8: `[`
                        ERR_EXPECT(S, 2);
                        return n;
                    } } } }   # refused by _mret_elem
        _bx_mret_note(S, fi, n, GTI(S));   # 6.7.3: a bool element
        var t = _mret_elem(S, fi, quiet);
        if (n < 3) { SFRT(S, fi, n, t); }
        n = n + 1;
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); } else { go = 0; }
    }
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); return n; }
    STI(S, GTI(S) + 1);                     # consume ')'
    if (quiet == 0) {
        if (n < 2) { ERR_MSG(S, "multi-value return needs 2 or 3 types", 37); }
        if (n > 3) { ERR_MSG(S, "multi-value return needs 2 or 3 types", 37); }
    }
    SFRN(S, fi, n);
    SFRS(S, fi, MULTIRET_SID);
    return n;
}

# One element of a multi-value return type (cursor on it), consumed; its return code.
# Unknown element type keeps the token stream in sync as a plain i64 slot
# rather than desyncing the parse — same tactic as the `_syntax_only` arm
# on the single-value path below. 6.6.16 (C8): a name that is no type at all is
# refused by name (it compiled silently as i64); every type name stays accepted.
# 6.6.17: a `*T` element is an i64 slot too (`_ptr_annot`).
# 6.6.17: and an element takes type arguments (`(Box<i64>, i64)`), resolved as a single return
# type's are (`_gtype_sid`): it was `expected ')', got '<'`.
fn _mret_elem(S, fi, quiet): i64 {
    if (_sl_ann_at(S, GTI(S)) == 1) {   # 6.7.8 (C2-6a): `(i64, [u8])` — refused by name, an i64 slot
        if (quiet == 0) {
            _sl_err(S, GTI(S), "a slice cannot be a return type (6.7.8: slices are fn-locals)",
              " - not as a multi-value element either; return its pointer and its length");
        }
        _sl_ann_skip(S);
        return 0 - 8;
    }
    if (PEEKT(S) == 10) {   # 6.7.7 (R3): `((i64, i64), i64)` — a nested tuple, refused by name
        if (quiet == 0) { _tup_pos_refuse(S, "a multi-value return element"); }
        else { STI(S, _call_close(S, GTI(S)) + 1); }
        return 0 - 8;
    }
    if (PEEKT(S) == 8) {
        _ptr_annot(S, 0 - 1, quiet);
        return 0 - 8;
    }
    var t = _classify_return_type(S, PEEKV(S));
    if (t == 0) {
        if (quiet == 0) { _tn_mret_check(S, GTI(S)); }
        t = 0 - 8;
    }
    if (t > 0) {
        if (quiet == 0) { t = _gtype_sid_def(S, fi, t); }   # 6.7.15 (D7): `(Box<Zork>, i64)` read at the definition
        else { t = _gtype_sid(S, fi, t); }
    }
    if (quiet == 0) { _vec_ann_chk(S, GTI(S), 0 - 1); }   # 6.7.14 (D4): `(Vec<T>, i64)` reads T
    STI(S, GTI(S) + 1);                 # consume the type IDENT
    SKIP_GENERICS(S);
    return t;
}

fn _classify_return_type(S, rt_noff): i64 {
    var rt_sid = FINDSTRUCT(S, rt_noff);
    if (rt_sid > 0) { return rt_sid; }
    var b0 = load8(S + 0xEC00000 + rt_noff);
    var b1 = load8(S + 0xEC00000 + rt_noff + 1);
    var b2 = load8(S + 0xEC00000 + rt_noff + 2);
    var b3 = load8(S + 0xEC00000 + rt_noff + 3);
    var b4 = load8(S + 0xEC00000 + rt_noff + 4);
    var b5 = load8(S + 0xEC00000 + rt_noff + 5);
    var b6 = load8(S + 0xEC00000 + rt_noff + 6);
    var b7 = load8(S + 0xEC00000 + rt_noff + 7);
    # scalars: i8 / i16 / i32 / i64 ('i' = 105)
    if (b0 == 105) {
        if (b1 == 56) { if (b2 == 0) { return 0 - 1; } }
        if (b1 == 49) { if (b2 == 54) { if (b3 == 0) { return 0 - 2; } } }
        if (b1 == 51) { if (b2 == 50) { if (b3 == 0) { return 0 - 4; } } }
        if (b1 == 54) { if (b2 == 52) { if (b3 == 0) { return 0 - 8; } } }
    }
    # Result → 'R','e','s','u','l','t',0
    if (b0 == 82) { if (b1 == 101) { if (b2 == 115) { if (b3 == 117) {
                    if (b4 == 108) { if (b5 == 116) { if (b6 == 0) { return 0 - 16; } } } } } } }
    # Option → 'O','p','t','i','o','n',0
    if (b0 == 79) { if (b1 == 112) { if (b2 == 116) { if (b3 == 105) {
                    if (b4 == 111) { if (b5 == 110) { if (b6 == 0) { return 0 - 17; } } } } } } }
    # Tagged → 'T','a','g','g','e','d',0
    if (b0 == 84) { if (b1 == 97) { if (b2 == 103) { if (b3 == 103) {
                    if (b4 == 101) { if (b5 == 100) { if (b6 == 0) { return 0 - 18; } } } } } } }
    # cstring → 'c','s','t','r','i','n','g',0
    if (b0 == 99) { if (b1 == 115) { if (b2 == 116) { if (b3 == 114) {
                    if (b4 == 105) { if (b5 == 110) { if (b6 == 103) { if (b7 == 0) { return 0 - 19; } } } } } } } }
    # v6.4.55: scalar f64 → 'f','6','4',0 — returned in xmm0 (SysV/Win64, NOT retptr).
    # Sentinel -9: free (−1..−8 = int scalars, −16..−19 = Result/Option/Tagged/cstring,
    # the SIMD band is <= −2048). Distinct from f64v2/f64v4 below (byte 3 = 'v' = 118).
    if (b0 == 102) { if (b1 == 54) { if (b2 == 52) { if (b3 == 0) { return 0 - 9; } } } }
    # f64v2 / f64v4 → 'f','6','4','v', '2'|'4', 0 — 128/256-bit descriptor sentinels
    # -2093 (desc 45) / -2125 (desc 77): moved off the flat -20/-21 that collided with
    # struct-ids 20/21 (v6.4.14 struct-sid/SIMD-sentinel fix). Decoded by _vec_desc.
    if (b0 == 102) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) {
                    if (b4 == 50) { if (b5 == 0) { return 0 - 2093; } }
                    if (b4 == 52) { if (b5 == 0) { return 0 - 2125; } }
                } } } }
    # f32v4 → 'f','3','2','v','4', 0 — 128-bit descriptor sentinel -2121 (SIMD Phase 1)
    if (b0 == 102) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) {
                    if (b4 == 52) { if (b5 == 0) { return 0 - 2121; } }
                } } } }
    # f32v8 → 'f','3','2','v','8', 0 — 256-bit descriptor sentinel -2153 (SIMD Phase 4)
    if (b0 == 102) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) {
                    if (b4 == 56) { if (b5 == 0) { return 0 - 2153; } }
                } } } }
    # v6.4.6 (Phase 3a) — integer vector return/param types (128-bit sentinels).
    # 'i'=105 'u'=117 'v'=118. i32v4/u32v4 = i/u,'3','2','v','4'.
    if (b0 == 105) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) { if (b4 == 52) { if (b5 == 0) { return 0 - 2122; } } } } } }  # i32v4
    if (b0 == 117) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) { if (b4 == 52) { if (b5 == 0) { return 0 - 2120; } } } } } }  # u32v4
    # i16v8/u16v8 = i/u,'1','6','v','8'.
    if (b0 == 105) { if (b1 == 49) { if (b2 == 54) { if (b3 == 118) { if (b4 == 56) { if (b5 == 0) { return 0 - 2150; } } } } } }  # i16v8
    if (b0 == 117) { if (b1 == 49) { if (b2 == 54) { if (b3 == 118) { if (b4 == 56) { if (b5 == 0) { return 0 - 2148; } } } } } }  # u16v8
    # i8v16/u8v16 = i/u,'8','v','1','6'.
    if (b0 == 105) { if (b1 == 56) { if (b2 == 118) { if (b3 == 49) { if (b4 == 54) { if (b5 == 0) { return 0 - 2178; } } } } } }  # i8v16
    if (b0 == 117) { if (b1 == 56) { if (b2 == 118) { if (b3 == 49) { if (b4 == 54) { if (b5 == 0) { return 0 - 2176; } } } } } }  # u8v16
    # i64v2/u64v2 = i/u,'6','4','v','2'.
    if (b0 == 105) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) { if (b4 == 50) { if (b5 == 0) { return 0 - 2094; } } } } } }  # i64v2
    if (b0 == 117) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) { if (b4 == 50) { if (b5 == 0) { return 0 - 2092; } } } } } }  # u64v2
    return 0;
}

# v6.3.5 CO-01 — pass-1 fn-signature prescan. Three small helpers that, when
# called from the pass-1 scan (_tl_scan1) in place of the old inline fn-skip, register
# every top-level fn AND record its ABI metadata (param masks, param count,
# variadic flag, struct/scalar return) BEFORE pass-2 emits any call. That makes
# forward calls — a call lexically before its definition — read the correct
# Str / cstring / Result / Option / Tagged / SIMD masks and struct-return ABI
# instead of the mask-0 an auto-registered bare name used to get (the silent
# miscompile CO-01 describes). Structs / enums / globals were already pass-1
# order-independent; this extends the same treatment to fn signatures.
#
# _prescan_skip_fn is the pre-CO-01 body-skip (6.7.7: with the parameter list skipped
# whole first, which moves no cursor a brace-free list ends at), so pass-1's TOKEN CURSOR
# advances exactly as it did before. _prescan_fn_sig extracts metadata on a
# throwaway cursor then RESETS and replays this — registration/mask writes are
# the only new effect, never a change in where pass-1 leaves the cursor.
fn _prescan_skip_fn(S): i64 {
    STI(S, GTI(S) + 1);  # consume FN
    STI(S, GTI(S) + 1);  # consume name
    if (PEEKT(S) == 19) { while (PEEKT(S) != 20 && PEEKT(S) != 12) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
    # 6.7.7: the parameter list as one balanced `( .. )` first, so nothing in a parameter default
    # (a refused `{`) is taken for the body. The same cursor for every list that holds no brace.
    if (PEEKT(S) == 10) {
        var cp = _tok_close_paren(S, GTI(S));
        if (cp > 0) { STI(S, cp + 1); }
    }
    var dep = 0;
    var fsk = 1;
    while (fsk == 1) {
        var ft = PEEKT(S);
        if (ft == 13) { dep = dep + 1; }
        if (ft == 14) { dep = dep - 1; if (dep == 0) { fsk = 0; } }
        if (ft == 12) { fsk = 0; }
        STI(S, GTI(S) + 1);
    }
    return 0;
}

# v6.3.36 (issue [5]) — does param type `tnoff` want a struct POINTER? True for a
# plain struct >8 bytes: _classify_param_type returns 0 for it (not Str/cstring/
# Result/Option/Tagged/SIMD, which are pointer/handle/value-passed), and the callee
# derefs a >8-byte struct param as a pointer (v6.3.16 lf_is_ptr), so the caller must
# address-pass it. Str (and Result/Option/Tagged where no struct takes the name, 6.7.14)
# classify non-zero → excluded (they hold a heap handle, value-passed). Used by both passes
# to build _fnt_structmask consistently, and by PARSE_FNCALL to gate the address push.
# ⛔ 6.6.20 — and for a `p: *S` parameter (`isptr` 1: a `*` preceded the type) at EVERY size of S:
# 6.6.17 (a2) made such a parameter a pointer at every size in the callee, but this bit — the
# caller's "push the address" — was set only over 8 B, so `rd1(s)` with `p: *S1` pushed s's VALUE
# and the callee dereferenced it (SIGSEGV, or a silent read / write through whatever s held),
# while `rd3(a)` with `p: *P3` took `&a`. One rule for both sizes. CHANGELOG [6.6.20]
fn _param_wants_struct_ptr(S, tnoff, isptr): i64 {
    var c = _classify_param_type(S, tnoff);
    if (c != 0) {
        if (isptr == 1) { return _ptc_is_vec(c); }   # 6.7.11: `p: *V` takes an address, as `*S` does
        return 0;
    }
    var sid = FINDSTRUCT(S, tnoff);
    if (sid <= 0) { return 0; }
    if (isptr == 1) { return 1; }
    if (STRUCTSZ(S, sid - 1) <= 8) { return 0; }
    return 1;
}
# ⛔ 6.7.11 — A POINTER TO A VECTOR IS A POINTER PARAMETER. Both scans consumed the `*` of `p: *f64v2`
# and then classified the bare name, so the parameter became a VALUE-form vector (two or four slots
# filled from XMM / V registers, a by-pointer copy-in on Win64) and every caller routed it as one:
# `rd(&b)` was "value-form SIMD arg must be a local IDENT", and `rd(b)` compiled and handed the body a
# vector it dereferenced as an address (SIGSEGV). Behind a `*` a vector class is class 9 here, which
# no mask arm takes: the parameter is one integer word whose step is the vector's size
# (`_mark_ptr_param`), address-passed like `p: *S` (`_param_wants_struct_ptr`), and a vector passed to
# it passes its address (`_sarg_vec_ptr`, the user's decision, 2026-10-13: (a)). The cursor is on the
# type's name in both scans, so the token before it says whether a `*` precedes it. CHANGELOG [6.7.11]
fn _param_class(S, tnoff): i64 {
    var c = _classify_param_type(S, tnoff);
    if (TOKTYP(S, GTI(S) - 1) != 8) { return c; }
    if (_ptc_is_vec(c) == 1) { return 9; }
    return c;
}
# 1 = `_classify_param_type`'s class `c` is a vector (f64v2 / f64v4 / f32v4 / f32v8, an integer 128-bit one).
# 6.7.12 recognised `*f32v8` here through `_ptr_vclass`; f32v8 has its own class since 6.7.13. CHANGELOG [6.7.13]
fn _ptc_is_vec(c): i64 {
    if (c >= 6) { if (c <= 8) { return 1; } }
    if (c == 10) { return 1; }
    if (c <= 0 - 2048) { return 1; }
    return 0;
}
# ... and its descriptor sid (the SLTYPE a vector local of that type carries, negated), or 0.
fn _ptc_vec_sid(c): i64 {
    if (c == 6) { return 2093; }
    if (c == 7) { return 2125; }
    if (c == 8) { return 2121; }
    if (c == 10) { return 2153; }
    if (c <= 0 - 2048) { return 0 - c; }
    return 0;
}
# 1 = the parameter being parsed was declared `name: *T` (`_mark_ptr_param` marked the slot it
# takes next; `_param_record` clears the mark).
# The rough return-type scan (PARSE_FN_DEF, before the parameters): a `: T` type parameter and
# (6.7.3) `: bool` are i64-shaped scalars, never the retptr default that shifts every parameter.
fn _rs_scalar_name(S, fi, noff): i64 {
    if (_is_tparam_of(S, fi, noff) == 1) { return 1; }
    return _bx_is_bool_name(S, noff);
}
fn _ptrp_now(S): i64 {
    if (_cur_fn_ptrp == GFLC(S) + 1) { return 1; }
    return 0;
}
# A type-parameter-typed parameter resolved to struct `sid` is address-passed over 8 B, and
# behind a `*` at every size (`_param_wants_struct_ptr`).
fn _tp_param_addr(S, sid): i64 {
    if (_ptrp_now(S) == 1) { return 1; }
    if (STRUCTSZ(S, sid - 1) > 8) { return 1; }
    return 0;
}

# ⛔ 6.6.11 — BIT 62 OF `_fnt_structmask`: "param 0 is a declared plain struct of 8 B or less,
# passed BY VALUE". The method-call arm (PARSE_FIELD_LOAD) needs it to push the receiver's value
# where it pushes `&x` for an untyped `self` (which IS a pointer) and for a > 8 B one (address-
# passed); without it `x.sum()` with `self: Odd` handed the callee an address. Read from the
# tokens of param 0 by BOTH passes (`_prescan_params`, PARSE_FN_DEF), so they cannot disagree.
# A spare bit, not a new table, so the brk layout does not move; the per-param readers test
# `1 << argc` and the whole-mask readers go through `_smask_args`. A generic `self: Box<T>` is
# left unflagged. `lp` = the `(` token. CHANGELOG [6.6.11]
fn _selfbv_bit(S, lp): i64 {
    if (TOKTYP(S, lp + 1) != 2) { return 0; }
    if (TOKTYP(S, lp + 2) != 49) { return 0; }
    if (TOKTYP(S, lp + 3) != 2) { return 0; }
    if (TOKTYP(S, lp + 4) == 19) { return 0; }
    var tnoff = TOKVAL(S, lp + 3);
    var sid = _selfbv_tp(S, tnoff);
    if (sid == 0) {
        if (_classify_param_type(S, tnoff) != 0) { return 0; }
        sid = FINDSTRUCT(S, tnoff);
    }
    if (sid <= 0) { return 0; }
    if (STRUCTSZ(S, sid - 1) > 8) { return 0; }
    return 1 << 62;
}
# An instance's `self: V` (V a type parameter): the type V is bound to, read before PARSE_FN_DEF binds
# it — `p.me()` calls `P_me$P` (`_mcall_gen`), and a <= 8 B P is passed by value. 0 elsewhere.
# CHANGELOG [6.7.11]
fn _selfbv_tp(S, tnoff): i64 {
    if (_inst_conc0 == 0) { if (_inst_conc1 == 0) { return 0; } }
    if (_inst_base_fi < 0) { return 0; }
    var tp = GFTP(S, _inst_base_fi);
    if (tnoff == (tp & 0xFFFFFFFF) - 1) { return _inst_conc0; }
    if (tnoff == ((tp >> 32) & 0xFFFFFFFF) - 1) { return _inst_conc1; }
    return 0;
}
# 6.6.17 (a10): nonzero when ANY parameter is address-passed, an overflow-row one included.
fn _smask_args(fi): i64 {
    var m = L64(_fnt_structmask + fi * 8) & ((1 << 62) - 1);
    if (m != 0) { return m; }
    return _pm_row_any(fi, 1);
}
# ⛔ 6.6.17 (a10) — PER-PARAMETER KINDS PAST THE i64 MASKS. Each per-fn mask holds one bit per
# parameter ordinal — `_fnt_structmask` keeps bit 62 for `_selfbv_bit`, so ordinals 0..61; the
# SysV `_fnt_simdmask` two bits each, so 0..30 — and `1 << pc` WRAPS at 64 on x86 (the count is
# taken mod 64). In a 70-parameter fn, parameter 66's struct bit landed on parameter 2 and
# parameter 67's `: Str` bit on parameter 3, so a struct local passed to 2 went by address and a
# string literal passed to 3 was `str_from`-wrapped; a struct parameter AT ordinal 62 was never
# address-passed (`_smask_args` masks bit 62 off). An ordinal past a mask's range now lives in the
# fn's overflow row (util.cyr `_pm_row_*`), written by `_pmw` / `_pmw2` at every mask write and
# read by `_pm_struct` / `_pm_str` / `_pm_cstr` / `_pm_simd` at every per-ordinal read. No
# parameter-count limit: the row grows. Row kinds: 1 struct (address-passed), 2 Str, 4 cstring,
# 8 Result, 16 Option, 32 Tagged, (SIMD code) << 6. The fn is `_cur_fn_ix` (the definition being
# parsed; `_prescan_params` sets it for pass 1). CHANGELOG [6.6.17]
fn _pmw(m, pc, k): i64 {
    if (pc < 62) { return m | (1 << pc); }
    _pm_row_or(_cur_fn_ix, pc, k);
    return m;
}
fn _pmw2(m, pc, code): i64 {
    if (pc < 31) { return m | (code << (pc * 2)); }
    _pm_row_or(_cur_fn_ix, pc, code << 6);
    return m;
}
fn _pm_bit(fi, mask, argc, k): i64 {
    if (argc < 62) { return (mask >> argc) & 1; }
    if ((_pm_row_get(fi, argc) & k) != 0) { return 1; }
    return 0;
}
fn _pm_struct(fi, argc): i64 { return _pm_bit(fi, L64(_fnt_structmask + fi * 8), argc, 1); }
fn _pm_str(fi, argc): i64 { return _pm_bit(fi, L64(_fnt_strmask + fi * 8), argc, 2); }
fn _pm_cstr(fi, argc): i64 { return _pm_bit(fi, L64(_fnt_cstrmask + fi * 8), argc, 4); }
fn _pm_simd(fi, argc): i64 {
    if (fi < 0) { return 0; }
    if (argc < 31) { return (L64(_fnt_simdmask + fi * 8) >> (argc * 2)) & 3; }
    return (_pm_row_get(fi, argc) >> 6) & 3;
}
fn _fn_self_byval(fi): i64 {
    if (fi < 0) { return 0; }
    return (L64(_fnt_structmask + fi * 8) >> 62) & 1;
}
# 6.6.20 — 1 when fn `fi` COPIES its parameter `argc` into its own frame in its prologue: a
# by-value struct over 8 B (`p: T`, `_sptr_params_localize`) or, on Win64, a value-form vector
# (ESTOREPARM_SIMD_WIN64). An address the caller pushes for such an argument is read by that copy
# and held by nothing once the call returns. Recorded by pass 1 (`_bvcp_note`), so a call parsed
# before the definition knows it, and again, exactly, where the definition emits the copy
# (`_sptr_params_localize` — a generic's instance, which pass 1 never sees, included; never for a
# redefined fn, whose calls all reach the LAST definition pass 1 recorded). 0 for a `*T`
# or untyped parameter, a `#naked` or `async` fn (pass 1: `_prescan_fn_sig`) and a fn neither pass
# has recorded. ⚠ Pass 1 must never record a copy the definition does not make — a call parsed
# before the definition would keep a `jmp` that the callee's pointer outlives (checked over the
# tcyr corpus and programs/, x86 and PE, at 6.6.20).
# ⛔ 6.7.9 — an ordinal past 61 is in the fn's copies row (util.cyr `_bvhi_*`): this answered 0
# there, so a by-value struct at parameter 62+ was never copied where it stands — `r62(.., b,
# bump(&b))` read 11 where 1 is right — and its address escaped (`_sarg_escapes`). Issue
# 2026-10-09-by-value-copy-mask-62-parameter-limit. CHANGELOG [6.7.9]
fn _pm_copies(fi, argc): i64 {
    if (argc >= 62) { return _bvhi_get(fi, argc); }
    return (GFBVCP(fi) >> argc) & 1;
}
# Parameter `pc` of fn `fi` is copied in: its bit in the mask `m`, or past 61 its byte in the row.
fn _bvcp_bit(fi, m, pc): i64 {
    if (pc < 62) { return m | (1 << pc); }
    _bvhi_set(fi, pc);
    return m;
}
# Pass 1, no copy for fn `fi` (`async`, a possible `#naked`): the mask and the row both cleared.
fn _bvcp_none(fi): i64 {
    SFBVCP(fi, 0);
    return _bvhi_reset(fi);
}
# Pass 1's half: parameter `pc`, cursor on its type name, `smask` the struct mask with this
# parameter's bit already decided, `inst` its struct (the instance for a generic) or <= 0.
# Mirrors `_local_is_sptr_param`'s test: address-passed, not a `*T`, not a handle (`Str` /
# `Result` / `Option` / `Tagged` — they never take the bit), and a plain struct or a Win64 vector.
# Past ordinal 61 the address-passed bit is the kind row's (`_psid_addr`) and the copy goes to the
# copies row (`_bvcp_bit`) — `_cur_fn_ix` is the fn being scanned (`_prescan_params`).
fn _bvcp_note(S, m, smask, pc, inst): i64 {
    if (_psid_addr(_cur_fn_ix, pc, smask) == 0) { return m; }
    if (TOKTYP(S, GTI(S) - 1) == 8) { return m; }
    var c = _classify_param_type(S, PEEKV(S));
    if (c == 0) {
        if (inst > 0) { return _bvcp_bit(_cur_fn_ix, m, pc); }
        return m;
    }
    if (_TARGET_PE == 0) { return m; }
    if (_ptc_is_vec(c) == 1) { return _bvcp_bit(_cur_fn_ix, m, pc); }   # 6.7.13: f32v8 too
    return m;
}
# 1 when a `#naked` may apply to the fn whose `fn` token is `ti`: a token 133 anywhere after the
# previous definition's `fn NAME`. Pass 2 hands a pending `#naked` to the NEXT PARSE_FN_DEF wherever
# it was armed (even inside the previous fn's body), so this is a superset of pass 2's answer — the
# safe direction for `_pm_copies`. A `#naked` fn has no frame to copy into.
fn _prescan_maybe_naked(S, ti): i64 {
    var j = ti - 1;
    while (j >= 0) {
        var t = TOKTYP(S, j);
        if (t == 133) { return 1; }
        if (t == 32) { if (TOKTYP(S, j + 1) == 2) { return 0; } }
        j = j - 1;
    }
    return 0;
}
# ⛔ 6.6.20 — THIS FN PUSHES AN ADDRESS IN ITS OWN FRAME as argument `argc` of `fi`. It escapes
# (`_fn_local_addr`, which costs every later tail call in the fn) unless nothing can hold it once
# the call returns: an ordinary call whose callee copies that parameter (`_pm_copies`). A tail
# call's own argument (`tail` = 1) always escapes — the `jmp` frees the frame before the callee's
# copy runs. The rules are above `_tc_after_args_divert`. CHANGELOG [6.6.20]
fn _sarg_escapes(fi, argc, tail): i64 {
    if (tail == 0) { if (_pm_copies(fi, argc) == 1) { return 0; } }
    _fn_local_addr = 1;
    return 0;
}

# ⛔ 6.7.7 — A BY-VALUE ARGUMENT IS ITS VALUE WHERE IT IS WRITTEN. A parameter the callee copies in
# its prologue (`_pm_copies`: a plain struct over 8 B, a Win64 value-form vector) is passed as an
# ADDRESS, and that copy runs after EVERY argument of the call was evaluated — so a later argument
# that wrote the struct was seen by the callee: `rd(b, bump(&b))` read `b.a` as 11 where 1 is
# right, for a local, a global, a field, a capture, a pointer-mode local and `&b` alike, through a
# method's argument or its by-value `self`, a named argument, a tail call and an operator's left
# operand, on every backend. A value-form vector loaded into its register after the integer
# arguments (SysV, aarch64, cx: `_simd_arg_second_pass`) the same. When a later argument may write
# memory (`_span_may_write`), the argument is copied where it stands — into a frame temporary, at
# top level a hidden global — and that copy's address is what the callee receives (a vector: what
# its register is loaded from). When none can, nothing is emitted: the common call is unchanged.
# Issue 2026-10-09-struct-arg-sees-later-arg-side-effect. CHANGELOG [6.7.7]
# 1 = token type `t` ends an operand a `(` after it calls: a name, `)`, `]`, a type argument's `>`.
fn _tok_calls(t): i64 {
    if (t == 2 || t == 11 || t == 29) { return 1; }
    if (t == 20 || t == 39 || t == 152) { return 1; }
    return 0;
}
# 1 = token type `t` runs nothing: a literal (number / char, string, float, `true` / `false`), `.`,
# `)` `[` `]`, a comparison, `& | ^ ~ % << >> >>>`, `&& || !`, and a closure's bars and the `,`
# between its parameters (the only depth-0 `,` an argument holds) — never an operator a struct
# dispatches (`+ - * /`, `_span_may_write`). A subscript stays pure under the bounds-checked mode
# (6.7.8): its check reads the index and exits or returns it — it never writes.
fn _tok_pure(t): i64 {
    if (t == 1 || t == 30 || t == 61 || t == 169 || t == 170) { return 1; }
    if (t == 41 || t == 11 || t == 28 || t == 29 || t == 31) { return 1; }
    if (t >= 17) { if (t <= 22) { return 1; } }
    if (t >= 34) { if (t <= 39) { return 1; } }
    if (t == 27 || t == 53 || t == 54 || t == 152 || t == 171) { return 1; }
    return 0;
}
# 1 = the name at token `i` with its `.field` chain reads a STRUCT value — an operand `+ - * /`
# dispatches on: a struct-typed name with no chain, or a chain ending at a struct-typed field.
# `acc + p.c` reads an integer field: 0 (a copy there cost a self tail call its `jmp`). A chain
# this does not follow (`t.0`, an unknown field) answers 1.
fn _name_struct_val(S, i): i64 {
    var sid = _sarg_name_sid(S, i);
    if (sid <= 0) { return 0; }
    var j = i + 1;
    while (TOKTYP(S, j) == 41) {
        if (TOKTYP(S, j + 1) != 2) { return 1; }
        var fi = FINDFIELD(S, sid - 1, TOKVAL(S, j + 1));
        if (fi < 0) { return 1; }
        sid = GETFTYPE(S, sid - 1, fi);
        if (sid <= 0) { return 0; }
        j = j + 2;
    }
    return 1;
}
# 1 = evaluating the tokens [q, e) — one argument (its `name:` label skipped) or an operand — may
# write memory: a call (`_tok_calls` before a `(`), any token `_tok_pure` does not name (an
# assignment, a block or struct literal, a builtin, `?`, `if`, ...), or `+ - * /` beside a struct
# value (`_name_struct_val`), which dispatches that struct's operator fn. Conservative: a 1 costs a
# copy.
fn _span_may_write(S, q, e): i64 {
    if (_pd_label_at(S, q) == 1) { q = q + 2; }
    var op = 0;
    var sn = 0;
    var i = q;
    while (i < e) {
        var t = TOKTYP(S, i);
        if (t == 10) {
            if (i > q) { if (_tok_calls(TOKTYP(S, i - 1)) == 1) { return 1; } }
        } elif (t == 2) {
            if (TOKTYP(S, i - 1) != 41) { if (_name_struct_val(S, i) == 1) { sn = 1; } }
        } elif (t >= 6 && t <= 9) { op = 1; }
        elif (t == 113 || t == 116) { op = 1; }   # `+%` / `-%` are `+` / `-`
        elif (_tok_pure(t) == 0) { return 1; }
        i = i + 1;
    }
    if (op == 1) { if (sn == 1) { return 1; } }
    return 0;
}
# 1 = an argument from token `q` (just past the call's `(` or a `,`) to the call's `)` may write.
fn _args_may_write(S, q): i64 {
    if (TOKTYP(S, q) == 11) { return 0; }
    var n = GTCNT(S);
    while (q < n) {
        var e = _arg_next(S, q);
        if (_span_may_write(S, q, e) == 1) { return 1; }
        if (TOKTYP(S, e) != 31) { return 0; }
        q = e + 1;
    }
    return 0;
}
# ... an argument after the one at the cursor.
fn _later_args_may_write(S): i64 {
    var e = _arg_next(S, GTI(S));
    if (TOKTYP(S, e) != 31) { return 0; }
    return _args_may_write(S, e + 1);
}
# From token `q`: the first `,` `)` `]` `}` `;` outside `( [ {`, or the EOF token — where the
# expression holding `q` ends (an operator's right operand ends there or before).
fn _tok_expr_end(S, q): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (q < n) {
        var t = TOKTYP(S, q);
        if (t == 12) { return q; }
        if (d == 0) {
            if (t == 31 || t == 11 || t == 29 || t == 14 || t == 5) { return q; }
        }
        if (t == 10 || t == 28 || t == 13) { d = d + 1; }
        if (t == 11 || t == 29 || t == 14) { d = d - 1; }
        q = q + 1;
    }
    return q;
}
# The local type of parameter `k` of `fi`'s struct (-sid; the instance's for a generic), or 0.
fn _snap_ps_ty(S, fi, k): i64 {
    var ps = GFPSID(S, fi, k);
    if (ps <= 0) { return 0; }
    if (ps >= 2048) { return 0; }
    return 0 - ps;
}
# The type of the vector local the argument at token `ti` names (inside any parentheses), or 0 —
# a Win64 vector argument, which travels by address.
fn _snap_vec_ty(S, ti): i64 {
    if (GINFN(S) != 1) { return 0; }
    while (TOKTYP(S, ti) == 10) { ti = ti + 1; }
    if (TOKTYP(S, ti) != 2) { return 0; }
    var li = FINDLOCAL(S, TOKVAL(S, ti));
    if (li < 0) { return 0; }
    var lt = GLTYPE(S, li);
    if (_is_simd_any(S, lt) == 0) { return 0; }
    return lt;
}
# ⛔ 6.7.14 — a Win64 value-form vector parameter given a closure's captured vector (D31) or a dereference `*pb` (D32)
# is passed the address of its env words / the pointer, which the callee copies in its prologue — after every argument:
# a later argument writing it (`two(b, setb(&b, 7))`, `two(*pb, setb(pb, 7))`) reached the callee, where SysV /
# AAPCS64 / cx copy the vector where the argument stands.
# The copy's type, the parameter's own vector (the class rule admits only its size), as `_snap_vec_ty` gives a local's;
# 0 = no such argument at the cursor. CHANGELOG [6.7.14]
fn _snap_pvf_ty(S, fi, argc): i64 {
    var c = _pwrap_in(S, GTI(S));
    if (c < 0) { return 0; }
    if (TOKTYP(S, c) != 8) { if (_spv_cap(S, c) == 0) { return 0; } }   # (D32) and a `*E`: its pointer is pushed
    return 0 - _pvf_param(S, fi, argc);
}
# The local type of the copy argument `argc` of `fi` (the cursor on it) takes where it stands, or
# 0 when it takes none: the callee does not copy that parameter, or no later argument may write.
fn _sarg_snap_ty(S, fi, argc): i64 {
    if (fi < 0) { return 0; }
    if (_pm_copies(fi, argc) == 0) { return 0; }
    var ty = _snap_ps_ty(S, fi, argc);
    if (ty == 0) { ty = _snap_vec_ty(S, GTI(S)); }
    if (ty == 0) { ty = _snap_pvf_ty(S, fi, argc); }   # 6.7.14 (D31, D32): a capture / `*pb`, Win64 value-form
    if (ty == 0) { return 0; }
    if (_later_args_may_write(S) == 0) { return 0; }
    return ty;
}
# The slots a copy of local type `ty` spans: a vector's, else its struct's, rounded up to words.
fn _snap_slots(S, ty): i64 {
    if (_is_simd_any(S, ty) == 1) { if (_vec_desc(S, ty) == 1) { return _vd_nslots; } }
    return (STRUCTSZ(S, (0 - ty) - 1) + 7) / 8;
}
# The argument just pushed — an address its callee copies through — copied HERE into storage of
# type `ty` whose address replaces it on the stack: a frame temporary, or at top level (no frame)
# a hidden global. A frame temporary passed to a tail call (`tail` 1) makes that one call an
# ordinary one (`_tc_snap_div`); the callee copies it in its prologue, so nothing holds it after
# the call and it is not `_fn_local_addr` (`_sarg_escapes` is a no-op for a copying callee, the
# only kind that gets here). Byte-exact (`_agc_copy_bytes`): an odd-size struct reads no byte past
# itself.
fn _sarg_snap(S, tail, ty): i64 {
    var n = _snap_slots(S, ty);
    var nb = n * 8;
    if (_is_simd_any(S, ty) == 0) { nb = STRUCTSZ(S, (0 - ty) - 1); }
    EPOPR(S);
    var p = _HTEMP(S);
    _HTSTORE(S, p);
    if (p >= 0) {
        if (p + 1 > _flc_hwm) { _flc_hwm = p + 1; }
        var t = _agg_temp_t(S, n, ty);
        _agc_copy_bytes(S, t, 0 - 1, _AGC_DREF(p), 0 - 1, nb);
        if (tail == 1) { _tc_snap_div = 1; }
        EFLADDR(S, t);
    } else {
        var gv = 0 - 2 - _HTEMP(S);
        S64(_vars_base + gv * 8, n * 8);
        _agc_copy_bytes(S, 0 - 1, gv, 0 - 1, 0 - 1000 - (0 - 2 - p), nb);
        EVADDR(S, gv);
    }
    EPUSHR(S);
    return 0;
}
# One int-class argument `argc` of `fi`, pushed — the struct-address arms (`_try_push_struct_addr_arg`),
# else its value — then copied where it stands when the callee copies it and a later argument may
# write it. Shared by `_call_arg_one` and the tail arm (`tail` 1).
fn _arg_push_snap(S, fi, argc, noff, tail): i64 {
    var ty = _sarg_snap_ty(S, fi, argc);
    if (_try_push_struct_addr_arg(S, fi, argc, tail) == 0) {
        _bx_pcmpe_arg(S, fi, argc, noff);
        EPUSHR(S);
    }
    if (ty != 0) { _sarg_snap(S, tail, ty); }
    return 0;
}
# A method's `self` just pushed for `fi` (the cursor on the call's `(`; `sid` the receiver's struct):
# copied where it stands when `fi` copies a by-value `self` and an argument may write it.
fn _self_snap(S, fi, sid): i64 {
    if (fi < 0) { return 0; }
    if (_pm_copies(fi, 0) == 0) { return 0; }
    var ty = _snap_ps_ty(S, fi, 0);
    if (ty == 0) { if (sid > 0) { ty = 0 - sid; } }
    if (ty == 0) { return 0; }
    if (_args_may_write(S, GTI(S) + 1) == 0) { return 0; }
    return _sarg_snap(S, 0, ty);
}
# An operator's left operand just pushed for operator fn `fi` (the cursor on the right operand):
# copied where it stands when `fi` copies it and the right operand may write it.
fn _op_lhs_snap(S, fi): i64 {
    if (fi < 0) { return 0; }
    if (_pm_copies(fi, 0) == 0) { return 0; }
    var ty = _snap_ps_ty(S, fi, 0);
    if (ty == 0) { return 0; }
    var q = GTI(S);
    if (_span_may_write(S, q, _tok_expr_end(S, q)) == 0) { return 0; }
    return _sarg_snap(S, 0, ty);
}
# A value-form vector recorded for its register (entry `i` of `tbl`, `_simd_arg_record`), which is
# loaded after every integer argument (`_simd_arg_second_pass`): copied here into a frame temporary
# of its type, recorded in its place. The caller asks only when a later argument may write it.
fn _simd_arg_snap(S, tbl, i): i64 {
    var lli = load64(tbl + i * 24);
    if (lli < 0) { return 0; }
    var lt = GLTYPE(S, lli);
    if (_vec_desc(S, lt) != 1) { return 0; }
    var n = _vd_nslots;
    var t = _agg_temp_t(S, n, lt);
    _agc_copy_bytes(S, t, 0 - 1, lli, 0 - 1, n * 8);
    store64(tbl + i * 24, t);
    return 0;
}

# 6.6.12 — record the struct id of an ADDRESS-passed struct parameter (see SFPSID, util.cyr).
# 6.7.3: and of a plain one passed by value (8 B or less) or a `Str` handle (`_psid_plain`), for
# the argument type check — so a recorded id no longer means address-passed (readers test
# `_pm_struct`). CHANGELOG [6.7.3]
fn _psid_note(S, fi, pc, sid, mask): i64 {
    if (_psid_addr(fi, pc, mask) == 0) { if (_psid_plain(S, sid) == 0) { return 0; } }
    return SFPSID(S, fi, pc, sid);
}
# ⛔ 6.7.7 (B4) — A TUPLE PARAMETER (`t: (i64, f64)`). A tuple is an anonymous struct of 8-byte slots
# and at least 16 B, so it takes the by-value struct path whole: ADDRESS-passed (the struct-mask
# bit), copied in the callee's prologue (`_sptr_params_localize`), its sid recorded for the argument
# check (`_psid_note`) and on the slot (SLTYPE = -sid). Both passes need the arm: pass 1 stopped at
# the `(` — a short parameter count and a mask-0 ABI, so a call parsed before the definition pushed
# the tuple's first word where the callee dereferences an address. `*( .. )` is refused by name (a
# tuple is never a pointer target), and pass 1 steps over it quietly. CHANGELOG [6.7.7]
var _tup_pt = 0;   # pass 2: the tuple parameter's sid (0 = refused); pass 1: the same, for `_tup_bvcp`
# Pass 2 (PARSE_FN_DEF), cursor on the type's `(`: returns the struct mask with parameter `pc`'s
# bit set, `_tup_pt` the sid; the cursor is left ON the `)` for the loop's shared step past the type.
fn _tup_param(S, pc, smask): i64 {
    _tup_pt = 0;
    if (_ptrp_now(S) == 1) {
        _tup_pos_refuse(S, "a pointer target `*( .. )`");
        STI(S, GTI(S) - 1);
        return smask;
    }
    _tup_pt = _tup_type(S, 0);
    if (_tup_pt <= 0) { return smask; }
    return _pmw(smask, pc, 1);
}
# Pass 1 (`_prescan_params_scan`), cursor on the `(`: the same mask and record, interned quietly;
# the cursor is left PAST the `)`.
fn _tup_pscan(S, fi, pc, smask, isptr): i64 {
    _tup_pt = 0;
    if (isptr == 1) {
        STI(S, _call_close(S, GTI(S)) + 1);
        return smask;
    }
    _tup_pt = _tup_type(S, 2);
    if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); }
    if (_tup_pt <= 0) { return smask; }
    var m = _pmw(smask, pc, 1);
    _psid_note(S, fi, pc, _tup_pt, m);
    return m;
}
# ... and its prologue copy (`_bvcp_note`'s plain-struct answer): every tuple parameter is copied in.
fn _tup_bvcp(m, pc): i64 {
    if (_tup_pt <= 0) { return m; }
    return _bvcp_bit(_cur_fn_ix, m, pc);
}
fn _psid_addr(fi, pc, mask): i64 {
    if (pc < 62) { return (mask >> pc) & 1; }
    return _pm_row_get(fi, pc) & 1;   # 6.6.17 (a10): the overflow row
}
# 6.7.3 — a struct parameter WITHOUT the address-passed bit that still names a struct: a plain one
# (8 B or less, BY VALUE) or a heap handle (`Str` / `Result` / `Option` / `Tagged`, value-passed
# pointers) — the receive path refuses `var s: Str = p` for a handle too. A vector (classes 6-8,
# the descriptor band) is never recorded. CHANGELOG [6.7.3]
fn _psid_plain(S, sid): i64 {
    if (sid <= 0) { return 0; }
    if (sid >= 2048) { return 0; }
    var c = _classify_param_type(S, L64(S + 0x1A6018 + (sid - 1) * 8));
    if (c == 0) { return 1; }
    if (c == 2) { return 0; }
    if (c > 5) { return 0; }
    if (c < 0) { return 0; }
    return 1;
}
# Pass 2's write (PARSE_FN_DEF): a REDEFINED fn's by-value record is left as pass 1 wrote it — the
# LAST definition's, which every call reaches (`_fn_redirect`) — since a second definition taking
# another plain struct of 8 B or less passes the signature check (no mask tells the two apart), and
# writing the earlier one's here mis-checked the calls between the two. CHANGELOG [6.7.3]
fn _psid_def_note(S, fi, pc, sid, mask): i64 {
    if (_psid_addr(fi, pc, mask) == 0) { if ((GFLG(S, fi) & 2048) != 0) { return 0; } }
    return _psid_note(S, fi, pc, sid, mask);
}
# Pass 1's half: a parameter typed with struct `base` — its address-passed bit follows the
# instance (`_gtype_param_mask`), and the sid is recorded. Returns the instance sid; the updated
# mask is the second return, `_psid_mask` (read it immediately).
var _psid_mask = 0;
fn _psid_scan(S, fi, pc, base, mask, isptr): i64 {
    var inst = _gtype_sid(S, fi, base);
    _psid_mask = _gtype_param_mask(S, mask, pc, base, inst, isptr);
    _psid_note(S, fi, pc, inst, _psid_mask);
    return inst;
}

# Scan the param list `( ... )` for fn `fi`, computing the per-fn ABI masks the
# same way PARSE_FN_DEF's param loop does (shared _classify_param_type → first
# match sets one mask at bit `pc`; SIMD uses 2 bits at pc*2), plus the param
# count and variadic flag. No slot allocation / no ESTOREPARM — pass-1 records
# metadata only. Leaves the cursor just past `)` (throwaway; caller resets).
# 6.6.17 (a10): the overflow-row writes (`_pmw`) name the fn through `_cur_fn_ix`, which pass 1
# does not otherwise set — set for the scan, then put back.
fn _prescan_params(S, fi): i64 {
    var sv = _cur_fn_ix;
    _cur_fn_ix = fi;
    _bvhi_reset(fi);   # 6.7.9: the scan's copies past ordinal 61 replace the last record (`_bvcp_bit`)
    _prescan_params_scan(S, fi);
    _cur_fn_ix = sv;
    return 0;
}
fn _prescan_params_scan(S, fi): i64 {
    if (PEEKT(S) != 10) { return 0; }   # no '(' — malformed; pass-2 will ERR
    var pdo = GTI(S);                   # 6.7.7 (B6): the list's `(`, for `_pd_record_at`
    STI(S, GTI(S) + 1);                 # consume '('
    _bx_fn_reset(S, fi);                # 6.7.3: this definition's bool facts are recorded afresh
    var pc = 0;
    var str_mask = 0;
    var cstring_mask = 0;
    var result_mask = 0;
    var option_mask = 0;
    var tagged_mask = 0;
    var simd_mask = 0;
    var struct_mask = _selfbv_bit(S, GTI(S) - 1);   # 6.6.11: bit 62, see there
    var bvcp = 0;                                    # 6.6.20: see `_pm_copies`
    if (PEEKT(S) != 11) {
        var pgo = 1;
        while (pgo == 1) {
            if (PEEKT(S) == 112) {          # variadic '...'
                STI(S, GTI(S) + 1);
                SFVA(S, fi, 1);
                pgo = 0;
            } else {
                if (PEEKT(S) == 2) {                         # param name
                    var _pnm = PEEKV(S);
                    STI(S, GTI(S) + 1);
                    if (pc == 0) { if (PEEKT(S) != 49) { struct_mask = _iself_prescan(S, fi, _pnm, struct_mask); } }   # 6.7.0 (A4)
                }
                if (PEEKT(S) == 49) {                        # ': Type'
                    STI(S, GTI(S) + 1);                      # consume ':'
                    var _pptr = 0;
                    if (PEEKT(S) == 8) { STI(S, GTI(S) + 1); _pptr = 1; }   # skip '*' (pointer)
                    if (PEEKT(S) == 10) {                    # 6.7.7 (B4): a tuple `( .. )`
                        struct_mask = _tup_pscan(S, fi, pc, struct_mask, _pptr);
                        bvcp = _tup_bvcp(bvcp, pc);
                    } elif (PEEKT(S) == 2) {
                        var c = _param_class(S, PEEKV(S));   # 6.7.11: a `*V` is a pointer
                        if (c == 1) { str_mask = _pmw(str_mask, pc, 2); }
                        elif (c == 2) { cstring_mask = _pmw(cstring_mask, pc, 4); }
                        elif (c == 3) { result_mask = _pmw(result_mask, pc, 8); }
                        elif (c == 4) { option_mask = _pmw(option_mask, pc, 16); }
                        elif (c == 5) { tagged_mask = _pmw(tagged_mask, pc, 32); }
                        # v6.4.31: Win64 (PE) passes __m128 / any >8B vector BY
                        # POINTER in an int arg reg (MS x64 ABI), so a value-form
                        # SIMD param is address-passed like a plain struct >8B —
                        # set struct_mask (drives the caller's &local push), NOT
                        # simd_mask (which would XMM-route it, the SysV path).
                        elif (c == 6) { if (_TARGET_PE == 1) { struct_mask = _pmw(struct_mask, pc, 1); } else { simd_mask = _pmw2(simd_mask, pc, 1); } }
                        # f64v4, and (6.7.13) f32v8: 32-byte, mask 2
                        elif (c == 7 || c == 10) { if (_TARGET_PE == 1) { struct_mask = _pmw(struct_mask, pc, 1); } else { simd_mask = _pmw2(simd_mask, pc, 2); } }
                        elif (c == 8) { if (_TARGET_PE == 1) { struct_mask = _pmw(struct_mask, pc, 1); } else { simd_mask = _pmw2(simd_mask, pc, 3); } }  # f32v4 (16-byte; mask=3 distinguishes from f64v2=1)
                        elif (c <= 0 - 2048) { if (_TARGET_PE == 1) { struct_mask = _pmw(struct_mask, pc, 1); } else { simd_mask = _pmw2(simd_mask, pc, 1); } }  # v6.4.7: integer 128-bit vector → 16-byte/1-XMM (mask 1)
                        # v6.3.36 (issue [5]) — plain struct >8 B param → address-passed.
                        if (_param_wants_struct_ptr(S, PEEKV(S), _pptr) == 1) { struct_mask = _pmw(struct_mask, pc, 1); }
                        # 6.6.10: `r: Box<Pt>` — the instance's size decides (see _gtype_sid).
                        var _pb = FINDSTRUCT(S, PEEKV(S));
                        if (_pb > 0) { _pb = _psid_scan(S, fi, pc, _pb, struct_mask, _pptr); struct_mask = _psid_mask; }
                        bvcp = _bvcp_note(S, bvcp, struct_mask, pc, _pb);
                        if (_pptr == 0) { _bx_pscan(S, fi, pc); }   # 6.7.3: a bool parameter
                        STI(S, GTI(S) + 1);                  # consume type name
                        SKIP_GENERICS(S);                    # `: Vec<i64>` etc.
                    } elif (PEEKT(S) != 12) {
                        # 6.7.7: a type token that is not a name (`u128`, the `fn` of `*fn`), taken
                        # as pass 2 takes it — stopping here counted the list short. A tuple type is
                        # stepped whole above (the token after it is the list's own). CHANGELOG [6.7.7]
                        # 6.7.8 (C2-6a): and a slice's whole `[ .. ]` (pass 2 refuses it by name).
                        # 6.7.11: the whole type, by pass 2's reader (`**T`, `*fn( .. ): T`, a refused token).
                        _param_type_step_q(S);
                    }
                }
                if (PEEKT(S) == 4) { STI(S, _pl_dflt_end(S, GTI(S))); }   # 6.7.7 (B6): a default (recorded below)
                pc = pc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }  # comma → next param
                else { pgo = 0; }
            }
        }
    }
    # Consume the closing ')' so the caller's return-type scan sees the ':' (or
    # '{') next — without this the cursor sits on ')' and `: Struct` returns are
    # never classified (struct-return forward calls would keep the mask-0 ABI).
    if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); }
    S64(_fnt_params + fi * 8, pc);
    S64(_fnt_strmask + fi * 8, str_mask);
    S64(_fnt_cstrmask + fi * 8, cstring_mask);
    S64(_fnt_resmask + fi * 8, result_mask);
    S64(_fnt_optmask + fi * 8, option_mask);
    S64(_fnt_tagmask + fi * 8, tagged_mask);
    S64(_fnt_simdmask + fi * 8, simd_mask);
    S64(_fnt_structmask + fi * 8, struct_mask);
    SFBVCP(fi, bvcp);
    _pd_record_at(S, fi, pdo);   # 6.7.7 (B6): its parameter defaults
    return 0;
}

# Register a top-level fn and record its ABI metadata in pass-1. Cursor enters at
# the FN token. Extraction runs on a throwaway cursor (it may advance through the
# signature however _prescan_params / the return-type scan need to); afterward the
# cursor is RESET to the FN token and _prescan_skip_fn replays the canonical skip,
# guaranteeing pass-1's net cursor advancement is byte-identical to the old inline
# skip.
#
# ⛔ 6.6.5 — the `if (GMOD(S) == 0)` guard that stood here excluded `mod`-scoped fns and
# (with the impl brace-skip in the seven forks) impl METHODS, on the reasoning that
# PARSE_FN_DEF's mangling mutates the name pool and `mod` is unused in-tree. Both halves
# were load-bearing bugs, not economies: an unregistered definition has no owner and no
# private bit, so `_vis_check` returned at its first test and a call PRECEDING the
# definition reached a private method or mod fn from any file; and with no pass-1 params
# the same forward call got the mask-0 ABI, so a >8-byte struct argument was passed by
# VALUE into a callee that derefs it — a silent SIGSEGV, not a visibility nicety.
# `_mod_name_intern` answers the pool question (mint once, reuse from either pass), so
# the guard is gone and EVERY definition kind is stamped here. CHANGELOG [6.6.5]
fn _prescan_fn_sig(S): i64 {
    var _pasync = 0;
    var _pcfn = 0;
    if (PEEKT(S) == 168) { STI(S, GTI(S) + 1); _pcfn = 1; }    # 6.7.2 (C1): `const fn`
    if (PEEKT(S) == 134) { STI(S, GTI(S) + 1); _pasync = 1; }   # v6.3.11: consume optional `async` prefix
    var start_ti = GTI(S);
    STI(S, GTI(S) + 1);                 # consume FN
    if (PEEKT(S) == 2) {
        var noff = PEEKV(S);
        STI(S, GTI(S) + 1);             # consume name
        var _ptp = _capture_tparams(S);   # v6.3.9: capture <T> (flag-off = old skip)
        noff = _mod_name_intern(S, GMOD(S), noff);   # `mod`/impl mangling, in pass 1 too
        # v6.5.0 Phase 2 — stamp visibility HERE, in pass 1.
        #
        # Two reasons, both load-bearing:
        #  (1) FORWARD calls. PARSE_FN_DEF runs in pass 2 in source order, so a
        #      cross-file call to a fn defined LATER in the concatenated stream
        #      resolves while the callee's fileid is still 0 — enforcement would
        #      fail open for exactly the half of calls that go through ECALLFIX,
        #      i.e. purely as a function of include order.
        #  (2) `_pub_pending` MUST be consumed here. Pass 1 walks the same tokens
        #      and _TL_VIS arms the marker at every `public`, but pass 1 never
        #      reached PARSE_FN_DEF to clear it — so the flag leaked across the
        #      pass boundary and suppressed the private stamp on the FIRST fn of
        #      pass 2. That is what made `private` work in a main source but
        #      silently do nothing from an included file.
        var _pfid = FM_FILEID(S, GTLINE(S, start_ti));
        var _ppriv = 0;
        if (_pub_pending == 0) { if (_PRIV_FILE(_pfid) == 1) { _ppriv = 1; } }
        _pub_pending = 0;
        # 6.6.5 — one entry per DEFINITION, not per NAME. Pass 1 used to FINDFN-or-REGFN,
        # so a second file's same-named helper overwrote the first file's owner, arity and
        # private bit before either body was parsed: two private `_h` helpers in two files
        # produced a false "is private to its file" AND a false "expects 2 arguments, got
        # 1". The v6.5.38 identity rule now runs in BOTH passes, from one place.
        var fi = _fn_def_slot(S, noff, _pfid, _ppriv);
        _prescan_dep_take(S, fi);               # 6.6.16: a pending `#deprecated`, for forward calls
        _prescan_eff_take(S, fi);               # 6.7.14: and `#io` / `#alloc`, for #pure's check
        _prescan_meth_note(S, fi, start_ti + 1);   # 6.7.14: an impl method's `T.m`, for the diagnostics
        if (_ptp != 0) { SFTP(S, fi, _ptp); }   # v6.3.9: forward-ref generic sig
        if (_pcfn == 1) { SFCFN(S, fi, 1); }    # 6.7.2 (C1): a const context may call it
        if (_ptp != 0) { _bnd_fn_record(S, fi, _ptp, GTI(S)); }   # 6.7.1 (C3): bounds + bounded sites, BEFORE the stub scan reads them
        if (_ptp != 0) { _gen_record(S, fi, GTI(S)); }   # 6.6.10: stub + carrier facts, by name
        # 6.6.10 — mark `async fn` HERE, so a coroutine's `await f(..)` classifies a callee
        # defined further down (`_await_operand_is_future`). CHANGELOG [6.6.10]
        var _pas0 = GFAS(S, fi);   # 6.6.20: whether an EARLIER definition was async
        if (_pasync == 1) { SFAS(S, fi, 1); }
        # 6.6.5 — def-start for EVERY prescanned fn, not just generics. It is how pass 2
        # finds the entry THIS definition owns (_fn_by_defti), and it is what lets a
        # forward `f<i32>(x)` instantiate (GFDS was pass-2-only, so the instantiator
        # returned -2 and the caller printed a stale "follow-on bite" error).
        # 6.6.20: an entry that already holds ANOTHER definition is a redefinition — fn flag
        # 2048, read where a call would otherwise bind to the body in hand at that point (the
        # inline replay; a generic's instance source). Left as the LAST definition's start.
        # One that disagrees with an earlier one about `async` is refused (_dsg_async_check).
        var _pds = GFDS(S, fi);
        if (_pds != 0) {
            if (_pds != start_ti + 1) {
                SFLG(S, fi, GFLG(S, fi) | 2048);
                _dsg_async_check(S, fi, noff, start_ti, _pas0, _pasync);
            }
        }
        SFDS(S, fi, start_ti + 1);
        SFFI(S, fi, _pfid + 1);
        if (_ppriv == 1) { SFLG(S, fi, GFLG(S, fi) | 64); }
        else { SFLG(S, fi, GFLG(S, fi) & (0 - 65)); }   # never leave a stale private bit
        _prescan_params(S, fi);
        if (_pasync == 1) { _bvcp_none(fi); }   # 6.6.20: see `_pm_copies`
        if (_prescan_maybe_naked(S, start_ti) == 1) { _bvcp_none(fi); }
        _prescan_ret_type(S, fi);
        _prescan_ret_single(S, fi);   # 6.6.17 (a5)
        _prescan_ret_arity(S, fi);    # 6.7.11
    } else { _pre_attr_drop(); }        # an unnamed `fn`: pass 2 refuses it; never carry past it
    STI(S, start_ti);
    _prescan_skip_fn(S);
    return 0;
}

# Pass 1, the cursor past fn `fi`'s parameter list: its optional `: ReturnType` recorded — a struct
# sid (a generic instance's), -9 an f64, a multi-value signature, a `*T`'s pointee, a bool (the
# cursor is left where those readers stop: `_prescan_ret_single` scans on to the `{`). Extracted from
# `_prescan_fn_sig` (6.7.8): a trait-object call's prototype is recorded from its trait member's
# signature the same way (`_dyn_proto`, parse_types.cyr).
fn _prescan_ret_type(S, fi): i64 {
    if (PEEKT(S) != 49) { return 0; }   # optional `: ReturnType`
    STI(S, GTI(S) + 1);     # consume ':'
    if (PEEKT(S) == 10) {
        # v6.5.21 — `: (T1, T2[, T3])`. Recorded HERE in pass 1 so a
        # FORWARD call can arity-check against a fn defined later.
        _parse_multiret_sig(S, fi, 1);
    } elif (PEEKT(S) == 8) { _ret_ptr_annot(S, fi, 1); }   # 6.6.17: `: *T`
    else {
        if (PEEKT(S) == 2) {
            var rtc = _classify_return_type(S, PEEKV(S));
            rtc = _bx_sig_ret(S, fi, rtc, PEEKV(S));        # 6.7.3: `: bool` is an i64, bit 4096
            if (rtc > 0) { rtc = _gtype_sid(S, fi, rtc); }   # 6.6.10: `: Box<Pt>`
            if (rtc != 0) { SFRS(S, fi, rtc); }
        }
    }
    return 0;
}

# ⛔ 6.6.17 (a5) — PASS 1: does fn `fi`'s body PROVABLY return ONE value? Then GFLG bit 1024, which
# `_dt_arity_check` (parse_decl.cyr) reads to refuse `var a, b = f();` — b took a stale rdx,
# silently, at fn scope and at top level. Recorded HERE so a forward call knows it. Conservative:
# a `ret2`, an `asm` block, a `?` or any `return` that is not provably one value (`_ret_stmt_single`)
# leaves the bit clear. Closure and nested-fn bodies are their own units. Cursor: past the
# signature; not moved.
fn _prescan_ret_single(S, fi): i64 {
    SFLG(S, fi, GFLG(S, fi) & (0 - 1025));
    var n = GTCNT(S);
    var i = _pre_body_open(S);
    if (i < 0) { return 0; }
    var e = _tok_skip_block(S, i, n);
    var j = i + 1;
    while (j < e) {
        var u = TOKTYP(S, j);
        if (u == 13 || u == 32) {
            var sk = _skip_nested_body(S, j);
            if (sk >= 0) { j = sk; }
        }
        elif (u == 97 || u == 48 || u == 124) { return 0; }   # ret2, asm, `?`
        elif (u == 33) { if (_ret_stmt_single(S, j) == 0) { return 0; } }
        j = j + 1;
    }
    if (_body_ends_in_return(S, i, e) == 0) { return 0; }
    SFLG(S, fi, GFLG(S, fi) | 1024);
    return 0;
}
# Pass 1, the cursor past a fn's signature: its body's `{`, or -1 (a bodiless `fn x(..);`, EOF).
fn _pre_body_open(S): i64 {
    var n = GTCNT(S);
    var i = GTI(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 13) { return i; }
        if (t == 5 || t == 12) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
# ⛔ 6.7.11 — PASS 1: how many values an UNDECLARED fn returns, when it is provable: every `return`
# is `return (..);` of one arity (2 or 3), there is no `ret2` / `asm` / `?`, and the body is left
# only through its returns (`_body_ends_in_return`). GFLG bit 65536 = 2 values, 131072 = 3
# (`_fn_ret_arity`), so a forward call knows it. A declared `: (T1, T2[, T3])` is GFRN's (GFRS
# MULTIRET_SID; `_dsg_save` / `_dsg_check` read GFRN as the DECLARED arity, so this is no GFRN).
# `var q, r, z = dm(17, 5);` with `dm` returning `(a / b, a % b)` bound z to whatever r8 held, and
# the tuple capture likewise — the destructure (`_dt_arity_check`) and the capture
# (`_tup_cap_class`) refuse a different count by name. Conservative: any other return leaves it
# unrecorded. Cursor: not moved. CHANGELOG [6.7.11]
# ⛔ 6.7.14 — `ret2(a, b)` IS TWO VALUES TOO (D42, the user's decision of 2026-10-16): a `ret2(..);`
# statement and `return ret2(..);` are two-value exits, and a body may also end in `ret2(..);` or in
# an if / elif / else whose every arm ends in an exit (`_ar_exits`). `var a, b, c = g2();` on such a
# fn bound c to a stale register. A `ret2` inside an expression still leaves it unrecorded.
fn _prescan_ret_arity(S, fi): i64 {
    SFLG(S, fi, GFLG(S, fi) & (0 - 196609));
    if (GFRS(S, fi) == MULTIRET_SID) { return 0; }
    var i = _pre_body_open(S);
    if (i < 0) { return 0; }
    var e = _tok_skip_block(S, i, GTCNT(S));
    var ar = 0;
    var j = i + 1;
    while (j < e) {
        var u = TOKTYP(S, j);
        if (u == 13 || u == 32) {
            var sk = _skip_nested_body(S, j);
            if (sk >= 0) { j = sk; }
        }
        elif (u == 97) {                  # 6.7.14: a `ret2(..);` statement — two values
            if (_ret2_stmt(S, j) == 0) { return 0; }
            if (ar == 3) { return 0; }
            ar = 2;
        }
        elif (u == 48 || u == 124) { return 0; }   # asm, `?`
        elif (u == 33) {
            var a = _ret_stmt_arity(S, j);
            if (a == 0) { return 0; }
            if (ar != 0 && a != ar) { return 0; }
            ar = a;
            if (TOKTYP(S, j + 1) == 97) { j = j + 1; }   # `return ret2(..);`: its ret2 is this exit
        }
        j = j + 1;
    }
    if (ar == 0) { return 0; }
    if (_ar_exits(S, i, e) == 0) { return 0; }
    if (ar == 2) { SFLG(S, fi, GFLG(S, fi) | 65536); }
    else { SFLG(S, fi, GFLG(S, fi) | 131072); }
    return 0;
}
# The values `return (a, b[, c]);` at token k returns, 2 or 3; else 0. Its commas are counted as
# PARSE_RETURN's multi-value arm counts them, read by shape (`_tup_p1`: pass 1 has not declared a
# generic named below).
fn _ret_stmt_arity(S, k): i64 {
    if (TOKTYP(S, k + 1) == 97) {   # 6.7.14: `return ret2(..);` is two values (D42)
        if (TOKTYP(S, k + 2) != 10) { return 0; }
        if (TOKTYP(S, _call_close(S, k + 2) + 1) != 5) { return 0; }
        return 2;
    }
    if (TOKTYP(S, k + 1) != 10) { return 0; }
    var sv = _tup_p1;
    _tup_p1 = 1;
    var c = _tup_commas(S, k + 1);
    _tup_p1 = sv;
    if (c < 1 || c > 2) { return 0; }
    if (TOKTYP(S, _call_close(S, k + 1) + 1) != 5) { return 0; }
    return c + 1;
}
# The values pass 1 recorded for an undeclared fn `fi` (`_prescan_ret_arity`): 2, 3, or 0 = unknown.
fn _fn_ret_arity(S, fi): i64 {
    var fl = GFLG(S, fi);
    if ((fl & 65536) != 0) { return 2; }
    if ((fl & 131072) != 0) { return 3; }
    return 0;
}
# 6.7.14 — 1 = the `ret2` at token k is a whole statement: it starts one (`;` `{` `}` before it) and
# its `(..)` is followed by the `;` (D42). Anything else is a `ret2` inside an expression.
fn _ret2_stmt(S, k): i64 {
    var p = TOKTYP(S, k - 1);
    if (p != 5 && p != 13 && p != 14) { return 0; }
    if (TOKTYP(S, k + 1) != 10) { return 0; }
    if (TOKTYP(S, _call_close(S, k + 1) + 1) != 5) { return 0; }
    return 1;
}
# 6.7.14 — 1 = the block `{` at o .. `}` at e is left only through an exit `_prescan_ret_arity`
# counts: it ends in a `return` or an infinite loop (`_body_ends_in_return`), in a `ret2(..);`
# statement, or in an if / elif / else chain whose every arm ends so (`_ar_ifelse`). (D42)
fn _ar_exits(S, o, e): i64 {
    if (_body_ends_in_return(S, o, e) == 1) { return 1; }
    if (TOKTYP(S, e - 1) == 5) {
        if (TOKTYP(S, e - 2) != 11) { return 0; }
        var q = _tok_open_back(S, e - 2);
        if (q > o + 1) { if (TOKTYP(S, q - 1) == 97) { return _ret2_stmt(S, q - 1); } }
        return 0;
    }
    if (TOKTYP(S, e - 1) != 14) { return 0; }
    var b = _tok_brace_back(S, e - 1);
    if (b <= o) { return 0; }
    if (TOKTYP(S, b - 1) != 23) { return 0; }   # the last arm is an `else { .. }`
    if (_ar_exits(S, b, e - 1) == 0) { return 0; }
    return _ar_ifelse(S, o, b - 2);
}
# The arm whose block closes at token c, and every arm before it in its if / elif chain, end in an
# exit (`_ar_exits`), and the chain's `if` starts a statement of the block opened at o.
fn _ar_ifelse(S, o, c): i64 {
    if (TOKTYP(S, c) != 14) { return 0; }
    var b = _tok_brace_back(S, c);
    if (b <= o) { return 0; }
    if (_ar_exits(S, b, c) == 0) { return 0; }
    if (TOKTYP(S, b - 1) != 11) { return 0; }
    var q = _tok_open_back(S, b - 1);
    if (q <= o + 1) { return 0; }
    var k = q - 1;
    var t = TOKTYP(S, k);
    if (t == 50) { return _ar_ifelse(S, o, k - 1); }   # `elif (..) { .. }`
    if (t != 15) { return 0; }
    t = TOKTYP(S, k - 1);
    if (t == 5 || t == 13 || t == 14) { return 1; }
    return 0;
}
# The `{` matching the `}` at token c, or -1.
fn _tok_brace_back(S, c): i64 {
    var d = 0;
    var k = c;
    while (k > 0) {
        var t = TOKTYP(S, k);
        if (t == 14) { d = d + 1; }
        elif (t == 13) {
            d = d - 1;
            if (d == 0) { return k; }
        }
        k = k - 1;
    }
    return 0 - 1;
}
# 1 = the body `{` at `o` .. `}` at `e` can be left only through a `return`: its LAST statement is a
# `return`, or (6.7.11) an infinite loop no `break` leaves (`_body_ends_in_loop`). A body that can
# fall off its end returns whatever rax:rdx its last statement left (a call's pair, say), so it is
# not provably one value.
fn _body_ends_in_return(S, o, e): i64 {
    var bd = 0;
    var pd = 0;
    var first = 1;
    var lastk = 0;
    var lasti = 0;
    var previ = 0;
    var inret = 0;   # 6.7.4: a `return` statement ends at its own `;`, not at an if-expression's `}`
    var j = o + 1;
    while (j < e) {
        var t = TOKTYP(S, j);
        if (first == 1) { previ = lasti; lastk = t; lasti = j; first = 0; if (t == 33) { inret = 1; } }
        if (t == 10 || t == 28) { pd = pd + 1; }
        elif (t == 11 || t == 29) { pd = pd - 1; }
        elif (t == 13) { bd = bd + 1; }
        elif (t == 14) { bd = bd - 1; if (bd == 0) { if (pd == 0) { if (inret == 0) { first = 1; } } } }
        elif (t == 5) { if (bd == 0) { if (pd == 0) { first = 1; inret = 0; } } }
        j = j + 1;
    }
    if (lastk == 0) { return 0; }
    if (lastk == 33) {
        if (TOKTYP(S, e - 1) == 5) { return 1; }
        return 0;
    }
    return _body_ends_in_loop(S, lasti, previ, e);
}
# ⛔ 6.7.11 — 1 = the body's last statement, at token `li`, is an infinite loop whose block closes the
# body (its `}` is the token before `e`), holds a `return` and has no `break` that leaves it:
# `loop { .. }`, `while (1) { .. }`, or `do { .. } while (1);` — the do-block's `}` restarts the
# statement, so `li` is its tail's `while` and `pi` (the statement before) the `do`. Every `return`
# inside was judged by the caller's walk. Before this a body ending in one was never "provably one
# value": `var a, b = one(1);` bound b to a stale rdx, silently. CHANGELOG [6.7.11]
fn _body_ends_in_loop(S, li, pi, e): i64 {
    var n = GTCNT(S);
    var ob = 0 - 1;
    if (_TOK_IS_LOOP(S, li) == 1) { ob = li + 1; }
    elif (TOKTYP(S, li) == 16) {
        if (_cond_is_one(S, li + 1) == 0) { return 0; }
        if (TOKTYP(S, li + 4) == 13) { ob = li + 4; }
        elif (li + 4 == e - 1) {
            if (TOKTYP(S, li + 4) != 5) { return 0; }
            if (TOKTYP(S, pi) != 172) { return 0; }
            if (TOKTYP(S, pi + 1) != 13) { return 0; }
            if (_tok_skip_block(S, pi + 1, n) != li - 1) { return 0; }
            return _loop_exits_by_return(S, pi + 1, li - 1);
        }
    }
    if (ob < 0) { return 0; }
    var cb = _tok_skip_block(S, ob, n);
    if (cb != e - 1) { return 0; }
    return _loop_exits_by_return(S, ob, cb);
}
# `( 1 )` at token k: the constant-true condition `while (1)` spells — or `( true )`, the bool
# literal 1 (token 169; D27 A, the user's decision, 2026-10-15: `while (true) { .. }` and
# `do { .. } while (true);` end a body in its returns as `while (1)` does). CHANGELOG [6.7.13]
fn _cond_is_one(S, k): i64 {
    if (TOKTYP(S, k) != 10) { return 0; }
    if (TOKTYP(S, k + 1) == 169) { if (TOKTYP(S, k + 2) == 11) { return 1; } return 0; }
    if (TOKTYP(S, k + 1) != 1) { return 0; }
    if (TOKVAL(S, k + 1) != 1) { return 0; }
    if (TOKTYP(S, k + 2) != 11) { return 0; }
    return 1;
}
# 1 = the loop block `{` at `o` .. `}` at `c` holds a `return` and no `break` that leaves it. A
# `break` in a nested while / for / loop / do / switch / match leaves THAT construct (guide, Control
# Flow), and one in a closure body or nested fn is its own unit: their bodies are stepped over for
# the break test (`_brk_inner_end`). Returns anywhere but a closure / nested fn count.
fn _loop_exits_by_return(S, o, c): i64 {
    var rets = 0;
    var j = o + 1;
    while (j < c) {
        var t = TOKTYP(S, j);
        if (t == 51) { return 0; }
        if (t == 33) { rets = 1; }
        var sk = _brk_inner_end(S, j);
        if (sk > j) {
            if (t != 13 && t != 32) { if (_has_return_tok(S, j, sk) == 1) { rets = 1; } }
            j = sk;
        }
        j = j + 1;
    }
    return rets;
}
# The last token of the unit at `j` that a `break` inside cannot leave the enclosing loop through —
# a closure body / nested fn (`_skip_nested_body`), or the BODY of a nested loop, switch or match
# (its first `{` at bracket depth 0, before any `;`: a do-while's tail `while (c);` has none) — or
# -1.
fn _brk_inner_end(S, j): i64 {
    var t = TOKTYP(S, j);
    if (t == 13 || t == 32) { return _skip_nested_body(S, j); }
    var lp = 0;
    if (t == 16 || t == 55 || t == 172 || t == 57 || t == 75) { lp = 1; }
    if (_TOK_IS_LOOP(S, j) == 1) { lp = 1; }
    if (lp == 0) { return 0 - 1; }
    var n = GTCNT(S);
    var pd = 0;
    var k = j + 1;
    while (k < n) {
        var u = TOKTYP(S, k);
        if (u == 12) { return 0 - 1; }
        if (u == 10 || u == 28) { pd = pd + 1; }
        elif (u == 11 || u == 29) { pd = pd - 1; }
        elif (pd == 0 && u == 5) { return 0 - 1; }
        elif (pd == 0 && u == 13) { return _tok_skip_block(S, k, n); }
        k = k + 1;
    }
    return 0 - 1;
}
# 1 = a `return` of THIS fn lies in tokens (j, e]: one outside any closure body / nested fn.
fn _has_return_tok(S, j, e): i64 {
    var k = j + 1;
    while (k <= e) {
        var t = TOKTYP(S, k);
        if (t == 33) { return 1; }
        if (t == 13 || t == 32) {
            var sk = _skip_nested_body(S, k);
            if (sk > k) { k = sk; }
        }
        k = k + 1;
    }
    return 0;
}
# 1 = the `return` at token k returns one value: `return;`, or an expression with no comma outside
# a bracket (a tuple `(a, b)` is two) that does not END in `)` — a whole call (`return f(..);`,
# `return x.m(..);`) forwards whatever its callee left in rax:rdx.
fn _ret_stmt_single(S, k): i64 {
    var n = GTCNT(S);
    var d = 0;
    var last = 0;
    var j = k + 1;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (d == 0 && t == 5) { j = n; }
        else {
            if (t == 10 || t == 28 || t == 13) { d = d + 1; }
            if (t == 11 || t == 29 || t == 14) { d = d - 1; }
            if (t == 31 && d <= 1) { return 0; }
            last = t;
            j = j + 1;
        }
    }
    if (last == 11) { return 0; }
    return 1;
}

# 6.6.16 — hand a pass-1 `#deprecated` (recorded by `_tl_deprecated(S, 0)`) to the fn just
# registered, so a call parsed BEFORE the definition warns. Pass 1 walks the definitions in
# pass 2's order (impl methods included), so this is the fn PARSE_FN_DEF will mark too; it
# only ORs bit 2 (value 4), which PARSE_FN_DEF ORs again. GFDM's one reader is
# `_DEPRECATED_WARN`, so nothing here reaches codegen. CHANGELOG [6.6.16]
fn _prescan_dep_take(S, fi): i64 {
    if (_pre_dep_pending == 0) { return 0; }
    SFLG(S, fi, GFLG(S, fi) | 4);
    SFDM(S, fi, _pre_dep_msg);
    _pre_dep_pending = 0;
    _pre_dep_msg = 0;
    return 0;
}

# 6.7.14 — the same hand-over for `#io` / `#alloc` (bits 16 / 32, armed by `_tl_arm1`), which
# PARSE_FN_DEF ORs again: #pure's check read them at the call, so a callee defined BELOW its
# `#pure` caller (a plain call, a tail call, an impl method) warned nothing. CHANGELOG [6.7.14]
fn _prescan_eff_take(S, fi): i64 {
    if (_pre_io_pending == 1) { SFLG(S, fi, GFLG(S, fi) | 16); }
    if (_pre_alloc_pending == 1) { SFLG(S, fi, GFLG(S, fi) | 32); }
    _pre_io_pending = 0;
    _pre_alloc_pending = 0;
    return 0;
}

# Pass 1's pending attributes dropped where no fn takes them (never carried into pass 2).
fn _pre_attr_drop(): i64 {
    _pre_dep_pending = 0;
    _pre_io_pending = 0;
    _pre_alloc_pending = 0;
    return 0;
}

# ⛔ 6.6.10 — A TYPE THAT NAMES A GENERIC STRUCT INSTANCE IN A SIGNATURE (`: Box<Pt>`, and
# `: Box<T>` in a generic's instance) was classified by its BASE name and the `<..>` skipped. As a
# return type the fn returned the base `Box` — whose `v: T` is an 8-byte i64 — while its caller
# declared `Box<Pt>` (24 B, `v` a Pt): `var r: Box<Pt> = mk<Pt>(p); r.v.x` failed with "expected
# ';', got '.'", and a plain `fn mkp(x: Pt): Box<Pt>` was refused ("fn return struct-id differs
# from declared var type"). As a parameter type `r.v.x` failed the same way. The type now
# resolves exactly as a `var b: Box<Pt>` does (parse_decl.cyr): an ALL-i64 argument list is the
# base struct itself, anything else the deduped `Box$..` instance, with an instance's T bound.
# A generic's BASE keeps the base struct — its T is unbound in the signature, and pass 1 records
# the same, so a forward call agrees. A list naming something that does not resolve YET keeps
# the base, as before: pass 1 is source-ordered (the definition corrects it once the names are
# declared), and the signature is read more than once (the pre-parameter rough scan, pass 1), so
# this is not the place to report it. Cursor on the type name; NOT consumed. CHANGELOG [6.6.10]
fn _gtype_sid(S, fi, base): i64 {
    if (_MONOMORPH_OK == 0) { return base; }
    if (base <= 0) { return base; }
    if (TOKTYP(S, GTI(S) + 1) != 19) {
        if (GSTP(S, base - 1) != 0) { _bnd_sbase(S, base); }   # 6.7.1 (C3): a bare `Box` is its i64 base
        return base;
    }
    if (GSTP(S, base - 1) == 0) { return base; }
    if (GFTP(S, fi) != 0) { if (_inst_conc0 == 0) { return base; } }
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    if (GFTP(S, fi) != 0) { _bind_generic_call(S, fi, _inst_conc0, _inst_conc1); }
    var r = base;
    if (_targs_resolvable(S, GTI(S) + 2) == 1) {
        var sv = GTI(S);
        r = _ret_targ_parse(S, base);
        STI(S, sv);
    }
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return r;
}
# ⛔ 6.7.14 (D6) — A SIGNATURE'S GENERIC STRUCT CHECKS ITS TYPE ARGUMENTS AT THE DEFINITION (PARSE_FN_DEF pass 2: a
# parameter `m: Mp<K, V>` / `m: *Mp<K, V>`, a return `: Mp<K, V>`; cursor on the struct's name). `_gtype_sid` keeps the
# base when an argument does not resolve — not the place to report it, since pass 1 reads it too, before a struct
# declared further down is known — so `fn gm(m: Mp<K, V>, b)` with K / V declared nowhere compiled as the base `Mp`,
# and `m: Box<Zork>` took a `Box<i64>`, while `var m: Mp<K, V>;` was refused. Pass 2 now reads the list as a local's
# annotation reads it, minting nothing (`_targ_chk`; the fn's own type parameters stay names): every refusal once, at
# its token, whether or not the fn is called (the user's D6 (a), 2026-10-16). CHANGELOG [6.7.14]
fn _gtype_sid_def(S, fi, base): i64 {
    if (_MONOMORPH_OK == 1) { if (base > 0) { if (TOKTYP(S, GTI(S) + 1) == 19) { if (GSTP(S, base - 1) != 0) {
                    _targ_chk(S, GTI(S) + 1);
                } } } }
    return _gtype_sid(S, fi, base);
}
# ⛔ 6.6.10 (bite 7 review) — AN INSTANCE'S `: T` RETURN, T BOUND TO A STRUCT, returns THAT struct
# by value, exactly as a `: Pt` fn does (the rough scan and the return type both ask this). It was
# always the base's i64 — the instance handed back rax, which for an address-passed parameter is
# the caller's struct ADDRESS: `q = idp(p)` stored a pointer into `q.x`, `var q: Pt = idp(p)` said
# "no struct type in scope". `Str` keeps its rax heap-handle return through the same exclusion a
# written `: Str` gets (the rough scan's pair test). 0 = not an instance's struct-bound `: T`.
# ⛔ 6.7.9 — and T = f64 is an f64 return (-9), as a written `: f64` is: an instance used to record
# the base's i64 (-8) and hand the double back in rax, which no call site types. CHANGELOG [6.7.9]
fn _gtype_tp_ret(S, fi, noff): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (_inst_conc0 == 0) { return 0; }
    var tp = GFTP(S, fi);
    if (tp == 0) { return 0; }
    var c = 0;
    if ((tp & 0xFFFFFFFF) == noff + 1) { c = _inst_conc0; }
    if (((tp >> 32) & 0xFFFFFFFF) == noff + 1) { c = _inst_conc1; }
    if (c == 0 - 9) { return c; }   # 6.7.9: T = f64 — the instance returns an f64 (xmm0 on x86)
    if (c <= 0) { return 0; }
    return c;
}
# `Name<a[, b]>` at the cursor (Name the generic struct `base`): its instance under the rule a
# `var x: Name<..>` declaration uses — ALL-i64 (or an unbound parameter) is the base struct itself,
# anything else the deduped `Name$..` instance. Consumes the type; leaves the explicit-call parse
# state it shares (`_ta_pending_gt`) as it found it.
fn _ret_targ_parse(S, base): i64 {
    var sv_gt = _ta_pending_gt;
    _ta_pending_gt = 0;
    var lit = _targs_literal(S, GTI(S) + 2);   # 6.7.1 (C3): `Box<i64>` written out
    STI(S, GTI(S) + 2);                  # the name, `<`
    var c0 = _parse_one_type_arg(S);
    var c1 = 0;
    if (_ta_comma(S) == 1) { c1 = _parse_one_type_arg(S); }
    _consume_gt(S);
    _ta_pending_gt = sv_gt;
    var inst = 0;
    if (c0 != 0 - 8 && c0 != 0) { inst = 1; }
    if (c1 != 0 && c1 != 0 - 8) { inst = 1; }
    if (inst == 0) {
        if (lit == 1) { _bnd_sbase(S, base); }   # 6.7.1 (C3)
        return base;
    }
    var g = _instantiate_generic_struct(S, base - 1, c0, c1);
    if (g > 0) { return g; }
    return base;
}
# A parameter typed `Name<..>` resolved to an instance: its address-passed bit follows the
# INSTANCE's size (`_param_wants_struct_ptr` sized the base by name) — or, behind a `*` (`isptr`),
# is set at every size (6.6.20).
fn _gtype_param_mask(S, mask, pc, base, inst, isptr): i64 {
    if (inst == base) { return mask; }
    var want = isptr;
    if (STRUCTSZ(S, inst - 1) > 8) { want = 1; }
    if (pc >= 62) {   # 6.6.17 (a10): the overflow row (`_pmw`)
        _pm_row_clr(_cur_fn_ix, pc, 1);
        if (want == 1) { _pm_row_or(_cur_fn_ix, pc, 1); }
        return mask;
    }
    mask = mask & (0 - 1 - (1 << pc));
    if (want == 1) { mask = mask | (1 << pc); }
    return mask;
}

# The top-level scans (pass 1 / pass 2), the definition identity and duplicate checks, and the fn
# definition itself (`_PARSE_FN_DEF_IMPL`) continue in src/frontend/parse_fn_def.cyr, which
# src/frontend/parse.cyr includes right after this file. CHANGELOG [6.7.15]
