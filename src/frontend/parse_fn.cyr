# PARSER — fn definitions, calls, returns, impls:
# REGFN / FINDFN / FINDLOCAL / PARSE_RETURN / PARSE_FNCALL /
# PARSE_IMPL / SKIP_GENERICS / DSE_PASS / IS_JUMP_TARGET /
# PARSE_FN_DEF.
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38. Consumes the state
# vars _cur_fn_regalloc / _cur_fn_ret_stash / _cur_fn_ret_sid defined
# at the top of parse.cyr. Included by parse.cyr at the same textual
# position the original content lived; self-host byte-identical.


# v5.5.38: control-flow fns (if/while/for + cond helpers) extracted.
include "src/frontend/parse_ctrl.cyr"

# ================================================================
# FUNCTION TABLE + CODEGEN
# ================================================================

# v5.6.5 O1: FNV-1a over the null-terminated ident at S+0x60000+noff.
# Returns the 64-bit hash. Caller masks with (table_size - 1) to land
# a slot. Constants are the standard FIPS-spec 64-bit FNV-1a values
# (offset basis + prime). Cyrius multiplies wrap on 2's-complement so
# the natural u64 arithmetic this algorithm assumes works directly.
# v6.5.52 — inline-replay param binding for WIDE (vector) params.
#
# The replay used to bind both params to adjacent SINGLE 8-byte slots and store each with an
# 8-byte EFLSTORE. A 16-byte f32v4/f64v2 (or 32-byte f64v4) therefore overran its neighbour:
# ONE SIMD param inlined correctly, TWO crashed the compiler outright. These two helpers make
# the binding width-driven and type-carrying, mirroring exactly what PARSE_FN_DEF does for a
# real (non-inlined) SIMD param: (nslots-1) anonymous filler slots first, then the NAMED slot
# last at the deepest displacement — which is where `&v` and lane access resolve.
# v6.5.52 — bind ONE value-form SIMD argument on the inline-replay path.
#
# ⛔ WHY THIS EXISTS INSTEAD OF `PCMPE` + STORE. `PCMPE` does not materialise a value-form
# SIMD operand at all — the normal call path routes those in TWO PASSES for a stated reason:
# the arg "MUST be a local", is recorded to a scratch table, and the XMM load is emitted
# AFTER the int args "so int-arg eval (which may clobber XMM during PCMPE) doesn't trample
# SIMD state". Without that, the replay's store wrote whatever XMM0 last held — measured on a
# 2-param call as three consecutive `movupd %xmm0, ...` with no load between them, so both
# params took the previous local's value (f32v4_dot returned 36.0 for an 8.0 case).
#
# The inline path needs no XMM ordinal — the destination is a frame slot, not an ABI register
# — so this copies memory-to-memory and sidesteps the clobber problem entirely: the load and
# the store are ADJACENT instructions, leaving no window for anything to touch XMM0.
#
# Mirrors the normal path's checks: the arg must be an IDENT naming a local whose SLTYPE
# matches the param's class (size-class for 16-byte vectors, exact for f32v4/f64v4), so a
# mismatched vector is rejected rather than silently reinterpreted.
# v6.5.66 — the plain copy, with no provenance recorded. Used by every non-x86 fork, where
# `_F64V_DISP` does not exist and the direct-form/harvest machinery is inert.
fn _inl_simd_arg_copy(S, alli, dst_slot, w): i64 {
    if (w == 4) {
        EFLLOAD_F64V4_PAIR(S, alli);
        EFLSTORE_F64V4_PAIR(S, dst_slot);
        return 0;
    }
    EFLLOAD_F64V2_PAIR(S, alli);
    EFLSTORE_F64V2_PAIR(S, dst_slot);
    return 0;
}

fn _inl_simd_arg(S, dst_slot, w, want_t): i64 {
    if (PEEKT(S) != 2) {
        ERR_MSG(S, "value-form SIMD arg must be a local IDENT (inline-replay path)", 62);
        return 0;
    }
    var anoff = PEEKV(S);
    STI(S, GTI(S) + 1);
    var alli = FINDLOCAL(S, anoff);
    if (alli < 0) {
        ERR_MSG(S, "value-form SIMD arg: IDENT not found as a local", 47);
        return 0;
    }
    var alt = GLTYPE(S, alli);
    if (want_t == 0 - 2121) {
        if (alt != 0 - 2121) { ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f32v4)", 56); }
    } elif (want_t == 0 - 2125) {
        if (alt != 0 - 2125) { ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f64v4)", 56); }
    } else {
        if (_is_simd128(S, alt) == 0) { ERR_MSG(S, "value-form SIMD arg must be a 16-byte vector", 44); }
    }
    # v6.5.66 — bracket the copy so it can be NOP'd out later if nothing reads the slot.
    #
    # ⛔ x86 ONLY, AND BOTH HALVES OF THAT GATE MATTER. `_F64V_DISP` lives in
    # backend/x86/float.cyr, which ONLY main.cyr / main_win.cyr / main_x86_macho.cyr include — the
    # three aarch64 forks and main_cx.cyr do not, and an undefined fn has been a hard error since
    # v6.3.2. Recording provenance unconditionally broke the aarch64-Mach-O fork outright
    # (rc=256), which is the v6.4.26 trap: a shared parse_fn/parse_expr call needs a peer in every
    # fork. A stub would be worse than useless here — `_prov_harvest` runs in SHARED code, so a
    # stub returning 0 would have it scanning every non-x86 build for displacement 0 and
    # potentially NOP-filling live bytes. Do not record at all off x86.
    if (_AARCH64_BACKEND != 0) { return _inl_simd_arg_copy(S, alli, dst_slot, w); }
    if (_TARGET_CX != 0) { return _inl_simd_arg_copy(S, alli, dst_slot, w); }
    var _pcs = GCP(S);
    if (w == 4) {
        EFLLOAD_F64V4_PAIR(S, alli);
        EFLSTORE_F64V4_PAIR(S, dst_slot);
        _prov_record(dst_slot, alli, _pcs, GCP(S), _F64V_DISP(dst_slot), 4);
        return 0;
    }
    EFLLOAD_F64V2_PAIR(S, alli);
    EFLSTORE_F64V2_PAIR(S, dst_slot);
    # v6.5.65 — record AFTER the store: the store itself invalidates the slot, so recording first
    # would immediately undo it.
    _prov_record(dst_slot, alli, _pcs, GCP(S), _F64V_DISP(dst_slot), 2);
    return 0;
}

fn _inl_store_arg(S, slot, w): i64 {
    if (w == 2) { EFLSTORE_F64V2_PAIR(S, slot); return 0; }
    if (w == 4) { EFLSTORE_F64V4_PAIR(S, slot); return 0; }
    EFLSTORE(S, slot);
    return 0;
}

fn _inl_bind_param(S, base, w, named, noff, t): i64 {
    var j = 0;
    while (j < w - 1) {
        S64(S + 0x5D9D000 + (base + j) * 8, 0 - 1);   # anon filler
        SLDEP(S, base + j, 0);
        SLTYPE(S, base + j, 0);
        j = j + 1;
    }
    S64(S + 0x5D9D000 + named * 8, noff);
    SLDEP(S, named, GSDEP(S));
    # 6.6.5: an inline-replay param wider than one slot IS the aggregate (the replay copies
    # the caller's words into it); a single-slot small struct is a value too.
    if (w > 1) { SLAGG(S, named, w); }
    else { MARK_SMALL_STRUCT(S, named, t); }
    # ⚠ Re-apply the param TYPE. Without this the param is untyped inside the inlined body,
    # which surfaces as a bogus "value-form SIMD arg type mismatch" at its first use — the
    # second of the two defects, independent of the slot-width one above.
    SLTYPE(S, named, t);
    return 0;
}

fn FNV1A_NOFF(S, noff): i64 {
    var h = 0xcbf29ce484222325;
    var i = 0;
    var c = load8(S + 0xEC00000 + noff + i);
    while (c != 0) {
        h = h ^ c;
        h = h * 0x100000001b3;
        i = i + 1;
        c = load8(S + 0xEC00000 + noff + i);
    }
    return h;
}

# v5.6.5 O1: insert (noff → fi) into fn_name_hash at 0x110000 via
# linear probing. Stored value is fi+1 so 0 marks empty (zero-init
# heap gives us free initialization). Called from REGFN after the
# fn_names entry is written. Load factor 0.5 at 4096-fn cap means
# avg ~1.5 probes to insert.
# v6.5.51 — fn-name-hash health, computed ON DEMAND for `CYRIUS_STATS=1` by walking the
# table once. Deliberately NOT a counter incremented inside _REGFN_HASH: that is the hot
# path, and this must cost nothing when the meter is off.
#
# ⭐ IT REPORTS maxprobe, NOT JUST LOAD, because maxprobe is the PROPERTY and load is only
# the mechanism. A gate pinning load alone would pass any future scheme that keeps load low
# while still clustering — the v6.5.36 lesson (an enum gate stayed green through five bad
# releases because it pinned the mechanism, and the mechanism was the thing that was wrong).
# What costs time is displacement from the home slot, so that is what is measured: for every
# occupied slot, re-derive the entry's home slot and report the largest wrap-adjusted
# distance. Measured on a 120,000-fn unit: 65,263 before v6.5.51, 38 after.
fn _fnhash_health(S): i64 {
    var slots = _fnt_hash_mask + 1;
    var used = 0;
    var maxd = 0;
    var sl = 0;
    while (sl < slots) {
        var e = load32(_fnt_namehash + sl * 4);
        if (e != 0) {
            used = used + 1;
            var noff = L64(_fnt_names + (e - 1) * 8);
            var hh = FNV1A_NOFF(S, noff);
            var home = (hh & _fnt_hash_mask);
            var d = ((sl - home) & _fnt_hash_mask);
            if (d > maxd) { maxd = d; }
        }
        sl = sl + 1;
    }
    syscall(SYS_WRITE, 2, "  fn_name_hash: ", 16);
    PRNUM(used);
    syscall(SYS_WRITE, 2, " / ", 3);
    PRNUM(slots);
    syscall(SYS_WRITE, 2, " slots, maxprobe ", 17);
    PRNUM(maxd);
    syscall(SYS_WRITE, 2, "\n", 1);
    return maxd;
}

fn _REGFN_HASH(S, noff, fi): i64 {
    var h = FNV1A_NOFF(S, noff);
    var slot = h & _fnt_hash_mask;
    while (load32(_fnt_namehash + slot * 4) != 0) {
        slot = (slot + 1) & _fnt_hash_mask;
    }
    store32(_fnt_namehash + slot * 4, fi + 1);
    return 0;
}

# v5.10.25 — Phase 3 generalize: detect _str/_int/_cstr suffix on
# the fn name at noff. Used by REGFN to auto-register an overload
# entry in fn_overload_{str,int,cstr} when the base name is also
# defined. Returns:
#   1 = _str  suffix (4 chars)
#   2 = _int  suffix (4 chars)
#   3 = _cstr suffix (5 chars)
#   0 = no recognized suffix
fn _OVERLOAD_SUFFIX(S, noff): i64 {
    var p = S + 0xEC00000 + noff;
    var len = 0;
    while (load8(p + len) != 0) { len = len + 1; }
    if (len > 4) {
        if (load8(p + len - 4) == 95) {
            if (load8(p + len - 3) == 115) {
                if (load8(p + len - 2) == 116) {
                    if (load8(p + len - 1) == 114) { return 1; }
                }
            }
            if (load8(p + len - 3) == 105) {
                if (load8(p + len - 2) == 110) {
                    if (load8(p + len - 1) == 116) { return 2; }
                }
            }
        }
    }
    if (len > 5) {
        if (load8(p + len - 5) == 95) {
            if (load8(p + len - 4) == 99) {
                if (load8(p + len - 3) == 115) {
                    if (load8(p + len - 2) == 116) {
                        if (load8(p + len - 1) == 114) { return 3; }
                    }
                }
            }
        }
    }
    return 0;
}

# Grow the fn-table family 2x: realloc + copy all 16 parallel 8 B/slot tables,
# realloc the start-hash (rebuilt each fixup, so no copy needed), then rebuild
# the name-hash at the new size and re-insert every live entry. Old buffers leak
# (cycc is short-lived). Ceiling 32768 — the 2 B hash slots store fi+1 (so the
# index must stay < 65536) and the live[] DCE bitmap is fixed at live[4096] =
# 32768 bits. v6.2.0 Phase 0 / AR-03. See util.cyr for the gvar family.
fn _fnt_grow(S): i64 {
    var nc = _fnt_cap * 2;
    if (nc > 131072) {
        syscall(SYS_WRITE, 2, "error: too many functions (max 131072)\n", 39);
        syscall(SYS_EXIT, 1);
    }
    var oc = _fnt_cap;
    _fnt_cstrmask  = _fnt_copy_table(_fnt_cstrmask,  oc, nc);
    _fnt_resmask   = _fnt_copy_table(_fnt_resmask,   oc, nc);
    _fnt_optmask   = _fnt_copy_table(_fnt_optmask,   oc, nc);
    _fnt_tagmask   = _fnt_copy_table(_fnt_tagmask,   oc, nc);
    _fnt_ovstr     = _fnt_copy_table(_fnt_ovstr,     oc, nc);
    _fnt_ovint     = _fnt_copy_table(_fnt_ovint,     oc, nc);
    _fnt_ovcstr    = _fnt_copy_table(_fnt_ovcstr,    oc, nc);
    _fnt_simdmask  = _fnt_copy_table(_fnt_simdmask,  oc, nc);
    _fnt_names     = _fnt_copy_table(_fnt_names,     oc, nc);
    _fnt_offsets   = _fnt_copy_table(_fnt_offsets,   oc, nc);
    _fnt_params    = _fnt_copy_table(_fnt_params,    oc, nc);
    _fnt_bodystart = _fnt_copy_table(_fnt_bodystart, oc, nc);
    _fnt_bodyend   = _fnt_copy_table(_fnt_bodyend,   oc, nc);
    _fnt_inline    = _fnt_copy_table(_fnt_inline,    oc, nc);
    _fnt_strmask   = _fnt_copy_table(_fnt_strmask,   oc, nc);
    _fnt_codeend   = _fnt_copy_table(_fnt_codeend,   oc, nc);
    _fnt_structmask = _fnt_copy_table(_fnt_structmask, oc, nc);
    # start-hash is rebuilt from scratch each fixup pass — just give it a
    # cap-sized buffer (contents irrelevant; the fixup clear loop zeroes it).
    # v6.5.51 — TWO hash slots per fn-table entry, so the open-addressed tables never
    # exceed 50 % load. They used to be nc slots for an nc-entry table, and REGFN only
    # grows once `fc >= _fnt_cap`, so the name hash filled to EXACTLY 100 % before every
    # doubling. Linear probing at that load degenerates into a full-table scan: measured
    # max probe 65,263 on a 131,072-slot table, 31.5 MILLION probes for one 120,000-fn
    # compile. Two slots per entry caps the load at 50 %, where the measured max probe is
    # 38 and the total is 131,892 — a 239x reduction that removes the superlinearity
    # outright (5.3 us/fn, flat from 34k to 120k fns).
    # Only these TWO tables double; the 17 payload tables above are untouched, so the cost
    # is ~2 MB at the 131,072 ceiling. Output is byte-identical: the hash is a lookup
    # accelerator whose probe ORDER changes but whose answers do not.
    _fnt_starthash = alloc(nc * 8);  # nc*2 slots x 4 B
    _fnt_namehash  = alloc(nc * 8);  # nc*2 slots x 4 B
    _fnt_hash_mask = nc * 2 - 1;
    _fnt_cap = nc;
    var i = 0;
    while (i < oc) {
        _REGFN_HASH(S, L64(_fnt_names + i * 8), i);
        i = i + 1;
    }
    return 0;
}

# Register new function, return index
# ⚡ v6.5.42 — HASH LOOKUP FOR `<name>_str` / `_int` / `_cstr`, replacing an O(n^2) scan.
#
# REGFN's REVERSE overload registration walked EVERY already-registered fn for every new one,
# looking for a sibling named `<my_name>_<suffix>`. That is quadratic in fn count by
# construction: at 60,000 fns it is ~1.8x10^9 name comparisons. MEASURED on the 60k fixture —
# 43.5 s with the scan, 23.6 s with it disabled, so it was **46 % of total compile time**, and
# the share grows with the square. (Filed as `2026-09-02-compile-time-superlinear-in-fn-count`,
# which named this as the strongest candidate; the measurement confirms it. ⚠ 23.6 s is still
# slow for 60k fns, so a SECOND quadratic contributor remains — see that filing.)
#
# The replacement is exactly equivalent, not an approximation: the scan was looking for a fn
# whose name is the concatenation `<my_name>` + `<suffix>`, so three direct lookups of those
# three names find precisely the same set. Equivalence is verifiable rather than argued —
# cycc's output must stay BYTE-IDENTICAL, and it does.
#
# ⚠ `_FINDFN_CSTR` cannot be used here: it is itself a linear scan, so three calls would make
# the cost WORSE, not better. This probes the hash table directly.
#
# ⚠ Hash slots are 4 BYTES since v6.5.40 (the fn ceiling went 32768 -> 131072, which required
# widening them from 2). Reading them as 2 would silently find the wrong entries.

# FNV-1a over the NUL-terminated name at `noff`, continued over `suflen` bytes at `suf`.
fn _fnv_noff_suffix(S, noff, suf, suflen): i64 {
    var h = 0xcbf29ce484222325;
    var i = 0;
    var c = load8(S + 0xEC00000 + noff + i);
    while (c != 0) {
        h = h ^ c;
        h = h * 0x100000001b3;
        i = i + 1;
        c = load8(S + 0xEC00000 + noff + i);
    }
    var j = 0;
    while (j < suflen) {
        h = h ^ load8(suf + j);
        h = h * 0x100000001b3;
        j = j + 1;
    }
    return h;
}

# 1 if the name at `sn` is exactly `<name at noff>` ++ `<suflen bytes at suf>`.
fn _name_is_noff_suffix(S, sn, noff, suf, suflen): i64 {
    var i = 0;
    var c = load8(S + 0xEC00000 + noff + i);
    while (c != 0) {
        if (load8(S + 0xEC00000 + sn + i) != c) { return 0; }
        i = i + 1;
        c = load8(S + 0xEC00000 + noff + i);
    }
    var j = 0;
    while (j < suflen) {
        if (load8(S + 0xEC00000 + sn + i + j) != load8(suf + j)) { return 0; }
        j = j + 1;
    }
    # must END there — otherwise `foo_string` would match a lookup for `foo_str`.
    if (load8(S + 0xEC00000 + sn + i + suflen) != 0) { return 0; }
    return 1;
}

# fn index of `<name at noff><suffix>`, or -1.
fn _findfn_noff_suffix(S, noff, suf, suflen): i64 {
    var h = _fnv_noff_suffix(S, noff, suf, suflen);
    var slot = h & _fnt_hash_mask;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_namehash + slot * 4);
        if (stored == 0) { probes = _fnt_cap; }
        else {
            var fi = stored - 1;
            var sn = L64(_fnt_names + fi * 8);
            if (_name_is_noff_suffix(S, sn, noff, suf, suflen) == 1) { return fi; }
            slot = (slot + 1) & _fnt_hash_mask;
            probes = probes + 1;
        }
    }
    return 0 - 1;
}

fn REGFN(S, noff): i64 {
    var fc = GFNC(S);
    # Grow the fn-table family the moment the count would exceed the cap (the
    # writes below append slot fc). _fnt_cap==0 guards any pre-init call.
    if (_fnt_cap != 0 && fc >= _fnt_cap) { _fnt_grow(S); }
    S64(_fnt_names + fc * 8, noff);
    S64(_fnt_offsets + fc * 8, 0 - 1);
    S64(_fnt_params + fc * 8, 0);
    SFNC(S, fc + 1);
    _REGFN_HASH(S, noff, fc);
    # v5.10.25 — auto-register overload mapping in BOTH directions
    # so include-order doesn't matter:
    #   FORWARD: this fn ends with `_str`/`_int`/`_cstr` AND base
    #            fn already registered → register fc as that base's
    #            overload target.
    #   REVERSE: this fn is a base AND a sibling already-registered
    #            fn matches `<this_name>_str`/`_int`/`_cstr` → register
    #            that sibling as fc's overload target.
    # Without bidirection, lib/str.cyr's `println_str` defined BEFORE
    # lib/string.cyr's `println` would never get registered.
    var _ov_p = S + 0xEC00000 + noff;
    var _ov_my_len = 0;
    while (load8(_ov_p + _ov_my_len) != 0) { _ov_my_len = _ov_my_len + 1; }
    # FORWARD direction
    var _ov_kind = _OVERLOAD_SUFFIX(S, noff);
    if (_ov_kind > 0) {
        var _ov_suffix_len = 4;
        if (_ov_kind == 3) { _ov_suffix_len = 5; }
        var _ov_base_len = _ov_my_len - _ov_suffix_len;
        var _ov_base_fi = _FINDFN_CSTR(S, _ov_p, _ov_base_len);
        if (_ov_base_fi >= 0) {
            # v6.4.75 — write through the RELOCATABLE table pointer, not the fixed
            # pre-grow base. _fnt_ovstr/ovint/ovcstr are in the _fnt_grow copy list
            # (they DO grow past 8192), but this forward-registration site alone
            # still wrote `S + 0x97A000 + ...`; once _fnt_grow relocated the table
            # off that fixed base, a forward-registered overload landed in the
            # abandoned region while every reader (parse_fn.cyr:1083/1109) looked at
            # the grown _fnt_ovstr — so overloads registered after a grow silently
            # went missing. The REVERSE-direction writes below already used the
            # pointers; this matches them.
            var _ov_tab = _fnt_ovstr;
            if (_ov_kind == 2) { _ov_tab = _fnt_ovint; }
            if (_ov_kind == 3) { _ov_tab = _fnt_ovcstr; }
            S64(_ov_tab + _ov_base_fi * 8, fc + 1);
        }
    }
    # REVERSE direction — find any already-registered `<my_name>_<suffix>` sibling.
    # ⚡ v6.5.42: three hash lookups, replacing a full walk of every registered fn. See
    # `_findfn_noff_suffix` above for the measurement and the equivalence argument.
    if (_ov_kind == 0) {
        var _rv_s = _findfn_noff_suffix(S, noff, "_str", 4);
        if (_rv_s >= 0) { S64(_fnt_ovstr + fc * 8, _rv_s + 1); }
        var _rv_i = _findfn_noff_suffix(S, noff, "_int", 4);
        if (_rv_i >= 0) { S64(_fnt_ovint + fc * 8, _rv_i + 1); }
        var _rv_c = _findfn_noff_suffix(S, noff, "_cstr", 5);
        if (_rv_c >= 0) { S64(_fnt_ovcstr + fc * 8, _rv_c + 1); }
    }
    return fc;
}

# Find function by name, return index or -1. v5.6.5 O1: hash-table
# fast path first (FNV-1a at 0x110000). Open-addressing with linear
# probing; stop on empty slot or content match via STREQ. Fall through
# to the use-alias linear scan only on hash miss — direct fn-name
# lookups (the >99% hot path) hit the hash and return immediately.
# v6.5.38 — resolve a name that has MULTIPLE definitions, at least one private.
#
# ⭐ THIS IS WHAT MAKES `private` A REAL BOUNDARY. Before this, the fn table held exactly
# one entry per NAME and a second definition overwrote the first ("last definition wins"),
# so a private helper was silently replaced by any same-named fn in any other file —
# INCLUDING for its own file's internal calls. Declaring `private` on both sides did not
# help, because visibility was enforced only at the REFERENCE site, on top of an unchanged
# global symbol table. Filed from owl 1.4.7, where vyakarana and sankoch each define a
# private `_stream_grow` disagreeing about arity, buffer offsets AND return polarity — a
# wrong binding there reports every successful buffer grow as a FAILURE, inside a
# tokenizer, on file content. v6.5.37 closed only the arity-differing case, as an error.
#
# The caller's file comes from the CURRENT TOKEN, not from `_cur_fn_ix` — the same choice
# `_vis_check` documents and for the same reason: the inline-replay path re-parses a
# callee's body while `_cur_fn_ix` still names the enclosing fn, so the fn table would
# answer for the wrong file.
#
# Preference order, and each arm matters:
#   1. a definition PRIVATE TO THE CALLER'S OWN FILE — the file's own helper always wins
#      inside that file, which is precisely what §1 of the filing got wrong;
#   2. otherwise the first NON-private definition — a public fn stays reachable from
#      everywhere, so splitting a name does not hide an ordinary API;
#   3. otherwise the first match, so the caller is referencing someone else's private fn
#      and `_vis_check` produces the existing "is private to its file" error. Returning -1
#      here instead would turn a precise diagnostic into "undefined function".
fn _findfn_scoped(S, noff, slot, first): i64 {
    var caller = FM_FILEID(S, GTLINE(S, GTI(S)));
    var pub_pick = 0 - 1;
    var s2 = slot;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_namehash + s2 * 4);
        if (stored == 0) { probes = _fnt_cap; }
        else {
            var fi = stored - 1;
            var sn = L64(_fnt_names + fi * 8);
            if (STREQ(S, sn, noff) == 1) {
                if ((GFLG(S, fi) & 64) != 0) {
                    var owner = GFFI(S, fi) - 1;      # GFFI stores fid+1; 0 = unknown
                    if (owner >= 0) { if (owner == caller) { return fi; } }
                }
                else { if (pub_pick < 0) { pub_pick = fi; } }
            }
            s2 = (s2 + 1) & _fnt_hash_mask;
            probes = probes + 1;
        }
    }
    if (pub_pick >= 0) { return pub_pick; }
    return first;
}

fn FINDFN(S, noff): i64 {
    var h = FNV1A_NOFF(S, noff);
    var slot = h & _fnt_hash_mask;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_namehash + slot * 4);
        if (stored == 0) { probes = _fnt_cap; }
        else {
            var fi = stored - 1;
            var sn = L64(_fnt_names + fi * 8);
            if (STREQ(S, sn, noff) == 1) {
                # v6.5.38 — bit 7 (128) = "this NAME has more than one definition, and at
                # least one of them is private". Set only by the split in PARSE_FN_DEF, so
                # it is clear for every fn in a normal program: the common path still
                # returns on the first match with no extra work and no file-map lookup.
                if ((GFLG(S, fi) & 128) != 0) { return _findfn_scoped(S, noff, slot, fi); }
                return fi;
            }
            slot = (slot + 1) & _fnt_hash_mask;
            probes = probes + 1;
        }
    }
    # Check use aliases: if noff matches a use_from, look up use_to
    var uc = GUSEC(S);
    var i = 0;
    while (i < uc) {
        var ufrom = L64(S + 0x18FFD0 + i * 8);
        if (STREQ(S, ufrom, noff) == 1) {
            var uto = L64(S + 0x1901D0 + i * 8);
            return FINDFN(S, uto);
        }
        i = i + 1;
    }
    # v6.4.3: f64v2(...) / f64v4(...) constructor sugar. An f64v2/f64v4 call
    # name that is NOT a real fn resolves to the lib constructor f64v2_make /
    # f64v4_make (lib/simd.cyr) — the natural `type(...)` spelling over the
    # proven make (agnos FP issue §2). Only fires as a fallback: a real fn
    # named f64v2 is found by the hash probe above and takes precedence.
    var _cp = S + 0xEC00000 + noff;
    if (load8(_cp) == 0x66) {                 # 'f'
        if (load8(_cp + 1) == 0x36) {         # '6'
            if (load8(_cp + 2) == 0x34) {     # '4'
                if (load8(_cp + 3) == 0x76) { # 'v'
                    var _cd = load8(_cp + 4);
                    if (load8(_cp + 5) == 0) {          # exactly "f64vN"
                        if (_cd == 0x32) {              # '2'
                            var _mk2 = _FINDFN_CSTR(S, "f64v2_make", 10);
                            if (_mk2 >= 0) { return _mk2; }
                        }
                        if (_cd == 0x34) {              # '4'
                            var _mk4 = _FINDFN_CSTR(S, "f64v4_make", 10);
                            if (_mk4 >= 0) { return _mk4; }
                        }
                    }
                }
            }
        }
    }
    return 0 - 1;
}

# v5.7.31: find fn index by literal c-string name (str_ptr / str_len).
# Used by parse_expr.cyr's aarch64 polyfill dispatch for f64_exp /
# f64_ln, where the lookup target is a fixed compiler-internal name
# rather than a user IDENT (whose noff would be available via
# PEEKV). Linear scan over GFCNT(S) entries; the str_data names are
# NUL-terminated, so we match str_len bytes AND verify the trailing
# NUL to avoid prefix matches. Returns fn index or -1.
# v5.11.37: _FINDFN_CSTR relocated to src/common/util.cyr so backend
# emit.cyr files can resolve polyfill fn indices without forward refs.
# See util.cyr for the definition.

# NOTE: Arch-specific function emit functions (EFNPRO, ESUBRSP, EFNEPI,
# ECALLTO, ECALLFIX, EPOPARG, ECALLPOPS, ECALLCLEAN, EDISP32,
# ESTOREREGPARM, ESTORESTACKPARM, ESTOREPARM, EFLLOAD, EFLSTORE)
# are in the arch-specific emit files:
#   x86_64:  src/backend/x86/emit.cyr
#   aarch64: src/backend/aarch64/emit.cyr

# Find fn local variable by name
fn FINDLOCAL(S, noff): i64 {
    var lc = GFLC(S);
    var i = lc - 1;
    # Search backward so inner scope shadows outer
    while (i >= 0) {
        var sn = L64(S + 0x5D9D000 + i * 8);
        if (sn >= 0) { if (STREQ(S, sn, noff) == 1) { return i; } }
        i = i - 1;
    }
    return 0 - 1;
}

# ================================================================
# PARSER — STATEMENT DISPATCH + FUNCTION SUPPORT
# ================================================================

# ⭐ 6.6.7 — THE TAIL ARM'S DIVERT LIST, IN ONE PLACE. `return IDENT(args);` is lowered to
# epilogue + `jmp` (ETAILJMP; the same shape on cx since 6.6.12), which reaches NOTHING the normal
# return does: not the return landing, not the defer walker, not PARSE_FNCALL. Every obligation
# PARSE_FNCALL or the epilogue carries therefore had to be re-discovered here, one silent wrong
# value at a time, and bolted on as its own `tc_has_addr = 1` line — fifteen diverts by 6.6.7
# (plus five checks copied into the emission itself: arity, #pure, #deprecated, SIMD_TC and the
# Win64 argument ceiling), spread over two hundred lines, while the standing note and a code
# comment each counted four. The diverts live in these four predicates now; a new obligation is
# a new line HERE. 1 = take the normal
# call path. ⚠ Every test is read-only (FINDFN, masks, token peeks) — order is free.
# ⚠ Over-diverting is NOT free: it costs the tail call, and a self-recursive tail call that
# loses it grows the stack (6.6.5 measured a correct program turned into rc 139). Each test is
# the exact question of the thing it protects, never an approximation. CHANGELOG [6.6.7]
fn _tc_must_divert(S, cfi, ti_after): i64 {
    if (_tc_frame_divert(S) == 1) { return 1; }
    if (_tc_callee_divert(S, cfi) == 1) { return 1; }
    if (_tc_args_divert(S, cfi, ti_after) == 1) { return 1; }
    if (_tc_generic_divert(S, cfi, ti_after) == 1) { return 1; }   # 6.6.10
    return 0;
}
# What THIS fn must still do after the callee returns, or what its frame must outlive.
fn _tc_frame_divert(S): i64 {
    # 6.6.7 — a fn with a `defer` or `secret var` ANYWHERE in its body: the jmp skipped the walker,
    # so the block never ran and a secret was never zeroised (CVE-47). The WHOLE body, prescanned
    # at its `{` (`_body_has_defer`) — a registered-so-far count misses a loop whose tail return
    # lexically precedes the defer. Such a fn never tail-calls; a deep self-recursion needs a loop.
    if (_cur_fn_has_defer == 1) { return 1; }
    # 6.6.7 — a tail call pushes nothing onto rp_vec, which is how _PARSE_DEFER refuses a
    # `return` inside a defer body. (Subsumed by the line above; kept as the defer arm's own rule.)
    if (_in_defer == 1) { return 1; }
    # 6.6.8 — a coroutine's completion (`_coro_mark_done`: state DONE + the stored result) lives
    # in the epilogue a `jmp` skips, so a tail-shaped `return f(x);` left it resumable and every
    # later force re-ran the tail. CHANGELOG [6.6.8]
    if (_cur_fn_coro == 1) { return 1; }
    # v6.5.14 — a pointer to a local laundered through a variable (`var p = &buf; return f(p);`):
    # the epilogue frees the frame the callee reads. Set wherever this fn materialises `&local`.
    if (_fn_local_addr == 1) { return 1; }
    # 6.6.6 — a struct-returning CALLER copies into its own retptr, which a `jmp` cannot do.
    if (_cur_fn_ret_sid > 0) { if (_cur_fn_ret_stash > 0) { return 1; } }
    # 6.6.6 — the rax:rdx PAIR and the VECTOR classes: a `jmp` hands the callee's return
    # convention straight to OUR caller, right only when the callee returns this same type the
    # same way (`return s2b(1);` from a `: P2` fn left rdx unwritten). The normal path is where
    # `_refuse_pair_return` / `_refuse_simd_return` see the shape.
    if (_cur_fn_ret_pair == 1) { if (_pair_ret_call_ok(S) == 0) { return 1; } }
    if (_cur_fn_returns_vector(S) == 1) { if (_simd_ret_call_ok(S) == 0) { return 1; } }
    # v6.4.31 — a SIMD-returning fn on Win64 returns through a hidden retptr in RCX, which the tail
    # path's argument marshalling overwrites (`return f32v4_make(...)` SIGSEGV'd).
    if (_TARGET_PE == 1) {
        if (_cur_fn_ret_stash > 0) {
            if (_cur_fn_returns_vector(S) == 1) { return 1; }
        }
    }
    return 0;
}
# What the CALLEE needs from PARSE_FNCALL that the tail path's plain argument loop never does.
fn _tc_callee_divert(S, cfi): i64 {
    # v6.5.17 — fncall0..8 are INDIRECT calls; `jmp fncallN` skipped the closure dispatch.
    if (_IS_FNCALL_NAME(S, PEEKV(S)) == 1) { return 1; }
    # 6.6.11 — `sizeof` / `mulh64` are lowered inline by PARSE_FACTOR; there is no fn to jump to.
    if (_is_ident_intrinsic(S, PEEKV(S)) == 1) { return 1; }
    # 6.6.6 — a >16 B struct-returning callee writes through a retptr the tail path never passes.
    if (_ret_agg_class(S, cfi) == 2) { return 1; }
    if (cfi < 0) { return 0; }
    # v6.3.36 — plain-struct params are ADDRESS-passed: pointers into the frame the jmp frees.
    if (_smask_args(cfi) != 0) { return 1; }
    # v6.4.53 — value-form SIMD params travel in vector registers; the tail path loads only the
    # integer ones (`return f32v4_add(v, v)` returned v).
    if (L64(_fnt_simdmask + cfi * 8) != 0) { return 1; }
    if (_pm_row_any(cfi, 0xC0) != 0) { return 1; }   # 6.6.17 (a10)
    # v6.5.1 — an overload-suffix sibling: the `_str`/`_int` dispatch lives only in PARSE_FNCALL
    # (`return println(myStr);` silently called the cstr base).
    if (L64(_fnt_ovstr + cfi * 8) != 0) { return 1; }
    if (L64(_fnt_ovint + cfi * 8) != 0) { return 1; }
    return 0;
}
# What the ARGUMENT LIST needs. The scan runs to the call's matching `)`.
fn _tc_args_divert(S, cfi, ti_after): i64 {
    var has_lit = 0;
    var depth = 1;
    var i = ti_after + 1;
    while (i < GTCNT(S)) {
        var t = TOKTYP(S, i);
        if (t == 10) { depth = depth + 1; }
        if (t == 11) { depth = depth - 1; if (depth == 0) { break; } }
        # v5.8.16 — `&local` spelled in the arg list: the callee reads the frame the jmp frees.
        if (t == 27) { return 1; }
        if (t == 1) { has_lit = 1; }
        i = i + 1;
    }
    if (cfi < 0) { return 0; }
    # v6.5.2 — an integer literal into a `: cstring` param is refused by PARSE_FNCALL only.
    if (has_lit == 1) { if (L64(_fnt_cstrmask + cfi * 8) != 0) { return 1; } }
    if (has_lit == 1) { if (_pm_row_any(cfi, 4) != 0) { return 1; } }   # 6.6.17 (a10)
    # 6.6.5 — a string literal into a `: Str` param is `str_from`-wrapped by PARSE_FNCALL only.
    # `_tc_str_literal_arg` asks PARSE_FNCALL's exact question (the literal is that argument's
    # FIRST token AND that argument's mask bit is set): looser forms were measured to cost a
    # self-recursive tail call its TCO.
    if (_tc_str_literal_arg(S, ti_after, cfi) == 1) { return 1; }
    return 0;
}

# Parse return expr ;  (uses PCMPE so return a == b; works)
# Tail call optimization: return fn(args); → epilogue + jmp fn
fn PARSE_RETURN(S): i64 {
    # v6.2.27 (review P2): a #naked fn emits no epilogue, so a `return` would jump
    # to a non-existent epilogue and fall through into the next fn. A naked ISR
    # must self-terminate in asm (iretq/eret) — reject `return` in its body.
    if (_cur_fn_naked == 1) {
        ERR_MSG(S, "return is not allowed in a #naked fn (body must end in asm: iretq/eret)", 71);
    }
    STI(S, GTI(S) + 1);
    # v6.5.67 — PROPAGATE PAIR-RETURNING-NESS. `fn mk(x) { return SOk(x); }` forwards a `: stack`
    # enum's (tag, payload) pair, so `mk` is itself pair-returning and binding ITS result to one
    # variable loses the payload just as surely. Marking the enclosing fn here is what makes the
    # diagnostic reach the idiomatic wrapper shape rather than only the bare constructor.
    # ⚠ Order-dependent by construction: a caller parsed BEFORE the callee's body will not see the
    # flag and degrades to the pre-v6.5.67 behaviour. That is the safe direction for a diagnostic —
    # a missed warning, never a false one.
    if (_cur_fn_ix >= 0) {
        if (_callee_returns_pair(S) == 1) { SFLG(S, _cur_fn_ix, GFLG(S, _cur_fn_ix) | 256); }
    }
    # Check for tail call: return IDENT(args);
    # Pattern: next token is IDENT, followed by LPAREN
    # Disabled inside inline replay (would emit caller's epilogue)
    if (GINFN(S) == 1) { if (GIDEP(S) == 0) {
            if (PEEKT(S) == 2) {
                var ti_after = GTI(S) + 1;
                if (ti_after < GTCNT(S)) {
                    if (TOKTYP(S, ti_after) == 10) {
                        # Verify it's actually a tail call: find matching ) and check for ;
                        var tc_scan = ti_after + 1;
                        var tc_depth = 1;
                        var tc_is_tail = 0;
                        while (tc_scan < GTCNT(S)) {
                            if (TOKTYP(S, tc_scan) == 10) { tc_depth = tc_depth + 1; }
                            if (TOKTYP(S, tc_scan) == 11) { tc_depth = tc_depth - 1; if (tc_depth == 0) { break; } }
                            tc_scan = tc_scan + 1;
                        }
                        if (tc_scan + 1 < GTCNT(S)) {
                            if (TOKTYP(S, tc_scan + 1) == 5) { tc_is_tail = 1; }
                        }
                        # Every reason to take the normal call path instead is in ONE predicate (above
                        # PARSE_RETURN). CHANGELOG [6.6.7]
                        if (tc_is_tail == 1) {
                            if (_tc_must_divert(S, FINDFN(S, PEEKV(S)), ti_after) == 1) { tc_is_tail = 0; }
                        }
                        if (tc_is_tail == 1) {
                            # Tail call: return fn(args); → evaluate args, epilogue, jmp fn
                            var tcnoff = PEEKV(S);
                            # v6.2.41 — capture call-site line for the arity check.
                            var _tc_line = GTLINE(S, GTI(S));
                            STI(S, GTI(S) + 1);
                            # Parse args (same as PARSE_FNCALL arg handling)
                            STI(S, GTI(S) + 1);  # consume (
                            # 6.6.16 — the token the call's warnings name (PARSE_FNCALL's
                            # convention: the first token after `(`). By the time they fire the
                            # cursor is past `);`, on the NEXT statement. CHANGELOG [6.6.16]
                            var _tc_wti = GTI(S);
                            var tcargc = 0;
                            # SIMD_TC (v6.4.15): the tail-call path bypasses
                            # PARSE_FNCALL, so a value-form SIMD arg mismatched to the
                            # callee's SIMD param (e.g. f64v2 where f32v4 is expected)
                            # was accepted silently. Read the callee's param mask
                            # up-front (FINDFN is read-only — the real FINDFN/REGFN
                            # registration below is unchanged, so fn-table order and
                            # codegen are byte-identical) and reject a mismatch,
                            # mirroring PARSE_FNCALL's class check. Reject-only: the
                            # PCMPE/EPUSHR emission is untouched, so well-typed calls
                            # (and every SIMD-free call) stay byte-identical.
                            var _tc_prefi = FINDFN(S, tcnoff);
                            if (PEEKT(S) != 11) {
                                var tcgo = 1;
                                while (tcgo == 1) {
                                    var _tc_cls = _pm_simd(_tc_prefi, tcargc);   # 6.6.17 (a10)
                                    if (_tc_cls > 0) {
                                        if (PEEKT(S) != 2) { ERR_MSG(S, "value-form SIMD arg must be a local IDENT", 41); }
                                        var _tc_alli = FINDLOCAL(S, PEEKV(S));
                                        if (_tc_alli < 0) { ERR_MSG(S, "value-form SIMD arg: IDENT not found as a local", 47); }
                                        var _tc_alt = GLTYPE(S, _tc_alli);
                                        if (_tc_cls == 1) {
                                            if (_is_simd128(S, _tc_alt) == 0) { ERR_MSG(S, "value-form SIMD arg must be a 16-byte vector", 44); }
                                        } elif (_tc_cls == 3) {
                                            if (_tc_alt != 0 - 2121) { ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f32v4)", 56); }
                                        } else {
                                            if (_tc_alt != 0 - 2125) { ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f64v4)", 56); }
                                        }
                                    }
                                    _check_str_cstring_arg(S, _tc_prefi, tcargc, tcnoff);   # 6.6.13 I11
                                    PCMPE(S);
                                    EPUSHR(S);
                                    tcargc = tcargc + 1;
                                    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                                    else { tcgo = 0; }
                                }
                            }
                            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
                            STI(S, GTI(S) + 1);  # consume )
                            # Pop args into registers
                            ECALLPOPS(S, tcargc);
                            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                            STI(S, GTI(S) + 1);
                            # Look up function
                            var tcfi = FINDFN(S, tcnoff);
                            if (tcfi < 0) { tcfi = REGFN(S, tcnoff); }
                            _callee_site_checks(S, tcfi, tcnoff, _tc_wti);   # v6.6.4: tail calls warned nothing
                            # v5.8.20: #pure enforcement on the tail-call path —
                            # `return helper(args);` bypasses PARSE_FNCALL but
                            # still needs the #io / #alloc check.
                            if (_cur_fn_is_pure == 1) {
                                var _tcf = GFLG(S, tcfi);
                                if (_tcf & 16 != 0) {
                                    syscall(SYS_WRITE, 2, "warning:", 8);
                                    _err_head_at(S, _tc_wti);
                                    syscall(SYS_WRITE, 2, ": #pure fn calls #io fn '", 25);
                                    PRSTR(S + 0xEC00000 + tcnoff);
                                    syscall(SYS_WRITE, 2, "'\n", 2);
                                }
                                if (_tcf & 32 != 0) {
                                    syscall(SYS_WRITE, 2, "warning:", 8);
                                    _err_head_at(S, _tc_wti);
                                    syscall(SYS_WRITE, 2, ": #pure fn calls #alloc fn '", 28);
                                    PRSTR(S + 0xEC00000 + tcnoff);
                                    syscall(SYS_WRITE, 2, "'\n", 2);
                                }
                            }
                            # v6.2.41 — arity check on the tail-call path
                            # (`return f(args);`). Mutually exclusive with
                            # PARSE_FNCALL (no double-fire); the most common call
                            # form, so covering it closes the bulk of the hole.
                            _CHECK_ARITY(S, _tc_line, tcnoff, tcfi, tcargc, 1);
                            # ⛔ 6.6.5 — this said `tcargc > 6`, the SysV register ceiling, on
                            # every target. On Win64 the ceiling is 4, so `return f5(...)` and
                            # `return f6(...)` took the TAIL-CALL branch: ETAILJMP's `mov rsp,rbp`
                            # tore down the frame ECALLPOPS had just written the stack arguments
                            # into, and the callee read whatever was above the old frame. Silent
                            # wrong values on real Windows (measured: 0 where 3 was right), and
                            # the reason frontend/expr_in_fn_args and stdlib/flags failed as PE.
                            # `_ARG_REG_COUNT()` is the same function the closure ABI uses, so
                            # the two cannot drift. CHANGELOG [6.6.5]
                            if (tcargc > _ARG_REG_COUNT()) {
                                # over the register ceiling: normal call (stack args would be
                                # clobbered by the tail-call epilogue)
                                var foff2 = L64(_fnt_offsets + tcfi * 8);
                                if (foff2 >= 0) { ECALLTO(S, foff2); }
                                else { ECALLFIX(S, tcfi); }
                                ECALLCLEAN(S, tcargc);
                                # Jump to function epilogue (same as normal return)
                                var rp2 = EJMP0(S);
                                vec_push(rp_vec, rp2);
                            } else {
                                # Emit epilogue + jmp (tail call, ≤6 args only)
                                ETAILJMP(S, tcfi);
                            }
                            return 0;
                        } }
                }
            }
        } }
    # Check for multi-return: return (a, b) → ret2(a, b)
    if (PEEKT(S) == 10) {
        # Scan ahead for comma at depth 1 to distinguish (a, b) from (a + b)
        var mr_scan = GTI(S) + 1;
        var mr_depth = 1;
        var mr_is_tuple = 0;
        # v6.5.21: COUNT the depth-1 commas instead of stopping at the first, so
        # `return (a, b, c);` is recognised as arity 3 rather than erroring at the
        # second comma with `expected ')'`.
        var mr_commas = 0;
        while (mr_scan < GTCNT(S) && mr_depth > 0) {
            var mr_tok = TOKTYP(S, mr_scan);
            if (mr_tok == 10) { mr_depth = mr_depth + 1; }
            if (mr_tok == 11) { mr_depth = mr_depth - 1; }
            if (mr_tok == 31 && mr_depth == 1) { mr_is_tuple = 1; mr_commas = mr_commas + 1; }
            mr_scan = mr_scan + 1;
        }
        # ⛔ 6.6.6 — A TUPLE RETURN IS A THIRD SPELLING THE VECTOR REFUSAL BELOW NEVER SEES.
        # Both arms below hand the values back in the ret2/ret3 INT register convention
        # (rax:rdx[:r3]) and `return 0` out of PARSE_RETURN, so they run in front of the
        # `_cur_fn_returns_vector` refusal ~330 lines down exactly the way the tail-call path
        # does. A vector return is a different convention on every target (XMM0/XMM1, V0/V1,
        # four cx R-regs, a PE retptr), so `fn bad(): f64v2 { return (41, 7); }` built clean
        # and the caller read 0 — measured on f64v2, f32v4, i64v2 and the arity-3 form into
        # f64v4. The PAIR class is untouched: rax:rdx IS its ABI. Refuse here and let the arms
        # below parse the tuple anyway, so the token stream stays in sync for the rest of the
        # body. See `_refuse_simd_return`. CHANGELOG [6.6.6]
        if (mr_is_tuple == 1) { _refuse_vector_tuple_return(S); }
        if (mr_is_tuple == 1) { if (mr_commas > 1) {
                # --- arity 3 ---------------------------------------------------
                # Push each value but the last, leave the last in rax, then unwind
                # into the return registers back-to-front. Generalises the arity-2
                # sequence below; nothing here is arity-2-specific.
                if (mr_commas > 2) {
                    ERR_MSG(S, "multi-value return needs 2 or 3 types", 37);
                }
                STI(S, GTI(S) + 1);  # consume (
                PCMPE(S);
                EPUSHR(S);                                                          # push a
                if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
                PCMPE(S);
                EPUSHR(S);                                                          # push b
                if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);
                PCMPE(S);                                                           # rax = c
                EMOVR3RAX(S);                                                       # ret3 = c
                EPOPR(S);                                                           # rax = b
                EMOVRDXRAX(S);                                                      # rdx = b
                EPOPR(S);                                                           # rax = a
                if (_cur_fn_ret_scalar == 0 - 9) { EMOVQ_X0_A(S); }
                if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);  # consume )
                if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1);    # consume ;
                var rp3 = EJMP0(S);
                vec_push(rp_vec, rp3);
                return 0;
            } }
        if (mr_is_tuple == 1) {
            # Multi-return: return (a, b) → same codegen as ret2(a, b)
            STI(S, GTI(S) + 1);  # consume (
            PCMPE(S);
            EPUSHR(S);
            if (PEEKT(S) != 31) { ERR_EXPECT(S, 31); } STI(S, GTI(S) + 1);  # consume ,
            PCMPE(S);
            # rax = b, stack = a → mov rdx, rax; pop rax
            EMOVRDXRAX(S);
            EPOPR(S);
            # v6.5.21: a `: f64` fn returning a TUPLE silently lost its FIRST
            # value. This branch returns early, so it never reached the
            # `_cur_fn_ret_scalar == 0 - 9` box below (:939) — yet the CALL SITE
            # unboxes unconditionally (`movq rax, xmm0`, parse_expr.cyr:609) for
            # any `: f64` callee. rax therefore arrived holding whatever f64 op
            # last touched xmm0: `fn f(a: f64, b: f64): f64 { return (a*b, a+b); }`
            # with 3.0/4.0 handed back 7 for BOTH values instead of 12 and 7, at
            # rc=0 with no diagnostic. Box the first value here so the caller's
            # unbox recovers it; rdx still carries the second, untouched.
            # x86-family only — EMOVQ_X0_A is a no-op on aarch64/cx, which is
            # why aarch64 was already correct. CHANGELOG [6.5.21].
            if (_cur_fn_ret_scalar == 0 - 9) { EMOVQ_X0_A(S); }
            if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); } STI(S, GTI(S) + 1);  # consume )
            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); } STI(S, GTI(S) + 1);  # consume ;
            var rp = EJMP0(S);
            vec_push(rp_vec, rp);
            return 0;
        }
    }
    # v5.5.36 Phase 2b — struct return by value. When the current fn
    # has `: StructName` on its signature, `return IDENT;` (where IDENT
    # is a struct-typed local matching the fn's ret_sid) is emitted as
    # a byte copy from &IDENT into the hidden retptr stashed at fn
    # entry. rax is set to the retptr (standard Win64/SysV convention
    # — caller may read rax to chain the value, though usually ignored
    # in favor of the caller-allocated destination).
    #
    # Only the simple `return IDENT;` form is supported; nested
    # expressions that produce structs (`return make_other();` etc.)
    # land in Phase 2c once call-site rewriting exists.
    # v5.10.2: only the BIG-struct path (stash > 0) uses the
    # byte-copy machinery. ≤16-byte struct returns (Str etc.) get
    # stash = 0 from the rough-scan up-front check; fall through
    # to the scalar return path which treats the local as a
    # pointer value and returns it via rax (matching the existing
    # stdlib convention: `Str` values are 16-byte heap structs
    # passed around as pointers, not by-value).
    if (_cur_fn_ret_sid > 0 && _cur_fn_ret_stash > 0) {
        # 6.6.6: `return f(..);` where `f` returns this same struct — emitted into a temp, then
        # copied into our retptr like `return IDENT;`. It used to take the tail path and crash.
        var srn_lli = _return_struct_call(S);
        if (srn_lli < 0) { srn_lli = _return_struct_expr(S); }   # a method / operator (bite 14 review)
        if (srn_lli < 0) {
            if (PEEKT(S) != 2) {
                ERR_MSG(S, "struct-return fn: return must be a bare local identifier, or a call to a fn returning the same struct", 101);
            }
            var srn_noff = PEEKV(S);
            if (TOKTYP(S, GTI(S) + 1) != 5) {
                ERR_MSG(S, "struct-return fn: return must be a bare local identifier, or a call to a fn returning the same struct", 101);
            }
            srn_lli = FINDLOCAL(S, srn_noff);
            if (srn_lli < 0) {
                ERR_MSG(S, "struct-return: identifier is not a local", 40);
            }
            var srn_lt = GLTYPE(S, srn_lli);
            if (srn_lt >= 0) {
                ERR_MSG(S, "struct-return: identifier is not struct-typed", 45);
            }
            if ((0 - srn_lt) != _cur_fn_ret_sid) {
                ERR_MSG(S, "struct-return: identifier type != fn ret_sid", 44);
            }
            STI(S, GTI(S) + 1);            # consume IDENT
        }
        if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
        STI(S, GTI(S) + 1);            # consume ';'
        # 6.6.6 — `return q;` where `q` is a by-value struct PARAMETER: its slot holds the
        # caller's ADDRESS, so the byte-copy below would copy the pointer word. Materialise the
        # struct into an inline temp and return THAT. See `_local_is_sptr_param`.
        # 6.6.17 (a1): and a HANDLE (a pointer-mode local). See `_ret_local_inline`.
        srn_lli = _ret_local_inline(S, srn_lli);
        # Byte-copy size (aligned up to 8 — the retptr slot is already
        # 8-aligned so padded copies are safe)
        var srn_sz = STRUCTSZ(S, _cur_fn_ret_sid - 1);
        var srn_aligned = (srn_sz + 7) & (0 - 8);
        # Source disp: &IDENT (bottom of struct) in the fn's frame
        var srn_src_disp = 0 - ((srn_lli + 1) * 8);
        if (_cur_fn_regalloc > 0) { srn_src_disp = srn_src_disp - _cur_fn_regalloc * 8; }
        if (_cur_fn_ret_stash > 0) { srn_src_disp = srn_src_disp - _cur_fn_ret_stash; }
        # Retptr stash disp: [rbp - regalloc*8 - 8]
        var srn_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
        # v5.9.26 Phase 2b-aarch64 (LDRB/STRB byte-copy loop):
        # cx bytecode still has no struct-return opcode → ERR_MSG;
        # aarch64 emits the LDRB/STRB analog of x86's `rep movsb`.
        # Encoding plan (3-instr loop body + setup + tail):
        #   movz/sub  x9, x29, #|src_disp|         ; via _EFP_ADDR_X9
        #   ldur      x10, [x29, #stash_disp]      ; retptr
        #   movz      x11, #aligned_byte_count
        # loop:
        #   ldrb      w12, [x9], #1                ; post-inc source
        #   strb      w12, [x10], #1               ; post-inc dest
        #   subs      x11, x11, #1
        #   b.ne      loop                         ; -3 instructions back
        #   ldur      x0, [x29, #stash_disp]       ; reload retptr
        # Constraints:
        #   - aligned size must fit MOVZ imm16 (< 65536). Cyrius
        #     struct sizes are bounded well below this in practice;
        #     guard error fires for the implausible large case.
        #   - stash_disp = -(regalloc*8 + 8). With regalloc cap of
        #     5, stash_disp in [-48,-8] always fits LDUR's signed
        #     9-bit immediate (-256..+255). Defensive guard checks.
        # v5.9.40 — struct-by-value return now goes through each
        # backend's `ESTRUCT_BYVAL_COPY` helper. Closes Phase 2c #1
        # (cx was the last remaining ERR_MSG path; aarch64 landed
        # at v5.9.26, x86 has been there since v5.6.12). Each
        # backend chooses its own copy strategy:
        #   x86      — push rsi/rdi + lea/mov + `rep movsb` (3 B)
        #   aarch64  — LDRB/STRB byte-loop with post-increment
        #   cx       — load8/store8 byte-loop with explicit
        #              add r9/r10/r11 + jnz back-jump (cxvm has
        #              no rep/post-incr semantics).
        # Constraints (apply to all backends in practice; named
        # at this call site for clarity since they are real
        # encoding limits, not invariants of the helper):
        #   - aligned byte count must fit MOVZ imm16 (< 65536) on
        #     aarch64. Cyrius struct sizes are bounded well below
        #     this; guard fires for the implausible large case.
        #   - stash_disp = -(regalloc*8 + 8) on aarch64 must fit
        #     LDUR's signed 9-bit immediate (-256..+255). With
        #     regalloc cap of 5, stash_disp is in [-48,-8] — safe.
        if (_AARCH64_BACKEND == 1) {
            if (srn_aligned > 65535) {
                ERR_MSG(S, "struct return by value: struct >= 64 KB pending Phase 2c (movz/movk chain)", 74);
            }
            if (srn_stash_disp < 0 - 256) {
                ERR_MSG(S, "struct return by value: stash_disp out of LDUR imm9 range — increase regalloc-aware fallback", 94);
            }
        }
        ESTRUCT_BYVAL_COPY(S, srn_src_disp, srn_stash_disp, srn_aligned);
        # jmp to epilogue (regular return-patch path)
        var srn_rp = EJMP0(S);
        vec_push(rp_vec, srn_rp);
        return 0;
    }
    # v5.10.45 Phase 1 — int-class 16B struct pair-return.
    # Fires when the current fn is annotated `: StructName` with
    # STRUCTSZ in [9,16] AND the struct sid != Str's sid AND the
    # return form is `return IDENT;` where IDENT is a 2-slot typed
    # local matching the declared return type. Emits the int-class
    # pair load `mov rax, [&v+0]; mov rdx, [&v+8]` via
    # `EFLLOAD_STRUCT_INT_PAIR` then jumps to the epilogue.
    # Falls through to scalar PCMPE for non-IDENT shapes (those
    # land on a follow-up slot — same staging as f64v2's v5.10.28
    # Phase 1 left non-IDENT to a follow-up).
    if (_cur_fn_ret_pair == 1) {
        if (PEEKT(S) == 2) {
            if (TOKTYP(S, GTI(S) + 1) == 5) {
                var _ip_noff = PEEKV(S);
                var _ip_lli = FINDLOCAL(S, _ip_noff);
                if (_ip_lli >= 0) {
                    var _ip_lt = GLTYPE(S, _ip_lli);
                    # Multi-slot typed local: lt < 0 AND -lt == ret_sid.
                    # Single-slot heap-handle pattern (e.g. `var s = alloc(...)`
                    # in a fn returning : Str) falls through to scalar PCMPE.
                    if (_ip_lt < 0) {
                        if ((0 - _ip_lt) == _cur_fn_ret_sid) {
                            STI(S, GTI(S) + 1);     # consume IDENT
                            STI(S, GTI(S) + 1);     # consume ';'
                            # 6.6.6 — an address-passed parameter holds the caller's pointer,
                            # not the pair. Materialise it inline first.
                            # 6.6.17 (a1): and a HANDLE. See `_ret_local_inline`.
                            _ip_lli = _ret_local_inline(S, _ip_lli);
                            EFLLOAD_STRUCT_INT_PAIR(S, _ip_lli);
                            var _ip_rp = EJMP0(S);
                            vec_push(rp_vec, _ip_rp);
                            return 0;
                        }
                    }
                }
            }
        }
        # 6.6.6 — EVERYTHING ELSE. A method / overloaded operator returning this same struct is
        # landed in a frame temp and loaded as the pair; a call returning it in the same two
        # registers passes straight through PCMPE; anything else cannot be carried and is
        # refused by name instead of silently handing back rax plus an unwritten rdx.
        # See `_refuse_pair_return`.
        if (_pair_ret_expr_shape(S) == 1) {
            var _pe_t = _return_struct_expr(S);
            EFLLOAD_STRUCT_INT_PAIR(S, _pe_t);
            if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
            STI(S, GTI(S) + 1);     # consume ';'
            var _pe_rp = EJMP0(S);
            vec_push(rp_vec, _pe_rp);
            return 0;
        }
        if (_pair_ret_call_ok(S) == 0) { _refuse_pair_return(S); }
    }
    if (_ret_small_ptrp(S) == 1) { return 0; }   # 6.6.17 (a1 review): `return p;`, p: *T, T <= 8 B
    # v5.10.28 — f64v2 multi-register pair return ABI.
    # When the current fn is annotated `: f64v2` (encoding -2093 in
    # _cur_fn_ret_scalar; v6.4.14 moved it off the flat -20) AND the
    # return form is `return IDENT;`
    # where IDENT is a 2-slot stack-local f64v2 var, emit the pair
    # load: rax = lo (named slot, &v+0), rdx = hi (filler slot,
    # &v+8). This is x86 SysV's 16-byte int-class struct return
    # ABI. Falls through to the scalar PCMPE path for non-IDENT
    # f64v2 returns (e.g. fn-call returning f64v2) — those land
    # on a follow-up slot.
    #
    # v5.10.31 — Win64 PE branch (`_cur_fn_ret_stash > 0` for
    # f64v2 set by the rough-scan when _TARGET_PE == 1): emit
    # byte-copy from &v into the retptr stash (size 16, aligned).
    # Win64 PCS for ≤16B composite returns uses retptr-style
    # (caller passes hidden buffer ptr in RCX), NOT pair register.
    # Mirror of the existing big-struct retptr return at line ~447.
    if (_is_simd128(S, _cur_fn_ret_scalar) == 1) {  # any 16B/1-XMM vector (f64v2/f32v4/i32v4/i16v8/i8v16/i64v2)
        if (PEEKT(S) == 2) {
            if (TOKTYP(S, GTI(S) + 1) == 5) {
                var _f2_noff = PEEKV(S);
                var _f2_lli = FINDLOCAL(S, _f2_noff);
                if (_f2_lli >= 0) {
                    var _f2_lt = GLTYPE(S, _f2_lli);
                    if (_is_simd128(S, _f2_lt) == 1) {
                        STI(S, GTI(S) + 1);  # consume IDENT
                        STI(S, GTI(S) + 1);  # consume ';'
                        if (_cur_fn_ret_stash > 0) {
                            # Win64 PE retptr-style return — byte-copy
                            # from &v (size 16) into the retptr stash
                            # at [rbp - regalloc*8 - 8]. ESTRUCT_BYVAL_COPY
                            # handles the rep movsb on x86 / LDRB/STRB
                            # loop on aarch64. Aarch64 stash isn't used
                            # by Win64 (Win64 is x86-only), but the
                            # helper is arch-agnostic and works through
                            # the same ABI helper either way.
                            var _f2w_src_disp = 0 - ((_f2_lli + 1) * 8);
                            if (_cur_fn_regalloc > 0) { _f2w_src_disp = _f2w_src_disp - _cur_fn_regalloc * 8; }
                            if (_cur_fn_ret_stash > 0) { _f2w_src_disp = _f2w_src_disp - _cur_fn_ret_stash; }
                            var _f2w_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
                            ESTRUCT_BYVAL_COPY(S, _f2w_src_disp, _f2w_stash_disp, 16);
                        } else {
                            # SysV/aarch64/cx pair-register return.
                            EFLLOAD_F64V2_PAIR(S, _f2_lli);
                        }
                        var _f2_rp = EJMP0(S);
                        vec_push(rp_vec, _f2_rp);
                        return 0;
                    }
                }
            }
        }
    }
    # v5.10.37 — f64v4 pair-quad return ABI. Mirror of v5.10.28's
    # f64v2 pair-return path, but 32-byte composite + 4-slot stack-
    # local. SysV/aarch64/cx: pair-quad register return (two
    # MOVUPDs on x86 / two LDR Q on aarch64 / four R-regs on cx
    # via EFLLOAD_F64V4_PAIR). Win64 PE: retptr-style with size 32.
    # v6.4.8 (SIMD Phase 4) — generalized from the exact -21 (f64v4) check to
    # _is_simd256 so f32v8 (-2153) shares the identical 32-byte / 2×128-XMM return
    # ABI. Byte-identical for f64v4 (_is_simd256(-21)==1); f32v8 is new. The return
    # value's byte layout is the same 32 bytes regardless of float lane width.
    if (_is_simd256(S, _cur_fn_ret_scalar) == 1) {
        if (PEEKT(S) == 2) {
            if (TOKTYP(S, GTI(S) + 1) == 5) {
                var _f4_noff = PEEKV(S);
                var _f4_lli = FINDLOCAL(S, _f4_noff);
                if (_f4_lli >= 0) {
                    var _f4_lt = GLTYPE(S, _f4_lli);
                    if (_is_simd256(S, _f4_lt) == 1) {
                        STI(S, GTI(S) + 1);  # consume IDENT
                        STI(S, GTI(S) + 1);  # consume ';'
                        if (_cur_fn_ret_stash > 0) {
                            # Win64 PE retptr-style — byte-copy size 32.
                            var _f4w_src_disp = 0 - ((_f4_lli + 1) * 8);
                            if (_cur_fn_regalloc > 0) { _f4w_src_disp = _f4w_src_disp - _cur_fn_regalloc * 8; }
                            if (_cur_fn_ret_stash > 0) { _f4w_src_disp = _f4w_src_disp - _cur_fn_ret_stash; }
                            var _f4w_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
                            ESTRUCT_BYVAL_COPY(S, _f4w_src_disp, _f4w_stash_disp, 32);
                        } else {
                            EFLLOAD_F64V4_PAIR(S, _f4_lli);
                        }
                        var _f4_rp = EJMP0(S);
                        vec_push(rp_vec, _f4_rp);
                        return 0;
                    }
                }
            }
        }
    }
    # 6.6.6 — EVERYTHING THAT REACHES HERE. The two branches above take `return IDENT;` for a
    # local of the matching vector class and return outright; the only other shape the vector
    # return ABI can carry is a call to a fn declared to return the SAME vector type (a register
    # passthrough on SysV/aarch64/cx, the retptr marshalling arm below on PE). Anything else
    # used to fall through to the scalar PCMPE path and hand back a half-written register pair,
    # silently.
    # ⛔ THIS SITE IS ONE OF THREE, AND THE OTHER TWO ARE ABOVE IT — this comment read
    # "EVERYTHING ELSE" when first written and that was FALSE, which is how `return (a, b);`
    # shipped unrefused. PARSE_RETURN is a SEQUENCE OF ARMS, each of which recognises a return
    # spelling, emits it, and `return 0`s out of this function; a check placed here is a check
    # only for the spellings that fall through every arm above to reach it. The two that do not:
    # the TAIL-CALL arm (~line 613, diverted by `_cur_fn_returns_vector` + `_simd_ret_call_ok`)
    # and the MULTI-RETURN arm (~line 909, `_refuse_vector_tuple_return`). Before adding a
    # fourth check here, enumerate the early returns above it again — they are the paths this
    # one cannot see. See `_refuse_simd_return`. CHANGELOG [6.6.6]
    if (_cur_fn_returns_vector(S) == 1) {
        if (_simd_ret_call_ok(S) == 0) { _refuse_simd_return(S); }
    }
    # v6.4.31: `return <simd_call>(args);` on Win64 PE — a SIMD-returning fn
    # whose return expression is itself a SIMD-returning call (e.g.
    # `f32v4_splat` → `return f32v4_make(x,x,x,x);`). The callee writes its
    # 16/32-byte result via a retptr; the generic PCMPE path can't set that up.
    # Marshal the inner call into an anon temp local (retptr = &temp, args via
    # the same struct-ptr path parse_decl uses), then byte-copy the temp into
    # THIS fn's retptr stash — the exact shape of the `return IDENT;` handler
    # above, just with a fresh call-result temp. SysV/aarch64 keep the generic
    # register-return path (ret_stash == 0). See [[project_v6431_win64_valueform_simd]].
    if (_TARGET_PE == 1) {
        if (_cur_fn_ret_stash > 0) {
            var _rc_is128 = _is_simd128(S, _cur_fn_ret_scalar);
            var _rc_is256 = _is_simd256(S, _cur_fn_ret_scalar);
            if (_rc_is128 == 1 || _rc_is256 == 1) {
                if (PEEKT(S) == 2) {
                    if (TOKTYP(S, GTI(S) + 1) == 10) {   # IDENT '(' → a call
                        var _rc_noff = PEEKV(S);
                        var _rc_fi = FINDFN(S, _rc_noff);
                        if (_rc_fi >= 0) {
                            if (GFRS(S, _rc_fi) == _cur_fn_ret_scalar) {
                                # Allocate anon temp (filler(s) + named lo slot).
                                var _rc_slots = 2;
                                if (_rc_is256 == 1) { _rc_slots = 4; }
                                var _rc_j = 0;
                                while (_rc_j < _rc_slots - 1) {
                                    var _rc_fill = GFLC(S);
                                    S64(S + 0x5D9D000 + _rc_fill * 8, 0 - 1);
                                    SLDEP(S, _rc_fill, GSDEP(S));
                                    SLTYPE(S, _rc_fill, 0);
                                    SFLC(S, _rc_fill + 1);
                                    _rc_j = _rc_j + 1;
                                }
                                var _rc_named = GFLC(S);
                                S64(S + 0x5D9D000 + _rc_named * 8, 0 - 1);
                                SLDEP(S, _rc_named, GSDEP(S));
                                SLTYPE(S, _rc_named, _cur_fn_ret_scalar);
                                # 6.6.5: the retptr callee writes THROUGH these slots, so the
                                # span has to be recorded like every other multi-slot receive —
                                # this was the ONE negative-SLTYPE registration in the tree
                                # without a SLAGG mark, and the picker's aggregate pass (now
                                # keyed on GLAGG rather than the vector descriptor) would have
                                # spanned it as 1 slot and left the fillers out of ra_unsafe.
                                SLAGG(S, _rc_named, _rc_slots);
                                SFLC(S, _rc_named + 1);
                                if (_rc_named + 1 > _flc_hwm) { _flc_hwm = _rc_named + 1; }
                                # Marshal the inner call: retptr = &temp, then args.
                                _callee_site_checks_here(S, _rc_fi, _rc_noff, 0);   # v6.6.4: PE SIMD-return call emits its own call
                                STI(S, GTI(S) + 1);   # consume callee IDENT
                                STI(S, GTI(S) + 1);   # consume '('
                                EFLADDR(S, _rc_named);
                                EPUSHR(S);
                                # 6.6.6: `_owncall_args` — the gates plus the arity check this
                                # PE-only loop never had (`return f(a);` on a 2-param vector `f`
                                # built clean). CHANGELOG [6.6.6]
                                var _rc_argc = _owncall_args(S, _rc_fi, _rc_noff, 1);
                                if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
                                STI(S, GTI(S) + 1);   # consume ';'
                                var _rc_target = L64(_fnt_offsets + _rc_fi * 8);
                                if (_rc_target >= 0) { ECALLTO(S, _rc_target); }
                                else { ECALLFIX(S, _rc_fi); }
                                ECALLCLEAN(S, _rc_argc);
                                # Byte-copy temp → our retptr stash (mirror return-IDENT).
                                var _rc_src_disp = 0 - ((_rc_named + 1) * 8);
                                if (_cur_fn_regalloc > 0) { _rc_src_disp = _rc_src_disp - _cur_fn_regalloc * 8; }
                                _rc_src_disp = _rc_src_disp - _cur_fn_ret_stash;
                                var _rc_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
                                var _rc_bytes = 16;
                                if (_rc_is256 == 1) { _rc_bytes = 32; }
                                ESTRUCT_BYVAL_COPY(S, _rc_src_disp, _rc_stash_disp, _rc_bytes);
                                var _rc_rp = EJMP0(S);
                                vec_push(rp_vec, _rc_rp);
                                return 0;
                            }
                        }
                    }
                }
            }
        }
    }
    # v5.10.48: bare `return;` synthesizes `return 0;` per cyrius's
    # int-only return convention. Closes
    # `docs/development/issues/2026-05-03-parser-cosmetic-limits-...`
    # `bare_return_in_if_block_rejected`. Pre-fix `if (...) { return;
    # }` errored with "unexpected ';'" because PCMPE was called
    # unconditionally and rejected an empty expression. Now: peek for
    # `;` BEFORE calling PCMPE; if present, emit `mov rax, 0` + jump
    # to epilogue (matches `return 0;` codegen byte-for-byte at this
    # position).
    if (PEEKT(S) == 5) {
        EMOVI(S, 0);
        STI(S, GTI(S) + 1);                             # consume ';'
        var br_rp = EJMP0(S);
        vec_push(rp_vec, br_rp);
        return 0;
    }
    PCMPE(S);
    # v6.4.55: scalar f64 return (sentinel -9) — cyrius boxes the f64 as its IEEE-754
    # bit-pattern in rax; SysV/Win64 return a double in xmm0, so move rax→xmm0 before
    # the epilogue. EMOVQ_X0_A is `movq xmm0, rax` on x86/PE/macho, a no-op on
    # aarch64/cx (value already in x0/r0 = their return reg). CHANGELOG [6.4.55].
    if (_cur_fn_ret_scalar == 0 - 9) { EMOVQ_X0_A(S); }
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);
    # Emit jmp to epilogue (record as return patch)
    var rp = EJMP0(S);
    vec_push(rp_vec, rp);
    return 0;
}

# v5.10.1 — type-check infrastructure: lazy lookup for the
# `Str` struct sid so PARSE_FNCALL can flag Str-typed args
# being passed to cstring-typed (non-`: Str`) params. The
# search shape mirrors `_STR_FROM_NOFF` in parse_expr.cyr —
# scan tok_names for the cstring "Str\0" (4 bytes:
# 0x0072_7453 little-endian), then resolve to a struct id via
# FINDSTRUCT. Returns 0 if Str isn't defined in this program
# (graceful — type checks just don't fire).
var _str_sid_cache = 0 - 1;
fn _STR_SID(S): i64 {
    if (_str_sid_cache >= 0) { return _str_sid_cache; }
    if (_str_sid_cache == 0 - 2) { return 0; }
    var npos = GNPOS(S);
    var i = 0;
    while (i < npos) {
        # "Str\0" first 4 bytes — bottom 32 bits = 0x00727453
        if (load8(S + 0xEC00000 + i)     == 83) {
            if (load8(S + 0xEC00000 + i + 1) == 116) {
                if (load8(S + 0xEC00000 + i + 2) == 114) {
                    if (load8(S + 0xEC00000 + i + 3) == 0) {
                        var sid = FINDSTRUCT(S, i);
                        if (sid > 0) {
                            _str_sid_cache = sid;
                            return sid;
                        }
                    }
                }
            }
        }
        # skip to next null terminator
        while (i < npos) { if (load8(S + 0xEC00000 + i) == 0) { i = i + 1; break; } i = i + 1; }
    }
    _str_sid_cache = 0 - 2;
    return 0;
}

# v5.10.1 — opt-in gate for the call-site type check.
# `CYRIUS_TYPE_CHECK=1` enabled warnings; default was off.
#
# v5.10.26 — DEFAULT FLIPPED ON. The v5.10.5 false-positive
# shape (Str → generic i64 param triggering false warning)
# was closed by v5.10.24's polarity inversion: the warning
# now fires only on params explicitly annotated `: cstring`
# instead of params NOT annotated `: Str`. Empirical sweep
# at v5.10.26 slot entry across 26 cyrius-application repos
# (cyrius / agnosys / hisab / kavach / abaco / aegis /
# agnostik / agnova / argonaut / ark / chakshu / cyim /
# cyim-lsp / cyrius-doom / daimon / darshana / kybernet /
# libro / majra / niyama / nous / owl / phylax / samvada /
# sandhi / shakti / sit / vyakarana / yantra / yukti)
# confirmed ZERO type-check warnings with TYPE_CHECK=1 —
# the surface is clean and the flip is safe.
#
# Set `CYRIUS_TYPE_CHECK=0` to opt OUT. Any other value
# (or env unset) keeps the check ON. The check is cheap
# (~O(args) per call site), wire-compatible across the
# v5.10.x line, and produces actionable warnings only on
# Str → cstring shape mismatches with hint catalog.
var _type_check_env_resolved = 0;
var _type_check_enabled = 1;
fn _TYPE_CHECK_ENABLED(): i64 {
    if (_type_check_env_resolved == 1) { return _type_check_enabled; }
    var v = _read_env("CYRIUS_TYPE_CHECK");
    if (v != 0) {
        if (load8(v) == 48) { _type_check_enabled = 0; }
        if (load8(v) == 49) { _type_check_enabled = 1; }
    }
    _type_check_env_resolved = 1;
    return _type_check_enabled;
}

# v5.10.25 — Phase 3 generalize retired the hardcoded
# {_PRINTLN_NOFF, _PRINTLN_STR_NOFF, _PRINTLN_INT_NOFF,
# _STRLEN_NOFF, _STR_LEN_NOFF} byte-by-byte name lookups.
# Replaced by registry-based dispatch populated at REGFN time
# from `_str` / `_int` / `_cstr` suffixes on sibling fns.
# See `_OVERLOAD_SUFFIX` + REGFN's auto-register block.

# v6.2.41 — shared call-site arity check (issue 2026-06-23-call-arity-no-check).
# cyrius has no overloading and no default args, so a positional arg-count
# mismatch is never intentional — the canonical free catch a compiler owes, and
# the worst footgun in a no-bounds-checking language (a stale call binds garbage
# / shifts args; tentib M3c shipped a mis-bound kernel that built `OK`). Emitted
# as a non-fatal WARNING (hard-error / --strict-arity escalation is a separate
# later scope). Shared by all three call-emit paths — PARSE_FNCALL's normal +
# inline-replay paths and the `return f(args);` tail-call path — so the
# diagnostic is uniform and covers the common call forms. Carve-outs:
#   - BACKWARD refs only (offset >= 0): a forward-declared callee has offset -1
#     and pc not yet known → checking would 556-false-positive building main.cyr.
#   - VARIADICS `fn f(a, ...)` (GFVA==1) take a flexible tail.
#   - `syscall` never reaches here (own path); fncallN are fixed-arity.
#   - Variant constructors register their real arity (parse_types.cyr), so they
#     validate here rather than needing an exemption.
# NOT yet covered (documented gap for the hard-error escalation): struct-return-
# by-value assignment (hidden retptr arg0) and `return (a, b)` multi-return.
# `need_off`: 1 = require the backward-ref offset gate (normal + tail-call paths,
# where a forward-ref callee has offset -1 and pc=0 → must skip). 0 = skip the
# gate (inline-replay path: the callee is provably backward — inlining requires
# its body — and pc is reliable there; the gate would otherwise wrongly skip an
# inlined-only fn that was DCE'd to no standalone body, e.g. a small backend
# helper, which still has offset -1 despite being defined).
fn _CHECK_ARITY(S, line, noff, fi, argc, need_off): i64 {
    if (need_off == 1) { if (L64(_fnt_offsets + fi * 8) < 0) { return 0; } }
    if (GFVA(S, fi) != 0) { return 0; }
    var pc = L64(_fnt_params + fi * 8);
    if (argc == pc) { return 0; }
    # v6.5.1 — ERROR, not warning. A call with the wrong argument count cannot
    # produce correct code: the surplus parameter is bound to whatever happens to
    # be in the register or stack slot. This was a *warning* for its entire life and
    # cyrius emitted a binary anyway, which is how `bayan_json_v_parse(someStr)`
    # returned 0 for every input right across the ecosystem with no outward sign but
    # one easily-missed line in build output. Verified safe to escalate: the whole
    # repo — 253 .tcyr, all 7 main forks, programs/ — produces ZERO of these.
    #
    # Deliberately does NOT set `_panic`: an arity mismatch is not a token-stream
    # desync, so the parse continues normally and ONE compile reports EVERY bad call
    # site (the v6.4.62 multi-error contract). `_had_error` alone withholds the binary.
    syscall(SYS_WRITE, 2, "error:", 6);
    FM_LOOKUP(S, line);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' expects ", 10);
    PRNUM(pc);
    syscall(SYS_WRITE, 2, " argument", 9);
    if (pc != 1) { syscall(SYS_WRITE, 2, "s", 1); }
    syscall(SYS_WRITE, 2, ", got ", 6);
    PRNUM(argc);
    syscall(SYS_WRITE, 2, "\n", 1);
    _had_error = 1;
    return 0;
}

# v6.3.36 (issue [5]) — if callee `fi` declares param `argc` as a plain struct >8 B
# (bit set in its _fnt_structmask) AND the current arg is a bare struct-typed local
# identifier (`foo(s)`, next token `,` or `)`), push the local's ADDRESS instead of
# its first-8-bytes value: the callee derefs a >8-byte struct param as a pointer
# (v6.3.16 lf_is_ptr), so a value would be dereffed-as-address → SIGSEGV. Returns 1
# when handled (IDENT consumed); 0 leaves the cursor untouched for the normal PCMPE
# value push. The CALLEE-mask gate is the reliable discriminator — cyrius tags both
# inline structs and struct-handles (Str, str_new_a results) with SLTYPE=-sid and
# reuses the -1 slot sentinel for freed block locals, so no arg-side heuristic works;
# the callee's declared param type does. Str/Result/Option/Tagged/scalar params keep
# their mask bit clear → value-passed (fixes the str_split/toml/vec_push_a regression).
fn _try_push_struct_addr_arg(S, fi, argc): i64 {
    if (fi < 0) { return 0; }
    if (_pm_struct(fi, argc) == 0) { return 0; }   # 6.6.17 (a10)
    if (PEEKT(S) != 2) { return 0; }
    var nx = TOKTYP(S, GTI(S) + 1);
    # ⛔ 6.6.6 — a by-value struct param given a struct-valued CALL (`h(mk(1, 2))`): the callee
    # takes the struct's ADDRESS, so the result needs storage to point at. It used to be pushed
    # as a value — the first word for a rax:rdx return (the callee then dereferenced a field),
    # and for a retptr return a call with no retptr at all (SIGSEGV). Top level has no frame: a
    # retptr callee falls through to PARSE_FNCALL, which refuses it by name; a rax:rdx one is
    # refused here (as first committed it fell through too, and PARSE_FNCALL refuses only the
    # retptr class, so `hy(p2(1, 2))` compiled clean and SIGSEGV'd). CHANGELOG [6.6.6]
    if (nx == 10) { if (GINFN(S) != 1) { return _refuse_toplevel_pair_arg(S); } }
    # 6.6.10 (bite 7 review): an explicit `idp<i32>(4)` too — it fell to the value push (SIGSEGV).
    var o = 0 - 1;
    if (GINFN(S) == 1) { o = _gcall_open(S, GTI(S)); }
    if (o >= 0) {
        # 6.6.12: `take(mk(p).v)` — the argument is a FIELD of the result, taken like `take(b.v)`.
        if (_call_dotted(S, GTI(S)) == 1) { return _push_struct_expr_arg(S, fi, argc); }
        if (_ret_agg_class(S, _gen_resolve_call(S, GTI(S))) == 0) { return 0; }   # 6.6.10: the instance's class
        if (_call_is_whole_arg(S, o - 1) == 0) { return 0; }
        EFLADDR(S, _struct_call_into_temp(S));
        EPUSHR(S);
        return 1;
    }
    # 6.6.6 (bite 14 review): any other expression — a method call or an operator returning the
    # struct takes its temp's address; everything else is pushed as its value. CHANGELOG [6.6.6]
    if (nx != 31) { if (nx != 11) { return _push_struct_expr_arg(S, fi, argc); } }
    var li = 0 - 1;
    if (GINFN(S) == 1) { li = FINDLOCAL(S, PEEKV(S)); }
    if (li < 0) { return _push_struct_addr_global(S); }
    var lt = GLTYPE(S, li);
    if (lt >= 0) { return 0; }          # must be a struct-typed local (SLTYPE = -sid)
    # v6.4.31: on SysV/aarch64 a SIMD local is register-passed (XMM/V) — never
    # address-passed — so reject it here. On Win64 PE it IS address-passed (MS
    # x64 by-pointer ABI), so let it flow through: push &local as the pointer.
    # ⛔ 6.6.5 — POINTER-MODE vs INLINE. This pushed `&slot` unconditionally, which is right
    # for an inline stack struct (the slot IS the struct) and WRONG for a pointer-mode local
    # (the slot HOLDS the struct's address): the callee then deref'd a pointer-to-pointer and
    # read the address itself as field 0. Measured on 6.6.4, silent and not a crash —
    # `var b: HB = alloc(24); b.a = 10; ...; f(0, b)` printed 140545185808389 where 42 is
    # right. Same discrimination `_resolve_field_base_addr` and the method-`self` push use:
    # the -1 slot-marker predecessor plus the <=8 B single-slot rule.
    # ⚠ NOT for SIMD. A value-form SIMD local is always inline, and on PE it is address-passed
    # by the MS x64 by-pointer ABI; its SLTYPE lives in the descriptor band (<= -2048) where
    # `STRUCTSZ` has no entry, so it must skip the test entirely rather than answer it wrong.
    # CHANGELOG [6.6.5]
    var _sa_ptr = 0;
    if (_is_simd_any(S, lt) == 1) { if (_TARGET_PE == 0) { return 0; } }
    else { _sa_ptr = _local_struct_is_ptr(S, li, lt); }
    if (_sa_ptr == 1) { EFLLOAD(S, li); } else { EFLADDR(S, li); }
    EPUSHR(S);
    STI(S, GTI(S) + 1);                 # consume IDENT
    return 1;
}

# 6.6.5 — the GLOBAL arm of the by-value struct argument. The callee's structmask says this
# parameter is ADDRESS-passed, and there was no global branch at all: a global struct argument
# was pushed BY VALUE (its first 8 bytes), so the callee deref'd a field as a pointer and
# SIGSEGV'd — `take(G)` for a top-level `var G = P { 11, 22 };` crashed where the identical
# local worked. `_var_ptrmode` is the recorded layout: 2 = inline (push its address), 1 = the
# slot holds the address (push the slot). 0 means this global is not a recorded aggregate, so
# leave it to the ordinary value push rather than guessing from GVTYPE, whose positive range is
# shared with scalar widths. CHANGELOG [6.6.5]
fn _push_struct_addr_global(S): i64 {
    var gvi = FINDVAR(S, PEEKV(S));
    if (gvi < 0) { return 0; }
    var gpm = GVPM(S, gvi);
    if (gpm == 0) { return 0; }
    if (gpm == 1) { EVLOAD(S, gvi); } else { EVADDR(S, gvi); }
    EPUSHR(S);
    STI(S, GTI(S) + 1);                 # consume IDENT
    return 1;
}

# ⛔ 6.6.5 — is this struct-typed local POINTER-mode (its slot holds the struct's address) or
# INLINE (the slot IS the struct)? ONE reader, and it READS THE RECORDED BIT.
#
# This fn shipped earlier in 6.6.5 carrying the historical GUESS, which is quoted below so the
# next reader can recognise it rather than reinvent it:
#
#     if (li > 0) { if (L64(S + 0x5D9D000 + (li - 1) * 8) == 0 - 1) { is_ptr = 0; } }
#     if (_TARGET_CX == 0) { if (sid > 0) { if (STRUCTSZ(S, sid - 1) <= 8) { is_ptr = 0; } } }
#
# "the slot below is named -1" is NOT a discriminator for inline-ness. SCOPE_POP writes -1 over
# every local of a block that has closed (util.cyr), and callptr / bitset / SIMD-reserve /
# closure-env temporaries are registered -1 by construction — so a POINTER-mode struct local
# declared after any of those was read as inline and its fields came off the frame. Wrong since
# 5.8.17, silent, and measured in a shipped consumer (stiva's fleet.cyr let an undersized node
# pass its memory constraint). The `<= 8 B` half was the ABI policy stated at the wrong end: cx
# was excluded from it, so on cx two single-field struct locals aliased each other.
#
# Registration now records the answer (SLAGG / GLAGG, util.cyr), so every consumer — field
# load/store, method self, by-value argument passing, copy-init, copy-assign and the regalloc
# picker's aggregate span — asks THIS fn and they cannot disagree. CHANGELOG [6.6.5]
fn _local_struct_is_ptr(S, li, lt): i64 {
    if (GLAGG(S, li) == 1) { return 0; }
    return 1;
}

# ⛔ 6.6.6 — A BY-VALUE STRUCT PARAMETER OVER 8 BYTES IS ADDRESS-PASSED, so its slot holds a
# POINTER to the caller's struct (`_param_wants_struct_ptr` sets the callee's structmask and the
# caller pushes `&local`). Field access already went the extra indirection
# (`_resolve_field_base_addr`); the COPY and RETURN paths did not, and every one of them was
# silent or fatal. Measured at 6.6.5: `q = r` stored r's first word OVER the pointer and the next
# `q.z` SIGSEGV'd; `r = q` copied the pointer into r's field 0; `return q;` from a 9-16 B fn
# loaded the ADDRESS as the rax:rdx pair and from a >16 B fn byte-copied the pointer word.
#
# ⭐ `li < _cur_fn_pslots` IS the discriminator, and it has to be, because the OTHER pointer-mode
# struct local — `var a = str_from(x)`, a heap handle — looks identical in every recorded field.
# `a = b` between two of those must stay a POINTER REBIND (that is the Str convention the whole
# stdlib is built on), while `q = r` on a parameter must copy through. Nothing but "is it a
# parameter" separates them. CHANGELOG [6.6.6]
fn _local_is_sptr_param(S, li): i64 {
    if (li < 0) { return 0; }
    if (li >= _cur_fn_pslots) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    if (GLAGG(S, li) != 0) { return 0; }
    var lt = GLTYPE(S, li);
    if (lt >= 0) { return 0; }
    if (lt <= 0 - 2048) { return 0; }
    var sid = 0 - lt;
    if (STRUCTSZ(S, sid - 1) <= 8) { return 0; }
    # ⛔ `Str` / `Result` / `Option` / `Tagged` are 16 B structs BY NAME whose slot holds a HEAP
    # HANDLE — `_param_wants_struct_ptr` excludes them, so they are value-passed and `a = b`
    # between two of them is a pointer rebind the whole stdlib depends on. Asked through the
    # SAME classifier that built the callee's structmask, on the recorded sid's name, so the two
    # cannot disagree about which parameters are address-passed.
    if (_classify_param_type(S, L64(S + 0x1A6018 + (sid - 1) * 8)) != 0) { return 0; }
    return 1;
}

# 6.6.6 — materialise an address-passed struct parameter as an INLINE frame aggregate, so the
# `return` paths (which address a local's slots directly) read the struct and not the pointer.
# Returns the temp's field-0 slot. CHANGELOG [6.6.6]
# ⛔ 6.6.17 (a1) — the local a `return x;` from a by-value struct fn reads, made INLINE. Both
# return arms address the local's SLOTS (the >16 B byte copy, the 9-16 B rax:rdx load), so a slot
# that HOLDS the struct's address handed back the pointer: an address-passed parameter (above) and
# a HANDLE — a pointer-mode local (`var p: Pt = alloc(16); .. return p;`), which 6.6.16 C2 made
# copy on `=` but not on `return` (the caller's `q.x` read a heap address, on every backend).
# Either is copied through its address into an inline temp. A struct of 8 B or less is held by
# value, and `Str` / `Result` / `Option` / `Tagged` slots are handles by convention
# (`_agc_plain_big`): both untouched. CHANGELOG [6.6.17]
fn _ret_local_inline(S, li): i64 {
    if (_local_is_sptr_param(S, li) == 1) { return _sptr_param_temp(S, li, _cur_fn_ret_sid); }
    if (GLAGG(S, li) != 0) { return li; }
    if (_agc_plain_big(S, GLTYPE(S, li)) == 0) { return li; }
    return _sptr_param_temp(S, li, _cur_fn_ret_sid);
}
# ⛔ 6.6.17 (a1 review) — `return p;` from a fn returning a struct of 8 B or less, where `p: *T` is
# a pointer to it. That class returns the struct's VALUE in rax (the scalar path below), and a
# `*T` slot holds an address, so the caller's `x.v` read the address (x86, qemu-aarch64, wine,
# cx alike); the 9-16 B and retptr classes already went through `_ret_local_inline`. The pointee
# is copied byte-exact into an inline temp (no read past a 3/5/6/7-byte struct) and its slot is
# the value. Consumes `IDENT ;` and jumps to the epilogue; 0 leaves the cursor alone.
fn _ret_small_ptrp(S): i64 {
    if (_cur_fn_ret_sid <= 0) { return 0; }
    if (_cur_fn_ret_stash > 0) { return 0; }
    if (_cur_fn_ret_pair == 1) { return 0; }
    if (STRUCTSZ(S, _cur_fn_ret_sid - 1) > 8) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    if (PEEKT(S) != 2) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 5) { return 0; }
    var li = FINDLOCAL(S, PEEKV(S));
    if (li < 0) { return 0; }
    if (_is_ptr_param(S, li) == 0) { return 0; }
    if (GLTYPE(S, li) != 0 - _cur_fn_ret_sid) { return 0; }
    STI(S, GTI(S) + 2);                   # IDENT ;
    var t = _sptr_param_temp(S, li, _cur_fn_ret_sid);
    EFLLOAD(S, t);
    var rp = EJMP0(S);
    vec_push(rp_vec, rp);
    return 1;
}
fn _sptr_param_temp(S, li, sid): i64 {
    var t = _agg_temp(S, sid);
    _agc_copy_bytes(S, t, 0 - 1, _AGC_DREF(li), 0 - 1, STRUCTSZ(S, sid - 1));
    return t;
}

# ⛔ 6.6.16 (C7) — A PARAMETER ANNOTATED WITH A PLAIN STRUCT IS A VALUE, AT EVERY WIDTH. Over 8 B
# the caller passes the struct's ADDRESS (the ABI above, unchanged), and nothing ever made the copy
# "by value" promises: `fn bump(p: P3) { p.x = p.x + 1; }` wrote the CALLER's struct — a named
# local, a global, a pointer-mode local's heap object, a forwarded parameter, a typed `self: T`
# receiver, a generic instance, a call through `fncall1(&bump, &p)`, and at top level a field
# (`take(BX.v)`). Only a field argument inside a fn was copied (6.6.12, caller-side, so not at top
# level). The copy is made HERE, in the callee's prologue — one site for every caller, fn pointers
# included, built from frontend emitters every backend has: after `_stkp_flush` has homed every
# parameter slot (a Win64 5th+ / SysV 7th+ pointer arrives on the stack) and before the body. Each
# such parameter's struct is copied into an inline frame aggregate (`_sptr_param_temp`), which
# takes the parameter's NAME at the parameter's depth (so a body `var p` is a duplicate exactly
# as before); the pointer slot is renamed -1. From there it is an ordinary inline local: field
# access, `q = r`, `return q`, `&q`, operators and closure captures take their inline paths.
# A `p: *T` parameter is a pointer and is never copied (`_is_ptr_param`); a `#naked` fn has no
# frame; a coroutine impl is re-entered on every resume (and an `async fn` refuses such a
# parameter, `_refuse_async_struct_param`). CHANGELOG [6.6.16]
fn _sptr_params_localize(S): i64 {
    if (_cur_fn_naked != 0) { return 0; }
    if (_pending_coro != 0) { return 0; }
    var li = 0;
    while (li < _cur_fn_pslots) {
        if (_local_is_sptr_param(S, li) == 1) {
            if (_is_ptr_param(S, li) == 0) { _sptr_param_localize1(S, li); }
        }
        li = li + 1;
    }
    return 0;
}
fn _sptr_param_localize1(S, li): i64 {
    var d = GSDEP(S);
    SSDEP(S, 0);
    var t = _sptr_param_temp(S, li, 0 - GLTYPE(S, li));
    SSDEP(S, d);
    S64(S + 0x5D9D000 + t * 8, L64(S + 0x5D9D000 + li * 8));
    SSLICE_W(S, t, 0);
    S64(S + 0x5D9D000 + li * 8, 0 - 1);
    return 0;
}

# ⭐ 6.6.5 — PARSE_FNCALL's `: Str` param auto-coercion, EXTRACTED so the method-call path
# (parse_decl.cyr) uses the same code rather than a second copy that drifts. A string
# literal landing in a param the callee annotated `: Str` is wrapped in `str_from(...)`;
# without the wrap the callee receives a raw cstr pointer and every Str accessor reads the
# wrong shape. Measured on 6.6.4 AND on the first cut of this bite: `h.slen("abcde")`
# returned 0 where the identical free fn `free_slen(0, "abcde")` returned 5 — a SILENT
# wrong value on the very argument loop this release rewrote. Returns 1 when handled (the
# literal is consumed and its Str pushed); 0 leaves the cursor untouched. CHANGELOG [6.6.5]
fn _try_push_str_literal_arg(S, fi, argc): i64 {
    if (fi < 0) { return 0; }
    if (_pm_str(fi, argc) == 0) { return 0; }   # 6.6.17 (a10)
    if (PEEKT(S) != 30) { return 0; }
    var sf_fi = FINDFN(S, _STR_FROM_NOFF(S));
    PCMPE(S);
    EPUSHR(S);
    ECALLPOPS(S, 1);
    if (sf_fi >= 0) {
        var sfoff = L64(_fnt_offsets + sf_fi * 8);
        if (sfoff >= 0) { ECALLTO(S, sfoff); }
        else { ECALLFIX(S, sf_fi); }
    }
    ECALLCLEAN(S, 1);
    EPUSHR(S);
    return 1;
}

# ⭐ 6.6.5 — PARSE_FNCALL'S `: Str` WRAP CRITERION, ASKED OF A CALL WITHOUT PARSING IT.
#
# The `return f(args);` tail path emits its own epilogue + `jmp` and never enters
# PARSE_FNCALL, so anything PARSE_FNCALL does to an ARGUMENT must be replicated there or
# diverted back. The divert is the cheap, safe half — but only if its predicate is EXACTLY the
# helper's. `_try_push_str_literal_arg` wraps an argument iff (a) that argument's FIRST token
# is a string literal and (b) the callee's `_fnt_strmask` bit for that argument's POSITION is
# set. This answers the same question over the raw token stream, so the divert cannot fire
# where the wrap would not, and cannot fail to fire where it would.
#
# Depth counts all four bracket kinds — ( ) [ ] { } — for the same reason `_CALL_ARGC_PEEK`
# does: a nested call, an index or a struct initializer must not leak its commas into this
# call's argument numbering, or the mask bit is read at the wrong position.
#
# ⚠ Both looser approximations were written, shipped into a review round and MEASURED wrong:
# "a literal anywhere in the parens" cost a self-recursive tail call its TCO and turned a
# correct program into a SIGSEGV; "a literal at depth 1, callee has SOME Str param" still
# diverted `f(x, "lit")` where the Str param is argument 0. Over-covering a TCO guard is not
# the safe direction. `ti_open` is the index of the call's `(`. CHANGELOG [6.6.5]
fn _tc_str_literal_arg(S, ti_open, fi): i64 {
    if (fi < 0) { return 0; }
    var mask = L64(_fnt_strmask + fi * 8);
    if (mask == 0) { if (_pm_row_any(fi, 2) == 0) { return 0; } }   # 6.6.17 (a10)
    var i = ti_open + 1;
    var depth = 0;
    var pos = 0;
    var first = 1;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0; }                                  # EOF — truncated input
        if (t == 11) { if (depth == 0) { return 0; } depth = depth - 1; }
        if (t == 29) { depth = depth - 1; }
        if (t == 14) { depth = depth - 1; }
        if (depth == 0) {
            if (t == 31) { pos = pos + 1; first = 1; }
            else {
                if (first == 1) { if (t == 30) { if (_pm_str(fi, pos) != 0) { return 1; } } }
                first = 0;
            }
        }
        if (t == 10) { depth = depth + 1; }
        if (t == 28) { depth = depth + 1; }
        if (t == 13) { depth = depth + 1; }
        i = i + 1;
    }
    return 0;
}

# ⭐ 6.6.13 (I11) — THE Str -> `: cstring` WARNING. It typed only an argument whose FIRST token
# was a `Str` local, on PARSE_FNCALL's path alone: a call result (`f(o, str_from("k"))`), a
# global, a `: Str` field, a tail call and a method call all compiled silent, `s.data` was
# reported as the Str itself, and the hint recommended `str_data(x)` — which a `: cstring`
# param reads past the Str's length (a slice borrows its parent's bytes), so taking the hint
# turned a warned bug into a silent one. Now ONE read-only helper serves every argument loop
# (PARSE_FNCALL, `_call_arg_one` — method calls and the struct-valued own calls — and
# PARSE_RETURN's tail loop) and types the argument only when it is a single primary that ends
# it: `x`, `f(..)` (the callee's `: Struct` return) or `x.f` (the field's declared type).
# Anything else (`s + 8`, `s.len`, `load64(p)`, an index, a chain) is left alone. Warning text
# only: nothing here moves the cursor or emits code, and the inferred-global record it reads
# (GVDSID) is diagnostic-only, so every binary is byte-identical. CHANGELOG [6.6.13]

# The `)` matching the `(` at token `ti`, or -1 when the input ends first. Read-only.
fn _tok_close_paren(S, ti): i64 {
    var depth = 0;
    var i = ti;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0 - 1; }
        if (t == 10) { depth = depth + 1; }
        if (t == 11) {
            depth = depth - 1;
            if (depth == 0) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# 1 when token `ti` ends an argument (`,` or `)`).
fn _tok_ends_arg(S, ti): i64 {
    var t = TOKTYP(S, ti);
    if (t == 31) { return 1; }
    if (t == 11) { return 1; }
    return 0;
}

# 1 when the name at offset `noff` is exactly the `n`-byte text `lit`. (cycc does not include
# lib/string.cyr, so this is the compare.)
fn _noff_is(S, noff, lit, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(S + 0xEC00000 + noff + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    if (load8(S + 0xEC00000 + noff + n) != 0) { return 0; }
    return 1;
}

# `var g = f(..);` at registration: f's name offset + 1 for the DIAGNOSTIC table (GVDSID), when
# the declaration is untyped and its initializer is exactly one call; else 0. Always written, so
# a redeclaration folded onto the slot clears a stale record. f's return is resolved when the
# check runs, so an f defined after g counts too.
fn _gv_diag_sid(S, gvi, sti, typed): i64 {
    var cn = 0;
    if (typed == 0) { cn = _gv_init_call_sid(S, sti); }
    SVDSID(S, gvi, cn);
    return 0;
}
fn _gv_init_call_sid(S, sti): i64 {
    if (TOKTYP(S, sti + 2) != 4) { return 0; }
    var cn = _gv_rhs_call_sid(S, sti + 3);
    return cn;
}
# The same record from the initializer's first token `ri`: `f(..);` gives f's name offset + 1,
# anything else 0. PARSE_VAR's global arm (a `var` after the first top-level statement, which
# never reaches PARSE_GVAR_REG) writes it from here.
fn _gv_rhs_call_sid(S, ri): i64 {
    if (TOKTYP(S, ri) != 2) { return 0; }
    if (TOKTYP(S, ri + 1) != 10) { return 0; }
    var e = _tok_close_paren(S, ri + 1);
    if (e < 0) { return 0; }
    if (TOKTYP(S, e + 1) != 5) { return 0; }
    return TOKVAL(S, ri) + 1;
}

# The struct id a NAMED value carries, 0 when untyped. Shared by the I11 Str -> `: cstring`
# warning, the overload dispatcher (both through `_str_arg_kind`) and `_recv_sid`. A local decides
# by itself (`0 - GLTYPE`; an untyped local shadowing a `Str` global is 0, not the global's
# type). A global: its positive GVTYPE, but only when GVPM marks it a struct — GVTYPE's positive
# range is shared with scalar widths, so an `i32` global's 4 must not read as struct id 4. Else
# an inferred global's initializer return (GVDSID: READ here, never written into GVTYPE, which
# would change codegen). Comparing a global against the LOCAL encoding `0 - sid` — what the I11
# check did before 6.6.13 and the dispatcher before 6.6.16 — matches no Str global at all.
fn _diag_name_sid(S, noff): i64 {
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) {
            var lt = GLTYPE(S, li);
            if (lt < 0) { if (lt > 0 - 2048) { return 0 - lt; } }
            return 0;
        }
    }
    var g = _glob_name_sid(S, noff);
    return g;
}
# `_diag_name_sid`'s global half, alone: the pair scans (`_tok_name_sid`) type a global receiver
# exactly as `_recv_sid` does, with no local table to consult. CHANGELOG [6.6.16]
fn _glob_name_sid(S, noff): i64 {
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    var gt = GVTYPE(S, vi);
    if (gt > 0) { if (GVPM(S, vi) != 0) { return gt; } }
    var cn = GVDSID(S, vi);
    if (cn <= 0) { return 0; }
    var cfi = FINDFN(S, cn - 1);
    if (cfi < 0) { return 0; }
    var r = GFRS(S, cfi);
    if (r < 0) { r = 0; }
    return r;
}

# The struct id of a single NAME read as a value, in PARSE_FACTOR's order: a local decides by
# itself, then — inside a capturing closure — a captured enclosing local decides by the type its
# snapshot recorded, then a global (`_diag_name_sid`). The overload dispatcher routes on this, so
# a cstr local, param or CAPTURE named like a Str global must read 0 here: measured on the planning
# prototype, `var s = "x"; var c = |k| show(s) ..;` beside a `var s: Str` global reached `show_str`,
# which read the cstr's bytes as a {data, len} header. CHANGELOG [6.6.16]
fn _arg_name_sid(S, noff): i64 {
    if (GINFN(S) == 1) {
        if (FINDLOCAL(S, noff) < 0) {
            var esl = _cl_cap_esl(S, noff);
            if (esl >= 0) {
                var t = _cl_snap_type(esl);
                if (t < 0) { if (t > 0 - 2048) { return 0 - t; } }
                return 0;
            }
        }
    }
    var r = _diag_name_sid(S, noff);
    return r;
}
# The enclosing slot a name reads inside a capturing closure body (PARSE_FACTOR's capture rung),
# or -1 when the name is not a capture there.
fn _cl_cap_esl(S, noff): i64 {
    if (_cl_capturing != 1) { return 0 - 1; }
    if (_cl_env_lidx < 0) { return 0 - 1; }
    var esl = _cl_snap_find(S, noff);
    if (esl < 0) { return 0 - 1; }
    if (_cl_cap_find(esl) < 0) { return 0 - 1; }
    return esl;
}

var _sca_shape = 0;   # how the argument's head is written: 0 `x`, 1 `f(..)`, 2 `g<..>(..)`
var _sca_di = 0;      # the `.` of the LAST `.f` / `.m(..)` step after the head, 0 when none
var _sca_d0 = 0;      # the `.` of the FIRST step (6.6.17: nested fields `a.b.name` are several)
# What the hint wraps in str_cstr(..): 0 `..`, 1 the head as written (`x.data` -> x), 2 the
# argument as written, 3 the IDENT inside `str_data(x)`.
var _sca_op = 0;
# What the argument at the cursor hands a `: cstring` param: 1 a Str, 2 a Str's data pointer
# (`x.data`, `x.data()`, `str_data(..)`), 0 not known. Only a head (`x`, `f(..)`, `g<..>(..)`,
# a generic `: T` by T's binding) followed by nested STRUCT fields and then at most one `.f` /
# `.m(..)` step, together ENDING the argument, is typed (6.6.17: `a.b.name`): `x.m().n()`,
# a step into a Str field, `s + 8` and `load64(p)` are 0.
# A pure peek (it writes only `_sca_shape` / `_sca_di` / `_sca_d0` / `_sca_op`, which the warning recomputes),
# and it does not depend on CYRIUS_TYPE_CHECK: PARSE_FNCALL's overload dispatcher routes
# `base(x, ..)` to `base_str` exactly when this answers 1 for the FIRST argument, so a first
# argument the warning would call "Str-typed" never reaches a base that has an arity-compatible
# `_str` sibling — the call is routed instead. Each piece is typed the way codegen reads it: `x`
# as PARSE_FACTOR does (`_arg_name_sid`), a call by its callee's declared return, the receiver of
# `x.f` / `x.m(..)` as PARSE_FIELD_LOAD does (`_recv_sid`), a method by `<Struct>_<m>`'s return.
# A call RESULT is typed by its declared return, never by its receiver or its head: the first
# 6.6.16 cut dropped the method shape, so `println(s.cat(t))` — routed before by `s`'s type,
# which is right only by luck (`s.len()` went to `_str` the same way) — printed pointer bytes.
# CHANGELOG [6.6.16]
fn _str_arg_kind(S, ssid): i64 {
    var ti = GTI(S);
    _sca_shape = 0;
    _sca_di = 0;
    _sca_d0 = 0;
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (_tok_ends_arg(S, ti + 1) == 1) {
        _sca_op = 2;
        if (_arg_name_sid(S, TOKVAL(S, ti)) == ssid) { return 1; }
        return 0;
    }
    var o = _gcall_open(S, ti);
    if (o >= 0) {
        var r = _str_call_kind(S, ti, o, ssid);
        return r;
    }
    if (TOKTYP(S, ti + 1) != 41) { return 0; }
    var bsid = _recv_sid(S, TOKVAL(S, ti));
    var k = _str_step_kind(S, ti + 1, bsid, ssid);
    return k;
}
# `f(..)` / `g<..>(..)` at token `ti`, its `(` at `o`: a Str when the callee is declared `: Str`
# (for a generic, its template's declared return: a `: T` return is no struct id there, so
# `id<Str>(s)` is not typed), a data pointer when it is `str_data`; followed by one `.f` /
# `.m(..)`, that step on the struct the callee returns.
fn _str_call_kind(S, ti, o, ssid): i64 {
    _sca_shape = 1;
    if (o != ti + 1) { _sca_shape = 2; }
    _sca_op = 0;
    var e = _tok_close_paren(S, o);
    if (e < 0) { return 0; }
    var cfi = FINDFN(S, TOKVAL(S, ti));
    var rs = 0;
    if (cfi >= 0) { rs = GFRS(S, cfi); }
    if (rs <= 0) { if (cfi >= 0) { rs = _gen_ret_bound(S, cfi, ti, o); } }   # 6.6.17: `: T`
    if (_tok_ends_arg(S, e + 1) == 0) {
        if (TOKTYP(S, e + 1) != 41) { return 0; }
        var k = _str_step_kind(S, e + 1, rs, ssid);
        return k;
    }
    if (cfi < 0) { return 0; }
    if (rs == ssid) {
        _sca_op = 2;
        return 1;
    }
    if (_sca_shape != 1) { return 0; }
    if (_noff_is(S, TOKVAL(S, ti), "str_data", 8) == 0) { return 0; }
    if (TOKTYP(S, ti + 2) == 2) { if (e == ti + 3) { _sca_op = 3; } }
    return 2;
}
# The one step `.f` / `.m(..)` whose `.` is at token `di`, on a receiver of struct id `rsid`
# (0 untyped), when the step ends the argument. A method is a Str when `<Struct>_<m>` (as
# PARSE_FIELD_LOAD builds it) is declared `: Str` — `s.cat(t)` is, `s.len()` / `s.data()` are
# not; a field when it is declared `: Str`; `.data` of a Str is its data pointer.
fn _str_step_kind(S, di, rsid, ssid): i64 {
    if (TOKTYP(S, di + 1) != 2) { return 0; }
    if (rsid <= 0) { return 0; }
    _sca_di = di;
    if (_sca_d0 == 0) { _sca_d0 = di; }
    if (TOKTYP(S, di + 2) == 10) {
        _sca_op = 2;
        var e = _tok_close_paren(S, di + 2);
        if (e < 0) { return 0; }
        if (_tok_ends_arg(S, e + 1) == 0) { return 0; }
        if (_str_data_call(S, di, e, rsid, ssid) == 1) { return 2; }   # 6.6.17: `x.data()`
        var mf = FINDFN(S, BUILD_METHOD_NAME(S, rsid - 1, TOKVAL(S, di + 1)));
        if (mf < 0) { return 0; }
        if (GFRS(S, mf) == ssid) { return 1; }
        return 0;
    }
    if (_tok_ends_arg(S, di + 2) == 0) {
        var nk = _str_nested_step(S, di, rsid, ssid);   # 6.6.17: `a.b.name`
        return nk;
    }
    if (rsid == ssid) {
        _sca_op = 1;
        if (_noff_is(S, TOKVAL(S, di + 1), "data", 4) == 1) { return 2; }
        return 0;
    }
    _sca_op = 2;
    var fx = FINDFIELD(S, rsid - 1, TOKVAL(S, di + 1));
    if (fx < 0) { return 0; }
    if (GETFTYPE(S, rsid - 1, fx) == ssid) { return 1; }
    return 0;
}

# 6.6.17 — `a.b.name`: a field that does not end the argument continues the chain when it is a
# nested STRUCT and the next step is a field, as PARSE_FIELD_LOAD walks it (`_rlf_more`). A
# `: Str` field is never stepped INTO (it is a pointer slot, not an inline struct), and a
# `.m(..)` after a nested field is not parsed at all, so neither is typed.
fn _str_nested_step(S, di, rsid, ssid): i64 {
    if (TOKTYP(S, di + 2) != 41) { return 0; }
    if (TOKTYP(S, di + 3) != 2) { return 0; }
    if (TOKTYP(S, di + 4) == 10) { return 0; }
    if (rsid == ssid) { return 0; }
    var fx = FINDFIELD(S, rsid - 1, TOKVAL(S, di + 1));
    if (fx < 0) { return 0; }
    var ft = GETFTYPE(S, rsid - 1, fx);
    if (ft <= 0) { return 0; }
    if (ft == ssid) { return 0; }
    var k = _str_step_kind(S, di + 2, ft, ssid);
    return k;
}
# 6.6.17 — `x.data()` on a Str is its data pointer, the method spelling of `x.data` and
# `str_data(x)` (I11 named those two and was silent on this one). 1 when the step at `di`, its
# `)` at `e`, is exactly that.
fn _str_data_call(S, di, e, rsid, ssid): i64 {
    if (rsid != ssid) { return 0; }
    if (e != di + 3) { return 0; }
    if (_noff_is(S, TOKVAL(S, di + 1), "data", 4) == 0) { return 0; }
    _sca_op = 1;
    return 1;
}
# 6.6.17 — what a generic declared `: T` returns at THIS call: the struct T is bound to, by the
# explicit type argument (`g<Str>(..)`) or by the argument the call infers it from (`g(s)`) — the
# binding `_gen_resolve_call` instantiates on. A peek: no instance is minted here. 0 when T is not
# bound to a struct (the call returns a scalar, as before).
fn _gen_ret_bound(S, fi, ti, o): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    var w = _gen_ret_tparam(S, fi);
    if (w < 0) { return 0; }
    var c = 0;
    if (o != ti + 1) { c = _gen_explicit_targ(S, ti, w); }
    else { c = _gen_infer_tp(S, fi, o, w); }
    if (c > 0) { return c; }
    return 0;
}
# Which type parameter (0 / 1) generic `fi` names as its return type, read from its signature
# (`fn g<T>(..): T`), else -1.
fn _gen_ret_tparam(S, fi): i64 {
    var tp = GFTP(S, fi);
    if (tp == 0) { return 0 - 1; }
    var ds = GFDS(S, fi);
    if (ds <= 0) { return 0 - 1; }
    var i = ds;                                  # the fn's name (GFDS = the `fn` token + 1)
    var n = GTCNT(S);
    while (i < n) { if (TOKTYP(S, i) == 10) { break; } i = i + 1; }
    var e = _tok_close_paren(S, i);
    if (e < 0) { return 0 - 1; }
    if (TOKTYP(S, e + 1) != 49) { return 0 - 1; }
    if (TOKTYP(S, e + 2) != 2) { return 0 - 1; }
    var rn = TOKVAL(S, e + 2);
    var t0 = tp & 0xFFFFFFFF;
    var t1 = (tp >> 32) & 0xFFFFFFFF;
    if (t0 != 0) { if (rn == t0 - 1) { return 0; } }
    if (t1 != 0) { if (rn == t1 - 1) { return 1; } }
    return 0 - 1;
}
# The struct named by explicit type argument `w` of the call at `ti` (`g<A>(` / `g<A, B>(`), when
# it is a single name; 0 otherwise (a scalar or a nested generic is not a Str).
fn _gen_explicit_targ(S, ti, w): i64 {
    var a = ti + 2;
    if (w == 1) {
        if (TOKTYP(S, a + 1) != 31) { return 0; }
        a = a + 2;
    }
    if (TOKTYP(S, a) != 2) { return 0; }
    var nt = TOKTYP(S, a + 1);
    if (nt != 20) { if (nt != 31) { return 0; } }
    var sid = FINDSTRUCT(S, TOKVAL(S, a));
    return sid;
}

# The argument as written: the head (`x`, `f(..)`, `g<..>(..)`), then its step (`.f`, `.m(..)`).
fn _sca_print_arg(S): i64 {
    _sca_print_head(S);
    if (_sca_di > 0) {
        var d = _sca_d0;
        while (d < _sca_di) {                     # the nested fields before the last step
            syscall(SYS_WRITE, 2, ".", 1);
            PRSTR(S + 0xEC00000 + TOKVAL(S, d + 1));
            d = d + 2;
        }
        syscall(SYS_WRITE, 2, ".", 1);
        PRSTR(S + 0xEC00000 + TOKVAL(S, _sca_di + 1));
        if (TOKTYP(S, _sca_di + 2) == 10) { _sca_print_call_args(S, _sca_di + 1); }
    }
    return 0;
}
fn _sca_print_head(S): i64 {
    var ti = GTI(S);
    PRSTR(S + 0xEC00000 + TOKVAL(S, ti));
    if (_sca_shape == 1) { _sca_print_call_args(S, ti); }
    if (_sca_shape == 2) { syscall(SYS_WRITE, 2, "<..>(..)", 8); }
    return 0;
}
# A call's argument list as the message shows it: `()`, `(x)` for one bare IDENT, else `(..)`.
fn _sca_print_call_args(S, ti): i64 {
    if (TOKTYP(S, ti + 2) == 11) {
        syscall(SYS_WRITE, 2, "()", 2);
        return 0;
    }
    if (TOKTYP(S, ti + 2) == 2) { if (TOKTYP(S, ti + 3) == 11) {
            syscall(SYS_WRITE, 2, "(", 1);
            PRSTR(S + 0xEC00000 + TOKVAL(S, ti + 2));
            syscall(SYS_WRITE, 2, ")", 1);
            return 0;
        } }
    syscall(SYS_WRITE, 2, "(..)", 4);
    return 0;
}
fn _sca_print_op(S): i64 {
    var ti = GTI(S);
    if (_sca_op == 0) { syscall(SYS_WRITE, 2, "..", 2); }
    if (_sca_op == 1) { _sca_print_head(S); }
    if (_sca_op == 2) { _sca_print_arg(S); }
    if (_sca_op == 3) { PRSTR(S + 0xEC00000 + TOKVAL(S, ti + 2)); }
    return 0;
}

# A Str-taking sibling of callee `fi` at param `argc`: its `<base>_str` overload, else
# `<stem>_str` for a callee named `<stem>_cstr` (bayan's `_by_cstr` / `_by_str` pair) — counted
# only when that sibling's param `argc` is annotated `: Str`. -1 when there is none.
fn _sca_sibling(S, fi, argc): i64 {
    var sib = L64(_fnt_ovstr + fi * 8) - 1;
    if (sib < 0) { sib = _sca_cstr_sibling(S, fi); }
    if (sib < 0) { return 0 - 1; }
    if (_pm_str(sib, argc) == 0) { return 0 - 1; }   # 6.6.17 (a10)
    return sib;
}
fn _sca_cstr_sibling(S, fi): i64 {
    var noff = L64(_fnt_names + fi * 8);
    var nm = S + 0xEC00000 + noff;
    var n = 0;
    while (load8(nm + n) != 0) { n = n + 1; }
    if (n < 6) { return 0 - 1; }
    if (n > 250) { return 0 - 1; }
    if (_noff_is(S, noff + n - 5, "_cstr", 5) == 0) { return 0 - 1; }
    var buf[256];
    var j = 0;
    while (j < n - 4) {
        store8(&buf + j, load8(nm + j));
        j = j + 1;
    }
    store8(&buf + n - 4, 115);
    store8(&buf + n - 3, 116);
    store8(&buf + n - 2, 114);
    var r = _FINDFN_CSTR(S, &buf, n - 1);
    return r;
}

# Warn when the argument at the cursor hands callee `fi`'s `: cstring` param `argc` a Str or a
# Str's data pointer. Read-only: never moves the cursor, never emits code. The hint never says
# `str_data` — that is the bug, not the fix.
fn _check_str_cstring_arg(S, fi, argc, noff): i64 {
    if (fi < 0) { return 0; }
    if (_TYPE_CHECK_ENABLED() != 1) { return 0; }
    if (_pm_cstr(fi, argc) == 0) { return 0; }   # 6.6.17 (a10)
    var ssid = _STR_SID(S);
    if (ssid <= 0) { return 0; }
    var k = _str_arg_kind(S, ssid);
    if (k == 0) { return 0; }
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head(S);
    if (k == 1) { syscall(SYS_WRITE, 2, ": passing Str-typed '", 21); }
    else { syscall(SYS_WRITE, 2, ": passing a Str's data pointer '", 32); }
    _sca_print_arg(S);
    syscall(SYS_WRITE, 2, "' to '", 6);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' which expects a cstring", 25);
    if (k == 1) { syscall(SYS_WRITE, 2, " (a Str is a {data, len} header, not a char*)\n", 46); }
    else { syscall(SYS_WRITE, 2, " (a Str's bytes are not NUL-terminated at its length)\n", 54); }
    _sca_print_hint(S, fi, argc);
    return 0;
}
fn _sca_print_hint(S, fi, argc): i64 {
    syscall(SYS_WRITE, 2, "  hint: ", 8);
    var sib = _sca_sibling(S, fi, argc);
    if (sib >= 0) {
        syscall(SYS_WRITE, 2, "call '", 6);
        PRSTR(S + 0xEC00000 + L64(_fnt_names + sib * 8));
        syscall(SYS_WRITE, 2, "', which takes a Str, or ", 25);
    }
    syscall(SYS_WRITE, 2, "pass str_cstr(", 14);
    _sca_print_op(S);
    syscall(SYS_WRITE, 2, ") for a NUL-terminated copy, or annotate the param `: Str`\n", 59);
    return 0;
}

# ⭐ 6.6.5 — v6.5.3's integer-literal-into-`: cstring` HARD ERROR, extracted from
# PARSE_FNCALL's argument loop so the method-call path runs it too. v6.5.3 escalated this
# from a warning to an error precisely because the alternative is a runtime crash — the
# callee derefs the number as a char*. The method path never had it: measured on 6.6.4 and
# on the first two cuts of this bite, `w.pr(42)` into `fn pr(self, p: cstring)` compiled
# clean and SIGSEGV'd (rc 139), while the identical `free_pr(0, 42)` was refused at compile
# time. `0` stays EXEMPT — it is the idiomatic NULL for a cstring param. Does not move the
# cursor; returns 0 always (the arg is still pushed by the caller's normal path, so ONE
# compile reports EVERY bad site — the v6.4.62 multi-error contract). CHANGELOG [6.6.5]
fn _check_int_lit_cstring_arg(S, fi, argc, noff): i64 {
    if (fi < 0) { return 0; }
    if (_TYPE_CHECK_ENABLED() != 1) { return 0; }
    if (PEEKT(S) != 1) { return 0; }
    if (PEEKV(S) == 0) { return 0; }
    if (_pm_cstr(fi, argc) == 0) { return 0; }   # 6.6.17 (a10)
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": passing integer literal ", 26);
    PRNUM(PEEKV(S));
    syscall(SYS_WRITE, 2, " to '", 5);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' which expects a cstring (a POINTER, not a number)\n", 52);
    syscall(SYS_WRITE, 2, "  hint: the value is a NUMBER — use the _int variant if one exists (e.g. println_int), or fmt_int_buf to render it\n", 117);
    _had_error = 1;
    return 0;
}

# ⭐ 6.6.5 — the v5.10.38 value-form SIMD argument RECORDING, extracted for the same reason.
# A SIMD-class param is NOT pushed with the int args: it is recorded here and loaded into
# XMM/V after ECALLPOPS (`_simd_arg_second_pass`), so int-arg evaluation cannot clobber the
# vector registers. The method-call path had neither half and pushed the vector as an int
# arg, which shifted every LATER argument by one register. Measured on 6.6.4 and on the
# first cut of this bite: `h.vmix(2, v, 3)` returned 927 where the identical free fn
# returned 923 — `j` received the vector's low half. `tbl` is the CALLER's scratch table
# (a local, so a nested call cannot clobber it). Returns the number of XMM slots consumed
# (1 for a 16-byte vector, 2 for 32-byte). CHANGELOG [6.6.5]
fn _simd_arg_record(S, cls, tbl, cnt, pc): i64 {
    if (PEEKT(S) != 2) {
        ERR_MSG(S, "value-form SIMD arg must be a local IDENT (caller-side scratch + addr-eval path not in v5.10.38 scope)", 102);
    }
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);  # consume IDENT
    var lli = FINDLOCAL(S, noff);
    if (lli < 0) {
        ERR_MSG(S, "value-form SIMD arg: IDENT not found as a local", 47);
    }
    var lt = GLTYPE(S, lli);
    _simd_arg_typecheck(S, cls, lt);
    store64(tbl + cnt * 24, lli);
    store64(tbl + cnt * 24 + 8, pc);
    store64(tbl + cnt * 24 + 16, cls);
    if (cls == 2) { return 2; }
    return 1;
}

# ⭐ 6.6.6 — ONE ARGUMENT OF AN OWN-CALL LOOP, run through PARSE_FNCALL's callee-mask gates: a
# value-form vector is RECORDED for the XMM/V second pass (never pushed); anything else is the
# int-class push behind the `: cstring` literal error, the `: Str` literal wrap and the
# struct-address push (which is also how a Win64 vector travels — by pointer, in its int slot).
# `st` is the caller's 3-word state: [int args pushed, vectors recorded, next XMM/V ordinal].
# The method-call loop grew these gates inline in 6.6.5; the two struct-valued `var` receives
# (`var p: S = f(...)`, retptr and rax:rdx) had NONE and pushed a vector as an int, so every
# later int shifted and the callee read a stale XMM0 (SysV/aarch64) or dereferenced the
# vector's first word as its pointer (Win64 page fault). Every own-call argument loop shares
# it — those three, and (via `_owncall_args`) the four PE-only vector-retptr loops, whose own
# copy had the gates but not the arity check. CHANGELOG [6.6.6]
fn _call_arg_one(S, fi, uarg, noff, tbl, st): i64 {
    var cls = _pm_simd(fi, uarg);   # 6.6.17 (a10)
    if (cls > 0) {
        var n = load64(st + 8);
        var o = load64(st + 16);
        store64(st + 16, o + _simd_arg_record(S, cls, tbl, n, o));
        store64(st + 8, n + 1);
        return 0;
    }
    _check_int_lit_cstring_arg(S, fi, uarg, noff);
    _check_str_cstring_arg(S, fi, uarg, noff);   # 6.6.13 I11
    if (_try_push_str_literal_arg(S, fi, uarg) == 0) {
        if (_try_push_struct_addr_arg(S, fi, uarg) == 0) { PCMPE(S); EPUSHR(S); }
    }
    store64(st, load64(st) + 1);
    return 0;
}

# The argument list of an own-call (cursor just past `(`): every argument through
# `_call_arg_one`, then `)`, the arity check PARSE_FNCALL runs, ECALLPOPS of the int args and
# the vector loads. `int0` = int args the caller already pushed (x86's retptr). Returns the
# int-class total, for ECALLCLEAN.
# Also the four WIN64-ONLY own-calls (a 16/32-byte vector returned through a retptr:
# `_try_vector_call_assign`, the `_f2c`/`_f4c` receives, the PE `return f(..)` path). They had a
# loop of their own with the cstring/Str/struct-address gates and NO arity check, so `v = f(3)`
# on a 2-param `f` built clean on PE alone. On PE the simd mask is 0 (a vector param is
# address-passed), so `_call_arg_one` IS that loop's body. CHANGELOG [6.6.6]
fn _owncall_args(S, fi, noff, int0): i64 {
    var tbl: i64[24];
    var st: i64[3];
    store64(&st, int0);
    store64(&st + 8, 0);
    store64(&st + 16, 0);
    var line = GTLINE(S, GTI(S));
    var uarg = 0;
    if (PEEKT(S) != 11) {
        var go = 1;
        while (go == 1) {
            _call_arg_one(S, fi, uarg, noff, &tbl, &st);
            uarg = uarg + 1;
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
            else { go = 0; }
        }
    }
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);                         # consume ')'
    _CHECK_ARITY(S, line, noff, fi, uarg, 1);
    var n = load64(&st);
    ECALLPOPS(S, n);
    _simd_arg_second_pass(S, &tbl, load64(&st + 8));
    return n;
}

# ⭐ 6.6.6 — A STRUCT-VALUED CALL NEEDS SOMEWHERE TO PUT ITS RESULT, WHEREVER IT IS WRITTEN.
# How fn `fi` returns: 2 = a >16 B struct through a hidden retptr (x86/cx: int arg 0; aarch64:
# X8), 1 = a 9-16 B non-Str struct in rax:rdx, 0 = anything else. The same predicate as the
# callee's rough-scan (`_cur_fn_ret_stash` / `_cur_fn_ret_pair`) and PARSE_VAR's asv_try /
# asv_pair, so caller and callee cannot disagree. CHANGELOG [6.6.6]
fn _ret_agg_class(S, fi): i64 {
    if (fi < 0) { return 0; }
    var sid = GFRS(S, fi);
    if (sid <= 0) { return 0; }
    var sz = STRUCTSZ(S, sid - 1);
    if (sz > 16) { return 2; }
    if (sz > 8) { if (sid != _STR_SID(S)) { return 1; } }
    return 0;
}

# An anonymous in-frame destination for struct `sid`: (n-1) fillers, then the slot that
# addresses it (field 0), laid out exactly like a `var p: S` receive. Returns that slot.
fn _agg_temp(S, sid): i64 {
    var sz = STRUCTSZ(S, sid - 1);
    var n = ((sz + 7) & (0 - 8)) / 8;
    var j = 0;
    while (j < n - 1) {
        var f = GFLC(S);
        S64(S + 0x5D9D000 + f * 8, 0 - 1);
        SLDEP(S, f, GSDEP(S));
        SLTYPE(S, f, 0);
        SFLC(S, f + 1);
        j = j + 1;
    }
    var t = GFLC(S);
    S64(S + 0x5D9D000 + t * 8, 0 - 1);
    SLDEP(S, t, GSDEP(S));
    SLAGG(S, t, n);
    SLTYPE(S, t, 0 - sid);
    SFLC(S, t + 1);
    if (t + 1 > _flc_hwm) { _flc_hwm = t + 1; }
    return t;
}

# The call itself, cursor just past `(`: the retptr (x86/cx: pushed as int arg 0, before the user
# args; aarch64: X8, after them), every user arg through the callee gates, the call, and for a
# rax:rdx return the pair store. The result lands in the aggregate whose field-0 slot is `dst`.
# Shared by PARSE_VAR's two receives and every call site below that used to have no destination.
fn _struct_call_emit(S, fi, noff, dst): i64 {
    var cls = _ret_agg_class(S, fi);
    var n0 = 0;
    if (cls == 2) { if (_AARCH64_BACKEND == 0) {
            EFLADDR(S, dst);
            EPUSHR(S);
            n0 = 1;
        } }
    var n = _owncall_args(S, fi, noff, n0);
    if (cls == 2) { if (_AARCH64_BACKEND == 1) { EFLADDR_X8(S, dst); } }
    var tgt = L64(_fnt_offsets + fi * 8);
    if (tgt >= 0) { ECALLTO(S, tgt); }
    else { ECALLFIX(S, fi); }
    ECALLCLEAN(S, n);
    if (cls == 1) { EFLSTORE_STRUCT_INT_PAIR(S, dst); }
    # 6.6.12: a struct result in rax — a <= 8 B struct's bytes (`dst` inline), or a `Str` handle
    # (`dst` pointer-mode, see `_struct_call_into`). Only `_call_field` asks for this class.
    if (cls == 0) { if (GFRS(S, fi) > 0) { EFLSTORE(S, dst); } }
    return 0;
}

# `IDENT ( args )` at the cursor, for a callee `_ret_agg_class` accepts: allocate a temp, emit
# the call into it, return the temp's field-0 slot. CHANGELOG [6.6.6]
fn _struct_call_into_temp(S): i64 {
    _struct_call_into(S, 0);
    return _sci_t;
}
# 6.6.12: `handle` = 1 for a struct returned as a HEAP HANDLE in rax (`Str` — the one class-0
# struct over 8 B): the temp is one POINTER-mode slot that holds it, as `var s = str_from(..)`
# does, not an inline aggregate the handle would be stored into. The slot is left in `_sci_t`.
var _sci_t = 0;
fn _struct_call_into(S, handle): i64 {
    var noff = PEEKV(S);
    var o = _gcall_open(S, GTI(S));          # 6.6.10: also `name<..>(`
    if (o < 0) { o = GTI(S) + 1; }
    var fi = _gen_resolve_call(S, GTI(S));   # 6.6.10: a generic's instance, not its base
    if (fi < 0) { fi = REGFN(S, noff); }
    _gen_own_call_check(S, fi, noff);
    _callee_site_checks_here(S, fi, noff, 0);   # the cursor is on the callee's name
    var t = 0;
    if (handle == 1) { t = _ptr_temp(S, GFRS(S, fi)); }
    else { t = _agg_temp(S, GFRS(S, fi)); }
    STI(S, o + 1);   # consume IDENT [<..>] `(`
    _struct_call_emit(S, fi, noff, t);
    _sci_t = t;
    return 0;
}

# An anonymous POINTER-mode struct slot (the slot holds the struct's address). CHANGELOG [6.6.12]
fn _ptr_temp(S, sid): i64 {
    var t = GFLC(S);
    S64(S + 0x5D9D000 + t * 8, 0 - 1);
    SLDEP(S, t, GSDEP(S));
    SLTYPE(S, t, 0 - sid);
    SFLC(S, t + 1);
    if (t + 1 > _flc_hwm) { _flc_hwm = t + 1; }
    return t;
}

# The token after the `)` that closes the call `IDENT (` at `ti` — what follows the call.
fn _call_follow(S, ti): i64 {
    var k = ti + 2;
    var d = 1;
    while (k < GTCNT(S)) {
        var t = TOKTYP(S, k);
        if (t == 10) { d = d + 1; }
        if (t == 11) { d = d - 1; if (d == 0) { break; } }
        k = k + 1;
    }
    return TOKTYP(S, k + 1);
}

# The `)` closing the call whose `(` is token `o`. CHANGELOG [6.6.12]
fn _call_close(S, o): i64 {
    var k = o + 1;
    var d = 1;
    while (k < GTCNT(S)) {
        var t = TOKTYP(S, k);
        if (t == 10) { d = d + 1; }
        if (t == 11) { d = d - 1; if (d == 0) { return k; } }
        k = k + 1;
    }
    return k;
}

# 1 = the call `name(..)` / `name<..>(..)` at token `ti` is followed by `.field` — its result is
# not the value (a `..` range is not a field). The receives that size a destination from the
# callee's return skip such a call. CHANGELOG [6.6.12]
fn _call_dotted(S, ti): i64 {
    var o = _gcall_open(S, ti);
    if (o < 0) { return 0; }
    var c = _call_close(S, o);
    if (TOKTYP(S, c + 1) != 41) { return 0; }
    if (TOKTYP(S, c + 2) != 2) { return 0; }
    return 1;
}

# Is the call at `ti` the WHOLE argument (followed by `,` or `)`)? A call inside a larger
# expression (`f(a) + 1`) is left to the ordinary value path.
fn _call_is_whole_arg(S, ti): i64 {
    var nx = _call_follow(S, ti);
    if (nx == 31) { return 1; }
    if (nx == 11) { return 1; }
    return 0;
}

# `return f(..);` in a struct-returning fn, where `f` returns that same struct: the call into a
# temp (returned), or -1 when the return expression is not that shape. CHANGELOG [6.6.6]
fn _return_struct_call(S): i64 {
    if (_gcall_open(S, GTI(S)) < 0) { return 0 - 1; }   # 6.6.10: `name(` or `name<..>(`
    if (_call_dotted(S, GTI(S)) == 1) { return 0 - 1; }   # 6.6.12: a field of the result
    var fi = _gen_resolve_call(S, GTI(S));   # 6.6.10: a generic's instance, not its base
    if (fi < 0) { return 0 - 1; }
    if (GFRS(S, fi) != _cur_fn_ret_sid) { return 0 - 1; }
    if (_ret_agg_class(S, fi) != 2) { return 0 - 1; }
    return _struct_call_into_temp(S);
}

# `var G: S = f(..)` at top level, `f` returning `S` in rax:rdx: the global is not an inline
# aggregate there (no receive path exists outside a fn), so `G.x` dereferenced the returned
# first word — SIGSEGV. Refused by name, like the retptr form PARSE_FNCALL refuses. CHANGELOG [6.6.6]
# `ti` is the callee's name token. ⛔ 6.6.11: resolved as the call REACHES it (`_gcall_open` +
# `_gen_resolve_call`) — FINDFN read the generic BASE, whose 8 B `W1<T>` is class 0, so
# `var G: W1<Pt> = mkw(gp)` was never refused (rc 139) — and also run by the declaration-zone
# replay (`_gvi_expr`), which never reached it at all: a `var G: Pt = mkp(2);` before the first
# top-level statement compiled clean and SIGSEGV'd on `G.x`. CHANGELOG [6.6.11]
fn _refuse_toplevel_pair_init(S, pscale, ti): i64 {
    if (pscale >= 0) { return 0; }
    if (_gcall_open(S, ti) < 0) { return 0; }
    if (_call_dotted(S, ti) == 1) { return 0; }   # 6.6.12: `_call_field` refuses a field of it
    var fi = _gen_resolve_call(S, ti);
    if (fi < 0) { return 0; }
    if (_grc_err < 0) { return 0; }   # a failed instantiation: the call refuses itself, once
    if (_ret_agg_class(S, fi) != 1) { return 0; }
    if (GFRS(S, fi) != 0 - pscale) { return 0; }
    _refuse_toplevel_struct_call(S, TOKVAL(S, ti));
    return 0;
}

# `h(p2(..))` at top level, `h` taking the struct by address and `p2` returning it in rax:rdx:
# there is no frame to put the pair in, so refuse it by name. Always returns 0 — the argument
# is then pushed by the ordinary path, and `_had_error` keeps the binary from being written.
fn _refuse_toplevel_pair_arg(S): i64 {
    if (_ret_agg_class(S, _gen_resolve_call(S, GTI(S))) != 1) { return 0; }   # 6.6.10: the instance's class
    if (_call_is_whole_arg(S, GTI(S)) == 0) { return 0; }
    _refuse_toplevel_struct_call(S, PEEKV(S));
    return 0;
}

# ⭐ 6.6.6 (bite 14 review) — A METHOD CALL OR AN OVERLOADED OPERATOR RETURNING A STRUCT BY
# VALUE. 14c gave every FREE-fn call a destination and missed the two paths that emit their own
# call: `var r: P3 = b.mk(2)`, `b.mk(3);`, `r = b.mk(5)` and `var c: V3 = a + b` SIGSEGV'd on
# x86, aarch64 and Win64 (the callee took `self` / the lhs address as its retptr), and
# `q = b.mp(3)` (rax:rdx) kept rax only. The emitter brackets its call with three hooks:
#   _sc_pre   before its first push: a temp — always for a >16 B result in a fn, for a 9-16 B one
#             only when a destination asked (`beg == _sc_want`) — and on x86/cx the temp's
#             address as int arg 0 (`_sc_n0` = 1), before `self` / the lhs
#   _sc_x8    after ECALLPOPS: the temp's address in aarch64's X8
#   _sc_post  after the call: the rax:rdx store / the first word as the value, and the record
#             (`_sc_*` in parse.cyr) a destination matches with `_sc_whole`
# At top level there is no frame: a >16 B call is refused here; a 9-16 B one is recorded without
# a temp, and a destination that needs storage refuses it. CHANGELOG [6.6.6]
fn _sc_pre(S, fi, noff, beg): i64 {
    _sc_n0 = 0;
    var cls = _ret_agg_class(S, fi);
    if (cls == 0) { return 0 - 1; }
    if (GINFN(S) != 1) {
        if (cls == 2) { _refuse_toplevel_struct_call(S, noff); }
        return 0 - 1;
    }
    if (cls == 1) { if (beg != _sc_want) { return 0 - 1; } }
    var t = _agg_temp(S, GFRS(S, fi));
    if (cls == 2) { if (_AARCH64_BACKEND == 0) {
            EFLADDR(S, t);
            EPUSHR(S);
            _sc_n0 = 1;
        } }
    return t;
}

fn _sc_x8(S, fi, t): i64 {
    if (t < 0) { return 0; }
    if (_AARCH64_BACKEND != 1) { return 0; }
    if (_ret_agg_class(S, fi) == 2) { EFLADDR_X8(S, t); }
    return 0;
}

fn _sc_post(S, fi, noff, beg, t): i64 {
    var cls = _ret_agg_class(S, fi);
    if (cls == 0) { return _sc_post_small(S, fi, noff, beg); }
    if (t >= 0) {
        if (cls == 1) { EFLSTORE_STRUCT_INT_PAIR(S, t); }
        else { EFLLOAD(S, t); SESTYPE(S, 0); }
    } else {
        if (GINFN(S) == 1) { return 0; }   # a 9-16 B result nobody asked to store: rax:rdx as ever
        if (cls == 2) {                    # top level: `_sc_pre` already refused it
            _sc_rbeg = beg;
            _sc_rend = GTI(S);
            return 0;
        }
    }
    _sc_beg = beg;
    _sc_end = GTI(S);
    _sc_tmp = t;
    _sc_sid = GFRS(S, fi);
    _sc_fn = noff;
    return 0;
}

# ⛔ 6.6.11 — A STRUCT RESULT OF 8 B OR LESS WAS NEVER RECORDED, so no destination could compare its
# type: `h.o = y.same()`, `z = y.same()`, `var z: Odd = y + y` stored an Od2 into an Odd silently
# (only the free-call FIELD form was refused). Recorded now with `_sc_tmp = -3`: "the value is in
# rax, there is no temp". Every `_sc_whole` consumer either type-checks it (`_fsc_expr`,
# `_pcmpe_struct_assign`, both var receives) or keeps ignoring it (-3 is neither -1 nor a slot).
# Str (16 B, a handle in rax) is not a <= 8 B struct and stays unrecorded. The scalar operator
# dispatch (parse_expr.cyr) calls this directly. CHANGELOG [6.6.11]
fn _sc_post_small(S, fi, noff, beg): i64 {
    if (fi < 0) { return 0; }
    var sid = GFRS(S, fi);
    if (sid <= 0) { return 0; }
    if (STRUCTSZ(S, sid - 1) > 8) { return 0; }
    _sc_beg = beg;
    _sc_end = GTI(S);
    _sc_tmp = 0 - 3;
    _sc_sid = sid;
    _sc_fn = noff;
    return 0;
}

# A struct-typed declaration (`pscale` = `0 - sid`) initialised from a recorded struct call of a
# different struct: refused (1). CHANGELOG [6.6.11]
fn _sc_decl_mismatch(S, pscale, sid): i64 {
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    if (pscale == 0 - sid) { return 0; }
    ERR_MSG(S, "fn return struct-id differs from declared var type", 50);
    return 1;
}

# ⛔ 6.6.11 — PARSE_VAR's initialiser arming, for a struct-typed declaration: the struct-typed
# FIELD source (`var p: Pt = b.v`, see `_fla_arm`) in a fn, and the type check of a whole free
# call returning a struct of 8 B or less (`var z: Odd = mkod2()`), which comes back in rax and so
# never reached the retptr / rax:rdx receives, the only ones that compared the sid. Returns the
# previous `_sc_want`, for `_scv_disarm`. CHANGELOG [6.6.11]
fn _scv_arm(S, pscale): i64 {
    if (pscale < 0) { if (pscale > 0 - 2048) {
            _scv_call_check(S, pscale);
            if (GINFN(S) == 1) { _fla_arm(GTI(S), pscale); }
        } }
    return _sc_arm(S);
}
fn _scv_disarm(w): i64 {
    _sc_want = w;
    _fla_want = 0 - 1;
    return 0;
}
fn _scv_call_check(S, pscale): i64 {
    var o = _gcall_open(S, GTI(S));
    if (o < 0) { return 0; }
    if (_call_follow(S, o - 1) != 5) { return 0; }
    var fi = _gen_resolve_call(S, GTI(S));
    if (fi < 0) { return 0; }
    if (_grc_err < 0) { return 0; }   # a failed instantiation: the call refuses itself, once
    var rs = GFRS(S, fi);
    if (rs <= 0) { return 0; }
    if (STRUCTSZ(S, rs - 1) > 8) {
        # In a fn the retptr / rax:rdx receives compare the sid; at top level there are none, so
        # a 9-16 B result is checked here (a >16 B one refuses itself: no frame). CHANGELOG [6.6.11]
        if (GINFN(S) == 1) { return 0; }
        if (_ret_agg_class(S, fi) != 1) { return 0; }
    }
    _sc_decl_mismatch(S, pscale, rs);
    return 0;
}

# The destination half. Arm before parsing the expression at the cursor; the previous want is
# returned for the caller to restore right after the parse, since a nested destination re-arms.
fn _sc_arm(S): i64 {
    var w = _sc_want;
    _sc_want = GTI(S);
    _sc_beg = 0 - 1;
    return w;
}

# After parsing from `start`: the temp holding the WHOLE expression's struct result; -1 when the
# whole expression is such a call at top level (no temp); -2 when it is not one — a struct call
# inside a larger expression (`b.mk(1).x`, `k + a * b`) does not span it, so it never matches.
fn _sc_whole(S, start): i64 {
    if (_sc_beg != start) { return 0 - 2; }
    if (_sc_end != GTI(S)) { return 0 - 2; }
    return _sc_tmp;
}

# `var p: S = <expr>` / `var p = <expr>` in a fn, <expr> one whole method/operator call returning
# S: the temp BECOMES `p` — named in place, the same inline aggregate `var p: S = f(..)` makes (and,
# untyped, the same inference). `ext` != 0 = a scalar/float/slice annotation: the first word, as
# ever. Returns 1 when `p` is declared. CHANGELOG [6.6.6]
fn _sc_var_receive(S, noff, pscale, ext, start): i64 {
    if (_fla_hit == 1) { return _fla_var_receive(S, noff, pscale); }   # 6.6.11: `var p: S = b.v`
    var t = _sc_whole(S, start);
    if (t == 0 - 3) { _sc_decl_mismatch(S, pscale, _sc_sid); return 0; }   # 6.6.11: <= 8 B, in rax
    if (t < 0) { return 0; }
    if (pscale == 0) {
        if (ext != 0) { return 0; }
    } elif (_sc_decl_mismatch(S, pscale, _sc_sid) == 1) {
        return 0;
    } elif (pscale != 0 - _sc_sid) {
        return 0;
    }
    S64(S + 0x5D9D000 + t * 8, noff);
    SSLICE_W(S, t, 0);
    return 1;
}

# `var G: S = <expr>` at top level: no frame, so a 9-16 B method/operator result is refused by name
# (a >16 B one already was, in `_sc_pre`). Untyped `var g = ..` keeps the first word.
fn _sc_global_receive(S, pscale, start): i64 {
    if (pscale <= 0 - 2048) { return _vecg_rhs_ok(S, start); }   # 6.6.17 (a3): a vector global
    if (_sc_global_mismatch(S, pscale, start) != 0) { return 0; }
    if (_sc_whole(S, start) != 0 - 1) { return 0; }
    if (pscale != 0 - _sc_sid) { return 0; }
    _refuse_toplevel_struct_call(S, _sc_fn);
    return 0;
}

# 6.6.17 (a3): a vector global declared after the first statement takes only `= 0;` (see
# `_vecg_size`, parse_decl.cyr). `start` is the initializer's first token, after
# `var NAME : VEC =` (a vector type is one token, so the name is 4 back).
fn _vecg_rhs_ok(S, start): i64 {
    var v = _CF_TRY(S, start, 5);
    var has = 0;
    if (_cf_ok == 1) { has = 1; }
    _vecg_init_ok(S, has, v, TOKVAL(S, start - 4));
    return 0;
}

# A top-level struct-typed destination given a whole method/operator result of another struct —
# <= 8 B (-3, in rax) or 9-16 B (-1, no frame) — refused by name (1). CHANGELOG [6.6.11]
fn _sc_global_mismatch(S, pscale, start): i64 {
    var t = _sc_whole(S, start);
    if (t != 0 - 3) { if (t != 0 - 1) { return 0; } }
    if (pscale >= 0) { return 0; }
    if (pscale == 0 - _sc_sid) { return 0; }
    return _sc_decl_mismatch(S, pscale, _sc_sid);
}

# A by-value struct parameter given an expression that is neither a bare name nor a free-fn call
# (those have their own arms in `_try_push_struct_addr_arg`): when it is one whole method/operator
# call returning a struct, the callee gets the temp's ADDRESS — the result's storage — where it
# used to get the first word. Anything else pushes the value, which is exactly what the caller's
# own PCMPE + EPUSHR would push. Returns 1: the argument is consumed. CHANGELOG [6.6.6]
# ⛔ 6.6.12 — A STRUCT-TYPED FIELD AS THE WHOLE ARGUMENT (`take(r.v)`) PUSHED ITS FIRST WORD, and
# the callee dereferenced that word as the struct's address: SIGSEGV on x86 and aarch64, a page
# fault on PE, 0 on cx — from a local, global, by-value parameter or pointer-mode base alike, and
# through a generic instance. The whole-field record (`_fla_want` / `_fla_take`) is armed here
# too, ending at `,` or `)`; see `_fla_push_arg`. CHANGELOG [6.6.12]
fn _push_struct_expr_arg(S, fi, argc): i64 {
    var st = GTI(S);
    var w = _sc_arm(S);
    var fw = _fla_want;
    var fa = _fla_arg;
    _fla_want = st;
    _fla_arg = st;
    _fla_hit = 0;
    PCMPE(S);
    _sc_want = w;
    _fla_want = fw;
    _fla_arg = fa;
    if (_fla_hit == 1) { return _fla_push_arg(S, fi, argc); }
    var t = _sc_whole(S, st);
    if (t >= 0) { EFLADDR(S, t); }
    if (t == 0 - 1) { _refuse_toplevel_struct_call(S, _sc_fn); }
    EPUSHR(S);
    return 1;
}

# The recorded field source as by-value argument `argc` of `fn`: checked against the parameter's
# struct (SFPSID — the instance's for a generic) and refused by name when it differs. The field's
# own ADDRESS is passed, in a fn and at top level alike, as a named argument's is: the callee
# copies it in its prologue (`_sptr_params_localize`), so a write through its parameter cannot
# reach the caller's field — the by-value contract. 6.6.12 copied it into a caller frame temp
# here instead, which had no frame to use at top level (there the callee got the field itself);
# with the callee's copy that temp was a second copy. Returns 1. CHANGELOG [6.6.12] [6.6.16]
fn _fla_push_arg(S, fi, argc): i64 {
    _fla_hit = 0;
    var ps = GFPSID(S, fi, argc);
    if (ps > 0) { if (ps != _fla_ft) {
            ERR_IDENT(S, "cannot pass ", _fla_name, " to a by-value parameter of a different struct type in a call to ", L64(_fnt_names + fi * 8));
            EPUSHR(S);   # keeps the argument count; no binary is written
            return 1;
        } }
    _fsc_src_x1(S, 0);
    EMOVI(S, 0);
    EADDR(S);            # rax = x1
    EPUSHR(S);
    return 1;
}

# `return s.m(..);` / `return a + b;` in a >16 B struct-returning fn, the call returning this same
# struct: its temp, which PARSE_RETURN copies into our retptr like `return IDENT;`. -1 when the
# expression is neither a method call nor an operator expression (cursor untouched). When it is
# one but not that shape: the struct-return diagnostic, and a junk slot 0 (cursor at `;`, the
# binary is never written). CHANGELOG [6.6.6]
fn _return_struct_expr(S): i64 {
    if (PEEKT(S) != 2) { return 0 - 1; }
    var nx = TOKTYP(S, GTI(S) + 1);
    if (nx == 41) {
        if (TOKTYP(S, GTI(S) + 3) != 10) { return 0 - 1; }
    } elif (_is_op_dispatch_tok(nx) == 0) { return 0 - 1; }
    var st = GTI(S);
    var w = _sc_arm(S);
    PCMPE(S);
    _sc_want = w;
    var t = _sc_whole(S, st);
    if (t >= 0) { if (_sc_sid == _cur_fn_ret_sid) { return t; } }
    ERR_MSG(S, "struct-return fn: return must be a bare local identifier, or a call to a fn returning the same struct", 101);
    return 0;
}

# ⛔ 6.6.6 (bite 14 review) — A 9-16 BYTE STRUCT RETURN (rax:rdx) ACCEPTED ANY EXPRESSION. The
# pair branch in PARSE_RETURN handled `return IDENT;` for a matching local and FELL THROUGH to
# the scalar PCMPE path for everything else — so `fn pr(): P2 { return s2(1,2); }` (s2 returns a
# 24 B P3 through a retptr) and `fn p5(): P2 { return 5; }` both compiled clean and handed back
# garbage: rax held whatever the expression left there and rdx was never written at all. The
# retptr sibling has always error'd on a shape it cannot carry; this class never did.
# These three say what the pair ABI CAN carry. `_pair_ret_call_ok` is a call to a fn returning
# the same struct in the same two registers (a pure rax:rdx passthrough — no copy needed);
# `_pair_ret_expr_shape` is the method / overloaded-operator token shape, which `_sc_pre` /
# `_sc_post` land in a frame temp for the pair load. Anything else is refused BY NAME.
# CHANGELOG [6.6.6]
fn _pair_ret_call_ok(S): i64 {
    if (_gcall_open(S, GTI(S)) < 0) { return 0; }   # 6.6.10: `name(` or `name<..>(`
    if (_call_dotted(S, GTI(S)) == 1) { return 0; }   # 6.6.12: a field of the result
    # 6.6.10 (bite 7 review): the fn the call REACHES — `return mkw(p);` from a `: W1<Pt>` fn was
    # compared against the base's 8 B `W1` and refused (6.6.9 compiled it).
    var fi = _gen_resolve_call(S, GTI(S));
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != _cur_fn_ret_sid) { return 0; }
    if (_ret_agg_class(S, fi) != 1) { return 0; }
    return 1;
}
fn _pair_ret_expr_shape(S): i64 {
    if (PEEKT(S) != 2) { return 0; }
    var nx = TOKTYP(S, GTI(S) + 1);
    if (nx == 41) {
        if (TOKTYP(S, GTI(S) + 3) == 10) { return 1; }
        return 0;
    }
    return _is_op_dispatch_tok(nx);
}
# Name what is actually there, so the diagnostic points at the construct and not just the fn.
fn _pair_ret_offender(S): i64 {
    if (PEEKT(S) == 2) { PRSTR(S + 0xEC00000 + PEEKV(S)); return 0; }
    if (PEEKT(S) == 1) { PRNUM(PEEKV(S)); return 0; }
    # 6.6.6 — a parenthesised return is either a tuple or a grouped expression; both read as
    # `(...)` and both are refusable shapes for a vector return. CHANGELOG [6.6.6]
    if (PEEKT(S) == 10) { syscall(SYS_WRITE, 2, "(...)", 5); return 0; }
    syscall(SYS_WRITE, 2, "this expression", 15);
    return 0;
}
# ⛔ 6.6.6 — A SIMD-RETURNING FN ACCEPTED ANY RETURN EXPRESSION. The same shape as the pair
# class above, one type class over. PARSE_RETURN's `_is_simd128` / `_is_simd256` branches handle
# exactly `return IDENT;` for a local of the matching class; everything else fell through to the
# scalar PCMPE path, so on 6.6.5 `fn bad(): f64v2 { return 5; }` compiled clean and handed back
# a half-written register pair (measured 0), and so did `return s;` for a scalar local, a bare
# `return;`, `return x + y;` (which returned Y UNCHANGED — there is no vector `+`),
# `return load64(&v);`, `return sc();` for a scalar-returning `sc`, and `return mk4();` from a
# `: f64v2` fn for a 32-byte `mk4`. The v6.4.31 `_TARGET_PE` arm below covers only
# `return <simd_call>(..)`.
# ⚠ THE CALL FORM IS TESTED ON THE EXACT DECLARED TYPE, not on the class, while `return IDENT;`
# above accepts any local of the same class. That asymmetry is deliberate and load-bearing: the
# `return IDENT;` branches byte-COPY 16/32 bytes, which is right whatever the lane type, but the
# PE arm keys on `GFRS(callee) == _cur_fn_ret_scalar` — so a same-class call of a DIFFERENT
# declared type would miss that arm and land on the generic path on Windows, which is the shape
# this bite removes. Refusing is the conservative answer, never a miscompile.
fn _simd_ret_call_ok(S): i64 {
    if (PEEKT(S) != 2) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 10) { return 0; }
    var fi = FINDFN(S, PEEKV(S));
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != _cur_fn_ret_scalar) { return 0; }
    return 1;
}
fn _cur_fn_returns_vector(S): i64 {
    if (_is_simd128(S, _cur_fn_ret_scalar) == 1) { return 1; }
    if (_is_simd256(S, _cur_fn_ret_scalar) == 1) { return 1; }
    return 0;
}
fn _refuse_simd_return(S): i64 {
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": a vector-returning fn carries its result in a fixed register pair, so `return` takes a local of that vector type or a call to a fn declared to return the same one — got `", 174);
    _pair_ret_offender(S);   # names the construct; not pair-specific despite the name
    syscall(SYS_WRITE, 2, "`\n", 2);
    _had_error = 1;
    return 0;
}

# 6.6.6 — the TUPLE spelling of the shape `_refuse_simd_return` names, called from
# PARSE_RETURN's multi-return arm. Its own fn for the same reason the other refusals are:
# cybs, the bootstrap compiler the seed assembles, fails SILENTLY when one fn accumulates too
# many global/call references, and PARSE_RETURN is already the largest fn in the frontend.
fn _refuse_vector_tuple_return(S): i64 {
    if (_cur_fn_returns_vector(S) == 0) { return 0; }
    _refuse_simd_return(S);
    return 0;
}

fn _refuse_pair_return(S): i64 {
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": a fn returning the 9-16 byte struct `", 39);
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (_cur_fn_ret_sid - 1) * 8));
    syscall(SYS_WRITE, 2, "` is returned in two registers, so `return` takes a local of that struct or a call returning it — got `", 105);
    _pair_ret_offender(S);
    syscall(SYS_WRITE, 2, "`\n", 2);
    _had_error = 1;
    return 0;
}

# The binary operators EMIT_OP_DISPATCH serves: + - * / and the wrapping +% -% *%.
fn _is_op_dispatch_tok(t): i64 {
    if (t >= 6) { if (t <= 9) { return 1; } }
    if (t == 113) { return 1; }
    if (t == 116) { return 1; }
    if (t == 119) { return 1; }
    return 0;
}

# ⛔ 6.6.6 — an `async fn` captures each parameter as ONE 8-byte int: its constructor homes
# register i into frame slot i and copies it to `obj[16 + i*8]` (or coroutine frame slot i), and
# `future_force` hands them back to the body as int arguments. A value-form vector travels in
# XMM/V (SysV/aarch64) or by pointer (Win64) and owns 2-4 slots, so it was never captured: a plain
# async fn computed with whatever XMM0 held at force time, a coroutine with the neighbouring ints
# shifted into the vector's lanes — exit 0, no diagnostic, while a vector LOCAL in the same fn
# was refused. Refused by name until the capture exists. CHANGELOG [6.6.6]
fn _refuse_async_simd_param(S, pnoff): i64 {
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": async fn parameter '", 22);
    PRSTR(S + 0xEC00000 + pnoff);
    syscall(SYS_WRITE, 2, "' is a value-form vector, which an `async fn` does not capture yet — pass a pointer to it\n", 92);
    _had_error = 1;
    return 0;
}
# ⛔ 6.6.16 (C7) — the same capture, for a plain struct over 8 B passed by value. Such a parameter
# arrives as its struct's ADDRESS, and a by-value one is copied in the callee's prologue
# (`_sptr_params_localize`) — but an `async fn` runs its body at force time, so the copy would
# read the caller's struct late (measured: `bump(p)`, then `p.x = 10`, then `await` printed 11),
# and a coroutine impl re-runs its prologue on every resume. Refused by name until the Future
# carries the struct; `p: *T` (one i64) and a struct of 8 B or less still compile. `li` is the
# parameter's slot, typed and not yet marked (`_param_record`). CHANGELOG [6.6.16]
fn _refuse_async_struct_param(S, li, pnoff): i64 {
    if (_cur_fn_ptrp == li + 1) { return 0; }
    var lt = GLTYPE(S, li);
    if (_agc_plain_big(S, lt) == 0) { return 0; }
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": async fn parameter '", 22);
    PRSTR(S + 0xEC00000 + pnoff);
    syscall(SYS_WRITE, 2, "' is a struct passed by value, which an `async fn` does not capture yet — pass a pointer to it (`", 99);
    PRSTR(S + 0xEC00000 + pnoff);
    syscall(SYS_WRITE, 2, ": *", 3);
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + ((0 - lt) - 1) * 8));
    syscall(SYS_WRITE, 2, "`)\n", 3);
    _had_error = 1;
    return 0;
}

# ⛔ 6.6.6 — an `async fn` hands its result back through ONE i64: `future_force` returns what the
# body left in rax. A struct returned BY VALUE does not travel that way. Over 16 B the ABI is a
# hidden retptr that nothing supplies — the coroutine CONSTRUCTOR is itself classified as a retptr
# callee, so the caller's buffer address is consumed building the Future and the body writes its
# result through whatever the first argument register held. 9-16 B is rax:rdx and the Future has
# no second word, so the high half is dropped. Both were SILENT: measured at 6.6.5,
# `async fn a2(a,b): P3` (24 B) made `print_num(future_force(a2(4,5)))` print 0 and exit 0, and the
# 16 B `P2` came back with `.x` only. A struct of 8 B or less IS one i64, and `Str` is a heap
# handle, so those keep working — `_ret_agg_class` is exactly that distinction. Refused by name
# until a Future can carry a struct. CHANGELOG [6.6.6]
fn _refuse_async_struct_return(S, fnoff, fi): i64 {
    if (_ret_agg_class(S, fi) == 0) { return 0; }
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": `async fn ", 12);
    PRSTR(S + 0xEC00000 + fnoff);
    syscall(SYS_WRITE, 2, "` returns a struct by value, and a Future carries one i64 — return a pointer to it\n", 85);
    _had_error = 1;
    return 0;
}

# ⛔ 6.6.6 (bite 16 review) — THE SAME "A FUTURE CARRIES ONE i64" LIMIT, ONE TYPE CLASS OVER.
# `_refuse_async_struct_return` above keys on `_ret_agg_class`, which answers only for STRUCTS
# (`GFRS` positive) — so a VALUE-FORM VECTOR return slipped straight through the hole the struct
# refusal had just closed. A vector travels in XMM/V (SysV/aarch64) or by pointer (Win64), never
# in rax, and the Future has nowhere to put it: measured on the compiler that shipped 16a,
# `async fn av(a,b): f64v2 { ... return v; }` + `future_force(av(7,9))` compiled with ZERO
# diagnostics and yielded 0 where the byte-identical SYNC fn yields 7. This is the exact shape
# `_refuse_async_simd_param` (20 lines up) already refuses on the PARAMETER side — the return
# half was simply never wired to it. Refused by name until a Future can carry a vector.
# CHANGELOG [6.6.6]
fn _refuse_async_vec_return(S, fnoff, fi): i64 {
    if (_is_simd_any(S, GFRS(S, fi)) == 0) { return 0; }
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": `async fn ", 12);
    PRSTR(S + 0xEC00000 + fnoff);
    syscall(SYS_WRITE, 2, "` returns a value-form vector, which an `async fn` does not capture yet — return a pointer to it\n", 99);
    _had_error = 1;
    return 0;
}

# A struct-valued call used where there is no frame to hold its result. Refused by name: before
# 6.6.6 every such site compiled clean and SIGSEGV'd (the callee wrote through whatever the first
# argument register held). CHANGELOG [6.6.6]
fn _refuse_toplevel_struct_call(S, noff): i64 {
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' returns a struct by value, and a struct result needs storage in a fn's frame — call it inside a fn\n", 103);
    _had_error = 1;
    return 0;
}

# v6.4.4/v6.4.7 mask classes: 1 = any 16-byte/1-XMM vector (f64v2 or an integer vector, so
# the test is the SIZE class), 3 = f32v4 exactly (distinguished so an f64v2 arg is rejected
# rather than silently run through addps), 2 = f64v4 (32-byte).
fn _simd_arg_typecheck(S, cls, lt): i64 {
    if (cls == 1) {
        if (_is_simd128(S, lt) == 0) {
            ERR_MSG(S, "value-form SIMD arg must be a 16-byte vector", 44);
        }
        return 0;
    }
    if (cls == 3) {
        if (lt != 0 - 2121) {
            ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f32v4)", 56);
        }
        return 0;
    }
    if (lt != 0 - 2125) {
        ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f64v4)", 56);
    }
    return 0;
}

# The second half: emit the XMM/V loads AFTER ECALLPOPS, AT the call site, so the vector
# registers hold the values entering the callee. See _simd_arg_record. CHANGELOG [6.6.5]
fn _simd_arg_second_pass(S, tbl, cnt): i64 {
    var i = 0;
    while (i < cnt) {
        var lli = load64(tbl + i * 24);
        var apc = load64(tbl + i * 24 + 8);
        var cl = load64(tbl + i * 24 + 16);
        if (cl == 2) { ELOAD_F64V4_TO_XMM(S, apc, lli); }
        else { ELOAD_F64V2_TO_XMM(S, apc, lli); }
        i = i + 1;
    }
    return 0;
}

# v5.6.4 #deprecated call-site warning. It fires at EVERY call site (unlike #must_use,
# which only fires on statement-level discard — deprecated fns should get the nudge no
# matter how their result is used). Message body lives in fn_deprecated_msg as a
# string-literal token value (offset<<32 | length).
#
# ⛔ 6.6.16 — reached ONLY through `_callee_site_checks` below. v6.6.4 called it from three
# paths (PARSE_FNCALL, the tail call, `_struct_call_into`) while `_vis_check` had fourteen, so
# `&old_f`, `o.m()`, the struct receives, operator dispatch and the PE vector receives were
# silent; and a call parsed before the definition was silent on every path, because only
# pass 2 set the bit (pass 1 now does — `_prescan_dep_take`). `ti` is the token the warning
# names: `_err_head` read the CURSOR, which the tail path has already walked past `);`, so
# `return old_f(x);` was reported on the NEXT token's line. CHANGELOG [6.6.16]
fn _DEPRECATED_WARN(S, fi, noff, ti): i64 {
    if (GFLG(S, fi) & 4 == 0) { return 0; }
    if (_dep_seen(ti, fi) == 1) { return 0; }
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' is deprecated", 15);
    var _dep_msg = GFDM(S, fi);
    if (_dep_msg != 0) {
        var _dep_len = _dep_msg & 0xFFFFFFFF;
        syscall(SYS_WRITE, 2, ": ", 2);
        syscall(SYS_WRITE, 2, _lit_ptr(S, _dep_msg), _dep_len);   # 6.6.17: a side-table message
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    return 1;
}

# 6.6.16 — ONE warning per call site. The same tokens are parsed more than once: an `#inline`
# fn's body at its definition and again at every expansion, a generic's body for its base and
# again for each instance. A re-parse names the same token for the same callee, so that pair
# is the site — `w(1); w(2);` on an `#inline fn w` calling a deprecated fn printed the
# identical line three times. Every path names a token of its OWN call (an operator its
# operator), so two calls never share a pair. Warnings are rare: a short list, not a bitmap.
var _dep_warned = 0;
fn _dep_seen(ti, fi): i64 {
    if (_dep_warned == 0) { _dep_warned = vec_new(); }
    var n = vec_len(_dep_warned);
    var i = 0;
    while (i < n) {
        if (vec_get(_dep_warned, i) == ti) { if (vec_get(_dep_warned, i + 1) == fi) { return 1; } }
        i = i + 2;
    }
    vec_push(_dep_warned, ti);
    vec_push(_dep_warned, fi);
    return 0;
}

# A generic INSTANCE (`old_g<i32>(..)`, minted as `old_g$i32`) is deprecated when its base is:
# the instance is re-parsed from the base's tokens long after the attribute was consumed, so
# it never received the bit, and only the i64 spellings (which ARE the base) warned.
# 6.6.17 — what an instance must know of itself that the base's pass-1 record holds: its type
# arguments (a3, `_bind_inl_generic`) and the base's "returns one value" bit 1024 (a5,
# `_prescan_ret_single` — the instance's body IS the base's tokens).
fn _gen_inst_record(S, spec, base_fi, c0, c1): i64 {
    if (spec < 0) { return 0; }
    SFIC(S, spec, c0, c1);
    if ((GFLG(S, base_fi) & 1024) != 0) { SFLG(S, spec, GFLG(S, spec) | 1024); }
    return 0;
}
fn _gen_inherit_dep(S, spec, base_fi): i64 {
    if (spec < 0) { return 0; }
    if ((GFLG(S, base_fi) & 4) == 0) { return 0; }
    SFLG(S, spec, GFLG(S, spec) | 4);
    SFDM(S, spec, GFDM(S, base_fi));
    return 0;
}

# 6.6.16 — THE per-callee check, for every path that resolves a name to an fn and emits its
# own call or address: the `private` check and the `#deprecated` warning, together, so the two
# lists cannot drift apart again (they had: 14 sites against 3). A new call path is ONE call
# here; `grep -n '_callee_site_checks' src/frontend/` is the list of paths. `ti` is the token
# the warning names. CHANGELOG [6.6.16]
fn _callee_site_checks(S, fi, noff, ti): i64 {
    if (fi < 0) { return 0; }
    _vis_check(S, fi, noff, ti);
    _DEPRECATED_WARN(S, fi, noff, ti);
    return 0;
}

# The same, naming a token relative to the cursor: `back` = 0 is the cursor itself (a path
# whose cursor is still on the callee's name, its `(`, or the first token after that `(`), 1 is
# the token just consumed (`&old_f`, whose name is behind the cursor — the token AFTER it can be
# on the next line). ONE call with no nested one, so the hot parsers that use it (PARSE_VAR,
# _PARSE_FACTOR_IMPL, PARSE_RETURN, PARSE_FNCALL) carry no more references than `_vis_check`
# alone did — cybs's per-fn reference ceiling fails silently (CLAUDE.md, Release Gate 2).
fn _callee_site_checks_here(S, fi, noff, back): i64 {
    _callee_site_checks(S, fi, noff, GTI(S) - back);
    return 0;
}

# Parse fn call args and emit call (as expression)
# v6.5.0 Phase 2 — cross-file `private` call check. WARN-mode; Phase 3 flips it to a
# hard error via the v6.3.2 undefined-fn playbook (measure the blast radius first,
# then flip default-on rather than sprinkling opt-outs).
#
# ONE shared fn rather than a copy per call site. The plan named two sites; there are
# at least thirteen paths that resolve a name to an fn index and emit their own call —
# ordinary calls, tail calls, operator overloading, methods, `&fn` pointers, closures,
# await, derive helpers. v6.4.81 shipped a bug of exactly that shape: the `_cfo` class
# was declared fixed three times, each fix scoped to the tier its repro landed in, and
# the fourth occurrence was in a resolution path nobody had enumerated. A single helper
# means adding a site is one call, and the set of sites is greppable.
#
# ⛔ v6.6.4: this header named `&fn` pointers and methods as paths that need the call —
# and v6.5.0 shipped THREE callers (PARSE_FNCALL, the tail call, EMIT_OP_DISPATCH).
# hisab found `&_private` callable from any file; the sweep found eight paths that
# resolve a user identifier through FINDFN and emit their own call/fixup with no check:
# `&fn` (parse_expr.cyr), `s.method()`, the asv retptr / asp pair struct receives (also
# the inferred `var q = f()` form), and four PE-only SIMD receive/return paths
# (parse_decl.cyr _try_vector_call_assign / _f2c / _f4c, parse_fn.cyr _rc). All eleven
# now call it — since 6.6.16 through `_callee_site_checks`, its only caller, which adds the
# `#deprecated` warning; `grep -n '_callee_site_checks' src/frontend/` is the list.
#
# ⛔ 6.6.5 — "FAIL-OPEN ON UNKNOWNS … Phase 3 must revisit this" stood here for five
# minors and WAS the hole. An unstamped callee (GFFI == 0) returned at the FIRST test
# below, so every definition kind pass 1 did not register — impl methods, `mod` fns, fns
# after the first top-level statement — was reachable from any file by a call that merely
# came EARLIER in the concatenated stream. Pass 1 now stamps all of them (_prescan_impl /
# _prescan_tail / the GMOD guard's removal), so "unknown" is no longer an ordinary state.
#
# This is the BACKSTOP under that, and it is fail-CLOSED-LATER rather than fail-open: a
# reference to a name with no owner AND no body yet is DEFERRED — recorded with the
# CALLER's file and its token — and re-judged by _vis_check_deferred once every definition
# in the compiland has been stamped. Nothing is reported at the reference itself, so the
# legitimately-unknown callees the old comment listed (enum constructors, DCE stubs, an fn
# that is never defined) stay silent: they still have no private bit at the end.
#
# ⚠ A deferral entry is only as good as the stamp that arrives later. If a future
# definition kind is added that pass 1 does not walk, this layer reports it instead of
# letting it through — which is the property the v6.5.0 comment promised and did not have.
# See tests/gates/frontend/private_forward_reference.sh (mutant M4+M5). CHANGELOG [6.6.5]
var _visdef_vec = 0;
# 6.6.5 round 3 — bumped once per PRIVATE stamp in PARSE_FN_DEF. `_vis_check_deferred` hangs
# off PARSE_PROG, which IS the block parser AND the fn-body parser, so it runs once per
# `if`/`else`/`while` body and once per fn definition; re-walking the whole deferral list each
# time is an unbounded term, because an entry whose callee is NEVER stamped (an undefined fn,
# an enum ctor, a DCE stub — exactly the cases that must stay silent) is never consumed and so
# is re-visited forever. Draining "definitively judged" entries cannot fix it: mid-parse an
# unstamped callee is indistinguishable from a not-yet-stamped one.
#
# ⭐ THE GUARD KEYS ON THE PRIVATE STAMP, NOT ON EVERY STAMP, and the difference is the whole
# fix. `_vis_report_late` reports nothing for a public callee, so a sweep can only reach a new
# verdict if a new PRIVATE bit landed since the last one. A compiland with no `private`
# anywhere — nearly all of them — therefore sweeps exactly ONCE. Keying on `SFFI` instead
# (the first attempt) left the quadratic in place, because every fn body ends with both a
# stamp and a sweep: MEASURED at 2000 refs x 6000 blocks, base 64 ms, SFFI-keyed 91 ms,
# private-keyed 62 ms. Sound by construction, and it is why the number below is measured
# rather than reasoned about.
var _vis_stamp_seq = 0;
var _vis_swept_seq = 0 - 1;
fn _vis_check(S, fi, noff, ti): i64 {
    if (fi < 0) { return 0; }                    # unresolved name — nothing to judge
    if (GFFI(S, fi) == 0) {
        # Owner unknown. If it also has no body yet, this may be a forward reference to a
        # definition that has not been stamped — re-judge it at the end of the parse.
        if (L64(_fnt_offsets + fi * 8) < 0) { _vis_defer(S, fi, ti); }
        return 0;
    }
    if ((GFLG(S, fi) & 64) == 0) { return 0; }   # callee not private — the common path
    var callee = GFFI(S, fi);
    if (callee == 0) { return 0; }               # callee origin unknown
    # The CALLER's file comes from the call's own token, not from `_cur_fn_ix`: the
    # inline-replay path re-parses a callee's body tokens while `_cur_fn_ix` still
    # names the enclosing fn, so asking the fn table would answer for the wrong file.
    # 6.6.17: `ti`, not the cursor — a tail call fires this past `);`, so the cursor named
    # the NEXT token (`return pv(x);` was reported at the `}` below it). CHANGELOG [6.6.17]
    var caller = FM_FILEID(S, GTLINE(S, ti)) + 1;
    if (caller == 0) { return 0; }
    if (caller == callee) { return 0; }          # same file — allowed
    # v6.5.0 Phase 3 — HARD ERROR by default, via the v6.3.2 undefined-fn playbook:
    # measure the blast radius in warn mode first, then flip default-on rather than
    # sprinkling opt-outs. Measured on the tree with lib/regex.cyr adopted (41 private
    # / 9 public): ZERO violations across tests/tcyr, programs, benches and fuzz.
    #
    # Routed through `_had_error` rather than SYS_EXIT so the compiler reports EVERY
    # violation in one run and emits no binary — the v6.4.62 multi-error contract.
    # A fail-fast exit here would make adopting `private` on a large file an
    # N-compile-cycles-to-find-N-callers exercise.
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' is private to its file\n", 25);
    _had_error = 1;
    return 1;
}

# 6.6.5 — record a reference whose callee had no owner yet: (fi, caller fid + 1, token).
# Kept as its own fn so cybs sees a small body (the global/call fan-out rule). Lazy vec:
# a compile with no unstamped reference allocates nothing.
fn _vis_defer(S, fi, ti): i64 {
    var dcaller = FM_FILEID(S, GTLINE(S, ti)) + 1;
    if (dcaller == 0) { return 0; }
    if (_visdef_vec == 0) { _visdef_vec = vec_new(); }
    vec_push(_visdef_vec, fi);
    vec_push(_visdef_vec, dcaller);
    vec_push(_visdef_vec, ti);
    return 0;
}

# 6.6.5 — re-judge every deferred reference against the stamps that exist NOW. Called from
# the end of PARSE_PROG, so there is no per-fork edit to forget.
#
# ⚠ PARSE_PROG IS THE BLOCK PARSER, NOT AN END-OF-PROGRAM HOOK. It runs for every `if` /
# `else` / `while` / `for` body as well as for the top-level statement list, so this is
# entered many times per compile — which is why each entry is CONSUMED when it is reported
# (its fi slot is set to -1) rather than left for the next block to report again. The last
# invocation is the end of the fork's top-level PARSE_PROG call, by which point every
# definition in the compiland has been parsed, so nothing can be missed by stopping early.
# The common path costs one comparison: the vec is never allocated unless something
# deferred. CHANGELOG [6.6.5]
fn _vis_check_deferred(S): i64 {
    if (_visdef_vec == 0) { return 0; }
    if (_vis_swept_seq == _vis_stamp_seq) { return 0; }   # 6.6.5 r3: nothing new stamped
    _vis_swept_seq = _vis_stamp_seq;
    var n = vec_len(_visdef_vec);
    var i = 0;
    while (i < n) {
        var fi = vec_get(_visdef_vec, i);
        if (fi >= 0) {
            if ((GFLG(S, fi) & 64) != 0) {
                var caller = vec_get(_visdef_vec, i + 1);
                var ti = vec_get(_visdef_vec, i + 2);
                if (_vis_report_late(S, fi, caller, ti) == 1) { vec_set(_visdef_vec, i, 0 - 1); }
            }
        }
        i = i + 3;
    }
    return 0;
}

# Returns 1 when it reported (so the caller can consume the entry), 0 when the reference is
# still not judgeable or is legitimate.
fn _vis_report_late(S, fi, caller, ti): i64 {
    var callee = GFFI(S, fi);
    if (callee == 0) { return 0; }
    if (callee == caller) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + L64(_fnt_names + fi * 8));
    syscall(SYS_WRITE, 2, "' is private to its file\n", 25);
    _had_error = 1;
    return 1;
}

# v6.5.0 Phase 3 — one-shot notice that visibility enforcement is DEGRADED.
#
# `private` is keyed on the file map, which caps at 1024 entries. Past that cap
# FM_FILEID cannot identify a file, the stamp records "unrecorded", and the private
# bit is therefore never set — so enforcement silently becomes a no-op for every file
# beyond the cap. Silently is the problem: a consumer who adopts `private` and grows
# past 1024 files would believe they still had a boundary. Fail-open is the right
# CODE behaviour (we cannot prove a violation we cannot attribute) but it must be
# announced, which is what this does.
var _vis_degraded_said = 0;
fn _vis_degraded_note(): i64 {
    if (_vis_degraded_said != 0) { return 0; }
    _vis_degraded_said = 1;
    syscall(SYS_WRITE, 2, "warning: file map full -- `private` enforcement is DISABLED past the 1024-file cap\n", 83);
    return 0;
}

# v6.5.1 — count the arguments of the call whose `(` was just consumed, WITHOUT
# moving the cursor. Needed by the overload-suffix dispatch in PARSE_FNCALL: a
# redirect `base(...)` → `base_str`/`base_int` is only correct when the TARGET's
# parameter count matches what THIS call site actually supplies.
#
# Before this existed the dispatch decided on the type of argument 1 alone and
# would happily rewrite a 1-argument call into a call to a 2-argument function,
# leaving the extra parameter bound to garbage and reporting only a *warning*.
# That is not theoretical: it silently broke `bayan_json_v_parse(someStr)` for
# the whole ecosystem (bayan 1.3.0 renamed its own public API to escape it), and
# it is the reason sakshi's unrelated `_sk_write_str` was a latent landmine.
#
# Depth counts all four bracket kinds — ( ) [ ] { } — so a nested call, an index
# or a struct initializer cannot leak its commas into the top-level count.
# CHANGELOG [6.5.1].
fn _CALL_ARGC_PEEK(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti) == 11) { return 0; }   # `f()` — empty argument list
    var depth = 0;
    var argc = 1;
    while (ti < GTCNT(S)) {
        var t = TOKTYP(S, ti);
        if (t == 12) { return argc; }        # EOF — truncated input, best effort
        if (t == 10) { depth = depth + 1; }
        if (t == 28) { depth = depth + 1; }
        if (t == 13) { depth = depth + 1; }
        if (t == 29) { depth = depth - 1; }
        if (t == 14) { depth = depth - 1; }
        if (t == 11) {
            if (depth == 0) { return argc; }
            depth = depth - 1;
        }
        if (t == 31) { if (depth == 0) { argc = argc + 1; } }
        ti = ti + 1;
    }
    return argc;
}

# v6.5.1 — may `fi` be used as an overload-redirect target for a call supplying
# `argc` arguments? Shared by the _str and _int dispatch arms so the two cannot
# drift. Deliberately permissive in the two cases where the param count is not
# yet knowable, which preserves pre-6.5.1 behaviour rather than silently dropping
# a legitimate redirect:
#   - target not yet DEFINED (offset < 0): its param count is still 0 from REGFN.
#     Same exemption `_CHECK_ARITY` makes via its `need_off` gate.
#   - target is VARIADIC: arity is unconstrained by construction.
fn _OV_ARITY_OK(S, fi, argc): i64 {
    if (L64(_fnt_offsets + fi * 8) < 0) { return 1; }
    if (GFVA(S, fi) != 0) { return 1; }
    if (L64(_fnt_params + fi * 8) == argc) { return 1; }
    return 0;
}

# v5.8.20: #pure caller cannot call #io / #alloc callees. Warning
# (not error) for downstream incremental adoption — same shape as
# #must_use / #deprecated diagnostics. The annotation ramp happens
# gradually; cyrlint --strict will escalate to error in a follow-up.
# 6.6.17: one fn, so the method arm (`p.m(..)`, `_field_load_on`) runs it too — an impl
# method takes `#io` / `#alloc` since 6.6.17 (`_impl_attrs`).
fn _pure_effect_warn(S, fi, noff): i64 {
    if (_cur_fn_is_pure != 1) { return 0; }
    if (fi < 0) { return 0; }
    var fl = GFLG(S, fi);
    if (fl & 16 != 0) {
        syscall(SYS_WRITE, 2, "warning:", 8);
        _err_head(S);
        syscall(SYS_WRITE, 2, ": #pure fn calls #io fn '", 25);
        PRSTR(S + 0xEC00000 + noff);
        syscall(SYS_WRITE, 2, "'\n", 2);
    }
    if (fl & 32 != 0) {
        syscall(SYS_WRITE, 2, "warning:", 8);
        _err_head(S);
        syscall(SYS_WRITE, 2, ": #pure fn calls #alloc fn '", 28);
        PRSTR(S + 0xEC00000 + noff);
        syscall(SYS_WRITE, 2, "'\n", 2);
    }
    return 0;
}

fn PARSE_FNCALL(S, noff): i64 {
    STI(S, GTI(S) + 1);  # consume (
    # Check for inline candidate
    var fi = FINDFN(S, noff);
    if (fi < 0) { fi = REGFN(S, noff); }
    # 6.6.10: a generic callee — infer a struct type argument (-> its instance) or refuse a scalar
    # call of a stub generic. See _gen_call_head.
    var _gfi = _gen_call_head(S, fi, noff);
    if (_gfi != fi) { fi = _gfi; noff = L64(_fnt_names + fi * 8); }
    # v5.10.25 — registry-based overload dispatch on the FIRST argument: for a fn `<base>`
    # with a `<base>_str` / `<base>_int` sibling (tables filled at REGFN time; user pairs work
    # the same way), `base(arg, ..)` is routed to the sibling when the arg matches, behind the
    # v6.5.1 arity gate (`_OV_ARITY_OK`):
    #   _str — the WHOLE first argument is a Str, as `_str_arg_kind` (the I11 classifier) reads
    #          it: a Str local / param / capture, a `: Str` or inferred-Str global, a one-step
    #          `: Str` field (`h.name`, `gh.name`, `mkh().name`), or a call or method declared
    #          `: Str` (`mk()`, `g<T>(..)`, `s.cat(t)`, `mkh().getname()`). `println(gs)` ->
    #          `println_str`, `strlen(gs)` -> `strlen_str`. `x.data`, `x.len`, `s.len()`,
    #          `x + 1` are NOT routed by their base's type.
    #   _int — an `IDENT(..)` call returning i64 (GFRS -8), into an i64-returning base whose
    #          param 0 is `: cstring` (v6.0.3 / v6.5.2, below). A plain i64 IDENT is never
    #          routed here.
    # 6.6.16: the Str arm typed the argument itself — `0 - sid` against a global's positive
    # GVTYPE (so no Str global ever routed and `println(gs)` printed the header's pointer
    # bytes), no fields, and nothing required the name to END the argument, so `show(s.data)`
    # / `show(s.len)` on a Str local reached `show_str`, which read the VALUE as a header.
    # CHANGELOG [6.6.16]
    if (PEEKT(S) == 2) {
        var _od_arg_scalar = 0;
        if (TOKTYP(S, GTI(S) + 1) == 10) {
            var _od_arg_fi = FINDFN(S, PEEKV(S));
            if (_od_arg_fi >= 0) {
                var _od_ret = GFRS(S, _od_arg_fi);
                if (_od_ret < 0) { _od_arg_scalar = 0 - _od_ret; }
            }
        }
        # The sibling first: the classifier scans a call argument's parens, and most bases
        # have no `_str` sibling to route to.
        var _od_str_target = L64(_fnt_ovstr + fi * 8);
        if (_od_str_target > 0) {
            var _od_str_sid = _STR_SID(S);
            if (_od_str_sid > 0) {
                if (_str_arg_kind(S, _od_str_sid) == 1) {
                    # v6.5.1 — arity-gate the redirect (see _OV_ARITY_OK).
                    var _od_st = _od_str_target - 1;
                    if (_OV_ARITY_OK(S, _od_st, _CALL_ARGC_PEEK(S)) == 1) {
                        fi = _od_st;
                        noff = L64(_fnt_names + fi * 8);
                    }
                }
            }
        }
        if (_od_arg_scalar == 8) {
            # v6.0.3 — Option A: only auto-route `base(i64-call) → base_int`
            # when the BASE is OUTPUT-style (declares an i64 return, e.g.
            # `println: i64`). DATA-producing bases (non-i64 return, e.g.
            # `str_from: Str`) must NOT auto-route. Reason: cyrius is
            # i64-everywhere (ADR-002), so the dispatcher cannot tell an
            # i64 that is a NUMBER from an i64 that is a POINTER. The arg
            # here is a fn-call returning i64 (e.g. `vec_get(): i64`,
            # which returns a cstr pointer). Routing `str_from(vec_get(..))`
            # to `str_from_int` STRINGIFIES the pointer's value (decimal)
            # instead of wrapping the cstr — silently corrupting data that
            # flows on (nous 0001: a cstr map key became "<pointer-decimal>"
            # → every lookup missed → cycle detection read acyclic). For an
            # output base the worst case is cosmetically-wrong output; for a
            # value-conversion base it is wrong DATA. `str_from` (Str return)
            # is the only such base in the stdlib; this gate blocks exactly
            # it while keeping `println`/`log_info`/… (i64 return) routing.
            # See CHANGELOG [6.0.3].
            if (GFRS(S, fi) == 0 - 8 && (L64(_fnt_cstrmask + fi * 8) & 1) != 0) {
                var _od_int_target = L64(_fnt_ovint + fi * 8);
                if (_od_int_target > 0) {
                    # v6.5.1 — arity-gate the redirect (see _OV_ARITY_OK).
                    var _od_it = _od_int_target - 1;
                    if (_OV_ARITY_OK(S, _od_it, _CALL_ARGC_PEEK(S)) == 1) {
                        fi = _od_it;
                        noff = L64(_fnt_names + fi * 8);
                    }
                }
            }
        }
    }
    # v5.10.39 — pointer-vs-value overload dispatch extension.
    # When the first arg is `&IDENT` (typ 27 = address-of), look up
    # `<base_name>_ptr` sibling by name. If found, route to it.
    # Enables consumers to call `f64v2_add(&x, &y)` and have the
    # parser auto-route to `f64v2_add_ptr` (v5.10.33 pointer-form),
    # while `f64v2_add(x, y)` (value-form, IDENT args) stays routed
    # to the base name via v5.10.38's caller-side SIMD-arg dispatch.
    #
    # Uses stack-local scratch + _FINDFN_CSTR — no tok_names bloat
    # (unlike the v5.10.25 forward/reverse registration which uses
    # the per-fn overload tables). Compile-time cost: O(N) name
    # compare over registered fns per pointer-form call site.
    if (PEEKT(S) == 27) {
        var _po_base_p = S + 0xEC00000 + noff;
        var _po_base_len = 0;
        while (load8(_po_base_p + _po_base_len) != 0) { _po_base_len = _po_base_len + 1; }
        # 128-byte scratch — must hold base_len + len("_ptr") + null.
        # The 120-char base-length guard below leaves headroom.
        # Pre-bumped from 16 bytes — was overflow-prone for any base
        # name >11 chars (e.g. `f64v2_add_ptr` direct call constructed
        # `f64v2_add_ptr_ptr` = 18 bytes; the overflow corrupted
        # adjacent stack data and returned wrong values from any fn
        # call that hit this dispatch path).
        if (_po_base_len < 120) {
            var _po_scratch[128];
            var _po_i = 0;
            while (_po_i < _po_base_len) {
                store8(&_po_scratch + _po_i, load8(_po_base_p + _po_i));
                _po_i = _po_i + 1;
            }
            store8(&_po_scratch + _po_base_len + 0, 95);   # '_'
            store8(&_po_scratch + _po_base_len + 1, 112);  # 'p'
            store8(&_po_scratch + _po_base_len + 2, 116);  # 't'
            store8(&_po_scratch + _po_base_len + 3, 114);  # 'r'
            store8(&_po_scratch + _po_base_len + 4, 0);
            var _po_fi = _FINDFN_CSTR(S, &_po_scratch, _po_base_len + 4);
            if (_po_fi >= 0) {
                fi = _po_fi;
                noff = L64(_fnt_names + fi * 8);
            }
        }
    }
    # v5.6.4: #deprecated call-site warning, with the `private` check (see
    # _callee_site_checks). It names the first token after the `(` we just consumed,
    # which is on the call-site's line.
    _callee_site_checks_here(S, fi, noff, 0);
    _pure_effect_warn(S, fi, noff);   # v5.8.20 (6.6.17: shared with the method arm)
    # ⛔ 6.6.6 — A >16 B STRUCT-RETURNING CALLEE WRITES ITS RESULT THROUGH A HIDDEN RETPTR, and
    # until 6.6.6 only `var p: S = f(..)` supplied one. Everywhere else — an expression
    # statement, an argument, `return f(..)` in a non-struct fn — the user args were marshalled
    # as if there were none: on x86 the callee took argument 1 as its destination (SIGSEGV
    # writing to 0x1), on aarch64 it wrote through whatever X8 held. Now the result lands in an
    # anonymous frame temp, and the expression's VALUE is its first word — exactly what a struct
    # local yields as an rvalue (`var k = r;`, `h(r)` into an untyped param), so the two agree.
    # At top level there is no frame to hold it: refused by name. CHANGELOG [6.6.6]
    if (_ret_agg_class(S, fi) == 2) {
        if (GINFN(S) == 0) { _refuse_toplevel_struct_call(S, noff); }
        else {
            var _sct = _agg_temp(S, GFRS(S, fi));
            _struct_call_emit(S, fi, noff, _sct);
            EFLLOAD(S, _sct);
            SESTYPE(S, 0);
            return 0;
        }
    }
    # v6.4.31: on Win64 PE a value-form SIMD param (address-passed, struct_mask
    # set) or a SIMD return (retptr-style) can't survive the inline replay, which
    # homes args with an 8-byte EFLSTORE and returns scalar-in-rax — it would
    # truncate the 16/32-byte vector. Force such callees through the normal
    # struct-ptr / retptr path (handled in parse_decl + PARSE_FNCALL below).
    var _pe_no_inline = 0;
    if (_TARGET_PE == 1) {
        if (_smask_args(fi) != 0) { _pe_no_inline = 1; }
        if (_is_simd_any(S, GFRS(S, fi)) == 1) { _pe_no_inline = 1; }
    }
    # 6.6.20: nor a REDEFINED fn (flag 2048, pass 1) on any target — replaying the body in hand
    # bound the call to whichever definition came first; a plain call reaches the last one.
    if ((GFLG(S, fi) & 2048) != 0) { _pe_no_inline = 1; }
    if (GFINL(S, fi) != 0) { if (GIDEP(S) < 3) { if (GINFN(S) == 1) { if (_pe_no_inline == 0) {
                    # INLINE PATH: replay function body tokens at call site
                    var pc = L64(_fnt_params + fi * 8);
                    var saved_flc = GFLC(S);
                    # Allocate fresh frame slots for callee params
                    # v6.5.52 — slot widths come from the callee's recorded param types.
                    var _ipt = GFIPT(S, fi);
                    var _t0 = _ipt_sltype(_ipt, 0);
                    var _t1 = _ipt_sltype(_ipt, 1);
                    var _w0 = _ipt_slots(S, _t0);
                    var _w1 = _ipt_slots(S, _t1);
                    var _ptot = 0;
                    if (pc >= 1) { _ptot = _w0; }
                    if (pc >= 2) { _ptot = _w0 + _w1; }
                    # NAMED slot = deepest of each param's group (anon fillers precede it).
                    var p0_slot = saved_flc + _w0 - 1;
                    var p1_slot = saved_flc + _w0 + _w1 - 1;
                    # v6.3.38 (A-broad) — RESERVE the param slots BEFORE evaluating args, so a
                    # nested inline call while evaluating arg1 uses frame slots ABOVE p0/p1
                    # instead of reusing saved_flc and clobbering the already-stored arg0.
                    # (v6.3.37 A3 only reserved frame SIZE via _flc_hwm; this reserves the slot
                    # INDICES too by bumping GFLC up-front.) Idempotent with the old post-loop
                    # SFLC(saved_flc+pc); the _flc_hwm high-water still feeds the frame patch.
                    SFLC(S, saved_flc + _ptot);
                    if (saved_flc + _ptot > _flc_hwm) { _flc_hwm = saved_flc + _ptot; }
                    # v6.5.52 — INVALIDATE the reserved slots BEFORE evaluating args. The slots are
                    # reserved here but not bound until after the arg loop, and arg evaluation does
                    # name lookups that scan every slot below GFLC — so an unwritten slot is read as
                    # a NAME OFFSET. Whatever the frame held previously is then handed to STREQ as a
                    # string pointer. MEASURED: `rsi = 0xffffffff` at the fault, i.e. a stale `0 - 1`
                    # anon marker dereferenced as a pointer.
                    # ⚠ The pre-v6.5.52 code had the same ordering and survived only because it
                    # reserved exactly `pc` slots and both were overwritten immediately; widening a
                    # param to 2 or 4 slots exposed the latent hole.
                    # v6.5.65 — a fresh replay owns a fresh set of param slots; drop any provenance
                    # left by an enclosing inline so a stale slot index cannot be re-matched.
                    _prov_reset();
                    var _prov_win = GCP(S);
                    var _pini = 0;
                    while (_pini < _ptot) {
                        S64(S + 0x5D9D000 + (saved_flc + _pini) * 8, 0 - 1);
                        SLDEP(S, saved_flc + _pini, 0);
                        SLTYPE(S, saved_flc + _pini, 0);
                        _pini = _pini + 1;
                    }
                    # Evaluate args and store to param slots
                    var iargc = 0;
                    # 6.6.10: the head's inference (by the parameter that carries each type
                    # parameter; a struct never gets here — it instantiated). Was a positional
                    # re-inference in the loop below, so `g(2, p)` bound T from the `2`.
                    var _ginf0 = _gh_inf0;
                    var _ginf1 = _gh_inf1;
                    # v6.2.41 — capture call-site line for the arity warning below.
                    var _iar_line = GTLINE(S, GTI(S));
                    if (PEEKT(S) != 11) {
                        var iago = 1;
                        while (iago == 1) {
                            # v6.5.52 — a SIMD param takes the local-copy path; PCMPE cannot
                            # materialise a value-form vector (see _inl_simd_arg).
                            var _sd = 0;
                            # 6.6.17 (a9): a vector's sentinel is negative; an f64 / f32 tag is positive.
                            if (iargc == 0) { if (_t0 < 0) { _inl_simd_arg(S, p0_slot, _w0, _t0); _sd = 1; } }
                            if (iargc == 1) { if (_t1 < 0) { _inl_simd_arg(S, p1_slot, _w1, _t1); _sd = 1; } }
                            if (_sd == 0) {
                                PCMPE(S);
                                if (iargc == 0) { _inl_store_arg(S, p0_slot, _w0); }
                                if (iargc == 1) { _inl_store_arg(S, p1_slot, _w1); }
                            }
                            iargc = iargc + 1;
                            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                            else { iago = 0; }
                        }
                    }
                    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
                    STI(S, GTI(S) + 1);
                    # v6.2.41 — arity check on the INLINE-replay path. Inline
                    # candidates are small fixed-arity fns (≤2 param slots), so a
                    # 1-param helper called with extra args lands HERE, not on the
                    # normal path — the normal-path check alone would miss it.
                    _CHECK_ARITY(S, _iar_line, noff, fi, iargc, 0);
                    # Set local count past the param slots
                    SFLC(S, saved_flc + _ptot);
                    # v6.3.37 (A3) — record the transient inline param-slot high-water so
                    # the enclosing fn's frame reserves it (see _flc_hwm). Without this the
                    # param slot aliases a live runtime `push rax` and clobbers an operand.
                    if (saved_flc + _ptot > _flc_hwm) { _flc_hwm = saved_flc + _ptot; }
                    # Register callee param names as temporary locals (packed in fn_inline)
                    var inl_packed = GFINL(S, fi);
                    var pn0 = inl_packed & 0xFFFFFFFF;
                    var pn1 = (inl_packed >> 32) & 0xFFFFFFFF;
                    if (pc >= 1) { _inl_bind_param(S, saved_flc, _w0, p0_slot, pn0, _t0); }
                    if (pc >= 2) { _inl_bind_param(S, saved_flc + _w0, _w1, p1_slot, pn1, _t1); }
                    # Save state and replay body tokens
                    var saved_ti = GTI(S);
                    var saved_rpc = vec_len(rp_vec);
                    # v6.3.9 (F-fns): bind T->concrete for the body replay (the bite-4
                    # consults read it). Save the enclosing binding first so a generic
                    # body that itself inline-calls restores correctly. _bind_generic_call
                    # is a no-op for non-generic callees → default path is just the saves
                    # (4 reads, restored verbatim) → byte-identical.
                    var _gsv_n0 = _tp_n0; var _gsv_c0 = _tp_c0;
                    var _gsv_n1 = _tp_n1; var _gsv_c1 = _tp_c1;
                    _bind_inl_generic(S, fi, _ginf0, _ginf1);   # 6.6.17 (a3): an instance binds its own
                    SIDEP(S, GIDEP(S) + 1);
                    # v6.5.52 — the replayed body is a NESTED SCOPE, so bump the scope depth for it.
                    # The duplicate-variable check is `GLDEP(existing) == GSDEP()`, i.e. same-scope,
                    # and the replay previously bumped only the INLINE depth. A callee body that
                    # declares `var r` therefore collided with a caller local of the same name —
                    # which every value-form SIMD wrapper triggers, since they are all
                    # `var r: <vec>; ...; return r;` and callers routinely name a result `r`.
                    # Shadowing is the correct semantics here: FINDLOCAL searches backward so the
                    # body's `r` wins inside the body, and the teardown clears it so the caller's
                    # `r` is visible again afterwards.
                    var _sdep_saved = GSDEP(S);
                    SSDEP(S, _sdep_saved + 1);
                    # v6.5.59 — carry the CALLEE's return class across the replay. The body is
                    # re-parsed inside the CALLER's function context, so `_cur_fn_ret_*` still
                    # described the caller and `return r;` emitted the caller's convention. A
                    # 128-bit vector survived that by luck (one XMM, moved by the default path); a
                    # 256-bit return is a PAIR and its second register was never moved — lanes 0-1
                    # correct, lanes 2-3 STALE, exit 0, no diagnostic.
                    # ⚠ Caught only because the probe asserted ALL FOUR LANES.
                    var _rs_saved = _cur_fn_ret_scalar;
                    var _cfrs = GFRS(S, fi);
                    if (_is_simd_any(S, _cfrs) == 1) { _cur_fn_ret_scalar = _cfrs; }
                    STI(S, GFBS(S, fi));
                    PARSE_PROG(S);
                    _cur_fn_ret_scalar = _rs_saved;
                    SSDEP(S, _sdep_saved);
                    # Patch return jumps from inlined body to here
                    var new_rpc = vec_len(rp_vec);
                    var ri = saved_rpc;
                    while (ri < new_rpc) {
                        EPATCH(S, vec_get(rp_vec, ri));
                        ri = ri + 1;
                    }
                    vec_truncate(rp_vec, saved_rpc);
                    SIDEP(S, GIDEP(S) - 1);
                    # v6.3.9 (F-fns): restore the enclosing generic binding.
                    _tp_n0 = _gsv_n0; _tp_c0 = _gsv_c0;
                    _tp_n1 = _gsv_n1; _tp_c1 = _gsv_c1;
                    # v6.5.66 — the whole body has now been emitted, so "was this param slot ever read?"
                    # is finally answerable. Any copy that was neither read nor written is dead: NOP it.
                    # ⭐ This is also what makes the chain register-resident — the copy's load was the
                    # xmm0 clobber between a link's result store and the next link's read of it, so
                    # removing it lets SLASE collapse that pair too.
                    _prov_harvest(_prov_win, GCP(S));
                    # Restore token index
                    STI(S, saved_ti);
                    # Invalidate the temporary locals the replay created.
                    # v6.5.52: this now covers the WHOLE replay window — the param slots (a wide
                    # param owns (nslots-1) anon fillers below its named slot) AND any locals the
                    # replayed BODY declared. Leaving the body's names registered makes a second
                    # inline of the same callee redeclare them: every value-form SIMD wrapper is
                    # `var r: <vec>; <op>(&r, &a, &b, n); return r;`, so `f32v4_add` used twice in
                    # one fn reported "duplicate variable" at lib/simd.cyr. GFLC is restored too so
                    # the slots are reusable; `_flc_hwm` keeps the peak for frame sizing.
                    var _body_flc = GFLC(S);
                    if (_body_flc > _flc_hwm) { _flc_hwm = _body_flc; }
                    var _inv = saved_flc;
                    while (_inv < _body_flc) {
                        S64(S + 0x5D9D000 + _inv * 8, 0 - 1);
                        SLTYPE(S, _inv, 0);
                        _inv = _inv + 1;
                    }
                    # ⚠ GFLC is deliberately NOT restored. The inlined body's EMITTED CODE still
                    # addresses these frame slots at runtime, so handing them to a later local is a
                    # real aliasing bug — measured: restoring GFLC made simd_ints SIGSEGV at run
                    # time while compiling clean. Only the NAME registrations are cleared, which is
                    # what the duplicate-variable check reads; the slots stay spent.
                    return 0;
                } } } }
    # NORMAL CALL PATH
    # Args pushed left-to-right: arg1 first (bottom), argN last (top).
    # ECALLPOPS pops top 6 into registers: rdi=argN-5, ..., r9=argN.
    # For >6 args, the first (argc-6) remain on stack in forward order.
    # ESTORESTACKPARM compensates for the reversed register assignment.
    # Auto-coerce string literals to Str for params annotated : Str.
    var argc = 0;
    # v6.2.41 — capture the call-site line before the arg loop advances GTI,
    # so the arity warning below points at the call, not the token after `)`.
    var _ar_line = GTLINE(S, GTI(S));
    # v5.10.38 — caller-side SIMD-arg routing. Read the callee's
    # per-fn SIMD mask (2 bits per param: 00 int, 01 f64v2, 10 f64v4).
    # When non-zero, value-form SIMD args get loaded into XMM/V regs
    # AFTER ECALLPOPS so int-arg eval (which may clobber XMM during
    # PCMPE) doesn't trample SIMD state. Scratch table records each
    # SIMD arg's (named_lli, simd_pc, class) so the second pass can
    # emit ELOAD_F64V2_TO_XMM / _F64V4_TO_XMM at the call site.
    var _fc_simd_table: i64[24];   # 8 args × 3 i64s = 24 slots (v6.2.1: i64[24]=192B; bare [24] was 24B → OOB past arg 0)
    var _fc_simd_count = 0;
    var _fc_simd_pc_caller = 0;
    var _fc_int_argc = 0;
    if (PEEKT(S) != 11) {
        var argo = 1;
        while (argo == 1) {
            # v5.10.38 — SIMD-class arg routing (must precede the
            # int-class type-check + push path). When the callee's
            # mask flags this argc as SIMD, the arg MUST be a local
            # f64v2/f64v4 IDENT (value-form caller pattern). Record
            # the IDENT's local idx + this caller-side simd ordinal
            # for the post-ECALLPOPS emission pass. Skip the int-
            # class push entirely; argc still advances for mask
            # alignment but _fc_int_argc does NOT.
            # 6.6.5: the body of this arm is now `_simd_arg_record`, shared with the
            # method-call path in parse_decl.cyr, which had no SIMD routing at all and
            # shifted every argument after a vector one by a register. CHANGELOG [6.6.5]
            var _fc_class = _pm_simd(fi, argc);   # 6.6.17 (a10)
            if (_fc_class > 0) {
                _fc_simd_pc_caller = _fc_simd_pc_caller + _simd_arg_record(S, _fc_class, &_fc_simd_table, _fc_simd_count, _fc_simd_pc_caller);
                _fc_simd_count = _fc_simd_count + 1;
                argc = argc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { argo = 0; }
                continue;
            }
            # The argument type checks (default ON since v5.10.5; `CYRIUS_TYPE_CHECK=0` opts out).
            # The v5.10.3 overload dispatch above has already routed the well-known shapes
            # (println(Str) -> println_str, strlen(Str) -> str_len, println(i64) -> println_int);
            # what is left are mismatches with no route, gated on the callee's param being
            # EXPLICITLY annotated `: cstring` (v5.10.24 — the old str_mask-cleared polarity
            # flooded every untyped param that legitimately takes a Str-as-pointer).
            #
            # v6.5.3 — an integer LITERAL passed to a param explicitly annotated
            # `: cstring` is unambiguously wrong. Unlike an i64 variable or a fn-call
            # result — which cyrius genuinely cannot distinguish from a pointer, per
            # ADR-002's i64-everywhere tenet — a literal is known at parse time to be a
            # NUMBER. Previously this compiled with NO diagnostic and SIGSEGV'd at
            # runtime, because the callee dereferences it as a char*: `println(42)`
            # printed nothing and died with signal 11. The `_int` overload route never
            # covered it either, since that route only ever fires for a bare fn-call
            # argument (never a literal, never a variable).
            #
            # `0` is EXEMPT — it is the idiomatic NULL for a cstring param.
            # Hard error, not a warning: there is no reading of this program under which
            # the call is correct, and a warning here is what let the crash ship.
            # 6.6.5: extracted to `_check_int_lit_cstring_arg`, shared with the method-call
            # path in parse_decl.cyr — `w.pr(42)` into a `: cstring` param compiled clean
            # and SIGSEGV'd where the identical free fn was a hard error. CHANGELOG [6.6.5]
            _check_int_lit_cstring_arg(S, fi, argc, noff);
            # A Str (or a Str's data pointer) into a `: cstring` param: a warning, from the ONE
            # helper every argument loop shares. Its hint never suggests `str_data(x)` — a Str's
            # bytes are not NUL-terminated at its length, so that is the bug, not the fix.
            # CHANGELOG [6.6.13]
            _check_str_cstring_arg(S, fi, argc, noff);   # 6.6.13 I11
            # Auto-coercion: if this param is : Str and the arg is a string literal,
            # emit str_from(literal) instead of the raw cstr pointer.
            # 6.6.5: extracted to `_try_push_str_literal_arg`, shared with the method-call
            # path in parse_decl.cyr, where `h.m("lit")` into a `: Str` param silently read
            # back 0. CHANGELOG [6.6.5]
            if (_try_push_str_literal_arg(S, fi, argc) == 1) {
                argc = argc + 1;
                _fc_int_argc = _fc_int_argc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { argo = 0; }
                continue;
            }
            # v6.3.36 (issue [5]) — bare inline-struct arg to a struct-pointer param:
            # push its address (frame-safe non-tail path). Falls through otherwise.
            if (_try_push_struct_addr_arg(S, fi, argc) == 1) {
                argc = argc + 1;
                _fc_int_argc = _fc_int_argc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { argo = 0; }
                continue;
            }
            PCMPE(S);
            EPUSHR(S);
            argc = argc + 1;
            _fc_int_argc = _fc_int_argc + 1;
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
            else { argo = 0; }
        }
    }
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    # v6.2.41 — normal-path call-site arity check (see _CHECK_ARITY above).
    _CHECK_ARITY(S, _ar_line, noff, fi, argc, 1);
    # v5.10.38 — SysV split-counter: ECALLPOPS only pops the int-class
    # arg count from the stack into RDI/RSI/RDX/RCX/R8/R9. SIMD args
    # haven't been pushed (they were recorded for the second pass
    # below).
    ECALLPOPS(S, _fc_int_argc);
    # Second pass: emit XMM/V loads for recorded SIMD args. AFTER
    # ECALLPOPS so int-arg eval can't clobber XMM state. AT the call
    # site so XMM holds the values entering the called fn.
    # 6.6.5: extracted to `_simd_arg_second_pass`, shared with the method-call path.
    _simd_arg_second_pass(S, &_fc_simd_table, _fc_simd_count);
    var foff = L64(_fnt_offsets + fi * 8);
    if (foff >= 0) {
        ECALLTO(S, foff);
    } else {
        ECALLFIX(S, fi);
    }
    ECALLCLEAN(S, _fc_int_argc);
    # v6.4.56 D3 — a call result's type is i64, not its LAST argument's expr-type
    # (which the arg parse leaked). Normalize so an outer op on the call result
    # doesn't mis-see it as f64. (Also the D1 seam: a scalar-f64-returning callee
    # is re-tagged F64_TYID at the call site in parse_expr after this returns.)
    SESTYPE(S, 0);
    return 0;
}

# Parse: impl TraitName for TypeName { fn method(self) { } ... }
# Methods get mangled to TypeName_method (trait name is documentation only for now)
fn PARSE_IMPL(S): i64 {
    # v6.6.4: a marker live here can only be STALE — `public impl` is consumed un-armed by
    # _TL_VIS, and a per-method `public fn` re-arms inside the loop below. Pass 2's `var` skip
    # never consumes, so `public var V = 7;` followed by an impl block re-exposed its FIRST
    # method.
    # ⛔ 6.6.5: that sentence used to end "(the only definition class stamped in pass 2 only)",
    # and pass 1 DID brace-skip impl bodies. It does not any more — `_prescan_impl` registers
    # and stamps every method in pass 1, which is what makes a forward `q.m()` / `Q_m(&q)` obey
    # `private` and get the right parameter ABI. See _prescan_impl. CHANGELOG [6.6.5]
    _pub_pending = 0;
    STI(S, GTI(S) + 1);  # consume IMPL
    # Parse trait name (skip for now — just used for documentation)
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    STI(S, GTI(S) + 1);  # consume trait name
    # Expect "for"
    if (PEEKT(S) != 55) { ERR_EXPECT(S, 55); }
    STI(S, GTI(S) + 1);  # consume FOR
    # Parse type name
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var type_noff = PEEKV(S);
    STI(S, GTI(S) + 1);  # consume type name
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);  # consume {
    # Parse methods inside the impl block
    # Temporarily set module to the type name so methods get mangled
    var saved_mod = GMOD(S);
    SMOD(S, type_noff);
    var igo = 1;
    while (igo == 1) {
        if (PEEKT(S) == 14) { igo = 0; }
        else {
            _impl_attrs(S, 1);         # 6.6.17: `#deprecated` / `#must_use` / ... on a method
            if (_TL_VIS(S) == 1) { }   # v6.5.0: `pub`/`public` on an impl method
            if (PEEKT(S) == 32) { PARSE_FN_DEF(S); }
            else { igo = 0; }
        }
    }
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);  # consume }
    SMOD(S, saved_mod);
    return 0;
}

# ⛔ 6.6.17 — DIRECTIVES IN AN impl BODY. Its loop took only `pub` and `fn`, so `#deprecated("..")`
# before a method was "expected '}', got unknown" (#must_use / #pure / #io / #alloc / #inline /
# #regalloc / #naked and #assert alike). They go through THE top-level dispatcher
# (`_tl_directive`): arm 1 in pass 2 arms an attribute for the method PARSE_FN_DEF parses next;
# arm 0 in pass 1 (`_prescan_impl_body`) consumes, and records a `#deprecated` for the method it
# registers, so a call parsed before the impl warns too.
fn _impl_attrs(S, arm): i64 {
    while (_tl_directive(S, arm) == 1) { }
    return 0;
}

# Skip generic parameters <T, U, ...> if present
# ⛔ 6.6.17: NESTED. It stopped at the first `>` and knew no `>>`, so `Vec<Box<i64>>` — whose
# tail the lexer makes ONE `>>` token — ran to the end of the file (`expected '=', got end of
# file`), and `Vec<Box<i64> >` left a `>` behind. See `_skip_targ_list`.
fn SKIP_GENERICS(S): i64 {
    if (PEEKT(S) == 19) { _skip_targ_list(S); }
    return 0;
}
# Cursor on a `<`: consume through the `>` that closes it, nested lists included (`>>` / `>>>`
# close two / three levels). Returns how many levels the last closer closed BEYOND this list — an
# enclosing type-argument list's `>` the lexer folded into the same token (`Box<Vec<i64>>`'s
# `>>`, seen from `Vec`), which the caller owes to `_consume_gt` (`_ta_pending_gt`).
# v6.5.19: EOF guard. `fn f<`, `struct S<`, `enum E<` truncated here span a loop whose only exit
# was `>`; this skipper emits no diagnostic, so `_had_error` stayed 0 and the v6.4.62 watchdog
# never ticked — cycc HUNG outright. See _wd_eof_tick (src/common/util.cyr) and CVE-39.
fn _skip_targ_list(S): i64 {
    var d = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { return 0; }
        if (t == 19) { d = d + 1; }
        elif (t == 20) { d = d - 1; }
        elif (t == 39) { d = d - 2; }
        elif (t == 152) { d = d - 3; }
        STI(S, GTI(S) + 1);
        if (d <= 0) { go = 0; }
    }
    return 0 - d;
}

# v6.3.9 (F-fns): capture a generic param list `<T, U>` at a fn signature, returning
# the names PACKED as (off0+1) | ((off1+1) << 32) (0 = no `<...>`). Consumes EXACTLY
# the tokens SKIP_GENERICS would (`<` through `>`), so the cursor advances identically.
# Default path (_MONOMORPH_OK == 0): delegates to SKIP_GENERICS verbatim and returns 0
# — byte-identical to the pre-v6.3.9 skip. Only ≤2 params are captured (the inline
# replay's pc≤2 ceiling); extra params are consumed but not recorded.
fn _capture_tparams(S): i64 {
    if (_MONOMORPH_OK == 0) { SKIP_GENERICS(S); return 0; }
    if (PEEKT(S) != 19) { return 0; }
    STI(S, GTI(S) + 1);  # consume <
    var off0 = 0;
    var off1 = 0;
    var n = 0;
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) == 20) { go = 0; }
        # v6.5.19: EOF guard — the monomorph twin of SKIP_GENERICS above, same hang.
        # It must consume EXACTLY what SKIP_GENERICS does (see the comment on this fn),
        # so the two guards have to stay in lockstep.
        elif (PEEKT(S) == 12) { go = 0; }
        else {
            if (PEEKT(S) == 2) {
                if (n == 0) { off0 = PEEKV(S) + 1; }
                if (n == 1) { off1 = PEEKV(S) + 1; }
                n = n + 1;
            }
            STI(S, GTI(S) + 1);
        }
    }
    STI(S, GTI(S) + 1);  # consume >
    return off0 | (off1 << 32);
}

# v6.3.9 (F-fns): infer the CANONICAL concrete-type token of the arg expression at
# the current cursor, WITHOUT consuming it. Encoding matches _tp_resolve: >0 struct
# sid, <0 -scalarwidth. `IDENT(` → callee GFRS (whose >0-sid / <0-width encoding is
# already canonical); a struct local (GLTYPE = -sid) → +sid; everything else (plain
# int, literal, complex expr) → i64 (-8). Narrow-scalar args infer as i64 — explicit
# `foo<i32>(x)` (the wired-up call form) pins those precisely.
fn _infer_conc_at_cursor(S): i64 {
    if (PEEKT(S) == 2) {
        var _ic_noff = PEEKV(S);
        if (TOKTYP(S, GTI(S) + 1) == 10) {
            var _ic_fi = FINDFN(S, _ic_noff);
            if (_ic_fi >= 0) {
                var _ic_ret = GFRS(S, _ic_fi);
                if (_ic_ret != 0) { return _ic_ret; }
            }
        } else {
            var _ic_lli = FINDLOCAL(S, _ic_noff);
            if (_ic_lli >= 0) {
                var _ic_lt = GLTYPE(S, _ic_lli);
                # 6.6.10: a vector local's SLTYPE is a descriptor sentinel (<= -2048), not a
                # struct id — it read as "struct 2093". Vectors are not type arguments.
                if (_ic_lt <= 0 - 2048) { return 0 - 8; }
                if (_is_ptr_param(S, _ic_lli) == 1) { return 0 - 8; }   # 6.6.10: `pp: *Pt` is a pointer
                if (_ic_lt < 0) { return 0 - _ic_lt; }
                return 0 - 8;
            }
            return _infer_conc_global(S, _ic_noff);
        }
    }
    return 0 - 8;
}
# 6.6.10 (bite 7 review): a `pp: *Pt` parameter. The parameter loop skips the `*`, so the slot is
# typed `Pt` like a by-value one and `pp.x` works — but it is a POINTER, and a `var q: *Pt` local
# (not struct-typed at all) infers i64, so `f(pp)` does too. It used to instantiate `f$Pt`.
# 6.6.16 (C7): the `*` is seen before the slot exists, so this only marks the slot to come;
# `_param_record` writes it onto the slot itself. It was a 64-bit mask by slot index, blind at
# slot >= 64, where a pointer then read as a by-value struct and was copied in. CHANGELOG [6.6.16]
fn _mark_ptr_param(S): i64 {
    _cur_fn_ptrp = GFLC(S) + 1;
    # 6.6.17: and its step, sizeof(T), as a mark on the slot the parameter takes next — read only
    # behind the slot's bit 56, which `_param_record` sets (see `_sl_marks`). Cursor on T; an
    # unknown T is refused by `_tn_param_check`, so this is quiet. `**T` steps a pointer's 8.
    var ps = 8;
    if (PEEKT(S) != 8) { ps = _ptr_step_peek(S, 0 - 1, 1); }
    SSLICE_W(S, GFLC(S), 0 - 0x7E00 - ps);
    return 0;
}
# 6.6.16 (C7) — an int-class parameter's slot facts, once its SLTYPE is set: an `async fn` refuses
# a struct by value (it reads the pending `*` mark, so first); a struct of 8 B or less is inline
# (MARK_SMALL_STRUCT); a `*T` is marked on its own slot — LAST, because MARK_SMALL_STRUCT's SLAGG
# rewrites the word's high half. One call from the parameter loop. CHANGELOG [6.6.16]
# ⛔ 6.6.17 (a2) — only a BY-VALUE struct parameter is a small struct. A `p: *T` is always an 8-byte
# pointer, whatever T's size; marking it inline when T was 8 B or less made `p.v` read and write
# the pointer's own slot (the caller's struct never moved). CHANGELOG [6.6.17]
fn _param_record(S, li, pnoff, is_async): i64 {
    if (is_async == 1) { _refuse_async_struct_param(S, li, pnoff); }
    if (_cur_fn_ptrp != li + 1) { MARK_SMALL_STRUCT(S, li, GLTYPE(S, li)); }
    if (_cur_fn_ptrp == li + 1) { SLPTRP(S, li); }
    _cur_fn_ptrp = 0;
    return 0;
}
# ⛔ 6.6.17 (a9) — an f64 / f32 parameter's slot tag, and the same tag for the INLINE replay. The
# replay re-registers a parameter by name with the type GFIPT recorded, which carried vector
# descriptors only, so an inlined `x: f64` was an untyped word: `#inline fn d(x: f64) { return x
# + x; }` added 1.5's bits as integers, and so did every one-statement generic instance at T = f64
# (`x: T` was untyped there too, see the parameter loop). Field `0x8001` / `0x8002` in the pack is
# f64 / f32 (`_ipt_sltype`); a vector's field is its descriptor + 1 (<= 256). CHANGELOG [6.6.17]
fn _param_float(S, li, pc, flt, pack): i64 {
    if (flt == 0) { return pack; }
    SLTYPE(S, li, flt);
    var f = 0x8001;
    if (flt == F32_TYID) { f = 0x8002; }
    if (pc == 0) { return pack | f; }
    if (pc == 1) { return pack | (f << 16); }
    return pack;
}
fn _is_ptr_param(S, li): i64 {
    if (li < 0) { return 0; }
    if (li >= _cur_fn_pslots) { return 0; }
    return GLPTRP(S, li);
}
# 6.6.10: a struct GLOBAL argument binds its struct like a struct local does. GVTYPE alone is
# ambiguous (a narrow scalar global stores its WIDTH there, 1..7); a struct global is the one
# with a recorded layout mode (GVPM 1 or 2, 6.6.5). A PEEK: `_findvar_core`, not FINDVAR, whose
# visibility report belongs to the argument's own parse.
fn _infer_conc_global(S, noff): i64 {
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0 - 8; }
    if (GVPM(S, vi) == 0) { return 0 - 8; }
    var t = GVTYPE(S, vi);
    if (t > 0) { return t; }
    return 0 - 8;
}

# v6.3.9 (F-fns): populate the active T->concrete binding for a generic call.
# Unpacks the callee's packed tparam names (GFTP) and binds tparam i <- inf_i (the
# positional inference: param_i is type tparam_i). Caller _tp_clear()s after the
# instantiation/replay. No-op when the callee has no tparams.
fn _bind_generic_call(S, fi, inf0, inf1): i64 {
    var _bg = GFTP(S, fi);
    if (_bg == 0) { return 0; }
    var _bg0 = _bg & 0xFFFFFFFF;
    if (_bg0 != 0) { _tp_bind(S, 0, _bg0 - 1, inf0); }
    var _bg1 = (_bg >> 32) & 0xFFFFFFFF;
    if (_bg1 != 0) { _tp_bind(S, 1, _bg1 - 1, inf1); }
    return 0;
}

# ⛔ 6.6.17 (a3) — the binding an INLINE replay of generic fn `fi` runs under. An instance
# (`szof$i16`, `sv$i8`) is a separate fn whose body tokens are the base's, so its replay must bind
# T to the instance's OWN type arguments (recorded at instantiation, `SFIC`); it bound the call's
# inferred ones, which an explicit `f<i16>(..)` never sets (-8, i64). A one-statement generic
# body is inlinable, so `return sizeof(T);` read 8 and `var y: T` was an i64 whenever the call
# sat inside a fn — and a generic forwarding its T (`return sv<T>(x);`) lost it. CHANGELOG [6.6.17]
fn _bind_inl_generic(S, fi, inf0, inf1): i64 {
    var c0 = GFIC(S, fi, 0);
    if (c0 != 0) { return _bind_generic_call(S, fi, c0, GFIC(S, fi, 1)); }
    return _bind_generic_call(S, fi, inf0, inf1);
}

# v6.3.9 (F-fns): is `noff` one of fn `fi`'s captured type-params? Used at the
# definition to accept a `: T` return type (T isn't a concrete type, but it IS a
# valid generic return) instead of erroring.
fn _is_tparam_of(S, fi, noff): i64 {
    var _it = GFTP(S, fi);
    if (_it == 0) { return 0; }
    var _it0 = _it & 0xFFFFFFFF;
    if (_it0 != 0) { if (noff == _it0 - 1) { return 1; } }
    var _it1 = (_it >> 32) & 0xFFFFFFFF;
    if (_it1 != 0) { if (noff == _it1 - 1) { return 1; } }
    return 0;
}

# v6.5.69 — does this fn body contain an `await`? Token lookahead over the body's brace
# span, restoring the cursor. Same shape as `_body_has_defer` below.
#
# ⛔ THIS SELECTOR IS LOAD-BEARING, NOT AN OPTIMISATION. The coroutine transform moves a
# body's locals into a heap frame and treats parameter 0 as the frame base. Applying it to
# EVERY `async fn` would break the ones that already work: `tests/fixtures/async/
# async_closure_generic.cyr` has `async fn compute(n)` whose body contains no `await` at all
# — it is awaited by its CALLER — so its parameter `n` would be read as a frame pointer.
# An `async fn` with no suspend point in its body keeps exactly the v6.3.11
# deferred-then-forced semantics it has today.
# v6.5.70 — the same question asked from the SIGNATURE rather than the body: scan forward to
# the body's opening brace, then over its span. Needed because a coroutine must reserve stack
# slot 0 for its frame base BEFORE its parameters are allocated slots, and the parameters are
# parsed first.
fn _fn_body_has_await_ahead(S): i64 {
    var _sv = GTI(S);
    var _g = 0;
    while (PEEKT(S) != 13) {
        if (PEEKT(S) == 12) { STI(S, _sv); return 0; }
        if (_g > 8192) { STI(S, _sv); return 0; }
        STI(S, GTI(S) + 1);
        _g = _g + 1;
    }
    STI(S, GTI(S) + 1);
    var _r = _body_has_await(S);
    STI(S, _sv);
    return _r;
}

fn _body_has_await(S): i64 {
    var _sv = GTI(S);
    var _bd = 1;
    var _found = 0;
    while (_bd > 0) {
        var _t = PEEKT(S);
        if (_t == 12) { _bd = 0; }                   # EOF guard
        elif (_t == 13) { _bd = _bd + 1; STI(S, GTI(S) + 1); }
        elif (_t == 14) { _bd = _bd - 1; STI(S, GTI(S) + 1); }
        elif (_t == 135) { _found = 1; STI(S, GTI(S) + 1); }
        else { STI(S, GTI(S) + 1); }
    }
    STI(S, _sv);
    return _found;
}

# 6.6.7 — does the fn body starting at the cursor (just past its `{`) contain a `defer` (106)
# or a `secret var` (108) ANYWHERE? Decides that its `return f(..);` never tail-calls
# (`_tc_frame_divert`). ⚠ Lexical over the whole brace range, so a defer inside a nested closure
# literal counts too — that costs the enclosing fn its tail calls, never correctness.
fn _body_has_defer(S): i64 {
    var i = GTI(S);
    var n = GTCNT(S);
    var bd = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0; }                   # EOF guard
        if (t == 13) { bd = bd + 1; }
        if (t == 14) { bd = bd - 1; if (bd == 0) { return 0; } }
        if (t == 106 || t == 108) { return 1; }
        i = i + 1;
    }
    return 0;
}

# ⛔ 6.6.10 — A GENERIC THAT USES T AS A STRUCT HAS NO SCALAR INSTANCE, AND EVERY CALL SITE HAS TO
# KNOW IT. `fn g<T>(p: T) { .. p.y .. }` has no valid i64 form, so its base (the i64 instance) is
# emitted as a `rax = 0` dead stub (v6.3.39 B3). That decision was made only WHILE the base was
# being emitted and recorded nowhere, so `g<i64>(5)`, `g(5)`, `return g(5);`, `outer<i64>(5)`
# forwarding to it, and `&g` all reached the stub and returned 0 with no diagnostic — and a body
# small enough to inline gave a misleading "no struct type in scope for 'p'" instead.
#
# The facts are now recorded per fn (GFGM, util.cyr) in PASS 1, BY NAME over the tokens, so a call
# preceding the definition asks the same question as one following it:
#   _gen_record  a generic's T-typed parameters (and which parameter carries each type parameter,
#                for inference) plus whether a T-typed name — a parameter OR a `var x: T` local —
#                is used as a struct (`x.f`; `x..y` is a range, not a field).
#   _gen_close   the transitive half: a generic that forwards a T-typed value (`g(p)`) or T itself
#                (`g<T>(p)`) into a generic with a stub base has a stub base too. Iterated to a
#                fixpoint, so the order the two are defined in does not matter.
# ⚠ The scan is lexical and so approximate. It can only err toward MORE stubs, and a stub is
# refused loudly at every scalar call — never the other way round, which was the silent bug.
# CHANGELOG [6.6.10]
var _gsn = 0;           # the T-typed names of the fn being scanned (params, then `var x: T`)
var _gsn_n = 0;
var _gs_at = 0;         # _gs_params: the token just past the parameter list
var _gm_gen = 0;        # bumped on every record, so the closure below knows to recompute
var _gm_closed = 0 - 1;

fn _gsn_add(noff): i64 {
    if (_gsn == 0) { _gsn = alloc(64 * 8); }
    if (_gsn_n < 64) { store64(_gsn + _gsn_n * 8, noff); _gsn_n = _gsn_n + 1; }
    return 0;
}
fn _gsn_has(noff): i64 {
    var i = 0;
    while (i < _gsn_n) {
        if (load64(_gsn + i * 8) == noff) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The parameter list at token `open` (its `(`): collect the T-typed parameter names and return the
# 1-based index of the first parameter carrying each type parameter, packed as GFGM bits 8-23.
fn _gs_params(S, fi, open): i64 {
    _gsn_n = 0;
    var i = open + 1;
    var n = GTCNT(S);
    var pk = 0;
    var pc = 0;
    var d = 0;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { break; }
        if (d == 0) {
            if (t == 11) { i = i + 1; break; }
            if (t == 31) { pc = pc + 1; }
            if (t == 2) { pk = _gs_param(S, fi, i, pc, pk); }
        }
        if (t == 10 || t == 19 || t == 28) { d = d + 1; }
        if (t == 11 || t == 20 || t == 29) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d < 0) { d = 0; }
        i = i + 1;
    }
    _gs_at = i;
    return pk;
}
# One `name: [*]Type` parameter at token i (parameter index pc).
fn _gs_param(S, fi, i, pc, pk): i64 {
    if (TOKTYP(S, i + 1) != 49) { return pk; }
    var ti = i + 2;
    if (TOKTYP(S, ti) == 8) { ti = ti + 1; }
    if (TOKTYP(S, ti) != 2) { return pk; }
    if (pc > 254) { return pk; }
    var tp = GFTP(S, fi);
    var tn = TOKVAL(S, ti);
    if (tn == (tp & 0xFFFFFFFF) - 1) {
        _gsn_add(TOKVAL(S, i));
        if ((pk & 0xFF00) == 0) { pk = pk | ((pc + 1) << 8); }
    }
    if (tn == ((tp >> 32) & 0xFFFFFFFF) - 1) {
        _gsn_add(TOKVAL(S, i));
        if ((pk & 0xFF0000) == 0) { pk = pk | ((pc + 1) << 16); }
    }
    return pk;
}
# From token i (past the parameter list) to the token after the body's `{`, or -1 (no body).
fn _gs_body_open(S, i): i64 {
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 13) { return i + 1; }
        if (t == 12 || t == 5) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
# Walk the body from token i (just past its `{`) to the matching `}`. mode 0: 1 iff a T-typed name
# is used as a struct. mode 1: 1 iff the body forwards a T-typed value, or T, to a stub generic.
fn _gs_scan(S, fi, i, mode): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0; }
        if (t == 13) { d = d + 1; }
        if (t == 14) { d = d - 1; if (d == 0) { return 0; } }
        if (t == 3) { _gs_var(S, fi, i); }
        if (t == 2) { if (_gs_use(S, fi, i, mode) == 1) { return 1; } }
        i = i + 1;
    }
    return 0;
}
# `var x: T` / `var x: *T` at token i: x is T-typed from here on.
fn _gs_var(S, fi, i): i64 {
    if (TOKTYP(S, i + 1) != 2) { return 0; }
    if (TOKTYP(S, i + 2) != 49) { return 0; }
    var ti = i + 3;
    if (TOKTYP(S, ti) == 8) { ti = ti + 1; }
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (_is_tparam_of(S, fi, TOKVAL(S, ti)) == 1) { _gsn_add(TOKVAL(S, i + 1)); }
    return 0;
}
fn _gs_use(S, fi, i, mode): i64 {
    var nx = TOKTYP(S, i + 1);
    if (mode == 0) {
        if (nx != 41) { return 0; }
        if (TOKTYP(S, i + 2) == 41) { return 0; }
        return _gsn_has(TOKVAL(S, i));
    }
    if (nx != 19 && nx != 10) { return 0; }
    var cfi = FINDFN(S, TOKVAL(S, i));
    if (cfi < 0 || cfi == fi) { return 0; }
    if (GFTP(S, cfi) == 0) { return 0; }
    if ((GFGM(S, cfi) & 3) == 0) { return 0; }
    if (nx == 19) { return _gs_targs_fwd(S, fi, i + 2); }
    var m = GFGM(S, cfi);
    if (_gs_arg_named(S, i + 1, (m >> 8) & 255) == 1) { return 1; }
    return _gs_arg_named(S, i + 1, (m >> 16) & 255);
}
# `callee<...>(`: 1 iff a type argument names one of fi's own type parameters.
fn _gs_targs_fwd(S, fi, j): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 12 || t == 10 || t == 5) { return 0; }
        if (t == 2) { if (_is_tparam_of(S, fi, TOKVAL(S, j)) == 1) { return 1; } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return 0; }
        j = j + 1;
    }
    return 0;
}
# 1 iff argument k-1 (k is 1-based; 0 = none) of the call whose `(` is at `open` is a bare
# T-typed name.
fn _gs_arg_named(S, open, k): i64 {
    if (k == 0) { return 0; }
    var a = _call_arg_start(S, open, k - 1);
    if (a < 0) { return 0; }
    if (TOKTYP(S, a) != 2) { return 0; }
    var nt = TOKTYP(S, a + 1);
    if (nt != 31 && nt != 11) { return 0; }
    return _gsn_has(TOKVAL(S, a));
}
# The first token of argument k (0-based) of the call whose `(` is at `open`, or -1.
fn _call_arg_start(S, open, k): i64 {
    var i = open + 1;
    if (TOKTYP(S, i) == 11) { return 0 - 1; }
    if (k == 0) { return i; }
    var n = GTCNT(S);
    var d = 0;
    var c = 0;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0 - 1; }
        if (t == 10 || t == 28 || t == 13) { d = d + 1; }
        if (t == 11 || t == 29 || t == 14) {
            if (d == 0) { return 0 - 1; }
            d = d - 1;
        }
        if (d == 0) {
            if (t == 31) { c = c + 1; if (c == k) { return i + 1; } }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# Pass 1 (`_prescan_fn_sig`, cursor on the `(`): record fi's GFGM word. Also the lazy path for a
# definition pass 1 never saw.
fn _gen_record(S, fi, open): i64 {
    var pk = _gs_params(S, fi, open);
    var b = _gs_body_open(S, _gs_at);
    var d = 0;
    if (b >= 0) { d = _gs_scan(S, fi, b, 0); }
    SFGM(S, fi, pk | 4 | d);
    _gm_gen = _gm_gen + 1;
    return 0;
}
# The `(` of fi's definition, from its recorded def-start.
fn _gen_def_open(S, fi): i64 {
    var i = GFDS(S, fi) - 1;
    if (i < 0) { return 0 - 1; }
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 10) { return i; }
        if (t == 12 || t == 13) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}
fn _gen_forwards(S, fi): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    _gs_params(S, fi, o);
    var b = _gs_body_open(S, _gs_at);
    if (b < 0) { return 0; }
    return _gs_scan(S, fi, b, 1);
}
fn _gen_close(S): i64 {
    if (_gm_closed == _gm_gen) { return 0; }
    var ch = 1;
    while (ch == 1) {
        ch = 0;
        var fi = 0;
        var n = GFNC(S);
        while (fi < n) {
            var m = GFGM(S, fi);
            if ((m & 7) == 4) {
                if (_gen_forwards(S, fi) == 1) { SFGM(S, fi, m | 2); ch = 1; }
            }
            fi = fi + 1;
        }
    }
    _gm_closed = _gm_gen;
    return 0;
}
# 1 iff fi's name is a minted instance (`base$Pt`): '$' is never a source identifier byte.
fn _gen_is_inst(S, fi): i64 {
    var p = S + 0xEC00000 + L64(_fnt_names + fi * 8);
    var i = 0;
    while (load8(p + i) != 0) {
        if (load8(p + i) == 36) { return 1; }
        i = i + 1;
    }
    return 0;
}
# Nonzero iff fi is a generic whose base (every scalar binding) is the dead stub: 1 direct,
# 2 transitive. An instance is never a stub.
fn _gen_stub(S, fi): i64 {
    if (fi < 0) { return 0; }
    if (GFTP(S, fi) == 0) { return 0; }
    if ((GFGM(S, fi) & 4) == 0) {
        if (_gen_is_inst(S, fi) == 1) { return 0; }
        var o = _gen_def_open(S, fi);
        if (o >= 0) { _gen_record(S, fi, o); }
    }
    _gen_close(S);
    return GFGM(S, fi) & 3;
}
# The refusal, by name, for a scalar call / type argument / address of a stub generic.
fn _refuse_gen_stub(S, noff): i64 {
    ERR_IDENT(S, "generic ", noff, " has no i64 (or other scalar) instance: it uses its type parameter as a struct (a '.field' on a T-typed value, directly or in a generic it forwards T to) — pass a struct argument, or name a struct type argument", 0 - 1);
    return 0;
}
# `&g`: the address is the base's, so a stub base is refused like a scalar call.
fn _gen_addr_check(S, fi, noff): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, noff); }
    return 0;
}

# Infer the concrete type of type parameter `which` (0|1) for a call to generic fi whose `(` is
# at token `open`, from the argument in the parameter position that carries it. A generic pass 1
# never recorded binds positionally, as before. No carrying parameter -> i64.
fn _gen_infer_tp(S, fi, open, which): i64 {
    var m = GFGM(S, fi);
    var k = which + 1;
    if ((m & 4) != 0) { k = (m >> (8 + which * 8)) & 255; }
    if (k == 0) { return 0 - 8; }
    var a = _call_arg_start(S, open, k - 1);
    if (a < 0) { return 0 - 8; }
    if (_gen_arg_whole(S, a) == 0) { return 0 - 8; }
    var sv = GTI(S);
    STI(S, a);
    var c = _infer_conc_at_cursor(S);
    STI(S, sv);
    return c;
}
# ⛔ 6.6.10 (bite 7 review) — only a WHOLE argument binds a type parameter: a bare name (next
# token `,` / `)`) or one whole call. The first cut read the argument's first token, so `f(p.y)`,
# `f(p.x + p.y)` and `f(p + 1)` all bound T to `Pt` and instantiated `f$Pt`, whose `v + 1` then
# needed an undefined `Pt_add` — programs 6.6.9 compiled and ran. Anything else infers i64.
fn _gen_arg_whole(S, a): i64 {
    if (TOKTYP(S, a) != 2) { return 1; }
    var nt = TOKTYP(S, a + 1);
    if (nt == 31 || nt == 11) { return 1; }
    if (nt == 10) { return _call_is_whole_arg(S, a); }
    return 0;
}
# ⛔ 6.6.10 — PARSE_FNCALL's head, for a call to a GENERIC (cursor just past its `(`). Struct
# inference used to exist only inside the inline replay, positionally, where `_inl_bind_param`
# then re-applied the base's i64 param type — so `var r = g(p)` with `p: Pt` ran the dead stub
# (0), `return g(p)` too, `g(2, p)` bound T from the `2`, and an inlinable body said "no struct
# type in scope for 'p'". Now an argument that infers a struct instantiates `g$Pt` exactly as
# `g<Pt>(p)` does, and a scalar call of a stub generic is refused by name. An explicit call
# (`_ta_explicit`) has already chosen its callee and is not re-inferred. Returns the fi to call.
# CHANGELOG [6.6.10]
fn _gen_call_head(S, fi, noff): i64 {
    _gh_inf0 = 0 - 8;
    _gh_inf1 = 0 - 8;
    var ex = _ta_explicit;
    _ta_explicit = 0;
    if (_MONOMORPH_OK == 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    if (ex == 0) {
        var open = GTI(S) - 1;
        var c0 = _gen_infer_tp(S, fi, open, 0);
        var c1 = _gen_infer_tp(S, fi, open, 1);
        if (c0 > 0 || c1 > 0) { return _gen_call_struct(S, fi, noff, c0, c1); }
        _gh_inf0 = c0;
        _gh_inf1 = c1;
    }
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, noff); }
    return fi;
}
fn _gen_call_struct(S, fi, noff, c0, c1): i64 {
    if (((GFTP(S, fi) >> 32) & 0xFFFFFFFF) == 0) { c1 = 0; }
    var spec = _instantiate_generic_fn(S, fi, c0, c1);
    if (spec >= 0) { return spec; }
    _refuse_gen_inst(S, noff, spec);
    return fi;
}
fn _refuse_gen_inst(S, noff, spec): i64 {
    if (spec == 0 - 3) {
        ERR_IDENT(S, "generic ", noff, ": a STRUCT type-argument (inferred or explicit) alongside a second type argument is unsupported — only a generic with ONE type parameter takes a struct", 0 - 1);
    } else {
        ERR_IDENT(S, "generic ", noff, ": no definition to instantiate for a struct type argument", 0 - 1);
    }
    return 0;
}
# 6.6.10 — THE FN A CALL AT TOKEN ti (`name(` / `name<..>(`) ACTUALLY REACHES: a generic's
# instance for explicit non-i64 type arguments or an argument that infers a struct, else FINDFN's
# entry. For the call paths that emit their OWN call instead of going through PARSE_FNCALL (the
# struct receives in PARSE_VAR, `_struct_call_into_temp`) and for their lookaheads, which all
# FINDFN'd the base: `var r: Box<Pt> = mk<Pt>(p)` was sized from the base's return and then
# CALLED the base with T = i64. Instantiates when needed; FINDFN is the dedup index, so the call
# itself then finds the same instance. A stub generic with scalar type arguments resolves to its
# base — the emitting path refuses it (`_gen_own_call_check`).
fn _gen_resolve_call(S, ti): i64 {
    _grc_err = 0;
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return fi; }
    if (_MONOMORPH_OK == 0) { return fi; }
    if (GFTP(S, fi) == 0) { return fi; }
    var c0 = 0 - 8;
    var c1 = 0;
    if (TOKTYP(S, ti + 1) == 19) {
        # A list naming anything but a declared struct / plain scalar / bound type parameter is
        # left to the call's own parse, which reports it — once.
        if (_targs_resolvable(S, ti + 2) == 0) { return fi; }
        var sv = GTI(S);
        var sv_gt = _ta_pending_gt;
        _ta_pending_gt = 0;
        STI(S, ti + 2);
        c0 = _parse_one_type_arg(S);
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); c1 = _parse_one_type_arg(S); }
        _ta_pending_gt = sv_gt;
        STI(S, sv);
        if (c0 <= 0 && c1 <= 0) {
            if (_gen_stub(S, fi) != 0) { return fi; }
            if (c0 == 0 - 8 && (c1 == 0 || c1 == 0 - 8)) { return fi; }
        }
    } else {
        c0 = _gen_infer_tp(S, fi, ti + 1, 0);
        c1 = _gen_infer_tp(S, fi, ti + 1, 1);
        if (c0 <= 0 && c1 <= 0) { return fi; }
        if (((GFTP(S, fi) >> 32) & 0xFFFFFFFF) == 0) { c1 = 0; }
    }
    var spec = _instantiate_generic_fn(S, fi, c0, c1);
    if (spec >= 0) { return spec; }
    # ⛔ 6.6.10 (bite 7 review): the base is NOT this call's callee — `var r = mk2(p, 1)` then ran it
    # with T = i64, silently. Recorded, and refused by the emitting path (`_gen_own_call_check`).
    _grc_err = spec;
    _grc_fi = fi;
    return fi;
}
# The `(` of the call at token ti — `name(`, or an explicit generic `name<..>(` whose type-argument
# list resolves (an unresolvable one is left to the call's own parse, which reports it) — or -1.
# 6.6.10: the paths that emit their OWN struct-valued call took only `name(`, so `r = mk<Pt>(p)`,
# `return mkw<Pt>(p)` and `gs(idp<i32>(4))` fell to a scalar value path.
fn _gcall_open(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0 - 1; }
    var nt = TOKTYP(S, ti + 1);
    if (nt == 10) { return ti + 1; }
    if (nt != 19) { return 0 - 1; }
    if (_MONOMORPH_OK == 0) { return 0 - 1; }
    var fi = FINDFN(S, TOKVAL(S, ti));
    if (fi < 0) { return 0 - 1; }
    if (GFTP(S, fi) == 0) { return 0 - 1; }
    if (_targs_resolvable(S, ti + 2) == 0) { return 0 - 1; }
    var e = _targs_end(S, ti + 2);
    if (TOKTYP(S, e + 1) != 10) { return 0 - 1; }
    return e + 1;
}
# The token closing the type-argument list that starts at token i (`>`, or a `>>` / `>>>` tail).
fn _targs_end(S, i): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return i; }
        i = i + 1;
    }
    return n;
}
# Does every name in the type-argument list starting at token i resolve — a declared struct, a
# plain scalar, or a type parameter bound right now? (A lookahead that parsed an unresolvable
# list would report its error a second time when the call itself is parsed.)
fn _targs_resolvable(S, i): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12 || t == 13 || t == 5 || t == 10) { return 0; }
        if (t == 2) { if (_targ_name_ok(S, TOKVAL(S, i)) == 0) { return 0; } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return 1; }
        i = i + 1;
    }
    return 0;
}
# 6.6.16 (C8): the lookup is the one type-name resolver's; the subset is unchanged — a struct,
# i8..i64 or f64 (what _type_arg_leaf instantiates), or a bound type parameter.
fn _targ_name_ok(S, noff): i64 {
    if (_tp_c0 != 0) { if (_tp_resolve(S, noff) != 0) { return 1; } }
    var c = _tn_resolve(S, noff);
    var k = _tn_class(c);
    if (k == 6 || k == 1) { return 1; }
    if (k == 3) { if (_tn_val(c) == 8) { return 1; } }
    return 0;
}
# The refusal for a path that emits its own call to a stub generic's base.
fn _gen_own_call_check(S, fi, noff): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (_grc_err < 0) { if (_grc_fi == fi) {
            var e = _grc_err;
            _grc_err = 0;
            _refuse_gen_inst(S, noff, e);
            return 0;
        } }
    if (_gen_stub(S, fi) != 0) { _refuse_gen_stub(S, noff); }
    return 0;
}
# The tail path (`return g(..);`) must take PARSE_FNCALL for a generic callee that the head would
# redirect or refuse: a stub base, or an argument that infers a struct. ⚠ ONLY those — diverting
# every generic cost a scalar generic its tail call (a 20,000,000-deep `cnt<T>` then SIGSEGV'd).
fn _tc_generic_divert(S, cfi, ti_after): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (cfi < 0) { return 0; }
    if (GFTP(S, cfi) == 0) { return 0; }
    if (_gen_stub(S, cfi) != 0) { return 1; }
    if (_gen_infer_tp(S, cfi, ti_after, 0) > 0) { return 1; }
    if (_gen_infer_tp(S, cfi, ti_after, 1) > 0) { return 1; }
    return 0;
}

# v6.3.10 (instantiate-once): mint a deduped specialized name `base$<tyname>` into
# tok_names for a concrete-type token, returning its noff. '$' (36) is not a legal
# identifier byte, so the name is unforgeable from source. Scalar tokens → i8/i16/
# i32/i64; a struct sid (>0) → the struct's name.
# v6.3.33 (generics tail): append one concrete's name-fragment at name-pool offset
# `wp`, return the new wp. Scalar → `i8`/`i16`/`i32`/`i64`; a struct sid → the
# struct's (possibly-already-mangled, e.g. nested `Pair$i32`) name. Extracted so
# `_mint_generic_name` can append BOTH type-args for a multi-param generic.
fn _append_conc_name(S, wp, conc): i64 {
    if (conc < 0) {
        store8(S + 0xEC00000 + wp, 105); wp = wp + 1;   # 'i'
        if (conc == 0 - 8) { store8(S + 0xEC00000 + wp, 54); wp = wp + 1; store8(S + 0xEC00000 + wp, 52); wp = wp + 1; }
        elif (conc == 0 - 4) { store8(S + 0xEC00000 + wp, 51); wp = wp + 1; store8(S + 0xEC00000 + wp, 50); wp = wp + 1; }
        elif (conc == 0 - 2) { store8(S + 0xEC00000 + wp, 49); wp = wp + 1; store8(S + 0xEC00000 + wp, 54); wp = wp + 1; }
        elif (conc == 0 - 1) { store8(S + 0xEC00000 + wp, 56); wp = wp + 1; }
    } else {
        var snoff = L64(S + 0x1A6018 + (conc - 1) * 8);
        var j = 0;
        while (load8(S + 0xEC00000 + snoff + j) != 0) { store8(S + 0xEC00000 + wp, load8(S + 0xEC00000 + snoff + j)); wp = wp + 1; j = j + 1; }
    }
    return wp;
}

# v6.3.33: mint `Base$<conc0>` (single param) or `Base$<conc0>$<conc1>` (two distinct
# params, conc1 != 0). The two-fragment name keeps `Two<i64,i32>` and `Two<i64,i64>`
# distinct in the FINDFN/FINDSTRUCT dedup index. Single-param (conc1 == 0) mints the
# same name as before → byte-identical dedup for the existing single-param instances.
fn _mint_generic_name(S, base_noff, conc, conc1): i64 {
    var blen = 0;
    while (load8(S + 0xEC00000 + base_noff + blen) != 0) { blen = blen + 1; }
    NPOS_GUARD(S, blen + 80);
    var wp = GNPOS(S);
    var noff = wp;
    var i = 0;
    while (i < blen) { store8(S + 0xEC00000 + wp, load8(S + 0xEC00000 + base_noff + i)); wp = wp + 1; i = i + 1; }
    store8(S + 0xEC00000 + wp, 36); wp = wp + 1;   # '$'
    wp = _append_conc_name(S, wp, conc);
    if (conc1 != 0) {
        store8(S + 0xEC00000 + wp, 36); wp = wp + 1;   # '$'
        wp = _append_conc_name(S, wp, conc1);
    }
    store8(S + 0xEC00000 + wp, 0); wp = wp + 1;
    SNPOS(S, wp);
    return noff;
}

# v6.3.35 (root cause A): the inline instance below is emitted by re-invoking
# PARSE_FN_DEF, which RESETS the per-fn jump-target table (`0x19E000`) at fn start
# (`jump_target_count = 0`). Because the instance is emitted INLINE in the enclosing
# fn's code range, that reset wipes the ENCLOSING fn's recorded jump targets — so the
# enclosing fn's LASE (`IS_JUMP_TARGET`) then mis-eliminates a load that IS a branch
# join (dropping early returns, clobbering a live local, corrupting operands). Snapshot
# the enclosing targets before the inline emit and merge them back after, so the
# enclosing LASE sees BOTH the instance's targets (already emitted in-range) and its
# own. (jump_src / nop-run compaction needs no restore: the enclosing fn is always
# `_cur_fn_has_closure` here → frame-trim is skipped and no nop_runs are produced.)
fn _jt_snapshot(S): i64 {
    var n = L64(S + 0x19E000);
    var buf = alloc((n + 1) * 8);
    store64(buf, n);
    var i = 0;
    while (i < n) { store64(buf + 8 + i * 8, L64(S + 0x19E008 + i * 8)); i = i + 1; }
    return buf;
}
fn _jt_merge(S, buf): i64 {
    var saved = load64(buf);
    var cur = L64(S + 0x19E000);
    var i = 0;
    while (i < saved) {
        if (cur < 1023) { S64(S + 0x19E008 + cur * 8, load64(buf + 8 + i * 8)); cur = cur + 1; }
        i = i + 1;
    }
    S64(S + 0x19E000, cur);
    return 0;
}

# 6.6.7 — the per-fn COMPACTION tables (jump sources, NOP runs, switch tables, the fixup and
# whole-program watermarks). A generic instance re-enters PARSE_FN_DEF, which zeroes all of
# them for itself and leaves ITS values behind: its NOP runs (already harvested from its own
# range) then drove the ENCLOSING fn's compaction over the enclosing fn's bytes — a generic
# call in a fn whose instance the register picker touched SIGSEGV'd. Copy the counts and the
# live entries out before the instance and back after it. (The enclosing fn records no NOP
# run of its own afterwards — `_cur_fn_has_closure` skips its picker and frame-trim — so its
# tables only have to be what they were.) CHANGELOG [6.6.7]
fn _tab_copy(dst, src, n): i64 {
    var i = 0;
    while (i < n) { store64(dst + i * 8, load64(src + i * 8)); i = i + 1; }
    return 0;
}
fn _tab_cap(n, cap): i64 {
    if (n > cap) { return cap; }
    return n;
}
fn _fnst_tab_save(S): i64 {
    var b = alloc(48 + 1024 * 8 + 1024 * 16 + 256 * 16);
    store64(b, L64(S + 0x1A0000));
    store64(b + 8, L64(S + 0x1A2008));
    store64(b + 16, L64(S + 0x1AC800));
    store64(b + 24, L64(S + 0x1A6010));
    store64(b + 32, _wp_fn_js0);
    store64(b + 40, _wp_fn_sw0);
    _tab_copy(b + 48, S + 0x1A0008, _tab_cap(load64(b), 1024));
    _tab_copy(b + 48 + 8192, S + 0x1A2010, _tab_cap(load64(b + 8), 1024) * 2);
    _tab_copy(b + 48 + 8192 + 16384, S + 0x1AC808, _tab_cap(load64(b + 16), 256) * 2);
    return b;
}
fn _fnst_tab_restore(S, b): i64 {
    S64(S + 0x1A0000, load64(b));
    S64(S + 0x1A2008, load64(b + 8));
    S64(S + 0x1AC800, load64(b + 16));
    S64(S + 0x1A6010, load64(b + 24));
    _wp_fn_js0 = load64(b + 32);
    _wp_fn_sw0 = load64(b + 40);
    _tab_copy(S + 0x1A0008, b + 48, _tab_cap(load64(b), 1024));
    _tab_copy(S + 0x1A2010, b + 48 + 8192, _tab_cap(load64(b + 8), 1024) * 2);
    _tab_copy(S + 0x1AC808, b + 48 + 8192 + 16384, _tab_cap(load64(b + 16), 256) * 2);
    return 0;
}

# v6.3.10 (instantiate-once): emit a deduped, monomorphized instance of generic fn
# `base_fi` for concrete-type token `conc0` (and `conc1`). Mints `base$ty`; FINDFN is
# the dedup index (hit → return the existing fi). On a miss, emits the specialized
# body ONCE — closure-style (jump-over): save the enclosing fn's per-fn codegen +
# binding state, reset, bind `T→conc`, `EJMP0` over the instance, record its offset,
# `EFNPRO`/`ESUBRSP`, replay the base body tokens (`GFBS`..) with the binding active so
# the bite-4 consults substitute, patch returns + epilogue + frame, `EPATCH` the jump,
# restore. Returns the specialized fi, or -2 for the not-yet-handled pc>0 case (the
# caller errors). pc=0 only this bite (param re-emission is the follow-on).
fn _instantiate_generic_fn(S, base_fi, conc0, conc1): i64 {
    # v6.3.33/v6.3.39: a STRUCT-typed type-arg on a generic FN needs a monomorphized
    # struct-ABI (by-value struct params + struct-return rebound per instance). v6.3.39
    # (B3) enables the SINGLE-tparam case — `wrap<Point>` re-emits the body with T bound
    # to the struct sid, so `p` becomes a by-value struct param and `p.x` resolves; the
    # ABI is now sound (the v6.3.36 structmask address-passes >8B struct params and the
    # v6.3.39 le8 fix keeps <=8B struct locals coherent — a plain `fn wrap_point(p:
    # Point): i64` already works, and the instance emits equivalent code). The MULTI-
    # tparam struct combos (`Two<Point,i64>`, a struct as the 2nd type-arg) remain
    # unproven — still -3 so the caller HARD-ERRORS rather than silently miscompiling.
    if (conc0 > 0 && conc1 != 0) { return 0 - 3; }   # struct 1st + a 2nd type-arg
    if (conc1 > 0) { return 0 - 3; }                 # struct as the 2nd type-arg
    var base_noff = L64(_fnt_names + base_fi * 8);
    var mangled = _mint_generic_name(S, base_noff, conc0, conc1);
    var spec = FINDFN(S, mangled);
    if (spec >= 0) { return spec; }                 # dedup hit
    var defstart = GFDS(S, base_fi);
    if (defstart == 0) { return 0 - 2; }            # 0 = no recorded def-start
    defstart = defstart - 1;                        # stored +1 (token index 0 is valid)
    # --- save the ENCLOSING fn's state (the fn currently being emitted) ---
    # 6.6.7 — ALL of it, through the shared snapshot (parse.cyr `_fnst_save`) plus the
    # compaction tables. The hand-kept list here saved rp_vec by LENGTH while the nested
    # PARSE_FN_DEF truncated it to 0 (an early `return` before the first `f<T>()` fell
    # through on x86/PE and hung on aarch64), and it omitted the defer table (an enclosing
    # `defer` registered before the call was DROPPED) and `_fn_local_addr` (re-opening the
    # v6.5.14 dead-stack tail call through a laundered `&local`). CHANGELOG [6.6.7]
    var sv_flc = GFLC(S);
    var sv_ti = GTI(S);
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    var locsnap = _cl_save_locals(S, sv_flc);
    # --- jump over the instance, then re-invoke PARSE_FN_DEF on the BASE's verbatim
    # tokens with the name + concrete-type overrides. PARSE_FN_DEF re-parses the full
    # signature (params/masks/return) + body and emits the specialized fn with T bound
    # to the concretes — full fidelity (params, struct args, masks) for free. ---
    var jmp = EJMP0(S);
    var jt_snap = _jt_snapshot(S);   # v6.3.35: save enclosing fn's jump targets (PARSE_FN_DEF resets them)
    var tab = _fnst_tab_save(S);
    var st = _fnst_save(S);
    STI(S, defstart);
    _inst_name = mangled;
    _inst_base_fi = base_fi;
    _inst_conc0 = conc0;
    _inst_conc1 = conc1;
    var attrs = _attr_park();         # 6.6.17: a pending attribute is the next definition's
    PARSE_FN_DEF(S);
    _attr_unpark(attrs);
    _inst_name = 0;
    _inst_base_fi = 0 - 1;
    _inst_conc0 = 0;
    _inst_conc1 = 0;
    # --- restore the enclosing fn's state ---
    _fnst_restore(S, st);
    _fnst_tab_restore(S, tab);
    _jt_merge(S, jt_snap);           # v6.3.35: restore enclosing targets (alongside the instance's)
    EPATCH(S, jmp);
    # The instance is emitted INLINE in the enclosing fn's code range (jumped over),
    # so mark the enclosing fn to skip its regalloc byte-scan post-pass (it would
    # rewrite + corrupt the instance) — same guard closures use.
    _cur_fn_has_closure = 1;
    _cl_restore_locals(S, locsnap, sv_flc);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    STI(S, sv_ti);
    spec = FINDFN(S, mangled);                       # now registered by PARSE_FN_DEF
    _gen_inst_record(S, spec, base_fi, conc0, conc1);   # 6.6.17 (a3, a5)
    _gen_inherit_dep(S, spec, base_fi);              # 6.6.16: `#deprecated` reaches instances
    return spec;
}

# ⛔ 6.6.17 — A PENDING fn ATTRIBUTE BELONGS TO THE DEFINITION IT PRECEDES, NOT TO AN INSTANCE.
# The instance above is emitted by PARSE_FN_DEF itself, which consumed whatever `#must_use` /
# `#deprecated` / `#pure` / ... was armed: an attribute written before a top-level statement that
# instantiates `g<i32>` marked `g$i32` (deprecated — every call to it warned) and was gone by the
# `fn` it preceded (`#must_use` silent there). Parked around the instance and put back. The
# instance still inherits the BASE's own `#deprecated` (`_gen_inherit_dep`).
fn _attr_park(): i64 {
    var b = alloc(80);
    store64(b, _regalloc_pending);       _regalloc_pending = 0;
    store64(b + 8, _must_use_pending);   _must_use_pending = 0;
    store64(b + 16, _deprecated_pending); _deprecated_pending = 0;
    store64(b + 24, _deprecated_msg_pending); _deprecated_msg_pending = 0;
    store64(b + 32, _pure_pending);      _pure_pending = 0;
    store64(b + 40, _io_pending);        _io_pending = 0;
    store64(b + 48, _alloc_pending);     _alloc_pending = 0;
    store64(b + 56, _naked_pending);     _naked_pending = 0;
    store64(b + 64, _inline_pending);    _inline_pending = 0;
    store64(b + 72, _pub_pending);       _pub_pending = 0;
    return b;
}
fn _attr_unpark(b): i64 {
    _regalloc_pending = load64(b);
    _must_use_pending = load64(b + 8);
    _deprecated_pending = load64(b + 16);
    _deprecated_msg_pending = load64(b + 24);
    _pure_pending = load64(b + 32);
    _io_pending = load64(b + 40);
    _alloc_pending = load64(b + 48);
    _naked_pending = load64(b + 56);
    _inline_pending = load64(b + 64);
    _pub_pending = load64(b + 72);
    return 0;
}

# v6.3.10 (generic structs): instantiate `Box<conc>` → a deduped specialized struct.
# Mints `Box$ty`; FINDSTRUCT is the dedup index. On a miss, re-invokes PARSE_STRUCT_DEF
# on the base struct's verbatim tokens with the name + binding overrides so each `: T`
# field resolves to the concrete type via the field consult. No codegen (struct
# registration only) → far simpler than the fn instance: just save/restore the cursor
# + binding. Returns the 1-based instance sid, or 0 if `base_si` isn't a generic struct.
fn _instantiate_generic_struct(S, base_si, conc0, conc1): i64 {
    var base_noff = L64(S + 0x1A6018 + base_si * 8);
    var mangled = _mint_generic_name(S, base_noff, conc0, conc1);
    var existing = FINDSTRUCT(S, mangled);
    if (existing > 0) { return existing; }           # dedup hit (1-based)
    var ds = GSDS(S, base_si);
    if (ds == 0) { return 0; }                       # not a generic struct
    ds = ds - 1;
    var stp = GSTP(S, base_si);
    var sv_ti = GTI(S);
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    STI(S, ds);
    _inst_name = mangled;
    var t0 = stp & 0xFFFFFFFF;
    if (t0 != 0) { _tp_bind(S, 0, t0 - 1, conc0); }
    var t1 = (stp >> 32) & 0xFFFFFFFF;
    # v6.3.33: bind the SECOND type param to conc1 (was conc0 → collapsed distinct
    # params). Single-param structs have t1 == 0 → no bind → conc1 unused.
    if (t1 != 0) { _tp_bind(S, 1, t1 - 1, conc1); }
    PARSE_STRUCT_DEF(S);
    _inst_name = 0;
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    STI(S, sv_ti);
    return FINDSTRUCT(S, mangled);                   # 1-based instance sid
}

# v6.3.33: consume one type-arg-list `>` close. A `>` (token 20) closes one level. A
# `>>` (token 39, the right-shift lexeme) closes THIS level AND owes one `>` to the
# enclosing level (`_ta_pending_gt`), so `Box<Pair<i32>>`'s trailing `>>` closes both
# Pair's and Box's `<`. If a close is already owed, decrement it and consume nothing.
fn _consume_gt(S): i64 {
    if (_ta_pending_gt > 0) { _ta_pending_gt = _ta_pending_gt - 1; return 0; }
    var t = PEEKT(S);
    if (t == 20) { STI(S, GTI(S) + 1); return 0; }
    if (t == 152) { STI(S, GTI(S) + 1); _ta_pending_gt = 2; return 0; }   # `>>>` owes two
    if (t == 39) { STI(S, GTI(S) + 1); _ta_pending_gt = 1; return 0; }   # `>>`
    return 0;
}

# v6.3.33 (generics tail — NESTED + multi-arg): consume ONE type argument at the
# cursor and return its concrete encoding (per _classify_return_type: >0 struct sid,
# -1/-2/-4/-8 scalars, -16..-21 special). A NESTED generic type-arg (`Name<...>` where
# Name is a generic struct) is RECURSIVELY parsed + instantiated → its INSTANCE sid is
# returned, so `Box<Pair<i32>>` binds Box's T to the `Pair$i32` instance (not the base
# Pair, whose i64 layout differs). Consumes the name + any nested `<...>`; leaves the
# cursor on the `,` or `>` that terminates this arg. A nested 2-param `M<A, B>` recurses
# on both. Gated by the callers (`_MONOMORPH_OK`); no default-path effect.
# v6.3.33: special/aggregate types (Result/Option/Tagged/cstring/f64v2/f64v4,
# encoded <= -16 by _classify_return_type) are NOT supported as generic type-args.
# Their monomorphized ABI is not soundly emitted (proven: a generic fn instantiated
# with f64v2/f64v4 slipped the struct guard AND miscompiled), and _append_conc_name
# only width-suffixes the plain scalars {-8,-4,-2,-1} — every special collapses to
# `Base$i`, ALIASING distinct instances in the FINDFN/FINDSTRUCT dedup. Hard-error at
# the single leaf-classify choke point (covers fn + struct + nested) instead of
# silently miscompiling. Scalars and struct type-args are unaffected.
fn _reject_special_type_arg(S, c): i64 {
    if (c <= 0 - 16) {
        ERR_MSG(S, "generic type-args must be a scalar (i8/i16/i32/i64) or a struct; Result/Option/Tagged/cstring/f64v2/f64v4 are unsupported", 121);
    }
    return 0;
}

# ⛔ 6.6.8 — A TYPE-ARG NAMING THE ENCLOSING GENERIC'S OWN TYPE PARAMETER. `inner<T>(p)` inside
# `fn outer<T>` classified `T` as a TYPE NAME, found none, and got 0 — "unbound" — so the
# instance was minted with `_inst_conc0 == 0`, which PARSE_FN_DEF reads as the BASE emission:
# a field-accessing body became the `rax = 0` dead stub and `outer<Pt>(p)` returned 2 where 16
# was right, with no diagnostic. A bound type parameter resolves to its binding (T -> Pt in the
# `outer<Pt>` instance, T -> i64 in outer's own base); a name that is neither a bound parameter
# nor a type is an error — 0 is never a type. CHANGELOG [6.6.8]
fn _type_arg_leaf(S, noff): i64 {
    var _c0 = 0;
    if (_tp_c0 != 0) { _c0 = _tp_resolve(S, noff); }
    if (_c0 == 0) { _c0 = _classify_return_type(S, noff); }
    if (_c0 == 0) {
        _refuse_type_arg_name(S, noff);
        return 0 - 8;
    }
    _reject_special_type_arg(S, _c0);
    return _c0;
}
# The refusal names the vocabulary: exactly the names a return type accepts (`_classify_return_type`)
# plus a bound type parameter. `u8`..`u64`, `bool`, `ptr`, `f32` and an enum name are NOT in it —
# a type argument picks a WIDTH and a layout, so an alias that silently chose one is the bug this
# replaced. An enum gets its own line: its values are i64, and "unknown type" reads as a typo.
fn _refuse_type_arg_name(S, noff): i64 {
    if (_is_enum_name(S, noff) == 1) {
        ERR_IDENT(S, "", noff, " is an enum, not a type argument — enum values are i64; write i64", 0 - 1);
        return 0;
    }
    ERR_IDENT(S, "unknown type ", noff, " as a type argument (a type argument is a struct, i8/i16/i32/i64, f64, or a type parameter in scope)", 0 - 1);
    return 0;
}
fn _is_enum_name(S, noff): i64 {
    if (_enum_id_of(S, noff) > 0) { return 1; }
    return 0;
}

# The 1-based id of the enum named `noff` (the GVENUMID of its variants), or 0. CHANGELOG [6.6.11]
fn _enum_id_of(S, noff): i64 {
    var n = GENUMC(S);
    var i = 0;
    while (i < n) {
        if (STREQ(S, GENUMNM(S, i), noff) == 1) { return i + 1; }
        i = i + 1;
    }
    return 0;
}

fn _parse_one_type_arg(S): i64 {
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);                              # consume the type-arg name
    if (PEEKT(S) != 19) {                            # no `<` → plain scalar / struct
        var _c0 = _type_arg_leaf(S, noff);
        return _c0;
    }
    var base_sid = FINDSTRUCT(S, noff);
    if (base_sid <= 0 || GSTP(S, base_sid - 1) == 0) {
        var _c1 = _classify_return_type(S, noff);    # `<` but not a generic struct
        _reject_special_type_arg(S, _c1);
        # 6.6.17: and its own `<..>` (`Box<Vec<i64>>`), which was left for the enclosing list.
        _ta_pending_gt = _ta_pending_gt + _skip_targ_list(S);
        return _c1;
    }
    STI(S, GTI(S) + 1);                              # consume the nested `<`
    var in0 = _parse_one_type_arg(S);                # recurse into the inner arg(s)
    var in1 = 0;
    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); in1 = _parse_one_type_arg(S); }   # `,`
    _consume_gt(S);                                  # consume the nested `>` (or `>>`)
    return _instantiate_generic_struct(S, base_sid - 1, in0, in1);
}

# Parse fn name<T>(params) { body }
# Dead store elimination: scan codebuf for consecutive stores to the same
# [rbp-N] offset, NOP out the first store when redundant.
# Pattern: store [rbp-N] (7) + load_imm (2/5/10) + store [rbp-N] (7) → NOP first store.
fn DSE_PASS(S, fn_start): i64 {
    var dse_cp = GCP(S);
    var dse_i = fn_start;
    while (dse_i + 14 < dse_cp) {
        if (load8(_codebuf_base + dse_i) == 0x48) {
            if (load8(_codebuf_base + dse_i + 1) == 0x89) {
                if (load8(_codebuf_base + dse_i + 2) == 0x85) {
                    var dse_off = load32(_codebuf_base + dse_i + 3);
                    var dse_j = dse_i + 7;
                    var dse_skip = 0;
                    if (load8(_codebuf_base + dse_j) == 0x31) { dse_skip = 2; }
                    elif (load8(_codebuf_base + dse_j) == 0xB8) { dse_skip = 5; }
                    elif (load8(_codebuf_base + dse_j) == 0x48) {
                        if (load8(_codebuf_base + dse_j + 1) == 0xB8) { dse_skip = 10; }
                    }
                    if (dse_skip > 0) {
                        var dse_next = dse_j + dse_skip;
                        if (dse_next + 7 <= dse_cp) {
                            if (load8(_codebuf_base + dse_next) == 0x48) {
                                if (load8(_codebuf_base + dse_next + 1) == 0x89) {
                                    if (load8(_codebuf_base + dse_next + 2) == 0x85) {
                                        if (load32(_codebuf_base + dse_next + 3) == dse_off) {
                                            var dse_ni = dse_i;
                                            while (dse_ni < dse_j) {
                                                store8(_codebuf_base + dse_ni, 0x90);
                                                dse_ni = dse_ni + 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        dse_i = dse_i + 1;
    }
    return 0;
}

# Check if a codebuf offset is a jump target (recorded by EPATCH)
fn IS_JUMP_TARGET(S, off): i64 {
    var jtc = L64(S + 0x19E000);
    # AR-03 (v6.1.38): only 1023 slots are valid (0x19E008..0x1A0000); EJMP's
    # overflow path bumps the count to the 1024 sentinel, so clamp before reading
    # — slot 1023 is jump_src_cnt, not a recorded target.
    if (jtc > 1023) { jtc = 1023; }
    var i = 0;
    while (i < jtc) {
        if (L64(S + 0x19E008 + i * 8) == off) { return 1; }
        i += 1;
    }
    return 0;
}

# v6.5.20 — shift helper for the NOP-harvest compactor: total bytes deleted BEFORE
# code position `p`. Same linear scan the jump/fixup/target stages run inline (runs
# are emit-order, not CP-sorted, at the point these stages execute).
fn _nop_shift_at(S, nrn, p): i64 {
    var sh = 0;
    var i = 0;
    while (i < nrn) {
        if (L64(S + 0x1A2010 + i * 16) < p) { sh = sh + L64(S + 0x1A2010 + i * 16 + 8); }
        i = i + 1;
    }
    return sh;
}

# v6.5.20 — compaction stage 3b: repair switch jump-table entries.
#
# THE P1 SILENT MISCOMPILE. A table-regime `switch` embeds a (range+1) x 4 byte
# table of `target_cp - table_cp` displacements, dispatched by
# `movsxd rax,[rcx+rax*4] ; add rax,rcx ; jmp rax`. The v5.6.27 compactor deletes
# the 4-byte NOPs the regalloc picker leaves behind and repairs jump disp32s, fixup
# CPs and jump-target CPs — but it never knew about this table. Every NOP harvested
# between the table and a case body therefore left that body's entry pointing 4 bytes
# too far, cumulatively: `case 0` (offset 0 deletions) stayed correct while every
# later case landed mid-instruction. With a `default:` that is a SIGSEGV; without one
# the strayed target fell off the end of the switch and the program returned the wrong
# answer with no diagnostic. Only bodies that assign a register-allocated local produce
# NOPs, which is exactly why a corpus of `case N: { return N; }` bodies never saw it.
#
# Runs BEFORE stage 4 (the byte copy) and reads pre-compaction CPs, like every other
# stage. Both ends move independently, so each entry is recomputed from scratch rather
# than adjusted by a single delta. x86-family only — parse.cyr forces the chain path
# for aarch64/cx, so `swn` is 0 there and this is a no-op. CHANGELOG [6.5.20]
# v6.5.20 — does the 4-byte window at code position `p` touch any switch jump TABLE?
# The tables live in the code stream as DATA (`nent` × 4-byte displacements, jumped over
# by the dispatch), so any byte-pattern scan over a fn's range walks them as if they were
# instructions. Used by _ra_frame_trim to refuse a match that overlaps table bytes.
fn _sw_tbl_hits(S, swn, p): i64 {
    var si = 0;
    while (si < swn) {
        var tcp = L64(S + 0x1AC808 + si * 16);
        if (p + 3 >= tcp) {
            if (p < tcp + L64(S + 0x1AC808 + si * 16 + 8) * 4) { return 1; }
        }
        si = si + 1;
    }
    return 0;
}

fn _sw_tbl_repair(S, nrn, swn): i64 {
    var si = 0;
    while (si < swn) {
        var tcp = L64(S + 0x1AC808 + si * 16);
        var nent = L64(S + 0x1AC808 + si * 16 + 8);
        var new_tcp = tcp - _nop_shift_at(S, nrn, tcp);
        var ei = 0;
        while (ei < nent) {
            var ea = _codebuf_base + tcp + ei * 4;
            var rel = load8(ea) | (load8(ea + 1) << 8) | (load8(ea + 2) << 16) | (load8(ea + 3) << 24);
            if (rel >= 0x80000000) { rel = rel - 0x100000000; }
            var tgt = tcp + rel;
            var nrel = tgt - _nop_shift_at(S, nrn, tgt) - new_tcp;
            store8(ea + 0, nrel & 0xFF);
            store8(ea + 1, (nrel >> 8) & 0xFF);
            store8(ea + 2, (nrel >> 16) & 0xFF);
            store8(ea + 3, (nrel >> 24) & 0xFF);
            ei = ei + 1;
        }
        si = si + 1;
    }
    return 0;
}

# v6.3.29 callee-saved frame-trim (CYRIUS_FRAMETRIM). A #regalloc fn's prologue/epilogue
# save+restore ALL _cur_fn_regalloc callee-saved regs (rbx,r12-r15), but the linear-scan
# picker used only _ra_used_n of them (it allocates lowest-first → the used set is the
# prefix {0.._ra_used_n-1}). Callee-saved regs are written ONLY by the picker, so the
# saves/restores for the unused [_ra_used_n, _cur_fn_regalloc) regs are DEAD. Record them
# as nop_runs → PARSE_FN_DEF's existing compactor (below) deletes them with full jump/
# fixup/target repair. Saves are 4 B each at _ra_save_cp+k*4 (order rbx=0..r15=4); the
# restore sequence emits REVERSE (r15 first), so reg k sits at
# _ra_restore_cp+(_cur_fn_regalloc-1-k)*4. Frame size is unchanged (the reserved slot
# stays, just unused; disps don't shift) → reloc-safe. x86-only; gated CYRIUS_FRAMETRIM.
# v6.5.35 — loop-aware live-interval extension.
#
# A value live anywhere inside a loop body must stay live for the WHOLE body, or the
# picker may hand its register to a later interval and a backward edge will then re-read
# the register expecting the earlier value. That is the exact v5.6.22 miscompile which
# forced every interval's end to the function end (see RA_SCAN_LOOPS in
# src/backend/x86/decode.cyr for the full account).
#
# Given the backward edges as (target, branch) pairs, an interval [first, last] that
# overlaps a loop body [t, s] extends to `s`. Extending can pull an interval into a loop
# it did not previously overlap — an outer loop enclosing an inner one — so this iterates
# to a fixpoint rather than making one pass. Nesting depth is small; the cap is a belt.
#
# CONSERVATIVE BY CONSTRUCTION: it only ever moves `last` LATER, never earlier, so the
# result is always at least as live as the real interval and never shorter than what the
# picker needs. The worst case degenerates to `hi`, which is the pre-v6.5.35 behaviour.
fn _ra_loop_extend(be_t, be_s, be_n, first, last, hi): i64 {
    var out = last;
    var iter = 0;
    while (iter < 16) {
        var changed = 0;
        var i = 0;
        while (i < be_n) {
            var t = load64(be_t + i * 8);
            var sbr = load64(be_s + i * 8);
            # [first, out] overlaps the loop body [t, sbr]?
            if (first <= sbr) {
                if (out >= t) {
                    if (sbr > out) { out = sbr; changed = 1; }
                }
            }
            i = i + 1;
        }
        if (changed == 0) { break; }
        iter = iter + 1;
    }
    if (out > hi) { out = hi; }
    return out;
}

# THE ONE DEFINITION OF "A FRAME REFERENCE THE REGISTER PICKER CAN REWRITE".
#
# Returns the opcode (0x8B = load, 0x89 = store) when the bytes at codebuf offset `p` are
# `48 8B 85 d32` / `48 89 85 d32` — a 64-bit move between RAX and [rbp+disp32] — and 0 for
# anything else. All three picker stages ask this one function: the use scan counts only what
# it accepts, the unsafe scan disqualifies a slot for ANY [rbp+disp32] reference it rejects,
# and the patch pass rewrites only what it accepts. So a promoted slot keeps no reference to
# its stack home, by construction.
#
# ⛔ The stages used to spell this test separately, and disagreed: the unsafe scan exempted
# every `48 8B` / `48 89` without reading the ModRM REG field, so a SIMD kernel's operand read
# `mov rdx,[rbp+disp32]` (48 8B 95, `_EMIT_LOAD_RDX_FROM_LOCAL`) passed as a rewritable move
# that the patch pass (exact 0x85) never rewrote. The slot was promoted, its rax store became a
# register move, and the kernel read a slot nothing wrote — silent wrong code or a SIGSEGV
# through every batch intrinsic. A byte pattern the pass cannot rewrite must DISQUALIFY; it may
# never be waved through by opcode alone. CHANGELOG [6.6.5]
fn _ra_plain_slot_mov(p): i64 {
    var b = _codebuf_base + p;
    if (load8(b) != 0x48) { return 0; }
    if (load8(b + 2) != 0x85) { return 0; }
    var op = load8(b + 1);
    if (op == 0x8B) { return 0x8B; }
    if (op == 0x89) { return 0x89; }
    return 0;
}

fn _ra_frame_trim(S, fn_start, fi): i64 {
    # v6.3.29: the trim's invariant is that the regalloc PICKER ran and its
    # lowest-first assignment is faithfully tracked in `_ra_used_n`. Two paths break
    # that, so skip them:
    #  - `_cur_fn_has_closure`: the fn emitted an INLINE closure/generic instance in
    #    its own range; the picker is skipped and the range holds a foreign frame.
    #  - `_MONOMORPH_OK` (CYRIUS_MONOMORPH=1, experimental/opt-in/default-off): generic
    #    instances are emitted by token-replaying PARSE_FN_DEF with the picker skipped,
    #    so `_ra_used_n` (0) understates the instance's real callee-saved use → a trim
    #    would drop a live save. The trim is a DEFAULT-path optimization; the replay
    #    path is out of its scope.
    if (_cur_fn_has_closure != 0) { return 0; }
    # v6.4.0: skip the frame-trim only for GENERIC fns under the flag (base + every
    # token-replayed instance share the generic fn's `fi`, so GFTP != 0 covers all the
    # picker-skipped cases), NOT the v6.3.29 broad `_MONOMORPH_OK != 0` blanket that
    # disabled the trim for EVERY fn under the flag (+16 KB the moment it flips default-on).
    # cycc has zero generic fns → every fn trims → byte-identical under the flag.
    if (_MONOMORPH_OK == 1 && GFTP(S, fi) != 0) { return 0; }
    if (_cur_fn_regalloc <= 0) { return 0; }
    if (_ra_used_n >= _cur_fn_regalloc) { return 0; }
    var cb = _codebuf_base;
    var lim = GCP(S) - 4;
    # v6.5.20 — switch jump tables emitted by THIS fn (see _sw_tbl_hits). The scan below
    # is an UNALIGNED byte-pattern walk of the whole fn range, and since v6.5.20 that
    # range can contain table DATA as well as instructions; a 4-byte window landing on
    # table bytes must not be recorded as a NOP run. Clamped to the 256-record cap for
    # the same reason the compaction gate tests it — past that the tail is unrecorded.
    var _swtn = L64(S + 0x1AC800);
    if (_swtn > 256) { _swtn = 256; }
    var k = _ra_used_n;
    while (k < _cur_fn_regalloc) {
        # Per-reg save/restore bytes: [rex, 89(save)/8B(restore), modrm, disp8].
        # k: 0=rbx 1=r12 2=r13 3=r14 4=r15. An UNUSED reg (k>=_ra_used_n) is never
        # touched by the body (only the picker writes callee-saved regs, and it didn't
        # assign this one), so among the EMITTED INSTRUCTIONS these 4-byte patterns
        # appear ONLY as its real prologue save + epilogue restore(s) — pattern-scanning
        # finds ALL of them (handles multiple epilogues) with no body false-match.
        #
        # ⚠ v6.5.20 — that argument is about EMITTED INSTRUCTIONS and says nothing about
        # anything else in the range, and since v6.5.20 the range is no longer all
        # instructions: a table-regime `switch` embeds its jump table INLINE as `nent`
        # 4-byte displacements. This walk is UNALIGNED, so it reads those displacement
        # bytes as opcodes, and the four-byte window can straddle an entry pair or the
        # code/table boundary. Nothing about the picker constrains data. The near miss is
        # concrete: `4C 89 | 6D E8` is an exact `mov [rbp-8],r13` window whose second half
        # is the low 16 bits of displacement −6035, an entirely ordinary backward offset
        # from a table to a case body. A match would record a phantom 4-byte NOP run and
        # the compactor would DELETE FOUR BYTES OF THE TABLE — the same silent-miscompile
        # class stage 3b (_sw_tbl_repair) exists to close.
        #
        # An impossibility proof is available in principle — it turns on displacement
        # magnitudes keeping bytes 2-3 at 0x00/0xFF and on which bytes precede each table
        # — but it would have to be re-derived every time either emitter's layout moves,
        # which is precisely the kind of standing obligation that rots. Excluding the
        # range costs one comparison per window and retires the question:
        # `_sw_tbl_hits` refuses any window touching a table. Refusing is safe in the
        # other direction too — a genuine save/restore cannot overlap a table (the
        # dispatch jumps over it), so no real save is ever skipped.
        var rex = 0x4C;   if (k == 0) { rex = 0x48; }
        var modrm = 0x5D; if (k == 1) { modrm = 0x65; }
        if (k == 2) { modrm = 0x6D; }
        if (k == 3) { modrm = 0x75; }
        if (k == 4) { modrm = 0x7D; }
        var disp = 0xF8;  if (k == 1) { disp = 0xF0; }
        if (k == 2) { disp = 0xE8; }
        if (k == 3) { disp = 0xE0; }
        if (k == 4) { disp = 0xD8; }
        var p = fn_start;
        while (p <= lim) {
            var hit = 0;
            if (_swtn == 0 || _sw_tbl_hits(S, _swtn, p) == 0) {
                if (load8(cb + p) == rex) {
                    if (load8(cb + p + 2) == modrm) {
                        if (load8(cb + p + 3) == disp) {
                            var op = load8(cb + p + 1);
                            if (op == 0x89) { hit = 1; }
                            if (op == 0x8B) { hit = 1; }
                            if (hit == 1) {
                                var nc = L64(S + 0x1A2008);
                                if (nc < 1024) {
                                    S64(S + 0x1A2010 + nc * 16, p);
                                    S64(S + 0x1A2010 + nc * 16 + 8, 4);
                                    S64(S + 0x1A2008, nc + 1);
                                }
                            }
                        }
                    }
                }
            }
            if (hit == 1) { p = p + 4; } else { p = p + 1; }
        }
        k = k + 1;
    }
    return 0;
}

# v6.3.5 CO-01 — single source of truth for param-type-name classification.
# Returns the param-type class for a type name at tok_names offset `tnoff`:
#   0 = int / struct / other (no special ABI mask)
#   1 = Str       2 = cstring   3 = Result   4 = Option
#   5 = Tagged    6 = f64v2     7 = f64v4
# Pure byte-compares over the name pool (S+0x60000); zero global-var refs and
# no calls beyond the L64/load8 memory builtins → cybs-safe by construction.
# Extracted verbatim from the PARSE_FN_DEF param loop so the pass-1 signature
# prescan (_prescan_fn_sig) and the pass-2 definition agree byte-for-byte.
fn _classify_param_type(S, tnoff): i64 {
    # Str → "Str\0" (low 32 bits = 0x00727453, little-endian)
    if (L64(S + 0xEC00000 + tnoff) & 0xFFFFFFFF == 0x00727453) { return 1; }
    var b0 = load8(S + 0xEC00000 + tnoff);
    var b1 = load8(S + 0xEC00000 + tnoff + 1);
    var b2 = load8(S + 0xEC00000 + tnoff + 2);
    var b3 = load8(S + 0xEC00000 + tnoff + 3);
    var b4 = load8(S + 0xEC00000 + tnoff + 4);
    var b5 = load8(S + 0xEC00000 + tnoff + 5);
    var b6 = load8(S + 0xEC00000 + tnoff + 6);
    var b7 = load8(S + 0xEC00000 + tnoff + 7);
    # cstring → 'c','s','t','r','i','n','g',0
    if (b0 == 99) { if (b1 == 115) { if (b2 == 116) { if (b3 == 114) {
                    if (b4 == 105) { if (b5 == 110) { if (b6 == 103) { if (b7 == 0) {
                                    return 2;
                                } } } } } } } }
    # Result → 'R','e','s','u','l','t',0
    if (b0 == 82) { if (b1 == 101) { if (b2 == 115) { if (b3 == 117) {
                    if (b4 == 108) { if (b5 == 116) { if (b6 == 0) {
                                return 3;
                            } } } } } } }
    # Option → 'O','p','t','i','o','n',0
    if (b0 == 79) { if (b1 == 112) { if (b2 == 116) { if (b3 == 105) {
                    if (b4 == 111) { if (b5 == 110) { if (b6 == 0) {
                                return 4;
                            } } } } } } }
    # Tagged → 'T','a','g','g','e','d',0
    if (b0 == 84) { if (b1 == 97) { if (b2 == 103) { if (b3 == 103) {
                    if (b4 == 101) { if (b5 == 100) { if (b6 == 0) {
                                return 5;
                            } } } } } } }
    # f64v2 / f64v4 → 'f','6','4','v', '2'|'4', 0
    if (b0 == 102) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) {
                    if (b4 == 50) { if (b5 == 0) { return 6; } }
                    if (b4 == 52) { if (b5 == 0) { return 7; } }
                } } } }
    # f32v4 → 'f','3','2','v','4', 0 — 128-bit; class 8 reuses f64v2's XMM/2-slot ABI
    # (pt_simd_class 1) but tags the param SLTYPE -2121 for op-width dispatch.
    if (b0 == 102) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) {
                    if (b4 == 52) { if (b5 == 0) { return 8; } }
                } } } }
    # v6.4.7 (Phase 3b) — integer vector value-form params: return the NEGATIVE
    # descriptor sentinel (≤ -2048), distinct from the small positive codes 1-8.
    # The prescan + def-fold detect `c <= -2048` → 16-byte/1-XMM routing (mask 1),
    # SLTYPE = the sentinel. 'i'=105 'u'=117 'v'=118.
    if (b0 == 105) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) { if (b4 == 52) { if (b5 == 0) { return 0 - 2122; } } } } } }  # i32v4
    if (b0 == 117) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) { if (b4 == 52) { if (b5 == 0) { return 0 - 2120; } } } } } }  # u32v4
    if (b0 == 105) { if (b1 == 49) { if (b2 == 54) { if (b3 == 118) { if (b4 == 56) { if (b5 == 0) { return 0 - 2150; } } } } } }  # i16v8
    if (b0 == 117) { if (b1 == 49) { if (b2 == 54) { if (b3 == 118) { if (b4 == 56) { if (b5 == 0) { return 0 - 2148; } } } } } }  # u16v8
    if (b0 == 105) { if (b1 == 56) { if (b2 == 118) { if (b3 == 49) { if (b4 == 54) { if (b5 == 0) { return 0 - 2178; } } } } } }  # i8v16
    if (b0 == 117) { if (b1 == 56) { if (b2 == 118) { if (b3 == 49) { if (b4 == 54) { if (b5 == 0) { return 0 - 2176; } } } } } }  # u8v16
    if (b0 == 105) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) { if (b4 == 50) { if (b5 == 0) { return 0 - 2094; } } } } } }  # i64v2
    if (b0 == 117) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) { if (b4 == 50) { if (b5 == 0) { return 0 - 2092; } } } } } }  # u64v2
    return 0;
}

# v6.3.5 CO-01 — single source of truth for return-type classification.
# Returns the fn_ret_sid encoding for a return-type name at `rt_noff`:
#   > 0  : struct sid (FINDSTRUCT)
#   -1/-2/-4/-8        : scalar i8 / i16 / i32 / i64
#   -16/-17/-18/-19    : Result / Option / Tagged / cstring
#   -20/-21            : f64v2 / f64v4
#   0    : unrecognized (caller raises the "return type must be ..." error)
# Mirrors the param classifier (one FINDSTRUCT call + byte-compares, no other
# global-var refs → cybs-safe). Extracted verbatim from PARSE_FN_DEF so the
# pass-1 _prescan_fn_sig writes the same struct-return / scalar ABI that the
# pass-2 definition does — forward calls to struct-returning fns then emit the
# hidden retptr correctly instead of reading SFRS=0.
# v6.5.21 — parse a MULTI-VALUE return annotation `: (T1, T2[, T3])` and record
# it on the fn. Leaves GTI just past the closing ')'; returns the arity.
# `quiet` = 1 for the pass-1 prescan, which only harvests metadata — PARSE_FN_DEF
# re-parses the same tokens in pass 2 and is where diagnostics fire, so reporting
# in both would double every message.
# Arity is recorded at the DECLARATION on purpose: a fn may mix `return 5;` with
# `return (a, b);` across branches, and a forward call has no body yet, so a
# body-scan could never answer the call site. See GFRN/GFRT in common/util.cyr.
fn _parse_multiret_sig(S, fi, quiet): i64 {
    STI(S, GTI(S) + 1);                     # consume '('
    var n = 0;
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) != 2) { if (PEEKT(S) != 8) { ERR_EXPECT(S, 2); return n; } }
        var t = _mret_elem(S, fi, quiet);
        if (n < 3) { SFRT(S, fi, n, t); }
        n = n + 1;
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); } else { go = 0; }
    }
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); return n; }
    STI(S, GTI(S) + 1);                     # consume ')'
    if (quiet == 0) {
        if (n < 2) { ERR_MSG(S, "multi-value return needs 2 or 3 types", 37); }
        if (n > 3) { ERR_MSG(S, "multi-value return needs 2 or 3 types", 37); }
    }
    SFRN(S, fi, n);
    SFRS(S, fi, MULTIRET_SID);
    return n;
}

# One element of a multi-value return type (cursor on it), consumed; its return code.
# Unknown element type keeps the token stream in sync as a plain i64 slot
# rather than desyncing the parse — same tactic as the `_syntax_only` arm
# on the single-value path below. 6.6.16 (C8): a name that is no type at all is
# refused by name (it compiled silently as i64); every type name stays accepted.
# 6.6.17: a `*T` element is an i64 slot too (`_ptr_annot`).
# 6.6.17: and an element takes type arguments (`(Box<i64>, i64)`), resolved as a single return
# type's are (`_gtype_sid`): it was `expected ')', got '<'`.
fn _mret_elem(S, fi, quiet): i64 {
    if (PEEKT(S) == 8) {
        _ptr_annot(S, 0 - 1, quiet);
        return 0 - 8;
    }
    var t = _classify_return_type(S, PEEKV(S));
    if (t == 0) {
        if (quiet == 0) { _tn_mret_check(S, GTI(S)); }
        t = 0 - 8;
    }
    if (t > 0) { t = _gtype_sid(S, fi, t); }
    STI(S, GTI(S) + 1);                 # consume the type IDENT
    SKIP_GENERICS(S);
    return t;
}

fn _classify_return_type(S, rt_noff): i64 {
    var rt_sid = FINDSTRUCT(S, rt_noff);
    if (rt_sid > 0) { return rt_sid; }
    var b0 = load8(S + 0xEC00000 + rt_noff);
    var b1 = load8(S + 0xEC00000 + rt_noff + 1);
    var b2 = load8(S + 0xEC00000 + rt_noff + 2);
    var b3 = load8(S + 0xEC00000 + rt_noff + 3);
    var b4 = load8(S + 0xEC00000 + rt_noff + 4);
    var b5 = load8(S + 0xEC00000 + rt_noff + 5);
    var b6 = load8(S + 0xEC00000 + rt_noff + 6);
    var b7 = load8(S + 0xEC00000 + rt_noff + 7);
    # scalars: i8 / i16 / i32 / i64 ('i' = 105)
    if (b0 == 105) {
        if (b1 == 56) { if (b2 == 0) { return 0 - 1; } }
        if (b1 == 49) { if (b2 == 54) { if (b3 == 0) { return 0 - 2; } } }
        if (b1 == 51) { if (b2 == 50) { if (b3 == 0) { return 0 - 4; } } }
        if (b1 == 54) { if (b2 == 52) { if (b3 == 0) { return 0 - 8; } } }
    }
    # Result → 'R','e','s','u','l','t',0
    if (b0 == 82) { if (b1 == 101) { if (b2 == 115) { if (b3 == 117) {
                    if (b4 == 108) { if (b5 == 116) { if (b6 == 0) { return 0 - 16; } } } } } } }
    # Option → 'O','p','t','i','o','n',0
    if (b0 == 79) { if (b1 == 112) { if (b2 == 116) { if (b3 == 105) {
                    if (b4 == 111) { if (b5 == 110) { if (b6 == 0) { return 0 - 17; } } } } } } }
    # Tagged → 'T','a','g','g','e','d',0
    if (b0 == 84) { if (b1 == 97) { if (b2 == 103) { if (b3 == 103) {
                    if (b4 == 101) { if (b5 == 100) { if (b6 == 0) { return 0 - 18; } } } } } } }
    # cstring → 'c','s','t','r','i','n','g',0
    if (b0 == 99) { if (b1 == 115) { if (b2 == 116) { if (b3 == 114) {
                    if (b4 == 105) { if (b5 == 110) { if (b6 == 103) { if (b7 == 0) { return 0 - 19; } } } } } } } }
    # v6.4.55: scalar f64 → 'f','6','4',0 — returned in xmm0 (SysV/Win64, NOT retptr).
    # Sentinel -9: free (−1..−8 = int scalars, −16..−19 = Result/Option/Tagged/cstring,
    # the SIMD band is <= −2048). Distinct from f64v2/f64v4 below (byte 3 = 'v' = 118).
    if (b0 == 102) { if (b1 == 54) { if (b2 == 52) { if (b3 == 0) { return 0 - 9; } } } }
    # f64v2 / f64v4 → 'f','6','4','v', '2'|'4', 0 — 128/256-bit descriptor sentinels
    # -2093 (desc 45) / -2125 (desc 77): moved off the flat -20/-21 that collided with
    # struct-ids 20/21 (v6.4.14 struct-sid/SIMD-sentinel fix). Decoded by _vec_desc.
    if (b0 == 102) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) {
                    if (b4 == 50) { if (b5 == 0) { return 0 - 2093; } }
                    if (b4 == 52) { if (b5 == 0) { return 0 - 2125; } }
                } } } }
    # f32v4 → 'f','3','2','v','4', 0 — 128-bit descriptor sentinel -2121 (SIMD Phase 1)
    if (b0 == 102) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) {
                    if (b4 == 52) { if (b5 == 0) { return 0 - 2121; } }
                } } } }
    # f32v8 → 'f','3','2','v','8', 0 — 256-bit descriptor sentinel -2153 (SIMD Phase 4)
    if (b0 == 102) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) {
                    if (b4 == 56) { if (b5 == 0) { return 0 - 2153; } }
                } } } }
    # v6.4.6 (Phase 3a) — integer vector return/param types (128-bit sentinels).
    # 'i'=105 'u'=117 'v'=118. i32v4/u32v4 = i/u,'3','2','v','4'.
    if (b0 == 105) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) { if (b4 == 52) { if (b5 == 0) { return 0 - 2122; } } } } } }  # i32v4
    if (b0 == 117) { if (b1 == 51) { if (b2 == 50) { if (b3 == 118) { if (b4 == 52) { if (b5 == 0) { return 0 - 2120; } } } } } }  # u32v4
    # i16v8/u16v8 = i/u,'1','6','v','8'.
    if (b0 == 105) { if (b1 == 49) { if (b2 == 54) { if (b3 == 118) { if (b4 == 56) { if (b5 == 0) { return 0 - 2150; } } } } } }  # i16v8
    if (b0 == 117) { if (b1 == 49) { if (b2 == 54) { if (b3 == 118) { if (b4 == 56) { if (b5 == 0) { return 0 - 2148; } } } } } }  # u16v8
    # i8v16/u8v16 = i/u,'8','v','1','6'.
    if (b0 == 105) { if (b1 == 56) { if (b2 == 118) { if (b3 == 49) { if (b4 == 54) { if (b5 == 0) { return 0 - 2178; } } } } } }  # i8v16
    if (b0 == 117) { if (b1 == 56) { if (b2 == 118) { if (b3 == 49) { if (b4 == 54) { if (b5 == 0) { return 0 - 2176; } } } } } }  # u8v16
    # i64v2/u64v2 = i/u,'6','4','v','2'.
    if (b0 == 105) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) { if (b4 == 50) { if (b5 == 0) { return 0 - 2094; } } } } } }  # i64v2
    if (b0 == 117) { if (b1 == 54) { if (b2 == 52) { if (b3 == 118) { if (b4 == 50) { if (b5 == 0) { return 0 - 2092; } } } } } }  # u64v2
    return 0;
}

# v6.3.5 CO-01 — pass-1 fn-signature prescan. Three small helpers that, when
# called from the pass-1 scan (_tl_scan1) in place of the old inline fn-skip, register
# every top-level fn AND record its ABI metadata (param masks, param count,
# variadic flag, struct/scalar return) BEFORE pass-2 emits any call. That makes
# forward calls — a call lexically before its definition — read the correct
# Str / cstring / Result / Option / Tagged / SIMD masks and struct-return ABI
# instead of the mask-0 an auto-registered bare name used to get (the silent
# miscompile CO-01 describes). Structs / enums / globals were already pass-1
# order-independent; this extends the same treatment to fn signatures.
#
# _prescan_skip_fn is the verbatim pre-CO-01 body-skip, so pass-1's TOKEN CURSOR
# advances exactly as it did before. _prescan_fn_sig extracts metadata on a
# throwaway cursor then RESETS and replays this — registration/mask writes are
# the only new effect, never a change in where pass-1 leaves the cursor.
fn _prescan_skip_fn(S): i64 {
    STI(S, GTI(S) + 1);  # consume FN
    STI(S, GTI(S) + 1);  # consume name
    if (PEEKT(S) == 19) { while (PEEKT(S) != 20 && PEEKT(S) != 12) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
    var dep = 0;
    var fsk = 1;
    while (fsk == 1) {
        var ft = PEEKT(S);
        if (ft == 13) { dep = dep + 1; }
        if (ft == 14) { dep = dep - 1; if (dep == 0) { fsk = 0; } }
        if (ft == 12) { fsk = 0; }
        STI(S, GTI(S) + 1);
    }
    return 0;
}

# v6.3.36 (issue [5]) — does param type `tnoff` want a struct POINTER? True for a
# plain struct >8 bytes: _classify_param_type returns 0 for it (not Str/cstring/
# Result/Option/Tagged/SIMD, which are pointer/handle/value-passed), and the callee
# derefs a >8-byte struct param as a pointer (v6.3.16 lf_is_ptr), so the caller must
# address-pass it. Str/Result/Option/Tagged are 16 B structs by NAME but classify
# non-zero → excluded (they hold a heap handle, value-passed). Used by both passes
# to build _fnt_structmask consistently, and by PARSE_FNCALL to gate the address push.
fn _param_wants_struct_ptr(S, tnoff): i64 {
    if (_classify_param_type(S, tnoff) != 0) { return 0; }
    var sid = FINDSTRUCT(S, tnoff);
    if (sid <= 0) { return 0; }
    if (STRUCTSZ(S, sid - 1) <= 8) { return 0; }
    return 1;
}

# ⛔ 6.6.11 — BIT 62 OF `_fnt_structmask`: "param 0 is a declared plain struct of 8 B or less,
# passed BY VALUE". The method-call arm (PARSE_FIELD_LOAD) needs it to push the receiver's value
# where it pushes `&x` for an untyped `self` (which IS a pointer) and for a > 8 B one (address-
# passed); without it `x.sum()` with `self: Odd` handed the callee an address. Read from the
# tokens of param 0 by BOTH passes (`_prescan_params`, PARSE_FN_DEF), so they cannot disagree.
# A spare bit, not a new table, so the brk layout does not move; the per-param readers test
# `1 << argc` and the whole-mask readers go through `_smask_args`. A generic `self: Box<T>` is
# left unflagged. `lp` = the `(` token. CHANGELOG [6.6.11]
fn _selfbv_bit(S, lp): i64 {
    if (TOKTYP(S, lp + 1) != 2) { return 0; }
    if (TOKTYP(S, lp + 2) != 49) { return 0; }
    if (TOKTYP(S, lp + 3) != 2) { return 0; }
    if (TOKTYP(S, lp + 4) == 19) { return 0; }
    var tnoff = TOKVAL(S, lp + 3);
    if (_classify_param_type(S, tnoff) != 0) { return 0; }
    var sid = FINDSTRUCT(S, tnoff);
    if (sid <= 0) { return 0; }
    if (STRUCTSZ(S, sid - 1) > 8) { return 0; }
    return 1 << 62;
}
# 6.6.17 (a10): nonzero when ANY parameter is address-passed, an overflow-row one included.
fn _smask_args(fi): i64 {
    var m = L64(_fnt_structmask + fi * 8) & ((1 << 62) - 1);
    if (m != 0) { return m; }
    return _pm_row_any(fi, 1);
}
# ⛔ 6.6.17 (a10) — PER-PARAMETER KINDS PAST THE i64 MASKS. Each per-fn mask holds one bit per
# parameter ordinal — `_fnt_structmask` keeps bit 62 for `_selfbv_bit`, so ordinals 0..61; the
# SysV `_fnt_simdmask` two bits each, so 0..30 — and `1 << pc` WRAPS at 64 on x86 (the count is
# taken mod 64). In a 70-parameter fn, parameter 66's struct bit landed on parameter 2 and
# parameter 67's `: Str` bit on parameter 3, so a struct local passed to 2 went by address and a
# string literal passed to 3 was `str_from`-wrapped; a struct parameter AT ordinal 62 was never
# address-passed (`_smask_args` masks bit 62 off). An ordinal past a mask's range now lives in the
# fn's overflow row (util.cyr `_pm_row_*`), written by `_pmw` / `_pmw2` at every mask write and
# read by `_pm_struct` / `_pm_str` / `_pm_cstr` / `_pm_simd` at every per-ordinal read. No
# parameter-count limit: the row grows. Row kinds: 1 struct (address-passed), 2 Str, 4 cstring,
# 8 Result, 16 Option, 32 Tagged, (SIMD code) << 6. The fn is `_cur_fn_ix` (the definition being
# parsed; `_prescan_params` sets it for pass 1). CHANGELOG [6.6.17]
fn _pmw(m, pc, k): i64 {
    if (pc < 62) { return m | (1 << pc); }
    _pm_row_or(_cur_fn_ix, pc, k);
    return m;
}
fn _pmw2(m, pc, code): i64 {
    if (pc < 31) { return m | (code << (pc * 2)); }
    _pm_row_or(_cur_fn_ix, pc, code << 6);
    return m;
}
fn _pm_bit(fi, mask, argc, k): i64 {
    if (argc < 62) { return (mask >> argc) & 1; }
    if ((_pm_row_get(fi, argc) & k) != 0) { return 1; }
    return 0;
}
fn _pm_struct(fi, argc): i64 { return _pm_bit(fi, L64(_fnt_structmask + fi * 8), argc, 1); }
fn _pm_str(fi, argc): i64 { return _pm_bit(fi, L64(_fnt_strmask + fi * 8), argc, 2); }
fn _pm_cstr(fi, argc): i64 { return _pm_bit(fi, L64(_fnt_cstrmask + fi * 8), argc, 4); }
fn _pm_simd(fi, argc): i64 {
    if (fi < 0) { return 0; }
    if (argc < 31) { return (L64(_fnt_simdmask + fi * 8) >> (argc * 2)) & 3; }
    return (_pm_row_get(fi, argc) >> 6) & 3;
}
fn _fn_self_byval(fi): i64 {
    if (fi < 0) { return 0; }
    return (L64(_fnt_structmask + fi * 8) >> 62) & 1;
}

# 6.6.12 — record the struct id of an ADDRESS-passed struct parameter (see SFPSID, util.cyr).
fn _psid_note(S, fi, pc, sid, mask): i64 {
    if (pc < 62) { if (((mask >> pc) & 1) == 0) { return 0; } }
    elif ((_pm_row_get(fi, pc) & 1) == 0) { return 0; }   # 6.6.17 (a10): the overflow row
    return SFPSID(S, fi, pc, sid);
}
# Pass 1's half: a parameter typed with struct `base` — its address-passed bit follows the
# instance (`_gtype_param_mask`), and the sid is recorded. Returns the instance sid; the updated
# mask is the second return, `_psid_mask` (read it immediately).
var _psid_mask = 0;
fn _psid_scan(S, fi, pc, base, mask): i64 {
    var inst = _gtype_sid(S, fi, base);
    _psid_mask = _gtype_param_mask(S, mask, pc, base, inst);
    _psid_note(S, fi, pc, inst, _psid_mask);
    return inst;
}

# Scan the param list `( ... )` for fn `fi`, computing the per-fn ABI masks the
# same way PARSE_FN_DEF's param loop does (shared _classify_param_type → first
# match sets one mask at bit `pc`; SIMD uses 2 bits at pc*2), plus the param
# count and variadic flag. No slot allocation / no ESTOREPARM — pass-1 records
# metadata only. Leaves the cursor just past `)` (throwaway; caller resets).
# 6.6.17 (a10): the overflow-row writes (`_pmw`) name the fn through `_cur_fn_ix`, which pass 1
# does not otherwise set — set for the scan, then put back.
fn _prescan_params(S, fi): i64 {
    var sv = _cur_fn_ix;
    _cur_fn_ix = fi;
    _prescan_params_scan(S, fi);
    _cur_fn_ix = sv;
    return 0;
}
fn _prescan_params_scan(S, fi): i64 {
    if (PEEKT(S) != 10) { return 0; }   # no '(' — malformed; pass-2 will ERR
    STI(S, GTI(S) + 1);                 # consume '('
    var pc = 0;
    var str_mask = 0;
    var cstring_mask = 0;
    var result_mask = 0;
    var option_mask = 0;
    var tagged_mask = 0;
    var simd_mask = 0;
    var struct_mask = _selfbv_bit(S, GTI(S) - 1);   # 6.6.11: bit 62, see there
    if (PEEKT(S) != 11) {
        var pgo = 1;
        while (pgo == 1) {
            if (PEEKT(S) == 112) {          # variadic '...'
                STI(S, GTI(S) + 1);
                SFVA(S, fi, 1);
                pgo = 0;
            } else {
                if (PEEKT(S) == 2) { STI(S, GTI(S) + 1); }   # param name
                if (PEEKT(S) == 49) {                        # ': Type'
                    STI(S, GTI(S) + 1);                      # consume ':'
                    if (PEEKT(S) == 8) { STI(S, GTI(S) + 1); }   # skip '*' (pointer)
                    if (PEEKT(S) == 2) {
                        var c = _classify_param_type(S, PEEKV(S));
                        if (c == 1) { str_mask = _pmw(str_mask, pc, 2); }
                        elif (c == 2) { cstring_mask = _pmw(cstring_mask, pc, 4); }
                        elif (c == 3) { result_mask = _pmw(result_mask, pc, 8); }
                        elif (c == 4) { option_mask = _pmw(option_mask, pc, 16); }
                        elif (c == 5) { tagged_mask = _pmw(tagged_mask, pc, 32); }
                        # v6.4.31: Win64 (PE) passes __m128 / any >8B vector BY
                        # POINTER in an int arg reg (MS x64 ABI), so a value-form
                        # SIMD param is address-passed like a plain struct >8B —
                        # set struct_mask (drives the caller's &local push), NOT
                        # simd_mask (which would XMM-route it, the SysV path).
                        elif (c == 6) { if (_TARGET_PE == 1) { struct_mask = _pmw(struct_mask, pc, 1); } else { simd_mask = _pmw2(simd_mask, pc, 1); } }
                        elif (c == 7) { if (_TARGET_PE == 1) { struct_mask = _pmw(struct_mask, pc, 1); } else { simd_mask = _pmw2(simd_mask, pc, 2); } }
                        elif (c == 8) { if (_TARGET_PE == 1) { struct_mask = _pmw(struct_mask, pc, 1); } else { simd_mask = _pmw2(simd_mask, pc, 3); } }  # f32v4 (16-byte; mask=3 distinguishes from f64v2=1)
                        elif (c <= 0 - 2048) { if (_TARGET_PE == 1) { struct_mask = _pmw(struct_mask, pc, 1); } else { simd_mask = _pmw2(simd_mask, pc, 1); } }  # v6.4.7: integer 128-bit vector → 16-byte/1-XMM (mask 1)
                        # v6.3.36 (issue [5]) — plain struct >8 B param → address-passed.
                        if (_param_wants_struct_ptr(S, PEEKV(S)) == 1) { struct_mask = _pmw(struct_mask, pc, 1); }
                        # 6.6.10: `r: Box<Pt>` — the instance's size decides (see _gtype_sid).
                        var _pb = FINDSTRUCT(S, PEEKV(S));
                        if (_pb > 0) { _pb = _psid_scan(S, fi, pc, _pb, struct_mask); struct_mask = _psid_mask; }
                        STI(S, GTI(S) + 1);                  # consume type name
                        SKIP_GENERICS(S);                    # `: Vec<i64>` etc.
                    }
                }
                pc = pc + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }  # comma → next param
                else { pgo = 0; }
            }
        }
    }
    # Consume the closing ')' so the caller's return-type scan sees the ':' (or
    # '{') next — without this the cursor sits on ')' and `: Struct` returns are
    # never classified (struct-return forward calls would keep the mask-0 ABI).
    if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); }
    S64(_fnt_params + fi * 8, pc);
    S64(_fnt_strmask + fi * 8, str_mask);
    S64(_fnt_cstrmask + fi * 8, cstring_mask);
    S64(_fnt_resmask + fi * 8, result_mask);
    S64(_fnt_optmask + fi * 8, option_mask);
    S64(_fnt_tagmask + fi * 8, tagged_mask);
    S64(_fnt_simdmask + fi * 8, simd_mask);
    S64(_fnt_structmask + fi * 8, struct_mask);
    return 0;
}

# Register a top-level fn and record its ABI metadata in pass-1. Cursor enters at
# the FN token. Extraction runs on a throwaway cursor (it may advance through the
# signature however _prescan_params / the return-type scan need to); afterward the
# cursor is RESET to the FN token and _prescan_skip_fn replays the canonical skip,
# guaranteeing pass-1's net cursor advancement is byte-identical to the old inline
# skip.
#
# ⛔ 6.6.5 — the `if (GMOD(S) == 0)` guard that stood here excluded `mod`-scoped fns and
# (with the impl brace-skip in the seven forks) impl METHODS, on the reasoning that
# PARSE_FN_DEF's mangling mutates the name pool and `mod` is unused in-tree. Both halves
# were load-bearing bugs, not economies: an unregistered definition has no owner and no
# private bit, so `_vis_check` returned at its first test and a call PRECEDING the
# definition reached a private method or mod fn from any file; and with no pass-1 params
# the same forward call got the mask-0 ABI, so a >8-byte struct argument was passed by
# VALUE into a callee that derefs it — a silent SIGSEGV, not a visibility nicety.
# `_mod_name_intern` answers the pool question (mint once, reuse from either pass), so
# the guard is gone and EVERY definition kind is stamped here. CHANGELOG [6.6.5]
fn _prescan_fn_sig(S): i64 {
    var _pasync = 0;
    if (PEEKT(S) == 134) { STI(S, GTI(S) + 1); _pasync = 1; }   # v6.3.11: consume optional `async` prefix
    var start_ti = GTI(S);
    STI(S, GTI(S) + 1);                 # consume FN
    if (PEEKT(S) == 2) {
        var noff = PEEKV(S);
        STI(S, GTI(S) + 1);             # consume name
        var _ptp = _capture_tparams(S);   # v6.3.9: capture <T> (flag-off = old skip)
        noff = _mod_name_intern(S, GMOD(S), noff);   # `mod`/impl mangling, in pass 1 too
        # v6.5.0 Phase 2 — stamp visibility HERE, in pass 1.
        #
        # Two reasons, both load-bearing:
        #  (1) FORWARD calls. PARSE_FN_DEF runs in pass 2 in source order, so a
        #      cross-file call to a fn defined LATER in the concatenated stream
        #      resolves while the callee's fileid is still 0 — enforcement would
        #      fail open for exactly the half of calls that go through ECALLFIX,
        #      i.e. purely as a function of include order.
        #  (2) `_pub_pending` MUST be consumed here. Pass 1 walks the same tokens
        #      and _TL_VIS arms the marker at every `public`, but pass 1 never
        #      reached PARSE_FN_DEF to clear it — so the flag leaked across the
        #      pass boundary and suppressed the private stamp on the FIRST fn of
        #      pass 2. That is what made `private` work in a main source but
        #      silently do nothing from an included file.
        var _pfid = FM_FILEID(S, GTLINE(S, start_ti));
        var _ppriv = 0;
        if (_pub_pending == 0) { if (_PRIV_FILE(_pfid) == 1) { _ppriv = 1; } }
        _pub_pending = 0;
        # 6.6.5 — one entry per DEFINITION, not per NAME. Pass 1 used to FINDFN-or-REGFN,
        # so a second file's same-named helper overwrote the first file's owner, arity and
        # private bit before either body was parsed: two private `_h` helpers in two files
        # produced a false "is private to its file" AND a false "expects 2 arguments, got
        # 1". The v6.5.38 identity rule now runs in BOTH passes, from one place.
        var fi = _fn_def_slot(S, noff, _pfid, _ppriv);
        _prescan_dep_take(S, fi);               # 6.6.16: a pending `#deprecated`, for forward calls
        if (_ptp != 0) { SFTP(S, fi, _ptp); }   # v6.3.9: forward-ref generic sig
        if (_ptp != 0) { _gen_record(S, fi, GTI(S)); }   # 6.6.10: stub + carrier facts, by name
        # 6.6.10 — mark `async fn` HERE, so a coroutine's `await f(..)` classifies a callee
        # defined further down (`_await_operand_is_future`). CHANGELOG [6.6.10]
        var _pas0 = GFAS(S, fi);   # 6.6.20: whether an EARLIER definition was async
        if (_pasync == 1) { SFAS(S, fi, 1); }
        # 6.6.5 — def-start for EVERY prescanned fn, not just generics. It is how pass 2
        # finds the entry THIS definition owns (_fn_by_defti), and it is what lets a
        # forward `f<i32>(x)` instantiate (GFDS was pass-2-only, so the instantiator
        # returned -2 and the caller printed a stale "follow-on bite" error).
        # 6.6.20: an entry that already holds ANOTHER definition is a redefinition — fn flag
        # 2048, read where a call would otherwise bind to the body in hand at that point (the
        # inline replay; a generic's instance source). Left as the LAST definition's start.
        # One that disagrees with an earlier one about `async` is refused (_dsg_async_check).
        var _pds = GFDS(S, fi);
        if (_pds != 0) {
            if (_pds != start_ti + 1) {
                SFLG(S, fi, GFLG(S, fi) | 2048);
                _dsg_async_check(S, fi, noff, start_ti, _pas0, _pasync);
            }
        }
        SFDS(S, fi, start_ti + 1);
        SFFI(S, fi, _pfid + 1);
        if (_ppriv == 1) { SFLG(S, fi, GFLG(S, fi) | 64); }
        else { SFLG(S, fi, GFLG(S, fi) & (0 - 65)); }   # never leave a stale private bit
        _prescan_params(S, fi);
        if (PEEKT(S) == 49) {       # optional `: ReturnType`
            STI(S, GTI(S) + 1);     # consume ':'
            if (PEEKT(S) == 10) {
                # v6.5.21 — `: (T1, T2[, T3])`. Recorded HERE in pass 1 so a
                # FORWARD call can arity-check against a fn defined later.
                _parse_multiret_sig(S, fi, 1);
            } elif (PEEKT(S) == 8) { _ret_ptr_annot(S, fi, 1); }   # 6.6.17: `: *T`
            else {
                if (PEEKT(S) == 2) {
                    var rtc = _classify_return_type(S, PEEKV(S));
                    if (rtc > 0) { rtc = _gtype_sid(S, fi, rtc); }   # 6.6.10: `: Box<Pt>`
                    if (rtc != 0) { SFRS(S, fi, rtc); }
                }
            }
        }
        _prescan_ret_single(S, fi);   # 6.6.17 (a5)
    } else { _pre_dep_pending = 0; }    # an unnamed `fn`: pass 2 refuses it; never carry past it
    STI(S, start_ti);
    _prescan_skip_fn(S);
    return 0;
}

# ⛔ 6.6.17 (a5) — PASS 1: does fn `fi`'s body PROVABLY return ONE value? Then GFLG bit 1024, which
# `_dt_arity_check` (parse_decl.cyr) reads to refuse `var a, b = f();` — b took a stale rdx,
# silently, at fn scope and at top level. Recorded HERE so a forward call knows it. Conservative:
# a `ret2`, an `asm` block, a `?` or any `return` that is not provably one value (`_ret_stmt_single`)
# leaves the bit clear. Closure and nested-fn bodies are their own units. Cursor: past the
# signature; not moved.
fn _prescan_ret_single(S, fi): i64 {
    SFLG(S, fi, GFLG(S, fi) & (0 - 1025));
    var n = GTCNT(S);
    var i = GTI(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 13) { break; }
        if (t == 5 || t == 12) { return 0; }
        i = i + 1;
    }
    if (i >= n) { return 0; }
    var e = _tok_skip_block(S, i, n);
    var j = i + 1;
    while (j < e) {
        var u = TOKTYP(S, j);
        if (u == 13 || u == 32) {
            var sk = _skip_nested_body(S, j);
            if (sk >= 0) { j = sk; }
        }
        elif (u == 97 || u == 48 || u == 124) { return 0; }   # ret2, asm, `?`
        elif (u == 33) { if (_ret_stmt_single(S, j) == 0) { return 0; } }
        j = j + 1;
    }
    if (_body_ends_in_return(S, i, e) == 0) { return 0; }
    SFLG(S, fi, GFLG(S, fi) | 1024);
    return 0;
}
# 1 = the LAST statement of the body `{` at `o` .. `}` at `e` is a `return`. A body that can fall
# off its end returns whatever rax:rdx its last statement left (a call's pair, say), so it is
# not provably one value.
fn _body_ends_in_return(S, o, e): i64 {
    if (TOKTYP(S, e - 1) != 5) { return 0; }
    var bd = 0;
    var pd = 0;
    var first = 1;
    var lastk = 0;
    var j = o + 1;
    while (j < e) {
        var t = TOKTYP(S, j);
        if (first == 1) { lastk = t; first = 0; }
        if (t == 10 || t == 28) { pd = pd + 1; }
        elif (t == 11 || t == 29) { pd = pd - 1; }
        elif (t == 13) { bd = bd + 1; }
        elif (t == 14) { bd = bd - 1; if (bd == 0) { if (pd == 0) { first = 1; } } }
        elif (t == 5) { if (bd == 0) { if (pd == 0) { first = 1; } } }
        j = j + 1;
    }
    if (lastk == 33) { return 1; }
    return 0;
}
# 1 = the `return` at token k returns one value: `return;`, or an expression with no comma outside
# a bracket (a tuple `(a, b)` is two) that does not END in `)` — a whole call (`return f(..);`,
# `return x.m(..);`) forwards whatever its callee left in rax:rdx.
fn _ret_stmt_single(S, k): i64 {
    var n = GTCNT(S);
    var d = 0;
    var last = 0;
    var j = k + 1;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (d == 0 && t == 5) { j = n; }
        else {
            if (t == 10 || t == 28 || t == 13) { d = d + 1; }
            if (t == 11 || t == 29 || t == 14) { d = d - 1; }
            if (t == 31 && d <= 1) { return 0; }
            last = t;
            j = j + 1;
        }
    }
    if (last == 11) { return 0; }
    return 1;
}

# 6.6.16 — hand a pass-1 `#deprecated` (recorded by `_tl_deprecated(S, 0)`) to the fn just
# registered, so a call parsed BEFORE the definition warns. Pass 1 walks the definitions in
# pass 2's order (impl methods included), so this is the fn PARSE_FN_DEF will mark too; it
# only ORs bit 2 (value 4), which PARSE_FN_DEF ORs again. GFDM's one reader is
# `_DEPRECATED_WARN`, so nothing here reaches codegen. CHANGELOG [6.6.16]
fn _prescan_dep_take(S, fi): i64 {
    if (_pre_dep_pending == 0) { return 0; }
    SFLG(S, fi, GFLG(S, fi) | 4);
    SFDM(S, fi, _pre_dep_msg);
    _pre_dep_pending = 0;
    _pre_dep_msg = 0;
    return 0;
}

# ⛔ 6.6.10 — A TYPE THAT NAMES A GENERIC STRUCT INSTANCE IN A SIGNATURE (`: Box<Pt>`, and
# `: Box<T>` in a generic's instance) was classified by its BASE name and the `<..>` skipped. As a
# return type the fn returned the base `Box` — whose `v: T` is an 8-byte i64 — while its caller
# declared `Box<Pt>` (24 B, `v` a Pt): `var r: Box<Pt> = mk<Pt>(p); r.v.x` failed with "expected
# ';', got '.'", and a plain `fn mkp(x: Pt): Box<Pt>` was refused ("fn return struct-id differs
# from declared var type"). As a parameter type `r.v.x` failed the same way. The type now
# resolves exactly as a `var b: Box<Pt>` does (parse_decl.cyr): an ALL-i64 argument list is the
# base struct itself, anything else the deduped `Box$..` instance, with an instance's T bound.
# A generic's BASE keeps the base struct — its T is unbound in the signature, and pass 1 records
# the same, so a forward call agrees. A list naming something that does not resolve YET keeps
# the base, as before: pass 1 is source-ordered (the definition corrects it once the names are
# declared), and the signature is read more than once (the pre-parameter rough scan, pass 1), so
# this is not the place to report it. Cursor on the type name; NOT consumed. CHANGELOG [6.6.10]
fn _gtype_sid(S, fi, base): i64 {
    if (_MONOMORPH_OK == 0) { return base; }
    if (base <= 0) { return base; }
    if (TOKTYP(S, GTI(S) + 1) != 19) { return base; }
    if (GSTP(S, base - 1) == 0) { return base; }
    if (GFTP(S, fi) != 0) { if (_inst_conc0 == 0) { return base; } }
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    if (GFTP(S, fi) != 0) { _bind_generic_call(S, fi, _inst_conc0, _inst_conc1); }
    var r = base;
    if (_targs_resolvable(S, GTI(S) + 2) == 1) {
        var sv = GTI(S);
        r = _ret_targ_parse(S, base);
        STI(S, sv);
    }
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return r;
}
# ⛔ 6.6.10 (bite 7 review) — AN INSTANCE'S `: T` RETURN, T BOUND TO A STRUCT, returns THAT struct
# by value, exactly as a `: Pt` fn does (the rough scan and the return type both ask this). It was
# always the base's i64 — the instance handed back rax, which for an address-passed parameter is
# the caller's struct ADDRESS: `q = idp(p)` stored a pointer into `q.x`, `var q: Pt = idp(p)` said
# "no struct type in scope". `Str` keeps its rax heap-handle return through the same exclusion a
# written `: Str` gets (the rough scan's pair test). 0 = not an instance's struct-bound `: T`.
fn _gtype_tp_ret(S, fi, noff): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    if (_inst_conc0 == 0) { return 0; }
    var tp = GFTP(S, fi);
    if (tp == 0) { return 0; }
    var c = 0;
    if ((tp & 0xFFFFFFFF) == noff + 1) { c = _inst_conc0; }
    if (((tp >> 32) & 0xFFFFFFFF) == noff + 1) { c = _inst_conc1; }
    if (c <= 0) { return 0; }
    return c;
}
# `Name<a[, b]>` at the cursor (Name the generic struct `base`): its instance under the rule a
# `var x: Name<..>` declaration uses — ALL-i64 (or an unbound parameter) is the base struct itself,
# anything else the deduped `Name$..` instance. Consumes the type; leaves the explicit-call parse
# state it shares (`_ta_pending_gt`) as it found it.
fn _ret_targ_parse(S, base): i64 {
    var sv_gt = _ta_pending_gt;
    _ta_pending_gt = 0;
    STI(S, GTI(S) + 2);                  # the name, `<`
    var c0 = _parse_one_type_arg(S);
    var c1 = 0;
    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); c1 = _parse_one_type_arg(S); }
    _consume_gt(S);
    _ta_pending_gt = sv_gt;
    var inst = 0;
    if (c0 != 0 - 8 && c0 != 0) { inst = 1; }
    if (c1 != 0 && c1 != 0 - 8) { inst = 1; }
    if (inst == 0) { return base; }
    var g = _instantiate_generic_struct(S, base - 1, c0, c1);
    if (g > 0) { return g; }
    return base;
}
# A parameter typed `Name<..>` resolved to an instance: its address-passed bit follows the
# INSTANCE's size (`_param_wants_struct_ptr` sized the base by name).
fn _gtype_param_mask(S, mask, pc, base, inst): i64 {
    if (inst == base) { return mask; }
    if (pc >= 62) {   # 6.6.17 (a10): the overflow row (`_pmw`)
        _pm_row_clr(_cur_fn_ix, pc, 1);
        if (STRUCTSZ(S, inst - 1) > 8) { _pm_row_or(_cur_fn_ix, pc, 1); }
        return mask;
    }
    mask = mask & (0 - 1 - (1 << pc));
    if (STRUCTSZ(S, inst - 1) > 8) { mask = mask | (1 << pc); }
    return mask;
}

# 6.6.5 — the pre-PARSE_PROG "registered but never defined" warning, extracted from the
# three forks (main, main_win, main_cx) that each carried a copy of it inline.
#
# ⚠ The `GFFI == 0` half is REQUIRED, not cosmetic. It runs BEFORE PARSE_PROG, which is
# where relaxed-ordering fns (`fn` after the first top-level statement) are defined; now
# that pass 1 prescans those, every one of them is registered with its owner and still has
# offset -1 here. Without the guard, compiling cycc's own source warned about
# `_emit_decimal` and friends — a fn with a recorded owner is one pass 1 SAW A DEFINITION
# for, so it is not undefined, it is not defined YET. CHANGELOG [6.6.5]
fn _warn_undefined_prepass(S): i64 {
    var wfi = 0;
    var wfc = GFNC(S);
    while (wfi < wfc) {
        if (L64(_fnt_offsets + wfi * 8) < 0 && GFFI(S, wfi) == 0) {
            syscall(SYS_WRITE, 2, "warning: undefined function '", 29);
            PRSTR(S + 0xEC00000 + L64(_fnt_names + wfi * 8));
            syscall(SYS_WRITE, 2, "'\n", 2);
        }
        wfi = wfi + 1;
    }
    return 0;
}

# 6.6.9 — THE top-level directive dispatcher. The pass-1 scan (_tl_scan1) calls it with
# arm=0 (consume only), the pass-2 dispatch (_tl_scan2) and PARSE_PROG call it with arm=1
# (arm the pending flag PARSE_FN_DEF transfers onto the next fn). Returns 1 when the
# token at the cursor was a directive it handled, 0 otherwise.
#
# WHY ONE FN: each of the seven src/main*.cyr forks used to carry its own copy of this
# chain in both passes, plus PARSE_PROG's copy — fifteen copies. Only main.cyr's pass 2
# armed #must_use/#deprecated/#pure/#io/#alloc, so on the other six forks an attribute
# placed before the first top-level statement (where every library puts them) was
# consumed and IGNORED: no warning, rc 0. The same drift made #naked and #inline inert on
# four targets at 6.6.3, and left #assert out of five forks' pass 1 and every pass 2, so a
# top-level `#assert` ended the declaration phase and the next struct was refused.
# A new directive goes HERE, once. CHANGELOG [6.6.9]
fn _tl_directive(S, arm): i64 {
    var t = PEEKT(S);
    if (t == 107) { _tl_assert(S, arm); return 1; }
    if (t == 124) { _tl_deprecated(S, arm); return 1; }
    if (_tl_flag_tok(t) == 0) { return 0; }
    if (arm == 1) { _tl_arm(t); }
    STI(S, GTI(S) + 1);
    return 1;
}

# The one-token fn attributes: #regalloc #must_use #pure #io #alloc #naked #inline.
fn _tl_flag_tok(t): i64 {
    if (t == 109 || t == 122 || t == 125 || t == 126) { return 1; }
    if (t == 127 || t == 133 || t == 163) { return 1; }
    return 0;
}

# Arm the pending flag for a one-token fn attribute. #regalloc is armed on every fork:
# PARSE_FN_DEF's SFRA gate (`_AARCH64_BACKEND == 0`) and the picker's own cx gate keep it
# inert where the x86 picker does not exist — the same arming PARSE_PROG always did.
# ⚠ #naked is NOT armed on cx, in either position: a bytecode VM has no machine return
# address to leave unframed, so a naked body falls straight through into the next fn.
# lib/fdlopen.cyr's dl_setjmp/dl_longjmp rely on that (their cx arm is ordinary code with
# a framed `return 0`). PARSE_PROG used to arm it on cx after the first statement.
fn _tl_arm(t): i64 {
    if (t == 133) { if (_TARGET_CX == 0) { _naked_pending = 1; } return 0; }
    if (t == 109) { _regalloc_pending = 1; }
    if (t == 122) { _must_use_pending = 1; }
    if (t == 125) { _pure_pending = 1; }
    if (t == 126) { _io_pending = 1; }
    if (t == 127) { _alloc_pending = 1; }
    if (t == 163) { _inline_pending = 1; }
    return 0;
}

# #deprecated("msg"). The message is REQUIRED (the v5.6.4 design): arm=1 refuses a bare
# `#deprecated` by name wherever it sits — it used to be a silent no-op before the first
# statement and a hard error after it. On the error the cursor stays put, so the `fn`
# that follows is still parsed. Pass 1 (arm=0) consumes and reports nothing; since 6.6.16
# it also RECORDS a complete `( STRING )` for the fn it registers next (`_prescan_dep_take`)
# — a call parsed before the definition never saw the bit, which only pass 2 set. A bare
# or malformed one records nothing: pass 2 still refuses it. CHANGELOG [6.6.16]
fn _tl_deprecated(S, arm): i64 {
    STI(S, GTI(S) + 1);
    if (arm == 0) {
        if (PEEKT(S) == 10) {
            STI(S, GTI(S) + 1);
            var _pd_msg = 0 - 1;
            if (PEEKT(S) == 30) { _pd_msg = PEEKV(S); STI(S, GTI(S) + 1); }
            if (PEEKT(S) == 11) {
                STI(S, GTI(S) + 1);
                if (_pd_msg != 0 - 1) { _pre_dep_pending = 1; _pre_dep_msg = _pd_msg; }
            }
        }
        return 0;
    }
    if (PEEKT(S) != 10) {
        # Report at the directive, not at the `fn` after it, and name the fix. The cursor is
        # already on a clean token, so clear the panic latch instead of letting the next
        # fn body's first statement resync over real code — but only the latch THIS error
        # set. When an earlier, unresynced error already held it, ERR_MSG swallowed this one
        # and an unconditional clear un-suppressed that error's cascade (a struct error plus
        # a bare `#deprecated ) )` reported 2 errors, not 1). CHANGELOG [6.6.10]
        var _dp_was = _panic;
        STI(S, GTI(S) - 1);
        ERR_MSG(S, "#deprecated needs a message string: #deprecated(<why, and what to use instead>)", 79);
        if (_dp_was == 0) { _panic = 0; }
        STI(S, GTI(S) + 1);
        return 0;
    }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 30) { ERR_EXPECT(S, 30); return 0; }
    _deprecated_msg_pending = PEEKV(S);
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); return 0; }
    STI(S, GTI(S) + 1);
    _deprecated_pending = 1;
    return 0;
}

# #assert — arm=1 evaluates it through PARSE_STMT, which emits no code for it, so it stays a
# declaration-phase directive instead of the first statement. Pass 1 (arm=0) must consume
# EXACTLY the tokens PARSE_STMT's arm does — `#assert ATOM [OP ATOM] [,] <line tail>` —
# without evaluating (a sizeof may name a struct pass 1 has not registered yet). It used to
# skip only the #assert's own LINE, so a wrapped `#assert 1 == 1,\n  "msg";` left pass 1
# on the continuation, its scan stopped, and every later declaration went unregistered
# ("undefined variable" far below). CHANGELOG [6.6.9]
fn _tl_assert(S, arm): i64 {
    if (arm == 1) { PARSE_STMT(S); return 0; }
    STI(S, GTI(S) + 1);
    _assert_skip_atom(S);
    var op = PEEKT(S);
    if (op >= 17 && op <= 22) {
        STI(S, GTI(S) + 1);
        _assert_skip_atom(S);
    }
    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    _assert_tail(S);
    return 0;
}

# Pass 1's twin of _EVAL_CONST_ATOM: advance over the same tokens, evaluate nothing. A
# number is one token; `sizeof ( [T] )` is its four; an enum constant is `NAME` (one) or
# `Enum.NAME` (three, 6.6.10); anything else is an error pass 2 reports. `sizeof` is the
# whole word (_is_sizeof_word, 7 bytes), not a 6-byte prefix. CHANGELOG [6.6.10]
fn _assert_skip_atom(S): i64 {
    var t = PEEKT(S);
    if (t == 1) { STI(S, GTI(S) + 1); return 0; }
    if (t != 2) { return 0; }
    if (_is_sizeof_word(S, PEEKV(S)) != 1) {
        var ti = GTI(S);
        if (TOKTYP(S, ti + 1) == 41) { if (TOKTYP(S, ti + 2) == 2) { STI(S, ti + 3); return 0; } }
        STI(S, ti + 1);
        return 0;
    }
    _assert_step(S);
    _assert_step(S);
    if (PEEKT(S) == 2 || PEEKT(S) == 105) { _assert_step(S); }   # 6.6.16: `sizeof(u128)` too
    _assert_step(S);
    return 0;
}

# One token forward, never past EOF.
fn _assert_step(S): i64 {
    if (PEEKT(S) != 12) { STI(S, GTI(S) + 1); }
    return 0;
}

# 6.6.9 — the "large static data" advisory, on every backend that writes an executable.
# It used to live inline in x86 EMITELF_USER only, so the same `var buf[200000]` warned on
# x86_64 ELF and was silent on PE, both Mach-O targets, aarch64 and cx. `dvb`/`dcn` are the
# bytes of statics inside unreachable fns and how many such fns HOLD them (GFVB > 0), computed
# by _dead_static_stash (src/backend/common/runtime.cyr) from the x86 AND aarch64 liveness
# passes since 6.6.10; cx has no liveness pass and passes 0, so it skips the hint.
# CHANGELOG [6.6.9] [6.6.10]
fn _warn_large_static(totvar, dvb, dcn): i64 {
    if (totvar <= 131072) { return 0; }
    syscall(SYS_WRITE, 2, "warning: large static data (", 28);
    PRNUM(totvar);
    syscall(SYS_WRITE, 2, " bytes) — consider alloc() for buffers >4KB\n", 46);
    # CYRIUS_DCE=1 NOPs the CODE of dead fns but does NOT free their bss reservations —
    # users hitting this warning should know that "set CYRIUS_DCE=1" is NOT the fix.
    # CHANGELOG [5.11.62]
    if (dvb > 0) {
        syscall(SYS_WRITE, 2, "  hint: ", 8);
        PRNUM(dvb);
        syscall(SYS_WRITE, 2, " bytes inside ", 14);
        PRNUM(dcn);
        syscall(SYS_WRITE, 2, " unreachable fn(s) — DCE NOPs code but keeps .bss; restructure with alloc() or move the static into a reachable consumer\n", 123);
    }
    return 0;
}

# Byte size of the global var named exactly `lit` (a C string), or 0 when there is none.
# main_cx.cyr uses it to leave lib/alloc_cx.cyr's own heap out of the static-data advisory.
fn _gvar_bytes_named(S, lit): i64 {
    var vi = 0;
    var n = GVCNT(S);
    while (vi < n) {
        var p = S + 0xEC00000 + L64(_varn_base + vi * 8);
        var k = 0;
        while (load8(p + k) != 0 && load8(p + k) == load8(lit + k)) { k = k + 1; }
        if (load8(p + k) == 0 && load8(lit + k) == 0) { return L64(_vars_base + vi * 8); }
        vi = vi + 1;
    }
    return 0;
}

# 6.6.5 — intern `mod_name` ONCE. Writes the candidate at GNPOS WITHOUT committing; if an
# fn of exactly that name is already registered (pass 1 minted it), reuse THAT entry's
# string and leave the pool untouched, otherwise commit. mmod == 0 → noff unchanged, so
# the overwhelming majority of definitions take the old path byte-for-byte.
#
# This is the whole answer to "how does the pass-1 mangle coexist with pass 2's", which
# the filing called a design decision on the name pool: FINDFN compares by STRING, so a
# string minted in either pass serves both, and pool GROWTH is unchanged because the
# second mint is discarded. Lifted verbatim out of PARSE_FN_DEF (v5.11.65 CVE-05 length
# walk included) so there is one mangler, not two. CHANGELOG [6.6.5]
fn _mod_name_intern(S, mmod, noff): i64 {
    if (mmod == 0) { return noff; }
    var _mmlen = 0; while (load8(S + 0xEC00000 + mmod + _mmlen) != 0) { _mmlen = _mmlen + 1; }
    var _nflen = 0; while (load8(S + 0xEC00000 + noff + _nflen) != 0) { _nflen = _nflen + 1; }
    NPOS_GUARD(S, _mmlen + 1 + _nflen + 1);
    var mwp = GNPOS(S);
    var mnoff = mwp;
    var mri = 0;
    while (mri < _mmlen) { store8(S + 0xEC00000 + mwp, load8(S + 0xEC00000 + mmod + mri)); mwp = mwp + 1; mri = mri + 1; }
    store8(S + 0xEC00000 + mwp, 95); mwp = mwp + 1;   # '_'
    mri = 0;
    while (mri < _nflen) { store8(S + 0xEC00000 + mwp, load8(S + 0xEC00000 + noff + mri)); mwp = mwp + 1; mri = mri + 1; }
    store8(S + 0xEC00000 + mwp, 0); mwp = mwp + 1;
    var efi = FINDFN(S, mnoff);
    if (efi >= 0) {
        var en = L64(_fnt_names + efi * 8);
        if (en != mnoff) { if (STREQ(S, en, mnoff) == 1) { return en; } }
    }
    SNPOS(S, mwp);
    return mnoff;
}

# 6.6.5 — the ONE identity rule both passes use to pick the fn-table entry a DEFINITION
# owns. An existing entry belongs to this definition iff its privacy class matches and
# (for private) its owner is this file; otherwise a same-named definition from another
# file SPLITS into its own entry with bit 128 on both (the v6.5.38 sibling marker that
# makes `_findfn_scoped` pick per caller-file).
#
# ⚠ An entry with raw fid 0 is one a CALL SITE registered — it has no owner, so it is
# adopted, never split. An unattributable definition (vis_fid < 0, past the 1024-file map
# cap) is adopted too: splitting on an unknown owner creates a symbol `_findfn_scoped` can
# never select, which turns a working call into a silent rebind. Same carve-outs the
# v6.5.38 pass-2 split had; they are now in one place instead of inline in PARSE_FN_DEF.
fn _fn_def_slot(S, noff, vis_fid, this_priv): i64 {
    var fi = FINDFN(S, noff);
    if (fi < 0) { return REGFN(S, noff); }
    var raw = GFFI(S, fi);
    if (raw == 0) { return fi; }              # registered by a call site: adopt
    if (vis_fid < 0) { return fi; }           # unattributable: adopt (see above)
    var prev_priv = 0;
    if ((GFLG(S, fi) & 64) != 0) { prev_priv = 1; }
    if (this_priv == 0) { if (prev_priv == 0) { return fi; } }   # public over public
    if (raw - 1 == vis_fid) { return fi; }    # same file: a redefinition, not a collision
    var nfi = REGFN(S, noff);
    SFLG(S, fi, GFLG(S, fi) | 128);
    SFLG(S, nfi, GFLG(S, nfi) | 128);
    return nfi;
}

# 6.6.5 — the entry pass 1 registered for the definition whose `fn` token is `ti`, or -1.
# Walks the hash probe chain (a split leaves two entries under one name, both reachable
# from the same home slot) and matches on def-start AND name.
fn _fn_by_defti(S, noff, ti): i64 {
    var h = FNV1A_NOFF(S, noff);
    var slot = h & _fnt_hash_mask;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_namehash + slot * 4);
        if (stored == 0) { return 0 - 1; }
        var fi = stored - 1;
        if (GFDS(S, fi) == ti + 1) { if (STREQ(S, L64(_fnt_names + fi * 8), noff) == 1) { return fi; } }
        slot = (slot + 1) & _fnt_hash_mask;
        probes = probes + 1;
    }
    return 0 - 1;
}

# 6.6.5 — the VERBATIM pass-1 impl brace-skip the seven forks used to carry inline. Kept
# as its own fn so `_prescan_impl` can replay it and pass 1's net cursor advance is
# byte-identical to before.
fn _prescan_skip_impl(S): i64 {
    STI(S, GTI(S) + 1);  # consume IMPL
    STI(S, GTI(S) + 1);  # consume trait name
    STI(S, GTI(S) + 1);  # consume FOR
    STI(S, GTI(S) + 1);  # consume type name
    if (PEEKT(S) == 13) {
        STI(S, GTI(S) + 1);
        var idep = 0;
        var isk = 1;
        while (isk == 1) {
            var it = PEEKT(S);
            if (it == 13) { idep = idep + 1; }
            if (it == 14) { if (idep == 0) { isk = 0; } else { idep = idep - 1; } }
            if (it == 12) { isk = 0; }
            STI(S, GTI(S) + 1);
        }
    }
    return 0;
}

# 6.6.5 — pass-1 impl scan. Registers and stamps each method (`Type_method`) exactly as a
# top-level fn is prescanned, mirroring PARSE_IMPL's own `_pub_pending` clear and module
# set, then RESETS the cursor and replays the canonical skip. Replaces the inline
# "skip entire block in pass 1 (functions registered in pass 2)" arm in all seven forks —
# which is what made an impl method the one definition kind with no owner, no private bit
# and no parameter masks until pass 2 had walked past its callers. CHANGELOG [6.6.5]
fn _prescan_impl(S): i64 {
    var start_ti = GTI(S);
    _pub_pending = 0;                    # mirror PARSE_IMPL's entry clear
    STI(S, GTI(S) + 1);                  # IMPL
    if (PEEKT(S) == 2) {
        STI(S, GTI(S) + 1);              # trait
        if (PEEKT(S) == 55) {
            STI(S, GTI(S) + 1);          # for
            if (PEEKT(S) == 2) {
                var tn = PEEKV(S);
                STI(S, GTI(S) + 1);
                if (PEEKT(S) == 13) {
                    STI(S, GTI(S) + 1);
                    var sv = GMOD(S);
                    SMOD(S, tn);
                    _prescan_impl_body(S);
                    SMOD(S, sv);
                }
            }
        }
    }
    _pub_pending = 0;
    STI(S, start_ti);
    _prescan_skip_impl(S);
    return 0;
}

fn _prescan_impl_body(S): i64 {
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 14) { go = 0; }
        elif (t == 73) { _TL_VIS(S); }                 # `public` on a method
        elif (t == 153) { _TL_VIS(S); }                # `private` — marked by _PRIV_PRESCAN
        elif (t == 32) { _prescan_fn_sig(S); }
        elif (_tl_directive(S, 0) == 1) { }            # 6.6.17: directives on a method (_impl_attrs)
        else { go = 0; }
    }
    return 0;
}

# 6.6.5 — skip ONE top-level statement, tracking ( { [ depth. Stops after a depth-0 `;`,
# or after a depth-0 `}` that is not followed by `else`/`elif` (a statement can end in a
# brace: `if (..) { .. } else { .. }`, `while`, `switch`, `match`). Returns 1 when the
# statement held a `fn` keyword — a definition PARSE_PROG will parse inside it (6.6.16).
fn _prescan_skip_stmt(S): i64 {
    var dep = 0;
    var go = 1;
    var hasfn = 0;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { return hasfn; }                              # EOF
        if (t == 32) {
            hasfn = 1;
            # 6.6.17 — a definition at statement position INSIDE the statement's block
            # (`if (..) { fn f(..) { .. } }`, which PARSE_PROG accepts) is prescanned like a
            # top-level one. It was skipped, so a call parsed before it warned "undefined
            # function" and — the same miscompile 6.6.5 fixed after the first statement — an
            # address-passed struct argument was pushed by value: rc 139. CHANGELOG [6.6.17]
            if (_prescan_block_fn(S, dep) == 1) { continue; }
        }
        # An attribute group before such a fn: `#deprecated("…")` is RECORDED for it, as the
        # top-level loop does, so a call parsed before the definition still warns. The one-token
        # attributes (`#pure` `#inline` …) need nothing in pass 1 and are skipped as tokens.
        if (t == 124) { if (dep >= 1) { _tl_deprecated(S, 0); continue; } }
        if (t == 10 || t == 13 || t == 28) { dep = dep + 1; }
        if (t == 11 || t == 14 || t == 29) { dep = dep - 1; }
        STI(S, GTI(S) + 1);
        if (dep <= 0) {
            if (t == 5) { go = 0; }
            elif (t == 14) {
                var nt = PEEKT(S);
                if (nt != 23 && nt != 50) { go = 0; }
            }
        }
    }
    return hasfn;
}

# Prescan the `fn NAME` at the cursor when it sits inside a block (`dep` >= 1) — after `{`, `;`,
# `}`, an attribute (`#pure fn …`, the reviewer's find: it used to require one of the first
# three) or a `case X:`. `fn` is never an expression, so any `fn NAME` in a block is a
# definition PARSE_PROG accepts or refuses (a fn in a closure body); prescanning one it refuses
# is harmless, the compile fails there. The signature walk consumes the whole definition, braces
# balanced, so the caller's depth is unchanged. Returns 1 when it consumed one.
fn _prescan_block_fn(S, dep): i64 {
    if (dep < 1) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
    _prescan_fn_sig(S);
    return 1;
}

# 6.6.5 — pass 1 stops at the first top-level STATEMENT (_tl_scan1 returns 0), but
# PARSE_PROG keeps accepting `fn` definitions after it — relaxed ordering. So every fn
# below the first statement was unstamped: reachable from any file by a preceding call,
# and address-passed struct params silently miscompiled. This walks the REST of the stream
# registering only those fns; statements are skipped (a top-level `var` registers itself
# on the PARSE_PROG path, so it must NOT be handled here).
#
# The cursor and module are saved and restored, so pass 2 starts exactly where it did.
# SMOD(0) because PARSE_PROG runs after pass 2's module reset. CHANGELOG [6.6.5]
fn _prescan_tail(S): i64 {
    var sv = GTI(S);
    var svmod = GMOD(S);
    SMOD(S, 0);
    _pub_pending = 0;
    _prescan_tail_loop(S);
    _pub_pending = 0;
    _pre_dep_pending = 0;                # the end of pass 1: nothing may carry into pass 2
    SMOD(S, svmod);
    STI(S, sv);
    return 0;
}

fn _prescan_tail_loop(S): i64 {
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { go = 0; }                       # EOF
        # ⚠ _IS_FN_KW, not a bare `t == 32`: the pass-1 scan (_tl_scan1) asks _IS_FN_KW, so a
        # bare test here would make the two scanners disagree about what a DEFINITION is and
        # an `async fn` after the first top-level statement would stay unstamped. Not
        # reachable today (PARSE_PROG rejects `async` there on 6.6.4 and on this build), and
        # _prescan_fn_sig already consumes the `async` prefix — the two scanners agreeing is
        # the point. CHANGELOG [6.6.5]
        elif (_IS_FN_KW(S) == 1) { _prescan_fn_sig(S); }
        elif (t == 14) { go = 0; }                     # stray '}' — where PARSE_PROG stops
        elif (t == 109 || t == 122 || t == 125 || t == 126 || t == 127 || t == 133 || t == 163) { STI(S, GTI(S) + 1); }
        elif (t == 124) { _tl_deprecated(S, 0); }       # the pass-1 arm itself, so it records too
        # ⚠ 6.6.16 — a statement holding a `fn` (a definition inside a top-level block, which
        # PARSE_PROG accepts) is where pass 2 hands a pending `#deprecated`. Since 6.6.17 that fn
        # is prescanned (`_prescan_block_fn`), which takes the pending itself; whatever is left
        # is dropped here rather than let it land on the NEXT top-level fn — the one pass 2
        # leaves unmarked, whose every call would then warn falsely.
        elif (_prescan_skip_stmt(S) == 1) { _pre_dep_pending = 0; }
    }
    return 0;
}

# 6.6.17 — THE top-level declaration scans, shared by all seven src/main*.cyr forks: pass 1
# (register), pass 2 (define) and the enum-init walk. Each fork used to carry its own copy of
# all three — 21 loops — so a new top-level form had to be added seven times, and the fork
# that missed it broke on its own target only (#io v5.8.20, #pure v6.2.2, the 6.6.3 #inline
# consume, the 6.6.9 directive arms). A new top-level form goes HERE, once; the
# toplevel_scan_shared gate refuses a fork that re-grows a copy. `objok` is 1 on the two
# forks with an object writer (main.cyr, main_win.cyr): there `object;` selects mode 3;
# elsewhere it is not a declaration and ends the scan ("unexpected object"). CHANGELOG [6.6.17]
fn _tl_pass1(S, objok): i64 {
    STI(S, 0);
    var go = 1;
    while (go == 1) { go = _tl_scan1(S, objok); }
    # pass 1 stops at the first top-level statement, but PARSE_PROG keeps defining fns after it
    _prescan_tail(S);
    SMOD(S, 0);
    return 0;
}

# One pass-1 step: consume one top-level declaration and return 1, or return 0 at the first
# token that is not one (the first statement). The arms only peek until they match.
fn _tl_scan1(S, objok): i64 {
    var t = PEEKT(S);
    if (t == 72) { _tl_mod(S); return 1; }
    if (_TL_VIS(S) == 1) { return 1; }
    if (t == 74) { _tl_use(S); return 1; }
    if (t == 40) { PARSE_STRUCT_DEF(S); return 1; }
    if (t == 101) { PARSE_UNION_DEF(S); return 1; }
    if (t == 3) { PARSE_GVAR_REG(S); return 1; }
    if (_tl_directive(S, 0) == 1) { return 1; }
    if (_IS_FN_KW(S) == 1) { _prescan_fn_sig(S); return 1; }   # v6.3.5 CO-01: register + ABI masks
    if (t == 60) { PARSE_ENUM_DEF(S, 0); return 1; }
    var r = _tl_scan1_mode(S, t, objok);
    return r;
}

fn _tl_scan1_mode(S, t, objok): i64 {
    if (_TOK_IS_KERNEL(S) == 1) { _tl_kmode(S, 1); return 1; }
    if (t == 78) { _tl_kmode(S, 2); return 1; }
    if (t == 79) { if (objok == 1) { _tl_kmode(S, 3); return 1; } }
    if (t == 77) { _prescan_impl(S); return 1; }
    return 0;
}

# `kernel;` / `shared;` / `object;` — set kernel_mode (pass 1). Pass 2 only skips them.
fn _tl_kmode(S, m): i64 {
    S64(S + 0x18FCA0, m);
    _tl_skip_mode(S);
    return 0;
}

fn _tl_skip_mode(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# `mod name;` — set the module prefix (both passes).
fn _tl_mod(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# `use modname.funcname;` — register the alias funcname -> modname_funcname (pass 1).
fn _tl_use(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) == 2) {
        var umod = PEEKV(S);
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 41) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) == 2) {
                var ufn = PEEKV(S);
                STI(S, GTI(S) + 1);
                _tl_use_alias(S, umod, ufn);
            }
        }
    }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# Append the mangled `mod_fn` to tok_names (NPOS is stable after lexing) and record the alias
# in the use table. v5.11.65 (CVE-05): bounded by the actual source lengths.
fn _tl_use_alias(S, umod, ufn): i64 {
    var uc = GUSEC(S);
    S64(S + 0x18FFD0 + uc * 8, ufn);
    var _ulen1 = 0; while (load8(S + 0xEC00000 + umod + _ulen1) != 0) { _ulen1 = _ulen1 + 1; }
    var _ulen2 = 0; while (load8(S + 0xEC00000 + ufn + _ulen2) != 0) { _ulen2 = _ulen2 + 1; }
    NPOS_GUARD(S, _ulen1 + 1 + _ulen2 + 1);
    var apos = GNPOS(S);
    var ri = 0;
    var rc = load8(S + 0xEC00000 + umod + ri);
    while (rc != 0) { store8(S + 0xEC00000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0xEC00000 + umod + ri); }
    store8(S + 0xEC00000 + apos, 95); apos = apos + 1;
    ri = 0; rc = load8(S + 0xEC00000 + ufn + ri);
    while (rc != 0) { store8(S + 0xEC00000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0xEC00000 + ufn + ri); }
    store8(S + 0xEC00000 + apos, 0); apos = apos + 1;
    var alias_noff = GNPOS(S);
    SNPOS(S, apos);
    S64(S + 0x1901D0 + uc * 8, alias_noff);
    SUSEC(S, uc + 1);
    return 0;
}

# Pass 2: define fns, impls and enum constructors; skip what pass 1 already registered.
fn _tl_pass2(S, objok): i64 {
    STI(S, 0);
    var go = 1;
    while (go == 1) { go = _tl_scan2(S, objok); }
    SMOD(S, 0);
    return 0;
}

fn _tl_scan2(S, objok): i64 {
    var t = PEEKT(S);
    if (t == 72) { _tl_mod(S); return 1; }
    if (_TL_VIS(S) == 1) { return 1; }
    if (t == 74) { _tl_skip_use(S); return 1; }
    if (t == 40) { _tl_skip_struct(S); return 1; }
    if (t == 101) { _tl_skip_union(S); return 1; }
    if (t == 60) { PARSE_ENUM_DEF(S, 2); return 1; }   # constructor bodies, before the jmp patch
    if (_TOK_IS_KERNEL(S) == 1) { _tl_skip_mode(S); return 1; }
    # 6.6.9: ONE dispatcher arms every fn attribute and evaluates #assert. See _tl_directive.
    if (_tl_directive(S, 1) == 1) { return 1; }
    var r = _tl_scan2_def(S, t, objok);
    return r;
}

fn _tl_scan2_def(S, t, objok): i64 {
    if (_IS_FN_KW(S) == 1) {
        # v6.5.17: EVERY fn body is parsed, reachable or not — reachability is a codegen
        # concern (CYRIUS_DCE=1, backend/x86/fixup.cyr), not a parsing one. A parse-time body
        # skip once made garbage in an uncalled fn compile GREEN on x86 and fail on aarch64
        # (tests/gates/frontend/dead_fn_body_syntax_checked.sh).
        # v6.3.11 (G): consume a leading `async` and arm the lowering PARSE_FN_DEF consumes.
        if (PEEKT(S) == 134) { _pending_async = 1; STI(S, GTI(S) + 1); }
        PARSE_FN_DEF(S);
        return 1;
    }
    if (t == 3) { _skip_gvar_decl(S); return 1; }   # 6.6.6: a `;` inside a closure body is not the end
    if (t == 77) { PARSE_IMPL(S); return 1; }
    if (t == 78) { _tl_skip_mode(S); return 1; }
    if (t == 79) { if (objok == 1) { _tl_skip_mode(S); return 1; } }
    return 0;
}

fn _tl_skip_use(S): i64 {
    while (PEEKT(S) != 5) { if (PEEKT(S) == 12) { break; } STI(S, GTI(S) + 1); }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# A struct (with its optional `<T>` list) or a union was parsed in pass 1: skip to its `}`.
fn _tl_skip_struct(S): i64 {
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
    _tl_skip_body(S);
    return 0;
}

fn _tl_skip_union(S): i64 {
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    _tl_skip_body(S);
    return 0;
}

fn _tl_skip_body(S): i64 {
    if (PEEKT(S) != 13) { ERR(S); }
    STI(S, GTI(S) + 1);
    var go = 1;
    while (go == 1) { if (PEEKT(S) == 14) { go = 0; } else { STI(S, GTI(S) + 1); } }
    STI(S, GTI(S) + 1);
    return 0;
}

# Enum initialisations, emitted FIRST (before the gvar inits, which may call fns that read
# enum values). Walks the whole token stream; the caller restores the cursor.
fn _tl_enum_inits(S): i64 {
    STI(S, 0);
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 1); }
        else { if (PEEKT(S) == 12) { go = 0; }
            else { STI(S, GTI(S) + 1); } }
    }
    return 0;
}

# v6.3.11 (G): mint `base$impl` — the hidden body-fn name for an `async fn`. The
# user-facing name `base` becomes the Future constructor; `base$impl` holds the
# actual body and is only ever reached by pointer (future_force), never by name.
fn _mint_impl_name(S, base_noff): i64 {
    var blen = 0;
    while (load8(S + 0xEC00000 + base_noff + blen) != 0) { blen = blen + 1; }
    NPOS_GUARD(S, blen + 8);
    var wp = GNPOS(S);
    var noff = wp;
    var i = 0;
    while (i < blen) { store8(S + 0xEC00000 + wp, load8(S + 0xEC00000 + base_noff + i)); wp = wp + 1; i = i + 1; }
    store8(S + 0xEC00000 + wp, 36); wp = wp + 1;    # '$'
    store8(S + 0xEC00000 + wp, 105); wp = wp + 1;   # 'i'
    store8(S + 0xEC00000 + wp, 109); wp = wp + 1;   # 'm'
    store8(S + 0xEC00000 + wp, 112); wp = wp + 1;   # 'p'
    store8(S + 0xEC00000 + wp, 108); wp = wp + 1;   # 'l'
    store8(S + 0xEC00000 + wp, 0); wp = wp + 1;
    SNPOS(S, wp);
    return noff;
}

# 6.6.10 — THE ARGC WORD CARRIES TWO MARKERS, so `future_force` can tell the three Future
# shapes apart without rewriting anything during a force (lib/async.cyr, lockstep):
#   FUT_MEMO (256) — a PLAIN compiler-built Future `[fp, argc, args…, done, value]`: forced once,
#                    and every later force answers from the memo. It used to re-run the body on
#                    every force (`await F; await F;` ran it twice), while a coroutine did not.
#   FUT_CORO (512) — a coroutine. Its impl takes exactly ONE argument, SELF at obj[16], so the
#                    arity is 1 whatever the declared parameter count; storing `pc` there made a
#                    0-parameter coroutine SIGSEGV (fncall0 left SELF garbage) and a 9+-parameter
#                    one exit 70 at its first force.
# A hand-built Future (`[fp, argc, args…]`, argc 0..8) carries neither and is re-run per force.
fn _async_argc_word(pc): i64 {
    if (_coro_was == 1) { return 1 | 512; }
    return pc | 256;
}
# 6.6.10 — `future_force`'s dispatch ladder stops at fncall8, so a PLAIN async fn with 9+
# parameters compiled clean and died at its first force (exit 70). Refuse it at the declaration.
# A coroutine has no limit: its arguments are frame locals and its impl takes SELF alone.
fn _async_refuse_arity(S, fi_f, noff_f, pc): i64 {
    if (_coro_was == 1) { return 0; }
    if (pc <= 8) { return 0; }
    if (_panic == 1) { return 1; }
    syscall(SYS_WRITE, 2, "error:", 6);
    var dti = GFDS(S, fi_f) - 1;
    if (dti >= 0) { _err_head_at(S, dti); } else { _err_head(S); }
    syscall(SYS_WRITE, 2, ": async fn `", 12);
    PRSTR(S + 0xEC00000 + noff_f);
    syscall(SYS_WRITE, 2, "` takes ", 8);
    PRNUM(pc);
    syscall(SYS_WRITE, 2, " parameters; an async fn that never awaits takes at most 8 (its Future is forced through fncall0..fncall8)\n", 107);
    _had_error = 1;
    return 1;
}

# 6.6.20 — the constructor's entry is set through `_fn_redirect`, like a plain definition's: an
# `async fn` redefined by another `async fn` binds every call to the LAST constructor (a call
# compiled between the two baked the first one's entry, whose Future shape may not even match —
# a plain Future against a coroutine's SIGSEGV'd). `async` against plain is refused in pass 1
# (`_dsg_async_check`). CHANGELOG [6.6.20]
fn _async_ctor_entry(S, fi_f, noff_f): i64 {
    var ti = GFDS(S, fi_f) - 1;   # its `fn` token, for the backstop's diagnostic
    if (ti < 0) { ti = 0; }
    _fn_redirect(S, fi_f, noff_f, ti);
    S64(_fnt_offsets + fi_f * 8, GCP(S));
    return 0;
}
# v6.3.11 (G): emit the Future constructor for an `async fn`. The body has already
# been emitted (as `f$impl`, fi_impl, with pc params); this synthesizes the
# user-named fn `f(p0..p{pc-1})` whose body allocates a Future heap object
# `[ &f$impl, pc, p0, … ]` and returns its pointer. Calls to `f` therefore build a
# deferred Future instead of running the body; `await fut` forces it (future_force).
# Mirrors the closure env construction (alloc + fn-addr fixup + field stores), but
# the captured values are the call's actual arguments and the dispatch is fncallN
# (future_force) rather than the hidden-env callptr convention. Needs lib/alloc.cyr.
fn _async_emit_constructor(S, noff_f, fi_impl, pc): i64 {
    var alloc_fi = _FINDFN_CSTR(S, "alloc", 5);
    var fi_f = FINDFN(S, noff_f);
    if (fi_f < 0) { fi_f = REGFN(S, noff_f); }
    SFAS(S, fi_f, 1);
    S64(_fnt_params + fi_f * 8, pc);
    if (_async_refuse_arity(S, fi_f, noff_f, pc) == 1) {
        _async_ctor_entry(S, fi_f, noff_f);
        return 0;
    }
    # Refused BEFORE any code: ERR_MSG does not exit, and the body below handed -1 to
    # ECALLFIX — rc 139 on aarch64/cx after the diagnostic. `f` still gets an offset (nothing
    # is written for a failed compile) so its callers do not add a second, false "reachable
    # undefined function" refusal. CHANGELOG [6.6.9]
    if (alloc_fi < 0) {
        ERR_MSG(S, "an async fn needs include \"lib/alloc.cyr\" for its Future heap object", 68);
        _async_ctor_entry(S, fi_f, noff_f);
        return 0;
    }
    # --- save enclosing (top-level) state; the constructor is its own fn ---
    # 6.6.7 — through the shared per-fn snapshot (parse.cyr `_fnst_save`), which zeroes the
    # parameter span, regalloc, ret class and the rest, and gives the constructor its own
    # return-patch and defer ranges. (6.6.6 had to add `_cur_fn_pslots` here by hand after the
    # list drifted; the shared snapshot is what stops the next one drifting.) CHANGELOG [6.6.7]
    var st = _fnst_save(S);
    _cur_fn_ix = fi_f;
    # 6.6.11: no skip-jmp before the constructor. Every caller is either unreachable by
    # fall-through here (the previous byte is f$impl's `ret`) or already jumps over the whole
    # definition (PARSE_PROG's fn_skip, the generic re-emit). The jmp sat in no fn's range,
    # so the DCE seed pass took it as a root and kept the NEXT fn alive. CHANGELOG [6.6.11]
    _async_ctor_entry(S, fi_f, noff_f);
    EFNPRO(S);
    # params p0..p{pc-1} → anonymous local slots 0..pc-1
    # ⛔ v6.5.70: this used to read `if (i < 6) { ESTOREPARM(S, i, i, 0); }` — TWO defects in
    # one line, and together they made `async fn` SILENTLY WRONG at arity >= 7. Parameters
    # past the sixth arrive on the STACK, so gating the call skipped homing them entirely and
    # the `obj[16 + i*8]` writes below then copied uninitialised frame slots into the Future.
    # And the arity argument was hard-coded 0, which is what `ESTORESTACKPARM` needs to compute
    # the SysV stack-arg displacement, so even an un-gated call would have addressed the wrong
    # slot. Measured: `await a7(1,2,3,4,5,6,7)` returned a code-address-shaped value instead of
    # 28 — exit 0, no diagnostic — while the 6-parameter async form and the PLAIN 7-parameter
    # fn were both correct in the same program.
    # `ESTOREPARM` already dispatches to `ESTORESTACKPARM` past the register args (4 on Win64,
    # 6 on SysV); it only ever needed to be called and told the arity. CHANGELOG [6.5.70]
    var i = 0;
    while (i < pc) {
        S64(S + 0x5D9D000 + i * 8, 0 - 1);
        SLDEP(S, i, 0);
        ESTOREPARM(S, i, i, pc);
        SFLC(S, i + 1);
        i = i + 1;
    }
    var frame_patch = ESUBRSP(S);
    # v6.5.69: a COROUTINE's object is also its FRAME, so it is sized for the body's locals
    # rather than just its arguments: [fp, argc, SELF, state, local0 … local{flc-1}].
    # ⛔ Getting this wrong is a heap overflow, not a wrong answer: the transform stores the
    # state word at +24 and locals from +32, and the pre-v6.5.69 object is (2+pc)*8 = 24
    # bytes for a 1-parameter fn — the state write alone lands one word past the allocation.
    # 6.6.10: a PLAIN Future also carries two trailing memo words `[done, value]` (see
    # `_async_argc_word`); a coroutine already keeps its completion past the frame.
    var _obj_bytes = (2 + pc) * 8 + 16;
    if (_coro_was == 1) { _obj_bytes = _coro_res_off() + 8; }   # 6.6.8: + the completion word
    # obj = alloc(_obj_bytes)
    EMOVI(S, _obj_bytes);
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, alloc_fi);
    ECALLCLEAN(S, 1);   # 6.6.5: was missing (see ECALLCLEAN)
    var obj_slot = pc;
    S64(S + 0x5D9D000 + obj_slot * 8, 0 - 1);
    SLDEP(S, obj_slot, 0);
    EFLSTORE(S, obj_slot);
    SFLC(S, obj_slot + 1);
    # obj[0] = &f$impl  (fixup-resolved code address)
    EFLLOAD(S, obj_slot);
    EPUSHR(S);
    var fc = GFCNT(S);
    if (fc >= 1048576) {
        syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
        syscall(SYS_EXIT, 1);
    }
    ELOAD_FN_ADDR(S, _fixup_base + fc * 16, fc, fi_impl);
    EPOPC(S);
    ESTORE64(S);
    # obj[8] = the argc word (pc | FUT_MEMO, or 1 | FUT_CORO — `_async_argc_word`)
    EFLLOAD(S, obj_slot);
    EADDRA_IMM(S, 8);
    EPUSHR(S);
    EMOVI(S, _async_argc_word(pc));
    EPOPC(S);
    ESTORE64(S);
    # v6.5.69: a coroutine's arg0 is the object ITSELF. `future_force` re-enters the body as
    # `fncall1(fp, obj[16])`, so storing SELF there is what hands the body its own frame on
    # every resume — the runtime needs no change at all. The state word starts at 0, which the
    # fn-end dispatch maps to the top of the real body.
    if (_coro_was == 1) {
        EFLLOAD(S, obj_slot);
        EADDRA_IMM(S, 16);
        EPUSHR(S);
        EFLLOAD(S, obj_slot);
        EPOPC(S);
        ESTORE64(S);                       # obj[16] = SELF
        EFLLOAD(S, obj_slot);
        EADDRA_IMM(S, _CORO_STATE_OFF);
        EPUSHR(S);
        EMOVI(S, 0);
        EPOPC(S);
        ESTORE64(S);                       # obj[state] = 0
        # The user's arguments become the coroutine's first frame locals. The body's
        # parameters occupy slots 1..pc (slot 0 is the reserved frame base), and slot k maps
        # to `_CORO_LOCAL_OFF + (k - 1) * 8` — so argument i lands exactly where parameter i
        # will read it. v6.5.70.
        var _ci = 0;
        while (_ci < pc) {
            EFLLOAD(S, obj_slot);
            EADDRA_IMM(S, _CORO_LOCAL_OFF + _ci * 8);
            EPUSHR(S);
            EFLLOAD(S, _ci);
            EPOPC(S);
            ESTORE64(S);
            _ci = _ci + 1;
        }
    }
    # obj[16 + i*8] = arg i (the constructor's param, captured by value)
    i = 0;
    if (_coro_was == 1) { i = pc; }        # a coroutine captures no positional args yet
    while (i < pc) {
        EFLLOAD(S, obj_slot);
        EADDRA_IMM(S, 16 + i * 8);
        EPUSHR(S);
        EFLLOAD(S, i);
        EPOPC(S);
        ESTORE64(S);
        i = i + 1;
    }
    # obj[16 + pc*8] = 0: the memo's `done` word. alloc does not promise zeroed memory (a
    # freelist / arena hands back used blocks), and a stale 1 would answer the first force with
    # a stale value. CHANGELOG [6.6.10]
    if (_coro_was == 0) {
        EFLLOAD(S, obj_slot);
        EADDRA_IMM(S, 16 + pc * 8);
        EPUSHR(S);
        EMOVI(S, 0);
        EPOPC(S);
        ESTORE64(S);
    }
    # return obj
    EFLLOAD(S, obj_slot);
    EFNEPI(S);
    var fsz = (GFLC(S) * 8 + 15) & (0 - 16);
    EPATCHFRAME(S, frame_patch, fsz);
    SFNE(S, fi_f, GCP(S));
    # --- restore enclosing state ---
    _fnst_restore(S, st);
    return 0;
}

# v6.5.0 Phase 1 — `CYRIUS_FILEID_DUMP=1` prints `<fileid> <fnname>` per definition.
#
# This exists so the substrate is VERIFIABLE and, just as importantly, so it is not
# WRITE-ONLY. The v6.4.82 closeout audit found `_fnt_is_async` had exactly one
# occurrence of its getter repo-wide — its own definition — meaning it lazily allocates
# 256 KB that nothing ever reads. A "recorded, not enforced" phase is precisely how a
# table ends up in that state, so Phase 1 ships its own reader and its own gate rather
# than waiting for Phase 2 to justify it retroactively.
#
# `-1` prints for an unrecorded/overflowed fn; see FM_FILEID's fail-closed note.
# Split into its own fn (not inlined at the record site) because PARSE_FN_DEF is
# already large and cybs mis-compiles fns carrying too many global/literal references —
# the `_var_grow` / `TOKNAME_BUILTIN` / `PP_FNAME_TOO_LONG` precedent. seed-derive is
# the gate that catches that, and it is run below.
var _fileid_dump = 0;
var _fileid_dump_init = 0;

fn _fileid_dump_note(S, fi, noff): i64 {
    PRNUM(GFFI(S, fi) - 1);
    syscall(SYS_WRITE, 2, " ", 1);
    # v6.5.0 Phase 2: also surface the visibility bit, so the gate can assert on the
    # decision and not merely on the file partition.
    if ((GFLG(S, fi) & 64) != 0) { syscall(SYS_WRITE, 2, "P ", 2); }
    else { syscall(SYS_WRITE, 2, "- ", 2); }
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "\n", 1);
    return 0;
}

fn _fileid_dump_arm(): i64 {
    if (_fileid_dump_init != 0) { return _fileid_dump; }
    _fileid_dump_init = 1;
    var e = _read_env("CYRIUS_FILEID_DUMP");
    if (e != 0) { if (load8(e) == 49) { if (load8(e + 1) == 0) { _fileid_dump = 1; } } }
    return _fileid_dump;
}

# 6.6.6 — A STACK-PASSED PARAMETER IS HOMED BY THE LOOP THAT CLASSIFIED IT. PARSE_FN_DEF's
# parameter loop is the only place that knows each parameter's arg ordinal (the CALLER's
# int-class position: `int_pc`, +1 for an x86 retptr) and its frame slot (`li`, which a value
# vector's filler slots push past its position). Past the register ceiling it cannot home the
# value yet — SysV/aarch64 stack slots count DOWN from the caller's int-class TOTAL — so it
# records (ordinal, slot) here and `_stkp_flush` homes them once the total is known. The old
# post-loop re-derived all three from `pc`, the all-class count: right only when every param is
# int-class, one slot, and there is no retptr. A value-form vector made it read the wrong
# register/stack slot INTO the wrong frame slot (`n6(v, 1..6)` read `e` as 0), a retptr made it
# read the return address, and it homed a coroutine impl's params, which the loop had refused
# (they arrive in the coroutine frame). CHANGELOG [6.6.6]
var _stkp_vec = 0;
# 6.6.17 (a10): and the fn's parameter-kind overflow row (`_pmw`) — the definition's own loop
# rewrites it, as the S64 stores rewrite the masks; pass 1's row must not survive under it (on PE,
# pass 1 runs before `_TARGET_PE` is set and records SysV shapes). Called once, at the top of
# the parameter loop, with `_cur_fn_ix` already the fn being defined.
fn _stkp_reset(): i64 {
    if (_stkp_vec == 0) { _stkp_vec = vec_new(); }
    vec_truncate(_stkp_vec, 0);
    _pm_row_reset(_cur_fn_ix);
    return 0;
}
fn _stkp_defer(pidx, li): i64 {
    vec_push(_stkp_vec, (pidx << 32) | li);
    return 0;
}
fn _stkp_flush(S, nint): i64 {
    var n = vec_len(_stkp_vec);
    var k = 0;
    while (k < n) {
        var e = vec_get(_stkp_vec, k);
        ESTOREPARM(S, e >> 32, e & 0xFFFFFFFF, nint);
        k = k + 1;
    }
    return 0;
}

# v6.5.19 (CVE-40): the fn-definition tier. `fn f() { ` repeated 514 times SIGSEGV'd —
# the cheapest of the six vectors at ~16 KB of stack per level, and the one neither the
# PARSE_STMT nor the PEXPR bound caught, because a nested definition recursed through
# THIS function rather than the statement wrapper (a top-level `fn` is dispatched from
# PARSE_PROG, and a nested one re-entered here until 6.6.16 refused it — parse.cyr
# `_refuse_nested_fn`). Wrapper shape identical to the other three chokepoints. See
# _rd_enter (src/common/util.cyr).
fn PARSE_FN_DEF(S): i64 {
    _rd_enter(S);
    # 6.6.5 — a fn body is emitted with its OWN frame, so its expression depth starts at 0
    # regardless of where the definition was encountered. That matters because a body can be
    # emitted MID-EXPRESSION: a closure literal in an argument position emits the closure's
    # body inline. Save, zero, check against 0 on the way out, restore.
    var _xd_outer = _xdepth;
    _xdepth = 0;
    # ⚠ 6.6.5 — there is deliberately NO UEFI firmware-return flag saved/zeroed here. One
    # was, for a round: the reasoning was "a `ret` inside a body returns to the cyrius
    # caller, not to firmware", which is true of a RETURN but not of an EXIT —
    # `syscall(60, x)` in a fn body must still reach firmware, and with the flag cleared it
    # emitted a bare 0xC3 at `rbp - fsz` and #GP'd under OVMF. EEXIT restores the parked
    # entry rsp instead, which is depth-independent, so there is nothing per-body to track.
    # See src/common/util.cyr for the whole post-mortem. CHANGELOG [6.6.5]
    var _rf = _PARSE_FN_DEF_IMPL(S);
    _rd_exit();
    _xd_check(S, 0, "fn body");
    _xdepth = _xd_outer;
    return _rf;
}

# 6.6.20 — "LAST DEFINITION WINS" FOR EVERY REFERENCE, NOT ONLY THE ONES THE FIXUP PASS SEES.
# A call to an already-defined fn is emitted against the entry it has at that moment (ECALLTO
# bakes the offset — fifteen frontend sites, plus `main` calls, vtables and every other shape
# that reads `_fnt_offsets` directly), while forward calls, tail calls and `&fn` go through
# fixups that resolve to the final entry. So `fn g` / `fn h() { var x = g(); }` / `fn g` bound
# h to the FIRST g while the warning promised the last, on x86, aarch64 and cx alike. Rather
# than re-route every site through a fixup (which changes the fixup and per-fn jump tables, and
# so the bytes, of programs with no redefinition), the earlier entry is made a jump to the new
# one when the redefinition's body starts: every reference to it, of whatever shape, follows.
# Chains (a third definition) are jumps to jumps. The jump lies outside every fn's range, so
# the dead-code pass takes it as a root and keeps the winning body live. Runs ONLY for a
# redefinition, so every other program is byte-identical. The calls this cannot reach — an
# inline replay, a generic instance — read pass 1's fn flag 2048 instead. CHANGELOG [6.6.20]
# ⚠ Every body is at least one jump long today (the defer-init placeholder opens even an empty
# `#naked` body), so the refusal below is a backstop: writing past a shorter body would land in
# the NEXT fn.
fn _fn_redirect(S, fi, noff, ti): i64 {
    var old = L64(_fnt_offsets + fi * 8);
    if (old < 0) { return 0; }
    if (EFNREDIRECT(S, old, GFNE(S, fi), GCP(S)) == 0) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": duplicate fn '", 16);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "': internal: its earlier body is shorter than a jump, so the calls bound to it cannot be redirected\n", 100);
    _had_error = 1;
    return 0;
}

# ⛔ v6.5.37 — carry the FIRST definition's arity and origin file across the parameter
# list, so a differing-arity duplicate can be reported as an ERROR once the new arity is
# known. Declared here, above both uses: a global declared BELOW its use is not visible in
# cyrius. -1 = no duplicate pending for the definition currently being parsed.
var _dup_prev_pc = 0 - 1;
var _dup_prev_fid = 0;

# ⛔ 6.6.20 — A DUPLICATE THAT DISAGREES ABOUT HOW IT IS CALLED IS AN ERROR TOO. Once every call
# reaches the last definition (`_fn_redirect`), a call compiled against an earlier one arrives with
# THAT one's calling convention: a retptr the winner never reads, a scalar where it fills a struct,
# an XMM argument it takes from a GPR, a C string where it reads a `Str`. Measured before this
# check: a scalar first `mk()` and a struct-returning last one SIGSEGV'd (a call between them used
# to bind the first and run). Same reasoning as the v6.5.37 arity error, for the rest of the call
# signature: the return type (unannotated is i64), a multi-value count, variadic, the
# per-parameter vector / struct / Str / cstring / Result / Option / Tagged masks, the same kinds
# for the ordinals past those masks' widths (the overflow row, `_pm_row_get`), the struct type
# of every address-passed struct parameter (GFPSID — `f(p: A)` then `f(p: B)` made B's body copy
# B's size out of the caller's A) and every vector parameter's type (`_dsg_vec_note`, for Win64).
# Saved from the earlier definition before this one overwrites them; compared once this one's
# signature is read. An arity difference is left to the arity error; `async` against plain is
# refused in pass 1 (`_dsg_async_check`).
var _dsg_on = 0;
var _dsg_pc = 0;
var _dsg_rs = 0;
var _dsg_rn = 0;
var _dsg_va = 0;
var _dsg_mk[8];   # the earlier definition's seven parameter masks (a bare top-level array is N*8 B)
var _dsg_ord = 0;   # and its per-ordinal facts: [count][overflow kind, struct id, vector type]
fn _dsg_rs_norm(v): i64 { if (v == 0) { return 0 - 8; } return v; }
# Parameter mask `k` of fn `fi`: the ones that change what a call passes or how it is checked.
fn _dsg_mask(fi, k): i64 {
    var t = _fnt_simdmask;
    if (k == 1) { t = _fnt_structmask; }
    if (k == 2) { t = _fnt_strmask; }
    if (k == 3) { t = _fnt_cstrmask; }
    if (k == 4) { t = _fnt_resmask; }
    if (k == 5) { t = _fnt_optmask; }
    if (k == 6) { t = _fnt_tagmask; }
    return L64(t + fi * 8);
}
# The struct id of parameter `i` when it is an address-passed struct, else 0.
fn _dsg_psid(S, fi, i): i64 {
    if (_pm_struct(fi, i) == 0) { return 0; }
    return GFPSID(S, fi, i);
}
# A REDEFINED fn's VECTOR parameter types, per ordinal (the descriptor `pt_simd_sid`): Win64
# passes every vector by address under the struct mask and leaves the SIMD mask 0, so the masks
# alone could not tell `f(v: f64v2)` from `f(v: f64v4)` there, and the 32-byte body copied 32
# bytes out of the caller's 16 (SysV refuses the pair through the SIMD mask). Lazy, at the max fn
# cap like _fnt_tparams, and written only for flag 2048 — a program without a redefinition never
# allocates it. Rows are [capacity][one word per ordinal] (`_psid_grow`).
var _fnt_dsgv = 0;
fn _dsg_vec_note(S, fi, pc, vsid): i64 {
    if ((GFLG(S, fi) & 2048) == 0) { return 0; }
    if (_fnt_dsgv == 0) { _fnt_dsgv = alloc(131072 * 8); }
    var row = L64(_fnt_dsgv + fi * 8);
    var cap = 0;
    if (row != 0) { cap = load64(row); }
    if (pc >= cap) {
        row = _psid_grow(row, cap, pc);
        S64(_fnt_dsgv + fi * 8, row);
    }
    S64(row + 8 + pc * 8, vsid);
    return 0;
}
fn _dsg_vec_get(fi, pc): i64 {
    if (_fnt_dsgv == 0) { return 0; }
    var row = L64(_fnt_dsgv + fi * 8);
    if (row == 0) { return 0; }
    if (pc >= load64(row)) { return 0; }
    return L64(row + 8 + pc * 8);
}
# Zero one [capacity][word per ordinal] row of a per-fn table (0 = none).
fn _dsg_row_zero(t, fi): i64 {
    if (t == 0) { return 0; }
    var row = L64(t + fi * 8);
    if (row == 0) { return 0; }
    var n = load64(row);
    var i = 0;
    while (i < n) { store64(row + 8 + i * 8, 0); i = i + 1; }
    return 0;
}
# A REDEFINED fn's struct-id and vector-type rows start empty at each definition's parameter
# list. Neither is rewritten wholesale like the masks — pass 1 leaves the LAST definition's
# struct ids in its row, and a parameter kind that records no id (a Win64 vector) would leave
# that stale id under the earlier definition — so without this the comparison could read the
# same value on both sides. Only for flag 2048: every other fn's rows are untouched.
fn _dsg_def_reset(S, fi): i64 {
    if ((GFLG(S, fi) & 2048) == 0) { return 0; }
    _dsg_row_zero(_fnt_psid, fi);
    _dsg_row_zero(_fnt_dsgv, fi);
    return 0;
}
fn _dsg_save(S, fi): i64 {
    _dsg_on = 1;
    _dsg_pc = L64(_fnt_params + fi * 8);
    _dsg_rs = _dsg_rs_norm(GFRS(S, fi));
    _dsg_rn = GFRN(S, fi);
    _dsg_va = GFVA(S, fi);
    var k = 0;
    while (k < 7) { S64(&_dsg_mk + k * 8, _dsg_mask(fi, k)); k = k + 1; }
    var n = _dsg_pc;
    if (n < 0) { n = 0; }
    _dsg_ord = alloc(8 + n * 24);
    store64(_dsg_ord, n);
    var i = 0;
    while (i < n) {
        store64(_dsg_ord + 8 + i * 24, _pm_row_get(fi, i));
        store64(_dsg_ord + 16 + i * 24, _dsg_psid(S, fi, i));
        store64(_dsg_ord + 24 + i * 24, _dsg_vec_get(fi, i));
        i = i + 1;
    }
    return 0;
}
# 1 when an ordinal's overflow kind, struct id or vector type differs from the saved definition's.
fn _dsg_ord_differs(S, fi): i64 {
    var n = load64(_dsg_ord);
    var i = 0;
    while (i < n) {
        if (_pm_row_get(fi, i) != load64(_dsg_ord + 8 + i * 24)) { return 1; }
        if (_dsg_psid(S, fi, i) != load64(_dsg_ord + 16 + i * 24)) { return 1; }
        if (_dsg_vec_get(fi, i) != load64(_dsg_ord + 24 + i * 24)) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn _dsg_check(S, fi, noff, ti): i64 {
    if (_dsg_on == 0) { return 0; }
    _dsg_on = 0;
    if (L64(_fnt_params + fi * 8) != _dsg_pc) { return 0; }   # the arity error covers it
    var what = 0;
    if (_dsg_rs_norm(GFRS(S, fi)) != _dsg_rs) { what = 1; }
    if (GFRN(S, fi) != _dsg_rn) { what = 1; }
    if (what == 0) { if (GFVA(S, fi) != _dsg_va) { what = 3; } }
    var k = 0;
    while (k < 7) {
        if (what == 0) { if (_dsg_mask(fi, k) != L64(&_dsg_mk + k * 8)) { what = 2; } }
        k = k + 1;
    }
    if (what == 0) { if (_dsg_ord_differs(S, fi) == 1) { what = 2; } }
    if (what == 0) { return 0; }
    return _dsg_report(S, noff, ti, what, _dup_prev_fid);
}
# The error both checks print. `fid` is the earlier definition's origin (GFFI form).
fn _dsg_report(S, noff, ti, what, fid): i64 {
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": duplicate fn '", 16);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' disagrees about its ", 22);
    if (what == 1) { syscall(SYS_WRITE, 2, "return type", 11); }
    if (what == 2) { syscall(SYS_WRITE, 2, "parameter types", 15); }
    if (what == 3) { syscall(SYS_WRITE, 2, "variadic parameter list", 23); }
    if (what == 4) { syscall(SYS_WRITE, 2, "`async` marker", 14); }
    syscall(SYS_WRITE, 2, " with the one in ", 17);
    _fm_print_fid(S, fid);
    syscall(SYS_WRITE, 2, " (last definition wins, so calls compiled against that one would reach this body through the wrong calling convention)\n", 119);
    _had_error = 1;
    return 0;
}
# 6.6.20 — `async fn f` against a plain `fn f`: a call to an async fn receives a Future, a call to
# a plain one the value, so once the last definition wins, one side reads the other's result as
# the wrong thing (measured: async-then-plain SIGSEGV'd at the `await`; plain-then-async bound
# the FIRST body with no warning at all, the async body being registered as `f$impl`). Refused
# here, in PASS 1, because it is the only place both definitions are seen under ONE entry: in
# pass 2 the async one's body is `f$impl` and its constructor never reaches the duplicate path,
# and GFAS is set by ANY async definition of the name. Called on a redefinition (`_pds`), with
# `was` = whether an earlier definition was async (GFAS before this one sets it), `now` = this.
fn _dsg_async_check(S, fi, noff, ti, was, now): i64 {
    if (was == now) { return 0; }
    return _dsg_report(S, noff, ti, 4, GFFI(S, fi));
}

fn _PARSE_FN_DEF_IMPL(S): i64 {
    var _is_async = 0;
    var _async_noff_f = 0;
    # v6.3.11 (G): the pass-2 dispatch already consumed the leading `async` (token
    # 134) and set _pending_async, so the cursor is at `fn` here. (The async token is
    # consumed in the dispatch, not here, so the DCE pre-check reads the real fn name.)
    if (_pending_async == 1) {
        _pending_async = 0;
        _ensure_async_gate(S);
        # A refused `async fn` compiles as a plain fn: lowering it anyway needed lib/alloc.cyr
        # for a Future nothing will run, and reported a second error for it. CHANGELOG [6.6.9]
        if (_ASYNC_OK == 0) { ERR_MSG(S, "async fn requires CYRIUS_ASYNC=1 (async/await are gated)", 56); }
        else { _is_async = 1; }
    }
    var _defstart_ti = GTI(S);   # v6.3.10: the `fn`-keyword token, for instance re-emit
    STI(S, GTI(S) + 1);  # consume FN
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);
    # Skip generic parameters if present: fn foo<T, U>(...)
    # v6.3.9 (F-fns): capture <T> names (flag-off = old SKIP_GENERICS skip); stored
    # into _fnt_tparams[fi] once fi is resolved below (fi isn't known until the name
    # is mangled + registered, so the packed names ride _gtp until then).
    var _gtp = _capture_tparams(S);
    # Mangle name if inside a module: mod_fn
    var mmod = GMOD(S);
    # v6.3.10 (instantiate-once): re-emitting a specialized instance — the mangled
    # name `foo$ty` is already fully formed, so use it verbatim and skip module
    # mangling. (_inst_name is set only by the instantiate trigger's re-invoke.)
    if (_inst_name != 0) { noff = _inst_name; mmod = 0; }
    # 6.6.5 — one mangler, shared with pass 1 (see _mod_name_intern). Pass 1 now mints
    # `Type_method` / `mod_fn` first, so this call finds that exact string and REUSES it
    # instead of minting a second copy; pool growth is unchanged either way.
    noff = _mod_name_intern(S, mmod, noff);
    # v6.3.11 (G): async fn — the user name `f` becomes a Future constructor
    # (synthesized after the body, below); the body itself is emitted under `f$impl`.
    # Generic async (`async fn f<T>`) is deferred — error rather than miscompile.
    if (_is_async == 1) {
        if (_gtp != 0) { ERR_MSG(S, "async generic fns not yet supported", 35); }
        _async_noff_f = noff;
        noff = _mint_impl_name(S, noff);
    }
    # Register or find fn.
    # v5.7.9: detect duplicate fn definitions across translation
    # units. If FINDFN returns an existing slot AND that slot already
    # has a non-(-1) body offset, this is a re-definition that
    # silently overwrites the previous body. Pre-v5.7.9, the
    # overwrite was completely silent — `lib/json.cyr fn json_build/1`
    # vs `lib/patra.cyr fn json_build/6` was the surfaced case
    # (last-include wins; the build appeared to succeed; calls to
    # the losing arity miscompiled). Forward declarations (slot
    # registered with offset=-1 by an earlier call site that landed
    # before the definition) leave the offset at -1, so the call
    # below does not fire on them — only on actual re-definitions.
    # v6.5.38 — visibility is now needed BEFORE the duplicate decision, so it is computed
    # here rather than after `fi` resolves (where Phase 1 originally stamped it). Whether
    # this definition is private decides whether a same-named definition SPLITS into its
    # own symbol or overwrites the existing one.
    var _vis_fid = FM_FILEID(S, GTLINE(S, _defstart_ti));
    var _this_priv = 0;
    if (_pub_pending == 0) { if (_PRIV_FILE(_vis_fid) == 1) { _this_priv = 1; } }
    # v6.6.4: a monomorphized INSTANCE inherits its BASE's visibility. The instance is
    # emitted by re-parsing the base's tokens from its `fn` keyword, so `_pub_pending`
    # is long consumed and `_PRIV_FILE` answers for the lib file — which stamped every
    # instance of a `public fn pgen<T>` in a private file PRIVATE, and refused
    # `pgen<i32>(42)` from another file while `pgen(42)` (the i64 base) was accepted.
    if (_inst_name != 0) {
        _this_priv = 0;
        if ((GFLG(S, _inst_base_fi) & 64) != 0) { _this_priv = 1; }
    }

    _dup_prev_pc = 0 - 1;
    _dsg_on = 0;
    # 6.6.5 — PASS 1 IS THE AUTHORITY. `_fn_by_defti` finds the entry pass 1 registered for
    # THIS definition (matched on its `fn` token), which does two things:
    #   * the entry is this definition's own, so the v6.5.38 per-file split has already
    #     happened in pass 1 — before any forward call could bind to the wrong one;
    #   * `_this_priv` is taken from that stamp rather than recomputed. Pass 2 computes
    #     visibility a SECOND time and gets it wrong in one case: its top-level `var` skip
    #     re-arms `public` and never consumes it, so the next fn was stamped public in a
    #     private file. That was masked only because the pass-1 bit was never cleared;
    #     clearing it (below, at the stamp) without this would have exposed it.
    # An instance (`_inst_name != 0`) is re-parsed from the BASE's tokens, so its def-start
    # names the base — it deliberately bypasses this and keeps the v6.6.4 inherited bit.
    var fi = 0 - 1;
    if (_inst_name == 0) { fi = _fn_by_defti(S, noff, _defstart_ti); }
    if (fi >= 0) {
        # ⚠ Only when nothing has CLAIMED the entry yet. Two same-file definitions of one
        # name share an entry (that is a redefinition, not a collision — it must keep
        # warning), and an entry holds ONE bit, so after the first definition emitted its
        # body the bit describes whichever definition wrote last. Measured: `public fn h()`
        # followed by `fn h()` in a private file came out PUBLIC, where every release since
        # v6.5.0 made it private. An offset >= 0 means an earlier definition owns this slot,
        # so this one keeps the visibility it computed for itself.
        if (L64(_fnt_offsets + fi * 8) < 0) {
            _this_priv = 0;
            if ((GFLG(S, fi) & 64) != 0) { _this_priv = 1; }
        }
    } else {
        # Not prescanned — a fn defined inside a top-level block (one inside a fn body is
        # refused, parse.cyr `_refuse_nested_fn`), or a monomorphized instance. The v6.5.38
        # identity rule still applies; it lives in `_fn_def_slot` now so pass 1 and pass 2
        # cannot drift apart about what a definition owns.
        fi = _fn_def_slot(S, noff, _vis_fid, _this_priv);
    }
    var _dup_off = L64(_fnt_offsets + fi * 8);
    if (_dup_off >= 0) {
        # v6.5.37: remember the loser's arity + file; the comparison happens once this
        # definition's own parameter list has been counted (see _fnt_params store below).
        _dup_prev_pc = L64(_fnt_params + fi * 8);
        _dup_prev_fid = GFFI(S, fi);
        _dsg_save(S, fi);   # 6.6.20: and the rest of its call signature (see _dsg_check)
        # v6.5.19 (agnosai filing) — TWO fixes to this one warning:
        #  * `_err_head_at(S, _defstart_ti)` instead of `_err_head(S)`. The cursor
        #    has already consumed `fn` and the NAME by here, so the plain head put
        #    the column on the `(` of the parameter list rather than on the
        #    definition. `_defstart_ti` is the `fn` keyword itself.
        #  * name the file the FIRST definition came from. GFFI still holds it —
        #    SFFI for THIS definition is written further down, after `fi` resolves —
        #    so the consumer gets both ends of the collision instead of having to
        #    infer "which copy wins" from a single position, which is the wrong
        #    inference the filing had to retract twice.
        syscall(SYS_WRITE, 2, "warning:", 8);
        _err_head_at(S, _defstart_ti);
        syscall(SYS_WRITE, 2, ": duplicate fn '", 16);
        PRSTR(S + 0xEC00000 + noff);
        syscall(SYS_WRITE, 2, "' (last definition wins; first defined in ", 42);
        _fm_print_fid(S, GFFI(S, fi));
        syscall(SYS_WRITE, 2, ")\n", 2);
    }
    if (_gtp != 0) { SFTP(S, fi, _gtp); }   # v6.3.9 (F-fns): record this fn's <T> names
    # v6.3.10: def-start +1 (0 = unrecorded; token 0 is valid). 6.6.20: NOT over a redefinition's
    # (flag 2048) — pass 1 left the LAST definition's start, so an instance minted between the
    # definitions is minted from the one that wins, not from the body in hand.
    if (_gtp != 0) { if ((GFLG(S, fi) & 2048) == 0) { SFDS(S, fi, _defstart_ti + 1); } }
    # v6.5.0 Phase 1 (public/private): stamp this fn's ORIGIN FILE, derived from the
    # line of its `fn` keyword via the file map the preprocessor already builds for
    # diagnostics (`#@file` markers -> FM_BUILD -> FM_FILEID). RECORDED ONLY — nothing
    # reads this for a decision yet, so program codegen is unchanged; Phase 2 is what
    # turns it into a visibility boundary.
    #
    # `_defstart_ti` is the `fn`-keyword token and is set unconditionally at the top of
    # PARSE_FN_DEF, so this is exact for every definition rather than approximated from
    # whatever token happens to be current. Deliberately placed HERE, after `fi` is
    # resolved: a forward reference registers a slot from a CALL SITE, and attributing
    # the fn to the caller's file would be precisely backwards.
    SFFI(S, fi, _vis_fid + 1);   # v6.5.38: _vis_fid is computed above, before the dup split
    # v6.5.0 Phase 2 — fn_flags bit 6 = PRIVATE. Set when this fn's own file opted in
    # AND no `public` moniker preceded it. Default (no `private` anywhere) leaves the
    # bit clear for every fn, so the whole feature is inert and byte-identical until a
    # file asks for it.
    #
    # `_pub_pending` is cleared UNCONDITIONALLY, exactly like `_must_use_pending` and
    # friends below. ⚠ That clear alone did NOT stop a stale marker from re-exposing an
    # unrelated fn: a `public` on a struct / union / enum / impl / `use` was armed and
    # never reached a definition until the NEXT fn or var — the hisab 2026-09-13 leak.
    # Since v6.6.4 _TL_VIS arms the marker only for tokens that can carry it (see
    # _PUB_CAN_ARM), PARSE_IMPL and the relaxed-ordering path clear it on entry, and the
    # array + destructure var paths consume it themselves.
    # 6.6.5 r3: a deferred reference can only become REPORTABLE when a new PRIVATE stamp
    # lands (`_vis_report_late` reports nothing for a public callee), so the sweep's seq
    # guard keys on this branch and not on SFFI. A compiland with no `private` anywhere —
    # which is nearly all of them — then sweeps exactly ONCE instead of once per fn body.
    if (_this_priv == 1) { SFLG(S, fi, GFLG(S, fi) | 64); _vis_stamp_seq = _vis_stamp_seq + 1; }
    # ⛔ 6.6.5 — and CLEAR it otherwise. The bit was only ever set, never cleared, so a
    # stale pass-1 private stamp survived onto a PUBLIC definition. That is not
    # hypothetical: with pass 1 keeping one entry per NAME, a private `_helper` in file A
    # stamped the shared entry, and file B's public `_helper` inherited the bit — the
    # guide's own two-file example was REFUSED, with no forward call involved, purely on
    # include order, and the "omitted from the exported symbol table" promise applied to
    # the wrong fn. CHANGELOG [6.6.5]
    else { SFLG(S, fi, GFLG(S, fi) & (0 - 65)); }
    # An unattributable fn (FM_FILEID -1) can never be marked private, so enforcement
    # would quietly stop applying. Say so once rather than degrade in silence.
    if (_vis_fid < 0) { _vis_degraded_note(); }
    _pub_pending = 0;
    if (_fileid_dump_arm() != 0) { _fileid_dump_note(S, fi, noff); }
    # v5.11.62: track the current fn for per-fn array-byte attribution.
    # Initialize the slot to 0 — fn body may have been touched by an earlier
    # forward-decl scan; this is the start of the body parse proper.
    _cur_fn_ix = fi;
    SFVB(S, fi, 0);
    # v5.5.36 Phase 2b — clear fn's struct-return slot. The `: StructName`
    # annotation after `)` sets it later if present; otherwise this fn
    # returns a scalar value in rax as usual.
    SFRS(S, fi, 0);
    # v5.5.36 Phase 3 — clear fn's variadic flag. Set to 1 in the
    # param loop below if the user writes `fn f(a, ...)`.
    SFVA(S, fi, 0);
    # v4.8.4-alpha4: transfer any pending `#regalloc` directive onto
    # this fn's metadata slot. Cleared whether consumed or not so a
    # stale flag from a prior parse error can't leak to the next fn.
    # v4.9.1: store 5 (max register count: rbx, r12-r15) for #regalloc fns.
    # v5.6.22 O4c (partial): infrastructure for auto-enable shipped
    # but DISABLED by default. CYRIUS_REGALLOC_AUTO_CAP=N opts in:
    #   -1 = disabled (default; back to explicit #regalloc opt-in only)
    #    N = first N fns get auto-enabled (bisection knob)
    # v5.6.22 attempt at default-on auto-enable surfaced a global-array
    # alignment regression (v5.5.21 fix interacts with auto-enable's
    # code-size growth in some shape that v5.5.21's per-array pad
    # misses; reproduces with `var rk[240]` + SSE m128 ops in
    # `tests/regression-inline-asm-discard.sh`). Investigation pinned
    # to v5.6.23 with proper alignment-debug budget. The picker
    # correctness fix (loop-back time-share — extend last_cp = ra_end)
    # is shipped here for opt-in #regalloc fns.
    #
    # x86-ONLY when enabled: the `_cur_fn_regalloc >= N` save/restore
    # emits below are RAW x86 bytes (`mov [rbp-8], rbx` etc.).
    #
    # v5.6.23: scan body for inline asm (token 48). Inline asm blocks
    # hardcode stack offsets like `mov rax, [rbp-0x08]` to read params
    # and locals. The regalloc prologue reserves [rbp-8]..[rbp-40] for
    # callee-saved register saves (rbx, r12-r15), shifting every
    # subsequent local-var slot by N*8 bytes. Asm reading the old
    # offsets gets the saved RBX value instead of its expected param —
    # SIGSEGV when the asm dereferences it. lib/fnptr.cyr,
    # lib/thread.cyr, lib/atomic.cyr, lib/hashmap_fast.cyr, lib/u128.cyr,
    # lib/thread_local.cyr, lib/fdlopen.cyr, lib/args_macos.cyr all
    # carry asm blocks that depend on the standard prologue layout.
    # Skip regalloc when body contains asm. Misframed at v5.6.22 ship as
    # an "alignment regression" — the actual bug is layout mismatch.
    var _has_inline_asm = 0;
    var _ia_save_ti = GTI(S);
    if (PEEKT(S) == 10) {
        STI(S, GTI(S) + 1);
        var _ia_pd = 1;
        while (_ia_pd > 0 && PEEKT(S) != 12) {
            if (PEEKT(S) == 10) { _ia_pd = _ia_pd + 1; }
            elif (PEEKT(S) == 11) { _ia_pd = _ia_pd - 1; }
            STI(S, GTI(S) + 1);
        }
    }
    if (PEEKT(S) == 49) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 2) { STI(S, GTI(S) + 1); }
    }
    if (PEEKT(S) == 13) {
        STI(S, GTI(S) + 1);
        var _ia_bd = 1;
        while (_ia_bd > 0 && PEEKT(S) != 12) {
            if (PEEKT(S) == 13) { _ia_bd = _ia_bd + 1; }
            elif (PEEKT(S) == 14) { _ia_bd = _ia_bd - 1; }
            elif (PEEKT(S) == 48) { _has_inline_asm = 1; }
            STI(S, GTI(S) + 1);
        }
    }
    STI(S, _ia_save_ti);

    # v5.6.24 default-on: _ra_auto_cap semantics:
    #   < 0  → uncapped (every eligible fn) — DEFAULT
    #   == 0 → disabled (explicit #regalloc opt-in only)
    #   > N  → first N eligible fns (bisection knob)
    # "Eligible" = x86 backend + no inline asm in body.
    # v5.6.23 fixed misdiagnosed asm/regalloc layout collision.
    # v5.6.24 fixed the picker bug surfaced by the default-on attempt:
    # SysV ECALLPOPS used r12-r14 as scratch for 8+ arg calls; under
    # regalloc the picker pinned caller's locals to those callee-saved
    # regs, so calls silently corrupted the locals. Rewrote ECALLPOPS
    # to use only r10 + direct [rsp+offset] addressing.
    var _auto_enable = 0;
    if (_AARCH64_BACKEND == 0) {
        if (_has_inline_asm == 0) {
            if (_ra_auto_cap < 0) { _auto_enable = 1; }
            elif (_ra_auto_cap > 0) {
                if (_ra_auto_count < _ra_auto_cap) { _auto_enable = 1; }
            }
        }
    }
    # v6.1.30: x86-macho reserves r15 for the parked argv base (the entry emits
    # `mov r15, rsp`), so cap regalloc at 4 callee-saved regs (rbx/r12/r13/r14)
    # on that target — never assign a 5th hot local to r15. ELF / arm64 / PE keep
    # 5. Gated on _TARGET_MACHO==1 (x86 Mach-O only; arm64 Mach-O is ==2).
    # v6.1.32: agnos parks the init rsp in r15 the same way (same SysV init
    # stack), so it reserves r15 too — cap it at 4 as well.
    var _ra_cap = 5;
    if (_TARGET_MACHO == 1) { _ra_cap = 4; }
    if (_TARGET_AGNOS == 1) { _ra_cap = 4; }
    # 6.6.5: a UEFI image parks the firmware entry rsp in r13 at the landing (see the
    # `lea r13, [rsp]` in src/main.cyr) because EEXIT returns to firmware with
    # `mov rsp, r13; ret` from ANY depth. The save list is rbx(0), r12(1), r13(2), r14(3),
    # r15(4), so capping at 2 is what reserves r13 — pick it for a hot local and an
    # `syscall(60, …)` anywhere under that fn jumps to a local's value. It also finally
    # reserves r14/r15, which have carried ImageHandle/SystemTable since v5.11.52 while
    # being assignable. EFI images are small; two callee-saved regs is not a real cost.
    # CHANGELOG [6.6.5]
    if (_TARGET_EFI_APPLICATION == 1) { _ra_cap = 2; }
    if (_regalloc_pending == 1) {
        # CO-03 (v6.1.34): #regalloc is x86-only (the post-body byte-peephole
        # picker). The AUTO path gates on `_AARCH64_BACKEND == 0` above; the
        # explicit-`#regalloc` path did NOT — add the gate so an annotated fn on
        # aarch64 doesn't reach the x86 picker (`_cur_fn_regalloc` stays 0 → the
        # picker self-skips).
        if (_has_inline_asm == 0) { if (_AARCH64_BACKEND == 0) { SFRA(S, fi, _ra_cap); } }
        else {
            syscall(SYS_WRITE, 2, "warning:", 8);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": '", 3);
            PRSTR(S + 0xEC00000 + noff);
            syscall(SYS_WRITE, 2, "': #regalloc skipped — fn contains inline asm (hardcoded stack offsets)\n", 74);
        }
        _regalloc_pending = 0;
    }
    elif (_auto_enable == 1) { SFRA(S, fi, _ra_cap); _ra_auto_count = _ra_auto_count + 1; }
    # v5.6.3: transfer any pending `#must_use` onto fn_flags[fi] bit 0.
    # Clear unconditionally (same stale-flag argument as #regalloc).
    if (_must_use_pending == 1) {
        var _prev = GFLG(S, fi);
        SFLG(S, fi, _prev | 1);
        _must_use_pending = 0;
    }
    # v5.6.4: transfer any pending `#deprecated("msg")` onto fn_flags
    # bit 2 + fn_deprecated_msg[fi]. Same stale-flag discipline.
    if (_deprecated_pending == 1) {
        var _prev_d = GFLG(S, fi);
        SFLG(S, fi, _prev_d | 4);
        SFDM(S, fi, _deprecated_msg_pending);
        _deprecated_pending = 0;
        _deprecated_msg_pending = 0;
    }
    # v5.8.20: transfer pending #pure / #io / #alloc onto fn_flags bits
    # 3 / 4 / 5. Same stale-flag discipline. _cur_fn_is_pure mirrors
    # bit 3 so PARSE_FNCALL can check it without re-loading fn_flags
    # for every call site (set here, reset at fn end below).
    if (_pure_pending == 1) {
        var _prev_p = GFLG(S, fi);
        SFLG(S, fi, _prev_p | 8);
        _pure_pending = 0;
    }
    if (_io_pending == 1) {
        var _prev_i = GFLG(S, fi);
        SFLG(S, fi, _prev_i | 16);
        _io_pending = 0;
    }
    if (_alloc_pending == 1) {
        var _prev_a = GFLG(S, fi);
        SFLG(S, fi, _prev_a | 32);
        _alloc_pending = 0;
    }
