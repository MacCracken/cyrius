# global-or-call-decision.md) a `*X` global, a call or method declared `: *X`, a `*X` field, pointer
# arithmetic on one: rax (the pointer) becomes S read through it; X another struct is refused by name.
# 6.7.13 (D4 (a)): and `& IDENT` of an inline struct (`_hl_dpsid`) — see `_ret_ptr_src`. CHANGELOG [6.7.13]
fn _ret_small_ptr(S, st): i64 {
    var a = _ie_unparen(S, st, GTI(S));
    var pe = _ie_pe;
    if (_ret_slot_amp(S, a, pe) == 1) { return 0; }   # 6.7.14 (D19 (a)): `&h` of a handle / `*T`, a slot
    var ps = _hl_dpsid(S, a, pe);   # 6.7.13 (D4 (a)): `& IDENT` of an inline struct too
    var kind = 1 + 2 * _hl_damp;
    if (ps <= 0) { return 0; }
    if (_dx_plain(S, ps) == 0) { return 0; }
    if (ps != _cur_fn_ret_sid) { return _ret_sid_refuse(S, st, _hl_pnm(S, a, pe), 0 - 1, ps, kind); }
    _hl_pval_ra(S, ps);
    return 0;
