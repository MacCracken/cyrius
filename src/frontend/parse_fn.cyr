                        if (_rs_b1 == 97) {
                            if (_rs_b2 == 103) {
                                if (_rs_b3 == 103) {
                                    if (load8(S + 0x60000 + _rs_rt_noff + 4) == 101) {
                                        if (load8(S + 0x60000 + _rs_rt_noff + 5) == 100) {
                                            if (load8(S + 0x60000 + _rs_rt_noff + 6) == 0) {
                                                _rs_is_scalar = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if (_rs_b0 == 99) {
                        if (_rs_b1 == 115) {
                            if (_rs_b2 == 116) {
                                if (_rs_b3 == 114) {
                                    if (load8(S + 0x60000 + _rs_rt_noff + 4) == 105) {
                                        if (load8(S + 0x60000 + _rs_rt_noff + 5) == 110) {
                                            if (load8(S + 0x60000 + _rs_rt_noff + 6) == 103) {
                                                if (load8(S + 0x60000 + _rs_rt_noff + 7) == 0) {
                                                    _rs_is_scalar = 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    # v5.10.28 — `f64v2` recognized as a primitive value
                    # type returning via multi-register pair (rax+rdx on
                    # x86 SysV). Encoding -20 reserved here so the
                    # rough-scan does NOT default to retptr-stash for
                    # f64v2-returning fns (their bytes flow through the
                    # post-param-list scalar return path with the
                    # multi-register return codegen). On SysV/aarch64/cx,
                    # set _rs_is_scalar = 1 (treats it as "scalar-ish"
                    # for stash decision; actual return codegen below
                    # detects rt_scalar == -20 and emits pair-return).
                    #
                    # v5.10.31 — Win64 PE ABI: ≤16-byte composite returns
                    # use retptr-style (caller-allocated buffer pointer
                    # in RCX), NOT rax/rdx pair. So on _TARGET_PE == 1,
                    # leave _rs_is_scalar at 0 — the rough-scan falls
                    # through to the default `_cur_fn_ret_stash = 8`,
                    # routing f64v2-returning fns through the existing
                    # retptr machinery. PARSE_RETURN's f64v2 branch
                    # detects stash > 0 and emits byte-copy via
                    # ESTRUCT_BYVAL_COPY-like helper.
                    if (_rs_b0 == 102) {
                        if (_rs_b1 == 54) {
                            if (_rs_b2 == 52) {
                                if (_rs_b3 == 118) {
                                    if (load8(S + 0x60000 + _rs_rt_noff + 4) == 50) {
                                        if (load8(S + 0x60000 + _rs_rt_noff + 5) == 0) {
                                            if (_TARGET_PE == 0) {
                                                _rs_is_scalar = 1;
                                            }
                                        }
                                    }
                                    # v5.10.37 — `f64v4` (32-byte). Same
                                    # SysV/aarch64/cx treatment as f64v2:
                                    # `_rs_is_scalar = 1` skips retptr-
                                    # stash; PARSE_RETURN dispatches via
                                    # rt_scalar == -21 to the pair-quad
                                    # codegen (two MOVUPDs on x86 / two
                                    # LDR Q on aarch64). Win64 PE keeps
                                    # the retptr-stash path (32B > 16B
                                    # composite cap per MS x64 ABI, just
                                    # like f64v2 on PE).
                                    if (load8(S + 0x60000 + _rs_rt_noff + 4) == 52) {
                                        if (load8(S + 0x60000 + _rs_rt_noff + 5) == 0) {
                                            if (_TARGET_PE == 0) {
                                                _rs_is_scalar = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    # v6.4.3+ (SIMD Phase 1) — `f32v4` (16-byte / 128-bit): same
                    # SysV/aarch64/cx pair-return treatment as f64v2 — set
                    # _rs_is_scalar = 1 to skip the retptr-stash so PARSE_RETURN's
                    # pair path (rt_scalar == -2121) fires; Win64 PE keeps the
                    # retptr-stash (leave _rs_is_scalar 0), like f64v2 on PE.
                    if (_rs_b0 == 102) {
                        if (_rs_b1 == 51) {
                            if (_rs_b2 == 50) {
                                if (_rs_b3 == 118) {
                                    if (load8(S + 0x60000 + _rs_rt_noff + 4) == 52) {
                                        if (load8(S + 0x60000 + _rs_rt_noff + 5) == 0) {
                                            if (_TARGET_PE == 0) {
                                                _rs_is_scalar = 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    # v6.3.9 (F-fns): a `: T` return where T is a captured type-param
                    # is i64-shaped (scalar) for the base instance — recognize it here
                    # so the rough-scan does NOT default to the retptr/stash ABI, which
                    # would reserve arg-reg 0 for a hidden retptr and shift user params
                    # by one (the `id<T>(x:T):T` → x lands in rsi, reads 0 bug).
                    if (_rs_is_scalar == 0) { if (_is_tparam_of(S, fi, _rs_rt_noff) == 1) { _rs_is_scalar = 1; } }
                    if (_rs_is_scalar == 0) {
                        _cur_fn_ret_stash = 8;
                    }
                }
            } else {
                # v6.5.21: `: (T1, T2[, T3])` is a REGISTER multi-value return
                # (rax / rdx / ret3), never a retptr. Without this guard it fell
                # into the retptr default, which reserves arg-reg 0 for a hidden
                # pointer and shifts every user param by one — `fn f(a, b): (i64,
                # i64)` called as `f(7, 9)` gave a = 9 and b = 0. Exactly the
                # failure the v6.3.9 note above describes for `: T`, in the arm
                # that catches every return type which is not a bare IDENT.
                if (PEEKT(S) != 10) { _cur_fn_ret_stash = 8; }
            }
        }
    }
    STI(S, _rs_save_ti);
    # Set fn offset to current CP
    S64(_fnt_offsets + fi * 8, GCP(S));
    # Save compiler state
    var saved_lv = GLVAR(S);
    SINFN(S, 1);
    SFLC(S, 0);
    _flc_hwm = 0;   # v6.3.37 (A3) — reset the inline param-slot high-water per fn
    _fn_local_addr = 0;   # v6.5.14 — reset the escaped-frame-address flag per fn
    # v6.0.7 — return-patch storage migrated from fixed array
    # (S + 0x18DA20, cap 256) to rp_vec. Per-fn reset is now
    # vec_truncate(rp_vec, 0); same semantic, bounded memory under the
    # bump allocator (proposal Option A reuse pattern).
    vec_truncate(rp_vec, 0);
    S64(S + 0x1AC020, 0);  # defer_count = 0
    S64(S + 0x19E000, 0);  # jump_target_count = 0
    S64(S + 0x1A0000, 0);  # v5.6.27: jump_src_cnt = 0 (per-fn compaction)
    S64(S + 0x1A2008, 0);  # v5.6.27: nop_run_cnt = 0
    S64(S + 0x1AC800, 0);  # v6.5.20: sw_tbl_cnt = 0 (per-fn switch-table repair)
    S64(S + 0x1A6010, GFCNT(S));  # v5.6.27: fn_start_fcnt baseline
    # Emit prologue (v6.2.27: #naked skips it — the body is the raw ISR; no
    # rbp frame, no `sub rsp`. frame_patch stays 0 so the EPATCHFRAME at fn end
    # is also skipped (nothing to patch) — the "dangling frame_patch" guard.)
    var frame_patch = 0;
    if (_cur_fn_naked == 0) {
        EFNPRO(S);
        frame_patch = ESUBRSP(S);
    }
    # v4.8.4-alpha6: save rbx into its reserved slot at [rbp-8]. Must
    # v4.9.1: save callee-saved registers into reserved slots.
    # rbx→[rbp-8], r12→[rbp-16], r13→[rbp-24], r14→[rbp-32], r15→[rbp-40].
    # Encodings: REX.WR=4C for r12-r15 (REX.R=1), opcode 89 (mov r/m,r),
    # ModR/M byte encodes register + [rbp+disp8].
    # v5.6.12: regalloc callee-saved spill block is raw x86 encoding.
    # v5.7.12 path B: regalloc save block is raw x86 encoding;
    # cx bytecode has no callee-save semantic in this slot.
    # The `_cur_fn_regalloc > 0` check on cx is academic — cx
    # never auto-enables regalloc (different scheduling) — but
    # explicit guard hardens against future changes.
    # v5.10.48 defensive: paired `_AARCH64_BACKEND == 0` guard
    # (surfaced v5.9.43 closeout, deferred from the original
    # v5.10.44 defensive bundle into .48). Currently x86-only via
    # `_TARGET_CX == 0`, but `_TARGET_CX` is false on aarch64
    # too — without the AARCH64 guard, raw x86 encoding would
    # leak into aarch64 emit if any future change wires cx==0 on
    # aarch64. Not a leak in practice (aarch64 doesn't auto-
    # enable regalloc → `_cur_fn_regalloc >= 1` never fires) but
    # defensive against future scheduling changes.
    # v5.11.35 path-A: dispatch lives in <backend>/emit.cyr.
    if (_cur_fn_naked == 0) { EREGALLOC_SAVE(S, _cur_fn_regalloc); }   # v6.2.27: #naked has no frame to save rbx into
    # v5.5.36 Phase 2b — stash the hidden retptr into the reserved
    # slot immediately after regalloc saves. ABI register varies:
    #   x86 SysV → RDI (pidx=0); x86 Win64 → RCX (pidx=0 with the
    #   Win64 ESTOREREGPARM dispatch picking RCX); aarch64 SysV →
    #   X8 (dedicated indirect-result register, NOT a regular
    #   arg reg — v5.9.26 fix); cx bytecode → r3 (first arg slot;
    #   v5.9.40 Phase 2c — caller-side asv path pushes retptr as
    #   first arg, ECALLPOPS lands it in r3).
    if (_cur_fn_ret_stash > 0) {
        var _rs_stash_disp = 0 - (_cur_fn_regalloc * 8 + 8);
        if (_AARCH64_BACKEND == 1) {
            ESTOREREGPARM(S, 8, _rs_stash_disp);   # stur x8, [x29, #disp]
        } else {
            ESTOREREGPARM(S, 0, _rs_stash_disp);
        }
    }
    var fn_start = GCP(S);
    # Parse params
    if (PEEKT(S) != 10) { ERR_EXPECT(S, 10); }
    STI(S, GTI(S) + 1);
    var pc = 0;
    var str_mask = 0;
    # v5.10.24 — Phase 2 param-type masks (mirror str_mask shape).
    # Bit N = 1 means param N is annotated `: <Type>`. Stored at
    # parallel heap offsets so PARSE_FNCALL can consult on a per-
    # fn / per-param basis. Empty (0) for fns with no annotated
    # params — same default as str_mask.
    var cstring_mask = 0;
    var result_mask = 0;
    # v5.10.38 — typed-simd Phase 10 (arc close). Param-side ABI:
    # `fn f(a: f64v2)` allocates 2 stack slots for `a` (mirror of
    # the v5.10.28 return-side multi-slot pattern) and emits a
    # register-pair store at fn entry from XMM<simd_ord> /
    # V<simd_ord> / r<2*simd_ord>+r<2*simd_ord+1> into the 2-slot
    # region. PARSE_FNCALL consults the SIMD mask to route value-
    # form args into XMM/V registers rather than int-class arg
    # regs. Pack 2 bits per param into a single 64-bit mask:
    #   00 = int-class (default)
    #   01 = f64v2 (uses 1 SIMD-class arg reg)
    #   10 = f64v4 (uses 2 SIMD-class arg regs)
    # 32 params per fn (cap matches existing param caps).
    var simd_mask = 0;
    # simd_pc tracks the SIMD-class arg-reg ordinal, INDEPENDENT
    # of the int-class pc. v5.10.38 cyrius-internal SysV-style
    # split-counter convention (NOT MS x64 single-counter): SIMD
    # params get XMM0..XMM7 / V0..V7 in their SIMD-arg ordinal
    # order; int params get RDI/RSI/RDX/RCX/R8/R9 in their
    # int-arg ordinal order. The two sequences are independent.
    var simd_pc = 0;
    var int_pc = 0;
    var option_mask = 0;
    var tagged_mask = 0;
    var struct_mask = 0;   # v6.3.36 (issue [5]): bit N = plain struct >8 B param
    _cur_fn_tp_pmask = 0;  # v6.3.39 (B3): reset per-fn tparam-typed-param mask
    # v6.3.39 (B3): for a specialized INSTANCE re-emit, bind T -> the concrete type(s)
    # BEFORE the param loop so a type-param-typed param `p: T` resolves to the concrete
    # struct (p becomes a by-value struct param → `p.x` in the body lays out + reads
    # correctly, like a plain `fn wrap_point(p: Point)`). CLEARED right after the loop so
    # the return-type scan + rest of the fn are unchanged; the existing body bind (~3113)
    # re-establishes it for PARSE_PROG. Only fires for an INSTANCE (_inst_conc0 != 0 — a
    # path that was -3-blocked before v6.3.39 for structs; scalar instances resolve the
    # tparam to a scalar → pt_sid stays 0, byte-identical). BASE + default never enter.
    var _b3_pl_bound = 0;
    if (_MONOMORPH_OK == 1) { if (_inst_conc0 != 0) { if (GFTP(S, fi) != 0) {
        _bind_generic_call(S, fi, _inst_conc0, _inst_conc1);
        _b3_pl_bound = 1;
    } } }
    if (PEEKT(S) != 11) {
        var pgo = 1;
        while (pgo == 1) {
            # v5.5.36 Phase 3 — variadic ellipsis terminator:
            # `fn f(a, ...)`. Must appear at the tail of the param
            # list (either as the first and only "param" for a
            # fully-variadic fn, or after at least one named param
            # with a preceding comma). Sets the fn-variadic flag and
            # breaks the param loop; no local-var slot is registered
            # for `...` itself.
            if (PEEKT(S) == 112) {
                STI(S, GTI(S) + 1);           # consume '...'
                SFVA(S, fi, 1);
                pgo = 0;
                break;
            }
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var pnoff = PEEKV(S);
            STI(S, GTI(S) + 1);
            # Optional type annotation: fn f(x: Str, y: Vec<i64>, ...)
            # If the type is Str, set bit pc in str_mask for auto-coercion.
            # v5.8.17 §9: if the type resolves to a struct, ALSO tag the
            # param's slot with SLTYPE = -sid so PARSE_FIELD_LOAD/STORE
            # treats `param.field` the same as a struct-typed local
            # initialized from a heap-alloc fn (pointer-mode dot access).
            # Without this tag, `s.len` on a `s: Str` parameter would
            # fall through to the undefined-variable path or read from
            # the slot's literal value.
            var pt_sid = 0;
            # v6.4.57 (Gap A) — scalar f64/f32 param tag (declared per-param here,
            # set from the type-name byte-match below, applied at the SLTYPE site).
            var pt_float = 0;
            # v5.10.38 — hoist pt_simd_class out of the nested type-
            # annotation block so the SIMD vs int-class path branch
            # below can see it. 0 = int-class (default), 1 = f64v2,
            # 2 = f64v4.
            var pt_simd_class = 0;
            var pt_simd_sid = 0;     # SLTYPE sentinel: 2093 f64v2 / 2125 f64v4 / 2121 f32v4 (all descriptor-band)
            if (PEEKT(S) == 49) {
                STI(S, GTI(S) + 1);  # consume :
                if (PEEKT(S) == 8) { STI(S, GTI(S) + 1); }  # skip * for pointer types
                if (PEEKT(S) == 2) {
                    var tnoff = PEEKV(S);
                    # v6.3.5 CO-01 — classify the param type-name once via the
                    # shared _classify_param_type, then fold the class into the
                    # per-fn masks. Identical behavior to the prior inline byte-
                    # compares (the type vocab — Str / cstring / Result / Option /
                    # Tagged / f64v2 / f64v4 — is mutually exclusive, so first-
                    # match == set-one-mask). Sharing the classifier keeps this
                    # pass-2 definition byte-identical with the pass-1
                    # _prescan_fn_sig signature scan (CO-01). Each class gets its
                    # own per-fn bitmask in a parallel heap region (0x93A000+);
                    # PARSE_FNCALL consults the masks for call-site type checks
                    # and value-form SIMD-arg routing.
                    var _ptc = _classify_param_type(S, tnoff);
                    # v6.4.57 (Gap A) — scalar f64/f32 param (exact "f64\0" / "f32\0").
                    # Only when _ptc == 0 so the SIMD f*v* vectors (which share the
                    # "f64"/"f32" prefix) are already caught by the classifier; the
                    # 4-byte mask with a trailing nul rules out "f32v8" etc. Applied to
                    # the int-class local's SLTYPE below (scalar f64/f32 travel in an int
                    # arg-reg as the raw IEEE bit-pattern, matching the return convention).
                    if (_ptc == 0) {
                        var _pfn = L64(S + 0x60000 + tnoff) & 0xFFFFFFFF;
                        if (_pfn == 0x00343666) { pt_float = F64_TYID; }
                        elif (_pfn == 0x00323366) { pt_float = F32_TYID; }
                    }
                    if (_ptc == 1) { str_mask = str_mask | (1 << pc); }
                    elif (_ptc == 2) { cstring_mask = cstring_mask | (1 << pc); }
                    elif (_ptc == 3) { result_mask = result_mask | (1 << pc); }
                    elif (_ptc == 4) { option_mask = option_mask | (1 << pc); }
                    elif (_ptc == 5) { tagged_mask = tagged_mask | (1 << pc); }
                    elif (_ptc == 6) { pt_simd_class = 1; pt_simd_sid = 2093; }  # f64v2 (v6.4.14: was 20, collided w/ struct-id 20)
                    elif (_ptc == 7) { pt_simd_class = 2; pt_simd_sid = 2125; }  # f64v4 (v6.4.14: was 21)
                    elif (_ptc == 8) { pt_simd_class = 1; pt_simd_sid = 2121; }  # f32v4
                    elif (_ptc <= 0 - 2048) { pt_simd_class = 1; pt_simd_sid = 0 - _ptc; }  # v6.4.7: integer 128-bit vector (16-byte/1-XMM, SLTYPE = sentinel)
