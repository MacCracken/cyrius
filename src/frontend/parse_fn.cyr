# A struct return of another struct, by name: `kind` 0 a value (`u` (a `U8`)), 1 a pointer (`pu` (a
# `*U8`)), 2 a dereference (`*pu` (a `U8`)), 3 an address-of (`&u` (a `*U8`), 6.7.13 D4 (a)). Reported at
# token `ti`; the parse goes on (no cascade). `nm` the result of a call to fn `fi` is named as the source spells it
# (`Pt.dup`, `_fn_src_name`; -1: a name as written). CHANGELOG [6.7.15]
fn _ret_sid_refuse(S, ti, nm, fi, usid, kind): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(ti, "_ret_sid_refuse", ((nm * 31 + usid) * 31 + kind) * 4096 + _cur_fn_ret_sid, 0) == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    PRSTR(": a fn returning the struct `");
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (_cur_fn_ret_sid - 1) * 8));
    PRSTR("` takes a value of that struct, or a pointer to one — got `");
    if (kind == 2) { PRSTR("*"); }
    if (kind == 3) { PRSTR("&"); }
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, nm));
    PRSTR("` (a `");
    if (kind == 1 || kind == 3) { PRSTR("*"); }
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (usid - 1) * 8));
    PRSTR("`)\n");
    _had_error = 1;
    return 0;
}
# `return IDENT;` forms after the struct classes, one call in PARSE_RETURN (cybs's per-fn ceiling).
fn _ret_var_forms(S): i64 {
    if (_ret_tuple_var(S) == 1) { return 1; }
    return _ret_small_ptrp(S);
}
# ⛔ 6.7.7 (B4, T5) — `return t;` with `t` a TUPLE — a local, a by-value parameter (copied in, so
# inline) or a global — from a fn DECLARED with its values, `: (T1, T2[, T3])`, element for element
# by class (f64, bool, any other integer class): its slots are loaded into the multi-value return
# registers as `return (t.0, t.1);` loads them (rax, rdx[, r3]; every load before the moves that
# set rdx / r3), and it lands as that arm lands (EJMP0 + rp_vec), so the defer walker, EDEFER_SAVE
# and the #inline replay treat it as that arm. Anything else is refused by name: an undeclared,
# scalar, struct or vector fn, a closure, an `async fn`, an arity or class mismatch (a retptr struct
# fn reports first, `_ret_struct_big`). Under the struct rule the scalar path refused it as a value
# (`_tup_rchk`). Parentheses around `t` are transparent (6.7.6): `(`s, the name, as many `)`s, `;` —
# read in one linear pass, since this runs for every `return` (a `_pwrap_k` peel is quadratic in the
# depth: `return ((..((1))..));` 65536 deep took 99 s). 1 = done (`;` consumed); 0 = not a tuple
# (cursor kept). CHANGELOG [6.7.7]
var _rtv_sid = 0;
fn _ret_tuple_var(S): i64 {
    var st = GTI(S);
    var k = 0;
    while (TOKTYP(S, st + k) == 10) { k = k + 1; }
    var ti = st + k;
    if (TOKTYP(S, ti) != 2) { return 0; }
    var j = 1;
    while (j <= k) {
        if (TOKTYP(S, ti + j) != 11) { return 0; }
        j = j + 1;
    }
    if (TOKTYP(S, ti + j) != 5) { return 0; }
    var idx = _ret_tup_idx(S, TOKVAL(S, ti));
    if (idx == 0 - 1) { return 0; }
    var sid = _rtv_sid;
    STI(S, ti + j + 1);   # past the `)`s and the `;`
    if (_ret_tup_ok(S, ti, sid) == 0) { return 1; }
    var n = GETFCOUNT(S, sid - 1);
    _fld_addr_ra(S, idx, sid, 0, 0 - 1);
    ELOAD64(S);
    EPUSHR(S);
    if (n == 3) {
        _fld_addr_ra(S, idx, sid, 8, 0 - 1);
        ELOAD64(S);
        EPUSHR(S);
    }
    _fld_addr_ra(S, idx, sid, (n - 1) * 8, 0 - 1);
    ELOAD64(S);
    if (n == 3) {
        EMOVR3RAX(S);
        EPOPR(S);
    }
    EMOVRDXRAX(S);
    EPOPR(S);
    var rp = EJMP0(S);
    vec_push(rp_vec, rp);
    return 1;
}
# The tuple `noff` names, resolved as a factor resolves it — a local, then (a closure's capture is
# not one here: the value path refuses it) a global: its field-base index (`0 - 2 - li`, or the
# global's), `_rtv_sid` its tuple; -1 = not a tuple.
fn _ret_tup_idx(S, noff): i64 {
    _rtv_sid = 0;
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) {
            if (GLAGG(S, li) == 0) { return 0 - 1; }
            var lt = GLTYPE(S, li);
            if (lt >= 0) { return 0 - 1; }
            if (_tup_is(S, 0 - lt) == 0) { return 0 - 1; }
            _rtv_sid = 0 - lt;
            return 0 - 2 - li;
        }
        if (_CL_CAP_FIELD_IDX(S, noff) < 0 - 1) { return 0 - 1; }
    }
    var gi = _findvar_core(S, noff);
    if (gi < 0) { return 0 - 1; }
    if (GVPM(S, gi) != 2) { return 0 - 1; }
    if (_tup_is(S, GVTYPE(S, gi)) == 0) { return 0 - 1; }
    _rtv_sid = GVTYPE(S, gi);
    return FINDVAR(S, noff);   # the reference: its visibility checked
}
# 1 = the fn being parsed declares tuple `sid`'s values (`t` at token `ti`); else refused, 0. An
# #inline replay parses the CALLEE's body in the caller's context: its definition checked itself.
fn _ret_tup_ok(S, ti, sid): i64 {
    if (GIDEP(S) != 0) { return 1; }
    if (_cur_fn_ret_pair == 1) { return 0; }   # a 9-16 B struct fn: its class refused `t` (`_ret_struct_pair`)
    var fi = _cur_fn_ix;
    if (fi < 0) { return _ret_tup_err(S, ti, sid, 1); }
    if (_cur_fn_coro == 1 || _fn_async_impl(S, fi) == 1) {
        if (GFRS(S, fi) == MULTIRET_SID) { return 0; }   # 6.7.11: refused at its declaration, once
        return _ret_tup_err(S, ti, sid, 2);
    }
    if (GFRS(S, fi) != MULTIRET_SID) { return _ret_tup_err(S, ti, sid, 1); }
    var n = GETFCOUNT(S, sid - 1);
    if (GFRN(S, fi) != n) { return _ret_tup_err(S, ti, sid, 3); }
    var k = 0;
    while (k < n) {
        if (_tup_ek(S, sid, k) != _mret_ek(S, fi, k)) { return _ret_tup_err(S, ti, sid, 3); }
        k = k + 1;
    }
    return 1;
}
# 1 = fn `fi` is an `async fn`'s body: the name `_mint_impl_name` gave it ends `$impl` (`$` is no
# identifier byte, and `impl` is a keyword, so no generic instance ends so). Its Future carries one i64.
fn _fn_async_impl(S, fi): i64 {
    var nm = S + 0xEC00000 + L64(_fnt_names + fi * 8);
    var n = 0;
    while (load8(nm + n) != 0) { n = n + 1; }
    if (n < 5) { return 0; }
    if (load8(nm + n - 5) != 36) { return 0; }
    if (load8(nm + n - 4) != 105) { return 0; }
    if (load8(nm + n - 3) != 109) { return 0; }
    if (load8(nm + n - 2) != 112) { return 0; }
    if (load8(nm + n - 1) != 108) { return 0; }
    return 1;
}
fn _ret_tup_err(S, ti, sid, kind): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": cannot return tuple '");
    PRSTR(S + 0xEC00000 + TOKVAL(S, ti));
    PRSTR("' ");
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
    if (kind == 2) { PRSTR(" from an `async fn` - it returns one value"); }
    elif (kind == 3) {
        PRSTR(" from '");
        PRSTR(S + 0xEC00000 + L64(_fnt_names + _cur_fn_ix * 8));
        PRSTR("' - it returns ");
        _mret_spell(S, _cur_fn_ix);
    } elif (GETFCOUNT(S, sid - 1) > 3) {   # 6.7.7 (B4 review): no fn declares 4 values (the return registers)
        PRSTR(" - a fn returns at most 3 values: return its elements, or pass the tuple to a parameter");
    } else {
        PRSTR(" - a tuple is returned by a fn declared with its values, `: ");
        PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
        PRSTR("`");
    }
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}
# The struct slot `li` points at (struct `sid`), copied byte-exact into an inline frame temp; its field-0
# slot. Under 8 B the temp's word is what a by-value consumer loads (`return q` of a `*S` parameter, a
# handle passed by value), so it is zeroed first: the padding is 0, never the frame's old bytes.
# CHANGELOG [6.7.13]
fn _sptr_param_temp(S, li, sid): i64 {
    var t = _agg_temp(S, sid);
    var sz = STRUCTSZ(S, sid - 1);
    if (sz < 8) { EMOVI(S, 0); EFLSTORE(S, t); }
    _agc_copy_bytes(S, t, 0 - 1, _AGC_DREF(li), 0 - 1, sz);
    return t;
}

# ⛔ 6.6.16 (C7) — A PARAMETER ANNOTATED WITH A PLAIN STRUCT IS A VALUE, AT EVERY WIDTH. Over 8 B
# the caller passes the struct's ADDRESS (the ABI above, unchanged), and nothing ever made the copy
# "by value" promises: `fn bump(p: P3) { p.x = p.x + 1; }` wrote the CALLER's struct — a named
# local, a global, a pointer-mode local's heap object, a forwarded parameter, a typed `self: T`
# receiver, a generic instance, a call through `fncall1(&bump, &p)`, and at top level a field
# (`take(BX.v)`). Only a field argument inside a fn was copied (6.6.12, caller-side, so not at top
# level). The copy is made HERE, in the callee's prologue — one site for every caller, fn pointers
# included, built from frontend emitters every backend has: after `_stkp_flush` has homed every
# parameter slot (a Win64 5th+ / SysV 7th+ pointer arrives on the stack) and before the body. Each
# such parameter's struct is copied into an inline frame aggregate (`_sptr_param_temp`), which
# takes the parameter's NAME at the parameter's depth (so a body `var p` is a duplicate exactly
# as before); the pointer slot is renamed -1. From there it is an ordinary inline local: field
# access, `q = r`, `return q`, `&q`, operators and closure captures take their inline paths.
# A `p: *T` parameter is a pointer and is never copied (`_is_ptr_param`); a `#naked` fn has no
# frame; a coroutine impl is re-entered on every resume (and an `async fn` refuses such a
# parameter, `_refuse_async_struct_param`). CHANGELOG [6.6.16]
# 6.6.20: and record which parameters are copied in, exactly, for every call parsed after this
# definition (`_pm_copies`; pass 1 predicted it for the calls before, and a generic INSTANCE, which
# pass 1 never saw, gets it here).
# ⚠ NOT for a REDEFINED fn (flag 2048, pass 1): every call to it reaches its LAST definition
# (`_fn_redirect`), whose copies pass 1 recorded, so the definition in hand is not the callee of a
# call parsed after it. Writing its record here raised a bit for `f(q: P3)` above `f(q: *P3)` (the
# signature check lets the pair through: both address-pass the same struct), and a later tail call
# kept its `jmp` while the `*P3` body held `&s` — a silent wrong value. CHANGELOG [6.6.20]
# 6.7.9: `rf` is the fn the record is written for, -1 for a redefinition (SFBVCP and `_bvhi_*` write
# nothing for it); its copies row past ordinal 61 is replaced whole, as the mask is.
fn _sptr_params_localize(S): i64 {
    var m = 0;
    var rf = _cur_fn_ix;
    if ((GFLG(S, rf) & 2048) != 0) { rf = 0 - 1; }
    _bvhi_reset(rf);
    if (_cur_fn_naked == 0) { if (_pending_coro == 0) { m = _sptr_params_copy(S, rf); } }
    SFBVCP(rf, m);
    return 0;
}
# Each parameter owns exactly ONE named slot (a vector's filler slots are -1), so a parameter's
# ordinal is the number of named slots below it — counted before `_sptr_param_localize1` renames
# the slot. Returns the copied ordinals below 62; one past 61 goes to `rf`'s copies row.
fn _sptr_params_copy(S, rf): i64 {
    var m = 0;
    var ord = 0;
    var li = 0;
    while (li < _cur_fn_pslots) {
        if (L64(S + 0x5D9D000 + li * 8) != 0 - 1) {
            if (_sptr_param_in(S, li) == 1) { m = _bvcp_bit(rf, m, ord); }
            ord = ord + 1;
        }
        li = li + 1;
    }
    return m;
}
# 1 = the parameter in slot `li` is a copy: a by-value struct over 8 B, copied in here, or a Win64
# value-form vector, which the parameter loop's ESTOREPARM_SIMD_WIN64 already copied in.
fn _sptr_param_in(S, li): i64 {
    if (_local_is_sptr_param(S, li) == 1) {
        if (_is_ptr_param(S, li) == 1) { return 0; }
        _sptr_param_localize1(S, li);
        return 1;
    }
    if (_TARGET_PE == 1) { if (GLTYPE(S, li) <= 0 - 2048) { return 1; } }
    return 0;
}
fn _sptr_param_localize1(S, li): i64 {
    var d = GSDEP(S);
    SSDEP(S, 0);
    var t = _sptr_param_temp(S, li, 0 - GLTYPE(S, li));
    SSDEP(S, d);
    S64(S + 0x5D9D000 + t * 8, L64(S + 0x5D9D000 + li * 8));
    SSLICE_W(S, t, 0);
    S64(S + 0x5D9D000 + li * 8, 0 - 1);
    return 0;
}

# ⭐ 6.6.5 — PARSE_FNCALL's `: Str` param auto-coercion, EXTRACTED so the method-call path
# (parse_decl.cyr) uses the same code rather than a second copy that drifts. A string
# literal landing in a param the callee annotated `: Str` is wrapped in `str_from(...)`;
# without the wrap the callee receives a raw cstr pointer and every Str accessor reads the
# wrong shape. Measured on 6.6.4 AND on the first cut of this bite: `h.slen("abcde")`
# returned 0 where the identical free fn `free_slen(0, "abcde")` returned 5 — a SILENT
# wrong value on the very argument loop this release rewrote. Returns 1 when handled (the
# literal is consumed and its Str pushed); 0 leaves the cursor untouched. CHANGELOG [6.6.5]
fn _try_push_str_literal_arg(S, fi, argc): i64 {
    if (fi < 0) { return 0; }
    if (_pm_str(fi, argc) == 0) { return 0; }   # 6.6.17 (a10)
    if (PEEKT(S) != 30) { if (_cst_str_tok(S, GTI(S)) == 0) { return 0; } }   # 6.7.2: or a string const
    var sf_fi = FINDFN(S, _STR_FROM_NOFF(S));
    PCMPE(S);
    EPUSHR(S);
    ECALLPOPS(S, 1);
    if (sf_fi >= 0) {
        var sfoff = L64(_fnt_offsets + sf_fi * 8);
        if (sfoff >= 0) { ECALLTO(S, sfoff); }
        else { ECALLFIX(S, sf_fi); }
    }
    ECALLCLEAN(S, 1);
    EPUSHR(S);
    return 1;
}

# ⭐ 6.6.5 — PARSE_FNCALL'S `: Str` WRAP CRITERION, ASKED OF A CALL WITHOUT PARSING IT.
#
# The `return f(args);` tail path emits its own epilogue + `jmp` and never enters
# PARSE_FNCALL, so anything PARSE_FNCALL does to an ARGUMENT must be replicated there or
# diverted back. The divert is the cheap, safe half — but only if its predicate is EXACTLY the
# helper's. `_try_push_str_literal_arg` wraps an argument iff (a) that argument's FIRST token
# is a string literal and (b) the callee's `_fnt_strmask` bit for that argument's POSITION is
# set. This answers the same question over the raw token stream, so the divert cannot fire
# where the wrap would not, and cannot fail to fire where it would.
#
# The arguments are numbered by `_arg_next`, the one argument walker: a nested call, an index or a
# struct initializer cannot leak its commas into this call's numbering, nor can a closure's
# `|a, b|` bars. ⛔ 6.7.7 — this scan counted that comma, so `return sl(|a, b| a + b, "hello");`
# into `fn sl(c, t: Str)` read the literal as argument 2, kept its `jmp` and passed the raw
# literal where a Str is expected (0 where 5 is right). CHANGELOG [6.7.7]
#
# ⚠ Both looser approximations were written, shipped into a review round and MEASURED wrong:
# "a literal anywhere in the parens" cost a self-recursive tail call its TCO and turned a
# correct program into a SIGSEGV; "a literal at depth 1, callee has SOME Str param" still
# diverted `f(x, "lit")` where the Str param is argument 0. Over-covering a TCO guard is not
# the safe direction. `ti_open` is the index of the call's `(`. CHANGELOG [6.6.5]
fn _tc_str_literal_arg(S, ti_open, fi): i64 {
    if (fi < 0) { return 0; }
    var mask = L64(_fnt_strmask + fi * 8);
    if (mask == 0) { if (_pm_row_any(fi, 2) == 0) { return 0; } }   # 6.6.17 (a10)
    var i = ti_open + 1;
    if (TOKTYP(S, i) == 11) { return 0; }
    var pos = 0;
    var n = GTCNT(S);
    while (i < n) {
        if (TOKTYP(S, i) == 30 || _cst_str_tok(S, i) == 1) { if (_pm_str(fi, pos) != 0) { return 1; } }
        i = _arg_next(S, i);
        if (TOKTYP(S, i) != 31) { return 0; }   # the call's `)`, or EOF
        i = i + 1;
        pos = pos + 1;
    }
    return 0;
}

# ⭐ 6.6.13 (I11) — THE Str -> `: cstring` WARNING. It typed only an argument whose FIRST token
# was a `Str` local, on PARSE_FNCALL's path alone: a call result (`f(o, str_from("k"))`), a
# global, a `: Str` field, a tail call and a method call all compiled silent, `s.data` was
# reported as the Str itself, and the hint recommended `str_data(x)` — which a `: cstring`
# param reads past the Str's length (a slice borrows its parent's bytes), so taking the hint
# turned a warned bug into a silent one. Now ONE read-only helper serves every argument loop
# (PARSE_FNCALL, `_call_arg_one` — method calls and the struct-valued own calls — and
# PARSE_RETURN's tail loop) and types the argument only when it is a single primary that ends
# it: `x`, `f(..)` (the callee's `: Struct` return) or `x.f` (the field's declared type).
# Anything else (`s + 8`, `s.len`, `load64(p)`, an index, a chain) is left alone. Warning text
# only: nothing here moves the cursor or emits code, and the inferred-global record it reads
# (GVDSID) is diagnostic-only, so every binary is byte-identical. CHANGELOG [6.6.13]

# The `)` matching the `(` at token `ti`, or -1 when the input ends first. Read-only.
fn _tok_close_paren(S, ti): i64 {
    var depth = 0;
    var i = ti;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0 - 1; }
        if (t == 10) { depth = depth + 1; }
        if (t == 11) {
            depth = depth - 1;
            if (depth == 0) { return i; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# 1 when token `ti` ends an argument (`,` or `)`).
fn _tok_ends_arg(S, ti): i64 {
    var t = TOKTYP(S, ti);
    if (t == 31) { return 1; }
    if (t == 11) { return 1; }
    return 0;
}

# ⭐ 6.7.7 (B6) — THE PARAMETER-LIST AND ARGUMENT-LIST WALKERS: one rule for every walker that
# steps over a parameter or an argument (default and named arguments). Cursor-free, read-only.
#   * In a parameter's TYPE `<` / `>` nest (`m: Map<K, V>`); in its DEFAULT, after a depth-0 `=`,
#     they are operators (`b = A < B`), so a default is skipped with `( [ {` balance only. A walker
#     that counted `<` there would lose the list's end.
#   * In an ARGUMENT list a closure's `|a, b|` bars, at an argument's start (or after a `name:`
#     label), hold a comma that separates nothing, and so does an explicit generic call's type
#     argument list (`pk<i64, i64>(1, 2)`). Every scanner that numbers or counts a call's
#     arguments steps by `_arg_next` — `_CALL_ARGC_PEEK`, `_call_arg_start` and
#     `_tc_str_literal_arg` counted the closure's comma until the closure-comma fix, and every
#     client counted the type arguments' until the generic-comma fix (CHANGELOG [6.7.7]).
# At the end of input each returns the EOF token, never its start, so a walker that `continue`s
# from the result always moves. CHANGELOG [6.7.7]

# From token `q`: the first `,` or `)` outside `( [ {` nesting, or the EOF token.
fn _tok_item_end(S, q): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (q < n) {
        var t = TOKTYP(S, q);
        if (t == 12) { return q; }
        if (d == 0) { if (t == 31 || t == 11) { return q; } }
        if (t == 10 || t == 28 || t == 13) { d = d + 1; }
        if (t == 11 || t == 29 || t == 14) { d = d - 1; }
        if (d < 0) { d = 0; }
        q = q + 1;
    }
    return q;
}
# The depth-0 `,` or `)` that ends the parameter default whose `=` is token `i` (or the EOF token).
fn _pl_dflt_end(S, i): i64 {
    return _tok_item_end(S, i + 1);
}
# A parameter TYPE's nesting depth after token type `t`: `( [ { <` open; `>>` / `>>>` close two /
# three (`Vec<Vec<i64>>`).
fn _pl_tdepth(t, d): i64 {
    if (t == 10 || t == 28 || t == 13 || t == 19) { return d + 1; }
    if (t == 11 || t == 29 || t == 14 || t == 20) { d = d - 1; }
    if (t == 39) { d = d - 2; }
    if (t == 152) { d = d - 3; }
    if (d < 0) { return 0; }
    return d;
}
# The depth-0 `,` or `)` that ends the parameter whose first token is `i` (a name, or `...`), or the
# EOF token: its type balanced by `_pl_tdepth`, a default from its depth-0 `=` by `_pl_dflt_end`.
fn _pl_next(S, i): i64 {
    var q = i;
    var d = 0;
    var n = GTCNT(S);
    while (q < n) {
        var t = TOKTYP(S, q);
        if (t == 12) { return q; }
        if (d == 0) {
            if (t == 31 || t == 11) { return q; }
            if (t == 4) { return _pl_dflt_end(S, q); }
        }
        d = _pl_tdepth(t, d);
        q = q + 1;
    }
    return q;
}
# 1 when the parameter list whose `(` is token `op` declares a default (a parameter-level `=`).
fn _pl_has_dflt(S, op): i64 {
    var q = op + 1;
    var d = 0;
    var n = GTCNT(S);
    while (q < n) {
        var t = TOKTYP(S, q);
        if (t == 12) { return 0; }
        if (d == 0) {
            if (t == 11) { return 0; }
            if (t == 4) { return 1; }
        }
        d = _pl_tdepth(t, d);
        q = q + 1;
    }
    return 0;
}
# 1 when token `ti` starts a named argument's label `name:`. Nothing else starts a call argument
# `IDENT :` — there is no ternary and no `::`, and a struct literal is only a `var` initializer.
fn _pd_label_at(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (TOKTYP(S, ti + 1) != 49) { return 0; }
    return 1;
}
# The depth-0 `,` or `)` that ends the call argument (or tuple element) whose first token is `i`
# (just past the `(` or a `,`), or the EOF token. A closure's `|..|` bars at its start, or after its
# label, are stepped over whole (`||` is one token, with no bars; a closure's parameters are
# untyped, so no `:`) — EVERY leading head: a body that opens with `|` or `||` is another closure
# literal (there is no unary `|`), so `|a| |b, d| ..` holds no argument separator.
# ⛔ 6.7.7 — and a comma inside an explicit generic call's type arguments ends nothing: a generic
# call that starts before it and opens its `(` past it (`_arg_gen_past`) is stepped over whole, and
# the walk resumes after its `)`. A comparison `a < b, c > d` keeps its comma: `_tup_gopen` answers
# only for a KNOWN generic fn whose list resolves as types and closes right before a `(`. Only a
# comma can lie inside a type-argument list, so an argument ending at `)` is never re-scanned. Until
# this, B4's `_tup_item_end` alone stepped over it (now folded in here: one walker), so `return
# w(pk<i64, i64>(1, 2));` into `fn w(a, b = 3)` was an `internal:` error, `w(b: pk<i64, i64>(1, 2),
# a: 1)` "a positional argument cannot follow a named one", and `show(s, pk<i64, i64>(1, 2))` was
# not routed to `show_str` (silent since 6.7.6). CHANGELOG [6.7.7]
fn _arg_next(S, i): i64 {
    var q = i;
    if (_pd_label_at(S, q) == 1) { q = q + 2; }
    var go = 1;
    while (go == 1) {
        var t = TOKTYP(S, q);
        if (t == 54) { q = q + 1; }
        elif (t == 35) {
            q = q + 1;
            while (TOKTYP(S, q) != 35 && TOKTYP(S, q) != 12) { q = q + 1; }
            if (TOKTYP(S, q) == 35) { q = q + 1; }
        } else { go = 0; }
    }
    var e = _tok_item_end(S, q);
    while (TOKTYP(S, e) == 31) {
        var g = _arg_gen_past(S, q, e);
        if (g < 0) { return e; }
        q = _call_close(S, g) + 1;
        e = _tok_item_end(S, q);
    }
    return e;
}
# The `(` of an explicit generic call `name<..>(` that starts in [q, e) and opens PAST `e` — so `e`
# is a comma inside its type arguments — or -1. (One nested inside a group there is balanced whole.)
fn _arg_gen_past(S, q, e): i64 {
    while (q < e) {
        if (TOKTYP(S, q) == 2) {
            if (TOKTYP(S, q + 1) == 19) {
                var o = _tup_gopen(S, q);
                if (o > e) { return o; }
            }
        }
        q = q + 1;
    }
    return 0 - 1;
}
# 1 when an argument of the call whose `(` is token `open` is named (`f(1, c: 3)`).
fn _pd_named_at(S, open): i64 {
    var q = open + 1;
    if (TOKTYP(S, q) == 11) { return 0; }
    var n = GTCNT(S);
    while (q < n) {
        if (_pd_label_at(S, q) == 1) { return 1; }
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0; }
        q = q + 1;
    }
    return 0;
}
# The depth-0 `=` of the parameter whose first token is `i` (its type nests `<..>`), or -1 when
# the parameter ends first.
fn _pl_eq(S, i): i64 {
    var q = i;
    var d = 0;
    var n = GTCNT(S);
    while (q < n) {
        var t = TOKTYP(S, q);
        if (t == 12) { return 0 - 1; }
        if (d == 0) {
            if (t == 31 || t == 11) { return 0 - 1; }
            if (t == 4) { return q; }
        }
        d = _pl_tdepth(t, d);
        q = q + 1;
    }
    return 0 - 1;
}
# The first parameter-level `=` of the list whose `(` is token `op`, or -1.
fn _pd_first_eq(S, op): i64 {
    var q = op + 1;
    if (TOKTYP(S, q) == 11) { return 0 - 1; }
    var n = GTCNT(S);
    while (q < n) {
        var eq = _pl_eq(S, q);
        if (eq >= 0) { return eq; }
        q = _pl_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0 - 1; }
        q = q + 1;
    }
    return 0 - 1;
}

# ⭐ 6.7.7 (B6) — PARAMETER DEFAULTS, THE DEFINITION SIDE. `fn f(a, b = 2, c: f64 = 1.5)`: a default
# is a compile-time constant (what a top-level `const X = ..;` takes, minus a `{`) on a TRAILING
# parameter (user, 2026-10-08). Pass 1 records each definition's defaults (`_pd_record_at`, from
# `_prescan_params_scan`) and refuses a bad SHAPE there; the end of pass 1 evaluates every default
# once, in the top context with the parser cursor on its own token — so FINDFN's file scoping and
# a const's `private` judge it at the definition, and no caller's local is ever visible — and
# refuses a value its parameter's type does not take (`_pd_sweep`). A refused row keeps its min — a
# call that leaves a refused default to it is not refused a second time, by arity (the default's own
# refusal stopped the build; the fill pushes 0) — except a fn defined twice (D15), whose calls pass
# every argument. Names are never stored: the definition's tokens hold them. Every
# refusal is one line at its token (`_tn_once`), and the parse stays in step. CHANGELOG [6.7.7]
# Row (alloc'd per definition that declares a default): [0] max = the parameter count, [8] min =
# the first default's index (max for D15), [16] the list's `(`, [24] flags (1 a refused
# shape: never evaluated; 2 redefined; 4 refused), [32] d0 = the first default's index, then for
# parameter d0 + j at [40 + j * 56]: its `=` token, its type token (-1 untyped), state (0 new, 1
# being evaluated, 2 done, 3 refused), kind (0 i64, 1 f64, 2 string, 3 bool), value, float-literal
# index (an f64's), its name.
var _fnt_pdflt = 0;   # per fn (131072, alloc'd at the first default anywhere): its row, 0 = none
fn _pd_row(fi): i64 {
    if (_fnt_pdflt == 0) { return 0; }
    if (fi < 0) { return 0; }
    return load64(_fnt_pdflt + fi * 8);
}
fn SFPD(fi, row): i64 {
    if (_fnt_pdflt == 0) { _fnt_pdflt = alloc(131072 * 8); }
    store64(_fnt_pdflt + fi * 8, row);
    return 0;
}
# A row refused (`shape` 1: never evaluated). Its min is kept: a short call is not refused again by
# arity, one error per mistake (6.7.13, issues/archived/2026-10-14-refused-parameter-default-refuses-every-short-call.md).
fn _pd_refuse_row(row, shape): i64 {
    var f = L64(row + 24) | 4;
    if (shape == 1) { f = f | 1; }
    S64(row + 24, f);
    return 0;
}

# A refusal AT token `ti`: `_pd_eo` opens the line (0 when the token was reported already, or an
# earlier error holds the panic latch — the `_bx_refuse` rule), the caller prints the text,
# `_pd_ec` closes it (the excerpt; no binary). The latch is left as it was.
fn _pd_eo(S, ti): i64 {
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": ", 2);
    return 1;
}
fn _pd_ec(S, ti): i64 {
    syscall(SYS_WRITE, 2, "\n", 1);
    var sv = GTI(S);
    STI(S, ti);
    _err_excerpt(S);
    STI(S, sv);
    _had_error = 1;
    return 0;
}
fn _pd_say(S, ti, msg): i64 {
    if (_pd_eo(S, ti) == 0) { return 0; }
    PRSTR(msg);
    return _pd_ec(S, ti);
}
fn _pd_q(S, noff): i64 {
    syscall(SYS_WRITE, 2, "'", 1);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "'", 1);
    return 0;
}
# "parameter 'p' of 'f'"
fn _pd_pof(S, pnoff, fi): i64 {
    PRSTR("parameter ");
    _pd_q(S, pnoff);
    PRSTR(" of ");
    _pd_q(S, _bx_fname(S, fi));
    return 0;
}
# The same at a call (C3, C4, C6): the callee as the source spells it (`_fn_src_name`, 6.7.14).
fn _pd_pofc(S, pnoff, fi): i64 {
    PRSTR("parameter ");
    _pd_q(S, pnoff);
    PRSTR(" of ");
    _pd_q(S, _fn_src_name(S, fi, _bx_fname(S, fi)));
    return 0;
}

# ── pass 1: the record ──────────────────────────────────────────────────────────────────────
# Definition fi, whose list's `(` is token `op` (cursor-free; `_prescan_params_scan` has just
# written its parameter count). A list with no default records nothing.
fn _pd_record_at(S, fi, op): i64 {
    var row = _pd_row(fi);
    if (row != 0) { if (L64(row + 16) == op) { return 0; } }
    if ((GFLG(S, fi) & 2048) != 0) {
        if (row != 0 || _pl_has_dflt(S, op) == 1) { _pd_redef(S, fi, op, row); }
        return 0;
    }
    if (_pl_has_dflt(S, op) == 0) {
        if (row != 0) { SFPD(fi, 0); }
        return 0;
    }
    var max = L64(_fnt_params + fi * 8);
    row = alloc(40 + max * 56);
    S64(row, max);
    S64(row + 8, max);
    S64(row + 16, op);
    S64(row + 24, 0);
    S64(row + 32, max);
    SFPD(fi, row);
    # A refused shape: the min is the parameters before the first `=` — D11 / D13 refuse the whole list
    # before `_pd_shape` lowers it from max. CHANGELOG [6.7.13]
    if (_pd_shape(S, fi, row) == 1) { _pd_refuse_row(row, 1); S64(row + 8, _pd_req_n(S, op)); }
    return 0;
}
# D15: a fn defined twice (fn flag 2048, pass 1) where any definition declares a default — which
# list a call would be checked and filled against is not one thing. Reported once.
fn _pd_redef(S, fi, op, row): i64 {
    if (row == 0) {
        row = alloc(40);
        S64(row + 16, op);
        S64(row + 24, 0);
        SFPD(fi, row);
    }
    var max = L64(_fnt_params + fi * 8);
    S64(row, max);
    S64(row + 32, max);
    var seen = L64(row + 24) & 2;
    S64(row + 24, L64(row + 24) | 2);
    _pd_refuse_row(row, 1);
    S64(row + 8, max);   # D15: which list a call is checked against is not one thing — every argument
    if (seen != 0) { return 0; }
    var nt = GFDS(S, fi);
    if (_pd_eo(S, nt) == 0) { return 0; }
    PRSTR("fn ");
    _pd_q(S, _bx_fname(S, fi));
    PRSTR(" is defined twice and declares parameter defaults");
    return _pd_ec(S, nt);
}
# Walk definition fi's parameters: each default's entry recorded; a bad shape refused at its token.
# The whole-list refusals come first (D11 a variadic fn; D13 a method of `impl Trait for T` — a
# trait default an impl inherits is that too, and `_tr_scan_tm` already refused its first `=`, so
# nothing more is said), then D1 a parameter with no default after one with a default, and D10 /
# D4 in `_pd_shape1`. 1 = refused.
fn _pd_shape(S, fi, row): i64 {
    var op = L64(row + 16);
    if (GFVA(S, fi) != 0) {
        _pd_say(S, _pd_first_eq(S, op), "a variadic fn takes no parameter defaults");
        return 1;
    }
    if (_impl_trait != 0) {
        var ft = _pd_first_eq(S, op);
        if (_pd_eo(S, ft) == 0) { return 1; }
        _pd_q(S, TOKVAL(S, GFDS(S, fi)));
        PRSTR(" implements trait ");
        _pd_q(S, _impl_trait);
        PRSTR(": its parameters take no defaults (the trait's signature is the contract)");
        _pd_ec(S, ft);
        return 1;
    }
    var max = L64(row);
    var q = op + 1;
    var k = 0;
    var d0 = 0 - 1;
    while (k < max) {
        if (TOKTYP(S, q) != 2) { return 1; }   # malformed: pass 2 refuses the list
        var eq = _pl_eq(S, q);
        if (eq >= 0) {
            if (d0 < 0) { d0 = k; S64(row + 8, k); S64(row + 32, k); }
            if (_pd_shape1(S, row, k, q, eq) == 1) { return 1; }
        } elif (d0 >= 0) {
            if (_pd_eo(S, q) == 1) {
                _pd_pof(S, TOKVAL(S, q), fi);
                PRSTR(" needs a default: it follows one that has a default (defaults are trailing)");
                _pd_ec(S, q);
            }
            return 1;
        }
        q = _pl_next(S, q);
        if (TOKTYP(S, q) != 31) { break; }
        q = q + 1;
        k = k + 1;
    }
    return 0;
}
# Parameter k of a definition (its name `q`, its `=` `eq`): its entry; D10 a default on the
# receiver `self`, D4 a `{` in a default (a block or an if-expression — the signature tools all
# take the first `{` for the body; a const names it). 1 = refused.
fn _pd_shape1(S, row, k, q, eq): i64 {
    var en = row + 40 + (k - L64(row + 32)) * 56;
    S64(en, eq);
    var tt = 0 - 1;
    if (TOKTYP(S, q + 1) == 49) { tt = q + 2; }
    S64(en + 8, tt);
    S64(en + 16, 0);
    S64(en + 24, 0);
    S64(en + 32, 0);
    S64(en + 40, 0 - 1);
    S64(en + 48, TOKVAL(S, q));
    if (k == 0) { if (_noff_is(S, TOKVAL(S, q), "self", 4) == 1) {
            _pd_say(S, eq, "the receiver 'self' takes no default");
            return 1;
        } }
    var e = _pl_dflt_end(S, eq);
    var i = eq + 1;
    while (i < e) {
        if (TOKTYP(S, i) == 13) {
            _pd_say(S, eq + 1, "a parameter default cannot hold a block or an if-expression - declare a const and name it");
            return 1;
        }
        i = i + 1;
    }
    return 0;
}
# D12 / D14 (`_tr_scan_tm`, pass 1): a default in a trait method's list — its default method's
# or its REQUIRED signature's (fork F1, user 2026-10-09: an error; it was accepted and ignored).
fn _pd_trait_refuse(S, tx, p, op): i64 {
    var eq = _pd_first_eq(S, op);
    if (eq < 0) { return 0; }
    if (_pd_eo(S, eq) == 0) { return 0; }
    PRSTR("trait ");
    _pd_q(S, L64(_tr_tab + tx * 32));
    PRSTR(" method ");
    _pd_q(S, TOKVAL(S, p + 1));
    PRSTR(": a trait's methods take no parameter defaults");
    return _pd_ec(S, eq);
}
# D18 (the closure parameter loop, cursor on the `=`): a closure is reached only through fncallN /
# callptr, which pass every argument. The cursor is left on the `,` or `|` that ends the default.
fn _pd_cl_refuse(S): i64 {
    var ti = GTI(S);
    _pd_say(S, ti, "a closure's parameters take no defaults");
    STI(S, _cl_ptail_end(S, ti + 1, 0));
    return 0;
}
# ⛔ 6.7.14 — A TYPED CLOSURE PARAMETER IS REFUSED BY THE RULE, ONCE (cursor on the `:`): a closure's parameters are
# untyped (it is reached only through fncallN / callptr, whose arguments are words). `|m: i64|` was "expected '|',
# got ':'", then the type parsed as the body ("undefined variable 'i64'"), and nested beside an enclosing `m` the
# pre-scan took `m` for a capture ("needs lib/alloc.cyr"). Now named at the `:`, the type stepped over to the `,` /
# `|` that ends it, as D18 steps over a default; the pre-scan reads `m: T` as the parser does (`_cl_lit_end`).
# CHANGELOG [6.7.14]
fn _cl_typed_refuse(S): i64 {
    var ti = GTI(S);
    _pd_say(S, ti, "a closure's parameters are untyped — drop `: T`");
    STI(S, _cl_ptail_end(S, ti + 1, 1));
    return 0;
}
# The closure parameter loop, cursor past a parameter's name: a default (D18) or a type (6.7.14) refused.
fn _cl_param_tail(S): i64 {
    if (PEEKT(S) == 4) { return _pd_cl_refuse(S); }
    if (PEEKT(S) == 49) { return _cl_typed_refuse(S); }
    return 0;
}
# From token `q`, a refused parameter tail's end: the `,` or `|` at depth 0, the end of file, or an unmatched closer.
# `ang` 1 (a type) counts `<` / `>` (`>>`, `>>>`) as brackets too, so `Map<K, V>` is one type; a default's value
# (`ang` 0) does not, where `<` compares.
fn _cl_ptail_end(S, q, ang): i64 {
    var d = 0;
    var n = GTCNT(S);
    while (q < n) {
        var t = TOKTYP(S, q);
        if (t == 12) { return q; }
        if (d == 0) { if (t == 31 || t == 35) { return q; } }
        if (t == 10 || t == 28 || t == 13) { d = d + 1; }
        if (t == 11 || t == 29 || t == 14) { d = d - 1; }
        if (ang == 1) { d = d + _cl_ang_step(t); }
        if (d < 0) { return q; }
        q = q + 1;
    }
    return q;
}
fn _cl_ang_step(t): i64 {
    if (t == 19) { return 1; }
    if (t == 20) { return 0 - 1; }
    if (t == 39) { return 0 - 2; }
    if (t == 152) { return 0 - 3; }
    return 0;
}
# Pass 2, a definition pass 1 did not record (`_PARSE_FN_DEF_IMPL`'s else-branch; `op` its `(`):
# a generic instance shares its base's row (one record, one report); an async fn's `f$impl` has
# none (the row is on pass 1's `f`, whose constructor takes every parameter); an earlier
# definition of a redefined fn is D15's. Anything else that declares a default is refused (D17),
# a backstop: no call before it could be checked or filled. (Pass 1 records every other
# definition, a fn inside a top-level block included — `_prescan_block_fn`, 6.6.17.)
fn _pd_late(S, fi, op, isasync): i64 {
    if (_inst_name != 0) {
        var br = _pd_row(_inst_base_fi);
        if (br != 0) { SFPD(fi, br); }
        return 0;
    }
    if (isasync == 1) { return 0; }
    if ((GFLG(S, fi) & 2048) != 0) { return 0; }   # an earlier definition of a redefined fn: D15
    if (_pd_row(fi) != 0) { return 0; }
    if (TOKTYP(S, op) != 10) { return 0; }
    if (_pl_has_dflt(S, op) == 0) { return 0; }
    var eq = _pd_first_eq(S, op);
    if (_pd_eo(S, eq) == 0) { return 0; }
    PRSTR("fn ");
    _pd_q(S, _bx_fname(S, fi));
    PRSTR(" declares parameter defaults, but pass 1 did not record its definition (internal) - its calls could not be checked or filled");
    return _pd_ec(S, eq);
}
# Pass 2, the list just counted (`pc`): a row's max is pass 1's count, and the range check, the fill
# and the named placement all read it. Two counts that differ would check a call against one and
# fill it against the other, silently (pass 1 once stopped at a type token that is not a name:
# `a: u128`, `*fn`). A backstop: refused, loudly. A redefined fn's row is D15's. CHANGELOG [6.7.7]
fn _pd_pc_check(S, fi, pc): i64 {
    var row = _pd_row(fi);
    if (row == 0) { return 0; }
    if (L64(row) == pc) { return 0; }
    if ((GFLG(S, fi) & 2048) != 0) { return 0; }
    var op = L64(row + 16);
    if (_pd_eo(S, op) == 0) { return 0; }
    PRSTR("internal: fn ");
    _pd_q(S, _bx_fname(S, fi));
    PRSTR(" declares parameter defaults, and its two passes count its parameters apart (");
    PRNUM(L64(row));
    PRSTR(" and ");
    PRNUM(pc);
    PRSTR(") - its calls could not be checked or filled");
    return _pd_ec(S, op);
}

# ── the end of pass 1: the values ───────────────────────────────────────────────────────────
# Every recorded default evaluated and checked once, used or not, as every top-level const is
# (`_tl_pass1`, after `_cst_sweep`, in every fork).
fn _pd_sweep(S): i64 {
    if (_fnt_pdflt == 0) { return 0; }
    var n = GFNC(S);
    var fi = 0;
    while (fi < n) {
        var row = _pd_row(fi);
        if (row != 0) {
            var pi = L64(row + 32);
            while (pi < L64(row)) {
                _pd_value(S, fi, pi);
                pi = pi + 1;
            }
        }
        fi = fi + 1;
    }
    return 0;
}
# Parameter pi's default of fi, evaluated once (memoised): its row entry (kind at +24, value at
# +32, float-literal index at +40), or 0 when it is refused (reported once). A default reached
# while it is being evaluated is defined in terms of itself (D16).
fn _pd_value(S, fi, pi): i64 {
    var row = _pd_row(fi);
    if (row == 0) { return 0; }
    if ((L64(row + 24) & 1) != 0) { return 0; }
    var d0 = L64(row + 32);
    if (pi < d0) { return 0; }
    if (pi >= L64(row)) { return 0; }
    var en = row + 40 + (pi - d0) * 56;
    var st = L64(en + 16);
    if (st == 2) { return en; }
    if (st == 3) { return 0; }
    if (st == 1) {
        if (_pd_eo(S, L64(en) + 1) == 1) {
            PRSTR("the default of ");
            _pd_pof(S, L64(en + 48), fi);
            PRSTR(" is defined in terms of itself");
            _pd_ec(S, L64(en) + 1);
        }
        S64(en + 16, 3);
        _pd_refuse_row(row, 0);
        return 0;
    }
    S64(en + 16, 1);
    if (_pd_eval(S, fi, row, en) == 0) {
        S64(en + 16, 3);
        _pd_refuse_row(row, 0);
        return 0;
    }
    S64(en + 16, 2);
    return en;
}
# One default: D2 (it names a parameter of its own fn), the evaluator (D3, in its own words), D20
# (it does not end at its `,` / `)`), then the parameter's type (`_pd_kind_ok`). 1 = taken.
fn _pd_eval(S, fi, row, en): i64 {
    var eq = L64(en);
    var end = _pl_dflt_end(S, eq);
    if (_pd_param_ref(S, fi, row, eq, end) == 1) { return 0; }
    var o: i64[3];
    var sv = GTI(S);
    STI(S, eq + 1);
    var v = _ce_top_expr(S, eq + 1, &o);
    STI(S, sv);
    if (load64(&o + 8) != 0) { return 0; }   # the latch is `_ce_top_expr`'s (6.7.14)
    if (load64(&o + 16) != end) {
        _pd_say(S, load64(&o + 16), "a parameter default is one constant expression, ending at ',' or ')'");
        return 0;
    }
    if (_pd_kind_ok(S, fi, en, load64(&o), v) == 0) { return 0; }
    S64(en + 24, load64(&o));
    S64(en + 32, v);
    if (load64(&o) == 1) { S64(en + 40, FLIT_ADD(v)); }
    return 1;
}
# D2: a name in the default (`eq` .. `end`) naming a parameter or a type parameter of its own fn —
# refused before the evaluator could read a global of the same name. Not a field (`.x`), not a
# call (`x(`). 1 = refused.
fn _pd_param_ref(S, fi, row, eq, end): i64 {
    var i = eq + 1;
    while (i < end) {
        if (TOKTYP(S, i) == 2) { if (TOKTYP(S, i - 1) != 41) { if (TOKTYP(S, i + 1) != 10) {
                    var w = _pd_names_param(S, fi, row, TOKVAL(S, i));
                    if (w != 0) {
                        if (_pd_eo(S, i) == 1) {
                            PRSTR("a default must be a compile-time constant: ");
                            _pd_q(S, TOKVAL(S, i));
                            if (w == 2) { PRSTR(" is a type parameter of "); }
                            else { PRSTR(" is a parameter of "); }
                            _pd_q(S, _bx_fname(S, fi));
                            _pd_ec(S, i);
                        }
                        return 1;
                    }
                } } }
        i = i + 1;
    }
    return 0;
}
# 1 when `noff` names a parameter of the list in `row`, 2 a type parameter of fi, else 0.
fn _pd_names_param(S, fi, row, noff): i64 {
    var q = L64(row + 16) + 1;
    var n = GTCNT(S);
    while (q < n) {
        if (TOKTYP(S, q) == 2) { if (STREQ(S, TOKVAL(S, q), noff) == 1) { return 1; } }
        q = _pl_next(S, q);
        if (TOKTYP(S, q) != 31) { break; }
        q = q + 1;
    }
    if (_pd_is_tparam(S, fi, L64(row + 16), noff) == 1) { return 2; }
    return 0;
}
# 1 when `noff` is one of fi's type parameters, read from its definition's `<..>` (its name is
# token GFDS, the list's `(` is `op`; a bound's trait names are not parameters).
fn _pd_is_tparam(S, fi, op, noff): i64 {
    if (GFDS(S, fi) == 0) { return 0; }
    var q = GFDS(S, fi) + 1;
    if (TOKTYP(S, q) != 19) { return 0; }
    var d = 0;
    while (q < op) {
        var t = TOKTYP(S, q);
        if (t == 2) { if (d == 1) {
                var pt = TOKTYP(S, q - 1);
                if (pt == 19 || pt == 31) { if (STREQ(S, TOKVAL(S, q), noff) == 1) { return 1; } }
            } }
        d = _pl_tdepth(t, d);
        q = q + 1;
    }
    return 0;
}

# ── the parameter's type: the defaults it takes ───────────────────────────────────────────
# The default class of a parameter whose type token is `tt` (-1 untyped): 0 untyped, 1 bool, 2
# f64, 3 f32, 4 cstring, 5 a pointer (`*T`) or a Vec handle, 8 + w a signed / 24 + w an unsigned
# integer of w bytes (an enum is an i64). A type that takes no default is negative (`_pd_cname`
# names it); -12 is a name nothing resolves, which pass 2 refuses by name.
fn _pd_pclass(S, fi, tt, op): i64 {
    if (tt < 0) { return 0; }
    var t = TOKTYP(S, tt);
    if (t == 8) { return 5; }
    if (t == 105) { return 0 - 6; }
    if (t == 10) { return 0 - 8; }
    if (t != 2) { return 0 - 12; }
    var noff = TOKVAL(S, tt);
    if (_pd_is_tparam(S, fi, op, noff) == 1) { return 0 - 9; }
    var pc = _classify_param_type(S, noff);
    if (pc == 1) { return 0 - 1; }
    if (pc == 2) { return 4; }
    if (pc == 3) { return 0 - 2; }
    if (pc == 4) { return 0 - 3; }
    if (pc == 5) { return 0 - 4; }
    if (pc != 0) { return 0 - 5; }   # f64v2 / f64v4 / f32v4 / an integer vector
    return _pd_tclass(_tn_resolve(S, noff));
}
fn _pd_tclass(c): i64 {
    var k = _tn_class(c);
    var v = _tn_val(c);
    if (k == 1) { return 8 + v; }
    if (k == 2) { return 24 + v; }
    if (k == 3) { if (v == 4) { return 3; } return 2; }
    if (k == 4) {
        if (v == 1) { return 1; }
        if (v == 2) { return 16; }   # an enum: its values are i64
        if (v == 8) { return 5; }    # Vec: a handle
        if (v == 7) { return 0 - 9; }
        return 0 - 12;
    }
    if (k == 5) { return 0 - 5; }
    if (k == 6) { return 0 - 7; }
    return 0 - 12;
}
fn _pd_cname(c): i64 {
    if (c == 0 - 1) { PRSTR("a Str"); }
    elif (c == 0 - 2) { PRSTR("a Result"); }
    elif (c == 0 - 3) { PRSTR("an Option"); }
    elif (c == 0 - 4) { PRSTR("a Tagged"); }
    elif (c == 0 - 5) { PRSTR("a vector"); }
    elif (c == 0 - 6) { PRSTR("a 128-bit integer"); }
    elif (c == 0 - 7) { PRSTR("a struct"); }
    elif (c == 0 - 8) { PRSTR("a tuple"); }
    else { PRSTR("a type parameter"); }
    return 0;
}
# 1 when integer v fits class c (8 + w signed, 24 + w unsigned; 8 bytes take every value).
fn _pd_fits(c, v): i64 {
    if (c >= 24) {
        var uw = c - 24;
        if (uw >= 8) { return 1; }
        if (v < 0) { return 0; }
        if (v > (1 << (uw * 8)) - 1) { return 0; }
        return 1;
    }
    var w = c - 8;
    if (w >= 8) { return 1; }
    var hi = (1 << (w * 8 - 1)) - 1;
    if (v > hi) { return 0; }
    if (v < 0 - hi - 1) { return 0; }
    return 1;
}
# The default kinds (k: 0 i64, 1 f64, 2 string, 3 bool) a parameter's type takes — untyped: an
# integer, a bool or a string (its literal's address, as a positional); an integer type: an
# integer in its range or a bool; bool: a bool; f64 / f32: a float, or 0 / an IEEE bit pattern
# (`_ic_val_ok`, the `var x: f64 = n` rule); cstring: a string or 0; `*T`: an integer. 1 = taken.
fn _pd_kind_ok(S, fi, en, k, v): i64 {
    var c = _pd_pclass(S, fi, L64(en + 8), L64(_pd_row(fi) + 16));
    if (c == 0 - 12) { return _pd_type_refused(S, L64(en + 8)); }   # 6.7.11
    # A bare `u128` (class -6): `_pty_u128` refuses the TYPE by name (6.7.14's D10 (a)), the one error; its default
    # is kept unjudged, as `_pd_type_refused`'s. D9 here printed a second error first (CHANGELOG [6.7.15]).
    if (c == 0 - 6) { return 1; }
    if (c < 0) { return _pd_d9(S, fi, en, c); }
    if (c == 0) {
        if (k != 1) { return 1; }
        var ti = L64(en) + 1;
        if (_pd_eo(S, ti) == 1) {
            _pd_pof(S, L64(en + 48), fi);
            PRSTR(" is untyped: a float default needs it declared ': f64' (or ': f32')");
            _pd_ec(S, ti);
        }
        return 0;
    }
    if (c == 1) { if (k == 3) { return 1; } return _pd_d7(S, fi, en, "a bool"); }
    if (c == 2 || c == 3) {
        if (k == 1) { return 1; }
        if (k == 0) {
            if (_ic_val_ok(v) == 0) { return 1; }
            return _pd_d7(S, fi, en, 0);
        }
        return _pd_d7(S, fi, en, "a float");
    }
    if (c == 4) {
        if (k == 2) { return 1; }
        if (k == 0) { if (v == 0) { return 1; } }
        return _pd_d7(S, fi, en, "a string (or 0)");
    }
    if (c == 5) { if (k == 0) { return 1; } return _pd_d7(S, fi, en, "an integer"); }
    if (k == 0 || k == 3) {
        if (_pd_fits(c, v) == 1) { return 1; }
        return _pd_d8(S, fi, en, v);
    }
    return _pd_d7(S, fi, en, "an integer");
}
# A parameter type nothing resolves (class -12) at token `tt`: 1 when PARSE_FN_DEF refuses it by name
# (`_tn_param_check`: a slice, or a name no type, handle or type parameter answers) — its default is
# then kept unjudged, so the fn's calls are not each refused as well for the argument it fills (the
# type's refusal stops the build). 0 keeps it dropped, as before, for any other token. CHANGELOG [6.7.11]
fn _pd_type_refused(S, tt): i64 {
    if (_sl_ann_at(S, tt) == 1) { return 1; }
    if (TOKTYP(S, tt) != 2) { return _pd_tok_refused(S, tt); }   # 6.7.12
    if (_classify_param_type(S, TOKVAL(S, tt)) != 0) { return 0; }
    if (_tn_resolve_at(S, tt) != 0) { return 0; }
    return 1;
}
# ⛔ 6.7.12 — and any other token the parameter-type reader refuses by name (`a: 5`, `a: fn`, `a: "s"`, 6.7.11's
# ARG-3): the reader itself, quiet (`_pty_end`, `loud` 0, records `_pty_bad`), so the two cannot disagree. Its
# default was dropped, so `fn f(a: 5 = 0)` + `f()` reported "'f' expects 1 argument, got 0" after the type's
# own refusal. Issue 2026-10-14-refused-parameter-type-default-cascades-arity-error. CHANGELOG [6.7.12]
fn _pd_tok_refused(S, tt): i64 {
    var b = _pty_bad;
    _pty_bad = 0;
    _pty_end(S, tt, 0, 0);
    var r = _pty_bad;
    _pty_bad = b;
    return r;
}
# The type at token tt, as written (`*T`, a name, u128).
fn _pd_tname(S, tt): i64 {
    if (TOKTYP(S, tt) == 8) { PRSTR("*"); tt = tt + 1; }
    if (TOKTYP(S, tt) == 105) { PRSTR("u128"); return 0; }
    if (TOKTYP(S, tt) == 2) { PRSTR(S + 0xEC00000 + TOKVAL(S, tt)); }
    return 0;
}
# D7 "parameter 'b' of 'f' is ': bool': its default must be a bool" (`want` 0: D6, an integer
# default on f64 / f32 — its bits, a subnormal). Returns 0.
fn _pd_d7(S, fi, en, want): i64 {
    var ti = L64(en) + 1;
    if (_pd_eo(S, ti) == 0) { return 0; }
    _pd_pof(S, L64(en + 48), fi);
    PRSTR(" is ': ");
    _pd_tname(S, L64(en + 8));
    if (want == 0) { PRSTR("': an integer default is its bit pattern - write 1.0"); }
    else {
        PRSTR("': its default must be ");
        PRSTR(want);
    }
    _pd_ec(S, ti);
    return 0;
}
# D8 "the default 300 does not fit parameter 'x' of 'f' (': u8')". Returns 0.
fn _pd_d8(S, fi, en, v): i64 {
    var ti = L64(en) + 1;
    if (_pd_eo(S, ti) == 0) { return 0; }
    PRSTR("the default ");
    PRNUM(v);
    PRSTR(" does not fit ");
    _pd_pof(S, L64(en + 48), fi);
    PRSTR(" (': ");
    _pd_tname(S, L64(en + 8));
    PRSTR("')");
    _pd_ec(S, ti);
    return 0;
}
# D9 "parameter 'p' of 'f' is a struct: it takes no default". Returns 0.
fn _pd_d9(S, fi, en, c): i64 {
    var ti = L64(en) + 1;
    if (_pd_eo(S, ti) == 0) { return 0; }
    _pd_pof(S, L64(en + 48), fi);
    PRSTR(" is ");
    _pd_cname(c);
    PRSTR(": it takes no default");
    _pd_ec(S, ti);
    return 0;
}

# ── the call site: min..max, and a short call's defaults ──────────────────────────────────────
# A call is checked against min..max (`_CHECK_ARITY`). A direct call short of max takes the
# missing trailing parameters' defaults, pushed after its written arguments in parameter order —
# each emitted exactly as its literal would be (`_cst_emit_val`; into an f32 parameter it rounds,
# as every f32 write does since 6.7.6) — so ECALLPOPS sees one int-class word per parameter on
# every target. A default is never a vector, a struct or a Str (`_pd_kind_ok`), so the vector
# second pass and the address pushes are untouched. Only the one marshaller fills
# (`_owncall_args_at`: PARSE_FNCALL, the method form, the struct-valued receives, the PE
# vector-retptr calls); the tail arm never sees such a call (`_tc_args_divert`, with
# `_CHECK_ARITY` mode 3 as the backstop) and an operator passes exactly two operands (D19).
# A const context fills from the same values (`_ce_fill`). CHANGELOG [6.7.7]
# min: the first defaulted parameter's index (max with no row, or a refused one).
fn _pd_min(fi): i64 {
    var row = _pd_row(fi);
    if (row != 0) { return L64(row + 8); }
    return L64(_fnt_params + fi * 8);
}
# After a direct call's written arguments (`p` of them, `self` counted; `st` the marshaller's
# state): the defaults of parameters p .. max - 1, when p is in range. The expression type is
# reset after a push: `_cst_emit_val` leaves an f64 default's, and the method form has no reset of
# its own (`p.m() * 2` with `d: f64 = 1.5` read the call's result as an f64).
fn _pd_fill(S, fi, p, st): i64 {
    var row = _pd_row(fi);
    if (row == 0) { return 0; }
    if (p < L64(row + 8)) { return 0; }   # short of the required ones: the arity error
    var max = L64(row);
    if (p >= max) { return 0; }
    while (p < max) {
        _pd_push_default(S, fi, p, st);
        p = p + 1;
    }
    SESTYPE(S, 0);
    return 0;
}
fn _pd_push_default(S, fi, pi, st): i64 {
    var en = _pd_value(S, fi, pi);
    if (en == 0) { EMOVI(S, 0); }   # refused, and reported at the default: the count stays right
    else {
        _cst_emit_val(S, L64(en + 24), L64(en + 32), L64(en + 40));
        if (L64(en + 24) == 1) { if (_pbool_get(fi, pi) == 3) { _f32_init_round(S, F32_TYID); } }
    }
    EPUSHR(S);
    store64(st, load64(st) + 1);
    return 0;
}
# 1 when the call whose `(` is token `open` fills a default or names an argument: the call the
# tail arm must not take (`_tc_args_divert`). Its written arguments are counted by `_arg_next`,
# which steps over a closure's `|a, b|` bars — counted as two arguments, `return ap(|a, b| ..)`
# to `fn ap(c, n = 5)` would look full and jump with `n` unset.
fn _pd_call_fills(S, fi, open): i64 {
    if (_pd_named_at(S, open) == 1) { return 1; }
    var row = _pd_row(fi);
    if (row == 0) { return 0; }
    var n = 0;
    var q = open + 1;
    if (TOKTYP(S, q) != 11) {
        var go = 1;
        while (go == 1) {
            n = n + 1;
            q = _arg_next(S, q);
            if (TOKTYP(S, q) == 31) { q = q + 1; } else { go = 0; }
        }
    }
    if (n < L64(row)) { return 1; }
    return 0;
}
# `_CHECK_ARITY` for a callee that declares defaults, modes 3 and 4 (1 = reported). Mode 3, the
# tail arm, short of max but in range: `_tc_args_divert` missed a call that fills — an internal
# error, never a `jmp` with a parameter unset. Mode 4, an operator dispatch: D19 (`_pd_d19`).
fn _pd_arity_mode(S, line, noff, fi, argc, mode): i64 {
    if (mode == 4) { return _pd_d19(S, noff, fi); }
    if (mode != 3) { return 0; }
    if (argc < _pd_min(fi)) { return 0; }
    if (argc >= L64(_fnt_params + fi * 8)) { return 0; }
    return _pd_line_err(S, line, "internal: tail call to ", noff, " reached the tail arm short of its defaults");
}
# D19, an operator dispatch reaching a fn that declares a default: reported ONCE, at the fn's first
# default (the mistake's place, with its column) — it was one line per use, at the use, and again
# after the definition's own refusal. A row refused already (a method of `impl Trait for T`, D13,
# or any shape refusal) says nothing more. Always 1: the dispatch's count is not judged.
# CHANGELOG [6.7.11]
fn _pd_d19(S, noff, fi): i64 {
    var row = _pd_row(fi);
    if ((L64(row + 24) & 4) != 0) { return 1; }
    var ft = _pd_first_eq(S, L64(row + 16));
    if (ft < 0) { ft = L64(row + 16); }
    if (_pd_eo(S, ft) == 0) { return 1; }
    PRSTR("operator fn ");
    _pd_q(S, noff);
    PRSTR(" declares a parameter default: an operator passes exactly its two operands");
    _pd_ec(S, ft);
    return 1;
}
# "error:<file>:<line>: <a>'<name>'<b>", the arity check's form. Returns 1.
fn _pd_line_err(S, line, a, noff, b): i64 {
    syscall(SYS_WRITE, 2, "error:", 6);
    FM_LOOKUP(S, line);
    PRSTR(": ");
    PRSTR(a);
    _pd_q(S, noff);
    PRSTR(b);
    syscall(SYS_WRITE, 2, "\n", 1);
    _had_error = 1;
    return 1;
}
# C15 (`_PINDIRECT_CALL_IN`, after `)`): `fncallN(&f, ..)` / `callptr(&f, ..)` passing fewer than
# f's parameters when f declares defaults. A call through a fn pointer passes every argument — the
# callee cannot know it was called short. Reported at the `&` (token `ti`).
fn _pd_icall_short(S, cfi, argc, ti): i64 {
    var row = _pd_row(cfi);
    if (row == 0) { return 0; }
    if (argc >= L64(row)) { return 0; }
    if (_pd_eo(S, ti) == 0) { return 0; }
    PRSTR("a call through a fn pointer passes every argument: ");
    _pd_q(S, _fn_src_name(S, cfi, _bx_fname(S, cfi)));
    PRSTR(" takes ");
    PRNUM(L64(row));
    PRSTR(" (defaults fill only direct calls)");
    return _pd_ec(S, ti);
}
# A const fn call (`_ce_call`, `n` arguments on the frame stack) short of its parameters: the
# defaults pushed after them, as the callee's parameters bind them (the values the end of pass 1
# computes — or computes now, for a const context forced earlier in pass 1). The count it leaves;
# a call short of the required ones stays short (`_ce_bind_params` refuses it).
fn _ce_fill(S, fi, n): i64 {
    var row = _pd_row(fi);
    if (row == 0) { return n; }
    if (n < L64(row + 8)) { return n; }
    while (n < L64(row)) {
        var en = _pd_value(S, fi, n);
        if (en == 0) { _ce_err = 1; return n; }   # refused, and reported at the default
        _ce_fr_push(S, 0 - 1, L64(en + 32), L64(en + 24), 8);
        n = n + 1;
    }
    return n;
}

# ── the call site: named arguments ──────────────────────────────────────────────────────────
# `f(1, c: 3)`: the positionals first, then `name: value` in any order, each parameter at most
# once (user, 2026-10-08). WRITTEN order is evaluation order; PARAMETER order is placement. The
# one marshaller (`_owncall_args_at`) runs the positionals and hands the cursor, on the first
# label, to `_pd_named`, which checks the whole call before it emits anything (`_pd_nscan`,
# cursor-free) and then marshals it one of two ways:
#   * IN ORDER (each name after the one before it — the common `f(1, c: 3)`): every argument where
#     it stands, a gap's defaults pushed before it (constants: no side effect, so written order
#     holds). No temporaries.
#   * REORDERED: each argument evaluated as written through its parameter's gates
#     (`_call_arg_one`), its int-class word popped into a hidden temporary (`_HTEMP`: a frame slot
#     in a fn, a dead global at top level), then every parameter pushed in parameter order — its
#     temporary, or its default. A vector is recorded at its parameter-order XMM / V ordinal
#     (`_simd_ord_at`), never pushed.
# Either way ECALLPOPS sees one int-class word per parameter, in parameter order, on every target
# (SysV 6 / Win64 4 / aarch64 8 registers, then the stack; cx). Direct calls only: fncallN /
# callptr refuse a label (C7), a builtin's undefined-name error gets a note (C14), a call that
# names an argument is never overload-routed (C10) nor inlined, and a const context binds names
# the same way (`_ce_call_named`). CHANGELOG [6.7.7]
# The marshaller's state for the named phase: st[24] the first user parameter (p0), st[32] the
# arity line, st[40] 1 = reordered, st[48] the per-call table (alloc'd, 24 B per parameter: the
# value's first token or 0 = not named, 1 = spilled, its temporary).

# The ordinal of fi's parameter named `noff`, or -1 — read from the definition's tokens.
fn _pd_index(S, fi, noff): i64 {
    var max = L64(_fnt_params + fi * 8);
    var k = 0;
    while (k < max) {
        var pn = _bx_pname(S, fi, k);
        if (pn < 0) { return 0 - 1; }
        if (STREQ(S, pn, noff) == 1) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}
# The XMM / V ordinal of fi's vector parameter pi: the widths of the vector parameters before it (a
# 32-byte vector takes two), exactly as a positional call's running ordinal reaches it.
fn _simd_ord_at(fi, pi): i64 {
    var o = 0;
    var j = 0;
    while (j < pi) {
        var c = _pm_simd(fi, j);
        if (c == 2) { o = o + 2; }
        elif (c > 0) { o = o + 1; }
        j = j + 1;
    }
    return o;
}
# The first label of the call whose argument list starts at token q (a label is always there).
fn _pd_first_label(S, q): i64 {
    var n = GTCNT(S);
    while (q < n) {
        if (_pd_label_at(S, q) == 1) { return q; }
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return q; }
        q = q + 1;
    }
    return q;
}
# The named phase (cursor on the call's first label; `p` the positionals written before it, `self`
# counted). Consumes through `)`; the marshaller pops st[0] words.
fn _pd_named(S, fi, noff, p, tbl, st): i64 {
    var c = _pd_ncallee(S, fi, noff, GTI(S));
    if (c == 2) { return _pd_ninplace(S, fi, noff, p, tbl, st); }
    if (c == 0) { c = _pd_nscan(S, fi, noff, p, st); }
    if (c != 0) { return _pd_nskip(S); }
    if (load64(st + 40) == 0) { _pd_ninorder(S, fi, noff, p, tbl, st); }
    else { _pd_nreorder(S, fi, noff, p, tbl, st); }
    SESTYPE(S, 0);   # the last argument's type is not the call's (an f64 one leaked into `p.m(..) * 2`)
    return 0;
}
# The callee's refusals (at the first label `lb`): C9 no declared parameter list (a variant
# constructor; an unresolved callee — under --syntax-only a sibling file's fn, which is no error
# there: 2, the arguments pushed in place), C11 a variadic fn, C12 a fn defined twice. 1 = refused.
fn _pd_ncallee(S, fi, noff, lb): i64 {
    if (_gen_def_open(S, fi) < 0) {
        if (_syntax_only == 1) { return 2; }
        if (_pd_eo(S, lb) == 1) {
            _pd_q(S, _fn_src_name(S, fi, noff));
            PRSTR(" takes no named arguments: it has no declared parameter list");
            _pd_ec(S, lb);
        }
        return 1;
    }
    if (GFVA(S, fi) != 0) {
        if (_pd_eo(S, lb) == 1) {
            _pd_q(S, _fn_src_name(S, fi, noff));
            PRSTR(" is variadic: its arguments are positional");
            _pd_ec(S, lb);
        }
        return 1;
    }
    if ((GFLG(S, fi) & 2048) != 0) {
        if (_pd_eo(S, lb) == 1) {
            _pd_q(S, _fn_src_name(S, fi, noff));
            PRSTR(" is defined twice: name its arguments only on a fn defined once");
            _pd_ec(S, lb);
        }
        return 1;
    }
    return 0;
}
# The whole call, checked before anything is emitted (cursor-free, from the first label at the
# cursor): C1 more positionals than parameters, C5 a positional after a named one, C2 an unknown
# name, C8 `self:` in the dot form, C4 a parameter given by position and by name, C3 one named
# twice, C6 a required one missing, C13 a reordered call in a `#naked` fn. Records each named
# parameter's value token (st[48]) and whether the call is reordered (st[40]). 1 = refused, once.
fn _pd_nscan(S, fi, noff, p, st): i64 {
    var max = L64(_fnt_params + fi * 8);
    var lb = GTI(S);
    if (p > max) {
        _check_arity_p0(S, load64(st + 32), noff, fi, p + _pd_nargs(S, lb), 1, load64(st + 24));
        return 1;
    }
    var tb = alloc(max * 24 + 24);
    store64(st + 48, tb);
    store64(st + 40, 0);
    var q = lb;
    var last = 0 - 1;
    var n = GTCNT(S);
    while (q < n) {
        if (_pd_label_at(S, q) == 0) { return _pd_c5(S, q, _fn_src_name(S, fi, noff)); }
        var pi = _pd_index(S, fi, TOKVAL(S, q));
        if (pi < 0) { return _pd_c2(S, q, fi, noff, load64(st + 24)); }
        if (pi < p) { return _pd_c4(S, q, fi, noff, pi, load64(st + 24)); }
        if (load64(tb + pi * 24) != 0) { return _pd_c3(S, q, fi); }
        store64(tb + pi * 24, q + 2);
        if (pi < last) { store64(st + 40, 1); }
        last = pi;
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { break; }
        q = q + 1;
    }
    var mn = _pd_min(fi);
    var k = p;
    while (k < mn) {
        if (load64(tb + k * 24) == 0) { return _pd_c6(S, q, fi, k); }
        k = k + 1;
    }
    if (load64(st + 40) == 1) { if (_cur_fn_naked == 1) {
            if (_pd_eo(S, lb) == 1) {
                PRSTR("a reordered named call needs a frame: not inside #naked fn ");
                _pd_q(S, _bx_fname(S, _cur_fn_ix));
                _pd_ec(S, lb);
            }
            return 1;
        } }
    return 0;
}
# The arguments from token q to the call's `)` (a closure's `|a, b|` bars hold no separator).
fn _pd_nargs(S, q): i64 {
    var c = 0;
    var n = GTCNT(S);
    while (q < n) {
        c = c + 1;
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return c; }
        q = q + 1;
    }
    return c;
}
# C2 "'f' has no parameter named 'c' - its parameters are: a, b" (from p0: not the dot form's
# `self`). Returns 1.
fn _pd_c2(S, q, fi, noff, p0): i64 {
    if (_pd_eo(S, q) == 0) { return 1; }
    _pd_q(S, _fn_src_name(S, fi, noff));
    PRSTR(" has no parameter named ");
    _pd_q(S, TOKVAL(S, q));
    var max = L64(_fnt_params + fi * 8);
    if (p0 >= max) { PRSTR(" - it takes no other arguments"); }
    else {
        PRSTR(" - its parameters are: ");
        var k = p0;
        while (k < max) {
            if (k > p0) { PRSTR(", "); }
            var pn = _bx_pname(S, fi, k);
            if (pn >= 0) { PRSTR(S + 0xEC00000 + pn); }
            k = k + 1;
        }
    }
    _pd_ec(S, q);
    return 1;
}
# C3 a parameter named twice. Returns 1.
fn _pd_c3(S, q, fi): i64 {
    if (_pd_eo(S, q) == 0) { return 1; }
    _pd_pofc(S, TOKVAL(S, q), fi);
    PRSTR(" is named twice");
    _pd_ec(S, q);
    return 1;
}
# C5 a positional argument (at token q) after a named one. Returns 1.
fn _pd_c5(S, q, noff): i64 {
    if (_pd_eo(S, q) == 0) { return 1; }
    PRSTR("a positional argument cannot follow a named one (in a call to ");
    _pd_q(S, noff);
    PRSTR(")");
    _pd_ec(S, q);
    return 1;
}
# C6 required parameter k not given (reported at token q, the call's `)`). Returns 1.
fn _pd_c6(S, q, fi, k): i64 {
    if (_pd_eo(S, q) == 0) { return 1; }
    PRSTR("missing argument for ");
    _pd_pofc(S, _bx_pname(S, fi, k), fi);
    PRSTR(" (it has no default)");
    _pd_ec(S, q);
    return 1;
}
# C4 a parameter given by position and by name; C8 `self:` in the dot form (`self` is parameter 0,
# the receiver). Returns 1.
fn _pd_c4(S, q, fi, noff, pi, p0): i64 {
    if (_pd_eo(S, q) == 0) { return 1; }
    if (pi == 0) { if (p0 == 1) {
            PRSTR("'self' is the receiver of a method call (o.m(..)) - it cannot be named");
            _pd_ec(S, q);
            return 1;
        } }
    _pd_pofc(S, TOKVAL(S, q), fi);
    PRSTR(" is given by position and by name");
    _pd_ec(S, q);
    return 1;
}
# One named argument for parameter pi (cursor on its value): a vector's register is its
# parameter-order ordinal; then the parameter's gates.
fn _pd_arg_at(S, fi, pi, noff, tbl, st): i64 {
    if (_pm_simd(fi, pi) > 0) { store64(st + 16, _simd_ord_at(fi, pi)); }
    return _call_arg_one(S, fi, pi, noff, tbl, st);
}
# Parameters k .. e - 1, each a default (`_pd_nscan` checked), pushed in parameter order.
fn _pd_fill_to(S, fi, k, e, st): i64 {
    while (k < e) {
        _pd_push_default(S, fi, k, st);
        k = k + 1;
    }
    return 0;
}
fn _pd_close(S): i64 {
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    return 0;
}
# In order: each argument where it stands, a gap's defaults before it, the trailing ones after.
# (A cursor that is not on a label here was left by an argument's own parse error, reported.)
fn _pd_ninorder(S, fi, noff, p, tbl, st): i64 {
    var next = p;
    var go = 1;
    while (go == 1) {
        var pi = 0 - 1;
        if (_pd_label_at(S, GTI(S)) == 1) { pi = _pd_index(S, fi, PEEKV(S)); }
        if (pi < 0) { go = 0; }
        else {
            _pd_fill_to(S, fi, next, pi, st);
            STI(S, GTI(S) + 2);   # the label and its `:`
            _pd_arg_at(S, fi, pi, noff, tbl, st);
            next = pi + 1;
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); } else { go = 0; }
        }
    }
    _pd_close(S);
    _pd_fill_to(S, fi, next, L64(_fnt_params + fi * 8), st);
    return 0;
}
# Reordered: each argument evaluated as written into a hidden temporary, then every parameter from
# p pushed in parameter order (a vector was recorded at its own ordinal: nothing to push).
fn _pd_nreorder(S, fi, noff, p, tbl, st): i64 {
    var tb = load64(st + 48);
    var go = 1;
    while (go == 1) {
        var pi = 0 - 1;
        if (_pd_label_at(S, GTI(S)) == 1) { pi = _pd_index(S, fi, PEEKV(S)); }
        if (pi < 0) { go = 0; }
        else {
            STI(S, GTI(S) + 2);
            var n0 = load64(st);
            _pd_arg_at(S, fi, pi, noff, tbl, st);
            if (load64(st) > n0) {
                EPOPR(S);
                var h = _HTEMP(S);
                _HTSTORE(S, h);
                store64(st, n0);
                store64(tb + pi * 24 + 8, 1);
                store64(tb + pi * 24 + 16, h);
            }
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); } else { go = 0; }
        }
    }
    _pd_close(S);
    var max = L64(_fnt_params + fi * 8);
    var k = p;
    while (k < max) {
        if (load64(tb + k * 24 + 8) == 1) {
            _HTLOAD(S, load64(tb + k * 24 + 16));
            EPUSHR(S);
            store64(st, load64(st) + 1);
        } elif (load64(tb + k * 24) == 0) { _pd_push_default(S, fi, k, st); }
        k = k + 1;
    }
    return 0;
}
# A refused call: the rest of its arguments parsed, nothing pushed, so the stream stays in step
# (`_had_error` withholds the binary).
fn _pd_nskip(S): i64 {
    var go = 1;
    while (go == 1) {
        if (_pd_label_at(S, GTI(S)) == 1) { STI(S, GTI(S) + 2); }
        PCMPE(S);
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); } else { go = 0; }
    }
    return _pd_close(S);
}
# --syntax-only, a callee with no declared list (a sibling file's fn): each `name: value` pushed
# where it stands, as a positional would be — only the grammar is judged (C5).
fn _pd_ninplace(S, fi, noff, p, tbl, st): i64 {
    var go = 1;
    while (go == 1) {
        if (_pd_label_at(S, GTI(S)) == 1) { STI(S, GTI(S) + 2); }
        else { _pd_c5(S, GTI(S), noff); }
        _call_arg_one(S, fi, p, noff, tbl, st);
        p = p + 1;
        if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); } else { go = 0; }
    }
    return _pd_close(S);
}
# C10 (`_fnc_route`, cursor on the first argument of a call that names one): such a call is never
# overload-routed — and it is refused when the positional call could be (the base has a `_str` /
# `_int` sibling, or its `&x` first argument a `<base>_ptr` one), so it never silently reaches a
# different fn than the same arguments written by position. Returns -1 (not routed).
fn _pd_route_named(S, fi, noff): i64 {
    var hit = 0;
    if (L64(_fnt_ovstr + fi * 8) > 0) { hit = 1; }
    if (L64(_fnt_ovint + fi * 8) > 0) { hit = 1; }
    if (PEEKT(S) == 27) { if (_fnc_ptr_sib(S, noff) >= 0) { hit = 1; } }
    if (hit == 0) { return 0 - 1; }
    var lb = _pd_first_label(S, GTI(S));
    if (_pd_eo(S, lb) == 1) {
        PRSTR("a call with named arguments cannot be overload-routed: ");
        _pd_q(S, _fn_src_name(S, fi, noff));
        PRSTR(" has a routed sibling - call the one you mean");
        _pd_ec(S, lb);
    }
    return 0 - 1;
}
# C7 (`_PINDIRECT_CALL_IN`, cursor on a label; `cst` the call's first argument): fncallN / callptr
# pass every argument by position. Reported once per call (at its first label); the label is
# stepped over and its value parsed, so the stream stays in step.
fn _pd_icall_named(S, cst): i64 {
    _pd_say(S, _pd_first_label(S, cst), "named arguments need a direct call - fncallN / callptr pass arguments by position");
    STI(S, GTI(S) + 2);
    return 0;
}
# C14 (every undefined-name report, `_gv_note_blockscoped`; cursor just past the name): a name
# followed by `:` at an argument's start is a named argument to something that takes none — a
# builtin, an intrinsic. The two errors stay; this says why.
fn _pd_c14_note(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti) != 49) { return 0; }
    if (TOKTYP(S, ti - 1) != 2) { return 0; }
    var pt = TOKTYP(S, ti - 2);
    if (pt != 10 && pt != 31) { return 0; }
    PRSTR("note: named arguments go only to a direct call of a declared fn (builtins, fncallN and callptr take positional arguments)\n");
    return 0;
}
# The first token of the argument a call to fi (`(` at `open`) passes parameter k — for the
# generic inference that reads an argument before the call is parsed (`_gen_infer_tp`,
# `_gs_arg_named`, `_tok_gen_ret_sid`). A call with no label keeps the positional rule
# (`_call_arg_start`); with one, a positional before the first label, else the value after the
# label naming parameter k, else -1. So `g(n: 2, x: p)` instantiates `g$Pt` as `g(p, 2)` does.
fn _call_arg_for(S, fi, open, k): i64 {
    return _call_arg_pk(S, fi, open, k, k);
}
# ... where `pk` is the POSITION that passes parameter k: k on a free call, k - 1 on a method call,
# whose `self` (parameter 0) is the receiver and not in the list (`_mcall_infer`, 6.7.9).
fn _call_arg_pk(S, fi, open, k, pk): i64 {
    if (_pd_named_at(S, open) == 0) { return _call_arg_start(S, open, pk); }
    var q = open + 1;
    var pc = 0;
    var n = GTCNT(S);
    while (q < n) {
        if (_pd_label_at(S, q) == 1) { break; }
        if (pc == pk) { return _call_arg_start(S, open, pk); }
        pc = pc + 1;
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0 - 1; }
        q = q + 1;
    }
    if (fi < 0) { return 0 - 1; }
    var pn = _bx_pname(S, fi, k);
    if (pn < 0) { return 0 - 1; }
    while (q < n) {
        if (_pd_label_at(S, q) == 1) { if (STREQ(S, TOKVAL(S, q), pn) == 1) { return q + 2; } }
        q = _arg_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0 - 1; }
        q = q + 1;
    }
    return 0 - 1;
}

# 1 when the name at offset `noff` is exactly the `n`-byte text `lit`. (cycc does not include
# lib/string.cyr, so this is the compare.)
fn _noff_is(S, noff, lit, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(S + 0xEC00000 + noff + i) != load8(lit + i)) { return 0; }
        i = i + 1;
    }
    if (load8(S + 0xEC00000 + noff + n) != 0) { return 0; }
    return 1;
}

# `var g = f(..);` at registration: f's name offset + 1 for the DIAGNOSTIC table (GVDSID), when
# the declaration is untyped and its initializer is exactly one call; else 0. Always written, so
# a redeclaration folded onto the slot clears a stale record. f's return is resolved when the
# check runs, so an f defined after g counts too.
fn _gv_diag_sid(S, gvi, sti, typed): i64 {
    var cn = 0;
    if (typed == 0) { cn = _gv_init_call_sid(S, sti); }
    SVDSID(S, gvi, cn);
    return 0;
}
fn _gv_init_call_sid(S, sti): i64 {
    if (TOKTYP(S, sti + 2) != 4) { return 0; }
    var cn = _gv_rhs_call_sid(S, sti + 3);
    return cn;
}
# The same record from the initializer's first token `ri`: `f(..);` gives f's name offset + 1,
# anything else 0. PARSE_VAR's global arm (a `var` after the first top-level statement, which
# never reaches PARSE_GVAR_REG) writes it from here.
fn _gv_rhs_call_sid(S, ri): i64 {
    if (TOKTYP(S, ri) != 2) { return 0; }
    if (TOKTYP(S, ri + 1) != 10) { return 0; }
    var e = _tok_close_paren(S, ri + 1);
    if (e < 0) { return 0; }
    if (TOKTYP(S, e + 1) != 5) { return 0; }
    return TOKVAL(S, ri) + 1;
}

# The struct id a NAMED value carries, 0 when untyped. Shared by the I11 Str -> `: cstring`
# warning, the overload dispatcher (both through `_str_arg_kind`) and `_recv_sid`. A local decides
# by itself (`0 - GLTYPE`; an untyped local shadowing a `Str` global is 0, not the global's
# type). A global: its positive GVTYPE, but only when GVPM marks it a struct — GVTYPE's positive
# range is shared with scalar widths, so an `i32` global's 4 must not read as struct id 4. Else
# an inferred global's initializer return (GVDSID: READ here, never written into GVTYPE, which
# would change codegen). Comparing a global against the LOCAL encoding `0 - sid` — what the I11
# check did before 6.6.13 and the dispatcher before 6.6.16 — matches no Str global at all.
fn _diag_name_sid(S, noff): i64 {
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, noff);
        if (li >= 0) {
            var lt = GLTYPE(S, li);
            if (lt < 0) { if (lt > 0 - 2048) { return 0 - lt; } }
            return 0;
        }
    }
    var g = _glob_name_sid(S, noff);
    return g;
}
# `_diag_name_sid`'s global half, alone: the pair scans (`_tok_name_sid`) type a global receiver
# exactly as `_recv_sid` does, with no local table to consult. CHANGELOG [6.6.16]
fn _glob_name_sid(S, noff): i64 {
    var vi = _findvar_core(S, noff);
    if (vi < 0) { return 0; }
    var gt = GVTYPE(S, vi);
    if (gt > 0) { if (GVPM(S, vi) != 0) { return gt; } }
    var cn = GVDSID(S, vi);
    if (cn <= 0) { return 0; }
    var cfi = FINDFN(S, cn - 1);
    if (cfi < 0) { return 0; }
    var r = GFRS(S, cfi);
    if (r < 0) { r = 0; }
    return r;
}

# The struct id of a single NAME read as a value, in PARSE_FACTOR's order: a local decides by
# itself, then — inside a capturing closure — a captured enclosing local decides by the type its
# snapshot recorded, then a global (`_diag_name_sid`). The overload dispatcher routes on this, so
# a cstr local, param or CAPTURE named like a Str global must read 0 here: measured on the planning
# prototype, `var s = "x"; var c = |k| show(s) ..;` beside a `var s: Str` global reached `show_str`,
# which read the cstr's bytes as a {data, len} header. CHANGELOG [6.6.16]
fn _arg_name_sid(S, noff): i64 {
    if (GINFN(S) == 1) {
        if (FINDLOCAL(S, noff) < 0) {
            var esl = _cl_cap_esl(S, noff);
            if (esl >= 0) {
                var t = _cl_snap_type(esl);
                if (t < 0) { if (t > 0 - 2048) { return 0 - t; } }
                return 0;
            }
        }
    }
    var r = _diag_name_sid(S, noff);
    return r;
}
# The enclosing slot a name reads inside a capturing closure body (PARSE_FACTOR's capture rung),
# or -1 when the name is not a capture there.
fn _cl_cap_esl(S, noff): i64 {
    if (_cl_capturing != 1) { return 0 - 1; }
    if (_cl_env_lidx < 0) { return 0 - 1; }
    var esl = _cl_snap_find(S, noff);
    if (esl < 0) { return 0 - 1; }
    if (_cl_cap_find(esl) < 0) { return 0 - 1; }
    return esl;
}

var _sca_shape = 0;   # how the argument's head is written: 0 `x`, 1 `f(..)`, 2 `g<..>(..)`
var _sca_di = 0;      # the `.` of the LAST `.f` / `.m(..)` step after the head, 0 when none
var _sca_d0 = 0;      # the `.` of the FIRST step (6.6.17: nested fields `a.b.name` are several)
# What the hint wraps in str_cstr(..): 0 `..`, 1 the head as written (`x.data` -> x), 2 the
# argument as written, 3 the IDENT inside `str_data(x)`.
var _sca_op = 0;
# What the argument at the cursor hands a `: cstring` param: 1 a Str, 2 a Str's data pointer
# (`x.data`, `x.data()`, `str_data(..)`), 0 not known. Only a head (`x`, `f(..)`, `g<..>(..)`,
# a generic `: T` by T's binding) followed by nested STRUCT fields and then at most one `.f` /
# `.m(..)` step, together ENDING the argument, is typed (6.6.17: `a.b.name`): `x.m().n()`,
# a step into a Str field, `s + 8` and `load64(p)` are 0.
# A pure peek (it writes only `_sca_shape` / `_sca_di` / `_sca_d0` / `_sca_op`, which the warning recomputes),
# and it does not depend on CYRIUS_TYPE_CHECK: PARSE_FNCALL's overload dispatcher routes
# `base(x, ..)` to `base_str` exactly when this answers 1 for the FIRST argument, so a first
# argument the warning would call "Str-typed" never reaches a base that has an arity-compatible
# `_str` sibling — the call is routed instead. Each piece is typed the way codegen reads it: `x`
# as PARSE_FACTOR does (`_arg_name_sid`), a call by its callee's declared return, the receiver of
# `x.f` / `x.m(..)` as PARSE_FIELD_LOAD does (`_recv_sid`), a method by `<Struct>_<m>`'s return.
# A call RESULT is typed by its declared return, never by its receiver or its head: the first
# 6.6.16 cut dropped the method shape, so `println(s.cat(t))` — routed before by `s`'s type,
# which is right only by luck (`s.len()` went to `_str` the same way) — printed pointer bytes.
# CHANGELOG [6.6.16]
fn _str_arg_kind(S, ssid): i64 {
    var ti = GTI(S);
    _sca_shape = 0;
    _sca_di = 0;
    _sca_d0 = 0;
    if (TOKTYP(S, ti) != 2) { return 0; }
    if (_tok_ends_arg(S, ti + 1) == 1) {
        _sca_op = 2;
        if (_arg_name_sid(S, TOKVAL(S, ti)) == ssid) { return 1; }
        return 0;
    }
    var o = _gcall_open(S, ti);
    if (o >= 0) {
        var r = _str_call_kind(S, ti, o, ssid);
        return r;
    }
    if (TOKTYP(S, ti + 1) != 41) { return 0; }
    var bsid = _recv_sid(S, TOKVAL(S, ti));
    var k = _str_step_kind(S, ti + 1, bsid, ssid);
    return k;
}
# `f(..)` / `g<..>(..)` at token `ti`, its `(` at `o`: a Str when the callee is declared `: Str`
# (for a generic, its template's declared return: a `: T` return is no struct id there, so
# `id<Str>(s)` is not typed), a data pointer when it is `str_data`; followed by one `.f` /
# `.m(..)`, that step on the struct the callee returns.
fn _str_call_kind(S, ti, o, ssid): i64 {
    _sca_shape = 1;
    if (o != ti + 1) { _sca_shape = 2; }
    _sca_op = 0;
    var e = _tok_close_paren(S, o);
    if (e < 0) { return 0; }
    var cfi = FINDFN(S, TOKVAL(S, ti));
    var rs = 0;
    if (cfi >= 0) { rs = GFRS(S, cfi); }
    if (rs <= 0) { if (cfi >= 0) { rs = _gen_ret_bound(S, cfi, ti, o); } }   # 6.6.17: `: T`
    if (_tok_ends_arg(S, e + 1) == 0) {
        if (TOKTYP(S, e + 1) != 41) { return 0; }
        var k = _str_step_kind(S, e + 1, rs, ssid);
        return k;
    }
    if (cfi < 0) { return 0; }
    if (rs == ssid) {
        _sca_op = 2;
        return 1;
    }
    if (_sca_shape != 1) { return 0; }
    if (_noff_is(S, TOKVAL(S, ti), "str_data", 8) == 0) { return 0; }
    if (TOKTYP(S, ti + 2) == 2) { if (e == ti + 3) { _sca_op = 3; } }
    return 2;
}
# The one step `.f` / `.m(..)` whose `.` is at token `di`, on a receiver of struct id `rsid`
# (0 untyped), when the step ends the argument. A method is a Str when `<Struct>_<m>` (as
# PARSE_FIELD_LOAD builds it) is declared `: Str` — `s.cat(t)` is, `s.len()` / `s.data()` are
# not; a field when it is declared `: Str`; `.data` of a Str is its data pointer.
fn _str_step_kind(S, di, rsid, ssid): i64 {
    if (TOKTYP(S, di + 1) != 2) { return 0; }
    if (rsid <= 0) { return 0; }
    _sca_di = di;
    if (_sca_d0 == 0) { _sca_d0 = di; }
    if (TOKTYP(S, di + 2) == 10) {
        _sca_op = 2;
        var e = _tok_close_paren(S, di + 2);
        if (e < 0) { return 0; }
        if (_tok_ends_arg(S, e + 1) == 0) { return 0; }
        if (_str_data_call(S, di, e, rsid, ssid) == 1) { return 2; }   # 6.6.17: `x.data()`
        var mf = _meth_fn_at(S, rsid, TOKVAL(S, di + 1), di + 1);
        if (mf < 0) { return 0; }
        if (GFRS(S, mf) == ssid) { return 1; }
        return 0;
    }
    if (_tok_ends_arg(S, di + 2) == 0) {
        var nk = _str_nested_step(S, di, rsid, ssid);   # 6.6.17: `a.b.name`
        return nk;
    }
    if (rsid == ssid) {
        _sca_op = 1;
        if (_noff_is(S, TOKVAL(S, di + 1), "data", 4) == 1) { return 2; }
        return 0;
    }
    _sca_op = 2;
    var fx = FINDFIELD(S, rsid - 1, TOKVAL(S, di + 1));
    if (fx < 0) { return 0; }
    if (GETFTYPE(S, rsid - 1, fx) == ssid) { return 1; }
    return 0;
}

# 6.6.17 — `a.b.name`: a field that does not end the argument continues the chain when it is a
# nested STRUCT and the next step is a field, as PARSE_FIELD_LOAD walks it (`_rlf_more`). A
# `: Str` field is never stepped INTO (it is a pointer slot, not an inline struct), and a
# `.m(..)` after a nested field is not parsed at all, so neither is typed.
fn _str_nested_step(S, di, rsid, ssid): i64 {
    if (TOKTYP(S, di + 2) != 41) { return 0; }
    if (TOKTYP(S, di + 3) != 2) { return 0; }
    if (TOKTYP(S, di + 4) == 10) { return 0; }
    if (rsid == ssid) { return 0; }
    var fx = FINDFIELD(S, rsid - 1, TOKVAL(S, di + 1));
    if (fx < 0) { return 0; }
    var ft = GETFTYPE(S, rsid - 1, fx);
    if (ft <= 0) { return 0; }
    if (ft == ssid) { return 0; }
    var k = _str_step_kind(S, di + 2, ft, ssid);
    return k;
}
# 6.6.17 — `x.data()` on a Str is its data pointer, the method spelling of `x.data` and
# `str_data(x)` (I11 named those two and was silent on this one). 1 when the step at `di`, its
# `)` at `e`, is exactly that.
fn _str_data_call(S, di, e, rsid, ssid): i64 {
    if (rsid != ssid) { return 0; }
    if (e != di + 3) { return 0; }
    if (_noff_is(S, TOKVAL(S, di + 1), "data", 4) == 0) { return 0; }
    _sca_op = 1;
    return 1;
}
# 6.6.17 — what a generic declared `: T` returns at THIS call: the struct T is bound to, by the
# explicit type argument (`g<Str>(..)`) or by the argument the call infers it from (`g(s)`) — the
# binding `_gen_resolve_call` instantiates on. A peek: no instance is minted here. 0 when T is not
# bound to a struct (the call returns a scalar, as before).
fn _gen_ret_bound(S, fi, ti, o): i64 {
    if (_MONOMORPH_OK == 0) { return 0; }
    var w = _gen_ret_tparam(S, fi);
    if (w < 0) { return 0; }
    var c = 0;
    if (o != ti + 1) { c = _gen_explicit_targ(S, ti, w); }
    else { c = _gen_infer_tp(S, fi, o, w); }
    if (c > 0) { return c; }
    return 0;
}
# Which type parameter (0 / 1) generic `fi` names as its return type, read from its signature
# (`fn g<T>(..): T`), else -1.
fn _gen_ret_tparam(S, fi): i64 {
    var tp = GFTP(S, fi);
    if (tp == 0) { return 0 - 1; }
    var ds = GFDS(S, fi);
    if (ds <= 0) { return 0 - 1; }
    var i = ds;                                  # the fn's name (GFDS = the `fn` token + 1)
    var n = GTCNT(S);
    while (i < n) { if (TOKTYP(S, i) == 10) { break; } i = i + 1; }
    var e = _tok_close_paren(S, i);
    if (e < 0) { return 0 - 1; }
    if (TOKTYP(S, e + 1) != 49) { return 0 - 1; }
    if (TOKTYP(S, e + 2) != 2) { return 0 - 1; }
    var rn = TOKVAL(S, e + 2);
    var t0 = tp & 0xFFFFFFFF;
    var t1 = (tp >> 32) & 0xFFFFFFFF;
    if (t0 != 0) { if (rn == t0 - 1) { return 0; } }
    if (t1 != 0) { if (rn == t1 - 1) { return 1; } }
    return 0 - 1;
}
# The struct named by explicit type argument `w` of the call at `ti` (`g<A>(` / `g<A, B>(`), when
# it is a single name; 0 otherwise (a scalar or a nested generic is not a Str).
fn _gen_explicit_targ(S, ti, w): i64 {
    var a = ti + 2;
    if (w == 1) {
        if (TOKTYP(S, a + 1) != 31) { return 0; }
        a = a + 2;
    }
    if (TOKTYP(S, a) != 2) { return 0; }
    var nt = TOKTYP(S, a + 1);
    if (nt != 20) { if (nt != 31) { return 0; } }
    var sid = FINDSTRUCT(S, TOKVAL(S, a));
    return sid;
}

# The argument as written: the head (`x`, `f(..)`, `g<..>(..)`), then its step (`.f`, `.m(..)`).
fn _sca_print_arg(S): i64 {
    _sca_print_head(S);
    if (_sca_di > 0) {
        var d = _sca_d0;
        while (d < _sca_di) {                     # the nested fields before the last step
            syscall(SYS_WRITE, 2, ".", 1);
            PRSTR(S + 0xEC00000 + TOKVAL(S, d + 1));
            d = d + 2;
        }
        syscall(SYS_WRITE, 2, ".", 1);
        PRSTR(S + 0xEC00000 + TOKVAL(S, _sca_di + 1));
        if (TOKTYP(S, _sca_di + 2) == 10) { _sca_print_call_args(S, _sca_di + 1); }
    }
    return 0;
}
fn _sca_print_head(S): i64 {
    var ti = GTI(S);
    PRSTR(S + 0xEC00000 + TOKVAL(S, ti));
    if (_sca_shape == 1) { _sca_print_call_args(S, ti); }
    if (_sca_shape == 2) { syscall(SYS_WRITE, 2, "<..>(..)", 8); }
    return 0;
}
# A call's argument list as the message shows it: `()`, `(x)` for one bare IDENT, else `(..)`.
fn _sca_print_call_args(S, ti): i64 {
    if (TOKTYP(S, ti + 2) == 11) {
        syscall(SYS_WRITE, 2, "()", 2);
        return 0;
    }
    if (TOKTYP(S, ti + 2) == 2) { if (TOKTYP(S, ti + 3) == 11) {
            syscall(SYS_WRITE, 2, "(", 1);
            PRSTR(S + 0xEC00000 + TOKVAL(S, ti + 2));
            syscall(SYS_WRITE, 2, ")", 1);
            return 0;
        } }
    syscall(SYS_WRITE, 2, "(..)", 4);
    return 0;
}
fn _sca_print_op(S): i64 {
    var ti = GTI(S);
    if (_sca_op == 0) { syscall(SYS_WRITE, 2, "..", 2); }
    if (_sca_op == 1) { _sca_print_head(S); }
    if (_sca_op == 2) { _sca_print_arg(S); }
    if (_sca_op == 3) { PRSTR(S + 0xEC00000 + TOKVAL(S, ti + 2)); }
    return 0;
}

# A Str-taking sibling of callee `fi` at param `argc`: its `<base>_str` overload, else
# `<stem>_str` for a callee named `<stem>_cstr` (bayan's `_by_cstr` / `_by_str` pair) — counted
# only when that sibling's param `argc` is annotated `: Str`. -1 when there is none.
fn _sca_sibling(S, fi, argc): i64 {
    var sib = L64(_fnt_ovstr + fi * 8) - 1;
    if (sib < 0) { sib = _sca_cstr_sibling(S, fi); }
    if (sib < 0) { return 0 - 1; }
    if (_pm_str(sib, argc) == 0) { return 0 - 1; }   # 6.6.17 (a10)
    return sib;
}
fn _sca_cstr_sibling(S, fi): i64 {
    var noff = L64(_fnt_names + fi * 8);
    var nm = S + 0xEC00000 + noff;
    var n = 0;
    while (load8(nm + n) != 0) { n = n + 1; }
    if (n < 6) { return 0 - 1; }
    if (n > 250) { return 0 - 1; }
    if (_noff_is(S, noff + n - 5, "_cstr", 5) == 0) { return 0 - 1; }
    var buf[256];
    var j = 0;
    while (j < n - 4) {
        store8(&buf + j, load8(nm + j));
        j = j + 1;
    }
    store8(&buf + n - 4, 115);
    store8(&buf + n - 3, 116);
    store8(&buf + n - 2, 114);
    var r = _FINDFN_CSTR(S, &buf, n - 1);
    return r;
}

# Warn when the argument at the cursor hands callee `fi`'s `: cstring` param `argc` a Str or a
# Str's data pointer. Read-only: never moves the cursor, never emits code. The hint never says
# `str_data` — that is the bug, not the fix.
fn _check_str_cstring_arg(S, fi, argc, noff): i64 {
    if (fi < 0) { return 0; }
    if (_TYPE_CHECK_ENABLED() != 1) { return 0; }
    if (_pm_cstr(fi, argc) == 0) { return 0; }   # 6.6.17 (a10)
    var ssid = _STR_SID(S);
    if (ssid <= 0) { return 0; }
    var k = _str_arg_kind(S, ssid);
    if (k == 0) { return 0; }
    if (_warn_seen(GTI(S), "_check_str_cstring_arg", ((fi * 31 + argc) * 31 + noff) * 4 + k) == 1) { return 0; }   # 6.7.15
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head(S);
    if (k == 1) { syscall(SYS_WRITE, 2, ": passing Str-typed '", 21); }
    else { syscall(SYS_WRITE, 2, ": passing a Str's data pointer '", 32); }
    _sca_print_arg(S);
    syscall(SYS_WRITE, 2, "' to '", 6);
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));
    syscall(SYS_WRITE, 2, "' which expects a cstring", 25);
    if (k == 1) { syscall(SYS_WRITE, 2, " (a Str is a {data, len} header, not a char*)\n", 46); }
    else { syscall(SYS_WRITE, 2, " (a Str's bytes are not NUL-terminated at its length)\n", 54); }
    _sca_print_hint(S, fi, argc);
    return 0;
}
fn _sca_print_hint(S, fi, argc): i64 {
    syscall(SYS_WRITE, 2, "  hint: ", 8);
    var sib = _sca_sibling(S, fi, argc);
    if (sib >= 0) {
        syscall(SYS_WRITE, 2, "call '", 6);
        PRSTR(S + 0xEC00000 + L64(_fnt_names + sib * 8));
        syscall(SYS_WRITE, 2, "', which takes a Str, or ", 25);
    }
    syscall(SYS_WRITE, 2, "pass str_cstr(", 14);
    _sca_print_op(S);
    syscall(SYS_WRITE, 2, ") for a NUL-terminated copy, or annotate the param `: Str`\n", 59);
    return 0;
}

# ⭐ 6.6.5 — v6.5.3's integer-literal-into-`: cstring` HARD ERROR, extracted from
# PARSE_FNCALL's argument loop so the method-call path runs it too. v6.5.3 escalated this
# from a warning to an error precisely because the alternative is a runtime crash — the
# callee derefs the number as a char*. The method path never had it: measured on 6.6.4 and
# on the first two cuts of this bite, `w.pr(42)` into `fn pr(self, p: cstring)` compiled
# clean and SIGSEGV'd (rc 139), while the identical `free_pr(0, 42)` was refused at compile
# time. `0` stays EXEMPT — it is the idiomatic NULL for a cstring param. Does not move the
# cursor; returns 0 always (the arg is still pushed by the caller's normal path, so ONE
# compile reports EVERY bad site — the v6.4.62 multi-error contract). CHANGELOG [6.6.5]
fn _check_int_lit_cstring_arg(S, fi, argc, noff): i64 {
    if (fi < 0) { return 0; }
    if (_TYPE_CHECK_ENABLED() != 1) { return 0; }
    if (PEEKT(S) != 1) { return 0; }
    if (PEEKV(S) == 0) { return 0; }
    if (_pm_cstr(fi, argc) == 0) { return 0; }   # 6.6.17 (a10)
    if (_derr_seen(GTI(S), "_check_int_lit_cstring_arg", (fi * 31 + argc) * 31 + noff, 0) == 1) { return 0; }   # 6.7.15
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": passing integer literal ", 26);
    PRNUM(PEEKV(S));
    syscall(SYS_WRITE, 2, " to '", 5);
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));
    syscall(SYS_WRITE, 2, "' which expects a cstring (a POINTER, not a number)\n", 52);
    syscall(SYS_WRITE, 2, "  hint: the value is a NUMBER — use the _int variant if one exists (e.g. println_int), or fmt_int_buf to render it\n", 117);
    _had_error = 1;
    return 0;
}

# ⭐ 6.6.5 — the v5.10.38 value-form SIMD argument RECORDING, extracted for the same reason.
# A SIMD-class param is NOT pushed with the int args: it is recorded here and loaded into
# XMM/V after ECALLPOPS (`_simd_arg_second_pass`), so int-arg evaluation cannot clobber the
# vector registers. The method-call path had neither half and pushed the vector as an int
# arg, which shifted every LATER argument by one register. Measured on 6.6.4 and on the
# first cut of this bite: `h.vmix(2, v, 3)` returned 927 where the identical free fn
# returned 923 — `j` received the vector's low half. `tbl` is the CALLER's scratch table
# (a local, so a nested call cannot clobber it). Returns the number of XMM slots consumed
# (1 for a 16-byte vector, 2 for 32-byte). CHANGELOG [6.6.5]
var _sar_fi = 0 - 1;   # 6.7.13: the callee `_simd_arg_record`'s argument is passed to (cybs's 6-parameter cap)
fn _simd_arg_record(S, cls, tbl, cnt, pc, want): i64 {
    var lli = _sar_src(S, _sar_fi, cls, want);   # 6.7.13 (D30): a local, or a call's temp; -1 refused
    store64(tbl + cnt * 24, lli);
    store64(tbl + cnt * 24 + 8, pc);
    store64(tbl + cnt * 24 + 16, cls);
    if (cls == 2) { return 2; }
    return 1;
}

# ⛔ 6.7.13 (D30 A, the user's decision, 2026-10-15) — A VECTOR CALL RESULT PASSED TO A VALUE-FORM VECTOR PARAMETER IS
# PASSED. `lanes(mkv(4, 2))` and `f64v2_add(a, mkv(3, 4))` were refused on x86_64 / aarch64 / cx with the v5.10.38 scope
# wording ("value-form SIMD arg: IDENT not found as a local") and a cascade ("expected ';', got number 4": the IDENT was
# consumed, the `(` left); on Win64 the value push handed the callee lane 0 as the vector's address (exit 5). A value-form
# parameter is the callee's vector local, which takes a call declared to return the vector (6.7.11's D32), and D27
# (6.7.12) passes such a call to a `*V` parameter through a frame temp: the same here. The whole argument at the cursor
# (`fi`'s parameter of class `cls`, `want` its 32-byte type), consumed: a local — its slot, checked by the class as ever;
# a call declared to return a vector (`_svc_rs`: by name, `g<T>(..)`, `&f` through fncallN / callptr, a method) — received
# into anonymous slots (`_vrcv_emit`; the second pass loads them after ECALLPOPS, and nothing names them, so no later
# argument writes them), their slot; anything else — or a call of another vector type, or one at top level (no frame:
# D40) — refused by name, once, and skipped to its `,` / `)`: -1. CHANGELOG [6.7.13]
fn _sar_src(S, fi, cls, want): i64 {
    var ti = GTI(S);
    var r = _sar_take(S, fi, cls, want, 0 - 1);
    if (r != 0 - 2) { return r; }
    _sar_none(S, ti, fi);
    return 0 - 1;
}
# The value-form vector argument at token `ti` (the cursor) that no source arm took: refused by name (`_sar_err`) — or
# (6.7.14) a call naming no fn, inside any parentheses (`_vrcv_nofnw`), left to the value parse, so the call registers
# and the undefined-function path names it (no binary: its error; under --allow-undef the call traps), where "got
# `f64v2_splat`" was the only line — and skipped to its `,` / `)`. Shared with the inline replay. 0.
fn _sar_none(S, ti, fi): i64 {
    var e = _arg_next(S, ti);
    if (_vrcv_nofnw(S, ti, e) == 1) { PCMPE(S); }
    else { _sar_err(S, ti, fi); }
    STI(S, e);
    return 0;
}
# ⛔ 6.7.14 — PARENTHESES WRAPPING A WHOLE VALUE-FORM VECTOR ARGUMENT ARE TRANSPARENT, as for every other aggregate
# destination (6.7.6, 6.7.11; 6.7.13's D17 / D19): `lanesn((v))` and `lanesn((mkv(4, 2)))` were refused on x86_64 /
# aarch64 / cx ("got `(...)`") where Windows passed them (`_sarg_paren`). The whole argument at the cursor, inside any
# parentheses wrapping all of it (`_pwrap_in`: `(v) + 1` and a tuple literal wrap nothing), into a value-form parameter
# of class `cls` / `want` of `fi` (`_sar_one`), the wrap's `)`s consumed: its slot (`_sar_lcl` 1: a local's own,
# nothing copied; else the slot `dst` it was received into, -1: anonymous slots of its type), or -1 (refused by its own
# rule, skipped); -2 = no such source, nothing moved. Shared by the call's record (`_sar_src`) and the inline replay
# (`_inl_simd_arg`); Win64's gate peels the same way (`_sarg_pe_vform`). CHANGELOG [6.7.14]
var _sar_ti = 0;   # 6.7.14: the whole argument's first token (before any wrap) — what a refusal inside it names
fn _sar_take(S, fi, cls, want, dst): i64 {
    var ti = GTI(S);
    _sar_ti = ti;
    var c = _pwrap_in(S, ti);
    if (c < 0) { return 0 - 2; }
    STI(S, c);
    var r = _sar_one(S, fi, cls, want, dst);
    if (r == 0 - 2) {
        STI(S, ti);
        return r;
    }
    _pw_close(S, c - ti);
    return r;
}
# The source at the cursor, unwrapped: a local of the parameter's class (checked by it, as ever), (6.7.14) a closure's
# captured vector (`_sar_cap`), a `*V` dereference (`_sar_deref`), else a call declared to return a vector
# (`_sar_vcall`; `_sar_lcl` is set after them: a nested call's argument sets it too).
fn _sar_one(S, fi, cls, want, dst): i64 {
    var c = GTI(S);
    var li = _spv_local(S, c);
    if (li >= 0) {
        STI(S, c + 1);
        _simd_arg_typecheck(S, cls, GLTYPE(S, li), want);
        _sar_lcl = 1;
        return li;
    }
    var r = _sar_cap(S, cls, want, dst);   # 6.7.14 (D31 A): a closure's captured vector
    if (r == 0 - 2) { r = _sar_deref(S, fi, cls, want, dst); }   # 6.7.14 (D32 A): `*p`
    if (r == 0 - 2) { r = _sar_vcall(S, fi, cls, want, dst); }
    _sar_lcl = 0;
    return r;
}
# ⛔ 6.7.14 — A CLOSURE'S CAPTURED VECTOR INTO A VALUE-FORM PARAMETER IS PASSED, AS THE LOCAL IS (D31, the user's
# decision, 2026-10-16: A). `|k| lanes(b)` with `b` a captured f64v2 and `fn lanes(x: f64v2)` was refused on every
# target ("a value-form vector argument to 'lanes' is a local of its type .. - got `b`"), where `lanes(b)` on the local
# passes: the record took a FINDLOCAL local, and a capture lives in the closure's env. 6.7.13's D32 gave a captured
# vector the local's rules for a pointer parameter; this is the value-form half. The whole name at the cursor, a
# captured vector (`_spv_cap`) — checked by the class rule a local of its type meets (`_simd_arg_typecheck`, its words)
# — has its env words (`&env[woff]`) copied into slot `dst` (-1: anonymous slots of its type) here, before ECALLPOPS,
# and that slot is what the vector second pass loads (the inline replay: the parameter's own slots). Another class is
# refused (-1); not a captured vector: -2. Win64 pushes the capture's address (`_spv_one`). CHANGELOG [6.7.14]
fn _sar_cap(S, cls, want, dst): i64 {
    var c = GTI(S);
    var t = _spv_cap(S, c);
    if (t == 0) { return 0 - 2; }
    STI(S, c + 1);
    _simd_arg_typecheck(S, cls, t, want);
    if (_sar_vok(S, cls, t, want) == 0) { return 0 - 1; }
    return _cap_vcopy(S, TOKVAL(S, c), t, dst);
}
# ⛔ 6.7.14 — A `*V` DEREFERENCE INTO A VALUE-FORM PARAMETER COPIES THE VECTOR THROUGH THE POINTER (D32, the user's
# decision, 2026-10-16: A). `lanes(*pb)` with `pb: *f64v2` and `fn lanes(x: f64v2)` was refused on x86_64 / aarch64 / cx
# ("got `*pb`") and compiled to a page fault on Win64 (lane 0 taken as the vector's address: exit 5). 6.7.13's D34 made
# `var v: f64v2 = *p;` copy through the pointer and D27 passes `*pv` to a `*V` parameter as pv: `*pv` has one meaning at
# every destination, and a value-form parameter is the callee's vector local (D30). The whole dereference at the cursor
# (`_sar_dsrc`) — its vector checked by the class rule a local of that type meets (`_simd_arg_typecheck`, its words) —
# is copied through the pointer into slot `dst` (-1: anonymous slots of its type) here, before ECALLPOPS, the slot the
# vector second pass loads (the inline replay: the parameter's own slots); Win64 pushes the pointer itself, the
# address its callee copies from (`_spv_one`). A `*q` naming no vector is refused by name; another class: -1; no whole
# dereference: -2. CHANGELOG [6.7.14]
fn _sar_deref(S, fi, cls, want, dst): i64 {
    var vd = _sar_dsrc(S, fi);
    if (vd == 0 - 1) { return 0 - 2; }
    if (vd == 0) { return 0 - 1; }
    _simd_arg_typecheck(S, cls, 0 - vd, want);
    if (_sar_vok(S, cls, 0 - vd, want) == 0) { return 0 - 1; }
    _vec_desc(S, 0 - vd);
    var n = GVEC_NSLOTS(S);
    if (dst < 0) { dst = _agg_temp_t(S, n, 0 - vd); }
    return _sar_copy_ra(S, dst, n);
}
# The whole dereference `* E` at the cursor (any wrap peeled; `,` / `)` after it, no operator splitting it, as the
# vector local's `_vrcv_dsrc` reads one), in a fn (its copy needs the frame): E is parsed — rax = the pointer, left
# there — and its vector read from its step word or an `&x` of a vector (`_dop_vd`: a `*V` local, parameter, capture,
# field, global, `: *V` call, `**V`'s `*pp`, `&b`): that descriptor (>= 2048). 0 = E names no vector: refused by name at
# the argument (`_sar_ti`), once — not after E's own parse reported — the cursor at the source's end. -1 = no whole
# dereference here, nothing moved.
fn _sar_dsrc(S, fi): i64 {
    var a = GTI(S);
    if (TOKTYP(S, a) != 8) { return 0 - 1; }
    if (GINFN(S) != 1) { return 0 - 1; }
    var e = _arg_next(S, a);
    if (e - a < 2) { return 0 - 1; }
    if (_gz_split(S, a, e) != 0 - 1) { return 0 - 1; }
    var ti = _sar_ti;
    var he = _had_error;
    STI(S, a + 1);
    PARSE_FACTOR(S);
    var vd = 0;
    if (GTI(S) == e) { vd = _dop_vd(S, a + 1, e); }
    if (vd != 0) { return vd; }
    if (he == 0) { if (_had_error == 1) { he = 2; } }
    if (he != 2) { _sar_err(S, ti, fi); }
    STI(S, e);
    return 0;
}
# The vector type (its SLTYPE) of the closure capture a whole argument at token `ti` names (`,` or `)` after it, no
# local of that name: `_cl_cap_vec`), else 0.
fn _spv_cap(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var nx = TOKTYP(S, ti + 1);
    if (nx != 31) { if (nx != 11) { return 0; } }
    if (FINDLOCAL(S, TOKVAL(S, ti)) >= 0) { return 0; }
    return _cl_cap_vec(S, TOKVAL(S, ti));
}
# rax = the address of the captured vector `noff`'s words in the closure's env (`&env[woff]`).
fn _cap_vaddr(S, noff): i64 {
    return _CL_CAP_WORDS_RA(S, _cl_cap_find(_cl_snap_find(S, noff)));
}
# The captured vector `noff` (type `t`) copied into slot `dst` (-1: anonymous slots of its type, `_agg_temp_t`) — the
# slot.
fn _cap_vcopy(S, noff, t, dst): i64 {
    _vec_desc(S, t);
    var n = GVEC_NSLOTS(S);
    if (dst < 0) { dst = _agg_temp_t(S, n, t); }
    _cap_vaddr(S, noff);
    return _sar_copy_ra(S, dst, n);
}
# rax = a vector's address: its `n` words copied into the slots of the vector at slot `dst`, the address kept on the
# stack between words — no frame temp: an `#inline` replay's arguments run before it releases its window (`SFLC` back
# to its parameters), so a temp taken there would lie past the frame. `_agc_copy_bytes`'s primitives. Returns `dst`.
fn _sar_copy_ra(S, dst, n): i64 {
    var i = 0;
    while (i < n) {
        EPUSHR(S);
        EMOVCA(S);
        if (i > 0) { EADDIMM_X1(S, i * 8); }
        EFIELD_LOAD_W(S, 8);
        EPUSHR(S);
        _agc_addr_x1(S, dst, 0 - 1, i * 8);
        EPOPR(S);
        ESTOC(S);
        EPOPR(S);
        i = i + 1;
    }
    return dst;
}
# The whole argument at the cursor when it is a call declared to return a vector (`_svc_rs`), into a value-form
# parameter of class `cls` / `want` of `fi`: received into slot `dst` (-1: anonymous slots of its type) — that slot; a
# vector the local rule refuses (`_sar_vok`) or a call at top level: refused by name, the argument skipped (-1); not
# such a call: -2, nothing moved.
fn _sar_vcall(S, fi, cls, want, dst): i64 {
    var rs = _svc_rs(S, GTI(S));
    if (rs == 0) { return 0 - 2; }
    var bad = 0;
    if (_sar_vok(S, cls, rs, want) == 0) {
        ERR_IDENT(S, "cannot pass ", _svc_nm, " to a parameter of a different vector type in a call to ", _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
        bad = 1;
    } elif (GINFN(S) != 1) {
        _svc_toplevel_err(S);
        bad = 1;
    }
    if (bad == 1) {
        STI(S, _arg_next(S, GTI(S)));
        return 0 - 1;
    }
    _vec_desc(S, rs);
    if (dst < 0) { dst = _agg_temp_t(S, GVEC_NSLOTS(S), rs); }
    _vrcv_k = 0;
    _vrcv_emit(S, dst, rs, _svc_k);
    return dst;
}
# 1 = a vector of local type `rs` passes a value-form parameter of class `cls` (`want` its 32-byte type), by the rule
# a local of that type meets (`_simd_arg_typecheck`): any 16-byte vector, exactly f32v4, exactly the 32-byte one.
fn _sar_vok(S, cls, rs, want): i64 {
    if (cls == 1) { return _is_simd128(S, rs); }
    var w = 0 - 2125;
    if (cls == 3) { w = 0 - 2121; }
    elif (want == 2153) { w = 0 - 2153; }
    if (rs == w) { return 1; }
    return 0;
}
# The class `_simd_arg_typecheck` reads for a value-form parameter of local type `t` (its SLTYPE): 3 = f32v4, 2 = a
# 32-byte vector, 1 = any other (16-byte) one.
fn _vf_cls(S, t): i64 {
    if (t == 0 - 2121) { return 3; }
    if (_is_simd256(S, t) == 1) { return 2; }
    return 1;
}
# The refusal of a value-form vector argument at token `ti` to `fi` that is no local (6.7.14: or closure capture), no
# call declared to return a vector and (6.7.14, D32) no dereference of a pointer to one: once, by name, without
# `_panic` (the caller skips the argument, so the parse stays in step and one compile reports every such argument).
# Returns 0.
fn _sar_err(S, ti, fi): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(ti, "_sar_err", fi, 0) == 1) { return 0; }   # 6.7.15: once per site
    var sv = GTI(S);
    STI(S, ti);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": a value-form vector argument to '");
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    PRSTR("' is a local of its type, a call declared to return it (by name, a method, or fncallN / callptr with the callee written `&f`) or a dereference of a pointer to its type (`*p`) - got `");
    _vrcv_offender(S, ti);
    PRSTR("`\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 0;
}

# ⭐ 6.6.6 — ONE ARGUMENT OF AN OWN-CALL LOOP, run through PARSE_FNCALL's callee-mask gates: a
# value-form vector is RECORDED for the XMM/V second pass (never pushed); anything else is the
# int-class push behind the `: cstring` literal error, the `: Str` literal wrap and the
# struct-address push (which is also how a Win64 vector travels — by pointer, in its int slot).
# `st` is the caller's 3-word state: [int args pushed, vectors recorded, next XMM/V ordinal].
# The method-call loop grew these gates inline in 6.6.5; the two struct-valued `var` receives
# (`var p: S = f(...)`, retptr and rax:rdx) had NONE and pushed a vector as an int, so every
# later int shifted and the callee read a stale XMM0 (SysV/aarch64) or dereferenced the
# vector's first word as its pointer (Win64 page fault). Every own-call argument loop shares
# it — those three, and (via `_owncall_args`) the four PE-only vector-retptr loops, whose own
# copy had the gates but not the arity check. CHANGELOG [6.6.6]
# The gates, in order (each keyed by the PARAMETER index `uarg`, so any caller that knows the index
# inherits all of them):
#   * a SIMD-class parameter (v5.10.38) must be a local vector IDENT; it is recorded, never pushed,
#     and loaded into XMM/V after ECALLPOPS, so int-arg evaluation cannot clobber the vector regs.
#   * an integer LITERAL into a param annotated `: cstring` is a hard error (v6.5.3 — the callee
#     derefs the number; `0`, the idiomatic NULL, is exempt); only an EXPLICIT annotation counts
#     (v5.10.24). A Str or a Str's data pointer into one warns (6.6.13 I11).
#   * a string literal into a `: Str` param is wrapped in `str_from` (else the callee reads a raw
#     cstr as a header).
#   * a bare inline struct into a struct-pointer param pushes its address (v6.3.36).
#   * otherwise PCMPE (plus 6.7.3's bool check and 6.7.6's f32 rounding) and EPUSHR.
# CHANGELOG [5.10.38] [6.5.3] [6.6.5] [6.6.13] [6.3.36]
fn _call_arg_one(S, fi, uarg, noff, tbl, st): i64 {
    var cls = _pm_simd(fi, uarg);   # 6.6.17 (a10)
    if (cls > 0) {
        var vs = _later_args_may_write(S);   # 6.7.7: its register is loaded after them (`_simd_arg_snap`)
        var n = load64(st + 8);
        var o = load64(st + 16);
        var w = 0;
        if (cls == 2) { w = _pv32_param(S, fi, uarg); }   # 6.7.13: f64v4 or f32v8
        _sar_fi = fi;
        store64(st + 16, o + _simd_arg_record(S, cls, tbl, n, o, w));
        store64(st + 8, n + 1);
        if (vs == 1) { _simd_arg_snap(S, tbl, n); }
        return 0;
    }
    _check_int_lit_cstring_arg(S, fi, uarg, noff);
    _check_str_cstring_arg(S, fi, uarg, noff);   # 6.6.13 I11
    if (_try_push_str_literal_arg(S, fi, uarg) == 0) { _arg_push_snap(S, fi, uarg, noff, 0); }   # 6.7.7: + its copy
    store64(st, load64(st) + 1);
    return 0;
}

# ⭐ 6.7.7 — THE ONE ARGUMENT MARSHALLER of every direct call to a known callee (cursor just past
# `(`): every argument through `_call_arg_one`, then `)`, the arity check, ECALLPOPS of the
# int-class args and the vector loads. `int0` = int args the caller already pushed (x86's retptr;
# the method form's retptr and `self`). `p0` = the first user parameter's index: 0, or 1 for
# `o.m(..)`, whose `self` is parameter 0. `line` = the arity message's line (the caller's — the
# method form names the `(`). Returns the int-class total, for ECALLCLEAN.
# ⭐ "One call syntax" was never "one call path": PARSE_FNCALL, the method form and the
# struct-valued receives each grew their own copy of this loop, and each copy missed a gate the
# others had — the method form shipped with NONE of the four callee-mask gates and no arity check
# (6.6.5: `h.slen("abcde")` read 0, `h.vmix(2, v, 3)` shifted `j` a register, `w.pr(42)` into a
# `: cstring` SIGSEGV'd, `q.one(5, 99)` built), the receives had none (6.6.6), and the four
# WIN64-ONLY vector-retptr calls (`_try_vector_call_assign`, the `_f2c`/`_f4c` receives, the PE
# `return f(..)`) had no arity check, so `v = f(3)` on a 2-param `f` built clean on PE alone.
# 6.7.7 folded PARSE_FNCALL's and the method form's loops onto this one, so a call-site obligation
# is written once. CHANGELOG [6.6.5] [6.6.6] [6.7.7]
fn _owncall_args_at(S, fi, noff, int0, p0, line): i64 {
    var tbl: i64[24];   # 8 args x 3 words, a LOCAL — a nested call gets its own (v6.2.1: i64[24])
    var st: i64[7];     # [0..16] below; [24..48] the named phase's (`_pd_named`)
    store64(&st, int0);
    store64(&st + 8, 0);
    store64(&st + 16, 0);
    var uarg = p0;
    if (PEEKT(S) != 11) {
        var go = 1;
        while (go == 1) {
            if (_pd_label_at(S, GTI(S)) == 1) { go = 0; }   # 6.7.7 (B6): a named argument
            else {
                _call_arg_one(S, fi, uarg, noff, &tbl, &st);
                uarg = uarg + 1;
                if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                else { go = 0; }
            }
        }
    }
    if (_pd_label_at(S, GTI(S)) == 1) {
        store64(&st + 24, p0);
        store64(&st + 32, line);
        _pd_named(S, fi, noff, uarg, &tbl, &st);   # 6.7.7 (B6): checked whole, then in parameter order
    } else {
        # 6.7.14: a missing `)` leaves a `;` / `}` / statement keyword in place, and an unclosed list
        # has no argument count to judge (`g(1;` also said "'g' expects 2 arguments, got 1").
        if (_expect_step(S, 11) == 1) { _check_arity_p0(S, line, noff, fi, uarg, 1, p0); }   # `uarg` counts `self`, as `_fnt_params` does (the message does not, 6.7.14)
        _pd_fill(S, fi, uarg, &st);                 # 6.7.7 (B6): a short call's parameter defaults
    }
    var n = load64(&st);
    ECALLPOPS(S, n);   # int-class args only: a vector was recorded, not pushed
    _simd_arg_second_pass(S, &tbl, load64(&st + 8));   # after ECALLPOPS: int args cannot clobber XMM/V
    return n;
}
# The plain form (p0 = 0), its line the first argument's (cursor just past `(`).
fn _owncall_args(S, fi, noff, int0): i64 {
    return _owncall_args_at(S, fi, noff, int0, 0, GTLINE(S, GTI(S)));
}

# ⭐ 6.6.6 — A STRUCT-VALUED CALL NEEDS SOMEWHERE TO PUT ITS RESULT, WHEREVER IT IS WRITTEN.
# How fn `fi` returns: 2 = a >16 B struct through a hidden retptr (x86/cx: int arg 0; aarch64:
# X8), 1 = a 9-16 B non-Str struct in rax:rdx, 0 = anything else. The same predicate as the
# callee's rough-scan (`_cur_fn_ret_stash` / `_cur_fn_ret_pair`) and PARSE_VAR's asv_try /
# asv_pair, so caller and callee cannot disagree. CHANGELOG [6.6.6]
fn _ret_agg_class(S, fi): i64 {
    if (fi < 0) { return 0; }
    var sid = GFRS(S, fi);
    if (sid <= 0) { return 0; }
    var sz = STRUCTSZ(S, sid - 1);
    if (sz > 16) { return 2; }
    if (sz > 8) { if (sid != _STR_SID(S)) { return 1; } }
    return 0;
}

# ⛔ 6.7.12 — ON WIN64 A VECTOR RESULT ALWAYS HAS SOMEWHERE TO GO. A value-form vector comes back through a hidden
# result pointer the CALLER passes as int arg 0 (the MS x64 ABI for a 16 / 32-byte value), and only the receives
# passed one (PARSE_VAR's, `_try_vector_call_assign`, `_vrcv_emit`). A vector-returning call anywhere else — a
# statement `mkv(41, 7);`, `callptr(&mkv, 41, 7);`, `var x = callptr(&mkv, ..)`, an argument, a method call, an
# operator fn returning a vector, at top level too — passed none, so the callee took its first user argument as
# the pointer and wrote the vector through it: a page fault (exit 5), or a silent overwrite of `self` for a
# method. SysV / AAPCS64 / cx return the vector in registers and are unchanged. Now every such call gets storage
# — a frame temporary in a fn, a hidden global at top level (no frame there) — whose address is int arg 0, and the
# expression's value is its first word, as a struct result's is (`_fnc_agg`, `_sc_pre` / `_sc_post`, `_icall_sret`).
# Issue 2026-10-13-pe-discarded-vector-call-result-no-hidden-pointer. CHANGELOG [6.7.12]
# 1 = on PE, fn `fi` returns a value-form vector (through a hidden result pointer).
fn _pe_vret(S, fi): i64 {
    if (_TARGET_PE != 1) { return 0; }
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) > 0 - 2048) { return 0; }
    return 1;
}
# The storage fn `fi`'s vector result is written to, its address pushed (int arg 0): its handle (`_HTLOAD`'s —
# a frame slot, or `0 - 2 - gv` for the hidden global at top level).
fn _pe_vtemp(S, fi): i64 {
    var rs = GFRS(S, fi);
    _vec_desc(S, rs);
    var n = GVEC_NSLOTS(S);
    var h = 0;
    if (GINFN(S) == 1) {
        h = _agg_temp_t(S, n, rs);
        EFLADDR(S, h);
    } else {
        h = _HTEMP(S);
        S64(_vars_base + (0 - 2 - h) * 8, n * 8);
        EVADDR(S, 0 - 2 - h);
    }
    EPUSHR(S);
    return h;
}
# After the call: the value is the storage's first word (-1: a receive passed its own destination, nothing).
fn _pe_vload(S, h): i64 {
    if (h != 0 - 1) { _HTLOAD(S, h); }
    SESTYPE(S, 0);
    return 0;
}

# An anonymous in-frame destination for struct `sid`: (n-1) fillers, then the slot that
# addresses it (field 0), laid out exactly like a `var p: S` receive. Returns that slot.
fn _agg_temp(S, sid): i64 {
    var sz = STRUCTSZ(S, sid - 1);
    return _agg_temp_t(S, ((sz + 7) & (0 - 8)) / 8, 0 - sid);
}
# ... `n` slots of local type `ty` (a struct's -sid, or a vector's type, laid out like a vector local).
fn _agg_temp_t(S, n, ty): i64 {
    var j = 0;
    while (j < n - 1) {
        var f = GFLC(S);
        S64(S + 0x5D9D000 + f * 8, 0 - 1);
        SLDEP(S, f, GSDEP(S));
        SLTYPE(S, f, 0);
        SFLC(S, f + 1);
        j = j + 1;
    }
    var t = GFLC(S);
    S64(S + 0x5D9D000 + t * 8, 0 - 1);
    SLDEP(S, t, GSDEP(S));
    SLAGG(S, t, n);
    SLTYPE(S, t, ty);
    SFLC(S, t + 1);
    if (t + 1 > _flc_hwm) { _flc_hwm = t + 1; }
    return t;
}

# The call itself, cursor just past `(`: the retptr (x86/cx: pushed as int arg 0, before the user
# args; aarch64: X8, after them), every user arg through the callee gates, the call, and for a
# rax:rdx return the pair store. The result lands in the aggregate whose field-0 slot is `dst`.
# Shared by PARSE_VAR's two receives and every call site below that used to have no destination.
fn _struct_call_emit(S, fi, noff, dst): i64 {
    var cls = _ret_agg_class(S, fi);
    var n0 = 0;
    if (cls == 2) { if (_AARCH64_BACKEND == 0) {
            EFLADDR(S, dst);
            EPUSHR(S);
            n0 = 1;
        } }
    var n = _owncall_args(S, fi, noff, n0);
    if (cls == 2) { if (_AARCH64_BACKEND == 1) { EFLADDR_X8(S, dst); } }
    var tgt = L64(_fnt_offsets + fi * 8);
    if (tgt >= 0) { ECALLTO(S, tgt); }
    else { ECALLFIX(S, fi); }
    ECALLCLEAN(S, n);
    SESTYPE(S, 0);   # 6.7.9: PARSE_FNCALL's D3 reset — `mk(1.5).a * 2` kept the f64 argument's type
    if (cls == 1) { EFLSTORE_STRUCT_INT_PAIR(S, dst); }
    # 6.6.12: a struct result in rax — a <= 8 B struct's bytes (`dst` inline), or a `Str` handle
    # (`dst` pointer-mode, see `_struct_call_into`). Only `_call_field` asks for this class.
    if (cls == 0) { if (GFRS(S, fi) > 0) { EFLSTORE(S, dst); } }
    return 0;
}

# `IDENT ( args )` at the cursor, for a callee `_ret_agg_class` accepts: allocate a temp, emit
# the call into it, return the temp's field-0 slot. CHANGELOG [6.6.6]
fn _struct_call_into_temp(S): i64 {
    _struct_call_into(S, 0);
    return _sci_t;
}
# 6.6.12: `handle` = 1 for a struct returned as a HEAP HANDLE in rax (`Str` — the one class-0
# struct over 8 B): the temp is one POINTER-mode slot that holds it, as `var s = str_from(..)`
# does, not an inline aggregate the handle would be stored into. The slot is left in `_sci_t`.
var _sci_t = 0;
fn _struct_call_into(S, handle): i64 {
    var noff = PEEKV(S);
    var o = _gcall_open(S, GTI(S));          # 6.6.10: also `name<..>(`
    if (o < 0) { o = GTI(S) + 1; }
    var fi = _gen_resolve_call(S, GTI(S));   # 6.6.10: a generic's instance, not its base
    if (fi < 0) { fi = REGFN(S, noff); }
    _gen_own_call_check(S, fi, noff);
    _callee_site_checks_here(S, fi, noff, 0);   # the cursor is on the callee's name
    var t = 0;
    if (handle == 1) { t = _ptr_temp(S, GFRS(S, fi)); }
    else { t = _agg_temp(S, GFRS(S, fi)); }
    STI(S, o + 1);   # consume IDENT [<..>] `(`
    _struct_call_emit(S, fi, noff, t);
    _sci_t = t;
    return 0;
}

# An anonymous POINTER-mode struct slot (the slot holds the struct's address). CHANGELOG [6.6.12]
fn _ptr_temp(S, sid): i64 {
    var t = GFLC(S);
    S64(S + 0x5D9D000 + t * 8, 0 - 1);
    SLDEP(S, t, GSDEP(S));
    SLTYPE(S, t, 0 - sid);
    SFLC(S, t + 1);
    if (t + 1 > _flc_hwm) { _flc_hwm = t + 1; }
    return t;
}

# The token after the `)` that closes the call `IDENT (` at `ti` — what follows the call.
fn _call_follow(S, ti): i64 {
    var k = ti + 2;
    var d = 1;
    while (k < GTCNT(S)) {
        var t = TOKTYP(S, k);
        if (t == 10) { d = d + 1; }
        if (t == 11) { d = d - 1; if (d == 0) { break; } }
        k = k + 1;
    }
    return TOKTYP(S, k + 1);
}

# The `)` closing the call whose `(` is token `o`. CHANGELOG [6.6.12]
fn _call_close(S, o): i64 {
    var k = o + 1;
    var d = 1;
    while (k < GTCNT(S)) {
        var t = TOKTYP(S, k);
        if (t == 10) { d = d + 1; }
        if (t == 11) { d = d - 1; if (d == 0) { return k; } }
        k = k + 1;
    }
    return k;
}

# 1 = the call `name(..)` / `name<..>(..)` at token `ti` is followed by `.field` — its result is
# not the value (a `..` range is not a field). The receives that size a destination from the
# callee's return skip such a call. CHANGELOG [6.6.12]
fn _call_dotted(S, ti): i64 {
    var o = _gcall_open(S, ti);
    if (o < 0) { return 0; }
    var c = _call_close(S, o);
    if (TOKTYP(S, c + 1) != 41) { return 0; }
    if (TOKTYP(S, c + 2) != 2) { return 0; }
    return 1;
}

# ⛔ 6.7.6 — 1 = the call `name(..)` / `name<..>(..)` at token `ti` is followed by token type `term`
# (`;`): it is the whole initialiser or return value. A receive that sized itself from the callee's
# return took the call alone when it was only an operator's LEFT operand, so `var r = mk3(4) - s;`
# and `return mk(1) + a;` were `expected ';', got '-'` on valid code. A call this cannot open (an
# unresolvable `<..>`) answers 1, as before. CHANGELOG [6.7.6]
fn _call_ends_at(S, ti, term): i64 {
    var o = _gcall_open(S, ti);
    if (o < 0) { return 1; }
    if (TOKTYP(S, _call_close(S, o) + 1) == term) { return 1; }
    return 0;
}

# Is the call at `ti` the WHOLE argument (followed by `,` or `)`)? A call inside a larger
# expression (`f(a) + 1`) is left to the ordinary value path.
fn _call_is_whole_arg(S, ti): i64 {
    var nx = _call_follow(S, ti);
    if (nx == 31) { return 1; }
    if (nx == 11) { return 1; }
    return 0;
}

# `return f(..);` in a struct-returning fn, where `f` returns that same struct: the call into a
# temp (returned), or -1 when the return expression is not that shape. CHANGELOG [6.6.6]
fn _return_struct_call(S): i64 {
    if (_gcall_open(S, GTI(S)) < 0) { return 0 - 1; }   # 6.6.10: `name(` or `name<..>(`
    if (_call_dotted(S, GTI(S)) == 1) { return 0 - 1; }   # 6.6.12: a field of the result
    if (_call_ends_at(S, GTI(S), _ret_term) == 0) { return 0 - 1; }   # 6.7.6: a left operand (`_ret_expr_head`)
    var fi = _gen_resolve_call(S, GTI(S));   # 6.6.10: a generic's instance, not its base
    if (fi < 0) { return 0 - 1; }
    if (GFRS(S, fi) != _cur_fn_ret_sid) { return 0 - 1; }
    if (_ret_agg_class(S, fi) != 2) { return 0 - 1; }
    return _struct_call_into_temp(S);
}

# `var G: S = f(..)` at top level, `f` returning `S` in rax:rdx: the global is not an inline
# aggregate there (no receive path exists outside a fn), so `G.x` dereferenced the returned
# first word — SIGSEGV. Refused by name, like the retptr form PARSE_FNCALL refuses. CHANGELOG [6.6.6]
# `ti` is the callee's name token. ⛔ 6.6.11: resolved as the call REACHES it (`_gcall_open` +
# `_gen_resolve_call`) — FINDFN read the generic BASE, whose 8 B `W1<T>` is class 0, so
# `var G: W1<Pt> = mkw(gp)` was never refused (rc 139) — and also run by the declaration-zone
# replay (`_gvi_expr`), which never reached it at all: a `var G: Pt = mkp(2);` before the first
# top-level statement compiled clean and SIGSEGV'd on `G.x`. CHANGELOG [6.6.11]
fn _refuse_toplevel_pair_init(S, pscale, ti): i64 {
    if (pscale >= 0) { return 0; }
    if (_gcall_open(S, ti) < 0) { return 0; }
    if (_call_dotted(S, ti) == 1) { return 0; }   # 6.6.12: `_call_field` refuses a field of it
    if (_call_ends_at(S, ti, 5) == 0) { return 0; }   # 6.7.6: a left operand refuses itself
    var fi = _gen_resolve_call(S, ti);
    if (fi < 0) { return 0; }
    if (_grc_err < 0) { return 0; }   # a failed instantiation: the call refuses itself, once
    if (_ret_agg_class(S, fi) != 1) { return 0; }
    if (GFRS(S, fi) != 0 - pscale) { return 0; }
    _refuse_toplevel_struct_call(S, TOKVAL(S, ti));
    return 0;
}

# `h(p2(..))` at top level, `h` taking the struct by address and `p2` returning it in rax:rdx —
# or (6.6.20) a struct of 8 B or less in rax: there is no frame to put the result in, so refuse
# it by name. Always returns 0 — the argument is then pushed by the ordinary path, and
# `_had_error` keeps the binary from being written.
fn _refuse_toplevel_struct_arg(S): i64 {
    var c = _arg_call_class(S);   # 6.6.10: the instance's class
    if (c != 1) { if (c != 3) { return 0; } }
    if (_call_is_whole_arg(S, _gcall_open(S, GTI(S)) - 1) == 0) { return 0; }
    _refuse_toplevel_struct_call(S, PEEKV(S));
    return 0;
}

# ⛔ 6.6.20 — the class of the struct the call at the cursor (`name(` / `name<..>(`) returns, for
# an address-passed parameter: `_ret_agg_class`'s 2 / 1, or 3 for a struct of 8 B or less, which
# comes back in rax. That class was 0 here and its value was pushed: harmless while only a struct
# over 8 B was address-passed (a smaller result cannot be one), fatal once a `p: *S` parameter of
# any size is — `rd1(mk())` with `p: *S1` SIGSEGV'd where `rd3(mk3())` took its temp's address.
fn _arg_call_class(S): i64 {
    var fi = _gen_resolve_call(S, GTI(S));
    var c = _ret_agg_class(S, fi);
    if (c != 0) { return c; }
    if (_ret_small_struct(S, fi) == 1) { return 3; }
    return 0;
}
# 1 = fn `fi` returns a struct of 8 B or less (by value, in rax).
fn _ret_small_struct(S, fi): i64 {
    if (fi < 0) { return 0; }
    var sid = GFRS(S, fi);
    if (sid <= 0) { return 0; }
    if (STRUCTSZ(S, sid - 1) > 8) { return 0; }
    return 1;
}

# ⭐ 6.6.6 (bite 14 review) — A METHOD CALL OR AN OVERLOADED OPERATOR RETURNING A STRUCT BY
# VALUE. 14c gave every FREE-fn call a destination and missed the two paths that emit their own
# call: `var r: P3 = b.mk(2)`, `b.mk(3);`, `r = b.mk(5)` and `var c: V3 = a + b` SIGSEGV'd on
# x86, aarch64 and Win64 (the callee took `self` / the lhs address as its retptr), and
# `q = b.mp(3)` (rax:rdx) kept rax only. The emitter brackets its call with three hooks:
#   _sc_pre   before its first push: a temp — always for a >16 B result in a fn, for a 9-16 B one
#             only when a destination asked (`beg == _sc_want`) — and on x86/cx the temp's
#             address as int arg 0 (`_sc_n0` = 1), before `self` / the lhs
#   _sc_x8    after ECALLPOPS: the temp's address in aarch64's X8
#   _sc_post  after the call: the rax:rdx store / the first word as the value, and the record
#             (`_sc_*` in parse.cyr) a destination matches with `_sc_whole`
# At top level there is no frame: a >16 B call is refused here; a 9-16 B one is recorded without
# a temp, and a destination that needs storage refuses it. CHANGELOG [6.6.6]
fn _sc_pre(S, fi, noff, beg): i64 {
    _sc_n0 = 0;
    if (_pe_vret(S, fi) == 1) {   # 6.7.12: a Win64 vector result's hidden pointer
        _sc_n0 = 1;
        if (beg == _sc_vbeg) { return _sc_vret(S); }   # 6.7.13 (D29): a vector receive's own destination
        return _pe_vtemp(S, fi);
    }
    var cls = _ret_agg_class(S, fi);
    if (cls == 0) { return 0 - 1; }
    if (GINFN(S) != 1) {
        if (cls == 2) { _refuse_toplevel_struct_call(S, noff); }
        return 0 - 1;
    }
    if (cls == 1) { if (beg != _sc_want) { return 0 - 1; } }
    var t = _agg_temp(S, GFRS(S, fi));
    if (cls == 2) { if (_AARCH64_BACKEND == 0) {
            EFLADDR(S, t);
            EPUSHR(S);
            _sc_n0 = 1;
        } }
    return t;
}

# 6.7.13 (D29) — a value-form vector receive of a METHOD call `x.m(..)` (`_vrcv_emit`, parse_decl.cyr) on PE: the
# method whose receiver is token `_sc_vbeg` (one-shot) takes the destination's address, slot `_sc_vdst`, as its
# hidden result pointer (int arg 0, before `self`) — `_icall_vret`'s shape. -1 (no temp: `_sc_post` reads nothing).
fn _sc_vret(S): i64 {
    _sc_vbeg = 0 - 1;
    EFLADDR(S, _sc_vdst);
    EPUSHR(S);
    return 0 - 1;
}
fn _sc_x8(S, fi, t): i64 {
    if (t < 0) { return 0; }
    if (_AARCH64_BACKEND != 1) { return 0; }
    if (_ret_agg_class(S, fi) == 2) { EFLADDR_X8(S, t); }
    return 0;
}

fn _sc_post(S, fi, noff, beg, t): i64 {
    if (_pe_vret(S, fi) == 1) { return _pe_vload(S, t); }   # 6.7.12
    var cls = _ret_agg_class(S, fi);
    if (cls == 0) { return _sc_post_small(S, fi, noff, beg); }
    if (t >= 0) {
        if (cls == 1) { EFLSTORE_STRUCT_INT_PAIR(S, t); }
        else { EFLLOAD(S, t); SESTYPE(S, 0); }
    } else {
        # A 9-16 B result nobody asked to store: rax:rdx as ever. 6.7.3: recorded with
        # `_sc_tmp` -4 ("in rax:rdx, no temp") for the argument type checks (`_sarg_byval_small`,
        # `_op_arg_check`). Every other `_sc_whole` consumer arms `_sc_want` at its own start, so
        # its whole expression has a temp and it never sees -4 — and `_op_is_sval` reads only -3.
        # CHANGELOG [6.7.3]
        if (GINFN(S) == 1) { t = 0 - 4; }
        elif (cls == 2) {                  # top level: `_sc_pre` already refused it
            _sc_rbeg = beg;
            _sc_rend = GTI(S);
            return 0;
        }
    }
    _sc_beg = beg;
    _sc_end = GTI(S);
    _sc_tmp = t;
    _sc_sid = GFRS(S, fi);
    _sc_fn = noff;
    _sc_fi = fi;
    _lsc_note(S, fi, beg, t);   # 6.7.6: for a left operand
    return 0;
}

# ⛔ 6.6.11 — A STRUCT RESULT OF 8 B OR LESS WAS NEVER RECORDED, so no destination could compare its
# type: `h.o = y.same()`, `z = y.same()`, `var z: Odd = y + y` stored an Od2 into an Odd silently
# (only the free-call FIELD form was refused). Recorded now with `_sc_tmp = -3`: "the value is in
# rax, there is no temp". Every `_sc_whole` consumer either type-checks it (`_fsc_expr`,
# `_pcmpe_struct_assign`, both var receives) or keeps ignoring it (-3 is neither -1 nor a slot).
# Str (16 B, a handle in rax) is not a <= 8 B struct and stays unrecorded. The scalar operator
# dispatch (parse_expr.cyr) calls this directly. CHANGELOG [6.6.11]
fn _sc_post_small(S, fi, noff, beg): i64 {
    if (fi < 0) { return 0; }
    var sid = GFRS(S, fi);
    if (_mv_callee_any(S, fi) == 1) { return _mrc_note(S, fi, noff, beg); }   # 6.7.7 (B4); 6.7.11: + a counted undeclared one; 6.7.14: a counted `: i64`
    if (sid <= 0) { return 0; }
    if (STRUCTSZ(S, sid - 1) > 8) { return 0; }
    _sc_beg = beg;
    _sc_end = GTI(S);
    _sc_tmp = 0 - 3;
    _sc_sid = sid;
    _sc_fn = noff;
    _sc_fi = fi;
    _lsc_note(S, fi, beg, 0 - 1);   # 6.7.6: for a left operand
    return 0;
}


# A struct-typed declaration (`pscale` = `0 - sid`) initialised from a recorded struct call of a
# different struct: refused (1). CHANGELOG [6.6.11]
fn _sc_decl_mismatch(S, pscale, sid): i64 {
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    if (pscale == 0 - sid) { return 0; }
    ERR_MSG(S, "fn return struct-id differs from declared var type", 50);
    return 1;
}

# ⛔ 6.6.11 — PARSE_VAR's initialiser arming, for a struct-typed declaration: the struct-typed
# FIELD source (`var p: Pt = b.v`, see `_fla_arm`) in a fn, and the type check of a whole free
# call returning a struct of 8 B or less (`var z: Odd = mkod2()`), which comes back in rax and so
# never reached the retptr / rax:rdx receives, the only ones that compared the sid. Returns the
# previous `_sc_want`, for `_scv_disarm`. CHANGELOG [6.6.11]
var _scv_pk = 0;     # 6.7.6: the parentheses `_scv_peel` stepped into, closed by `_scv_disarm`
var _scv_term = 5;   # ... and the token that ends the initialiser inside them (`)`), else `;`
# ⛔ 6.7.6 (FE) — declarations NEST: a closure body inside an initialiser or an operator operand
# (`var q: K = (mkk(fncall1(|x| { var y = x; return y; }, 2)));`, `s - mkv(fncall1(|x| { var y = x;
# return y; }, 4))`) runs PARSE_VAR inside the outer one. The inner arm zeroed `_scv_pk` / `_scv_term`
# and its disarm set `_sc_fcw` / `_fla_want` to -1, so the outer wrap never closed ("expected ';',
# got ')'") and the outer call recorded no temp (`_fnc_agg`): its first word was passed as its
# address, SIGSEGV. Each arm now saves the four on `_scv_vec` and its disarm restores them, as
# `_op_big_arm` / `_op_big_disarm` do; the returned word packs the previous `_sc_want` (low 32
# bits, + 1) and the save's depth (high), so a disarm reads its own save even after an unbalanced
# inner one. CHANGELOG [6.7.6]
var _scv_vec = 0;
# 6.7.9 — 1 = the initialiser the last `_scv_disarm` closed reported an error of its own (`_had_error`
# 0 at its arm, 1 at its disarm): its whole-result refusal (`_sc_global_pair`) would be a second
# report of a line already refused — `var G: Pt = mk2(3) + H;` (the left operand). A file with an
# earlier error cannot tell, and may report both.
var _scv_err = 0;
fn _scv_save(): i64 {
    if (_scv_vec == 0) { _scv_vec = vec_new(); }
    var d = vec_len(_scv_vec);
    vec_push(_scv_vec, _scv_pk);
    vec_push(_scv_vec, _scv_term);
    vec_push(_scv_vec, _sc_fcw);
    vec_push(_scv_vec, _fla_want);
    vec_push(_scv_vec, _had_error);
    vec_push(_scv_vec, _scv_un);
    vec_push(_scv_vec, _dvi_want);   # 6.7.14 (D36)
    return d;
}
fn _scv_restore(d): i64 {
    _scv_pk = vec_get(_scv_vec, d);
    _scv_term = vec_get(_scv_vec, d + 1);
    _sc_fcw = vec_get(_scv_vec, d + 2);
    _fla_want = vec_get(_scv_vec, d + 3);
    _scv_un = vec_get(_scv_vec, d + 5);
    _dvi_want = vec_get(_scv_vec, d + 6);
    vec_truncate(_scv_vec, d);
    return 0;
}
# `ext` != 0: a scalar / float / slice / bool annotation (`_sc_var_receive`'s), which takes the first word.
# ⛔ 6.7.11 — an UNTYPED declaration in a fn steps inside a whole wrap too, so `var c = (a + b);` and `var e =
# (a.m());` with a 9-16 B result take the temp as the unwrapped form does: `_sc_pre` makes one only for the
# destination's own start (`_sc_want`), and the wrap's `(` is not it, so c held the first word (`c.w`
# refused, `take(c)` passed the word as the struct's address) — the user's decision (a), 2026-10-13
# (issues/archived/2026-10-13-untyped-struct-binding-beyond-operators-decision.md). CHANGELOG [6.7.11]
fn _scv_arm(S, pscale, ext): i64 {
    var d = _scv_save();
    _scv_top_ann(S, pscale);   # 6.7.12 (D28): `var n: i64 = fncall1(&mk3, 5);`; 6.7.13: + top level
    _scv_pk = 0;
    _scv_term = 5;
    if (pscale < 0) { if (pscale > 0 - 2048) {
            if (GINFN(S) == 1) { _scv_peel(S); }   # 6.7.6
            _scv_call_check(S, pscale);
            if (GINFN(S) == 1) { _fla_arm(GTI(S), pscale); }
        } }
    _scv_un = 0 - 1;
    _dvi_want = 0 - 1;
    if (pscale == 0) { if (ext == 0) { if (GINFN(S) == 1) {
                _scv_un_peel(S);
                _dvi_arm(S);   # 6.7.14 (D36): `var v = *p;`
            } } }
    var w = _sc_arm(S);
    return (w + 1) | (d << 32);
}
# The untyped peel. A whole DYN result inside it keeps its refusal (6.7.8 V4d: `var x = (pass(o));`,
# `(o.me())`): `_scv_un` (parse.cyr), the token it stepped to, is not a destination for V4's exemption
# (`_dyn_want`).
fn _scv_un_peel(S): i64 {
    _scv_peel(S);
    if (_scv_pk > 0) { _scv_un = GTI(S); }
    return 0;
}
fn _scv_disarm(S, w): i64 {
    _sc_want = (w & 0xFFFFFFFF) - 1;
    if (_scv_pk > 0) { _pw_close(S, _scv_pk); }   # 6.7.6: the wrap `_scv_peel` stepped into
    _scv_err = 0;
    if (vec_get(_scv_vec, (w >> 32) + 4) == 0) { _scv_err = _had_error; }   # 6.7.9
    _scv_restore(w >> 32);
    return 0;
}
# ⛔ 6.7.6 — `var q: K = (z.k);`, `= (j.dup())`, `= (a + b)`, `= (mk(4))` in a fn: the initialiser
# wrapped in parentheses (`_pwrap_k`) was an expression whose value is the struct's first word, so q
# was a POINTER-mode K holding it and `q.a` dereferenced a value: SIGSEGV. The declaration steps
# inside the wrap before it arms, so the field source, the method / operator temp and (through
# `_sc_fcw`, read by PARSE_FNCALL's `_fnc_agg`) a free call's temp are taken exactly as for the
# unwrapped initialiser; `_scv_disarm` closes the wrap, and `_sc_whole` sees through it. A name
# (`= (j)`) is `_try_struct_copy_init`'s. CHANGELOG [6.7.6]
fn _scv_peel(S): i64 {
    if (PEEKT(S) != 10) { return 0; }
    if (_tup_lit_at(S, GTI(S)) >= 0) { return 0; }   # 6.7.7: a tuple literal is not a wrap
    var k = _pwrap_k(S, GTI(S));
    if (TOKTYP(S, _pw_end) != 5) { return 0; }
    STI(S, GTI(S) + k);
    _scv_pk = k;
    _scv_term = 11;
    _sc_fcw = GTI(S);
    return 0;
}
fn _scv_call_check(S, pscale): i64 {
    var o = _gcall_open(S, GTI(S));
    if (o < 0) { return 0; }
    if (_call_follow(S, o - 1) != _scv_term) { return 0; }
    var fi = _gen_resolve_call(S, GTI(S));
    if (fi < 0) { return 0; }
    if (_grc_err < 0) { return 0; }   # a failed instantiation: the call refuses itself, once
    var rs = GFRS(S, fi);
    if (rs <= 0) { return 0; }
    if (STRUCTSZ(S, rs - 1) > 8) {
        # In a fn the retptr / rax:rdx receives compare the sid; at top level there are none, so
        # a 9-16 B result is checked here (a >16 B one refuses itself: no frame). CHANGELOG [6.6.11]
        if (GINFN(S) == 1) { return 0; }
        if (_ret_agg_class(S, fi) != 1) { return 0; }
    }
    _sc_decl_mismatch(S, pscale, rs);
    return 0;
}

# The destination half. Arm before parsing the expression at the cursor; the previous want is
# returned for the caller to restore right after the parse, since a nested destination re-arms.
fn _sc_arm(S): i64 {
    var w = _sc_want;
    _sc_want = GTI(S);
    _sc_beg = 0 - 1;
    return w;
}

# After parsing from `start`: the temp holding the WHOLE expression's struct result; -1 when the
# whole expression is such a call at top level (no temp); -2 when it is not one — a struct call
# inside a larger expression (`b.mk(1).x`, `k + a * b`) does not span it, so it never matches.
fn _sc_whole(S, start): i64 {
    if (_sc_beg != start) {
        if (_sc_pwrap(S, start) == 1) { return _sc_tmp; }   # 6.7.6
        return 0 - 2;
    }
    if (_sc_end != GTI(S)) { return 0 - 2; }
    return _sc_tmp;
}
# 6.7.6 — the record spans the expression inside parentheses that wrap the whole of it: `start`
# opens `k` `(` that end where the record begins, and `k` `)` follow the record up to the cursor
# (`x = (p.dup())`, `var q: P = (a + b)`). The parser consumed them as nested parenthesised
# factors, so they are balanced. CHANGELOG [6.7.6]
fn _sc_pwrap(S, start): i64 {
    if (_sc_beg <= start) { return 0; }
    var k = _sc_beg - start;
    if (_sc_end + k != GTI(S)) { return 0; }
    var i = 0;
    while (i < k) {
        if (TOKTYP(S, start + i) != 10) { return 0; }
        if (TOKTYP(S, _sc_end + i) != 11) { return 0; }
        i = i + 1;
    }
    return 1;
}

# `var p: S = <expr>` / `var p = <expr>` in a fn, <expr> one whole method/operator call returning
# S: the temp BECOMES `p` — named in place, the same inline aggregate `var p: S = f(..)` makes (and,
# untyped, the same inference). `ext` != 0 = a scalar/float/slice annotation: the first word, as
# ever. Returns 1 when `p` is declared. CHANGELOG [6.6.6]
fn _sc_var_receive(S, noff, pscale, ext, start): i64 {
    if (_scv_refd == start) { return 0; }   # 6.7.13 (D13): refused by `_scv_rec_ann`; the annotation stands
    if (_dvi_take(S, noff, pscale, ext, start) == 1) { return 1; }   # 6.7.14 (D36): `var v = *p;`, p a `*V`
    if (_scv_dyn_chk(S, pscale, ext, start) == 1) { return 0; }   # 6.7.8
    if (_fla_hit == 1) { return _fla_var_receive(S, noff, pscale); }   # 6.6.11: `var p: S = b.v`
    if (_fls_whole(S, start) == 1) { _fls_type_err(S, pscale, noff); return 0; }   # 6.7.6: a `Str` field
    var t = _sc_whole(S, start);
    if (t == 0 - 3) { _sc_decl_mismatch(S, pscale, _sc_sid); return 0; }   # 6.6.11: <= 8 B, in rax
    if (t < 0) { return 0; }
    if (pscale == 0) {
        if (ext != 0) { return 0; }
    } elif (_sc_decl_mismatch(S, pscale, _sc_sid) == 1) {
        return 0;
    } elif (pscale != 0 - _sc_sid) {
        return 0;
    }
    S64(S + 0x5D9D000 + t * 8, noff);
    SSLICE_W(S, t, 0);
    return 1;
}

# ⛔ 6.7.14 (D36 A, the user's decision, 2026-10-16) — AN UNTYPED `var v = *p;` WITH `p: *V` DECLARES A `V` LOCAL COPIED
# THROUGH p, as `var v = mkv(..)` binds the vector (v6.5.61), `var v = callptr(&f, ..)` too (6.7.13's D29), and `var v:
# V = *p;` copies (6.7.13's D34). It bound ONE word, lane 0 (the filed repro: x86_64 114, IR=3 226, aarch64 26, cx 98,
# PE 146 where 161 is right), silently. E's type is known only once it is parsed, so the declaration's scalar path runs
# as ever: when the whole initialiser, inside any parentheses (`_scv_un_peel` stepped in), is one dereference `* E`
# (`_vrcv_dsrc`), its `*` is watched (`_dvi_arm`); E naming a value-form vector, `_deref_read` parks the pointer
# (`_dvi_park`, parse_expr.cyr) and the declaration takes it here (`_dvi_take`): the local is that vector, its 16 / 32
# bytes copied through the pointer. A `*p` of no vector binds the word as before — nothing parks, its code unchanged.
# CHANGELOG [6.7.14]
fn _dvi_arm(S): i64 {
    if (PEEKT(S) != 8) { return 0; }
    if (_vrcv_dsrc(S, GTI(S), _scv_term) != 4) { return 0; }
    if (_vrcv_k != 0) { return 0; }
    _dvi_want = GTI(S);
    return 0;
}
# After the untyped initialiser [start, cursor): 1 = it was the watched `*E` whose pointer `_dvi_park` parked, nothing
# emitted since (`_dlo_cp`) — `noff` declared that vector, copied through it.
fn _dvi_take(S, noff, pscale, ext, start): i64 {
    if (pscale != 0) { return 0; }
    if (ext != 0) { return 0; }
    var d = _dvi_got;
    if (d < start) { return 0; }
    if (_dlo_beg != d) { return 0; }
    if (_dlo_cp != GCP(S)) { return 0; }
    if (_dlo_end + d - start != GTI(S)) { return 0; }
    _dvi_got = 0 - 1;
    var ty = 0 - _dlo_sid;
    _vec_desc(S, ty);
    var n = GVEC_NSLOTS(S);
    var named = _sci_slots(S, noff, ty, n);
    _agc_copy_bytes(S, named, 0 - 1, _AGC_DREF(_dlo_h), 0 - 1, n * 8);
    return 1;
}
# 6.7.8 (review) — a declaration's whole dyn initialiser (`_dyn_dst_chk`, parse_expr.cyr): in a fn an
# untyped one infers the dyn (a copy) and a struct annotation is `_sc_decl_mismatch`'s; any other
# annotation (`: i64`, `: *Sq`, `: f64`, a vector — `ext` a scalar / float / slice / bool one) is
# refused. 1 = refused.
fn _scv_dyn_chk(S, pscale, ext, start): i64 {
    if (pscale == 0) { if (ext == 0) { return 0; } }
    if (pscale < 0) { if (pscale > 0 - 2048) { return 0; } }
    return _dyn_dst_chk(S, start, 0);
}

# `var G: S = <expr>` at top level: no frame, so a 9-16 B method/operator result is refused by name
# (a >16 B one already was, in `_sc_pre`). Untyped `var g = ..` keeps the first word — 6.7.8: never a
# dyn's, which is refused whatever the annotation (a dyn global's own is `_dyn_var`'s).
fn _sc_global_receive(S, pscale, start): i64 {
    if (pscale >= 0 || pscale <= 0 - 2048) { if (_dyn_dst_chk(S, start, 0) == 1) { return 0; } }
    if (pscale <= 0 - 2048) { return _vecg_rhs_ok(S, start); }   # 6.6.17 (a3): a vector global
    return _sc_global_pair(S, pscale, start);
}
# ⛔ 6.7.9 — the struct half, shared with the declaration zone's replay (`_gvi_expr`), which ran only
# `_sc_global_mismatch`: `var G2: Q = Q0.mk();` before the first statement (a 9-16 B method, a generic
# method, `(Q0.mk())`, an operator `Q0 + Q1`) stored rax — the struct's first WORD — as the address of
# the inline G2, and the first `G2.a` SIGSEGV'd. Now refused by name there too — once in either place:
# a line refused inside its initialiser (`_scv_err`: an operand, an argument) is not refused again
# for its result. CHANGELOG [6.7.9]
fn _sc_global_pair(S, pscale, start): i64 {
    if (_sc_global_mismatch(S, pscale, start) != 0) { return 0; }
    if (_scv_err == 1) { return 0; }   # refused inside its initialiser: that refusal alone (6.7.9)
    if (_sc_whole(S, start) != 0 - 1) { return 0; }
    if (pscale != 0 - _sc_sid) { return 0; }
    _refuse_toplevel_struct_call(S, _sc_fn);
    return 0;
}

# 6.6.17 (a3): a vector global declared after the first statement takes only `= 0;` (see
# `_vecg_size`, parse_decl.cyr). `start` is the initializer's first token, after
# `var NAME : VEC =` (a vector type is one token, so the name is 4 back).
fn _vecg_rhs_ok(S, start): i64 {
    var v = _CF_TRY(S, start, 5);
    var has = 0;
    if (_cf_ok == 1) { has = 1; }
    _vecg_init_ok(S, has, v, TOKVAL(S, start - 4));
    return 0;
}

# 6.7.6 — `var G: Q = H.name;` (a `: Str` field) into a struct global of another type: refused by
# name, as in a fn (`_fls_type_err`). The declared name is not at hand here, so it is not named.
fn _fls_global_err(S, pscale): i64 {
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    if (pscale == 0 - _fls_sid) { return 0; }
    ERR_IDENT(S, "cannot copy ", _fls_name, " (a Str field) into a global of a different struct type", 0 - 1);
    return 1;
}
# A top-level struct-typed destination given a whole method/operator result of another struct —
# <= 8 B (-3, in rax) or 9-16 B (-1, no frame) — refused by name (1). CHANGELOG [6.6.11]
fn _sc_global_mismatch(S, pscale, start): i64 {
    if (_fls_whole(S, start) == 1) { return _fls_global_err(S, pscale); }   # 6.7.6: a `Str` field
    var t = _sc_whole(S, start);
    if (t != 0 - 3) { if (t != 0 - 1) { return 0; } }
    if (pscale >= 0) { return 0; }
    if (pscale == 0 - _sc_sid) { return 0; }
    return _sc_decl_mismatch(S, pscale, _sc_sid);
}

# A by-value struct parameter given an expression that is neither a bare name nor a free-fn call
# (those have their own arms in `_try_push_struct_addr_arg`): when it is one whole method/operator
# call returning a struct, the callee gets the temp's ADDRESS — the result's storage — where it
# used to get the first word. Anything else pushes the value, which is exactly what the caller's
# own PCMPE + EPUSHR would push. Returns 1: the argument is consumed. CHANGELOG [6.6.6]
# ⛔ 6.6.12 — A STRUCT-TYPED FIELD AS THE WHOLE ARGUMENT (`take(r.v)`) PUSHED ITS FIRST WORD, and
# the callee dereferenced that word as the struct's address: SIGSEGV on x86 and aarch64, a page
# fault on PE, 0 on cx — from a local, global, by-value parameter or pointer-mode base alike, and
# through a generic instance. The whole-field record (`_fla_want` / `_fla_take`) is armed here
# too, ending at `,` or `)`; see `_fla_push_arg`. CHANGELOG [6.6.12]
fn _push_struct_expr_arg(S, fi, argc, tail): i64 {
    var st = GTI(S);
    var w = _sc_arm(S);
    var fw = _fla_want;
    var fa = _fla_arg;
    _fla_want = st;
    _fla_arg = st;
    _fla_hit = 0;
    PCMPE(S);
    _sc_want = w;
    _fla_want = fw;
    _fla_arg = fa;
    if (_fla_hit == 1) { return _fla_push_arg(S, fi, argc, tail); }
    if (_dro_want == st) { if (_dro_take(S, st) == 1) {   # ops-5: a whole dereference (`_sarg_deref`)
            _dro_check(S, fi, argc);
            _HTLOAD(S, _dlo_h);
            EPUSHR(S);
            return 1;
        } }
    _tup_arg_mrc(S, fi, argc, st);   # 6.7.7 (B4): `g(x.f())`, f multi-value
    _mv_arg_mrc(S, fi, argc, st);    # 6.7.11: ... into a named struct
    var t = _sc_whole(S, st);
    if (t >= 0 || t == 0 - 3) { _sarg_type_errf(S, fi, argc, _sc_sid, _sc_fn, _sc_fi); }   # 6.7.3; 6.7.14: `S2.dup`
    if (t == 0 - 2) { if (_fls_whole(S, st) == 1) { _sarg_type_err(S, fi, argc, _fls_sid, _fls_name); } }   # 6.7.6
    if (t == 0 - 3) { t = _sc_small_temp(S); }   # 6.6.20
    if (t >= 0) { _sarg_escapes(fi, argc, tail); EFLADDR(S, t); }   # 6.6.20: a temp in this frame
    if (t == 0 - 1) { _refuse_toplevel_struct_call(S, _sc_fn); }
    EPUSHR(S);
    return 1;
}

# ⛔ 6.6.20 — a whole method / operator result of 8 B or less (`_sc_whole` -3: the value is in rax,
# no temp) given to an address-passed parameter: stored into a frame temp, whose slot is returned
# for the caller to push the ADDRESS of. Its value was pushed, which only a `p: *S` parameter of
# 8 B or less can receive — `rd1(s.dup())` SIGSEGV'd where `rd3(a.dup())` worked. At top level
# there is no frame: refused by name (-2, the value is pushed and no binary is written).
fn _sc_small_temp(S): i64 {
    if (GINFN(S) != 1) {
        _refuse_toplevel_struct_call(S, _sc_fn);
        return 0 - 2;
    }
    var t = _agg_temp(S, _sc_sid);
    EFLSTORE(S, t);
    return t;
}

# The recorded field source as by-value argument `argc` of `fn`: checked against the parameter's
# struct (SFPSID — the instance's for a generic) and refused by name when it differs. The field's
# own ADDRESS is passed, in a fn and at top level alike, as a named argument's is: the callee
# copies it in its prologue (`_sptr_params_localize`), so a write through its parameter cannot
# reach the caller's field — the by-value contract. 6.6.12 copied it into a caller frame temp
# here instead, which had no frame to use at top level (there the callee got the field itself);
# with the callee's copy that temp was a second copy. Returns 1. CHANGELOG [6.6.12] [6.6.16]
fn _fla_push_arg(S, fi, argc, tail): i64 {
    _fla_addr(S, fi, argc, tail);
    EPUSHR(S);           # on a refusal it keeps the argument count; no binary is written
    return 1;
}
# rax = the recorded field's address, as by-value / `*S` argument `argc` of `fi` (refused by name
# when the parameter's struct differs). Shared with an operator's right operand (`_op_rhs`, `tail`
# 0). A field of an inline aggregate in this frame is an address in it (`_sarg_escapes`).
# ⛔ 6.7.14 (D34 A, the user's decision, 2026-10-16) — a struct-typed FIELD into a `*V` parameter is refused by name, as
# 6.7.13's D33 refuses the struct from a local, a call, `*ps`, a global or a capture: `rd(w.s)` (`s: Pt`, `p: *f64v2`)
# passed the field's address and the callee read its bytes as the vector (42 on every target). A `*V` records no struct
# (GFPSID), so the check above compared nothing; `_sarg_svec_err` answers 0 for any other parameter. CHANGELOG [6.7.14]
fn _fla_addr(S, fi, argc, tail): i64 {
    _fla_hit = 0;
    var ps = GFPSID(S, fi, argc);
    if (ps > 0) { if (ps != _fla_ft) {
            ERR_IDENT(S, "cannot pass ", _fla_name, " to a parameter of a different struct type in a call to ", _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
            return 0;
        } }
    elif (_sarg_svec_err(S, fi, argc, _fla_name, 0 - 1) == 1) { return 0; }
    if (_fsc_src_in_frame(S) == 1) { _sarg_escapes(fi, argc, tail); }   # 6.6.20
    _fsc_src_x1(S, 0);
    EMOVI(S, 0);
    EADDR(S);            # rax = x1
    return 0;
}

# ⛔ 6.7.6 — A STRUCT RESULT OVER 8 B AS THE RIGHT OPERAND OF AN ADDRESS-PASSED PARAMETER: `s - mk3(4)`
# (`fn P3_sub(a: *P3, b: *P3)`, a retptr result), `p + p.dup()` (`fn Pt_add(a: Pt, b: Pt)`, a rax:rdx
# method result), by-value or `*S`, bare or in parentheses, SIGSEGV'd: the operand's VALUE — its
# first word — was pushed where the operator fn takes its address, because a free call's temp was
# never recorded and a 9-16 B method / operator result got no temp at all unless a destination
# asked. The operand now asks, as a destination does: `_sc_want` (the method / operator temp) and
# `_sc_fcw` (a free call's, `_fnc_agg`) name its first token inside any wrap, and a record that
# spans the whole operand passes the temp's address. At top level there is no frame: refused by
# name. The previous want / fcw are returned packed for `_op_big_disarm` (operands nest).
# CHANGELOG [6.7.6]
var _obt_enc = 0 - 1;   # `_op_big_take`'s operand encoding, for `_OP_OPERAND_ADDR`
fn _op_big_arm(S, rb): i64 {
    var saved = (_sc_want + 1) | ((_sc_fcw + 1) << 32);
    var b = rb + _pwrap_k(S, rb);
    _sc_want = b;
    _sc_fcw = b;
    _sc_beg = 0 - 1;   # only this operand's own record may match
    return saved;
}
fn _op_big_disarm(saved): i64 {
    _sc_want = (saved & 0xFFFFFFFF) - 1;
    _sc_fcw = ((saved >> 32) & 0xFFFFFFFF) - 1;
    return 0;
}
# After the operand [rb, cursor) of operator fn `fi` is parsed: 1 = it is one whole struct result
# (`_obt_enc` = its temp, or -1 after a top-level refusal); 0 = anything else, classified as before.
fn _op_big_take(S, fi, rb): i64 {
    var t = _sc_whole(S, rb);
    if (t >= 0) {
        _op_arg_check(S, fi, rb);
        _obt_enc = 0 - 2 - t;   # a frame temp: `_op_operand_local` passes `&t` (and notes the escape)
        return 1;
    }
    if (t == 0 - 1) {
        _op_arg_check(S, fi, rb);
        _obt_enc = _refuse_toplevel_op_operand(S, fi, 1);
        return 1;
    }
    if (GINFN(S) == 1) { return 0; }
    if (_op_rhs_pair_call(S, rb) == 0) { return 0; }
    _obt_enc = _refuse_toplevel_op_operand(S, fi, 1);
    return 1;
}
# 1 = the operand [rb, cursor) is one whole free call (inside any wrap) returning a 9-16 B struct in
# rax:rdx — at top level it has no temp to pass the address of. A retptr one refuses itself.
fn _op_rhs_pair_call(S, rb): i64 {
    var k = _pwrap_k(S, rb);
    var c = rb + k;
    var o = _gcall_open(S, c);
    if (o < 0) { return 0; }
    if (_call_close(S, o) + 1 + k != GTI(S)) { return 0; }
    if (_ret_agg_class(S, _gen_resolve_call(S, c)) != 1) { return 0; }
    return 1;
}

# ⛔ 6.6.20 — THE RIGHT OPERAND OF AN OVERLOADED OPERATOR, parsed (PARSE_TERM) and classified for
# operand 1 of fn `fi`, the way `_try_push_struct_addr_arg` classifies a call argument. Returns its
# encoding for `_OP_OPERAND_ADDR` (-1 = the value in rax, pushed as it is). For an ADDRESS-passed
# operand (a `*S` at any size, a by-value struct over 8 B):
#   - a whole struct-typed FIELD (`b - h.p`, `w2 - h.w`, `(h.p)`) passes the field's own address,
#     as `take(h.p)` does — its first word was pushed and dereferenced: SIGSEGV for `*P3` and
#     by-value `P3` (6.6.16 through 6.6.19), and for `*W` a copy that lost a write through it;
#   - for a `*S` of 8 B or less, a whole free call returning such a struct (`s - mk1(4)`, class 3)
#     is a struct VALUE (`_op_call_end`, decided before the parse as the call path decides it), as
#     is a method / operator result (`_sc_beg` is cleared so only this operand's record matches);
#   - (ops-5) a whole dereference of a `*S` (`a + *p`, `(*p)`, `*gp()`) passes its pointer, as `a + p`
#     does — it passed the word the dereference read (`_dro_want`, `_dro_take`; see `_sarg_deref`);
#     `_op_operand_sv` decides the rest.
fn _op_rhs(S, fi): i64 {
    var rb = GTI(S);
    var arm = 0;
    if (fi >= 0) { arm = _pm_struct(fi, 1); }
    var fw = _fla_want;
    var fo = _fla_opd;
    var fp = _fla_opdp;
    var dw = _dro_want;
    var ce = 0 - 1;
    var big = 0 - 1;
    if (arm == 1) {
        _fla_want = rb;
        _fla_opd = rb;
        if (TOKTYP(S, rb) == 10) { _fla_want = rb + 1; _fla_opdp = rb + 1; }
        _fla_hit = 0;
        _dro_want = rb + _pwrap_k(S, rb);   # ops-5: a dereference there is parked
        if (_op_small_ptr(S, fi, 1) == 1) { _sc_beg = 0 - 1; ce = _op_call_end_p(S, rb); }
        else { big = _op_big_arm(S, rb); }   # 6.7.6: a struct over 8 B
    }
    PARSE_TERM(S);
    _dro_want = dw;
    var rps = GPSC(S);   # 6.7.10 (B7-1b): the operand's pointer step, for `_hl_byval_arg`
    if (big >= 0) { _op_big_disarm(big); }
    _bx_op_rhs(S, fi, rb);   # 6.7.3: an operator fn's bool parameter 1
    if (arm == 1) {
        _fla_want = fw;
        _fla_opd = fo;
        _fla_opdp = fp;
        if (_fla_hit == 1) { _fla_addr(S, fi, 1, 0); return 0 - 1; }
        if (_dro_take(S, rb) == 1) {   # ops-5: a whole dereference — its pointer (`_opd_operand`)
            _dro_check(S, fi, 1);
            _opd_k = 2;
            return _OPD_SV;
        }
    }
    if (big >= 0) { if (_op_big_take(S, fi, rb) == 1) { return _obt_enc; } }   # 6.7.6
    var sv = 1;
    if (GTI(S) != ce) { sv = _op_is_sval(S, rb, GTI(S)); }
    _op_arg_check(S, fi, rb);   # 6.7.3
    # 6.7.10 (B7-1): a HANDLE of 8 B or less into a by-value parameter passes its struct (`b + a`);
    # (B7-1b) a typed pointer or `&s` passes the struct it points at (`b + sp`, `b + &s`).
    if (_hl_byval(S, fi, 1) == 1) { if (_hl_byval_arg(S, fi, 1, rb, rps) == 1) { return 0 - 1; } }
    return _op_operand_sv(S, fi, 1, GESVAR(S), _op_bare(S, rb, GTI(S)), sv);
}
# ⛔ 6.7.3 — the right operand [rb, cursor) of operator fn `fi`, already parsed, is ARGUMENT 1 of
# that fn: its static struct against parameter 1's (`_sarg_type_err`) — a bare name (`p`, `(p)`),
# a whole method / operator result, or a whole free call (resolved after the parse: a dedup hit).
# `q + p` with `fn Q_add(a: Q, b: Q)` read past p (1) and `q + mkp()` SIGSEGV'd. A whole field is
# `_fla_addr`'s (address-passed operand, 6.6.20). Emits nothing. CHANGELOG [6.7.3]
fn _op_arg_check(S, fi, rb): i64 {
    if (fi < 0) { return 0; }
    if (GFPSID(S, fi, 1) <= 0) { return 0; }
    var e = GTI(S);
    var asid = 0;
    var nm = 0;
    var afi = 0 - 1;
    if (_op_bare(S, rb, e) == 1) {
        var nt = rb;
        if (e == rb + 3) { nt = rb + 1; }
        asid = _sarg_name_sid(S, nt);
        nm = TOKVAL(S, nt);
    } elif (_sc_whole(S, rb) != 0 - 2) {
        asid = _sc_sid;
        nm = _sc_fn;
        afi = _sc_fi;   # 6.7.14: named `S2.dup`
    } elif (_fls_whole(S, rb) == 1) {   # 6.7.6: a `Str` field
        asid = _fls_sid;
        nm = _fls_name;
    } elif (TOKTYP(S, rb) == 2) {
        var o = _gcall_open(S, rb);
        if (o >= 0) { if (_call_close(S, o) + 1 == e) {
                asid = _sarg_call_rs(S, rb);
                nm = TOKVAL(S, rb);
            } }
    }
    return _sarg_type_errf(S, fi, 1, asid, nm, afi);
}
# The token after a whole free call `name(..)` / `name<..>(..)` at the cursor that returns a struct
# of 8 B or less (`_arg_call_class` 3), or -1.
fn _op_call_end(S): i64 {
    var o = _gcall_open(S, GTI(S));
    if (o < 0) { return 0 - 1; }
    if (_call_dotted(S, GTI(S)) == 1) { return 0 - 1; }
    if (_arg_call_class(S) != 3) { return 0 - 1; }
    return _call_close(S, o) + 1;
}
# ... or the token after `(name(..))`, the same call alone in one pair of parentheses, as `(s)`,
# `(t.dup())` and `(h.p)` are taken: `s - (mk1(4))` handed the struct's WORD to a `*S1` operand
# (SIGSEGV) and compiled clean at top level. The `)` after the call closes the `(` at `rb`.
fn _op_call_end_p(S, rb): i64 {
    var ce = _op_call_end(S);
    if (ce >= 0) { return ce; }
    if (TOKTYP(S, rb) != 10) { return 0 - 1; }
    STI(S, rb + 1);
    ce = _op_call_end(S);
    STI(S, rb);
    if (ce < 0) { return 0 - 1; }
    if (TOKTYP(S, ce) != 11) { return 0 - 1; }
    return ce + 1;
}
# 1 = token type `t` continues a TERM after a factor (PARSE_TERM's loop and its postfix `?`), or
# continues the factor itself (`.`, `[`, `(`) — so a field just loaded is not the whole operand.
fn _op_term_cont(t): i64 {
    if (t == 8 || t == 119 || t == 9 || t == 34) { return 1; }
    if (t == 38 || t == 39 || t == 152 || t == 120 || t == 121) { return 1; }
    if (t == 124 || t == 41 || t == 28 || t == 10) { return 1; }
    return 0;
}

# `return s.m(..);` / `return a + b;` in a >16 B struct-returning fn, the call returning this same
# struct: its temp, which PARSE_RETURN copies into our retptr like `return IDENT;`. -1 when the
# expression is neither a method call nor an operator expression (cursor untouched). When it is
# one but not that shape: the struct-return diagnostic, and a junk slot 0 (cursor at `;`, the
# binary is never written). CHANGELOG [6.6.6]
fn _return_struct_expr(S): i64 {
    if (_ret_expr_head(S) == 0) { return 0 - 1; }
    var st = GTI(S);
    var w = _sc_arm(S);
    PCMPE(S);
    _sc_want = w;
    var t = _sc_whole(S, st);
    if (t >= 0) { if (_sc_sid == _cur_fn_ret_sid) { return t; } }
    ERR_MSG(S, "struct-return fn: return must be a bare local identifier, or a call to a fn returning the same struct", 101);
    return 0;
}

# ⛔ 6.6.6 (bite 14 review) — A 9-16 BYTE STRUCT RETURN (rax:rdx) ACCEPTED ANY EXPRESSION. The
# pair branch in PARSE_RETURN handled `return IDENT;` for a matching local and FELL THROUGH to
# the scalar PCMPE path for everything else — so `fn pr(): P2 { return s2(1,2); }` (s2 returns a
# 24 B P3 through a retptr) and `fn p5(): P2 { return 5; }` both compiled clean and handed back
# garbage: rax held whatever the expression left there and rdx was never written at all. The
# retptr sibling has always error'd on a shape it cannot carry; this class never did.
# These three say what the pair ABI CAN carry. `_pair_ret_call_ok` is a call to a fn returning
# the same struct in the same two registers (a pure rax:rdx passthrough — no copy needed);
# `_pair_ret_expr_shape` is the method / overloaded-operator token shape, which `_sc_pre` /
# `_sc_post` land in a frame temp for the pair load. Anything else is refused BY NAME.
# CHANGELOG [6.6.6]
fn _pair_ret_call_ok(S): i64 {
    if (_gcall_open(S, GTI(S)) < 0) { return 0; }   # 6.6.10: `name(` or `name<..>(`
    if (_call_dotted(S, GTI(S)) == 1) { return 0; }   # 6.6.12: a field of the result
    # 6.7.11: the call must END the value: `return mk2(1) == p;` (any operator that does not dispatch,
    # `_ret_expr_head`'s) left rax the comparison and rdx mk2's stale word. CHANGELOG [6.7.11]
    if (_call_ends_at(S, GTI(S), _ret_term) == 0) { return 0; }
    # 6.6.10 (bite 7 review): the fn the call REACHES — `return mkw(p);` from a `: W1<Pt>` fn was
    # compared against the base's 8 B `W1` and refused (6.6.9 compiled it).
    var fi = _gen_resolve_call(S, GTI(S));
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != _cur_fn_ret_sid) { return 0; }
    if (_ret_agg_class(S, fi) != 1) { return 0; }
    return 1;
}
fn _pair_ret_expr_shape(S): i64 {
    return _ret_expr_head(S);
}
# The method / overloaded-operator shape at the cursor: `x.m(`, `x OP`, and (6.7.6) a call or a
# parenthesised operand that is an operator's LEFT operand, `f(..) OP`, `(x) OP` — a call's result
# now dispatches (`_op_lst`); a wrap around the WHOLE value was peeled first (`_ret_peel`).
fn _ret_expr_head(S): i64 {
    if (_icall_ret(S) == 1) { return 1; }   # 6.7.11
    if (PEEKT(S) == 10) {
        _pwrap_k(S, GTI(S));
        return _is_op_dispatch_tok(TOKTYP(S, _pw_end));
    }
    if (PEEKT(S) == 8) { return _ret_lopd(S, GTI(S)); }   # 6.7.10: `*p OP`
    if (PEEKT(S) != 2) { return 0; }
    var nx = TOKTYP(S, GTI(S) + 1);
    if (nx == 41) {
        if (TOKTYP(S, GTI(S) + 3) == 10) { return 1; }
        if (_mchain_targs(S, GTI(S) + 3) != GTI(S) + 3) { return 1; }   # 6.7.14 (D7 (a)): `x.m<..>(`
        return _ret_lopd(S, GTI(S));   # 6.7.10: `w.s OP`
    }
    if (_is_op_dispatch_tok(nx) == 1) { return 1; }
    var o = _gcall_open(S, GTI(S));
    if (o < 0) { return 0; }
    return _is_op_dispatch_tok(TOKTYP(S, _call_close(S, o) + 1));
}
# 6.7.11 — 1 = the return value is one whole call through fncallN / callptr whose callee `&f` returns
# this fn's struct (`_icall_sid_at`): the struct-call hooks give it a temp, as a method call's.
fn _icall_ret(S): i64 {
    var sid = _icall_sid_at(S, GTI(S));
    if (sid <= 0) { return 0; }
    if (sid != _cur_fn_ret_sid) { return 0; }
    if (TOKTYP(S, _call_close(S, GTI(S) + 1) + 1) != _ret_term) { return 0; }
    return 1;
}
# ⛔ 6.7.10 — `return w.s + a;` / `return *p - a;` in a struct-returning fn: a struct-typed field or a
# `*T` dereference as the left operand dispatches (decision 11), as `return s + a;` with a struct
# variable does, so its result takes the operator receive. 1 = the operand at token `b` — a name or
# call, then `.field` / `.method(..)` steps, ending in a struct-typed field (`_hl_pchain`: a value, no
# `*T`); or `*` and a `*T`-typed name, chain or parenthesised operand (`_hl_dpsid`; `*&p` too) — is
# followed by an operator that dispatches. Anything else keeps its own return path (and its own refusal).
fn _ret_lopd(S, b): i64 {
    var i = b;
    if (TOKTYP(S, b) == 8) { i = b + 1; }
    if (TOKTYP(S, i) == 10) { i = _call_close(S, i) + 1; }
    elif (TOKTYP(S, i) == 27) { i = i + 2; }   # 6.7.13: `*&p + a` (`_hl_dpsid` types `&p`)
    elif (TOKTYP(S, i) == 2) {
        var o = _gcall_open(S, i);
        if (o >= 0) { i = _call_close(S, o) + 1; } else { i = i + 1; }
        while (TOKTYP(S, i) == 41) {
            if (TOKTYP(S, i + 1) != 2) { return 0; }
            if (TOKTYP(S, i + 2) == 10) { i = _call_close(S, i + 2) + 1; } else { i = i + 2; }
        }
    } else { return 0; }
    if (_is_op_dispatch_tok(TOKTYP(S, i)) == 0) { return 0; }
    if (TOKTYP(S, b) == 8) {
        if (_hl_dpsid(S, b + 1, i) > 0) { return 1; }
        return 0;
    }
    if (_hl_pchain(S, b, i) <= 0) { return 0; }
    if (_hl_cp != 0) { return 0; }
    return 1;
}
# Name what is actually there, so the diagnostic points at the construct and not just the fn.
fn _pair_ret_offender(S): i64 {
    if (PEEKT(S) == 2) { PRSTR(S + 0xEC00000 + PEEKV(S)); return 0; }
    if (PEEKT(S) == 1) { PRNUM(PEEKV(S)); return 0; }
    # 6.6.6 — a parenthesised return is either a tuple or a grouped expression; both read as
    # `(...)` and both are refusable shapes for a vector return. CHANGELOG [6.6.6]
    if (PEEKT(S) == 10) { syscall(SYS_WRITE, 2, "(...)", 5); return 0; }
    syscall(SYS_WRITE, 2, "this expression", 15);
    return 0;
}
# ⛔ 6.6.6 — A SIMD-RETURNING FN ACCEPTED ANY RETURN EXPRESSION. The same shape as the pair
# class above, one type class over. PARSE_RETURN's `_is_simd128` / `_is_simd256` branches handle
# exactly `return IDENT;` for a local of the matching class; everything else fell through to the
# scalar PCMPE path, so on 6.6.5 `fn bad(): f64v2 { return 5; }` compiled clean and handed back
# a half-written register pair (measured 0), and so did `return s;` for a scalar local, a bare
# `return;`, `return x + y;` (which returned Y UNCHANGED — there is no vector `+`),
# `return load64(&v);`, `return sc();` for a scalar-returning `sc`, and `return mk4();` from a
# `: f64v2` fn for a 32-byte `mk4`. The v6.4.31 `_TARGET_PE` arm below covers only
# `return <simd_call>(..)`.
# ⚠ THE CALL FORM IS TESTED ON THE EXACT DECLARED TYPE, not on the class, while `return IDENT;`
# above accepts any local of the same class. That asymmetry is deliberate and load-bearing: the
# `return IDENT;` branches byte-COPY 16/32 bytes, which is right whatever the lane type, but the
# PE arm keys on `GFRS(callee) == _cur_fn_ret_scalar` — so a same-class call of a DIFFERENT
# declared type would miss that arm and land on the generic path on Windows, which is the shape
# this bite removes. Refusing is the conservative answer, never a miscompile.
# 6.7.13: an explicit instance `g<T>(..)` too, as the fn it reaches (`_vcall_fi`; the tail arm takes only `IDENT (`).
# ⛔ 6.7.13 (D29 A, the user's decision, 2026-10-15): and the whole `return callptr(&f, ..);` / `fncallN(&f, ..)`
# with `f` declared to return this vector (`_ret_vicall`) — refused "got `this expression`" though its callee is
# known; through a variable it stays refused (no declared type: X13).
# 6.7.14 (D35 A): and a whole dereference `* E` (`_vrcv_dsrc`, by its tokens) — E's vector is known once it is parsed,
# which `_ret_vderef` does (another vector, or none, refused there in this rule's words). CHANGELOG [6.7.14]
fn _simd_ret_call_ok(S): i64 {
    if (_ret_vicall(S) == 1) { return 1; }
    if (_ret_vmc(S) == 1) { return 1; }   # 6.7.14 (D39): `return s.mv();`
    if (_vrcv_dsrc(S, GTI(S), 5) == 4) { return 1; }
    var fi = _vcall_fi(S, GTI(S));
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != _cur_fn_ret_scalar) { return 0; }
    return 1;
}
# 1 = the return value at the cursor is one whole `fncallN(&f, ..)` / `callptr(&f, ..)` (`;` after it), `f` declared
# to return this fn's vector (`_icall_rs_at`).
fn _ret_vicall(S): i64 {
    if (_icall_rs_at(S, GTI(S)) != _cur_fn_ret_scalar) { return 0; }
    if (_cur_fn_ret_scalar > 0 - 2048) { return 0; }
    if (TOKTYP(S, _call_close(S, GTI(S) + 1) + 1) != 5) { return 0; }
    return 1;
}
# On Win64 that call returns through a hidden pointer (int arg 0), as `f(..)` does: into an anonymous temp
# (`_icall_vbeg` / `_icall_vdst`, parse_expr.cyr), copied into this fn's own result pointer — the by-name arm's
# shape below. SysV / AAPCS64 / cx return it in the vector registers, which the scalar path leaves as they are.
# 1 = emitted (the `;` consumed). CHANGELOG [6.7.13]
fn _ret_vicall_pe(S): i64 {
    if (_TARGET_PE != 1) { return 0; }
    if (_cur_fn_ret_stash <= 0) { return 0; }
    if (_ret_vicall(S) == 0) { return 0; }
    _vec_desc(S, _cur_fn_ret_scalar);
    var n = GVEC_NSLOTS(S);
    var t = _agg_temp_t(S, n, _cur_fn_ret_scalar);
    _icall_vbeg = GTI(S);
    _icall_vdst = t;
    PCMPE(S);
    return _ret_vt_done(S, t, n);
}
# The vector a return left in frame temporary `t` (`n` slots), the cursor on the `;`: consumed; Win64 copies it into
# this fn's own result pointer (its stash, `return IDENT;`'s copy), SysV / AAPCS64 / cx load the vector return registers
# from it (`return IDENT;`'s pair load); then the jump to the epilogue. 1. CHANGELOG [6.7.14]
fn _ret_vt_done(S, t, n): i64 {
    if (PEEKT(S) != 5) { ERR_EXPECT(S, 5); }
    STI(S, GTI(S) + 1);   # consume ';'
    if (_cur_fn_ret_stash > 0) {
        var src = 0 - ((t + 1) * 8);
        if (_cur_fn_regalloc > 0) { src = src - _cur_fn_regalloc * 8; }
        src = src - _cur_fn_ret_stash;
        ESTRUCT_BYVAL_COPY(S, src, 0 - (_cur_fn_regalloc * 8 + 8), n * 8);
    } elif (n == 4) { EFLLOAD_F64V4_PAIR(S, t); }
    else { EFLLOAD_F64V2_PAIR(S, t); }
    vec_push(rp_vec, EJMP0(S));
    return 1;
}
# PARSE_RETURN's vector sources that emit their own return (one call there: cybs's per-fn ceiling): `callptr(&f, ..)` on
# Win64 (6.7.13's D29) and (6.7.14) a method on Win64 (D39), a dereference `*p` (D35). 1 = emitted. CHANGELOG [6.7.14]
fn _ret_vec_take(S): i64 {
    if (_ret_vicall_pe(S) == 1) { return 1; }
    if (_ret_vmc_pe(S) == 1) { return 1; }   # 6.7.14 (D39): `return s.mv();` on Win64
    return _ret_vderef(S);
}
# ⛔ 6.7.14 (D39 A, the user's decision, 2026-10-16) — `return s.mv();` FROM A FN DECLARED TO RETURN THE VECTOR THE
# METHOD IS DECLARED TO RETURN IS ACCEPTED, as `return mkv(..);` by name always was and `return callptr(&mkv, ..);` is
# since 6.7.13's D29 — it was refused "got `s`" on every target. 1 = the return value at the cursor is one whole method
# call `x.m(..)` (`;` after it) declared to return this fn's vector (`_vmc_whole`); a method of another vector keeps the
# 6.6.6 rule's refusal. SysV / AAPCS64 / cx take the call's vector registers as the by-name call's (the scalar path);
# Win64 passes a temporary as its hidden result pointer, copied into this fn's own (`_ret_vmc_pe`). CHANGELOG [6.7.14]
fn _ret_vmc(S): i64 {
    if (_cur_fn_ret_scalar > 0 - 2048) { return 0; }
    if (_vmc_whole(S, GTI(S), 5) != _cur_fn_ret_scalar) { return 0; }
    return 1;
}
# ... on Win64: the method arm's hook (`_sc_vbeg` / `_sc_vdst`, one-shot, `_sc_vret`) passes the temporary's address
# before `self`, as the vector receive's does. 1 = emitted (the `;` consumed).
fn _ret_vmc_pe(S): i64 {
    if (_TARGET_PE != 1) { return 0; }
    if (_cur_fn_ret_stash <= 0) { return 0; }
    if (_ret_vmc(S) == 0) { return 0; }
    _vec_desc(S, _cur_fn_ret_scalar);
    var n = GVEC_NSLOTS(S);
    var t = _agg_temp_t(S, n, _cur_fn_ret_scalar);
    _sc_vbeg = GTI(S);
    _sc_vdst = t;
    PCMPE(S);
    _sc_vbeg = 0 - 1;
    return _ret_vt_done(S, t, n);
}
# ⛔ 6.7.14 (D35 A, the user's decision, 2026-10-16) — `return *p;` FROM A FN DECLARED TO RETURN THE VECTOR `p` POINTS AT
# COPIES IT THROUGH THE POINTER, as `var v: V = *p;` does (6.7.13's D34: `*pv` is the vector at every destination) and
# as a struct fn's `return *p;` copies (6.7.10 decision 6). It was refused "got `this expression`" on every target. The
# whole return value at the cursor, inside any parentheses, is one dereference `* E` (`_vrcv_dsrc`, by its tokens; the
# 6.6.6 rule let it past, `_simd_ret_call_ok`): E is parsed and its vector read (`_vrcv_dparse`) — this fn's: its 16 /
# 32 bytes copied into a frame temporary the return takes (`_ret_vt_done`); another vector, or none (`*pi` of a `*i64`):
# refused in the 6.6.6 rule's words at the value's first token, as before. 1 = taken. CHANGELOG [6.7.14]
fn _ret_vderef(S): i64 {
    if (_cur_fn_returns_vector(S) == 0) { return 0; }
    var ti = GTI(S);
    if (_vrcv_dsrc(S, ti, 5) != 4) { return 0; }
    var ty = _cur_fn_ret_scalar;
    _vec_desc(S, ty);
    var n = GVEC_NSLOTS(S);
    var t = _agg_temp_t(S, n, ty);
    var vd = _vrcv_dparse(S);
    if (0 - vd == ty) { _agc_copy_bytes(S, t, 0 - 1, _AGC_DREF(_vrcv_dh), 0 - 1, n * 8); }
    else { _ret_vrefuse(S, ti); }
    return _ret_vt_done(S, t, n);
}
# The 6.6.6 rule's refusal at token `ti` (the value's first), the cursor kept. 0.
fn _ret_vrefuse(S, ti): i64 {
    var sv = GTI(S);
    STI(S, ti);
    _refuse_simd_return(S);
    STI(S, sv);
    return 0;
}
fn _cur_fn_returns_vector(S): i64 {
    if (_is_simd128(S, _cur_fn_ret_scalar) == 1) { return 1; }
    if (_is_simd256(S, _cur_fn_ret_scalar) == 1) { return 1; }
    return 0;
}
# The 6.6.6 rule at the return value of a vector-returning fn (cursor on it), PARSE_RETURN's site: refused unless a call
# declared to return this vector — and (6.7.14) unless it starts with a call naming no fn, inside any parentheses
# (`_vrcv_nofnw`): the undefined-function path names that one, as the vector local's receive leaves it since 6.7.13
# ("got `f64v2_splat`" came first). The tail arm diverts such a call here (`_tc_frame_divert`). CHANGELOG [6.7.14]
fn _ret_vec_rule(S): i64 {
    if (_cur_fn_returns_vector(S) == 0) { return 0; }
    if (_simd_ret_call_ok(S) == 1) { return 0; }
    var ti = GTI(S);
    if (_vrcv_nofnw(S, ti, _gz_end(S, ti)) == 1) { return 0; }
    return _refuse_simd_return(S);
}
fn _refuse_simd_return(S): i64 {
    if (_panic == 1) { return 0; }
    if (_derr_seen(GTI(S), "_refuse_simd_return", 0, 0) == 1) { return 0; }   # 6.7.15: once per site
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": a vector-returning fn carries its result in a fixed register pair, so `return` takes a local of that vector type or a call to a fn declared to return the same one — got `", 174);
    _pair_ret_offender(S);   # names the construct; not pair-specific despite the name
    syscall(SYS_WRITE, 2, "`\n", 2);
    _had_error = 1;
    return 0;
}

# 6.6.6 — the TUPLE spelling of the shape `_refuse_simd_return` names, called from
# PARSE_RETURN's multi-return arm. Its own fn for the same reason the other refusals are:
# cybs, the bootstrap compiler the seed assembles, fails SILENTLY when one fn accumulates too
# many global/call references, and PARSE_RETURN is already the largest fn in the frontend.
fn _refuse_vector_tuple_return(S): i64 {
    _refuse_struct_tuple_return(S);
    if (_cur_fn_returns_vector(S) == 0) { return 0; }
    _refuse_simd_return(S);
    return 0;
}
# ⛔ 6.7.11 — A TUPLE LITERAL IS NOT THE STRUCT A FN DECLARED `: S` RETURNS (the user's decision,
# 2026-10-13: refused by name in every class). The multi-value arms load rax:rdx[:r3], which is the
# 9-16 B pair's ABI by coincidence only: a fn returning a struct over 16 B never wrote its result
# pointer (the caller read 0, 0, 0) and one of 8 B or less dropped the second value. A tuple is an
# anonymous struct, another type (guide § Tuples); `var t = (a, b); return t;` was already refused.
# Cursor on the literal's `(`. Not a tuple, `Str` (a handle) or dyn (`_mret_land` refuses that one),
# and not in an inline replay, whose `return` is the callee's (`_ret_small_cls`). CHANGELOG [6.7.11]
fn _refuse_struct_tuple_return(S): i64 {
    if (GIDEP(S) != 0) { return 0; }
    if (_cur_fn_ret_sid <= 0) { return 0; }
    if (_dx_plain(S, _cur_fn_ret_sid) == 0) { return 0; }
    if (_panic == 1) { return 0; }
    if (_derr_seen(GTI(S), "_refuse_struct_tuple_return", _cur_fn_ret_sid, 0) == 1) { return 0; }   # 6.7.15
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": a fn returning the struct `");
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (_cur_fn_ret_sid - 1) * 8));
    PRSTR("` returns that struct — `");
    if (_tup_commas(S, GTI(S)) > 1) { PRSTR("(a, b, c)"); } else { PRSTR("(a, b)"); }
    PRSTR("` is a tuple, another type\n");
    _had_error = 1;
    return 0;
}

fn _refuse_pair_return(S): i64 {
    if (_panic == 1) { return 0; }
    if (_slit_at(S, GTI(S)) == 1) { return 0; }   # 6.7.14 (D12 (a)): the factor refuses the literal, once
    if (_derr_seen(GTI(S), "_refuse_pair_return", _cur_fn_ret_sid, 0) == 1) { return 0; }   # 6.7.15: once per site
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": a fn returning the 9-16 byte struct `", 39);
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (_cur_fn_ret_sid - 1) * 8));
    syscall(SYS_WRITE, 2, "` is returned in two registers, so `return` takes a local of that struct or a call returning it — got `", 105);
    _pair_ret_offender(S);
    syscall(SYS_WRITE, 2, "`\n", 2);
    _had_error = 1;
    return 0;
}

# The binary operators EMIT_OP_DISPATCH serves: + - * / and the wrapping +% -% *%.
fn _is_op_dispatch_tok(t): i64 {
    if (t >= 6) { if (t <= 9) { return 1; } }
    if (t == 113) { return 1; }
    if (t == 116) { return 1; }
    if (t == 119) { return 1; }
    return 0;
}

# ⛔ 6.6.6 — an `async fn` captures each parameter as ONE 8-byte int: its constructor homes
# register i into frame slot i and copies it to `obj[16 + i*8]` (or coroutine frame slot i), and
# `future_force` hands them back to the body as int arguments. A value-form vector travels in
# XMM/V (SysV/aarch64) or by pointer (Win64) and owns 2-4 slots, so it was never captured: a plain
# async fn computed with whatever XMM0 held at force time, a coroutine with the neighbouring ints
# shifted into the vector's lanes — exit 0, no diagnostic, while a vector LOCAL in the same fn
# was refused. Refused by name until the capture exists. CHANGELOG [6.6.6]
fn _refuse_async_simd_param(S, pnoff): i64 {
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": async fn parameter '", 22);
    PRSTR(S + 0xEC00000 + pnoff);
    syscall(SYS_WRITE, 2, "' is a value-form vector, which an `async fn` does not capture yet — pass a pointer to it\n", 92);
    _had_error = 1;
    return 0;
}
# ⛔ 6.6.16 (C7) — the same capture, for a plain struct over 8 B passed by value. Such a parameter
# arrives as its struct's ADDRESS, and a by-value one is copied in the callee's prologue
# (`_sptr_params_localize`) — but an `async fn` runs its body at force time, so the copy would
# read the caller's struct late (measured: `bump(p)`, then `p.x = 10`, then `await` printed 11),
# and a coroutine impl re-runs its prologue on every resume. Refused by name until the Future
# carries the struct; `p: *T` (one i64) and a struct of 8 B or less still compile. `li` is the
# parameter's slot, typed and not yet marked (`_param_record`). CHANGELOG [6.6.16]
fn _refuse_async_struct_param(S, li, pnoff): i64 {
    if (_cur_fn_ptrp == li + 1) { return 0; }
    var lt = GLTYPE(S, li);
    if (_agc_plain_big(S, lt) == 0) { return 0; }
    if (_dyn_is(S, 0 - lt) == 1) { return 0; }   # 6.7.8: refused at its type (T11), once
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": async fn parameter '", 22);
    PRSTR(S + 0xEC00000 + pnoff);
    if (_tup_is(S, 0 - lt) == 1) {   # 6.7.7 (B4): a tuple has no pointer form (`*( .. )` is refused)
        PRSTR("' is a tuple ");
        PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + ((0 - lt) - 1) * 8));
        PRSTR(", which an `async fn` does not capture yet - pass its elements as separate parameters\n");
        _had_error = 1;
        return 0;
    }
    syscall(SYS_WRITE, 2, "' is a struct passed by value, which an `async fn` does not capture yet — pass a pointer to it (`", 99);
    PRSTR(S + 0xEC00000 + pnoff);
    syscall(SYS_WRITE, 2, ": *", 3);
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + ((0 - lt) - 1) * 8));
    syscall(SYS_WRITE, 2, "`)\n", 3);
    _had_error = 1;
    return 0;
}

# ⛔ 6.6.6 — an `async fn` hands its result back through ONE i64: `future_force` returns what the
# body left in rax. A struct returned BY VALUE does not travel that way. Over 16 B the ABI is a
# hidden retptr that nothing supplies — the coroutine CONSTRUCTOR is itself classified as a retptr
# callee, so the caller's buffer address is consumed building the Future and the body writes its
# result through whatever the first argument register held. 9-16 B is rax:rdx and the Future has
# no second word, so the high half is dropped. Both were SILENT: measured at 6.6.5,
# `async fn a2(a,b): P3` (24 B) made `print_num(future_force(a2(4,5)))` print 0 and exit 0, and the
# 16 B `P2` came back with `.x` only. A struct of 8 B or less IS one i64, and `Str` is a heap
# handle, so those keep working — `_ret_agg_class` is exactly that distinction. Refused by name
# until a Future can carry a struct. CHANGELOG [6.6.6]
fn _refuse_async_struct_return(S, fnoff, fi): i64 {
    if (_ret_agg_class(S, fi) == 0) { return 0; }
    if (_dyn_is(S, GFRS(S, fi)) == 1) { return 0; }   # 6.7.8: refused at its type (T11), once
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": `async fn ", 12);
    PRSTR(S + 0xEC00000 + fnoff);
    syscall(SYS_WRITE, 2, "` returns a struct by value, and a Future carries one i64 — return a pointer to it\n", 85);
    _had_error = 1;
    return 0;
}

# ⛔ 6.6.6 (bite 16 review) — THE SAME "A FUTURE CARRIES ONE i64" LIMIT, ONE TYPE CLASS OVER.
# `_refuse_async_struct_return` above keys on `_ret_agg_class`, which answers only for STRUCTS
# (`GFRS` positive) — so a VALUE-FORM VECTOR return slipped straight through the hole the struct
# refusal had just closed. A vector travels in XMM/V (SysV/aarch64) or by pointer (Win64), never
# in rax, and the Future has nowhere to put it: measured on the compiler that shipped 16a,
# `async fn av(a,b): f64v2 { ... return v; }` + `future_force(av(7,9))` compiled with ZERO
# diagnostics and yielded 0 where the byte-identical SYNC fn yields 7. This is the exact shape
# `_refuse_async_simd_param` (20 lines up) already refuses on the PARAMETER side — the return
# half was simply never wired to it. Refused by name until a Future can carry a vector.
# CHANGELOG [6.6.6]
fn _refuse_async_vec_return(S, fnoff, fi): i64 {
    if (_is_simd_any(S, GFRS(S, fi)) == 0) { return 0; }
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": `async fn ", 12);
    PRSTR(S + 0xEC00000 + fnoff);
    syscall(SYS_WRITE, 2, "` returns a value-form vector, which an `async fn` does not capture yet — return a pointer to it\n", 99);
    _had_error = 1;
    return 0;
}

# ⛔ 6.7.11 — THE SAME LIMIT FOR SEVERAL VALUES. A multi-value return travels in rax:rdx[:r3] and a
# Future memoises ONE word (`future_force` returns rax): `async fn g(): (i64, i64) { return (1, 2); }`
# compiled clean, `await g()` yielded 1, and the documented `rethi()` read got 2 only on the force
# that ran the body — a memoised `await f` or a reactor-driven one read whatever the last call left
# in rdx (19 where 12 is right, on every target). Neither refusal above saw it: `GFRS` holds
# MULTIRET_SID, no struct and no vector. Refused by name (the user's decision, 2026-10-13): at the
# declaration (`: (T1, T2[, T3])`), and in an undeclared body at `return (a, b[, c]);` (PARSE_RETURN)
# and `ret2(a, b)` (PARSE_SIMD_EXT) — a declared fn's body was reported at its declaration.
# CHANGELOG [6.7.11]
fn _refuse_async_multi_return(S, fnoff, fi): i64 {
    if (GFRS(S, fi) != MULTIRET_SID) { return 0; }
    if (_panic == 1) { return 0; }
    _async_mv_say(S, fnoff, 0, GFRN(S, fi));
    return 0;
}
# ... in the body: the multi-value spelling at token `ti` writes `n` values. The body of an async fn,
# a coroutine's included, is its `$impl`; a closure in it is its own fn. An #inline replay parses its
# callee's body here (its own definition was judged).
fn _refuse_async_mv_body(S, ti, n): i64 {
    if (GIDEP(S) != 0) { return 0; }
    var fi = _cur_fn_ix;
    if (fi < 0) { return 0; }
    if (_fn_async_impl(S, fi) == 0) { return 0; }
    if (GFRS(S, fi) == MULTIRET_SID) { return 0; }
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    _async_mv_say(S, L64(_fnt_names + fi * 8), 5, n);
    STI(S, sv);
    return 0;
}
# `return (a, b[, c]);` at token `st` (PARSE_RETURN, before its arms): the multi-value arm's literal.
fn _async_mv_ret(S, st): i64 {
    if (TOKTYP(S, st) != 10) { return 0; }
    var c = _tup_commas(S, st);
    if (c <= 0) { return 0; }
    return _refuse_async_mv_body(S, st, c + 1);
}
# ⛔ 6.7.13 — ... AND `return h(..);` FORWARDING A MULTI-VALUE CALL: the callee declared `: (T1, T2[,
# T3])`, counted by pass 1 or a method (`_mv_callee`), parentheses around the whole call transparent
# (`_ret_whole_call`). The forward left the values in the return registers and the Future memoised the
# first — the third spelling of the loss above (the repro exited 19 where 12 is right, on every target).
# Refused with the same text at the forwarded call (D24 A, the user's decision, 2026-10-15); a callee
# held in a variable (`callptr(fp, ..)`) is unknown and not judged. Token `st` = the value's first;
# called once from PARSE_RETURN, before the arms (the tail-call arm takes `return h(..);`).
# In a fn returning a struct of 8 B or less (`_ret_small_cls`) the same forward returned the call's
# FIRST value as the struct's word (the repro exited 3) — the fifth named-struct destination of "a
# multi-value call is not a struct value" (6.7.11, D20 / D21), where the 9-16 B and over-16 B classes
# already refuse it by their own texts: "a multi-value call 'mk' is not returned as struct 'P1' - bind
# it first" (`_mv_struct_err` kind 4; D25 A, the user's decision, 2026-10-15). CHANGELOG [6.7.13]
fn _ret_mv_fwd(S, st): i64 {
    if (GIDEP(S) != 0) { return 0; }
    if (_cur_fn_ix < 0) { return 0; }
    if (_syntax_only == 1) { return 0; }
    var asy = _fn_async_impl(S, _cur_fn_ix);
    if (asy == 0) { if (_ret_small_cls(S) == 0) { return 0; } }
    var k = 0;
    while (TOKTYP(S, st + k) == 10) { k = k + 1; }
    var fi = _ret_whole_call(S, st, k);
    if (_mv_callee(S, fi) == 0) { return 0; }
    if (asy == 1) { return _refuse_async_mv_body(S, st + k, _mv_count(S, fi)); }
    return _ret_mv_small(S, st + k, fi);
}
# ... the small-struct report at the call `ct` (a method's hint `x.mk(..)`).
fn _ret_mv_small(S, ct, fi): i64 {
    if (_mcall_open(S, ct, 0 - 1) >= 0) { return _mv_struct_err(S, ct, _cur_fn_ret_sid, TOKVAL(S, ct + 2), fi, 4, 2); }
    return _mv_struct_err(S, ct, _cur_fn_ret_sid, TOKVAL(S, ct), fi, 4, 1);
}
# "`async fn g` returns 2 values, and a Future carries one i64 - return a pointer to a struct holding
# them", at the cursor; `cut` bytes of the name's tail dropped (the body's `$impl`).
fn _async_mv_say(S, noff, cut, n): i64 {
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": `async fn ");
    var nm = S + 0xEC00000 + noff;
    var len = 0;
    while (load8(nm + len) != 0) { len = len + 1; }
    syscall(SYS_WRITE, 2, nm, len - cut);
    PRSTR("` returns ");
    PRNUM(n);
    PRSTR(" values, and a Future carries one i64 - return a pointer to a struct holding them\n");
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}

# A struct-valued call used where there is no frame to hold its result. Refused by name: before
# 6.6.6 every such site compiled clean and SIGSEGV'd (the callee wrote through whatever the first
# argument register held). CHANGELOG [6.6.6]
# `_tsc_n` counts the refusals written: a statement form that sees it move while it parsed its call knows the
# call refused itself, and steps over the rest without a second error (`mk().n = 5;` at top level was also
# "the result is a temporary"). The panic latch is left as it was. CHANGELOG [6.7.14]
# 6.7.15: the callee `noff` named as the source spells it — a method `Pt.dup`, not its fn `Pt_dup` (`_fn_src_name`).
var _tsc_n = 0;
fn _refuse_toplevel_struct_call(S, noff): i64 {
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + _fn_src_name(S, FINDFN(S, noff), noff));   # 6.7.15: a method `Pt.dup`, not `Pt_dup`
    syscall(SYS_WRITE, 2, "' returns a struct by value, and a struct result needs storage in a fn's frame — call it inside a fn\n", 103);
    _had_error = 1;
    _tsc_n = _tsc_n + 1;
    return 0;
}
# ERR_IDENT whose first name `noff` is the result of a call to fn `fi` (a struct-call record's `_sc_fi`; -1: a name as
# written), printed as the source spells it (`_fn_src_name`: `Pt.dup`). Reported once per token and record — keyed on
# `noff`, the record's own name, not the scratch the spelling is written at. CHANGELOG [6.7.15]
fn _err_ident_fn(S, msg, noff, fi, tail, noff2): i64 {
    var nm = _fn_src_name(S, fi, noff);
    if (nm == noff) { return ERR_IDENT(S, msg, noff, tail, noff2); }   # a free fn: its own name, keyed so
    if (_err_once(S, (((msg * 31 + noff) * 31 + tail) * 31 + noff2) * 8 + 3) == 0) { return 0; }
    return ERR_IDENT(S, msg, nm, tail, noff2);
}

# v6.4.4/v6.4.7 mask classes: 1 = any 16-byte/1-XMM vector (f64v2 or an integer vector, so
# the test is the SIZE class), 3 = f32v4 exactly (distinguished so an f64v2 arg is rejected
# rather than silently run through addps), 2 = a 32-byte vector: `want` (`_pv32_param`) says which.
fn _simd_arg_typecheck(S, cls, lt, want): i64 {
    if (cls == 1) {
        if (_is_simd128(S, lt) == 0) {
            ERR_MSG(S, "value-form SIMD arg must be a 16-byte vector", 44);
        }
        return 0;
    }
    if (cls == 3) {
        if (lt != 0 - 2121) {
            ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f32v4)", 56);
        }
        return 0;
    }
    return _simd256_typecheck(S, want, lt);
}
# ⛔ 6.7.13 — THE 32-BYTE VECTOR PARAMETER'S OWN TYPE. f32v8 and f64v4 share the value-form ABI (two XMM / V
# registers, a 32-byte copy-in on Win64) and the 2-bit SIMD mask's code 2, which has no room for a fourth code, so
# parameter `k` of fn `fi` is read from the definition's tokens, as `_pvec_param` reads a `*V`: 2153 = `v: f32v8`,
# 2125 = `v: f64v4`, 0 = neither, or no definition to read. CHANGELOG [6.7.13]
fn _pv32_param(S, fi, k): i64 {
    var o = _gen_def_open(S, fi);
    if (o < 0) { return 0; }
    if (_dps_param(S, o, k) == 0) { return 0; }
    var i = _dps_ts;
    if (TOKTYP(S, i) != 2) { return 0; }
    var c = _classify_param_type(S, TOKVAL(S, i));
    if (c == 10) { return 2153; }
    if (c == 7) { return 2125; }
    return 0;
}
# A vector local of SLTYPE `lt` into a value-form 32-byte parameter declared `want` (0: f64v4, the mask's reading
# before 6.7.13): anything but that vector is refused by name, f64v4 into `v: f32v8` and f32v8 into `v: f64v4` too.
fn _simd256_typecheck(S, want, lt): i64 {
    if (want == 2153) {
        if (lt != 0 - 2153) {
            ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f32v8)", 56);
        }
        return 0;
    }
    if (lt != 0 - 2125) {
        ERR_MSG(S, "value-form SIMD arg type mismatch (callee expects f64v4)", 56);
    }
    return 0;
}

# The second half: emit the XMM/V loads AFTER ECALLPOPS, AT the call site, so the vector
# registers hold the values entering the callee. See _simd_arg_record. CHANGELOG [6.6.5]
fn _simd_arg_second_pass(S, tbl, cnt): i64 {
    var i = 0;
    while (i < cnt) {
        var lli = load64(tbl + i * 24);
        var apc = load64(tbl + i * 24 + 8);
        var cl = load64(tbl + i * 24 + 16);
        if (cl == 2) { ELOAD_F64V4_TO_XMM(S, apc, lli); }
        else { ELOAD_F64V2_TO_XMM(S, apc, lli); }
        i = i + 1;
    }
    return 0;
}

# v5.6.4 #deprecated call-site warning. It fires at EVERY call site (unlike #must_use,
# which only fires on statement-level discard — deprecated fns should get the nudge no
# matter how their result is used). Message body lives in fn_deprecated_msg as a
# string-literal token value (offset<<32 | length).
#
# ⛔ 6.6.16 — reached ONLY through `_callee_site_checks` below. v6.6.4 called it from three
# paths (PARSE_FNCALL, the tail call, `_struct_call_into`) while `_vis_check` had fourteen, so
# `&old_f`, `o.m()`, the struct receives, operator dispatch and the PE vector receives were
# silent; and a call parsed before the definition was silent on every path, because only
# pass 2 set the bit (pass 1 now does — `_prescan_dep_take`). `ti` is the token the warning
# names: `_err_head` read the CURSOR, which the tail path has already walked past `);`, so
# `return old_f(x);` was reported on the NEXT token's line. CHANGELOG [6.6.16]
fn _DEPRECATED_WARN(S, fi, noff, ti): i64 {
    if (GFLG(S, fi) & 4 == 0) { return 0; }
    if (_dep_seen(ti, fi) == 1) { return 0; }
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));
    syscall(SYS_WRITE, 2, "' is deprecated", 15);
    var _dep_msg = GFDM(S, fi);
    if (_dep_msg != 0) {
        var _dep_len = _dep_msg & 0xFFFFFFFF;
        syscall(SYS_WRITE, 2, ": ", 2);
        syscall(SYS_WRITE, 2, _lit_ptr(S, _dep_msg), _dep_len);   # 6.6.17: a side-table message
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    return 1;
}

# 6.6.16 — ONE warning per call site. The same tokens are parsed more than once: an `#inline`
# fn's body at its definition and again at every expansion, a generic's body for its base and
# again for each instance. A re-parse names the same token for the same callee, so that pair
# is the site — `w(1); w(2);` on an `#inline fn w` calling a deprecated fn printed the
# identical line three times. Every path names a token of its OWN call (an operator its
# operator), so two calls never share a pair. Warnings are rare: a short list, not a bitmap.
var _dep_warned = 0;
fn _dep_seen(ti, fi): i64 {
    if (_dep_warned == 0) { _dep_warned = vec_new(); }
    var n = vec_len(_dep_warned);
    var i = 0;
    while (i < n) {
        if (vec_get(_dep_warned, i) == ti) { if (vec_get(_dep_warned, i + 1) == fi) { return 1; } }
        i = i + 2;
    }
    vec_push(_dep_warned, ti);
    vec_push(_dep_warned, fi);
    return 0;
}

# A generic INSTANCE (`old_g<i32>(..)`, minted as `old_g$i32`) is deprecated when its base is:
# the instance is re-parsed from the base's tokens long after the attribute was consumed, so
# it never received the bit, and only the i64 spellings (which ARE the base) warned.
# 6.6.17 — what an instance must know of itself that the base's pass-1 record holds: its type
# arguments (a3, `_bind_inl_generic`) and the base's "returns one value" bit 1024 (a5,
# `_prescan_ret_single` — the instance's body IS the base's tokens); 6.7.11, its value count
# (`_prescan_ret_arity`). 6.7.15: the base's `#io` / `#alloc` (bits 16 / 32) — `#pure`'s check reads the callee's
# bits, and a call through an instance (`h<i32>(1)`) was silent (CHANGELOG [6.7.15]).
fn _gen_inst_record(S, spec, base_fi, c0, c1): i64 {
    if (spec < 0) { return 0; }
    SFIC(S, spec, c0, c1);
    if (GFMETH(S, base_fi) != 0) { SFMETH(S, spec, GFMETH(S, base_fi)); }   # 6.7.14: `P.id<f64>`
    if ((GFLG(S, base_fi) & 1024) != 0) { SFLG(S, spec, GFLG(S, spec) | 1024); }
    SFLG(S, spec, GFLG(S, spec) | (GFLG(S, base_fi) & 196608));   # 6.7.11: its arity record
    SFLG(S, spec, GFLG(S, spec) | (GFLG(S, base_fi) & 48));       # 6.7.15: `#io` / `#alloc`
    return 0;
}
fn _gen_inherit_dep(S, spec, base_fi): i64 {
    if (spec < 0) { return 0; }
    if ((GFLG(S, base_fi) & 4) == 0) { return 0; }
    SFLG(S, spec, GFLG(S, spec) | 4);
    SFDM(S, spec, GFDM(S, base_fi));
    return 0;
}

# 6.6.16 — THE per-callee check, for every path that resolves a name to an fn and emits its
# own call or address: the `private` check and the `#deprecated` warning, together, so the two
# lists cannot drift apart again (they had: 14 sites against 3). A new call path is ONE call
# here; `grep -n '_callee_site_checks' src/frontend/` is the list of paths. `ti` is the token
# the warning names. Returns 1 when the `private` check refused the call (reported), else 0 —
# only the const evaluator reads it, to stop its evaluation (CHANGELOG [6.7.11]). CHANGELOG [6.6.16]
fn _callee_site_checks(S, fi, noff, ti): i64 {
    if (fi < 0) { return 0; }
    var r = _vis_check(S, fi, noff, ti);
    _DEPRECATED_WARN(S, fi, noff, ti);
    return r;
}

# The same, naming a token relative to the cursor: `back` = 0 is the cursor itself (a path
# whose cursor is still on the callee's name, its `(`, or the first token after that `(`), 1 is
# the token just consumed (`&old_f`, whose name is behind the cursor — the token AFTER it can be
# on the next line). ONE call with no nested one, so the hot parsers that use it (PARSE_VAR,
# _PARSE_FACTOR_IMPL, PARSE_RETURN, PARSE_FNCALL) carry no more references than `_vis_check`
# alone did — cybs's per-fn reference ceiling fails silently (CLAUDE.md, Release Gate 2).
fn _callee_site_checks_here(S, fi, noff, back): i64 {
    _callee_site_checks(S, fi, noff, GTI(S) - back);
    return 0;
}

# Parse fn call args and emit call (as expression)
# v6.5.0 Phase 2 — cross-file `private` call check. WARN-mode; Phase 3 flips it to a
# hard error via the v6.3.2 undefined-fn playbook (measure the blast radius first,
# then flip default-on rather than sprinkling opt-outs).
#
# ONE shared fn rather than a copy per call site. The plan named two sites; there are
# at least thirteen paths that resolve a name to an fn index and emit their own call —
# ordinary calls, tail calls, operator overloading, methods, `&fn` pointers, closures,
# await, derive helpers. v6.4.81 shipped a bug of exactly that shape: the `_cfo` class
# was declared fixed three times, each fix scoped to the tier its repro landed in, and
# the fourth occurrence was in a resolution path nobody had enumerated. A single helper
# means adding a site is one call, and the set of sites is greppable.
#
# ⛔ v6.6.4: this header named `&fn` pointers and methods as paths that need the call —
# and v6.5.0 shipped THREE callers (PARSE_FNCALL, the tail call, EMIT_OP_DISPATCH).
# hisab found `&_private` callable from any file; the sweep found eight paths that
# resolve a user identifier through FINDFN and emit their own call/fixup with no check:
# `&fn` (parse_expr.cyr), `s.method()`, the asv retptr / asp pair struct receives (also
# the inferred `var q = f()` form), and four PE-only SIMD receive/return paths
# (parse_decl.cyr _try_vector_call_assign / _f2c / _f4c, parse_fn.cyr _rc). All eleven
# now call it — since 6.6.16 through `_callee_site_checks`, its only caller, which adds the
# `#deprecated` warning; `grep -n '_callee_site_checks' src/frontend/` is the list.
#
# ⛔ 6.6.5 — "FAIL-OPEN ON UNKNOWNS … Phase 3 must revisit this" stood here for five
# minors and WAS the hole. An unstamped callee (GFFI == 0) returned at the FIRST test
# below, so every definition kind pass 1 did not register — impl methods, `mod` fns, fns
# after the first top-level statement — was reachable from any file by a call that merely
# came EARLIER in the concatenated stream. Pass 1 now stamps all of them (_prescan_impl /
# _prescan_tail / the GMOD guard's removal), so "unknown" is no longer an ordinary state.
#
# This is the BACKSTOP under that, and it is fail-CLOSED-LATER rather than fail-open: a
# reference to a name with no owner AND no body yet is DEFERRED — recorded with the
# CALLER's file and its token — and re-judged by _vis_check_deferred once every definition
# in the compiland has been stamped. Nothing is reported at the reference itself, so the
# legitimately-unknown callees the old comment listed (enum constructors, DCE stubs, an fn
# that is never defined) stay silent: they still have no private bit at the end.
#
# ⚠ A deferral entry is only as good as the stamp that arrives later. If a future
# definition kind is added that pass 1 does not walk, this layer reports it instead of
# letting it through — which is the property the v6.5.0 comment promised and did not have.
# See tests/gates/frontend/private_forward_reference.sh (mutant M4+M5). CHANGELOG [6.6.5]
var _visdef_vec = 0;
# 6.6.5 round 3 — bumped once per PRIVATE stamp in PARSE_FN_DEF. `_vis_check_deferred` hangs
# off PARSE_PROG, which IS the block parser AND the fn-body parser, so it runs once per
# `if`/`else`/`while` body and once per fn definition; re-walking the whole deferral list each
# time is an unbounded term, because an entry whose callee is NEVER stamped (an undefined fn,
# an enum ctor, a DCE stub — exactly the cases that must stay silent) is never consumed and so
# is re-visited forever. Draining "definitively judged" entries cannot fix it: mid-parse an
# unstamped callee is indistinguishable from a not-yet-stamped one.
#
# ⭐ THE GUARD KEYS ON THE PRIVATE STAMP, NOT ON EVERY STAMP, and the difference is the whole
# fix. `_vis_report_late` reports nothing for a public callee, so a sweep can only reach a new
# verdict if a new PRIVATE bit landed since the last one. A compiland with no `private`
# anywhere — nearly all of them — therefore sweeps exactly ONCE. Keying on `SFFI` instead
# (the first attempt) left the quadratic in place, because every fn body ends with both a
# stamp and a sweep: MEASURED at 2000 refs x 6000 blocks, base 64 ms, SFFI-keyed 91 ms,
# private-keyed 62 ms. Sound by construction, and it is why the number below is measured
# rather than reasoned about.
var _vis_stamp_seq = 0;
var _vis_swept_seq = 0 - 1;
fn _vis_check(S, fi, noff, ti): i64 {
    if (fi < 0) { return 0; }                    # unresolved name — nothing to judge
    if (GFFI(S, fi) == 0) {
        # Owner unknown. If it also has no body yet, this may be a forward reference to a
        # definition that has not been stamped — re-judge it at the end of the parse.
        if (L64(_fnt_offsets + fi * 8) < 0) { _vis_defer(S, fi, ti); }
        return 0;
    }
    if ((GFLG(S, fi) & 64) == 0) { return 0; }   # callee not private — the common path
    var callee = GFFI(S, fi);
    if (callee == 0) { return 0; }               # callee origin unknown
    # The CALLER's file comes from the call's own token, not from `_cur_fn_ix`: the
    # inline-replay path re-parses a callee's body tokens while `_cur_fn_ix` still
    # names the enclosing fn, so asking the fn table would answer for the wrong file.
    # 6.6.17: `ti`, not the cursor — a tail call fires this past `);`, so the cursor named
    # the NEXT token (`return pv(x);` was reported at the `}` below it). CHANGELOG [6.6.17]
    var caller = FM_FILEID(S, GTLINE(S, ti)) + 1;
    if (caller == 0) { return 0; }
    if (caller == callee) { return 0; }          # same file — allowed
    # v6.5.0 Phase 3 — HARD ERROR by default, via the v6.3.2 undefined-fn playbook:
    # measure the blast radius in warn mode first, then flip default-on rather than
    # sprinkling opt-outs. Measured on the tree with lib/regex.cyr adopted (41 private
    # / 9 public): ZERO violations across tests/tcyr, programs, benches and fuzz.
    #
    # Routed through `_had_error` rather than SYS_EXIT so the compiler reports EVERY
    # violation in one run and emits no binary — the v6.4.62 multi-error contract.
    # A fail-fast exit here would make adopting `private` on a large file an
    # N-compile-cycles-to-find-N-callers exercise.
    if (_vis_seen(ti, fi) == 1) { _had_error = 1; return 1; }   # 6.7.14: once per site
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));
    syscall(SYS_WRITE, 2, "' is private to its file\n", 25);
    _had_error = 1;
    return 1;
}

# 6.7.14 — ONE `private` error per call site, `_dep_seen`'s rule for the same reason: the body of an
# `#inline` fn is parsed at its definition and again at every expansion, a generic's for its base and
# again per instance, and each re-parse names the same (token, callee) pair — `w() + w()` on an
# `#inline fn w` calling another file's private fn printed the identical error three times. A repeat
# keeps the verdict (`_had_error`, the refusal the const evaluator reads) and prints nothing. Both
# report paths record here, so a site the deferred sweep reported is not reported again by a later
# replay. Lazy: a compile with no violation allocates nothing. CHANGELOG [6.7.14]
var _vis_reported = 0;
fn _vis_seen(ti, fi): i64 {
    if (_vis_reported == 0) { _vis_reported = vec_new(); }
    var n = vec_len(_vis_reported);
    var i = 0;
    while (i < n) {
        if (vec_get(_vis_reported, i) == ti) { if (vec_get(_vis_reported, i + 1) == fi) { return 1; } }
        i = i + 2;
    }
    vec_push(_vis_reported, ti);
    vec_push(_vis_reported, fi);
    return 0;
}

# 6.6.5 — record a reference whose callee had no owner yet: (fi, caller fid + 1, token).
# Kept as its own fn so cybs sees a small body (the global/call fan-out rule). Lazy vec:
# a compile with no unstamped reference allocates nothing.
fn _vis_defer(S, fi, ti): i64 {
    var dcaller = FM_FILEID(S, GTLINE(S, ti)) + 1;
    if (dcaller == 0) { return 0; }
    if (_visdef_vec == 0) { _visdef_vec = vec_new(); }
    vec_push(_visdef_vec, fi);
    vec_push(_visdef_vec, dcaller);
    vec_push(_visdef_vec, ti);
    return 0;
}

# 6.6.5 — re-judge every deferred reference against the stamps that exist NOW. Called from
# the end of PARSE_PROG, so there is no per-fork edit to forget.
#
# ⚠ PARSE_PROG IS THE BLOCK PARSER, NOT AN END-OF-PROGRAM HOOK. It runs for every `if` /
# `else` / `while` / `for` body as well as for the top-level statement list, so this is
# entered many times per compile — which is why each entry is CONSUMED when it is reported
# (its fi slot is set to -1) rather than left for the next block to report again. The last
# invocation is the end of the fork's top-level PARSE_PROG call, by which point every
# definition in the compiland has been parsed, so nothing can be missed by stopping early.
# The common path costs one comparison: the vec is never allocated unless something
# deferred. CHANGELOG [6.6.5]
fn _vis_check_deferred(S): i64 {
    if (_visdef_vec == 0) { return 0; }
    if (_vis_swept_seq == _vis_stamp_seq) { return 0; }   # 6.6.5 r3: nothing new stamped
    _vis_swept_seq = _vis_stamp_seq;
    var n = vec_len(_visdef_vec);
    var i = 0;
    while (i < n) {
        var fi = vec_get(_visdef_vec, i);
        if (fi >= 0) {
            if ((GFLG(S, fi) & 64) != 0) {
                var caller = vec_get(_visdef_vec, i + 1);
                var ti = vec_get(_visdef_vec, i + 2);
                if (_vis_report_late(S, fi, caller, ti) == 1) { vec_set(_visdef_vec, i, 0 - 1); }
            }
        }
        i = i + 3;
    }
    return 0;
}

# Returns 1 when it reported (so the caller can consume the entry), 0 when the reference is
# still not judgeable or is legitimate.
fn _vis_report_late(S, fi, caller, ti): i64 {
    var callee = GFFI(S, fi);
    if (callee == 0) { return 0; }
    if (callee == caller) { return 0; }
    if (_vis_seen(ti, fi) == 1) { _had_error = 1; return 1; }   # 6.7.14: once per site
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, L64(_fnt_names + fi * 8)));
    syscall(SYS_WRITE, 2, "' is private to its file\n", 25);
    _had_error = 1;
    return 1;
}

# v6.5.0 Phase 3 — one-shot notice that visibility enforcement is DEGRADED.
#
# `private` is keyed on the file map, which caps at 1024 entries. Past that cap
# FM_FILEID cannot identify a file, the stamp records "unrecorded", and the private
# bit is therefore never set — so enforcement silently becomes a no-op for every file
# beyond the cap. Silently is the problem: a consumer who adopts `private` and grows
# past 1024 files would believe they still had a boundary. Fail-open is the right
# CODE behaviour (we cannot prove a violation we cannot attribute) but it must be
# announced, which is what this does.
var _vis_degraded_said = 0;
fn _vis_degraded_note(): i64 {
    if (_vis_degraded_said != 0) { return 0; }
    _vis_degraded_said = 1;
    syscall(SYS_WRITE, 2, "warning: file map full -- `private` enforcement is DISABLED past the 1024-file cap\n", 83);
    return 0;
}

# v6.5.1 — count the arguments of the call whose `(` was just consumed, WITHOUT
# moving the cursor. Needed by the overload-suffix dispatch in PARSE_FNCALL: a
# redirect `base(...)` → `base_str`/`base_int` is only correct when the TARGET's
# parameter count matches what THIS call site actually supplies.
#
# Before this existed the dispatch decided on the type of argument 1 alone and
# would happily rewrite a 1-argument call into a call to a 2-argument function,
# leaving the extra parameter bound to garbage and reporting only a *warning*.
# That is not theoretical: it silently broke `bayan_json_v_parse(someStr)` for
# the whole ecosystem (bayan 1.3.0 renamed its own public API to escape it), and
# it is the reason sakshi's unrelated `_sk_write_str` was a latent landmine.
#
# The arguments are stepped over by `_arg_next`, the one argument walker, so a nested call, an
# index or a struct initializer cannot leak its commas into the top-level count — nor (6.7.7) a
# closure's `|a, b|` bars, which counted one argument too many and kept `show(s, |a, b| a + b)`
# from its `show_str` sibling. CHANGELOG [6.5.1] [6.7.7]
fn _CALL_ARGC_PEEK(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti) == 11) { return 0; }   # `f()` — empty argument list
    var argc = 1;
    var n = GTCNT(S);
    while (ti < n) {
        ti = _arg_next(S, ti);
        if (TOKTYP(S, ti) != 31) { return argc; }   # the call's `)`, or EOF (best effort)
        argc = argc + 1;
        ti = ti + 1;
    }
    return argc;
}

# v6.5.1 — may `fi` be used as an overload-redirect target for a call supplying
# `argc` arguments? Shared by the _str and _int dispatch arms so the two cannot
# drift. The count is the target's min..max (6.7.7: a sibling that declares defaults fills the
# rest), judged alike for a sibling defined above or BELOW the call: pass 1 records every
# definition's count, variadic flag and defaults row (GFDS != 0) before pass 2 parses a call —
# the facts `_CHECK_ARITY` judges a forward call by. A VARIADIC target is unconstrained by
# construction.
# 6.7.9: a forward sibling was let through unjudged, so `pr(s)` reached a 2-parameter `pr_str`
# defined below it — garbage for the second parameter, refused naming `pr_str` since 6.7.7 —
# where the same sibling above the call was judged and `pr` ran.
# ⛔ 6.7.11 — a target with NO definition (offset < 0, GFDS 0: a name only called somewhere) never
# takes the call (the user's decision (b), 2026-10-13). It was routed "into the undefined-function
# diagnostic": `pr(s)`, written to the DEFINED `pr`, reached the undefined `pr_str` — under
# --allow-undef a trap (rc 132), by default a refusal only because the route made the name
# reachable. In an `object;` unit a sibling defined in another object is such a name too.
# CHANGELOG [6.5.1] [6.7.9] [6.7.11]
fn _OV_ARITY_OK(S, fi, argc): i64 {
    if (L64(_fnt_offsets + fi * 8) < 0) { if (GFDS(S, fi) == 0) { return 0; } }
    if (GFVA(S, fi) != 0) { return 1; }
    if (argc > L64(_fnt_params + fi * 8)) { return 0; }
    if (argc >= _pd_min(fi)) { return 1; }
    return 0;
}

# v5.8.20: #pure caller cannot call #io / #alloc callees. Warning
# (not error) for downstream incremental adoption — same shape as
# #must_use / #deprecated diagnostics. The annotation ramp happens
# gradually; cyrlint --strict will escalate to error in a follow-up.
# 6.6.17: one fn, so the method arm (`p.m(..)`, `_field_load_on`) runs it too — an impl
# method takes `#io` / `#alloc` since 6.6.17 (`_impl_attrs`).
fn _pure_effect_warn(S, fi, noff): i64 {
    if (_cur_fn_is_pure != 1) { return 0; }
    if (fi < 0) { return 0; }
    var fl = GFLG(S, fi);
    if (fl & 16 != 0) {
        syscall(SYS_WRITE, 2, "warning:", 8);
        _err_head(S);
        syscall(SYS_WRITE, 2, ": #pure fn calls #io fn '", 25);
        PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));
        syscall(SYS_WRITE, 2, "'\n", 2);
    }
    if (fl & 32 != 0) {
        syscall(SYS_WRITE, 2, "warning:", 8);
        _err_head(S);
        syscall(SYS_WRITE, 2, ": #pure fn calls #alloc fn '", 28);
        PRSTR(S + 0xEC00000 + _fn_src_name(S, fi, noff));
        syscall(SYS_WRITE, 2, "'\n", 2);
    }
    return 0;
}

# The first argument's scalar width for the `_int` overload route (cursor on its first token, an
# IDENT): a call `f(..)` declared to return a scalar (its GFRS, negated — 8 for `: i64`), else 0.
# ⛔ 6.7.6 (Break 1, lane D) — or 8 when the WHOLE argument is a name DECLARED an integer: a local or
# parameter (bit 59, SLINTD) or a global (GVINTD) annotated i8..i64 / u8..u64. `var n: i64 = 42;
# println(n);` handed n to println's `: cstring` overload, which dereferenced 42 — rc 139. An
# untyped name is never routed (ADR-002: it may hold a pointer). CHANGELOG [6.7.6]
fn _od_arg_kind(S): i64 {
    var nt = TOKTYP(S, GTI(S) + 1);
    if (nt == 10) {
        var fi = FINDFN(S, PEEKV(S));
        if (fi < 0) { return 0; }
        var r = GFRS(S, fi);
        if (r < 0) { return 0 - r; }
        return 0;
    }
    if (nt != 11) { if (nt != 31) { return 0; } }
    if (GINFN(S) == 1) {
        var li = FINDLOCAL(S, PEEKV(S));
        if (li >= 0) { return GLINTD(S, li) * 8; }
        if (_cl_capturing == 1) { if (_cl_env_lidx >= 0) {   # a closure's capture of one
                var esl = _cl_snap_find(S, PEEKV(S));
                if (esl >= 0) { return _cl_snap_intd(esl) * 8; }
            } }
    }
    var vi = _findvar_core(S, PEEKV(S));
    if (vi < 0) { return 0; }
    return GVINTD(S, vi) * 8;
}
# PARSE_FNCALL's struct-result arm (cursor just past the call's `(`): a >16 B result into an
# anonymous frame temp, whose first word is the expression's value (see the 6.6.6 note in
# PARSE_FNCALL); at top level refused by name, and 0 (the call is emitted as ever). 1 = emitted.
# 6.7.6: the call `_sc_fcw` names (a parenthesised declaration initialiser, `_scv_peel`) — and a
# 9-16 B result there too — is recorded as a method call's temp is, for `_sc_var_receive`.
fn _fnc_agg(S, fi, noff): i64 {
    if (_pe_vret(S, fi) == 1) { return _fnc_pe_vec(S, fi, noff); }   # 6.7.12
    var cls = _ret_agg_class(S, fi);
    if (cls == 0) { return 0; }
    var want = 0;
    if (_sc_fcw >= 0) { if (_gcall_open(S, _sc_fcw) == GTI(S) - 1) { want = 1; } }
    if (cls == 1) { if (want == 0) { return 0; } }
    if (GINFN(S) == 0) {
        if (cls == 2) { _refuse_toplevel_struct_call(S, noff); }
        return 0;
    }
    var o = GTI(S) - 1;
    var t = _agg_temp(S, GFRS(S, fi));
    _struct_call_emit(S, fi, noff, t);
    EFLLOAD(S, t);
    SESTYPE(S, 0);
    if (want == 1) {
        _sc_beg = _sc_fcw;
        _sc_end = GTI(S);
        _sc_tmp = t;
        _sc_sid = GFRS(S, fi);
        _sc_fn = noff;
        _sc_fi = fi;
    }
    _fnc_lo = o;   # 6.7.6: the temp, for a left operand (`_lsc_free`)
    _fnc_lt = t;
    _fnc_lcp = GCP(S);
    return 1;
}

# 6.7.12 — PARSE_FNCALL's Win64 vector arm (cursor just past the call's `(`): the call with its storage's address
# as int arg 0 (`_pe_vtemp`), the value its first word. 1 = emitted.
fn _fnc_pe_vec(S, fi, noff): i64 {
    var h = _pe_vtemp(S, fi);
    var n = _owncall_args(S, fi, noff, 1);
    var tgt = L64(_fnt_offsets + fi * 8);
    if (tgt >= 0) { ECALLTO(S, tgt); }
    else { ECALLFIX(S, fi); }
    ECALLCLEAN(S, n);
    _pe_vload(S, h);
    return 1;
}

# ⛔ 6.7.14 — A REPLAYED BODY'S `return` IS THE CALLEE'S, NEVER THE CALLER'S STRUCT RETURN. An inline
# candidate (a small generic, `#inline`) is not called but re-parsed inside the CALLER's fn context, so
# its `return` met the caller's struct-return class: `return GPA;` in `fn gpg<T>(): *T`, replayed in
# `fn r(): P2`, was refused as "a fn returning the 9-16 byte struct `P2` ... got `GPA`" (a struct the
# generic never names), and from a 24 B fn "struct-return: identifier is not a local"; a one-call body
# (`return gsel(sizeof(T));`) the same. The replay runs with the caller's struct class masked — sid and
# pair 0, the state an i64 caller already replays under — and restored after it. The caller's frame
# layout (`_cur_fn_ret_stash`) is untouched. The body's own locals keep a nested replay safe. One call
# in PARSE_FNCALL, as `_cov_body` was (cybs's per-fn reference ceiling). CHANGELOG [6.7.14]
# A panic latch the caller set (a refused argument) survives the replay: the body's statement ends clear
# it (`_stmt_resync`), so x86_64 / aarch64 / cx went on to print the next statement's refusal, which a real
# call (Win64's vector arm, a non-inline fn) leaves latched and skipped. CHANGELOG [6.7.15]
fn _inl_replay_body(S, fi): i64 {
    var sid = _cur_fn_ret_sid;
    var pair = _cur_fn_ret_pair;
    var pn = _panic;
    _cur_fn_ret_sid = 0;
    _cur_fn_ret_pair = 0;
    _cov_body(S, fi, 0 - 1);
    _cur_fn_ret_sid = sid;
    _cur_fn_ret_pair = pair;
    if (pn == 1) { _panic = 1; }
    return 0;
}

# PARSE_FNCALL's inline path, after the arguments: the local count goes back to just past the parameter slots,
# and `_flc_hwm` keeps the higher of that and the count the arguments reached. An argument may take frame
# temporaries at GFLC and above (a u128 operation's `_w128_tmp`, `_HTEMP`'s hidden temps) and give nothing to
# `_flc_hwm`; the frame was sized from the parameter slots alone, so `id(a) + id(a + 1)` (a u128) put `a + 1`'s
# temp past the frame, over the pushed left operand (84 for 83). As 6.7.13's INT-1 `_icall_slot` records its
# slot. The v6.3.37 (A3) parameter-slot record is the second bump. A helper: PARSE_FNCALL sits at cybs's per-fn
# reference ceiling. CHANGELOG [6.7.15]
fn _inl_flc_release(S, top): i64 {
    if (GFLC(S) > _flc_hwm) { _flc_hwm = GFLC(S); }
    SFLC(S, top);
    if (top > _flc_hwm) { _flc_hwm = top; }
    return 0;
}

# PARSE_FNCALL's overload routing on the FIRST argument (cursor on it, just past `(`): the routed
# callee, or -1 when the call is not routed (the caller then keeps its own `noff`, so a `use`
# alias keeps its name). Out of PARSE_FNCALL's body, which sits at cybs's per-fn reference
# ceiling. CHANGELOG [6.7.7]
fn _fnc_route(S, fi, noff): i64 {
    if (_pd_named_at(S, GTI(S) - 1) == 1) { return _pd_route_named(S, fi, noff); }   # 6.7.7 (B6): C10
    var r = 0 - 1;
    # v5.10.25 — registry-based overload dispatch on the FIRST argument: for a fn `<base>`
    # with a `<base>_str` / `<base>_int` sibling (tables filled at REGFN time; user pairs work
    # the same way), `base(arg, ..)` is routed to the sibling when the arg matches, behind the
    # v6.5.1 arity gate (`_OV_ARITY_OK`):
    #   _str — the WHOLE first argument is a Str, as `_str_arg_kind` (the I11 classifier) reads
    #          it: a Str local / param / capture, a `: Str` or inferred-Str global, a one-step
    #          `: Str` field (`h.name`, `gh.name`, `mkh().name`), or a call or method declared
    #          `: Str` (`mk()`, `g<T>(..)`, `s.cat(t)`, `mkh().getname()`). `println(gs)` ->
    #          `println_str`, `strlen(gs)` -> `strlen_str`. `x.data`, `x.len`, `s.len()`,
    #          `x + 1` are NOT routed by their base's type.
    #   _int — an `IDENT(..)` call returning i64 (GFRS -8), into an i64-returning base whose
    #          param 0 is `: cstring` (v6.0.3 / v6.5.2, below). A plain i64 IDENT is never
    #          routed here.
    # 6.6.16: the Str arm typed the argument itself — `0 - sid` against a global's positive
    # GVTYPE (so no Str global ever routed and `println(gs)` printed the header's pointer
    # bytes), no fields, and nothing required the name to END the argument, so `show(s.data)`
    # / `show(s.len)` on a Str local reached `show_str`, which read the VALUE as a header.
    # CHANGELOG [6.6.16]
    if (PEEKT(S) == 2) {
        var _od_arg_scalar = _od_arg_kind(S);   # 6.7.6: + a name declared an integer
        # The sibling first: the classifier scans a call argument's parens, and most bases
        # have no `_str` sibling to route to.
        var _od_str_target = L64(_fnt_ovstr + fi * 8);
        if (_od_str_target > 0) {
            var _od_str_sid = _STR_SID(S);
            if (_od_str_sid > 0) {
                if (_str_arg_kind(S, _od_str_sid) == 1) {
                    # v6.5.1 — arity-gate the redirect (see _OV_ARITY_OK).
                    var _od_st = _od_str_target - 1;
                    if (_OV_ARITY_OK(S, _od_st, _CALL_ARGC_PEEK(S)) == 1) {
                        fi = _od_st;
                        r = fi;
                    }
                }
            }
        }
        if (_od_arg_scalar == 8) {
            # v6.0.3 — Option A: only auto-route `base(i64-call) → base_int`
            # when the BASE is OUTPUT-style (declares an i64 return, e.g.
            # `println: i64`). DATA-producing bases (non-i64 return, e.g.
            # `str_from: Str`) must NOT auto-route. Reason: cyrius is
            # i64-everywhere (ADR-002), so the dispatcher cannot tell an
            # i64 that is a NUMBER from an i64 that is a POINTER. The arg
            # here is a fn-call returning i64 (e.g. `vec_get(): i64`,
            # which returns a cstr pointer). Routing `str_from(vec_get(..))`
            # to `str_from_int` STRINGIFIES the pointer's value (decimal)
            # instead of wrapping the cstr — silently corrupting data that
            # flows on (nous 0001: a cstr map key became "<pointer-decimal>"
            # → every lookup missed → cycle detection read acyclic). For an
            # output base the worst case is cosmetically-wrong output; for a
            # value-conversion base it is wrong DATA. `str_from` (Str return)
            # is the only such base in the stdlib; this gate blocks exactly
            # it while keeping `println`/`log_info`/… (i64 return) routing.
            # See CHANGELOG [6.0.3].
            if (GFRS(S, fi) == 0 - 8 && (L64(_fnt_cstrmask + fi * 8) & 1) != 0) {
                var _od_int_target = L64(_fnt_ovint + fi * 8);
                if (_od_int_target > 0) {
                    # v6.5.1 — arity-gate the redirect (see _OV_ARITY_OK).
                    var _od_it = _od_int_target - 1;
                    if (_OV_ARITY_OK(S, _od_it, _CALL_ARGC_PEEK(S)) == 1) {
                        fi = _od_it;
                        r = fi;
                    }
                }
            }
        }
    }
    # v5.10.39 — pointer-vs-value overload dispatch extension.
    # When the first arg is `&IDENT` (typ 27 = address-of), look up
    # `<base_name>_ptr` sibling by name. If found, route to it.
    # Enables consumers to call `f64v2_add(&x, &y)` and have the
    # parser auto-route to `f64v2_add_ptr` (v5.10.33 pointer-form),
    # while `f64v2_add(x, y)` (value-form, IDENT args) stays routed
    # to the base name via v5.10.38's caller-side SIMD-arg dispatch.
    #
    # Uses stack-local scratch + _FINDFN_CSTR — no tok_names bloat
    # (unlike the v5.10.25 forward/reverse registration which uses
    # the per-fn overload tables). Compile-time cost: O(N) name
    # compare over registered fns per pointer-form call site.
    if (PEEKT(S) == 27) {
        var _po_fi = _fnc_ptr_sib(S, noff);
        if (_po_fi >= 0) { r = _po_fi; }
    }
    return r;
}
# The `<base>_ptr` sibling of the fn named `noff`, or -1 (v5.10.39, above). Out of `_fnc_route` so
# C10 asks the same question (6.7.7).
fn _fnc_ptr_sib(S, noff): i64 {
    var _po_base_p = S + 0xEC00000 + noff;
    var _po_base_len = 0;
    while (load8(_po_base_p + _po_base_len) != 0) { _po_base_len = _po_base_len + 1; }
    # 128-byte scratch — must hold base_len + len("_ptr") + null.
    # The 120-char base-length guard below leaves headroom.
    # Pre-bumped from 16 bytes — was overflow-prone for any base
    # name >11 chars (e.g. `f64v2_add_ptr` direct call constructed
    # `f64v2_add_ptr_ptr` = 18 bytes; the overflow corrupted
    # adjacent stack data and returned wrong values from any fn
    # call that hit this dispatch path).
    if (_po_base_len >= 120) { return 0 - 1; }
    var _po_scratch[128];
    var _po_i = 0;
    while (_po_i < _po_base_len) {
        store8(&_po_scratch + _po_i, load8(_po_base_p + _po_i));
        _po_i = _po_i + 1;
    }
    store8(&_po_scratch + _po_base_len + 0, 95);   # '_'
    store8(&_po_scratch + _po_base_len + 1, 112);  # 'p'
    store8(&_po_scratch + _po_base_len + 2, 116);  # 't'
    store8(&_po_scratch + _po_base_len + 3, 114);  # 'r'
    store8(&_po_scratch + _po_base_len + 4, 0);
    return _FINDFN_CSTR(S, &_po_scratch, _po_base_len + 4);
}

# 1 when a call to `fi` must take the normal path even though the callee is inline-eligible.
# v6.4.31: on Win64 PE a value-form SIMD param (address-passed, struct_mask set) or a SIMD return
# (retptr-style) can't survive the inline replay, which homes args with an 8-byte EFLSTORE and
# returns scalar-in-rax — it would truncate the 16/32-byte vector; such callees take the normal
# struct-ptr / retptr path. 6.6.20: nor a REDEFINED fn (flag 2048, pass 1) on any target —
# replaying the body in hand bound the call to whichever definition came first; a plain call
# reaches the last one. 6.7.7: nor a call that names an argument — the replay binds by position
# (the one marshaller places names). Out of PARSE_FNCALL's body (cybs ceiling).
# CHANGELOG [6.6.20] [6.7.7]
fn _fnc_no_inline(S, fi): i64 {
    if (_TARGET_PE == 1) {
        if (_smask_args(fi) != 0) { return 1; }
        if (_is_simd_any(S, GFRS(S, fi)) == 1) { return 1; }
    }
    if ((GFLG(S, fi) & 2048) != 0) { return 1; }
    if (_pd_named_at(S, GTI(S) - 1) == 1) { return 1; }
    return 0;
}

fn PARSE_FNCALL(S, noff): i64 {
    STI(S, GTI(S) + 1);  # consume (
    # Check for inline candidate
    var fi = FINDFN(S, noff);
    if (fi < 0) { fi = REGFN(S, noff); }
    # 6.6.10: a generic callee — infer a struct type argument (-> its instance) or refuse a scalar
    # call of a stub generic. See _gen_call_head.
    var _gfi = _gen_call_head(S, fi, noff);
    if (_gfi != fi) { fi = _gfi; noff = L64(_fnt_names + fi * 8); }
    var _rfi = _fnc_route(S, fi, noff);   # 6.7.7: the routing, out of this body
    if (_rfi >= 0) { fi = _rfi; noff = L64(_fnt_names + fi * 8); }
    # v5.6.4: #deprecated call-site warning, with the `private` check (see
    # _callee_site_checks). It names the first token after the `(` we just consumed,
    # which is on the call-site's line.
    _callee_site_checks_here(S, fi, noff, 0);
    _pure_effect_warn(S, fi, noff);   # v5.8.20 (6.6.17: shared with the method arm)
    # ⛔ 6.6.6 — A >16 B STRUCT-RETURNING CALLEE WRITES ITS RESULT THROUGH A HIDDEN RETPTR, and
    # until 6.6.6 only `var p: S = f(..)` supplied one. Everywhere else — an expression
    # statement, an argument, `return f(..)` in a non-struct fn — the user args were marshalled
    # as if there were none: on x86 the callee took argument 1 as its destination (SIGSEGV
    # writing to 0x1), on aarch64 it wrote through whatever X8 held. Now the result lands in an
    # anonymous frame temp, and the expression's VALUE is its first word — exactly what a struct
    # local yields as an rvalue (`var k = r;`, `h(r)` into an untyped param), so the two agree.
    # At top level there is no frame to hold it: refused by name. CHANGELOG [6.6.6]
    if (_fnc_agg(S, fi, noff) == 1) { return 0; }   # 6.7.6: out of this body (cybs ceiling)
    var _pe_no_inline = _fnc_no_inline(S, fi);   # 6.7.7: out of this body
    if (GFINL(S, fi) != 0) { if (GIDEP(S) < 3) { if (GINFN(S) == 1) { if (_pe_no_inline == 0) {
                    # INLINE PATH: replay function body tokens at call site
                    var pc = L64(_fnt_params + fi * 8);
                    var saved_flc = GFLC(S);
                    # Allocate fresh frame slots for callee params
                    # v6.5.52 — slot widths come from the callee's recorded param types.
                    var _ipt = GFIPT(S, fi);
                    var _t0 = _ipt_sltype(_ipt, 0);
                    var _t1 = _ipt_sltype(_ipt, 1);
                    var _w0 = _ipt_slots(S, _t0);
                    var _w1 = _ipt_slots(S, _t1);
                    var _ptot = 0;
                    if (pc >= 1) { _ptot = _w0; }
                    if (pc >= 2) { _ptot = _w0 + _w1; }
                    # NAMED slot = deepest of each param's group (anon fillers precede it).
                    var p0_slot = saved_flc + _w0 - 1;
                    var p1_slot = saved_flc + _w0 + _w1 - 1;
                    # v6.3.38 (A-broad) — RESERVE the param slots BEFORE evaluating args, so a
                    # nested inline call while evaluating arg1 uses frame slots ABOVE p0/p1
                    # instead of reusing saved_flc and clobbering the already-stored arg0.
                    # (v6.3.37 A3 only reserved frame SIZE via _flc_hwm; this reserves the slot
                    # INDICES too by bumping GFLC up-front.) Idempotent with the old post-loop
                    # SFLC(saved_flc+pc); the _flc_hwm high-water still feeds the frame patch.
                    SFLC(S, saved_flc + _ptot);
                    if (saved_flc + _ptot > _flc_hwm) { _flc_hwm = saved_flc + _ptot; }
                    # v6.5.52 — INVALIDATE the reserved slots BEFORE evaluating args. The slots are
                    # reserved here but not bound until after the arg loop, and arg evaluation does
                    # name lookups that scan every slot below GFLC — so an unwritten slot is read as
                    # a NAME OFFSET. Whatever the frame held previously is then handed to STREQ as a
                    # string pointer. MEASURED: `rsi = 0xffffffff` at the fault, i.e. a stale `0 - 1`
                    # anon marker dereferenced as a pointer.
                    # ⚠ The pre-v6.5.52 code had the same ordering and survived only because it
                    # reserved exactly `pc` slots and both were overwritten immediately; widening a
                    # param to 2 or 4 slots exposed the latent hole.
                    # v6.5.65 — a fresh replay owns a fresh set of param slots; drop any provenance
                    # left by an enclosing inline so a stale slot index cannot be re-matched.
                    _prov_reset();
                    var _prov_win = GCP(S);
                    var _pini = 0;
                    while (_pini < _ptot) {
                        S64(S + 0x5D9D000 + (saved_flc + _pini) * 8, 0 - 1);
                        SLDEP(S, saved_flc + _pini, 0);
                        SLTYPE(S, saved_flc + _pini, 0);
                        _pini = _pini + 1;
                    }
                    # Evaluate args and store to param slots
                    var iargc = 0;
                    # 6.6.10: the head's inference (by the parameter that carries each type
                    # parameter; a struct never gets here — it instantiated). Was a positional
                    # re-inference in the loop below, so `g(2, p)` bound T from the `2`.
                    var _ginf0 = _gh_inf0;
                    var _ginf1 = _gh_inf1;
                    # v6.2.41 — capture call-site line for the arity warning below.
                    var _iar_line = GTLINE(S, GTI(S));
                    if (PEEKT(S) != 11) {
                        var iago = 1;
                        while (iago == 1) {
                            # v6.5.52 — a SIMD param takes the local-copy path; PCMPE cannot
                            # materialise a value-form vector (see _inl_simd_arg).
                            var _sd = 0;
                            # 6.6.17 (a9): a vector's sentinel is negative; an f64 / f32 tag is positive.
                            if (iargc == 0) { if (_t0 < 0) { _inl_simd_arg(S, p0_slot, _w0, _t0, fi); _sd = 1; } }
                            if (iargc == 1) { if (_t1 < 0) { _inl_simd_arg(S, p1_slot, _w1, _t1, fi); _sd = 1; } }
                            if (_sd == 0) {
                                _bx_pcmpe_arg(S, fi, iargc, noff);   # PCMPE + 6.7.3's bool check
                                if (iargc == 0) { _inl_store_arg(S, p0_slot, _w0); }
                                if (iargc == 1) { _inl_store_arg(S, p1_slot, _w1); }
                            }
                            iargc = iargc + 1;
                            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                            else { iago = 0; }
                        }
                    }
                    # v6.2.41 — arity check on the INLINE-replay path. Inline
                    # candidates are small fixed-arity fns (≤2 param slots), so a
                    # 1-param helper called with extra args lands HERE, not on the
                    # normal path — the normal-path check alone would miss it.
                    # 6.7.14: an unclosed list leaves its `;` (`_expect_step`) and has no count.
                    if (_expect_step(S, 11) == 1) { _CHECK_ARITY(S, _iar_line, noff, fi, iargc, 0); }
                    # Set local count past the param slots, keeping the argument temps' peak (see the helper)
                    _inl_flc_release(S, saved_flc + _ptot);
                    # Register callee param names as temporary locals (packed in fn_inline)
                    var inl_packed = GFINL(S, fi);
                    var pn0 = inl_packed & 0xFFFFFFFF;
                    var pn1 = (inl_packed >> 32) & 0xFFFFFFFF;
                    if (pc >= 1) { _inl_bind_param(S, saved_flc, _w0, p0_slot, pn0, _t0); }
                    if (pc >= 2) { _inl_bind_param(S, saved_flc + _w0, _w1, p1_slot, pn1, _t1); }
                    _inl_param_marks(S, fi, p0_slot, p1_slot, pc);   # 6.7.6: + an integer's bit 59
                    # Save state and replay body tokens
                    var saved_ti = GTI(S);
                    var saved_rpc = vec_len(rp_vec);
                    # v6.3.9 (F-fns): bind T->concrete for the body replay (the bite-4
                    # consults read it). Save the enclosing binding first so a generic
                    # body that itself inline-calls restores correctly. _bind_generic_call
                    # is a no-op for non-generic callees → default path is just the saves
                    # (4 reads, restored verbatim) → byte-identical.
                    var _gsv_n0 = _tp_n0; var _gsv_c0 = _tp_c0;
                    var _gsv_n1 = _tp_n1; var _gsv_c1 = _tp_c1;
                    _bind_inl_generic(S, fi, _ginf0, _ginf1);   # 6.6.17 (a3): an instance binds its own
                    SIDEP(S, GIDEP(S) + 1);
                    # v6.5.52 — the replayed body is a NESTED SCOPE, so bump the scope depth for it.
                    # The duplicate-variable check is `GLDEP(existing) == GSDEP()`, i.e. same-scope,
                    # and the replay previously bumped only the INLINE depth. A callee body that
                    # declares `var r` therefore collided with a caller local of the same name —
                    # which every value-form SIMD wrapper triggers, since they are all
                    # `var r: <vec>; ...; return r;` and callers routinely name a result `r`.
                    # Shadowing is the correct semantics here: FINDLOCAL searches backward so the
                    # body's `r` wins inside the body, and the teardown clears it so the caller's
                    # `r` is visible again afterwards.
                    var _sdep_saved = GSDEP(S);
                    SSDEP(S, _sdep_saved + 1);
                    # v6.5.59 — carry the CALLEE's return class across the replay. The body is
                    # re-parsed inside the CALLER's function context, so `_cur_fn_ret_*` still
                    # described the caller and `return r;` emitted the caller's convention. A
                    # 128-bit vector survived that by luck (one XMM, moved by the default path); a
                    # 256-bit return is a PAIR and its second register was never moved — lanes 0-1
                    # correct, lanes 2-3 STALE, exit 0, no diagnostic.
                    # ⚠ Caught only because the probe asserted ALL FOUR LANES.
                    var _rs_saved = _cur_fn_ret_scalar;
                    var _cfrs = GFRS(S, fi);
                    if (_is_simd_any(S, _cfrs) == 1) { _cur_fn_ret_scalar = _cfrs; }
                    STI(S, GFBS(S, fi));
                    _inl_replay_body(S, fi);   # 6.7.10 (P5-B) the coverage hit, then PARSE_PROG; 6.7.14 the caller's struct class masked
                    _cur_fn_ret_scalar = _rs_saved;
                    _inl_scope_end(S, _sdep_saved);   # 6.7.14: + the replay's local consts
                    _bx_falloff_fi(S, fi);   # 6.7.3: an inlined bool callee off its end is `false` too
                    _mret_falloff_fi(S, fi);   # 6.7.13 (D28 C): a declared multi-value one's values 0
                    # Patch return jumps from inlined body to here
                    var new_rpc = vec_len(rp_vec);
                    var ri = saved_rpc;
                    while (ri < new_rpc) {
                        EPATCH(S, vec_get(rp_vec, ri));
                        ri = ri + 1;
                    }
                    _ret_box_f64(S, _cfrs);   # 6.6.20: the replay's landing boxes for the CALLEE
                    vec_truncate(rp_vec, saved_rpc);
                    SIDEP(S, GIDEP(S) - 1);
                    # v6.3.9 (F-fns): restore the enclosing generic binding.
                    _tp_n0 = _gsv_n0; _tp_c0 = _gsv_c0;
                    _tp_n1 = _gsv_n1; _tp_c1 = _gsv_c1;
                    # v6.5.66 — the whole body has now been emitted, so "was this param slot ever read?"
                    # is finally answerable. Any copy that was neither read nor written is dead: NOP it.
                    # ⭐ This is also what makes the chain register-resident — the copy's load was the
                    # xmm0 clobber between a link's result store and the next link's read of it, so
                    # removing it lets SLASE collapse that pair too.
                    _prov_harvest(_prov_win, GCP(S));
                    # Restore token index
                    STI(S, saved_ti);
                    # Invalidate the temporary locals the replay created.
                    # v6.5.52: this now covers the WHOLE replay window — the param slots (a wide
                    # param owns (nslots-1) anon fillers below its named slot) AND any locals the
                    # replayed BODY declared. Leaving the body's names registered makes a second
                    # inline of the same callee redeclare them: every value-form SIMD wrapper is
                    # `var r: <vec>; <op>(&r, &a, &b, n); return r;`, so `f32v4_add` used twice in
                    # one fn reported "duplicate variable" at lib/simd.cyr. GFLC is restored too so
                    # the slots are reusable; `_flc_hwm` keeps the peak for frame sizing.
                    var _body_flc = GFLC(S);
                    if (_body_flc > _flc_hwm) { _flc_hwm = _body_flc; }
                    var _inv = saved_flc;
                    while (_inv < _body_flc) {
                        S64(S + 0x5D9D000 + _inv * 8, 0 - 1);
                        SLTYPE(S, _inv, 0);
                        _inv = _inv + 1;
                    }
                    # ⚠ GFLC is deliberately NOT restored. The inlined body's EMITTED CODE still
                    # addresses these frame slots at runtime, so handing them to a later local is a
                    # real aliasing bug — measured: restoring GFLC made simd_ints SIGSEGV at run
                    # time while compiling clean. Only the NAME registrations are cleared, which is
                    # what the duplicate-variable check reads; the slots stay spent.
                    return 0;
                } } } }
    # NORMAL CALL PATH — the one marshaller (6.7.7; the gates and their history are at
    # `_call_arg_one`). Args are pushed left to right; ECALLPOPS moves the last ones into the
    # argument registers and leaves the rest on the stack in order. The arity message names the
    # line of the first argument, captured before the loop advances (v6.2.41).
    var _fc_int_argc = _owncall_args_at(S, fi, noff, 0, 0, GTLINE(S, GTI(S)));
    var foff = L64(_fnt_offsets + fi * 8);
    if (foff >= 0) {
        ECALLTO(S, foff);
    } else {
        ECALLFIX(S, fi);
    }
    ECALLCLEAN(S, _fc_int_argc);
    # v6.4.56 D3 — a call result's type is i64, not its LAST argument's expr-type
    # (which the arg parse leaked). Normalize so an outer op on the call result
    # doesn't mis-see it as f64. (Also the D1 seam: a scalar-f64-returning callee
    # is re-tagged F64_TYID at the call site in parse_expr after this returns.)
    SESTYPE(S, 0);
    return 0;
}

# ⛔ 6.7.0 (A1, A2) — TRAITS, CHECKED. `trait Show { fn show(self): i64; fn twice(self): i64 { .. } }`
# declares a method set; `impl Show for T` is checked against it (an undeclared trait, a method
# the trait does not declare, a parameter count that differs and a required method left out are
# each a compile error naming the trait), and a method with a body in the trait is a DEFAULT,
# instantiated for every impl that does not supply its own — parsed from the trait's tokens with
# the impl's type, exactly as a generic instance is parsed from its base's.
# NAMES (the user's decision, 2026-10-07): a method keeps its plain `T_m` while only one trait (or
# an inherent impl) gives T an `m`, and is ALSO reachable as `T_Trait_m` (FINDFN's miss path,
# `_tr_fallback`). When two traits both give T an `m`, each is defined as `T_Trait_m` and the
# plain `T_m` / `p.m()` is an ambiguity error naming both — except inside an impl (or a default) of
# one of those traits, where `self.m()` means that trait's own. An inherent `impl T { fn m }` keeps
# `T_m`, so `p.m()` picks it and the trait's is `T_Trait_m`.
# Every trait and impl is recorded by ONE token pre-scan at the start of pass 1 (`_tr_prepass`), so
# a trait declared below its impl, and a collision with an impl further down, are known before the
# first method is registered. The tables are alloc'd on the first trait or impl, so a program with
# neither pays nothing. Caps are refused by name (never a silent overflow). CHANGELOG [6.7.0]
var _tr_tab = 0;    # per trait (4 words): name, first method, method count, `trait` token
var _tr_n = 0;
var _trm_tab = 0;   # per trait method (4 words): name, parameter count, default `fn` token + 1 (0 = required), trait
var _trm_n = 0;
var _trm_ft = 0;    # per trait method: its `fn` token (6.7.8; the trait-object call's lazy prototypes read it)
var _ti_tab = 0;    # per impl (8 words): trait name (0 = inherent), type name, first method, method count, `impl` token, `T_Trait` prefix (0 = not minted), trait index (-1 = unknown)
var _ti_n = 0;
var _tim_tab = 0;   # per impl method (3 words): name, `fn` token, parameter count
var _tim_n = 0;
var _tr_pend = 0;   # `_tr_arity`'s second result: the token after the `)`
var _tr_fb_busy = 0;
var _cur_ii = 0 - 1;   # the impl whose body is being parsed (pass 1 / pass 2), -1 = none

fn _tr_alloc(S): i64 {
    if (_tr_tab != 0) { return 0; }
    _tr_tab = alloc(1024 * 32);
    _trm_tab = alloc(8192 * 32);
    _trm_ft = alloc(8192 * 8);
    _ti_tab = alloc(4096 * 64);
    _tim_tab = alloc(32768 * 24);
    return 0;
}
fn _tr_cap(S, ti, what, n): i64 {
    var sv = GTI(S);
    STI(S, ti);
    ERR_MSG(S, what, n);
    STI(S, sv);
    return 0 - 1;
}
# Cursor-free: the parameter count of the list whose `(` is token `p`, and `_tr_pend` = the token
# after its `)`. A comma inside `<..>` (`m: Map<K, V>`) or nested parens is not a separator, and a
# parameter default is skipped whole (`_pl_dflt_end`).
fn _tr_arity(S, p): i64 {
    var q = p + 1;
    if (TOKTYP(S, q) == 11) { _tr_pend = q + 1; return 0; }
    var n = 1;
    var pd = 0;
    var ad = 0;
    while (TOKTYP(S, q) != 12) {
        var t = TOKTYP(S, q);
        if (t == 10) { pd = pd + 1; }
        elif (t == 11) {
            if (pd == 0) { _tr_pend = q + 1; return n; }
            pd = pd - 1;
        }
        elif (t == 19) { ad = ad + 1; }
        elif (t == 20) { ad = ad - 1; }
        elif (t == 39) { ad = ad - 2; }
        elif (t == 31) { if (pd == 0) { if (ad <= 0) { n = n + 1; } } }
        elif (t == 4) { if (pd == 0) { q = _pl_dflt_end(S, q); continue; } }   # 6.7.7: a default
        q = q + 1;
    }
    _tr_pend = q;
    return n;
}
# The token after the `}` that closes the block whose `{` is token `p`.
fn _tr_brace_end(S, p): i64 {
    var d = 0;
    var q = p;
    while (TOKTYP(S, q) != 12) {
        var t = TOKTYP(S, q);
        if (t == 13) { d = d + 1; }
        if (t == 14) {
            d = d - 1;
            if (d == 0) { return q + 1; }
        }
        q = q + 1;
    }
    return q;
}
# `fn` at token `p` (a trait or impl member): its `(` — past the name and any `<..>`. -1 = malformed.
fn _tr_paren(S, p): i64 {
    var q = p + 1;
    if (TOKTYP(S, q) != 2) { return 0 - 1; }
    q = q + 1;
    if (TOKTYP(S, q) == 19) {
        var ad = 0;
        while (TOKTYP(S, q) != 12) {
            var t = TOKTYP(S, q);
            if (t == 19) { ad = ad + 1; }
            elif (t == 20) { ad = ad - 1; }
            elif (t == 39) { ad = ad - 2; }
            q = q + 1;
            if (ad <= 0) { break; }
        }
    }
    if (TOKTYP(S, q) != 10) { return 0 - 1; }
    return q;
}

# ── the pre-scan ────────────────────────────────────────────────────────────────────────────
fn _tr_prepass(S): i64 {
    var p = 0;
    var d = 0;
    while (TOKTYP(S, p) != 12) {
        var t = TOKTYP(S, p);
        if (d == 0) {
            if (t == 167) { _tr_alloc(S); p = _tr_scan_trait(S, p); continue; }
            if (t == 77) { _tr_alloc(S); p = _tr_scan_impl(S, p); continue; }
        }
        if (t == 13) { d = d + 1; }
        if (t == 14) { if (d > 0) { d = d - 1; } }
        p = p + 1;
    }
    var i = 0;
    while (i < _ti_n) {
        var tn = L64(_ti_tab + i * 64);
        if (tn != 0) { S64(_ti_tab + i * 64 + 48, _tr_find(S, tn)); }
        i = i + 1;
    }
    return 0;
}
fn _tr_find(S, noff): i64 {
    var i = 0;
    while (i < _tr_n) {
        if (STREQ(S, L64(_tr_tab + i * 32), noff) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# `trait NAME { fn .. ; fn .. { .. } }` at token `ti`: record it; returns the token after its `}`.
fn _tr_scan_trait(S, ti): i64 {
    if (TOKTYP(S, ti + 1) != 2) { return ti + 1; }
    if (TOKTYP(S, ti + 2) != 13) { return ti + 2; }
    var end = _tr_brace_end(S, ti + 2);
    if (_tr_n >= 1024) { _tr_cap(S, ti, "too many traits (max 1024)", 26); return end; }
    var tx = _tr_n;
    S64(_tr_tab + tx * 32, TOKVAL(S, ti + 1));
    S64(_tr_tab + tx * 32 + 8, _trm_n);
    S64(_tr_tab + tx * 32 + 24, ti);
    _tr_n = _tr_n + 1;
    var p = ti + 3;
    while (p < end - 1) {
        if (TOKTYP(S, p) == 32) { p = _tr_scan_tm(S, tx, p, end); }
        else { p = p + 1; }
    }
    S64(_tr_tab + tx * 32 + 16, _trm_n - L64(_tr_tab + tx * 32 + 8));
    return end;
}
# A trait member `fn` at `p`: record it; returns the token after it (its `;`, or its body's `}`).
fn _tr_scan_tm(S, tx, p, end): i64 {
    var op = _tr_paren(S, p);
    if (op < 0) { return p + 1; }
    if (_pl_has_dflt(S, op) == 1) { _pd_trait_refuse(S, tx, p, op); }   # 6.7.7 (B6): D12 / D14 (F1)
    var ar = _tr_arity(S, op);
    var q = _tr_pend;
    while (q < end - 1) {
        var t = TOKTYP(S, q);
        if (t == 5 || t == 13) { break; }
        q = q + 1;
    }
    var dflt = 0;
    var nx = q + 1;
    if (TOKTYP(S, q) == 13) {
        dflt = p + 1;
        nx = _tr_brace_end(S, q);
    }
    if (_trm_n >= 8192) { _tr_cap(S, p, "too many trait methods (max 8192)", 33); return nx; }
    S64(_trm_tab + _trm_n * 32, TOKVAL(S, p + 1));
    S64(_trm_tab + _trm_n * 32 + 8, ar);
    S64(_trm_tab + _trm_n * 32 + 16, dflt);
    S64(_trm_tab + _trm_n * 32 + 24, tx);
    S64(_trm_ft + _trm_n * 8, p);
    _trm_n = _trm_n + 1;
    return nx;
}
# `impl X for T {` / `impl T {` at token `ti`: record it and its methods; returns the token after `}`.
fn _tr_scan_impl(S, ti): i64 {
    if (TOKTYP(S, ti + 1) != 2) { return ti + 1; }
    var trn = TOKVAL(S, ti + 1);
    var tn = trn;
    var ob = ti + 2;
    if (TOKTYP(S, ob) == 55) {
        if (TOKTYP(S, ti + 3) != 2) { return ti + 3; }
        tn = TOKVAL(S, ti + 3);
        ob = ti + 4;
    } else { trn = 0; }
    if (TOKTYP(S, ob) != 13) { return ob; }
    var end = _tr_brace_end(S, ob);
    if (_ti_n >= 4096) { _tr_cap(S, ti, "too many impl blocks (max 4096)", 31); return end; }
    var ii = _ti_n;
    S64(_ti_tab + ii * 64, trn);
    S64(_ti_tab + ii * 64 + 8, tn);
    S64(_ti_tab + ii * 64 + 16, _tim_n);
    S64(_ti_tab + ii * 64 + 32, ti);
    S64(_ti_tab + ii * 64 + 40, 0);
    S64(_ti_tab + ii * 64 + 48, 0 - 1);
    _ti_n = _ti_n + 1;
    var p = ob + 1;
    var d = 0;
    while (p < end - 1) {
        var t = TOKTYP(S, p);
        if (t == 13) { d = d + 1; }
        elif (t == 14) { d = d - 1; }
        elif (t == 32) { if (d == 0) { _tr_scan_im(S, p); } }
        p = p + 1;
    }
    S64(_ti_tab + ii * 64 + 24, _tim_n - L64(_ti_tab + ii * 64 + 16));
    return end;
}
fn _tr_scan_im(S, p): i64 {
    var op = _tr_paren(S, p);
    if (op < 0) { return 0; }
    if (_tim_n >= 32768) { _tr_cap(S, p, "too many impl methods (max 32768)", 33); return 0; }
    S64(_tim_tab + _tim_n * 24, TOKVAL(S, p + 1));
    S64(_tim_tab + _tim_n * 24 + 8, p);
    S64(_tim_tab + _tim_n * 24 + 16, _tr_arity(S, op));
    _tim_n = _tim_n + 1;
    return 0;
}

# ── queries ─────────────────────────────────────────────────────────────────────────────────
# The impl whose `impl` token is `ti`, -1 when none (no trait / impl tables, or not recorded).
fn _ti_by_ti(S, ti): i64 {
    var i = 0;
    while (i < _ti_n) {
        if (L64(_ti_tab + i * 64 + 32) == ti) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# The trait method `m` of trait `tx`, -1 when it declares none.
fn _trm_of(S, tx, m): i64 {
    if (tx < 0) { return 0 - 1; }
    var k = L64(_tr_tab + tx * 32 + 8);
    var e = k + L64(_tr_tab + tx * 32 + 16);
    while (k < e) {
        if (STREQ(S, L64(_trm_tab + k * 32), m) == 1) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}
# Impl `ii`'s own method `m`, -1 when it defines none.
fn _tim_of(S, ii, m): i64 {
    var k = L64(_ti_tab + ii * 64 + 16);
    var e = k + L64(_ti_tab + ii * 64 + 24);
    while (k < e) {
        if (STREQ(S, L64(_tim_tab + k * 24), m) == 1) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}
# 1 when impl `ii` gives its type a method `m`: its own, or its trait's default.
fn _ti_provides(S, ii, m): i64 {
    if (_tim_of(S, ii, m) >= 0) { return 1; }
    var k = _trm_of(S, L64(_ti_tab + ii * 64 + 48), m);
    if (k < 0) { return 0; }
    if (L64(_trm_tab + k * 32 + 16) != 0) { return 1; }
    return 0;
}
# For type name `tn` and method `m`: how many TRAIT impls provide it; `_tr_inh` = 1 when an inherent
# impl does too.
var _tr_inh = 0;
fn _tr_providers(S, tn, m): i64 {
    _tr_inh = 0;
    var n = 0;
    var i = 0;
    while (i < _ti_n) {
        if (STREQ(S, L64(_ti_tab + i * 64 + 8), tn) == 1) {
            if (_ti_provides(S, i, m) == 1) {
                if (L64(_ti_tab + i * 64) == 0) { _tr_inh = 1; }
                else { n = n + 1; }
            }
        }
        i = i + 1;
    }
    return n;
}
# The module prefix a method `m` of impl `ii` is defined under: its type name, unless it collides
# (two traits give the type an `m`, or a trait's `m` meets an inherent one), when it is `T_Trait`.
fn _tr_prefix(S, ii, m): i64 {
    var tn = L64(_ti_tab + ii * 64 + 8);
    var trn = L64(_ti_tab + ii * 64);
    if (trn == 0) { return tn; }
    var n = _tr_providers(S, tn, m);
    if (n < 2) { if (_tr_inh == 0) { return tn; } }
    var pf = L64(_ti_tab + ii * 64 + 40);
    if (pf == 0) {
        pf = _tr_join(S, tn, trn);
        S64(_ti_tab + ii * 64 + 40, pf);
    }
    return pf;
}
# Intern `a_b` in the name pool (NPOS advances); returns its offset.
fn _tr_join(S, a, b): i64 { return _tr_joinc(S, a, b, 95); }
# ... `a`, the byte `c`, `b` (6.7.8: a trait-object call's prototype is `dyn Show.show`, `c` = `.`).
fn _tr_joinc(S, a, b, c): i64 {
    var la = 0; while (load8(S + 0xEC00000 + a + la) != 0) { la = la + 1; }
    var lb = 0; while (load8(S + 0xEC00000 + b + lb) != 0) { lb = lb + 1; }
    NPOS_GUARD(S, la + 1 + lb + 1);
    var at = GNPOS(S);
    var w = at;
    var i = 0;
    while (i < la) { store8(S + 0xEC00000 + w, load8(S + 0xEC00000 + a + i)); w = w + 1; i = i + 1; }
    store8(S + 0xEC00000 + w, c);
    w = w + 1;
    i = 0;
    while (i < lb) { store8(S + 0xEC00000 + w, load8(S + 0xEC00000 + b + i)); w = w + 1; i = i + 1; }
    store8(S + 0xEC00000 + w, 0);
    SNPOS(S, w + 1);
    return at;
}
# 1 when method `m` of impl `ii` (a trait impl) collides — `_tr_prefix` without minting.
fn _tr_collides(S, ii, m): i64 {
    if (L64(_ti_tab + ii * 64) == 0) { return 0; }
    var n = _tr_providers(S, L64(_ti_tab + ii * 64 + 8), m);
    if (n >= 2) { return 1; }
    return _tr_inh;
}
# The string at `noff + at` starts with name `a` then `_`: the offset just past the `_`, else -1.
fn _tr_pfx(S, noff, at, a): i64 {
    var i = 0;
    var c = load8(S + 0xEC00000 + a);
    while (c != 0) {
        if (load8(S + 0xEC00000 + noff + at + i) != c) { return 0 - 1; }
        i = i + 1;
        c = load8(S + 0xEC00000 + a + i);
    }
    if (load8(S + 0xEC00000 + noff + at + i) != 95) { return 0 - 1; }
    return at + i + 1;
}
# FINDFN of `a_m`, built in scratch well past GNPOS (the name being looked up may itself be
# BUILD_METHOD_NAME's scratch AT GNPOS), so nothing is interned.
fn _tr_findfn_join(S, a, m): i64 { return FINDFN(S, _tr_scratch(S, a, m, 4096)); }
# `a_m` written `off` bytes past GNPOS — NOT interned, and clear of a scratch name at GNPOS.
fn _tr_scratch(S, a, m, off): i64 {
    var la = 0; while (load8(S + 0xEC00000 + a + la) != 0) { la = la + 1; }
    var lm = 0; while (load8(S + 0xEC00000 + m + lm) != 0) { lm = lm + 1; }
    NPOS_GUARD(S, off + la + lm + 2);
    var at = GNPOS(S) + off;
    var w = at;
    var i = 0;
    while (i < la) { store8(S + 0xEC00000 + w, load8(S + 0xEC00000 + a + i)); w = w + 1; i = i + 1; }
    store8(S + 0xEC00000 + w, 95);
    w = w + 1;
    i = 0;
    while (i < lm) { store8(S + 0xEC00000 + w, load8(S + 0xEC00000 + m + i)); w = w + 1; i = i + 1; }
    store8(S + 0xEC00000 + w, 0);
    return at;
}
# FINDFN's miss path. Returns a fn index, -1 = not a trait name, -2 = an ambiguity, reported.
fn _tr_fallback(S, noff): i64 {
    if (_tr_fb_busy == 1) { return 0 - 1; }
    _tr_fb_busy = 1;
    var r = _tr_fb_qual(S, noff);
    if (r == 0 - 1) { r = _tr_fb_ambig(S, noff); }
    _tr_fb_busy = 0;
    return r;
}
# `T_Trait_m` for a method that did not collide (so it is defined as `T_m`).
fn _tr_fb_qual(S, noff): i64 {
    var i = 0;
    while (i < _ti_n) {
        var trn = L64(_ti_tab + i * 64);
        if (trn != 0) {
            var tn = L64(_ti_tab + i * 64 + 8);
            var k = _tr_pfx(S, noff, 0, tn);
            if (k >= 0) { k = _tr_pfx(S, noff, k, trn); }
            if (k >= 0) {
                var m = noff + k;
                if (_ti_provides(S, i, m) == 1) { if (_tr_collides(S, i, m) == 0) { return _tr_findfn_join(S, tn, m); } }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}
# `T_m` where two traits give T an `m` and no inherent impl does.
fn _tr_fb_ambig(S, noff): i64 {
    var i = 0;
    while (i < _ti_n) {
        if (L64(_ti_tab + i * 64) != 0) {
            var tn = L64(_ti_tab + i * 64 + 8);
            var k = _tr_pfx(S, noff, 0, tn);
            if (k >= 0) {
                var m = noff + k;
                if (_ti_provides(S, i, m) == 1) {
                    if (_tr_providers(S, tn, m) >= 2) { if (_tr_inh == 0) { return _tr_ambig_hit(S, noff, i, tn, m); } }
                }
            }
        }
        i = i + 1;
    }
    return 0 - 1;
}
# Inside an impl (or a default) of one of the colliding traits for T, `m` means that trait's own;
# anywhere else the plain name is refused, naming a qualified spelling.
fn _tr_ambig_hit(S, noff, i, tn, m): i64 {
    if (_cur_ii >= 0) {
        if (L64(_ti_tab + _cur_ii * 64) != 0) { if (STREQ(S, L64(_ti_tab + _cur_ii * 64 + 8), tn) == 1) {
                if (_ti_provides(S, _cur_ii, m) == 1) { return _tr_findfn_join(S, _tr_prefix(S, _cur_ii, m), m); }
            } }
    }
    # Reported only AT a call site of the name — the token before the cursor spells it (a direct
    # `P_size(..)`) or its method part (`p.size()`). Lookups made elsewhere (a pre-scan of the
    # callee, the cursor parked in another file) answer "not found" and the site reports.
    if (_tr_at_site(S, noff, m) == 0) { return 0 - 1; }
    # The prefix was minted in pass 1 (every colliding method registered under it), so this does
    # not intern; the suggestion is scratch past the looked-up name, which may sit AT GNPOS.
    ERR_IDENT(S, "ambiguous method ", noff, ": more than one trait gives the type this method - call it by its trait-qualified name, e.g. ", _tr_scratch(S, _tr_prefix(S, i, m), m, 8192));
    return 0 - 2;
}

# An "undefined function" that is an AMBIGUOUS trait method (`P_size` where two traits give P a
# `size`): say so, and name a qualified spelling. The direct call reaches the lookup with no site to
# point at, so the note rides the undefined-function report instead. CHANGELOG [6.7.0]
fn _tr_undef_note(S, noff): i64 {
    if (_ti_n == 0) { return 0; }
    var i = 0;
    while (i < _ti_n) {
        if (L64(_ti_tab + i * 64) != 0) {
            var tn = L64(_ti_tab + i * 64 + 8);
            var k = _tr_pfx(S, noff, 0, tn);
            if (k >= 0) {
                var m = noff + k;
                if (_ti_provides(S, i, m) == 1) { if (_tr_providers(S, tn, m) >= 2) { if (_tr_inh == 0) {
                            syscall(SYS_WRITE, 2, "  note: it is ambiguous - more than one trait gives '", 53);
                            PRSTR(S + 0xEC00000 + tn);
                            syscall(SYS_WRITE, 2, "' this method; call it by its trait-qualified name, e.g. '", 58);
                            PRSTR(S + 0xEC00000 + _tr_scratch(S, _tr_prefix(S, i, m), m, 8192));
                            syscall(SYS_WRITE, 2, "'\n", 2);
                            return 1;
                        } } }
            }
        }
        i = i + 1;
    }
    return 0;
}
fn _tr_at_site(S, noff, m): i64 {
    var t = GTI(S) - 1;
    if (t < 0) { return 0; }
    if (TOKTYP(S, t) != 2) { return 0; }
    if (STREQ(S, TOKVAL(S, t), noff) == 1) { return 1; }
    if (STREQ(S, TOKVAL(S, t), m) == 1) { return 1; }
    return 0;
}

# ── pass hooks ─────────────────────────────────────────────────────────────────────────────
# The cursor is on a method's `fn` inside impl `_cur_ii`: define it under its prefix (`_tr_prefix`).
fn _tr_mod_for(S): i64 {
    if (_cur_ii < 0) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
    SMOD(S, _tr_prefix(S, _cur_ii, TOKVAL(S, GTI(S) + 1)));
    return 0;
}
fn _tr_mod_back(S): i64 {
    if (_cur_ii < 0) { return 0; }
    SMOD(S, L64(_ti_tab + _cur_ii * 64 + 8));
    return 0;
}
# Every default method of impl `ii`'s trait that it does not define itself: registered (`mode` 0,
# pass 1) or defined (1, pass 2) from the trait's own `fn` token, under the impl's type. The
# cursor is put back; SMOD is left on the impl's type.
fn _tr_defaults(S, ii, mode): i64 {
    if (ii < 0) { return 0; }
    var tx = L64(_ti_tab + ii * 64 + 48);
    if (tx < 0) { return 0; }
    var sv = GTI(S);
    var k = L64(_tr_tab + tx * 32 + 8);
    var e = k + L64(_tr_tab + tx * 32 + 16);
    while (k < e) {
        var dt = L64(_trm_tab + k * 32 + 16);
        var m = L64(_trm_tab + k * 32);
        if (dt != 0) { if (_tim_of(S, ii, m) < 0) {
                SMOD(S, _tr_prefix(S, ii, m));
                STI(S, dt - 1);
                _pub_pending = 0;
                if (mode == 0) { _prescan_fn_sig(S); } else { PARSE_FN_DEF(S); }
            } }
        k = k + 1;
    }
    SMOD(S, L64(_ti_tab + ii * 64 + 8));
    STI(S, sv);
    return 0;
}
# 1 when impl method `k`'s parameters beyond the trait's `want` are exactly its defaulted ones: the
# count differs only by the parameters the definition's refusal already named ("its parameters take
# no defaults", D13) — one `k = 1` is one error, not a second "different number of parameters".
# CHANGELOG [6.7.11]
fn _tr_dflt_extra(S, k, want): i64 {
    var op = _tr_paren(S, L64(_tim_tab + k * 24 + 8));
    if (op < 0) { return 0; }
    if (_pd_first_eq(S, op) < 0) { return 0; }
    if (_pd_req_n(S, op) == want) { return 1; }
    return 0;
}
# The parameters of the list whose `(` is token `op` before its first default.
fn _pd_req_n(S, op): i64 {
    var q = op + 1;
    if (TOKTYP(S, q) == 11) { return 0; }
    var k = 0;
    var n = GTCNT(S);
    while (q < n) {
        if (_pl_eq(S, q) >= 0) { return k; }
        k = k + 1;
        q = _pl_next(S, q);
        if (TOKTYP(S, q) != 31) { return k; }
        q = q + 1;
    }
    return k;
}
# Pass 2: impl `ii` against its trait. Every error names the trait.
fn _tr_check_impl(S, ii): i64 {
    if (ii < 0) { return 0; }
    var trn = L64(_ti_tab + ii * 64);
    if (trn == 0) { return 0; }
    var tx = L64(_ti_tab + ii * 64 + 48);
    if (tx < 0) {
        ERR_IDENT(S, "impl of undeclared trait ", trn, " for ", L64(_ti_tab + ii * 64 + 8));
        return 0;
    }
    var k = L64(_ti_tab + ii * 64 + 16);
    var e = k + L64(_ti_tab + ii * 64 + 24);
    while (k < e) {
        var m = L64(_tim_tab + k * 24);
        var tk = _trm_of(S, tx, m);
        if (tk < 0) {
            ERR_IDENT(S, "method ", m, " is not declared in trait ", trn);
            return 0;
        }
        if (L64(_tim_tab + k * 24 + 16) != L64(_trm_tab + tk * 32 + 8)) { if (_tr_dflt_extra(S, k, L64(_trm_tab + tk * 32 + 8)) == 0) {
                ERR_IDENT(S, "method ", m, " takes a different number of parameters than its declaration in trait ", trn);
                return 0;
            } }
        if (_tr_ret_chk(S, ii, tk, k) == 1) { return 0; }   # 6.7.15 (D4): and its return type
        k = k + 1;
    }
    k = L64(_tr_tab + tx * 32 + 8);
    e = k + L64(_tr_tab + tx * 32 + 16);
    while (k < e) {
        if (L64(_trm_tab + k * 32 + 16) == 0) { if (_tim_of(S, ii, L64(_trm_tab + k * 32)) < 0) {
                ERR_IDENT(S, "impl is missing method ", L64(_trm_tab + k * 32), ", required by trait ", trn);
                return 0;
            } }
        k = k + 1;
    }
    return 0;
}
# ⛔ 6.7.15 (D4) — AN IMPL METHOD'S RETURN TYPE IS CHECKED AGAINST ITS TRAIT MEMBER'S, at the impl (`ii` the impl,
# `tk` the member, `k` the method), beside the parameter count: `trait T { fn c(self): f64; }` implemented as
# `fn c(self): i64` compiled, and a bounded generic caller declared `: f64` received the integer bits. Compared as
# forming a dyn compares it (`_dyn_ret_at` / `_dyn_ty_eq`: a name by its resolved type, no annotation an i64), each
# spelling read as the annotation reader reads it (`_ty_norm_eq`: `>>` two closes, `Box<i64>` the base `Box`) and
# refused by name, "'P.c' returns i64, trait 'T' declares f64" (the user's D4 (a), 2026-10-18). A side whose return its
# own reader refuses is that refusal alone (`_tr_rt_bad`). Parameter types are not compared (D4 leaves them out).
# 1 = refused. CHANGELOG [6.7.15]
var _trr_a = 0;    # the member's return type's tokens [_trr_a, _trr_ae); the method's [_trr_b, _trr_be)
var _trr_ae = 0;
var _trr_b = 0;
var _trr_be = 0;
fn _tr_ret_chk(S, ii, tk, k): i64 {
    var fp = L64(_tim_tab + k * 24 + 8);
    if (_tr_ret_differs(S, L64(_trm_ft + tk * 8), fp) == 0) { return 0; }
    var at = _trr_b;
    if (at == _trr_be) { at = fp + 1; }   # no annotation: at the method's name
    return _tr_ret_err(S, ii, L64(_tim_tab + k * 24), at);
}
# 1 when the member at `fn` token `tp` and the method at `fp` return different types and neither return is one its own
# reader refuses: the impl is refused for it (`_tr_ret_chk`), and forming a dyn from it adds nothing (`_dyn_pair_chk`).
fn _tr_ret_differs(S, tp, fp): i64 {
    var a = _tr_paren(S, tp);
    var b = _tr_paren(S, fp);
    if (a < 0 || b < 0) { return 0; }
    _trr_a = _dyn_ret_at(S, a);
    _trr_ae = _dps_te;
    _trr_b = _dyn_ret_at(S, b);
    _trr_be = _dps_te;
    if (_ty_norm_eq(S, _trr_a, _trr_ae, _trr_b, _trr_be) == 1) { return 0; }   # `Box<i64>` is `Box`, `>>` is `> >`
    if (_tr_rt_bad(S, _trr_a, _trr_ae, 0) == 1) { return 0; }
    if (_tr_rt_bad(S, _trr_b, _trr_be, 1) == 1) { return 0; }
    return 1;
}
# 1 when the return type [a, ae) is refused by its own reader — the trait's for a member (`im` 0), PARSE_FN_DEF's for a
# method (1): a slice, `u128` or `Vec` as the type, a name that is no type, and for a method a name a fn's return does
# not take (`_tn_ret_report`'s: u8..u64, f32, an enum).
fn _tr_rt_bad(S, a, ae, im): i64 {
    if (a == ae) { return 0; }
    if (_sl_ann_at(S, a) == 1) { return 1; }
    if (TOKTYP(S, a) == 105) { return 1; }
    if (_trs_ret_vec(S, a) == 1) { return 1; }
    if (im == 1) { if (_tr_rt_nonret(S, a) == 1) { return 1; } }
    var k = a;
    while (k < ae) {
        if (TOKTYP(S, k) == 2) { if (_tn_resolve_at(S, k) == 0) { return 1; } }
        k = k + 1;
    }
    return 0;
}
fn _tr_rt_nonret(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var noff = TOKVAL(S, ti);
    if (_classify_return_type(S, noff) != 0) { return 0; }
    if (_bx_is_bool_name(S, noff) == 1) { return 0; }
    if (_tn_resolve_at(S, ti) == _tn_code(4, 7)) { return 0; }   # a type parameter
    return 1;
}
# "'P.c' returns i64, trait 'T' declares f64" at token `at` (the method's return type, or its name), once; not a
# panic — nothing is consumed. The two types as written (no annotation is i64).
fn _tr_ret_err(S, ii, m, at): i64 {
    if (_panic == 1) { return 1; }
    if (_tn_once(S, at) == 0) { return 1; }
    var sv = GTI(S);
    STI(S, at);
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    PRSTR(": '");
    PRSTR(S + 0xEC00000 + L64(_ti_tab + ii * 64 + 8));
    PRSTR(".");
    PRSTR(S + 0xEC00000 + m);
    PRSTR("' returns ");
    _tr_rt_pr(S, _trr_b, _trr_be);
    PRSTR(", trait '");
    PRSTR(S + 0xEC00000 + L64(_ti_tab + ii * 64));
    PRSTR("' declares ");
    _tr_rt_pr(S, _trr_a, _trr_ae);
    PRSTR("\n");
    _err_excerpt(S);
    _had_error = 1;
    STI(S, sv);
    return 1;
}
fn _tr_rt_pr(S, a, ae): i64 {
    if (a == ae) { PRSTR("i64"); return 0; }
    return _rcv_ann_pr(S, a, ae);
}
# Pass 1: a `trait` declaration was recorded by the pre-scan — skip it.
fn _tl_trait1(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti + 1) == 2) { if (TOKTYP(S, ti + 2) == 13) { STI(S, _tr_brace_end(S, ti + 2)); return 0; } }
    STI(S, ti + 1);
    return 0;
}
# Pass 2: a `trait` declaration — check its shape and skip it (a default is emitted per impl).
fn _tl_trait2(S): i64 {
    var ti = GTI(S);
    if (TOKTYP(S, ti + 1) != 2) { STI(S, ti + 1); ERR_EXPECT(S, 2); return 0; }
    if (TOKTYP(S, ti + 2) != 13) { STI(S, ti + 2); ERR_EXPECT(S, 13); return 0; }
    var nm = TOKVAL(S, ti + 1);
    var end = _tr_brace_end(S, ti + 2);
    var tx = _tr_find(S, nm);
    if (tx >= 0) { if (L64(_tr_tab + tx * 32 + 24) != ti) {
            STI(S, ti + 1);
            ERR_IDENT(S, "duplicate trait ", nm, " (declared twice)", 0 - 1);
            STI(S, end);
            return 0;
        } }
    var p = ti + 3;
    while (p < end - 1) {
        if (TOKTYP(S, p) != 32) {
            STI(S, p);
            ERR_IDENT(S, "a trait body holds only `fn` declarations - in trait ", nm, 0, 0 - 1);
            STI(S, end);
            return 0;
        }
        var p0 = p;
        var op = _tr_paren(S, p);
        if (op < 0) { STI(S, p + 1); ERR_EXPECT(S, 2); STI(S, end); return 0; }
        _tr_arity(S, op);
        var q = _tr_pend;
        while (q < end - 1) {
            var t = TOKTYP(S, q);
            if (t == 5 || t == 13) { break; }
            q = q + 1;
        }
        if (TOKTYP(S, q) == 13) { p = _tr_brace_end(S, q); }
        elif (TOKTYP(S, q) == 5) { p = q + 1; }
        else { STI(S, q); ERR_MSG(S, "a trait method declaration ends with ';' (required) or a body (a default)", 73); STI(S, end); return 0; }
        if (_tr_dup_meth(S, tx, TOKVAL(S, op - 1)) == 1) {
            STI(S, op - 1);
            ERR_IDENT(S, "duplicate method ", TOKVAL(S, op - 1), " in trait ", nm);
            STI(S, end);
            return 0;
        }
        _tr_sig_check(S, tx, p0, op, q);   # 6.7.8: the signature itself
    }
    STI(S, end);
    return 0;
}

# ⛔ 6.7.8 — A TRAIT MEMBER'S SIGNATURE IS PARSED. The pre-scan reads a member's name and counts its
# commas (the impl's arity check), and until 6.7.8 nothing else read it: junk in a required
# signature (`fn sh(self, n + foo bar): i64;`), an unknown type name, or junk in a default that every
# impl overrides compiled, unread. Pass 2 walks each member's signature here, at the trait, emitting
# nothing, with PARSE_FN_DEF's grammar and its words: `( [param {, param}] ) [: Ret]` and then the
# `;` or the body; a param is `name [: Type] [= default]` or `...` (last); a Type is `*`.. then a
# name [<..>], a tuple `( Type, .. )`, `u128`, or `*fn( Type, .. ) [: Type]`. A grammar error is
# reported even under `--syntax-only` (lint asks exactly that) and never holds the panic latch, so
# every member of a file reports; an unknown name is `_tn_refuse`'s (silent under `--syntax-only`).
# One report per member. A default that some impl INHERITS is skipped: PARSE_FN_DEF parses that one
# whole for the impl (`_tr_defaults`), so its signature is checked there, and reported once.
# CHANGELOG [6.7.8]
var _trs_bad = 0;   # the member being walked has reported (or stopped)
# Member `fn` token `p` of trait `tx`: its `(` is token `op`, its `;` / body `{` token `q`.
fn _tr_sig_check(S, tx, p, op, q): i64 {
    if (TOKTYP(S, q) == 13) { if (_tr_dflt_inh(S, tx, TOKVAL(S, p + 1)) == 1) { return 0; } }
    _trs_bad = 0;
    _trs_fn = p + 1;   # 6.7.15 (D7)
    var i = _trs_params(S, op + 1, q);
    if (_trs_bad == 0) {
        if (TOKTYP(S, i) == 49) {
            if (TOKTYP(S, i + 1) == 10) { i = _trs_type(S, i + 1, q, " in a multi-value return type", 0 - 1); }
            elif (_trs_ret_refused(S, i + 1) == 0) { i = _trs_type(S, i + 1, q, " as a fn return type", 0 - 1); }
        }
    }
    if (_trs_bad == 0) { if (i != q) { _trs_end(S, i); } }
    _trs_fn = 0;
    return 0;
}
# ⛔ 6.7.15 (D9, D3) — A TRAIT MEMBER'S RETURN TYPE IS HELD TO A FN'S RETURN VOCABULARY FOR `Vec` AND `u128` (`ti` the
# type's first token, past the `:`): `fn a(self): Vec<i64>;` and `fn n(self): u128;` compiled, though no impl can
# define them — an impl's `fn a(self): Vec<i64>` / `fn n(self): u128` is refused, as any fn's is. Refused at the member,
# once, with the fn's words: "type 'Vec' cannot be a fn return type" and its note (`_tn_ret_report`; a bare `: Vec`
# too; silent under `--syntax-only`, as the fn's is), "`u128` is not supported as a fn return type yet" (`_u128_refuse`,
# reported under `--syntax-only` too, as the fn's is). `: *Vec<T>`, `: *u128`, a `*fn( .. ): Vec<T>` / `*fn( .. ): u128`
# type's own return and a parameter `v: Vec<T>` are unchanged (the user's D9 (a) and D3 (a), 2026-10-18). 1 = refused
# (the member's walk ends). CHANGELOG [6.7.15]
fn _trs_ret_refused(S, ti): i64 {
    if (TOKTYP(S, ti) == 105) {
        _trs_bad = 1;
        _u128_refuse(S, ti, "a fn return type yet");
        return 1;
    }
    if (_trs_ret_vec(S, ti) == 0) { return 0; }
    _trs_bad = 1;
    if (_syntax_only == 1) { return 1; }
    var sv = GTI(S);
    STI(S, ti);
    _tn_ret_report(S, ti);
    STI(S, sv);
    return 1;
}
# 1 when token `ti` is the built-in `Vec` (no program struct of that name), with or without its `<..>`.
fn _trs_ret_vec(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var noff = TOKVAL(S, ti);
    if ((L64(S + 0xEC00000 + noff) & 0xFFFFFFFF) != 0x00636556) { return 0; }   # "Vec\0"
    if (FINDSTRUCT(S, noff) > 0) { return 0; }
    return 1;
}
# 1 when an impl of trait `tx` does not define `m` — it inherits the default.
fn _tr_dflt_inh(S, tx, m): i64 {
    if (tx < 0) { return 0; }
    var i = 0;
    while (i < _ti_n) {
        if (L64(_ti_tab + i * 64 + 48) == tx) { if (_tim_of(S, i, m) < 0) { return 1; } }
        i = i + 1;
    }
    return 0;
}
# The parameter list from token `i` (just past its `(`): the token after its `)`.
fn _trs_params(S, i, q): i64 {
    if (TOKTYP(S, i) == 11) { return i + 1; }
    while (_trs_bad == 0) {
        if (TOKTYP(S, i) == 112) { i = i + 1; }   # `...`: the last
        else {
            if (TOKTYP(S, i) != 2) { return _trs_err(S, i, 2); }
            var pn = TOKVAL(S, i);
            i = i + 1;
            if (TOKTYP(S, i) == 49) { i = _trs_type(S, i + 1, q, " for parameter ", pn); }
            if (_trs_bad == 1) { return i; }
            if (TOKTYP(S, i) == 4) {   # 6.7.7 (B6): refused in pass 1 (`_pd_trait_refuse`); stepped over
                i = _pl_dflt_end(S, i);
                if (i > q) { i = q; }
            }
            if (TOKTYP(S, i) == 31) {
                i = i + 1;
                continue;
            }
        }
        if (TOKTYP(S, i) != 11) { return _trs_err(S, i, 11); }
        return i + 1;
    }
    return i;
}
# A type from token `i`; the token after it. `tail` / `nm` name the site in an unknown-type refusal.
fn _trs_type(S, i, q, tail, nm): i64 {
    var st = 0;
    while (TOKTYP(S, i) == 8) {
        i = i + 1;
        st = 1;
    }
    # 6.7.8 — a slice in a trait member's signature is refused BY NAME, as in a fn definition (C2-6a's
    # texts): the reader had no slice arm, so `[` met "expected identifier" and `slice<..>` "unknown
    # type 'slice'" (issues/2026-10-09-slice-type-outside-fn-local-misdiagnosed.md, the residual).
    if (_sl_ann_at(S, i) == 1) {
        _trs_bad = 1;
        if (st == 1) { _sl_err_ptr(S, i); return i; }
        if (nm >= 0) {
            _sl_err(S, i, "a slice cannot be a parameter (6.7.8: slices are fn-locals)",
              " - pass &s and read slice_ptr / slice_len, or the pointer and the length");
            return i;
        }
        _sl_err(S, i, "a slice cannot be a return type (6.7.8: slices are fn-locals)",
          " - fill a slice the caller passes as &s (slice_set), or return the pointer and the length");
        return i;
    }
    var t = TOKTYP(S, i);
    if (t == 105) { return _trs_u128(S, i, st, nm); }   # u128 (6.7.14: not a parameter / return type yet)
    if (t == 10) { return _trs_inner(S, i + 1, q, tail, nm); }   # a tuple
    if (t == 32) { if (st == 1) {   # `*fn( .. ) [: T]`
            if (TOKTYP(S, i + 1) != 10) { return _trs_err(S, i + 1, 10); }
            i = _trs_inner(S, i + 2, q, tail, nm);
            if (_trs_bad == 0) { if (TOKTYP(S, i) == 49) { i = _trs_type(S, i + 1, q, tail, nm); } }
            return i;
        } }
    if (t != 2) { return _trs_err(S, i, 2); }
    _trs_name(S, i, tail, nm);
    i = i + 1;
    if (TOKTYP(S, i) != 19) { return i; }
    _vec_ann_chk(S, i - 1, nm);   # 6.7.14 (D4): `v: Vec<T>` reads T, as in a fn definition
    _trs_targs(S, i - 1);         # 6.7.15 (D7): `b: Box<nosuch>` reads its list
    var d = 0;   # `<..>` is skipped, as PARSE_FN_DEF's SKIP_GENERICS does
    while (i < q) {
        t = TOKTYP(S, i);
        if (t == 19) { d = d + 1; }
        elif (t == 20) { d = d - 1; }
        elif (t == 39) { d = d - 2; }
        elif (t == 152) { d = d - 3; }
        i = i + 1;
        if (d <= 0) { return i; }
    }
    return _trs_err(S, i, 20);
}
# ⛔ 6.7.15 (D7) — A GENERIC STRUCT'S TYPE ARGUMENTS IN A TRAIT MEMBER'S SIGNATURE (`ti` the struct's name, its `<`
# next) are read, as a fn definition's are since 6.7.14 (`_gtype_sid_def`): the list was skipped unread, so
# `fn a(self, b: Box<nosuch>): i64;` compiled as the base `Box`. Every type-argument refusal once at its token
# (`_targ_chk`, nothing instantiated); the member's own `<U>` stays a name (`_trs_fn`). A refusal ends the member's
# walk, as the reader's others do (the user's D7 (a), 2026-10-18). CHANGELOG [6.7.15]
var _trs_fn = 0;   # the walked member's `fn` token + 1 (0 = none): its own type parameters are names
fn _trs_targs(S, ti): i64 {
    if (_MONOMORPH_OK != 1) { return 0; }
    if (_trs_bad == 1) { return 0; }
    var sid = FINDSTRUCT(S, TOKVAL(S, ti));
    if (sid <= 0) { return 0; }
    if (GSTP(S, sid - 1) == 0) { return 0; }
    var sv_rf = _ta_refd;
    _ta_refd = 0;
    _targ_chk(S, ti + 1);
    if (_ta_refd == 1) { _trs_bad = 1; }
    _ta_refd = sv_rf;
    return 0;
}
# 6.7.14 (D10 (a)): a trait member's `u128` PARAMETER is refused as a fn definition's is (`_pty_u128`); behind a
# `*`, or inside a tuple / `*fn( .. )` list (`_trs_lvl`), unchanged. The member's own `: u128` return is refused
# before this reader (`_trs_ret_refused`, 6.7.15's D3); one met here with no parameter (`nm < 0`) is a multi-value
# element's or a `*fn( .. )` type's return, which reads on.
var _trs_lvl = 0;
fn _trs_u128(S, i, st, nm): i64 {
    if (nm < 0) { return i + 1; }
    if (st == 0) { if (_trs_lvl == 0) {
            _u128_refuse(S, i, "a parameter type yet - pass `*u128`");
            _trs_bad = 1;
        } }
    return i + 1;
}
fn _trs_inner(S, i, q, tail, nm): i64 {
    _trs_lvl = _trs_lvl + 1;
    var r = _trs_list(S, i, q, tail, nm);
    _trs_lvl = _trs_lvl - 1;
    return r;
}
# The types of a `( .. )` from token `i` (just past its `(`), comma-separated: the token after `)`.
fn _trs_list(S, i, q, tail, nm): i64 {
    if (TOKTYP(S, i) == 11) { return i + 1; }
    while (_trs_bad == 0) {
        i = _trs_type(S, i, q, tail, nm);
        if (_trs_bad == 1) { return i; }
        if (TOKTYP(S, i) != 31) {
            if (TOKTYP(S, i) != 11) { return _trs_err(S, i, 11); }
            return i + 1;
        }
        i = i + 1;
    }
    return i;
}
# A type name at token `i`: a type in scope (the member's own `<U>` included), or, for a parameter,
# a by-name handle (`s: Str` with no lib/str.cyr — `_tn_param_check`'s rule). Else refused by name.
fn _trs_name(S, i, tail, nm): i64 {
    if (_tn_resolve_at(S, i) != 0) { return 0; }
    if (nm >= 0) { if (_classify_param_type(S, TOKVAL(S, i)) != 0) { return 0; } }
    _tn_refuse(S, i, tail, nm);
    if (_syntax_only == 0) { _trs_bad = 1; }
    return 0;
}
# A grammar error at token `ti` (ERR_EXPECT's words), the latch it set cleared; returns `ti`.
fn _trs_err(S, ti, et): i64 {
    _trs_bad = 1;
    if (_panic == 1) { return ti; }
    var sv = GTI(S);
    STI(S, ti);
    ERR_EXPECT(S, et);
    _panic = 0;
    STI(S, sv);
    return ti;
}
# A token between the signature and its `;` / body.
fn _trs_end(S, ti): i64 {
    if (_panic == 1) { return 0; }
    var sv = GTI(S);
    STI(S, ti);
    ERR_MSG(S, "a trait method declaration ends with ';' (required) or a body (a default)", 73);
    _panic = 0;
    STI(S, sv);
    return 0;
}
# 1 when trait `tx` declares `m` more than once.
fn _tr_dup_meth(S, tx, m): i64 {
    if (tx < 0) { return 0; }
    var n = 0;
    var k = L64(_tr_tab + tx * 32 + 8);
    var e = k + L64(_tr_tab + tx * 32 + 16);
    while (k < e) {
        if (STREQ(S, L64(_trm_tab + k * 32), m) == 1) { n = n + 1; }
        k = k + 1;
    }
    if (n > 1) { return 1; }
    return 0;
}

# ⛔ 6.7.1 (C3) — TRAIT BOUNDS ON TYPE PARAMETERS. `fn f<T: Show + Eq>(v: T)` and `struct Box<T: Show>`.
# Before 6.7.1 `<T: Show>` minted a SECOND type parameter named `Show` (`_capture_tparams` took every
# identifier in the list), so `f(p)` with a struct was refused as "a struct beside a second type
# argument". Decisions (user, 2026-10-07):
#   * a bound is a CONTRACT — on a bounded T-typed parameter or local, `v.m()` must be a method of a
#     bound's trait, checked at the generic's DEFINITION (pass 1), and the bound picks that trait's
#     `m` when T has a colliding one (as `self.m()` does inside an impl, ADR-007). Fields are not part
#     of a trait and still resolve per instance; an UNBOUNDED T keeps per-instance resolution.
#   * `T: A + B` requires every impl; the same syntax bounds a generic struct's parameter.
#   * a bound is satisfied by `impl Trait for X` whatever X is — a struct or a scalar.
# Every instantiation is checked — an instance (`_instantiate_generic_fn` / `_struct`) and the i64
# BASE a scalar call reaches (whose body is the dead stub when i64 does not satisfy a bound, so every
# scalar path meets the refusal). A bounded call site is recorded by its method-name TOKEN in pass 1:
# the base, every instance and every inline replay re-parse those same tokens, so the site resolves to
# the impl's own method (`_tr_prefix`) in each of them, for a scalar T too (`i64_show(v)`).
# CHANGELOG [6.7.1]

# A fn's bound block; 1 = recorded with no valid bound (pass 1 reported it — pass 2 must not again).
fn GFBND(S, fi): i64 {
    if (_fnt_bnd == 0) { return 0; }
    var b = L64(_fnt_bnd + fi * 8);
    if (b == 1) { return 0; }
    return b;
}
fn SFBND(S, fi, v): i64 { if (_fnt_bnd == 0) { _fnt_bnd = alloc(131072 * 8); } S64(_fnt_bnd + fi * 8, v); return 0; }
fn GSBND(S, si): i64 { if (_st_bnd == 0) { return 0; } return L64(_st_bnd + si * 8); }
fn SSBND(S, si, v): i64 { if (_st_bnd == 0) { _st_bnd = alloc(1024 * 8); } S64(_st_bnd + si * 8, v); return 0; }

# Cursor on the `:` after type parameter `slot` (`n` = how many came before it, so a third is `n` 2):
# consume `: A + B ..` and record each name; a malformed shape is recorded, never reported here — this
# runs in both passes and for every instance, and the definition's ONE report is `_bnd_make`'s.
fn _ctp_bounds(S, slot): i64 {
    if (_ctp_buf == 0) { _ctp_buf = alloc(2 * 8 * 16); }
    STI(S, GTI(S) + 1);                 # consume `:`
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) != 2) {
            if (_ctp_bad == 0) { _ctp_bad = GTI(S) + 1; _ctp_badk = 1; }
            return 0;
        }
        if (slot > 1) {
            if (_ctp_bad == 0) { _ctp_bad = GTI(S) + 1; _ctp_badk = 3; }
        } else {
            var k = _ctp_n0;
            if (slot == 1) { k = _ctp_n1; }
            if (k >= 8) {
                if (_ctp_bad == 0) { _ctp_bad = GTI(S) + 1; _ctp_badk = 2; }
            } else {
                S64(_ctp_buf + (slot * 8 + k) * 16, PEEKV(S));
                S64(_ctp_buf + (slot * 8 + k) * 16 + 8, GTI(S));
                if (slot == 0) { _ctp_n0 = k + 1; } else { _ctp_n1 = k + 1; }
            }
        }
        STI(S, GTI(S) + 1);             # consume the trait name
        if (PEEKT(S) == 19) {           # a trait takes no type arguments
            if (_ctp_bad == 0) { _ctp_bad = GTI(S); _ctp_badk = 4; }
            # its `>>` may close the parameter list too (`<T: Show<i64>>`)
            if (_skip_targ_list(S) > 0) { _ctp_closed = 1; return 0; }
        }
        if (PEEKT(S) == 6) { STI(S, GTI(S) + 1); }   # `+`
        else { go = 0; }
    }
    return 0;
}

# A refusal AT token `ti` (the cursor is put back): pass 1 reports from a pre-scan.
fn _bnd_err_at(S, ti, msg, noff, tail, noff2): i64 {
    var sv = GTI(S);
    STI(S, ti);
    ERR_IDENT(S, msg, noff, tail, noff2);
    STI(S, sv);
    return 0;
}
fn _bnd_errm_at(S, ti, msg, len): i64 {
    var sv = GTI(S);
    STI(S, ti);
    ERR_MSG(S, msg, len);
    STI(S, sv);
    return 0;
}

# The bound block for the list `_capture_tparams` just read (`tp` its packed names), or 0 when it has
# no bound. Each trait name is resolved here, once per definition: an undeclared one is refused.
# Block: [0] count0, [1..8] trait indices; [9] count1, [10..17].
fn _bnd_make(S, tp): i64 {
    if (_ctp_bad != 0) {
        var bt = _ctp_bad - 1;
        _ctp_bad = 0;
        if (_ctp_badk == 1) { _bnd_errm_at(S, bt, "expected a trait name in a type parameter's bound (`T: Show + Eq`)", 66); }
        if (_ctp_badk == 2) { _bnd_err_at(S, bt, "too many bounds on one type parameter (max 8): ", TOKVAL(S, bt), 0, 0 - 1); }
        if (_ctp_badk == 4) { _bnd_err_at(S, bt, "a trait in a bound takes no type arguments: ", TOKVAL(S, bt), 0, 0 - 1); }
        if (_ctp_badk == 3) { _bnd_err_at(S, bt, "a bound on a third type parameter: at most two type parameters are recorded, so ", TOKVAL(S, bt), " would never be checked", 0 - 1); }
    }
    if (_ctp_n0 + _ctp_n1 == 0) { return 0; }
    var blk = alloc(18 * 8);
    var slot = 0;
    while (slot < 2) {
        var n = _ctp_n0;
        if (slot == 1) { n = _ctp_n1; }
        var tpn = ((tp >> (slot * 32)) & 0xFFFFFFFF) - 1;
        var c = 0;
        var k = 0;
        while (k < n) {
            var bn = L64(_ctp_buf + (slot * 8 + k) * 16);
            var tx = 0 - 1;
            if (_tr_tab != 0) { tx = _tr_find(S, bn); }
            if (tx < 0) {
                _bnd_err_at(S, L64(_ctp_buf + (slot * 8 + k) * 16 + 8), "unknown trait ", bn, " in the bound on type parameter ", tpn);
            } else {
                S64(blk + (slot * 9 + 1 + c) * 8, tx);
                c = c + 1;
            }
            k = k + 1;
        }
        S64(blk + slot * 9 * 8, c);
        slot = slot + 1;
    }
    _ctp_n0 = 0;
    _ctp_n1 = 0;
    return blk;
}

# Scalar `conc` (-8 / -4 / -2 / -1, f64 -9) or struct sid: 1 iff `tn` names that type.
fn _bnd_type_is(S, tn, conc): i64 {
    if (conc > 0) { return STREQ(S, tn, L64(S + 0x1A6018 + (conc - 1) * 8)); }
    var p = S + 0xEC00000 + tn;
    var c0 = 105;
    var c1 = 54;
    var c2 = 52;
    if (conc == 0 - 4) { c1 = 51; c2 = 50; }
    elif (conc == 0 - 2) { c1 = 49; c2 = 54; }
    elif (conc == 0 - 1) { c1 = 56; c2 = 0; }
    elif (conc == 0 - 9) { c0 = 102; }
    elif (conc != 0 - 8) { return 0; }
    if (load8(p) != c0) { return 0; }
    if (load8(p + 1) != c1) { return 0; }
    if (c2 == 0) {
        if (load8(p + 2) != 0) { return 0; }
        return 1;
    }
    if (load8(p + 2) != c2) { return 0; }
    if (load8(p + 3) != 0) { return 0; }
    return 1;
}
# The impl of trait `tx` for type `conc`, -1 when there is none.
fn _bnd_impl(S, tx, conc): i64 {
    var i = 0;
    while (i < _ti_n) {
        if (L64(_ti_tab + i * 64 + 48) == tx) { if (_bnd_type_is(S, L64(_ti_tab + i * 64 + 8), conc) == 1) { return i; } }
        i = i + 1;
    }
    return 0 - 1;
}
# The first bound of `blk`'s slot `slot` that `conc` does not satisfy, -1 when all are.
fn _bnd_fail(S, blk, slot, conc): i64 {
    if (blk == 0) { return 0 - 1; }
    var n = L64(blk + slot * 9 * 8);
    var k = 0;
    while (k < n) {
        var tx = L64(blk + (slot * 9 + 1 + k) * 8);
        if (_bnd_impl(S, tx, conc) < 0) { return tx; }
        k = k + 1;
    }
    return 0 - 1;
}
# 1 iff this (generic, conc0, conc1) refusal was already reported — once per pair of types, not
# once per call site (a lookahead resolves a call before its own parse does).
fn _bnd_memo_seen(g, c0, c1): i64 {
    if (_bnd_memo == 0) { _bnd_memo = alloc(256 * 24); }
    var i = 0;
    while (i < _bnd_memo_n) {
        var e = _bnd_memo + i * 24;
        if (load64(e) == g) { if (load64(e + 8) == c0) { if (load64(e + 16) == c1) { return 1; } } }
        i = i + 1;
    }
    if (_bnd_memo_n < 256) {
        var e2 = _bnd_memo + _bnd_memo_n * 24;
        store64(e2, g); store64(e2 + 8, c0); store64(e2 + 16, c1);
        _bnd_memo_n = _bnd_memo_n + 1;
    }
    return 0;
}
# Print the concrete type's name, for a refusal.
fn _bnd_pr_conc(S, conc): i64 {
    if (conc > 0) { PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (conc - 1) * 8)); return 0; }
    if (conc == 0 - 4) { PRSTR("i32"); }
    elif (conc == 0 - 2) { PRSTR("i16"); }
    elif (conc == 0 - 1) { PRSTR("i8"); }
    elif (conc == 0 - 9) { PRSTR("f64"); }
    else { PRSTR("i64"); }
    return 0;
}
# Check generic `g` (a fn index, or -1 - a struct index) against the concretes: 0 = satisfied, 1 =
# refused (reported once per pair of types). ⚠ Four parameters, not seven: cybs passes six.
fn _bnd_check(S, g, c0, c1): i64 {
    var blk = 0;
    var tp = 0;
    var gnoff = 0;
    if (g >= 0) {
        blk = GFBND(S, g);
        tp = GFTP(S, g);
        gnoff = L64(_fnt_names + g * 8);
    } else {
        blk = GSBND(S, 0 - 1 - g);
        tp = GSTP(S, 0 - 1 - g);
        gnoff = L64(S + 0x1A6018 + (0 - 1 - g) * 8);
    }
    if (blk == 0) { return 0; }
    if (c0 == 0) { c0 = 0 - 8; }
    if (c1 == 0) { c1 = 0 - 8; }
    var slot = 0;
    while (slot < 2) {
        var conc = c0;
        if (slot == 1) { conc = c1; }
        var tx = _bnd_fail(S, blk, slot, conc);
        if (tx >= 0) {
            if (_bnd_quiet == 1) { if (g < 0) { if (_bnd_quiet_hit == 0) { _bnd_quiet_hit = 0 - g; } } return 1; }
            if (_bnd_memo_seen(g, c0, c1) == 1) { return 1; }
            # 6.7.14: a refusal the panic latch swallows prints nothing — its note alone, after an earlier
            # error in the statement (`gs(5) + gb(3)`), named a bound the reader was never shown. CHANGELOG [6.7.14]
            if (_panic == 1) { return 1; }
            if (g >= 0) { _gen_ident_err(S, g, gnoff, ": its type argument does not implement trait ", L64(_tr_tab + tx * 32)); }
            else { ERR_IDENT(S, "generic ", gnoff, ": its type argument does not implement trait ", L64(_tr_tab + tx * 32)); }
            # 6.7.14: the same refusal at the same token in another instance of the enclosing generic
            # (`gb<T>(x)` in `o<i32>` and `o<i16>`) is printed as nothing by the error latch: so is its note.
            if (_err_quiet == 1) { return 1; }
            syscall(SYS_WRITE, 2, "  note: the bound on type parameter '", 37);
            PRSTR(S + 0xEC00000 + (((tp >> (slot * 32)) & 0xFFFFFFFF) - 1));
            syscall(SYS_WRITE, 2, "' needs `impl ", 14);
            PRSTR(S + 0xEC00000 + L64(_tr_tab + tx * 32));
            syscall(SYS_WRITE, 2, " for ", 5);
            _bnd_pr_conc(S, conc);
            syscall(SYS_WRITE, 2, "`, and there is none\n", 21);
            return 1;
        }
        slot = slot + 1;
    }
    return 0;
}
fn _bnd_check_fn(S, fi, c0, c1): i64 {
    if (GFBND(S, fi) == 0) { return 0; }
    return _bnd_check(S, fi, c0, c1);
}
fn _bnd_check_struct(S, si, c0, c1): i64 {
    if (GSBND(S, si) == 0) { return 0; }
    return _bnd_check(S, 0 - 1 - si, c0, c1);
}

# 6.7.14: the forwarding half of `_bnd_base_bad` (`_bbs_fwd_bad`).
var _bnd_has = 0;    # 1 once a fn has a real bound (`_fnt_bnd` is alloc'd for every generic's "no bound" mark)
var _bbs_fwd = 0;    # fi + 1 of the generic the judged fn forwards T to whose base is bad, 0 = none
var _bbs_root = 0;   # fi + 1 of the generic at the end of that chain, whose own bound (or bounded struct) fails
var _bbf_vis = 0;    # the generics one judgement has visited (alloc'd, grown), `_bbf_n` of them
var _bbf_n = 0;
var _bbf_cap = 0;
var _bbf_dep = 0;    # the judgement's recursion depth
var _bbf_t = 0;      # the scan tables the judgement scans with, swapped with the stub scan's (`_bbf_swap`)

# ── the contract, at the definition (pass 1) ────────────────────────────────────────────────
fn _bnr_add(S, name, slot, isptr): i64 {
    if (_bnr_tab == 0) { _bnr_tab = alloc(64 * 24); _bnr_cap = 64; }
    var i = 0;
    while (i < _bnr_n) {
        if (STREQ(S, L64(_bnr_tab + i * 24), name) == 1) {
            S64(_bnr_tab + i * 24 + 8, slot);
            S64(_bnr_tab + i * 24 + 16, isptr);
            return 0;
        }
        i = i + 1;
    }
    if (_bnr_n >= _bnr_cap) { _bnr_tab = _tab_grow(_bnr_tab, _bnr_cap * 3); _bnr_cap = _bnr_cap * 2; }   # 6.7.14 (`_gsn_add`)
    S64(_bnr_tab + _bnr_n * 24, name);
    S64(_bnr_tab + _bnr_n * 24 + 8, slot);
    S64(_bnr_tab + _bnr_n * 24 + 16, isptr);
    _bnr_n = _bnr_n + 1;
    return 0;
}
fn _bnr_find(S, name): i64 {
    var i = 0;
    while (i < _bnr_n) {
        if (L64(_bnr_tab + i * 24 + 8) >= 0) { if (STREQ(S, L64(_bnr_tab + i * 24), name) == 1) { return i; } }
        i = i + 1;
    }
    return 0 - 1;
}
# `name: [*]TN` at token i (a parameter, or the name of a `var`): its bounded slot, recorded; a name
# re-declared with another type stops being a receiver (slot -1).
fn _bnr_decl(S, tp, blk, i): i64 {
    if (TOKTYP(S, i + 1) != 49) {
        var r0 = _bnr_find(S, TOKVAL(S, i));
        if (r0 >= 0) { S64(_bnr_tab + r0 * 24 + 8, 0 - 1); }
        return 0;
    }
    var ti = i + 2;
    var isptr = 0;
    if (TOKTYP(S, ti) == 8) { ti = ti + 1; isptr = 1; }
    var slot = 0 - 1;
    if (TOKTYP(S, ti) == 2) {
        var tn = TOKVAL(S, ti);
        if (tn == (tp & 0xFFFFFFFF) - 1) { if (L64(blk) > 0) { slot = 0; } }
        if (tn == ((tp >> 32) & 0xFFFFFFFF) - 1) { if (L64(blk + 72) > 0) { slot = 1; } }
    }
    if (slot >= 0) { _bnr_add(S, TOKVAL(S, i), slot, isptr); return 0; }
    var r = _bnr_find(S, TOKVAL(S, i));
    if (r >= 0) { S64(_bnr_tab + r * 24 + 8, 0 - 1); }
    return 0;
}
fn _bs_add(S, ti, tx, tpn, isptr): i64 {
    if (_bs_tab == 0) { _bs_tab = alloc(4096 * 32); }
    if (_bs_n >= 4096) { _tr_cap(S, ti, "too many bounded method calls (max 4096)", 40); return 0; }
    S64(_bs_tab + _bs_n * 32, ti);
    S64(_bs_tab + _bs_n * 32 + 8, tx);
    S64(_bs_tab + _bs_n * 32 + 16, tpn);
    S64(_bs_tab + _bs_n * 32 + 24, isptr);
    _bs_n = _bs_n + 1;
    return 0;
}
# The bounded site whose method-name token is `ti`, -1 when none.
fn _bs_find(S, ti): i64 {
    var i = 0;
    while (i < _bs_n) {
        if (L64(_bs_tab + i * 32) == ti) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
# `recv.m(` at token i, `recv` a bounded receiver r: `m` must be a method of exactly one of its
# slot's traits — recorded as a site; otherwise refused at the method name.
fn _bnd_site(S, tp, blk, i, r): i64 {
    var slot = L64(_bnr_tab + r * 24 + 8);
    var m = TOKVAL(S, i + 2);
    var n = L64(blk + slot * 9 * 8);
    var hit = 0 - 1;
    var hits = 0;
    var k = 0;
    while (k < n) {
        var tx = L64(blk + (slot * 9 + 1 + k) * 8);
        if (_trm_of(S, tx, m) >= 0) {
            if (hits == 1) { return _bnd_site_refuse(S, i, i + 2, tx, 0); }
            hit = tx;
            hits = 1;
        }
        k = k + 1;
    }
    var tpn = ((tp >> (slot * 32)) & 0xFFFFFFFF) - 1;
    if (hit < 0) { return _bnd_site_refuse(S, i, i + 2, 0 - 1, tpn); }
    _bs_add(S, i + 2, hit, tpn, L64(_bnr_tab + r * 24 + 16));
    return 0;
}
# The two refusals of a bounded call whose method (token mti) no trait of the bound declares (tx -1; tpn the
# type parameter) or a second trait declares too (tx that trait) — at the method's name, the call recorded as a
# refused site so the parser consumes it quietly. The receiver, for the note, is the name at ri, or the field
# chain `ri.f` when mti is two names past it (`b.v.other()`, `_bnd_fsite`; CHANGELOG [6.7.15]).
fn _bnd_site_refuse(S, ri, mti, tx, tpn): i64 {
    var m = TOKVAL(S, mti);
    if (tx >= 0) {
        _bnd_err_at(S, mti, "ambiguous method ", m, ": more than one trait in this type parameter's bound declares it, e.g. ", L64(_tr_tab + tx * 32));
    } else {
        _bnd_err_at(S, mti, "method ", m, " is not in the bound on type parameter ", tpn);
        if (_err_quiet == 0) {   # 6.7.15: a refusal the panic latch swallowed prints no orphan note
            syscall(SYS_WRITE, 2, "  note: a bound is the contract for a bounded type parameter - call only its traits' methods on '", 97);
            PRSTR(S + 0xEC00000 + TOKVAL(S, ri));
            if (mti == ri + 4) { syscall(SYS_WRITE, 2, ".", 1); PRSTR(S + 0xEC00000 + TOKVAL(S, ri + 2)); }
            syscall(SYS_WRITE, 2, "', or add a trait that declares this one to the bound\n", 54);
        }
    }
    _bs_add(S, mti, 0 - 1, 0, 0);   # refused: its call is consumed quietly
    return 0;
}
# Generic fi's parameter list (its `(` at `open`) and body: every bounded receiver, and every call of
# a method on one — checked against the bound and recorded. Pass 1, once per definition.
fn _bnd_sites(S, fi, open): i64 {
    var blk = GFBND(S, fi);
    if (blk == 0) { return 0; }
    if (open < 0) { return 0; }
    var tp = GFTP(S, fi);
    _bnr_n = 0;
    var i = open + 1;
    var n = GTCNT(S);
    var d = 0;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0; }
        if (d == 0) {
            if (t == 11) { break; }
            if (t == 4) { i = _pl_dflt_end(S, i); continue; }   # 6.7.7: a default (`<` is an operator there)
            if (t == 2) { if (TOKTYP(S, i - 1) == 10 || TOKTYP(S, i - 1) == 31) { _bnr_decl(S, tp, blk, i); } }
        }
        if (t == 10 || t == 19 || t == 28) { d = d + 1; }
        if (t == 11 || t == 20 || t == 29) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (d < 0) { d = 0; }
        i = i + 1;
    }
    var b = _gs_body_open(S, i + 1);
    if (b < 0) { return 0; }
    i = b;
    d = 1;
    while (i < n) {
        var t2 = TOKTYP(S, i);
        if (t2 == 12) { return 0; }
        if (t2 == 13) { d = d + 1; }
        if (t2 == 14) { d = d - 1; if (d == 0) { return 0; } }
        if (t2 == 3) { if (TOKTYP(S, i + 1) == 2) { _bnr_decl(S, tp, blk, i + 1); } }
        if (t2 == 2) {
            if (TOKTYP(S, i + 1) == 41) { if (TOKTYP(S, i + 2) == 2) { if (TOKTYP(S, i + 3) == 10) {
                        if (TOKTYP(S, i - 1) != 41) {
                            var r = _bnr_find(S, TOKVAL(S, i));
                            if (r >= 0) { _bnd_site(S, tp, blk, i, r); }
                        }
                    } } }
            if (TOKTYP(S, i + 3) == 41) { if (TOKTYP(S, i + 5) == 10) { _bnd_fsite(S, fi, blk, open, i); } }   # 6.7.14
        }
        i = i + 1;
    }
    return 0;
}
# ⛔ 6.7.14 — A BOUNDED CALL ON A STRUCT CARRIER'S T FIELD: `b.v.show()` with `b: Box<T>` (`v: T`) and
# `T: Show`. Only a call on a name declared `T` / `*T` was a bounded site, so this one was not, and the stub
# scan's carrier rule (6.7.11, `_gs_cfield`) counted `b.v.<anything>` a struct use: the base was the stub,
# and `gs(bi)` with `bi: Box<i64>` was refused although `impl Show for i64` exists. `x.f.m(` at token i,
# x a carrier (a parameter or `var` typed `[*]G<..T..>`, found by scope) whose G declares `f: T` in a slot the
# carrier gives a bounded type parameter, and m a method of exactly one of that slot's traits: a bounded site at
# m, which the scan reads as a trait use (`_gs_bfield`) and a scalar T's call takes the field's value as `self`
# (`_load_bs_field`). A `f: *T` field, and a field whose slot has no bound, record nothing — that call keeps its
# 6.7.11 reading. CHANGELOG [6.7.14]
# ⛔ 6.7.15 (the user's D5 (a), 2026-10-18) — the field call is held to the whole contract, as the call on a
# T-typed name is: a method no trait of the bound declares (`b.v.other()` under `T: Show`), or one two traits
# declare, is refused at the definition by `_bnd_site`'s two refusals (`_bnd_site_refuse`), called or not; it
# compiled and called the instance's own method. CHANGELOG [6.7.15]
fn _bnd_fsite(S, fi, blk, open, i): i64 {
    if (TOKTYP(S, i - 1) == 41) { return 0; }
    if (TOKTYP(S, i + 1) != 41) { return 0; }
    if (TOKTYP(S, i + 2) != 2) { return 0; }
    if (TOKTYP(S, i + 4) != 2) { return 0; }
    var d = _tok_name_decl(S, open, i, TOKVAL(S, i));
    if (d < 0) { return 0; }
    var r = _bnd_fslot(S, fi, d, TOKVAL(S, i + 2));
    if (r < 0) { return 0; }
    var slot = r;
    var m = TOKVAL(S, i + 4);
    var n = L64(blk + slot * 9 * 8);
    if (n == 0) { return 0; }   # an unbounded slot: no contract
    var tpn = ((GFTP(S, fi) >> (slot * 32)) & 0xFFFFFFFF) - 1;
    var hit = 0 - 1;
    var k = 0;
    while (k < n) {
        var tx = L64(blk + (slot * 9 + 1 + k) * 8);
        if (_trm_of(S, tx, m) >= 0) {
            if (hit >= 0) { return _bnd_site_refuse(S, i, i + 4, tx, tpn); }
            hit = tx;
        }
        k = k + 1;
    }
    if (hit < 0) { return _bnd_site_refuse(S, i, i + 4, 0 - 1, tpn); }
    _bs_add(S, i + 4, hit, tpn, 0);
    return 0;
}
# The declaration at token d (`name: [*]G<..>`): the slot (0 / 1) of fi's type parameter that G's field
# `fnoff` holds whole (`f: T`), or -1 — a `f: *T` field is no receiver here (its call keeps 6.7.11's reading).
fn _bnd_fslot(S, fi, d, fnoff): i64 {
    if (TOKTYP(S, d + 1) != 49) { return 0 - 1; }
    var ti = d + 2;
    if (TOKTYP(S, ti) == 8) { ti = ti + 1; }
    if (TOKTYP(S, ti) != 2) { return 0 - 1; }
    if (TOKTYP(S, ti + 1) != 19) { return 0 - 1; }
    var tp = GFTP(S, fi);
    var j = ti + 2;
    var slot = 0;
    var dp = 1;
    var n = GTCNT(S);
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 12 || t == 10 || t == 11 || t == 13 || t == 5) { return 0 - 1; }
        if (dp == 1) { if (_gs_targ_whole(S, j) == 1) {
                var a = _gs_gfield_at(S, TOKVAL(S, ti), slot, fnoff);
                if (a >= 0) { if (TOKTYP(S, a) != 8) {
                        if (TOKVAL(S, j) == (tp & 0xFFFFFFFF) - 1) { return 0; }
                        if (TOKVAL(S, j) == ((tp >> 32) & 0xFFFFFFFF) - 1) { return 1; }
                    } }
            } }
        if (t == 31) { if (dp == 1) { slot = slot + 1; } }
        if (t == 19) { dp = dp + 1; }
        if (t == 20) { dp = dp - 1; }
        if (t == 39) { dp = dp - 2; }
        if (t == 152) { dp = dp - 3; }
        if (dp <= 0) { return 0 - 1; }
        j = j + 1;
    }
    return 0 - 1;
}
# Record fi's bounds (the list `_capture_tparams` just read, packed names `tp`) and its sites — once.
fn _bnd_fn_record(S, fi, tp, open): i64 {
    var seen = 0;
    if (_fnt_bnd != 0) { seen = L64(_fnt_bnd + fi * 8); }
    if (seen != 0) { _ctp_n0 = 0; _ctp_n1 = 0; _ctp_bad = 0; return 0; }
    var blk = _bnd_make(S, tp);
    if (blk == 0) { SFBND(S, fi, 1); return 0; }
    SFBND(S, fi, blk);
    _bnd_has = 1;
    _bnd_sites(S, fi, open);
    return 0;
}

# ── the call: a bounded site's callee ───────────────────────────────────────────────────────────
# Site `bsi`, receiver struct `sid` (0 = a scalar T): the impl's own method, by its defined name
# (`T_m`, or `T_Trait_m` on a collision). -1 when the type has no such impl (the instantiation was
# refused) — the caller then takes the ordinary path, whose error stands.
fn _bs_callee(S, bsi, sid): i64 {
    var tx = L64(_bs_tab + bsi * 32 + 8);
    if (tx < 0) { return 0 - 1; }
    var conc = sid;
    if (sid <= 0) {
        conc = 0;
        if (_tp_c0 != 0) { conc = _tp_resolve(S, L64(_bs_tab + bsi * 32 + 16)); }
        if (conc == 0) { conc = 0 - 8; }
    }
    var ii = _bnd_impl(S, tx, conc);
    if (ii < 0) { return 0 - 1; }
    var m = TOKVAL(S, L64(_bs_tab + bsi * 32));
    return _tr_findfn_join(S, _tr_prefix(S, ii, m), m);
}
# The lookahead sites' method lookup (`x.m(` with `x`'s struct `sid`, the method name at token `mti`):
# a bounded site's own callee, else `Type_m`. One compare when the program has no bound. 6.7.8 (D6): on
# a dyn, the member's prototype (`_dyn_mfn`) — so the lookaheads type a call through a dyn as its trait
# declares it.
fn _meth_fn_at(S, sid, mnoff, mti): i64 {
    if (_dyn_is(S, sid) == 1) { return _dyn_mfn(S, sid, mnoff); }
    if (_bs_n > 0) {
        var b = _bs_find(S, mti);
        if (b >= 0) {
            var f = _bs_callee(S, b, sid);
            if (f >= 0) { return f; }
        }
    }
    return FINDFN(S, BUILD_METHOD_NAME(S, sid - 1, mnoff));
}

# ── the i64 base ────────────────────────────────────────────────────────────────────────────────
# A generic's base is its i64 instance, emitted eagerly. It is not a valid one — and is the dead
# stub, like a struct-using generic's — when i64 fails one of the generic's OWN bounds, or when it
# instantiates a BOUNDED generic struct with its own type parameter (`Box<T>` with `Box<T: Show>`)
# and i64 fails that struct's bound. Without the second half, `fn mk<T>(x: T): Box<T>` was refused
# at its definition although only `mk(5)` is wrong. Cached only in pass 2 (`_bbm_get`): struct bounds are
# known once pass 1 has registered every struct; and a program with no bound never gets past the first test.
# ⛔ 6.7.14 — AND WHEN IT FORWARDS ITS T TO A GENERIC WHOSE BASE IS NOT A VALID i64 INSTANCE
# (`_bbs_fwd_bad`): `fn o<T>(x: T) { return gb(x); }` with `fn gb<T: Show>` and only `impl Show for f64`.
# The stub scan counted that forward a struct use, so `o`'s base was the stub, which has no scalar
# instance: `o(h)` / `o<f64>(h)` were refused "uses its type parameter as a struct" with a note naming
# i64. A bound-bad base is bad at i64 only: now `o`'s base is skipped the same way, `o(h)` calls `o$f64`,
# and `o(3)` is refused naming the forward and the impl i64 lacks (`_refuse_bnd_fwd`). CHANGELOG [6.7.14]
fn _bnd_base_bad(S, fi): i64 {
    _bbs_why = 0;
    _bbs_fwd = 0;
    if (fi < 0) { return 0; }
    if (_fnt_bnd == 0) { if (_st_bnd == 0) { return 0; } }
    var tp = GFTP(S, fi);
    if (tp == 0) { return 0; }
    if (_gen_is_inst(S, fi) == 1) { return 0; }
    var mv = _bbm_get(fi);
    if (mv >= 0) { return mv; }   # 6.7.15: its verdict, memoised
    var blk = GFBND(S, fi);
    if (blk != 0) {
        if (_bnd_fail(S, blk, 0, 0 - 8) >= 0) { return 1; }
        if (_bnd_fail(S, blk, 1, 0 - 8) >= 0) { return 1; }
    }
    if (_st_bnd != 0) { if (_bbs_struct(S, fi, tp) == 1) { _bbm_put(fi, 1); return 1; } }
    if (_bnd_has == 0) { if (_st_bnd == 0) { return 0; } }
    return _bbs_fwd_bad(S, fi);
}
# ⛔ 6.7.15 — THE VERDICT IS MEMOISED PER GENERIC, AND THE JUDGEMENT HAS NO DEPTH CAP. `_bbs_fwd_bad` judged a
# generic's forwards afresh at every asking (each call site, each base), so a chain of N forwarders cost N^2 scans,
# and a depth cap (64) kept that bounded by answering "not bad" past it — a valid 66-deep chain's base was then
# refused at a definition (issues/2026-10-17-bounded-forward-judgement-capped-at-64-deep.md). Each generic's
# verdict (with the diagnostics a refusal names: `_bbs_fwd`, `_bbs_root`, `_bbs_why`) is recorded once it is
# known to hold: a "bad" one always (a bad base reached is a fact, wherever it was found); a "not bad" one only
# when the whole judgement found nothing — inside a judgement that ends bad, a generic answered while one of its
# forwards was still being judged (a cycle, `_bbf_vis`) may be wrong, so it is not kept. Only in pass 2 (every
# impl and struct bound known) and while the stub flags are closed and unchanged (`_gm_gen`: a generic recorded
# later changes what a forward to it means, so it drops every entry). CHANGELOG [6.7.15]
var _bbm = 0;        # per generic fi: (tag, verdict, _bbs_fwd, _bbs_root, _bbs_why), 40 B; tag = `_gm_gen` + 1
var _bbm_cap = 0;    # its entries
var _bbf_ep = 0;     # the judgement's `_gm_gen` + 1 when it may record, else 0
# 1 = a verdict may be read or recorded now.
fn _bbm_ok(): i64 {
    if (_dyn_p2 == 0) { return 0; }
    if (_gm_closed != _gm_gen) { return 0; }
    return 1;
}
# fi's memoised verdict (the diagnostics set from it), or -1.
fn _bbm_get(fi): i64 {
    if (fi >= _bbm_cap) { return 0 - 1; }
    if (_bbm_ok() == 0) { return 0 - 1; }
    var e = _bbm + fi * 40;
    if (L64(e) != _gm_gen + 1) { return 0 - 1; }
    _bbs_fwd = L64(e + 16);
    _bbs_root = L64(e + 24);
    _bbs_why = L64(e + 32);
    return L64(e + 8);
}
# Record verdict v for fi, with the diagnostics as they stand.
fn _bbm_put(fi, v): i64 {
    if (_bbm_ok() == 0) { return 0; }
    if (_bbf_dep > 0) { if (_bbf_ep != _gm_gen + 1) { return 0; } }   # inside a judgement: its epoch still holds
    if (fi >= _bbm_cap) { _bbm_grow(fi); }
    var e = _bbm + fi * 40;
    S64(e, _gm_gen + 1);
    S64(e + 8, v);
    S64(e + 16, _bbs_fwd);
    S64(e + 24, _bbs_root);
    S64(e + 32, _bbs_why);
    return 0;
}
fn _bbm_grow(fi): i64 {
    var c = _bbm_cap * 2;
    if (c < 1024) { c = 1024; }
    while (c <= fi) { c = c * 2; }
    var t = alloc(c * 40);
    var w = 0;
    while (w < c * 5) { S64(t + w * 8, 0); w = w + 1; }
    if (_bbm != 0) { _tab_copy(t, _bbm, _bbm_cap * 5); }
    _bbm = t;
    _bbm_cap = c;
    return 0;
}
# 1 iff generic fi's definition instantiates a bounded generic struct with its own type parameter and
# i64 fails that struct's bound (`_bbs_why` = the struct).
fn _bbs_struct(S, fi, tp): i64 {
    var i = _gen_def_open(S, fi);
    if (i < 0) { return 0; }
    var n = GTCNT(S);
    var d = 0;
    var inb = 0;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { return 0; }
        if (t == 13) { d = d + 1; inb = 1; }
        if (t == 14) { d = d - 1; if (inb == 1) { if (d == 0) { return 0; } } }
        if (t == 5) { if (inb == 0) { return 0; } }
        if (t == 2) { if (TOKTYP(S, i + 1) == 19) {
                var fs = FINDSTRUCT(S, TOKVAL(S, i));
                if (fs > 0) { if (GSBND(S, fs - 1) != 0 || GSBB(S, fs - 1) != 0) {
                        if (_bbs_targs(S, fi, tp, fs, i + 2) == 1) { _bbs_why = fs; return 1; }
                    } }
            } }
        i = i + 1;
    }
    return 0;
}
# `Box<..>` (bounded struct fs) whose list starts at token j: 1 iff an argument that is just one of
# fi's type parameters takes a slot whose bound i64 fails.
fn _bbs_targs(S, fi, tp, fs, j): i64 {
    var sblk = GSBND(S, fs - 1);
    var slot = 0;
    var n = GTCNT(S);
    while (j < n) {
        if (TOKTYP(S, j) != 2) { return 0; }
        var nt = TOKTYP(S, j + 1);
        if (nt == 31 || nt == 20 || nt == 39 || nt == 152) {
            var a = TOKVAL(S, j);
            if (a == (tp & 0xFFFFFFFF) - 1 || a == ((tp >> 32) & 0xFFFFFFFF) - 1) {
                if (GSBB(S, fs - 1) != 0) { return 1; }
                if (slot < 2) { if (_bnd_fail(S, sblk, slot, 0 - 8) >= 0) { return 1; } }
            }
        }
        # to the next argument at this level, or the end of the list
        var d = 0;
        while (j < n) {
            var t = TOKTYP(S, j);
            if (t == 12 || t == 5 || t == 13) { return 0; }
            if (t == 19) { d = d + 1; }
            if (t == 20) { if (d == 0) { return 0; } d = d - 1; }
            if (t == 39 || t == 152) { return 0; }
            if (t == 31) { if (d == 0) { j = j + 1; break; } }
            j = j + 1;
        }
        slot = slot + 1;
    }
    return 0;
}
# 1 iff generic fi forwards its T — a whole T-typed name in a carrying position, a struct carrier, or
# `<T>` (the stub scan's mode 2, `_gs_use`) — to a generic whose base `_bnd_base_bad` judges bad
# (`_bbs_fwd` = that generic + 1; `_bbs_root` = + 1 of the one whose own bound or bounded struct fails).
# A stub fi is the stub's (its base is skipped, every scalar call refused by `_refuse_gen_stub`). Each
# generic is scanned once per judgement (`_bbf_vis`), so a cycle of forwards ends; a verdict known to hold is
# memoised (`_bbm_put`), so a chain of any depth is judged once per generic (6.7.15: it was capped at 64 deep).
fn _bbs_fwd_bad(S, fi): i64 {
    if ((GFGM(S, fi) & 3) != 0) { return 0; }
    var top = 0;
    if (_bbf_dep == 0) {
        _bbf_n = 0;
        top = 1;
        _bbf_ep = 0;
        if (_bbm_ok() == 1) { _bbf_ep = _gm_gen + 1; }
    }
    _bbf_push(fi);
    var lo = _bbf_n;
    _bbf_scan(S, fi);
    var hi = _bbf_n;
    _bbf_dep = _bbf_dep + 1;
    var r = 0;
    var k = lo;
    while (k < hi) {
        var g = L64(_bbf_vis + k * 8);
        if (_bnd_base_bad(S, g) == 1) {
            if (_bbs_fwd == 0) { _bbs_root = g + 1; }
            _bbs_fwd = g + 1;
            r = 1;
            k = hi;
        }
        k = k + 1;
    }
    _bbf_dep = _bbf_dep - 1;
    if (r == 1) { if (_bbf_ep == _gm_gen + 1) { _bbm_put(fi, 1); } return 1; }
    if (top == 1) { _bbf_none(); }
    return 0;
}
# The judgement found no bad base: none of the generics it visited reaches one — each is recorded "not bad".
fn _bbf_none(): i64 {
    if (_bbf_ep != _gm_gen + 1) { return 0; }
    _bbs_fwd = 0;
    _bbs_root = 0;
    _bbs_why = 0;
    var k = 0;
    while (k < _bbf_n) {
        _bbm_put(L64(_bbf_vis + k * 8), 0);
        k = k + 1;
    }
    return 0;
}
# Add generic g to the judgement's visited list (once).
fn _bbf_push(g): i64 {
    var k = 0;
    while (k < _bbf_n) {
        if (L64(_bbf_vis + k * 8) == g) { return 0; }
        k = k + 1;
    }
    if (_bbf_vis == 0) { _bbf_vis = alloc(64 * 8); _bbf_cap = 64; }
    if (_bbf_n >= _bbf_cap) { _bbf_vis = _tab_grow(_bbf_vis, _bbf_cap); _bbf_cap = _bbf_cap * 2; }
    S64(_bbf_vis + _bbf_n * 8, g);
    _bbf_n = _bbf_n + 1;
    return 0;
}
# The refusal for a scalar call (or `&g`) of generic fi whose base forwards its T to a bad base: the
# forward, then a note naming what the chain's last generic needs.
fn _refuse_bnd_fwd(S, fi, noff): i64 {
    if (_bnd_memo_seen(fi, 0 - 8, 0 - 8) == 1) { return 0; }
    if (_panic == 1) { return 0; }
    _gen_ident_err(S, fi, noff, " has no i64 instance: it forwards its type parameter to ", L64(_fnt_names + (_bbs_fwd - 1) * 8));
    var r = _bbs_root - 1;
    if (r < 0) { return 0; }
    if (_bbs_why > 0) {
        PRSTR("  note: '");
        PRSTR(S + 0xEC00000 + L64(_fnt_names + r * 8));
        PRSTR("' instantiates the bounded generic struct '");
        PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (_bbs_why - 1) * 8));
        PRSTR("' with its type parameter, and i64 does not satisfy its bound\n");
        return 0;
    }
    var blk = GFBND(S, r);
    var slot = 0;
    var tx = _bnd_fail(S, blk, 0, 0 - 8);
    if (tx < 0) { slot = 1; tx = _bnd_fail(S, blk, 1, 0 - 8); }
    if (tx < 0) { return 0; }
    PRSTR("  note: the bound on type parameter '");
    PRSTR(S + 0xEC00000 + (((GFTP(S, r) >> (slot * 32)) & 0xFFFFFFFF) - 1));
    PRSTR("' of '");
    PRSTR(S + 0xEC00000 + L64(_fnt_names + r * 8));
    PRSTR("' needs `impl ");
    PRSTR(S + 0xEC00000 + L64(_tr_tab + tx * 32));
    PRSTR(" for i64`, and there is none\n");
    return 0;
}
# The refusal for a scalar call (or `&g`) of generic fi whose base is not a valid i64 instance:
# its own bound (reported by `_bnd_check_fn`), or a bounded struct it instantiates with its T.
fn _refuse_bnd_base(S, fi, noff): i64 {
    if (_bnd_check_fn(S, fi, 0 - 8, 0 - 8) == 1) { return 0; }
    if (_bbs_fwd > 0) { _refuse_bnd_fwd(S, fi, noff); return 0; }   # 6.7.14
    if (_bbs_why <= 0) { return 0; }
    if (_bnd_memo_seen(fi, 0 - 8, 0 - 8) == 1) { return 0; }
    _gen_ident_err(S, fi, noff, " has no i64 instance: it instantiates a bounded generic struct with its type parameter, and i64 does not satisfy the bound of ", L64(S + 0x1A6018 + (_bbs_why - 1) * 8));
    return 0;
}

# ── generic structs ─────────────────────────────────────────────────────────────────────────────
# A struct's i64 BASE (a bare `Box`, a written `Box<i64>`) is an instance like any other: refused
# when i64 fails the struct's own bound, or when the struct's base definition instantiates a
# bounded struct with its own type parameter and i64 fails THAT bound (`struct W<T> { b: Box<T>; }`
# — recorded quietly while W's base is parsed, `_bnd_quiet`, since `W<Pt>` may be fine).
fn GSBB(S, si): i64 { if (_st_bb == 0) { return 0; } return L64(_st_bb + si * 8); }
fn SSBB(S, si, v): i64 { if (_st_bb == 0) { _st_bb = alloc(1024 * 8); } S64(_st_bb + si * 8, v); return 0; }
fn _bnd_sbase(S, sid): i64 {
    if (sid <= 0) { return 0; }
    var si = sid - 1;
    if (GSBND(S, si) != 0) { if (_bnd_check_struct(S, si, 0 - 8, 0 - 8) == 1) { return 1; } }
    var bb = GSBB(S, si);
    if (bb <= 0) { return 0; }
    if (_bnd_quiet == 1) { if (_bnd_quiet_hit == 0) { _bnd_quiet_hit = sid; } return 1; }
    if (_bnd_memo_seen(0 - 1 - si, 0 - 8, 0 - 8) == 1) { return 1; }
    ERR_IDENT(S, "generic struct ", L64(S + 0x1A6018 + si * 8), " has no i64 instance: a field instantiates a bounded generic struct with its type parameter, and i64 does not satisfy the bound of ", L64(S + 0x1A6018 + (bb - 1) * 8));
    return 1;
}
# 1 iff the type-argument list at token j (just past `<`) is written with no type parameter that is
# bound right now — so an all-i64 list there names the base explicitly (`Box<i64>`), not through a
# generic's T, whose i64 base is judged where IT is used.
fn _targs_literal(S, j): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 12 || t == 5 || t == 13 || t == 10) { return 1; }
        if (t == 2) { if (_tp_c0 != 0) { if (_tp_resolve(S, TOKVAL(S, j)) != 0) { return 0; } } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return 1; }
        j = j + 1;
    }
    return 1;
}

# A scalar receiver as `self` (a bounded site's, or `self` in a scalar impl; `bsi` -1): its VALUE (an untyped `self` in `impl Show for i64` is
# the i64 itself). A `*T` receiver with T bound to a scalar is refused — its pointee's width is T's.
fn _bs_scalar_self(S, idx, bsi, noff): i64 {
    if (bsi >= 0) { if (L64(_bs_tab + bsi * 32 + 24) != 0) {
            ERR_IDENT(S, "method call on ", noff, ", a pointer to a type parameter bound to a scalar - call it on the value", 0 - 1);
            return 0;
        } }
    if (idx <= 0 - 1000000) { _CL_CAP_BASE_RA(S, 0 - 1000000 - idx, 0); ELOAD64(S); }
    elif (idx < 0 - 1) { EFLLOAD(S, 0 - idx - 2); }
    else { EVLOAD(S, idx); }
    return 0;
}

# ⛔ 6.7.2 (B1, C1) — COMPILE-TIME CONSTANTS AND `const fn`.
# `const LIMIT = 7;`, `const PI = 3.14159;`, `const NAME = "cyrius";` — no storage; every use is the
# value, a string const its literal. `const fn f(..) { .. }` is an ordinary fn that a CONST CONTEXT
# (a const initializer, an array size, `#assert`, a `case` label, an enum value) runs at compile
# time; anywhere else it is a plain runtime call. User decisions, 2026-10-07 (roadmap.md § B / C1):
# int + f64 + string consts, top level and inside fns, const fn in const contexts only, its body
# the pure subset, checked at the definition.
#
# TOP-LEVEL consts are found by ONE pre-scan at the start of pass 1 (`_cst_prepass`) wherever they
# sit, so order does not matter, and each gets a global name slot of SIZE 0 (no storage) flagged
# PENDING (GVECP 2). Its first reader evaluates it: `GVECP` forces it (`_cst_force`), so every
# enum-constant reader — array sizes, `#assert`, the folder, the factor — takes an integer const
# unchanged (GVECP 1, the value in `_vecv_base`); an f64 or string const keeps GVECP 0 and is read
# through `_cst_vkind` by the factor, which emits it as its literal. The end of pass 1 evaluates
# every const (`_cst_sweep`), used or not, so each error is reported.
# LOCAL consts live in their own scoped table (`_lc_tab`: name, scope depth, inline depth, kind,
# value) — a const has no frame slot, so a closure sees it by NAME and never captures it; a var
# and a const of one name resolve to the more deeply declared; an inline replay sees only the
# consts it declares itself; a generic instance or another fn sees none of its encloser's.
# THE EVALUATOR (`_ce_*`) interprets tokens, mirroring the parser — `||` over `&&` over ONE
# comparison over `+ - & | ^` over `* / % << >> >>>` over unary `- ~` — and its STATIC typing: an
# operator takes its float form when its LEFT operand is f64 (the right one's bits used as they
# are, as at run time), an untyped `var` is an integer whatever it holds. f64 arithmetic is the
# integer-only `_sf_*` (cybs has no float), and a NaN is refused (its bits differ by target).
# The definition check of a const fn is the same interpreter in SKIP mode over its whole body.
# CHANGELOG [6.7.2]

# ── small helpers ───────────────────────────────────────────────────────────────────────────────
# 6.7.14 — a refusal at a token already reported (`_tn_once`) is counted, not printed again. The end
# of pass 1 runs the const fn bodies its consts call (`_cst_sweep`) and pass 2 checks each definition
# again (`_ce_check_fn`, and the parser's own refusals): the same token's error was printed twice
# once pass 2 stopped starting under pass 1's latch. Marked only when it would print. 1 = said.
fn _ce_said(S): i64 {
    if (_panic == 1) { return 0; }
    if (_tn_once(S, _ce_ti) == 1) { return 0; }
    _had_error = 1;
    _panic = 1;
    return 1;
}
fn _ce_bad(S, msg, len): i64 {
    if (_ce_err == 1) { return 0; }
    _ce_err = 1;
    if (_ce_quiet == 1) { return 0; }   # 6.7.15: _ce_top_quiet
    _ce_rti = _ce_ti;   # 6.7.15 (`_ce_err_dup`)
    if (_ce_said(S) == 1) { return 0; }   # 6.7.14
    var sv = GTI(S);
    STI(S, _ce_ti);
    ERR_MSG(S, msg, len);
    STI(S, sv);
    return 0;
}
fn _ce_badn(S, msg, noff, tail): i64 {
    if (_ce_err == 1) { return 0; }
    _ce_err = 1;
    if (_ce_quiet == 1) { return 0; }   # 6.7.15: _ce_top_quiet
    _ce_rti = _ce_ti;   # 6.7.15
    _ce_bn = noff;   # 6.7.14: the subject, for `_ce_check_fn` (see `_ce_name_said`)
    if (_ce_said(S) == 1) { return 0; }   # 6.7.14
    var sv = GTI(S);
    STI(S, _ce_ti);
    ERR_IDENT(S, msg, noff, tail, 0 - 1);
    STI(S, sv);
    return 0;
}
# ⛔ 6.7.14 — A CONST FN'S BODY IS ALSO AN ORDINARY FN, COMPILED AFTER ITS DEFINITION CHECK: an unknown
# name was refused twice, "unknown name 't' in a const context" by the check and "undefined variable 't'"
# by the run-time compile, one column on (`t = 1;`: "'t' is not a local of this const fn" and the same).
# The name the check refused (`_ce_badn`'s subject, `_ce_bn`) is kept for that body (`_ce_fn_rname`,
# scoped by PARSE_FN_DEF), and an undefined-variable report of it there is counted, not printed. Another
# name stays reported: the check stops at its first refusal, and the run-time compile still names what
# the check never reached. 1 = this report is that one. CHANGELOG [6.7.14]
var _ce_bn = 0 - 1;
var _ce_fn_rname = 0 - 1;
var _ce_fn_refd = 0;
# ⛔ 6.7.15 — AND THE TOKEN IT REFUSED (`_ce_rti`, set by `_ce_bad` / `_ce_badn` / `_ce_expect`; kept for that
# body as `_ce_fn_rtok`, scoped by PARSE_FN_DEF): the body's own report of a mistake there is the same mistake
# in the parser's words — "not a compile-time expression" then "unexpected ';'" at one `;` (`var y = n +;`).
# The run-time body began under the check's latch until 6.7.15, which hid that in its first statement only.
# `_err_once`'s repeat test: 1 = printed already, or that token in that body (counted and latched, not
# printed). CHANGELOG [6.7.15]
var _ce_rti = 0 - 1;
var _ce_fn_rtok = 0 - 1;
fn _ce_err_dup(S, id): i64 {
    if (_err_dup(S, id) == 1) { return 1; }
    if (_ce_fn_rtok < 0) { return 0; }
    if (GTI(S) != _ce_fn_rtok) { return 0; }
    return 1;
}
fn _ce_name_said(S, noff): i64 {
    if (_ce_fn_rname < 0) { return 0; }
    if (STREQ(S, _ce_fn_rname, noff) == 0) { return 0; }
    _had_error = 1;
    return 1;
}
# 6.7.14 — a field arm's refusal in the run-time body of a const fn whose definition check refused it
# (`_ce_fn_refd`): a field is never in a const fn, so the check refused this one by the subset's rule (or a
# const's), or stopped at an earlier refusal; the run-time compile said "no struct type in scope for 'a'",
# blaming a missing include. Counted as ERR_IDENT would count it (the statement resyncs), not printed.
# 1 = stood down. CHANGELOG [6.7.14]
fn _ce_fld_said(S): i64 {
    if (_ce_fn_refd == 0) { return 0; }
    _had_error = 1;
    _panic = 1;
    return 1;
}
# A runtime fault (division by zero, NaN, overflow of a conversion) — only when executing.
fn _ce_fault(S, msg, len): i64 {
    if (_ce_skip > 0) { return 0; }
    return _ce_bad(S, msg, len);
}
fn _ce_expect(S, t): i64 {
    if (_ce_err == 1) { return 0; }
    if (TOKTYP(S, _ce_ti) == t) { _ce_ti = _ce_ti + 1; return 1; }
    if (_ce_err == 0) {
        _ce_err = 1;
        if (_ce_quiet == 1) { return 0; }   # 6.7.15: _ce_top_quiet
        _ce_rti = _ce_ti;   # 6.7.15
        if (_ce_said(S) == 1) { return 0; }   # 6.7.14
        var sv = GTI(S);
        STI(S, _ce_ti);
        ERR_EXPECT(S, t);
        STI(S, sv);
    }
    return 0;
}
fn _ce_step(S): i64 {
    if (_ce_skip > 0) { return 0; }
    _ce_steps = _ce_steps + 1;
    if (_ce_steps > 10000000) { _ce_bad(S, "compile-time evaluation exceeded 10,000,000 steps (an endless loop in a const fn?)", 82); }
    return 0;
}

# ── frames: the const fn being run (5 words): name, value, kind (0 i64, 1 f64, 2 a string),
# width (8, or 4 / 2 / 1 for a narrow integer), const (1 = a `const` inside the body) ──────────
fn _ce_fr_push(S, name, v, k, w): i64 {
    if (_ce_st == 0) { _ce_st = alloc(65536 * 40); }
    if (_ce_sp >= 65536) { _ce_bad(S, "compile-time evaluation: too many locals (max 65536)", 52); return 0 - 1; }
    var e = _ce_st + _ce_sp * 40;
    store64(e, name); store64(e + 8, v); store64(e + 16, k); store64(e + 24, w); store64(e + 32, 0);
    _ce_sp = _ce_sp + 1;
    return _ce_sp - 1;
}
fn _ce_fr_find(S, name): i64 {
    var i = _ce_sp - 1;
    while (i >= _ce_fb) {
        if (STREQ(S, load64(_ce_st + i * 40), name) == 1) { return i; }
        i = i - 1;
    }
    return 0 - 1;
}
# Narrow a value to a local's width, sign-extending as the runtime's narrow load does.
fn _ce_narrow(v, w): i64 {
    if (w == 4) { v = v & 0xFFFFFFFF; if ((v & 0x80000000) != 0) { v = v | (0 - 0x100000000); } return v; }
    if (w == 2) { v = v & 0xFFFF; if ((v & 0x8000) != 0) { v = v | (0 - 0x10000); } return v; }
    if (w == 1) { v = v & 0xFF; if ((v & 0x80) != 0) { v = v | (0 - 0x100); } return v; }
    return v;
}

# ── expressions ─────────────────────────────────────────────────────────────────────────────────
fn _ce_expr(S): i64 {
    var v = _ce_land(S);
    while (TOKTYP(S, _ce_ti) == 54) {
        if (_ce_err == 1) { return 0; }
        _ce_ti = _ce_ti + 1;
        var lt = 0;
        if (v != 0) { lt = 1; }
        if (lt == 1) { _ce_skip = _ce_skip + 1; }
        var r = _ce_land(S);
        if (lt == 1) { _ce_skip = _ce_skip - 1; v = 1; }
        else { v = 0; if (r != 0) { v = 1; } }
        _ce_k = 3;   # 6.7.3: an || link is a bool
    }
    return v;
}
fn _ce_land(S): i64 {
    var v = _ce_atom(S);
    while (TOKTYP(S, _ce_ti) == 53) {
        if (_ce_err == 1) { return 0; }
        _ce_ti = _ce_ti + 1;
        var lf = 0;
        if (v == 0) { lf = 1; }
        if (lf == 1) { _ce_skip = _ce_skip + 1; }
        var r = _ce_atom(S);
        if (lf == 1) { _ce_skip = _ce_skip - 1; v = 0; }
        else { v = 0; if (r != 0) { v = 1; } }
        _ce_k = 3;   # 6.7.3: an && link is a bool
    }
    return v;
}
fn _ce_atom(S): i64 {
    var a = _ce_add(S);
    var op = TOKTYP(S, _ce_ti);
    if (op < 17) { return a; }
    if (op > 22) { return a; }
    var ak = _ce_k;
    _ce_ti = _ce_ti + 1;
    var b = _ce_add(S);
    var bk = _ce_k;
    _ce_k = 3;   # 6.7.3: a comparison is a bool
    if (_ce_err == 1) { return 0; }
    if (_ce_skip > 0) { return 0; }
    if (ak == 2 || bk == 2) { _ce_bad(S, "a string in a comparison: a const string is a value to pass, not to compare", 75); return 0; }
    var c = 0;
    if (ak == 1) {
        _sf_err = 0;
        c = _sf_cmp(a, b);
        if (_sf_err == 1) { _ce_fault(S, "a NaN in a compile-time comparison (its result depends on the target)", 69); return 0; }
    } else {
        if (a < b) { c = 0 - 1; }
        elif (a > b) { c = 1; }
    }
    return _ce_cmp_res(op, c);
}
fn _ce_cmp_res(op, c): i64 {
    if (op == 17) { if (c == 0) { return 1; } return 0; }
    if (op == 18) { if (c != 0) { return 1; } return 0; }
    if (op == 19) { if (c < 0) { return 1; } return 0; }
    if (op == 20) { if (c > 0) { return 1; } return 0; }
    if (op == 21) { if (c <= 0) { return 1; } return 0; }
    if (c >= 0) { return 1; }
    return 0;
}
fn _ce_add(S): i64 {
    var v = _ce_term(S);
    var go = 1;
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        var t = TOKTYP(S, _ce_ti);
        if (t == 113) { t = 6; }
        if (t == 116) { t = 7; }
        if (t == 114 || t == 115 || t == 117 || t == 118) {
            _ce_bad(S, "a saturating or checked operator (+| +? -| -?) calls lib/overflow.cyr - it is not compile-time", 94);
            return 0;
        }
        if (t == 6 || t == 7 || t == 27 || t == 35 || t == 36) {
            var vk = _ce_k;
            _ce_ti = _ce_ti + 1;
            var r = _ce_term(S);
            var rk = _ce_k;
            v = _ce_binop(S, t, v, vk, r, rk);
        } else { go = 0; }
    }
    return v;
}
fn _ce_term(S): i64 {
    var v = _ce_unary(S);
    var go = 1;
    while (go == 1) {
        if (_ce_err == 1) { return 0; }
        var t = TOKTYP(S, _ce_ti);
        if (t == 119) { t = 8; }
        if (t == 120 || t == 121) {
            _ce_bad(S, "a saturating or checked operator (*| *?) calls lib/overflow.cyr - it is not compile-time", 88);
            return 0;
        }
        if (t == 8 || t == 9 || t == 34 || t == 38 || t == 39 || t == 152) {
            var vk = _ce_k;
            _ce_ti = _ce_ti + 1;
            var r = _ce_unary(S);
            var rk = _ce_k;
            v = _ce_binop(S, t, v, vk, r, rk);
        } else { go = 0; }
    }
    return v;
}
# One binary operator, the left operand's static kind choosing int or float (as PEXPR / PARSE_TERM).
fn _ce_binop(S, t, a, ak, b, bk): i64 {
    _ce_k = 0;
    if (_ce_err == 1) { return 0; }
    if (_ce_skip > 0) {
        if (ak == 1) { if (t == 6 || t == 7 || t == 8 || t == 9) { _ce_k = 1; } }
        if (ak == 4) { if (t == 6 || t == 7 || t == 8 || t == 9) { _ce_k = 4; } }   # 6.7.4: still unknown
        return 0;
    }
    if (ak == 2 || bk == 2) { _ce_bad(S, "a string in arithmetic: a const string is a value to pass, not to compute with", 78); return 0; }
    if (ak == 1) { if (t == 6 || t == 7 || t == 8 || t == 9) { return _ce_fbin(S, t, a, b); } }
    return _ce_ibin(S, t, a, b);
}
fn _ce_fbin(S, t, a, b): i64 {
    _sf_err = 0;
    var r = 0;
    if (t == 6) { r = _sf_add(a, b); }
    elif (t == 7) { r = _sf_sub(a, b); }
    elif (t == 8) { r = _sf_mul(a, b); }
    else { r = _sf_div(a, b); }
    if (_sf_err == 1) { _ce_fault(S, "a NaN in compile-time f64 arithmetic (an operand, or 0/0, inf-inf, 0*inf): its bits depend on the target", 104); return 0; }
    _ce_k = 1;
    return r;
}
fn _ce_ibin(S, t, a, b): i64 {
    if (t == 6) { return a + b; }
    if (t == 7) { return a - b; }
    if (t == 27) { return a & b; }
    if (t == 35) { return a | b; }
    if (t == 36) { return a ^ b; }
    if (t == 8) { return a * b; }
    if (t == 38) { return a << (b & 63); }
    if (t == 39) { return a >> (b & 63); }
    if (t == 152) { return _CF_ASR(a, b); }
    if (b == 0) { _ce_fault(S, "division by zero in a compile-time evaluation", 45); return 0; }
    if (t == 9) {
        if (b == 0 - 1) { return 0 - a; }   # INT_MIN / -1 wraps, as the literal folder does (_CF_TERM)
        return a / b;
    }
    if (b == 0 - 1) { return 0; }
    return a % b;
}
fn _ce_unary(S): i64 {
    var t = TOKTYP(S, _ce_ti);
    if (t == 7) {
        _ce_ti = _ce_ti + 1;
        var v = _ce_unary(S);
        if (_ce_k == 2) { _ce_bad(S, "a string in arithmetic: a const string is a value to pass, not to compute with", 78); return 0; }
        if (_ce_k == 1) { return _sf_neg(v); }
        if (_ce_k == 3) { _ce_k = 0; }   # 6.7.3: `-ok` is an integer, as at run time
        return 0 - v;
    }
    if (t == 37) {
        _ce_ti = _ce_ti + 1;
        var w = _ce_unary(S);
        if (_ce_k == 2) { _ce_bad(S, "a string in arithmetic: a const string is a value to pass, not to compute with", 78); return 0; }
        _ce_k = 0;
        return w ^ (0 - 1);
    }
    if (t == 171) {
        # `!x` (6.7.3): 1 when the operand's word is 0 — an f64 operand is its raw bits, as at run time.
        _ce_ti = _ce_ti + 1;
        var nv = _ce_unary(S);
        if (_ce_k == 2) { _ce_bad(S, "a string in arithmetic: a const string is a value to pass, not to compute with", 78); return 0; }
        _ce_k = 3;
        if (nv == 0) { return 1; }
        return 0;
    }
    return _ce_factor(S);
}
fn _ce_factor(S): i64 {
    _ce_k = 0;
    if (_ce_err == 1) { return 0; }
    var t = TOKTYP(S, _ce_ti);
    if (t == 1) { var v = TOKVAL(S, _ce_ti); _ce_ti = _ce_ti + 1; return v; }
    if (t == 169) { _ce_ti = _ce_ti + 1; _ce_k = 3; return 1; }   # true (6.7.3) — kind 3, a bool
    if (t == 170) { _ce_ti = _ce_ti + 1; _ce_k = 3; return 0; }   # false
    if (t == 61) { var fv = FLIT_NUM(TOKVAL(S, _ce_ti)); _ce_ti = _ce_ti + 1; _ce_k = 1; return fv; }
    if (t == 30) { var sv = TOKVAL(S, _ce_ti); _ce_ti = _ce_ti + 1; _ce_k = 2; return sv; }
    if (t == 10) {
        if (_tup_commas(S, _ce_ti) > 0) {   # 6.7.7 (B4, R5): `const C = (1, 2);`, a literal in a const fn
            _ce_bad(S, "a tuple in a const context - a const is one value (take a tuple at run time: `var t = ( .. );`)", 95);
            return 0;
        }
