    }
    # v5.8.20: #pure caller cannot call #io / #alloc callees. Warning
    # (not error) for downstream incremental adoption — same shape as
    # #must_use / #deprecated diagnostics. The annotation ramp happens
    # gradually; cyrlint --strict will escalate to error in a follow-up.
    if (_cur_fn_is_pure == 1) {
        if (_dep_flags & 16 != 0) {
            syscall(SYS_WRITE, 2, "warning:", 8);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": #pure fn calls #io fn '", 25);
            PRSTR(S + 0x60000 + noff);
            syscall(SYS_WRITE, 2, "'\n", 2);
        }
        if (_dep_flags & 32 != 0) {
            syscall(SYS_WRITE, 2, "warning:", 8);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": #pure fn calls #alloc fn '", 28);
            PRSTR(S + 0x60000 + noff);
            syscall(SYS_WRITE, 2, "'\n", 2);
        }
    }
    # v6.4.31: on Win64 PE a value-form SIMD param (address-passed, struct_mask
    # set) or a SIMD return (retptr-style) can't survive the inline replay, which
    # homes args with an 8-byte EFLSTORE and returns scalar-in-rax — it would
    # truncate the 16/32-byte vector. Force such callees through the normal
    # struct-ptr / retptr path (handled in parse_decl + PARSE_FNCALL below).
    var _pe_no_inline = 0;
    if (_TARGET_PE == 1) {
        if (L64(_fnt_structmask + fi * 8) != 0) { _pe_no_inline = 1; }
        if (_is_simd_any(S, GFRS(S, fi)) == 1) { _pe_no_inline = 1; }
    }
    if (GFINL(S, fi) != 0) { if (GIDEP(S) < 3) { if (GINFN(S) == 1) { if (_pe_no_inline == 0) {
                # INLINE PATH: replay function body tokens at call site
                var pc = L64(_fnt_params + fi * 8);
