    if (_gtp != 0) { SFTP(S, fi, _gtp); }   # v6.3.9 (F-fns): record this fn's <T> names
    if (_gtp != 0) { SFDS(S, fi, _defstart_ti + 1); }   # v6.3.10: def-start +1 (0 = unrecorded; token 0 is valid)
    # v6.5.0 Phase 1 (public/private): stamp this fn's ORIGIN FILE, derived from the
    # line of its `fn` keyword via the file map the preprocessor already builds for
    # diagnostics (`#@file` markers -> FM_BUILD -> FM_FILEID). RECORDED ONLY — nothing
    # reads this for a decision yet, so program codegen is unchanged; Phase 2 is what
    # turns it into a visibility boundary.
    #
    # `_defstart_ti` is the `fn`-keyword token and is set unconditionally at the top of
    # PARSE_FN_DEF, so this is exact for every definition rather than approximated from
    # whatever token happens to be current. Deliberately placed HERE, after `fi` is
    # resolved: a forward reference registers a slot from a CALL SITE, and attributing
    # the fn to the caller's file would be precisely backwards.
    var _vis_fid = FM_FILEID(S, GTLINE(S, _defstart_ti));
    SFFI(S, fi, _vis_fid + 1);
