    return 0;
}
# The struct the pointer parked in frame slot `h` points at, copied byte-exact into a temp of the fn's
# struct: the temp.
fn _ret_ptr_copy(S, h): i64 {
    var t = _agg_temp(S, _cur_fn_ret_sid);
    _agc_copy_bytes(S, t, 0 - 1, _AGC_DREF(h), 0 - 1, STRUCTSZ(S, _cur_fn_ret_sid - 1));
    return t;
}
# The rax:rdx class's arm of `_ret_ptr_src`: the temp loaded as the pair, the return landed. 1 = done.
fn _ret_ptr_pair(S): i64 {
    var t = _ret_ptr_src(S);
    if (t < 0) { return 0; }
    _ret_end(S);
    EFLLOAD_STRUCT_INT_PAIR(S, t);
    var rp = EJMP0(S);
    vec_push(rp_vec, rp);
    return 1;
}
# ⛔ 6.6.17 (a1 review) — `return p;` from a fn returning a struct of 8 B or less, where `p: *T` is
# a pointer to it. That class returns the struct's VALUE in rax (the scalar path below), and a
# `*T` slot holds an address, so the caller's `x.v` read the address (x86, qemu-aarch64, wine,
# cx alike); the 9-16 B and retptr classes already went through `_ret_local_inline`. The pointee
# is copied byte-exact into an inline temp (no read past a 3/5/6/7-byte struct) and its slot is
# the value. Consumes `IDENT ;` and jumps to the epilogue; 0 leaves the cursor alone.
# ⛔ 6.7.10 (B7-1) — and a HANDLE of 8 B or less (the handle line: `var p: B8 = alloc(8); .. return p;`),
# which returns the struct it points at as a handle over 8 B does (`_ret_local_inline`); and either
# inside parentheses (`return (p);`, transparent since 6.7.6), which handed back the address. A
# handle or a `*U` of ANOTHER struct is left to the scalar tail, which refuses it by name
# (`_ret_small_val`, 6.7.11).
fn _ret_small_ptrp(S): i64 {
    if (_cur_fn_ret_sid <= 0) { return 0; }
    if (_cur_fn_ret_stash > 0) { return 0; }
    if (_cur_fn_ret_pair == 1) { return 0; }
    if (STRUCTSZ(S, _cur_fn_ret_sid - 1) > 8) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    var k = _hl_ret_k(S);
    if (k < 0) { return 0; }
    var li = FINDLOCAL(S, TOKVAL(S, GTI(S) + k));
    if (li < 0) { return _ret_small_gh(S, k); }   # 6.7.10 (B7-1g): a handle global
    var hl = _small_hdl(S, li);
    if (_is_ptr_param(S, li) == 0) { if (hl == 0) { return 0; } }
    if (GLTYPE(S, li) != 0 - _cur_fn_ret_sid) { return 0; }
    STI(S, GTI(S) + 2 + 2 * k);           # IDENT ; and the wrap
    var t = _sptr_param_temp(S, li, 0 - GLTYPE(S, li));
    EFLLOAD(S, t);
