# PARSER — the top-level scans and the fn definition:
# _warn_undefined_prepass / _tl_directive / _tl_use / _tl_pass1 / _tl_pass2 / _tl_enum_inits /
# the declaration-after-the-first-statement rule (_decl_late, _dl_*) / _fn_redirect / the
# duplicate-definition checks (_dsg_*) / _PARSE_FN_DEF_IMPL.
# ================================================================
# Split out of src/frontend/parse_fn.cyr in 6.7.15 (D25 A, the user, 2026-10-18): that file had
# reached its last 3 KB under cyrfmt's / cyrlint's 1028 KB read cap. parse.cyr includes this file
# right after parse_fn.cyr, so the token stream — and cycc — are unchanged (self-host
# byte-identical). The 6.7.17 layout review gives the frontend its folders. CHANGELOG [6.7.15]

# 6.6.5 — the pre-PARSE_PROG "registered but never defined" warning, extracted from the
# three forks (main, main_win, main_cx) that each carried a copy of it inline.
#
# ⚠ The `GFFI == 0` half is REQUIRED, not cosmetic. It runs BEFORE PARSE_PROG, which is
# where relaxed-ordering fns (`fn` after the first top-level statement) are defined; now
# that pass 1 prescans those, every one of them is registered with its owner and still has
# offset -1 here. Without the guard, compiling cycc's own source warned about
# `_emit_decimal` and friends — a fn with a recorded owner is one pass 1 SAW A DEFINITION
# for, so it is not undefined, it is not defined YET. CHANGELOG [6.6.5]
fn _warn_undefined_prepass(S): i64 {
    var wfi = 0;
    var wfc = GFNC(S);
    while (wfi < wfc) {
        if (L64(_fnt_offsets + wfi * 8) < 0 && GFFI(S, wfi) == 0) {
            syscall(SYS_WRITE, 2, "warning: undefined function '", 29);
            PRSTR(S + 0xEC00000 + _fn_src_name(S, wfi, L64(_fnt_names + wfi * 8)));   # 6.7.14: `S.nope`
            syscall(SYS_WRITE, 2, "'\n", 2);
            _tr_undef_note(S, L64(_fnt_names + wfi * 8));   # 6.7.0: an ambiguous trait method
        }
        wfi = wfi + 1;
    }
    return 0;
}

# 6.6.9 — THE top-level directive dispatcher. The pass-1 scan (_tl_scan1) calls it with
# arm=0 (consume only), the pass-2 dispatch (_tl_scan2) and PARSE_PROG call it with arm=1
# (arm the pending flag PARSE_FN_DEF transfers onto the next fn). Returns 1 when the
# token at the cursor was a directive it handled, 0 otherwise.
#
# WHY ONE FN: each of the seven src/main*.cyr forks used to carry its own copy of this
# chain in both passes, plus PARSE_PROG's copy — fifteen copies. Only main.cyr's pass 2
# armed #must_use/#deprecated/#pure/#io/#alloc, so on the other six forks an attribute
# placed before the first top-level statement (where every library puts them) was
# consumed and IGNORED: no warning, rc 0. The same drift made #naked and #inline inert on
# four targets at 6.6.3, and left #assert out of five forks' pass 1 and every pass 2, so a
# top-level `#assert` ended the declaration phase and the next struct was refused.
# A new directive goes HERE, once. CHANGELOG [6.6.9]
fn _tl_directive(S, arm): i64 {
    var t = PEEKT(S);
    if (t == 107) { _tl_assert(S, arm); return 1; }
    if (t == 124) { _tl_deprecated(S, arm); return 1; }
    if (_tl_flag_tok(t) == 0) { return 0; }
    if (arm == 1) { _tl_arm(t); }
    else { _tl_arm1(t); }   # 6.7.14: pass 1's own `#io` / `#alloc` pair
    STI(S, GTI(S) + 1);
    return 1;
}

# The one-token fn attributes: #regalloc #must_use #pure #io #alloc #naked #inline.
fn _tl_flag_tok(t): i64 {
    if (t == 109 || t == 122 || t == 125 || t == 126) { return 1; }
    if (t == 127 || t == 133 || t == 163) { return 1; }
    return 0;
}

# Arm the pending flag for a one-token fn attribute. #regalloc is armed on every fork:
# PARSE_FN_DEF's SFRA gate (`_AARCH64_BACKEND == 0`) and the picker's own cx gate keep it
# inert where the x86 picker does not exist — the same arming PARSE_PROG always did.
# ⚠ #naked is NOT armed on cx, in either position: a bytecode VM has no machine return
# address to leave unframed, so a naked body falls straight through into the next fn.
# lib/fdlopen.cyr's dl_setjmp/dl_longjmp rely on that (their cx arm is ordinary code with
# a framed `return 0`). PARSE_PROG used to arm it on cx after the first statement.
fn _tl_arm(t): i64 {
    if (t == 133) { if (_TARGET_CX == 0) { _naked_pending = 1; } return 0; }
    if (t == 109) { _regalloc_pending = 1; }
    if (t == 122) { _must_use_pending = 1; }
    if (t == 125) { _pure_pending = 1; }
    if (t == 126) { _io_pending = 1; }
    if (t == 127) { _alloc_pending = 1; }
    if (t == 163) { _inline_pending = 1; }
    return 0;
}

# Pass 1's arm: only `#io` / `#alloc`, into the pass-1 pair (`_prescan_eff_take`), never the
# pass-2 flags above — a flag carried across the pass boundary is the `_pub_pending` defect.
fn _tl_arm1(t): i64 {
    if (t == 126) { _pre_io_pending = 1; }
    if (t == 127) { _pre_alloc_pending = 1; }
    return 0;
}

# #deprecated("msg"). The message is REQUIRED (the v5.6.4 design): arm=1 refuses a bare
# `#deprecated` by name wherever it sits — it used to be a silent no-op before the first
# statement and a hard error after it. On the error the cursor stays put, so the `fn`
# that follows is still parsed. Pass 1 (arm=0) consumes and reports nothing; since 6.6.16
# it also RECORDS a complete `( STRING )` for the fn it registers next (`_prescan_dep_take`)
# — a call parsed before the definition never saw the bit, which only pass 2 set. A bare
# or malformed one records nothing: pass 2 still refuses it. CHANGELOG [6.6.16]
fn _tl_deprecated(S, arm): i64 {
    STI(S, GTI(S) + 1);
    if (arm == 0) {
        if (PEEKT(S) == 10) {
            STI(S, GTI(S) + 1);
            var _pd_msg = 0 - 1;
            if (PEEKT(S) == 30) { _pd_msg = PEEKV(S); STI(S, GTI(S) + 1); }
            if (PEEKT(S) == 11) {
                STI(S, GTI(S) + 1);
                if (_pd_msg != 0 - 1) { _pre_dep_pending = 1; _pre_dep_msg = _pd_msg; }
            }
        }
        return 0;
    }
    if (PEEKT(S) != 10) {
        # Report at the directive, not at the `fn` after it, and name the fix. The cursor is
        # already on a clean token, so clear the panic latch instead of letting the next
        # fn body's first statement resync over real code — but only the latch THIS error
        # set. When an earlier, unresynced error already held it, ERR_MSG swallowed this one
        # and an unconditional clear un-suppressed that error's cascade (a struct error plus
        # a bare `#deprecated ) )` reported 2 errors, not 1). CHANGELOG [6.6.10]
        var _dp_was = _panic;
        STI(S, GTI(S) - 1);
        ERR_MSG(S, "#deprecated needs a message string: #deprecated(<why, and what to use instead>)", 79);
        if (_dp_was == 0) { _panic = 0; }
        STI(S, GTI(S) + 1);
        return 0;
    }
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 30) { ERR_EXPECT(S, 30); return 0; }
    _deprecated_msg_pending = PEEKV(S);
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); return 0; }
    STI(S, GTI(S) + 1);
    _deprecated_pending = 1;
    return 0;
}

# #assert — arm=1 evaluates it through PARSE_STMT, which emits no code for it, so it stays a
# declaration-phase directive instead of the first statement. Pass 1 (arm=0) must consume
# EXACTLY the tokens PARSE_STMT's arm does — `#assert ATOM [OP ATOM] [,] <line tail>` —
# without evaluating (a sizeof may name a struct pass 1 has not registered yet). It used to
# skip only the #assert's own LINE, so a wrapped `#assert 1 == 1,\n  "msg";` left pass 1
# on the continuation, its scan stopped, and every later declaration went unregistered
# ("undefined variable" far below). CHANGELOG [6.6.9]
fn _tl_assert(S, arm): i64 {
    if (arm == 1) { PARSE_STMT(S); return 0; }
    STI(S, GTI(S) + 1);
    STI(S, _ce_extent(S, GTI(S)));   # 6.7.4: a const expression, by the evaluator's grammar
    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
    _assert_tail(S);
    return 0;
}

# 6.6.9 — the "large static data" advisory, on every backend that writes an executable.
# It used to live inline in x86 EMITELF_USER only, so the same `var buf[200000]` warned on
# x86_64 ELF and was silent on PE, both Mach-O targets, aarch64 and cx. `dvb`/`dcn` are the
# bytes of statics inside unreachable fns and how many such fns HOLD them (GFVB > 0), computed
# by _dead_static_stash (src/backend/common/runtime.cyr) from the x86 AND aarch64 liveness
# passes since 6.6.10; cx has no liveness pass and passes 0, so it skips the hint.
# CHANGELOG [6.6.9] [6.6.10]
fn _warn_large_static(totvar, dvb, dcn): i64 {
    totvar = totvar - _cov_bytes;   # 6.7.10: the execution-coverage band and map are the mode's, not the program's
    if (totvar <= 131072) { return 0; }
    syscall(SYS_WRITE, 2, "warning: large static data (", 28);
    PRNUM(totvar);
    syscall(SYS_WRITE, 2, " bytes) — consider alloc() for buffers >4KB\n", 46);
    # CYRIUS_DCE=1 NOPs the CODE of dead fns but does NOT free their bss reservations —
    # users hitting this warning should know that "set CYRIUS_DCE=1" is NOT the fix.
    # CHANGELOG [5.11.62]
    if (dvb > 0) {
        syscall(SYS_WRITE, 2, "  hint: ", 8);
        PRNUM(dvb);
        syscall(SYS_WRITE, 2, " bytes inside ", 14);
        PRNUM(dcn);
        syscall(SYS_WRITE, 2, " unreachable fn(s) — DCE NOPs code but keeps .bss; restructure with alloc() or move the static into a reachable consumer\n", 123);
    }
    return 0;
}

# 6.6.5 — intern `mod_name` ONCE. Writes the candidate at GNPOS WITHOUT committing; if an
# fn of exactly that name is already registered (pass 1 minted it), reuse THAT entry's
# string and leave the pool untouched, otherwise commit. mmod == 0 → noff unchanged, so
# the overwhelming majority of definitions take the old path byte-for-byte.
#
# This is the whole answer to "how does the pass-1 mangle coexist with pass 2's", which
# the filing called a design decision on the name pool: FINDFN compares by STRING, so a
# string minted in either pass serves both, and pool GROWTH is unchanged because the
# second mint is discarded. Lifted verbatim out of PARSE_FN_DEF (v5.11.65 the compiler heap guard-page gap length
# walk included) so there is one mangler, not two. CHANGELOG [6.6.5]
fn _mod_name_intern(S, mmod, noff): i64 {
    if (mmod == 0) { return noff; }
    var _mmlen = 0; while (load8(S + 0xEC00000 + mmod + _mmlen) != 0) { _mmlen = _mmlen + 1; }
    var _nflen = 0; while (load8(S + 0xEC00000 + noff + _nflen) != 0) { _nflen = _nflen + 1; }
    NPOS_GUARD(S, _mmlen + 1 + _nflen + 1);
    var mwp = GNPOS(S);
    var mnoff = mwp;
    var mri = 0;
    while (mri < _mmlen) { store8(S + 0xEC00000 + mwp, load8(S + 0xEC00000 + mmod + mri)); mwp = mwp + 1; mri = mri + 1; }
    store8(S + 0xEC00000 + mwp, 95); mwp = mwp + 1;   # '_'
    mri = 0;
    while (mri < _nflen) { store8(S + 0xEC00000 + mwp, load8(S + 0xEC00000 + noff + mri)); mwp = mwp + 1; mri = mri + 1; }
    store8(S + 0xEC00000 + mwp, 0); mwp = mwp + 1;
    var efi = FINDFN(S, mnoff);
    if (efi >= 0) {
        var en = L64(_fnt_names + efi * 8);
        if (en != mnoff) { if (STREQ(S, en, mnoff) == 1) { return en; } }
    }
    SNPOS(S, mwp);
    return mnoff;
}

# 6.6.5 — the ONE identity rule both passes use to pick the fn-table entry a DEFINITION
# owns. An existing entry belongs to this definition iff its privacy class matches and
# (for private) its owner is this file; otherwise a same-named definition from another
# file SPLITS into its own entry with bit 128 on both (the v6.5.38 sibling marker that
# makes `_findfn_scoped` pick per caller-file).
#
# ⚠ An entry with raw fid 0 is one a CALL SITE registered — it has no owner, so it is
# adopted, never split. An unattributable definition (vis_fid < 0, past the 1024-file map
# cap) is adopted too: splitting on an unknown owner creates a symbol `_findfn_scoped` can
# never select, which turns a working call into a silent rebind. Same carve-outs the
# v6.5.38 pass-2 split had; they are now in one place instead of inline in PARSE_FN_DEF.
fn _fn_def_slot(S, noff, vis_fid, this_priv): i64 {
    var fi = FINDFN(S, noff);
    if (fi < 0) { return REGFN(S, noff); }
    var raw = GFFI(S, fi);
    if (raw == 0) { return fi; }              # registered by a call site: adopt
    if (vis_fid < 0) { return fi; }           # unattributable: adopt (see above)
    var prev_priv = 0;
    if ((GFLG(S, fi) & 64) != 0) { prev_priv = 1; }
    if (this_priv == 0) { if (prev_priv == 0) { return fi; } }   # public over public
    if (raw - 1 == vis_fid) { return fi; }    # same file: a redefinition, not a collision
    var nfi = REGFN(S, noff);
    SFLG(S, fi, GFLG(S, fi) | 128);
    SFLG(S, nfi, GFLG(S, nfi) | 128);
    return nfi;
}

# 6.6.5 — the entry pass 1 registered for the definition whose `fn` token is `ti`, or -1.
# Walks the hash probe chain (a split leaves two entries under one name, both reachable
# from the same home slot) and matches on def-start AND name.
fn _fn_by_defti(S, noff, ti): i64 {
    var h = FNV1A_NOFF(S, noff);
    var slot = h & _fnt_hash_mask;
    var probes = 0;
    while (probes < _fnt_cap) {
        var stored = load32(_fnt_namehash + slot * 4);
        if (stored == 0) { return 0 - 1; }
        var fi = stored - 1;
        if (GFDS(S, fi) == ti + 1) { if (STREQ(S, L64(_fnt_names + fi * 8), noff) == 1) { return fi; } }
        slot = (slot + 1) & _fnt_hash_mask;
        probes = probes + 1;
    }
    return 0 - 1;
}

# 6.6.5 — the VERBATIM pass-1 impl brace-skip the seven forks used to carry inline. Kept
# as its own fn so `_prescan_impl` can replay it and pass 1's net cursor advance is
# byte-identical to before.
fn _prescan_skip_impl(S): i64 {
    STI(S, GTI(S) + 1);  # consume IMPL
    _impl_name_skip(S);  # consume the trait (or, inherent, the type) name
    if (PEEKT(S) == 55) {   # 6.7.0 (A3): absent in an inherent `impl Type {`
        STI(S, GTI(S) + 1);  # consume FOR
        _impl_name_skip(S);  # consume type name
    }
    if (PEEKT(S) == 13) {
        STI(S, GTI(S) + 1);
        var idep = 0;
        var isk = 1;
        while (isk == 1) {
            var it = PEEKT(S);
            if (it == 13) { idep = idep + 1; }
            if (it == 14) { if (idep == 0) { isk = 0; } else { idep = idep - 1; } }
            if (it == 12) { isk = 0; }
            STI(S, GTI(S) + 1);
        }
    }
    return 0;
}

# 6.6.5 — pass-1 impl scan. Registers and stamps each method (`Type_method`) exactly as a
# top-level fn is prescanned, mirroring PARSE_IMPL's own `_pub_pending` clear and module
# set, then RESETS the cursor and replays the canonical skip. Replaces the inline
# "skip entire block in pass 1 (functions registered in pass 2)" arm in all seven forks —
# which is what made an impl method the one definition kind with no owner, no private bit
# and no parameter masks until pass 2 had walked past its callers. CHANGELOG [6.6.5]
fn _prescan_impl(S): i64 {
    var start_ti = GTI(S);
    _pub_pending = 0;                    # mirror PARSE_IMPL's entry clear
    STI(S, GTI(S) + 1);                  # IMPL
    if (PEEKT(S) == 2) {
        var trn = PEEKV(S);
        STI(S, GTI(S) + 1);              # trait (or, inherent — 6.7.0 A3 — the type)
        var tn = 0;
        if (PEEKT(S) == 13) { tn = trn; trn = 0; }
        elif (PEEKT(S) == 55) {
            STI(S, GTI(S) + 1);          # for
            if (PEEKT(S) == 2) {
                tn = PEEKV(S);
                STI(S, GTI(S) + 1);
            }
        }
        if (tn != 0) { if (PEEKT(S) == 13) {
                STI(S, GTI(S) + 1);
                var sv = GMOD(S);
                SMOD(S, tn);
                var _sit = _impl_tnoff;
                var _sitr = _impl_trait;
                _impl_tnoff = tn;           # 6.7.0 (A4): an untyped `self` here is a `*T`
                _impl_trait = trn;          # 6.7.0 (A3): 0 = inherent
                var _sii = _cur_ii;
                _cur_ii = 0 - 1;
                if (_ti_n > 0) { _cur_ii = _ti_by_ti(S, start_ti); }
                _prescan_impl_body(S);
                _tr_defaults(S, _cur_ii, 0);   # 6.7.0 (A1): register the defaults it inherits
                _cur_ii = _sii;
                _impl_tnoff = _sit;
                _impl_trait = _sitr;
                SMOD(S, sv);
            } }
    }
    _pub_pending = 0;
    STI(S, start_ti);
    _prescan_skip_impl(S);
    return 0;
}

fn _prescan_impl_body(S): i64 {
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 14) { go = 0; }
        elif (t == 73) { _TL_VIS(S); }                 # `public` on a method
        elif (t == 153) { _TL_VIS(S); }                # `private` — marked by _PRIV_PRESCAN
        elif (t == 32) { _tr_mod_for(S); _prescan_fn_sig(S); _tr_mod_back(S); }   # 6.7.0: its prefix
        elif (_tl_directive(S, 0) == 1) { }            # 6.6.17: directives on a method (_impl_attrs)
        else { go = 0; }
    }
    return 0;
}

# 6.6.5 — skip ONE top-level statement, tracking ( { [ depth. Stops after a depth-0 `;`,
# or after a depth-0 `}` that is not followed by `else`/`elif` (a statement can end in a
# brace: `if (..) { .. } else { .. }`, `while`, `switch`, `match`). Returns 1 when the
# statement held a `fn` keyword — a definition PARSE_PROG will parse inside it (6.6.16).
fn _prescan_skip_stmt(S): i64 {
    var dep = 0;
    var go = 1;
    var hasfn = 0;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { return hasfn; }                              # EOF
        if (t == 32) {
            hasfn = 1;
            # 6.6.17 — a definition at statement position INSIDE the statement's block
            # (`if (..) { fn f(..) { .. } }`, which PARSE_PROG accepts) is prescanned like a
            # top-level one. It was skipped, so a call parsed before it warned "undefined
            # function" and — the same miscompile 6.6.5 fixed after the first statement — an
            # address-passed struct argument was pushed by value: rc 139. CHANGELOG [6.6.17]
            if (_prescan_block_fn(S, dep) == 1) { continue; }
        }
        # An attribute group before such a fn: `#deprecated("…")` is RECORDED for it, as the
        # top-level loop does, so a call parsed before the definition still warns; so are `#io` /
        # `#alloc` (6.7.14). The other one-token attributes need nothing in pass 1.
        if (t == 124) { if (dep >= 1) { _tl_deprecated(S, 0); continue; } }
        if (dep >= 1) { _tl_arm1(t); }
        if (t == 10 || t == 13 || t == 28) { dep = dep + 1; }
        if (t == 11 || t == 14 || t == 29) { dep = dep - 1; }
        STI(S, GTI(S) + 1);
        if (dep <= 0) {
            if (t == 5) { go = 0; }
            elif (t == 14) {
                var nt = PEEKT(S);
                if (nt != 23 && nt != 50) { go = 0; }
            }
        }
    }
    return hasfn;
}

# Prescan the `fn NAME` at the cursor when it sits inside a block (`dep` >= 1) — after `{`, `;`,
# `}`, an attribute (`#pure fn …`, the reviewer's find: it used to require one of the first
# three) or a `case X:`. `fn` is never an expression, so any `fn NAME` in a block is a
# definition PARSE_PROG accepts or refuses (a fn in a closure body); prescanning one it refuses
# is harmless, the compile fails there. The signature walk consumes the whole definition, braces
# balanced, so the caller's depth is unchanged. Returns 1 when it consumed one.
fn _prescan_block_fn(S, dep): i64 {
    if (dep < 1) { return 0; }
    if (TOKTYP(S, GTI(S) + 1) != 2) { return 0; }
    _prescan_fn_sig(S);
    return 1;
}

# 6.6.5 — pass 1 stops at the first top-level STATEMENT (_tl_scan1 returns 0), but
# PARSE_PROG keeps accepting `fn` definitions after it — relaxed ordering. So every fn
# below the first statement was unstamped: reachable from any file by a preceding call,
# and address-passed struct params silently miscompiled. This walks the REST of the stream
# registering only those fns; statements are skipped (a top-level `var` registers itself
# on the PARSE_PROG path, so it must NOT be handled here).
#
# The cursor and module are saved and restored, so pass 2 starts exactly where it did.
# SMOD(0) because PARSE_PROG runs after pass 2's module reset. CHANGELOG [6.6.5]
fn _prescan_tail(S): i64 {
    var sv = GTI(S);
    var svmod = GMOD(S);
    SMOD(S, 0);
    _pub_pending = 0;
    _prescan_tail_loop(S);
    _pub_pending = 0;
    _pre_attr_drop();                    # the end of pass 1: nothing may carry into pass 2
    SMOD(S, svmod);
    STI(S, sv);
    _gz_sweep(S);   # 6.7.10 (B7-1g): every fn is registered — the zone's small struct globals judged
    return 0;
}

fn _prescan_tail_loop(S): i64 {
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12) { go = 0; }                       # EOF
        # ⚠ _IS_FN_KW, not a bare `t == 32`: the pass-1 scan (_tl_scan1) asks _IS_FN_KW, so a
        # bare test here would make the two scanners disagree about what a DEFINITION is and
        # an `async fn` after the first top-level statement would stay unstamped. Not
        # reachable today (PARSE_PROG rejects `async` there on 6.6.4 and on this build), and
        # _prescan_fn_sig already consumes the `async` prefix — the two scanners agreeing is
        # the point. CHANGELOG [6.6.5]
        elif (_IS_FN_KW(S) == 1) { _prescan_fn_sig(S); }
        elif (t == 14) { _tl_stray_brace(S); go = 0; }   # an unmatched '}' — refused (6.7.9)
        elif (t == 109 || t == 122 || t == 125 || t == 126 || t == 127 || t == 133 || t == 163) { _tl_arm1(t); STI(S, GTI(S) + 1); }
        elif (t == 124) { _tl_deprecated(S, 0); }       # the pass-1 arm itself, so it records too
        # ⚠ 6.6.16 — a statement holding a `fn` (a definition inside a top-level block, which
        # PARSE_PROG accepts) is where pass 2 hands a pending `#deprecated`. Since 6.6.17 that fn
        # is prescanned (`_prescan_block_fn`), which takes the pending itself; whatever is left
        # is dropped here rather than let it land on the NEXT top-level fn — the one pass 2
        # leaves unmarked, whose every call would then warn falsely.
        elif (_prescan_skip_stmt(S) == 1) { _pre_attr_drop(); }
    }
    return 0;
}

# 6.7.9 — an unmatched `}` at module scope. Every declaration and statement before it was
# consumed with its braces balanced, so a `}` the tail loop meets closes nothing. PARSE_PROG is
# also the block parser (`}` ends its loop), so it stopped there and everything after the brace
# was silently dropped: rc 0, `main` never compiled — and in a multi-file build the lost
# definitions surfaced as "undefined" errors in OTHER files (agnos's report). Refused HERE, in
# pass 1, before any body is parsed, so it is the first diagnostic and nothing cascades. The
# hint covers the other way to get here: an extra `}` INSIDE a fn ends it early, and the fn's own
# closing brace is the one left over. CHANGELOG [6.7.9]
fn _tl_stray_brace(S): i64 {
    var quiet = _panic;   # ERR_MSG prints nothing under an earlier error; nor does the hint
    ERR_MSG(S, "unmatched '}' at module scope", 29);
    if (quiet == 0) { syscall(SYS_WRITE, 2, "  hint: if it was meant to close a fn or block, a '}' above it closed that one too soon\n", 88); }
    syscall(SYS_EXIT, 1);
    return 0;
}

# 6.6.17 — THE top-level declaration scans, shared by all seven src/main*.cyr forks: pass 1
# (register), pass 2 (define) and the enum-init walk. Each fork used to carry its own copy of
# all three — 21 loops — so a new top-level form had to be added seven times, and the fork
# that missed it broke on its own target only (#io v5.8.20, #pure v6.2.2, the 6.6.3 #inline
# consume, the 6.6.9 directive arms). A new top-level form goes HERE, once; the
# toplevel_scan_shared gate refuses a fork that re-grows a copy. `objok` is 1 on the two
# forks with an object writer (main.cyr, main_win.cyr): there `object;` selects mode 3;
# elsewhere it is not a declaration and ends the scan ("unexpected object"). CHANGELOG [6.6.17]
fn _tl_pass1(S, objok): i64 {
    _dyn_fold(S);     # 6.7.8: `dyn X` -> one identifier token, BEFORE any prepass records an index
    _tr_prepass(S);   # 6.7.0 (A1/A2): every trait and impl, before the first method is registered
    _dyn_prepass(S);  # 6.7.8: each folded `dyn X` registered (its struct) and checked where it stands
    _cst_prepass(S);  # 6.7.2 (B1): every top-level const, wherever it sits (a size-0 pending slot)
    STI(S, 0);
    var go = 1;
    while (go == 1) { go = _tl_scan1(S, objok); }
    _tl_stmt1 = GTI(S);   # 6.7.14: the first top-level statement (`_decl_late` names its line)
    _psig_reread(S);      # 6.7.15: a signature naming a struct declared below its fn, read again
    # pass 1 stops at the first top-level statement, but PARSE_PROG keeps defining fns after it
    _prescan_tail(S);
    SMOD(S, 0);
    _cst_sweep(S);    # 6.7.2: every top-level const evaluated (and checked), used or not
    _pd_sweep(S);     # 6.7.7 (B6): every parameter default too
    # 6.7.14: pass 2 restarts at token 0, in sync — a pass-1 refusal (an enum value, a global array
    # size) must not hold the cascade latch into it, where the first statement's resync swallowed
    # the statement after it (its error lost, or a const it declared "undefined"). CHANGELOG [6.7.14]
    _panic = 0;
    _bnd_target_check(S);   # 6.7.8 (C2-7): the bounds-checked mode vs kernel / EFI / shared / object
    _cov_pass1(S);    # 6.7.10 (P5B-1): the execution-coverage mode, likewise (parse_cov.cyr)
    _dyn_p2 = 1;      # 6.7.8: every struct is registered — a trait-object call's prototype may be made
    return 0;
}

# ⛔ 6.7.15 — A CALL ABOVE A FN READS THE SIGNATURE THE DEFINITION READS, WHEREVER ITS STRUCTS ARE DECLARED. The
# prescan (`_prescan_fn_sig`, CO-01) records a fn's ABI facts as pass 1 meets it, and a struct declared below the
# fn was not registered yet: `x: R2` was a plain word (its 16 / 24 B argument pushed as its first word, SIGSEGV),
# `x: *R2` recorded no struct ("cannot pass 't' ... pass &t"), a `: Pq` / `: *Later` return no struct (no hidden
# result pointer, 139; "no struct type in scope"), and a struct named like a vector, `Result` or `bool` the
# built-in. A call parsed before the definition reads that record. So each definition is noted (`_psig_note`: the
# fn, its `fn` and `(` tokens, how many structs were registered, its impl context), and once the scan has
# registered every struct, a definition whose signature names one registered after it (`_psig_late`) is read
# again by the same reader (`_prescan_sig_facts`) — the one-time parts (the slot, visibility, `#deprecated` /
# effect / method notes, generic records) are not re-run. A signature naming no such struct is never re-read, so
# a program whose structs precede their fns compiles byte-identically.
# (issues/2026-10-17-forward-call-struct-parameter-of-struct-declared-below-fn.md, the return twin.) CHANGELOG [6.7.15]
var _psig_tab = 0;   # 9 words per prescanned definition (`_psig_note`), a vec made at the first
fn _psig_note(S, fi, ti, pasync): i64 {
    if (_psig_tab == 0) { _psig_tab = vec_new(); }
    vec_push(_psig_tab, fi);
    vec_push(_psig_tab, ti);
    vec_push(_psig_tab, GTI(S));
    vec_push(_psig_tab, GSTC(S));
    vec_push(_psig_tab, pasync);
    vec_push(_psig_tab, GMOD(S));
    vec_push(_psig_tab, _impl_tnoff);
    vec_push(_psig_tab, _impl_trait);
    vec_push(_psig_tab, _cur_ii);
    return 0;
}
# The end of pass 1's scan: each noted definition that a struct registered after it may change, read again. The
# cursor, the module and the impl context are put back.
fn _psig_reread(S): i64 {
    if (_psig_tab == 0) { return 0; }
    var sv = GTI(S);
    var svm = GMOD(S);
    var sit = _impl_tnoff;
    var sitr = _impl_trait;
    var sii = _cur_ii;
    var n = vec_len(_psig_tab);
    var i = 0;
    while (i < n) {
        if (vec_get(_psig_tab, i + 3) < GSTC(S)) { _psig_one(S, i); }
        i = i + 9;
    }
    _impl_tnoff = sit;
    _impl_trait = sitr;
    _cur_ii = sii;
    SMOD(S, svm);
    STI(S, sv);
    return 0;
}
# Entry `i`: re-read when it is still its fn's record (a later definition of the same fn is the one calls reach) and
# its signature names a late struct. The kind row past ordinal 61 is rebuilt whole, as the definition rebuilds it.
fn _psig_one(S, i): i64 {
    var fi = vec_get(_psig_tab, i);
    var ti = vec_get(_psig_tab, i + 1);
    if (GFDS(S, fi) != ti + 1) { return 0; }
    if (_psig_late(S, ti, vec_get(_psig_tab, i + 3)) == 0) { return 0; }
    SMOD(S, vec_get(_psig_tab, i + 5));
    _impl_tnoff = vec_get(_psig_tab, i + 6);
    _impl_trait = vec_get(_psig_tab, i + 7);
    _cur_ii = vec_get(_psig_tab, i + 8);
    STI(S, vec_get(_psig_tab, i + 2));
    _pm_row_reset(fi);
    _prescan_sig_facts(S, fi, ti, vec_get(_psig_tab, i + 4));
    return 0;
}
# 1 = the signature of the definition whose `fn` is token `ti` — its name to the body's `{` (or a `;`) — holds a name
# that resolves to a struct registered after the first `sc0` (`FINDSTRUCT` answered otherwise when it was read).
fn _psig_late(S, ti, sc0): i64 {
    var n = GTCNT(S);
    var k = ti + 1;
    while (k < n) {
        var t = TOKTYP(S, k);
        if (t == 13 || t == 5 || t == 12) { return 0; }
        if (t == 2) { if (_psig_late_name(S, TOKVAL(S, k), sc0) == 1) { return 1; } }
        k = k + 1;
    }
    return 0;
}
fn _psig_late_name(S, noff, sc0): i64 {
    var sc = GSTC(S);
    var j = sc0;
    while (j < sc) {
        if (STREQ(S, L64(S + 0x1A6018 + j * 8), noff) == 1) {
            if (FINDSTRUCT(S, noff) > sc0) { return 1; }
            return 0;
        }
        j = j + 1;
    }
    return 0;
}

# ⛔ 6.7.14 — A DECLARATION AFTER THE FIRST TOP-LEVEL STATEMENT IS ONE ERROR BY NAME (the user's decision D13 (a),
# 2026-10-16: the guide's rule). Pass 1 registers declarations up to the first statement (`_tl_scan1`); after it
# PARSE_PROG takes a `fn` of any kind, a `const` and a `var`. A `struct`, `enum`, `union`, `trait`, `impl`, `mod`,
# `use` or `pub` / `public` there reached PARSE_STMT: "unexpected struct" (`union`: "expected ';', got union") and up
# to three invented errors, the statement resync re-entering its braces; an `include` of a file declaring one failed
# inside that file ("lib/str.cyr:24:1: unexpected struct" + three). Now one error naming the rule and the first
# statement's line, and the declaration stepped (`_dl_skip`); one inside a file whose `include` follows the statement
# is reported at that include line, the rest of the inclusion stepped (its fns would use what it declares). Module
# scope only (`_pp_depth` 1); a block's or a fn body's declaration is `_decl_inner`'s (6.7.15). CHANGELOG [6.7.14]
var _tl_stmt1 = 0 - 1;   # the first top-level statement's first token (`_tl_pass1`), -1 before pass 1
fn _decl_late(S): i64 {
    if (_decl_inner(S) == 1) { return 1; }   # 6.7.15: in a fn body or a block
    if (GINFN(S) != 0) { return 0; }
    if (_pp_depth != 1) { return 0; }
    if (_dl_kind(PEEKT(S)) == 0) { return 0; }
    if (_tl_stmt1 < 0) { return 0; }
    var ti = GTI(S);
    var l1 = GTLINE(S, ti);
    var f1 = FM_SITE(S, l1);
    var f0 = FM_SITE(S, GTLINE(S, _tl_stmt1));
    var n0 = _fm_site_line;
    if (f1 != f0) { if (_dl_incl(S, l1, f0, n0) == 1) { return 1; } }
    _dl_report(S, ti, f1, f0, n0);
    _dl_skip(S);
    _dl_derived(S);
    _dl_names(S, ti, GTI(S));   # 6.7.15
    _dl_quiet(S, ti, GTI(S));
    return 1;
}
# ⛔ 6.7.15 — ONE LEVEL DOWN: a `struct`, `enum`, `union`, `trait` or `impl` in a fn body or a block (GINFN 1, or
# `_pp_depth` past module scope) belongs to the declaration section too (the guide's rule, D13 (a)'s one level
# down). PARSE_PROG is also the block and fn-body parser, so it reached PARSE_STMT: "unexpected struct" (`union`:
# "expected ';', got union") and up to four invented errors, the resync re-entering the declaration's braces and
# the fn body's own `}` consumed ("return outside a fn body"). Now one error by name at the keyword, the
# declaration stepped as at module scope (`_dl_skip_in`: never the `}` that closes the enclosing body), and what it
# names and the fns it would define entered as reported (`_dl_names`, `_dl_quiet`), so the body parses on in sync.
# CHANGELOG [6.7.15]
fn _decl_inner(S): i64 {
    if (GINFN(S) == 0) { if (_pp_depth <= 1) { return 0; } }
    var t = PEEKT(S);
    if (t != 40 && t != 60 && t != 101 && t != 167 && t != 77) { return 0; }   # struct enum union trait impl
    var ti = GTI(S);
    _dl_in_report(S, ti);
    _dl_skip_in(S);
    _dl_derived(S);
    _dl_names(S, ti, GTI(S));
    _dl_quiet(S, ti, GTI(S));
    return 1;
}
# "a `struct` declaration belongs to the declaration section at top level, not inside a fn body" (or "... not
# inside a block"), at the keyword `ti`; once per token (a generic's instances, an inline replay) and not over a
# refused const fn's check of the same token (`_ce_err_dup`). No panic latch: the body's next statement is its own.
fn _dl_in_report(S, ti): i64 {
    _had_error = 1;
    if (_panic == 1) { return 0; }
    var id = "declaration section";
    if (_ce_err_dup(S, (id * 31 + 19) * 8 + 4) == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    PRSTR(": ");
    _dl_art_kw(S, ti);
    PRSTR(" declaration belongs to the declaration section at top level, not inside ");
    if (GINFN(S) == 1) { PRSTR("a fn body\n"); } else { PRSTR("a block\n"); }
    _err_excerpt(S);
    return 0;
}
# A `#derive`d struct / enum: the preprocessor writes its generated fns onto the expanded line of the closing `}`
# (v6.5.20, PP_DERIVE_SERIALIZE). They are the refused type's, so a `fn` / `public fn` the declaration's line still
# holds is stepped with the rest of that line (the derive's `#assert sizeof(Q)` was "unknown type 'Q'", an enum's
# `public` codec a second refusal).
fn _dl_derived(S): i64 {
    if (PEEKT(S) != 32) { if (PEEKT(S) != 73) { return 0; } }
    var ln = GTLINE(S, GTI(S) - 1);
    while (PEEKT(S) != 12) {
        if (GTLINE(S, GTI(S)) != ln) { return 0; }
        STI(S, GTI(S) + 1);
    }
    return 0;
}
# 1 = token type `t` opens a declaration the rule keeps before the first statement.
fn _dl_kind(t): i64 {
    if (t == 40 || t == 60 || t == 101 || t == 167) { return 1; }   # struct enum union trait
    if (t == 77 || t == 72 || t == 74 || t == 73) { return 1; }     # impl mod use pub / public
    return 0;
}
# "a `struct` declaration must come before the first top-level statement (line 2)", at the keyword `ti`; the
# statement's file is named too when it is another (`f0` != `f1`).
fn _dl_report(S, ti, f1, f0, n0): i64 {
    if (_panic == 1) { return 0; }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    PRSTR(": ");
    _dl_art_kw(S, ti);
    PRSTR(" declaration must come before the first top-level statement (");
    _dl_where(S, f1, f0, n0);
    PRSTR(")\n");
    _err_excerpt(S);
    _had_error = 1;
    return 0;
}
# "a `struct`" / "an `impl`": the keyword as the source spells it (`pub` or `public`).
fn _dl_art_kw(S, ti): i64 {
    var t = TOKTYP(S, ti);
    if (t == 60 || t == 77) { PRSTR("an `"); } else { PRSTR("a `"); }
    var p = S + 0x459D000 + GTOFF(S, ti);
    var n = 0;
    while (ISALNUM(load8(p + n)) == 1) { n = n + 1; }
    if (n == 0) { PRSTR(TOKNAME(t)); } else { syscall(SYS_WRITE, 2, p, n); }
    PRSTR("`");
    return 0;
}
# "line 2", or "lib/x.cyr:2" when the first statement sits in another file than the one reporting.
fn _dl_where(S, f1, f0, n0): i64 {
    if (f1 == f0) { PRSTR("line "); }
    elif (f0 >= 0) { PRSTR(S + 0x721000 + f0); PRSTR(":"); }
    PRNUM(n0);
    return 0;
}
# The declaration at expanded line `l1` sits in an inclusion of another file than the first statement's (`f0`): when
# that file resumes after it — the include's own line is that resume's base less one — the include is reported
# there, once, and the rest of the inclusion is stepped. 0 = no such resume (the statement is in a file that ended
# before: the caller reports the declaration itself).
fn _dl_incl(S, l1, f0, n0): i64 {
    if (f0 < 0) { return 0; }
    var cnt = load64(S + 0x71A000);
    var i = 0;
    while (i < cnt) {
        if (load64(S + 0x71A040 + i * 24) > l1) {
            if (load64(S + 0x71A040 + i * 24 + 16) == f0) { return _dl_incl_at(S, l1, i, f0, n0); }
        }
        i = i + 1;
    }
    return 0;
}
fn _dl_incl_at(S, l1, e, f0, n0): i64 {
    var ti = GTI(S);
    if (_panic == 0) {
        PRSTR("error:");
        PRSTR(S + 0x721000 + f0);
        PRSTR(":");
        PRNUM((load64(S + 0x71A040 + e * 24 + 8) >> 32) - 1);
        PRSTR(":1: an include of a file that declares ");
        _dl_art_kw(S, ti);
        PRSTR(" (");
        FM_LOOKUP(S, l1);
        PRSTR(") must come before the first top-level statement (line ");
        PRNUM(n0);
        PRSTR(")\n");
        _had_error = 1;
    }
    var st = load64(S + 0x71A040 + e * 24);
    while (PEEKT(S) != 12) {
        if (GTLINE(S, GTI(S)) >= st) { break; }
        STI(S, GTI(S) + 1);
    }
    _dl_names(S, ti, GTI(S));   # 6.7.15
    _dl_quiet(S, ti, GTI(S));
    return 1;
}
# ⚠ The fns a refused declaration would have defined — a `pub fn`, an impl's methods (`T_m`), a `use` alias, the free
# fns of a refused inclusion or of a derive's line — are entered as REPORTED (offset -2, `_nested_fn_mark`'s rule), so
# a call of one adds no "undefined function" + "refusing to emit binary" to the one error. A fn defined elsewhere is
# untouched (its offset is no longer -1, or its definition writes it).
fn _dl_quiet(S, a, e): i64 {
    var isid = 0;
    var d = 0;
    var i = a;
    while (i < e) {
        var k = TOKTYP(S, i);
        if (k == 77) { if (d == 0) { isid = _dl_impl_sid(S, i); } }
        if (k == 13) { d = d + 1; }
        if (k == 14) { d = d - 1; if (d <= 0) { isid = 0; } }
        if (k == 32) { if (TOKTYP(S, i + 1) == 2) { _dl_fn_at(S, i, d, isid); } }
        i = i + 1;
    }
    if (TOKTYP(S, a) == 74) { if (TOKTYP(S, e - 2) == 2) { _dl_fn_quiet(S, TOKVAL(S, e - 2), a, 0); } }   # `use m.f;`
    return 0;
}
fn _dl_fn_at(S, i, d, isid): i64 {
    var n = TOKVAL(S, i + 1);
    if (d == 0) { return _dl_fn_quiet(S, n, i, 0); }
    if (d != 1) { return 0; }
    if (isid <= 0) { return 0; }
    var mn = BUILD_METHOD_NAME(S, isid - 1, n);
    if (mn == GNPOS(S)) { var l = 0; while (load8(S + 0xEC00000 + mn + l) != 0) { l = l + 1; } SNPOS(S, mn + l + 1); }
    return _dl_fn_quiet(S, mn, i, ((L64(S + 0x1A6018 + (isid - 1) * 8) + 1) << 32) | n);
}
# `impl T {` / `impl Tr for T {` at token `i`: T's struct id, 0 when T names none.
fn _dl_impl_sid(S, i): i64 {
    var n = i + 1;
    if (TOKTYP(S, i + 2) == 55) { n = i + 3; }
    if (TOKTYP(S, n) != 2) { return 0; }
    var sid = FINDSTRUCT(S, TOKVAL(S, n));
    if (sid < 0) { return 0; }
    return sid;
}
fn _dl_fn_quiet(S, noff, kw, meth): i64 {
    var fi = FINDFN(S, noff);
    if (fi < 0) { fi = REGFN(S, noff); }
    if (L64(_fnt_offsets + fi * 8) != 0 - 1) { return 0; }
    S64(_fnt_offsets + fi * 8, 0 - 2);
    if (GFFI(S, fi) == 0) { SFFI(S, fi, FM_FILEID(S, GTLINE(S, kw)) + 1); }
    if (meth != 0) { if (GFMETH(S, fi) == 0) { SFMETH(S, fi, meth); } }   # named `T.m`, as a call would
    return 0;
}
# ⛔ 6.7.15 — AND WHAT IT NAMES: a refused declaration's struct, union and enum names and an enum's members are
# entered as reported too (`_dl_names`, over the tokens the refusal stepped: a late declaration, a refused
# inclusion, one in a fn body or a block), so a USE of one is not a second error after the declaration's —
# `var q = Q { 5 };` was "undefined variable 'Q'" + "expected ';', got '{'", `E.B` / `B` "undefined variable",
# `fn f(q: *Q)` "unknown type 'Q' for parameter 'q'" and its `q.y` "no struct type in scope for 'q'". The
# reporters ask `_dl_refd_at` (the name: `_undef_var_report`, `_tn_refuse`, the stray literal's `_slit_refd`) and
# `_ann_refd_said` (a variable whose annotation named one: the `.field`, method and field-store `sid == 0` arms)
# and stand down, counted (`_had_error`), not printed. Exact names only: a name that resolves never reaches a
# reporter, and one declared nowhere is still reported. A payload member's constructor is a fn: `_dl_fn_quiet`.
# CHANGELOG [6.7.15]
var _dlr = 0;   # the refused names (name offsets), a vec made at the first
var _dlv = 0;   # (scope, name) pairs: the variables `_ann_refd_mark` marked, a vec made at the first
fn _dl_names(S, a, e): i64 {
    var d = 0;
    var i = a;
    while (i < e) {
        var k = TOKTYP(S, i);
        if (d == 0) { _dl_name_at(S, i, k, e); }
        if (k == 13) { d = d + 1; }
        if (k == 14) { d = d - 1; }
        i = i + 1;
    }
    return 0;
}
# A `struct` / `union` / `enum` keyword at token `i` (`k`), at depth 0 of the stepped range: its name, an enum's
# members.
fn _dl_name_at(S, i, k, e): i64 {
    if (k != 40 && k != 101 && k != 60) { return 0; }
    if (TOKTYP(S, i + 1) != 2) { return 0; }
    _dl_refd_add(S, TOKVAL(S, i + 1));
    if (k == 60) { _dl_members(S, i + 2, e); }
    return 0;
}
# The members of the enum whose header runs from token `j` (past its name: a `<..>`, a `: stack`, its `{`): each
# name that opens a member — after the `{`, a `,` or a `;`, outside a payload's `( .. )` — to the enum's `}`.
fn _dl_members(S, j, e): i64 {
    while (j < e) {
        if (TOKTYP(S, j) == 13) { break; }
        j = j + 1;
    }
    var p = 0;
    var i = j + 1;
    while (i < e) {
        var k = TOKTYP(S, i);
        if (k == 14) { if (p == 0) { return 0; } }
        if (k == 10) { p = p + 1; }
        if (k == 11) { p = p - 1; }
        if (k == 2) { if (p == 0) { _dl_member_at(S, i); } }
        i = i + 1;
    }
    return 0;
}
fn _dl_member_at(S, i): i64 {
    var b = TOKTYP(S, i - 1);
    if (b != 13 && b != 31 && b != 5) { return 0; }
    _dl_refd_add(S, TOKVAL(S, i));
    if (TOKTYP(S, i + 1) == 10) { _dl_fn_quiet(S, TOKVAL(S, i), i, 0); }   # `Ok2(v)`: its constructor
    return 0;
}
fn _dl_refd_add(S, noff): i64 {
    if (_dlr == 0) { _dlr = vec_new(); }
    vec_push(_dlr, noff);
    return 0;
}
# 1 = `noff` names what a refused declaration declared (`_dl_names`): the use stands down, counted.
fn _dl_refd_at(S, noff): i64 {
    if (_dlr == 0) { return 0; }
    if (noff < 0) { return 0; }
    var n = vec_len(_dlr);
    var i = 0;
    while (i < n) {
        if (STREQ(S, vec_get(_dlr, i), noff) == 1) { _had_error = 1; return 1; }
        i = i + 1;
    }
    return 0;
}
# `_tn_refuse`'s stand-down: the type name at token `ti` is a refused declaration's, so the annotation is not
# reported again, and the variable it annotates (`vnoff`, -1 for none) is marked (`_ann_refd_mark`). 1 = stood down.
fn _dl_refd_ann(S, ti, vnoff): i64 {
    if (_dl_refd_at(S, TOKVAL(S, ti)) == 0) { return 0; }
    _ann_refd_mark(S, vnoff);
    return 1;
}
# The stand-down helper the "no struct type in scope" reporters share: variable `vnoff`, declared here — a local
# or a parameter of the fn being compiled (its `_cur_fn_ix`), at top level a global — took an annotation that was
# refused (or, `_slit_stray`, a refused struct's literal), so its uses are counted, not reported (`_ann_refd_said`).
fn _ann_refd_mark(S, vnoff): i64 {
    if (vnoff < 0) { return 0; }
    if (_dlv == 0) { _dlv = vec_new(); }
    var sc = 0 - 2;
    if (GINFN(S) == 1) { sc = _cur_fn_ix; }
    vec_push(_dlv, sc);
    vec_push(_dlv, vnoff);
    return 0;
}
# 1 = variable `noff`, resolved to `idx` (a global >= 0, a local < -1), was marked by `_ann_refd_mark` in its
# scope: counted as ERR_IDENT would count the report (`_had_error`, the panic latch: the statement resyncs), not
# printed. A closure capture is not looked up.
fn _ann_refd_said(S, noff, idx): i64 {
    if (_dlv == 0) { return 0; }
    var sc = 0 - 2;
    if (idx < 0) {
        if (idx > 0 - 2) { return 0; }
        if (idx <= 0 - 1000000) { return 0; }
        sc = _cur_fn_ix;
    }
    var n = vec_len(_dlv);
    var i = 0;
    while (i < n) {
        if (vec_get(_dlv, i) == sc) {
            if (STREQ(S, vec_get(_dlv, i + 1), noff) == 1) {
                _had_error = 1;
                _panic = 1;
                return 1;
            }
        }
        i = i + 2;
    }
    return 0;
}
# Step the declaration at the cursor: through the `}` closing its first `{ .. }`, or through its `;` when that comes
# first at depth 0 (`mod m;`, `use m.f;`, `pub var x = ..;`, `pub const ..;`). A `pub` steps what it marks.
fn _dl_skip(S): i64 { return _dl_skip_at(S, 0); }
# Below module scope (`_decl_inner`): a `}` met at depth 0 closes the enclosing fn body or block — left for it.
fn _dl_skip_in(S): i64 { return _dl_skip_at(S, 1); }
fn _dl_skip_at(S, inner): i64 {
    var semi = 0;
    var t = PEEKT(S);
    if (t == 72 || t == 74) { semi = 1; }
    if (t == 73) {
        var t2 = TOKTYP(S, GTI(S) + 1);
        if (t2 == 3 || t2 == 168 || t2 == 72 || t2 == 74) { semi = 1; }
    }
    var d = 0;
    while (PEEKT(S) != 12) {
        var k = PEEKT(S);
        if (inner == 1) { if (k == 14) { if (d == 0) { return 0; } } }
        STI(S, GTI(S) + 1);
        if (k == 10 || k == 28 || k == 13) { d = d + 1; }
        if (k == 11 || k == 29 || k == 14) { d = d - 1; }
        if (d <= 0) {
            if (k == 5) { return 0; }
            if (k == 14) { if (semi == 0) { return 0; } }
        }
    }
    return 0;
}

# One pass-1 step: consume one top-level declaration and return 1, or return 0 at the first
# token that is not one (the first statement). The arms only peek until they match.
fn _tl_scan1(S, objok): i64 {
    var t = PEEKT(S);
    if (t == 72) { _tl_mod(S); return 1; }
    if (_TL_VIS(S) == 1) { return 1; }
    if (t == 74) { _tl_use(S); return 1; }
    if (t == 40) { PARSE_STRUCT_DEF(S); return 1; }
    if (t == 101) { PARSE_UNION_DEF(S); return 1; }
    if (t == 3) { PARSE_GVAR_REG(S); return 1; }
    if (_tl_directive(S, 0) == 1) { return 1; }
    if (_IS_FN_KW(S) == 1) { _prescan_fn_sig(S); return 1; }   # v6.3.5 CO-01: register + ABI masks
    if (t == 168) { _cst_skip_decl(S); return 1; }   # 6.7.2 (B1): recorded by `_cst_prepass`
    if (t == 60) { PARSE_ENUM_DEF(S, 0); return 1; }
    var r = _tl_scan1_mode(S, t, objok);
    return r;
}

fn _tl_scan1_mode(S, t, objok): i64 {
    if (_TOK_IS_KERNEL(S) == 1) { _tl_kmode(S, 1); return 1; }
    if (t == 78) { _tl_kmode(S, 2); return 1; }
    if (t == 79) { if (objok == 1) { _tl_kmode(S, 3); return 1; } }
    if (t == 77) { _prescan_impl(S); return 1; }
    if (t == 167) { _tl_trait1(S); return 1; }   # 6.7.0 (A1): recorded by `_tr_prepass`
    return 0;
}

# `kernel;` / `shared;` / `object;` — set kernel_mode (pass 1). Pass 2 only skips them.
fn _tl_kmode(S, m): i64 {
    S64(S + 0x18FCA0, m);
    _tl_skip_mode(S);
    return 0;
}

fn _tl_skip_mode(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# `mod name;` — set the module prefix (both passes).
fn _tl_mod(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# `use modname.funcname;` — register the alias funcname -> modname_funcname (pass 1).
fn _tl_use(S): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) == 2) {
        var umod = PEEKV(S);
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 41) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) == 2) {
                var ufn = PEEKV(S);
                # 6.6.20: `use m.mulh64;` binds the BARE name, so it is a declaration of it —
                # the call would lower to the intrinsic. No fnptr.cyr exemption (isfn 0).
                _RSV_INTRINSIC_DECL(S, ufn, GTI(S), 0);
                STI(S, GTI(S) + 1);
                _tl_use_alias(S, umod, ufn);
            }
        }
    }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# Append the mangled `mod_fn` to tok_names (NPOS is stable after lexing) and record the alias
# in the use table. v5.11.65 (the compiler heap guard-page gap): bounded by the actual source lengths.
# 6.6.20 (the use-alias table overflow bug): use_from / use_to hold 64 entries each and ABUT (use_from[64] is use_to[0],
# use_to[64] the count), so the 65th alias silently re-bound alias #1 and later ones walked the
# heap up to gvar_cnt. Refuse BEFORE any store; ERR_MSG does not exit, so the return is the stop.
fn _tl_use_alias(S, umod, ufn): i64 {
    var uc = GUSEC(S);
    if (uc >= 64) { ERR_MSG(S, "too many `use` aliases (max 64)", 31); return 0; }
    S64(S + 0x18FFD0 + uc * 8, ufn);
    var _ulen1 = 0; while (load8(S + 0xEC00000 + umod + _ulen1) != 0) { _ulen1 = _ulen1 + 1; }
    var _ulen2 = 0; while (load8(S + 0xEC00000 + ufn + _ulen2) != 0) { _ulen2 = _ulen2 + 1; }
    NPOS_GUARD(S, _ulen1 + 1 + _ulen2 + 1);
    var apos = GNPOS(S);
    var ri = 0;
    var rc = load8(S + 0xEC00000 + umod + ri);
    while (rc != 0) { store8(S + 0xEC00000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0xEC00000 + umod + ri); }
    store8(S + 0xEC00000 + apos, 95); apos = apos + 1;
    ri = 0; rc = load8(S + 0xEC00000 + ufn + ri);
    while (rc != 0) { store8(S + 0xEC00000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0xEC00000 + ufn + ri); }
    store8(S + 0xEC00000 + apos, 0); apos = apos + 1;
    var alias_noff = GNPOS(S);
    SNPOS(S, apos);
    S64(S + 0x1901D0 + uc * 8, alias_noff);
    SUSEC(S, uc + 1);
    return 0;
}

# Pass 2: define fns, impls and enum constructors; skip what pass 1 already registered.
fn _tl_pass2(S, objok): i64 {
    STI(S, 0);
    var go = 1;
    while (go == 1) { go = _tl_scan2(S, objok); }
    SMOD(S, 0);
    return 0;
}

fn _tl_scan2(S, objok): i64 {
    var t = PEEKT(S);
    if (t == 72) { _tl_mod(S); return 1; }
    if (_TL_VIS(S) == 1) { return 1; }
    if (t == 74) { _tl_skip_use(S); return 1; }
    if (t == 40) { _tl_skip_struct(S); return 1; }
    if (t == 101) { _tl_skip_union(S); return 1; }
    if (t == 60) { PARSE_ENUM_DEF(S, 2); return 1; }   # constructor bodies, before the jmp patch
    if (_TOK_IS_KERNEL(S) == 1) { _tl_skip_mode(S); return 1; }
    # 6.6.9: ONE dispatcher arms every fn attribute and evaluates #assert. See _tl_directive.
    if (_tl_directive(S, 1) == 1) { return 1; }
    var r = _tl_scan2_def(S, t, objok);
    return r;
}

fn _tl_scan2_def(S, t, objok): i64 {
    if (_IS_FN_KW(S) == 1) {
        # v6.5.17: EVERY fn body is parsed, reachable or not — reachability is a codegen
        # concern (CYRIUS_DCE=1, backend/x86/fixup.cyr), not a parsing one. A parse-time body
        # skip once made garbage in an uncalled fn compile GREEN on x86 and fail on aarch64
        # (tests/gates/frontend/dead_fn_body_syntax_checked.sh).
        # v6.3.11 (G): consume a leading `async` and arm the lowering PARSE_FN_DEF consumes.
        if (PEEKT(S) == 134) { _pending_async = 1; STI(S, GTI(S) + 1); }
        if (PEEKT(S) == 168) { _pending_cfn = 1; STI(S, GTI(S) + 1); }   # 6.7.2 (C1): `const fn`
        PARSE_FN_DEF(S);
        return 1;
    }
    if (t == 168) {   # 6.7.2 (B1): a top-level const (no code); one the pre-scan did not take is malformed
        if (_cst_is_top(S, GTI(S)) == 0) { _cst_stmt(S); return 1; }
        _cst_skip_decl(S);
        return 1;
    }
    if (t == 3) { _skip_gvar_decl(S); return 1; }   # 6.6.6: a `;` inside a closure body is not the end
    if (t == 77) { PARSE_IMPL(S); return 1; }
    if (t == 167) { _tl_trait2(S); return 1; }   # 6.7.0 (A1)
    if (t == 78) { _tl_skip_mode(S); return 1; }
    if (t == 79) { if (objok == 1) { _tl_skip_mode(S); return 1; } }
    return 0;
}

fn _tl_skip_use(S): i64 {
    while (PEEKT(S) != 5) { if (PEEKT(S) == 12) { break; } STI(S, GTI(S) + 1); }
    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    return 0;
}

# A struct (with its optional `<T>` list) or a union was parsed in pass 1: skip to its `}`.
fn _tl_skip_struct(S): i64 {
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
    _tl_skip_body(S);
    return 0;
}

fn _tl_skip_union(S): i64 {
    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
    _tl_skip_body(S);
    return 0;
}

fn _tl_skip_body(S): i64 {
    if (PEEKT(S) != 13) { ERR(S); }
    STI(S, GTI(S) + 1);
    var go = 1;
    while (go == 1) { if (PEEKT(S) == 14) { go = 0; } else { STI(S, GTI(S) + 1); } }
    STI(S, GTI(S) + 1);
    return 0;
}

# Enum initialisations, emitted FIRST (before the gvar inits, which may call fns that read
# enum values). Walks the whole token stream; the caller restores the cursor.
fn _tl_enum_inits(S): i64 {
    STI(S, 0);
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 1); }
        else { if (PEEKT(S) == 12) { go = 0; }
            else { STI(S, GTI(S) + 1); } }
    }
    return 0;
}

# v6.3.11 (G): mint `base$impl` — the hidden body-fn name for an `async fn`. The
# user-facing name `base` becomes the Future constructor; `base$impl` holds the
# actual body and is only ever reached by pointer (future_force), never by name.
fn _mint_impl_name(S, base_noff): i64 {
    var blen = 0;
    while (load8(S + 0xEC00000 + base_noff + blen) != 0) { blen = blen + 1; }
    NPOS_GUARD(S, blen + 8);
    var wp = GNPOS(S);
    var noff = wp;
    var i = 0;
    while (i < blen) { store8(S + 0xEC00000 + wp, load8(S + 0xEC00000 + base_noff + i)); wp = wp + 1; i = i + 1; }
    store8(S + 0xEC00000 + wp, 36); wp = wp + 1;    # '$'
    store8(S + 0xEC00000 + wp, 105); wp = wp + 1;   # 'i'
    store8(S + 0xEC00000 + wp, 109); wp = wp + 1;   # 'm'
    store8(S + 0xEC00000 + wp, 112); wp = wp + 1;   # 'p'
    store8(S + 0xEC00000 + wp, 108); wp = wp + 1;   # 'l'
    store8(S + 0xEC00000 + wp, 0); wp = wp + 1;
    SNPOS(S, wp);
    return noff;
}

# 6.6.10 — THE ARGC WORD CARRIES TWO MARKERS, so `future_force` can tell the three Future
# shapes apart without rewriting anything during a force (lib/async.cyr, lockstep):
#   FUT_MEMO (256) — a PLAIN compiler-built Future `[fp, argc, args…, done, value]`: forced once,
#                    and every later force answers from the memo. It used to re-run the body on
#                    every force (`await F; await F;` ran it twice), while a coroutine did not.
#   FUT_CORO (512) — a coroutine. Its impl takes exactly ONE argument, SELF at obj[16], so the
#                    arity is 1 whatever the declared parameter count; storing `pc` there made a
#                    0-parameter coroutine SIGSEGV (fncall0 left SELF garbage) and a 9+-parameter
#                    one exit 70 at its first force.
# A hand-built Future (`[fp, argc, args…]`, argc 0..8) carries neither and is re-run per force.
fn _async_argc_word(pc): i64 {
    if (_coro_was == 1) { return 1 | 512; }
    return pc | 256;
}
# 6.6.10 — `future_force`'s dispatch ladder stops at fncall8, so a PLAIN async fn with 9+
# parameters compiled clean and died at its first force (exit 70). Refuse it at the declaration.
# A coroutine has no limit: its arguments are frame locals and its impl takes SELF alone.
fn _async_refuse_arity(S, fi_f, noff_f, pc): i64 {
    if (_coro_was == 1) { return 0; }
    if (pc <= 8) { return 0; }
    if (_panic == 1) { return 1; }
    syscall(SYS_WRITE, 2, "error:", 6);
    var dti = GFDS(S, fi_f) - 1;
    if (dti >= 0) { _err_head_at(S, dti); } else { _err_head(S); }
    syscall(SYS_WRITE, 2, ": async fn `", 12);
    PRSTR(S + 0xEC00000 + noff_f);
    syscall(SYS_WRITE, 2, "` takes ", 8);
    PRNUM(pc);
    syscall(SYS_WRITE, 2, " parameters; an async fn that never awaits takes at most 8 (its Future is forced through fncall0..fncall8)\n", 107);
    _had_error = 1;
    return 1;
}

# 6.6.20 — the constructor's entry is set through `_fn_redirect`, like a plain definition's: an
# `async fn` redefined by another `async fn` binds every call to the LAST constructor (a call
# compiled between the two baked the first one's entry, whose Future shape may not even match —
# a plain Future against a coroutine's SIGSEGV'd). `async` against plain is refused in pass 1
# (`_dsg_async_check`). CHANGELOG [6.6.20]
fn _async_ctor_entry(S, fi_f, noff_f): i64 {
    var ti = GFDS(S, fi_f) - 1;   # its `fn` token, for the backstop's diagnostic
    if (ti < 0) { ti = 0; }
    _fn_redirect(S, fi_f, noff_f, ti);
    S64(_fnt_offsets + fi_f * 8, GCP(S));
    return 0;
}
# v6.3.11 (G): emit the Future constructor for an `async fn`. The body has already
# been emitted (as `f$impl`, fi_impl, with pc params); this synthesizes the
# user-named fn `f(p0..p{pc-1})` whose body allocates a Future heap object
# `[ &f$impl, pc, p0, … ]` and returns its pointer. Calls to `f` therefore build a
# deferred Future instead of running the body; `await fut` forces it (future_force).
# Mirrors the closure env construction (alloc + fn-addr fixup + field stores), but
# the captured values are the call's actual arguments and the dispatch is fncallN
# (future_force) rather than the hidden-env callptr convention. Needs lib/alloc.cyr.
fn _async_emit_constructor(S, noff_f, fi_impl, pc): i64 {
    var alloc_fi = _FINDFN_CSTR(S, "alloc", 5);
    var fi_f = FINDFN(S, noff_f);
    if (fi_f < 0) { fi_f = REGFN(S, noff_f); }
    SFAS(S, fi_f, 1);
    S64(_fnt_params + fi_f * 8, pc);
    if (_async_refuse_arity(S, fi_f, noff_f, pc) == 1) {
        _async_ctor_entry(S, fi_f, noff_f);
        return 0;
    }
    # Refused BEFORE any code: ERR_MSG does not exit, and the body below handed -1 to
    # ECALLFIX — rc 139 on aarch64/cx after the diagnostic. `f` still gets an offset (nothing
    # is written for a failed compile) so its callers do not add a second, false "reachable
    # undefined function" refusal. CHANGELOG [6.6.9]
    if (alloc_fi < 0) {
        ERR_MSG(S, "an async fn needs include \"lib/alloc.cyr\" for its Future heap object", 68);
        _async_ctor_entry(S, fi_f, noff_f);
        return 0;
    }
    # --- save enclosing (top-level) state; the constructor is its own fn ---
    # 6.6.7 — through the shared per-fn snapshot (parse.cyr `_fnst_save`), which zeroes the
    # parameter span, regalloc, ret class and the rest, and gives the constructor its own
    # return-patch and defer ranges. (6.6.6 had to add `_cur_fn_pslots` here by hand after the
    # list drifted; the shared snapshot is what stops the next one drifting.) CHANGELOG [6.6.7]
    var st = _fnst_save(S);
    _cur_fn_ix = fi_f;
    # 6.6.11: no skip-jmp before the constructor. Every caller is either unreachable by
    # fall-through here (the previous byte is f$impl's `ret`) or already jumps over the whole
    # definition (PARSE_PROG's fn_skip, the generic re-emit). The jmp sat in no fn's range,
    # so the DCE seed pass took it as a root and kept the NEXT fn alive. CHANGELOG [6.6.11]
    _async_ctor_entry(S, fi_f, noff_f);
    EFNPRO(S);
    # params p0..p{pc-1} → anonymous local slots 0..pc-1
    # ⛔ v6.5.70: this used to read `if (i < 6) { ESTOREPARM(S, i, i, 0); }` — TWO defects in
    # one line, and together they made `async fn` SILENTLY WRONG at arity >= 7. Parameters
    # past the sixth arrive on the STACK, so gating the call skipped homing them entirely and
    # the `obj[16 + i*8]` writes below then copied uninitialised frame slots into the Future.
    # And the arity argument was hard-coded 0, which is what `ESTORESTACKPARM` needs to compute
    # the SysV stack-arg displacement, so even an un-gated call would have addressed the wrong
    # slot. Measured: `await a7(1,2,3,4,5,6,7)` returned a code-address-shaped value instead of
    # 28 — exit 0, no diagnostic — while the 6-parameter async form and the PLAIN 7-parameter
    # fn were both correct in the same program.
    # `ESTOREPARM` already dispatches to `ESTORESTACKPARM` past the register args (4 on Win64,
    # 6 on SysV); it only ever needed to be called and told the arity. CHANGELOG [6.5.70]
    var i = 0;
    while (i < pc) {
        S64(S + 0x5D9D000 + i * 8, 0 - 1);
        SLDEP(S, i, 0);
        ESTOREPARM(S, i, i, pc);
        SFLC(S, i + 1);
        i = i + 1;
    }
    var frame_patch = ESUBRSP(S);
    # v6.5.69: a COROUTINE's object is also its FRAME, so it is sized for the body's locals
    # rather than just its arguments: [fp, argc, SELF, state, local0 … local{flc-1}].
    # ⛔ Getting this wrong is a heap overflow, not a wrong answer: the transform stores the
    # state word at +24 and locals from +32, and the pre-v6.5.69 object is (2+pc)*8 = 24
    # bytes for a 1-parameter fn — the state write alone lands one word past the allocation.
    # 6.6.10: a PLAIN Future also carries two trailing memo words `[done, value]` (see
    # `_async_argc_word`); a coroutine already keeps its completion past the frame.
    var _obj_bytes = (2 + pc) * 8 + 16;
    if (_coro_was == 1) { _obj_bytes = _coro_res_off() + 8; }   # 6.6.8: + the completion word
    # obj = alloc(_obj_bytes)
    EMOVI(S, _obj_bytes);
    EPUSHR(S);
    ECALLPOPS(S, 1);
    ECALLFIX(S, alloc_fi);
    ECALLCLEAN(S, 1);   # 6.6.5: was missing (see ECALLCLEAN)
    var obj_slot = pc;
    S64(S + 0x5D9D000 + obj_slot * 8, 0 - 1);
    SLDEP(S, obj_slot, 0);
    EFLSTORE(S, obj_slot);
    SFLC(S, obj_slot + 1);
    # obj[0] = &f$impl  (fixup-resolved code address)
    EFLLOAD(S, obj_slot);
    EPUSHR(S);
    var fc = GFCNT(S);
    if (fc >= 1048576) {
        syscall(SYS_WRITE, 2, "error: fixup table full (1048576)\n", 34);
        syscall(SYS_EXIT, 1);
    }
    ELOAD_FN_ADDR(S, _fixup_base + fc * 16, fc, fi_impl);
    EPOPC(S);
    ESTORE64(S);
    # obj[8] = the argc word (pc | FUT_MEMO, or 1 | FUT_CORO — `_async_argc_word`)
    EFLLOAD(S, obj_slot);
    EADDRA_IMM(S, 8);
    EPUSHR(S);
    EMOVI(S, _async_argc_word(pc));
    EPOPC(S);
    ESTORE64(S);
    # v6.5.69: a coroutine's arg0 is the object ITSELF. `future_force` re-enters the body as
    # `fncall1(fp, obj[16])`, so storing SELF there is what hands the body its own frame on
    # every resume — the runtime needs no change at all. The state word starts at 0, which the
    # fn-end dispatch maps to the top of the real body.
    if (_coro_was == 1) {
        EFLLOAD(S, obj_slot);
        EADDRA_IMM(S, 16);
        EPUSHR(S);
        EFLLOAD(S, obj_slot);
        EPOPC(S);
        ESTORE64(S);                       # obj[16] = SELF
        EFLLOAD(S, obj_slot);
        EADDRA_IMM(S, _CORO_STATE_OFF);
        EPUSHR(S);
        EMOVI(S, 0);
        EPOPC(S);
        ESTORE64(S);                       # obj[state] = 0
        # The user's arguments become the coroutine's first frame locals. The body's
        # parameters occupy slots 1..pc (slot 0 is the reserved frame base), and slot k maps
        # to `_CORO_LOCAL_OFF + (k - 1) * 8` — so argument i lands exactly where parameter i
        # will read it. v6.5.70.
        var _ci = 0;
        while (_ci < pc) {
            EFLLOAD(S, obj_slot);
            EADDRA_IMM(S, _CORO_LOCAL_OFF + _ci * 8);
            EPUSHR(S);
            EFLLOAD(S, _ci);
            EPOPC(S);
            ESTORE64(S);
            _ci = _ci + 1;
        }
    }
    # obj[16 + i*8] = arg i (the constructor's param, captured by value)
    i = 0;
    if (_coro_was == 1) { i = pc; }        # a coroutine captures no positional args yet
    while (i < pc) {
        EFLLOAD(S, obj_slot);
        EADDRA_IMM(S, 16 + i * 8);
        EPUSHR(S);
        EFLLOAD(S, i);
        EPOPC(S);
        ESTORE64(S);
        i = i + 1;
    }
    # obj[16 + pc*8] = 0: the memo's `done` word. alloc does not promise zeroed memory (a
    # freelist / arena hands back used blocks), and a stale 1 would answer the first force with
    # a stale value. CHANGELOG [6.6.10]
    if (_coro_was == 0) {
        EFLLOAD(S, obj_slot);
        EADDRA_IMM(S, 16 + pc * 8);
        EPUSHR(S);
        EMOVI(S, 0);
        EPOPC(S);
        ESTORE64(S);
    }
    # return obj
    EFLLOAD(S, obj_slot);
    EFNEPI(S);
    var fsz = (GFLC(S) * 8 + 15) & (0 - 16);
    EPATCHFRAME(S, frame_patch, fsz);
    SFNE(S, fi_f, GCP(S));
    # --- restore enclosing state ---
    _fnst_restore(S, st);
    return 0;
}

# v6.5.0 Phase 1 — `CYRIUS_FILEID_DUMP=1` prints `<fileid> <fnname>` per definition.
#
# This exists so the substrate is VERIFIABLE and, just as importantly, so it is not
# WRITE-ONLY. The v6.4.82 closeout audit found `_fnt_is_async` had exactly one
# occurrence of its getter repo-wide — its own definition — meaning it lazily allocates
# 256 KB that nothing ever reads. A "recorded, not enforced" phase is precisely how a
# table ends up in that state, so Phase 1 ships its own reader and its own gate rather
# than waiting for Phase 2 to justify it retroactively.
#
# `-1` prints for an unrecorded/overflowed fn; see FM_FILEID's fail-closed note.
# Split into its own fn (not inlined at the record site) because PARSE_FN_DEF is
# already large and cybs mis-compiles fns carrying too many global/literal references —
# the `_var_grow` / `TOKNAME_BUILTIN` / `PP_FNAME_TOO_LONG` precedent. seed-derive is
# the gate that catches that, and it is run below.
var _fileid_dump = 0;
var _fileid_dump_init = 0;

fn _fileid_dump_note(S, fi, noff): i64 {
    PRNUM(GFFI(S, fi) - 1);
    syscall(SYS_WRITE, 2, " ", 1);
    # v6.5.0 Phase 2: also surface the visibility bit, so the gate can assert on the
    # decision and not merely on the file partition.
    if ((GFLG(S, fi) & 64) != 0) { syscall(SYS_WRITE, 2, "P ", 2); }
    else { syscall(SYS_WRITE, 2, "- ", 2); }
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "\n", 1);
    return 0;
}

fn _fileid_dump_arm(): i64 {
    if (_fileid_dump_init != 0) { return _fileid_dump; }
    _fileid_dump_init = 1;
    var e = _read_env("CYRIUS_FILEID_DUMP");
    if (e != 0) { if (load8(e) == 49) { if (load8(e + 1) == 0) { _fileid_dump = 1; } } }
    return _fileid_dump;
}

# 6.6.6 — A STACK-PASSED PARAMETER IS HOMED BY THE LOOP THAT CLASSIFIED IT. PARSE_FN_DEF's
# parameter loop is the only place that knows each parameter's arg ordinal (the CALLER's
# int-class position: `int_pc`, +1 for an x86 retptr) and its frame slot (`li`, which a value
# vector's filler slots push past its position). Past the register ceiling it cannot home the
# value yet — SysV/aarch64 stack slots count DOWN from the caller's int-class TOTAL — so it
# records (ordinal, slot) here and `_stkp_flush` homes them once the total is known. The old
# post-loop re-derived all three from `pc`, the all-class count: right only when every param is
# int-class, one slot, and there is no retptr. A value-form vector made it read the wrong
# register/stack slot INTO the wrong frame slot (`n6(v, 1..6)` read `e` as 0), a retptr made it
# read the return address, and it homed a coroutine impl's params, which the loop had refused
# (they arrive in the coroutine frame). CHANGELOG [6.6.6]
var _stkp_vec = 0;
# 6.6.17 (a10): and the fn's parameter-kind overflow row (`_pmw`) — the definition's own loop
# rebuilds it, as its S64 stores rewrite the masks. The masks are replaced whole; the row is only
# ever OR-ed into (`_pm_row_or`), so it is cleared here first, or whatever pass 1 recorded for this
# fn index would survive under pass 2's answer instead of being replaced by it. Called once, at
# the top of the parameter loop, with `_cur_fn_ix` already the fn being defined.
fn _stkp_reset(): i64 {
    if (_stkp_vec == 0) { _stkp_vec = vec_new(); }
    vec_truncate(_stkp_vec, 0);
    _pm_row_reset(_cur_fn_ix);
    return 0;
}
fn _stkp_defer(pidx, li): i64 {
    vec_push(_stkp_vec, (pidx << 32) | li);
    return 0;
}
fn _stkp_flush(S, nint): i64 {
    var n = vec_len(_stkp_vec);
    var k = 0;
    while (k < n) {
        var e = vec_get(_stkp_vec, k);
        ESTOREPARM(S, e >> 32, e & 0xFFFFFFFF, nint);
        k = k + 1;
    }
    return 0;
}

# v6.5.19 (the define-body copy overflow bug): the fn-definition tier. `fn f() { ` repeated 514 times SIGSEGV'd —
# the cheapest of the six vectors at ~16 KB of stack per level, and the one neither the
# PARSE_STMT nor the PEXPR bound caught, because a nested definition recursed through
# THIS function rather than the statement wrapper (a top-level `fn` is dispatched from
# PARSE_PROG, and a nested one re-entered here until 6.6.16 refused it — parse.cyr
# `_refuse_nested_fn`). Wrapper shape identical to the other three chokepoints. See
# _rd_enter (src/common/util.cyr).
fn PARSE_FN_DEF(S): i64 {
    _rd_enter(S);
    # 6.6.5 — a fn body is emitted with its OWN frame, so its expression depth starts at 0
    # regardless of where the definition was encountered. That matters because a body can be
    # emitted MID-EXPRESSION: a closure literal in an argument position emits the closure's
    # body inline. Save, zero, check against 0 on the way out, restore.
    var _xd_outer = _xdepth;
    _xdepth = 0;
    # 6.7.2 (B1): an enclosing fn's local consts are not this body's (a generic instance or a
    # relaxed-order fn is parsed inside another).
    var _lc_sv_n = _lc_n;
    var _lc_sv_f = _lc_floor;
    _lc_floor = _lc_n;
    var _rn_sv = _ce_fn_rname;   # 6.7.14: a const fn's refused name / check is its own body's (`_ce_name_said`, `_ce_fld_said`)
    var _rf_sv = _ce_fn_refd;
    var _rt_sv = _ce_fn_rtok;   # 6.7.15 (`_ce_err_dup`)
    _ce_fn_rname = 0 - 1;
    _ce_fn_refd = 0;
    _ce_fn_rtok = 0 - 1;
    # ⚠ 6.6.5 — there is deliberately NO UEFI firmware-return flag saved/zeroed here. One
    # was, for a round: the reasoning was "a `ret` inside a body returns to the cyrius
    # caller, not to firmware", which is true of a RETURN but not of an EXIT —
    # `syscall(60, x)` in a fn body must still reach firmware, and with the flag cleared it
    # emitted a bare 0xC3 at `rbp - fsz` and #GP'd under OVMF. EEXIT restores the parked
    # entry rsp instead, which is depth-independent, so there is nothing per-body to track.
    # See src/common/util.cyr for the whole post-mortem. CHANGELOG [6.6.5]
    var _rf = _PARSE_FN_DEF_IMPL(S);
    _lc_n = _lc_sv_n;
    _lc_floor = _lc_sv_f;
    _ce_fn_rname = _rn_sv;
    _ce_fn_refd = _rf_sv;
    _ce_fn_rtok = _rt_sv;
    _rd_exit();
    _xd_check(S, 0, "fn body");
    _xdepth = _xd_outer;
    return _rf;
}

# 6.6.20 — "LAST DEFINITION WINS" FOR EVERY REFERENCE, NOT ONLY THE ONES THE FIXUP PASS SEES.
# A call to an already-defined fn is emitted against the entry it has at that moment (ECALLTO
# bakes the offset — fifteen frontend sites, plus `main` calls, vtables and every other shape
# that reads `_fnt_offsets` directly), while forward calls, tail calls and `&fn` go through
# fixups that resolve to the final entry. So `fn g` / `fn h() { var x = g(); }` / `fn g` bound
# h to the FIRST g while the warning promised the last, on x86, aarch64 and cx alike. Rather
# than re-route every site through a fixup (which changes the fixup and per-fn jump tables, and
# so the bytes, of programs with no redefinition), the earlier entry is made a jump to the new
# one when the redefinition's body starts: every reference to it, of whatever shape, follows.
# Chains (a third definition) are jumps to jumps. The jump lies outside every fn's range, so
# the dead-code pass takes it as a root and keeps the winning body live; the rest of the losing
# body is recorded (`_fnr_add`), so its calls are not roots (6.7.14). Runs ONLY for a
# redefinition, so every other program is byte-identical. The calls this cannot reach — an
# inline replay, a generic instance — read pass 1's fn flag 2048 instead. CHANGELOG [6.6.20]
# ⚠ Every body is at least one jump long today (the defer-init placeholder opens even an empty
# `#naked` body), so the refusal below is a backstop: writing past a shorter body would land in
# the NEXT fn.
fn _fn_redirect(S, fi, noff, ti): i64 {
    var old = L64(_fnt_offsets + fi * 8);
    if (old < 0) { return 0; }
    if (EFNREDIRECT(S, old, GFNE(S, fi), GCP(S)) == 0) {
        _fnr_add(old, GFNE(S, fi));   # 6.7.14: its calls are no dead-code roots (util.cyr)
        return 0;
    }
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": duplicate fn '", 16);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "': internal: its earlier body is shorter than a jump, so the calls bound to it cannot be redirected\n", 100);
    _had_error = 1;
    return 0;
}

# ⛔ v6.5.37 — carry the FIRST definition's arity and origin file across the parameter
# list, so a differing-arity duplicate can be reported as an ERROR once the new arity is
# known. Declared here, above both uses: a global declared BELOW its use is not visible in
# cyrius. -1 = no duplicate pending for the definition currently being parsed.
var _dup_prev_pc = 0 - 1;
var _dup_prev_fid = 0;

# ⛔ 6.6.20 — A DUPLICATE THAT DISAGREES ABOUT HOW IT IS CALLED IS AN ERROR TOO. Once every call
# reaches the last definition (`_fn_redirect`), a call compiled against an earlier one arrives with
# THAT one's calling convention: a retptr the winner never reads, a scalar where it fills a struct,
# an XMM argument it takes from a GPR, a C string where it reads a `Str`. Measured before this
# check: a scalar first `mk()` and a struct-returning last one SIGSEGV'd (a call between them used
# to bind the first and run). Same reasoning as the v6.5.37 arity error, for the rest of the call
# signature: the return type (unannotated is i64), a multi-value count, variadic, the
# per-parameter vector / struct / Str / cstring / Result / Option / Tagged masks, the same kinds
# for the ordinals past those masks' widths (the overflow row, `_pm_row_get`), the struct type
# of every address-passed struct parameter (GFPSID — `f(p: A)` then `f(p: B)` made B's body copy
# B's size out of the caller's A) and every vector parameter's type (`_dsg_vec_note`, for Win64).
# Saved from the earlier definition before this one overwrites them; compared once this one's
# signature is read. An arity difference is left to the arity error; `async` against plain is
# refused in pass 1 (`_dsg_async_check`).
var _dsg_on = 0;
var _dsg_pc = 0;
var _dsg_rs = 0;
var _dsg_rn = 0;
var _dsg_va = 0;
var _dsg_mk[8];   # the earlier definition's seven parameter masks (a bare top-level array is N*8 B)
var _dsg_ord = 0;   # and its per-ordinal facts: [count][overflow kind, struct id, vector type]
fn _dsg_rs_norm(v): i64 { if (v == 0) { return 0 - 8; } return v; }
# Parameter mask `k` of fn `fi`: the ones that change what a call passes or how it is checked.
fn _dsg_mask(fi, k): i64 {
    var t = _fnt_simdmask;
    if (k == 1) { t = _fnt_structmask; }
    if (k == 2) { t = _fnt_strmask; }
    if (k == 3) { t = _fnt_cstrmask; }
    if (k == 4) { t = _fnt_resmask; }
    if (k == 5) { t = _fnt_optmask; }
    if (k == 6) { t = _fnt_tagmask; }
    return L64(t + fi * 8);
}
# The struct id of parameter `i` when it is an address-passed struct, else 0.
fn _dsg_psid(S, fi, i): i64 {
    if (_pm_struct(fi, i) == 0) { return 0; }
    return GFPSID(S, fi, i);
}
# A REDEFINED fn's VECTOR parameter types, per ordinal (the descriptor `pt_simd_sid`): Win64
# passes every vector by address under the struct mask and leaves the SIMD mask 0, so the masks
# alone could not tell `f(v: f64v2)` from `f(v: f64v4)` there, and the 32-byte body copied 32
# bytes out of the caller's 16 (SysV refuses the pair through the SIMD mask). Lazy, at the max fn
# cap like _fnt_tparams, and written only for flag 2048 — a program without a redefinition never
# allocates it. Rows are [capacity][one word per ordinal] (`_psid_grow`).
var _fnt_dsgv = 0;
fn _dsg_vec_note(S, fi, pc, vsid): i64 {
    if ((GFLG(S, fi) & 2048) == 0) { return 0; }
    if (_fnt_dsgv == 0) { _fnt_dsgv = alloc(131072 * 8); }
    var row = L64(_fnt_dsgv + fi * 8);
    var cap = 0;
    if (row != 0) { cap = load64(row); }
    if (pc >= cap) {
        row = _psid_grow(row, cap, pc);
        S64(_fnt_dsgv + fi * 8, row);
    }
    S64(row + 8 + pc * 8, vsid);
    return 0;
}
fn _dsg_vec_get(fi, pc): i64 {
    if (_fnt_dsgv == 0) { return 0; }
    var row = L64(_fnt_dsgv + fi * 8);
    if (row == 0) { return 0; }
    if (pc >= load64(row)) { return 0; }
    return L64(row + 8 + pc * 8);
}
# Zero one [capacity][word per ordinal] row of a per-fn table (0 = none).
fn _dsg_row_zero(t, fi): i64 {
    if (t == 0) { return 0; }
    var row = L64(t + fi * 8);
    if (row == 0) { return 0; }
    var n = load64(row);
    var i = 0;
    while (i < n) { store64(row + 8 + i * 8, 0); i = i + 1; }
    return 0;
}
# A REDEFINED fn's struct-id and vector-type rows start empty at each definition's parameter
# list. Neither is rewritten wholesale like the masks — pass 1 leaves the LAST definition's
# struct ids in its row, and a parameter kind that records no id (a Win64 vector) would leave
# that stale id under the earlier definition — so without this the comparison could read the
# same value on both sides. Only for flag 2048: every other fn's rows are untouched.
fn _dsg_def_reset(S, fi): i64 {
    if ((GFLG(S, fi) & 2048) == 0) { return 0; }
    _dsg_row_zero(_fnt_psid, fi);
    _dsg_row_zero(_fnt_dsgv, fi);
    return 0;
}
fn _dsg_save(S, fi): i64 {
    _dsg_on = 1;
    _dsg_pc = L64(_fnt_params + fi * 8);
    _dsg_rs = _dsg_rs_norm(GFRS(S, fi));
    _dsg_rn = GFRN(S, fi);
    _dsg_va = GFVA(S, fi);
    var k = 0;
    while (k < 7) { S64(&_dsg_mk + k * 8, _dsg_mask(fi, k)); k = k + 1; }
    var n = _dsg_pc;
    if (n < 0) { n = 0; }
    _dsg_ord = alloc(8 + n * 24);
    store64(_dsg_ord, n);
    var i = 0;
    while (i < n) {
        store64(_dsg_ord + 8 + i * 24, _pm_row_get(fi, i));
        store64(_dsg_ord + 16 + i * 24, _dsg_psid(S, fi, i));
        store64(_dsg_ord + 24 + i * 24, _dsg_vec_get(fi, i));
        i = i + 1;
    }
    return 0;
}
# 1 when an ordinal's overflow kind, struct id or vector type differs from the saved definition's.
fn _dsg_ord_differs(S, fi): i64 {
    var n = load64(_dsg_ord);
    var i = 0;
    while (i < n) {
        if (_pm_row_get(fi, i) != load64(_dsg_ord + 8 + i * 24)) { return 1; }
        if (_dsg_psid(S, fi, i) != load64(_dsg_ord + 16 + i * 24)) { return 1; }
        if (_dsg_vec_get(fi, i) != load64(_dsg_ord + 24 + i * 24)) { return 1; }
        i = i + 1;
    }
    return 0;
}
fn _dsg_check(S, fi, noff, ti): i64 {
    if (_dsg_on == 0) { return 0; }
    _dsg_on = 0;
    if (L64(_fnt_params + fi * 8) != _dsg_pc) { return 0; }   # the arity error covers it
    var what = 0;
    if (_dsg_rs_norm(GFRS(S, fi)) != _dsg_rs) { what = 1; }
    if (GFRN(S, fi) != _dsg_rn) { what = 1; }
    if (what == 0) { if (GFVA(S, fi) != _dsg_va) { what = 3; } }
    var k = 0;
    while (k < 7) {
        if (what == 0) { if (_dsg_mask(fi, k) != L64(&_dsg_mk + k * 8)) { what = 2; } }
        k = k + 1;
    }
    if (what == 0) { if (_dsg_ord_differs(S, fi) == 1) { what = 2; } }
    if (what == 0) { return 0; }
    return _dsg_report(S, noff, ti, what, _dup_prev_fid);
}
# The error both checks print. `fid` is the earlier definition's origin (GFFI form).
fn _dsg_report(S, noff, ti, what, fid): i64 {
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head_at(S, ti);
    syscall(SYS_WRITE, 2, ": duplicate fn '", 16);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' disagrees about its ", 22);
    if (what == 1) { syscall(SYS_WRITE, 2, "return type", 11); }
    if (what == 2) { syscall(SYS_WRITE, 2, "parameter types", 15); }
    if (what == 3) { syscall(SYS_WRITE, 2, "variadic parameter list", 23); }
    if (what == 4) { syscall(SYS_WRITE, 2, "`async` marker", 14); }
    syscall(SYS_WRITE, 2, " with the one in ", 17);
    _fm_print_fid(S, fid);
    syscall(SYS_WRITE, 2, " (last definition wins, so calls compiled against that one would reach this body through the wrong calling convention)\n", 119);
    _had_error = 1;
    return 0;
}
# 6.6.20 — `async fn f` against a plain `fn f`: a call to an async fn receives a Future, a call to
# a plain one the value, so once the last definition wins, one side reads the other's result as
# the wrong thing (measured: async-then-plain SIGSEGV'd at the `await`; plain-then-async bound
# the FIRST body with no warning at all, the async body being registered as `f$impl`). Refused
# here, in PASS 1, because it is the only place both definitions are seen under ONE entry: in
# pass 2 the async one's body is `f$impl` and its constructor never reaches the duplicate path,
# and GFAS is set by ANY async definition of the name. Called on a redefinition (`_pds`), with
# `was` = whether an earlier definition was async (GFAS before this one sets it), `now` = this.
fn _dsg_async_check(S, fi, noff, ti, was, now): i64 {
    if (was == now) { return 0; }
    return _dsg_report(S, noff, ti, 4, GFFI(S, fi));
}

fn _PARSE_FN_DEF_IMPL(S): i64 {
    var _is_async = 0;
    var _async_noff_f = 0;
    var _cfn_here = _pending_cfn;   # 6.7.2 (C1): the dispatch consumed a `const` prefix
    _pending_cfn = 0;
    # v6.3.11 (G): the pass-2 dispatch already consumed the leading `async` (token
    # 134) and set _pending_async, so the cursor is at `fn` here. (The async token is
    # consumed in the dispatch, not here, so the DCE pre-check reads the real fn name.)
    if (_pending_async == 1) {
        _pending_async = 0;
        _ensure_async_gate(S);
        # A refused `async fn` compiles as a plain fn: lowering it anyway needed lib/alloc.cyr
        # for a Future nothing will run, and reported a second error for it. CHANGELOG [6.6.9]
        if (_ASYNC_OK == 0) { ERR_MSG(S, "async fn requires CYRIUS_ASYNC=1 (async/await are gated)", 56); }
        else { _is_async = 1; }
    }
    var _defstart_ti = GTI(S);   # v6.3.10: the `fn`-keyword token, for instance re-emit
    STI(S, GTI(S) + 1);  # consume FN
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var noff = PEEKV(S);
    STI(S, GTI(S) + 1);
    # Skip generic parameters if present: fn foo<T, U>(...)
    # v6.3.9 (F-fns): capture <T> names (flag-off = old SKIP_GENERICS skip); stored
    # into _fnt_tparams[fi] once fi is resolved below (fi isn't known until the name
    # is mangled + registered, so the packed names ride _gtp until then).
    var _gtp = _capture_tparams(S);
    # Mangle name if inside a module: mod_fn
    var mmod = GMOD(S);
    # v6.3.10 (instantiate-once): re-emitting a specialized instance — the mangled
    # name `foo$ty` is already fully formed, so use it verbatim and skip module
    # mangling. (_inst_name is set only by the instantiate trigger's re-invoke.)
    if (_inst_name != 0) { noff = _inst_name; mmod = 0; }
    # 6.6.5 — one mangler, shared with pass 1 (see _mod_name_intern). Pass 1 now mints
    # `Type_method` / `mod_fn` first, so this call finds that exact string and REUSES it
    # instead of minting a second copy; pool growth is unchanged either way.
    noff = _mod_name_intern(S, mmod, noff);
    _RSV_INTRINSIC_DECL(S, noff, _defstart_ti + 1, 1);   # 6.6.20: `fn mulh64` / `fn fncallN` / `fn sizeof`
    # v6.3.11 (G): async fn — the user name `f` becomes a Future constructor
    # (synthesized after the body, below); the body itself is emitted under `f$impl`.
    # Generic async (`async fn f<T>`) is deferred — error rather than miscompile.
    if (_is_async == 1) {
        if (_gtp != 0) { ERR_MSG(S, "async generic fns not yet supported", 35); }
        _async_noff_f = noff;
        noff = _mint_impl_name(S, noff);
    }
    # Register or find fn.
    # v5.7.9: detect duplicate fn definitions across translation
    # units. If FINDFN returns an existing slot AND that slot already
    # has a non-(-1) body offset, this is a re-definition that
    # silently overwrites the previous body. Pre-v5.7.9, the
    # overwrite was completely silent — `lib/json.cyr fn json_build/1`
    # vs `lib/patra.cyr fn json_build/6` was the surfaced case
    # (last-include wins; the build appeared to succeed; calls to
    # the losing arity miscompiled). Forward declarations (slot
    # registered with offset=-1 by an earlier call site that landed
    # before the definition) leave the offset at -1, so the call
    # below does not fire on them — only on actual re-definitions.
    # v6.5.38 — visibility is now needed BEFORE the duplicate decision, so it is computed
    # here rather than after `fi` resolves (where Phase 1 originally stamped it). Whether
    # this definition is private decides whether a same-named definition SPLITS into its
    # own symbol or overwrites the existing one.
    var _vis_fid = FM_FILEID(S, GTLINE(S, _defstart_ti));
    var _this_priv = 0;
    if (_pub_pending == 0) { if (_PRIV_FILE(_vis_fid) == 1) { _this_priv = 1; } }
    # v6.6.4: a monomorphized INSTANCE inherits its BASE's visibility. The instance is
    # emitted by re-parsing the base's tokens from its `fn` keyword, so `_pub_pending`
    # is long consumed and `_PRIV_FILE` answers for the lib file — which stamped every
    # instance of a `public fn pgen<T>` in a private file PRIVATE, and refused
    # `pgen<i32>(42)` from another file while `pgen(42)` (the i64 base) was accepted.
    if (_inst_name != 0) {
        _this_priv = 0;
        if ((GFLG(S, _inst_base_fi) & 64) != 0) { _this_priv = 1; }
    }

    _dup_prev_pc = 0 - 1;
    _dsg_on = 0;
    # 6.6.5 — PASS 1 IS THE AUTHORITY. `_fn_by_defti` finds the entry pass 1 registered for
    # THIS definition (matched on its `fn` token), which does two things:
    #   * the entry is this definition's own, so the v6.5.38 per-file split has already
    #     happened in pass 1 — before any forward call could bind to the wrong one;
    #   * `_this_priv` is taken from that stamp rather than recomputed. Pass 2 computes
    #     visibility a SECOND time and gets it wrong in one case: its top-level `var` skip
    #     re-arms `public` and never consumes it, so the next fn was stamped public in a
    #     private file. That was masked only because the pass-1 bit was never cleared;
    #     clearing it (below, at the stamp) without this would have exposed it.
    # An instance (`_inst_name != 0`) is re-parsed from the BASE's tokens, so its def-start
    # names the base — it deliberately bypasses this and keeps the v6.6.4 inherited bit.
    var fi = 0 - 1;
    if (_inst_name == 0) { fi = _fn_by_defti(S, noff, _defstart_ti); }
    if (fi >= 0) {
        # ⚠ Only when nothing has CLAIMED the entry yet. Two same-file definitions of one
        # name share an entry (that is a redefinition, not a collision — it must keep
        # warning), and an entry holds ONE bit, so after the first definition emitted its
        # body the bit describes whichever definition wrote last. Measured: `public fn h()`
        # followed by `fn h()` in a private file came out PUBLIC, where every release since
        # v6.5.0 made it private. An offset >= 0 means an earlier definition owns this slot,
        # so this one keeps the visibility it computed for itself.
        if (L64(_fnt_offsets + fi * 8) < 0) {
            _this_priv = 0;
            if ((GFLG(S, fi) & 64) != 0) { _this_priv = 1; }
        }
    } else {
        # Not found — a monomorphized instance, an async fn's `f$impl`, or an earlier definition
        # of a redefined fn (pass 1 keeps the last one's start). A fn inside a top-level block is
        # prescanned since 6.6.17 (`_prescan_block_fn`; one inside a fn body is refused, parse.cyr
        # `_refuse_nested_fn`). The v6.5.38 identity rule still applies; it lives in
        # `_fn_def_slot` now so pass 1 and pass 2 cannot drift apart about what a definition owns.
        fi = _fn_def_slot(S, noff, _vis_fid, _this_priv);
        _pd_late(S, fi, GTI(S), _is_async);   # 6.7.7 (B6): an instance's defaults are its base's
    }
    var _dup_off = L64(_fnt_offsets + fi * 8);
    if (_dup_off >= 0) {
        # v6.5.37: remember the loser's arity + file; the comparison happens once this
        # definition's own parameter list has been counted (see _fnt_params store below).
        _dup_prev_pc = L64(_fnt_params + fi * 8);
        _dup_prev_fid = GFFI(S, fi);
        _dsg_save(S, fi);   # 6.6.20: and the rest of its call signature (see _dsg_check)
        # v6.5.19 (agnosai filing) — TWO fixes to this one warning:
        #  * `_err_head_at(S, _defstart_ti)` instead of `_err_head(S)`. The cursor
        #    has already consumed `fn` and the NAME by here, so the plain head put
        #    the column on the `(` of the parameter list rather than on the
        #    definition. `_defstart_ti` is the `fn` keyword itself.
        #  * name the file the FIRST definition came from. GFFI still holds it —
        #    SFFI for THIS definition is written further down, after `fi` resolves —
        #    so the consumer gets both ends of the collision instead of having to
        #    infer "which copy wins" from a single position, which is the wrong
        #    inference the filing had to retract twice.
        syscall(SYS_WRITE, 2, "warning:", 8);
        _err_head_at(S, _defstart_ti);
        syscall(SYS_WRITE, 2, ": duplicate fn '", 16);
        PRSTR(S + 0xEC00000 + noff);
        syscall(SYS_WRITE, 2, "' (last definition wins; first defined in ", 42);
        _fm_print_fid(S, GFFI(S, fi));
        syscall(SYS_WRITE, 2, ")\n", 2);
    }
    if (_gtp != 0) { SFTP(S, fi, _gtp); }   # v6.3.9 (F-fns): record this fn's <T> names
    if (_cfn_here == 1) {   # 6.7.2 (C1): `const fn` — marked (pass 1 did too) and checked ONCE, here
        SFCFN(S, fi, 1);
        if (_inst_name == 0) { _ce_check_fn(S, fi); }
    }
    # v6.3.10: def-start +1 (0 = unrecorded; token 0 is valid). 6.6.20: NOT over a redefinition's
    # (flag 2048) — pass 1 left the LAST definition's start, so an instance minted between the
    # definitions is minted from the one that wins, not from the body in hand.
    if (_gtp != 0) { if ((GFLG(S, fi) & 2048) == 0) { SFDS(S, fi, _defstart_ti + 1); } }
    if (_gtp != 0) { if (_inst_name == 0) { _bnd_fn_record(S, fi, _gtp, _gen_def_open(S, fi)); } }   # 6.7.1 (C3): once (pass 1 did)
    # v6.5.0 Phase 1 (public/private): stamp this fn's ORIGIN FILE, derived from the
    # line of its `fn` keyword via the file map the preprocessor already builds for
    # diagnostics (`#@file` markers -> FM_BUILD -> FM_FILEID). RECORDED ONLY — nothing
    # reads this for a decision yet, so program codegen is unchanged; Phase 2 is what
    # turns it into a visibility boundary.
    #
    # `_defstart_ti` is the `fn`-keyword token and is set unconditionally at the top of
    # PARSE_FN_DEF, so this is exact for every definition rather than approximated from
    # whatever token happens to be current. Deliberately placed HERE, after `fi` is
    # resolved: a forward reference registers a slot from a CALL SITE, and attributing
    # the fn to the caller's file would be precisely backwards.
    SFFI(S, fi, _vis_fid + 1);   # v6.5.38: _vis_fid is computed above, before the dup split
    # v6.5.0 Phase 2 — fn_flags bit 6 = PRIVATE. Set when this fn's own file opted in
    # AND no `public` moniker preceded it. Default (no `private` anywhere) leaves the
    # bit clear for every fn, so the whole feature is inert and byte-identical until a
    # file asks for it.
    #
    # `_pub_pending` is cleared UNCONDITIONALLY, exactly like `_must_use_pending` and
    # friends below. ⚠ That clear alone did NOT stop a stale marker from re-exposing an
    # unrelated fn: a `public` on a struct / union / enum / impl / `use` was armed and
    # never reached a definition until the NEXT fn or var — the hisab 2026-09-13 leak.
    # Since v6.6.4 _TL_VIS arms the marker only for tokens that can carry it (see
    # _PUB_CAN_ARM), PARSE_IMPL and the relaxed-ordering path clear it on entry, and the
    # array + destructure var paths consume it themselves.
    # 6.6.5 r3: a deferred reference can only become REPORTABLE when a new PRIVATE stamp
    # lands (`_vis_report_late` reports nothing for a public callee), so the sweep's seq
    # guard keys on this branch and not on SFFI. A compiland with no `private` anywhere —
    # which is nearly all of them — then sweeps exactly ONCE instead of once per fn body.
    if (_this_priv == 1) { SFLG(S, fi, GFLG(S, fi) | 64); _vis_stamp_seq = _vis_stamp_seq + 1; }
    # ⛔ 6.6.5 — and CLEAR it otherwise. The bit was only ever set, never cleared, so a
    # stale pass-1 private stamp survived onto a PUBLIC definition. That is not
    # hypothetical: with pass 1 keeping one entry per NAME, a private `_helper` in file A
    # stamped the shared entry, and file B's public `_helper` inherited the bit — the
    # guide's own two-file example was REFUSED, with no forward call involved, purely on
    # include order, and the "omitted from the exported symbol table" promise applied to
    # the wrong fn. CHANGELOG [6.6.5]
    else { SFLG(S, fi, GFLG(S, fi) & (0 - 65)); }
    # An unattributable fn (FM_FILEID -1) can never be marked private, so enforcement
    # would quietly stop applying. Say so once rather than degrade in silence.
    if (_vis_fid < 0) { _vis_degraded_note(); }
    _pub_pending = 0;
    if (_fileid_dump_arm() != 0) { _fileid_dump_note(S, fi, noff); }
    # v5.11.62: track the current fn for per-fn array-byte attribution.
    # Initialize the slot to 0 — fn body may have been touched by an earlier
    # forward-decl scan; this is the start of the body parse proper.
    _cur_fn_ix = fi;
    SFVB(S, fi, 0);
    # v5.5.36 Phase 2b — clear fn's struct-return slot. The `: StructName`
    # annotation after `)` sets it later if present; otherwise this fn
    # returns a scalar value in rax as usual.
    SFRS(S, fi, 0);
    _bx_fn_reset(S, fi);   # 6.7.3: bit 4096 / the multi-return bits / the bool parameter row
    # v5.5.36 Phase 3 — clear fn's variadic flag. Set to 1 in the
    # param loop below if the user writes `fn f(a, ...)`.
    SFVA(S, fi, 0);
    # v4.8.4-alpha4: transfer any pending `#regalloc` directive onto
    # this fn's metadata slot. Cleared whether consumed or not so a
    # stale flag from a prior parse error can't leak to the next fn.
    # v4.9.1: store 5 (max register count: rbx, r12-r15) for #regalloc fns.
    # v5.6.22 O4c (partial): infrastructure for auto-enable shipped
    # but DISABLED by default. CYRIUS_REGALLOC_AUTO_CAP=N opts in:
    #   -1 = disabled (default; back to explicit #regalloc opt-in only)
    #    N = first N fns get auto-enabled (bisection knob)
    # v5.6.22 attempt at default-on auto-enable surfaced a global-array
    # alignment regression (v5.5.21 fix interacts with auto-enable's
    # code-size growth in some shape that v5.5.21's per-array pad
    # misses; reproduces with `var rk[240]` + SSE m128 ops in
    # the inline-asm-discard regression — then
    # `tests/regression-inline-asm-discard.sh`, now the check driver's
    # `_inline_asm_discard_gate` over tests/fixtures/inline_asm_discard/).
    # Investigation pinned
    # to v5.6.23 with proper alignment-debug budget. The picker
    # correctness fix (loop-back time-share — extend last_cp = ra_end)
    # is shipped here for opt-in #regalloc fns.
    #
    # x86-ONLY when enabled: the `_cur_fn_regalloc >= N` save/restore
    # emits below are RAW x86 bytes (`mov [rbp-8], rbx` etc.).
    #
    # v5.6.23: scan body for inline asm (token 48). Inline asm blocks
    # hardcode stack offsets like `mov rax, [rbp-0x08]` to read params
    # and locals. The regalloc prologue reserves [rbp-8]..[rbp-40] for
    # callee-saved register saves (rbx, r12-r15), shifting every
    # subsequent local-var slot by N*8 bytes. Asm reading the old
    # offsets gets the saved RBX value instead of its expected param —
    # SIGSEGV when the asm dereferences it. lib/fnptr.cyr,
    # lib/thread.cyr, lib/atomic.cyr, lib/hashmap_fast.cyr, lib/u128.cyr,
    # lib/thread_local.cyr, lib/fdlopen.cyr, lib/args_macos.cyr all
    # carry asm blocks that depend on the standard prologue layout.
    # Skip regalloc when body contains asm. Misframed at v5.6.22 ship as
    # an "alignment regression" — the actual bug is layout mismatch.
    var _has_inline_asm = 0;
    var _ia_save_ti = GTI(S);
    if (PEEKT(S) == 10) {
        STI(S, GTI(S) + 1);
        var _ia_pd = 1;
        while (_ia_pd > 0 && PEEKT(S) != 12) {
            if (PEEKT(S) == 10) { _ia_pd = _ia_pd + 1; }
            elif (PEEKT(S) == 11) { _ia_pd = _ia_pd - 1; }
            STI(S, GTI(S) + 1);
        }
    }
    if (PEEKT(S) == 49) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 2) { STI(S, GTI(S) + 1); }
    }
    if (PEEKT(S) == 13) {
        STI(S, GTI(S) + 1);
        var _ia_bd = 1;
        while (_ia_bd > 0 && PEEKT(S) != 12) {
            if (PEEKT(S) == 13) { _ia_bd = _ia_bd + 1; }
            elif (PEEKT(S) == 14) { _ia_bd = _ia_bd - 1; }
            elif (PEEKT(S) == 48) { _has_inline_asm = 1; }
            STI(S, GTI(S) + 1);
        }
    }
    STI(S, _ia_save_ti);

    # v5.6.24 default-on: _ra_auto_cap semantics:
    #   < 0  → uncapped (every eligible fn) — DEFAULT
    #   == 0 → disabled (explicit #regalloc opt-in only)
    #   > N  → first N eligible fns (bisection knob)
    # "Eligible" = x86 backend + no inline asm in body.
    # v5.6.23 fixed misdiagnosed asm/regalloc layout collision.
    # v5.6.24 fixed the picker bug surfaced by the default-on attempt:
    # SysV ECALLPOPS used r12-r14 as scratch for 8+ arg calls; under
    # regalloc the picker pinned caller's locals to those callee-saved
    # regs, so calls silently corrupted the locals. Rewrote ECALLPOPS
    # to use only r10 + direct [rsp+offset] addressing.
    var _auto_enable = 0;
    if (_AARCH64_BACKEND == 0) {
        if (_has_inline_asm == 0) {
            if (_ra_auto_cap < 0) { _auto_enable = 1; }
            elif (_ra_auto_cap > 0) {
                if (_ra_auto_count < _ra_auto_cap) { _auto_enable = 1; }
            }
        }
    }
    # v6.1.30: x86-macho reserves r15 for the parked argv base (the entry emits
    # `mov r15, rsp`), so cap regalloc at 4 callee-saved regs (rbx/r12/r13/r14)
    # on that target — never assign a 5th hot local to r15. ELF / arm64 / PE keep
    # 5. Gated on _TARGET_MACHO==1 (x86 Mach-O only; arm64 Mach-O is ==2).
    # v6.1.32: agnos parks the init rsp in r15 the same way (same SysV init
    # stack), so it reserves r15 too — cap it at 4 as well.
    var _ra_cap = 5;
    if (_TARGET_MACHO == 1) { _ra_cap = 4; }
    if (_TARGET_AGNOS == 1) { _ra_cap = 4; }
    # 6.6.5: a UEFI image parks the firmware entry rsp in r13 at the landing (see the
    # `lea r13, [rsp]` in src/main.cyr) because EEXIT returns to firmware with
    # `mov rsp, r13; ret` from ANY depth. The save list is rbx(0), r12(1), r13(2), r14(3),
    # r15(4), so capping at 2 is what reserves r13 — pick it for a hot local and an
    # `syscall(60, …)` anywhere under that fn jumps to a local's value. It also finally
    # reserves r14/r15, which have carried ImageHandle/SystemTable since v5.11.52 while
    # being assignable. EFI images are small; two callee-saved regs is not a real cost.
    # CHANGELOG [6.6.5]
    if (_TARGET_EFI_APPLICATION == 1) { _ra_cap = 2; }
    if (_regalloc_pending == 1) {
        # CO-03 (v6.1.34): #regalloc is x86-only (the post-body byte-peephole
        # picker). The AUTO path gates on `_AARCH64_BACKEND == 0` above; the
        # explicit-`#regalloc` path did NOT — add the gate so an annotated fn on
        # aarch64 doesn't reach the x86 picker (`_cur_fn_regalloc` stays 0 → the
        # picker self-skips).
        if (_has_inline_asm == 0) { if (_AARCH64_BACKEND == 0) { SFRA(S, fi, _ra_cap); } }
        else {
            syscall(SYS_WRITE, 2, "warning:", 8);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": '", 3);
            PRSTR(S + 0xEC00000 + noff);
            syscall(SYS_WRITE, 2, "': #regalloc skipped — fn contains inline asm (hardcoded stack offsets)\n", 74);
        }
        _regalloc_pending = 0;
    }
    elif (_auto_enable == 1) { SFRA(S, fi, _ra_cap); _ra_auto_count = _ra_auto_count + 1; }
    # v5.6.3: transfer any pending `#must_use` onto fn_flags[fi] bit 0.
    # Clear unconditionally (same stale-flag argument as #regalloc).
    if (_must_use_pending == 1) {
        var _prev = GFLG(S, fi);
        SFLG(S, fi, _prev | 1);
        _must_use_pending = 0;
    }
    # v5.6.4: transfer any pending `#deprecated("msg")` onto fn_flags
    # bit 2 + fn_deprecated_msg[fi]. Same stale-flag discipline.
    if (_deprecated_pending == 1) {
        var _prev_d = GFLG(S, fi);
        SFLG(S, fi, _prev_d | 4);
        SFDM(S, fi, _deprecated_msg_pending);
        _deprecated_pending = 0;
        _deprecated_msg_pending = 0;
    }
    # v5.8.20: transfer pending #pure / #io / #alloc onto fn_flags bits
    # 3 / 4 / 5. Same stale-flag discipline. _cur_fn_is_pure mirrors
    # bit 3 so PARSE_FNCALL can check it without re-loading fn_flags
    # for every call site (set here, reset at fn end below).
    if (_pure_pending == 1) {
        var _prev_p = GFLG(S, fi);
        SFLG(S, fi, _prev_p | 8);
        _pure_pending = 0;
    }
    if (_io_pending == 1) {
        var _prev_i = GFLG(S, fi);
        SFLG(S, fi, _prev_i | 16);
        _io_pending = 0;
    }
    if (_alloc_pending == 1) {
        var _prev_a = GFLG(S, fi);
        SFLG(S, fi, _prev_a | 32);
        _alloc_pending = 0;
    }
    # v6.2.27: #naked — record for this fn so the prologue/epilogue/frame emit
    # below is skipped (the body is the raw ISR). Reset at PARSE_FN_DEF end.
    if (_naked_pending == 1) {
        _cur_fn_naked = 1;
        _naked_pending = 0;
    }
    else { _cur_fn_naked = 0; }
    # v6.5.63: #inline — consume the pending flag into a LOCAL, not a global. A definition
    # emitted mid-body (a generic instance) re-enters this fn, and a global would let the inner
    # fn inherit or clear the outer one's request (the shape `_cur_fn_naked` needs an explicit
    # save/restore for).
    var _fn_inline_req = 0;
    if (_inline_pending == 1) {
        _fn_inline_req = 1;
        _inline_pending = 0;
    }
    # v6.5.71: `#derive(accessors)` asks for its generated getters/setters to be inlined
    # through a side channel rather than by emitting `#inline` — derive bodies are flattened
    # onto one line and `#` opens a comment, so the text route swallows the next `#derive`.
    if (_fn_inline_req == 0) {
        if (_pp_inl_has(S + 0xEC00000 + noff) == 1) { _fn_inline_req = 1; }
    }
    _cur_fn_is_pure = (GFLG(S, fi) >> 3) & 1;
    # v4.8.4-alpha5: mirror fn_regalloc[fi] into _cur_fn_regalloc so
    # codegen (EFNEPI, ETAILJMP) can emit rbx save/restore. Reset at
    # the end of PARSE_FN_DEF.
    _cur_fn_regalloc = GFRA(S, fi);
    _ra_used_n = 0;            # v6.3.29 frame-trim: max callee-saved reg the picker assigns, +1
    _cur_fn_has_closure = 0;   # v6.3.7 — set by PARSE_FACTOR when this fn emits a closure
    # v5.5.36 Phase 2b — look ahead past the param list to see whether
    # the fn signature carries a `: StructName` return annotation. We
    # need the answer BEFORE param parse begins so local-disp shifts
    # account for the retptr stash slot (reserved immediately after
    # regalloc saves, before any regular local). Cheap one-pass scan
    # that pops TI back to its original position; parenthesis depth
    # tracking handles nested parens in default-value expressions
    # (future-proof; current cyrius fn params are name-only or
    # `name: Type`).
    _cur_fn_ret_stash = 0;
    _cur_fn_ret_scalar = 0;
    _cur_fn_ret_pair = 0;
    _cur_fn_pslots = 0;   # 6.6.6 — recorded at the end of the parameter loop
    _cur_fn_ptrp = 0;     # 6.6.10 — `p: *T` parameters, set in the parameter loop
    _cur_iself_sid = 0;   # 6.7.0 (A4) — an impl method's untyped `self`, set in the parameter loop
    var _rs_save_ti = GTI(S);
    if (PEEKT(S) == 10) {
        STI(S, GTI(S) + 1);
        var _rs_depth = 1;
        while (_rs_depth > 0 && PEEKT(S) != 12) {
            var _rs_tk = PEEKT(S);
            if (_rs_tk == 10) { _rs_depth = _rs_depth + 1; }
            if (_rs_tk == 11) { _rs_depth = _rs_depth - 1; }
            STI(S, GTI(S) + 1);
        }
        # v5.10.2: special-case ≤16-byte struct returns (Str etc.).
        # Pre-v5.10.2 ANY `: ReturnType` annotation triggered the
        # retptr/X8 calling convention (caller-allocs retbuf, callee
        # writes via hidden first arg). That's right for big structs
        # but breaks ABI for Str (16 bytes — fits in rax + rdx
        # multi-return; existing stdlib fns return Str via the
        # rax+rdx convention without annotations). Peek the return
        # type's struct id + size: if STRUCTSZ <= 16, skip the
        # stash (return via rax/rdx); else set stash = 8 (existing
        # retptr behavior). Type tracking via `_cur_fn_ret_sid` is
        # set later in the parse (line ~1024); this rough-scan only
        # decides the stash question.
        if (PEEKT(S) == 49) {
            STI(S, GTI(S) + 1);
            if (PEEKT(S) == 2) {
                var _rs_rt_noff = PEEKV(S);
                var _rs_rt_sid = FINDSTRUCT(S, _rs_rt_noff);
                if (_rs_rt_sid > 0) { _rs_rt_sid = _gtype_sid(S, fi, _rs_rt_sid); }   # 6.6.10: `: Box<Pt>`
                else { _rs_rt_sid = _gtype_tp_ret(S, fi, _rs_rt_noff); }             # 6.6.10: `: T`, T = Pt
                if (_rs_rt_sid > 0) {
                    var _rs_rt_sz = STRUCTSZ(S, _rs_rt_sid - 1);
                    if (_rs_rt_sz > 16) {
                        _cur_fn_ret_stash = 8;
                    } else {
                        # v5.10.45 Phase 1: 9-16B int-class value-type
                        # struct → pair-return rax/rdx. Str (also 16B) is
                        # special-cased to keep its existing scalar-rax
                        # heap-handle semantics — `fn str_from(c): Str`
                        # returns `rax = heap_ptr`, not a value-typed
                        # struct copy. Pre-v5.10.45 ALL ≤16B structs
                        # fell through to scalar-rax; for non-Str 16B
                        # value structs (e.g. `struct Point {x: i64;
                        # y: i64;}`), this lost the high half. Filed
                        # at v5.10.44 ship (premise-check finding).
                        if (_rs_rt_sz > 8) {
                            if (_rs_rt_sid != _STR_SID(S)) {
                                _cur_fn_ret_pair = 1;
                            }
                        }
                    }
                } else {
                    # v5.10.5 — recognize i8/i16/i32/i64 scalar returns
                    # so the rough-scan doesn't default to retptr-stash
                    # for them. Mirrors the post-param-list scalar path
                    # that encodes negative values into fn_ret_sid.
                    # v5.10.23 — extended to recognize Result / Option /
                    # Tagged / cstring as i64-shape scalars (all return
                    # raw pointers — heap handle for Result/Option/Tagged,
                    # null-terminated byte ptr for cstring; rax-via-i64
                    # ABI not retptr-stash). Without this addition, fns
                    # annotated with the new types would silently get
                    # retptr/X8 calling convention and corrupt the
                    # is_ok/result_unwrap semantics in callers.
                    var _rs_b0 = load8(S + 0xEC00000 + _rs_rt_noff);
                    var _rs_b1 = load8(S + 0xEC00000 + _rs_rt_noff + 1);
