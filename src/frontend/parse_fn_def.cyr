                    if (_rs_b0 == 105) {
                        if (_rs_b1 == 56) {
                            if (_rs_b2 == 0) { _rs_is_scalar = 1; }
                        }
                        if (_rs_b1 == 49) {
                            if (_rs_b2 == 54) {
                                if (_rs_b3 == 0) { _rs_is_scalar = 1; }
                            }
                        }
                        if (_rs_b1 == 51) {
                            if (_rs_b2 == 50) {
                                if (_rs_b3 == 0) { _rs_is_scalar = 1; }
                            }
                        }
