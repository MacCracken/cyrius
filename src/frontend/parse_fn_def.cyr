                        if (_rs_b1 == 112) {
                            if (_rs_b2 == 116) {
                                if (_rs_b3 == 105) {
                                    if (load8(S + 0xEC00000 + _rs_rt_noff + 4) == 111) {
                                        if (load8(S + 0xEC00000 + _rs_rt_noff + 5) == 110) {
