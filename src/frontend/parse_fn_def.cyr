                    elif (_ptc == 5) { tagged_mask = _pmw(tagged_mask, pc, 32); }
                    elif (_ptc == 6) { pt_simd_class = 1; pt_simd_sid = 2093; }  # f64v2 (v6.4.14: was 20, collided w/ struct-id 20)
                    elif (_ptc == 7) { pt_simd_class = 2; pt_simd_sid = 2125; }  # f64v4 (v6.4.14: was 21)
                    elif (_ptc == 8) { pt_simd_class = 1; pt_simd_sid = 2121; }  # f32v4
                    elif (_ptc == 10) { pt_simd_class = 2; pt_simd_sid = 2153; }  # 6.7.13: f32v8 (f64v4's 32-byte ABI)
                    elif (_ptc <= 0 - 2048) { pt_simd_class = 1; pt_simd_sid = 0 - _ptc; }  # v6.4.7: integer 128-bit vector (16-byte/1-XMM, SLTYPE = sentinel)
                    # v6.3.36 (issue [5]) — plain struct >8 B param → address-passed.
                    if (_param_wants_struct_ptr(S, tnoff, _ptrp_now(S)) == 1) { struct_mask = _pmw(struct_mask, pc, 1); }
                    pt_sid = FINDSTRUCT(S, tnoff);
                    # 6.6.10: `r: Box<Pt>` is the instance, sized as one (see _gtype_sid).
                    if (pt_sid > 0) {
                        var _pgi = _gtype_sid_def(S, fi, pt_sid);   # 6.7.14 (D6): its `<..>` checked
                        struct_mask = _gtype_param_mask(S, struct_mask, pc, pt_sid, _pgi, _ptrp_now(S));
                        pt_sid = _pgi;
                    }
                    # v6.3.9 (F-fns): param `: T` under an active generic binding.
                    # A struct-bound tparam makes this a struct param (pt_sid);
                    # scalar-bound tparams correctly stay int params (register-width;
                    # narrowing is value-side via `var y: T`). Str-param ABI
                    # classification rides the struct-interaction work (v6.3.10).
                    # Inert when _tp_c0==0 → byte-identical default path.
                    if (_tp_c0 != 0) {
                        var _ptpc = _tp_resolve(S, tnoff);
                        if (_ptpc == 0 - 9) { pt_float = F64_TYID; }   # 6.6.17 (a9): `x: T`, T = f64, is an f64 param
                        if (_ptpc > 0) {
                            pt_sid = _ptpc;
                            # v6.3.39 (B3) — a tparam-typed param resolved (via the instance
                            # binding) to a struct >8 B must be ADDRESS-passed, exactly like a
                            # plain struct >8 B param. The name-based _param_wants_struct_ptr
                            # above sees only "T" (not a struct) so it can't set the bit; set
                            # it here from the resolved sid. <=8 B resolved structs stay
                            # value-passed (bit clear), matching the non-generic ABI.
                            if (_tp_param_addr(S, _ptpc) == 1) { struct_mask = _pmw(struct_mask, pc, 1); }   # 6.6.20: + `p: *T`
                        }
                    }
                    _tn_param_check(S, pnoff, fi, _ptc);   # 6.6.16 (C8): an unknown name is refused by name
                }
                # v6.4.31: Win64 PE value-form SIMD params are now supported via
                # the MS x64 by-pointer ABI (address-passed like a plain struct
                # >8B). The former hard-error here is gone — the SIMD param branch
                # below routes PE through struct_mask + a copy-in store rather than
                # the SysV XMM path. See [[project_v6431_win64_valueform_simd]].
                _param_type_step(S);   # consume type (6.7.8, C2-6a: a slice `[T]` refused, consumed whole)
                _ngt_refuse(S, GTI(S) - 1);   # 6.7.15 (D6): `p: Pt<..>` / `p: i64<..>` refused at the name
                SKIP_GENERICS(S);    # skip <T> if present
            }
            # v5.10.38 — branch: SIMD param (f64v2/f64v4) needs
            # multi-slot alloc + register-pair store; int-class param
            # is the legacy single-slot path. Shared loop-bottom
            # (pc++ + comma-consume) at the end.
            if (pt_simd_class > 0) {
                if (_is_async == 1) { _refuse_async_simd_param(S, pnoff); }   # 6.6.6
                _dsg_vec_note(S, fi, pc, pt_simd_sid);   # 6.6.20: a redefinition's vector types
                var simd_slots = 2;     # f64v2 / f32v4 (128-bit)
                var simd_sid = pt_simd_sid;   # 2093 f64v2 / 2125 f64v4 / 2121 f32v4
                if (pt_simd_class == 2) {
                    simd_slots = 4;     # f64v4
                }
                # Allocate (simd_slots - 1) anon filler slots + 1
                # named slot (deepest = lo half, where &v points).
                # Mirror of the v5.10.28 var-decl multi-slot pattern.
                var simd_j = 0;
                while (simd_j < simd_slots - 1) {
                    var simd_fi = GFLC(S);
                    S64(S + 0x5D9D000 + simd_fi * 8, 0 - 1);  # anon
                    SLDEP(S, simd_fi, 0);
                    SLTYPE(S, simd_fi, 0);
                    SFLC(S, simd_fi + 1);
                    simd_j = simd_j + 1;
                }
                # Named slot (deepest disp; where &v resolves).
                var simd_named = GFLC(S);
                S64(S + 0x5D9D000 + simd_named * 8, pnoff);
                SLDEP(S, simd_named, 0);
                SLAGG(S, simd_named, simd_slots);   # 6.6.5: a value-form vector param is inline on every ABI
                SLTYPE(S, simd_named, 0 - simd_sid);
                SFLC(S, simd_named + 1);
                # The multi-slot frame (above) is target-independent — &v +
                # lane access resolve identically on SysV and Win64. Only the
                # ABI of how the value ARRIVES differs, branched here.
                if (_TARGET_PE == 0) {
                    # SysV / aarch64: value arrives in XMM/V register(s).
                    # Encode in per-fn simd_mask: 2 bits per param at offset
                    # pc*2. PARSE_FNCALL reads this to route value-form args
                    # into XMM/V regs at call sites. v6.4.4: the mask
                    # distinguishes f32v4 (code 3) from f64v2 (code 1) for
                    # caller type-checking; pt_simd_class stays 1 (XMM count /
                    # 16-byte ABI) so all size logic is unchanged.
                    var pt_mask_code = pt_simd_class;
                    if (simd_sid == 2121) { pt_mask_code = 3; }
                    simd_mask = _pmw2(simd_mask, pc, pt_mask_code);
                    # Bound check: SysV SIMD arg-regs are XMM0..XMM7
                    # (8 regs); f64v2 uses 1, f64v4 uses 2.
                    if (simd_pc + pt_simd_class > 8) {
                        ERR_MSG(S, "too many f64v2/f64v4 params (SIMD arg-reg budget XMM0..XMM7 exceeded)", 69);
                    }
                    # Emit register-pair store at fn entry. ESTOREPARM_F64V2
                    # / F64V4 takes the SIMD ordinal + named slot's local idx.
                    if (pt_simd_class == 1) {
                        ESTOREPARM_F64V2(S, simd_pc, simd_named);
                        simd_pc = simd_pc + 1;
                    } else {
                        ESTOREPARM_F64V4(S, simd_pc, simd_named);
                        simd_pc = simd_pc + 2;
                    }
                } else {
                    # v6.4.31 Win64 PE: MS x64 passes __m128 / any >8B vector BY
                    # POINTER in a positional int arg reg (rcx/rdx/r8/r9, then
                    # stack). Set struct_mask (drives the caller's &local push)
                    # and copy the pointed-to bytes into the same multi-slot
                    # frame the SysV path uses, so downstream &v/lanes match.
                    # The vector consumes ONE integer arg reg (int_pc), NOT XMM —
                    # positional with any int params, +1 for a retptr-return fn.
                    struct_mask = _pmw(struct_mask, pc, 1);
                    var _pe_shift = 0;
                    if (_cur_fn_ret_stash > 0) { _pe_shift = 1; }
                    var _pe_bytes = 16;
                    if (pt_simd_class == 2) { _pe_bytes = 32; }
                    if (_cur_fn_naked == 0) {
                        ESTOREPARM_SIMD_WIN64(S, int_pc + _pe_shift, simd_named, _pe_bytes);
                    }
                    int_pc = int_pc + 1;
                }
            } else {
                # Int-class param — legacy single-slot path.
                var li = GFLC(S);
                S64(S + 0x5D9D000 + li * 8, pnoff);
                SLDEP(S, li, 0);
                # v5.10.1: explicit SLTYPE clear for untyped params. The
                # LTYPE table at S+0x192200 isn't cleared per-fn (only
                # FLC resets), so a fresh param slot can inherit a stale
                # `0 - sid` value from a prior fn's local in the same
                # slot index. Surfaced when v5.10.1 added the call-site
                # type-check: untyped `alloc` param of `str_cat_a` was
                # falsely flagged Str-typed because the previous fn
                # (using slot 0 for a Str-annotated local) left SLTYPE
                # = -STR_SID. Belt-and-braces: zero first, then set to
                # `-pt_sid` only if explicitly annotated.
                SLTYPE(S, li, 0);
                if (pt_sid > 0) { SLTYPE(S, li, 0 - pt_sid); }
                _psid_def_note(S, fi, pc, pt_sid, struct_mask);   # 6.6.12: see SFPSID (util.cyr); 6.7.3
                # v6.4.57 (Gap A) — a scalar f64/f32 param gets the same positive
                # F64_TYID/F32_TYID tag a `var y: f64` local gets, so parse_expr's
                # local-load (lt == F64_TYID/F32_TYID) routes ops to the float
                # emitters. pt_float is 0 for every non-float param (incl. all of
                # cycc's) → self-host stays byte-identical.
                _ipt_pack = _param_float(S, li, pc, pt_float, _ipt_pack);   # 6.6.17 (a9)
                # 6.6.5 — RECORD THE PARAM ABI INSTEAD OF RE-DERIVING IT AT EVERY USE. A struct
                # param over 8 B is ADDRESS-passed (`_param_wants_struct_ptr` sets structmask
                # and the caller pushes `&local`), so its slot holds a pointer; one that fits in
                # 8 B arrives BY VALUE, so the slot IS the struct. That second half used to be a
                # `_TARGET_CX == 0` guess at the use site, which is why cx deref'd its own slot.
                # 6.6.16 (C7): `_param_record` also marks a `*T` on its slot and refuses a struct
                # by value on an `async fn`. Over 8 B such a parameter is COPIED in the prologue
                # (`_sptr_params_localize`, after `_stkp_flush` below).
                _param_record(S, li, pnoff, _is_async);
                _bx_param(S, fi, pc, li, pt_bool);   # 6.7.3: last — after _param_record's bit 56
                # Only emit register params now (0-5). v5.5.36 Phase 2b:
                # x86 struct-returning fns reserve arg-reg 0 (RDI on SysV,
                # RCX on Win64) for the hidden retptr, so user param 0
                # arrives in the SECOND arg reg — shift pidx +1. v5.9.26:
                # aarch64 SysV puts the retptr in X8 (dedicated, outside
                # the regular X0..X7 arg-reg sequence), so user params on
                # aarch64 stay at X0..X7 unshifted regardless of
                # struct-return status.
                #
                # v5.10.38: use `int_pc` (int-class-only counter) not
                # `pc` (any-class). For fns with no SIMD params,
                # int_pc == pc and behavior is identical. For mixed
                # fns, SIMD params skip the int-class arg-reg sequence
                # per SysV's independent-counter convention.
                var _pp_shift = 0;
                if (_cur_fn_ret_stash > 0) {
                    if (_AARCH64_BACKEND == 0) { _pp_shift = 1; }
                }
                # v6.2.x: a #naked fn takes args in registers only — there is no
                # rbp frame to home them into (the asm body reads x0../rdi.. directly).
                # v6.5.70: a COROUTINE's impl is re-entered as `fncall1(fp, SELF)`, so its
                # declared parameters do NOT arrive in registers — the constructor has already
                # placed them in the coroutine frame. Homing a register here would overwrite
                # them with whatever the ABI happened to leave in that register on a resume.
                if (_cur_fn_naked == 0 && _pending_coro == 0) {
                    if (int_pc + _pp_shift < 6) {
                        ESTOREPARM(S, int_pc + _pp_shift, li, pc);
                    } else {
                        _stkp_defer(int_pc + _pp_shift, li);   # 6.6.6: homed by _stkp_flush
                    }
                }
                SFLC(S, li + 1);
                int_pc = int_pc + 1;
            }
            # v6.5.52: record this param's vector descriptor (desc = sid - 2048, +1 so 0
            # means "not a vector"). pt_simd_sid is only live inside this loop iteration.
            if (pt_simd_sid != 0) {
                if (pc == 0) { _ipt_pack = _ipt_pack | ((pt_simd_sid - 2048) + 1); }
                if (pc == 1) { _ipt_pack = _ipt_pack | ((((pt_simd_sid - 2048) + 1)) << 16); }
            }
            if (PEEKT(S) == 4) { STI(S, _pl_dflt_end(S, GTI(S))); }   # 6.7.7 (B6): a default (pass 1 checked it)
            pc = pc + 1;
            if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
            else { pgo = 0; }
        }
    }
    if (PEEKT(S) != 11) { ERR_EXPECT(S, 11); }
    STI(S, GTI(S) + 1);
    # v6.5.62 — THE PICKER EXCLUDED PARAMS BY PARAM *COUNT* WHILE THE SLOT MAP IS BY *SLOT*.
    #
    # A by-value vector param occupies `nslots` frame slots — (nslots-1) anonymous fillers and
    # then its NAMED slot — so in `fn f(v: f64v4, s)` the scalar `s` lives at slot 4 while `pc`
    # is 2. The register-allocator picker skipped params with `iv_li = pc`, so it treated `s` as
    # an ordinary local, made it a candidate and promoted it to a callee-saved register — while
    # the prologue's homing store still wrote the incoming value to the frame slot. The callee
    # then read the register, not the argument.
    #
    # Live and silent from ordinary user code: a non-inlined `fn my_scale(v: f64v4, s)` read
    # `s` as 0. It did NOT show up for `f64v2` (2 slots) or with the scalar param first, and a
    # FLAT wrapper dodged it by inlining — which is why `lib/simd.cyr`'s own `f64v4_scale` only
    # exposed it while it still carried a dispatch. `CYRIUS_REGALLOC_PICKER_CAP=0` makes the
    # same source correct, which is what identifies the picker as the owner.
    #
    # Capture the real boundary here, where the parameter list has just closed and GFLC counts
    # exactly the param slots. For a fn with no wide params this equals `pc`, so nothing moves.
    var ra_pslots = GFLC(S);
    S64(_fnt_params + fi * 8, pc);
    _pd_pc_check(S, fi, pc);   # 6.7.7: one parameter count for a defaulted fn
    # ⛔ v6.5.37 — A DUPLICATE THAT DISAGREES ABOUT ARITY IS AN ERROR, NOT A WARNING.
    #
    # `duplicate fn ... last definition wins` is easy to read as benign shadowing, and
    # usually is. It is not benign when the two definitions disagree about ARITY, because
    # the duplicate path routes AROUND the call-site arity check that has been a hard error
    # since v6.5.1: measured at 6.5.36, a 3-arg call bound to a 1-arg duplicate compiled and
    # ran, silently dropping arguments 2 and 3 (exit 201 where 106 was intended), while the
    # identical mismatch with no duplicate present is refused outright. This is the one way
    # to defeat that check.
    #
    # Filed from owl 1.4.7 (2026-08-22), where `vyakarana` and `sankoch` each define a
    # private-by-convention `_stream_grow` and disagree about arity, buffer offsets AND
    # return-value polarity — a wrong binding there reports every successful buffer grow as
    # a failure, inside a tokenizer, on file content. `private` does NOT prevent this: it is
    # enforced on REFERENCE but not on DEFINITION, so both files' internal calls are rebound.
    #
    # ⚠ THIS IS THE CHEAP HALF, AND IT IS NOT THE FULL FIX. Same-arity replacement (owl's
    # §1 and §2) still happens: a private helper can still be silently replaced by another
    # file's same-named, same-arity function. The real fix is to scope private symbols at
    # INSERTION — a per-file table or file-unique mangling — which makes the guide's
    # "omitted from the exported symbol table" claim literally true. That stays open.
    #
    # Blast radius measured before landing: building cycc itself and the cyrius CLI produce
    # ZERO duplicate-fn warnings; the whole 284-file corpus produces 5, of which the only
    # arity-differing pair was two tests defining a local `fn run()` over lib/process.cyr's
    # `run(cmd, arg1, arg2)` — renamed in the same change, because a generic name shadowing
    # a stdlib fn at a different arity is precisely the hazard this now refuses.
    if (_dup_prev_pc >= 0) {
        if (_dup_prev_pc != pc) {
            syscall(SYS_WRITE, 2, "error:", 6);
            _err_head_at(S, _defstart_ti);
            syscall(SYS_WRITE, 2, ": duplicate fn '", 16);
            PRSTR(S + 0xEC00000 + noff);
            syscall(SYS_WRITE, 2, "' disagrees about arity: this one takes ", 40);
            PRNUM(pc);
            syscall(SYS_WRITE, 2, ", the one in ", 13);
            _fm_print_fid(S, _dup_prev_fid);
            syscall(SYS_WRITE, 2, " takes ", 7);
            PRNUM(_dup_prev_pc);
            syscall(SYS_WRITE, 2, " (last definition wins, so calls to the other arity would silently mis-bind)\n", 77);
            _had_error = 1;
        }
        _dup_prev_pc = 0 - 1;
    }
    if (_b3_pl_bound == 1) { _tp_clear(S); }   # v6.3.39 (B3): end the param-loop binding
    # v6.2.x: a #naked fn may take up to 6 register-passed params (the arg-home
    # stores are gated above, so they stay in x0../rdi.. for the asm body — e.g.
    # dl_setjmp(buf) / dl_longjmp(buf,val)). 7+ params spill to the stack, which a
    # frameless fn can't reach, so reject those.
    if (_cur_fn_naked == 1) {
        if (pc > 6) {
            ERR_MSG(S, "a #naked fn can have at most 6 register-passed parameters", 57);
        }
    }
    # Store Str param mask — bit N set = param N is : Str
    S64(_fnt_strmask + fi * 8, str_mask);
    # v5.10.24 — Phase 2 param-type masks. Same per-fn shape as
    # str_mask; PARSE_FNCALL reads them for call-site type checks.
    S64(_fnt_cstrmask + fi * 8, cstring_mask);
    S64(_fnt_resmask + fi * 8, result_mask);
    S64(_fnt_optmask + fi * 8, option_mask);
    S64(_fnt_tagmask + fi * 8, tagged_mask);
    # v5.10.38 — typed-simd Phase 10. Per-fn SIMD-param mask: 2 bits
    # per param at offset pc*2. Default 0 means no SIMD params (legacy
    # behavior); non-zero triggers caller-side XMM-routing in
    # PARSE_FNCALL.
    S64(_fnt_simdmask + fi * 8, simd_mask);
    # v6.3.36 (issue [5]) — plain struct >8 B param mask (bit N = address-passed).
    S64(_fnt_structmask + fi * 8, struct_mask);
    # v5.5.36 Phase 2b — optional `: StructName` return-type annotation:
    # `fn make(): Point { ... return p; }`. Sets fn_ret_sid[fi] = sid;
    # PARSE_RETURN + call-site consult it to emit the Win64 hidden-RCX /
    # SysV-RDI retptr convention (see main.cyr heap map 0x15A000).
    if (PEEKT(S) == 49) {
        STI(S, GTI(S) + 1);                         # consume ':'
        # v6.5.21 — multi-value return `: (T1, T2[, T3])`. Handled before the
        # single-type path because that path requires an IDENT and would report
        # `expected identifier, got '('`.
        if (PEEKT(S) == 10) {
            _parse_multiret_sig(S, fi, 0);
            _cur_fn_ret_scalar = MULTIRET_SID;
        } elif (_ret_ann_alt(S, fi) == 0) {   # `: *T` (6.6.17) and a slice (6.7.8, refused) are taken there
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var rt_noff = PEEKV(S);
            # v6.3.5 CO-01 — classify the return type via the shared
            # _classify_return_type so the pass-1 _prescan_fn_sig records the
            # identical struct-return / scalar ABI. Positive = struct sid;
            # negative = scalar/extended encoding; 0 = unrecognized.
            var _rtc = _classify_return_type(S, rt_noff);
            if (_rtc == 0) {
                # v6.3.9 (F-fns): `: T` where T is a captured type-param is a valid
                # GENERIC return. The base signature treats it as an i64-scalar return
                # (-8); the concrete return is per-instantiation (the inline-replay body
                # leaves the value in rax). Struct-typed generic returns (retptr ABI)
                # ride the struct-interaction work (v6.3.10). Non-tparam unknowns error.
                if (_is_tparam_of(S, fi, rt_noff) == 1) {
                    _rtc = _gtype_tp_ret(S, fi, rt_noff);   # 6.6.10: an instance's `: T`, T = Pt
                    if (_rtc == 0) { _rtc = 0 - 8; }
                }
                # v6.5.19: `: T` where T is a struct declared in a SIBLING FILE is a
                # RESOLUTION failure, and under --syntax-only it must not become an error at
                # all. Measured on agnosai, which BUILDS GREEN yet had 3 of its files
                # condemned by `cyrius lint`: this ERR_MSG sets _panic, _sync_skip then
                # resyncs mid-declaration, and the desynced parse MANUFACTURES
                # `expected ';', got '='` — which IS in the syntax class, so lint refused a
                # module whose only sin was lacking its includes. Same shape as the struct
                # FIELD sites fixed earlier this release, at the return-type site they
                # missed; and the same cascade hazard `_syntax_only`'s comment documents.
                # Treating it as an i64 scalar return keeps the token stream in sync, which
                # is all the pre-pass needs. A real build is untouched — _syntax_only is 0.
                # 6.6.16 (C8): _tn_ret_refuse names the type, once, with no cascade (and skips
                # a `<..>` after it); under --syntax-only it refuses nothing and answers -8.
                else { _rtc = _bx_ret_or_refuse(S, fi, rt_noff); }   # 6.7.3: `: bool` is an i64, bit 4096
            }
            if (_rtc > 0) { _rtc = _gtype_sid_def(S, fi, _rtc); }   # 6.6.10: `: Box<Pt>`; 6.7.14 (D6): checked
            SFRS(S, fi, _rtc);
            if (_rtc > 0) {
                _cur_fn_ret_sid = _rtc;
                STI(S, GTI(S) + 1);
                _ngt_refuse(S, GTI(S) - 1);   # 6.7.15 (D6): `: Pt<..>` refused at the name
                SKIP_GENERICS(S);
            } else {
                _cur_fn_ret_scalar = _rtc;
                STI(S, GTI(S) + 1);
            }
        }
    }
    # 6.6.6 — the Future carries one i64, so neither a by-value struct return nor a value-form
    # vector return ever arrives. See `_refuse_async_struct_return` / `_refuse_async_vec_return`
    # (two fns, because the struct test reads `GFRS` as a sid and the vector test reads the same
    # word as a descriptor — one predicate cannot answer both). CHANGELOG [6.6.6]
    if (_is_async == 1) { _refuse_async_struct_return(S, _async_noff_f, fi); }
    if (_is_async == 1) { _refuse_async_vec_return(S, _async_noff_f, fi); }
    if (_is_async == 1) { _refuse_async_multi_return(S, _async_noff_f, fi); }   # 6.7.11
    # Record first param name offset for inlining (stored in fn_inline later)
    # Emit the stack param stores the loop deferred, now that the int-class TOTAL is known.
    # `_pl_shift` mirrors the in-loop `_pp_shift`: an x86 retptr (SysV rdi / Win64 rcx) is
    # int-class arg 0, so the caller pushed int_pc + 1 (v6.4.44); aarch64 passes it in X8.
    # ⛔ 6.6.6: the total is `int_pc + _pl_shift`, NOT `pc` — the count the caller pushed
    # (`_fc_int_argc`, `asv_argc`). `pc` also counts value-form vectors, which travel in XMM/V
    # on SysV/aarch64 and never reach the int arg stack, and it omits the retptr. (Win64's
    # stack formula ignores the total; there only the recorded ordinal and slot matter.)
    var _pl_shift = 0;
    if (_cur_fn_ret_stash > 0) {
        if (_AARCH64_BACKEND == 0) { _pl_shift = 1; }
    }
    # 6.6.6 — the parameter list owns slots 0..GFLC-1 and nothing else has been registered
    # yet, so THIS is the boundary `_local_is_sptr_param` tests. CHANGELOG [6.6.6]
    _cur_fn_pslots = GFLC(S);
    _stkp_flush(S, int_pc + _pl_shift);
    _sptr_params_localize(S);   # 6.6.16 (C7): a struct parameter over 8 B is copied in, here
    _dsg_check(S, fi, noff, _defstart_ti);   # 6.6.20: a redefinition must be called the same way
    # Parse body
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    # Emit jmp placeholder for defer flag init (backpatched after body)
    var defer_init_jmp = EJMP0(S);
    var body_cp = GCP(S);
    _cur_fn_has_defer = _body_has_defer(S);   # 6.6.7: its `return f(..)` never tail-calls
    # Record body start for inline replay (x86 only; v6.3.5 AR-01: also under the
    # opt-in CYRIUS_MONOMORPH gate so the replay substrate can be proven byte-correct
    # without re-enabling _INLINE_OK by default).
    # v6.4.0 DECOUPLE: under _MONOMORPH_OK capture ONLY generic fns (GFTP != 0). The shared
    # `|| _MONOMORPH_OK` gate also re-enabled GENERAL inlining of non-generic fns (the v1.11.3
    # x86 size regression that disabled _INLINE_OK; +25.6% on cycc). Gating to GFTP!=0 keeps
    # non-generic codegen byte-identical under the flag → the CYRIUS_MONOMORPH flip is byte-id.
    # v6.5.52 — admit SIMD-param fns (the value-form f32v4/f64v2/f64v4 wrappers) to the
    # inline-replay path so a SIMD chain stops crossing call boundaries.
    #
    # ⛔ v6.5.63 — THE "+25.6 % ON CYCC AT v1.11.3" JUSTIFICATION ABOVE IS STALE, AND THE LIVE
    # BLOCKER IS A HARD ERROR, NOT A SIZE COST. Re-taken on today's compiler by the two-step
    # (build a cycc with `_INLINE_OK = 1`, then have IT rebuild the same source):
    #
    #     error: function exceeds 1023 jump targets (x86 LASE cap) - split the function
    #
    # General inlining does not compile the compiler at all, so there is currently no size
    # figure to quote — the number carried in these comments for ~15 majors describes a build
    # that cannot be produced. Whoever revisits a global flip must lift or scope that cap first
    # (`EJMP` / `EJMP0`, src/backend/x86/jump.cyr; the 8 KB table at 0x19E000 is consumed by
    # LASE), and only then re-measure size. Do not re-quote +25.6 %.
    #
    # v6.5.63 — `#inline` (token 163) is the opt-in route, and it has neither problem: a
    # per-fn request inlines one small flat body at its call sites, so it cannot drive any
    # single function toward 1023 jump targets the way whole-program inlining does. Consumers
    # were already writing `#inline` (svara has four in `src/formant.cyr`) against a directive
    # that did not exist and lexed as a comment.
    if (_INLINE_OK == 1 || _fn_inline_req == 1 || (_MONOMORPH_OK == 1 && GFTP(S, fi) != 0) || _fn_has_simd_param(S, pc) == 1) { SFBS(S, fi, GTI(S)); }
    # v6.3.9 (F-fns): a generic fn's body references type-param `T`s that are unbound
    # at definition. In an i64-everywhere language the dominant instantiation is i64,
    # so the BASE fn IS the i64 monomorphization: bind every `T -> i64` for the base
    # body emission (the bite-4 consults then resolve `var y: T` / sizeof(T) / `: T`
    # to i64). i64-typed calls are plain normal calls to this base; non-i64 type-args
    # mint a separate instance on demand at their call sites (bites 6-7). Gated on
    # _MONOMORPH_OK && GFTP!=0 → non-generic / flag-off path is byte-identical.
    var _gen_base = 0;
    if (_MONOMORPH_OK == 1 && GFTP(S, fi) != 0) {
        # v6.3.10: a specialized instance binds T to its concrete type(s); the base
        # binds T->i64 (base-as-i64). _inst_conc0 is set only during an instance re-emit.
        if (_inst_conc0 != 0) { _bind_generic_call(S, fi, _inst_conc0, _inst_conc1); }
        else { _bind_generic_call(S, fi, 0 - 8, 0 - 8); }
        _gen_base = 1;
    }
    # v6.3.39 (B3): a generic fn that field-accesses a tparam-typed param
    # (`fn wrap<T>(p: T): i64 { return p.x + p.y; }`) has NO valid i64 base — `p.x` on an
    # i64-bound tparam is illegal. The base-as-i64 body can't be parsed, but it is also
    # never validly CALLED (there is no `wrap<i64>` — i64 has no fields). So for the base
    # emission ONLY, skip the body to a trivial `rax=0` dead stub. The SPECIALIZED
    # instances re-emit the real body with T bound to the concrete struct (p becomes a
    # by-value struct param → `p.x` resolves; the v6.3.36 structmask + v6.3.39 le8 fix
    # make that ABI sound — a plain `fn wrap_point(p: Point): i64` already works). Gated
    # under _MONOMORPH_OK (this whole _gen_base block) → default byte-identical.
    # 6.6.10: the decision is the recorded one (`_gen_stub`), which also covers a `var q: T` local
    # used as a struct and a base that FORWARDS T to a stub generic — the same answer every call
    # site now gets. CHANGELOG [6.6.10]
    var _b3_skip = 0;
    if (_gen_base == 1 && _inst_conc0 == 0) {
        if (_gen_stub(S, fi) != 0 || _bnd_base_bad(S, fi) == 1) { _b3_skip = 1; }   # 6.7.1: or not a valid i64 instance of its bounds
    }
    # v6.5.69 — COROUTINE SETUP. An `async fn` body becomes a state machine: its locals live
    # in the heap object the runtime hands back on every resume, and the fn top dispatches to
    # the suspend point it left from. Stack slot 0 holds the frame base (param 0 = SELF); every
    # local from slot 1 up is a coroutine-frame slot.
    # ⚠ x86 family only. The redirect and the dispatch are emitted through x86-specific paths,
    # and a coroutine compiled without them would read a frame destroyed at the last suspend.
    # A hard error is the contract; a quiet stack-frame body is the miscompile.
    if (_pending_coro == 1) {
        if (_AARCH64_BACKEND != 0) {
            ERR_MSG(S, "`async fn` mid-body suspend is x86-only so far (aarch64 has no coroutine frame yet)", 83);
        }
        if (_TARGET_CX != 0) {
            ERR_MSG(S, "`async fn` mid-body suspend is x86-only so far (the cx backend has no coroutine frame yet)", 90);
        }
        _cur_fn_coro = 1;
        _coro_base = 0;
        _coro_lo = 1;
        _coro_nsusp = 0;
        # The regalloc picker's post-emit byte peephole matches `[rbp+disp32]` moves; a coro
        # body's locals are `[r11+disp32]`, and its stack frame does not survive a suspend.
        # Reuse the existing "do not run the picker over this body" signal.
        _cur_fn_has_closure = 1;
        # Home the ONE incoming register argument — SELF, the coroutine frame — into the
        # reserved stack slot 0. Every `[r11+off]` local access loads its base from here.
        ESTOREPARM(S, 0, _coro_base, 1);
        _coro_top_jmp = EJMP0(S);   # jmp DISPATCH — patched at fn end
        _coro_entry_cp = GCP(S);    # state 0 lands here
    }
    if (_b3_skip == 1) {
        var _b3_bd = 1;
        while (_b3_bd > 0) {
            var _b3t = PEEKT(S);
            if (_b3t == 12) { break; }               # EOF guard
            # 6.6.16: a nested fn is refused here too (consumed whole), whether or not an
            # instance ever re-parses this body. See `_refuse_nested_fn` (parse.cyr).
            if (_refuse_nested_fn(S) == 0) {
                if (_b3t == 13) { _b3_bd = _b3_bd + 1; }
                elif (_b3t == 14) { _b3_bd = _b3_bd - 1; if (_b3_bd == 0) { break; } }
                STI(S, GTI(S) + 1);
            }
        }
        EMOVI(S, 0);                                  # dead stub: rax = 0
    } else {
        _cov_body(S, fi, _defstart_ti);   # 6.7.10 (P5-B): the coverage hit, then PARSE_PROG
    }
    # v6.5.69 — THE RESUME DISPATCH, emitted at fn END where every landing pad is already a
    # known code position, so only the single forward jump from the fn top needs patching.
    # ⚠ A COMPARE CHAIN, NOT A JUMP TABLE. `PARSE_SWITCH`'s table path is x86-only — it sets
    # `use_table = 0` for aarch64 and cx — and the table is DATA inside `.text`, which the
    # whole-program compactor's own notes flag as the thing a linear decoder walks into. The
    # chain is what that parser itself falls back to and it needs no new machinery.
    if (_cur_fn_coro == 1) {
        # 6.6.10 — A BODY THAT FALLS OFF ITS END COMPLETES with 0, through the return landing
        # (its defers, then `_coro_mark_done`). The dispatch below sits right after the body, so
        # a fall-off ran into it, read C[state] and jumped back to the last resume label: the
        # force that should have completed the coroutine never returned. The plain-fn path got
        # this routing in 6.6.7 (`_defer_emit_init`); the coroutine path never did.
        EMOVI(S, 0);
        vec_push(rp_vec, EJMP0(S));
        EPATCH(S, _coro_top_jmp);
        _coro_flc = GFLC(S);
        _coro_done_check(S);
        var _dk = 1;
        while (_dk <= _coro_nsusp) {
            EFLLOAD(S, _coro_base);           # rax = C  (slot < _coro_lo: the stack path)
            EADDRA_IMM(S, _CORO_STATE_OFF);
            ELOAD64(S);                       # rax = C[state]
            EPUSHR(S);
            EMOVI(S, _dk);
            EPOPC(S);                         # rcx = _dk
            ECMPR(S);
            var _dp = EJCC(S, 0x85);          # jne -> next comparison
            EJMP(S, L64(&_coro_rcp + _dk * 8));
            EPATCH(S, _dp);
            _dk = _dk + 1;
        }
        # 6.6.7 — state 0 (first entry) zeroes the defer flags, which live in the heap frame and
        # so could not be zeroed at fn entry (SELF is homed only after it), and must NOT be
        # re-zeroed on a resume or a defer registered before an await would be forgotten.
        _defer_zero_flags(S);
        EJMP(S, _coro_entry_cp);              # state 0 -> the top of the real body
        # Hand the frame size to the constructor, which is emitted AFTER this body and so
        # already knows how big the coroutine frame has to be — the one piece of luck in the
        # whole layout, and the reason no second pass is needed.
        # (`_coro_flc` was taken at the top of this dispatch, before `_coro_done_check`.)
        _coro_was = 1;
        # 6.6.7: `_cur_fn_coro` stays 1 until the defer walker is emitted (see the epilogue).
    }
    if (_gen_base == 1) { _tp_clear(S); }
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    # Record body end and classify inline candidate. v6.4.0 DECOUPLE: generic fns only.
    if (_INLINE_OK == 1 || _fn_inline_req == 1 || (_MONOMORPH_OK == 1 && GFTP(S, fi) != 0) || _fn_has_simd_param(S, pc) == 1) {
        SFBE(S, fi, GTI(S));
        var btokens = GTI(S) - GFBS(S, fi);
        var can_inline = 1;
        var _inl_why = 0;
        if (pc > 2) { can_inline = 0; _inl_why = 1; }
        if (_is_async == 1) { can_inline = 0; _inl_why = 8; }   # 6.7.14: first — never replayed
        if (_pd_row(fi) != 0) { can_inline = 0; if (_inl_why == 0) { _inl_why = 7; } }   # 6.7.7 (B6): a call may fill
        # v6.3.9 (F-fns): ceiling 16->32 — admits slightly larger straight-line
        # generic/inline bodies. pc<=2 (above) + the forbidden-token scan below
        # (no control-flow / var-decl) are UNCHANGED, so inl_packed (2 param
        # offsets) capacity is untouched. Only fires under _INLINE_OK/_MONOMORPH_OK
        # (this whole block is gated) → default cycc self-host is byte-identical.
        if (btokens > 32) { can_inline = 0; if (_inl_why == 0) { _inl_why = 2; } }
        # v6.3.37 (C1) — a struct-typed or `*T` parameter cannot ride the inline replay;
        # `_inl_param_why` says why and walks the parameter SLOTS.
        if (can_inline == 1) {
            var _pwhy = _inl_param_why(S);   # 6.6.20: by SLOT, and a `*T` parameter too (see there)
            if (_pwhy != 0) { can_inline = 0; if (_inl_why == 0) { _inl_why = _pwhy; } }
        }
        if (can_inline == 1) {
            var sci = GFBS(S, fi);
            while (sci < GTI(S)) {
                var st = TOKTYP(S, sci);
                if (st == 15) { can_inline = 0; if (_inl_why == 0) { _inl_why = 4; } }
                if (st == 16) { can_inline = 0; if (_inl_why == 0) { _inl_why = 4; } }
                if (st == 55) { can_inline = 0; if (_inl_why == 0) { _inl_why = 4; } }
                # 6.7.5 (B5): `do`, and the contextual `loop {` — no token, so the three tests above
                # never see it, and a body holding a `loop` was the one loop form replayed.
                if (st == 172 || _TOK_IS_LOOP_AT(S, sci) == 1) { can_inline = 0; if (_inl_why == 0) { _inl_why = 4; } }
                # 6.6.7 — a `defer` / `secret var` belongs to the fn that REGISTERS it, and the
                # replay re-parses this body inside the CALLER, so the block would join the
                # caller's defer table and run at the CALLER's return (measured: `g(5); seen =
                # cran;` read 0, the block ran twice at the caller's end). Not opt-in: every small
                # generic fn and SIMD-param fn is a candidate. It also has to stay out because
                # the caller's `_body_has_defer` prescan cannot see a replayed block, so the
                # caller could still tail-call past it. CHANGELOG [6.6.7]
                if (st == 106 || st == 108) { can_inline = 0; if (_inl_why == 0) { _inl_why = 5; } }
                # v6.5.52 — a body `var` decl is allowed for SIMD-param fns. The value-form
                # wrappers all declare a scratch (`var r: f32v4; f32v_add(&r,&a,&b,4); return r;`),
                # so the blanket exclusion kept out exactly the fns this arc needs. Body locals
                # allocate at GFLC, which the replay has already advanced past the param slots,
                # so they land above them. Kept for every other fn: this stays scoped to the
                # targeted admission rather than widening general inlining.
                if (st == 3) { if (_fn_has_simd_param(S, pc) == 0) { can_inline = 0; if (_inl_why == 0) { _inl_why = 4; } } }
                sci = sci + 1;
            }
        }
        if (can_inline == 1) {
            # v6.5.52: the replay needs param TYPES as well as names — GFINL carries only the
            # two name offsets, which is why a wide param was bound into an 8-byte slot.
            SFIPT(S, fi, _ipt_pack);
            # v6.5.52 — pack the NAMED slot of each param, not slots 0 and 1.
            # ⛔ THIS IS WHY WIDE PARAMS CRASHED THE COMPILER. A param occupies
            # `_ipt_slots` slots with (n-1) ANON fillers BEFORE its named slot, so for a
            # 16-byte param the name lives at slot 1, not slot 0 — and slot 0 holds the anon
            # marker `0 - 1`. Packed through `& 0xFFFFFFFF` that becomes 0xFFFFFFFF, which is
            # POSITIVE as an i64, so FINDLOCAL's `if (sn >= 0)` guard lets it through and hands
            # 4294967295 to STREQ as a name offset. Measured at the fault: rsi = 0xffffffff.
            var _n0 = _ipt_slots(S, _ipt_sltype(_ipt_pack, 0)) - 1;
            var _n1 = _n0 + _ipt_slots(S, _ipt_sltype(_ipt_pack, 1));
            if (pc == 2) { SFINL(S, fi, (L64(S + 0x5D9D000 + _n1 * 8) << 32) | (L64(S + 0x5D9D000 + _n0 * 8) & 0xFFFFFFFF)); }
            elif (pc == 1) { SFINL(S, fi, L64(S + 0x5D9D000 + _n0 * 8)); }
            elif (pc == 0) { SFINL(S, fi, 1); }
        } else { SFINL(S, fi, 0); }
        # v6.5.63 — AN IGNORED `#inline` MUST SAY SO. The whole reason this directive exists
        # is that consumers were annotating for an optimisation that was not there; a request
        # that silently does nothing is that same defect with a token in front of it. Name the
        # constraint that refused it so the author can restructure or drop the marker.
        if (_fn_inline_req == 1) {
            if (can_inline == 0) {
                if (_inl_why == 1) { WARN(S, "#inline ignored: fn takes more than 2 parameters", 48); }
                if (_inl_why == 2) { WARN(S, "#inline ignored: body exceeds 32 tokens", 39); }
                if (_inl_why == 3) { WARN(S, "#inline ignored: struct/aggregate parameter", 43); }
                if (_inl_why == 4) { WARN(S, "#inline ignored: body has control flow or a var declaration", 59); }
                if (_inl_why == 5) { WARN(S, "#inline ignored: body has a defer/secret block", 46); }
                if (_inl_why == 6) { WARN(S, "#inline ignored: pointer (*T) parameter", 39); }
                if (_inl_why == 7) { WARN(S, "#inline ignored: fn has parameter defaults", 42); }
                if (_inl_why == 8) { _inl_async_warn(S, _async_noff_f); }
            }
        }
    }
    STI(S, GTI(S) + 1);
    # Defer flag init (zeroing trampoline), return landing, LIFO defer walk — the shared
    # epilogue authority (parse.cyr `_defer_emit_init` / `_rp_patch_here` / `_defer_emit_walk`),
    # over THIS fn's ranges [_defer_base, count) and [_rp_base, len). CHANGELOG [6.6.7]
    # 6.7.3: off the end of a bool fn is `false` — before the defer trampoline (with defers the
    # fall-through jmps round it to the landing); every return lands past it.
    _bx_falloff(S);
    _mret_falloff(S);   # 6.7.13 (D28 C): and of a fn declared `: (T1, T2[, T3])`, every value 0
    _defer_emit_init(S, defer_init_jmp, body_cp);
    _tcp_resolve(S);   # 6.7.3: the in-loop tail calls' verdicts (a fn with a defer has none)
    _rp_patch_here(S);
    _ret_box_f64(S, _cur_fn_ret_scalar);   # 6.6.20: every return arm, and falling off the end
    _defer_emit_walk(S);
    # 6.6.7 — a coroutine's suspend exits return 0 to the runtime WITHOUT completing the body,
    # so they land HERE, past the walker: a defer runs once, when the body really returns.
    # The coroutine mode was held on through the walker so its flag loads use the heap frame
    # the body's flag stores wrote (clearing it before the walker is why coroutine defers never
    # ran: the set went to [r11+off], the test to [rbp-disp]). CHANGELOG [6.6.7]
    if (_cur_fn_coro == 1) {
        _coro_mark_done(S);
        _coro_land_suspends(S);
        _cur_fn_coro = 0;
    }
    # v4.9.1: restore callee-saved registers (reverse order of save).
    # v5.11.35 path-A: dispatch lives in <backend>/emit.cyr.
    # v6.2.27: #naked emits NO regalloc restore + NO epilogue — the ISR body
    # ends with its own return (iretq / eret), not a `mov rsp,rbp; pop rbp; ret`.
    if (_cur_fn_naked == 0) {
        EREGALLOC_RESTORE(S, _cur_fn_regalloc);
        # Emit epilogue
        EFNEPI(S);
    }
    # CO-03 (v6.1.34): DSE + LASE are x86 byte-pattern passes — they scan codebuf
    # for `48 89 85`/`48 8B 85` windows and NOP-patch. On aarch64 (a 4-byte ISA)
    # those bytes can match instruction words and corrupt them, so gate to x86,
    # matching the compaction pass below (also `_AARCH64_BACKEND == 0`-gated). The
    # compiler's own aarch64 code doesn't hit the pattern in-tree, but a consumer's
    # could (silent miscompile).
    #
    # ⛔ `_AARCH64_BACKEND == 0` IS NOT AN x86 TEST — cx sets it to 0 as well, so every pass
    # below this line used to walk cx BYTECODE looking for x86 ModRM bytes, and NOP-fill on a
    # match. `wp_compact` (common/ir.cyr) and `_try_vec_direct` (parse_expr.cyr) already carry
    # both tests and say so; these four did not. The reasoning the CO-03 comment gives for
    # aarch64 — the compiler's own output never spells the pattern, a consumer's could — holds
    # verbatim for cx, whose opcode assignment is not a fixed ISA and can change under us.
    # Measured inert today: 44 of 44 cx-compilable corpus files emit identical bytecode with
    # this gate, the same standing the register picker's own `_TARGET_CX` gate has. One local,
    # read four times, so the two per-byte walks below do not gain a second global load.
    # CHANGELOG [6.6.5]
    var bp_x86 = 0;
    if (_AARCH64_BACKEND == 0 && _TARGET_CX == 0) { bp_x86 = 1; }
    if (bp_x86 == 1) { DSE_PASS(S, fn_start); }
    # LASE: eliminate store+load pairs where the load is NOT a jump target (x86-only)
    #
    # v6.5.53 — SWITCH-TABLE GUARD, for both LASE loops. Since v6.5.20 a fn's byte range can
    # contain inline switch jump-table DATA as well as instructions, and BOTH of these loops are
    # UNALIGNED byte-pattern walks of that range — the same shape `_ra_frame_trim` already
    # guards with `_sw_tbl_hits` for exactly this reason. A 4-byte displacement in a table is
    # arbitrary bytes, so in principle one can spell a store/load pattern and NOP-filling there
    # would corrupt the table.
    #
    # ⚠ HONEST SCOPE, because the first version of this comment overstated it: measurement says
    # the hazard is currently UNREACHABLE, not live. Table entries are fn-relative signed 32-bit
    # deltas, so their high byte is 0x00, and matching `66 0F 11 85` would need a delta near
    # -2.06 GB. The integer arm was unguarded too and has evidently never been bitten. This is
    # therefore DEFENSIVE — two comparisons that cost nothing and remove a whole class of
    # reasoning from every future edit to either loop — not a bug fix. It is added because both
    # loops are unaligned byte walks over a range that has contained DATA since v6.5.20, which is
    # exactly the condition `_ra_frame_trim` already guards against a few hundred lines up.
    var lase_swtn = L64(S + 0x1AC800);
    if (lase_swtn > 256) { lase_swtn = 256; }
    var lase_cp = GCP(S);
    var lase_i = fn_start;
    var lase_count = 0;
    while (bp_x86 == 1 && lase_i + 14 <= lase_cp) {
        # Detect store (7 bytes): 48 89 85 XX XX XX XX
        if (load8(_codebuf_base + lase_i) == 0x48) {
            if (load8(_codebuf_base + lase_i + 1) == 0x89) {
                if (load8(_codebuf_base + lase_i + 2) == 0x85) {
                    # Check for load at exactly store+7: 48 8B 85 XX XX XX XX (same offset)
                    var lj = lase_i + 7;
                    if (load8(_codebuf_base + lj) == 0x48) {
                        if (load8(_codebuf_base + lj + 1) == 0x8B) {
                            if (load8(_codebuf_base + lj + 2) == 0x85) {
                                if (load32(_codebuf_base + lase_i + 3) == load32(_codebuf_base + lj + 3)) {
                                    # Same offset — check if load is a jump target
                                    if (IS_JUMP_TARGET(S, lj) == 0 && (lase_swtn == 0 || _sw_tbl_hits(S, lase_swtn, lase_i) == 0)) {
                                        # Safe to eliminate — NOP the 7-byte load
                                        var ln = lj;
                                        while (ln < lj + 7) {
                                            store8(_codebuf_base + ln, 0x90);
                                            ln += 1;
                                        }
                                        lase_count += 1;
                                    }
                                }
                            } } }
                } } }
        lase_i += 1;
    }
    # v6.5.53 — the SAME elimination for 128-bit SIMD pairs. v6.5.52 made the value-form SIMD
    # wrappers inline, which turns a chain into packed ops separated by store-then-immediately-
    # reload of the same frame slot:
    #     66 0F 11 85 <disp32>   movupd [rbp+disp32], xmm0     (8 bytes)
    #     66 0F 10 85 <disp32>   movupd xmm0, [rbp+disp32]     (8 bytes)
    # The integer loop above cannot see these: it matches only REX.W `48 89 85` / `48 8B 85`.
    #
    # ⭐ MODRM 0x85 PINS xmm0 ON BOTH SIDES, and that is what makes this safe. ModRM is
    # mod(2) reg(3) rm(3), so 0x85 = mod 10 (disp32), reg 000 (xmm0), rm 101 (rbp); xmm1 is
    # 0x8D, xmm2 0x95, xmm3 0x9D. Requiring 0x85 on BOTH sides guarantees the load's
    # destination is the register the store just wrote — the property the integer version gets
    # for free from rax.
    #
    # ⚠ TWO SEPARATE INVARIANTS, AND CONFLATING THEM IS HOW THE NEXT EDIT MISCOMPILES.
    #
    #   ADJACENCY (+8) is what keeps the 32-byte f64v4/f32v8 pair out. A 256-bit value stores as
    #   `66 0F 11 85 <d_lo>` (xmm0) then `66 0F 11 8D <d_lo+16>` (xmm1), so the byte at store+8
    #   is another STORE (0x11) and fails the 0x10 test; independently `d_lo != d_lo+16`, so the
    #   disp32 equality test rejects it too. The modrm has nothing to do with it.
    #
    #   THE REGISTER TEST is what keeps the LOAD's destination honest, and it IS load-bearing.
    #   The load side's register is VARIABLE: `ELOAD_F64V2_TO_XMM` / `ELOAD_F64V4_TO_XMM`
    #   (backend/x86/emit.cyr) emit `0x85 + (simd_ord << 3)` for SIMD argument ordinals 0..7, so
    #   a value stored from xmm0 is routinely reloaded into xmm2/xmm3 as a later call's second
    #   SIMD argument. Deleting THAT load leaves xmm2/xmm3 holding whatever the previous SIMD
    #   call left behind — a silent wrong vector, no crash, no diagnostic.
    #
    # ⚠ MEASURED four ways on a 3-link chain, because the interaction is what matters:
    #     pin + strict +8 (shipped)  ->  0 deletions, 0 miscompiles
    #     pin + relaxed distance     ->  3 deletions, 0 miscompiles
    #     no pin + strict +8         ->  0 deletions, 0 miscompiles
    #     no pin + relaxed distance  ->  6 deletions, **2 MISCOMPILES**
    # So the register test looks redundant TODAY only because adjacency happens to exclude the
    # cases that need it. Relax the distance — which is the obvious next step, since f64v4 pairs
    # sit at store+16/+24 and this pass currently gets nothing for them — and it becomes the only
    # thing standing between you and a wrong answer. Do not remove it.
    #
    # The comparison below is written as REGISTER IDENTITY rather than two literal `== 0x85`
    # tests. Byte-identical behaviour today (both sides are xmm0 in every sequence the emitters
    # currently produce), but it states the actual requirement, so it survives a future edit that
    # widens the addressing form or the distance.
    #
    # Like the integer version this NOP-FILLS the load in place rather than removing bytes, so
    # no jump displacement, fixup CP or inline switch-table entry moves — the v6.5.20 class of
    # bug (a pass relocating code without knowing about an inline data table) cannot arise.
    # IS_JUMP_TARGET still guards the load: control arriving directly at it would find xmm0
    # holding something else.
    var slase_i = fn_start;
    while (bp_x86 == 1 && slase_i + 16 <= lase_cp) {
        if (load8(_codebuf_base + slase_i) == 0x66) {
            if (load8(_codebuf_base + slase_i + 1) == 0x0F) {
                if (load8(_codebuf_base + slase_i + 2) == 0x11) {
                    var _st_mr = load8(_codebuf_base + slase_i + 3);
                    if ((_st_mr & 0xC7) == 0x85) {
                        var slj = slase_i + 8;
                        # v6.5.66 — SKIP AN INTERVENING NOP RUN, AND NOTHING ELSE.
                        #
                        # v6.5.66 harvests the now-dead inline-param copies by NOP-FILLING them in
                        # place, so a chain link's result store and the next link's reload are no
                        # longer at +8 — they are separated by 32 bytes of 0x90. Without this the
                        # pass silently stops firing on exactly the sequence it was built for.
                        #
                        # ⚠ THIS IS NOT "RELAX THE DISTANCE", and the distinction is the whole
                        # safety argument. The block comment above records the measurement: pin +
                        # RELAXED DISTANCE gives 3 deletions and 0 miscompiles, but no-pin +
                        # relaxed distance gives 2 MISCOMPILES, because arbitrary instructions
                        # between store and load may clobber the register. NOPs provably clobber
                        # nothing, so the adjacency proof survives intact — the register-identity
                        # pin below is kept regardless, exactly as that comment demands.
                        #
                        # ⚠ EVERY SKIPPED BYTE IS JUMP-TARGET CHECKED, not just the load. Control
                        # arriving anywhere inside the run falls through to the load with the
                        # register holding something else — the same hazard IS_JUMP_TARGET guards
                        # at `slj`, one byte at a time across the gap.
                        var _slnskip = 0;
                        while (_slnskip < 64) {
                            if (load8(_codebuf_base + slj) != 0x90) { _slnskip = 64; }
                            else {
                                if (IS_JUMP_TARGET(S, slj) == 1) { _slnskip = 64; }
                                else { slj = slj + 1; _slnskip = _slnskip + 1; }
                            }
                        }
                        if (load8(_codebuf_base + slj) == 0x66) {
                            if (load8(_codebuf_base + slj + 1) == 0x0F) {
                                if (load8(_codebuf_base + slj + 2) == 0x10) {
                                    var _ld_mr = load8(_codebuf_base + slj + 3);
                                    # same addressing form ([rbp+disp32]) AND the same xmm register
                                    if ((_ld_mr & 0xC7) == 0x85 && ((_st_mr >> 3) & 7) == ((_ld_mr >> 3) & 7)) {
                                        if (load32(_codebuf_base + slase_i + 4) == load32(_codebuf_base + slj + 4)) {
                                            if (IS_JUMP_TARGET(S, slj) == 0 && (lase_swtn == 0 || _sw_tbl_hits(S, lase_swtn, slase_i) == 0)) {
                                                var sln = slj;
                                                while (sln < slj + 8) {
                                                    store8(_codebuf_base + sln, 0x90);
                                                    sln += 1;
                                                }
                                                lase_count += 1;
                                            }
                                        }
                                    } } } }
                    } } } }
        slase_i += 1;
    }
    # v4.8.4-alpha7/alpha8: #regalloc routing via post-body peephole.
    # alpha7 did the core patch (rewrite `mov rax,[rbp-N]` /
    # `mov [rbp-N],rax` to `mov rax,rbx` / `mov rbx,rax` + NOP pad)
    # for a positional pick (local idx `pc`). alpha8 adds:
    #   1. Use-count picker — actually pick the hottest non-param
    #      slot, not just the first one.
    #   2. Width-aware safety scan — abort routing if the picked slot
    #      is accessed via any non-8-byte mov (movzx byte/word,
    #      byte/word/dword store, loop-var r12 cache), since those
    #      still hit the stack slot and would diverge from rbx.
    # The `&local` abort (lea [rbp+hot_disp]) also stays in effect.
    #
    # `_TARGET_CX == 0`: this is an x86 byte-pattern rewriter. cx sets `_AARCH64_BACKEND = 0`, so
    # the auto-enable above fires there too (`_cur_fn_regalloc` = 5, measured) and this pass used
    # to walk cx BYTECODE looking for x86 ModRM bytes. It matched nothing in any cx corpus file
    # (0 of 44 outputs change with the gate), but a classifier reading a byte stream it was not
    # written for is the defect this pass just had, in its purest form. The frame reservation
    # `_cur_fn_regalloc` implies is left alone — changing it would move every cx local. CHANGELOG [6.6.5]
    if (_cur_fn_regalloc > 0 && _cur_fn_has_closure == 0 && _TARGET_CX == 0) {
        var ra_flc = GFLC(S);
        if (pc < ra_flc) {
            var ra_start = fn_start;
            var ra_end = GCP(S);
            # -- Use-count + live-interval pass (alpha8 + v5.6.19 O4a).
            # Walk the emitted bytes and for each user-local slot:
            #   ra_counts[idx]  → number of patchable 64-bit mov refs
            #   ra_first[idx]   → CP of first ref (-1 if none)
            #   ra_last[idx]    → CP of last ref (-1 if none)
            # The intervals (ra_first, ra_last) are the foundation for
            # v5.6.20's Poletto-Sarkar linear-scan picker. Built for
            # every regalloc-flagged fn here; v5.6.21 auto-enables for
            # every fn so intervals are computed everywhere.
            #
            # Params (idx < pc) get skipped — their prologue stores are
            # `ESTOREREGPARM` (different ModR/M), but the subsequent
            # reads/writes we *would* match shouldn't steal a slot
            # from a hotter user local.
            #
            # Cap at 256 entries — #regalloc fns are small by
            # intention; if any has >256 locals it skips routing.
            if (ra_flc <= 256) {
                # v5.6.19 O4a: arrays sized 2048 bytes = 256 i64 slots.
                # The pre-existing `ra_counts[256]` is only 256 BYTES (32
                # i64 slots) but the init+scan loops write 256 slots —
                # the overflow lands in adjacent global memory and the
                # existing peephole tolerated it because pick uses
                # use-count which falls through to 0 for high-idx slots.
                # Interval tracking can't tolerate that — first/last
                # values must be reliable per slot. Sized correctly here.
                var ra_counts[2048];
                var ra_first[2048];
                var ra_last[2048];
                var ra_ci = 0;
                while (ra_ci < 256) {
                    store64(&ra_counts + ra_ci * 8, 0);
                    store64(&ra_first + ra_ci * 8, 0 - 1);
                    store64(&ra_last + ra_ci * 8, 0 - 1);
                    ra_ci = ra_ci + 1;
                }
                var ra_s = ra_start;
                while (ra_s + 7 <= ra_end) {
                    # Counts exactly the forms the patch pass rewrites — the shared predicate. The
                    # `0x48` byte test is a fast reject of the predicate's own first check, not a
                    # second definition: it keeps a call off most bytes of every function.
                    var ra_k = 0;
                    if (load8(_codebuf_base + ra_s) == 0x48) { ra_k = _ra_plain_slot_mov(ra_s); }
                    if (ra_k != 0) {
                        # Decode disp32 → local idx. Only [rbp+neg]
                        # slots are user locals; positive disps are
                        # stack args above rbp and ignored.
                        var ra_d = load32(_codebuf_base + ra_s + 3);
                        # Sign-extend the 32-bit signed disp.
                        if (ra_d >= 0x80000000) { ra_d = ra_d - 0x100000000; }
                        if (ra_d < 0) {
                            # disp = -(idx+1+N)*8 - stash where N = _cur_fn_regalloc
                            # and stash = _cur_fn_ret_stash (retptr slot, bytes), so
                            # idx = (-ra_d - stash)/8 - 1 - N. v6.4.31: the `- stash`
                            # term was missing → on a retptr-returning fn (stash=8:
                            # >16B struct OR — since .31 — any SIMD return) every
                            # local's refs mapped one slot high, defeating the
                            # `iv_li = pc` param exclusion so a homed-not-stored param
                            # got a register with no init (garbage). No-op when stash=0.
                            var ra_idx = (0 - ra_d - _cur_fn_ret_stash) / 8 - 1 - _cur_fn_regalloc;
                            if (ra_idx >= pc) {
                                if (ra_idx < ra_flc) {
                                    var ra_cur = load64(&ra_counts + ra_idx * 8);
                                    store64(&ra_counts + ra_idx * 8, ra_cur + 1);
                                    # v5.6.19 O4a: track first/last CP for this local.
                                    if (load64(&ra_first + ra_idx * 8) == (0 - 1)) {
                                        store64(&ra_first + ra_idx * 8, ra_s);
                                    }
                                    store64(&ra_last + ra_idx * 8, ra_s);
                                } }
                        }
                    }
                    ra_s = ra_s + 1;
                }
                # v5.6.19 O4a: dump per-fn intervals when CYRIUS_REGALLOC_DUMP=1.
                # Output format (one fn-header + one line per local with refs):
                #   ra: fi=<fi> fn_start=<cp> fn_end=<cp> flc=<n>
                #   ra:   lidx=<lidx> count=<n> first=<cp> last=<cp> span=<bytes>
                if (_ra_dump_enabled == 1) {
                    syscall(SYS_WRITE, 2, "ra: fi=", 7);
                    PRNUM(fi);
                    syscall(SYS_WRITE, 2, " fn_start=", 10);
                    PRNUM(ra_start);
                    syscall(SYS_WRITE, 2, " fn_end=", 8);
                    PRNUM(ra_end);
                    syscall(SYS_WRITE, 2, " flc=", 5);
                    PRNUM(ra_flc);
                    syscall(SYS_WRITE, 2, " pc=", 4);
                    PRNUM(pc);
                    syscall(SYS_WRITE, 2, "\n", 1);
                    var _rad_li = pc;
                    while (_rad_li < ra_flc) {
                        var _rad_c = load64(&ra_counts + _rad_li * 8);
                        if (_rad_c > 0) {
                            var _rad_f = load64(&ra_first + _rad_li * 8);
                            var _rad_l = load64(&ra_last + _rad_li * 8);
                            syscall(SYS_WRITE, 2, "ra:   lidx=", 11);
                            PRNUM(_rad_li);
                            syscall(SYS_WRITE, 2, " count=", 7);
                            PRNUM(_rad_c);
                            syscall(SYS_WRITE, 2, " first=", 7);
                            PRNUM(_rad_f);
                            syscall(SYS_WRITE, 2, " last=", 6);
                            PRNUM(_rad_l);
                            syscall(SYS_WRITE, 2, " span=", 6);
                            PRNUM(_rad_l - _rad_f);
                            syscall(SYS_WRITE, 2, "\n", 1);
                        }
                        _rad_li = _rad_li + 1;
                    }
                }
                # v4.9.1: pick up to _cur_fn_regalloc hot locals.
                # Register assignment table (3-byte mov encodings):
                #   reg 0 (rbx): load=48 89 D8, store=48 89 C3
                #   reg 1 (r12): load=4C 89 E0, store=49 89 C4
                #   reg 2 (r13): load=4C 89 E8, store=49 89 C5
                #   reg 3 (r14): load=4C 89 F0, store=49 89 C6
                #   reg 4 (r15): load=4C 89 F8, store=49 89 C7
                # "load" = mov rax, reg; "store" = mov reg, rax.
                var ra_load_b0[5]; var ra_load_b1[5]; var ra_load_b2[5];
                var ra_store_b0[5]; var ra_store_b1[5]; var ra_store_b2[5];
                store8(&ra_load_b0, 0x48); store8(&ra_load_b1, 0x89); store8(&ra_load_b2, 0xD8);
                store8(&ra_store_b0, 0x48); store8(&ra_store_b1, 0x89); store8(&ra_store_b2, 0xC3);
                store8(&ra_load_b0+1, 0x4C); store8(&ra_load_b1+1, 0x89); store8(&ra_load_b2+1, 0xE0);
                store8(&ra_store_b0+1, 0x49); store8(&ra_store_b1+1, 0x89); store8(&ra_store_b2+1, 0xC4);
                store8(&ra_load_b0+2, 0x4C); store8(&ra_load_b1+2, 0x89); store8(&ra_load_b2+2, 0xE8);
                store8(&ra_store_b0+2, 0x49); store8(&ra_store_b1+2, 0x89); store8(&ra_store_b2+2, 0xC5);
                store8(&ra_load_b0+3, 0x4C); store8(&ra_load_b1+3, 0x89); store8(&ra_load_b2+3, 0xF0);
                store8(&ra_store_b0+3, 0x49); store8(&ra_store_b1+3, 0x89); store8(&ra_store_b2+3, 0xC6);
                store8(&ra_load_b0+4, 0x4C); store8(&ra_load_b1+4, 0x89); store8(&ra_load_b2+4, 0xF8);
                store8(&ra_store_b0+4, 0x49); store8(&ra_store_b1+4, 0x89); store8(&ra_store_b2+4, 0xC7);
                # v5.6.20 Phase O4b: Poletto-Sarkar linear-scan picker.
                # Replaces the greedy use-count picker. Operates over the
                # v5.6.19 intervals (ra_first / ra_last / ra_counts).
                #
                # Algorithm (Poletto & Sarkar 1999):
                #   1. Build interval list for locals with count >= 2
                #   2. Sort by first_cp ascending (tie-break: lidx ascending)
                #   3. Walk forward; maintain active set (per-reg interval idx)
                #   4. For each interval:
                #      a. Expire any active reg whose interval.last < cur.first
                #      b. If a free reg: safety_scan + assign
                #      c. Else (all regs in use): find spill candidate with
                #         FURTHEST last_cp; if its last > cur.last, evict it
                #         and take its register; else cur itself spills
                #   5. Patch pass: for each assigned interval, rewrite ONLY
                #      within [first, last] — time-sliced sharing.
                #
                # Time-sliced sharing safety (no spill/reload code yet):
                # cyrius requires `var x = expr;` for every user local —
                # every interval starts with a STORE. The register holds the
                # right value from the start of each interval; no LOAD-from-
                # stack needed at interval start. Safety scan still full-fn:
                # if a local has non-mov access (e.g., &local), it's barred
                # from regalloc entirely.
                #
                # CYRIUS_REGALLOC_PICKER_CAP=N caps total assignments for
                # bisection (per v5.6.17 saved methodology). Read elsewhere.
                var iv_lidx[2048];     # 256 i64 slots
                var iv_first[2048];
                var iv_last[2048];
                var iv_assigned[2048]; # which reg this interval got (-1 = spilled)
                var iv_n = 0;

                # v6.5.35 — LOOP-AWARE liveness, replacing the v5.6.22 blanket extension.
                #
                # v5.6.22 found that time-sharing a register breaks across a backward CFG
                # edge: when the picker reuses a register for a later interval, a JMP_BACK
                # into a position inside an EARLIER interval re-reads the register expecting
                # the earlier value and finds the later one. It surfaced on
                # PP_ALREADY_INCLUDED (`while (i < cnt)`: the `cnt` load was rewritten to
                # rbx, and rbx was later reused for `p` inside the loop body). The safe fix
                # then was to extend EVERY interval's end to the function end so expire could
                # never fire — correct, but it made the linear scan greedy-equivalent and the
                # computed intervals dead weight. The note called the proper fix
                # "loop-aware liveness extension, pinned future slot". This is that slot.
                #
                # Now: find the backward edges once per fn, and extend only the intervals
                # that actually overlap a loop body, only as far as that loop's branch.
                # Measured on cycc's own source at v6.5.34, this moves 946 more locals into
                # registers (1,617 → 2,563 assigned, +58 %) across 137 of 553 fns.
                #
                # ⚠ FAIL-SAFE, AND IT MUST STAY THAT WAY: `RA_SCAN_LOOPS` returns -1 for an
                # undecodable range OR more edges than the cap, and -1 means "no information",
                # NOT "no loops". A partial edge list is worse than none — the picker would
                # time-share across exactly the loop the scan failed to see. On -1 every
                # interval falls back to `ra_end`, i.e. precisely the v5.6.22 behaviour.
                var be_t[1024];   # 128 i64 slots
                var be_s[1024];
                var be_n = RA_SCAN_LOOPS(_codebuf_base, ra_start, ra_end, &be_t, &be_s, 128);

                # v6.5.35 — HOIST the per-candidate safety scan out of the picker loop.
                #
                # "Is this local safe to promote?" was answered by walking the whole function's
                # bytes ONCE PER CANDIDATE. That was affordable only because the lifetime cap
                # stopped the loop after five picks; removing the cap (see the pick_cap note
                # below) made it run for every interval, and the cost is O(candidates x fn
                # bytes). MEASURED on a quiet box: self_compile 712ms -> 770ms, +8.1%.
                #
                # The question is per-LOCAL and the answer does not depend on which candidate
                # is asking, so one pass over the function fills a per-local flag and every
                # later lookup is O(1). Two disqualifiers:
                #   * a `[rbp+disp32]` reference, with ANY reg field, that `_ra_plain_slot_mov`
                #     rejects — i.e. anything but exactly `48 8B 85` / `48 89 85`, and
                #   * ANY `lea` of the slot — `48 8D` with (ModRM & 0xC7) == 0x85, any dest.
                #     A <=8-byte struct field store emits `lea rcx,[rbp+disp]; mov [rcx],rax`,
                #     so the slot is address-taken and must stay in memory. Masking the reg
                #     field matters: the v6.3.39 bug was a non-rax lea slipping past an
                #     exact-0x85 test and the picker promoting a slot the store never wrote.
                var ra_unsafe[256];
                var ru_i = 0;
                while (ru_i < 256) { store8(&ra_unsafe + ru_i, 0); ru_i = ru_i + 1; }
                var ru_p = ra_start;
                while (ru_p + 7 <= ra_end) {
                    var ru_m = load8(_codebuf_base + ru_p + 2);
                    # THE TRIGGER IS REG-FIELD AGNOSTIC, AND SO IS THE EXEMPTION (6.6.5).
                    #
                    # `(ru_m & 0xC7) == 0x85` is mod=10, rm=101 — every [rbp+disp32] reference,
                    # whatever its reg field. v6.5.64 widened the trigger to this from an exact
                    # `== 0x85` so that `movupd -disp(%rbp),%xmm1` (66 0F 10 8D) and friends would
                    # disqualify their slot, and its comment claimed `mov rdx,[rbp+disp32]`
                    # (48 8B 95) was now caught too. ⛔ It was not: the exemption below still read
                    # only the prefix and opcode (`48 8B` / `48 89`), so 48 8B 95 was waved through
                    # as a "plain mov" the patch pass would rewrite — and the patch pass rewrites
                    # exact 0x85 only. `_EMIT_LOAD_RDX_FROM_LOCAL` emits exactly that form for every
                    # operand read of every SIMD batch intrinsic (19 kernel emitters, 55 sites), so
                    # any operand slot that also carried two rax references (a slot freed by a nested
                    # inline replay and reused by the intrinsic's `_SIMD_RESERVE`) was promoted, its
                    # store rewritten into a register move, and the kernel read a slot nothing wrote.
                    # The exemption now asks the same predicate the use scan and the patch pass ask,
                    # so the three cannot disagree.
                    #
                    # ⚠ The v6.5.57 aggregate pass below is still needed and still separate: a
                    # struct/vector local's non-base words are reached through `lea`, never by an
                    # rbp disp, so no byte scan can see them. It also covered the high halves that
                    # `EFLLOAD_F64V4_PAIR` and `EFL{LOAD,STORE}_STRUCT_INT_PAIR` reference with
                    # non-rax forms (`66 0F 10 8D`, `48 8B/89 95`) — those are now disqualified here
                    # as well, by construction, instead of by a type rule happening to cover them.
                    #
                    # ⚠ The scan sees disp32 only. An rbp disp8 or SIB reference to a local slot
                    # would be invisible to all three stages; none is emitted into a regalloc fn
                    # (only ASM_PARAM_LOAD uses disp8, and inline-asm fns never enable the picker).
                    # tests/gates/codegen/simd_intrinsic_operand_slots.sh axis F pins that census.
                    # CHANGELOG [6.6.5]
                    if ((ru_m & 0xC7) == 0x85) {
                        var ru_d = load32(_codebuf_base + ru_p + 3);
                        if (ru_d >= 0x80000000) { ru_d = ru_d - 0x100000000; }
                        if (ru_d < 0) {
                            var ru_li = (0 - ru_d - _cur_fn_ret_stash) / 8 - 1 - _cur_fn_regalloc;
                            if (ru_li >= 0) {
                                if (ru_li < 256) {
                                    if (_ra_plain_slot_mov(ru_p) == 0) { store8(&ra_unsafe + ru_li, 1); }
                                }
                            }
                        }
                    }
                    ru_p = ru_p + 1;
                }

                # v6.5.57 — AN AGGREGATE'S NON-BASE WORDS ARE INVISIBLE TO THE SCAN ABOVE.
                # A struct field or vector lane is reached as `lea rcx,[rbp+base]` then
                # `mov [rcx+off]`, so ONLY the aggregate's base slot ever appears as an rbp
                # disp32. Its second and later words are named by no `[rbp+disp]` reference at
                # all, so the lea test cannot mark them and the picker was free to promote one
                # — while the field write that really sets it goes through rcx and never
                # reaches the register. The read then returns whatever the register held.
                #
                # ⚠ LATENT SINCE THE PICKER EXISTED, and it stayed latent only because those
                # words were referenced at most once, below the `iv_c > 1` candidacy threshold.
                # v6.5.57's aggregate-assignment copy adds a second reference and trips it:
                # `a` / `var b: P2 = a` / `var c: P2` / `c = a` made `b.y` read 11 instead of 22.
                # Confirmed by construction — `CYRIUS_REGALLOC_PICKER_CAP=0` makes the same
                # source correct.
                #
                # An aggregate is never a good register candidate anyway (its fields are
                # addressed, not held), so mark every slot it spans. Slots descend from the
                # named slot, matching `_try_struct_copy_init`'s `named - i` layout.
                var ag_li = 0;
                while (ag_li < ra_flc) {
                    var ag_t = GLTYPE(S, ag_li);
                    if (ag_t < 0) {
                        # 6.6.5: span the RECORDED layout. A pointer-mode struct local occupies
                        # ONE slot; the width-derived span used here before reached down over a
                        # NEIGHBOUR's slots and barred them from the picker for no reason.
                        var ag_n = 1;
                        if (GLAGG(S, ag_li) == 1) { ag_n = AGG_NSLOTS(S, ag_t); }
                        var ag_k = 0;
                        while (ag_k < ag_n) {
                            var ag_s = ag_li - ag_k;
                            if (ag_s >= 0) { if (ag_s < 256) { store8(&ra_unsafe + ag_s, 1); } }
                            ag_k = ag_k + 1;
                        }
                    }
                    ag_li = ag_li + 1;
                }

                var iv_li = ra_pslots;
                while (iv_li < ra_flc) {
                    var iv_c = load64(&ra_counts + iv_li * 8);
                    if (iv_c > 1) {
                        var iv_f = load64(&ra_first + iv_li * 8);
                        store64(&iv_lidx + iv_n * 8, iv_li);
                        store64(&iv_first + iv_n * 8, iv_f);
                        if (be_n < 0) {
                            store64(&iv_last + iv_n * 8, ra_end);
                        } else {
                            store64(&iv_last + iv_n * 8, _ra_loop_extend(&be_t, &be_s, be_n, iv_f, load64(&ra_last + iv_li * 8), ra_end));
                        }
                        store64(&iv_assigned + iv_n * 8, 0 - 1);
                        iv_n = iv_n + 1;
                    }
                    iv_li = iv_li + 1;
                }

                # Sort intervals by first_cp ascending (tie-break: lidx asc).
                # Insertion sort — iv_n is small (≤ 256).
                var sort_s = 1;
                while (sort_s < iv_n) {
                    var key_lidx = load64(&iv_lidx + sort_s * 8);
                    var key_first = load64(&iv_first + sort_s * 8);
                    var key_last = load64(&iv_last + sort_s * 8);
                    var sort_j = sort_s - 1;
                    var sort_done = 0;
                    while (sort_j >= 0 && sort_done == 0) {
                        var prev_first = load64(&iv_first + sort_j * 8);
                        var prev_lidx = load64(&iv_lidx + sort_j * 8);
                        var should_shift = 0;
                        if (prev_first > key_first) { should_shift = 1; }
                        elif (prev_first == key_first) {
                            if (prev_lidx > key_lidx) { should_shift = 1; }
                        }
                        if (should_shift == 1) {
                            store64(&iv_lidx + (sort_j + 1) * 8, prev_lidx);
                            store64(&iv_first + (sort_j + 1) * 8, prev_first);
                            store64(&iv_last + (sort_j + 1) * 8, load64(&iv_last + sort_j * 8));
                            sort_j = sort_j - 1;
                        } else { sort_done = 1; }
                    }
                    store64(&iv_lidx + (sort_j + 1) * 8, key_lidx);
                    store64(&iv_first + (sort_j + 1) * 8, key_first);
                    store64(&iv_last + (sort_j + 1) * 8, key_last);
                    sort_s = sort_s + 1;
                }

                # Linear scan. active_iv[r] = interval index in reg r (-1 = free).
                var active_iv[40];   # 5 i64 slots
                var as_init = 0;
                while (as_init < 5) {
                    store64(&active_iv + as_init * 8, 0 - 1);
                    as_init = as_init + 1;
                }
                # Picker assignment cap: bisection knob from day 1.
                #
                # ⭐ v6.5.35 — this was the SECOND half of the cross-BB defect, and the one
                # the roadmap's "it is one line" framing missed entirely. `picked` counts
                # assignments over the whole FUNCTION's lifetime, and the default cap was
                # `_cur_fn_regalloc` (5) — so once five locals had EVER been given a register,
                # every later interval was blocked no matter how many registers the expire
                # step had just freed. Time-sharing was structurally impossible even with
                # perfectly computed intervals, which is why fixing the interval force-set
                # ALONE changed not one byte of any consumer program's output (measured:
                # json_engine, math_pack_integration and sakshi_full were byte-identical).
                #
                # The knob's own comment already said `-1 = uncapped`; the code did not
                # implement that. The simultaneous-register constraint is enforced where it
                # belongs — `free_r == -1` falls through to the spill heuristic — so the
                # lifetime cap is now applied ONLY when the bisection knob asks for it.
                var pick_cap = 0 - 1;
                if (_ra_picker_cap >= 0) { pick_cap = _ra_picker_cap; }
                var picked = 0;

                var pi = 0;
                while (pi < iv_n) {
                    var cur_first = load64(&iv_first + pi * 8);
                    var cur_last = load64(&iv_last + pi * 8);
                    var cur_lidx = load64(&iv_lidx + pi * 8);
                    # Expire active intervals whose last < cur_first
                    var er = 0;
                    while (er < _cur_fn_regalloc) {
                        var aiv_e = load64(&active_iv + er * 8);
                        if (aiv_e != (0 - 1)) {
                            var aiv_e_last = load64(&iv_last + aiv_e * 8);
                            if (aiv_e_last < cur_first) {
                                store64(&active_iv + er * 8, 0 - 1);
                            }
                        }
                        er = er + 1;
                    }
                    # Find a free register (lowest index — deterministic)
                    var free_r = 0 - 1;
                    var fr = 0;
                    while (fr < _cur_fn_regalloc && free_r < 0) {
                        if (load64(&active_iv + fr * 8) == (0 - 1)) { free_r = fr; }
                        fr = fr + 1;
                    }
                    # Bisection cap (-1 = none; see the pick_cap note above)
                    var cap_block = 0;
                    if (pick_cap >= 0) {
                        if (picked >= pick_cap) { cap_block = 1; }
                    }
                    # v6.5.35 — O(1) lookup into the per-local map built once above,
                    # replacing a full-function byte walk PER CANDIDATE. Same two
                    # disqualifiers, same answer; see the ra_unsafe note for why the walk
                    # became unaffordable the moment the lifetime cap was lifted.
                    var ps_safe = 1;
                    if (cap_block == 0) {
                        if (cur_lidx >= 0) {
                            if (cur_lidx < 256) {
                                if (load8(&ra_unsafe + cur_lidx) == 1) { ps_safe = 0; }
                            } else { ps_safe = 0; }
                        }
                    }
                    if (cap_block == 0 && ps_safe == 1) {
                        if (free_r != (0 - 1)) {
                            store64(&active_iv + free_r * 8, pi);
                            store64(&iv_assigned + pi * 8, free_r);
                            if (free_r + 1 > _ra_used_n) { _ra_used_n = free_r + 1; }   # v6.3.29 frame-trim
                            picked = picked + 1;
                        } else {
                            # Spill heuristic: pick active reg whose interval
                            # has FURTHEST last_cp. Tie-break: lowest reg.
                            var spill_r = 0;
                            var spill_last = load64(&iv_last + load64(&active_iv) * 8);
                            var sr = 1;
                            while (sr < _cur_fn_regalloc) {
                                var siv = load64(&active_iv + sr * 8);
                                var siv_last = load64(&iv_last + siv * 8);
                                if (siv_last > spill_last) {
                                    spill_r = sr;
                                    spill_last = siv_last;
                                }
                                sr = sr + 1;
                            }
                            if (spill_last > cur_last) {
                                # Evict the active one, give the reg to cur.
                                var prev_pi = load64(&active_iv + spill_r * 8);
                                store64(&iv_assigned + prev_pi * 8, 0 - 1);
                                store64(&active_iv + spill_r * 8, pi);
                                store64(&iv_assigned + pi * 8, spill_r);
                                if (spill_r + 1 > _ra_used_n) { _ra_used_n = spill_r + 1; }   # v6.3.29 frame-trim
                                # picked count stays — net zero (one in, one out).
                            }
                            # else: cur spills, iv_assigned[pi] stays -1.
                        }
                    }
                    pi = pi + 1;
                }
                # Patch pass: time-sliced rewrite. For each interval with
                # assigned reg, rewrite disp32 matches ONLY within [first, last]
                # (inclusive of last's 7-byte instruction).
                var ra_ai = 0;
                while (ra_ai < iv_n) {
                    var ai_reg = load64(&iv_assigned + ra_ai * 8);
                    if (ai_reg < 0) { ra_ai = ra_ai + 1; continue; }
                    var ra_local = load64(&iv_lidx + ra_ai * 8);
                    var ai_first = load64(&iv_first + ra_ai * 8);
                    var ai_last = load64(&iv_last + ra_ai * 8);
                    var hot_disp = 0 - ((ra_local + 1 + _cur_fn_regalloc) * 8) - _cur_fn_ret_stash;   # v6.4.31: include retptr stash
                    var hot_disp32 = hot_disp & 0xFFFFFFFF;
                    var lb0 = load8(&ra_load_b0 + ai_reg);
                    var lb1 = load8(&ra_load_b1 + ai_reg);
                    var lb2 = load8(&ra_load_b2 + ai_reg);
                    var sb0 = load8(&ra_store_b0 + ai_reg);
                    var sb1 = load8(&ra_store_b1 + ai_reg);
                    var sb2 = load8(&ra_store_b2 + ai_reg);
                    # Walk codebuf within interval bounds. Upper bound is
                    # ai_last (start of last instruction) + 6 (so the 7-byte
                    # mov fits within ra_end for the load8/load32 reads).
                    var ra_p = ai_first;
                    var ra_p_max = ai_last + 7;
                    if (ra_p_max > ra_end) { ra_p_max = ra_end; }
                    while (ra_p + 7 <= ra_p_max) {
                        # Rewrites exactly the forms the use scan counted — the shared predicate
                        # (same `0x48` fast reject as the use scan).
                        var op1 = 0;
                        if (load8(_codebuf_base + ra_p) == 0x48) { op1 = _ra_plain_slot_mov(ra_p); }
                        if (op1 != 0) {
                            if (load32(_codebuf_base + ra_p + 3) == hot_disp32) {
                                if (op1 == 0x8B) {
                                    # mov rax,[rbp+disp] → mov rax,REG; 4-byte NOP
                                    store8(_codebuf_base + ra_p + 0, lb0);
                                    store8(_codebuf_base + ra_p + 1, lb1);
                                    store8(_codebuf_base + ra_p + 2, lb2);
                                    store8(_codebuf_base + ra_p + 3, 0x0F);
                                    store8(_codebuf_base + ra_p + 4, 0x1F);
                                    store8(_codebuf_base + ra_p + 5, 0x40);
                                    store8(_codebuf_base + ra_p + 6, 0x00);
                                    # v5.6.27: record NOP run at ra_p+3, len 4
                                    var _nrc_l = L64(S + 0x1A2008);
                                    if (_nrc_l < 1024) {
                                        S64(S + 0x1A2010 + _nrc_l * 16, ra_p + 3);
                                        S64(S + 0x1A2010 + _nrc_l * 16 + 8, 4);
                                        S64(S + 0x1A2008, _nrc_l + 1);
                                    }
                                }
                                if (op1 == 0x89) {
                                    # mov [rbp+disp],rax → mov REG,rax; 4-byte NOP
                                    store8(_codebuf_base + ra_p + 0, sb0);
                                    store8(_codebuf_base + ra_p + 1, sb1);
                                    store8(_codebuf_base + ra_p + 2, sb2);
                                    store8(_codebuf_base + ra_p + 3, 0x0F);
                                    store8(_codebuf_base + ra_p + 4, 0x1F);
                                    store8(_codebuf_base + ra_p + 5, 0x40);
                                    store8(_codebuf_base + ra_p + 6, 0x00);
                                    # v5.6.27: record NOP run at ra_p+3, len 4
                                    var _nrc_s = L64(S + 0x1A2008);
                                    if (_nrc_s < 1024) {
                                        S64(S + 0x1A2010 + _nrc_s * 16, ra_p + 3);
                                        S64(S + 0x1A2010 + _nrc_s * 16 + 8, 4);
                                        S64(S + 0x1A2008, _nrc_s + 1);
                                    }
                                }
                            } }
                        ra_p = ra_p + 1;
                    }
                    ra_ai = ra_ai + 1;
                }
            }
        }
    }
    # v5.6.27: codebuf compaction (NOP harvest with jump+fixup repair).
    # Per-fn pass after picker. Walks the per-fn nop_run_tbl (populated
    # by picker patches above), updates every disp32 in the per-fn
    # jump_src_tbl (EJCC/EJMP/EJMP0/ECALLTO recorded their CPs at
    # emit time), shifts every fixup-table CP added during this fn,
    # shifts every jump-target table entry, then compacts bytes
    # in-place by skipping NOP runs.
    #
    # Gates: x86 only (`bp_x86` — NOT `_AARCH64_BACKEND == 0`, which is true on cx too; see
    # the DSE/LASE gate above); non-shared/non-object kmode (rip-rel disp32
    # untracked); no overflow on jump_src_tbl or nop_run_tbl;
    # IR_ENABLED == 0 (DSE/LASE NOPs at IR=3 not tracked).
    #
    # `bp_x86` is also what keeps `_ra_frame_trim` off cx: it is the last x86 byte-pattern
    # scanner in this function (an unaligned walk for `48/4C 89|8B <modrm> <disp8>` save/restore
    # quads), its own `_ra_used_n >= _cur_fn_regalloc` guard does NOT fire there — the picker
    # never ran, so `_ra_used_n` is 0 — and a chance match would record a NOP run the compactor
    # below then deletes from the bytecode. Gating the call site is the whole fix; the trim
    # keeps no `_TARGET_CX` test of its own. CHANGELOG [6.6.5]
    if (bp_x86 == 1) {
        var _kmode = L64(S + 0x18FCA0);
        if (_kmode <= 1) {
            # v6.5.54 — was `IR_ENABLED(S) == 0`, which disabled NOP harvesting for every IR
            # mode. MEASURED cost on a cycc self-compile: CYRIUS_IR=3 carried 19,067 NOP
            # instructions against the default path's 44 (+65,320 bytes of .text, +6.2 %, and
            # 670 -> 694 ms), and 10,748 of those were REGALLOC/frame-trim NOPs this very pass
            # would have collected. The blocker was stale IR node CPs, now repaired by stage 3c.
            if (1 == 1) {
                # v6.3.29: append dead callee-saved save/restore nop_runs BEFORE reading
                # _nrn, so the compactor below harvests them (same jump/fixup repair as
                # the regalloc picker's runs). Off by default → byte-identical.
                if (_FRAMETRIM_OK == 1) { _ra_frame_trim(S, fn_start, fi); }
                var _nrn = L64(S + 0x1A2008);
                var _jsn = L64(S + 0x1A0000);
                # v6.5.20: `_swn <= 256` is the switch-table overflow gate. PARSE_SWITCH
                # keeps counting past the 256-record cap, so an over-full fn fails this
                # test and skips compaction entirely — correct code, just unoptimised.
                # Dropping the pass is the ONLY safe response: compacting with an
                # unrecorded table is the miscompile this stage exists to prevent.
                #
                # ⚠ IT IS UNREACHABLE TODAY — kept as a cap-coupling guard, not as a
                # live limit, and it must not be quoted as one. A table switch costs 5
                # jump targets, so the x86 LASE cap in backend/x86/jump.cyr bites first:
                # measured on this build, 204 table switches in one fn compile and 205
                # give `error: function exceeds 1023 jump targets`. 204 < 256, so `_swn`
                # cannot reach 257. The test earns its place only because the two caps
                # live in different modules — raise the LASE cap without resizing the
                # 4096-byte sw_tbl region (main.cyr heap map) and this becomes the thing
                # standing between that change and a silent miscompile.
                var _swn = L64(S + 0x1AC800);
                if (_nrn > 0 && _nrn < 1024 && _jsn < 1024 && _swn <= 256) {
                    # Stage 1: update intra-fn jump disp32s.
                    # For each tracked source CP: decode disp32, compute
                    # target, recompute new disp using shift_at(src) and
                    # shift_at(tgt). shift_at(p) = sum of nop lens where
                    # nop_cp < p (linear scan; runs are emit-order which
                    # may not be CP-sorted, so check all).
                    var _ji = 0;
                    while (_ji < _jsn) {
                        var _src_cp = L64(S + 0x1A0008 + _ji * 8);
                        var _da = _codebuf_base + _src_cp;
                        var _disp = load8(_da) | (load8(_da + 1) << 8) | (load8(_da + 2) << 16) | (load8(_da + 3) << 24);
                        if (_disp >= 0x80000000) { _disp = _disp - 0x100000000; }
                        var _tgt_cp = _src_cp + 4 + _disp;
                        var _ssh = 0;
                        var _tsh = 0;
                        var _ni = 0;
                        while (_ni < _nrn) {
                            var _ncp = L64(S + 0x1A2010 + _ni * 16);
                            var _nlen = L64(S + 0x1A2010 + _ni * 16 + 8);
                            if (_ncp < _src_cp) { _ssh = _ssh + _nlen; }
                            if (_ncp < _tgt_cp) { _tsh = _tsh + _nlen; }
                            _ni = _ni + 1;
                        }
                        var _nd = _disp - _tsh + _ssh;
                        store8(_da + 0, _nd & 0xFF);
                        store8(_da + 1, (_nd >> 8) & 0xFF);
                        store8(_da + 2, (_nd >> 16) & 0xFF);
                        store8(_da + 3, (_nd >> 24) & 0xFF);
                        _ji = _ji + 1;
                    }
                    # Stage 2: shift fixup-table CPs added during this fn.
                    # FIXUP later patches via these CPs — they must reflect
                    # post-compaction positions.
                    # ⛔ 6.6.17: not `_fi` — until cybs's lexer arm for `_` (6.6.17), cybs (the
                    # seed-built bootstrap compiler) dropped the leading `_`s of EVERY name, so
                    # `_fi` WAS this fn's `fi` in gen1: the fn-end record went to the wrong slot,
                    # harmless until the fn table grew past 2048 (`_fnt_codeend` then overran
                    # into `_fnt_structmask`).
                    var _fc0 = L64(S + 0x1A6010);
                    var _fcn = GFCNT(S);
                    var _fxi = _fc0;
                    while (_fxi < _fcn) {
                        var _fa = _fixup_base + _fxi * 16;
                        var _fcp = L64(_fa);
                        var _fsh = 0;
                        var _ni2 = 0;
                        while (_ni2 < _nrn) {
                            var _ncp2 = L64(S + 0x1A2010 + _ni2 * 16);
                            if (_ncp2 < _fcp) { _fsh = _fsh + L64(S + 0x1A2010 + _ni2 * 16 + 8); }
                            _ni2 = _ni2 + 1;
                        }
                        S64(_fa, _fcp - _fsh);
                        _fxi = _fxi + 1;
                    }
                    # Stage 3: shift jump-target table entries (used by LASE
                    # / BB analysis at IR>0; harmless to update at IR=0).
                    var _jtc = L64(S + 0x19E000);
                    # AR-03 (v6.1.38): clamp to 1023 valid slots (the 1024 sentinel
                    # from EJMP's overflow path would shift jump_src_cnt at 0x1A0000).
                    if (_jtc > 1023) { _jtc = 1023; }
                    var _jti = 0;
                    while (_jti < _jtc) {
                        var _jta = S + 0x19E008 + _jti * 8;
                        var _jcp = L64(_jta);
                        var _jsh = 0;
                        var _ni3 = 0;
                        while (_ni3 < _nrn) {
                            var _ncp3 = L64(S + 0x1A2010 + _ni3 * 16);
                            if (_ncp3 < _jcp) { _jsh = _jsh + L64(S + 0x1A2010 + _ni3 * 16 + 8); }
                            _ni3 = _ni3 + 1;
                        }
                        S64(_jta, _jcp - _jsh);
                        _jti = _jti + 1;
                    }
                    # Stage 3b (v6.5.20): repair switch jump-table entries. MUST run
                    # before stage 4 — it reads pre-compaction CPs like stages 1-3.
                    _sw_tbl_repair(S, _nrn, _swn);
                    # Stage 3d (v6.5.68): the whole-program registries hold PRE-compaction
                    # CPs for this function's segment, and this pass is about to move those
                    # bytes. ⛔ WITHOUT THIS the post-parse pass reads positions that were
                    # already stale by up to a few hundred bytes per function, and repairs
                    # the wrong instructions — a silent miscompile whose magnitude grows with
                    # the program. Only THIS function's segment needs it: earlier functions'
                    # entries are below every run here (`_nop_shift_at` returns 0) and later
                    # ones do not exist yet, which is the same argument stage 3c makes for
                    # IR node CPs. CHANGELOG [6.5.68]
                    var _wpi = _wp_fn_js0;
                    while (_wpi < _wpjs_n) {
                        var _wpc = L64(_wpjs_base + _wpi * 8);
                        S64(_wpjs_base + _wpi * 8, _wpc - _nop_shift_at(S, _nrn, _wpc));
                        _wpi = _wpi + 1;
                    }
                    var _wsi = _wp_fn_sw0;
                    while (_wsi < _wpsw_n) {
                        var _wsc = L64(_wpsw_base + _wsi * 16);
                        S64(_wpsw_base + _wsi * 16, _wsc - _nop_shift_at(S, _nrn, _wsc));
                        _wsi = _wsi + 1;
                    }
                    # Stage 3c (v6.5.54): repair IR node CPs. THE REASON THE COMPACTOR USED TO
                    # BE DISABLED UNDER IR MODE. The IR records a code position per node; this
                    # pass deletes bytes, so every recorded CP above a deleted run is stale, and
                    # the IR fixpoint (main.cyr, after ALL parsing) would then read and rewrite
                    # code at the wrong offsets — measured: lifting the gate without this makes
                    # the IR=3-built cycc die with `alloc_init: mmap failed`.
                    # ⚠ Shifting EVERY node is correct even though this pass is per-fn: nodes
                    # from earlier fns have CPs below every run in `nop_run_tbl`, so
                    # `_nop_shift_at` returns 0 for them, and later fns have not been emitted.
                    if (IR_ENABLED(S) != 0) {
                        var _irn = IR_NCNT(S);
                        var _iri = IR_CLO();
                        while (_iri < _irn) {
                            var _ircp = IR_NODE_CP(S, _iri);
                            IR_SNODE_CP(S, _iri, _ircp - _nop_shift_at(S, _nrn, _ircp));
                            _iri = _iri + 1;
                        }
                        IR_SCLO(_irn);
                    }
                    # Stage 4: compact bytes. Sort NOP runs by CP first
                    # (insertion sort; nrn ≤ 1024). Picker emit order isn't
                    # strictly CP-monotone (multiple intervals patched in
                    # interval order, not emit order).
                    var _si = 1;
                    while (_si < _nrn) {
                        var _kcp = L64(S + 0x1A2010 + _si * 16);
                        var _klen = L64(S + 0x1A2010 + _si * 16 + 8);
                        var _sj = _si - 1;
                        var _sd = 0;
                        while (_sj >= 0 && _sd == 0) {
                            var _pcp = L64(S + 0x1A2010 + _sj * 16);
                            if (_pcp > _kcp) {
                                S64(S + 0x1A2010 + (_sj + 1) * 16, _pcp);
                                S64(S + 0x1A2010 + (_sj + 1) * 16 + 8, L64(S + 0x1A2010 + _sj * 16 + 8));
                                _sj = _sj - 1;
                            } else { _sd = 1; }
                        }
                        S64(S + 0x1A2010 + (_sj + 1) * 16, _kcp);
                        S64(S + 0x1A2010 + (_sj + 1) * 16 + 8, _klen);
                        _si = _si + 1;
                    }
                    # Now compact: walk fn_start..GCP, skip NOP-run bytes,
                    # copy non-NOP bytes back to write-pointer.
                    var _end = GCP(S);
                    var _wp = fn_start;
                    var _rp = fn_start;
                    var _ri = 0;
                    while (_rp < _end) {
                        var _skip = 0;
                        if (_ri < _nrn) {
                            var _nrcp = L64(S + 0x1A2010 + _ri * 16);
                            if (_rp == _nrcp) {
                                _rp = _rp + L64(S + 0x1A2010 + _ri * 16 + 8);
                                _ri = _ri + 1;
                                _skip = 1;
                            }
                        }
                        if (_skip == 0) {
                            store8(_codebuf_base + _wp, load8(_codebuf_base + _rp));
                            _wp = _wp + 1;
                            _rp = _rp + 1;
                        }
                    }
                    SCP(S, _wp);
                    # Invalidate emit-tracker globals — their CPs are stale.
                    _last_push_cp = 0 - 1;
                    _last_emovca_cp = 0 - 1;
                    _last_movca_popr_cp = 0 - 1;
                }
            }
        }
    }
    # Patch frame size
    var flc = GFLC(S);
    # v6.3.37 (A3) — cover the inline-replay path's transient param-slot peak so a
    # live runtime `push` can't alias it (inert on default builds — _flc_hwm stays 0).
    if (_flc_hwm > flc) { flc = _flc_hwm; }
    # v4.8.4-alpha6: #regalloc fns reserve an extra 8-byte slot at
    # [rbp-8] for the saved rbx. Bumping flc by 1 pre-rounding keeps
    # the 16-byte alignment formula valid — call-site rsp stays 16-
    # aligned for SSE-safe callees.
    if (_cur_fn_regalloc > 0) { flc = flc + _cur_fn_regalloc; }
    # v5.5.36 Phase 2b — struct-returning fns reserve one extra
    # 8-byte slot for the hidden retptr stash (between regalloc
    # saves and regular locals).
    if (_cur_fn_ret_stash > 0) { flc = flc + 1; }
    var fsz = (flc * 8 + 15) & (0 - 16);
    # v6.2.27: #naked emitted no ESUBRSP (frame_patch stayed 0) → nothing to patch.
    if (_cur_fn_naked == 0) { EPATCHFRAME(S, frame_patch, fsz); }
    # Record fn code end (v4.4.0 DCE) — this is GCP after epilogue + LASE + frame patch.
    # Paired with fn_start at 0x1C4000[fi], the [start, end) range bounds the emitted
    # body bytes for this fn, usable by the FIXUP pass to NOP dead functions safely.
    SFNE(S, fi, GCP(S));
    # Restore state (DON'T restore VCNT — arrays inside functions are globals that persist)
    # 6.6.5: their NAMES do not persist though — close every fn-local static declared in this
    # body so it cannot shadow a later file's global. See `_fs_push` (parse.cyr).
    _fs_popto(S, _fs_floor);
    _fs_floor = _fs_saved_floor;
    SLVAR(S, saved_lv);
    SINFN(S, 0);
    # v4.8.4-alpha5: clear #regalloc mirror so nested/sibling fns without
    # the directive don't inherit it.
    _cur_fn_regalloc = 0;
    _cur_fn_naked = 0;   # v6.2.27: reset #naked for the next fn
    # v5.5.36 Phase 2b — same for the ret-stash flag + sid mirror.
    _cur_fn_ret_stash = 0;
    _cur_fn_ret_sid = 0;
    # v5.10.45 Phase 1 — clear pair-return flag.
    _cur_fn_ret_pair = 0;
    _cur_fn_pslots = 0;   # 6.6.6 — parameter slot span (see _local_is_sptr_param)
    _cur_fn_ptrp = 0;
    # v5.8.20 — same for the #pure mirror.
    _cur_fn_is_pure = 0;
    # v5.11.62 — clear per-fn array-byte attribution tracker so top-level
    # `var foo[N]` declarations between fn defs don't get attributed to
    # the previous fn.
    _cur_fn_ix = 0 - 1;
    # v6.3.11 (G): async fn — the body emitted above as `f$impl` (fi). Now synthesize
    # the user-named Future constructor `f`, which bundles the args + &f$impl into a
    # heap Future and returns it. pc is the body's recorded param count.
    if (_is_async == 1) {
        _async_emit_constructor(S, _async_noff_f, fi, L64(_fnt_params + fi * 8));
        _coro_was = 0;   # v6.5.69: per-fn, consumed by the constructor above
    }
    return 0;
}
