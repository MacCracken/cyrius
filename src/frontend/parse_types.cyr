        if (TOKTYP(S, o - 1) == 32) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a `*fn(..)` parameter - pass a record that holds one"); }
        if (TOKTYP(S, o - 1) == 49) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a tuple or multi-value element - return or hold it alone"); }
    }
