# 1 = trait member `k` is callable through a dyn — a slot: not generic, and its first parameter an
# untyped `self` and no `...`. (Calling another member through a dyn is refused at the call.)
fn _dyn_slot_ok(S, k): i64 {
    var tp = L64(_trm_ft + k * 8);
    if (TOKTYP(S, tp + 2) == 19) { return 0; }
    var o = _tr_paren(S, tp);
    if (o < 0) { return 0; }
    if (TOKTYP(S, o + 1) != 2) { return 0; }
    if (_noff_is(S, TOKVAL(S, o + 1), "self", 4) == 0) { return 0; }
    if (TOKTYP(S, o + 2) == 49) { return 0; }
    var j = 1;
    while (_dps_param(S, o, j) == 1) {
