fn _dyn_sform(S, sid): i64 { return _dyn_tset(S, L64(S + 0x1A6018 + (sid - 1) * 8)); }
# One name: a local, a closure's capture, a global.
fn _dyn_src_name(S, a): i64 {
    var nm = TOKVAL(S, a);
