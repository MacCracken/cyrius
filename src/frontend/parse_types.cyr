# PARSER — types, structs, enums, unions + shared helpers
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38 to keep single-file
# LOC under ~1500. Included by parse.cyr at the same textual position
# the original content lived, so the flattened fn-definition order is
# preserved (self-host byte-identical by construction). No logical
# change from the original inline version.

# ================================================================
# STRUCT SUPPORT
# ================================================================
# Heap layout for structs — see src/main.cyr for the authoritative map.
# Quick reference of the regions this file touches:
#   0x13A000 var_types[8192]      65536 bytes — struct_id per var (0=scalar)
#   0x1A6018  struct_names[1024]   8192 bytes — name offset per struct (cap 1024 since v6.0.47)
#   0x1A8018  struct_fcounts[1024] 8192 bytes — field count per struct (bit 63 = union; v6.0.47)
#   0x91A000 struct_ftypes        65536 bytes — PACKED field-type pool (v6.0.47): 8192 entries × 8B, addr=(field_base[si]+fc)*8. ftype: >0 sid / 0 i64 / <0 -width / far-neg = Vec<T> handle sentinel (v6.4.x, MKVEC)
#   0x92A000 struct_fnames        65536 bytes — PACKED field-name pool (v6.0.47): 8192 entries × 8B, same indexing
#   0x18F830  struct_count         8 bytes
#   0x1D8000  enum_const_val[65536] 65536 bytes — RAW enum value per var slot (v5.5.2); a grown var-family table (_vecv_base, _grow_g5), presence in the GVECP byte map (util.cyr)

fn GSTC(S): i64 { return L64(S + 0x18F830); }
fn SSTC(S, v): i64 { S64(S + 0x18F830, v); return 0; }

# R3 (v6.4.15): the pure i8/i16/i32/i64 type-name -> byte-width ladder, hand-
# duplicated across 6 shape-A sites (struct/union field + Vec element, #assert
# sizeof, expression sizeof). Returns 1/2/4/8, else 0. The four masks are
# mutually exclusive (distinct name bytes) so if/return == the former if/elif
# chain. Narrow slice only — the complex annotation ladders (unsigned/f64/f32/
# u128/SIMD-order-sensitive) in parse_decl.cyr keep their inline form.
fn _scalar_name_width(name64): i64 {
    if (name64 & 0xFFFF == 0x3869) { return 1; }
    if (name64 & 0xFFFFFF == 0x363169) { return 2; }
    if (name64 & 0xFFFFFF == 0x323369) { return 4; }
    if (name64 & 0xFFFFFF == 0x343669) { return 8; }
    return 0;
}

# 6.6.10 — the same ladder for a FIELD type, which must match the WHOLE name. The masks above
# test only the leading bytes, so `v: i16v8` registered a 2-byte i16 field and `v: i64v2` an
# 8-byte one, silently; a vector (or `i8foo`) now falls through to the named-type path, where
# it is refused by name. Since 6.6.16 every other site resolves through _tn_resolve below.
# CHANGELOG [6.6.10]
fn _field_scalar_width(name64): i64 {
    var w = _scalar_name_width(name64);
    if (w == 1) { if ((name64 >> 16) & 0xFF != 0) { return 0; } }
    if (w > 1) { if ((name64 >> 24) & 0xFF != 0) { return 0; } }
    return w;
}

# ⛔ 6.6.16 (C8) — ONE TYPE-NAME VOCABULARY. sizeof, `#assert sizeof` and every annotation
# (a local, a global, `*T`, `[T]` / `slice<T>`, a param, a return, a multi-value return element)
# had a ladder of its own. Most matched a name's PREFIX — `var a: i8x = 300` was an i8 (it read
# 44), `var a: f64zz` an f64, and `var p: u8pair;` (a struct) was a u8 scalar BEFORE the struct
# lookup ran — and almost all read a name they did not know as a silent i64 (`var a: Nonexist`,
# `fn f(a: i16q)`, `fn f(): (i64, Nope)`). sizeof knew only i8..i64, u128 and structs, so
# `sizeof(f64)` / `sizeof(u8)` / `sizeof(bool)` did not compile. Every one of those sites now
# resolves here, by the WHOLE name, and a name that is no type is refused by name (_tn_refuse).
# The struct lookup goes FIRST, as _classify_return_type's always has. CHANGELOG [6.6.16]
#
# THE CODE BAND. A resolved name is one value in a band of its own, `0x7E000000 | class << 16 |
# val`, that no table stores and no other encoding uses: it is not a struct sid (1..1024) nor
# `0 - sid` (GLTYPE, pscale, GVTYPE's pointer scale), not a width (SLTYPE 1/2/4/8, `0 - width`
# from _tp_resolve / scalar_type), not the F64_TYID..FUTURE_TYID band (0x40000001..4), not the
# SIMD descriptor band (<= -2048), not MULTIRET_SID (-40) and not the `0 - 1000 - gvi`
# global-deref band. A caller reads a code ONLY through the accessors below (_tn_iw, _tn_sgn,
# _tn_flt, _tn_sid, _tn_vec, _tn_bytes) and stores what it always stored — a width, a sid, a
# sentinel, a float tag — so no code ever reaches SLTYPE, SVTYPE, GFRS/GFRT, SPSC, pscale,
# scalar_type or a global's init blob, and one that leaked could not be read as any of them.
#   class 1  signed integer     i8 i16 i32 i64           val = its bytes
#   class 2  unsigned integer   u8 u16 u32 u64           val = its bytes
#   class 3  float              f32 f64                  val = its bytes
#   class 4  an 8-byte handle   val: 1 bool, 2 an enum, 3 Result, 4 Option, 5 Tagged, 6 cstring,
#                               7 a type parameter, 8 Vec (a vec_new() handle; the `<T>` of
#                               `Vec<T>` is skipped by each site, as it always was)
#   class 5  a SIMD vector      val = 0 - its descriptor sentinel (f64v2 2093, i8v16 2178, ...)
#   class 6  a struct or union  val = its sid
# `u128` is a keyword token, never a name: its sites handle token 105 before the lookup.
fn _tn_code(cls, val): i64 { return 0x7E000000 | (cls << 16) | val; }
fn _tn_class(c): i64 {
    if ((c >> 24) != 0x7E) { return 0; }
    return (c >> 16) & 0xFF;
}
fn _tn_val(c): i64 { return c & 0xFFFF; }

# The builtin scalar names, each matched WHOLE (the NUL is in the mask). 0 = not one of them.
fn _tn_scalar(n): i64 {
    if ((n & 0xFFFFFF) == 0x003869) { return _tn_code(1, 1); }      # i8
    if ((n & 0xFFFFFF) == 0x003875) { return _tn_code(2, 1); }      # u8
    var lo = n & 0xFFFFFFFF;
    if (lo == 0x00363169) { return _tn_code(1, 2); }                # i16
    if (lo == 0x00323369) { return _tn_code(1, 4); }                # i32
    if (lo == 0x00343669) { return _tn_code(1, 8); }                # i64
    if (lo == 0x00363175) { return _tn_code(2, 2); }                # u16
    if (lo == 0x00323375) { return _tn_code(2, 4); }                # u32
    if (lo == 0x00343675) { return _tn_code(2, 8); }                # u64
    if (lo == 0x00343666) { return _tn_code(3, 8); }                # f64
    if (lo == 0x00323366) { return _tn_code(3, 4); }                # f32
    if ((n & 0xFFFFFFFFFF) == 0x006C6F6F62) { return _tn_code(4, 1); }   # bool
    if (lo == 0x00636556) { return _tn_code(4, 8); }                # Vec — the field vocabulary's handle
    return 0;
}

# A _classify_return_type value (also a bound type parameter's _tp_resolve value) as a code.
fn _tn_from_rc(rc): i64 {
    if (rc > 0) { return _tn_code(6, rc); }
    if (rc <= 0 - 2048) { return _tn_code(5, 0 - rc); }
    if (rc == 0 - 9) { return _tn_code(3, 8); }                     # f64
    if (rc >= 0 - 8) { if (rc < 0) { return _tn_code(1, 0 - rc); } }   # i8 / i16 / i32 / i64
    if (rc <= 0 - 16) { if (rc >= 0 - 19) { return _tn_code(4, 0 - rc - 13); } }   # Result Option Tagged cstring
    return 0;
}

# The name at `noff`, with no scope: a struct or union (first), a builtin scalar, Result / Option /
# Tagged / cstring, a vector, or an enum declared on either side (its values are i64). 0 = none.
fn _tn_resolve(S, noff): i64 {
    var c = _tn_from_rc(_classify_return_type(S, noff));
    if (c != 0) { return c; }
    c = _tn_scalar(L64(S + 0xEC00000 + noff));
    if (c != 0) { return c; }
    if (_is_enum_name(S, noff) == 1) { return _tn_code(4, 2); }
    if (_declared_later(S, noff, 60, 60) == 1) { return _tn_code(4, 2); }
    return 0;
}

# The name at token `ti`, in scope: _tn_resolve, else a type parameter in scope there (8 bytes,
# the i64 base): a bound one, the declaring struct's own, the enclosing generic fn's (its body or
# its signature — CYRIUS_MONOMORPH=0 binds and captures nothing, so these read the tokens).
fn _tn_resolve_at(S, ti): i64 {
    var noff = TOKVAL(S, ti);
    if (_tp_resolve(S, noff) != 0) { return _tn_code(4, 7); }   # bound: callers that size it bind first
    var c = _tn_resolve(S, noff);
    if (c != 0) { return c; }
    if (_tn_tparam(S, ti, noff) == 1) { return _tn_code(4, 7); }
    return 0;
}
fn _tn_tparam(S, ti, noff): i64 {
    if (_is_own_tparam(S, noff) == 1) { return 1; }
    if (_arr_fn_tparam(S, ti, noff) == 1) { return 1; }
    return _tn_sig_tparam(S, ti, noff);
}
# Is `noff` (at token `ti`, in a fn SIGNATURE — a param or return type) one of that fn's own
# `<T, ..>`? The signature holds no `{`, `}` or `;`, so meeting one means `ti` is not in one.
fn _tn_sig_tparam(S, ti, noff): i64 {
    var k = ti - 1;
    while (k >= 0) {
        var t = TOKTYP(S, k);
        if (t == 13 || t == 14 || t == 5) { return 0; }
        if (t == 32) {
            if (TOKTYP(S, k + 2) != 19) { return 0; }   # `fn name <`
            var j = k + 3;
            t = TOKTYP(S, j);
            while (t != 20 && t != 10 && t != 12) {
                if (t == 2) { if (STREQ(S, TOKVAL(S, j), noff) == 1) { return 1; } }
                j = j + 1;
                t = TOKTYP(S, j);
            }
            return 0;
        }
        k = k - 1;
    }
    return 0;
}

# The accessors — the only way a code is read.
fn _tn_iw(c): i64 {                         # an integer's width (iN / uN), else 0
    var k = _tn_class(c);
    if (k == 1 || k == 2) { return _tn_val(c); }
    return 0;
}
fn _tn_sgn(c): i64 {                        # 1 for a SIGNED sub-i64 integer (loads sign-extend)
    if (_tn_class(c) == 1) { if (_tn_val(c) < 8) { return 1; } }
    return 0;
}
fn _tn_flt(c): i64 {                        # F64_TYID / F32_TYID, else 0
    if (_tn_class(c) != 3) { return 0; }
    if (_tn_val(c) == 8) { return F64_TYID; }
    return F32_TYID;
}
fn _tn_sid(c): i64 {                        # a struct's sid, else 0
    if (_tn_class(c) == 6) { return _tn_val(c); }
    return 0;
}
fn _tn_bool(c): i64 {                       # 1 for `bool` (6.7.3), else 0
    if (_tn_class(c) == 4) { if (_tn_val(c) == 1) { return 1; } }
    return 0;
}
fn _tn_vec(c): i64 {                        # a vector's descriptor sentinel (<= -2048), else 0
    if (_tn_class(c) == 5) { return 0 - _tn_val(c); }
    return 0;
}
fn _tn_init_w(c): i64 {                     # 6.6.16 (C1): the bytes of an array element an
    var w = _tn_iw(c);                      # integer constant initializes — iN / uN its width,
    if (w > 0) { return w; }                # bool and an enum 8 — else 0 (a float, a struct, a
    if (_tn_class(c) == 4) {                # vector, a handle no constant makes)
        var v = _tn_val(c);
        if (v == 1 || v == 2) { return 8; }
    }
    return 0;
}
# sizeof: an integer or float its width; a handle (bool, an enum, cstring, Result, Option,
# Tagged, Vec, a type parameter's i64 base) 8; a vector 16 / 32; a struct STRUCTSZ. This is exactly
# what `var a: T[N]` reserves per element (_arr_ebytes), so the array is N * sizeof(T).
fn _tn_bytes(S, c): i64 {
    var k = _tn_class(c);
    if (k == 6) { return STRUCTSZ(S, _tn_val(c) - 1); }
    if (k == 5) {
        _vec_desc(S, 0 - _tn_val(c));
        return GVEC_NSLOTS(S) * 8;
    }
    if (k == 4) { return 8; }
    if (k >= 1) { return _tn_val(c); }
    return 0;
}

# The refusal: ONE named error, reported AT the name (`ti`), the cursor put back, and the panic
# latch this error set cleared — the declaration parses on as a plain i64, so each bad name is
# reported once, with no cascade, and every bad name of a file is reported. An error that already
# held the latch is left alone. `--syntax-only` (lint's pre-pass) resolves nothing and refuses
# nothing, as _arr_name_ebytes does. `tail` / `noff2` are ERR_IDENT's (the site, and a var name
# or -1). A struct or union declared BELOW a site that needs it above keeps its own message.
fn _tn_refuse(S, ti, tail, noff2): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var noff = TOKVAL(S, ti);
    var sv = GTI(S);
    STI(S, ti);
    if (_declared_later(S, noff, 40, 101) == 1) {
        ERR_IDENT(S, "type ", noff, " is declared after its use; declare it above the first use", 0 - 1);
    } else {
        ERR_IDENT(S, "unknown type ", noff, tail, noff2);
        _tn_prefix_note(S, noff);
        PRSTR("  note: a type is i8..i64, u8..u64, u128, f32, f64, bool, cstring, Result, Option, Tagged, Vec, an enum, a vector type, or a struct or union (missing include?)\n");
    }
    STI(S, sv);
    _panic = 0;
    return 0;
}
# `i8x` is not `i8`: name the builtin a misspelling starts with, since the prefix used to be enough.
fn _tn_prefix_note(S, noff): i64 {
    var n = L64(S + 0xEC00000 + noff);
    var k = 0;
    if (_tn_scalar(n & 0xFFFF) != 0) { k = 2; }
    if (_tn_scalar(n & 0xFFFFFF) != 0) { k = 3; }
    if (_tn_scalar(n & 0xFFFFFFFF) != 0) { k = 4; }
    if (k == 0) { return 0; }
    PRSTR("  note: '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("' is not '");
    syscall(SYS_WRITE, 2, S + 0xEC00000 + noff, k);
    PRSTR("' - a type name must match whole\n");
    return 0;
}
# A generic fn's body is parsed once for its base and once per instance, so the same name would
# be refused on every pass: one byte per token (lazily allocated) reports it the first time only.
var _tn_seen = 0;
var _tn_seen_n = 0;
fn _tn_once(S, ti): i64 {
    if (_tn_seen == 0) {
        _tn_seen_n = GTCNT(S) + 1;
        _tn_seen = alloc(_tn_seen_n);
        if (_tn_seen == 0) { return 1; }
    }
    if (ti < 0 || ti >= _tn_seen_n) { return 1; }
    if (load8(_tn_seen + ti) == 1) { return 0; }
    store8(_tn_seen + ti, 1);
    return 1;
}

# A type annotation at token `ti` (a local or a global; `vnoff` the variable): its code, or 0
# after the refusal. The caller takes the width / sign / float / sid / vector through the
# accessors; a refused name leaves all of them 0, i.e. a plain i64. An ARRAY element (`T[N]`,
# the `[` next) is not refused here: _arr_name_ebytes names it as an array element.
fn _tn_ann(S, ti, vnoff): i64 {
    var c = _tn_resolve_at(S, ti);
    if (c == 0) {
        if (TOKTYP(S, ti + 1) != 28) { _tn_refuse(S, ti, " for variable ", vnoff); }
    }
    return c;
}

# A `var` annotation's code (a local, or a global after the first statement). A type parameter
# the default build BOUND (`_tp_resolve`: T -> i64 in the base, T -> its argument in an instance)
# is its argument's code, so `var y: T` / `var a: T[N]` in the `g<f64>` instance are exactly
# `var y: f64` / `var a: f64[N]` — the accessors give the width, the sign of i8/i16/i32, the
# float tag, the sid. That arm used to read the binding's raw code as a width: T = f64 (-9) made
# a 9-byte word (`T[N]` reserved 9 * N while sizeof(T) is 8) and T = i8 never sign-extended.
fn _tn_var_ann(S, ti, vnoff): i64 {
    var b = _tp_resolve(S, TOKVAL(S, ti));
    if (b != 0) { return _tn_from_rc(b); }
    return _tn_ann(S, ti, vnoff);
}

# ⛔ 6.6.17 — `p + n` ON A `*T` STEPS sizeof(T) ELEMENTS, AT EVERY SITE (the user's decision,
# 2026-10-05). The step used to depend on WHERE the pointer was declared: a local `*i8` / `*i16` /
# `*i32` stepped 1 and every other local `*T` 8 (so `*u8` stepped 8 and `*Pt` 8); a parameter 1
# whatever T (a `*f32` parameter was even an f32, so `p + 1` was a float add, and a `*Pt` one
# dispatched `Pt_add`); a closure-captured `*T` 1; a declaration-block global 8; a global after
# the first statement 1/2/4/8 by T; and `p += n` 1 everywhere. Measured across ~/Repos: no source
# declares a `*T` at all, so nothing relied on the old steps (drafts b7-measure).
# A `*T` slot stays a full 8-byte word (6.6.16 C8: a narrow SLTYPE truncated the pointer). The
# step is carried on the slot as a MARK in the slice-width table, `0 - 0x7E00 - step`, read only
# when bit 56 of the depth word says the slot is a typed pointer (SLPTRP — set here for a local,
# by `_param_record` for a parameter): the slice-width table is not reset for a parameter's slot,
# so a mark is only trusted behind that bit, which every slot gets fresh. A step-8 local keeps
# SLTYPE 8, the load path it always had. The mark rides the closure snapshot with the depth word
# (`_cl_snap_ptr_step`). CHANGELOG [6.6.17]
# `ps` is PARSE_VAR's pscale: > 0 a pointer's step; 0 or `0 - sid` / a vector descriptor for
# anything else, which is the SLTYPE as it stands.
# ⛔ 6.6.17 — a `*Struct` local takes dot syntax like a `p: *Struct` parameter (`p.val`,
# `p.next.val`, `p.m()`; it was "no struct type in scope"): its SLTYPE is `0 - sid` with no
# inline mark (`_sl_marks` clears one), so field access reads THROUGH the slot, while a value read
# stays a plain pointer word (`_load_lt`, behind the slot's bit 56) and `p = p.next` rebinds it.
# `ann` is the annotation's first token.
fn _sl_ptr_type(S, li, ps, ann): i64 {
    if (ps > 0) {
        var sid = _ptr_ann_sid(S, ann);
        if (sid > 0) { SLTYPE(S, li, 0 - sid); return 0; }
        if (ps != 8) { SLTYPE(S, li, 0); return 0; }
    }
    SLTYPE(S, li, ps);
    return 0;
}
fn _sl_marks(S, li, sgn, st, sw, ps): i64 {
    if (sgn == 1) { if (sw == 0) { SSLICE_W(S, li, 0 - st); } }
    if (ps > 0) {
        SSLICE_W(S, li, 0 - 0x7E00 - ps);
        SLAGG(S, li, 0);                 # a pointer is never an inline struct (MARK_SMALL_STRUCT)
        SLPTRP(S, li);
    }
    return 0;
}
# The struct a pointer annotation `*T` at token `ann` (its `*`) points at — T a struct or a
# generic instance, one `*` — else 0.
fn _ptr_ann_sid(S, ann): i64 {
    if (ann <= 0) { return 0; }
    if (TOKTYP(S, ann) != 8) { return 0; }
    return _ptr_tok_sid(S, ann + 1);
}
fn _ptr_tok_sid(S, ti): i64 {
    if (TOKTYP(S, ti) != 2) { return 0; }
    var sid = FINDSTRUCT(S, TOKVAL(S, ti));
    if (sid <= 0) { return 0; }
    if (TOKTYP(S, ti + 1) != 19) { return sid; }
    var sv = GTI(S);
    STI(S, ti + 1);
    var g = _gen_ann_sid(S, sid);
    STI(S, sv);
    if (g > 0) { return g; }
    return sid;
}
# A `*T` GLOBAL: its step as before (`0 - ps` in the var-type table), and T's struct, when it is
# one, in a side table — so `G.val` reads through it (`_gv_recv_sid`, `_gv_holds_addr`).
var _gv_psid = 0;
fn _gv_ptr_type(S, vi, ps, ann): i64 {
    SVTYPE(S, vi, 0 - ps);
    var sid = _ptr_ann_sid(S, ann);
    if (sid <= 0) { return 0; }
    if (_gv_psid == 0) { _gv_psid = alloc(1048576 * 8); }
    if (vi < 1048576) { S64(_gv_psid + vi * 8, sid); }
    return 0;
}
fn _gv_ptr_sid(S, vi): i64 {
    if (_gv_psid == 0) { return 0; }
    if (vi < 0) { return 0; }
    if (vi >= 1048576) { return 0; }
    return L64(_gv_psid + vi * 8);
}
# The struct a global receiver `vi` names for `.field`: a `*T` global's T, else its var type.
fn _gv_recv_sid(S, vi): i64 {
    var p = _gv_ptr_sid(S, vi);
    if (p > 0) { return p; }
    return GVTYPE(S, vi);
}
# 1 = global `vi`'s slot HOLDS the struct's address: a pointer-mode struct global, or a `*T` one.
fn _gv_holds_addr(S, vi): i64 {
    if (GVPM(S, vi) == 1) { return 1; }
    if (_gv_ptr_sid(S, vi) > 0) { return 1; }
    return 0;
}
# The step of a typed-pointer slot `li` (a local or a `p: *T` parameter), 0 when it is none.
fn _slot_ptr_step(S, li): i64 {
    if (GLPTRP(S, li) == 0) { return 0; }
    var w = GSLICE_W(S, li);
    if (w <= 0 - 0x7E01) { return 0 - w - 0x7E00; }
    return 8;
}
# The type a VALUE read of local `li` is made at (PARSE_FACTOR, `x OP= ..`): a typed pointer is a
# plain word (0) whatever its SLTYPE says — a `p: *f32` parameter's slot is typed f32 and a
# `p: *Pt` one `0 - sid` (that is what `p.x` reads through), but its VALUE is an address, so it is
# neither a float nor an operator-overloading operand. Step-8 locals keep SLTYPE 8.
fn _load_lt(S, li): i64 {
    var lt = GLTYPE(S, li);
    if (GLPTRP(S, li) == 0) { return lt; }
    if (lt == 8) { return 8; }
    return 0;
}
# An SLTYPE-0 local was just loaded: its marks — the untyped-float flag (_UFV_L) and the pointer
# step above.
fn _sl_load_marks(S, li): i64 {
    _UFV_L(S, li);
    var ps = _slot_ptr_step(S, li);
    if (ps > 0) { SPSC(S, ps); }
    if (GLBOOL(S, li) == 1) { _BX_MARK(S); }   # 6.7.3: a bool local's read is a boolean value
    return 0;
}

# The pointer annotation `*T` at token `ti` (T, the token after the `*`), resolved — an unknown T
# is refused (it was taken silently). 6.6.17: only a slice element `[*T]` / `slice<*T>` asks this
# now (whose width is a pointer's 8); every `*T` variable's step is sizeof(T), `_tn_ptr_step`.
fn _tn_ptr(S, ti, vnoff): i64 {
    if (TOKTYP(S, ti) != 2) { return 8; }
    var c = _tn_resolve_at(S, ti);
    if (c == 0) {
        _tn_refuse(S, ti, " as the target of pointer ", vnoff);
        return 8;
    }
    if (_tn_class(c) == 1) { return _tn_val(c); }
    return 8;
}

# 6.6.17 — sizeof(T) for the pointer annotation `*T` at token `ti` (T, the token after the `*`):
# the step of `p + n` on such a pointer. T is resolved as _tn_ptr resolves it: an unknown T is
# refused once (`quiet` 1, pass 1: not reported — pass 2 reads it again) and steps 8; a bound
# type parameter steps by its argument's size, an unbound one by its i64 base's 8.
fn _tn_ptr_step(S, ti, vnoff, quiet): i64 {
    if (TOKTYP(S, ti) == 105) { return 16; }      # *u128
    if (TOKTYP(S, ti) != 2) { return 8; }
    var w = 0;
    var b = _tp_resolve(S, TOKVAL(S, ti));
    if (b != 0) { w = _tn_bytes(S, _tn_from_rc(b)); }
    else {
        var c = _tn_resolve_at(S, ti);
        if (c == 0) {
            if (quiet == 0) { _tn_refuse(S, ti, " as the target of pointer ", vnoff); }
            return 8;
        }
        w = _tn_bytes(S, c);
    }
    if (w < 1) { return 8; }
    return w;
}
# ⛔ 6.6.17 — `name: *T` (a struct or union field) and `fn f(): *T` (a return type, a multi-value
# return element) did not parse — `expected identifier, got '*'` — while `var p: *T` and a
# `p: *T` parameter did. Each is an 8-byte pointer. Cursor on the first `*`: consumes the `*`s,
# T and any `<..>` after it, and returns the step of `p + n` on the value — sizeof(T), 8 for a
# pointer to a pointer — which a field load / a call result carries as its pointer scale, so
# `var q: *T = h.p;` / `= f();` is not "assigning non-pointer to typed pointer". CHANGELOG [6.6.17]
fn _ptr_annot(S, vnoff, quiet): i64 {
    var n = 0;
    while (PEEKT(S) == 8) {
        STI(S, GTI(S) + 1);
        n = n + 1;
    }
    var ps = _ptr_step_peek(S, vnoff, quiet);
    if (n > 1) { ps = 8; }
    if (PEEKT(S) == 2 || PEEKT(S) == 105) {
        STI(S, GTI(S) + 1);
        SKIP_GENERICS(S);
    } elif (quiet == 0) { ERR_EXPECT(S, 2); }
    return ps;
}
# The step of `*T` with the cursor on T, which does not move: `_tn_ptr_step`, except that a
# generic struct with arguments is its INSTANCE (`*Box<i32>` steps sizeof(Box<i32>), as `var b:
# Box<i32>` declares it — it stepped the base's size), sized as `_sizeof_type` sizes it. Pass 1
# (`quiet`) sizes an instance only when its arguments resolve already. CHANGELOG [6.6.17]
fn _ptr_step_peek(S, vnoff, quiet): i64 {
    var ti = GTI(S);
    var ps = _tn_ptr_step(S, ti, vnoff, quiet);
    if (TOKTYP(S, ti) != 2) { return ps; }
    if (TOKTYP(S, ti + 1) != 19) { return ps; }
    var sid = FINDSTRUCT(S, TOKVAL(S, ti));
    if (sid <= 0) { return ps; }
    if (quiet == 1) { if (_targs_resolvable(S, ti + 2) == 0) { return ps; } }
    STI(S, ti + 1);
    var g = _gen_ann_sid(S, sid);
    STI(S, ti);
    if (g > 0) { if (g != sid) { ps = STRUCTSZ(S, g - 1); } }
    return ps;
}
# A `name: *T` field (cursor on its `:`): an 8-byte field whose loads carry T's step.
# ⛔ 6.6.17 (review) — a pointer to a STRUCT is sized when the field is LOADED, not when it is
# declared: inside its own definition a struct has the size of the fields so far
# (`struct Node { val; next: *Node; }` stepped 8, not 16), and a struct declared further down
# (`struct A { p: *B; }`) was refused "declared after its use", so two structs could not point
# at each other. Such a field records T's token (`0 - (ti + 1)`); `_fld_ps_get` sizes it.
var _fld_ps = 0;   # per field-pool entry: the step of a `*T` field (or T's token), 0 otherwise
fn _add_ptr_field(S, si, fnoff): i64 {
    STI(S, GTI(S) + 1);                     # consume ':'
    var ps = _fld_ptr_late(S);
    if (ps == 0) { ps = _ptr_annot(S, fnoff, 0); }
    var ent = L64(S + 0x1AA018 + si * 8) + (L64(S + 0x1A8018 + si * 8) & 0x7FFFFFFFFFFFFFFF);
    var top = L64(S + 0x1AC018);
    ADDFIELD(S, si, fnoff);
    if (L64(S + 0x1AC018) == top) { return 0; }   # refused (and reported) by ADDFIELD
    if (ent >= 8192) { return 0; }
    if (_fld_ps == 0) { _fld_ps = alloc(8192 * 8); }
    S64(_fld_ps + ent * 8, ps);
    if (ps < 0) { _fld_pb_note(S, ent, si); }
    return 0;
}
# ⛔ 6.6.20 — the binding a late `*S<..>` field is re-read under. `_fld_ps_get` / `_fld_ptr_sid`
# re-read the DEFINITION's tokens at the USE site, under whatever type parameters were bound
# there: in a plain fn `struct L<T> { next: *L<T>; }`'s T was unbound — `a.next + 1` stepped the
# base L whatever the instance, and `a.next.v` was refused "unknown type 'T'" even on L<i64> —
# and in `fn k<T>` the struct's T silently took k's binding, so `a.next.w = 9` wrote with another
# instance's layout, past the end of the struct. Recorded per entry: the struct's own parameters
# (GSTP, set before its fields parse) bound as they are now — an instance's arguments, or the i64
# base's -8 for the definition itself. Any other binding is dropped (a non-generic struct's field
# names no parameter). 4 words per entry: n0, c0, n1, c1 (`_tp_bind`'s pairs). CHANGELOG [6.6.20]
var _fld_pb = 0;
fn _fld_pb_note(S, ent, si): i64 {
    if (_fld_pb == 0) { _fld_pb = alloc(8192 * 32); }
    var b = _fld_pb + ent * 32;
    var stp = GSTP(S, si);
    var n0 = stp & 0xFFFFFFFF;
    var n1 = (stp >> 32) & 0xFFFFFFFF;
    S64(b, 0); S64(b + 8, 0); S64(b + 16, 0); S64(b + 24, 0);
    if (n0 != 0) { S64(b, n0 - 1); S64(b + 8, _tp_or_base(S, n0 - 1)); }
    if (n1 != 0) { S64(b + 16, n1 - 1); S64(b + 24, _tp_or_base(S, n1 - 1)); }
    return 0;
}
fn _tp_or_base(S, noff): i64 {
    var c = _tp_resolve(S, noff);
    if (c == 0) { return 0 - 8; }
    return c;
}
# Replace the binding in force with entry `ent`'s; the caller saved it and puts it back.
fn _fld_pb_bind(S, ent): i64 {
    _tp_clear(S);
    if (_fld_pb == 0) { return 0; }
    var b = _fld_pb + ent * 32;
    _tp_n0 = L64(b); _tp_c0 = L64(b + 8); _tp_n1 = L64(b + 16); _tp_c1 = L64(b + 24);
    return 0;
}
# Cursor on the `*` of a field's `*T`: when T (one `*`) names a struct — this one, one declared
# above, or one declared below — consume the annotation and return `0 - (ti + 1)` (T's token);
# else 0, cursor untouched.
fn _fld_ptr_late(S): i64 {
    var ti = GTI(S) + 1;
    if (TOKTYP(S, ti) != 2) { return 0; }
    var noff = TOKVAL(S, ti);
    if (FINDSTRUCT(S, noff) <= 0) { if (_declared_later(S, noff, 40, 101) == 0) { return 0; } }
    STI(S, ti + 1);
    SKIP_GENERICS(S);
    return 0 - (ti + 1);
}
# The pointee struct of a `name: *T` field — T a struct, or a generic instance — else 0. 6.6.17
fn _fld_ptr_sid(S, si, fi): i64 {
    if (_fld_ps == 0) { return 0; }
    var ent = (L64(S + 0x1AA018 + si * 8) + fi) & 0x7FFFFFFFFFFFFFFF;
    if (ent >= 8192) { return 0; }
    var v = L64(_fld_ps + ent * 8);
    if (v >= 0) { return 0; }
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _fld_pb_bind(S, ent);
    var sid = _ptr_tok_sid(S, 0 - v - 1);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return sid;
}
fn _fld_ps_get(S, si, fi): i64 {
    if (_fld_ps == 0) { return 0; }
    var ent = (L64(S + 0x1AA018 + si * 8) + fi) & 0x7FFFFFFFFFFFFFFF;
    if (ent >= 8192) { return 0; }
    var v = L64(_fld_ps + ent * 8);
    if (v >= 0) { return v; }
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    _fld_pb_bind(S, ent);
    var sv = GTI(S);
    STI(S, 0 - v - 1);
    var ps = _ptr_step_peek(S, 0 - 1, 1);
    STI(S, sv);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return ps;
}
# A `fn f(): *T` return (cursor on the `*`): recorded as an i64 return plus T's step, which a
# call to it carries (`_call_ret_ps`). `quiet` 1 in pass 1 (`_prescan_fn_sig`), which only
# records it; pass 2 (PARSE_FN_DEF) refuses an unknown T and sets the fn's return scalar.
var _fn_rps = 0;   # per fn: the step of a `*T` return, 0 for any other return
var _fn_rpsid = 0; # per fn: T's struct for a `*T` return (6.6.17, `_call_ptr_field`), else 0
# ⛔ 6.6.20 — a generic INSTANCE's `: *T` is read under the instance's binding, as `_gtype_sid`
# reads `: Box<T>`: PARSE_FN_DEF binds T only around the parameter loop and the body, and the
# return type sits between them, so every instance recorded the unbound T's i64 step (8) and
# `gr<i32>(..) + 1` stepped 8. The binding in force is put back after. CHANGELOG [6.6.20]
fn _ret_ptr_annot(S, fi, quiet): i64 {
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    if (_MONOMORPH_OK == 1) { if (_inst_conc0 != 0) { if (GFTP(S, fi) != 0) {
                _bind_generic_call(S, fi, _inst_conc0, _inst_conc1);
            } } }
    _ret_ptr_record(S, fi, quiet);
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return 0;
}
fn _ret_ptr_record(S, fi, quiet): i64 {
    var psid = _ptr_ann_sid(S, GTI(S));
    if (psid > 0) {
        if (_fn_rpsid == 0) { _fn_rpsid = alloc(131072 * 8); }
        S64(_fn_rpsid + fi * 8, psid);
    }
    var ps = _ptr_annot(S, 0 - 1, quiet);
    SFRS(S, fi, 0 - 8);
    if (_fn_rps == 0) { _fn_rps = alloc(131072 * 8); }
    S64(_fn_rps + fi * 8, ps);
    if (quiet == 0) { _cur_fn_ret_scalar = 0 - 8; }
    return 0;
}
# 6.6.17: and 0 for every other callee — the result is a plain value, whatever scale the last
# argument left (`_call_scale_fix`).
fn _call_ret_ps(S, fi): i64 {
    var ps = 0;
    if (fi >= 0) { if (_fn_rps != 0) { ps = L64(_fn_rps + fi * 8); } }
    SPSC(S, ps);
    return 0;
}

# A slice element `[T]` / `slice<T>` at token `ti`: its width. A bound type parameter is its
# argument's size; a name that is no type is refused (it was 8, silently).
fn _tn_slice_w(S, ti, vnoff): i64 {
    if (TOKTYP(S, ti) == 105) { return 16; }      # u128
    if (TOKTYP(S, ti) != 2) { return 8; }
    var b = _tp_resolve(S, TOKVAL(S, ti));
    if (b != 0) { return _tn_bytes(S, _tn_from_rc(b)); }
    var c = _tn_resolve_at(S, ti);
    if (c == 0) {
        _tn_refuse(S, ti, " as the element of slice ", vnoff);
        return 8;
    }
    return _tn_bytes(S, c);
}

# sizeof(T) at token `ti` — an expression (`asrt` 0) or an `#assert` operand (1): T's bytes, or 0
# after the refusal. A bound type parameter is its argument's size (f64 is 8: it read 9).
fn _tn_sizeof(S, ti, asrt): i64 {
    if (TOKTYP(S, ti) == 105) { return 16; }      # u128
    if (TOKTYP(S, ti) != 2) { return 0; }
    var b = _tp_resolve(S, TOKVAL(S, ti));
    if (b != 0) { return _tn_bytes(S, _tn_from_rc(b)); }
    var c = _tn_resolve_at(S, ti);
    if (c != 0) { return _tn_bytes(S, c); }
    if (asrt == 0) {
        _tn_refuse(S, ti, " in sizeof", 0 - 1);
        return 0;
    }
    # An `#assert` operand: leave the latch set, as the error it replaces did — the #assert
    # handler then drops its own "#assert failed" for the operand it could not evaluate.
    _tn_refuse(S, ti, " in #assert sizeof", 0 - 1);
    _panic = 1;
    return 0;
}

# ⛔ 6.6.17 — `sizeof(T<..>)` did not parse (`expected ')', got '<'`). Cursor on T: its size, T
# and any `<..>` consumed. A generic struct with arguments is the INSTANCE `var b: Box<i32>`
# declares (`_gen_ann_sid`), so `sizeof(Box<i32>)` is what that variable occupies; any other
# `T<..>` (`Vec<i64>`, a handle) is T's own size. `asrt` as _tn_sizeof's.
fn _sizeof_type(S, asrt): i64 {
    var ti = GTI(S);
    var sz = _tn_sizeof(S, ti, asrt);
    STI(S, ti + 1);
    if (PEEKT(S) != 19) { return sz; }
    var sid = 0;
    if (TOKTYP(S, ti) == 2) { sid = FINDSTRUCT(S, TOKVAL(S, ti)); }
    var g = _gen_ann_sid(S, sid);
    if (g > 0) { if (g != sid) { sz = STRUCTSZ(S, g - 1); } }
    return sz;
}

# A parameter's type name at the cursor (PARSE_FN_DEF; `ptc` its _classify_param_type class).
# Str, cstring, Result, Option, Tagged and the vector names stay accepted BY NAME (`ptc != 0`):
# `s: Str` in a unit without lib/str.cyr is the by-name handle the param ABI has always taken.
# So is a type parameter of the fn (captured, or read from its `<..>`) and any name the resolver
# knows. Anything else is refused by name — `fn f(a: Nonexist)` / `fn f(a: i16q)` compiled with
# no ABI at all. Widths still have no effect on a param. Pass 1 (_prescan_params) reads the same
# names and reports nothing, so each is reported once.
fn _tn_param_check(S, pnoff, fi, ptc): i64 {
    if (ptc != 0) { return 0; }
    var ti = GTI(S);
    if (_tn_resolve_at(S, ti) != 0) { return 0; }
    if (_is_tparam_of(S, fi, TOKVAL(S, ti)) == 1) { return 0; }
    _tn_refuse(S, ti, " for parameter ", pnoff);
    return 0;
}

# A return type _classify_return_type does not take (cursor on it): an unknown name is
# `unknown type 'X' as a fn return type`; a type that exists but is not a return type (u8..u64,
# f32, bool, an enum) says so by name — both used to be the one unnamed "fn return type must be
# struct or ..." line, and its panic resync could cascade. The ACCEPTED set is unchanged.
# Returns the return code to record: 0 after the refusal, and -8 (an i64) under --syntax-only,
# which resolves nothing and refuses nothing (see the v6.5.19 note at the call site). Either
# way a `<..>` after the name (`fn f(): Vec<i64>`) is skipped with it — the cursor is left on its
# last token, the one the caller steps past — so its type arguments are not parsed as the body
# (a second and third error, `expected '{', got '<'` and `undefined variable 'i64'`).
fn _tn_ret_refuse(S): i64 {
    var ti = GTI(S);
    var rc = 0;
    if (_syntax_only == 1) { rc = 0 - 8; }
    else { _tn_ret_report(S, ti); }
    if (TOKTYP(S, ti + 1) != 19) { return rc; }
    STI(S, ti + 1);
    SKIP_GENERICS(S);
    STI(S, GTI(S) - 1);
    return rc;
}
fn _tn_ret_report(S, ti): i64 {
    var c = _tn_resolve_at(S, ti);
    if (c == 0) {
        _tn_refuse(S, ti, " as a fn return type", 0 - 1);
        return 0;
    }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    if (c == _tn_code(4, 7)) {
        ERR_IDENT(S, "type parameter ", TOKVAL(S, ti), " cannot be this fn's return type", 0 - 1);
        PRSTR("  note: a generic fn returns its first or second type parameter, and none under CYRIUS_MONOMORPH=0\n");
    } else {
        ERR_IDENT(S, "type ", TOKVAL(S, ti), " cannot be a fn return type", 0 - 1);
        PRSTR("  note: a return type is a struct, i8/i16/i32/i64, f64, a vector type, Result, Option, Tagged, cstring or a pointer *T; return an i64 (no annotation) for the others\n");
    }
    _panic = 0;
    return 0;
}

# A multi-value return element (`: (T1, T2)`) _classify_return_type does not take: every TYPE
# name stays accepted as a plain i64 slot (as it always was); a name that is no type is refused
# — `fn f(): (i64, Nonexist)` compiled silently. Pass 2 only (pass 1 is `quiet`).
fn _tn_mret_check(S, ti): i64 {
    if (_tn_resolve_at(S, ti) != 0) { return 0; }
    _tn_refuse(S, ti, " in a multi-value return type", 0 - 1);
    return 0;
}

# Get/set struct_id for global variable at index vi.
# v6.2.18+ math mini-arc: scalar f64/f32 reuse the var-type slot with high
# sentinel codes (distinct from struct ids, which are small positives). A var
# of these types is 8-byte-stored (the f64 bit pattern, or the f32 bits in the
# low 32) so the existing `vt>0 && size==8` value-load path applies; PEXPR /
# PARSE_TERM route operators on F64_TYID to the EMIT_F64_BINOP builtin (f32 is
# type-only — converted via f32_from/f32_to, no f32 arithmetic).
var F64_TYID = 0x40000001;
var F32_TYID = 0x40000002;
# v6.5.21 — GFRS marker for a MULTI-VALUE return signature, `fn f(): (f64, f64)`.
# The arity and element types live in GFRN / GFRT (util.cyr); this only says
# "look there". -40 sits in the gap between the scalar sentinels (-1 .. -19) and
# the SIMD descriptor band (-2092 .. -2178).
var MULTIRET_SID = 0 - 40;
# 0x40000003 was CLOSURE_TYID (v6.3.8 - v6.5.16) — RETIRED, do not reuse. A local
# holding a capturing closure was stamped with it so callptr could recognise the
# value. That only worked while the value sat in its declaring `var`, and the
# sentinel additionally leaked into SPSC as a pointer scale (`(f + 1) - f` == 2^30+3).
# v6.5.17 moved the decision to RUNTIME — bit 63 of the value itself; see ECLNORM
# in backend/x86/emit.cyr.
# v6.3.11 (G) — a value holding an async Future object `[impl_ptr, argc, args…]`
# (built by an `async fn`'s synthesized constructor). `await fut` forces it via the
# runtime's future_force. The tag is informational in v1 (await calls future_force
# on its operand directly); reserved for future await-type checking.
var FUTURE_TYID = 0x40000004;
fn GVTYPE(S, vi): i64 { return L64(_vart_base + vi * 8); }
fn SVTYPE(S, vi, v): i64 { S64(_vart_base + vi * 8, v); return 0; }
# v6.4.23: per-var signedness (1 = signed sub-i64 iN scalar global). var_size can't
# hold it (fixup.cyr SUMS it for data layout); the type table has 6 direct readers.
fn GVSGN(S, vi): i64 { return L64(_vsgn_base + vi * 8); }
fn SVSGN(S, vi, v): i64 { S64(_vsgn_base + vi * 8, v); return 0; }

# v5.7.17: dump every registered struct name to stderr. Called from
# REGSTRUCT before the cap-overflow ERR_MSG so the user sees WHICH
# structs filled the table (before the cap raise from 64, the
# diagnostic pointed at the first user-code struct line — even when
# the overflow came from auto-prepended dep dist bundles, which
# blamed the user instead of the deps. kybernet 2026-04-27 surfacing).
fn DUMP_STRUCTS(S): i64 {
    var sc = GSTC(S);
    syscall(SYS_WRITE, 2, "note: ", 6);
    PRNUM(sc);
    syscall(SYS_WRITE, 2, " structs registered (deps usually fill most via auto-prepend); names follow:\n", 77);
    var i = 0;
    while (i < sc) {
        var noff = L64(S + 0x1A6018 + i * 8);
        syscall(SYS_WRITE, 2, "  #", 3);
        PRNUM(i);
        syscall(SYS_WRITE, 2, " ", 1);
        var nlen = 0;
        while (load8(S + 0xEC00000 + noff + nlen) != 0) { nlen = nlen + 1; }
        syscall(SYS_WRITE, 2, S + 0xEC00000 + noff, nlen);
        syscall(SYS_WRITE, 2, "\n", 1);
        i = i + 1;
    }
    return 0;
}

# Register a new struct, return index (1-based, 0 = not a struct)
# 6.6.10: returns 0 when the table is full. ERR_MSG returns (multi-error, v6.4.62), so this
# cap used to fall through into the stores at index 1024+; both callers now skip the body on
# 0 (indexing with sid - 1 = -1 would write at negative indices). DUMP_STRUCTS runs on the
# FIRST overflow only — once per refused struct made the note quadratic (600,953 lines at
# 1500 structs). CHANGELOG [6.6.10]
var _regstruct_dumped = 0;
fn REGSTRUCT(S, noff): i64 {
    var sc = GSTC(S);
    if (sc >= 1024) {
        if (_regstruct_dumped == 0) { DUMP_STRUCTS(S); }
        _regstruct_dumped = 1;
        ERR_MSG(S, "too many struct definitions (max 1024)", 38);
        return 0;
    }
    S64(S + 0x1A6018 + sc * 8, noff);
    S64(S + 0x1A8018 + sc * 8, 0);
    S64(S + 0x1AA018 + sc * 8, L64(S + 0x1AC018));   # field_base[sc] = pooltop (v6.0.47 packed field pool)
    SSTC(S, sc + 1);
    return sc + 1;
}

# Find struct by name, return 1-based index or 0
fn FINDSTRUCT(S, noff): i64 {
    var sc = GSTC(S);
    var i = 0;
    while (i < sc) {
        var sn = L64(S + 0x1A6018 + i * 8);
        if (STREQ(S, sn, noff) == 1) { return i + 1; }
        i = i + 1;
    }
    return 0;
}

# Add field to struct (0-based struct index si), ftype = struct_id or 0 for scalar
# 6.6.11: a union keeps its flag in bit 63 of the count (PARSE_UNION_DEF), so the count is
# MASKED for the 256 cap, the pool entry and the pool top, and raw + 1 is stored back. Read raw,
# a union's count was negative (the cap never fired), and the flag rode `pooltop` into every
# later struct's field_base, so the signed 8192 test never tripped either. CHANGELOG [6.6.11]
fn ADDFIELD(S, si, fnoff): i64 {
    var raw = L64(S + 0x1A8018 + si * 8);
    var fc = raw & 0x7FFFFFFFFFFFFFFF;
    if (fc >= 256) { ERR_MSG(S, "too many struct fields (max 256)", 32); return 0; }   # 6.6.10: stop, don't store
    var ent = L64(S + 0x1AA018 + si * 8) + fc;   # packed pool: field_base[si] + fc
    if (ent >= 8192) { ERR_MSG(S, "struct field pool exhausted (8192 max)", 38); return 0; }
    S64(S + 0x92A000 + ent * 8, fnoff);
    S64(S + 0x91A000 + ent * 8, 0);
    S64(S + 0x1A8018 + si * 8, raw + 1);
    S64(S + 0x1AC018, ent + 1);   # pooltop = ent + 1 (sequential per-struct fill)
    return 0;
}

fn ADDFIELDTYPED(S, si, fnoff, ftype): i64 {
    var raw = L64(S + 0x1A8018 + si * 8);   # masked as in ADDFIELD (union flag, bit 63)
    var fc = raw & 0x7FFFFFFFFFFFFFFF;
    if (fc >= 256) { ERR_MSG(S, "too many struct fields (max 256)", 32); return 0; }   # 6.6.10: stop, don't store
    var ent = L64(S + 0x1AA018 + si * 8) + fc;   # packed pool: field_base[si] + fc
    if (ent >= 8192) { ERR_MSG(S, "struct field pool exhausted (8192 max)", 38); return 0; }
    S64(S + 0x92A000 + ent * 8, fnoff);
    S64(S + 0x91A000 + ent * 8, ftype);
    S64(S + 0x1A8018 + si * 8, raw + 1);
    S64(S + 0x1AC018, ent + 1);   # pooltop = ent + 1 (sequential per-struct fill)
    return 0;
}

# 6.6.10 — ADDFIELD, then record the field's float kind (1 = f64, 2 = f32; 0 records nothing).
# The entry is computed the way ADDFIELD computes it, and marked only when ADDFIELD actually
# stored (a refused field leaves the pool top where it was). See SFFK. CHANGELOG [6.6.10]
fn ADDFIELDFK(S, si, fnoff, k): i64 {
    var ent = L64(S + 0x1AA018 + si * 8) + (L64(S + 0x1A8018 + si * 8) & 0x7FFFFFFFFFFFFFFF);
    var top = L64(S + 0x1AC018);
    ADDFIELD(S, si, fnoff);
    if (k == 0) { if (_fld_bool == 0) { return 0; } }
    if (L64(S + 0x1AC018) == top) { return 0; }
    if (k == 3) { SFBOOL(S, ent, 1); return 0; }   # 6.7.3: a bool field (not a float kind)
    SFBOOL(S, ent, 0);
    if (k == 0) { return 0; }
    SFFK(S, ent, k);
    return 0;
}

fn GETFTYPE(S, si, fi): i64 {
    var b = L64(S + 0x1AA018 + si * 8);
    return L64(S + 0x91A000 + (b + fi) * 8);
}

# Get field name offset (into tok_names at S+0x60000) for struct si, field fi.
# Returns the same offset that was recorded by ADDFIELD, so direct equality
# with a parsed IDENT's PEEKV works (idents are interned by the lexer).
fn GETFNAME(S, si, fi): i64 {
    var b = L64(S + 0x1AA018 + si * 8);
    return L64(S + 0x92A000 + (b + fi) * 8);
}

# Compare two null-terminated strings in tok_names. Returns 1 if equal.
# Needed because named-field init uses the identifier buffer (S+0x60000)
# where two different source occurrences of the same name share an offset
# (dedup), but defensive equality handles the rare non-interned case too.
fn STREQTOK(S, a_off, b_off): i64 {
    if (a_off == b_off) { return 1; }
    var i = 0;
    while (1 == 1) {
        var ca = load8(S + 0xEC00000 + a_off + i);
        var cb = load8(S + 0xEC00000 + b_off + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# v5.10.7 — `: Str` field detection. A struct field whose type
# is the `Str` struct (defined in `lib/str.cyr`) is treated as
# a SINGLE 8-byte pointer slot rather than a 16-byte by-value
# inline embedding. Mirrors the v5.10.2 ≤16-byte calling-conv
# convention: Str values flow as pointers to heap-allocated
# 16-byte headers, so a Str-typed struct field is also a
# pointer slot.
#
# Pre-v5.10.7 FIELDSZ returned 16 for `: Str` fields (full
# STRUCTSZ of Str), which made PARSE_STRUCT_INIT positional
# flatten consume 2 expressions per Str field (data + len) —
# but PP_DERIVE Serialize codegen + load64-at-offset
# semantics treated Str as 1 pointer slot. The mismatch
# surfaced in the agnosys 1.1.12 follow-up: struct init like
# `var s = named_status { my_str, 42 };` errored
# `unexpected '}'` because the parser was still expecting a
# third expression for the i64 field after consuming
# `my_str`/`42` as data/len.
fn IS_STR_FIELD(S, ft): i64 {
    if (ft <= 0) { return 0; }
    var sname_off = L64(S + 0x1A6018 + (ft - 1) * 8);
    if (load8(S + 0xEC00000 + sname_off)     != 83)  { return 0; }
    if (load8(S + 0xEC00000 + sname_off + 1) != 116) { return 0; }
    if (load8(S + 0xEC00000 + sname_off + 2) != 114) { return 0; }
    if (load8(S + 0xEC00000 + sname_off + 3) != 0)   { return 0; }
    return 1;
}

# v6.4.x Pin 2 — Vec<T> array-typed struct field encoding. A Vec<T> field is
# an 8-byte pointer slot (the vec_new() handle), like a Str field, but Vec is
# not a registered struct so it cannot be name-detected. The ftype cell carries
# a far-negative sentinel: MKVEC(elem) = -0x50000 - elem, where `elem` is the
# element type in the normal field-type encoding (>0 struct sid, 0 = i64/f64,
# <0 = -width scalar). IS_VEC_FIELD tests the sentinel window BEFORE any ft>0 /
# ft<0 decode (the -2121-class OOB guard); the element type is `(0 - 0x50000) - ft`.
# The window (-0x80000, -0x40000] is disjoint from every real field ftype
# (0, sids 1..1024, -1/-2/-4 widths).
fn MKVEC(S, elem): i64 {
    return (0 - 0x50000) - elem;
}
fn IS_VEC_FIELD(S, ft): i64 {
    if (ft <= (0 - 0x40000)) {
        if (ft > (0 - 0x80000)) { return 1; }
    }
    return 0;
}

# Get byte size of a single field from its type encoding
# >0 = nested struct ID, 0 = untyped (8), <0 = sized scalar (-width)
# v5.10.7 — Str field special-case: 8 bytes (pointer slot).
# v6.4.x — Vec<T> field special-case: 8 bytes (pointer slot), guarded FIRST.
fn FIELDSZ(S, ft): i64 {
    if (IS_VEC_FIELD(S, ft) == 1) { return 8; }
    if (ft > 0) {
        if (IS_STR_FIELD(S, ft) == 1) { return 8; }
        return STRUCTSZ(S, ft - 1);
    }
    if (ft < 0) { return 0 - ft; }
    return 8;
}

# Get total size of a struct/union in bytes
fn STRUCTSZ(S, si): i64 {
    var fc = GETFCOUNT(S, si);
    var is_u = ISUNION(S, si);
    var sz = 0;
    var i = 0;
    while (i < fc) {
        var fsz = FIELDSZ(S, GETFTYPE(S, si, i));
        if (is_u == 1) {
            if (fsz > sz) { sz = fsz; }
        } else {
            sz = sz + fsz;
        }
        i = i + 1;
    }
    return sz;
}

# 6.6.5 — how many 8-byte frame slots an aggregate SLTYPE spans. `t` is the local's
# type marker: `0 - sid` for a struct, a descriptor-band sentinel (<= -2048) for a
# vector. Returns 1 for anything that is not a multi-word aggregate, so callers can use
# the count unconditionally. One definition, so the picker, the copy paths and the
# literal allocator cannot disagree about a struct's width. CHANGELOG [6.6.5]
fn AGG_NSLOTS(S, t): i64 {
    if (t >= 0) { return 1; }
    if (_vec_desc(S, t) == 1) { return GVEC_NSLOTS(S); }
    var sz = STRUCTSZ(S, (0 - t) - 1);
    if (sz <= 8) { return 1; }
    return ((sz + 7) & (0 - 8)) / 8;
}

# 6.6.5 — a struct that fits in ONE 8-byte slot is held BY VALUE, on every target. This
# is the ABI policy that used to live inside `_resolve_field_base_addr` as an inline
# `if (_TARGET_CX == 0) { if (STRUCTSZ <= 8) ... }` guess; recording it at registration
# is what lets cx answer it the same way as x86 and aarch64. Before this, cx skipped the
# rule entirely, so two `var b: B1;` single-field locals both dereferenced their own
# uninitialised slot and ALIASED each other (measured 2 where 43 is right).
fn MARK_SMALL_STRUCT(S, li, t): i64 {
    if (t >= 0) { return 0; }
    if (t <= 0 - 2048) { return 0; }        # SIMD descriptor band — not a struct sid
    if (STRUCTSZ(S, (0 - t) - 1) > 8) { return 0; }
    SLAGG(S, li, 1);
    return 0;
}

# Get byte offset of field fi within struct/union si
fn FIELDOFF(S, si, fi): i64 {
    if (ISUNION(S, si) == 1) { return 0; }
    var off = 0;
    var i = 0;
    while (i < fi) {
        off = off + FIELDSZ(S, GETFTYPE(S, si, i));
        i = i + 1;
    }
    return off;
}

# Parse: enum Name { A; B; C; } — registers variants as global constants
# Called from BOTH pass 1 (register vars) and pass 2 (emit init code).
# Pass 1: just register var names + sizes (no code)
# Pass 2: emit mov rax, val; evstore for each variant
fn PARSE_ENUM_DEF(S, emit_code): i64 {
    STI(S, GTI(S) + 1);
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var enoff = PEEKV(S);
    STI(S, GTI(S) + 1);
    # v5.8.21: enum Foo<T, E> { ... } — skip generic params, mirroring
    # PARSE_STRUCT_DEF / PARSE_UNION_DEF. Type params are not yet
    # bound to anything (mono-only); accepting the syntax unblocks
    # `enum Result<T, E> { Ok(v); Err(e); }` source shape.
    SKIP_GENERICS(S);
    # v6.5.55 — `enum Name: stack { V(x); ... }` opts the declaration OUT of heap boxing.
    # A payload variant of a stack enum returns its (tag, payload) in the multi-return
    # register pair (rax = tag, rdx = payload) instead of a 16-byte `alloc`, and is read with
    # the existing destructuring bind: `var t, v = Ok(5);`.
    #
    # ⭐ WHY `stack` AND NOT A NEW KEYWORD. `stack` is token 111, reserved since v5.5.36 for
    # `stack var buf[N]` ("live on the call stack rather than being hoisted"), which is the
    # same meaning one level up. Reusing it means no lexer change and no chance of colliding
    # with an identifier — adding a `value` keyword would have silently broken any program
    # using `value` as a name.
    #
    # ⚠ OPT-IN ON PURPOSE. The boxed form is the DOCUMENTED representation: the guide spells
    # `Ok(42)` as "16-byte heap alloc — tag at +0, payload at +8", `?` desugars to
    # `load64(rax + 8)`, and lib/result.cyr's is_ok/result_unwrap plus ~300 ecosystem sites
    # read those offsets directly. Flipping the default would break all of them SILENTLY.
    var is_stack_enum = 0;
    if (PEEKT(S) == 49) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) != 111) { ERR_EXPECT(S, 111); }
        STI(S, GTI(S) + 1);
        is_stack_enum = 1;
    }
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    # v5.8.22 bite #1 — bump enum_count + capture eid for variant
    # tagging. Pass 1 only (emit_code == 0); pass 2 reuses the
    # same eid implicitly via the variant lookup at match-check
    # time. eid is 1-based so 0 in var_enum_id[] cleanly means
    # "not a variant".
    var ee_eid = 0;
    if (emit_code == 0) {
        ee_eid = GENUMC(S) + 1;
        SENUMC(S, ee_eid);
        SENUMNM(S, ee_eid - 1, enoff);
    }
    var val = 0;
    var ego = 1;
    while (ego == 1) {
        if (PEEKT(S) == 14) { ego = 0; }
        # v6.5.19: EOF guard. Without it `enum` (FOUR BYTES) SIGSEGV'd: the loop's only
        # exit was `}`, so at EOF it re-registered the same member forever, and the
        # per-member write walked the 1024-entry enum-const table off its region at
        # ~1027 iterations. The v6.4.62 watchdog could not catch it — that one detects a
        # STALL, and this loop ADVANCES GTI every iteration. See CVE-39.
        elif (PEEKT(S) == 12) { ego = 0; }
        else {
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var vnoff = PEEKV(S);
            var vti = GTI(S);
            STI(S, GTI(S) + 1);
            # Check for constructor syntax: Variant(param) | Variant(a, b, ...)
            # v5.8.21 bite: count arity by consuming param idents until ')'.
            # Comma (token 31) separates; ident (token 2) bumps arity.
            # v5.8.23 bite #1 — empty parens `Foo()` is now a TRUE
            # nullary tagged variant: alloc(8), tag at +0, no payload,
            # no params consumed. This is the migration shape for
            # `enum Option { None(); Some(v); }` — the paren-consistent
            # form that subsumes lib/tagged.cyr's hand-rolled
            # `fn None() { return tagged_new(NONE, 0); }`. Pre-v5.8.23
            # empty parens collapsed to arity-1 (16-byte alloc with
            # garbage payload) which was a no-real-consumer landmine.
            var has_ctor = 0;
            var ctor_arity = 0;
            if (PEEKT(S) == 10) {
                has_ctor = 1;
                STI(S, GTI(S) + 1);
                while (PEEKT(S) != 11) {
                    if (PEEKT(S) == 12) { break; }   # v6.4.61: EOF guard (multi-error recovery safety)
                    if (PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
                    else {
                        if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
                        STI(S, GTI(S) + 1);
                        ctor_arity = ctor_arity + 1;
                    }
                }
                STI(S, GTI(S) + 1);
            }
            if (PEEKT(S) == 4) {
                STI(S, GTI(S) + 1);
                # 6.7.2 (B1): `[-]N` as before, or an integer const expression (a const, an earlier
                # enum constant, sizeof, a const fn call) — evaluated once, replayed by token.
                val = _enum_val(S);
            }
            if (emit_code == 2) {
                # Pass 2 function section: emit constructor bodies only
                if (has_ctor == 1) {
                    # v6.5.55 — the pair carries exactly tag + one payload. Reject anything
                    # else HERE rather than emitting a ctor that silently drops fields.
                    # v6.5.67 — arity 0 is now allowed: a NULLARY variant has no payload, so it
                    # needs no second register and simply returns its tag. Rejecting it blocked
                    # the one type this whole arc exists to migrate — `enum Option { None(); Some(v); }`
                    # could not be declared `: stack` at all ("stack enum variant must take exactly
                    # 1 field"), which no roadmap line mentioned. Arity 2+ still cannot fit the
                    # pair and is still refused, with the bound now stated in the message.
                    if (is_stack_enum == 1) {
                        if (ctor_arity > 1) { ERR_MSG(S, "stack enum variant takes 0 or 1 fields (the pair holds tag + one payload)", 73); }
                    }
                    # v5.11.65 (CVE-05): bound NPOS_GUARD by actual
                    # variant-name length; was magic-256.
                    var _vnlen2 = 0; while (load8(S + 0xEC00000 + vnoff + _vnlen2) != 0) { _vnlen2 = _vnlen2 + 1; }
                    NPOS_GUARD(S, _vnlen2 + 1);
                    var cwp2 = GNPOS(S);
                    var cnoff2 = cwp2;
                    var cri2 = 0;
                    var crc2 = load8(S + 0xEC00000 + vnoff + cri2);
                    while (crc2 != 0) { store8(S + 0xEC00000 + cwp2, crc2); cwp2 = cwp2 + 1; cri2 = cri2 + 1; crc2 = load8(S + 0xEC00000 + vnoff + cri2); }
                    store8(S + 0xEC00000 + cwp2, 0); cwp2 = cwp2 + 1;
                    SNPOS(S, cwp2);
                    var cfi = FINDFN(S, cnoff2);
                    if (cfi >= 0) {
                        # v6.5.67 — MARK A STACK-ENUM CONSTRUCTOR AS PAIR-RETURNING (fn flag 256).
                        #
                        # v6.5.55 gave these constructors a two-register return (rax = tag,
                        # rdx = payload) and nothing recorded that fact anywhere, so every consumer
                        # that binds the result to ONE variable silently kept the tag and dropped
                        # the payload — no diagnostic, exit 0. Measured: a fn that binds
                        # `var r = inner();` and later `return r;` hands back whatever the last
                        # 3-arg call left in rdx (probe: payload 9 where 3 was correct). That is
                        # the v6.5.15 class — "a failed open reported as success" — on the payload
                        # instead of the tag, and the `.55` corpus cannot see it because every
                        # stack-enum test destructures at the call site.
                        #
                        # The flag lets the binding sites REFUSE a lossy context instead of losing
                        # data, and it propagates through `return` so a forwarding wrapper is
                        # flagged too.
                        if (is_stack_enum == 1) { if (ctor_arity == 1) {
                                SFLG(S, cfi, GFLG(S, cfi) | 256);
                                # v6.6.0 — a new pair-returning constructor exists, so the
                                # forward-reference propagation in parse.cyr must run again: anything
                                # it already decided was computed without knowing about this one.
                                _pair_prescan_done = 0;
                            } }
                        # 6.6.9 — a NULLARY stack variant (fn flag 512). It returns the tag alone,
                        # which is the whole value, so `return None();` in a fn that returns
                        # `Some(v)` elsewhere is a legal return — but the mixed-return warning
                        # (parse.cyr) could only see flag 256 and called it a dropped tag.
                        # CHANGELOG [6.6.9]
                        if (is_stack_enum == 1) { if (ctor_arity == 0) { SFLG(S, cfi, GFLG(S, cfi) | 512); } }
                        S64(_fnt_offsets + cfi * 8, GCP(S));
                        # v6.2.41 — register the constructor's REAL arity (was a
                        # hardcoded 1 — a dead sentinel; _fnt_params' only reader
                        # is the inline-replay path, which ctors never take). The
                        # accurate count lets the call-site arity check validate
                        # multi-field variants (Pair/Triple) instead of exempting
                        # them. Byte-identical: arity-1 ctors are unchanged, and
                        # arity-2+ differ only in a value no codegen path reads.
                        S64(_fnt_params + cfi * 8, ctor_arity);
                        EFNPRO(S);
                        var ctor_frame = ESUBRSP(S);
                        # v5.8.21 bite: store each incoming param into its
                        # own local slot 0..arity-1. ESTOREPARM routes through
                        # the per-target ABI dispatch — args 0-5 (SysV/aarch64)
                        # / 0-3 (Win64) from registers, the rest from the stack.
                        # ⛔ 6.6.6 — the last argument is the caller's int-class
                        # TOTAL, which SysV and aarch64 count stack slots DOWN
                        # from. It was a literal 0, so a 7+-field variant read
                        # field 7 from the ctor's OWN frame slot 4 (x86: `g` held
                        # `e`) and aarch64 OR-ed a negative offset into its `ldr`
                        # encoding (SIGILL). Constructor params are all int-class,
                        # one slot each, no retptr: the total is the arity.
                        # CHANGELOG [6.6.6]
                        var ctor_pi = 0;
                        while (ctor_pi < ctor_arity) {
                            ESTOREPARM(S, ctor_pi, ctor_pi, ctor_arity);
                            ctor_pi = ctor_pi + 1;
                        }
                        if (is_stack_enum == 1) {
                            # v6.5.55 — the whole point: NO alloc. Hand back (tag, payload) in
                            # the multi-return pair the language already has. Copy semantics is
                            # what makes this sound where the v6.5.15 attempt was not: each
                            # binding is its own copy, so two values built at one call site
                            # cannot alias, and nothing points at storage that can be reused.
                            # v6.5.67 — a NULLARY variant carries no payload: emit the tag alone
                            # and leave rdx untouched. It is therefore NOT pair-returning, so it
                            # does not get flag 256 and a single-variable bind of it stays legal —
                            # which is exactly right, since there is nothing to lose.
                            if (ctor_arity == 1) {
                                EFLLOAD(S, 0);
                                EMOVRDXRAX(S);
                            }
                            EMOVI(S, val);
                            EPATCHFRAME(S, ctor_frame, 16);
                            EFNEPI(S);
                        } else {
                            EMOVI(S, 8 + ctor_arity * 8); EPUSHR(S);
                            ECALLPOPS(S, 1);
                            NPOS_GUARD(S, 8);
                            var awnp = GNPOS(S);
                            store8(S + 0xEC00000 + awnp, 97); store8(S + 0xEC00000 + awnp + 1, 108);
                            store8(S + 0xEC00000 + awnp + 2, 108); store8(S + 0xEC00000 + awnp + 3, 111);
                            store8(S + 0xEC00000 + awnp + 4, 99); store8(S + 0xEC00000 + awnp + 5, 0);
                            SNPOS(S, awnp + 6);
                            var afi = FINDFN(S, awnp);
                            if (afi < 0) { afi = REGFN(S, awnp); }
                            var afoff = L64(_fnt_offsets + afi * 8);
                            if (afoff >= 0) { ECALLTO(S, afoff); } else { ECALLFIX(S, afi); }
                            ECALLCLEAN(S, 1);
                            # v5.8.21 bite: alloc-ptr lives in slot `arity`
                            # (slots 0..arity-1 hold params). Tag at +0,
                            # payloads at +8, +16, ... For arity=1 this
                            # produces byte-identical output to the prior
                            # hardcoded path: slot 1, EMOVI(8), one store.
                            EFLSTORE(S, ctor_arity);
                            EFLLOAD(S, ctor_arity); EPUSHR(S); EMOVI(S, val); EPOPC(S); ESTORE64(S);
                            var ctor_si = 0;
                            while (ctor_si < ctor_arity) {
                                EFLLOAD(S, ctor_arity); EPUSHR(S); EMOVI(S, 8 + ctor_si * 8); EMOVCA(S); EPOPR(S); EADDR(S);
                                EPUSHR(S); EFLLOAD(S, ctor_si); EPOPC(S); ESTORE64(S);
                                ctor_si = ctor_si + 1;
                            }
                            EPATCHFRAME(S, ctor_frame, (ctor_arity + 1) * 16);
                            EFLLOAD(S, ctor_arity);
                            EFNEPI(S);
                        }
                    }
                }
            }
            elif (emit_code == 0) {
                # Pass 1: register variant as global var
                var vcnt = GVCNT(S);
                # v6.2.11: flag a conflicting-value redefinition of this name
                # (issue 2026-06-14) BEFORE registering it, so the lookup sees only
                # prior defs. Pass-1-only (emit_code==0) → no double-warn.
                CHKDUPVAL(S, vnoff, val);
                CHK_ENUM_OVER_VAR(S, vnoff, val);   # 6.6.9: the zero/computed-var prior CHKDUPVAL cannot compare
                S64(_varn_base + vcnt * 8, vnoff);
                S64(_vars_base + vcnt * 8, 8);
                # v5.5.2: record enum variant's compile-time value in the
                # enum_const_val table (_vecv_base, a grown var-family table
                # indexed by var slot); SVECP marks the slot as an enum const.
                # PARSE_FACTOR reads this when resolving a bare/qualified
                # identifier and folds to EMOVI + _cfo=1 so callers like
                # the syscall-reroute dispatch see sc_num correctly.
                # v6.5.36: RAW value + an OUT-OF-BAND presence flag. The old
                # `(1 << 63) | val` tag could not represent a value with bit 62 or 63
                # set, and silently corrupted every enum constant >= 2^62 for five
                # releases. See util.cyr's GVECP/SVECP note.
                # 6.6.8: at EVERY var index — the old `vcnt < 1024` guard left a late
                # enum unfolded (no array size, no dup warning, no Mach-O syscall
                # reroute). CHANGELOG [6.6.8]
                S64(_vecv_base + vcnt * 8, val);
                SVECP(S, vcnt, 1);
                # v5.8.22 bite #1 — tag variant with parent enum-id +
                # bump per-enum variant count. Both keyed for the future
                # exhaustive-match consumer; no read site yet so this
                # ships byte-identical compiler output (DCE keeps the
                # writer fns alive via this call).
                SVENUMID(S, vcnt, ee_eid);
                SENUMVCNT(S, ee_eid - 1, GENUMVCNT(S, ee_eid - 1) + 1);
                SVCNT(S, vcnt + 1);
                # Register constructor function if has payload
                if (has_ctor == 1) {
                    # 6.6.20: the constructor is a fn under the BARE variant name, so a payload
                    # variant `mulh64(a)` / `fncall1(a)` / `sizeof(a)` declares a reserved
                    # intrinsic (the call lowers to the intrinsic, or SIGSEGVs). A unit variant
                    # declares no fn and stays accepted (`E.mulh64`). CHANGELOG [6.6.20]
                    _RSV_INTRINSIC_DECL(S, vnoff, vti, 0);
                    # v5.11.65 (CVE-05): bound NPOS_GUARD by actual
                    # variant-name length; was magic-256.
                    var _vnlen1 = 0; while (load8(S + 0xEC00000 + vnoff + _vnlen1) != 0) { _vnlen1 = _vnlen1 + 1; }
                    NPOS_GUARD(S, _vnlen1 + 1);
                    var cwp = GNPOS(S);
                    var cnoff = cwp;
                    var cri = 0;
                    var crc = load8(S + 0xEC00000 + vnoff + cri);
                    while (crc != 0) { store8(S + 0xEC00000 + cwp, crc); cwp = cwp + 1; cri = cri + 1; crc = load8(S + 0xEC00000 + vnoff + cri); }
                    store8(S + 0xEC00000 + cwp, 0); cwp = cwp + 1;
                    SNPOS(S, cwp);
                    REGFN(S, cnoff);
                }
            } else {
                # Pass 2 enum init (emit_code == 1): just set constant values
                # 6.6.6: only into an ENUM constant's slot. When a declaration-zone `var`
                # redeclares the name, FINDVAR (last match) returns the var, which already
                # holds its own value from program start. This store runs before every
                # deferred initializer, so it overwrote that value (`enum E { K = 5; }
                # var K = 7;` read 5 under "last definition wins"). CHANGELOG [6.6.6]
                #
                # `_findvar_core`, not FINDVAR: this looks up the slot THIS enum member
                # registered in pass 1 — it is the declaration's own second pass, not a
                # reference the source spells — so the cross-file `private` check must not
                # run. It did, and a `private` file whose `enum E { X = 2; }` shared a name
                # with another `private` file's `var X = 5;` was refused at its OWN member
                # line (`error: lib/a.cyr:2:24: 'X' is private to its file`, rc 1, no
                # binary) even though neither file mentions the other's symbol. Fourth
                # member of the same family as _findvar_core's three. CHANGELOG [6.6.6]
                var idx = _findvar_core(S, vnoff);
                if (idx >= 0) { if (GVENUMID(S, idx) != 0) { EMOVI(S, val); EVSTORE(S, idx); } }
            }
            val = val + 1;
            # v5.8.21: accept either ';' (5) or ',' (31) between
            # variants, mirroring the canonical pin shape
            # `enum Result<T,E> { Ok(T), Err(E) }`. The historical
            # ';' form (used across stdlib syscalls + lib/tagged.cyr's
            # OptionTag/ResultTag/EitherTag) keeps working.
            if (PEEKT(S) == 5 || PEEKT(S) == 31) { STI(S, GTI(S) + 1); }
        }
    }
    # v6.5.19: the loop can now exit on EOF as well as on `}` (the CVE-39 guard above),
    # so the closing brace has to be VERIFIED rather than assumed. Without this,
    # `enum E {` truncated mid-body exited 0 and cycc emitted a binary for a file that
    # simply stops — trading a SIGSEGV for silent acceptance, which is worse.
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    return 0;
}

# Get field count for struct (0-based index). High bit = union flag.
fn GETFCOUNT(S, si): i64 { return L64(S + 0x1A8018 + si * 8) & 0x7FFFFFFFFFFFFFFF; }
fn ISUNION(S, si): i64 { return L64(S + 0x1A8018 + si * 8) >> 63; }

# Find field index in struct (0-based struct index), return field index or -1
fn FINDFIELD(S, si, fnoff): i64 {
    var fc = GETFCOUNT(S, si);
    var fbase = L64(S + 0x1AA018 + si * 8);
    var i = 0;
    while (i < fc) {
        var fn_off = L64(S + 0x92A000 + (fbase + i) * 8);
        if (STREQ(S, fn_off, fnoff) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Parse: struct Name<T> { field; field; ... }
# 6.6.9 — A SECOND `struct X` / `union X` WITH A DIFFERENT LAYOUT. REGSTRUCT appends and
# FINDSTRUCT returns the FIRST match, so the second definition was registered and never read:
# sizeof(X) and every field offset came from the first, silently. Measured: two `SP` structs of
# 5 and 3 fields built rc 0 with sizeof(SP) = 40, and code written against the 3-field one read
# the 5-field offsets. Live in the older kavach several repos still vendor (two
# `struct SpawnedProcess`). A WARNING, so those builds keep compiling; an identical
# redefinition (same kind, same field names and types, in order) stays silent. CHANGELOG [6.6.9]
fn _struct_same_layout(S, a, b): i64 {
    if (L64(S + 0x1A8018 + a * 8) != L64(S + 0x1A8018 + b * 8)) { return 0; }   # count + union bit
    var n = GETFCOUNT(S, a);
    var i = 0;
    while (i < n) {
        if (STREQ(S, GETFNAME(S, a, i), GETFNAME(S, b, i)) == 0) { return 0; }
        if (GETFTYPE(S, a, i) != GETFTYPE(S, b, i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# `prev` = FINDSTRUCT before this definition registered (1-based, 0 = new name); `sid` = this one.
fn _chk_struct_redef(S, prev, sid, name_ti): i64 {
    if (prev == 0) { return 0; }
    if (_struct_same_layout(S, prev - 1, sid - 1) == 1) { return 0; }
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head_at(S, name_ti);
    if (ISUNION(S, sid - 1) == 1) { syscall(SYS_WRITE, 2, ": union '", 9); }
    else { syscall(SYS_WRITE, 2, ": struct '", 10); }
    PRSTR(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8));
    syscall(SYS_WRITE, 2, "' redefined with a different layout — the FIRST definition is the one used (sizeof, field offsets, every access)\n", 115);
    return 0;
}

# 6.6.10 — REGSTRUCT refused the definition (table full, already reported): consume its
# `{ ... }` body without registering anything, so the caller never indexes with sid - 1 = -1.
# Stops at EOF; a body that does not start with `{` is left for the caller's error path.
fn _skip_refused_body(S): i64 {
    if (PEEKT(S) != 13) { return 0; }
    var depth = 0;
    while (PEEKT(S) != 12) {
        var t = PEEKT(S);
        STI(S, GTI(S) + 1);
        if (t == 13) { depth = depth + 1; }
        if (t == 14) {
            depth = depth - 1;
            if (depth == 0) { return 0; }
        }
    }
    return 0;
}

# ⛔ 6.6.10 — A FIELD TYPE THAT NAMES NOTHING WAS SILENTLY AN 8-BYTE i64. The ladder's last
# arm was `ADDFIELDTYPED(.., FINDSTRUCT(name))`, and FINDSTRUCT answers 0 — the i64 encoding —
# for a name it does not know. So `a: Nonexist` compiled (sizeof 16 for `{ a: Nonexist; x; }`),
# a struct declared BELOW its use gave its user a different layout than the same text declared
# above (sizeof(A) = 16 vs 24 for `struct A { b: B; x; }`, and `a.b` loaded 8 bytes with no
# diagnostic), and `f64` / `f32` — never in the ladder — lost their float type.
# A field type is now one of: a struct or union declared ABOVE it; i8/i16/i32/i64 (their
# widths); u8/u16/u32/u64, cstring, Result/Option/Tagged or an enum (8 bytes); f64 / f32
# (8 bytes, typed — see SFFK); Vec<T> or a bare Vec; or a type parameter of the struct being
# declared. An enum may be declared on either side (its values are i64, so its position
# changes nothing).
# ⚠ u8/u16/u32 and f32 fields occupy 8 BYTES — the layout (and ABI) is unchanged, and the guide
# says so. Anything else is refused by name. CHANGELOG [6.6.10]
var _sdef_tp_ti = 0;   # the token after the declaring struct's name (its `<` when generic)

# The float kind of an accepted non-struct field type name (0 = plain 8 bytes, 1 = f64, 2 = f32),
# or -1 when the name is not a field type at all (a vector, or no type). 6.6.16: through the one
# type-name resolver (_tn_resolve), so `bool` — an 8-byte array element and sizeof 8 — is an
# 8-byte field too (it was refused here alone), and `Vec` is a `Vec<T>` element (`Vec<Vec>`, a
# vector of 8-byte handles). A bare `Vec` / `Vec<T>` FIELD never reaches here (PARSE_STRUCT_DEF
# takes it first). CHANGELOG [6.6.16]
fn _field_name_kind(S, tnoff): i64 {
    var c = _tn_resolve(S, tnoff);
    if (c == 0) {
        if (_is_own_tparam(S, tnoff) == 1) { return 0; }
        return 0 - 1;
    }
    var k = _tn_class(c);
    if (k == 3) {
        if (_tn_val(c) == 8) { return 1; }   # f64
        return 2;                            # f32
    }
    if (k == 5) { return 0 - 1; }            # a vector: _refuse_field_type names it
    if (_tn_bool(c) == 1) { return 3; }      # 6.7.3: bool (an 8-byte word, writes checked)
    return 0;   # u8..u64 (8 bytes), cstring, Result, Option, Tagged, an enum (either side)
}

# Is `noff` one of the type parameters of the struct being declared (`struct Box<T> { v: T; }`)?
# Read from the tokens, not the monomorph binding: the default build never captures them.
fn _is_own_tparam(S, noff): i64 {
    var k = _sdef_tp_ti;
    if (k <= 0) { return 0; }
    if (TOKTYP(S, k) != 19) { return 0; }
    k = k + 1;
    while (k < GTCNT(S)) {
        var t = TOKTYP(S, k);
        if (t == 20) { return 0; }
        if (t == 13) { return 0; }
        if (t == 2) { if (TOKTYP(S, k - 1) != 49 && TOKTYP(S, k - 1) != 6) {   # 6.7.1: not a bound's trait
                if (STREQ(S, TOKVAL(S, k), noff) == 1) { return 1; } } }
        k = k + 1;
    }
    return 0;
}

# Is a declaration of this name — keyword token `ta` or `tb` (struct 40, union 101, enum 60)
# followed by the name — LATER in the token stream?
fn _declared_later(S, noff, ta, tb): i64 {
    var k = GTI(S);
    var n = GTCNT(S);
    while (k + 1 < n) {
        var t = TOKTYP(S, k);
        if (t == ta || t == tb) {
            if (TOKTYP(S, k + 1) == 2) { if (STREQ(S, TOKVAL(S, k + 1), noff) == 1) { return 1; } }
        }
        k = k + 1;
    }
    return 0;
}

# The refusal. The cursor is already past the type name, so the declaration parses on: the
# panic latch THIS error set is cleared again, and every bad field of every struct is reported
# (not only the first of the file). An error that already held the latch is left alone.
fn _refuse_field_type(S, tnoff, fnoff, snoff): i64 {
    if (_panic == 1) { return 0; }
    if (_classify_return_type(S, tnoff) <= 0 - 2048) {
        ERR_IDENT(S, "vector type ", tnoff, " cannot be a struct field type; field ", fnoff);
    } elif (_declared_later(S, tnoff, 40, 101) == 1) {
        ERR_IDENT(S, "struct field type ", tnoff, " is declared after its use; declare it before ", snoff);
    } else {
        ERR_IDENT(S, "unknown type ", tnoff, " for struct field ", fnoff);
        _tn_prefix_note(S, tnoff);   # 6.6.16
        PRSTR("  note: a field type is a struct or union declared above it, i8/i16/i32/i64, u8/u16/u32/u64, f32, f64, bool, cstring, Result, Option, Tagged, an enum, Vec / Vec<T>, or a pointer *T (missing include?)\n");
    }
    _panic = 0;
    return 0;
}

# The ladder's named-type arm, shared by struct and union: a struct/union declared above, or
# an accepted scalar name (float kind recorded), or a refusal naming the type.
# ⛔ A struct naming ITSELF as a field type (`struct Node { next: Node; }`) is refused too: FINDSTRUCT
# finds the struct being declared, and STRUCTSZ then recursed through that field forever — the
# compiler died with SIGSEGV, no diagnostic. A link to another node is an i64 (pointer) field.
fn _add_named_field(S, si, fnoff, tnoff): i64 {
    var fsid = FINDSTRUCT(S, tnoff);
    if (fsid == si + 1) {
        if (_panic == 0) {
            ERR_IDENT(S, "field ", fnoff, " makes a struct contain itself: ", tnoff);
            PRSTR("  note: a link to another one is an i64 (pointer) field\n");
            _panic = 0;
        }
        ADDFIELD(S, si, fnoff);
        return 0;
    }
    if (fsid > 0) { ADDFIELDTYPED(S, si, fnoff, fsid); return 0; }
    var k = _field_name_kind(S, tnoff);
    if (k < 0) {
        _refuse_field_type(S, tnoff, fnoff, L64(S + 0x1A6018 + si * 8));
        k = 0;
    }
    ADDFIELDFK(S, si, fnoff, k);
    return 0;
}

# A `Vec<T>` element type in the same vocabulary: its field-type encoding, refusing a name
# that is none of them.
fn _vec_elem_code(S, si, fnoff, etoff): i64 {
    var ew = _field_scalar_width(L64(S + 0xEC00000 + etoff));
    if (ew > 0) {
        if (ew < 8) { return 0 - ew; }
        return 0;
    }
    var es = FINDSTRUCT(S, etoff);
    if (es > 0) { return es; }
    if (_field_name_kind(S, etoff) < 0) { _refuse_field_type(S, etoff, fnoff, L64(S + 0x1A6018 + si * 8)); }
    return 0;
}

# A `Vec<T>` field's element, cursor on T: its code (`_vec_elem_code`, which refuses an unknown
# name), T and the `>` closing `Vec<` consumed. 6.6.17: T may take type arguments of its own —
# `items: Vec<Box<i64>>` was `expected '>', got '<'`. They are skipped, not instantiated: this
# runs inside a struct definition, whose fields must stay contiguous in the field pool, and the
# element code is read only by the derive codecs. The lexer's `>>` closes T's list AND the
# `Vec<` one, which `_ta_pending_gt` carries.
fn _vec_field_elem(S, si, fnoff): i64 {
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var etoff = PEEKV(S);
    STI(S, GTI(S) + 1);                     # consume the element type name
    var elemc = _vec_elem_code(S, si, fnoff, etoff);
    _ta_pending_gt = 0;
    if (PEEKT(S) == 19) { _ta_pending_gt = _skip_targ_list(S); }
    if (_ta_pending_gt > 0) { _ta_pending_gt = _ta_pending_gt - 1; return elemc; }
    if (PEEKT(S) != 20) { ERR_EXPECT(S, 20); }
    STI(S, GTI(S) + 1);                     # consume >
    return elemc;
}

# ⛔ 6.7.1 (C3) — A FIELD WHOSE TYPE IS A GENERIC STRUCT INSTANCE, `b: Box<i32>`. It was `expected
# identifier, got '<'`: the field parse took the name `Box` and stopped at its `<`. The instance cannot
# be minted where the field is read — a struct's fields fill a contiguous slice of the field pool from
# the pool top REGSTRUCT recorded, and a new instance registered mid-definition would land its own
# fields inside that slice. So every generic field type is instantiated FIRST, by a pre-scan of the
# body before the outer struct registers (`_sdef_gen_prescan`), and the field parse then finds the
# instance deduped (`_sfield_named`). In a generic struct's base definition its own type parameters are
# the i64 base's (`b: Box<T>` in `W<T>` is the base `Box`); an instance binds them to its arguments.
# A field naming the struct being defined — itself, or inside its type arguments — is refused: the
# struct would contain itself. CHANGELOG [6.7.1]
fn _sfield_gen(S, fs, stp): i64 {
    var sv_n0 = _tp_n0; var sv_c0 = _tp_c0; var sv_n1 = _tp_n1; var sv_c1 = _tp_c1;
    var sv_q = _bnd_quiet;
    var sv_qh = _bnd_quiet_hit;
    if (stp != 0) { if (_tp_c0 == 0) {
            var t0 = stp & 0xFFFFFFFF;
            if (t0 != 0) { _tp_bind(S, 0, t0 - 1, 0 - 8); }
            var t1 = (stp >> 32) & 0xFFFFFFFF;
            if (t1 != 0) { _tp_bind(S, 1, t1 - 1, 0 - 8); }
            # 6.7.1 (C3): `Box<T>` in the BASE definition — its T is the base's i64, which `W<Pt>`
            # does not share. A failing bound there is recorded on W (`_sdef_bb`), judged where W's
            # base is used; a field not naming T (`Box<Pt>`) is checked for real.
            if (_targs_literal(S, GTI(S) + 1) == 0) { _bnd_quiet = 1; _bnd_quiet_hit = 0; }
        } }
    var g = _gen_ann_sid(S, fs);
    if (_bnd_quiet == 1) { if (_bnd_quiet_hit > 0) { if (_sdef_bb == 0) { _sdef_bb = _bnd_quiet_hit; } } }
    _bnd_quiet = sv_q;
    _bnd_quiet_hit = sv_qh;
    _tp_n0 = sv_n0; _tp_c0 = sv_c0; _tp_n1 = sv_n1; _tp_c1 = sv_c1;
    return g;
}
# 1 iff the type-argument list starting at token j (just past its `<`) names `own` anywhere.
fn _targs_name(S, j, own): i64 {
    var n = GTCNT(S);
    var d = 1;
    while (j < n) {
        var t = TOKTYP(S, j);
        if (t == 12 || t == 5 || t == 13) { return 0; }
        if (t == 2) { if (STREQ(S, TOKVAL(S, j), own) == 1) { return 1; } }
        if (t == 19) { d = d + 1; }
        if (t == 20) { d = d - 1; }
        if (t == 39) { d = d - 2; }
        if (t == 152) { d = d - 3; }
        if (d <= 0) { return 0; }
        j = j + 1;
    }
    return 0;
}
# Cursor on a struct body's `{` (`own` its source name, `stp` its type parameters): instantiate every
# `name: Generic<..>` field type before the struct registers. The cursor is put back.
fn _sdef_gen_prescan(S, stp, own): i64 {
    if (_MONOMORPH_OK != 1) { return 0; }
    if (PEEKT(S) != 13) { return 0; }
    var sv = GTI(S);
    var sv_in = _inst_name;
    var n = GTCNT(S);
    var i = sv + 1;
    var d = 1;
    while (i < n) {
        var t = TOKTYP(S, i);
        if (t == 12) { break; }
        if (t == 13) { d = d + 1; }
        if (t == 14) { d = d - 1; if (d == 0) { break; } }
        if (d == 1) { if (t == 49) { if (TOKTYP(S, i - 1) == 2) { if (TOKTYP(S, i + 1) == 2) { if (TOKTYP(S, i + 2) == 19) {
                            var fn0 = TOKVAL(S, i + 1);
                            var fs = FINDSTRUCT(S, fn0);
                            if (fs > 0) { if (GSTP(S, fs - 1) != 0) { if (STREQ(S, fn0, own) == 0) { if (_targs_name(S, i + 3, own) == 0) {
                                            STI(S, i + 2);
                                            _sfield_gen(S, fs, stp);
                                            _inst_name = sv_in;
                                        } } } }
                        } } } } }
        i = i + 1;
    }
    _ta_pending_gt = 0;
    STI(S, sv);
    return 0;
}
# 1 iff struct si's name is a minted instance (`Box$i32`): '$' is never a source identifier byte.
fn _sname_minted(S, si): i64 {
    var p = S + 0xEC00000 + L64(S + 0x1A6018 + si * 8);
    var i = 0;
    while (load8(p + i) != 0) {
        if (load8(p + i) == 36) { return 1; }
        i = i + 1;
    }
    return 0;
}
# A field typed by a struct name (`tnoff`, cursor after it): a generic one's `<..>` is its instance
# (`_sdef_gen_prescan` minted it already, so this finds it); anything else is `_add_named_field`.
fn _sfield_named(S, si, fnoff, tnoff, stp, own): i64 {
    if (PEEKT(S) == 19) { if (_MONOMORPH_OK == 1) {
            var fs = FINDSTRUCT(S, tnoff);
            if (fs > 0) { if (GSTP(S, fs - 1) != 0) {
                    if (STREQ(S, tnoff, own) == 1 || _targs_name(S, GTI(S) + 1, own) == 1) {
                        # Reported at the definition; an instance re-parse (`W$i32`) stays quiet.
                        if (_panic == 0 && _sname_minted(S, si) == 0) {
                            ERR_IDENT(S, "field ", fnoff, " makes a struct contain itself: ", own);
                            PRSTR("  note: a link to another one is an i64 (pointer) field\n");
                            _panic = 0;
                        }
                        _ta_pending_gt = 0;
                        _skip_targ_list(S);
                        ADDFIELD(S, si, fnoff);
                        return 0;
                    }
                    var g = _sfield_gen(S, fs, stp);
                    ADDFIELDTYPED(S, si, fnoff, g);
                    return 0;
                } }
        } }
    return _add_named_field(S, si, fnoff, tnoff);
}

fn PARSE_STRUCT_DEF(S): i64 {
    var _sdefstart = GTI(S);   # v6.3.10: the `struct` token, for generic instance re-emit
    STI(S, GTI(S) + 1);  # consume STRUCT
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var noff = PEEKV(S);
    var _sname_ti = GTI(S);
    STI(S, GTI(S) + 1);
    # Skip generic parameters if present: struct Foo<T, U>
    # v6.3.10 (generic structs): capture <T> (flag-off / non-generic = old SKIP_GENERICS).
    var _stp = _capture_tparams(S);
    var _sbnd = 0;   # 6.7.1 (C3): `struct Box<T: Show>` — read now, before the pre-scan re-captures
    if (_stp != 0) { if (_inst_name == 0) { _sbnd = _bnd_make(S, _stp); } }
    var _sv_sbb = _sdef_bb;
    _sdef_bb = 0;
    # v6.3.10: re-emitting a `Box$ty` instance uses the mangled name verbatim.
    if (_inst_name != 0) { noff = _inst_name; }
    var _sown = TOKVAL(S, _sname_ti);
    _sdef_gen_prescan(S, _stp, _sown);   # 6.7.1 (C3): `b: Box<i32>` fields, before REGSTRUCT
    var _sprev = FINDSTRUCT(S, noff);
    var sid = REGSTRUCT(S, noff);
    if (sid == 0) { _sdef_bb = _sv_sbb; return _skip_refused_body(S); }   # 6.6.10: table full — never index -1
    var si = sid - 1;
    var _sv_tp_ti = _sdef_tp_ti;
    _sdef_tp_ti = _sname_ti + 1;   # 6.6.10: its `<T>`, for _is_own_tparam
    if (_stp != 0) { SSTP(S, si, _stp); SSDS(S, si, _sdefstart + 1); }   # record for instantiation
    if (_sbnd != 0) { SSBND(S, si, _sbnd); }
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);  # consume {
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) == 14) { go = 0; }
        # v6.5.19: EOF guard — same class as the enum member loop above (CVE-39).
        # `struct`, `struct S`, `struct S {`, `struct S { a` all SIGSEGV'd at 6.5.18.
        elif (PEEKT(S) == 12) { go = 0; }
        else {
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var fnoff = PEEKV(S);
            STI(S, GTI(S) + 1);
            # Check for type annotation: field: Type
            if (PEEKT(S) == 49 && TOKTYP(S, GTI(S) + 1) == 8) { _add_ptr_field(S, si, fnoff); }   # 6.6.17: `: *T`
            elif (PEEKT(S) == 49) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
                var tnoff = PEEKV(S);
                # v6.3.10 (generic structs): a field `: T` under an active instance
                # binding resolves to the concrete type — canonical token <0 = scalar
                # -width, >0 = struct sid. Inert (no binding) → the normal field parse.
                var _ftc = 0;
                if (_tp_c0 != 0) { _ftc = _tp_resolve(S, tnoff); }
                if (_ftc != 0) {
                    STI(S, GTI(S) + 1);   # consume the type name
                    if (_ftc == 0 - 9) {
                        ADDFIELDFK(S, si, fnoff, 1);   # 6.6.10: `T` bound to f64 is an f64 field
                    } elif (_ftc < 0) {
                        var _fw = 0 - _ftc;
                        if (_fw < 8) { ADDFIELDTYPED(S, si, fnoff, 0 - _fw); }
                        else { ADDFIELD(S, si, fnoff); }
                    } else {
                        ADDFIELDTYPED(S, si, fnoff, _ftc);
                    }
                } else {
                    # Check scalar types first
                    var ftname = L64(S + 0xEC00000 + tnoff);
                    var fscalar = _field_scalar_width(ftname);
                    STI(S, GTI(S) + 1);
                    # v6.4.x Pin 2 — Vec<T> array-typed field. `Vec` (0x636556)
                    # followed by `<` (token 19) is a typed handle field: an
                    # 8-byte pointer slot (like Str), element type T recorded in
                    # a far-negative sentinel via MKVEC. Non-generic structs only.
                    if (ftname & 0xFFFFFFFF == 0x636556) {
                        if (PEEKT(S) == 19) {
                            STI(S, GTI(S) + 1);   # consume <
                            var elemc = _vec_field_elem(S, si, fnoff);   # 6.6.17: + a nested `<..>`
                            var _vsent = MKVEC(S, elemc);
                            ADDFIELDTYPED(S, si, fnoff, _vsent);
                        } else {
                            var _bsid = FINDSTRUCT(S, tnoff);   # a bare `Vec`: an untyped 8-byte handle
                            ADDFIELDTYPED(S, si, fnoff, _bsid);
                        }
                    } elif (fscalar > 0) {
                        # Store as negative width for sized scalars, 0 for i64 (default)
                        if (fscalar < 8) { ADDFIELDTYPED(S, si, fnoff, 0 - fscalar); }
                        else { ADDFIELD(S, si, fnoff); }
                    } else {
                        _sfield_named(S, si, fnoff, tnoff, _stp, _sown);   # 6.6.10: refuses an unknown name; 6.7.1: `Box<i32>`
                    }
                }
            } else {
                ADDFIELD(S, si, fnoff);
            }
            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
        }
    }
    # v6.5.19: verify the brace — the loop can now exit on EOF too. See PARSE_ENUM_DEF.
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);  # consume }
    _sdef_tp_ti = _sv_tp_ti;
    if (_sdef_bb > 0) { SSBB(S, si, _sdef_bb); }   # 6.7.1 (C3)
    _sdef_bb = _sv_sbb;
    _chk_struct_redef(S, _sprev, sid, _sname_ti);
    return 0;
}

# Parse union — same as struct but sets high bit in fcount to mark as union
fn PARSE_UNION_DEF(S): i64 {
    STI(S, GTI(S) + 1);  # consume UNION
    if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
    var noff = PEEKV(S);
    var _uname_ti = GTI(S);
    STI(S, GTI(S) + 1);
    SKIP_GENERICS(S);
    _sdef_gen_prescan(S, 0, noff);   # 6.7.1 (C3): `b: Box<i32>` fields, before REGSTRUCT
    var _uprev = FINDSTRUCT(S, noff);
    var sid = REGSTRUCT(S, noff);
    if (sid == 0) { return _skip_refused_body(S); }   # 6.6.10: table full — never index -1
    var si = sid - 1;
    var _sv_tp_ti = _sdef_tp_ti;
    _sdef_tp_ti = _uname_ti + 1;   # 6.6.10: its `<T>`, for _is_own_tparam
    # Set union flag (high bit of fcount)
    S64(S + 0x1A8018 + si * 8, 1 << 63);
    if (PEEKT(S) != 13) { ERR_EXPECT(S, 13); }
    STI(S, GTI(S) + 1);
    var go = 1;
    while (go == 1) {
        if (PEEKT(S) == 14) { go = 0; }
        # v6.5.19: EOF guard — the union twin of the struct loop above (CVE-39).
        elif (PEEKT(S) == 12) { go = 0; }
        else {
            if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
            var fnoff = PEEKV(S);
            STI(S, GTI(S) + 1);
            if (PEEKT(S) == 49 && TOKTYP(S, GTI(S) + 1) == 8) { _add_ptr_field(S, si, fnoff); }   # 6.6.17: `: *T`
            elif (PEEKT(S) == 49) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) != 2) { ERR_EXPECT(S, 2); }
                var tnoff = PEEKV(S);
                var ftname = L64(S + 0xEC00000 + tnoff);
                var fscalar = _field_scalar_width(ftname);
                STI(S, GTI(S) + 1);
                # v6.4.x Pin 2 — Vec<T> array-typed field (PARSE_UNION_DEF
                # parallel copy of the PARSE_STRUCT_DEF branch).
                if (ftname & 0xFFFFFFFF == 0x636556) {
                    if (PEEKT(S) == 19) {
                        STI(S, GTI(S) + 1);   # consume <
                        var elemc = _vec_field_elem(S, si, fnoff);   # 6.6.17: + a nested `<..>`
                        var _vsent = MKVEC(S, elemc);
                        ADDFIELDTYPED(S, si, fnoff, _vsent);
                    } else {
                        var _bsid = FINDSTRUCT(S, tnoff);   # a bare `Vec`: an untyped 8-byte handle
                        ADDFIELDTYPED(S, si, fnoff, _bsid);
                    }
                } elif (fscalar > 0) {
                    if (fscalar < 8) { ADDFIELDTYPED(S, si, fnoff, 0 - fscalar); }
                    else { ADDFIELD(S, si, fnoff); }
                } else {
                    _sfield_named(S, si, fnoff, tnoff, 0, noff);   # 6.6.10: refuses an unknown name; 6.7.1: `Box<i32>`
                }
            } else {
                ADDFIELD(S, si, fnoff);
            }
            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
        }
    }
    # v6.5.19: verify the brace — the loop can now exit on EOF too. See PARSE_ENUM_DEF.
    if (PEEKT(S) != 14) { ERR_EXPECT(S, 14); }
    STI(S, GTI(S) + 1);
    _sdef_tp_ti = _sv_tp_ti;
    _chk_struct_redef(S, _uprev, sid, _uname_ti);
    return 0;
}

fn STREQ(S, a, b): i64 {
    var i = 0;
    var go = 1;
    while (go == 1) {
        var ca = load8(S + 0xEC00000 + a + i);
        var cb = load8(S + 0xEC00000 + b + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 1;
}

# 6.6.6: a KERNEL build replays the declaration-zone initializers AFTER the top-level program
# has registered its own globals, so a name read inside one (`var b = id(a);`) resolved to a
# later `var a` of the program instead of the declaration-zone global every other build reads.
# While that replay runs, globals in [_fv_hide_lo, _fv_hide_hi) — the program's — lose to any
# declaration-zone match of the name (EMIT_GVAR_INITS sets the range from _gv_zone_top, which
# main.cyr records before the kernel's PARSE_PROG). With no such match the program's global is
# still returned, as before. CHANGELOG [6.6.6]
var _gv_zone_top = 0;
var _fv_hide_lo = 0;
var _fv_hide_hi = 0;
fn _fv_hidden(vi): i64 {
    if (vi >= _fv_hide_hi) { return 0; }
    if (vi < _fv_hide_lo) { return 0; }
    return 1;
}

# 6.6.6 bite 19a — the follow-up to a FINDVAR miss: was this name a `var` declared inside a
# TOP-LEVEL BLOCK, which now leaves scope with its block (see _gvs_push, util.cyr)? Such a
# slot is marked dead with 2 (1 is a compiler temporary / a fn-local static), so a miss can
# say WHICH variable and WHERE to put it instead of the bare "missing include or enum?".
# Printed as a `note:` after the error so the error text every gate greps stays unchanged.
# CHANGELOG [6.6.6]
#
# 6.6.8: a top-level `for x in ...` variable is marked 3 (_HTLOOPEND, parse.cyr) — the block
# note's advice ("declare it before the block") does not apply to a loop variable, so the
# most recent out-of-scope match picks which note is printed. CHANGELOG [6.6.8]
fn _gv_blockscoped(S, noff): i64 {
    var vi = GVCNT(S) - 1;
    while (vi >= 0) {
        var d = GVDEAD(S, vi);
        if (d >= 2) {
            if (STREQ(S, L64(_varn_base + vi * 8), noff) == 1) { return d; }
        }
        vi = vi - 1;
    }
    return 0;
}
fn _gv_note_blockscoped(S, noff): i64 {
    var k = _gv_blockscoped(S, noff);
    if (k == 0) { return 0; }
    syscall(SYS_WRITE, 2, "note: '", 7);
    PRSTR(S + 0xEC00000 + noff);
    if (k == 3) { return _gv_note_loopvar(S); }
    syscall(SYS_WRITE, 2, "' was declared inside a top-level block and goes out of scope at its '}'\n", 73);
    syscall(SYS_WRITE, 2, "      (since 6.6.6 a top-level block scopes its `var`s like a fn body does)\n", 76);
    syscall(SYS_WRITE, 2, "      declare it at top level, before the block, to use it after the block\n", 75);
    return 0;
}

fn _gv_note_loopvar(S): i64 {
    syscall(SYS_WRITE, 2, "' is a `for ... in` loop variable and goes out of scope at the end of its loop\n", 79);
    syscall(SYS_WRITE, 2, "      to use a value after the loop, assign it to a variable declared before the loop\n", 86);
    return 0;
}

# 6.6.6 bite 19b — RESOLUTION vs. a DECLARATION-TIME PROBE.
#
# FINDVAR is the one resolver, and v6.5.0 put the cross-file `private` check inside it on
# purpose: every REFERENCE goes through it, so one check covers them all. But FOUR callers are
# not references at all — PARSE_GVAR_REG's `sit_shadow` probe, CHKDUPVAL, CHK_ENUM_SHADOW and
# PARSE_ENUM_DEF's pass-2 value store all look a name up while REGISTERING it, and none is
# reading a prior definition. Running the visibility check for them made a legal program fail:
#
#     lib/a.cyr:  private            lib/b.cyr:  private
#                 var LIMIT = 5;                 var B_CAP = LIMIT * 2;
#                                                var LIMIT = 5;
#
#     error: lib/b.cyr:3:11: 'LIMIT' is private to its file          (rc 1)
#
# b.cyr's own `var LIMIT = 5;` — the declaration, on its own line — was reported as an illegal
# ACCESS to a.cyr's private `LIMIT`, which b.cyr never mentions. The probe found a's slot,
# FINDVAR reported it, and the file that is allowed its own `LIMIT` could not declare one.
#
# So the lookup is split: `_findvar_core` is pure resolution and `FINDVAR` is that plus the
# visibility check, exactly as before for every reference. Declaration-time probes call the
# core.
#
# ⚠ THE FIRST CUT OF THIS FIX MOVED TWO OF FOUR, and said in this comment and in the CHANGELOG
# that there were two. CHK_ENUM_SHADOW is the arm that runs for every NON-int-literal
# initializer — so `var X = 2 + 3;` beside another file's `private var X` stayed refused while
# `var X = 5;` was fixed — and PARSE_ENUM_DEF's pass-2 value store is the fourth: it resolves
# the slot the enum member itself registered in pass 1, and refused a `private` file at its own
# `enum E { X = 2; }` line when another `private` file declared a `var X`. When you find a
# probe, grep for the SHAPE (a FINDVAR call reached from a registration path) rather than
# counting the ones already named — twice now the count in this comment has been the bug.
# CHANGELOG [6.6.6]
#
# 6.6.9 — THE GLOBAL VAR TABLE HAS A NAME INDEX. `_findvar_core` and `_gv_prior`
# (parse_decl.cyr) used to walk EVERY registered global with STREQ, and every new top-level
# global or enum member triggers two of those walks (the sit_shadow probe + `_gv_fold`, or
# CHKDUPVAL + the enum pass-2 lookup), so N registrations cost O(N²): 20,000 constant
# globals took ~4.9 s, 99 % of it in this phase. Now a name maps to the HIGHEST slot of that
# name and `_fvh_prev[vi]` links each slot to the next lower slot of the same name, so a
# lookup visits only the slots that share the name, highest first — the order the old
# reverse walk tested them in, so every result is the one it returned.
#
# The index syncs LAZILY for [_fvh_upto, GVCNT). That is sound because every writer of
# `_varn_base` writes the name at an index >= GVCNT BEFORE bumping the count, and nothing
# renames a slot below the count (a registration folded away by `_gv_fold` is never counted,
# and the next one at that index overwrites its name first). A slot not yet counted is not
# visible to either walk, which is also what the old loops did. `_HTEMP` slots carry name
# offset 0 and all chain under the first lexed word, dead — the same cost as before for
# that one name, and skipped exactly as before. No heap/brk layout change: both tables are
# alloc'd. CHANGELOG [6.6.9]
#
# A name map: open addressing, 16-byte entries (name offset, value), value 0 = empty. The
# handle is a 3-word block: table, mask (slots - 1), slots in use. Doubles at half full.
fn _nm_alloc(m, slots): i64 {
    store64(m, alloc(slots * 16));
    store64(m + 8, slots - 1);
    store64(m + 16, 0);
    return 0;
}
fn _nm_new(slots): i64 {
    var m = alloc(24);
    _nm_alloc(m, slots);
    return m;
}
# The entry for `noff`: the matching one, or the empty slot it would go in.
fn _nm_probe(S, m, noff): i64 {
    var tab = load64(m);
    var mask = load64(m + 8);
    var s = FNV1A_NOFF(S, noff) & mask;
    while (load64(tab + s * 16 + 8) != 0) {
        if (STREQ(S, load64(tab + s * 16), noff) == 1) { return tab + s * 16; }
        s = (s + 1) & mask;
    }
    return tab + s * 16;
}
fn _nm_get(S, m, noff): i64 { return load64(_nm_probe(S, m, noff) + 8); }
fn _nm_put(S, m, noff, val): i64 {
    var a = _nm_probe(S, m, noff);
    if (load64(a + 8) == 0) {
        store64(a, noff);
        store64(m + 16, load64(m + 16) + 1);
    }
    store64(a + 8, val);
    if (load64(m + 16) * 2 > load64(m + 8)) { _nm_grow(S, m); }
    return 0;
}
fn _nm_grow(S, m): i64 {
    var old = load64(m);
    var n = load64(m + 8) + 1;
    _nm_alloc(m, n * 2);
    var i = 0;
    while (i < n) {
        if (load64(old + i * 16 + 8) != 0) { _nm_put(S, m, load64(old + i * 16), load64(old + i * 16 + 8)); }
        i = i + 1;
    }
    return 0;
}

var _fvh_m = 0;      # name -> highest slot of that name + 1
var _fvh_prev = 0;   # per slot: the next lower slot of the same name + 1 (0 = none)
var _fvh_pcap = 0;
var _fvh_upto = 0;   # slots [0, _fvh_upto) are indexed
fn _fvh_prev_grow(n): i64 {
    var nc = 4096;
    while (nc < n) { nc = nc * 2; }
    var np = alloc(nc * 8);
    var i = 0;
    while (i < _fvh_pcap) { store64(np + i * 8, load64(_fvh_prev + i * 8)); i = i + 1; }
    _fvh_prev = np;
    _fvh_pcap = nc;
    return 0;
}
fn _fvh_add(S, vi): i64 {
    var noff = L64(_varn_base + vi * 8);
    store64(_fvh_prev + vi * 8, _nm_get(S, _fvh_m, noff));
    _nm_put(S, _fvh_m, noff, vi + 1);
    return 0;
}
fn _fvh_sync(S): i64 {
    var n = GVCNT(S);
    if (_fvh_upto >= n) { return 0; }
    if (_fvh_m == 0) { _fvh_m = _nm_new(4096); }
    if (n > _fvh_pcap) { _fvh_prev_grow(n * 2); }
    while (_fvh_upto < n) {
        _fvh_add(S, _fvh_upto);
        _fvh_upto = _fvh_upto + 1;
    }
    return 0;
}
# The highest counted slot named `noff`, + 1 (0 = none). Walk down with _fvh_next.
fn _fvh_head(S, noff): i64 {
    _fvh_sync(S);
    if (_fvh_m == 0) { return 0; }
    return _nm_get(S, _fvh_m, noff);
}
fn _fvh_next(vi): i64 { return load64(_fvh_prev + vi * 8); }

fn _findvar_core(S, noff): i64 {
    var e = _fvh_head(S, noff);
    var hid = 0 - 1;   # 6.6.6: the last match inside the hidden range (see _fv_hidden)
    while (e != 0) {
        var vi = e - 1;
        # 6.6.5: a compiler-generated global temporary (top-level `switch` / `match` / `?` /
        # `for ... in`) is registered with NAME OFFSET 0, which is the FIRST LEXED WORD of the
        # program — so this lookup RETURNED those slots for that identifier and `&setup` changed
        # meaning after an intervening `switch`. They are marked dead at registration and
        # skipped here; inside a fn they are anonymous frame slots and never reach this table.
        if (GVDEAD(S, vi) == 0) { if (_fv_hidden(vi) == 1) {
                if (hid < 0) { hid = vi; }
            } else {
                return vi;
            } }
        e = _fvh_next(vi);
    }
    return hid;
}

# The resolver every REFERENCE goes through.
#
# v6.5.0 Phase 2b — the cross-file `private` check for GLOBAL vars lives HERE, inside the
# single resolver, rather than being wired at each call site. Every global reference goes
# through it, so one check covers them all — which is the lesson from the fn side, where the
# plan named 2 of at least 13 resolution paths and the tail-call path was silently unenforced
# until a gate caught it.
#
# Locals need no special case: frame locals are never stamped, so GVFI reads 0 and the check
# falls straight through. 6.6.5: a fn-local STRUCT LITERAL is now a frame object and never
# reaches this table at all, and a fn-local STATIC array (over the frame budget, or under
# CYRIUS_STACK_ARRAYS=0) is scoped like a local and marked dead when its block closes, so it is
# skipped rather than stamped. Neither can shadow another file's global any more.
fn FINDVAR(S, noff): i64 {
    var vi = _findvar_core(S, noff);
    if (vi >= 0) { _vis_check_var(S, vi, noff); }
    return vi;
}

# Cross-file access to a file-private global. Same hard-error contract as the fn side
# (v6.5.0 Phase 3): reported via `_had_error` so every violation surfaces in one run
# and no binary is emitted.
var _vcv_last_vi = 0 - 1;   # v6.6.4: dedup key — (var, source line) of the last report
var _vcv_last_line = 0 - 1;
fn _vis_check_var(S, vi, noff): i64 {
    var owner = GVFI(S, vi);
    if (owner == 0) { return 0; }          # public, a local, or unrecorded
    var here = FM_FILEID(S, GTLINE(S, GTI(S))) + 1;
    if (here == 0) { return 0; }
    if (here == owner) { return 0; }       # same file — allowed
    # v6.6.4: a struct-field access (`_gs.a`) resolves its base TWICE — once on the
    # lookahead, once on the resolve — and reported the same violation at two columns.
    # One report per (var, line): the gate's "exactly once" contract, and a reader
    # gets one line per offending line of code.
    var _vcv_line = GTLINE(S, GTI(S));
    if (vi == _vcv_last_vi) { if (_vcv_line == _vcv_last_line) { return 1; } }
    _vcv_last_vi = vi;
    _vcv_last_line = _vcv_line;
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": '", 3);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' is private to its file\n", 25);
    _had_error = 1;
    return 1;
}

# v6.2.11: constant-collision guardrail (issue 2026-06-14). cyrius has a FLAT
# data-symbol namespace and silently lets the LAST definition of a name win.
# When two co-linked modules define the same name with DIFFERENT compile-time
# values (e.g. patra `enum TokType { TK_IDENT = 2 }` vs vyakarana `var TK_IDENT
# = 0`, or net `var SYS_SOCKET = 41` vs syscalls `enum { SYS_SOCKET = 198 }`),
# whichever loses gets the other's value substituted into its code with no
# warning — the owl/patra `TK_IDENT`-aliases-`TK_EOF` corruption. This mirrors
# the duplicate-`fn` warning (parse_fn.cyr) for data symbols: called at the
# enum-member + literal-`var` registration sites with the NEW name+value BEFORE
# the new entry is written, so the lookup sees only PRIOR definitions. (6.6.6: the
# lookup is `_findvar_core`, not FINDVAR — see the note on the call below.) The prior's
# compile-time value comes from the enum-const-fold table (_vecv_base raw value,
# "is enum const" = the GVECP presence byte map) or, for a literal-init global, the static-init table
# (0x1EC000). #ifdef platform variants never collide here — PREPROCESS strips
# the inactive branch before registration, so only the active value is seen.
# WARN only — never blocks the build. This is a best-effort lint that catches
# the dangerous two-module collisions (one def per module); it deliberately
# under-fires (false-negatives only, never false-positives) in these cases:
#   - a prior literal-init-to-ZERO global is indistinguishable from an
#     uninitialised 0x1EC000 slot, so a `var X = 0` prior is not compared (the
#     dangerous SYS_*/ERR_* cases are enum or nonzero). 6.6.9: when the NEW
#     definition is a nonzero enum constant, CHK_ENUM_OVER_VAR (above) reports it;
#   - value-identical redefinitions are silent (intended);
#   - (no index cap on either half any more.) 6.6.6 bite 19c removed a blanket
#     `if (pi >= 1024) { return 0; }` over the WHOLE function, which made a LITERAL-init
#     prior invisible past 1024 and silenced the warning in exactly the large programs
#     that collide (measured: 1100 globals, then `var a = 5; var a = 7;`, no warning).
#     The ENUM half stayed capped at 1024 by the fold table's presence map until 6.6.8,
#     which sized that map to the var table — an enum prior past 1024 now warns too;
#   - cx used to record only a REDECLARED constant in 0x1EC000 (its first literal
#     took the runtime-store path), so a two-link collision was not seen there.
#     ⚠ 6.6.6 bite 19d changed that: cx now records EVERY folded constant global,
#     so a two-link collision IS reported on cx and its warnings agree with the
#     host's. MEASURED with cx compilers built from the pre-19d tree and from this
#     one: `var dupa = 5; var dupa = 7;` -> old cx silent, new cx and host both
#     warn; a three-link chain -> old cx 1 warning, new cx and host 2.
# 6.6.6: "last definition wins" is now what the compiler DOES, for every read —
# a redeclaration shares the global's slot and a constant one is its value from
# program start (see _gv_supersede, parse_decl.cyr). It used to be a second
# slot, so this warning described a semantics nobody implemented (the earlier
# read got 0). A constant redeclaration now records its value, so a 3rd+ link
# of a chain is compared against the 2nd (it used to compare against 0 and stay
# silent). CHANGELOG [6.6.6]
# 6.6.9 — THE ENUM-AFTER-VAR HALF OF THE PAIRING. CHK_ENUM_SHADOW refuses a var declared
# after an enum constant of the same name, and CHKDUPVAL compares values when both sides are
# compile-time literals. The case neither saw: a global whose value is ZERO or COMPUTED
# (`var A = 0;`, `var A = f();`, `var A = "s";` — nothing recorded in the static-init table),
# then an enum member `A`. Every later use folds to the constant — the variable's own module
# included — with no diagnostic. Measured: `var A = f();` then `enum { A = 4130 }` built rc 0
# and read 4130 everywhere. A WARNING (as CHKDUPVAL is) so existing builds keep compiling; a
# zero constant over such a var is not compared (a zero var and a zero constant agree).
# CHANGELOG [6.6.9]
fn CHK_ENUM_OVER_VAR(S, noff, newval): i64 {
    if (newval == 0) { return 0; }
    var pi = _findvar_core(S, noff);
    if (pi < 0) { return 0; }
    if (GVECP(S, pi) == 1) { return 0; }                 # prior is an enum const: CHKDUPVAL
    if (L64(_vgsi_base + pi * 8) != 0) { return 0; }     # prior literal recorded: CHKDUPVAL
    syscall(SYS_WRITE, 2, "warning:", 8);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": duplicate symbol '", 20);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' is an enum constant here and a global variable before it (value 0 or computed) — every use now reads the constant, including the variable's own module\n", 155);
    return 0;
}

fn CHKDUPVAL(S, noff, newval): i64 {
    # 6.6.6: _findvar_core, not FINDVAR — this is a DECLARATION-time probe of a name being
    # registered, not a reference to the prior global, so it must not run the cross-file
    # `private` check. See _findvar_core.
    var pi = _findvar_core(S, noff);
    if (pi < 0) { return 0; }
    var pval = 0;
    var phas = 0;
    if (GVECP(S, pi) == 1) {          # out-of-band flag → prior is an enum const
        pval = L64(_vecv_base + pi * 8);
        phas = 1;
    } else {
        var plit = L64(_vgsi_base + pi * 8);   # prior literal-init global
        if (plit != 0) { pval = plit; phas = 1; }
    }
    if (phas == 1) {
        if (pval != newval) {
            syscall(SYS_WRITE, 2, "warning:", 8);
            _err_head(S);
            syscall(SYS_WRITE, 2, ": duplicate symbol '", 20);
            PRSTR(S + 0xEC00000 + noff);
            syscall(SYS_WRITE, 2, "' redefined with conflicting value (last definition wins)\n", 58);
            # v6.5.50 — a `SYS_*` redefinition is not a cosmetic name collision, and the
            # generic wording above hides that. The stdlib's syscall numbers are ARCH-AWARE
            # (lib/syscalls.cyr -> syscalls_x86_64_linux.cyr / syscalls_aarch64_linux.cyr);
            # a consumer's own `var SYS_FOO = <x86_64 number>` agrees on x86 and WINS
            # everywhere else, so the emitted svc issues a different, valid syscall and the
            # build succeeds. MEASURED under qemu on the two live instances found at v6.5.37:
            # `sys_umount2` was issuing getpid(2) on every ELF-aarch64 build. Filed from
            # darshana, where the only diagnostic read as lint.
            # ⚠ Deliberately NOT gated on the target. The general "is this number right for
            # this arch" question needs an x86_64->aarch64 CORRESPONDENCE TABLE the compiler
            # does not have, but THIS case needs no table: a conflicting SYS_* redefinition is
            # wrong on every target whose numbers differ, and the author of a cross-compiled
            # source cannot know which targets that will be.
            if (load8(S + 0xEC00000 + noff) == 83) {
                if (load8(S + 0xEC00000 + noff + 1) == 89) {
                    if (load8(S + 0xEC00000 + noff + 2) == 83) {
                        if (load8(S + 0xEC00000 + noff + 3) == 95) {
                            syscall(SYS_WRITE, 2, "note: 'SYS_*' names a syscall number, and the stdlib's is ARCH-AWARE\n", 69);
                            syscall(SYS_WRITE, 2, "      overriding it emits a DIFFERENT syscall on every target whose native number differs\n", 90);
                            syscall(SYS_WRITE, 2, "      (aarch64, macOS) - the build succeeds and the wrong call is made silently.\n", 81);
                            syscall(SYS_WRITE, 2, "      Drop the local definition and include lib/syscalls.cyr instead.\n", 70);
                        } } } }
        }
    }
    return 0;
}

# v6.3.24: HARD-ERROR when a `var` is declared with the same name as an existing
# ENUM CONSTANT. Distinct from CHKDUPVAL (var-vs-var literal conflict → a warning,
# to preserve the intentional-override pattern): a var shadowing an enum constant
# is almost always a bug and SILENTLY miscompiles. FINDVAR returns last-match, so
# once the var is registered EVERY later `NAME` reference — including inside
# already-parsed library code that uses the constant as an ABI offset — binds to
# the var's slot instead of the folded constant. A consumer `var DB_PATH = "…"`
# shadowing patra's `enum DbOff { DB_PATH = 16 }` made `patra_open`'s
# `store64(db + DB_PATH, …)` add a string POINTER as an offset → out-of-bounds
# store → runtime SIGSEGV (the yeo-cy-test / SecureYeoman probe crash, misfiled as
# a "string-literal global holds garbage at scale" codegen bug — the string value
# is fine; the NAME collides). CHKDUPVAL missed it twice: it only ran for `= NUM ;`
# inits (a string/expr init never reached it) and its fold-table probe capped at
# index 1024 until 6.6.8 (large consumer stacks exceed it). var_enum_id (GVENUMID) is the
# reliable, uncapped, growable per-symbol marker (1-based enum-id; 0 = plain var).
# Fail loud so the collision surfaces at compile time — the fix is to rename the
# variable. See issues/archived/2026-07-01-string-literal-global-garbage-in-large-programs.md.
#
# 6.6.6: `_findvar_core`, not `FINDVAR` — this is the THIRD declaration-time probe, and it was
# missed when the other two moved. It runs for every global whose initializer is NOT an int
# literal (`chk_has == 0`), so with a `private` file already owning the name, `var X = 2 + 3;`
# / `= "abcd"` / `= f();` in another `private` file was reported as an illegal ACCESS to the
# first file's X rather than compiled. The 19b gate could not see it: every accepting row it
# had used `= NUM ;`, which takes the CHKDUPVAL path instead. CHANGELOG [6.6.6]
fn CHK_ENUM_SHADOW(S, noff): i64 {
    var pi = _findvar_core(S, noff);
    if (pi < 0) { return 0; }
    if (GVENUMID(S, pi) == 0) { return 0; }   # prior symbol is a plain var, not an enum const
    syscall(SYS_WRITE, 2, "error:", 6);
    _err_head(S);
    syscall(SYS_WRITE, 2, ": variable '", 12);
    PRSTR(S + 0xEC00000 + noff);
    syscall(SYS_WRITE, 2, "' shadows an enum constant (rename the variable)\n", 49);
    syscall(SYS_EXIT, 1);
    return 0;
}
