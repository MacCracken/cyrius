# F6 — no `impl Tr for T`.
fn _dyn_f6(S, ti, tx): i64 {
    if (_dyn_ebeg(S, ti) == 0) { return 0 - 1; }
    PRSTR("no `impl ");
    _dyn_pn(S, L64(_tr_tab + tx * 32));
    PRSTR(" for ");
    syscall(SYS_WRITE, 2, _dsr_tp, _dsr_tn);
    PRSTR("` - a ");
    _dyn_ps(S, _dsr_ds);
    PRSTR(" is formed only from a type that implements ");
