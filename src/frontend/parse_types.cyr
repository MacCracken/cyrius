    return 1;
}
# Slot `k`'s fn for impl `ii` (T's own method, or T's default instance — `T_Trait_m` when the name
# collides), -1 for a member that is no slot.
fn _dyn_slot_fi(S, ii, k): i64 {
    if (_dyn_slot_ok(S, k) == 0) { return 0 - 1; }
    var m = L64(_trm_tab + k * 32);
    return _tr_findfn_join(S, _tr_prefix(S, ii, m), m);
