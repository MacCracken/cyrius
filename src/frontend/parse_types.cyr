# The vtable of trait `tx`: a hidden global of one word per member (at least one: a zero-size
# global's store overwrote its neighbour), named nothing and dead to FINDVAR (`_HTEMP`'s top-level
# arm). Registered inside a fn too, and program-wide BY DESIGN: every forming site, of every call,
# thread and file, writes the same words (tests/gates/codegen/hidden_temp_census.sh names it). Its index.
fn _dyn_vt_reg(S, tx): i64 {
    var n = L64(_tr_tab + tx * 32 + 16);
    if (n < 1) { n = 1; }
    var _dvt = GVCNT(S);
    S64(_varn_base + _dvt * 8, 0);
    S64(_vars_base + _dvt * 8, n * 8);
    SVDEAD(S, _dvt, 1);
    SVCNT(S, _dvt + 1);
    return _dvt;
