# PARSER — types, structs, enums, unions + shared helpers
# ================================================================
# Split out of src/frontend/parse.cyr in v5.5.38 to keep single-file
# LOC under ~1500. Included by parse.cyr at the same textual position
# the original content lived, so the flattened fn-definition order is
# preserved (self-host byte-identical by construction). No logical
# change from the original inline version.

# ================================================================
# STRUCT SUPPORT
# ================================================================
# Heap layout for structs — see src/main.cyr for the authoritative map.
# Quick reference of the regions this file touches:
#   0x13A000 var_types[8192]      65536 bytes — struct_id per var (0=scalar)
#   0x1A6018  struct_names[1024]   8192 bytes — name offset per struct (cap 1024 since v6.0.47)
#   0x1A8018  struct_fcounts[1024] 8192 bytes — field count per struct (bit 63 = union; v6.0.47)
#   0x91A000 struct_ftypes        65536 bytes — PACKED field-type pool (v6.0.47): 8192 entries × 8B, addr=(field_base[si]+fc)*8. ftype: >0 sid / 0 i64 / <0 -width / far-neg = Vec<T> handle sentinel (v6.4.x, MKVEC)
#   0x92A000 struct_fnames        65536 bytes — PACKED field-name pool (v6.0.47): 8192 entries × 8B, same indexing
#   0x18F830  struct_count         8 bytes
#   0x1D8000  enum_const_val[65536] 65536 bytes — RAW enum value per var slot (v5.5.2); a grown var-family table (_vecv_base, _grow_g5), presence in the GVECP byte map (util.cyr)

fn GSTC(S): i64 { return L64(S + 0x18F830); }
fn SSTC(S, v): i64 { S64(S + 0x18F830, v); return 0; }

# R3 (v6.4.15): the pure i8/i16/i32/i64 type-name -> byte-width ladder, hand-
# duplicated across 6 shape-A sites (struct/union field + Vec element, #assert
# sizeof, expression sizeof). Returns 1/2/4/8, else 0. The four masks are
# mutually exclusive (distinct name bytes) so if/return == the former if/elif
# chain. Narrow slice only — the complex annotation ladders (unsigned/f64/f32/
# u128/SIMD-order-sensitive) in parse_decl.cyr keep their inline form.
fn _scalar_name_width(name64): i64 {
    if (name64 & 0xFFFF == 0x3869) { return 1; }
    if (name64 & 0xFFFFFF == 0x363169) { return 2; }
    if (name64 & 0xFFFFFF == 0x323369) { return 4; }
    if (name64 & 0xFFFFFF == 0x343669) { return 8; }
    return 0;
}

# 6.6.10 — the same ladder for a FIELD type, which must match the WHOLE name. The masks above
# test only the leading bytes, so `v: i16v8` registered a 2-byte i16 field and `v: i64v2` an
# 8-byte one, silently; a vector (or `i8foo`) now falls through to the named-type path, where
# it is refused by name. Since 6.6.16 every other site resolves through _tn_resolve below.
# CHANGELOG [6.6.10]
fn _field_scalar_width(name64): i64 {
    var w = _scalar_name_width(name64);
    if (w == 1) { if ((name64 >> 16) & 0xFF != 0) { return 0; } }
    if (w > 1) { if ((name64 >> 24) & 0xFF != 0) { return 0; } }
    return w;
}

# ⛔ 6.6.16 (C8) — ONE TYPE-NAME VOCABULARY. sizeof, `#assert sizeof` and every annotation
# (a local, a global, `*T`, `[T]` / `slice<T>`, a param, a return, a multi-value return element)
# had a ladder of its own. Most matched a name's PREFIX — `var a: i8x = 300` was an i8 (it read
# 44), `var a: f64zz` an f64, and `var p: u8pair;` (a struct) was a u8 scalar BEFORE the struct
# lookup ran — and almost all read a name they did not know as a silent i64 (`var a: Nonexist`,
# `fn f(a: i16q)`, `fn f(): (i64, Nope)`). sizeof knew only i8..i64, u128 and structs, so
# `sizeof(f64)` / `sizeof(u8)` / `sizeof(bool)` did not compile. Every one of those sites now
# resolves here, by the WHOLE name, and a name that is no type is refused by name (_tn_refuse).
# The struct lookup goes FIRST, as _classify_return_type's always has. CHANGELOG [6.6.16]
#
# THE CODE BAND. A resolved name is one value in a band of its own, `0x7E000000 | class << 16 |
# val`, that no table stores and no other encoding uses: it is not a struct sid (1..1024) nor
# `0 - sid` (GLTYPE, pscale, GVTYPE's pointer scale), not a width (SLTYPE 1/2/4/8, `0 - width`
# from _tp_resolve / scalar_type), not the F64_TYID..FUTURE_TYID band (0x40000001..4), not the
# SIMD descriptor band (<= -2048), not MULTIRET_SID (-40) and not the `0 - 1000 - gvi`
# global-deref band. A caller reads a code ONLY through the accessors below (_tn_iw, _tn_sgn,
# _tn_flt, _tn_sid, _tn_vec, _tn_bytes) and stores what it always stored — a width, a sid, a
# sentinel, a float tag — so no code ever reaches SLTYPE, SVTYPE, GFRS/GFRT, SPSC, pscale,
# scalar_type or a global's init blob, and one that leaked could not be read as any of them.
#   class 1  signed integer     i8 i16 i32 i64           val = its bytes
#   class 2  unsigned integer   u8 u16 u32 u64           val = its bytes
#   class 3  float              f32 f64                  val = its bytes
#   class 4  an 8-byte handle   val: 1 bool, 2 an enum, 3 Result, 4 Option, 5 Tagged, 6 cstring,
#                               7 a type parameter, 8 Vec (a vec_new() handle; the `<T>` of
#                               `Vec<T>` is skipped by each site, as it always was)
#   class 5  a SIMD vector      val = 0 - its descriptor sentinel (f64v2 2093, i8v16 2178, ...)
#   class 6  a struct or union  val = its sid
# `u128` is a keyword token, never a name: its sites handle token 105 before the lookup.
fn _tn_code(cls, val): i64 { return 0x7E000000 | (cls << 16) | val; }
fn _tn_class(c): i64 {
    if ((c >> 24) != 0x7E) { return 0; }
    return (c >> 16) & 0xFF;
}
fn _tn_val(c): i64 { return c & 0xFFFF; }

# The builtin scalar names, each matched WHOLE (the NUL is in the mask). 0 = not one of them.
fn _tn_scalar(n): i64 {
    if ((n & 0xFFFFFF) == 0x003869) { return _tn_code(1, 1); }      # i8
    if ((n & 0xFFFFFF) == 0x003875) { return _tn_code(2, 1); }      # u8
    var lo = n & 0xFFFFFFFF;
    if (lo == 0x00363169) { return _tn_code(1, 2); }                # i16
    if (lo == 0x00323369) { return _tn_code(1, 4); }                # i32
    if (lo == 0x00343669) { return _tn_code(1, 8); }                # i64
    if (lo == 0x00363175) { return _tn_code(2, 2); }                # u16
    if (lo == 0x00323375) { return _tn_code(2, 4); }                # u32
    if (lo == 0x00343675) { return _tn_code(2, 8); }                # u64
    if (lo == 0x00343666) { return _tn_code(3, 8); }                # f64
    if (lo == 0x00323366) { return _tn_code(3, 4); }                # f32
    if ((n & 0xFFFFFFFFFF) == 0x006C6F6F62) { return _tn_code(4, 1); }   # bool
    if (lo == 0x00636556) { return _tn_code(4, 8); }                # Vec — the field vocabulary's handle
    return 0;
}

# A _classify_return_type value (also a bound type parameter's _tp_resolve value) as a code.
fn _tn_from_rc(rc): i64 {
    if (rc > 0) { return _tn_code(6, rc); }
    if (rc <= 0 - 2048) { return _tn_code(5, 0 - rc); }
    if (rc == 0 - 9) { return _tn_code(3, 8); }                     # f64
    if (rc >= 0 - 8) { if (rc < 0) { return _tn_code(1, 0 - rc); } }   # i8 / i16 / i32 / i64
    if (rc <= 0 - 16) { if (rc >= 0 - 19) { return _tn_code(4, 0 - rc - 13); } }   # Result Option Tagged cstring
    return 0;
}

# The name at `noff`, with no scope: a struct or union (first), a builtin scalar, Result / Option /
# Tagged / cstring, a vector, or an enum declared on either side (its values are i64). 0 = none.
fn _tn_resolve(S, noff): i64 {
    var c = _tn_from_rc(_classify_return_type(S, noff));
    if (c != 0) { return c; }
    c = _tn_scalar(L64(S + 0xEC00000 + noff));
    if (c != 0) { return c; }
    if (_is_enum_name(S, noff) == 1) { return _tn_code(4, 2); }
    if (_declared_later(S, noff, 60, 60) == 1) { return _tn_code(4, 2); }
    return 0;
}

# The name at token `ti`, in scope: _tn_resolve, else a type parameter in scope there (8 bytes,
# the i64 base): a bound one, the declaring struct's own, the enclosing generic fn's (its body or
# its signature — CYRIUS_MONOMORPH=0 binds and captures nothing, so these read the tokens).
fn _tn_resolve_at(S, ti): i64 {
    var noff = TOKVAL(S, ti);
    if (_tp_resolve(S, noff) != 0) { return _tn_code(4, 7); }   # bound: callers that size it bind first
    var c = _tn_resolve(S, noff);
    if (c != 0) { return c; }
    if (_tn_tparam(S, ti, noff) == 1) { return _tn_code(4, 7); }
    return 0;
}
fn _tn_tparam(S, ti, noff): i64 {
    if (_is_own_tparam(S, noff) == 1) { return 1; }
    if (_arr_fn_tparam(S, ti, noff) == 1) { return 1; }
    return _tn_sig_tparam(S, ti, noff);
}
# Is `noff` (at token `ti`, in a fn SIGNATURE — a param or return type) one of that fn's own
# `<T, ..>`? The signature holds no `{`, `}` or `;`, so meeting one means `ti` is not in one.
fn _tn_sig_tparam(S, ti, noff): i64 {
    var k = ti - 1;
    while (k >= 0) {
        var t = TOKTYP(S, k);
        if (t == 13 || t == 14 || t == 5) { return 0; }
        if (t == 32) {
            if (TOKTYP(S, k + 2) != 19) { return 0; }   # `fn name <`
            var j = k + 3;
            t = TOKTYP(S, j);
            while (t != 20 && t != 10 && t != 12) {
                if (t == 2) { if (STREQ(S, TOKVAL(S, j), noff) == 1) { return 1; } }
                j = j + 1;
                t = TOKTYP(S, j);
            }
            return 0;
        }
        k = k - 1;
    }
    return 0;
}

# The accessors — the only way a code is read.
fn _tn_iw(c): i64 {                         # an integer's width (iN / uN), else 0
    var k = _tn_class(c);
    if (k == 1 || k == 2) { return _tn_val(c); }
    return 0;
}
fn _tn_sgn(c): i64 {                        # 1 for a SIGNED sub-i64 integer (loads sign-extend)
    if (_tn_class(c) == 1) { if (_tn_val(c) < 8) { return 1; } }
    return 0;
}
fn _tn_flt(c): i64 {                        # F64_TYID / F32_TYID, else 0
    if (_tn_class(c) != 3) { return 0; }
    if (_tn_val(c) == 8) { return F64_TYID; }
    return F32_TYID;
}
fn _tn_sid(c): i64 {                        # a struct's sid, else 0
    if (_tn_class(c) == 6) { return _tn_val(c); }
    return 0;
}
fn _tn_bool(c): i64 {                       # 1 for `bool` (6.7.3), else 0
    if (_tn_class(c) == 4) { if (_tn_val(c) == 1) { return 1; } }
    return 0;
}
fn _tn_vec(c): i64 {                        # a vector's descriptor sentinel (<= -2048), else 0
    if (_tn_class(c) == 5) { return 0 - _tn_val(c); }
    return 0;
}
fn _tn_init_w(c): i64 {                     # 6.6.16 (C1): the bytes of an array element an
    var w = _tn_iw(c);                      # integer constant initializes — iN / uN its width,
    if (w > 0) { return w; }                # bool and an enum 8 — else 0 (a float, a struct, a
    if (_tn_class(c) == 4) {                # vector, a handle no constant makes)
        var v = _tn_val(c);
        if (v == 1 || v == 2) { return 8; }
    }
    return 0;
}
# sizeof: an integer or float its width; a handle (bool, an enum, cstring, Result, Option,
# Tagged, Vec, a type parameter's i64 base) 8; a vector 16 / 32; a struct STRUCTSZ. This is exactly
# what `var a: T[N]` reserves per element (_arr_ebytes), so the array is N * sizeof(T).
fn _tn_bytes(S, c): i64 {
    var k = _tn_class(c);
    if (k == 6) { return STRUCTSZ(S, _tn_val(c) - 1); }
    if (k == 5) {
        _vec_desc(S, 0 - _tn_val(c));
        return GVEC_NSLOTS(S) * 8;
    }
    if (k == 4) { return 8; }
    if (k >= 1) { return _tn_val(c); }
    return 0;
}

# The refusal: ONE named error, reported AT the name (`ti`), the cursor put back, and the panic
# latch this error set cleared — the declaration parses on as a plain i64, so each bad name is
# reported once, with no cascade, and every bad name of a file is reported. An error that already
# held the latch is left alone. `--syntax-only` (lint's pre-pass) resolves nothing and refuses
# nothing, as _arr_name_ebytes does. `tail` / `noff2` are ERR_IDENT's (the site, and a var name
# or -1). A struct or union declared BELOW a site that needs it above keeps its own message.
fn _tn_refuse(S, ti, tail, noff2): i64 {
    if (_syntax_only == 1) { return 0; }
    if (_panic == 1) { return 0; }
    if (_tn_once(S, ti) == 0) { return 0; }
    var noff = TOKVAL(S, ti);
    var sv = GTI(S);
    STI(S, ti);
    if (_declared_later(S, noff, 40, 101) == 1) {
        ERR_IDENT(S, "type ", noff, " is declared after its use; declare it above the first use", 0 - 1);
    } else {
        ERR_IDENT(S, "unknown type ", noff, tail, noff2);
        _tn_prefix_note(S, noff);
        PRSTR("  note: a type is i8..i64, u8..u64, u128, f32, f64, bool, cstring, Result, Option, Tagged, Vec, an enum, a vector type, or a struct or union (missing include?)\n");
    }
    STI(S, sv);
    _panic = 0;
    return 0;
}
# `i8x` is not `i8`: name the builtin a misspelling starts with, since the prefix used to be enough.
fn _tn_prefix_note(S, noff): i64 {
    var n = L64(S + 0xEC00000 + noff);
    var k = 0;
    if (_tn_scalar(n & 0xFFFF) != 0) { k = 2; }
    if (_tn_scalar(n & 0xFFFFFF) != 0) { k = 3; }
    if (_tn_scalar(n & 0xFFFFFFFF) != 0) { k = 4; }
    if (k == 0) { return 0; }
    PRSTR("  note: '");
    PRSTR(S + 0xEC00000 + noff);
    PRSTR("' is not '");
    syscall(SYS_WRITE, 2, S + 0xEC00000 + noff, k);
    PRSTR("' - a type name must match whole\n");
    return 0;
}
# A generic fn's body is parsed once for its base and once per instance, so the same name would
# be refused on every pass: one byte per token (lazily allocated) reports it the first time only.
var _tn_seen = 0;
var _tn_seen_n = 0;
fn _tn_once(S, ti): i64 {
    if (_tn_seen == 0) {
        _tn_seen_n = GTCNT(S) + 1;
        _tn_seen = alloc(_tn_seen_n);
        if (_tn_seen == 0) { return 1; }
    }
    if (ti < 0 || ti >= _tn_seen_n) { return 1; }
    if (load8(_tn_seen + ti) == 1) { return 0; }
    store8(_tn_seen + ti, 1);
    return 1;
}

# A type annotation at token `ti` (a local or a global; `vnoff` the variable): its code, or 0
# after the refusal. The caller takes the width / sign / float / sid / vector through the
# accessors; a refused name leaves all of them 0, i.e. a plain i64. An ARRAY element (`T[N]`,
# the `[` next) is not refused here: _arr_name_ebytes names it as an array element.
fn _tn_ann(S, ti, vnoff): i64 {
    if (TOKTYP(S, ti) == 10) { STI(S, ti); return _tn_code(6, _tup_type(S, 0)); }   # 6.7.7 (B4): `(T, ..)`
    var c = _tn_resolve_at(S, ti);
    if (c == 0) {
        if (TOKTYP(S, ti + 1) != 28) { _tn_refuse(S, ti, " for variable ", vnoff); }
    }
    return c;
}

# A `var` annotation's code (a local, or a global after the first statement). A type parameter
# the default build BOUND (`_tp_resolve`: T -> i64 in the base, T -> its argument in an instance)
# is its argument's code, so `var y: T` / `var a: T[N]` in the `g<f64>` instance are exactly
# `var y: f64` / `var a: f64[N]` — the accessors give the width, the sign of i8/i16/i32, the
# float tag, the sid. That arm used to read the binding's raw code as a width: T = f64 (-9) made
# a 9-byte word (`T[N]` reserved 9 * N while sizeof(T) is 8) and T = i8 never sign-extended.
fn _tn_var_ann(S, ti, vnoff): i64 {
    if (TOKTYP(S, ti) == 10) { return _tn_ann(S, ti, vnoff); }   # 6.7.7: a tuple, before the binding
    var b = _tp_resolve(S, TOKVAL(S, ti));
    if (b != 0) { return _tn_from_rc(b); }
    return _tn_ann(S, ti, vnoff);
}
# 6.7.7 (B4): the first token of a `var` annotation's named type — an IDENT, or the `(` of a tuple
# type. One call where the declaration ladders read `PEEKT(S) == 2` (no hot body gains a reference).
fn _tn_head(S): i64 {
    var t = PEEKT(S);
    if (t == 2 || t == 10) { return 1; }
    return 0;
}

# A slice element's first token (PARSE_VAR's `[T]` / `slice<T>` arms): a name, `u128`, or (6.7.7) a
# tuple's `(`, which _tn_slice_w refuses by name. One call where the arms read two.
fn _tn_slice_head(S): i64 {
    var t = PEEKT(S);
    if (t == 2 || t == 105 || t == 10) { return 1; }
    return 0;
}

# ⛔ 6.7.7 (B4) — TUPLE TYPES (the user's decision, 2026-10-08). `(T1, T2, ..)` is an ANONYMOUS
# STRUCT of 8-byte slots, interned ONCE per element list in the struct table under its canonical
# spelling `(i64, f64)` — the name every struct diagnostic prints. `(` is never an identifier byte,
# so the name collides with no user struct and no minted `Box$..`. Its fields are named "0", "1",
# .. (FINDFIELD compares names by content, so the lexer's `t.0` selector finds them), every one 8
# bytes: i64 an integer word, f64 a float field (GFFK), bool a checked bool field (GFBOOL). From
# there a tuple IS a struct for every existing rule — inline locals and globals, copies
# type-checked by sid (equal element lists are the same sid), struct fields, `t.0` reads and
# writes, OP=. The vocabulary is i64 / f64 / bool; every other element, and every type position
# the decision leaves open, is refused by name. Interning registers a struct, so it must never run
# INSIDE another struct's definition (REGSTRUCT starts the new struct's fields at the field pool's
# top): PARSE_STRUCT_DEF interns its tuple fields before it registers (`_sdef_tup_prescan`) and
# then only looks them up. CHANGELOG [6.7.7]
var _tup_fnames = 0;   # the field names "0".."255": name-pool offset + 1, minted on first use
fn _tup_fname(S, k): i64 {
    if (_tup_fnames == 0) { _tup_fnames = alloc(256 * 8); }
    var o = load64(_tup_fnames + k * 8);
    if (o != 0) { return o - 1; }
    NPOS_GUARD(S, 4);
    var np = GNPOS(S);
    var w = np;
    if (k >= 100) { store8(S + 0xEC00000 + w, 48 + k / 100); w = w + 1; }
    if (k >= 10) { store8(S + 0xEC00000 + w, 48 + (k / 10) % 10); w = w + 1; }
    store8(S + 0xEC00000 + w, 48 + k % 10);
    store8(S + 0xEC00000 + w + 1, 0);
    SNPOS(S, w + 2);
    store64(_tup_fnames + k * 8, np + 1);
    return np;
}
# 1 = struct `sid` (1-based) is a tuple type: its name starts with `(`.
fn _tup_is(S, sid): i64 {
    if (sid <= 0) { return 0; }
    if (sid > GSTC(S)) { return 0; }
    if (load8(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8)) == 40) { return 1; }
    return 0;
}
# A tuple refusal at token `ti`: "<msg>['<name>'][<tail>]". Reported ONCE per token, in sync — the
# panic latch is left as it was, so every refusal of a file is reported and none swallows the next
# statement — and not at all under `--syntax-only` (lint's pre-pass resolves no type). 1 = reported.
fn _tup_err(S, ti, msg, noff, tail): i64 {
    return _dyn_err(S, ti, msg, 0, noff, tail);   # 6.7.8: the one reporter, shared with dyn
}
# Cursor on a tuple type's `(` in a position the decision leaves open (`what` names it): refused by
# name at the `(`, and the whole `( .. )` consumed — the parse goes on in sync.
fn _tup_pos_refuse(S, what): i64 {
    var ti = GTI(S);
    _tup_err(S, ti, "a tuple type cannot be ", 0 - 1, what);
    STI(S, _call_close(S, ti) + 1);
    return 0;
}
# One element of a tuple type, consumed through the next depth-0 `,` or `)`: 1 = i64, 2 = f64,
# 3 = bool. Anything else is refused (`mode` 0) and read as i64, so `t.0` uses do not cascade.
fn _tup_elem(S, mode): i64 {
    var ti = GTI(S);
    var t = PEEKT(S);
    var k = 1;
    if (t == 2) {
        var c = _tn_resolve_at(S, ti);
        if (c == _tn_code(1, 8)) { k = 1; }
        elif (c == _tn_code(3, 8)) { k = 2; }
        elif (c == _tn_code(4, 1)) { k = 3; }
        elif (mode == 0) {
            if (c == 0) { _tn_refuse(S, ti, " as a tuple element", 0 - 1); }
            elif (_tn_class(c) == 6) { _tup_err(S, ti, "a tuple element is i64, f64 or bool, not struct ", TOKVAL(S, ti), 0); }
            else { _tup_err(S, ti, "a tuple element is i64, f64 or bool, not ", TOKVAL(S, ti), 0); }
        }
    } elif (mode == 0) {
        if (t == 31 || t == 11) { _tup_err(S, ti, "an empty element in a tuple type", 0 - 1, 0); }
        elif (t == 8) { _tup_err(S, ti, "a tuple element is i64, f64 or bool, not a pointer `*T`", 0 - 1, 0); }
        elif (t == 10) { _tup_err(S, ti, "a tuple element is i64, f64 or bool, not a nested tuple", 0 - 1, 0); }
        elif (t == 28) { _tup_err(S, ti, "a tuple element is i64, f64 or bool, not a slice", 0 - 1, 0); }
        elif (t == 105) { _tup_err(S, ti, "a tuple element is i64, f64 or bool, not u128", 0 - 1, 0); }
        else { _tup_err(S, ti, "a tuple element is i64, f64 or bool", 0 - 1, 0); }
    }
    _tup_skip_elem(S);
    return k;
}
fn _tup_skip_elem(S): i64 {
    var d = 0;
    var go = 1;
    while (go == 1) {
        var t = PEEKT(S);
        if (t == 12 || t == 5 || t == 13 || t == 14 || t == 4) { return 0; }
        if (d == 0) { if (t == 31 || t == 11) { return 0; } }
        if (t == 10 || t == 28 || t == 19) { d = d + 1; }
        elif (t == 11 || t == 29 || t == 20) { d = d - 1; }
        elif (t == 39) { d = d - 2; }
        elif (t == 152) { d = d - 3; }
        if (d < 0) { d = 0; }
        STI(S, GTI(S) + 1);
    }
    return 0;
}
# Append element `n` (kind `k`) to the canonical name being built at `w`; returns the new end.
fn _tup_put(S, w, n, k): i64 {
    var p = S + 0xEC00000;
    if (n > 0) { store8(p + w, 44); store8(p + w + 1, 32); w = w + 2; }
    if (k == 3) {
        store8(p + w, 98); store8(p + w + 1, 111); store8(p + w + 2, 111); store8(p + w + 3, 108);
        return w + 4;
    }
    if (k == 2) { store8(p + w, 102); } else { store8(p + w, 105); }
    store8(p + w + 1, 54);
    store8(p + w + 2, 52);
    return w + 3;
}
# THE INTERNING. Cursor on a tuple type's `(`; returns its sid, the cursor left ON the closing `)`
# (the declaration ladders' shared `STI` steps past it). The canonical name is built at the name
# pool's top and committed only on a miss, which registers the struct and its fields in one run.
# `mode` 0 interns and reports; 1 (inside PARSE_STRUCT_DEF, the replay) only looks up, quietly — a
# miss returns 0; 2 (pass 1's parameter scan, `_tup_pscan`) interns quietly — pass 2 parses the
# same tokens with mode 0 and reports. Arity is 2..256 (the struct field cap); a refused shape
# still interns (`()` and `(T)` padded with i64, past 256 cut), so one refusal is the only error.
fn _tup_type(S, mode): i64 {
    var open = GTI(S);
    if (mode == 0) { _tup_gen_chk(S, open); }
    NPOS_GUARD(S, 1600);
    var np = GNPOS(S);
    store8(S + 0xEC00000 + np, 40);
    var w = np + 1;
    var n = 0;
    var cnt = 0;
    var trail = 0;
    STI(S, open + 1);
    if (PEEKT(S) == 11) {
        if (mode == 0) { _tup_err(S, open, "a tuple type has 2 or more elements - `()` is empty", 0 - 1, 0); }
    } else {
        var go = 1;
        while (go == 1) {
            var k = _tup_elem(S, mode);
            if (n < 256) { w = _tup_put(S, w, n, k); n = n + 1; }
            cnt = cnt + 1;
            go = 0;
            if (PEEKT(S) == 31) {
                STI(S, GTI(S) + 1);
                go = 1;
                if (PEEKT(S) == 11) {
                    if (mode == 0) { _tup_err(S, GTI(S) - 1, "a trailing comma in a tuple type", 0 - 1, 0); }
                    trail = 1;
                    go = 0;
                }
            }
        }
    }
    if (mode == 0) {
        if (cnt + trail == 1) { _tup_err(S, open, "a tuple type has 2 or more elements - write the one type without parentheses", 0 - 1, 0); }
        if (cnt > 256) { _tup_err(S, open, "a tuple type has at most 256 elements", 0 - 1, 0); }
    }
    while (n < 2) { w = _tup_put(S, w, n, 1); n = n + 1; }
    if (PEEKT(S) != 11) { if (mode == 0) { ERR_EXPECT(S, 11); } }
    return _tup_commit(S, np, w, n, mode);
}
# The interning's second half: close the canonical name built at `np` (`n` elements, its end at
# `w`), then look it up — a hit is the sid, the name not committed — or, `mode` != 1, register it
# and its fields in one run.
fn _tup_commit(S, np, w, n, mode): i64 {
    store8(S + 0xEC00000 + w, 41);
    store8(S + 0xEC00000 + w + 1, 0);
    var sid = FINDSTRUCT(S, np);
    if (sid > 0) { return sid; }
    if (mode == 1) { return 0; }
    SNPOS(S, w + 2);
    sid = REGSTRUCT(S, np);
    if (sid == 0) { return 0; }
    _tup_fields(S, sid - 1, np, n);
    return sid;
}
# 6.7.7 (B4) — an UN-ANNOTATED literal's type: `n` i64 elements (2..256, the caller checked), interned
# exactly as the spelled `(i64, .., i64)` is, so `var q = (1, 2);` and `var u: (i64, i64) = q;` are
# one type. Not inside a struct definition (no caller is).
fn _tup_ints(S, n): i64 {
    NPOS_GUARD(S, 1600);
    var np = GNPOS(S);
    store8(S + 0xEC00000 + np, 40);
    var w = np + 1;
    var i = 0;
    while (i < n) {
        w = _tup_put(S, w, i, 1);
        i = i + 1;
    }
    return _tup_commit(S, np, w, n, 0);
}
# The fields of new tuple struct `si`, read back from its canonical name at `np`.
fn _tup_fields(S, si, np, n): i64 {
    var p = np + 1;
    var i = 0;
    while (i < n) {
        var b = load8(S + 0xEC00000 + p);
        var k = 0;
        if (b == 102) { k = 1; }
        if (b == 98) { k = 3; }
        ADDFIELDFK(S, si, _tup_fname(S, i), k);
        while (load8(S + 0xEC00000 + p) != 44 && load8(S + 0xEC00000 + p) != 41) { p = p + 1; }
        p = p + 2;
        i = i + 1;
    }
    return 0;
}
# The `fn` token whose signature or body holds token `ti`, else -1. Read from the tokens: the
# nearest `fn` before `ti` is the enclosing one (fns do not nest) when `ti` is in its signature (no
# `{` between them) or its `{ .. }` body. ⛔ 6.7.8 — a BODYLESS trait member (`fn pick<U>(..): i64;`)
# ends at its `;`: the signature scan stops at a `;` or `}` (a signature holds neither). It ran on
# to the next `{` — a struct's, or nothing — so a tuple-typed zone global or struct field right
# after a trait whose last member is generic was "a tuple type in a generic fn" (6.7.7).
fn _tok_enclosing_fn(S, ti): i64 {
    var k = ti - 1;
    while (k >= 0) {
        if (TOKTYP(S, k) == 32) { break; }
        k = k - 1;
    }
    if (k < 0) { return 0 - 1; }
    var j = k + 1;
    while (j < ti) {
        var t = TOKTYP(S, j);
        if (t == 13) { break; }
        if (t == 5 || t == 14) { return 0 - 1; }
        j = j + 1;
    }
    if (j < ti) { if (_tok_body_spans(S, k, ti) == 0) { return 0 - 1; } }
    return k;
}
# R4 — a tuple type in a GENERIC fn (its signature or its body) is refused: a type parameter and a
# tuple have no rule together yet. Generic when `fn name <` (CYRIUS_MONOMORPH=0 binds nothing).
fn _tup_gen_chk(S, ti): i64 {
    var k = _tok_enclosing_fn(S, ti);
    if (k < 0) { return 0; }
    if (TOKTYP(S, k + 2) != 19) { return 0; }
    return _tup_err(S, ti, "a tuple type in a generic fn is refused - a type parameter and a tuple do not combine yet", 0 - 1, 0);
}

# ⛔ 6.7.8 — CHECKED `dyn` (the user's decisions, 2026-10-07): `o: dyn Show` is an ordinary 16-byte
# struct of two words {data, vtable} — ADR-002's one-word model holds. THE TOKEN FOLD: before any
# prepass records a token index, `dyn X` becomes ONE identifier token named `dyn X` (a space: no
# lexed identifier spells it, so it collides with no user name), and `_dyn_prepass` registers that
# name as a struct before any user struct. Every struct position then takes it unchanged — a
# local, a global, a parameter (pass 1's scan too), a return (the rough pair scan), a field, a
# copy checked by sid. The two words are named " data" / " vtable" (a leading space): no field
# access reaches them (decision 7 — "unknown field 'data' on struct 'dyn Show'"). Each position
# the decisions leave open is refused by name at the prepass, once per token. A unit that spells
# no `dyn` folds nothing (`_lex_dyn_n`, lex.cyr): its tokens are untouched. CHANGELOG [6.7.8]
var _dyn_ix = 0;   # the folded tokens: (index << 2) | 1 when a `+ B` after it was dropped (T2); | 2 a bare `dyn`
var _dyn_nx = 0;
var _dyn_nm = 0;   # one minted name per spelling: (X's name offset, `dyn X`'s)
var _dyn_nn = 0;
var _dyn_wd = 0;   # the word names " data" / " vtable" (name offset + 1), minted once
var _dyn_wv = 0;
var _dyn_hm = 0;   # per struct: 0 = not judged, 1 = holds no dyn, 2 = holds one (`_dyn_held`)

fn _dyn_fold(S): i64 {
    if (_lex_dyn_n == 0) { return 0; }
    _dyn_ix = alloc(_lex_dyn_n * 8);
    _dyn_nm = alloc(_lex_dyn_n * 16);
    var n = GTCNT(S);
    var r = 0;
    var w = 0;
    while (r < n) {
        if (TOKTYP(S, r) == 173) {
            if (TOKTYP(S, r + 1) == 2) {
                r = _dyn_fold1(S, r, w);
                w = w + 1;
                continue;
            }
            _dyn_note(w, 2);   # a `dyn` with no trait name after it: T3, judged by the prepass
        }
        if (w != r) { _dyn_tok_mv(S, w, r); }
        w = w + 1;
        r = r + 1;
    }
    STCNT(S, w);
    return 0;
}
# `dyn` at token `r`, the identifier X after it: ONE identifier at `w`, named `dyn X`, carrying
# `dyn`'s line word (a diagnostic's caret points at `dyn`). A `+ B` run after it is dropped, its
# reason recorded for the prepass (T2), so the parse goes on in sync. The next token to read.
fn _dyn_fold1(S, r, w): i64 {
    var lw = L64(S + 0xCC00000 + r * 8);
    var nm = _dyn_name(S, TOKVAL(S, r + 1));
    S64(S + 0x8C00000 + w * 8, 2);
    S64(S + 0xAC00000 + w * 8, nm);
    STLINE(S, w, lw);
    var q = r + 2;
    var plus = 0;
    while (TOKTYP(S, q) == 6) {
        if (TOKTYP(S, q + 1) != 2) { break; }
        q = q + 2;
        plus = 1;
    }
    _dyn_note(w, plus);
    return q;
}
fn _dyn_note(w, f): i64 {
    S64(_dyn_ix + _dyn_nx * 8, (w << 2) | f);
    _dyn_nx = _dyn_nx + 1;
    return 0;
}
fn _dyn_tok_mv(S, w, r): i64 {
    S64(S + 0x8C00000 + w * 8, TOKTYP(S, r));
    S64(S + 0xAC00000 + w * 8, TOKVAL(S, r));
    STLINE(S, w, L64(S + 0xCC00000 + r * 8));
    return 0;
}
# The name `dyn X` for X at name offset `xnoff` — one offset per spelling (LEXID already gives one
# X one offset).
fn _dyn_name(S, xnoff): i64 {
    var i = 0;
    while (i < _dyn_nn) {
        if (L64(_dyn_nm + i * 16) == xnoff) { return L64(_dyn_nm + i * 16 + 8); }
        i = i + 1;
    }
    var n = 0;
    while (load8(S + 0xEC00000 + xnoff + n) != 0) { n = n + 1; }
    var np = _dyn_mint(S, "dyn ", 4, n + 1);
    i = 0;
    while (i <= n) {
        store8(S + 0xEC00000 + np + 4 + i, load8(S + 0xEC00000 + xnoff + i));
        i = i + 1;
    }
    SNPOS(S, np + 4 + n + 1);
    S64(_dyn_nm + _dyn_nn * 16, xnoff);
    S64(_dyn_nm + _dyn_nn * 16 + 8, np);
    _dyn_nn = _dyn_nn + 1;
    return np;
}
# Write the `n` bytes of `s` at the name pool's top, `more` bytes reserved after them; the offset.
# The caller moves the pool's top (SNPOS) past what it wrote.
fn _dyn_mint(S, s, n, more): i64 {
    NPOS_GUARD(S, n + more + 1);
    var np = GNPOS(S);
    var i = 0;
    while (i < n) {
        store8(S + 0xEC00000 + np + i, load8(s + i));
        i = i + 1;
    }
    store8(S + 0xEC00000 + np + n, 0);
    return np;
}
fn _dyn_word(S, s, n): i64 {
    var np = _dyn_mint(S, s, n, 0);
    SNPOS(S, np + n + 1);
    return np + 1;
}
# The struct `dyn X` (name offset `noff`), registered on its first spelling: two 8-byte words.
fn _dyn_reg(S, noff): i64 {
    var sid = FINDSTRUCT(S, noff);
    if (sid > 0) { return sid; }
    sid = REGSTRUCT(S, noff);
    if (sid == 0) { return 0; }
    if (_dyn_wd == 0) { _dyn_wd = _dyn_word(S, " data", 5); }
    if (_dyn_wv == 0) { _dyn_wv = _dyn_word(S, " vtable", 7); }
    ADDFIELD(S, sid - 1, _dyn_wd - 1);
    ADDFIELD(S, sid - 1, _dyn_wv - 1);
    return sid;
}
# 1 = the source at token `st` is one whole call returning dyn `sid` (`;` after it) — at top level
# its own path refuses it (no frame for a 9-16 B result), so a declaration backstop stays quiet.
# 6.7.8 (D6): a method's too (`var G: dyn Show = Z.me();`, through a dyn or not).
fn _dyn_src_call(S, st, sid): i64 {
    var o = _gcall_open(S, st);
    if (o < 0) { return _dyn_src_mcall(S, st, sid); }
    if (TOKTYP(S, _call_close(S, o) + 1) != 5) { return 0; }
    var fi = _gen_resolve_call(S, st);
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != sid) { return 0; }
    return 1;
}
fn _dyn_src_mcall(S, st, sid): i64 {
    if (_tok_method_open(S, st) == 0) { return 0; }
    if (TOKTYP(S, _call_close(S, st + 3) + 1) != 5) { return 0; }
    var fi = _pair_callee_at(S, st);
    if (fi < 0) { return 0; }
    if (GFRS(S, fi) != sid) { return 0; }
    return 1;
}
# 1 = struct `sid` (1-based) is a dyn: its name starts `dyn ` (only the fold mints one).
fn _dyn_is(S, sid): i64 {
    if (_dyn_nx == 0) { return 0; }
    if (sid <= 0) { return 0; }
    if (sid > GSTC(S)) { return 0; }
    if (L64(S + 0xEC00000 + L64(S + 0x1A6018 + (sid - 1) * 8)) & 0xFFFFFFFF == 0x206E7964) { return 1; }
    return 0;
}
# 1 = struct `sid` is a dyn or holds one in a field, directly or through a nested struct field
# (a generic instance's included). Judged once per struct (`_dyn_hm`): asked only of a complete one.
fn _dyn_held(S, sid): i64 {
    if (_dyn_is(S, sid) == 1) { return 1; }
    if (_dyn_nx == 0) { return 0; }
    if (sid <= 0) { return 0; }
    if (sid > GSTC(S)) { return 0; }
    if (_dyn_hm == 0) { _dyn_hm = alloc(1024); }
    var m = load8(_dyn_hm + sid - 1);
    if (m != 0) { return m - 1; }
    var r = 0;
    var fc = GETFCOUNT(S, sid - 1);
    var i = 0;
    while (i < fc) {
        var ft = GETFTYPE(S, sid - 1, i);
        if (_spi_is_nested(S, ft) == 1) { if (_dyn_held(S, ft) == 1) { r = 1; } }
        i = i + 1;
    }
    store8(_dyn_hm + sid - 1, r + 1);
    return r;
}
# ⛔ U1 / U2 — STRUCT LOCALS ARE NOT ZEROED, so `var o: dyn Show;` in a fn — or `var h: H;` /
# `var hs: H[N]` where H holds a dyn, directly or through a nested struct field — left a vtable word
# of whatever the frame held: a call through it jumps to garbage. Refused by name at the annotation
# (`ann`), the name still declared (PARSE_VAR goes on, nothing cascades). A global is zeroed (a
# zone global is refused uninitialised anyway). `_tup_var`'s first line; `noff` -1 for an array.
# 6.7.8 (D5): `var o: dyn S = src;` whose source is no dyn value is declared here, the dyn formed in
# place (`_dyn_var_init`: 1, the `;` consumed); a copy is left to PARSE_VAR's struct paths (0).
fn _dyn_var(S, noff, pscale, ann): i64 {
    if (pscale == 0) { if (ann != 0) { return _dyn_var_ann(S, ann); } }
    if (pscale >= 0) { return 0; }
    if (pscale <= 0 - 2048) { return 0; }
    if (PEEKT(S) == 5) {
        _dyn_uninit(S, 0 - pscale, ann, noff);
        return 0;
    }
    if (PEEKT(S) != 4) { return 0; }
    if (_dyn_is(S, 0 - pscale) == 0) { return 0; }
    return _dyn_var_init(S, noff, 0 - pscale);   # 6.7.8 (D5): 1 = declared, formed or refused
}
# 6.7.8 (review) — `var y: i64 = mk();` / `: u8` / `: f64` in a fn, `mk()` returning a dyn: PARSE_VAR's
# struct receive infers its struct from a whole free call for an annotation that is no struct, so y
# became the dyn its annotation says it is not (`y.area()` compiled). Refused at the call, in V4's
# words; a bool's is `_bx_decl`'s. (A method / operator initialiser is `_sc_var_receive`'s.) 0.
fn _dyn_var_ann(S, ann): i64 {
    if (_dyn_nx == 0) { return 0; }
    if (GINFN(S) != 1) { return 0; }
    if (PEEKT(S) != 4) { return 0; }
    var a = GTI(S) + 1;
    if (TOKTYP(S, a) != 2) { return 0; }
    if (TOKTYP(S, a + 1) != 10) { return 0; }
    if (_call_dotted(S, a) == 1) { return 0; }
    if (TOKTYP(S, _call_close(S, a + 1) + 1) != 5) { return 0; }
    if (_tn_resolve_at(S, ann) == _tn_code(4, 1)) { return 0; }
    var fi = FINDFN(S, TOKVAL(S, a));
    if (fi < 0) { return 0; }
    if (_dyn_is(S, GFRS(S, fi)) == 0) { return 0; }
    _dyn_err(S, a, "a ", GFRS(S, fi), 0 - 1, " result used as a value - call one of its methods, or copy it whole into a dyn");
    return 0;
}
fn _dyn_uninit(S, sid, ann, noff): i64 {
    if (GINFN(S) != 1) { return 0; }
    if (_dyn_held(S, sid) == 0) { return 0; }
    if (_dyn_is(S, sid) == 1) { return _dyn_err(S, ann, "declare ", sid, noff, " with its value - struct locals are not zeroed, and a dyn's vtable is formed, never left to the frame"); }
    if (noff < 0) { return _dyn_err(S, ann, "an array of ", sid, 0 - 1, " in a fn is refused - its records hold a dyn, struct locals are not zeroed, and a dyn's vtable is formed, never left to the frame"); }
    return _dyn_err(S, ann, "declare ", sid, noff, " with its value - it holds a dyn, struct locals are not zeroed, and a dyn's vtable is formed, never left to the frame");
}
# T12 — the field of struct `si` typed by struct `fs` (its type token `ti`): a union cannot hold a dyn
# (another member would write its words), nor can a generic struct have a dyn field (a type
# parameter and a dyn do not combine yet: the struct `_sdef_tp_ti` is defining opens `<`).
fn _dyn_field_chk(S, si, fs, ti): i64 {
    if (_dyn_held(S, fs) == 0) { return 0; }
    if (ISUNION(S, si) == 1) { return _dyn_err(S, ti, "a union cannot hold a dyn - another member would write its words", 0, 0 - 1, 0); }
    if (_dyn_is(S, fs) == 0) { return 0; }
    if (TOKTYP(S, _sdef_tp_ti) == 19) { return _dyn_err(S, ti, "a dyn field in a generic struct is refused - a type parameter and a dyn do not combine yet", 0, 0 - 1, 0); }
    return 0;
}

# The prepass (`_tl_pass1`, right after `_tr_prepass`, so a trait name resolves): every folded
# token registers its struct — a refused one too, so its later uses do not cascade — and is
# checked where it stands. Reported through `_tup_err`'s reporter: once per token, the latch left
# alone, silent under `--syntax-only`.
fn _dyn_prepass(S): i64 {
    var i = 0;
    while (i < _dyn_nx) {
        var e = L64(_dyn_ix + i * 8);
        if ((e & 2) == 0) { _dyn_chk(S, e >> 2, e & 1); }
        else { _dyn_bare(S, e >> 2); }
        i = i + 1;
    }
    return 0;
}
# T3 — a `dyn` with no trait name after it, in a type position (after `:`, `<`, `*`, `[`, or a `,`
# inside `<..>`), where the parser took any one token as the type (`o: dyn)`, `Vec<dyn>` compiled).
# The token becomes the identifier `dyn`, so each type resolver after this refuses it at the same
# token, silently (`_tn_once`): one report. In a name position the parser names the reserved word.
var _dyn_bare_nm = 0;
fn _dyn_bare(S, ti): i64 {
    if (ti == 0) { return 0; }
    var pt = TOKTYP(S, ti - 1);
    var k = 0;
    if (pt == 49 || pt == 19 || pt == 8 || pt == 28) { k = 1; }
    if (pt == 31) { if (_dyn_opener(S, ti) == 19) { k = 1; } }
    if (k == 0) { return 0; }
    _dyn_err(S, ti, "`dyn` takes a trait's name - `dyn Show` for `trait Show`", 0, 0 - 1, 0);
    if (_dyn_bare_nm == 0) { _dyn_bare_nm = _dyn_word(S, "dyn", 3); }
    S64(S + 0x8C00000 + ti * 8, 2);
    S64(S + 0xAC00000 + ti * 8, _dyn_bare_nm - 1);
    return 0;
}
fn _dyn_chk(S, ti, plus): i64 {
    var noff = TOKVAL(S, ti);
    var sid = _dyn_reg(S, noff);
    if (_dyn_pos(S, ti, sid) == 1) { return 0; }
    if (plus == 1) { return _dyn_err(S, ti, "`dyn A + B` is refused - a dyn holds one vtable, of one trait", 0, 0 - 1, 0); }
    var nt = TOKTYP(S, ti + 1);
    if (nt == 19) { return _dyn_err(S, ti, "", sid, 0 - 1, " takes no type arguments - a trait has none"); }
    if (nt == 28) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be an array element - hold it in a record (`struct R { o: dyn ..; }`) and make an array of those"); }
    if (_tr_find(S, noff + 4) < 0) { return _dyn_err(S, ti, "", 0, noff + 4, " is not a trait - `dyn` takes a declared trait's name"); }
    return _dyn_fn_chk(S, ti);
}
# The position: a dyn type is written after a `:` (a var, a parameter, a return type, a field, a
# trait member's signature). Every other position is refused by name (1 = refused).
fn _dyn_pos(S, ti, sid): i64 {
    if (ti == 0) { return _dyn_where(S, ti, sid); }
    var pt = TOKTYP(S, ti - 1);
    if (pt == 49) { return 0; }
    if (pt == 19) {
        if (_dyn_tok_is(S, ti - 2, "slice", 5) == 1) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a slice element"); }
        return _dyn_targ(S, ti, sid);
    }
    if (pt == 31) { return _dyn_pos_comma(S, ti, sid); }
    if (pt == 8) { return _dyn_err(S, ti, "a pointer to ", sid, 0 - 1, " is refused - a dyn is a two-word value; point at a record that holds one (`struct R { o: dyn ..; }`, `*R`)"); }
    if (pt == 28) { return _dyn_err(S, ti, "", sid, 0 - 1, " cannot be a slice element"); }
    if (pt == 10) { return _dyn_pos_paren(S, ti, ti - 1, sid); }
    if (pt == 77) { return _dyn_err(S, ti, "`impl` takes a type that is not a dyn - implement the trait for a struct or a scalar", 0, 0 - 1, 0); }
    if (pt == 55) { if (ti >= 3) { if (TOKTYP(S, ti - 3) == 77) {
                return _dyn_err(S, ti, "`impl` takes a type that is not a dyn - implement the trait for a struct or a scalar", 0, 0 - 1, 0);
            } } }
    return _dyn_where(S, ti, sid);
}
fn _dyn_where(S, ti, sid): i64 {
    _dyn_err(S, ti, "", sid, 0 - 1, " is a type - write it after a `:` (`o: dyn Show`)");
    # As a VALUE (`= dyn Show`, `return dyn Show`, an argument) it would also be an undefined
    # variable: it becomes the number 0 there, so the refusal above is the one report.
    if (ti < 3) { return 1; }
    var pt = TOKTYP(S, ti - 1);
    var e = 0;
    if (pt == 4 || pt == 33) { e = 1; }
    if (pt == 10) { if (TOKTYP(S, ti - 2) == 2) { if (TOKTYP(S, ti - 3) != 32) { e = 1; } } }
    if (e == 1) {
