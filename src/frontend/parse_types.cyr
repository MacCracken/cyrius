    return 0;
}
# Parameter `k` of the list whose `(` is token `o`: 1 and its type's tokens [`_dps_ts`, `_dps_te`)
# (empty when untyped; `_dps_va` 1 for `...`), or 0 when the list has no parameter `k`.
var _dps_ts = 0;
var _dps_te = 0;
var _dps_va = 0;
var _dps_nm = 0;   # ... and its first token (its name)
fn _dps_param(S, o, k): i64 {
    var q = o + 1;
    if (TOKTYP(S, q) == 11) { return 0; }
    var n = 0;
    while (n < k) {
        q = _pl_next(S, q);
        if (TOKTYP(S, q) != 31) { return 0; }
        q = q + 1;
        n = n + 1;
    }
    _dps_va = 0;
    _dps_nm = q;
    _dps_ts = q + 1;
    _dps_te = q + 1;
    if (TOKTYP(S, q) == 112) {
        _dps_va = 1;
        return 1;
    }
    if (TOKTYP(S, q + 1) == 49) {
