fn _dyn_src_global(S, vi, a): i64 {
    var pm = GVPM(S, vi);
    var gt = GVTYPE(S, vi);
    if (pm == 2) { if (gt > 0) {
            if (_dyn_is(S, gt) == 1) { return 0; }
            return _dyn_frf(S, a, "no implicit `&`: write `&", "` (the dyn holds its address)");
        } }
    if (pm == 1) { if (gt > 0) { return _dyn_sform(S, gt); } }
    var ps = _gv_ptr_sid(S, vi);
    if (ps > 0) { return _dyn_sform(S, ps); }
    if (GVVEC(S, vi) != 0) { return _dyn_f5(S, a); }
    if (gt < 0) { return _dyn_f8p(S, a); }   # a `*T` global, T no struct
