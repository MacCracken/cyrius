# The return type after the parameter list whose `(` is `o`: its first token, `_dps_te` its end
# (both the token after the `)` when there is none — an untyped i64).
fn _dyn_ret_at(S, o): i64 {
    var c = _call_close(S, o);
    _dps_te = c + 1;
    if (TOKTYP(S, c + 1) != 49) { return c + 1; }
    var i = c + 2;
    var d = 0;
    var n = GTCNT(S);
    while (i < n) {
        var t = TOKTYP(S, i);
        if (d == 0) { if (t == 5 || t == 13) { _dps_te = i; return c + 2; } }
        d = _pl_tdepth(t, d);
        i = i + 1;
    }
