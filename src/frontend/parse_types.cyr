}
# THE PAIR'S ONE CHECK (decision 4: impls never formed into a dyn keep the count-only check). 1 = ok.
fn _dyn_pair_chk(S, ii, tx, ti): i64 {
    var k = L64(_tr_tab + tx * 32 + 8);
    var e = k + L64(_tr_tab + tx * 32 + 16);
    while (k < e) {
        var m = L64(_trm_tab + k * 32);
        var fp = L64(_trm_ft + k * 8);   # the slot's code: the impl's own method, or the default
        var im = _tim_of(S, ii, m);
