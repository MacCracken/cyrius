# A3 — 0 = the impl's method at `fn` token `fp` has the trait member at `tp`'s signature: each
# parameter after `self`, then the return, by type (a name by its resolved type, untyped = i64,
# every other token by its kind), generic-ness and `...` alike. Else what differs: 3 a parameter's
# type (`_dsq_k` its name token), 4 the return type, 5 the parameter count, 6 one generic, 7 a `...`.
var _dsq_k = 0;   # the trait's differing parameter (its name token)
fn _dyn_sig_eq(S, tp, fp): i64 {
    var ga = 0;
    var gb = 0;
    if (TOKTYP(S, tp + 2) == 19) { ga = 1; }
    if (TOKTYP(S, fp + 2) == 19) { gb = 1; }
    if (ga != gb) { return 6; }
    var a = _tr_paren(S, tp);
    var b = _tr_paren(S, fp);
    if (a < 0 || b < 0) { return 0; }   # malformed: its own parse reports it
    var k = 1;
    var go = 1;
    while (go == 1) {
        var ha = _dps_param(S, a, k);
        var xs = _dps_ts;
        var xe = _dps_te;
        var xv = _dps_va;
        var xn = _dps_nm;
        var hb = _dps_param(S, b, k);
        if (ha + hb == 0) { go = 0; }
        else {
            if (ha != hb) { return 5; }
            if (xv != _dps_va) { return 7; }
            if (_dyn_ty_eq(S, xs, xe, _dps_ts, _dps_te) == 0) {
                _dsq_k = xn;
                return 3;
