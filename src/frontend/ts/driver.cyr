# ================================================================
# src/frontend/ts/driver.cyr — the TypeScript modes, run after the source read
# ================================================================
# Included by every driver right after `SBL(S, bl);`: each mode runs over the bytes read
# and exits before PREPROCESS, so a normal compile passes straight through. See
# driver_flags.cyr. CHANGELOG [6.7.15]

# ─── TS frontend arena (v6.4.82) ──────────────────────────────────
# The TS arena used to be the FIXED base `S + 0x298B000`, which overlapped
# `tok_types` entirely plus 1.6 MB of `tok_values` — 10,027,008 bytes. It was
# survivable only because all three TS modes SYS_EXIT before PREPROCESS and LEX,
# so the token arrays are never populated in TS mode: a TEMPORAL invariant
# guarding a spatial collision, held by nothing but call ordering, and invisible
# to tests/gates/memory/heapmap.sh because the base was a code literal rather than a map entry.
#
# Origin: 0x298B000 - 0x207B000 = 9,502,720 = exactly the 9.06 MB the v5.11.68
# reorg shrank the heap by. That reorg moved ~35 region bases and MISSED THIS ONE
# literal. Which is the whole argument for alloc() over another fixed base — a
# literal is what the next reorg misses too. ts/lex.cyr:20-22 already documented
# `alloc()` as the contract test drivers use; the fixed base was the deviation.
#
# Allocated ONLY in a TS mode, so a normal compile pays nothing.
var _ts_base = 0;
if (_ts_lex_only_mode == 1 || _ts_parse_only_mode == 1 || _ts_emit_js_mode == 1) {
    _ts_base = alloc(TS_HEAP_SIZE);
    if (_ts_base == 0) {
        syscall(SYS_WRITE, 2, "error: cannot allocate the TS frontend arena\n", 45);
        syscall(SYS_EXIT, 1);
    }
}

# ─── TS lex-only mode (P1.6b wire-in) ─────────────────────────────
# When --lex-ts is set, run TS_LEX on the source bytes and exit with
# 0 (clean lex) or 1 (lex error). No parser/typecheck/lower yet —
# those are v5.7.2 P2-P5. This mode lets cbt/build.cyr's compile()
# detect a .ts source and verify it lexes cleanly via cycc directly,
# without forcing every consumer to go through a separate test driver.
if (_ts_lex_only_mode == 1) {
    var _ts_n = TS_LEX(_ts_base, S + _SRCB, bl);
    if (_ts_n < 0) {
        var _ts_err = TS_GETERR(_ts_base);
        syscall(SYS_WRITE, 2, "ts lex error: code ", 19);
        var _eb[3];
        if (_ts_err >= 10) {
            store8(&_eb, 48 + _ts_err / 10);
            store8(&_eb + 1, 48 + _ts_err % 10);
            store8(&_eb + 2, 10);
            syscall(SYS_WRITE, 2, &_eb, 3);
        } else {
            store8(&_eb, 48 + _ts_err);
            store8(&_eb + 1, 10);
            syscall(SYS_WRITE, 2, &_eb, 2);
        }
        syscall(SYS_EXIT, 1);
    }
    syscall(SYS_EXIT, 0);
}

# ─── TS parse-only mode (P2.1 wire-in) ────────────────────────────

# Emit a non-negative i64 as decimal to stderr (fd 2).
fn _emit_decimal(n): i64 {
    # i64::MIN — see lib/fmt.cyr:fmt_int. The sign is emitted eagerly here, so only the
    # negation and the loop condition change. CHANGELOG [6.5.8]
    if (n < 0) {
        syscall(SYS_WRITE, 2, "-", 1);
    }
    if (n == 0) {
        syscall(SYS_WRITE, 2, "0", 1);
        return 0;
    }
    var buf[24];
    var i = 0;
    while (n != 0) {
        var d = n % 10;
        if (d < 0) { d = 0 - d; }
        store8(&buf + i, 48 + d);
        n = n / 10;
        i = i + 1;
    }
    # Reverse in place + emit
    var rev[24];
    var j = 0;
    while (j < i) {
        store8(&rev + j, load8(&buf + (i - 1 - j)));
        j = j + 1;
    }
    syscall(SYS_WRITE, 2, &rev, i);
    return 0;
}

if (_ts_parse_only_mode == 1) {
    var _tp_lex_n = TS_LEX(_ts_base, S + _SRCB, bl);
    if (_tp_lex_n < 0) {
        syscall(SYS_WRITE, 2, "ts lex error before parse\n", 26);
        syscall(SYS_EXIT, 1);
    }
    var _tp_parse_n = TS_PARSE(_ts_base);
    if (_tp_parse_n < 0) {
        var _tp_err = TS_PARSE_GETERR(_ts_base);
        var _tp_etok = TS_PARSE_GETERR_TOK(_ts_base);
        # current parser TOK_IDX — most accurate since not all err
        # sites set ERR_TOK_IDX. Emit both for triage.
        var _tp_cur = load64(_ts_base + 0xD80000 + 8);   # TS_PS_TOK_IDX = 8
        var _tp_line = load64(_ts_base + 0x100000 + _tp_cur * 8);
        var _tp_type = load64(_ts_base + 0x000000 + _tp_cur * 8);
        syscall(SYS_WRITE, 2, "ts parse error: code=", 21);
        _emit_decimal(_tp_err);
        syscall(SYS_WRITE, 2, " line=", 6);
        _emit_decimal(_tp_line);
        syscall(SYS_WRITE, 2, " tok=", 5);
        _emit_decimal(_tp_type);
        syscall(SYS_WRITE, 2, " cur_idx=", 9);
        _emit_decimal(_tp_cur);
        syscall(SYS_WRITE, 2, " err_idx=", 9);
        _emit_decimal(_tp_etok);
        syscall(SYS_WRITE, 2, "\n", 1);
        syscall(SYS_EXIT, 1);
    }
    syscall(SYS_EXIT, 0);
}

if (_ts_emit_js_mode == 1) {
    var _ej_lex_n = TS_LEX(_ts_base, S + _SRCB, bl);
    if (_ej_lex_n < 0) {
        syscall(SYS_WRITE, 2, "ts lex error before emit\n", 25);
        syscall(SYS_EXIT, 1);
    }
    var _ej_parse_n = TS_PARSE(_ts_base);
    if (_ej_parse_n < 0) {
        syscall(SYS_WRITE, 2, "ts parse error before emit\n", 27);
        syscall(SYS_EXIT, 1);
    }
    var _ej_rc = TS_JS_EMIT(_ts_base, S + _SRCB);
    syscall(SYS_EXIT, _ej_rc);
}
