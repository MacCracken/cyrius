# ================================================================
# src/frontend/ts/driver_args.cyr — the TypeScript flags, read off each fork's arguments
# ================================================================
# Every fork other than src/main.cyr includes this beside driver_flags.cyr. src/main.cyr reads
# the same flags inline in its /proc/self/cmdline loop: it builds byte-identical with the
# shared driver files, so its arms stay where they are, and `_ts_arg` makes their tests.
# Until 6.7.15 the other forks had no TS front end: `--parse-ts` was skipped like any unknown
# flag and the TypeScript was compiled as cyrius (6.7.15's D38: run the front end on every
# compiler). tests/gates/platform/ts_flags_every_driver.sh holds them to the same answers.
# CHANGELOG [6.7.15]

# One argument at `p`, with `n` bytes readable from it in the /proc/self/cmdline layout (its
# own bytes, its NUL, and the arguments after it): the path after a TS mode flag (the next
# argument that does not start with "--"), or a mode flag by its first four characters —
# "--le" (--lex-ts), "--pa" (--parse-ts), "--em" (--emit-js) — the tests src/main.cyr's arms
# make. The third character is tested before the fourth is read.
fn _ts_arg(p, n): i64 {
    if (_ts_expect_path == 1) {
        if (n >= 2) {
            if (_ts_arg_dashes(p) == 0) {
                _ts_input_path = p;
                _ts_expect_path = 0;
            }
        }
    }
    if (n < 4) { return 0; }
    if (_ts_arg_dashes(p) == 0) { return 0; }
    var c = load8(p + 2);
    if (c == 0) { return 0; }
    var d = load8(p + 3);
    if (c == 108) { if (d == 101) { _ts_lex_only_mode = 1; _ts_expect_path = 1; } }
    if (c == 112) { if (d == 97) { _ts_parse_only_mode = 1; _ts_expect_path = 1; } }
    if (c == 101) { if (d == 109) { _ts_emit_js_mode = 1; _ts_expect_path = 1; } }
    return 0;
}

# 1 when the argument at `p` starts with "--".
fn _ts_arg_dashes(p): i64 {
    if (load8(p) != 45) { return 0; }
    if (load8(p + 1) != 45) { return 0; }
    return 1;
}

#ifdef CYRIUS_TARGET_MACOS
# macOS: argv off the entry stack the driver parks (no /proc), as _ARGV_FLAGS_MACHO
# (src/common/util.cyr) reads it. Each argument gets the `n` /proc would give it: its
# length + its NUL, + 1 when another argument follows.
fn _ts_args_macho(): i64 {
    var base = _macho_x28();
    if (base == 0) { return 0; }
    var argc = load64(base);
    if (argc < 2) { return 0; }
    if (argc > 4096) { return 0; }
    #ifdef CYRIUS_ARCH_AARCH64
    var vec = load64(base + 8);
    #else
    var vec = base + 8;
    #endif
    if (vec == 0) { return 0; }
    var i = 1;
    while (i < argc) {
        var p = load64(vec + i * 8);
        if (p != 0) {
            var n = 1;
            while (load8(p + n - 1) != 0) { n = n + 1; }
            if (i + 1 < argc) { n = n + 1; }
            _ts_arg(p, n);
        }
        i = i + 1;
    }
    return 0;
}
#endif

#ifdef CYRIUS_TARGET_WIN
# Windows: GetCommandLineW is ONE UTF-16LE string. It is split as CommandLineToArgvW
# splits it — argv[0] up to its closing quote or the first blank, then blank-separated
# arguments where a `"` toggles quoting and backslashes escape only a quote (2n + `"`: n
# backslashes and a toggle; 2n+1 + `"`: n and a literal `"`) — into UTF-8 (the path the PE
# open widens back), NUL-separated, and walked as /proc/self/cmdline is. Called after
# alloc_init: the block is alloc()'d (<= 4 bytes a code unit, its NULs included).
var _ts_w_o = 0;

fn _ts_w16(w, i): i64 {
    return load8(w + i * 2) | (load8(w + i * 2 + 1) << 8);
}

# 1 for a blank between arguments (space, tab).
fn _ts_w_blank(c): i64 {
    if (c == 32) { return 1; }
    if (c == 9) { return 1; }
    return 0;
}

# Code point `cp` as UTF-8 at `out + _ts_w_o`.
fn _ts_w_put(out, cp): i64 {
    var o = _ts_w_o;
    if (cp < 0x80) {
        store8(out + o, cp);
        _ts_w_o = o + 1;
        return 0;
    }
    if (cp < 0x800) {
        store8(out + o, 0xC0 | (cp >> 6));
        store8(out + o + 1, 0x80 | (cp & 0x3F));
        _ts_w_o = o + 2;
        return 0;
    }
    if (cp < 0x10000) {
        store8(out + o, 0xE0 | (cp >> 12));
        store8(out + o + 1, 0x80 | ((cp >> 6) & 0x3F));
        store8(out + o + 2, 0x80 | (cp & 0x3F));
        _ts_w_o = o + 3;
        return 0;
    }
    store8(out + o, 0xF0 | (cp >> 18));
    store8(out + o + 1, 0x80 | ((cp >> 12) & 0x3F));
    store8(out + o + 2, 0x80 | ((cp >> 6) & 0x3F));
    store8(out + o + 3, 0x80 | (cp & 0x3F));
    _ts_w_o = o + 4;
    return 0;
}

# `b` backslashes at `out + _ts_w_o`.
fn _ts_w_bs(out, b): i64 {
    while (b > 0) { _ts_w_put(out, 92); b = b - 1; }
    return 0;
}

# One argument from unit `i` (not a blank) into `out`, NUL-terminated; returns the unit
# after it. A surrogate pair is one code point.
fn _ts_w_arg(w, i, units, out): i64 {
    var inq = 0;
    var b = 0;
    var c = 0;
    var lo = 0;
    while (i < units) {
        c = _ts_w16(w, i);
        if (inq == 0) { if (_ts_w_blank(c) == 1) { break; } }
        if (c == 92) {
            b = b + 1;
            i = i + 1;
            continue;
        }
        if (c == 34) {
            _ts_w_bs(out, b / 2);
            if ((b & 1) == 1) { _ts_w_put(out, 34); }
            else { inq = 1 - inq; }
            b = 0;
            i = i + 1;
            continue;
        }
        _ts_w_bs(out, b);
        b = 0;
        if (c >= 0xD800 && c < 0xDC00 && i + 1 < units) {
            lo = _ts_w16(w, i + 1);
            if (lo >= 0xDC00 && lo < 0xE000) {
                c = 0x10000 + ((c - 0xD800) << 10) + (lo - 0xDC00);
                i = i + 1;
            }
        }
        _ts_w_put(out, c);
        i = i + 1;
    }
    _ts_w_bs(out, b);
    store8(out + _ts_w_o, 0);
    _ts_w_o = _ts_w_o + 1;
    return i;
}

# Walk a NUL-separated argument block of `total` bytes (argv[0] already skipped).
fn _ts_args_block(b, total): i64 {
    var k = 0;
    while (k < total) {
        _ts_arg(b + k, total - k);
        while (k < total && load8(b + k) != 0) { k = k + 1; }
        k = k + 1;
    }
    return 0;
}

fn _ts_args_win(): i64 {
    var w = syscall(61446);              # GetCommandLineW -> UTF-16LE LPWSTR
    if (w == 0) { return 0; }
    var units = 0;
    while (_ts_w16(w, units) != 0) { units = units + 1; }
    var out = alloc(units * 4 + 8);
    if (out == 0) { return 0; }
    var i = 0;
    if (_ts_w16(w, 0) == 34) {
        i = 1;
        while (i < units && _ts_w16(w, i) != 34) { i = i + 1; }
        if (i < units) { i = i + 1; }
    } else {
        while (i < units && _ts_w_blank(_ts_w16(w, i)) == 0) { i = i + 1; }
    }
    _ts_w_o = 0;
    while (i < units) {
        if (_ts_w_blank(_ts_w16(w, i)) == 1) { i = i + 1; }
        else { i = _ts_w_arg(w, i, units, out); }
    }
    _ts_args_block(out, _ts_w_o);
    return 0;
}
#endif
