# ================================================================
# Cyrius Compiler v2 — Modular Self-Hosting Compiler
# ================================================================
# Same language as cc.cyr, split into modules using include.
# Compiled by cc (cybs's extended language).
#
# Build: cat src/main.cyr | ./build/cycc > /tmp/cycc && chmod +x /tmp/cycc
# Self-host: cat src/main.cyr | /tmp/cycc > /tmp/cc5b && cmp /tmp/cycc /tmp/cc5b
# ================================================================
# HEAP MAP — Authoritative offset registry
# ================================================================
# Check here FIRST before allocating new state.
# Last full audit: v6.2.x closeout — monotonic layout, 96 regions
# (0 overlaps, 0 warnings) verified by tests/heapmap.sh. The
# auditor's parser was last fixed in v5.5.40 (regex required 2+
# spaces after hex offset, silently dropped every region past
# 0x1FC000). Layout reads top-to-bottom matching runtime offsets;
# section headers below group by purpose, NOT strict offset order
# (e.g. compiler-scratch scalars at 0x18C100..0x1903F8 sit between
# var_types end and str_data start; preprocessor scratch interleaves
# in the same range).
#
# --- Low heap: I/O + identifiers ---
#   0x00000  input_buf     [1048576]      1MB raw stdin input (v3.6.7, was 256KB)
#                                         NOTE: input_buf extends past 0x60000 (tok_names).
#                                         tok_names is REBUILT by LEX after preprocessing —
#                                         the overlap is tolerated because preprocessing reads
#                                         from 0x459D000, not S+0.
#   0x60000  tok_names     [262144]      256KB packed identifier strings (nested in input_buf — rebuilt by LEX, v4.6.2 was 64KB, v5.11.18 doubled 128KB → 256KB; grows 0x60000-0xA0000 into the 0xA0000-0x18C100 gap)
#
# --- Struct tables (v3.6.6: expanded to 64 structs) ---
#   0x18E630  (FREED v6.0.47)             was struct_names → relocated to 0x1A6018 [1024], cap 256→1024
#   0x18EE30  (FREED v6.0.47)             was struct_fcounts → relocated to 0x1A8018 [1024]
#   0x18F830  struct_count  [8]
#
# --- Compiler state (scalars) ---
#   0x18C100  BL,CP,VCNT,TCNT,TI,NPOS    6 × 8 bytes
#   0x18DA00  fn_count, in_fn, local_cnt
#   0x18DA20  (FREED v6.0.88)             was ret_patches [2048] — return
#                                          patches migrated to rp_vec @ v6.0.7;
#                                          2 KB array + counter retired here.
#   0x18E220  (FREED v6.0.88)             was ret_patch_cnt [8]
#   0x18F838  loop_top      [8]
#   0x18F840  break_patch   [8]
#   0x18F848  extra_patches [64]          8 && condition patches
#   0x18F888  extra_patch_cnt [8]
#   0x18F890  ptr_scale     [8]
#   0x18F898  continue_count [8]
#   0x18F8A0  continue_patches [64]       8 continue forward-patches
#   0x18F900  (FREED v6.0.47)             was defer_count → relocated to 0x1AC020 (cap 8→64)
#   0x18F908  (FREED v6.0.47)             was defer_addrs → relocated to 0x1AC028
#   0x18FCA0  kernel_mode   [8]
#   0x18FCA8  fixup_cnt     [8]
#   0x18FCB0  last_var      [8]
#   0x18FCB8  cur_line      [8]
#   0x18FCC0  scope_depth   [8]
#   0x18FCC8  str_pos       [8]           string write position (moved from 0x70000 in v4.6.2)
#   0x18FCD0  data_size     [8]           total variable data bytes (moved from 0x70008 in v4.6.2)
#   0x18FCE8  kernel_load_base [8]        v6.3.3 #5: settable kernel ELF base (0 = built-in default)
#   0x18FEC8  current_module [8]
#   0x18FED0  pub_flags     [256]
#   0x18FFD0  use_from      [512]         64 use alias source names
#   0x1901D0  use_to        [512]         64 use alias target names
#   0x1903D0  use_count     [8]
#   0x1903D8  expr_stype    [8]
#   0x1903E0  expr_var      [8]
#   0x1903E8  inline_depth  [8]
#   0x1903F0  expr_width    [8]
#   0x1903F8  init_offset / elf_out_len [8]  (dual-use: init_offset pre-FIXUP, elf_out_len post-FIXUP)
#   0x198000  gvar_toks     [8192]        1024 deferred global var inits
#   0x19A000  gvar_cnt      [8]
#   0x71A000  file_map_cnt  [8]           file:line error map entry count (v6.1.35: relocated from 0x19A100)
#   0x71A040  file_map      [24576]       1024 entries × 24 B (start_line, line_count, fname_offset);
#                                         CVE-31 cap 128→1024, relocated from 0x19A108 into the freed
#                                         0x71A000 band (the .27 output_buf gap, below TS@0x800000)
#   0x721000  file_map_str  [32768]       filename string scratch (v6.1.35: relocated from 0x19D000[4096])
#   (0x19A100/0x19A108/0x19D000 now FREE — reclaimed by the v6.1.35 file_map move)
#
# --- Preprocessor + local var state ---
#   0x190500  include_fname [256]         preprocessor filename scratch
#   0x191000  (FREED v6.1.40)             was fn_local_names → relocated+grown to 0x5D9D000 (CVE-24)
#   0x191800  lex_pp file-scratch [16KB]  READFILE deps-file scratch (was ALSO local_depths, which moved
#                                        to 0x5DBD000 @ v6.1.40 — they time-shared this band)
#   0x192000  macro tables                16 macros (names, offsets, bodies)
#   0x192200  (FREED v6.1.40)             was local_types → relocated to 0x5DDD000
#   0x193400  (FREED v6.1.40)             was local_slice_widths → relocated to 0x5DFD000
#   --- the 4 slot-indexed per-fn local tables RELOCATED to the heap top @ 0x5D9D000 (CVE-24 v6.1.40):
#       indexed by stack-frame SLOT (a `stack var buf[N]` registers N/8 fillers), so a large stack array
#       overflowed the old 256/576-slot tables. Grown to 16384 slots (128 KB frames) each + capped in
#       SFLC. See the 0x5D9D000 block below. ---
#
# --- Function tables (GROWABLE as of v6.2.0 — Phase 0 / AR-03) ---
# These are the INITIAL bases (8192 slots × 8 B each); REGFN relocates the
# whole family off-heap + rehashes the name-hash when the count would exceed
# the cap (ceiling 32768). Accessed by the `_fnt_*` gvars, NOT these literal
# offsets — see util.cyr for the family + grow.
#   0x93A000 fn_param_cstring_mask  _fnt_cstrmask
#   0x94A000 fn_param_result_mask   _fnt_resmask
#   0x95A000 fn_param_option_mask   _fnt_optmask
#   0x96A000 fn_param_tagged_mask   _fnt_tagmask
#   0x97A000 fn_overload_str        _fnt_ovstr
#   0x98A000 fn_overload_int        _fnt_ovint
#   0x99A000 fn_overload_cstr       _fnt_ovcstr
#   0x9AA000 fn_param_simd_mask     _fnt_simdmask
#   0x9BA000 fn_names               _fnt_names
#   0x9CA000 fn_offsets             _fnt_offsets
#   0x9DA000 fn_params              _fnt_params
#   0x9EA000 fn_body_start          _fnt_bodystart
#   0x9FA000 fn_body_end            _fnt_bodyend
#   0xA0A000 fn_inline              _fnt_inline
#   0xA1A000 fn_param_str_mask      _fnt_strmask
#   0xA2A000 fn_code_end            _fnt_codeend
#   0x110000 fn_name_hash (2 B/slot) _fnt_namehash  (grow → rehash)
#   0x114000 fn_start_hash (2 B/slot) _fnt_starthash (rebuilt per fixup)
# Initial bases live back-to-back in the band ending at 0x92A000 (the IR
# region's start). Cap 8192 initially → byte-identical under the old cap.
#
# --- Reclaimable / scratch ---
#   0x1C0000  include_fnames[32768]       256 include-once filenames × 128 B (v4.8.4-alpha2)
#   0x1C8000  fn_var_bytes  [65536]       8192 × 8B — per-fn array-bytes
#                                        accumulator (sum of all
#                                        `var foo[N]` aligned sizes
#                                        registered inside this fn body).
#                                        Set by parse_decl.cyr's array-
#                                        register path when `_cur_fn_ix >= 0`.
#                                        Read by FIXUP's `large static data`
#                                        warning to compute "M bytes inside
#                                        N unreachable fns" attribution post-
#                                        DCE. Uses the slot reclaimed at
#                                        v5.11.19 when fn_regalloc relocated
#                                        0x1C8000 → 0x14A000. v5.11.62.
#   0x14A000  fn_regalloc   [65536]       8192 per-fn #regalloc flags (v4.8.4-alpha4; v5.11.19 doubled + relocated 0x1C8000 → 0x14A000)
#   0x1D8000  enum_const_val[8192]        1024 slots × 8 B — PARSE_ENUM_DEF
#                                        stores (1<<63)|val per variant; read
#                                        by PARSE_FACTOR to const-fold enum
#                                        identifiers at parse time (v5.5.2)
#   0x19E000  jump_target_cnt[8]          v5.6.x: per-fn count of LASE jump targets (x86-only)
#   0x19E008  jump_target_tbl[8184]       1023 × 8B target CPs — the count above shares the
#                                        8 KB [0x19E000..0x1A0000) budget, so the entries hold
#                                        1023, NOT 1024 (AR-03 v6.1.38: x86/jump.cyr guards jtc<1023;
#                                        the prior jtc<1024 wrote slot 1023 into jump_src_cnt below).
#   0x1A0000  jump_src_cnt  [8]           v5.6.27: per-fn count of recorded disp32 source CPs
#   0x1A0008  jump_src_tbl  [8192]        v5.6.27: 1024 × 8B disp32 CP entries (count is separate
#                                        at 0x1A0000, so these get the full [8192] — no off-by-one).
#                                        Reset at fn start. Populated by EJCC/EJMP/EJMP0/ECALLTO.
#                                        Read by compact_nops to remap intra-fn jump disps.
#   0x1A2008  nop_run_cnt   [8]           v5.6.27: per-fn count of NOP runs
#   0x1A2010  nop_run_tbl   [16384]       v5.6.27: 1024 × 16B (cp, len) NOP run entries.
#                                        Reset at fn start. Populated by picker patches.
#                                        Read by compact_nops to skip during byte copy.
#   0x1A6010  fn_start_fcnt [8]           v5.6.27: GFCNT at fn start; compact_nops walks
#                                        new fixup entries [fn_start_fcnt, GFCNT) to
#                                        shift their CPs.
#   --- v6.0.47 cap-raise relocations (freed band 0x1A6018-0x1B0000) ---
#   0x1A6018  struct_names  [8192]        1024 struct name offsets (cap 256→1024; was 0x18E630)
#   0x1A8018  struct_fcounts[8192]        1024 field counts (bit 63 = union; was 0x18EE30)
#   0x1AA018  struct_field_base[8192]     1024 × 8B per-struct start index into the packed field pools (NEW v6.0.47)
#   0x1AC018  struct_field_pooltop[8]     next free packed-pool entry index (NEW v6.0.47)
#   0x1AC020  defer_count   [8]           deferred/secret blocks per fn (cap 8→64; was 0x18F900)
#   0x1AC028  defer_addrs   [1536]        64 × 24B {block_start, end_jmp, flag_local} (was 0x18F908)
#   0x1DA000  DCE bitmap    [8192]        dead-code-elimination scratch (pass 2 only)
#   0x1DC000  pe_reloc_coffs[65536]       8192 × 8B coff slots for PE base-
#                                        relocation collection (DIR64 sites),
#                                        populated by _pe_layout + read by
#                                        EMITPE_EXEC's .reloc writer (v5.5.35)
#   0x15A000  fn_ret_sid    [65536]       8192 × 8B — per-fn struct return id (v5.11.19 doubled + relocated 0x1EC000 → 0x15A000)
#                                        (0 = scalar return, sid = struct;
#                                        set by PARSE_FN `: StructName` annot,
#                                        read by PARSE_RETURN + call-site to
#                                        emit Win64 hidden-RCX / SysV-RDI
#                                        retptr convention (v5.5.36 Phase 2b)
#   0x16A000  fn_variadic   [65536]       8192 × 8B — per-fn variadic flag (v5.11.19 doubled + relocated 0x1F4000 → 0x16A000)
#                                        (0 = fixed-arity, 1 = `fn f(a, ...)`
#                                        took an ellipsis tail); set by
#                                        PARSE_FN's param loop on seeing
#                                        `...`. Phase 3-min (v5.5.36) reads
#                                        it at call sites to emit Win64
#                                        float-dup when an arg is f64;
#                                        callee-side save-area prologue +
#                                        va_arg stdlib is Phase 3-full.
#   0x17A000  fn_flags      [65536]       8192 × 8B — per-fn attribute bits (v5.11.19 doubled + relocated 0x1FC000 → 0x17A000)
#                                        (v5.6.3). bit0 = #must_use (warn
#                                        when return is dropped at
#                                        expression-statement level); bit1
#                                        reserved for future @unsafe-fn;
#                                        bit2 = #deprecated (v5.6.4 — warn
#                                        at every call site, message in
#                                        fn_deprecated_msg below).
#                                        Set by PARSE_FN_DEF consuming
#                                        pending flags from preceding lexer
#                                        tokens (122 = HASH_MUST_USE, 124 =
#                                        HASH_DEPRECATED).
#   0x1EC000 gvar_initval  [65536]       8192 × 8B — per-gvar static-init
#                                        literal value (v5.11.64). Written
#                                        by PARSE_GVAR_REG when RHS matches
#                                        the shape `var X = INT_LITERAL ;`
#                                        with a non-zero value; FIXUP-time
#                                        emit paths write these bytes into
#                                        the var area instead of zero,
#                                        eliminating the runtime store
#                                        sequence. Solves the kmode-entry
#                                        init-order bug filed at
#                                        docs/development/issues/
#                                        2026-05-18-gvar-init-order-zero-reads.md
#                                        (agnos xHCI Attempt 64). Slot uses
#                                        v5.11.19 freed-region (was
#                                        fn_ret_sid before .19 relocation).
#   0x1B0000 gvar_byte_off [65536]       8192 × 8B — per-gvar byte offset
#                                        within the var area, populated by
#                                        FIXUP's prefix-sum loop (v5.11.64,
#                                        relocated from output_buf scratch
#                                        to a stable region so EMIT_*
#                                        paths can read it after the output
#                                        write reaches past 128KB). Slot
#                                        lives in the freed band between
#                                        fn_start_fcnt end (0x1A6018) and
#                                        the include_fnames / fn_names
#                                        section start at 0x1C0000 (free
#                                        in BOTH main.cyr and main_aarch64
#                                        heap maps, per cross-arch propagation).
#   0x204000  var_enum_id   [65536]       8192 × 8B — per-variant parent
#                                        enum id (1-based; 0 = not a
#                                        variant). Written by PARSE_ENUM_
#                                        DEF in pass 1 alongside var_noffs
#                                        / var_sizes. Read by future
#                                        PARSE_MATCH coverage check
#                                        (v5.8.22 bite #1 — infrastructure
#                                        only this slot; consumer in bite
#                                        #2). Pre-v5.8.22 there was no
#                                        per-variant → enum mapping; the
#                                        existing enum_const_val table
#                                        only stored tag values.
#   0x214000  enum_count    [8]           total enum decls seen at parse
#                                        time. Bumped by PARSE_ENUM_DEF in
#                                        pass 1; eid 1-based so 0 in
#                                        var_enum_id[] is unambiguous.
#                                        Cap 1024 (v5.8.24 — bumped from
#                                        256 after audit found stdlib
#                                        alone at 299 enum decls;
#                                        composed multi-dep downstream
#                                        programs were 1-2 releases from
#                                        tripping).
#   0x214008  enum_variant_count[8192]    1024 × 8B — per-enum variant
#                                        count, indexed 0..enum_count-1.
#                                        Bumped per variant in pass 1.
#                                        Read at match-check time to
#                                        compare against arm-coverage set
#                                        size (v5.8.22 bite #2). v5.8.24
#                                        grew 256→1024 with cap bump.
#   0x216008  enum_name     [8192]        1024 × 8B — per-enum name
#                                        offset (into S+0x60000 ident
#                                        pool) for diagnostic messages.
#                                        Written by PARSE_ENUM_DEF in
#                                        pass 1 alongside variant
#                                        tagging. v5.8.24 moved 0x214808
#                                        → 0x216008 + grew 256→1024 with
#                                        the cap bump.
#   0x100000 fn_deprecated_msg [65536]   8192 × 8B — per-fn deprecation (v5.11.19 doubled + relocated 0x104000 → 0x100000)
#                                        message token value (v5.6.4). 0 =
#                                        no message; nonzero = (offset<<16)
#                                        | length into str_data at 0x21A000
#                                        (same encoding as string-literal
#                                        token values). Parallel to
#                                        fn_flags bit 2.
#   0x110000 fn_name_hash  [16384]       8192 slots × 2B — FNV-1a open- (v5.11.19 relocated 0x10C000 → 0x110000; size unchanged to preserve mask 8191 and fit available gap)
#                                        addressing hash of fn-name strings
#                                        at S+0x60000+noff → (fi+1). 0 =
#                                        empty slot (zero-init heap makes
#                                        this free). Probing: linear with
#                                        mask 8191. Load factor 0.5 at
#                                        4096-fn cap. Accelerates FINDFN's
#                                        hot path from O(N) linear scan to
#                                        O(1) expected. Use-alias fallback
#                                        remains linear in FINDFN. v5.6.5.
#   0x114000 fn_start_hash [16384]       8192 slots × 2B — golden-ratio (v5.11.19 relocated 0x110000 → 0x114000; size unchanged to preserve mask 8191 and fit available gap)
#                                        Knuth-multiplicative hash of
#                                        fn_offsets[fi] → (fi+1). 0 = empty.
#                                        Built once at fixup() entry with
#                                        explicit per-slot reset (the
#                                        intervening 232 KB gap up to
#                                        0x91A000 is not zeroed by
#                                        _HEAP_INIT_SCRATCH). Hash:
#                                        (start * 0x9E3779B97F4A7C15) >> 16,
#                                        mask 8191; linear probe. Replaces
#                                        two O(N²) DCE byte-scan linear
#                                        scans (seed pass + propagate
#                                        fixpoint loop). v5.10.41.
#
# --- Variable tables (v6.3.0: GROWABLE var-family; see util.cyr `_var_grow`) ---
#   These offsets are now the INITIAL bases of 7 growable parallel tables, all
#   vcnt-indexed: var_noffs/var_sizes/var_types (below) + gvar_byte_off (0x1B0000),
#   enum_const_val (0x1D8000), gvar_initval (0x1EC000), var_enum_id (0x204000).
#   SVCNT grows the whole family 2x past the old 8192 cap (the bases relocate off
#   these offsets; the offsets remain the under-cap home, so heapmap stays valid).
#   0x11A000 var_noffs     [65536]       8192 var name offsets (initial base)
#   0x12A000 var_sizes     [65536]       8192 var sizes (initial base)
#   0x13A000 var_types     [65536]       8192 var type IDs (initial base)
#
# --- String literal data ---
#   0x21A000 str_data     [2097152]     2MB string literal bytes. Sized for the
#                                        Unicode 17.0.0 compat-decomp table
#                                        (~445 KB hex-pair encoded; v5.8.51-deferred
#                                        / v5.8.59-bumped). Lineage: 32KB at 0x40000
#                                        (v3.6.7) → 256KB at 0x14A000 (v3.6.9, 8x)
#                                        → 2MB at high-block (v5.8.59, forced off
#                                        0x14A000 by the 0x18C100 scratch
#                                        collision) → 2MB at 0x21A000 (v5.8.61
#                                        monotonic, fits the var_enum_id..
#                                        preprocess_out gap; brk -2 MB).
#                                        Post-v5.11.68 reorg: directly abuts
#                                        codebuf at 0x41A000 — 192 KB residual
#                                        headroom absorbed in the closeout shift.
#
# --- Large buffers ---
#   0x41A000 codebuf       [3145728]     3MB generated machine code — INITIAL base only; GROWABLE as of v6.2.0 (Phase 0): `_codebuf_base`/`_codebuf_cap`, EB relocates off-heap (2x, 64 MiB ceiling) when cp nears the cap — see util.cyr _codebuf_grow. (v5.7.27 — was 1MB pre-v5.7.27; bumped to absorb cyrius-ts test-compile pressure (94% on ts_parse_p52-54 across v5.7.24-v5.7.26)) (v3.5.2). Pulled DOWN 2.24 MB at v5.11.68 to abut str_data end (was 0x64A000).
#   0x4D9D000 output_buf    [16777216]   16MB ELF output — RELOCATED to heap-top from 0x71A000 (2MB→16MB) @ v6.1.27 phylax binary-cap (v3.5.2).
#                                        Pre-v5.8.46 tok_types ALSO lived here (overlap recycled
#                                        the buffer post-lex for ELF emission); v5.8.46 relocated
#                                        tok_types to the post-TS high block at 0x2D7C000 to
#                                        free the cap for sandhi consumers — see below.
#
# --- Token arrays (v3.6.2 layout RETIRED v5.8.46) ---
#   (was 0xB4A000 tok_types — note: comment was stale, code wrote at 0x4D9D000)
#   (was 0xD4A000 tok_values [2097152] 262144 entries × 8 bytes)
#   (was 0xF4A000 tok_lines  [2097152] 262144 entries × 8 bytes)
#   (262144-entry cap blocked sit v0.7.2 + every sandhi consumer named in the
#    cyrius v5.7.0 CHANGELOG — see archived issue
#    docs/development/issues/archived/2026-04-25-cyrius-fixup-table-cap.md)
#
# --- Relocated struct field tables (v3.6.6) ---
#   0x91A000 struct_ftypes [65536]       PACKED field-type pool (v6.0.47): 8192 flat entries × 8B, addr = (field_base[si]+fc)*8 (was 256×32 fixed grid). Overflow → "pool exhausted" diag.
#   0x92A000 struct_fnames [65536]       PACKED field-name pool (v6.0.47): 8192 flat entries × 8B, same indexing
#
#   --- v5.10.24 REAL TYPE SYSTEM Phase 2 — extended param-type masks ---
#   (Mirror of fn_param_str_mask at 0xA1A000 — bit N set = param N has the
#   given type annotation. Used by PARSE_FNCALL call-site type check to fire
#   warnings on type mismatches. Reused the 256 KB v5.5.37-retired gap.)
#   0x93A000 fn_param_cstring_mask [32768] 4096 cstring-param bitmasks (v5.10.24)
#   0x94A000 fn_param_result_mask  [32768] 4096 Result-param bitmasks  (v5.10.24)
#   0x95A000 fn_param_option_mask  [32768] 4096 Option-param bitmasks  (v5.10.24)
#   0x96A000 fn_param_tagged_mask  [32768] 4096 Tagged-param bitmasks  (v5.10.24)
#   0x97A000 fn_overload_str       [32768] 4096 fi+1 of <name>_str  overload (v5.10.25)
#   0x98A000 fn_overload_int       [32768] 4096 fi+1 of <name>_int  overload (v5.10.25)
#   0x99A000 fn_overload_cstr      [32768] 4096 fi+1 of <name>_cstr overload (v5.10.25)
#   0x9AA000 fn_param_simd_mask    [32768] 4096 per-fn SIMD-param class mask (v5.10.38).
#                                                  2 bits per param: 00 int-class,
#                                                  01 f64v2 (1 XMM reg slot),
#                                                  10 f64v4 (2 XMM reg slots).
#                                                  PARSE_FNCALL consults this to route
#                                                  SIMD args into XMM regs rather than
#                                                  int-class arg regs.
#
# --- cycc IR region (v5.0.0) ---
#   0xA3A000 ir_nodes      [4194304]     262144 IR nodes × 16 bytes
#   0xE3A000 ir_blocks    [1048576]     32768 basic blocks × 32 bytes
#   0xF3A000 ir_state     [4096]        IR builder state (counters, current BB)
#   0xF3B000 ir_edges     [262144]      32768 CFG edges × 8 bytes
#   0xF7B000 ir_cp        [1048576]     262144 node CP offsets × 4 bytes
#
# --- Fixup table — NEW slot (v5.5.37) ---
#   0x107B000 fixup_tbl    [16777216]    1048576 entries × 16 bytes
#                                        (cap raised 32768 → 262144 in
#                                        v5.7.1, then 262144 → 1048576
#                                        in v5.7.7 — sandhi consumers
#                                        plus agnostik-class derive-
#                                        codegen burn fixups faster
#                                        than the 262K ceiling allows).
#
#   0x207B000 brk-fixup-end               ~33 MB at end of fixup_tbl
#                                        (post-v5.11.68 reorg; was
#                                        0x298B000 / ~41.5 MB pre-.68)
#   0x2D7C000 brk-with-ts-frontend        ~45.5 MB — 13.3 MB TS frontend
#                                        reservation between fixup_tbl
#                                        end (0x207B000) and tok_types
#                                        start (0x2D7C000) preserved
#                                        across the .68 reorg
#
# --- Token arrays RELOCATED here (v5.8.46) ---
#   0x2D7C000 tok_types     [8388608]     1048576 entries × 8 bytes — was 0x4D9D000
#                                        (overlap w/ output_buf, capped at 262144). Cap raise
#                                        from 262144 → 1048576 (4×) sized to absorb sandhi
#                                        consumers (sit v0.7.2 with sandhi in [deps].stdlib
#                                        threshold-aborted at 262144); empirical M from the
#                                        v5.8.46 `needed M, cap is N` diagnostic.
#   0x357C000 tok_values    [8388608]     1048576 entries × 8 bytes — was 0xD4A000
#   0x3D7C000 tok_lines     [8388608]     1048576 entries × 8 bytes — was 0xF4A000
#
# --- LEXID dedup index (v5.10.40 — lex-hot-path optimization) ---
#   0x457C000  lexid_count   [8]            entries used so far (≤16384)
#   0x457C100  lexid_heads   [2048]         per-length head idx+1 (256 × 8B;
#                                            0 = empty bucket). bucket = klen
#                                            saturated at 255 (collisions tolerated;
#                                            byte-compare still authoritative).
#   0x457C900  lexid_entries [131072]       16384 × 8B linked-list nodes.
#                                            Each entry packs (canonical offset
#                                            into tok_names @ 0x60000 in low 32,
#                                            next-entry idx+1 in high 32). Walked
#                                            most-recent-first; on match returns
#                                            the recorded canonical offset.
#                                            Replaces the v0.x O(N²) walk-from-
#                                            offset-zero dedup loop in LEXID.
#                                            cap 16384 → ~3× safety margin over
#                                            cycc self-compile's distinct-id count.
#
#
# --- Relocated large buffer (v5.11.33) ---
#   0x459D000 preprocess_out [8388608]   8 MB expanded source buffer.
#                                        v5.11.33 raised cap 2 MB → 8 MB
#                                        after sit v0.7.6 hit 2,099,593
#                                        bytes (2,441 over the prior cap)
#                                        on a stock sandhi-folded
#                                        [deps].stdlib. v5.11.68 reorg
#                                        shifted from 0x4EAD000 → 0x459D000
#                                        (-9.06 MB) as part of the full
#                                        post-codebuf cascade.
#                                        See CHANGELOG [5.11.33] +
#                                        [5.11.68].
#
#   --- per-fn local tables, relocated here + grown @ v6.1.40 (CVE-24); see the local-var note above ---
#   0x5D9D000 fn_local_names    [131072]  16384 local-name slots × 8B (was 0x191000/256). SFLC caps the
#                                        per-fn slot count at 16384 (= 128 KB stack frame) — a `stack var
#                                        buf[N]` registers N/8 fillers, so large arrays overran the old table.
#   0x5DBD000 local_depths      [131072]  16384 scope-depth slots × 8B (was 0x191800)
#   0x5DDD000 local_types       [131072]  16384 type slots × 8B (was 0x192200)
#   0x5DFD000 local_slice_widths[131072]  16384 slice-width slots × 8B (was 0x193400) → ends 0x5E1D000
#
#   0x5E1D000 brk-final                   ~94.1 MB — heap end (+512 KB local-table relocation @ v6.1.40;
#                                        +16MB output_buf @ v6.1.27). v5.11.68
#                                        full heap-map reorg shrunk brk
#                                        by 9.06 MB (was 0x56AD000 /
#                                        ~86.6 MB pre-.68). Layout is
#                                        monotonic from 0x00000 to brk
#                                        except the single 13.3 MB TS
#                                        frontend reservation between
#                                        fixup_tbl end and tok_types
#                                        start. See CHANGELOG [5.11.68]
#                                        for the gap-by-gap close shape.
#
# Token types:
#   1=NUM 2=IDENT 3=VAR 4=EQ 5=SEMI 6=PLUS 7=MINUS 8=STAR 9=SLASH
#   10=LPAREN 11=RPAREN 12=EOF 13=LBRACE 14=RBRACE 15=IF 16=WHILE
#   17=EQEQ 18=NEQ 19=LT 20=GT 21=LTE 22=GTE 23=ELSE
#   24=SYSCALL 25=LOAD8 26=STORE8 27=AMPERSAND 28=LBRACKET 29=RBRACKET
#   30=STRING 31=COMMA 32=FN 33=RETURN 34=PERCENT 35=PIPE 36=CARET
#   37=TILDE 38=SHL 39=SHR 40=STRUCT 41=DOT 42=LOAD16 43=LOAD32
#   44=LOAD64 45=STORE16 46=STORE32 47=STORE64 48=ASM 49=COLON
#   50=ELIF 51=BREAK 52=CONTINUE 53=AND 54=OR 55=FOR 56=KERNEL 57=SWITCH 58=CASE 59=DEFAULT 60=ENUM
#   61=FLOAT 62=F64ADD 63=F64SUB 64=F64MUL 65=F64DIV 66=F64FROM 67=F64TO
#   68=F64EQ 69=F64LT 70=F64GT 71=F64NEG
#   72=MOD 73=PUB 74=USE 75=MATCH 76=IN 77=IMPL
#   97=RET2 98=RETHI 99=F64ATAN 100=SIZEOF


# x86_64 syscall number constants (used by shared cc/ modules)
enum Sys { SYS_READ = 0; SYS_WRITE = 1; SYS_OPEN = 2; SYS_CLOSE = 3; SYS_BRK = 12; SYS_EXIT = 60; }

# v5.6.39: version string + length sourced from auto-generated
# src/version_str.cyr (regenerated from VERSION on every bump).
# Replaces a hardcoded "cycc X.Y.Z\n" literal that drifted because
# version-bump.sh's regex couldn't match `-N` hotfix suffixes.
include "src/version_str.cyr"

# ================================================================
# MODULES
# ================================================================
include "src/common/util.cyr"
# v6.0.8 — shared backend helpers extracted from x86/aarch64 into
# src/backend/common/. tokens.cyr = TOKTYP/TOKVAL/PEEKT/PEEKV.
# runtime.cyr = _env_scratch + _read_env + _prof_clock_ns + RECFIX.
# Must precede emit/fixup includes because those call _read_env +
# RECFIX + PEEKT/V internally.
include "src/backend/common/tokens.cyr"
include "src/backend/common/runtime.cyr"
include "src/backend/x86/emit.cyr"
include "src/backend/x86/float.cyr"
include "src/backend/x86/jump.cyr"
include "src/backend/x86/decode.cyr"
include "src/common/ir.cyr"
include "src/frontend/lex.cyr"
include "src/frontend/ts/lex.cyr"
include "src/frontend/ts/parse.cyr"
include "src/backend/js/emit.cyr"

# v6.0.6 — pull in lib/alloc + lib/vec for the v6.0.7 return-patch-buffer
# → vec conversion (proposal Option C). cycc's existing fixed-heap layout
# (0x00000..0x4D9D000) is unchanged; alloc.cyr's brk-based heap sits AFTER
# our extension (alloc_init() runs syscall(12, 0) which returns the
# post-extension brk and adds another 1 MB on top). vec.cyr depends on
# alloc; alloc.cyr transitively includes lib/fnptr.cyr for vtable dispatch.
# Must precede parse.cyr/parse_expr/parse_fn so their fn bodies can
# reference vec_push / vec_get / vec_len / vec_truncate at parse time
# (v6.0.7 conversion).
include "lib/alloc.cyr"
include "lib/vec.cyr"

# v6.0.7 — return-patch vec storage. Declared BEFORE parse.cyr so the
# converted call sites in parse.cyr / parse_expr.cyr / parse_fn.cyr can
# resolve `rp_vec` at parse time. Initialized to 0; the real
# `rp_vec = vec_new()` assignment happens at the alloc_init() block
# below, after the brk extension. Top-level execution order guarantees
# alloc_init() + vec_new() run before LEX/PARSE/FIXUP touch it.
var rp_vec = 0;

include "src/frontend/parse.cyr"
include "src/backend/macho/emit.cyr"
include "src/backend/pe/emit.cyr"
include "src/backend/x86/fixup.cyr"

# ================================================================
# MAIN
# ================================================================

# --version + --strict parsing (v5.4.19): read /proc/self/cmdline.
# --strict sets _strict_mode = 1, which fixup.cyr reads to decide
# whether undefined-function warnings should hard-fail the compile
# (vs the default: warn and continue into a known-to-crash binary).
var _strict_mode = 0;
# v6.3.2: --allow-undef downgrades the now-DEFAULT reachable-undefined-fn
# hard error (backend/*/fixup.cyr gates on `_allow_undef == 0`) back to a
# warning. 0 = hard-error (default); 1 = warn + continue.
var _allow_undef = 0;
# v5.7.8: errors that print "error:" but want to keep going (so the
# binary is still produced for downstream debug) set this flag; the
# final exit returns it as the process exit code. Without this,
# `cyrius check` and every gate-script that pipes through cycc silently
# treats failed compiles as successes.
var _had_error = 0;
var _ts_lex_only_mode = 0;       # P1.6b: --lex-ts CLI flag
var _ts_parse_only_mode = 0;     # P2.1: --parse-ts CLI flag
var _ts_emit_js_mode = 0;        # v6.1.10: --emit-js CLI flag (Phase D)
# v6.0.5: path arg for `--parse-ts <file>` / `--lex-ts <file>` so a
# scripted invocation doesn't block reading stdin (yeo-cy-test papercut
# #3, 2026-05-27). The next non-flag arg after a TS mode flag is the
# input path; if 0, fall back to stdin (preserves all existing callers
# that dup2 a fixture fd onto stdin).
var _ts_input_path = 0;
var _ts_expect_path = 0;
var _vbuf[256];
var _vfd = 0;
var _vn = 0;
#ifdef CYRIUS_TARGET_MACOS
# v6.0.42 (x86-macOS runtime arc, layer 3): macOS has no /proc. A failed
# `open("/proc/self/cmdline")` returns errno via Darwin's carry-flag
# convention (POSITIVE rax, not Linux's negative), so the `if (_vn > 0)`
# guard below — written for Linux — would fire on garbage and walk the
# parse loop off `_vbuf` → SIGSEGV. Skip the /proc scan on macho; `_vn`
# stays 0 so the flag-parse block is bypassed. cycc still compiles from
# stdin. --version/--strict/--lex-ts flags on macho need stack-argv
# (layer 4 — Darwin entry stack: argc/argv/envp/apple). See issue
# 2026-06-02-macos-x86-release-no-compiler.md.
#else
if (SYS_OPEN == 2) { _vfd = syscall(SYS_OPEN, "/proc/self/cmdline", 0, 0); }
else { _vfd = syscall(SYS_OPEN, 0 - 100, "/proc/self/cmdline", 0, 0); }
_vn = syscall(SYS_READ, _vfd, &_vbuf, 255);
syscall(SYS_CLOSE, _vfd);
#endif
if (_vn > 0) {
    var _vi = 0;
    while (_vi < _vn) { if (load8(&_vbuf + _vi) == 0) { _vi = _vi + 1; break; } _vi = _vi + 1; }
    # Walk the cmdline args, looking for --version or --strict. Each
    # arg is NUL-terminated; cmdline contains argv[0]\0argv[1]\0...
    while (_vi < _vn) {
        # If a TS mode flag was just seen and the current arg isn't a
        # flag, treat it as the input file path (v6.0.5).
        if (_ts_expect_path == 1) {
            if (_vi + 2 <= _vn) {
                if (load8(&_vbuf + _vi) != 45 || load8(&_vbuf + _vi + 1) != 45) {
                    _ts_input_path = &_vbuf + _vi;
                    _ts_expect_path = 0;
                }
            }
        }
        # "--ve" (--version) — short-circuit exit
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 118 && load8(&_vbuf + _vi + 3) == 101) {
                    syscall(SYS_WRITE, 1, _VERSION_STR_CYCC, _VERSION_LEN_CYCC);
                    syscall(SYS_EXIT, 0);
                }
            }
        }
        # "--st" (--strict) — set flag, keep parsing
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 115 && load8(&_vbuf + _vi + 3) == 116) {
                    _strict_mode = 1;
                }
            }
        }
        # "--al" (--allow-undef, v6.3.2) — downgrade the default reachable-
        # undefined-fn hard error back to a warning. chars a(97) l(108).
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 97 && load8(&_vbuf + _vi + 3) == 108) {
                    _allow_undef = 1;
                }
            }
        }
        # "--pie" (v6.1.6) — position-independent codegen. chars p(112) i(105)
        # e(101) disambiguate from --parse-ts (--pa). Effective for BOTH kernel
        # (`kernel;`, kmode==1 → ET_DYN via EMITELF64_KERNEL) AND userland (kmode 0
        # → ET_DYN via EMITELF_USER(S,3), base-0 entry, RIP-relative). Real ASLR
        # then depends on the loader randomizing the ET_DYN base (e.g. the AGNOS
        # kernel for the userspace target — see the v6.3.23 SEC-AGNOS-01 note).
        # Also honored via CYRIUS_PIE=1 env (set below) for the cyrius-build
        # wrapper + cross/test harnesses.
        if (_vi + 5 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 112 && load8(&_vbuf + _vi + 3) == 105 && load8(&_vbuf + _vi + 4) == 101) {
                    _pie_mode = 1;
                }
            }
        }
        # "--le" (--lex-ts) — TS lex-only mode (P1.6b wire-in).
        # cycc reads stdin, runs TS_LEX, exits 0 (clean lex) or 1 (error).
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 108 && load8(&_vbuf + _vi + 3) == 101) {
                    _ts_lex_only_mode = 1;
                    _ts_expect_path = 1;
                }
            }
        }
        # "--pa" (--parse-ts) — TS parse-only mode (P2.1 wire-in).
        # cycc reads stdin, runs TS_LEX then TS_PARSE, exits 0 (both
        # clean) or 1 (lex/parse error). No typecheck/lower yet — P3-P5.
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 112 && load8(&_vbuf + _vi + 3) == 97) {
                    _ts_parse_only_mode = 1;
                    _ts_expect_path = 1;
                }
            }
        }
        # "--em" (--emit-js) — TS/TSX → JS emit (v6.1.10, Phase D).
        # cycc lexes + parses the TS/TSX input then walks the AST emitting
        # browser JS to stdout: strips types/interfaces/aliases, lowers JSX
        # to `h(...)`-pragma calls (+ optional standalone prelude), passes
        # ESM through. e(101) m(109) disambiguate from every other flag.
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 101 && load8(&_vbuf + _vi + 3) == 109) {
                    _ts_emit_js_mode = 1;
                    _ts_expect_path = 1;
                }
            }
        }
        # Skip to next arg (past next \0)
        while (_vi < _vn && load8(&_vbuf + _vi) != 0) { _vi = _vi + 1; }
        _vi = _vi + 1;
    }
}

# Allocate heap
#ifdef CYRIUS_TARGET_MACOS
# v6.0.41: macOS has no brk syscall — bootstrap the compiler-state heap
# via mmap, mirroring the arm64 driver (main_aarch64_macho.cyr). This is
# the FIRST syscall cycc makes; on Darwin a raw brk(12) SIGSYS's before
# any output (the x86 driver previously paid this unconditionally, so the
# x86 Mach-O cycc never compiled on-device — only the syscall ABV xlat in
# emit.cyr was missing too; both are needed). Linux mmap number 9 →
# BSD 197 via EMACHO_SYSXLAT at emit. Size 0x5E1D000 (~94.1 MB) matches
# main.cyr's brk top below (output_buf 16 MB @ v6.1.27 + local tables
# +512 KB @ v6.1.40); flags MAP_ANON|MAP_PRIVATE = 0x1002.
var S = syscall(9, 0, 0x5E1D000, 3, 0x1002, 0 - 1, 0);
if (S < 0x100000) {
    syscall(1, 2, "cycc: mmap heap init failed\n", 28);
    syscall(60, 1);
}
#else
var S = syscall(SYS_BRK, 0);
# brk extends past the TS frontend heap region (0x1D0B000 base
# + 0xD81000 size, per src/frontend/ts/{lex,parse}.cyr design after
# v5.7.2 P2.1). TS region is only TOUCHED in --lex-ts / --parse-ts
# modes; the +13.5 MB brk extension is paid unconditionally.
syscall(SYS_BRK, S + 0x5E1D000);
#endif

# Zero scratch state (v5.8.63 extraction; see src/common/util.cyr for slot list)
_HEAP_INIT_SCRATCH(S);

# v6.0.6 — initialize the alloc/vec surface. v6.0.7 — assign the
# pre-declared `rp_vec` global (forward-declared above the parse.cyr
# include) its real value. alloc_init() must run AFTER our brk
# extension so its _heap_base sits past the fixed-heap region.
# Keeping the explicit alloc_init over alloc.cyr's lazy-init for
# narrower failure mode.
alloc_init();
rp_vec = vec_new();
# Phase 0 (v6.2.0): growable fixup table — base = the existing 0x107B000 region,
# cap = the old hard cap; GFCNT grows it 2x via alloc() once full (util.cyr).
_fixup_base = S + 0x107B000;
_fixup_cap = 1048576;
# Phase 0 (v6.2.0): growable fn-tables — bases start AT the original fixed
# offsets, mask 8191, cap 8192 (byte-identical under the old cap; REGFN grows
# the family + rehashes when the count would exceed it). See util.cyr.
_fnt_cstrmask = S + 0x93A000;
_fnt_resmask = S + 0x94A000;
_fnt_optmask = S + 0x95A000;
_fnt_tagmask = S + 0x96A000;
_fnt_ovstr = S + 0x97A000;
_fnt_ovint = S + 0x98A000;
_fnt_ovcstr = S + 0x99A000;
_fnt_simdmask = S + 0x9AA000;
_fnt_names = S + 0x9BA000;
_fnt_offsets = S + 0x9CA000;
_fnt_params = S + 0x9DA000;
_fnt_bodystart = S + 0x9EA000;
_fnt_bodyend = S + 0x9FA000;
_fnt_inline = S + 0xA0A000;
_fnt_strmask = S + 0xA1A000;
_fnt_codeend = S + 0xA2A000;
_fnt_namehash = S + 0x110000;
_fnt_starthash = S + 0x114000;
_fnt_hash_mask = 8191;
_fnt_cap = 8192;
# Phase 0 (v6.2.0): growable codebuf — base at the original 3 MB region,
# cap 3145728 (byte-identical under the old cap; EB grows + relocates off-heap
# when cp nears it). The cx backend's own 0x54A000 codebuf is separate + fixed.
_codebuf_base = S + 0x41A000;
_varn_base = S + 0x11A000;
_vars_base = S + 0x12A000;
_vart_base = S + 0x13A000;
_vgoff_base = S + 0x1B0000;
_vecv_base = S + 0x1D8000;
_vgsi_base = S + 0x1EC000;
_venid_base = S + 0x204000;
_var_cap = 8192;
_codebuf_cap = 3145728;

# Read input. Buffer is 256KB (v3.4.19, was 128KB before). If the source ever
# fills the whole buffer, we error out explicitly instead of silently truncating
# — the old silent cap at 131072 bytes masked the mabda 141KB bundle failure as
# a random "unexpected end of file" at token ~3719.
#
# v6.0.5: when `--parse-ts <file>` / `--lex-ts <file>` provides a path arg,
# read from the named file instead of stdin so scripted CI invocations don't
# block on a terminal-less stdin.
var _input_fd = 0;
if (_ts_input_path != 0) {
    if (SYS_OPEN == 2) { _input_fd = syscall(SYS_OPEN, _ts_input_path, 0, 0); }
    else { _input_fd = syscall(SYS_OPEN, 0 - 100, _ts_input_path, 0, 0); }
    if (_input_fd < 0) {
        syscall(SYS_WRITE, 2, "error: cannot open '", 20);
        var _pl = 0;
        while (load8(_ts_input_path + _pl) != 0) { _pl = _pl + 1; }
        syscall(SYS_WRITE, 2, _ts_input_path, _pl);
        syscall(SYS_WRITE, 2, "'\n", 2);
        syscall(SYS_EXIT, 1);
    }
}
var bl = 0;
var done = 0;
while (done == 0) {
    var n = syscall(SYS_READ, _input_fd, S + bl, 1048576 - bl);
    if (n <= 0) { done = 1; }
    else {
        bl = bl + n;
        if (bl >= 1048576) {
            # One more read to distinguish "exactly 256KB" from "more coming"
            var probe[1];
            var pn = syscall(SYS_READ, _input_fd, &probe, 1);
            if (pn > 0) {
                syscall(SYS_WRITE, 2, "error: input exceeds 1MB buffer (raise input_buf in src/main.cyr)\n", 66);
                syscall(SYS_EXIT, 1);
            }
            done = 1;
        }
    }
}
if (_input_fd != 0) { syscall(SYS_CLOSE, _input_fd); }
SBL(S, bl);

# ─── TS lex-only mode (P1.6b wire-in) ─────────────────────────────
# When --lex-ts is set, run TS_LEX on the source bytes and exit with
# 0 (clean lex) or 1 (lex error). No parser/typecheck/lower yet —
# those are v5.7.2 P2-P5. This mode lets cbt/build.cyr's compile()
# detect a .ts source and verify it lexes cleanly via cycc directly,
# without forcing every consumer to go through a separate test driver.
if (_ts_lex_only_mode == 1) {
    var _ts_n = TS_LEX(S + 0x298B000, S, bl);
    if (_ts_n < 0) {
        var _ts_err = TS_GETERR(S + 0x298B000);
        syscall(SYS_WRITE, 2, "ts lex error: code ", 19);
        var _eb[3];
        if (_ts_err >= 10) {
            store8(&_eb, 48 + _ts_err / 10);
            store8(&_eb + 1, 48 + _ts_err % 10);
            store8(&_eb + 2, 10);
            syscall(SYS_WRITE, 2, &_eb, 3);
        } else {
            store8(&_eb, 48 + _ts_err);
            store8(&_eb + 1, 10);
            syscall(SYS_WRITE, 2, &_eb, 2);
        }
        syscall(SYS_EXIT, 1);
    }
    syscall(SYS_EXIT, 0);
}

# ─── TS parse-only mode (P2.1 wire-in) ────────────────────────────

# Emit a non-negative i64 as decimal to stderr (fd 2).
fn _emit_decimal(n): i64 {
    if (n < 0) {
        syscall(SYS_WRITE, 2, "-", 1);
        n = 0 - n;
    }
    if (n == 0) {
        syscall(SYS_WRITE, 2, "0", 1);
        return 0;
    }
    var buf[24];
    var i = 0;
    while (n > 0) {
        store8(&buf + i, 48 + n % 10);
        n = n / 10;
        i = i + 1;
    }
    # Reverse in place + emit
    var rev[24];
    var j = 0;
    while (j < i) {
        store8(&rev + j, load8(&buf + (i - 1 - j)));
        j = j + 1;
    }
    syscall(SYS_WRITE, 2, &rev, i);
    return 0;
}

if (_ts_parse_only_mode == 1) {
    var _tp_lex_n = TS_LEX(S + 0x298B000, S, bl);
    if (_tp_lex_n < 0) {
        syscall(SYS_WRITE, 2, "ts lex error before parse\n", 26);
        syscall(SYS_EXIT, 1);
    }
    var _tp_parse_n = TS_PARSE(S + 0x298B000);
    if (_tp_parse_n < 0) {
        var _tp_err = TS_PARSE_GETERR(S + 0x298B000);
        var _tp_etok = TS_PARSE_GETERR_TOK(S + 0x298B000);
        # current parser TOK_IDX — most accurate since not all err
        # sites set ERR_TOK_IDX. Emit both for triage.
        var _tp_cur = load64(S + 0x298B000 + 0xD80000 + 8);   # TS_PS_TOK_IDX = 8
        var _tp_line = load64(S + 0x298B000 + 0x100000 + _tp_cur * 8);
        var _tp_type = load64(S + 0x298B000 + 0x000000 + _tp_cur * 8);
        syscall(SYS_WRITE, 2, "ts parse error: code=", 21);
        _emit_decimal(_tp_err);
        syscall(SYS_WRITE, 2, " line=", 6);
        _emit_decimal(_tp_line);
        syscall(SYS_WRITE, 2, " tok=", 5);
        _emit_decimal(_tp_type);
        syscall(SYS_WRITE, 2, " cur_idx=", 9);
        _emit_decimal(_tp_cur);
        syscall(SYS_WRITE, 2, " err_idx=", 9);
        _emit_decimal(_tp_etok);
        syscall(SYS_WRITE, 2, "\n", 1);
        syscall(SYS_EXIT, 1);
    }
    syscall(SYS_EXIT, 0);
}

if (_ts_emit_js_mode == 1) {
    var _ej_lex_n = TS_LEX(S + 0x298B000, S, bl);
    if (_ej_lex_n < 0) {
        syscall(SYS_WRITE, 2, "ts lex error before emit\n", 25);
        syscall(SYS_EXIT, 1);
    }
    var _ej_parse_n = TS_PARSE(S + 0x298B000);
    if (_ej_parse_n < 0) {
        syscall(SYS_WRITE, 2, "ts parse error before emit\n", 27);
        syscall(SYS_EXIT, 1);
    }
    var _ej_rc = TS_JS_EMIT(S + 0x298B000, S);
    syscall(SYS_EXIT, _ej_rc);
}

# Init stdlib fallback path from HOME env
_init_cyrius_lib();

# Register compiler-builtin arch marker so lib files can `#ifdef
# CYRIUS_ARCH_X86` to select x86-specific asm over aarch64 asm.
PP_PREDEFINE(S, "CYRIUS_ARCH_X86");
# v5.5.0: CYRIUS_TARGET_LINUX selects Linux-shaped stdlib peers
# when the target OS isn't explicitly Windows (cycc_win) or Mac
# (CYRIUS_MACHO envs). Paired with CYRIUS_TARGET_WIN (cycc_win.cyr)
# so stdlib selectors can pick per-OS peers without juggling
# missing `#else` / `#ifndef` directives.
# v5.5.6: honor the CYRIUS_TARGET_WIN=1 env var early (before
# PREPROCESS) so `#ifdef CYRIUS_TARGET_WIN` blocks in user code
# (notably lib/fnptr.cyr's Win64 fncallN variants) are actually
# emitted when this cycc binary is invoked with the env var to
# produce PE output. Without this check the preprocessor saw
# only CYRIUS_TARGET_LINUX and the Win64 blocks never fired,
# silently falling back to SysV asm that crashed on Windows.
var _pe_env_early = _read_env("CYRIUS_TARGET_WIN");
var _is_pe_build = 0;
if (_pe_env_early != 0) {
    if (load8(_pe_env_early) == 49 && load8(_pe_env_early + 1) == 0) {
        _is_pe_build = 1;
    }
}
# v6.1.6: CYRIUS_PIE=1 env mirrors the --pie cmdline flag (parsed above from
# /proc/self/cmdline). The cyrius-build wrapper + cross/test harnesses set the
# env; either path sets _pie_mode → position-independent kernel codegen.
# Effective only with `kernel;` (kmode==1); a no-op for userland/shared/object.
var _pie_env_early = _read_env("CYRIUS_PIE");
if (_pie_env_early != 0) {
    if (load8(_pie_env_early) == 49 && load8(_pie_env_early + 1) == 0) {
        _pie_mode = 1;
    }
}
# v5.11.52: CYRIUS_TARGET_EFI=1 implies the PE32+ container (Windows
# and UEFI share MS x64 ABI, PE format, shadow space convention).
# Setting _is_pe_build here makes downstream PP_PREDEFINE fire
# CYRIUS_TARGET_WIN — lib/fnptr.cyr's MS-x64 branches and other
# PE-targeting stdlib paths then activate for EFI builds. The
# CYRIUS_TARGET_EFI predefine itself is added below so consumers
# can target-discriminate when needed.
var _efi_env_early = _read_env("CYRIUS_TARGET_EFI");
var _is_efi_build = 0;
if (_efi_env_early != 0) {
    if (load8(_efi_env_early) == 49 && load8(_efi_env_early + 1) == 0) {
        _is_pe_build = 1;
        _is_efi_build = 1;
    }
}
# v5.5.16: check the Mach-O env vars at the same early point so
# `#ifdef CYRIUS_TARGET_MACOS` branches in stdlib (e.g. lib/alloc.cyr
# → lib/alloc_macos.cyr) activate on cross-builds to arm64 / x86_64
# Darwin. Before this patch the compiler unconditionally predefined
# CYRIUS_TARGET_LINUX for every non-Windows build — so on Mach-O
# targets `lib/alloc.cyr`'s brk-based Linux path fired, silently
# broken (brk is Linux-only; BSD syscall 12 is chdir, so the heap
# base turned into garbage and tool binaries exited 0 with no
# output — see v5.5.15 project note). CYRIUS_MACHO selects the
# x86_64 Mach-O path; CYRIUS_MACHO_ARM selects arm64 Darwin.
var _macho_env_early = _read_env("CYRIUS_MACHO");
var _macho_arm_env_early = _read_env("CYRIUS_MACHO_ARM");
var _is_macho_build = 0;
if (_macho_env_early != 0) {
    if (load8(_macho_env_early) == 49 && load8(_macho_env_early + 1) == 0) {
        _is_macho_build = 1;
    }
}
if (_macho_arm_env_early != 0) {
    if (load8(_macho_arm_env_early) == 49 && load8(_macho_arm_env_early + 1) == 0) {
        _is_macho_build = 1;
    }
}
# AGNOS ring-3 userspace target (x86_64 ELF + agnos syscall ABI) via
# CYRIUS_TARGET_AGNOS=1 — an emit target (cycc runs on the host, emits an
# agnos binary). See agnos/docs/development/agnos-userland-abi.md.
var _agnos_env_early = _read_env("CYRIUS_TARGET_AGNOS");
var _is_agnos_build = 0;
if (_agnos_env_early != 0) {
    if (load8(_agnos_env_early) == 49 && load8(_agnos_env_early + 1) == 0) {
        _is_agnos_build = 1;
    }
}
if (_is_pe_build == 1) {
    PP_PREDEFINE(S, "CYRIUS_TARGET_WIN");
    if (_is_efi_build == 1) { PP_PREDEFINE(S, "CYRIUS_TARGET_EFI"); }
} else { if (_is_macho_build == 1) {
        PP_PREDEFINE(S, "CYRIUS_TARGET_MACOS");
    } else { if (_is_agnos_build == 1) {
        # agnos ring-3: x86_64 ELF (default emit), agnos syscall ABI. NOT
        # CYRIUS_TARGET_LINUX (no /proc, different syscall numbers); agnos-
        # specific behavior is gated on #ifdef CYRIUS_TARGET_AGNOS.
        PP_PREDEFINE(S, "CYRIUS_TARGET_AGNOS");
        PP_PREDEFINE(S, "CYRIUS_HAS_VAL_SIMD_PARAMS");
    } else {
        PP_PREDEFINE(S, "CYRIUS_TARGET_LINUX");
# v5.10.39 — non-PE targets support the f64v2/f64v4 value-form
# param ABI (Phase 10 from v5.10.38). lib/simd.cyr gates value-form
# typed wrappers on this flag so PE builds skip them and the
# pointer-form `_ptr` siblings remain the supported PE path.
PP_PREDEFINE(S, "CYRIUS_HAS_VAL_SIMD_PARAMS");
    } } }

# v5.6.5 O1: total compile-time instrumentation. Gated by the
# CYRIUS_PROF env var (set to "1" to enable). Reads clock_gettime(
# CLOCK_MONOTONIC) now, again at exit, prints elapsed-ms to stderr.
# Cross-arch via #ifdef in _prof_clock_ns — x86_64 uses syscall 228,
# aarch64 uses 113; other targets return 0 so the breakdown reads
# "0 ms" but doesn't crash. Env read costs ~3 syscalls; clock reads
# are ~100 ns each — negligible even when CYRIUS_PROF is off
# because _prof_t0 still gets captured to keep the init path
# straight-line (byte-identical doesn't depend on this).
var _prof_on_env = _read_env("CYRIUS_PROF");
var _prof_on = 0;
if (_prof_on_env != 0) {
    if (load8(_prof_on_env) == 49) { _prof_on = 1; }
}
var _prof_t0 = 0;
if (_prof_on == 1) { _prof_t0 = _prof_clock_ns(); }

# v5.6.19 O4a: regalloc interval-table inspection knob.
# CYRIUS_REGALLOC_DUMP=1 prints per-fn (lidx, count, first_cp, last_cp)
# for every fn that runs the regalloc peephole. Foundation for v5.6.20
# Poletto-Sarkar — verify intervals match expectations before wiring
# the algorithm.
var _ra_dump_env = _read_env("CYRIUS_REGALLOC_DUMP");
if (_ra_dump_env != 0) {
    if (load8(_ra_dump_env) == 49) { _ra_dump_enabled = 1; }
}
# v5.6.20 O4b: CYRIUS_REGALLOC_PICKER_CAP=N — bisection knob for
# the new Poletto-Sarkar picker. Caps total assignments per fn.
# -1 = uncapped; 0 = no assignments (fall back to all-stack).
var _ra_picker_cap_env = _read_env("CYRIUS_REGALLOC_PICKER_CAP");
if (_ra_picker_cap_env != 0) {
    _ra_picker_cap = 0;
    var _rpci = 0;
    while (load8(_ra_picker_cap_env + _rpci) >= 48) {
        if (load8(_ra_picker_cap_env + _rpci) > 57) { _rpci = 99999; }
        else {
            _ra_picker_cap = _ra_picker_cap * 10 + (load8(_ra_picker_cap_env + _rpci) - 48);
            _rpci = _rpci + 1;
        }
    }
}
# v5.6.24 default-on: CYRIUS_REGALLOC_AUTO_CAP=N overrides the
# auto-enable cap. v5.6.22 shipped infra DISABLED. v5.6.23 narrowed
# the gate to skip inline-asm fns (layout-collision fix). v5.6.24
# fixed the picker bug surfaced by default-on (SysV ECALLPOPS for
# 8+ arg calls clobbered r12-r14 = picker's pinned-local regs) and
# flipped the default to ON.
#   < 0  = uncapped (every eligible fn) — compiled-in DEFAULT
#   == 0 = disabled (back to explicit #regalloc opt-in only)
#   > N  = first N eligible fns (bisection knob)
# "Eligible" = x86 backend + no inline asm in body.
var _ra_auto_cap_env = _read_env("CYRIUS_REGALLOC_AUTO_CAP");
if (_ra_auto_cap_env != 0) {
    _ra_auto_cap = 0;
    var _raci = 0;
    while (load8(_ra_auto_cap_env + _raci) >= 48) {
        if (load8(_ra_auto_cap_env + _raci) > 57) { _raci = 99999; }
        else {
            _ra_auto_cap = _ra_auto_cap * 10 + (load8(_ra_auto_cap_env + _raci) - 48);
            _raci = _raci + 1;
        }
    }
}

# v5.10.0 — per-phase timing for CYRIUS_PROF=1. Each major phase
# captures its end timestamp; the prof epilogue at line 1446
# subtracts adjacent timestamps for the breakdown. Costs ~100 ns
# per clock read (negligible vs second-scale phase totals); when
# CYRIUS_PROF=0 the captures are skipped via the guard. Phase
# boundaries: pp_end (preprocessor), lex_end, gvar_inits_end,
# parse_end, fixup_end, emit_elf_end, write_end (after stdout
# loop in the trailer). Foundation for the v5.10.x optimization
# arc — measure first, then optimize the slow phase.
var _prof_pp_end = 0;
var _prof_lex_end = 0;
var _prof_gvar_end = 0;
var _prof_parse_end = 0;
var _prof_fixup_end = 0;
var _prof_emit_end = 0;
var _prof_write_end = 0;

# Preprocess includes
PREPROCESS(S);
if (_prof_on == 1) { _prof_pp_end = _prof_clock_ns(); }


# Re-init ALL compiler state that the ifdef copy-back may have overwritten.
# For expanded source >256KB, the copy-back writes past S+0x40000 into every
# heap region up to S+bl. This mirrors the full initialization at lines 155-196
# so every scalar starts fresh before LEX runs.
S64(S + 0x18FCC8, 0);       # str_pos (moved from 0x70000 in 4.6.2)
S64(S + 0x18FCD0, 0);       # data_size (moved from 0x70008 in 4.6.2)
S64(S + 0x18C108, 0);       # CP
S64(S + 0x18C110, 0);       # VCNT
S64(S + 0x18C118, 0);       # TCNT
S64(S + 0x18C120, 0);       # TI
S64(S + 0x18C128, 0);       # NPOS
S64(S + 0x18FCA8, 0);       # fixup_cnt
S64(S + 0x18FCB0, 0 - 1);   # last_var
S64(S + 0x18DA00, 0);       # fn_count
S64(S + 0x18DA08, 0);       # in_fn
S64(S + 0x18DA10, 0);       # local_cnt
S64(S + 0x18F830, 0);       # struct_count
S64(S + 0x18F888, 0);       # extra_patch_cnt
S64(S + 0x18FCA0, 0);       # kernel_mode
# v6.2.27: the `--target=<arch>-bare-metal-elf` triple forces kernel mode from
# the CLI (CYRIUS_KERNEL=1) so a bare-metal build needs no source `kernel;`
# directive — the triple is the complete bare-metal declaration. Default unset →
# kernel_mode stays 0 → cycc byte-identical. The `kernel;` dispatch (PARSE_PROG)
# only ever SETS it to 1, so forcing it here composes (never reset to 0).
var _kern_env = _read_env("CYRIUS_KERNEL");
if (_kern_env != 0) {
    if (load8(_kern_env) == 49 && load8(_kern_env + 1) == 0) {
        S64(S + 0x18FCA0, 1);
    }
}
# v6.3.3 #5: CYRIUS_KERNEL_BASE=0x<hex> sets the kernel load/link base — the
# `[sections] base` manifest key flows in through this env (cbt appends it). Default
# unset -> cell 0x18FCE8 stays 0 -> _kernel_load_base() returns the built-in 0x100000
# -> cycc byte-identical. Resolves issues/2026-06-19-kernel-load-base-settable.md.
var _kbase_env = _read_env("CYRIUS_KERNEL_BASE");
if (_kbase_env != 0) {
    var _kb = _parse_hex_env(_kbase_env);
    if (_kb != 0) { S64(S + 0x18FCE8, _kb); }
}
S64(S + 0x18FCB8, 1);       # cur_line (starts at 1)
S64(S + 0x18FCC0, 0);       # scope_depth
S64(S + 0x1903D8, 0);       # expr_stype
S64(S + 0x1903E8, 0);       # inline_depth
S64(S + 0x1903F0, 0);       # expr_width
S64(S + 0x18F898, 0);       # continue_count
S64(S + 0x18FEC8, 0);       # current_module
S64(S + 0x1903D0, 0);       # use_count
S64(S + 0x19A000, 0);       # gvar_cnt
S64(S + 0x197000, 0);       # macro state
S64(S + 0x197F00, 0);       # macro state 2

# Build file map from #@file markers (for file:line error messages)
FM_BUILD(S);

# Lex
LEX(S);
if (_prof_on == 1) { _prof_lex_end = _prof_clock_ns(); }


# Emit initial jmp over fn bodies
EB(S, 0xE9);
var jmp_patch = GCP(S);
EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

# Pass 1: Pre-scan to register all global vars and structs (no fn bodies)
STI(S, 0);
var scan = 1;
while (scan == 1) {
    if (PEEKT(S) == 72) {
        # mod name; — set current module prefix
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); }
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    }
    else { if (PEEKT(S) == 73) {
            # pub — skip in pass 1 (just consume the keyword, next token is fn/var/struct)
            STI(S, GTI(S) + 1);
        }
        else { if (PEEKT(S) == 74) {
                # use modname.funcname; — register alias
                STI(S, GTI(S) + 1);
                if (PEEKT(S) == 2) {
                    var umod = PEEKV(S);
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 41) {
                        STI(S, GTI(S) + 1);
                        if (PEEKT(S) == 2) {
                            var ufn = PEEKV(S);
                            STI(S, GTI(S) + 1);
                            # Build mangled name: mod_fn
                            # Each alias gets 64 bytes in scratch area (30000 + uc*64)
                            var uc = GUSEC(S);
                            S64(S + 0x18FFD0 + uc * 8, ufn);
                            # Append mangled name to tok_names (after lexing, NPOS is stable)
                            # v5.11.65 (CVE-05): bound by actual source lengths.
                            var _ulen1 = 0; while (load8(S + 0x60000 + umod + _ulen1) != 0) { _ulen1 = _ulen1 + 1; }
                            var _ulen2 = 0; while (load8(S + 0x60000 + ufn + _ulen2) != 0) { _ulen2 = _ulen2 + 1; }
                            NPOS_GUARD(S, _ulen1 + 1 + _ulen2 + 1);
                            var apos = GNPOS(S);
                            var ri = 0;
                            var rc = load8(S + 0x60000 + umod + ri);
                            while (rc != 0) { store8(S + 0x60000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0x60000 + umod + ri); }
                            store8(S + 0x60000 + apos, 95); apos = apos + 1;
                            ri = 0; rc = load8(S + 0x60000 + ufn + ri);
                            while (rc != 0) { store8(S + 0x60000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0x60000 + ufn + ri); }
                            store8(S + 0x60000 + apos, 0); apos = apos + 1;
                            var alias_noff = GNPOS(S);
                            SNPOS(S, apos);
                            S64(S + 0x1901D0 + uc * 8, alias_noff);
                            SUSEC(S, uc + 1);
                        }
                    }
                }
                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
            }
            else { if (PEEKT(S) == 40) { PARSE_STRUCT_DEF(S); }
                else { if (PEEKT(S) == 101) { PARSE_UNION_DEF(S); }
                    else { if (PEEKT(S) == 3) { PARSE_GVAR_REG(S); }
                        # v4.8.4-alpha1: #regalloc — consume silently in pass 1. Pass 1
                        # doesn't REGFN, so there's no metadata slot to attach to here;
                        # pass 2 re-reads the same token stream and arms the pending flag
                        # then. (v4.8.4-alpha4 kept the pass-1 consume unchanged so a
                        # stale flag can't leak from pass 1 into pass 2.)
                        # v5.8.21: same shape for #must_use (122), #deprecated (124),
                        # #pure (125), #io (126), #alloc (127). Pre-fix, an annotated
                        # fn at the start of any stdlib file (e.g. `#io fn sys_write`)
                        # caused the pass-1 scanner to fall into the catchall else and
                        # terminate, leaving subsequent enum / fn defs unregistered for
                        # pass 2. Surfaced when the v5.8.20 annotation-ramp bite
                        # marked sys_open/close/read/write `#io` and check.sh dropped
                        # to 48/64 — every test file including syscalls hit
                        # "unexpected enum" at lib/syscalls_x86_64_linux.cyr:555.
                        # All five tokens consume silently here; pass 2 arms the
                        # pending flags via parse.cyr's directive dispatcher.
                        else { if (PEEKT(S) == 109) { STI(S, GTI(S) + 1); }
                            else { if (PEEKT(S) == 122) { STI(S, GTI(S) + 1); }
                                else { if (PEEKT(S) == 124) {
                                        # #deprecated has a (STR) message arg in pass 2;
                                        # in pass 1 we still need to consume the parens
                                        # and the string literal so they don't dangle.
                                        STI(S, GTI(S) + 1);
                                        if (PEEKT(S) == 10) {
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 30) { STI(S, GTI(S) + 1); }
                                            if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); }
                                        }
                                    }
                                    else { if (PEEKT(S) == 125) { STI(S, GTI(S) + 1); }
                                        else { if (PEEKT(S) == 126) { STI(S, GTI(S) + 1); }
                                            else { if (PEEKT(S) == 127 || PEEKT(S) == 133) { STI(S, GTI(S) + 1); }
                            else { if (_IS_FN_KW(S) == 1) {
                                    # v6.3.5 CO-01 — prescan the fn signature:
                                    # register the fn + record its ABI metadata
                                    # (param masks / count / variadic / return
                                    # type) so a forward call (lexically before
                                    # the definition) resolves the correct Str /
                                    # cstring / SIMD / struct-return ABI instead
                                    # of mask 0. Cursor advancement is byte-
                                    # identical to the prior inline skip — the
                                    # only new effect is the pass-1 registration
                                    # (see _prescan_fn_sig in parse_fn.cyr).
                                    _prescan_fn_sig(S);
                                }
                                else { if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 0); }
                                    else { if (_TOK_IS_KERNEL(S) == 1) {
                                            S64(S + 0x18FCA0, 1);
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                        }
                                        else { if (PEEKT(S) == 78) {
                                                S64(S + 0x18FCA0, 2);
                                                STI(S, GTI(S) + 1);
                                                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                            }
                                            else { if (PEEKT(S) == 79) {
                                                    S64(S + 0x18FCA0, 3);
                                                    STI(S, GTI(S) + 1);
                                                    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                                }
                                                else { if (PEEKT(S) == 77) {
                                                        # impl — skip entire block in pass 1 (functions registered in pass 2)
                                                        STI(S, GTI(S) + 1);  # consume IMPL
                                                        STI(S, GTI(S) + 1);  # consume trait name
                                                        STI(S, GTI(S) + 1);  # consume FOR
                                                        STI(S, GTI(S) + 1);  # consume type name
                                                        if (PEEKT(S) == 13) {
                                                            STI(S, GTI(S) + 1);
                                                            var idep = 0;
                                                            var isk = 1;
                                                            while (isk == 1) {
                                                                var it = PEEKT(S);
                                                                if (it == 13) { idep = idep + 1; }
                                                                if (it == 14) { if (idep == 0) { isk = 0; } else { idep = idep - 1; } }
                                                                if (it == 12) { isk = 0; }
                                                                STI(S, GTI(S) + 1);
                                                            }
                                                        }
                                                    }
                                                    else { if (PEEKT(S) == 107) {
                                                            # #assert — skip in pass 1, evaluated in pass 2 via PARSE_STMT
                                                            while (PEEKT(S) != 5 && PEEKT(S) != 12) { STI(S, GTI(S) + 1); }
                                                            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                                        }
                                                        else { scan = 0; } } } } } } } } } } } } } } } } } } }
}

# Reset module for pass 2
SMOD(S, 0);

# DCE pre-scan: build referenced-name bitmap in one pass over tokens.
# Uses output_buf (S+0x1DA000, 8KB) as scratch — safe because EMITELF runs later.
# Bitmap: bit N set means tok_names offset N is referenced as non-FN identifier.
var dce_bm = S + 0x1DA000;
var dce_zi = 0;
while (dce_zi < 8192) { store8(dce_bm + dce_zi, 0); dce_zi = dce_zi + 1; }
var dce_ti = 0;
var dce_tc = GTCNT(S);
var dce_prev = 0;
while (dce_ti < dce_tc) {
    var dce_tt = TOKTYP(S, dce_ti);
    if (dce_tt == 2) {
        if (dce_prev != 32) {
            var dce_noff = TOKVAL(S, dce_ti);
            if (dce_noff < 65536) {
                var dce_byte = dce_noff >> 3;
                var dce_bit = dce_noff & 7;
                store8(dce_bm + dce_byte, load8(dce_bm + dce_byte) | (1 << dce_bit));
            }
        }
    }
    dce_prev = dce_tt;
    dce_ti = dce_ti + 1;
}

# Mach-O output via CYRIUS_MACHO=1 (x86_64) or CYRIUS_MACHO_ARM=1 (ARM64)
var _macho_env = _read_env("CYRIUS_MACHO");
if (_macho_env != 0) {
    if (load8(_macho_env) == 49 && load8(_macho_env + 1) == 0) {
        _TARGET_MACHO = 1;
    }
}
var _macho_arm_env = _read_env("CYRIUS_MACHO_ARM");
if (_macho_arm_env != 0) {
    if (load8(_macho_arm_env) == 49 && load8(_macho_arm_env + 1) == 0) {
        _TARGET_MACHO = 2;
    }
}

# PE32+ output via CYRIUS_TARGET_WIN=1 (x86_64 Windows .exe).
# Routes final emit through src/backend/pe/emit.cyr's EMITPE_EXEC.
var _pe_env = _read_env("CYRIUS_TARGET_WIN");
if (_pe_env != 0) {
    if (load8(_pe_env) == 49 && load8(_pe_env + 1) == 0) {
        _TARGET_PE = 1;
    }
}

# v6.3.5 AR-01 — opt-in monomorphization substrate (gated proof). CYRIUS_MONOMORPH=1
# re-enables the inline body-token capture so the intact emit-time replay path
# fires; default off keeps codegen byte-identical. Set before pass 2 (capture runs
# in PARSE_FN_DEF). See util.cyr `_MONOMORPH_OK`.
var _mono_env = _read_env("CYRIUS_MONOMORPH");
if (_mono_env != 0) {
    if (load8(_mono_env) == 49 && load8(_mono_env + 1) == 0) {
        _MONOMORPH_OK = 1;
    }
}

# AGNOS ring-3 output via CYRIUS_TARGET_AGNOS=1 (x86_64 ELF, agnos syscall
# numbers + agnos exit=0). Shares the default ELF emit path (_TARGET_PE==0,
# _TARGET_MACHO==0); EEXIT branches on _TARGET_AGNOS for syscall(0) exit.
var _agnos_env = _read_env("CYRIUS_TARGET_AGNOS");
if (_agnos_env != 0) {
    if (load8(_agnos_env) == 49 && load8(_agnos_env + 1) == 0) {
        _TARGET_AGNOS = 1;
    }
}

# ELF64 kernel output via CYRIUS_ELF64_KERNEL=1. Same `kernel;` source
# directive — flag decides ELF class. Routes the kernel-mode (==1)
# branch in EMITELF (fixup.cyr) to EMITELF64_KERNEL instead of
# EMITELF_KERNEL. Used by the AGNOS kernel build for UEFI x86_64 boot
# (multiboot2 + EFI64-entry tag; GRUB-EFI hands off in long mode
# without long-mode-exit — see iron-boot-testing-log.md § Diagnosis
# 2026-05-13).
var _elf64k_env = _read_env("CYRIUS_ELF64_KERNEL");
if (_elf64k_env != 0) {
    if (load8(_elf64k_env) == 49 && load8(_elf64k_env + 1) == 0) {
        _TARGET_ELF64_KERNEL = 1;
    }
}

# UEFI Application output via CYRIUS_TARGET_EFI=1. Sibling of
# CYRIUS_TARGET_WIN — implies _TARGET_PE=1 (PE32+ container + MS x64
# ABI + .reloc) and additionally flips the Subsystem byte to 0xA
# (IMAGE_SUBSYSTEM_EFI_APPLICATION), suppresses the kernel32
# ExitProcess import + IAT call (EEXIT emits a bare `ret` — firmware
# reads rax as EFI_STATUS), and errors out at compile time on any
# kernel32-rerouted syscall (UEFI has no kernel32; silent miscompile
# avoided). Unblocks the gnoboot sovereign UEFI bootloader (AGNOS MVP
# boot path; see issue 2026-05-13-gnoboot-uefi-application-emit.md).
var _efi_env = _read_env("CYRIUS_TARGET_EFI");
if (_efi_env != 0) {
    if (load8(_efi_env) == 49 && load8(_efi_env + 1) == 0) {
        _TARGET_PE = 1;
        _TARGET_EFI_APPLICATION = 1;
    }
}

# cycc: opt-in IR recording via CYRIUS_IR=1|2
var _ir_env = _read_env("CYRIUS_IR");
if (_ir_env != 0) {
    var _ir_ch = load8(_ir_env);
    if (_ir_ch >= 49 && _ir_ch <= 51) {
        IR_SENABLE(S, 1);
        ir_reset(S);
    }
}

# Pass 2: Parse struct and fn definitions (vars already registered)
STI(S, 0);
var topgo = 1;
while (topgo == 1) {
    # Skip mod/pub/use in pass 2
    if (PEEKT(S) == 72) { STI(S, GTI(S) + 1); if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
    else { if (PEEKT(S) == 73) { STI(S, GTI(S) + 1); }
        else { if (PEEKT(S) == 74) { while (PEEKT(S) != 5) { if (PEEKT(S) == 12) { break; } STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
            else { if (PEEKT(S) == 40) {
                    # Skip struct (already parsed in pass 1)
                    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                    if (PEEKT(S) != 13) { ERR(S); }
                    STI(S, GTI(S) + 1);
                    var ssk = 1;
                    while (ssk == 1) { if (PEEKT(S) == 14) { ssk = 0; } else { STI(S, GTI(S) + 1); } }
                    STI(S, GTI(S) + 1);
                }
                else { if (PEEKT(S) == 101) {
                        # Skip union (already parsed in pass 1)
                        STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                        if (PEEKT(S) != 13) { ERR(S); }
                        STI(S, GTI(S) + 1);
                        var usk = 1;
                        while (usk == 1) { if (PEEKT(S) == 14) { usk = 0; } else { STI(S, GTI(S) + 1); } }
                        STI(S, GTI(S) + 1);
                    }
                    else { if (PEEKT(S) == 60) {
                            # Emit constructor bodies in function section (before JMP is patched)
                            PARSE_ENUM_DEF(S, 2);
                        }
                        else { if (_TOK_IS_KERNEL(S) == 1) {
                                STI(S, GTI(S) + 1);
                                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                            }
                            # v4.8.4-alpha4: #regalloc — arm the pending flag so the next `fn`
                            # definition picks it up in REGFN. PARSE_FN_DEF transfers the flag
                            # to fn_regalloc[fi] and clears _regalloc_pending. The DCE stub
                            # path below also clears the flag (dead fns don't need tracking).
                            #
                            # v5.8.21: same shape for the v5.6.x + v5.8.20 fn-attribute
                            # tokens. Pre-fix, an annotated fn at top of any stdlib file
                            # (e.g. `#io fn sys_write`) had no Pass-2 handler, so the
                            # directive token sat unconsumed and the parser hit `enum`
                            # at line 555 (or wherever the next decl was) in the WRONG
                            # context — surfaced as "unexpected enum" with a misleading
                            # line number. All five tokens arm the corresponding pending
                            # flag in parse.cyr; PARSE_FN_DEF transfers them at the next
                            # fn definition.
                            else { if (PEEKT(S) == 109) { _regalloc_pending = 1; STI(S, GTI(S) + 1); }
                                else { if (PEEKT(S) == 122) { _must_use_pending = 1; STI(S, GTI(S) + 1); }
                                    else { if (PEEKT(S) == 124) {
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 10) {
                                                STI(S, GTI(S) + 1);
                                                if (PEEKT(S) == 30) {
                                                    _deprecated_msg_pending = PEEKV(S);
                                                    _deprecated_pending = 1;
                                                    STI(S, GTI(S) + 1);
                                                }
                                                if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); }
                                            }
                                        }
                                        else { if (PEEKT(S) == 125) { _pure_pending = 1; STI(S, GTI(S) + 1); }
                                            else { if (PEEKT(S) == 126) { _io_pending = 1; STI(S, GTI(S) + 1); }
                                                else { if (PEEKT(S) == 127 || PEEKT(S) == 133) { if (PEEKT(S) == 133) { _naked_pending = 1; } else { _alloc_pending = 1; } STI(S, GTI(S) + 1); }
                                else { if (_IS_FN_KW(S) == 1) {
                                        # v6.3.11 (G): consume a leading `async` here (cursor → `fn`) so the
                                        # DCE name-read + match-peek + stub paths below all see the real fn
                                        # name, not `async`. _pending_async is armed only on the reachable
                                        # path (below), so a DCE-stubbed async fn can't leak the flag.
                                        var _blk_async = 0;
                                        if (PEEKT(S) == 134) { _blk_async = 1; STI(S, GTI(S) + 1); }
                                        # DCE: check bitmap for reference to this function name.
                                        # Skip DCE for module-scoped or underscore-named functions.
                                        # Also skip in object mode — externally-referenced functions
                                        # don't appear as identifiers in this module's token stream but
                                        # still need full bodies for the linker to resolve cross-unit calls.
                                        # And in shared mode — exported `.so` functions are called by
                                        # dlopen consumers (no in-module reference) and need full bodies.
                                        var dce_fnoff = TOKVAL(S, GTI(S) + 1);
                                        var dce_reachable = 1;
                                        var dce_km = L64(S + 0x18FCA0);
                                        if (dce_km == 3 || dce_km == 2) { dce_reachable = 1; }
                                        else { if (GMOD(S) == 0) {
                                                # v5.9.37: exempt `main` from DCE. The auto-call-
                                                # main path at the exit epilogue calls main from
                                                # generated code (no user-visible ident reference);
                                                # without this exemption DCE would stub main to
                                                # `xor eax, eax; ret` and the program would exit 0
                                                # without running its actual body.
                                                var dce_is_main = 0;
                                                if (load8(S + 0x60000 + dce_fnoff) == 109) {     # 'm'
                                                    if (load8(S + 0x60000 + dce_fnoff + 1) == 97) {   # 'a'
                                                        if (load8(S + 0x60000 + dce_fnoff + 2) == 105) {   # 'i'
                                                            if (load8(S + 0x60000 + dce_fnoff + 3) == 110) {   # 'n'
                                                                if (load8(S + 0x60000 + dce_fnoff + 4) == 0) {
                                                                    dce_is_main = 1;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                # Check for underscore in name (mangled — skip DCE)
                                                var dce_np = S + 0x60000 + dce_fnoff;
                                                var dce_has_us = 0;
                                                var dce_ni = 0;
                                                while (load8(dce_np + dce_ni) != 0) {
                                                    if (load8(dce_np + dce_ni) == 95) { dce_has_us = 1; }
                                                    dce_ni = dce_ni + 1;
                                                }
                                                if (dce_is_main == 0) {
                                                    if (dce_has_us == 0) {
                                                        # Check bitmap: is this name offset referenced?
                                                        if (dce_fnoff < 65536) {
                                                            var dce_byte = dce_fnoff >> 3;
                                                            var dce_bit = dce_fnoff & 7;
                                                            if ((load8(dce_bm + dce_byte) & (1 << dce_bit)) == 0) {
                                                                dce_reachable = 0;
                                                            }
                                                        }
                                                    }
                                                }
                                            } }
                                        # v6.2.28: a #naked fn is referenced by ADDRESS (its slot in
                                        # the IDT), not by an in-module call, so the DCE bitmap (keyed
                                        # on ident references) wrongly stubs it — and a stubbed naked
                                        # fn bypasses PARSE_FN_DEF's param/return safety guards
                                        # (issue 2026-06-19-naked-fn-safety). Force it reachable so the
                                        # real body + the guards always run. _naked_pending is armed at
                                        # the pass-2 #naked dispatch (token 133) one iteration prior.
                                        if (_naked_pending == 1) { dce_reachable = 1; }
                                        # v5.9.24 (agnosys 1.1.5 filing): semantic checks
                                        # emitted during body parse (e.g. `match` exhaustiveness
                                        # warning at PARSE_MATCH:488) must NOT be gated on
                                        # DCE-reachability. The DCE bitmap is keyed on noff
                                        # presence in the token stream; stdlib's `lib/string.cyr`
                                        # uses `n` as a local variable name, so user `fn n(x)`
                                        # collides into the "reachable" bucket while user
                                        # `fn name(x)` (no stdlib reference) lands in the
                                        # "unreachable" bucket — the warning fires
                                        # non-deterministically across fn names. Fix: peek
                                        # ahead through the body for token 75 (match); if any
                                        # match block is present, force dce_reachable=1 so
                                        # PARSE_FN_DEF runs the coverage check. Token-skip
                                        # bookkeeping is restored before dispatch.
                                        if (dce_reachable == 0) {
                                            var _mp_save_ti = GTI(S);
                                            STI(S, GTI(S) + 1);  # past `fn`
                                            STI(S, GTI(S) + 1);  # past name
                                            if (PEEKT(S) == 19) {
                                                while (PEEKT(S) != 20) { if (PEEKT(S) == 12) { break; } STI(S, GTI(S) + 1); }
                                                if (PEEKT(S) == 20) { STI(S, GTI(S) + 1); }
                                            }
                                            if (PEEKT(S) == 10) {
                                                STI(S, GTI(S) + 1);
                                                var _mp_pd = 1;
                                                while (_mp_pd > 0 && PEEKT(S) != 12) {
                                                    if (PEEKT(S) == 10) { _mp_pd = _mp_pd + 1; }
                                                    elif (PEEKT(S) == 11) { _mp_pd = _mp_pd - 1; }
                                                    STI(S, GTI(S) + 1);
                                                }
                                            }
                                            if (PEEKT(S) == 49) {
                                                STI(S, GTI(S) + 1);
                                                if (PEEKT(S) == 2) { STI(S, GTI(S) + 1); }
                                            }
                                            if (PEEKT(S) == 13) {
                                                STI(S, GTI(S) + 1);
                                                var _mp_bd = 1;
                                                while (_mp_bd > 0 && PEEKT(S) != 12) {
                                                    if (PEEKT(S) == 13) { _mp_bd = _mp_bd + 1; }
                                                    elif (PEEKT(S) == 14) { _mp_bd = _mp_bd - 1; }
                                                    elif (PEEKT(S) == 75) { dce_reachable = 1; }
                                                    STI(S, GTI(S) + 1);
                                                }
                                            }
                                            STI(S, _mp_save_ti);
                                        }
                                        if (dce_reachable == 1) {
                                            if (_blk_async == 1) { _pending_async = 1; }   # v6.3.11 (G): arm async lowering for PARSE_FN_DEF
                                            PARSE_FN_DEF(S);
                                        } else {
                                            # Emit stub: set fn_offsets, emit xor eax,eax; ret, skip body
                                            STI(S, GTI(S) + 1);  # consume FN
                                            var stub_noff = PEEKV(S);
                                            STI(S, GTI(S) + 1);  # consume name
                                            if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                                            # Register or find function and set its offset to stub
                                            var stub_fi = FINDFN(S, stub_noff);
                                            if (stub_fi < 0) { stub_fi = REGFN(S, stub_noff); }
                                            # v4.8.4-alpha4: clear any pending `#regalloc` — a DCE'd fn
                                            # is emitted as a 3-byte stub and has no prologue to attach
                                            # callee-saved-reg state to. Leaving the flag armed would
                                            # leak it to whichever fn lands next.
                                            if (_regalloc_pending == 1) { _regalloc_pending = 0; }
                                            # v6.2.27 (review P1): a DCE-stubbed #naked fn must clear
                                            # _naked_pending too — else it leaks into the next live fn
                                            # (e.g. main), which is then emitted frameless and faults on
                                            # rbp-relative arg-home stores against rbp=0 (SIGSEGV).
                                            if (_naked_pending == 1) { _naked_pending = 0; }
                                            S64(_fnt_offsets + stub_fi * 8, GCP(S));
                                            # Emit stub: xor eax, eax; ret (3 bytes)
                                            EB(S, 0x31); EB(S, 0xC0); EB(S, 0xC3);
                                            # Skip function body tokens
                                            var sdep = 0;
                                            var ssk2 = 1;
                                            while (ssk2 == 1) {
                                                var st = PEEKT(S);
                                                if (st == 13) { sdep = sdep + 1; }
                                                if (st == 14) { sdep = sdep - 1; if (sdep == 0) { ssk2 = 0; } }
                                                if (st == 12) { ssk2 = 0; }
                                                STI(S, GTI(S) + 1);
                                            }
                                        }
                                    }
                                    else { if (PEEKT(S) == 3) {
                                            var vsk = 1;
                                            while (vsk == 1) { if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); vsk = 0; } else { STI(S, GTI(S) + 1); } }
                                        }
                                        else { if (PEEKT(S) == 77) { PARSE_IMPL(S); }
                                            else { if (PEEKT(S) == 78) { STI(S, GTI(S) + 1); if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
                                                else { if (PEEKT(S) == 79) { STI(S, GTI(S) + 1); if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
                                                    else { topgo = 0; } } } } } } } } } } } } } } } } } }
}

# Reset module
SMOD(S, 0);

# Patch jmp to land here (start of main code)
EPATCH(S, jmp_patch);

# v6.1.30: x86-macho argv — park the init rsp in r15 (reserved from regalloc, see
# parse_fn.cyr cap on _TARGET_MACHO==1) as the FIRST landing instruction. The entry
# jmp preserves rsp, so here rsp is still the init stack ([rsp]=argc, inline
# argv/envp) — captured before EMIT_GVAR_INITS / EFNPRO below push anything. r15 is
# never clobbered, so it survives into argc()/argv()/_read_env. cycc ignores it.
# MUST match main_x86_macho.cyr's macho park byte-for-byte (cross == native).
# _TARGET_MACHO==1 is x86 Mach-O (==2 is arm64, which has its own x28 prologue).
if (_TARGET_MACHO == 1) { E3(S, 0xE78949); }   # mov r15, rsp   (49 89 E7)
# v6.1.32: agnos argv — same SysV init stack as x86-macho ([rsp]=argc, inline
# argv/envp), same r15 park at the landing. Done HERE (before EMIT_GVAR_INITS)
# so a call-bearing top-level initializer `var r = main();` — emitted INSIDE the
# gvar-init block — can't run main() before the capture. The old v6.1.14 `call
# _agnos_capture_rsp` was emitted AFTER EMIT_GVAR_INITS (below), so for that
# entry shape main() ran with _agnos_init_rsp still 0 → argc()==0 (attn11 issue
# 2026-06-10-cyrius-agnos-capture-after-gvar-init-call). r15 is reserved from
# regalloc (parse_fn.cyr cap on _TARGET_AGNOS==1); lib/args_agnos.cyr reads it.
if (_TARGET_AGNOS == 1) { E3(S, 0xE78949); }   # mov r15, rsp   (49 89 E7)

# v5.11.52: under CYRIUS_TARGET_EFI=1, save firmware-supplied entry
# args (RCX = ImageHandle, RDX = SystemTable per UEFI MS x64 ABI)
# into callee-saved R14/R15 BEFORE any user emit fires. EMIT_GVAR_INITS
# and top-level statements emit instructions that clobber RAX/RCX
# (e.g. `mov rcx, &gvar; mov [rcx], rax`). R14/R15 are callee-saved
# in both SysV and MS x64 — cyrius's emit machinery preserves them
# across all per-byte and per-call sequences, so they survive
# everything up to the efi_main call below.
#
# v5.11.53: REX prefix was wrong at v5.11.52 ship. MR-form `mov r/m, r`
# encodes dst in the r/m field; to extend dst to r14/r15 needs REX.B,
# not REX.R. v5.11.52 emitted REX `0x4C` (W+R) which is correct for
# the RESTORE direction below (r14/r15 as source → reg field → REX.R)
# but WRONG for the SAVE here (r14/r15 as destination → r/m field →
# REX.B). Decoded, `4C 89 CE` was `mov rsi, r9` not `mov r14, rcx`.
# Correct prefix is `0x49` (W+B). Filed at
# docs/development/issues/archived/2026-05-13-efi-main-trampoline-save-rex-wrong.md;
# gnoboot's first call inside efi_main NULL-deref'd CR2=0 because
# RCX/RDX restored from uninitialized R14/R15 (which had the
# AF-pattern OVMF uses for unallocated memory).
# Bytes: 49 89 CE  (mov r14, rcx) ; 49 89 D7  (mov r15, rdx)
if (_TARGET_EFI_APPLICATION == 1) {
    # v5.11.54: byte-literal save replaced with named ops. The
    # v5.11.52 ship had `EB(S, 0x4C)` here which silently encoded
    # `mov rsi, r9` instead of `mov r14, rcx` — see CHANGELOG
    # [5.11.53] postmortem. Named ops put the REX bit in the op
    # name, so future encoding bugs surface at compile-time review
    # (wrong op name) instead of slipping past as numeric typos.
    EMOV_R14_RCX(S);
    EMOV_R15_RDX(S);
}

# In object mode AND shared mode, wrap top-level code as a callable
# function (_cyrius_init). Object mode: linked binaries call it after
# symbol merge. Shared mode: dynamic loader calls it via DT_INIT on
# dlopen — this is how `var x = 100;` initializers actually run.
var _cyrius_init_offset = GCP(S);
S64(S + 0x1903F8, _cyrius_init_offset);
var _init_km = L64(S + 0x18FCA0);
if (_init_km == 3 || _init_km == 2) {
    EFNPRO(S);               # push rbp; mov rbp, rsp
    # Allocate generous stack frame for top-level init code (4096 bytes = 512 locals)
    E3(S, 0xEC8148);          # sub rsp, imm32
    EB(S, 0x00); EB(S, 0x10); EB(S, 0x00); EB(S, 0x00);  # 0x1000 = 4096 bytes
}

# Emit enum initializations FIRST (before gvar inits, since gvar inits may call
# functions that reference enum values)
var gvar_save_ti = GTI(S);
STI(S, 0);
var escan = 1;
while (escan == 1) {
    if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 1); }
    else { if (PEEKT(S) == 12) { escan = 0; }
        else { STI(S, GTI(S) + 1); } }
}
# v5.7.19: kmode == 1 needs top-level asm (the multiboot 32→64
# long-mode boot shim) to run BEFORE any 64-bit gvar-init code.
# Multiboot1 hands control in 32-bit protected mode; gvar inits
# emit `mov rcx, imm64` (REX.W) + `mov [rcx], rax` sequences that
# #GP under 32-bit. cc3 emitted top-level asm at the entry; that
# ordering invariant was load-bearing for every agnos release and
# silently dropped at v5.0.0 (cc4→cycc IR overhaul). Path A1 from
# agnos/docs/development/proposals/2026-04-27-cycc-kernel-boot-shim-regression.md
# restores it for kmode only — non-kmode paths unchanged so cycc
# self-host stays byte-identical.
if (_init_km == 1) {
    # Kernel mode: PARSE_PROG FIRST (top-level asm runs before gvar inits).
    STI(S, gvar_save_ti);
    PARSE_PROG(S);
} else {
    # Executable / object / shared modes: gvar inits before main parse.
    EMIT_GVAR_INITS(S);
    STI(S, gvar_save_ti);
}
if (_prof_on == 1) { _prof_gvar_end = _prof_clock_ns(); }

# Warn about undefined functions (registered but never defined — offset still -1)
var wfi = 0;
var wfc = GFNC(S);
while (wfi < wfc) {
    if (L64(_fnt_offsets + wfi * 8) < 0) {
        syscall(SYS_WRITE, 2, "warning: undefined function '", 29);
        PRSTR(S + 0x60000 + L64(_fnt_names + wfi * 8));
        syscall(SYS_WRITE, 2, "'\n", 2);
    }
    wfi = wfi + 1;
}

if (_init_km == 1) {
    EMIT_GVAR_INITS(S);
} else {
    # v6.0.58: x86-macОS argv/env capture ("layer 6"). Emit `call
    # _macho_capture_args` HERE — after EMIT_GVAR_INITS above (so the
    # `_macho_init_rsp = 0` initializer already ran and won't clobber us) but
    # BEFORE PARSE_PROG (so it runs ahead of any top-level `var r = main();
    # syscall(60, r)` that would exit before the auto-call-main below — the case
    # for cyrfmt/cyrlint/cyrdoc and the cyrius wrapper). rsp here still = the
    # LC_UNIXTHREAD init stack ([rsp]=argc, inline argv). The fn parks the init
    # rsp into _macho_init_rsp; argc()/argv()/_macho_fill_environ read it. Emits
    # nothing if the program omits args_macos.cyr (e.g. cycc, reads stdin).
    # _TARGET_MACHO==1 is x86-macho; ==2 is arm64 (its own stp/x28 prologue).
    if (_TARGET_MACHO == 1) {
        var _mcap_found = _find_fn_by_name(S, "_macho_capture_args", 19);
        if (_mcap_found >= 0) {
            var _mcap_off = L64(_fnt_offsets + _mcap_found * 8);
            if (_mcap_off >= 0) { ECALLTO(S, _mcap_off); }
        }
    }
    # v6.1.32: the agnos init-rsp capture moved UP to the entry landing (the r15
    # park next to the x86-macho one). The v6.1.14 `call _agnos_capture_rsp` that
    # used to be HERE ran AFTER EMIT_GVAR_INITS, so a `var r = main();` gvar
    # initializer (emitted inside the gvar-init block) executed main() before the
    # capture → argc()==0 (attn11 issue
    # 2026-06-10-cyrius-agnos-capture-after-gvar-init-call). The landing park is
    # immune to that. See the park above + lib/args_agnos.cyr.
    # Parse main code (top-level statements)
    PARSE_PROG(S);
}
if (_prof_on == 1) { _prof_parse_end = _prof_clock_ns(); }

# Exit epilogue
var lv = GLVAR(S);
if (lv >= 0) { EVLOAD(S, lv); }

# v5.11.52: `fn efi_main(handle, st)` entry convention. When
# CYRIUS_TARGET_EFI=1 AND a fn named `efi_main` is registered, emit
# a trampoline call AFTER GLVAR load (which clobbers rax): restore
# the firmware args saved at entry (R14 → RCX = ImageHandle, R15 →
# RDX = SystemTable), allocate the MS x64 shadow space + 8-byte
# stack alignment, call efi_main directly, restore the stack. The
# EEXIT below emits a single `ret` under EFI mode — firmware reads
# RAX as EFI_STATUS.
#
# Must run AFTER the GLVAR-load above (mirrors the main-fn auto-call
# pattern at line ~1362) — that load otherwise clobbers efi_main's
# rax return. Must run BEFORE EEXIT so EEXIT's `ret` returns rax to
# firmware.
#
# If `efi_main` isn't defined, fall through to today's behavior:
# top-level statements ran during PARSE_PROG, firmware-supplied args
# survive on the caller's terms (hand-rolled inline-asm capture). The
# convention is opt-in via fn presence.
#
# Closes the second of the two 2026-05-13 gnoboot ergonomic filings;
# see archived/2026-05-13-gnoboot-efi-main-convention.md.
if (_TARGET_EFI_APPLICATION == 1) {
    # v5.11.54: open-coded 9-deep byte match replaced with
    # _find_fn_by_name helper. Same shape as the `main` lookup
    # above; v5.11.52 shipped the open-coded version.
    var _efm_found = _find_fn_by_name(S, "efi_main", 8);
    if (_efm_found >= 0) {
        var _efm_off = L64(_fnt_offsets + _efm_found * 8);
        if (_efm_off >= 0) {
            # v5.11.54: byte-literal restore + RSP-adjust replaced
            # with named ops (parallel to the save above).
            EMOV_RCX_R14(S);                # restore ImageHandle
            EMOV_RDX_R15(S);                # restore SystemTable
            ESUB_RSP_IMM8(S, 0x28);          # MS-x64 shadow space + align
            ECALLTO(S, _efm_off);
            EADD_RSP_IMM8(S, 0x28);
            # EEXIT below emits `ret` under EFI mode — firmware reads
            # rax as EFI_STATUS (the value efi_main returned).
        }
    }
}

# v6.0.55: agnos init-stack capture USED to live here (entry epilogue, just
# before `call main`). v6.1.14 moved it up to after EMIT_GVAR_INITS / before
# PARSE_PROG. v6.1.32 moved it UP AGAIN to the entry LANDING (an r15 park, before
# EMIT_GVAR_INITS) — the after-gvar-init placement still ran behind a
# call-bearing `var r = main();` initializer (main() executed during the
# gvar-init block, before the capture → argc()==0). The landing park is immune.
# See the r15 park near the top of main code + CHANGELOG [6.1.32].

# v5.9.37: auto-call `main()` if defined and not already called.
# Pre-fix sources with only `fn main() { ... }` (no trailing
# `var ec = main(); syscall(60, ec);` wiring) ran the gvar
# inits + parse-prog and exited with rax=junk — main was never
# invoked. Surfaced from agnosys 1.1.12 verbatim repro at
# /tmp/cyrius-derive-serialize-incomplete/minimal_repro.cyr
# which has only the fn def with no main-wire and would print
# nothing + exit 80.
#
# We walk the fn table looking for an exact byte-match on
# "main\0". If found AND its offset is set (body emitted), AND
# we're in executable mode, emit `call main` directly. Any
# user-side `syscall(60, ...)` already exited before we get
# here, so this is purely a fallback for the no-wire case.
#
# Must run AFTER the GLVAR-load above — that load otherwise
# clobbers main's rax return.
var _epi_km_pre = L64(S + 0x18FCA0);
if (_epi_km_pre == 0) {
    # v5.11.54: open-coded nested-if byte match replaced with
    # _find_fn_by_name helper (src/common/util.cyr). Same shape
    # as the efi_main lookup below; both collapse to one helper.
    var _main_found = _find_fn_by_name(S, "main", 4);
    if (_main_found >= 0) {
        var _main_off = L64(_fnt_offsets + _main_found * 8);
        if (_main_off >= 0) {
            ECALLTO(S, _main_off);
        }
    }
}
var _epi_km = L64(S + 0x18FCA0);
if (_epi_km == 3 || _epi_km == 2) {
    # Object / shared mode: return from _cyrius_init (leave; ret).
    # Shared mode uses this as the DT_INIT target.
    EFNEPI(S);
} else {
    # Executable mode: exit via syscall(60, exit_code)
    EEXIT(S);
}

# cycc: IR stats/dump
if (IR_ENABLED(S) == 1) {
    var ir_bbs = ir_build_bbs(S);
    var ir_edges = ir_build_edges(S);
    var ir_lase_n = ir_lase(S);
    # v5.6.12: LASE + DBE codebuf patching ENABLED under CYRIUS_IR=3.
    # Safety precondition: parse_*.cyr's 15 direct-emit blocks are now
    # wrapped with IR_RAW_EMIT markers so DBE's `all_nop` check returns
    # 0 when a BB contains raw emits (no spurious NOP-fill). LASE's
    # 16-byte range limit remains intact.
    var ir_lase_bytes = 0;
    var ir_dbe_bytes = 0;
    # v5.6.14: LASE correctness fix shipped. Root cause was
    # parse_ctrl.cyr capturing while/for loop_top = GCP(S) WITHOUT
    # recording an IR_NOP landing pad, so ir_build_bbs didn't split
    # BBs at loop tops. JMP_BACK targets then landed mid-BB, letting
    # LASE eliminate LOAD_LOCALs that were "same-BB after STORE_LOCAL"
    # only on first entry — loop-back iterations had rax clobbered.
    # Parse now records IR_NOP at each loop_top (4 sites in
    # parse_ctrl.cyr). Also closed three coverage gaps in EMULH,
    # EIDIV, ELODC by recording IR_RAX_CLOBBER.
    #
    # DBE remains disabled — needs its own correctness audit (suspect
    # #3 from v5.6.14 roadmap: ir_dead_block_elim's `all_nop == 1`
    # check passes vacuously on zero-IR-node BBs).
    var ir_fold_n = 0;
    var ir_fold_bytes = 0;
    var ir_dce_n = 0;
    var ir_dce_bytes = 0;
    var ir_dse_n = 0;
    var ir_fp_iter = 0;
    if (load8(_ir_env) == 51) {
        # v5.6.18 cap knobs (per the v5.6.17 saved bisection methodology —
        # every IR pass gets a CYRIUS_<PASS>_CAP knob from day 1).
        var _dce_cap_env = _read_env("CYRIUS_DCE_CAP");
        var _dce_cap = 0 - 1;
        if (_dce_cap_env != 0) {
            _dce_cap = 0;
            var _dci = 0;
            while (load8(_dce_cap_env + _dci) >= 48) {
                if (load8(_dce_cap_env + _dci) > 57) { _dci = 99999; }
                else {
                    _dce_cap = _dce_cap * 10 + (load8(_dce_cap_env + _dci) - 48);
                    _dci = _dci + 1;
                }
            }
        }
        var _dse_cap_env = _read_env("CYRIUS_DSE_CAP");
        var _dse_cap = 0 - 1;
        if (_dse_cap_env != 0) {
            _dse_cap = 0;
            var _dsi = 0;
            while (load8(_dse_cap_env + _dsi) >= 48) {
                if (load8(_dse_cap_env + _dsi) > 57) { _dsi = 99999; }
                else {
                    _dse_cap = _dse_cap * 10 + (load8(_dse_cap_env + _dsi) - 48);
                    _dsi = _dsi + 1;
                }
            }
        }
        # v5.6.18 Phase O3c: fixed-point driver — repeats LASE-apply →
        # const-fold → DCE → dead-store until no new candidates fire.
        # Cascading: dead-store removes a STORE_LOCAL whose preceding
        # LOAD_IMM may then become eligible for fold/DCE; the loop
        # catches those. Hard cap at 8 iterations as a safety belt.
        var _changed = 1;
        while (_changed == 1) {
            _changed = 0;
            ir_fp_iter = ir_fp_iter + 1;
            var fp_fold_pack = ir_const_fold(S);
            var fp_fold_n = (fp_fold_pack >> 32) & 0xFFFFFFFF;
            if (fp_fold_n > 0) {
                ir_fold_n = ir_fold_n + fp_fold_n;
                ir_fold_bytes = ir_fold_bytes + (fp_fold_pack & 0xFFFFFFFF);
                _changed = 1;
            }
            var fp_dce_n = ir_dce_capped(S, _dce_cap);
            if (fp_dce_n > 0) { ir_dce_n = ir_dce_n + fp_dce_n; _changed = 1; }
            var fp_dse_n = ir_dead_store_capped(S, _dse_cap);
            if (fp_dse_n > 0) { ir_dse_n = ir_dse_n + fp_dse_n; _changed = 1; }
            if (ir_fp_iter >= 8) { _changed = 0; }
        }
        # Apply LASE once at the end — picks up all IR_ELIMINATEDs from
        # all passes (DCE + dead-store).
        ir_lase_bytes = ir_apply_lase(S);
        ir_dce_bytes = ir_lase_bytes;  # legacy field name; reflects total NOP-fill
        # DBE pinned to a later investigation slot.
        # ir_dbe_bytes = ir_dead_block_elim(S);
    }
    syscall(SYS_WRITE, 2, "ir: ", 4);
    PRNUM(IR_NCNT(S));
    syscall(SYS_WRITE, 2, " nodes, ", 8);
    PRNUM(ir_bbs);
    syscall(SYS_WRITE, 2, " BBs, ", 6);
    PRNUM(ir_edges);
    syscall(SYS_WRITE, 2, " edges, ", 8);
    PRNUM(ir_lase_n);
    syscall(SYS_WRITE, 2, " LASE", 5);
    if (ir_lase_bytes > 0) {
        syscall(SYS_WRITE, 2, " (", 2);
        PRNUM(ir_lase_bytes);
        syscall(SYS_WRITE, 2, "B applied)", 10);
    }
    if (ir_fold_n > 0) {
        syscall(SYS_WRITE, 2, ", ", 2);
        PRNUM(ir_fold_n);
        syscall(SYS_WRITE, 2, " folds (", 8);
        PRNUM(ir_fold_bytes);
        syscall(SYS_WRITE, 2, "B)", 2);
    }
    if (ir_dce_n > 0) {
        syscall(SYS_WRITE, 2, ", ", 2);
        PRNUM(ir_dce_n);
        syscall(SYS_WRITE, 2, " DCE", 4);
    }
    if (ir_dse_n > 0) {
        syscall(SYS_WRITE, 2, ", ", 2);
        PRNUM(ir_dse_n);
        syscall(SYS_WRITE, 2, " DSE", 4);
    }
    if (ir_fp_iter > 1) {
        syscall(SYS_WRITE, 2, " (", 2);
        PRNUM(ir_fp_iter);
        syscall(SYS_WRITE, 2, " fp iters)", 10);
    }
    if (ir_dbe_bytes > 0) {
        syscall(SYS_WRITE, 2, ", ", 2);
        PRNUM(ir_dbe_bytes);
        syscall(SYS_WRITE, 2, "B DBE", 5);
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    # CYRIUS_IR=2: verbose dump
    if (load8(_ir_env) == 50) { ir_dump(S); }
}

# Fixup + ELF + write
FIXUP(S);
if (_prof_on == 1) { _prof_fixup_end = _prof_clock_ns(); }
# v4.8.3-alpha1: capacity meter — opt-in via CYRIUS_STATS=1.
# Bote and other consumer projects hit silent capacity walls (fn
# table, identifier buffer); this exposes utilization at compile
# time so refactors can size themselves.
var _stats_env = _read_env("CYRIUS_STATS");
if (_stats_env != 0) {
    if (load8(_stats_env) == 49 && load8(_stats_env + 1) == 0) {
        syscall(SYS_WRITE, 2, "cyrius stats:\n", 14);
        syscall(SYS_WRITE, 2, "  fn_table:    ", 15); PRNUM(GFNC(S));
        syscall(SYS_WRITE, 2, " / 8192\n",        8);
        syscall(SYS_WRITE, 2, "  identifiers: ", 15); PRNUM(GNPOS(S));
        syscall(SYS_WRITE, 2, " / 262144\n",     10);
        syscall(SYS_WRITE, 2, "  var_table:   ", 15); PRNUM(GVCNT(S));
        syscall(SYS_WRITE, 2, " / 8192\n",        8);
        syscall(SYS_WRITE, 2, "  fixup_table: ", 15); PRNUM(GFCNT(S));
        syscall(SYS_WRITE, 2, " / 1048576\n",      11);
        syscall(SYS_WRITE, 2, "  string_data: ", 15); PRNUM(GSPOS(S));
        syscall(SYS_WRITE, 2, " / 2097152\n",    11);
        syscall(SYS_WRITE, 2, "  code_size:   ", 15); PRNUM(GCP(S));
        syscall(SYS_WRITE, 2, " / 1048576\n",    11);
    }
}
# v4.8.3-alpha2: soft 85% warnings on default builds. Catches
# "close-to-wall" conditions before a refactor trips the cap.
# Suppressed under CYRIUS_STATS=1 (already shown above) and under
# `--version` short-circuit (handled before this point).
if (_stats_env == 0) {
    if (GFNC(S) * 100 / _fnt_cap >= 85) {
        syscall(SYS_WRITE, 2, "warning: fn_table at ", 21);
        PRNUM(GFNC(S) * 100 / _fnt_cap);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GFNC(S));
        syscall(SYS_WRITE, 2, "/8192) — split into compilation units soon\n", 45);
    }
    if (GNPOS(S) * 100 / 262144 >= 85) {
        syscall(SYS_WRITE, 2, "warning: identifier buffer at ", 30);
        PRNUM(GNPOS(S) * 100 / 262144);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GNPOS(S));
        syscall(SYS_WRITE, 2, "/262144 bytes) — reduce includes or split soon\n", 49);
    }
    if (GVCNT(S) * 100 / 8192 >= 85) {
        syscall(SYS_WRITE, 2, "warning: var_table at ", 22);
        PRNUM(GVCNT(S) * 100 / 8192);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GVCNT(S));
        syscall(SYS_WRITE, 2, "/8192) — too many globals + locals\n", 37);
    }
    if (GFCNT(S) * 100 / 1048576 >= 85) {
        syscall(SYS_WRITE, 2, "warning: fixup_table at ", 24);
        PRNUM(GFCNT(S) * 100 / 1048576);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GFCNT(S));
        syscall(SYS_WRITE, 2, "/1048576) — too many cross-fn refs\n", 37);
    }
    if (GSPOS(S) * 100 / 2097152 >= 85) {
        syscall(SYS_WRITE, 2, "warning: string_data at ", 24);
        PRNUM(GSPOS(S) * 100 / 2097152);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GSPOS(S));
        syscall(SYS_WRITE, 2, "/2097152 bytes)\n", 16);
    }
    if (GCP(S) * 100 / _codebuf_cap >= 85) {
        syscall(SYS_WRITE, 2, "warning: code buffer at ", 24);
        PRNUM(GCP(S) * 100 / _codebuf_cap);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GCP(S));
        syscall(SYS_WRITE, 2, "/3145728 bytes)\n", 16);
    }
}
EMITELF(S);
if (_prof_on == 1) { _prof_emit_end = _prof_clock_ns(); }
# Write ELF output (loop on partial writes)
var olen = L64(S + 0x1903F8);
var written = 0;
var wgo = 1;
while (wgo == 1) {
    var w = syscall(SYS_WRITE, 1, S + 0x4D9D000 + written, olen - written);
    if (w <= 0) { wgo = 0; }
    else {
        written = written + w;
        if (written >= olen) { wgo = 0; }
    }
}
if (_prof_on == 1) { _prof_write_end = _prof_clock_ns(); }

# v5.6.5 O1: total compile time to stderr if CYRIUS_PROF=1.
# v5.10.0: per-phase breakdown via 7 captured timestamps
# (pp_end / lex_end / gvar_end / parse_end / fixup_end /
# emit_end / write_end). The breakdown reveals which phase
# is the optimization target for subsequent v5.10.x slots.
if (_prof_on == 1) {
    var _prof_t1 = _prof_clock_ns();
    var _prof_ms = (_prof_t1 - _prof_t0) / 1000000;
    syscall(SYS_WRITE, 2, "prof: compile ", 14);
    PRNUM(_prof_ms);
    syscall(SYS_WRITE, 2, " ms (pp=", 8);
    PRNUM((_prof_pp_end - _prof_t0) / 1000000);
    syscall(SYS_WRITE, 2, " lex=", 5);
    PRNUM((_prof_lex_end - _prof_pp_end) / 1000000);
    syscall(SYS_WRITE, 2, " gvar=", 6);
    PRNUM((_prof_gvar_end - _prof_lex_end) / 1000000);
    syscall(SYS_WRITE, 2, " parse=", 7);
    PRNUM((_prof_parse_end - _prof_gvar_end) / 1000000);
    syscall(SYS_WRITE, 2, " fixup=", 7);
    PRNUM((_prof_fixup_end - _prof_parse_end) / 1000000);
    syscall(SYS_WRITE, 2, " emit=", 6);
    PRNUM((_prof_emit_end - _prof_fixup_end) / 1000000);
    syscall(SYS_WRITE, 2, " write=", 7);
    PRNUM((_prof_write_end - _prof_emit_end) / 1000000);
    syscall(SYS_WRITE, 2, " ms)\n", 5);
}
syscall(SYS_EXIT, _had_error);
