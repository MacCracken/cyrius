# ================================================================
# Cyrius Compiler v2 — Modular Self-Hosting Compiler
# ================================================================
# Same language as cc.cyr, split into modules using include.
# Compiled by cc (cybs's extended language).
#
# Build: cat src/main_aarch64.cyr | ./build/cycc > /tmp/cycc_aarch64
# Cross-compile: produces aarch64 ELF from x86 host
# ================================================================
# HEAP MAP — Synced with main.cyr (v4.2)
# ================================================================
# Identical layout to x86. All offsets in parse.cyr/lex.cyr are shared.
# See main.cyr for authoritative heap map with detailed annotations.
#
#   0x00000  input_buf     [1048576]      1MB raw stdin input
#   0x60000  tok_names     [262144]      256KB packed identifier strings (v4.6.2; v5.11.18 doubled 128KB → 256KB)
#   0x18FCC8  str_pos       [8]           string write position (moved in v4.6.2)
#   0x18FCD0  data_size     [8]           total variable data bytes (moved in v4.6.2)
#   0x18E630  struct_names  [2048]        256 struct name offsets (cap 256, v5.7.17)
#   0x18EE30  struct_fcounts[2048]        256 struct field counts (relocated v5.7.17)
#   0x18F830  struct_count  [8]
#   0x18C100  BL,CP,VCNT,TCNT,TI,NPOS    compiler state
#   0x18DA00  fn_count, in_fn, local_cnt
#   0x18DA20  ret_patches   [2048]        256 return patch offsets (v5.10.6 — was [512]/64)
#   0x18E220  ret_patch_cnt [8]            (relocated from 0x18DC20 at v5.10.6)
#   0x18F900  defer_count   [8]           + defer_addrs [192]
#   0x190500  include_fname [256]
#   0x191000  fn_local_names
#   0x191800  local_depths  [512]
#   0x192000  macro tables
#   0x192200  local_types
#   0x198000  gvar_toks     [8192]
#   0x19A000  gvar_cnt      [8]
#   0x1A0000  jump_src + nop_run + fn_start_fcnt (v5.6.27)
#   0x1C0000  fn_names      [16384]       2048 functions
#   0x1C4000  fn_offsets    [16384]
#   0x1C8000  fn_params     [16384]
#   0x1CC000  fn_body_start [16384]
#   0x1D0000  fn_body_end   [16384]
#   0x1D4000  fn_inline     [16384]
#   0x1D8000  enum_const_val[8192]        1024 × 8 B enum-variant fold table (v5.5.2)
#   0x1DC000  fn_param_str_mask [16384]
#   0x11A000 var_noffs     [65536]       8192 variables
#   0x12A000 var_sizes     [65536]
#   0x13A000 var_types     [65536]
#   0x14A000 (free band — was str_data pre-v5.8.59; see main.cyr for full lineage)
#   0x21A000 str_data      [2097152]     2MB string literal bytes (v5.8.61 monotonic
#                                        position; see main.cyr for full lineage)
#   (2 MB freed gap retired v5.11.68 — was preprocess_out [2097152] pre-v5.11.32,
#                                        relocated to 0x459D000 at v5.11.33 +
#                                        cap raised 2 MB → 8 MB. The 2 MB hole was
#                                        absorbed by v5.11.68's full heap-map reorg.)
#   0x41A000 codebuf       [3145728]     3MB generated machine code (v5.7.27)
#   0x71A000 output_buf    [2097152]     2MB ELF output (v5.6.43; was 1MB pre-v5.6.43)
#   (tok arrays RETIRED here v5.8.46 — relocated to high block at 0x2D7C000;
#    pre-v5.8.46 the comments showed tok_types/values/lines at 0xB4A000/0xD4A000/0xF4A000
#    but the code actually overlapped tok_types with output_buf at 0x71A000)
#
# --- Relocated token arrays (v5.8.46, cap 262144 → 1048576 — sandhi consumer unblock) ---
#   0x2D7C000 tok_types     [8388608]     1048576 entries × 8 bytes
#   0x357C000 tok_values    [8388608]     1048576 entries × 8 bytes
#   0x3D7C000 tok_lines     [8388608]     1048576 entries × 8 bytes
#   0x91A000 struct_ftypes [65536]       256 structs × 32 fields (cap 256, v5.7.17)
#   0x92A000 struct_fnames [65536]       256 structs × 32 fields (cap 256, v5.7.17)
#   0x93A000 (legacy fixup-table slot — retired v5.5.37; 256 KB gap)
#   0xA3A000 (fn tables end here — IR region not used by aarch64 compiler)
#
# --- LEXID dedup index (v5.10.40) ---
#   0x457C000  lexid_count   [8]
#   0x457C100  lexid_heads   [2048]         per-length head idx+1
#   0x457C900  lexid_entries [131072]       16384 × 8B chain nodes
#   (Full doc in src/main.cyr §LEXID_DEDUP)
#
#   0x459D000 preprocess_out [8388608]   8 MB expanded source buffer.
#                                        Relocated here from 0x44A000 at v5.11.33
#                                        + cap raised 2 MB → 8 MB after sit
#                                        v0.7.6 hit 2,099,593 bytes (2,441 over
#                                        the 2 MB cap) on stock sandhi-folded
#                                        [deps].stdlib. See CHANGELOG [5.11.33].
#   0x4D9D000 brk                         ~77.6 MB total heap (post-v5.11.68 reorg — was ~86.6 MB pre-.68). v5.11.33 grew this
#                                        from 0x459D000 / 78.6 MB at v5.10.40
#                                        by the 8 MB preprocess_out relocation
#                                        above. Lineage: v5.10.40 grew brk from
#                                        0x457C000 / 78.5 MB at v5.8.61 by 132 KB
#                                        LEXID dedup index; v5.8.61 shrunk from
#                                        0x508C000 / 80.5 MB at v5.8.59-.60;
#                                        synced with main.cyr.


# ================================================================
# MODULES
# ================================================================
# HOST syscall numbers — x86_64 Linux (cross-compiler runs on x86)
# For native aarch64 self-hosting, use main_aarch64_native.cyr instead.
enum Sys { SYS_READ = 0; SYS_WRITE = 1; SYS_OPEN = 2; SYS_CLOSE = 3; SYS_BRK = 12; SYS_EXIT = 60; }

include "src/version_str.cyr"
include "src/common/util.cyr"
include "src/backend/aarch64/emit.cyr"
include "src/backend/aarch64/jump.cyr"
# v5.6.13: parse_*.cyr references `IR_RAW_EMIT` unconditionally
# (the v5.6.12 instrumentation markers), so aarch64 needs the
# IR opcode enum available too. ir.cyr's lowering fns dispatch
# to emit helpers (EADDR, ECMPR, …) which exist on both backends.
include "src/common/ir.cyr"
include "src/frontend/lex.cyr"
include "src/frontend/parse.cyr"
include "src/backend/macho/emit.cyr"
include "src/backend/aarch64/fixup.cyr"

# v6.0.6 — pull in lib/alloc + lib/vec for the v6.0.7 return-patch-buffer
# → vec conversion (proposal Option C). Mirrors src/main.cyr; the aarch64
# cross-compiler is x86-hosted so the same alloc.cyr Linux branch fires.
# See src/main.cyr's v6.0.6 include header for full rationale.
include "lib/alloc.cyr"
include "lib/vec.cyr"

# ================================================================
# MAIN
# ================================================================

# v5.11.63: --strict parity with main.cyr (which has had it since
# v5.4.19). When --strict appears anywhere in cmdline, set
# _strict_mode = 1; aarch64 fixup.cyr's undef-fn check exits with
# code 1 instead of just warning. The SYS_OPEN == 2 branch handles
# both x86_64 host (cross-compile path: openat is unavailable as
# SYS_OPEN; use direct open) and aarch64 host (native path: SYS_OPEN
# resolves to openat, needs AT_FDCWD = -100 as first arg). The same
# block lands verbatim in main_aarch64_macho.cyr +
# main_aarch64_native.cyr so all three variants link against the
# shared backend/aarch64/fixup.cyr that reads _strict_mode. See
# CHANGELOG [5.11.63].
var _strict_mode = 0;
var _vbuf[256];
var _vfd = 0;
if (SYS_OPEN == 2) { _vfd = syscall(SYS_OPEN, "/proc/self/cmdline", 0, 0); }
else { _vfd = syscall(SYS_OPEN, 0 - 100, "/proc/self/cmdline", 0, 0); }
var _vn = syscall(SYS_READ, _vfd, &_vbuf, 255);
syscall(SYS_CLOSE, _vfd);
if (_vn > 0) {
    var _vi = 0;
    # Skip argv[0]
    while (_vi < _vn) { if (load8(&_vbuf + _vi) == 0) { _vi = _vi + 1; break; } _vi = _vi + 1; }
    while (_vi < _vn) {
        # "--st" (--strict) — set flag, keep parsing
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 115 && load8(&_vbuf + _vi + 3) == 116) {
                    _strict_mode = 1;
                }
            }
        }
        # Skip to next arg (past next \0)
        while (_vi < _vn && load8(&_vbuf + _vi) != 0) { _vi = _vi + 1; }
        _vi = _vi + 1;
    }
}

# Allocate heap
# aarch64 syscall numbers (no translation layer — native numbers)
var S = syscall(SYS_BRK, 0);
# brk extends through tok_lines (~78.5 MB) — synced with main.cyr.
# aarch64 skips the TS frontend, so the ~13.5 MiB pad between
# fixup_tbl-end (0x298B000) and tok-block-start (0x2D7C000) is
# unused on this path; kept for offset parity with main.cyr.
syscall(SYS_BRK, S + 0x4D9D000);

# Zero scratch state (v5.8.63 extraction; see src/common/util.cyr for slot list)
_HEAP_INIT_SCRATCH(S);

# v6.0.6 — initialize the alloc/vec surface and pre-allocate the
# return-patch vec. Same shape as src/main.cyr; see there for full
# rationale.
alloc_init();
var rp_vec = vec_new();

# Read input (256KB, v3.4.19 — see src/main.cyr for rationale)
var bl = 0;
var done = 0;
while (done == 0) {
    var n = syscall(SYS_READ, 0, S + bl, 1048576 - bl);
    if (n <= 0) { done = 1; }
    else {
        bl = bl + n;
        if (bl >= 1048576) {
            var probe[1];
            var pn = syscall(SYS_READ, 0, &probe, 1);
            if (pn > 0) {
                syscall(SYS_WRITE, 2, "error: input exceeds 1MB buffer (raise input_buf in src/main.cyr)\n", 66);
                syscall(SYS_EXIT, 1);
            }
            done = 1;
        }
    }
}
SBL(S, bl);

# Preprocess includes
_init_cyrius_lib();
PP_PREDEFINE(S, "CYRIUS_ARCH_AARCH64");
# v5.5.16: check CYRIUS_MACHO_ARM early so `#ifdef CYRIUS_TARGET_MACOS`
# activates for stdlib per-OS dispatch (lib/alloc.cyr → alloc_macos.cyr,
# Linux-ism guards in lib/io.cyr etc.). Before v5.5.16 this branch
# unconditionally predefined CYRIUS_TARGET_LINUX even under
# CYRIUS_MACHO_ARM=1, so stdlib's brk-based Linux alloc path ran on
# Darwin — BSD syscall 12 is chdir, not brk, which silently corrupted
# the heap base (manifest as tool binaries exiting 0 with no output
# on ecb per v5.5.15). Mirrors the main.cyr Mach-O early-check added
# in the same minor.
var _macho_arm_env_early = _read_env("CYRIUS_MACHO_ARM");
var _is_macho_arm_build = 0;
if (_macho_arm_env_early != 0) {
    if (load8(_macho_arm_env_early) == 49 && load8(_macho_arm_env_early + 1) == 0) {
        _is_macho_arm_build = 1;
    }
}
if (_is_macho_arm_build == 1) {
    PP_PREDEFINE(S, "CYRIUS_TARGET_MACOS");
} else {
    PP_PREDEFINE(S, "CYRIUS_TARGET_LINUX");
}
# v5.10.39 — non-PE targets support f64v2/f64v4 value-form param
# ABI. See main.cyr for rationale.
PP_PREDEFINE(S, "CYRIUS_HAS_VAL_SIMD_PARAMS");
PREPROCESS(S);

# Lex
LEX(S);

# v5.5.17: Mach-O arm64 entry prologue — save argc/argv before the
# branch-over-fn-bodies. At LC_MAIN entry the Darwin ABI hands us
# argc in x0, argv in x1, envp in x2, apple[] in x3 (same as C main).
# Linux has them on the stack; Mach-O has them in registers that any
# subsequent gvar/enum-init emit will clobber. Push x0/x1 onto the
# stack and stash the pointer in x28 (callee-saved per AAPCS64, not
# used anywhere else by the cyrius aarch64 backend per a grep of
# src/backend/aarch64). `lib/args_macos.cyr` reads x28 via inline asm
# to expose argc()/argv(n) without any /proc/self/cmdline reach-around.
if (_is_macho_arm_build == 1) {
    EW(S, 0xA9BF07E0);  # stp x0, x1, [sp, #-16]!
    EW(S, 0x910003FC);  # mov x28, sp
}

# Emit initial branch over fn bodies (aarch64: B +0, patch later)
var jmp_patch = EJMP0(S);

# Pass 1: Pre-scan to register all global vars and structs (no fn bodies)
# Synced with main.cyr v2.1 — includes mod/pub/use/impl/union support
STI(S, 0);
var scan = 1;
while (scan == 1) {
    if (PEEKT(S) == 72) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); }
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    }
    else { if (PEEKT(S) == 73) {
            STI(S, GTI(S) + 1);
        }
        else { if (PEEKT(S) == 74) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) == 2) {
                    var umod = PEEKV(S);
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 41) {
                        STI(S, GTI(S) + 1);
                        if (PEEKT(S) == 2) {
                            var ufn = PEEKV(S);
                            STI(S, GTI(S) + 1);
                            var uc = GUSEC(S);
                            S64(S + 0x18FFD0 + uc * 8, ufn);
                            # v5.11.65 (CVE-05): pre-v5.11.65 this path had
                            # no tok_names bounds check at all (the parallel
                            # x86 main.cyr had a magic-256 NPOS_GUARD that
                            # this file never gained). Walk source lengths +
                            # call NPOS_GUARD for the actual write surface.
                            var _ulen1 = 0; while (load8(S + 0x60000 + umod + _ulen1) != 0) { _ulen1 = _ulen1 + 1; }
                            var _ulen2 = 0; while (load8(S + 0x60000 + ufn + _ulen2) != 0) { _ulen2 = _ulen2 + 1; }
                            NPOS_GUARD(S, _ulen1 + 1 + _ulen2 + 1);
                            var apos = GNPOS(S);
                            var ri = 0;
                            var rc = load8(S + 0x60000 + umod + ri);
                            while (rc != 0) { store8(S + 0x60000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0x60000 + umod + ri); }
                            store8(S + 0x60000 + apos, 95); apos = apos + 1;
                            ri = 0; rc = load8(S + 0x60000 + ufn + ri);
                            while (rc != 0) { store8(S + 0x60000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0x60000 + ufn + ri); }
                            store8(S + 0x60000 + apos, 0); apos = apos + 1;
                            var alias_noff = GNPOS(S);
                            SNPOS(S, apos);
                            S64(S + 0x1901D0 + uc * 8, alias_noff);
                            SUSEC(S, uc + 1);
                        }
                    }
                }
                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
            }
            else { if (PEEKT(S) == 40) { PARSE_STRUCT_DEF(S); }
                else { if (PEEKT(S) == 101) { PARSE_UNION_DEF(S); }
                    else { if (PEEKT(S) == 3) { PARSE_GVAR_REG(S); }
                        else { if (PEEKT(S) == 32) {
                                STI(S, GTI(S) + 1);
                                STI(S, GTI(S) + 1);
                                if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                                var dep = 0;
                                var fsk = 1;
                                while (fsk == 1) {
                                    var ft = PEEKT(S);
                                    if (ft == 13) { dep = dep + 1; }
                                    if (ft == 14) { dep = dep - 1; if (dep == 0) { fsk = 0; } }
                                    if (ft == 12) { fsk = 0; }
                                    STI(S, GTI(S) + 1);
                                }
                            }
                            else { if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 0); }
                                else { if (_TOK_IS_KERNEL(S) == 1) {
                                        S64(S + 0x18FCA0, 1);
                                        STI(S, GTI(S) + 1);
                                        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                    }
                                    else { if (PEEKT(S) == 78) {
                                            S64(S + 0x18FCA0, 2);
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                        }
                                        else { if (PEEKT(S) == 77) {
                                                STI(S, GTI(S) + 1);
                                                STI(S, GTI(S) + 1);
                                                STI(S, GTI(S) + 1);
                                                STI(S, GTI(S) + 1);
                                                if (PEEKT(S) == 13) {
                                                    STI(S, GTI(S) + 1);
                                                    var idep = 0;
                                                    var isk = 1;
                                                    while (isk == 1) {
                                                        var it = PEEKT(S);
                                                        if (it == 13) { idep = idep + 1; }
                                                        if (it == 14) { if (idep == 0) { isk = 0; } else { idep = idep - 1; } }
                                                        if (it == 12) { isk = 0; }
                                                        STI(S, GTI(S) + 1);
                                                    }
                                                }
                                            }
                                            else { scan = 0; } } } } } } } } } } }
}

# Reset module for pass 2
SMOD(S, 0);

# Mach-O output via CYRIUS_MACHO_ARM=1 (aarch64 cross-compiler path)
var _macho_arm_env = _read_env("CYRIUS_MACHO_ARM");
if (_macho_arm_env != 0) {
    if (load8(_macho_arm_env) == 49 && load8(_macho_arm_env + 1) == 0) {
        _TARGET_MACHO = 2;
    }
}

# Pass 2: Parse struct and fn definitions (vars already registered)
# Synced with main.cyr v2.1 — includes mod/pub/use/impl/union/enum-ctor support
STI(S, 0);
var topgo = 1;
while (topgo == 1) {
    if (PEEKT(S) == 72) { STI(S, GTI(S) + 1); if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
    else { if (PEEKT(S) == 73) { STI(S, GTI(S) + 1); }
        else { if (PEEKT(S) == 74) { while (PEEKT(S) != 5) { if (PEEKT(S) == 12) { break; } STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
            else { if (PEEKT(S) == 40) {
                    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                    if (PEEKT(S) != 13) { ERR(S); }
                    STI(S, GTI(S) + 1);
                    var ssk = 1;
                    while (ssk == 1) { if (PEEKT(S) == 14) { ssk = 0; } else { STI(S, GTI(S) + 1); } }
                    STI(S, GTI(S) + 1);
                }
                else { if (PEEKT(S) == 101) {
                        STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                        if (PEEKT(S) != 13) { ERR(S); }
                        STI(S, GTI(S) + 1);
                        var usk = 1;
                        while (usk == 1) { if (PEEKT(S) == 14) { usk = 0; } else { STI(S, GTI(S) + 1); } }
                        STI(S, GTI(S) + 1);
                    }
                    else { if (PEEKT(S) == 60) {
                            PARSE_ENUM_DEF(S, 2);
                        }
                        else { if (_TOK_IS_KERNEL(S) == 1) {
                                STI(S, GTI(S) + 1);
                                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                            }
                            else { if (PEEKT(S) == 32) {
                                    PARSE_FN_DEF(S);
                                }
                                else { if (PEEKT(S) == 3) {
                                        var vsk = 1;
                                        while (vsk == 1) { if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); vsk = 0; } else { STI(S, GTI(S) + 1); } }
                                    }
                                    else { if (PEEKT(S) == 77) { PARSE_IMPL(S); }
                                        else { if (PEEKT(S) == 78) { STI(S, GTI(S) + 1); if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
                                            else { topgo = 0; } } } } } } } } } } }
}

# Reset module
SMOD(S, 0);

# Patch jmp to land here (start of main code)
EPATCH(S, jmp_patch);

# Emit enum initializations FIRST (before gvar inits)
var gvar_save_ti = GTI(S);
STI(S, 0);
var escan = 1;
while (escan == 1) {
    if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 1); }
    else { if (PEEKT(S) == 12) { escan = 0; }
        else { STI(S, GTI(S) + 1); } }
}
# Emit deferred global var initializations
EMIT_GVAR_INITS(S);
STI(S, gvar_save_ti);

# Parse main code (top-level statements)
PARSE_PROG(S);
var _pp_dbg = _read_env("CYRIUS_DEBUG_PHASES");
if (_pp_dbg != 0) { if (load8(_pp_dbg) == 49) { syscall(SYS_WRITE, 2, "[phase] aarch64 PARSE_PROG done\n", 32); } }

# Exit epilogue — load last var
var lv = GLVAR(S);
if (lv >= 0) { EVLOAD(S, lv); }

# v5.9.37: auto-call `main()` if defined (cross-arch with x86 fix
# in src/main.cyr). Sources with only `fn main() { ... }` (no
# trailing `var ec = main(); syscall(60, ec);` wiring) ran the
# gvar inits + parse-prog and exited with rax=junk — main was
# never invoked. Surfaced from agnosys 1.1.12 verbatim repro.
# Walks fn table for "main\0" name match; emits ECALLTO if found.
# aarch64 backend doesn't DCE (no main_aarch64-side DCE logic) so
# no separate exemption needed.
var _epi_km_pre = L64(S + 0x18FCA0);
if (_epi_km_pre == 0) {
    var _main_fc = GFNC(S);
    var _main_fi = 0;
    var _main_found = 0 - 1;
    while (_main_fi < _main_fc) {
        var _main_noff = L64(S + 0x9BA000 + _main_fi * 8);
        if (load8(S + 0x60000 + _main_noff)     == 109) {
            if (load8(S + 0x60000 + _main_noff + 1) == 97) {
                if (load8(S + 0x60000 + _main_noff + 2) == 105) {
                    if (load8(S + 0x60000 + _main_noff + 3) == 110) {
                        if (load8(S + 0x60000 + _main_noff + 4) == 0) {
                            _main_found = _main_fi;
                            _main_fi = _main_fc;
                        }
                    }
                }
            }
        }
        _main_fi = _main_fi + 1;
    }
    if (_main_found >= 0) {
        var _main_off = L64(S + 0x9CA000 + _main_found * 8);
        if (_main_off >= 0) {
            ECALLTO(S, _main_off);
        }
    }
}

EEXIT(S);

# Fixup + ELF + write
FIXUP(S);
EMITELF(S);
# Write ELF output (loop on partial writes)
var olen = L64(S + 0x1903F8);
var written = 0;
var wgo = 1;
while (wgo == 1) {
    var w = syscall(SYS_WRITE, 1, S + 0x71A000 + written, olen - written);
    if (w <= 0) { wgo = 0; }
    else {
        written = written + w;
        if (written >= olen) { wgo = 0; }
    }
}
syscall(SYS_EXIT, 0);
