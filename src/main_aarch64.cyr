# ================================================================
# Cyrius Compiler v2 — Modular Self-Hosting Compiler
# ================================================================
# Same language as cc.cyr, split into modules using include.
# Compiled by cc (cybs's extended language).
#
# Build: cat src/main_aarch64.cyr | ./build/cycc > /tmp/cycc_aarch64
# Cross-compile: produces aarch64 ELF from x86 host
# ================================================================
# HEAP MAP — none here: src/main.cyr carries the ONE heap map, and this fork
# uses that layout (every `S + 0x…` offset lives in the shared modules).
# tests/gates/memory/heapmap.sh FAILS if a fork carries a map line: the
# copies that stood here had drifted from the live layout. CHANGELOG [6.6.20]
# The IR regions are x86-family only — this fork never enables CYRIUS_IR.
# ================================================================


# ================================================================
# MODULES
# ================================================================
# HOST syscall numbers — x86_64 Linux (cross-compiler runs on x86)
# For native aarch64 self-hosting, use main_aarch64_native.cyr instead.
enum Sys { SYS_READ = 0; SYS_WRITE = 1; SYS_OPEN = 2; SYS_CLOSE = 3; SYS_BRK = 12; SYS_EXIT = 60; }

include "src/version_str.cyr"
include "src/common/util.cyr"
# v6.0.8 — shared backend helpers (see src/main.cyr for full header).
include "src/backend/common/tokens.cyr"
include "src/backend/common/runtime.cyr"
include "src/backend/aarch64/emit.cyr"
include "src/backend/aarch64/jump.cyr"
# v5.6.13: parse_*.cyr references `IR_RAW_EMIT` unconditionally
# (the v5.6.12 instrumentation markers), so aarch64 needs the
# IR opcode enum available too. ir.cyr's lowering fns dispatch
# to emit helpers (EADDR, ECMPR, …) which exist on both backends.
include "src/common/ir.cyr"
include "src/frontend/lex.cyr"

# v6.0.6 — pull in lib/alloc + lib/vec for the v6.0.7 return-patch-buffer
# → vec conversion (proposal Option C). Mirrors src/main.cyr; the aarch64
# cross-compiler is x86-hosted so the same alloc.cyr Linux branch fires.
# v6.0.7 — reordered before parse.cyr so the converted vec_push / vec_get
# / vec_len / vec_truncate call sites in parse_expr / parse_fn can resolve
# at parse time. See src/main.cyr's v6.0.6 include header for full rationale.
include "lib/alloc.cyr"
include "lib/vec.cyr"

# v6.0.7 — return-patch vec storage (forward decl; real assignment below).
var rp_vec = 0;

include "src/frontend/parse.cyr"
include "src/backend/macho/emit.cyr"
include "src/backend/aarch64/fixup.cyr"

# ================================================================
# MAIN
# ================================================================

# v5.11.63: --strict parity with main.cyr (which has had it since
# v5.4.19). When --strict appears anywhere in cmdline, set
# _strict_mode = 1; aarch64 fixup.cyr's undef-fn check exits with
# code 1 instead of just warning. The SYS_OPEN == 2 branch handles
# both x86_64 host (cross-compile path: openat is unavailable as
# SYS_OPEN; use direct open) and aarch64 host (native path: SYS_OPEN
# resolves to openat, needs AT_FDCWD = -100 as first arg). The same
# block lands verbatim in main_aarch64_macho.cyr +
# main_aarch64_native.cyr so all three variants link against the
# shared backend/aarch64/fixup.cyr that reads _strict_mode. See
# CHANGELOG [5.11.63].
var _strict_mode = 0;
var _allow_undef = 0;   # v6.3.2: --allow-undef downgrades the now-default reachable-undef hard error (aarch64/fixup.cyr gates on `_allow_undef == 0`)
var _vbuf[256];
var _vfd = 0;
if (SYS_OPEN == 2) { _vfd = syscall(SYS_OPEN, "/proc/self/cmdline", 0, 0); }
else { _vfd = syscall(SYS_OPEN, 0 - 100, "/proc/self/cmdline", 0, 0); }
var _vn = syscall(SYS_READ, _vfd, &_vbuf, 255);
syscall(SYS_CLOSE, _vfd);
if (_vn > 0) {
    var _vi = 0;
    # Skip argv[0]
    while (_vi < _vn) { if (load8(&_vbuf + _vi) == 0) { _vi = _vi + 1; break; } _vi = _vi + 1; }
    while (_vi < _vn) {
        # "--ve" (--version) — print + exit. v6.6.6: this arm was MISSING on
        # every aarch64 driver and on main_cx.cyr, so `cycc --version` on an ARM
        # install fell straight through to "compile stdin" — with no file piped
        # in it compiled EMPTY input and wrote a 65,888-byte ELF to stdout, exit
        # 0. (scripts/install.sh reads `cycc --version | awk '{print $2}'`, so it
        # reported the binary's first field as the toolchain version.)
        # CHANGELOG [6.6.6]
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 118 && load8(&_vbuf + _vi + 3) == 101) {
                    _write_out_all(_VERSION_STR_CYCC_AARCH64, _VERSION_LEN_CYCC_AARCH64);
                    syscall(SYS_EXIT, 0);
                }
            }
        }
        # "--st" (--strict) — set flag, keep parsing
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 115 && load8(&_vbuf + _vi + 3) == 116) {
                    _strict_mode = 1;
                }
            }
        }
        # "--al" (--allow-undef, v6.3.2) — downgrade the default reachable-
        # undefined-fn hard error to a warning. chars a(97) l(108).
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 97 && load8(&_vbuf + _vi + 3) == 108) {
                    _allow_undef = 1;
                }
            }
        }
        # "--pie" (v6.1.8) — position-independent codegen (aarch64). chars
        # p(112) i(105) e(101). Reuses the proven Mach-O adrp/add PIC path for
        # ELF PIE. Also honored via CYRIUS_PIE=1 env (set below).
        if (_vi + 5 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 112 && load8(&_vbuf + _vi + 3) == 105 && load8(&_vbuf + _vi + 4) == 101) {
                    _pie_mode = 1;
                }
            }
        }
        # Skip to next arg (past next \0)
        while (_vi < _vn && load8(&_vbuf + _vi) != 0) { _vi = _vi + 1; }
        _vi = _vi + 1;
    }
}

# Allocate heap
# aarch64 syscall numbers (no translation layer — native numbers)
var S = syscall(SYS_BRK, 0);
# brk extends through tok_lines (~78.5 MB) — synced with main.cyr.
# aarch64 skips the TS frontend, so the ~13.5 MiB pad between
# fixup_tbl-end (0x298B000) and tok-block-start (0x8C00000) is
# unused on this path; kept for offset parity with main.cyr.
# v6.4.21: extended 0x5E1D000 → 0xF600000 so the relocated lexid_entries
# @ 0xF400000 (LEXID cap 16384→65536) is mapped; 0x5E1D000..0xF400000 is
# unused on aarch64 (no IR arena) but lazy-mapped, so no physical cost.
syscall(SYS_BRK, S + 0xF600000);

# Zero scratch state (v5.8.63 extraction; see src/common/util.cyr for slot list)
_HEAP_INIT_SCRATCH(S);

# v6.0.6 — initialize the alloc/vec surface. v6.0.7 — assign the
# pre-declared `rp_vec` global. Same shape as src/main.cyr.
alloc_init();
rp_vec = vec_new();
# Phase 0 (v6.2.0): growable fixup table — base = the existing 0x107B000 region,
# cap = the old hard cap; GFCNT grows it 2x via alloc() once full (util.cyr).
_fixup_base = S + 0x107B000;
_fixup_cap = 1048576;
# Phase 0 (v6.2.0): growable fn-tables — bases start AT the original fixed
# offsets, mask 8191, cap 8192 (byte-identical under the old cap; REGFN grows
# the family + rehashes when the count would exceed it). See util.cyr.
_fnt_cstrmask = S + 0x93A000;
_fnt_resmask = S + 0x94A000;
_fnt_optmask = S + 0x95A000;
_fnt_tagmask = S + 0x96A000;
_fnt_ovstr = S + 0x97A000;
_fnt_ovint = S + 0x98A000;
_fnt_ovcstr = S + 0x99A000;
_fnt_simdmask = S + 0x9AA000;
_fnt_names = S + 0x9BA000;
_fnt_offsets = S + 0x9CA000;
_fnt_params = S + 0x9DA000;
_fnt_bodystart = S + 0x9EA000;
_fnt_bodyend = S + 0x9FA000;
_fnt_inline = S + 0xA0A000;
_fnt_strmask = S + 0xA1A000;
_fnt_codeend = S + 0xA2A000;
_fnt_structmask = S + 0xA3A000;
_fnt_namehash = S + 0x110000;
_fnt_starthash = S + 0x114000;
_fnt_hash_mask = 4095;   # v6.5.40: hash slots are 4 B now, so the fixed 16 KB regions hold 4096
_fnt_cap = 2048;        # v6.5.51: HALF the fixed 4096-slot hash regions, so load stays <=50 % before the first grow (was 4096 = 100 % full)        # v6.5.40: was 8192 at 2 B/slot; _fnt_grow doubles from here
# Growable codebuf (Phase 0 v6.2.0; 8 MiB base + 8 MiB steps @ v6.4.49): base is
# an off-heap 8 MiB alloc (cap 8388608); EB grows +8 MiB off-heap when cp nears
# the cap, 64 MiB ceiling (util.cyr _codebuf_grow). Was a fixed 3 MiB in-heap
# region @ S+0x41A000 pre-.49. cx's own 0x54A000 codebuf is separate + fixed.
_codebuf_base = alloc(8388608);
_output_base = alloc(1073741824);
if (_output_base == 0) { syscall(SYS_WRITE, 2, "error: cannot allocate 1 GiB output buffer
", 43); syscall(SYS_EXIT, 1); }
_output_cap = 1073741824;   # v6.4.52: 1 GiB output buffer on ALL platforms (macOS/Windows large-alloc path landed; was Linux-only + 16 MiB fallback in .51)
_varn_base = S + 0x11A000;
_vars_base = S + 0x12A000;
_vart_base = S + 0x13A000;
_vgoff_base = S + 0x1B0000;
_vecv_base = S + 0x1D8000;
_vgsi_base = S + 0x1EC000;
_venid_base = S + 0x204000;
_var_cap = 8192;
_vsgn_base = alloc(1048576 * 8);   # v6.4.23 signed-global sign-ext: max-sized (var-grow cap) so it never grows → NO cybs-fragile grow-chain change; 8MB lazy-mapped
_codebuf_cap = 8388608;

# Read input (256KB, v3.4.19 — see src/main.cyr for rationale)
var bl = 0;
var done = 0;
while (done == 0) {
    var n = syscall(SYS_READ, 0, S + _SRCB + bl, _SRC_CAP - bl);
    if (n <= 0) { done = 1; }
    else {
        bl = bl + n;
        if (bl >= _SRC_CAP) {
            var probe[1];
            var pn = syscall(SYS_READ, 0, &probe, 1);
            if (pn > 0) {
                syscall(SYS_WRITE, 2, "error: input exceeds the 24MB source buffer
", 44);
                syscall(SYS_EXIT, 1);
            }
            done = 1;
        }
    }
}
SBL(S, bl);

# Preprocess includes
_init_cyrius_lib();
PP_PREDEFINE(S, "CYRIUS_ARCH_AARCH64");
var _poison_env_early = _read_env("CYRIUS_POISON");
# v6.5.29 — CYRIUS_POISON: opt-in allocator poison mode (redzones, poison fill,
# quarantine-on-free) so an out-of-bounds READ or a use-after-free is OBSERVABLE to
# `cyrius fuzz`. Filed by sit after a heap disclosure its fuzz suite ran past for three
# minor versions: the read landed in mapped memory, so there was no fault to catch.
# A COMPILE-TIME predefine, not a runtime env read — `lib/freelist.cyr` deliberately
# depends on mmap + atomic only, and an allocator should not be parsing the environment.
# Costs nothing when off. Set on all SEVEN forks, because a fuzz mode that exists only on
# x86-Linux tells three other platforms' consumers nothing.
if (_poison_env_early != 0) { PP_PREDEFINE(S, "CYRIUS_POISON"); }
# v5.5.16: check CYRIUS_MACHO_ARM early so `#ifdef CYRIUS_TARGET_MACOS`
# activates for stdlib per-OS dispatch (lib/alloc.cyr → alloc_macos.cyr,
# Linux-ism guards in lib/io.cyr etc.). Before v5.5.16 this branch
# unconditionally predefined CYRIUS_TARGET_LINUX even under
# CYRIUS_MACHO_ARM=1, so stdlib's brk-based Linux alloc path ran on
# Darwin — BSD syscall 12 is chdir, not brk, which silently corrupted
# the heap base (manifest as tool binaries exiting 0 with no output
# on ecb per v5.5.15). Mirrors the main.cyr Mach-O early-check added
# in the same minor.
var _macho_arm_env_early = _read_env("CYRIUS_MACHO_ARM");
var _is_macho_arm_build = 0;
if (_macho_arm_env_early != 0) {
    if (load8(_macho_arm_env_early) == 49 && load8(_macho_arm_env_early + 1) == 0) {
        _is_macho_arm_build = 1;
    }
}
# v6.1.8: CYRIUS_PIE=1 env mirrors the --pie cmdline flag (aarch64 ELF PIE).
var _pie_env_early = _read_env("CYRIUS_PIE");
if (_pie_env_early != 0) {
    if (load8(_pie_env_early) == 49 && load8(_pie_env_early + 1) == 0) {
        _pie_mode = 1;
    }
}
# v6.2.27: --target=aarch64-bare-metal-elf forces kernel_mode from the CLI
# (CYRIUS_KERNEL=1) — the aarch64 mirror of the main.cyr force-kmode. Injected
# before any pass/emit reads kernel_mode (read at the EMITELF site). State is
# BRK-zeroed (no explicit init), so default unset → kernel_mode 0 →
# cycc_aarch64 byte-identical. The `kernel;` dispatch only SETS it → composes.
var _kern_env_a = _read_env("CYRIUS_KERNEL");
if (_kern_env_a != 0) {
    if (load8(_kern_env_a) == 49 && load8(_kern_env_a + 1) == 0) {
        S64(S + 0x18FCA0, 1);
    }
}
# v6.3.3 #5: CYRIUS_KERNEL_BASE=0x<hex> -> kernel load base (cell 0x18FCE8). Mirrors
# the x86 fork; default unset -> _kernel_load_base() returns 0x40000000 byte-identical.
var _kbase_env_a = _read_env("CYRIUS_KERNEL_BASE");
if (_kbase_env_a != 0) {
    var _kb_a = _parse_hex_env(_kbase_env_a);
    if (_kb_a != 0) { S64(S + 0x18FCE8, _kb_a); }
}
if (_is_macho_arm_build == 1) {
    PP_PREDEFINE(S, "CYRIUS_TARGET_MACOS");
} else {
    PP_PREDEFINE(S, "CYRIUS_TARGET_LINUX");
}
# v5.10.39 — non-PE targets support f64v2/f64v4 value-form param
# ABI. See main.cyr for rationale.
PP_PREDEFINE(S, "CYRIUS_HAS_VAL_SIMD_PARAMS");
PREPROCESS(S);

# Build file map from #@file markers (for file:line error messages)
# v6.5.20: this call existed ONLY in main.cyr and main_win.cyr. The other five
# forks never built the map, so FM_LOOKUP's `cnt == 0` early-return printed the
# RAW EXPANDED-BUFFER line and dropped the `<source>:` prefix entirely — every
# diagnostic on ecb / ach / pi was wrong, and not by a constant: the skew grows
# with everything the preprocessor splices in (+1 bare, +4 with one include,
# +6 with two). Measured pre-existing, but 6.5.20 removed a compensating error
# that had been masking it on the derive path, so it must not ship unfixed.
FM_BUILD(S);

# Lex
LEX(S);

# v5.5.17: Mach-O arm64 entry prologue — save argc/argv before the
# branch-over-fn-bodies. At LC_MAIN entry the Darwin ABI hands us
# argc in x0, argv in x1, envp in x2, apple[] in x3 (same as C main).
# Linux has them on the stack; Mach-O has them in registers that any
# subsequent gvar/enum-init emit will clobber. Push x0/x1 onto the
# stack and stash the pointer in x28 (callee-saved per AAPCS64, not
# used anywhere else by the cyrius aarch64 backend per a grep of
# src/backend/aarch64). `lib/args_macos.cyr` reads x28 via inline asm
# to expose argc()/argv(n) without any /proc/self/cmdline reach-around.
if (_is_macho_arm_build == 1) {
    EW(S, 0xA9BF07E0);  # stp x0, x1, [sp, #-16]!
    EW(S, 0x910003FC);  # mov x28, sp
}

# Emit initial branch over fn bodies (aarch64: B +0, patch later)
var jmp_patch = EJMP0(S);

# v6.3.39 (aarch64 monomorph parity): read CYRIUS_MONOMORPH BEFORE pass-1. Pass-1
# registers structs including their generic type-param encoding (GSTP), which is only
# captured when _MONOMORPH_OK==1. Reading it AFTER pass-1 (the pre-v6.3.39 site, which
# stayed here after the v6.3.33 fix landed in main.cyr ONLY) left generic structs
# un-instantiated on aarch64 → `var h: Holder<Point>; h.v.x` parse-failed. Default (env
# unset) → _MONOMORPH_OK stays 0 → pass-1 SKIP_GENERICS unchanged → byte-identical.
var _mono_env = _read_env("CYRIUS_MONOMORPH");
if (_mono_env != 0) {
    if (load8(_mono_env) == 48 && load8(_mono_env + 1) == 0) {
        _MONOMORPH_OK = 0;
    }
}

# 6.6.17 — the TARGET flags are read BEFORE pass 1: `_prescan_params` records each fn's
# parameter shapes by `_TARGET_PE` (a Win64 vector parameter is passed by address), so with the
# flag set after pass 1 a forward call to a vector-param fn was marshalled SysV-style and the PE
# callee faulted. tests/tcyr/crossos/vector_param_forward_call.tcyr. CHANGELOG [6.6.17]
# Mach-O output via CYRIUS_MACHO_ARM=1 (aarch64 cross-compiler path)
var _macho_arm_env = _read_env("CYRIUS_MACHO_ARM");
if (_macho_arm_env != 0) {
    if (load8(_macho_arm_env) == 49 && load8(_macho_arm_env + 1) == 0) {
        _TARGET_MACHO = 2;
    }
}

# Pass 1: Pre-scan to register all global vars and structs (no fn bodies)
_tl_pass1(S, 0);   # 6.6.17: the ONE pass-1 scan, shared by every fork (src/frontend/parse_fn.cyr)


# v6.3.5 AR-01 — monomorphization opt-in is now read BEFORE pass-1 (see above,
# v6.3.39 aarch64 parity). This site retired.

# Pass 2: Parse struct and fn definitions (vars already registered)
_tl_pass2(S, 0);   # 6.6.17: the ONE pass-2 dispatch, shared by every fork

# Patch jmp to land here (start of main code)
EPATCH(S, jmp_patch);

# Emit enum initializations FIRST (before gvar inits)
var gvar_save_ti = GTI(S);
_tl_enum_inits(S);
# Emit deferred global var initializations
EMIT_GVAR_INITS(S);
STI(S, gvar_save_ti);

# 6.6.9: the pre-PARSE_PROG "undefined function" warning every other fork prints — this
# fork never called it, so an undefined call in code DCE judges unreachable was silent here
# and loud on x86. See _warn_undefined_prepass (parse_fn.cyr). CHANGELOG [6.6.9]
_warn_undefined_prepass(S);

# Parse main code (top-level statements)
PARSE_PROG(S);
var _pp_dbg = _read_env("CYRIUS_DEBUG_PHASES");
if (_pp_dbg != 0) { if (load8(_pp_dbg) == 49) { syscall(SYS_WRITE, 2, "[phase] aarch64 PARSE_PROG done\n", 32); } }

# Exit epilogue — load last var
var lv = GLVAR(S);
if (lv >= 0) { EVLOAD(S, lv); }

# v5.9.37: auto-call `main()` if defined (cross-arch with x86 fix
# in src/main.cyr). Sources with only `fn main() { ... }` (no
# trailing `var ec = main(); syscall(60, ec);` wiring) ran the
# gvar inits + parse-prog and exited with rax=junk — main was
# never invoked. Surfaced from agnosys 1.1.12 verbatim repro.
# Walks fn table for "main\0" name match; emits ECALLTO if found.
# aarch64 backend doesn't DCE (no main_aarch64-side DCE logic) so
# no separate exemption needed.
var _epi_km_pre = L64(S + 0x18FCA0);
if (_epi_km_pre == 0) {
    var _main_fc = GFNC(S);
    var _main_fi = 0;
    var _main_found = 0 - 1;
    while (_main_fi < _main_fc) {
        var _main_noff = L64(_fnt_names + _main_fi * 8);
        if (load8(S + 0xEC00000 + _main_noff)     == 109) {
            if (load8(S + 0xEC00000 + _main_noff + 1) == 97) {
                if (load8(S + 0xEC00000 + _main_noff + 2) == 105) {
                    if (load8(S + 0xEC00000 + _main_noff + 3) == 110) {
                        if (load8(S + 0xEC00000 + _main_noff + 4) == 0) {
                            _main_found = _main_fi;
                            _main_fi = _main_fc;
                        }
                    }
                }
            }
        }
        _main_fi = _main_fi + 1;
    }
    if (_main_found >= 0) {
        var _main_off = L64(_fnt_offsets + _main_found * 8);
        if (_main_off >= 0) {
            ECALLTO(S, _main_off);
        }
    }
}

EEXIT(S);
# 6.6.18: the shared ESYSXLAT stubs for variable syscall numbers, after all code (emit.cyr).
ESYSX_STUBS(S);

# Fixup + ELF + write
FIXUP(S);
# v6.4.50: soft capacity warnings, shared across all 7 drivers (util.cyr).
_capacity_warnings(S, 67108864, 1);
EMITELF(S);
# Write ELF output (loop on partial writes)
# v6.6.6 — the loop that used to sit here stopped on the first failing `write` and
# then exited 0 with a TRUNCATED image. _write_out_all (src/common/util.cyr) is the
# same loop plus the comparison it was missing, shared by every fork so the check
# cannot be present in one and absent in the rest. CHANGELOG [6.6.6]
var olen = L64(S + 0x1903F8);
_write_out_all(_output_base, olen);
syscall(SYS_EXIT, _had_error);   # v6.4.62: DX multi-error — exit 1 when errors were reported
