# ================================================================
# Cyrius Compiler v2 — Modular Self-Hosting Compiler
# ================================================================
# Same language as cc.cyr, split into modules using include.
# Compiled by cc (cybs's extended language).
#
# Build: cat src/main_aarch64.cyr | cycc > cc5_cross && cat src/main_aarch64_native.cyr | cc5_cross > cc5_native
# Native aarch64 compiler — runs on ARM hardware with native syscall numbers
# ================================================================
# HEAP MAP — none here: src/main.cyr carries the ONE heap map, and this fork
# uses that layout (every `S + 0x…` offset lives in the shared modules).
# tests/gates/memory/heapmap.sh FAILS if a fork carries a map line: the
# copies that stood here had drifted from the live layout. CHANGELOG [6.6.20]
# The IR regions are x86-family only — this fork never enables CYRIUS_IR.
# ================================================================


# ================================================================
# MODULES
# ================================================================
# HOST syscall numbers — aarch64 Linux (native compiler runs on ARM)
# SYS_OPEN is openat(56) — requires dirfd as first arg (AT_FDCWD = -100).
# lex.cyr already handles this via `if (SYS_OPEN == 2)` branching.
enum Sys { SYS_READ = 63; SYS_WRITE = 64; SYS_OPEN = 56; SYS_CLOSE = 57; SYS_BRK = 214; SYS_EXIT = 93; }

include "src/version_str.cyr"
include "src/common/util.cyr"
# v6.0.8 — shared backend helpers (see src/main.cyr).
include "src/backend/common/tokens.cyr"
include "src/backend/common/runtime.cyr"
include "src/backend/aarch64/emit.cyr"
include "src/backend/aarch64/jump.cyr"
# v5.6.32: parse_*.cyr references `IR_RAW_EMIT` unconditionally
# since the v5.6.12 O3a instrumentation markers landed, so aarch64
# native needs the IR opcode enum available too. main_aarch64.cyr
# (cross-compiler) already includes this at the same spot; the
# native variant was overlooked when ir.cyr was added — hence the
# pre-v5.6.32 self-host parse failure on the Pi.
include "src/common/ir.cyr"
include "src/frontend/lex.cyr"

# v6.0.7 — alloc + vec for return-patch vec storage. Native aarch64
# runs on the Pi; alloc.cyr's CYRIUS_TARGET_LINUX branch fires (same
# as the cross variant) and uses native aarch64 brk syscall numbers.
include "lib/alloc.cyr"
include "lib/vec.cyr"
var rp_vec = 0;

include "src/frontend/parse.cyr"
include "src/backend/aarch64/fixup.cyr"

# v6.2.44: the native aarch64-Linux fork omits macho/emit.cyr (Mach-O is
# not a native-Linux output), but the shared aarch64/fixup.cyr keeps a
# runtime `if (_emit_fmt==2) EMITMACHO_ARM64()` dispatch branch — dead
# here (emit_fmt is never 2 on native-Linux). The cross + macho forks
# define the real fn via their macho include; this native-only stub
# resolves the symbol (silences the cross-build "undefined function"
# warning; a reachable one is FATAL by default since v6.3.2) without pulling
# in the Mach-O emitter.
# Same dead-branch justification as aarch64/emit.cyr's _PE stub cohort.
# See CHANGELOG [6.2.44].
fn EMITMACHO_ARM64(S): i64 { return 0; }

# ================================================================
# MAIN
# ================================================================

# Command-line flags from /proc/self/cmdline — the same block as the Linux
# aarch64 cross-compiler (main_aarch64.cyr); the native path resolves SYS_OPEN
# to openat(56) so the AT_FDCWD = -100 branch fires. `--strict` is ACCEPTED and
# does nothing (see src/main.cyr). CHANGELOG [6.6.20]
var _allow_undef = 0;   # v6.3.2: --allow-undef downgrades the now-default reachable-undef hard error (aarch64/fixup.cyr gates on `_allow_undef == 0`)
var _vbuf[256];
var _vfd = 0;
if (SYS_OPEN == 2) { _vfd = syscall(SYS_OPEN, "/proc/self/cmdline", 0, 0); }
else { _vfd = syscall(SYS_OPEN, 0 - 100, "/proc/self/cmdline", 0, 0); }
var _vn = syscall(SYS_READ, _vfd, &_vbuf, 255);
syscall(SYS_CLOSE, _vfd);
if (_vn > 0) {
    var _vi = 0;
    while (_vi < _vn) { if (load8(&_vbuf + _vi) == 0) { _vi = _vi + 1; break; } _vi = _vi + 1; }
    while (_vi < _vn) {
        # "--ve" (--version) — print + exit. v6.6.6: MISSING here, which is the
        # shipped ARM-Linux compiler (`cyrius pulsar` installs this fork as
        # `cycc`), so on a Raspberry Pi / aarch64 box `cycc --version` compiled
        # EMPTY stdin and wrote an ELF to stdout with exit 0 instead of printing
        # a version. CHANGELOG [6.6.6]
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 118 && load8(&_vbuf + _vi + 3) == 101) {
                    _write_out_all(_VERSION_STR_CYCC_AARCH64, _VERSION_LEN_CYCC_AARCH64);
                    syscall(SYS_EXIT, 0);
                }
            }
        }
        # "--sy" (--syntax-only) — the same flag as main.cyr's (see _syntax_only, util.cyr):
        # `cyrius lint`'s pre-pass passes it, and without this arm a file whose only fault
        # was a name defined in another file was refused as unparseable on this host.
        # chars s(115) y(121). CHANGELOG [6.6.20]
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 115 && load8(&_vbuf + _vi + 3) == 121) {
                    _syntax_only = 1;
                }
            }
        }
        # "--al" (--allow-undef, v6.3.2) — downgrade the default reachable-undef hard error to a warning. chars a(97) l(108).
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 97 && load8(&_vbuf + _vi + 3) == 108) {
                    _allow_undef = 1;
                }
            }
        }
        # "--pie" — position-independent codegen, as in main_aarch64.cyr (also CYRIUS_PIE=1,
        # read below). This fork had neither, so `cyrius build --pie` on an ARM host wrote a
        # fixed-address ET_EXEC and exited 0. chars p(112) i(105) e(101). CHANGELOG [6.6.20]
        if (_vi + 5 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 112 && load8(&_vbuf + _vi + 3) == 105 && load8(&_vbuf + _vi + 4) == 101) {
                    _pie_mode = 1;
                }
            }
        }
        while (_vi < _vn && load8(&_vbuf + _vi) != 0) { _vi = _vi + 1; }
        _vi = _vi + 1;
    }
}

# Allocate heap
# aarch64 syscall numbers (no translation layer — native numbers)
var S = syscall(SYS_BRK, 0);
# The arena runs to the brk-final line of src/main.cyr's heap map (0xF600000,
# 246 MiB, where lexid_entries ends) — the one layout every driver shares.
# 6.6.20: the extension is CHECKED. An rlimit (ulimit -v / -d) that refuses it left the arena
# unmapped and cycc died on its first heap store with SIGSEGV 139 and no message; the Mach-O
# paths already refused by name. CHANGELOG [6.6.20]
var _arena_top = syscall(SYS_BRK, S + 0xF600000);
if (_arena_top < S + 0xF600000) {
    syscall(SYS_WRITE, 2, "error: cannot map the 246 MiB compiler arena (brk refused it; check ulimit -v / ulimit -d)\n", 91);
    syscall(SYS_EXIT, 1);
}

# Zero scratch state (v5.8.63 extraction; see src/common/util.cyr for slot list)
_HEAP_INIT_SCRATCH(S);

# v6.0.7 — init alloc and assign rp_vec (return-patch storage).
alloc_init();
rp_vec = vec_new();
# The region bases + caps, shared by six drivers. CHANGELOG [6.6.20]
include "src/common/heap_regions.cyr"

# Read input (256KB, v3.4.19 — see src/main.cyr for rationale)
var bl = 0;
var done = 0;
while (done == 0) {
    var n = syscall(SYS_READ, 0, S + _SRCB + bl, _SRC_CAP - bl);
    if (n <= 0) { done = 1; }
    else {
        bl = bl + n;
        if (bl >= _SRC_CAP) {
            var probe[1];
            var pn = syscall(SYS_READ, 0, &probe, 1);
            if (pn > 0) {
                syscall(SYS_WRITE, 2, "error: input exceeds the 24MB source buffer
", 44);
                syscall(SYS_EXIT, 1);
            }
            done = 1;
        }
    }
}
SBL(S, bl);

# Preprocess includes
_init_cyrius_lib();
PP_PREDEFINE(S, "CYRIUS_ARCH_AARCH64");
var _poison_env_early = _read_env("CYRIUS_POISON");
# v6.5.29 — CYRIUS_POISON: opt-in allocator poison mode (redzones, poison fill,
# quarantine-on-free) so an out-of-bounds READ or a use-after-free is OBSERVABLE to
# `cyrius fuzz`. Filed by sit after a heap disclosure its fuzz suite ran past for three
# minor versions: the read landed in mapped memory, so there was no fault to catch.
# A COMPILE-TIME predefine, not a runtime env read — `lib/freelist.cyr` deliberately
# depends on mmap + atomic only, and an allocator should not be parsing the environment.
# Costs nothing when off. Set on all SEVEN forks, because a fuzz mode that exists only on
# x86-Linux tells three other platforms' consumers nothing.
if (_poison_env_early != 0) { PP_PREDEFINE(S, "CYRIUS_POISON"); }
# CYRIUS_MACHO_ARM=1 is REFUSED by name here. This fork has no Mach-O emitter (it omits
# backend/macho/emit.cyr; EMITMACHO_ARM64 above is a stub), so it used to predefine
# CYRIUS_TARGET_MACOS, compile the whole program, and write ZERO bytes with exit 0. Mach-O
# arm64 comes from the cross (cycc_aarch64) or from cycc on macOS. CHANGELOG [6.6.20]
var _macho_arm_env_early = _read_env("CYRIUS_MACHO_ARM");
if (_macho_arm_env_early != 0) {
    if (load8(_macho_arm_env_early) == 49 && load8(_macho_arm_env_early + 1) == 0) {
        syscall(SYS_WRITE, 2, "error: CYRIUS_MACHO_ARM=1: this native aarch64-Linux cycc has no Mach-O emitter (use cycc_aarch64, or cycc on macOS)\n", 117);
        syscall(SYS_EXIT, 1);
    }
}
# CYRIUS_PIE=1 mirrors the --pie flag above, as in main_aarch64.cyr. Read before any
# codegen: the aarch64 emitter picks adrp/add over absolute addresses on _pie_mode.
var _pie_env_early = _read_env("CYRIUS_PIE");
if (_pie_env_early != 0) {
    if (load8(_pie_env_early) == 49 && load8(_pie_env_early + 1) == 0) {
        _pie_mode = 1;
    }
}
# CYRIUS_KERNEL=1 (what `cyrius build --target=aarch64-bare-metal-elf` injects) forces
# kernel_mode and CYRIUS_KERNEL_BASE=0x<hex> sets its load base, as in main_aarch64.cyr.
# This fork read neither, so asked for a kernel image it wrote a USERLAND ELF, rc 0.
# CHANGELOG [6.6.20]
var _kern_env_n = _read_env("CYRIUS_KERNEL");
if (_kern_env_n != 0) {
    if (load8(_kern_env_n) == 49 && load8(_kern_env_n + 1) == 0) {
        S64(S + 0x18FCA0, 1);
    }
}
var _kbase_env_n = _read_env("CYRIUS_KERNEL_BASE");
if (_kbase_env_n != 0) {
    var _kb_n = _parse_hex_env(_kbase_env_n);
    if (_kb_n != 0) { S64(S + 0x18FCE8, _kb_n); }
}
PP_PREDEFINE(S, "CYRIUS_TARGET_LINUX");
# v5.10.39 — non-PE targets support f64v2/f64v4 value-form param ABI.
PP_PREDEFINE(S, "CYRIUS_HAS_VAL_SIMD_PARAMS");
PREPROCESS(S);

# Build file map from #@file markers (for file:line error messages)
# v6.5.20: this call existed ONLY in main.cyr and main_win.cyr. The other five
# forks never built the map, so FM_LOOKUP's `cnt == 0` early-return printed the
# RAW EXPANDED-BUFFER line and dropped the `<source>:` prefix entirely — every
# diagnostic on ecb / ach / pi was wrong, and not by a constant: the skew grows
# with everything the preprocessor splices in (+1 bare, +4 with one include,
# +6 with two). Measured pre-existing, but 6.5.20 removed a compensating error
# that had been masking it on the derive path, so it must not ship unfixed.
FM_BUILD(S);

# Lex
LEX(S);

# Emit initial branch over fn bodies (aarch64: B +0, patch later)
var jmp_patch = EJMP0(S);

# Pass 1: Pre-scan to register all global vars and structs (no fn bodies)
_tl_pass1(S, 0);   # 6.6.17: the ONE pass-1 scan, shared by every fork (src/frontend/parse_fn.cyr)

# v6.3.5 AR-01 — opt-in monomorphization substrate (CYRIUS_MONOMORPH=1; default off; see util.cyr).
var _mono_env = _read_env("CYRIUS_MONOMORPH");
if (_mono_env != 0) {
    if (load8(_mono_env) == 48 && load8(_mono_env + 1) == 0) {
        _MONOMORPH_OK = 0;
    }
}

# Pass 2: Parse struct and fn definitions (vars already registered)
_tl_pass2(S, 0);   # 6.6.17: the ONE pass-2 dispatch, shared by every fork

# Patch jmp to land here (start of main code)
EPATCH(S, jmp_patch);

# Emit enum initializations FIRST (before gvar inits)
var gvar_save_ti = GTI(S);
_tl_enum_inits(S);
# Emit deferred global var initializations
EMIT_GVAR_INITS(S);
STI(S, gvar_save_ti);

# 6.6.9: the pre-PARSE_PROG "undefined function" warning every other fork prints — this
# fork never called it, so an undefined call in code DCE judges unreachable was silent here
# and loud on x86. See _warn_undefined_prepass (parse_fn.cyr). CHANGELOG [6.6.9]
_warn_undefined_prepass(S);
# Parse main code (top-level statements)
PARSE_PROG(S);

# Exit epilogue — load last var
var lv = GLVAR(S);
if (lv >= 0) { EVLOAD(S, lv); }

# v6.0.68: auto-call `main()` if defined — port of main_aarch64.cyr's
# v5.9.37 fix that this NATIVE aarch64-Linux fork never received (same
# rot class as the Mach-O fork at v6.0.37 and main_win at v6.0.54).
# Without it a source whose only entry is `fn main() { ... }` (no
# trailing `var ec = main(); syscall(60, ec);`) never invoked main and
# exited with junk in x0 — so EVERY `cyrius build` on aarch64-Linux that
# used the bare-`main` convention silently produced a binary exiting 0.
# Latent the whole life of build/cycc-native-aarch64 (v6.0.7+) because
# the aarch64-native funcgate was soft, masked behind §D1's deps failure;
# surfaced the instant §D1 was fixed and the funcgate reached the run step
# (fib exited 0, not 42). The compiler itself sys_exits explicitly, so it
# self-hosts byte-identical either way. Walks the fn table for "main\0"
# and emits ECALLTO if found.
var _epi_km_pre = L64(S + 0x18FCA0);
if (_epi_km_pre == 0) {
    # The first fn named exactly "main" (src/common/util.cyr), as main.cyr and main_win.cyr
    # look it up. CHANGELOG [6.6.20]
    var _main_found = _find_fn_by_name(S, "main", 4);
    if (_main_found >= 0) {
        var _main_off = L64(_fnt_offsets + _main_found * 8);
        if (_main_off >= 0) {
            ECALLTO(S, _main_off);
        }
    }
}

EEXIT(S);
# 6.6.18: the shared ESYSXLAT stubs for variable syscall numbers, after all code (emit.cyr).
ESYSX_STUBS(S);

# Fixup + ELF + write
FIXUP(S);
# v6.4.50: soft capacity warnings, shared across all 7 drivers (util.cyr).
_capacity_warnings(S, 67108864, 1);
EMITELF(S);
# Write ELF output (loop on partial writes)
# v6.6.6 — the loop that used to sit here stopped on the first failing `write` and
# then exited 0 with a TRUNCATED image. _write_out_all (src/common/util.cyr) is the
# same loop plus the comparison it was missing, shared by every fork so the check
# cannot be present in one and absent in the rest. CHANGELOG [6.6.6]
var olen = L64(S + 0x1903F8);
_write_out_all(_output_base, olen);
syscall(SYS_EXIT, _had_error);   # v6.4.62: DX multi-error — exit 1 when errors were reported
