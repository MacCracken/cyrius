# ================================================================
# Cyrius Compiler v2 — Modular Self-Hosting Compiler
# ================================================================
# Same language as cc.cyr, split into modules using include.
# Compiled by cc (cybs's extended language).
#
# Build: cat src/main_aarch64.cyr | cycc > cc5_cross && cat src/main_aarch64_native.cyr | cc5_cross > cc5_native
# Native aarch64 compiler — runs on ARM hardware with native syscall numbers
# ================================================================
# HEAP MAP — Synced with main.cyr (v5.0.3)
# ================================================================
# Identical layout to x86. All offsets in parse.cyr/lex.cyr are shared.
# See main.cyr for authoritative heap map with detailed annotations.
#
#   0x00000  input_buf     [1048576]      1MB raw stdin input
#   0x60000  tok_names     [262144]      256KB packed identifier strings (v4.6.2; v5.11.18 doubled 128KB → 256KB)
#   0x18FCC8  str_pos       [8]           string write position (moved in v4.6.2)
#   0x18FCD0  data_size     [8]           total variable data bytes (moved in v4.6.2)
#   0x18E630  struct_names  [2048]        256 struct name offsets (cap 256, v5.7.17)
#   0x18EE30  struct_fcounts[2048]        256 struct field counts (relocated v5.7.17)
#   0x18F830  struct_count  [8]
#   0x18C100  BL,CP,VCNT,TCNT,TI,NPOS    compiler state
#   0x18DA00  fn_count, in_fn, local_cnt
#   0x18DA20  (FREED v6.0.88)             was ret_patches [2048] — migrated to rp_vec @ v6.0.7
#   0x18E220  (FREED v6.0.88)             was ret_patch_cnt [8]
#   0x18F900  defer_count   [8]           + defer_addrs [192]
#   0x190500  include_fname [256]
#   0x191000  fn_local_names
#   0x191800  local_depths  [512]
#   0x192000  macro tables
#   0x192200  local_types
#   0x198000  gvar_toks     [8192]
#   0x19A000  gvar_cnt      [8]
#   0x1A0000  jump_src + nop_run + fn_start_fcnt (v5.6.27)
#   0x1C0000  fn_names      [16384]       2048 functions
#   0x1C4000  fn_offsets    [16384]
#   0x1C8000  fn_params     [16384]
#   0x1CC000  fn_body_start [16384]
#   0x1D0000  fn_body_end   [16384]
#   0x1D4000  fn_inline     [16384]
#   0x1DC000  fn_param_str_mask [16384]
#   0x11A000 var_noffs     [65536]       8192 variables
#   0x12A000 var_sizes     [65536]
#   0x13A000 var_types     [65536]
#   0x14A000 (free band — was str_data pre-v5.8.59; see main.cyr for full lineage)
#   0x21A000 str_data      [2097152]     2MB string literal bytes (v5.8.61 monotonic — see main.cyr)
#   (2 MB freed gap retired v5.11.68 — was preprocess_out [2097152] pre-v5.11.32,
#                                        relocated to 0x459D000 at v5.11.33 +
#                                        cap raised 2 MB → 8 MB. The 2 MB hole was
#                                        absorbed by v5.11.68's full heap-map reorg.)
#   0x41A000 codebuf       [3145728]     3MB generated machine code (v5.7.27)
#   0x4D9D000 output_buf    [16777216]   16MB ELF output — RELOCATED to heap-top from 0x71A000 (2MB→16MB) @ v6.1.27 phylax binary-cap
#   (tok arrays RETIRED here v5.8.46 — see main.cyr for canonical layout;
#    relocated to 0x2D7C000 / 0x357C000 / 0x3D7C000 with cap 1048576)
#   0x91A000 struct_ftypes [16384]       64 structs × 32 fields
#   0x92A000 struct_fnames [16384]
#   0x93A000 (legacy fixup-table slot — retired v5.5.37; 256 KB gap)
#   0xA3A000 (fn tables end here — IR region not used by aarch64 compiler)
#
# --- LEXID dedup index (v5.10.40) ---
#   0x457C000  lexid_count   [8]
#   0x457C100  lexid_heads   [2048]
#   0x457C900  lexid_entries [131072]
#   (Full doc in src/main.cyr §LEXID_DEDUP)
#
#   0x459D000 preprocess_out [8388608]   8 MB expanded source buffer.
#                                        Relocated here from 0x44A000 at v5.11.33
#                                        + cap raised 2 MB → 8 MB. See
#                                        CHANGELOG [5.11.33].
#   0x5D9D000 local tables (CVE-24 v6.1.40) 4×128 KB per-fn slot-indexed tables (fn_local_names/
#                                        depths/types/slice; relocated from 0x191000) → top 0x5E1D000
#   0x5E1D000 brk                         ~94.1 MB total heap (+512 KB local-table reloc @ v6.1.40; +16MB output_buf @ v6.1.27) (post-v5.11.68 reorg — was ~86.6 MB pre-.68). v5.11.33 grew this
#                                        from 0x459D000 / 78.6 MB at v5.10.40 by
#                                        the 8 MB preprocess_out relocation;
#                                        v5.10.40 grew from 0x457C000 / 78.5 MB
#                                        at v5.8.61 by 132 KB LEXID dedup; was
#                                        0x508C000 / 80.5 MB at v5.8.59-.60;
#                                        synced with main.cyr.


# ================================================================
# MODULES
# ================================================================
# HOST syscall numbers — aarch64 Linux (native compiler runs on ARM)
# SYS_OPEN is openat(56) — requires dirfd as first arg (AT_FDCWD = -100).
# lex.cyr already handles this via `if (SYS_OPEN == 2)` branching.
enum Sys { SYS_READ = 63; SYS_WRITE = 64; SYS_OPEN = 56; SYS_CLOSE = 57; SYS_BRK = 214; SYS_EXIT = 93; }

include "src/version_str.cyr"
include "src/common/util.cyr"
# v6.0.8 — shared backend helpers (see src/main.cyr).
include "src/backend/common/tokens.cyr"
include "src/backend/common/runtime.cyr"
include "src/backend/aarch64/emit.cyr"
include "src/backend/aarch64/jump.cyr"
# v5.6.32: parse_*.cyr references `IR_RAW_EMIT` unconditionally
# since the v5.6.12 O3a instrumentation markers landed, so aarch64
# native needs the IR opcode enum available too. main_aarch64.cyr
# (cross-compiler) already includes this at the same spot; the
# native variant was overlooked when ir.cyr was added — hence the
# pre-v5.6.32 self-host parse failure on the Pi.
include "src/common/ir.cyr"
include "src/frontend/lex.cyr"

# v6.0.7 — alloc + vec for return-patch vec storage. Native aarch64
# runs on the Pi; alloc.cyr's CYRIUS_TARGET_LINUX branch fires (same
# as the cross variant) and uses native aarch64 brk syscall numbers.
include "lib/alloc.cyr"
include "lib/vec.cyr"
var rp_vec = 0;

include "src/frontend/parse.cyr"
include "src/backend/aarch64/fixup.cyr"

# v6.2.44: the native aarch64-Linux fork omits macho/emit.cyr (Mach-O is
# not a native-Linux output), but the shared aarch64/fixup.cyr keeps a
# runtime `if (_emit_fmt==2) EMITMACHO_ARM64()` dispatch branch — dead
# here (emit_fmt is never 2 on native-Linux). The cross + macho forks
# define the real fn via their macho include; this native-only stub
# resolves the symbol (silences the cross-build "undefined function"
# warning; FATAL under --strict) without pulling in the Mach-O emitter.
# Same dead-branch justification as aarch64/emit.cyr's _PE stub cohort.
# See CHANGELOG [6.2.44].
fn EMITMACHO_ARM64(S): i64 { return 0; }

# ================================================================
# MAIN
# ================================================================

# v5.11.63: --strict parity with main.cyr. Same block as the Linux
# aarch64 cross-compiler (main_aarch64.cyr); native path resolves
# SYS_OPEN to openat(56) so the AT_FDCWD = -100 branch fires. Shared
# backend/aarch64/fixup.cyr reads `_strict_mode` after the patch loop.
# See CHANGELOG [5.11.63].
var _strict_mode = 0;
var _vbuf[256];
var _vfd = 0;
if (SYS_OPEN == 2) { _vfd = syscall(SYS_OPEN, "/proc/self/cmdline", 0, 0); }
else { _vfd = syscall(SYS_OPEN, 0 - 100, "/proc/self/cmdline", 0, 0); }
var _vn = syscall(SYS_READ, _vfd, &_vbuf, 255);
syscall(SYS_CLOSE, _vfd);
if (_vn > 0) {
    var _vi = 0;
    while (_vi < _vn) { if (load8(&_vbuf + _vi) == 0) { _vi = _vi + 1; break; } _vi = _vi + 1; }
    while (_vi < _vn) {
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 115 && load8(&_vbuf + _vi + 3) == 116) {
                    _strict_mode = 1;
                }
            }
        }
        while (_vi < _vn && load8(&_vbuf + _vi) != 0) { _vi = _vi + 1; }
        _vi = _vi + 1;
    }
}

# Allocate heap
# aarch64 syscall numbers (no translation layer — native numbers)
var S = syscall(SYS_BRK, 0);
# brk extends through tok_lines (~78.5 MB) — synced with main.cyr.
syscall(SYS_BRK, S + 0x5E1D000);

# Zero scratch state (v5.8.63 extraction; see src/common/util.cyr for slot list)
_HEAP_INIT_SCRATCH(S);

# v6.0.7 — init alloc and assign rp_vec (return-patch storage).
alloc_init();
rp_vec = vec_new();
# Phase 0 (v6.2.0): growable fixup table — base = the existing 0x107B000 region,
# cap = the old hard cap; GFCNT grows it 2x via alloc() once full (util.cyr).
_fixup_base = S + 0x107B000;
_fixup_cap = 1048576;
# Phase 0 (v6.2.0): growable fn-tables — bases start AT the original fixed
# offsets, mask 8191, cap 8192 (byte-identical under the old cap; REGFN grows
# the family + rehashes when the count would exceed it). See util.cyr.
_fnt_cstrmask = S + 0x93A000;
_fnt_resmask = S + 0x94A000;
_fnt_optmask = S + 0x95A000;
_fnt_tagmask = S + 0x96A000;
_fnt_ovstr = S + 0x97A000;
_fnt_ovint = S + 0x98A000;
_fnt_ovcstr = S + 0x99A000;
_fnt_simdmask = S + 0x9AA000;
_fnt_names = S + 0x9BA000;
_fnt_offsets = S + 0x9CA000;
_fnt_params = S + 0x9DA000;
_fnt_bodystart = S + 0x9EA000;
_fnt_bodyend = S + 0x9FA000;
_fnt_inline = S + 0xA0A000;
_fnt_strmask = S + 0xA1A000;
_fnt_codeend = S + 0xA2A000;
_fnt_namehash = S + 0x110000;
_fnt_starthash = S + 0x114000;
_fnt_hash_mask = 8191;
_fnt_cap = 8192;
# Phase 0 (v6.2.0): growable codebuf — base at the original 3 MB region,
# cap 3145728 (byte-identical under the old cap; EB grows + relocates off-heap
# when cp nears it). The cx backend's own 0x54A000 codebuf is separate + fixed.
_codebuf_base = S + 0x41A000;
_varn_base = S + 0x11A000; _vars_base = S + 0x12A000; _vart_base = S + 0x13A000; _vgoff_base = S + 0x1B0000; _vecv_base = S + 0x1D8000; _vgsi_base = S + 0x1EC000; _venid_base = S + 0x204000; _var_cap = 8192;
_codebuf_cap = 3145728;

# Read input (256KB, v3.4.19 — see src/main.cyr for rationale)
var bl = 0;
var done = 0;
while (done == 0) {
    var n = syscall(SYS_READ, 0, S + bl, 1048576 - bl);
    if (n <= 0) { done = 1; }
    else {
        bl = bl + n;
        if (bl >= 1048576) {
            var probe[1];
            var pn = syscall(SYS_READ, 0, &probe, 1);
            if (pn > 0) {
                syscall(SYS_WRITE, 2, "error: input exceeds 1MB buffer (raise input_buf in src/main.cyr)\n", 66);
                syscall(SYS_EXIT, 1);
            }
            done = 1;
        }
    }
}
SBL(S, bl);

# Preprocess includes
_init_cyrius_lib();
PP_PREDEFINE(S, "CYRIUS_ARCH_AARCH64");
# v5.11.27 — port the env-driven CYRIUS_MACHO_ARM dispatch block that
# main_aarch64.cyr:148-159 has carried since v5.5.16. Without it
# lib/alloc.cyr's `#ifdef CYRIUS_TARGET_LINUX` branch is dead → alloc
# undefined → every aarch64-native binary SIGILLs at first alloc().
# See CHANGELOG [5.11.27].
var _macho_arm_env_early = _read_env("CYRIUS_MACHO_ARM");
var _is_macho_arm_build = 0;
if (_macho_arm_env_early != 0) {
    if (load8(_macho_arm_env_early) == 49 && load8(_macho_arm_env_early + 1) == 0) {
        _is_macho_arm_build = 1;
    }
}
if (_is_macho_arm_build == 1) {
    PP_PREDEFINE(S, "CYRIUS_TARGET_MACOS");
} else {
    PP_PREDEFINE(S, "CYRIUS_TARGET_LINUX");
}
# v5.10.39 — non-PE targets support f64v2/f64v4 value-form param ABI.
PP_PREDEFINE(S, "CYRIUS_HAS_VAL_SIMD_PARAMS");
PREPROCESS(S);

# Lex
LEX(S);

# Emit initial branch over fn bodies (aarch64: B +0, patch later)
var jmp_patch = EJMP0(S);

# Pass 1: Pre-scan to register all global vars and structs (no fn bodies)
# Synced with main.cyr v2.1 — includes mod/pub/use/impl/union support
STI(S, 0);
var scan = 1;
while (scan == 1) {
    if (PEEKT(S) == 72) {
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); }
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    }
    else { if (PEEKT(S) == 73) {
            STI(S, GTI(S) + 1);
        }
        else { if (PEEKT(S) == 74) {
                STI(S, GTI(S) + 1);
                if (PEEKT(S) == 2) {
                    var umod = PEEKV(S);
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 41) {
                        STI(S, GTI(S) + 1);
                        if (PEEKT(S) == 2) {
                            var ufn = PEEKV(S);
                            STI(S, GTI(S) + 1);
                            var uc = GUSEC(S);
                            S64(S + 0x18FFD0 + uc * 8, ufn);
                            # v5.11.65 (CVE-05): pre-v5.11.65 this path had
                            # no tok_names bounds check at all (the parallel
                            # x86 main.cyr had a magic-256 NPOS_GUARD that
                            # this file never gained). Walk source lengths +
                            # call NPOS_GUARD for the actual write surface.
                            var _ulen1 = 0; while (load8(S + 0x60000 + umod + _ulen1) != 0) { _ulen1 = _ulen1 + 1; }
                            var _ulen2 = 0; while (load8(S + 0x60000 + ufn + _ulen2) != 0) { _ulen2 = _ulen2 + 1; }
                            NPOS_GUARD(S, _ulen1 + 1 + _ulen2 + 1);
                            var apos = GNPOS(S);
                            var ri = 0;
                            var rc = load8(S + 0x60000 + umod + ri);
                            while (rc != 0) { store8(S + 0x60000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0x60000 + umod + ri); }
                            store8(S + 0x60000 + apos, 95); apos = apos + 1;
                            ri = 0; rc = load8(S + 0x60000 + ufn + ri);
                            while (rc != 0) { store8(S + 0x60000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0x60000 + ufn + ri); }
                            store8(S + 0x60000 + apos, 0); apos = apos + 1;
                            var alias_noff = GNPOS(S);
                            SNPOS(S, apos);
                            S64(S + 0x1901D0 + uc * 8, alias_noff);
                            SUSEC(S, uc + 1);
                        }
                    }
                }
                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
            }
            else { if (PEEKT(S) == 40) { PARSE_STRUCT_DEF(S); }
                else { if (PEEKT(S) == 101) { PARSE_UNION_DEF(S); }
                    else { if (PEEKT(S) == 3) { PARSE_GVAR_REG(S); }
                        # v6.2.2: pass-1 must consume fn-attribute annotation tokens
                        # 109 #regalloc / 122 #must_use / 124 #deprecated / 125 #pure /
                        # 126 #io / 127 #alloc — exactly as main.cyr:1150-1165 does.
                        # Pre-fix this aarch64 scanner had no case for them, so an
                        # annotated fn (e.g. bayan's `#pure fn bayan_u128_eq`) fell into
                        # the catchall `else { scan = 0; }`, terminating pass-1 early and
                        # leaving the following enum (bayan's `TomlError`) unregistered →
                        # `error: unexpected enum`. Pass 2 arms the pending flags
                        # generically, so consume silently here.
                        else { if (PEEKT(S) == 109) { STI(S, GTI(S) + 1); }
                            else { if (PEEKT(S) == 122) { STI(S, GTI(S) + 1); }
                                else { if (PEEKT(S) == 124) {
                                        STI(S, GTI(S) + 1);
                                        if (PEEKT(S) == 10) {
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 30) { STI(S, GTI(S) + 1); }
                                            if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); }
                                        }
                                    }
                                    else { if (PEEKT(S) == 125) { STI(S, GTI(S) + 1); }
                                        else { if (PEEKT(S) == 126) { STI(S, GTI(S) + 1); }
                                            else { if (PEEKT(S) == 127 || PEEKT(S) == 133) { STI(S, GTI(S) + 1); }   # v6.2.27: +128 #naked (consume-and-ignore)
                        else { if (PEEKT(S) == 32) {
                                STI(S, GTI(S) + 1);
                                STI(S, GTI(S) + 1);
                                if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                                var dep = 0;
                                var fsk = 1;
                                while (fsk == 1) {
                                    var ft = PEEKT(S);
                                    if (ft == 13) { dep = dep + 1; }
                                    if (ft == 14) { dep = dep - 1; if (dep == 0) { fsk = 0; } }
                                    if (ft == 12) { fsk = 0; }
                                    STI(S, GTI(S) + 1);
                                }
                            }
                            else { if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 0); }
                                else { if (_TOK_IS_KERNEL(S) == 1) {
                                        S64(S + 0x18FCA0, 1);
                                        STI(S, GTI(S) + 1);
                                        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                    }
                                    else { if (PEEKT(S) == 78) {
                                            S64(S + 0x18FCA0, 2);
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                        }
                                        else { if (PEEKT(S) == 77) {
                                                STI(S, GTI(S) + 1);
                                                STI(S, GTI(S) + 1);
                                                STI(S, GTI(S) + 1);
                                                STI(S, GTI(S) + 1);
                                                if (PEEKT(S) == 13) {
                                                    STI(S, GTI(S) + 1);
                                                    var idep = 0;
                                                    var isk = 1;
                                                    while (isk == 1) {
                                                        var it = PEEKT(S);
                                                        if (it == 13) { idep = idep + 1; }
                                                        if (it == 14) { if (idep == 0) { isk = 0; } else { idep = idep - 1; } }
                                                        if (it == 12) { isk = 0; }
                                                        STI(S, GTI(S) + 1);
                                                    }
                                                }
                                            }
                                            else { scan = 0; } } } } } } } } } } } } } } } } }
}

# Reset module for pass 2
SMOD(S, 0);

# Pass 2: Parse struct and fn definitions (vars already registered)
# Synced with main.cyr v2.1 — includes mod/pub/use/impl/union/enum-ctor support
STI(S, 0);
var topgo = 1;
while (topgo == 1) {
    if (PEEKT(S) == 72) { STI(S, GTI(S) + 1); if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
    else { if (PEEKT(S) == 73) { STI(S, GTI(S) + 1); }
        else { if (PEEKT(S) == 74) { while (PEEKT(S) != 5) { if (PEEKT(S) == 12) { break; } STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
            else { if (PEEKT(S) == 40) {
                    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                    if (PEEKT(S) != 13) { ERR(S); }
                    STI(S, GTI(S) + 1);
                    var ssk = 1;
                    while (ssk == 1) { if (PEEKT(S) == 14) { ssk = 0; } else { STI(S, GTI(S) + 1); } }
                    STI(S, GTI(S) + 1);
                }
                else { if (PEEKT(S) == 101) {
                        STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                        if (PEEKT(S) != 13) { ERR(S); }
                        STI(S, GTI(S) + 1);
                        var usk = 1;
                        while (usk == 1) { if (PEEKT(S) == 14) { usk = 0; } else { STI(S, GTI(S) + 1); } }
                        STI(S, GTI(S) + 1);
                    }
                    else { if (PEEKT(S) == 60) {
                            PARSE_ENUM_DEF(S, 2);
                        }
                        else { if (_TOK_IS_KERNEL(S) == 1) {
                                STI(S, GTI(S) + 1);
                                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                            }
                            # v6.2.2: consume fn-attribute annotation tokens 109/122/124/
                            # 125/126/127 in pass-2 too (aarch64 gates off the #pure/#io/
                            # #alloc/#regalloc opts per CO-03, so just skip the token — no
                            # pending flags). Without this, a top-level `#pure` fell to
                            # `else { topgo = 0; }`, ending pass-2, and the trailing enum
                            # tripped `unexpected enum`. Mirror of main.cyr:1377-1391
                            # (minus the _*_pending sets aarch64 doesn't use).
                            else { if (PEEKT(S) == 109) { STI(S, GTI(S) + 1); }
                                else { if (PEEKT(S) == 122) { STI(S, GTI(S) + 1); }
                                    else { if (PEEKT(S) == 124) {
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 10) {
                                                STI(S, GTI(S) + 1);
                                                if (PEEKT(S) == 30) { STI(S, GTI(S) + 1); }
                                                if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); }
                                            }
                                        }
                                        else { if (PEEKT(S) == 125) { STI(S, GTI(S) + 1); }
                                            else { if (PEEKT(S) == 126) { STI(S, GTI(S) + 1); }
                                                else { if (PEEKT(S) == 127 || PEEKT(S) == 133) { if (PEEKT(S) == 133) { _naked_pending = 1; } STI(S, GTI(S) + 1); }   # v6.2.27: arm #naked (aarch64 skips prologue too, via the shared parse_fn.cyr gating)
                            else { if (PEEKT(S) == 32) {
                                    PARSE_FN_DEF(S);
                                }
                                else { if (PEEKT(S) == 3) {
                                        var vsk = 1;
                                        while (vsk == 1) { if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); vsk = 0; } else { STI(S, GTI(S) + 1); } }
                                    }
                                    else { if (PEEKT(S) == 77) { PARSE_IMPL(S); }
                                        else { if (PEEKT(S) == 78) { STI(S, GTI(S) + 1); if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
                                            else { topgo = 0; } } } } } } } } } } } } } } } } }
}

# Reset module
SMOD(S, 0);

# Patch jmp to land here (start of main code)
EPATCH(S, jmp_patch);

# Emit enum initializations FIRST (before gvar inits)
var gvar_save_ti = GTI(S);
STI(S, 0);
var escan = 1;
while (escan == 1) {
    if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 1); }
    else { if (PEEKT(S) == 12) { escan = 0; }
        else { STI(S, GTI(S) + 1); } }
}
# Emit deferred global var initializations
EMIT_GVAR_INITS(S);
STI(S, gvar_save_ti);

# Parse main code (top-level statements)
PARSE_PROG(S);

# Exit epilogue — load last var
var lv = GLVAR(S);
if (lv >= 0) { EVLOAD(S, lv); }

# v6.0.68: auto-call `main()` if defined — port of main_aarch64.cyr's
# v5.9.37 fix that this NATIVE aarch64-Linux fork never received (same
# rot class as the Mach-O fork at v6.0.37 and main_win at v6.0.54).
# Without it a source whose only entry is `fn main() { ... }` (no
# trailing `var ec = main(); syscall(60, ec);`) never invoked main and
# exited with junk in x0 — so EVERY `cyrius build` on aarch64-Linux that
# used the bare-`main` convention silently produced a binary exiting 0.
# Latent the whole life of build/cycc-native-aarch64 (v6.0.7+) because
# the aarch64-native funcgate was soft, masked behind §D1's deps failure;
# surfaced the instant §D1 was fixed and the funcgate reached the run step
# (fib exited 0, not 42). The compiler itself sys_exits explicitly, so it
# self-hosts byte-identical either way. Walks the fn table for "main\0"
# and emits ECALLTO if found.
var _epi_km_pre = L64(S + 0x18FCA0);
if (_epi_km_pre == 0) {
    var _main_fc = GFNC(S);
    var _main_fi = 0;
    var _main_found = 0 - 1;
    while (_main_fi < _main_fc) {
        var _main_noff = L64(_fnt_names + _main_fi * 8);
        if (load8(S + 0x60000 + _main_noff)     == 109) {
            if (load8(S + 0x60000 + _main_noff + 1) == 97) {
                if (load8(S + 0x60000 + _main_noff + 2) == 105) {
                    if (load8(S + 0x60000 + _main_noff + 3) == 110) {
                        if (load8(S + 0x60000 + _main_noff + 4) == 0) {
                            _main_found = _main_fi;
                            _main_fi = _main_fc;
                        }
                    }
                }
            }
        }
        _main_fi = _main_fi + 1;
    }
    if (_main_found >= 0) {
        var _main_off = L64(_fnt_offsets + _main_found * 8);
        if (_main_off >= 0) {
            ECALLTO(S, _main_off);
        }
    }
}

EEXIT(S);

# Fixup + ELF + write
FIXUP(S);
EMITELF(S);
# Write ELF output (loop on partial writes)
var olen = L64(S + 0x1903F8);
var written = 0;
var wgo = 1;
while (wgo == 1) {
    var w = syscall(SYS_WRITE, 1, S + 0x4D9D000 + written, olen - written);
    if (w <= 0) { wgo = 0; }
    else {
        written = written + w;
        if (written >= olen) { wgo = 0; }
    }
}
syscall(SYS_EXIT, 0);
