# Cyrius-X Compiler — emits .cyx bytecode instead of ELF
# Usage: cat prog.cyr | ./build/cycc_cx > prog.cyx
# Run:   cat prog.cyx | ./build/cxvm

enum Sys { SYS_READ = 0; SYS_WRITE = 1; SYS_OPEN = 2; SYS_CLOSE = 3; SYS_BRK = 12; SYS_EXIT = 60; }

include "src/version_str.cyr"
include "src/common/util.cyr"
# v6.0.8 — token helpers shared with x86/aarch64. cx KEEPS its own
# RECFIX (different cap + region) and _read_env stub, so it does
# NOT include common/runtime.cyr.
include "src/backend/common/tokens.cyr"
include "src/backend/cx/emit.cyr"
# v5.7.11: ir.cyr added at v5.6.12 (O3a IR instrumentation) but
# never to main_cx.cyr; parse_expr.cyr references IR_RAW_EMIT.
# Same shape as v5.6.32's main_aarch64_native.cyr fix.
include "src/common/ir.cyr"
include "src/frontend/lex.cyr"

# v6.0.7 — alloc + vec for return-patch vec storage. Must precede
# parse.cyr so converted call sites resolve at parse time.
include "lib/alloc.cyr"
include "lib/vec.cyr"
var rp_vec = 0;

include "src/frontend/parse.cyr"

# MAIN
# ================================================================

# Allocate heap. v6.4.22: per-target — macOS/Windows have NO brk (XNU/Win32),
# so cross-compiling cycc_cx to Mach-O/PE with the old raw `syscall(SYS_BRK,...)`
# emitted 2 unrouted syscalls that FAULTED on macOS (signal 12) and would on PE.
# Mirror main.cyr / main_win.cyr: mmap on macho (flags 0x1002 = MAP_ANON|PRIVATE)
# + on PE (flags 0x22, the syscall(9) → VirtualAlloc reroute), brk on Linux/agnos.
# Flat per-target #ifdef blocks (exactly one of MACOS/WIN/LINUX/AGNOS is predefined
# by the compiling driver) — the alloc.cyr idiom, avoids nested #ifdef. Arena top
# 0xF600000 maps the relocated lexid_entries @ 0xF400000 (v6.4.21 LEXID cap).
#ifdef CYRIUS_TARGET_MACOS
var S = syscall(9, 0, 0xF600000, 3, 0x1002, 0 - 1, 0);
if (S < 0x100000) {
    syscall(1, 2, "cycc_cx: mmap heap init failed\n", 31);
    syscall(60, 1);
}
#endif
#ifdef CYRIUS_TARGET_WIN
var S = syscall(9, 0, 0xF600000, 3, 0x22, 0 - 1, 0);
#endif
#ifdef CYRIUS_TARGET_LINUX
var S = syscall(SYS_BRK, 0);
syscall(SYS_BRK, S + 0xF600000);
#endif
#ifdef CYRIUS_TARGET_AGNOS
var S = syscall(SYS_BRK, 0);
syscall(SYS_BRK, S + 0xF600000);
#endif

# Zero scratch state (v5.8.63 extraction; see src/common/util.cyr for slot list)
_HEAP_INIT_SCRATCH(S);

# v6.0.7 — init alloc and assign rp_vec (return-patch storage).
alloc_init();
rp_vec = vec_new();
# Phase 0 (v6.2.0): growable fn-tables — bases start AT the original fixed
# offsets, mask 8191, cap 8192 (byte-identical under the old cap; REGFN grows
# the family + rehashes when the count would exceed it). See util.cyr.
_fnt_cstrmask = S + 0x93A000;
_fnt_resmask = S + 0x94A000;
_fnt_optmask = S + 0x95A000;
_fnt_tagmask = S + 0x96A000;
_fnt_ovstr = S + 0x97A000;
_fnt_ovint = S + 0x98A000;
_fnt_ovcstr = S + 0x99A000;
_fnt_simdmask = S + 0x9AA000;
_fnt_names = S + 0x9BA000;
_fnt_offsets = S + 0x9CA000;
_fnt_params = S + 0x9DA000;
_fnt_bodystart = S + 0x9EA000;
_fnt_bodyend = S + 0x9FA000;
_fnt_inline = S + 0xA0A000;
_fnt_strmask = S + 0xA1A000;
_fnt_codeend = S + 0xA2A000;
_fnt_structmask = S + 0xA3A000;
_fnt_namehash = S + 0x110000;
_fnt_starthash = S + 0x114000;
_fnt_hash_mask = 4095;   # v6.5.40: hash slots are 4 B now, so the fixed 16 KB regions hold 4096
_fnt_cap = 4096;        # v6.5.40: was 8192 at 2 B/slot; _fnt_grow doubles from here
# Phase 0 (v6.2.0): growable codebuf — base at the original 3 MB region,
# cap 3145728 (byte-identical under the old cap; EB grows + relocates off-heap
# when cp nears it). The cx backend's own 0x54A000 codebuf is separate + fixed.
_codebuf_base = S + 0x41A000;
_varn_base = S + 0x11A000;
_vars_base = S + 0x12A000;
_vart_base = S + 0x13A000;
_vgoff_base = S + 0x1B0000;
_vecv_base = S + 0x1D8000;
_vgsi_base = S + 0x1EC000;
_venid_base = S + 0x204000;
_var_cap = 8192;
_vsgn_base = alloc(1048576 * 8);   # v6.4.23 signed-global sign-ext: max-sized (var-grow cap) so it never grows → NO cybs-fragile grow-chain change; 8MB lazy-mapped
_codebuf_cap = 3145728;
# ⛔ v6.5.13 — cx never set these. `_fixup_base` stayed 0, so the SHARED
# `ELOAD_FN_ADDR` path (parse_expr.cyr:687 `var fnaddr = _fixup_base + fc * 16`)
# computed an address near NULL and SIGSEGV'd the compiler the moment cx tried to
# record a fn-pointer fixup — which is why cx's ELOAD_FN_ADDR was a return-0 stub
# and `&fn` silently produced 0. cx's own writers (RECFIX / ECALLFIX / the closure
# fixup in backend/cx/emit.cyr) all hardcode `S + 0x150B000`, so point the shared
# base at the SAME table; the two addressing schemes must not diverge. Cap matches
# ECALLFIX's own `fc >= 1048576` guard.
_fixup_base = S + 0x150B000;
_fixup_cap = 1048576;

# Read input (256KB, v3.4.19 — see src/main.cyr for rationale)
var bl = 0;
var done = 0;
while (done == 0) {
    var n = syscall(SYS_READ, 0, S + _SRCB + bl, _SRC_CAP - bl);
    if (n <= 0) { done = 1; }
    else {
        bl = bl + n;
        if (bl >= _SRC_CAP) {
            var probe[1];
            var pn = syscall(SYS_READ, 0, &probe, 1);
            if (pn > 0) {
                syscall(SYS_WRITE, 2, "error: input exceeds the 24MB source buffer
", 44);
                syscall(SYS_EXIT, 1);
            }
            done = 1;
        }
    }
}
SBL(S, bl);

# Preprocess includes
_init_cyrius_lib();
# v6.4.54: cx now marshals value-form SIMD params/returns (GP register-pair transport,
# ESTOREPARM_F64V2/V4 + ELOAD_F64V2/V4_TO_XMM in backend/cx/emit.cyr), so lib/simd.cyr's
# value-form typed wrappers compile on cx — matches every other fork (main.cyr:1021, etc.).
PP_PREDEFINE(S, "CYRIUS_HAS_VAL_SIMD_PARAMS");
var _poison_env_early = _read_env("CYRIUS_POISON");
# v6.5.29 — CYRIUS_POISON: opt-in allocator poison mode (redzones, poison fill,
# quarantine-on-free) so an out-of-bounds READ or a use-after-free is OBSERVABLE to
# `cyrius fuzz`. Filed by sit after a heap disclosure its fuzz suite ran past for three
# minor versions: the read landed in mapped memory, so there was no fault to catch.
# A COMPILE-TIME predefine, not a runtime env read — `lib/freelist.cyr` deliberately
# depends on mmap + atomic only, and an allocator should not be parsing the environment.
# Costs nothing when off. Set on all SEVEN forks, because a fuzz mode that exists only on
# x86-Linux tells three other platforms' consumers nothing.
if (_poison_env_early != 0) { PP_PREDEFINE(S, "CYRIUS_POISON"); }
PREPROCESS(S);

# Build file map from #@file markers (for file:line error messages)
# v6.5.20: this call existed ONLY in main.cyr and main_win.cyr. The other five
# forks never built the map, so FM_LOOKUP's `cnt == 0` early-return printed the
# RAW EXPANDED-BUFFER line and dropped the `<source>:` prefix entirely — every
# diagnostic on ecb / ach / pi was wrong, and not by a constant: the skew grows
# with everything the preprocessor splices in (+1 bare, +4 with one include,
# +6 with two). Measured pre-existing, but 6.5.20 removed a compensating error
# that had been masking it on the derive path, so it must not ship unfixed.
FM_BUILD(S);

# Lex
LEX(S);


# Emit initial jmp over fn bodies (bytecode JMP)
var jmp_patch = EJMP0(S);

# Pass 1: Pre-scan to register all global vars and structs (no fn bodies)
STI(S, 0);
var scan = 1;
while (scan == 1) {
    if (PEEKT(S) == 72) {
        # mod name; — set current module prefix
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); }
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    }
    else { if (_TL_VIS(S) == 1) {
            # v6.5.0: `pub`/`public` and `private` both handled by _TL_VIS, which
            # consumes the token and records the visibility intent. Was a bare
            # skip-and-ignore for `pub`.
        }
        else { if (PEEKT(S) == 74) {
                # use modname.funcname; — register alias
                STI(S, GTI(S) + 1);
                if (PEEKT(S) == 2) {
                    var umod = PEEKV(S);
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 41) {
                        STI(S, GTI(S) + 1);
                        if (PEEKT(S) == 2) {
                            var ufn = PEEKV(S);
                            STI(S, GTI(S) + 1);
                            # Build mangled name: mod_fn
                            # Each alias gets 64 bytes in scratch area (30000 + uc*64)
                            var uc = GUSEC(S);
                            S64(S + 0x18FFD0 + uc * 8, ufn);
                            # Append mangled name to tok_names (after lexing, NPOS is stable)
                            # v5.11.65 (CVE-05): no prior tok_names guard
                            # on this path. See main_aarch64.cyr same site.
                            var _ulen1 = 0; while (load8(S + 0xEC00000 + umod + _ulen1) != 0) { _ulen1 = _ulen1 + 1; }
                            var _ulen2 = 0; while (load8(S + 0xEC00000 + ufn + _ulen2) != 0) { _ulen2 = _ulen2 + 1; }
                            NPOS_GUARD(S, _ulen1 + 1 + _ulen2 + 1);
                            var apos = GNPOS(S);
                            var ri = 0;
                            var rc = load8(S + 0xEC00000 + umod + ri);
                            while (rc != 0) { store8(S + 0xEC00000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0xEC00000 + umod + ri); }
                            store8(S + 0xEC00000 + apos, 95); apos = apos + 1;
                            ri = 0; rc = load8(S + 0xEC00000 + ufn + ri);
                            while (rc != 0) { store8(S + 0xEC00000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0xEC00000 + ufn + ri); }
                            store8(S + 0xEC00000 + apos, 0); apos = apos + 1;
                            var alias_noff = GNPOS(S);
                            SNPOS(S, apos);
                            S64(S + 0x1901D0 + uc * 8, alias_noff);
                            SUSEC(S, uc + 1);
                        }
                    }
                }
                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
            }
            else { if (PEEKT(S) == 40) { PARSE_STRUCT_DEF(S); }
                else { if (PEEKT(S) == 101) { PARSE_UNION_DEF(S); }
                    else { if (PEEKT(S) == 3) { PARSE_GVAR_REG(S); }
                        else { if (_IS_FN_KW(S) == 1) {
                                # v6.3.5 CO-01 — pass-1 fn-signature prescan (see _prescan_fn_sig in parse_fn.cyr).
                                _prescan_fn_sig(S);
                            }
                            else { if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 0); }
                                else { if (_TOK_IS_KERNEL(S) == 1) {
                                        S64(S + 0x18FCA0, 1);
                                        STI(S, GTI(S) + 1);
                                        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                    }
                                    else { if (PEEKT(S) == 78) {
                                            S64(S + 0x18FCA0, 2);
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                        }
                                        else { if (PEEKT(S) == 77) {
                                                # impl — skip entire block in pass 1 (functions registered in pass 2)
                                                STI(S, GTI(S) + 1);  # consume IMPL
                                                STI(S, GTI(S) + 1);  # consume trait name
                                                STI(S, GTI(S) + 1);  # consume FOR
                                                STI(S, GTI(S) + 1);  # consume type name
                                                if (PEEKT(S) == 13) {
                                                    STI(S, GTI(S) + 1);
                                                    var idep = 0;
                                                    var isk = 1;
                                                    while (isk == 1) {
                                                        var it = PEEKT(S);
                                                        if (it == 13) { idep = idep + 1; }
                                                        if (it == 14) { if (idep == 0) { isk = 0; } else { idep = idep - 1; } }
                                                        if (it == 12) { isk = 0; }
                                                        STI(S, GTI(S) + 1);
                                                    }
                                                }
                                            }
                                            else { if (PEEKT(S) == 109 || PEEKT(S) == 122 || PEEKT(S) == 125 || PEEKT(S) == 126 || PEEKT(S) == 127 || PEEKT(S) == 133) { STI(S, GTI(S) + 1); } else { if (PEEKT(S) == 124) { STI(S, GTI(S) + 1); if (PEEKT(S) == 10) { STI(S, GTI(S) + 1); if (PEEKT(S) == 30) { STI(S, GTI(S) + 1); } if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); } } } else { scan = 0; } } } } } } } } } } } } }
}

# Reset module for pass 2
SMOD(S, 0);

# v6.5.17 — the DCE pre-scan referenced-name bitmap is GONE with the parse-time
# body skip it fed. See src/main.cyr for the full note.

# v6.3.5 AR-01 — opt-in monomorphization substrate (CYRIUS_MONOMORPH=1; default off; see util.cyr).
var _mono_env = _read_env("CYRIUS_MONOMORPH");
if (_mono_env != 0) {
    if (load8(_mono_env) == 48 && load8(_mono_env + 1) == 0) {
        _MONOMORPH_OK = 0;
    }
}

# Pass 2: Parse struct and fn definitions (vars already registered)
STI(S, 0);
var topgo = 1;
while (topgo == 1) {
    # Skip mod/pub/use in pass 2
    if (PEEKT(S) == 72) { STI(S, GTI(S) + 1); if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
    else { if (_TL_VIS(S) == 1) { }
        else { if (PEEKT(S) == 74) { while (PEEKT(S) != 5) { if (PEEKT(S) == 12) { break; } STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
            else { if (PEEKT(S) == 40) {
                    # Skip struct (already parsed in pass 1)
                    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                    if (PEEKT(S) != 13) { ERR(S); }
                    STI(S, GTI(S) + 1);
                    var ssk = 1;
                    while (ssk == 1) { if (PEEKT(S) == 14) { ssk = 0; } else { STI(S, GTI(S) + 1); } }
                    STI(S, GTI(S) + 1);
                }
                else { if (PEEKT(S) == 101) {
                        # Skip union (already parsed in pass 1)
                        STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                        if (PEEKT(S) != 13) { ERR(S); }
                        STI(S, GTI(S) + 1);
                        var usk = 1;
                        while (usk == 1) { if (PEEKT(S) == 14) { usk = 0; } else { STI(S, GTI(S) + 1); } }
                        STI(S, GTI(S) + 1);
                    }
                    else { if (PEEKT(S) == 60) {
                            # Emit constructor bodies in function section (before JMP is patched)
                            PARSE_ENUM_DEF(S, 2);
                        }
                        else { if (_TOK_IS_KERNEL(S) == 1) {
                                STI(S, GTI(S) + 1);
                                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                            }
                            else { if (_IS_FN_KW(S) == 1) {
                                    # v6.5.17 — EVERY fn body is PARSED, reachable or not. The
                                    # parse-time "skip an unreferenced fn's body" stub that used to
                                    # sit here was gated on "the name contains no '_'", so a syntax
                                    # error inside an uncalled underscore-free fn compiled GREEN.
                                    # Reachability is a codegen concern; see src/main.cyr for the
                                    # full note and tests/gates/frontend/dead_fn_body_syntax_checked.sh.
                                    if (PEEKT(S) == 134) { _pending_async = 1; STI(S, GTI(S) + 1); }   # v6.3.11 (G)
                                    PARSE_FN_DEF(S);
                                }
                                else { if (PEEKT(S) == 3) {
                                        var vsk = 1;
                                        while (vsk == 1) { if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); vsk = 0; } else { STI(S, GTI(S) + 1); } }
                                    }
                                    else { if (PEEKT(S) == 77) { PARSE_IMPL(S); }
                                        else { if (PEEKT(S) == 78) { STI(S, GTI(S) + 1); if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
                                            else { topgo = 0; } } } } } } } } } } }
}

# Reset module
SMOD(S, 0);

# Patch jmp to land here (start of main code)
EPATCH(S, jmp_patch);

# Emit enum initializations FIRST (before gvar inits, since gvar inits may call
# functions that reference enum values)
var gvar_save_ti = GTI(S);
STI(S, 0);
var escan = 1;
while (escan == 1) {
    if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 1); }
    else { if (PEEKT(S) == 12) { escan = 0; }
        else { STI(S, GTI(S) + 1); } }
}
# Emit deferred global var initializations
EMIT_GVAR_INITS(S);
STI(S, gvar_save_ti);

# Warn about undefined functions (registered but never defined — offset still -1)
var wfi = 0;
var wfc = GFNC(S);
while (wfi < wfc) {
    if (L64(_fnt_offsets + wfi * 8) < 0) {   # v6.4.58: canonical table (0xE92000 was all-zero → never fired)
        syscall(SYS_WRITE, 2, "warning: undefined function '", 29);
        PRSTR(S + 0xEC00000 + L64(_fnt_names + wfi * 8));
        syscall(SYS_WRITE, 2, "'\n", 2);
    }
    wfi = wfi + 1;
}

# Parse main code (top-level statements)
PARSE_PROG(S);

# Exit epilogue — load last var
var lv = GLVAR(S);
if (lv >= 0) { EVLOAD(S, lv); }
EEXIT(S);

# Fixup: resolve string/var/fn addresses in bytecode
# For .cyx, addresses are byte offsets into the data section appended after code.
# Data layout: [code (cp bytes)] [var data (totvar bytes)] [string data (spos bytes)]
var cp = GCP(S);
cp = (cp + 7) & (0 - 8);
SCP(S, cp);
var vcnt = GVCNT(S);
var totvar = 0;
var vi = 0;
while (vi < vcnt) { totvar = totvar + L64(_vars_base + vi * 8); vi = vi + 1; }
var spos = GSPOS(S);
# Data base = cp (data starts right after bytecode in the loaded .cyx)
var dbase = cp;

# ⛔ v6.5.12: REACHABLE UNDEFINED CALLS ARE A HARD ERROR ON cx TOO.
#
# The native backends have gated this since v6.3.2 (src/backend/x86/fixup.cyr:725,
# aarch64/fixup.cyr:558). cx had NO equivalent, and the consequence was not a missing
# diagnostic — it was a corrupt program emitted with exit 0:
#
#   `var r = nosuchfn(1);`  →  compile exit 0, ZERO stderr, a 215-byte .cyx; running it
#   printed the pre-call marker **1026 times** and never reached the post-call one.
#
# Mechanism: an undefined fn leaves **-1** in `_fnt_offsets`, and the ftype==2 arm below
# computed `off = (target - coff) / 4` from it with no check, patching a garbage backward
# offset into the call — so control jumped to roughly offset 0 and the program restarted.
# The warn loop further down could never catch this either: it walks REGISTERED fns, and
# it fired for none of them in the repro.
#
# Counted here rather than errored inline so the message names EVERY missing fn in one
# pass, matching the native gate's `undef_count` shape. cx has no `--allow-undef` (that
# flag lives in the main.cyr fork), so this is unconditional — which is correct: there is
# no useful `.cyx` to emit when a call target does not exist.
var cx_undef = 0;
var ufi = 0;
while (ufi < GFCNT(S)) {
    var ufaddr = S + 0x150B000 + ufi * 16;
    var uraw = L64(ufaddr + 8);
    var uft = uraw >> 56;
    var uidx = uraw & 0x00FFFFFFFFFFFFFF;
    if (uft == 2 || uft == 3) {
        if (L64(_fnt_offsets + uidx * 8) < 0) {
            if (cx_undef == 0) {
                syscall(SYS_WRITE, 2, "error: undefined function(s) called (cx backend):\n", 50);
            }
            syscall(SYS_WRITE, 2, "  - ", 4);
            PRSTR(S + 0xEC00000 + L64(_fnt_names + uidx * 8));
            syscall(SYS_WRITE, 2, "\n", 1);
            cx_undef = cx_undef + 1;
        }
    }
    ufi = ufi + 1;
}
if (cx_undef > 0) {
    syscall(SYS_WRITE, 2, "  refusing to emit .cyx — an unresolved call patches a garbage offset and restarts the program.\n", 98);
    syscall(SYS_EXIT, 1);
}

var fcnt = GFCNT(S);
var fi = 0;
while (fi < fcnt) {
    var faddr = S + 0x150B000 + fi * 16;   # cx arc B: fixup table base — MUST match the writers (RECFIX / ECALLFIX / closure-fixup in backend/cx/emit.cyr all write 0x150B000). Was 0x1A0000 (a refactor miss) → var + forward-call fixups were written but never read, so every global var / forward call collided at the placeholder addr 0.
    var coff = L64(faddr);
    var raw = L64(faddr + 8);
    var ftype = raw >> 56;
    var idx = raw & 0x00FFFFFFFFFFFFFF;
    if (ftype == 2) {
        # Forward function call — patch the 24-bit relative offset into bytes 1-3 of
        # the call instruction (opcode 0x60 at byte 0 PRESERVED), in 4-byte instruction
        # units, mirroring ECALLTO's `off=(target-cp)/4`. v6.4.54: this was triply broken
        # — (a) read the stale 0xE92000 stub table (only the DCE-dead-fn stub writes it)
        # instead of _fnt_offsets (the canonical table PARSE_FN_DEF writes + ECALLTO reads,
        # parse_fn.cyr:1526); (b) used BYTE units (`target-coff-4`); (c) `S64(pa, ...low 32
        # bits...)` clobbered byte 0 (the 0x60 opcode) → every forward call derailed/SIGSEGV.
        # CHANGELOG [6.4.54]
        var target = L64(_fnt_offsets + idx * 8);
        var off = (target - coff) / 4;
        store8(S + 0x54A000 + coff + 1, off & 0xFF);
        store8(S + 0x54A000 + coff + 2, (off >> 8) & 0xFF);
        store8(S + 0x54A000 + coff + 3, (off >> 16) & 0xFF);
    }
    elif (ftype == 3) {
        # Function pointer — absolute code offset
        var foff = L64(_fnt_offsets + idx * 8);   # v6.4.58: canonical table (mirrors the ftype==2 reader migrated in v6.4.54)
        # Patch movi: store 16-bit value in bytes 2-3
        store8(S + 0x54A000 + coff + 2, foff & 0xFF);
        store8(S + 0x54A000 + coff + 3, (foff >> 8) & 0xFF);
    }
    elif (ftype == 1) {
        # String address → dbase + totvar + string_offset
        # coff points AFTER the movi instruction — patch at coff-4+2 = coff-2
        var addr = dbase + totvar + idx;
        store8(S + 0x54A000 + coff - 2, addr & 0xFF);
        store8(S + 0x54A000 + coff - 1, (addr >> 8) & 0xFF);
        if (addr > 0xFFFF) {
            # Patch movhi (starts at coff, bytes 2-3)
            store8(S + 0x54A000 + coff + 2, (addr >> 16) & 0xFF);
            store8(S + 0x54A000 + coff + 3, (addr >> 24) & 0xFF);
        }
    }
    else {
        # Variable address → dbase + cumulative offset
        var cumul = 0;
        vi = 0;
        while (vi < idx) { cumul = cumul + L64(_vars_base + vi * 8); vi = vi + 1; }
        var addr = dbase + cumul;
        store8(S + 0x54A000 + coff - 2, addr & 0xFF);
        store8(S + 0x54A000 + coff - 1, (addr >> 8) & 0xFF);
        if (addr > 0xFFFF) {
            store8(S + 0x54A000 + coff + 2, (addr >> 16) & 0xFF);
            store8(S + 0x54A000 + coff + 3, (addr >> 24) & 0xFF);
        }
    }
    fi = fi + 1;
}

# v6.4.50: soft capacity warnings (util.cyr, shared). cx's code lives in the
# fixed 512 KiB region at 0x54A000 — no growable codebuf — so pass (524288, 0).
# Warnings go to stderr (fd 2); the .cyx below goes to stdout (fd 1), unaffected.
_capacity_warnings(S, 524288, 0);

# Emit CYX file: header + bytecode + var data + string data
# Header: "CYX" (3 bytes) + format version (1 byte) + entry_offset (4 bytes LE).
# cx arc A: byte 3 is now a FORMAT VERSION (was a hardcoded 0). Bump CYX_VERSION on
# ANY bytecode-ISA change (e.g. arc-B float opcodes) so a shipped cxvm rejects a
# .cyx it can't run instead of silently mis-executing. cxvm validates it.
# v6.4.62 (DX multi-error): a compile with ANY reported error emits NO .cyx (cx has
# its own write path, not EMITELF) — every error was printed and cx exits _had_error(=1).
if (_had_error == 0) {
    syscall(SYS_WRITE, 1, "CYX", 3);
    var ver_byte[1];
    store8(&ver_byte, 1);   # CYX_VERSION = 1
    syscall(SYS_WRITE, 1, &ver_byte, 1);
    var entry_off[4];
    store32(&entry_off, 0);
    syscall(SYS_WRITE, 1, &entry_off, 4);
    # Write bytecode
    var bw = 0;
    var bwgo = 1;
    while (bwgo == 1) {
        var w = syscall(SYS_WRITE, 1, S + 0x54A000 + bw, cp - bw);
        if (w <= 0) { bwgo = 0; }
        else { bw = bw + w; if (bw >= cp) { bwgo = 0; } }
    }
    # Write variable data (zeroed)
    var zero_byte[1];
    store8(&zero_byte, 0);
    vi = 0;
    while (vi < totvar) { syscall(SYS_WRITE, 1, &zero_byte, 1); vi = vi + 1; }
    # Write string data
    bw = 0;
    bwgo = 1;
    while (bwgo == 1) {
        var w = syscall(SYS_WRITE, 1, S + 0x21A000 + bw, spos - bw);
        if (w <= 0) { bwgo = 0; }
        else { bw = bw + w; if (bw >= spos) { bwgo = 0; } }
    }
}
syscall(SYS_EXIT, _had_error);
