# ================================================================
# Cyrius Compiler v2 — Modular Self-Hosting Compiler
# ================================================================
# Same language as cc.cyr, split into modules using include.
# Compiled by cc (cybs's extended language).
#
# Build: cat src/main.cyr | ./build/cycc > /tmp/cycc && chmod +x /tmp/cycc
# Self-host: cat src/main.cyr | /tmp/cycc > /tmp/cc5b && cmp /tmp/cycc /tmp/cc5b
# ================================================================
# HEAP MAP — none here: src/main.cyr carries the ONE heap map, and this fork
# uses that layout (every `S + 0x…` offset lives in the shared modules).
# tests/gates/memory/heapmap.sh FAILS if a fork carries a map line: the
# copies that stood here had drifted from the live layout. CHANGELOG [6.6.20]
# ================================================================
#
# Token types:
#   1=NUM 2=IDENT 3=VAR 4=EQ 5=SEMI 6=PLUS 7=MINUS 8=STAR 9=SLASH
#   10=LPAREN 11=RPAREN 12=EOF 13=LBRACE 14=RBRACE 15=IF 16=WHILE
#   17=EQEQ 18=NEQ 19=LT 20=GT 21=LTE 22=GTE 23=ELSE
#   24=SYSCALL 25=LOAD8 26=STORE8 27=AMPERSAND 28=LBRACKET 29=RBRACKET
#   30=STRING 31=COMMA 32=FN 33=RETURN 34=PERCENT 35=PIPE 36=CARET
#   37=TILDE 38=SHL 39=SHR 40=STRUCT 41=DOT 42=LOAD16 43=LOAD32
#   44=LOAD64 45=STORE16 46=STORE32 47=STORE64 48=ASM 49=COLON
#   50=ELIF 51=BREAK 52=CONTINUE 53=AND 54=OR 55=FOR 56=KERNEL 57=SWITCH 58=CASE 59=DEFAULT 60=ENUM
#   61=FLOAT 62=F64ADD 63=F64SUB 64=F64MUL 65=F64DIV 66=F64FROM 67=F64TO
#   68=F64EQ 69=F64LT 70=F64GT 71=F64NEG
#   72=MOD 73=PUB 74=USE 75=MATCH 76=IN 77=IMPL
#   97=RET2 98=RETHI 99=F64ATAN 100=SIZEOF


# x86_64 syscall number constants (used by shared cc/ modules)
enum Sys { SYS_READ = 0; SYS_WRITE = 1; SYS_OPEN = 2; SYS_CLOSE = 3; SYS_MMAP = 9; SYS_BRK = 12; SYS_EXIT = 60; }

# v5.6.39: shared auto-generated version string (see src/version_str.cyr).
include "src/version_str.cyr"

# ================================================================
# MODULES
# ================================================================
include "src/common/util.cyr"
# v6.0.8 — shared backend helpers (see src/main.cyr).
include "src/backend/common/tokens.cyr"
include "src/backend/common/runtime.cyr"
include "src/backend/x86/emit.cyr"
include "src/backend/x86/float.cyr"
include "src/backend/x86/jump.cyr"
include "src/backend/x86/decode.cyr"
include "src/common/ir.cyr"
include "src/frontend/lex.cyr"

# v6.0.7 — alloc + vec for return-patch vec storage. Must precede
# parse.cyr so converted call sites resolve at parse time. The PE
# build pre-defines CYRIUS_TARGET_WIN so alloc.cyr routes to
# alloc_windows.cyr (VirtualAlloc) instead of brk.
include "lib/alloc.cyr"
include "lib/vec.cyr"
var rp_vec = 0;

include "src/frontend/parse.cyr"
include "src/backend/macho/emit.cyr"
include "src/backend/pe/emit.cyr"
include "src/backend/x86/fixup.cyr"

# ================================================================
# MAIN
# ================================================================

# Command-line flags (v5.4.19). `--strict` is ACCEPTED and does nothing — a reachable
# undefined fn is a hard error by default since v6.3.2; see src/main.cyr. CHANGELOG [6.6.20]
var _allow_undef = 0;   # v6.3.2: --allow-undef downgrades the now-default reachable-undef hard error (x86/fixup.cyr gates on `_allow_undef == 0`)
var _vbuf[256];
var _vfd = 0;
# v5.5.9: the command-line parse uses /proc/self/cmdline, a
# Linux-only pseudofile. On Windows this CreateFileW returns
# INVALID_HANDLE_VALUE and subsequent ReadFile on the bad handle
# crashes cycc_win.exe at startup. Gate the whole block on
# CYRIUS_TARGET_LINUX so cycc_win.exe (built by cycc_win with
# CYRIUS_TARGET_WIN predefined at runtime) skips it entirely.
# v6.0.54: the Windows equivalent below uses GetCommandLineW (the
# `syscall(0xF006)` PE reroute, src/backend/x86/emit.cyr) — the
# "GetCommandLineW-based replacement" the prior comment queued.
#ifdef CYRIUS_TARGET_LINUX
if (SYS_OPEN == 2) { _vfd = syscall(SYS_OPEN, "/proc/self/cmdline", 0, 0); }
else { _vfd = syscall(SYS_OPEN, 0 - 100, "/proc/self/cmdline", 0, 0); }
var _vn = syscall(SYS_READ, _vfd, &_vbuf, 255);
syscall(SYS_CLOSE, _vfd);
if (_vn > 0) {
    var _vi = 0;
    while (_vi < _vn) { if (load8(&_vbuf + _vi) == 0) { _vi = _vi + 1; break; } _vi = _vi + 1; }
    # Walk the cmdline args, looking for cycc's flags. Each
    # arg is NUL-terminated; cmdline contains argv[0]\0argv[1]\0...
    while (_vi < _vn) {
        # "--ve" (--version) — short-circuit exit
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 118 && load8(&_vbuf + _vi + 3) == 101) {
                    _write_out_all(_VERSION_STR_CYCC_WIN, _VERSION_LEN_CYCC_WIN);
                    syscall(SYS_EXIT, 0);
                }
            }
        }
        # "--sy" (--syntax-only) — the same flag as main.cyr's (see _syntax_only, util.cyr).
        # 6.6.17: this fork never read it, so `cyrius lint`'s pre-pass on Windows got a full
        # resolving compile. chars s(115) y(121).
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 115 && load8(&_vbuf + _vi + 3) == 121) {
                    _syntax_only = 1;
                }
            }
        }
        # "--al" (--allow-undef, v6.3.2) — downgrade the default reachable-undef hard error to a warning. chars a(97) l(108).
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 97 && load8(&_vbuf + _vi + 3) == 108) {
                    _allow_undef = 1;
                }
            }
        }
        # Skip to next arg (past next \0)
        while (_vi < _vn && load8(&_vbuf + _vi) != 0) { _vi = _vi + 1; }
        _vi = _vi + 1;
    }
}
#endif

# v6.0.54: the Windows command-line path. GetCommandLineW returns
# ONE UTF-16LE string (program path + args, space-separated, NOT NUL-split),
# so we walk it char-by-char (2 bytes each, ASCII low byte) and, at each
# token start (string start or just after an unquoted space), test the
# first four chars for "--ve" (--version → print + exit), "--sy" or "--al"
# (set the flag). Reading +6 max stays inside the kernel-owned,
# double-NUL-terminated buffer. ASCII-only, like lib/args_win.cyr; a path
# containing "--version" mid-token is not at a token start, so no false hit.
#ifdef CYRIUS_TARGET_WIN
var _vw = syscall(61446);              # GetCommandLineW → UTF-16LE LPWSTR in rax
if (_vw != 0) {
    var _wi = 0;
    var _wtok = 1;                     # at a token start (start-of-string counts)
    var _wdone = 0;
    var _wc = 0;
    var _whi = 0;
    while (_wdone == 0) {
        _wc = load8(_vw + _wi);        # low byte of the wide char (ASCII)
        _whi = load8(_vw + _wi + 1);   # high byte
        # double-NUL terminates; a U+xx00 char (low 0, high != 0) is NOT the end.
        if (_wc == 0) { if (_whi == 0) { _wdone = 1; } }
        if (_wdone == 0) {
            if (_wc == 32) {
                _wtok = 1;             # unquoted space → next char starts a token
            } else {
                if (_wtok == 1) {
                    if (load8(_vw + _wi) == 45) {
                        if (load8(_vw + _wi + 2) == 45) {
                            if (load8(_vw + _wi + 4) == 118) {
                                if (load8(_vw + _wi + 6) == 101) {
                                    _write_out_all(_VERSION_STR_CYCC_WIN, _VERSION_LEN_CYCC_WIN);
                                    syscall(SYS_EXIT, 0);
                                }
                            }
                            if (load8(_vw + _wi + 4) == 115) {
                                # "--sy" (--syntax-only, 6.6.17): UTF-16 s(115) y(121)
                                if (load8(_vw + _wi + 6) == 121) {
                                    _syntax_only = 1;
                                }
                            }
                            # "--al" (--allow-undef, v6.3.2): UTF-16 a(97) l(108)
                            if (load8(_vw + _wi + 4) == 97) {
                                if (load8(_vw + _wi + 6) == 108) {
                                    _allow_undef = 1;
                                }
                            }
                        }
                    }
                    _wtok = 0;
                }
            }
            _wi = _wi + 2;
        }
    }
}
#endif

# Allocate heap.
# Windows has no brk (the Linux-style `syscall(SYS_BRK, 0)` / extend
# pattern crashes with STATUS_ACCESS_VIOLATION on PE because SYS_BRK
# isn't rerouted). v5.5.8: use SYS_MMAP which works on both paths of
# this file's build chain:
#   - cycc (Linux) compiles main_win.cyr → cycc_win (Linux ELF):
#     heap init runs on Linux, calls mmap(0, <arena>, PROT_RW=3,
#     MAP_PRIVATE|MAP_ANONYMOUS=0x22, -1, 0) → valid region.
#   - cycc_win compiles main_win.cyr → cycc_win.exe (PE):
#     heap init runs on Windows, PE backend (v5.5.1) routes to
#     VirtualAlloc(0, <arena>, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE).
#     The prot/flags/fd/offset are ignored by EMMAP_PE.
# <arena> is 0xF600000 (246 MiB): the brk-final line of src/main.cyr's heap
# map, the arena end every driver requests. (This block quoted "32 MB" and then
# "0x5F00000 (95 MB)" until 6.6.20; both were sizes of layouts long gone.) PE
# EMMAP routes via VirtualAlloc with prot/flags ignored.
var S = syscall(SYS_MMAP, 0, 0xF600000, 3, 0x22, 0 - 1, 0);   # v6.3.28: +IR arrays @ arena top (0x5E9D000..0x729D000); v6.4.21: +512 KB lexid_entries @ 0xF400000 (LEXID cap 16384→65536)
# 6.6.20: CHECKED — the Linux host stage's mmap returns -errno and VirtualAlloc returns 0 when
# refused (ulimit -v / -d on Linux); cycc then died on its first heap store with no message.
# CHANGELOG [6.6.20]
if (S < 0x100000) {
    syscall(SYS_WRITE, 2, "error: cannot map the 246 MiB compiler arena (mmap / VirtualAlloc refused it; check ulimit -v / ulimit -d)\n", 107);
    syscall(SYS_EXIT, 1);
}

# Zero scratch state (v5.8.63 extraction; see src/common/util.cyr for slot list)
_HEAP_INIT_SCRATCH(S);

# v6.0.7 — init alloc and assign rp_vec (return-patch storage).
alloc_init();
rp_vec = vec_new();
# The region bases + caps, shared by six drivers. CHANGELOG [6.6.20]
include "src/common/heap_regions.cyr"

# Read input. Buffer is 256KB (v3.4.19, was 128KB before). If the source ever
# fills the whole buffer, we error out explicitly instead of silently truncating
# — the old silent cap at 131072 bytes masked the mabda 141KB bundle failure as
# a random "unexpected end of file" at token ~3719.
var bl = 0;
var done = 0;
while (done == 0) {
    var n = syscall(SYS_READ, 0, S + _SRCB + bl, _SRC_CAP - bl);
    if (n <= 0) { done = 1; }
    else {
        bl = bl + n;
        if (bl >= _SRC_CAP) {
            # One more read to distinguish "exactly 256KB" from "more coming"
            var probe[1];
            var pn = syscall(SYS_READ, 0, &probe, 1);
            if (pn > 0) {
                syscall(SYS_WRITE, 2, "error: input exceeds the 24MB source buffer
", 44);
                syscall(SYS_EXIT, 1);
            }
            done = 1;
        }
    }
}
SBL(S, bl);

# Init stdlib fallback path from HOME env
_init_cyrius_lib();

# Register compiler-builtin arch marker so lib files can `#ifdef
# CYRIUS_ARCH_X86` to select x86-specific asm over aarch64 asm.
PP_PREDEFINE(S, "CYRIUS_ARCH_X86");
var _poison_env_early = _read_env("CYRIUS_POISON");
# v6.5.29 — CYRIUS_POISON: opt-in allocator poison mode (redzones, poison fill,
# quarantine-on-free) so an out-of-bounds READ or a use-after-free is OBSERVABLE to
# `cyrius fuzz`. Filed by sit after a heap disclosure its fuzz suite ran past for three
# minor versions: the read landed in mapped memory, so there was no fault to catch.
# A COMPILE-TIME predefine, not a runtime env read — `lib/freelist.cyr` deliberately
# depends on mmap + atomic only, and an allocator should not be parsing the environment.
# Costs nothing when off. Set on all SEVEN forks, because a fuzz mode that exists only on
# x86-Linux tells three other platforms' consumers nothing.
if (_poison_env_early != 0) { PP_PREDEFINE(S, "CYRIUS_POISON"); }
# v5.5.0: cycc_win also defines CYRIUS_TARGET_WIN so stdlib can
# `#ifdef CYRIUS_TARGET_WIN` to select Windows-shaped includes
# (syscalls_windows.cyr + alloc_windows.cyr) instead of the
# Linux peers that ship by default on the x86 branch.
PP_PREDEFINE(S, "CYRIUS_TARGET_WIN");
# v5.11.52: under CYRIUS_TARGET_EFI=1 (UEFI Application output), also
# predefine CYRIUS_TARGET_EFI so consumers can target-discriminate
# UEFI vs Windows-CUI at preprocessor time. EFI and Windows share MS
# x64 ABI + PE32+ container; the lib/fnptr.cyr MS-x64 branches fire
# under CYRIUS_TARGET_WIN regardless.
var _efi_env_early_w = _read_env("CYRIUS_TARGET_EFI");
if (_efi_env_early_w != 0) {
    if (load8(_efi_env_early_w) == 49 && load8(_efi_env_early_w + 1) == 0) {
        PP_PREDEFINE(S, "CYRIUS_TARGET_EFI");
    }
}
# v6.4.31: Win64 PE now supports the f64v2/f64v4/f32v4 (+ integer vector)
# value-form param & return ABI (MS x64 by-pointer params in an int arg reg
# + retptr-style return). lib/simd.cyr gates its value-form typed wrappers on
# this flag; before .31 PE skipped them and only the pointer-form `_ptr`
# siblings worked. See [[project_v6431_win64_valueform_simd]].
PP_PREDEFINE(S, "CYRIUS_HAS_VAL_SIMD_PARAMS");

# Preprocess includes
PREPROCESS(S);

# Re-init the compiler scalars so every one starts fresh before LEX runs (the same
# slots _HEAP_INIT_SCRATCH zeroes, util.cyr). Written when input_buf sat at S+0 and
# the #ifdef copy-back of a >256 KB expansion ran through every heap region up to
# S+bl; since v6.5.39 input_buf is at S + 0x7400000 with the preprocess_out cap,
# so the copy-back stays inside it and this is now a plain reset after PREPROCESS.
S64(S + 0x18FCC8, 0);       # str_pos (moved from 0x70000 in 4.6.2)
S64(S + 0x18FCD0, 0);       # data_size (moved from 0x70008 in 4.6.2)
S64(S + 0x18C108, 0);       # CP
S64(S + 0x18C110, 0);       # VCNT
S64(S + 0x18C118, 0);       # TCNT
S64(S + 0x18C120, 0);       # TI
S64(S + 0x18C128, 0);       # NPOS
S64(S + 0x18FCA8, 0);       # fixup_cnt
S64(S + 0x18FCB0, 0 - 1);   # last_var
S64(S + 0x18DA00, 0);       # fn_count
S64(S + 0x18DA08, 0);       # in_fn
S64(S + 0x18DA10, 0);       # local_cnt
S64(S + 0x18F830, 0);       # struct_count
S64(S + 0x18F888, 0);       # extra_patch_cnt
S64(S + 0x18FCA0, 0);       # kernel_mode
S64(S + 0x18FCB8, 1);       # cur_line (starts at 1)
S64(S + 0x18FCC0, 0);       # scope_depth
S64(S + 0x1903D8, 0);       # expr_stype
S64(S + 0x1903E8, 0);       # inline_depth
S64(S + 0x1903F0, 0);       # expr_width
S64(S + 0x18F898, 0);       # continue_mode
S64(S + 0x18FEC8, 0);       # current_module
S64(S + 0x1903D0, 0);       # use_count
S64(S + 0x19A000, 0);       # gvar_cnt
S64(S + 0x197F00, 0);       # include_count

# Build file map from #@file markers (for file:line error messages)
FM_BUILD(S);

# Lex
LEX(S);


# Emit initial jmp over fn bodies
EB(S, 0xE9);
var jmp_patch = GCP(S);
EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);
# ⛔ v6.5.68: THIS disp32 IS IN NO REGISTRY UNLESS IT IS PUT THERE. It is hand-emitted
# raw rather than through EJMP0, so the per-fn compactor never saw it either — it simply
# never mattered, because that pass only ever deleted bytes INSIDE one function and this
# jump's source and target both sit outside every function body. The whole-program pass
# deletes across the entire buffer, and a single unrepaired 5-byte deletion below the
# target makes cycc SIGSEGV at its own pre-compaction entry address.
_wpjs_add_raw(S, jmp_patch);

# v6.3.39 (Windows monomorph parity): read CYRIUS_MONOMORPH BEFORE pass-1 (pass-1
# captures generic structs' GSTP type-param encoding only when _MONOMORPH_OK==1; the
# v6.3.33 fix landed in main.cyr only). Default (env unset) → byte-identical.
var _mono_env = _read_env("CYRIUS_MONOMORPH");
if (_mono_env != 0) {
    if (load8(_mono_env) == 48 && load8(_mono_env + 1) == 0) {
        _MONOMORPH_OK = 0;
    }
}

# 6.6.17 — the TARGET flags are read BEFORE pass 1: `_prescan_params` records each fn's
# parameter shapes by `_TARGET_PE` (a Win64 vector parameter is passed by address), so with the
# flag set after pass 1 a forward call to a vector-param fn was marshalled SysV-style and the PE
# callee faulted. tests/tcyr/crossos/vector_param_forward_call.tcyr. CHANGELOG [6.6.17]
# Mach-O output via CYRIUS_MACHO=1 (x86_64) or CYRIUS_MACHO_ARM=1 (ARM64)
var _macho_env = _read_env("CYRIUS_MACHO");
if (_macho_env != 0) {
    if (load8(_macho_env) == 49 && load8(_macho_env + 1) == 0) {
        _TARGET_MACHO = 1;
    }
}
var _macho_arm_env = _read_env("CYRIUS_MACHO_ARM");
if (_macho_arm_env != 0) {
    if (load8(_macho_arm_env) == 49 && load8(_macho_arm_env + 1) == 0) {
        _TARGET_MACHO = 2;
    }
}

# PE32+ output is the DEFAULT for cycc_win (this file). CYRIUS_TARGET_WIN=0
# opts out and emits ELF instead (rare — use cycc for ELF).
_TARGET_PE = 1;
var _pe_env = _read_env("CYRIUS_TARGET_WIN");
if (_pe_env != 0) {
    if (load8(_pe_env) == 48 && load8(_pe_env + 1) == 0) {
        _TARGET_PE = 0;
    }
}

# UEFI Application output via CYRIUS_TARGET_EFI=1 (v5.11.47). Same
# PE32+ container, MS x64 ABI, and .reloc as the Windows path —
# Subsystem byte flips 3 → 0xA (IMAGE_SUBSYSTEM_EFI_APPLICATION), no
# kernel32 imports, EEXIT emits `ret` instead of ExitProcess IAT
# call. Unblocks gnoboot (AGNOS sovereign UEFI bootloader) — see
# docs/development/issues/archived/2026-05-13-gnoboot-uefi-application-emit.md.
var _efi_env = _read_env("CYRIUS_TARGET_EFI");
if (_efi_env != 0) {
    if (load8(_efi_env) == 49 && load8(_efi_env + 1) == 0) {
        _TARGET_PE = 1;
        _TARGET_EFI_APPLICATION = 1;
    }
}


# Pass 1: Pre-scan to register all global vars and structs (no fn bodies)
_tl_pass1(S, 1);   # 6.6.17: the ONE pass-1 scan, shared by every fork (src/frontend/parse_fn.cyr)

# v6.5.17 — the DCE pre-scan referenced-name bitmap is GONE with the parse-time
# body skip it fed. See src/main.cyr for the full note.

# cycc: opt-in IR recording via CYRIUS_IR=1|2
var _ir_env = _read_env("CYRIUS_IR");
if (_ir_env != 0) {
    var _ir_ch = load8(_ir_env);
    if (_ir_ch >= 49 && _ir_ch <= 51) {
        IR_SENABLE(S, 1);
        ir_reset(S);
    }
}

# v6.3.5 AR-01 — monomorphization opt-in is now read BEFORE pass-1 (v6.3.39 Windows
# parity). This site retired.

# Pass 2: Parse struct and fn definitions (vars already registered)
_tl_pass2(S, 1);   # 6.6.17: the ONE pass-2 dispatch, shared by every fork

# Patch jmp to land here (start of main code)
EPATCH(S, jmp_patch);

# 6.6.5 — the Win64/UEFI entry alignment seed. Windows enters the image with the return
# address pushed (rsp ≡ 8), Linux does not; without these 4 bytes the whole PE base runs one
# parity off and every statement-level call enters its callee misaligned. MUST stay
# byte-identical to src/main.cyr's landing (cross-compiled cycc_win == native cycc_win), and
# MUST ship together with the retuned fixed-frame reroutes in src/backend/x86/emit.cyr
# (`_pe_fixed_frame`) — the seed alone is what "destabilised cycc" at v6.0.71.
# CHANGELOG [6.6.5]
#
# ⛔ Under UEFI, park the entry rsp in r13 FIRST — EEXIT returns to firmware with
# `mov rsp, r13; ret`, which is correct at any call depth where a bare `ret` is not.
# MUST stay byte-identical to src/main.cyr's landing — which is why both call the same
# EPARK_EFI_RSP helper rather than open-coding the bytes twice. CHANGELOG [6.6.5]
if (_TARGET_EFI_APPLICATION == 1) { EPARK_EFI_RSP(S); }   # lea r13, [rsp]  (4C 8D 2C 24)
if (_TARGET_PE == 1) { ESUB_RSP_IMM8(S, 8); }

# In object mode AND shared mode, wrap top-level code as a callable
# function (_cyrius_init). Object mode: linked binaries call it after
# symbol merge. Shared mode: dynamic loader calls it via DT_INIT on
# dlopen — this is how `var x = 100;` initializers actually run.
var _cyrius_init_offset = GCP(S);
S64(S + 0x1903F8, _cyrius_init_offset);
var _init_km = L64(S + 0x18FCA0);
if (_init_km == 3 || _init_km == 2) {
    EFNPRO(S);               # push rbp; mov rbp, rsp
    # Allocate generous stack frame for top-level init code (4096 bytes = 512 locals)
    E3(S, 0xEC8148);          # sub rsp, imm32
    EB(S, 0x00); EB(S, 0x10); EB(S, 0x00); EB(S, 0x00);  # 0x1000 = 4096 bytes
    # 6.6.5: object/shared mode never returns to firmware (EFNEPI to a linked caller, whose
    # `push rbp` above already re-aligned); EEXIT reads kmode itself. Mirror of
    # src/main.cyr. CHANGELOG [6.6.5]
}

# Emit enum initializations FIRST (before gvar inits, since gvar inits may call
# functions that reference enum values)
var gvar_save_ti = GTI(S);
_tl_enum_inits(S);
# Emit deferred global var initializations
EMIT_GVAR_INITS(S);
STI(S, gvar_save_ti);

# 6.6.5 — ONE shared emitter (src/frontend/parse_fn.cyr). Three forks carried this loop
# inline and it needed a fix in all three: pass 1 now prescans relaxed-ordering fns, which
# PARSE_PROG defines BELOW this point, so an un-guarded loop warns about every one of them.
_warn_undefined_prepass(S);

# Parse main code (top-level statements)
PARSE_PROG(S);

# Exit epilogue
var lv = GLVAR(S);
if (lv >= 0) { EVLOAD(S, lv); }

# v6.0.54: auto-call `main()` if defined and not already called — port of
# main.cyr's v5.9.37 fix (the WIN driver lacked it, so a source with only
# `fn main() { ... }` and no explicit `syscall(60, main())` wire ran the
# gvar inits + parse-prog and exited with rax=junk; main never ran). Must
# run AFTER the GLVAR-load above — that load clobbers main's rax return.
# Pairs with the `dce_is_main` exemption in the DCE block above (without it
# DCE would stub main to `xor eax,eax; ret`). See CHANGELOG [5.9.37]/[6.0.54].
var _epi_km_pre = L64(S + 0x18FCA0);
if (_epi_km_pre == 0) {
    var _main_found = _find_fn_by_name(S, "main", 4);
    if (_main_found >= 0) {
        var _main_off = L64(_fnt_offsets + _main_found * 8);
        if (_main_off >= 0) {
            ECALLTO(S, _main_off);
        }
    }
}
var _epi_km = L64(S + 0x18FCA0);
if (_epi_km == 3 || _epi_km == 2) {
    # Object / shared mode: return from _cyrius_init (leave; ret).
    # Shared mode uses this as the DT_INIT target.
    EFNEPI(S);
} else {
    # Executable mode: exit via syscall(60, exit_code)
    EEXIT(S);
}

# cycc: IR stats/dump
if (IR_ENABLED(S) == 1) {
    var ir_bbs = ir_build_bbs(S);
    var ir_edges = ir_build_edges(S);
    var ir_lase_n = ir_lase(S);
    # LASE/DBE codebuf patching disabled — IR doesn't capture all emit
    # calls. NOP-filling an IR node's CP range can destroy adjacent
    # non-IR code. Analysis-only until ALL emission goes through IR.
    var ir_lase_bytes = 0;
    var ir_dbe_bytes = 0;
    # DBE disabled — IR doesn't capture all emit calls (EB/E2/E3 direct,
    # EEXIT, ESTOREPARM, etc. are not instrumented). NOP-filling a BB's
    # CP range can destroy non-IR code. Safe only after ALL emission goes
    # through IR. Tracked for beta.
    # if (load8(_ir_env) == 51) { ir_dbe_bytes = ir_dead_block_elim(S); }
    syscall(SYS_WRITE, 2, "ir: ", 4);
    PRNUM(IR_NCNT(S));
    syscall(SYS_WRITE, 2, " nodes, ", 8);
    PRNUM(ir_bbs);
    syscall(SYS_WRITE, 2, " BBs, ", 6);
    PRNUM(ir_edges);
    syscall(SYS_WRITE, 2, " edges, ", 8);
    PRNUM(ir_lase_n);
    syscall(SYS_WRITE, 2, " LASE", 5);
    if (ir_dbe_bytes > 0) {
        syscall(SYS_WRITE, 2, ", ", 2);
        PRNUM(ir_dbe_bytes);
        syscall(SYS_WRITE, 2, "B DBE", 5);
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    # CYRIUS_IR=2: verbose dump
    if (load8(_ir_env) == 50) { ir_dump(S); }
}

# Fixup + ELF + write
FIXUP(S);
# v4.8.3-alpha1: capacity meter — opt-in via CYRIUS_STATS=1.
# Bote and other consumer projects hit silent capacity walls (fn
# table, identifier buffer); this exposes utilization at compile
# time so refactors can size themselves.
var _stats_env = _read_env("CYRIUS_STATS");
if (_stats_env != 0) {
    if (load8(_stats_env) == 49 && load8(_stats_env + 1) == 0) {
        syscall(SYS_WRITE, 2, "cyrius stats:\n", 14);
        syscall(SYS_WRITE, 2, "  fn_table:    ", 15); PRNUM(GFNC(S));
        syscall(SYS_WRITE, 2, " / 131072\n",      10);   # v6.4.75: hard ceiling (_fnt_grow max), was a stale 8192
        syscall(SYS_WRITE, 2, "  identifiers: ", 15); PRNUM(GNPOS(S));
        syscall(SYS_WRITE, 2, " / 8388608\n",    11);   # v6.5.40: pool 512 KB → 8 MB (was a STALE 524288 — CI caught it reporting 200751/524288 against a live 8 MB pool)
        syscall(SYS_WRITE, 2, "  var_table:   ", 15); PRNUM(GVCNT(S));
        # ⛔ v6.5.40: 8192 was the INITIAL _var_cap, not the ceiling. `_var_grow` doubles it and
        # refuses only past 1048576 (util.cyr:109), so this meter over-reported utilization by
        # up to 128x — a project with 20,000 globals read as 244 % while being perfectly fine.
        # THIRD occurrence of a stale denominator in this one block: code_size showed 269 % for
        # the same reason until v6.4.73, identifiers was stale until v6.5.40, this was latent.
        # `tests/gates/memory/capacity_meter_denominators.sh` now derives all six from the caps.
        syscall(SYS_WRITE, 2, " / 1048576\n",    11);
        syscall(SYS_WRITE, 2, "  fixup_table: ", 15); PRNUM(GFCNT(S));
        syscall(SYS_WRITE, 2, " / 1048576\n",       11);
        syscall(SYS_WRITE, 2, "  string_data: ", 15); PRNUM(GSPOS(S));
        syscall(SYS_WRITE, 2, " / 2097152\n",    11);
        syscall(SYS_WRITE, 2, "  code_size:   ", 15); PRNUM(GCP(S));
        # v6.4.73: 67108864, was a stale 1048576 (see src/main.cyr — the codebuf
        # became the 64 MiB growable off-heap region at v6.4.49; this meter's
        # denominator was never brought along, so it reported >100 % as normal).
        syscall(SYS_WRITE, 2, " / 67108864\n",   12);
        _fnhash_health(S);
    }
}
# v4.8.3-alpha2: soft capacity warnings. Shared across all 7 drivers via
# _capacity_warnings (util.cyr) since v6.4.50; 64 MiB growable codebuf here.
_capacity_warnings(S, 67108864, 1);
EMITELF(S);
# Write ELF output (loop on partial writes)
# v6.6.6 — the loop that used to sit here stopped on the first failing `write` and
# then exited 0 with a TRUNCATED image. _write_out_all (src/common/util.cyr) is the
# same loop plus the comparison it was missing, shared by every fork so the check
# cannot be present in one and absent in the rest. CHANGELOG [6.6.6]
var olen = L64(S + 0x1903F8);
_write_out_all(_output_base, olen);
syscall(SYS_EXIT, _had_error);   # v6.4.62: DX multi-error — exit 1 when errors were reported
