# ================================================================
# Cyrius Compiler v2 — Modular Self-Hosting Compiler
# ================================================================
# Same language as cc.cyr, split into modules using include.
# Compiled by cc (cybs's extended language).
#
# Build: cat src/main.cyr | ./build/cycc > /tmp/cycc && chmod +x /tmp/cycc
# Self-host: cat src/main.cyr | /tmp/cycc > /tmp/cc5b && cmp /tmp/cycc /tmp/cc5b
# ================================================================
# HEAP MAP — Authoritative offset registry (v3.6.10)
# ================================================================
# Check here FIRST before allocating new state.
# Last full audit: v3.6.10. Verified by tests/heapmap.sh (47 regions, 0 warnings).
#
# --- Low heap: I/O + identifiers ---
#   0x00000  input_buf     [1048576]      1MB raw stdin input (v3.6.7, was 256KB)
#                                         NOTE: input_buf extends past 0x60000 (tok_names).
#                                         tok_names is REBUILT by LEX after preprocessing —
#                                         the overlap is tolerated because preprocessing reads
#                                         from 0x459D000, not S+0.
#   0x60000  tok_names     [262144]      256KB packed identifier strings (nested in input_buf — rebuilt by LEX, v4.6.2 was 64KB, v5.11.18 doubled 128KB → 256KB)
#
# --- Struct tables (v3.6.6: expanded to 64 structs) ---
#   0x18E630  struct_names  [2048]        256 struct name offsets (cap 256, v5.7.17)
#   0x18EE30  struct_fcounts[2048]        256 struct field counts (bit 63 = union; relocated v5.7.17)
#   0x18F830  struct_count  [8]
#
# --- Compiler state (scalars) ---
#   0x18C100  BL,CP,VCNT,TCNT,TI,NPOS    6 × 8 bytes
#   0x18DA00  fn_count, in_fn, local_cnt
#   0x18DA20  (FREED v6.0.88)             was ret_patches [2048] — migrated to rp_vec @ v6.0.7
#   0x18E220  (FREED v6.0.88)             was ret_patch_cnt [8]
#   0x18F838  loop_top      [8]
#   0x18F840  break_patch   [8]
#   0x18F848  extra_patches [64]          8 && condition patches
#   0x18F888  extra_patch_cnt [8]
#   0x18F890  ptr_scale     [8]
#   0x18F898  continue_count [8]
#   0x18F8A0  continue_patches [64]       8 continue forward-patches
#   0x18F900  defer_count   [8]           deferred blocks per function (max 8)
#   0x18F908  defer_addrs   [64]          8 deferred block code offsets (LIFO)
#   0x18FCA0  kernel_mode   [8]
#   0x18FCA8  fixup_cnt     [8]
#   0x18FCB0  last_var      [8]
#   0x18FCB8  cur_line      [8]
#   0x18FCC0  scope_depth   [8]
#   0x18FCC8  str_pos       [8]           string write position (moved from 0x70000 in v4.6.2)
#   0x18FCD0  data_size     [8]           total variable data bytes (moved from 0x70008 in v4.6.2)
#   0x18FEC8  current_module [8]
#   0x18FED0  pub_flags     [256]
#   0x18FFD0  use_from      [512]         64 use alias source names
#   0x1901D0  use_to        [512]         64 use alias target names
#   0x1903D0  use_count     [8]
#   0x1903D8  expr_stype    [8]
#   0x1903E0  expr_var      [8]
#   0x1903E8  inline_depth  [8]
#   0x1903F0  expr_width    [8]
#   0x1903F8  init_offset / elf_out_len [8]  (dual-use: init_offset pre-FIXUP, elf_out_len post-FIXUP)
#   0x198000  (FREED v6.3.41)             was gvar_toks[8192]=1024 → relocated+grown to 0x729000[32768]=4096
#   0x729000  gvar_toks     [32768]       4096 deferred global var inits (v6.3.41; count stays at 0x19A000)
#   0x19A000  gvar_cnt      [8]
#   0x71A000  file_map_cnt  [8]           file:line error map entry count (v6.1.35: relocated from 0x19A100)
#   0x71A040  file_map      [24576]       1024 entries × 24 B (start_line, line_count, fname_offset);
#                                         CVE-31 cap 128→1024, relocated from 0x19A108 into the freed
#                                         0x71A000 band (the .27 output_buf gap, below TS@0x800000)
#   0x721000  file_map_str  [32768]       filename string scratch (v6.1.35: relocated from 0x19D000[4096])
#   (0x19A100/0x19A108/0x19D000 now FREE — reclaimed by the v6.1.35 file_map move)
#
# --- Preprocessor + local var state ---
#   0x190500  include_fname [256]         preprocessor filename scratch
#   0x191000  fn_local_names              local variable names
#   0x191800  local_depths  [512]         scope depths per local
#   0x192000  macro tables                16 macros (names, offsets, bodies)
#   0x192200  local_types                 local variable type tracking
#
# --- Function tables (relocated v4.7.1 — caps raised 2048 → 4096) ---
#   0x1A0000  jump_src + nop_run + fn_start_fcnt (v5.6.27)
#   0x9BA000 fn_names      [32768]       4096 function name offsets
#   0x9CA000 fn_offsets    [32768]       4096 function code offsets
#   0x9DA000 fn_params     [32768]       4096 function param counts
#   0x9EA000 fn_body_start [32768]       4096 inline body start
#   0x9FA000 fn_body_end   [32768]       4096 inline body end
#   0xA0A000 fn_inline     [32768]       4096 inline flags
#   0xA1A000 fn_param_str_mask [32768]   4096 Str-param bitmasks (v3.6.0)
#   0xA2A000 fn_code_end   [32768]       4096 fn code END offsets (v4.4.0)
# These fn-metadata tables sit at 0xA1A000/0xA2A000, BELOW the runtime
# fixup_tbl base (0x107B000). The fixup_tbl is GROWABLE as of v6.2.0
# (Phase 0 / AR-03): initial 1048576 × 16 B = 16 MiB at 0x107B000, then
# _fixup_grow doubles it off the heap — see runtime.cyr RECFIX.
#
# --- Reclaimable / scratch ---
#   0x1C0000  include_fnames[32768]       256 include-once filenames × 128 B (v4.8.4-alpha2)
#   0x14A000  fn_regalloc   [65536]       8192 per-fn #regalloc flags (v4.8.4-alpha4; v5.11.19 doubled + relocated)
#   0x1D8000  enum_const_val[8192]        1024 slots × 8 B — PARSE_ENUM_DEF
#                                        stores (1<<63)|val per variant; read
#                                        by PARSE_FACTOR to const-fold enum
#                                        identifiers at parse time (v5.5.2)
#   0x1DA000  DCE bitmap    [8192]        dead-code-elimination scratch (pass 2 only)
#
# --- Variable tables ---
#   0x11A000 var_noffs     [65536]       8192 variable name offsets
#   0x12A000 var_sizes     [65536]       8192 variable sizes
#   0x13A000 var_types     [65536]       8192 variable type IDs
#
# --- Relocated string data (v3.6.7) ---
#   0x14A000 (free band — was str_data pre-v5.8.59; see main.cyr for full lineage)
#   0x21A000 str_data      [2097152]     2MB string literal bytes (v5.8.61 monotonic — see main.cyr)
#
# --- Large buffers ---
#   (2 MB freed gap retired v5.11.68 — was preprocess_out [2097152] pre-v5.11.32,
#                                        relocated to 0x459D000 at v5.11.33 +
#                                        cap raised 2 MB → 8 MB. The 2 MB hole was
#                                        absorbed by v5.11.68's full heap-map reorg.)
#   0x41A000 codebuf       [3145728]     3MB generated machine code (v5.7.27)
#   0x4D9D000 output_buf    [16777216]   16MB ELF output — RELOCATED to heap-top from 0x71A000 (2MB→16MB) @ v6.1.27 phylax binary-cap (v3.5.2)
#   (tok arrays RETIRED here v5.8.46 — see main.cyr for canonical layout;
#    relocated to 0x2D7C000 / 0x357C000 / 0x3D7C000 with cap 1048576)
#
# --- Token arrays (v3.6.2 layout RETIRED v5.8.46) ---
#   (was 0xB4A000 tok_types — code overlapped tok_types with output_buf at 0x4D9D000)
#   (was 0xD4A000 tok_values [2097152] 262144 entries × 8 bytes)
#   (was 0xF4A000 tok_lines  [2097152] 262144 entries × 8 bytes)
#   See main.cyr for the new layout (high block at 0x2D7C000, cap 1048576).
#
# --- Relocated struct field tables (v3.6.6) ---
#   0x91A000 struct_ftypes [16384]       64 structs × 32 fields × 8 bytes
#   0x92A000 struct_fnames [16384]       64 structs × 32 fields × 8 bytes
#
#   0x93A000 (fixup table: 16384 entries × 16 bytes ends at 0x9BA000)
#
# --- cycc IR region (v5.0.0) ---
#   0xA3A000 ir_nodes      [4194304]     262144 IR nodes × 16 bytes
#   0xE3A000 ir_blocks    [1048576]     32768 basic blocks × 32 bytes
#   0xF3A000 ir_state     [4096]        IR builder state (counters, current BB)
#   0xF3B000 ir_edges     [262144]      32768 CFG edges × 8 bytes
#   0xF7B000 ir_cp        [1048576]     262144 node CP offsets × 4 bytes
#
#
# --- LEXID dedup index (v5.10.40) ---
#   0x457C000  lexid_count   [8]
#   0x457C100  lexid_heads   [2048]
#   0x457C900  lexid_entries [131072]
#   (Full doc in src/main.cyr §LEXID_DEDUP)
#
#   0x459D000 preprocess_out [8388608]   8 MB expanded source buffer.
#                                        Relocated here from 0x44A000 at v5.11.33
#                                        + cap raised 2 MB → 8 MB. See
#                                        CHANGELOG [5.11.33].
#   0x5D9D000 local tables (CVE-24 v6.1.40) 4×128 KB per-fn slot-indexed tables → end 0x5E1D000 (the
#                                        0x5F00000 VirtualAlloc below already covers them)
#   0x5E1D000 brk-equivalent              ~94.1 MB (+512 KB local-table relocation @ v6.1.40;
#                                        +16MB output_buf @ v6.1.27). 0x5F00000 VirtualAlloc (95 MB,
#                                        ~908 KB headroom) covers it. v5.11.68 grew this from
#                                        0x459D000 / 78.6 MB at v5.10.40 by the
#                                        8 MB preprocess_out relocation;
#                                        v5.10.40 grew from 0x457C000 / 78.5 MB
#                                        at v5.8.61 by 132 KB LEXID dedup; was
#                                        0x5100000 at .59-.60 / 0x5000000 /
#                                        0x298B000.
#
# Token types:
#   1=NUM 2=IDENT 3=VAR 4=EQ 5=SEMI 6=PLUS 7=MINUS 8=STAR 9=SLASH
#   10=LPAREN 11=RPAREN 12=EOF 13=LBRACE 14=RBRACE 15=IF 16=WHILE
#   17=EQEQ 18=NEQ 19=LT 20=GT 21=LTE 22=GTE 23=ELSE
#   24=SYSCALL 25=LOAD8 26=STORE8 27=AMPERSAND 28=LBRACKET 29=RBRACKET
#   30=STRING 31=COMMA 32=FN 33=RETURN 34=PERCENT 35=PIPE 36=CARET
#   37=TILDE 38=SHL 39=SHR 40=STRUCT 41=DOT 42=LOAD16 43=LOAD32
#   44=LOAD64 45=STORE16 46=STORE32 47=STORE64 48=ASM 49=COLON
#   50=ELIF 51=BREAK 52=CONTINUE 53=AND 54=OR 55=FOR 56=KERNEL 57=SWITCH 58=CASE 59=DEFAULT 60=ENUM
#   61=FLOAT 62=F64ADD 63=F64SUB 64=F64MUL 65=F64DIV 66=F64FROM 67=F64TO
#   68=F64EQ 69=F64LT 70=F64GT 71=F64NEG
#   72=MOD 73=PUB 74=USE 75=MATCH 76=IN 77=IMPL
#   97=RET2 98=RETHI 99=F64ATAN 100=SIZEOF


# x86_64 syscall number constants (used by shared cc/ modules)
enum Sys { SYS_READ = 0; SYS_WRITE = 1; SYS_OPEN = 2; SYS_CLOSE = 3; SYS_MMAP = 9; SYS_BRK = 12; SYS_EXIT = 60; }

# v5.6.39: shared auto-generated version string (see src/version_str.cyr).
include "src/version_str.cyr"

# ================================================================
# MODULES
# ================================================================
include "src/common/util.cyr"
# v6.0.8 — shared backend helpers (see src/main.cyr).
include "src/backend/common/tokens.cyr"
include "src/backend/common/runtime.cyr"
include "src/backend/x86/emit.cyr"
include "src/backend/x86/float.cyr"
include "src/backend/x86/jump.cyr"
include "src/backend/x86/decode.cyr"
include "src/common/ir.cyr"
include "src/frontend/lex.cyr"

# v6.0.7 — alloc + vec for return-patch vec storage. Must precede
# parse.cyr so converted call sites resolve at parse time. The PE
# build pre-defines CYRIUS_TARGET_WIN so alloc.cyr routes to
# alloc_windows.cyr (VirtualAlloc) instead of brk.
include "lib/alloc.cyr"
include "lib/vec.cyr"
var rp_vec = 0;

include "src/frontend/parse.cyr"
include "src/backend/macho/emit.cyr"
include "src/backend/pe/emit.cyr"
include "src/backend/x86/fixup.cyr"

# ================================================================
# MAIN
# ================================================================

# --version + --strict parsing (v5.4.19): read /proc/self/cmdline.
# --strict sets _strict_mode = 1, which fixup.cyr reads to decide
# whether undefined-function warnings should hard-fail the compile
# (vs the default: warn and continue into a known-to-crash binary).
var _strict_mode = 0;
var _allow_undef = 0;   # v6.3.2: --allow-undef downgrades the now-default reachable-undef hard error (x86/fixup.cyr gates on `_allow_undef == 0`)
var _vbuf[256];
var _vfd = 0;
# v5.5.9: --version / --strict parsing uses /proc/self/cmdline, a
# Linux-only pseudofile. On Windows this CreateFileW returns
# INVALID_HANDLE_VALUE and subsequent ReadFile on the bad handle
# crashes cycc_win.exe at startup. Gate the whole block on
# CYRIUS_TARGET_LINUX so cycc_win.exe (built by cc5_win_linux with
# CYRIUS_TARGET_WIN predefined at runtime) skips it entirely.
# v6.0.54: the Windows equivalent below uses GetCommandLineW (the
# `syscall(0xF006)` PE reroute, src/backend/x86/emit.cyr) — the
# "GetCommandLineW-based replacement" the prior comment queued.
#ifdef CYRIUS_TARGET_LINUX
if (SYS_OPEN == 2) { _vfd = syscall(SYS_OPEN, "/proc/self/cmdline", 0, 0); }
else { _vfd = syscall(SYS_OPEN, 0 - 100, "/proc/self/cmdline", 0, 0); }
var _vn = syscall(SYS_READ, _vfd, &_vbuf, 255);
syscall(SYS_CLOSE, _vfd);
if (_vn > 0) {
    var _vi = 0;
    while (_vi < _vn) { if (load8(&_vbuf + _vi) == 0) { _vi = _vi + 1; break; } _vi = _vi + 1; }
    # Walk the cmdline args, looking for --version or --strict. Each
    # arg is NUL-terminated; cmdline contains argv[0]\0argv[1]\0...
    while (_vi < _vn) {
        # "--ve" (--version) — short-circuit exit
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 118 && load8(&_vbuf + _vi + 3) == 101) {
                    syscall(SYS_WRITE, 1, _VERSION_STR_CYCC_WIN, _VERSION_LEN_CYCC_WIN);
                    syscall(SYS_EXIT, 0);
                }
            }
        }
        # "--st" (--strict) — set flag, keep parsing
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 115 && load8(&_vbuf + _vi + 3) == 116) {
                    _strict_mode = 1;
                }
            }
        }
        # "--al" (--allow-undef, v6.3.2) — downgrade the default reachable-undef hard error to a warning. chars a(97) l(108).
        if (_vi + 4 <= _vn) {
            if (load8(&_vbuf + _vi) == 45 && load8(&_vbuf + _vi + 1) == 45) {
                if (load8(&_vbuf + _vi + 2) == 97 && load8(&_vbuf + _vi + 3) == 108) {
                    _allow_undef = 1;
                }
            }
        }
        # Skip to next arg (past next \0)
        while (_vi < _vn && load8(&_vbuf + _vi) != 0) { _vi = _vi + 1; }
        _vi = _vi + 1;
    }
}
#endif

# v6.0.54: the Windows --version / --strict path. GetCommandLineW returns
# ONE UTF-16LE string (program path + args, space-separated, NOT NUL-split),
# so we walk it char-by-char (2 bytes each, ASCII low byte) and, at each
# token start (string start or just after an unquoted space), test the
# first four chars for "--ve" (--version → print + exit) or "--st"
# (--strict → set the flag). Reading +6 max stays inside the kernel-owned,
# double-NUL-terminated buffer. ASCII-only, like lib/args_win.cyr; a path
# containing "--version" mid-token is not at a token start, so no false hit.
#ifdef CYRIUS_TARGET_WIN
var _vw = syscall(61446);              # GetCommandLineW → UTF-16LE LPWSTR in rax
if (_vw != 0) {
    var _wi = 0;
    var _wtok = 1;                     # at a token start (start-of-string counts)
    var _wdone = 0;
    var _wc = 0;
    var _whi = 0;
    while (_wdone == 0) {
        _wc = load8(_vw + _wi);        # low byte of the wide char (ASCII)
        _whi = load8(_vw + _wi + 1);   # high byte
        # double-NUL terminates; a U+xx00 char (low 0, high != 0) is NOT the end.
        if (_wc == 0) { if (_whi == 0) { _wdone = 1; } }
        if (_wdone == 0) {
            if (_wc == 32) {
                _wtok = 1;             # unquoted space → next char starts a token
            } else {
                if (_wtok == 1) {
                    if (load8(_vw + _wi) == 45) {
                        if (load8(_vw + _wi + 2) == 45) {
                            if (load8(_vw + _wi + 4) == 118) {
                                if (load8(_vw + _wi + 6) == 101) {
                                    syscall(SYS_WRITE, 1, _VERSION_STR_CYCC_WIN, _VERSION_LEN_CYCC_WIN);
                                    syscall(SYS_EXIT, 0);
                                }
                            }
                            if (load8(_vw + _wi + 4) == 115) {
                                if (load8(_vw + _wi + 6) == 116) {
                                    _strict_mode = 1;
                                }
                            }
                            # "--al" (--allow-undef, v6.3.2): UTF-16 a(97) l(108)
                            if (load8(_vw + _wi + 4) == 97) {
                                if (load8(_vw + _wi + 6) == 108) {
                                    _allow_undef = 1;
                                }
                            }
                        }
                    }
                    _wtok = 0;
                }
            }
            _wi = _wi + 2;
        }
    }
}
#endif

# Allocate heap.
# Windows has no brk (the Linux-style `syscall(SYS_BRK, 0)` / extend
# pattern crashes with STATUS_ACCESS_VIOLATION on PE because SYS_BRK
# isn't rerouted). v5.5.8: use SYS_MMAP which works on both paths of
# this file's build chain:
#   - cycc (Linux) compiles main_win.cyr → cc5_win_linux (Linux ELF):
#     heap init runs on Linux, calls mmap(0, 32MB, PROT_RW=3,
#     MAP_PRIVATE|MAP_ANONYMOUS=0x22, -1, 0) → valid region.
#   - cc5_win_linux compiles main_win.cyr → cycc_win.exe (PE):
#     heap init runs on Windows, PE backend (v5.5.1) routes to
#     VirtualAlloc(0, 32MB, MEM_COMMIT|MEM_RESERVE, PAGE_READWRITE).
#     The prot/flags/fd/offset are ignored by EMMAP_PE.
# 32 MB covers the 21 MB heap with margin + page-alignment.
# MMAP region sized at 0x5F00000 (95 MB) — covers the cyrius heap
# layout through preprocess_out (brk-equivalent at 0x4D9D000 /
# ~77.6 MB) plus 1.4 MB page-alignment slack. Synced with
# main.cyr's brk extension.
# Lineage: 0x5800000 / 88 MB through v5.11.67 ← 0x5000000 / 80 MB
# pre-v5.11.33 (preprocess_out cap raise 2 MB → 8 MB grew it 8 MB).
# v5.11.68 full heap-map reorg shrunk MMAP 0x5800000 → 0x4F00000 → 0x5F00000 @ v6.1.27
# (-9.06 MB) tracking the brk reduction. PE EMMAP routes via
# VirtualAlloc with prot/flags ignored.
var S = syscall(SYS_MMAP, 0, 0x7300000, 3, 0x22, 0 - 1, 0);   # v6.3.28: +IR arrays relocated to arena top (0x5E9D000..0x729D000) for the 1M-node cap

# Zero scratch state (v5.8.63 extraction; see src/common/util.cyr for slot list)
_HEAP_INIT_SCRATCH(S);

# v6.0.7 — init alloc and assign rp_vec (return-patch storage).
alloc_init();
rp_vec = vec_new();
# Phase 0 (v6.2.0): growable fixup table — base = the existing 0x107B000 region,
# cap = the old hard cap; GFCNT grows it 2x via alloc() once full (util.cyr).
_fixup_base = S + 0x107B000;
_fixup_cap = 1048576;
# Phase 0 (v6.2.0): growable fn-tables — bases start AT the original fixed
# offsets, mask 8191, cap 8192 (byte-identical under the old cap; REGFN grows
# the family + rehashes when the count would exceed it). See util.cyr.
_fnt_cstrmask = S + 0x93A000;
_fnt_resmask = S + 0x94A000;
_fnt_optmask = S + 0x95A000;
_fnt_tagmask = S + 0x96A000;
_fnt_ovstr = S + 0x97A000;
_fnt_ovint = S + 0x98A000;
_fnt_ovcstr = S + 0x99A000;
_fnt_simdmask = S + 0x9AA000;
_fnt_names = S + 0x9BA000;
_fnt_offsets = S + 0x9CA000;
_fnt_params = S + 0x9DA000;
_fnt_bodystart = S + 0x9EA000;
_fnt_bodyend = S + 0x9FA000;
_fnt_inline = S + 0xA0A000;
_fnt_strmask = S + 0xA1A000;
_fnt_codeend = S + 0xA2A000;
_fnt_structmask = S + 0xA3A000;
_fnt_namehash = S + 0x110000;
_fnt_starthash = S + 0x114000;
_fnt_hash_mask = 8191;
_fnt_cap = 8192;
# Phase 0 (v6.2.0): growable codebuf — base at the original 3 MB region,
# cap 3145728 (byte-identical under the old cap; EB grows + relocates off-heap
# when cp nears it). The cx backend's own 0x54A000 codebuf is separate + fixed.
_codebuf_base = S + 0x41A000;
_varn_base = S + 0x11A000;
_vars_base = S + 0x12A000;
_vart_base = S + 0x13A000;
_vgoff_base = S + 0x1B0000;
_vecv_base = S + 0x1D8000;
_vgsi_base = S + 0x1EC000;
_venid_base = S + 0x204000;
_var_cap = 8192;
_codebuf_cap = 3145728;

# Read input. Buffer is 256KB (v3.4.19, was 128KB before). If the source ever
# fills the whole buffer, we error out explicitly instead of silently truncating
# — the old silent cap at 131072 bytes masked the mabda 141KB bundle failure as
# a random "unexpected end of file" at token ~3719.
var bl = 0;
var done = 0;
while (done == 0) {
    var n = syscall(SYS_READ, 0, S + bl, 1048576 - bl);
    if (n <= 0) { done = 1; }
    else {
        bl = bl + n;
        if (bl >= 1048576) {
            # One more read to distinguish "exactly 256KB" from "more coming"
            var probe[1];
            var pn = syscall(SYS_READ, 0, &probe, 1);
            if (pn > 0) {
                syscall(SYS_WRITE, 2, "error: input exceeds 1MB buffer (raise input_buf in src/main.cyr)\n", 66);
                syscall(SYS_EXIT, 1);
            }
            done = 1;
        }
    }
}
SBL(S, bl);

# Init stdlib fallback path from HOME env
_init_cyrius_lib();

# Register compiler-builtin arch marker so lib files can `#ifdef
# CYRIUS_ARCH_X86` to select x86-specific asm over aarch64 asm.
PP_PREDEFINE(S, "CYRIUS_ARCH_X86");
# v5.5.0: cycc_win also defines CYRIUS_TARGET_WIN so stdlib can
# `#ifdef CYRIUS_TARGET_WIN` to select Windows-shaped includes
# (syscalls_windows.cyr + alloc_windows.cyr) instead of the
# Linux peers that ship by default on the x86 branch.
PP_PREDEFINE(S, "CYRIUS_TARGET_WIN");
# v5.11.52: under CYRIUS_TARGET_EFI=1 (UEFI Application output), also
# predefine CYRIUS_TARGET_EFI so consumers can target-discriminate
# UEFI vs Windows-CUI at preprocessor time. EFI and Windows share MS
# x64 ABI + PE32+ container; the lib/fnptr.cyr MS-x64 branches fire
# under CYRIUS_TARGET_WIN regardless.
var _efi_env_early_w = _read_env("CYRIUS_TARGET_EFI");
if (_efi_env_early_w != 0) {
    if (load8(_efi_env_early_w) == 49 && load8(_efi_env_early_w + 1) == 0) {
        PP_PREDEFINE(S, "CYRIUS_TARGET_EFI");
    }
}

# Preprocess includes
PREPROCESS(S);

# Re-init ALL compiler state that the ifdef copy-back may have overwritten.
# For expanded source >256KB, the copy-back writes past S+0x40000 into every
# heap region up to S+bl. This mirrors the full initialization at lines 155-196
# so every scalar starts fresh before LEX runs.
S64(S + 0x18FCC8, 0);       # str_pos (moved from 0x70000 in 4.6.2)
S64(S + 0x18FCD0, 0);       # data_size (moved from 0x70008 in 4.6.2)
S64(S + 0x18C108, 0);       # CP
S64(S + 0x18C110, 0);       # VCNT
S64(S + 0x18C118, 0);       # TCNT
S64(S + 0x18C120, 0);       # TI
S64(S + 0x18C128, 0);       # NPOS
S64(S + 0x18FCA8, 0);       # fixup_cnt
S64(S + 0x18FCB0, 0 - 1);   # last_var
S64(S + 0x18DA00, 0);       # fn_count
S64(S + 0x18DA08, 0);       # in_fn
S64(S + 0x18DA10, 0);       # local_cnt
S64(S + 0x18F830, 0);       # struct_count
S64(S + 0x18F888, 0);       # extra_patch_cnt
S64(S + 0x18FCA0, 0);       # kernel_mode
S64(S + 0x18FCB8, 1);       # cur_line (starts at 1)
S64(S + 0x18FCC0, 0);       # scope_depth
S64(S + 0x1903D8, 0);       # expr_stype
S64(S + 0x1903E8, 0);       # inline_depth
S64(S + 0x1903F0, 0);       # expr_width
S64(S + 0x18F898, 0);       # continue_count
S64(S + 0x18FEC8, 0);       # current_module
S64(S + 0x1903D0, 0);       # use_count
S64(S + 0x19A000, 0);       # gvar_cnt
S64(S + 0x197000, 0);       # macro state
S64(S + 0x197F00, 0);       # macro state 2

# Build file map from #@file markers (for file:line error messages)
FM_BUILD(S);

# Lex
LEX(S);


# Emit initial jmp over fn bodies
EB(S, 0xE9);
var jmp_patch = GCP(S);
EB(S, 0); EB(S, 0); EB(S, 0); EB(S, 0);

# v6.3.39 (Windows monomorph parity): read CYRIUS_MONOMORPH BEFORE pass-1 (pass-1
# captures generic structs' GSTP type-param encoding only when _MONOMORPH_OK==1; the
# v6.3.33 fix landed in main.cyr only). Default (env unset) → byte-identical.
var _mono_env = _read_env("CYRIUS_MONOMORPH");
if (_mono_env != 0) {
    if (load8(_mono_env) == 49 && load8(_mono_env + 1) == 0) {
        _MONOMORPH_OK = 1;
    }
}

# Pass 1: Pre-scan to register all global vars and structs (no fn bodies)
STI(S, 0);
var scan = 1;
while (scan == 1) {
    if (PEEKT(S) == 72) {
        # mod name; — set current module prefix
        STI(S, GTI(S) + 1);
        if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); }
        if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
    }
    else { if (PEEKT(S) == 73) {
            # pub — skip in pass 1 (just consume the keyword, next token is fn/var/struct)
            STI(S, GTI(S) + 1);
        }
        else { if (PEEKT(S) == 74) {
                # use modname.funcname; — register alias
                STI(S, GTI(S) + 1);
                if (PEEKT(S) == 2) {
                    var umod = PEEKV(S);
                    STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 41) {
                        STI(S, GTI(S) + 1);
                        if (PEEKT(S) == 2) {
                            var ufn = PEEKV(S);
                            STI(S, GTI(S) + 1);
                            # Build mangled name: mod_fn
                            # Each alias gets 64 bytes in scratch area (30000 + uc*64)
                            var uc = GUSEC(S);
                            S64(S + 0x18FFD0 + uc * 8, ufn);
                            # Append mangled name to tok_names (after lexing, NPOS is stable)
                            # v5.11.65 (CVE-05): bound by actual source lengths.
                            var _ulen1 = 0; while (load8(S + 0x60000 + umod + _ulen1) != 0) { _ulen1 = _ulen1 + 1; }
                            var _ulen2 = 0; while (load8(S + 0x60000 + ufn + _ulen2) != 0) { _ulen2 = _ulen2 + 1; }
                            NPOS_GUARD(S, _ulen1 + 1 + _ulen2 + 1);
                            var apos = GNPOS(S);
                            var ri = 0;
                            var rc = load8(S + 0x60000 + umod + ri);
                            while (rc != 0) { store8(S + 0x60000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0x60000 + umod + ri); }
                            store8(S + 0x60000 + apos, 95); apos = apos + 1;
                            ri = 0; rc = load8(S + 0x60000 + ufn + ri);
                            while (rc != 0) { store8(S + 0x60000 + apos, rc); apos = apos + 1; ri = ri + 1; rc = load8(S + 0x60000 + ufn + ri); }
                            store8(S + 0x60000 + apos, 0); apos = apos + 1;
                            var alias_noff = GNPOS(S);
                            SNPOS(S, apos);
                            S64(S + 0x1901D0 + uc * 8, alias_noff);
                            SUSEC(S, uc + 1);
                        }
                    }
                }
                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
            }
            else { if (PEEKT(S) == 40) { PARSE_STRUCT_DEF(S); }
                else { if (PEEKT(S) == 101) { PARSE_UNION_DEF(S); }
                    else { if (PEEKT(S) == 3) { PARSE_GVAR_REG(S); }
                        # v4.8.4-alpha1: #regalloc — consume silently in pass 1. Pass 1
                        # doesn't REGFN, so there's no metadata slot to attach to here;
                        # pass 2 re-reads the same token stream and arms the pending flag
                        # then. (v4.8.4-alpha4 kept the pass-1 consume unchanged so a
                        # stale flag can't leak from pass 1 into pass 2.)
                        # v6.2.32: full annotation-token set consumed in pass 1 —
                        # 109 #regalloc / 122 #must_use / 124 #deprecated / 125 #pure /
                        # 126 #io / 127 / 133 #naked. main_win.cyr previously consumed
                        # only 109+133, so a PE consumer of an annotation-bearing lib
                        # (bayan via cyrsign) hit "unexpected enum" — the next enum went
                        # unregistered. The other 5 forks already had the full set;
                        # this is the last fork to mirror it. See project_v622_annotation_fork_desync.
                        else { if (PEEKT(S) == 109 || PEEKT(S) == 122 || PEEKT(S) == 124 || PEEKT(S) == 125 || PEEKT(S) == 126 || PEEKT(S) == 127 || PEEKT(S) == 133) {
                                    if (PEEKT(S) == 124) {
                                        # #deprecated carries an optional ("message") — consume it so it can't dangle.
                                        STI(S, GTI(S) + 1);
                                        if (PEEKT(S) == 10) { STI(S, GTI(S) + 1); if (PEEKT(S) == 30) { STI(S, GTI(S) + 1); } if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); } }
                                    } else { STI(S, GTI(S) + 1); }
                                }
                            else { if (_IS_FN_KW(S) == 1) {
                                    # v6.3.5 CO-01 — pass-1 fn-signature prescan (see _prescan_fn_sig in parse_fn.cyr).
                                    _prescan_fn_sig(S);
                                }
                                else { if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 0); }
                                    else { if (_TOK_IS_KERNEL(S) == 1) {
                                            S64(S + 0x18FCA0, 1);
                                            STI(S, GTI(S) + 1);
                                            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                        }
                                        else { if (PEEKT(S) == 78) {
                                                S64(S + 0x18FCA0, 2);
                                                STI(S, GTI(S) + 1);
                                                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                            }
                                            else { if (PEEKT(S) == 79) {
                                                    S64(S + 0x18FCA0, 3);
                                                    STI(S, GTI(S) + 1);
                                                    if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                                }
                                                else { if (PEEKT(S) == 77) {
                                                        # impl — skip entire block in pass 1 (functions registered in pass 2)
                                                        STI(S, GTI(S) + 1);  # consume IMPL
                                                        STI(S, GTI(S) + 1);  # consume trait name
                                                        STI(S, GTI(S) + 1);  # consume FOR
                                                        STI(S, GTI(S) + 1);  # consume type name
                                                        if (PEEKT(S) == 13) {
                                                            STI(S, GTI(S) + 1);
                                                            var idep = 0;
                                                            var isk = 1;
                                                            while (isk == 1) {
                                                                var it = PEEKT(S);
                                                                if (it == 13) { idep = idep + 1; }
                                                                if (it == 14) { if (idep == 0) { isk = 0; } else { idep = idep - 1; } }
                                                                if (it == 12) { isk = 0; }
                                                                STI(S, GTI(S) + 1);
                                                            }
                                                        }
                                                    }
                                                    else { if (PEEKT(S) == 107) {
                                                            # #assert — skip in pass 1, evaluated in pass 2 via PARSE_STMT
                                                            while (PEEKT(S) != 5 && PEEKT(S) != 12) { STI(S, GTI(S) + 1); }
                                                            if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                                                        }
                                                        else { scan = 0; } } } } } } } } } } } } } }
}

# Reset module for pass 2
SMOD(S, 0);

# DCE pre-scan: build referenced-name bitmap in one pass over tokens.
# Uses output_buf (S+0x1DA000, 8KB) as scratch — safe because EMITELF runs later.
# Bitmap: bit N set means tok_names offset N is referenced as non-FN identifier.
var dce_bm = S + 0x1DA000;
var dce_zi = 0;
while (dce_zi < 8192) { store8(dce_bm + dce_zi, 0); dce_zi = dce_zi + 1; }
var dce_ti = 0;
var dce_tc = GTCNT(S);
var dce_prev = 0;
while (dce_ti < dce_tc) {
    var dce_tt = TOKTYP(S, dce_ti);
    if (dce_tt == 2) {
        if (dce_prev != 32) {
            var dce_noff = TOKVAL(S, dce_ti);
            if (dce_noff < 65536) {
                var dce_byte = dce_noff >> 3;
                var dce_bit = dce_noff & 7;
                store8(dce_bm + dce_byte, load8(dce_bm + dce_byte) | (1 << dce_bit));
            }
        }
    }
    dce_prev = dce_tt;
    dce_ti = dce_ti + 1;
}

# Mach-O output via CYRIUS_MACHO=1 (x86_64) or CYRIUS_MACHO_ARM=1 (ARM64)
var _macho_env = _read_env("CYRIUS_MACHO");
if (_macho_env != 0) {
    if (load8(_macho_env) == 49 && load8(_macho_env + 1) == 0) {
        _TARGET_MACHO = 1;
    }
}
var _macho_arm_env = _read_env("CYRIUS_MACHO_ARM");
if (_macho_arm_env != 0) {
    if (load8(_macho_arm_env) == 49 && load8(_macho_arm_env + 1) == 0) {
        _TARGET_MACHO = 2;
    }
}

# PE32+ output is the DEFAULT for cycc_win (this file). CYRIUS_TARGET_WIN=0
# opts out and emits ELF instead (rare — use cycc for ELF).
_TARGET_PE = 1;
var _pe_env = _read_env("CYRIUS_TARGET_WIN");
if (_pe_env != 0) {
    if (load8(_pe_env) == 48 && load8(_pe_env + 1) == 0) {
        _TARGET_PE = 0;
    }
}

# UEFI Application output via CYRIUS_TARGET_EFI=1 (v5.11.47). Same
# PE32+ container, MS x64 ABI, and .reloc as the Windows path —
# Subsystem byte flips 3 → 0xA (IMAGE_SUBSYSTEM_EFI_APPLICATION), no
# kernel32 imports, EEXIT emits `ret` instead of ExitProcess IAT
# call. Unblocks gnoboot (AGNOS sovereign UEFI bootloader) — see
# docs/development/issues/archived/2026-05-13-gnoboot-uefi-application-emit.md.
var _efi_env = _read_env("CYRIUS_TARGET_EFI");
if (_efi_env != 0) {
    if (load8(_efi_env) == 49 && load8(_efi_env + 1) == 0) {
        _TARGET_PE = 1;
        _TARGET_EFI_APPLICATION = 1;
    }
}

# cycc: opt-in IR recording via CYRIUS_IR=1|2
var _ir_env = _read_env("CYRIUS_IR");
if (_ir_env != 0) {
    var _ir_ch = load8(_ir_env);
    if (_ir_ch >= 49 && _ir_ch <= 51) {
        IR_SENABLE(S, 1);
        ir_reset(S);
    }
}

# v6.3.5 AR-01 — monomorphization opt-in is now read BEFORE pass-1 (v6.3.39 Windows
# parity). This site retired.

# Pass 2: Parse struct and fn definitions (vars already registered)
STI(S, 0);
var topgo = 1;
while (topgo == 1) {
    # Skip mod/pub/use in pass 2
    if (PEEKT(S) == 72) { STI(S, GTI(S) + 1); if (PEEKT(S) == 2) { SMOD(S, PEEKV(S)); STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
    else { if (PEEKT(S) == 73) { STI(S, GTI(S) + 1); }
        else { if (PEEKT(S) == 74) { while (PEEKT(S) != 5) { if (PEEKT(S) == 12) { break; } STI(S, GTI(S) + 1); } if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
            else { if (PEEKT(S) == 40) {
                    # Skip struct (already parsed in pass 1)
                    STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                    if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                    if (PEEKT(S) != 13) { ERR(S); }
                    STI(S, GTI(S) + 1);
                    var ssk = 1;
                    while (ssk == 1) { if (PEEKT(S) == 14) { ssk = 0; } else { STI(S, GTI(S) + 1); } }
                    STI(S, GTI(S) + 1);
                }
                else { if (PEEKT(S) == 101) {
                        # Skip union (already parsed in pass 1)
                        STI(S, GTI(S) + 1); STI(S, GTI(S) + 1);
                        if (PEEKT(S) != 13) { ERR(S); }
                        STI(S, GTI(S) + 1);
                        var usk = 1;
                        while (usk == 1) { if (PEEKT(S) == 14) { usk = 0; } else { STI(S, GTI(S) + 1); } }
                        STI(S, GTI(S) + 1);
                    }
                    else { if (PEEKT(S) == 60) {
                            # Emit constructor bodies in function section (before JMP is patched)
                            PARSE_ENUM_DEF(S, 2);
                        }
                        else { if (_TOK_IS_KERNEL(S) == 1) {
                                STI(S, GTI(S) + 1);
                                if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); }
                            }
                            # v4.8.4-alpha4: #regalloc — arm the pending flag so the next `fn`
                            # definition picks it up in REGFN. PARSE_FN_DEF transfers the flag
                            # to fn_regalloc[fi] and clears _regalloc_pending. The DCE stub
                            # path below also clears the flag (dead fns don't need tracking).
                            # v6.2.32: full annotation-token set consumed in pass 2 too
                            # (see the pass-1 note). PE keeps 109 → _regalloc_pending;
                            # 122/124/125/126/127/133 are consume-and-ignore (their opts/
                            # diagnostics are gated off on the PE backend, CO-03) — the
                            # point is to keep the token stream in sync so the next enum
                            # registers. #deprecated (124) consumes its optional ("msg").
                            else { if (PEEKT(S) == 109 || PEEKT(S) == 122 || PEEKT(S) == 124 || PEEKT(S) == 125 || PEEKT(S) == 126 || PEEKT(S) == 127 || PEEKT(S) == 133) {
                                    if (PEEKT(S) == 109) { _regalloc_pending = 1; }
                                    if (PEEKT(S) == 124) {
                                        STI(S, GTI(S) + 1);
                                        if (PEEKT(S) == 10) { STI(S, GTI(S) + 1); if (PEEKT(S) == 30) { STI(S, GTI(S) + 1); } if (PEEKT(S) == 11) { STI(S, GTI(S) + 1); } }
                                    } else { STI(S, GTI(S) + 1); }
                                }
                                else { if (_IS_FN_KW(S) == 1) {
                                        var _blk_async = 0;   # v6.3.11 (G): consume `async` (cursor→`fn`) before the DCE name-read
                                        if (PEEKT(S) == 134) { _blk_async = 1; STI(S, GTI(S) + 1); }
                                        # DCE: check bitmap for reference to this function name.
                                        # Skip DCE for module-scoped or underscore-named functions.
                                        # Also skip in object mode — externally-referenced functions
                                        # don't appear as identifiers in this module's token stream but
                                        # still need full bodies for the linker to resolve cross-unit calls.
                                        # And in shared mode — exported `.so` functions are called by
                                        # dlopen consumers (no in-module reference) and need full bodies.
                                        var dce_fnoff = TOKVAL(S, GTI(S) + 1);
                                        var dce_reachable = 1;
                                        var dce_km = L64(S + 0x18FCA0);
                                        if (dce_km == 3 || dce_km == 2) { dce_reachable = 1; }
                                        else { if (GMOD(S) == 0) {
                                                # v6.0.54: exempt `main` from DCE — port of main.cyr's
                                                # v5.9.37 fix. The WIN driver lacked it, so native
                                                # cycc_win stubbed an explicit `fn main()` to
                                                # `xor eax,eax; ret` and the program exited 0 without
                                                # running its body (the auto-call-main epilogue below
                                                # calls main from generated code, so DCE never sees an
                                                # ident reference). See CHANGELOG [5.9.37] / [6.0.54].
                                                var dce_is_main = 0;
                                                if (load8(S + 0x60000 + dce_fnoff) == 109) {     # 'm'
                                                    if (load8(S + 0x60000 + dce_fnoff + 1) == 97) {   # 'a'
                                                        if (load8(S + 0x60000 + dce_fnoff + 2) == 105) {   # 'i'
                                                            if (load8(S + 0x60000 + dce_fnoff + 3) == 110) {   # 'n'
                                                                if (load8(S + 0x60000 + dce_fnoff + 4) == 0) {
                                                                    dce_is_main = 1;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                                # Check for underscore in name (mangled — skip DCE)
                                                var dce_np = S + 0x60000 + dce_fnoff;
                                                var dce_has_us = 0;
                                                var dce_ni = 0;
                                                while (load8(dce_np + dce_ni) != 0) {
                                                    if (load8(dce_np + dce_ni) == 95) { dce_has_us = 1; }
                                                    dce_ni = dce_ni + 1;
                                                }
                                                if (dce_is_main == 0) {
                                                    if (dce_has_us == 0) {
                                                        # Check bitmap: is this name offset referenced?
                                                        if (dce_fnoff < 65536) {
                                                            var dce_byte = dce_fnoff >> 3;
                                                            var dce_bit = dce_fnoff & 7;
                                                            if ((load8(dce_bm + dce_byte) & (1 << dce_bit)) == 0) {
                                                                dce_reachable = 0;
                                                            }
                                                        }
                                                    }
                                                }
                                            } }
                                        if (dce_reachable == 1) {
                                            if (_blk_async == 1) { _pending_async = 1; }   # v6.3.11 (G)
                                            PARSE_FN_DEF(S);
                                        } else {
                                            # Emit stub: set fn_offsets, emit xor eax,eax; ret, skip body
                                            STI(S, GTI(S) + 1);  # consume FN
                                            var stub_noff = PEEKV(S);
                                            STI(S, GTI(S) + 1);  # consume name
                                            if (PEEKT(S) == 19) { while (PEEKT(S) != 20) { STI(S, GTI(S) + 1); } STI(S, GTI(S) + 1); }
                                            # Register or find function and set its offset to stub
                                            var stub_fi = FINDFN(S, stub_noff);
                                            if (stub_fi < 0) { stub_fi = REGFN(S, stub_noff); }
                                            # v4.8.4-alpha4: clear any pending `#regalloc` — a DCE'd fn
                                            # is emitted as a 3-byte stub and has no prologue to attach
                                            # callee-saved-reg state to. Leaving the flag armed would
                                            # leak it to whichever fn lands next.
                                            if (_regalloc_pending == 1) { _regalloc_pending = 0; }
                                            S64(_fnt_offsets + stub_fi * 8, GCP(S));
                                            # Emit stub: xor eax, eax; ret (3 bytes)
                                            EB(S, 0x31); EB(S, 0xC0); EB(S, 0xC3);
                                            # Skip function body tokens
                                            var sdep = 0;
                                            var ssk2 = 1;
                                            while (ssk2 == 1) {
                                                var st = PEEKT(S);
                                                if (st == 13) { sdep = sdep + 1; }
                                                if (st == 14) { sdep = sdep - 1; if (sdep == 0) { ssk2 = 0; } }
                                                if (st == 12) { ssk2 = 0; }
                                                STI(S, GTI(S) + 1);
                                            }
                                        }
                                    }
                                    else { if (PEEKT(S) == 3) {
                                            var vsk = 1;
                                            while (vsk == 1) { if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); vsk = 0; } else { STI(S, GTI(S) + 1); } }
                                        }
                                        else { if (PEEKT(S) == 77) { PARSE_IMPL(S); }
                                            else { if (PEEKT(S) == 78) { STI(S, GTI(S) + 1); if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
                                                else { if (PEEKT(S) == 79) { STI(S, GTI(S) + 1); if (PEEKT(S) == 5) { STI(S, GTI(S) + 1); } }
                                                    else { topgo = 0; } } } } } } } } } } } } }
}

# Reset module
SMOD(S, 0);

# Patch jmp to land here (start of main code)
EPATCH(S, jmp_patch);

# In object mode AND shared mode, wrap top-level code as a callable
# function (_cyrius_init). Object mode: linked binaries call it after
# symbol merge. Shared mode: dynamic loader calls it via DT_INIT on
# dlopen — this is how `var x = 100;` initializers actually run.
var _cyrius_init_offset = GCP(S);
S64(S + 0x1903F8, _cyrius_init_offset);
var _init_km = L64(S + 0x18FCA0);
if (_init_km == 3 || _init_km == 2) {
    EFNPRO(S);               # push rbp; mov rbp, rsp
    # Allocate generous stack frame for top-level init code (4096 bytes = 512 locals)
    E3(S, 0xEC8148);          # sub rsp, imm32
    EB(S, 0x00); EB(S, 0x10); EB(S, 0x00); EB(S, 0x00);  # 0x1000 = 4096 bytes
}

# Emit enum initializations FIRST (before gvar inits, since gvar inits may call
# functions that reference enum values)
var gvar_save_ti = GTI(S);
STI(S, 0);
var escan = 1;
while (escan == 1) {
    if (PEEKT(S) == 60) { PARSE_ENUM_DEF(S, 1); }
    else { if (PEEKT(S) == 12) { escan = 0; }
        else { STI(S, GTI(S) + 1); } }
}
# Emit deferred global var initializations
EMIT_GVAR_INITS(S);
STI(S, gvar_save_ti);

# Warn about undefined functions (registered but never defined — offset still -1)
var wfi = 0;
var wfc = GFNC(S);
while (wfi < wfc) {
    if (L64(_fnt_offsets + wfi * 8) < 0) {
        syscall(SYS_WRITE, 2, "warning: undefined function '", 29);
        PRSTR(S + 0x60000 + L64(_fnt_names + wfi * 8));
        syscall(SYS_WRITE, 2, "'\n", 2);
    }
    wfi = wfi + 1;
}

# Parse main code (top-level statements)
PARSE_PROG(S);

# Exit epilogue
var lv = GLVAR(S);
if (lv >= 0) { EVLOAD(S, lv); }

# v6.0.54: auto-call `main()` if defined and not already called — port of
# main.cyr's v5.9.37 fix (the WIN driver lacked it, so a source with only
# `fn main() { ... }` and no explicit `syscall(60, main())` wire ran the
# gvar inits + parse-prog and exited with rax=junk; main never ran). Must
# run AFTER the GLVAR-load above — that load clobbers main's rax return.
# Pairs with the `dce_is_main` exemption in the DCE block above (without it
# DCE would stub main to `xor eax,eax; ret`). See CHANGELOG [5.9.37]/[6.0.54].
var _epi_km_pre = L64(S + 0x18FCA0);
if (_epi_km_pre == 0) {
    var _main_found = _find_fn_by_name(S, "main", 4);
    if (_main_found >= 0) {
        var _main_off = L64(_fnt_offsets + _main_found * 8);
        if (_main_off >= 0) {
            ECALLTO(S, _main_off);
        }
    }
}
var _epi_km = L64(S + 0x18FCA0);
if (_epi_km == 3 || _epi_km == 2) {
    # Object / shared mode: return from _cyrius_init (leave; ret).
    # Shared mode uses this as the DT_INIT target.
    EFNEPI(S);
} else {
    # Executable mode: exit via syscall(60, exit_code)
    EEXIT(S);
}

# cycc: IR stats/dump
if (IR_ENABLED(S) == 1) {
    var ir_bbs = ir_build_bbs(S);
    var ir_edges = ir_build_edges(S);
    var ir_lase_n = ir_lase(S);
    # LASE/DBE codebuf patching disabled — IR doesn't capture all emit
    # calls. NOP-filling an IR node's CP range can destroy adjacent
    # non-IR code. Analysis-only until ALL emission goes through IR.
    var ir_lase_bytes = 0;
    var ir_dbe_bytes = 0;
    # DBE disabled — IR doesn't capture all emit calls (EB/E2/E3 direct,
    # EEXIT, ESTOREPARM, etc. are not instrumented). NOP-filling a BB's
    # CP range can destroy non-IR code. Safe only after ALL emission goes
    # through IR. Tracked for beta.
    # if (load8(_ir_env) == 51) { ir_dbe_bytes = ir_dead_block_elim(S); }
    syscall(SYS_WRITE, 2, "ir: ", 4);
    PRNUM(IR_NCNT(S));
    syscall(SYS_WRITE, 2, " nodes, ", 8);
    PRNUM(ir_bbs);
    syscall(SYS_WRITE, 2, " BBs, ", 6);
    PRNUM(ir_edges);
    syscall(SYS_WRITE, 2, " edges, ", 8);
    PRNUM(ir_lase_n);
    syscall(SYS_WRITE, 2, " LASE", 5);
    if (ir_dbe_bytes > 0) {
        syscall(SYS_WRITE, 2, ", ", 2);
        PRNUM(ir_dbe_bytes);
        syscall(SYS_WRITE, 2, "B DBE", 5);
    }
    syscall(SYS_WRITE, 2, "\n", 1);
    # CYRIUS_IR=2: verbose dump
    if (load8(_ir_env) == 50) { ir_dump(S); }
}

# Fixup + ELF + write
FIXUP(S);
# v4.8.3-alpha1: capacity meter — opt-in via CYRIUS_STATS=1.
# Bote and other consumer projects hit silent capacity walls (fn
# table, identifier buffer); this exposes utilization at compile
# time so refactors can size themselves.
var _stats_env = _read_env("CYRIUS_STATS");
if (_stats_env != 0) {
    if (load8(_stats_env) == 49 && load8(_stats_env + 1) == 0) {
        syscall(SYS_WRITE, 2, "cyrius stats:\n", 14);
        syscall(SYS_WRITE, 2, "  fn_table:    ", 15); PRNUM(GFNC(S));
        syscall(SYS_WRITE, 2, " / 8192\n",        8);
        syscall(SYS_WRITE, 2, "  identifiers: ", 15); PRNUM(GNPOS(S));
        syscall(SYS_WRITE, 2, " / 262144\n",     10);
        syscall(SYS_WRITE, 2, "  var_table:   ", 15); PRNUM(GVCNT(S));
        syscall(SYS_WRITE, 2, " / 8192\n",        8);
        syscall(SYS_WRITE, 2, "  fixup_table: ", 15); PRNUM(GFCNT(S));
        syscall(SYS_WRITE, 2, " / 1048576\n",       11);
        syscall(SYS_WRITE, 2, "  string_data: ", 15); PRNUM(GSPOS(S));
        syscall(SYS_WRITE, 2, " / 2097152\n",    11);
        syscall(SYS_WRITE, 2, "  code_size:   ", 15); PRNUM(GCP(S));
        syscall(SYS_WRITE, 2, " / 1048576\n",    11);
    }
}
# v4.8.3-alpha2: soft 85% warnings on default builds. Catches
# "close-to-wall" conditions before a refactor trips the cap.
# Suppressed under CYRIUS_STATS=1 (already shown above) and under
# `--version` short-circuit (handled before this point).
if (_stats_env == 0) {
    if (GFNC(S) * 100 / _fnt_cap >= 85) {
        syscall(SYS_WRITE, 2, "warning: fn_table at ", 21);
        PRNUM(GFNC(S) * 100 / _fnt_cap);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GFNC(S));
        syscall(SYS_WRITE, 2, "/8192) — split into compilation units soon\n", 45);
    }
    if (GNPOS(S) * 100 / 262144 >= 85) {
        syscall(SYS_WRITE, 2, "warning: identifier buffer at ", 30);
        PRNUM(GNPOS(S) * 100 / 262144);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GNPOS(S));
        syscall(SYS_WRITE, 2, "/262144 bytes) — reduce includes or split soon\n", 49);
    }
    if (GVCNT(S) * 100 / 8192 >= 85) {
        syscall(SYS_WRITE, 2, "warning: var_table at ", 22);
        PRNUM(GVCNT(S) * 100 / 8192);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GVCNT(S));
        syscall(SYS_WRITE, 2, "/8192) — too many globals + locals\n", 37);
    }
    if (GFCNT(S) * 100 / 1048576 >= 85) {
        syscall(SYS_WRITE, 2, "warning: fixup_table at ", 24);
        PRNUM(GFCNT(S) * 100 / 1048576);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GFCNT(S));
        syscall(SYS_WRITE, 2, "/1048576) — too many cross-fn refs\n", 37);
    }
    if (GSPOS(S) * 100 / 2097152 >= 85) {
        syscall(SYS_WRITE, 2, "warning: string_data at ", 24);
        PRNUM(GSPOS(S) * 100 / 2097152);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GSPOS(S));
        syscall(SYS_WRITE, 2, "/2097152 bytes)\n", 16);
    }
    if (GCP(S) * 100 / _codebuf_cap >= 85) {
        syscall(SYS_WRITE, 2, "warning: code buffer at ", 24);
        PRNUM(GCP(S) * 100 / _codebuf_cap);
        syscall(SYS_WRITE, 2, "% (", 3); PRNUM(GCP(S));
        syscall(SYS_WRITE, 2, "/3145728 bytes)\n", 16);
    }
}
EMITELF(S);
# Write ELF output (loop on partial writes)
var olen = L64(S + 0x1903F8);
var written = 0;
var wgo = 1;
while (wgo == 1) {
    var w = syscall(SYS_WRITE, 1, S + 0x4D9D000 + written, olen - written);
    if (w <= 0) { wgo = 0; }
    else {
        written = written + w;
        if (written >= olen) { wgo = 0; }
    }
}
syscall(SYS_EXIT, 0);
