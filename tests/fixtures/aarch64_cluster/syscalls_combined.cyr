# aarch64 syscall stdlib + thread/atomic/thread_local/flags
# acceptance fixture (v5.4.11 .. v5.5.33). Cross-built with
# build/cc5_aarch64, scp'd to the configured SSH target (default
# `pi`), executed there, exit code decoded by the dispatcher.
#
# Exit-code contract:
#   99 — all sub-tests PASS
#   <id*10 + sub> — test `id` failed at sub-step `sub`
#                   (e.g. 12 = test 1 read syscall failed,
#                    72 = test 7 CAS sanity step 2 failed)
#
# Sub-tests preserve the original .sh's exit-code mapping so
# diagnostic recipes from older sessions still translate.
#
# Tests:
#   1. sys_open + sys_read + sys_write (yukti pin v5.4.11)
#   2. thread_create + thread_join smoke (majra pin v5.4.11)
#   3. alloc 256 × 1 KB blocks (v5.5.18)
#   4. file_open/write/close/read fs roundtrip (v5.5.18)
#   5. 4 × thread_create/join in parallel (v5.5.18)
#   6. thread_local set/get + 4-thread isolation (v5.5.30)
#   7. atomic_cas/load/fetch_add + 4-thread contention (v5.5.31)
#   8. mutex-wrapped hashmap + 4-thread contention (v5.5.32)
#   9. lib/flags.cyr CLI flag parser (v5.5.33)

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/atomic.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"
include "lib/flags.cyr"

fn _t1_sys_open() {
    var fd = sys_open("/etc/hostname", O_RDONLY, 0);
    if (fd < 0) { return 11; }
    var buf[256];
    var n = sys_read(fd, &buf, 255);
    sys_close(fd);
    if (n <= 0) { return 12; }
    sys_write(STDOUT_FD, &buf, n);
    return 0;
}

fn _t2_worker(arg) {
    syscall(SYS_EXIT, 0);
    return 0;
}

fn _t2_thread() {
    var t = thread_create(&_t2_worker, 0);
    if (t == 0) { return 21; }
    var rj = thread_join(t);
    if (rj != 0) { return 22; }
    return 0;
}

fn _t3_alloc() {
    var i = 0;
    var last = 0;
    while (i < 256) {
        var p = alloc(1024);
        if (p == 0) { return 31; }
        store64(p, i);
        last = p;
        i = i + 1;
    }
    if (load64(last) != 255) { return 32; }
    return 0;
}

fn _t4_fs() {
    var path = "/tmp/cyrius_regr_fs_probe.txt";
    var msg = "hello_fs\n";
    var mlen = 9;
    var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    if (fd < 0) { return 41; }
    var w = file_write(fd, msg, mlen);
    file_close(fd);
    if (w != mlen) { return 42; }
    var rfd = file_open(path, O_RDONLY, 0);
    if (rfd < 0) { return 43; }
    var buf[64];
    var n = file_read(rfd, &buf, 64);
    file_close(rfd);
    sys_unlink(path);
    if (n != mlen) { return 44; }
    var i = 0;
    while (i < mlen) {
        if (load8(&buf + i) != load8(msg + i)) { return 45; }
        i = i + 1;
    }
    return 0;
}

fn _t5_worker(arg) {
    var x = 0;
    var i = 0;
    while (i < 100) { x = x + i; i = i + 1; }
    syscall(SYS_EXIT, 0);
    return 0;
}

fn _t5_mt() {
    var handles[32];
    var i = 0;
    while (i < 4) {
        var t = thread_create(&_t5_worker, i);
        if (t == 0) { return 51; }
        store64(&handles + i * 8, t);
        i = i + 1;
    }
    i = 0;
    while (i < 4) {
        var rj = thread_join(load64(&handles + i * 8));
        if (rj != 0) { return 52; }
        i = i + 1;
    }
    return 0;
}

var _tl_mtx = 0;
var _tl_mismatches = 0;

fn _tl_worker(arg) {
    var tid = gettid();
    thread_local_set(0, tid);
    var i = 0;
    while (i < 1000) { i = i + 1; }
    if (thread_local_get(0) != tid) {
        mutex_lock(_tl_mtx);
        _tl_mismatches = _tl_mismatches + 1;
        mutex_unlock(_tl_mtx);
    }
    syscall(SYS_EXIT, 0);
    return 0;
}

fn _t6_tl() {
    if (thread_local_init() != 1) { return 61; }
    thread_local_set(0, 0x5A5A5A5A);
    thread_local_set(7, 0xCAFEBABE);
    if (thread_local_get(0) != 0x5A5A5A5A) { return 62; }
    if (thread_local_get(7) != 0xCAFEBABE) { return 63; }
    _tl_mtx = mutex_new();
    var t1 = thread_create(&_tl_worker, 0);
    var t2 = thread_create(&_tl_worker, 0);
    var t3 = thread_create(&_tl_worker, 0);
    var t4 = thread_create(&_tl_worker, 0);
    thread_join(t1); thread_join(t2); thread_join(t3); thread_join(t4);
    if (_tl_mismatches != 0) { return 64; }
    if (thread_local_get(0) != 0x5A5A5A5A) { return 65; }
    return 0;
}

fn _at_worker(arg) {
    var p = arg;
    var i = 0;
    while (i < 500) {
        atomic_fetch_add(p, 1);
        i = i + 1;
    }
    syscall(SYS_EXIT, 0);
    return 0;
}

fn _t7_atomic() {
    var p = alloc(8);
    atomic_store(p, 0);
    if (atomic_cas(p, 0, 100) != 1) { return 71; }
    if (atomic_load(p) != 100) { return 72; }
    if (atomic_cas(p, 999, 200) != 0) { return 73; }
    if (atomic_load(p) != 100) { return 74; }
    if (atomic_fetch_add(p, 50) != 100) { return 75; }
    if (atomic_load(p) != 150) { return 76; }
    atomic_store(p, 0);
    var t1 = thread_create(&_at_worker, p);
    var t2 = thread_create(&_at_worker, p);
    var t3 = thread_create(&_at_worker, p);
    var t4 = thread_create(&_at_worker, p);
    thread_join(t1); thread_join(t2); thread_join(t3); thread_join(t4);
    if (atomic_load(p) != 2000) { return 77; }
    atomic_fence();
    return 0;
}

var _ts_mtx = 0;
var _ts_map = 0;

fn _ts_worker(arg) {
    var tid = arg;
    var i = 0;
    while (i < 50) {
        mutex_lock(_ts_mtx);
        map_u64_set(_ts_map, tid * 1000 + i, tid * 10000 + i);
        mutex_unlock(_ts_mtx);
        i = i + 1;
    }
    syscall(SYS_EXIT, 0);
    return 0;
}

fn _t8_ts() {
    _ts_mtx = mutex_new();
    _ts_map = map_u64_new();
    var t1 = thread_create(&_ts_worker, 1);
    var t2 = thread_create(&_ts_worker, 2);
    var t3 = thread_create(&_ts_worker, 3);
    var t4 = thread_create(&_ts_worker, 4);
    thread_join(t1); thread_join(t2); thread_join(t3); thread_join(t4);
    if (map_u64_size(_ts_map) != 200) { return 81; }
    var tid = 1;
    while (tid < 5) {
        var i = 0;
        while (i < 50) {
            if (map_u64_get(_ts_map, tid * 1000 + i) != tid * 10000 + i) {
                return 82;
            }
            i = i + 1;
        }
        tid = tid + 1;
    }
    return 0;
}

fn _t9_flags() {
    var fs = flags_new();
    var f_v = flags_add_bool(fs, 118, "verbose", 0, "");
    var f_n = flags_add_int(fs, 110, "count", 0, "");
    var f_o = flags_add_str(fs, 111, "output", 0, "");
    var argv = alloc(6 * 8);
    store64(argv + 0,  "prog");
    store64(argv + 8,  "-v");
    store64(argv + 16, "--count=42");
    store64(argv + 24, "-o");
    store64(argv + 32, "/tmp/out");
    store64(argv + 40, "file.cyr");
    if (flags_parse(fs, 6, argv) != 0) { return 91; }
    if (flags_get_bool(fs, f_v) != 1) { return 92; }
    if (flags_get_int(fs, f_n) != 42) { return 93; }
    if (streq(flags_get_str(fs, f_o), "/tmp/out") != 1) { return 94; }
    if (flags_positional_count(fs) != 1) { return 95; }
    if (streq(flags_positional(fs, 0), "file.cyr") != 1) { return 96; }
    return 0;
}

fn main() {
    alloc_init();
    var rc = 0;
    rc = _t1_sys_open(); if (rc != 0) { syscall(SYS_EXIT, rc); }
    rc = _t2_thread();   if (rc != 0) { syscall(SYS_EXIT, rc); }
    rc = _t3_alloc();    if (rc != 0) { syscall(SYS_EXIT, rc); }
    rc = _t4_fs();       if (rc != 0) { syscall(SYS_EXIT, rc); }
    rc = _t5_mt();       if (rc != 0) { syscall(SYS_EXIT, rc); }
    rc = _t6_tl();       if (rc != 0) { syscall(SYS_EXIT, rc); }
    rc = _t7_atomic();   if (rc != 0) { syscall(SYS_EXIT, rc); }
    rc = _t8_ts();       if (rc != 0) { syscall(SYS_EXIT, rc); }
    rc = _t9_flags();    if (rc != 0) { syscall(SYS_EXIT, rc); }
    syscall(SYS_EXIT, 99);
}

main();
