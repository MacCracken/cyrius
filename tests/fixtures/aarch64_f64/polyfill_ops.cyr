# polyfill_ops.cyr — the aarch64 f64_exp / f64_ln / f64_log2 / f64_exp2 builtins (lib/math.cyr's
# polyfills) on real ARM hardware. Exits 99 when every row holds, else the number of the first
# row that failed (the gate in programs/checks/platform_aarch64.cyr reports it).
#
# The bar is the one the 6.6.8 fdlibm ports promise on every target: finite results within
# 1 ulp of the correctly rounded value, and IEEE-754 special values by class. Until 6.6.8 this
# fixture allowed 1,024-8,192 ulp and had no special-value rows, so the 210-ulp ln, the
# 2,300-ulp exp and ln(-1.5) = +4.27e9 all passed it (CHANGELOG [6.6.8]).
include "lib/math.cyr"
include "lib/syscalls.cyr"

# 0 = finite, 1 = +inf, 2 = -inf, 3 = NaN.
fn _cls(b): i64 {
    if (((b >> 52) & 0x7FF) == 0x7FF) {
        if ((b & 0x000FFFFFFFFFFFFF) != 0) { return 3; }
        if (((b >> 63) & 1) == 1) { return 2; }
        return 1;
    }
    return 0;
}
# Within 1 ulp of `want` (monotonic integer order, so it counts across zero).
fn _ulp1(got, want): i64 {
    if (_cls(got) != 0) { return 0; }
    var g = got;
    var w = want;
    if (((g >> 63) & 1) == 1) { g = 0 - (g & 0x7FFFFFFFFFFFFFFF); }
    if (((w >> 63) & 1) == 1) { w = 0 - (w & 0x7FFFFFFFFFFFFFFF); }
    var d = g - w;
    if (d < 0) { d = 0 - d; }
    if (d > 1) { return 0; }
    return 1;
}

fn main() {
    # Exact rows.
    if (f64_exp(0) != 0x3FF0000000000000) { return 1; }                      # exp(0) = 1
    if (f64_ln(0x3FF0000000000000) != 0) { return 2; }                       # ln(1) = +0
    if (f64_log2(0x3FF0000000000000) != 0) { return 3; }                     # log2(1) = +0
    if (f64_log2(0x4020000000000000) != 0x4008000000000000) { return 4; }    # log2(8) = 3
    if (f64_log2(0x4090000000000000) != 0x4024000000000000) { return 5; }    # log2(1024) = 10
    if (f64_log2(0x3FE0000000000000) != 0xBFF0000000000000) { return 6; }    # log2(0.5) = -1
    if (f64_exp2(0x4024000000000000) != 0x4090000000000000) { return 7; }    # exp2(10) = 1024

    # Within 1 ulp of the correctly rounded value.
    if (_ulp1(f64_exp(0x3FF0000000000000), 0x4005BF0A8B145769) == 0) { return 8; }    # exp(1) = e
    if (_ulp1(f64_exp(0xBFF0000000000000), 0x3FD78B56362CEF38) == 0) { return 9; }    # exp(-1)
    if (_ulp1(f64_ln(0x4005BF0A8B145769), 0x3FF0000000000000) == 0) { return 10; }   # ln(e) = 1
    if (_ulp1(f64_exp(f64_ln(0x4000000000000000)), 0x4000000000000000) == 0) { return 11; }  # exp(ln 2)
    if (_ulp1(f64_ln(0x3FF6A09E667F3AAF), 0x3FD62E42FEFA36C8) == 0) { return 12; }   # the sqrt(2) edge (was 213 ulp)
    if (_ulp1(f64_exp(0x4080FE327CF14777), 0x70F6A49CCEACE863) == 0) { return 13; }  # exp(543.77) (was 2,313 ulp)
    if (_ulp1(f64_exp(0xC087200000000000), 0x0000000000000055) == 0) { return 14; }  # exp(-740), subnormal
    if (_ulp1(f64_exp2(0x3FE0000000000000), 0x3FF6A09E667F3BCD) == 0) { return 15; } # exp2(0.5) = sqrt(2)
    if (_ulp1(f64_ln(1), 0xC0874385446D71C3) == 0) { return 16; }                    # ln(min subnormal)

    # Special values, by class (the sign and payload of a NaN are not promised).
    if (_cls(f64_ln(0)) != 2) { return 17; }                         # ln(+0) = -inf (was -709)
    if (_cls(f64_ln(0xBFF8000000000000)) != 3) { return 18; }        # ln(-1.5) = NaN (was +4.27e9)
    if (_cls(f64_ln(0x7FF0000000000000)) != 1) { return 19; }        # ln(+inf) = +inf
    if (_cls(f64_log2(0x7FF0000000000000)) != 1) { return 20; }      # log2(+inf) = +inf (was 1024)
    if (_cls(f64_log2(0xBFE6666666666666)) != 3) { return 21; }      # log2(-0.7) = NaN
    if (_cls(f64_exp(0x408F400000000000)) != 1) { return 22; }       # exp(1000) = +inf (was negative)
    if (f64_exp(0xC3E158E460913D00) != 0) { return 23; }             # exp(-1e19) = +0 (was 1.0)
    if (f64_exp(0xFFEFFFFFFFFFFFFF) != 0) { return 24; }             # exp(-DBL_MAX) = +0 (was +inf)
    if (_cls(f64_exp2(0x409F400000000000)) != 1) { return 25; }      # exp2(2000) = +inf (was -2^-48)
    if (f64_exp2(0xFFEFFFFFFFFFFFFF) != 0) { return 26; }            # exp2(-DBL_MAX) = +0 (was 1.0)
    if (_cls(f64_exp(0x7FF8000000000000)) != 3) { return 27; }       # exp(NaN) = NaN

    return 99;
}

var r = main();
syscall(SYS_EXIT, r);
