# Fixture for _async_dns_gate (v6.4.40 — async DNS resolution on the reactor).
#
# async_resolve(rt, ns_addr, ns_port, host) builds a DNS A query, UDP-sends it to the
# nameserver, parks on the reply, and parses the first A record — returning the IPv4 as
# a network-order int (ready for async_connect). Tested hermetically: a mock DNS server
# task (on the same reactor) replies with a canned A record 42.0.0.0, so the resolver
# returns 42. Both tasks run on one reactor — task_join drives the whole round-trip.
#
# Proven fail-on-bug: the resolver returns 42 only if the query round-trips and the A
# record parses correctly (wrong txid / rcode / no-answer → -1).
# MUST exit 42.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/net.cyr"
include "lib/async.cyr"

# Mock DNS server task: on the first query, reply with a canned A-record response
# (42.0.0.0). ctx = { step, srv_fd, rt }.
fn mock_dns(ctx): i64 {
    if (load64(ctx) == 0) {
        store64(ctx, 1);
        async_wait_fd(load64(ctx + 16), load64(ctx + 8));   # park on the server socket
        return 0;
    }
    var qbuf[512];
    var caddr[16];
    var clen[8];
    store32(&clen, 16);
    syscall(SYS_RECVFROM, load64(ctx + 8), &qbuf, 512, 0, &caddr, &clen);   # learn client addr
    var r[64];
    store8(&r + 0, 0x43); store8(&r + 1, 0x42);       # txid 0x4342 (matches the resolver)
    store8(&r + 2, 0x81); store8(&r + 3, 0x80);       # QR=1, RD=1, RA=1, rcode=0
    store8(&r + 4, 0); store8(&r + 5, 1);             # QDCOUNT=1
    store8(&r + 6, 0); store8(&r + 7, 1);             # ANCOUNT=1
    store8(&r + 8, 0); store8(&r + 9, 0);
    store8(&r + 10, 0); store8(&r + 11, 0);
    store8(&r + 12, 1); store8(&r + 13, 0x78); store8(&r + 14, 0);          # question "x"
    store8(&r + 15, 0); store8(&r + 16, 1); store8(&r + 17, 0); store8(&r + 18, 1);
    store8(&r + 19, 0xC0); store8(&r + 20, 0x0C);     # answer name -> pointer to offset 12
    store8(&r + 21, 0); store8(&r + 22, 1);           # TYPE A
    store8(&r + 23, 0); store8(&r + 24, 1);           # CLASS IN
    store8(&r + 25, 0); store8(&r + 26, 0); store8(&r + 27, 0); store8(&r + 28, 0x3C);   # TTL
    store8(&r + 29, 0); store8(&r + 30, 4);           # RDLENGTH 4
    store8(&r + 31, 42); store8(&r + 32, 0); store8(&r + 33, 0); store8(&r + 34, 0);     # 42.0.0.0
    syscall(44, load64(ctx + 8), &r, 35, 0, &caddr, load32(&clen));         # sendto the reply
    return 0;
}

fn main(): i64 {
    alloc_init();
    var sport = 47671;
    var localhost = 0x0100007F;    # 127.0.0.1
    var rt = async_new();

    # mock DNS server on 127.0.0.1:sport
    var srv_t, srv = udp_socket();
    sock_reuse(srv);
    sock_bind(srv, localhost, sport);
    var mctx = alloc(24);
    store64(mctx, 0);
    store64(mctx + 8, srv);
    store64(mctx + 16, rt);
    async_spawn(rt, &mock_dns, mctx);

    # resolve via the mock nameserver — the reactor interleaves the server + resolver
    var ip = task_join(rt, async_resolve(rt, localhost, sport, "x.example"));
    async_run(rt);
    sock_close(srv);
    return ip;                     # 42 (from the canned 42.0.0.0 A record)
}
