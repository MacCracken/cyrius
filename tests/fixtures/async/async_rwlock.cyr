# Fixture for _async_rwlock_gate (v6.4.41 — async cooperative RwLock, try-acquire).
#
# async_rwlock_new / async_try_read_lock / async_read_unlock / async_try_write_lock /
# async_write_unlock — the reactor-cooperative reader/writer lock (non-blocking try
# family; the state a single-threaded reactor holds across an await). Pure state ops.
#
# Proven fail-on-bug: exercises the exclusion invariants — a writer blocks readers +
# other writers, readers share + block writers — 7 checks, sum 42 iff all hold.
# MUST exit 42.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"
include "lib/async.cyr"

fn main(): i64 {
    alloc_init();
    var lk = async_rwlock_new();
    var ok = 0;

    if (async_try_write_lock(lk) == 1) { ok = ok + 1; }   # 1: writer acquires (free)
    if (async_try_read_lock(lk) == 0) { ok = ok + 1; }    # 2: read blocked by the writer
    if (async_try_write_lock(lk) == 0) { ok = ok + 1; }   # 3: 2nd writer blocked
    async_write_unlock(lk);

    if (async_try_read_lock(lk) == 1) { ok = ok + 1; }    # 4: read after unlock
    if (async_try_read_lock(lk) == 1) { ok = ok + 1; }    # 5: 2nd reader shares
    if (async_try_write_lock(lk) == 0) { ok = ok + 1; }   # 6: write blocked by readers
    async_read_unlock(lk);
    async_read_unlock(lk);

    if (async_try_write_lock(lk) == 1) { ok = ok + 1; }   # 7: write after readers released

    return ok * 6;                                        # 7 * 6 = 42
}
