# Fixture for _async_sendrecv_gate (v6.4.39 — async socket send/recv on the reactor).
#
# async_send(rt, fd, buf, len) / async_recv(rt, fd, buf, len) park on the socket's
# write/read readiness, then do one write/read; each returns a task handle whose result
# (via task_join) is the byte count. Exercised over a real localhost connection.
#
# Proven fail-on-bug — sum is exactly 42:
#   client async_send 20 -> server recv 20    (+20)
#   server send 22       -> client async_recv (+22)
# A dropped byte or a wrong count misses 42; a failed connect exits 1.
# MUST exit 42.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/net.cyr"
include "lib/async.cyr"

fn main(): i64 {
    alloc_init();
    var port = 47663;
    var localhost = 0x0100007F;    # 127.0.0.1
    var total = 0;

    var lfd = payload(tcp_socket());
    sock_reuse(lfd);
    sock_bind(lfd, 0, port);
    sock_listen(lfd, 1);

    var rt = async_new();
    var cfd = task_join(rt, async_connect(rt, localhost, port));
    if (cfd < 0) { return 1; }
    var sfd = payload(sock_accept(lfd));

    # client async_send 20 -> server recv
    var sb[8];
    store8(&sb, 20);
    task_join(rt, async_send(rt, cfd, &sb, 1));
    var rb[8];
    sock_recv(sfd, &rb, 1);
    total = total + load8(&rb);

    # server send 22 -> client async_recv
    store8(&rb, 22);
    sock_send(sfd, &rb, 1);
    var cb[8];
    store8(&cb, 0);
    task_join(rt, async_recv(rt, cfd, &cb, 1));
    total = total + load8(&cb);

    async_run(rt);
    sock_close(cfd);
    sock_close(sfd);
    sock_close(lfd);
    return total;                  # 20 + 22 = 42
}
