# cx_host_dispatch.cyr — what a cx guest's syscalls answer on the host cxvm runs on (6.7.15).
#
# Built ONCE with cycc_cx (a .cyx is portable) and run on every host's own cxvm: locally on x86_64
# Linux and an aarch64-built cxvm under qemu (tests/gates/codegen/cx_host_dispatch.sh), and on pi,
# ecb, ach and cass (scripts/cross-os-selfhost.sh). Built natively with cycc it is that gate's x86_64
# oracle: the same raw x86-Linux numbers, issued by the kernel itself.
#
# Every call is a raw `syscall(<x86-Linux number>, …)`, the .cyx ABI. Until 6.7.15 cxvm passed the
# listed calls to the host as that number, which the aarch64 and Mach-O compilers renumber as the
# host stdlib's own: on aarch64 Linux lseek ran getxattr, kill ran lseek, exit_group exited 0 and
# fork ran close (the parent took the child branch); on arm64 macOS kill ran lseek and getppid /
# dup / lseek / sched_yield / exit_group died of SIGSYS (issues/2026-10-17-cxvm-forwards-guest-x86-
# numbers-through-host-renumbering.md).
#
# Each row sets a bit in `lin` when its answer is not x86_64 Linux's, and in `pe` when it is not
# Windows' (the PE routes; -ENOSYS, -38, where the PE peer has only a stub). One line
# `cxh lin=<mask> pe=<mask>` goes to stdout, then the run exits 77 when every row has the Linux
# answer, 78 when every row has the Windows one, and otherwise 1 + the lowest failing Linux row
# (1..10). The exit itself is the exit_group row: a 77 / 78 can only come from exit_group(77 / 78),
# and exit(3) follows it in case it returns.
var lin = 0;
var pe = 0;

fn _cxh_row(bit, linux_ok, pe_ok): i64 {
    if (linux_ok == 0) { lin = lin | bit; }
    if (pe_ok == 0) { pe = pe | bit; }
    return 0;
}

# `v` in decimal followed by "\n" at `b` (at least 24 bytes); returns the length.
fn _cxh_dec(b, v): i64 {
    var t[24];
    var n = 0;
    if (v == 0) { store8(&t, 48); n = 1; }
    while (v > 0) { store8(&t + n, 48 + v % 10); v = v / 10; n = n + 1; }
    var i = 0;
    while (i < n) { store8(b + i, load8(&t + n - 1 - i)); i = i + 1; }
    store8(b + n, 10);
    return n + 1;
}

# The fork row: 0 the Linux answer (the parent sees the child's pid; the child, which sees 0, writes
# its own getpid() to cxh_child and exits), 1 the Windows answer (-38, no child), 2 neither.
fn _cxh_fork(): i64 {
    var pid = syscall(57);
    if (pid == 0) {
        var cb[32];
        var cn = _cxh_dec(&cb, syscall(39));
        var cf = syscall(2, "cxh_child", 577, 420);   # O_WRONLY | O_CREAT | O_TRUNC
        syscall(1, cf, &cb, cn);
        syscall(3, cf);
        syscall(231, 0);
        syscall(60, 0);
    }
    if (pid == 0 - 38) { return 1; }
    if (pid <= 0) { return 2; }
    if (pid == syscall(39)) { return 2; }
    var want[32];
    var wn = _cxh_dec(&want, pid);
    var ts[16];
    syscall(228, 1, &ts);
    var deadline = load64(&ts) + 10;
    var got[32];
    while (load64(&ts) < deadline) {
        var f = syscall(2, "cxh_child", 0, 0);
        if (f >= 0) {
            var n = syscall(0, f, &got, 32);
            syscall(3, f);
            if (n == wn && memeq_cxh(&got, &want, wn) == 1) { return 0; }
        }
        syscall(24);
        syscall(228, 1, &ts);
    }
    return 2;
}

fn memeq_cxh(a, b, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# open's flags (the x86-Linux bits the guest passes; cxvm maps them to the host's): a bitmask of the
# sub-rows that did not give the Linux answer — 0 when all did. The PE peer takes the x86-Linux
# values, so Windows answers as Linux does.
fn _cxh_open(): i64 {
    var bad = 0;
    var fd = syscall(2, "cxh_f", 577, 420);   # O_WRONLY | O_CREAT | O_TRUNC
    if (fd < 0) { return 255; }
    if (syscall(1, fd, "abcdef", 6) != 6) { bad = bad | 1; }
    syscall(3, fd);
    var ex = syscall(2, "cxh_f", 193, 420);   # O_WRONLY | O_CREAT | O_EXCL on an existing file
    if (ex != 0 - 17) { bad = bad | 2; }
    if (ex >= 0) { syscall(3, ex); }
    fd = syscall(2, "cxh_f", 1025, 0);        # O_WRONLY | O_APPEND: writes land at the end
    syscall(8, fd, 0, 0);
    if (syscall(1, fd, "gh", 2) != 2) { bad = bad | 4; }
    syscall(3, fd);
    var rb[16];
    fd = syscall(2, "cxh_f", 0, 0);
    if (syscall(0, fd, &rb, 16) != 8) { bad = bad | 4; }
    syscall(3, fd);
    fd = syscall(2, "cxh_f", 513, 0);         # O_WRONLY | O_TRUNC
    syscall(3, fd);
    fd = syscall(2, "cxh_f", 0, 0);
    if (syscall(0, fd, &rb, 16) != 0) { bad = bad | 8; }
    syscall(3, fd);
    var dd = syscall(2, "cxh_f", 65536, 0);   # O_RDONLY | O_DIRECTORY on a file: -ENOTDIR
    if (dd != 0 - 20) { bad = bad | 16; }
    if (dd >= 0) { syscall(3, dd); }
    return bad;
}

# fcntl's scalar commands, the status flags in Linux bits both ways: 0 the Linux answers, 1 every
# command -38 (Windows has no fcntl), 2 neither.
fn _cxh_fcntl(): i64 {
    var fd = syscall(2, "cxh_f", 3074, 0);    # O_RDWR | O_APPEND | O_NONBLOCK
    if (fd < 0) { return 2; }
    var g1 = syscall(72, fd, 3, 0);           # F_GETFL
    var s1 = syscall(72, fd, 4, 1024);        # F_SETFL O_APPEND: O_NONBLOCK cleared
    var g2 = syscall(72, fd, 3, 0);
    var s2 = syscall(72, fd, 4, 3072);        # F_SETFL O_APPEND | O_NONBLOCK
    var g3 = syscall(72, fd, 3, 0);
    var fdf = syscall(72, fd, 1, 0);          # F_GETFD: no FD_CLOEXEC
    var d = syscall(72, fd, 1030, 10);        # F_DUPFD_CLOEXEC, the lowest fd >= 10
    var dfd = 0 - 38;
    if (d >= 0) { dfd = syscall(72, d, 1, 0); syscall(3, d); }
    syscall(3, fd);
    var ok = 1;
    if (g1 < 0 || (g1 & 3075) != 3074) { ok = 0; }
    if ((g1 & 0x20000) != 0) { ok = 0; }        # x86's O_NOFOLLOW: never reported (arm64's O_LARGEFILE)
    if (s1 != 0 || g2 < 0 || (g2 & 3075) != 1026) { ok = 0; }
    if (s2 != 0 || g3 < 0 || (g3 & 3075) != 3074) { ok = 0; }
    if (fdf != 0) { ok = 0; }
    if (d < 10 || dfd != 1) { ok = 0; }
    if (ok == 1) { return 0; }
    if (g1 == 0 - 38 && s1 == 0 - 38 && fdf == 0 - 38 && d == 0 - 38) { return 1; }
    return 2;
}

var me = syscall(39);
_cxh_row(1, me > 0, me > 0);
var pp = syscall(110);
_cxh_row(2, pp > 0, pp == 0 - 38);
var cl = syscall(3, 0 - 1);
_cxh_row(4, cl == 0 - 9, cl == 0);            # on Windows -1 is the current-process pseudo-handle
var kl = syscall(62, me, 0);
_cxh_row(8, kl == 0, kl == 0 - 38);
var du = syscall(32, 0 - 1);
_cxh_row(16, du == 0 - 9, du == 0 - 38);
var ls = syscall(8, 0 - 1, 0, 0);
_cxh_row(32, ls == 0 - 9, ls == 0 - 9);
var sy = syscall(24);
_cxh_row(64, sy == 0, sy == 0 - 38);
var fk = _cxh_fork();
_cxh_row(128, fk == 0, fk == 1);
var op = _cxh_open();
_cxh_row(256, op == 0, op == 0);
var fc = _cxh_fcntl();
_cxh_row(512, fc == 0, fc == 1);

var line[64];
store64(&line, 0x3D6E696C20687863);           # "cxh lin="
var ln = 8 + _cxh_dec(&line + 8, lin) - 1;
store8(&line + ln, 32);
store8(&line + ln + 1, 112);                  # " pe="
store8(&line + ln + 2, 101);
store8(&line + ln + 3, 61);
ln = ln + 4 + _cxh_dec(&line + ln + 4, pe);
syscall(1, 1, &line, ln);

var code = 0;
if (lin == 0) { code = 77; }
elif (pe == 0) { code = 78; }
else {
    var bitn = 1;
    while ((lin & 1) == 0) { lin = lin >> 1; bitn = bitn + 1; }
    code = bitn;
}
syscall(231, code);
syscall(60, 3);
