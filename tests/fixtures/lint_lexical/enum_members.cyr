include "lib/alloc.cyr"
enum OneLine { ERR_ONE = 1, ERR_TWO = 2 }
enum TwoPer {
    ERR_A = 1, ERR_B = 2,
    OK_C = 3
}
enum NextLine
{
    ERR_NL = 1
}
enum Plain { P_ONE = 1 }
var ERR_STATE = 0;
fn after_plain(): i64 {
    ERR_STATE = 5;
    return ERR_STATE;
}
