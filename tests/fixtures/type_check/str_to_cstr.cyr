# v5.10.1 — type-check pass 1 synthetic fixture.
# Verifies that `var s: Str = ...; foo(s);` where foo's first
# param is NOT `: Str`-annotated emits a warning at the call
# site when CYRIUS_TYPE_CHECK=1 is set.
#
# Manual verify:
#   CYRIUS_TYPE_CHECK=1 cat tests/fixtures/type_check/str_to_cstr.cyr \
#     | build/cc5 > /dev/null 2>&1 \
#     | grep "passing Str-typed 's' to 'takes_cstring'"
#
# Expected stderr line on user main (line 14):
#   warning:<source>:14: passing Str-typed 's' to 'takes_cstring'
#       which expects a cstring (use str_data(s) or annotate
#       the param `: Str`)
#
# Default (no env): no warning fires; cc5 byte-identical
# self-host. Formal check.cyr gate lands at v5.10.2 when the
# stdlib annotation pass cleans up legitimate-call false
# positives (e.g., `str_len(s: Str)`-style fns currently
# missing the param annotation).
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/alloc.cyr"

fn takes_cstring(s) {
    var n = 0;
    while (load8(s + n) != 0) { n = n + 1; }
    return n;
}

fn main() {
    alloc_init();
    var s: Str = str_from("hello");
    var n = takes_cstring(s);
    syscall(60, n);
}

main();
