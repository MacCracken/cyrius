# Test: the Windows command-line tokenizer (_args_tokenize_utf16).
#
# args_win.cyr feeds GetCommandLineW (one UTF-16LE string) through the
# shared, target-agnostic _args_tokenize_utf16 (lib/args.cyr) to produce
# the SAME NUL-joined blob the Linux branch builds. The parse is pure (no
# syscall), so we exercise it here on Linux with hand-built UTF-16 input —
# the riskiest part of the v6.0.54 Windows args branch, run-verified before
# it ever reaches cass. See CHANGELOG [6.0.54].

include "lib/alloc.cyr"
include "lib/args.cyr"
include "lib/assert.cyr"

# Write ASCII cstr `src` into `dst` as UTF-16LE (low byte = char, high = 0)
# + a double-NUL terminator — i.e. exactly what GetCommandLineW returns.
fn _mk_wide(dst, src) {
    var i = 0;
    var o = 0;
    while (load8(src + i) != 0) {
        store8(dst + o, load8(src + i));
        store8(dst + o + 1, 0);
        o = o + 2;
        i = i + 1;
    }
    store8(dst + o, 0);
    store8(dst + o + 1, 0);
    return o;
}

# 1 if the NUL-terminated cstr at `p` equals `expected`.
fn _streq_at(p, expected) {
    var i = 0;
    var a = 0;
    var b = 0;
    while (1) {
        a = load8(p + i);
        b = load8(expected + i);
        if (a != b) { return 0; }
        if (a == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# argc/argv over the NUL-joined blob — same logic the real argc()/argv(n)
# use (the blob format is identical across Linux + Windows).
fn _blob_argc(buf, len) {
    var count = 0;
    var i = 0;
    while (i < len) {
        if (load8(buf + i) == 0) { count = count + 1; }
        i = i + 1;
    }
    return count;
}
fn _blob_argv(buf, len, n) {
    if (n == 0) { return buf; }
    var count = 0;
    var i = 0;
    while (i < len) {
        if (load8(buf + i) == 0) {
            count = count + 1;
            if (count == n) { return buf + i + 1; }
        }
        i = i + 1;
    }
    return 0;
}

alloc_init();

var wbuf = alloc(4096);
var blob = alloc(4096);
var len = 0;

# Case 1: simple split — the canonical "prog --flag value" shape.
_mk_wide(wbuf, "prog --cost 70B");
len = _args_tokenize_utf16(wbuf, blob, 4096);
test_group("simple split");
assert_eq(_blob_argc(blob, len), 3, "argc = 3");
assert(_streq_at(_blob_argv(blob, len, 0), "prog") == 1, "argv0 = prog");
assert(_streq_at(_blob_argv(blob, len, 1), "--cost") == 1, "argv1 = --cost");
assert(_streq_at(_blob_argv(blob, len, 2), "70B") == 1, "argv2 = 70B");

# Case 2: quoted program path with an embedded space; quotes stripped,
# the space inside the quotes is preserved as part of argv[0].
_mk_wide(wbuf, "\"my prog\" --x");
len = _args_tokenize_utf16(wbuf, blob, 4096);
test_group("quoted path");
assert_eq(_blob_argc(blob, len), 2, "argc = 2");
assert(_streq_at(_blob_argv(blob, len, 0), "my prog") == 1, "argv0 = my prog");
assert(_streq_at(_blob_argv(blob, len, 1), "--x") == 1, "argv1 = --x");

# Case 3: runs of spaces collapse to one separator (no empty args).
_mk_wide(wbuf, "prog   --x");
len = _args_tokenize_utf16(wbuf, blob, 4096);
test_group("collapsed spaces");
assert_eq(_blob_argc(blob, len), 2, "argc = 2");
assert(_streq_at(_blob_argv(blob, len, 0), "prog") == 1, "argv0 = prog");
assert(_streq_at(_blob_argv(blob, len, 1), "--x") == 1, "argv1 = --x");

# Case 4: tab is also a separator.
_mk_wide(wbuf, "prog\t--x");
len = _args_tokenize_utf16(wbuf, blob, 4096);
test_group("tab separator");
assert_eq(_blob_argc(blob, len), 2, "argc = 2");
assert(_streq_at(_blob_argv(blob, len, 1), "--x") == 1, "argv1 = --x");

# Case 5: the real ai-hwaccel acceptance shape — argv[0] present, --version.
_mk_wide(wbuf, "ai-hwaccel.exe --version");
len = _args_tokenize_utf16(wbuf, blob, 4096);
test_group("version shape");
assert_eq(_blob_argc(blob, len), 2, "argc = 2");
assert(_streq_at(_blob_argv(blob, len, 0), "ai-hwaccel.exe") == 1, "argv0 = ai-hwaccel.exe");
assert(_streq_at(_blob_argv(blob, len, 1), "--version") == 1, "argv1 = --version");

# Case 6: single token (program name only) — argc = 1.
_mk_wide(wbuf, "prog");
len = _args_tokenize_utf16(wbuf, blob, 4096);
test_group("single token");
assert_eq(_blob_argc(blob, len), 1, "argc = 1");
assert(_streq_at(_blob_argv(blob, len, 0), "prog") == 1, "argv0 = prog");

# Case 7: an empty quoted arg "" is preserved (argc=2), matching Linux +
# Windows CommandLineToArgvW — the quote sets in_arg so it isn't dropped.
_mk_wide(wbuf, "prog \"\"");
len = _args_tokenize_utf16(wbuf, blob, 4096);
test_group("empty quoted arg");
assert_eq(_blob_argc(blob, len), 2, "argc = 2 (empty arg kept)");
assert(_streq_at(_blob_argv(blob, len, 0), "prog") == 1, "argv0 = prog");
assert(_streq_at(_blob_argv(blob, len, 1), "") == 1, "argv1 = empty");

# Case 8: a non-ASCII wide char (U+0100, low byte 0) must NOT inject a NUL
# and split the arg — it down-converts to '?' and the arg stays whole.
store8(wbuf + 0, 112); store8(wbuf + 1, 0);    # 'p'
store8(wbuf + 2, 114); store8(wbuf + 3, 0);    # 'r'
store8(wbuf + 4, 111); store8(wbuf + 5, 0);    # 'o'
store8(wbuf + 6, 103); store8(wbuf + 7, 0);    # 'g'
store8(wbuf + 8, 0);   store8(wbuf + 9, 1);    # U+0100 (low byte 0)
store8(wbuf + 10, 0);  store8(wbuf + 11, 0);   # double-NUL terminator
len = _args_tokenize_utf16(wbuf, blob, 4096);
test_group("non-ASCII no-split");
assert_eq(_blob_argc(blob, len), 1, "argc = 1 (U+0100 did not split)");
assert(_streq_at(_blob_argv(blob, len, 0), "prog?") == 1, "argv0 = prog?");

var r = assert_summary();
