alloc_init();

# byte 0 must stay 0 — pre-fix the >=4096 writes wrapped down onto it.
assert_eq(load8(&huge + 0),    0,   "huge[0] = 0 (not clobbered by >4096 wrap)");
# last 12-bit-clean offset
assert_eq(load8(&huge + 4095), 111, "huge[4095] = 111 (<4096, single add)");
# the wrap point: b_i==4096, b_i&0xFFF==0
assert_eq(load8(&huge + 4096), 222, "huge[4096] = 222 (the 12-bit-mask wrap point)");
assert_eq(load8(&huge + 4097), 123, "huge[4097] = 123 (lo+hi adds)");
# hi-chunk boundary
assert_eq(load8(&huge + 8191), 88,  "huge[8191] = 88 (hi-chunk=1, max)");
assert_eq(load8(&huge + 8192), 199, "huge[8192] = 199 (hi-chunk=2, LSL#12 imm=2)");
assert_eq(load8(&huge + 8199), 7,   "huge[8199] = 7 (last element)");

var _exit_code = assert_summary();
syscall(60, _exit_code);
