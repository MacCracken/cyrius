# aarch64_imm12_frame_field.tcyr — guards the aarch64 ADD/SUB-immediate
# 12-bit-mask class fixed in v6.2.21 (EADDIMM_X1 struct-field offsets +
# EPATCHFRAME stack frames). ADD/SUB-imm carries only a 12-bit immediate
# (optionally LSL #12); an unguarded `& 0xFFF` silently corrupted stack frames
# (EPATCHFRAME) and struct-field offsets (EADDIMM_X1) >= 4096.
#
# `caller` builds a > 4096-byte frame (600 scalar locals) and calls `clobber`
# (another big frame); iff the caller's frame was under-allocated, clobber's
# frame OVERLAPS the caller's high locals and corrupts them, so the sum comes
# out wrong. Passes trivially on x86 (no 12-bit imm limit); on aarch64 it FAILS
# without the fix (verified under qemu-aarch64: old compiler exits non-zero).
# EADDIMM_X1's >= 4096 field path is not runtime-observable from source (structs
# cap at 256 fields; no multi-level field writes) — it is disasm-verified in the
# v6.2.21 closeout instead.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/assert.cyr"

