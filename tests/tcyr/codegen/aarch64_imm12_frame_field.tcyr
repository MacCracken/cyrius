fn main(): i64 {
    alloc_init();
    test_group("aarch64 imm12-mask: >= 4096-byte frame survives a call (EPATCHFRAME)");
    assert_eq(caller(), 3999, "600-local (>=4096B) frame: high locals survive a helper call");
