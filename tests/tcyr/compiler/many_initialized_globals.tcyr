# All 1100 deferred-init globals ran their initializer before main:
assert_eq(g0, 3, "first call-init global (g0) initialized");
assert_eq(g549, 3, "a middle call-init global (g549) initialized");
assert_eq(g1099, 3, "the 1100th call-init global (g1099) — past the old 1024 cap — initialized");
assert_eq(g0 + g549 + g1099, 9, "sum across the low/mid/high globals (3+3+3)");

var r = assert_summary();
