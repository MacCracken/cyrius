# async_alloc_refused.tcyr — when the runtime's allocator refuses, every Linux reactor verb that
# builds a context returns its failure value instead of storing through a null pointer.
#
# ⛔ WHY. async_connect / async_accept / async_recv / async_send / async_resolve /
# async_interval / async_spawn_process / async_with_timeout each took `alloc_via(rt's allocator,
# N)` and wrote the context fields straight into it. `async_new_in(a)` exists precisely so a
# caller can hand the runtime a bounded arena — and when that arena was full, the first store
# was `store64(0, 0)`: SIGSEGV. async_spawn itself already answered an exhausted allocator with
# 0, so these now do the same (async_with_timeout answers -1, its existing failure value, and
# closes the timerfd it had just opened). async_interval also closes its timerfd when no task
# could own it. CHANGELOG [6.6.10]
#
# 6.6.20: the Windows IOCP peer (lib/async_win.cyr) had the same seven unchecked contexts, and
# the agnos peer two (async_recv / async_send) — 6.6.10 checked the Linux and macOS arms, and
# the alloc census matched only the `alloc(` spelling, so it never saw `alloc_via(`. The Windows
# group below runs the same rows on PE (wine locally; check.sh compiles it for PE). CHANGELOG [6.6.20]
#
# Linux x86_64 + aarch64 (the epoll reactor in lib/async.cyr) and Windows (the IOCP peer); other
# targets print a named SKIP.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/atomic.cyr"
include "lib/fnptr.cyr"
include "lib/async.cyr"
include "lib/assert.cyr"

var _aar_refuse = 0;
var _aar_rt = 0;
# An Allocator that serves `alloc` until told to refuse: mode 1 refuses everything, mode 2 only
# the 64-byte task struct (TASK_SIZE), so a verb gets its context and then fails to spawn.
fn _aar_alloc(state, size): i64 {
    if (_aar_refuse == 1) { return 0; }
    if (_aar_refuse == 2) { if (size == 64) { return 0; } }
    return alloc(size);
}
fn _aar_realloc(state, p, old, sz): i64 { return 0; }
fn _aar_free(state, p): i64 { return 0; }
fn _aar_reset(state): i64 { return 0; }
fn _aar_task(arg): i64 { return 0; }
fn _aar_tick(arg): i64 { return 0; }
# Parks on an fd nothing ever writes: a handle that never completes.
fn _aar_park(fd): i64 { async_wait_fd(_aar_rt, fd); return 0; }

#ifdef CYRIUS_TARGET_LINUX
# The lowest free fd: a leaked fd moves it up.
fn _aar_low_fd(): i64 {
    var p[16];
    if (sys_pipe(&p) < 0) { return 0 - 1; }
    var lo = load32(&p);
    sys_close(load32(&p));
    sys_close(load32(&p + 4));
    return lo;
}

fn _aar_rows(): i64 {
    test_group("async reactor verbs under a refusing allocator");
    var al = allocator_new(&_aar_alloc, &_aar_realloc, &_aar_free, &_aar_reset, 0);
    var rt = async_new_in(al);
    _aar_rt = rt;
    assert_eq(rt != 0, 1, "runtime built while the allocator still serves");
    var never[16];
    assert_eq(sys_pipe(&never) >= 0, 1, "a pipe nothing will write");
    var hp = async_spawn(rt, &_aar_park, load32(&never));
    var h = async_spawn(rt, &_aar_task, 0);
    assert_eq(h != 0, 1, "a task spawned while the allocator still serves");
    var buf = alloc(64);
    var fd0 = _aar_low_fd();
    _aar_refuse = 1;
    assert_eq(async_connect(rt, 0x0100007F, 9), 0, "async_connect: 0, no store through null");
    assert_eq(async_accept(rt, 0), 0, "async_accept: 0");
    assert_eq(async_recv(rt, 0, buf, 64), 0, "async_recv: 0");
    assert_eq(async_send(rt, 1, buf, 1), 0, "async_send: 0");
    assert_eq(async_resolve(rt, 0x0100007F, 53, "example.com"), 0, "async_resolve: 0");
    assert_eq(async_spawn_process(rt, "/bin/true", 0, 0), 0, "async_spawn_process: 0");
    assert_eq(async_interval(rt, &_aar_tick, 0, 50, 0), 0, "async_interval: 0");
    assert_eq(async_with_timeout(rt, h, 50), 0 - 1, "async_with_timeout: -1 (no sentinel, no deadline)");
    assert_eq(_aar_low_fd(), fd0, "no timerfd leaked by async_interval / async_with_timeout");
    # Mode 2: the context is served, the task struct is not.
    _aar_refuse = 2;
    assert_eq(async_interval(rt, &_aar_tick, 0, 50, 0), 0, "async_interval: 0 when its task cannot be spawned");
    # Without the sentinel check this pumped for a handle that never completes: a hang.
    assert_eq(async_with_timeout(rt, hp, 50), 0 - 1, "async_with_timeout: -1 when the deadline sentinel cannot be spawned");
    assert_eq(_aar_low_fd(), fd0, "no timerfd leaked when the task spawn is refused");
    _aar_refuse = 0;
    return 0;
}
#endif

#ifdef CYRIUS_TARGET_WIN
fn _aar_rows_win(): i64 {
    test_group("Windows IOCP verbs under a refusing allocator");
    var al = allocator_new(&_aar_alloc, &_aar_realloc, &_aar_free, &_aar_reset, 0);
    var rt = async_new_in(al);
    _aar_rt = rt;
    assert_eq(rt != 0, 1, "runtime built while the allocator still serves");
    var h = async_spawn(rt, &_aar_task, 0);
    assert_eq(h != 0, 1, "a task spawned while the allocator still serves");
    var buf = alloc(64);
    _aar_refuse = 1;
    assert_eq(async_connect(rt, 0x0100007F, 9), 0, "async_connect: 0, no store through null");
    assert_eq(async_accept(rt, 0), 0, "async_accept: 0");
    assert_eq(async_recv(rt, 0, buf, 64), 0, "async_recv: 0");
    assert_eq(async_send(rt, 1, buf, 1), 0, "async_send: 0");
    assert_eq(async_resolve(rt, 0x0100007F, 53, "example.com"), 0, "async_resolve: 0");
    assert_eq(async_interval(rt, &_aar_tick, 0, 50, 0), 0, "async_interval: 0");
    assert_eq(async_with_timeout(rt, h, 50), 0 - 1, "async_with_timeout: -1 (no sentinel, no deadline)");
    _aar_refuse = 0;
    return 0;
}
#endif

fn main(): i64 {
    alloc_init();
    #ifdef CYRIUS_TARGET_LINUX
    _aar_rows();
    #endif
    #ifdef CYRIUS_TARGET_WIN
    _aar_rows_win();
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    #ifndef CYRIUS_TARGET_WIN
    println("    SKIP: these rows cover the Linux reactor and the Windows IOCP peer; this target has its own");
    #endif
    #endif
    return assert_summary();
}

var exit_code = main();
sys_exit(exit_code);
