# async_multi_waiter.tcyr — v6.5.26: the async reactor must support MORE THAN ONE waiter,
# including two on the SAME fd.
#
# ⛔ THIS IS THE FIRST TEST OF THE ASYNC RUNTIME. `grep -rln 'async_run\|async_spawn'
# tests/tcyr/` returned NOTHING before this file — the whole reactor (async_spawn,
# async_run, _async_step, _async_wait_events) shipped from v6.4.33 with zero corpus
# coverage. That is how the defect below survived four minors.
#
# THE DEFECT. `_async_wait_events` stored the TASK POINTER in the epoll data slot, so an fd
# identified exactly ONE waiter, and its `EPOLL_CTL_ADD` return was UNCHECKED — a second
# waiter on the same fd got `-EEXIST` and was SILENTLY LOST: it parked and nothing ever woke
# it. The wake path then `EPOLL_CTL_DEL`'d the fd unconditionally, dropping the registration
# for anyone still parked on the other direction, and `epoll_wait` had maxevents=1.
#
# ⭐ WHY IT MATTERS BEYOND A LOST WAKEUP. This is what made stiva's `exec -it` (a TTY relay:
# two independent directions inside one task) and a select!-style multiplexed server
# inexpressible — filed 2026-07-25 as needing STACKLESS COROUTINES and pinned to v6.5.33-.34
# behind an IR substrate. It needed neither: the park/resume runtime already worked, the
# waiter REGISTRY just could not hold two entries. A missing-language-feature filing that
# was really a lost-wakeup bug in ~20 lines of lib code.
#
# ⭐ WHAT MUTATION-TESTING ACTUALLY ESTABLISHED, which is not what the first pass assumed.
# The v6.5.26 fix has THREE parts: (a) `epoll_data = FD` + walking the task list on wake,
# (b) an `EPOLL_CTL_ADD -EEXIST -> MOD` fallback at REGISTRATION, (c) MOD-the-remainder
# instead of an unconditional DEL at WAKE. Measured, one mutation at a time:
#   * disable (b) alone  -> all axes GREEN. (c) re-registers the surviving waiter's mask one
#     wake later, so the runtime self-heals with a single extra epoll round trip.
#   * disable (c) alone  -> all axes GREEN. (b) had already registered the UNION mask, so a
#     single event carries both directions and both waiters wake from it.
#   * disable BOTH       -> HANGS (killed at the 30 s timeout, no summary printed).
# So (b) and (c) are REDUNDANT INDIVIDUALLY and JOINTLY LOAD-BEARING — each covers the
# other's absence. That is defence in depth, not dead code, and it is the honest description:
# a green axis here does not prove (b) or (c) separately, and no single-line mutation can.
# (a) is the part that carries axes 1-4 on its own.
#
# ⚠ Do not "simplify" by deleting either (b) or (c) on the grounds that the suite stays
# green — the suite stays green for EITHER deletion and hangs for BOTH.
#
# ⛔ PLATFORM REALITY, MEASURED ON THE REAL HOSTS — not reasoned from source.
# v6.5.26 shipped this file OUTSIDE crossos/ on the claim that "the reactor is epoll-only",
# and that claim was half wrong and cost a release of coverage:
#   * pi (aarch64 LINUX) runs it — epoll exists there. **23/23 on real hardware.** It was
#     never run only because nobody built it for aarch64 and pushed it. Pure omission.
#   * cass (Windows/PE) cannot COMPILE it: the Windows peer has no `sys_pipe` (Windows makes
#     pipes via CreatePipe/0xF004), and async_win.cyr is IOCP with no readiness registry.
#   * ecb / ach (macOS) RUN it as of v6.5.27, on a real kqueue reactor
#     (`lib/async_macos.cyr` + `sys_kqueue`/`sys_kevent`, private-alias band 1362/1363 →
#     BSD 362/363). Before that macOS had NO reactor: it fell into the epoll body on a
#     kernel with no epoll, and `lib/syscalls_macos.cyr` declared SYS_EPOLL_* as LINUX
#     numbers the macho translators do not route — dead-but-armed constants of the same
#     class as SIGCHLD=17-is-Darwin's-SIGSTOP.
#     ⭐ kqueue needs no union mask and no modify-on-conflict: it keys by (ident, FILTER),
#     so the two directions of one fd are independent registrations. The epoll bug this
#     file exists for is structurally impossible there.
# So the guards below are per-CAPABILITY, and each SKIP NAMES the missing capability instead
# of the file quietly not existing in the gate. A skip you can read beats a test you deleted.
#
# Each axis below is a shape that CANNOT pass against the pre-fix runtime.# Each axis below is a shape that CANNOT pass against the pre-fix runtime.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/assert.cyr"
# ⚠ `lib/vec.cyr` is explicit and load-bearing for the NON-Linux targets. Without it this
# file compiles on Linux (the undefined `vec_get` is pruned as unreachable, warning only)
# and HARD-FAILS on PE and Mach-O, where the same reference is a reachable-undef error.
# That per-target disagreement is filed separately; here the fix is simply to declare what
# is used. It is also why this file could not just be dropped into crossos/ unchanged.
include "lib/async.cyr"

var _fds_a[2];          # pipe A. ⚠ pipe(2) writes two i32 fds (8 B total), so the
                        # ends are load32(@0) and load32(@4) — a load64 here packs BOTH
                        # fds into one garbage value, which parks the reactor on an fd that
                        # does not exist and hangs async_run. Cost a debug cycle.
var _fds_b[2];          # pipe B
var _hits = 0;          # how many waiter tasks observed their fd ready
var _order = 0;         # packed wake order, to prove BOTH ran (not just one twice)

# ⚠ THE POLL-STRUCTURED CONTRACT, which the first draft of this file got wrong and hung on:
# `async_wait_fd` PARKS the task and RETURNS — it does not block. A task must therefore
# return immediately after parking and resume FROM THE TOP when woken, using its own
# progress flag to know which step it is on. Falling through after the park call makes the
# body run once, park, run again from the top, park again... forever. `_async_step` only
# marks a task DONE if it is still TASK_READY when its fn returns, so a parked-and-fallen-
# through task never completes and `async_run` never returns. (Documented at
# `_async_wait_events`; costing a debug cycle here is why it is restated at the call site.)
var _p1 = 0; var _p2 = 0; var _pb = 0; var _prw = 0; var _psr = 0; var _psw = 0;
var _sp[2];             # socketpair — readable AND writable on ONE fd

# Two tasks that park on the SAME read fd. Before the fix, exactly one of these could ever
# be registered; the other parked forever and was never woken.
fn _waiter_same_1(arg): i64 {
    if (_p1 == 0) {
        _p1 = 1;
        if (async_wait_fd(arg, load32(&_fds_a)) < 0) { return 0 - 1; }
        return 0;
    }
    _hits = _hits + 1;
    _order = _order | 1;
    return 1;
}
fn _waiter_same_2(arg): i64 {
    if (_p2 == 0) {
        _p2 = 1;
        if (async_wait_fd(arg, load32(&_fds_a)) < 0) { return 0 - 1; }
        return 0;
    }
    _hits = _hits + 1;
    _order = _order | 2;
    return 2;
}

# Two tasks on DIFFERENT fds — the case that worked before, kept so a fix that broke it
# cannot pass.
fn _waiter_pipe_b(arg): i64 {
    if (_pb == 0) {
        _pb = 1;
        if (async_wait_fd(arg, load32(&_fds_b)) < 0) { return 0 - 1; }
        return 0;
    }
    _hits = _hits + 1;
    _order = _order | 4;
    return 3;
}

# A task parked on read-OR-write of one fd via the new async_wait_rw. Registering both
# directions is two event bits on one fd, which the single-waiter design could not express.
fn _waiter_rw(arg): i64 {
    if (_prw == 0) {
        _prw = 1;
        if (async_wait_rw(arg, load32(&_fds_b + 4)) < 0) { return 0 - 1; }
        return 0;
    }
    _hits = _hits + 1;
    _order = _order | 8;
    return 4;
}

# Axis-5 pair: two waiters on ONE socketpair fd wanting OPPOSITE directions. This is the
# case the MOD fallback exists for — the reader ADDs EPOLLIN, then the writer's ADD gets
# -EEXIST and must MOD the registration to EPOLLIN|EPOLLOUT or one of them never wakes.
fn _waiter_sp_read(arg): i64 {
    if (_psr == 0) {
        _psr = 1;
        if (async_wait_fd(arg, load32(&_sp)) < 0) { return 0 - 1; }
        return 0;
    }
    _hits = _hits + 1;
    _order = _order | 16;
    return 5;
}
fn _waiter_sp_write(arg): i64 {
    if (_psw == 0) {
        _psw = 1;
        if (async_wait_writable(arg, load32(&_sp)) < 0) { return 0 - 1; }
        return 0;
    }
    _hits = _hits + 1;
    _order = _order | 32;
    return 6;
}

fn main(): i64 {
    test_group("async reactor: multiple waiters, including two on one fd (v6.5.26)");
    #ifdef CYRIUS_TARGET_WIN
    println("    SKIP: Windows has no sys_pipe and async_win.cyr is IOCP (completion, not readiness) - no waiter registry to exercise");
    #endif
    #ifndef CYRIUS_TARGET_WIN

    # --- axis 1: TWO waiters on the SAME fd both wake ---
    # The core of the fix. Pre-fix: one is silently dropped.
    assert_eq(sys_pipe(&_fds_a), 0, "pipe A created");
    var rt = async_new();
    assert(rt != 0, "runtime created");
    _hits = 0; _order = 0; _p1 = 0; _p2 = 0; _pb = 0; _prw = 0;
    assert(async_spawn(rt, &_waiter_same_1, rt) != 0, "spawned waiter 1 on pipe A");
    assert(async_spawn(rt, &_waiter_same_2, rt) != 0, "spawned waiter 2 on the SAME fd");
    sys_write(load32(&_fds_a + 4), "x", 1);          # make pipe A readable
    async_run(rt);
    assert_eq(_hits, 2, "BOTH waiters on one fd woke (pre-fix: 1, the second was lost)");
    assert_eq(_order, 3, "both distinct tasks ran, not one of them twice");

    # --- axis 2: waiters on DIFFERENT fds both wake (no regression) ---
    assert_eq(sys_pipe(&_fds_b), 0, "pipe B created");
    var rt2 = async_new();
    _hits = 0; _order = 0; _p1 = 0; _p2 = 0; _pb = 0; _prw = 0;
    assert(async_spawn(rt2, &_waiter_same_1, rt2) != 0, "spawned a pipe-A waiter");
    assert(async_spawn(rt2, &_waiter_pipe_b, rt2) != 0, "spawned a pipe-B waiter");
    sys_write(load32(&_fds_b + 4), "y", 1);
    async_run(rt2);
    assert_eq(_hits, 2, "waiters on two different fds both woke");
    assert_eq(_order, 5, "the pipe-A and pipe-B tasks both ran");

    # --- axis 3: async_wait_rw parks on both directions of one fd ---
    # A pipe write end is immediately writable, so this must wake on EPOLLOUT.
    var rt3 = async_new();
    _hits = 0; _order = 0; _p1 = 0; _p2 = 0; _pb = 0; _prw = 0;
    assert(async_spawn(rt3, &_waiter_rw, rt3) != 0, "spawned an async_wait_rw waiter");
    async_run(rt3);
    assert_eq(_hits, 1, "async_wait_rw woke on the writable direction");
    assert_eq(_order, 8, "the rw task is the one that ran");

    # --- axis 4: three waiters, two sharing an fd, all in ONE runtime ---
    # The multiplexed-server shape: N waiters, one runtime, no direction starved.
    var rt4 = async_new();
    _hits = 0; _order = 0; _p1 = 0; _p2 = 0; _pb = 0; _prw = 0;
    assert(async_spawn(rt4, &_waiter_same_1, rt4) != 0, "spawned share-1");
    assert(async_spawn(rt4, &_waiter_same_2, rt4) != 0, "spawned share-2 (same fd)");
    assert(async_spawn(rt4, &_waiter_pipe_b, rt4) != 0, "spawned the other-fd waiter");
    sys_write(load32(&_fds_a + 4), "z", 1);
    sys_write(load32(&_fds_b + 4), "w", 1);
    async_run(rt4);
    assert_eq(_hits, 3, "all THREE waiters woke (two of them sharing one fd)");
    assert_eq(_order, 7, "all three distinct tasks ran");

    # --- axis 5 (THE `exec -it` SHAPE): one fd, two waiters, OPPOSITE directions ---
    # A connected socketpair end is immediately WRITABLE, and becomes READABLE once its peer
    # writes — so both waiters have real work and neither can be starved. This is the axis
    # the MOD fallback is load-bearing for; see the note at the top of this file.
    if (sys_socketpair(1, 1, 0, &_sp) == 0) {          # AF_UNIX, SOCK_STREAM
        var rt5 = async_new();
        _hits = 0; _order = 0; _psr = 0; _psw = 0;
        assert(async_spawn(rt5, &_waiter_sp_read, rt5) != 0, "spawned the READ waiter on the socketpair fd");
        assert(async_spawn(rt5, &_waiter_sp_write, rt5) != 0, "spawned the WRITE waiter on the SAME fd");
        sys_write(load32(&_sp + 4), "q", 1);           # peer writes -> our end becomes readable
        async_run(rt5);
        assert_eq(_hits, 2, "BOTH opposite-direction waiters on ONE fd woke (the exec -it shape)");
        assert_eq(_order, 48, "the reader AND the writer each ran exactly once");
        sys_close(load32(&_sp)); sys_close(load32(&_sp + 4));
    } else {
        println("    SKIP axis 5: sys_socketpair unavailable on this target");
    }

    sys_close(load32(&_fds_a)); sys_close(load32(&_fds_a + 4));
    sys_close(load32(&_fds_b)); sys_close(load32(&_fds_b + 4));

    #endif

    var r = assert_summary();
    return r;
}
var ec = main();
syscall(60, ec);
