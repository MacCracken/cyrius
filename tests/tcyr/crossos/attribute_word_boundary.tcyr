# attribute_word_boundary.tcyr — v6.6.6 bite 5a.
#
# The lexer's `#` branch matched each attribute name as a byte PREFIX and then
# kept lexing the SAME line, so a comment whose first word merely STARTS with an
# attribute name was parsed as code. `#ioctl numbers` lexed as `#io` + the
# identifier `ctl`; the diagnostic pointed at the comment's second word. Fixed by
# LEXATTRBOUND (src/frontend/lex.cyr): an attribute name must be followed by
# whitespace, end of input or `(`.
#
# ⚠ THIS FILE'S REAL ASSERTIONS ARE THE COMMENTS THEMSELVES. Every `#` line below
# that opens with an attribute prefix is a compile-time assertion: under the old
# lexer this file does not compile at all. The runtime assertions are the OTHER
# half — the attributes still arm — because the wrong fix here is "make every `#`
# a comment", and that fix compiles this file just as happily.
#
# Cross-OS: the `#` branch is shared frontend code, so the defect and the fix are
# identical on x86-linux, aarch64, macOS (Mach-O) and Windows (PE). This lives in
# tests/tcyr/crossos/ so the release gate runs it on ecb/ach/cass/pi rather than
# on x86 alone.
#
# Coverage:
#   1. an attribute-prefixed comment does not change the program (10 shapes,
#      three of them `name(` — the review round found that taking `(` as a
#      boundary at all ten sites left `#io(fd) reads a byte` still failing with
#      `unexpected '('`; only `#deprecated(`, `#pe_import(` and `#assert(` end
#      at a paren now)
#   2. #inline still arms on a fn the compiler CAN inline
#   3. #pure / #io / #alloc still arm and still run their fns
#   4. #must_use still arms and its fn still returns its value
#   5. #regalloc still arms on a same-line fn definition
#   6. the SAME root cause in the PREPROCESSOR (review round): the three ISDERIVE*
#      probes in src/frontend/lex_pp.cyr matched `#derive(Serialize)` as an 18-byte
#      prefix, so `#derive(Serialize)x note` — a COMMENT — armed the derive
#      machinery and CHANGED THE EMITTED BINARY with rc=0 either way. That one is
#      codegen-visible, which is why it belongs on the cross-OS hosts and not only
#      in the x86 shell gate. (PP_IS_HOST_ONLY, the other half, only scans INCLUDED
#      files, so it needs a companion file and stays in the shell gate.)
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"

#ioctl numbers
#allocator notes
#inlined by hand
#assertion holds
#purely local
#naked-eye check
#iota
#io(fd) reads a byte
#naked(truth) hurts
#pure(ly) awesome

#inline
fn awb_inc(a): i64 { return a + 1; }

#io
fn awb_io(): i64 { return 10; }

#alloc
fn awb_alloc(): i64 { return 20; }

#must_use
fn awb_must(): i64 { return 30; }

#regalloc fn awb_reg(a, b): i64 { var c = a + b; return c * 2; }

#derive(Serialize)x note
#derive(Deserialize)x note
#derive(accessors)x note

#derive(accessors)
struct awb_pt { x: i64; y: i64; }
var awb_p[2];

#pure
fn awb_pure(a): i64 { return a * 2; }

fn main(): i64 {
    test_group("attribute-prefixed comments are comments");
    # Each of the ten `#`-lines above is a comment the old lexer read as code — the
    # seven from the filing's table plus the three `name(` shapes the review round
    # added. If any of them had armed, this file would not have compiled, so
    # reaching here at all is the assertion; the values below make it explicit.
    var ten = 10;
    assert_eq(ten, 10, "the file compiled with 10 attribute-prefixed comments");
    # Same for the three `#derive(...)x note` lines: under the old preprocessor the
    # first of them armed ISDERIVE and the derive handler died on the line after it.
    assert_eq(ten - 7, 3, "the file compiled with 3 derive-prefixed comments");

    test_group("every attribute still arms and still runs");
    assert_eq(awb_inc(41), 42, "#inline fn returns its value");
    assert_eq(awb_io(), 10, "#io fn returns its value");
    assert_eq(awb_alloc(), 20, "#alloc fn returns its value");
    assert_eq(awb_must(), 30, "#must_use fn returns its value");
    assert_eq(awb_reg(3, 4), 14, "#regalloc fn on the same line still defines it");
    assert_eq(awb_pure(21), 42, "#pure fn returns its value");

    test_group("#derive still arms after the boundary");
    awb_pt_set_x(&awb_p, 20);
    awb_pt_set_y(&awb_p, 22);
    assert_eq(awb_pt_x(&awb_p) + awb_pt_y(&awb_p), 42,
      "#derive(accessors) still generates working getters and setters");
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
