# bool_values.tcyr — 6.7.3 (B2): `true`, `false`, `!` and `bool`, at run time on every backend.
#
# `true` is 1 and `false` is 0 (ADR-002 keeps i64 the core: sizeof(bool) == 8). `!e` is 1 when e's
# word is 0, else 0; it binds like unary minus (its operand is a factor), and an f64 operand is
# tested by its raw bits, as `if (x)` tests it. Until 6.7.3 the lexer DROPPED a lone `!`, so `!x`
# compiled as `x` (the dropped-bang lexer bug). The user's decisions (2026-10-07): a WRITE into a bool is checked —
# only a boolean value (true / false, a comparison, `!`, `&&` / `||`, another bool) is accepted —
# and a bool READS as the integer 0 or 1 everywhere. The refusals are
# tests/gates/frontend/bool_checked.sh.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

enum Flag { OFF = false; ON = true; }
#assert true == 1
#assert !false
#assert !!7 == 1
const T1 = !0;
const F1 = !9;
const CT = true;
const CF = !CT;
const CC = 3 < 4;
const fn cneg(b: bool): bool { return !b; }
const fn cpos(x): bool { return x > 0; }
const CN = cneg(CC);
const CP = cpos(5) && CT;
enum CE { CEA = CT; CEB = CP + 1; }
#assert CT
#assert !CF
var GT: bool = true;
var GF: bool = false;
var GC: bool = (3 < 4);
fn one(): i64 { return 1; }
struct Sw { n; on: bool; }
struct Box2 { k; s: Sw; }
impl Sw { fn flip(self): i64 { self.on = !self.on; return 0; } }
var GS = Sw { 9, true };
fn even(n): bool { if (n == 0) { return true; } if (n == 1) { return false; } return even(n - 2); }
fn pos(x): bool { return x > 0; }
fn neg(x): bool { return !pos(x); }
fn both(a: bool, b: bool): bool { return a && b; }
fn fall(x): bool { if (x > 5) { return true; } }
fn pair(x): (i64, bool) { return (x, x > 2); }
fn f7(a, b, c, d, e, g, ok: bool): i64 { return ok * 100 + a; }
fn twice(n): i64 { return n * 2; }
impl Sw { fn is(self): bool { return self.on; } fn put(self, v: bool): i64 { self.on = v; return 0; } }
var GD: bool = one() == 1;

fn not_of(x) { return !x; }

fn values(): i64 {
    assert_eq(true, 1, "V1: true is 1");
    assert_eq(false, 0, "V2: false is 0");
    assert_eq(!0, 1, "V3: !0");
    assert_eq(!7, 0, "V4: !7");
    assert_eq(!!5, 1, "V5: !!5");
    assert_eq(not_of(0 - 3), 0, "V6: !x on a negative");
    var x = 5;
    var hit = 0;
    if (!x) { hit = 1; }
    assert_eq(hit, 0, "V7: if (!x) with x = 5 is not taken");
    x = 0;
    if (!x) { hit = 1; }
    assert_eq(hit, 1, "V8: if (!x) with x = 0 is taken");
    var done = 0;
    var n = 0;
    while (!done) { n = n + 1; if (n == 4) { done = 1; } }
    assert_eq(n, 4, "V9: while (!done)");
    assert_eq(!x + 1, 2, "V10: ! binds tighter than + (like unary minus)");
    assert_eq(!(x + 1), 0, "V11: !(..) over a parenthesised sum");
    assert_eq(-!x, 0 - 1, "V12: unary minus over !");
    assert_eq(!0.0, 1, "V13: !0.0 tests the raw word");
    assert_eq(!(-0.0), 0, "V14: !(-0.0) is 0 (its sign bit is set), as if (-0.0) is taken");
    assert_eq((3 < 4) && !false, 1, "V15: && with !");
    assert_eq(!(3 < 4) || false, 0, "V16: || with !");
    var s = 0;
    switch (x == 0) { case true: s = 1; case false: s = 2; }
    assert_eq(s, 1, "V17: case true");
    assert_eq(ON, 1, "V18: an enum value from true");
    assert_eq(OFF, 0, "V19: an enum value from false");
    assert_eq(T1 + F1, 1, "V20: a const from !");
    return 0;
}

fn locals(): i64 {
    var a = 3;
    var t: bool = true;
    var f: bool = false;
    var c: bool = a < 4;
    var d: bool = !a;
    var e: bool = (a > 1) && (a < 9);
    var g: bool = c || d;
    var h: bool = (c);
    var k: bool = !!a;
    var l: bool = f64_lt(1.0, 2.0);
    assert_eq(t + f * 2 + c * 4 + d * 8 + e * 16 + g * 32 + h * 64 + k * 128 + l * 256, 1 + 4 + 16 + 32 + 64 + 128 + 256, "L1: locals from every producer");
    t = a != 3;
    assert_eq(t, 0, "L2: assigned a comparison");
    t = !t;
    assert_eq(t, 1, "L3: assigned its own negation");
    for (var q = 0; q < 3; t = q > 1) { q = q + 1; }
    assert_eq(t, 1, "L4: a for step assigns a comparison");
    var n = 10 + c;
    assert_eq(n, 11, "L5: a bool reads as 1 in arithmetic");
    assert_eq(c * 4 + f, 4, "L6: ... and 0");
    return 0;
}

fn globals(): i64 {
    assert_eq(GT + GF * 2 + GC * 4 + GD * 8, 13, "G1: static, deferred and parenthesised bool globals");
    GF = GT && GC;
    assert_eq(GF, 1, "G2: a global assigned an &&");
    GF = !GF;
    assert_eq(GF, 0, "G3: ... and its negation");
    var l: bool = GT;
    assert_eq(l, 1, "G4: a local from a bool global");
    return 0;
}

fn fields(): i64 {
    var a: Sw;
    a.n = 4;
    a.on = a.n > 3;
    assert_eq(a.on, 1, "F1: a field stored a comparison");
    a.flip();
    assert_eq(a.on, 0, "F2: self.on = !self.on");
    var b = Sw { 1, true };
    var c = Sw { n: 2, on: (a.n == 4) };
    assert_eq(b.on + c.on * 2, 3, "F3: positional and named literals");
    var x: Box2;
    x.s.on = b.on && c.on;
    assert_eq(x.s.on, 1, "F4: a chain");
    var l: bool = x.s.on;
    assert_eq(l + GS.on, 2, "F5: a local from a field, a global literal's field");
    return 0;
}

fn fns(): i64 {
    assert_eq(even(10) + even(7) * 2, 1, "N1: a recursive bool tail call");
    assert_eq(pos(3) + neg(3) * 2 + neg(0 - 1) * 4, 5, "N2: ! over a bool fn's call");
    assert_eq(both(true, 3 < 4) + both(true, false) * 2, 1, "N3: bool parameters");
    assert_eq(fall(9) + fall(1) * 2, 1, "N4: running off the end of a bool fn is false");
    var a, b = pair(5);
    assert_eq(a * 10 + b, 51, "N5: a bool element of a multi-value return");
    assert_eq(f7(1, 2, 3, 4, 5, 6, 2 > 1), 101, "N6: a bool at parameter ordinal 7");
    var s: Sw;
    s.put(4 > 1);
    var c: bool = s.is();
    assert_eq(c + twice(c), 3, "N7: methods; a bool passed to an i64 parameter reads 1");
    return 0;
}

fn consts(): i64 {
    assert_eq(CT + CF * 2 + CC * 4 + CN * 8 + CP * 16, 21, "K1: bool consts from true, !, a comparison, bool const fns");
    const L = 2 > 1;
    var b: bool = L;
    var c: bool = CN || CP;
    assert_eq(b + c * 2, 3, "K2: a local bool const and top-level ones into bools");
    assert_eq(CEB, 2, "K3: an enum value from a bool const");
    var s = 0;
    switch (1) { case CT: s = 1; default: s = 2; }
    assert_eq(s, 1, "K4: a case label from a bool const");
    assert_eq(cneg(false), 1, "K5: a bool const fn called at run time");
    return 0;
}

fn run(): i64 {
    values();
    locals();
    globals();
    fields();
    fns();
    consts();
    return 0;
}
var r0 = run();
var rr = assert_summary();
syscall(60, rr);
