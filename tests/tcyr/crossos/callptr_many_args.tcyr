# callptr_many_args.tcyr — 6.6.17 (a11). An indirect call (`callptr`) passes any number of arguments,
# at any stack depth.
#
# ⛔ THE DEFECTS, every release through 6.6.16.
#   * Windows (ECALLPOPS's callptr twin, ECALLPTR_PE): every displacement and immediate of the
#     stack-argument path was one signed byte, so from 16 arguments `sub rsp, 0x80` sign-extended to
#     `add rsp, 128` (and the loads / copies / final drop overflowed alike): an access violation on
#     cass (0xC0000005) at 16 arguments, right at 13.
#   * Windows: a frame of a page or more was ONE `sub rsp`, past the stack's single guard page. At
#     the deepest point the stack has reached (the bottom of a deep recursion) that faults on real
#     Windows (measured on cass with the probe removed: 0xC0000005); it is now probed a page at a
#     time. Wine does not model the guard page — only cass sees the second row fail.
#   * cx: from 12 arguments r14 / r15 are argument registers, and the call boundary used them as
#     scratch (ECALLIND, the callee's frame `movi`, each parameter store): 12581018 where 650 is
#     right, for a DIRECT call too. Now r251 / r252.
# CROSS-HOST: Win64 (cass) is the target of the first two; the rows run on every host.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

fn m12(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11) { return a0 * 1 + a1 * 2 + a2 * 3 + a3 * 4 + a4 * 5 + a5 * 6 + a6 * 7 + a7 * 8 + a8 * 9 + a9 * 10 + a10 * 11 + a11 * 12; }
fn m13(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12) { return a0 * 1 + a1 * 2 + a2 * 3 + a3 * 4 + a4 * 5 + a5 * 6 + a6 * 7 + a7 * 8 + a8 * 9 + a9 * 10 + a10 * 11 + a11 * 12 + a12 * 13; }
fn m16(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15) { return a0 * 1 + a1 * 2 + a2 * 3 + a3 * 4 + a4 * 5 + a5 * 6 + a6 * 7 + a7 * 8 + a8 * 9 + a9 * 10 + a10 * 11 + a11 * 12 + a12 * 13 + a13 * 14 + a14 * 15 + a15 * 16; }
fn m20(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19) { return a0 * 1 + a1 * 2 + a2 * 3 + a3 * 4 + a4 * 5 + a5 * 6 + a6 * 7 + a7 * 8 + a8 * 9 + a9 * 10 + a10 * 11 + a11 * 12 + a12 * 13 + a13 * 14 + a14 * 15 + a15 * 16 + a16 * 17 + a17 * 18 + a18 * 19 + a19 * 20; }
fn m40(a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, a32, a33, a34, a35, a36, a37, a38, a39) { return a0 * 1 + a1 * 2 + a2 * 3 + a3 * 4 + a4 * 5 + a5 * 6 + a6 * 7 + a7 * 8 + a8 * 9 + a9 * 10 + a10 * 11 + a11 * 12 + a12 * 13 + a13 * 14 + a14 * 15 + a15 * 16 + a16 * 17 + a17 * 18 + a18 * 19 + a19 * 20 + a20 * 21 + a21 * 22 + a22 * 23 + a23 * 24 + a24 * 25 + a25 * 26 + a26 * 27 + a27 * 28 + a28 * 29 + a29 * 30 + a30 * 31 + a31 * 32 + a32 * 33 + a33 * 34 + a34 * 35 + a35 * 36 + a36 * 37 + a37 * 38 + a38 * 39 + a39 * 40; }
