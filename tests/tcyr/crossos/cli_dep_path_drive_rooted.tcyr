# cli_dep_path_drive_rooted.tcyr — CROSS-HOST: the CLI's `[deps.X] path` join (cbt/deps/keys.cyr
# `_dep_join_path`) on each host's own compiler. On Windows (cass) a drive-rooted `C:/x` / `C:\x`,
# a rooted `\x` (UNC included) and a drive-relative `C:x` are taken as given; a relative path joins
# onto the manifest's directory. POSIX hosts (ecb, ach, pi, x86_64 Linux) take only a leading `/` as
# absolute. Through 6.7.12 cyrius.exe joined every drive-rooted path (`C:\proj/C:/deps/foo`) and
# reported the module missing. The CLI's own file, compiled the way cbt/cyrius.cyr includes it.
# CHANGELOG [6.7.13]
include "lib/assert.cyr"
include "lib/syscalls.cyr"
#ifndef CYRIUS_TARGET_AGNOS
#ifndef CYRIUS_TARGET_CX
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"
include "lib/fs.cyr"
include "lib/process.cyr"
include "lib/audit_walk.cyr"
include "src/version_str.cyr"
include "cbt/core.cyr"
include "cbt/cli_args.cyr"
include "cbt/manifest.cyr"
include "cbt/sigclean.cyr"
include "cbt/build.cyr"
include "cbt/commands/build_run.cyr"
include "cbt/commands/tests.cyr"
include "cbt/commands/fuzz.cyr"
include "cbt/commands/benches.cyr"
include "cbt/commands/check.cyr"
include "cbt/commands/self.cyr"
include "cbt/commands/lib_sync.cyr"
include "cbt/commands/clean.cyr"
include "cbt/commands/fmt_hooks.cyr"
include "cbt/commands/lint.cyr"
include "cbt/commands/api_doc_vet.cyr"
include "cbt/commands/audit.cyr"
include "cbt/commands/capacity.cyr"
include "cbt/commands/soak_smoke.cyr"
include "cbt/commands/distlib/profile.cyr"
include "cbt/commands/distlib/unit.cyr"
include "cbt/commands/distlib/targets.cyr"
include "cbt/commands/distlib/verify.cyr"
include "cbt/commands/distlib/snapshot.cyr"
include "cbt/commands/distlib/embed.cyr"
include "cbt/commands/distlib/all.cyr"
include "cbt/commands/distlib/modular.cyr"
include "cbt/commands/distlib/distlib.cyr"
include "cbt/commands/publish.cyr"
include "cbt/project.cyr"
include "cbt/quality.cyr"
include "cbt/deps/vendor.cyr"
include "cbt/deps/pin.cyr"
include "cbt/deps/stdlib.cyr"
include "cbt/deps/leaves.cyr"
include "cbt/deps/names.cyr"
include "cbt/deps/submodule.cyr"
include "cbt/deps/keys.cyr"
include "cbt/deps/local.cyr"
include "cbt/deps/named.cyr"
include "cbt/deps/dry_run.cyr"
include "cbt/deps/resolve.cyr"
include "cbt/deps/package.cyr"
include "cbt/deps/update.cyr"
include "cbt/deps/sha256.cyr"
include "cbt/deps/git_cache.cyr"
include "cbt/deps/lock.cyr"
include "cbt/pulsar.cyr"

alloc_init();
assert_streq(_dep_join_path("C:/proj", "../dep"), "C:/proj/../dep", "a relative path joins");
assert_streq(_dep_join_path("C:/proj", "/deps/foo"), "/deps/foo", "a rooted /path is taken as given");
#ifdef CYRIUS_TARGET_WIN
assert_streq(_dep_join_path("C:\\proj", "D:/deps/foo"), "D:/deps/foo", "PE: a drive-rooted D:/ path is taken as given");
assert_streq(_dep_join_path("C:\\proj", "D:\\deps\\foo"), "D:\\deps\\foo", "PE: a drive-rooted D:\\ path is taken as given");
assert_streq(_dep_join_path("C:\\proj", "\\\\srv\\share\\foo"), "\\\\srv\\share\\foo", "PE: a UNC path is taken as given");
assert_streq(_dep_join_path("C:\\proj", "D:foo"), "D:foo", "PE: a drive-relative D:foo is taken as given");
#endif
#ifndef CYRIUS_TARGET_WIN
assert_streq(_dep_join_path("/proj", "D:/deps/foo"), "/proj/D:/deps/foo", "POSIX: D:/x is a relative name");
#endif
#endif
#endif
var r = assert_summary();
syscall(SYS_EXIT, r);
