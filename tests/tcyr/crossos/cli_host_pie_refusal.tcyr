# cli_host_pie_refusal.tcyr — CROSS-HOST: which CLI refuses `--pie` (cbt/cli_args.cyr
# `_cli_host_refuses_pie`), answered by each host's own compiler. D43 (the user, 2026-10-15): the
# x86_64 macOS CLI refuses it (ach: a fixed-address Mach-O, no MH_PIE mode) and the arm64 one accepts
# it as met (ecb: every arm64 Mach-O is MH_PIE); the Windows CLI refuses it (D5, 6.7.12); Linux
# (x86_64, pi) builds it. Through 6.7.12 both Macs wrote the plain image at rc 0. The refusal line
# the answer prints on stderr is expected. CHANGELOG [6.7.13]
include "lib/assert.cyr"
include "lib/syscalls.cyr"
#ifndef CYRIUS_TARGET_AGNOS
#ifndef CYRIUS_TARGET_CX
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"
include "lib/fs.cyr"
include "lib/process.cyr"
include "src/version_str.cyr"
include "cbt/core.cyr"
include "cbt/cli_args.cyr"

alloc_init();
var want = 0;
#ifdef CYRIUS_TARGET_WIN
want = 1;
#endif
#ifdef CYRIUS_TARGET_MACOS
#ifndef CYRIUS_ARCH_AARCH64
want = 1;
#endif
#endif
assert_eq(_cli_host_refuses_pie(), want, "--pie refused on the Windows and x86_64 macOS CLIs, accepted elsewhere");
#endif
#endif
var r = assert_summary();
syscall(SYS_EXIT, r);
