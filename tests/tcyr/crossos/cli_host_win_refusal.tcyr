# cli_host_win_refusal.tcyr — CROSS-HOST: which CLI refuses `--win` (cbt/cli_args.cyr
# `_cli_host_refuses_win`), answered by each host's own compiler. The aarch64 Linux CLI refuses it
# (pi: its cycc emits aarch64 only — through 6.7.12 `cyrius build --win` wrote an aarch64 ELF named
# `.exe` at rc 0), and so do both macOS CLIs (ecb, ach: neither Mach-O compiler reads
# CYRIUS_TARGET_WIN — through 6.7.13 it wrote a Mach-O named `.exe` at rc 0); x86_64 Linux (cycc
# emits PE) and Windows (native) accept it. The refusal line the answer prints on stderr is
# expected. CHANGELOG [6.7.13], [6.7.14]
include "lib/assert.cyr"
include "lib/syscalls.cyr"
#ifndef CYRIUS_TARGET_AGNOS
#ifndef CYRIUS_TARGET_CX
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"
include "lib/fs.cyr"
include "lib/process.cyr"
include "src/version_str.cyr"
include "cbt/core.cyr"
include "cbt/cli_args.cyr"

alloc_init();
var want = 0;
#ifdef CYRIUS_TARGET_LINUX
#ifdef CYRIUS_ARCH_AARCH64
want = 1;
#endif
#endif
#ifdef CYRIUS_TARGET_MACOS
want = 1;
#endif
assert_eq(_cli_host_refuses_win(), want, "--win refused on the aarch64 Linux and macOS CLIs, accepted elsewhere");
#endif
#endif
var r = assert_summary();
syscall(SYS_EXIT, r);
