# cli_scratch_resolve_kill.tcyr — CROSS-HOST: a killed scratch resolve leaves nothing (6.7.14).
# `cyrius deps --locked` and the pin-move dry pass resolve into a private scratch under the CLI's
# temp dir; while one runs, cbt/deps.cyr's `_dep_copy_file` records each directory it is about to
# create at or under the scratch root (never one above it) and each file — the destination before
# it exists, and the sibling temp `_aw_open` created, recorded with HUP / INT / TERM held across
# the exclusive create (6.7.15; 6.7.14 recorded the name it PREDICTED, so a file planted there,
# which `_aw_open` skipped, was unlinked by a kill) — in the kill handler's scratch-tree slot. Every
# host: the directory filter and the slot (pure logic). POSIX (ecb, ach, pi, x86_64 Linux): the
# records a real copy leaves, a copy beside planted temp names (recorded: only the temp it made;
# the signals held only across the create), and a forked CHILD that resolves two files into a
# scratch, one beside a planted temp name, and SIGTERMs itself — it dies by SIGTERM with its own
# files removed, the planted file kept with the directories holding it, and the scratch's parent
# directory kept. CHANGELOG [6.7.14], [6.7.15]
include "lib/assert.cyr"
include "lib/syscalls.cyr"
#ifndef CYRIUS_TARGET_AGNOS
#ifndef CYRIUS_TARGET_CX
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/io.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/args.cyr"
include "lib/fs.cyr"
include "lib/process.cyr"
include "lib/audit_walk.cyr"
include "src/version_str.cyr"
include "cbt/core.cyr"
include "cbt/cli_args.cyr"
include "cbt/manifest.cyr"
include "cbt/sigclean.cyr"
include "cbt/build.cyr"
include "cbt/commands.cyr"
include "cbt/project.cyr"
include "cbt/quality.cyr"
include "cbt/deps.cyr"
include "cbt/pulsar.cyr"

alloc_init();

# 1 when cstr `s` is in vec `v`, else 0.
fn _csk_has(v, s): i64 {
    var i = 0;
    while (i < vec_len(v)) {
        if (_cstr_eq(vec_get(v, i), s) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Every host: which directories a scratch rooted at "C:/x/scr" records.
_dep_scr_begin("C:/x/scr");
var slot_mine = 0;
if (_cbt_sig_tree_files == _dep_scr_files && _cbt_sig_tree_dirs == _dep_scr_dirs) { slot_mine = 1; }
assert_eq(slot_mine, 1, "the scratch's two vecs sit in the kill handler's scratch-tree slot");
_dep_scr_dir("C:");
_dep_scr_dir("C:/x");
_dep_scr_dir("C:/x/scr");
_dep_scr_dir("C:/x/scr/lib");
_dep_scr_dir("C:/x/scr/lib");
_dep_scr_dir("C:/x/scrap");
_dep_scr_dir("C:/x/scrap/lib");
_dep_scr_dir("C:/x/scr/lib/fam");
assert_eq(vec_len(_dep_scr_dirs), 3, "the root and two levels under it are recorded, each once");
assert_eq(_csk_has(_dep_scr_dirs, "C:/x"), 0, "a directory above the root is never recorded");
assert_eq(_csk_has(_dep_scr_dirs, "C:/x/scrap"), 0, "a sibling sharing the root's spelling is not under it");
assert_streq(vec_get(_dep_scr_dirs, 0), "C:/x/scr", "parents first: the root");
assert_streq(vec_get(_dep_scr_dirs, 2), "C:/x/scr/lib/fam", "…its deepest directory last");
_dep_scr_end();
assert_eq(_cbt_sig_tree_files, 0, "_dep_scr_end clears the slot");
assert_eq(_dep_scr_dirs, 0, "…and stops recording");
_dep_scr_dir("C:/x/scr/lib");
assert_eq(_dep_scr_dirs, 0, "a directory met with no scratch running is not recorded");

#ifndef CYRIUS_TARGET_WIN
# "/tmp/" "csk.<parent pid><suffix>" — a fresh arena string, per process (gates_never_write_tree.sh
# axis 6 reads a whole "/tmp/<name>" literal as a fixed name).
var _csk_parent = sys_getpid();
fn _csk_path(suffix): i64 {
    var p = alloc(96);
    memcpy(p, "/tmp/", 5);
    memcpy(p + 5, "csk.", 4);
    var o = 9 + fmt_int_buf(_csk_parent, p + 9);
    memcpy(p + o, suffix, strlen(suffix));
    store8(p + o + strlen(suffix), 0);
    return p;
}

# The status of child `c`: its exit code, or 1000 + the signal that ended it.
fn _csk_wait(c): i64 {
    var st[8];
    store64(&st, 0);
    var w = sys_waitpid(c, &st, 0);
    while (w == 0 - 4) { w = sys_waitpid(c, &st, 0); }
    if (w != c) { return 0 - 1; }
    var s = load32(&st);
    if (WIFEXITED(s) == 1) { return WEXITSTATUS(s); }
    return 1000 + (s & 127);
}

var src = _csk_path(".src");
file_write_all(src, "fn csk(): i64 { return 1; }\n", 28);
var par = _csk_path("");
xmkdir(par, 448);

# The temp name `_aw_open(dst)` tries `k` names from now (lib/io.cyr `_io_tmp_name`: pid + the
# counter), named without spending the counter — where another process could plant a file.
fn _csk_next_tmp(dst, k): i64 {
    var c = _io_atomic_ctr;
    _io_atomic_ctr = c + k - 1;
    var t = _io_tmp_name(dst);
    _io_atomic_ctr = c;
    return t;
}

# The HUP / INT / TERM bits (0x4003) of this thread's signal mask.
fn _csk_mask_bits(): i64 {
    var none[8];
    var cur[8];
    store64(&none, 0);
    store64(&cur, 0);
    sys_sigprocmask(SIG_BLOCK, &none, &cur);
    return load64(&cur) & 0x4003;
}

# A recorded copy beside files planted at the next two temp names it will try (6.7.15): the
# exclusive create skips both, and the temp recorded is the third name, the one it created.
var root0 = _csk_path("/scr0");
xmkdir(root0, 448);
xmkdir(_cat2(root0, "/lib"), 448);
var pf = _cat2(root0, "/lib/pred.cyr");
var p1 = _csk_next_tmp(pf, 1);
var p2 = _csk_next_tmp(pf, 2);
var p3 = _csk_next_tmp(pf, 3);
file_write_all(p1, "mine\n", 5);
file_write_all(p2, "mine\n", 5);
var m0 = _csk_mask_bits();
_dep_scr_begin(root0);
var cr0 = _dep_copy_file(src, pf);
assert_eq(cr0, 0, "a recorded copy beside two planted temp names succeeded");
assert_eq(_csk_has(_dep_scr_files, p1), 0, "the planted name it tried first is not recorded (6.7.14 recorded it)");
assert_eq(_csk_has(_dep_scr_files, p2), 0, "…nor the second");
assert_eq(_csk_has(_dep_scr_files, p3), 1, "the temp it created, the first free name, is recorded");
assert_eq(file_exists(p3), 0, "…and is gone once renamed into place");
assert_eq(file_exists(p1) + file_exists(p2), 2, "the planted files are untouched");
assert_eq(_csk_mask_bits(), m0, "HUP / INT / TERM are held only across the create: the mask is back after the copy");
_dep_scr_end();
sys_unlink(p1);
sys_unlink(p2);
_dep_rm_tree(root0);

# A real copy into a scratch under `par`: the records, parents first, nothing above the root.
var root = _csk_path("/scr");
_dep_scr_begin(root);
var dst = _cat2(root, "/lib/fam/x.cyr");
var cr = _dep_copy_file(src, dst);
assert_eq(cr, 0, "the copy into the scratch succeeded");
assert_eq(vec_len(_dep_scr_dirs), 3, "its directories are recorded: root, lib, lib/fam");
assert_eq(_csk_has(_dep_scr_dirs, par), 0, "the directory holding the root is not recorded");
assert_eq(_csk_has(_dep_scr_files, dst), 1, "the destination is recorded");
var tmp_rec = 0;
var fi = 0;
while (fi < vec_len(_dep_scr_files)) {
    var fp = vec_get(_dep_scr_files, fi);
    if (strlen(fp) > strlen(dst) && memeq(fp, dst, strlen(dst)) == 1) { tmp_rec = fp; }
    fi = fi + 1;
}
assert(tmp_rec != 0, "the sibling temp is recorded");
if (tmp_rec != 0) { assert_eq(file_exists(tmp_rec), 0, "…and is gone once renamed into place"); }
assert_eq(file_exists(dst), 1, "the destination exists");
_dep_rm_tree(root);
_dep_scr_end();

# The kill: a CHILD resolves two files into a scratch, then SIGTERMs itself.
var root2 = _csk_path("/scr2");
var c = sys_fork();
if (c == 0) {
    if (_cbt_sig_install() != 0) { sys_exit(64 + 1); }
    _dep_scr_begin(root2);
    if (_dep_copy_file(src, _cat2(root2, "/lib/a.cyr")) != 0) { sys_exit(64 + 2); }
    if (_dep_copy_file(src, _cat2(root2, "/lib/fam/b.cyr")) != 0) { sys_exit(64 + 2); }
    sys_kill(sys_getpid(), 15);
    sys_exit(91);
}
var rc2 = _csk_wait(c);
assert_eq(rc2, 1015, "the CHILD dies by SIGTERM after its handler ran (64+N: a setup failure)");
assert_eq(file_exists(_cat2(root2, "/lib/fam/b.cyr")), 0, "its scratch's files are unlinked");
assert_eq(file_exists(root2), 0, "…and its directories removed, the root included");
assert_eq(file_exists(par), 1, "the directory holding the root stays");
_dep_rm_tree(root2);

# The kill beside a planted temp name (6.7.15): the CHILD plants a file at the name its copy of
# b.cyr tries first (its own pid: another same-user process could), copies, then SIGTERMs itself.
# The planted file survives, and so do the directories holding it; the CHILD's own files go.
var root3 = _csk_path("/scr3");
var bplant = _csk_path("/b.plant");
var c3 = sys_fork();
if (c3 == 0) {
    if (_cbt_sig_install() != 0) { sys_exit(64 + 1); }
    _dep_scr_begin(root3);
    if (_dep_copy_file(src, _cat2(root3, "/lib/a.cyr")) != 0) { sys_exit(64 + 2); }
    var bd = _cat2(root3, "/lib/b.cyr");
    var bp = _csk_next_tmp(bd, 1);
    if (file_write_all(bp, "mine\n", 5) != 5) { sys_exit(64 + 3); }
    file_write_all(bplant, bp, strlen(bp));   # tell the parent its name
    if (_dep_copy_file(src, bd) != 0) { sys_exit(64 + 2); }
    sys_kill(sys_getpid(), 15);
    sys_exit(91);
}
var rc3 = _csk_wait(c3);
var bpn = alloc(256);
var bpl = file_read_all(bplant, bpn, 255);
if (bpl < 0) { bpl = 0; }
store8(bpn + bpl, 0);
assert_eq(rc3, 1015, "beside a planted temp name: the CHILD dies by SIGTERM after its handler ran (64+N: setup)");
assert(bpl > 0, "…the CHILD planted a file at its copy's first temp name (anti-vacuous)");
assert_eq(file_exists(bpn), 1, "…the planted file survives the kill (6.7.14 recorded that name and unlinked it)");
var own3 = file_exists(_cat2(root3, "/lib/b.cyr")) + file_exists(_cat2(root3, "/lib/a.cyr"));
assert_eq(own3, 0, "…the CHILD's own files are unlinked");
assert_eq(file_exists(_cat2(root3, "/lib")), 1, "…and the directory holding the planted file stays");
_dep_rm_tree(root3);
sys_unlink(bplant);
_dep_rm_tree(par);
sys_unlink(src);
#endif
#endif
#endif
var r = assert_summary();
syscall(SYS_EXIT, r);
