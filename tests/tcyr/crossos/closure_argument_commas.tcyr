# closure_argument_commas.tcyr — 6.7.7 — a closure literal's `|a, b|` comma separates no arguments,
# in every scanner that numbers or counts a call's arguments before the call is parsed.
#
# Three scanners found "argument k" on the raw token stream by counting depth-0 commas, tracking
# only `( [ {`, so every argument after a two-parameter closure was numbered one too high
# (issue 2026-10-09-closure-literal-comma-counted-as-argument). Measured on the merged 6.7.7
# compiler, on x86, aarch64, cx and PE alike:
#   * `_call_arg_start` (generic type-argument inference): `gx(|a, b| a + b, p)` read the closure's
#     `b` as argument 1, inferred T from a scalar and refused valid source ("generic 'gx' has no i64
#     (or other scalar) instance") — the direct call, a generic forwarding T past a closure, a call
#     with a named argument after the closure, and a `var q = pick(|a, b| .., p)` receive;
#   * `_tc_str_literal_arg` (the tail-call divert for a string literal into a `: Str` parameter):
#     `return sl(|a, b| a + b, "hello");` kept its `jmp` without the `str_from` wrap, and returned 0
#     where the non-tail call returns 5;
#   * `_CALL_ARGC_PEEK` (the overload-routing arity gate): `show(s, |a, b| a + b)` counted three
#     arguments and was not routed to `show_str` (1 where 2 is right).
# All three now step by `_arg_next`, the one argument walker. One-parameter closures (`|a| a`,
# no comma) and `||` (one token) were always right and are the controls.
#
# ⛔ The same walker took the comma inside an EXPLICIT GENERIC CALL's type arguments
# (`pk<i64, i64>(1, 2)`) for an argument boundary — B4's tuple walker (`_tup_item_end`) alone stepped
# over it; now `_arg_next` does, for every client. Measured on the merged 6.7.7 compiler (x86):
#   * `_pd_call_fills` (B6, new in 6.7.7): `return wd(pk<i64, i64>(1, 2));` into `fn wd(a, b = 3)`
#     looked full and reached the tail arm short — "internal: tail call to 'wd' reached the tail arm
#     short of its defaults" (also two generic calls in one argument, a nested one, one in a
#     closure body);
#   * `_pd_nscan` (B6): `wd(b: pk<i64, i64>(1, 2), a: 1)` — "a positional argument cannot follow a
#     named one";
#   * `_CALL_ARGC_PEEK` (silent since 6.7.6): `shw(str_from("hi"), pk<i64, i64>(1, 2))` counted three
#     arguments and was not routed to `shw_str`;
#   * `_tc_str_literal_arg`: `return slg(pk<i64, i64>(1, 2), "hello");` jumped with the raw literal
#     in the Str parameter (12 where 62 is right);
#   * `_call_arg_start` / `_call_arg_for` (generic inference, positional and named) and
#     `_tok_gen_ret_sid` (a receive): T inferred from the type arguments' tail, refused.
# A parenthesised generic call, a non-tail call and a comparison `a < b, c > d` were always right
# and are the controls — also `c > (d)`, where `a < b, c > (d)` has a generic call's shape but `a`
# is no generic fn, through the tail divert, the overload router and the inference (a walker that
# read the shape alone, with no lookup, broke those three).
#
# ⚠ CROSS-HOST: the scanners are frontend-only, but each wrong reading changes the code emitted —
# a refused build, a tail `jmp` with a raw literal in a Str register, a call to the wrong fn — so
# every row runs on x86, aarch64, cx and PE.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"
include "lib/str.cyr"
include "lib/assert.cyr"

struct Pt { x; y; }

# ── _call_arg_start: generic type-argument inference ────────────────────────────────────────────
fn gx<T>(c, v: T): i64 { return v.x * 100 + fncall2(c, 2, 3); }
fn gx_one<T>(c, v: T): i64 { return v.x * 100 + fncall1(c, 5); }
fn inner<T>(c, v: T): i64 { return v.x * 100 + fncall2(c, 1, 1); }
fn outer<T>(v: T): i64 { return inner(|a, b| a + b, v); }
fn gx3<T>(c, v: T, n): i64 { return v.x * 100 + fncall2(c, 4, 5) * 10 + n; }
fn g_shape1(): i64 { var p = Pt { 7, 9 }; return gx(|a, b| a + b, p); }
fn g_three(): i64 { var p = Pt { 7, 9 }; return gx(|a, b, c| a * b, p); }
fn g_one(): i64 { var p = Pt { 7, 9 }; return gx_one(|a| a, p); }
fn g_fwd(): i64 { var p = Pt { 7, 9 }; return outer(p); }
fn g_named(): i64 { var p = Pt { 7, 9 }; return gx3(|a, b| a * b, p, n: 3); }
# cx has no 9-16 B register-pair struct return, so the receive row is not built there.
#ifndef CYRIUS_TARGET_CX
fn pick<T>(c, v: T): T { return v; }
fn g_recv(): i64 { var p = Pt { 7, 9 }; var q = pick(|a, b| a + b, p); return q.x * 10 + q.y; }
#endif

# ── _tc_str_literal_arg: a tail call's string literal into a `: Str` parameter ─────────────────
fn sl(c, t: Str): i64 { return str_len(t) * 100 + fncall2(c, 2, 3); }
fn sl3(c, d, t: Str): i64 { return str_len(t) * 100 + d; }
fn viaret(): i64 { return sl(|a, b| a + b, "hello"); }
fn viavar(): i64 { var n = sl(|a, b| a + b, "hello"); return n; }
fn viaret3(): i64 { return sl(|a, b, c| a + b, "hello"); }
fn viaret_mid(): i64 { return sl3(|a, b| a + b, 7, "hey"); }
fn viaret_one(): i64 { return sl(|a| a + 3, "hello"); }

# ── _CALL_ARGC_PEEK: the overload-routing arity gate ────────────────────────────────────────────
fn show(x, c): i64 { return 1000 + fncall2(c, 2, 3); }
fn show_str(s: Str, c): i64 { return str_len(s) * 100 + fncall2(c, 2, 3); }
fn ov_two(): i64 { var s = str_from("hi"); return show(s, |a, b| a * b); }
fn ov_three(): i64 { var s = str_from("hi"); return show(s, |a, b, c| a + b); }
fn ov_one(): i64 { var s = str_from("hi"); return show(s, |a| a * 2); }

# ── an explicit generic call's type arguments `pk<i64, i64>(..)` ────────────────────────────────
fn pk<A, B>(a: A, b: B): i64 { return a * 10 + b; }
fn wd(a, b = 3): i64 { return a + b; }
fn gc_tail(): i64 { return wd(pk<i64, i64>(1, 2)); }
fn gc_named(): i64 { var x = wd(b: pk<i64, i64>(1, 2), a: 1); return x; }
var gc_top = wd(b: pk<i64, i64>(1, 2), a: 1);
fn shw(x, c): i64 { return 1000 + c; }
fn shw_str(s: Str, c): i64 { return str_len(s) * 100 + c; }
fn gc_route(): i64 { return shw(str_from("hi"), pk<i64, i64>(1, 2)); }
fn gc_route_var(): i64 { var n = shw(str_from("hi"), pk<i64, i64>(1, 2)); return n; }
fn slg(c, t: Str): i64 { return str_len(t) * 10 + c; }
fn gc_lit(): i64 { return slg(pk<i64, i64>(1, 2), "hello"); }
fn gxg<T>(c, v: T): i64 { return v.x * 100 + c; }
fn gc_infer(): i64 { var p = Pt { 7, 9 }; return gxg(pk<i64, i64>(1, 2), p); }
fn gc_infer_named(): i64 { var p = Pt { 7, 9 }; return gxg(pk<i64, i64>(1, 2), v: p); }
#ifndef CYRIUS_TARGET_CX
fn gc_recv(): i64 { var p = Pt { 7, 9 }; var q = pick(pk<i64, i64>(1, 2), p); return q.x * 10 + q.y; }
#endif
fn apg(c, n = 5): i64 { return fncall2(c, n, 1); }
fn gc_two(): i64 { return wd(pk<i64, i64>(1, 2) + pk<i64, i64>(3, 4)); }
fn gc_nest(): i64 { return wd(pk<i64, i64>(pk<i64, i64>(1, 2), 3)); }
fn gc_clos(): i64 { return apg(|a, b| pk<i64, i64>(a, b)); }
fn gc_paren(): i64 { return wd((pk<i64, i64>(1, 2))); }
fn gc_nontail(): i64 { var x = wd(pk<i64, i64>(1, 2)); return x; }
fn wc(x, y, z = 5): i64 { return x * 100 + y * 10 + z; }
fn gc_cmp(): i64 { var a = 1; var b = 2; var c = 3; var d = 4; return wc(a < b, c > d); }
fn gc_cmp_paren(): i64 { var a = 1; var b = 2; var c = 3; var d = 4; return wc(a < b, c > (d)); }
fn slc(x, y, t: Str): i64 { return str_len(t) * 100 + x * 10 + y; }
fn gc_cmp_lit(): i64 { var a = 1; var b = 2; var c = 3; var d = 4; return slc(a < b, c > (d), "hello"); }
fn sh3(x, y, z): i64 { return 1000 + y * 10 + z; }
fn sh3_str(s: Str, y, z): i64 { return str_len(s) * 100 + y * 10 + z; }
fn gc_cmp_route(): i64 { var a = 1; var b = 2; var c = 3; var d = 4; var s = str_from("hi"); return sh3(s, a < b, c > (d)); }
fn gx2<T>(x, y, v: T): i64 { return v.x * 100 + x * 10 + y; }
fn gc_cmp_infer(): i64 { var a = 1; var b = 2; var c = 3; var d = 4; var p = Pt { 7, 9 }; return gx2(a < b, c > (d), p); }

fn rows(): i64 {
    alloc_init();
    assert_eq(g_shape1(), 705, "the issue's shape 1: gx(|a, b| a + b, p) infers T = Pt (it was refused)");
    assert_eq(g_three(), 706, "gx(|a, b, c| a * b, p): two closure commas");
    assert_eq(g_one(), 705, "control: gx_one(|a| a, p)");
    assert_eq(g_fwd(), 702, "a generic forwards T past a closure: inner(|a, b| a + b, v)");
    assert_eq(g_named(), 903, "a named argument after the closure: gx3(|a, b| a * b, p, n: 3)");
    #ifndef CYRIUS_TARGET_CX
    assert_eq(g_recv(), 79, "var q = pick(|a, b| a + b, p) receives the Pt");
    #endif
    assert_eq(viaret(), 505, "the issue's shape 2: return sl(|a, b| a + b, \"hello\") wraps the literal");
    assert_eq(viavar(), 505, "control: the same call outside tail position");
    assert_eq(viaret3(), 505, "the tail form with a three-parameter closure");
    assert_eq(viaret_mid(), 307, "the tail form with the literal two arguments after the closure");
    assert_eq(viaret_one(), 505, "control: return sl(|a| a + 3, \"hello\")");
    assert_eq(ov_two(), 206, "show(s, |a, b| a * b) is routed to show_str");
    assert_eq(ov_three(), 205, "show(s, |a, b, c| a + b) is routed to show_str");
    assert_eq(ov_one(), 204, "control: show(s, |a| a * 2) is routed to show_str");
    assert_eq(gc_tail(), 15, "B6: return wd(pk<i64, i64>(1, 2)) fills b (it was an internal error)");
    assert_eq(gc_named(), 13, "B6: wd(b: pk<i64, i64>(1, 2), a: 1) names both arguments");
    assert_eq(gc_top, 13, "... at top level");
    assert_eq(gc_route(), 212, "shw(str_from(\"hi\"), pk<i64, i64>(1, 2)) is routed to shw_str");
    assert_eq(gc_route_var(), 212, "... outside tail position");
    assert_eq(gc_lit(), 62, "return slg(pk<i64, i64>(1, 2), \"hello\") wraps the literal");
    assert_eq(gc_infer(), 712, "gxg(pk<i64, i64>(1, 2), p) infers T = Pt");
    assert_eq(gc_infer_named(), 712, "gxg(pk<i64, i64>(1, 2), v: p) infers T = Pt by name");
    #ifndef CYRIUS_TARGET_CX
    assert_eq(gc_recv(), 79, "var q = pick(pk<i64, i64>(1, 2), p) receives the Pt");
    #endif
    assert_eq(gc_two(), 49, "two generic calls in one argument: wd(pk<..>(1, 2) + pk<..>(3, 4))");
    assert_eq(gc_nest(), 126, "a generic call inside a generic call's arguments");
    assert_eq(gc_clos(), 51, "a generic call in a closure body: apg(|a, b| pk<i64, i64>(a, b))");
    assert_eq(gc_paren(), 15, "control: wd((pk<i64, i64>(1, 2)))");
    assert_eq(gc_nontail(), 15, "control: var x = wd(pk<i64, i64>(1, 2))");
    assert_eq(gc_cmp(), 105, "control: wc(a < b, c > d) is two arguments");
    assert_eq(gc_cmp_paren(), 105, "control: wc(a < b, c > (d)) is two arguments (a is no generic fn)");
    assert_eq(gc_cmp_lit(), 510, "control: return slc(a < b, c > (d), \"hello\") wraps argument 2");
    assert_eq(gc_cmp_route(), 210, "control: sh3(s, a < b, c > (d)) is routed to sh3_str");
    assert_eq(gc_cmp_infer(), 710, "control: gx2(a < b, c > (d), p) infers T = Pt from argument 2");
    return 0;
}
rows();
var r = assert_summary();
