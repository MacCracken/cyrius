# const_contexts.tcyr — 6.7.2 (B1, C1): the places a compile-time value is required take any integer
# const expression — a const, an enum constant, sizeof, a `const fn` call, arithmetic.
#   E  enum values (`EA = N`, `EC = twice(N) + 1`, `ED = 0 - 3`; `-2` as before)
#   S  array sizes, top level and in a fn, bare and element-typed (`var g[N * 2]`, `var a: i64[twice(N)]`)
#   A  `#assert` (`twice(N) == 8 && N > 3`), at top level and in a fn
#   W  `case` labels (`case N`, `case twice(N)`, `case 0 - 1`, `case pick(1)`) — evaluated once by the
#      switch's pre-scan and replayed by its body paths
#   T  a string const passed where a `Str` is expected is wrapped like its literal (str_from)
# Before 6.7.2 an array size took one literal or enum constant, `#assert` one atom or two compared,
# a case label one number, an enum value `[-]N`.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/assert.cyr"

const N = 4;
const fn twice(x) { return x * 2; }
const fn pick(k) { if (k == 1) { return 100; } return 200; }
enum E { EA = N; EB; EC = twice(N) + 1; ED = 0 - 3; EE = -2; }
var garr[N * 2];
var gtyped: i64[twice(N)];
#assert N * 2 == 8, "N * 2";
#assert twice(N) == 8 && N > 3, "a const fn in #assert";
#assert sizeof(i32) == 4;
const SZ = sizeof(i64) * N;
const GREETING = "hello";

fn slen(s: Str): i64 { return str_len(s); }

fn classify(v): i64 {
    switch (v) {
        case N: return 1;
        case twice(N): return 2;
        case 0 - 1: return 3;
        case pick(1): return 4;
        default: return 0;
    }
    return 0 - 1;
}

fn run(): i64 {
    var larr[N];
    var lsz: i64[twice(3)];
    assert_eq(EA, 4, "E1: an enum value from a const");
    assert_eq(EB, 5, "E2: and the next one counts on");
    assert_eq(EC, 9, "E3: a const fn in an enum value");
    assert_eq(ED, 0 - 3, "E4: a negative expression");
    assert_eq(EE, 0 - 2, "E5: -N as before");
    assert_eq(SZ, 32, "K1: sizeof in a const");
    assert_eq(classify(4), 1, "W1: case N");
    assert_eq(classify(8), 2, "W2: case twice(N)");
    assert_eq(classify(0 - 1), 3, "W3: case 0 - 1");
    assert_eq(classify(100), 4, "W4: case pick(1)");
    assert_eq(classify(7), 0, "W5: default");
    assert_eq(slen(GREETING), 5, "T1: a string const where a Str is expected is wrapped like its literal");
    lsz[5] = 9;
    assert_eq(lsz[5], 9, "S2: a fn-local typed array sized by a const fn");
    #assert EC == 9, "an #assert in a fn";
    return 0;
}
var r0 = run();
var rr = assert_summary();
syscall(60, rr);
