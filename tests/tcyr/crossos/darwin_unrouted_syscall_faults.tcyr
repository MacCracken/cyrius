# darwin_unrouted_syscall_faults.tcyr — v6.6.8: on BOTH macOS targets a syscall number the
# Mach-O translation does not route FAILS — SIGSYS by default, -ENOSYS (-78) when SIGSYS is
# ignored. It never quietly runs some other call.
#
# THE DEFECT (arm64-macOS). ESYSXLAT's Mach-O chain writes x16 (Darwin's syscall register) only
# when a row MATCHES. An unmatched number left x16 holding whatever last wrote it — normally the
# PREVIOUS syscall's BSD number, since x16 survives `svc` — so the call silently re-ran that
# previous syscall with the new arguments. Measured on ecb with the 6.6.7 compiler: getpid, then
# an unrouted number, returned the PID again. The class shipped at least eight times, each fixed
# by adding the one row that surfaced; `syscall_ioctl_x86_compat.tcyr` passed on ecb only because
# its raw 16 re-ran ioctl out of x16 = 54. Fixed at the root: the chain head sets x16 = 0xFFFF,
# which xnu maps to nosys.
#
# x86-macOS never re-ran a stale call (an unmatched number reaches Darwin unclassed), but with
# SIGSYS ignored it returned the NUMBER ITSELF — `syscall(4000)` gave 4000, a positive "success"
# (measured on ach). Its chain now ends by classing a leftover number as Unix 0xFFFF, so both
# Macs answer -78.
#
# ⭐ WHY THE CALL BEFORE IS getpid. The stale-x16 failure returns whatever the PREVIOUS call
# returned, so the test primes it with a call whose answer is distinctive and known. An
# assertion of "r < 0" alone would pass over a stale call that happened to fail.
# ⭐ WHY A RUNTIME NUMBER AND A LITERAL. The literal is what the compiler warns about; the runtime
# number (`_nr`, set in main) is the one it cannot see. Both go through the same chain.
# ⭐ WHY A FORKED CHILD. "Returns -78 with SIGSYS ignored" is the half a test can observe in
# process; the DEFAULT is that the process dies, and only a child can show that.
#
# 6.6.10 — the peer-decline group covers BOTH Macs. The epoll/inotify asserts used to sit under
# `#ifdef CYRIUS_ARCH_AARCH64` because the x86-macOS peer did not define those wrappers at all
# (the test would not have compiled on ach); it now carries them, the six pure helpers and the
# flag enums, so the same source runs on ach and ecb. sys_getdents64 joined the group: Darwin's
# getdirentries64 takes a fourth OUT-pointer (basep) the 3-arg wrapper never passed, so xnu wrote
# 8 bytes through whatever r10 / x3 held — the assert primes that register with the address of a
# live sentinel first, which is exactly how the stray write was measured (sentinel zeroed on both
# Macs), so a wrapper that regressed to issuing the call fails here even when it returns data.
#
# Elsewhere the file compiles and asserts nothing: Linux and aarch64 pass an unrouted number
# through to the kernel by design (native numbers must survive), and PE declines with -38.
include "lib/syscalls.cyr"
include "lib/assert.cyr"

var _nr = 0;
fn _unrouted_nr(): i64 { return _nr; }
# dup3 through a RUNTIME number: a literal SYS_DUP3 site is (correctly) warned as unrouted, and
# darwin_syscall_literals_routed.sh allows exactly one deliberate literal in this file (4001).
# Darwin-only: PE and agnos declare no SYS_DUP3.
#ifdef CYRIUS_TARGET_MACOS
fn _dup3_nr(): i64 { return SYS_DUP3; }
#endif

fn main(): i64 {
    #ifdef CYRIUS_TARGET_MACOS
    _nr = 4000;   # no Mach-O row on either backend (rows stop well below; 4095 is the arm cmp cap)

    test_group("Darwin: an unrouted syscall, SIGSYS ignored, returns -ENOSYS");
    assert_eq(signal_ignore(12), 0, "signal_ignore(SIGSYS) == 0");
    var pid = syscall(SYS_GETPID);
    assert(pid > 0, "getpid > 0 (primes the syscall register with a distinctive answer)");
    var r = syscall(_unrouted_nr(), 0, 0, 0);
    assert(r != pid, "a runtime unrouted number does NOT re-run the previous call (was: == getpid)");
    assert_eq(r, 0 - 78, "a runtime unrouted number returns -ENOSYS (-78)");
    var pid2 = syscall(SYS_GETPID);
    var r2 = syscall(4001, 0, 0, 0);
    assert(r2 != pid2, "a literal unrouted number does NOT re-run the previous call");
    assert_eq(r2, 0 - 78, "a literal unrouted number returns -ENOSYS (-78)");

    # The stdlib must not be the thing that faults. arm64-macOS resolves the aarch64-LINUX peer,
    # whose pause / epoll_wait / inotify issued numbers Darwin has no row for (1073, raw 232,
    # 26/27/28) — a stale x16 before the fix, a SIGSYS after it — so they decline instead, as
    # the x86-macOS peer's sys_pause has since 6.6.5. Asserted with SIGSYS still ignored, so a
    # wrapper that regressed to issuing its number shows up as a FAIL here, not a dead process.
    test_group("Darwin: the peer declines what Darwin does not have (-ENOSYS, no syscall)");
    assert_eq(sys_pause(), 0 - 78, "sys_pause() == -78 (Darwin has no pause; would block on Linux)");
    var evs[64];
    assert_eq(sys_epoll_wait(0, &evs, 1, 0), 0 - 78, "sys_epoll_wait() == -78 (no epoll on Darwin)");
    assert_eq(sys_inotify_init(), 0 - 78, "sys_inotify_init() == -78");
    assert_eq(sys_inotify_add_watch(0, ".", IN_MODIFY), 0 - 78, "sys_inotify_add_watch() == -78");
    assert_eq(sys_inotify_rm_watch(0, 1), 0 - 78, "sys_inotify_rm_watch() == -78");

    # getdents: prime the 4th-argument register with &sent (a failing 4-arg openat), then list
    # a real, open directory. The broken wrapper returned Darwin records (n > 0) AND zeroed sent.
    var sent[8];
    store64(&sent, 0x5A5A5A5A5A5A5A5A);
    var dfd = sys_open(".", O_RDONLY, 0);
    assert(dfd >= 0, "open(\".\") for the getdents probe");
    var dbuf[4096];
    syscall(SYS_OPENAT, 0 - 100, "/nonexistent-cyrius-6610", 0, &sent);
    assert_eq(sys_getdents64(dfd, &dbuf, 4096), 0 - 78,
      "sys_getdents64() == -78 (Darwin getdirentries64 has a 4th basep out-pointer)");
    assert_eq(load64(&sent), 0x5A5A5A5A5A5A5A5A,
      "the sentinel the 4th-argument register pointed at is intact (was: zeroed)");
    sys_close(dfd);

    # 6.6.12 (Q3). faccessat: x86-macOS had no 269 row, so this SIGSYS'd on ach (rc 140) while the
    # same source worked on ecb; asserted with SIGSYS ignored, the regression reads -78 here.
    # dup3: arm64-macOS renumbered 24 → dup2 90, and Darwin's dup2 ignores x2, so
    # dup3(1, 51, O_CLOEXEC) handed back fd 51 with FD_CLOEXEC CLEAR (measured on ecb). There is
    # no dup3 on Darwin, so the honest answer is the unrouted one — -ENOSYS and no fd — on both
    # Macs; sys_dup2 issues x86 dup2 33 instead and must keep working.
    test_group("Darwin: faccessat is routed on both Macs; dup3 never drops its flags");
    assert_eq(syscall(SYS_FACCESSAT, AT_FDCWD, "/", 0, 0), 0, "faccessat(AT_FDCWD, \"/\") == 0 (was: SIGSYS on x86-macOS)");
    assert_eq(syscall(SYS_FACCESSAT, AT_FDCWD, "/nonexistent-cyrius-6612", 0, 0), 0 - 2,
      "faccessat on a missing path == -ENOENT");
    assert_eq(sys_access("/", 0), 0, "sys_access(\"/\") == 0");
    sys_close(50);
    assert_eq(sys_dup2(1, 50), 50, "sys_dup2(1, 50) == 50 (x86 dup2 33 → BSD 90)");
    assert_eq(sys_fcntl(50, F_GETFD, 0), 0, "the dup2'd fd has FD_CLOEXEC clear, as dup2 promises");
    sys_close(50);
    sys_close(51);
    var d3 = syscall(_dup3_nr(), 1, 51, O_CLOEXEC);
    assert_eq(d3, 0 - 78, "dup3(1, 51, O_CLOEXEC) == -ENOSYS (was: 51 with the flag dropped on arm64)");
    assert(sys_fcntl(51, F_GETFD, 0) < 0, "and fd 51 was not created behind the caller's back");

    # The x86-macOS peer now has the arm64-macOS surface: the flag enums, the SYS_* names and the
    # pure helpers all resolve (this group did not COMPILE on ach before 6.6.10).
    test_group("Darwin: both Macs expose the same Linux-shaped surface");
    assert_eq(IN_MODIFY, 2, "IN_MODIFY resolves (InotifyEvent)");
    assert_eq(IN_CLOSE_WRITE, 8, "IN_CLOSE_WRITE resolves");
    assert_eq(MS_BIND, 4096, "MS_BIND resolves (MsFlag)");
    assert_eq(MS_RDONLY, 1, "MS_RDONLY resolves");
    assert_eq(SYS_FLOCK, 73, "SYS_FLOCK is the x86 number 73 on both Macs (renumbered to BSD 131)");
    assert(SYS_DUP3 > 0, "SYS_DUP3 resolves");
    assert(SYS_FACCESSAT > 0, "SYS_FACCESSAT resolves");
    assert(SYS_SYSINFO > 0, "SYS_SYSINFO resolves");
    assert(SYS_INOTIFY_INIT1 > 0, "SYS_INOTIFY_INIT1 resolves");
    var ss = sigset_new();
    assert(ss != 0, "sigset_new() returns a set");
    sigset_add(ss, 15);
    assert_eq(sigset_has(ss, 15), 1, "sigset_has(15) after sigset_add(15)");
    assert_eq(sigset_has(ss, 9), 0, "sigset_has(9) is clear");
    var ev = epoll_event_new(EPOLLIN, 0x1122334455);
    assert(ev != 0, "epoll_event_new() returns an event");
    assert_eq(load32(ev), EPOLLIN, "epoll_event.events @0");
    #ifdef CYRIUS_ARCH_AARCH64
    assert_eq(load64(ev + 8), 0x1122334455, "epoll_event.data @8 (aarch64: unpacked)");
    #endif
    #ifdef CYRIUS_ARCH_X86
    assert_eq(load64(ev + 4), 0x1122334455, "epoll_event.data @4 (x86_64: packed)");
    #endif
    var ts = timerspec_new(3, 5);
    assert(ts != 0, "timerspec_new() returns an itimerspec");
    assert_eq(load64(ts), 3, "itimerspec.it_interval.tv_sec");
    assert_eq(load64(ts + 16), 5, "itimerspec.it_value.tv_sec");
    assert_eq(timerfd_drain(0 - 1), 0, "timerfd_drain() on a bad fd reads nothing and returns 0");

    test_group("Darwin: by default an unrouted syscall kills the process with SIGSYS");
    assert_eq(signal_default(12), 0, "signal_default(SIGSYS) == 0");
    var child = sys_fork();
    if (child == 0) {
        syscall(_unrouted_nr(), 0, 0, 0);
        syscall(60, 0);   # reached only if the call did NOT fault — the parent sees exit 0
    }
    assert(child > 0, "fork succeeded");
    var st = 0;
    var w = sys_waitpid(child, &st, 0);
    assert_eq(w, child, "waitpid returns the child");
    assert_eq(WIFSIGNALED(st), 1, "the child was killed by a signal");
    assert_eq(WTERMSIG(st), 12, "the signal is SIGSYS (12)");
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    test_group("not Darwin: an unrouted number passes through by design — nothing to assert");
    assert_eq(1, 1, "skipped");
    #endif
    return assert_summary();
}
var ec = main();
syscall(60, ec);
