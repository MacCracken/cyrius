# ---- top level: statements through a global `*i16` ----
zero();
store64(&BUF, 0x9999999999999999);
G16 = &BUF + 2;
*G16 = 0 - 2;
*G16 *= 21;
assert_eq(*G16, 0 - 42, "top level: *G = -2; *G *= 21 through a global *i16");
assert_eq(load64(&BUF), 0x99999999FFD69999, "top level: bytes 2..3 only");
var r = assert_summary();
