fn dH_locd(): i64 { var o = OH { 0, 0, 99 }; var p: *SH = &o; var x = SH { 1, 2 }; var q: *SH = &x; *p = *q; zeroH(&x); return valH(p) + (o.g != 99) * 1000000000; }
fn dH_locu(): i64 { var o = OH { 0, 0, 99 }; var p: *SH = &o; fillee(p, 16); var x = UW; *p = x; return ub(p, 16, 99); }
fn dH_P(): i64 { var l = SH { 1, 2 }; *GPH = l; zeroH(&l); return cH(); }
fn dH_ar(): i64 { var p: *SH = &GTH; var l = SH { 1, 2 }; *(p + 0) = l; zeroH(&l); return cH(); }
fn dH_cl(): i64 { var l = SH { 1, 2 }; *gpH() = l; zeroH(&l); return cH(); }
fn dH_wp(): i64 { var w = WH { 0, 1, 2, 7, 0 }; w.p = &GTH; var l = SH { 1, 2 }; *w.p = l; zeroH(&l); return cH(); }
fn dH_self(): i64 { var l = SH { 1, 2 }; GTH.put(l); return cH(); }
fn dH_selfp(): i64 { var l = SH { 1, 2 }; GTH.putp(l); return cH(); }
fn dH_pp(q: *SH): i64 { var l = SH { 1, 2 }; *q = l; zeroH(&l); return cH(); }
