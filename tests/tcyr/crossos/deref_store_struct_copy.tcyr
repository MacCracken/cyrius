# deref_store_struct_copy.tcyr — 6.7.11. `*p = v` THROUGH A `*S` COPIES THE STRUCT (the user's decision (a),
# 2026-10-13; issues/archived/2026-10-11-deref-store-through-struct-pointer-decision.md): exactly `sizeof(S)` bytes (none for
# a zero-size struct) from any `S` value `G = v` takes — a local, a by-value parameter, a global, a field, a call, a
# method or operator result, a handle or a `*S` (copied, never rebound), `*q` — as `p = l` and `G = l` (with
# `p = &G`) copy it; an untyped value is stored as the struct's word at `sizeof(S)` bytes, at most 8, never past
# the object.
#
# ⛔ THROUGH 6.7.10 the store was neither: a zero-size struct took 8 bytes over the next global, a 3 B one the whole
# 8-byte word (past the object), a 4 B one its first field, a 16 B one its first 8 bytes (42 where 90 is right), a
# 24 B one its first word.
#
# THE RULES, at 0, 3, 4, 5, 6, 7, 8, 9, 16 and 24 B (unsigned narrow fields; the source's fields 1, 2, 3 ..., read
# back as the digits 123...): every source above into `*p` (p a `*S` local pointing at a global; the guard byte
# packed right after that global kept, +1000000000), into a struct inside a larger local (its next field kept),
# through `*P` (a `*S` global), `*(p + 0)`, `*gp()`, `*w.p`, a `*S` parameter, `*self` in an impl method (an
# untyped `self` too) and a for step; a copy, not an alias (the source written after the store); an untyped value
# byte-exact (`ub`: its low bytes in place, the bytes past 8 untouched, nothing past the object); at top level too
# (a call / method / operator result over 8 B has no frame there, as `G = v`); a statement nested in the source (a
# closure body's own `p = m`) is its own assignment. Another struct and `*p OP= v` are refused by name
# (tests/gates/frontend/struct_copy_type_checked.sh).
#
# CROSS-HOST: the release gate's cross-OS leg runs it on ecb / ach / cass / pi; tests/gates/codegen/
# small_struct_handle_line.sh R15 on x86_64 (plain, CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm)
# and PE (wine).
include "lib/assert.cyr"

# 1 = the `sz` bytes at `p` are the word 0x0807060504030201's low bytes (at most 8) and 0xEE past them, and the
# byte after them is `g` — an untyped value stored as the struct's word, nothing past the object.
fn ub(p, sz, g): i64 {
    var k = 0;
    while (k < sz) {
        var want = 0xEE;
        if (k < 8) { want = k + 1; }
        if (load8(p + k) != want) { return 0; }
        k = k + 1;
    }
    if (load8(p + sz) != g) { return 0; }
    return 1;
}
fn fillee(p, sz): i64 { var k = 0; while (k < sz) { store8(p + k, 0xEE); k = k + 1; } return 0; }
var UW = 0x0807060504030201;

# ── 0 B ──
struct S0 {  }
struct W0 { k; s: S0; g: u8; p: *S0; }
struct O0 { s: S0; g: u8; }
var GT0 = S0 { };
var GZ0: u8 = 99;
var GL0 = S0 { };
var GP0: *S0 = &GT0;
var GQ0: *S0 = &GL0;
fn set0(p: *S0): i64 {  return 0; }
fn zero0(p: *S0): i64 {  return 0; }
fn val0(p: *S0): i64 { return 0; }
fn mk0(): S0 { var r: S0; set0(&r); return r; }
fn gp0(): *S0 { return GP0; }
fn gq0(): *S0 { return GQ0; }
impl S0 {
    fn dup(self: *S0): S0 { return mk0(); }
    fn put(self, l: S0): i64 { *self = l; return 0; }
    fn putp(self: *S0, l: S0): i64 { *self = l; return 0; }
}
var ZHIT0 = 0;
fn S0_add(l: S0, r: S0): S0 { var t: S0; ZHIT0 = ZHIT0 + 1; return t; }
fn c0(): i64 { var r = val0(&GT0) + (GZ0 != 99) * 1000000000; zero0(&GT0); return r; }
fn d0_l(): i64 { var p: *S0 = &GT0; var l = S0 { }; *p = l; zero0(&l); return c0(); }
fn d0_byv(l: S0): i64 { var p: *S0 = &GT0; *p = l; zero0(&l); return c0(); }
fn d0_glob(): i64 { var p: *S0 = &GT0; *p = GL0; zero0(&GL0); var r = c0(); set0(&GL0); return r; }
fn d0_fld(): i64 { var p: *S0 = &GT0; var w = W0 { 0, 7, 0 }; *p = w.s;  return c0() + (w.g != 7) * 1000000000; }
fn d0_call(): i64 { var p: *S0 = &GT0; *p = mk0(); return c0(); }
fn d0_meth(): i64 { var p: *S0 = &GT0; var l = S0 { }; *p = l.dup(); return c0(); }
fn d0_op(): i64 { var p: *S0 = &GT0; var z = S0 { }; var l = S0 { }; *p = z + l; zero0(&l); return c0(); }
fn d0_dq(): i64 { var p: *S0 = &GT0; var x = S0 { }; var q: *S0 = &x; *p = *q; zero0(&x); return c0(); }
fn d0_q(): i64 { var p: *S0 = &GT0; var x = S0 { }; var q: *S0 = &x; *p = q; zero0(&x); return c0() + (q != &x) * 1000000000; }
fn d0_h(): i64 { var p: *S0 = &GT0; var x = S0 { }; var h: S0 = &x; *p = h; zero0(&x); return c0(); }
fn d0_gq(): i64 { var p: *S0 = &GT0; *p = GQ0; zero0(&GL0); var r = c0(); set0(&GL0); return r; }
fn d0_cq(): i64 { var p: *S0 = &GT0; *p = gq0(); zero0(&GL0); var r = c0(); set0(&GL0); return r; }
fn d0_ut(): i64 { var p: *S0 = &GT0; fillee(&GT0, 0); var x = UW; *p = x; var r = ub(&GT0, 0, 99); zero0(&GT0); return r; }
fn d0_loc(): i64 { var o = O0 { 99 }; var p: *S0 = &o; var l = S0 { }; *p = l; zero0(&l); return val0(p) + (o.g != 99) * 1000000000; }
fn d0_locc(): i64 { var o = O0 { 99 }; var p: *S0 = &o; *p = mk0(); return val0(p) + (o.g != 99) * 1000000000; }
fn d0_locd(): i64 { var o = O0 { 99 }; var p: *S0 = &o; var x = S0 { }; var q: *S0 = &x; *p = *q; zero0(&x); return val0(p) + (o.g != 99) * 1000000000; }
fn d0_locu(): i64 { var o = O0 { 99 }; var p: *S0 = &o; fillee(p, 0); var x = UW; *p = x; return ub(p, 0, 99); }
fn d0_P(): i64 { var l = S0 { }; *GP0 = l; zero0(&l); return c0(); }
fn d0_ar(): i64 { var p: *S0 = &GT0; var l = S0 { }; *(p + 0) = l; zero0(&l); return c0(); }
fn d0_cl(): i64 { var l = S0 { }; *gp0() = l; zero0(&l); return c0(); }
fn d0_wp(): i64 { var w = W0 { 0, 7, 0 }; w.p = &GT0; var l = S0 { }; *w.p = l; zero0(&l); return c0(); }
fn d0_self(): i64 { var l = S0 { }; GT0.put(l); return c0(); }
fn d0_selfp(): i64 { var l = S0 { }; GT0.putp(l); return c0(); }
fn d0_pp(q: *S0): i64 { var l = S0 { }; *q = l; zero0(&l); return c0(); }
fn d0_for(): i64 {
    var p: *S0 = &GT0;
    var l = S0 { };
    for (var i = 0; i < 1; *p = l) { i = 1; }
    zero0(&l);
    return c0();
}

# ── 6.7.13: a zero-size struct into a struct-typed FIELD, and a zero-size `*p` as a VALUE, move no byte
# (issues/2026-10-14-zero-size-struct-into-field-or-dereference-value-moves-a-word.md). Through 6.7.12 `o.s = GP`,
# `o.s = gp()`, `o.s = (GP)`, `o.s = mk()` and `o.s = 5` stored an 8-byte word over the field's neighbour (0 where
# 77 is right), and `*p` as a value loaded the word at p — 8 bytes past the object: `tw0(*p)` saw the guard byte
# after GT0 (99), `bp0(*p)` into a `*S0` parameter got that word as the pointer, `*p + l` did not dispatch
# (a SIGSEGV at the end of a mapping: tests/gates/codegen/small_struct_handle_line.sh PZ). Now the word is 0, the
# pointer p, and `S0_add` is called, as at every other size.
struct OZ0 { s: S0; n; }
fn tw0(e: S0): i64 { return load64(&e); }
fn bp0(q: *S0): i64 { if (q == &GT0) { return 1; } return 0; }
fn z0_fg(): i64 { var o: OZ0; o.n = 77; o.s = GP0; return o.n; }
fn z0_fc(): i64 { var o: OZ0; o.n = 77; o.s = gp0(); return o.n; }
fn z0_fw(): i64 { var o: OZ0; o.n = 77; o.s = (GP0); return o.n; }
fn z0_fm(): i64 { var o: OZ0; o.n = 77; o.s = mk0(); return o.n; }
fn z0_f5(): i64 { var o: OZ0; o.n = 77; o.s = 5; return o.n; }
fn z0_fq(): i64 { var o: OZ0; o.n = 77; var q: *S0 = &GT0; o.s = q; return o.n; }
fn z0_fd(): i64 { var o: OZ0; o.n = 77; o.s = *GP0; return o.n; }
fn z0_po(): i64 { var b = OZ0 { 77 }; var o: *OZ0 = &b; o.s = gp0(); o.s = mk0(); return b.n; }
fn z0_tw(): i64 { var p: *S0 = &GT0; return tw0(*p); }
fn z0_tp(): i64 { var p: *S0 = &GT0; return tw0((*p)); }
fn z0_tc(): i64 { return tw0(*gp0()); }
fn z0_l(): i64 { var p: *S0 = &GT0; var a = 77; var l: S0 = *p; var b = 77; return a + b - 77 + tw0(l) * 0; }
fn z0_bp(): i64 { var p: *S0 = &GT0; return bp0(*p); }
fn z0_op(): i64 { var p: *S0 = &GT0; var l = S0 { }; ZHIT0 = 0; var r: S0 = *p + l; return ZHIT0; }

