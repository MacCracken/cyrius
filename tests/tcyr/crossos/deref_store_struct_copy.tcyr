# A statement nested in the source (a closure body's `p = m`, its own `*S3` named p) is its own assignment:
# it copies m into ITS p's struct and never into the outer store's.
var GK3 = 0;
fn pick3(f, l: S3): S3 { GK3 = callptr(f, 0); return l; }
fn d3_nest(): i64 {
    var p: *S3 = &GT3;
    var l = S3 { 1, 2, 3 };
    *p = pick3(|d| { var t = S3 { 7, 7, 7 }; var p: *S3 = &t; var m = S3 { 9, 8, 7 }; p = m; return val3(&t); }, l);
    return c3() * 1000 + GK3;
}

