fn dw_main(): i64 {
    var s = S { 1, 2 };
    var p: *S = &s;
    *p = 7;
    return s.a * 10 + s.b;
}
fn dw_zero(): i64 { var s = S { 1, 2 }; var p: *S = &s; *p = 0; return s.a * 10 + s.b; }
fn dH_ut(): i64 { var p: *SH = &GTH; fillee(&GTH, 16); var x = UW; *p = x; var r = ub(&GTH, 16, 99); zeroH(&GTH); return r; }
fn dH_loc(): i64 { var o = OH { 0, 0, 99 }; var p: *SH = &o; var l = SH { 1, 2 }; *p = l; zeroH(&l); return valH(p) + (o.g != 99) * 1000000000; }
