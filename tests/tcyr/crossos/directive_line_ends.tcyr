# directive_line_ends.tcyr — a directive line reads its whole line, and the line after it runs (6.7.17,
# issues/2026-10-21-directive-line-tails-unread-use-without-path-late-private.md).
#   U  a `use` with no `;` ends at its line: pass 2 stepped to the NEXT `;`, so `use dle.seven` dropped the statement on
#      the line after it (`dle_u = seven();` never ran: 0, not 7)
#   A  an #assert's line ends at its `;` or the line's end (the user's D28 refuses anything else there): a statement
#      after the `;` on its line runs, the line after a `;`-less message runs, and an impl's `#assert .., "m";` keeps
#      the method after it
#   I  an include line may end with `;` and a `#` comment (the user's D29 refuses anything else there): the two lines
#      below are such controls, the second an include-once skip
#   P  a file-level `private` line after the first top-level statement compiles (the user's D31): the statements after
#      it run ("unexpected private" through 6.7.16)
# WHY A CROSS-HOST TEST. Each reader is in the shared front end, but the consequence is a statement that runs or not,
# on every target alike; these rows run on ecb / ach / cass / pi with the release gate's cross-OS leg.
include "lib/assert.cyr"  # I: a comment after the file name
include "lib/assert.cyr";  # I: `;` then a comment, on an include-once skip

struct DleS { a; }
impl DleS { #assert 1 == 1, "m"; fn five(self): i64 { return 5; } }

var dle_u = 0;
mod dle;
fn seven(): i64 { return 7; }
use dle.seven
dle_u = seven();
assert_eq(dle_u, 7, "U: the statement after a `;`-less `use` ran");

var dle_a = 0;
#assert 1 == 1, "m"; dle_a = 9;
assert_eq(dle_a, 9, "A: a statement after the message's `;` on its line ran");
var dle_b = 0;
#assert 1 == 1, "m"
dle_b = 4;
assert_eq(dle_b, 4, "A: the line after a `;`-less message ran");
var dle_s = DleS { 1 };
assert_eq(dle_s.five(), 5, "A: an impl's `#assert .., \"m\";` keeps the method after it");

private
var dle_p = 6;
dle_p = dle_p + 1;
assert_eq(dle_p, 7, "P: the statements after a late `private` line ran");

var r = assert_summary();
