assert_eq(gi_fields(), 244242, "GI: a **P3 field, a nested one, one through a *W");
assert_eq(gi_st(gi_mkpp()) * 100 + gi_tg(gi_gpp(GI_PPS)), 2442, "GI: a : **P3 call and a generic call at its instance");
assert_eq(gi_addr(), 2442, "GI: &ps of a *P3 local and &G of a *P3 global");
assert_eq(gi_cap(), 4225, "GI: a captured **P3");
assert_eq(gi_meth(), 66, "GI: a generic method's **T");
assert_eq(gi_result(), 42, "GI: a : T result binds the struct (var v = gd(pps); v.c)");
assert_eq(gi_pair(), 2416, "GI: two type parameters, each from its own **");
assert_eq(gi_misc(), 242424, "GI: sizeof(T), a named argument, a forwarder's instance");
assert_eq(gi_uses(), 24, "GI: a call above the generic's definition");
