assert_eq(gi_stub(), 5, "GW: var r = gd(pk + 0); r.pick(t) in a generic (the stub scan reads the arithmetic too)");
assert_eq(gi_deep(), 24424242, "GD: s3(ppps) steps 24, t3(ppps), t4(p4) and t4(&ppps) pass the struct (D24 A; were 8 / a fault)");
