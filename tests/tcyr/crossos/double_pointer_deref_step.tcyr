# double_pointer_deref_step.tcyr — 6.7.13 (the user's decision D9 (a), 2026-10-15) — `*pp` of a `pp: **T` is a
# `*T`: `*pp + n` steps n elements, `var q: *T = *pp;` is silent, and `**pp` through a narrow T (`**u8`, `**i32`)
# reads and writes the element.
#
# A `**T` stepped a pointer's 8 and said nothing about its pointee, so `*pp` was an untyped word: `*(*pp + 1)`
# read 8 bytes one BYTE past the pointee (the filed repro exited 1 on x86_64 and aarch64), `**pp` read 8 bytes
# whatever T was, and `var q: *T = *pp;` warned "assigning non-pointer to typed pointer"
# (issues/archived/2026-10-13-double-pointer-dereference-is-an-untyped-word.md). The pointee's step word now rides the
# `**T`'s (its pin; 6.7.14: bit 62 and bits 48-61): a local, a parameter, a closure capture, a global, a field, a `: **T` return, a
# generic instance's, `pp + n`, a `***T` (whose `*ppp` is a `**T`), a field `**S` of the struct being declared
# (sized when it is dereferenced), a `**f64v2` (its `*ppv` a `*f64v2`: `rd(**ppv)` passes the pointer, D27).
#
# GI (6.7.14, the user's decision D40 A, 2026-10-16): a generic's `pp: **T` with no `<..>` binds T to the struct a
# `**S` argument points through to, as `st<S>(pps)` does — `st(pps)` ran the i64 base, so `*pp + 1` stepped 8 and
# `take(**pp)` into `*P3` faulted (issues/archived/2026-10-16-generic-double-pointer-parameter-pointee-unbound.md). Every
# `**S` source (a local, a parameter, a global, a field chain, a call, a generic call, `&p` / `&G` of a `*S`, a
# capture), a method, a `: T` result, two type parameters, a named argument, a forward call, a forwarder; GK: the
# controls (a direct or a struct carrier wins; a `*S`, a `**Q2` that is no `**T`, `&ps + 0` — a byte pointer, 6.7.11's
# D15 — bind nothing; 6.7.15, the user's decision D11 (a), 2026-10-18: a `**i32` binds i32 — it bound nothing, i64).
# GW (6.7.15, the user's decisions D22 A / D23 A, 2026-10-18): parentheses around the whole argument are transparent
# and a typed pointer plus or minus n is still that pointer — `tg((pps))`, `tg((&ps))`, `tg(pps + 0)`, `n + pps`,
# `(pps) - n`, a field / global / call + 0, a method, and through a single-star `p: *T` `g(ps + 1)` / `g(1 + ps)` /
# a `*i32`'s `pa + 1` — each ran the i64 base (8, or a fault for `take(**pp)`); a generic that forwards the result's
# T into a method (the stub scan, `_tok_ta_arith`). GD (D24 A): `ppp: ***T` and `****T` bind T from a `***S` /
# `****S` argument (`&pps` of a `**S` too) — they ran the i64 base (81 for 241, `take(***ppp)` faulted). The filed
# repros verbatim: tests/gates/frontend/generic_double_pointer_infer.sh.
#
# CROSS-HOST: frontend typing, but the element reads and writes are each backend's narrow loads and stores. Run
# on ecb / ach (Mach-O), cass (PE) and pi (aarch64) by the release gate.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"
include "lib/simd.cyr"
include "lib/assert.cyr"

struct Node { val; kids: **Node; n; }
struct H { k; pp: **i64; p8: **u8; }
struct GiP3 { a; b; c; }   # GI (below)
struct GiQ2 { u; v; }
struct GiW { x; pp: **GiP3; }
struct GiH { k; w: GiW; }
impl GiP3 { fn gm<T>(self, pp: **T): i64 { var a = *pp + 1; var b = *pp; return a - b + self.c; } }
impl GiP3 { fn gm1<T>(self, p: *T): i64 { var a = p + 1; var b = p; return a - b + self.c; } }   # GW
impl GiP3 { fn gm3<T>(self, ppp: ***T): i64 { return gi_take(***ppp) + self.a; } }                 # GD
struct GiW3 { x; ppp: ***GiP3; }                                                                    # GD
struct GiPk { n; }                                                                                  # GW: the stub scan
struct GiQk { a; b; }
impl GiPk { fn pick<V>(self, w: V): i64 { return w.b + self.n; } }

var GA: i64[3];
var GP: *i64 = 0;

# The filed repro's two fns, verbatim but for the names (its `main` is dp_filed).
fn second(pp: **i64): i64 { return *(*pp + 1); }
fn dp_filed(): i64 {
    var a: i64[2];
    store64(&a, 5);
    store64(&a + 8, 42);
    var p: *i64 = &a;
    var pp: **i64 = &p;
    var q: *i64 = *pp;          # warns: assigning non-pointer to typed pointer
    if (*(q + 1) != 42) { return 3; }
    if (*(*pp + 1) != 42) { return 1; }   # a `**i64` local: `*pp + 1` steps one byte
    if (second(pp) != 42) { return 2; }   # a `**i64` parameter (6.7.11): the same
    return 0;
}

fn gsec<T>(pp: **T): i64 { return *(*pp + 1); }
fn sp_hi(p: *f64v2): i64 { var q = p; return load64(q + 8); }
fn bytes_of(pp: **i64): i64 { var b = *pp + 1; var a = *pp; return b - a; }   # untyped copies: the byte distance

fn r_local(): i64 {
    var a: i64[3];
    a[0] = 5; a[1] = 42; a[2] = 77;
    var p: *i64 = &a;
    var pp: **i64 = &p;
    return *(*pp + 1) * 100 + *(*pp + 2) - 77 + (*pp + 2 - *pp);   # 4200 + 77 - 77 + 2
}
fn r_bytes(): i64 {
    var a: i64[2];
    var p: *i64 = &a;
    var pp: **i64 = &p;
    return bytes_of(pp);
}
fn r_diff(): i64 {
    var a: i64[4];
    var p: *i64 = &a;
    var p3: *i64 = p + 3;
    var pp: **i64 = &p;
    var qq: **i64 = &p3;
    return *qq - *pp;
}
fn r_ppadd(): i64 {   # `pp + 1` keeps the pin: its dereference is still a `*i64`
    var a: i64[3];
    a[2] = 9;
    var ps: i64[2];
    store64(&ps, &a); store64(&ps + 8, &a);
    var pp: **i64 = &ps;
    return *(*(pp + 1) + 2);
}
fn r_bind(): i64 {
    var a: i64[2];
    a[1] = 31;
    var p: *i64 = &a;
    var pp: **i64 = &p;
    var q: *i64 = *pp;
    q = *pp;
    return *(q + 1);
}
fn r_field(): i64 {
    var a: i64[2];
    a[1] = 61;
    var p: *i64 = &a;
    var h: H;
    h.pp = &p;
    var hp: *H = &h;
    return *(*h.pp + 1) + *(*hp.pp + 1);
}
fn r_triple(): i64 {
    var a: i64[2];
    a[0] = 5; a[1] = 42;
    var p: *i64 = &a;
    var pp: **i64 = &p;
    var ppp: ***i64 = &pp;
    var x = *ppp + 1;   # a `**i64` steps a pointer's 8
    var y = *ppp;
    return *(**ppp + 1) * 100 + ***ppp + (x - y);   # 4200 + 5 + 8
}
fn r_u8(): i64 {
    var b: u8[4];
    b[0] = 255; b[1] = 1; b[2] = 2; b[3] = 3;
    var p8: *u8 = &b;
    var pp8: **u8 = &p8;
    return **pp8 * 10 + *(*pp8 + 2);   # 2552: the element, not the word 0x030201FF
}
fn r_u8_store(): i64 {
    var b: u8[4];
    b[0] = 255; b[1] = 1; b[2] = 2; b[3] = 3;
    var p8: *u8 = &b;
    var pp8: **u8 = &p8;
    **pp8 = 9;          # one byte
    **pp8 += 1;
    return b[0] * 1000 + b[1] * 100 + b[2] * 10 + b[3];   # 10123
}
fn r_i32(): i64 {
    var e: i32[2];
    e[0] = 0 - 5; e[1] = 7;
    var p32: *i32 = &e;
    var pp32: **i32 = &p32;
    if (**pp32 != 0 - 5) { return 1; }       # sign-extended, 4 bytes
    if (*(*pp32 + 1) != 7) { return 2; }
    **pp32 += 3;                             # 4 bytes: e[1] untouched
    if (e[0] != 0 - 2) { return 3; }
    if (e[1] != 7) { return 4; }
    return 0;
}
fn r_param32(pp: **i32): i64 { return *(*pp + 1); }
fn r_p32(): i64 { var e: i32[2]; e[1] = 23; var p: *i32 = &e; return r_param32(&p); }
fn r_closure(): i64 {
    var a: i64[2];
    a[1] = 47;
    var p: *i64 = &a;
    var pp: **i64 = &p;
    var c = || { return *(*pp + 1); };
    return callptr(c);
}
fn r_generic(): i64 {
    var a: i64[2];
    a[1] = 42;
    var p: *i64 = &a;
    var e: i32[2];
    e[1] = 7;
    var p32: *i32 = &e;
    return gsec<i64>(&p) * 10 + gsec<i32>(&p32);   # 427
}
fn r_node(): i64 {
    var arr: Node[2];
    var kids: *Node = &arr;
    var n0: Node;
    n0.kids = &kids;
    var x = *n0.kids + 1;   # a Node steps sizeof(Node), 24 (8 while the field was declared)
    var y = *n0.kids;
    return x - y;
}
fn r_compound(): i64 {   # `*pp += n` steps the pointee as `*pp = *pp + n` does
    var a: i64[4];
    a[3] = 13;
    var p: *i64 = &a;
    var pp: **i64 = &p;
    *pp += 3;
    var x = *p;
    *pp -= 2;
    var u = p;
    var w = &a;
    var h: H;
    h.pp = &p;
    *h.pp += 1;
    var u2 = p;
    for (var i = 0; i < 1; *pp -= 1) { i = i + 1; }
    var u3 = p;
    return x * 1000 + (u - w) * 10 + (u2 - w) / 8 + (u3 - w);   # 13000 + 80 + 2 + 8
}
fn r_ifexpr(): i64 {
    var a: i64[3];
    a[2] = 22;
    var p: *i64 = &a;
    var pp: **i64 = &p;
    var qq: **i64 = &p;
    var c = 1;
    return *(if (c == 1) { *pp } else { *qq } + 2);
}
struct Bx<T> { v: T; w: T; }
fn r_box(): i64 {
    var bs: Bx<i32>[3];
    var p: *Bx<i32> = &bs;
    var pp: **Bx<i32> = &p;
    var x = *pp + 1;   # sizeof(Bx<i32>), 8
    var y = *pp;
    return x - y;
}
fn r_f32(): i64 {
    var f: f32[2];
    store32(&f, 0x40200000);   # 2.5
    var p: *f32 = &f;
    var pp: **f32 = &p;
    var one: f32 = 1.0;
    var g: f32 = **pp + one;   # an f32 add: 3.5
    return load32(&g);
}
fn r_vec(): i64 {
    var two: f64v2[2];
    var pt: *f64v2 = &two;
    var ppt: **f64v2 = &pt;
    var x = *ppt + 1;   # 16
    var y = *ppt;
    var b: f64v2 = f64v2_make(11, 22);
    var pb: *f64v2 = &b;
    var ppb: **f64v2 = &pb;
    var q: *f64v2 = *ppb;
    return (x - y) * 100 + sp_hi(**ppb) - load64(q);   # 1600 + 22 - 11
}

GP = &GA;
GA[0] = 3; GA[1] = 4; GA[2] = 5;
# A `**T` global past the first statement (a declaration-zone one does not parse yet: issues/2026-10-14-declaration-
# zone-pointer-annotation-replay-reads-one-star.md, placed 6.7.14).
var GPP: **i64 = &GP;
var GPPP: ***i64 = &GPP;
var TQ = *(*GPP + 2);   # top level: a `**i64` global
var TQ2: *i64 = *GPP;   # silent
*GPP += 2;              # top level: steps 16 bytes
var TQ3 = **GPP;
*GPP -= 2;
fn gpp(): **i64 { return GPP; }
fn r_global(): i64 { var q: *i64 = *GPP; return *(*GPP + 1) * 10 + *(q + 2); }
fn r_ret(): i64 { return *(*gpp() + 2); }
fn r_gtriple(): i64 { return *(**GPPP + 1); }

# GI — a `pp: **T` binds T from a `**S` argument (D40 A). Each was the i64 base: 8, or a fault for `take(**pp)`.
fn gi_take(p: *GiP3): i64 { return p.c; }
fn gi_uses(): i64 { var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; return gi_late(&ps); }   # above the generic
fn gi_st<T>(pp: **T): i64 { var a = *pp + 1; var b = *pp; return a - b; }
fn gi_tg<T>(pp: **T): i64 { return gi_take(**pp); }
fn gi_sz<T>(pp: **T): i64 { return sizeof(T); }
fn gi_late<T>(pp: **T): i64 { return sizeof(T); }
fn gi_gd<T>(pp: **T): T { return **pp; }
fn gi_two<A, B>(pa: **A, pb: **B): i64 { return sizeof(A) * 100 + sizeof(B); }
fn gi_fw<T>(pp: **T): i64 { return gi_st(pp); }
fn gi_gpp<T>(x: **T): **T { return x; }
fn gi_viap(pps: **GiP3): i64 { return gi_st(pps) + gi_tg(pps); }
fn gi_mix<T>(pp: **T, x: T): i64 { return sizeof(T); }
fn gi_both<T>(b: *Bx<T>, pp: **T): i64 { return sizeof(T); }
fn gi_nt<T>(pp: **GiQ2): i64 { return sizeof(T); }
var GI_S = GiP3 { 7, 8, 42 };
var GI_PS: *GiP3 = &GI_S;
var GI_PPS: **GiP3 = &GI_PS;
fn gi_mkpp(): **GiP3 { return GI_PPS; }
fn gi_fields(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    var w: GiW; w.pp = pps; var h: GiH; h.w.pp = pps; var pw: *GiW = &w;
    return gi_st(w.pp) * 10000 + gi_tg(h.w.pp) * 100 + gi_tg(pw.pp);   # 244242
}
fn gi_addr(): i64 { var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; return gi_st(&ps) * 100 + gi_tg(&GI_PS); }
fn gi_cap(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    var f = |k| gi_tg(pps) * 100 + gi_st(pps) + k;
    return fncall1(f, 1);   # 4225
}
fn gi_meth(): i64 { var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps; return s.gm(pps); }
fn gi_result(): i64 { var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps; var v = gi_gd(pps); return v.c; }
fn gi_pair(): i64 {
    var s: GiP3; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    var q: GiQ2; var pq: *GiQ2 = &q; var ppq: **GiQ2 = &pq;
    return gi_two(pps, ppq);   # 2416
}
fn gi_local(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    return gi_st(pps) * 100 + gi_tg(pps);   # 2442
}
fn gi_misc(): i64 {
    var s: GiP3; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    return gi_sz(pps) * 10000 + gi_sz(pp: pps) * 100 + gi_fw(pps);   # 242424
}
fn gi_ctl(): i64 {
    var s: GiP3; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    var i: i32 = 5; var pi: *i32 = &i; var ppi: **i32 = &pi;
    return gi_mix(pps, 7) * 10000 + gi_sz(ps) * 100 + gi_sz(ppi);   # 80804
}
fn gi_ctl2(): i64 {
    var s: GiP3; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    var q: GiQ2; var pq: *GiQ2 = &q; var ppq: **GiQ2 = &pq;
    var bq: Bx<GiQ2>;
    return gi_both(&bq, pps) * 10000 + gi_nt(ppq) * 100 + gi_sz(&ps + 0);   # 160808
}
# GW — D22 A / D23 A. Each was the i64 base: 8, or a fault for `take(**pp)`.
fn gi_ps1<T>(p: *T): i64 { var a = p + 1; var b = p; return a - b; }
fn gi_xs<T>(x: T): i64 { return sizeof(T); }
fn gi_wrap(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    return gi_st((pps)) * 1000000 + gi_tg(((pps))) * 10000 + gi_tg((&ps)) * 100 + gi_sz(((&GI_PS)));   # 24424224
}
fn gi_arith(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    return gi_st(pps + 0) * 1000000 + gi_tg(pps - 0) * 10000 + gi_tg(0 + pps) * 100 + gi_sz((pps) + 1 - 1);   # 24424224
}
fn gi_arith2(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps; var w: GiW; w.pp = pps;
    return gi_tg(w.pp + 0) * 1000000 + gi_tg(GI_PPS + 0) * 10000 + gi_tg(gi_mkpp() - 0) * 100 + gi_tg((pps + 0));   # 42424242
}
fn gi_single(): i64 {
    var s: GiP3; var ps: *GiP3 = &s;
    var a: i32[4]; var pa: *i32 = &a;
    return gi_ps1(ps + 1) * 1000000 + gi_ps1(1 + ps) * 10000 + gi_ps1((ps) - 1) * 100 + gi_ps1(pa + 1) * 10 + gi_xs(ps + 1) / 8;   # 24242441
}
fn gi_wmeth(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps;
    return s.gm((pps)) * 10000 + s.gm(pps + 0) * 100 + s.gm1(ps + 1);   # 666666
}
fn gi_kd<T>(x: *T): T { var t: T = *x; return t; }
fn gi_ko<T>(t: T): i64 { var s = GiPk { 1 }; var pk: *GiPk = &s; var r = gi_kd(pk + 0); return r.pick(t); }
fn gi_stub(): i64 { var q = GiQk { 3, 4 }; return gi_ko(q); }   # 5
# GD — D24 A. Each was the i64 base: 8 (81 for the filed repro's 241), or a fault for `take(***ppp)`.
fn gi_s3<T>(ppp: ***T): i64 { var a = **ppp + 1; var b = **ppp; return a - b; }
fn gi_t3<T>(ppp: ***T): i64 { return gi_take(***ppp); }
fn gi_t4<T>(p4: ****T): i64 { return gi_take(****p4); }
fn gi_z3<T>(ppp: ***T): i64 { return sizeof(T); }
fn gi_r3<T>(ppp: ***T): T { return ***ppp; }
fn gi_f3<T>(ppp: ***T): i64 { return gi_t3(ppp); }
var GI_PPPS: ***GiP3 = &GI_PPS;
fn gi_mk3(): ***GiP3 { return GI_PPPS; }
fn gi_deep(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps; var ppps: ***GiP3 = &pps;
    var p4: ****GiP3 = &ppps;
    return gi_s3(ppps) * 1000000 + gi_t3(ppps) * 10000 + gi_t4(p4) * 100 + gi_t4(&ppps);   # 24424242
}
fn gi_deep2(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps; var ppps: ***GiP3 = &pps;
    var w: GiW3; w.ppp = ppps;
    return gi_t3(&pps) * 1000000 + gi_t3(w.ppp) * 10000 + gi_t3(GI_PPPS) * 100 + gi_t3(gi_mk3());   # 42424242
}
fn gi_deep3(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps; var ppps: ***GiP3 = &pps;
    var v = gi_r3(ppps);
    return gi_t3((ppps)) * 1000000 + gi_t3(ppps + 0) * 10000 + gi_f3(ppps) * 100 + v.c;   # 42424242
}
fn gi_deep4(): i64 {
    var s = GiP3 { 1, 2, 42 }; var ps: *GiP3 = &s; var pps: **GiP3 = &ps; var ppps: ***GiP3 = &pps;
    var f = |k| gi_t3(ppps) + k;
    return s.gm3(ppps) * 10000 + fncall1(f, 1) * 100 + gi_z3(ppp: ppps);   # 434324
}
fn gi_dctl(): i64 {
    var s: GiP3; var ps: *GiP3 = &s; var pps: **GiP3 = &ps; var ppps: ***GiP3 = &pps;
    var i: i32[2]; var pi: *i32 = &i; var ppi: **i32 = &pi; var pppi: ***i32 = &ppi;
    return gi_s3<GiP3>(ppps) * 10000 + gi_z3(pppi) * 1000 + gi_z3(pps) * 10 + gi_z3(&ps) / 8;   # 244081
}

assert_eq(dp_filed(), 0, "the filed repro: *(*pp + 1) and second(pp) read the second element (it exited 1)");
assert_eq(r_local(), 4202, "a **i64 local: *pp + 1 / + 2 step elements, *pp + 2 - *pp is 2");
assert_eq(r_bytes(), 8, "untyped copies of *pp + 1 and *pp are 8 bytes apart");
assert_eq(r_diff(), 3, "*qq - *pp of two **i64 is an element count");
assert_eq(r_ppadd(), 9, "pp + 1 keeps the pointee: *(*(pp + 1) + 2)");
assert_eq(r_bind(), 31, "var q: *i64 = *pp; q = *pp;");
assert_eq(r_global(), 45, "a **i64 global: *(*GPP + 1), var q: *i64 = *GPP");
assert_eq(TQ, 5, "a **i64 global at top level");
assert_eq(*(TQ2 + 1), 4, "var TQ2: *i64 = *GPP; at top level");
assert_eq(TQ3, 5, "*GPP += 2 at top level steps two elements");
assert_eq(r_field(), 122, "a **i64 field, through a struct and a *H");
assert_eq(r_ret(), 5, "a : **i64 return: *(*gpp() + 2)");
assert_eq(r_triple(), 4213, "a ***i64: **ppp is a *i64, *ppp a **i64 (steps 8), ***ppp the element");
assert_eq(r_gtriple(), 4, "a ***i64 global");
assert_eq(r_u8(), 2552, "**pp through a **u8 reads one byte; *(*pp8 + 2) steps bytes");
assert_eq(r_u8_store(), 10123, "**pp8 = 9 and **pp8 += 1 write one byte");
assert_eq(r_i32(), 0, "**pp through a **i32: 4 bytes sign-extended, += at 4 bytes");
assert_eq(r_p32(), 23, "a **i32 parameter: *(*pp + 1) steps 4");
assert_eq(r_closure(), 47, "a captured **i64");
assert_eq(r_generic(), 427, "a generic fn's **T at i64 and i32");
assert_eq(r_node(), 24, "a **Node field of Node itself: *n.kids + 1 steps the whole struct");
