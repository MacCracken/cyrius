assert_eq(gi_arith(), 24424224, "GW: pps + 0, pps - 0, 0 + pps and (pps) + 1 - 1 are pps (D23 A; were 8 / a fault)");
assert_eq(gi_arith2(), 42424242, "GW: a field, a global, a : **P3 call plus or minus 0, and (pps + 0) (D23 A)");
