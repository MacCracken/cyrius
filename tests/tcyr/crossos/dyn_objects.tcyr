var GS2: dyn Show = (GPP);

var gp1 = P { 4, 9 };
assert_eq(form_local(), 4998, "§forming `&p` of an inline local: data = &p; slot 0 show, slot 1 default twice");
assert_eq(form_ptr_local(), 49, "§forming a `*P` local: the data word is the pointer");
assert_eq(fq(&gp1), 49, "§forming a `q: *P` parameter");
assert_eq(fv(gp1), 49, "§forming `&q` of a by-value parameter's copy");
assert_eq(form_handle(), 73, "§forming a pointer-mode handle (`var h: P = alloc(16)`)");
assert_eq(form_field(), 49, "§forming a `*P` field `h.pp`");
assert_eq(form_calls(), 124949, "§forming a call returning `*P`, a method returning `*P`, an untyped impl `self`");
assert_eq(form_wrapped(), 49, "§forming a parenthesised source `((&p))`");
assert_eq(form_globals(), 1212, "§forming `&G0` of an inline global and a `*P` global");
assert_eq(dk0(GS), 34, "§forming a global after the first statement");
assert_eq(dk0(GS2), 12, "§forming a global after the first statement from a wrapped `*P` global");

assert_eq(sc_locals(), 42, "§scalars declared i64 / u64 / u8 / i32 / bool locals: the data word is the value");
assert_eq(sc_float(), 60007000, "§scalars declared f64 / f32 locals: the value's bits");
assert_eq(sc_named(), 80029004, "§scalars a declared enum and cstring local");
assert_eq(sc_globals(), 100720088001, "§scalars declared i64 / u64 / enum globals (u64 picks `impl Num for u64`)");
assert_eq(sc_u64(9), 2009, "§scalars a declared u64 parameter picks `impl Num for u64`");
assert_eq(sc_i64(9), 1009, "§scalars a declared i64 parameter");
assert_eq(sc_bool(true), 5001, "§scalars a declared bool parameter");
assert_eq(nested(), 12, "§scalars a `*P` call whose argument forms a `dyn Num` from a declared i64");
assert_eq(sc_lits(), 42, "§scalars the literals 5 / -5 / 2.5 / -2.5 / true / 'A'");

assert_eq(self_forms(), 5090123, "§self `self: *Q8` and `self: Big` (24 B, address-passed) take the data word");

assert_eq(defaults(), 40807, "§defaults slot 0 base, slot 1 T's default instance, slot 2 T's own override");
assert_eq(collision(), 6, "§defaults a collision with an inherent `base`: the slot is `C1_Tw_base`, never `C1_base`");

assert_eq(dk0(Z), 12, "§destinations a declaration-zone global");
assert_eq(dk0(ZH.o), 12, "§destinations a zone struct literal copying a zone dyn");
assert_eq(d_asg(), 344912, "§destinations an assignment (bare, wrapped)");
assert_eq(d_step(), 344949, "§destinations a classic-for step `o = &p`");
assert_eq(d_fields(), 7849123434, "§destinations a field: local, through `*H` (wrapped), zone global");
assert_eq(d_args(), 4934064033, "§destinations an argument (bare, wrapped, the 6th and the 7th)");
assert_eq(d_rets(), 49123449, "§destinations a return (bare, wrapped, in a `defer` fn, forwarded)");
assert_eq(tc_a(&gp1, 3), 49 + 34 + 34, "§destinations TC: a tail-position argument diverts the call");
assert_eq(tc_c(), 12, "§destinations TC: a tail caller with no parameter (its temp in the callee's own slots)");
assert_eq(tc_loop(&gp1, 3), 49, "§destinations TC: the same tail call inside a loop");

var s13 = S13 { 1 };
assert_eq(site_second_in_source(&s13), 14, "§sites filled at every site: the second in source order runs first");
assert_eq(site_first_in_source(&s13), 14, "§sites ... and the first one after it");

assert_eq(records(), 112234312, "§records records holding a dyn, kept in a Vec, `r.o = q` through `*Rec`");

assert_eq(inl_rows(), 20052006, "§inline a declared u64 parameter forms in an auto-inlined and an `#inline` fn");

receivers();
arguments();
results();
assert_eq(known_callee(), 18181818, "§known `fncall1(&mkdk, &p)` / `callptr((&mkdk), &p)` copy the dyn, `fncall1(&mkpk, &p)` forms, an assignment takes it");
assert_eq(lit_wrapped(), 6497849, "§literal `H { 7, (mkdk(&p)), 8 }` and `((mkdk(&p)))`: a wrapped dyn call is the element");
assert_eq(c_ord(), 507002, "§calls C-ORD: the callee and `self` are read before an argument reseats the dyn");
