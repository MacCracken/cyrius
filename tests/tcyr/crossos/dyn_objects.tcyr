  "§pairs a destructure of a `: Result` / `: Option` member, a forming site above the impl, a `: i64` member");

# §toplevel — each call at top level opens the indirect call's micro-frame.
assert_eq(ZK, 7, "§toplevel a declaration-zone global initialised by a call through a dyn");
assert_eq(GS.show(), 34, "§toplevel a call at top level");
assert_eq(TK.a7(1, 2, 3, 4, 5, 6), 91, "§toplevel 7 arguments: the stack arguments inside the micro-frame");
assert_eq(TK.fi(TK.fi(1)), 7, "§toplevel a call through a dyn in another's arguments");
var tlf: f64 = TK.rf() + 1.0;
assert(tlf == 3.5, "§toplevel an f64 result");
TK.fi(0);

var r = assert_summary();
syscall(60, r);
