# enum_ctor_wide_variants.tcyr — 6.6.6: an enum variant constructor with seven or more fields
# must store every field from its own argument.
#
# THE DEFECT (bite 14b). A variant constructor is a synthesized fn whose prologue homes each
# parameter into its own frame slot. Past the int register ceiling (6 on SysV and aarch64) the
# argument is on the caller's stack, and SysV/aarch64 locate it by counting DOWN from the caller's
# int-class TOTAL — which the constructor passed as a literal 0. On x86_64 that addressed the
# constructor's OWN frame, so field 7 held field 5's value and field 8 field 6's
# (`V7(1..7)` -> 1234565, `V8(1..8)` -> 12345656); on aarch64 the negative offset was OR-ed into
# an `ldr` encoding and the constructor died with SIGILL. Win64 was right (its stack formula
# does not read the total). Silent on x86: exit 0, no diagnostic.
#
# ⭐ EVERY EXPECTED VALUE IS A LITERAL — the arguments, distinct two-digit numbers, so a field
# read from a neighbour cannot pass. 6 fields is the control (all in registers everywhere).
include "lib/assert.cyr"

enum E6 { V6(a, b, c, d, e, f); }
enum E7 { V7(a, b, c, d, e, f, g); }
enum E8 { V8(a, b, c, d, e, f, g, h); }
enum E10 { V10(a, b, c, d, e, f, g, h, i, j); }

fn field(e, i): i64 { return load64(e + 8 + i * 8); }

fn main(): i64 {
    alloc_init();

    test_group("6 fields — CONTROL, all in registers");
    var e6 = V6(11, 23, 35, 47, 59, 62);
    assert_eq(field(e6, 0), 11, "V6 a");
    assert_eq(field(e6, 1), 23, "V6 b");
    assert_eq(field(e6, 2), 35, "V6 c");
    assert_eq(field(e6, 3), 47, "V6 d");
    assert_eq(field(e6, 4), 59, "V6 e");
    assert_eq(field(e6, 5), 62, "V6 f");

    test_group("7 fields — the 7th is the first stack argument");
    var e7 = V7(11, 23, 35, 47, 59, 62, 74);
    assert_eq(field(e7, 0), 11, "V7 a");
    assert_eq(field(e7, 4), 59, "V7 e");
    assert_eq(field(e7, 5), 62, "V7 f");
    assert_eq(field(e7, 6), 74, "V7 g (read e's 59 before)");

    test_group("8 fields");
    var e8 = V8(11, 23, 35, 47, 59, 62, 74, 86);
    assert_eq(field(e8, 5), 62, "V8 f");
    assert_eq(field(e8, 6), 74, "V8 g (read e before)");
    assert_eq(field(e8, 7), 86, "V8 h (read f before)");

    test_group("10 fields — four on the stack, in order");
    var e10 = V10(11, 23, 35, 47, 59, 62, 74, 86, 98, 13);
    assert_eq(field(e10, 0), 11, "V10 a");
    assert_eq(field(e10, 1), 23, "V10 b");
    assert_eq(field(e10, 2), 35, "V10 c");
    assert_eq(field(e10, 3), 47, "V10 d");
    assert_eq(field(e10, 4), 59, "V10 e");
    assert_eq(field(e10, 5), 62, "V10 f");
    assert_eq(field(e10, 6), 74, "V10 g");
    assert_eq(field(e10, 7), 86, "V10 h");
    assert_eq(field(e10, 8), 98, "V10 i");
    assert_eq(field(e10, 9), 13, "V10 j");

    test_group("the tag survives");
    assert_eq(load64(e7), load64(V7(0, 0, 0, 0, 0, 0, 0)), "two V7 values carry one tag");

    var r = assert_summary();
    return r;
}
var ec = main();
syscall(60, ec);
