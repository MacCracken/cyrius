# enum_fold_past_1024.tcyr — an enum constant registered past var index 1024 is a compile-time
# constant like any other (6.6.8 bite 1).
#
# THE DEFECT (measured at 6.6.7). The enum-presence flag (util.cyr GVECP/SVECP) was a 1024-slot
# table, a stale copy of a cap the value table had not had since v6.3.0, so a constant whose var
# index was >= 1024 was NOT folded. Three consequences, all but the first silent:
#   * `var buf[ENUM]` was refused ("array size identifier must be an enum constant"), top level
#     and in a fn alike;
#   * the duplicate-symbol warning went quiet (tests/gates/frontend/duplicate_symbol_warning_at_scale.sh);
#   * on BOTH Mach-O targets `syscall(ENUM, ...)` lost its COMPILE-TIME reroute: 228 is
#     rerouted to libSystem's clock on arm64 macOS and composed from gettimeofday on x86 macOS,
#     and past 1024 the raw number went to the XNU kernel instead — a different syscall.
#     PE and aarch64-Linux translate at run time too, so they never showed it.
# Reached by real programs: the folded stdlibs put a program past index 1024 (syscalls + alloc +
# str + fmt + vec + sigil is ~984 vars; + patra is ~1400), and 6.6.7 had to spell lib/sys.cyr's
# `sys_sched_kicks` buffer as a literal to build for agnos at all.
#
# WHY A CROSS-HOST TEST: the syscall rows are what ecb and ach need to PROVE — a 228 through an
# enum declared past the cap must behave exactly like the literal 228 on that host.
# RED on 6.6.7: the array-size lines do not compile, on every target. CHANGELOG [6.6.8]
include "lib/assert.cyr"

# Declared BEFORE the filler: a low var index, the control for the syscall rows.
enum EfLo { EF_CLK_LO = 228; }

# The filler: 1100 enum members, so everything declared after it sits past var index 1024.
