# Declared AFTER the filler — past the old cap.
enum EfHi { EF_GSZ = 3; EF_LSZ = 24; EF_VAL = 19; EF_CLK = 228; }

var ef_gbuf[EF_GSZ];                 # top-level: EF_GSZ i64 slots

fn ef_local_sized(): i64 {
    var lb[EF_LSZ];                  # in a fn: EF_LSZ bytes
    store8(&lb + 23, 7);
    return load8(&lb + 23);
}

store64(&ef_gbuf + 16, 41);
var r1 = assert_eq(load64(&ef_gbuf + 16), 41, "a top-level array sized by an enum past index 1024");
var r2 = assert_eq(ef_local_sized(), 7, "a fn-local array sized by an enum past index 1024");
var r3 = assert_eq(EF_VAL + 3, 22, "an enum constant past index 1024 has its value");

# syscall(228): the literal is the control. On Linux the call returns 0 and fills the timespec;
# on macOS (both archs) the reroute returns nanoseconds in the return register. Whatever the
# host's shape is, the enum spellings must match the literal's. Clock 0 (CLOCK_REALTIME) because
# it is the one id every host agrees on: 1 is MONOTONIC on Linux and not a clock at all to
# macOS's clock_gettime_nsec_np, which returns 0 for it (measured on ecb). Before 6.6.8 the
# enum-past-1024 spelling was a raw `svc`/`syscall` 228 on XNU — SIGSYS, exit 140, on ecb AND ach.
var ef_ts[2];
var ef_lit = syscall(228, 0, &ef_ts);
var ef_lo = syscall(EF_CLK_LO, 0, &ef_ts);
var ef_hi = syscall(EF_CLK, 0, &ef_ts);
var r4 = assert(ef_lit >= 0, "syscall(228) succeeds on this host (the control)");
var r5 = assert(ef_hi >= 0, "syscall(<enum 228 past index 1024>) succeeds");
if (ef_lit == 0) {
    var r6 = assert_eq(ef_hi, 0, "enum-past-1024 228 has the literal's return shape (0)");
    var r7 = assert_eq(ef_lo, 0, "enum-below-1024 228 has the literal's return shape (0)");
    var r8 = assert(load64(&ef_ts) > 0, "the timespec was filled");
} else {
    var r9 = assert(ef_lo > 0, "enum-below-1024 228 returns the clock like the literal");
    var r10 = assert(ef_hi > 0, "enum-past-1024 228 returns the clock like the literal");
}

var r = assert_summary();
