# exp2_atan_bigtrig.tcyr — VR-01: f64_exp2 / f64_atan on aarch64 (ecb
# macOS-arm64 + pi) route through lib/math.cyr's _f64_exp2_polyfill /
# _f64_atan_polyfill (v6.4.25 — closes the last two aarch64 transcendental gaps,
# issues/2026-07-07-aarch64-f64-exp2-atan-hard-error.md); x86 (Linux + cass) keeps
# native x87 f2xm1/fpatan. Also validates the v6.4.25 Payne-Hanek-lite (double-
# double) trig range reduction for large |x| (issues/2026-07-07-aarch64-trig-
# payne-hanek-range-reduction.md). Pre-v6.4.25 f64_exp2/f64_atan hard-errored on
# aarch64, and large-angle sin/cos lost precision on every arch's polyfill path.
# Calling _f64_*_polyfill directly exercises the aarch64 code path on x86 too.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/math.cyr"

alloc_init();

var eps = f64_div(f64_from(1), f64_from(1000000000));   # 1e-9

fn near(a, b) {
    return f64_lt(f64_abs(f64_sub(a, b)), eps);
}

# Reference bit patterns (dev-computed). F64_PI_6/2/4 come from lib/math.cyr;
# π/3 is test-only (not needed by any polyfill), so it stays local here.
var F64_PI_3 = 0x3FF0C152382D7365;   # π/3         → atan(√3)
var SQRT3   = 0x3FFBB67AE8584CAA;   # √3          → atan(√3) = π/3
var TAN30   = 0x3FE279A74590331D;   # 1/√3        → atan(1/√3) = π/6
var ATAN1K  = 0x3FF91DE2C0E658BD;   # atan(1000)  (≈ π/2 but distinct)
var EXP2_35 = 0x4026A09E667F3BCD;   # 2^3.5 = 8√2
# Payne-Hanek large-angle references (libm sin/cos).
var SIN10K  = 0xBFD38F2FA75D9289;   # sin(10000)
var COS10K  = 0xBFEE780E88EC4409;   # cos(10000)
var SIN1M   = 0xBFD6664B2568D867;   # sin(1000000)
var COS1M   = 0x3FEDF9DF9906D32C;   # cos(1000000)

test_group("f64_exp2 known values (arch-dispatched builtin)");
assert(near(f64_exp2(f64_from(0)),  f64_from(1))    == 1, "2^0 = 1");
assert(near(f64_exp2(f64_from(1)),  f64_from(2))    == 1, "2^1 = 2");
assert(near(f64_exp2(f64_from(10)), f64_from(1024)) == 1, "2^10 = 1024");
assert(near(f64_exp2(f64_neg(f64_from(1))), F64_HALF) == 1, "2^-1 = 0.5");
assert(near(f64_exp2(F64_HALF), F64_SQRT2) == 1, "2^0.5 = √2");

test_group("_f64_exp2_polyfill direct (the aarch64 path, on every arch)");
assert(near(_f64_exp2_polyfill(f64_from(3)),  f64_from(8)) == 1, "polyfill 2^3 = 8");
assert(near(_f64_exp2_polyfill(F64_SQRT2), EXP2_35) == 0, "polyfill 2^√2 ≠ 2^3.5 (sanity)");
assert(near(_f64_exp2_polyfill(F64_ONE_HALF), F64_SQRT2) == 0, "polyfill 2^1.5 ≠ √2 (sanity)");

test_group("f64_atan known values (arch-dispatched builtin)");
assert(near(f64_atan(f64_from(0)), f64_from(0)) == 1, "atan 0 = 0");
assert(near(f64_atan(f64_from(1)), F64_PI_4) == 1, "atan 1 = π/4");
assert(near(f64_atan(f64_neg(f64_from(1))), f64_neg(F64_PI_4)) == 1, "atan -1 = -π/4");
assert(near(f64_atan(SQRT3), F64_PI_3) == 1, "atan √3 = π/3");
assert(near(f64_atan(TAN30), F64_PI_6) == 1, "atan 1/√3 = π/6");
assert(near(f64_atan(f64_from(1000)), ATAN1K) == 1, "atan 1000 ≈ 1.5697…");

test_group("_f64_atan_polyfill direct (the aarch64 path, on every arch)");
assert(near(_f64_atan_polyfill(f64_from(1)), F64_PI_4) == 1, "polyfill atan 1 = π/4");
assert(near(_f64_atan_polyfill(SQRT3), F64_PI_3) == 1, "polyfill atan √3 = π/3");
assert(near(_f64_atan_polyfill(f64_neg(SQRT3)), f64_neg(F64_PI_3)) == 1, "polyfill atan -√3 = -π/3");

test_group("Payne-Hanek: large-angle sin/cos (dd reduction, every arch)");
assert(near(_f64_sin_polyfill(f64_from(10000)),   SIN10K) == 1, "sin(10000)  dd");
assert(near(_f64_cos_polyfill(f64_from(10000)),   COS10K) == 1, "cos(10000)  dd");
assert(near(_f64_sin_polyfill(f64_from(1000000)), SIN1M)  == 1, "sin(1e6)    dd");
assert(near(_f64_cos_polyfill(f64_from(1000000)), COS1M)  == 1, "cos(1e6)    dd");

test_group("sin^2 + cos^2 = 1 at large |x| (dd reduction holds the identity)");
var one = f64_from(1);
var t = f64_from(20000);
var i = 0;
while (i < 12) {
    var s = _f64_sin_polyfill(t);
    var c = _f64_cos_polyfill(t);
    var id = f64_add(f64_mul(s, s), f64_mul(c, c));
    assert(near(id, one) == 1, "sin^2+cos^2=1 at large |x|");
    t = f64_add(t, f64_from(77777));
    i = i + 1;
}

var r = assert_summary();
