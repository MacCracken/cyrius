# exp2_atan_bigtrig.tcyr — VR-01: f64_exp2 / f64_atan on aarch64 (ecb
# macOS-arm64 + pi) route through lib/math.cyr's _f64_exp2_polyfill /
# _f64_atan_polyfill (v6.4.25 — closes the last two aarch64 transcendental gaps,
# issues/archived/2026-07-07-aarch64-f64-exp2-atan-hard-error.md); x86 (Linux + cass) keeps
# native x87 f2xm1/fpatan. Also pins large-argument sin/cos, whose reduction is
# fdlibm's Payne-Hanek (__kernel_rem_pio2) since 6.6.9 — the v6.4.25 double-double
# reduction it replaced failed past ~2^50. Every finite row is <= 1 ulp from the
# correctly rounded value (exp2 since 6.6.8; atan and the trig rows since 6.6.9).
# Calling _f64_*_polyfill directly exercises the aarch64 code path on x86 too.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/math.cyr"

alloc_init();

var eps = f64_div(f64_from(1), f64_from(1000000000));   # 1e-9

fn near(a, b) {
    return f64_lt(f64_abs(f64_sub(a, b)), eps);
}

# exp2 (6.6.8), atan and sin/cos (6.6.9) promise <= 1 ulp from the correctly rounded value on
# every target (lib/math.cyr's fdlibm ports), so their rows use that bar. `b` is the correctly
# rounded bit pattern. The 1e-9 `near` above is left only for the sanity and identity rows.
fn ulp1(a, b) {
    var d = a - b;
    if (d < 0) { d = 0 - d; }
    if (d > 1) { return 0; }
    return 1;
}

# Reference bit patterns (dev-computed). F64_PI_6/2/4 come from lib/math.cyr;
# π/3 is test-only (not needed by any polyfill), so it stays local here.
var F64_PI_3 = 0x3FF0C152382D7365;   # π/3         → atan(√3)
var SQRT3   = 0x3FFBB67AE8584CAA;   # √3          → atan(√3) = π/3
var TAN30   = 0x3FE279A74590331D;   # 1/√3        → atan(1/√3) = π/6
var ATAN1K  = 0x3FF91DE2C0E658BD;   # atan(1000)  (≈ π/2 but distinct)
var EXP2_35 = 0x4026A09E667F3BCD;   # 2^3.5 = 8√2
# Large-angle references (Python decimal, correctly rounded).
var SIN10K  = 0xBFD38F2FA75D9289;   # sin(10000)
var COS10K  = 0xBFEE780E88EC4409;   # cos(10000)
var SIN1M   = 0xBFD6664B2568D867;   # sin(1000000)
var COS1M   = 0x3FEDF9DF9906D32C;   # cos(1000000)
var SIN2P54 = 0x3FECB6F75F360B74;   # sin(2^54)
var COS2P56 = 0xBFD04E42257E0F47;   # cos(2^56)
var SIN2P62 = 0xBFE67E57355F0147;   # sin(2^62)

test_group("f64_exp2 known values (arch-dispatched builtin)");
assert(ulp1(f64_exp2(f64_from(0)),  f64_from(1))    == 1, "2^0 = 1");
assert(ulp1(f64_exp2(f64_from(1)),  f64_from(2))    == 1, "2^1 = 2");
assert(ulp1(f64_exp2(f64_from(10)), f64_from(1024)) == 1, "2^10 = 1024");
assert(ulp1(f64_exp2(f64_neg(f64_from(1))), F64_HALF) == 1, "2^-1 = 0.5");
assert(ulp1(f64_exp2(F64_HALF), F64_SQRT2) == 1, "2^0.5 = √2");

test_group("_f64_exp2_polyfill direct (the aarch64 path, on every arch)");
assert(ulp1(_f64_exp2_polyfill(f64_from(3)),  f64_from(8)) == 1, "polyfill 2^3 = 8");
assert(ulp1(_f64_exp2_polyfill(F64_HALF), F64_SQRT2) == 1, "polyfill 2^0.5 = √2");
assert(ulp1(_f64_exp2_polyfill(0x400C000000000000), EXP2_35) == 1, "polyfill 2^3.5 = 8√2");
assert(near(_f64_exp2_polyfill(F64_SQRT2), EXP2_35) == 0, "polyfill 2^√2 ≠ 2^3.5 (sanity)");
assert(near(_f64_exp2_polyfill(F64_ONE_HALF), F64_SQRT2) == 0, "polyfill 2^1.5 ≠ √2 (sanity)");

# atan's rows use the same <= 1 ulp bar (6.6.9: lib/math.cyr's fdlibm s_atan port — the Taylor
# polyfill it replaced read atan(1) 26 ulp off, 52 ulp worst on [-4, 4]). The builtin is x87
# fpatan on x86 and the polyfill on aarch64; both must be within 1 ulp, and the polyfill's bits
# are pinned. atan(±1) is exactly ±π/4 (the double nearest it) on every target.
fn atan_row(x, cr, pin, name) {
    assert(ulp1(f64_atan(x), cr) == 1, name);
    assert(ulp1(_f64_atan_polyfill(x), cr) == 1, name);
    assert_eq(_f64_atan_polyfill(x), pin, name);
    return 0;
}

test_group("atan special values and exact rows (builtin and polyfill)");
assert_eq(f64_atan(F64_ONE), F64_PI_4, "atan(1) = pi/4 exactly");
assert_eq(_f64_atan_polyfill(F64_ONE), F64_PI_4, "polyfill atan(1) = pi/4 exactly (was 26 ulp off)");
assert_eq(f64_atan(0xBFF0000000000000), 0xBFE921FB54442D18, "atan(-1) = -pi/4 exactly");
assert_eq(_f64_atan_polyfill(0xBFF0000000000000), 0xBFE921FB54442D18, "polyfill atan(-1) = -pi/4 exactly");
assert_eq(f64_atan(0), 0, "atan(+0) = +0");
assert_eq(_f64_atan_polyfill(0x8000000000000000), 0x8000000000000000, "polyfill atan(-0) = -0");
assert_eq(f64_atan(0x8000000000000000), 0x8000000000000000, "atan(-0) = -0");
assert_eq(f64_atan(0x7FF0000000000000), F64_PI_2, "atan(+inf) = pi/2");
assert_eq(_f64_atan_polyfill(0x7FF0000000000000), F64_PI_2, "polyfill atan(+inf) = pi/2");
assert_eq(_f64_atan_polyfill(0xFFF0000000000000), 0xBFF921FB54442D18, "polyfill atan(-inf) = -pi/2");
assert_eq(_f64_atan_polyfill(0x0000000000000001), 0x0000000000000001, "polyfill atan(min subnormal) = itself");
assert_eq(_f64_atan_polyfill(0x7FF8000000000000) & 0x7FF8000000000000, 0x7FF8000000000000, "polyfill atan(NaN) = NaN");

test_group("atan finite rows: <= 1 ulp from correctly rounded, polyfill bits pinned");
atan_row(0x3FE0000000000000, 0x3FDDAC670561BB4F, 0x3FDDAC670561BB4F, "atan 0.5");
atan_row(0x3FDC000000000000, 0x3FDA64EEC3CC23FD, 0x3FDA64EEC3CC23FD, "atan 0.4375 (breakpoint)");
atan_row(0x3FE6000000000000, 0x3FE345F01CCE37BB, 0x3FE345F01CCE37BB, "atan 0.6875 (breakpoint)");
atan_row(0x3FF3000000000000, 0x3FEBDE70ED439FE7, 0x3FEBDE70ED439FE7, "atan 1.1875 (breakpoint)");
atan_row(0x4003800000000000, 0x3FF2E75728833A54, 0x3FF2E75728833A54, "atan 2.4375 (breakpoint)");
atan_row(SQRT3, F64_PI_3, F64_PI_3, "atan sqrt3 = pi/3");
atan_row(0xBFFBB67AE8584CAA, 0xBFF0C152382D7365, 0xBFF0C152382D7365, "atan -sqrt3 = -pi/3");
atan_row(TAN30, 0x3FE0C152382D7366, 0x3FE0C152382D7366, "atan 1/sqrt3");
atan_row(0x408F400000000000, ATAN1K, ATAN1K, "atan 1000");
atan_row(0x4202A05F20000000, 0x3FF921FB543D4DE0, 0x3FF921FB543D4DE0, "atan 1e10");
atan_row(0x4410000000000000, 0x3FF921FB54442D18, 0x3FF921FB54442D18, "atan 2^66");
atan_row(0x3E40000000000000, 0x3E40000000000000, 0x3E40000000000000, "atan 2^-27");
atan_row(0x3FB999999999999A, 0x3FB983E282E2CC4D, 0x3FB983E282E2CC4D, "atan 0.1");
atan_row(0xBFECCCCCCCCCCCCD, 0xBFE77338A80603BE, 0xBFE77338A80603BE, "atan -0.9");
atan_row(0xC000000000000000, 0xBFF1B6E192EBBE44, 0xBFF1B6E192EBBE44, "atan -2");
atan_row(0x4024000000000000, 0x3FF789BD2C160054, 0x3FF789BD2C160054, "atan 10");
atan_row(0x7FEFFFFFFFFFFFFF, 0x3FF921FB54442D18, 0x3FF921FB54442D18, "atan DBL_MAX");

# 2,128 arguments, half spread over every binade from 2^-40 up, half on the breakpoint binades
# 2^-8 .. 2^7, random mantissa and sign (xorshift64). When the hash was pinned every result was
# checked within 1 ulp of the correctly rounded value, so any other bit on any target fails.
test_group("atan sweep: 2,128 arguments, polyfill bits identical on every target");
var s = 0xD1B54A32D192ED03;
var ha = 0xCBF29CE484222325;
var far = 0;
var x = 0;
var e = 0;
var d = 0;
var fa = 0;
var j = 0;
while (j < 2128) {
    s = s ^ (s << 13);
    s = s ^ (s >> 7);
    s = s ^ (s << 17);
    e = (j % 1064) - 40;
    if (j % 2 == 0) { e = (j % 16) - 8; }
    x = ((e + 1023) << 52) | (s & 0x000FFFFFFFFFFFFF) | (s & 0x8000000000000000);
    ha = (ha ^ _f64_atan_polyfill(x)) * 0x100000001B3;
    # x87 fpatan and the polyfill are each within 1 ulp of the true value, so never 3 apart.
    # The ulp distance is an INTEGER subtraction of the two bit patterns, so the builtin's
    # result goes through an untyped temp first: since 6.6.10 `f64_atan(x) - ...` is a float
    # subtraction (the builtin's result is a float operand). CHANGELOG [6.6.10]
    fa = f64_atan(x);
    d = fa - _f64_atan_polyfill(x);
    if (d < 0) { d = 0 - d; }
    if (d > 2) { far = far + 1; }
    j = j + 1;
}
assert_eq(ha, 0x0A5B6D5E3138B7A3, "atan sweep hash (every result within 1 ulp when pinned)");
assert_eq(far, 0, "the builtin stays within 2 ulp of the polyfill");

test_group("large-angle sin/cos: <= 1 ulp (the pre-6.6.9 dd reduction failed past ~2^50)");
assert(ulp1(_f64_sin_polyfill(f64_from(10000)),   SIN10K) == 1, "sin(10000)");
assert(ulp1(_f64_cos_polyfill(f64_from(10000)),   COS10K) == 1, "cos(10000)");
assert(ulp1(_f64_sin_polyfill(f64_from(1000000)), SIN1M)  == 1, "sin(1e6)");
assert(ulp1(_f64_cos_polyfill(f64_from(1000000)), COS1M)  == 1, "cos(1e6)");
assert(ulp1(f64_sin(f64_from(1000000)), SIN1M) == 1, "builtin sin(1e6)");
assert(ulp1(_f64_sin_polyfill(0x4310000000000000), 0x3FDFC4F5E3AAEDDB) == 1, "sin(2^50)");
assert(ulp1(_f64_sin_polyfill(0x4350000000000000), SIN2P54) == 1, "sin(2^54) (was 3.9e10 ulp off)");
assert(ulp1(_f64_cos_polyfill(0x4370000000000000), COS2P56) == 1, "cos(2^56) (|cos| was > 1)");
assert(ulp1(_f64_sin_polyfill(0x43D0000000000000), SIN2P62) == 1, "sin(2^62)");
assert(ulp1(_f64_sin_polyfill(0x44F0000000000000), 0xBFEB7727FA80CA37) == 1, "sin(2^80)");

test_group("sin^2 + cos^2 = 1 at large |x|");
var one = f64_from(1);
var t = f64_from(20000);
var i = 0;
while (i < 12) {
    var sn = _f64_sin_polyfill(t);
    var c = _f64_cos_polyfill(t);
    var id = f64_add(f64_mul(sn, sn), f64_mul(c, c));
    assert(near(id, one) == 1, "sin^2+cos^2=1 at large |x|");
    t = f64_add(t, f64_from(77777));
    i = i + 1;
}

var r = assert_summary();
