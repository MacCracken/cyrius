# vr01_f32v4_ctor.tcyr — VR-01: f32v4 construct + splat + lane-extract, CROSS-OS.
# (v6.4.5, SIMD Phase 2.) The f32v4 TYPE, `f32v4_make`/`_splat`, and lane-extract
# (`f32v4_laneN`, value + `&`-routed pointer form) are ARCH-NEUTRAL — they lower to
# store32/load32 + the 128-bit value-form param ABI, NOT to EMIT_F32V_LOOP. So they
# work on aarch64/macOS even though the packed ARITHMETIC (add/sub/mul/fmadd/dot) is
# x86-only until Phase 5 (aarch64 NEON).
#
# This gives the release gate's cross-OS LIBTEST real-hardware coverage of the f32v4
# type + value-form ABI on ecb (macOS) + pi (aarch64) — coverage the regular
# simd_f32v4.tcyr can't provide on ARM (it's XFAIL'd there because its arithmetic
# asserts no-op on the stubs). Verified 7/7 on x86 AND on aarch64 via qemu-aarch64.
#
# Gated on CYRIUS_HAS_VAL_SIMD_PARAMS. This header used to say value-form SIMD was
# "non-PE by design" and that the test SKIPS on cass — both untrue since v6.4.31 (PE)
# and v6.4.32 (cx). It RUNS on cass. The stale wording helped hide the v6.4.81 bug
# where main.cyr's PE/Mach-O CROSS arms lost the predefine: "by design" reads as
# intent, not as a defect.
# f32 bit patterns: 1.0f=0x3F800000, 2.0f=0x40000000, 3.0f=0x40400000, 4.0f=0x40800000.
include "lib/assert.cyr"
include "lib/simd.cyr"
include "lib/syscalls.cyr"

fn main(): i64 {
#ifdef CYRIUS_HAS_VAL_SIMD_PARAMS
    test_group("f32v4 construct + splat + lane-extract (cross-OS, arch-neutral)");
    var v: f32v4 = f32v4_make(0x3F800000, 0x40000000, 0x40400000, 0x40800000);
    assert_eq(f32v4_lane0(&v), 0x3F800000, "f32v4_make lane 0 = 1.0f (ptr extract)");
    assert_eq(f32v4_lane1(&v), 0x40000000, "f32v4_make lane 1 = 2.0f");
    assert_eq(f32v4_lane2(&v), 0x40400000, "f32v4_make lane 2 = 3.0f");
    assert_eq(f32v4_lane3(&v), 0x40800000, "f32v4_make lane 3 = 4.0f");

    var s: f32v4 = f32v4_splat(0x40000000);
    assert_eq(f32v4_lane0(&s), 0x40000000, "f32v4_splat broadcasts lane 0");
    assert_eq(f32v4_lane3(&s), 0x40000000, "f32v4_splat broadcasts lane 3");

    # value-form lane extract — exercises the 128-bit value-form param ABI on ARM/macOS.
    assert_eq(f32v4_lane0(v), 0x3F800000, "f32v4_lane0(value) = 1.0f (value-form param ABI)");

    return assert_summary();
#endif
    return 0;   # PE (no value-form SIMD): skip cleanly — tracked separately.
}
var ec = main();
syscall(60, ec);
