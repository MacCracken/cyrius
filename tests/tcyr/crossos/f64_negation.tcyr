# f64_negation.tcyr — 6.6.8: negating a float flips its SIGN BIT, on every target.
#
# ⛔ THE DEFECT. Unary minus negated a float's IEEE bit pattern AS AN INTEGER. `-1.0` was
# `0 - 0x3FF0000000000000` = 0xC010000000000000 = -4.0; `-1.5` was -3.0, `-0.5` -8.0, `-0.0`
# +0.0, and `-x` on an f64-typed value was the same integer negation. Every target, no
# diagnostic. Separately, x86 `f64_neg` computed `0.0 - x`, which is not negation either:
# 0.0 - (+0) is +0 and a NaN kept its sign, so x86 and aarch64 disagreed bit-for-bit.
# The ecosystem wrote the defect down as rules ("negative float constants go through f64_neg",
# "-0 cannot be produced") instead of it being fixed.
#
# ⭐ WHY BIT PATTERNS. Every row compares exact bits, because the two failure shapes are both
# "a plausible float": -4.0 for -1.0 passes any sign test, and +0 for -0 passes any `==`.
# -0 is distinguished from +0 by its bits and by 1/x (-inf vs +inf).
#
# In crossos/ because the three negation paths are three backends' emitters: x86 `btc`,
# aarch64 FNEG, and the cx `fneg` opcode (cxvm runs it through the host's f64_neg).
include "lib/assert.cyr"
include "lib/syscalls.cyr"
# aarch64 lowers f64_sin/f64_exp to lib/math.cyr polyfills; the cx target has no
# transcendental ops, so the include (and the rows that need it) are compiled off there.
#ifndef CYRIUS_TARGET_CX
include "lib/math.cyr"
#endif

var G_NEG: f64 = -2.5;          # top-level initializer: the runtime-init path, not a local

fn negf(x: f64): f64 { return -x; }
fn negf_untyped_ret(x: f64) { return -x; }
# Untyped params: the XOR is on plain i64 bits, whatever the caller's operands were typed.
fn bits_xor(a, b) { return a ^ b; }

# A bare `if (v)` straight after a negation. x86 skips the `test rax, rax` when the flags
# already describe rax, and `btc` does NOT set ZF — so the branch read the ZF of whatever
# ran before the negation. Each shape is kept as written: the store-forwarded var is what
# lets the branch follow the negation directly.
fn branch_neg_zero_lit() { var taken = 0; var z = -0.0; if (z) { taken = 1; } return taken; }
fn branch_f64_neg_zero() { var taken = 0; var q = f64_neg(0); if (q) { taken = 1; } return taken; }
fn branch_f64_neg_to_zero() {
    var taken = 0; var one = 1; var zero = 0;
    var q = f64_neg((one << 63) | zero);   # the `or` leaves ZF=0; q is +0
    if (q) { taken = 1; }
    return taken;
}

fn main(): i64 {
    test_group("unary minus on float literals");
    var a: f64 = -1.0;
    assert_eq(a, 0xBFF0000000000000, "-1.0 is -1.0 (was 0xC010.. = -4.0)");
    var b: f64 = -1.5;
    assert_eq(b, 0xBFF8000000000000, "-1.5 is -1.5 (was -3.0)");
    var c = -1.5;
    assert_eq(c, 0xBFF8000000000000, "untyped `var c = -1.5` is -1.5");
    var h: f64 = -0.5;
    assert_eq(h, 0xBFE0000000000000, "-0.5 is -0.5 (was -8.0)");
    var nz: f64 = -0.0;
    assert_eq(nz, 0x8000000000000000, "-0.0 is NEGATIVE zero (was +0)");
    var one: f64 = 1.0;
    var inv = f64_div(one, nz);
    assert_eq(inv, 0xFFF0000000000000, "1 / -0.0 is -inf (the sign is real, not just bits)");
    assert_eq(G_NEG, 0xC004000000000000, "top-level `var G: f64 = -2.5` is -2.5");
    var p: f64 = 2.0 * -1.0;
    assert_eq(p, 0xC000000000000000, "2.0 * -1.0 is -2.0 (was -8.0)");
    var q: f64 = 0.0 - 1.5;
    assert_eq(q, 0xBFF8000000000000, "0.0 - 1.5 unchanged: -1.5");

    test_group("unary minus on f64-typed operands");
    var x: f64 = 1.0;
    assert_eq(negf(x), 0xBFF0000000000000, "fn negf(x: f64): f64 { return -x; } of 1.0 is -1.0");
    assert_eq(negf_untyped_ret(x), 0xBFF0000000000000, "-x with an untyped return is -1.0");
    var zero: f64 = 0.0;
    assert_eq(negf(zero), 0x8000000000000000, "-x of +0 is -0");
    assert_eq(negf(nz), 0, "-x of -0 is +0");
    var nx: f64 = -x;
    assert_eq(nx, 0xBFF0000000000000, "var nx: f64 = -x");
    var nnx: f64 = - -x;
    assert_eq(nnx, 0x3FF0000000000000, "- -x is x");
    var three: f64 = 3.0;
    var m: f64 = -three * three;
    assert_eq(m, 0xC022000000000000, "-x * y is an f64 product: -9.0");
    var pm: f64 = -(three + x);
    assert_eq(pm, 0xC010000000000000, "-(x + y) negates the f64 sum: -4.0");
    var fc: f64 = -f64_from(3);
    assert_eq(fc, 0xC008000000000000, "-f64_from(3) is -3.0");
    var nan: f64 = f64_div(zero, zero);
    var nn: f64 = -nan;
    assert_eq(bits_xor(nn, nan), 0x8000000000000000, "-NaN differs from NaN in the sign bit only");

    test_group("unary minus on a float-returning builtin (untyped argument)");
    # The builtins inherit their ARGUMENT's type, and the i64-boxed idiom leaves it untyped,
    # so the operand's type said "integer" and these were integer negations of the bits.
    var u2 = 0x4000000000000000;      # 2.0, untyped
    var u15 = 0x3FF8000000000000;     # 1.5, untyped: 0 - 0x4000.. happens to BE -2.0's
                                      # bits, so a 2.0 result cannot tell the two apart
    # Off on cx: it rejects f64_sin/f64_exp (no libm opcodes).
#ifndef CYRIUS_TARGET_CX
    assert_eq(-f64_exp(0), 0xBFF0000000000000, "-f64_exp(0) is -1.0 (was -4.0)");
    assert_eq(-f64_sin(0), 0x8000000000000000, "-f64_sin(0) is -0 (was +0)");
#endif
    # On every target since 6.6.10: cx's f64_sqrt was an identity stub (cx_float_unary_ops.tcyr).
    assert_eq(-f64_sqrt(u2), 0xBFF6A09E667F3BCD, "-f64_sqrt(untyped 2.0) is -sqrt(2)");
    assert_eq(-f64_add(u2, u2), 0xC010000000000000, "-f64_add(untyped) is -4.0");
    assert_eq(-f64_abs(u15), 0xBFF8000000000000, "-f64_abs(untyped 1.5) is -1.5");
    assert_eq(-f64_neg(u15), 0x3FF8000000000000, "-f64_neg(x) is x");
    assert_eq(-f32_from(u2), 0xC0000000, "-f32_from(untyped 2.0) is -2.0f (bit 31)");
    assert_eq(-f32_to(0x3FC00000), 0xBFF8000000000000, "-f32_to(1.5f) is -1.5");

    test_group("a branch on a negated value tests the value");
    assert_eq(branch_neg_zero_lit(), 1, "if (-0.0) is taken: -0 is nonzero bits");
    assert_eq(branch_f64_neg_zero(), 1, "if (f64_neg(0)) is taken");
    assert_eq(branch_f64_neg_to_zero(), 0, "if (f64_neg(-0)) is not taken: the result is 0");

    test_group("f64_neg is a sign-bit flip");
    assert_eq(f64_neg(0), 0x8000000000000000, "f64_neg(+0) is -0 (x86 gave +0)");
    assert_eq(f64_neg(0x8000000000000000), 0, "f64_neg(-0) is +0");
    assert_eq(f64_neg(0x7FF8000000000000), 0xFFF8000000000000, "f64_neg(NaN) flips the NaN's sign (x86 kept it)");
    assert_eq(f64_neg(0x3FF0000000000000), 0xBFF0000000000000, "f64_neg(1.0) is -1.0");
    assert_eq(f64_neg(0x7FF0000000000000), 0xFFF0000000000000, "f64_neg(+inf) is -inf");

    test_group("f32 unary minus flips bit 31");
    var f: f32 = f32_from(0x3FF8000000000000);
    var nf: f32 = -f;
    assert_eq(nf, 0xBFC00000, "-f on an f32 is -1.5f");
    assert_eq(f32_to(nf), 0xBFF8000000000000, "f32_to(-f) is -1.5");

    test_group("integer unary minus unchanged");
    var i = 7;
    assert_eq(-i, 0 - 7, "-i on an int");
    assert_eq(-5, 0 - 5, "-5 literal");
    assert_eq(-(i + 1), 0 - 8, "-(i + 1)");
    return assert_summary();
}
var rc = main();
syscall(60, rc);
