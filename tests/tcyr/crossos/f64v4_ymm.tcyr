# f64v4_ymm.tcyr — v6.5.24: f64v4 add/sub/mul/div widened to 256-bit ymm
# (vaddpd/vsubpd/vmulpd/vdivpd) behind the simd_has_avx2() runtime gate.
#
# v6.5.38 — extended to fmadd/dot/scale/abs/sqrt, the five ops `.24` left behind on the
# 128-bit kernel (and left UNGATED, unlike its four). Same two-path structure: AVX2 path
# then forced fallback, so both kernels are proven to agree in one run.
#
# ⭐ WHY THIS LIVES IN crossos/ AND NOT simd/. This release put a runtime CPU gate in
# front of arithmetic that EVERY target already used: all eight f64v4 wrappers (4 ops ×
# value/_ptr) now branch on simd_has_avx2() before choosing a kernel. On x86-with-AVX2
# that picks the new ymm emitter; on pre-AVX2 x86 and on EVERY non-x86 target the probe
# returns 0 and the old 128-bit f64v_* path must still be taken. So a mistake in the gate
# does not break an exotic new feature — it breaks all f64v4 arithmetic on ARM, Windows
# and Mach-O. That is precisely the "compiles on five targets is not runs on five
# targets" failure the crossos bucket exists to catch (v6.5.7, seven real defects).
#
# ⚠ WHAT MAKES THIS TEST NON-VACUOUS. On an AVX2 host the ymm path and the SSE path
# return the SAME values, so a value check alone would pass even if the gate never
# selected ymm at all. Two things close that hole:
#   1. `_avx2_cache = 0` forces the fallback and every result is re-asserted, so BOTH
#      kernels are executed and proven to agree lane-for-lane in one run.
#   2. The exact VEX bytes are checked separately and host-CPU-independently by
#      tests/gates/codegen/f64v4_ymm_disasm.sh — that gate, not this file, is what
#      proves ymm is actually emitted.
# ⚠ The cache is only ever forced to 0, NEVER to 1: forcing 1 on a pre-AVX2 x86 host
# would execute VEX and SIGILL. Real detection is restored (= 2) at the end.
#
# Inputs are chosen so every op is EXACT in binary floating point (no rounding, so the
# two kernels must agree bit-for-bit and the expected values are unarguable):
#   a = [10, 20, 30, 40]   b = [2, 4, 5, 8]
#   add [12, 24, 35, 48]   sub [8, 16, 25, 32]   mul [20, 80, 150, 320]   div [5, 5, 6, 5]
# Lanes 2 and 3 are asserted on every op because they are the half a broken 4-lane
# stride would leave untouched — a two-lane-only bug passes if you only check lane 0.
include "lib/assert.cyr"
include "lib/simd.cyr"
include "lib/syscalls.cyr"

fn main(): i64 {
    test_group("f64v4 256-bit ymm arithmetic (AVX2 path or fallback, per host)");
    var a: f64v4 = f64v4_make(f64_from(10), f64_from(20), f64_from(30), f64_from(40));
    var b: f64v4 = f64v4_make(f64_from(2), f64_from(4), f64_from(5), f64_from(8));

    # --- pointer forms ---
    var s: f64v4 = f64v4_add_ptr(&a, &b);
    assert_eq(f64_to(f64v4_lane0_ptr(&s)), 12, "add_ptr lane0 = 10+2 = 12");
    assert_eq(f64_to(f64v4_lane1_ptr(&s)), 24, "add_ptr lane1 = 20+4 = 24");
    assert_eq(f64_to(f64v4_lane2_ptr(&s)), 35, "add_ptr lane2 = 30+5 = 35");
    assert_eq(f64_to(f64v4_lane3_ptr(&s)), 48, "add_ptr lane3 = 40+8 = 48 (4th lane)");
    var d: f64v4 = f64v4_sub_ptr(&a, &b);
    assert_eq(f64_to(f64v4_lane2_ptr(&d)), 25, "sub_ptr lane2 = 30-5 = 25");
    assert_eq(f64_to(f64v4_lane3_ptr(&d)), 32, "sub_ptr lane3 = 40-8 = 32");
    var m: f64v4 = f64v4_mul_ptr(&a, &b);
    assert_eq(f64_to(f64v4_lane2_ptr(&m)), 150, "mul_ptr lane2 = 30*5 = 150");
    assert_eq(f64_to(f64v4_lane3_ptr(&m)), 320, "mul_ptr lane3 = 40*8 = 320");
    var q: f64v4 = f64v4_div_ptr(&a, &b);
    assert_eq(f64_to(f64v4_lane2_ptr(&q)), 6, "div_ptr lane2 = 30/5 = 6");
    assert_eq(f64_to(f64v4_lane3_ptr(&q)), 5, "div_ptr lane3 = 40/8 = 5");

    # --- value forms (same gate; the `&` call idiom is the one the codegen tests use) ---
    var vs: f64v4 = f64v4_add(&a, &b);
    assert_eq(f64_to(f64v4_lane3(&vs)), 48, "add value-form lane3 = 48");
    var vm: f64v4 = f64v4_mul(&a, &b);
    assert_eq(f64_to(f64v4_lane2(&vm)), 150, "mul value-form lane2 = 150");
    var vq: f64v4 = f64v4_div(&a, &b);
    assert_eq(f64_to(f64v4_lane3(&vq)), 5, "div value-form lane3 = 5");
    var vd: f64v4 = f64v4_sub(&a, &b);
    assert_eq(f64_to(f64v4_lane2(&vd)), 25, "sub value-form lane2 = 25");

    # --- v6.5.38: the five ops `.24` left on the 128-bit kernel ---
    # `.24` widened only add/sub/mul/div. fmadd, dot, scale, abs and sqrt kept running the
    # SSE2 loop at rsi += 2 — two iterations for four lanes — and, unlike their four
    # siblings, had NO simd_has_avx2() gate at all. All five (× value and _ptr forms) are
    # now gated onto EMIT_F64V4_{FMADD,DOT,SCALE,UNARY}.
    # Inputs stay exact in binary FP so both kernels must agree bit-for-bit:
    #   c  = [1, 2, 3, 4]        fmadd a*b+c = [21, 82, 153, 324]
    #   dot = 20+80+150+320 = 570        scale a*3 = [30, 60, 90, 120]
    #   neg = [-10, 20, -30, 40] abs = [10, 20, 30, 40]
    #   sq  = [4, 16, 36, 64]    sqrt = [2, 4, 6, 8]
    test_group("f64v4 fmadd/dot/scale/abs/sqrt widened to ymm (v6.5.38)");
    var c: f64v4 = f64v4_make(f64_from(1), f64_from(2), f64_from(3), f64_from(4));
    var neg: f64v4 = f64v4_make(f64_from(0 - 10), f64_from(20), f64_from(0 - 30), f64_from(40));
    var sq: f64v4 = f64v4_make(f64_from(4), f64_from(16), f64_from(36), f64_from(64));

    var fm: f64v4 = f64v4_fmadd_ptr(&a, &b, &c);
    assert_eq(f64_to(f64v4_lane0_ptr(&fm)), 21, "fmadd_ptr lane0 = 10*2+1 = 21");
    assert_eq(f64_to(f64v4_lane2_ptr(&fm)), 153, "fmadd_ptr lane2 = 30*5+3 = 153");
    assert_eq(f64_to(f64v4_lane3_ptr(&fm)), 324, "fmadd_ptr lane3 = 40*8+4 = 324 (4th lane)");
    var fmv: f64v4 = f64v4_fmadd(&a, &b, &c);
    assert_eq(f64_to(f64v4_lane3(&fmv)), 324, "fmadd value-form lane3 = 324");

    # dot folds ACROSS the 128-bit lane boundary (vextractf128 + vaddpd). A naive widening
    # that just reuses haddpd sums within each lane and silently drops lanes 2-3, giving
    # 100 instead of 570 — which is exactly what this number is here to catch.
    assert_eq(f64_to(f64v4_dot_ptr(&a, &b)), 570, "dot_ptr = 20+80+150+320 = 570 (all 4 lanes)");
    assert_eq(f64_to(f64v4_dot(&a, &b)), 570, "dot value-form = 570");

    var sc: f64v4 = f64v4_scale_ptr(&a, f64_from(3));
    assert_eq(f64_to(f64v4_lane0_ptr(&sc)), 30, "scale_ptr lane0 = 10*3 = 30");
    assert_eq(f64_to(f64v4_lane3_ptr(&sc)), 120, "scale_ptr lane3 = 40*3 = 120 (broadcast reached lane 3)");
    var scv: f64v4 = f64v4_scale(&a, f64_from(3));
    assert_eq(f64_to(f64v4_lane2(&scv)), 90, "scale value-form lane2 = 90");

    var ab: f64v4 = f64v4_abs_ptr(&neg);
    assert_eq(f64_to(f64v4_lane0_ptr(&ab)), 10, "abs_ptr lane0 = |-10| = 10");
    assert_eq(f64_to(f64v4_lane2_ptr(&ab)), 30, "abs_ptr lane2 = |-30| = 30 (mask reached upper lane)");
    var abv: f64v4 = f64v4_abs(&neg);
    assert_eq(f64_to(f64v4_lane2(&abv)), 30, "abs value-form lane2 = 30");

    var sr: f64v4 = f64v4_sqrt_ptr(&sq);
    assert_eq(f64_to(f64v4_lane0_ptr(&sr)), 2, "sqrt_ptr lane0 = sqrt(4) = 2");
    assert_eq(f64_to(f64v4_lane3_ptr(&sr)), 8, "sqrt_ptr lane3 = sqrt(64) = 8 (4th lane)");
    var srv: f64v4 = f64v4_sqrt(&sq);
    assert_eq(f64_to(f64v4_lane3(&srv)), 8, "sqrt value-form lane3 = 8");

    # --- v6.5.62 — KERNEL-vs-KERNEL PARITY, DIRECTLY ON THE BUILTINS ---
    #
    # ⛔ THE BLOCK BELOW THIS ONE WENT VACUOUS AT v6.5.62 AND THAT IS WHY THIS EXISTS.
    # It proves parity by setting `_avx2_cache = 0` and re-running the WRAPPERS — which worked
    # only while every wrapper consulted that global. v6.5.62 removed the per-call AVX2 dispatch
    # from add/sub/mul/div/scale/abs/sqrt (it cost ~25 % and bought nothing at a fixed 4 lanes),
    # so those wrappers no longer read `_avx2_cache` at all and the "forced fallback" re-run is
    # now the SAME code path as the first run. It still passes; it just stops proving anything.
    #
    # ⭐ That is the v6.5.36 lesson exactly — a gate that pins the MECHANISM rather than the
    # PROPERTY passes while the mechanism is gone. The property is "the 128-bit and 256-bit
    # kernels agree lane-for-lane", so assert it on the RAW BUILTINS, which no wrapper change
    # can route around. Compared against each other rather than against literals, so the check
    # cannot drift out of sync with the inputs either.
    # ⛔ GUARDED BY CAPABILITY, AND THE FIRST CUT OF THIS BLOCK WAS NOT — it called the ymm
    # builtins unconditionally and the release gate went RED on cass with
    # STATUS_ILLEGAL_INSTRUCTION (0xC000001D). cass is an Intel Celeron J4125 (Goldmont Plus):
    # SSE4.2, NO AVX2. The `_ptr`/value wrappers never expose that because they ask
    # `simd_has_avx2()` first; calling `f64v256_*` DIRECTLY is the one way to execute VEX on a
    # host that cannot decode it. This file's own header already warned — "the cache is only
    # ever forced to 0, NEVER to 1: forcing 1 on a pre-AVX2 x86 host would execute VEX and
    # SIGILL" — and the first cut walked straight into it from the other direction.
    # ⭐ Worth more than the fix: the four-host leg caught in one run what a Linux-only run
    # could not see at all, because the maintainer's dev box has AVX2 and cass does not.
    #
    # So: the 128-bit assertions run EVERYWHERE (that kernel is legal on every x86), and the
    # 256-vs-128 comparison runs only where AVX2 exists. The group is never empty and never
    # silently skipped.
    test_group("f64v4 kernel parity: f64v256_* == f64v_* (raw builtins, wrapper-independent)");
    var k8: f64v4; var k4: f64v4;
    var hasavx2 = simd_has_avx2();
    f64v_add(&k4, &a, &b, 4);
    assert_eq(f64_to(load64(&k4 + 0)), 12, "128-bit kernel add lane0 (runs on every host)");
    assert_eq(f64_to(load64(&k4 + 24)), 48, "128-bit kernel add lane3 (runs on every host)");
    if (hasavx2 == 0) {
        # No AVX2 on this host: only one kernel is legal, so there is nothing to compare.
        assert_eq(hasavx2, 0, "no AVX2 here — 256-vs-128 parity not applicable (honest skip)");
    }
    if (hasavx2 == 1) {
    f64v256_add(&k8, &a, &b, 4); f64v_add(&k4, &a, &b, 4);
    assert_eq(load64(&k8 + 0), load64(&k4 + 0), "add lane0 kernels agree");
    assert_eq(load64(&k8 + 8), load64(&k4 + 8), "add lane1 kernels agree");
    assert_eq(load64(&k8 + 16), load64(&k4 + 16), "add lane2 kernels agree");
    assert_eq(load64(&k8 + 24), load64(&k4 + 24), "add lane3 kernels agree");
    f64v256_sub(&k8, &a, &b, 4); f64v_sub(&k4, &a, &b, 4);
    assert_eq(load64(&k8 + 24), load64(&k4 + 24), "sub lane3 kernels agree");
    f64v256_mul(&k8, &a, &b, 4); f64v_mul(&k4, &a, &b, 4);
    assert_eq(load64(&k8 + 24), load64(&k4 + 24), "mul lane3 kernels agree");
    f64v256_div(&k8, &a, &b, 4); f64v_div(&k4, &a, &b, 4);
    assert_eq(load64(&k8 + 16), load64(&k4 + 16), "div lane2 kernels agree");
    f64v256_scale(&k8, &a, f64_from(3), 4); f64v_scale(&k4, &a, f64_from(3), 4);
    assert_eq(load64(&k8 + 24), load64(&k4 + 24), "scale lane3 kernels agree");
    f64v256_abs(&k8, &neg, 4); f64v_abs(&k4, &neg, 4);
    assert_eq(load64(&k8 + 16), load64(&k4 + 16), "abs lane2 kernels agree");
    f64v256_sqrt(&k8, &sq, 4); f64v_sqrt(&k4, &sq, 4);
    assert_eq(load64(&k8 + 24), load64(&k4 + 24), "sqrt lane3 kernels agree");
    }

    # --- forced 128-bit fallback: both kernels must agree lane-for-lane ---
    # Still meaningful for fmadd and dot, which KEEP a dispatch at v6.5.62 (their two paths are
    # NOT bit-identical — fused vs two roundings, and a different reduction order — so the
    # selection has to stay). For the other ops this re-runs the single remaining path; the
    # kernel-parity block above is what covers them now.
    test_group("f64v4 forced 128-bit fallback parity (simd_has_avx2 = 0)");
    _avx2_cache = 0;
    var s2: f64v4 = f64v4_add_ptr(&a, &b);
    assert_eq(f64_to(f64v4_lane0_ptr(&s2)), 12, "fallback add lane0 = 12");
    assert_eq(f64_to(f64v4_lane2_ptr(&s2)), 35, "fallback add lane2 = 35");
    assert_eq(f64_to(f64v4_lane3_ptr(&s2)), 48, "fallback add lane3 = 48");
    var d2: f64v4 = f64v4_sub_ptr(&a, &b);
    assert_eq(f64_to(f64v4_lane3_ptr(&d2)), 32, "fallback sub lane3 = 32");
    var m2: f64v4 = f64v4_mul_ptr(&a, &b);
    assert_eq(f64_to(f64v4_lane3_ptr(&m2)), 320, "fallback mul lane3 = 320");
    var q2: f64v4 = f64v4_div_ptr(&a, &b);
    assert_eq(f64_to(f64v4_lane2_ptr(&q2)), 6, "fallback div lane2 = 6");
    var vs2: f64v4 = f64v4_add(&a, &b);
    assert_eq(f64_to(f64v4_lane3(&vs2)), 48, "fallback add value-form lane3 = 48");
    # v6.5.38 — the five new ops through the 128-bit kernel: same answers, both paths.
    var fm2: f64v4 = f64v4_fmadd_ptr(&a, &b, &c);
    assert_eq(f64_to(f64v4_lane3_ptr(&fm2)), 324, "fallback fmadd lane3 = 324");
    assert_eq(f64_to(f64v4_dot_ptr(&a, &b)), 570, "fallback dot = 570");
    var sc2: f64v4 = f64v4_scale_ptr(&a, f64_from(3));
    assert_eq(f64_to(f64v4_lane3_ptr(&sc2)), 120, "fallback scale lane3 = 120");
    var ab2: f64v4 = f64v4_abs_ptr(&neg);
    assert_eq(f64_to(f64v4_lane2_ptr(&ab2)), 30, "fallback abs lane2 = 30");
    var sr2: f64v4 = f64v4_sqrt_ptr(&sq);
    assert_eq(f64_to(f64v4_lane3_ptr(&sr2)), 8, "fallback sqrt lane3 = 8");
    _avx2_cache = 2;   # restore real detection

    # --- f64v2 must NOT have been widened: the ymm stride is 4, a 2-lane vector is not ---
    # If someone ever points the f64v2 wrappers at the 256-bit kernel, this reads or
    # writes 16 bytes past a 16-byte vector. Cheap permanent guard against that edit.
    test_group("f64v2 stays on the 128-bit kernel");
    var p: f64v2 = f64v2_make(f64_from(7), f64_from(9));
    var pb: f64v2 = f64v2_make(f64_from(3), f64_from(4));
    var ps: f64v2 = f64v2_add_ptr(&p, &pb);
    # f64v2 has no lane-extractor wrappers (only f64v4/f32v4/f32v8 do) — read the lanes
    # directly, which is what the other f64v2 tests do.
    assert_eq(f64_to(load64(&ps + 0)), 10, "f64v2 add lane0 = 7+3 = 10");
    assert_eq(f64_to(load64(&ps + 8)), 13, "f64v2 add lane1 = 9+4 = 13");

    var r = assert_summary();
    return r;
}
var ec = main();
syscall(60, ec);
