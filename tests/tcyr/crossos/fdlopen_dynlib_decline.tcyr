# fdlopen_dynlib_decline.tcyr — v6.6.4: the two x86_64-Linux-only facilities DECLINE on
# aarch64 by decision, on every entry point, and still work on x86-Linux.
#
# lib/fdlopen.cyr and lib/dynlib.cyr are x86_64-Linux loaders (ld-linux-x86-64.so.2, an x86
# asm trampoline, R_X86_64_* relocations, arch_prctl(ARCH_SET_FS) TLS). Their raw fstat(5) /
# lstat(6) reached aarch64 as setxattr / lsetxattr and failed CLOSED by accident; the raw
# arch_prctl(158) reached it as getgroups(0x1002, buf), which SUCCEEDS and fills the buffer
# with gids. ⚠ Routing 5→80 in ESYSXLAT (this release) ALONE turned dynlib_open from
# fail-closed into fail-OPEN — measured under qemu with an aarch64 ET_DYN: it mmap'd the
# object, walked its relocs against x86 constants and handed back a non-zero handle. The
# declines below are the other half of that patch and must not be separated from the rows.
#
# The x86 arm keeps the facilities honest the other way: a decline that had quietly become
# unconditional would red here on the x86 host (release-gate step 3) before it reached ach.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/mmap.cyr"
include "lib/io.cyr"
include "lib/fdlopen.cyr"
include "lib/dynlib.cyr"
include "lib/assert.cyr"

# v6.6.6: a PER-PROCESS scratch name. This test used fixed /tmp names, shared by every concurrent
# run of the suite (two check.sh at once), so one run deleted or rewrote another's file
# mid-assert. The pid is taken once, so a forked child names the same files. CHANGELOG [6.6.6]
var _scratch_pid = 0;
fn _scratch(name, suffix): i64 {   # "/tmp/<name>.<pid><suffix>", NUL-terminated
    if (_scratch_pid == 0) { _scratch_pid = sys_getpid(); }
    var nl = strlen(name);
    var sl = strlen(suffix);
    var p = alloc(nl + sl + 32);
    memcpy(p, "/tmp/", 5);
    memcpy(p + 5, name, nl);
    var o = 5 + nl;
    store8(p + o, 46);
    o = o + 1;
    var d[24];
    var n = 0;
    var v = _scratch_pid;
    while (n == 0 || v > 0) {
        var q = v / 10;
        store8(&d + n, 48 + v - q * 10);
        n = n + 1;
        v = q;
    }
    while (n > 0) {
        n = n - 1;
        store8(p + o, load8(&d + n));
        o = o + 1;
    }
    memcpy(p + o, suffix, sl);
    store8(p + o + sl, 0);
    return p;
}

# A 1,176-byte aarch64 ET_DYN (`mov x0,#7; ret` exported as tiny_fn), built with
# `aarch64-linux-gnu-ld -shared -z max-page-size=4096 -z norelro --hash-style=sysv -s`
# and embedded so the test needs no cross toolchain on ecb/ach/cass/pi. Written to /tmp.
fn _write_tiny_so(): i64 {
    var path = _scratch("cyr_tiny_aarch64", ".so");
    var blob = "\x7f\x45\x4c\x46\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x03\x00\xb7\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x40\x00\x00\x00\x00\x00\x00\x00\x58\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x40\x00\x38\x00\x03\x00\x40\x00\x09\x00\x08\x00\x01\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x44\x01\x00\x00\x00\x00\x00\x00\x44\x01\x00\x00\x00\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x06\x00\x00\x00\x48\x01\x00\x00\x00\x00\x00\x00\x48\x11\x00\x00\x00\x00\x00\x00\x48\x11\x00\x00\x00\x00\x00\x00\xd0\x00\x00\x00\x00\x00\x00\x00\xd0\x00\x00\x00\x00\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x06\x00\x00\x00\x48\x01\x00\x00\x00\x00\x00\x00\x48\x11\x00\x00\x00\x00\x00\x00\x48\x11\x00\x00\x00\x00\x00\x00\xb0\x00\x00\x00\x00\x00\x00\x00\xb0\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x10\x00\x04\x00\x3c\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x74\x69\x6e\x79\x5f\x66\x6e\x00\x00\x00\x00\xe0\x00\x80\xd2\xc0\x03\x5f\xd6\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\xe8\x00\x00\x00\x00\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x30\x01\x00\x00\x00\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x0a\x00\x00\x00\x00\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x0b\x00\x00\x00\x00\x00\x00\x00\x18\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x48\x11\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x2e\x73\x68\x73\x74\x72\x74\x61\x62\x00\x2e\x68\x61\x73\x68\x00\x2e\x64\x79\x6e\x73\x79\x6d\x00\x2e\x64\x79\x6e\x73\x74\x72\x00\x2e\x74\x65\x78\x74\x00\x2e\x64\x79\x6e\x61\x6d\x69\x63\x00\x2e\x67\x6f\x74\x00\x2e\x67\x6f\x74\x2e\x70\x6c\x74\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x0b\x00\x00\x00\x05\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\xe8\x00\x00\x00\x00\x00\x00\x00\xe8\x00\x00\x00\x00\x00\x00\x00\x14\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x11\x00\x00\x00\x0b\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x30\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x01\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x18\x00\x00\x00\x00\x00\x00\x00\x19\x00\x00\x00\x03\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x00\x30\x01\x00\x00\x00\x00\x00\x00\x30\x01\x00\x00\x00\x00\x00\x00\x09\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x21\x00\x00\x00\x01\x00\x00\x00\x06\x00\x00\x00\x00\x00\x00\x00\x3c\x01\x00\x00\x00\x00\x00\x00\x3c\x01\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x27\x00\x00\x00\x06\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x48\x11\x00\x00\x00\x00\x00\x00\x48\x01\x00\x00\x00\x00\x00\x00\xb0\x00\x00\x00\x00\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x10\x00\x00\x00\x00\x00\x00\x00\x30\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\xf8\x11\x00\x00\x00\x00\x00\x00\xf8\x01\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x35\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x12\x00\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00\x00\x00\x18\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x08\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x18\x02\x00\x00\x00\x00\x00\x00\x3e\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00";
    var fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC, 493);
    if (fd < 0) { return path; }
    sys_write(fd, blob, 1176);
    sys_close(fd);
    return path;
}

fn main(): i64 {
    alloc_init();
    #ifdef CYRIUS_ARCH_AARCH64
    test_group("aarch64: fdlopen / dynlib decline on every entry point");
    # ⚠ Which of these DISCRIMINATE. The regression this file guards is "the 5/6 ESYSXLAT rows
    # present, a decline removed" — not the 6.6.3 tree, whose accidental failures happen to
    # return the same values as a decline. Against that mutant: the two FIXTURE assertions
    # (mmap + dynlib_open on a real aarch64 ET_DYN) go red — without the decline the load now
    # SUCCEEDS (returns 0 / a handle). `fdlopen_helper_available()` is unconditional 0 here
    # (pre-fix it depended on whether $HOME/.cyrius/dlopen-helper existed on the box) and
    # `_fdlopen_verify_trusted()` returns 0 either way (an x86-offset read of the aarch64
    # struct lands on st_uid/st_nlink and never looks like S_IFREG) — both are pinned as
    # CONTRACT (what a consumer may rely on), not as the discriminator.
    assert_eq(fdlopen_helper_available(), 0, "fdlopen_helper_available() == 0 unconditionally (contract)");
    # (was getgroups(4098, tls) → the group COUNT; 0 on a process with no supplementary
    # groups, which the `rc != 0` check read as success = fail-open)
    assert_eq(dynlib_bootstrap_tls(), 0, "dynlib_bootstrap_tls() == 0 (contract)");
    assert_eq(_fdlopen_verify_trusted("/etc/passwd"), 0, "_fdlopen_verify_trusted() == 0 (contract)");
    var info = alloc(256);
    #ifdef CYRIUS_TARGET_LINUX
    # the shape that went fail-open with the ESYSXLAT rows alone: a real aarch64 ET_DYN
    # (the 1,176-byte fixture written by _write_tiny_so below — a system libc.so.6 fails
    # for unrelated reasons under qemu and would pass vacuously). Decline removed + rows
    # present: _fdlopen_mmap_elf maps it and returns 0, dynlib_open hands back a handle.
    var so = _write_tiny_so();
    assert_eq(_fdlopen_mmap_elf(so, info), 0 - 1, "_fdlopen_mmap_elf(<aarch64 ET_DYN>) == -1 (declined; 0 without it)");
    assert_eq(dynlib_open(so), 0, "dynlib_open(<aarch64 ET_DYN>) == 0 — declined, not loaded with x86 relocs");
    xunlink(so);
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    assert_eq(_fdlopen_mmap_elf("/etc/passwd", info), 0 - 1, "_fdlopen_mmap_elf() == -1 (contract, non-Linux)");
    #endif
    #endif
    #ifdef CYRIUS_ARCH_X86
    #ifdef CYRIUS_TARGET_LINUX
    test_group("x86-Linux: the facilities still WORK (a decline gone unconditional would red here)");
    assert_eq(_fdlopen_verify_trusted("/etc/passwd"), 1, "_fdlopen_verify_trusted(/etc/passwd) == 1 (root 0644)");
    var info2 = alloc(256);
    var ld = "/lib64/ld-linux-x86-64.so.2";
    if (file_exists(ld) == 0) { ld = "/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2"; }
    if (file_exists(ld) == 1) {
        assert_eq(_fdlopen_mmap_elf(ld, info2), 0, "_fdlopen_mmap_elf(ld-linux-x86-64.so.2) == 0 (maps)");
    } else {
        assert_eq(1, 1, "no x86 ld.so on this box to map — skipped");
    }
    # the loader-side belt: an object for another machine (e_machine != EM_X86_64) is
    # refused even here — the x86 build used to "load" the aarch64 fixture with every
    # relocation skipped and hand back a handle
    var so2 = _write_tiny_so();
    assert_eq(dynlib_open(so2), 0, "dynlib_open(<aarch64 ET_DYN>) == 0 on x86 — e_machine belt (was: a handle)");
    xunlink(so2);
    #endif
    #ifndef CYRIUS_TARGET_LINUX
    test_group("x86 non-Linux: nothing to assert (fdlopen/dynlib decline on macOS/PE already)");
    assert_eq(1, 1, "skipped");
    #endif
    #endif
    return assert_summary();
}
var ec = main();
syscall(60, ec);
