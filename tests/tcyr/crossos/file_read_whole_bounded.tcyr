# file_read_whole_bounded.tcyr — 6.6.7. file_read_whole CHECKS every allocation, CLAMPS its
# growth to a ceiling, and has bounded (`_max`), allocator-threaded (`_a`) and caller-buffer
# (`_into`) forms.
#
# ⛔ THE DEFECT (kybernet, 2026-09-23). The growth alloc was unchecked and doubled from 64 KiB
# with no ceiling. At 1 GiB the next grow asked for alloc(2^31 + 1) — past ALLOC_MAX, so 0 —
# and the memcpy wrote through NULL: ANY file of 1 GiB or more SIGSEGV'd the reader on every
# box (measured: 2^30 - 1 bytes fine, 2^30 exactly rc 139). A stream that never ends
# (/dev/zero) did the same sooner, an empty file with a failed first alloc stored its NUL at
# address 0, and every call cost 64 KiB of bump heap that is never reclaimed.
#
# ⭐ SIZES ARE CHOSEN AROUND THE GROWTH STEPS: the first buffer is 4096, so a 10,000-byte file
# grows 4096 -> 8192 -> (clamped) 10000 under max 10000. A max of 9,999 must then answer
# -EFBIG — which pins the CLAMP: with plain doubling the buffer overshoots max to 16384 and the
# over-size file is silently returned whole.
#
# Mutations (6.6.7, x86): growth clamp removed -> the max+1 rows FAIL (10001 returned for max
# 10000); the growth alloc check removed -> the fail_after_n_allocs(1) row SIGSEGVs; the
# one-byte probe at cap == max removed -> the max+1 rows FAIL; initial cap back to 65536 ->
# the _a allocation-count row FAILS (1, not 3).
include "lib/io.cyr"
include "lib/assert.cyr"

fn _mkfile(path, n): i64 {
    var b = alloc(n + 1);
    var i = 0;
    while (i < n) { store8(b + i, 65 + (i % 26)); i = i + 1; }
    return file_write_all(path, b, n);
}

# 1 when `buf[0..n)` is the _mkfile pattern and buf[n] is the NUL.
fn _is_pattern(buf, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(buf + i) != 65 + (i % 26)) { return 0; }
        i = i + 1;
    }
    if (load8(buf + n) != 0) { return 0; }
    return 1;
}

fn main(): i64 {
    alloc_init();
    var big = test_scratch("_frw_big");
    var over = test_scratch("_frw_over");
    var empty = test_scratch("_frw_empty");
    assert_eq(_mkfile(big, 10000), 10000, "fixture: 10000-byte file written");
    assert_eq(_mkfile(over, 10001), 10001, "fixture: 10001-byte file written");
    assert_eq(_mkfile(empty, 0), 0, "fixture: empty file written");

    # ── the unbounded form still reads the whole file ──
    var n = 0 - 99;
    var b = file_read_whole(big, &n);
    assert(b != 0, "file_read_whole: buffer returned");
    assert_eq(n, 10000, "file_read_whole: whole length");
    assert_eq(_is_pattern(b, n), 1, "file_read_whole: bytes + NUL terminator");

    # ── an EMPTY file is a valid, NUL-terminated, zero-length buffer ──
    n = 0 - 99;
    b = file_read_whole(empty, &n);
    assert(b != 0, "empty file: a buffer, not a failure");
    assert_eq(n, 0, "empty file: length 0");
    assert_eq(load8(b), 0, "empty file: NUL at [0]");

    # ── exactly max is a success; max + 1 is -EFBIG ──
    n = 0 - 99;
    b = file_read_whole_max(big, 10000, &n);
    assert_eq(n, 10000, "max == size: whole file");
    assert_eq(_is_pattern(b, 10000), 1, "max == size: bytes intact");
    n = 0 - 99;
    b = file_read_whole_max(over, 10000, &n);
    assert_eq(b, 0, "size == max + 1: no buffer");
    assert_eq(n, 0 - 27, "size == max + 1: -EFBIG");
    n = 0 - 99;
    b = file_read_whole_max(big, 9999, &n);
    assert_eq(n, 0 - 27, "size == max + 1 (max 9999, past the 8192 step): -EFBIG");
    n = 0 - 99;
    b = file_read_whole_max(big, 0 - 1, &n);
    assert_eq(n, 0 - 22, "negative max: -EINVAL");
    # the unbounded wrapper keeps its 0 / len 0 contract on EVERY failure
    n = 0 - 99;
    b = file_read_whole("_frw_does_not_exist_667", &n);
    assert_eq(b, 0, "missing file: file_read_whole returns 0");
    assert_eq(n, 0, "missing file: file_read_whole len 0");
    n = 0 - 99;
    b = file_read_whole_max("_frw_does_not_exist_667", 100, &n);
    assert(n < 0, "missing file: file_read_whole_max reports a negative errno");

    # ── _a: a refused allocation is -ENOMEM, never a store through 0 ──
    n = 0 - 99;
    b = file_read_whole_a(fail_after_n_allocs(0), big, 100000, &n);
    assert_eq(b, 0, "first alloc refused: no buffer");
    assert_eq(n, 0 - 12, "first alloc refused: -ENOMEM");
    n = 0 - 99;
    b = file_read_whole_a(fail_after_n_allocs(0), empty, 100000, &n);
    assert_eq(n, 0 - 12, "first alloc refused on an EMPTY file: -ENOMEM (was a NUL stored at 0)");
    n = 0 - 99;
    b = file_read_whole_a(fail_after_n_allocs(1), big, 100000, &n);
    assert_eq(b, 0, "growth alloc refused: no buffer");
    assert_eq(n, 0 - 12, "growth alloc refused: -ENOMEM");
    var ta = fail_after_n_allocs(0 - 1);
    n = 0 - 99;
    b = file_read_whole_a(ta, big, 100000, &n);
    assert_eq(n, 10000, "_a with a working allocator: whole file");
    assert_eq(test_allocator_alloc_count(ta), 3, "_a: 4096 -> 8192 -> 16384 is three allocations");

    # ── _into: the caller's buffer is reused, and grown (clamped) only when needed ──
    var rb[16];
    store64(&rb, 0);
    store64(&rb + 8, 0);
    var r = file_read_whole_into(&rb, big, 12000);
    assert_eq(r, 10000, "_into: first read, whole file");
    assert_eq(load64(&rb + 8), 12000, "_into: grew 4096 -> 8192 -> 12000 (clamped to max)");
    assert_eq(_is_pattern(load64(&rb), 10000), 1, "_into: bytes intact");
    var p0 = load64(&rb);
    var u0 = alloc_used();
    r = file_read_whole_into(&rb, big, 12000);
    assert_eq(r, 10000, "_into: second read, whole file");
    assert_eq(alloc_used() - u0, 0, "_into: a read that fits allocates NOTHING");
    assert_eq(load64(&rb), p0, "_into: same buffer reused");
    r = file_read_whole_into(&rb, over, 10000);
    assert_eq(r, 0 - 27, "_into: over max is -EFBIG");
    assert_eq(load64(&rb), p0, "_into: -EFBIG keeps the caller's buffer");
    r = file_read_whole_into(&rb, empty, 12000);
    assert_eq(r, 0, "_into: empty file, length 0");
    assert_eq(load8(load64(&rb)), 0, "_into: empty file NUL-terminated");

    # ── a stream that never ends is bounded, not a crash ──
    #ifndef CYRIUS_TARGET_WIN
    n = 0 - 99;
    b = file_read_whole_max("/dev/zero", 65536, &n);
    assert_eq(n, 0 - 27, "/dev/zero under max 64 KiB: -EFBIG");
    #endif

    xunlink(big);
    xunlink(over);
    xunlink(empty);
    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
