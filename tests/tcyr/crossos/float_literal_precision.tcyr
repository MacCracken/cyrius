# float_literal_precision.tcyr — a decimal float literal is the CORRECTLY ROUNDED binary64 value
# of its digits, bit for bit, on every backend.
#
# v6.5.28 fixed the first defect here: a literal packed as a 32/32 rational, so
# 3.141592653589793 was 0.061575. 6.6.10 fixed the second: the i64 numerator/denominator pair
# that replaced it overflowed once the digit string reached 2^63 or past 18 FRACTION digits
# (leading zeros count), so `0.0000000000000000001` was negative and `9.999999999999999999` was
# -8.2; and the runtime divide (cvtsi2sd/scvtf + divsd/fdiv) double-rounded once the numerator
# passed 2^53, putting ~3%/24%/21% of 16/17/18-digit literals 1 ulp off — silently, on every
# host. The lexer now does the conversion with integer bignums (round-half-even, subnormals,
# overflow to +inf) and the backends load the bits as one immediate. CHANGELOG [6.6.10]
#
# ⛔ WHY BIT-EXACT. Until 6.6.10 every row here scaled by a power of ten and truncated with
# f64_to, which cannot see a 1-ulp error — the rows passed while 1 in 4 17-digit literals was
# wrong. Each expected value below is the IEEE-754 bit pattern (computed independently, not by
# this compiler); any backend that loads a different double fails the row.
#
# ⛔ WHY crossos/. EMIT_FLOAT_LIT is implemented THREE times — x86 (float.cyr, shared by ELF,
# Mach-O and PE), aarch64 (emit.cyr) and cx (emit.cyr). The release gate runs this directory on
# real ecb / ach / cass / pi.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/assert.cyr"

fn main(): i64 {
    test_group("inside the old 32-bit rational ceiling (v6.5.28 rows, now bit-exact)");
    assert_eq(3.14, 0x40091EB851EB851F, "3.14");
    assert_eq(3.141592, 0x400921FAFC8B007A, "3.141592 (7 sig)");
    assert_eq(3.14159265, 0x400921FB53C8D4F1, "3.14159265 (9 sig)");
    assert_eq(3.1415926535, 0x400921FB54411744, "3.1415926535 (11 sig) -- 0.95822 before v6.5.28");
    assert_eq(3.141592653589793, 0x400921FB54442D18, "3.141592653589793 (16 sig) -- 0.061575 before v6.5.28");
    assert_eq(100.123456789, 0x405907E6B74DCE59, "100.123456789 -- int part > 1 defeats a digit-cap fix");
    assert_eq(0.000001234, 0x3EB4B3FD5942CD96, "0.000001234 (leading fraction zeros)");
    assert_eq(0.1, 0x3FB999999999999A, "0.1");
    assert_eq(0.5, 0x3FE0000000000000, "0.5");
    assert_eq(1.0, 0x3FF0000000000000, "1.0");
    assert_eq(0.0, 0x0000000000000000, "0.0");

    test_group("16-19 significant digits: 1 ulp off under the runtime divide (double rounding)");
    assert_eq(9.080912425089961, 0x4022296D5A7733EF, "16 sig -- was ...33EE");
    assert_eq(5.8527257631892173, 0x40176930F1456AD5, "17 sig -- was ...6AD6");
    assert_eq(7.02950583792446774, 0x401C1E36C743B4E8, "18 sig -- was ...B4E7");
    assert_eq(6.400467850393513403, 0x40199A143E822883, "19 sig, 18 fraction digits -- was ...2882");
    assert_eq(0.9222578791123097, 0x3FED8322F4A8808C, "dhvani tests/simd.tcyr:158 biquad a2 -- was ...808B");

    test_group("past 18 fraction digits or a 2^63 digit string: garbage, often negative");
    assert_eq(3.861192452458940349282, 0x400EE3B8DE56FC48, "22 sig -- was 0x3FF809BBFA686CF6 (1.50)");
    assert_eq(0.0000000000000000001, 0x3BFD83C94FB6D2AC, "1 sig, 19 fraction digits -- was NEGATIVE");
    assert_eq(9.999999999999999999, 0x4024000000000000, "19 nines -- was -8.2");
    assert_eq(0.1000000000000000055511, 0x3FB999999999999A, "0.1 spelled to 22 digits -- was ~2.08");
    assert_eq(9223372036854775807.0, 0x43E0000000000000, "2^63 - 1");
    assert_eq(9223372036854775808.0, 0x43E0000000000000, "2^63 -- the numerator's first overflow");
    assert_eq(9223372036854775808.5, 0x43E0000000000000, "2^63 + 0.5");
    assert_eq(18446744073709551616.0, 0x43F0000000000000, "2^64");
    assert_eq(12345678901234567890.0, 0x43E56A95319D63E1, "20-digit integer part -- was negative");

    test_group("round-half-even, sticky tails, subnormals, overflow");
    assert_eq(1.00000000000000011102230246251565404236316680908203125, 0x3FF0000000000000, "1 + 2^-53 exactly: a tie, stays even (1.0)");
    assert_eq(1.00000000000000011102230246251565404236316680908203126, 0x3FF0000000000001, "1 + 2^-53 + tiny: rounds up");
    assert_eq(1., 0x3FF0000000000001, "1 + 2^-53, 850 zeros, then 1: the tail past the 800-digit cap still breaks the tie UP");
    assert_eq(1.000000000000000166533453693773481063544750213623046875, 0x3FF0000000000001, "1 + 2^-53 + 2^-54 exactly: an exact quotient whose bits below the round bit break the tie UP");
    assert_eq(1.00000000000000033306690738754696212708950042724609375, 0x3FF0000000000002, "1 + 3*2^-53 exactly: a tie, rounds up to even");
    assert_eq(0., 0x0010000000000000, "smallest normal 2^-1022");
    assert_eq(0., 0x000FFFFFFFFFFFFF, "just below 2^-1022: largest subnormal");
    assert_eq(0., 0x0000000000000001, "smallest subnormal 2^-1074");
    assert_eq(0., 0x0000000000000000, "2^-1075 exactly (half the smallest subnormal, 751 digits): a tie, rounds to 0");
    assert_eq(0., 0x0000000000000001, "2^-1075 plus a digit 752 places down: one digit past the tie: rounds UP");
    assert_eq(0., 0x0000000000000000, "1e-324: below half the smallest subnormal, 0");
    assert_eq(.0, 0x7FEFFFFFFFFFFFFF, "DBL_MAX exactly");
    assert_eq(.0, 0x7FF0000000000000, "halfway between DBL_MAX and 2^1024: a tie, overflows to +inf");

    var r = assert_summary();
    return r;
}
var ec = main();
syscall(60, ec);
