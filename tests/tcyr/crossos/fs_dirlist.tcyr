# fs_dirlist.tcyr — VR-01: the directory-listing layer (lib/fs.cyr → fs_win.cyr
# FindFirstFileW/GetFileAttributesW on cass; getdents64 on Linux; getdirentries on
# ecb). Before v6.1.18 dir_list/is_dir were silent no-ops on Windows. Runs on
# Linux + cass + ecb + ach + pi.
#
# ⛔ 6.6.8 — THE FIXTURE IS ITS OWN. This read `tests/win` and `VERSION` relative to the
# working directory, so it passed only when run from the repo root (or a runner bundle that
# happens to carry both): from anywhere else `is_dir on a directory` failed (4/5) on a
# correct fs layer — a verdict about the cwd, not the code. It now creates a directory and a
# file of its own (per-pid names, in the cwd), checks those, and removes them.
# CHANGELOG [6.6.8]
#
# 6.6.11 — a Str is answered for ITS OWN bytes. `str_sub` shares its parent's bytes and leaves no
# NUL at its end, and every arm (the Windows widen, the POSIX stat/open) read the path to a NUL:
# `is_dir` of a 3-byte prefix of "dirA" said 1 and `dir_list_checked` listed dirA. The rows below
# run on every target, unguarded, because the POSIX arms had the same wrong answer. The fixture
# directory ends in "_dir" so its one-byte-shorter prefix names nothing. CHANGELOG [6.6.11]
#
# 6.6.12 — `dir_list_into` (the caller-owned-buffer lister) had NO Windows arm: the POSIX open +
# getdents64 body compiled for PE and answered -1 for every directory, `.` included. Its rows run
# on every target (same -1/-2/-3/-4 contract everywhere). An EMPTY path is refused on every
# target (on Windows "<empty>\*" was the drive root, which dir_list then listed). And on Windows
# GetLastError (0xF04B) is routed — `_dir_list_into_vec` reads it after FindNextFileW returns 0 to
# tell the end (ERROR_NO_MORE_FILES) from a failure part-way, which used to end the listing as if
# it were complete; the Windows rows check the reroute returns the real last error. CHANGELOG [6.6.12]
#
# 6.7.11 — a path that is NOT a directory fails at the open (O_DIRECTORY): with O_RDONLY alone a
# FIFO there blocked dir_list / dir_list_checked / dir_list_into in open(2) until a writer came, so
# the listing never returned (agora's store scan froze its poll server). The FIFO rows run on
# Linux and macOS; the listers run in a forked child the parent waits 5 s for, so a regression
# reads RED here rather than hanging the leg. Linux makes the FIFO with sys_mknodat; Darwin's
# declines (-78), so /usr/bin/mkfifo does there. Windows has no FIFO; agnos opens with AO_DIRECTORY
# already and has no mknodat (-38), so neither runs the group. A regular file is -ENOTDIR
# on every POSIX host now (Darwin's getdirentries answered -22, EINVAL). CHANGELOG [6.7.11]
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/chrono.cyr"
#ifdef CYRIUS_TARGET_MACOS
include "lib/process.cyr"
#endif

# "<stem><pid><tail>", NUL-terminated.
fn _name(stem, tail): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, stem);
    str_builder_add_int(sb, sys_getpid());
    str_builder_add_cstr(sb, tail);
    return str_data(str_builder_build(sb));
}

#ifndef CYRIUS_TARGET_WIN
#ifndef CYRIUS_TARGET_AGNOS
# A FIFO at `path`: mknodat(S_IFIFO|0600) on Linux, /usr/bin/mkfifo on macOS. 0 = made.
fn _mkfifo(path): i64 {
    #ifdef CYRIUS_TARGET_MACOS
    var a = vec_new();
    vec_push(a, "/usr/bin/mkfifo");
    vec_push(a, path);
    return exec_vec(a);
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    return sys_mknodat(AT_FDCWD, path, 4096 | 384, 0);
    #endif
}

# The three listers on `path`, in a forked child. The child exits with bit 0 set unless
# dir_list_into answered -1, bit 1 unless dir_list_checked answered -20 (-ENOTDIR), bit 2 unless
# dir_list returned an empty vec. Returns that code; -1 when the child was still blocked after
# 5 s (killed), -2 no fork, -3 it died.
fn _listers_in_child(path): i64 {
    var pid = sys_fork();
    if (pid < 0) { return 0 - 2; }
    if (pid == 0) {
        var scr[4096];
        var nm[256];
        var ofs: i64[16];
        var code = 0;
        if (dir_list_into(str_from(path), &scr, 4096, &nm, 256, &ofs, 16) != 0 - 1) { code = code | 1; }
        var v = vec_new();
        if (dir_list_checked(str_from(path), v) != 0 - 20) { code = code | 2; }
        var dv = dir_list(str_from(path));
        if (dv == 0 || vec_len(dv) != 0) { code = code | 4; }
        sys_exit(code);
    }
    var st[8];
    store64(&st, 0);
    var waited = 0;
    while (waited < 5000) {
        if (sys_waitpid(pid, &st, 1) == pid) {      # 1 = WNOHANG
            if (WIFEXITED(load32(&st)) == 1) { return WEXITSTATUS(load32(&st)); }
            return 0 - 3;
        }
        sleep_ms(10);
        waited = waited + 10;
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &st, 0);
    return 0 - 1;
}
#endif
#endif

fn main(): i64 {
    alloc_init();
    var dir = _name("cyrius_fsdl_", "_dir");
    var file = _name("cyrius_fsdl_", "_dir/member.txt");
    var leaf = "member.txt";
    assert_eq(xmkdir(dir, 493), 0, "premise: the fixture directory was created");
    assert_eq(file_write_all(file, "x\n", 2), 2, "premise: a file was created inside it");

    test_group("is_dir distinguishes directory / file / missing");
    assert_eq(is_dir(str_from(dir)), 1, "is_dir on a directory returns 1");
    assert_eq(is_dir(str_from(file)), 0, "is_dir on a regular file returns 0");
    assert_eq(is_dir(str_from("no_such_dir_xyz")), 0, "is_dir on a missing path returns 0");

    test_group("dir_list enumerates a directory");
    var v = dir_list(str_from(dir));
    assert_neq(v, 0, "dir_list returned a vec");
    var found = 0;
    var i = 0;
    while (v != 0 && i < vec_len(v)) {
        var e = vec_get(v, i);
        if (str_len(e) == strlen(leaf)) {
            if (memeq(str_data(e), leaf, strlen(leaf)) == 1) { found = 1; }
        }
        i = i + 1;
    }
    assert_eq(found, 1, "dir_list found the file created in it, by name");
    var cv = vec_new();
    assert_eq(dir_list_checked(str_from(dir), cv), 0,
      "dir_list_checked of it is 0 — the enumeration ENDED, it did not fail (6.6.12: GetLastError on PE)");
    assert_eq(vec_len(cv), 1, "and holds its one entry");
    var c = dir_list(str_from("."));
    assert_eq(c != 0 && vec_len(c) > 0, 1, "dir_list found at least one entry in the CWD");

    test_group("a Str is answered for its own bytes, not the bytes after it");
    var full = str_from(dir);
    var pre = str_sub(full, 0, str_len(full) - 1);     # "<...>_di" — shares full's bytes, no NUL
    assert_eq(is_dir(pre), 0, "is_dir of a str_sub prefix naming a MISSING path is 0");
    var pv = vec_new();
    assert_lt(dir_list_checked(pre, pv), 0, "dir_list_checked of that prefix fails");
    assert_eq(vec_len(pv), 0, "and lists nothing (not the fixture's member)");
    var nb[256];
    var dn = strlen(dir);
    memcpy(&nb, dir, dn);
    store8(&nb + dn, 0);                               # "<fixture>\0zz" — to its NUL, the fixture
    store8(&nb + dn + 1, 122);
    store8(&nb + dn + 2, 122);
    var withnul = str_new(&nb, dn + 3);
    assert_eq(is_dir(withnul), 0, "is_dir refuses a path with an embedded NUL");
    var nv = vec_new();
    assert_lt(dir_list_checked(withnul, nv), 0, "dir_list_checked refuses it too");

    test_group("dir_list_into lists into caller buffers, on every target");
    var scr[4096];
    var nm[256];
    var ofs: i64[16];
    assert_eq(dir_list_into(str_from(dir), &scr, 4096, &nm, 256, &ofs, 16), 1,
      "dir_list_into of the fixture: 1 entry");
    assert_eq(streq(&nm + load64(&ofs), leaf), 1, "named member.txt, NUL-terminated at its offset");
    assert_neq(dir_list_into(str_from("."), &scr, 4096, &nm, 256, &ofs, 16), 0 - 1,
      "dir_list_into of the CWD is not -1 (a count, or -3/-4 for a big CWD)");
    assert_eq(dir_list_into(str_from("no_such_dir_xyz"), &scr, 4096, &nm, 256, &ofs, 16), 0 - 1,
      "dir_list_into of a missing path: -1");
    assert_eq(dir_list_into(str_from(dir), &scr, 512, &nm, 256, &ofs, 16), 0 - 2,
      "scratch under 1024: -2");
    assert_eq(dir_list_into(str_from(dir), &scr, 4096, &nm, 5, &ofs, 16), 0 - 3,
      "names buffer too small for member.txt: -3, not a short count");
    assert_eq(dir_list_into(str_from(dir), &scr, 4096, &nm, 256, &ofs, 0), 0 - 4,
      "no room in offs: -4");

    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    test_group("a path that is not a directory fails at the open (O_DIRECTORY, 6.7.11)");
    var fv = vec_new();
    assert_eq(dir_list_checked(str_from(file), fv), 0 - 20,
      "dir_list_checked of a regular file: -20, -ENOTDIR at the open (Darwin's getdirentries said -22)");
    assert_eq(dir_list_into(str_from(file), &scr, 4096, &nm, 256, &ofs, 16), 0 - 1,
      "dir_list_into of a regular file: -1");
    var fifo = _name("cyrius_fsdl_", "_fifo");
    xunlink(fifo);                                     # a killed earlier run cannot poison this one
    assert_eq(_mkfifo(fifo), 0, "premise: a FIFO was made (mknodat on Linux, /usr/bin/mkfifo on macOS)");
    var lc = _listers_in_child(fifo);
    assert_neq(lc, 0 - 1, "the listers RETURN on a FIFO (with O_RDONLY alone open(2) blocked until the 5 s kill)");
    assert_eq(lc, 0, "on the FIFO dir_list_into is -1, dir_list_checked -20 (-ENOTDIR), dir_list an empty vec");
    assert_eq(xunlink(fifo), 0, "the FIFO unlinks");
    #endif
    #endif

    test_group("an EMPTY path names nothing (not the drive root)");
    var ev = vec_new();
    assert_lt(dir_list_checked(str_from(""), ev), 0, "dir_list_checked of an empty path fails");
    assert_eq(vec_len(ev), 0, "and lists nothing");
    assert_eq(is_dir(str_from("")), 0, "is_dir of an empty path is 0");

    #ifdef CYRIUS_TARGET_WIN
    test_group("Windows: GetLastError (0xF04B) reports the real last error");
    assert_eq(is_dir(str_from("no_such_dir_xyz")), 0, "premise: a missing name");
    assert_eq(syscall(0xF04B), 2, "after it: ERROR_FILE_NOT_FOUND (2)");
    assert_eq(is_dir(str_from("no_such_dir_xyz/child")), 0, "premise: a missing parent");
    assert_eq(syscall(0xF04B), 3, "after it: ERROR_PATH_NOT_FOUND (3) — a live value, not a constant");
    #endif

    xunlink(file);
    xrmdir(dir);
    assert_eq(is_dir(str_from(dir)), 0, "the fixture was removed");
    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
