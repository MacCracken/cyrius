# generic_bind_field_method_struct.tcyr — 6.7.17 (the user's D2, 2026-10-22): a struct-typed FIELD and a
# struct-returning METHOD call bind a generic's `x: T` to that struct, as a struct local or a free call does — on every
# receiver head the method arm takes (a name, a field through a pointer, a nested field, a call, a parenthesised value,
# a chain's method), on every call path, through `p: *T` too (a struct value binds there; a `*S` field or method its S),
# and inside a generic (the token scans type `var r = idt(w.p);` as the parser binds it). Through 6.7.16 each ran the
# i64 base: `sz(w.p)` and `sz(b.mp2())` were 8 for a 16-byte P2, and `rdb(w.p)` (`v.b`) was refused "has no i64 (or
# other scalar) instance". A scalar field still binds i64, and through `x: T` no pointer binds (6.7.14's D8).
# Filed: docs/development/issues/2026-10-21-generic-struct-field-or-method-argument-binds-t-i64.md
# The G rows (6.7.17, met beside D2): a struct CARRIER `b: Box<T>` / `b: *Box<T>` given an inline `Box<P2>` field or a
# method returning `Box<P2>` / `*Box<P2>`, on any head, binds T = P2 as a Box<P2> local or a free call does — each was
# refused "a different struct type" against the i64 base (`_gsc_arg`; the token scans' `_tok_sc_arg` likewise).
# The H rows (6.7.17, met beside D2): through `pp: **T` (and deeper) and a `pp: **Box<T>` carrier, a method returning
# `**P2` / `***P2` / `**Box<P2>` and a `**P2` field after a method bind as a free call and a field chain do — the method
# ran the i64 base (`sizeof(T)` 8; `ppb(b.mqq())` refused "has no i64 instance"), the carrier was refused "a different
# struct type" (`_ic_pp_arg`; the token scans' `_tok_pp_arg` likewise).
# The F17 rows (6.7.17, the genr review, beside D2): inside a generic, a struct carrier's T field `b.v` (`b: Box<T>`,
# `v: T`), whole in an argument, is a value of T as a T-typed name is — forwarded into a stub (`rdb(b.v)`, `k.pick(b.v)`,
# `gxb(b.v)`, `gxb(mk1(b.v))`, wrapped, named, through `*Box<T>`), or bound to a generic call's `: U` (`var r =
# idt(b.v); r.b`, a bounded `r.s2()`, a two-slot carrier). D2's instance binds it (`rdb$P2`), but the stub scan read
# only a name: each generic kept its i64 base and was refused at the definition, called or not.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

struct P1 { a; }
struct P2 { a; b; }
struct P3 { a; b; c; }
struct C4 { r: u8; g: u8; b: u8; x: u8; }
struct Box<T> { v: T; n; }
struct G1<T> { v: T; k; }
struct W { p: P2; n; q: *P2; p1: P1; p3: P3; c4: C4; s: Str; bx: Box<P2>; }
struct V { w: W; }
struct O { p: P2; p1: P1; }
struct B { k; }
struct K { n; }
struct HB { k; b: Box<P2>; pb: *Box<P2>; bi: Box<i32>; }
struct HW { h: HB; }
struct WQ { k; qq: **P2; bb: **Box<P2>; }

var GP2: P2 = P2 { 11, 12 };
var GW: O = O { 31, 32, 33 };
var GBX: Box<P2> = Box<P2> { 71, 72, 73 };
var GHH: HB = HB { 0, 1, 2, 6, 0, 4, 5 };
var GI4: i32 = 5;
var GPI4: *i32 = &GI4;
var GPP2: *P2 = &GP2;
var GPPP2: **P2 = &GPP2;
var GPBX: *Box<P2> = &GBX;
var GWQ: WQ = WQ { 0, &GPP2, &GPBX };
var GB0: B = B { 0 };

impl B {
    fn mp2(self): P2 { var q: P2; q.a = 1; q.b = 2; return q; }
    fn mp1(self): P1 { var q: P1; q.a = 21; return q; }
    fn mp3(self): P3 { var q: P3; q.a = 24; q.b = 25; q.c = 26; return q; }
    fn mc4(self): C4 { var q: C4; q.r = 1; q.g = 27; return q; }
    fn ms(self): Str { return str_from("hello"); }
    fn mpp(self): *P2 { return &GP2; }
    fn mw(self, w: *W): *W { return w; }
    fn mwv(self): W { var w: W; w.p.a = 41; w.p.b = 42; return w; }
    fn idv<U>(self, x: U): U { return x; }
    fn mkb(self): Box<P2> { var x: Box<P2>; x.v.b = 9; x.n = 5; return x; }
    fn mpb(self): *Box<P2> { return &GBX; }
    fn mh(self): HB { var h: HB; h.b.v.b = 8; h.b.n = 6; return h; }
    fn mqq(self): **P2 { return &GPP2; }
    fn mqqq(self): ***P2 { return &GPPP2; }
    fn mqi(self): **i32 { return &GPI4; }
    fn mbb2(self): **Box<P2> { return &GPBX; }
    fn mwq(self): WQ { var x: WQ; x.qq = &GPP2; x.bb = &GPBX; return x; }
    fn mwqp(self): *WQ { return &GWQ; }
    fn mqu<U>(self, x: **U): **U { return x; }
}
impl P2 {
    fn me(self): P2 { var q: P2; q.a = self.a + 100; q.b = self.b + 100; return q; }
    fn m2(self): (i64, i64) { return (self.a, self.b); }
}
impl K { fn pick<V>(self, x: V): i64 { return x.b + self.n; } }
impl W { fn szp(self): i64 { return sz(self.p); } }

fn sz<T>(v: T): i64 { return sizeof(T); }
fn psz<T>(p: *T): i64 { return sizeof(T); }
fn rdb<T>(v: T): i64 { return v.b; }
fn rda<T>(v: T): i64 { return v.a; }
fn rdc<T>(v: T): i64 { return v.c; }
fn rdg<T>(v: T): i64 { return v.g; }
fn rdl<T>(v: T): i64 { return v.len; }
fn pdb<T>(p: *T): i64 { return p.b; }
fn pdc<T>(p: *T): i64 { return p.c; }
fn idt<T>(x: T): T { return x; }
fn mkg1<T>(v: T): G1<T> { var g: G1<T>; g.v = v; g.k = sizeof(T); return g; }
fn mkw(): W { var w: W; w.p.a = 51; w.p.b = 52; return w; }
fn mkhb(): HB { var h: HB; h.b.v.b = 7; h.b.n = 4; return h; }
fn gx<T>(b: Box<T>): i64 { return sizeof(T) * 100 + b.n; }
fn gpx<T>(b: *Box<T>): i64 { return sizeof(T) * 100 + b.n; }
fn gvb<T>(b: Box<T>): T { var r: T = b.v; return r; }
fn ppsz<T>(pp: **T): i64 { return sizeof(T); }
fn ppb<T>(pp: **T): i64 { var p: *T = *pp; return p.b; }
fn p3sz<T>(ppp: ***T): i64 { return sizeof(T); }
fn bbsz<T>(pp: **Box<T>): i64 { var x: *Box<T> = *pp; return sizeof(T) * 100 + x.n; }
fn gd2<T>(pp: **T): T { var t: T = **pp; return t; }
fn unb2<T>(pp: **Box<T>): T { var x: *Box<T> = *pp; var r: T = x.v; return r; }
fn two<A, C>(x: A, y: C): i64 { return sizeof(A) * 100 + sizeof(C); }
fn tcw(w: W): i64 { return sz(w.p); }
fn tcm(b: B): i64 { return sz(b.mp2()); }
fn take(p: P2): i64 { return p.a * 100 + p.b; }
fn retp(w: *W): P2 { return idt(w.p); }
fn retm(b: B): P2 { return idt(b.mp2()); }
# Inside a generic: `r` is typed by the token scans as the parser binds `idt(..)`, so the forward of T into the stub
# method `K.pick` makes `o*` a stub (its i64 base is not emitted) and `o*(q)` calls the P2 instance.
fn o1<T>(t: T): i64 { var w: O; w.p.a = 3; w.p.b = 4; var r = idt(w.p); var k = K { r.b }; return k.pick(t); }
fn o2<T>(t: T): i64 { var b = B { 0 }; var r = idt(b.mp2()); var k = K { r.b }; return k.pick(t); }
fn o3<T>(t: T): i64 { var r = idt(GW.p); var k = K { r.b }; return k.pick(t); }
fn o4<T>(t: T): i64 { var b = B { 0 }; var r = gd2(b.mqq()); var k = K { r.b }; return k.pick(t); }
fn o5<T>(t: T): i64 { var b = B { 0 }; var r = unb2(b.mbb2()); var k = K { r.b }; return k.pick(t); }
fn o6<T>(t: T): i64 { var b = B { 0 }; var r = gd2(b.mwq().qq); var k = K { r.b }; return k.pick(t); }
# Inside a generic, a carrier's T field (the F17 rows).
struct Pair<X, Y> { f: X; s: Y; }
trait Sh2 { fn s2(self): i64; }
impl Sh2 for P2 { fn s2(self): i64 { return self.a * 10 + self.b; } }
impl Sh2 for i64 { fn s2(self): i64 { return self + 100; } }
fn gxb<T>(b: Box<T>): i64 { return b.v.b + b.n; }
fn mk1<T>(x: T): Box<T> { var b: Box<T>; b.v = x; b.n = 1; return b; }
fn cf1<T>(b: Box<T>): i64 { return rdb(b.v); }
fn cf2<T>(b: Box<T>): i64 { var k = K { 1 }; return k.pick(b.v); }
fn cf3<T>(b: Box<T>): i64 { var r = idt(b.v); return r.b; }
fn cf4<T>(b: *Box<T>): i64 { return rdb(b.v); }
fn cf5<T>(b: Box<T>): i64 { return rdb((b.v)) * 100 + sz(b.v); }
fn cf6<T>(b: Box<T>): i64 { return rdb(v: b.v); }
fn cf7<T: Sh2>(b: Box<T>): i64 { var r = idt(b.v); return r.s2(); }
fn cf8<A, C: Sh2>(p: Pair<A, C>): i64 { var r = idt(p.s); return r.s2(); }
fn cf9<T>(b: Box<T>): i64 { return gxb(b.v); }
fn cf10<T>(b: Box<T>): i64 { return gxb(mk1(b.v)); }

# The declaration zone: the sweep and the replay bind alike — an 8-byte struct result types the global (a 16-byte one
# is refused there, "call it inside a fn", as `idt(q)` of a struct global is).
var GZ = sz(GW.p);
var GZR = idt(GW.p1);
var GZB = gx(GHH.b);
var GZQ = ppsz(GB0.mqq());
var GZQB = bbsz(GB0.mbb2());

fn run(): i64 {
    var w: W;
    w.p.a = 1; w.p.b = 2; w.n = 9; w.q = &GP2;
    w.p1.a = 5; w.p3.a = 6; w.p3.b = 7; w.p3.c = 8; w.c4.g = 9; w.s = str_from("abcd"); w.bx.n = 3;
    var b = B { 0 };
    var q = b.mp2();
    var v: V; v.w.p.a = 61; v.w.p.b = 62;
    var pw: *W = &w;
    var kk = K { 100 };

    # the filed repros' shapes
    assert_eq(sz(w.p), 16, "F1: sz(w.p), an inline P2 field, binds P2 (8 before)");
    assert_eq(sz(b.mp2()), 16, "F2: sz(b.mp2()), a method returning P2, binds P2 (8 before)");
    assert_eq(sz(q), 16, "F3: sz(q), the method's result through a local (control, unchanged)");
    assert_eq(rdb(w.p), 2, "F4: rdb(w.p) reads v.b (refused 'no i64 instance' before)");
    assert_eq(rdb(b.mp2()), 2, "F4m: rdb(b.mp2())");

    # every receiver head the method arm takes
    assert_eq(sz(v.w.p) * 100 + rdb(v.w.p), 1662, "F5: a nested field v.w.p");
    assert_eq(sz(pw.p) * 100 + rdb(pw.p), 1602, "F6: a field through a pointer pw.p");
    assert_eq(rdb(w.p.me()), 102, "F7: a chain's method w.p.me()");
    assert_eq(rdb(b.mw(&w).p), 2, "F7b: a field after a method b.mw(&w).p");
    assert_eq(rdb(b.mwv().p.me()), 142, "F7c: a method, a field, a method b.mwv().p.me()");
    assert_eq(rdb(mkw().p), 52, "F8a: a call head mkw().p");
    assert_eq(rdb((*pw).p), 2, "F8b: a parenthesised head (*pw).p");
    assert_eq(rdb((w.p)), 2, "F8c: a wrapped chain (w.p)");
    assert_eq(rdb(((b.mp2()))), 2, "F8d: a wrapped method ((b.mp2()))");
    assert_eq(rdb(GW.p), 32, "F8e: a struct global's field GW.p");
    assert_eq(w.szp(), 16, "F8f: an impl's self.p");
    var cl = || { return sz(w.p) * 100 + rdb(w.p); };
    assert_eq(fncall0(cl), 1602, "F8g: a closure's captured w.p");

    # the generic method's own argument, a generic method's `: U` result, an explicit one
    assert_eq(kk.pick(w.p), 102, "F9: a generic method's argument kk.pick(w.p) binds P2, as K_pick(kk, w.p)");
    assert_eq(K_pick(kk, b.mp2()), 102, "F9b: the free spelling K_pick(kk, b.mp2())");
    assert_eq(sz(b.idv(q)), 16, "F9c: a generic method's : U result b.idv(q) at P2");
    assert_eq(rdb(b.idv(w.p)), 2, "F9d: b.idv(w.p): its U binds P2, its result binds P2");
    assert_eq(rdb(b.idv<P2>(q)), 2, "F9e: the explicit b.idv<P2>(q)");

    # every call path
    assert_eq(idt(w.p).b, 2, "F10a: an expression idt(w.p).b");
    var r1 = idt(w.p);
    assert_eq(r1.b, 2, "F10b: a declaration var r1 = idt(w.p);");
    var r2: P2 = idt(b.mp2());
    assert_eq(r2.a * 10 + r2.b, 12, "F10c: an annotated receive var r2: P2 = idt(b.mp2());");
    r2 = idt(v.w.p);
    assert_eq(r2.b, 62, "F10d: an assignment r2 = idt(v.w.p);");
    var o: O;
    o.p = idt(pw.p);
    assert_eq(o.p.b, 2, "F10e: a field store o.p = idt(pw.p);");
    assert_eq(retp(&w).b, 2, "F10f: return idt(w.p); in a fn returning P2");
    assert_eq(retm(b).b, 2, "F10g: return idt(b.mp2());");
    assert_eq(take(idt(w.p)), 102, "F10h: an argument take(idt(w.p))");
    var g = mkg1(b.mp2());
    assert_eq(g.k * 100 + g.v.b, 1602, "F11: mkg1(b.mp2()) is G1<P2>");
    var g2 = mkg1(w.p);
    assert_eq(g2.k * 100 + g2.v.b, 1602, "F11b: mkg1(w.p) is G1<P2>");
    assert_eq(two(w.p, b.mp1()), 1608, "F10i: two type parameters, two(w.p, b.mp1())");
    assert_eq(sz(v: w.p), 16, "F10j: a named argument sz(v: w.p)");
    assert_eq(tcw(w) * 100 + tcm(b), 1616, "F10k: a tail call return sz(w.p); / return sz(b.mp2());");

    # sizes: 8, 24, a packed 4-byte struct, a Str, a generic struct instance
    assert_eq(sz(w.p1) * 100 + rda(w.p1), 805, "F12a: an 8-byte P1 field");
    assert_eq(sz(w.p3) * 100 + rdc(w.p3), 2408, "F12b: a 24-byte P3 field");
    assert_eq(sz(w.c4) * 100 + rdg(w.c4), 409, "F12c: a packed 4-byte C4 field");
    assert_eq(sz(w.s) * 100 + rdl(w.s), 1604, "F12d: a Str field binds Str");
    assert_eq(sz(w.bx), 24, "F12e: a Box<P2> field binds Box<P2>");
    assert_eq(rda(b.mp1()) * 100 + rdc(b.mp3()), 2126, "F12f: 8- and 24-byte method results");
    assert_eq(rdg(b.mc4()) * 100 + rdl(b.ms()), 2705, "F12g: a packed and a Str method result");

    # through `p: *T`: a struct value binds its struct (its address passed), a `*S` field or method S
    assert_eq(psz(w.p) * 100 + pdb(w.p), 1602, "F13a: psz(w.p) / pdb(w.p) through p: *T (refused before)");
    assert_eq(pdc(w.p3), 8, "F13b: pdc(w.p3)");
    assert_eq(psz(b.mpp()) * 100 + pdb(b.mpp()), 1612, "F13c: a : *P2 method b.mpp() (8 before)");
    assert_eq(pdb(b.mp2()), 2, "F13d: a P2 method result through p: *T (refused before)");
    assert_eq(psz(b.mw(&w).q) * 100 + pdb(b.mw(&w).q), 1612, "F13e: a *P2 field after a method");
    assert_eq(pdb(w.q), 12, "F13f: a *P2 field (6.7.14's D8, unchanged)");

    # controls: a scalar field and, through x: T, a pointer bind i64
    assert_eq(sz(w.n), 8, "FK1: a scalar field w.n binds i64");
    assert_eq(sz(w.q), 8, "FK2: a *P2 field through x: T binds no pointer (6.7.14's D8)");
    assert_eq(sz(b.mpp()), 8, "FK3: a : *P2 method through x: T binds no pointer");
    assert_eq(sz(w.p.a), 8, "FK4: a scalar field of a struct field");

    # a method-chain lookahead whose head is a generic call bound by a chain (the destructure's `_mch_open`)
    var da, db = idt(w.p).m2();
    assert_eq(da * 10 + db, 12, "F16a: var da, db = idt(w.p).m2();");
    var dc, dd = idt(b.mp2()).m2();
    assert_eq(dc * 10 + dd, 12, "F16b: var dc, dd = idt(b.mp2()).m2();");
    var de, df = idt(GW.p).me().m2();
    assert_eq(de * 1000 + df, 131132, "F16c: var de, df = idt(GW.p).me().m2();");

    # a struct carrier given a field or a method (met beside D2)
    var h: HB; h.b.v.b = 2; h.b.n = 3; h.pb = &GBX; h.bi.n = 1;
    var hw: HW; hw.h.b.n = 2;
    assert_eq(gx(h.b), 1603, "G1: gx(h.b), an inline Box<P2> field, binds P2 (refused before)");
    assert_eq(gx(b.mkb()), 1605, "G2: gx(b.mkb()), a method returning Box<P2> (refused before)");
    assert_eq(gpx(b.mpb()), 1673, "G3: gpx(b.mpb()), a method returning *Box<P2> (refused before)");
    assert_eq(gpx(h.pb), 1673, "G4: gpx(h.pb), a *Box<P2> field (6.7.8, unchanged)");
    assert_eq(gx(hw.h.b), 1602, "G5: gx(hw.h.b), a nested field");
    assert_eq(gx(mkhb().b), 1604, "G6: gx(mkhb().b), a call head");
    assert_eq(gx(b.mh().b), 1606, "G7: gx(b.mh().b), a field after a method");
    assert_eq(gx(h.bi), 401, "G8: gx(h.bi), a Box<i32> field, calls gx$i32 (sizeof 4)");
    assert_eq(gvb(h.b).b, 2, "G9: gvb(h.b) returns the P2 its T binds");
    assert_eq(gvb(b.mkb()).b, 9, "G10: gvb(b.mkb())");
    var ph: *HB = &h;
    assert_eq(gx(ph.b), 1603, "G11: gx(ph.b), a field through a pointer");
    assert_eq(gpx(h.b), 1603, "G12: gpx(h.b), an inline Box<P2> field into b: *Box<T> (its address passed)");
    assert_eq(GZB, 1606, "G13: the zone: var GZB = gx(GHH.b);");

    # through `pp: **T` and a `pp: **Box<T>` carrier (met beside D2)
    assert_eq(ppsz(b.mqq()), 16, "H1: ppsz(b.mqq()), a method returning **P2, binds P2 (8 before)");
    assert_eq(ppb(b.mqq()), 12, "H2: ppb(b.mqq()) reads p.b (refused 'no i64 instance' before)");
    assert_eq(ppsz(b.mwq().qq), 16, "H3: ppsz(b.mwq().qq), a **P2 field after a method (8 before)");
    assert_eq(ppsz(b.mwqp().qq), 16, "H4: ppsz(b.mwqp().qq), after a *WQ method");
    assert_eq(ppsz((b.mqq())), 16, "H5: ppsz((b.mqq())), wrapped");
    assert_eq(p3sz(b.mqqq()), 16, "H6: p3sz(b.mqqq()), a ***P2 method into ppp: ***T");
    assert_eq(ppsz(b.mqu(&GPP2)), 16, "H7: ppsz(b.mqu(&GPP2)), a generic method's : **U");
    assert_eq(ppsz(b.mqi()), 4, "H8: ppsz(b.mqi()), a **i32 method binds i32 (6.7.15's D11)");
    assert_eq(bbsz(b.mbb2()), 1673, "H9: bbsz(b.mbb2()), a **Box<P2> method into pp: **Box<T> (refused before)");
    assert_eq(bbsz(b.mwq().bb), 1673, "H10: bbsz(b.mwq().bb), a **Box<P2> field after a method (refused before)");
    assert_eq(gd2(b.mqq()).b, 12, "H11: gd2(b.mqq()) returns the P2 its T binds");
    assert_eq(GZQ * 10000 + GZQB, 161673, "H12: the zone: ppsz(GB0.mqq()), bbsz(GB0.mbb2())");
    assert_eq(o4(q) * 10000 + o5(q) * 100 + o6(q), 147414, "H13: in a generic, var r = gd2(b.mqq()); / unb2(b.mbb2()); / gd2(b.mwq().qq); typed");
    assert_eq(ppsz(b.mpp()), 8, "HK1: a : *P2 method into pp: **T binds nothing (as a *P2 call)");
    assert_eq(p3sz(b.mqq()), 8, "HK2: a : **P2 method into ppp: ***T binds nothing (as a **P2 call)");

    # inside a generic, and the declaration zone
    assert_eq(o1(q), 6, "F14a: in a generic, var r = idt(w.p); is typed (the stub forward seen)");
    assert_eq(o2(q), 4, "F14b: in a generic, var r = idt(b.mp2());");
    assert_eq(o3(q), 34, "F14c: in a generic, var r = idt(GW.p);");
    assert_eq(GZ, 16, "F15a: the zone: var GZ = sz(GW.p);");
    assert_eq(GZR.a, 33, "F15b: the zone: var GZR = idt(GW.p1); is a P1");

    # inside a generic, a struct carrier's T field `b.v` (the genr review, beside D2)
    assert_eq(cf1(GBX), 72, "F17a: rdb(b.v), a carrier's T field forwarded into a stub (refused at the definition before)");
    assert_eq(cf2(GBX), 73, "F17b: k.pick(b.v), into a stub method");
    assert_eq(cf3(GBX), 72, "F17c: var r = idt(b.v); r.b");
    assert_eq(cf4(GPBX), 72, "F17d: rdb(b.v) through b: *Box<T>");
    assert_eq(cf5(GBX), 7216, "F17e: rdb((b.v)), wrapped; sz(b.v) binds P2");
    assert_eq(cf6(GBX), 72, "F17f: rdb(v: b.v), a named argument");
    var bi: Box<i64>; bi.v = 4; bi.n = 0;
    assert_eq(cf7(GBX) * 1000 + cf7(bi), 782104, "F17g: a bounded r.s2() on var r = idt(b.v); at P2 and at i64");
    var pr: Pair<i64, P2>; pr.f = 0; pr.s.a = 3; pr.s.b = 4;
    var pi: Pair<i64, i64>; pi.f = 0; pi.s = 6;
    assert_eq(cf8(pr) * 1000 + cf8(pi), 34106, "F17h: var r = idt(p.s); r.s2() through a two-slot carrier's second slot, at P2 and i64");
    var bb: Box<Box<P2>>; bb.v.v.b = 5; bb.v.n = 2;
    assert_eq(cf9(bb) * 100 + cf10(GBX), 773, "F17i: gxb(b.v) and gxb(mk1(b.v)) in a carrier position");
    return 0;
}
