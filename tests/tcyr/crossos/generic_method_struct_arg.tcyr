# generic_method_struct_arg.tcyr — 6.7.11: a generic METHOD call reaches the instance its arguments bind.
#
# ⛔ The method arm (`_field_load_on`) took only an f64 binding (`_mcall_gen`, 6.7.9): a struct one
# called the i64 base — the dead stub when the body uses the type parameter as a struct, so
# `p.pick(q)` returned 0 where the free spelling `P_pick(p, q)` read q.b (the filed repro exited 7, 77
# is right). Now the method infers as the free call does: a struct argument of any size, through a
# pointer receiver, `self.m(..)`, a chain `mk().m(..)`, a named argument, two type parameters, a
# struct carrier (`b: Box<V>`), and a type parameter on `self` (the receiver's struct). A scalar
# binding of a stub is refused naming the fn (the user's decision A, 2026-10-13) — those rows are in
# tests/gates/frontend/generic_method_infer.sh. Filed:
# docs/development/issues/archived/2026-10-10-generic-method-call-runs-i64-base.md
#   S  struct arguments: 8 / 16 / 24 / 40 B, pointer receiver, self.m, chain, named, two params
#   R  results: `var w = p.m(q);`, `: V` returned at a struct (untyped / annotated, 8 and 24 B)
#   B  a bounded `<V: Show>` member and an `impl Tr for P` member
#   C  a struct carrier `Box<V>` (V = Pt, V = i32)      E  `self: V` binds the receiver (8 / 24 B)
#   F  a generic forwarding its T-typed name into a stub generic method (`p.pick(t)`, `self.pick(w)`)
#      is a stub too, as with the free spelling: its i64 base is not emitted, so it compiles and its
#      struct instance reaches the method's (a scalar call of it is refused — the gate's S8); the
#      receiver a single name, a field chain (`h.p`, `x.hp.p`, `x.pp`) or a call result (`mk()`,
#      `mkfh().p`, a `: *P` call, a method call `h.gp()`, a generic's `: P`) — F10-F18, the 6.7.11
#      review
#   K  scalars into a generic method that has an i64 instance are unchanged
#   X  (6.7.14, the user's D7 (a), 2026-10-16) explicit type arguments, as on the free spelling: `p.id<f64>(h)`,
#      `var xa = p.id<f64>(h);` (an f64), a chain `w.v.id<f64>(h)`, struct type arguments of 8 / 16 / 24 B (a
#      receive, an annotation, a return), a bounded member, two type parameters, a `*P` receiver, a statement,
#      `p.pick<T>(t)` in a generic, `p.k<i64>(9)` — it was refused "unknown field 'id'" + "undefined variable"
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

trait Show { fn show(self): i64; }
trait Tr { fn tk(self): i64; fn tp<V>(self, w: V): i64; }

struct P { v; }
struct Q { a; b; c; }
struct R { x; }
struct T2 { x; y; }
struct Big { a; b; c; d; e; }
struct Pt { x; y; }
struct Box<T> { v: T; n; }
struct E3 { a; b; c; }

impl Show for Q { fn show(self): i64 { return self.c * 2; } }
impl Show for i64 { fn show(self): i64 { return self + 100; } }

impl P {
    fn pick<V>(self, w: V): i64 { return w.b; }
    fn first<V>(self, w: V): i64 { return w.x; }
    fn e5<V>(self, w: V): i64 { return w.e; }
    fn two<A, B>(self, a: A, b: B): i64 { return a.x + b.b + self.v; }
    fn inner(self, q: Q): i64 { return self.pick(q) + 100; }
    fn id<V>(self, w: V): V { return w; }
    fn bm<V: Show>(self, v: V): i64 { return v.show() + self.v; }
    fn cm<V>(self, b: Box<V>): i64 { var t: V = b.v; return t.y; }
    fn cn<V>(self, b: Box<V>): i64 { return b.n + self.v; }
    fn me<V>(self: V): i64 { return self.v + 1; }
    fn k<V>(self, v: V): i64 { return v + self.v; }
    fn fwd<V>(self, w: V): i64 { return self.pick(w) + 1; }
    fn fwd2<V>(self: P, w: V): i64 { return self.pick(w) + 2; }
    fn kf<V>(self, w: V): i64 { return self.k(w) + 3; }
}
impl E3 { fn me<V>(self: V): i64 { return self.c + 1; } }
impl Tr for P {
    fn tk(self): i64 { return 1; }
    fn tp<V>(self, w: V): i64 { return w.c; }
}
fn mk(): P { var p = P { 5 }; return p; }
fn o1<T>(p: P, t: T): i64 { return p.pick(t); }
fn o2<T>(p: *P, t: T): i64 { return p.pick(t); }
fn o3<T>(t: T): i64 {
    var x: P;
    x.v = 1;
    return x.pick(t);
}
fn o4<T>(t: T): i64 {
    var x = P { 1 };
    return x.pick(t);
}
fn o5<T>(p: P, t: T): i64 { return p.k(t); }
# A forwarder whose receiver is a field chain or a call result (the 6.7.11 review: the stub scan typed a
# single name only, so these were refused at their own definitions).
struct FH { p: P; n; }
struct FHH { h: FH; hp: *FH; pp: *P; }
fn mkfh(): FH { var h: FH; h.p.v = 5; h.n = 1; return h; }
fn mkfpp(pp: *P): *P { return pp; }
fn of_c<T>(h: FH, t: T): i64 { return h.p.pick(t); }
fn of_k<T>(t: T): i64 { return mk().pick(t); }
fn of_h1<T>(x: FHH, t: T): i64 { return x.h.p.pick(t); }
fn of_h2<T>(x: *FHH, t: T): i64 { return x.hp.p.pick(t); }
fn of_h3<T>(x: FHH, t: T): i64 { return x.pp.pick(t); }
fn of_h4<T>(t: T): i64 { return mkfh().p.pick(t); }
fn of_h5<T>(pp: *P, t: T): i64 { return mkfpp(pp).pick(t); }
impl FH { fn gp(self): P { return self.p; } }
fn mkfg<U>(u: U): P { var p = P { 5 }; return p; }
fn of_m<T>(h: FH, t: T): i64 { return h.gp().pick(t); }
fn of_g<T>(t: T): i64 { return mkfg(t).pick(t); }
fn o6<T>(p: P, t: T): i64 {
    var u: T = t;
    return p.pick(u);
}
fn add1(x: i64): i64 { return x + 1; }
# 6.7.14 (D7 (a)): explicit type arguments on the method spelling.
struct WP { v: P; k; }
fn ox<T>(p: P, t: T): i64 { return p.pick<T>(t); }
fn rx(p: P, t: T2): T2 { return p.id<T2>(t); }
fn rq(p: P, t: Q): Q { return p.id<Q>(t); }
fn run_x(): i64 {
    var p = P { 5 };
    var q = Q { 1, 7, 3 };
    var r = R { 4 };
    var t = T2 { 6, 8 };
    var pp: *P = &p;
    var wp: WP;
    wp.v = p;
    wp.k = 0;
    var h: f64 = 1.5;
    var xa = p.id<f64>(h);
    assert_eq(xa * 2.0 == 3.0, 1, "X1: var xa = p.id<f64>(h); is an f64 (was refused: unknown field 'id')");
    assert_eq(p.id<f64>(h) * 2.0 == 3.0, 1, "X2: p.id<f64>(h) in an expression is an f64");
    var xb = wp.v.id<f64>(h);
    assert_eq(xb * 2.0 == 3.0, 1, "X3: a chain wp.v.id<f64>(h)");
    assert_eq(p.pick<Q>(q), 7, "X4: p.pick<Q>(q), a 24 B struct type argument");
    var xc = p.id<Q>(q);
    assert_eq(xc.c, 3, "X5: var xc = p.id<Q>(q); (24 B)");
    var xd: T2 = p.id<T2>(t);
    assert_eq(xd.y, 8, "X6: var xd: T2 = p.id<T2>(t); (16 B)");
    var xe = p.id<R>(r);
    assert_eq(xe.x, 4, "X7: var xe = p.id<R>(r); (8 B)");
    assert_eq(rx(p, t).y + rq(p, q).c, 11, "X8: return p.id<T2>(t); / return p.id<Q>(t); (16 / 24 B returns)");
    assert_eq(p.bm<Q>(q), 11, "X9: a bounded member, p.bm<Q>(q)");
    assert_eq(p.bm<i64>(2), 107, "X10: the same at i64, p.bm<i64>(2)");
    assert_eq(p.two<R, Q>(r, q), 16, "X11: two type parameters, p.two<R, Q>(r, q)");
    assert_eq(pp.pick<Q>(q), 7, "X12: a *P receiver");
    p.id<f64>(h);
    assert_eq(ox(p, q), 7, "X13: p.pick<T>(t) inside a generic (and a statement p.id<f64>(h); before it)");
    assert_eq(p.k<i64>(9), 14, "X14: p.k<i64>(9), the i64 base");
    return 0;
}

fn run(): i64 {
    var p = P { 5 };
    var q = Q { 1, 7, 3 };
    var r = R { 4 };
    var t = T2 { 6, 8 };
    var g = Big { 1, 2, 3, 4, 9 };
    var pp: *P = &p;
    assert_eq(p.pick(q), 7, "S1: p.pick(q), a 24 B struct (was 0: the dead stub)");
    assert_eq(P_pick(p, q), 7, "S2: the free spelling P_pick(p, q)");
    assert_eq(p.first(r), 4, "S3: an 8 B struct argument");
    assert_eq(p.first(t), 6, "S4: a 16 B struct argument");
    assert_eq(p.e5(g), 9, "S5: a 40 B struct argument");
    assert_eq(pp.pick(q), 7, "S6: a *P receiver");
    assert_eq(p.inner(q), 107, "S7: self.pick(q) inside a method");
    assert_eq(mk().pick(q), 7, "S8: a chain mk().pick(q)");
    assert_eq(p.pick(w: q), 7, "S9: a named argument");
    assert_eq(p.two(r, q), 16, "S10: two type parameters, both structs");
    assert_eq(p.pick(q) * 10 + p.first(r), 74, "S11: two instances in one expression");
    assert_eq(add1(p.pick(q)), 8, "S12: as an argument");
    var w = p.pick(q);
    assert_eq(w, 7, "R1: var w = p.pick(q);");
    var a = p.id(q);
    assert_eq(a.b, 7, "R2: var a = p.id(q); a : V at a 24 B struct");
    var b: Q = p.id(q);
    assert_eq(b.c, 3, "R3: var b: Q = p.id(q);");
    var c = p.id(r);
    assert_eq(c.x, 4, "R4: var c = p.id(r); an 8 B struct result");
    var d: R = p.id(r);
    assert_eq(d.x, 4, "R5: var d: R = p.id(r);");
    assert_eq(p.bm(q), 11, "B1: a bounded <V: Show> member: Q's show through the instance");
    assert_eq(p.bm(2), 107, "B2: the same member at i64");
    assert_eq(p.tp(q), 3, "B3: an impl Tr for P generic member");
    assert_eq(mk().pick(q) * 10 + p.tp(q), 73, "B4: the chain and the trait member together");
    var bx: Box<Pt>;
    bx.v.x = 3;
    bx.v.y = 4;
    bx.n = 8;
    var bi: Box<i32>;
    bi.v = 2;
    bi.n = 9;
    assert_eq(p.cm(bx), 4, "C1: a Box<V> carrier binds V = Pt (was refused: a different struct type)");
    assert_eq(P_cm(p, bx), 4, "C2: its free spelling");
    assert_eq(p.cn(bx), 13, "C3: a carrier into a generic with an i64 base, V = Pt");
    assert_eq(p.cn(bi), 14, "C4: a Box<i32> carrier binds V = i32");
    assert_eq(p.me(), 6, "E1: self: V binds the receiver, an 8 B P (was 0)");
    var e3 = E3 { 1, 2, 3 };
    assert_eq(e3.me(), 4, "E2: self: V, a 24 B receiver (was 0)");
    assert_eq(P_me(p), 6, "E3: the free spelling P_me(p)");
    assert_eq(p.fwd(q), 8, "F1: a generic method forwarding to one: self.pick(w) (was refused / 0)");
    assert_eq(p.fwd2(q), 9, "F2: ... through a `self: P`");
    assert_eq(o1(p, q), 7, "F3: a generic fn forwarding: p.pick(t), p: P");
    assert_eq(o2(&p, q), 7, "F4: ... p: *P");
    assert_eq(o3(q), 7, "F5: ... a `var x: P` local");
    assert_eq(o4(q), 7, "F6: ... a `var x = P { .. }` local");
    assert_eq(o6(p, q), 7, "F7: ... a `var u: T` local forwarded");
    assert_eq(o5(p, 2), 7, "F8: forwarding into a method with an i64 base, at i64");
    assert_eq(p.kf(4), 12, "F9: self.k(w) at i64");
    var fh = mkfh();
    var fp2 = P { 5 };
    var fx: FHH;
    fx.h = fh;
    fx.hp = &fh;
    fx.pp = &fp2;
    assert_eq(of_c(fh, q), 7, "F10: a field-chain receiver, h.p.pick(t) (was refused at its definition)");
    assert_eq(of_k(q), 7, "F11: a call-result receiver, mk().pick(t)");
    assert_eq(of_h1(fx, q), 7, "F12: two hops, x.h.p.pick(t)");
    assert_eq(of_h2(&fx, q), 7, "F13: through a `*FH` field, x.hp.p.pick(t)");
    assert_eq(of_h3(fx, q), 7, "F14: a `*P` field, x.pp.pick(t)");
    assert_eq(of_h4(q), 7, "F15: a call result's field, mkfh().p.pick(t)");
    assert_eq(of_h5(&fp2, q), 7, "F16: a `: *P` call result, mkfpp(pp).pick(t)");
    assert_eq(of_m(fh, q), 7, "F17: a method call's result, h.gp().pick(t)");
    assert_eq(of_g(q), 7, "F18: a generic's `: P` result, mkfg(t).pick(t)");
    assert_eq(p.k(9), 14, "K1: a scalar into a generic method with an i64 base");
    var kv = p.k(20);
    assert_eq(kv, 25, "K2: var kv = p.k(20);");
    assert_eq(p.id(4), 4, "K3: p.id(4), the i64 base");
    return 0;
}
var r0 = run();
var r1 = run_x();
var rr = assert_summary();
syscall(60, rr);
