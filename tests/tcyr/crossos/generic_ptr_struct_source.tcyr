    return take8(*gpv(G8));
}
fn a4_v_8(): i64 {
    var a = mk8(9);
    var c: S8 = a - *gpv(G8);
    return rd8(c);
}
fn a5_v_8(): i64 {
    var a = mk8(1);
    var c: S8 = *gpv(G8) + a;
    return rd8(c);
}
fn a6_v_8(): i64 {
    return gpv(G8).v;
}
fn a7_v_8(): i64 {
    var pq: *S8 = gpv(G8);
    var l: S8 = pq;
    poke();
    var r = rd8(l);
    unpoke();
    return r;
}
