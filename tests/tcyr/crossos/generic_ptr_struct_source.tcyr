# S8: o.s = gpg<S>(), l = *gpg<S>(), o.s = *gpg<S>(), l = (gpg<S>()), l = gpg<S>() + 0, l = gp2<S, i64>(3),
# l = (*gpg<S>()); a guard field after `s` kept
fn b_8(): i64 {
    var o1: O8; var o2: O8;
    o1.g = 9; o2.g = 9;
    o1.s = gpg<S8>();
    o2.s = *gpg<S8>();
    var l1 = mk8(1); var l2 = mk8(1); var l3 = mk8(1); var l4 = mk8(1); var l5 = mk8(1);
    l1 = *gpg<S8>();
    l2 = (gpg<S8>());
    l3 = gpg<S8>() + 0;
    l4 = gp2<S8, i64>(3);
    l5 = (*gpg<S8>());
    poke();
    var k = 0;
    if (rd8(o1.s) == 58) { k = k + 1; }
    if (rd8(o2.s) == 58) { k = k + 2; }
    if (rd8(l1) == 58) { k = k + 4; }
    if (rd8(l2) == 58) { k = k + 8; }
    if (rd8(l3) == 58) { k = k + 16; }
    if (rd8(l4) == 58) { k = k + 32; }
    if (rd8(l5) == 58) { k = k + 64; }
    if (o1.g + o2.g == 18) { k = k + 128; }
    unpoke();
    return k;
}
# S16: o.s = gpg<S>(), l = *gpg<S>(), o.s = *gpg<S>(), l = (gpg<S>()), l = gpg<S>() + 0, l = gp2<S, i64>(3),
# l = (*gpg<S>()); a guard field after `s` kept
fn b_16(): i64 {
    var o1: O16; var o2: O16;
    o1.g = 9; o2.g = 9;
    o1.s = gpg<S16>();
    o2.s = *gpg<S16>();
    var l1 = mk16(1); var l2 = mk16(1); var l3 = mk16(1); var l4 = mk16(1); var l5 = mk16(1);
    l1 = *gpg<S16>();
    l2 = (gpg<S16>());
    l3 = gpg<S16>() + 0;
    l4 = gp2<S16, i64>(3);
    l5 = (*gpg<S16>());
    poke();
    var k = 0;
    if (rd16(o1.s) == 58) { k = k + 1; }
    if (rd16(o2.s) == 58) { k = k + 2; }
    if (rd16(l1) == 58) { k = k + 4; }
    if (rd16(l2) == 58) { k = k + 8; }
    if (rd16(l3) == 58) { k = k + 16; }
    if (rd16(l4) == 58) { k = k + 32; }
    if (rd16(l5) == 58) { k = k + 64; }
    if (o1.g + o2.g == 18) { k = k + 128; }
    unpoke();
    return k;
}
# S24: o.s = gpg<S>(), l = *gpg<S>(), o.s = *gpg<S>(), l = (gpg<S>()), l = gpg<S>() + 0, l = gp2<S, i64>(3),
# l = (*gpg<S>()); a guard field after `s` kept
fn b_24(): i64 {
    var o1: O24; var o2: O24;
    o1.g = 9; o2.g = 9;
    o1.s = gpg<S24>();
    o2.s = *gpg<S24>();
    var l1 = mk24(1); var l2 = mk24(1); var l3 = mk24(1); var l4 = mk24(1); var l5 = mk24(1);
    l1 = *gpg<S24>();
    l2 = (gpg<S24>());
    l3 = gpg<S24>() + 0;
    l4 = gp2<S24, i64>(3);
    l5 = (*gpg<S24>());
    poke();
    var k = 0;
    if (rd24(o1.s) == 583) { k = k + 1; }
    if (rd24(o2.s) == 583) { k = k + 2; }
    if (rd24(l1) == 583) { k = k + 4; }
    if (rd24(l2) == 583) { k = k + 8; }
    if (rd24(l3) == 583) { k = k + 16; }
    if (rd24(l4) == 583) { k = k + 32; }
    if (rd24(l5) == 583) { k = k + 64; }
    if (o1.g + o2.g == 18) { k = k + 128; }
    unpoke();
    return k;
}
# from inside a generic instance: `gpg<T>()` with T bound to the struct
fn outer<T>(): i64 {
    var l: T;
    l = gpg<T>();
    poke();
    var q: T = *gpg<T>();
    var r = l.v * 10 + q.v;
    unpoke();
    return r;
}
# ── top level: a declaration-zone `var Z: S = *gpg<S>();`, then statements ──
var Z16: S16 = *gpg<S16>();
var Z24: S24 = *gpg<S24>();
var T16 = S16 { 1, 1 };
var T24 = S24 { 1, 1, 1 };
var TO = O24 { 9, 0, 0, 0, 9 };
T16 = gpg<S16>();
T24 = *gpg<S24>();
TO.s = gpg<S24>();
var TV = gpg<S16>().w * 10 + gpg<S24>().x;
poke();
var TZ = rd16(Z16) * 1000 + rd24(Z24);
var TT = rd16(T16) * 1000 + rd24(T24);
var TS = rd24(TO.s) + (TO.g == 9) * 1000;
unpoke();

assert_eq(a1_e_8(), 58, "l = F copies the struct (explicit gpg<S>(), 8 B)");
assert_eq(a2_e_8(), 58, "var q: S = *F copies (explicit gpg<S>(), 8 B)");
assert_eq(a3_e_8(), 58, "take(*F) passes the struct (explicit gpg<S>(), 8 B)");
assert_eq(a4_e_8(), 48, "a - *F dispatches S_sub (explicit gpg<S>(), 8 B)");
assert_eq(a5_e_8(), 68, "*F + a dispatches S_add (explicit gpg<S>(), 8 B)");
assert_eq(a6_e_8(), 5, "F.v reads through the pointer (explicit gpg<S>(), 8 B)");
assert_eq(a7_e_8(), 58, "control: var p: *S = F; var l: S = p (explicit gpg<S>(), 8 B)");
assert_eq(a1_i_8(), 58, "l = F copies the struct (inferred gpi(p), p: *S, 8 B)");
assert_eq(a2_i_8(), 58, "var q: S = *F copies (inferred gpi(p), p: *S, 8 B)");
assert_eq(a3_i_8(), 58, "take(*F) passes the struct (inferred gpi(p), p: *S, 8 B)");
assert_eq(a4_i_8(), 48, "a - *F dispatches S_sub (inferred gpi(p), p: *S, 8 B)");
assert_eq(a5_i_8(), 68, "*F + a dispatches S_add (inferred gpi(p), p: *S, 8 B)");
assert_eq(a6_i_8(), 5, "F.v reads through the pointer (inferred gpi(p), p: *S, 8 B)");
assert_eq(a7_i_8(), 58, "control: var p: *S = F; var l: S = p (inferred gpi(p), p: *S, 8 B)");
assert_eq(a1_v_8(), 58, "l = F copies the struct (inferred gpv(G), by value, 8 B)");
assert_eq(a2_v_8(), 58, "var q: S = *F copies (inferred gpv(G), by value, 8 B)");
assert_eq(a3_v_8(), 58, "take(*F) passes the struct (inferred gpv(G), by value, 8 B)");
assert_eq(a4_v_8(), 48, "a - *F dispatches S_sub (inferred gpv(G), by value, 8 B)");
