    var l = mk8(1);
    l = gpv(G8);
    poke();
    var r = rd8(l);
    unpoke();
    return r;
}
fn a2_v_8(): i64 {
    var q: S8 = *gpv(G8);
    poke();
    var r = rd8(q);
    unpoke();
    return r;
}
