# from inside a generic instance: `gpg<T>()` with T bound to the struct
fn outer<T>(): i64 {
    var l: T;
    l = gpg<T>();
    poke();
    var q: T = *gpg<T>();
    var r = l.v * 10 + q.v;
    unpoke();
    return r;
}
# ── 6.7.14: the generic called inside a fn that RETURNS a struct by value ──
# gpg's body is REPLAYED at the call, inside the caller; its `return` met the CALLER's struct-return class, so
# a 9-16 B or 24 B enclosing fn refused it ("... two registers ... got `gsel`", "return must be a bare local
# identifier ..."; `return GPA;` "... got `GPA`" / "identifier is not a local"). The callee's return is its own:
# T a struct or a scalar, a one-call body and a global body, 8 / 16 / 24 B enclosing fns.
# issues/archived/2026-10-14-generic-instance-return-takes-enclosing-fns-struct-return-class.md
var GPA = 0;
fn gpa<T>(): *T { return GPA; }
fn gsize(n: i64): i64 { return n; }
fn gsz<T>(): i64 { return gsize(sizeof(T)); }
fn rc8(): S8 { var q: *S16 = gpg<S16>(); var t: S8; t.v = q.v * 10 + q.w; return t; }
fn rc16s(): S16 { var q: *S24 = gpg<S24>(); var t: S16; t.v = q.x; t.w = q.w; return t; }
fn rc16i(): S16 { var a = gpg<i32>(); var t: S16; t.v = load64(a); t.w = 7; return t; }
fn rc24s(): S24 { var q: *S16 = gpg<S16>(); var t: S24; t.v = q.v; t.w = q.w; t.x = 1; return t; }
fn rc24i(): S24 { var a = gpg<i16>(); var t: S24; t.v = load64(a); t.w = 0; t.x = 2; return t; }
fn rg16(): S16 { var q: *S8 = gpa<S8>(); var t: S16; t.v = q.v; t.w = 4; return t; }
fn rg24(): S24 { var q: *S8 = gpa<S8>(); var t: S24; t.v = q.v; t.w = 1; t.x = 2; return t; }
fn rz16(): S16 { var t: S16; t.v = gsz<S8>(); t.w = gsz<S24>(); return t; }
fn rz24(): S24 { var t: S24; t.v = gsz<S24>(); t.w = gsz<S16>(); t.x = gsz<i32>(); return t; }
fn rcall(): i64 {
    GPA = &G8;
    var k = 0;
    var c8: S8 = rc8();
    if (c8.v == 58) { k = k + 1; }
    var c16s: S16 = rc16s();
    if (rd16(c16s) == 38) { k = k + 2; }
    var c16i: S16 = rc16i();
    if (rd16(c16i) == 57) { k = k + 4; }
    var c24s: S24 = rc24s();
    if (rd24(c24s) == 581) { k = k + 8; }
    var c24i: S24 = rc24i();
    if (rd24(c24i) == 502) { k = k + 16; }
    var g16: S16 = rg16();
    if (rd16(g16) == 54) { k = k + 32; }
    var g24: S24 = rg24();
    if (rd24(g24) == 512) { k = k + 64; }
    return k;
}
fn rz16v(): i64 { var z: S16 = rz16(); return rd16(z); }
fn rz24v(): i64 { var z: S24 = rz24(); return rd24(z); }
fn rpass(): i64 { return rd16(rc16s()) * 1000 + rd24(rc24s()); }

# ── 6.7.14: `var h: S = gpg<S>();` in a fn — the annotated local is a HANDLE to the struct the call points at ──
# (the 6.7.10 handle line: a call returning a `*T` binds a handle, as the non-generic `fn gp(): *S` does). Through
# 6.7.13 the annotation was dropped for a generic callee: `h` was an untyped word and `h.v = 6` was refused "no struct
# type in scope for 'h'". Explicit at 8 / 16 / 24 B, inferred through `gpi(p)` / `gpv(G)`, and h's uses that name no
# field: `var c: S = h;` binds a second handle, `take16(h)` passes the struct h points at.
# issues/archived/2026-10-14-generic-pointer-call-into-annotated-local-drops-struct-type.md
fn hb8(): i64 { var h: S8 = gpg<S8>(); h.v = 6; var k = G8.v * 10 + h.v; unpoke(); return k; }
fn hb16(): i64 { var h: S16 = gpg<S16>(); h.v = 6; var k = G16.v * 10 + h.w; unpoke(); return k; }
fn hb24(): i64 { var h: S24 = gpg<S24>(); h.v = 6; var k = G24.v * 100 + h.w * 10 + h.x; unpoke(); return k; }
fn hbi(): i64 { var p: *S16 = &G16; var h: S16 = gpi(p); h.v = 6; var k = G16.v * 10 + h.w; unpoke(); return k; }
fn hbv(): i64 { var h: S24 = gpv(G24); h.v = 6; var k = G24.v * 100 + h.w * 10 + h.x; unpoke(); return k; }
fn hbc(): i64 { var h: S16 = gpg<S16>(); var c: S16 = h; c.v = 7; var k = G16.v * 10 + h.w; unpoke(); return k; }
fn hbt(): i64 { var h: S24 = gpg<S24>(); var g: S16 = gpv(G16); return take16(g) * 1000 + rd24(h); }

# ── 6.7.14: a generic declared `: *Box<T>` — a pointer to a generic struct of its own T ──
# `fn mkp<T>(x: T): *Box<T>` was refused at its definition, called or not ("unknown type 'T' as a type argument",
# twice): the base's return was read with T unbound. The base reads it as `*Box` (T -> i64, as its body binds), and
# each instance as its own `*Box$S16`, which a `*Box<T>` carrier (`gnb(mkp(..))`) infers from.
# issues/archived/2026-10-14-generic-pointer-to-generic-struct-return-refused.md
struct Box<T> { v: T; n; }
fn mkp<T>(x: T): *Box<T> { var b: *Box<T> = alloc(sizeof(T) + 8); b.v = x; b.n = 8; return b; }
fn gnb<T>(b: *Box<T>): i64 { return b.n * 10 + sizeof(T); }
fn pb1(): i64 { return gnb(mkp(G16)); }
fn pb2(): i64 { return mkp<S16>(G16).n * 100 + mkp<S16>(G16).v.w; }
fn pb3(): i64 { var q: *Box<S24> = mkp(G24); return q.n * 100 + q.v.w * 10 + q.v.x; }
fn pb4(): i64 { return mkp(5).n * 10 + mkp(5).v; }
fn pb5(): i64 { var q: *Box<S8> = mkp<S8>(G8); q.v.v = 9; return q.v.v * 10 + G8.v + gnb(q) * 100; }

# ── top level: a declaration-zone `var Z: S = *gpg<S>();`, then statements ──
var Z16: S16 = *gpg<S16>();
var Z24: S24 = *gpg<S24>();
var T16 = S16 { 1, 1 };
var T24 = S24 { 1, 1, 1 };
var TO = O24 { 9, 0, 0, 0, 9 };
T16 = gpg<S16>();
T24 = *gpg<S24>();
TO.s = gpg<S24>();
var TV = gpg<S16>().w * 10 + gpg<S24>().x;
poke();
var TZ = rd16(Z16) * 1000 + rd24(Z24);
var TT = rd16(T16) * 1000 + rd24(T24);
var TS = rd24(TO.s) + (TO.g == 9) * 1000;
unpoke();

