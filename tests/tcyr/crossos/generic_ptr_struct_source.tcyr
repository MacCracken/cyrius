# generic_ptr_struct_source.tcyr — 6.7.11. A GENERIC CALL DECLARED `: *T` IS A STRUCT SOURCE, as `fn gp(): *S` is
# (6.7.10, decision 6) — issues/archived/2026-10-13-generic-pointer-returning-call-as-struct-source.md.
#
# ⛔ THROUGH 6.7.10 the chain typer skipped a generic call (`_hl_pchain`), and the instance recorded T's pointer
# STEP but not its struct (`_ret_ptr_record` read `*T` with `FINDSTRUCT('T')`): `l = gpg<S>()` stored the
# POINTER word into the first field, `var q: S = *gpg<S>();` bound a handle to the word the dereference read,
# `take(*gpg<S>())`, `a - *gpg<S>()` and `*gpg<S>() + a` passed that word as the struct's address (SIGSEGV on
# every one), and `gpg<S>().v` was refused "it does not return a struct" — while binding the call first
# (`var p: *S = gpg<S>();`) worked. The filed repro (16 B): 102, 139, 139, 139, 139, refused, 58.
#
# THE RULE (every row's value is what the non-generic `fn gp(): *S` gives): the seven filed positions at 8,
# 16 and 24 B, for an EXPLICIT `gpg<S>()` and two INFERRED forms — `gpi(p)` (`fn gpi<T>(x: *T): *T`, p a
# `*S` local: T binds S) and `gpv(G)` (`fn gpv<T>(x: T): *T`, a by-value struct argument). A copy reads the
# struct at the time of the copy: each copy row writes the pointee afterwards (6 into its first field) and
# reads the copy back (8 B: `v * 10 + 8`; 16 B: `v * 10 + w`; 24 B: `v * 100 + w * 10 + x` = 58 / 58 / 583).
# Then the same call in the 6.7.11 copy arms — a struct-typed FIELD destination (`o.s = gpg<S>()`), an
# assignment from its dereference (`l = *gpg<S>()`, `o.s = *gpg<S>()`) — wrapped, as pointer arithmetic,
# through a two-parameter generic, from inside another generic's instance (`gpg<T>()` with T bound), and at
# top level (a declaration-zone `var Z: S = *gpg<S>();`, statements, a field of the call).
# (`gpi(&G)` is not here: `&G` infers T = i64 for a `*T` parameter, so it runs the i64 base — no `*S`.)
# 6.7.14: the same generics called inside fns that RETURN a struct by value (8 / 16 / 24 B), T a struct or a
# scalar, a one-call body and a global body — a replayed `return` is the callee's (`rcall`, `rz16`, `rz24`). And
# `var h: S = gpg<S>();` in a fn is a handle to the struct the call points at (`hb*`); a generic declared
# `: *Box<T>` compiles and its call is a `*Box<..>` (`pb*`).
#
# CROSS-HOST: tests/gates/codegen/small_struct_handle_line.sh R12 runs this file on x86_64 (plain,
# CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm) and PE (wine); the release gate's
# cross-OS leg on ecb / ach / cass / pi. The filed repro verbatim and the refusals are
# tests/gates/frontend/generic_struct_field.sh's P rows.
include "lib/assert.cyr"

struct S8 { v; }
struct S16 { v; w; }
struct S24 { v; w; x; }
struct O8 { k; s: S8; g; }
struct O16 { k; s: S16; g; }
struct O24 { k; s: S24; g; }
var G8 = S8 { 5 };
var G16 = S16 { 5, 8 };
var G24 = S24 { 5, 8, 3 };

# the global a `*T` of each size points at (sizeof(T) picks it in the instance)
fn gsel(n: i64): i64 {
    if (n == 8) { return &G8; }
    if (n == 16) { return &G16; }
    return &G24;
}
fn gpg<T>(): *T { return gsel(sizeof(T)); }
fn gpi<T>(x: *T): *T { return x; }
fn gpv<T>(x: T): *T { return gsel(sizeof(T)); }
fn gp2<T, U>(u: U): *T { return gsel(sizeof(T)); }
fn poke(): i64 { G8.v = 6; G16.v = 6; G24.v = 6; return 0; }
fn unpoke(): i64 { G8.v = 5; G16.v = 5; G24.v = 5; return 0; }

fn rd8(r: S8): i64 { return r.v * 10 + 8; }
fn take8(s: S8): i64 { return rd8(s); }
fn S8_sub(a: *S8, b: *S8): S8 {
    var r: S8;
    r.v = a.v - b.v;
    return r;
}
fn S8_add(a: *S8, b: *S8): S8 {
    var r: S8;
    r.v = a.v + b.v;
    return r;
}
fn mk8(k: i64): S8 { var r: S8; r.v = k; return r; }
fn rd16(r: S16): i64 { return r.v * 10 + r.w; }
fn take16(s: S16): i64 { return rd16(s); }
fn S16_sub(a: *S16, b: *S16): S16 {
    var r: S16;
    r.v = a.v - b.v;
    r.w = a.w - b.w;
    return r;
}
fn S16_add(a: *S16, b: *S16): S16 {
    var r: S16;
    r.v = a.v + b.v;
    r.w = a.w + b.w;
    return r;
}
fn mk16(k: i64): S16 { var r: S16; r.v = k; r.w = k; return r; }
fn rd24(r: S24): i64 { return r.v * 100 + r.w * 10 + r.x; }
fn take24(s: S24): i64 { return rd24(s); }
fn S24_sub(a: *S24, b: *S24): S24 {
    var r: S24;
    r.v = a.v - b.v;
    r.w = a.w - b.w;
    r.x = a.x - b.x;
    return r;
}
fn S24_add(a: *S24, b: *S24): S24 {
    var r: S24;
    r.v = a.v + b.v;
    r.w = a.w + b.w;
    r.x = a.x + b.x;
    return r;
}
fn mk24(k: i64): S24 { var r: S24; r.v = k; r.w = k; r.x = k; return r; }

fn a1_e_8(): i64 {
    var l = mk8(1);
    l = gpg<S8>();
    poke();
    var r = rd8(l);
    unpoke();
    return r;
}
fn a2_e_8(): i64 {
    var q: S8 = *gpg<S8>();
    poke();
    var r = rd8(q);
    unpoke();
    return r;
}
fn a3_e_8(): i64 {
