# S8: o.s = gpg<S>(), l = *gpg<S>(), o.s = *gpg<S>(), l = (gpg<S>()), l = gpg<S>() + 0, l = gp2<S, i64>(3),
# l = (*gpg<S>()); a guard field after `s` kept
fn b_8(): i64 {
    var o1: O8; var o2: O8;
    o1.g = 9; o2.g = 9;
    o1.s = gpg<S8>();
    o2.s = *gpg<S8>();
    var l1 = mk8(1); var l2 = mk8(1); var l3 = mk8(1); var l4 = mk8(1); var l5 = mk8(1);
    l1 = *gpg<S8>();
    l2 = (gpg<S8>());
    l3 = gpg<S8>() + 0;
    l4 = gp2<S8, i64>(3);
    l5 = (*gpg<S8>());
    poke();
    var k = 0;
    if (rd8(o1.s) == 58) { k = k + 1; }
    if (rd8(o2.s) == 58) { k = k + 2; }
    if (rd8(l1) == 58) { k = k + 4; }
    if (rd8(l2) == 58) { k = k + 8; }
    if (rd8(l3) == 58) { k = k + 16; }
    if (rd8(l4) == 58) { k = k + 32; }
    if (rd8(l5) == 58) { k = k + 64; }
    if (o1.g + o2.g == 18) { k = k + 128; }
    unpoke();
    return k;
}
