# generic_struct_field.tcyr — 6.7.1 (C3 prerequisite): a struct FIELD typed with a generic struct
# instance, `b: Box<i32>`, read and written through, on every backend.
#
# ⛔ Before 6.7.1 such a field was `expected identifier, got '<'`. It cannot be instantiated where
# the field is read — a struct's fields fill one contiguous slice of the field pool, and an instance
# registered mid-definition would land its own fields inside it — so every generic field type is
# minted by a pre-scan of the body BEFORE the outer struct registers (`_sdef_gen_prescan`), and the
# field then names the instance. Rows: a plain outer with fields before and after (F1-F3, by value
# too), `Box<Pt>` (F4), two type arguments `Pair<i32, Pt>` (F5), nested `Box<Box<i32>>` (F6),
# `Box<i64>` is the base `Box` (F7), `Box<T>` inside a generic outer follows its instance (F8 `W<Pt>`,
# F9 `W<i32>`) and is the base in the base `W` (F10), a union (F11). Layouts are packed:
# `Box<i32>` is 4 + 8 = 12 B. The refusals (a field naming its own struct) and the `#derive` walk
# are tests/gates/frontend/generic_struct_field.sh. Mutation: skip `_sdef_gen_prescan` -> cycc
# SIGSEGVs on this file.
#
# 6.7.16 — A `**G<..>` FIELD (two stars or more) mints G<..> after the struct's `}`, under the struct's own binding.
# Its annotation and its pin minted the instance in the middle of the struct's run of the field pool, so the
# instance's fields took slots the struct's next field overwrote: `PB<Pt>` first named by `qq: **PB<Pt>` had no `v` /
# `n` ("unknown field 'v' on struct 'PB$Pt'", the file refused), and `**PB<SA>` inside SA sized PB<SA> with the SA so
# far. A generic struct's `**PB<T>` / `**LL<T>` field was "unknown type 'T' as a type argument". Rows F12-F17: the
# field before and after other fields, `***`, a union, the struct's own name, a generic struct's self link and
# `**PB<T>` at its instances and its base — each through the pin (`*h.qq + 1` steps the instance, `*h.qq` is its
# `*PB<..>`, `**h.qq` its value). The refusals are generic_struct_field.sh PP.
#
# 6.7.16 — A FIELD OF A FIELD IN A GENERIC BODY, AND THE BASE'S SIGNATURE LIST. `g.v.v = v` with `g: G1<Box<T>>` was
# judged a struct use of the parameter `v` (the stub scan read the field name), so `mkn<i32>(33)` was refused; and the
# base read its `: G1<Box<T>>` as the base G1 while its body's `var g: G1<Box<T>>` is `G1$Box`, so the definition was
# refused. Rows F18-F22: the filed shape at i64 / i32 / Pt, `q.a.k` beside a parameter `a`, the base's parameters and
# returns naming instances (`G1<Box<T>>`, `*G1<Box<T>>`, `Box<Pt>`, `Box<i32>`), a bare `: G1<T>` unchanged. The
# refusal rows are generic_struct_field.sh NF.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

struct Pt { x; y; }
struct Box<T> { v: T; n; }
struct Pair<A, B> { a: A; b: B; }
# a generic-instance field in a plain struct, before and after other fields
struct H { a: i64; b: Box<i32>; c: i64; }
struct HP { p: Box<Pt>; k: i32; }
struct H2 { q: Pair<i32, Pt>; z; }
struct HN { nb: Box<Box<i32>>; tail; }
struct HI { bi: Box<i64>; e; }
# inside a generic struct: Box<T> follows the instance
struct W<T> { w: Box<T>; m; }
union U { ub: Box<i32>; raw; }
# 6.7.16: a `**G<..>` field is the first to name each of these instances
struct Pt2 { a; b; c; }
struct PB<T> { v: T; n; }
struct HQ { k; qq: **PB<Pt>; m; }
struct HQ3 { qq: ***PB<Pt2>; k; }
union UQ { qq: **PB<Pair<i64, Pt>>; raw; }
struct SA { k; p: **PB<SA>; m; }
struct LL<T> { v: T; next: **LL<T>; m; }
struct HG<T> { qq: **PB<T>; k; }

fn pp_hq(): i64 {
    var b: PB<Pt>; b.v.x = 1; b.v.y = 5; b.n = 6; var pb: *PB<Pt> = &b;
    var h: HQ; h.k = 1; h.m = 2; h.qq = &pb;
    var a = *h.qq + 1; var c = *h.qq; var q: *PB<Pt> = *h.qq; var v: PB<Pt> = **h.qq;
    return h.k * 100000 + h.m * 10000 + (a - c) * 100 + q.n * 10 + v.v.y + sizeof(PB<Pt>) * 1000000;
}
fn pp_hq3(): i64 {
    var b: PB<Pt2>; b.v.c = 4; b.n = 3; var pb: *PB<Pt2> = &b; var ppb: **PB<Pt2> = &pb;
    var h: HQ3; h.k = 7; h.qq = &ppb;
    var a = **h.qq + 1; var c = **h.qq; var q: *PB<Pt2> = **h.qq;
    return h.k * 10000 + (a - c) * 100 + q.n * 10 + q.v.c;
}
fn pp_uq(): i64 {
    var b: PB<Pair<i64, Pt>>; b.v.a = 2; b.v.b.y = 3; b.n = 4; var pb: *PB<Pair<i64, Pt>> = &b;
    var u: UQ; u.qq = &pb;
    var a = *u.qq + 1; var c = *u.qq; var q: *PB<Pair<i64, Pt>> = *u.qq;
    return (a - c) * 1000 + q.n * 100 + q.v.b.y * 10 + q.v.a;
}
fn pp_sa(): i64 {
    var s: SA; s.k = 1; s.m = 2; var b: PB<SA>; b.n = 3; b.v.m = 4; var pb: *PB<SA> = &b; s.p = &pb;
    var q: *PB<SA> = *s.p;
    return s.k * 100000 + s.m * 10000 + q.n * 1000 + q.v.m * 100 + sizeof(PB<SA>);
}
fn pp_ll(): i64 {
    var l: LL<Pt>; l.v.y = 5; l.m = 7; var pl: *LL<Pt> = &l; l.next = &pl;
    var a = *l.next + 1; var c = *l.next; var q: *LL<Pt> = *l.next;
    return (a - c) * 1000 + q.m * 100 + (**l.next).v.y * 10 + sizeof(LL<Pt>) / 8;
}
fn pp_hg(): i64 {
    var b: PB<Pt>; b.v.y = 4; b.n = 3; var pb: *PB<Pt> = &b;
    var h: HG<Pt>; h.k = 2; h.qq = &pb;
    var a = *h.qq + 1; var c = *h.qq; var q: *PB<Pt> = *h.qq;
    var bi: PB<i64>; bi.n = 6; var pbi: *PB<i64> = &bi; var hi: HG<i64>; hi.qq = &pbi; var qi: *PB<i64> = *hi.qq;
    var hb: HG; hb.qq = &pbi; var e = *hb.qq + 1; var f = *hb.qq;
    return h.k * 1000000 + (a - c) * 10000 + q.n * 1000 + (**h.qq).v.y * 100 + qi.n * 10 + (e - f) / 8;
}

# 6.7.16: a field of a field in a generic body; the base's signature lists at T = i64
struct In { k; }
struct QA { a: In; }
struct G1<T> { v: T; }
fn nf_mkn<T>(v: T): G1<Box<T>> { var g: G1<Box<T>>; g.v.v = v; g.v.n = 7; return g; }
fn nf_qa<T>(a: T): i64 { var q: QA; q.a.k = 5; return q.a.k; }
fn nf_r1<T>(g: G1<Box<T>>): i64 { return g.v.v + g.v.n; }
fn nf_r2<T>(g: *G1<Box<T>>): i64 { return g.v.v * 10 + g.v.n; }
fn nf_r3<T>(b: Box<Pt>, x: T): i64 { return b.v.y * 10 + b.n + x; }
fn nf_m1<T>(x: T): Box<Pt> { var b: Box<Pt>; b.v.x = x; b.v.y = 2; b.n = 3; return b; }
fn nf_m2<T>(x: T): Box<i32> { var b: Box<i32>; b.v = 3; b.n = x; return b; }
fn nf_mk1<T>(v: T): G1<T> { var g: G1<T>; g.v = v; return g; }
fn nf_mkn_all(): i64 {
    var a = nf_mkn(30); var c = nf_mkn<i32>(1);
    var p: Pt; p.x = 4; p.y = 5; var d = nf_mkn(p); var e: G1<Box<Pt>> = nf_mkn<Pt>(p);
    return a.v.v * 100000 + c.v.v * 10000 + d.v.v.x * 1000 + e.v.v.y * 100 + a.v.n * 10 + sizeof(G1<Box<i64>>) / 8;
}
fn nf_params(): i64 {
    var g: G1<Box<i64>>; g.v.v = 1; g.v.n = 2;
    var q: Box<Pt>; q.v.y = 3; q.n = 4;
    return nf_r1(g) * 10000 + nf_r2(&g) * 100 + nf_r3(q, 1);
}
fn nf_rets(): i64 {
    var a = nf_m1(4); var b = nf_m2(5);
    return a.v.x * 1000 + a.v.y * 100 + a.n * 10 + b.v + b.n * 0 + sizeof(Box<i32>) * 10000 + b.n * 100000;
}
fn nf_bare(): i64 {
    var p: Pt; p.x = 3; p.y = 4;
    var x = nf_mk1(6); var y = nf_mk1<i32>(2); var z = nf_mk1(p);
    return x.v * 1000 + y.v * 100 + z.v.y * 10 + sizeof(G1);
}

fn hsum(h: H): i64 { return h.a + h.b.v + h.b.n + h.c; }

fn run(): i64 {
    var h: H; h.a = 1; h.b.v = 2; h.b.n = 3; h.c = 4;
    assert_eq(h.a + h.b.v + h.b.n + h.c, 10, "F1: H fields through b: Box<i32>");
    assert_eq(sizeof(H), 28, "F2: sizeof(H) = 8 + 12 (Box<i32>: v 4, n 8; packed) + 8");
    assert_eq(hsum(h), 10, "F3: H passed by value");
    var hp: HP; hp.p.v.x = 40; hp.p.v.y = 2; hp.p.n = 5; hp.k = 7;
    assert_eq(hp.p.v.x + hp.p.v.y + hp.p.n + hp.k, 54, "F4: Box<Pt> field");
    var h2: H2; h2.q.a = 3; h2.q.b.x = 4; h2.q.b.y = 5; h2.z = 6;
    assert_eq(h2.q.a + h2.q.b.x + h2.q.b.y + h2.z, 18, "F5: Pair<i32, Pt> field");
    var hn: HN; hn.nb.v.v = 9; hn.nb.v.n = 10; hn.nb.n = 11; hn.tail = 12;
    assert_eq(hn.nb.v.v + hn.nb.v.n + hn.nb.n + hn.tail, 42, "F6: Box<Box<i32>> field");
    var hi: HI; hi.bi.v = 20; hi.bi.n = 21; hi.e = 1;
    assert_eq(hi.bi.v + hi.bi.n + hi.e, 42, "F7: Box<i64> is the base Box");
    var w: W<Pt>; w.w.v.x = 30; w.w.v.y = 10; w.w.n = 1; w.m = 1;
    assert_eq(w.w.v.x + w.w.v.y + w.w.n + w.m, 42, "F8: Box<T> inside W<Pt>");
    var wi: W<i32>; wi.w.v = 40; wi.w.n = 1; wi.m = 1;
    assert_eq(wi.w.v + wi.w.n + wi.m, 42, "F9: Box<T> inside W<i32>");
    var wb: W; wb.w.v = 41; wb.m = 1;
    assert_eq(wb.w.v + wb.m, 42, "F10: the base W (Box<T> = the base Box)");
    var u: U; u.ub.v = 42;
    assert_eq(u.ub.v, 42, "F11: Box<i32> in a union");
    assert_eq(pp_hq(), 24122465, "F12: qq: **PB<Pt> (PB<Pt>'s first use): its fields, k / m around it, *h.qq + 1 steps 24, *h.qq, **h.qq");
    assert_eq(pp_hq3(), 73234, "F13: qq: ***PB<Pt2>, k after it: **h.qq + 1 steps 32");
    assert_eq(pp_uq(), 32432, "F14: a union's qq: **PB<Pair<i64, Pt>>: *u.qq + 1 steps 32");
    assert_eq(pp_sa(), 123432, "F15: p: **PB<SA> inside SA: PB<SA> holds the whole SA (24 + 8)");
    assert_eq(pp_ll(), 32754, "F16: LL<T>'s next: **LL<T> at LL<Pt>: steps 32, *l.next a *LL<Pt>");
    assert_eq(pp_hg(), 2243462, "F17: HG<T>'s qq: **PB<T>: HG<Pt> steps 24, HG<i64> a *PB<i64>, the base HG steps 16");
    assert_eq(nf_mkn_all(), 3014572, "F18: : G1<Box<T>> at i64 (16 B), i32, Pt (24 B), explicit — g.v.v = v");
    assert_eq(nf_qa(9), 5, "F19: q.a.k beside a parameter a: T (no struct use of a)");
    assert_eq(nf_params(), 31235, "F20: the base's G1<Box<T>>, *G1<Box<T>>, Box<Pt> parameters are the instances");
    assert_eq(nf_rets(), 624233, "F21: the base's : Box<Pt> and : Box<i32> returns are the instances");
    assert_eq(nf_bare(), 6248, "F22: a bare : G1<T> return is the base G1 at i64 (unchanged)");
    return 0;
}
var r0 = run();
var rr = assert_summary();
syscall(60, rr);
