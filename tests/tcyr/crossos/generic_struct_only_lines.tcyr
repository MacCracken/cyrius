# generic_struct_only_lines.tcyr — 6.7.16 (the user's D1, 2026-10-19): a generic whose body only works when T is a
# struct — `return &n;` with n typed by T in a fn returning a struct, or a struct result over 8 B stored in a name typed
# by T (`var y: T = mkp();`, `y = mkp();`, `p = mkp();` into a `*T`) — has no scalar instance: its scalar calls are
# refused by name (tests/gates/frontend/small_struct_return_type_refused.sh RG*, struct_result_type_refused.sh TG*).
# Through 6.7.15 the base, the T = i64 instance, ran such a line: `h(3)` returned a dead slot's address as the struct,
# `g(5)` kept the struct's first word. These rows pin what still compiles, on every backend: the struct instances
# (the address of a T-typed local is the struct; the result is copied into y, or through p), a forwarder at a struct,
# an untyped `var n = x;` at a struct, a fn returning its own `: T` (no such generic), and the one-word results a scalar
# keeps (an 8-byte struct, a `Str` handle).
# 6.7.16 (the user's D102, 2026-10-20), V1-V15: an untyped `var y = x;` holding a value of T takes T's type in each
# instance — x itself, wrapped, through another untyped var, a generic call's `: U` / `: Box<U>` result bound to it, a
# struct carrier `b: Box<T>` — so its field, store, method, `y = mkp()`, forward and closure uses run at a struct T
# (each was "no struct type in scope for 'y'" at the definition), a bounded `y.show()` calls the bound's impl at every T,
# and at a scalar T a body that only uses y as a word runs; the scalar calls of a struct use are refused
# (struct_result_type_refused.sh TV*). V16-V18 (the D102 review, 2026-10-21): at any length — a 10-copy chain, 9 untyped
# vars mixing copies and `id(..)`, `id(..)` 9 deep (an 8-level budget left each "no struct type in scope" at the
# definition). V19-V21: x read after a closure's own `|x|`, a `for x in` loop or a block destructuring `var q, x` is the
# T value (inside them it is not: struct_result_type_refused.sh TV11-TV11i).
# 6.7.17 (the user's D1, 2026-10-22), V22-V28: g's OWN x read past a closure's `|x|`, a `for x in` loop or a block's
# `var q, x` is the T value — a bounded `x.show()` the bound's impl, `x.b` the struct's field, a carrier's `b.v.b` past
# `|b|` — as is a T value a closure captures, a destructure's right-hand side `pr(x.b)` and a range's start bound
# `x.a..10` (each reads the enclosing x; inside the rebindings x is their own word, refused at the definition:
# struct_result_type_refused.sh RB*).
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

struct S8 { v; }
struct Q { a; b; }
struct Q8 { a; }
fn mkp(): Q { var q: Q; q.a = 333; q.b = 444; return q; }
fn mk8(): Q8 { var q: Q8; q.a = 21; return q; }
fn mks(): Str { return str_from("abc"); }
impl Q { fn mk(self): Q { var q: Q; q.a = 301; q.b = 2; return q; } }

fn h<T>(x: T): S8 { var n: T = x; return &n; }
fn k<T>(x: T): S8 { return h(x); }
fn hu<T>(x: T): S8 { var n = x; return &n; }
fn ht<T>(x: T): T { var n: T = x; return &n; }
fn g<T>(x: T): i64 { var y: T = mkp(); return y.b - 400; }
fn gm<T>(x: T): i64 { var b: Q; var y: T = b.mk(); return y.a - 300; }
fn ga<T>(x: T): i64 { var y: T = x; y = mkp(); return y.a - 300; }
fn gp<T>(x: T): i64 { var p: *T = &x; p = mkp(); return x.b - 400; }
fn g8<T>(x: T): i64 { var y: T = mk8(); return y; }
fn gs<T>(x: T): i64 { var y: T = mks(); return str_len(y); }

struct Box<T> { v: T; n; }
struct P { k; }
trait Show { fn show(self): i64; }
impl Show for Q { fn show(self): i64 { return self.a * 10 + self.b; } }
impl Show for i64 { fn show(self): i64 { return self + 100; } }
impl Q { fn sum(self): i64 { return self.a + self.b; } }
impl P { fn hm<T>(self, x: T): i64 { var y = x; return y.b + self.k; } }
fn id<T>(v: T): T { return v; }
fn idp<T>(p: *T): T { var r: T = *p; return r; }
fn mkbox<T>(v: T): Box<T> { var b: Box<T>; b.v = v; b.n = 6; return b; }
fn idpp<T>(pp: **T): T { var r: T = **pp; return r; }
fn first<T>(b: Box<T>): T { var r: T = b.v; return r; }
fn v15<T>(x: T): i64 { var p: *T = &x; var a = idpp(&p); var bx: Box<T>; bx.v = x; var b = first(bx); return a.a + b.b; }
fn vb<T>(x: T): i64 { return x.b; }
fn sh<U: Show>(v: U): i64 { return v.show(); }
fn v1<T>(x: T): i64 { var y = x; return y.b; }
fn v2<T>(x: T): i64 { var y = x; y = mkp(); return y.b - 400; }
fn v3<T>(x: T): i64 { var z = (x); var y = z; return y.a * 10 + y.b; }
fn v4<T>(x: T): i64 { var y = x; y.b = 9; return y.b * 10 + x.b; }
fn v5<T>(x: T): i64 { var y = x; return y.sum(); }
fn v6<T>(x: T): i64 { var y = x; return vb(y); }
fn v7<T>(x: T): i64 { var a = id(x); var b = id<T>(x); var c = idp(&x); return a.a + b.b + c.a; }
fn v8<T>(b: Box<T>): i64 { var y = b; return y.v.b * 10 + y.n; }
fn v9<T>(x: T): i64 { var y = mkbox(x); return y.v.a * 10 + y.n; }
fn v10<T>(x: T): i64 { var y = x; var f = |k| { return y.b + k; }; return fncall1(f, 1); }
fn v11<T: Show>(x: T): i64 { var y = x; var z = id(x); return y.show() + sh(z); }
fn v12<T>(x: T): i64 { var y = x; return y + 1; }
fn v16<T>(x: T): i64 { var y1 = x; var y2 = y1; var y3 = y2; var y4 = y3; var y5 = y4; var y6 = y5; var y7 = y6; var y8 = y7; var y9 = y8; var y10 = y9; return y10.b; }
fn v17<T>(x: T): i64 { var a = x; var b = id(a); var c = b; var d = id(c); var e = d; var f = id(e); var h = f; var i = id(h); var j = i; return j.a * 10 + j.b; }
fn v18<T>(x: T): i64 { var y = id(id(id(id(id(id(id(id(id(x))))))))); return y.a; }
fn two(): (i64, i64) { return (1, 2); }
fn v19<T>(x: T): i64 { var f = |x| { return x + 1; }; var y = x; return y.b + fncall1(f, 1); }
fn v20<T>(x: T): i64 { var s = 0; for x in 0..3 { s = s + x; } var y = x; return y.b + s; }
fn v21<T>(x: T): i64 { var r = 0; if (r == 0) { var q, x = two(); r = q + x; } var y = x; return y.b + r; }
fn pr(a: i64): (i64, i64) { return (a, a + 1); }
fn v22<T: Show>(x: T): i64 { var f = |x| { return x + 1; }; var s = 0; for x in 0..2 { s = s + x; } return x.show() + fncall1(f, 1) + s; }
fn v23<T: Show>(x: T): i64 { var r = 0; if (r == 0) { var q, x = two(); r = q + x; } return x.show() + r; }
fn v24<T: Show>(x: T): i64 { var f = |k| { return x.show() + k; }; return fncall1(f, 1); }
fn v25<T>(x: T): i64 { var f = |x| { return x + 1; }; return x.b + fncall1(f, 1); }
fn v26<T>(b: Box<T>): i64 { var f = |b| { return b + 1; }; return b.v.b + fncall1(f, 1); }
fn v27<T>(x: T): i64 { var q, x = pr(x.b); return q + x; }
fn v28<T>(x: T): i64 { var s = 0; for x in x.a..10 { s = s + 1; } return s; }

fn run(): i64 {
    var s: S8; s.v = 7;
    var c1: S8 = h<S8>(s);
    assert_eq(c1.v, 7, "L1: h<S8>(s): &n of the T-typed n is the struct");
    var c2: S8 = h(s);
    assert_eq(c2.v, 7, "L2: h(s) inferred");
    var c3: S8 = k(s);
    assert_eq(c3.v, 7, "L3: a forwarder k(s) at S8");
    var c4: S8 = hu(s);
    assert_eq(c4.v, 7, "L4: an untyped var n = x at S8");
    var c5: S8 = ht(s);
    assert_eq(c5.v, 7, "L5: a : T return at S8");
    assert_eq(ht(3) != 0, 1, "L6: a : T return at i64 is no stub (an address)");
    var q: Q; q.a = 7; q.b = 8;
    assert_eq(g(q), 44, "L7: var y: T = mkp() at T = Q copies (y.b 444)");
    assert_eq(gm(q), 1, "L8: var y: T = b.mk() at T = Q copies (y.a 301)");
    assert_eq(ga(q), 33, "L9: y = mkp() at T = Q copies (y.a 333)");
    assert_eq(gp(q), 44, "L10: p = mkp() (p: *T) at T = Q copies through p (x.b 444)");
    assert_eq(g8(5), 21, "L11: an 8-byte struct result into y: T at i64 keeps its word");
    assert_eq(gs(5), 3, "L12: a Str result into y: T at i64 keeps its handle");
    assert_eq(v1(q), 8, "V1: var y = x; y.b at T = Q (the D102 repro's shape)");
    assert_eq(v2(q), 44, "V2: var y = x; y = mkp() at T = Q copies (y.b 444)");
    assert_eq(v3(q), 78, "V3: var z = (x); var y = z; at T = Q");
    assert_eq(v4(q), 98, "V4: y.b = 9 stores into y's copy, x.b stays 8");
    assert_eq(v5(q), 15, "V5: y.sum() at T = Q");
    assert_eq(v6(q), 8, "V6: y forwarded to a stub generic at T = Q");
    assert_eq(v7(q), 22, "V7: id(x), id<T>(x), idp(&x) at T = Q");
    var bx: Box<Q>; bx.v = q; bx.n = 6;
    assert_eq(v8(bx), 86, "V8: var y = b (b: Box<T>) at T = Q: y.v.b, y.n");
    assert_eq(v9(q), 76, "V9: var y = mkbox(x) at T = Q: y.v.a, y.n");
    assert_eq(v10(q), 9, "V10: a closure reads y.b at T = Q");
    assert_eq(v11(q), 156, "V11: bounded y.show() and sh(id(x)) at T = Q");
    assert_eq(v11(5), 210, "V12: bounded y.show() and sh(id(x)) at T = i64 call impl Show for i64");
    assert_eq(v12(5), 6, "V13: y used as a word at a scalar T runs");
    var pp = P { 10 };
    assert_eq(pp.hm(q), 18, "V14: a generic method's var y = x; y.b at T = Q");
    assert_eq(v15(q), 15, "V15: idpp(&p) (pp: **U) and first(bx) (b: Box<U>) at T = Q");
    assert_eq(v16(q), 8, "V16: a 10-copy chain of untyped vars at T = Q");
    assert_eq(v17(q), 78, "V17: 9 untyped vars mixing copies and id() at T = Q");
    assert_eq(v18(q), 7, "V18: id(..) nested 9 deep at T = Q");
    assert_eq(v19(q), 10, "V19: var y = x; after a closure's own |x| reads the T-typed x");
    assert_eq(v20(q), 11, "V20: var y = x; after a for x in loop reads the T-typed x");
    assert_eq(v21(q), 11, "V21: var y = x; after a block destructuring var q, x reads the T-typed x");
    assert_eq(v22(q), 81, "V22: bounded x.show() past a closure's |x| and a for x in loop: the T value's");
    assert_eq(v22(5), 108, "V22i: ... at T = i64 (impl Show for i64)");
    assert_eq(v23(q), 81, "V23: bounded x.show() past a block's var q, x: the T value's");
    assert_eq(v24(q), 79, "V24: a closure capturing the T value calls the bound's impl");
    assert_eq(v24(5), 106, "V24i: ... at T = i64");
    assert_eq(v25(q), 10, "V25: x.b past a closure's |x|: the T value's field");
    assert_eq(v26(bx), 10, "V26: b.v.b past a closure's |b|: the carrier's field");
    assert_eq(v27(q), 17, "V27: var q, x = pr(x.b); reads the T value's x.b on its right-hand side");
    assert_eq(v28(q), 3, "V28: for x in x.a..10 reads the T value's x.a in its start bound");
    return 0;
}
alloc_init();
var r0 = run();
var r = assert_summary();
