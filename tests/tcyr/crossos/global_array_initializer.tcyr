# a list is the value FROM PROGRAM START, 6.6.6's rule for a constant redeclaration: an earlier
# initializer reads it, and over an earlier initializer of the same name it wins (a constant it
# does not fully list keeps its other bytes; a computed one still runs, its result discarded)
fn gai_read_fwd(): i64 { return GRDT[1]; }
var GRD = gai_read_fwd();
var GRDT: i64[2] = {5, 6};
var GRS = 5;
var GRS[1] = {0};
var GRK = 0x0506;
var GRK[1] = {9};
var GRZ = 0;
var GRZ[1] = {0, 3};
var GAI_CALLS = 0;
fn gai_side(): i64 { GAI_CALLS = GAI_CALLS + 1; return 0x7777; }
var GRC = gai_side();
var GRC[1] = {0, 4};

alloc_init();

# ── after the first top-level statement: the same declarations mean the same thing ──
var GPOST: i64[3] = {GA, 5, -9};
var GPOSTW: u16[2] = {0xFFFF, GaiE.GB};
var GPOSTB[1] = {7, 8, 9};
var GPOSTF: f64[1] = {-1.5};

# the filed probe: 42 + 42 + 100
assert_eq(GT[2] + GW[2] + 100, 184, "T[2] + W[2] + 100 == 184");
assert_eq(GT[0], 1, "GT[0]");
assert_eq(GT[1], 2, "GT[1]");
assert_eq(load64(&GT + 16), 42, "GT raw 16");
assert_eq(GW[0], 1, "GW[0]");
assert_eq(load16(&GW + 2), 2, "GW raw 2");

assert_eq(GI8[0], -128, "i8 lo");
assert_eq(GI8[1], 127, "i8 hi");
assert_eq(GI8[2], -1, "i8 0xFF is the bits of -1");
assert_eq(GI8[3], -128, "i8 0x80 is the bits of -128");
assert_eq(load8(&GI8 + 2), 255, "i8 raw byte 2");
assert_eq(GU8[1], 255, "u8 hi");
assert_eq(GU8[2], 255, "u8 -1 is the bits of 255");
assert_eq(load8(&GU8 + 3), 0x7F, "u8 raw byte 3");
assert_eq(GI16[0], -32768, "i16 lo");
assert_eq(GI16[1], 32767, "i16 hi");
assert_eq(GI16[2], -1, "i16 0xFFFF");
assert_eq(GU16[1], 65535, "u16 hi");
assert_eq(GU16[2], 32768, "u16 -32768 is 0x8000");
assert_eq(GI32[0], -2147483648, "i32 lo");
assert_eq(GI32[1], 2147483647, "i32 hi");
assert_eq(GI32[2], -1, "i32 0xFFFFFFFF");
assert_eq(load32(&GU32 + 4), 0xFFFFFFFF, "u32 hi");
assert_eq(load32(&GU32 + 8), 0xFFFFFFFF, "u32 -1");
assert_eq(GI64[0], -1, "i64 -1");
assert_eq(GI64[1], 0x7FFFFFFFFFFFFFFF, "i64 max");
assert_eq(GI64[2] + 0x7FFFFFFFFFFFFFFF, -1, "i64 min");
assert_eq(GI64[3], 42, "i64 [3]");
assert_eq(load64(&GU64), -1, "u64 -1");
assert_eq(load64(&GU64 + 8), 7, "u64 [1]");

assert_eq(GEN[0], 3, "enum bare");
assert_eq(GEN[1], 0x40, "enum qualified");
assert_eq(GEN[2], 0x46, "enum expression");
assert_eq(GEN[3], 16, "shift");
assert_eq(GEN[4], -5, "negative");
assert_eq(GEN[5], -7, "parenthesised negative enum");
assert_eq(GEN[6], 0x13, "or");
assert_eq(GEN8[0], -7, "i8 negative enum");
assert_eq(GEN8[1], -7, "i8 qualified negative enum");
assert_eq(load64(&GENT), 0x40, "enum-typed element 0");
assert_eq(load64(&GENT + 8), 3, "enum-typed element 1");
assert_eq(GFWD[0], 0x1234, "forward enum, qualified");
assert_eq(GFWD[1], 10, "forward enum in an expression");

assert_eq(load8(&GBARE), 3, "bare enum");
assert_eq(load8(&GBARE + 1), 0x40, "bare qualified enum");
assert_eq(load8(&GBARE + 2), 0x11, "bare expression");
assert_eq(load8(&GBARE + 3), 255, "bare 255");
assert_eq(load8(&GBARE + 5), 0, "bare tail");

assert_eq(load64(&GF64), load64(&GF64S1), "f64 1.5 == the scalar constant's bits");
assert_eq(load64(&GF64 + 16), load64(&GF64S3), "f64 0.1 == the scalar constant's bits");
assert_eq(load64(&GF64 + 8), 0xC002000000000000, "f64 -2.25 bits");
assert_eq(load32(&GF32), f32_from(1.5), "f32 1.5 == f32_from");
assert_eq(load32(&GF32 + 4), f32_from(0.1) | 0x80000000, "f32 -0.1 == f32_from, sign set");
assert_eq(load32(&GF32 + 8), f32_from(3.25), "f32 3.25 == f32_from");
assert_eq(load64(&GU128), 7, "u128 low");
assert_eq(load64(&GU128 + 8), 0, "u128 high");
assert_eq(load64(&GU128 + 16), -1, "u128 -1 low");
assert_eq(load64(&GU128 + 24), 0, "u128 -1 high");
assert_eq(load64(&GU128 + 32), 0x123456789, "u128 wide low");
assert_eq(load64(&GBOOL + 16), 1, "bool is 8 bytes per element");
assert_eq(load64(&GPTR), 0x1000, "pointer element 0");
assert_eq(load64(&GPTR + 8), 8, "pointer element 1");

assert_eq(GPART[0], 11, "partial [0]");
assert_eq(GPART[1], 22, "partial [1]");
assert_eq(GPART[2] + GPART[3] + GPART[4], 0, "partial: the rest is 0");
assert_eq(load8(&GTAIL + 11), 12, "u8[12] last element");
assert_eq(GCAN, 0x5A, "the narrow canary after a 12-byte array is untouched");
assert_eq(GCAN2, 0x0123456789ABCDEF, "the 8-byte canary is untouched");

var gk = 0;
var gbad = 0;
while (gk < 200) {
    if (load32(&GFL32 + gk * 4) != f32_from(load64(&GFL64 + gk * 8))) { gbad = gbad + 1; }
    gk = gk + 1;
}
assert_eq(gbad, 0, "f32 elements == f32_from of the same literal (200)");
assert_eq(load32(&GFL32 + 4 * 199), 0x80000001, "f32 corpus: -least subnormal");

assert_eq(GPOST[0], 3, "post-statement enum");
assert_eq(GPOST[2], -9, "post-statement negative");
assert_eq(GPOSTW[0], 0xFFFF, "post-statement u16");
assert_eq(GPOSTW[1], 0x40, "post-statement qualified enum");
assert_eq(load8(&GPOSTB + 2), 9, "post-statement bare list");
assert_eq(load64(&GPOSTF), 0xBFF8000000000000, "post-statement f64 -1.5");

assert_eq(GRD, 6, "an earlier initializer reads a list declared below it");
assert_eq(load64(&GRS), 0, "a zero list over a scalar constant");
assert_eq(load64(&GRK), 0x0509, "a list over a scalar constant keeps the bytes it does not list");
assert_eq(load64(&GRZ), 0x0300, "a list over `= 0` is the value (the later declaration wins)");
assert_eq(load64(&GRC), 0x0400, "a list over a computed initializer is the value");
assert_eq(GAI_CALLS, 1, "the computed initializer still ran, once");

var r = assert_summary();
