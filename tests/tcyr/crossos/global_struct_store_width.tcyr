var GM5: M5 = M5 { 0, 0 };
var TM5_0: i8 = 0x51; var TM5_1: i8 = 0x52; var TM5_2: i8 = 0x53; var TM5_3: i8 = 0x54; var TM5_4: i8 = 0x55; var TM5_5: i8 = 0x56; var TM5_6: i8 = 0x57;
var HM6: M6 = M6 { 0x24232221, 0x2625 };
var GM6: M6 = M6 { 0, 0 };
