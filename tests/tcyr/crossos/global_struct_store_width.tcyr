var TB16_0: i8 = 0x51; var TB16_1: i8 = 0x52; var TB16_2: i8 = 0x53; var TB16_3: i8 = 0x54; var TB16_4: i8 = 0x55; var TB16_5: i8 = 0x56; var TB16_6: i8 = 0x57;
var HM3: M3 = M3 { 0x2221, 0x23 };
var GM3: M3 = M3 { 0, 0 };
var TM3_0: i8 = 0x51; var TM3_1: i8 = 0x52; var TM3_2: i8 = 0x53; var TM3_3: i8 = 0x54; var TM3_4: i8 = 0x55; var TM3_5: i8 = 0x56; var TM3_6: i8 = 0x57;
