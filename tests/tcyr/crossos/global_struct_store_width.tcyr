assert_eq(gs_tail(&TM15_0), 0 - 1, "M15 I: TM15_0..TM15_6 hold their image values");

assert_eq(gs_pat(&DGB3, 3), 0 - 1, "B3 J: var DGB3 = HB3; (declaration zone) holds the pattern");
assert_eq(DGTB3, 0x51, "B3 J: the i8 after DGB3 keeps its value");
assert_eq(gs_pat(&DCB3, 3), 0 - 1, "B3 J: var DCB3 = dmkB3(); (declaration zone) holds the pattern");
assert_eq(DCTB3, 0x52, "B3 J: the i8 after DCB3 keeps its value");
assert_eq(gs_pat(&DGB5, 5), 0 - 1, "B5 J: var DGB5 = HB5; (declaration zone) holds the pattern");
assert_eq(DGTB5, 0x51, "B5 J: the i8 after DGB5 keeps its value");
assert_eq(gs_pat(&DCB5, 5), 0 - 1, "B5 J: var DCB5 = dmkB5(); (declaration zone) holds the pattern");
assert_eq(DCTB5, 0x52, "B5 J: the i8 after DCB5 keeps its value");
