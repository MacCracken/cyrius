# At top level, after the first statement: a global source, and a call (a struct over 8 bytes
# needs a frame for its result, so it is refused at top level and has no row).
GB1 = HB1; gs_row(&GB1, 1, "B1 T: GB1 = HB1 at top level");
GB1 = mkB1(); gs_row(&GB1, 1, "B1 T: GB1 = mkB1() at top level");
GB2 = HB2; gs_row(&GB2, 2, "B2 T: GB2 = HB2 at top level");
GB2 = mkB2(); gs_row(&GB2, 2, "B2 T: GB2 = mkB2() at top level");
GB3 = HB3; gs_row(&GB3, 3, "B3 T: GB3 = HB3 at top level");
GB3 = mkB3(); gs_row(&GB3, 3, "B3 T: GB3 = mkB3() at top level");
GB4 = HB4; gs_row(&GB4, 4, "B4 T: GB4 = HB4 at top level");
GB4 = mkB4(); gs_row(&GB4, 4, "B4 T: GB4 = mkB4() at top level");
GB5 = HB5; gs_row(&GB5, 5, "B5 T: GB5 = HB5 at top level");
GB5 = mkB5(); gs_row(&GB5, 5, "B5 T: GB5 = mkB5() at top level");
GB6 = HB6; gs_row(&GB6, 6, "B6 T: GB6 = HB6 at top level");
GB6 = mkB6(); gs_row(&GB6, 6, "B6 T: GB6 = mkB6() at top level");
GB7 = HB7; gs_row(&GB7, 7, "B7 T: GB7 = HB7 at top level");
GB7 = mkB7(); gs_row(&GB7, 7, "B7 T: GB7 = mkB7() at top level");
GB8 = HB8; gs_row(&GB8, 8, "B8 T: GB8 = HB8 at top level");
GB8 = mkB8(); gs_row(&GB8, 8, "B8 T: GB8 = mkB8() at top level");
GB9 = HB9; gs_row(&GB9, 9, "B9 T: GB9 = HB9 at top level");
GB10 = HB10; gs_row(&GB10, 10, "B10 T: GB10 = HB10 at top level");
GB11 = HB11; gs_row(&GB11, 11, "B11 T: GB11 = HB11 at top level");
GB12 = HB12; gs_row(&GB12, 12, "B12 T: GB12 = HB12 at top level");
GB13 = HB13; gs_row(&GB13, 13, "B13 T: GB13 = HB13 at top level");
GB14 = HB14; gs_row(&GB14, 14, "B14 T: GB14 = HB14 at top level");
GB15 = HB15; gs_row(&GB15, 15, "B15 T: GB15 = HB15 at top level");
GB16 = HB16; gs_row(&GB16, 16, "B16 T: GB16 = HB16 at top level");
GM3 = HM3; gs_row(&GM3, 3, "M3 T: GM3 = HM3 at top level");
GM3 = mkM3(); gs_row(&GM3, 3, "M3 T: GM3 = mkM3() at top level");
GM5 = HM5; gs_row(&GM5, 5, "M5 T: GM5 = HM5 at top level");
GM5 = mkM5(); gs_row(&GM5, 5, "M5 T: GM5 = mkM5() at top level");
GM6 = HM6; gs_row(&GM6, 6, "M6 T: GM6 = HM6 at top level");
GM6 = mkM6(); gs_row(&GM6, 6, "M6 T: GM6 = mkM6() at top level");
GM7 = HM7; gs_row(&GM7, 7, "M7 T: GM7 = HM7 at top level");
GM7 = mkM7(); gs_row(&GM7, 7, "M7 T: GM7 = mkM7() at top level");
GM9 = HM9; gs_row(&GM9, 9, "M9 T: GM9 = HM9 at top level");
GM15 = HM15; gs_row(&GM15, 15, "M15 T: GM15 = HM15 at top level");

# A global declared after the first statement (PARSE_VAR's registration) is packed the same way.
var LGB3: B3 = B3 { 0, 0, 0 };
var LTB3_0: i8 = 0x51; var LTB3_1: i8 = 0x52; var LTB3_2: i8 = 0x53; var LTB3_3: i8 = 0x54; var LTB3_4: i8 = 0x55; var LTB3_5: i8 = 0x56; var LTB3_6: i8 = 0x57;
assert_eq(&LTB3_0 - &LGB3, 3, "B3 K: LTB3_0 is packed right after LGB3");
LGB3 = HB3; gs_row(&LGB3, 3, "B3 K: LGB3 = HB3 (declared after the first statement)");
fn lputB3(): i64 { var l: B3 = HB3; LGB3 = l; return 0; }
lputB3(); gs_row(&LGB3, 3, "B3 K: LGB3 = l in a fn");
var LGB7: B7 = B7 { 0, 0, 0, 0, 0, 0, 0 };
var LTB7_0: i8 = 0x51; var LTB7_1: i8 = 0x52; var LTB7_2: i8 = 0x53; var LTB7_3: i8 = 0x54; var LTB7_4: i8 = 0x55; var LTB7_5: i8 = 0x56; var LTB7_6: i8 = 0x57;
assert_eq(&LTB7_0 - &LGB7, 7, "B7 K: LTB7_0 is packed right after LGB7");
LGB7 = HB7; gs_row(&LGB7, 7, "B7 K: LGB7 = HB7 (declared after the first statement)");
fn lputB7(): i64 { var l: B7 = HB7; LGB7 = l; return 0; }
lputB7(); gs_row(&LGB7, 7, "B7 K: LGB7 = l in a fn");
var LGM5: M5 = M5 { 0, 0 };
var LTM5_0: i8 = 0x51; var LTM5_1: i8 = 0x52; var LTM5_2: i8 = 0x53; var LTM5_3: i8 = 0x54; var LTM5_4: i8 = 0x55; var LTM5_5: i8 = 0x56; var LTM5_6: i8 = 0x57;
assert_eq(&LTM5_0 - &LGM5, 5, "M5 K: LTM5_0 is packed right after LGM5");
LGM5 = HM5; gs_row(&LGM5, 5, "M5 K: LGM5 = HM5 (declared after the first statement)");
fn lputM5(): i64 { var l: M5 = HM5; LGM5 = l; return 0; }
lputM5(); gs_row(&LGM5, 5, "M5 K: LGM5 = l in a fn");
var LGM6: M6 = M6 { 0, 0 };
var LTM6_0: i8 = 0x51; var LTM6_1: i8 = 0x52; var LTM6_2: i8 = 0x53; var LTM6_3: i8 = 0x54; var LTM6_4: i8 = 0x55; var LTM6_5: i8 = 0x56; var LTM6_6: i8 = 0x57;
assert_eq(&LTM6_0 - &LGM6, 6, "M6 K: LTM6_0 is packed right after LGM6");
LGM6 = HM6; gs_row(&LGM6, 6, "M6 K: LGM6 = HM6 (declared after the first statement)");
fn lputM6(): i64 { var l: M6 = HM6; LGM6 = l; return 0; }
lputM6(); gs_row(&LGM6, 6, "M6 K: LGM6 = l in a fn");

var r = assert_summary();
syscall(SYS_EXIT, r);
