alloc_init();

# The leading-block layout and values: every neighbour byte still holds its image value.
assert_eq(&TB1_0 - &GB1, 1, "B1 I: TB1_0 is packed right after GB1");
assert_eq(gs_pat(&HB1, 1), 0 - 1, "B1 I: HB1 holds the pattern");
assert_eq(gs_tail(&TB1_0), 0 - 1, "B1 I: TB1_0..TB1_6 hold their image values");
assert_eq(&TB2_0 - &GB2, 2, "B2 I: TB2_0 is packed right after GB2");
assert_eq(gs_pat(&HB2, 2), 0 - 1, "B2 I: HB2 holds the pattern");
assert_eq(gs_tail(&TB2_0), 0 - 1, "B2 I: TB2_0..TB2_6 hold their image values");
assert_eq(&TB3_0 - &GB3, 3, "B3 I: TB3_0 is packed right after GB3");
assert_eq(gs_pat(&HB3, 3), 0 - 1, "B3 I: HB3 holds the pattern");
assert_eq(gs_tail(&TB3_0), 0 - 1, "B3 I: TB3_0..TB3_6 hold their image values");
assert_eq(&TB4_0 - &GB4, 4, "B4 I: TB4_0 is packed right after GB4");
assert_eq(gs_pat(&HB4, 4), 0 - 1, "B4 I: HB4 holds the pattern");
assert_eq(gs_tail(&TB4_0), 0 - 1, "B4 I: TB4_0..TB4_6 hold their image values");
