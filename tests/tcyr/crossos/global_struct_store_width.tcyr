impl B15 { fn pat(self): B15 { var l: B15; l.f0 = 0x21; l.f1 = 0x22; l.f2 = 0x23; l.f3 = 0x24; l.f4 = 0x25; l.f5 = 0x26; l.f6 = 0x27; l.f7 = 0x28; l.f8 = 0x29; l.f9 = 0x2A; l.f10 = 0x2B; l.f11 = 0x2C; l.f12 = 0x2D; l.f13 = 0x2E; l.f14 = 0x2F; return l; } }
#endif
fn putB15(p: B15): i64 { GB15 = p; return 0; }
fn rowsB15(): i64 {
    var g = &GB15;
    gs_reset(g, 15);
    var l: B15; l.f0 = 0x21; l.f1 = 0x22; l.f2 = 0x23; l.f3 = 0x24; l.f4 = 0x25; l.f5 = 0x26; l.f6 = 0x27; l.f7 = 0x28; l.f8 = 0x29; l.f9 = 0x2A; l.f10 = 0x2B; l.f11 = 0x2C; l.f12 = 0x2D; l.f13 = 0x2E; l.f14 = 0x2F;
    GB15 = l; gs_row(g, 15, "B15 A: GB15 = l (a local)");
    #ifndef CYRIUS_TARGET_CX
    GB15 = mkB15(); gs_row(g, 15, "B15 B: GB15 = mkB15() (a call)");
    GB15 = l.pat(); gs_row(g, 15, "B15 C: GB15 = l.pat() (a method)");
    #endif
    putB15(l); gs_row(g, 15, "B15 D: GB15 = p (a by-value parameter)");
    GB15 = HB15; gs_row(g, 15, "B15 E: GB15 = HB15 (a global)");
    GB15 = (l); gs_row(g, 15, "B15 F: GB15 = (l) (a wrapped source)");
    var i = 0;
    for (i = 0; i < 1; GB15 = l) { i = i + 1; }
    gs_row(g, 15, "B15 G: a for step GB15 = l");
    var f = || { GB15 = l; return 0; };
    fncall0(f); gs_row(g, 15, "B15 H: GB15 = l in a closure (a captured source)");
    return 0;
}
