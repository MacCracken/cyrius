var GB5: B5 = B5 { 0, 0, 0, 0, 0 };
var TB5_0: i8 = 0x51; var TB5_1: i8 = 0x52; var TB5_2: i8 = 0x53; var TB5_3: i8 = 0x54; var TB5_4: i8 = 0x55; var TB5_5: i8 = 0x56; var TB5_6: i8 = 0x57;
var HB6: B6 = B6 { 0x21, 0x22, 0x23, 0x24, 0x25, 0x26 };
var GB6: B6 = B6 { 0, 0, 0, 0, 0, 0 };
var TB6_0: i8 = 0x51; var TB6_1: i8 = 0x52; var TB6_2: i8 = 0x53; var TB6_3: i8 = 0x54; var TB6_4: i8 = 0x55; var TB6_5: i8 = 0x56; var TB6_6: i8 = 0x57;
var HB7: B7 = B7 { 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27 };
var GB7: B7 = B7 { 0, 0, 0, 0, 0, 0, 0 };
var TB7_0: i8 = 0x51; var TB7_1: i8 = 0x52; var TB7_2: i8 = 0x53; var TB7_3: i8 = 0x54; var TB7_4: i8 = 0x55; var TB7_5: i8 = 0x56; var TB7_6: i8 = 0x57;
