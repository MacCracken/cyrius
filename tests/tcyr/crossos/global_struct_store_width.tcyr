# global_struct_store_width.tcyr — 6.7.7 — a whole-struct store into a GLOBAL writes exactly the
# struct's bytes, on every backend.
#
# ⛔ THE DEFECT. Narrow scalar globals and narrow struct fields are PACKED (6.6.10, 6.6.13), so an
# inline struct global is exactly its size and the next global can start right after it: a 3 / 5 /
# 6 / 7-byte global has neighbours at +3 / +5 / +6 / +7. A struct of 8 bytes or fewer travels as
# ONE value (rax / x0 / r0) and its store into a global is `_asg_store_slot`'s EVSTORE_W at the
# global's width — which stored exactly only 1 / 2 / 4 bytes and sent every other width to the
# 8-byte store. `G = l;` (the filed repro), `G = mk();`, a method result, a by-value parameter,
# another global, a wrapped source, a for step and a closure body, in a fn, at top level and on a
# global declared after the first statement, all wrote the value's upper bytes over the next
# 5 / 3 / 2 / 1 bytes of globals — silently, measured on x86, aarch64 (qemu), cx and PE (wine);
# both Mach-O targets share the x86 / aarch64 emitters.
# Filed: docs/development/issues/2026-10-09-global-odd-size-struct-store-overwrites-next-global.md
# THE FIX: EVSTORE_W stores a 3 / 5 / 6 / 7-byte width as 4 + 2 + 1 pieces on every backend
# (x86 `_ESTORE_ODD_RCX` — PE and Mach-O x86 too; aarch64 `_ESTORE_ODD_X1` — Mach-O arm64 too;
# cx `_CX_STORE_ODD`). CHANGELOG [6.7.7]
#
# NOT THE PATH (measured): the declaration replay's `_gv_store`, the filing's probable cause. A
# struct global initialised from an EXPRESSION (`var G: S3 = H;`, `= mk();`, in the leading block or
# after the first statement) is registered at 8 bytes, so its 8-byte store is in bounds, and a
# literal (`= S3 { .. }`) is laid down field by field. The J rows keep those two as controls.
# A struct over 8 bytes is copied byte-exact (`_agc_copy_bytes`) or received at its size, so the
# 9..16-byte rows passed before the fix too: they show the tail word never had the defect.
#
# THE ROWS, per shape — Bn is n `i8` fields (n = 1..16); Mn mixes i16 / i32 / i64 fields to the odd
# sizes 3 / 5 / 6 / 7 and the 9 / 15-byte tails. The destination GX is followed by seven packed
# `i8` globals 0x51..0x57 (I asserts the packing: padding after GX would hide the overrun), and
# every row stores the pattern 0x21 + k, then checks the destination's bytes AND the seven bytes
# after it. A..H in a fn: a local, a call, a method, a by-value parameter, a global, a wrapped
# source, a for step, a closure capture. T at top level after the first statement: a global, and a
# call when the struct fits in 8 bytes (a wider result needs a frame and is refused there). K: a
# global declared after the first statement. J: the declaration-zone controls. cx refuses a
# 9..16-byte struct return by name, so B and C are fenced off there for those shapes.
#
# Mutation ledger (2026-10-09; a scratch copy of the tree, rebuilt with the one change; the gate
# tests/gates/codegen/global_struct_store_width.sh runs this file on every leg):
#   the merged 6.7.7 compiler, before the fix  -> 88 of 304 red on x86, aarch64 and PE; 88 of 284 on cx
#   M1 x86 EVSTORE_W without its odd arm       -> x86 and PE 88 red; aarch64 and cx green
#   M2 aarch64 EVSTORE_W without it            -> aarch64 88 red
#   M3 cx EVSTORE_W without it                 -> cx 88 red
#   M4 x86: each ror by 8*off, not 8*(off-rot) -> x86 and PE 22 red (byte 6 of every 7-byte shape)
#   M6 aarch64: the later pieces store w0, not the shifted w16 -> aarch64 88 red
#   M7 cx: every later piece stored at r1 + 0  -> cx 88 red
#   GREEN, recorded: M5 x86 without the closing `rol` (no caller reads rax after the store; it is
#   kept so EVSTORE_W leaves rax as every store emitter does) and M8 `_gv_store` back to exact
#   1 / 2 / 4 (no declaration reaches it at an odd width — above).
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

# Struct shapes: Bn is n `i8` fields (n bytes), Mn mixes widths to the same odd sizes.
struct B1 { f0: i8; }
struct B2 { f0: i8; f1: i8; }
struct B3 { f0: i8; f1: i8; f2: i8; }
struct B4 { f0: i8; f1: i8; f2: i8; f3: i8; }
struct B5 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; }
struct B6 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; }
struct B7 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; }
struct B8 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; }
struct B9 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; f8: i8; }
struct B10 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; f8: i8; f9: i8; }
struct B11 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; f8: i8; f9: i8; f10: i8; }
struct B12 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; f8: i8; f9: i8; f10: i8; f11: i8; }
struct B13 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; f8: i8; f9: i8; f10: i8; f11: i8; f12: i8; }
struct B14 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; f8: i8; f9: i8; f10: i8; f11: i8; f12: i8; f13: i8; }
struct B15 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; f8: i8; f9: i8; f10: i8; f11: i8; f12: i8; f13: i8; f14: i8; }
struct B16 { f0: i8; f1: i8; f2: i8; f3: i8; f4: i8; f5: i8; f6: i8; f7: i8; f8: i8; f9: i8; f10: i8; f11: i8; f12: i8; f13: i8; f14: i8; f15: i8; }
struct M3 { a: i16; b: i8; }
struct M5 { a: i32; b: i8; }
struct M6 { a: i32; b: i16; }
struct M7 { a: i32; b: i16; c: i8; }
struct M9 { a: i64; b: i8; }
struct M15 { a: i64; b: i32; c: i16; d: i8; }

# Per shape X: HX holds the pattern (byte k = 0x21 + k), GX is the destination, and the seven
# `i8` globals TX_0..TX_6 are packed right after GX (asserted by the L rows) with 0x51..0x57.
var HB1: B1 = B1 { 0x21 };
var GB1: B1 = B1 { 0 };
var TB1_0: i8 = 0x51; var TB1_1: i8 = 0x52; var TB1_2: i8 = 0x53; var TB1_3: i8 = 0x54; var TB1_4: i8 = 0x55; var TB1_5: i8 = 0x56; var TB1_6: i8 = 0x57;
var HB2: B2 = B2 { 0x21, 0x22 };
var GB2: B2 = B2 { 0, 0 };
var TB2_0: i8 = 0x51; var TB2_1: i8 = 0x52; var TB2_2: i8 = 0x53; var TB2_3: i8 = 0x54; var TB2_4: i8 = 0x55; var TB2_5: i8 = 0x56; var TB2_6: i8 = 0x57;
var HB3: B3 = B3 { 0x21, 0x22, 0x23 };
var GB3: B3 = B3 { 0, 0, 0 };
var TB3_0: i8 = 0x51; var TB3_1: i8 = 0x52; var TB3_2: i8 = 0x53; var TB3_3: i8 = 0x54; var TB3_4: i8 = 0x55; var TB3_5: i8 = 0x56; var TB3_6: i8 = 0x57;
var HB4: B4 = B4 { 0x21, 0x22, 0x23, 0x24 };
