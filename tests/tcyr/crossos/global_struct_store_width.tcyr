var GM15: M15 = M15 { 0, 0, 0, 0 };
var TM15_0: i8 = 0x51; var TM15_1: i8 = 0x52; var TM15_2: i8 = 0x53; var TM15_3: i8 = 0x54; var TM15_4: i8 = 0x55; var TM15_5: i8 = 0x56; var TM15_6: i8 = 0x57;

# The declaration-zone controls: a copy-init and a call-init of an odd shape register a full
# 8-byte global (measured), so the 8-byte replay store is in bounds; each is followed by a packed
# `i8` that must keep its value.
fn dmkB3(): B3 { var l: B3 = HB3; return l; }
fn dmkB5(): B5 { var l: B5 = HB5; return l; }
fn dmkB6(): B6 { var l: B6 = HB6; return l; }
fn dmkB7(): B7 { var l: B7 = HB7; return l; }
var DGB3: B3 = HB3;
var DGTB3: i8 = 0x51;
var DCB3: B3 = dmkB3();
var DCTB3: i8 = 0x52;
var DGB5: B5 = HB5;
var DGTB5: i8 = 0x51;
var DCB5: B5 = dmkB5();
var DCTB5: i8 = 0x52;
var DGB6: B6 = HB6;
var DGTB6: i8 = 0x51;
var DCB6: B6 = dmkB6();
var DCTB6: i8 = 0x52;
var DGB7: B7 = HB7;
var DGTB7: i8 = 0x51;
var DCB7: B7 = dmkB7();
var DCTB7: i8 = 0x52;

# -1 when the n bytes at g are the pattern 0x21 + k; else the first offset that is not.
fn gs_pat(g, n): i64 {
    var k = 0;
    while (k < n) { if (load8(g + k) != 0x21 + k) { return k; } k = k + 1; }
    return 0 - 1;
}
# -1 when the seven bytes at g are still 0x51..0x57; else the first offset that is not.
fn gs_tail(g): i64 {
    var k = 0;
    while (k < 7) { if (load8(g + k) != 0x51 + k) { return k; } k = k + 1; }
    return 0 - 1;
}
# -1 when the destination holds the pattern AND its seven neighbour bytes are untouched.
fn gs_bad(g, n): i64 {
    var k = gs_pat(g, n);
    if (k >= 0) { return k; }
    k = gs_tail(g + n);
    if (k >= 0) { return n + k; }
    return 0 - 1;
}
# Zero the destination and lay the seven neighbour bytes back down (a failed row cannot leak into
# the next one).
fn gs_reset(g, n): i64 {
    var k = 0;
    while (k < n) { store8(g + k, 0); k = k + 1; }
    k = 0;
    while (k < 7) { store8(g + n + k, 0x51 + k); k = k + 1; }
    return 0;
}
fn gs_row(g, n, what): i64 {
    assert_eq(gs_bad(g, n), 0 - 1, what);
    gs_reset(g, n);
    return 0;
}

fn mkB1(): B1 { var l: B1; l.f0 = 0x21; return l; }
impl B1 { fn pat(self): B1 { var l: B1; l.f0 = 0x21; return l; } }
fn putB1(p: B1): i64 { GB1 = p; return 0; }
fn rowsB1(): i64 {
    var g = &GB1;
    gs_reset(g, 1);
    var l: B1; l.f0 = 0x21;
    GB1 = l; gs_row(g, 1, "B1 A: GB1 = l (a local)");
    GB1 = mkB1(); gs_row(g, 1, "B1 B: GB1 = mkB1() (a call)");
    GB1 = l.pat(); gs_row(g, 1, "B1 C: GB1 = l.pat() (a method)");
    putB1(l); gs_row(g, 1, "B1 D: GB1 = p (a by-value parameter)");
    GB1 = HB1; gs_row(g, 1, "B1 E: GB1 = HB1 (a global)");
    GB1 = (l); gs_row(g, 1, "B1 F: GB1 = (l) (a wrapped source)");
    var i = 0;
    for (i = 0; i < 1; GB1 = l) { i = i + 1; }
    gs_row(g, 1, "B1 G: a for step GB1 = l");
    var f = || { GB1 = l; return 0; };
    fncall0(f); gs_row(g, 1, "B1 H: GB1 = l in a closure (a captured source)");
    return 0;
}
fn mkB2(): B2 { var l: B2; l.f0 = 0x21; l.f1 = 0x22; return l; }
impl B2 { fn pat(self): B2 { var l: B2; l.f0 = 0x21; l.f1 = 0x22; return l; } }
fn putB2(p: B2): i64 { GB2 = p; return 0; }
fn rowsB2(): i64 {
    var g = &GB2;
    gs_reset(g, 2);
    var l: B2; l.f0 = 0x21; l.f1 = 0x22;
    GB2 = l; gs_row(g, 2, "B2 A: GB2 = l (a local)");
    GB2 = mkB2(); gs_row(g, 2, "B2 B: GB2 = mkB2() (a call)");
    GB2 = l.pat(); gs_row(g, 2, "B2 C: GB2 = l.pat() (a method)");
    putB2(l); gs_row(g, 2, "B2 D: GB2 = p (a by-value parameter)");
    GB2 = HB2; gs_row(g, 2, "B2 E: GB2 = HB2 (a global)");
    GB2 = (l); gs_row(g, 2, "B2 F: GB2 = (l) (a wrapped source)");
    var i = 0;
    for (i = 0; i < 1; GB2 = l) { i = i + 1; }
    gs_row(g, 2, "B2 G: a for step GB2 = l");
    var f = || { GB2 = l; return 0; };
    fncall0(f); gs_row(g, 2, "B2 H: GB2 = l in a closure (a captured source)");
    return 0;
}
fn mkB3(): B3 { var l: B3; l.f0 = 0x21; l.f1 = 0x22; l.f2 = 0x23; return l; }
impl B3 { fn pat(self): B3 { var l: B3; l.f0 = 0x21; l.f1 = 0x22; l.f2 = 0x23; return l; } }
fn putB3(p: B3): i64 { GB3 = p; return 0; }
fn rowsB3(): i64 {
    var g = &GB3;
    gs_reset(g, 3);
    var l: B3; l.f0 = 0x21; l.f1 = 0x22; l.f2 = 0x23;
    GB3 = l; gs_row(g, 3, "B3 A: GB3 = l (a local)");
    GB3 = mkB3(); gs_row(g, 3, "B3 B: GB3 = mkB3() (a call)");
    GB3 = l.pat(); gs_row(g, 3, "B3 C: GB3 = l.pat() (a method)");
