# inline_str_value.tcyr — 6.7.13 (the user's decision D7 (1), 2026-10-15) — an INLINE `Str` is its header's
# address wherever a `Str` value is taken.
#
# A `Str` is a heap handle by name: its slot holds the address of a 16-byte `{ data; len; }` header. A
# `Str { p, n }` literal is an INLINE header on the frame, whose slot is field 0 — and every
# use of the bare name as a `Str` value took that slot, the `data` word, as the header: `f(t)` into `s: Str`
# read the length out of whatever followed the string (the filed repro exited 0 where 7 is right, on every
# target; issues/archived/2026-10-12-inline-str-local-passed-to-str-param-wrong-value.md). Now `f(t)`, `f((t))`,
# `str_len(t)`, a method's `Str` parameter, `var h: Str = t;`, `var h = t;` and `h = t;` into a handle take the
# header's address, with no allocation: `&t` for a local (so `h` is a second handle to t's header), the static
# address for an inline global, the environment copy's address for a closure's capture. The uses that would let
# a frame's header outlive the frame are refused by name (tests/gates/frontend/inline_str_value.sh): `return t;`
# from a fn returning `Str`, a store into a `Str` global, a `Str` field or through a `*Str`. A global's address
# is static and a capture is a copy in the closure's environment, so neither is refused: those rows are here.
# Since 6.7.14 (the user's decision D20 (a), 2026-10-16) a bare `var t: Str;` is an inline `Str` under D7 (1) too
# (the b_bare / u_* rows), and `t = a` — an inline `Str` <- a `Str` HANDLE: a local, a parameter, a global, a
# call or method declared `: Str`, a `Str` field — copies the header a points at (the h_* rows), as `t = u`
# between two inline `Str`s does: through 6.7.13 it stored a's address into t.data and left t.len stale (6.6.16's
# pun, which `str_len(t)` read back through t.data for a bare t). An untyped source keeps the one-word store
# (tests/gates/frontend/inline_str_value.sh K8).
# Since 6.7.15 a `*Str` joins in (the user's decisions of 2026-10-18): `t = p` / `t = *p` copy the header p points at
# into an inline `Str` (D14, the ps_* rows; an if-expression of handles keeps the word, D15); `p = t` / `GP = gt` into a
# `*Str` take the header's address as the declaration does (D16, the pa_* rows); a `*Str` dereference into a `Str`
# parameter passes p (`str_len(*p)`, the sd_* rows); a zone `var HB: Str = gb;` with gb declared below binds (D17).
# Since 6.7.16 `t = *pp` with pp a `**Str` (so `*pp` is a `*Str`) copies the header too, as `t = p` does (the pps_*
# rows, R_TOP11: a local, a bare `var t: Str;`, an inline global, a for step, wrapped, a parameter, a `**Str` global,
# a `: **Str` call, a `**Str` field, `**ppp`, a capture, top level); it stored the header's address into t.data and
# left t.len stale (the filed repro 22, want 55; issues/2026-10-18-inline-str-from-double-str-pointer-single-deref-
# stores-one-word.md, its repro verbatim is inline_str_value.sh PP1). Into a `*Str` or a handle `q = *pp` stays the
# rebind `q = p` is. And `h = *p` into a `Str` HANDLE (p a `*Str`) rebinds h to the header p points at, as `h = p`
# does (the user's D20, 2026-10-19; the hd_* rows, R_TOP12: a local, a parameter, a global, wrapped, a for step, `*GP`,
# `*gp()`, `*w.p`, `*w.sp()`, a capture, top level): it stored the header's data word as the handle (the filed repro 0,
# want 5; issues/archived/2026-10-18-str-handle-assigned-str-pointer-dereference-stores-data-word.md, inline_str_value.sh HD1).
# And an inline `Str` stored into a `*Str` FIELD or through a `**Str` takes its header's address, as `p = gt` into a
# `*Str` name does (the user's D19, 2026-10-19; the pa_fld_* / pa_pp_* rows, R_TOP13 / R_TOP14: a local's field, a
# global's, through a `*W`, nested, a `: *W` call's, a for step, a capture, `*pp`, `*(pp)`, `*GPP`, `*gpp()`, a `pp:
# **Str` parameter, top level); it stored the data word (the filed repros 0, want 9 and 7; issues/2026-10-18-inline-
# str-into-str-pointer-field-or-double-pointer-keeps-data-word.md, inline_str_value.sh FD1 / FD2). A frame's t is
# refused by name into any field (a local struct's too, D19) and through `*pp` (the gate's X15-X19).
#
# CROSS-HOST: the address is EFLADDR / EVADDR on each backend, the tail-call rows check that a frame address
# laundered through a handle diverts the `jmp` (`_fn_local_addr`). Run on ecb / ach (Mach-O), cass (PE) and pi
# (aarch64) by the release gate.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/io.cyr"
include "lib/bayan.cyr"
include "lib/assert.cyr"

fn f(s: Str): i64 { return str_len(s); }
fn f2(k, s: Str): i64 { return str_len(s) + k; }
fn fd(s: Str): i64 { return load8(str_data(s)); }

struct U { data; len; }
fn gu(s: U): i64 { return s.len; }

struct O { k; }
fn O_m(self: *O, s: Str): i64 { return str_len(s) + self.k; }

fn gg<T>(x: T): i64 { return str_len(x); }

struct W { s: Str; n; }

#derive(Serialize)
struct Rec { name: Str; n; }

var gt: Str = Str { "abcdefg", 7 };
var GQ: Str = Str { "a\"b", 3 };
var GH: Str = 0;
var G_DEF = 0;
var GA: Str = 0;                       # a Str handle global (set at top level)
var gi: Str = Str { "zz", 2 };         # an inline Str global the h_ginl row copies into
var gi2: Str = Str { "zz", 2 };        # ... and the top-level rows
var gi3: Str = Str { "zz", 2 };
var GPS: *Str = 0;                     # a `*Str` global the pa_* rows assign (6.7.15, D16)
# ── top level: `var H: Str = gz;` is a handle to gz's header in the declaration zone and after the first statement
#    (6.7.14, D21 (a)); `var P: *Str = gz;` takes the same address; an untyped `var U = gz;` keeps the word (D22 (b))
var gz: Str = Str { "abcdefg", 7 };
var HZ: Str = gz;
var HZ2: Str = ((gz));
var HZ3: Str = gz;
var PZ: *Str = gz;
var UZ = gz;
var GWZ: W = W { *PZ, 1 };   # a zone literal: `*PZ` into a `Str` field is PZ, gz's header (6.7.16)
# ── gb declared BELOW the handle binds too: its address is static (6.7.15, D17; refused "cannot copy-init" before)
var HB: Str = gb;
var HB2: Str = ((gb));
var PB: *Str = gb;
var gb: Str = Str { "abcdefg", 7 };

# ── the filed table (issues/archived/2026-10-12-inline-str-local-passed-to-str-param-wrong-value.md) ──────────────────
fn t_call(): i64 { var t: Str = Str { "abcdefg", 7 }; return f(t); }
fn t_paren(): i64 { var t: Str = Str { "abcdefg", 7 }; return f((t)); }
fn t_stdlib(): i64 { var t: Str = Str { "abcdefg", 7 }; return str_len(t); }
fn t_second(): i64 { var t: Str = Str { "abcdefg", 7 }; return f2(30, t); }
fn t_global(): i64 { return f(gt); }
fn t_decl(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = t; return f(h); }
fn t_asg(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = str_from("zz"); h = t; return f(h); }
fn t_amp(): i64 { var t: Str = Str { "abcdefg", 7 }; return f(&t); }
fn t_field(): i64 { var t: Str = Str { "abcdefg", 7 }; return t.len; }
fn t_ctl(): i64 { var u: U = U { "abc", 37 }; return gu(u); }
fn t_untyped(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = t; return f(h); }

# ── not a tail call: the value inside an expression ─────────────────────────────────────────────────────────
fn t_twice(): i64 { var t: Str = Str { "abcdefg", 7 }; var r = f(t) + f((t)); return r; }
fn t_data(): i64 { var t: Str = Str { "xyz", 3 }; var r = fd(t); return r; }

# ── `var h: Str = t;`, `var h = t;`, `h = t;` bind a handle to t's header (no copy) ─────────────────────────
fn b_decl(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = t; h.len = 3; return t.len * 10 + f(h); }
fn b_untyped(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = t; h.len = 3; return t.len * 10 + str_len(h); }
fn b_asg(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = 0; h = t; h.len = 3; return t.len * 10 + f(h); }
fn b_wrap(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = (t); var k: Str = 0; k = ((t)); return f(h) * 10 + f(k); }
fn b_param(s: Str): i64 { var t: Str = Str { "abc", 3 }; s = t; return str_len(s); }
fn b_inline(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = Str { "zz", 2 }; h = t; h.len = 3; return t.len * 10 + f(h); }
fn b_shadow(): i64 { alloc_init(); var gt: Str = str_from("zz"); return f(gt); }

# ── a bare `var t: Str;` is an inline `Str` under D7 (1) (6.7.14, D20 (a)): its header's address, bound or copied ──
fn b_bare(): i64 { var t: Str; t.data = "abc"; t.len = 3; return f(t); }
fn u_pun(): i64 { var t: Str; t = str_from("hello"); return str_len(t); }
fn u_branch(c): i64 { var t: Str; if (c == 1) { t = str_from("abc"); } else { t = str_from("de"); } return str_len(t); }
fn u_copy(): i64 { var t: Str; t = str_from("hello"); var h: Str = t; var k = t; h.len = 4; return f(t) * 10 + f(k); }
fn u_cap(): i64 { var t: Str; t = str_from("hello"); var c = || { var h: Str = t; return f(h); }; return callptr(c); }
fn u_reuse(): i64 { var t: Str = Str { "abcdefg", 7 }; return f(t); }   # a literal Str in a slot a bare one used

# ── `t = a`, an inline `Str` <- a `Str` handle, copies a's header (6.7.14, D20 (a)) ──────────────────────────
fn gs<T>(x: T): Str { return str_from("abcde"); }
fn h_len(): i64 { var a = str_from("abcde"); var t: Str; t = a; return t.len; }
fn h_copy(): i64 { var a = str_from("abcde"); var t: Str; t = a; a.len = 2; return t.len * 10 + str_len(a); }
fn h_row3(): i64 { var t: Str; t = str_from("hello"); var h: Str = Str { "zz", 2 }; h = t; return str_len(h); }
fn h_lit(): i64 { var a = str_from("abcde"); var t: Str = Str { "zz", 2 }; t = a; return t.len * 10 + f(t); }
fn h_param(s: Str): i64 { var t: Str; t = s; return t.len * 10 + f(t); }
fn h_global(): i64 { var t: Str = Str { "zz", 2 }; t = GA; return t.len * 10 + f(t); }
fn h_call(): i64 { var t: Str = Str { "zz", 2 }; t = str_from("abcde"); return t.len * 10 + f(t); }
fn h_gen(): i64 { var t: Str = Str { "zz", 2 }; t = gs<i64>(1); return t.len * 10 + f(t); }
fn h_meth(): i64 { var h = str_from("abcde"); var t: Str; t = h.clone(); var u: Str; u = h.sub(1, 3); return t.len * 10 + f(u); }
fn h_field(): i64 { var w: W = W { str_from("abcde"), 1 }; var t: Str; t = w.s; return t.len * 10 + f(t); }
fn h_fieldp(): i64 { var p: *W = new_w(); p.s = str_from("abcde"); var t: Str; t = p.s; return t.len * 10 + f(t); }
fn h_wrap(): i64 { var a = str_from("abcde"); var t: Str; t = (a); var u: Str; u = ((str_from("xyz"))); return t.len * 10 + f(u); }
fn h_step(): i64 { var a = str_from("abcde"); var t: Str; var i = 0; for (i = 0; i < 1; t = a) { i = i + 1; } return t.len * 10 + f(t); }
fn h_cap(): i64 { var a = str_from("abcde"); var c = || { var t: Str = Str { "zz", 2 }; t = a; return t.len * 10 + f(t); }; return callptr(c); }
fn h_ginl(): i64 { var a = str_from("abcde"); gi = a; a.len = 1; return gi.len * 10 + f(gi); }

# ── a `Str` method's operand (lib/str.cyr types it since 6.7.14, D18 (c)) and a `*Str` declaration take the header ──
fn q_eq(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = str_from("abcdefg"); return h.eq(t); }
fn q_cat(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = str_from("abcdefg"); return str_len(h.cat(t)); }
fn q_has(): i64 {
    var n: Str = Str { "cde", 3 };
    var p: Str = Str { "abc", 3 };
    var s: Str = Str { "efg", 3 };
    var h = str_from("abcdefg");
    return h.contains(n) * 100 + h.starts_with(p) * 10 + h.ends_with(s);
}
fn q_not(): i64 { var t: Str = Str { "abcdefz", 7 }; var x: Str = Str { "xyz", 3 }; var h = str_from("abcdefg"); return h.eq(t) + h.contains(x) + h.starts_with(x) + h.ends_with(x); }
fn q_glob(): i64 { var h = str_from("abcdefg"); return h.eq(gt) * 10 + h.contains(gt); }
fn q_lit(): i64 { var h = str_from("abcdefg"); return h.eq("abcdefg") * 1000 + h.contains("cde") * 100 + h.starts_with("abc") * 10 + h.ends_with("efg"); }
fn q_catl(): i64 { var h = str_from("abcdefg"); return str_len(h.cat("xy")); }
fn q_ptr(): i64 { var t: Str = Str { "abcdefg", 7 }; var p: *Str = t; p.len = 3; return t.len * 10 + str_len(p); }
fn q_pglob(): i64 { var p: *Str = gt; var q: *Str = (gt); return str_len(p) * 10 + str_len(q); }
fn q_pbare(): i64 { var t: Str; t = str_from("abcde"); var p: *Str = (t); p.len = 2; return t.len; }
fn q_pcap(): i64 { var t: Str = Str { "abcdefg", 7 }; var c = || { var p: *Str = t; return str_len(p); }; return callptr(c); }

# ── `t = p` / `t = *p` with p a `*Str` copy the header p points at into an inline `Str` (6.7.15, D14) ───────────────
var gi4: Str = Str { "zz", 2 };        # an inline Str global the ps_* rows copy into
fn ps_name(): i64 { var a = str_from("abcde"); var p: *Str = a; var t: Str = Str { "zz", 2 }; t = p; a.len = 1; return t.len * 10 + f(t); }
fn ps_deref(): i64 { var a = str_from("abcde"); var p: *Str = a; var t: Str = Str { "zz", 2 }; t = *p; a.len = 1; return t.len * 10 + f(t); }
fn ps_bare(): i64 { var a = str_from("abcde"); var p: *Str = a; var t: Str; t = p; var u: Str; u = *p; return t.len * 10 + f(u); }
fn ps_global(): i64 { var a = str_from("abcde"); var p: *Str = a; gi4 = p; var r = gi4.len * 10; gi4.len = 2; gi4 = *p; r = r + f(gi4); gi4.len = 2; return r; }
fn ps_param(p: *Str): i64 { var t: Str = Str { "zz", 2 }; t = p; var u: Str; u = *p; return t.len * 10 + f(u); }
fn ps_gsrc(): i64 { var a = str_from("abcde"); GPS = a; var t: Str; t = GPS; var u: Str; u = *GPS; GPS = 0; return t.len * 10 + f(u); }
fn ps_step(): i64 { var a = str_from("abcde"); var p: *Str = a; var t: Str; var u: Str; var i = 0; for (i = 0; i < 1; t = p) { i = i + 1; } for (i = 0; i < 1; u = *p) { i = i + 1; } return t.len * 10 + f(u); }
fn ps_wrap(): i64 { var a = str_from("abcde"); var p: *Str = a; var t: Str; t = (p); var u: Str; u = (*p); var v: Str; v = *(p + 0); return t.len * 100 + u.len * 10 + v.len; }
fn ps_chain(): i64 { var a = str_from("abcde"); var p: *Str = a; var pp: **Str = &p; var w: WP = WP { a, 1 }; GPS = a; var t: Str; t = **pp; var u: Str; u = *w.p; var v: Str; v = *gsp(); GPS = 0; return t.len * 100 + u.len * 10 + v.len; }
fn ps_cap(): i64 { var a = str_from("abcde"); var p: *Str = a; var c = || { var t: Str = Str { "zz", 2 }; t = p; var u: Str; u = *p; return t.len * 10 + f(u); }; return callptr(c); }
fn ps_inl(): i64 { var t: Str = Str { "zz", 2 }; var p: *Str = t; var u: Str; u = *p; t.len = 1; return u.len; }

# ── `t = *pp` with pp a `**Str` (so `*pp` is a `*Str`) copies the header into an inline `Str` too (6.7.16) ─────────
var GPPS: **Str = &GPS;                # a `**Str` global the pps_* rows read through
fn gpps(): **Str { return &GPS; }
struct WPP { pp: **Str; n; }
fn pps_local(): i64 { var a = str_from("abcde"); var p: *Str = a; var pp: **Str = &p; var t: Str = Str { "zz", 2 }; t = *pp; a.len = 1; return t.len * 10 + f(t); }
fn pps_bare(): i64 { var a = str_from("abcde"); var p: *Str = a; var pp: **Str = &p; var t: Str; t = *pp; a.len = 1; return t.len * 10 + f(t); }
fn pps_global(): i64 { var a = str_from("abcde"); var p: *Str = a; var pp: **Str = &p; gi4 = *pp; a.len = 1; var r = gi4.len * 10 + f(gi4); gi4.len = 2; return r; }
fn pps_step(): i64 { var a = str_from("abcde"); var p: *Str = a; var pp: **Str = &p; var t: Str = Str { "zz", 2 }; var i = 0; for (i = 0; i < 1; t = *pp) { i = i + 1; } a.len = 1; return t.len * 10 + f(t); }
fn pps_wrap(): i64 { var a = str_from("abcde"); var p: *Str = a; var pp: **Str = &p; var t: Str; t = (*pp); var u: Str; u = *(pp); var v: Str; v = ((*pp)); var w: Str; w = *(pp + 0); a.len = 1; return t.len * 1000 + u.len * 100 + v.len * 10 + w.len; }
fn pps_param(pp: **Str): i64 { var t: Str = Str { "zz", 2 }; t = *pp; return t.len * 10 + f(t); }
fn pps_param_c(): i64 { var a = str_from("abcde"); var p: *Str = a; return pps_param(&p); }
fn pps_chain(): i64 { var a = str_from("abcde"); GPS = a; var p: *Str = a; var pp: **Str = &p; var ppp: ***Str = &pp; var w: WPP = WPP { pp, 1 }; var t: Str; t = *GPPS; var u: Str; u = *gpps(); var v: Str; v = *w.pp; var x: Str; x = **ppp; GPS = 0; a.len = 1; return t.len * 1000 + u.len * 100 + v.len * 10 + x.len; }
fn pps_cap(): i64 { var a = str_from("abcde"); var p: *Str = a; var pp: **Str = &p; var c = || { var t: Str = Str { "zz", 2 }; t = *pp; return t.len * 10 + f(t); }; return callptr(c); }
fn pps_inl(): i64 { var t: Str = Str { "abc", 3 }; var p: *Str = t; var pp: **Str = &p; var u: Str = Str { "q", 9 }; u = *pp; t.len = 1; return u.len * 10 + f(u); }
fn pps_rebind(): i64 { var a = str_from("abcde"); var b = str_from("xy"); var p: *Str = a; var pp: **Str = &p; var q: *Str = b; q = *pp; a.len = 3; return (q == p) * 100 + str_len(q) * 10 + str_len(b); }
fn pps_handle(): i64 { var a = str_from("abcde"); var p: *Str = a; var pp: **Str = &p; var h = str_from("xy"); h = *pp; a.len = 3; return (h == p) * 100 + str_len(h); }

# ── an inline `Str` ASSIGNED into a `*Str` takes its header's address, as the declaration does (6.7.15, D16) ──────
fn pa_local(): i64 { var t: Str = Str { "abcdefg", 7 }; var p: *Str = 0; p = t; p.len = 3; return t.len * 10 + str_len(p); }
fn pa_gt(): i64 { var p: *Str = 0; p = gt; return str_len(p); }
fn pa_gp(): i64 { GPS = gt; var r = str_len(GPS); GPS = 0; return r; }
fn pa_param(p: *Str): i64 { var t: Str = Str { "abcde", 5 }; p = t; return str_len(p); }
fn pa_wrap(): i64 { var t: Str = Str { "abcdefg", 7 }; var p: *Str = 0; p = (t); var q: *Str = 0; q = ((gt)); return str_len(p) * 10 + str_len(q); }
fn pa_step(): i64 { var t: Str = Str { "abcdefg", 7 }; var p: *Str = 0; var i = 0; for (i = 0; i < 1; p = t) { i = i + 1; } return str_len(p); }
# ── an inline `Str` into a `*Str` FIELD or through a `**Str` takes its header's address (6.7.16, D19) ─────────────
struct WS { p: *Str; n; }
struct OS { w: WS; pw: *WS; }
var GWS: WS = WS { 0, 0 };
var GWSZ: WS = WS { gz, 1 };          # a zone literal's `*Str` element: gz's header (6.7.16, D19)
var GWSZN: WS = WS { n: 2, p: gz };   # ... named
var PPZ: **Str = &PZ;
var UZPP: Str = *PPZ;                 # a zone `Str` declaration from `*pp` of a `**Str` global: a copy (6.7.16, D74)
var VZP: Str = PZ;                    # ... from a `*Str` global's name: a copy (6.7.16, D18 (a))
var GYZS: *Str = *PZ;                 # a zone `*Str` declaration from `*PZ` is PZ (6.7.16, D73)
var HAZ: Str = *(&gz);                # a zone `var H: Str = *(&gz);` is a handle on gz, as `= gz` is (6.7.16, D71)
var HAZ2: Str = *((&gz));
var PAZ: *Str = *&gz;
fn mkws(): *WS { return &GWS; }
fn pa_fld_local(): i64 { var w: WS = WS { 0, 1 }; w.p = gt; return str_len(w.p); }
fn pa_fld_global(): i64 { GWS.p = gt; var r = str_len(GWS.p); GWS.p = 0; return r; }
fn pa_fld_ptr(): i64 { var w: WS = WS { 0, 1 }; var pw: *WS = &w; pw.p = gt; return str_len(w.p); }
fn pa_fld_nest(): i64 { var w0: WS = WS { 0, 1 }; var o: OS = OS { w0, &w0 }; o.w.p = gt; o.pw.p = (gt); return str_len(o.w.p) * 10 + str_len(w0.p); }
fn pa_fld_call(): i64 { mkws().p = gt; var r = str_len(GWS.p); GWS.p = 0; return r; }
fn pa_fld_step(): i64 { var w: WS = WS { 0, 1 }; var i = 0; for (i = 0; i < 1; w.p = gt) { i = i + 1; } return str_len(w.p); }
fn pa_fld_bind(): i64 { var w: WS = WS { 0, 1 }; w.p = gt; w.p.len = 3; var r = gt.len; gt.len = 7; return r; }
