# inline_str_value.tcyr — 6.7.13 (the user's decision D7 (1), 2026-10-15) — an INLINE `Str` is its header's
# address wherever a `Str` value is taken.
#
# A `Str` is a heap handle by name: its slot holds the address of a 16-byte `{ data; len; }` header. A
# `Str { p, n }` literal is an INLINE header on the frame, whose slot is field 0 — and every
# use of the bare name as a `Str` value took that slot, the `data` word, as the header: `f(t)` into `s: Str`
# read the length out of whatever followed the string (the filed repro exited 0 where 7 is right, on every
# target; issues/archived/2026-10-12-inline-str-local-passed-to-str-param-wrong-value.md). Now `f(t)`, `f((t))`,
# `str_len(t)`, a method's `Str` parameter, `var h: Str = t;`, `var h = t;` and `h = t;` into a handle take the
# header's address, with no allocation: `&t` for a local (so `h` is a second handle to t's header), the static
# address for an inline global, the environment copy's address for a closure's capture. The uses that would let
# a frame's header outlive the frame are refused by name (tests/gates/frontend/inline_str_value.sh): `return t;`
# from a fn returning `Str`, a store into a `Str` global, a `Str` field or through a `*Str`. A global's address
# is static and a capture is a copy in the closure's environment, so neither is refused: those rows are here.
# Since 6.7.14 (the user's decision D20 (a), 2026-10-16) a bare `var t: Str;` is an inline `Str` under D7 (1) too
# (the b_bare / u_* rows), and `t = a` — an inline `Str` <- a `Str` HANDLE: a local, a parameter, a global, a
# call or method declared `: Str`, a `Str` field — copies the header a points at (the h_* rows), as `t = u`
# between two inline `Str`s does: through 6.7.13 it stored a's address into t.data and left t.len stale (6.6.16's
# pun, which `str_len(t)` read back through t.data for a bare t). An untyped source keeps the one-word store
# (tests/gates/frontend/inline_str_value.sh K8).
#
# CROSS-HOST: the address is EFLADDR / EVADDR on each backend, the tail-call rows check that a frame address
# laundered through a handle diverts the `jmp` (`_fn_local_addr`). Run on ecb / ach (Mach-O), cass (PE) and pi
# (aarch64) by the release gate.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/io.cyr"
include "lib/bayan.cyr"
include "lib/assert.cyr"

fn f(s: Str): i64 { return str_len(s); }
fn f2(k, s: Str): i64 { return str_len(s) + k; }
fn fd(s: Str): i64 { return load8(str_data(s)); }

struct U { data; len; }
fn gu(s: U): i64 { return s.len; }

struct O { k; }
fn O_m(self: *O, s: Str): i64 { return str_len(s) + self.k; }

fn gg<T>(x: T): i64 { return str_len(x); }

struct W { s: Str; n; }

#derive(Serialize)
struct Rec { name: Str; n; }

var gt: Str = Str { "abcdefg", 7 };
var GQ: Str = Str { "a\"b", 3 };
var GH: Str = 0;
var G_DEF = 0;
var GA: Str = 0;                       # a Str handle global (set at top level)
var gi: Str = Str { "zz", 2 };         # an inline Str global the h_ginl row copies into
var gi2: Str = Str { "zz", 2 };        # ... and the top-level rows
var gi3: Str = Str { "zz", 2 };
# ── top level: `var H: Str = gz;` is a handle to gz's header in the declaration zone and after the first statement
#    (6.7.14, D21 (a)); `var P: *Str = gz;` takes the same address; an untyped `var U = gz;` keeps the word (D22 (b))
var gz: Str = Str { "abcdefg", 7 };
var HZ: Str = gz;
var HZ2: Str = ((gz));
var HZ3: Str = gz;
var PZ: *Str = gz;
var UZ = gz;
# ── gb declared BELOW the handle binds too: its address is static (6.7.15, D17; refused "cannot copy-init" before)
var HB: Str = gb;
var HB2: Str = ((gb));
var PB: *Str = gb;
var gb: Str = Str { "abcdefg", 7 };

# ── the filed table (issues/archived/2026-10-12-inline-str-local-passed-to-str-param-wrong-value.md) ──────────────────
fn t_call(): i64 { var t: Str = Str { "abcdefg", 7 }; return f(t); }
fn t_paren(): i64 { var t: Str = Str { "abcdefg", 7 }; return f((t)); }
fn t_stdlib(): i64 { var t: Str = Str { "abcdefg", 7 }; return str_len(t); }
fn t_second(): i64 { var t: Str = Str { "abcdefg", 7 }; return f2(30, t); }
fn t_global(): i64 { return f(gt); }
fn t_decl(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = t; return f(h); }
fn t_asg(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = str_from("zz"); h = t; return f(h); }
fn t_amp(): i64 { var t: Str = Str { "abcdefg", 7 }; return f(&t); }
fn t_field(): i64 { var t: Str = Str { "abcdefg", 7 }; return t.len; }
fn t_ctl(): i64 { var u: U = U { "abc", 37 }; return gu(u); }
fn t_untyped(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = t; return f(h); }

# ── not a tail call: the value inside an expression ─────────────────────────────────────────────────────────
fn t_twice(): i64 { var t: Str = Str { "abcdefg", 7 }; var r = f(t) + f((t)); return r; }
fn t_data(): i64 { var t: Str = Str { "xyz", 3 }; var r = fd(t); return r; }

# ── `var h: Str = t;`, `var h = t;`, `h = t;` bind a handle to t's header (no copy) ─────────────────────────
fn b_decl(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = t; h.len = 3; return t.len * 10 + f(h); }
fn b_untyped(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = t; h.len = 3; return t.len * 10 + str_len(h); }
fn b_asg(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = 0; h = t; h.len = 3; return t.len * 10 + f(h); }
fn b_wrap(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = (t); var k: Str = 0; k = ((t)); return f(h) * 10 + f(k); }
fn b_param(s: Str): i64 { var t: Str = Str { "abc", 3 }; s = t; return str_len(s); }
fn b_inline(): i64 { var t: Str = Str { "abcdefg", 7 }; var h: Str = Str { "zz", 2 }; h = t; h.len = 3; return t.len * 10 + f(h); }
fn b_shadow(): i64 { alloc_init(); var gt: Str = str_from("zz"); return f(gt); }

# ── a bare `var t: Str;` is an inline `Str` under D7 (1) (6.7.14, D20 (a)): its header's address, bound or copied ──
fn b_bare(): i64 { var t: Str; t.data = "abc"; t.len = 3; return f(t); }
fn u_pun(): i64 { var t: Str; t = str_from("hello"); return str_len(t); }
fn u_branch(c): i64 { var t: Str; if (c == 1) { t = str_from("abc"); } else { t = str_from("de"); } return str_len(t); }
fn u_copy(): i64 { var t: Str; t = str_from("hello"); var h: Str = t; var k = t; h.len = 4; return f(t) * 10 + f(k); }
fn u_cap(): i64 { var t: Str; t = str_from("hello"); var c = || { var h: Str = t; return f(h); }; return callptr(c); }
fn u_reuse(): i64 { var t: Str = Str { "abcdefg", 7 }; return f(t); }   # a literal Str in a slot a bare one used

# ── `t = a`, an inline `Str` <- a `Str` handle, copies a's header (6.7.14, D20 (a)) ──────────────────────────
fn gs<T>(x: T): Str { return str_from("abcde"); }
fn h_len(): i64 { var a = str_from("abcde"); var t: Str; t = a; return t.len; }
fn h_copy(): i64 { var a = str_from("abcde"); var t: Str; t = a; a.len = 2; return t.len * 10 + str_len(a); }
fn h_row3(): i64 { var t: Str; t = str_from("hello"); var h: Str = Str { "zz", 2 }; h = t; return str_len(h); }
fn h_lit(): i64 { var a = str_from("abcde"); var t: Str = Str { "zz", 2 }; t = a; return t.len * 10 + f(t); }
fn h_param(s: Str): i64 { var t: Str; t = s; return t.len * 10 + f(t); }
fn h_global(): i64 { var t: Str = Str { "zz", 2 }; t = GA; return t.len * 10 + f(t); }
fn h_call(): i64 { var t: Str = Str { "zz", 2 }; t = str_from("abcde"); return t.len * 10 + f(t); }
fn h_gen(): i64 { var t: Str = Str { "zz", 2 }; t = gs<i64>(1); return t.len * 10 + f(t); }
fn h_meth(): i64 { var h = str_from("abcde"); var t: Str; t = h.clone(); var u: Str; u = h.sub(1, 3); return t.len * 10 + f(u); }
fn h_field(): i64 { var w: W = W { str_from("abcde"), 1 }; var t: Str; t = w.s; return t.len * 10 + f(t); }
fn h_fieldp(): i64 { var p: *W = new_w(); p.s = str_from("abcde"); var t: Str; t = p.s; return t.len * 10 + f(t); }
fn h_wrap(): i64 { var a = str_from("abcde"); var t: Str; t = (a); var u: Str; u = ((str_from("xyz"))); return t.len * 10 + f(u); }
fn h_step(): i64 { var a = str_from("abcde"); var t: Str; var i = 0; for (i = 0; i < 1; t = a) { i = i + 1; } return t.len * 10 + f(t); }
fn h_cap(): i64 { var a = str_from("abcde"); var c = || { var t: Str = Str { "zz", 2 }; t = a; return t.len * 10 + f(t); }; return callptr(c); }
fn h_ginl(): i64 { var a = str_from("abcde"); gi = a; a.len = 1; return gi.len * 10 + f(gi); }

# ── a `Str` method's operand (lib/str.cyr types it since 6.7.14, D18 (c)) and a `*Str` declaration take the header ──
fn q_eq(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = str_from("abcdefg"); return h.eq(t); }
fn q_cat(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = str_from("abcdefg"); return str_len(h.cat(t)); }
fn q_has(): i64 {
    var n: Str = Str { "cde", 3 };
    var p: Str = Str { "abc", 3 };
    var s: Str = Str { "efg", 3 };
    var h = str_from("abcdefg");
    return h.contains(n) * 100 + h.starts_with(p) * 10 + h.ends_with(s);
}
fn q_not(): i64 { var t: Str = Str { "abcdefz", 7 }; var x: Str = Str { "xyz", 3 }; var h = str_from("abcdefg"); return h.eq(t) + h.contains(x) + h.starts_with(x) + h.ends_with(x); }
fn q_glob(): i64 { var h = str_from("abcdefg"); return h.eq(gt) * 10 + h.contains(gt); }
fn q_lit(): i64 { var h = str_from("abcdefg"); return h.eq("abcdefg") * 1000 + h.contains("cde") * 100 + h.starts_with("abc") * 10 + h.ends_with("efg"); }
fn q_catl(): i64 { var h = str_from("abcdefg"); return str_len(h.cat("xy")); }
fn q_ptr(): i64 { var t: Str = Str { "abcdefg", 7 }; var p: *Str = t; p.len = 3; return t.len * 10 + str_len(p); }
fn q_pglob(): i64 { var p: *Str = gt; var q: *Str = (gt); return str_len(p) * 10 + str_len(q); }
fn q_pbare(): i64 { var t: Str; t = str_from("abcde"); var p: *Str = (t); p.len = 2; return t.len; }
fn q_pcap(): i64 { var t: Str = Str { "abcdefg", 7 }; var c = || { var p: *Str = t; return str_len(p); }; return callptr(c); }

fn z_bind(): i64 { HZ.len = 3; var r = gz.len; gz.len = 7; return r; }
fn z_wrap(): i64 { return f(HZ2) * 10 + str_len(PZ); }
fn z_word(): i64 { if (UZ == load64(&gz)) { return 1; } return 0; }
fn z_rebind(): i64 { HZ3 = str_from("xy"); return f(HZ3) * 10 + gz.len; }
fn z_below(): i64 { HB.len = 3; var r = gb.len * 100 + f(HB2) * 10 + str_len(PB); gb.len = 7; return r; }

# ── a global inline `Str`: its static address, wherever it goes ─────────────────────────────────────────────
fn mkg(): Str { return gt; }
fn mkgp(): Str { return (gt); }
fn g_ret(): i64 { var h = mkg(); return f(h) * 10 + f(mkgp()); }
fn g_decl(): i64 { var h: Str = gt; var k = gt; return f(h) * 10 + f(k); }
fn g_bind(): i64 { var h: Str = gt; h.len = 3; var r = gt.len; gt.len = 7; return r; }
fn g_store(): i64 { GH = gt; return f(GH); }
fn g_field(): i64 { var w: W = W { gt, 1 }; var w2: W = W { 0, 2 }; w2.s = gt; return f(w.s) * 10 + f(w2.s); }
fn new_w(): *W { return alloc(sizeof(W)); }
fn new_slot(): *Str { return alloc(8); }
fn g_heap(): i64 { var p: *W = new_w(); p.s = gt; var ps: *Str = new_slot(); *ps = gt; return f(p.s) * 10 + f(load64(ps)); }

# ── methods, generics, overloads ────────────────────────────────────────────────────────────────────────────
fn m_self(): i64 { var t: Str = Str { "abcdefg", 7 }; return t.len(); }
fn m_arg(): i64 { var o: O = O { 30 }; var t: Str = Str { "abcdefg", 7 }; return o.m(t); }
fn m_gen(): i64 { var t: Str = Str { "abcdefg", 7 }; return gg(t) * 10 + gg<Str>(t); }
fn m_strlen(): i64 { var t: Str = Str { "abcdefg", 7 }; return strlen(t); }
fn m_cat(): i64 { var t: Str = Str { "abc", 3 }; var u = str_cat(t, t); return str_len(u); }
fn fp(p: *Str): i64 { return str_len(p); }
fn m_ptr(): i64 { var t: Str = Str { "abcdefg", 7 }; return fp(t) * 10 + fp(gt); }
fn m_eq(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = str_from("abcdefg"); return str_eq(h, t) * 10 + str_eq(t, h); }

# ── closures and defer: the capture is a copy in the environment, a defer runs in the frame ─────────────────
fn c_cap(): i64 { var t: Str = Str { "abcdefg", 7 }; var c = || { return f(t); }; return callptr(c); }
fn mkc() { var t: Str = Str { "abcdefg", 7 }; return || { return f(t); }; }
fn smash(a, b, c, d): i64 { var x: i64[16]; var i = 0; while (i < 16) { x[i] = 0 - 1; i = i + 1; } return a + b + c + d + x[3]; }
fn c_escape(): i64 { var c = mkc(); smash(1, 2, 3, 4); return callptr(c); }
fn c_bindcap(): i64 {
    var t: Str = Str { "abcdefg", 7 };
    var c = || { var h: Str = t; h.len = 3; return str_len(t); };
    return callptr(c) * 10 + t.len;
}
fn c_own(): i64 { var c = || { var t: Str = Str { "abcdefg", 7 }; return f(t); }; return callptr(c); }
fn d_body(): i64 { var t: Str = Str { "abcdefg", 7 }; defer { G_DEF = f(t); } return 0; }
fn d_defer(): i64 { d_body(); return G_DEF; }

# ── the encoder that found it: a `Str` field encoded from an inline `Str` ───────────────────────────────────
fn e_json(): i64 {
    var t: Str = Str { "a\"b", 3 };
    var sb = str_builder_new();
    str_builder_add_json_str(sb, t);
    var s = str_builder_build(sb);
    if (str_len(s) != 6) { return 0 - str_len(s); }
    return memeq(str_data(s), "\"a\\\"b\"", 6);
}
fn e_derive(): i64 {
    var r: Rec = Rec { GQ, 5 };
    var sb = str_builder_new();
    Rec_to_json(&r, sb);
    var s = str_builder_build(sb);
    var want = "{\"name\":\"a\\\"b\",\"n\":5}";
    if (str_len(s) != strlen(want)) { return 0 - str_len(s); }
    return memeq(str_data(s), want, strlen(want));
}

alloc_init();
var R_TOP = f(gt);   # at top level, a global inline `Str`
GA = str_from("abcde");
gi2 = GA;                    # at top level: an inline Str global <- a Str handle global
var R_TOP2 = gi2.len * 10 + f(gi2);
gi3 = str_from("xyz");       # ... <- a `: Str` call
var R_TOP3 = gi3.len * 10 + f(gi3);
var P_TOP: *Str = gt;        # a `*Str` declaration after the first statement: gt's static address (D18 (c))
var R_TOP4 = str_len(P_TOP);
var HL: Str = gz;            # after the first statement: a handle to gz's header (D21 (a))
HL.len = 4;
var R_TOP5 = gz.len;
gz.len = 7;
var UL = gz;                 # an untyped top-level declaration keeps gz's first word (D22 (b))
var R_TOP6 = 0;
if (UL == load64(&gz)) { R_TOP6 = 1; }

assert_eq(t_call(), 7, "f(t) passes t's header (the filed repro)");
assert_eq(t_paren(), 7, "f((t))");
assert_eq(t_stdlib(), 7, "str_len(t), a stdlib `s: Str` parameter");
assert_eq(t_second(), 37, "f(30, t), t second");
assert_eq(t_global(), 7, "f(gt), an inline global");
assert_eq(t_decl(), 7, "var h: Str = t; f(h)");
assert_eq(t_asg(), 7, "h = t into a handle; f(h)");
assert_eq(t_amp(), 7, "f(&t), the workaround, unchanged");
assert_eq(t_field(), 7, "t.len, unchanged");
assert_eq(t_ctl(), 37, "a user struct U { data; len; } control, unchanged");
assert_eq(t_untyped(), 7, "var h = t; f(h)");
assert_eq(t_twice(), 14, "f(t) + f((t)) inside an expression");
assert_eq(t_data(), 120, "str_data(t) reads t's data ('x')");
assert_eq(b_decl(), 33, "var h: Str = t binds: h.len = 3 writes t's header");
assert_eq(b_untyped(), 33, "var h = t binds as the annotated form does");
assert_eq(b_asg(), 33, "h = t rebinds h to t's header");
assert_eq(b_wrap(), 77, "var h: Str = (t); k = ((t))");
assert_eq(b_param(str_from("zzzzz")), 3, "s = t rebinds a by-value Str parameter");
assert_eq(b_inline(), 73, "h = t between two inline Strs copies the header (h is its own)");
assert_eq(b_shadow(), 2, "a local handle named gt shadows the global: its own word");
assert_eq(b_bare(), 3, "var t: Str; (inline, no literal) passes its header (D20 (a))");
assert_eq(u_pun(), 5, "var t: Str; t = a; str_len(t) reads t's own header, a's copied");
assert_eq(u_branch(1), 3, "var t: Str; assigned in one branch (then)");
assert_eq(u_branch(0), 2, "var t: Str; assigned in one branch (else)");
assert_eq(u_copy(), 44, "var h: Str = t; / var k = t; of a bare t bind its header (h.len = 4 writes t.len)");
assert_eq(u_cap(), 5, "var h: Str = t; of a captured bare t binds the environment's copy");
assert_eq(u_reuse(), 7, "a literal Str in a slot an earlier fn's bare Str used");
assert_eq(h_len(), 5, "var t: Str; t = a; t.len is a's length (the pun left it unwritten)");
assert_eq(h_copy(), 52, "t = a is a copy: a write to a leaves t");
assert_eq(h_row3(), 5, "t = str_from(..); h = t between inline Strs: h has t's header");
assert_eq(h_lit(), 55, "a literal-declared inline Str <- a Str handle local");
assert_eq(h_param(str_from("abcde")), 55, "<- a `s: Str` parameter");
assert_eq(h_global(), 55, "<- a Str handle global");
assert_eq(h_call(), 55, "<- a `: Str` call");
assert_eq(h_gen(), 55, "<- a generic `: Str` call");
assert_eq(h_meth(), 53, "<- a method's `: Str` result (h.clone(), h.sub(1, 3))");
assert_eq(h_field(), 55, "<- a `Str` field of a local");
assert_eq(h_fieldp(), 55, "<- a `Str` field through a `*W`");
assert_eq(h_wrap(), 53, "t = (a); u = ((str_from(..)))");
assert_eq(h_step(), 55, "a for step t = a");
assert_eq(h_cap(), 55, "a closure's own inline Str <- a captured Str handle");
assert_eq(h_ginl(), 55, "an inline Str global <- a Str handle local (a copy: a.len = 1 after)");
assert_eq(q_eq(), 1, "h.eq(t): Str_eq's `other: Str` takes t's header (D18 (c); 0 through 6.7.13)");
assert_eq(q_cat(), 14, "h.cat(t): Str_cat's `other: Str`");
assert_eq(q_has(), 111, "h.contains(n) / h.starts_with(p) / h.ends_with(s)");
assert_eq(q_not(), 0, "the same methods answer 0 for strings that differ");
assert_eq(q_glob(), 11, "h.eq(gt) / h.contains(gt): an inline global's static address");
assert_eq(q_lit(), 1111, "a string literal into the typed methods is a Str (each was 0 through 6.7.13)");
assert_eq(q_catl(), 9, "h.cat(\"xy\") (3 through 6.7.13)");
assert_eq(q_ptr(), 33, "var p: *Str = t; takes t's header: p.len = 3 writes t.len (D18 (c))");
assert_eq(q_pglob(), 77, "var p: *Str = gt; / = (gt);");
assert_eq(q_pbare(), 2, "var p: *Str = (t); of a bare t binds its header");
assert_eq(q_pcap(), 7, "var p: *Str = t; inside a closure: the environment's copy");
assert_eq(g_ret(), 77, "return gt / return (gt) from a fn returning Str: the static address");
assert_eq(g_decl(), 77, "var h: Str = gt; var k = gt;");
assert_eq(g_bind(), 3, "var h: Str = gt binds gt's header");
assert_eq(g_store(), 7, "GH = gt into a Str global");
assert_eq(g_field(), 77, "W { gt, 1 } and w.s = gt into a Str field");
assert_eq(g_heap(), 77, "p.s = gt and *ps = gt through a pointer");
assert_eq(m_self(), 7, "t.len(): the method's self");
assert_eq(m_arg(), 37, "o.m(t): a method's `s: Str` parameter");
assert_eq(m_gen(), 77, "gg(t) and gg<Str>(t), T = Str");
assert_eq(m_strlen(), 7, "strlen(t) routes to the Str overload");
assert_eq(m_cat(), 6, "str_cat(t, t)");
assert_eq(m_eq(), 11, "str_eq(h, t) and str_eq(t, h)");
assert_eq(m_ptr(), 77, "fp(t) / fp(gt) into a `p: *Str` parameter: the header's address, as `fp(&t)`");
assert_eq(c_cap(), 7, "a closure capturing t: f(t) inside");
assert_eq(c_escape(), 7, "a closure returned out of t's frame: its copy survives");
assert_eq(c_bindcap(), 37, "var h: Str = t inside a closure binds the closure's copy");
assert_eq(c_own(), 7, "an inline Str local of a closure body");
assert_eq(d_defer(), 7, "f(t) in a defer, in t's frame");
assert_eq(e_json(), 1, "str_builder_add_json_str(sb, t) encodes \"a\\\"b\"");
assert_eq(e_derive(), 1, "#derive(Serialize): a Str field from an inline global");
assert_eq(R_TOP, 7, "f(gt) at top level");
assert_eq(R_TOP2, 55, "top level: an inline Str global <- a Str handle global");
assert_eq(R_TOP3, 33, "top level: an inline Str global <- a `: Str` call");
assert_eq(R_TOP4, 7, "top level: var P: *Str = gt; (after the first statement)");
