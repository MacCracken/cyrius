fn amp_cap(): i64 { var t: Str = Str { "xyz", 3 }; var c = || { var h: Str = *(&t); var w: W = W { 0, 1 }; w.s = *(&t); GH = *(&t); var r = f(*(&t)) * 1000 + str_len(h) * 100 + str_len(w.s) * 10 + str_len(GH); GH = 0; return r; }; return callptr(c); }
fn amp_untyped(): i64 { var t: Str = Str { "xyz", 3 }; var a = fncall1(&fu1, *(&t)); var b = fu1(*(&t)); return (a == load64(&t)) * 10 + (b == load64(&t)); }
fn amp_zone(): i64 { return (HAZ == &gz) * 100 + (HAZ2 == &gz) * 10 + (PAZ == &gz); }
fn mkamp(): Str { return str_from("abcd"); }
fn amp_st(): i64 { var t: Str = Str { "xyz", 3 }; *(&t) = gt; var r = t.len; var t2: Str = Str { "xyz", 3 }; var a = str_from("abcde"); *(&t2) = a; a.len = 1; return r * 10 + t2.len; }
fn amp_st_src(): i64 { var a = str_from("abcde"); var p: *Str = a; var t: Str = Str { "xyz", 3 }; *(&t) = *p; a.len = 1; var r = t.len; *((&t)) = mkamp(); r = r * 10 + t.len; var w: W = W { str_from("uvwxyz"), 1 }; *&t = w.s; r = r * 10 + t.len; var u: Str = Str { "q", 1 }; *(&t) = *(&u); return r * 10 + t.len; }
fn amp_st_glob(): i64 { *(&gi) = gt; var r = gi.len; gi.len = 2; var i = 0; var t: Str = Str { "xyz", 3 }; for (i = 0; i < 1; *(&t) = gt) { i = i + 1; } return r * 10 + t.len; }
# ── an inline `Str` returned from a fn returning `*Str` is its header's address, as into every other `*Str` slot (6.7.16):
#    `return gt;` returned gt's data word; a frame's `return t;` is refused by name (the gate's X30 / X31) ─────────────
fn rpg0(): *Str { return gt; }
fn rpg1(): *Str { return ((gt)); }
fn rpg2(): *Str { return *(&gt); }
fn W_rpg(self: *W): *Str { return gt; }
fn rp_ret(): i64 { var w: W = W { 0, 1 }; return (rpg0() == &gt) * 1000 + (rpg1() == &gt) * 100 + (rpg2() == &gt) * 10 + (w.rpg() == &gt); }
fn rp_len(): i64 { var p: *Str = rpg0(); p.len = 3; var r = gt.len; gt.len = 7; return r * 10 + str_len(rpg1()); }

fn z_bind(): i64 { HZ.len = 3; var r = gz.len; gz.len = 7; return r; }
fn z_wrap(): i64 { return f(HZ2) * 10 + str_len(PZ); }
fn z_word(): i64 { if (UZ == load64(&gz)) { return 1; } return 0; }
fn z_rebind(): i64 { HZ3 = str_from("xy"); return f(HZ3) * 10 + gz.len; }
fn z_below(): i64 { HB.len = 3; var r = gb.len * 100 + f(HB2) * 10 + str_len(PB); gb.len = 7; return r; }

# ── a global inline `Str`: its static address, wherever it goes ─────────────────────────────────────────────
fn mkg(): Str { return gt; }
fn mkgp(): Str { return (gt); }
fn g_ret(): i64 { var h = mkg(); return f(h) * 10 + f(mkgp()); }
fn g_decl(): i64 { var h: Str = gt; var k = gt; return f(h) * 10 + f(k); }
fn g_bind(): i64 { var h: Str = gt; h.len = 3; var r = gt.len; gt.len = 7; return r; }
fn g_store(): i64 { GH = gt; return f(GH); }
fn g_field(): i64 { var w: W = W { gt, 1 }; var w2: W = W { 0, 2 }; w2.s = gt; return f(w.s) * 10 + f(w2.s); }
fn new_w(): *W { return alloc(sizeof(W)); }
fn new_slot(): *Str { return alloc(8); }
fn g_heap(): i64 { var p: *W = new_w(); p.s = gt; var ps: *Str = new_slot(); *ps = gt; return f(p.s) * 10 + f(load64(ps)); }

# ── methods, generics, overloads ────────────────────────────────────────────────────────────────────────────
fn m_self(): i64 { var t: Str = Str { "abcdefg", 7 }; return t.len(); }
fn m_arg(): i64 { var o: O = O { 30 }; var t: Str = Str { "abcdefg", 7 }; return o.m(t); }
fn m_gen(): i64 { var t: Str = Str { "abcdefg", 7 }; return gg(t) * 10 + gg<Str>(t); }
fn m_strlen(): i64 { var t: Str = Str { "abcdefg", 7 }; return strlen(t); }
fn m_cat(): i64 { var t: Str = Str { "abc", 3 }; var u = str_cat(t, t); return str_len(u); }
fn fp(p: *Str): i64 { return str_len(p); }
fn m_ptr(): i64 { var t: Str = Str { "abcdefg", 7 }; return fp(t) * 10 + fp(gt); }
fn m_eq(): i64 { var t: Str = Str { "abcdefg", 7 }; var h = str_from("abcdefg"); return str_eq(h, t) * 10 + str_eq(t, h); }

# ── closures and defer: the capture is a copy in the environment, a defer runs in the frame ─────────────────
fn c_cap(): i64 { var t: Str = Str { "abcdefg", 7 }; var c = || { return f(t); }; return callptr(c); }
fn mkc() { var t: Str = Str { "abcdefg", 7 }; return || { return f(t); }; }
fn smash(a, b, c, d): i64 { var x: i64[16]; var i = 0; while (i < 16) { x[i] = 0 - 1; i = i + 1; } return a + b + c + d + x[3]; }
fn c_escape(): i64 { var c = mkc(); smash(1, 2, 3, 4); return callptr(c); }
fn c_bindcap(): i64 {
    var t: Str = Str { "abcdefg", 7 };
    var c = || { var h: Str = t; h.len = 3; return str_len(t); };
    return callptr(c) * 10 + t.len;
}
fn c_own(): i64 { var c = || { var t: Str = Str { "abcdefg", 7 }; return f(t); }; return callptr(c); }
fn d_body(): i64 { var t: Str = Str { "abcdefg", 7 }; defer { G_DEF = f(t); } return 0; }
fn d_defer(): i64 { d_body(); return G_DEF; }

# ── the encoder that found it: a `Str` field encoded from an inline `Str` ───────────────────────────────────
fn e_json(): i64 {
    var t: Str = Str { "a\"b", 3 };
    var sb = str_builder_new();
    str_builder_add_json_str(sb, t);
    var s = str_builder_build(sb);
    if (str_len(s) != 6) { return 0 - str_len(s); }
    return memeq(str_data(s), "\"a\\\"b\"", 6);
}
fn e_derive(): i64 {
    var r: Rec = Rec { GQ, 5 };
    var sb = str_builder_new();
    Rec_to_json(&r, sb);
    var s = str_builder_build(sb);
    var want = "{\"name\":\"a\\\"b\",\"n\":5}";
    if (str_len(s) != strlen(want)) { return 0 - str_len(s); }
    return memeq(str_data(s), want, strlen(want));
}

# 6.7.17 (the user's D19, 2026-10-22): `*p` of a `*Str` as a nested struct field's element reaching a `Str` first leaf is
# p, as the direct literal `WS { *p, 1 }` stores it; it stored the header's data word (the ns_* rows, R_TOP22).
struct NsWS { s: Str; n; }
struct NsO { v: NsWS; m; }
struct NsX { o: NsO; k; }
fn ns_gp(p: *Str): *Str { return p; }
fn ns_filed(): i64 { var a = str_from("abcdefg"); var p: *Str = a; var o = NsO { *p, 1, 2 }; if (o.v.s == a) { return 10; } if (o.v.s == load64(a)) { return 50; } return 99; }
fn ns_deep(): i64 { var a = str_from("abcdefg"); var p: *Str = a; var x = NsX { *p, 1, 2, 3 }; return (x.o.v.s == a) * 1000 + x.o.v.n * 100 + x.o.m * 10 + x.k; }
fn ns_wrap(): i64 { var a = str_from("abcdefg"); var p: *Str = a; var o = NsO { (*ns_gp(p)), 4, 5 }; return str_len(o.v.s) * 10 + o.v.n; }
fn ns_glob(): i64 { var p: *Str = &gt; var o = NsO { ((*p)), 4, 5 }; return (o.v.s == &gt) * 100 + str_len(o.v.s) * 10 + o.m; }
alloc_init();
var R_TOP = f(gt);   # at top level, a global inline `Str`
GA = str_from("abcde");
gi2 = GA;                    # at top level: an inline Str global <- a Str handle global
var R_TOP2 = gi2.len * 10 + f(gi2);
gi3 = str_from("xyz");       # ... <- a `: Str` call
var R_TOP3 = gi3.len * 10 + f(gi3);
var P_TOP: *Str = gt;        # a `*Str` declaration after the first statement: gt's static address (D18 (c))
var R_TOP4 = str_len(P_TOP);
var HL: Str = gz;            # after the first statement: a handle to gz's header (D21 (a))
HL.len = 4;
var R_TOP5 = gz.len;
gz.len = 7;
var UL = gz;                 # an untyped top-level declaration keeps gz's first word (D22 (b))
var R_TOP6 = 0;
if (UL == load64(&gz)) { R_TOP6 = 1; }
GPS = gt;                    # top level: an inline Str global assigned into a `*Str` global (D16)
var R_TOP7 = str_len(GPS);
var R_TOP8 = str_len(*GPS);  # top level: a `*Str` dereference into a `Str` parameter (6.7.15)
gi4 = GPS;                   # top level: an inline Str global <- a `*Str` global (D14)
var R_TOP9 = gi4.len;
gi4.len = 2;
gi4 = *GPS;
var R_TOP10 = f(gi4);
gi4.len = 2;
gi4 = *GPPS;                 # top level: an inline Str global <- `*pp` of a `**Str` global (6.7.16)
var R_TOP11 = gi4.len * 10 + f(gi4);
gi4.len = 2;
GH = *GPS;                   # top level: a Str handle global <- `*p` of a `*Str` global rebinds it (6.7.16, D20)
var R_TOP12 = (GH == GPS) * 100 + f(GH);
GH = 0;
GWS.p = gt;                  # top level: an inline Str global into a `*Str` field of a global (6.7.16, D19)
var R_TOP13 = str_len(GWS.p);
GWS.p = 0;
*GPPS = gt;                  # top level: through a `**Str` global (6.7.16, D19)
var R_TOP14 = str_len(GPS);
GPS = gt;                    # top level: `gg<Str>(*GPS)` / `gg(*GPS)` into a generic's `x: T` at T = Str (6.7.16)
var R_TOP15 = gg<Str>(*GPS) * 10 + gg(*GPS);
GW.s = *GPS;                 # top level: `*GPS` into a `Str` field of a global is GPS (6.7.16)
var GWL: W = W { *GPS, 1 };  # ... and into a literal's `Str` field after a statement
var R_TOP16 = (GW.s == GPS) * 100 + (GWL.s == GPS) * 10 + str_len(GW.s);
GW.s = 0;
var GWSL: WS = WS { gt, 1 };  # top level after a statement: a literal's `*Str` element takes gt's header (6.7.16, D19)
var R_TOP17 = str_len(GWSL.p);
var LUPP: Str = *GPPS;        # top level after a statement: a `Str` declaration from `*GPPS` is a copy (6.7.16, D74)
var LVP: Str = (GPS);          # ... and from a `*Str` global's name (6.7.16, D18 (a))
gt.len = 1;
var R_TOP18 = LUPP.len * 10 + LVP.len;
gt.len = 7;
GPS = gt;                    # top level: `*GPS` into `*Str` slots is GPS (6.7.16, D73) — through a pointer, a global, a
var bq: *Str = str_from("xy");   #   declaration after a statement
GQS = bq;
*GQS = *GPS;
GXS = *GPS;
var LYS: *Str = *GPS;
var R_TOP19 = (load64(bq) == &gt) * 100 + (GXS == &gt) * 10 + (LYS == &gt);
GQS = 0;
GXS = 0;
GPS = 0;
var HAL: Str = *(&gt);       # top level after a statement: `*(&gt)` is gt (6.7.16, D71) — a declaration, an inline
gi4 = *(&gt);                #   Str global's copy, a handle global
GH = *&gt;
var R_TOP20 = (HAL == &gt) * 100 + gi4.len * 10 + (GH == &gt);
*(&gi3) = gt;                # top level: `*(&gi3) = gt` copies gt's header into the inline gi3, as `gi3 = gt` (6.7.16, D71)
var R_TOP21 = gi3.len;
var nsp: *Str = &gt;          # top level after a statement: `*nsp` into a nested `Str` leaf is nsp (6.7.17, D19)
var GNSO = NsO { *nsp, 4, 5 };
var R_TOP22 = (GNSO.v.s == &gt) * 100 + str_len(GNSO.v.s) * 10 + GNSO.v.n;
gi4.len = 2;
GH = 0;
GPS = 0;

assert_eq(t_call(), 7, "f(t) passes t's header (the filed repro)");
