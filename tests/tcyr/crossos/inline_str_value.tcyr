assert_eq(R_TOP6, 1, "top level after a statement: an untyped var UL = gz; keeps gz's first word (D22 (b))");
assert_eq(z_bind(), 3, "declaration zone: var HZ: Str = gz; HZ.len = 3 writes gz.len (D21 (a); a copy through 6.7.13)");
assert_eq(z_wrap(), 77, "declaration zone: var HZ2: Str = ((gz)); var PZ: *Str = gz;");
