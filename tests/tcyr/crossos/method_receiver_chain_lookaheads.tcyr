assert_eq(fc_xs(), 34, "MX: ... after a single name, q.idv(q).m2() (needs a call before)");
assert_eq(fc_xgi(), 34, "MX: an inferred generic step returning G1<V>, w.p.mkg(q).v.m2() (needs a call before)");
assert_eq(fc_xd(), 27, "MX: a tuple capture on a dereference head, (*pw).p.idv(q).mm(2) (not a tuple before)");
