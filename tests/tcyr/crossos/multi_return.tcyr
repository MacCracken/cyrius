# multi_return.tcyr — cross-host: multi-value return must carry EVERY value on
# EVERY target, and the `: f64` / signature-typed forms must not lose or corrupt one.
#
# v6.5.21. Multi-value return has shipped since v3.7.2 (`return (a, b);` +
# `var q, r = f();`) and had THREE lines of coverage in the whole tree —
# `tests/tcyr/lang/regression.tcyr`, integer-only, and NOTHING in `crossos/`. It was
# never run off-Linux. Three defects were living in that gap, all silent:
#
#   1. cx returned the FIRST value TWICE. `EMOVRDXRAX` / `EMOVRA_RDX` were literal
#      `return 0;` stubs (src/backend/cx/emit.cyr), so `return (5, 9)` scored 59 on
#      x86 / aarch64 / PE and 55 under cxvm — exit 0, no diagnostic. The macOS-rot
#      shape exactly: a stub that compiles clean, runs clean, and lies.
#   2. A `: f64` fn returning a tuple lost its FIRST value on x86/PE. The tuple path
#      returned before the callee's `movq xmm0, rax` box, while the CALL SITE
#      unboxes `movq rax, xmm0` unconditionally for any `: f64` callee — so value 1
#      arrived as whatever f64 op last touched xmm0. aarch64 was UNAFFECTED (the
#      moves are no-ops there), i.e. the bug was backend-divergent and a Linux-only
#      or ARM-only run would each have seen half of it.
#   3. f64 type was lost at the binding, so arithmetic on a returned f64 was an
#      INTEGER add over the bit pattern.
#
# ⚠ WHY THIS BELONGS IN crossos/ AND NOT lang/: every one of the three was
# target-dependent. (1) was cx-only, (2) was x86-family-only, and a host-side test on
# any single target passes against at least one of them in full. This file is the
# thing that makes "multi-return works" a claim about the toolchain rather than about
# one box.
#
# ⚠ The `(5, 9) -> 59` shape is deliberate: the two values must be DISTINGUISHABLE
# and ORDER-SENSITIVE. A test using `(1, 1)` or summing the values passes against
# defect 1 — the first-value-twice bug is invisible unless the values differ and the
# assertion can tell which slot each landed in.

include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"

# --- arity 2, undeclared (the legacy form, ~200 sites across 24 consumer repos) ---
fn mr_divmod(a, b) { return (a / b, a % b); }

# --- arity 2, declared ---
fn mr_pair(a, b): (i64, i64) { return (a, b); }

# --- arity 3 (v6.5.21; abaco's `_dd_pow10` is the motivating 3-valued primitive) ---
fn mr_triple(a): (i64, i64, i64) { return (a, a + 1, a + 2); }

# --- f64 pair, types carried BY THE SIGNATURE (no annotation on the bindings) ---
fn mr_f64pair(a, b): (f64, f64) { return (f64_mul(a, b), f64_add(a, b)); }

# --- `: f64` scalar annotation + tuple return — defect 2's exact shape ---
fn mr_f64tagged(a: f64, b: f64): f64 { return (f64_mul(a, b), f64_add(a, b)); }

# --- legacy ret2 / rethi builtins (share the same register pair) ---
fn mr_ret2(a, b) { ret2(a / b, a % b); }

# --- `: f64` SINGLE return. Defect 3's discriminator in pre-6.5.21 syntax: this
# shape parses on 6.5.20 and gets the wrong answer there, so it is the assertion
# that mutation-proves the type-propagation fix rather than merely exercising it.
fn mr_f64one(a, b): f64 { return f64_mul(a, b); }

# --- 6.7.11: a fn declared `: (T1, T2[, T3])` returns its values. Every return that is not one of
# these is refused at the fn (tests/gates/diagnostics/destructure_one_value_refused.sh axis 5); the
# ones that stay valid must carry EVERY value on every target: a forwarded call of the same arity (a
# tail call: the callee's registers pass straight through), the same call in parentheses (no tail
# call), an undeclared callee of that arity, arity 3, a method, a tuple local.
fn mr_fwd_pair(a, b): (i64, i64) { return mr_pair(a, b); }
fn mr_fwd_wrapped(a, b): (i64, i64) { return (mr_pair(a, b)); }
fn mr_fwd_divmod(a, b): (i64, i64) { return mr_divmod(a, b); }
fn mr_fwd_triple(a): (i64, i64, i64) { return mr_triple(a); }
fn mr_ret_tuple(a, b): (i64, i64) { var t = (b, a); return t; }
struct MrBox { v; }
impl MrBox {
    fn pair(self, a): (i64, i64) { return (a, self.v); }
    fn fall(self, x): (i64, i64, i64) { if (x > 0) { return (self.v, 2, 3); } }
}
fn mr_fwd_method(a): (i64, i64) { var bx = MrBox { 9 }; return bx.pair(a); }
fn mr_fwd_callptr(a, b): (i64, i64) { var fp = &mr_pair; return callptr(fp, a, b); }

# --- 6.7.13 (D28 C, the user's decision, 2026-10-15): a fn declared `: (T1, T2[, T3])` whose body reaches
# its `}` returns 0 for every value, as a bool fn's is `false` (6.7.3); every `return` is untouched. A body
# whose returns cover every path (if / else, an infinite loop) never reaches it. The defer runs and the
# values stay 0; an #inline replay, a method, a generic instance and an empty body land the same way.
fn mr_fall2(x): (i64, i64) { if (x > 0) { return (1, 2); } }
fn mr_fall3(x): (i64, i64, i64) { if (x > 0) { return (1, 2, 3); } }
fn mr_ifelse(x): (i64, i64) { if (x > 0) { return (1, 2); } else { return (3, 4); } }
fn mr_loopend(x): (i64, i64) { while (1) { if (x > 3) { return (x, 2); } x = x + 1; } }
var mr_dg = 0;
fn mr_fall_defer(x): (i64, i64) { defer { var p, q, w = mr_triple(76); mr_dg = q; } if (x > 0) { return (1, 2); } }
fn mr_fall_f64(x): (f64, f64) { if (x > 0) { return (f64_from(1), f64_from(2)); } }
fn mr_fall_gen<T>(x: T): (i64, i64) { if (x > 0) { return (x, 2); } }
fn mr_k40(x) { return x + 40; }
#inline
fn mr_fall_inline(x): (i64, i64) { mr_k40(x); }
fn mr_empty(): (i64, i64) { }

fn main(): i64 {
    # 1. undeclared arity 2 — order-sensitive
    var q, r = mr_divmod(10, 3);
    assert_eq(q, 3, "undeclared arity2: first value (quotient)");
    assert_eq(r, 1, "undeclared arity2: second value (remainder)");

    # 2. declared arity 2 — distinguishable values, so first-twice cannot pass
    var p1, p2 = mr_pair(5, 9);
    assert_eq(p1, 5, "declared arity2: first value");
    assert_eq(p2, 9, "declared arity2: second value (cx returned 5 pre-6.5.21)");

    # 3. arity 3 — all three slots distinct
    var t1, t2, t3 = mr_triple(40);
    assert_eq(t1, 40, "arity3: first value");
    assert_eq(t2, 41, "arity3: second value");
    assert_eq(t3, 42, "arity3: third value");

    # 4. f64 pair typed by the signature. 3.0 * 4.0 = 12.0, 3.0 + 4.0 = 7.0.
    var fp, fs = mr_f64pair(f64_from(3), f64_from(4));
    assert_eq(f64_to(fp), 12, "f64 pair: product arrives in slot 1");
    assert_eq(f64_to(fs), 7, "f64 pair: sum arrives in slot 2");

    # 4b. arithmetic on the bindings must be FLOAT arithmetic, not an integer add
    # over the bit patterns (defect 3: this returned 0 before v6.5.21).
    var fsum: f64 = fp + fs;
    assert_eq(f64_to(fsum), 19, "f64 pair: bindings carry the f64 type");

    # 5. `: f64` + tuple — defect 2. Pre-6.5.21 BOTH slots came back as the second
    # value (7) on x86/PE, because the caller read a stale xmm0.
    var gp, gs = mr_f64tagged(f64_from(3), f64_from(4));
    assert_eq(f64_to(gp), 12, ": f64 tuple: first value not clobbered by stale xmm0");
    assert_eq(f64_to(gs), 7, ": f64 tuple: second value");

    # 5b. `: f64` SINGLE return must type its binding too. Mutation-proven: on the
    # 6.5.20 compiler this shape parses and yields 0 (an INTEGER add over two
    # IEEE-754 bit patterns); on 6.5.21 it yields 24.
    var op1 = mr_f64one(f64_from(3), f64_from(4));
    var od: f64 = op1 + op1;
    assert_eq(f64_to(od), 24, ": f64 single return types the binding");

    # 6. legacy ret2 / rethi — same register pair, same cx stub
    var lq = mr_ret2(10, 3);
    var lr = rethi();
    assert_eq(lq, 3, "ret2: rax value");
    assert_eq(lr, 1, "rethi: second value (cx returned 3 pre-6.5.21)");

    # 7. 6.7.11 — the forwards that stay valid, SEEDED: a three-value call first leaves 77 / 78 in
    # the second and third return registers, so a value a forward lost reads as one of those.
    var s1, s2, s3 = mr_triple(76);
    assert_eq(s1 + s2 + s3, 231, "seed: 76, 77, 78");
    var fa, fb = mr_fwd_pair(5, 9);
    assert_eq(fa, 5, "forwarded (tail call): first value");
    assert_eq(fb, 9, "forwarded (tail call): second value");
    s1, s2, s3 = mr_triple(76);
    var wa, wb = mr_fwd_wrapped(6, 8);
    assert_eq(wa, 6, "forwarded in parentheses: first value");
    assert_eq(wb, 8, "forwarded in parentheses: second value");
    s1, s2, s3 = mr_triple(76);
    var dq, dr = mr_fwd_divmod(17, 5);
    assert_eq(dq, 3, "forwarded undeclared callee: first value");
    assert_eq(dr, 2, "forwarded undeclared callee: second value");
    s1, s2, s3 = mr_triple(10);
    var u1, u2, u3 = mr_fwd_triple(40);
    assert_eq(u1, 40, "forwarded arity 3: first value");
    assert_eq(u2, 41, "forwarded arity 3: second value");
    assert_eq(u3, 42, "forwarded arity 3: third value");
    s1, s2, s3 = mr_triple(76);
    var ta, tb = mr_ret_tuple(3, 4);
    assert_eq(ta, 4, "return t;: first value");
    assert_eq(tb, 3, "return t;: second value");
    s1, s2, s3 = mr_triple(76);
    var ma, mb = mr_fwd_method(2);
    assert_eq(ma, 2, "forwarded method: first value");
    assert_eq(mb, 9, "forwarded method: second value");
    s1, s2, s3 = mr_triple(76);
    var ca, cb = mr_fwd_callptr(7, 4);
    assert_eq(ca, 7, "forwarded callptr (callee unknown): first value");
    assert_eq(cb, 4, "forwarded callptr (callee unknown): second value");

    # 8. 6.7.13 — `callptr(fp, ..)` destructures as `fncallN` does (it was refused "multi-value destructure
    # needs a call on the right-hand side"; issues/2026-10-13-destructure-of-callptr-refused.md): every value
    # read after an INDIRECT call, SEEDED as section 7 is. MUTATION: `_dt_rhs_check_t` without its `callptr`
    # line -> the file does not build.
    var cfp = &mr_pair;
    s1, s2, s3 = mr_triple(76);
    var xa, xb = callptr(cfp, 5, 9);
    assert_eq(xa, 5, "callptr destructure: first value");
    assert_eq(xb, 9, "callptr destructure: second value");
    s1, s2, s3 = mr_triple(76);
    xa, xb = callptr(cfp, 6, 8);
    assert_eq(xa * 10 + xb, 68, "callptr re-assignment `a, b = callptr(..)`: both values");
    var tfp = &mr_triple;
    s1, s2, s3 = mr_triple(10);
    var y1, y2, y3 = callptr(tfp, 40);
    assert_eq(y1, 40, "callptr destructure arity 3: first value");
    assert_eq(y2, 41, "callptr destructure arity 3: second value");
    assert_eq(y3, 42, "callptr destructure arity 3: third value");

    # 9. 6.7.13 — off the end of a fn declared `: (T1, T2[, T3])` every value is 0 (D28 C, the user's decision,
    # 2026-10-15; issues/2026-10-13-declared-multi-value-fn-falls-off-its-end.md: the repro read the seeded 77 on
    # every target). SEEDED as section 7 is, so a value left stale reads 77 / 78 (7.0 for the f64 pair).
    # MUTATION (run 2026-10-15): `_mret_falloff` answering 0 -> 9 rows fail on x86 (the stale 77 / 78 / 7.0);
    # `_mret_falloff_fi` answering 0 -> the #inline row (4077: 40, 77).
    s1, s2, s3 = mr_triple(76);
    var fo1, fo2 = mr_fall2(0);
    assert_eq(fo1, 0, "fall-off arity 2: first value 0");
    assert_eq(fo2, 0, "fall-off arity 2: second value 0 (it read the seeded 77)");
    s1, s2, s3 = mr_triple(76);
    var fo3a, fo3b, fo3c = mr_fall3(0);
    assert_eq(fo3a, 0, "fall-off arity 3: first value 0");
    assert_eq(fo3b, 0, "fall-off arity 3: second value 0");
    assert_eq(fo3c, 0, "fall-off arity 3: third value 0 (it read the seeded 78)");
    s1, s2, s3 = mr_triple(76);
    var fr1, fr2 = mr_fall2(1);
    assert_eq(fr1 * 10 + fr2, 12, "fall-off fn, the return taken: its values");
    s1, s2, s3 = mr_triple(76);
    var ie1, ie2 = mr_ifelse(0);
    assert_eq(ie1 * 10 + ie2, 34, "if / else both returning: the else arm's values");
    s1, s2, s3 = mr_triple(76);
    var le1, le2 = mr_loopend(0);
    assert_eq(le1 * 10 + le2, 42, "a body ending in while (1): the loop's return");
    mr_dg = 0;
    s1, s2, s3 = mr_triple(76);
    var fd1, fd2 = mr_fall_defer(0);
    assert_eq(mr_dg, 77, "fall-off with a defer: the defer ran (its own call returned 77)");
    assert_eq(fd1 * 10 + fd2, 0, "fall-off with a defer: the values stay 0 across the defer's call");
    var sf1, sf2 = mr_f64pair(f64_from(3), f64_from(4));
    var ff1, ff2 = mr_fall_f64(0);
    assert_eq(f64_to(ff1), 0, "fall-off f64 pair: first value 0.0");
    assert_eq(f64_to(ff2), 0, "fall-off f64 pair: second value 0.0 (it read the seeded 7.0)");
    var fbx = MrBox { 9 };
    s1, s2, s3 = mr_triple(76);
    var fm1, fm2, fm3 = fbx.fall(0);
    assert_eq(fm1 + fm2 + fm3, 0, "fall-off method arity 3: every value 0");
    s1, s2, s3 = mr_triple(76);
    var fg1, fg2 = mr_fall_gen<i64>(0);
    assert_eq(fg1 * 10 + fg2, 0, "fall-off generic instance: every value 0");
    s1, s2, s3 = mr_triple(76);
    var fi1, fi2 = mr_fall_inline(0);
    assert_eq(fi1 * 100 + fi2, 0, "fall-off #inline replay: every value 0 (it read 40, 77)");
    s1, s2, s3 = mr_triple(76);
    var fe1, fe2 = mr_empty();
    assert_eq(fe1 * 10 + fe2, 0, "an empty body: every value 0");
    s1, s2, s3 = mr_triple(76);
    mr_fall2(0);
    var fh = rethi();
    assert_eq(fh, 0, "fall-off then rethi(): the second register is 0");

    var r2 = assert_summary();
    return r2;
}
