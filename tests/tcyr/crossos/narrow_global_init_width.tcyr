# narrow_global_init_width.tcyr — 6.6.13 (M1) — a narrow (1/2/4-byte) global in the leading
# declaration block is INITIALISED at its own width, on every backend.
#
# `var a: u8 = 0; var b: u8 = 7; syscall(60, b);` exited 0 (want 7) on x86, aarch64, PE and both
# Mach-O targets. A leading-block global takes the static file-image path only when its
# initialiser folds to a NON-zero constant; a `= 0`, any non-constant expression and a call are
# stored at startup instead, by EMIT_GVAR_INITS's replay (src/frontend/parse_decl.cyr), whose
# scalar arm stored with the 8-byte EVSTORE whatever the slot's width. Narrow globals are packed,
# so that store wrote the value's upper bytes over the next 7/6/4 bytes of globals — and a
# neighbour whose value was already in the image lost it. Now _gv_store stores at the slot's
# width (exact 1/2/4; anything else keeps the 8-byte store). cx's constant prestore had the same
# 8-byte store; its row is in tests/gates/codegen/cx_tailcall_and_vm_traps.sh (axis E).
#
# Every row is a SAME-WIDTH narrow-narrow pair (or triple), never narrow-then-i64: global
# alignment pads before a wider global, so an 8-byte store landing in padding would pass whether
# or not it is width-correct. Each width covers three initialiser kinds — `= 0`, a non-constant
# global copy (`= SRC_WIDE`) and a call (`= wide()`) — in both orders (the narrow one first, then
# a neighbour; a neighbour, the narrow one, a neighbour), plus a signed negative from a call. The
# wide value has the top bit of every narrow width set, so each row also checks the truncation and
# the sign extension the load applies. Reads happen inside a fn (check_<w>) and at top level; the
# `pp_` rows after the first top-level statement go through the PARSE_PROG declaration path,
# which was always width-correct — a control.
#
# Mutation ledger: the 6.6.13-open compiler (EMIT_GVAR_INITS's 8-byte EVSTORE) fails 76 of the
# 135 rows here, at every width and for every initialiser kind; the rows it passes are the ones
# no 8-byte store reaches (the value itself, a neighbour declared BEFORE it) and the pp_ controls.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

# Bit 7 / 15 / 31 of every narrow width is set, so a truncated value also reads back negative at
# the signed widths: u8 136, i8 -120, u16 63368, i16 -2168, u32 3588683656, i32 -706283640.
var SRC_WIDE = 0x11223344D5E6F788;
fn wide(): i64 { return 0x11223344D5E6F788; }
fn neg3(): i64 { return 0 - 3; }

# u8
var zn_u8_a: u8 = 0;
var zn_u8_b: u8 = 7;
var nzn_u8_a: u8 = 7;
var nzn_u8_b: u8 = 0;
var nzn_u8_c: u8 = 9;
var gn_u8_a: u8 = SRC_WIDE;
var gn_u8_b: u8 = 7;
var ngn_u8_a: u8 = 7;
var ngn_u8_b: u8 = SRC_WIDE;
var ngn_u8_c: u8 = 9;
var cn_u8_a: u8 = wide();
var cn_u8_b: u8 = 7;
var ncn_u8_a: u8 = 7;
var ncn_u8_b: u8 = wide();
var ncn_u8_c: u8 = 9;
var sn_u8_a: u8 = neg3();
var sn_u8_b: u8 = 7;
var nsn_u8_a: u8 = 7;
var nsn_u8_b: u8 = neg3();
var nsn_u8_c: u8 = 9;

# i8
var zn_i8_a: i8 = 0;
var zn_i8_b: i8 = 7;
var nzn_i8_a: i8 = 7;
var nzn_i8_b: i8 = 0;
var nzn_i8_c: i8 = 9;
