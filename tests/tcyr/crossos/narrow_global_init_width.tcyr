var nzn_i32_b: i32 = 0;
var nzn_i32_c: i32 = 9;
var gn_i32_a: i32 = SRC_WIDE;
var gn_i32_b: i32 = 7;
var ngn_i32_a: i32 = 7;
var ngn_i32_b: i32 = SRC_WIDE;
var ngn_i32_c: i32 = 9;
var cn_i32_a: i32 = wide();
var cn_i32_b: i32 = 7;
var ncn_i32_a: i32 = 7;
var ncn_i32_b: i32 = wide();
var ncn_i32_c: i32 = 9;
var sn_i32_a: i32 = neg3();
var sn_i32_b: i32 = 7;
