# Top-level reads (the filed shape and its reverse) — the first statement ends the leading block.
assert_eq(zn_u8_b, 7, "top level: u8 = 0 then 7: its neighbour");
assert_eq(nzn_u8_c, 9, "top level: u8 7, = 0, 9: the neighbour after the zero");
assert_eq(zn_i8_b, 7, "top level: i8 = 0 then 7: its neighbour");
assert_eq(nzn_i8_c, 9, "top level: i8 7, = 0, 9: the neighbour after the zero");
assert_eq(zn_u16_b, 7, "top level: u16 = 0 then 7: its neighbour");
assert_eq(nzn_u16_c, 9, "top level: u16 7, = 0, 9: the neighbour after the zero");
assert_eq(zn_i16_b, 7, "top level: i16 = 0 then 7: its neighbour");
assert_eq(nzn_i16_c, 9, "top level: i16 7, = 0, 9: the neighbour after the zero");
assert_eq(zn_u32_b, 7, "top level: u32 = 0 then 7: its neighbour");
assert_eq(nzn_u32_c, 9, "top level: u32 7, = 0, 9: the neighbour after the zero");
assert_eq(zn_i32_b, 7, "top level: i32 = 0 then 7: its neighbour");
assert_eq(nzn_i32_c, 9, "top level: i32 7, = 0, 9: the neighbour after the zero");

# Control: declared after a top-level statement, so PARSE_VAR's top-level arm stores these (it
# always used EVSTORE_W).
var pp_u8_a: u8 = 0;
var pp_u8_b: u8 = 7;
var pp_i16_a: i16 = 0;
var pp_i16_b: i16 = 1234;
var pp_u32_a: u32 = 0;
var pp_u32_b: u32 = 9;
assert_eq(pp_u8_b, 7, "PARSE_PROG path: u8 = 0 then 7: its neighbour");
assert_eq(pp_i16_b, 1234, "PARSE_PROG path: i16 = 0 then 1234: its neighbour");
assert_eq(pp_u32_b, 9, "PARSE_PROG path: u32 = 0 then 9: its neighbour");

check_u8();
check_i8();
check_u16();
check_i16();
check_u32();
check_i32();
var r = assert_summary();
