var ncn_i8_a: i8 = 7;
var ncn_i8_b: i8 = wide();
var ncn_i8_c: i8 = 9;
var sn_i8_a: i8 = neg3();
var sn_i8_b: i8 = 7;
var nsn_i8_a: i8 = 7;
var nsn_i8_b: i8 = neg3();
var nsn_i8_c: i8 = 9;

# u16
var zn_u16_a: u16 = 0;
