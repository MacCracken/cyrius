var nsn_i32_b: i32 = neg3();
var nsn_i32_c: i32 = 9;

fn check_u8(): i64 {
    assert_eq(zn_u8_a, 0, "u8 = 0 then 7: the zero");
    assert_eq(zn_u8_b, 7, "u8 = 0 then 7: its neighbour");
    assert_eq(nzn_u8_a, 7, "u8 7, = 0, 9: the first");
    assert_eq(nzn_u8_b, 0, "u8 7, = 0, 9: the zero");
    assert_eq(nzn_u8_c, 9, "u8 7, = 0, 9: the neighbour after the zero");
    assert_eq(gn_u8_a, 136, "u8 = <global> then 7: truncated to the width");
    assert_eq(gn_u8_b, 7, "u8 = <global> then 7: its neighbour");
    assert_eq(ngn_u8_a, 7, "u8 7, = <global>, 9: the first");
    assert_eq(ngn_u8_b, 136, "u8 7, = <global>, 9: truncated to the width");
    assert_eq(ngn_u8_c, 9, "u8 7, = <global>, 9: the neighbour after it");
    assert_eq(cn_u8_a, 136, "u8 = f() then 7: truncated to the width");
    assert_eq(cn_u8_b, 7, "u8 = f() then 7: its neighbour");
    assert_eq(ncn_u8_a, 7, "u8 7, = f(), 9: the first");
    assert_eq(ncn_u8_b, 136, "u8 7, = f(), 9: truncated to the width");
    assert_eq(ncn_u8_c, 9, "u8 7, = f(), 9: the neighbour after it");
    assert_eq(sn_u8_a, 253, "u8 = neg3() then 7: -3 at the width");
    assert_eq(sn_u8_b, 7, "u8 = neg3() then 7: its neighbour");
    assert_eq(nsn_u8_a, 7, "u8 7, = neg3(), 9: the first");
    assert_eq(nsn_u8_b, 253, "u8 7, = neg3(), 9: -3 at the width");
    assert_eq(nsn_u8_c, 9, "u8 7, = neg3(), 9: the neighbour after it");
    return 0;
}

fn check_i8(): i64 {
    assert_eq(zn_i8_a, 0, "i8 = 0 then 7: the zero");
    assert_eq(zn_i8_b, 7, "i8 = 0 then 7: its neighbour");
    assert_eq(nzn_i8_a, 7, "i8 7, = 0, 9: the first");
    assert_eq(nzn_i8_b, 0, "i8 7, = 0, 9: the zero");
    assert_eq(nzn_i8_c, 9, "i8 7, = 0, 9: the neighbour after the zero");
    assert_eq(gn_i8_a, 0 - 120, "i8 = <global> then 7: truncated to the width");
    assert_eq(gn_i8_b, 7, "i8 = <global> then 7: its neighbour");
    assert_eq(ngn_i8_a, 7, "i8 7, = <global>, 9: the first");
    assert_eq(ngn_i8_b, 0 - 120, "i8 7, = <global>, 9: truncated to the width");
    assert_eq(ngn_i8_c, 9, "i8 7, = <global>, 9: the neighbour after it");
    assert_eq(cn_i8_a, 0 - 120, "i8 = f() then 7: truncated to the width");
    assert_eq(cn_i8_b, 7, "i8 = f() then 7: its neighbour");
    assert_eq(ncn_i8_a, 7, "i8 7, = f(), 9: the first");
    assert_eq(ncn_i8_b, 0 - 120, "i8 7, = f(), 9: truncated to the width");
    assert_eq(ncn_i8_c, 9, "i8 7, = f(), 9: the neighbour after it");
    assert_eq(sn_i8_a, 0 - 3, "i8 = neg3() then 7: -3 at the width");
    assert_eq(sn_i8_b, 7, "i8 = neg3() then 7: its neighbour");
    assert_eq(nsn_i8_a, 7, "i8 7, = neg3(), 9: the first");
    assert_eq(nsn_i8_b, 0 - 3, "i8 7, = neg3(), 9: -3 at the width");
    assert_eq(nsn_i8_c, 9, "i8 7, = neg3(), 9: the neighbour after it");
    return 0;
}

