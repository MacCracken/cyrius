# narrow_unsigned_f32_fields.tcyr — 6.7.10 (B7-2). u8 / u16 / u32 AND f32 STRUCT FIELDS ARE THEIR
# WIDTHS (the user's decision, 2026-10-08: packed, no padding — the rule i8 / i16 / i32 fields have
# always followed): u8 / u16 / u32 take 1 / 2 / 4 bytes and read ZERO-extended, f32 takes 4 (its
# binary32 bits, typed). Through 6.7.9 each was an 8-byte slot: `struct C4 { r: u8; g: u8; b: u8;
# a: u8; }` was 32 bytes, `struct { a: u8; b: i64; }` 16, and `c.r = 250; c.r += 10;` read 260.
#
# The rows:
#   * sizeof and offsets — structs, a union, nesting, a mix with i8..i32; u64 stays 8;
#   * zero-extension at every width (255 / 0xFFFF / 0xFFFFFFFF, never -1) and the field's own width
#     on a write and an `OP=` (250 + 10 is 4, 255 + 1 is 0, a u32 0 - 1 is 0xFFFFFFFF), the
#     neighbours kept;
#   * a `*T` onto unaligned heap bytes reads and writes only its field's bytes (guards each side);
#   * f32: the binary32 bits at 4 bytes, a sum, `*=`, compares, 0.1's rounding, a negative;
#   * positional, named and nested literals in a fn, in the declaration zone and after it;
#   * THE CLASS SWEEP — every size 1..17 and 20 built from u8 / u16 / u32 / f32 fields (the by-value
#     class follows the size: one register to 8 B, a pair to 16 B, an address over 16), each through
#     a by-value argument (the callee's write stays in the callee), a struct return, `q = a`, a store
#     into a value global with a u8 global declared right after it, a store into a field with a u8
#     guard field on each side, and a closure capture — u values with their high bits set, so a
#     sign-extending read or a wider store is red;
#   * operators (`C4_add` wraps per channel, `F2_add`), a by-value and an untyped `self`;
#   * `*C4` steps 4 bytes and `C4[2]` is 8 (the u8 global after it kept);
#   * a shrunk struct at the handle line: `var c: C4 = alloc(4); c.r = 5;` reaches the heap (B7-1).
# The refusals, the redefinition warnings and the mutation ledger are
# tests/gates/frontend/narrow_fields_checked.sh, which runs this file on x86_64 (default, CYRIUS_IR=1,
# CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm) and PE (wine); cx_crossos_rows_run.sh runs it
# natively and on cxvm.
# CROSS-HOST: the release gate's cross-OS leg runs it on ecb / ach / cass / pi — a u32 after a u8 sits
# at offset 1, an unaligned access on every target.
include "lib/assert.cyr"
include "lib/alloc.cyr"

struct A9 { a: u8; b: i64; }
struct B10 { a: u16; b: u32; c: f32; }
struct C4 { r: u8; g: u8; b: u8; a: u8; }
union U4 { a: u8; b: u32; c: f32; }
struct NC { c: C4; x: u16; y: u32; }
struct M9 { a: u64; b: u8; }
struct MX { a: i8; b: u8; c: i16; d: u16; e: i32; f: u32; g: f32; }
struct F2 { x: f32; y: f32; }
struct WD { a: u8; b: i32; c: i8; e: i16; d; }

var GD = C4 { 1, 2, 3, 4 };
var GDN = NC { 5, 6, 7, 8, 0xBEEF, 0xFFFFFFFF };
var GDF = B10 { 0xFFFF, 0xFFFFFFFE, 1.5 };
var GA: C4[2];
var GAG: u8 = 0x5A;

fn C4_add(a: C4, b: C4): C4 { var r: C4; r.r = a.r + b.r; r.g = a.g + b.g; r.b = a.b + b.b; r.a = a.a + b.a; return r; }
fn F2_add(a: F2, b: F2): F2 { var r: F2; r.x = a.x + b.x; r.y = a.y + b.y; return r; }
impl C4 { fn lum(self: C4): i64 { return self.r + self.g + self.b + self.a; } }
impl C4 { fn first(self) { return self.r; } }
impl F2 { fn sum4(self: F2): i64 { return f64_to(f32_to(self.x + self.y) * 4.0); } }

# ── the class sweep: one struct per size, its checksum read by value (zs) and through a *T (zp) ──
# 1 B { u8 }
struct Z1 { f0: u8; }
struct W1 { h: u8; z: Z1; g: u8; }
var GZ1 = Z1 { 0 };
var GG1: u8 = 0x5A;
fn zs1(z: Z1): i64 {
    var k = z.f0 * 1;
    return k;
}
fn zp1(p: *Z1): i64 {
    var k = p.f0 * 1;
    return k;
}
fn mk1(): Z1 {
    var r: Z1;
    r.f0 = 0xF1;
    return r;
}
fn zw1(z: Z1): i64 { z.f0 = 1; return zs1(z); }
fn za1(): i64 {
    var a = mk1();
    var k = zw1(a);
    if (k == zs1(a)) { return 0 - 1; }
    return zs1(a);
}
fn zr1(): i64 { var r: Z1 = mk1(); return zp1(&r); }
fn zq1(): i64 { var a = mk1(); var q: Z1; q = a; a.f0 = 1; return zp1(&q); }
fn zg1(): i64 {
    var a = mk1();
    GZ1 = a;
    a.f0 = 1;
    if (GG1 != 0x5A) { return 0 - 1; }
    return zp1(&GZ1);
}
fn zf1(): i64 {
    var a = mk1();
    var w: W1;
    w.h = 0x5A;
    w.g = 0x5A;
    w.z = a;
    a.f0 = 1;
    if (w.h != 0x5A) { return 0 - 1; }
    if (w.g != 0x5A) { return 0 - 2; }
    var q: Z1 = w.z;
    return zp1(&q);
}
fn zc1(): i64 { var a = mk1(); var f = |d| { return zs1(a) + d; }; return callptr(f, 0); }

