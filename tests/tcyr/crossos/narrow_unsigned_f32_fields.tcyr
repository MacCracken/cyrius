# ── offsets: a field written through a *T over a filled heap block lands at its packed offset ──
fn at_b10(m, k): *B10 { return m + k; }
fn at_nc(m, k): *NC { return m + k; }
fn at_mx(m, k): *MX { return m + k; }
fn at_u4(m, k): *U4 { return m + k; }
fn at_m9(m, k): *M9 { return m + k; }
fn fill(m, n, b) { var i = 0; while (i < n) { store8(m + i, b); i = i + 1; } return 0; }
fn off_b10(): i64 {
    var m = alloc(16);
    fill(m, 16, 0);
    var p: *B10 = at_b10(m, 0);
    p.a = 0x1122;
    p.b = 0x33445566;
    p.c = 1.5;
    if (load16(m) != 0x1122) { return 1; }
    if (load32(m + 2) != 0x33445566) { return 2; }
    if (load32(m + 6) != 0x3FC00000) { return 3; }
    if (load8(m + 10) != 0) { return 4; }
    return 0;
}
fn off_nc(): i64 {
    var m = alloc(16);
    fill(m, 16, 0);
    var p: *NC = at_nc(m, 0);
    p.c.b = 0x77;
    p.x = 0xBEEF;
    p.y = 0xCAFEF00D;
    if (load8(m + 2) != 0x77) { return 1; }
    if (load16(m + 4) != 0xBEEF) { return 2; }
    if (load32(m + 6) != 0xCAFEF00D) { return 3; }
    if (load8(m + 10) != 0) { return 4; }
    return 0;
}
fn off_mx(): i64 {
    var m = alloc(24);
    fill(m, 24, 0);
    var p: *MX = at_mx(m, 0);
    p.b = 0xAB;
    p.d = 0xCDEF;
    p.f = 0x89ABCDEF;
    p.g = 2.5;
    if (load8(m + 1) != 0xAB) { return 1; }
    if (load16(m + 4) != 0xCDEF) { return 2; }
    if (load32(m + 10) != 0x89ABCDEF) { return 3; }
    if (load32(m + 14) != 0x40200000) { return 4; }
    if (load8(m + 18) != 0) { return 5; }
    return 0;
}
fn off_u4(): i64 {
    var m = alloc(8);
    fill(m, 8, 0xEE);
    var p: *U4 = at_u4(m, 0);
    p.b = 0x01020304;
    if (p.a != 4) { return 1; }
    p.a = 0xFF;
    if (p.b != 0x010203FF) { return 2; }
    p.c = 1.5;
    if (p.b != 0x3FC00000) { return 3; }
    if (load8(m + 4) != 0xEE) { return 4; }
    return 0;
}
fn off_m9(): i64 {
    var m = alloc(16);
    fill(m, 16, 0);
    var p: *M9 = at_m9(m, 0);
    p.a = 0 - 1;
    p.b = 7;
    if (load8(m + 8) != 7) { return 1; }
    if (p.a != 0 - 1) { return 2; }
    return 0;
}

# ── zero-extension and the field's width ──
fn zx_u8(): i64 { var c = C4 { 255, 254, 253, 252 }; return c.r * 1000 + c.a; }
fn zx_u16(): i64 { var b = B10 { 0xFFFF, 0, 0.0 }; return b.a; }
fn zx_u32(): i64 { var b = B10 { 0, 0xFFFFFFFF, 0.0 }; return b.b; }
fn zx_cmp(): i64 { var c = C4 { 200, 0, 0, 0 }; if (c.r > 100) { return 1; } return 0; }
fn zx_shr(): i64 { var c = C4 { 200, 0, 0, 0 }; c.r >>= 1; return c.r; }
fn zx_div(): i64 {
    var c = C4 { 200, 0, 0, 0 };
    var b = B10 { 0xFFFE, 0xFFFFFFFC, 1.5 };
    c.r /= 2;
    b.a /= 2;
    b.b /= 4;
    return c.r * 100000000000 + b.a * 10000000 + b.b - 0x3FFFFFFF;
}
fn wr_inc(): i64 { var c = C4 { 255, 254, 253, 252 }; c.r += 1; return c.r * 1000 + c.g; }
fn wr_add(): i64 { var w = WD { 250, 7, 0 - 3, 9, 11 }; w.a += 10; return w.a * 1000 + w.b * 100 + w.c * 10 + w.d; }
fn wr_mul(): i64 { var c = C4 { 1, 254, 9, 4 }; c.g *= 2; return c.g * 10000 + c.b * 100 + c.a; }
fn wr_u32m(): i64 { var b = B10 { 7, 0, 1.5 }; b.b -= 1; if (b.a != 7) { return 0 - 1; } return b.b; }
fn wr_u16i(): i64 { var b = B10 { 0xFFFF, 9, 1.5 }; b.a += 1; return b.a * 100 + b.b; }
fn wr_store(): i64 { var c = C4 { 1, 2, 3, 4 }; c.g = 0x1FF; return c.r * 10000 + c.g * 10 + c.b; }
fn wr_store32(): i64 { var b = B10 { 3, 0, 1.5 }; b.b = 0x123456789; if (b.a != 3) { return 0 - 1; } return b.b; }

# ── a *T over unaligned heap bytes: only its field's bytes ──
fn ptr_rw(): i64 {
    var m = alloc(16);
    fill(m, 16, 0xEE);
    var p: *B10 = at_b10(m, 3);
    p.b = 0x01020304;
    if (load16(m + 3) != 0xEEEE) { return 1; }
    if (load32(m + 5) != 0x01020304) { return 2; }
    if (load8(m + 9) != 0xEE) { return 3; }
    p.a = 0xABCD;
    if (load8(m + 2) != 0xEE) { return 4; }
    if (load32(m + 5) != 0x01020304) { return 5; }
    p.c = 2.5;
    if (load32(m + 9) != 0x40200000) { return 6; }
    if (load8(m + 13) != 0xEE) { return 7; }
    if (p.a != 0xABCD) { return 8; }
    p.b = 0xFFFFFFFF;
    if (p.b != 0xFFFFFFFF) { return 9; }
    if (f64_to(f32_to(p.c) * 2.0) != 5) { return 10; }
    return 0;
}

# ── f32 fields ──
fn f_bits(): i64 { var f = F2 { 1.5, 2.25 }; return load32(&f) * 100 + (load32(&f + 4) - 0x40100000); }
fn f_sum(): i64 { var f = F2 { 1.5, 2.25 }; return f64_to(f32_to(f.x + f.y) * 4.0); }
fn f_mul(): i64 { var f = F2 { 1.5, 2.25 }; f.x *= f32_from(2.0); return f64_to(f32_to(f.x) * 2.0); }
fn f_cmp(): i64 {
    var f = F2 { 3.0, 2.25 };
    var k = 0;
    if (f.x > f.y) { k = k + 1; }
    f.x = 0.0 - 2.25;
    if (f.x < f.y) { k = k + 10; }
    if (load32(&f) == 0xC0100000) { k = k + 100; }
    return k;
}
fn f_round(): i64 { var f = F2 { 0.0, 0.0 }; f.y = 0.1; return load32(&f + 4); }
fn f_local(): i64 { var s: f32 = 1.25; var f = F2 { 0.0, 7.0 }; f.x = s; return load32(&f) * 10 + f64_to(f32_to(f.y)); }

# ── literals ──
fn lit_pos(): i64 { var c = C4 { 1, 2, 3, 4 }; return load32(&c); }
fn lit_named(): i64 { var c = C4 { a: 4, r: 1, b: 3, g: 2 }; return load32(&c); }
fn lit_nested(): i64 {
    var n = NC { 5, 6, 7, 8, 0xBEEF, 0xFFFFFFFF };
    if (n.c.r != 5) { return 1; }
    if (n.c.a != 8) { return 2; }
    if (n.x != 0xBEEF) { return 3; }
    if (n.y != 0xFFFFFFFF) { return 4; }
    if (load16(&n + 4) != 0xBEEF) { return 5; }
    return 0;
}
fn lit_nested_val(): i64 { var c = C4 { 9, 8, 7, 6 }; var n = NC { c, 1, 2 }; return n.c.b * 100 + n.x * 10 + n.y; }
fn lit_f(): i64 {
    var b = B10 { 0xFFFF, 0xFFFFFFFE, 1.5 };
    return load32(&b + 6) - 0x3FC00000 + b.a - 0xFFFF + b.b - 0xFFFFFFFE;
}

# ── operators and self ──
fn op_c4(): i64 {
    var x = C4 { 250, 1, 2, 3 };
    var y = C4 { 10, 2, 3, 4 };
    var z: C4 = x + y;
    return z.r * 1000 + z.g * 100 + z.b * 10 + z.a;
}
fn op_f2(): i64 {
    var u = F2 { 1.5, 2.0 };
    var v = F2 { 0.25, 0.5 };
    var s: F2 = u + v;
    return f64_to(f32_to(s.x) * 4.0) * 100 + f64_to(f32_to(s.y) * 4.0);
}
fn self_val(): i64 { var x = C4 { 250, 1, 2, 3 }; return x.lum(); }
fn self_untyped(): i64 { var x = C4 { 250, 1, 2, 3 }; return x.first(); }
fn self_f2(): i64 { var u = F2 { 1.5, 2.0 }; return u.sum4(); }

# ── *C4 steps 4; C4[2] is 8 bytes ──
fn arr_step(): i64 {
    var p: *C4 = &GA;
    var p1: *C4 = p + 1;
    p1.a = 0xFF;
    p1.r = 0x11;
    if (load8(&GA + 7) != 0xFF) { return 1; }
    if (load8(&GA + 4) != 0x11) { return 2; }
    if (GAG != 0x5A) { return 3; }
    var la: C4[2];
    var lp: *C4 = &la;
    lp = lp + 1;
    lp.g = 9;
    if (load8(&la + 5) != 9) { return 4; }
    return 0;
}

# ── a shrunk struct at the handle line (B7-1): from an address it is a handle ──
fn hl_alloc(): i64 {
    var c: C4 = alloc(4);
    c.r = 5;
    c.a = 0xFE;
    var m = load64(&c);
    return load8(m) * 1000 + load8(m + 3);
}
fn hl_addr(): i64 {
    var m = alloc(8);
    store64(m, 0);
    var c: C4 = m;
    c.g = 7;
    c.a = 9;
    if (load8(m + 4) != 0) { return 0 - 1; }
    return load32(m);
}

alloc_init();
var GL = B10 { c: 2.5, a: 0x1234, b: 0x89ABCDEF };
assert_eq(sizeof(A9), 9, "sizeof { u8; i64 } is 9 (was 16)");
assert_eq(sizeof(B10), 10, "sizeof { u16; u32; f32 } is 10 (was 24)");
assert_eq(sizeof(C4), 4, "sizeof { u8 x4 } is 4 (was 32)");
assert_eq(sizeof(U4), 4, "sizeof union { u8; u32; f32 } is 4 (was 8)");
assert_eq(sizeof(NC), 10, "sizeof { C4; u16; u32 } is 10 (nested)");
assert_eq(sizeof(M9), 9, "sizeof { u64; u8 } is 9: u64 stays 8 bytes");
assert_eq(sizeof(MX), 18, "sizeof { i8; u8; i16; u16; i32; u32; f32 } is 18");
assert_eq(sizeof(F2), 8, "sizeof { f32; f32 } is 8 (was 16)");
assert_eq(sizeof(WD), 16, "sizeof { u8; i32; i8; i16; i64 } is 16");
assert_eq(off_b10(), 0, "offsets { u16; u32; f32 }: 0 / 2 / 6, nothing at 10");
assert_eq(off_nc(), 0, "offsets { C4; u16; u32 }: c.b at 2, x at 4, y at 6");
assert_eq(off_mx(), 0, "offsets { i8; u8; i16; u16; i32; u32; f32 }: 1 / 4 / 10 / 14");
assert_eq(off_u4(), 0, "union { u8; u32; f32 }: every field at 0, 4 bytes");
assert_eq(off_m9(), 0, "{ u64; u8 }: b at 8, a full 64-bit a");
assert_eq(zx_u8(), 255252, "u8 255 / 252 read zero-extended (not -1 / -4)");
assert_eq(zx_u16(), 65535, "u16 0xFFFF reads 65535");
assert_eq(zx_u32(), 4294967295, "u32 0xFFFFFFFF reads 4294967295");
assert_eq(zx_cmp(), 1, "u8 200 > 100 (an unsigned read)");
assert_eq(zx_shr(), 100, "u8 200 >>= 1 is 100");
assert_eq(zx_div(), 10327670000000, "u8 200 /= 2, u16 0xFFFE /= 2, u32 0xFFFFFFFC /= 4: unsigned dividends");
assert_eq(wr_inc(), 254, "u8 255 += 1 wraps to 0, its neighbour kept");
assert_eq(wr_add(), 4681, "u8 250 += 10 is 4 (it was 260); the i32 / i8 / i64 after it kept");
assert_eq(wr_mul(), 2520904, "u8 254 *= 2 is 252, the neighbours kept");
assert_eq(wr_u32m(), 4294967295, "u32 0 -= 1 is 0xFFFFFFFF, the u16 before it kept");
assert_eq(wr_u16i(), 9, "u16 0xFFFF += 1 wraps to 0, the u32 after it kept");
assert_eq(wr_store(), 12553, "u8 = 0x1FF stores its byte (255), the neighbours kept");
assert_eq(wr_store32(), 591751049, "u32 = 0x123456789 stores its 4 bytes");
assert_eq(ptr_rw(), 0, "*B10 at an unaligned heap address: each field's bytes only, read back zero-extended");
assert_eq(f_bits(), 106954752000, "f32 fields hold binary32 bits at offsets 0 and 4");
assert_eq(f_sum(), 15, "f.x + f.y (f32) is 3.75");
assert_eq(f_mul(), 6, "f.x *= 2.0f");
assert_eq(f_cmp(), 111, "f32 field compares; a negative's bits");
assert_eq(f_round(), 1036831949, "0.1 into an f32 field rounds to binary32 (0x3DCCCCCD)");
assert_eq(f_local(), 10674503687, "an f32 local into an f32 field: its 4 bytes");
assert_eq(lit_pos(), 67305985, "a positional C4 literal in a fn: 01 02 03 04");
assert_eq(lit_named(), 67305985, "a named C4 literal in a fn");
assert_eq(lit_nested(), 0, "a nested literal { C4 { .. }, u16, u32 } in a fn");
assert_eq(lit_nested_val(), 712, "a nested literal taking a C4 value");
assert_eq(lit_f(), 0, "a { u16; u32; f32 } literal in a fn");
assert_eq(load32(&GD), 67305985, "a declaration-zone C4 literal: 01 02 03 04");
assert_eq(GDN.c.r * 100 + GDN.c.a, 508, "a declaration-zone nested literal: c");
assert_eq(GDN.x, 0xBEEF, "a declaration-zone nested literal: the u16 after the C4");
assert_eq(GDN.y, 4294967295, "a declaration-zone nested literal: the u32, zero-extended");
assert_eq(load16(&GDN + 4), 0xBEEF, "a declaration-zone nested literal: x at offset 4");
assert_eq(GDF.a * 10 + GDF.b - 0xFFFFFFFE, 655350, "a declaration-zone { u16; u32; f32 } literal");
assert_eq(load32(&GDF + 6), 0x3FC00000, "a declaration-zone f32 field: 1.5's binary32 bits at offset 6");
var GLK = load16(&GL) + load32(&GL + 2) - 0x89ABCDEF + load32(&GL + 6) - 0x40200000;
assert_eq(GLK, 0x1234, "a named { u16; u32; f32 } literal after the first statement: 0 / 2 / 6");
assert_eq(op_c4(), 4357, "C4_add: the u8 channels wrap (250 + 10 = 4)");
assert_eq(op_f2(), 710, "F2_add: f32 field sums");
assert_eq(self_val(), 256, "a by-value self: C4 (4 B)");
assert_eq(self_untyped(), 250, "an untyped self on a C4");
assert_eq(self_f2(), 14, "a by-value self: F2 (8 B)");
assert_eq(arr_step(), 0, "*C4 + 1 steps 4 bytes; C4[2] is 8 (the u8 global after it kept)");
assert_eq(hl_alloc(), 5254, "var c: C4 = alloc(4) is a handle: c.r = 5 reaches the heap");
assert_eq(hl_addr(), 150996736, "var c: C4 = m (an address) is a handle: its 4 bytes, nothing past them");
assert_eq(sizeof(Z1), 1, "1 B { u8 }: sizeof");
assert_eq(sizeof(W1), 3, "1 B { u8 }: a field between two u8 guards");
