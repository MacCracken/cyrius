assert_eq(zr1(), 241, "1 B { u8 }: a struct return");
assert_eq(zq1(), 241, "1 B { u8 }: q = a (a copy, not an alias)");
assert_eq(zg1(), 241, "1 B { u8 }: a value global store, the u8 global after it kept");
assert_eq(zf1(), 241, "1 B { u8 }: a field store, the guard fields kept");
assert_eq(zc1(), 241, "1 B { u8 }: a closure capture");
