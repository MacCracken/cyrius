# ns_rootfs_syscalls.tcyr — v6.6.8: sys_unshare / sys_chroot / sys_pivot_root /
# sys_capget / sys_capset / sys_process_vm_readv / sys_process_vm_writev / sys_mknodat reach
# THE CALL THEIR NAME CLAIMS on every target that has it, and decline honestly elsewhere.
#
# ⛔ WHY THIS FILE LIVES IN `crossos/`. None of these calls had a name in either Linux peer,
# so consumers wrote numbers — and on ELF-aarch64 every number they could write ran a
# different call, with a clean build and no diagnostic. Measured on the 6.6.7 tree under
# `qemu-aarch64 -strace`:
#
#     161 (x86 chroot)          → sethostname(...) = -1 EPERM
#     272 (x86 unshare)         → kcmp(...)        = -1 ESRCH
#     155 (x86 pivot_root)      → getpgid(...)     = -1 ESRCH
#     125 / 126 (capget/capset) → sched_get_priority_max / _min  (shakti's cap drop: a no-op)
#     310 / 311 / 259           → Unknown syscall  (ENOSYS)
#
# and the aarch64-NATIVE spellings of chroot (51) and pivot_root (41) never reached the
# kernel as themselves: the x86-compat rows getsockname 51→204 and socket 41→198 claim them.
# mknodat's native 33 is the dup2 33→dup3 row source, which is why vani's aarch64 FIFO tests
# got -9 (EBADF from dup3) and had to be skipped.
#
# ⚠ EVERY ASSERTION PINS A VALUE ONLY THE RIGHT CALL PRODUCES, unprivileged, never a bare
# "it failed" — each wrong call above FAILS too, so a test that accepts any error cannot tell
# them apart (the statfs_family.tcyr lesson):
#   * unshare(0) is a valid no-op → 0.            kcmp answers -ESRCH.
#   * chroot(missing) resolves the path first → -ENOENT for every caller.  sethostname: EPERM.
#   * pivot_root(missing, missing) → -EPERM unprivileged, -ENOENT with CAP_SYS_ADMIN.
#                                                  getpgid answers -ESRCH.
#   * capget(bad version, NULL) → 0 AND rewrites hdr.version to 0x20080522.  The scheduler
#     calls answer -EINVAL and write nothing.
#   * capset(current caps) → 0.                   sched_get_priority_min: -EINVAL.
#   * process_vm_readv/writev on this process copy the bytes.   ENOSYS copies none.
#   * mknodat(S_IFIFO) creates a node that stat reports as a FIFO.  dup3 answers -EBADF.
# CHANGELOG [6.6.8]
#
# On cx (6.7.16's D75, the user, 2026-10-20): cxvm serves unshare and the FIFO's mknodat / stat,
# and answers -38 for chroot, pivot_root, capget, capset, process_vm_readv / writev and unlinkat
# (6.7.14's D55: an unlisted number never reaches the host). Each of those rows prints
# `not run: this host has no <call> route` instead of failing — the compile-time cx check of
# 6.7.16's D28 (`_no_route`); the x86_64 cxvm reads 4 passed, 0 failed.
# ⚠ NOT under qemu-aarch64: qemu-user does not implement process_vm_readv / process_vm_writev
# (-38, 5 rows RED: 14 passed, 5 failed), and on aarch64 a -38 is this file's own defect signature
# (a number routed to no call), so no row there is excused — the rows are green on real pi, which
# is where the cross-OS leg runs them. Reproduce aarch64 failures of this file on pi, not qemu
# (docs/development/dev-tools-linux.md).
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"

fn _check_audit_arch(): i64 {
    #ifdef CYRIUS_ARCH_X86
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    assert_eq(AUDIT_ARCH_NATIVE, 0xC000003E, "AUDIT_ARCH_NATIVE is AUDIT_ARCH_X86_64");
    #endif
    #endif
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    assert_eq(AUDIT_ARCH_NATIVE, 0xC00000B7, "AUDIT_ARCH_NATIVE is AUDIT_ARCH_AARCH64");
    #endif
    return 0;
}

# 1 when a seccomp FILTER is active on this process (/proc/self/status "Seccomp:\t2").
# Docker's default profile is one, and the AGNOS CI job runs this suite inside a container.
fn _seccomp_filtered(): i64 {
    var fd = sys_open("/proc/self/status", 0, 0);
    if (fd < 0) { return 0; }
    var buf[4096];
    var n = sys_read(fd, &buf, 4095);
    sys_close(fd);
    if (n <= 0) { return 0; }
    store8(&buf + n, 0);
    if (strstr(&buf, "Seccomp:\t2") >= 0) { return 1; }
    return 0;
}

# 6.7.16's D75 (6.7.16's D28's shape): on cx a row whose call answered -38 — cxvm's answer for a
# number it has no route for — is named as not run instead of failing. _no_route(r, call) is `call`
# when that is so (cx only, a compile-time check), else 0; _not_run prints the line.
fn _no_route(r, call): i64 {
    #ifdef CYRIUS_TARGET_CX
    if (r == 0 - 38) { return call; }
    #endif
    return 0;
}
fn _not_run(call, name): i64 {
    var a = "  not run: this host has no ";
    var b = " route: ";
    sys_write(1, a, strlen(a));
    sys_write(1, call, strlen(call));
    sys_write(1, b, strlen(b));
    sys_write(1, name, strlen(name));
    sys_write(1, "\n", 1);
    return 0;
}

# The eight wrappers on a target that has none of these calls: each returns `want`.
fn _check_declines(want, label): i64 {
    var hdr[8];
    var buf[32];
    assert_eq(sys_unshare(0), want, label);
    assert_eq(sys_chroot("/cyr_no_such_root"), want, label);
    assert_eq(sys_pivot_root("/cyr_nx_a", "/cyr_nx_b"), want, label);
    assert_eq(sys_capget(&hdr, 0), want, label);
    assert_eq(sys_capset(&hdr, &buf), want, label);
    assert_eq(sys_process_vm_readv(1, &buf, 1, &buf, 1, 0), want, label);
    assert_eq(sys_process_vm_writev(1, &buf, 1, &buf, 1, 0), want, label);
    assert_eq(sys_mknodat(0 - 100, "cyr_no_node", 4480, 0), want, label);
    return 0;
}

fn main(): i64 {
    alloc_init();
    _check_audit_arch();

    #ifdef CYRIUS_TARGET_MACOS
    test_group("v6.6.8 — Darwin declines all eight with -78 (ENOSYS) and never emits the number");
    _check_declines(0 - 78, "declines with -78 on macOS");
    # 6.7.16: one exception — a FIFO at AT_FDCWD (or an absolute path) is made over Darwin's mknod
    # (the x86 133, routed to BSD 14 on both Macs), for cxvm's mknodat. _check_declines' mknodat
    # is relative to Linux's -100, a dirfd Darwin's mknod cannot take, so it still declines.
    # CHANGELOG [6.7.16]
    test_group("6.7.16 — Darwin makes a FIFO over mknod; any other node still declines");
    var mf = test_scratch("cyr_mknod_fifo");
    sys_unlink(mf);
    assert_eq(sys_mknodat(AT_FDCWD, mf, 4096 | 384, 0), 0,
      "mknodat(AT_FDCWD, S_IFIFO|0600) makes the FIFO (-78 until 6.7.16)");
    var mst[STAT_BUFSZ];
    assert_eq(sys_stat(mf, &mst), 0, "the node exists");
    assert_eq(load32(&mst + STAT_MODE) & 61440, 4096, "stat reports it as a FIFO (S_IFIFO)");
    assert_eq(sys_mknodat(AT_FDCWD, mf, 4096 | 384, 0), 0 - 17, "a second mknodat is -EEXIST");
    assert_eq(sys_unlink(mf), 0, "the FIFO unlinks");
    assert_eq(sys_mknodat(AT_FDCWD, mf, 32768 | 384, 0), 0 - 78,
      "a regular-file node (S_IFREG) still declines with -78");
    #endif

    #ifdef CYRIUS_TARGET_WIN
    test_group("v6.6.8 — PE declines all eight with -38 (ENOSYS)");
    _check_declines(0 - 38, "declines with -38 on Windows");
    #endif

    #ifdef CYRIUS_TARGET_AGNOS
    test_group("v6.6.8 — agnos declines all eight with -38 (ENOSYS)");
    _check_declines(0 - 38, "declines with -38 on agnos");
    #endif

    #ifndef CYRIUS_TARGET_MACOS
    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    test_group("v6.6.8 — unshare / chroot / pivot_root reach the kernel as themselves");
    # unshare(0) has NO permission check, so the only -EPERM it can return is a seccomp filter
    # denying the syscall itself — Docker's default profile does, and the AGNOS CI job runs this
    # file in a container (6.6.8's first CI run went red here). Accepted only when a filter is
    # really active; the wrong call (kcmp on aarch64) answers -ESRCH either way.
    var un = sys_unshare(0);
    var un_ok = 0;
    if (un == 0) { un_ok = 1; }
    if (un == 0 - 1) { if (_seccomp_filtered() == 1) { un_ok = 1; } }
    assert_eq(un_ok, 1, "unshare(0) is 0, or -EPERM under a seccomp filter (kcmp answered -ESRCH)");
    var ch = sys_chroot("/cyr_no_such_root_6_6_8");
    var chc = _no_route(ch, "chroot");
    if (chc == 0) {
        assert_eq(ch, 0 - 2, "chroot(missing path) is -ENOENT (sethostname answered -EPERM)");
    } else { _not_run(chc, "chroot(missing path) is -ENOENT"); }
    var pr = sys_pivot_root("/cyr_no_such_new_root", "/cyr_no_such_put_old");
    var pr_ok = 0;
    if (pr == 0 - 1) { pr_ok = 1; }     # EPERM: no CAP_SYS_ADMIN (checked before the paths)
    if (pr == 0 - 2) { pr_ok = 1; }     # ENOENT: privileged, and the paths do not exist
    var prc = _no_route(pr, "pivot_root");
    if (prc == 0) {
        assert_eq(pr_ok, 1, "pivot_root(missing) is -EPERM or -ENOENT (getpgid answered -ESRCH)");
    } else { _not_run(prc, "pivot_root(missing) is -EPERM or -ENOENT"); }

    test_group("v6.6.8 — capget / capset reach the capability calls");
    var hdr[8];
    store32(&hdr, 0);                   # a version the kernel does not know
    store32(&hdr + 4, 0);               # pid 0 = self
    var cg = sys_capget(&hdr, 0);
    var cgc = _no_route(cg, "capget");
    if (cgc == 0) {
        assert_eq(cg, 0, "capget(bad version, NULL) probes and returns 0");
        assert_eq(load32(&hdr), 0x20080522,
          "capget wrote _LINUX_CAPABILITY_VERSION_3 into hdr.version (nothing else writes it)");
    } else {
        _not_run(cgc, "capget(bad version, NULL) probes and returns 0");
        _not_run(cgc, "capget wrote _LINUX_CAPABILITY_VERSION_3 into hdr.version");
    }
    var data[24];
    var z = 0;
    while (z < 24) { store8(&data + z, 0); z = z + 1; }
    store32(&hdr, 0x20080522);
    store32(&hdr + 4, 0);
    var cg2 = sys_capget(&hdr, &data);
    var cg2c = _no_route(cg2, "capget");
    if (cg2c == 0) {
        assert_eq(cg2, 0, "capget(v3, self) reads this thread's capability sets");
    } else { _not_run(cg2c, "capget(v3, self) reads this thread's capability sets"); }
    store32(&hdr, 0);
    store32(&hdr + 4, 0);
    var cg3 = sys_capget(&hdr, &data);
    var cg3c = _no_route(cg3, "capget");
    if (cg3c == 0) {
        assert_eq(cg3, 0 - 22, "capget(bad version, data) is -EINVAL");
    } else { _not_run(cg3c, "capget(bad version, data) is -EINVAL"); }
    store32(&hdr, 0x20080522);
    store32(&hdr + 4, 0);
    var cur[24];
    var cg4 = sys_capget(&hdr, &cur);
    var cg4c = _no_route(cg4, "capget");
    if (cg4c == 0) {
        assert_eq(cg4, 0, "capget reads the sets to write back");
    } else { _not_run(cg4c, "capget reads the sets to write back"); }
    var cs = sys_capset(&hdr, &cur);
    var csc = _no_route(cs, "capset");
    if (csc == 0) {
        assert_eq(cs, 0, "capset(the current sets) is allowed and returns 0 (sched_get_priority_min: -EINVAL)");
    } else { _not_run(csc, "capset(the current sets) is allowed and returns 0"); }

    test_group("v6.6.8 — process_vm_readv / writev copy memory on this process");
    var src[16];
    store64(&src, 0x0123456789ABCDEF);
    store64(&src + 8, 0x7EDCBA9876543210);
    var dst[16];
    store64(&dst, 0);
    store64(&dst + 8, 0);
    var liov[16];
    var riov[16];
    store64(&liov, &dst);
    store64(&liov + 8, 16);
    store64(&riov, &src);
    store64(&riov + 8, 16);
    var me = sys_getpid();
    var rv = sys_process_vm_readv(me, &liov, 1, &riov, 1, 0);
    var rvc = _no_route(rv, "process_vm_readv");
    if (rvc == 0) {
        assert_eq(rv, 16, "process_vm_readv copied 16 bytes");
        assert_eq(load64(&dst), 0x0123456789ABCDEF, "process_vm_readv: first word arrived");
        assert_eq(load64(&dst + 8), 0x7EDCBA9876543210, "process_vm_readv: second word arrived");
    } else {
        _not_run(rvc, "process_vm_readv copied 16 bytes");
        _not_run(rvc, "process_vm_readv: first word arrived");
        _not_run(rvc, "process_vm_readv: second word arrived");
    }
    var dst2[16];
    store64(&dst2, 0);
    store64(&dst2 + 8, 0);
    store64(&liov, &src);               # local = source, remote = destination
    store64(&riov, &dst2);
    var wv = sys_process_vm_writev(me, &liov, 1, &riov, 1, 0);
    var wvc = _no_route(wv, "process_vm_writev");
    if (wvc == 0) {
        assert_eq(wv, 16, "process_vm_writev copied 16 bytes");
        assert_eq(load64(&dst2 + 8), 0x7EDCBA9876543210, "process_vm_writev: the bytes landed");
    } else {
        _not_run(wvc, "process_vm_writev copied 16 bytes");
        _not_run(wvc, "process_vm_writev: the bytes landed");
    }

    test_group("v6.6.8 — mknodat makes a FIFO (vani's named-FIFO tests, skipped on aarch64)");
    var fifo = test_scratch("cyr_mknodat_fifo");
    # A killed earlier run cannot poison this one (pid-named); on cx through unlink (no unlinkat route).
    if (_no_route(sys_unlinkat(AT_FDCWD, fifo, 0), "unlinkat") != 0) { sys_unlink(fifo); }
    assert_eq(sys_mknodat(AT_FDCWD, fifo, 4096 | 384, 0), 0,
      "mknodat(AT_FDCWD, S_IFIFO|0600) succeeds (native 33 ran dup3: -EBADF)");
    var st[STAT_BUFSZ];
    assert_eq(sys_stat(fifo, &st), 0, "the node exists");
    assert_eq(load32(&st + STAT_MODE) & 61440, 4096, "stat reports it as a FIFO (S_IFIFO)");
    var ul = sys_unlinkat(AT_FDCWD, fifo, 0);
    var ulc = _no_route(ul, "unlinkat");
    if (ulc == 0) {
        assert_eq(ul, 0, "the FIFO unlinks");
    } else {
        _not_run(ulc, "the FIFO unlinks");
        sys_unlink(fifo);               # not a row: the node must not outlive the run (cxvm serves unlink)
    }
    #endif
    #endif
    #endif

    return assert_summary();
}
var ec = main();
syscall(60, ec);
