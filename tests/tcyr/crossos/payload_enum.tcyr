# payload_enum.tcyr — v6.5.55. RUNS the payload-variant constructor on real hardware.
#
# WHY THIS IS IN crossos/. The release gate's four-host leg (ecb macOS-arm64, ach Intel-Mac,
# cass Windows/PE, pi aarch64) COMPILED the payload-variant lowering on every target and never
# RAN it. Proven with the compiler's own reachability pass: `CYRIUS_DCE_VERBOSE=1` on the five
# crossos files that pull in lib/result.cyr / lib/tagged.cyr lists `dead: Ok`, `dead: Err`,
# `dead: Some`, `dead: Left`, `dead: Right` — the constructors were linked out as unreachable.
# The other 57 files never mention them. So a payload-enum representation defect shipped GREEN
# through all four hosts on real hardware.
#
# ⭐ This is the macOS-rot shape exactly: a target the gate compiles for but never exercises.
# `src/` has no payload enum anywhere, so the self-host fixpoint cannot cover it either — the
# cross-host coverage has to be a file that CONSTRUCTS and READS one on the host.
#
# ⚠ `load64(box + 8)` is the only expressible payload read (the language has no destructuring;
# PARSE_MATCH takes constant-valued arms). If the representation changes, change the read and
# keep every assertion — what is pinned is that simultaneously-live values stay distinct.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/result.cyr"
include "lib/tagged.cyr"
include "lib/assert.cyr"

enum Wire { Ping(v); Pong(a, b); Idle; }

# Two live values from ONE textual call site — the shape that per-call-site storage aliases.
fn _mk(n): i64 { return Ok(n); }

fn _two_live(): i64 {
    var a = _mk(11);
    var b = _mk(22);
    if (load64(a + 8) != 11) { return 1; }
    if (load64(b + 8) != 22) { return 2; }
    if (a == b) { return 3; }
    return 0;
}

fn _retain(): i64 {
    var keep: i64[16];
    var i = 0;
    while (i < 16) {
        if (i % 2 == 0) { store64(&keep + i * 8, _mk(100 + i)); }
        else { store64(&keep + i * 8, Err(200 + i)); }
        i = i + 1;
    }
    var bad = 0;
    i = 0;
    while (i < 16) {
        var wt = 1; var wp = 200 + i;
        if (i % 2 == 0) { wt = 0; wp = 100 + i; }
        var box = load64(&keep + i * 8);
        if (load64(box) != wt) { bad = bad + 1; }
        if (load64(box + 8) != wp) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

test_group("payload-enum constructor on this host");
assert_eq(_two_live(), 0, "two live values from one call site are distinct");
assert_eq(_retain(), 0, "16 simultaneously-live values keep their tags and payloads");

test_group("tags, arities and edge payloads on this host");
var p = Ping(41);
var q = Pong(5, 6);
assert_eq(load64(p), 0, "Ping tag");
assert_eq(load64(p + 8), 41, "Ping payload");
assert_eq(load64(q), 1, "Pong tag");
assert_eq(load64(q + 8), 5, "Pong field 0");
assert_eq(load64(q + 16), 6, "Pong field 1");
assert_eq(Idle, 2, "bare constant variant is its discriminant");

var z = Ok(0);
var neg = Err(0 - 1);
var big = Ok(4611686018427387904);
assert_eq(load64(z + 8), 0, "payload 0");
assert_eq(load64(neg + 8), 0 - 1, "payload -1");
assert_eq(load64(big + 8), 4611686018427387904, "payload 2^62");
assert_neq(load64(z), load64(Err(0)), "Ok(0) and Err(0) differ in tag");

test_group("Option/Either constructors run here too");
var s = Some(7);
assert_eq(load64(s + 8), 7, "Some payload");
assert_eq(is_ok(Ok(1)), 1, "is_ok");
assert_eq(is_err_result(Err(1)), 1, "is_err_result");

var r = assert_summary();
