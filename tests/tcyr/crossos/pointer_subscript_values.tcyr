# ---- top level: statements through a global `*T` ----
zero();
G16 = &BUF;
G16[3] = 0 - 2;
G16[3] *= 21;
assert_eq(G16[3], 0 - 42, "top level: G[3] = -2; G[3] *= 21 on a global *i16");
assert_eq(load16(&BUF + 6), 65494, "top level: element 3 is bytes 6..7");
var r = assert_summary();
