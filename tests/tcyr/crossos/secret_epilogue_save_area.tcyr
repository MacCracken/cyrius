# secret_epilogue_save_area.tcyr — CVE-69 (6.6.15): a fn's epilogue leaves NO copy of its return
# registers in dead stack after its `secret var` wipe.
#
# ⛔ The defer walker (`_defer_emit_walk`, which every fn holding a `defer` or a `secret var` runs
# on every return) saves the WHOLE return convention in a 64-byte area below sp — x86_64: rax,
# rdx, r8, the entry rsp, xmm0, xmm1; aarch64: x0-x3, q0, q1 — runs the blocks (the secret wipe
# among them), reloads the registers, and released the area WITHOUT clearing it. So every
# `secret var` fn wrote whatever those registers held into dead stack AFTER its own wipe. In
# sigil 3.13.7, xmm1 still held the HMAC_DRBG's last SHA-NI state at `ecdsa_p256_sign`'s return
# — the RFC 6979 nonce k — and k plus one signature is the private key.
#
# How: `_load_markers` puts a distinct marker in every register the walker saves and returns
# (its own epilogue touches none of them); `_sec_regs` calls it as its LAST statement and falls
# off its end, so nothing but the epilogue sees them. Its caller then calls `_window`, whose
# uninitialised array covers the released frames and the stack below them, and counts markers.
# Controls keep the count honest:
#   - `_deep_plain` leaves all eight markers in a frame at the depth the save area occupies,
#     with no `secret`: the window MUST see them, or it is not looking where the area was;
#   - `_plain_regs` is `_sec_regs` without `secret` (so no walker): zero before and after the
#     fix — the markers the secret row counted came from the epilogue, not from the helper;
#   - `_defer_regs` holds a plain `defer` instead: the same walker and area, cleared the same.
# The value rows check that the registers the walker hands back are intact after the clear.
#
# ⚠ CROSS-HOST: the area and its release are emitted per backend — x86 (ELF, PE and x86 Mach-O
# share the emitter) and aarch64 (ELF, Mach-O). Measured before the fix: 7 of 7 markers on
# x86_64 (rax rdx r8, xmm0 and xmm1 both halves), 8 of 8 on aarch64.
include "lib/string.cyr"
include "lib/assert.cyr"
include "lib/simd.cyr"

# Marker k (1..8) = MK_BASE + k * 0x10000 = 0x5EC0_0000_000k_A5A5. `_window` recognises a marker
# arithmetically and keeps no copy of one in its own frame, so it cannot count itself.
var MK_BASE = 0x5EC000000000A5A5;
fn _mk(k): i64 { return MK_BASE + k * 0x10000; }

var _sink = 0;
var _got = 0;

# x86: rax=1 rdx=2 r8=3 xmm0=[4,5] xmm1=[6,7]; aarch64: x0=1 x1=2 x2=3 x3=8 q0=[4,5] q1=[6,7].
# x9 / x10 / xmm2 are scratch no epilogue saves (xmm2 is cleared again).
fn _load_markers(): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        0x48; 0xB8; 0xA5; 0xA5; 0x04; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M4
        0x66; 0x48; 0x0F; 0x6E; 0xC0;                                 # movq xmm0, rax
        0x48; 0xB8; 0xA5; 0xA5; 0x05; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M5
        0x66; 0x48; 0x0F; 0x6E; 0xD0;                                 # movq xmm2, rax
        0x66; 0x0F; 0x6C; 0xC2;                                       # punpcklqdq xmm0, xmm2
        0x48; 0xB8; 0xA5; 0xA5; 0x06; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M6
        0x66; 0x48; 0x0F; 0x6E; 0xC8;                                 # movq xmm1, rax
        0x48; 0xB8; 0xA5; 0xA5; 0x07; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M7
        0x66; 0x48; 0x0F; 0x6E; 0xD0;                                 # movq xmm2, rax
        0x66; 0x0F; 0x6C; 0xCA;                                       # punpcklqdq xmm1, xmm2
        0x66; 0x0F; 0xEF; 0xD2;                                       # pxor xmm2, xmm2
        0x48; 0xBA; 0xA5; 0xA5; 0x02; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rdx, M2
        0x49; 0xB8; 0xA5; 0xA5; 0x03; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs r8, M3
        0x48; 0xB8; 0xA5; 0xA5; 0x01; 0x00; 0x00; 0x00; 0xC0; 0x5E;   # movabs rax, M1
    }
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    asm {
        0xA9; 0xB4; 0x94; 0xD2;   # movz x9, #0xA5A5
        0x89; 0x00; 0xA0; 0xF2;   # movk x9, #4, lsl #16
        0x09; 0xD8; 0xEB; 0xF2;   # movk x9, #0x5EC0, lsl #48
        0x20; 0x01; 0x67; 0x9E;   # fmov d0, x9
        0xAA; 0xB4; 0x94; 0xD2;   # movz x10, #0xA5A5
        0xAA; 0x00; 0xA0; 0xF2;   # movk x10, #5, lsl #16
        0x0A; 0xD8; 0xEB; 0xF2;   # movk x10, #0x5EC0, lsl #48
        0x40; 0x1D; 0x18; 0x4E;   # mov v0.d[1], x10
        0xA9; 0xB4; 0x94; 0xD2;   # movz x9, #0xA5A5
        0xC9; 0x00; 0xA0; 0xF2;   # movk x9, #6, lsl #16
        0x09; 0xD8; 0xEB; 0xF2;   # movk x9, #0x5EC0, lsl #48
        0x21; 0x01; 0x67; 0x9E;   # fmov d1, x9
        0xAA; 0xB4; 0x94; 0xD2;   # movz x10, #0xA5A5
        0xEA; 0x00; 0xA0; 0xF2;   # movk x10, #7, lsl #16
        0x0A; 0xD8; 0xEB; 0xF2;   # movk x10, #0x5EC0, lsl #48
        0x41; 0x1D; 0x18; 0x4E;   # mov v1.d[1], x10
        0xA1; 0xB4; 0x94; 0xD2;   # movz x1, #0xA5A5
        0x41; 0x00; 0xA0; 0xF2;   # movk x1, #2, lsl #16
        0x01; 0xD8; 0xEB; 0xF2;   # movk x1, #0x5EC0, lsl #48
        0xA2; 0xB4; 0x94; 0xD2;   # movz x2, #0xA5A5
        0x62; 0x00; 0xA0; 0xF2;   # movk x2, #3, lsl #16
        0x02; 0xD8; 0xEB; 0xF2;   # movk x2, #0x5EC0, lsl #48
        0xA3; 0xB4; 0x94; 0xD2;   # movz x3, #0xA5A5
        0x03; 0x01; 0xA0; 0xF2;   # movk x3, #8, lsl #16
        0x03; 0xD8; 0xEB; 0xF2;   # movk x3, #0x5EC0, lsl #48
        0xA0; 0xB4; 0x94; 0xD2;   # movz x0, #0xA5A5
        0x20; 0x00; 0xA0; 0xF2;   # movk x0, #1, lsl #16
        0x00; 0xD8; 0xEB; 0xF2;   # movk x0, #0x5EC0, lsl #48
    }
    #endif
}

fn _sec_regs(): i64 {
    secret var key[32];
    store64(&key, 0x7E7E);
    _load_markers();
}
fn _plain_regs(): i64 {
    var key[32];
    store64(&key, 0x7E7E);
    _load_markers();
}
fn _defer_regs(): i64 {
    defer { _sink = _sink + 1; }
    var key[32];
    store64(&key, 0x7E7E);
    _load_markers();
}

# All eight markers in a frame one level below a frame shaped like `_sec_regs`'s — where its save
# area sits.
fn _put_markers(): i64 {
    var a: i64[8];
    var k = 0;
    while (k < 8) { store64(&a + k * 8, _mk(k + 1)); k = k + 1; }
    return 0;
}
fn _deep_plain(): i64 {
    var key[32];
    store64(&key, 0x7E7E);
    _put_markers();
    return 0;
}

# Distinct markers in the uninitialised 4 KB below this frame's top (a bitmask, so a marker that
# appears twice counts once and the anti-vacuous row can demand all eight).
fn _window(): i64 {
    var w: i64[512];
    var seen = 0;
    var d = 0;
    var i = 0;
    while (i < 512) {
        d = load64(&w + i * 8) - MK_BASE;
        if ((d & 0xFFFF) == 0 && d >= 0x10000 && d <= 0x80000) { seen = seen | (1 << ((d >> 16) - 1)); }
        i = i + 1;
    }
    return seen;
}
fn _popcount(x): i64 { var n = 0; while (x != 0) { n = n + (x & 1); x = x >> 1; } return n; }

# Each row starts from zeroed dead stack: without it a row would count what the PREVIOUS row's
# epilogue left behind (measured — the no-walker control read 6 of the secret row's markers).
fn _scrub(): i64 { var pad: i64[1024]; memset(&pad, 0, 8192); return 0; }

fn row_deep_plain(): i64 { _deep_plain(); return _window(); }
fn row_secret(): i64 { _got = _sec_regs(); return _window(); }
fn row_plain_regs(): i64 { _got = _plain_regs(); return _window(); }
fn row_defer(): i64 { _got = _defer_regs(); return _window(); }

# --- the walker hands back every return register intact after the clear ----------------------
fn _sec_pair(a, b): i64 { secret var key[16]; store64(&key, a); return (a, b); }
fn _sec_triple(a, b, c): i64 { secret var key[16]; store64(&key, a); return (a, b, c); }
fn _sec_f64(a): f64 { secret var key[16]; store64(&key, a); var x: f64 = f64_from(a); return x / 4.0; }
fn _sec_v4(): f64v4 { secret var key[16]; store64(&key, 9); var v: f64v4 = f64v4_make(31, 32, 33, 34); return v; }

fn main(): i64 {
    alloc_init();

    test_group("the window sees the depth the save area occupies (anti-vacuous)");
    _scrub();
    assert_eq(row_deep_plain(), 255, "all eight markers left one frame down are visible to the window");

    test_group("a secret var fn's epilogue leaves no return register in dead stack");
    _scrub();
    var s = row_secret();
    assert_eq(_popcount(s), 0, "secret var: no marker survives the epilogue (bitmask in the next row)");
    assert_eq(s, 0, "secret var: marker bitmask (bit k-1 = marker k)");
    assert_eq(_got, _mk(1), "secret var: the return value survives the clear");

    test_group("controls");
    _sink = 0;
    _scrub();
    var d = row_defer();
    assert_eq(d, 0, "plain defer: the same walker, the same clear");
    assert_eq(_sink, 1, "plain defer: the block ran");
    assert_eq(_got, _mk(1), "plain defer: the return value survives the clear");
    _scrub();
    assert_eq(row_plain_regs(), 0, "no defer, no walker: no marker (the helper itself spills none)");
    assert_eq(_got, _mk(1), "no defer: the helper's return value");

    test_group("values the walker restores after the clear");
    var pa, pb = _sec_pair(7, 99);
    assert_eq(pa * 1000 + pb, 7099, "secret var: (a, b) return");
    var ta, tb, tc = _sec_triple(7, 99, 55);
    assert_eq(ta * 10000 + tb * 100 + tc, 79955, "secret var: (a, b, c) return");
    var fr: f64 = _sec_f64(10);
    assert_eq(f64_to(fr * 10.0), 25, "secret var: f64 return");
    var v4: f64v4 = _sec_v4();
    var l01 = f64v4_lane0_ptr(&v4) * 100 + f64v4_lane1_ptr(&v4);
    var l23 = f64v4_lane2_ptr(&v4) * 100 + f64v4_lane3_ptr(&v4);
    assert_eq(l01 * 10000 + l23, 31323334, "secret var: f64v4 return (xmm0:xmm1 / q0:q1)");

    var r = assert_summary();
    return r;
}
var ec = main();
syscall(60, ec);
