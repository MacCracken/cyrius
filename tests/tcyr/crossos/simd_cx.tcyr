# simd_cx.tcyr — cross-OS gate for the FLAT-ARRAY SIMD intrinsics over LOCAL arrays.
# Every packed op here is pure-memory (`&dst,&a,&b,n` pointers) — no value-form params or
# returns — so it runs on all four backends: x86 SSE, aarch64 NEON, Win64 PE, and (the point
# of this gate) the cx bytecode VM, where v6.4.32 added the scalar per-lane emitters. Uses
# LOCAL arrays specifically to exercise the v6.4.32 cx frame-addressing fixes (ELOAD_LOCAL_ADDR
# stub + the EFLLOAD/EFLSTORE/pair regalloc-offset unification) — before those, `&local`
# aliased on cx. f64 bit patterns via f64_from(int); f32 as raw i32 lane bits.
include "lib/assert.cyr"
include "lib/syscalls.cyr"
# NOTE: the flat-array SIMD verbs (f64v_*/f32v_*/iv_*) are compiler BUILTINS — no
# lib/simd.cyr needed. (simd.cyr also drags in value-form wrappers whose vec_get
# dep + cx value-form gaps are irrelevant to this flat-array gate.)

fn main(): i64 {
    test_group("flat-array SIMD over local arrays (x86/aarch64/PE/cx)");
    var A[64]; var B[64]; var R[64]; var C[64];

    # --- f64 packed add / sub / mul / div ---
    store64(&A + 0, f64_from(10)); store64(&A + 8, f64_from(20));
    store64(&B + 0, f64_from(3));  store64(&B + 8, f64_from(4));
    f64v_add(&R, &A, &B, 2);
    assert_eq(f64_to(load64(&R + 0)), 13, "f64v_add lane0 = 10+3");
    assert_eq(f64_to(load64(&R + 8)), 24, "f64v_add lane1 = 20+4");
    f64v_mul(&R, &A, &B, 2);
    assert_eq(f64_to(load64(&R + 0)), 30, "f64v_mul lane0 = 10*3");
    assert_eq(f64_to(load64(&R + 8)), 80, "f64v_mul lane1 = 20*4");

    # --- f64 dot / fmadd / scale / sqrt (keystone verbs) ---
    assert_eq(f64_to(f64v_dot(&A, &B, 2)), 110, "f64v_dot = 10*3 + 20*4 = 110");
    store64(&C + 0, f64_from(1)); store64(&C + 8, f64_from(1));
    f64v_fmadd(&R, &A, &B, &C, 2);
    assert_eq(f64_to(load64(&R + 0)), 31, "f64v_fmadd lane0 = 10*3+1");
    f64v_scale(&R, &A, f64_from(2), 2);
    assert_eq(f64_to(load64(&R + 0)), 20, "f64v_scale lane0 = 10*2");
    store64(&A + 0, f64_from(9)); store64(&A + 8, f64_from(16));
    f64v_sqrt(&R, &A, 2);
    assert_eq(f64_to(load64(&R + 0)), 3, "f64v_sqrt lane0 = sqrt(9)");
    assert_eq(f64_to(load64(&R + 8)), 4, "f64v_sqrt lane1 = sqrt(16)");

    # --- f32 packed add (bit-exact: 2.0f + 3.0f = 5.0f) ---
    store32(&A + 0, 0x40000000); store32(&A + 4, 0x40000000);
    store32(&B + 0, 0x40400000); store32(&B + 4, 0x40400000);
    f32v_add(&R, &A, &B, 2);
    assert_eq(load32(&R + 0), 0x40A00000, "f32v_add lane0 = 5.0f");
    assert_eq(load32(&R + 4), 0x40A00000, "f32v_add lane1 = 5.0f");

    # --- integer vectors: packed i32 add + int8 widening dot (signed) ---
    store32(&A + 0, 100); store32(&A + 4, 200);
    store32(&B + 0, 7);   store32(&B + 4, 8);
    iv_add(&R, &A, &B, 2, 4);
    assert_eq(load32(&R + 0), 107, "iv_add i32 lane0 = 107");
    assert_eq(load32(&R + 4), 208, "iv_add i32 lane1 = 208");
    var i = 0; while (i < 16) { store8(&A + i, 2); store8(&B + i, 3); i = i + 1; }
    assert_eq(iv_dp8(&A, &B, 16), 96, "iv_dp8 u8=2 * i8=3 over 16 = 96");
    i = 0; while (i < 16) { store8(&B + i, 255); i = i + 1; }
    assert_eq(iv_dp8(&A, &B, 16), 0 - 32, "iv_dp8 signed i8=-1 → -32");

    # --- i64 packed multiply (v6.4.53, iv_mul w=8): native 64-bit lane on cx (load64/MUL/store64),
    #     pmuludq synthesis on x86/PE, extract/mul/insert on aarch64 NEON. lane1 = 2^32+1 forces
    #     the high-word cross term, so a naive 32-bit-only path would drop it. ---
    store64(&A + 0, 1000000); store64(&A + 8, 4294967297);
    store64(&B + 0, 3);       store64(&B + 8, 3);
    iv_mul(&R, &A, &B, 2, 8);
    assert_eq(load64(&R + 0), 3000000, "iv_mul i64 lane0 = 1000000*3 = 3000000");
    assert_eq(load64(&R + 8), 12884901891, "iv_mul i64 lane1 = (2^32+1)*3 (cross term kept)");

    # NB: `return assert_summary()` DIRECTLY, not via a `var ec` local — the cx
    # backend mis-captures `var x = assert_summary()` when a prior assert_eq has
    # mutated the assert globals (pre-existing cx bug, reproduces on v6.4.31 with
    # zero SIMD/arrays; filed 2026-07-09-cx-var-capture-after-global-mutation).
    # The direct return sidesteps it and keeps success == exit 0 on all backends.
    return assert_summary();
}
var rc = main();
syscall(60, rc);
