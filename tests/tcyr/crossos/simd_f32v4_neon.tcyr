# simd_f32v4_neon.tcyr — cross-OS gate for f32v4 packed ops. Two groups:
#   1) RAW flat-array intrinsics (f32v_add/sub/mul/fmadd/dot over pointers) — exercises the
#      packed-op emitters directly: x86 SSE (addps/subps/mulps + haddps) and aarch64 NEON
#      (.4s fadd/fsub/fmul + faddp, SIMD Phase 5 v6.4.28).
#   2) VALUE-FORM params + returns (f32v4_make/splat/add/lane0/dot) — v6.4.31 added the Win64
#      PE by-pointer param + retptr return ABI, so the value-form surface now runs on ALL FOUR
#      hosts (x86-Linux + aarch64 + macOS + Win64 PE), not just the non-PE corpus. `f32v4_splat`
#      is `return f32v4_make(...)` — a SIMD-returning call in a return (retptr tail path).
# f32 bit patterns: 1.0f=0x3F800000, 2.0f=0x40000000, 3.0f=0x40400000, 8.0f=0x41000000.
include "lib/assert.cyr"
include "lib/vec.cyr"      # v6.4.31: simd.cyr's value-form wrappers reference vec_get
include "lib/simd.cyr"
include "lib/syscalls.cyr"

# v6.4.53 (issue 2026-07-08): value-form SIMD call with a DUPLICATED arg in a tail-call
# return — f(v, v). The tail-call path marshaled value-form vector args through INTEGER
# registers (no XMM/q-reg second pass), so the duplicated local left the 2nd vector reg
# stale and the callee read garbage for arg 2. Distinct args survived by luck; only the
# dup exposed it. Fix: divert value-form-SIMD-param callees off the tail path to the
# normal PARSE_FNCALL path (which has the XMM/q-reg second pass) on ALL targets. This runs
# the exact broken path — dup arg through a tail-call return — on every cross-OS host.
fn dbl_v(v: f32v4): f32v4 { return f32v4_add(v, v); }

fn main(): i64 {
    test_group("f32v4 packed ops — raw flat-array intrinsics (x86 SSE / aarch64 NEON)");
    var a[16]; var b[16]; var r[16];   # 4 f32 lanes each (16 bytes)
    store32(&a + 0, 0x40000000); store32(&a + 4, 0x40000000);   # a = 2.0f x4
    store32(&a + 8, 0x40000000); store32(&a + 12, 0x40000000);
    store32(&b + 0, 0x3F800000); store32(&b + 4, 0x3F800000);   # b = 1.0f x4
    store32(&b + 8, 0x3F800000); store32(&b + 12, 0x3F800000);

    f32v_add(&r, &a, &b, 4);                                     # 2+1 = 3.0f
    assert_eq(load32(&r + 0),  0x40400000, "f32v_add lane0 = 3.0f");
    assert_eq(load32(&r + 12), 0x40400000, "f32v_add lane3 = 3.0f (all 4 lanes)");

    f32v_sub(&r, &a, &b, 4);                                     # 2-1 = 1.0f
    assert_eq(load32(&r + 4),  0x3F800000, "f32v_sub lane1 = 1.0f");

    f32v_mul(&r, &a, &b, 4);                                     # 2*1 = 2.0f
    assert_eq(load32(&r + 8),  0x40000000, "f32v_mul lane2 = 2.0f");

    f32v_fmadd(&r, &a, &b, &b, 4);                               # 2*1+1 = 3.0f
    assert_eq(load32(&r + 0),  0x40400000, "f32v_fmadd lane0 = 2*1+1 = 3.0f");
    assert_eq(load32(&r + 12), 0x40400000, "f32v_fmadd lane3 = 3.0f");

    var dt = f32v_dot(&a, &b, 4);                                # sum(2*1)x4 = 8.0f
    assert_eq(dt, 0x41000000, "f32v_dot(2.0x4 · 1.0x4) = 8.0f");

    # 8-lane dot exercises 2 loop iterations of the packed op.
    var a8[32]; var b8[32];
    var i = 0;
    while (i < 8) { store32(&a8 + i * 4, 0x40000000); store32(&b8 + i * 4, 0x3F800000); i = i + 1; }
    var dt8 = f32v_dot(&a8, &b8, 8);                             # sum(2*1)x8 = 16.0f
    assert_eq(dt8, 0x41800000, "f32v_dot over 8 lanes (2 iters) = 16.0f");

    # --- v6.4.31 value-form params + returns (now cross-OS, incl. Win64 PE) ---
    test_group("f32v4 value-form params + returns (Win64 by-ptr param + retptr return)");
    var va: f32v4 = f32v4_make(0x40000000, 0x40000000, 0x40000000, 0x40000000);  # 2.0f x4
    var vb: f32v4 = f32v4_splat(0x3F800000);                                       # return f32v4_make(...)
    assert_eq(f32v4_lane0(va), 0x40000000, "value-form lane0(va) = 2.0f (by-ptr param)");
    assert_eq(f32v4_lane0(vb), 0x3F800000, "f32v4_splat → return f32v4_make(...) lane0 = 1.0f");
    var vr: f32v4 = f32v4_add(va, vb);                                             # 3.0f (2 by-ptr params + retptr)
    assert_eq(f32v4_lane0(vr), 0x40400000, "f32v4_add(value) lane0 = 3.0f");
    assert_eq(f32v4_lane3(vr), 0x40400000, "f32v4_add(value) lane3 = 3.0f (all 16 bytes)");
    var vm: f32v4 = f32v4_mul(va, vb);                                             # 2.0f (2 by-ptr params + retptr)
    assert_eq(f32v4_lane0(vm), 0x40000000, "f32v4_mul(value) lane0 = 2.0f");
    assert_eq(f32v4_dot(va, vb), 0x41000000, "f32v4_dot(value) = 8.0f");

    # --- v6.4.53 duplicate-arg tail-call fix: dbl_v(v) = f32v4_add(v, v) via a tail return ---
    test_group("f32v4 value-form DUPLICATE-arg tail call (v6.4.53)");
    var dv: f32v4 = f32v4_splat(0x40000000);                                       # 2.0f x4
    var dd: f32v4 = dbl_v(dv);                                                      # add(v,v) = 4.0f x4
    assert_eq(f32v4_lane0(dd), 0x40800000, "dbl_v(2.0f) lane0 = 4.0f (dup arg, tail call)");
    assert_eq(f32v4_lane1(dd), 0x40800000, "dbl_v(2.0f) lane1 = 4.0f (2nd reg not stale)");
    assert_eq(f32v4_lane3(dd), 0x40800000, "dbl_v(2.0f) lane3 = 4.0f (all 16 bytes)");

    var ec = assert_summary();
    return ec;
}
var rc = main();
syscall(60, rc);
