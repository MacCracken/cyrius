# simd_pointer_param.tcyr — 6.7.11: a pointer-to-vector PARAMETER (`p: *f64v2`) is a pointer: one
# integer word whose step is the vector's size, as a `*f64v2` local is. A vector passed to it passes its
# ADDRESS, as a struct passed to a `*T` parameter does (6.6.20) — the user's decision, 2026-10-13: (a).
#
# ⛔ THE DEFECT, 6.6.10 - 6.7.10. Both parameter scans consumed the `*` and classified the bare vector
# name, so the parameter was a VALUE-form vector (XMM / V registers; on Win64 a by-pointer copy-in) and
# every caller routed it as one: `rd(&b)` was refused "value-form SIMD arg must be a local IDENT", and
# `rd(b)` compiled and the body dereferenced lane 0's bits as an address (SIGSEGV; cx "guest address
# out of range"). A vector of another type into `*V` is refused by name (param_type_grammar's sibling
# gate, tests/gates/codegen/simd_pointer_param.sh).
# Filed: docs/development/issues/archived/2026-10-10-pointer-to-vector-parameter-is-value-form.md
# Run on x86_64 / IR / DCE / aarch64 / cx / PE by tests/gates/codegen/simd_pointer_param.sh, on the
# four hardware hosts by the release gate's cross-OS leg — Win64 routed this through its by-pointer
# value-form path, so cass is the leg that matters most.
#
# 6.7.12 (D27, the user, 2026-10-15: B): a vector VALUE that is not a named local passes an address too —
# a call result (by name, parenthesised, `fncallN(&f, ..)` / `callptr(&f, ..)`, a tail position) through a
# frame temp it is received into, a dereference `*pv` of a `*V` (a local, a parameter, a capture, a field, a
# global, a `: *V` call, `pv + n`) as pv itself — and `*f32v8` is a `*V` (`r8(e)` passes `&e`). They passed
# lane 0's bits as the address (139 / 139 / a cx fault / PE 5; x86_64 refused the first two through 6.7.10).
# Filed: docs/development/issues/archived/2026-10-13-vector-value-into-pointer-parameter-passes-lane-bits.md
include "lib/syscalls.cyr"
include "lib/assert.cyr"
include "lib/simd.cyr"
include "lib/fnptr.cyr"

struct Sv { k; }

# --- reads through `*V`, each vector type ----------------------------------------------------------
fn sp_lo(p: *f64v2): i64 { return load64(p); }
fn sp_hi(p: *f64v2): i64 { var q = p; return load64(q + 8); }   # an untyped copy steps bytes
fn sp_w3(p: *f64v4): i64 { var q = p; return load64(q + 24); }
fn sp_f4(p: *f32v4): i64 { var q = p; return load32(q + 12); }
fn sp_i4(p: *i32v4): i64 { var q = p; return load32(q + 8); }
fn sp_i64v2(p: *i64v2): i64 { var q = p; return load64(q + 8); }
# --- the step: `p + 1` is one whole vector -----------------------------------------------------------
fn sp_step2(p: *f64v2): i64 { var a = p + 1; var b = p; return a - b; }
fn sp_step4(p: *f64v4): i64 { var a = p + 1; var b = p; return a - b; }
fn sp_next(p: *f64v2): i64 { return load64(p + 1); }        # the second vector's lane 0
fn sp_next4(p: *f64v4): i64 { return load64(p + 1); }
# --- writes reach the caller's vector -----------------------------------------------------------------
fn sp_wr(p: *f64v2, v): i64 { store64(p, v); return 0; }
# --- mixed signatures: the XMM / V ordinals count only the value-form vectors -----------------------
fn sp_mix(v: f64v2, p: *f64v2): i64 { return load64(&v + 8) * 100 + load64(p); }
fn sp_mix2(p: *f64v2, v: f64v2, k): i64 { return load64(p) * 100 + load64(&v) + k; }
fn sp_mix3(a: f64v4, p: *f32v4, b: f64v2): i64 {
    var q = p;
    return load64(&a + 24) * 10000 + load32(q) * 100 + load64(&b + 8);
}
fn sp_seventh(a, b, c, d, e, f, p: *f64v2): i64 { return load64(p) + a; }   # stack-passed on SysV / Win64
# --- a method, a generic, a call handed on, a tail position -------------------------------------------
impl Sv {
    fn rdm(self, p: *f64v2): i64 { return load64(p) + self.k; }
}
fn sp_gen<T>(p: *f64v2, x: T): i64 { return load64(p) + x; }
fn sp_pass(p: *f64v2): i64 { return sp_lo(p); }
fn sp_vparam(v: f64v2): i64 { return sp_hi(v); }             # a value-form parameter handed to `*V`
fn sp_tail(b: f64v2): i64 { return sp_hi(b); }
fn sp_tail2(): i64 { var c: f64v2 = f64v2_make(5, 6); return sp_hi(c); }   # its frame outlives the call

# --- 6.7.12 (D27): a vector value that is not a named local --------------------------------------
struct Hv { k; pv: *f64v2; }
var GPV: *f64v2 = 0;
fn sp_mkv(a, b): f64v2 { return f64v2_make(a, b); }
fn sp_mkv4(d): f64v4 { return f64v4_make(1, 2, 3, d); }
fn sp_mk8(a): f32v8 { return f32v8_make(a, 2, 3, 4, 5, 6, 7, a + 1); }
fn sp_mkg<T>(a: T, b): f64v2 { return f64v2_make(a, b); }
fn sp_f8(p: *f32v8): i64 { var q = p; return load32(q) * 100 + load32(q + 28); }
fn sp_gpv(p: *f64v2): *f64v2 { return p; }
fn sp_tcall(): i64 { return sp_hi(sp_mkv(5, 61)); }       # a call result in a tail position
fn sp_tderef(p: *f64v2): i64 { return sp_hi(*p); }        # a parameter's dereference, in a tail position
impl Sv {
    fn rdh(self, p: *f64v2): i64 { var q = p; return load64(q + 8) + self.k; }
}

fn sp_vrows(): i64 {
    var b: f64v2 = f64v2_make(11, 22);
    var pb: *f64v2 = &b;
    assert_eq(sp_lo(sp_mkv(42, 7)), 42, "D27: rd(mkv(..)) passes a temp's address");
    assert_eq(sp_hi(sp_mkv(42, 7)), 7, "D27: rd(mkv(..)), lane 1");
    assert_eq(sp_lo((sp_mkv(43, 7))), 43, "D27: rd((mkv(..)))");
    assert_eq(sp_hi(fncall2(&sp_mkv, 44, 8)), 8, "D27: rd(fncall2(&mkv, ..))");
    assert_eq(sp_lo(callptr(&sp_mkv, 45, 9)), 45, "D27: rd(callptr(&mkv, ..))");
    assert_eq(sp_lo(callptr((&sp_mkv), 42, 2)), 42, "D27: rd(callptr((&mkv), ..)), the callee wrapped (6.7.13: 139 before)");
    assert_eq(sp_hi(fncall2(((&sp_mkv)), 44, 9)), 9, "D27: rd(fncall2(((&mkv)), ..)), lane 1");
    assert_eq(sp_tcall(), 61, "D27: a call result in a tail position");
    assert_eq(sp_lo(sp_mkg(46, 1)), 46, "D27: an inferred generic call result");
    assert_eq(sp_w3(sp_mkv4(47)), 47, "D27: a 32-byte call result (*f64v4)");
    var s: Sv;
    s.k = 100;
    assert_eq(s.rdh(sp_mkv(1, 48)), 148, "D27: a method's argument");
    assert_eq(sp_lo(*pb), 11, "D27: rd(*pb) passes pb");
    assert_eq(sp_hi(*pb), 22, "D27: rd(*pb), lane 1");
    assert_eq(sp_lo((*pb)), 11, "D27: rd((*pb))");
    assert_eq(sp_tderef(pb), 22, "D27: a *V parameter's dereference, in a tail position");
    assert_eq(sp_lo(*sp_gpv(pb)), 11, "D27: the dereference of a : *V call");
    var h: Hv;
    h.pv = &b;
    assert_eq(sp_hi(*h.pv), 22, "D27: the dereference of a *V field");
    GPV = &b;
    assert_eq(sp_lo(*GPV), 11, "D27: the dereference of a *V global");
    var two: f64v2[2];
    store64(&two + 16, 31);
    var pt: *f64v2 = &two;
    assert_eq(sp_lo(*(pt + 1)), 31, "D27: rd(*(pv + 1)) is the next vector");
    var cl = |x| sp_hi(*pb) + x;
    assert_eq(fncall1(cl, 1), 23, "D27: a captured *V's dereference");
    assert_eq(s.rdh(*pb), 122, "D27: a method's argument, dereferenced");
    var e: f32v8 = f32v8_make(42, 2, 3, 4, 5, 6, 7, 8);
    assert_eq(sp_f8(e), 4208, "D27: *f32v8: r8(e) passes &e");
    assert_eq(sp_f8(&e), 4208, "D27: *f32v8: r8(&e)");
    assert_eq(sp_f8(sp_mk8(50)), 5051, "D27: *f32v8: a call result");
    return 0;
}

# ⛔ 6.7.13 — a vector METHOD result and an explicit-instance result into `*V` (D27's call-result rule once the sources
# are typed: issues/archived/2026-10-15-vector-value-into-other-pointer-or-byvalue-struct-and-unreceived-call-sources.md rows
# 6-7): `rd(s.mv(42, 7))` and `rd(mkg<i64>(42, 7))` pushed lane 0 as the address (139 / cx 253 / PE 5; PE 7 for the
# method). On Win64 the method's hidden result pointer is the temp's, before `self`, which must stay intact.
struct Smv { k; j; }
impl Smv {
    fn mv(self, a, b): f64v2 { return f64v2_make(a + self.k, b); }
    fn m4(self, d): f64v4 { return f64v4_make(1, 2, 3, d + self.k); }
    fn mg<T>(self, a: T): f64v2 { return f64v2_make(a, self.j); }
}
fn sp_mrows(): i64 {
    var s: Smv;
    s.k = 0;
    s.j = 9;
    assert_eq(sp_lo(s.mv(42, 7)), 42, "6.7.13: rd(s.mv(42, 7)), a method result (the filed row 6)");
    assert_eq(sp_hi(s.mv(42, 7)), 7, "6.7.13: rd(s.mv(42, 7)), lane 1");
    assert_eq(sp_lo((s.mv(43, 7))), 43, "6.7.13: rd((s.mv(..))), parenthesised");
    assert_eq(sp_w3(s.m4(47)), 47, "6.7.13: a 32-byte method result (*f64v4)");
    assert_eq(sp_hi(s.mg(5)), 9, "6.7.13: a generic method's result");
    var sv: Sv;
    sv.k = 100;
    assert_eq(sv.rdh(s.mv(1, 48)), 148, "6.7.13: a method result as a method's argument");
    var ps: *Smv = &s;
    assert_eq(sp_lo(ps.mv(44, 1)), 44, "6.7.13: through a *Smv receiver");
    assert_eq(s.k * 10 + s.j, 9, "6.7.13: the receiver untouched by the hidden result pointer (PE)");
    assert_eq(sp_lo(sp_mkg<i64>(42, 7)), 42, "6.7.13: rd(mkg<i64>(42, 7)), an explicit instance (the filed row 7)");
    assert_eq(sp_hi(sp_mkg<i32>(1, 8)), 8, "6.7.13: rd(mkg<i32>(..)), a real instance, lane 1");
    return 0;
}

# Value-form vector parameters (6.7.14: a capture and a `*V` dereference passed to them, D31 / D32).
fn sp_vl(x: f64v2): i64 { if (load64(&x) == 999) { return 0; } return load64(&x) * 100 + load64(&x + 8); }
fn sp_vl4(x: f64v4): i64 { if (load64(&x) == 999) { return 0; } return load64(&x) * 1000 + load64(&x + 24); }
fn sp_vbump(x: f64v2): i64 { store64(&x, 99); return load64(&x); }   # writes its own copy

# ⛔ 6.7.13 (D32 A, the user's decision, 2026-10-15) — a closure's captured vector meets the local's argument rules: into a
# `*V` of its type it passes the capture's address (both lanes are the captured copy's), and into a pointer of another kind
# it is refused by name, as the local is (D27; the refusals are tests/gates/codegen/simd_pointer_param.sh CR rows).
# issues/archived/2026-10-15-captured-vector-into-other-pointer-kind-passes-capture-address.md
fn sp_crows(): i64 {
    var b: f64v2 = f64v2_make(11, 22);
    var w: f64v4 = f64v4_make(1, 2, 3, 44);
    var f: f32v4 = f32v4_make(5, 6, 7, 88);
    var c1 = |k| sp_lo(b) * 100 + sp_hi(b) + k;
    assert_eq(fncall1(c1, 0), 1122, "6.7.13 D32: a captured f64v2 into *f64v2 passes the capture's address, both lanes");
    var c2 = |k| sp_w3(w) + k;
    assert_eq(fncall1(c2, 1), 45, "6.7.13 D32: a captured f64v4 into *f64v4, lane 3");
    var c3 = |k| sp_f4(f) + k;
    assert_eq(fncall1(c3, 0), 88, "6.7.13 D32: a captured f32v4 into *f32v4, lane 3");
    var c4 = |k| sp_hi((b)) + k;
    assert_eq(fncall1(c4, 0), 22, "6.7.13 D32: a captured vector, parenthesised");
    var s: Sv;
    s.k = 100;
    var c5 = |k| s.rdm(b) + k;
    assert_eq(fncall1(c5, 0), 111, "6.7.13 D32: a captured vector into a method's *V parameter");
    var c6 = |k| sp_wr(b, 77) + sp_lo(b) + k;
    assert_eq(fncall1(c6, 0), 77, "6.7.13 D32: a write through *V reaches the closure's captured copy");
    assert_eq(load64(&b), 11, "6.7.13 D32: ... not the enclosing local (captured by value)");
    # 6.7.14 (D31 A, the user's decision, 2026-10-16): and into a VALUE-form parameter it passes the vector, as the local
    # does (it was refused on every target). issues/archived/2026-10-16-captured-vector-into-value-form-parameter-refused.md
    var c7 = |k| sp_vl(b) + k;
    assert_eq(fncall1(c7, 0), 1122, "6.7.14 D31: a captured f64v2 into x: f64v2, both lanes");
    var c8 = |k| sp_vl4(w) + k;
    assert_eq(fncall1(c8, 0), 1044, "6.7.14 D31: a captured f64v4 into x: f64v4, lanes 0 and 3");
    var c9 = |k| sp_vbump(b) + sp_lo(b) + k;
    assert_eq(fncall1(c9, 0), 110, "6.7.14 D31: the callee's write stays in its copy (the capture keeps 11)");
    return 0;
}

# ⛔ 6.7.13 — a dereference of an ADDRESS-OF a vector, or of a `**V`, is the vector: `rd(*&b)`, `rd(*(&b))` and
# `rd(**ppb)` into `*V` pass `&b` / `*ppb` (they pushed lane 0 as the address: 139 / cx 253 / PE 5).
# issues/archived/2026-10-15-vector-deref-through-address-of-or-double-pointer-into-vector-pointer-param.md
var GDV: f64v2 = 0;
fn sp_dparam(x: f64v2): i64 { return sp_hi(*&x); }
fn sp_drows(): i64 {
    var b: f64v2 = f64v2_make(11, 22);
    var pb: *f64v2 = &b;
    var ppb: **f64v2 = &pb;
    assert_eq(sp_lo(*&b), 11, "6.7.13: rd(*&b) passes &b, lane 0");
    assert_eq(sp_hi(*&b), 22, "6.7.13: rd(*&b), lane 1");
    assert_eq(sp_hi(*(&b)), 22, "6.7.13: rd(*(&b))");
    assert_eq(sp_hi((*&b)), 22, "6.7.13: rd((*&b))");
    assert_eq(sp_lo(**ppb), 11, "6.7.13: rd(**ppb) passes *ppb, lane 0");
    assert_eq(sp_hi(**ppb), 22, "6.7.13: rd(**ppb), lane 1");
    var w: f64v4 = f64v4_make(1, 2, 3, 44);
    assert_eq(sp_w3(*&w), 44, "6.7.13: rd(*&w) into *f64v4, lane 3");
    assert_eq(sp_dparam(b), 22, "6.7.13: rd(*&x), x a value-form parameter");
    var c = |k| sp_hi(*&b) + k;
    assert_eq(fncall1(c, 1), 23, "6.7.13: rd(*&b), b a closure's capture");
    store64(&GDV, 31);
    store64(&GDV + 8, 32);
    assert_eq(sp_hi(*&GDV), 32, "6.7.13: rd(*&G), G a vector global");
    sp_wr(*&b, 77);
    assert_eq(load64(&b), 77, "6.7.13: a write through rd(*&b) reaches b");
    # 6.7.14 (D32 A, the user's decision, 2026-10-16): into a VALUE-form parameter `*pv` is the vector, copied through the
    # pointer (refused on x86_64 / aarch64 / cx; PE faulted, exit 5).
    # issues/archived/2026-10-16-vector-dereference-into-value-form-parameter-faults-on-pe.md
    assert_eq(sp_vl(*pb), 7722, "6.7.14 D32: lanes(*pb) into x: f64v2, both lanes");
    assert_eq(sp_vl((**ppb)), 7722, "6.7.14 D32: lanes((**ppb)), wrapped, through a **f64v2");
    var pw: *f64v4 = &w;
    assert_eq(sp_vl4(*pw), 1044, "6.7.14 D32: an f64v4 *pw into x: f64v4");
    assert_eq(sp_vbump(*pb) + load64(&b), 176, "6.7.14 D32: the callee's write stays in its copy (b keeps 77)");
    return 0;
}

# ⛔ 6.7.14 — D31 / D32's value-form call as an ARGUMENT of an `#inline` fn inside a closure: the copy's frame temp is
# taken while the replay evaluates its arguments, then given back, and a closure's frame was sized from its local count
# alone (never the high-water a plain fn's frame takes), so the temp lay below rsp and the next push overwrote it —
# a wrong value on x86_64 / IR=3 / PE, a fault on aarch64. Integer-only inline calls in a closure met it too (26, 57).
# issues/archived/2026-10-16-captured-vector-into-value-form-parameter-refused.md (the vectors lane's review)
#inline
fn sp_li(a: i64, b: i64): i64 { return a + b; }
fn sp_vln(x: f64v2, n): i64 { if (n == 999) { return 0; } return load64(&x) * 100 + load64(&x + 8) + n; }
fn sp_irows(): i64 {
    var b: f64v2 = f64v2_make(11, 22);
    var pb: *f64v2 = &b;
    var c1 = |k| sp_li(sp_vl(b), k);
    assert_eq(fncall1(c1, 1), 1123, "6.7.14: |k| li(lanes(b), k), a capture");
    var c2 = |k| sp_li(sp_vl(*pb), k);
    assert_eq(fncall1(c2, 1), 1123, "6.7.14: |k| li(lanes(*pb), k), a *V dereference");
    var c3 = |k| sp_li(sp_vl(sp_mkv(4, 2)), k);
    assert_eq(fncall1(c3, 1), 403, "6.7.14: |k| li(lanes(mkv(4, 2)), k), a call");
    var c4 = |k| sp_li(sp_vln(b, sp_wr(pb, 7)), k);
    assert_eq(fncall1(c4, 1), 1123, "6.7.14: a capture copied before a later argument writes b");
    sp_wr(pb, 11);
    var c5 = |k| sp_li(sp_vln(*pb, sp_wr(pb, 7)), k);
    assert_eq(fncall1(c5, 1), 1123, "6.7.14: *pb copied where it stands, before a later argument writes it");
    assert_eq(sp_lo(pb), 7, "6.7.14: ... and the write reached b");
    var c6 = |k| sp_li(k, 1) + sp_li(k + 1, sp_li(k, 2)) + sp_li(sp_li(k, 3), k);
    assert_eq(fncall1(c6, 10), 57, "6.7.14: integer #inline calls nested in a closure");
    return 0;
}

fn sp_rows(): i64 {
    var b: f64v2 = f64v2_make(11, 22);
    var w: f64v4 = f64v4_make(1, 2, 3, 44);
    var f: f32v4 = f32v4_make(5, 6, 7, 88);
    var iv: i32v4 = i32v4_make(9, 10, 77, 12);
    var lv: i64v2;
    store64(&lv, 13);
    store64(&lv + 8, 66);
    # the filed shapes: `rd(&b)` and `rd(b)` both pass b's address
    assert_eq(sp_lo(&b), 11, "*f64v2: rd(&b) reads lane 0");
    assert_eq(sp_lo(b), 11, "*f64v2: rd(b) passes b's address (lane 0)");
    assert_eq(sp_hi(b), 22, "*f64v2: rd(b), lane 1");
    var pl: *f64v2 = &b;
    assert_eq(sp_lo(pl), 11, "*f64v2: a *f64v2 local passes its value");
    var up = &b;
    assert_eq(sp_hi(up), 22, "*f64v2: an untyped pointer");
    assert_eq(sp_w3(w), 44, "*f64v4: rd(w), lane 3");
    assert_eq(sp_w3(&w), 44, "*f64v4: rd(&w), lane 3");
    assert_eq(sp_f4(f), 88, "*f32v4: rd(f), lane 3");
    assert_eq(sp_i4(iv), 77, "*i32v4: rd(iv), lane 2");
    assert_eq(sp_i64v2(lv), 66, "*i64v2: rd(lv), lane 1");
    assert_eq(sp_step2(&b), 16, "*f64v2: p + 1 steps 16");
    assert_eq(sp_step4(&w), 32, "*f64v4: p + 1 steps 32");
    var two: f64v2[2];
    store64(&two + 16, 31);
    assert_eq(sp_next(&two), 31, "*f64v2: load64(p + 1) is the next vector");
    var two4: f64v4[2];
    store64(&two4 + 32, 41);
    assert_eq(sp_next4(&two4), 41, "*f64v4: load64(p + 1) is the next vector");
    sp_wr(b, 99);
    assert_eq(load64(&b), 99, "*f64v2: a write through p reaches b");
    store64(&b, 11);
    var m: f64v2 = f64v2_make(3, 4);
    assert_eq(sp_mix(m, b), 411, "(v: f64v2, p: *f64v2)");
    assert_eq(sp_mix2(b, m, 5), 1108, "(p: *f64v2, v: f64v2, k)");
    assert_eq(sp_mix3(w, f, m), 440504, "(a: f64v4, p: *f32v4, b: f64v2)");
    assert_eq(sp_seventh(1, 2, 3, 4, 5, 6, b), 12, "*f64v2 as the seventh (stack) parameter");
    var s: Sv;
    s.k = 100;
    assert_eq(s.rdm(b), 111, "*f64v2 on an impl method");
    assert_eq(sp_gen(b, 1000), 1011, "*f64v2 on a generic");
    assert_eq(sp_pass(&b), 11, "*f64v2 handed on as a pointer");
    assert_eq(sp_vparam(m), 4, "a value-form parameter passed to *f64v2");
    assert_eq(sp_tail(b), 22, "a value-form parameter passed in a tail position");
    assert_eq(sp_tail2(), 6, "a local passed in a tail position");
    assert_eq(sp_lo((b)), 11, "*f64v2: rd((b)) — the parentheses are transparent");
    assert_eq(sp_fwd(b), 22, "*f64v2 on a fn defined below (pass 1)");
    assert_eq(fncall1(&sp_lo, &b), 11, "fncall1(&rd, &b): the pointer in an integer register");
    assert_eq(callptr(&sp_hi, &b), 22, "callptr(&rd, &b)");
    return 0;
}
fn sp_fwd(p: *f64v2): i64 { var q = p; return load64(q + 8); }

sp_rows();
sp_vrows();
sp_mrows();
sp_crows();
sp_drows();
sp_irows();
var r = assert_summary();
