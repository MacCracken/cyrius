# simd_value_return_binding.tcyr — v6.5.61: a value-form vector return must survive
# EVERY binding form, not just `var r: <exact type> = f(...)`.
#
# THE DEFECT. The 16/32-byte receive paths in PARSE_VAR were gated entirely on the var's
# own type annotation, so only one spelling stored the whole vector:
#   var r: f64v2 = f64v2_add(a, b);   OK — the only form the corpus ever used
#   var r      = f64v2_add(a, b);     lanes read back as ZERO   (no annotation → scalar init)
#   var r: f64v2;  r = f64v2_add(a, b);   lanes read back as ZERO   (assignment path had no
#                                          receive at all — 8-byte EFLSTORE)
#   var r: f64v4 = f64v2_add(a, b);   lanes read back as ZERO   (mismatch fell through)
# All silent: exit 0, no diagnostic, wrong numbers. Every width (f32v4 → garbage, f64v2 → 0,
# f64v4 → 0) and every vector-returning fn, user-defined as well as stdlib.
#
# ⭐ WHY THIS LIVES IN crossos/ AND NOT simd/. The fix is ABI-shaped on two axes that a
# Linux run cannot see. (1) The SysV/aarch64 receive stores a REGISTER PAIR
# (EFLSTORE_F64V2_PAIR / _F64V4_PAIR); the Win64 receive instead passes the destination
# address as a hidden arg 0 and the callee writes through it. Those are different code
# paths, and the assignment-form branch is NEW on both. (2) `simd_has_avx2()` returns 0 on
# every non-x86 target, so ecb/ach/pi exercise the 128-bit kernel underneath these bindings
# while cass exercises the retptr path. A test that only ran here would prove neither.
# This is the "compiles on five targets is not runs on five targets" rule (v6.5.7).
#
# ⚠ WHAT MAKES THIS TEST NON-VACUOUS. Group A is a CONTROL: the annotated declaration form
# ALWAYS worked, so if a future change breaks the receive wholesale, A fails too and the
# file cannot be mistaken for a regression confined to the new forms. Groups B/C/D are the
# forms that were broken. EVERY LANE is asserted, never just lane 0 — the v6.5.59 lesson:
# a lane-0 assertion passes while half the vector is stale, which is exactly why nothing
# caught the 256-bit return dropping lanes 2-3.
#
# Inputs are exact in binary floating point, so the expected values are unarguable and the
# lanes are DISTINCT (a lane mix-up or a splat cannot pass):
#   f64v2 a = [10, 20]        b = [1, 2]        a+b = [11, 22]   a*b = [10, 40]
#   f64v4 h = [1, 2, 3, 4]                      h+h = [2, 4, 6, 8]
#   f32v4 f = [1, 2, 3, 4]f                     f+f = [2, 4, 6, 8]f
include "lib/assert.cyr"
include "lib/simd.cyr"

# A user-defined vector-returning fn — the defect was never confined to lib/simd.cyr.
fn mk2(): f64v2 {
    var r: f64v2 = f64v2_make(f64_from(5), f64_from(6));
    return r;
}
fn mk4(): f64v4 {
    var r: f64v4 = f64v4_make(f64_from(1), f64_from(2), f64_from(3), f64_from(4));
    return r;
}

# --- E (6.7.13, issues/archived/2026-10-14-explicit-instance-vector-result-not-received.md): an EXPLICIT-INSTANCE generic call
#     `g<T>(..)` is a by-name call declared to return its vector. Every receive tested `IDENT (`, so the assignment
#     was refused, the declaration dropped its annotation (a one-word local: the high lanes garbage, silently) and
#     `return g<T>(..)` was refused. Raw lane bits, each lane distinct; `<i32>` is a real instance, `<i64>` the
#     base. ---
fn ge2<T>(x: T, y: T): f64v2 {
    var v: f64v2;
    store64(&v, x); store64(&v + 8, y);
    return v;
}
fn ge4<T>(x: T, y: T): f64v4 {
    var v: f64v4;
    store64(&v, x); store64(&v + 8, y); store64(&v + 16, x + 100); store64(&v + 24, y + 100);
    return v;
}
fn gef<T>(x: T, y: T): f32v4 {
    var v: f32v4;
    store32(&v, x); store32(&v + 4, y); store32(&v + 8, x + 100); store32(&v + 12, y + 100);
    return v;
}
fn re2(x, y): f64v2 { return ge2<i64>(x, y); }
fn re4(x, y): f64v4 { return ge4<i64>(x, y); }
fn ref4(x, y): f32v4 { return gef<i32>(x, y); }

# --- F (6.7.13, D34 A — the user's decision, 2026-10-15; issues/archived/2026-10-13-vector-dereference-into-vector-local-decision.md):
#     `var v: V = *p;` / `v = *p;` with `p: *V` copy the 16 / 32 bytes through the pointer, as `var q: T = *p;` copies a
#     struct. Refused since 6.7.11 (and through 6.7.10 one word with the high lanes stale: x86_64 210, aarch64 74, cx 98,
#     PE 146 where 161 is right). Each lane distinct; the copy is a copy (writes to either side stay there). ---
var GPF: *f64v2 = 0;
fn dpf_get(p: *f64v2): *f64v2 { return p; }
fn dpf_par(p: *f64v2): i64 { var v: f64v2 = *p; return load64(&v) * 1000 + load64(&v + 8); }
fn dpf_par4(p: *f64v4): i64 { var v: f64v4 = mk4(); v = *p; return load64(&v + 16) * 1000 + load64(&v + 24); }

# --- G (6.7.14, D35 A / D36 A — the user's decisions, 2026-10-16; issues/2026-10-16-vector-dereference-return-and-untyped-
#     destinations.md): `return *p;` from a fn declared `: V` with `p: *V` copies the vector through the pointer (refused
#     "got `this expression`" through 6.7.13), and an untyped `var v = *p;` declares a V local copied through p (one
#     word, lane 0, through 6.7.13: x86_64 114, IR=3 226, aarch64 26, cx 98, PE 146 where 161 is right). ---
fn drt2(p: *f64v2): f64v2 { return *p; }
fn drt2w(p: *f64v2): f64v2 { return (*p); }
fn drt2pp(pp: **f64v2): f64v2 { return **pp; }
fn drt4(p: *f64v4): f64v4 { return *p; }
fn drtf(p: *f32v4): f32v4 { return *p; }
fn dvlanes(x: f64v2): i64 { return load64(&x) * 1000 + load64(&x + 8); }

# --- H (6.7.15, issues/2026-10-17-chained-receiver-vector-method-binds-a-word-annotated-refused.md): a method declared
#     `: V` on a FIELD-CHAIN receiver is the vector at every receive a single-name receiver's is (6.7.13's D29 A, 6.7.14's
#     D37 / D38 / D39). The untyped `var v = w.s.mv();` bound one word — stack garbage, per target and per build (x86_64
#     104, IR=3 40, aarch64 144, cx 98, PE 195 where 161 is right); the annotated declaration, the assignment, a value-form
#     argument and the return were refused "got `w`"; a `*f64v2` argument pushed lane 0 as the address (139). Raw lane
#     bits, each lane distinct; on Win64 the receive's address is the method's hidden result pointer. ---
struct CrS { k; }
struct CrW { s: CrS; j; }
struct CrH { w: CrW; i; }
struct CrN { ps: *CrS; q; }
impl CrS {
    fn mv(self): f64v2 { var v: f64v2; store64(&v, 40 + self.k); store64(&v + 8, 7); return v; }
    fn mg<T>(self, a: T): f64v2 { var v: f64v2; store64(&v, a + self.k); store64(&v + 8, 8); return v; }
    fn m4(self): f64v4 { var v: f64v4; store64(&v, 1); store64(&v + 8, 2); store64(&v + 16, 3); store64(&v + 24, self.k); return v; }
}
fn cr_lanes(x: f64v2): i64 { return load64(&x) * 1000 + load64(&x + 8); }
fn cr_rd(p: *f64v2): i64 { var v: f64v2 = *p; return load64(&v) * 1000 + load64(&v + 8); }
fn cr_ret(w: *CrW): f64v2 { return w.s.mv(); }
fn cr_ret2(h: *CrH): f64v2 { return h.w.s.mg<i64>(50); }

fn main(): i64 {
    var a: f64v2 = f64v2_make(f64_from(10), f64_from(20));
    var b: f64v2 = f64v2_make(f64_from(1), f64_from(2));

    # --- A: CONTROL — the annotated declaration form, which always worked ---
    test_group("A control: var r: T = f()");
    var ca: f64v2 = f64v2_add(a, b);
    assert_eq(f64_to(load64(&ca + 0)), 11, "control f64v2 lane0");
    assert_eq(f64_to(load64(&ca + 8)), 22, "control f64v2 lane1");

    # --- B: untyped declaration — type inferred from the callee's return ---
    test_group("B untyped: var r = f()");
    var ua = f64v2_add(a, b);
    assert_eq(f64_to(load64(&ua + 0)), 11, "untyped f64v2 lane0");
    assert_eq(f64_to(load64(&ua + 8)), 22, "untyped f64v2 lane1");

    var um = f64v2_mul(a, b);
    assert_eq(f64_to(load64(&um + 0)), 10, "untyped f64v2_mul lane0");
    assert_eq(f64_to(load64(&um + 8)), 40, "untyped f64v2_mul lane1");

    # a vector op that also takes a trailing SCALAR param
    var us = f64v2_scale(a, f64_from(3));
    assert_eq(f64_to(load64(&us + 0)), 30, "untyped f64v2_scale lane0");
    assert_eq(f64_to(load64(&us + 8)), 60, "untyped f64v2_scale lane1");

    # user-defined callee, not stdlib
    var uu = mk2();
    assert_eq(f64_to(load64(&uu + 0)), 5, "untyped user-fn f64v2 lane0");
    assert_eq(f64_to(load64(&uu + 8)), 6, "untyped user-fn f64v2 lane1");

    # 256-bit: all four lanes, because a pair-store bug leaves lanes 2-3 stale
    var h: f64v4 = mk4();
    var u4 = f64v4_add(h, h);
    assert_eq(f64_to(load64(&u4 + 0)), 2, "untyped f64v4 lane0");
    assert_eq(f64_to(load64(&u4 + 8)), 4, "untyped f64v4 lane1");
    assert_eq(f64_to(load64(&u4 + 16)), 6, "untyped f64v4 lane2");
    assert_eq(f64_to(load64(&u4 + 24)), 8, "untyped f64v4 lane3");

    # 128-bit f32: distinct lanes, raw bit patterns (2.0f 4.0f 6.0f 8.0f)
    var f: f32v4 = f32v4_make(0x3F800000, 0x40000000, 0x40400000, 0x40800000);
    var uf = f32v4_add(f, f);
    assert_eq(load32(&uf + 0), 0x40000000, "untyped f32v4 lane0 = 2.0f");
    assert_eq(load32(&uf + 4), 0x40800000, "untyped f32v4 lane1 = 4.0f");
    assert_eq(load32(&uf + 8), 0x40C00000, "untyped f32v4 lane2 = 6.0f");
    assert_eq(load32(&uf + 12), 0x41000000, "untyped f32v4 lane3 = 8.0f");

    # --- C: assignment form — the declaration path's other half ---
    test_group("C assignment: var r: T; r = f()");
    var xa: f64v2;
    xa = f64v2_add(a, b);
    assert_eq(f64_to(load64(&xa + 0)), 11, "assigned f64v2 lane0");
    assert_eq(f64_to(load64(&xa + 8)), 22, "assigned f64v2 lane1");

    # RE-assignment must also land, not just the first store
    xa = f64v2_mul(a, b);
    assert_eq(f64_to(load64(&xa + 0)), 10, "reassigned f64v2_mul lane0");
    assert_eq(f64_to(load64(&xa + 8)), 40, "reassigned f64v2_mul lane1");

    xa = mk2();
    assert_eq(f64_to(load64(&xa + 0)), 5, "assigned user-fn f64v2 lane0");
    assert_eq(f64_to(load64(&xa + 8)), 6, "assigned user-fn f64v2 lane1");

    var x4: f64v4;
    x4 = f64v4_add(h, h);
    assert_eq(f64_to(load64(&x4 + 0)), 2, "assigned f64v4 lane0");
    assert_eq(f64_to(load64(&x4 + 8)), 4, "assigned f64v4 lane1");
    assert_eq(f64_to(load64(&x4 + 16)), 6, "assigned f64v4 lane2");
    assert_eq(f64_to(load64(&x4 + 24)), 8, "assigned f64v4 lane3");

    var xf: f32v4;
    xf = f32v4_add(f, f);
    assert_eq(load32(&xf + 0), 0x40000000, "assigned f32v4 lane0 = 2.0f");
    assert_eq(load32(&xf + 12), 0x41000000, "assigned f32v4 lane3 = 8.0f");

    # --- D: the operands must survive being passed by value ---
    # A receive that wrote past its slot would corrupt them; assert they are intact.
    test_group("D operands intact after by-value passing");
    assert_eq(f64_to(load64(&a + 0)), 10, "operand a lane0 intact");
    assert_eq(f64_to(load64(&a + 8)), 20, "operand a lane1 intact");
    assert_eq(f64_to(load64(&h + 0)), 1, "operand h lane0 intact");
    assert_eq(f64_to(load64(&h + 24)), 4, "operand h lane3 intact");

    # --- E: the explicit instance, every binding form (6.7.13) ---
    test_group("E explicit instance: g<T>(..) into a value-form vector local");
    var e2: f64v2 = ge2<i64>(41, 7);
    assert_eq(load64(&e2), 41, "declared f64v2 from ge2<i64> lane0");
    assert_eq(load64(&e2 + 8), 7, "declared f64v2 from ge2<i64> lane1");
    var a2: f64v2;
    a2 = ge2<i64>(3, 9);
    assert_eq(load64(&a2), 3, "assigned f64v2 from ge2<i64> lane0");
    assert_eq(load64(&a2 + 8), 9, "assigned f64v2 from ge2<i64> lane1");
    var u2 = ge2<i32>(5, 6);
    assert_eq(load64(&u2), 5, "untyped from ge2<i32> lane0");
    assert_eq(load64(&u2 + 8), 6, "untyped from ge2<i32> lane1");
    var e4: f64v4 = ge4<i64>(1, 2);
    assert_eq(load64(&e4), 1, "declared f64v4 from ge4<i64> lane0");
    assert_eq(load64(&e4 + 8), 2, "declared f64v4 from ge4<i64> lane1");
    assert_eq(load64(&e4 + 16), 101, "declared f64v4 from ge4<i64> lane2");
    assert_eq(load64(&e4 + 24), 102, "declared f64v4 from ge4<i64> lane3");
    e4 = ge4<i32>(3, 4);
    assert_eq(load64(&e4), 3, "assigned f64v4 from ge4<i32> lane0");
    assert_eq(load64(&e4 + 24), 104, "assigned f64v4 from ge4<i32> lane3");
    var ef: f32v4 = gef<i32>(1, 2);
    assert_eq(load32(&ef), 1, "declared f32v4 from gef<i32> lane0");
    assert_eq(load32(&ef + 4), 2, "declared f32v4 from gef<i32> lane1");
    assert_eq(load32(&ef + 8), 101, "declared f32v4 from gef<i32> lane2");
    assert_eq(load32(&ef + 12), 102, "declared f32v4 from gef<i32> lane3");
    ef = gef<i64>(7, 8);
    assert_eq(load32(&ef), 7, "assigned f32v4 from gef<i64> lane0");
    assert_eq(load32(&ef + 12), 108, "assigned f32v4 from gef<i64> lane3");
    var r2: f64v2 = re2(11, 12);
    assert_eq(load64(&r2), 11, "return ge2<i64>(..) from a f64v2 fn lane0");
    assert_eq(load64(&r2 + 8), 12, "return ge2<i64>(..) from a f64v2 fn lane1");
    var r4: f64v4 = re4(5, 6);
    assert_eq(load64(&r4), 5, "return ge4<i64>(..) from a f64v4 fn lane0");
    assert_eq(load64(&r4 + 24), 106, "return ge4<i64>(..) from a f64v4 fn lane3");
    var rf: f32v4 = ref4(9, 10);
    assert_eq(load32(&rf), 9, "return gef<i32>(..) from a f32v4 fn lane0");
    assert_eq(load32(&rf + 12), 110, "return gef<i32>(..) from a f32v4 fn lane3");

    # --- F: the dereference of a `*V` into a value-form vector local (D34 A) ---
    test_group("F *p of a *V into a value-form vector local");
    var w2: f64v2 = ge2<i64>(41, 7);
    var p2: *f64v2 = &w2;
    var d2: f64v2 = *p2;
    assert_eq(load64(&d2), 41, "declared f64v2 from *p lane0");
    assert_eq(load64(&d2 + 8), 7, "declared f64v2 from *p lane1");
    store64(&d2, 99);
    assert_eq(load64(&w2), 41, "a copy: writing it leaves the pointee");
    store64(&w2 + 8, 8);
    assert_eq(load64(&d2 + 8), 7, "a copy: writing the pointee leaves it");
    d2 = *p2;
    assert_eq(load64(&d2), 41, "assigned f64v2 from *p lane0");
    assert_eq(load64(&d2 + 8), 8, "assigned f64v2 from *p lane1");
    var dw: f64v2 = (*p2);
    assert_eq(load64(&dw + 8), 8, "declared from (*p) lane1");
    assert_eq(dpf_par(&w2), 41008, "a p: *f64v2 parameter's *p, both lanes");
    GPF = &w2;
    var dg: f64v2 = *GPF;
    assert_eq(load64(&dg), 41, "a *V global's *G lane0");
    assert_eq(load64(&dg + 8), 8, "a *V global's *G lane1");
    var dc: f64v2 = *dpf_get(p2);
    assert_eq(load64(&dc + 8), 8, "a : *V call's *f() lane1");
    var pp2: **f64v2 = &p2;
    var dd: f64v2 = **pp2;
    assert_eq(load64(&dd), 41, "**pp of a **f64v2 lane0");
    assert_eq(load64(&dd + 8), 8, "**pp of a **f64v2 lane1");
    var two: f64v2[2];
    store64(&two + 16, 31); store64(&two + 24, 32);
    var pt: *f64v2 = &two;
    var dn: f64v2 = *(pt + 1);
    assert_eq(load64(&dn) * 100 + load64(&dn + 8), 3132, "*(p + 1) is the next vector");
    var w4: f64v4 = ge4<i64>(1, 2);
    var p4: *f64v4 = &w4;
    var d4: f64v4 = *p4;
    assert_eq(load64(&d4), 1, "declared f64v4 from *p lane0");
    assert_eq(load64(&d4 + 8), 2, "declared f64v4 from *p lane1");
    assert_eq(load64(&d4 + 16), 101, "declared f64v4 from *p lane2");
    assert_eq(load64(&d4 + 24), 102, "declared f64v4 from *p lane3");
    assert_eq(dpf_par4(p4), 101102, "assigned f64v4 from a parameter's *p lanes 2 and 3");
    var wf: f32v4 = gef<i32>(1, 2);
    var pf: *f32v4 = &wf;
    var df: f32v4 = *pf;
    assert_eq(load32(&df), 1, "declared f32v4 from *p lane0");
    assert_eq(load32(&df + 4), 2, "declared f32v4 from *p lane1");
    assert_eq(load32(&df + 8), 101, "declared f32v4 from *p lane2");
    assert_eq(load32(&df + 12), 102, "declared f32v4 from *p lane3");
    var wi: i32v4 = i32v4_make(5, 6, 7, 8);
    var pi: *i32v4 = &wi;
    var di: i32v4 = i32v4_make(0, 0, 0, 0);
    di = *pi;
    assert_eq(load32(&di) * 1000 + load32(&di + 4) * 100 + load32(&di + 8) * 10 + load32(&di + 12), 5678,
      "assigned i32v4 from *p, every lane");

    var da: f64v2 = *&w2;
    assert_eq(load64(&da) * 100 + load64(&da + 8), 4108, "declared from *&w: the dereference of an address-of a vector");
    d2 = *(&w2);
    assert_eq(load64(&d2) * 100 + load64(&d2 + 8), 4108, "assigned from *(&w)");

    # --- G: `return *p;` and an untyped `var v = *p;` (D35, D36) ---
    test_group("G return *p and an untyped var v = *p");
    var gw: f64v2 = ge2<i64>(61, 62);
    var gp2: *f64v2 = &gw;
    var gr: f64v2 = drt2(gp2);
    assert_eq(load64(&gr), 61, "return *p lane0");
    assert_eq(load64(&gr + 8), 62, "return *p lane1");
    var grw: f64v2 = drt2w(gp2);
    assert_eq(load64(&grw) * 100 + load64(&grw + 8), 6162, "return (*p), both lanes");
    var grp: f64v2 = drt2pp(&gp2);
    assert_eq(load64(&grp) * 100 + load64(&grp + 8), 6162, "return **pp of a **f64v2, both lanes");
    store64(&gr, 5);
    assert_eq(load64(&gw), 61, "the returned vector is a copy");
    var gw4: f64v4 = ge4<i64>(1, 2);
    var gr4: f64v4 = drt4(&gw4);
    assert_eq(load64(&gr4), 1, "return *p of a *f64v4 lane0");
    assert_eq(load64(&gr4 + 8), 2, "return *p of a *f64v4 lane1");
    assert_eq(load64(&gr4 + 16), 101, "return *p of a *f64v4 lane2");
    assert_eq(load64(&gr4 + 24), 102, "return *p of a *f64v4 lane3");
    var gwf: f32v4 = gef<i32>(3, 4);
    var grf: f32v4 = drtf(&gwf);
    assert_eq(load32(&grf), 3, "return *p of a *f32v4 lane0");
    assert_eq(load32(&grf + 4), 4, "return *p of a *f32v4 lane1");
    assert_eq(load32(&grf + 8), 103, "return *p of a *f32v4 lane2");
    assert_eq(load32(&grf + 12), 104, "return *p of a *f32v4 lane3");
    var gu = *gp2;
    assert_eq(load64(&gu), 61, "untyped var v = *p lane0");
    assert_eq(load64(&gu + 8), 62, "untyped var v = *p lane1");
    assert_eq(dvlanes(gu), 61062, "untyped var v = *p is the vector: a value-form argument");
    store64(&gu + 8, 9);
    assert_eq(load64(&gw + 8), 62, "untyped var v = *p is a copy");
    var guw = (*gp2);
    assert_eq(load64(&guw) * 100 + load64(&guw + 8), 6162, "untyped var v = (*p), both lanes");
    var gpp2: **f64v2 = &gp2;
    var gupp = **gpp2;
    assert_eq(load64(&gupp) * 100 + load64(&gupp + 8), 6162, "untyped var v = **pp, both lanes");
    var gp4: *f64v4 = &gw4;
    var gu4 = *gp4;
    assert_eq(load64(&gu4), 1, "untyped f64v4 from *p lane0");
    assert_eq(load64(&gu4 + 24), 102, "untyped f64v4 from *p lane3");
    var gpf: *f32v4 = &gwf;
    var guf = *gpf;
    assert_eq(load32(&guf), 3, "untyped f32v4 from *p lane0");
    assert_eq(load32(&guf + 12), 104, "untyped f32v4 from *p lane3");
    var gx = 77;
    var gpi: *i64 = &gx;
    var gxi = *gpi;
    assert_eq(gxi + 1, 78, "untyped var x = *pi of a *i64 stays a word");

    # --- H: a method on a field-chain receiver (6.7.15) ---
    test_group("H a vector method on a field chain w.s.mv()");
    var cw: CrW; cw.s.k = 1; cw.j = 5;
    var cu = cw.s.mv();
    assert_eq(load64(&cu), 41, "untyped var v = w.s.mv() lane0");
    assert_eq(load64(&cu + 8), 7, "untyped var v = w.s.mv() lane1");
    var cad: f64v2 = cw.s.mv();
    assert_eq(cr_lanes(cad), 41007, "declared from w.s.mv(), both lanes");
    var cs: f64v2 = ge2<i64>(0, 0);
    cs = cw.s.mv();
    assert_eq(cr_lanes(cs), 41007, "assigned from w.s.mv(), both lanes");
    assert_eq(cr_lanes(cw.s.mv()), 41007, "w.s.mv() into a value-form parameter");
    assert_eq(cr_rd(cw.s.mv()), 41007, "w.s.mv() into a *f64v2 parameter");
    var cr: f64v2 = cr_ret(&cw);
    assert_eq(cr_lanes(cr), 41007, "return w.s.mv() from a f64v2 fn");
    assert_eq(cw.s.k * 10 + cw.j, 15, "the receiver is intact");
    var cpw: *CrW = &cw;
    var cp = cpw.s.mv();
    assert_eq(cr_lanes(cp), 41007, "untyped from pw.s.mv() (a pointer head)");
    var ch: CrH; ch.w.s.k = 3; ch.i = 9;
    var chu = ch.w.s.mv();
    assert_eq(cr_lanes(chu), 43007, "untyped from h.w.s.mv() (two hops)");
    var chg: f64v2 = ch.w.s.mg(60);
    assert_eq(cr_lanes(chg), 63008, "declared from h.w.s.mg(60) (a generic method)");
    var chr: f64v2 = cr_ret2(&ch);
    assert_eq(cr_lanes(chr), 53008, "return h.w.s.mg<i64>(50) (an explicit instance)");
    var cs0: CrS = CrS { 4 };
    var cn: CrN; cn.ps = &cs0;
    var cnu = cn.ps.mv();
    assert_eq(cr_lanes(cnu), 44007, "untyped from n.ps.mv() (a *S field)");
    var c4 = ch.w.s.m4();
    assert_eq(load64(&c4) * 1000 + load64(&c4 + 8) * 100 + load64(&c4 + 16) * 10 + load64(&c4 + 24), 1233,
      "untyped f64v4 from h.w.s.m4(), every lane");
    assert_eq(ch.w.s.k * 10 + ch.i, 39, "the two-hop receiver is intact");

    var r = assert_summary();
    return r;
}
var ec = main();
syscall(60, ec);
