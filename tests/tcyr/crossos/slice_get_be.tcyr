# slice_get_be.tcyr — 6.7.18 (the user's D1): lib/slice.cyr's slice_get_be reads a 1..8-byte
# big-endian field of a [u8] slice, every byte checked as `s[i]` checks one. The network parsers
# take their multi-byte length and type fields through it. Its out-of-range side (exit 134,
# `slice bounds violation`) is pinned by tests/gates/memory/net_parsers_read_through_slices.sh.
# CHANGELOG [6.7.18]
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/slice.cyr"
include "lib/assert.cyr"

fn _be_group(): i64 {
    test_group("slice_get_be reads big-endian fields inside the slice");
    var b = alloc(16);
    var i = 0;
    while (i < 10) { store8(b + i, 0x10 * i + i + 1); i = i + 1; }   # 01 12 23 34 45 56 67 78 89 9A
    var s: [u8] = 0;
    slice_set(&s, b, 10);
    assert_eq(slice_get_be(&s, 0, 1), 0x01, "w=1 at 0");
    assert_eq(slice_get_be(&s, 0, 2), 0x0112, "w=2 at 0");
    assert_eq(slice_get_be(&s, 1, 2), 0x1223, "w=2 at 1");
    assert_eq(slice_get_be(&s, 2, 4), 0x23344556, "w=4 at 2");
    assert_eq(slice_get_be(&s, 1, 3), 0x122334, "w=3 at 1");
    assert_eq(slice_get_be(&s, 2, 8), 0x23344556677889 * 256 + 0x9A, "w=8 at 2: the field ends at the slice's last byte");
    assert_eq(slice_get_be(&s, 8, 2), 0x899A, "w=2 ending at the last byte");
    assert_eq(slice_get_be(&s, 9, 1), 0x9A, "w=1 at the last byte");
    store8(b, 0xFF); store8(b + 1, 0xFE);
    assert_eq(slice_get_be(&s, 0, 2), 0xFFFE, "unsigned: a high bit set reads 0xFFFE, not negative");
    s.len = 2;
    assert_eq(slice_get_be(&s, 0, 2), 0xFFFE, "a 2-byte slice holds a 2-byte field");
    return 0;
}

fn main(): i64 {
    alloc_init();
    _be_group();
    return assert_summary();
}
var ec = main();
syscall(60, ec);
