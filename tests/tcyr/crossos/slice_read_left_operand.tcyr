# slice_read_left_operand.tcyr — a slice subscript is a whole value: `s[0] + 10` (6.7.8, C2-1b).
#
# THE DEFECT (6.7.5 – 6.7.7, every target). The slice read `s[i]` (`_slice_sub_read`,
# src/frontend/parse_expr.cyr) parses its index, calls `_slice_idx_get_W(&s, i)` and returns — but
# left behind what the INDEX had said about itself, as if it described the element:
#   - a constant index armed the constant folder (`_cfo` / `_cfp` / `_cfv`), so `s[0] + 10` folded
#     `0 + 10` and REWOUND the code to the index's load: the call vanished, its fixup then patched
#     the return's jump into a jump to the helper — `return s[0] + 10;` exited 134 "slice bounds
#     violation", `var y = s[0] + 10;` and `return s[1] * 2;` SIGSEGV'd;
#   - a `*T`-typed index left its pointer step, so `s[ix()] + 1` added 4 (ix(): *i32);
#   - a struct-typed index left its type, so `s[n] + 10` dispatched `Idx_add`.
# `10 + s[0]`, `(s[0]) + 10` and `var x = s[0]; x + 10` were right. THE FIX: the slice read ends
# with `_arr_sub_read`'s resets (step 0, estype 0, `_cfo` 0).
#
# Rows: the filed repro verbatim (R), every binary operator class with a slice read on the left (O),
# every element width (W), the index shapes that armed the folder or left state behind (I), and the
# positions — return, initializer, assignment, every compound operator, a condition, a for-step, an
# if-expression, an argument, chains, unary operands (C); and (6.7.8) an index variable stored just
# before the read, which CYRIUS_IR=3 forwarded across the slice's raw frame base (V). Element values
# stay non-negative, so no row depends on how a signed slice element is extended.
# The gate tests/gates/frontend/slice_read_left_operand.sh runs this file on x86 (plain, IR=1, IR=3,
# DCE=1), aarch64 (qemu), cx (cxvm) and PE (wine).
include "lib/slice.cyr"
include "lib/assert.cyr"

enum Ix { IX_ONE = 1; IX_TWO = 2; }
const C_ONE = 1;
struct Idx { v; }
fn Idx_add(a, b): i64 { return 99; }
fn ix(): *i32 { return 2; }
fn id(v): i64 { return v; }

# ── R: the filed repro (b = { 5, 6, .. }, s = slice_set(&s, &b, 4)) ──────────────────────────────
fn rep_ret(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    return s[0] + 10;
}
fn rep_var(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    var y = s[0] + 10;
    return y;
}
fn rep_mul(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    return s[1] * 2;
}
fn rep_right(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    return 10 + s[0];
}
fn rep_paren(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    return (s[0]) + 10;
}
fn rep_named(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    var x = s[0];
    return x + 10;
}

# ── O: every binary operator class, the slice read on the left (s = { 5, 6, 12, 3 }) ─────────────
fn ops(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6; b[2] = 12; b[3] = 3;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    var k = 7;
    assert_eq(s[0] + 10, 15, "O1: s[0] + 10");
    assert_eq(s[0] - 1, 4, "O2: s[0] - 1");
    assert_eq(s[0] * 3, 15, "O3: s[0] * 3");
    assert_eq(s[2] / 4, 3, "O4: s[2] / 4");
    assert_eq(s[2] % 5, 2, "O5: s[2] % 5");
    assert_eq(s[0] & 4, 4, "O6: s[0] & 4");
    assert_eq(s[0] | 8, 13, "O7: s[0] | 8");
    assert_eq(s[0] ^ 1, 4, "O8: s[0] ^ 1");
    assert_eq(s[0] << 2, 20, "O9: s[0] << 2");
    assert_eq(s[2] >> 2, 3, "O10: s[2] >> 2");
    assert_eq(s[2] >>> 1, 6, "O11: s[2] >>> 1");
    assert_eq(s[0] == 5, 1, "O12: s[0] == 5");
    assert_eq(s[0] != 5, 0, "O13: s[0] != 5");
    assert_eq(s[0] < 6, 1, "O14: s[0] < 6");
    assert_eq(s[0] <= 4, 0, "O15: s[0] <= 4");
    assert_eq(s[0] > 4, 1, "O16: s[0] > 4");
    assert_eq(s[0] >= 6, 0, "O17: s[0] >= 6");
    assert_eq(s[0] && 0, 0, "O18: s[0] && 0");
    assert_eq(s[0] || 0, 1, "O19: s[0] || 0");
    assert_eq(s[0] +% 10, 15, "O20: s[0] +% 10");
    assert_eq(s[0] -% 1, 4, "O21: s[0] -% 1");
    assert_eq(s[0] *% 3, 15, "O22: s[0] *% 3");
    assert_eq(s[0] + k, 12, "O23: s[0] + a variable");
    assert_eq(s[1] * k, 42, "O24: s[1] * a variable");
    assert_eq(s[0] + s[1], 11, "O25: s[0] + s[1]");
    assert_eq(s[1] * s[3], 18, "O26: s[1] * s[3]");
    return 0;
}

# ── W: every element width (d = { 5, 6, 12, 3 }) ─────────────────────────────────────────────────
fn w_u8(): i64 {
    var d: u8[4];
    d[0] = 5; d[1] = 6; d[2] = 12; d[3] = 3;
    var s: [u8] = 0;
    slice_set(&s, &d, 4);
    assert_eq(s[0] + 10, 15, "W1: [u8] s[0] + 10");
    assert_eq(s[1] * 2, 12, "W1: [u8] s[1] * 2");
    assert_eq(s[3] << 4, 48, "W1: [u8] s[3] << 4");
    assert_eq(s[2] >> 2, 3, "W1: [u8] s[2] >> 2");
    assert_eq(s[0] == 5, 1, "W1: [u8] s[0] == 5");
    return s[1] + 1;
}
fn w_i8(): i64 {
    var d: i8[4];
    d[0] = 5; d[1] = 6; d[2] = 12; d[3] = 3;
    var s: [i8] = 0;
    slice_set(&s, &d, 4);
    assert_eq(s[0] + 10, 15, "W2: [i8] s[0] + 10");
    assert_eq(s[1] * 2, 12, "W2: [i8] s[1] * 2");
    assert_eq(s[2] - 2, 10, "W2: [i8] s[2] - 2");
    assert_eq(s[3] | 4, 7, "W2: [i8] s[3] | 4");
    return s[1] + 1;
}
fn w_u16(): i64 {
    var d: u16[4];
    d[0] = 5; d[1] = 6; d[2] = 12; d[3] = 3;
    var s: [u16] = 0;
    slice_set(&s, &d, 4);
    assert_eq(s[0] + 10, 15, "W3: [u16] s[0] + 10");
    assert_eq(s[1] * 2, 12, "W3: [u16] s[1] * 2");
    assert_eq(s[2] / 3, 4, "W3: [u16] s[2] / 3");
    assert_eq(s[3] ^ 1, 2, "W3: [u16] s[3] ^ 1");
    return s[1] + 1;
}
fn w_i16(): i64 {
    var d: i16[4];
    d[0] = 5; d[1] = 6; d[2] = 12; d[3] = 3;
    var s: [i16] = 0;
    slice_set(&s, &d, 4);
    assert_eq(s[0] + 10, 15, "W4: [i16] s[0] + 10");
    assert_eq(s[1] * 2, 12, "W4: [i16] s[1] * 2");
    assert_eq(s[2] % 5, 2, "W4: [i16] s[2] % 5");
    assert_eq(s[3] < 4, 1, "W4: [i16] s[3] < 4");
    return s[1] + 1;
}
fn w_u32(): i64 {
    var d: u32[4];
    d[0] = 5; d[1] = 6; d[2] = 12; d[3] = 3;
    var s: [u32] = 0;
    slice_set(&s, &d, 4);
    assert_eq(s[0] + 10, 15, "W5: [u32] s[0] + 10");
    assert_eq(s[1] * 2, 12, "W5: [u32] s[1] * 2");
    assert_eq(s[2] & 4, 4, "W5: [u32] s[2] & 4");
    assert_eq(s[3] >>> 1, 1, "W5: [u32] s[3] >>> 1");
    return s[1] + 1;
}
fn w_i32(): i64 {
    var d: i32[4];
    d[0] = 5; d[1] = 6; d[2] = 12; d[3] = 3;
    var s: [i32] = 0;
    slice_set(&s, &d, 4);
    assert_eq(s[0] + 10, 15, "W6: [i32] s[0] + 10");
    assert_eq(s[1] * 2, 12, "W6: [i32] s[1] * 2");
    assert_eq(s[2] >> 1, 6, "W6: [i32] s[2] >> 1");
    assert_eq(s[3] != 3, 0, "W6: [i32] s[3] != 3");
    return s[1] + 1;
}
fn w_u64(): i64 {
    var d: u64[4];
    d[0] = 5; d[1] = 6; d[2] = 12; d[3] = 3;
    var s: [u64] = 0;
    slice_set(&s, &d, 4);
    assert_eq(s[0] + 10, 15, "W7: [u64] s[0] + 10");
    assert_eq(s[1] * 2, 12, "W7: [u64] s[1] * 2");
    assert_eq(s[2] - 12, 0, "W7: [u64] s[2] - 12");
    assert_eq(s[3] >= 3, 1, "W7: [u64] s[3] >= 3");
    return s[1] + 1;
}
fn w_i64(): i64 {
    var d: i64[4];
    d[0] = 5; d[1] = 6; d[2] = 12; d[3] = 3;
    var s: [i64] = 0;
    slice_set(&s, &d, 4);
    assert_eq(s[0] + 10, 15, "W8: [i64] s[0] + 10");
    assert_eq(s[1] * 2, 12, "W8: [i64] s[1] * 2");
    assert_eq(s[2] << 1, 24, "W8: [i64] s[2] << 1");
    assert_eq(s[3] > 2, 1, "W8: [i64] s[3] > 2");
    return s[1] + 1;
}
# A [u128] read is the element's ADDRESS (lib/slice.cyr `_slice_idx_get_16`): `s[1] + 8` its high word.
fn w_u128(): i64 {
    var d: i64[4];
    d[0] = 11; d[1] = 22; d[2] = 33; d[3] = 44;
    var s: [u128] = 0;
    slice_set(&s, &d, 2);
    assert_eq(load64(s[1] + 8), 44, "W9: [u128] load64(s[1] + 8)");
    assert_eq(load64(s[0] + 8), 22, "W9: [u128] load64(s[0] + 8)");
    return load64(s[1]);
}

# ── I: the index shapes (s = { 5, 6, 12, 3 }) ───────────────────────────────────────────────────
fn idx(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6; b[2] = 12; b[3] = 3;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    var i = 2;
    var n: Idx;
    n.v = 1;
    const L_TWO = 2;
    assert_eq(s[1 + 1] + 1, 13, "I1: a folded constant index, s[1 + 1] + 1");
    assert_eq(s[2 * 1] * 2, 24, "I2: a folded product index, s[2 * 1] * 2");
    assert_eq(s[IX_TWO] + 1, 13, "I3: an enum-constant index");
    assert_eq(s[Ix.IX_ONE] * 3, 18, "I4: a qualified enum-constant index");
    assert_eq(s[C_ONE] - 1, 5, "I5: a const index");
    assert_eq(s[L_TWO] / 2, 6, "I6: a local const index");
    assert_eq(s[i] + 1, 13, "I7: a variable index (control)");
    assert_eq(s[i + 1] * 2, 6, "I8: a computed index (control)");
    assert_eq(s[ix()] + 1, 13, "I9: a *i32-returning call as the index: its step is not the element's");
    assert_eq(s[n] + 10, 16, "I10: a struct-typed index: its type is not the element's (no Idx_add)");
    assert_eq(s.len + 10, 14, "I11: s.len + 10 (control)");
    return 0;
}

# ── V: the index variable stored just before the read (s = { 5, 6, 12, 3 }). Under CYRIUS_IR=3 on
# x86 the slice's frame base (raw bytes, no IR node) let the pass take rax for the variable it had
# just stored: `var i = 2; var x = s[i];` passed &s as the index and exited 134 (6.7.8) ──────────
fn ivar(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6; b[2] = 12; b[3] = 3;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    var i = 2;
    var x = s[i];
    assert_eq(x, 12, "V1: var i = 2; var x = s[i];");
    var j = 3;
    assert_eq(s[j - 1] + 1, 13, "V2: var j = 3; s[j - 1] + 1");
    var k = 0;
    k = 1;
    assert_eq(s[k] * 2, 12, "V3: k = 1; s[k] * 2");
    var m = 3;
    if (s[m] == 3) { m = 0; }
    assert_eq(m, 0, "V4: var m = 3; if (s[m] == 3)");
    return 0;
}

# ── C: the positions (s = { 5, 6, 12, 3 }) ──────────────────────────────────────────────────────
fn ctx_ret(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6; b[2] = 12; b[3] = 3;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    return s[2] >> 1;
}
fn ctx(): i64 {
    var b: i64[4];
    b[0] = 5; b[1] = 6; b[2] = 12; b[3] = 3;
    var s: [i64] = 0;
    slice_set(&s, &b, 4);
    var z = 0;
    z = s[1] * 2;
    assert_eq(z, 12, "C2: an assignment, z = s[1] * 2");
    var k = 1;
    k += s[0] + 10;
    assert_eq(k, 16, "C3: k += s[0] + 10");
    k -= s[1] * 2;
    assert_eq(k, 4, "C4: k -= s[1] * 2");
    k *= s[0] - 3;
    assert_eq(k, 8, "C5: k *= s[0] - 3");
    k /= s[3] - 1;
    assert_eq(k, 4, "C6: k /= s[3] - 1");
    k %= s[0] - 2;
    assert_eq(k, 1, "C7: k %= s[0] - 2");
    k |= s[0] << 1;
    assert_eq(k, 11, "C8: k |= s[0] << 1");
    k &= s[1] + 1;
    assert_eq(k, 3, "C9: k &= s[1] + 1");
    k ^= s[1] - 1;
    assert_eq(k, 6, "C10: k ^= s[1] - 1");
    k <<= s[3] - 1;
    assert_eq(k, 24, "C11: k <<= s[3] - 1");
    k >>= s[3] - 2;
    assert_eq(k, 12, "C12: k >>= s[3] - 2");
    k >>>= s[3] - 1;
    assert_eq(k, 3, "C13: k >>>= s[3] - 1");
    var hit = 0;
    if (s[0] + 1 == 6) { hit = 1; }
    assert_eq(hit, 1, "C14: an if condition, s[0] + 1 == 6");
    var w = 0;
    while (s[0] * w < 20) { w = w + 1; }
    assert_eq(w, 4, "C15: a while condition, s[0] * w < 20");
    var c = 0;
    for (var i = 0; s[3] + i < 6; i = i + 1) { c = c + 1; }
    assert_eq(c, 3, "C16: a for condition, s[3] + i < 6");
    var c2 = 0;
    var j = 0;
    for (j = 0; j < 20; j = s[0] + j) { c2 = c2 + 1; }
    assert_eq(c2, 4, "C17: a for step, j = s[0] + j");
    var c3 = 0;
    for (j = 0; j < 30; j += s[0] * 2) { c3 = c3 + 1; }
    assert_eq(c3, 3, "C18: a compound for step, j += s[0] * 2");
    var v = if (s[0] + 1 == 6) { s[1] * 2 } else { 0 };
    assert_eq(v, 12, "C19: an if-expression, its condition and branch");
    assert_eq(id(s[0] + 10), 15, "C20: an argument, id(s[0] + 10)");
    assert_eq(s[0] + 10 + 1, 16, "C21: a chain, s[0] + 10 + 1");
    assert_eq(s[1] * 2 * 3, 36, "C22: a chain, s[1] * 2 * 3");
    assert_eq(s[2] / 4 * 3, 9, "C23: a chain, s[2] / 4 * 3");
    assert_eq(0 - s[1] + 10, 4, "C24: a left subtraction, 0 - s[1] + 10");
    assert_eq(-s[1] + 10, 4, "C25: unary minus, -s[1] + 10");
    assert_eq(~s[1] + 10, 3, "C26: bitwise not, ~s[1] + 10");
    assert_eq(!s[0] + 1, 1, "C27: logical not, !s[0] + 1");
    return 0;
}

assert_eq(rep_ret(), 15, "R1: return s[0] + 10;");
assert_eq(rep_var(), 15, "R2: var y = s[0] + 10;");
assert_eq(rep_mul(), 12, "R3: return s[1] * 2;");
assert_eq(rep_right(), 15, "R4: return 10 + s[0]; (right before the fix)");
assert_eq(rep_paren(), 15, "R5: return (s[0]) + 10; (right before the fix)");
assert_eq(rep_named(), 15, "R6: var x = s[0]; return x + 10; (right before the fix)");
ops();
assert_eq(w_u8(), 7, "W1: [u8] return s[1] + 1");
assert_eq(w_i8(), 7, "W2: [i8] return s[1] + 1");
assert_eq(w_u16(), 7, "W3: [u16] return s[1] + 1");
assert_eq(w_i16(), 7, "W4: [i16] return s[1] + 1");
assert_eq(w_u32(), 7, "W5: [u32] return s[1] + 1");
assert_eq(w_i32(), 7, "W6: [i32] return s[1] + 1");
assert_eq(w_u64(), 7, "W7: [u64] return s[1] + 1");
assert_eq(w_i64(), 7, "W8: [i64] return s[1] + 1");
assert_eq(w_u128(), 33, "W9: [u128] load64(s[1])");
idx();
ivar();
assert_eq(ctx_ret(), 6, "C1: return s[2] >> 1;");
ctx();

var r = assert_summary();
