assert_eq(zg5_call(), -7000000004, "5 B: call");
assert_eq(zg5_opr(), -7000000004, "5 B: opr");
assert_eq(zg5_ie(1), -7000000004, "5 B: if-expression branch");
assert_eq(zg6_arg(), -7000000300, "6 B: arg");
assert_eq(zg6_argp(), -7000000300, "6 B: argp");
assert_eq(zg6_ret(), -7000000300, "6 B: ret");
assert_eq(zg6_retp(), -7000000300, "6 B: retp");
