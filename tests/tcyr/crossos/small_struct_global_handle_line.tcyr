test_group("sizes 1..8 B at top level (a hidden global, no frame)");
zset1(ZT1);
assert_eq(zs1(ZT1), -3, "1 B at top level: arg");
assert_eq(zs1((ZT1)), -3, "1 B at top level: (arg)");
var zx1 = zguard1();
ZO1 = zmk1();
assert_eq(load8(zx1 + 1), 0x5A, "1 B at top level: `h = mk()` writes no byte past the object");
assert_eq(zobj1(zx1), -3, "1 B at top level: `h = mk()` copies into the object");
zset2(ZT2);
assert_eq(zs2(ZT2), -300, "2 B at top level: arg");
assert_eq(zs2((ZT2)), -300, "2 B at top level: (arg)");
var zx2 = zguard2();
ZO2 = zmk2();
assert_eq(load8(zx2 + 2), 0x5A, "2 B at top level: `h = mk()` writes no byte past the object");
assert_eq(zobj2(zx2), -300, "2 B at top level: `h = mk()` copies into the object");
zset3(ZT3);
assert_eq(zs3(ZT3), -30000004, "3 B at top level: arg");
assert_eq(zs3((ZT3)), -30000004, "3 B at top level: (arg)");
var zx3 = zguard3();
ZO3 = zmk3();
assert_eq(load8(zx3 + 3), 0x5A, "3 B at top level: `h = mk()` writes no byte past the object");
assert_eq(zobj3(zx3), -30000004, "3 B at top level: `h = mk()` copies into the object");
zset4(ZT4);
assert_eq(zs4(ZT4), -70000, "4 B at top level: arg");
assert_eq(zs4((ZT4)), -70000, "4 B at top level: (arg)");
var zx4 = zguard4();
ZO4 = zmk4();
assert_eq(load8(zx4 + 4), 0x5A, "4 B at top level: `h = mk()` writes no byte past the object");
assert_eq(zobj4(zx4), -70000, "4 B at top level: `h = mk()` copies into the object");
zset5(ZT5);
assert_eq(zs5(ZT5), -7000000004, "5 B at top level: arg");
assert_eq(zs5((ZT5)), -7000000004, "5 B at top level: (arg)");
var zx5 = zguard5();
ZO5 = zmk5();
assert_eq(load8(zx5 + 5), 0x5A, "5 B at top level: `h = mk()` writes no byte past the object");
assert_eq(zobj5(zx5), -7000000004, "5 B at top level: `h = mk()` copies into the object");
zset6(ZT6);
assert_eq(zs6(ZT6), -7000000300, "6 B at top level: arg");
assert_eq(zs6((ZT6)), -7000000300, "6 B at top level: (arg)");
var zx6 = zguard6();
ZO6 = zmk6();
assert_eq(load8(zx6 + 6), 0x5A, "6 B at top level: `h = mk()` writes no byte past the object");
assert_eq(zobj6(zx6), -7000000300, "6 B at top level: `h = mk()` copies into the object");
zset7(ZT7);
assert_eq(zs7(ZT7), -70000030000004, "7 B at top level: arg");
assert_eq(zs7((ZT7)), -70000030000004, "7 B at top level: (arg)");
var zx7 = zguard7();
ZO7 = zmk7();
assert_eq(load8(zx7 + 7), 0x5A, "7 B at top level: `h = mk()` writes no byte past the object");
assert_eq(zobj7(zx7), -70000030000004, "7 B at top level: `h = mk()` copies into the object");
zset8(ZT8);
assert_eq(zs8(ZT8), -7000080000, "8 B at top level: arg");
assert_eq(zs8((ZT8)), -7000080000, "8 B at top level: (arg)");
var zx8 = zguard8();
ZO8 = zmk8();
assert_eq(load8(zx8 + 8), 0x5A, "8 B at top level: `h = mk()` writes no byte past the object");
assert_eq(zobj8(zx8), -7000080000, "8 B at top level: `h = mk()` copies into the object");

var r = assert_summary();
