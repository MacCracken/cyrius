assert_eq(zg2_call(), -300, "2 B: call");
assert_eq(zg2_opr(), -300, "2 B: opr");
assert_eq(zg2_ie(1), -300, "2 B: if-expression branch");
assert_eq(zg3_arg(), -30000004, "3 B: arg");
assert_eq(zg3_argp(), -30000004, "3 B: argp");
assert_eq(zg3_ret(), -30000004, "3 B: ret");
