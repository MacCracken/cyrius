# small_struct_global_handle_line.tcyr — 6.7.10 (B7-1g). THE HANDLE LINE FOR GLOBALS: a struct global
# of 8 B or less initialised from anything that is not a struct value of its type is a HANDLE, as one
# over 8 B is (the user's decision 5, 2026-10-12: one rule for locals and globals at every size). The
# local half is small_struct_handle_line.tcyr (B7-1).
#
# ⛔ THE ASYMMETRY, 6.6.5 through 6.7.9. `var GH: H = alloc(16);` (16 B) declared a handle global — its
# slot held the address and `GH.v = 7` wrote the heap object — while `var G8: S8 = alloc(8);` (8 B), or
# `= &buf`, `= gp()` with `fn gp(): *S8`, `= 9`, declared an INLINE S8 whose one field was the address:
# `G8.v` read the address back and `G8.v = 5` never reached the object, with no diagnostic.
#
# THE RULE, measured against the 16 B behaviour (every `_8` row has an `_h` twin over 8 B where one can
# exist — a struct call, method, operator or if-expression result over 8 B has no storage at top level
# and is refused there, and a fn cannot `return` a global over 8 B, so those rows are 8 B only):
#   * a COPY (the global is inline): a literal, an inline global `(name)` / `name`, a field chain, `*p`
#     with `p: *T` (6.7.10: copied at EVERY size — over 8 B the global was a handle holding the word
#     `*p` read, and its first field write SIGSEGV'd) and every other dereference of a `*T` (the review
#     fix: `(*p)`, `*(p + 0)`, `*gp()`, `*W.p`), a field or a method reached through a `*T` global, a
#     `: *T` call or a `*T` field (the review fix: `P.s`, `gp().s`, `P.dbl()`, `W.p.dbl()` — B7-1g made the
#     fields handles and refused the methods as a zone misread), a whole free / wrapped / generic call, a method,
#     an operator, an if-expression — declared before the first top-level statement (the declaration
#     zone, judged from its tokens once every fn is registered, so a fn declared BELOW counts) or after
#     it (judged as a local is);
#   * a HANDLE: `alloc(..)`, `&x`, a `*T` call, an untyped call, an untyped global, an integer (`= 9` a
#     handle to address 9: `+` on it is pointer arithmetic, no operator dispatch; `= 0` a NULL handle),
#     a method or operator whose fn returns no struct;
#   * a BIND (a second handle to the same object): another handle global, as at 16 B.
#   ⚠ NOT CHANGED, awaiting the user: a global initialised from a `*T` global's NAME (`var G: S8 = P;`)
#     keeps the layout it had (8 B or less an inline value holding the pointer word; over 8 B a handle
#     bound to P's object) — a local copies there (6.7.0), a global over 8 B binds; no row pins either.
#   A handle global's consumers take its STRUCT, as a handle local's do: a by-value argument (`f(G)`,
#   `f((G))`, a method's, a generic's), `return G` / `return (G)`, an operator's right operand, an
#   if-expression branch, `q = G` / `G = q` / `G = V` / `V = G` (copied through the address; handle <-
#   handle REBINDS, at any type), `G = mk()` / `G = b.dbl()` / `G = b + b` / `G = if ..` / `G = w.s`
#   (copied into the object), `w.s = G`, a nested literal element — inside a fn and at top level, where
#   a 3 / 5 / 6 / 7-byte struct goes through a hidden global (there is no frame). A handle into a `*T`
#   parameter, an untyped parameter, a `self: *T` receiver or a dyn passes its address, `&G` is its
#   slot, `G + n` is pointer arithmetic and `var q: S8 = G;` binds, as at 16 B.
#   A copy is told from an alias by a WRITE after it: `src.v * 100 + before * 10 + after`.
#
# Mutation ledger: tests/gates/codegen/small_struct_handle_line.sh (the G rows), which runs this file
# on x86_64 (plain, CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm) and PE (wine).
# CROSS-HOST: the release gate's cross-OS leg runs it on ecb / ach / cass / pi.
include "lib/assert.cyr"

struct S8 { v; }                     # 8 B
struct H { v; w; }                   # 16 B — the twin
struct U8 { u; }                     # 8 B, another type
struct UH { u; x; }                  # 16 B, another type
struct W8 { s: S8; n; }
struct WH { s: H; n; }
struct Q8 { v; }
struct QH { v; w; }
struct R8 { v; }                     # an operator returning no struct
struct RH { v; w; }

trait Show { fn show(self): i64; }
impl Show for Q8 { fn show(self: *Q8): i64 { return self.v + 500; } }
impl Show for QH { fn show(self: *QH): i64 { return self.v + 500; } }
struct DW { o: dyn Show; }
fn dk0(o: dyn Show): i64 {
    var w: DW = DW { o };
    return callptr(load64(load64(&w + 8)), load64(&w));
}

var BUF8[8];
var BUFH[16];
var PB8[8];
var PBH[16];
var UB8[8];
var UBH[16];

fn mk8(n): S8 { var r: S8; r.v = n; return r; }
fn mkh(n): H { var r: H; r.v = n; r.w = 0; return r; }
fn gp8(): *S8 { return &PB8; }
fn gph(): *H { return &PBH; }
fn ga8() { return &UB8; }
fn gah() { return &UBH; }
fn S8_dbl(self: S8): S8 { var r: S8; r.v = self.v * 2; return r; }
fn H_dbl(self: H): H { var r: H; r.v = self.v * 2; r.w = 0; return r; }
fn S8_pp(self: *S8): *S8 { return self; }
fn H_pp(self: *H): *H { return self; }
fn S8_add(l: S8, r: S8): S8 { var t: S8; t.v = l.v + r.v; return t; }
fn H_add(l: H, r: H): H { var t: H; t.v = l.v + r.v; t.w = 0; return t; }
fn S8_mul(l: S8, k): S8 { var t: S8; t.v = l.v * k; return t; }
fn S8_with(self: S8, o: S8) { return self.v * 10 + o.v; }
fn H_with(self: H, o: H) { return self.v * 10 + o.v; }
fn S8_pm(self: *S8) { return self.v + 100; }
fn H_pm(self: *H) { return self.v + 100; }
fn R8_add(l, r) { return &BUF8; }
fn RH_add(l, r) { return &BUFH; }
fn take8(s: S8) { return s.v; }
fn takeh(s: H) { return s.v; }
fn rp8(p: *S8) { return p.v; }
fn rph(p: *H) { return p.v; }
fn tu(x) { return load64(x); }
fn idg<T>(x: T): T { return x; }
fn tg8<T>(k: T, s: S8) { return k + s.v; }
fn tgh<T>(k: T, s: H) { return k + s.v; }

# ── the initialiser matrix, in the declaration zone (before the first top-level statement) ──
var SRC8 = S8 { 5 };
var SRCH = H { 5, 0 };
var WS8 = W8 { 0, 0 };
var WSH = WH { 0, 0, 0 };
fn wsinit() { WS8.s.v = 5; WSH.s.v = 5; return 0; }
var _ws = wsinit();                  # the replay runs in declaration order: WS8.s is 5 below
var PS8: *S8 = &SRC8;
var PSH: *H = &SRCH;
struct PW8 { p: *S8; }
struct PWH { p: *H; }
var PWG8 = PW8 { &SRC8 };
var PWGH = PWH { &SRCH };
fn gs8(): *S8 { return &SRC8; }
fn gsh(): *H { return &SRCH; }
var PW8S: *W8 = &WS8;
fn gw8(): *W8 { return &WS8; }
var GU8 = &UB8;
var GUH = &UBH;
var RV8 = R8 { 1 };
var RVH = RH { 1, 0 };
# COPIES
var IN8: S8 = SRC8;
var INH: H = SRCH;
var IP8: S8 = (SRC8);
var IPH: H = (SRCH);
var IF8: S8 = WS8.s;
var IFH: H = WSH.s;
var ID8: S8 = *PS8;
var IDH: H = *PSH;
var IDP8: S8 = (*PS8);               # the review fix: a dereference at any spelling copies
var IDPH: H = (*PSH);
var IDA8: S8 = *(PS8 + 0);
var IDAH: H = *(PSH + 0);
var IDC8: S8 = *gs8();
var IDCH: H = *gsh();
var IDF8: S8 = *PWG8.p;
var IDFH: H = *PWGH.p;
var IDB8: S8 = *gsb8();              # a `: *S8` fn declared below the global (judged by the sweep)
var IPM8: S8 = PS8.dbl();            # the review fix: a `*T` receiver — a method through a `*S8` global,
var IGM8: S8 = gs8().dbl();          #   a `: *S8` call, a `*S8` field — is a struct result (the sweep
var IWM8: S8 = PWG8.p.dbl();         #   misread these as handles, the replay refused the program)
var IPF8: S8 = PW8S.s;               # a field through a `*W8` global, a `: *W8` call, in parentheses:
var IGF8: S8 = gw8().s;              #   a struct value (B7-1g made them handles holding the field's word)
var IWF8: S8 = (PW8S.s);
var IC8: S8 = mk8(5);
var ICW8: S8 = (mk8(5));
var ICB8: S8 = mkb8(5);              # a fn declared below the global
var IG8: S8 = idg<S8>(SRC8);
var IGI8: S8 = idg(SRC8);
var IM8: S8 = SRC8.dbl();
var IO8: S8 = SRC8 + SRC8;
var IOM8: S8 = SRC8 * 2 + SRC8;
var IOP8: S8 = (SRC8 + SRC8) + SRC8;
var IE8: S8 = if (SRC8.v == 5) { SRC8 } else { IN8 };
# HANDLES
var HA8: S8 = alloc(8);
var HAH: H = alloc(16);
var HR8: S8 = &BUF8;
var HRH: H = &BUFH;
var HP8: S8 = gp8();
var HPH: H = gph();
var HU8: S8 = ga8();
var HUH: H = gah();
var HX8: S8 = GU8;
var HXH: H = GUH;
var HN8: S8 = 9;
var HNH: H = 9;
var HZ8: S8 = 0;
var HZH: H = 0;
var HM8: S8 = SRC8.pp();
var HMH: H = SRCH.pp();
var HO8: S8 = RV8 + RV8;
var HOH: H = RVH + RVH;
# BINDS
var HB8: S8 = HA8;
var HBH: H = HAH;
fn mkb8(n): S8 { var r: S8; r.v = n; return r; }
fn gsb8(): *S8 { return &SRC8; }

# A copy row: the global read (`b`), then written; the source is unchanged.
fn i_n_8() { var b = IN8.v; IN8.v = 9; return SRC8.v * 100 + b * 10 + IN8.v; }
fn i_n_h() { var b = INH.v; INH.v = 9; return SRCH.v * 100 + b * 10 + INH.v; }
fn i_p_8() { var b = IP8.v; IP8.v = 9; return SRC8.v * 100 + b * 10 + IP8.v; }
fn i_p_h() { var b = IPH.v; IPH.v = 9; return SRCH.v * 100 + b * 10 + IPH.v; }
fn i_f_8() { var b = IF8.v; IF8.v = 9; return WS8.s.v * 100 + b * 10 + IF8.v; }
fn i_f_h() { var b = IFH.v; IFH.v = 9; return WSH.s.v * 100 + b * 10 + IFH.v; }
fn i_d_8() { var b = ID8.v; ID8.v = 9; return SRC8.v * 100 + b * 10 + ID8.v; }
fn i_d_h() { var b = IDH.v; IDH.v = 9; return SRCH.v * 100 + b * 10 + IDH.v; }
fn i_dp_8() { var b = IDP8.v; IDP8.v = 9; return SRC8.v * 100 + b * 10 + IDP8.v; }
fn i_dp_h() { var b = IDPH.v; IDPH.v = 9; return SRCH.v * 100 + b * 10 + IDPH.v; }
fn i_da_8() { var b = IDA8.v; IDA8.v = 9; return SRC8.v * 100 + b * 10 + IDA8.v; }
fn i_da_h() { var b = IDAH.v; IDAH.v = 9; return SRCH.v * 100 + b * 10 + IDAH.v; }
fn i_dc_8() { var b = IDC8.v; IDC8.v = 9; return SRC8.v * 100 + b * 10 + IDC8.v; }
fn i_dc_h() { var b = IDCH.v; IDCH.v = 9; return SRCH.v * 100 + b * 10 + IDCH.v; }
fn i_df_8() { var b = IDF8.v; IDF8.v = 9; return SRC8.v * 100 + b * 10 + IDF8.v; }
fn i_df_h() { var b = IDFH.v; IDFH.v = 9; return SRCH.v * 100 + b * 10 + IDFH.v; }
fn i_db_8() { var b = IDB8.v; IDB8.v = 9; return SRC8.v * 100 + b * 10 + IDB8.v; }
fn i_pm_8() { var b = IPM8.v; IPM8.v = 9; return SRC8.v * 1000 + b * 10 + IPM8.v; }
fn i_gm_8() { var b = IGM8.v; IGM8.v = 9; return SRC8.v * 1000 + b * 10 + IGM8.v; }
fn i_wm_8() { var b = IWM8.v; IWM8.v = 9; return SRC8.v * 1000 + b * 10 + IWM8.v; }
fn i_pf_8() { var b = IPF8.v; IPF8.v = 9; return WS8.s.v * 100 + b * 10 + IPF8.v; }
fn i_gf_8() { var b = IGF8.v; IGF8.v = 9; return WS8.s.v * 100 + b * 10 + IGF8.v; }
fn i_wf_8() { var b = IWF8.v; IWF8.v = 9; return WS8.s.v * 100 + b * 10 + IWF8.v; }
fn i_c_8() { var b = IC8.v; IC8.v = 9; return b * 10 + IC8.v; }
fn i_cw_8() { var b = ICW8.v; ICW8.v = 9; return b * 10 + ICW8.v; }
fn i_cb_8() { var b = ICB8.v; ICB8.v = 9; return b * 10 + ICB8.v; }
fn i_g_8() { var b = IG8.v; IG8.v = 9; return SRC8.v * 100 + b * 10 + IG8.v; }
fn i_gi_8() { var b = IGI8.v; IGI8.v = 9; return SRC8.v * 100 + b * 10 + IGI8.v; }
fn i_m_8() { var b = IM8.v; IM8.v = 9; return SRC8.v * 1000 + b * 10 + IM8.v; }
fn i_o_8() { var b = IO8.v; IO8.v = 9; return SRC8.v * 1000 + b * 10 + IO8.v; }
fn i_om_8() { var b = IOM8.v; IOM8.v = 9; return SRC8.v * 1000 + b * 10 + IOM8.v; }
fn i_op_8() { var b = IOP8.v; IOP8.v = 9; return SRC8.v * 1000 + b * 10 + IOP8.v; }
fn i_e_8() { var b = IE8.v; IE8.v = 9; return SRC8.v * 100 + b * 10 + IE8.v; }

# A handle row: a write through the global reaches its object.
fn h_a_8() { HA8.v = 9; return load64(load64(&HA8)); }
fn h_a_h() { HAH.v = 9; return load64(load64(&HAH)); }
fn h_r_8() { HR8.v = 9; return load64(&BUF8); }
fn h_r_h() { HRH.v = 9; return load64(&BUFH); }
fn h_p_8() { HP8.v = 9; return load64(&PB8); }
fn h_p_h() { HPH.v = 9; return load64(&PBH); }
fn h_u_8() { HU8.v = 9; return load64(&UB8); }
fn h_u_h() { HUH.v = 9; return load64(&UBH); }
fn h_x_8() { HX8.v = 8; return load64(GU8); }
fn h_x_h() { HXH.v = 8; return load64(GUH); }
fn h_n_8() { return HN8 + 0; }
fn h_n_h() { return HNH + 0; }
fn h_z_8() { HZ8 = HA8; HZ8.v = 4; return HA8.v; }
fn h_z_h() { HZH = HAH; HZH.v = 4; return HAH.v; }
fn h_m_8() { HM8.v = 9; var b = SRC8.v; SRC8.v = 5; return b; }
fn h_m_h() { HMH.v = 9; var b = SRCH.v; SRCH.v = 5; return b; }
fn h_o_8() { HO8.v = 7; return load64(&BUF8); }
fn h_o_h() { HOH.v = 7; return load64(&BUFH); }
fn b_a_8() { HB8.v = 7; return HA8.v; }
fn b_a_h() { HBH.v = 7; return HAH.v; }

# ── the consumer matrix: a handle global `A` (its object's v = 5) ──
var A8: S8 = alloc(8);
var AH: H = alloc(16);
var B8: S8 = alloc(8);
var BH: H = alloc(16);
var X8: S8 = alloc(8);
var XH: H = alloc(16);
var AU8: U8 = alloc(8);
var AUH: UH = alloc(16);
var V8 = S8 { 3 };
var VH = H { 3, 0 };
var QG8: Q8 = alloc(8);
var QGH: QH = alloc(16);

fn c_rw_8() { A8.v = 5; return load64(load64(&A8)); }
fn c_rw_h() { AH.v = 5; return load64(load64(&AH)); }
fn c_arg_8() { A8.v = 5; return take8(A8); }
fn c_arg_h() { AH.v = 5; return takeh(AH); }
fn c_argp_8() { A8.v = 5; return take8((A8)); }
fn c_argp_h() { AH.v = 5; return takeh((AH)); }
fn c_argm_8() { A8.v = 5; var b: S8; b.v = 1; return b.with(A8); }
fn c_argm_h() { AH.v = 5; var b: H; b.v = 1; return b.with(AH); }
fn c_argg_8() { A8.v = 5; return tg8(1, A8); }
fn c_argg_h() { AH.v = 5; return tgh(1, AH); }
fn c_gen_8() { A8.v = 5; var q: S8 = idg(A8); var b = q.v; q.v = 9; return A8.v * 100 + b * 10 + q.v; }
fn c_gen_h() { AH.v = 5; var q: H = idg(AH); var b = q.v; q.v = 9; return AH.v * 100 + b * 10 + q.v; }
fn c_recv_8() { A8.v = 5; var b: S8; b.v = 1; return A8.with(b); }
fn c_recv_h() { AH.v = 5; var b: H; b.v = 1; return AH.with(b); }
fn c_recvd_8() { A8.v = 5; var q: S8 = A8.dbl(); return q.v; }
fn c_recvd_h() { AH.v = 5; var q: H = AH.dbl(); return q.v; }
fn c_pm_8() { A8.v = 5; return A8.pm(); }
fn c_pm_h() { AH.v = 5; return AH.pm(); }
fn c_ret_8f(): S8 { A8.v = 5; return A8; }
fn c_ret_8() { var q: S8 = c_ret_8f(); var b = q.v; q.v = 9; return A8.v * 100 + b * 10 + q.v; }
fn c_retp_8f(): S8 { A8.v = 5; return (A8); }
fn c_retp_8() { var q: S8 = c_retp_8f(); var b = q.v; q.v = 9; return A8.v * 100 + b * 10 + q.v; }
fn c_reto_8f(): S8 { AU8.u = 6; return AU8; }   # a handle of another struct: its own bytes
fn c_reto_8() { var q: S8 = c_reto_8f(); return q.v; }
fn c_opr_8() { A8.v = 5; var b: S8; b.v = 1; var q: S8 = b + A8; return q.v; }
fn c_opr_h() { AH.v = 5; var b: H; b.v = 1; var q: H = b + AH; return q.v; }
fn c_opl_8() { return (A8 + 8) - load64(&A8); }
fn c_opl_h() { return (AH + 8) - load64(&AH); }
fn c_ie_8(k) {
    A8.v = 5;
    var c: S8;
    c.v = 2;
    var q: S8 = if (k == 1) { A8 } else { c };
    var b = q.v;
    q.v = 9;
    return A8.v * 100 + b * 10 + q.v;
}
fn c_ain_8() { A8.v = 5; var q: S8; q.v = 1; q = A8; var b = q.v; q.v = 9; return A8.v * 100 + b * 10 + q.v; }
fn c_ain_h() { AH.v = 5; var q: H; q.v = 1; q = AH; var b = q.v; q.v = 9; return AH.v * 100 + b * 10 + q.v; }
fn c_aout_8() { var x = load64(&B8); B8.v = 5; var q: S8; q.v = 7; B8 = q; q.v = 1; return load64(x); }
fn c_aout_h() { var x = load64(&BH); BH.v = 5; var q: H; q.v = 7; BH = q; q.v = 1; return load64(x); }
fn c_vin_8() { A8.v = 5; V8 = A8; A8.v = 1; var b = V8.v; V8.v = 3; return b; }
fn c_vin_h() { AH.v = 5; VH = AH; AH.v = 1; var b = VH.v; VH.v = 3; return b; }
fn c_vout_8() { var x = load64(&B8); V8.v = 4; B8 = V8; V8.v = 3; return load64(x); }
fn c_vout_h() { var x = load64(&BH); VH.v = 4; BH = VH; VH.v = 3; return load64(x); }
fn c_rb_8() {
    var x = load64(&X8);
    X8.v = 5;
    var y = load64(&B8);
    B8.v = 3;
    X8 = B8;
    X8.v = 8;
    var r = load64(x) * 10 + B8.v;
    store64(&X8, x);
    store64(&B8, y);
    return r;
}
fn c_rb_h() {
    var x = load64(&XH);
    XH.v = 5;
    var y = load64(&BH);
    BH.v = 3;
    XH = BH;
    XH.v = 8;
    var r = load64(x) * 10 + BH.v;
    store64(&XH, x);
    store64(&BH, y);
    return r;
}
fn c_rbt_8() { var x = load64(&X8); AU8.u = 2; X8 = AU8; X8.v = 4; var r = AU8.u; store64(&X8, x); return r; }
fn c_rbt_h() { var x = load64(&XH); AUH.u = 2; XH = AUH; XH.v = 4; var r = AUH.u; store64(&XH, x); return r; }
fn c_decl_8() { A8.v = 5; var c: S8 = A8; c.v = 9; return A8.v; }
fn c_decl_h() { AH.v = 5; var c: H = AH; c.v = 9; return AH.v; }
fn c_call_8() { var x = load64(&X8); X8 = mk8(6); return load64(x); }
fn c_call_h() { var x = load64(&XH); XH = mkh(6); return load64(x); }
fn c_callw_8() { var x = load64(&X8); X8 = (mk8(7)); return load64(x); }
fn c_meth_8() { var x = load64(&X8); var b: S8; b.v = 4; X8 = b.dbl(); return load64(x); }
fn c_meth_h() { var x = load64(&XH); var b: H; b.v = 4; XH = b.dbl(); return load64(x); }
fn c_op_8() { var x = load64(&X8); var b: S8; b.v = 4; X8 = b + b; return load64(x); }
fn c_op_h() { var x = load64(&XH); var b: H; b.v = 4; XH = b + b; return load64(x); }
fn c_ief_8(k) { var x = load64(&X8); var b: S8; b.v = 4; X8 = if (k == 1) { b } else { b }; return load64(x); }
fn c_fld_8() { var x = load64(&X8); var w: W8; w.s.v = 3; w.n = 0; X8 = w.s; return load64(x); }
fn c_fld_h() { var x = load64(&XH); var w: WH; w.s.v = 3; w.n = 0; XH = w.s; return load64(x); }
fn c_wfs_8() { A8.v = 5; var w: W8; w.n = 0; w.s = A8; A8.v = 1; return w.s.v; }
fn c_wfs_h() { AH.v = 5; var w: WH; w.n = 0; w.s = AH; AH.v = 1; return w.s.v; }
fn c_nest_8() { A8.v = 5; var w = W8 { A8, 3 }; A8.v = 1; return w.s.v * 10 + w.n; }
fn c_nest_h() { AH.v = 5; var w = WH { AH, 3 }; AH.v = 1; return w.s.v * 10 + w.n; }
fn c_rp_8() { A8.v = 5; return rp8(A8); }
fn c_rp_h() { AH.v = 5; return rph(AH); }
fn c_tu_8() { A8.v = 5; return tu(A8); }
fn c_tu_h() { AH.v = 5; return tu(AH); }
fn c_clo_8() { A8.v = 5; var f = |d| { return A8.v + d; }; return callptr(f, 1); }
fn c_clo_h() { AH.v = 5; var f = |d| { return AH.v + d; }; return callptr(f, 1); }
fn c_cloa_8() { A8.v = 5; var f = |d| { return take8(A8) + d; }; return callptr(f, 1); }
fn c_cloa_h() { AH.v = 5; var f = |d| { return takeh(AH) + d; }; return callptr(f, 1); }
# A closure's CAPTURE named like a handle global is the capture, never the global (`_hl_capn`).
fn c_capn_8() { var A8: S8; A8.v = 2; var f = |d| { return take8(A8) + d; }; return callptr(f, 0); }
fn c_capn_h() { var AH: H; AH.v = 2; AH.w = 0; var f = |d| { return takeh(AH) + d; }; return callptr(f, 0); }
fn c_dyn_8() { QG8.v = 7; var o: dyn Show = QG8; return dk0(o); }
fn c_dyn_h() { QGH.v = 7; var o: dyn Show = QGH; return dk0(o); }
fn c_addr_8() { var x = load64(&A8); A8.v = 5; return load64(x); }
fn c_addr_h() { var x = load64(&AH); AH.v = 5; return load64(x); }
fn c_opeq_8() { A8.v = 5; A8.v += 3; return load64(load64(&A8)); }
fn c_opeq_h() { AH.v = 5; AH.v += 3; return load64(load64(&AH)); }

# ── the SIZE rows (1..8 B: i8 / i16 / i32 compositions, signed values): a handle global of each size ──
# through every by-value consumer; `h = q` and `h = mk()` land on a buffer with a guard byte right after
# the object (no byte past it is written). 3 / 5 / 6 / 7 B go through a temp, in a fn and at top level.
# 1 B
struct T1 { a: i8; }
var ZG1: T1 = alloc(16);   # a handle global
var ZO1: T1 = 0;           # a handle global rebound onto a guarded buffer
var ZT1: T1 = alloc(16);   # read and written at top level
fn zs1(s: T1) { return s.a; }
fn zset1(p: *T1) { p.a = 0 - 3; return 0; }
fn zzero1(p: *T1) { p.a = 0; return 0; }
fn zmk1(): T1 { var r: T1; zset1(&r); return r; }
fn T1_add(l: T1, r: T1): T1 { var t: T1; t.a = l.a + r.a; return t; }
fn zobj1(x) { var h: T1 = x; return zs1(h); }
fn zgrt1(): T1 { zset1(ZG1); return ZG1; }
fn zgrp1(): T1 { zset1(ZG1); return (ZG1); }
fn zguard1() {
    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    ZO1 = x;
    return x;
}
fn zg1_arg() { zset1(ZG1); return zs1(ZG1); }
fn zg1_argp() { zset1(ZG1); return zs1((ZG1)); }
fn zg1_ret() { var q: T1 = zgrt1(); return zs1(q); }
fn zg1_retp() { var q: T1 = zgrp1(); return zs1(q); }
fn zg1_in() { zset1(ZG1); var q: T1; zzero1(&q); q = ZG1; zzero1(ZG1); return zs1(q); }
fn zg1_out() {
    var x = zguard1();
    var q: T1;
    zset1(&q);
    ZO1 = q;
    zzero1(&q);
    if (load8(x + 1) != 0x5A) { return 1; } return zobj1(x);
}
fn zg1_call() {
    var x = zguard1();
    ZO1 = zmk1();
    if (load8(x + 1) != 0x5A) { return 1; } return zobj1(x);
}
fn zg1_opr() { zset1(ZG1); var z: T1; zzero1(&z); var q: T1 = z + ZG1; return zs1(q); }
fn zg1_ie(k) {
    zset1(ZG1);
    var z: T1;
    zzero1(&z);
    var q: T1 = if (k == 1) { ZG1 } else { z };
    return zs1(q);
}

