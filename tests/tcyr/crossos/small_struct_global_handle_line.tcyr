# ── after the first top-level statement: each global is judged as its initialiser is parsed ──
var _late = 0;
_late = 1;
var LN8: S8 = SRC8;
var LNH: H = SRCH;
var LD8: S8 = *PS8;
var LDH: H = *PSH;
var LDP8: S8 = (*PS8);
var LDPH: H = (*PSH);
var LDC8: S8 = *gs8();
var LDCH: H = *gsh();
var LDF8: S8 = *PWG8.p;
var LDFH: H = *PWGH.p;
var LPM8: S8 = PS8.dbl();
var LPF8: S8 = PW8S.s;
var LGF8: S8 = gw8().s;
var LC8: S8 = mk8(5);
var LM8: S8 = SRC8.dbl();
var LO8: S8 = SRC8 + SRC8;
var LE8: S8 = if (_late == 1) { SRC8 } else { IN8 };
var LA8: S8 = alloc(8);
var LAH: H = alloc(16);
var LR8: S8 = &BUF8;
var LRH: H = &BUFH;
var LI8: S8 = 9;
var LIH: H = 9;
var LB8: S8 = LA8;
var LBH: H = LAH;
fn l_n_8() { var b = LN8.v; LN8.v = 9; return SRC8.v * 100 + b * 10 + LN8.v; }
fn l_n_h() { var b = LNH.v; LNH.v = 9; return SRCH.v * 100 + b * 10 + LNH.v; }
fn l_d_8() { var b = LD8.v; LD8.v = 9; return SRC8.v * 100 + b * 10 + LD8.v; }
fn l_d_h() { var b = LDH.v; LDH.v = 9; return SRCH.v * 100 + b * 10 + LDH.v; }
fn l_dp_8() { var b = LDP8.v; LDP8.v = 9; return SRC8.v * 100 + b * 10 + LDP8.v; }
fn l_dp_h() { var b = LDPH.v; LDPH.v = 9; return SRCH.v * 100 + b * 10 + LDPH.v; }
fn l_dc_8() { var b = LDC8.v; LDC8.v = 9; return SRC8.v * 100 + b * 10 + LDC8.v; }
fn l_dc_h() { var b = LDCH.v; LDCH.v = 9; return SRCH.v * 100 + b * 10 + LDCH.v; }
fn l_df_8() { var b = LDF8.v; LDF8.v = 9; return SRC8.v * 100 + b * 10 + LDF8.v; }
fn l_df_h() { var b = LDFH.v; LDFH.v = 9; return SRCH.v * 100 + b * 10 + LDFH.v; }
fn l_pm_8() { var b = LPM8.v; LPM8.v = 9; return SRC8.v * 1000 + b * 10 + LPM8.v; }
fn l_pf_8() { var b = LPF8.v; LPF8.v = 9; return WS8.s.v * 100 + b * 10 + LPF8.v; }
fn l_gf_8() { var b = LGF8.v; LGF8.v = 9; return WS8.s.v * 100 + b * 10 + LGF8.v; }
fn l_c_8() { var b = LC8.v; LC8.v = 9; return b * 10 + LC8.v; }
fn l_m_8() { var b = LM8.v; LM8.v = 9; return SRC8.v * 1000 + b * 10 + LM8.v; }
fn l_o_8() { var b = LO8.v; LO8.v = 9; return SRC8.v * 1000 + b * 10 + LO8.v; }
fn l_e_8() { var b = LE8.v; LE8.v = 9; return SRC8.v * 100 + b * 10 + LE8.v; }
fn l_a_8() { LA8.v = 9; return load64(load64(&LA8)); }
fn l_a_h() { LAH.v = 9; return load64(load64(&LAH)); }
fn l_r_8() { LR8.v = 6; return load64(&BUF8); }
fn l_r_h() { LRH.v = 6; return load64(&BUFH); }
fn l_i_8() { return LI8 + 0; }
fn l_i_h() { return LIH + 0; }
fn l_b_8() { LB8.v = 7; return LA8.v; }
fn l_b_h() { LBH.v = 7; return LAH.v; }
fn l_arg_8() { LA8.v = 5; return take8(LA8); }
fn l_arg_h() { LAH.v = 5; return takeh(LAH); }

test_group("the declaration zone: a struct value is copied (the source unchanged)");
assert_eq(i_n_8(), 559, "8 B: an inline global");
assert_eq(i_n_h(), 559, "16 B: an inline global");
assert_eq(i_p_8(), 559, "8 B: (an inline global)");
assert_eq(i_p_h(), 559, "16 B: (an inline global)");
assert_eq(i_f_8(), 559, "8 B: a field chain");
assert_eq(i_f_h(), 559, "16 B: a field chain");
assert_eq(i_d_8(), 559, "8 B: *p");
assert_eq(i_d_h(), 559, "16 B: *p (6.7.10: a copy; a handle holding the first word before)");
assert_eq(i_dp_8(), 559, "8 B: (*p) (the review fix: a dereference at any spelling)");
assert_eq(i_dp_h(), 559, "16 B: (*p)");
assert_eq(i_da_8(), 559, "8 B: *(p + 0)");
assert_eq(i_da_h(), 559, "16 B: *(p + 0)");
assert_eq(i_dc_8(), 559, "8 B: *gp() (a : *T fn)");
assert_eq(i_dc_h(), 559, "16 B: *gp()");
assert_eq(i_df_8(), 559, "8 B: *W.p (a *T field)");
assert_eq(i_df_h(), 559, "16 B: *W.p");
assert_eq(i_db_8(), 559, "8 B: *gp() of a fn declared below the global");
assert_eq(i_pm_8(), 5109, "8 B: P.dbl() through a *S8 global (the review fix: a *T receiver)");
assert_eq(i_gm_8(), 5109, "8 B: gp().dbl() through a : *S8 call");
assert_eq(i_wm_8(), 5109, "8 B: W.p.dbl() through a *S8 field");
assert_eq(i_pf_8(), 559, "8 B: P.s, a field through a *W8 global, copied");
assert_eq(i_gf_8(), 559, "8 B: gp().s, a field through a : *W8 call, copied");
assert_eq(i_wf_8(), 559, "8 B: (P.s), copied");
assert_eq(i_c_8(), 59, "8 B: a call");
assert_eq(i_cw_8(), 59, "8 B: (a call)");
assert_eq(i_cb_8(), 59, "8 B: a call of a fn declared below the global");
assert_eq(i_g_8(), 559, "8 B: an explicit generic call");
assert_eq(i_gi_8(), 559, "8 B: an inferred generic call");
assert_eq(i_m_8(), 5109, "8 B: a method");
assert_eq(i_o_8(), 5109, "8 B: an operator");
assert_eq(i_om_8(), 5159, "8 B: `s * 2 + s` (two dispatches)");
assert_eq(i_op_8(), 5159, "8 B: `(s + s) + s`");
assert_eq(i_e_8(), 559, "8 B: an if-expression");

test_group("the declaration zone: anything else is a handle (a write reaches the object)");
assert_eq(h_a_8(), 9, "8 B: alloc");
assert_eq(h_a_h(), 9, "16 B: alloc");
assert_eq(h_r_8(), 9, "8 B: &x");
assert_eq(h_r_h(), 9, "16 B: &x");
assert_eq(h_p_8(), 9, "8 B: a `*T` call");
assert_eq(h_p_h(), 9, "16 B: a `*T` call");
assert_eq(h_u_8(), 9, "8 B: an untyped call");
assert_eq(h_u_h(), 9, "16 B: an untyped call");
assert_eq(h_x_8(), 8, "8 B: an untyped global");
assert_eq(h_x_h(), 8, "16 B: an untyped global");
assert_eq(h_n_8(), 9, "8 B: `= 9` is a handle to address 9: `+` is pointer arithmetic, no dispatch");
assert_eq(h_n_h(), 9, "16 B: `= 9`");
assert_eq(h_z_8(), 4, "8 B: `= 0` is a NULL handle, then rebound");
assert_eq(h_z_h(), 4, "16 B: `= 0`");
assert_eq(h_m_8(), 9, "8 B: a method returning `*T`");
assert_eq(h_m_h(), 9, "16 B: a method returning `*T`");
assert_eq(h_o_8(), 7, "8 B: an operator returning no struct");
assert_eq(h_o_h(), 7, "16 B: an operator returning no struct");
assert_eq(b_a_8(), 7, "8 B: from another handle global: binds");
assert_eq(b_a_h(), 7, "16 B: from another handle global: binds");

test_group("after the first statement: the same line");
assert_eq(l_n_8(), 559, "8 B: an inline global, copied");
assert_eq(l_n_h(), 559, "16 B: an inline global, copied");
assert_eq(l_d_8(), 559, "8 B: *p, copied");
assert_eq(l_d_h(), 559, "16 B: *p, copied (6.7.10)");
assert_eq(l_dp_8(), 559, "8 B: (*p), copied (the review fix)");
assert_eq(l_dp_h(), 559, "16 B: (*p), copied");
assert_eq(l_dc_8(), 559, "8 B: *gp(), copied");
assert_eq(l_dc_h(), 559, "16 B: *gp(), copied");
assert_eq(l_df_8(), 559, "8 B: *W.p, copied");
assert_eq(l_df_h(), 559, "16 B: *W.p, copied");
assert_eq(l_pm_8(), 5109, "8 B: P.dbl() through a *S8 global, copied");
assert_eq(l_pf_8(), 559, "8 B: P.s through a *W8 global, copied");
assert_eq(l_gf_8(), 559, "8 B: gp().s through a : *W8 call, copied");
assert_eq(l_c_8(), 59, "8 B: a call, copied");
assert_eq(l_m_8(), 5109, "8 B: a method, copied");
assert_eq(l_o_8(), 5109, "8 B: an operator, copied");
assert_eq(l_e_8(), 559, "8 B: an if-expression, copied");
assert_eq(l_a_8(), 9, "8 B: alloc, a handle");
assert_eq(l_a_h(), 9, "16 B: alloc, a handle");
assert_eq(l_r_8(), 6, "8 B: &x, a handle");
assert_eq(l_r_h(), 6, "16 B: &x, a handle");
assert_eq(l_i_8(), 9, "8 B: `= 9`, pointer arithmetic");
assert_eq(l_i_h(), 9, "16 B: `= 9`, pointer arithmetic");
assert_eq(l_b_8(), 7, "8 B: from a handle, binds");
assert_eq(l_b_h(), 7, "16 B: from a handle, binds");
assert_eq(l_arg_8(), 5, "8 B: a by-value argument takes the struct");
assert_eq(l_arg_h(), 5, "16 B: a by-value argument takes the struct");

test_group("a handle global's consumers take its struct");
assert_eq(c_rw_8(), 5, "8 B: a field write reaches the object");
assert_eq(c_rw_h(), 5, "16 B: a field write reaches the object");
assert_eq(c_arg_8(), 5, "8 B: argument");
assert_eq(c_arg_h(), 5, "16 B: argument");
assert_eq(c_argp_8(), 5, "8 B: (argument)");
assert_eq(c_argp_h(), 5, "16 B: (argument)");
assert_eq(c_argm_8(), 15, "8 B: a method's argument");
assert_eq(c_argm_h(), 15, "16 B: a method's argument");
assert_eq(c_argg_8(), 6, "8 B: a generic's argument");
assert_eq(c_argg_h(), 6, "16 B: a generic's argument");
assert_eq(c_gen_8(), 559, "8 B: idg(G) is a copy");
assert_eq(c_gen_h(), 559, "16 B: idg(G) is a copy");
assert_eq(c_recv_8(), 51, "8 B: a by-value receiver");
assert_eq(c_recv_h(), 51, "16 B: a by-value receiver");
assert_eq(c_recvd_8(), 10, "8 B: a by-value receiver's struct result");
assert_eq(c_recvd_h(), 10, "16 B: a by-value receiver's struct result");
assert_eq(c_pm_8(), 105, "8 B: a `self: *T` receiver");
assert_eq(c_pm_h(), 105, "16 B: a `self: *T` receiver");
assert_eq(c_ret_8(), 559, "8 B: return G (a copy; a fn returns no global over 8 B)");
assert_eq(c_retp_8(), 559, "8 B: return (G)");
assert_eq(c_reto_8(), 6, "8 B: return G of another struct gives its bytes, not its address");
assert_eq(c_opr_8(), 6, "8 B: an operator's right operand");
assert_eq(c_opr_h(), 6, "16 B: an operator's right operand");
assert_eq(c_opl_8(), 8, "8 B: an operator's left operand is pointer arithmetic");
assert_eq(c_opl_h(), 8, "16 B: an operator's left operand is pointer arithmetic");
assert_eq(c_ie_8(1), 559, "8 B: an if-expression branch (over 8 B one is refused)");
assert_eq(c_ain_8(), 559, "8 B: q = G copies");
assert_eq(c_ain_h(), 559, "16 B: q = G copies");
assert_eq(c_aout_8(), 7, "8 B: G = q copies into the object");
assert_eq(c_aout_h(), 7, "16 B: G = q copies into the object");
assert_eq(c_vin_8(), 5, "8 B: V = G (a value global) copies");
assert_eq(c_vin_h(), 5, "16 B: V = G (a value global) copies");
assert_eq(c_vout_8(), 4, "8 B: G = V copies into the object");
assert_eq(c_vout_h(), 4, "16 B: G = V copies into the object");
assert_eq(c_rb_8(), 58, "8 B: G = G2 between handles rebinds");
assert_eq(c_rb_h(), 58, "16 B: G = G2 between handles rebinds");
assert_eq(c_rbt_8(), 4, "8 B: a handle of another struct rebinds too");
assert_eq(c_rbt_h(), 4, "16 B: a handle of another struct rebinds too");
assert_eq(c_decl_8(), 9, "8 B: `var c: S8 = G;` binds");
assert_eq(c_decl_h(), 9, "16 B: `var c: H = G;` binds");
assert_eq(c_call_8(), 6, "8 B: G = mk() copies into the object");
assert_eq(c_call_h(), 6, "16 B: G = mk() copies into the object");
assert_eq(c_callw_8(), 7, "8 B: G = (mk()) copies into the object");
assert_eq(c_meth_8(), 8, "8 B: G = b.dbl() copies into the object");
assert_eq(c_meth_h(), 8, "16 B: G = b.dbl() copies into the object");
assert_eq(c_op_8(), 8, "8 B: G = b + b copies into the object");
assert_eq(c_op_h(), 8, "16 B: G = b + b copies into the object");
assert_eq(c_ief_8(1), 4, "8 B: G = if .. copies into the object");
assert_eq(c_fld_8(), 3, "8 B: G = w.s copies into the object");
assert_eq(c_fld_h(), 3, "16 B: G = w.s copies into the object");
assert_eq(c_wfs_8(), 5, "8 B: w.s = G copies");
assert_eq(c_wfs_h(), 5, "16 B: w.s = G copies");
assert_eq(c_nest_8(), 53, "8 B: a nested literal element copies");
assert_eq(c_nest_h(), 53, "16 B: a nested literal element copies");
assert_eq(c_rp_8(), 5, "8 B: into a `*T` parameter, the address");
assert_eq(c_rp_h(), 5, "16 B: into a `*T` parameter, the address");
assert_eq(c_tu_8(), 5, "8 B: into an untyped parameter, the address");
assert_eq(c_tu_h(), 5, "16 B: into an untyped parameter, the address");
assert_eq(c_clo_8(), 6, "8 B: read inside a closure");
assert_eq(c_clo_h(), 6, "16 B: read inside a closure");
assert_eq(c_cloa_8(), 6, "8 B: an argument inside a closure");
assert_eq(c_cloa_h(), 6, "16 B: an argument inside a closure");
assert_eq(c_capn_8(), 2, "8 B: a capture named like a handle global is the capture");
assert_eq(c_capn_h(), 2, "16 B: a capture named like a handle global is the capture");
assert_eq(c_dyn_8(), 507, "8 B: a dyn from a handle global holds its address");
assert_eq(c_dyn_h(), 507, "16 B: a dyn from a handle global holds its address");
assert_eq(c_addr_8(), 5, "8 B: &G is the slot holding the address");
assert_eq(c_addr_h(), 5, "16 B: &G is the slot holding the address");
assert_eq(c_opeq_8(), 8, "8 B: G.v += 3 writes the object");
assert_eq(c_opeq_h(), 8, "16 B: G.v += 3 writes the object");

test_group("at top level (no frame)");
A8.v = 5;
AH.v = 5;
assert_eq(take8(A8), 5, "8 B: argument");
assert_eq(takeh(AH), 5, "16 B: argument");
assert_eq(take8((A8)), 5, "8 B: (argument)");
var tq8: S8 = V8 + A8;
assert_eq(tq8.v, 8, "8 B: an operator's right operand");
var tie8: S8 = if (_late == 1) { A8 } else { V8 };
assert_eq(tie8.v, 5, "8 B: an if-expression branch");
var tx8 = load64(&X8);
var txh = load64(&XH);
X8 = mk8(6);
assert_eq(load64(tx8), 6, "8 B: G = mk() copies into the object");
X8 = V8.dbl();
assert_eq(load64(tx8), 6, "8 B: G = V.dbl() copies into the object");
V8 = A8;
assert_eq(V8.v, 5, "8 B: V = G copies");
V8.v = 3;
assert_eq(A8.v, 5, "8 B: ... and the object is not aliased");
X8 = V8;
assert_eq(load64(tx8), 3, "8 B: G = V copies into the object");
XH = VH;
assert_eq(load64(txh), 3, "16 B: G = V copies into the object");
assert_eq(A8 + 0, load64(&A8), "8 B: G + 0 is the address");
assert_eq(AH + 0, load64(&AH), "16 B: G + 0 is the address");

test_group("sizes 1..8 B: a handle global of each size, every consumer");
assert_eq(zg1_arg(), -3, "1 B: arg");
assert_eq(zg1_argp(), -3, "1 B: argp");
assert_eq(zg1_ret(), -3, "1 B: ret");
assert_eq(zg1_retp(), -3, "1 B: retp");
assert_eq(zg1_in(), -3, "1 B: in");
assert_eq(zg1_out(), -3, "1 B: out");
assert_eq(zg1_call(), -3, "1 B: call");
assert_eq(zg1_opr(), -3, "1 B: opr");
