assert_eq(zg5_arg(), -7000000004, "5 B: arg");
assert_eq(zg5_argp(), -7000000004, "5 B: argp");
assert_eq(zg5_ret(), -7000000004, "5 B: ret");
assert_eq(zg5_retp(), -7000000004, "5 B: retp");
assert_eq(zg5_in(), -7000000004, "5 B: in");
