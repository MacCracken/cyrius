assert_eq(zg3_call(), -30000004, "3 B: call");
assert_eq(zg3_opr(), -30000004, "3 B: opr");
assert_eq(zg3_ie(1), -30000004, "3 B: if-expression branch");
assert_eq(zg4_arg(), -70000, "4 B: arg");
assert_eq(zg4_argp(), -70000, "4 B: argp");
assert_eq(zg4_ret(), -70000, "4 B: ret");
