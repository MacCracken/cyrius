fn i_call_h() { var q: H = mkh(5); var r: H = q; var b = r.v; r.v = 9; return q.v * 100 + b * 10 + r.v; }
fn i_callw_8() { var q: S8 = (mk8(5)); var r: S8 = q; var b = r.v; r.v = 9; return q.v * 100 + b * 10 + r.v; }
fn i_callw_h() { var q: H = (mkh(5)); var r: H = q; var b = r.v; r.v = 9; return q.v * 100 + b * 10 + r.v; }
fn i_gen_8() { var a: S8; a.v = 5; var q: S8 = idg(a); var b = q.v; q.v = 9; return a.v * 100 + b * 10 + q.v; }
fn i_gen_h() { var a: H; a.v = 5; var q: H = idg(a); var b = q.v; q.v = 9; return a.v * 100 + b * 10 + q.v; }
