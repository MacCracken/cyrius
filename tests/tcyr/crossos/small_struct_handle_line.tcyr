# ── review fix: a dereference at ANY spelling is a struct value and copies (decision 6) — only
# `* IDENT ;` was taken, so `(*p)`, `*(p + 0)`, `*w.p`, `*gp()`, `*w.mp()`, `(*self)` made a handle
# holding the word the dereference read (inline copies through 6.7.9; garbage handles over 8 B) ──
struct PW8 { p: *S8; }
