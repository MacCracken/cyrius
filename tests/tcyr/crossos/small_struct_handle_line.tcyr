# An if-expression branch over 8 B is refused (`_ie_big_err`): no 16 B twin.
fn i_ie_8(k) {
    var a: S8;
    a.v = 5;
    var c: S8;
    c.v = 2;
    var q: S8 = if (k == 1) { a } else { c };
    var b = q.v;
    q.v = 9;
    return a.v * 100 + b * 10 + q.v;
}
fn i_inf_8() { var q = mk8(5); var r: S8 = q; var b = r.v; r.v = 9; return q.v * 100 + b * 10 + r.v; }
fn i_inf_h() { var q = mkh(5); var r: H = q; var b = r.v; r.v = 9; return q.v * 100 + b * 10 + r.v; }
fn i_lit_8() { var q: S8 = S8 { 5 }; var r: S8 = q; var b = r.v; r.v = 9; return q.v * 100 + b * 10 + r.v; }
fn i_lit_h() { var q: H = H { 5, 0 }; var r: H = q; var b = r.v; r.v = 9; return q.v * 100 + b * 10 + r.v; }

# ── HANDLES: the write through the local reaches the object (9) ──
fn h_untyped_8() { var x = alloc(8); store64(x, 5); var q: S8 = x; q.v = 9; return load64(x); }
fn h_untyped_h() { var x = alloc(16); store64(x, 5); var q: H = x; q.v = 9; return load64(x); }
fn h_alloc_8() { var q: S8 = alloc(8); q.v = 9; return load64(q); }
fn h_alloc_h() { var q: H = alloc(16); q.v = 9; return load64(q); }
fn h_addr_8() { var a: S8; a.v = 5; var q: S8 = &a; q.v = 9; return a.v; }
fn h_addr_h() { var a: H; a.v = 5; var q: H = &a; q.v = 9; return a.v; }
fn h_pcall_8() { GB8 = alloc(8); var q: S8 = gp8(); q.v = 9; return load64(GB8); }
fn h_pcall_h() { GBH = alloc(16); var q: H = gph(); q.v = 9; return load64(GBH); }
fn h_ucall_8() { GB8 = alloc(8); var q: S8 = ga8(); q.v = 9; return load64(GB8); }
fn h_ucall_h() { GBH = alloc(16); var q: H = gah(); q.v = 9; return load64(GBH); }
fn h_zero_8() { var q: S8 = 0; var h: S8 = alloc(8); h.v = 3; q = h; q.v = 9; return h.v; }
fn h_zero_h() { var q: H = 0; var h: H = alloc(16); h.v = 3; q = h; q.v = 9; return h.v; }
fn h_int_8() { var q: S8 = 9; return q + 0; }
fn h_int_h() { var q: H = 9; return q + 0; }
fn h_i32_8() { var x = alloc(8); var q: I4 = x; q.a = 0 - 3; return load32(x); }
fn h_i32_h() { var x = alloc(16); var q: I12 = x; q.a = 0 - 3; return load32(x); }

# ── BINDS: a declaration from a handle is a second handle to the same object (9) ──
fn b_local_8() { var h: S8 = alloc(8); h.v = 5; var c: S8 = h; c.v = 9; return h.v; }
fn b_local_h() { var h: H = alloc(16); h.v = 5; var c: H = h; c.v = 9; return h.v; }
fn b_cap_8() {
    var h: S8 = alloc(8);
    h.v = 5;
    var f = |d| { var c: S8 = h; c.v = 9 + d; return 0; };
    callptr(f, 0);
    return h.v;
}
fn b_cap_h() {
    var h: H = alloc(16);
    h.v = 5;
    var f = |d| { var c: H = h; c.v = 9 + d; return 0; };
    callptr(f, 0);
    return h.v;
}

