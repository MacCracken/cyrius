# the review fix's size rows: `(*p)` / `*(p + 0)` of a 1 / 3 / 4 / 7 / 8 B struct, a guard byte after the source
fn d_sz1() {
    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    var p: *T1 = x;
    zset1(p);
    var q: T1 = (*p);
    var r: T1 = *(p + 0);
    var c = zs1(q);
    if (zs1(r) != c) { return 1; }
    zzero1(&q);
    zzero1(&r);
    if (load8(x + 1) != 0x5A) { return 2; }
    if (zs1(p) != c) { return 3; }
    return c;
}
