# 1 B: a: i8
fn zs1(s: T1) { return s.a; }
fn zset1(p: *T1) { p.a = 0 - 3; return 0; }
fn zzero1(p: *T1) { p.a = 0; return 0; }
fn zmk1(): T1 { var r: T1; zset1(&r); return r; }
fn zrt1(): T1 { var h: T1 = alloc(16); zset1(h); return h; }
fn zrp1(): T1 { var h: T1 = alloc(16); zset1(h); return (h); }
fn T1_add(l: T1, r: T1): T1 { var t: T1; t.a = l.a + r.a; return t; }
fn zobj1(x) { var h: T1 = x; return zs1(h); }
fn z1_arg() { var h: T1 = alloc(16); zset1(h); return zs1(h); }
fn z1_argp() { var h: T1 = alloc(16); zset1(h); return zs1((h)); }
fn z1_ret() { var q: T1 = zrt1(); return zs1(q); }
fn z1_retp() { var q: T1 = zrp1(); return zs1(q); }
fn z1_in() { var h: T1 = alloc(16); zset1(h); var q: T1; zzero1(&q); q = h; zzero1(h); return zs1(q); }
fn z1_out() {
    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    var h: T1 = x;
    var q: T1;
    zset1(&q);
    h = q;
    zzero1(&q);
    if (load8(x + 1) != 0x5A) { return 1; } return zobj1(x);
}
fn z1_call() {
    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    var h: T1 = x;
    h = zmk1();
    if (load8(x + 1) != 0x5A) { return 1; } return zobj1(x);
}
fn z1_opr() { var h: T1 = alloc(16); zset1(h); var z: T1; zzero1(&z); var q: T1 = z + h; return zs1(q); }
fn z1_ie(k) {
    var h: T1 = alloc(16);
    zset1(h);
    var z: T1;
    zzero1(&z);
    var q: T1 = if (k == 1) { h } else { z };
    return zs1(q);
}
fn z1_cap() { var h: T1 = alloc(16); zset1(h); var f = |d| { return zs1(h) + d; }; return callptr(f, 0); }

# 2 B: a: i16
fn zs2(s: T2) { return s.a; }
fn zset2(p: *T2) { p.a = 0 - 300; return 0; }
fn zzero2(p: *T2) { p.a = 0; return 0; }
fn zmk2(): T2 { var r: T2; zset2(&r); return r; }
fn zrt2(): T2 { var h: T2 = alloc(16); zset2(h); return h; }
fn zrp2(): T2 { var h: T2 = alloc(16); zset2(h); return (h); }
fn T2_add(l: T2, r: T2): T2 { var t: T2; t.a = l.a + r.a; return t; }
fn zobj2(x) { var h: T2 = x; return zs2(h); }
fn z2_arg() { var h: T2 = alloc(16); zset2(h); return zs2(h); }
fn z2_argp() { var h: T2 = alloc(16); zset2(h); return zs2((h)); }
fn z2_ret() { var q: T2 = zrt2(); return zs2(q); }
fn z2_retp() { var q: T2 = zrp2(); return zs2(q); }
fn z2_in() { var h: T2 = alloc(16); zset2(h); var q: T2; zzero2(&q); q = h; zzero2(h); return zs2(q); }
fn z2_out() {
    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    var h: T2 = x;
    var q: T2;
    zset2(&q);
    h = q;
    zzero2(&q);
    if (load8(x + 2) != 0x5A) { return 1; } return zobj2(x);
}
fn z2_call() {
    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    var h: T2 = x;
    h = zmk2();
    if (load8(x + 2) != 0x5A) { return 1; } return zobj2(x);
}
fn z2_opr() { var h: T2 = alloc(16); zset2(h); var z: T2; zzero2(&z); var q: T2 = z + h; return zs2(q); }
fn z2_ie(k) {
    var h: T2 = alloc(16);
    zset2(h);
    var z: T2;
    zzero2(&z);
    var q: T2 = if (k == 1) { h } else { z };
    return zs2(q);
}
fn z2_cap() { var h: T2 = alloc(16); zset2(h); var f = |d| { return zs2(h) + d; }; return callptr(f, 0); }

# 3 B: a: i16, b: i8
fn zs3(s: T3) { return s.a * 100000 + s.b; }
fn zset3(p: *T3) { p.a = 0 - 300; p.b = 0 - 4; return 0; }
fn zzero3(p: *T3) { p.a = 0; p.b = 0; return 0; }
fn zmk3(): T3 { var r: T3; zset3(&r); return r; }
fn zrt3(): T3 { var h: T3 = alloc(16); zset3(h); return h; }
fn zrp3(): T3 { var h: T3 = alloc(16); zset3(h); return (h); }
fn T3_add(l: T3, r: T3): T3 { var t: T3; t.a = l.a + r.a; t.b = l.b + r.b; return t; }
fn zobj3(x) { var h: T3 = x; return zs3(h); }
fn z3_arg() { var h: T3 = alloc(16); zset3(h); return zs3(h); }
fn z3_argp() { var h: T3 = alloc(16); zset3(h); return zs3((h)); }
