    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    var p: *T3 = x;
    zset3(p);
    var q: T3 = (*p);
    var r: T3 = *(p + 0);
    var c = zs3(q);
    if (zs3(r) != c) { return 1; }
    zzero3(&q);
    zzero3(&r);
    if (load8(x + 3) != 0x5A) { return 2; }
    if (zs3(p) != c) { return 3; }
    return c;
}
