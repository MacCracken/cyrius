fn i_derefg_h() { var a: H; a.v = 5; GPH = &a; var q: H = *GPH; var b = q.v; q.v = 9; return a.v * 100 + b * 10 + q.v; }
fn i_derefp_8p(p: *S8) { var q: S8 = *p; var b = q.v; q.v = 9; return p.v * 100 + b * 10 + q.v; }
