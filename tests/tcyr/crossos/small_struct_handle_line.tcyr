# small_struct_handle_line.tcyr — 6.7.10 (B7-1). THE HANDLE LINE: a struct local of 8 B or less
# initialised from anything that is not a struct value of its type is a HANDLE, as one over 8 B is
# (the user's decision, 2026-10-12). One rule at every size.
#
# ⛔ THE ASYMMETRY, 6.6.5 through 6.7.9. `var hq: H = alloc(16);` (16 B) declared a handle — its slot
# held the address and `hq.a = 7` wrote the heap object — while `var q: S8 = alloc(8);` (8 B), or
# `= &s`, `= gp()` with `fn gp(): *S8`, declared an INLINE S8 whose one field was the address: `q.v`
# read the address back and `q.v = 5` never reached the object, with no diagnostic (MARK_SMALL_STRUCT
# marked every struct local of 8 B or less inline, whatever its initialiser). The filed repro exited
# 17 where 237 is right (docs/development/issues/2026-10-08-small-struct-local-from-address-is-
# value-not-handle.md; its verbatim run is tests/gates/codegen/small_struct_handle_line.sh R0).
#
# THE RULE, measured against the 16 B behaviour (the spec — every `_8` row below has an `_h` twin
# over 8 B and both must give the row's constant, except where a 16 B twin cannot exist):
#   * a COPY (the local is inline): a literal, a field, a local / `(local)`, a by-value parameter, a
#     value global, a capture of a struct's words, a `*T` name, `*p` (6.7.10: copied at EVERY size —
#     over 8 B `var q: H = *p` was a handle holding the word `*p` read, and `q.v = 9` SIGSEGV'd) and
#     every other dereference of a `*T` (the review fix: `(*p)`, `*(p + 1)`, `*(0 + p)`, `*w.p`,
#     `*gp()`, `*w.mp()`, `(*self)`, a captured or global `*T`, at sizes 1 / 3 / 4 / 7 / 8 B), a
#     whole free / generic / wrapped call, a method, an operator, an if-expression, an inferred
#     `var q = mk8(5)`;
#   * a HANDLE: an untyped value, `alloc(..)`, `&x`, a `*T` call, an untyped call, an integer
#     (`var q: S8 = 0;` is a NULL handle, `= 9` a handle to address 9 — `+` on it is pointer
#     arithmetic, no operator dispatch, as at 16 B);
#   * a BIND (a second handle): a declaration from a handle, a local or a captured one.
#   A handle's consumers take its STRUCT, as over 8 B: a by-value argument (`take8(a)`,
#   `take8((a))`, a method's, a generic's, from a closure), `return a` / `return (a)`, an operator's
#   right operand, an if-expression branch, `q = a` / `a = q` (copied through the address; handle
#   <- handle REBINDS at any type, but a closure's CAPTURED handle is a source the copy goes through,
#   as at 16 B), `a = mk()` / `a = b.dbl()` / `a = b + b` / `a = if ..` / `a = w.s`
#   (copied into the object), `w.s = a`, a nested literal element, a closure capture (the env word is
#   the address), defer, match and #regalloc bodies. A handle into a `*T` parameter, an untyped
#   parameter, a closure's parameter, a `self: *T` receiver or a dyn passes its address, and `&a` is
#   its slot, as at 16 B. (An `#inline` fn with a struct parameter is not inlined — a plain call, the
#   argument row's path; an `async fn` body is the gate's AS row: CYRIUS_ASYNC=1.)
#   A copy is told from an alias by a WRITE after it: `src.v * 100 + before * 10 + after`, so 559 is
#   "5 copied, the copy written 9, the source unchanged".
# The SIZE rows (1..8 B: i8 / i16 / i32 compositions, signed values) run the by-value consumers on
# a handle of each size: argument, `(arg)`, return, `return (h)`, `q = h`, `h = q` and `h = mk()`
# (with a guard byte right after the object: no byte past it is written), operator right operand,
# if-expression branch, closure capture. 3 / 5 / 6 / 7 B are copied byte-exact through a frame temp
# (no byte past the object is read — the end-of-mapping P row is the gate's).
#
# Mutation ledger: tests/gates/codegen/small_struct_handle_line.sh (M2 .. M15), which runs this
# file on x86_64 (plain, CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm) and PE
# (wine). CROSS-HOST: the release gate's cross-OS leg runs it on ecb / ach / cass / pi.
include "lib/assert.cyr"

struct S8 { v; }                     # 8 B
struct H { v; w; }                   # 16 B — the twin
struct U8 { u; }                     # 8 B, another type
struct UH { u; x; }                  # 16 B, another type
struct W8 { s: S8; n; }
struct WH { s: H; n; }
struct I4 { a: i32; }
struct I12 { a: i32; b; }
struct Q8 { v; }
struct QH { v; w; }

trait Show { fn show(self): i64; }
impl Show for Q8 { fn show(self: *Q8): i64 { return self.v + 500; } }
impl Show for QH { fn show(self: *QH): i64 { return self.v + 500; } }
struct DW { o: dyn Show; }
fn dk0(o: dyn Show): i64 {
    var w: DW = DW { o };
    return callptr(load64(load64(&w + 8)), load64(&w));
}

var GB8 = 0;
var GBH = 0;
var GR = 0;
var G8 = S8 { 5 };
var GH = H { 5, 0 };
var GP8: *S8 = 0;
var GPH: *H = 0;

fn mk8(n): S8 { var r: S8; r.v = n; return r; }
fn mkh(n): H { var r: H; r.v = n; r.w = 0; return r; }
fn gp8(): *S8 { return GB8; }
fn gph(): *H { return GBH; }
fn ga8() { return GB8; }
fn gah() { return GBH; }
fn S8_dbl(self: S8): S8 { var r: S8; r.v = self.v * 2; return r; }
fn H_dbl(self: H): H { var r: H; r.v = self.v * 2; r.w = 0; return r; }
fn S8_add(l: S8, r: S8): S8 { var t: S8; t.v = l.v + r.v; return t; }
fn H_add(l: H, r: H): H { var t: H; t.v = l.v + r.v; t.w = 0; return t; }
fn S8_sub(a: *S8, b: *S8): i64 { return a.v - b.v; }
fn H_sub(a: *H, b: *H): i64 { return a.v - b.v; }
fn S8_with(self: S8, o: S8) { return self.v * 10 + o.v; }
fn H_with(self: H, o: H) { return self.v * 10 + o.v; }
fn S8_pm(self: *S8) { return self.v + 100; }
fn H_pm(self: *H) { return self.v + 100; }
fn take8(s: S8) { return s.v; }
fn takeh(s: H) { return s.v; }
fn rp8(p: *S8) { return p.v; }
fn rph(p: *H) { return p.v; }
fn tu(x) { return load64(x); }
fn idg<T>(x: T): T { return x; }
fn tg8<T>(k: T, s: S8) { return k + s.v; }
fn tgh<T>(k: T, s: H) { return k + s.v; }

# ── the initialiser matrix: COPIES (559: 5 copied, the copy then written 9, the source still 5) ──
fn i_local_8() { var a: S8; a.v = 5; var q: S8 = a; var b = q.v; q.v = 9; return a.v * 100 + b * 10 + q.v; }
fn i_local_h() { var a: H; a.v = 5; var q: H = a; var b = q.v; q.v = 9; return a.v * 100 + b * 10 + q.v; }
fn i_paren_8() { var a: S8; a.v = 5; var q: S8 = (a); var b = q.v; q.v = 9; return a.v * 100 + b * 10 + q.v; }
fn i_paren_h() { var a: H; a.v = 5; var q: H = (a); var b = q.v; q.v = 9; return a.v * 100 + b * 10 + q.v; }
fn i_field_8() {
    var w: W8;
    w.s.v = 5;
    w.n = 0;
    var q: S8 = w.s;
    var b = q.v;
    q.v = 9;
    return w.s.v * 100 + b * 10 + q.v;
}
fn i_field_h() {
    var w: WH;
    w.s.v = 5;
    w.n = 0;
    var q: H = w.s;
    var b = q.v;
    q.v = 9;
    return w.s.v * 100 + b * 10 + q.v;
}
fn i_param_8p(p: S8) { var q: S8 = p; var b = q.v; q.v = 9; return p.v * 100 + b * 10 + q.v; }
fn i_param_hp(p: H) { var q: H = p; var b = q.v; q.v = 9; return p.v * 100 + b * 10 + q.v; }
fn i_param_8() { var a: S8; a.v = 5; return i_param_8p(a); }
fn i_param_h() { var a: H; a.v = 5; return i_param_hp(a); }
fn i_global_8() { var q: S8 = G8; var b = q.v; q.v = 9; return G8.v * 100 + b * 10 + q.v; }
fn i_global_h() { var q: H = GH; var b = q.v; q.v = 9; return GH.v * 100 + b * 10 + q.v; }
fn i_cap_8() {
    var a: S8;
    a.v = 5;
    var f = |d| { var q: S8 = a; var b = q.v; q.v = 9 + d; return a.v * 100 + b * 10 + q.v; };
    return callptr(f, 0);
}
fn i_cap_h() {
    var a: H;
    a.v = 5;
    var f = |d| { var q: H = a; var b = q.v; q.v = 9 + d; return a.v * 100 + b * 10 + q.v; };
    return callptr(f, 0);
}
