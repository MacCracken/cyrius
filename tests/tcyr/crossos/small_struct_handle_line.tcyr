fn z3_retp() { var q: T3 = zrp3(); return zs3(q); }
fn z3_in() { var h: T3 = alloc(16); zset3(h); var q: T3; zzero3(&q); q = h; zzero3(h); return zs3(q); }
fn z3_out() {
    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    var h: T3 = x;
    var q: T3;
    zset3(&q);
    h = q;
    zzero3(&q);
    if (load8(x + 3) != 0x5A) { return 1; } return zobj3(x);
}
fn z3_call() {
    var x = alloc(16);
    store64(x, 0x5A5A5A5A5A5A5A5A);
    store64(x + 8, 0x5A5A5A5A5A5A5A5A);
    var h: T3 = x;
    h = zmk3();
