alloc_init();
test_group("the handle line: 8 B rows and their 16 B twins");
assert_eq(i_local_8(), 559, "init: a local copies");
assert_eq(i_local_8(), i_local_h(), "  = its 16 B twin");
assert_eq(i_paren_8(), 559, "init: (a local) copies");
assert_eq(i_paren_8(), i_paren_h(), "  = its 16 B twin");
assert_eq(i_field_8(), 559, "init: a struct field copies");
assert_eq(i_field_8(), i_field_h(), "  = its 16 B twin");
assert_eq(i_param_8(), 559, "init: a by-value parameter copies");
assert_eq(i_param_8(), i_param_h(), "  = its 16 B twin");
assert_eq(i_global_8(), 559, "init: a value global copies");
assert_eq(i_global_8(), i_global_h(), "  = its 16 B twin");
assert_eq(i_cap_8(), 559, "init: a capture of the struct's words copies");
assert_eq(i_cap_8(), i_cap_h(), "  = its 16 B twin");
assert_eq(i_pname_8(), 559, "init: a *T name copies");
assert_eq(i_pname_8(), i_pname_h(), "  = its 16 B twin");
assert_eq(d_par_8(), 559, "init: (*p) copies (6.7.10 review: a dereference at any spelling)");
assert_eq(d_par_8(), d_par_h(), "  = its 16 B twin");
assert_eq(d_par2_8(), 559, "init: ((*p)) copies");
assert_eq(d_par2_8(), d_par2_h(), "  = its 16 B twin");
assert_eq(d_ar_8(), 559, "init: *(p + 0) copies");
assert_eq(d_ar_8(), d_ar_h(), "  = its 16 B twin");
assert_eq(d_ar1_8(), 559, "init: *(p + 1) copies the second element");
assert_eq(d_ar1_8(), d_ar1_h(), "  = its 16 B twin");
assert_eq(d_npl_8(), 559, "init: *(0 + p) copies");
assert_eq(d_npl_8(), d_npl_h(), "  = its 16 B twin");
assert_eq(d_fld_8(), 559, "init: *w.p (a *T field) copies");
assert_eq(d_fld_8(), d_fld_h(), "  = its 16 B twin");
assert_eq(d_call_8(), 559, "init: *gp() (a : *T call) copies");
assert_eq(d_call_8(), d_call_h(), "  = its 16 B twin");
assert_eq(d_meth_8(), 559, "init: *w.mp() (a : *T method) copies");
assert_eq(d_meth_8(), d_meth_h(), "  = its 16 B twin");
assert_eq(d_self_8(), 559, "init: (*self) (a self: *T) copies");
assert_eq(d_self_8(), d_self_h(), "  = its 16 B twin");
assert_eq(d_cap_8(), 559, "init: (*p) of a captured *T copies");
assert_eq(d_cap_8(), d_cap_h(), "  = its 16 B twin");
assert_eq(d_gpar_8(), 559, "init: (*G) (a *T global) copies");
assert_eq(d_gpar_8(), d_gpar_h(), "  = its 16 B twin");
assert_eq(d_sz1(), -3, "1 B: (*p) and *(p + 0) copy, the guard byte after the source kept");
assert_eq(d_sz3(), -30000004, "3 B: (*p) and *(p + 0) copy byte-exact, the guard kept");
assert_eq(d_sz4(), -70000, "4 B: (*p) and *(p + 0) copy, the guard kept");
assert_eq(d_sz7(), -70000030000004, "7 B: (*p) and *(p + 0) copy byte-exact, the guard kept");
assert_eq(d_sz8(), -7000080000, "8 B: (*p) and *(p + 0) copy, the guard kept");
assert_eq(i_deref_8(), 559, "init: *p copies (over 8 B too, 6.7.10)");
assert_eq(i_deref_8(), i_deref_h(), "  = its 16 B twin");
assert_eq(i_derefg_8(), 559, "init: *G (a *T global) copies");
assert_eq(i_derefg_8(), i_derefg_h(), "  = its 16 B twin");
assert_eq(i_derefp_8(), 559, "init: *p (a *T parameter) copies");
assert_eq(i_derefp_8(), i_derefp_h(), "  = its 16 B twin");
assert_eq(i_derefc_8(), 559, "init: *p (a captured *T) copies");
assert_eq(i_derefc_8(), i_derefc_h(), "  = its 16 B twin");
assert_eq(i_call_8(), 559, "init: a free call copies");
assert_eq(i_call_8(), i_call_h(), "  = its 16 B twin");
assert_eq(i_callw_8(), 559, "init: a wrapped free call copies");
assert_eq(i_callw_8(), i_callw_h(), "  = its 16 B twin");
assert_eq(i_gen_8(), 559, "init: a generic call copies");
assert_eq(i_gen_8(), i_gen_h(), "  = its 16 B twin");
assert_eq(i_meth_8(), 1109, "init: a method result copies");
assert_eq(i_meth_8(), i_meth_h(), "  = its 16 B twin");
assert_eq(i_op_8(), 779, "init: an operator result copies");
assert_eq(i_op_8(), i_op_h(), "  = its 16 B twin");
assert_eq(i_inf_8(), 559, "init: an inferred `var q = mk8(5)` copies");
assert_eq(i_inf_8(), i_inf_h(), "  = its 16 B twin");
assert_eq(i_lit_8(), 559, "init: a literal copies");
assert_eq(i_lit_8(), i_lit_h(), "  = its 16 B twin");
assert_eq(h_untyped_8(), 9, "handle: from an untyped value");
assert_eq(h_untyped_8(), h_untyped_h(), "  = its 16 B twin");
assert_eq(h_alloc_8(), 9, "handle: from alloc");
assert_eq(h_alloc_8(), h_alloc_h(), "  = its 16 B twin");
assert_eq(h_addr_8(), 9, "handle: from &x");
assert_eq(h_addr_8(), h_addr_h(), "  = its 16 B twin");
assert_eq(h_pcall_8(), 9, "handle: from a *T call");
assert_eq(h_pcall_8(), h_pcall_h(), "  = its 16 B twin");
assert_eq(h_ucall_8(), 9, "handle: from an untyped call");
assert_eq(h_ucall_8(), h_ucall_h(), "  = its 16 B twin");
assert_eq(h_zero_8(), 9, "handle: from 0, then rebound to a handle");
assert_eq(h_zero_8(), h_zero_h(), "  = its 16 B twin");
assert_eq(h_int_8(), 9, "handle: from an integer, + is pointer arithmetic");
assert_eq(h_int_8(), h_int_h(), "  = its 16 B twin");
assert_eq(h_i32_8(), 4294967293, "handle: an i32-field struct from an address");
assert_eq(h_i32_8(), h_i32_h(), "  = its 16 B twin");
assert_eq(b_local_8(), 9, "bind: from a handle local");
assert_eq(b_local_8(), b_local_h(), "  = its 16 B twin");
assert_eq(b_cap_8(), 9, "bind: from a captured handle");
assert_eq(b_cap_8(), b_cap_h(), "  = its 16 B twin");
assert_eq(c_arg_8(), 5, "consumer: a by-value argument takes the struct");
assert_eq(c_arg_8(), c_arg_h(), "  = its 16 B twin");
assert_eq(c_argp_8(), 5, "consumer: a (wrapped) argument");
assert_eq(c_argp_8(), c_argp_h(), "  = its 16 B twin");
assert_eq(c_argm_8(), 15, "consumer: a method's argument");
assert_eq(c_argm_8(), c_argm_h(), "  = its 16 B twin");
assert_eq(c_argg_8(), 6, "consumer: a generic's by-value argument");
assert_eq(c_argg_8(), c_argg_h(), "  = its 16 B twin");
assert_eq(c_gen_8(), 559, "consumer: a generic identity copies");
assert_eq(c_gen_8(), c_gen_h(), "  = its 16 B twin");
assert_eq(c_recv_8(), 51, "consumer: a by-value receiver");
assert_eq(c_recv_8(), c_recv_h(), "  = its 16 B twin");
assert_eq(c_recvd_8(), 10, "consumer: a by-value receiver, struct result");
assert_eq(c_recvd_8(), c_recvd_h(), "  = its 16 B twin");
assert_eq(c_ret_8(), 5, "consumer: return a");
assert_eq(c_ret_8(), c_ret_h(), "  = its 16 B twin");
assert_eq(c_retp_8(), 5, "consumer: return (a)");
assert_eq(c_retp_8(), c_retp_h(), "  = its 16 B twin");
assert_eq(c_opr_8(), 6, "consumer: an operator's right operand");
assert_eq(c_opr_8(), c_opr_h(), "  = its 16 B twin");
assert_eq(c_opl_8(), 8, "consumer: a left operand is pointer arithmetic");
assert_eq(c_opl_8(), c_opl_h(), "  = its 16 B twin");
assert_eq(c_ain_8(), 559, "consumer: q = a copies");
assert_eq(c_ain_8(), c_ain_h(), "  = its 16 B twin");
assert_eq(c_aout_8(), 7, "consumer: a = q copies into the object");
assert_eq(c_aout_8(), c_aout_h(), "  = its 16 B twin");
assert_eq(c_rb_8(), 58, "consumer: handle <- handle rebinds");
assert_eq(c_rb_8(), c_rb_h(), "  = its 16 B twin");
assert_eq(c_rbt_8(), 58, "consumer: handle <- handle of another type rebinds");
assert_eq(c_rbt_8(), c_rbt_h(), "  = its 16 B twin");
assert_eq(c_acall_8(), 7, "consumer: a = mk() copies into the object");
assert_eq(c_acall_8(), c_acall_h(), "  = its 16 B twin");
assert_eq(c_acallw_8(), 7, "consumer: a = (mk()) copies into the object");
assert_eq(c_acallw_8(), c_acallw_h(), "  = its 16 B twin");
assert_eq(c_ameth_8(), 8, "consumer: a = b.dbl() copies into the object");
assert_eq(c_ameth_8(), c_ameth_h(), "  = its 16 B twin");
assert_eq(c_aop_8(), 8, "consumer: a = b + b copies into the object");
assert_eq(c_aop_8(), c_aop_h(), "  = its 16 B twin");
assert_eq(c_afld_8(), 6, "consumer: a = w.s copies into the object");
assert_eq(c_afld_8(), c_afld_h(), "  = its 16 B twin");
assert_eq(c_agl_8(), 5, "consumer: a = G copies into the object");
assert_eq(c_agl_8(), c_agl_h(), "  = its 16 B twin");
assert_eq(c_gla_8(), 6, "consumer: G = a copies");
assert_eq(c_gla_8(), c_gla_h(), "  = its 16 B twin");
assert_eq(c_fst_8(), 5, "consumer: w.s = a copies");
assert_eq(c_fst_8(), c_fst_h(), "  = its 16 B twin");
assert_eq(c_nlit_8(), 52, "consumer: a nested literal element copies");
assert_eq(c_nlit_8(), c_nlit_h(), "  = its 16 B twin");
assert_eq(c_ncap_8(), 9, "consumer: a nested closure writes the object");
assert_eq(c_ncap_8(), c_ncap_h(), "  = its 16 B twin");
assert_eq(c_carg_8(), 5, "consumer: a captured handle as an argument");
assert_eq(c_carg_8(), c_carg_h(), "  = its 16 B twin");
assert_eq(c_cin_8(), 559, "consumer: q = a with a captured handle copies");
assert_eq(c_cin_8(), c_cin_h(), "  = its 16 B twin");
assert_eq(c_crb_8(), 57, "consumer: handle = a captured handle copies (a capture is a value source)");
assert_eq(c_crb_8(), c_crb_h(), "  = its 16 B twin");
assert_eq(c_copr_8(), 6, "consumer: a captured handle as an operator's right operand");
assert_eq(c_copr_8(), c_copr_h(), "  = its 16 B twin");
assert_eq(c_match_8(1), 5, "consumer: in a match arm");
assert_eq(c_match_8(1), c_match_h(1), "  = its 16 B twin");
assert_eq(c_ra_8(), 10, "consumer: in a #regalloc fn");
assert_eq(c_ra_8(), c_ra_h(), "  = its 16 B twin");
assert_eq(x_ptrarg_8(), 5, "address: into a *T parameter");
assert_eq(x_ptrarg_8(), x_ptrarg_h(), "  = its 16 B twin");
assert_eq(x_ptrop_8(), 4, "address: into a *T operator operand");
assert_eq(x_ptrop_8(), x_ptrop_h(), "  = its 16 B twin");
assert_eq(x_ptrself_8(), 105, "address: a self: *T receiver");
assert_eq(x_ptrself_8(), x_ptrself_h(), "  = its 16 B twin");
assert_eq(x_untyped_8(), 5, "address: into an untyped parameter");
assert_eq(x_untyped_8(), x_untyped_h(), "  = its 16 B twin");
assert_eq(x_clo_8(), 5, "address: into a closure's parameter");
assert_eq(x_clo_8(), x_clo_h(), "  = its 16 B twin");
assert_eq(x_dyn_8(), 507, "address: a dyn formed from a handle");
assert_eq(x_dyn_8(), x_dyn_h(), "  = its 16 B twin");
assert_eq(x_addr_8(), 0, "address: &a is the slot holding the address");
assert_eq(x_addr_8(), x_addr_h(), "  = its 16 B twin");
assert_eq(x_opeq_8(), 8, "OP= on a handle's field writes the object");
assert_eq(x_opeq_8(), x_opeq_h(), "  = its 16 B twin");
assert_eq(i_ie_8(1), 559, "init: an if-expression copies (no 16 B twin: a branch over 8 B is refused)");
assert_eq(c_ie_8(1), 559, "consumer: an if-expression branch takes the struct");
assert_eq(c_aie_8(1), 4, "consumer: a = if .. copies into the object");
assert_eq(c_cie_8(), 5, "consumer: a captured handle as an if-expression branch");
c_def_8();
var gd8 = GR;
c_def_h();
assert_eq(gd8, 6, "consumer: a defer body takes the struct");
assert_eq(gd8, GR, "  = its 16 B twin");
test_group("the handle line at every size 1..8 B");
