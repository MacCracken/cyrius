# small_struct_pointer_copy.tcyr — 6.7.10 (B7-1c). STRUCT COPIES ARE SIZE-INDEPENDENT (the user's
# decision 6, 2026-10-12): `l = p` / `G = p` with `p: *S` copy the struct p points at, and `q = r`
# through `q: *S` copies r into the pointee, at every size — as over 8 B.
#
# ⛔ THE ASYMMETRY, 6.7.0 through 6.7.9 (measured). Over 8 B a `*T` local or parameter is a copy-assign HANDLE
# (its slot holds the address): `l = p` copied `*p` into l, `G = p` into the global, `q = r` and
# `p = l` copied into the pointee, and `p = p2` rebound p. A `*T` of a struct of 8 B or less was not a
# struct operand at all, so the same statements were one-word stores, with no diagnostic: `l = p` and
# `G = p` stored the POINTER into the first field (`l.v` read the address), and `q = r` / `p = l`
# rebound q / p to r's word (the pointee never changed; the next `q.v` read through r's field as an
# address). The other struct-copy sources into a `*T` were stores of the struct's word too:
# `p = mk8(4)`, `p = l.dbl()`, `p = l + m`, `p = if (c) { l } else { m }`, `p = w.s`, each a garbage
# pointer.
#
# THE RULE, every `_8` row against its `_h` twin over 8 B (both must give the row's constant, except
# the if-expression: a struct VALUE over 8 B is no if-expression branch, `_ie_big_err`):
#   * a COPY between a `*T` (a local, a parameter — `self: *T` too —, a closure's captured `*T` as a
#     source) and a struct value (an inline local, a by-value parameter, a value global, a captured
#     struct): `l = p`, `G = p`, `l = q`, `G = q`, `q = r`, `q = G`, `p = l`, `p = G`, wrapped (`l =
#     (p)`, `p = ((l))`); and a struct result into a `*T`: a call, a wrapped call, a method, an
#     operator, an if-expression, a field — each copied into the POINTEE, byte-exact (3 / 5 / 6 / 7 B
#     too: the guard byte after the object is kept); in a fn, a closure body, a defer body, a
#     #regalloc fn;
#   * a REBIND (the one-word store, as over 8 B): `*T` <- `*T` (`p = p2`, `q = q2`, `p = pu` of
#     another struct), `*T` <- handle and handle <- `*T` — at any pair of struct types;
#   * a captured `*T` SOURCE into a `*T` local copies (`pc = p` in a closure body), as over 8 B, where a
#     capture is a value source (6.6.13);
#   * THE BOUNDARY (unchanged, as over 8 B): a `*i64` (or an untyped local holding an address) into a
#     struct value stores its word.
# A copy is told from an alias by a WRITE after it. A struct value of ANOTHER type is refused by name,
# as over 8 B (`l = pu`, `pu = l`, `G = pu`, `q = G`, `p = mku(1)`: the gate's CP rows).
# Not here: a `*T` GLOBAL (`l = GP`, `GP = l`), a `: *T` call (`l = gp()`) and a `*T` field (`l = w.p`)
# store the word at EVERY size (over 8 B too) — a separate, pre-existing defect.
# The SIZE rows (1..8 B: i8 / i16 / i32 compositions, signed values) run the six shapes on each size
# with a guard byte right after the object (a field of the enclosing struct, a global declared after
# the value global): no byte past the object is written. The end-of-mapping row is the gate's (PM).
#
# Mutation ledger: tests/gates/codegen/small_struct_handle_line.sh (MC1 .. MC4), which runs this file
# on x86_64 (plain, CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm) and PE (wine).
# CROSS-HOST: the release gate's cross-OS leg runs it on ecb / ach / cass / pi.
include "lib/assert.cyr"
include "lib/alloc.cyr"

struct S8 { v; }                     # 8 B
struct H { v; w; }                   # 16 B — the twin
struct U8 { u; }                     # 8 B, another type
struct UH { u; x; }                  # 16 B, another type
struct W8 { s: S8; n; }
struct WH { s: H; n; }

var G8 = S8 { 0 };
var GH = H { 0, 0 };
var GD8 = 0;
var GDH = 0;

fn mk8(n): S8 { var r: S8; r.v = n; return r; }
fn mkh(n): H { var r: H; r.v = n; r.w = 0; return r; }
impl S8 { fn dbl(self: S8): S8 { var r: S8; r.v = self.v * 2; return r; } }
impl H { fn dbl(self: H): H { var r: H; r.v = self.v * 2; r.w = 0; return r; } }
impl S8 { fn setto(self: *S8, o: S8): i64 { self = o; return self.v; } }
impl H { fn setto(self: *H, o: H): i64 { self = o; return self.v; } }
fn S8_add(a: S8, b: S8): S8 { var r: S8; r.v = a.v + b.v; return r; }
fn H_add(a: H, b: H): H { var r: H; r.v = a.v + b.v; r.w = 0; return r; }

# ── the six shapes (`src.v` copied; the write after it tells a copy from an alias) ──
# l = p: 5 copied, then x written 6 -> 56
fn s_lp_8() { var x: S8; x.v = 5; var p: *S8 = &x; var l: S8; l.v = 1; l = p; x.v = 6; return l.v * 10 + x.v; }
fn s_lp_h() {
    var x: H; x.v = 5; x.w = 0;
    var p: *H = &x;
    var l: H; l.v = 1; l.w = 0;
    l = p;
    x.v = 6;
    return l.v * 10 + x.v;
}
# G = p -> 56
fn s_gp_8() { var x: S8; x.v = 5; var p: *S8 = &x; G8.v = 1; G8 = p; x.v = 6; return G8.v * 10 + x.v; }
fn s_gp_h() { var x: H; x.v = 5; x.w = 0; var p: *H = &x; GH.v = 1; GH = p; x.v = 6; return GH.v * 10 + x.v; }
# q = r through a *T parameter: the pointee gets 7; the callee's later write to r stays its own -> 777
fn s_qr_p8(q: *S8, r: S8) { q = r; r.v = 9; return q.v; }
fn s_qr_ph(q: *H, r: H) { q = r; r.v = 9; return q.v; }
fn s_qr_8() { var d: S8; d.v = 1; var r: S8; r.v = 7; var k = s_qr_p8(&d, r); return d.v * 100 + k * 10 + r.v; }
fn s_qr_h() {
    var d: H; d.v = 1; d.w = 0;
    var r: H; r.v = 7; r.w = 0;
    var k = s_qr_ph(&d, r);
    return d.v * 100 + k * 10 + r.v;
}
# l = q: 5 copied out of the pointee, then the pointee written 9 -> 599
fn s_lq_p8(q: *S8) { var l: S8; l.v = 1; l = q; q.v = 9; return l.v * 10 + q.v; }
fn s_lq_ph(q: *H) { var l: H; l.v = 1; l.w = 0; l = q; q.v = 9; return l.v * 10 + q.v; }
fn s_lq_8() { var x: S8; x.v = 5; var r = s_lq_p8(&x); return r * 10 + x.v; }
fn s_lq_h() { var x: H; x.v = 5; x.w = 0; var r = s_lq_ph(&x); return r * 10 + x.v; }
# q = G: 4 into the pointee, then G written 9 -> 449
fn s_qg_p8(q: *S8) { q = G8; G8.v = 9; return q.v; }
fn s_qg_ph(q: *H) { q = GH; GH.v = 9; return q.v; }
fn s_qg_8() { G8.v = 4; var d: S8; d.v = 1; var k = s_qg_p8(&d); return d.v * 100 + k * 10 + G8.v; }
fn s_qg_h() { GH.v = 4; GH.w = 0; var d: H; d.v = 1; d.w = 0; var k = s_qg_ph(&d); return d.v * 100 + k * 10 + GH.v; }
# p = l: 3 into the pointee (p still points at y), then l written 4 -> 334
fn s_pl_8() {
    var y: S8;
    y.v = 1;
    var p: *S8 = &y;
    var l: S8;
    l.v = 3;
    p = l;
    l.v = 4;
    return y.v * 100 + p.v * 10 + l.v;
}
fn s_pl_h() {
    var y: H; y.v = 1; y.w = 0;
    var p: *H = &y;
    var l: H; l.v = 3; l.w = 0;
    p = l;
    l.v = 4;
    return y.v * 100 + p.v * 10 + l.v;
}
# G = q -> 59; p = G -> 67
fn s_gq_p8(q: *S8) { G8 = q; q.v = 9; return G8.v; }
fn s_gq_ph(q: *H) { GH = q; q.v = 9; return GH.v; }
fn s_gq_8() { var x: S8; x.v = 5; var k = s_gq_p8(&x); return k * 10 + x.v; }
fn s_gq_h() { var x: H; x.v = 5; x.w = 0; var k = s_gq_ph(&x); return k * 10 + x.v; }
fn s_pg_8() { G8.v = 6; var y: S8; y.v = 1; var p: *S8 = &y; p = G8; G8.v = 7; return y.v * 10 + G8.v; }
fn s_pg_h() {
    GH.v = 6;
    GH.w = 0;
    var y: H;
    y.v = 1;
    y.w = 0;
    var p: *H = &y;
    p = GH;
    GH.v = 7;
    return y.v * 10 + GH.v;
}
# wrapped: l = (p), py = ((l)) -> 556
fn s_wrap_8() {
    var x: S8; x.v = 5;
    var p: *S8 = &x;
    var l: S8; l.v = 1;
    l = (p);
    var y: S8; y.v = 1;
    var py: *S8 = &y;
    py = ((l));
    x.v = 6;
    return l.v * 100 + y.v * 10 + x.v;
}
fn s_wrap_h() {
    var x: H; x.v = 5; x.w = 0;
    var p: *H = &x;
    var l: H; l.v = 1; l.w = 0;
    l = (p);
    var y: H; y.v = 1; y.w = 0;
    var py: *H = &y;
    py = ((l));
    x.v = 6;
    return l.v * 100 + y.v * 10 + x.v;
}
# self = o through `self: *T` -> 44 (o stored before the receiver: see the IR=3 note in small_struct_pointer_arg.tcyr)
fn s_self_8() { var o: S8; o.v = 4; var y: S8; y.v = 1; var k = y.setto(o); return y.v * 10 + k; }
fn s_self_h() { var o: H; o.v = 4; o.w = 0; var y: H; y.v = 1; y.w = 0; var k = y.setto(o); return y.v * 10 + k; }

# ── a struct result into a *T: copied into the pointee ──
fn x_call_8() { var y: S8; y.v = 1; var p: *S8 = &y; p = mk8(4); return y.v * 10 + p.v; }
fn x_call_h() { var y: H; y.v = 1; y.w = 0; var p: *H = &y; p = mkh(4); return y.v * 10 + p.v; }
fn x_wcall_8() { var y: S8; y.v = 1; var p: *S8 = &y; p = (mk8(4)); return y.v * 10 + p.v; }
fn x_wcall_h() { var y: H; y.v = 1; y.w = 0; var p: *H = &y; p = (mkh(4)); return y.v * 10 + p.v; }
fn x_meth_8() { var l: S8; l.v = 3; var y: S8; y.v = 1; var p: *S8 = &y; p = l.dbl(); return y.v * 10 + l.v; }
fn x_meth_h() {
    var l: H;
    l.v = 3;
    l.w = 0;
    var y: H;
    y.v = 1;
    y.w = 0;
    var p: *H = &y;
    p = l.dbl();
    return y.v * 10 + l.v;
}
fn x_op_8() {
    var y: S8;
    y.v = 1;
    var p: *S8 = &y;
    var l: S8;
    l.v = 3;
    var m: S8;
    m.v = 4;
    p = l + m;
    return y.v * 10 + p.v;
}
fn x_op_h() {
    var y: H; y.v = 1; y.w = 0;
    var p: *H = &y;
    var l: H; l.v = 3; l.w = 0;
    var m: H; m.v = 4; m.w = 0;
    p = l + m;
    return y.v * 10 + p.v;
}
fn x_ie_8(c) {
    var y: S8; y.v = 1;
    var p: *S8 = &y;
    var l: S8; l.v = 3;
    var m: S8; m.v = 4;
    p = if (c == 1) { l } else { m };
    l.v = 5;
    m.v = 5;
    return y.v;
}
fn x_field_8() {
    var y: S8;
    y.v = 1;
    var p: *S8 = &y;
    var w: W8;
    w.s.v = 5;
    w.n = 0;
    p = w.s;
    w.s.v = 6;
    return y.v * 10 + w.s.v;
}
fn x_field_h() {
    var y: H; y.v = 1; y.w = 0;
    var p: *H = &y;
    var w: WH; w.s.v = 5; w.s.w = 0; w.n = 0;
    p = w.s;
    w.s.v = 6;
    return y.v * 10 + w.s.v;
}

# ── rebinds: *T <- *T, *T <- handle, handle <- *T (the object written afterwards is the new one) ──
fn r_pp_8() {
    var a: S8;
    a.v = 1;
    var b: S8;
    b.v = 2;
    var p: *S8 = &a;
    var p2: *S8 = &b;
    p = p2;
    p.v = 7;
    return a.v * 10 + b.v;
}
fn r_pp_h() {
    var a: H; a.v = 1; a.w = 0;
    var b: H; b.v = 2; b.w = 0;
    var p: *H = &a;
    var p2: *H = &b;
    p = p2;
    p.v = 7;
    return a.v * 10 + b.v;
}
fn r_qq_p8(q: *S8, q2: *S8) { q = q2; q.v = 7; return 0; }
fn r_qq_ph(q: *H, q2: *H) { q = q2; q.v = 7; return 0; }
fn r_qq_8() { var a: S8; a.v = 1; var b: S8; b.v = 2; r_qq_p8(&a, &b); return a.v * 10 + b.v; }
fn r_qq_h() { var a: H; a.v = 1; a.w = 0; var b: H; b.v = 2; b.w = 0; r_qq_ph(&a, &b); return a.v * 10 + b.v; }
fn r_ph_8() {
    var a: S8;
    a.v = 1;
    var p: *S8 = &a;
    var h: S8 = alloc(8);
    h.v = 2;
    p = h;
    p.v = 7;
    return a.v * 10 + h.v;
}
fn r_ph_h() {
    var a: H;
    a.v = 1;
    a.w = 0;
    var p: *H = &a;
    var h: H = alloc(16);
    h.v = 2;
    p = h;
    p.v = 7;
    return a.v * 10 + h.v;
}
fn r_hp_8() {
    var a: S8;
    a.v = 1;
    var p: *S8 = &a;
    var h: S8 = alloc(8);
    h.v = 2;
    h = p;
    h.v = 7;
    return a.v * 10 + p.v;
}
fn r_hp_h() {
    var a: H;
    a.v = 1;
    a.w = 0;
    var p: *H = &a;
    var h: H = alloc(16);
    h.v = 2;
    h = p;
    h.v = 7;
    return a.v * 10 + p.v;
}
fn r_pu_8() {
    var a: S8;
    a.v = 1;
    var u: U8;
    u.u = 2;
    var p: *S8 = &a;
    var pu: *U8 = &u;
    p = pu;
    p.v = 7;
    return a.v * 10 + u.u;
}
fn r_pu_h() {
    var a: H; a.v = 1; a.w = 0;
    var u: UH; u.u = 2; u.x = 0;
    var p: *H = &a;
    var pu: *UH = &u;
    p = pu;
    p.v = 7;
    return a.v * 10 + u.u;
}

# ── closures ──
# l = p with p a captured *T (5 copied; then p written 6) -> 566
fn k_lp_8() {
    var x: S8;
    x.v = 5;
    var p: *S8 = &x;
    var f = |d| { var l: S8; l.v = 1; l = p; p.v = 6 + d; return l.v * 10 + p.v; };
    var r = callptr(f, 0);
    return r * 10 + x.v;
}
fn k_lp_h() {
    var x: H;
    x.v = 5;
    x.w = 0;
    var p: *H = &x;
    var f = |d| { var l: H; l.v = 1; l.w = 0; l = p; p.v = 6 + d; return l.v * 10 + p.v; };
    var r = callptr(f, 0);
    return r * 10 + x.v;
}
# pc = m: a closure's own *T destination -> 34
fn k_pl_8() {
    var f = |d| {
        var y: S8; y.v = 1;
        var pc: *S8 = &y;
        var m: S8; m.v = 3 + d;
        pc = m;
        m.v = 4;
        return y.v * 10 + m.v;
    };
    return callptr(f, 0);
}
fn k_pl_h() {
    var f = |d| {
        var y: H; y.v = 1; y.w = 0;
        var pc: *H = &y;
        var m: H; m.v = 3 + d; m.w = 0;
        pc = m;
        m.v = 4;
        return y.v * 10 + m.v;
    };
    return callptr(f, 0);
}
# pc = p, p a captured *T: a copy into pc's pointee, as over 8 B -> 56
fn k_pcap_8() {
    var x: S8;
    x.v = 5;
    var p: *S8 = &x;
    var f = |d| { var y: S8; y.v = 1; var pc: *S8 = &y; pc = p; p.v = 6 + d; return y.v * 10 + p.v; };
    return callptr(f, 0);
}
fn k_pcap_h() {
    var x: H;
    x.v = 5;
    x.w = 0;
    var p: *H = &x;
    var f = |d| { var y: H; y.v = 1; y.w = 0; var pc: *H = &y; pc = p; p.v = 6 + d; return y.v * 10 + p.v; };
    return callptr(f, 0);
}
# G = p, p a captured *T -> 56
fn k_gp_8() {
    var x: S8;
    x.v = 5;
    var p: *S8 = &x;
    var f = |d| { G8 = p; p.v = 6 + d; return G8.v * 10 + p.v; };
    return callptr(f, 0);
}
fn k_gp_h() {
    var x: H;
    x.v = 5;
    x.w = 0;
    var p: *H = &x;
    var f = |d| { GH = p; p.v = 6 + d; return GH.v * 10 + p.v; };
    return callptr(f, 0);
}
# l = q, q a captured *T parameter -> 566
fn k_lq_p8(q: *S8) {
    var f = |d| { var l: S8; l.v = 1; l = q; q.v = 6 + d; return l.v * 10 + q.v; };
    return callptr(f, 0);
}
fn k_lq_ph(q: *H) {
    var f = |d| { var l: H; l.v = 1; l.w = 0; l = q; q.v = 6 + d; return l.v * 10 + q.v; };
    return callptr(f, 0);
}
fn k_lq_8() { var x: S8; x.v = 5; return k_lq_p8(&x) * 10 + x.v; }
fn k_lq_h() { var x: H; x.v = 5; x.w = 0; return k_lq_ph(&x) * 10 + x.v; }
# pc = l, l a captured struct value (its words at the capture: 3) -> 3
fn k_pv_8() {
    var l: S8;
    l.v = 3;
    var f = |d| { var y: S8; y.v = 1; var pc: *S8 = &y; pc = l; return y.v + d; };
    l.v = 4;
    return callptr(f, 0);
}
fn k_pv_h() {
    var l: H;
    l.v = 3;
    l.w = 0;
    var f = |d| { var y: H; y.v = 1; y.w = 0; var pc: *H = &y; pc = l; return y.v + d; };
    l.v = 4;
    return callptr(f, 0);
}

# ── defer and #regalloc bodies ──
fn d_8() { var x: S8; x.v = 5; var p: *S8 = &x; var l: S8; l.v = 1; defer { l = p; GD8 = l.v; } x.v = 6; return 0; }
fn d_h() {
    var x: H;
    x.v = 5;
    x.w = 0;
    var p: *H = &x;
    var l: H;
    l.v = 1;
    l.w = 0;
    defer { l = p; GDH = l.v; }
    x.v = 6;
    return 0;
}
#regalloc
fn ra_8() {
    var x: S8;
    x.v = 5;
    var p: *S8 = &x;
    var l: S8;
    l.v = 1;
    l = p;
    var y: S8;
    y.v = 1;
    var q: *S8 = &y;
    q = l;
    x.v = 6;
    return l.v * 100 + y.v * 10 + x.v;
}
#regalloc
fn ra_h() {
    var x: H; x.v = 5; x.w = 0;
    var p: *H = &x;
    var l: H; l.v = 1; l.w = 0;
    l = p;
    var y: H; y.v = 1; y.w = 0;
    var q: *H = &y;
    q = l;
    x.v = 6;
    return l.v * 100 + y.v * 10 + x.v;
}

# ── the boundary: a *i64 — its word, as over 8 B ──
fn b_i64p_8() { var k = 9; var pi: *i64 = &k; var l: S8; l.v = 1; l = pi; if (l.v == pi) { return 1; } return 0; }
fn b_i64p_h() {
    var k = 9;
    var pi: *i64 = &k;
    var l: H;
    l.v = 1;
    l.w = 0;
    l = pi;
    if (l.v == pi) { return 1; }
    return 0;
}

# ── every size 1..8 B: the six shapes, a guard byte after the object (a field; a global declared after it) ──
struct B1 { a: i8; }
struct C1 { b: B1; g: i8; }
struct B2 { a: i16; }
struct C2 { b: B2; g: i8; }
struct B3 { a: i8; b: i8; c: i8; }
struct C3 { b: B3; g: i8; }
struct B4 { a: i32; }
struct C4 { b: B4; g: i8; }
struct B5 { a: i32; b: i8; }
struct C5 { b: B5; g: i8; }
struct B6 { a: i32; b: i16; }
struct C6 { b: B6; g: i8; }
struct B7 { a: i32; b: i16; c: i8; }
struct C7 { b: B7; g: i8; }
struct B8 { a: i32; b: i32; }
struct C8 { b: B8; g: i8; }

var GB1 = B1 { 0 };
var ZB1: i8 = 99;
var GB2 = B2 { 0 };
var ZB2: i8 = 99;
var GB3 = B3 { 0, 0, 0 };
var ZB3: i8 = 99;
var GB4 = B4 { 0 };
var ZB4: i8 = 99;
var GB5 = B5 { 0, 0 };
var ZB5: i8 = 99;
