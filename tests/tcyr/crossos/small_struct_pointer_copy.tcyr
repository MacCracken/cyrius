var ZB8: i8 = 99;

fn q1_r(q: *B1, r: B1) { q = r; return 0; }
fn q1_g(q: *B1) { q = GB1; return 0; }
fn q1_l(q: *B1) { var l: B1; l.a = 5; l = q; if (l.a == 0 - 7) { return 1; } return 0; }
fn z1() {
    var c: C1; c.b.a = 0 - 7; c.g = 99;
    var p: *B1 = &c;
    var k = 0;
    var l: B1; l.a = 5;
    l = p;
    p.a = 5;
    if (l.a == 0 - 7) { k = k + 1; }
    var m: B1; m.a = 5;
    p = m;
    m.a = 0 - 7;
    if (c.b.a == 5 && c.g == 99) { k = k + 1; }
    GB1 = p;
    if (GB1.a == 5 && ZB1 == 99) { k = k + 1; }
    var r: B1; r.a = 0 - 7;
    q1_r(&c, r);
    if (c.b.a == 0 - 7 && c.g == 99) { k = k + 1; }
    k = k + q1_l(&c);
    q1_g(&c);
    if (c.b.a == 5 && c.g == 99) { k = k + 1; }
    return k;
}
