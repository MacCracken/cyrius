alloc_init();
assert_eq(s_lp_8(), 56, "l = p: *p copied into l (not an alias)");
assert_eq(s_lp_8(), s_lp_h(), "  = its 16 B twin");
assert_eq(s_gp_8(), 56, "G = p: *p copied into a value global");
assert_eq(s_gp_8(), s_gp_h(), "  = its 16 B twin");
assert_eq(s_qr_8(), 777, "q = r through a *T parameter: r copied into the pointee");
assert_eq(s_qr_8(), s_qr_h(), "  = its 16 B twin");
assert_eq(s_lq_8(), 599, "l = q: the pointee copied out of a *T parameter");
assert_eq(s_lq_8(), s_lq_h(), "  = its 16 B twin");
assert_eq(s_qg_8(), 449, "q = G: a value global copied into the pointee");
assert_eq(s_qg_8(), s_qg_h(), "  = its 16 B twin");
assert_eq(s_pl_8(), 334, "p = l: a *T local's pointee takes the copy, p still points at it");
assert_eq(s_pl_8(), s_pl_h(), "  = its 16 B twin");
assert_eq(s_gq_8(), 59, "G = q");
assert_eq(s_gq_8(), s_gq_h(), "  = its 16 B twin");
assert_eq(s_pg_8(), 67, "p = G");
assert_eq(s_pg_8(), s_pg_h(), "  = its 16 B twin");
assert_eq(s_wrap_8(), 556, "l = (p), py = ((l))");
assert_eq(s_wrap_8(), s_wrap_h(), "  = its 16 B twin");
assert_eq(s_self_8(), 44, "self = o through self: *T");
assert_eq(s_self_8(), s_self_h(), "  = its 16 B twin");
assert_eq(x_call_8(), 44, "p = mk8(4): a call's struct into the pointee");
assert_eq(x_call_8(), x_call_h(), "  = its 16 B twin");
assert_eq(x_wcall_8(), 44, "p = (mk8(4))");
assert_eq(x_wcall_8(), x_wcall_h(), "  = its 16 B twin");
assert_eq(x_meth_8(), 63, "p = l.dbl(): a method's struct into the pointee");
assert_eq(x_meth_8(), x_meth_h(), "  = its 16 B twin");
assert_eq(x_op_8(), 77, "p = l + m: an operator's struct into the pointee");
assert_eq(x_op_8(), x_op_h(), "  = its 16 B twin");
assert_eq(x_ie_8(1) * 10 + x_ie_8(0), 34, "p = if (c) { l } else { m }: into the pointee (no 16 B twin: _ie_big_err)");
assert_eq(x_field_8(), 56, "p = w.s: a field's struct into the pointee");
assert_eq(x_field_8(), x_field_h(), "  = its 16 B twin");
assert_eq(r_pp_8(), 17, "p = p2 rebinds");
assert_eq(r_pp_8(), r_pp_h(), "  = its 16 B twin");
assert_eq(r_qq_8(), 17, "q = q2 (two *T parameters) rebinds");
assert_eq(r_qq_8(), r_qq_h(), "  = its 16 B twin");
assert_eq(r_ph_8(), 17, "p = h (a handle) rebinds");
assert_eq(r_ph_8(), r_ph_h(), "  = its 16 B twin");
assert_eq(r_hp_8(), 77, "h = p (into a handle) rebinds");
assert_eq(r_hp_8(), r_hp_h(), "  = its 16 B twin");
assert_eq(r_pu_8(), 17, "p = pu (a *U of another struct) rebinds");
assert_eq(r_pu_8(), r_pu_h(), "  = its 16 B twin");
assert_eq(k_lp_8(), 566, "closure: l = p, p a captured *T");
assert_eq(k_lp_8(), k_lp_h(), "  = its 16 B twin");
assert_eq(k_pl_8(), 34, "closure: pc = m into the closure's own *T");
assert_eq(k_pl_8(), k_pl_h(), "  = its 16 B twin");
assert_eq(k_pcap_8(), 56, "closure: pc = p, p a captured *T, copies (a capture is a value source)");
assert_eq(k_pcap_8(), k_pcap_h(), "  = its 16 B twin");
assert_eq(k_gp_8(), 56, "closure: G = p, p a captured *T");
assert_eq(k_gp_8(), k_gp_h(), "  = its 16 B twin");
assert_eq(k_lq_8(), 566, "closure: l = q, q a captured *T parameter");
assert_eq(k_lq_8(), k_lq_h(), "  = its 16 B twin");
assert_eq(k_pv_8(), 3, "closure: pc = l, l a captured struct (its words at the capture)");
assert_eq(k_pv_8(), k_pv_h(), "  = its 16 B twin");
d_8();
d_h();
assert_eq(GD8, 6, "a defer body: l = p at the fn's return");
assert_eq(GD8, GDH, "  = its 16 B twin");
assert_eq(ra_8(), 556, "a #regalloc fn: l = p, q = l");
assert_eq(ra_8(), ra_h(), "  = its 16 B twin");
assert_eq(b_i64p_8(), 1, "boundary: a *i64 into a struct value is its word");
