fn a3_p(): i64 { var x = D3 { 5, 8, 9 }; return a3_pf(x); }
fn a3_x(): i64 { var d: D3 = *(&AX3); var l = D3 { 0, 0, 0 }; l = *(&AX3); return (d.a * 100 + d.b * 10 + d.c) * 1000 + l.a * 100 + l.b * 10 + l.c; }
