    for (i = 0; i < 1; o.s = (*p)) { i = i + 1; }
    x.a = 1;
    return (l.a * 100 + l.b * 10 + l.c) * 1000 + o.s.a * 100 + o.s.b * 10 + o.s.c + (o.g - 99) * 1000000;
}
fn s3_h(): i64 {
    var x = D3 { 5, 8, 9 };
