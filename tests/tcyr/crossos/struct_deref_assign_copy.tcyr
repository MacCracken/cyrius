fn a8_l(): i64 { var x = D8 { 5, 8 }; var l = D8 { 0, 0 }; l = *(&x); var m = D8 { 0, 0 }; m = (*&x); x.a = 1; return (l.a * 10 + l.b) * 1000 + m.a * 10 + m.b; }
