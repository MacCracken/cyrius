var TT8 = D8 { 0, 0 };
var TH8: D8 = &TT8;
var TXH = DH { 5, 8 };
var TPH: *DH = &TXH;
var TGH = DH { 0, 0 };
var TZH: i8 = 99;
var TOH = OH { 0, 0, 99 };
var TTH = DH { 0, 0 };
var THH: DH = &TTH;
