var RHb = TGH.a * 10 + TGH.b;
GPH = TPH;
TOH.s = *gpH();
var RHc = TOH.s.a * 10 + TOH.s.b + (TOH.g - 99) * 1000;
THH = *TPH;
var RHd = TTH.a * 10 + TTH.b;
TGT = (*TPT);
var RTb = TGT.a * 100 + TGT.b * 10 + TGT.c;
GPT = TPT;
TOT.s = *gpT();
var RTc = TOT.s.a * 100 + TOT.s.b * 10 + TOT.s.c + (TOT.g - 99) * 1000;
THT = *TPT;
var RTd = TTT.a * 100 + TTT.b * 10 + TTT.c;
TX3.a = 1;
TXH.a = 1;
var TBD3: D3 = (*&AX3);
AG3 = *(&AX3);
var TBG3 = AG3.a * 100 + AG3.b * 10 + AG3.c + (AZ3 - 99) * 10000;
var TBD8: D8 = (*&AX8);
AG8 = *(&AX8);
