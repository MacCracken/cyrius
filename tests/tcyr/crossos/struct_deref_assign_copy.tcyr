# ── 6.7.13: a dereference of an ADDRESS-OF, `*(&x)` / `*&x`, is the struct `x` names
# (issues/2026-10-14-dereference-of-address-of-struct-faults.md): through 6.7.12 `_hl_psid` answered 0 for `&x`, so
# `var d: S = *(&x);` over 8 B was a HANDLE holding x's first field as its address (SIGSEGV), `l = *(&x)` / `G =
# *(&x)` / `o.s = *(&x)` stored that one word, and `return *(&x)` over 8 B was refused. The `a` rows at 3 / 8 / 16 /
# 24 B, the source written after the copy (a copy, not an alias): a declaration, a local, a global and a field
# destination (the guard after each kept), a `*S` destination (into the pointee), a store `*(&G) = v` / `*&l = v`,
# a `return`, the source a by-value parameter or a value global, and at top level.
var AG3 = D3 { 0, 0, 0 };
var AZ3: i8 = 99;
var AX3 = D3 { 5, 8, 9 };
var AG8 = D8 { 0, 0 };
var AZ8: i8 = 99;
var AX8 = D8 { 5, 8 };
var AGH = DH { 0, 0 };
var AZH: i8 = 99;
var AXH = DH { 5, 8 };
var AGT = DT { 0, 0, 0 };
var AZT: i8 = 99;
var AXT = DT { 5, 8, 9 };
fn a3_d(): i64 { var x = D3 { 5, 8, 9 }; var d: D3 = *(&x); var e: D3 = *&x; x.a = 1; return (d.a * 100 + d.b * 10 + d.c) * 1000 + e.a * 100 + e.b * 10 + e.c; }
fn a3_l(): i64 { var x = D3 { 5, 8, 9 }; var l = D3 { 0, 0, 0 }; l = *(&x); var m = D3 { 0, 0, 0 }; m = (*&x); x.a = 1; return (l.a * 100 + l.b * 10 + l.c) * 1000 + m.a * 100 + m.b * 10 + m.c; }
fn a3_g(): i64 { var x = D3 { 5, 8, 9 }; AG3 = *(&x); x.a = 1; return AG3.a * 100 + AG3.b * 10 + AG3.c + (AZ3 - 99) * 10000; }
fn a3_o(): i64 { var x = D3 { 5, 8, 9 }; var o = O3 { 0, 0, 0, 99 }; o.s = *(&x); x.a = 1; return o.s.a * 100 + o.s.b * 10 + o.s.c + (o.g - 99) * 10000; }
fn a3_q(): i64 { var x = D3 { 5, 8, 9 }; var t = D3 { 0, 0, 0 }; var q: *D3 = &t; q = *(&x); x.a = 1; return t.a * 100 + t.b * 10 + t.c + (q != &t) * 10000; }
fn a3_s(): i64 { var v = D3 { 5, 8, 9 }; var z = D3 { 0, 0, 0 }; AG3 = z; *(&AG3) = v; var l = D3 { 0, 0, 0 }; *&l = v; v.a = 1; return (AG3.a * 100 + AG3.b * 10 + AG3.c + (AZ3 - 99) * 10000) * 1000 + l.a * 100 + l.b * 10 + l.c; }
fn a3_rf(): D3 { var x = D3 { 5, 8, 9 }; return *(&x); }
