assert_eq(TBD8.a * 10 + TBD8.b, 58, "8 B: top level, var G: S = (*&X) after the first statement");
assert_eq(TBG8, 58, "8 B: top level, G = *(&X) (the guard global kept)");
assert_eq(TADH.a * 10 + TADH.b, 58, "16 B: top level, var G: S = *(&X) in the declaration zone");
assert_eq(TBDH.a * 10 + TBDH.b, 58, "16 B: top level, var G: S = (*&X) after the first statement");
assert_eq(TBGH, 58, "16 B: top level, G = *(&X) (the guard global kept)");
assert_eq(TADT.a * 100 + TADT.b * 10 + TADT.c, 589, "24 B: top level, var G: S = *(&X) in the declaration zone");
assert_eq(TBDT.a * 100 + TBDT.b * 10 + TBDT.c, 589, "24 B: top level, var G: S = (*&X) after the first statement");
assert_eq(TBGT, 589, "24 B: top level, G = *(&X) (the guard global kept)");
assert_eq(aT_ro(), 700, "24 B: return *&x + y dispatches DT_add, received");
assert_eq(aT_hl(), 5, "guard: var w: DT = *(&h), h a handle local: bound to its object, not a copy of the slot");
assert_eq(aT_hc(), 5, "guard: ... h a captured handle");
assert_eq(aT_hg(), 5, "guard: ... h a handle global");
assert_eq(aT_hq(), 5, "guard: var w: DT = *(&q), q a *DT parameter (its &q is the slot)");
var r = assert_summary();
