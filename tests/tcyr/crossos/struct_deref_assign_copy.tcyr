fn aT_x(): i64 { var d: DT = *(&AXT); var l = DT { 0, 0, 0 }; l = *(&AXT); return (d.a * 100 + d.b * 10 + d.c) * 1000 + l.a * 100 + l.b * 10 + l.c; }
# `return *&x + y` from a struct fn dispatches its operator (`_ret_lopd`), as `return *(&x) + y` does
fn DT_add(a: *DT, b: *DT): DT { var r = DT { a.a + b.a, a.b + b.b, a.c + b.c }; return r; }
fn aT_rof(): DT { var x = DT { 5, 8, 9 }; var y = DT { 1, 1, 1 }; return *&x + y; }
fn aT_ro(): i64 { var r: DT = aT_rof(); return r.a * 100 + r.b * 10 + r.c; }
# the guards: a handle's `&h` (a local, a closure capture, a global) and a `*S` parameter's `&q` are their SLOT
# (the guide's handle line), so `*(&h)` is the untyped word the slot holds — the declaration from it is a
# handle bound to the same object (x 5 through it), never a copy of the slot's bytes
var AHT: DT = &AXT;
fn axT(): *DT { return &AXT; }
fn aT_hl(): i64 { var h: DT = axT(); var w: DT = *(&h); return w.a; }
fn aT_hc(): i64 { var h: DT = axT(); var c = || { var w: DT = *(&h); return w.a; }; return callptr(c); }
fn aT_hg(): i64 { var w: DT = *(&AHT); return w.a; }
fn aT_qf(q: *DT): i64 { var w: DT = *(&q); return w.a; }
fn aT_hq(): i64 { return aT_qf(axT()); }
# ── top level: a value global, a field of one, a handle global (after the first statement) ──
var TX3 = D3 { 5, 8, 9 };
var TP3: *D3 = &TX3;
var TG3 = D3 { 0, 0, 0 };
var TZ3: i8 = 99;
var TO3 = O3 { 0, 0, 0, 99 };
var TT3 = D3 { 0, 0, 0 };
var TH3: D3 = &TT3;
var TX8 = D8 { 5, 8 };
var TP8: *D8 = &TX8;
