fn aT_pf(q: DT): i64 { var d: DT = *(&q); var l = DT { 0, 0, 0 }; l = *&q; return (d.a * 100 + d.b * 10 + d.c) * 1000 + l.a * 100 + l.b * 10 + l.c; }
