# struct_deref_assign_copy.tcyr — 6.7.11. AN ASSIGNMENT FROM A STRUCT DEREFERENCE COPIES THE STRUCT
# (issues/archived/2026-10-13-assignment-from-struct-dereference-copies-one-word.md; 6.7.10 decision 6: `*p` is a struct
# value at every size, and the declaration `var d: S = *p;` copies it).
#
# ⛔ THROUGH 6.7.10 the assignment forms parsed `*p` as an expression and stored its FIRST WORD: `l = *p`,
# `G = *p` and `o.s = *p` left the rest of the struct stale (50 where 58 is right, {5, 0, 0} at 24 B), and
# `q = *p` with `q: *S` REBOUND q to that word (its pointee untouched; the next `q.a` read through it), with
# a false "assigning non-pointer to typed pointer" warning on `l = *p` / `q = *p`. Every target.
#
# THE RULE, each row at 3, 8, 16 and 24 B (the source {5, 8, 9}, written after the copy to tell a copy from
# an alias): a dereference of a `*S` — `*p`, `(*p)`, `*(p + 0)`, `*gp()`, `*w.p` — assigned to a struct
# value (an inline local, a value global, a by-value parameter, a struct-typed field, through a `*O` too)
# copies STRUCTSZ bytes, a guard byte after the object kept; to a `*S` local or parameter, or to a handle,
# it copies into the POINTEE, as `q = l` does; in a classic-for step too; at top level (a value global, a
# field of one, a handle global). The declaration and `q = l` are the controls. A `*U` of another struct is
# refused by name and `l = *p` / `q = *p` compile without a warning (the gate's rows,
# tests/gates/frontend/struct_copy_source_type_refused.sh).
#
# CROSS-HOST: the release gate's cross-OS leg runs it on ecb / ach / cass / pi; tests/gates/codegen/
# small_struct_handle_line.sh R11 on x86_64 (plain, CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu),
# cx (cxvm) and PE (wine).
include "lib/assert.cyr"

# ── 3 B ──
struct D3 { a: i8; b: i8; c: i8; }
struct O3 { s: D3; g: i8; }
struct W3 { k; p: *D3; }
var GD3 = D3 { 0, 0, 0 };
var ZD3: i8 = 99;
var GP3: *D3 = 0;
fn gp3(): *D3 { return GP3; }
fn s3_l(): i64 { var x = D3 { 5, 8, 9 }; var p: *D3 = &x; var l = D3 { 0, 0, 0 }; l = *p; x.a = 1; return l.a * 100 + l.b * 10 + l.c; }
fn s3_g(): i64 { var x = D3 { 5, 8, 9 }; var p: *D3 = &x; GD3 = *p; x.a = 1; return GD3.a * 100 + GD3.b * 10 + GD3.c + (ZD3 - 99) * 1000; }
