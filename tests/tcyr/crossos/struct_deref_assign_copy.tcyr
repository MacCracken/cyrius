var TPT: *DT = &TXT;
var TGT = DT { 0, 0, 0 };
var TZT: i8 = 99;
var TOT = OT { 0, 0, 0, 99 };
var TTT = DT { 0, 0, 0 };
var THT: DT = &TTT;
var TAD3: D3 = *(&AX3);
var TAD8: D8 = *(&AX8);
var TADH: DH = *(&AXH);
var TADT: DT = *(&AXT);
var e = 0;
TG3 = *TP3;
var R3a = TG3.a * 100 + TG3.b * 10 + TG3.c + (TZ3 - 99) * 1000;
TG3.a = 0; TG3.b = 0; TG3.c = 0;
TG8 = *TP8;
var R8a = TG8.a * 10 + TG8.b + (TZ8 - 99) * 1000;
TG8.a = 0; TG8.b = 0;
TGH = *TPH;
var RHa = TGH.a * 10 + TGH.b + (TZH - 99) * 1000;
TGH.a = 0; TGH.b = 0;
TGT = *TPT;
var RTa = TGT.a * 100 + TGT.b * 10 + TGT.c + (TZT - 99) * 1000;
TGT.a = 0; TGT.b = 0; TGT.c = 0;
TG3 = (*TP3);
var R3b = TG3.a * 100 + TG3.b * 10 + TG3.c;
GP3 = TP3;
TO3.s = *gp3();
var R3c = TO3.s.a * 100 + TO3.s.b * 10 + TO3.s.c + (TO3.g - 99) * 1000;
TH3 = *TP3;
var R3d = TT3.a * 100 + TT3.b * 10 + TT3.c;
TG8 = (*TP8);
