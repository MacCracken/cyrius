fn s3_bv(l: D3, p: *D3): i64 { l = *p; return l.a * 100 + l.b * 10 + l.c; }
fn s3_byv(): i64 { var x = D3 { 5, 8, 9 }; var z = D3 { 0, 0, 0 }; var r = s3_bv(z, &x); return r + (z.a * 100 + z.b * 10 + z.c) * 1000; }

