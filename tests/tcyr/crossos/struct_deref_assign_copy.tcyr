fn aT_o(): i64 { var x = DT { 5, 8, 9 }; var o = OT { 0, 0, 0, 99 }; o.s = *(&x); x.a = 1; return o.s.a * 100 + o.s.b * 10 + o.s.c + (o.g - 99) * 10000; }
fn aT_q(): i64 { var x = DT { 5, 8, 9 }; var t = DT { 0, 0, 0 }; var q: *DT = &t; q = *(&x); x.a = 1; return t.a * 100 + t.b * 10 + t.c + (q != &t) * 10000; }
fn aT_s(): i64 { var v = DT { 5, 8, 9 }; var z = DT { 0, 0, 0 }; AGT = z; *(&AGT) = v; var l = DT { 0, 0, 0 }; *&l = v; v.a = 1; return (AGT.a * 100 + AGT.b * 10 + AGT.c + (AZT - 99) * 10000) * 1000 + l.a * 100 + l.b * 10 + l.c; }
