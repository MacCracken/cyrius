fn s3_call(): i64 { var x = D3 { 5, 8, 9 }; GP3 = &x; var l = D3 { 0, 0, 0 }; l = *gp3(); x.a = 1; return l.a * 100 + l.b * 10 + l.c; }
fn s3_fld(): i64 { var x = D3 { 5, 8, 9 }; var w = W3 { 0, &x }; var l = D3 { 0, 0, 0 }; l = *w.p; x.a = 1; return l.a * 100 + l.b * 10 + l.c; }
fn s3_po(): i64 {
    var x = D3 { 5, 8, 9 };
    var p: *D3 = &x;
    var o: O3;
    o.s.a = 0; o.s.b = 0; o.s.c = 0;
    o.g = 99;
    var po: *O3 = &o;
    po.s = *p;
    x.a = 1;
