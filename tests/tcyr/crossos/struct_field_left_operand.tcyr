    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = w.s / a + a;
    return q.v + (q.w - 5) * 1000;
}
fn f_pw_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var pw: *W8 = &w; var q: S8 = pw.s + a; return q.v; }
fn f_pw_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var pw: *WH = &w;
    var q: H = pw.s + a;
    return q.v + (q.w - 3) * 1000;
}
fn f_pwmul_8() {
    var w: W8 = W8 { 1, 70, 9 };
    var a: S8 = S8 { 4 };
    var pw: *W8 = &w;
    var r = pw.s * a;
    return r * 1000 + w.s.v;
}
fn f_pwmul_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var pw: *WH = &w;
    var r = pw.s * a;
    return r * 1000 + w.s.v;
}
fn f_deref_8() { var x: S8 = S8 { 70 }; var a: S8 = S8 { 4 }; var ps: *S8 = &x; var q: S8 = *ps + a; return q.v; }
fn f_deref_h() {
    var x: H = H { 70, 1 };
    var a: H = H { 4, 2 };
    var ps: *H = &x;
    var q: H = *ps + a;
    return q.v + (q.w - 3) * 1000;
}
fn f_dparen_8() {
    var x: S8 = S8 { 70 };
    var a: S8 = S8 { 4 };
    var ps: *S8 = &x;
    var q: S8 = (*ps) + a;
    return q.v * 1000 + (((*ps)) - a);
}
fn f_dparen_h() {
    var x: H = H { 70, 1 };
    var a: H = H { 4, 2 };
    var ps: *H = &x;
    var q: H = (*ps) + a;
    return (q.v + (q.w - 3) * 1000) * 1000 + (((*ps)) - a);
}
fn f_dmul_8() { var x: S8 = S8 { 70 }; var a: S8 = S8 { 4 }; var ps: *S8 = &x; var r = *ps * a; return r * 1000 + x.v; }
fn f_dmul_h() {
    var x: H = H { 70, 1 };
    var a: H = H { 4, 2 };
    var ps: *H = &x;
    var r = *ps * a;
    return r * 1000 + x.v;
}
fn f_call_8() { var a: S8 = S8 { 4 }; var q: S8 = mkw8(70).s + a; return q.v; }
fn f_call_h() { var a: H = H { 4, 2 }; var q: H = mkwh(70).s + a; return q.v + (q.w - 3) * 1000; }
var GW8 = W8 { 1, 70, 9 };
var GWH = WH { 1, 70, 1, 9 };
fn f_glob_8() { var a: S8 = S8 { 4 }; var q: S8 = GW8.s + a; return q.v * 1000 + (GW8.s - a); }
fn f_glob_h() {
    var a: H = H { 4, 2 };
    var q: H = GWH.s + a;
    return (q.v + (q.w - 3) * 1000) * 1000 + (GWH.s - a);
}
fn f_paren_8() {
    var w: W8 = W8 { 1, 70, 9 };
    var a: S8 = S8 { 4 };
    var q: S8 = (w.s) + a;
    return q.v * 1000 + (((w.s)) - a);
}
fn f_paren_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = (w.s) + a;
    return (q.v + (q.w - 3) * 1000) * 1000 + (((w.s)) - a);
}
fn f_self_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; return w.opv(a); }
fn f_self_h() { var w: WH = WH { 1, 70, 1, 9 }; var a: H = H { 4, 2 }; return w.opv(a); }
fn pv8(h: W8, a: S8): i64 { var q: S8 = h.s + a; return q.v; }
fn pp8(h: *W8, a: S8): i64 { var q: S8 = h.s + a; return q.v; }
fn pvh(h: WH, a: H): i64 { var q: H = h.s + a; return q.v + (q.w - 3) * 1000; }
fn pph(h: *WH, a: H): i64 { var q: H = h.s + a; return q.v + (q.w - 3) * 1000; }
fn f_parm_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; return pv8(w, a) * 1000 + pp8(&w, a); }
fn f_parm_h() { var w: WH = WH { 1, 70, 1, 9 }; var a: H = H { 4, 2 }; return pvh(w, a) * 1000 + pph(&w, a); }
fn f_nest_8() { var o: O8 = O8 { 5, 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = o.w.s + a; return q.v; }
fn f_nest_h() {
    var o: OH = OH { 5, 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = o.w.s + a;
    return q.v + (q.w - 3) * 1000;
}
fn f_clos_8() {
    var w: W8 = W8 { 1, 70, 9 };
    var a: S8 = S8 { 4 };
    var f = |d| { var q: S8 = w.s + a; return q.v + d; };
    return callptr(f, 0);
}
fn f_clos_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var f = |d| { var q: H = w.s + a; return q.v + (q.w - 3) * 1000 + d; };
    return callptr(f, 0);
}
fn f_untyped_8() {
    var w = mkw8(70);
    var v = W8 { 1, 70, 9 };
    var a: S8 = S8 { 4 };
    var q: S8 = w.s + a;
    var q2: S8 = v.s + a;
    return q.v * 1000 + q2.v;
}
fn f_untyped_h() {
    var w = mkwh(70);
    var v = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = w.s + a;
    var q2: H = v.s + a;
    return (q.v + (q.w - 3) * 1000) * 1000 + q2.v + (q2.w - 3) * 1000;
}
fn f_dcall_8() { var a: S8 = S8 { 4 }; var q: S8 = *gp8() + a; return q.v; }
fn f_dcall_h() { var a: H = H { 4, 2 }; var q: H = *gph() + a; return q.v + (q.w - 3) * 1000; }
fn f_dfld_8() { var x: S8 = S8 { 70 }; var a: S8 = S8 { 4 }; var pw = PW8 { &x }; var q: S8 = *pw.ps + a; return q.v; }
fn f_dfld_h() {
    var x: H = H { 70, 1 };
    var a: H = H { 4, 2 };
    var pw = PWH { &x };
    var q: H = *pw.ps + a;
    return q.v + (q.w - 3) * 1000;
}
fn dq8(q: *S8, a: S8): i64 { var r: S8 = *q + a; return r.v; }
fn dqh(q: *H, a: H): i64 { var r: H = *q + a; return r.v + (r.w - 3) * 1000; }
fn f_dparm_8() { var x: S8 = S8 { 70 }; var a: S8 = S8 { 4 }; return dq8(&x, a); }
fn f_dparm_h() { var x: H = H { 70, 1 }; var a: H = H { 4, 2 }; return dqh(&x, a); }
fn f_arg_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; return take8(w.s + a); }
fn f_arg_h() { var w: WH = WH { 1, 70, 1, 9 }; var a: H = H { 4, 2 }; return takeh(w.s + a); }
fn f_ret_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = rt8(&w, a); return q.v; }
fn f_ret_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = rth(&w, a);
    return q.v + (q.w - 3) * 1000;
}
fn f_dret_8() { var x: S8 = S8 { 70 }; var a: S8 = S8 { 4 }; var q: S8 = rd8(&x, a); return q.v; }
fn f_dret_h() { var x: H = H { 70, 1 }; var a: H = H { 4, 2 }; var q: H = rdh(&x, a); return q.v + (q.w - 3) * 1000; }
fn f_rhs_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = a + w.s; return q.v; }
fn f_rhs_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = a + w.s;
    return q.v + (q.w - 3) * 1000;
}
fn f_both_8() { var w: W8 = W8 { 1, 70, 9 }; var q: S8 = w.s + w.s; return q.v; }
fn f_both_h() { var w: WH = WH { 1, 70, 1, 9 }; var q: H = w.s + w.s; return q.v + (q.w - 2) * 1000; }

# ── 24 B (a retptr result, `*T3` parameters for `-`) ──
fn f_t3_add() {
    var w: W3 = W3 { 1, 70, 1, 2, 9 };
    var c: T3 = T3 { 4, 2, 3 };
    var q: T3 = w.s + c;
    return q.x + (q.y - 3) * 1000 + (q.z - 5) * 100000 + (w.g - 9);
}
fn f_t3_sub() { var w: W3 = W3 { 1, 70, 1, 2, 9 }; var c: T3 = T3 { 4, 2, 3 }; return w.s - c; }
fn f_t3_deref() {
    var x: T3 = T3 { 70, 1, 2 };
    var c: T3 = T3 { 4, 2, 3 };
    var p: *T3 = &x;
    var q: T3 = *p + c;
    return q.x + (q.y - 3) * 1000 + (q.z - 5) * 100000;
}
fn f_t3_ret() {
    var w: W3 = W3 { 1, 70, 1, 2, 9 };
    var c: T3 = T3 { 4, 2, 3 };
    var q: T3 = rt3(&w, c);
    return q.x + (q.z - 5) * 1000;
}

# ── sizes 1..8 B: s = (7, 5, 3), a = (2, 1, 1); `+` = (23, 6, 4) by value, `-` = 33 through `*S` ──
struct S1 { a: u8; }
struct S2 { a: u16; }
struct S3 { a: u8; b: u16; }
struct S4 { a: u32; }
struct S5 { a: u32; b: u8; }
struct S6 { a: u32; b: u16; }
struct S7 { a: u32; b: u16; c: u8; }
struct Z8 { a: u32; b: u16; c: u8; d: u8; }
struct V1 { s: S1; g: i8; }
struct V2 { s: S2; g: i8; }
struct V3 { s: S3; g: i8; }
struct V4 { s: S4; g: i8; }
struct V5 { s: S5; g: i8; }
struct V6 { s: S6; g: i8; }
struct V7 { s: S7; g: i8; }
struct V8 { s: Z8; g: i8; }
fn S1_add(l: S1, r: S1): S1 { var t: S1; t.a = l.a * 3 + r.a; return t; }
fn S2_add(l: S2, r: S2): S2 { var t: S2; t.a = l.a * 3 + r.a; return t; }
fn S3_add(l: S3, r: S3): S3 { var t: S3; t.a = l.a * 3 + r.a; t.b = l.b + r.b; return t; }
fn S4_add(l: S4, r: S4): S4 { var t: S4; t.a = l.a * 3 + r.a; return t; }
fn S5_add(l: S5, r: S5): S5 { var t: S5; t.a = l.a * 3 + r.a; t.b = l.b + r.b; return t; }
fn S6_add(l: S6, r: S6): S6 { var t: S6; t.a = l.a * 3 + r.a; t.b = l.b + r.b; return t; }
fn S7_add(l: S7, r: S7): S7 { var t: S7; t.a = l.a * 3 + r.a; t.b = l.b + r.b; t.c = l.c + r.c; return t; }
fn Z8_add(l: Z8, r: Z8): Z8 {
    var t: Z8;
    t.a = l.a * 3 + r.a;
    t.b = l.b + r.b;
    t.c = l.c + r.c;
    t.d = l.d + r.d;
    return t;
}
fn S1_sub(l: *S1, r: *S1): i64 { return l.a * 5 - r.a; }
fn S2_sub(l: *S2, r: *S2): i64 { return l.a * 5 - r.a; }
fn S3_sub(l: *S3, r: *S3): i64 { return l.a * 5 - r.a; }
fn S4_sub(l: *S4, r: *S4): i64 { return l.a * 5 - r.a; }
fn S5_sub(l: *S5, r: *S5): i64 { return l.a * 5 - r.a; }
fn S6_sub(l: *S6, r: *S6): i64 { return l.a * 5 - r.a; }
fn S7_sub(l: *S7, r: *S7): i64 { return l.a * 5 - r.a; }
fn Z8_sub(l: *Z8, r: *Z8): i64 { return l.a * 5 - r.a; }
# Each returns 6: `w.s + a`, `w.s - a`, `*p + a` and the guard byte (9) after the field.
fn z1() {
    var w: V1; w.s.a = 7; w.g = 9;
    var a: S1; a.a = 2;
    var x: S1; x.a = 7;
    var p: *S1 = &x;
    var q: S1 = w.s + a;
    var r = w.s - a;
    var d: S1 = *p + a;
    var k = 0;
    if (q.a == 23) { k = k + 1; }
    if (r == 33) { k = k + 1; }
    if (d.a == 23) { k = k + 1; }
    if (w.g == 9) { k = k + 1; }
    if (w.s.a == 7) { k = k + 2; }
    return k;
}
fn z2() {
    var w: V2; w.s.a = 7; w.g = 9;
    var a: S2; a.a = 2;
    var x: S2; x.a = 7;
