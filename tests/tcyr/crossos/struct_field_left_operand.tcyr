# ── top level: a field and a dereference of globals, in the declaration zone and after it ──
var GA8 = S8 { 4 };
var GAH = H { 4, 2 };
var GZW8 = W8 { 1, 70, 9 };
var GZWH = WH { 1, 70, 1, 9 };
var GZP8: *S8 = &GX8;
var TQ8: S8 = GZW8.s + GA8;           # the zone: a struct value (the operator's), copied
var TD8: S8 = *GZP8 + GA8;
var TS8 = GZW8.s - GA8;
var TSH = GZWH.s - GAH;              # a 16 B field by address at top level: no frame needed
alloc_init();
var TQ8b: S8 = GZW8.s + GA8;          # after the first statement
var TD8b: S8 = (*GZP8) + GA8;
var TM8 = GZW8.s * GA8;               # `*S` parameters: the field's own address — it becomes 71

assert_eq(f_loc_8(), 214, "var q: S8 = w.s + a (an inline local's field): S8_add, a struct value");
assert_eq(f_loc_8(), f_loc_h(), "  = its 16 B twin");
assert_eq(f_asg_8(), 214, "q = w.s + a into a value");
assert_eq(f_asg_8(), f_asg_h(), "  = its 16 B twin");
assert_eq(f_hdl_8(), 214, "q = w.s + a into a handle: copied into the object");
assert_eq(f_hdl_8(), f_hdl_h(), "  = its 16 B twin");
assert_eq(f_ptr_8(), 214, "p = w.s + a into a *S: copied into the pointee");
