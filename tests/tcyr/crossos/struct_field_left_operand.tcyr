# struct_field_left_operand.tcyr — 6.7.10. A STRUCT-TYPED FIELD OR A `*T` DEREFERENCE AS AN
# OPERATOR'S LEFT OPERAND DISPATCHES (the user's decision 11, 2026-10-12): `w.s + a`, `p.s + a`
# through a `*T`, `*p + a`, `(*p) + a`, `f().s + a` call `S_add` (and `S_sub` / `S_mul` / `S_div`)
# exactly as a struct variable does, at every size, and the result is a struct value.
#
# ⛔ THROUGH 6.7.9 (and 6.7.10 before this fix) only a struct VARIABLE or a struct result typed an
# operator's left operand: a field or a dereference loaded its first word and the integer arm combined
# it with the right operand's — no operator fn was called, at every size, silently
# (issues/2026-10-08-struct-field-left-operand-never-dispatches.md: `h.p - s` gave 250, 3 - 9, where
# `P2_sub` gives 139). Under the handle line (B7-1) `var q: S8 = w.s + a;` was then a handle holding
# that integer, and `q.v` SIGSEGV'd.
#
# THE RULE, every `_8` row against its `_h` twin over 8 B (both give the row's constant; the 24 B
# rows take the retptr class): the left operand is a struct-typed field — of an inline local, an
# untyped one, a by-value or `*W` parameter, `self`, a global, a `*W` local, a call result, a nested
# field, a closure capture, wrapped in parentheses — or a dereference of a `*S` — a local, a
# parameter, a `: *S` call, a `*S` field, wrapped. It passes what a struct variable passes: its
# ADDRESS into a `*S` parameter or over 8 B (a write through it reaches the field — the `_mul` rows),
# else its value. The result is a struct value: a declaration copies it, an assignment copies it into
# a value, a handle or a `*S`'s pointee, an argument takes it, `return` returns it, and it chains
# (`w.s + a + a`, `w.s / a + a`). The right-operand control (`a + w.s`) dispatched before.
# The SIZE rows (1..8 B: u8 / u16 / u32 compositions — a SIGNED narrow field read through a `*S` is the
# open CYRIUS_IR=3 defect, issues/2026-10-08-ir3-drops-unrecorded-field-emits.md) run `w.s + a` (by
# value), `w.s - a` (through `*S` parameters) and `*p + a` on each size, a guard byte after the field kept.
# Refusals (a missing operator fn, a parameter of another struct, a 9-16 B result at top level) and the
# declaration zone's agreement: tests/gates/codegen/small_struct_handle_line.sh (rows F, GC8).
#
# CROSS-HOST: tests/gates/codegen/small_struct_handle_line.sh R6 runs this file on x86_64 (plain,
# CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm) and PE (wine); the release
# gate's cross-OS leg on ecb / ach / cass / pi.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"

struct S8 { v; }                      # 8 B
struct H { v; w; }                    # 16 B — the twin (rax:rdx)
struct T3 { x; y; z; }                # 24 B (a retptr result)
struct W8 { n; s: S8; g; }
struct WH { n; s: H; g; }
struct W3 { n; s: T3; g; }
struct O8 { k; w: W8; }
struct OH { k; w: WH; }
struct PW8 { ps: *S8; }
struct PWH { ps: *H; }

fn S8_add(a: S8, b: S8): S8 { var r: S8; r.v = a.v * 3 + b.v; return r; }
fn H_add(a: H, b: H): H { var r: H; r.v = a.v * 3 + b.v; r.w = a.w + b.w; return r; }
fn T3_add(a: T3, b: T3): T3 { var r: T3; r.x = a.x * 3 + b.x; r.y = a.y + b.y; r.z = a.z + b.z; return r; }
fn S8_sub(a: S8, b: S8): i64 { return a.v * 5 - b.v; }
fn H_sub(a: H, b: H): i64 { return a.v * 5 - b.v; }
fn T3_sub(a: *T3, b: *T3): i64 { return a.x * 5 - b.x; }
fn S8_mul(a: *S8, b: *S8): i64 { a.v = a.v + 1; return a.v * 7 + b.v; }
fn H_mul(a: *H, b: *H): i64 { a.v = a.v + 1; return a.v * 7 + b.v; }
fn S8_div(a: S8, b: S8): S8 { var r: S8; r.v = a.v / b.v + 100; return r; }
fn H_div(a: H, b: H): H { var r: H; r.v = a.v / b.v + 100; r.w = a.w + b.w; return r; }

fn mkw8(n): W8 { var w: W8 = W8 { 1, n, 9 }; return w; }
fn mkwh(n): WH { var w: WH = WH { 1, n, 1, 9 }; return w; }
var GX8 = S8 { 70 };
var GXH = H { 70, 1 };
fn gp8(): *S8 { return &GX8; }
fn gph(): *H { return &GXH; }
fn take8(s: S8): i64 { return s.v; }
fn takeh(s: H): i64 { return s.v + (s.w - 3) * 1000; }
fn rt8(w: *W8, a: S8): S8 { return w.s + a; }
fn rth(w: *WH, a: H): H { return w.s + a; }
fn rt3(w: *W3, a: T3): T3 { return w.s + a; }
fn rd8(p: *S8, a: S8): S8 { return *p + a; }
fn rdh(p: *H, a: H): H { return *p + a; }
impl W8 { fn opv(self: W8, a: S8): i64 { var q: S8 = self.s + a; return q.v; } }
impl WH { fn opv(self: *WH, a: H): i64 { var q: H = self.s + a; return q.v + (q.w - 3) * 1000; } }

# ── the shapes: s = 70 (H: 70, 1), a = 4 (H: 4, 2); `+` gives 214 (H: w 3), `-` 346, `*` 501 (and
# writes 71 into the field it was given), `/` 117 ──
fn f_loc_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = w.s + a; return q.v + (w.g - 9); }
fn f_loc_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = w.s + a;
    return q.v + (q.w - 3) * 1000 + (w.g - 9);
}
fn f_asg_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = S8 { 0 }; q = w.s + a; return q.v; }
fn f_asg_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = H { 0, 0 };
    q = w.s + a;
    return q.v + (q.w - 3) * 1000;
}
fn f_hdl_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = alloc(8); q = w.s + a; return q.v; }
