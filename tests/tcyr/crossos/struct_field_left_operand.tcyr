    var w: W8 = W8 { 1, 70, 9 };
    var a: S8 = S8 { 4 };
    var y: S8 = S8 { 0 };
    var p: *S8 = &y;
    p = w.s + a;
    return y.v;
}
fn f_ptr_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var y: H = H { 0, 0 };
    var p: *H = &y;
    p = w.s + a;
    return y.v + (y.w - 3) * 1000;
}
fn f_sub_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; return w.s - a; }
fn f_sub_h() { var w: WH = WH { 1, 70, 1, 9 }; var a: H = H { 4, 2 }; return w.s - a; }
fn f_mul_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var r = w.s * a; return r * 1000 + w.s.v; }
fn f_mul_h() { var w: WH = WH { 1, 70, 1, 9 }; var a: H = H { 4, 2 }; var r = w.s * a; return r * 1000 + w.s.v; }
fn f_div_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = w.s / a; return q.v; }
fn f_div_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = w.s / a;
    return q.v + (q.w - 3) * 1000;
}
fn f_chain_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = w.s + a + a; return q.v; }
fn f_chain_h() {
    var w: WH = WH { 1, 70, 1, 9 };
    var a: H = H { 4, 2 };
    var q: H = w.s + a + a;
    return q.v + (q.w - 5) * 1000;
}
fn f_divadd_8() { var w: W8 = W8 { 1, 70, 9 }; var a: S8 = S8 { 4 }; var q: S8 = w.s / a + a; return q.v; }
