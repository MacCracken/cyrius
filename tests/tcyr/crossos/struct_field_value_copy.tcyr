# struct_field_value_copy.tcyr — 6.6.10 — a struct VALUE assigned into a struct-typed FIELD
# copies the whole struct, on every backend.
#
# `b.v = p;` (with `struct Box { v: Pt; n; }`) parsed `p` as an ordinary value — a struct's
# value is its FIRST word — and stored one word: `b.v.y` kept whatever it held. From an
# address-passed struct PARAMETER the one word was the POINTER, so `b.v.x` read a stack address.
# The v6.6.6 struct-copy arc covered a local, a parameter and a global as the DESTINATION, never
# a field. Each row below read the stale / pointer word on 6.6.9.
#
# Mutation that reddens this file: make `_fsc_src` (src/frontend/parse_decl.cyr) return 0.
#
# The "odd-width" rows (6.6.10, bite 5 review): a <= 8 B struct result — a method, an overloaded
# operator, a free call at top level — and a plain integer arrive in rax, and a 3/5/6/7-byte field
# took the width ladder's 8-byte ESTOC, overwriting the fields after it. Each row checks the
# neighbours. Mutation: make `_fst_odd_sz` return 0 — every odd-width row goes red.
#
# 6.6.11 rows — the reverse direction and its neighbours:
#   * `var y: Q = x;` from an address-passed by-value PARAMETER bound a second pointer to the
#     caller's struct: writes through `y` changed the caller, `return y;` returned garbage.
#     Mutation: restore `return 0` for a non-inline source in `_try_struct_copy_init`.
#   * a method whose `self: T` is a struct of 8 B or less was handed `&x` where the free call
#     passes x's value. Mutation: make `_fn_self_byval` (src/frontend/parse_fn.cyr) return 0.
#   * a struct VARIABLE copied FROM a struct-typed field (`q = b.v;` into a local, a global and an
#     address-passed parameter; `var p: Pt = b.v;`) copied one word, and the declaration SIGSEGV'd
#     reading `p.x` through that word. Mutation: make `_fla_arm` (src/frontend/parse_decl.cyr)
#     return before arming — the "from a struct-typed field" group goes red (x86: SIGSEGV).
#
# 6.6.12 rows — the positional LITERAL of a struct with a nested struct field:
#   * a nested field was flattened as 8 bytes per inner field, never at the inner fields' own
#     FIELDOFF/FIELDSZ, and never recursed: `HO { 0x11, 0x2222, 0x33, 0x44444444 }` (8 B) wrote
#     13 bytes past its object — over the next global, or the fn's frame — and read back wrong on
#     every backend; a struct nested TWO levels deep took the wrong number of values. The row
#     that stood at the odd-width group (`var GHO = HO { 0, 0, 0, 0 };`) passed only by layout.
#     The rows check every field, and a canary after the object where one can be placed: a
#     global in the leading declaration block (the canary is static data, in place before the
#     literal runs) and a fn-local (canaries on both sides). The global after the first
#     statement is checked field by field.
#     Mutation: make `_spi_nested` (src/frontend/parse_decl.cyr) flatten 8 bytes per inner field
#     instead of recursing — the HO rows go red and the two-level literals stop compiling.
#   * a nested struct field takes a whole struct VALUE (`Box { p, 5 }`): a local, a parameter, a
#     global, a struct-typed field, a call (>16 B retptr, 9-16 B rax:rdx, <= 8 B rax), a method, an
#     operator; a value of a type on the field's first-field chain fills that inner struct.
#     Before 6.6.12 each of these was a compile error ("unexpected '}'").
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

struct Pt { x; y; }
struct Box { v: Pt; n; }
struct Big { a; b; c; }
struct BB { k; w: Big; }
struct Outer { t; b: Box; }
struct Odd { a: i8; b: i16; }
struct HasOdd { o: Odd; tail: i8; }
struct HO { o: Odd; t: i8; u: i32; }
struct HH { h: HO; z: i8; }
struct S5 { a: i32; b: i8; }
struct S6 { a: i16; b: i16; c: i16; }
struct S7 { a: i32; b: i16; c: i8; }
struct H5 { s: S5; t: i8; u: i16; }
struct H6 { s: S6; t: i16; }
struct H7 { s: S7; t: i8; }
union UB { v: Pt; raw: i64; }

var GB = Box { 0, 0, 0 };
var GP = Pt { 50, 60 };
# 6.6.12: literals in the leading declaration block (replayed by EMIT_GVAR_INITS), each followed
# by constant canaries — static data, in place before the literal's stores run.
var GHOD = HO { 0x11, 0x2222, 0x33, 0x44444444 };
var GHOD_C1 = 0x5A5A5A5A5A5A5A5A;
var GHOD_C2 = 0x5A5A5A5A5A5A5A5A;
var GOUD = Outer { 1, 2, 3, 4 };
var GOUD_C = 0x5A5A5A5A5A5A5A5A;
var GHHD = HH { 1, 2, 3, 4, 5 };
var GHHD_C = 0x5A5A5A5A5A5A5A5A;
var GBOXD = Box { GP, 7 };

fn mkpt(a): Pt { var p: Pt; p.x = a; p.y = a + 1; return p; }
fn mkbig(a): Big { var p: Big; p.a = a; p.b = a + 1; p.c = a + 2; return p; }
fn mkodd(a): Odd { var o: Odd; o.a = a; o.b = a * 100; return o; }
impl Mk for Odd { fn twice(self): Odd { var r: Odd; r.a = load8(self) * 2; r.b = load16(self + 1) * 2; return r; } }
fn Odd_add(p: Odd, q: Odd): Odd { var r: Odd; r.a = p.a + q.a; r.b = p.b + q.b; return r; }
fn S6_add(p: S6, q: S6): S6 { var r: S6; r.a = p.a + q.a; r.b = p.b + q.b; r.c = p.c + q.c; return r; }
fn mks5(a): S5 { var r: S5; r.a = a; r.b = a + 1; return r; }
fn mks7(a): S7 { var r: S7; r.a = a; r.b = a + 1; r.c = a + 2; return r; }
impl Mk for Pt { fn twice(self): Pt { var r: Pt; r.x = load64(self) * 2; r.y = load64(self + 8) * 2; return r; } }
fn Big_add(a: Big, b: Big): Big { var r: Big; r.a = a.a + b.a; r.b = a.b + b.b; r.c = a.c + b.c; return r; }

fn pack(b: Box): i64 { return b.v.x * 10 + b.v.y + b.n * 100; }

fn from_param(x: Pt): i64 { var b: Box; b.n = 5; b.v.y = 99; b.v = x; return pack(b); }
fn from_local(): i64 { var p: Pt; p.x = 1; p.y = 2; var b: Box; b.n = 7; b.v.y = 99; b.v = p; return pack(b); }
fn from_heap(): i64 { var p: Pt = alloc(16); p.x = 4; p.y = 5; var b: Box; b.n = 1; b.v = p; p.y = 9; return pack(b); }
fn from_global(): i64 { var b: Box; b.n = 2; b.v = GP; return b.v.x + b.v.y + b.n; }
fn from_call(): i64 { var b: Box; b.n = 3; b.v.y = 99; b.v = mkpt(4); return pack(b); }
fn from_bigcall(): i64 { var b: BB; b.k = 9; b.w = mkbig(1); return b.w.a + b.w.b * 10 + b.w.c * 100 + b.k * 1000; }
fn from_method(): i64 { var p: Pt; p.x = 3; p.y = 4; var b: Box; b.n = 1; b.v.y = 99; b.v = p.twice(); return pack(b); }
fn from_operator(): i64 { var a: Big; a.a = 1; a.b = 2; a.c = 3; var c: Big; c.a = 10; c.b = 20; c.c = 30; var b: BB; b.k = 0; b.w = a + c; return b.w.a + b.w.b + b.w.c; }
fn from_field(): i64 { var a: Box; a.v.x = 6; a.v.y = 8; a.n = 1; var b: Box; b.n = 2; b.v = a.v; return pack(b); }
# Outer is { t @0; b: Box @8 = { v: Pt @8 = { x @8; y @16 }; n @24 } } — a chain reaches two levels.
fn from_chain(): i64 { var o: Outer; o.t = 0; store64(&o + 8, 1); store64(&o + 16, 3); var b: Box; b.n = 4; b.v = o.b.v; return pack(b); }
fn into_chain(): i64 { var p: Pt; p.x = 2; p.y = 7; var o: Outer; o.t = 5; o.b.n = 6; o.b.v = p; return load64(&o + 8) * 10 + load64(&o + 16) + o.b.n * 100 + o.t * 1000; }
fn into_global(): i64 { var p: Pt; p.x = 8; p.y = 9; GB.n = 1; GB.v = p; return pack(GB); }
fn into_union(): i64 { var p: Pt; p.x = 11; p.y = 12; var u: UB; u.v = p; return u.v.x + u.v.y; }
fn odd_sizes(): i64 {
    var o: Odd; o.a = 3; o.b = 700;
    var h: HasOdd; h.tail = 5; h.o = o;
    var r = h.o.a + h.o.b + h.tail * 10000;
    h.tail = 6; h.o = mkodd(2);
    return r * 1000000 + h.o.a + h.o.b + h.tail * 10000;
}
# Each returns the field's bytes plus the neighbours; a clobbered neighbour reads 0.
fn odd_method(): i64 { var x: Odd; x.a = 1; x.b = 2; var h: HO; h.t = 5; h.u = 9; h.o = x.twice(); return h.o.a + h.o.b * 10 + h.t * 100 + h.u * 1000; }
fn odd_operator(): i64 { var x: Odd; x.a = 1; x.b = 2; var h: HO; h.t = 5; h.u = 9; h.o = x + x; return h.o.a + h.o.b * 10 + h.t * 100 + h.u * 1000; }
fn s6_operator(): i64 { var x: S6; x.a = 1; x.b = 2; x.c = 3; var h: H6; h.t = 77; h.s = x + x; return h.s.a + h.s.b * 10 + h.s.c * 100 + h.t * 1000; }
fn s5_call(): i64 { var h: H5; h.t = 3; h.u = 4; h.s = mks5(6); return h.s.a + h.s.b * 10 + h.t * 100 + h.u * 1000; }
fn s7_call(): i64 { var h: H7; h.t = 8; h.s = mks7(1); return h.s.a + h.s.b * 10 + h.s.c * 100 + h.t * 1000; }
# 0x030201 into Odd: a = 1, b = 0x0302 = 770; the fourth byte (0) must not reach `t`.
fn odd_integer(): i64 { var h: HO; h.t = 5; h.u = 9; h.o = 0x030201; return h.o.a + h.o.b * 10 + h.t * 100 + h.u * 1000; }
fn keep_neighbours(): i64 { var b: Box; b.n = 42; var p: Pt; p.x = 1; p.y = 1; b.v = p; return b.n; }

# ── 6.6.11: copy-init from an address-passed struct parameter ──────────────────────────────────
struct Q { a; b; c; }
fn pc_mod16(x: Pt): i64 { var y: Pt = x; y.x = 9; return y.x; }
fn pc_mod24(x: Q): i64 { var y: Q = x; y.a = 9; return y.a; }
fn pc_id16(x: Pt): Pt { var y: Pt = x; return y; }
fn pc_id24(x: Q): Q { var y: Q = x; return y; }
fn pc_caller16(): i64 { var p: Pt; p.x = 1; p.y = 2; var m = pc_mod16(p); return p.x + p.y * 10 + m * 100; }
fn pc_caller24(): i64 { var q: Q; q.a = 1; q.b = 2; q.c = 3; var m = pc_mod24(q); return q.a + q.b * 10 + q.c * 100 + m * 1000; }
fn pc_ret16(): i64 { var p: Pt; p.x = 1; p.y = 2; var r: Pt = pc_id16(p); return r.x + r.y * 10; }
fn pc_ret24(): i64 { var q: Q; q.a = 1; q.b = 2; q.c = 3; var r: Q = pc_id24(q); return r.a + r.b * 10 + r.c * 100; }

# ── 6.6.11: a method's by-value `self` of 8 B or less ──────────────────────────────────────────
struct P8 { x: i32; y: i32; }
fn P8_sum(self: P8): i64 { return self.x + self.y * 10; }
fn Odd_sum(self: Odd): i64 { return self.a + self.b * 10; }
fn Odd_dbl(self: Odd): Odd { var r: Odd; r.a = self.a * 2; r.b = self.b * 2; return r; }
fn P8_twice(self: P8): P8 { var r: P8; r.x = self.x * 2; r.y = self.y * 2; return r; }
var GP8 = P8 { 3, 4 };
var GODD = Odd { 1, 2 };
fn sb_local(): i64 { var x: Odd; x.a = 1; x.b = 2; var y: P8; y.x = 3; y.y = 4; return x.sum() + y.sum() * 100; }
fn sb_global(): i64 { return GODD.sum() + GP8.sum() * 100; }
fn sb_result(): i64 { var x: Odd; x.a = 1; x.b = 2; var z: Odd = x.dbl(); var y: P8; y.x = 3; y.y = 4; var w: P8; w.x = 0; w.y = 0; w = y.twice(); return z.a + z.b * 10 + w.x * 100 + w.y * 1000; }
fn sb_capture(): i64 { var x: P8; x.x = 2; x.y = 3; var f = || x.sum(); return callptr(f); }
fn sb_forward(): i64 { var x: P8; x.x = 4; x.y = 5; return x.later(); }
fn P8_later(self: P8): i64 { return self.x * self.y; }

# ── 6.6.11: a struct variable copied FROM a struct-typed field ─────────────────────────────────
struct B8 { v: P8; n; }
struct BQ { k; q: Q; }
var GQ = Pt { 0, 0 };
var GBX = Box { 5, 6, 7 };
fn fl_assign_local(): i64 { var b: Box; b.v.x = 3; b.v.y = 4; b.n = 9; var q: Pt; q.x = 0; q.y = 0; q = b.v; return q.x * 10 + q.y + b.n * 100; }
fn fl_decl_local(): i64 { var b: Box; b.v.x = 3; b.v.y = 4; b.n = 9; var p: Pt = b.v; p.x = 7; return p.x * 10 + p.y + b.v.x * 100; }
fn fl_assign_global(): i64 { var b: Box; b.v.x = 3; b.v.y = 4; GQ = b.v; return GQ.x * 10 + GQ.y; }
fn fl_assign_param(q: Pt): i64 { var b: Box; b.v.x = 3; b.v.y = 4; q = b.v; return q.x * 10 + q.y; }
fn fl_decl_global_src(): i64 { var q: Pt = GBX.v; return q.x * 10 + q.y; }
fn fl_decl_24(): i64 { var b: BQ; b.k = 8; b.q.a = 1; b.q.b = 2; b.q.c = 3; var y: Q = b.q; return y.a + y.b * 10 + y.c * 100 + b.k * 1000; }
fn fl_assign_24(): i64 { var b: BQ; b.k = 8; b.q.a = 4; b.q.b = 5; b.q.c = 6; var y: Q; y.a = 0; y.b = 0; y.c = 0; y = b.q; return y.a + y.b * 10 + y.c * 100; }
fn fl_odd(): i64 { var h: HO; h.o.a = 3; h.o.b = 700; h.t = 5; h.u = 9; var z: Odd = h.o; var w: Odd; w.a = 0; w.b = 0; w = h.o; return z.a + z.b * 10 + w.a * 10000 + w.b * 100000; }
fn fl_p8(): i64 { var b: B8; b.v.x = 3; b.v.y = 4; b.n = 9; var p: P8 = b.v; var q: P8; q.x = 0; q.y = 0; q = b.v; return p.x * 10 + p.y + q.x * 1000 + q.y * 100; }

# ── 6.6.12: positional literals of structs with nested struct fields ───────────────────────────
# HO = { o: Odd @0 = { a: i8 @0; b: i16 @1 }; t: i8 @3; u: i32 @4 } — 8 bytes.
fn ho4(h): i64 { return load8(h) + load16(h + 1) * 10 + load8(h + 3) * 100 + load32(h + 4) * 1000; }
# Outer = { t @0; b: Box @8 = { v: Pt @8 = { x @8; y @16 }; n @24 } }.
fn ou4(o): i64 { return load64(o) + load64(o + 8) * 10 + load64(o + 16) * 100 + load64(o + 24) * 1000; }
# HH = { h: HO @0; z: i8 @8 } — two levels, narrow throughout.
fn hh5(h): i64 { return ho4(h) + load8(h + 8) * 10000; }
var HO_ALL = 0x44444444 * 1000 + 0x33 * 100 + 0x2222 * 10 + 0x11;
# Each returns 1 only when every field is right AND the canaries on both sides are intact.
fn lit_ho_local(): i64 {
    var c0 = 0x5A5A5A5A5A5A5A5A;
    var h = HO { 0x11, 0x2222, 0x33, 0x44444444 };
    var c1 = 0x5A5A5A5A5A5A5A5A;
    if (c0 != 0x5A5A5A5A5A5A5A5A) { return 0; }
    if (c1 != 0x5A5A5A5A5A5A5A5A) { return 0; }
    return ho4(&h) == HO_ALL;
}
fn lit_outer_local(): i64 { var c0 = 7; var o = Outer { 1, 2, 3, 4 }; var c1 = 8; return ou4(&o) + c0 * 10000 + c1 * 100000; }
fn lit_hh_local(): i64 { var c0 = 7; var h = HH { 1, 2, 3, 4, 5 }; var c1 = 8; return hh5(&h) + c0 * 100000 + c1 * 1000000; }
fn lit_scalar_exprs(): i64 { var k = 3; var b = Box { k + 1, k * 2, 9 }; return pack(b); }
# a whole struct value for a nested struct field
fn lv_local(): i64 { var p: Pt; p.x = 1; p.y = 2; var b = Box { p, 5 }; p.x = 9; return pack(b); }
fn lv_param(p: Pt): i64 { var b = Box { p, 5 }; return pack(b); }
fn lv_global(): i64 { var b = Box { GP, 5 }; return b.v.x + b.v.y + b.n; }
fn lv_field(): i64 { var a: Box; a.v.x = 6; a.v.y = 8; a.n = 1; var b = Box { a.v, 2 }; return pack(b); }
fn lv_call(): i64 { var b = Box { mkpt(4), 3 }; return pack(b); }
fn lv_method(): i64 { var p: Pt; p.x = 3; p.y = 4; var b = Box { p.twice(), 1 }; return pack(b); }
fn lv_bigcall(): i64 { var b = BB { 9, mkbig(1) }; return b.w.a + b.w.b * 10 + b.w.c * 100 + b.k * 1000; }
fn lv_operator(): i64 { var a: Big; a.a = 1; a.b = 2; a.c = 3; var c: Big; c.a = 10; c.b = 20; c.c = 30; var b = BB { 4, a + c }; return b.w.a + b.w.b + b.w.c + b.k * 1000; }
fn lv_oddcall(): i64 { var h = HasOdd { mkodd(2), 5 }; return h.o.a + h.o.b * 10 + h.tail * 10000; }
fn lv_oddlocal(): i64 { var o: Odd; o.a = 3; o.b = 700; var h = HasOdd { o, 5 }; return h.o.a + h.o.b * 10 + h.tail * 10000; }
fn lv_oddmethod(): i64 { var x: Odd; x.a = 1; x.b = 2; var h = HO { x.twice(), 5, 9 }; return h.o.a + h.o.b * 10 + h.t * 100 + h.u * 1000; }
fn lv_chain(): i64 { var p: Pt; p.x = 2; p.y = 3; var o = Outer { 1, p, 4 }; return ou4(&o); }
fn lv_whole2(): i64 { var b: Box; b.v.x = 2; b.v.y = 3; b.n = 4; var o = Outer { 1, b }; return ou4(&o); }
fn lv_chain_field(): i64 { var b: Box; b.v.x = 2; b.v.y = 3; b.n = 9; var o = Outer { 1, b.v, 4 }; return ou4(&o); }
fn lv_chain_call(): i64 { var o = Outer { 1, mkpt(2), 4 }; return ou4(&o); }

test_group("a struct value assigned into a struct-typed field copies the whole struct");
var gp: Pt = alloc(16);
gp.x = 3; gp.y = 4;
assert_eq(from_param(gp), 534, "from an address-passed struct parameter (was the pointer)");
assert_eq(from_local(), 712, "from an inline local");
assert_eq(from_heap(), 145, "from a pointer-mode local: a copy, not an alias");
assert_eq(from_global(), 112, "from an inline global");
assert_eq(from_call(), 345, "from a 9-16 B struct call (rax:rdx)");
assert_eq(from_bigcall(), 9321, "from a >16 B struct call (retptr)");
assert_eq(from_method(), 168, "from a method returning the struct");
assert_eq(from_operator(), 66, "from an overloaded operator returning the struct");
assert_eq(from_field(), 268, "from another field of that struct type");
assert_eq(from_chain(), 413, "from a two-level field chain");
assert_eq(into_chain(), 5627, "into a two-level field chain");
assert_eq(into_global(), 189, "into a global's field");
assert_eq(into_union(), 23, "into a union field");
assert_eq(odd_sizes(), 50703060202, "a 3-byte struct field, byte-exact (neighbour intact)");
assert_eq(keep_neighbours(), 42, "the field after the copied one is untouched");


test_group("an odd-width (3/5/6/7 B) struct field is stored byte-exact: its neighbours survive");
assert_eq(odd_method(), 9542, "a method returning a 3-byte struct");
assert_eq(odd_operator(), 9542, "an overloaded operator into a 3-byte field");
assert_eq(s6_operator(), 77642, "an overloaded operator into a 6-byte field");
assert_eq(s5_call(), 4376, "a free call into a 5-byte field");
assert_eq(s7_call(), 8321, "a free call into a 7-byte field");
assert_eq(odd_integer(), 17201, "a plain integer into a 3-byte field writes three bytes");
var GHO = HO { 0x11, 0x2222, 0x33, 0x44444444 };
# (no canary here: a global declared after this point is stored in program order, AFTER the
# literal, and would hide an overrun — the leading-block GHOD rows below carry the canaries)
assert_eq(ho4(&GHO), HO_ALL, "top-level literal of a struct with a 3-byte nested field: every field");
GHO.t = 5; GHO.u = 9;
GHO.o = mkodd(2);
assert_eq(GHO.o.a + GHO.o.b * 10 + GHO.t * 10000 + GHO.u * 100000, 952002, "a free call into a 3-byte field at top level");

test_group("var y: T = x from an address-passed struct parameter is a copy (6.6.11)");
assert_eq(pc_caller16(), 921, "writing y leaves the caller's 16 B struct intact");
assert_eq(pc_caller24(), 9321, "writing y leaves the caller's 24 B struct intact");
assert_eq(pc_ret16(), 21, "copy-init then return y (rax:rdx)");
assert_eq(pc_ret24(), 321, "copy-init then return y (retptr)");

test_group("a method whose self is a struct of 8 B or less gets the VALUE (6.6.11)");
assert_eq(sb_local(), 4321, "x.sum() on a 3 B and an 8 B local");
assert_eq(sb_global(), 4321, "G.sum() on a 3 B and an 8 B global");
assert_eq(sb_result(), 8642, "x.dbl() / y.twice() returning the struct");
assert_eq(sb_capture(), 32, "a captured receiver");
assert_eq(sb_forward(), 20, "a method defined after its call");

test_group("a struct variable copied FROM a struct-typed field takes the whole struct (6.6.11)");
assert_eq(fl_assign_local(), 934, "q = b.v into a local");
assert_eq(fl_decl_local(), 374, "var p: Pt = b.v (was SIGSEGV), and it is a copy");
assert_eq(fl_assign_global(), 34, "GQ = b.v into a global");
var gq2: Pt = alloc(16);
assert_eq(fl_assign_param(gq2), 34, "q = b.v into an address-passed parameter");
assert_eq(fl_decl_global_src(), 56, "var q: Pt = GBX.v from a global's field");
assert_eq(fl_decl_24(), 8321, "var y: Q = b.q (24 B)");
assert_eq(fl_assign_24(), 654, "y = b.q (24 B)");
assert_eq(fl_odd(), 70037003, "a 3-byte struct from a field, both forms");
assert_eq(fl_p8(), 3434, "an 8-byte struct from a field, both forms");

test_group("a positional literal lays a nested struct out at its real offsets (6.6.12)");
assert_eq(ho4(&GHOD), HO_ALL, "leading-block literal, a 3-byte nested field: every field");
assert_eq(GHOD_C1, 0x5A5A5A5A5A5A5A5A, "... the global after it is untouched");
assert_eq(GHOD_C2, 0x5A5A5A5A5A5A5A5A, "... and the one after that");
assert_eq(lit_ho_local(), 1, "fn-local literal: every field, both neighbours intact");
assert_eq(ou4(&GOUD), 4321, "a struct nested two levels deep takes four values");
assert_eq(GOUD_C, 0x5A5A5A5A5A5A5A5A, "... the global after it is untouched");
assert_eq(lit_outer_local(), 874321, "... fn-local, neighbours intact");
assert_eq(hh5(&GHHD), 54321, "two levels, narrow throughout");
assert_eq(GHHD_C, 0x5A5A5A5A5A5A5A5A, "... the global after it is untouched");
assert_eq(lit_hh_local(), 8754321, "... fn-local, neighbours intact");
assert_eq(lit_scalar_exprs(), 946, "expressions still flatten into the nested leaves");

test_group("a nested struct field takes a whole struct value (6.6.12)");
assert_eq(lv_local(), 512, "from a local, copied (a later write to it does not show)");
var gp3: Pt = alloc(16);
gp3.x = 3; gp3.y = 4;
assert_eq(lv_param(gp3), 534, "from an address-passed parameter (not the pointer)");
assert_eq(lv_global(), 115, "from a global");
assert_eq(GBOXD.v.x + GBOXD.v.y * 10 + GBOXD.n * 100, 1350, "from a global, in the leading block");
assert_eq(lv_field(), 268, "from a struct-typed field");
assert_eq(lv_call(), 345, "from a 9-16 B call (rax:rdx)");
assert_eq(lv_method(), 168, "from a method");
assert_eq(lv_bigcall(), 9321, "from a >16 B call (retptr)");
assert_eq(lv_operator(), 4066, "from an overloaded operator");
assert_eq(lv_oddcall(), 52002, "a 3-byte struct from a call (rax), byte-exact");
assert_eq(lv_oddlocal(), 57003, "a 3-byte struct from a local");
assert_eq(lv_oddmethod(), 9542, "a 3-byte struct from a method, the narrow fields after it intact");
assert_eq(lv_chain(), 4321, "a value of the nested field's first-field type fills it");
assert_eq(lv_whole2(), 4321, "a whole two-level value");
assert_eq(lv_chain_field(), 4321, "a first-field-type value from a field");
assert_eq(lv_chain_call(), 4321, "a first-field-type value from a call");

var r = assert_summary();
