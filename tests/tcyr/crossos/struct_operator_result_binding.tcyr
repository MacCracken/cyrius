# struct_operator_result_binding.tcyr — 6.7.10. AN UNTYPED `var c = a + b;` WHOSE OPERATOR RETURNS A
# STRUCT TAKES THE STRUCT TYPE AT EVERY SIZE (the user's decision 12, 2026-10-12), as it did over 8 B:
# `c.g` reads and writes the field and `c + c` dispatches the operator again.
#
# ⛔ THROUGH 6.7.9 an operator result of 8 B or less was a plain word: the untyped binding held the
# struct's bytes with no type, so `c.g` was "no struct type in scope for 'c'" and `c + c` added two
# integers, while the same expression over 8 B named its temporary `c` (`_sc_var_receive`) and typed it.
# 6.7.10's packed fields moved `struct C4 { r: u8; g: u8; b: u8; a: u8; }` from 32 to 4 bytes, so
# `var c = A + B; c.g = 1;` — which compiled through 6.7.9 — was refused.
#
# THE RULE, every row against its 16 B twin (both give the row's constant): the binding is an inline
# struct of the operator fn's RETURN type (`S_add` may return another struct), a copy (a write to c
# leaves a and b), whatever the left operand is — a variable, a field, a dereference, a call result (the
# operator's type wins over the leading call's, as over 8 B), wrapped, chained — and for `+ - * /`.
# An operator returning an INTEGER leaves the binding untyped (`var r = a - b; r + 1` is an integer
# add). At top level an untyped global keeps the struct's word, untyped, at every size (over 8 B a
# global's operator result has no temporary to name).
#
# 6.7.11 (the user's decision (a), 2026-10-13; issues/2026-10-13-untyped-struct-binding-beyond-operators-
# decision.md) — the rule reaches EVERY whole struct result: a method chain of 8 B or less (`var c =
# a.d().d();`), an if-expression of struct branches (8 B or less, the only size a branch can be), and a
# 9-16 B operator / method result in parentheses (`var c = (a + b);`, `(a.m())`) bind an inline struct, as
# the annotated form does; through 6.7.10 each was an untyped word (`c.v` refused, `c + 1` added to it,
# `takeh(c)` passed the 16 B one's first word as its address). The `m` / `i` / `p` rows below, each at
# 1..8 B and against its 16 / 24 B twin; an integer-ending chain, a scalar annotation (8 B or less: over 8 B it is
# refused since 6.7.13, D13) and a global keep the word.
#
# CROSS-HOST: tests/gates/codegen/small_struct_handle_line.sh R8 runs this file on x86_64 (plain,
# CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm) and PE (wine); the release gate's
# cross-OS leg on ecb / ach / cass / pi.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"

struct C4 { r: u8; g: u8; b: u8; a: u8; }          # 4 B (32 through 6.7.9)
struct S8 { v; }
struct H { v; w; }
struct U8 { u; }
struct UH { u; x; }
struct T3 { x; y; z; }
struct W8 { n; s: S8; }
struct WH { n; s: H; }

fn C4_add(a: C4, b: C4): C4 { var r: C4; r.r = a.r + b.r; r.g = a.g + b.g; r.b = a.b + b.b; r.a = a.a + b.a; return r; }
fn S8_add(a: S8, b: S8): S8 { var r: S8; r.v = a.v * 3 + b.v; return r; }
fn H_add(a: H, b: H): H { var r: H; r.v = a.v * 3 + b.v; r.w = a.w + b.w; return r; }
fn T3_add(a: T3, b: T3): T3 { var r: T3; r.x = a.x * 3 + b.x; r.y = a.y + b.y; r.z = a.z + b.z; return r; }
fn S8_mul(a: S8, b: S8): U8 { var r: U8; r.u = a.v * b.v; return r; }
fn H_mul(a: H, b: H): UH { var r: UH; r.u = a.v * b.v; r.x = 0; return r; }
fn S8_div(a: *S8, b: *S8): S8 { var r: S8; r.v = a.v / b.v; return r; }
fn H_div(a: *H, b: *H): H { var r: H; r.v = a.v / b.v; r.w = 0; return r; }
fn S8_sub(a: S8, b: S8): i64 { return a.v - b.v; }
fn H_sub(a: H, b: H): i64 { return a.v - b.v; }
fn mk8(n): S8 { var r: S8; r.v = n; return r; }
fn mkh(n): H { var r: H; r.v = n; r.w = 1; return r; }
fn take8(s: S8): i64 { return s.v; }
fn takeh(s: H): i64 { return s.v; }

# ── the filed C4 case: c.g = 1 (it was refused since 4 B), c + c dispatches again, A and B kept ──
fn c4_case() {
    var A = C4 { 1, 2, 3, 4 };
    var B = C4 { 10, 20, 30, 40 };
    var c = A + B;
    c.g = 1;
    var d = c + c;
    var k = 0;
    if (c.r == 11) { if (c.g == 1) { if (c.b == 33) { if (c.a == 44) { k = k + 1; } } } }
    if (d.r == 22) { if (d.g == 2) { if (d.b == 66) { if (d.a == 88) { k = k + 10; } } } }
    if (A.g == 2) { if (B.g == 20) { k = k + 100; } }
    return k;
}
fn c4_wrap() {
    var A = C4 { 250, 2, 3, 4 };
    var B = C4 { 10, 20, 30, 40 };
    var c = A + B;
    return c.r * 100 + c.g;
}

# ── 8 B against its 16 B twin: a = 4 (H: 4, 1), b = 70 (H: 70, 2) ──
fn b_var_8() {
    var a: S8 = S8 { 4 };
    var b: S8 = S8 { 70 };
    var c = a + b;
    c.v = c.v + 1;
    return c.v * 100 + a.v;
}
fn b_var_h() {
    var a: H = H { 4, 1 };
    var b: H = H { 70, 2 };
    var c = a + b;
    c.v = c.v + 1;
    return c.v * 100 + a.v + (c.w - 3) * 100000;
}
fn b_again_8() { var a: S8 = S8 { 4 }; var b: S8 = S8 { 70 }; var c = a + b; var d = c + c; return d.v; }
fn b_again_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = a + b; var d = c + c; return d.v; }
fn b_other_8() { var a: S8 = S8 { 4 }; var b: S8 = S8 { 70 }; var c = a * b; c.u = c.u + 1; return c.u; }
fn b_other_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = a * b; c.u = c.u + 1; return c.u; }
fn b_div_8() { var a: S8 = S8 { 70 }; var b: S8 = S8 { 4 }; var c = a / b; return c.v; }
fn b_div_h() { var a: H = H { 70, 1 }; var b: H = H { 4, 2 }; var c = a / b; return c.v; }
fn b_lcall_8() { var b: S8 = S8 { 70 }; var c = mk8(4) * b; c.u = c.u + 1; return c.u; }
fn b_lcall_h() { var b: H = H { 70, 2 }; var c = mkh(4) * b; c.u = c.u + 1; return c.u; }
fn b_field_8() {
    var w: W8 = W8 { 0, 4 };
    var b: S8 = S8 { 70 };
    var c = w.s + b;
    c.v = c.v + 1;
    return c.v * 100 + w.s.v;
}
fn b_field_h() {
    var w: WH = WH { 0, 4, 1 };
    var b: H = H { 70, 2 };
    var c = w.s + b;
    c.v = c.v + 1;
    return c.v * 100 + w.s.v;
}
fn b_deref_8() { var x: S8 = S8 { 4 }; var p: *S8 = &x; var b: S8 = S8 { 70 }; var c = *p + b; return c.v; }
fn b_deref_h() { var x: H = H { 4, 1 }; var p: *H = &x; var b: H = H { 70, 2 }; var c = *p + b; return c.v; }
fn b_paren_8() { var a: S8 = S8 { 4 }; var b: S8 = S8 { 70 }; var c = (a + b); return c.v; }
fn b_paren_t() { var a: T3 = T3 { 4, 1, 1 }; var b: T3 = T3 { 70, 2, 2 }; var c = (a + b); return c.x; }
# 6.7.11: and its 16 B twin — through 6.7.10 a 9-16 B result in parentheses had no temporary for an untyped
# binding to name (`c.v` refused)
fn b_paren_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = (a + b); return c.v; }
fn b_chain_8() { var a: S8 = S8 { 4 }; var b: S8 = S8 { 70 }; var c = a + b + a; return c.v; }
fn b_chain_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = a + b + a; return c.v; }
fn b_arg_8() { var a: S8 = S8 { 4 }; var b: S8 = S8 { 70 }; var c = a + b; return take8(c); }
fn b_arg_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = a + b; return takeh(c); }
fn b_clos_8() {
    var a: S8 = S8 { 4 };
    var b: S8 = S8 { 70 };
    var f = |d| { var c = a + b; return c.v + d; };
    return callptr(f, 0);
}
fn b_clos_h() {
    var a: H = H { 4, 1 };
    var b: H = H { 70, 2 };
    var f = |d| { var c = a + b; return c.v + d; };
    return callptr(f, 0);
}
# an integer-returning operator leaves the binding untyped: `r + 1` is an integer add
fn b_int_8() { var a: S8 = S8 { 70 }; var b: S8 = S8 { 4 }; var r = a - b; return r + 1; }
fn b_int_h() { var a: H = H { 70, 1 }; var b: H = H { 4, 2 }; var r = a - b; return r + 1; }
# 6.7.11 — and after a LEADING CALL: a call's struct types the binding only when the call is the whole
# initialiser, so `var r = mk8(10) - b;` with an integer-returning `-` is an untyped integer, as is a
# comparison after a leading call (through 6.7.10 r took mk8's S8, so `r.v` dereferenced the integer —
# refused now: tests/gates/codegen/struct_value_codegen.sh L16 / L17,
# small_struct_handle_line.sh B2); a struct-returning operator still
# types the binding; a `: f64` call keeps its f64
fn T3_sub(a: *T3, b: *T3): i64 { return a.z - b.z; }
fn mkt(n): T3 { var r: T3; r.x = n; r.y = n; r.z = n; return r; }
fn fdbl(): f64 { return 1.5; }
fn b_lint_8() { var b: S8 = S8 { 3 }; var r = mk8(10) - b; return r + 1; }
fn b_lint_h() { var b: H = H { 3, 0 }; var r = mkh(10) - b; return r + 1; }
fn b_lint_t() { var b: T3 = T3 { 9, 9, 9 }; var r = mkt(4) - b; return r + 10; }
fn b_lcmp_8() { var b: S8 = S8 { 1 }; var r = mk8(1) == b; return r + 1; }
fn b_lop_t() { var b: T3 = T3 { 5, 6, 7 }; var r = mkt(4) + b; return r.x + r.y + r.z; }
fn b_lf64() { var x = fdbl() * 2.0; var y = x + x; return f64_to(y); }
# 6.7.13 (issues/archived/2026-10-14-integer-comparison-result-keeps-f64-right-operand-type.md) — a comparison, an `&&` /
# `||` link and (the user's decision D12 (a), 2026-10-15) `& | ^ % << >> >>>` give an INTEGER whatever the
# right operand: with an f64 one the result kept the f64 type and the next `*` took the f64 arm (the repro: 0).
# `xb` holds f64 bits whose low byte is 3 (a shift count of 3), so the integer result is checkable.
fn f64_bits3(): f64 { var x: f64 = 0.0; store64(&x, 0x3FF0000000000003); return x; }
fn c_lt() { var n = 1; var x: f64 = 2.5; var c = (n < x) * 3; return c; }
fn c_and() { var n = 1; var x: f64 = 2.5; var c = (n == 1 && x) * 3; return c; }
fn c_or() { var n = 1; var x: f64 = 2.5; var c = (n == 0 || x) * 3; return c; }
fn c_band() { var m = 7; var xb = f64_bits3(); var c = (m & xb) * 3; return c; }
fn c_bxor() { var m = 7; var xb = f64_bits3(); var c = (m ^ xb) * 3; return c & 255; }
fn c_mod() { var m = 64; var xb = f64_bits3(); var c = (m % xb) * 3; return c; }
fn c_shl() { var m = 7; var xb = f64_bits3(); var c = (m << xb) * 3; return c; }
fn c_shr() { var m = 64; var xb = f64_bits3(); var c = (m >> xb) * 3; return c; }
# 6.7.13 (issues/archived/2026-10-14-f64-leading-call-types-comparison-binding-f64.md) — `var c = f() < 1.0;` with a `: f64`
# leading call bound c as an f64 (the leading call's type), so `-c` was a float negation: the sign bit flipped
# (0x8000000000000001, the repro: 3 where 1 is right) and `0 - c` warned kind 2. The f64 binding holds only
# while the whole initialiser is still f64 (`_var_rhs_post`): b_lf64 above keeps it.
fn fhalf(): f64 { return 0.5; }
fn l_lt() { var c = fhalf() < 1.0; var n = -c; return n; }
fn l_eq() { var c = fhalf() == 0.5; var n = -c; return n; }
fn l_le() { var c = fhalf() <= 0.5; var n = -c; return n; }
fn l_ge() { var c = fhalf() >= 0.5; var n = 0 - c; return n; }
fn l_and() { var k = 1; var c = fhalf() > 0.1 && k == 1; var n = -c; return n; }
fn l_andx() { var k = 0; var x: f64 = 2.5; var c = fhalf() > 0.1 && k < x; var n = -c; return n; }
fn l_keep() { var x = fhalf(); var y = x + 1.5; return f64_to(y); }

# ── sizes 1..7 B (u8 / u16 / u32 compositions): c.f read and written, c + c dispatched ──
struct Z1 { a: u8; }
struct Z2 { a: u16; }
struct Z3 { a: u8; b: u16; }
struct Z5 { a: u32; b: u8; }
struct Z6 { a: u32; b: u16; }
struct Z7 { a: u32; b: u16; c: u8; }
fn Z1_add(l: Z1, r: Z1): Z1 { var t: Z1; t.a = l.a + r.a; return t; }
fn Z2_add(l: Z2, r: Z2): Z2 { var t: Z2; t.a = l.a + r.a; return t; }
fn Z3_add(l: Z3, r: Z3): Z3 { var t: Z3; t.a = l.a + r.a; t.b = l.b + r.b; return t; }
fn Z5_add(l: Z5, r: Z5): Z5 { var t: Z5; t.a = l.a + r.a; t.b = l.b + r.b; return t; }
fn Z6_add(l: Z6, r: Z6): Z6 { var t: Z6; t.a = l.a + r.a; t.b = l.b + r.b; return t; }
fn Z7_add(l: Z7, r: Z7): Z7 { var t: Z7; t.a = l.a + r.a; t.b = l.b + r.b; t.c = l.c + r.c; return t; }
# each: x = (3, 4, 5), y = (1, 1, 1): c = x + y, c.a += 10, d = c + c -> d.a = 28 (d.b 10, d.c 12)
fn z1() { var x: Z1; x.a = 3; var y: Z1; y.a = 1; var c = x + y; c.a = c.a + 10; var d = c + c; return d.a; }
fn z2() { var x: Z2; x.a = 3; var y: Z2; y.a = 1; var c = x + y; c.a = c.a + 10; var d = c + c; return d.a; }
fn z3() {
    var x: Z3; x.a = 3; x.b = 4;
    var y: Z3; y.a = 1; y.b = 1;
    var c = x + y;
    c.a = c.a + 10;
    var d = c + c;
    return d.a + d.b * 100;
}
fn z5() {
    var x: Z5; x.a = 3; x.b = 4;
    var y: Z5; y.a = 1; y.b = 1;
    var c = x + y;
    c.a = c.a + 10;
    var d = c + c;
    return d.a + d.b * 100;
}
fn z6() {
    var x: Z6; x.a = 3; x.b = 4;
    var y: Z6; y.a = 1; y.b = 1;
    var c = x + y;
    c.a = c.a + 10;
    var d = c + c;
    return d.a + d.b * 100;
}
fn z7() {
    var x: Z7; x.a = 3; x.b = 4; x.c = 5;
    var y: Z7; y.a = 1; y.b = 1; y.c = 1;
    var c = x + y;
    c.a = c.a + 10;
    var d = c + c;
    return d.a + d.b * 100 + d.c * 10000;
}

# ── 6.7.11: a METHOD CHAIN (m), an IF-EXPRESSION (i), a PARENTHESISED 9-16 B result (p) ──
# Methods: `d` doubles every field (a fresh struct), `n` returns an integer. Every chain starts from v = 5.
fn S8_d(self: *S8): S8 { var r: S8; r.v = self.v * 2; return r; }
fn S8_n(self: *S8): i64 { return self.v; }
fn H_d(self: *H): H { var r: H; r.v = self.v * 2; r.w = self.w * 2; return r; }
fn H_m(self: *H): H { var r: H; r.v = self.v + 1; r.w = 2; return r; }
fn T3_d(self: *T3): T3 { var r: T3; r.x = self.x * 2; r.y = self.y * 2; r.z = self.z * 2; return r; }
fn C4_d(self: *C4): C4 { var r: C4; r.r = self.r * 2; r.g = self.g * 2; r.b = self.b * 2; r.a = self.a * 2; return r; }
fn Z1_d(self: *Z1): Z1 { var r: Z1; r.a = self.a * 2; return r; }
fn Z6_d(self: *Z6): Z6 { var r: Z6; r.a = self.a * 2; r.b = self.b * 2; return r; }
fn S8_m(self: *S8): S8 { var r: S8; r.v = self.v + 1; return r; }
fn T3_m(self: *T3): T3 { var r: T3; r.x = self.x + 1; r.y = 2; r.z = 3; return r; }
fn mkc4(n): C4 { var r: C4; r.r = n; r.g = n + 1; r.b = n + 2; r.a = n + 3; return r; }
fn mkz1(n): Z1 { var r: Z1; r.a = n; return r; }
# the issue's three repros (u1 20, u2 7, u3 41)
fn u1() { var a: S8; a.v = 5; var c = a.d().d(); return c.v; }
fn u2() { var k = 1; var c = if (k == 1) { mk8(7) } else { mk8(9) }; return c.v; }
struct S16 { v; w; }
fn S16_add(a: *S16, b: *S16): S16 { var r: S16; r.v = a.v + b.v; r.w = a.w + b.w; return r; }
fn S16_m(self: *S16): S16 { var r: S16; r.v = self.v + 1; r.w = 2; return r; }
fn u3() {
    var a: S16; a.v = 3; a.w = 4; var b: S16; b.v = 10; b.w = 20;
    var c = (a + b); var e = (a.m()); return c.v + c.w + e.v;
}
# m: the chain binds the struct: c.f written (a copy: a kept), c + c dispatches, take(c) by value
fn m_var_8() { var a: S8 = S8 { 5 }; var c = a.d().d(); c.v = c.v + 1; return c.v * 100 + a.v; }
fn m_var_h() { var a: H = H { 5, 1 }; var c = a.d().d(); c.v = c.v + 1; return c.v * 100 + a.v + (c.w - 4) * 100000; }
fn m_var_t() { var a: T3 = T3 { 5, 1, 1 }; var c = a.d().d(); c.x = c.x + 1; return c.x * 100 + a.x + (c.z - 4) * 100000; }
fn m_again_8() { var a: S8 = S8 { 5 }; var c = a.d().d(); var d = c + c; return d.v; }
fn m_again_h() { var a: H = H { 5, 1 }; var c = a.d().d(); var d = c + c; return d.v; }
fn m_arg_8() { var a: S8 = S8 { 5 }; var c = a.d().d(); return take8(c); }
fn m_arg_h() { var a: H = H { 5, 1 }; var c = a.d().d(); return takeh(c); }
fn m_three_8() { var a: S8 = S8 { 5 }; var c = a.d().d().d(); return c.v; }
fn m_call_8() { var c = mk8(5).d().d(); return c.v; }
fn m_call_h() { var c = mkh(5).d().d(); return c.v; }
fn m_wrap_8() { var a: S8 = S8 { 5 }; var c = (a.d().d()); return c.v; }
fn m_c4() { var a: C4 = mkc4(1); var c = a.d().d(); c.g = c.g + 1; var d = c + c; return d.r * 1000 + d.g * 10 + c.a; }
fn m_z1() { var a: Z1 = mkz1(5); var c = a.d().d(); c.a = c.a + 1; var d = c + c; return d.a; }
fn m_z6() { var a: Z6; a.a = 5; a.b = 7; var c = a.d().d(); c.a = c.a + 1; return c.a * 1000 + c.b; }
# a chain ENDING in an integer method is an integer: c + 1 adds
fn m_int_8() { var a: S8 = S8 { 5 }; var c = a.d().n(); return c + 1; }
# i: an if-expression of struct branches (8 B or less)
fn i_var_8() { var k = 1; var c = if (k == 1) { mk8(7) } else { mk8(9) }; c.v = c.v + 1; return c.v; }
fn i_else_8() { var k = 2; var c = if (k == 1) { mk8(7) } else { mk8(9) }; return c.v; }
fn i_again_8() { var k = 1; var c = if (k == 1) { mk8(7) } else { mk8(9) }; var d = c + c; return d.v; }
fn i_arg_8() { var k = 1; var c = if (k == 1) { mk8(7) } else { mk8(9) }; return take8(c); }
fn i_elif_8() { var k = 2; var c = if (k == 1) { mk8(7) } elif (k == 2) { mk8(8) } else { mk8(9) }; return c.v; }
fn i_wrap_8() { var k = 1; var c = (if (k == 1) { mk8(7) } else { mk8(9) }); return c.v; }
fn i_var_name() { var k = 1; var x: S8 = S8 { 7 }; var y: S8 = S8 { 9 }; var c = if (k == 1) { x } else { y }; c.v = c.v + 1; return c.v * 10 + x.v; }
fn i_c4() { var k = 1; var c = if (k == 1) { mkc4(1) } else { mkc4(5) }; c.g = 9; var d = c + c; return d.r * 100 + d.g; }
fn i_z1() { var k = 1; var c = if (k == 1) { mkz1(3) } else { mkz1(4) }; c.a = c.a + 10; var d = c + c; return d.a; }
# p: a parenthesised operator / method result, the 16 B one new (its 8 and 24 B twins typed before)
fn p_op_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = (a + b); c.v = c.v + 1; return c.v * 100 + a.v + (c.w - 3) * 100000; }
fn p_op_8() { var a: S8 = S8 { 4 }; var b: S8 = S8 { 70 }; var c = (a + b); c.v = c.v + 1; return c.v * 100 + a.v; }
fn p_meth_h() { var a: H = H { 5, 1 }; var e = (a.m()); e.w = e.w + 1; return e.v * 10 + e.w; }
fn p_meth_8() { var a: S8 = S8 { 5 }; var e = (a.m()); return e.v * 10 + 3; }
fn p_meth_t() { var a: T3 = T3 { 5, 1, 1 }; var e = (a.m()); return e.x * 10 + e.y + e.z - 2; }
fn p_again_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = (a + b); var d = c + c; return d.v; }
fn p_arg_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = (a + b); return takeh(c); }
fn p_arg_m() { var a: H = H { 5, 1 }; var e = (a.m()); return takeh(e); }
fn p_deep_h() { var a: H = H { 4, 1 }; var b: H = H { 70, 2 }; var c = (((a + b))); return c.v + c.w; }
fn p_mchain_h() { var a: H = H { 5, 1 }; var c = (a.d().d()); return c.v + c.w; }
# a scalar annotation keeps an 8 B struct's one word (over 8 B it is refused by name since 6.7.13, D13 — the
# 16 B row that kept H's first word is a refusal row in tests/gates/frontend/struct_receive_inference_checked.sh);
# parentheses around an integer stay an integer
fn p_scalar_8() { var a: S8 = S8 { 4 }; var b: S8 = S8 { 70 }; var c: i64 = (a + b); return c; }
fn p_int_h() { var a: H = H { 70, 1 }; var b: H = H { 4, 2 }; var r = (a - b); return r + 1; }

# ── top level: an untyped global keeps the operator result's word, untyped, as over 8 B ──
var GA = S8 { 4 };
var GB = S8 { 70 };
var TG = GA + GB;
var TI = if (GA.v == 4) { mk8(7) } else { mk8(9) };   # 6.7.11: an if-expression's word, untyped (7)

assert_eq(c4_case(), 111, "the filed C4 case: var c = A + B; c.g = 1; c + c (A and B kept)");
assert_eq(c4_wrap(), 422, "C4: the u8 channel wraps in the operator (250 + 10 = 4)");
assert_eq(b_var_8(), 8304, "var c = a + b: an inline S8, a copy (a kept)");
assert_eq(b_var_8(), b_var_h(), "  = its 16 B twin");
assert_eq(b_again_8(), 328, "c + c dispatches again");
assert_eq(b_again_8(), b_again_h(), "  = its 16 B twin");
assert_eq(b_other_8(), 281, "var c = a * b: the operator's return type (U8), not the operands'");
assert_eq(b_other_8(), b_other_h(), "  = its 16 B twin");
assert_eq(b_div_8(), 17, "var c = a / b (*S parameters)");
assert_eq(b_div_8(), b_div_h(), "  = its 16 B twin");
assert_eq(b_lcall_8(), 281, "var c = mk(4) * b: the operator's type wins over the leading call's");
assert_eq(b_lcall_8(), b_lcall_h(), "  = its 16 B twin");
assert_eq(b_field_8(), 8304, "var c = w.s + b: a field left operand (w.s kept)");
assert_eq(b_field_8(), b_field_h(), "  = its 16 B twin");
assert_eq(b_deref_8(), 82, "var c = *p + b: a dereference left operand");
assert_eq(b_deref_8(), b_deref_h(), "  = its 16 B twin");
assert_eq(b_paren_8(), 82, "var c = (a + b)");
assert_eq(b_paren_8(), b_paren_t(), "  = its 24 B twin");
assert_eq(b_paren_8(), b_paren_h(), "  = its 16 B twin (6.7.11: an untyped word through 6.7.10)");
assert_eq(b_chain_8(), 250, "var c = a + b + a");
assert_eq(b_chain_8(), b_chain_h(), "  = its 16 B twin");
assert_eq(b_arg_8(), 82, "take(c): c passed by value");
assert_eq(b_arg_8(), b_arg_h(), "  = its 16 B twin");
assert_eq(b_clos_8(), 82, "var c = a + b in a closure body");
assert_eq(b_clos_8(), b_clos_h(), "  = its 16 B twin");
assert_eq(b_int_8(), 67, "an integer-returning operator: the binding stays untyped");
assert_eq(b_int_8(), b_int_h(), "  = its 16 B twin");
assert_eq(b_lint_8(), 8, "var r = mk8(10) - b; an integer-returning operator after a leading call: untyped");
assert_eq(b_lint_8(), b_lint_h(), "  = its 16 B twin");
assert_eq(b_lint_t(), 5, "  24 B: var r = mkt(4) - b; r + 10");
assert_eq(b_lcmp_8(), 2, "var r = mk8(1) == b; a comparison after a leading call: untyped");
assert_eq(b_lop_t(), 38, "var r = mkt(4) + b; a struct-returning operator after a leading call types it");
assert_eq(b_lf64(), 6, "var x = f() * 2.0; a : f64 leading call keeps the f64 binding");
assert_eq(c_lt(), 3, "(n < x) * 3 with x: f64 is an integer multiply (the repro: 0)");
assert_eq(c_and(), 3, "(n == 1 && x) * 3: an && link is 0 / 1");
assert_eq(c_or(), 3, "(n == 0 || x) * 3: an || link is 0 / 1");
assert_eq(c_band(), 9, "(m & x) * 3 is an integer (D12 (a))");
assert_eq(c_bxor(), 12, "(m ^ x) * 3 is an integer (D12 (a))");
assert_eq(c_mod(), 192, "(m % x) * 3 is an integer (D12 (a))");
assert_eq(c_shl(), 168, "(m << x) * 3 is an integer (D12 (a))");
assert_eq(c_shr(), 24, "(m >> x) * 3 is an integer (D12 (a))");
assert_eq(l_lt(), 0 - 1, "var c = f() < 1.0; -c is -1 (the repro: the sign bit flipped)");
assert_eq(l_eq(), 0 - 1, "var c = f() == 0.5; -c is -1");
assert_eq(l_le(), 0 - 1, "var c = f() <= 0.5; -c is -1");
assert_eq(l_ge(), 0 - 1, "var c = f() >= 0.5; 0 - c is -1");
assert_eq(l_and(), 0 - 1, "var c = f() > 0.1 && k == 1; -c is -1");
assert_eq(l_andx(), 0 - 1, "var c = f() > 0.1 && k < x (x: f64); -c is -1 (the compare half)");
assert_eq(l_keep(), 2, "var x = f(); a whole : f64 call keeps the f64 binding");
assert_eq(z1(), 28, "1 B: c.a written, c + c");
assert_eq(z2(), 28, "2 B: c.a written, c + c");
assert_eq(z3(), 1028, "3 B: c.a written, c + c");
assert_eq(z5(), 1028, "5 B: c.a written, c + c");
assert_eq(z6(), 1028, "6 B: c.a written, c + c");
assert_eq(z7(), 121028, "7 B: c.a written, c + c");
assert_eq(TG, 82, "top level: an untyped global keeps the result's word");
assert_eq(u1(), 20, "6.7.11 u1: var c = a.d().d(); c.v (the issue's repro: refused)");
assert_eq(u2(), 7, "u2: var c = if (..) { mk(7) } else { mk(9) }; c.v (refused)");
assert_eq(u3(), 41, "u3: var c = (a + b); var e = (a.m()); at 16 B (refused)");
assert_eq(m_var_8(), 2105, "m: var c = a.d().d(): an inline S8, a copy (a kept)");
assert_eq(m_var_8(), m_var_h(), "  = its 16 B twin");
assert_eq(m_var_8(), m_var_t(), "  = its 24 B twin");
assert_eq(m_again_8(), 80, "m: c + c dispatches S8_add");
assert_eq(m_again_8(), m_again_h(), "  = its 16 B twin");
assert_eq(m_arg_8(), 20, "m: take8(c): c passed by value");
assert_eq(m_arg_8(), m_arg_h(), "  = its 16 B twin");
assert_eq(m_three_8(), 40, "m: three links");
assert_eq(m_call_8(), 20, "m: a chain on a call, mk8(5).d().d()");
assert_eq(m_call_8(), m_call_h(), "  = its 16 B twin");
assert_eq(m_wrap_8(), 20, "m: var c = (a.d().d());");
assert_eq(m_c4(), 8196, "m: 4 B packed C4: c.g written, c + c");
assert_eq(m_z1(), 42, "m: 1 B Z1: c.a written, c + c");
assert_eq(m_z6(), 21028, "m: 6 B Z6: c.a written");
assert_eq(m_int_8(), 11, "m: a chain ending in an integer method stays an integer");
assert_eq(i_var_8(), 8, "i: var c = if (k) { mk8(7) } else { mk8(9) }: an inline S8");
assert_eq(i_else_8(), 9, "i: the else branch");
assert_eq(i_again_8(), 28, "i: c + c dispatches S8_add");
assert_eq(i_arg_8(), 7, "i: take8(c)");
assert_eq(i_elif_8(), 8, "i: an elif branch");
assert_eq(i_wrap_8(), 7, "i: in parentheses");
assert_eq(i_var_name(), 87, "i: branches naming S8 locals: a copy (x kept)");
assert_eq(i_c4(), 218, "i: 4 B packed C4: c.g written, c + c");
assert_eq(i_z1(), 26, "i: 1 B Z1: c.a written, c + c");
assert_eq(p_op_h(), 8304, "p: var c = (a + b) at 16 B: an inline H, a copy (a kept)");
assert_eq(p_op_h(), p_op_8(), "  = its 8 B twin");
assert_eq(p_meth_h(), 63, "p: var e = (a.m()) at 16 B");
assert_eq(p_meth_h(), p_meth_8(), "  = its 8 B twin");
assert_eq(p_meth_h(), p_meth_t(), "  = its 24 B twin");
assert_eq(p_again_h(), 328, "p: c + c dispatches H_add");
assert_eq(p_arg_h(), 82, "p: takeh(c): c passed by value (its first word as its address through 6.7.10)");
assert_eq(p_arg_m(), 6, "p: takeh(e) of (a.m())");
assert_eq(p_deep_h(), 85, "p: (((a + b)))");
assert_eq(p_mchain_h(), 24, "p: (a.d().d()) at 16 B");
assert_eq(p_scalar_8(), 82, "p: var c: i64 = (a + b) at 8 B: a scalar annotation keeps the struct's one word");
assert_eq(p_int_h(), 67, "p: (a - b) returning an integer stays an integer");
assert_eq(TI, 7, "top level: an if-expression's untyped global keeps the word");
var r = assert_summary();
