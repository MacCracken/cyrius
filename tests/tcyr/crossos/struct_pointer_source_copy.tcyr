# struct_pointer_source_copy.tcyr — 6.7.10. A STRUCT COPY THROUGH A `*T` GLOBAL, A `: *T` CALL OR A `*T`
# FIELD COPIES THE STRUCT, AT EVERY SIZE (the user's decision 6, 2026-10-12: struct copies are
# size-independent, and a struct copy through a `*T` copies the struct it points at).
#
# ⛔ THROUGH 6.7.9 (and 6.7.10 before this fix) — at EVERY size, 16 B included — a `*T` global's name, a call
# or method declared `: *T` and a `*T` field were no copy-assign operand: `l = GP`, `G = GP`, `l = gp()`,
# `l = w.p` stored the POINTER word into the first field (`l.v` read the address, the rest stayed stale),
# silently, while `l = p` through a `*T` LOCAL copied (6.7.0; B7-1c at every size) and `var q: S = GP`
# copied (6.7.0).
#
# THE RULE, every `_8` row against its `_h` twin over 8 B (both give the row's constant: the pointee's
# second word is 8, so a one-word store reads 50 where 58 is right): a struct VALUE destination — an inline
# local, a value global, a by-value parameter — takes a COPY of the struct a `*T` global, a `: *T` call or
# method, or a `*T` field (at the end of any chain, in parentheses) points at: a write through the pointer
# afterwards does not reach it. In a fn, a closure body, a for step and at top level. A `*T` or handle
# DESTINATION still REBINDS (`*T` <- `*T` and handle <- `*T` are the one-word store, as over 8 B): `q = GP`
# through `q: *S8` repoints q. The SIZE rows (1..7 B, u8 / u16 / u32 compositions) copy into a value global
# with a guard global packed right after it, and into a local: no byte past the object is written.
# A `*U` of another struct is refused by name (the gate's CQ rows); the end-of-mapping row is the gate's (PQ).
# (ops-6) Pointer arithmetic on a `*T` — `p + 1`, `(p + 1)`, `1 + p`, `GQ + 1`, `q - 1` — is such a source too.
#
# CROSS-HOST: tests/gates/codegen/small_struct_handle_line.sh R9 runs this file on x86_64 (plain,
# CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu), cx (cxvm) and PE (wine); the release gate's
# cross-OS leg on ecb / ach / cass / pi.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"

struct S8 { v; }
struct H { v; w; }
struct W8 { n; p: *S8; }
struct WH { n; p: *H; }
struct O8 { k; w: W8; }
struct OH { k; w: WH; }

var X8 = S8 { 5 };
var XH = H { 5, 8 };
var GP8: *S8 = &X8;
var GPH: *H = &XH;
var G8 = S8 { 0 };
var GH = H { 0, 0 };
var GW8 = W8 { 0, &X8 };
var GWH = WH { 0, &XH };
fn gp8(): *S8 { return &X8; }
fn gph(): *H { return &XH; }
fn mkw8(): W8 { var w: W8; w.n = 0; w.p = &X8; return w; }
fn mkwh(): WH { var w: WH; w.n = 0; w.p = &XH; return w; }
impl W8 { fn mp(self: *W8): *S8 { return self.p; } }
impl WH { fn mp(self: *WH): *H { return self.p; } }

# `l.v * 10 + l.w` (8 B: + 8), read after the pointee was written 6 (and put back): 58 = a copy
fn rd8(l: S8): i64 { return l.v * 10 + 8; }
fn rdh(l: H): i64 { return l.v * 10 + l.w; }
fn poke(): i64 { X8.v = 6; XH.v = 6; return 0; }
fn unpoke(): i64 { X8.v = 5; XH.v = 5; return 0; }

fn c_lgp_8() { var l: S8 = S8 { 1 }; l = GP8; poke(); var r = rd8(l); unpoke(); return r; }
fn c_lgp_h() { var l: H = H { 1, 0 }; l = GPH; poke(); var r = rdh(l); unpoke(); return r; }
fn c_ggp_8() { G8.v = 1; G8 = GP8; poke(); var r = rd8(G8); unpoke(); return r; }
fn c_ggp_h() { GH.v = 1; GH.w = 0; GH = GPH; poke(); var r = rdh(GH); unpoke(); return r; }
fn c_lcall_8() { var l: S8 = S8 { 1 }; l = gp8(); poke(); var r = rd8(l); unpoke(); return r; }
fn c_lcall_h() { var l: H = H { 1, 0 }; l = gph(); poke(); var r = rdh(l); unpoke(); return r; }
fn c_gcall_8() { G8.v = 1; G8 = gp8(); poke(); var r = rd8(G8); unpoke(); return r; }
fn c_gcall_h() { GH.v = 1; GH.w = 0; GH = gph(); poke(); var r = rdh(GH); unpoke(); return r; }
fn c_lfld_8() { var w = W8 { 0, &X8 }; var l: S8 = S8 { 1 }; l = w.p; poke(); var r = rd8(l); unpoke(); return r; }
fn c_lfld_h() { var w = WH { 0, &XH }; var l: H = H { 1, 0 }; l = w.p; poke(); var r = rdh(l); unpoke(); return r; }
fn c_gfld_8() { var w = W8 { 0, &X8 }; G8.v = 1; G8 = w.p; poke(); var r = rd8(G8); unpoke(); return r; }
fn c_gfld_h() { var w = WH { 0, &XH }; GH.v = 1; GH.w = 0; GH = w.p; poke(); var r = rdh(GH); unpoke(); return r; }
# wrapped: l = (GP), m = (gp()), k = ((w.p)) -> 585858
fn c_wrap_8() {
    var w = W8 { 0, &X8 };
    var l: S8 = S8 { 1 };
    var m: S8 = S8 { 1 };
    var k: S8 = S8 { 1 };
    l = (GP8);
    m = (gp8());
    k = ((w.p));
    poke();
    var r = rd8(l) * 10000 + rd8(m) * 100 + rd8(k);
    unpoke();
    return r;
}
fn c_wrap_h() {
    var w = WH { 0, &XH };
    var l: H = H { 1, 0 };
    var m: H = H { 1, 0 };
    var k: H = H { 1, 0 };
    l = (GPH);
    m = (gph());
    k = ((w.p));
    poke();
    var r = rdh(l) * 10000 + rdh(m) * 100 + rdh(k);
    unpoke();
    return r;
}
# chains: through a *W local, a global W, a call result, a nested field, a `: *T` method -> 5858585858
fn c_chain_8() {
    var w = W8 { 0, &X8 };
    var pw: *W8 = &w;
    var o = O8 { 0, 0, &X8 };
    var a: S8 = S8 { 1 };
    var b: S8 = S8 { 1 };
    var c: S8 = S8 { 1 };
    var d: S8 = S8 { 1 };
    var e: S8 = S8 { 1 };
    a = pw.p;
    b = GW8.p;
    c = mkw8().p;
    d = o.w.p;
    e = w.mp();
    poke();
    var r = (((rd8(a) * 100 + rd8(b)) * 100 + rd8(c)) * 100 + rd8(d)) * 100 + rd8(e);
    unpoke();
    return r;
}
fn c_chain_h() {
    var w = WH { 0, &XH };
    var pw: *WH = &w;
    var o = OH { 0, 0, &XH };
    var a: H = H { 1, 0 };
    var b: H = H { 1, 0 };
    var c: H = H { 1, 0 };
    var d: H = H { 1, 0 };
    var e: H = H { 1, 0 };
    a = pw.p;
    b = GWH.p;
    c = mkwh().p;
    d = o.w.p;
    e = w.mp();
    poke();
    var r = (((rdh(a) * 100 + rdh(b)) * 100 + rdh(c)) * 100 + rdh(d)) * 100 + rdh(e);
    unpoke();
    return r;
}
# a by-value parameter as the destination: the caller's struct is untouched -> 5811 (the callee's copy 58,
# the caller's 1 / 1)
fn pv8(l: S8): i64 { l = GP8; poke(); var r = rd8(l); unpoke(); return r; }
fn pvh(l: H): i64 { l = GPH; poke(); var r = rdh(l); unpoke(); return r; }
fn c_parm_8() { var l: S8 = S8 { 1 }; var r = pv8(l); return r * 100 + l.v * 10 + 1; }
fn c_parm_h() { var l: H = H { 1, 1 }; var r = pvh(l); return r * 100 + l.v * 10 + l.w; }
# a closure body, l its own
fn c_clos_8() {
    var f = |d| { var l: S8 = S8 { 1 }; l = GP8; poke(); var r = rd8(l); unpoke(); return r + d; };
    return callptr(f, 0);
}
fn c_clos_h() {
    var f = |d| { var l: H = H { 1, 0 }; l = GPH; poke(); var r = rdh(l); unpoke(); return r + d; };
    return callptr(f, 0);
}
# a classic-for step
fn c_for_8() {
    var l: S8 = S8 { 1 };
    var i = 0;
    for (i = 0; i < 1; l = gp8()) { i = i + 1; }
    poke();
    var r = rd8(l);
    unpoke();
    return r;
}
fn c_for_h() {
    var l: H = H { 1, 0 };
    var i = 0;
    for (i = 0; i < 1; l = gph()) { i = i + 1; }
    poke();
    var r = rdh(l);
    unpoke();
    return r;
}
# a #regalloc fn
#regalloc fn c_ra_8() { var l: S8 = S8 { 1 }; l = GP8; poke(); var r = rd8(l); unpoke(); return r; }
#regalloc fn c_ra_h() { var l: H = H { 1, 0 }; l = GPH; poke(); var r = rdh(l); unpoke(); return r; }

# ── rebinds (unchanged): a `*T` or handle destination is the one-word store ──
# q = GP through q: *S rebinds q: the write reaches X, not the caller's y -> 19 (y 1, X written 9)
fn qg8(q: *S8) { q = GP8; q.v = 9; return 0; }
fn qgh(q: *H) { q = GPH; q.v = 9; return 0; }
fn r_q_8() { var y: S8 = S8 { 1 }; qg8(&y); var r = y.v * 10 + X8.v; unpoke(); return r; }
fn r_q_h() { var y: H = H { 1, 0 }; qgh(&y); var r = y.v * 10 + XH.v; unpoke(); return r; }
# p = gp() into a *S local rebinds; h = GP into a handle rebinds -> 1919
fn r_p_8() {
    var y: S8 = S8 { 1 };
    var p: *S8 = &y;
    p = gp8();
    p.v = 9;
    var a = y.v * 10 + X8.v;
    unpoke();
    var h: S8 = alloc(8);
    h.v = 1;
    var hh = h;
    h = GP8;
    h.v = 9;
    var b = load64(hh) * 10 + X8.v;
    unpoke();
    return a * 100 + b;
}
fn r_p_h() {
    var y: H = H { 1, 0 };
    var p: *H = &y;
    p = gph();
    p.v = 9;
    var a = y.v * 10 + XH.v;
    unpoke();
    var h: H = alloc(16);
    h.v = 1;
    var hh = h;
    h = GPH;
    h.v = 9;
    var b = load64(hh) * 10 + XH.v;
    unpoke();
    return a * 100 + b;
}

# ── pointer arithmetic on a `*T` (ops-6): `l = p + 1`, `l = (p + 1)`, `l = 1 + p`, `l = GQ + 1`, `G = q - 1`
# copy the struct the result points at; they stored the pointer word into the first field at every size ──
var AR8[2];
var ARH[4];
var GQ8: *S8 = &AR8;
var GQH: *H = &ARH;
fn arm(): i64 {
    var p8: *S8 = &AR8;
    p8.v = 1;
    var e8: *S8 = p8 + 1;
    e8.v = 5;
    var ph: *H = &ARH;
    ph.v = 1;
    ph.w = 1;
    var eh: *H = ph + 1;
    eh.v = 5;
    eh.w = 8;
    return 0;
}
fn apoke(): i64 { var e8: *S8 = GQ8 + 1; e8.v = 6; var eh: *H = GQH + 1; eh.v = 6; return 0; }
fn c_ar_8() {
    arm();
    var p: *S8 = &AR8;
    var a: S8 = S8 { 1 };
    var b: S8 = S8 { 1 };
    var c: S8 = S8 { 1 };
    var d: S8 = S8 { 1 };
    a = p + 1;
    b = (p + 1);
    c = 1 + p;
    d = GQ8 + 1;
    apoke();
    var r = ((rd8(a) * 100 + rd8(b)) * 100 + rd8(c)) * 100 + rd8(d);
    arm();
    return r;
}
fn c_ar_h() {
    arm();
    var p: *H = &ARH;
    var a: H = H { 1, 0 };
    var b: H = H { 1, 0 };
    var c: H = H { 1, 0 };
    var d: H = H { 1, 0 };
    a = p + 1;
    b = (p + 1);
    c = 1 + p;
    d = GQH + 1;
    apoke();
    var r = ((rdh(a) * 100 + rdh(b)) * 100 + rdh(c)) * 100 + rdh(d);
    arm();
    return r;
}
fn c_arg_8() { arm(); var q: *S8 = GQ8 + 2; G8.v = 1; G8 = q - 1; apoke(); var r = rd8(G8); arm(); return r; }
fn c_arg_h() { arm(); var q: *H = GQH + 2; GH.v = 1; GH.w = 0; GH = q - 1; apoke(); var r = rdh(GH); arm(); return r; }
# a `*T` or handle destination still rebinds: q = p + 1 through a `*S` local, h = p + 1 into a handle -> 1919
fn r_ar_8() {
    arm();
    var p: *S8 = &AR8;
    var q: *S8 = p;
    q = p + 1;
    q.v = 9;
    var a = p.v * 10 + load64(GQ8 + 1);
    arm();
    var h: S8 = alloc(8);
    h.v = 1;
    var hh = h;
    h = p + 1;
    h.v = 9;
    var b = load64(hh) * 10 + load64(GQ8 + 1);
    arm();
    return a * 100 + b;
}
fn r_ar_h() {
    arm();
    var p: *H = &ARH;
    var q: *H = p;
    q = p + 1;
    q.v = 9;
    var e: *H = GQH + 1;
    var a = p.v * 10 + e.v;
    arm();
    var h: H = alloc(16);
    h.v = 1;
    var hh = h;
    h = p + 1;
    h.v = 9;
    var b = load64(hh) * 10 + e.v;
    arm();
    return a * 100 + b;
}

# ── sizes 1..7 B: a value global with a guard global packed right after it, and a local ──
struct Z1 { a: u8; }
struct Z2 { a: u16; }
struct Z3 { a: u8; b: u16; }
struct Z4 { a: u32; }
struct Z5 { a: u32; b: u8; }
struct Z6 { a: u32; b: u16; }
struct Z7 { a: u32; b: u16; c: u8; }
var Y1 = Z1 { 7 };
var Y2 = Z2 { 7 };
var Y3 = Z3 { 7, 5 };
var Y4 = Z4 { 7 };
var Y5 = Z5 { 7, 5 };
var Y6 = Z6 { 7, 5 };
var Y7 = Z7 { 7, 5, 3 };
var P1: *Z1 = &Y1;
var P2: *Z2 = &Y2;
var P3: *Z3 = &Y3;
var P4: *Z4 = &Y4;
var P5: *Z5 = &Y5;
var P6: *Z6 = &Y6;
var P7: *Z7 = &Y7;
fn q7(): *Z7 { return &Y7; }
var D1 = Z1 { 0 };
var D1g: u8 = 9;
var D2 = Z2 { 0 };
var D2g: u8 = 9;
var D3 = Z3 { 0, 0 };
var D3g: u8 = 9;
var D4 = Z4 { 0 };
var D4g: u8 = 9;
var D5 = Z5 { 0, 0 };
var D5g: u8 = 9;
var D6 = Z6 { 0, 0 };
var D6g: u8 = 9;
var D7 = Z7 { 0, 0, 0 };
var D7g: u8 = 9;
# each: the global and a local copied from the `*T` global, the guard 9 kept -> 3
fn s1() {
    D1 = P1;
    var l: Z1;
    l = P1;
    var k = 0;
    if (D1.a == 7) { if (l.a == 7) { k = k + 1; } } if (D1g == 9) { k = k + 2; } return k;
}
fn s2() {
    D2 = P2;
    var l: Z2;
    l = P2;
    var k = 0;
    if (D2.a == 7) { if (l.a == 7) { k = k + 1; } } if (D2g == 9) { k = k + 2; } return k;
}
fn s3() {
    D3 = P3;
    var l: Z3;
    l = P3;
    var k = 0;
    if (D3.a == 7) { if (D3.b == 5) { if (l.b == 5) { k = k + 1; } } }
    if (D3g == 9) { k = k + 2; }
    return k;
}
fn s4() {
    D4 = P4;
    var l: Z4;
    l = P4;
    var k = 0;
    if (D4.a == 7) { if (l.a == 7) { k = k + 1; } } if (D4g == 9) { k = k + 2; } return k;
}
fn s5() {
    D5 = P5;
    var l: Z5;
    l = P5;
    var k = 0;
    if (D5.a == 7) { if (D5.b == 5) { if (l.b == 5) { k = k + 1; } } }
    if (D5g == 9) { k = k + 2; }
    return k;
}
fn s6() {
    D6 = P6;
    var l: Z6;
    l = P6;
    var k = 0;
    if (D6.a == 7) { if (D6.b == 5) { if (l.b == 5) { k = k + 1; } } }
    if (D6g == 9) { k = k + 2; }
    return k;
}
fn s7() {
    D7 = q7();
    var l: Z7;
    l = P7;
    var k = 0;
    if (D7.a == 7) { if (D7.b == 5) { if (D7.c == 3) { if (l.c == 3) { k = k + 1; } } } }
    if (D7g == 9) { k = k + 2; }
    return k;
}

fn s7a() {
    D7.a = 0;
    D7 = P7 + 0;
    var l: Z7;
    l = 0 + P7;
    var k = 0;
    if (D7.a == 7) { if (D7.b == 5) { if (D7.c == 3) { if (l.c == 3) { k = k + 1; } } } }
    if (D7g == 9) { k = k + 2; }
    return k;
}

# ── top level: G = GP, G = gp(), G = W.p as statements ──
alloc_init();
var TT = S8 { 0 };
var TU = H { 0, 0 };
TT = GP8;
TU = gph();
X8.v = 6;
XH.v = 6;
var TA = rd8(TT);
var TB = rdh(TU);
unpoke();
TU = GWH.p;
XH.v = 7;
var TC = rdh(TU);
unpoke();
arm();
TT = GQ8 + 1;
TU = (GQH + 1);
apoke();
var TD = rd8(TT);
var TE = rdh(TU);
arm();

assert_eq(c_lgp_8(), 58, "l = GP (a *S global): a copy");
assert_eq(c_lgp_8(), c_lgp_h(), "  = its 16 B twin");
assert_eq(c_ggp_8(), 58, "G = GP into a value global");
assert_eq(c_ggp_8(), c_ggp_h(), "  = its 16 B twin");
assert_eq(c_lcall_8(), 58, "l = gp() (a : *S call)");
assert_eq(c_lcall_8(), c_lcall_h(), "  = its 16 B twin");
assert_eq(c_gcall_8(), 58, "G = gp()");
assert_eq(c_gcall_8(), c_gcall_h(), "  = its 16 B twin");
assert_eq(c_lfld_8(), 58, "l = w.p (a *S field)");
assert_eq(c_lfld_8(), c_lfld_h(), "  = its 16 B twin");
assert_eq(c_gfld_8(), 58, "G = w.p");
assert_eq(c_gfld_8(), c_gfld_h(), "  = its 16 B twin");
assert_eq(c_wrap_8(), 585858, "l = (GP), m = (gp()), k = ((w.p))");
assert_eq(c_wrap_8(), c_wrap_h(), "  = its 16 B twin");
assert_eq(c_chain_8(), 5858585858, "pw.p, GW.p, mkw().p, o.w.p, w.mp() (a : *S method)");
assert_eq(c_chain_8(), c_chain_h(), "  = its 16 B twin");
assert_eq(c_parm_8(), 5811, "l = GP into a by-value parameter: the callee's own copy");
assert_eq(c_parm_8(), c_parm_h(), "  = its 16 B twin");
assert_eq(c_clos_8(), 58, "l = GP in a closure body");
assert_eq(c_clos_8(), c_clos_h(), "  = its 16 B twin");
assert_eq(c_for_8(), 58, "l = gp() as a classic-for step");
assert_eq(c_for_8(), c_for_h(), "  = its 16 B twin");
assert_eq(c_ra_8(), 58, "l = GP in a #regalloc fn");
assert_eq(c_ra_8(), c_ra_h(), "  = its 16 B twin");
assert_eq(r_q_8(), 19, "q = GP through q: *S rebinds (unchanged)");
assert_eq(r_q_8(), r_q_h(), "  = its 16 B twin");
assert_eq(r_p_8(), 1919, "p = gp() into a *S local and h = GP into a handle rebind (unchanged)");
assert_eq(r_p_8(), r_p_h(), "  = its 16 B twin");
assert_eq(c_ar_8(), 58585858, "l = p + 1, (p + 1), 1 + p, GQ + 1: pointer arithmetic on a *S (ops-6)");
assert_eq(c_ar_8(), c_ar_h(), "  = its 16 B twin");
assert_eq(c_arg_8(), 58, "G = q - 1 into a value global");
assert_eq(c_arg_8(), c_arg_h(), "  = its 16 B twin");
assert_eq(r_ar_8(), 1919, "q = p + 1 into a *S local and h = p + 1 into a handle rebind (unchanged)");
assert_eq(r_ar_8(), r_ar_h(), "  = its 16 B twin");
assert_eq(s1(), 3, "1 B: G = P, l = P; the guard kept");
assert_eq(s2(), 3, "2 B: G = P, l = P; the guard kept");
assert_eq(s3(), 3, "3 B: G = P, l = P; the guard kept");
assert_eq(s4(), 3, "4 B: G = P, l = P; the guard kept");
assert_eq(s5(), 3, "5 B: G = P, l = P; the guard kept");
assert_eq(s6(), 3, "6 B: G = P, l = P; the guard kept");
assert_eq(s7(), 3, "7 B: G = q7(), l = P; the guard kept");
assert_eq(s7a(), 3, "7 B: G = P + 0, l = 0 + P; the guard kept");
assert_eq(TA, 58, "top level: G = GP");
assert_eq(TB, 58, "top level: G = gp() (16 B)");
assert_eq(TC, 58, "top level: G = GW.p (16 B)");
assert_eq(TD, 58, "top level: G = GQ + 1");
assert_eq(TE, 58, "top level: G = (GQ + 1) (16 B)");
var r = assert_summary();
