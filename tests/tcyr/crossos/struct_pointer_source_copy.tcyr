    funpoke();
    if (fgh(&a, &b, &c, &d, &e) == 0) { return 0 - 1; }
    return r;
}
fn fp_t() {
    var w = WT { 0, &XT };
    var a: FT; var b: FT; var c: FT; var d: FT; var e: FT;
    fzt(&a); fzt(&b); fzt(&c); fzt(&d); fzt(&e);
    var pa: *FT = &a; var pb: *FT = &b; var pc: *FT = &c; var pd: *FT = &d; var pe: *FT = &e;
    pa.s = GPT;
    pb.s = gpt();
    pc.s = w.p;
    pd.s = GPT + 0;
    pe.s = (gpt());
    fpoke();
    var r = (((rdt(a.s) * 1000 + rdt(b.s)) * 1000 + rdt(c.s)) * 1000 + rdt(d.s)) * 1000 + rdt(e.s);
    funpoke();
    if (fgt(&a, &b, &c, &d, &e) == 0) { return 0 - 1; }
    return r;
}
# a classic-for step `o.s = GP` (the source ends at the for's `)`) -> 58 / 58 / 583
fn ff_8() {
    var o: F8;
    fz8(&o);
    var i = 0;
    for (i = 0; i < 1; o.s = GP8) { i = i + 1; }
    fpoke();
    var r = rd8(o.s);
    funpoke();
    return r;
}
fn ff_h() {
    var o: FH;
    fzh(&o);
    var i = 0;
    for (i = 0; i < 1; o.s = (gph())) { i = i + 1; }
    fpoke();
    var r = rdh(o.s);
    funpoke();
    return r;
}
fn ff_t() {
    var o: FT;
    fzt(&o);
    var i = 0;
    for (i = 0; i < 1; o.s = GPT + 0) { i = i + 1; }
    fpoke();
    var r = rdt(o.s);
    funpoke();
    return r;
}

# ── top level: G = GP, G = gp(), G = W.p as statements ──
alloc_init();
var TT = S8 { 0 };
var TU = H { 0, 0 };
TT = GP8;
TU = gph();
X8.v = 6;
XH.v = 6;
var TA = rd8(TT);
var TB = rdh(TU);
unpoke();
TU = GWH.p;
XH.v = 7;
var TC = rdh(TU);
unpoke();
arm();
TT = GQ8 + 1;
TU = (GQH + 1);
apoke();
var TD = rd8(TT);
var TE = rdh(TU);
arm();
# top level, 6.7.11: a struct-typed field destination from the five sources, direct and through a `*O`
var TW8 = W8 { 0, &X8 };
var TWH = WH { 0, &XH };
var TWT = WT { 0, &XT };
var TFA = F8 { 9, 1, 9 };
var TFB = F8 { 9, 1, 9 };
var TFC = F8 { 9, 1, 9 };
var TFD = F8 { 9, 1, 9 };
var TFE = F8 { 9, 1, 9 };
var THA = FH { 9, 1, 0, 9 };
var THB = FH { 9, 1, 0, 9 };
var THC = FH { 9, 1, 0, 9 };
var THD = FH { 9, 1, 0, 9 };
var THE = FH { 9, 1, 0, 9 };
var TTA = FT { 9, 1, 0, 0, 9 };
var TTB = FT { 9, 1, 0, 0, 9 };
var TTC = FT { 9, 1, 0, 0, 9 };
var TTD = FT { 9, 1, 0, 0, 9 };
var TTE = FT { 9, 1, 0, 0, 9 };
var TPA: *F8 = &TFA;
var TPB: *FH = &THB;
var TPC: *FT = &TTC;
TPA.s = GP8;
TFB.s = gp8();
TFC.s = TW8.p;
TFD.s = GP8 + 0;
TFE.s = (gp8());
THA.s = GPH;
TPB.s = gph();
THC.s = TWH.p;
THD.s = GPH + 0;
THE.s = (gph());
TTA.s = GPT;
TTB.s = gpt();
TPC.s = TWT.p;
TTD.s = GPT + 0;
TTE.s = (gpt());
fpoke();
var TF8 = ((rd8(TFA.s) * 100 + rd8(TFB.s)) * 100 + rd8(TFC.s)) * 100;
TF8 = (TF8 + rd8(TFD.s)) * 100 + rd8(TFE.s);
var TFH = ((rdh(THA.s) * 100 + rdh(THB.s)) * 100 + rdh(THC.s)) * 100;
TFH = (TFH + rdh(THD.s)) * 100 + rdh(THE.s);
var TFT = ((rdt(TTA.s) * 1000 + rdt(TTB.s)) * 1000 + rdt(TTC.s)) * 1000;
TFT = (TFT + rdt(TTD.s)) * 1000 + rdt(TTE.s);
funpoke();
var TFG = fg8(&TFA, &TFB, &TFC, &TFD, &TFE) + fgh(&THA, &THB, &THC, &THD, &THE);
TFG = TFG + fgt(&TTA, &TTB, &TTC, &TTD, &TTE);

