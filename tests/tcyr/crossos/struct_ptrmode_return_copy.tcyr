# struct_ptrmode_return_copy.tcyr — 6.6.17 (a1). `return p;` from a by-value struct fn, where `p`
# is a HANDLE (a pointer-mode local: `var p: Pt = alloc(16);`), returns the struct p points at.
#
# ⛔ THE DEFECT, every release through 6.6.16. Both return arms of PARSE_RETURN address the
# returned local's SLOTS — the 9-16 B rax:rdx load and the >16 B byte copy into the retptr — and a
# handle's slot holds the struct's ADDRESS. So `q.x` read a heap address and the other fields read
# neighbouring frame words: `mk2(10)` gave {140448913948680, 10} where {10, 11} is right, on x86,
# aarch64, PE and (>16 B) cx alike. 6.6.16 (C2) made `q = a` copy through a handle; the `return`
# path was missed. A `*T` parameter (already copied through, 6.6.6) and an 8 B struct (held by
# value) are the controls: they were right before and must stay right.
#
# Each subject is checked against hand-computed constants, and a copy is told from an alias by a
# WRITE to the heap object after the return (the returned value must not move).
# CROSS-HOST: the copy is the per-chunk address + load/store every backend emits.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/assert.cyr"

struct P1 { x; }                     # 8 B — held by value (control)
struct P2 { x; y; }                  # 16 B — the rax:rdx pair class
struct O12 { a: i64; b: i32; }       # 12 B — pair class, odd tail
struct P3 { x; y; z; }               # 24 B — the retptr class
struct O20 { a; b; c: i32; }         # 20 B — retptr class, odd tail

var GHP = 0;                         # the last handle a maker allocated (for the alias rows)

fn mk1(n): P1 { var p: P1 = alloc(8); p.x = n; return p; }
fn mk2(n): P2 { var p: P2 = alloc(16); p.x = n; p.y = n + 1; GHP = p; return p; }
fn mk12(n): O12 { var p: O12 = alloc(16); p.a = n; p.b = n + 1; return p; }
fn mk3(n): P3 { var p: P3 = alloc(24); p.x = n; p.y = n + 1; p.z = n + 2; GHP = p; return p; }
fn mk20(n): O20 { var p: O20 = alloc(24); p.a = n; p.b = n + 1; p.c = n + 2; return p; }
# A handle that came from somewhere other than alloc: another handle (rebind) and a call.
fn src2(n): i64 { var p: P2 = alloc(16); p.x = n; p.y = n * 2; return p; }
fn via2(n): P2 { var h: P2 = alloc(16); var p: P2 = src2(n); h = p; return h; }
fn P2_twice(self: P2): P2 { var p: P2 = alloc(16); p.x = self.x * 2; p.y = self.y * 2; return p; }
fn P3_twice(self: P3): P3 { var p: P3 = alloc(24); p.x = self.x * 2; p.y = self.y * 2; p.z = self.z * 2; return p; }
# Controls: a `*T` parameter returned by value (copied through since 6.6.6).
fn fw2(p: *P2): P2 { return p; }
fn fw3(p: *P3): P3 { return p; }
# ...and the class of 8 B or less, which returns the VALUE in rax: `return p;` handed back the
# ADDRESS there (6.6.17 review) — fixed by `_ret_small_ptrp`. B6 is 6 bytes (copied 4 + 2).
struct B8 { v; }
struct B4 { a: i32; }
struct B6 { a: i32; b: i16; }
fn fw8(p: *B8): B8 { return p; }
fn fw4(p: *B4): B4 { return p; }
fn fw6(p: *B6): B6 { return p; }

fn t_p1() { var a: P1 = mk1(7); return a.x; }
fn t_p2() { var b: P2 = mk2(10); return b.x * 100 + b.y; }
fn t_p2_noalias() { var b: P2 = mk2(10); store64(GHP, 55); return b.x; }
fn t_p2_assign() { var b: P2; b.x = 1; b.y = 1; b = mk2(30); return b.x * 100 + b.y; }
fn t_o12() { var b: O12 = mk12(4); return b.a * 10 + b.b; }
fn t_p3() { var c: P3 = mk3(20); return c.x * 10000 + c.y * 100 + c.z; }
fn t_p3_noalias() { var c: P3 = mk3(20); store64(GHP + 8, 77); return c.y; }
fn t_p3_assign() { var c: P3; c.x = 1; c.y = 1; c.z = 1; c = mk3(40); return c.x * 10000 + c.y * 100 + c.z; }
fn t_o20() { var c: O20 = mk20(5); return c.a * 100 + c.b * 10 + c.c; }
fn t_via2() { var b: P2 = via2(6); return b.x * 100 + b.y; }
fn t_m2() { var s: P2; s.x = 3; s.y = 4; var b: P2 = s.twice(); return b.x * 100 + b.y; }
fn t_m3() { var s: P3; s.x = 1; s.y = 2; s.z = 3; var c: P3 = s.twice(); return c.x * 10000 + c.y * 100 + c.z; }
fn t_fw2() { var s: P2; s.x = 8; s.y = 9; var b: P2 = fw2(&s); s.x = 0; return b.x * 100 + b.y; }
fn t_fw3() { var s: P3; s.x = 1; s.y = 2; s.z = 3; var c: P3 = fw3(&s); s.y = 0; return c.x * 10000 + c.y * 100 + c.z; }
fn t_fw8() { var s: B8; s.v = 5; var c: B8 = fw8(&s); s.v = 0; return c.v; }
fn t_fw4() { var s: B4; s.a = 0 - 7; var c: B4 = fw4(&s); s.a = 0; return c.a; }
fn t_fw6() { var s: B6; s.a = 300; s.b = 0 - 2; var c: B6 = fw6(&s); s.a = 0; return c.a * 10 + c.b; }

alloc_init();
assert_eq(t_p1(), 7, "8 B handle-shaped local returns its value (control)");
assert_eq(t_p2(), 1011, "16 B handle returned by value: {10, 11}");
assert_eq(t_p2_noalias(), 10, "16 B: the returned value is a copy, not the heap object");
assert_eq(t_p2_assign(), 3031, "16 B: `b = mk2(..)` assignment receive");
assert_eq(t_o12(), 45, "12 B (odd tail) handle returned by value: {4, 5}");
assert_eq(t_p3(), 202122, "24 B handle returned through the retptr: {20, 21, 22}");
assert_eq(t_p3_noalias(), 21, "24 B: the returned value is a copy, not the heap object");
assert_eq(t_p3_assign(), 404142, "24 B: `c = mk3(..)` assignment receive");
assert_eq(t_o20(), 567, "20 B (odd tail) handle returned through the retptr: {5, 6, 7}");
assert_eq(t_via2(), 612, "16 B handle rebound from another handle, then returned");
assert_eq(t_m2(), 608, "method returning a 16 B handle by value");
assert_eq(t_m3(), 20406, "method returning a 24 B handle by value");
assert_eq(t_fw2(), 809, "control: a 16 B `*T` parameter returned by value");
assert_eq(t_fw3(), 10203, "control: a 24 B `*T` parameter returned by value");
assert_eq(t_fw8(), 5, "an 8 B `*T` parameter returned by value is its struct, not its address");
assert_eq(t_fw4(), 0 - 7, "a 4 B `*T` parameter returned by value (signed i32 field)");
assert_eq(t_fw6(), 2998, "a 6 B `*T` parameter returned by value: {300, -2}");
var r = assert_summary();
