# struct_receive_paren_call.tcyr — 6.7.11. PARENTHESES AROUND A WHOLE STRUCT-RETURNING CALL ARE
# TRANSPARENT TO AN UNTYPED DECLARATION: `var x = (mk());` RECEIVES THE STRUCT AS `var x = mk();` DOES.
#
# ⛔ THE DEFECT (issues/archived/2026-10-10-struct-receive-inference-paren-call-and-scalar-annotation.md, shape
# (a)). PARSE_VAR's struct receive looked for `IDENT (` right after `=`, so a call wrapped in
# parentheses inferred nothing: x was an i64 holding the struct's FIRST word (3), and `dq(x)` into a
# by-value `q: Q` parameter passed 3 as the struct's address — SIGSEGV on x86_64 and aarch64, a guest
# error (1) on cx, 5 on PE. The receive now judges the call inside the wrap (`_rcv_peel`) and the typed
# path's `_scv_peel` takes it, as it already did for `var x: Q = (mk());`.
#
# ⚠ WHY crossos/: the receive is per-backend (the 9-16 B pair registers, the > 16 B hidden retptr);
# this file runs on pi, ecb, ach and cass at the release gate, and on x86_64 / qemu-aarch64 / cxvm /
# wine in tests/gates/frontend/struct_receive_inference_checked.sh (with shape (b)'s refusals and the
# mutation ledger).
#
# Every value reads back as 34 (a * 10 + b, the 24 B struct's third word folded in), so a first word
# alone, a swapped pair or an address all miss.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/assert.cyr"

struct Q { a; b; }
struct Q3 { a; b; c; }
struct Bx<T> { a: T; b: T; }

fn mk(): Q { var q: Q; q.a = 3; q.b = 4; return q; }
fn mk3(): Q3 { var q: Q3; q.a = 3; q.b = 4; q.c = 7; return q; }
fn mkv(v): Q { var q: Q; q.a = v; q.b = v + 1; return q; }
fn mkg<T>(v: T): Bx<T> { var b: Bx<T>; b.a = v; b.b = v + 1; return b; }
fn dq(q: Q): i64 { return q.a * 10 + q.b; }
fn dq3(q: Q3): i64 { return q.a * 10 + q.b + q.c - 7; }
fn dbx(b: Bx<i64>): i64 { return b.a * 10 + b.b; }

# --- fn scope, 9-16 B (the rax:rdx pair) ---
fn p16(): i64 { var x = (mk()); return dq(x); }
fn p16_2(): i64 { var x = ((mk())); return dq(x); }
fn p16_fields(): i64 { var x = (mk()); return x.a * 10 + x.b; }
fn p16_arg(v): i64 { var x = (mkv(v)); return dq(x); }
fn p16_gen(): i64 { var x = (mkg<i64>(3)); return dbx(x); }
# --- fn scope, > 16 B (the hidden retptr) ---
fn p24(): i64 { var x = (mk3()); return dq3(x); }
fn p24_2(): i64 { var x = ((mk3())); return dq3(x); }
fn p24_fields(): i64 { var x = (mk3()); return x.a * 10 + x.b + x.c - 7; }
# --- in a closure ---
fn c16(): i64 { var f = |k| { var x = (mk()); return dq(x) + k; }; return fncall1(f, 0); }
fn c16_2(): i64 { var f = |k| { var x = ((mk())); return dq(x) + k; }; return fncall1(f, 0); }
fn c24(): i64 { var f = |k| { var x = (mk3()); return dq3(x) + k; }; return fncall1(f, 0); }
fn c24_2(): i64 { var f = |k| { var x = ((mk3())); return dq3(x) + k; }; return fncall1(f, 0); }
# --- the controls: unwrapped, and the typed wrap ---
fn u16(): i64 { var x = mk(); return dq(x); }
fn u24(): i64 { var x = mk3(); return dq3(x); }
fn t16(): i64 { var x: Q = (mk()); return dq(x); }
fn t24(): i64 { var x: Q3 = ((mk3())); return dq3(x); }
# --- two receives in a row: the second must not see the first's temp ---
fn twice(): i64 { var x = (mk()); var y = (mkv(5)); return dq(x) + dq(y) - 56; }
# --- 6.7.13: 8 B and less (issues/archived/2026-10-14-paren-wrapped-call-untyped-receive-8b-call-and-16b-method.md) ---
# `var x = (mk1());` inferred nothing: `x.a` was "no struct type in scope for 'x'" (an 8 B result is its
# word, so `d1(x)` was right). The wrap is transparent (`_var_rhs_wsid`), as decision 12 / D42 bind a
# whole struct result at every size. The 16 B METHOD half (`(b.mk())`, 139 through 6.7.10) pins D42.
struct P1 { a; }
struct P8 { a: u32; b: u32; }
struct G1<T> { v: T; }
impl Q { fn mkm(self): Q { var q: Q; q.a = 3; q.b = 4; return q; } }
fn mk1(): P1 { var p: P1; p.a = 33; return p; }
fn mk8(): P8 { var p: P8; p.a = 30; p.b = 3; return p; }
fn mkg1<T>(v: T): G1<T> { var g: G1<T>; g.v = v; return g; }
fn d1(p: P1): i64 { return p.a; }
fn fh(): f64 { return 2.5; }
fn w8(): i64 { var x = (mk1()); return x.a; }
fn w8_2(): i64 { var x = ((mk1())); return x.a; }
fn w8_gen(): i64 { var x = (mkg1(33)); return x.v; }
fn w8_u32(): i64 { var x = (mk8()); return x.a + x.b; }
fn w8_arg(): i64 { var x = (mk1()); return d1(x); }
fn w8_cl(): i64 { var f = |k| { var x = (mk1()); return x.a + k; }; return fncall1(f, 0); }
fn w16_m(): i64 { var b = Q { 1, 2 }; var x = (b.mkm()); return dq(x); }
fn wf64(): i64 { var x = (fh()); var y = x + 1.0; var z = fh() + 1.0; if (y == z) { return 1; } return 0; }
fn wexpr(): i64 { var x = (1 + 2); return x; }
# 6.7.14 (issues/2026-10-16-paren-wrapped-f64-call-leading-operator-untyped.md): `var a = (f()) * 2.0;` was an untyped word
# holding the product's bits, where `f() * 2.0` is an f64 — `a + 1.5` then added integers. The wrapped leading `: f64`
# call types the binding as the unwrapped one does, while the whole initialiser is still an f64: a comparison and
# 6.7.13 D12's `& | ^ % << >>` stay integers (`-c` integer negation, `b - 1` integer subtraction).
fn wf64_op(): i64 { var a = (fh()) * 2.0; var y = a + 1.5; return f64_to(y); }
fn wf64_2(): i64 { var a = ((fh())) + 1.0; var y = a + 1.5; return f64_to(y); }
fn wf64_lt(): i64 { var c = (fh()) * 2.0 < 1.0; return -c; }
fn wf64_gt(): i64 { var c = ((fh())) * 2.0 > 1.0; return -c; }
fn wf64_and(): i64 { var b = (fh()) & 1; return b - 1; }
# --- 6.7.14: a `Str` handle (issues/2026-10-16-paren-wrapped-str-call-untyped-receive-is-a-word.md) ---
# `var s = (mks());` with `mks(): Str` bound an untyped word, where `var t = mks();` is a Str (v5.10.4): `println(s)`
# took the cstring overload and printed the header's bytes, `s.len()` was "no struct type in scope for 's'". The
# wrapped Str is typed as the unwrapped one is (`_var_rhs_wsid`). `who` routes on the argument's type: 2 = a Str.
fn mks(): Str { return str_from("abcde"); }
fn who(s: cstring): i64 { return 1; }
fn who_str(s: Str): i64 { return 2; }
fn who_int(n: i64): i64 { return 3; }
fn ws(): i64 { var s = (mks()); return s.len(); }
fn ws_2(): i64 { var s = ((mks())); return s.len(); }
fn ws_fn(): i64 { var s = (mks()); var t = ((mks())); return str_len(s) * 10 + str_len(t); }
fn ws_ov(): i64 { var s = (mks()); var t = ((mks())); return who(s) * 10 + who(t); }
fn ws_cl(): i64 { var f = |k| { var s = (mks()); return s.len() + k; }; return fncall1(f, 0); }
fn ws_u(): i64 { var t = mks(); return who(t) * 10 + t.len(); }
# --- 6.7.14 (the user's decision D24 (a), 2026-10-16): a `.field` / `.m()` AFTER the parentheses ---
# `(s).a` and `(mk1()).a` were "expected ';', got '.'": the parenthesised factor returned at its `)`. The wrap
# around a struct value is transparent there too (issues/2026-10-16-field-of-parenthesised-expression-does-not-
# parse.md): a name, a `*T` and `*p`, a free call (8 / 16 / 24 B, `Str`), a method, an operator, a known `&f`, a
# struct-typed field, a `: *T` call — and a `.m()` / a chain on any of them, as a value and as a statement.
struct QO { a; b; }
struct HQ { n; q: Q; }
impl P1 { fn m(self): i64 { return self.a + 1; } }
fn QO_add(x: QO, y: QO): QO { var r: QO; r.a = x.a + y.a; r.b = x.b + y.b; return r; }
var GQ = Q { 3, 4 };
var GP1 = P1 { 33 };
fn gq(): *Q { return &GQ; }
fn pf_name(): i64 { var s = P1 { 33 }; return (s).a; }
fn pf_name2(): i64 { var s = P1 { 33 }; return ((s)).a; }
fn pf_ptr(): i64 { var s = P1 { 33 }; var p: *P1 = &s; return (p).a; }
fn pf_deref(): i64 { var s = P1 { 33 }; var p: *P1 = &s; return (*p).a; }
fn pf_meth(): i64 { var s = P1 { 32 }; return (s).m(); }
fn pf_c8(): i64 { return (mk1()).a; }
fn pf_c16(): i64 { return (mk()).a * 10 + ((mk())).b; }
fn pf_c24(): i64 { return (mk3()).a * 10 + (mk3()).b + (mk3()).c - 7; }
fn pf_m16(): i64 { var b = Q { 1, 2 }; return (b.mkm()).a * 10 + (b.mkm()).b; }
fn pf_op(): i64 { var x = QO { 1, 2 }; var y = QO { 2, 2 }; return (x + y).a * 10 + (x + y).b; }
fn pf_fld(): i64 { var h: HQ; h.n = 1; h.q.a = 3; h.q.b = 4; return (h.q).a * 10 + ((h).q).b; }
fn pf_gptr(): i64 { return (gq()).a * 10 + (gq()).b; }
fn pf_icall(): i64 { return (fncall0(&mk3)).a * 10 + (callptr(&mk3)).b + (fncall0(&mk3)).c - 7; }
fn pf_str(): i64 { return (mks()).len(); }
fn pf_glob(): i64 { return (GP1).a; }
fn pf_chain(): i64 { var b = Q { 1, 2 }; return (b).mkm().a * 10 + (b.mkm()).mkm().b; }
fn pf_stmt(): i64 { var s = P1 { 32 }; (s).m(); (mk1()).a; return (s).a + 1; }
fn pf_cl(): i64 { var f = |k| { var s = P1 { 33 }; return (s).a + k; }; return fncall1(f, 0); }
fn pf_recv(): i64 { var b = Q { 1, 2 }; var x: Q = (b).mkm(); return dq(x); }
var GPF = (GP1).a;

test_group("var x = (mk()); — 9-16 B, fn scope");
assert_eq(p16(), 34, "(mk()) into a by-value parameter");
assert_eq(p16_2(), 34, "((mk())) into a by-value parameter");
assert_eq(p16_fields(), 34, "(mk()) then x.a / x.b");
assert_eq(p16_arg(3), 34, "(mkv(3)), a call with an argument");
assert_eq(p16_gen(), 34, "(mkg<i64>(3)), a generic instance's struct");
test_group("var x = (mk3()); — > 16 B, fn scope");
assert_eq(p24(), 34, "(mk3()) into a by-value parameter");
assert_eq(p24_2(), 34, "((mk3())) into a by-value parameter");
assert_eq(p24_fields(), 34, "(mk3()) then x.a / x.b / x.c");
test_group("in a closure");
assert_eq(c16(), 34, "(mk()) in a closure");
assert_eq(c16_2(), 34, "((mk())) in a closure");
assert_eq(c24(), 34, "(mk3()) in a closure");
assert_eq(c24_2(), 34, "((mk3())) in a closure");
test_group("controls");
assert_eq(u16(), 34, "var x = mk(); (unwrapped)");
assert_eq(u24(), 34, "var x = mk3(); (unwrapped)");
assert_eq(t16(), 34, "var x: Q = (mk()); (typed)");
assert_eq(t24(), 34, "var x: Q3 = ((mk3())); (typed)");
assert_eq(twice(), 34, "two wrapped receives in a row");
test_group("6.7.13: 8 B and less, and the 16 B method");
assert_eq(w8(), 33, "var x = (mk1()); x.a (8 B: refused at x.a before)");
assert_eq(w8_2(), 33, "var x = ((mk1())); x.a");
assert_eq(w8_gen(), 33, "var x = (mkg1(33)); an inferred generic's 8 B struct");
assert_eq(w8_u32(), 33, "var x = (mk8()); two u32 fields");
assert_eq(w8_arg(), 33, "var x = (mk1()); d1(x) by value");
assert_eq(w8_cl(), 33, "var x = (mk1()); in a closure");
assert_eq(w16_m(), 34, "var x = (b.mkm()); dq(x), a 16 B method (D42: 139 through 6.7.10)");
assert_eq(wf64(), 1, "var x = (fh()); a : f64 call types x f64, as var x = fh(); does");
assert_eq(wexpr(), 3, "var x = (1 + 2); stays an untyped 3");
test_group("6.7.14: a wrapped f64 call before an operator");
assert_eq(wf64_op(), 6, "var a = (fh()) * 2.0; is an f64 (the filed repro's shape: 0 before)");
assert_eq(wf64_2(), 5, "var a = ((fh())) + 1.0; is an f64");
assert_eq(wf64_lt(), 0, "var c = (fh()) * 2.0 < 1.0; stays an integer 0 (-c is not -0.0)");
assert_eq(wf64_gt(), 0 - 1, "var c = ((fh())) * 2.0 > 1.0; stays an integer 1");
assert_eq(wf64_and(), 0 - 1, "var b = (fh()) & 1; stays an integer (D12)");
test_group("6.7.14: a Str handle");
assert_eq(ws(), 5, "var s = (mks()); s.len() (refused before)");
assert_eq(ws_2(), 5, "var s = ((mks())); s.len()");
assert_eq(ws_fn(), 55, "(mks()) / ((mks())) then str_len(s)");
assert_eq(ws_ov(), 22, "(mks()) / ((mks())) route to who_str (11 before: the cstring base)");
assert_eq(ws_cl(), 5, "var s = (mks()); in a closure");
assert_eq(ws_u(), 25, "control: var t = mks(); (unwrapped)");

test_group("6.7.14 (D24): a .field / .m() after the parentheses");
assert_eq(pf_name(), 33, "(s).a (the filed repro's shape)");
assert_eq(pf_name2(), 33, "((s)).a");
assert_eq(pf_ptr(), 33, "(p).a, p a *P1");
assert_eq(pf_deref(), 33, "(*p).a");
assert_eq(pf_meth(), 33, "(s).m()");
assert_eq(pf_c8(), 33, "(mk1()).a, 8 B");
assert_eq(pf_c16(), 34, "(mk()).a / ((mk())).b, 16 B");
assert_eq(pf_c24(), 34, "(mk3()).a / .b / .c, 24 B (a temp)");
assert_eq(pf_m16(), 34, "(b.mkm()).a, a method's result");
assert_eq(pf_op(), 34, "(x + y).a, an operator's result");
assert_eq(pf_fld(), 34, "(h.q).a / ((h).q).b, a struct-typed field");
assert_eq(pf_gptr(), 34, "(gq()).a, a : *Q call");
assert_eq(pf_icall(), 34, "(fncall0(&mk3)).a / (callptr(&mk3)).b, a known callee");
assert_eq(pf_str(), 5, "(mks()).len(), a Str");
assert_eq(pf_glob(), 33, "(GP1).a, a global");
assert_eq(pf_chain(), 34, "(b).mkm().a / (b.mkm()).mkm().b, chains");
assert_eq(pf_stmt(), 33, "(s).m(); (mk1()).a; as statements");
assert_eq(pf_cl(), 33, "(s).a in a closure");
assert_eq(pf_recv(), 34, "var x: Q = (b).mkm(); a struct destination");
assert_eq(GPF, 33, "var GPF = (GP1).a; at top level");

var r = assert_summary();
