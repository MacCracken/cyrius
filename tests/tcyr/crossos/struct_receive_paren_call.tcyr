# struct_receive_paren_call.tcyr — 6.7.11. PARENTHESES AROUND A WHOLE STRUCT-RETURNING CALL ARE
# TRANSPARENT TO AN UNTYPED DECLARATION: `var x = (mk());` RECEIVES THE STRUCT AS `var x = mk();` DOES.
#
# ⛔ THE DEFECT (issues/archived/2026-10-10-struct-receive-inference-paren-call-and-scalar-annotation.md, shape
# (a)). PARSE_VAR's struct receive looked for `IDENT (` right after `=`, so a call wrapped in
# parentheses inferred nothing: x was an i64 holding the struct's FIRST word (3), and `dq(x)` into a
# by-value `q: Q` parameter passed 3 as the struct's address — SIGSEGV on x86_64 and aarch64, a guest
# error (1) on cx, 5 on PE. The receive now judges the call inside the wrap (`_rcv_peel`) and the typed
# path's `_scv_peel` takes it, as it already did for `var x: Q = (mk());`.
#
# ⚠ WHY crossos/: the receive is per-backend (the 9-16 B pair registers, the > 16 B hidden retptr);
# this file runs on pi, ecb, ach and cass at the release gate, and on x86_64 / qemu-aarch64 / cxvm /
# wine in tests/gates/frontend/struct_receive_inference_checked.sh (with shape (b)'s refusals and the
# mutation ledger).
#
# Every value reads back as 34 (a * 10 + b, the 24 B struct's third word folded in), so a first word
# alone, a swapped pair or an address all miss.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/assert.cyr"

struct Q { a; b; }
struct Q3 { a; b; c; }
struct Bx<T> { a: T; b: T; }

fn mk(): Q { var q: Q; q.a = 3; q.b = 4; return q; }
fn mk3(): Q3 { var q: Q3; q.a = 3; q.b = 4; q.c = 7; return q; }
fn mkv(v): Q { var q: Q; q.a = v; q.b = v + 1; return q; }
fn mkg<T>(v: T): Bx<T> { var b: Bx<T>; b.a = v; b.b = v + 1; return b; }
fn dq(q: Q): i64 { return q.a * 10 + q.b; }
fn dq3(q: Q3): i64 { return q.a * 10 + q.b + q.c - 7; }
fn dbx(b: Bx<i64>): i64 { return b.a * 10 + b.b; }

# --- fn scope, 9-16 B (the rax:rdx pair) ---
fn p16(): i64 { var x = (mk()); return dq(x); }
fn p16_2(): i64 { var x = ((mk())); return dq(x); }
fn p16_fields(): i64 { var x = (mk()); return x.a * 10 + x.b; }
fn p16_arg(v): i64 { var x = (mkv(v)); return dq(x); }
fn p16_gen(): i64 { var x = (mkg<i64>(3)); return dbx(x); }
# --- fn scope, > 16 B (the hidden retptr) ---
fn p24(): i64 { var x = (mk3()); return dq3(x); }
fn p24_2(): i64 { var x = ((mk3())); return dq3(x); }
fn p24_fields(): i64 { var x = (mk3()); return x.a * 10 + x.b + x.c - 7; }
# --- in a closure ---
fn c16(): i64 { var f = |k| { var x = (mk()); return dq(x) + k; }; return fncall1(f, 0); }
fn c16_2(): i64 { var f = |k| { var x = ((mk())); return dq(x) + k; }; return fncall1(f, 0); }
fn c24(): i64 { var f = |k| { var x = (mk3()); return dq3(x) + k; }; return fncall1(f, 0); }
fn c24_2(): i64 { var f = |k| { var x = ((mk3())); return dq3(x) + k; }; return fncall1(f, 0); }
# --- the controls: unwrapped, and the typed wrap ---
fn u16(): i64 { var x = mk(); return dq(x); }
fn u24(): i64 { var x = mk3(); return dq3(x); }
fn t16(): i64 { var x: Q = (mk()); return dq(x); }
fn t24(): i64 { var x: Q3 = ((mk3())); return dq3(x); }
# --- two receives in a row: the second must not see the first's temp ---
fn twice(): i64 { var x = (mk()); var y = (mkv(5)); return dq(x) + dq(y) - 56; }
# --- 6.7.13: 8 B and less (issues/archived/2026-10-14-paren-wrapped-call-untyped-receive-8b-call-and-16b-method.md) ---
# `var x = (mk1());` inferred nothing: `x.a` was "no struct type in scope for 'x'" (an 8 B result is its
# word, so `d1(x)` was right). The wrap is transparent (`_var_rhs_wsid`), as decision 12 / D42 bind a
# whole struct result at every size. The 16 B METHOD half (`(b.mk())`, 139 through 6.7.10) pins D42.
struct P1 { a; }
struct P8 { a: u32; b: u32; }
struct G1<T> { v: T; }
impl Q { fn mkm(self): Q { var q: Q; q.a = 3; q.b = 4; return q; } }
fn mk1(): P1 { var p: P1; p.a = 33; return p; }
fn mk8(): P8 { var p: P8; p.a = 30; p.b = 3; return p; }
fn mkg1<T>(v: T): G1<T> { var g: G1<T>; g.v = v; return g; }
fn d1(p: P1): i64 { return p.a; }
fn fh(): f64 { return 2.5; }
fn w8(): i64 { var x = (mk1()); return x.a; }
fn w8_2(): i64 { var x = ((mk1())); return x.a; }
fn w8_gen(): i64 { var x = (mkg1(33)); return x.v; }
fn w8_u32(): i64 { var x = (mk8()); return x.a + x.b; }
fn w8_arg(): i64 { var x = (mk1()); return d1(x); }
fn w8_cl(): i64 { var f = |k| { var x = (mk1()); return x.a + k; }; return fncall1(f, 0); }
fn w16_m(): i64 { var b = Q { 1, 2 }; var x = (b.mkm()); return dq(x); }
fn wf64(): i64 { var x = (fh()); var y = x + 1.0; var z = fh() + 1.0; if (y == z) { return 1; } return 0; }
fn wexpr(): i64 { var x = (1 + 2); return x; }

test_group("var x = (mk()); — 9-16 B, fn scope");
assert_eq(p16(), 34, "(mk()) into a by-value parameter");
assert_eq(p16_2(), 34, "((mk())) into a by-value parameter");
assert_eq(p16_fields(), 34, "(mk()) then x.a / x.b");
assert_eq(p16_arg(3), 34, "(mkv(3)), a call with an argument");
assert_eq(p16_gen(), 34, "(mkg<i64>(3)), a generic instance's struct");
test_group("var x = (mk3()); — > 16 B, fn scope");
assert_eq(p24(), 34, "(mk3()) into a by-value parameter");
assert_eq(p24_2(), 34, "((mk3())) into a by-value parameter");
assert_eq(p24_fields(), 34, "(mk3()) then x.a / x.b / x.c");
test_group("in a closure");
assert_eq(c16(), 34, "(mk()) in a closure");
assert_eq(c16_2(), 34, "((mk())) in a closure");
assert_eq(c24(), 34, "(mk3()) in a closure");
assert_eq(c24_2(), 34, "((mk3())) in a closure");
test_group("controls");
assert_eq(u16(), 34, "var x = mk(); (unwrapped)");
assert_eq(u24(), 34, "var x = mk3(); (unwrapped)");
assert_eq(t16(), 34, "var x: Q = (mk()); (typed)");
assert_eq(t24(), 34, "var x: Q3 = ((mk3())); (typed)");
assert_eq(twice(), 34, "two wrapped receives in a row");
test_group("6.7.13: 8 B and less, and the 16 B method");
assert_eq(w8(), 33, "var x = (mk1()); x.a (8 B: refused at x.a before)");
assert_eq(w8_2(), 33, "var x = ((mk1())); x.a");
assert_eq(w8_gen(), 33, "var x = (mkg1(33)); an inferred generic's 8 B struct");
assert_eq(w8_u32(), 33, "var x = (mk8()); two u32 fields");
assert_eq(w8_arg(), 33, "var x = (mk1()); d1(x) by value");
assert_eq(w8_cl(), 33, "var x = (mk1()); in a closure");
assert_eq(w16_m(), 34, "var x = (b.mkm()); dq(x), a 16 B method (D42: 139 through 6.7.10)");
assert_eq(wf64(), 1, "var x = (fh()); a : f64 call types x f64, as var x = fh(); does");
assert_eq(wexpr(), 3, "var x = (1 + 2); stays an untyped 3");

var r = assert_summary();
