fn gT_byv(l: VT): i64 { zeroT(&GTT); GPT = &GTT; GPT = l; l.a = 1; return gT_chk(); }
fn gT_rq(): i64 { zeroT(&GTT); var x = VT { 5, 8, 9 }; var q: *VT = &x; GPT = q; var r = (GPT == &x) * 1000 + valT(&GTT); GPT = &GTT; return r; }
fn gT_ra(): i64 { zeroT(&GTT); var x = VT { 5, 8, 9 }; GPT = &x; var r = (GPT == &x) * 1000 + valT(&GTT); GPT = &GTT; return r; }
fn gT_rg(): i64 { zeroT(&GTT); GPT = GQT; var r = (GPT == &GLT) * 1000 + valT(&GTT); GPT = &GTT; return r; }
fn gT_rc(): i64 { zeroT(&GTT); GPT = gqT(); var r = (GPT == &GLT) * 1000 + valT(&GTT); GPT = &GTT; return r; }
fn lT_l(): i64 { var t = VT { 0, 0, 0 }; var q: *VT = &t; var l = VT { 5, 8, 9 }; q = l; l.a = 1; return valT(&t) + (q != &t) * 1000; }
fn lT_call(): i64 { var t = VT { 0, 0, 0 }; var q: *VT = &t; q = mkT(); return valT(&t) + (q != &t) * 1000; }
fn lT_fld(): i64 { var t = VT { 0, 0, 0 }; var q: *VT = &t; var w = WT { 0, 5, 8, 9, 7 }; q = w.s; w.s.a = 1; return valT(&t) + (q != &t) * 1000; }
fn lT_dref(): i64 { var t = VT { 0, 0, 0 }; var q: *VT = &t; var x = VT { 5, 8, 9 }; var p: *VT = &x; q = *p; x.a = 1; return valT(&t) + (q != &t) * 1000; }
fn lT_meth(): i64 { var t = VT { 0, 0, 0 }; var q: *VT = &t; var l = VT { 0, 0, 0 }; q = l.dup(); return valT(&t) + (q != &t) * 1000; }
fn lT_op(): i64 { var t = VT { 0, 0, 0 }; var q: *VT = &t; var z = VT { 0, 0, 0 }; var l = VT { 5, 8, 9 }; q = z + l; l.a = 1; return valT(&t) + (q != &t) * 1000; }
fn pT_l(q: *VT): i64 { var l = VT { 5, 8, 9 }; q = l; l.a = 1; return 0; }
fn pT_call(q: *VT): i64 { q = mkT(); return 0; }
fn pT_fld(q: *VT): i64 { var w = WT { 0, 5, 8, 9, 7 }; q = w.s; w.s.a = 1; return 0; }
fn pT_dref(q: *VT): i64 { var x = VT { 5, 8, 9 }; var p: *VT = &x; q = *p; x.a = 1; return 0; }
fn pT_meth(q: *VT): i64 { var l = VT { 0, 0, 0 }; q = l.dup(); return 0; }
fn pT_op(q: *VT): i64 { var z = VT { 0, 0, 0 }; var l = VT { 5, 8, 9 }; q = z + l; l.a = 1; return 0; }
fn pT_run(k): i64 {
    var t = VT { 0, 0, 0 };
    if (k == 0) { pT_l(&t); }
    elif (k == 1) { pT_call(&t); }
    elif (k == 2) { pT_fld(&t); }
    elif (k == 3) { pT_dref(&t); }
    elif (k == 4) { pT_meth(&t); }
    else { pT_op(&t); }
    return valT(&t);
}

# ── top level (after the first statement): a `*S` global destination ──
