assert_eq(g0_l(), 0, "0 B: GP = l copies nothing (GP still points there, the neighbour kept)");
assert_eq(g0_call(), 0, "0 B: GP = mk() copies nothing");
assert_eq(l0_l(), 0, "0 B: control, q = l through a *S local");
assert_eq(R0a, 0, "0 B: top level, GP = mk() copies nothing");
assert_eq(R0b, 0, "0 B: top level, GP = G copies nothing");
assert_eq(g3_l(), 589, "3 B: GP = l copies into *GP (GP still points there, the guard kept)");
assert_eq(g3_call(), 589, "3 B: GP = mk() (a call result)");
assert_eq(g3_fld(), 589, "3 B: GP = w.s (a struct-typed field)");
assert_eq(g3_dref(), 589, "3 B: GP = *p (a dereference)");
assert_eq(g3_meth(), 589, "3 B: GP = l.dup() (a method result)");
assert_eq(g3_op(), 589, "3 B: GP = z + l (an operator result)");
assert_eq(g3_glob(), 589, "3 B: GP = G (a value global)");
assert_eq(g3_par(), 589, "3 B: GP = (l)");
assert_eq(g3_pcall(), 589, "3 B: GP = (mk())");
assert_eq(g3_for(), 589, "3 B: GP = l as a for step");
