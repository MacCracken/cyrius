zero3(&TT3);
TP3 = TQ3;
var R3r = (TP3 == &TL3) * 1000 + val3(&TT3);
TP3 = &TT3;
TP3 = &TL3;
var R3s = (TP3 == &TL3) * 1000 + val3(&TT3);
TP3 = &TT3;
