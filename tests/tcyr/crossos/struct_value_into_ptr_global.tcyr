# struct_value_into_ptr_global.tcyr — 6.7.11. A STRUCT VALUE ASSIGNED TO A TYPED `*S` GLOBAL COPIES INTO ITS
# POINTEE (the user's decision (a), 2026-10-13; issues/2026-10-13-struct-value-into-pointer-global-destination-
# decision.md): `GP = l` copies `l` into `*GP`, as `q = l` does through a `*S` local or parameter (6.7.10, the
# handle line) — one rule for locals and globals at every size.
#
# ⛔ THROUGH 6.7.10 the global was no copy destination: the one-word store made `GP` the word `l.a` (the filed
# repro: GP == 5, its struct untouched), silently, and the next `GP.a` dereferenced it.
#
# THE RULE, each row at 0, 3, 8, 16 and 24 B (0 B: nothing copied, the neighbour intact) (the source {5, 8, 9}, written after the copy to tell a copy from an
# alias; `GP` checked to still point at its struct, +1000; the guard global after that struct kept, +10000): a
# struct VALUE — a local, a value global, a by-value parameter, a call result, a field `w.s`, a dereference `*p`,
# a method result, an operator result, wrapped, in a for step — into a `*S` GLOBAL, a `*S` local and a `*S`
# parameter copies into the pointee; at top level too (a call / method / operator result over 8 B has no frame
# there and is refused, as into a value global). A `*S` or untyped source REBINDS the global (`GP = q`,
# `GP = &x`, `GP = GP2`, `GP = gq()`). A struct of another type is refused by name (tests/gates/frontend/
# struct_copy_type_checked.sh).
#
# CROSS-HOST: the release gate's cross-OS leg runs it on ecb / ach / cass / pi; tests/gates/codegen/
# small_struct_handle_line.sh R14 on x86_64 (plain, CYRIUS_IR=1, CYRIUS_IR=3, CYRIUS_DCE=1), aarch64 (qemu),
# cx (cxvm) and PE (wine).
include "lib/assert.cyr"

# ── 0 B: a zero-size struct — nothing copied, the pointer kept, the neighbour after the struct intact ──
struct V0 { }
var GT0: V0 = V0 { };
var GZ0: i8 = 99;
var GP0: *V0 = &GT0;
fn mk0(): V0 { var r: V0; return r; }
fn g0_chk(): i64 { return (GP0 != &GT0) * 1000 + (GZ0 - 99) * 10000; }
fn g0_l(): i64 { GP0 = &GT0; var l: V0; GP0 = l; return g0_chk(); }
fn g0_call(): i64 { GP0 = &GT0; GP0 = mk0(); return g0_chk(); }
fn l0_l(): i64 { var t: V0; var q: *V0 = &t; var l: V0; q = l; return (q != &t) * 1000; }

# ── 3 B ──
struct V3 { a: u8; b: u8; c: u8; }
struct W3 { k; s: V3; g: i8; }
var GT3 = V3 { 0, 0, 0 };
var GZ3: i8 = 99;
var GL3 = V3 { 5, 8, 9 };
var GP3: *V3 = &GT3;
var GQ3: *V3 = &GL3;
fn set3(p: *V3): i64 { p.a = 5; p.b = 8; p.c = 9; return 0; }
fn zero3(p: *V3): i64 { p.a = 0; p.b = 0; p.c = 0; return 0; }
fn val3(p: *V3): i64 { return p.a * 100 + p.b * 10 + p.c; }
fn mk3(): V3 { var r: V3; set3(&r); return r; }
fn gq3(): *V3 { return GQ3; }
impl V3 { fn dup(self: *V3): V3 { return mk3(); } }
fn V3_add(l: V3, r: V3): V3 { var t: V3; t.a = l.a + r.a; t.b = l.b + r.b; t.c = l.c + r.c; return t; }
fn g3_chk(): i64 { return val3(&GT3) + (GP3 != &GT3) * 1000 + (GZ3 - 99) * 10000; }
fn g3_l(): i64 { zero3(&GT3); GP3 = &GT3; var l = V3 { 5, 8, 9 }; GP3 = l; l.a = 1; return g3_chk(); }
fn g3_call(): i64 { zero3(&GT3); GP3 = &GT3; GP3 = mk3(); return g3_chk(); }
fn g3_fld(): i64 { zero3(&GT3); GP3 = &GT3; var w = W3 { 0, 5, 8, 9, 7 }; GP3 = w.s; w.s.a = 1; return g3_chk() + (w.g - 7) * 100000; }
fn g3_dref(): i64 { zero3(&GT3); GP3 = &GT3; var x = V3 { 5, 8, 9 }; var p: *V3 = &x; GP3 = *p; x.a = 1; return g3_chk(); }
fn g3_meth(): i64 { zero3(&GT3); GP3 = &GT3; var l = V3 { 0, 0, 0 }; GP3 = l.dup(); return g3_chk(); }
fn g3_op(): i64 { zero3(&GT3); GP3 = &GT3; var z = V3 { 0, 0, 0 }; var l = V3 { 5, 8, 9 }; GP3 = z + l; l.a = 1; return g3_chk(); }
fn g3_glob(): i64 { zero3(&GT3); GP3 = &GT3; GP3 = GL3; GL3.a = 1; var r = g3_chk(); GL3.a = 5; return r; }
fn g3_par(): i64 { zero3(&GT3); GP3 = &GT3; var l = V3 { 5, 8, 9 }; GP3 = (l); l.a = 1; return g3_chk(); }
fn g3_pcall(): i64 { zero3(&GT3); GP3 = &GT3; GP3 = (mk3()); return g3_chk(); }
fn g3_for(): i64 {
    zero3(&GT3);
    GP3 = &GT3;
    var l = V3 { 5, 8, 9 };
    for (var i = 0; i < 1; GP3 = l) { i = 1; }
    l.a = 1;
    return g3_chk();
}
fn g3_byv(l: V3): i64 { zero3(&GT3); GP3 = &GT3; GP3 = l; l.a = 1; return g3_chk(); }
fn g3_rq(): i64 { zero3(&GT3); var x = V3 { 5, 8, 9 }; var q: *V3 = &x; GP3 = q; var r = (GP3 == &x) * 1000 + val3(&GT3); GP3 = &GT3; return r; }
fn g3_ra(): i64 { zero3(&GT3); var x = V3 { 5, 8, 9 }; GP3 = &x; var r = (GP3 == &x) * 1000 + val3(&GT3); GP3 = &GT3; return r; }
fn g3_rg(): i64 { zero3(&GT3); GP3 = GQ3; var r = (GP3 == &GL3) * 1000 + val3(&GT3); GP3 = &GT3; return r; }
fn g3_rc(): i64 { zero3(&GT3); GP3 = gq3(); var r = (GP3 == &GL3) * 1000 + val3(&GT3); GP3 = &GT3; return r; }
fn l3_l(): i64 { var t = V3 { 0, 0, 0 }; var q: *V3 = &t; var l = V3 { 5, 8, 9 }; q = l; l.a = 1; return val3(&t) + (q != &t) * 1000; }
fn l3_call(): i64 { var t = V3 { 0, 0, 0 }; var q: *V3 = &t; q = mk3(); return val3(&t) + (q != &t) * 1000; }
fn l3_fld(): i64 { var t = V3 { 0, 0, 0 }; var q: *V3 = &t; var w = W3 { 0, 5, 8, 9, 7 }; q = w.s; w.s.a = 1; return val3(&t) + (q != &t) * 1000; }
fn l3_dref(): i64 { var t = V3 { 0, 0, 0 }; var q: *V3 = &t; var x = V3 { 5, 8, 9 }; var p: *V3 = &x; q = *p; x.a = 1; return val3(&t) + (q != &t) * 1000; }
fn l3_meth(): i64 { var t = V3 { 0, 0, 0 }; var q: *V3 = &t; var l = V3 { 0, 0, 0 }; q = l.dup(); return val3(&t) + (q != &t) * 1000; }
fn l3_op(): i64 { var t = V3 { 0, 0, 0 }; var q: *V3 = &t; var z = V3 { 0, 0, 0 }; var l = V3 { 5, 8, 9 }; q = z + l; l.a = 1; return val3(&t) + (q != &t) * 1000; }
fn p3_l(q: *V3): i64 { var l = V3 { 5, 8, 9 }; q = l; l.a = 1; return 0; }
fn p3_call(q: *V3): i64 { q = mk3(); return 0; }
fn p3_fld(q: *V3): i64 { var w = W3 { 0, 5, 8, 9, 7 }; q = w.s; w.s.a = 1; return 0; }
fn p3_dref(q: *V3): i64 { var x = V3 { 5, 8, 9 }; var p: *V3 = &x; q = *p; x.a = 1; return 0; }
fn p3_meth(q: *V3): i64 { var l = V3 { 0, 0, 0 }; q = l.dup(); return 0; }
fn p3_op(q: *V3): i64 { var z = V3 { 0, 0, 0 }; var l = V3 { 5, 8, 9 }; q = z + l; l.a = 1; return 0; }
fn p3_run(k): i64 {
    var t = V3 { 0, 0, 0 };
    if (k == 0) { p3_l(&t); }
    elif (k == 1) { p3_call(&t); }
    elif (k == 2) { p3_fld(&t); }
    elif (k == 3) { p3_dref(&t); }
    elif (k == 4) { p3_meth(&t); }
    else { p3_op(&t); }
    return val3(&t);
}

