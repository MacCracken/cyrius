# symlink_long_path.tcyr — a symlink is created at a path longer than MAX_PATH (260 units), and
# past 519 units, on every target; it reads back through the link, its kind is right, and on POSIX
# readlink returns its target verbatim.
#
# ⛔ 6.7.12 — THE DEFECT (issues/2026-10-08-windows-symlink-no-long-path-prefix.md). Windows'
# `sys_symlink` widened both paths ITSELF (at most 519 units, never `\\?\`-prefixed) and handed
# them to CreateSymbolicLinkW (reroute 0xF03E), so on a Windows without process-wide long paths a
# link path over 260 units failed -1 — measured on cass (LongPathsEnabled = 0, Developer Mode on):
# a 269-unit directory took `open(O_CREAT)` and a short link, and refused the link — and anything
# of 519+ units was refused before the call. The reroute now takes NARROW paths like every other
# path reroute: the link is made absolute and `\\?\`-prefixed at 248+ units, the target is decoded
# only (the link stores it verbatim, resolved against the link's directory; '/' becomes '\') —
# except an ABSOLUTE target (`X:\…`, `\\server\…`), which takes the same `\\?\` at 248+ units:
# without it a 260+-unit absolute target failed -1 on cass for a short link and a long one alike.
# wine does not enforce MAX_PATH, so only real Windows reddens without the fix; every POSIX
# target is the oracle. CHANGELOG [6.7.12]
#
# A short link is made first, as the control: without Developer Mode (or elevation) Windows
# refuses EVERY link, a policy and not this defect, and the link rows are then skipped BY NAME —
# the premises still run. Fixtures are per-pid names in the cwd, removed at the end; removing them
# is itself a row (an `xrmdir` of a level fails if anything is left in it).
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"

# "<a><b>", NUL-terminated.
fn _sl_cat(a, b): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    return str_data(str_builder_build(sb));
}

# "<a>/<run of n copies of byte c>", NUL-terminated.
fn _sl_run(a, c, n): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, "/");
    var i = 0;
    while (i < n) {
        str_builder_add_byte(sb, c);
        i = i + 1;
    }
    return str_data(str_builder_build(sb));
}

# 1 when `p` reads back exactly `want` (`wn` bytes) — through a link, the target's bytes.
fn _sl_reads(p, want, wn): i64 {
    var buf[64];
    var n = file_read_all(p, &buf, 64);
    if (n != wn) { return 0; }
    return memeq(&buf, want, wn);
}

# 1 when the link at `p` holds exactly `want` — readlink on POSIX. Windows has no readlink route
# (xreadlink is -1 there), so the read-through rows carry it.
fn _sl_target_is(p, want): i64 {
    var buf[1024];
    var n = xreadlink(p, &buf, 1024);
    var wn = strlen(want);
    if (n != wn) { return 0; }
    return memeq(&buf, want, wn);
}

# 1 where this target can read its cwd (so `_sl_abs` must answer): Linux, macOS, Windows.
fn _sl_cwd_arm(): i64 {
    var a = 0;
    #ifdef CYRIUS_TARGET_LINUX
    a = 1;
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    a = 1;
    #endif
    #ifdef CYRIUS_TARGET_WIN
    a = 1;
    #endif
    return a;
}

# The ABSOLUTE form of the cwd-relative path `rel`, "<cwd>/<rel>", or 0 when the cwd cannot be read
# (or this target has no arm: AGNOS, cx). Linux: readlink /proc/self/cwd; macOS: fcntl(F_GETPATH)
# on "." (Darwin has no getcwd syscall); Windows: GetFinalPathNameByHandleW on "." (reroute 0xF04E),
# its `\\?\` dropped so the target is a plain `X:\…` (`\\?\UNC\…` becomes `\\…`).
fn _sl_abs(rel): i64 {
    var cwd = alloc(98304);
    var n = 0 - 1;
    #ifdef CYRIUS_TARGET_LINUX
    var g = xreadlink("/proc/self/cwd", cwd, 4096);
    if (g > 0) {
        store8(cwd + g, 0);
        n = g;
    }
    #endif
    #ifdef CYRIUS_TARGET_MACOS
    var fd = sys_open(".", 0, 0);
    if (fd >= 0) {
        if (sys_fcntl(fd, 50, cwd) == 0) { n = strlen(cwd); }
        sys_close(fd);
    }
    #endif
    #ifdef CYRIUS_TARGET_WIN
    var w = alloc(65536);
    var h = file_open(".", O_RDONLY | O_DIRECTORY, 0);
    if (h >= 0) {
        var wn = syscall(0xF04E, h, w, 32768, 0);    # FILE_NAME_NORMALIZED | VOLUME_NAME_DOS
        file_close(h);
        if (wn > 0) {
            if (wn < 32768) { n = _fs_narrow(w, cwd, 98304); }
        }
    }
    if (n > 4) {
        if (memeq(cwd, "\\\\?\\", 4) == 1) {
            var skip = 4;
            var keep = 0;
            if (memeq(cwd + 4, "UNC\\", 4) == 1) { skip = 6; keep = 1; }
            var i = 0;
            while (i + skip <= n) {
                store8(cwd + i, load8(cwd + i + skip));
                i = i + 1;
            }
            n = n - skip;
            if (keep == 1) { store8(cwd, 92); }          # "UNC\server" -> "\\server"
        }
    }
    #endif
    if (n <= 0) { return 0; }
    return _sl_cat(_sl_cat(cwd, "/"), rel);
}

# Remove a directory link: RemoveDirectoryW on Windows (a directory symlink is a directory
# object there), unlink elsewhere. Neither touches the target.
fn _sl_unlink_dirlink(p): i64 {
    #ifdef CYRIUS_TARGET_WIN
    return xrmdir(p);
    #endif
    #ifndef CYRIUS_TARGET_WIN
    return xunlink(p);
    #endif
}

fn main(): i64 {
    alloc_init();
    var root = test_scratch("cyrius_sll");
    assert_eq(xmkdir(root, 493), 0, "premise: the fixture root was created");
    var d1 = _sl_run(root, 97, 130);                       # root/aaa...   (130)
    var d2 = _sl_run(d1, 98, 130);                         # .../bbb...    (past 260 units with a leaf)
    var d3 = _sl_run(d2, 99, 150);                         # .../ccc...
    var d4 = _sl_run(d3, 101, 150);                        # .../eee...    (past 519 units with a leaf)
    assert_eq(xmkdir(d1, 493), 0, "premise: mkdir level 1");
    assert_eq(xmkdir(d2, 493), 0, "premise: mkdir level 2 (long on Windows: 248+ units)");
    assert_eq(xmkdir(d3, 493), 0, "premise: mkdir level 3");
    assert_eq(xmkdir(d4, 493), 0, "premise: mkdir level 4");
    var t2 = _sl_cat(d2, "/target.txt");
    var t4 = _sl_cat(d4, "/target.txt");
    var sub = _sl_cat(d2, "/subdir");
    var inner = _sl_cat(sub, "/inner.txt");
    assert_eq(file_write_all(t2, "level-two\n", 10), 10, "premise: a target file at the long level 2");
    assert_eq(file_write_all(t4, "level-four\n", 11), 11, "premise: a target file at the long level 4");
    assert_eq(xmkdir(sub, 493), 0, "premise: a directory at level 2");
    assert_eq(file_write_all(inner, "inner\n", 6), 6, "premise: a file inside it");

    test_group("the control: a SHORT symlink");
    var ts = _sl_cat(root, "/short_target.txt");
    assert_eq(file_write_all(ts, "short\n", 6), 6, "premise: a short target file");
    var sl = _sl_cat(root, "/short_link");
    var made = xsymlink("short_target.txt", sl);
    #ifdef CYRIUS_TARGET_WIN
    if (made != 0) {
        println("  SKIP: the symlink rows: this Windows refuses to create any link (no Developer Mode)");
    }
    #endif
    #ifndef CYRIUS_TARGET_WIN
    assert_eq(made, 0, "a short symlink is created");
    #endif
    if (made == 0) {
        assert_eq(is_symlink(str_from(sl)), 1, "it is a link");
        assert_eq(_sl_reads(sl, "short\n", 6), 1, "it reads its target");
        assert_eq(xunlink(sl), 0, "the short link is removed");

        test_group("a symlink whose PATH is past 260 units (the filed shape)");
        var l2 = _sl_cat(d2, "/link");
        assert_gt(strlen(l2), 260, "premise: the link path is longer than MAX_PATH even relative");
        assert_eq(xsymlink("target.txt", l2), 0,
          "xsymlink(\"target.txt\", <260+-unit path>) is 0 (Windows: -1 before)");
        assert_eq(is_symlink(str_from(l2)), 1, "it is a link");
        assert_eq(_sl_reads(l2, "level-two\n", 10), 1, "opened through it, it reads its target (relative to the link)");
        #ifndef CYRIUS_TARGET_WIN
        assert_eq(_sl_target_is(l2, "target.txt"), 1, "readlink returns the target verbatim");
        #endif
        assert_eq(xunlink(l2), 0, "the link is removed");
        assert_eq(file_exists(t2), 1, "its target is still there");

        test_group("a symlink past 519 units (refused before the call on Windows until 6.7.12)");
        var l4 = _sl_cat(d4, "/link");
        assert_gt(strlen(l4), 519, "premise: the link path is longer than 519 units");
        assert_eq(xsymlink("target.txt", l4), 0, "xsymlink(\"target.txt\", <519+-unit path>) is 0");
        assert_eq(is_symlink(str_from(l4)), 1, "it is a link");
        assert_eq(_sl_reads(l4, "level-four\n", 11), 1, "opened through it, it reads its target");
        #ifndef CYRIUS_TARGET_WIN
        assert_eq(_sl_target_is(l4, "target.txt"), 1, "readlink returns the target verbatim");
        #endif
        assert_eq(xunlink(l4), 0, "the link is removed");

        test_group("a symlink to an ABSOLUTE target past 260 units (Windows: the long-path prefix at 248+ units)");
        var at2 = _sl_abs(t2);
        var atd = _sl_abs(sub);
        var known = 0;
        if (at2 != 0) { known = 1; }
        assert_eq(known, _sl_cwd_arm(), "premise: the cwd is read (Linux, macOS, Windows)");
        if (at2 == 0) {
            println("  SKIP: the absolute-target rows: no way to read the cwd on this target");
        }
        if (at2 != 0) {
            assert_gt(strlen(at2), 260, "premise: the absolute target is longer than MAX_PATH");
            var la = _sl_cat(root, "/abs_link");
            assert_eq(xsymlink(at2, la), 0,
              "xsymlink(<260+-unit ABSOLUTE target>, <short link>) is 0 (Windows: -1 before)");
            assert_eq(is_symlink(str_from(la)), 1, "it is a link");
            assert_eq(_sl_reads(la, "level-two\n", 10), 1, "opened through it, it reads its target");
            #ifndef CYRIUS_TARGET_WIN
            assert_eq(_sl_target_is(la, at2), 1, "readlink returns the absolute target verbatim");
            #endif
            assert_eq(xunlink(la), 0, "the short link is removed");
            var lla = _sl_cat(d2, "/abs_link");
            assert_eq(xsymlink(at2, lla), 0,
              "xsymlink(<260+-unit ABSOLUTE target>, <260+-unit link>) is 0 (Windows: -1 before)");
            assert_eq(is_symlink(str_from(lla)), 1, "it is a link");
            assert_eq(_sl_reads(lla, "level-two\n", 10), 1, "opened through it, it reads its target");
            assert_eq(xunlink(lla), 0, "the long link is removed");
            var adl = _sl_cat(root, "/abs_dir_link");
            assert_eq(xsymlink(atd, adl), 0, "xsymlink(<260+-unit ABSOLUTE directory>, <short link>) is 0");
            assert_eq(is_dir(str_from(adl)), 1, "a DIRECTORY link: the kind probe saw the long absolute target");
            assert_eq(_sl_reads(_sl_cat(adl, "/inner.txt"), "inner\n", 6), 1, "a file reads through it");
            assert_eq(_sl_unlink_dirlink(adl), 0, "the directory link is removed");
            assert_eq(file_exists(t2), 1, "the absolute target is still there");
        }

        test_group("the target is stored as given: a relative target with '/', a directory target");
        var l3 = _sl_cat(d2, "/slash_link");
        assert_eq(xsymlink("subdir/inner.txt", l3), 0, "xsymlink(\"subdir/inner.txt\", <long path>) is 0");
        assert_eq(_sl_reads(l3, "inner\n", 6), 1, "it resolves against the link's directory ('/' is a separator)");
        #ifndef CYRIUS_TARGET_WIN
        assert_eq(_sl_target_is(l3, "subdir/inner.txt"), 1, "readlink returns it verbatim");
        #endif
        assert_eq(xunlink(l3), 0, "the link is removed");
        var dl = _sl_cat(d2, "/dir_link");
        assert_eq(xsymlink("subdir", dl), 0, "xsymlink(\"subdir\", <long path>) is 0");
        assert_eq(is_symlink(str_from(dl)), 1, "it is a link");
        assert_eq(is_dir(str_from(dl)), 1, "a DIRECTORY link: the kind probe saw the long target");
        assert_eq(_sl_reads(_sl_cat(dl, "/inner.txt"), "inner\n", 6), 1, "a file reads through it");
        assert_eq(_sl_unlink_dirlink(dl), 0, "the directory link is removed");
        assert_eq(is_dir(str_from(sub)), 1, "its target is still there");
    }

    assert_eq(xunlink(inner), 0, "cleanup: the inner file");
    assert_eq(xrmdir(sub), 0, "cleanup: the level-2 directory");
    assert_eq(xunlink(t4), 0, "cleanup: the level-4 target");
    assert_eq(xunlink(t2), 0, "cleanup: the level-2 target");
    assert_eq(xunlink(ts), 0, "cleanup: the short target");
    assert_eq(xrmdir(d4), 0, "cleanup: level 4 (it held nothing else)");
    assert_eq(xrmdir(d3), 0, "cleanup: level 3");
    assert_eq(xrmdir(d2), 0, "cleanup: level 2");
    assert_eq(xrmdir(d1), 0, "cleanup: level 1");
    assert_eq(xrmdir(root), 0, "cleanup: the fixture root");
    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
