# sync_mutex.tcyr — VR-01: mutex mutual exclusion under contention (lib/thread.cyr
# mutex → sync_windows.cyr CRITICAL_SECTION on cass; sync_macos.cyr on ecb; futex on
# Linux). 8 workers each increment a shared counter 1000× under the lock; the total
# must be exact (no lost updates) — a broken mutex loses increments. Linux + cass + ecb.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/thread.cyr"

var _vs_mtx = 0;
var _vs_counter = 0;

fn _vs_worker(arg) {
    var i = 0;
    while (i < 1000) {
        mutex_lock(_vs_mtx);
        _vs_counter = _vs_counter + 1;
        mutex_unlock(_vs_mtx);
        i = i + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_group("mutex serializes 8 workers × 1000 increments with no lost updates");
    _vs_mtx = mutex_new();
    _vs_counter = 0;
    var t0 = thread_create(&_vs_worker, 0);
    var t1 = thread_create(&_vs_worker, 0);
    var t2 = thread_create(&_vs_worker, 0);
    var t3 = thread_create(&_vs_worker, 0);
    var t4 = thread_create(&_vs_worker, 0);
    var t5 = thread_create(&_vs_worker, 0);
    var t6 = thread_create(&_vs_worker, 0);
    var t7 = thread_create(&_vs_worker, 0);
    thread_join(t0); thread_join(t1); thread_join(t2); thread_join(t3);
    thread_join(t4); thread_join(t5); thread_join(t6); thread_join(t7);
    # v6.5.11: macOS takes the SAME assertion as every other target. It used to assert
    # the tautology `assert_eq(_vs_counter, _vs_counter)` because Darwin threading was a
    # no-op and the counter stayed 0. macOS now routes to the serial fallback
    # (lib/thread_macos.cyr): the bodies run inline, so every increment lands and the
    # total is 8000 exactly as on Linux — unparallelized, but CORRECT, which is what
    # this assertion is about.
    assert_eq(_vs_counter, 8000, "all 8000 locked increments landed (no lost updates)");

    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
