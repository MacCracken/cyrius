# syscall_wrappers.tcyr — v6.5.7: the syscall-wrapper pass, EXECUTED on real hardware.
#
# WHY THIS FILE EXISTS AT ALL. `tests/syscall_wrapper_pass.sh` proves these wrappers COMPILE
# on all five targets, which is most of the risk — the peers diverge and a wrapper added to
# one is missing from two others. But compiling is not running, and the release gate's
# cross-OS leg executes only tests/tcyr/crossos/. Without a file in that directory, `sys_chdir` /
# `signal_default` / the `x*` family / `sys_fchownat` were never once RUN on macOS-arm64,
# Intel-Mac, Windows or aarch64 — exactly the shape of the macOS rot that CLAUDE.md's
# cross-OS principle was written after (a green check on hello-world while the real thing
# was broken for nine minors).
#
# ⭐ THE SHARPEST CASE HERE IS `sys_fchownat` ON aarch64, and it can only fail on hardware.
# aarch64's native fchownat is 54, but the x86-compat shim rewrites source-54 to 208
# (setsockopt) before the svc, so the wrapper goes through the v6.5.7 PRIVATE ALIAS 1054,
# renumbered by ESYSXLAT to 54 on Linux and to Darwin 468 on macOS-arm64. If that alias arm
# is missing, mis-encoded, or ORDERED WRONG (it must sit after the setsockopt entry, or its
# own x8=54 output is re-caught and reissued as setsockopt), this returns a socket errno
# instead of 0 — silently, and only on ARM. Mutation-verified: the misordered build returns
# -ENOPROTOOPT (-92) here.
#
# Kept deliberately non-destructive: everything lands under one temp dir that is removed at
# the end, and the chown is a no-op (-1/-1 = "leave both unchanged") on a file we just made.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/syscalls.cyr"
include "lib/io.cyr"

fn main(): i64 {
    alloc_init();

    # ── sys_chdir. Called at lib/regression.cyr:658 and defined NOWHERE before .7, so that
    # cyrius-deps-shipped stdlib file could not compile for any consumer reaching
    # regression_exec_in_dir3.
    #ifndef CYRIUS_TARGET_WIN
    assert_eq(sys_chdir("/"), 0, "sys_chdir to / succeeds");
    assert_eq(sys_chdir("/tmp"), 0, "sys_chdir to /tmp succeeds");
    assert(sys_chdir("/nonexistent_cyrius_probe_dir") != 0, "sys_chdir to a missing dir fails");
    #endif

    # ── signal_default — the counterpart signal_ignore never had. SIG_IGN is INHERITED
    # across execve (a handler is not), so without a way back a process hands its ignore to
    # every child it ever execs.
    assert_eq(signal_ignore(SIGPIPE), 0, "signal_ignore(SIGPIPE)");
    assert_eq(signal_default(SIGPIPE), 0, "signal_default(SIGPIPE) restores SIG_DFL");
    assert_eq(signal_default(SIGPIPE), 0, "signal_default is idempotent");

    # ── the x* family. These are the wrappers whose agnos arms are LENGTH-carrying at the
    # same arity as the POSIX ones, so a wrong call compiles clean everywhere.
    #ifndef CYRIUS_TARGET_WIN
    xrmdir("/tmp/cyr_vr01_wrap/a/b");
    xrmdir("/tmp/cyr_vr01_wrap/a");
    xunlink("/tmp/cyr_vr01_wrap/lnk");
    xunlink("/tmp/cyr_vr01_wrap/hard");
    xunlink("/tmp/cyr_vr01_wrap/f");
    xrmdir("/tmp/cyr_vr01_wrap");

    assert_eq(xmkdir_p("/tmp/cyr_vr01_wrap/a/b", 493), 0, "xmkdir_p builds a nested tree");
    assert_eq(_xdir_exists("/tmp/cyr_vr01_wrap/a/b"), 1, "the nested tree exists");
    assert_eq(xmkdir_p("/tmp/cyr_vr01_wrap/a/b", 493), 0, "xmkdir_p on an existing tree is success");

    var fd = sys_open("/tmp/cyr_vr01_wrap/f", O_WRONLY | O_CREAT | O_TRUNC, 0x180);
    assert(fd >= 0, "probe file created");
    sys_write(fd, "x", 1);
    sys_close(fd);

    assert_eq(xsymlink("/tmp/cyr_vr01_wrap/f", "/tmp/cyr_vr01_wrap/lnk"), 0, "xsymlink");
    var rb[256];
    assert(xreadlink("/tmp/cyr_vr01_wrap/lnk", &rb, 256) > 0, "xreadlink returns a length");
    assert_eq(xlink("/tmp/cyr_vr01_wrap/f", "/tmp/cyr_vr01_wrap/hard"), 0, "xlink");

    # ── sys_fchownat. AT_FDCWD + AT_SYMLINK_NOFOLLOW is lchown semantics — the reason this is
    # the ONE wrapped primitive of the chown family rather than the legacy trio (two of the
    # agnos 92-95 band terminate the caller on ARM). uid/gid -1 leaves both unchanged, so on
    # a file we just created this is a permitted no-op for any user.
    #
    # On aarch64 THIS is the alias test: a wrong/missing/misordered 1054 arm surfaces here as
    # a socket errno rather than 0.
    #ifndef CYRIUS_TARGET_AGNOS
    var ch = sys_fchownat(AT_FDCWD, "/tmp/cyr_vr01_wrap/f", 0 - 1, 0 - 1, AT_SYMLINK_NOFOLLOW);
    assert_eq(ch, 0, "sys_fchownat(AT_FDCWD, -1, -1, NOFOLLOW) is a permitted no-op");
    #endif

    # ── v6.5.15: pipe / fchmod / access ─────────────────────────────────────
    # These three had NO cross-host coverage and all three were BROKEN on
    # macOS-arm64 until this release — which is why they belong here and not in a
    # Linux-only .tcyr: on Linux every one passes against the bug.
    #
    # pipe: `sys_pipe` issues pipe2(59), which the macho ESYSXLAT never mapped, so on
    # Darwin it reached BSD 59 = execve — it failed, left the fd buffer unwritten, and
    # the caller read garbage descriptors. Even once mapped, DARWIN RETURNS BOTH FDS IN
    # REGISTERS (x0/x1) and never touches the buffer, so a renumber alone is not enough.
    # Assert the ROUND TRIP, not just the return code — a fixup that writes the wrong
    # register still returns 0.
    var pfds[16];
    assert_eq(sys_pipe(&pfds), 0, "sys_pipe returns 0");
    var prd = load32(&pfds);
    var pwr = load32(&pfds + 4);
    assert(prd >= 0, "pipe read fd is valid (garbage fd = the unwritten-buffer bug)");
    assert(pwr >= 0, "pipe write fd is valid");
    assert_neq(prd, pwr, "the two pipe fds are distinct");
    assert_eq(sys_write(pwr, "pq", 2), 2, "wrote 2 bytes into the pipe");
    var pbuf[8];
    assert_eq(sys_read(prd, &pbuf, 2), 2, "read 2 bytes back out of the pipe");
    assert_eq(load8(&pbuf) & 0xFF, 112, "pipe round-trips byte 0");
    assert_eq(load8(&pbuf + 1) & 0xFF, 113, "pipe round-trips byte 1");
    sys_close(prd);
    sys_close(pwr);

    # fchmod: 52 was unmapped on macho, so it returned -9 (EBADF).
    var fmfd = sys_open("/tmp/cyr_vr01_wrap/f", O_WRONLY, 0);
    assert(fmfd >= 0, "opened the probe file for fchmod");
    assert_eq(sys_fchmod(fmfd, 420), 0, "sys_fchmod(fd, 0644) returns 0");
    sys_close(fmfd);

    # access: faccessat(269) was unmapped on macho AND the wrapper passed only 3 args.
    # Linux's faccessat ignores the 4th; DARWIN'S VALIDATES IT, so a stale register made
    # every macOS sys_access return -22. Assert BOTH directions — a wrapper that always
    # returns non-zero would pass a present-file-only check.
    assert_eq(sys_access("/tmp/cyr_vr01_wrap/f", 0), 0, "sys_access on an existing file is 0");
    assert(sys_access("/tmp/cyr_vr01_wrap/absent_probe", 0) < 0,
        "sys_access on a missing file is negative");

    xunlink("/tmp/cyr_vr01_wrap/lnk");
    xunlink("/tmp/cyr_vr01_wrap/hard");
    xunlink("/tmp/cyr_vr01_wrap/f");
    xrmdir("/tmp/cyr_vr01_wrap/a/b");
    xrmdir("/tmp/cyr_vr01_wrap/a");
    xrmdir("/tmp/cyr_vr01_wrap");
    assert_eq(_xdir_exists("/tmp/cyr_vr01_wrap"), 0, "cleanup removed the probe tree");
    #endif

    # ── v6.5.25: the Windows-VISIBLE arm for sys_getpid + sys_access ──────────────────
    #
    # ⛔ WHY A SEPARATE BLOCK AND NOT JUST UNGUARDING THE ASSERTIONS ABOVE. The `sys_access`
    # assertions already in this file sit inside the `#ifndef CYRIUS_TARGET_WIN` block that
    # opens ~line 52, so they are COMPILED OUT on cass — Windows had ZERO execution coverage
    # for access. They cannot simply be unguarded, because the enclosing block depends on
    # `xsymlink`/`xlink`/`xmkdir_p`, which degrade to -1 on PE. This block builds its probe
    # file with `sys_open` only, so it runs on every target.
    #
    # These two wrappers were band-D (.25) items and BOTH reroutes (0xF01C
    # GetCurrentProcessId, 0xF019 GetFileAttributesW) had been live for minors — only the raw
    # floor names were missing from the standalone Windows peer, which made each a hard
    # compile error for PE. The wrapper rule is the reason this arm exists at all: a wrapper
    # that COMPILES on five targets is not a wrapper that RUNS, and the release gate's
    # cross-OS leg only executes what is in this directory.
    test_group("sys_getpid + sys_access — Windows-visible (crossos)");

    # getpid: assert a plausible pid, both directions. A stub returning 0 or -1 fails this,
    # which is the whole point — the Windows peer had no sys_getpid at all until .25.
    var mypid = sys_getpid();
    assert(mypid > 0, "sys_getpid() returns a positive pid");
    assert_eq(sys_getpid(), mypid, "sys_getpid() is stable across calls");

    # access: create a probe file with sys_open (portable on PE), then assert BOTH
    # directions. A wrapper that always returns 0 passes a present-file check alone, and one
    # that always returns -1 passes a missing-file check alone — so neither assertion is
    # sufficient by itself. This is the same both-directions requirement the macOS
    # faccessat fix documented above.
    var pfd = sys_open("cyr_vr01_access_probe", O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
    assert(pfd >= 0, "created the access probe file");
    if (pfd >= 0) {
        sys_write(pfd, "x", 1);
        sys_close(pfd);
        assert_eq(sys_access("cyr_vr01_access_probe", 0), 0,
            "sys_access on an existing file is 0 (runs on Windows too)");
        assert(sys_access("cyr_vr01_access_probe_absent", 0) < 0,
            "sys_access on a missing file is negative (runs on Windows too)");
        sys_unlink("cyr_vr01_access_probe");
        assert(sys_access("cyr_vr01_access_probe", 0) < 0,
            "sys_access is negative again once the file is unlinked");
    }

    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
