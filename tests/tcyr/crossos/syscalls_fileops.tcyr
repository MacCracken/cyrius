# syscalls_fileops.tcyr — VR-01 platform-variant stdlib coverage.
# Exercises the raw syscall shims (lib/syscalls.cyr dispatcher → syscalls_windows.cyr
# on cass, syscalls_macos.cyr on ecb, the Linux path on Linux): a file open/write/
# lseek/read/close/unlink round-trip. Zero of the pre-.43 tcyr touched these files,
# so a syscall the target mistranslates (arity, flag mapping, byte order) rotted
# silently — this catches it. Runs on Linux + cass + ecb via the LIBTEST glob.
# Relative CWD path so it works on all three (POSIX /tmp vs Windows %TEMP%).
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"

fn main(): i64 {
    alloc_init();
    test_group("syscalls file I/O round-trip (open/write/lseek/read/close/unlink)");
    var path = "_vr01_fileops.bin";
    # create + write
    var fd = sys_open(path, 577, 420);          # O_WRONLY|O_CREAT|O_TRUNC, 0644
    assert_neq(fd < 0, 1, "sys_open O_CREAT|O_WRONLY succeeded");
    var msg = "cyrius-vr01";                     # 11 bytes
    var w = sys_write(fd, msg, 11);
    assert_eq(w, 11, "sys_write wrote all 11 bytes");
    sys_close(fd);
    # reopen read-only, read back (sys_lseek is NOT portable — only Windows/agnos
    # define it; Linux/macOS/aarch64 don't — so this stays a fresh-open read).
    var rfd = sys_open(path, 0, 0);              # O_RDONLY
    assert_neq(rfd < 0, 1, "sys_open O_RDONLY succeeded");
    var buf = alloc(64);
    var r = sys_read(rfd, buf, 64);
    assert_eq(r, 11, "sys_read returned the 11 written bytes");
    assert_eq(memeq(buf, msg, 11), 1, "read-back bytes match what was written");
    sys_close(rfd);
    # unlink cleans up
    var u = sys_unlink(path);
    assert_eq(u < 0, 0, "sys_unlink removed the file");
    var gone = sys_open(path, 0, 0);
    assert_eq(gone < 0, 1, "the unlinked file no longer opens");

    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
