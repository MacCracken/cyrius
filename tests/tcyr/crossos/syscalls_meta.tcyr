# syscalls_meta.tcyr — VR-01: filesystem-metadata syscalls (sys_mkdir / sys_chmod
# / sys_unlink → syscalls_windows.cyr CreateDirectory/DeleteFile on cass; syscalls_macos.cyr
# on ecb; Linux path on Linux). Distinct from the file-I/O test. is_dir (lib/fs.cyr)
# confirms mkdir landed. Idempotent (asserts is_dir, not mkdir's return, so a re-run
# over an existing dir still passes). Runs on Linux + cass + ecb.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/fs.cyr"
include "lib/io.cyr"

fn main(): i64 {
    alloc_init();
    test_group("sys_mkdir creates a directory (verified via is_dir)");
    # v6.6.6: PID-suffixed (test_scratch, lib/assert.cyr). The name was fixed and the check
    # driver's cwd is the REPO ROOT, so two check.sh runs in one checkout raced over the same
    # directory. Still cwd-relative — Windows has no /tmp. CHANGELOG [6.6.6]
    #
    # ⚠ ON EVERY TARGET, PE INCLUDED, SINCE THE SAME RELEASE. This used to carry a
    # `#ifdef CYRIUS_TARGET_WIN` branch holding the FIXED name, because `xrmdir` returned -1
    # on PE (no RemoveDirectoryW reroute was wired) and a per-pid name would have turned one
    # reused leftover into one per run on the one target that could not clean up. 6.6.6 wired
    # that reroute (`syscall(0xF03A)`), so the carve-out — and its `win_guarded` allowlist
    # entry in gates_never_write_tree.sh axis 8 — are gone with it. CHANGELOG [6.6.6]
    var mdir = test_scratch("_vr01_mdir");
    sys_mkdir(mdir, 493);                        # 0755; return not asserted (idempotent re-runs)
    assert_eq(is_dir(str_from(mdir)), 1, "the directory exists after sys_mkdir");
    # 6.6.5 — AND REMOVE IT. This test created `_vr01_mdir` and never removed it, so every
    # corpus run (and every check.sh) left an empty directory in the REPO ROOT — and in
    # `~/_cyaud` on ecb/ach/cass/pi. It was invisible to `git status` because git does not
    # track empty directories, which is why "delete it once by hand" was reported as a fix
    # twice and did not hold: the leaker regenerates it. The file half beside this
    # (`_vr01_meta.bin`) was always cleaned up; only the directory was not.
    # ⚠ `xrmdir` (lib/io.cyr), not `sys_rmdir`: agnos's raw wrapper is length-carrying
    # (`sys_rmdir(path, pathlen)`) and Windows has no wrapper at all, so a bare `sys_rmdir`
    # here would be an arity mismatch on agnos and an undefined fn on cass — the exact trap
    # xrmdir was added at v6.5.2 to close. v6.6.6: the removal is asserted UNCONDITIONALLY.
    # It used to be `if (rd == 0) { ... }` because xrmdir returned -1 on PE with no
    # RemoveDirectoryW reroute wired — i.e. the one target where this could fail was the one
    # target not asserting it, which is how a gap stays invisible. The reroute is wired now,
    # so cass answers the same question as everybody else. CHANGELOG [6.6.6]
    assert_eq(xrmdir(mdir), 0, "xrmdir removed the directory");
    assert_eq(is_dir(str_from(mdir)), 0, "the directory is gone after xrmdir");

    test_group("sys_chmod + sys_unlink on a regular file");
    var mfile = test_scratch("_vr01_meta.bin");
    var fd = sys_open(mfile, 577, 420);   # create
    assert_neq(fd < 0, 1, "created the metadata test file");
    sys_write(fd, "x", 1);
    sys_close(fd);
    var cm = sys_chmod(mfile, 420);   # 0644
    assert_eq(cm < 0, 0, "sys_chmod on the file succeeded");
    var u = sys_unlink(mfile);
    assert_eq(u < 0, 0, "sys_unlink removed the file");
    assert_eq(is_dir(str_from(mfile)), 0, "the unlinked file is gone");

    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
