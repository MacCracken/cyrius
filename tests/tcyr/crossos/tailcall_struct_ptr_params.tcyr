# tailcall_struct_ptr_params.tcyr — a tail call into a fn with an ADDRESS-PASSED parameter (a
# struct over 8 B as `p: T` or `p: *T`, a Win64 value-form vector) keeps its `jmp` unless an
# address in the caller's own frame can reach the callee.
#
# THE BUG (fixed 6.6.20). Any address-passed parameter diverted EVERY tail call to its fn onto
# the normal call path, whatever the argument was. So the shape the 6.6.16 by-value migration
# recommends for a mutating callee, a `p: *Node` list walk —
#     fn walk(p: *Node, acc) { if (p == 0) { return acc; } return walk(p.next, acc + p.v); }
# — recursed with `call`, and a long list overflowed the stack (rc 139; the untyped twin ran in
# constant stack). The tail arm now pushes such an argument exactly as an ordinary call does.
#
# THE HAZARD THE DIVERT STOOD FOR is an address in the frame the `jmp` frees reaching the callee —
# not only as the argument itself but LAUNDERED through a value: `var x = idp(s); return dP(x, k);`
# hands `dP` the `&s` that `idp` returned, and `x` is an ordinary pointer local. The first cut of
# this fix vetted the argument's shape and kept that call (a silent wrong value). What keeps a
# `jmp` sound now, each pinned by rows below:
#   1. any address in this frame handed to anything that may KEEP it sets the fn's escape flag,
#      `&s` or implicit — an inline struct argument, a by-value parameter's copy, a struct call's
#      temp, a field of an inline struct, a method's `self`, an operator's operand — and every LATER
#      tail call diverts. An ordinary call whose callee COPIES that parameter in its prologue keeps
#      nothing (a `p: T` over 8 B, a Win64 vector): it sets no flag, as on 6.6.19;
#   2. inside a loop that flag is not yet set when a lexically earlier return runs on the next
#      iteration, so there the verdict waits for the end of the outermost loop (6.7.3: a call
#      to ANY callee, kept when no frame address is taken in that loop; 6.6.20 diverted an
#      address-passed callee there always — tailcall_loop_frame_address.tcyr has the rows);
#   3. an address created while evaluating the tail call's OWN arguments (`dQ(G, s.me())`,
#      `dP(idu(idp(s)), k)`) turns that call into an ordinary call.
# Rules 1 and 3 cover a callee with no address-passed parameter too (`dU`).
# A `*S` of 8 B or less is address-passed too since 6.6.20 (lane s-ptr), so every path that lane
# added to pass one an address — a bare name, a <= 8 B call / method / operator result's temp, a
# field, an overloaded operator's operand (bare, a temp, a parenthesised call, a field) — counts
# exactly as its over-8-byte twin does (group "a `*S` of 8 B or less"; each row's only frame
# address is the one under test).
#
# HOW A ROW TELLS A KEPT TAIL CALL FROM A DIVERTED ONE. Each probe callee stores the address of
# one of its own locals in `_dmark`. Called directly from the checker it lands at some depth; a
# wrapper that tail-calls it with a `jmp` puts it at the SAME depth (the wrapper's frame is gone),
# and a wrapper that calls it normally puts it DEEPER. So every row asserts both the value and
# the depth — exactly, with no reliance on a freed frame happening to be overwritten.
#   - kept (same depth): a forwarded `*T` parameter, an untyped pointer local, a typed `*T` local
#     (one forwarding a parameter, one holding a heap pointer), a pointer-mode struct local (its
#     heap pointer), a global struct into `*T` and into a by-value `T` (the global's own address is
#     pushed), a field reached through a `*T` parameter or a `*T` local (the pointee's field), a
#     plain call that returns a pointer, and a return that runs BEFORE the fn's frame address exists;
#   - kept (same depth) after an EARLIER by-value call given an address in this frame — an inline
#     struct, a struct call's temp, a field of an inline struct, a by-value parameter's copy, a vector
#     (address-passed on Win64), a typed `self: T`, a typed operator, a callee declared below, a
#     generic's instance, and one inside the tail call's own arguments: the callee copied it and
#     holds nothing;
#   - diverted (deeper): an inline struct local, a field of one, a forwarded by-value parameter (an
#     inline copy in this frame since 6.6.16), a struct call's temp, a value-form vector local
#     (address-passed on Win64, vector-register-passed elsewhere), `&local`, a call given an inline
#     struct local, and every laundered shape of rules 1-3;
#   - diverted (deeper) after an earlier call that may keep the address: a `*T` parameter, a
#     `#naked` fn (no frame, so no copy), each declared above and below. 6.6.19 kept both — a `jmp`
#     that was right only while the callee happened not to keep the pointer.
# The deep rows run 1,000,000 levels, past any default stack (1 MB on Windows): the real shapes.
#
# ⚠ CROSS-HOST because the tail-call epilogue and the address-passing ABI are per backend, and the
# vector row diverts through this rule only on Win64.
include "lib/assert.cyr"
include "lib/alloc.cyr"

struct P3 { a; b; c; }
struct W { x; inner: P3; }
var G = P3 { 10, 20, 30 };
var _dmark = 0;

# Probe callees: each records its own depth. The j* locals overwrite a freed caller frame, so a
# wrongly kept tail call also reads the wrong value.
fn dP(p: *P3, k) {
    var j1 = 901; var j2 = 902; var j3 = 903; var j4 = 904; var j5 = 905; var j6 = 906;
    _dmark = &j1;
    return p.a + p.b + p.c + k + (j1 + j2 + j3 + j4 + j5 + j6) - 5421;
}
fn dV(p: P3, k) {
    var j1 = 901; var j2 = 902; var j3 = 903; var j4 = 904; var j5 = 905; var j6 = 906;
    _dmark = &j1;
    return p.a + p.b + p.c + k + (j1 + j2 + j3 + j4 + j5 + j6) - 5421;
}
fn dVec(v: f64v2, k) {
    var j1 = 901; var j2 = 902; var j3 = 903; var j4 = 904; var j5 = 905; var j6 = 906;
    _dmark = &j1;
    return load64(&v + 0) + load64(&v + 8) + k + (j1 + j2 + j3 + j4 + j5 + j6) - 5421;
}
fn mk(a, b, c): P3 { var r = P3 { a, b, c }; return r; }
fn mkv(a, b): f64v2 { var r: f64v2; store64(&r + 0, a); store64(&r + 8, b); return r; }
fn dQ(p: *P3, q) {
    var j1 = 901; var j2 = 902; var j3 = 903; var j4 = 904; var j5 = 905; var j6 = 906;
    _dmark = &j1;
    return p.a + load64(q) + load64(q + 8) + load64(q + 16) + (j1 + j2 + j3 + j4 + j5 + j6) - 5421;
}
fn dU(q, k) {
    var j1 = 901; var j2 = 902; var j3 = 903; var j4 = 904; var j5 = 905; var j6 = 906;
    _dmark = &j1;
    return load64(q) + load64(q + 8) + load64(q + 16) + k + (j1 + j2 + j3 + j4 + j5 + j6) - 5421;
}
fn idp(p: *P3) { return p; }
fn idpt(p: *P3): *P3 { return p; }
fn idu(p) { return p; }
fn p3_set(p: *P3, v) { p.a = v; return p; }
# A method and an operator that hand their receiver / operand back: legal, and exactly how an
# address in the caller's frame comes back out as a value.
fn P3_me(self) { return self; }
fn P3_add(a, b) { return a; }
fn P3_cp(self: *P3): P3 { var r = P3 { self.a, self.b, self.c }; return r; }
fn hp3(a, b, c): *P3 { var h = alloc(24); store64(h, a); store64(h + 8, b); store64(h + 16, c); return h; }
# By value: copied in the callee's prologue. `*T` and `#naked`: the callee gets the address itself.
fn sumV(p: P3) { var t = p.a + p.b; return t + p.c; }
fn sumG<T>(p: T) { var t = p.a + p.b; return t + p.c; }   # its instance is copied in too
fn sum3p(p: *P3) { var t = p.a + p.b; return t + p.c; }
fn P3_sumv(self: P3) { var t = self.a + self.b; return t + self.c; }
struct Q3 { a; b; c; }
fn Q3_add(a: Q3, b: Q3) { var t = a.a; return t + b.c; }
# Returns 6 and never reads `p`; the asm is per arch (x86 SysV and Win64 alike).
#naked
fn nk6(p: P3): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        0xB8; 0x06; 0x00; 0x00; 0x00;   # mov eax, 6
        0xC3;                            # ret
    }
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    asm {
        0xC0; 0x00; 0x80; 0xD2;         # mov x0, #6
        0xC0; 0x03; 0x5F; 0xD6;         # ret
    }
    #endif
}
fn _same(m, base): i64 { if (m == base) { return 1; } return 0; }
fn _deeper(m, base): i64 { if (m < base) { return 1; } return 0; }

# --- kept: pushed exactly as an ordinary call pushes it -----------------------------------------
fn t_ptp(q: *P3, k) { return dP(q, k); }
fn t_raw(k) { var h = alloc(24); store64(h, 7); store64(h + 8, 8); store64(h + 16, 9); return dP(h, k); }
fn t_glob(k) { return dP(G, k); }
fn t_globv(k) { return dV(G, k); }
fn t_fld(w: *W, k) { return dP(w.inner, k); }
fn t_tloc(q: *P3, k) { var x: *P3 = q; return dP(x, k); }
fn t_theap(k) { var h: *P3 = hp3(7, 8, 9); return dP(h, k); }
fn t_tfld(w: *W, k) { var x: *W = w; return dP(x.inner, k); }
fn t_pcall(q: *P3, k) { return dP(idp(q), k); }
fn t_pmode(k) { var b: P3 = alloc(24); b.a = 7; b.b = 8; b.c = 9; return dP(b, k); }
# The address appears only AFTER this return, and no loop can bring it back round.
fn t_before(q: *P3, k, c) {
    if (c == 1) { return dP(q, k); }
    var s = P3 { 1, 2, 3 };
    return dP(s, k);
}
# --- kept: an EARLIER by-value call copied the address it was given -------------------------------
fn t_bvk(q: *P3, k) { var s = P3 { 1, 2, 3 }; var v = sumV(s); return dP(q, k + v - 6); }
fn t_bvkc(q: *P3, k) { var v = sumV(mk(1, 2, 3)); return dP(q, k + v - 6); }
fn t_bvkf(q: *P3, k) { var w: W; w.x = 0; w.inner.a = 1; w.inner.b = 2; w.inner.c = 3; var v = sumV(w.inner); return dP(q, k + v - 6); }
fn t_bvkp(p: P3, q: *P3, k) { var v = sumV(p); return dP(q, k + v - 12); }
fn t_bvkv(q: *P3, k) { var v: f64v2 = mkv(30, 12); var x = dVec(v, 0); return dP(q, k + x - 42); }
fn t_bvkm(q: *P3, k) { var s = P3 { 1, 2, 3 }; var v = s.sumv(); return dP(q, k + v - 6); }
fn t_bvko(q: *P3, k) { var s = Q3 { 1, 2, 3 }; var t = Q3 { 4, 5, 6 }; var v = s + t; return dP(q, k + v - 7); }
fn t_bvkw(q: *P3, k) { var s = P3 { 1, 2, 3 }; var v = sumF(s); return dP(q, k + v - 6); }
fn t_bvka(q: *P3, k) { var s = P3 { 1, 2, 3 }; return dP(q, k + sumV(s) - 6); }
fn t_bvkg(q: *P3, k) { var s = P3 { 1, 2, 3 }; var v = sumG(s); return dP(q, k + v - 6); }
# --- diverted: an earlier call may KEEP the address ----------------------------------------------
fn t_ptrb(q: *P3, k) { var s = P3 { 1, 2, 3 }; var v = sum3p(s); return dP(q, k + v - 6); }
fn t_nkd(q: *P3, k) { var s = P3 { 1, 2, 3 }; var v = nk6(s); return dP(q, k + v - 6); }
fn t_ptrbf(q: *P3, k) { var s = P3 { 1, 2, 3 }; var v = sum3f(s); return dP(q, k + v - 6); }
fn t_nkdf(q: *P3, k) { var s = P3 { 1, 2, 3 }; var v = nk6f(s); return dP(q, k + v - 6); }
# --- diverted: the argument is an address in this frame -----------------------------------------
fn t_loc(k) { var s = P3 { 1, 2, 3 }; return dP(s, k); }
fn t_locv(k) { var s = P3 { 1, 2, 3 }; return dV(s, k); }
fn t_ifld(k) { var w: W; w.x = 0; w.inner.a = 4; w.inner.b = 5; w.inner.c = 6; return dP(w.inner, k); }
fn t_bvp(p: P3, k) { return dP(p, k); }
fn t_bvv(p: P3, k) { return dV(p, k); }
fn t_call(k) { return dP(mk(4, 5, 6), k); }
fn t_vec(k) { var v: f64v2 = mkv(30, 12); return dVec(v, k); }
fn t_tamp(k) { var s = P3 { 1, 2, 3 }; var x: *P3 = &s; return dP(x, k); }
fn t_pcloc(k) { var s = P3 { 1, 2, 3 }; return dP(idp(s), k); }
# --- diverted: an address in this frame laundered through a value --------------------------------
# rule 1: an earlier implicit push of a frame address.
fn t_idl(k) { var s = P3 { 1, 2, 3 }; var x = idp(s); return dP(x, k); }
fn t_idc(k) { var x = idp(mk(1, 2, 3)); return dP(x, k); }
fn t_idf(k) { var w: W; w.x = 0; w.inner.a = 1; w.inner.b = 2; w.inner.c = 3; var x = idp(w.inner); return dP(x, k); }
fn t_idv(p: P3, k) { var x = idp(p); return dP(x, k); }
fn t_idm(q: *P3, k) { var x = idp(q.cp()); return dP(x, k); }
fn t_rep(p: *P3, k) { var s = P3 { 1, 2, 3 }; p = idpt(s); return dP(p, k); }
fn t_bld(k) { var s = P3 { 0, 2, 3 }; var x = p3_set(s, 1); return dP(x, k); }
fn t_self(k) { var s = P3 { 1, 2, 3 }; var x = s.me(); return dP(x, k); }
fn t_oper(k) { var s = P3 { 1, 2, 3 }; var t = P3 { 4, 5, 6 }; var x = s + t; return dP(x, k); }
fn t_ul(k) { var s = P3 { 1, 2, 3 }; var x = idp(s); return dU(x, k); }
# rule 2: the address is taken AFTER the return in the source, BEFORE it at run time.
fn t_lpa(k) {
    var s = P3 { 1, 2, 3 };
    var x = 0;
    var i = 0;
    while (i < 2) {
        if (i == 1) { return dP(x, k); }
        x = &s;
        i = i + 1;
    }
    return 0;
}
fn t_lpc(k) {
    var s = P3 { 1, 2, 3 };
    var x = 0;
    var i = 0;
    while (i < 2) {
        if (i == 1) { return dP(x, k); }
        x = idp(s);
        i = i + 1;
    }
    return 0;
}
# rule 3: the tail call's own arguments create the address.
fn t_nsp(k) { var s = P3 { 1, 2, 3 }; return dQ(G, s.me()); }
fn t_inu(k) { var s = P3 { 1, 2, 3 }; return dP(idu(idp(s)), k); }
fn t_um(k) { var s = P3 { 1, 2, 3 }; return dU(s.me(), k); }

# --- deep: the real shapes, 1,000,000 levels --------------------------------------------------
struct Node { v; next: *Node; }
fn walk(p: *Node, acc) {
    if (p == 0) { return acc; }
    return walk(p.next, acc + p.v);
}
fn walkl(p: *Node, acc) {
    if (p == 0) { return acc; }
    var nx: *Node = p.next;
    return walkl(nx, acc + p.v);
}
fn walkc(p: *Node, acc) {
    if (p == 0) { return acc; }
    var cur: *Node = p;
    return walkc(cur.next, acc + cur.v);
}
fn nxt(p: *Node) { return p.next; }
fn walkn(p: *Node, acc) {
    if (p == 0) { return acc; }
    return walkn(nxt(p), acc + p.v);
}
fn cntq(q: *P3, n, acc) {
    if (n == 0) { return acc; }
    return cntq(q, n - 1, acc + q.a);
}
fn cntg(p: *P3, n, acc) {
    if (n == 0) { return acc; }
    return cntg(G, n - 1, acc + p.b);
}
fn cntv(p: P3, n, acc) {
    if (n == 0) { return acc; }
    return cntv(G, n - 1, acc + p.c);
}
# Mutual, through a fn declared below: `w.inner` is a field of the pointee, not of this frame.
fn stepw(w: *W, n, acc) {
    if (n == 0) { return acc; }
    return stepp(w.inner, w, n - 1, acc);
}
fn stepp(p: *P3, w: *W, n, acc) { return stepw(w, n, acc + p.a); }
# An earlier by-value call before the self tail call: 6.6.19 ran each of these in constant stack.
fn loopv(n, acc) {
    if (n == 0) { return acc; }
    var s = P3 { 1, 2, 3 };
    var v = sumV(s);
    return loopv(n - 1, acc + v);
}
fn loopc(n, acc) {
    if (n == 0) { return acc; }
    var v = sumV(mk(1, 2, 3));
    return loopc(n - 1, acc + v);
}
fn loopf(n, acc) {
    if (n == 0) { return acc; }
    var w: W; w.x = 0; w.inner.a = 1; w.inner.b = 2; w.inner.c = 3;
    var v = sumV(w.inner);
    return loopf(n - 1, acc + v);
}
fn loopa(n, acc) {
    if (n == 0) { return acc; }
    var s = P3 { 1, 2, 3 };
    return loopa(n - 1, acc + sumV(s));
}
fn loopm(n, acc) {
    if (n == 0) { return acc; }
    var s = P3 { 1, 2, 3 };
    var v = s.sumv();
    return loopm(n - 1, acc + v);
}
fn loopo(n, acc) {
    if (n == 0) { return acc; }
    var s = Q3 { 1, 2, 3 };
    var t = Q3 { 4, 5, 6 };
    var v = s + t;
    return loopo(n - 1, acc + v);
}
fn loopw(n, acc) {
    if (n == 0) { return acc; }
    var s = P3 { 1, 2, 3 };
    var v = sumF(s);
    return loopw(n - 1, acc + v);
}
fn loopx(n, acc) {
    if (n == 0) { return acc; }
    var v: f64v2 = mkv(1, 2);
    var x = dVec(v, 0);
    return loopx(n - 1, acc + x);
}
fn loopg(n, acc) {
    if (n == 0) { return acc; }
    var s = P3 { 1, 2, 3 };
    var v = sumG(s);
    return loopg(n - 1, acc + v);
}
# Declared BELOW their callers: a forward call reads pass 1's record of the copy.
fn sumF(p: P3) { var t = p.a + p.b; return t + p.c; }
fn sum3f(p: *P3) { var t = p.a + p.b; return t + p.c; }
#naked
fn nk6f(p: P3): i64 {
    #ifdef CYRIUS_ARCH_X86
    asm {
        0xB8; 0x06; 0x00; 0x00; 0x00;   # mov eax, 6
        0xC3;                            # ret
    }
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    asm {
        0xC0; 0x00; 0x80; 0xD2;         # mov x0, #6
        0xC0; 0x03; 0x5F; 0xD6;         # ret
    }
    #endif
}

# --- a `*S` of 8 B OR LESS: address-passed since 6.6.20 (lane s-ptr), at every site above -------
# A bare struct name, a <= 8 B struct call / method / operator result, a field and an overloaded
# operator's `*S` operand each hand the callee an address in this frame, through paths lane s-ptr
# added in the same release; each must count as an escape exactly as its over-8-byte twin does.
struct S1 { v; }
struct HS { k; inner: S1; }
var G1 = S1 { 5 };
fn dP1(p: *S1, k) {
    var j1 = 901; var j2 = 902; var j3 = 903; var j4 = 904; var j5 = 905; var j6 = 906;
    _dmark = &j1;
    return p.v + k + (j1 + j2 + j3 + j4 + j5 + j6) - 5421;
}
fn dU1(q, k) {
    var j1 = 901; var j2 = 902; var j3 = 903; var j4 = 904; var j5 = 905; var j6 = 906;
    _dmark = &j1;
    return load64(q) + k + (j1 + j2 + j3 + j4 + j5 + j6) - 5421;
}
fn idp1(p: *S1) { return p; }
fn byv1(b: S1) { return b.v; }
fn mk1(n): S1 { var s = S1 { n }; return s; }
fn S1_dup(self: *S1): S1 { var d = S1 { self.v + 1 }; return d; }
fn S1_add(a: S1, b: S1): S1 { var r = S1 { a.v + b.v }; return r; }
fn S1_sub(a: *S1, b: *S1) { return a; }   # hands its LEFT operand back
fn S1_mul(a: *S1, b: *S1) { return b; }   # hands its RIGHT operand back
fn t1_ptp(q: *S1, k) { return dP1(q, k); }
fn t1_glob(k) { return dP1(G1, k); }
fn t1_bv(q: *S1, k) { var s = S1 { 5 }; var v = byv1(s); return dP1(q, k + v - 5); }
fn t1_idl(k) { var s = S1 { 5 }; var x = idp1(s); return dU1(x, k); }
fn t1_idc(k) { var x = idp1(mk1(5)); return dU1(x, k); }
fn t1_idm(q: *S1, k) { var x = idp1(q.dup()); return dU1(x, k); }
fn t1_ido(k) { var s = S1 { 2 }; var t = S1 { 3 }; var x = idp1(s + t); return dU1(x, k); }
fn t1_idf(k) { var h: HS; h.k = 0; h.inner.v = 5; var x = idp1(h.inner); return dU1(x, k); }
# The other operand is the global G1 (its own address), so each row's only frame address is the one
# under test.
fn t1_opn(k) { var s = S1 { 5 }; var x = G1 * s; return dU1(x, k); }
fn t1_opl(k) { var s = S1 { 5 }; var x = s - G1; return dU1(x, k); }
fn t1_opt(k) { var x = G1 * mk1(5); return dU1(x, k); }
fn t1_optp(k) { var x = G1 * (mk1(5)); return dU1(x, k); }
fn t1_opf(k) { var h: HS; h.k = 0; h.inner.v = 5; var x = G1 * h.inner; return dU1(x, k); }
fn t1_loc(k) { var s = S1 { 5 }; return dP1(s, k); }
fn t1_call(k) { return dP1(mk1(5), k); }
fn t1_aid(k) { var s = S1 { 5 }; return dU1(idp1(s), k); }
fn t1_aop(k) { var s = S1 { 5 }; var t = S1 { 9 }; return dU1(s - t, k); }
# Inside a loop the verdict waits for the loop's end (rule 2): with no frame address in the loop
# a `*S1` callee keeps its `jmp`, as 6.6.19 kept it and 6.6.20 did not (it diverted every
# address-passed callee inside a loop, the price it paid for `t1_lpa`). CHANGELOG [6.7.3]
fn t1_lp(q: *S1, k) {
    var i = 0;
    while (i < 2) {
        if (i == 1) { return dP1(q, k); }
        i = i + 1;
    }
    return 0;
}
fn t1_lpa(k) {
    var s = S1 { 5 };
    var x = 0;
    var i = 0;
    while (i < 2) {
        if (i == 1) { return dP1(x, k); }
        x = &s;
        i = i + 1;
    }
    return 0;
}
fn walk1(p: *S1, n, acc) {
    if (n == 0) { return acc; }
    return walk1(p, n - 1, acc + p.v);
}
fn cnt1g(p: *S1, n, acc) {
    if (n == 0) { return acc; }
    return cnt1g(G1, n - 1, acc + p.v);
}

fn check_struct_ptr_tailcalls(): i64 {
    alloc_init();
    var q = P3 { 3, 4, 5 };
    var vv: f64v2 = mkv(1, 2);
    var w2 = alloc(32);
    store64(w2, 0); store64(w2 + 8, 11); store64(w2 + 16, 22); store64(w2 + 24, 33);
    # Each probe's depth when the checker calls it directly.
    dP(q, 0);
    var baseP = _dmark;
    dV(q, 0);
    var baseV = _dmark;
    dVec(vv, 0);
    var baseVec = _dmark;
    dQ(q, w2);
    var baseQ = _dmark;
    dU(w2, 0);
    var baseU = _dmark;
    var q1 = S1 { 5 };
    dP1(q1, 0);
    var baseP1 = _dmark;
    dU1(w2, 0);
    var baseU1 = _dmark;
    var r = 0;

    test_group("kept: the tail call reaches the callee at the caller's depth");
    r = t_ptp(q, 1);
    assert_eq(r, 13, "a forwarded `q: *T` parameter: value");
    assert_eq(_same(_dmark, baseP), 1, "a forwarded `q: *T` parameter: kept");
    r = t_raw(1);
    assert_eq(r, 25, "an untyped pointer local into `*T`: value");
    assert_eq(_same(_dmark, baseP), 1, "an untyped pointer local into `*T`: kept");
    r = t_glob(1);
    assert_eq(r, 61, "a global struct into `*T`: value");
    assert_eq(_same(_dmark, baseP), 1, "a global struct into `*T`: kept");
    r = t_globv(1);
    assert_eq(r, 61, "a global struct into a by-value `T`: value");
    assert_eq(_same(_dmark, baseV), 1, "a global struct into a by-value `T`: kept");
    r = t_fld(w2, 1);
    assert_eq(r, 67, "`w.inner` through a `*W` parameter: value");
    assert_eq(_same(_dmark, baseP), 1, "`w.inner` through a `*W` parameter: kept");
    r = t_tloc(q, 1);
    assert_eq(r, 13, "a `*T` local forwarding a parameter: value");
    assert_eq(_same(_dmark, baseP), 1, "a `*T` local forwarding a parameter: kept");
    r = t_theap(1);
    assert_eq(r, 25, "a `*T` local holding a heap pointer: value");
    assert_eq(_same(_dmark, baseP), 1, "a `*T` local holding a heap pointer: kept");
    r = t_tfld(w2, 1);
    assert_eq(r, 67, "`x.inner` through a `*W` local: value");
    assert_eq(_same(_dmark, baseP), 1, "`x.inner` through a `*W` local: kept");
    r = t_pcall(q, 1);
    assert_eq(r, 13, "a plain call returning a pointer: value");
    assert_eq(_same(_dmark, baseP), 1, "a plain call returning a pointer: kept");
    r = t_pmode(1);
    assert_eq(r, 25, "a pointer-mode struct local into `*T`: value");
    assert_eq(_same(_dmark, baseP), 1, "a pointer-mode struct local into `*T`: kept");
    r = t_before(q, 1, 1);
    assert_eq(r, 13, "a return before the frame address exists: value");
    assert_eq(_same(_dmark, baseP), 1, "a return before the frame address exists: kept");
    r = t_before(q, 1, 0);
    assert_eq(r, 7, "the same fn's return after it: value");
    assert_eq(_deeper(_dmark, baseP), 1, "the same fn's return after it: diverted");

    test_group("kept: an earlier by-value call copied the address it was given");
    r = t_bvk(q, 1);
    assert_eq(r, 13, "`sumV(s)` (an inline local) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`sumV(s)` (an inline local) before the tail call: kept");
    r = t_bvkc(q, 1);
    assert_eq(r, 13, "`sumV(mk(..))` (a struct call's temp) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`sumV(mk(..))` (a struct call's temp) before the tail call: kept");
    r = t_bvkf(q, 1);
    assert_eq(r, 13, "`sumV(w.inner)` (a field of an inline local) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`sumV(w.inner)` (a field of an inline local) before the tail call: kept");
    r = t_bvkp(q, q, 1);
    assert_eq(r, 13, "`sumV(p)` (a by-value parameter's copy) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`sumV(p)` (a by-value parameter's copy) before the tail call: kept");
    r = t_bvkv(q, 1);
    assert_eq(r, 13, "`dVec(v, 0)` (a value-form vector) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`dVec(v, 0)` (a value-form vector) before the tail call: kept");
    r = t_bvkm(q, 1);
    assert_eq(r, 13, "`s.sumv()` (a by-value `self: T`) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`s.sumv()` (a by-value `self: T`) before the tail call: kept");
    r = t_bvko(q, 1);
    assert_eq(r, 13, "`s + t` (an operator taking `a: T, b: T`) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`s + t` (an operator taking `a: T, b: T`) before the tail call: kept");
    r = t_bvkw(q, 1);
    assert_eq(r, 13, "`sumF(s)` (a by-value callee declared below) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`sumF(s)` (a by-value callee declared below) before the tail call: kept");
    r = t_bvka(q, 1);
    assert_eq(r, 13, "`dP(q, k + sumV(s) - 6)` (inside the tail call's arguments): value");
    assert_eq(_same(_dmark, baseP), 1, "`dP(q, k + sumV(s) - 6)` (inside the tail call's arguments): kept");
    r = t_bvkg(q, 1);
    assert_eq(r, 13, "`sumG(s)` (a generic's instance) before the tail call: value");
    assert_eq(_same(_dmark, baseP), 1, "`sumG(s)` (a generic's instance) before the tail call: kept");

    test_group("diverted: an earlier call may keep the address");
    r = t_ptrb(q, 1);
    assert_eq(r, 13, "`sum3p(s)` (a `*T` parameter) before the tail call: value");
    assert_eq(_deeper(_dmark, baseP), 1, "`sum3p(s)` (a `*T` parameter) before the tail call: diverted");
    r = t_nkd(q, 1);
    assert_eq(r, 13, "`nk6(s)` (a `#naked` fn) before the tail call: value");
    assert_eq(_deeper(_dmark, baseP), 1, "`nk6(s)` (a `#naked` fn) before the tail call: diverted");
    r = t_ptrbf(q, 1);
    assert_eq(r, 13, "`sum3f(s)` (a `*T` callee declared below) before the tail call: value");
    assert_eq(_deeper(_dmark, baseP), 1, "`sum3f(s)` (a `*T` callee declared below) before the tail call: diverted");
    r = t_nkdf(q, 1);
    assert_eq(r, 13, "`nk6f(s)` (a `#naked` fn declared below) before the tail call: value");
    assert_eq(_deeper(_dmark, baseP), 1, "`nk6f(s)` (a `#naked` fn declared below) before the tail call: diverted");

    test_group("diverted: the argument is an address in the caller's frame");
    r = t_loc(1);
    assert_eq(r, 7, "an inline struct local into `*T`: value");
    assert_eq(_deeper(_dmark, baseP), 1, "an inline struct local into `*T`: diverted");
    r = t_locv(1);
    assert_eq(r, 7, "an inline struct local into a by-value `T`: value");
    assert_eq(_deeper(_dmark, baseV), 1, "an inline struct local into a by-value `T`: diverted");
    r = t_ifld(1);
    assert_eq(r, 16, "a field of an inline struct local into `*T`: value");
    assert_eq(_deeper(_dmark, baseP), 1, "a field of an inline struct local into `*T`: diverted");
    r = t_bvp(q, 1);
    assert_eq(r, 13, "a forwarded by-value parameter into `*T`: value");
    assert_eq(_deeper(_dmark, baseP), 1, "a forwarded by-value parameter into `*T`: diverted");
    r = t_bvv(q, 1);
    assert_eq(r, 13, "a forwarded by-value parameter into a by-value `T`: value");
    assert_eq(_deeper(_dmark, baseV), 1, "a forwarded by-value parameter into a by-value `T`: diverted");
    r = t_call(1);
    assert_eq(r, 16, "a struct call's temp into `*T`: value");
    assert_eq(_deeper(_dmark, baseP), 1, "a struct call's temp into `*T`: diverted");
    r = t_vec(1);
    assert_eq(r, 43, "a value-form vector local: value");
    assert_eq(_deeper(_dmark, baseVec), 1, "a value-form vector local: diverted");
    r = t_tamp(1);
    assert_eq(r, 7, "a `*T` local holding `&local`: value");
    assert_eq(_deeper(_dmark, baseP), 1, "a `*T` local holding `&local`: diverted");
    r = t_pcloc(1);
    assert_eq(r, 7, "a plain call given an inline struct local: value");
    assert_eq(_deeper(_dmark, baseP), 1, "a plain call given an inline struct local: diverted");

    test_group("diverted: an address in the caller's frame laundered through a value");
    r = t_idl(1);
    assert_eq(r, 7, "`var x = idp(s)` (an inline local): value");
    assert_eq(_deeper(_dmark, baseP), 1, "`var x = idp(s)` (an inline local): diverted");
    r = t_idc(1);
    assert_eq(r, 7, "`var x = idp(mk(..))` (a struct call's temp): value");
    assert_eq(_deeper(_dmark, baseP), 1, "`var x = idp(mk(..))` (a struct call's temp): diverted");
    r = t_idf(1);
    assert_eq(r, 7, "`var x = idp(w.inner)` (a field of an inline local): value");
    assert_eq(_deeper(_dmark, baseP), 1, "`var x = idp(w.inner)` (a field of an inline local): diverted");
    r = t_idv(q, 1);
    assert_eq(r, 13, "`var x = idp(p)` (a by-value parameter's copy): value");
    assert_eq(_deeper(_dmark, baseP), 1, "`var x = idp(p)` (a by-value parameter's copy): diverted");
    r = t_idm(q, 1);
    assert_eq(r, 13, "`var x = idp(q.cp())` (a method result's temp): value");
    assert_eq(_deeper(_dmark, baseP), 1, "`var x = idp(q.cp())` (a method result's temp): diverted");
    r = t_rep(q, 1);
    assert_eq(r, 7, "`p = idpt(s)` on a `*T` parameter: value");
    assert_eq(_deeper(_dmark, baseP), 1, "`p = idpt(s)` on a `*T` parameter: diverted");
    r = t_bld(1);
    assert_eq(r, 7, "a builder `p3_set(s, 1)` returning its argument: value");
    assert_eq(_deeper(_dmark, baseP), 1, "a builder `p3_set(s, 1)` returning its argument: diverted");
    r = t_self(1);
    assert_eq(r, 7, "`var x = s.me()` (a method's `self`): value");
    assert_eq(_deeper(_dmark, baseP), 1, "`var x = s.me()` (a method's `self`): diverted");
    r = t_oper(1);
    assert_eq(r, 7, "`var x = s + t` (an operator's operand): value");
    assert_eq(_deeper(_dmark, baseP), 1, "`var x = s + t` (an operator's operand): diverted");
    r = t_ul(1);
    assert_eq(r, 7, "`var x = idp(s)` into an untyped callee: value");
    assert_eq(_deeper(_dmark, baseU), 1, "`var x = idp(s)` into an untyped callee: diverted");
    r = t_lpa(1);
    assert_eq(r, 7, "`x = &s` after the return, inside a loop: value");
    assert_eq(_deeper(_dmark, baseP), 1, "`x = &s` after the return, inside a loop: diverted");
    r = t_lpc(1);
    assert_eq(r, 7, "`x = idp(s)` after the return, inside a loop: value");
    assert_eq(_deeper(_dmark, baseP), 1, "`x = idp(s)` after the return, inside a loop: diverted");
    r = t_nsp(1);
    assert_eq(r, 16, "`dQ(G, s.me())` (the untyped argument): value");
    assert_eq(_deeper(_dmark, baseQ), 1, "`dQ(G, s.me())` (the untyped argument): diverted");
    r = t_inu(1);
    assert_eq(r, 7, "`dP(idu(idp(s)), k)`: value");
    assert_eq(_deeper(_dmark, baseP), 1, "`dP(idu(idp(s)), k)`: diverted");
    r = t_um(1);
    assert_eq(r, 7, "`dU(s.me(), k)` into an untyped callee: value");
    assert_eq(_deeper(_dmark, baseU), 1, "`dU(s.me(), k)` into an untyped callee: diverted");

    test_group("a `*S` of 8 B or less: every frame-address site counts");
    r = t1_ptp(q1, 1);
    assert_eq(r, 6, "a forwarded `q: *S1` parameter: value");
    assert_eq(_same(_dmark, baseP1), 1, "a forwarded `q: *S1` parameter: kept");
    r = t1_glob(1);
    assert_eq(r, 6, "a global S1 into `*S1`: value");
    assert_eq(_same(_dmark, baseP1), 1, "a global S1 into `*S1`: kept");
    r = t1_bv(q1, 1);
    assert_eq(r, 6, "`byv1(s)` (an S1 by value, no address) before the tail call: value");
    assert_eq(_same(_dmark, baseP1), 1, "`byv1(s)` (an S1 by value, no address) before the tail call: kept");
    r = t1_idl(1);
    assert_eq(r, 6, "`var x = idp1(s)` (an inline S1): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = idp1(s)` (an inline S1): diverted");
    r = t1_idc(1);
    assert_eq(r, 6, "`var x = idp1(mk1(5))` (an S1 call's temp): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = idp1(mk1(5))` (an S1 call's temp): diverted");
    r = t1_idm(q1, 0);
    assert_eq(r, 6, "`var x = idp1(q.dup())` (an S1 method result's temp): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = idp1(q.dup())` (an S1 method result's temp): diverted");
    r = t1_ido(1);
    assert_eq(r, 6, "`var x = idp1(s + t)` (an S1 operator result's temp): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = idp1(s + t)` (an S1 operator result's temp): diverted");
    r = t1_idf(1);
    assert_eq(r, 6, "`var x = idp1(h.inner)` (an S1 field of an inline local): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = idp1(h.inner)` (an S1 field of an inline local): diverted");
    r = t1_opn(1);
    assert_eq(r, 6, "`var x = G1 * s` (a `*S1` right operand, a bare name): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = G1 * s` (a `*S1` right operand, a bare name): diverted");
    r = t1_opl(1);
    assert_eq(r, 6, "`var x = s - G1` (a `*S1` left operand, a bare name): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = s - G1` (a `*S1` left operand, a bare name): diverted");
    r = t1_opt(1);
    assert_eq(r, 6, "`var x = G1 * mk1(5)` (a `*S1` operand's temp): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = G1 * mk1(5)` (a `*S1` operand's temp): diverted");
    r = t1_optp(1);
    assert_eq(r, 6, "`var x = G1 * (mk1(5))` (a parenthesised call operand's temp): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = G1 * (mk1(5))` (a parenthesised call operand's temp): diverted");
    r = t1_opf(1);
    assert_eq(r, 6, "`var x = G1 * h.inner` (a field operand of an inline local): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`var x = G1 * h.inner` (a field operand of an inline local): diverted");
    r = t1_loc(1);
    assert_eq(r, 6, "an inline S1 into `*S1` (the tail call's argument): value");
    assert_eq(_deeper(_dmark, baseP1), 1, "an inline S1 into `*S1` (the tail call's argument): diverted");
    r = t1_call(1);
    assert_eq(r, 6, "an S1 call's temp into `*S1` (the tail call's argument): value");
    assert_eq(_deeper(_dmark, baseP1), 1, "an S1 call's temp into `*S1` (the tail call's argument): diverted");
    r = t1_aid(1);
    assert_eq(r, 6, "`dU1(idp1(s), k)`: value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`dU1(idp1(s), k)`: diverted");
    r = t1_aop(1);
    assert_eq(r, 6, "`dU1(s - t, k)` (a `*S1` operand in the tail call's arguments): value");
    assert_eq(_deeper(_dmark, baseU1), 1, "`dU1(s - t, k)` (a `*S1` operand in the tail call's arguments): diverted");
    r = t1_lp(q1, 1);
    assert_eq(r, 6, "a `*S1` tail call inside a loop: value");
    assert_eq(_same(_dmark, baseP1), 1, "a `*S1` tail call inside a loop, no frame address in it: kept (rule 2)");
    r = t1_lpa(1);
    assert_eq(r, 6, "`x = &s` (an S1) after the return, inside a loop: value");
    assert_eq(_deeper(_dmark, baseP1), 1, "`x = &s` (an S1) after the return, inside a loop: diverted");

    test_group("deep: 1,000,000 levels in constant stack");
    var head = 0;
    var i = 0;
    while (i < 1000000) {
        var nd = alloc(16);
        store64(nd, 1);
        store64(nd + 8, head);
        head = nd;
        i = i + 1;
    }
    assert_eq(walk(head, 0), 1000000, "walk(p.next, ..) over a 1,000,000-node list (p: *Node)");
    assert_eq(walkl(head, 0), 1000000, "`var nx: *Node = p.next; return walkl(nx, ..)`");
    assert_eq(walkc(head, 0), 1000000, "`return walkc(cur.next, ..)` through a `*Node` local");
    assert_eq(walkn(head, 0), 1000000, "`return walkn(nxt(p), ..)`: a pointer-returning call");
    assert_eq(cntq(q, 1000000, 0), 3000000, "a forwarded `q: *T` parameter");
    assert_eq(cntg(G, 1000000, 0), 20000000, "a global struct into `*T`");
    assert_eq(cntv(G, 1000000, 0), 30000000, "a global struct into a by-value `T`");
    var wh = alloc(32);
    store64(wh, 0); store64(wh + 8, 2); store64(wh + 16, 0); store64(wh + 24, 0);
    assert_eq(stepw(wh, 1000000, 0), 2000000, "`w.inner` through a `*W` parameter (mutual recursion)");
    assert_eq(loopv(1000000, 0), 6000000, "`var v = sumV(s)` before the self tail call");
    assert_eq(loopc(1000000, 0), 6000000, "`var v = sumV(mk(..))` before the self tail call");
    assert_eq(loopf(1000000, 0), 6000000, "`var v = sumV(w.inner)` before the self tail call");
    assert_eq(loopa(1000000, 0), 6000000, "`return loopa(n - 1, acc + sumV(s))`");
    assert_eq(loopm(1000000, 0), 6000000, "`var v = s.sumv()` (`self: T`) before the self tail call");
    assert_eq(loopo(1000000, 0), 7000000, "`var v = s + t` (`a: T, b: T`) before the self tail call");
    assert_eq(loopw(1000000, 0), 6000000, "`var v = sumF(s)` (declared below) before the self tail call");
    assert_eq(loopx(1000000, 0), 3000000, "`var x = dVec(v, 0)` (a vector) before the self tail call");
    assert_eq(loopg(1000000, 0), 6000000, "`var v = sumG(s)` (a generic's instance) before the self tail call");
    assert_eq(walk1(q1, 1000000, 0), 5000000, "a forwarded `p: *S1` parameter (lane s-ptr alone diverted it)");
    assert_eq(cnt1g(G1, 1000000, 0), 5000000, "a global S1 into `*S1`");
    return 0;
}
check_struct_ptr_tailcalls();
var r = assert_summary();
