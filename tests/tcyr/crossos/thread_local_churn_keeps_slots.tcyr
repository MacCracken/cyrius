# thread_local_churn_keeps_slots.tcyr — 6.7.18: while threads are created and exit concurrently,
# every live thread keeps its own thread-local slots.
#
# THE DEFECT (arm64 macOS). The slot lookup (lib/thread_local.cyr `_tlocal_base`) returned the main
# thread's array whenever a live-thread counter, `_tls_live`, read 0. thread_create raised the
# counter on the creator, and every exiting thread lowered it, both with plain read-modify-writes:
# `_tls_live = _tls_live + 1` and `if (_tls_live > 0) { _tls_live = _tls_live - 1; }`. When a
# creator's increment raced an exiting thread's decrement, one of the two was lost. Lost
# increments left the count below the number of live threads. Once it read 0, a live worker's
# thread_local_get / _set went to main's array: every library's per-thread state was shared with
# main and with every other such worker. Since 6.7.18 there is no counter. The first thread_create
# records main's key, and only main (or a program before its first thread_create) gets main's array.
#
# THE ROW. RC_CHAINS relay chains of RC_STEPS threads run at once. Each thread checks that its slot
# reads fresh (0), writes its own value, and starts its successor. It then joins its predecessor,
# so creates race exits for the whole run and no stack is left unjoined. Finally it reads its
# value back. Main's own value must survive the run. Where thread_create runs the body inline
# (THREADS_CONCURRENT = 0, the serial peer) a chain nests, so it is kept short and joins nothing.
#
# RED ON THE PARENT (arm64 macOS; the release gate runs this row on ecb). The parent's registry
# and thread_create were extracted verbatim and run this workload on Linux threads, with gettid
# standing in for TPIDRRO_EL0. At 16 chains x 1000 steps, 32 of 55 runs went RED on x86, and 3 of
# 3 under qemu-aarch64. Threads saw foreign slots at start, and main's value came back as a
# worker's. Every RED run counted 0 registry overflows, so the counter alone caused them. With the
# counter gone, 0 of 160 runs went RED (the final registry). Every other target has no counter and
# passes on the parent: Linux blocks come from clone, Windows blocks from TlsGetValue, and
# x86-macOS blocks hang off the gs header.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/syscalls.cyr"
include "lib/atomic.cyr"
include "lib/chrono.cyr"
include "lib/thread.cyr"
include "lib/thread_local.cyr"

enum RelayChurn {
    RC_CHAINS = 16;
    RC_STEPS = 1000;       # per chain where threads are real
    RC_STEPS_SERIAL = 8;   # per chain on the serial peer, where a chain is nested calls
    RC_DEADLINE = 120000;  # ms; a stalled chain FAILS, it does not hang the leg
}

var _rc_slot = 0;
var _rc_steps = 0;
var _rc_hs = 0;            # handle of thread n at word n (chain c's threads are c*steps ..)
var _rc_done = 0;          # chains finished (or ended by a refused thread_create)
var _rc_fresh_bad = 0;
var _rc_back_bad = 0;
var _rc_refused = 0;
var _rc_late = 0;

fn _rc_step(n): i64 {
    var i = n % _rc_steps;
    if (thread_local_get(_rc_slot) != 0) { atomic_fetch_add(&_rc_fresh_bad, 1); }
    thread_local_set(_rc_slot, 0x100000 + n);
    if (i + 1 < _rc_steps) {
        var h = thread_create(&_rc_step, n + 1);
        if (h == 0) {
            atomic_fetch_add(&_rc_refused, 1);
            atomic_fetch_add(&_rc_done, 1);
        }
        atomic_store(_rc_hs + (n + 1) * 8, h);
    } else {
        atomic_fetch_add(&_rc_done, 1);
    }
    if (THREADS_CONCURRENT == 1) {
        if (i > 0) {                                   # join the predecessor once its handle is out
            var t0 = clock_now_ms();
            while (atomic_load(_rc_hs + (n - 1) * 8) == 0) {
                if (clock_now_ms() - t0 > RC_DEADLINE) { atomic_fetch_add(&_rc_late, 1); break; }
            }
            var hp = atomic_load(_rc_hs + (n - 1) * 8);
            if (hp != 0) { thread_join(hp); }
        }
    }
    if (thread_local_get(_rc_slot) != 0x100000 + n) { atomic_fetch_add(&_rc_back_bad, 1); }
    return 0;
}

fn main(): i64 {
    alloc_init();
    thread_local_init();
    test_group("thread-local slots stay per-thread while threads are created and exit concurrently");

    _rc_slot = thread_local_alloc();
    assert_eq(_rc_slot >= 16, 1, "thread_local_alloc handed out a library slot (>= 16)");
    thread_local_set(_rc_slot, 0x51);
    _rc_steps = RC_STEPS;
    if (THREADS_CONCURRENT == 0) { _rc_steps = RC_STEPS_SERIAL; }
    _rc_hs = alloc(RC_CHAINS * _rc_steps * 8);
    memset(_rc_hs, 0, RC_CHAINS * _rc_steps * 8);

    var c = 0;
    while (c < RC_CHAINS) {
        var h = thread_create(&_rc_step, c * _rc_steps);
        if (h == 0) {
            atomic_fetch_add(&_rc_refused, 1);
            atomic_fetch_add(&_rc_done, 1);
        }
        atomic_store(_rc_hs + c * _rc_steps * 8, h);
        c = c + 1;
    }
    var t0 = clock_now_ms();
    while (atomic_load(&_rc_done) < RC_CHAINS) {
        if (clock_now_ms() - t0 > RC_DEADLINE) { break; }
        sleep_ms(1);
    }
    assert_eq(atomic_load(&_rc_done), RC_CHAINS, "every chain ran to its end before the deadline");
    if (THREADS_CONCURRENT == 1) {
        c = 0;
        while (c < RC_CHAINS) {                        # each chain's last thread; the rest were joined in-chain
            var last = _rc_hs + (c * _rc_steps + _rc_steps - 1) * 8;
            var t1 = clock_now_ms();
            while (atomic_load(last) == 0) {
                if (clock_now_ms() - t1 > RC_DEADLINE) { break; }
                sleep_ms(1);
            }
            var hl = atomic_load(last);
            if (hl != 0) { thread_join(hl); }
            c = c + 1;
        }
    }
    if (_rc_fresh_bad != 0 || _rc_back_bad != 0) {
        print_num(_rc_fresh_bad); println(" threads saw another thread's slot at start");
        print_num(_rc_back_bad); println(" threads read back another thread's value");
    }
    assert_eq(_rc_refused, 0, "no thread_create was refused");
    assert_eq(_rc_late, 0, "no predecessor's handle missed the deadline");
    assert_eq(_rc_fresh_bad, 0, "every thread's slot read fresh (0) at start, never another thread's value");
    assert_eq(_rc_back_bad, 0, "every thread read back its own value past its neighbours' start and exit");
    assert_eq(thread_local_get(_rc_slot), 0x51, "main's slot is still main's after the churn");

    var r = assert_summary();
    return r;
}
var ec = main();
syscall(60, ec);
