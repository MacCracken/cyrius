    _mx_cliSrvEku_key = hex_decode("308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420aecdc0a32f448bce07e2605ec4c75803f0c2085cae4b5a90e46f3e53107eebc7a144034200046839f85c483605c8be06f05b4dca16474bfe3402741b5059c3722c7d7da01229549d3b1ddbce23fa64d16ced763b9aeb2a4ef1231c9d98ef416bc863023c81c1", 276);
