# ---- the in-memory transport: two logs, each written by one side's latest run ----
var _mx_cs = 0;          # client -> server bytes the server reads (the client's last run)
var _mx_cs_len = 0;
var _mx_cs_next = 0;     # what the running client writes
var _mx_cs_next_len = 0;
var _mx_sc = 0;          # server -> client
var _mx_sc_len = 0;
var _mx_sc_next = 0;
var _mx_sc_next_len = 0;
var _mx_cs_rd = 0;       # the server's read cursor into _mx_cs
var _mx_sc_rd = 0;       # the client's read cursor into _mx_sc
var _mx_overflow = 0;
var _mx_eof = 0;         # the running side read past the end of the other's log

fn _mx_read(h, buf, n): i64 {
    var src = _mx_sc;
    var len = _mx_sc_len;
    var cur = _mx_sc_rd;
    if (h == MX_SERVER) {
        src = _mx_cs;
        len = _mx_cs_len;
        cur = _mx_cs_rd;
    }
    var avail = len - cur;
    if (avail <= 0) {                                   # EOF: the other side has not got here yet
        _mx_eof = 1;
        return 0;
    }
    var k = n;
    if (k > avail) { k = avail; }
    memcpy(buf, src + cur, k);
    if (h == MX_SERVER) { _mx_cs_rd = cur + k; }
    else { _mx_sc_rd = cur + k; }
    return k;
}

# A tampering client (rows below): _MX_TAMPER_DROP_CV removes the client's CertificateVerify from
# its flight — the 1.2 message from its plaintext handshake record, the middle one of the three
# sealed 1.3 records (Certificate, CertificateVerify, Finished) — and _MX_TAMPER_ADD_CV (1.2) puts
# an unrequested CertificateVerify after an empty Certificate and the ClientKeyExchange.
enum MxTamper { _MX_TAMPER_NONE = 0; _MX_TAMPER_DROP_CV = 1; _MX_TAMPER_ADD_CV = 2; }
var _mx_tamper = 0;
var _mx_tbuf = 0;

fn _mx_rec_len(p): i64 { return 5 + (((load8(p + 3) & 0xFF) << 8) | (load8(p + 4) & 0xFF)); }

# The client's write `buf`/`n`, tampered into _mx_tbuf. Returns the tampered length.
fn _mx_tamper_write(buf, n): i64 {
    if (n < 5) { memcpy(_mx_tbuf, buf, n); return n; }
    var ct = load8(buf) & 0xFF;
    if (ct == TLS_CT_HANDSHAKE) {
        if ((load8(buf + 5) & 0xFF) != TLS_HS_CERTIFICATE) { memcpy(_mx_tbuf, buf, n); return n; }
        var rl = _mx_rec_len(buf);
        var o = 5;
        var pos = 5;
        while (pos + 4 <= rl) {
            var mt = load8(buf + pos) & 0xFF;
            var ml = 4 + (((load8(buf + pos + 1) & 0xFF) << 16) | ((load8(buf + pos + 2) & 0xFF) << 8) | (load8(buf + pos + 3) & 0xFF));
            var keep = 1;
            if (_mx_tamper == _MX_TAMPER_DROP_CV) { if (mt == TLS_HS_CERTIFICATE_VERIFY) { keep = 0; } }
            if (keep == 1) {
                memcpy(_mx_tbuf + o, buf + pos, ml);
                o = o + ml;
            }
            if (_mx_tamper == _MX_TAMPER_ADD_CV) {
                if (mt == TLS_HS_CLIENT_KEY_EXCHANGE) {
                    memcpy(_mx_tbuf + o, "\x0f\x00\x00\x04\x04\x03\x00\x00", 8);
                    o = o + 8;
                }
            }
            pos = pos + ml;
        }
        memcpy(_mx_tbuf, buf, 3);
        store8(_mx_tbuf + 3, ((o - 5) >> 8) & 0xFF);
        store8(_mx_tbuf + 4, (o - 5) & 0xFF);
        memcpy(_mx_tbuf + o, buf + rl, n - rl);         # any record after it, as written
        return o + n - rl;
    }
    if (ct == TLS_CT_APPLICATION_DATA) {
        if (_mx_tamper == _MX_TAMPER_DROP_CV) {
            var r1 = _mx_rec_len(buf);
            if (r1 < n) {
                var r2 = _mx_rec_len(buf + r1);
                if (r1 + r2 < n) {
                    var r3 = _mx_rec_len(buf + r1 + r2);
                    if (r1 + r2 + r3 == n) {                # Certificate, CertificateVerify, Finished
                        memcpy(_mx_tbuf, buf, r1);
                        memcpy(_mx_tbuf + r1, buf + r1 + r2, r3);
                        return r1 + r3;
                    }
                }
            }
        }
    }
    memcpy(_mx_tbuf, buf, n);
    return n;
}

fn _mx_write(h, buf, n): i64 {
    if (h == MX_CLIENT) {
        if (_mx_tamper != _MX_TAMPER_NONE) {
            var tn = _mx_tamper_write(buf, n);
            if (_mx_cs_next_len + tn > MX_LOG_CAP) { _mx_overflow = 1; return 0 - 1; }
            memcpy(_mx_cs_next + _mx_cs_next_len, _mx_tbuf, tn);
            _mx_cs_next_len = _mx_cs_next_len + tn;
            return n;
        }
    }
    if (h == MX_SERVER) {
        if (_mx_sc_next_len + n > MX_LOG_CAP) { _mx_overflow = 1; return 0 - 1; }
        memcpy(_mx_sc_next + _mx_sc_next_len, buf, n);
        _mx_sc_next_len = _mx_sc_next_len + n;
        return n;
    }
    if (_mx_cs_next_len + n > MX_LOG_CAP) { _mx_overflow = 1; return 0 - 1; }
    memcpy(_mx_cs_next + _mx_cs_next_len, buf, n);
    _mx_cs_next_len = _mx_cs_next_len + n;
    return n;
}

fn _mx_now(): i64 { return 1893456000; }                 # 2030-01-01 00:00 UTC

# Deterministic entropy (xorshift64), reseeded at the start of every run of a side.
var _mx_rng = 1;
fn _mx_seed(s): i64 { _mx_rng = s; return 0; }
fn _mx_rand(buf, n, fl): i64 {
    var i = 0;
    while (i < n) {
        var x = _mx_rng;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        _mx_rng = x;
        store8(buf + i, (x >> 24) & 0xFF);
        i = i + 1;
    }
    return n;
}

# ---- one row ----
var _mx_ca_arena = 0;    # the client's Allocator, reset every run
var _mx_sv_arena = 0;    # the server's
# What the server's accept hook does (a consumer's hook: lib/tls.cyr verbs on the native handle).
var _mx_h_mode = 0;      # the OpenSSL SSL_VERIFY_* mode passed to tls_set_verify
var _mx_h_root = 0;      # a DER trust root, or 0 for none
var _mx_h_root_n = 0;
# Observations: [0] client tls_native_connect, [1] client read after "ping" (-99 when not run),
# [2] server accept (TLS_OK or its LAST_ERR), [3] server read (-99), [4] tls_native_get_peer_cert_der
# on the server, [5] tls_get_peer_spki_der on the server's shim, [6] rounds to the fixed point (0 =
# never settled), [7] the client's TLS_CTX_OFF_CERT_REQUESTED.
var _mx_obs: i64[8];
var _mx_c_eof = 0;       # the last client run read past the end of the server's log
var _mx_s_eof = 0;       # the last server run, of the client's

fn _mx_srv_hook(hctx, handle): i64 {
    if (tls_set_verify(handle, _mx_h_mode, 0) != 0) { return 1; }
    if (_mx_h_root != 0) {
        if (tls_native_set_ca_bundle(handle, _mx_h_root, _mx_h_root_n, 1) != TLS_OK) { return 1; }
    }
    return 0;
}

fn _mx_client_run(v12, ccert, cclen, ckey, cklen): i64 {
    reset_via(_mx_ca_arena);
    _mx_seed(0x2468ACE1);
    _mx_eof = 0;
    _mx_sc_rd = 0;
    _mx_cs_next_len = 0;
    var c = tls_native_new_client_in(_mx_ca_arena, 0, 0);
    tls_native_set_verify(c, TLS_VERIFY_NONE);            # the server's own chain is not under test
    if (v12 == 1) { tls_native_set_version_range(c, TLS_VERSION_1_2, TLS_VERSION_1_2); }
    if (ccert != 0) {
        tls_native_set_client_cert(c, ccert, cclen, 1);
        tls_native_set_client_key(c, ckey, cklen);
    }
    var rc = tls_native_connect(c, MX_CLIENT);
    _mx_obs[0] = rc;
    _mx_obs[1] = 0 - 99;
    if (rc == TLS_OK) {
        tls_native_write(c, "ping", 4);
        var b[64];
        store64(&b, 0);
        var n = tls_native_read(c, &b, 64);
        _mx_obs[1] = n;
        if (n == 4) {
            if (memeq(&b, "pong", 4) != 1) { _mx_obs[1] = 0 - 98; }
        }
    }
    _mx_obs[7] = load64(c + TLS_CTX_OFF_CERT_REQUESTED);
    _mx_c_eof = _mx_eof;
    var t = _mx_cs;
    _mx_cs = _mx_cs_next;
    _mx_cs_next = t;
    _mx_cs_len = _mx_cs_next_len;
    return 0;
}

fn _mx_server_run(): i64 {
    reset_via(_mx_sv_arena);
    _mx_seed(0x13579BDF);
    _mx_eof = 0;
    _mx_cs_rd = 0;
    _mx_sc_next_len = 0;
    var creds: i64[4];
    store64(&creds, _mx_srvEd);                         # Ed25519: the cheapest server signature to replay
    store64(&creds + 8, _mx_srvEd_n);
    store64(&creds + 16, _mx_srvEd_key);
    store64(&creds + 24, _mx_srvEd_key_n);
    var sh = tls_accept_alloc_in(_mx_sv_arena, MX_SERVER, &creds, &_mx_srv_hook, 0);
    _mx_obs[2] = 0 - 999;
    _mx_obs[3] = 0 - 99;
    _mx_obs[4] = 0 - 99;
    _mx_obs[5] = 0 - 99;
    if (sh != 0) {
        var nctx = load64(sh);
        if (tls_accept_complete(sh) == 1) {
            _mx_obs[2] = TLS_OK;
            var b[64];
            store64(&b, 0);
            var n = tls_read(sh, &b, 64);
            _mx_obs[3] = n;
            if (n == 4) {
                if (memeq(&b, "ping", 4) == 1) { tls_write(sh, "pong", 4); }
                else { _mx_obs[3] = 0 - 98; }
            }
        } else {
            var le = tls_native_get_last_error(nctx);
            if (le == 0) { le = 0 - 777; }              # a failure with no error recorded never reads as TLS_OK
            _mx_obs[2] = le;
        }
        var g = alloc(4096);
        _mx_obs[4] = tls_native_get_peer_cert_der(nctx, g, 4096);
        _mx_obs[5] = tls_get_peer_spki_der(sh, g, 4096);
    }
    _mx_s_eof = _mx_eof;
    var t = _mx_sc;
    _mx_sc = _mx_sc_next;
    _mx_sc_next = t;
    _mx_sc_len = _mx_sc_next_len;
    return 0;
}

# Replay one row to its fixed point. `v12` pins the CLIENT to TLS 1.2 (the server keeps its default
# 1.2..1.3 range and routes on the ClientHello — the downgrade a 1.2-only client chooses).
fn _mx_row(v12, ccert, cclen, ckey, cklen, smode, root, root_n): i64 {
    _mx_h_mode = smode;
    _mx_h_root = root;
    _mx_h_root_n = root_n;
    _mx_cs_len = 0;
    _mx_sc_len = 0;
    _mx_overflow = 0;
    var pc = 0 - 1;
    var ps = 0 - 1;
    var r = 0;
    var settled = 0;
    while (settled == 0) {
        if (r >= MX_ROUNDS_MAX) { settled = 2; }
        if (settled == 0) {
            _mx_client_run(v12, ccert, cclen, ckey, cklen);
            _mx_server_run();
            r = r + 1;
            # Settled: a round in which neither run read past the other's log replays itself
            # exactly (each side consumed only bytes the other's next run writes again), or one in
            # which neither log grew.
            if (_mx_c_eof == 0) {
                if (_mx_s_eof == 0) { settled = 1; }
            }
            if (_mx_cs_len == pc) {
                if (_mx_sc_len == ps) { settled = 1; }
            }
            pc = _mx_cs_len;
            ps = _mx_sc_len;
        }
    }
    _mx_obs[6] = 0;
    if (settled == 1) { _mx_obs[6] = r; }
    assert(_mx_obs[6] > 0, "  the replay settled (both logs stopped growing)");
    assert_eq(_mx_overflow, 0, "  no log overflowed");
    return 0;
}

fn _mx_v(v12): i64 {
    if (v12 == 1) { println("  (client offers TLS 1.2 only; server default range 1.2..1.3)"); return 0; }
    println("  (TLS 1.3)");
    return 0;
}

# A row whose client is authenticated: the handshake completes, ping/pong flow, and the server's
# getters name the client.
fn _mx_ok(label, der_n): i64 {
    assert_eq(_mx_obs[2], TLS_OK, label);
    assert_eq(_mx_obs[0], TLS_OK, "  client connect: TLS_OK");
    assert_eq(_mx_obs[3], 4, "  the server reads the client's \"ping\"");
    assert_eq(_mx_obs[1], 4, "  the client reads the server's \"pong\"");
    assert_eq(_mx_obs[4], der_n, "  tls_native_get_peer_cert_der on the server: the client's leaf");
    if (der_n > 0) { assert(_mx_obs[5] > 0, "  tls_get_peer_spki_der on the server: the client's key"); }
    else { assert_eq(_mx_obs[5], 0, "  tls_get_peer_spki_der on the server: none"); }
    return 0;
}

# A row whose client is refused with `code`: the server fails, names nobody, and tells the client
# (an alert: TLS 1.2 reads it in place of the server's CCS, TLS 1.3 on its first read).
fn _mx_refused(v12, code, label): i64 {
    assert_eq(_mx_obs[2], code, label);
    assert_eq(_mx_obs[4], 0, "  the server's peer getter names nobody");
    assert_eq(_mx_obs[5], 0, "  tls_get_peer_spki_der: none");
    if (v12 == 1) {
        assert_eq(_mx_obs[0], TLS_ERR_ALERT, "  the 1.2 client reads the server's alert in place of its CCS");
    } else {
        assert_eq(_mx_obs[0], TLS_OK, "  the 1.3 client finished its side");
        assert_eq(_mx_obs[1], TLS_ERR_ALERT, "  …and reads the server's alert");
    }
    return 0;
}

fn test_matrix(v12): i64 {
    var PEER = 1;
    var PEER_FAIL = 3;
    var FAIL_ALONE = 2;
    var fail_mode = PEER_FAIL;
    if (v12 == 1) { fail_mode = FAIL_ALONE; }

    test_group("6.6.14 — a client that presents nothing");
    _mx_v(v12);
    _mx_row(v12, 0, 0, 0, 0, PEER, _mx_ca, _mx_ca_n);
    _mx_ok("SSL_VERIFY_PEER, an empty Certificate: accepted with no identity", 0);
    assert_eq(_mx_obs[7], 1, "  the server asked (the client saw a CertificateRequest)");
    _mx_row(v12, 0, 0, 0, 0, fail_mode, _mx_ca, _mx_ca_n);
    _mx_refused(v12, TLS_ERR_CERT_INVALID, "FAIL_IF_NO_PEER_CERT via tls_set_verify, an empty Certificate: CERT_INVALID");

    test_group("6.6.14 — a certificate that chains to the server's root");
    _mx_v(v12);
    _mx_row(v12, _mx_cli, _mx_cli_n, _mx_cli_key, _mx_cli_key_n, PEER, _mx_ca, _mx_ca_n);
    _mx_ok("P-256 leaf issued by the trusted CA: authenticated", _mx_cli_n);
    _mx_row(v12, _mx_cliEd, _mx_cliEd_n, _mx_cliEd_key, _mx_cliEd_key_n, fail_mode, _mx_ca, _mx_ca_n);
    _mx_ok("Ed25519 leaf, FAIL_IF_NO_PEER_CERT: authenticated", _mx_cliEd_n);
    _mx_row(v12, _mx_cli384, _mx_cli384_n, _mx_cli384_key, _mx_cli384_key_n, PEER, _mx_ca, _mx_ca_n);
    _mx_ok("P-384 leaf: authenticated", _mx_cli384_n);

    test_group("6.6.14 — certificates the server must refuse");
    _mx_v(v12);
    _mx_row(v12, _mx_self, _mx_self_n, _mx_self_key, _mx_self_key_n, PEER, _mx_ca, _mx_ca_n);
    _mx_refused(v12, TLS_ERR_CERT_INVALID, "an UNTRUSTED self-signed leaf: CERT_INVALID");
    _mx_row(v12, _mx_cliOther, _mx_cliOther_n, _mx_cliOther_key, _mx_cliOther_key_n, PEER, _mx_ca, _mx_ca_n);
    _mx_refused(v12, TLS_ERR_CERT_INVALID, "a leaf from another CA: CERT_INVALID");
    _mx_row(v12, _mx_cliExp, _mx_cliExp_n, _mx_cliExp_key, _mx_cliExp_key_n, PEER, _mx_ca, _mx_ca_n);
    _mx_refused(v12, TLS_ERR_CERT_INVALID, "an EXPIRED leaf from the trusted CA: CERT_INVALID");
    _mx_row(v12, _mx_cliSrvEku, _mx_cliSrvEku_n, _mx_cliSrvEku_key, _mx_cliSrvEku_key_n, PEER, _mx_ca, _mx_ca_n);
    _mx_refused(v12, TLS_ERR_CERT_INVALID, "a leaf whose extendedKeyUsage is serverAuth only: CERT_INVALID");
    _mx_row(v12, _mx_cli, _mx_cli_n, _mx_self_key, _mx_self_key_n, PEER, _mx_ca, _mx_ca_n);
    _mx_refused(v12, TLS_ERR_AUTHN, "the trusted leaf with ANOTHER key's CertificateVerify: AUTHN");
    _mx_row(v12, _mx_cli, _mx_cli_n, _mx_cli_key, _mx_cli_key_n, PEER, 0, 0);
    _mx_refused(v12, TLS_ERR_CERT_INVALID, "a server with NO trust roots refuses a presented leaf (fail closed)");

    test_group("6.6.14 — a client that does not prove possession");
    _mx_v(v12);
    _mx_tamper = _MX_TAMPER_DROP_CV;
    _mx_row(v12, _mx_cli, _mx_cli_n, _mx_cli_key, _mx_cli_key_n, PEER, _mx_ca, _mx_ca_n);
    _mx_tamper = _MX_TAMPER_NONE;
    if (v12 == 1) {
        assert_eq(_mx_obs[2], TLS_ERR_PROTOCOL,
          "the trusted leaf with its CertificateVerify REMOVED: refused (its CCS where the CV is due)");
    } else {
        assert_eq(_mx_obs[2], TLS_ERR_DECRYPT,
          "the trusted leaf with its CertificateVerify REMOVED: refused (its Finished where the CV is due)");
    }
    assert_eq(_mx_obs[4], 0, "  …and the server names nobody");
    if (v12 == 1) {
        _mx_tamper = _MX_TAMPER_ADD_CV;
        _mx_row(v12, 0, 0, 0, 0, PEER, _mx_ca, _mx_ca_n);
        _mx_tamper = _MX_TAMPER_NONE;
        assert_eq(_mx_obs[2], TLS_ERR_BAD_HANDSHAKE,
          "an empty Certificate, then an unrequested CertificateVerify: BAD_HANDSHAKE");
    }

    test_group("6.6.14 — a server that does not ask");
    _mx_v(v12);
    _mx_row(v12, _mx_cli, _mx_cli_n, _mx_cli_key, _mx_cli_key_n, 0, _mx_ca, _mx_ca_n);
    _mx_ok("SSL_VERIFY_NONE: no CertificateRequest, the client sends no certificate", 0);
    assert_eq(_mx_obs[7], 0, "  the client saw no CertificateRequest");
    return 0;
}

# A2 at the API: the OpenSSL bitmask -> native mode, never less strict than asked.
fn test_set_verify_modes(): i64 {
    test_group("6.6.14 — tls_set_verify maps SSL_VERIFY_FAIL_IF_NO_PEER_CERT through");
    var s = tls_native_new_server(_mx_srv, _mx_srv_n, _mx_srv_key, _mx_srv_key_n);
    assert_eq(tls_set_verify(s, 3, 0), 0, "tls_set_verify(PEER | FAIL_IF_NO_PEER_CERT)");
    assert_eq(load64(s + TLS_CTX_OFF_VERIFY), TLS_VERIFY_FAIL_IF_NO_PEER_CERT, "  -> TLS_VERIFY_FAIL_IF_NO_PEER_CERT");
    tls_set_verify(s, 2, 0);
    assert_eq(load64(s + TLS_CTX_OFF_VERIFY), TLS_VERIFY_FAIL_IF_NO_PEER_CERT,
      "FAIL_IF_NO_PEER_CERT alone -> FAIL (stricter than OpenSSL, which ignores it without PEER)");
    tls_set_verify(s, 1, 0);
    assert_eq(load64(s + TLS_CTX_OFF_VERIFY), TLS_VERIFY_PEER, "PEER -> TLS_VERIFY_PEER");
    tls_set_verify(s, 5, 0);
    assert_eq(load64(s + TLS_CTX_OFF_VERIFY), TLS_VERIFY_PEER, "PEER | CLIENT_ONCE -> TLS_VERIFY_PEER");
    tls_set_verify(s, 8, 0);
    assert_eq(load64(s + TLS_CTX_OFF_VERIFY), TLS_VERIFY_PEER, "POST_HANDSHAKE alone -> TLS_VERIFY_PEER (never looser)");
    tls_set_verify(s, 0, 0);
    assert_eq(load64(s + TLS_CTX_OFF_VERIFY), TLS_VERIFY_NONE, "0 -> TLS_VERIFY_NONE");
    return 0;
}

fn _mx_all(): i64 {
    alloc_init();
    _mx_fixtures();
    _mx_cs = alloc(MX_LOG_CAP);
    _mx_cs_next = alloc(MX_LOG_CAP);
    _mx_sc = alloc(MX_LOG_CAP);
    _mx_sc_next = alloc(MX_LOG_CAP);
    _mx_tbuf = alloc(MX_LOG_CAP);
    _mx_ca_arena = arena_allocator(2097152);
    _mx_sv_arena = arena_allocator(2097152);
    tls_native_set_transport(&_mx_read, &_mx_write, &_mx_now);
    tls_native_set_entropy(&_mx_rand);
    test_set_verify_modes();
    test_matrix(0);
    test_matrix(1);
    tls_native_set_entropy(0);
    tls_native_set_transport(0, 0, 0);
    return 0;
}

_mx_all();
var r = assert_summary();
