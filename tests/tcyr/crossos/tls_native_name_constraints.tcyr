# tls_native_name_constraints.tcyr — 6.7.18 (CYRIUS-2026-0042, the native-TLS side): the native chain
# verifier enforces X.509 nameConstraints (RFC 5280 §4.2.1.10, §6.1.3(b)-(c), §6.1.4(g)) — every CA
# on the path it selects, the trust anchor included, over every certificate below that CA, the
# leaf always included.
#
# THE DEFECT (the 2026-10-22 audit, docs/audit/2026-10-22-security-audit.md): _tn_verify_chain
# (lib/tls_native_hs12.cyr) — the client's verifier of a server chain and the mTLS server's verifier
# of a client chain — checked the window, keyUsage / pathLen, extendedKeyUsage and the trust policy,
# and never a nameConstraints extension; sigil 3.13.13 dropped a non-critical one at parse (and
# refused a critical one as unhandled — a fail-closed by accident). A name-constrained subordinate
# CA under a trusted root could vouch for any host: the audit's repro (root -> "Constrained Sub-CA
# good.test", nameConstraints=permitted;DNS:good.test, NON-critical -> a leaf for victim-bank.test)
# read tls_native_client_verify_chain 0 and tls_native_client_verify_hostname 0, and a native
# connect to `openssl s_server` presenting it completed (OpenSSL: error 47, permitted subtree
# violation). sigil 3.13.14 parses the extension and its _x509_verify_link applies the DIRECT
# issuer's constraints — but a CA's constraints bind every certificate below it, the link check
# exempts a self-issued CA child (it cannot tell whether that child is the leaf), and the trust
# anchor's constraints reach the leaf only through the chain. So the walker applies them itself
# (_tn_nc_below_ok, through sigil's x509_name_constraints_check): each candidate intermediate and
# each trust root, while the path is SELECTED, against the leaf and every intermediate already on
# the path (a self-issued intermediate exempt, §6.1.3(b)). A CA that does not allow the path below
# it is skipped and path building goes on, as a wrongly purposed CA is (6.6.16); with none left the
# chain is refused, TLS_ERR_CERT_INVALID. The end-to-end rows (the native client against `openssl
# s_server` presenting the chains) are tests/gates/platform/tls_native_name_constraints_openssl.sh.
#
# THE FIXTURES (openssl 3.6.5, P-256, every certificate valid 2025-01-01 .. 2049-12-31, read at a
# pinned 2030-01-01, so no row is a time bomb). Families share one subject and one key, so any
# member signs for any other and the constraint is a row's only variable:
#   roots  root (CN=nc-root, no constraint) and root_nc (the same subject and key,
#          critical permitted;DNS:good.test);
#   ints   CN=nc-int, one key, issued by the root key, pathlen 1: int_nc (NON-critical
#          permitted;DNS:good.test — the audit's shape), int_ncc (the same, critical), int_plain
#          (none), int_ex (excluded;DNS:bad.good.test), int_ip (permitted;IP:192.0.2.0/24), int_xv
#          (excluded;DNS:victim-bank.test); int_si — SELF-ISSUED (issuer = subject = CN=nc-int,
#          a second key, issued by the nc-int key) carrying SAN DNS:victim-bank.test;
#   lower  CN=nc-lower, a CA issued by the nc-int key, no constraint;
#   leaves serverAuth + clientAuth, digitalSignature; issued by the nc-int key: leaf_victim
#          (DNS:victim-bank.test), leaf_www (www.good.test), leaf_apex (good.test), leaf_notgood
#          (notgood.test), leaf_suffix (good.test.evil.example), leaf_bad (x.bad.good.test),
#          leaf_ipok (IP 192.0.2.7), leaf_ipno (IP 198.51.100.7), leaf_dot (victim-bank.test.,
#          a trailing dot), leaf_cn (no SAN, CN=victim-bank.test); by the root key: leaf_r_victim,
#          leaf_r_www; by the nc-lower key: leaf_l_victim, leaf_l_www, leaf_l_bad, leaf_l_dot; by
#          int_si's key: leaf_si_www, leaf_si_victim.
#
# THE VERDICT TABLE (native; `openssl verify -attime 1893456000 -purpose sslserver` on the same
# files: ok, 47 = permitted subtree violation, 48 = excluded subtree violation):
#   leaf_victim   <- int_nc / int_ncc <- root          REFUSED   47 / 47   (the audit's repro)
#   leaf_www / leaf_apex <- int_nc <- root             ok        ok
#   leaf_www      <- int_ncc <- root                   ok        ok        (3.13.13: refused at parse)
#   leaf_notgood / leaf_suffix <- int_nc <- root       REFUSED   47 / 47   (label boundary, suffix)
#   leaf_cn       <- int_nc / int_plain <- root        REFUSED / ok        47 / ok  (CN as dNSName)
#   leaf_bad / leaf_www <- int_ex <- root              REFUSED / ok        48 / ok
#   leaf_ipok / leaf_ipno <- int_ip <- root            ok / REFUSED        ok / 47
#   leaf_dot      <- int_nc <- root                    REFUSED   47
#   leaf_dot      <- int_xv <- root                    REFUSED   ok        (divergence: below)
#   leaf_victim / leaf_www <- int_xv <- root           REFUSED / ok        48 / ok
#   the ANCHOR: leaf_r_victim / leaf_r_www <- root_nc  REFUSED / ok        47 / ok
#     leaf_victim / leaf_www <- int_plain <- root_nc   REFUSED / ok        47 / ok
#     leaf_l_victim / leaf_l_www <- nc-lower <- int_plain <- root_nc
#                                                      REFUSED / ok        47 / ok
#   an UPPER CA: leaf_l_victim / leaf_l_www <- nc-lower <- int_nc <- root
#                                                      REFUSED / ok        47 / ok
#     leaf_l_bad  <- nc-lower <- int_ex <- root        REFUSED   48
#     leaf_l_dot  <- nc-lower <- int_xv / int_nc <- root
#                                                      REFUSED / REFUSED   ok / 47
#   self-issued: leaf_si_www / leaf_si_victim <- int_si <- int_nc <- root
#                                                      ok / REFUSED        ok / 47
#   controls: leaf_victim <- int_plain <- root, leaf_l_victim <- nc-lower <- int_plain <- root: ok
# DIVERGENCE (the trailing dot): sigil drops one trailing dot from the name and the constraint
#   before matching, so `victim-bank.test.` is inside an excluded `victim-bank.test` — OpenSSL
#   3.6.5 compares literally and lets it out. The native hostname check compares literally too,
#   so a client dialling `victim-bank.test.` matches that SAN: the chain is the only guard.
# Path building (the native verifier skips a CA that does not allow the path below it and tries
# the next candidate, as for extendedKeyUsage): [nc-lower, int_nc, int_plain] verifies
# leaf_l_victim through int_plain, which shares int_nc's subject and key — OpenSSL fails on the
# first candidate it picks.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/io.cyr"
include "lib/tls.cyr"

var NC_NOW = 1893456000;   # 2030-01-01 00:00 UTC

var _nc_root = 0;
var _nc_root_nc = 0;
var _nc_int_nc = 0;
var _nc_int_ncc = 0;
var _nc_int_plain = 0;
var _nc_int_ex = 0;
var _nc_int_ip = 0;
var _nc_int_xv = 0;
var _nc_int_si = 0;
var _nc_lower = 0;
var _nc_leaf_victim = 0;
var _nc_leaf_www = 0;
var _nc_leaf_apex = 0;
var _nc_leaf_notgood = 0;
var _nc_leaf_suffix = 0;
var _nc_leaf_bad = 0;
var _nc_leaf_ipok = 0;
var _nc_leaf_ipno = 0;
var _nc_leaf_dot = 0;
var _nc_leaf_cn = 0;
var _nc_leaf_r_victim = 0;
var _nc_leaf_r_www = 0;
var _nc_leaf_l_victim = 0;
var _nc_leaf_l_www = 0;
var _nc_leaf_l_bad = 0;
var _nc_leaf_l_dot = 0;
var _nc_leaf_si_www = 0;
var _nc_leaf_si_victim = 0;

# A parsed certificate from its DER as hex (`hex_n` hex digits), or 0 when it does not parse.
fn _nc_cert(hex, hex_n): i64 {
    var der = hex_decode(hex, hex_n);
    var c = x509_cert_alloc();
    if (x509_parse(der, hex_n / 2, c) != 1) { return 0; }
    return c;
}

fn _nc_fixtures(): i64 {
    _nc_root = _nc_cert("", 794);
    _nc_root_nc = _nc_cert("", 750);
    _nc_int_nc = _nc_cert("", 818);
    _nc_int_ncc = _nc_cert("", 822);
    _nc_int_plain = _nc_cert("", 762);
    _nc_int_ex = _nc_cert("", 832);
    _nc_int_ip = _nc_cert("", 822);
    _nc_int_xv = _nc_cert("", 836);
    _nc_int_si = _nc_cert("", 824);
    _nc_lower = _nc_cert("", 766);
    _nc_leaf_victim = _nc_cert("", 882);
    _nc_leaf_www = _nc_cert("", 872);
    _nc_leaf_apex = _nc_cert("", 866);
    _nc_leaf_notgood = _nc_cert("", 878);
    _nc_leaf_suffix = _nc_cert("", 892);
    _nc_leaf_bad = _nc_cert("", 872);
    _nc_leaf_ipok = _nc_cert("", 854);
    _nc_leaf_ipno = _nc_cert("", 854);
    _nc_leaf_dot = _nc_cert("", 878);
    _nc_leaf_cn = _nc_cert("", 830);
    _nc_leaf_r_victim = _nc_cert("", 890);
    _nc_leaf_r_www = _nc_cert("", 878);
    _nc_leaf_l_victim = _nc_cert("", 892);
    _nc_leaf_l_www = _nc_cert("", 878);
    _nc_leaf_l_bad = _nc_cert("", 882);
    _nc_leaf_l_dot = _nc_cert("", 888);
    _nc_leaf_si_www = _nc_cert("", 874);
    _nc_leaf_si_victim = _nc_cert("", 890);
    return 0;
}

# The [count][cert ptrs] intermediates list _tn_verify_chain takes (TLS order), or 0 for none.
fn _nc_inters(a, b, c): i64 {
    if (a == 0) { return 0; }
    var n = 1;
    if (b != 0) { n = 2; }
    if (c != 0) { n = 3; }
    var l = alloc(8 + n * 8);
    store64(l, n);
    store64(l + 8, a);
    if (n >= 2) { store64(l + 16, b); }
    if (n == 3) { store64(l + 24, c); }
    return l;
}

# _tn_verify_chain on a fresh ctx trusting the one DER root `root`.
fn _nc_vp(root, leaf, i1, i2, i3, purpose): i64 {
    var ctx = tls_native_new_client("localhost", 9);
    if (tls_native_set_ca_bundle(ctx, load64(root), load64(root + 8), 1) != TLS_OK) { return 0 - 999; }
    return _tn_verify_chain(ctx, leaf, _nc_inters(i1, i2, i3), NC_NOW, purpose);
}

fn _nc_v(root, leaf, i1, i2, i3): i64 { return _nc_vp(root, leaf, i1, i2, i3, _TN_PURPOSE_SERVER); }

fn _nc_ok(r, label): i64 { return assert_eq(r, TLS_OK, label); }
fn _nc_no(r, label): i64 { return assert_eq(r, TLS_ERR_CERT_INVALID, label); }

fn test_fixtures(): i64 {
    test_group("the fixtures parse, and the constrained ones carry nameConstraints");
    assert(_nc_root != 0, "root parses");
    assert(_nc_root_nc != 0, "root_nc parses");
    assert(_nc_int_nc != 0, "int_nc parses (non-critical nameConstraints)");
    assert(_nc_int_ncc != 0, "int_ncc parses (critical nameConstraints; sigil 3.13.13 refused it)");
    assert(_nc_int_plain != 0, "int_plain parses");
    assert(_nc_int_ex != 0, "int_ex parses");
    assert(_nc_int_ip != 0, "int_ip parses");
    assert(_nc_int_xv != 0, "int_xv parses");
    assert(_nc_int_si != 0, "int_si parses");
    assert(_nc_lower != 0, "nc-lower parses");
    assert(_nc_leaf_victim != 0, "leaf_victim parses");
    assert(_nc_leaf_l_dot != 0, "leaf_l_dot parses");
    assert(_nc_leaf_si_victim != 0, "leaf_si_victim parses");
    assert_eq(x509_cert_has_name_constraints(_nc_root_nc), 1, "  root_nc carries nameConstraints");
    assert_eq(x509_cert_has_name_constraints(_nc_int_nc), 1, "  int_nc carries nameConstraints");
    assert_eq(x509_cert_has_name_constraints(_nc_int_ncc), 1, "  int_ncc carries nameConstraints");
    assert_eq(x509_cert_has_name_constraints(_nc_int_xv), 1, "  int_xv carries nameConstraints");
    assert_eq(x509_cert_has_name_constraints(_nc_root), 0, "  root carries none");
    assert_eq(x509_cert_has_name_constraints(_nc_int_plain), 0, "  int_plain carries none");
    assert_eq(x509_cert_has_name_constraints(_nc_lower), 0, "  nc-lower carries none");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_victim, _nc_int_plain, 0, 0), "control: leaf_victim <- int_plain <- root verifies");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_l_victim, _nc_lower, _nc_int_plain, 0),
      "control: leaf_l_victim <- nc-lower <- int_plain <- root verifies");
    _nc_no(_nc_v(_nc_root, _nc_leaf_l_victim, _nc_int_plain, 0, 0), "control: no nc-lower, no path (CERT_INVALID)");
    return 0;
}

# The audit's repro: a name-constrained intermediate issuing a leaf for a name outside its permit.
fn test_audit_repro(): i64 {
    test_group("the audit's repro: a good.test-constrained intermediate issuing victim-bank.test");
    _nc_no(_nc_v(_nc_root, _nc_leaf_victim, _nc_int_nc, 0, 0), "leaf_victim <- int_nc (non-critical) <- root: REFUSED");
    _nc_no(_nc_v(_nc_root, _nc_leaf_victim, _nc_int_ncc, 0, 0), "leaf_victim <- int_ncc (critical) <- root: REFUSED");
    # The public verb, as the audit's nc_probe drives it: the server's leaf and intermediates in the ctx.
    var c = tls_native_new_client("victim-bank.test", 16);
    tls_native_set_ca_bundle(c, load64(_nc_root), load64(_nc_root + 8), 1);
    store64(c + TLS_CTX_OFF_SERVER_CERT, _nc_leaf_victim);
    store64(c + TLS_CTX_OFF_SERVER_INTERS, _nc_inters(_nc_int_nc, 0, 0));
    assert_eq(tls_native_client_verify_hostname(c), TLS_OK,
      "tls_native_client_verify_hostname(victim-bank.test): the SAN matches — the chain is the guard");
    var d = tls_native_new_client("victim-bank.test", 16);
    tls_native_set_ca_bundle(d, load64(_nc_root), load64(_nc_root + 8), 1);
    store64(d + TLS_CTX_OFF_SERVER_CERT, _nc_leaf_victim);
    store64(d + TLS_CTX_OFF_SERVER_INTERS, _nc_inters(_nc_int_nc, 0, 0));
    _nc_no(tls_native_client_verify_chain(d, NC_NOW), "tls_native_client_verify_chain: REFUSED (was TLS_OK)");
    return 0;
}

fn test_permitted(): i64 {
    test_group("the permitted names still verify");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_www, _nc_int_nc, 0, 0), "www.good.test <- int_nc: verifies");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_apex, _nc_int_nc, 0, 0), "good.test <- int_nc: verifies");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_www, _nc_int_ncc, 0, 0),
      "www.good.test <- int_ncc (critical): verifies (sigil 3.13.13 refused the CA at parse)");
    var c = tls_native_new_client("www.good.test", 13);
    tls_native_set_ca_bundle(c, load64(_nc_root), load64(_nc_root + 8), 1);
    store64(c + TLS_CTX_OFF_SERVER_CERT, _nc_leaf_www);
    store64(c + TLS_CTX_OFF_SERVER_INTERS, _nc_inters(_nc_int_nc, 0, 0));
    _nc_ok(tls_native_client_verify_chain(c, NC_NOW), "tls_native_client_verify_chain(www.good.test <- int_nc): verifies");
    _nc_ok(tls_native_client_verify_hostname(c), "  and its hostname matches");
    test_group("a name outside the permit, by its shape");
    _nc_no(_nc_v(_nc_root, _nc_leaf_notgood, _nc_int_nc, 0, 0), "notgood.test <- int_nc: REFUSED (a label boundary)");
    _nc_no(_nc_v(_nc_root, _nc_leaf_suffix, _nc_int_nc, 0, 0), "good.test.evil.example <- int_nc: REFUSED (a suffix)");
    _nc_no(_nc_v(_nc_root, _nc_leaf_cn, _nc_int_nc, 0, 0),
      "no SAN, CN=victim-bank.test <- int_nc: REFUSED (the CN read as a dNSName)");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_cn, _nc_int_plain, 0, 0), "  the same leaf <- int_plain: verifies (control)");
    return 0;
}

fn test_excluded_and_ip(): i64 {
    test_group("an excluded subtree");
    _nc_no(_nc_v(_nc_root, _nc_leaf_bad, _nc_int_ex, 0, 0), "x.bad.good.test <- int_ex (excluded bad.good.test): REFUSED");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_www, _nc_int_ex, 0, 0), "www.good.test <- int_ex: verifies");
    _nc_no(_nc_v(_nc_root, _nc_leaf_victim, _nc_int_xv, 0, 0),
      "victim-bank.test <- int_xv (excluded victim-bank.test): REFUSED");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_www, _nc_int_xv, 0, 0), "www.good.test <- int_xv: verifies");
    _nc_no(_nc_v(_nc_root, _nc_leaf_l_bad, _nc_lower, _nc_int_ex, 0),
      "x.bad.good.test <- nc-lower <- int_ex: REFUSED (the excluding CA one level up)");
    test_group("an iPAddress subtree");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_ipok, _nc_int_ip, 0, 0), "IP 192.0.2.7 <- int_ip (192.0.2.0/24): verifies");
    _nc_no(_nc_v(_nc_root, _nc_leaf_ipno, _nc_int_ip, 0, 0), "IP 198.51.100.7 <- int_ip: REFUSED");
    return 0;
}

# The trust anchor's own nameConstraints, at depth 0, 1 and 2.
fn test_anchor(): i64 {
    test_group("a constraint on the trust ANCHOR binds the whole path");
    _nc_no(_nc_v(_nc_root_nc, _nc_leaf_r_victim, 0, 0, 0), "victim-bank.test <- root_nc (depth 0): REFUSED");
    _nc_ok(_nc_v(_nc_root_nc, _nc_leaf_r_www, 0, 0, 0), "www.good.test <- root_nc (depth 0): verifies");
    _nc_no(_nc_v(_nc_root_nc, _nc_leaf_victim, _nc_int_plain, 0, 0),
      "victim-bank.test <- int_plain <- root_nc (depth 1): REFUSED");
    _nc_ok(_nc_v(_nc_root_nc, _nc_leaf_www, _nc_int_plain, 0, 0), "www.good.test <- int_plain <- root_nc: verifies");
    _nc_no(_nc_v(_nc_root_nc, _nc_leaf_l_victim, _nc_lower, _nc_int_plain, 0),
      "victim-bank.test <- nc-lower <- int_plain <- root_nc (depth 2): REFUSED");
    _nc_ok(_nc_v(_nc_root_nc, _nc_leaf_l_www, _nc_lower, _nc_int_plain, 0),
      "www.good.test <- nc-lower <- int_plain <- root_nc: verifies");
    return 0;
}

# A CA's constraints bind every certificate below it, not only the one it signs.
fn test_upper_ca(): i64 {
    test_group("a constrained CA one level up binds the leaf below the CA it signs");
    _nc_no(_nc_v(_nc_root, _nc_leaf_l_victim, _nc_lower, _nc_int_nc, 0),
      "victim-bank.test <- nc-lower <- int_nc <- root: REFUSED");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_l_www, _nc_lower, _nc_int_nc, 0), "www.good.test <- nc-lower <- int_nc <- root: verifies");
    var c = tls_native_new_client("victim-bank.test", 16);
    tls_native_set_ca_bundle(c, load64(_nc_root), load64(_nc_root + 8), 1);
    store64(c + TLS_CTX_OFF_SERVER_CERT, _nc_leaf_l_victim);
    store64(c + TLS_CTX_OFF_SERVER_INTERS, _nc_inters(_nc_lower, _nc_int_nc, 0));
    _nc_no(tls_native_client_verify_chain(c, NC_NOW), "tls_native_client_verify_chain(victim-bank.test <- nc-lower <- int_nc): REFUSED");
    test_group("the client purpose (an mTLS server verifying a client chain) is bound the same");
    _nc_no(_nc_vp(_nc_root, _nc_leaf_l_victim, _nc_lower, _nc_int_nc, 0, _TN_PURPOSE_CLIENT),
      "client purpose: victim-bank.test <- nc-lower <- int_nc: REFUSED");
    _nc_ok(_nc_vp(_nc_root, _nc_leaf_l_www, _nc_lower, _nc_int_nc, 0, _TN_PURPOSE_CLIENT),
      "client purpose: www.good.test <- nc-lower <- int_nc: verifies");
    _nc_no(_nc_vp(_nc_root_nc, _nc_leaf_victim, _nc_int_plain, 0, 0, _TN_PURPOSE_CLIENT),
      "client purpose: victim-bank.test <- int_plain <- root_nc: REFUSED");
    return 0;
}

fn test_trailing_dot(): i64 {
    test_group("a trailing-dot name is no way out");
    _nc_no(_nc_v(_nc_root, _nc_leaf_dot, _nc_int_nc, 0, 0), "victim-bank.test. <- int_nc (permitted good.test): REFUSED");
    _nc_no(_nc_v(_nc_root, _nc_leaf_dot, _nc_int_xv, 0, 0),
      "victim-bank.test. <- int_xv (excluded victim-bank.test): REFUSED (openssl 3.6.5 lets it out)");
    _nc_no(_nc_v(_nc_root, _nc_leaf_l_dot, _nc_lower, _nc_int_xv, 0), "victim-bank.test. <- nc-lower <- int_xv: REFUSED");
    _nc_no(_nc_v(_nc_root, _nc_leaf_l_dot, _nc_lower, _nc_int_nc, 0), "victim-bank.test. <- nc-lower <- int_nc: REFUSED");
    var c = tls_native_new_client("victim-bank.test.", 17);
    tls_native_set_ca_bundle(c, load64(_nc_root), load64(_nc_root + 8), 1);
    store64(c + TLS_CTX_OFF_SERVER_CERT, _nc_leaf_l_dot);
    store64(c + TLS_CTX_OFF_SERVER_INTERS, _nc_inters(_nc_lower, _nc_int_xv, 0));
    assert_eq(tls_native_client_verify_hostname(c), TLS_OK,
      "a client dialling victim-bank.test. matches its SAN literally — the chain is the guard");
    var d = tls_native_new_client("victim-bank.test.", 17);
    tls_native_set_ca_bundle(d, load64(_nc_root), load64(_nc_root + 8), 1);
    store64(d + TLS_CTX_OFF_SERVER_CERT, _nc_leaf_l_dot);
    store64(d + TLS_CTX_OFF_SERVER_INTERS, _nc_inters(_nc_lower, _nc_int_xv, 0));
    _nc_no(tls_native_client_verify_chain(d, NC_NOW), "  and tls_native_client_verify_chain REFUSES it");
    return 0;
}

fn test_self_issued_and_paths(): i64 {
    test_group("a self-issued intermediate is exempt (RFC 5280 §6.1.3(b)); the leaf never is");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_si_www, _nc_int_si, _nc_int_nc, 0),
      "www.good.test <- int_si (self-issued, SAN victim-bank.test) <- int_nc: verifies");
    _nc_no(_nc_v(_nc_root, _nc_leaf_si_victim, _nc_int_si, _nc_int_nc, 0),
      "victim-bank.test <- int_si <- int_nc: REFUSED");
    test_group("path building: a CA that does not allow the path below it is SKIPPED, not fatal");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_l_victim, _nc_lower, _nc_int_nc, _nc_int_plain),
      "[nc-lower, int_nc, int_plain]: int_nc skipped, verifies through int_plain");
    _nc_ok(_nc_v(_nc_root, _nc_leaf_l_victim, _nc_lower, _nc_int_plain, _nc_int_nc),
      "[nc-lower, int_plain, int_nc]: verifies through int_plain");
    _nc_no(_nc_v(_nc_root, _nc_leaf_l_victim, _nc_lower, _nc_int_nc, _nc_int_xv),
      "[nc-lower, int_nc, int_xv]: no CA allows it, REFUSED");
    return 0;
}

fn _nc_all(): i64 {
    alloc_init();
    _nc_fixtures();
    test_fixtures();
