# ---- PEM armour for keys made up at run time (openssl's layout: 64-column lines) ----
var _pk_b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

fn _pk_put(out, p, s): i64 {
    var n = strlen(s);
    memcpy(out + p, s, n);
    return p + n;
}

fn _pk_b64c(v): i64 { return load8(_pk_b64 + (v & 63)) & 0xFF; }

# Armour `n` DER bytes under `label` into `out`. Returns the text's length.
fn _pk_armour(der, n, label, out): i64 {
    var p = _pk_put(out, 0, "-----BEGIN ");
    p = _pk_put(out, p, label);
    p = _pk_put(out, p, "-----\n");
    var i = 0;
    var col = 0;
    while (i < n) {
        var b0 = load8(der + i) & 0xFF;
        var b1 = 0;
        var b2 = 0;
        if (i + 1 < n) { b1 = load8(der + i + 1) & 0xFF; }
        if (i + 2 < n) { b2 = load8(der + i + 2) & 0xFF; }
        store8(out + p, _pk_b64c(b0 >> 2));
        store8(out + p + 1, _pk_b64c(((b0 & 3) << 4) | (b1 >> 4)));
        store8(out + p + 2, 61);
        store8(out + p + 3, 61);
        if (i + 1 < n) { store8(out + p + 2, _pk_b64c(((b1 & 15) << 2) | (b2 >> 6))); }
        if (i + 2 < n) { store8(out + p + 3, _pk_b64c(b2)); }
        p = p + 4;
        col = col + 4;
        i = i + 3;
        if (col == 64) {
            store8(out + p, 10);
            p = p + 1;
            col = 0;
        }
    }
    if (col > 0) {
        store8(out + p, 10);
        p = p + 1;
    }
    p = _pk_put(out, p, "-----END ");
    p = _pk_put(out, p, label);
    p = _pk_put(out, p, "-----\n");
    return p;
}

# An Ed25519 key made up from `k` (distinct for every k < 256): its PKCS#8 DER (48 B) into `der`.
fn _pk_ed_make(k, der): i64 {
    memcpy(der, _pk_ed_der, 16);                         # the PKCS#8 / RFC 8410 prefix
    var i = 0;
    while (i < 32) {
        store8(der + 16 + i, (k * 131 + i * 29 + 7) & 0xFF);
        i = i + 1;
    }
    return 48;
}

# The PEM text of key `k` (a fresh 128-byte buffer; the text is 119 bytes).
fn _pk_ed_pem_of(k): i64 {
    var der: i64[6];
    _pk_ed_make(k, &der);
    var out = alloc(128);
    _pk_armour(&der, 48, "PRIVATE KEY", out);
    return out;
}

# The seed of key `k` (32 B).
fn _pk_ed_seed_of(k): i64 {
    var der = alloc(48);
    _pk_ed_make(k, der);
    return der + 16;
}

# ---- one accept's credential load ----
var _pk_arena = 0;          # the server's Allocator, rewound before every accept

# lib/tls.cyr's server accept on `a` (rewound first): the native ctx, or 0 when the credentials
# are refused. The "socket" is the replay transport's server handle; nothing reads it here.
fn _pk_accept_in(a, cert, cert_n, key, key_n): i64 {
    reset_via(a);
    var creds: i64[4];
    store64(&creds, cert);
    store64(&creds + 8, cert_n);
    store64(&creds + 16, key);
    store64(&creds + 24, key_n);
    var sh = tls_accept_alloc_in(a, PK_SERVER, &creds, 0, 0);
    if (sh == 0) { return 0; }
    return load64(sh);
}

fn _pk_accept(cert, cert_n, key, key_n): i64 {
    return _pk_accept_in(_pk_arena, cert, cert_n, key, key_n);
}

# Global-heap bytes PK_ACCEPTS accepts of this key add, after one accept that may fill the cache.
fn _pk_growth(cert, cert_n, key, key_n): i64 {
    _pk_accept(cert, cert_n, key, key_n);
    var u0 = alloc_used();
    var i = 0;
    while (i < PK_ACCEPTS) {
        _pk_accept(cert, cert_n, key, key_n);
        i = i + 1;
    }
    return alloc_used() - u0;
}

# tls_native_server_load_creds's answer for these credentials on a fresh server ctx.
fn _pk_load_err(cert, cert_n, key, key_n): i64 {
    reset_via(_pk_arena);
    var s = tls_native_new_server_in(_pk_arena, cert, cert_n, key, key_n);
    if (s == 0) { return 0 - 999; }
    return tls_native_server_load_creds(s);
}

# 1 when the native ctx holds algorithm `algo` and the `n` key-material bytes at `want`.
fn _pk_holds(nctx, algo, want, n): i64 {
    if (nctx == 0) { return 0; }
    if (load64(nctx + TLS_CTX_OFF_KEY_ALGO) != algo) { return 0; }
    if (load64(nctx + TLS_CTX_OFF_KEY_MAT_LEN) != n) { return 0; }
    var m = load64(nctx + TLS_CTX_OFF_KEY_MAT);
    if (m == 0) { return 0; }
    return memeq(m, want, n);
}

fn _pk_say_growth(label, g): i64 {
    sys_write(1, "    ", 4);
    sys_write(1, label, strlen(label));
    sys_write(1, ": ", 2);
    fmt_int(g);
    sys_write(1, " B of global heap over ", 23);
    fmt_int(PK_ACCEPTS);
    println(" accepts");
    return 0;
}

# ---- rows ----

fn test_filed_shape(): i64 {
    test_group("6.6.16 — the filed shape: a 119-byte Ed25519 PEM key, the arena rewound per accept");
    assert_eq(strlen(_pk_ed_pem), 119, "the PEM key is 119 bytes, as sandhi's key.pem");
    var g = _pk_growth(_pk_ed_crt, 322, _pk_ed_pem, 119);
    _pk_say_growth("Ed25519 PEM", g);
    assert_eq(g, 0, "0 B of global heap per accept (6.6.15: 120, the key decoded on every accept)");
    var gd = _pk_growth(_pk_ed_crt, 322, _pk_ed_der, 48);
    assert_eq(gd, 0, "the same key as DER: 0 B per accept (it never took the PEM decoder)");
    return 0;
}

# One key form: it loads `algo` and the `n` bytes at `want`, twice, and costs 0 B per accept after
# the first.
fn _pk_form(label, cert, cert_n, key, key_n, algo, want, n): i64 {
    println(label);
    var s = _pk_accept(cert, cert_n, key, key_n);
    assert(s != 0, "  tls_accept_alloc_in accepts the credentials");
    assert_eq(_pk_holds(s, algo, want, n), 1, "  the ctx holds the key's algorithm and key material");
    s = _pk_accept(cert, cert_n, key, key_n);
    assert_eq(_pk_holds(s, algo, want, n), 1, "  …and again on the next accept");
    assert_eq(_pk_growth(cert, cert_n, key, key_n), 0, "  0 B of global heap per accept");
    return 0;
}

fn test_key_forms(): i64 {
    test_group("6.6.16 — every key form loads the same key, at 0 B per accept");
    _pk_form("  Ed25519 PKCS#8 PEM", _pk_ed_crt, 322, _pk_ed_pem, 119, SIG_PRIVKEY_ED25519, _pk_ed_seed, 32);
    _pk_form("  Ed25519 PKCS#8 DER", _pk_ed_crt, 322, _pk_ed_der, 48, SIG_PRIVKEY_ED25519, _pk_ed_seed, 32);
    _pk_form("  P-256 PKCS#8 PEM", _pk_p256_crt, 387, _pk_p256_p8_pem, 241, SIG_PRIVKEY_ECDSA_P256, _pk_p256_d, 32);
    _pk_form("  P-256 SEC1 PEM", _pk_p256_crt, 387, _pk_p256_sec1_pem, 227, SIG_PRIVKEY_ECDSA_P256, _pk_p256_d, 32);
    _pk_form("  P-256 PKCS#8 DER", _pk_p256_crt, 387, _pk_p256_p8, 138, SIG_PRIVKEY_ECDSA_P256, _pk_p256_d, 32);
    _pk_form("  P-256 SEC1 DER", _pk_p256_crt, 387, _pk_p256_sec1, 121, SIG_PRIVKEY_ECDSA_P256, _pk_p256_d, 32);
    _pk_form("  P-384 PKCS#8 PEM", _pk_p384_crt, 448, _pk_p384_p8_pem, 306, SIG_PRIVKEY_ECDSA_P384, _pk_p384_d, 48);
    _pk_form("  P-384 SEC1 PEM", _pk_p384_crt, 448, _pk_p384_sec1_pem, 288, SIG_PRIVKEY_ECDSA_P384, _pk_p384_d, 48);
    _pk_form("  P-384 PKCS#8 DER", _pk_p384_crt, 448, _pk_p384_p8, 185, SIG_PRIVKEY_ECDSA_P384, _pk_p384_d, 48);
    _pk_form("  P-384 SEC1 DER", _pk_p384_crt, 448, _pk_p384_sec1, 167, SIG_PRIVKEY_ECDSA_P384, _pk_p384_d, 48);

    # The client's own key (mTLS) is loaded by the same code, once per connection.
    println("  a client's own P-256 PKCS#8 PEM key (tls_native_set_client_key)");
    var ok = 0;
    var i = 0;
    while (i < 3) {
        reset_via(_pk_arena);
        var c = tls_native_new_client_in(_pk_arena, 0, 0);
        if (tls_native_set_client_key(c, _pk_p256_p8_pem, 241) == TLS_OK) {
            ok = ok + _pk_holds(c, SIG_PRIVKEY_ECDSA_P256, _pk_p256_d, 32);
        }
        i = i + 1;
    }
    assert_eq(ok, 3, "  each client ctx holds the key");
    var u0 = alloc_used();
    i = 0;
    while (i < PK_ACCEPTS) {
        reset_via(_pk_arena);
        tls_native_set_client_key(tls_native_new_client_in(_pk_arena, 0, 0), _pk_p256_p8_pem, 241);
        i = i + 1;
    }
    assert_eq(alloc_used() - u0, 0, "  0 B of global heap per client connection");
    return 0;
}

# A refused key: TLS_ERR_KEY_UNSUPPORTED from tls_native_server_load_creds three times, a 0 from
# tls_accept_alloc_in, and 0 B per accept after the first.
fn _pk_refused(label, key, key_n): i64 {
    println(label);
    assert_eq(_pk_load_err(_pk_ed_crt, 322, key, key_n), TLS_ERR_KEY_UNSUPPORTED,
      "  tls_native_server_load_creds: TLS_ERR_KEY_UNSUPPORTED");
    assert_eq(_pk_load_err(_pk_ed_crt, 322, key, key_n), TLS_ERR_KEY_UNSUPPORTED, "  …the second time");
    assert_eq(_pk_load_err(_pk_ed_crt, 322, key, key_n), TLS_ERR_KEY_UNSUPPORTED, "  …and the third");
    assert_eq(_pk_accept(_pk_ed_crt, 322, key, key_n), 0, "  tls_accept_alloc_in refuses the credentials");
    return 0;
}

# The same, plus the growth row (PEM texts only: a DER key never took the decoder).
fn _pk_refused_pem(label, key, key_n): i64 {
    _pk_refused(label, key, key_n);
    assert_eq(_pk_growth(_pk_ed_crt, 322, key, key_n), 0, "  0 B of global heap per refused accept");
    return 0;
}

fn test_refusals(): i64 {
    test_group("6.6.16 — a refused key keeps its error, at the same point, at 0 B per accept");
    _pk_refused_pem("  RSA, PKCS#1 PEM (the native stack signs with no RSA key)", _pk_rsa_p1_pem, 887);
    _pk_refused_pem("  RSA, PKCS#8 PEM", _pk_rsa_p8_pem, 916);
    _pk_refused("  RSA, PKCS#8 DER", _pk_rsa_der, 634);
    var bad = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEI!!!!\n-----END PRIVATE KEY-----\n";
    _pk_refused_pem("  a body that is not base64", bad, strlen(bad));
    var noend = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIMMx4F5lYITmTNvmOlrWxwSEciBwi4i9wwc2cLwqmoGc\n";
    _pk_refused_pem("  no END line", noend, strlen(noend));
    var trunc = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIE\n-----END PRIVATE KEY-----\n";
    _pk_refused_pem("  a truncated body", trunc, strlen(trunc));
    var crt = alloc(1024);
    var crt_n = _pk_armour(_pk_ed_crt, 322, "CERTIFICATE", crt);
    _pk_refused_pem("  a certificate, not a key", crt, crt_n);
    _pk_refused_pem("  a lone dash", "-", 1);
    var mis1 = alloc(512);
    var mis1_n = _pk_armour(_pk_p256_sec1, 121, "PRIVATE KEY", mis1);
    _pk_refused_pem("  the PKCS#8 label around a SEC1 P-256 key", mis1, mis1_n);
    var mis2 = alloc(512);
    var mis2_n = _pk_armour(_pk_p256_p8, 138, "EC PRIVATE KEY", mis2);
    _pk_refused_pem("  the SEC1 label around a PKCS#8 P-256 key", mis2, mis2_n);
    return 0;
}

fn test_keyed_on_text(): i64 {
    test_group("6.6.16 — the cache is keyed on the PEM text, not on its address");
    var a = _pk_ed_pem_of(1);
    assert_eq(memeq(_pk_ed_pem_of(0 - 1), a, 119), 0, "two made-up keys differ");
    # The armour reproduces openssl's text byte for byte, so the made-up keys are real PEM.
    var ref = alloc(128);
    assert_eq(_pk_armour(_pk_ed_der, 48, "PRIVATE KEY", ref), 119, "the armour of the fixture is 119 bytes");
    assert_eq(memeq(ref, _pk_ed_pem, 119), 1, "…and is openssl's text");

    println("  two keys of the same length, alternating");
    var b = _pk_ed_pem_of(2);
    var sa = _pk_ed_seed_of(1);
    var sb = _pk_ed_seed_of(2);
    var ok = 0;
    var i = 0;
    while (i < 10) {
        ok = ok + _pk_holds(_pk_accept(_pk_ed_crt, 322, a, 119), SIG_PRIVKEY_ED25519, sa, 32);
        ok = ok + _pk_holds(_pk_accept(_pk_ed_crt, 322, b, 119), SIG_PRIVKEY_ED25519, sb, 32);
        i = i + 1;
    }
    assert_eq(ok, 20, "  every load holds its own key");
    var u0 = alloc_used();
    i = 0;
    while (i < 10) {
        _pk_accept(_pk_ed_crt, 322, a, 119);
        _pk_accept(_pk_ed_crt, 322, b, 119);
        i = i + 1;
    }
    assert_eq(alloc_used() - u0, 0, "  0 B of global heap once both are cached");

    println("  one buffer, refilled with another key of the same length");
    var buf = alloc(128);
    memcpy(buf, _pk_ed_pem_of(3), 119);
    var s3 = _pk_ed_seed_of(3);
    var s4 = _pk_ed_seed_of(4);
    assert_eq(_pk_holds(_pk_accept(_pk_ed_crt, 322, buf, 119), SIG_PRIVKEY_ED25519, s3, 32), 1,
      "  key 3 loads key 3");
    memcpy(buf, _pk_ed_pem_of(4), 119);
    assert_eq(_pk_holds(_pk_accept(_pk_ed_crt, 322, buf, 119), SIG_PRIVKEY_ED25519, s4, 32), 1,
      "  the buffer refilled with key 4 loads key 4, not the cached key 3");
    memcpy(buf, _pk_ed_pem_of(3), 119);
    assert_eq(_pk_holds(_pk_accept(_pk_ed_crt, 322, buf, 119), SIG_PRIVKEY_ED25519, s3, 32), 1,
      "  …and refilled with key 3 again, key 3");
    return 0;
}

# ---- real handshakes over the replay transport (see tls_native_client_auth.tcyr) ----
var _pk_cs = 0;             # client -> server bytes the server reads (the client's last run)
var _pk_cs_len = 0;
var _pk_cs_next = 0;        # what the running client writes
var _pk_cs_next_len = 0;
var _pk_sc = 0;             # server -> client
var _pk_sc_len = 0;
var _pk_sc_next = 0;
var _pk_sc_next_len = 0;
var _pk_cs_rd = 0;
var _pk_sc_rd = 0;
var _pk_overflow = 0;
var _pk_eof = 0;            # the running side read past the end of the other's log
var _pk_c_eof = 0;
var _pk_s_eof = 0;
var _pk_ca = 0;             # the client's Allocator, rewound every run

fn _pk_read(h, buf, n): i64 {
    var src = _pk_sc;
    var len = _pk_sc_len;
    var cur = _pk_sc_rd;
    if (h == PK_SERVER) {
        src = _pk_cs;
        len = _pk_cs_len;
        cur = _pk_cs_rd;
    }
    var avail = len - cur;
    if (avail <= 0) {
        _pk_eof = 1;
        return 0;
    }
    var k = n;
    if (k > avail) { k = avail; }
    memcpy(buf, src + cur, k);
    if (h == PK_SERVER) { _pk_cs_rd = cur + k; }
    else { _pk_sc_rd = cur + k; }
    return k;
}

fn _pk_write(h, buf, n): i64 {
    if (h == PK_SERVER) {
        if (_pk_sc_next_len + n > PK_LOG_CAP) { _pk_overflow = 1; return 0 - 1; }
        memcpy(_pk_sc_next + _pk_sc_next_len, buf, n);
        _pk_sc_next_len = _pk_sc_next_len + n;
        return n;
    }
    if (_pk_cs_next_len + n > PK_LOG_CAP) { _pk_overflow = 1; return 0 - 1; }
    memcpy(_pk_cs_next + _pk_cs_next_len, buf, n);
    _pk_cs_next_len = _pk_cs_next_len + n;
    return n;
}

fn _pk_now(): i64 { return 1893456000; }                 # 2030-01-01 00:00 UTC

# Deterministic entropy (xorshift64), reseeded at the start of every run of a side.
var _pk_rng = 1;
fn _pk_rand(buf, n, fl): i64 {
    var i = 0;
    while (i < n) {
        var x = _pk_rng;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        _pk_rng = x;
        store8(buf + i, (x >> 24) & 0xFF);
        i = i + 1;
    }
    return n;
}

# [0] client connect, [1] the client's read after "ping" (-99 when not run), [2] server accept
# (TLS_OK, the ctx's last error, or -999 when tls_accept_alloc_in refused), [3] the server's read
# (-99), [4] global-heap bytes of the server runs after the first, [5] rounds to the fixed point.
var _pk_obs: i64[6];

fn _pk_client_run(v12): i64 {
    reset_via(_pk_ca);
    _pk_rng = 0x2468ACE1;
    _pk_eof = 0;
    _pk_sc_rd = 0;
    _pk_cs_next_len = 0;
    var c = tls_native_new_client_in(_pk_ca, 0, 0);
    tls_native_set_verify(c, TLS_VERIFY_NONE);      # the CertificateVerify is still checked
    if (v12 == 1) { tls_native_set_version_range(c, TLS_VERSION_1_2, TLS_VERSION_1_2); }
    var rc = tls_native_connect(c, PK_CLIENT);
    _pk_obs[0] = rc;
    _pk_obs[1] = 0 - 99;
    if (rc == TLS_OK) {
        tls_native_write(c, "ping", 4);
        var b[64];
        store64(&b, 0);
        var n = tls_native_read(c, &b, 64);
        _pk_obs[1] = n;
        if (n == 4) {
            if (memeq(&b, "pong", 4) != 1) { _pk_obs[1] = 0 - 98; }
        }
    }
    _pk_c_eof = _pk_eof;
    var t = _pk_cs;
    _pk_cs = _pk_cs_next;
    _pk_cs_next = t;
    _pk_cs_len = _pk_cs_next_len;
    return 0;
}

# One server run: an accept through lib/tls.cyr. Returns the global-heap bytes it added.
fn _pk_server_run(cert, cert_n, key, key_n): i64 {
    var u0 = alloc_used();
    reset_via(_pk_arena);
    _pk_rng = 0x13579BDF;
    _pk_eof = 0;
    _pk_cs_rd = 0;
    _pk_sc_next_len = 0;
    var creds: i64[4];
    store64(&creds, cert);
    store64(&creds + 8, cert_n);
    store64(&creds + 16, key);
    store64(&creds + 24, key_n);
    var sh = tls_accept_alloc_in(_pk_arena, PK_SERVER, &creds, 0, 0);
    _pk_obs[2] = 0 - 999;
    _pk_obs[3] = 0 - 99;
    if (sh != 0) {
        var nctx = load64(sh);
        if (tls_accept_complete(sh) == 1) {
            _pk_obs[2] = TLS_OK;
            var b[64];
            store64(&b, 0);
            var n = tls_read(sh, &b, 64);
            _pk_obs[3] = n;
            if (n == 4) {
                if (memeq(&b, "ping", 4) == 1) { tls_write(sh, "pong", 4); }
                else { _pk_obs[3] = 0 - 98; }
            }
        } else {
            var le = tls_native_get_last_error(nctx);
            if (le == 0) { le = 0 - 777; }
            _pk_obs[2] = le;
        }
    }
    var g = alloc_used() - u0;
    _pk_s_eof = _pk_eof;
    var t = _pk_sc;
    _pk_sc = _pk_sc_next;
    _pk_sc_next = t;
    _pk_sc_len = _pk_sc_next_len;
    return g;
}

# Replay one handshake to its fixed point: each round runs the client from scratch against the
# server's last log, then the server against the client's.
fn _pk_row(v12, cert, cert_n, key, key_n): i64 {
    _pk_cs_len = 0;
    _pk_sc_len = 0;
    _pk_overflow = 0;
    var pc = 0 - 1;
    var ps = 0 - 1;
    var r = 0;
    var grow = 0;
    var settled = 0;
    while (settled == 0) {
        if (r >= PK_ROUNDS_MAX) { settled = 2; }
        if (settled == 0) {
            _pk_client_run(v12);
            var g = _pk_server_run(cert, cert_n, key, key_n);
            if (r > 0) { grow = grow + g; }               # the first run may fill one-time state
            r = r + 1;
            if (_pk_c_eof == 0) {
                if (_pk_s_eof == 0) { settled = 1; }
            }
            if (_pk_cs_len == pc) {
                if (_pk_sc_len == ps) { settled = 1; }
            }
            pc = _pk_cs_len;
            ps = _pk_sc_len;
        }
    }
    _pk_obs[4] = grow;
    _pk_obs[5] = 0;
    if (settled == 1) { _pk_obs[5] = r; }
    assert(_pk_obs[5] > 1, "  the replay settled after more than one round");
    assert_eq(_pk_overflow, 0, "  no log overflowed");
    return 0;
}

fn _pk_hs(label, v12, cert, cert_n, key, key_n): i64 {
    println(label);
    _pk_accept(cert, cert_n, key, key_n);               # a warm cache, as in a running server
    _pk_row(v12, cert, cert_n, key, key_n);
    assert_eq(_pk_obs[2], TLS_OK, "  the server's handshake completes");
    assert_eq(_pk_obs[0], TLS_OK, "  the client's handshake completes (it checked the CertificateVerify)");
    assert_eq(_pk_obs[3], 4, "  the server reads the client's \"ping\"");
    assert_eq(_pk_obs[1], 4, "  the client reads the server's \"pong\"");
    assert_eq(_pk_obs[4], 0, "  0 B of global heap per server run");
    return 0;
}

fn test_handshakes(): i64 {
    test_group("6.6.16 — PEM and DER keys handshake, at 0 B of global heap per accept");
    _pk_hs("  Ed25519 PKCS#8 PEM, TLS 1.3", 0, _pk_ed_crt, 322, _pk_ed_pem, 119);
    _pk_hs("  Ed25519 PKCS#8 DER, TLS 1.3", 0, _pk_ed_crt, 322, _pk_ed_der, 48);
    _pk_hs("  Ed25519 PKCS#8 PEM, TLS 1.2", 1, _pk_ed_crt, 322, _pk_ed_pem, 119);
    _pk_hs("  P-256 PKCS#8 PEM, TLS 1.3", 0, _pk_p256_crt, 387, _pk_p256_p8_pem, 241);
    _pk_hs("  P-256 SEC1 PEM, TLS 1.3", 0, _pk_p256_crt, 387, _pk_p256_sec1_pem, 227);
    _pk_hs("  P-256 PKCS#8 DER, TLS 1.3", 0, _pk_p256_crt, 387, _pk_p256_p8, 138);
    _pk_hs("  P-256 SEC1 DER, TLS 1.3", 0, _pk_p256_crt, 387, _pk_p256_sec1, 121);
    _pk_hs("  P-256 SEC1 PEM, TLS 1.2", 1, _pk_p256_crt, 387, _pk_p256_sec1_pem, 227);
    _pk_hs("  P-384 PKCS#8 PEM, TLS 1.3", 0, _pk_p384_crt, 448, _pk_p384_p8_pem, 306);
    _pk_hs("  P-384 SEC1 PEM, TLS 1.3", 0, _pk_p384_crt, 448, _pk_p384_sec1_pem, 288);
    _pk_hs("  P-384 PKCS#8 DER, TLS 1.3", 0, _pk_p384_crt, 448, _pk_p384_p8, 185);
    _pk_hs("  P-384 SEC1 DER, TLS 1.3", 0, _pk_p384_crt, 448, _pk_p384_sec1, 167);
    _pk_hs("  P-384 PKCS#8 PEM, TLS 1.2", 1, _pk_p384_crt, 448, _pk_p384_p8_pem, 306);

    println("  a key that is not the certificate's (an Ed25519 certificate, another Ed25519 key)");
    var other = _pk_ed_pem_of(1);
    _pk_row(0, _pk_ed_crt, 322, other, 119);
    assert_eq(_pk_obs[0], TLS_ERR_AUTHN, "  the client refuses the server's CertificateVerify");
    return 0;
}

# ---- threads ----
var _pk_go = 0;
var _pk_done = 0;
var _pk_bad = 0;
var _pk_shared = 0;         # the key every racer loads
var _pk_shared_seed = 0;
var _pk_own: i64[8];        # each racer's own key
var _pk_own_seed: i64[8];
var _pk_racer_arena: i64[8];

fn _pk_racer(i): i64 {
    var t0 = clock_now_ms();
    while (atomic_load(&_pk_go) == 0) {
        if (clock_now_ms() - t0 > PK_DEADLINE_MS) { break; }
    }
    var a = _pk_racer_arena[i];
    var own = _pk_own[i];
    var own_seed = _pk_own_seed[i];
    var k = 0;
    while (k < PK_RACE_LOADS) {
        var s = _pk_accept_in(a, _pk_ed_crt, 322, _pk_shared, 119);
        if (_pk_holds(s, SIG_PRIVKEY_ED25519, _pk_shared_seed, 32) != 1) { atomic_fetch_add(&_pk_bad, 1); }
        s = _pk_accept_in(a, _pk_ed_crt, 322, own, 119);
        if (_pk_holds(s, SIG_PRIVKEY_ED25519, own_seed, 32) != 1) { atomic_fetch_add(&_pk_bad, 1); }
        k = k + 1;
    }
    atomic_fetch_add(&_pk_done, 1);
    return 0;
}

fn test_threads(): i64 {
    test_group("6.6.16 — loaders racing on new keys each get their key, and then the cache");
    if (THREADS_CONCURRENT == 1) { println("  (real threads)"); }
    else { println("  (THREADS_CONCURRENT is 0 here: the racers may run in turn; the rows hold either way)"); }
    _pk_shared = _pk_ed_pem_of(10);
    _pk_shared_seed = _pk_ed_seed_of(10);
    var i = 0;
    while (i < PK_RACERS) {
        _pk_own[i] = _pk_ed_pem_of(11 + i);
        _pk_own_seed[i] = _pk_ed_seed_of(11 + i);
        _pk_racer_arena[i] = arena_allocator(1048576);
        i = i + 1;
    }
    _pk_go = 0;
    _pk_done = 0;
    _pk_bad = 0;
    # Where bodies run inline, the start flag must already be up or each would wait out the deadline.
    if (THREADS_CONCURRENT != 1) { atomic_store(&_pk_go, 1); }
    var ts: i64[8];
    i = 0;
    while (i < PK_RACERS) {
        ts[i] = thread_create(&_pk_racer, i);
        i = i + 1;
    }
    atomic_store(&_pk_go, 1);
    var t0 = clock_now_ms();
    while (atomic_load(&_pk_done) < PK_RACERS) {
        if (clock_now_ms() - t0 > PK_DEADLINE_MS) { break; }
        sleep_ms(1);
    }
    assert_eq(atomic_load(&_pk_done), PK_RACERS, "every racer finished");
    if (atomic_load(&_pk_done) == PK_RACERS) {
        i = 0;
        while (i < PK_RACERS) {
            thread_join(ts[i]);
            i = i + 1;
        }
    }
    assert_eq(atomic_load(&_pk_bad), 0, "every one of 400 loads held its own key");
    # One load each from here: a key whose every racing load found the claim taken is cached now.
    _pk_accept(_pk_ed_crt, 322, _pk_shared, 119);
    i = 0;
    while (i < PK_RACERS) {
        _pk_accept(_pk_ed_crt, 322, _pk_own[i], 119);
        i = i + 1;
    }
    var u0 = alloc_used();
    var ok = _pk_holds(_pk_accept(_pk_ed_crt, 322, _pk_shared, 119), SIG_PRIVKEY_ED25519, _pk_shared_seed, 32);
    i = 0;
    while (i < PK_RACERS) {
        ok = ok + _pk_holds(_pk_accept(_pk_ed_crt, 322, _pk_own[i], 119), SIG_PRIVKEY_ED25519, _pk_own_seed[i], 32);
        i = i + 1;
    }
    assert_eq(alloc_used() - u0, 0, "afterwards all nine keys are served from the cache: 0 B");
    assert_eq(ok, 9, "…holding the right keys");
    return 0;
}

fn test_capacity(): i64 {
    test_group("6.6.16 — past the cache's capacity, keys still load");
    var first = _pk_ed_pem_of(100);
    var ok = 0;
    var k = 100;
    while (k < 140) {
        var sk = _pk_accept(_pk_ed_crt, 322, _pk_ed_pem_of(k), 119);
        ok = ok + _pk_holds(sk, SIG_PRIVKEY_ED25519, _pk_ed_seed_of(k), 32);
        k = k + 1;
    }
    assert_eq(ok, 40, "40 more distinct keys each load their own key");
    var u0 = alloc_used();
    var s = _pk_accept(_pk_ed_crt, 322, first, 119);
    assert_eq(alloc_used() - u0, 0, "the first of them, cached before the cache filled, still costs 0 B");
    assert_eq(_pk_holds(s, SIG_PRIVKEY_ED25519, _pk_ed_seed_of(100), 32), 1, "…and holds its key");
    var last = _pk_accept(_pk_ed_crt, 322, _pk_ed_pem_of(139), 119);
    assert_eq(_pk_holds(last, SIG_PRIVKEY_ED25519, _pk_ed_seed_of(139), 32), 1,
      "the last, past the capacity, loads its key again");
    return 0;
}

fn _pk_all(): i64 {
    alloc_init();
    _pk_fixtures();
    _pk_arena = arena_allocator(2097152);
    _pk_ca = arena_allocator(2097152);
    _pk_cs = alloc(PK_LOG_CAP);
    _pk_cs_next = alloc(PK_LOG_CAP);
    _pk_sc = alloc(PK_LOG_CAP);
    _pk_sc_next = alloc(PK_LOG_CAP);
    tls_native_set_transport(&_pk_read, &_pk_write, &_pk_now);
    tls_native_set_entropy(&_pk_rand);
    test_filed_shape();
    test_key_forms();
    test_refusals();
    test_keyed_on_text();
    test_handshakes();
    test_threads();
    test_capacity();
    tls_native_set_entropy(0);
    tls_native_set_transport(0, 0, 0);
    return 0;
}

_pk_all();
var r = assert_summary();
