# tls_native_pem_key_once.tcyr — 6.6.16: a native TLS server decodes a PEM private key ONCE, not on
# every accept, on every host target.
#
# ⛔ THE DEFECT (issue 2026-10-04-sandhi-tls-server-pem-key-decoded-per-accept, measured on 6.6.15):
# lib/tls.cyr's accept builds a server ctx from the caller's credentials on EVERY connection and
# loads them, and a PEM key went through sigil's pem_decode_privkey each time. That decoder takes
# its DER scratch from the GLOBAL heap (alloc(pem_len)), never from the arena tls_accept_alloc_in
# was given, so a server that rewinds a per-connection arena still kept pem_len bytes (rounded to
# 8) per connection: 120 B per request for a 119-byte Ed25519 key (sandhi 1.10.7's
# _server_tls_probe [8]). A DER key cost 0.
#
# ROWS
#   - the filed shape: 40 accepts of a 119-byte Ed25519 PKCS#8 PEM through tls_accept_alloc_in,
#     the arena rewound per accept: 0 B of global heap per accept (6.6.15: 120);
#   - each key form loads the same algorithm and key material as its DER, and an accept after
#     the first costs 0 B: Ed25519 PKCS#8, and P-256 / P-384 in PKCS#8 and SEC1, as PEM and DER;
#     and a client's own key (tls_native_set_client_key, mTLS), which the same code loads;
#   - refusals keep the error the accept path gave (TLS_ERR_KEY_UNSUPPORTED from
#     tls_native_server_load_creds, so tls_accept_alloc_in answers 0), every time, and cost 0 B
#     from the second on: RSA (PKCS#1 and PKCS#8 PEM, DER), bad base64, no END line, a truncated
#     body, a certificate, a lone dash, and a label that does not match its body (the PKCS#8 label
#     around a SEC1 key, and the reverse: the decoder's verdict is kept, not a looser re-parse);
#   - the cache is keyed on the TEXT: two keys of the same length alternate, and one buffer is
#     refilled with another key, and each load gets its own key;
#   - real handshakes: lib/tls.cyr's tls_accept_alloc_in + tls_accept_complete against
#     tls_native_connect, over the replay transport of tls_native_client_auth.tcyr (one thread,
#     so it runs on every host): each key form in TLS 1.3 and one PEM per algorithm in TLS 1.2,
#     "ping" / "pong" both ways, and 0 B of global heap per server run; a server whose key is
#     not its certificate's fails at the client (TLS_ERR_AUTHN), so the rows have teeth;
#   - threads: 8 loaders take one new key and one key each at once. Every load gets its key, and
#     afterwards every one of them is served from the cache;
#   - past the cache's capacity a new key still loads correctly, and a key cached before it
#     filled is still served from it.
# MEASURED RED: the 6.6.15 lib fails 24 of the 204 assertions, every growth row whose text reaches
# the decoder's allocation (a text with no key label, or no END line, never did); 40 accepts of
# the 119-byte key cost it 4800 B, the filed 120 B each. Every other row holds on both.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/chrono.cyr"
include "lib/atomic.cyr"
include "lib/thread.cyr"
include "lib/tls.cyr"

enum PkHandle { PK_CLIENT = 1; PK_SERVER = 2; }
var PK_LOG_CAP = 65536;
var PK_ROUNDS_MAX = 10;
var PK_ACCEPTS = 40;        # accepts per growth measurement
var PK_RACERS = 8;
var PK_RACE_LOADS = 25;
var PK_DEADLINE_MS = 60000; # a racer that has not finished by then fails the row

# ---- fixtures (openssl 3.6; every certificate self-signed, CN=localhost) ----
var _pk_ed_crt = 0;
var _pk_ed_der = 0;
var _pk_p256_crt = 0;
var _pk_p256_p8 = 0;
var _pk_p256_sec1 = 0;
var _pk_p384_crt = 0;
var _pk_p384_p8 = 0;
var _pk_p384_sec1 = 0;
var _pk_rsa_der = 0;
var _pk_ed_pem = 0;
var _pk_p256_p8_pem = 0;
var _pk_p256_sec1_pem = 0;
var _pk_p384_p8_pem = 0;
var _pk_p384_sec1_pem = 0;
var _pk_rsa_p1_pem = 0;
var _pk_rsa_p8_pem = 0;
var _pk_ed_seed = 0;        # the key material each form must load (its DER, through sigil's parser)
var _pk_p256_d = 0;
var _pk_p384_d = 0;

