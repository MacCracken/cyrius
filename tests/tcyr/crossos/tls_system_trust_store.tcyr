# tls_system_trust_store.tcyr — 6.6.14 (CYRIUS-2026-0020): where the native TLS client's SYSTEM trust roots
# come from, on every target.
#
#   POSIX (Linux, macOS, aarch64): the first readable of the four bundle paths, as before.
#   Windows: NEVER those paths. "/etc/ssl/cert.pem" is drive-relative there (C:\etc\ssl\cert.pem)
#            and any local user may create C:\etc, so the bundle reader let one user plant trust
#            anchors for every native TLS client on the box (measured on cass, 6.6.13: a planted
#            cert.pem installed as the only root).
#
#   Windows: since 6.6.14 the CurrentUser ROOT store instead, through crypt32 — before it Windows
#            had no system roots at all, so every verifying native connect failed. Only the roots
#            Windows trusts for TLS server authentication are taken (see _tn_ca_read_win).
#
# The Windows rows plant that file THEMSELVES — the fixture P-256 CA (CN=localhost, the root
# tls_native_scaffold.tcyr serves) at the exact path the reader opened — load the system roots,
# and assert the planted root is not among them; then they remove only what they created. They
# run first: the system set is loaded once per process. The store-policy rows re-derive, with
# their own decoding, which ROOT-store certificates the policy takes for TLS and compare that with
# the bundle the library exported, certificate by certificate. Because a real store holds only what
# the host happens to hold (cass's Disallowed store is empty, no root there carries prop 84 or an
# over-long or malformed property), the policy is then run rule by rule on stores the test builds in
# MEMORY: the fixture root with exactly the properties each row names.
# A SERVER ctx (it verifies CLIENT chains) gets, on Windows, a second set: the roots the store trusts
# for CLIENT authentication (CYRIUS-2026-0027, 6.6.17 — it was handed the serverAuth set, so a root Windows
# trusts for server authentication only anchored an mTLS client identity). The client-purpose rows
# re-derive that set from the real store, run the policy rule by rule for the client purpose on the
# memory stores, and verify one client chain end to end against a root whose store purposes are
# [serverAuth] (refused) and [clientAuth] (verifies). POSIX bundles carry no per-root purpose, so
# there a server ctx shares the client ctx's set (one row pins that).
# Every host verifies one real chain offline, at a fixed time: www.microsoft.com's (leaf, Microsoft
# TLS G2 RSA CA OCSP 04, Microsoft TLS RSA Root G2) to DigiCert Global Root G2, which is in the
# Windows store and in every POSIX bundle.
# Cross-OS because the store is a different thing on every host.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/tls.cyr"

var _ts_p256 = 0;          # DER, 385 bytes — the planted root (CN=localhost, 2026-06-01 .. 2036-05-29)
var _ts_p256_len = 385;
var _ts_now = 1790931739;  # 2026-10-02: inside every fixture's validity window
var _ts_ms = 0;            # www.microsoft.com chain, DER: leaf (2026-01-22 .. 2027-01-17),
var _ts_ms_len = 2478;
var _ts_mi = 0;            # Microsoft TLS G2 RSA CA OCSP 04 (2025-08-01 .. 2029-06-03),
var _ts_mi_len = 1980;
var _ts_mr = 0;            # Microsoft TLS RSA Root G2, cross-signed by DigiCert Global Root G2
var _ts_mr_len = 1421;
var _ts_eku_root = 0;      # tls_native_ca_eku.tcyr's root_none (CN=eku-root, no EKU), DER, 348 bytes, and
var _ts_eku_leaf = 0;      # its leaf_r (CN=localhost, serverAuth + clientAuth, notBefore 2025-01-01), 432 bytes
var _ts_eku_nb = 1735689600;
var _TS_EKU_NOW = 1893456000;   # 2030-01-01: inside the eku fixtures' 2025 .. 2049 window
var _ts_dn = 0;            # DigiNotar Root CA (SHA-1 c060ed44...), DER, 1422 bytes: distrusted by Windows
var _ts_dn_len = 1422;     # through the disallowed CTL (6.7.12)

# Base64 (RFC 4648) of src[0..n) into out; returns the length written.
fn _ts_b64(src, n, out): i64 {
    var tbl = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    var i = 0;
    var o = 0;
    while (i + 3 <= n) {
        var v = ((load8(src + i) & 0xFF) << 16) | ((load8(src + i + 1) & 0xFF) << 8) | (load8(src + i + 2) & 0xFF);
        store8(out + o, load8(tbl + ((v >> 18) & 63)));
        store8(out + o + 1, load8(tbl + ((v >> 12) & 63)));
        store8(out + o + 2, load8(tbl + ((v >> 6) & 63)));
        store8(out + o + 3, load8(tbl + (v & 63)));
        i = i + 3;
        o = o + 4;
    }
    var rem = n - i;
    if (rem > 0) {
        var w = (load8(src + i) & 0xFF) << 16;
        if (rem == 2) { w = w | ((load8(src + i + 1) & 0xFF) << 8); }
        store8(out + o, load8(tbl + ((w >> 18) & 63)));
        store8(out + o + 1, load8(tbl + ((w >> 12) & 63)));
        store8(out + o + 2, 61);
        if (rem == 2) { store8(out + o + 2, load8(tbl + ((w >> 6) & 63))); }
        store8(out + o + 3, 61);
        o = o + 4;
    }
    return o;
}

# One PEM certificate block (64-column body) at buf; returns its length.
fn _ts_pem(buf, der, dlen): i64 {
    memcpy(buf, "-----BEGIN CERTIFICATE-----\n", 28);
    var pos = 28;
    var b = alloc(dlen * 2 + 8);
    var bl = _ts_b64(der, dlen, b);
    var i = 0;
    while (i < bl) {
        var k = bl - i;
        if (k > 64) { k = 64; }
        memcpy(buf + pos, b + i, k);
        pos = pos + k;
        store8(buf + pos, 10);
        pos = pos + 1;
        i = i + k;
    }
    memcpy(buf + pos, "-----END CERTIFICATE-----\n", 26);
    return pos + 26;
}

# 1 when needle[0..nl) occurs in hay[0..hl).
fn _ts_contains(hay, hl, needle, nl): i64 {
    if (hay == 0) { return 0; }
    var i = 0;
    while (i + nl <= hl) {
        if (memeq(hay + i, needle, nl) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn _ts_installed(ctx): i64 {
    var set = load64(ctx + TLS_CTX_OFF_CA_ROOT);
    if (set == 0) { return 0; }
    return load64(set);
}

# Verify `leaf` (parsed) with intermediates `inters` ([count][ptrs], or 0) against `ctx`'s roots.
fn _ts_verify(ctx, leaf, inters, now): i64 {
    store64(ctx + TLS_CTX_OFF_SERVER_CERT, leaf);
    store64(ctx + TLS_CTX_OFF_SERVER_INTERS, inters);
    return tls_native_client_verify_chain(ctx, now);
}

# Windows: a planted C:\etc\ssl\cert.pem is NOT a trust root. Runs before anything else loads the
# system set (it is loaded once per process, so this is the load).
fn test_planted_bundle_ignored(): i64 {
    test_group("Windows: a planted /etc/ssl/cert.pem (drive-relative, C: etc ssl) is not read");
    var pem = alloc(2048);
    var plen = _ts_pem(pem, _ts_p256, _ts_p256_len);
    # Create only what is missing, and remember it: a host whose C:\etc already exists keeps it.
    var made_etc = 0;
    var made_ssl = 0;
    var made_pem = 0;
    if (xmkdir("/etc", 0x1ED) == 0) { made_etc = 1; }
    if (xmkdir("/etc/ssl", 0x1ED) == 0) { made_ssl = 1; }
    if (file_exists("/etc/ssl/cert.pem") == 0) {
        if (file_write_all("/etc/ssl/cert.pem", pem, plen) == plen) { made_pem = 1; }
    }
    assert_eq(made_pem, 1, "the test planted /etc/ssl/cert.pem (it did not exist)");
    assert_eq(file_exists("/etc/ssl/cert.pem"), 1, "the planted file is there to be read");
    var c = tls_native_new_client("localhost", 9);
    var rc = tls_native_set_ca_system(c);
    syscall(1, 1, "  set_ca_system rc ", 19);
    fmt_int(rc);
    syscall(1, 1, ", ", 2);
    fmt_int(_ts_installed(c));
    syscall(1, 1, " roots installed\n", 17);
    assert_eq(rc, TLS_OK, "the Windows ROOT store loads (TLS_OK, not TLS_ERR_IO)");
    assert_gt(_ts_installed(c), 0, "and installs roots");
    # The planted root must not anchor anything: its own self-signed cert does not verify.
    var leaf = x509_cert_alloc();
    assert_eq(x509_parse(_ts_p256, _ts_p256_len, leaf), 1, "the planted root parses");
    var v = tls_native_new_client("localhost", 9);
    store64(v + TLS_CTX_OFF_CA_ROOT, load64(c + TLS_CTX_OFF_CA_ROOT));
    assert_eq(_ts_verify(v, leaf, 0, _ts_now), TLS_ERR_CERT_INVALID, "the planted root anchors nothing");
    # And its bytes are not in the cached system bundle.
    var b = alloc(1024);
    var bl = _ts_b64(_ts_p256, 48, b);
    var inbuf = 0;
    if (_tn_ca_len > 0) { inbuf = _ts_contains(_tn_ca_buf, _tn_ca_len, b, bl); }
    assert_eq(inbuf, 0, "the planted PEM is not in the cached system bundle");
    # The client-purpose set a server ctx loads (CYRIUS-2026-0027) reads the store too, never the file.
    var sc = _tn_ctx_new(TLS_ROLE_SERVER);
    assert_eq(tls_native_set_ca_system(sc), TLS_OK, "a server ctx's system set loads while the file is planted");
    var inbuf2 = 0;
    if (_tn_ca_cl_len > 0) { inbuf2 = _ts_contains(_tn_ca_cl_buf, _tn_ca_cl_len, b, bl); }
    assert_eq(inbuf2, 0, "  and the planted PEM is not in it");
    # Remove only what this test created.
    if (made_pem == 1) { assert_eq(xunlink("/etc/ssl/cert.pem"), 0, "the planted file is removed"); }
    if (made_ssl == 1) { assert_eq(xrmdir("/etc/ssl"), 0, "the created /etc/ssl is removed"); }
    if (made_etc == 1) { assert_eq(xrmdir("/etc"), 0, "the created /etc is removed"); }
    assert_eq(file_exists("/etc/ssl/cert.pem"), 0, "nothing planted is left behind");
    return 0;
}

# The test's own count of BEGIN markers — independent of the library's.
fn _ts_blocks(pem, len): i64 {
    var n = 0;
    var i = 0;
    while (i + 27 <= len) {
        if (memeq(pem + i, "-----BEGIN CERTIFICATE-----", 27) == 1) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# Every target: the system set loads, once, and its counts add up.
fn test_system_roots(): i64 {
    test_group("tls_native_set_ca_system: the system set loads and its counts add up");
    var c = tls_native_new_client("localhost", 9);
    assert_eq(tls_native_set_ca_system(c), TLS_OK, "tls_native_set_ca_system: TLS_OK");
    assert_gt(_tn_ca_len, 0, "the system bundle has bytes");
    var blocks = _ts_blocks(_tn_ca_buf, _tn_ca_len);
    var inst = _ts_installed(c);
    var sk = tls_native_ca_skipped(c);
    syscall(1, 1, "  system bundle: ", 17);
    fmt_int(blocks);
    syscall(1, 1, " blocks, ", 9);
    fmt_int(inst);
    syscall(1, 1, " installed, ", 12);
    fmt_int(sk);
    syscall(1, 1, " skipped (", 10);
    fmt_int(_tn_ca_sys_refused);
    syscall(1, 1, " refused by store policy)\n", 26);
    assert_gt(inst, 0, "it installs roots");
    assert_eq(inst + sk, blocks + _tn_ca_sys_refused, "installed + skipped == PEM blocks + refused");
    #ifndef CYRIUS_TARGET_WIN
    assert_eq(_tn_ca_sys_refused, 0, "POSIX: nothing is refused outside the bundle");
    #endif
    var d = tls_native_new_client("localhost", 9);
    var u0 = alloc_used();
    assert_eq(tls_native_set_ca_system(d), TLS_OK, "a second ctx installs too");
    assert_eq(alloc_used() - u0, 0, "and allocates nothing: the set is loaded once, shared");
    assert_eq(load64(d + TLS_CTX_OFF_CA_ROOT), load64(c + TLS_CTX_OFF_CA_ROOT), "the same set");
    # A SERVER ctx (it verifies client chains) loads the system roots too.
    var sv = _tn_ctx_new(TLS_ROLE_SERVER);
    assert_eq(tls_native_set_ca_system(sv), TLS_OK, "a server ctx: tls_native_set_ca_system TLS_OK");
    assert_gt(_ts_installed(sv), 0, "  and installs roots");
    #ifndef CYRIUS_TARGET_WIN
    assert_eq(load64(sv + TLS_CTX_OFF_CA_ROOT), load64(c + TLS_CTX_OFF_CA_ROOT),
      "POSIX: the same set as a client ctx (a bundle has no per-root purpose)");
    #endif
    #ifdef CYRIUS_TARGET_WIN
    assert_neq(load64(sv + TLS_CTX_OFF_CA_ROOT), load64(c + TLS_CTX_OFF_CA_ROOT),
      "Windows: a different set from a client ctx's — the roots trusted for client authentication");
    var sv2 = _tn_ctx_new(TLS_ROLE_SERVER);
    var u1 = alloc_used();
    assert_eq(tls_native_set_ca_system(sv2), TLS_OK, "a second server ctx installs too");
    assert_eq(alloc_used() - u1, 0, "  allocating nothing: the client-purpose set is loaded once, shared");
    assert_eq(load64(sv2 + TLS_CTX_OFF_CA_ROOT), load64(sv + TLS_CTX_OFF_CA_ROOT), "  the same set");
    #endif
    return 0;
}

# Parse a DER certificate the test embeds; 0 if it does not parse.
fn _ts_cert(der, dlen): i64 {
    var c = x509_cert_alloc();
    if (x509_parse(der, dlen, c) != 1) { return 0; }
    return c;
}

# Every target: a real public chain verifies against the system roots, offline, at a fixed time.
fn test_real_chain(): i64 {
    test_group("a real chain (www.microsoft.com -> DigiCert Global Root G2) verifies against the system roots");
    var leaf = _ts_cert(_ts_ms, _ts_ms_len);
    var ica = _ts_cert(_ts_mi, _ts_mi_len);
    var xr = _ts_cert(_ts_mr, _ts_mr_len);
    assert_neq(leaf, 0, "the leaf parses");
    assert_neq(ica, 0, "the issuing CA parses");
    assert_neq(xr, 0, "the cross-signed root parses");
    var inters = alloc(24);
    store64(inters, 2);
    store64(inters + 8, ica);
    store64(inters + 16, xr);
    var c = tls_native_new_client("www.microsoft.com", 17);
    assert_eq(tls_native_set_ca_system(c), TLS_OK, "the system set installs");
    assert_eq(_ts_verify(c, leaf, inters, _ts_now), TLS_OK, "the chain verifies (TLS_OK)");
    # Controls: the system set is what anchored it, and the time is honoured.
    var d = tls_native_new_client("www.microsoft.com", 17);
    assert_eq(tls_native_set_ca_bundle(d, _ts_p256, _ts_p256_len, 1), TLS_OK, "a set of only the fixture root");
    assert_eq(_ts_verify(d, leaf, inters, _ts_now), TLS_ERR_CERT_INVALID, "does not anchor it");
    var e = tls_native_new_client("www.microsoft.com", 17);
    tls_native_set_ca_system(e);
    assert_eq(_ts_verify(e, leaf, inters, x509_cert_not_after(leaf) + 86400), TLS_ERR_CERT_INVALID,
      "after the leaf's notAfter it fails");
    var f = tls_native_new_client("www.microsoft.com", 17);
    tls_native_set_ca_system(f);
    store64(inters, 1);                 # the cross-signed root left out: no path to an anchor
    assert_eq(_ts_verify(f, leaf, inters, _ts_now), TLS_ERR_CERT_INVALID, "without its cross-signed root it fails");
    return 0;
}

# ── 6.7.12: the root set's trust policy, every target ─────────────────────────────────────────────
# On Windows tls_native_set_ca_system installs the system store's policy (TLS_CTX_OFF_CA_POLICY): the
# disallowed CTL's public-key entries, the Disallowed store's certificates, a NotBefore root's issuance
# bound. The verifier applies it on every target, so these rows install policies of their own and run
# the verifier offline.

# The MD5 of `c`'s (parsed) subjectPublicKey, 16 bytes (the CTL's identifier form).
fn _tp_key(c): i64 {
    var h = alloc(16);
    if (_tn_spki_md5(load64(c), load64(c + 8), h) != 1) { return 0; }
    return h;
}

# A policy that distrusts the keys of the certificates `a` and `b` (parsed; 0 = none).
fn _tp_deny_keys(a, b): i64 {
    var keys = alloc(32);
    var n = 0;
    if (a != 0) {
        memcpy(keys, _tp_key(a), 16);
        n = 1;
    }
    if (b != 0) {
        memcpy(keys + n * 16, _tp_key(b), 16);
        n = n + 1;
    }
    return _tn_pol_new(n, keys, 0, 0, 0, 0);
}

# A policy that distrusts the certificate `c` (parsed) byte for byte.
fn _tp_deny_cert(c): i64 {
    var l = alloc(16);
    store64(l, load64(c));
    store64(l + 8, load64(c + 8));
    return _tn_pol_new(0, 0, 1, l, 0, 0);
}

# A policy giving the root `r` (parsed) the issuance bound `b`.
fn _tp_bound(r, b): i64 {
    var l = alloc(24);
    store64(l, load64(r));
    store64(l + 8, load64(r + 8));
    store64(l + 16, b);
    return _tn_pol_new(0, 0, 0, 0, 1, l);
}

# The microsoft.com chain's verdict at _ts_now on a client ctx with the system roots and policy `pol`.
fn _tp_ms(leaf, inters, pol): i64 {
    var c = tls_native_new_client("www.microsoft.com", 17);
    if (tls_native_set_ca_system(c) != TLS_OK) { return 0 - 99; }
    store64(c + TLS_CTX_OFF_CA_POLICY, pol);
    return _ts_verify(c, leaf, inters, _ts_now);
}

# The system root that anchors `cur` (parsed): issuer-matching and signing it; 0 when none.
fn _tp_anchor_of(cur): i64 {
    var c = tls_native_new_client("localhost", 9);
    if (tls_native_set_ca_system(c) != TLS_OK) { return 0; }
    var set = load64(c + TLS_CTX_OFF_CA_ROOT);
    var i = 0;
    while (i < load64(set)) {
        var r = load64(set + 8 + i * 8);
        if (_x509_issuer_matches(cur, r) == 1) {
            if (_x509_verify_link(cur, r) == 1) { return r; }
        }
        i = i + 1;
    }
    return 0;
}

# Every target: a certificate the policy distrusts — by its key (the disallowed CTL's form) or byte for
# byte (the Disallowed store's) — breaks the path wherever it stands: leaf, intermediate, cross-signed
# root, trust anchor. Before 6.7.12 nothing beyond the root set was consulted.
fn test_policy_deny_rows(): i64 {
    test_group("the trust policy's deny list binds every certificate of a path (6.7.12)");
    var leaf = _ts_cert(_ts_ms, _ts_ms_len);
    var ica = _ts_cert(_ts_mi, _ts_mi_len);
    var xr = _ts_cert(_ts_mr, _ts_mr_len);
    var other = _ts_cert(_ts_p256, _ts_p256_len);
    var inters = alloc(24);
    store64(inters, 2);
    store64(inters + 8, ica);
    store64(inters + 16, xr);
    var anchor = _tp_anchor_of(xr);
    assert_neq(anchor, 0, "DigiCert Global Root G2 is in the system set and anchors the chain");
    assert_eq(_tp_ms(leaf, inters, 0), TLS_OK, "no policy: the chain verifies (control)");
    assert_eq(_tp_ms(leaf, inters, _tp_deny_keys(other, 0)), TLS_OK, "an unrelated key denied: verifies");
    assert_eq(_tp_ms(leaf, inters, _tn_pol_new(0, 0, 0, 0, 0, 0)), TLS_OK, "an empty policy: verifies");
    assert_eq(_tp_ms(leaf, inters, _tp_deny_keys(ica, 0)), TLS_ERR_CERT_INVALID,
      "the INTERMEDIATE's key denied: refused");
    assert_eq(_tp_ms(leaf, inters, _tp_deny_keys(xr, 0)), TLS_ERR_CERT_INVALID,
      "the cross-signed root's key denied: refused");
    assert_eq(_tp_ms(leaf, inters, _tp_deny_keys(leaf, 0)), TLS_ERR_CERT_INVALID, "the LEAF's key denied: refused");
    if (anchor != 0) {
        assert_eq(_tp_ms(leaf, inters, _tp_deny_keys(anchor, 0)), TLS_ERR_CERT_INVALID,
          "the trust anchor's key denied: refused");
    }
    assert_eq(_tp_ms(leaf, inters, _tp_deny_keys(other, ica)), TLS_ERR_CERT_INVALID,
      "the intermediate's key second in the list: refused");
    assert_eq(_tp_ms(leaf, inters, _tp_deny_cert(ica)), TLS_ERR_CERT_INVALID,
      "the intermediate denied byte for byte (the Disallowed store's form): refused");
    assert_eq(_tp_ms(leaf, inters, _tp_deny_cert(other)), TLS_OK, "an unrelated certificate denied: verifies");
    # A caller's own bundle carries no system policy: installing one clears it.
    var c = tls_native_new_client("www.microsoft.com", 17);
    store64(c + TLS_CTX_OFF_CA_POLICY, _tp_deny_keys(ica, 0));
    assert_eq(tls_native_set_ca_bundle(c, _ts_p256, _ts_p256_len, 1), TLS_OK, "a caller's bundle installs");
    assert_eq(load64(c + TLS_CTX_OFF_CA_POLICY), 0, "  and clears the policy");
    var d = tls_native_new_client("www.microsoft.com", 17);
    assert_eq(tls_native_set_ca_system(d), TLS_OK, "the system set installs");
    #ifndef CYRIUS_TARGET_WIN
    assert_eq(load64(d + TLS_CTX_OFF_CA_POLICY), 0, "  POSIX: with no policy (a bundle is a list of roots)");
    #endif
    #ifdef CYRIUS_TARGET_WIN
    assert_eq(load64(d + TLS_CTX_OFF_CA_POLICY), _tn_ca_sys_pol, "  Windows: with the system store's policy");
    #endif
    return 0;
}

# Every target: the identifier the disallowed CTL lists DigiNotar Root CA under is the MD5 of its
# public key — the entry read from the CTL on cass (2026-10-15), and what Windows' chain engine
# distrusts DigiNotar by (CERT_TRUST_IS_EXPLICIT_DISTRUST, the Disallowed store empty).
fn test_ctl_identifier_row(): i64 {
    test_group("the disallowed CTL's identifier is the MD5 of a certificate's public key (6.7.12)");
    var dn = _ts_cert(_ts_dn, _ts_dn_len);
    assert_neq(dn, 0, "DigiNotar Root CA parses");
    var want = hex_decode("37392e833dc605dd7b38244739939ee3", 32);
    var h = alloc(16);
    assert_eq(_tn_spki_md5(_ts_dn, _ts_dn_len, h), 1, "its subjectPublicKey is found");
    assert_eq(memeq(h, want, 16), 1, "  its MD5 is the CTL's entry 37392e83 3dc605dd 7b382447 39939ee3");
    var keys = alloc(16);
    memcpy(keys, want, 16);
    var pol = _tn_pol_new(1, keys, 0, 0, 0, 0);
    var c = tls_native_new_client("localhost", 9);
    assert_eq(tls_native_set_ca_bundle(c, _ts_dn, _ts_dn_len, 1), TLS_OK, "a set of DigiNotar Root CA alone");
    assert_eq(_tn_pol_der_denied(pol, _ts_dn, _ts_dn_len), 1, "a policy holding that entry denies it");
    assert_eq(_tn_pol_der_denied(pol, _ts_p256, _ts_p256_len), 0, "  and not an unrelated certificate");
    return 0;
}

# Every target: a root carrying an issuance bound (Windows' NotBefore distrust, D9) anchors a leaf whose
# notBefore precedes the bound, and refuses one issued on or after it — it is the LEAF's date that counts.
fn test_policy_bound_rows(): i64 {
    test_group("a root's issuance bound: older leaves anchor, newer ones do not (6.7.12, D9)");
    var root = _ts_cert(_ts_eku_root, 348);
    var leaf = _ts_cert(_ts_eku_leaf, 432);
    assert_neq(root, 0, "the eku root parses");
    assert_neq(leaf, 0, "its leaf parses");
    assert_eq(x509_cert_not_before(leaf), _ts_eku_nb, "  the leaf's notBefore is 2025-01-01T00:00:00Z");
    var c = tls_native_new_client("localhost", 9);
    assert_eq(tls_native_set_ca_bundle(c, _ts_eku_root, 348, 1), TLS_OK, "a set of the eku root alone");
    var set = load64(c + TLS_CTX_OFF_CA_ROOT);
    var r = load64(set + 8);
    assert_eq(_tn_verify_chain(c, leaf, 0, _TS_EKU_NOW, _TN_PURPOSE_SERVER), TLS_OK, "no bound: verifies");
    store64(c + TLS_CTX_OFF_CA_POLICY, _tp_bound(r, _ts_eku_nb + 1));
    assert_eq(_tn_verify_chain(c, leaf, 0, _TS_EKU_NOW, _TN_PURPOSE_SERVER), TLS_OK,
      "bound one second after the leaf's notBefore: verifies (issued before the date)");
    store64(c + TLS_CTX_OFF_CA_POLICY, _tp_bound(r, _ts_eku_nb));
    assert_eq(_tn_verify_chain(c, leaf, 0, _TS_EKU_NOW, _TN_PURPOSE_SERVER), TLS_ERR_CERT_INVALID,
      "bound AT the leaf's notBefore: refused (on or after)");
    store64(c + TLS_CTX_OFF_CA_POLICY, _tp_bound(r, _ts_eku_nb - 86400));
    assert_eq(_tn_verify_chain(c, leaf, 0, _TS_EKU_NOW, _TN_PURPOSE_SERVER), TLS_ERR_CERT_INVALID,
      "bound a day before it: refused");
    store64(c + TLS_CTX_OFF_CA_POLICY, _tp_bound(_ts_cert(_ts_p256, _ts_p256_len), _ts_eku_nb));
    assert_eq(_tn_verify_chain(c, leaf, 0, _TS_EKU_NOW, _TN_PURPOSE_SERVER), TLS_OK,
      "a bound on a different root: verifies");
    # Through intermediates: the anchor's bound is compared with the LEAF, not with the CA below it.
    var mleaf = _ts_cert(_ts_ms, _ts_ms_len);
    var ica = _ts_cert(_ts_mi, _ts_mi_len);
    var xr = _ts_cert(_ts_mr, _ts_mr_len);
    var inters = alloc(24);
    store64(inters, 2);
    store64(inters + 8, ica);
    store64(inters + 16, xr);
    var anchor = _tp_anchor_of(xr);
    assert_neq(anchor, 0, "the microsoft.com chain's anchor is in the system set");
    if (anchor != 0) {
        var lnb = x509_cert_not_before(mleaf);
        assert_eq(_tp_ms(mleaf, inters, _tp_bound(anchor, lnb + 1)), TLS_OK,
          "anchor bound just after the leaf's notBefore: verifies");
        assert_eq(_tp_ms(mleaf, inters, _tp_bound(anchor, x509_cert_not_before(ica) + 1)), TLS_ERR_CERT_INVALID,
          "anchor bound after the intermediates' notBefore but before the leaf's: refused");
    }
    return 0;
}

#ifdef CYRIUS_TARGET_WIN
var _TS_NOT_FOUND = 0x80092004;     # CRYPT_E_NOT_FOUND
var _ts_oid_sa = 0;                 # 06 08 2B 06 01 05 05 07 03 01 — serverAuth, as a whole TLV
var _ts_oid_ca = 0;                 # 06 08 2B 06 01 05 05 07 03 02 — clientAuth
var _ts_oid_any = 0;                # 06 04 55 1D 25 00 — anyExtendedKeyUsage
var _ts_pbuf = 0;                   # one property value

# The test's own read of property `id` of the store certificate `cc` into _ts_pbuf: its length,
# -1 when absent, -2 when the call failed for another reason.
fn _ts_prop(fns, cc, id): i64 {
    var cb[8];
    store64(&cb, 65536);
    var r = callptr(load64(fns + 24), cc, id, _ts_pbuf, &cb) & 0xFFFFFFFF;
    if (r == 0) {
        if ((syscall(0xF04B) & 0xFFFFFFFF) == _TS_NOT_FOUND) { return 0 - 1; }
        return 0 - 2;
    }
    return load32(&cb);
}

# serverAuth (`pu` = _TN_PURPOSE_SERVER) or clientAuth (_TN_PURPOSE_CLIENT), or anyExtendedKeyUsage,
# anywhere in a purpose list, as a whole TLV — a different reading from the library's element walk.
fn _ts_names(n, pu): i64 {
    var want = _ts_oid_sa;
    if (pu == _TN_PURPOSE_CLIENT) { want = _ts_oid_ca; }
    if (_ts_contains(_ts_pbuf, n, want, 10) == 1) { return 1; }
    if (_ts_contains(_ts_pbuf, n, _ts_oid_any, 6) == 1) { return 1; }
    return 0;
}

# 1 when _ts_pbuf[0..n) is one well-formed DER SEQUENCE OF OBJECT IDENTIFIER filling it exactly —
# the test's own reading: header first, then each element as a non-empty short-form OID.
fn _ts_eku_ok(n): i64 {
    if (n < 2) { return 0; }
    if ((load8(_ts_pbuf) & 0xFF) != 0x30) { return 0; }
    var b1 = load8(_ts_pbuf + 1) & 0xFF;
    var hl = 0;
    var body = 0;
    if (b1 < 0x80) {
        hl = 2;
        body = b1;
    }
    if (b1 == 0x81) {
        if (n >= 3) {
            hl = 3;
            body = load8(_ts_pbuf + 2) & 0xFF;
        }
    }
    if (b1 == 0x82) {
        if (n >= 4) {
            hl = 4;
            body = ((load8(_ts_pbuf + 2) & 0xFF) << 8) | (load8(_ts_pbuf + 3) & 0xFF);
        }
    }
    if (hl == 0) { return 0; }
    if (hl + body != n) { return 0; }
    var i = hl;
    while (i < n) {
        if (n - i < 2) { return 0; }
        if ((load8(_ts_pbuf + i) & 0xFF) != 6) { return 0; }
        var l = load8(_ts_pbuf + i + 1) & 0xFF;
        if (l < 1) { return 0; }
        if (l > 127) { return 0; }
        if (n - i - 2 < l) { return 0; }
        i = i + 2 + l;
    }
    return 1;
}

# 1 when `cc` carries the dated distrust property `d` (104 Disable, 126 NotBefore) and its purpose
# scope `e` (122, 127) is absent — every purpose — malformed, or names purpose `pu` /
# anyExtendedKeyUsage.
fn _ts_dated(fns, cc, d, e, pu): i64 {
    var nd = _ts_prop(fns, cc, d);
    if (nd == 0 - 1) { return 0; }
    if (nd == 0 - 2) { return 1; }
    var ne = _ts_prop(fns, cc, e);
    if (ne < 0) { return 1; }
    if (_ts_eku_ok(ne) == 0) { return 1; }
    if (_ts_names(ne, pu) == 1) { return 1; }
    return 0;
}

var _ts_xbound = 0;                 # the issuance bound _ts_expect derived (answer 3)

# The NotBefore distrust (126 / 127) of `cc` for purpose `pu`, the test's own reading: 0 none covers
# it, 1 one does (its bound, Unix seconds rounded up, in _ts_xbound), 2 it cannot be judged (a date that
# is not one 8-byte FILETIME, a scope that cannot be read or is malformed).
fn _ts_notbefore(fns, cc, pu): i64 {
    var nd = _ts_prop(fns, cc, 126);
    if (nd == 0 - 1) { return 0; }
    if (nd != 8) { return 2; }
    var ft = load64(_ts_pbuf);
    if (ft < 0) { return 2; }
    var ne = _ts_prop(fns, cc, 127);
    if (ne == 0 - 2) { return 2; }
    if (ne >= 0) {
        if (_ts_eku_ok(ne) == 0) { return 2; }
        if (_ts_names(ne, pu) == 0) { return 0; }
    }
    var secs = ft / 10000000;
    if (secs * 10000000 != ft) { secs = secs + 1; }
    _ts_xbound = secs - 11644473600;
    return 1;
}

# What Windows' root-program properties say about `cc` for TLS purpose `pu`: 1 an anchor, 3 an anchor
# with an issuance bound (6.7.12, D9: a NotBefore date 126 / 127 covers it; the bound in _ts_xbound),
# 0 not a root for it, 2 refused by the library — distrusted by a Disable date that covers it (104 /
# 122), confined by root-program name constraints (84), or a property it cannot read.
fn _ts_expect(fns, cc, pu): i64 {
    var n = _ts_prop(fns, cc, 9);
    if (n == 0 - 2) { return 2; }    # unreadable: the library refuses and counts it
    if (n >= 0) {
        if (_ts_eku_ok(n) == 0) { return 2; }
        if (_ts_names(n, pu) == 0) { return 0; }
    }
    if (_ts_prop(fns, cc, 84) != 0 - 1) { return 2; }
    if (_ts_dated(fns, cc, 104, 122, pu) == 1) { return 2; }
    var nb = _ts_notbefore(fns, cc, pu);
    if (nb == 2) { return 2; }
    if (nb == 1) { return 3; }
    return 1;
}

# ── The disallowed CTL, the test's own reading (6.7.12) ──────────────────────────────────────────
var _ts_ctl_present = 0;            # 1 when the registry holds DisallowedCertEncodedCtl
var _ts_ctl_n = 0;                  # its entries,
var _ts_ctl_n16 = 0;                # those of 16 bytes (the public-key MD5s),
var _ts_ctl_keys = 0;               # copied (16 B each)
var _ts_ctl_n48 = 0;                # and those of 48 bytes (a form not applied; see the library's header)

# Read the CTL through advapi32 + crypt32 directly, into the _ts_ctl_* cells. 1, or 0 when it is
# present but cannot be read.
fn _ts_ctl_read(): i64 {
    var k = syscall(0xF013, "kernel32.dll");
    var ll = syscall(0xF014, k, "LoadLibraryExA");
    var adv = callptr(ll, "advapi32.dll", 0, 0x800);
    var c32 = callptr(ll, "crypt32.dll", 0, 0x800);
    var reg = syscall(0xF014, adv, "RegGetValueW");
    var mk = syscall(0xF014, c32, "CertCreateCTLContext");
    var ws = alloc(256);
    var wv = alloc(64);
    _tn_w_widen("SOFTWARE\\Microsoft\\SystemCertificates\\AuthRoot\\AutoUpdate", ws, 256);
    _tn_w_widen("DisallowedCertEncodedCtl", wv, 64);
    var data = alloc(1048576);
    var cb[8];
    store64(&cb, 1048576);
    var r = callptr(reg, 0x80000002, ws, wv, 0xFFFF, 0, data, &cb) & 0xFFFFFFFF;
    if (r == 2) { return 1; }
    if (r != 0) { return 0; }
    _ts_ctl_present = 1;
    var ctl = callptr(mk, 0x10001, data, load32(&cb));
    if (ctl == 0) { return 0; }
    var info = load64(ctl + 24);
    _ts_ctl_n = load32(info + 96);
    var ents = load64(info + 104);
    _ts_ctl_keys = alloc(_ts_ctl_n * 16 + 16);
    var i = 0;
    while (i < _ts_ctl_n) {
        var l = load32(ents + i * 32);
        if (l == 16) {
            memcpy(_ts_ctl_keys + _ts_ctl_n16 * 16, load64(ents + i * 32 + 8), 16);
            _ts_ctl_n16 = _ts_ctl_n16 + 1;
        }
        if (l == 48) { _ts_ctl_n48 = _ts_ctl_n48 + 1; }
        i = i + 1;
    }
    return 1;
}

# 1 when the 16 bytes at h are one of the CTL's public-key entries.
fn _ts_ctl_lists(h): i64 {
    var i = 0;
    while (i < _ts_ctl_n16) {
        if (memeq(_ts_ctl_keys + i * 16, h, 16) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when the policy `pol` holds a bound `b` for exactly der[0..dlen).
fn _ts_pol_bound_is(pol, der, dlen, b): i64 {
    var i = 0;
    while (i < load64(pol + 32)) {
        var e = load64(pol + 40) + i * 24;
        if (load64(e + 8) == dlen) {
            if (memeq(load64(e), der, dlen) == 1) {
                if (load64(e + 16) == b) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# 1 when der[0..dlen) is one of the `nd` copied certificates at list ([ptr][len] pairs).
fn _ts_listed(list, nd, der, dlen): i64 {
    var i = 0;
    while (i < nd) {
        if (load64(list + i * 16 + 8) == dlen) {
            if (memeq(load64(list + i * 16), der, dlen) == 1) { return 1; }
        }
        i = i + 1;
    }
    return 0;
}

# Windows: the exported bundle for purpose `pu` (`bundle`[0..`blen`), `refused` roots) is exactly the
# ROOT store's roots for it — re-derived here from the store, certificate by certificate, with the
# test's own reading of the properties.
fn _ts_store_policy(pu, bundle, blen, refused, pol): i64 {
    _ts_oid_sa = hex_decode("06082b06010505070301", 20);
    _ts_oid_ca = hex_decode("06082b06010505070302", 20);
    _ts_oid_any = hex_decode("0604551d2500", 12);
    _ts_pbuf = alloc(65536);
    var fns[32];
    assert_eq(_tn_w_crypt32(&fns), 1, "crypt32 loads from System32 and resolves");
    var root = _tn_w_open(&fns, "ROOT");
    var dis = _tn_w_open(&fns, "Disallowed");
    assert_neq(root, 0, "CurrentUser ROOT opens");
    assert_neq(dis, 0, "CurrentUser Disallowed opens");
    var en = load64(&fns + 8);
    # The Disallowed certificates, copied: the walk releases each context it returns.
    var dlist = alloc(512 * 16);
    var nd = 0;
    var c = callptr(en, dis, 0);
    while (c != 0) {
        if (nd < 512) {
            var l = load32(c + 16);
            var cp = alloc(l);
            memcpy(cp, load64(c + 8), l);
            store64(dlist + nd * 16, cp);
            store64(dlist + nd * 16 + 8, l);
            nd = nd + 1;
        }
        c = callptr(en, dis, c);
    }
    var total = 0;
    var want_in = 0;
    var want_ref = 0;
    var not_tls = 0;
    var wrong = 0;
    var nb_tls = 0;                     # roots whose NotBefore distrust (126 / 127) covers TLS (bounded)
    var nb_ok = 0;                      # ... in the bundle AND carrying that bound in the policy
    var ctl_out = 0;                    # roots the CTL's public-key entries keep out
    var keydiff = 0;                    # roots whose key MD5 the library computes differently from crypt32
    var h = alloc(64);
    var kid = alloc(64);                # crypt32's key MD5 (prop 25) of the current root
    var pem = alloc(65536);
    c = callptr(en, root, 0);
    while (c != 0) {
        total = total + 1;
        var der = load64(c + 8);
        var dlen = load32(c + 16);
        # The key identifier the CTL lists (crypt32's CERT_SUBJECT_PUBLIC_KEY_MD5_HASH_PROP_ID, 25) —
        # and the library's own computation of it must agree.
        var kn = _ts_prop(&fns, c, 25);
        if (kn == 16) { memcpy(kid, _ts_pbuf, 16); }
        var lib_ok = _tn_spki_md5(der, dlen, h);
        if (kn != 16) { keydiff = keydiff + 1; }
        if (kn == 16) {
            if (lib_ok != 1) { keydiff = keydiff + 1; }
            if (lib_ok == 1) {
                if (memeq(h, kid, 16) != 1) { keydiff = keydiff + 1; }
            }
        }
        var x = _ts_expect(&fns, c, pu);
        var xb = _ts_xbound;
        if (x != 0) {
            if (_ts_listed(dlist, nd, der, dlen) == 1) { x = 0; }
        }
        if (x != 0) {
            if (kn == 16) {
                if (_ts_ctl_lists(kid) == 1) {
                    x = 0;
                    ctl_out = ctl_out + 1;
                }
            }
        }
        if (x == 0) { not_tls = not_tls + 1; }
        if (x == 1) { want_in = want_in + 1; }
        if (x == 3) { want_in = want_in + 1; }
        if (x == 2) { want_ref = want_ref + 1; }
        var got = 0;
        if (dlen < 40000) {
            var pl = _ts_pem(pem, der, dlen);
            got = _ts_contains(bundle, blen, pem, pl);
        }
        if (x == 1) {
            if (got != 1) { wrong = wrong + 1; }
        }
        if (x == 3) {
            nb_tls = nb_tls + 1;
            if (got != 1) { wrong = wrong + 1; }
            if (got == 1) {
                if (_ts_pol_bound_is(pol, der, dlen, xb) == 1) { nb_ok = nb_ok + 1; }
            }
        }
        if (x == 0) {
            if (got != 0) { wrong = wrong + 1; }
        }
        if (x == 2) {
            if (got != 0) { wrong = wrong + 1; }
        }
        c = callptr(en, root, c);
    }
    callptr(load64(&fns + 16), dis, 0);
    callptr(load64(&fns + 16), root, 0);
    syscall(1, 1, "  ROOT store: ", 14);
    fmt_int(total);
    syscall(1, 1, " certificates, ", 15);
    fmt_int(want_in);
    syscall(1, 1, " TLS roots, ", 12);
    fmt_int(not_tls);
    syscall(1, 1, " not for TLS, ", 14);
    fmt_int(want_ref);
    syscall(1, 1, " refused by policy, ", 20);
    fmt_int(nd);
    syscall(1, 1, " in Disallowed, ", 16);
    fmt_int(ctl_out);
    syscall(1, 1, " kept out by the CTL; ", 22);
    fmt_int(nb_tls);
    syscall(1, 1, " taken with a NotBefore bound\n", 30);
    assert_gt(total, 0, "the ROOT store has certificates");
    assert_gt(want_in, 0, "some are TLS roots");
    assert_eq(keydiff, 0, "the library's key MD5 equals crypt32's (prop 25) for every ROOT certificate");
    assert_eq(wrong, 0, "each ROOT certificate is in the bundle exactly when Windows trusts it for TLS");
    assert_eq(_ts_blocks(bundle, blen), want_in, "the bundle holds exactly those");
    assert_eq(nb_ok, nb_tls, "every root whose NotBefore distrust covers TLS is in it WITH its bound (D9)");
    assert_eq(load64(pol + 32), nb_tls, "  and the policy carries exactly those bounds");
    assert_eq(refused, want_ref, "the roots the policy refuses are the refused count");
    assert_eq(load64(pol), _ts_ctl_n16, "the policy carries the CTL's public-key entries, every one");
    assert_eq(load64(pol + 16), nd, "  and the Disallowed store's certificates");
    return 0;
}

fn test_store_policy(): i64 {
    test_group("Windows: the disallowed CTL is read (6.7.12)");
    assert_eq(_ts_ctl_read(), 1, "the test reads the CTL itself (or finds none)");
    syscall(1, 1, "  CTL: ", 7);
    if (_ts_ctl_present == 0) { syscall(1, 1, "absent (no DisallowedCertEncodedCtl - wine) ", 44); }
    fmt_int(_ts_ctl_n);
    syscall(1, 1, " entries, ", 10);
    fmt_int(_ts_ctl_n16);
    syscall(1, 1, " public-key MD5s applied, ", 26);
    fmt_int(_ts_ctl_n48);
    syscall(1, 1, " of 48 bytes not applied\n", 25);
    assert_neq(_tn_ca_sys_pol, 0, "the system set was published with a trust policy");
    if (_tn_ca_sys_pol == 0) { return 0; }
    if (_ts_ctl_present == 1) {
        assert_gt(_ts_ctl_n16, 0, "present: it lists public keys (cass: 82 of 88)");
        assert_gt(load64(_tn_ca_sys_pol), 0, "  and the system set's policy carries them");
    }
    if (_ts_ctl_present == 0) {
        assert_eq(load64(_tn_ca_sys_pol), 0, "absent: the policy lists no key, and the store still loads");
    }
    test_group("Windows: the bundle is exactly the ROOT store's TLS roots, re-derived here");
    _ts_store_policy(_TN_PURPOSE_SERVER, _tn_ca_buf, _tn_ca_len, _tn_ca_sys_refused, _tn_ca_sys_pol);
    # CYRIUS-2026-0027: a server ctx's set is the store's CLIENT-authentication roots.
    test_group("Windows: a server ctx's bundle is exactly the ROOT store's clientAuth roots, re-derived here");
    var sv = _tn_ctx_new(TLS_ROLE_SERVER);
    assert_eq(tls_native_set_ca_system(sv), TLS_OK, "a server ctx loads the client-purpose set");
    assert_gt(_tn_ca_cl_len, 0, "  its bundle has bytes");
    assert_neq(_tn_ca_cl_pol, 0, "  published with a trust policy");
    if (_tn_ca_cl_pol == 0) { return 0; }
    _ts_store_policy(_TN_PURPOSE_CLIENT, _tn_ca_cl_buf, _tn_ca_cl_len, _tn_ca_cl_refused, _tn_ca_cl_pol);
    return 0;
}

# ── The store policy on stores the test builds in memory ─────────────────────────────────────
# The real ROOT store exercises only what the host happens to hold — cass's Disallowed store is
# EMPTY, so a library that ignored Disallowed passed every row above. These rows build
# CERT_STORE_PROV_MEMORY stores, add the fixture root with exactly the properties the row names, and
# run the library's own walk (_tn_w_export) over them. Deterministic on any Windows host; no admin
# rights; no machine trust state is touched.
var _tm_add = 0;        # CertAddEncodedCertificateToStore
var _tm_setp = 0;       # CertSetCertificateContextProperty
var _tm_free = 0;       # CertFreeCertificateContext
var _tm_props = 0;      # the row's properties: [id][ptr][len], up to 8
var _tm_n = 0;
var _tm_pem = 0;        # the fixture root as the PEM block the library must write
var _tm_pem_len = 0;
var _tm_pu = 0;         # the purpose _tm_run exports for (TlsChainPurpose; SERVER unless a row says)
var _tm_cert = 0;       # the certificate the row puts in ROOT (DER) — the fixture root unless a row says
var _tm_cert_len = 0;
var _tm_out = 0;        # the last export's bundle and byte count (the end-to-end rows parse it)
var _tm_out_len = 0;
var _tm_nkeys = 0;      # the row's trust-policy deny keys (16 B each) and deny certs ([ptr][len]) —
var _tm_keys = 0;       # what the disallowed CTL and the Disallowed store hand the export (6.7.12)
var _tm_ncerts = 0;
var _tm_certs = 0;
var _tm_bound = 0;      # the issuance bound the last export recorded for the row's certificate (got 3)

var _TM_SA = "300a06082b06010505070301";                            # [serverAuth]
var _TM_CS = "300a06082b06010505070303";                            # [codeSigning]
var _TM_CS_SA = "301406082b0601050507030306082b06010505070301";     # [codeSigning, serverAuth]
var _TM_ANY = "30060604551d2500";                                   # [anyExtendedKeyUsage]
var _TM_CA = "300a06082b06010505070302";                            # [clientAuth]
var _TM_SA_CA = "301406082b0601050507030106082b06010505070302";     # [serverAuth, clientAuth]
var _TM_DATE = "0080e9e6f9c7d901";                                  # a FILETIME
var _TM_DATE_UNIX = 1691280412;     # its issuance bound: 1691280411.8986752 s after the epoch, rounded UP
var _TM_DATE_EXACT = "00006dc64717da01";                            # a FILETIME on a whole second,
var _TM_DATE_EXACT_UNIX = 1700000000;                               # 1700000000 exactly

fn _tm_reset(): i64 {
    _tm_n = 0;
    _tm_nkeys = 0;
    _tm_ncerts = 0;
    return 0;
}

# Give the row's certificate property `id` = the bytes of `hex` ("" = present and EMPTY).
fn _tm_with(id, hex): i64 {
    var hl = strlen(hex);
    var p = alloc(8);
    if (hl > 0) { p = hex_decode(hex, hl); }
    store64(_tm_props + _tm_n * 24, id);
    store64(_tm_props + _tm_n * 24 + 8, p);
    store64(_tm_props + _tm_n * 24 + 16, hl / 2);
    _tm_n = _tm_n + 1;
    return 0;
}

# Give the row's certificate property `id` = p[0..n).
fn _tm_with_bytes(id, p, n): i64 {
    store64(_tm_props + _tm_n * 24, id);
    store64(_tm_props + _tm_n * 24 + 8, p);
    store64(_tm_props + _tm_n * 24 + 16, n);
    _tm_n = _tm_n + 1;
    return 0;
}

# A 694-byte purpose list — longer than any on cass (104 B) and than the 512-byte buffer the policy
# once read into: 69 OIDs, codeSigning throughout, the last one serverAuth when `sa` is 1.
fn _tm_long(sa): i64 {
    var p = alloc(694);
    store8(p, 0x30);
    store8(p + 1, 0x82);
    store8(p + 2, 0x02);
    store8(p + 3, 0xB2);                # 690 = 69 * 10
    var cs = hex_decode("06082b06010505070303", 20);
    var i = 0;
    while (i < 69) {
        memcpy(p + 4 + i * 10, cs, 10);
        i = i + 1;
    }
    if (sa == 1) { store8(p + 693, 0x01); }
    return p;
}

# ROOT (memory) holds the fixture root with the properties given since _tm_reset; Disallowed
# (memory) holds nothing (dis 0), the fixture too (1), or a different certificate (2); the trust
# policy holds the row's deny keys and certs (_tm_nkeys / _tm_ncerts). Run _tn_w_export into a
# `cap`-byte buffer and classify the result: 1 exported (exactly the fixture's PEM, nothing refused,
# no bound), 3 exported WITH an issuance bound (6.7.12: one bound, for exactly this certificate, its
# value in _tm_bound), 0 excluded (nothing written, nothing counted), 2 refused (nothing written,
# counted once), -1 anything else, -9 the stores could not be built as the row says.
fn _tm_run(fns, dis_holds, cap): i64 {
    var open = load64(fns);
    var root = callptr(open, 2, 0, 0, 0, 0);            # CERT_STORE_PROV_MEMORY
    var dis = callptr(open, 2, 0, 0, 0, 0);
    if (root == 0) { return 0 - 9; }
    if (dis == 0) { return 0 - 9; }
    var ok = 1;
    var cc[8];
    store64(&cc, 0);
    # X509_ASN_ENCODING, CERT_STORE_ADD_ALWAYS, and the store's context back.
    if ((callptr(_tm_add, root, 1, _tm_cert, _tm_cert_len, 4, &cc) & 0xFFFFFFFF) == 0) { ok = 0; }
    if (load64(&cc) == 0) { ok = 0; }
    var i = 0;
    while (i < _tm_n) {
        var blob[16];                                    # CRYPT_DATA_BLOB { DWORD cbData; BYTE *pbData }
        store64(&blob, load64(_tm_props + i * 24 + 16));
        store64(&blob + 8, load64(_tm_props + i * 24 + 8));
        if (ok == 1) {
            if ((callptr(_tm_setp, load64(&cc), load64(_tm_props + i * 24), 0, &blob) & 0xFFFFFFFF) == 0) { ok = 0; }
        }
        i = i + 1;
    }
    if (dis_holds == 1) {
        if ((callptr(_tm_add, dis, 1, _tm_cert, _tm_cert_len, 4, 0) & 0xFFFFFFFF) == 0) { ok = 0; }
    }
    if (dis_holds == 2) {
        if ((callptr(_tm_add, dis, 1, _ts_mr, _ts_mr_len, 4, 0) & 0xFFFFFFFF) == 0) { ok = 0; }
    }
    if (load64(&cc) != 0) { callptr(_tm_free, load64(&cc)); }
    var got = 0 - 9;
    if (ok == 1) {
        var buf = alloc(cap);
        var nref[8];
        store64(&nref, 0 - 1);
        var pol = _tn_pol_new(_tm_nkeys, _tm_keys, _tm_ncerts, _tm_certs, 0, 0);
        var total = _tn_w_export(fns, root, dis, buf, cap, &nref, _tm_pu, pol);
        var r = load64(&nref);
        var nb = load64(pol + 32);
        _tm_out = buf;
        _tm_out_len = total;
        _tm_bound = 0;
        got = 0 - 1;
        if (total == 0) {
            if (nb == 0) {
                if (r == 0) { got = 0; }
                if (r == 1) { got = 2; }
            }
        }
        if (total == _tm_pem_len) {
            if (r == 0) {
                if (memeq(buf, _tm_pem, _tm_pem_len) == 1) {
                    if (nb == 0) { got = 1; }
                    if (nb == 1) {
                        var e = load64(pol + 40);
                        if (load64(e + 8) == _tm_cert_len) {
                            if (memeq(load64(e), _tm_cert, _tm_cert_len) == 1) {
                                got = 3;
                                _tm_bound = load64(e + 16);
                            }
                        }
                    }
                }
            }
        }
    }
    callptr(load64(fns + 16), dis, 0);
    callptr(load64(fns + 16), root, 0);
    _tm_reset();
    return got;
}

# Windows: each policy rule, one memory store per row.
fn test_policy_rows(): i64 {
    test_group("Windows: the store policy, row by row, on stores built in memory");
    var fns[32];
    assert_eq(_tn_w_crypt32(&fns), 1, "crypt32 loads and resolves");
    var k = syscall(0xF013, "crypt32.dll");
    _tm_add = syscall(0xF014, k, "CertAddEncodedCertificateToStore");
    _tm_setp = syscall(0xF014, k, "CertSetCertificateContextProperty");
    _tm_free = syscall(0xF014, k, "CertFreeCertificateContext");
    assert_neq(_tm_add, 0, "CertAddEncodedCertificateToStore resolves");
    assert_neq(_tm_setp, 0, "CertSetCertificateContextProperty resolves");
    assert_neq(_tm_free, 0, "CertFreeCertificateContext resolves");
    _tm_props = alloc(8 * 24);
    _tm_cert = _ts_p256;
    _tm_cert_len = _ts_p256_len;
    _tm_pu = _TN_PURPOSE_SERVER;
    _tm_pem = alloc(2048);
    _tm_pem_len = _ts_pem(_tm_pem, _ts_p256, _ts_p256_len);
    var cap = 4096;
    # Control and Disallowed.
    assert_eq(_tm_run(&fns, 0, cap), 1, "no property: exported");
    assert_eq(_tm_run(&fns, 1, cap), 0, "also in Disallowed: excluded, not counted");
    assert_eq(_tm_run(&fns, 2, cap), 1, "a DIFFERENT certificate in Disallowed: still exported");
    # 6.7.12: the trust policy's deny list (the disallowed CTL's keys, the Disallowed store's
    # certificates) keeps a root out the way the Disallowed store does.
    _tm_keys = alloc(32);
    _tm_certs = alloc(32);
    _tm_nkeys = 1;
    _tn_spki_md5(_ts_p256, _ts_p256_len, _tm_keys);
    assert_eq(_tm_run(&fns, 0, cap), 0, "its key in the CTL's list: excluded, not counted");
    _tm_nkeys = 1;
    _tn_spki_md5(_ts_mr, _ts_mr_len, _tm_keys);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a DIFFERENT key in the CTL's list: exported");
    _tm_ncerts = 1;
    store64(_tm_certs, _ts_p256);
    store64(_tm_certs + 8, _ts_p256_len);
    assert_eq(_tm_run(&fns, 0, cap), 0, "it, byte for byte, in the policy's deny certs: excluded");
    _tm_nkeys = 1;
    _tn_spki_md5(_ts_p256, _ts_p256_len, _tm_keys);
    _tm_with(84, "3000");
    assert_eq(_tm_run(&fns, 0, cap), 0, "refused by name constraints AND its key listed: excluded, not counted");
    _tm_nkeys = 1;
    _tn_spki_md5(_ts_p256, _ts_p256_len, _tm_keys);
    _tm_with(126, _TM_DATE);
    assert_eq(_tm_run(&fns, 0, cap), 0, "a NotBefore root whose key is listed: excluded, no bound");
    # The purposes allow-list (prop 9).
    _tm_with(9, _TM_CS);
    assert_eq(_tm_run(&fns, 0, cap), 0, "purposes [codeSigning]: not a TLS root, not counted");
    _tm_with(9, _TM_CS_SA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "purposes [codeSigning, serverAuth]: exported");
    _tm_with(9, _TM_ANY);
    assert_eq(_tm_run(&fns, 0, cap), 1, "purposes [anyExtendedKeyUsage]: exported");
    _tm_with(9, "3000");
    assert_eq(_tm_run(&fns, 0, cap), 0, "purposes [] (no purpose at all): not a TLS root");
    _tm_with(9, _TM_CS);
    _tm_with(104, _TM_DATE);
    assert_eq(_tm_run(&fns, 0, cap), 0, "not a TLS root AND a disable date: excluded, not counted");
    # A malformed purpose list cannot be judged: refused and counted, never taken.
    _tm_with(9, "3100");
    assert_eq(_tm_run(&fns, 0, cap), 2, "purposes with the wrong tag: refused, counted");
    _tm_with(9, "3005060300");
    assert_eq(_tm_run(&fns, 0, cap), 2, "purposes truncated: refused");
    _tm_with(9, "300a06082b0601050507030100");
    assert_eq(_tm_run(&fns, 0, cap), 2, "purposes [serverAuth] plus a trailing byte: refused");
    _tm_with(9, "3002060030");
    assert_eq(_tm_run(&fns, 0, cap), 2, "purposes with an empty OID: refused");
    _tm_with(9, "3003068101");
    assert_eq(_tm_run(&fns, 0, cap), 2, "purposes with a long-form OID length: refused");
    _tm_with(9, "");
    assert_eq(_tm_run(&fns, 0, cap), 2, "purposes present but EMPTY: refused");
    # A purpose list of any length is read whole (size-queried), or refused and counted.
    _tm_with_bytes(9, _tm_long(1), 694);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a 694-byte purpose list ending in serverAuth: read whole, exported");
    _tm_with_bytes(9, _tm_long(0), 694);
    assert_eq(_tm_run(&fns, 0, cap), 0, "a 694-byte purpose list without serverAuth: not a TLS root");
    _tm_with_bytes(9, _tm_long(1), 694);
    assert_eq(_tm_run(&fns, 0, 650), 2, "a purpose list too long for the buffer's free tail: refused, COUNTED");
    # Root-program name constraints (prop 84): the verifier cannot confine a root to names, so refused.
    _tm_with(84, "3000");
    assert_eq(_tm_run(&fns, 0, cap), 2, "root-program name constraints: refused, counted");
    _tm_with(84, "");
    assert_eq(_tm_run(&fns, 0, cap), 2, "an EMPTY name-constraints property: refused");
    _tm_with(9, _TM_CS);
    _tm_with(84, "3000");
    assert_eq(_tm_run(&fns, 0, cap), 0, "name constraints on a root that is not for TLS: excluded, not counted");
    # The disable date (prop 104), scoped by prop 122.
    _tm_with(104, _TM_DATE);
    assert_eq(_tm_run(&fns, 0, cap), 2, "a disable date for every purpose: refused, counted");
    _tm_with(104, "");
    assert_eq(_tm_run(&fns, 0, cap), 2, "an EMPTY disable date (VeriSign Class 3 G5 has one): refused");
    _tm_with(104, _TM_DATE);
    _tm_with(122, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 2, "a disable date for [serverAuth]: refused");
    _tm_with(104, _TM_DATE);
    _tm_with(122, _TM_ANY);
    assert_eq(_tm_run(&fns, 0, cap), 2, "a disable date for [anyExtendedKeyUsage]: refused");
    _tm_with(104, _TM_DATE);
    _tm_with(122, _TM_CS);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a disable date for [codeSigning] only: exported");
    _tm_with(104, _TM_DATE);
    _tm_with(122, "3100");
    assert_eq(_tm_run(&fns, 0, cap), 2, "a disable date with a MALFORMED scope: refused (fails closed)");
    _tm_with(104, _TM_DATE);
    _tm_with(122, "300a06082b06010505070303ff");
    assert_eq(_tm_run(&fns, 0, cap), 2, "a disable date for [codeSigning] plus a trailing byte: refused");
    _tm_with(122, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a purpose scope with no date carries no distrust: exported");
    _tm_with(104, _TM_DATE);
    assert_eq(_tm_run(&fns, 1, cap), 0, "refused by date AND in Disallowed: excluded, not counted");
    # The NotBefore date (prop 126: certificates issued after it are not trusted), scoped by 127.
    # 6.7.12 (D9): a NotBefore date covering the purpose no longer refuses the root — it is exported WITH
    # an issuance bound (3), so the leaves it issued before the date verify, as on SChannel. Until 6.7.11
    # each `3` below was a `2`: refused whole, counted.
    _tm_with(126, _TM_DATE);
    assert_eq(_tm_run(&fns, 0, cap), 3, "a NotBefore date for every purpose: exported WITH a bound");
    assert_eq(_tm_bound, _TM_DATE_UNIX, "  the bound is the date in Unix seconds, rounded up");
    _tm_with(126, _TM_DATE_EXACT);
    assert_eq(_tm_run(&fns, 0, cap), 3, "a NotBefore date on a whole second: exported with a bound");
    assert_eq(_tm_bound, _TM_DATE_EXACT_UNIX, "  the bound is that second exactly");
    _tm_with(126, "");
    assert_eq(_tm_run(&fns, 0, cap), 2, "an EMPTY NotBefore date: refused (cannot be judged)");
    _tm_with(126, "0080e9e6");
    assert_eq(_tm_run(&fns, 0, cap), 2, "a 4-byte NotBefore date (not a FILETIME): refused");
    _tm_with(126, "0080e9e6f9c7d90100");
    assert_eq(_tm_run(&fns, 0, cap), 2, "a 9-byte NotBefore date: refused");
    _tm_with(126, "00000000000000ff");
    assert_eq(_tm_run(&fns, 0, cap), 2, "a NotBefore FILETIME with its top bit set: refused");
    _tm_with(126, _TM_DATE);
    _tm_with(127, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 3, "a NotBefore date for [serverAuth]: exported with a bound");
    _tm_with(126, _TM_DATE);
    _tm_with(127, _TM_CS_SA);
    assert_eq(_tm_run(&fns, 0, cap), 3, "a NotBefore date for [codeSigning, serverAuth] (Entrust's shape): bounded");
    _tm_with(126, _TM_DATE);
    _tm_with(127, _TM_ANY);
    assert_eq(_tm_run(&fns, 0, cap), 3, "a NotBefore date for [anyExtendedKeyUsage]: bounded");
    _tm_with(126, _TM_DATE);
    _tm_with(127, _TM_CS);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a NotBefore date for [codeSigning] only (DigiCert G2's shape): no bound");
    _tm_with(126, _TM_DATE);
    _tm_with(127, "3005060300");
    assert_eq(_tm_run(&fns, 0, cap), 2, "a NotBefore date with a MALFORMED scope: refused (fails closed)");
    _tm_with(126, _TM_DATE);
    _tm_with(127, "");
    assert_eq(_tm_run(&fns, 0, cap), 2, "a NotBefore date with an EMPTY scope value: refused");
    _tm_with(126, _TM_DATE);
    _tm_with_bytes(127, _tm_long(0), 694);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a NotBefore date for a 694-byte [codeSigning ...] scope: read whole, exported");
    _tm_with(126, _TM_DATE);
    _tm_with_bytes(127, _tm_long(1), 694);
    assert_eq(_tm_run(&fns, 0, cap), 3, "a NotBefore date for a 694-byte scope ending in serverAuth: bounded");
    _tm_with(127, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a NotBefore scope with no date carries no distrust: exported");
    _tm_with(104, _TM_DATE);
    _tm_with(122, _TM_CS);
    _tm_with(126, _TM_DATE);
    assert_eq(_tm_run(&fns, 0, cap), 3, "a Disable date for [codeSigning] but NotBefore for all: bounded");
    _tm_with(104, _TM_DATE);
    _tm_with(126, _TM_DATE);
    assert_eq(_tm_run(&fns, 0, cap), 2, "a Disable date for all AND a NotBefore date: refused (Disable wins)");
    _tm_with(126, _TM_DATE);
    assert_eq(_tm_run(&fns, 1, cap), 0, "a NotBefore date AND in Disallowed: excluded, no bound");
    _tm_with(126, _TM_DATE);
    assert_eq(_tm_run(&fns, 0, 300), 2, "a bounded root that does not fit the buffer: refused, counted");
    # A block that does not fit the buffer is refused and counted, never silently dropped.
    assert_eq(_tm_run(&fns, 0, 300), 2, "a root that does not fit the buffer: refused, counted");
    return 0;
}

# ── CYRIUS-2026-0027: the same policy for the CLIENT purpose (a server ctx's set) ─────────────────────
# Before 6.6.17 the store had one export, for serverAuth, and a server ctx installed it: a root
# whose store purposes are [serverAuth] anchored a CLIENT chain. Each row runs _tn_w_export for the
# client purpose; the server-purpose twin of the defect row is the control.
fn test_policy_rows_client(): i64 {
    test_group("Windows: the store policy for CLIENT authentication (a server ctx's set), row by row");
    var fns[32];
    assert_eq(_tn_w_crypt32(&fns), 1, "crypt32 loads and resolves");
    var cap = 4096;
    _tm_pu = _TN_PURPOSE_CLIENT;
    assert_eq(_tm_run(&fns, 0, cap), 1, "no property: exported");
    _tm_with(9, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 0, "purposes [serverAuth]: NOT a client root, not counted (6.6.16: exported)");
    _tm_with(9, _TM_CA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "purposes [clientAuth]: exported");
    _tm_with(9, _TM_SA_CA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "purposes [serverAuth, clientAuth]: exported");
    _tm_with(9, _TM_CS_SA);
    assert_eq(_tm_run(&fns, 0, cap), 0, "purposes [codeSigning, serverAuth]: not a client root");
    _tm_with(9, _TM_ANY);
    assert_eq(_tm_run(&fns, 0, cap), 1, "purposes [anyExtendedKeyUsage]: exported");
    _tm_with(9, "3000");
    assert_eq(_tm_run(&fns, 0, cap), 0, "purposes []: not a client root");
    _tm_with(9, "3100");
    assert_eq(_tm_run(&fns, 0, cap), 2, "purposes with the wrong tag: refused, counted");
    _tm_with(84, "3000");
    assert_eq(_tm_run(&fns, 0, cap), 2, "root-program name constraints: refused, counted");
    assert_eq(_tm_run(&fns, 1, cap), 0, "in Disallowed: excluded, not counted");
    # A dated distrust is scoped by ITS purpose list, read for the client purpose.
    _tm_with(104, _TM_DATE);
    assert_eq(_tm_run(&fns, 0, cap), 2, "a disable date for every purpose: refused");
    _tm_with(104, _TM_DATE);
    _tm_with(122, _TM_CA);
    assert_eq(_tm_run(&fns, 0, cap), 2, "a disable date for [clientAuth]: refused");
    _tm_with(104, _TM_DATE);
    _tm_with(122, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a disable date for [serverAuth] only: exported for client authentication");
    _tm_with(126, _TM_DATE);
    _tm_with(127, _TM_CA);
    assert_eq(_tm_run(&fns, 0, cap), 3, "a NotBefore date for [clientAuth]: exported with a bound (6.7.12)");
    _tm_with(126, _TM_DATE);
    _tm_with(127, _TM_CS_SA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "a NotBefore date for [codeSigning, serverAuth]: no bound for client authentication");
    _tm_with_bytes(9, _tm_long(1), 694);
    assert_eq(_tm_run(&fns, 0, cap), 0, "a 694-byte purpose list ending in serverAuth: not a client root");
    # The mirror, for the server purpose: a [clientAuth] root is not a TLS server anchor.
    _tm_pu = _TN_PURPOSE_SERVER;
    _tm_with(9, _TM_CA);
    assert_eq(_tm_run(&fns, 0, cap), 0, "server purpose, purposes [clientAuth]: not a server root");
    _tm_with(9, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "server purpose, purposes [serverAuth]: exported (control)");
    return 0;
}

# The exported bundle, installed on a ctx of `role`, verifying leaf_r for `pu`: the verdict.
fn _tm_verify(role, leaf, pu): i64 {
    var ctx = _tn_ctx_new(role);
    if (_tm_out_len <= 0) { return 0 - 99; }
    if (tls_native_set_ca_bundle(ctx, _tm_out, _tm_out_len, 0) != TLS_OK) { return 0 - 98; }
    return _tn_verify_chain(ctx, leaf, 0, _TM_NOW, pu);
}

var _TM_NOW = 1893456000;   # 2030-01-01: inside the eku fixtures' 2025 .. 2049 window

# End to end: a client identity issued by a root whose STORE purposes are [serverAuth] does not
# verify on a server ctx built from the export; one whose purposes include clientAuth does. The root
# (CN=eku-root) and leaf (CN=localhost, serverAuth + clientAuth) are tls_native_ca_eku.tcyr's
# root_none and leaf_r — the root carries NO extendedKeyUsage of its own, so the store property is
# the only purpose in play.
fn test_policy_client_chain(): i64 {
    test_group("Windows: a client chain anchored at a [serverAuth]-only store root is refused (CYRIUS-2026-0027)");
    var fns[32];
    assert_eq(_tn_w_crypt32(&fns), 1, "crypt32 loads and resolves");
    var root = _ts_eku_root;
    var leaf = _ts_cert(_ts_eku_leaf, 432);
    assert_neq(leaf, 0, "the client leaf parses");
    _tm_cert = root;
    _tm_cert_len = 348;
    _tm_pem_len = _ts_pem(_tm_pem, root, 348);
    var cap = 4096;
    # Store purposes [serverAuth]: the server-purpose export anchors a SERVER chain (control) ...
    _tm_pu = _TN_PURPOSE_SERVER;
    _tm_with(9, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "[serverAuth] root: in the server-purpose export");
    assert_eq(_tm_verify(TLS_ROLE_CLIENT, leaf, _TN_PURPOSE_SERVER), TLS_OK,
      "  control: a client ctx on that export verifies the leaf as a TLS server");
    # ... and the client-purpose export, which a server ctx installs, does not hold it.
    _tm_pu = _TN_PURPOSE_CLIENT;
    _tm_with(9, _TM_SA);
    assert_eq(_tm_run(&fns, 0, cap), 0, "[serverAuth] root: NOT in the client-purpose export");
    _tm_out_len = 0;
    # The chain against what 6.6.16 installed on a server ctx (the server-purpose export):
    _tm_pu = _TN_PURPOSE_SERVER;
    _tm_with(9, _TM_SA);
    _tm_run(&fns, 0, cap);
    var old_way = _tm_verify(TLS_ROLE_SERVER, leaf, _TN_PURPOSE_CLIENT);
    assert_eq(old_way, TLS_OK, "  (the 6.6.16 shape: the serverAuth set on a server ctx verified this client — the defect)");
    # Store purposes [clientAuth]: the client-purpose export holds it, and the client chain verifies.
    _tm_pu = _TN_PURPOSE_CLIENT;
    _tm_with(9, _TM_CA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "[clientAuth] root: in the client-purpose export");
    assert_eq(_tm_verify(TLS_ROLE_SERVER, leaf, _TN_PURPOSE_CLIENT), TLS_OK,
      "  a server ctx on that export verifies the leaf as a TLS client");
    _tm_with(9, _TM_SA_CA);
    assert_eq(_tm_run(&fns, 0, cap), 1, "[serverAuth, clientAuth] root: in the client-purpose export");
    assert_eq(_tm_verify(TLS_ROLE_SERVER, leaf, _TN_PURPOSE_CLIENT), TLS_OK, "  and the client chain verifies");
    _tm_cert = _ts_p256;
    _tm_cert_len = _ts_p256_len;
    _tm_pem_len = _ts_pem(_tm_pem, _ts_p256, _ts_p256_len);
    return 0;
}

# Windows, OPT-IN and administrator only (CYRIUS_TLS_TEST_PROTECTED_ROOTS=1): the ProtectedRoots policy
# (HKLM\SOFTWARE\Policies\Microsoft\SystemCertificates\Root\ProtectedRoots, Flags) reaches the export
# because crypt32 applies it when the loader opens CurrentUser\ROOT (6.7.12; the issue's item 1). It
# sets Flags = 8 for one fresh export and removes the key at once — machine policy, seen by every
# process for that moment, hence opt-in. Flags = 1 (no user roots) cannot be shown on a host where none
# can be planted: from a session with no desktop, `certutil -user -addstore Root` is refused
# ERROR_NOT_SUPPORTED (as SYSTEM too) and a root written into the registry is purged at the next open;
# 8 (ONLY_LM_GPT / DISABLE_LM_AUTH: no AuthRoot) takes the same path and shrinks the set measurably.
fn test_protected_roots(): i64 {
    test_group("Windows: the ProtectedRoots policy reaches the export through crypt32's open (opt-in)");
    if (getenv("CYRIUS_TLS_TEST_PROTECTED_ROOTS") == 0) {
        syscall(1, 1, "  not run: set CYRIUS_TLS_TEST_PROTECTED_ROOTS=1, as an administrator (it sets machine policy briefly)\n", 103);
        return 0;
    }
    var k = syscall(0xF013, "kernel32.dll");
    var ll = syscall(0xF014, k, "LoadLibraryExA");
    var adv = callptr(ll, "advapi32.dll", 0, 0x800);
    var ropen = syscall(0xF014, adv, "RegOpenKeyExW");
    var rclose = syscall(0xF014, adv, "RegCloseKey");
    var rset = syscall(0xF014, adv, "RegSetKeyValueW");
    var rdel = syscall(0xF014, adv, "RegDeleteKeyW");
    var parent = alloc(256);
    var sub = alloc(256);
    var val = alloc(32);
    _tn_w_widen("SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\Root", parent, 256);
    _tn_w_widen("SOFTWARE\\Policies\\Microsoft\\SystemCertificates\\Root\\ProtectedRoots", sub, 256);
    _tn_w_widen("Flags", val, 32);
    var h[8];
    store64(&h, 0);
    var pe = callptr(ropen, _TN_W_HKLM, parent, 0, 0x20019, &h) & 0xFFFFFFFF;
    if (pe == 0) { callptr(rclose, load64(&h)); }
    assert_eq(pe, 0, "the parent policy key exists (nothing but the leaf is ever created)");
    var ex = callptr(ropen, _TN_W_HKLM, sub, 0, 0x20019, &h) & 0xFFFFFFFF;
    if (ex == 0) { callptr(rclose, load64(&h)); }
    assert_eq(ex, 2, "the ProtectedRoots key is absent (an administrator's own is never touched)");
    if (pe != 0) { return 0; }
    if (ex != 2) { return 0; }
    var cap = 1048576;
    var buf = alloc(cap);
    var nref[8];
    var pol[8];
    var b0 = _ts_blocks(buf, _tn_ca_read_win(buf, cap, &nref, &pol, _TN_PURPOSE_SERVER));
    var v[8];
    store64(&v, 8);
    var b1 = 0 - 1;
    var sr = callptr(rset, _TN_W_HKLM, sub, val, 4, &v, 4) & 0xFFFFFFFF;    # REG_DWORD
    if (sr == 0) {
        b1 = _ts_blocks(buf, _tn_ca_read_win(buf, cap, &nref, &pol, _TN_PURPOSE_SERVER));
        assert_eq(callptr(rdel, _TN_W_HKLM, sub) & 0xFFFFFFFF, 0, "the ProtectedRoots key is removed again");
    }
    assert_eq(sr, 0, "Flags = 8 set (an administrator)");
    var b2 = _ts_blocks(buf, _tn_ca_read_win(buf, cap, &nref, &pol, _TN_PURPOSE_SERVER));
    syscall(1, 1, "  exported roots: ", 18);
    fmt_int(b0);
    syscall(1, 1, " -> under Flags = 8: ", 21);
    fmt_int(b1);
    syscall(1, 1, " -> key removed: ", 17);
    fmt_int(b2);
    syscall(1, 1, "\n", 1);
    assert_gt(b0, 0, "the export holds roots");
    assert_lt(b1, b0, "under the policy it holds fewer: crypt32 applied it at the loader's open");
    assert_eq(b2, b0, "with the key removed it is whole again");
    return 0;
}
#endif

# Every target: a system load that found no usable bundle because the store refused every root
# (Windows: _tn_ca_read_win returns -1 with refusals counted) still reports those refusals through
# tls_native_ca_skipped. The published once-state is injected and restored, so this runs last.
fn test_all_refused_counted(): i64 {
    test_group("a system store whose every root was refused: TLS_ERR_IO, and the refusals are counted");
    var s0 = _tn_ca_state;
    var l0 = _tn_ca_len;
    var set0 = _tn_ca_sys_set;
    var k0 = _tn_ca_sys_skipped;
    _tn_ca_state = 2;
    _tn_ca_len = 0 - 1;
    _tn_ca_sys_set = 0;
    _tn_ca_sys_skipped = 7;
    var ctx = tls_native_new_client("localhost", 9);
    assert_eq(tls_native_set_ca_system(ctx), TLS_ERR_IO, "no usable bundle: TLS_ERR_IO");
    assert_eq(tls_native_ca_skipped(ctx), 7, "the 7 refused roots are reported, not 0");
    _tn_ca_state = s0;
    _tn_ca_len = l0;
    _tn_ca_sys_set = set0;
    _tn_ca_sys_skipped = k0;
    return 0;
}

fn main(): i64 {
    alloc_init();
    _ts_eku_root = hex_decode("", 696);
    _ts_eku_leaf = hex_decode("", 864);
    _ts_dn = hex_decode("", 2844);
    _ts_p256 = hex_decode("", 770);
    _ts_ms = hex_decode("", 4956);
    _ts_mi = hex_decode("", 3960);
    _ts_mr = hex_decode("", 2842);
    #ifdef CYRIUS_TARGET_WIN
    test_planted_bundle_ignored();
    #endif
    test_system_roots();
    test_real_chain();
    test_policy_deny_rows();
    test_ctl_identifier_row();
    test_policy_bound_rows();
    #ifdef CYRIUS_TARGET_WIN
    test_store_policy();
    test_policy_rows();
    test_policy_rows_client();
    test_policy_client_chain();
    test_protected_roots();
    #endif
    test_all_refused_counted();
    return assert_summary();
}
var ec = main();
syscall(60, ec);
