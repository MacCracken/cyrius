# typed_pointer_step.tcyr — 6.6.17 — `p + n` / `p - n` / `p += n` / `p -= n` on a `*T` step
# sizeof(T) elements, at EVERY site: a local, a parameter, a closure-captured local (one level and
# two), a global declared in the leading declaration block or after the first statement, a
# `name: *T` field and a `fn f(): *T` result. (`*u8` 1, `*i16` 2, `*i32` / `*u32` / `*f32` 4, `*i64`
# 8, `*Pt` sizeof(Pt) = 24, `**T` 8.)
#
# Before 6.6.17 (measured on the 6.6.17-open compiler) the step depended on the SITE: a local
# `*i8`/`*i16`/`*i32` stepped 1 and every other local 8 (`*u8` 8, `*Pt` 8); a parameter 1 whatever T;
# a captured `*T` 1; a declaration-block global 8; a later global 1/2/4/8 by T; and `p += n` 1
# everywhere. Two parameter cells were not a step at all: `p + 1` on a `*f32` parameter was a FLOAT
# add of the pointer's bits, and on a `*Pt` parameter it dispatched `Pt_add`. No source in the
# ecosystem declared a `*T` (drafts b7-measure), so the user's decision was one rule, no refusal.
# Every row is the BYTE distance `d(p + n, p)`, computed outside the pointer expression.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"
include "lib/simd.cyr"

struct Pt { x; y; z; }
struct Hold { p: *Pt; b: *u8; }
var buf[512];

fn d(a, b): i64 { return a - b; }

fn locals(): i64 {
    var a: *u8 = &buf;
    var b: *i16 = &buf;
    var c: *i32 = &buf;
    var e: *i64 = &buf;
    var f: *f32 = &buf;
    var g: *u32 = &buf;
    var h: *Pt = &buf;
    var k: **Pt = &buf;
    assert_eq(d(a + 1, a), 1, "local *u8 + 1");
    assert_eq(d(b + 3, b), 6, "local *i16 + 3");
    assert_eq(d(c + 2, c), 8, "local *i32 + 2");
    assert_eq(d(e + 1, e), 8, "local *i64 + 1");
    assert_eq(d(f + 1, f), 4, "local *f32 + 1");
    assert_eq(d(g + 1, g), 4, "local *u32 + 1");
    assert_eq(d(h + 2, h), 48, "local *Pt + 2");
    assert_eq(d(k + 1, k), 8, "local **Pt + 1");
    assert_eq(d(h + 3 - 1, h), 48, "local *Pt + 3 - 1");
    var q: *Pt = h + 1;
    assert_eq(d(q, h), 24, "var q: *Pt = h + 1");
    return 0;
}

fn params(a: *u8, c: *i32, f: *f32, h: *Pt): i64 {
    assert_eq(d(a + 5, a), 5, "param *u8 + 5");
    assert_eq(d(c + 1, c), 4, "param *i32 + 1");
    assert_eq(d(f + 2, f), 8, "param *f32 + 2 (a pointer, not a float add)");
    assert_eq(d(h + 1, h), 24, "param *Pt + 1 (pointer arithmetic, no Pt_add)");
    h.y = 77;
    assert_eq(load64(&buf + 8), 77, "param *Pt: h.y still writes through the pointer");
    var c2: *i32 = c;
    assert_eq(d(c2 + 1, c2), 4, "a *i32 param copied into a *i32 local");
    return 0;
}

fn compound(c: *i32): i64 {
    var c0 = c;
    c += 3;
    assert_eq(d(c, c0), 12, "param *i32 += 3");
    c -= 1;
    assert_eq(d(c, c0), 8, "param *i32 -= 1");
    var h: *Pt = &buf;
    var h0 = h;
    h += 1;
    assert_eq(d(h, h0), 24, "local *Pt += 1");
    var a: *u8 = &buf;
    var a0 = a;
    a += 7;
    assert_eq(d(a, a0), 7, "local *u8 += 7");
    var n = 10;
    n += 3;
    assert_eq(n, 13, "an untyped local += 3 is unchanged");
    return 0;
}

fn captures(): i64 {
    var h: *Pt = &buf;
    var c: *i16 = &buf;
    var f1 = || d(h + 1, h);
    var f2 = |n| d(c + n, c);
    assert_eq(callptr(f1), 24, "captured *Pt + 1");
    assert_eq(callptr(f2, 3), 6, "captured *i16 + 3");
    var f3 = |x| { var k = |y| d(h + y, h); return callptr(k, x); };
    assert_eq(callptr(f3, 2), 48, "a capture of a capture, *Pt + 2");
    return 0;
}

fn cap_param(p: *i32): i64 {
    var f = || d(p + 1, p);
    return callptr(f);
}

var D_u8: *u8 = 0;
var D_pt: *Pt = 0;
var D_i32: *i32 = 0;
fn decl_globals(): i64 {
    D_u8 = &buf; D_pt = &buf; D_i32 = &buf;
    assert_eq(d(D_u8 + 1, D_u8), 1, "declaration-block global *u8 + 1");
    assert_eq(d(D_pt + 1, D_pt), 24, "declaration-block global *Pt + 1");
    assert_eq(d(D_i32 + 2, D_i32), 8, "declaration-block global *i32 + 2");
    var g0 = D_i32;
    D_i32 += 1;
    assert_eq(d(D_i32, g0), 4, "declaration-block global *i32 += 1");
    return 0;
}

fn fields_and_returns(): i64 {
    var hd: Hold;
    hd.p = &buf; hd.b = &buf;
    assert_eq(d(hd.p + 1, hd.p), 24, "a *Pt field + 1");
    assert_eq(d(hd.b + 1, hd.b), 1, "a *u8 field + 1");
    return 0;
}
fn ret_pt(): *Pt { return &buf; }

# ── a call's result is a plain value unless the callee declares `: *T` ─────────────────────
# Before 6.6.17 it carried its LAST ARGUMENT's scale: `f(p) + 1` with `p: *i64` added 8.
struct Q2 { a; }
fn f_int(x): i64 { return 100; }
fn Q2_m(self, x): i64 { return 100; }
fn g_int<T>(x: T, y): i64 { return 100; }
fn call_results(): i64 {
    var p: *i64 = &buf;
    var q: Q2;
    q.a = 0;
    var cl = |x| x;
    store64(&buf, 0);
    assert_eq(f_int(p) + 1, 101, "f(p) + 1, p: *i64");
    assert_eq(load64(p) + 1, 1, "load64(p) + 1");
    assert_eq(fncall1(&f_int, p) + 1, 101, "fncall1(&f, p) + 1");
    assert_eq(callptr(cl, p) - p + 1, 1, "callptr(cl, p) - p + 1");
    assert_eq(q.m(p) + 1, 101, "q.m(p) + 1");
    assert_eq(g_int<i32>(1, p) + 1, 101, "g<i32>(1, p) + 1");
    assert_eq(d(ret_pt() + 1, ret_pt()), 24, "a declared `: *Pt` return still steps 24");
    return 0;
}

# ── a pointer to a generic instance steps the instance's size (it stepped the base's) ──────────
struct Box2<T> { v: T; w: T; }
fn box_param(p: *Box2<i16>): i64 { return d(p + 1, p); }
fn generic_pointee(): i64 {
    var bp: *Box2<i32> = &buf;
    assert_eq(d(bp + 1, bp), 8, "*Box2<i32> steps sizeof(Box2<i32>)");
    assert_eq(sizeof(Box2<i32>), 8, "sizeof(Box2<i32>)");
    assert_eq(box_param(&buf), 4, "a *Box2<i16> param steps 4");
    return 0;
}

# ── pointer difference and `n + p` (C rules) ────────────────────────────────────────────────
# Before 6.6.17 `q - p` scaled the right pointer by the left one's step (`*i16`: -4090 where 3 is
# right) and `n + p` stepped 1.
fn differences(p: *i16): i64 {
    var q: *i16 = p + 3;
    assert_eq(q - p, 3, "*i16 q - p is an element count");
    var a: *Pt = &buf;
    var b: *Pt = a + 2;
    assert_eq(b - a, 2, "*Pt b - a");
    assert_eq(a - b, 0 - 2, "*Pt a - b is negative");
    assert_eq((b - a) + 1, 3, "an element count is a plain value");
    var c: *i64 = &buf;
    assert_eq(d(2 + c, c), 16, "2 + c steps like c + 2");
    assert_eq(2 + c - c, 2, "2 + c - c");
    var e = &buf + 16;
    assert_eq(e - &buf, 16, "plain addresses: a byte difference, as before");
    var n = 3;
    assert_eq(d(c - n, c), 0 - 24, "c - n still steps n elements");
    return 0;
}

# ── the inline replay steps a `*T` parameter too (6.6.20) ───────────────────────────────────
# `#inline` fns, one-statement generics and SIMD-parameter fns are re-parsed into the CALLER, and
# that replay re-registered a parameter by name with only its vector / float type: a `*T`
# parameter lost its pointer step, so `p + n` stepped 1 (`*f32`: a FLOAT add of the pointer's
# bits, truncating it) while the same fn out of line stepped sizeof(T). Such fns are not replayed
# now. And the parameter scan went by PARAMETER, not slot, so `fn sv_pt(v: f64v2, s: Pt)` was
# replayed and the compiler crashed on the call. Each row is a value the out-of-line fn gives.
#inline
fn in_add(p: *i32): i64 { return d(p + 1, p); }
#inline
fn in_ret(p: *i32): *i32 { return p + 2; }
#inline
fn in_diff(q: *i32, p: *i32): i64 { return q - p; }
#inline
fn in_asg(p: *i32): *i32 { p += 3; return p; }
#inline
fn in_f32(p: *f32): i64 { return d(p + 1, p); }
fn gs_ret<T>(p: *T): *T { return p + 2; }
fn gs_diff<T>(q: *T, p: *T): i64 { return q - p; }
fn sv_ptr(v: f64v2, p: *i32): *i32 { return p + 2; }
fn sv_pt(v: f64v2, s: Pt): i64 { return s.y; }
fn inline_replay(): i64 {
    var b = &buf;
    assert_eq(in_add(b), 4, "#inline *i32: p + 1");
    assert_eq(d(in_ret(b), b), 8, "#inline *i32: returns p + 2");
    assert_eq(in_diff(b + 16, b), 4, "#inline *i32: q - p is an element count");
    assert_eq(d(in_asg(b), b), 12, "#inline *i32: p += 3");
    assert_eq(in_f32(b), 4, "#inline *f32: p + 1 is a pointer step, not a float add");
    assert_eq(d(gs_ret<i32>(b), b), 8, "one-statement generic gs_ret<i32>: p + 2");
    assert_eq(d(gs_ret<i16>(b), b), 4, "gs_ret<i16>: p + 2");
    assert_eq(d(gs_ret<i64>(b), b), 16, "gs_ret<i64>: p + 2");
    assert_eq(d(gs_ret<f64>(b), b), 16, "gs_ret<f64>: p + 2, not an f64 add");
    assert_eq(d(gs_ret<i8>(b), b), 2, "gs_ret<i8>: p + 2");
    assert_eq(d(gs_ret<Pt>(b), b), 48, "gs_ret<Pt>: p + 2");
    assert_eq(gs_diff<i32>(b + 16, b), 4, "gs_diff<i32>: q - p");
    var v: f64v2;
    assert_eq(d(sv_ptr(v, b), b), 8, "a SIMD-param fn: a trailing *i32 param + 2");
    var s: Pt;
    s.x = 5; s.y = 9; s.z = 1;
    assert_eq(sv_pt(v, s), 9, "a SIMD param then a struct param (compiled, and reads s.y)");
    return 0;
}

# ── a GENERIC fn's `: *T` result steps the instance's T (6.6.20) ─────────────────────────────
# Every instance stepped 8, the i64 base's: the instance's return type was read with T unbound,
# and the call's scale was taken from the template. `store32(gr<i32>(x) + i, v)` wrote at 8*i.
# (An inferred SCALAR argument binds the i64 base, so `gr(a)` with `a: i32` steps 8 by rule.)
fn gr<T>(x: T): *T { var z = 0; return &buf; }
fn g0<T>(): *T { var z = 0; return &buf; }
fn gr_nested<T>(x: T): i64 { var q = gr<T>(x) + 1; return q - &buf; }
fn generic_returns(): i64 {
    var b = &buf;
    var pt: Pt;
    pt.x = 0; pt.y = 0; pt.z = 0;
    assert_eq(d(gr<i8>(1) + 3, b), 3, "gr<i8>(1) + 3");
    assert_eq(d(gr<i16>(1) + 1, b), 2, "gr<i16>(1) + 1");
    assert_eq(d(gr<i32>(1) + 1, b), 4, "gr<i32>(1) + 1");
    assert_eq(d(gr<i64>(1) + 1, b), 8, "gr<i64>(1) + 1");
    assert_eq(d(gr<Pt>(pt) + 1, b), 24, "gr<Pt>(pt) + 1");
    assert_eq(d(gr(pt) + 1, b), 24, "gr(pt) + 1, T inferred as Pt");
    assert_eq(d(g0<i32>() + 1, b), 4, "g0<i32>() + 1, no arguments");
    assert_eq(d(g0<Pt>() + 2, b), 48, "g0<Pt>() + 2");
    assert_eq(d(2 + gr<i32>(1), b), 8, "2 + gr<i32>(1)");
    assert_eq(d(gr<i32>(1) - 1, b), 0 - 4, "gr<i32>(1) - 1");
    assert_eq(d((gr<i16>(1)) + 3, b), 6, "(gr<i16>(1)) + 3");
    assert_eq(gr_nested<i32>(1), 4, "gr<T>(x) + 1 inside a generic instance, T = i32");
    assert_eq(gr_nested<i16>(1), 2, "gr<T>(x) + 1 inside a generic instance, T = i16");
    var q: *i32 = gr<i32>(1);
    assert_eq(d(q + 1, b), 4, "var q: *i32 = gr<i32>(1); q + 1 (control)");
    return 0;
}

# ── a pointer's step dies with the operator that consumed it (6.7.9) ───────────────────────────
# The pointer-scale word is the LAST factor's, and only `+` / `-` wrote their result's back, so after
# any other operator whose last operand was `q: *T` the next `+ n` / `- n` stepped sizeof(T): with
# `q: *i32`, `(x == q) + 100` was 401, `(m & q) + 1` 4, `(-q) + 1` -q + 4 and `mk(q).n + 1` 4
# (6.6.17 - 6.7.8, every target, silent). An operator that produces a plain integer leaves no step
# (the user's decision 1(a), 2026-10-11): each row is such an integer `+ n` / `- n`, measured
# against the same expression on `qq`, the untyped copy of q. The `ctl` rows are pointer arithmetic,
# unchanged. issues/2026-10-10-pointer-step-leaks-through-operators.md
struct Hn { n; m; }
struct Vo { x; }
fn Vo_add(a, b): i64 { return 10; }
fn Vo_mul(a, b): i64 { return 20; }
var HNB[2];
fn hn_mk(q): Hn { var h: Hn; h.n = 0; h.m = 0; return h; }
fn hn_mp(q): *Hn { return &HNB; }
fn op_rows_i16(): i64 {
    var q: *i16 = &buf;
    var qq: i64 = q;
    var x = 0; var base = 1; var m = 0; var z = 0; var k = 1;
    store64(&HNB, 0); store64(&HNB + 8, 0);
    assert_eq((qq == q) + 100, 101, "*i16: (qq == q) + 100");
    assert_eq((qq != q) - 1, 0 - 1, "*i16: (qq != q) - 1");
    assert_eq((qq < q) + 1, 1, "*i16: (qq < q) + 1");
    assert_eq((qq >= q) - 1, 0, "*i16: (qq >= q) - 1");
    assert_eq((base && q) + 1, 2, "*i16: (base && q) + 1");
    assert_eq((z || q) - 1, 0, "*i16: (z || q) - 1");
    assert_eq((k * q) + 1, qq + 1, "*i16: (k * q) + 1");
    assert_eq((qq / q) - 1, 0, "*i16: (qq / q) - 1");
    assert_eq((qq % q) + 1, 1, "*i16: (qq % q) + 1");
    assert_eq((z << q) + 1, 1, "*i16: (z << q) + 1");
    assert_eq((z >>> q) - 1, 0 - 1, "*i16: (z >>> q) - 1");
    assert_eq((m & q) + 1, 1, "*i16: (m & q) + 1");
    assert_eq((z | q) - 1, qq - 1, "*i16: (z | q) - 1");
    assert_eq((z ^ q) + 1, qq + 1, "*i16: (z ^ q) + 1");
    assert_eq((~q) + 1, (~qq) + 1, "*i16: (~q) + 1");
    assert_eq((-q) - 1, (0 - qq) - 1, "*i16: (-q) - 1");
    assert_eq(-q + 1, (0 - qq) + 1, "*i16: -q + 1");
    assert_eq(hn_mk(q).n + 1, 1, "*i16: mk(q).n + 1 (a by-value struct result's field)");
    assert_eq(hn_mk(q).m - 1, 0 - 1, "*i16: mk(q).m - 1");
    assert_eq(hn_mp(q).n + 1, 1, "*i16: mp(q).n + 1 (a *H result's field)");
    assert_eq(k * q + 1, qq + 1, "*i16: k * q + 1");
    assert_eq(q & qq + 1, qq + 1, "*i16: q & qq + 1 (the left operand's step)");
    assert_eq(q ^ qq - 1, 0 - 1, "*i16: q ^ qq - 1");
    assert_eq(z + (qq == q) + 1, 2, "*i16: z + (qq == q) + 1");
    assert_eq(z + (k * q) - 1, qq - 1, "*i16: z + (k * q) - 1");
    var v: Vo;
    v.x = 0;
    assert_eq((v + q) + 1, 11, "*i16: (v + q) + 1 (an operator fn's result)");
    assert_eq((v * q) - 1, 19, "*i16: (v * q) - 1");
    assert_eq(d((q) + 1, q), 2, "*i16 ctl: (q) + 1 steps");
    assert_eq(d((q + 1) + 1, q), 2 * 2, "*i16 ctl: (q + 1) + 1");
    assert_eq(d(2 + q, q), 2 * 2, "*i16 ctl: 2 + q");
    assert_eq(d(q + (qq == q), q), 2, "*i16 ctl: q + (qq == q) steps one element");
    var q3: *i16 = q + 3;
    assert_eq((q3 - q) + 1, 4, "*i16 ctl: (q3 - q) + 1, an element count");
    store64(&buf, 0x0807060504030201); store64(&buf + 8, 0x100F0E0D0C0B0A09);
    assert_eq(*(q + 1), q[1], "*i16 ctl: *(q + 1) reads the element q[1] reads");
    return 0;
}
fn op_rows_i32(): i64 {
    var q: *i32 = &buf;
    var qq: i64 = q;
    var x = 0; var base = 1; var m = 0; var z = 0; var k = 1;
    store64(&HNB, 0); store64(&HNB + 8, 0);
    assert_eq((qq == q) + 100, 101, "*i32: (qq == q) + 100");
    assert_eq((qq != q) - 1, 0 - 1, "*i32: (qq != q) - 1");
    assert_eq((qq < q) + 1, 1, "*i32: (qq < q) + 1");
    assert_eq((qq >= q) - 1, 0, "*i32: (qq >= q) - 1");
    assert_eq((base && q) + 1, 2, "*i32: (base && q) + 1");
    assert_eq((z || q) - 1, 0, "*i32: (z || q) - 1");
    assert_eq((k * q) + 1, qq + 1, "*i32: (k * q) + 1");
    assert_eq((qq / q) - 1, 0, "*i32: (qq / q) - 1");
    assert_eq((qq % q) + 1, 1, "*i32: (qq % q) + 1");
    assert_eq((z << q) + 1, 1, "*i32: (z << q) + 1");
    assert_eq((z >>> q) - 1, 0 - 1, "*i32: (z >>> q) - 1");
    assert_eq((m & q) + 1, 1, "*i32: (m & q) + 1");
    assert_eq((z | q) - 1, qq - 1, "*i32: (z | q) - 1");
    assert_eq((z ^ q) + 1, qq + 1, "*i32: (z ^ q) + 1");
    assert_eq((~q) + 1, (~qq) + 1, "*i32: (~q) + 1");
    assert_eq((-q) - 1, (0 - qq) - 1, "*i32: (-q) - 1");
    assert_eq(-q + 1, (0 - qq) + 1, "*i32: -q + 1");
    assert_eq(hn_mk(q).n + 1, 1, "*i32: mk(q).n + 1 (a by-value struct result's field)");
    assert_eq(hn_mk(q).m - 1, 0 - 1, "*i32: mk(q).m - 1");
    assert_eq(hn_mp(q).n + 1, 1, "*i32: mp(q).n + 1 (a *H result's field)");
    assert_eq(k * q + 1, qq + 1, "*i32: k * q + 1");
    assert_eq(q & qq + 1, qq + 1, "*i32: q & qq + 1 (the left operand's step)");
    assert_eq(q ^ qq - 1, 0 - 1, "*i32: q ^ qq - 1");
    assert_eq(z + (qq == q) + 1, 2, "*i32: z + (qq == q) + 1");
    assert_eq(z + (k * q) - 1, qq - 1, "*i32: z + (k * q) - 1");
    var v: Vo;
    v.x = 0;
    assert_eq((v + q) + 1, 11, "*i32: (v + q) + 1 (an operator fn's result)");
    assert_eq((v * q) - 1, 19, "*i32: (v * q) - 1");
    assert_eq(d((q) + 1, q), 4, "*i32 ctl: (q) + 1 steps");
    assert_eq(d((q + 1) + 1, q), 2 * 4, "*i32 ctl: (q + 1) + 1");
    assert_eq(d(2 + q, q), 2 * 4, "*i32 ctl: 2 + q");
    assert_eq(d(q + (qq == q), q), 4, "*i32 ctl: q + (qq == q) steps one element");
    var q3: *i32 = q + 3;
    assert_eq((q3 - q) + 1, 4, "*i32 ctl: (q3 - q) + 1, an element count");
    store64(&buf, 0x0807060504030201); store64(&buf + 8, 0x100F0E0D0C0B0A09);
    assert_eq(*(q + 1), q[1], "*i32 ctl: *(q + 1) reads the element q[1] reads");
    return 0;
}
fn op_rows_i64(): i64 {
    var q: *i64 = &buf;
    var qq: i64 = q;
    var x = 0; var base = 1; var m = 0; var z = 0; var k = 1;
    store64(&HNB, 0); store64(&HNB + 8, 0);
    assert_eq((qq == q) + 100, 101, "*i64: (qq == q) + 100");
    assert_eq((qq != q) - 1, 0 - 1, "*i64: (qq != q) - 1");
    assert_eq((qq < q) + 1, 1, "*i64: (qq < q) + 1");
    assert_eq((qq >= q) - 1, 0, "*i64: (qq >= q) - 1");
    assert_eq((base && q) + 1, 2, "*i64: (base && q) + 1");
    assert_eq((z || q) - 1, 0, "*i64: (z || q) - 1");
    assert_eq((k * q) + 1, qq + 1, "*i64: (k * q) + 1");
    assert_eq((qq / q) - 1, 0, "*i64: (qq / q) - 1");
    assert_eq((qq % q) + 1, 1, "*i64: (qq % q) + 1");
    assert_eq((z << q) + 1, 1, "*i64: (z << q) + 1");
    assert_eq((z >>> q) - 1, 0 - 1, "*i64: (z >>> q) - 1");
    assert_eq((m & q) + 1, 1, "*i64: (m & q) + 1");
    assert_eq((z | q) - 1, qq - 1, "*i64: (z | q) - 1");
    assert_eq((z ^ q) + 1, qq + 1, "*i64: (z ^ q) + 1");
    assert_eq((~q) + 1, (~qq) + 1, "*i64: (~q) + 1");
    assert_eq((-q) - 1, (0 - qq) - 1, "*i64: (-q) - 1");
    assert_eq(-q + 1, (0 - qq) + 1, "*i64: -q + 1");
    assert_eq(hn_mk(q).n + 1, 1, "*i64: mk(q).n + 1 (a by-value struct result's field)");
    assert_eq(hn_mk(q).m - 1, 0 - 1, "*i64: mk(q).m - 1");
    assert_eq(hn_mp(q).n + 1, 1, "*i64: mp(q).n + 1 (a *H result's field)");
    assert_eq(k * q + 1, qq + 1, "*i64: k * q + 1");
    assert_eq(q & qq + 1, qq + 1, "*i64: q & qq + 1 (the left operand's step)");
    assert_eq(q ^ qq - 1, 0 - 1, "*i64: q ^ qq - 1");
    assert_eq(z + (qq == q) + 1, 2, "*i64: z + (qq == q) + 1");
    assert_eq(z + (k * q) - 1, qq - 1, "*i64: z + (k * q) - 1");
    var v: Vo;
    v.x = 0;
    assert_eq((v + q) + 1, 11, "*i64: (v + q) + 1 (an operator fn's result)");
    assert_eq((v * q) - 1, 19, "*i64: (v * q) - 1");
    assert_eq(d((q) + 1, q), 8, "*i64 ctl: (q) + 1 steps");
    assert_eq(d((q + 1) + 1, q), 2 * 8, "*i64 ctl: (q + 1) + 1");
    assert_eq(d(2 + q, q), 2 * 8, "*i64 ctl: 2 + q");
    assert_eq(d(q + (qq == q), q), 8, "*i64 ctl: q + (qq == q) steps one element");
    var q3: *i64 = q + 3;
    assert_eq((q3 - q) + 1, 4, "*i64 ctl: (q3 - q) + 1, an element count");
    store64(&buf, 0x0807060504030201); store64(&buf + 8, 0x100F0E0D0C0B0A09);
    assert_eq(*(q + 1), q[1], "*i64 ctl: *(q + 1) reads the element q[1] reads");
    return 0;
}
fn op_rows_Pt(): i64 {
    var q: *Pt = &buf;
    var qq: i64 = q;
    var x = 0; var base = 1; var m = 0; var z = 0; var k = 1;
    store64(&HNB, 0); store64(&HNB + 8, 0);
    assert_eq((qq == q) + 100, 101, "*Pt: (qq == q) + 100");
    assert_eq((qq != q) - 1, 0 - 1, "*Pt: (qq != q) - 1");
    assert_eq((qq < q) + 1, 1, "*Pt: (qq < q) + 1");
    assert_eq((qq >= q) - 1, 0, "*Pt: (qq >= q) - 1");
    assert_eq((base && q) + 1, 2, "*Pt: (base && q) + 1");
    assert_eq((z || q) - 1, 0, "*Pt: (z || q) - 1");
    assert_eq((k * q) + 1, qq + 1, "*Pt: (k * q) + 1");
    assert_eq((qq / q) - 1, 0, "*Pt: (qq / q) - 1");
    assert_eq((qq % q) + 1, 1, "*Pt: (qq % q) + 1");
    assert_eq((z << q) + 1, 1, "*Pt: (z << q) + 1");
    assert_eq((z >>> q) - 1, 0 - 1, "*Pt: (z >>> q) - 1");
    assert_eq((m & q) + 1, 1, "*Pt: (m & q) + 1");
    assert_eq((z | q) - 1, qq - 1, "*Pt: (z | q) - 1");
    assert_eq((z ^ q) + 1, qq + 1, "*Pt: (z ^ q) + 1");
    assert_eq((~q) + 1, (~qq) + 1, "*Pt: (~q) + 1");
    assert_eq((-q) - 1, (0 - qq) - 1, "*Pt: (-q) - 1");
    assert_eq(-q + 1, (0 - qq) + 1, "*Pt: -q + 1");
    assert_eq(hn_mk(q).n + 1, 1, "*Pt: mk(q).n + 1 (a by-value struct result's field)");
    assert_eq(hn_mk(q).m - 1, 0 - 1, "*Pt: mk(q).m - 1");
    assert_eq(hn_mp(q).n + 1, 1, "*Pt: mp(q).n + 1 (a *H result's field)");
    assert_eq(k * q + 1, qq + 1, "*Pt: k * q + 1");
    assert_eq(q & qq + 1, qq + 1, "*Pt: q & qq + 1 (the left operand's step)");
    assert_eq(q ^ qq - 1, 0 - 1, "*Pt: q ^ qq - 1");
    assert_eq(z + (qq == q) + 1, 2, "*Pt: z + (qq == q) + 1");
    assert_eq(z + (k * q) - 1, qq - 1, "*Pt: z + (k * q) - 1");
    var v: Vo;
    v.x = 0;
    assert_eq((v + q) + 1, 11, "*Pt: (v + q) + 1 (an operator fn's result)");
    assert_eq((v * q) - 1, 19, "*Pt: (v * q) - 1");
    assert_eq(d((q) + 1, q), 24, "*Pt ctl: (q) + 1 steps");
    assert_eq(d((q + 1) + 1, q), 2 * 24, "*Pt ctl: (q + 1) + 1");
    assert_eq(d(2 + q, q), 2 * 24, "*Pt ctl: 2 + q");
    assert_eq(d(q + (qq == q), q), 24, "*Pt ctl: q + (qq == q) steps one element");
    var q3: *Pt = q + 3;
    assert_eq((q3 - q) + 1, 4, "*Pt ctl: (q3 - q) + 1, an element count");
    return 0;
}

# `p?` reads the Result p points at (tag 0 = Ok, then the payload) and yields the payload — a plain
# value: `(p?) + 1` stepped sizeof(T) too. issues/2026-10-10-pointer-step-leaks-through-operators.md
var QMB[2];
fn qm_rows(): i64 {
    store64(&QMB, 0);
    store64(&QMB + 8, 5);
    var a: *i16 = &QMB;
    var b: *i32 = &QMB;
    var c: *i64 = &QMB;
    var e: *Pt = &QMB;
    assert_eq((a?) + 1, 6, "*i16: (p?) + 1, a Result's payload");
    assert_eq((b?) - 1, 4, "*i32: (p?) - 1");
    assert_eq(c? + 1, 6, "*i64: p? + 1");
    assert_eq((e?) + 1, 6, "*Pt: (p?) + 1");
    return 0;
}

# ── a builtin at the head of a term is a plain value (6.6.17's call rule, 6.7.9) ───────────────
# PARSE_TERM dispatches an intrinsic (bitget / bitset / bitclr, store8..64, f64_* ...) itself, past the
# factor wrapper that resets a call's step, so its result kept its LAST argument's: with `q: *i32`,
# `bitget(m, 0, q) + 1` added 4. As the right operand of `*` it was always right (the wrapper's).
fn intrin_rows(): i64 {
    var q: *i32 = &buf;
    var w: *Pt = &buf;
    var m = 0;
    assert_eq(bitget(m, 0, q) + 1, 1, "*i32: bitget(m, 0, q) + 1");
    assert_eq((bitget(m, 0, w)) - 1, 0 - 1, "*Pt: (bitget(m, 0, w)) - 1");
    assert_eq(bitclr(m, 0, q) + 1, 1, "*i32: bitclr(m, 0, q) + 1");
    assert_eq(m + bitget(m, 0, w) + 1, 1, "*Pt: m + bitget(m, 0, w) + 1");
    assert_eq(m * bitget(m, 0, q) + 1, 1, "*i32 ctl: m * bitget(m, 0, q) + 1 (the right of `*`)");
    return 0;
}

# ── `n + p` with a one-byte `*T` is that pointer, as `p + n` is (6.7.9) ───────────────────────────
# `n + p8` (`*u8` / `*i8`: a step of 1, nothing to scale) wrote back the INTEGER's word, 0, so it was
# no `*u8`: `var r: *u8 = 2 + p;` warned and `(1 + p8) - q32` built a byte difference (the gate's
# DXc rows hold the diagnostics). It now keeps p's word. A step of 1 scales nothing, so every value
# is the one it always was: these rows pin it on every leg — a difference of two such values (now an
# element count, `_ptr_diff`), a typed declaration from one, the chains, each one-byte source. A
# narrow SCALAR (`w: u8`, step 1 but no `*T`) stays an integer: `(1 + w) - q` is `n - p`.
fn ob_u8(): *u8 { return &buf; }
fn onebyte_rows(a: *u8): i64 {
    var p: *u8 = &buf;
    var s: *i8 = &buf;
    var h: Hold;
    h.b = &buf;
    D_u8 = &buf;
    assert_eq((1 + p) - p, 1, "*u8: (1 + p) - p is an element count");
    assert_eq((5 + p) - (2 + p), 3, "*u8: (5 + p) - (2 + p)");
    assert_eq((3 + s) - p, 3, "*i8 - *u8: one step, an element count");
    assert_eq(p - (4 + s), 0 - 4, "*u8: p - (4 + s)");
    var r: *u8 = 2 + p;
    assert_eq(d(r, p), 2, "*u8: var r: *u8 = 2 + p");
    assert_eq(d(r + 1, p), 3, "*u8: a *u8 declared from 2 + p, + 1");
    assert_eq(d((2 + p) + 3, p), 5, "*u8: (2 + p) + 3");
    assert_eq(d(1 + (2 + p), p), 3, "*u8: 1 + (2 + p)");
    assert_eq(d((6 + p) - 2, p), 4, "*u8: (6 + p) - 2");
    assert_eq((6 + a) - a, 6, "*u8 parameter: (n + a) - a");
    assert_eq((7 + h.b) - h.b, 7, "*u8 field: (n + h.b) - h.b");
    assert_eq((8 + D_u8) - D_u8, 8, "*u8 global: (n + G) - G");
    assert_eq((9 + ob_u8()) - p, 9, "*u8 call: (n + f()) - p");
    var c = 1;
    var q: *u8 = if (c > 0) { 1 + p } else { p };
    assert_eq(d(q, p), 1, "*u8: an if-expression of 1 + p and p");
    var w: u8 = 5;
    var b: *i32 = &buf;
    var bi: i64 = b;
    assert_eq((1 + w) - b + bi, 6, "a u8 scalar: (1 + w) - q is n - p, no difference");
    return 0;
}

alloc_init();
inline_replay();
generic_returns();
locals();
call_results();
differences(&buf);
generic_pointee();
params(&buf, &buf, &buf, &buf);
compound(&buf);
captures();
assert_eq(cap_param(&buf), 4, "a captured *i32 parameter + 1");
decl_globals();
fields_and_returns();
assert_eq(d(ret_pt() + 1, ret_pt()), 24, "a *Pt return + 1");
op_rows_i16();
op_rows_i32();
op_rows_i64();
op_rows_Pt();
qm_rows();
intrin_rows();
onebyte_rows(&buf);

var A_u8: *u8 = &buf;
var A_pt: *Pt = &buf;
fn after_globals(): i64 {
    assert_eq(d(A_u8 + 3, A_u8), 3, "later global *u8 + 3");
    assert_eq(d(A_pt + 1, A_pt), 24, "later global *Pt + 1");
    return 0;
}
after_globals();
var r = assert_summary();
