# u128_compare_all_bits.tcyr — 6.7.6 (Break 1, D3): a u128 COMPARISON compares all 128 bits (the user's
# decision, 2026-10-08, third round): `==` `!=` `<` `<=` `>` `>=`, UNSIGNED, a u128 against a u128 or an
# integer (zero-extended, lane D2's operand rule) on either side, in every context a comparison is
# parsed — an `if` / `while` / `for` condition, an `&&` / `||` operand, a value, an if-expression
# condition, a chained `a < b < c` — at fn and top level. The T rows (6.7.6, D4): a TRUTH TEST is a
# comparison with zero, so a bare condition, an `&&` / `||` operand, `!b` and a `match` / `switch`
# subject read all 128 bits too.
#
# ⛔ THE DEFECT. Every u128 comparison read the LOW words, signed: `b == c` was true for values 2^64
# apart, `b < c` false for 1 and 2^64, and a low word with its top bit set compared below 1. Each pair
# below is set with store64 (lo, hi) and every expected answer is written out by hand.
#
# ⚠ CROSS-HOST: the compare is the backend's (x86 cmp / sbb and xor / or, aarch64 subs / sbcs and eor /
# orr, cx a computed unsigned compare); the temporaries are frame slots or, at top level, dead globals.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

var M = 0xFFFFFFFFFFFFFFFF;   # 2^64 - 1, the all-ones word
var T = 0x8000000000000000;   # 2^63: a low word that a SIGNED compare puts below 1

fn set2(p, lo, hi): i64 { store64(p, lo); store64(p + 8, hi); return 0; }
# `x > zap(&x)` — the left operand is evaluated before the right, as an integer's is.
fn zap(p): i64 { set2(p, 0, 0); return 3; }
fn id(n): i64 { return n; }

var GA: u128 = 0;
var GB: u128 = 0;

fn tmain(): i64 {
    var b: u128 = 0;
    var c: u128 = 0;
    # The high words differ, the low words are equal (the filed shape).
    set2(&b, 5, 1);
    set2(&c, 5, 2);
    assert_eq(b == c, 0, "C1: `==` reads the high words (5 + 2^64 vs 5 + 2^65)");
    assert_eq(b != c, 1, "C2: `!=`");
    assert_eq(b < c, 1, "C3: `<`");
    assert_eq(b <= c, 1, "C4: `<=`");
    assert_eq(b > c, 0, "C5: `>`");
    assert_eq(b >= c, 0, "C6: `>=`");
    assert_eq(c > b, 1, "C7: `>` the other way");
    assert_eq(c >= b, 1, "C8: `>=` the other way");
    # The high words decide even when the low words say the opposite.
    set2(&b, M, 0);
    set2(&c, 0, 1);
    assert_eq(b < c, 1, "C9: 2^64 - 1 < 2^64 (the low words say >)");
    assert_eq(b > c, 0, "C10: ... and not >");
    # Equal high words: the low words decide, UNSIGNED.
    set2(&b, T, 3);
    set2(&c, 1, 3);
    assert_eq(b > c, 1, "C11: a low word of 2^63 is above 1 (unsigned)");
    assert_eq(b < c, 0, "C12: ... not below it");
    assert_eq(b <= c, 0, "C13: `<=` on the low words");
    assert_eq(b >= c, 1, "C14: `>=` on the low words");
    # Equal values.
    set2(&b, 9, M);
    set2(&c, 9, M);
    assert_eq(b == c, 1, "C15: equal values are `==`");
    assert_eq(b <= c, 1, "C16: ... `<=`");
    assert_eq(b >= c, 1, "C17: ... `>=`");
    assert_eq(b < c, 0, "C18: ... not `<`");
    assert_eq(b != c, 0, "C19: ... not `!=`");
    # An integer operand is zero-extended (D2's rule): M is 2^64 - 1, not -1.
    set2(&b, M, 0);
    assert_eq(b == M, 1, "C20: u128 2^64 - 1 == the integer 0xFFFF_FFFF_FFFF_FFFF");
    set2(&b, M, 1);
    assert_eq(b == M, 0, "C21: ... not when the high word is set");
    assert_eq(b > M, 1, "C22: 2^65 - 1 > 2^64 - 1 (an integer on the right)");
    assert_eq(M < b, 1, "C23: an integer on the LEFT is zero-extended too");
    assert_eq(7 == b, 0, "C24: `7 == b` reads b's high word");
    set2(&b, 7, 0);
    assert_eq(7 == b, 1, "C25: `7 == b` with b = 7");
    assert_eq(b == 7, 1, "C26: `b == 7` with b = 7");
    assert_eq(b < T, 1, "C27: 7 < 2^63 (the integer zero-extended, not negative)");
    # Computed u128 operands (a `+` / `-` result) on either side.
    set2(&b, M, 0);
    set2(&c, 0, 1);
    assert_eq(b + 1 == c, 1, "C28: `b + 1 == c` (the carried sum)");
    assert_eq(c == b + 1, 1, "C29: `c == b + 1` (a sum on the right)");
    assert_eq((b + 2) > c, 1, "C30: a parenthesised sum on the left");
    assert_eq(c - 1 < c, 1, "C31: a difference that borrows");
    # Contexts.
    var n = 0;
    set2(&b, 5, 1);
    set2(&c, 5, 2);
    if (b == c) { n = n + 1; }
    if (b != c) { n = n + 2; }
    if (b < c && c > b) { n = n + 4; }
    if (b == c || c < b) { n = n + 8; }
    if (b > c) { n = n + 16; } elif (b < c) { n = n + 32; }
    assert_eq(n, 38, "C32: `if` / `elif`, `&&` / `||` conditions");
    var r = if (b >= c) { 1 } else { 2 };
    assert_eq(r, 2, "C33: an if-expression condition");
    var x = b < c;
    assert_eq(x, 1, "C34: a comparison as a value");
    assert_eq(id(c > b), 1, "C35: a comparison as an argument");
    var k = 0;
    set2(&c, 0, 1);
    if (1 < 2 < c) { k = 1; }
    assert_eq(k, 1, "C36: a chained condition `(1 < 2) < c`, c 2^64 (its low word 0)");
    set2(&c, 1, 1);
    k = 0;
    if (2 > 1 == c) { k = 1; }
    assert_eq(k, 0, "C37: ... `(2 > 1) == c` reads c's high word (c 2^64 + 1)");
    set2(&b, 0, 2);
    set2(&c, 5, 1);
    k = 0;
    while (b < c && k < 9) { b = b + 1; k = k + 1; }
    assert_eq(k, 0, "C38: a `while` condition: 2^65 < 2^64 + 5 is false (the low words said 0 < 5)");
    set2(&b, M - 1, 0);
    set2(&c, 1, 1);
    k = 0;
    while (b < c && k < 9) { b = b + 1; k = k + 1; }
    assert_eq(k, 3, "C39: a `while` condition across 2^64");
    set2(&b, 7, 1);
    set2(&c, 2, 2);
    k = 0;
    for (n = 0; b <= c && n < 4; n = n + 1) { k = k + 1; }
    assert_eq(k, 4, "C40: a `for` condition: 2^64 + 7 <= 2^65 + 2 (the low words said 7 > 2)");
    # The left operand is evaluated first.
    set2(&b, 1, 1);
    assert_eq(b > zap(&b), 1, "C41: the left u128 is read before the right side runs");
    # Globals.
    set2(&GA, 4, 8);
    set2(&GB, 4, 9);
    assert_eq(GA < GB, 1, "C42: u128 globals");
    set2(&b, 4, 7);
    assert_eq(GA == b, 0, "C43: a global against a local (equal low words)");
    return 0;
}

# ── 6.7.6 (D4): a TRUTH TEST is a comparison with zero, so it reads all 128 bits too (the user's
# decision, 2026-10-08) — a bare condition, an `&&` / `||` operand, `!b`, and a `match` / `switch`
# subject (each case value zero-extended). Each read the LOW word: 2^64 was false to `if (b)`, `!b` was
# 1, and match / switch took the 0 arm. Every loop below is bounded whatever the test reads.
var GZ: u128 = 0;
# Sets *p to 0 (both words) and returns 0: a match arm that changes the subject after it was read.
fn zero2(p): i64 { set2(p, 0, 0); return 0; }
fn ttruth(): i64 {
    var b: u128 = 0;
    var c: u128 = 0;
    var z: u128 = 0;
    set2(&b, 0, 1);                       # 2^64: its low word is 0
    set2(&c, 1, 0);                       # 1: its high word is 0
    var n = 0;
    if (b) { n = n + 1; }
    if (c) { n = n + 2; }
    if (z) { n = n + 4; }
    assert_eq(n, 3, "T1: `if (b)` tests both words (2^64 true, 1 true, 0 false)");
    n = 0;
    if (z) { n = 1; } elif (b) { n = 2; } else { n = 3; }
    assert_eq(n, 2, "T2: `elif (b)` on 2^64");
    n = 0;
    if ((b)) { n = 1; }
    assert_eq(n, 1, "T3: a parenthesised `if ((b))`");
    n = 0;
    while (b) { n = n + 1; if (n == 3) { set2(&b, 0, 0); } if (n > 8) { break; } }
    assert_eq(n, 3, "T4: `while (b)` runs until both words are 0");
    set2(&b, 0, 1);
    n = 0;
    do { n = n + 1; if (n == 2) { set2(&b, 0, 0); } if (n > 8) { break; } } while (b);
    assert_eq(n, 2, "T5: `do .. while (b)`");
    set2(&b, 0, 1);
    n = 0;
    var k = 0;
    for (k = 0; b; k = k + 1) { n = n + 1; if (n == 4) { set2(&b, 0, 0); } if (n > 8) { break; } }
    assert_eq(n, 4, "T6: a `for` condition `b`");
    set2(&b, 0, 1);
    var r = if (b) { 7 } else { 9 };
    assert_eq(r, 7, "T7: an if-expression condition");
    r = if (z) { 7 } elif (b) { 8 } else { 9 };
    assert_eq(r, 8, "T8: an if-expression `elif` condition");
    # `&&` / `||` operands, as a condition and as a value, a u128 on either side.
    n = 0;
    if (b && 1) { n = n + 1; }
    if (1 && b) { n = n + 2; }
    if (z || b) { n = n + 4; }
    if (b || z) { n = n + 8; }
    if (b && c) { n = n + 16; }
    if (z && b) { n = n + 32; }
    if (z || z) { n = n + 64; }
    assert_eq(n, 31, "T9: `&&` / `||` conditions test each u128 operand on all 128 bits");
    assert_eq(b && 1, 1, "T10: `b && 1` as a value");
    assert_eq(1 && b, 1, "T11: `1 && b` as a value");
    assert_eq(b || 0, 1, "T12: `b || 0` as a value");
    assert_eq(0 || b, 1, "T13: `0 || b` as a value");
    assert_eq(z || z, 0, "T14: `z || z` (both 0) as a value");
    # `!` is `== 0` on all 128 bits.
    assert_eq(!b, 0, "T15: `!b` on 2^64 is 0");
    assert_eq(!c, 0, "T16: `!c` on 1 is 0");
    assert_eq(!z, 1, "T17: `!z` on 0 is 1");
    assert_eq(!(b - 1), 0, "T18: `!(b - 1)` (2^64 - 1, a computed u128) is 0");
    assert_eq(!(b - b), 1, "T19: `!(b - b)` (0) is 1");
    n = 0;
    if (!b) { n = 1; }
    if (!z) { n = n + 2; }
    assert_eq(n, 2, "T20: `if (!b)` / `if (!z)`");
    # `match` on a u128 subject: each arm value zero-extended, compared on all 128 bits.
    var m = 0;
    match b { 0 => { m = 1; } 1 => { m = 2; } _ => { m = 3; } }
    assert_eq(m, 3, "T21: `match b` on 2^64 takes neither the 0 nor the 1 arm");
    match c { 0 => { m = 1; } 1 => { m = 2; } _ => { m = 3; } }
    assert_eq(m, 2, "T22: `match c` on 1 takes the 1 arm");
    var d: u128 = 0;
    set2(&d, M, 0);
    match d { 0 - 1 => { m = 4; } _ => { m = 5; } }
    assert_eq(m, 4, "T23: an arm value -1 is zero-extended: 2^64 - 1 matches it");
    set2(&d, M, M);
    match d { 0 - 1 => { m = 4; } _ => { m = 5; } }
    assert_eq(m, 5, "T24: ... 2^128 - 1 does not");
    var e: u128 = 0;
    set2(&e, 0, 1);
    match b { e => { m = 6; } _ => { m = 7; } }
    assert_eq(m, 6, "T25: a u128 arm value compares as it is (2^64 == 2^64)");
    set2(&e, 0, 2);
    match b { e => { m = 6; } _ => { m = 7; } }
    assert_eq(m, 7, "T26: ... 2^64 != 2^65 (equal low words)");
    match b + 1 { 1 => { m = 8; } _ => { m = 9; } }
    assert_eq(m, 9, "T27: `match b + 1` (2^64 + 1) does not take the 1 arm");
    match b { zero2(&b) => { m = 10; } _ => { m = 11; } }
    assert_eq(m, 11, "T28: the subject is read once, before an arm changes it");
    set2(&b, 0, 1);
    # `switch` on a u128 subject: a chain, a dense table-sized one, no default, a negative case.
    var w = 0;
    switch (b) { case 0: w = 1; default: w = 2; }
    assert_eq(w, 2, "T29: `switch (b)` on 2^64 takes default, not case 0");
    set2(&d, 2, 1);
    switch (d) { case 0: w = 10; case 1: w = 11; case 2: w = 12; case 3: w = 13; default: w = 99; }
    assert_eq(w, 99, "T30: four dense cases (a jump table on x86) and 2^64 + 2: default");
    set2(&d, 2, 0);
    switch (d) { case 0: w = 10; case 1: w = 11; case 2: w = 12; case 3: w = 13; default: w = 99; }
    assert_eq(w, 12, "T31: ... and 2 takes case 2");
    w = 0;
    switch (b) { case 0: w = 1; case 1: w = 2; }
    assert_eq(w, 0, "T32: no default: 2^64 takes no case");
    set2(&d, M, 0);
    switch (d) { case 0 - 1: w = 5; default: w = 6; }
    assert_eq(w, 5, "T33: `case -1` is zero-extended: 2^64 - 1 takes it");
    switch (c) { case 1: w = 7; default: w = 8; }
    assert_eq(w, 7, "T34: `switch (c)` on 1 takes case 1");
    # A u128 global in a fn.
    set2(&GZ, 0, 3);
    n = 0;
    if (GZ) { n = 1; }
    assert_eq(n + !GZ, 1, "T35: a u128 global: `if (GZ)` true, `!GZ` 0");
    return 0;
}

var tr = tmain();
var tt = ttruth();
# At top level (the temporaries are dead globals).
set2(&GA, 2, 1);
set2(&GB, 3, 0);
assert_eq(GA > GB, 1, "C44: at top level, 2^64 + 2 > 3");
assert_eq(GA == 2, 0, "C45: ... and not == 2");
assert_eq(GA - GB == M, 1, "C46: ... `GA - GB == 2^64 - 1`");
var top = 0;
if (GB < GA) { top = 1; }
assert_eq(top, 1, "C47: a top-level `if` condition");
# Truth tests at top level (D4): the subject temporaries are dead globals there.
set2(&GZ, 0, 1);
top = 0;
if (GZ) { top = top + 1; }
if (!GZ) { top = top + 2; }
if (GZ && 1) { top = top + 4; }
assert_eq(top, 5, "T36: at top level, `if (GZ)`, `if (!GZ)`, `GZ && 1` on 2^64");
var tm = 0;
match GZ { 0 => { tm = 1; } _ => { tm = 2; } }
assert_eq(tm, 2, "T37: a top-level `match GZ` on 2^64");
switch (GZ) { case 0: tm = 3; default: tm = 4; }
assert_eq(tm, 4, "T38: a top-level `switch (GZ)` on 2^64");
var rr = assert_summary();
syscall(60, rr);
