# untyped_struct_name_copy.tcyr — 6.7.12 (D29) — an untyped `var q = p;` of a struct VALUE is a typed
# copy, as `var q: P = p;` is (the user's decision (a), 2026-10-15).
#
# Through 6.7.11 the untyped declaration took p's FIRST WORD: `q.y` was "no struct type in scope for
# 'q'" in a fn and "undefined variable 'q'" inside a closure that captured q (the filed repro,
# issues/archived/2026-10-11-closure-field-read-of-captured-slice-or-untyped-struct-copy-refused.md, half 2),
# `take(q)` into a by-value struct parameter passed the word as the struct's address (SIGSEGV), and
# `q + p` added integers. Now q takes p's type and its own bytes: field reads and writes are the
# copy's, a closure's snapshot carries the type, and an operator dispatches on it. The source is a
# name (or a wrap `(p)`) naming an inline struct local, a by-value struct parameter or a closure's
# captured copy of one. Unchanged, and asserted here: a `*T` source stays a plain word, an untyped
# impl `self` (a `*T`) too, an untyped GLOBAL keeps the word, and `return q;` from an i64 fn is the
# first word (an rvalue of an inline struct is its first word).
#
# 6.7.13 (the user's decision D6 (b), 2026-10-15) — D29 REACHES A STRUCT GLOBAL: `var q = G;` in a fn, G an
# inline struct global, is a copy of it, as `var q: P = G;` is (6.6.5) — at 3 / 8 / 16 / 24 B, wrapped, written
# without touching G, passed by value, an operator's operand, captured, inside a closure, in a loop. Through
# 6.7.12 q was G's first word: `q.y` "no struct type in scope for 'q'", `tk(q)` SIGSEGV
# (issues/2026-10-15-untyped-name-copy-of-struct-global-or-handle-keeps-word.md). A HANDLE keeps the word (a
# local, a global, a local named G that shadows the global), as a `*T` does; a local named G is a local copy.
#
# CROSS-HOST: the copy is the copy-init's per-chunk address + load / store (8/4/2/1 bytes) or, at 8 B
# or less, the one inline word, emitted by each backend; the closure rows read the captured words
# through the env base. Run on ecb / ach (Mach-O), cass (PE) and pi (aarch64) by the release gate.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fnptr.cyr"
include "lib/str.cyr"
include "lib/assert.cyr"

struct P { x; y; }
struct S8 { a: i32; b: i32; }
struct P3 { x; y; z; }
struct Odd { a: i8; b: i16; }
struct Box<T> { v: T; w: T; }

var GP: P = P { 3, 4 };
var GH = GP;   # an untyped global in the declaration zone keeps the word

# ── the filed repro 2, as a fn ──────────────────────────────────────────────────────────────────
fn repro(): i64 {
    var p: P = P { 3, 4 };
    var q = p;
    var c = |k| q.y + k;
    return fncall1(c, 1) + q.y * 10;
}

fn rd(): i64 { var p: P = P { 3, 4 }; var q = p; return q.y; }
fn wr(): i64 { var p: P = P { 3, 4 }; var q = p; q.y = 9; return p.y * 10 + q.y; }
fn wrx(): i64 { var p: P = P { 3, 4 }; var q = p; p.x = 7; return q.x * 10 + p.x; }
fn s8(): i64 { var p: S8 = S8 { 3, 4 }; var q = p; q.b = 9; return p.b * 10 + q.b; }
fn p24(): i64 { var p = P3 { 1, 2, 3 }; var q = p; q.z = 9; return p.z * 1000 + q.x * 100 + q.y * 10 + q.z; }
fn odd(): i64 { var p: Odd = Odd { 3, 4 }; var q = p; q.b = 9; return p.a * 100 + p.b * 10 + q.b; }
fn prm(p: P): i64 { var q = p; q.y = 9; return p.y * 10 + q.y; }
fn prmc(): i64 { var p: P = P { 3, 4 }; var r = prm(p); return r * 10 + p.y; }
fn prm8(p: S8): i64 { var q = p; q.b = 9; return p.b * 10 + q.b; }
fn prm8c(): i64 { var p: S8 = S8 { 3, 4 }; return prm8(p); }
fn nest(): i64 {
    var p: P = P { 3, 4 };
    var c = |k| { var q = p; var d = |j| q.y + j; return fncall1(d, k); };
    return fncall1(c, 1);
}
fn capprm(p: P): i64 {
    var c = |k| { var q = p; q.y = 9; return p.y * 10 + q.y + k; };
    return fncall1(c, 0);
}
fn capprmc(): i64 { var p: P = P { 3, 4 }; return capprm(p); }
fn cap8(): i64 {
    var p: S8 = S8 { 3, 4 };
    var c = |k| { var q = p; q.b = 9; return p.b * 10 + q.b + k; };
    return fncall1(c, 0);
}
fn twice(): i64 {
    var p: P = P { 3, 4 };
    var c = || { var q = p; q.y = q.y + 1; return q.y; };
    return fncall0(c) * 10 + fncall0(c);
}
fn capptr(pp: *P): i64 {
    var c = |k| { var q = pp; return (q == pp) * 10 + load64(q + 8) + k; };
    return fncall1(c, 0);
}
fn capptrc(): i64 { var p: P = P { 3, 4 }; return capptr(&p); }
fn ptr(): i64 { var p: P = P { 3, 4 }; var pp: *P = &p; var q = pp; return (q == &p) * 10 + load64(q + 8); }
fn wrap(): i64 { var p: P = P { 3, 4 }; var q = (p); q.x = 1; return p.x * 10 + q.y; }
fn tk(a: P): i64 { return a.y; }
fn arg(): i64 { var p: P = P { 3, 4 }; var q = p; return tk(q); }
fn word(): i64 { var p: P = P { 3, 4 }; var q = p; return q; }
fn chain(): i64 { var p: P = P { 3, 4 }; var q = p; var r = q; r.y = 7; return q.y * 10 + r.y; }
fn P_add(a: P, b: P): P { var r = P { a.x + b.x, a.y + b.y }; return r; }
fn opd(): i64 { var p: P = P { 3, 4 }; var q = p; var s = q + p; return s.x * 10 + s.y; }
fn gen(): i64 { var b: Box<i64> = Box<i64> { 3, 4 }; var q = b; q.w = 9; return b.w * 10 + q.w; }
impl P {
    fn sy(self): i64 { var q = self; return load64(q + 8); }
    fn vy(self: P): i64 { var q = self; q.y = 9; return self.y * 10 + q.y; }
}
fn selfp(): i64 { var p: P = P { 3, 4 }; return p.sy(); }
fn selfv(): i64 { var p: P = P { 3, 4 }; return p.vy(); }
fn loopc(): i64 {
    var p: P = P { 3, 4 };
    var t = 0;
    var i = 0;
    while (i < 3) { var q = p; q.y = q.y + i; t = t * 10 + q.y; i = i + 1; }
    return t;
}

# ── 6.7.13 (D6 (b)): a struct GLOBAL source ─────────────────────────────────────────────────────
var GO: Odd = Odd { 3, 4 };
var GS8: S8 = S8 { 3, 4 };
var G24: P3 = P3 { 1, 2, 3 };
var GHD: P = 0;   # a handle global (the handle line): its slot holds an address
fn g16rd(): i64 { var q = GP; return q.y; }
fn g16wr(): i64 { var q = GP; q.y = 9; return GP.y * 10 + q.y; }
fn g16wrx(): i64 { var q = GP; GP.x = 7; var r = q.x * 10 + GP.x; GP.x = 3; return r; }
fn g8(): i64 { var q = GS8; q.b = 9; return GS8.b * 10 + q.b; }
fn g3(): i64 { var q = GO; q.b = 9; return GO.a * 100 + GO.b * 10 + q.b; }
fn g24(): i64 { var q = G24; q.z = 9; return G24.z * 1000 + q.x * 100 + q.y * 10 + q.z; }
fn gwrap(): i64 { var q = (GP); q.x = 1; return GP.x * 10 + q.y; }
fn gwrap24(): i64 { var q = ((G24)); return q.x * 100 + q.y * 10 + q.z; }
fn gwrap8(): i64 { var q = (GS8); q.a = 1; return GS8.a * 10 + q.b; }
fn garg(): i64 { var q = GP; return tk(q); }
fn gop(): i64 { var q = GP; var s = q + GP; return s.x * 10 + s.y; }
fn gcap(): i64 { var q = GP; var c = |k| q.y + k; return fncall1(c, 1) + q.y * 10; }
fn gin(): i64 { var c = |k| { var q = GP; q.y = 9; return GP.y * 10 + q.y + k; }; return fncall1(c, 0); }
fn gnest(): i64 { var c = |k| { var q = G24; var d = |j| q.z + j; return fncall1(d, k); }; return fncall1(c, 1); }
fn gin8(): i64 { var c = || { var q = GS8; q.b = q.b + 1; return q.b; }; return fncall0(c) * 10 + fncall0(c); }
fn gshadow(): i64 { var GP: P = P { 7, 8 }; var q = GP; q.y = 9; return GP.y * 10 + q.y; }
fn gshadowh(): i64 { alloc_init(); var GP: P = alloc(16); GP.y = 4; var q = GP; return (q == GP) * 10 + load64(q + 8); }
fn ghandle(): i64 { alloc_init(); var h: P = alloc(16); h.y = 4; var q = h; return (q == h) * 10 + load64(q + 8); }
fn ghglob(): i64 { alloc_init(); GHD = alloc(16); GHD.y = 4; var q = GHD; return (q == GHD) * 10 + load64(q + 8); }
fn gloop(): i64 {
    var t = 0;
    var i = 0;
    while (i < 3) { var q = GP; q.y = q.y + i; t = t * 10 + q.y; i = i + 1; }
    return t;
}

assert_eq(repro(), 45, "filed repro 2: a closure reads q.y of an untyped copy");
assert_eq(GH, 3, "an untyped global (declaration zone) keeps the word");
var GH2 = GP;   # after the first statement: PARSE_VAR's global arm
assert_eq(GH2, 3, "an untyped global (after a statement) keeps the word");
assert_eq(rd(), 4, "q.y reads the copy outside a closure");
assert_eq(wr(), 49, "q.y = 9 writes the copy, p.y stays 4");
assert_eq(wrx(), 37, "a write to p after the copy leaves q.x at 3");
assert_eq(s8(), 49, "an 8 B S8 source: the copy is its own word");
assert_eq(p24(), 3129, "a 24 B source: copied, q.z = 9 leaves p.z at 3");
assert_eq(odd(), 349, "an odd 3 B source: copied byte-exact");
assert_eq(prmc(), 494, "a by-value parameter source; the caller's p.y stays 4");
assert_eq(prm8c(), 49, "an 8 B by-value parameter source");
assert_eq(nest(), 5, "a captured struct copied in a closure, read by a nested closure");
assert_eq(capprmc(), 49, "a captured by-value parameter copied in a closure");
assert_eq(cap8(), 49, "a captured 8 B struct copied in a closure");
assert_eq(twice(), 55, "a copy inside a closure is fresh on every call");
assert_eq(ptr(), 14, "a *T source stays a plain word (the address)");
assert_eq(capptrc(), 14, "a captured *T parameter copied in a closure stays a word");
assert_eq(wrap(), 34, "a wrapped (p) source is a copy");
assert_eq(arg(), 4, "the copy passes to a by-value struct parameter");
assert_eq(word(), 3, "return q from an i64 fn is the first word");
assert_eq(chain(), 47, "a copy of a copy is a copy");
assert_eq(opd(), 68, "q + p dispatches P_add on the copy");
assert_eq(gen(), 49, "a generic instance Box<i64> source");
assert_eq(selfp(), 4, "an untyped impl self (a *T) stays a word");
assert_eq(selfv(), 49, "a by-value self: P source is a copy");
assert_eq(loopc(), 456, "a copy declared in a loop body is fresh each iteration");

assert_eq(g16rd(), 4, "6.7.13 D6: var q = G (16 B global): q.y reads the copy");
assert_eq(g16wr(), 49, "6.7.13 D6: q.y = 9 writes the copy, G.y stays 4");
assert_eq(g16wrx(), 37, "6.7.13 D6: a write to G after the copy leaves q.x at 3");
assert_eq(g8(), 49, "6.7.13 D6: an 8 B global: the copy is its own word");
assert_eq(g3(), 349, "6.7.13 D6: an odd 3 B global: copied byte-exact");
assert_eq(g24(), 3129, "6.7.13 D6: a 24 B global: copied, q.z = 9 leaves G.z at 3");
assert_eq(gwrap(), 34, "6.7.13 D6: var q = (G) is a copy");
assert_eq(gwrap24(), 123, "6.7.13 D6: var q = ((G)) of 24 B is a copy");
assert_eq(gwrap8(), 34, "6.7.13 D6: var q = (G) of 8 B is a copy");
assert_eq(garg(), 4, "6.7.13 D6: the copy of G passes to a by-value struct parameter (was SIGSEGV)");
assert_eq(gop(), 68, "6.7.13 D6: q + G dispatches P_add on the copy");
assert_eq(gcap(), 45, "6.7.13 D6: a closure captures the copy of G with its type");
assert_eq(gin(), 49, "6.7.13 D6: var q = G inside a closure is a copy");
assert_eq(gnest(), 4, "6.7.13 D6: a 24 B copy of G in a closure, read by a nested closure");
assert_eq(gin8(), 55, "6.7.13 D6: an 8 B copy of G inside a closure is fresh on every call");
assert_eq(gshadow(), 89, "6.7.13 D6: a local named G shadows the global: a local copy");
assert_eq(gshadowh(), 14, "6.7.13 D6: a local HANDLE named G shadows the global: the word");
assert_eq(ghandle(), 14, "6.7.13 D6: var q = h (a handle local) keeps the word (the address)");
assert_eq(ghglob(), 14, "6.7.13 D6: var q = GH (a handle global) keeps the word (the address)");
assert_eq(gloop(), 456, "6.7.13 D6: a copy of G declared in a loop body is fresh each iteration");

var r = assert_summary();
