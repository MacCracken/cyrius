# user_struct_named_slice.tcyr — 6.7.11 — a program's own `struct slice` is that struct in a fn-local
# annotation too (the user's decision (b), 2026-10-13); the built-in slice stays reachable as `[T]`.
#
# ⛔ THE DEFECT, 6.6.10 through 6.7.10. PARSE_VAR compared an annotation's word against `slice` (the
# built-in `slice<T>` spelling) BEFORE any struct lookup, so with `struct slice { a; b; c; }` declared,
# `var x: slice;` was "uninitialized variable not allowed" and `var x: slice = 0;` the built-in 16-byte
# {ptr, len} slot (`x.a`: "no struct type in scope for 'x'"); with a generic `struct slice<T>` (this
# file's), `var x: slice<i64>` was the built-in slot ("slice has only .ptr and .len fields"). A parameter, a
# pointer target, a field, a global and a type argument already named the program's struct (6.7.8,
# tests/gates/frontend/slice_position_refused.sh K2). Now the local does too, on every fork: the 24-byte
# struct local (the bare name: the generic's i64 base), its instances, a field and globals of the type —
# and a `[u8]` slice in the same file is still the built-in one.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/slice.cyr"
include "lib/assert.cyr"

struct Pt { x; y; }
struct slice<T> { a: T; b; c; }         # generic: a bare `slice` is its i64 base, `slice<Pt>` an instance
struct H { s: slice; k; }

var GZ: slice = slice { 1, 2, 3 };

fn third(s: *slice): i64 { return s.c; }

fn filed(): i64 {
    var x: slice;                        # the program's 24-byte struct (the issue's 14 row)
    x.a = 5;
    var B: i64[3];
    store64(&B + 16, 9);
    return third(&B) + x.a;
}

fn locals(): i64 {
    var x: slice;
    x.a = 10;
    x.b = 20;
    x.c = 30;
    var y: slice = x;                    # a copy of the struct, not a {ptr, len} pair
    y.c = 4;
    assert_eq(sizeof(slice), 24, "sizeof(slice) is the program's struct");
    assert_eq(x.a + x.b + x.c, 60, "var x: slice, three fields");
    assert_eq(y.a + y.c + x.c, 44, "var y: slice = x copies all 24 bytes");
    assert_eq(third(&x), 30, "&x into a *slice parameter");
    var h: H;
    h.s.b = 7;
    h.k = 1;
    assert_eq(h.s.b + h.k, 8, "a struct field of the program's slice type");
    var bk: u8[4];
    store8(&bk + 2, 3);
    var u: [u8] = 0;                     # the built-in, reachable as [T]
    slice_set(&u, &bk, 4);
    assert_eq(u[2] + slice_len(&u), 7, "a [u8] local in the same file is the built-in slice");
    var w: slice<i64>;
    w.a = 5;
    w.c = 2;
    var q: slice<Pt>;
    q.a.x = 30;
    q.a.y = 4;
    q.c = 1;
    assert_eq(w.a + w.c + q.a.x + q.a.y + q.c, 42, "var w: slice<i64> / var q: slice<Pt>, the program's instances");
    assert_eq(sizeof(slice<Pt>), 32, "sizeof(slice<Pt>): the instance (16 + 8 + 8)");
    return 0;
}

fn sum_g(): i64 {
    GZ.c = 20;
    return GZ.a + GZ.b + GZ.c;
}

locals();
assert_eq(filed(), 14, "the filed shape: var x: slice; x.a = 5; f(&B) + x.a");
assert_eq(sum_g(), 23, "a declaration-zone global of the program's slice type");
var GP: slice = slice { 6, 0, 0 };
assert_eq(GP.a + GP.b, 6, "a global after the first statement");
var r = assert_summary();
