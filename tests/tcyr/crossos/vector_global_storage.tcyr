# vector_global_storage.tcyr — 6.6.17 (a3). A VECTOR-typed global owns the vector's bytes: 16 for a
# 128-bit vector, 32 for a 256-bit one, in both global zones (the declaration block, and after the
# first top-level statement).
#
# ⛔ THE DEFECT, every release through 6.6.16. `var g: f64v2 = 0;` was ONE 8-byte slot, so the
# pointer-form API the language routes `f64v2_add(&g, &h)` to wrote the vector's second lane over
# the NEXT global — silently, on every target (`&after - &g` measured 8). The value-form shapes
# that moved one word of it (`g = f(..)`, `var v: f64v2 = g;`, `g = v;`, a non-zero initializer)
# are now refused by name; tests/gates/diagnostics/type_name_refused.sh pins those.
#
# CROSS-HOST: each image writer lays the var area out from the recorded size (ELF, Mach-O, PE),
# and cx from its own var data; the `&g` + load/store round trip is per-backend.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/simd.cyr"
include "lib/assert.cyr"

var g2: f64v2 = 0;
var after2: i64 = 0x55;
var g4: f64v4 = 0;
var after4: i64 = 0x66;
var gi: i32v4 = 0;
var afteri: i64 = 0x77;

fn lane_sum2(p) { return load64(p) + load64(p + 8); }

fn ptr_api_roundtrip(): i64 {
    var a: f64v2 = f64v2_make(0x3FF0000000000000, 0x4000000000000000);   # {1.0, 2.0}
    store64(&g2, load64(&a));
    store64(&g2 + 8, load64(&a + 8));
    var s: f64v2 = f64v2_add(&g2, &g2);                                   # routed to _ptr
    if (load64(&s) != 0x4000000000000000) { return 1; }                   # 2.0
    if (load64(&s + 8) != 0x4010000000000000) { return 2; }               # 4.0
    return 0;
}

# 6.7.15 (D26 A / D27 A, the user's decisions, 2026-10-18; issues/2026-10-17-top-level-untyped-vector-call-or-method-
# result-binds-a-word.md): a call declared to return a vector into a TOP-LEVEL declaration is refused — untyped `var w =
# mkv(..);` / `= s.mv();` "'mkv' returns a vector by value, and a vector result needs storage in a fn's frame", `var x:
# i64 = mkv(..);` "vector return type does not match the declared type" (simd_return_shapes.sh rows TL) — where it held
# one word (x86_64 / aarch64 0, cx 154, Windows 195). The controls, in both zones: the call made in a fn, its lanes read
# into a top-level scalar or stored through a vector global's address; a scalar method or call keeps its word.
fn vg_mk(a, b): f64v2 { var v: f64v2; store64(&v, a); store64(&v + 8, b); return v; }
fn vg_lanes(): i64 { var v = vg_mk(41, 7); return load64(&v) * 10 + load64(&v + 8); }
fn vg_fill(p) { var v = vg_mk(43, 9); store64(p, load64(&v)); store64(p + 8, load64(&v + 8)); return 0; }
struct VgS { k; }
impl VgS { fn ks(self): i64 { return self.k + 1; } fn mv(self): f64v2 { return vg_mk(self.k, 8); } }
fn vg_mlanes(s: *VgS): i64 { var v = s.mv(); return load64(&v) * 10 + load64(&v + 8); }
var vgs: VgS = VgS { 5 };
var vgl = vg_lanes();
var vgk = vgs.ks();
var vgn: i64 = vg_lanes() + 1;
var g5: f64v2 = 0;
var vgf = vg_fill(&g5);

assert_eq(&after2 - &g2, 16, "f64v2 global is 16 B (declaration block)");
assert_eq(&after4 - &g4, 32, "f64v4 global is 32 B (declaration block)");
assert_eq(&afteri - &gi, 16, "i32v4 global is 16 B (declaration block)");
alloc_init();
assert_eq(ptr_api_roundtrip(), 0, "&g with the *_ptr form reads both lanes");
assert_eq(after2, 0x55, "the global after an f64v2 is untouched by a full-width write");
store64(&g4 + 24, 7);
assert_eq(after4, 0x66, "the global after an f64v4 is untouched by its last lane");
assert_eq(lane_sum2(&gi), 0, "an i32v4 global starts zero");

# After the first statement: PARSE_VAR's global arm sizes it the same way.
var h2: f64v2 = 0;
var hafter2: i64 = 0x88;
var h4: f64v4 = 0 + 0;
var hafter4: i64 = 0x99;
assert_eq(&hafter2 - &h2, 16, "f64v2 global is 16 B (after the first statement)");
assert_eq(&hafter4 - &h4, 32, "f64v4 global is 32 B (after the first statement)");
store64(&h2 + 8, 3);
assert_eq(hafter2, 0x88, "the late global after an f64v2 is untouched by its second lane");

# 6.7.15 (D26 / D27): the controls beside the refused top-level vector call.
assert_eq(vgl, 417, "a vector call's lanes read in a fn, into a zone global");
assert_eq(vgk, 6, "a scalar method into an untyped zone global keeps its word");
assert_eq(vgn, 418, "a scalar call starting an i64 zone initialiser");
assert_eq(lane_sum2(&g5), 52, "a vector call stored through a zone vector global's address");
var hgl = vg_lanes();
var hgk = vgs.ks();
var hgm = vg_mlanes(&vgs);
var h5: f64v2 = 0;
vg_fill(&h5);
assert_eq(hgl, 417, "a vector call's lanes read in a fn, into a late global");
assert_eq(hgk, 6, "a scalar method into an untyped late global keeps its word");
assert_eq(hgm, 58, "a vector method called in a fn on a global struct");
assert_eq(load64(&h5) * 10 + load64(&h5 + 8), 439, "a vector call stored through a late vector global's address");
var r = assert_summary();
