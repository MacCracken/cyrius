#endif

# FRAME ROWS — the same 16-bit displacement, reached by frame size instead of parameter count.
# Every local after `buf` sits past 64 KiB below x29. The broken compiler addressed it through a
# lone `movz` of the displacement (`y` at x29 - 0x11178 became x29 - 0x1178, a byte inside buf), so
# filling buf overwrote it. `fill` keeps its counter in its own small frame, so a regression reads
# the fill byte instead of hanging (a counter local past 64 KiB is overwritten by the fill itself).
# These rows run on cx as well (see the header): frame_below goes first and gates the other three,
# because on cx's defect `wfill`'s own frame sat inside `buf` and the fill never ended.
struct WT3 { a; b; c; }
fn wfill(p, n, v) { var i = 0; while (i < n) { store8(p + i, v); i = i + 1; } return 0; }
fn wmk3(): WT3 { var p = WT3 { 1, 2, 3 }; return p; }
# A callee's frame starts below its caller's whole 70000-byte frame: `pa` (the first local, just
# under the frame pointer) minus a fresh callee local's address must exceed it. Every local it
# reads sits ABOVE `buf`, so the row needs no displacement past 64 KiB and cannot hang.
fn frame_below() {
    var a = 0;
    var pa = &a;
    var d = 0;
    var buf[70000];
    store8(&buf, 1);
    d = pa - spp();
    assert_gt(d, 70000, "a callee's frame starts below a 70000-byte caller frame (sp lowered past 64 KiB)");
    if (d > 70000) { return 1; }
    return 0;
}
fn frame_local() {
    var buf[70000];
    var y = 5;
    wfill(&buf, 70000, 90);
    assert_eq(y, 5, "a local after a 70000-byte buffer keeps its value (load / store past 64 KiB)");
    return 0;
}
fn frame_addr() {
    var buf[70000];
    var y = 0;
    var py = &y;
    store64(py, 77);
    wfill(&buf, 70000, 90);
    assert_eq(y, 77, "a store through &local past 64 KiB lands on that local");
    return 0;
}
fn frame_retptr() {
    var buf[70000];
    var q: WT3 = wmk3();
    wfill(&buf, 70000, 90);
    assert_eq(q.a * 100 + q.b * 10 + q.c, 123, "a struct result received into a local past 64 KiB (the X8 retptr)");
    return 0;
}

fn run() {
    direct261();
    ptr261();
    if (direct262() == 0) { loop262(); }
    ptr262();
    if (direct263() == 0) { loop263(); }
    ptr263();
    direct600();
    ptr600();
    #ifndef CYRIUS_TARGET_CX
    direct2100();
    ptr2100();
    direct8200();
    ptr8200();
    #endif
    if (frame_below() == 1) {
        frame_local();
        frame_addr();
        frame_retptr();
    }
    return 0;
}

alloc_init();
run();
var r = assert_summary();
