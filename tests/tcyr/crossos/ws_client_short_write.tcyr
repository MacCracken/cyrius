# ws_client_short_write.tcyr — v6.6.8: lib/ws.cyr's client frame sender reports a short write
# instead of returning the full length with the frame cut short.
#
# The client twin of sock_send_all_short_write.tcyr (a separate file because lib/ws.cyr and
# lib/ws_server.cyr both define the WS_OP_* names). `_ws_send_frame` wrote the header and the
# masked payload with bare sys_write calls and dropped both counts, so under SO_SNDTIMEO (or a
# signal) the peer got a truncated frame while ws_send_binary returned `len`. It now goes through
# lib/net.cyr's sock_send_all and returns -1; ws_connect's handshake request likewise marks the
# socket CLOSED instead of reading a 101 for a request that never went out. CHANGELOG [6.6.8]
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/syscalls.cyr"
include "lib/tagged.cyr"
include "lib/io.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/net.cyr"
include "lib/bayan.cyr"
include "lib/ws.cyr"
include "lib/assert.cyr"

fn main(): i64 {
    alloc_init();

    #ifndef CYRIUS_TARGET_WIN
    #ifndef CYRIUS_TARGET_AGNOS
    var N = 1048576;
    var big = alloc(N);
    memset(big, 0x33, N);

    test_group("v6.6.8 — a client frame nobody reads fails instead of returning its length");
    var p[16];
    assert_eq(sys_socketpair(1, 1, 0, &p), 0, "socketpair");
    var a = load32(&p);
    assert_eq(sock_set_send_timeout(a, 0, 100000), 0, "SO_SNDTIMEO = 100 ms");
    var ws = ws_new(a);
    store64(ws + 8, WS_OPEN);                   # skip the handshake: framing is what is tested
    assert_eq(ws_send_binary(ws, big, N), 0 - 1, "ws_send_binary is -1 (it used to return 1048576)");
    sys_close(a);
    sys_close(load32(&p + 4));

    test_group("v6.6.8 — a small frame to a live peer still sends in full");
    var q[16];
    assert_eq(sys_socketpair(1, 1, 0, &q), 0, "socketpair");
    var qa = load32(&q);
    var qb = load32(&q + 4);
    var ws2 = ws_new(qa);
    store64(ws2 + 8, WS_OPEN);
    assert_eq(ws_send_text(ws2, "hello"), 5, "ws_send_text returns the payload length");
    var got[32];
    # 2-byte header (0x81, 0x80|5) + 4-byte mask + 5 masked bytes = 11.
    assert_eq(sys_read(qb, &got, 32), 11, "the peer reads exactly one 11-byte frame");
    assert_eq(load8(&got) & 0xFF, 0x81, "FIN + TEXT");
    sys_close(qa);
    sys_close(qb);

    # ws_connect's handshake request. The server's 101 is already waiting on the socket, so the
    # only thing that can decide the outcome is the request write — forced to fail here by
    # shutting this end for writing (-EPIPE, SIGPIPE ignored). Pre-6.6.8 ws_connect dropped that
    # count, read the 101 and reported an OPEN socket the server never received a request on.
    test_group("v6.6.8 — ws_connect: a handshake request that was not sent is not OPEN");
    signal_ignore(SIGPIPE);
    var r101 = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n";
    var h[16];
    assert_eq(sys_socketpair(1, 1, 0, &h), 0, "socketpair");
    var ha = load32(&h);
    var hb = load32(&h + 4);
    assert_eq(sys_write(hb, r101, strlen(r101)), strlen(r101), "control: the peer's 101 is queued");
    assert_eq(ws_state(ws_connect(ha, "/chat", "h")), WS_OPEN, "control: request sent, 101 read -> OPEN");
    sys_close(ha);
    sys_close(hb);
    var k[16];
    assert_eq(sys_socketpair(1, 1, 0, &k), 0, "socketpair");
    var ka = load32(&k);
    var kb = load32(&k + 4);
    assert_eq(sys_write(kb, r101, strlen(r101)), strlen(r101), "the peer's 101 is queued");
    assert_eq(sock_shutdown(ka, 1), 0, "SHUT_WR on the client end");
    assert_eq(ws_state(ws_connect(ka, "/chat", "h")), WS_CLOSED, "request not sent -> CLOSED (it used to be OPEN)");
    sys_close(ka);
    sys_close(kb);

    # 6.6.20 — the masked payload was an alloc(len) copy taken after the header was sent, and
    # alloc(0) is 0 on every target: every EMPTY frame went out in full and then reported -1
    # (a keepalive written `if (ws_ping(ws) < 0) close` dropped every connection). The frame is
    # now built in a 4096-byte stack buffer, masked a chunk at a time by ABSOLUTE payload offset —
    # the 5000-byte row crosses that boundary and must still unmask to the bytes that were sent
    # (5008 bytes stay under macOS's 8 KiB AF_UNIX send buffer: nobody reads until it returns).
    test_group("6.6.20 — empty frames report 0 and are sent once; a multi-chunk frame masks right");
    var e[16];
    assert_eq(sys_socketpair(1, 1, 0, &e), 0, "socketpair");
    var ea = load32(&e);
    var eb = load32(&e + 4);
    var ws3 = ws_new(ea);
    store64(ws3 + 8, WS_OPEN);
    var eg[32];
    assert_eq(ws_ping(ws3), 0, "ws_ping returns 0 (it returned -1 after sending the frame)");
    assert_eq(sys_read(eb, &eg, 32), 6, "  ...and the peer reads exactly one 6-byte frame");
    assert_eq(load8(&eg) & 0xFF, 0x89, "  FIN + PING");
    assert_eq(load8(&eg + 1) & 0xFF, 0x80, "  MASK bit, length 0");
    assert_eq(ws_send_text(ws3, ""), 0, "ws_send_text(ws, \"\") returns 0");
    assert_eq(sys_read(eb, &eg, 32), 6, "  ...one 6-byte frame");
    assert_eq(load8(&eg) & 0xFF, 0x81, "  FIN + TEXT");
    assert_eq(ws_send_binary(ws3, "", 0), 0, "ws_send_binary(ws, x, 0) returns 0");
    assert_eq(sys_read(eb, &eg, 32), 6, "  ...one 6-byte frame");
    assert_eq(load8(&eg) & 0xFF, 0x82, "  FIN + BINARY");
    assert_eq(ws_send_binary(ws3, "", 0 - 1), 0 - 1, "a negative length is -1, and nothing is sent");
    assert_eq(ws_state(ws3), WS_OPEN, "  ...the connection is still OPEN");

    var M = 5000;
    var src = alloc(M);
    var j = 0;
    while (j < M) { store8(src + j, (j * 7 + 3) & 0xFF); j = j + 1; }
    assert_eq(ws_send_binary(ws3, src, M), M, "a 5000-byte frame (two 4096-byte fills) returns its length");
    var fr = alloc(M + 8);
    var got2 = 0;
    var rr = 1;
    while (got2 < M + 8 && rr > 0) {
        rr = sys_read(eb, fr + got2, M + 8 - got2);
        if (rr > 0) { got2 = got2 + rr; }
    }
    assert_eq(got2, M + 8, "  ...the peer reads 2 + 2 + 4 header bytes and the 5000-byte payload");
    assert_eq(load8(fr + 1) & 0xFF, 0x80 | 126, "  16-bit extended length");
    assert_eq(((load8(fr + 2) & 0xFF) << 8) | (load8(fr + 3) & 0xFF), M, "  announcing 5000");
    var bad = 0;
    j = 0;
    while (j < M) {
        var mb = load8(fr + 4 + (j % 4)) & 0xFF;
        if (((load8(fr + 8 + j) & 0xFF) ^ mb) != (load8(src + j) & 0xFF)) { bad = bad + 1; }
        j = j + 1;
    }
    assert_eq(bad, 0, "  every payload byte unmasks to the byte sent (across the chunk boundary)");

    # With the 8-byte header the first fill carries 4088 payload bytes — a multiple of 4, so a
    # mask indexed by the CHUNK offset would still unmask right. A 64-bit-length frame has a
    # 14-byte header (4082 in the first fill, 4082 % 4 = 2), which tells the two apart. Linux
    # only: 70014 bytes fit a Linux AF_UNIX socketpair's default buffer, not macOS's 8 KiB one.
    #ifdef CYRIUS_TARGET_LINUX
    var L = 70000;
    var src2 = alloc(L);
    j = 0;
    while (j < L) { store8(src2 + j, (j * 13 + 5) & 0xFF); j = j + 1; }
    assert_eq(ws_send_binary(ws3, src2, L), L, "a 70000-byte frame (64-bit length) returns its length");
    var fr2 = alloc(L + 14);
    got2 = 0;
    rr = 1;
    while (got2 < L + 14 && rr > 0) {
        rr = sys_read(eb, fr2 + got2, L + 14 - got2);
        if (rr > 0) { got2 = got2 + rr; }
    }
    assert_eq(got2, L + 14, "  ...the peer reads 2 + 8 + 4 header bytes and the payload");
    assert_eq(load8(fr2 + 1) & 0xFF, 0x80 | 127, "  64-bit extended length");
    bad = 0;
    j = 0;
    while (j < L) {
        var mb2 = load8(fr2 + 10 + (j % 4)) & 0xFF;
        if (((load8(fr2 + 14 + j) & 0xFF) ^ mb2) != (load8(src2 + j) & 0xFF)) { bad = bad + 1; }
        j = j + 1;
    }
    assert_eq(bad, 0, "  every byte unmasks right (the mask follows the ABSOLUTE payload offset)");
    #endif
    sys_close(ea);
    sys_close(eb);
    #endif
    #endif

    # Every target, so no host scores this file 0 of 0 (PE and agnos have no socketpair here).
    test_group("v6.6.8 — a failed write is -1 on every target");
    var wsx = ws_new(0 - 1);
    store64(wsx + 8, WS_OPEN);
    assert_eq(ws_send_text(wsx, "x"), 0 - 1, "a frame to a descriptor that is not open is -1");
    assert_lt(sock_send_all(0 - 1, "x", 1), 0, "sock_send_all to a bad fd is -errno");

    return assert_summary();
}
var ec = main();
syscall(60, ec);
