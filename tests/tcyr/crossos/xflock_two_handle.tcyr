# 6.7.12 — xflock with TWO handles on one file, on every target. Windows had no route: xflock's
# PE arm was the constant -1, so a lock was never granted there and patra's open-time WAL
# recovery (taken only under a granted LOCK_EX|LOCK_NB) never ran. It is now kernel32
# LockFileEx / UnlockFileEx (reroutes 0xF04C / 0xF04D) on ONE sentinel byte at 2^63 - 1:
# Windows byte locks are MANDATORY, so locking the file's real bytes would fail the other
# handle's reads and writes — the rows below that read and write through the second handle
# while the first holds LOCK_EX are what pin the sentinel. Linux and both Macs run the same
# rows through flock(2) (flock locks belong to the open file description, so two opens in one
# process contend, as two handles do on Windows). A refused LOCK_NB is -EAGAIN: 11 on Linux
# and PE, 35 on Darwin. CHANGELOG [6.7.12]
# A cx guest on a WINDOWS host's cxvm has no flock route (its PE peer is a stub, so cxvm answers
# every xflock -38): there the lock rows are named as not run instead of failing, 6.7.16's D28 shape
# (they failed 24 of 36 on wine's cxvm.exe). CHANGELOG [6.7.17]
# A BAD OP on an open fd is -22 (EINVAL) and changes no lock, on every target (6.7.17's D97, the
# user, 2026-10-22: "validate the op in the macOS arm — a bad op is -22, as D37"). Linux's flock(2)
# checks the op before anything else (an op that is not LOCK_SH, LOCK_EX or LOCK_UN, + LOCK_NB, is
# -22), and so does the Windows arm. Darwin's flock read such an op its own way — one naming LOCK_UN
# unlocked, else one naming LOCK_EX locked exclusive, else one naming LOCK_SH shared, whatever other
# bits it carried, and one naming none was -9 — so macOS answered 3, 7 and 18 with 0 and the
# exclusive lock, 17 with 0 and the shared one, 9, 10 and 24 with 0 and the lock let go, and 0, 4
# and 16 with -9 (measured on ecb and ach). The macOS arm, and cxvm's flock on a Darwin host, check
# the op first since 6.7.17. CHANGELOG [6.7.17]
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/assert.cyr"

alloc_init();

var XF_EAGAIN = 11;
#ifdef CYRIUS_TARGET_MACOS
XF_EAGAIN = 35;
#endif
var XF_SH = 1;
var XF_EX = 2;
var XF_NB = 4;
var XF_UN = 8;

# Bad op `op` on A, which holds `held` (0: no lock; XF_EX: the exclusive one): -22, and A's lock is
# what it was — B's LOCK_EX|LOCK_NB is 0 (B lets go at once) when A held none, -EAGAIN when A held
# LOCK_EX. Afterwards A is put back in `held`, whatever the op did.
fn xf_badop(a, b, op, held, what, after): i64 {
    assert_eq(xflock(a, op), 0 - 22, what);
    var want = 0;
    if (held != 0) { want = 0 - XF_EAGAIN; }
    var rb = xflock(b, XF_EX | XF_NB);
    if (rb == 0) { xflock(b, XF_UN); }
    assert_eq(rb, want, after);
    if (held == 0) { xflock(a, XF_UN); } else { xflock(a, held); }
    return 0;
}

var path = test_scratch("cyrius_xflock_two_handle.tmp");
xunlink(path);

var a = file_open(path, O_RDWR | O_CREAT, 420);
assert_eq(a >= 0, 1, "handle A opens");

# The route probe: LOCK_UN of a lock nobody holds is 0 wherever xflock has a route.
var xf_route = 1;
#ifdef CYRIUS_TARGET_CX
if (xflock(a, XF_UN) == 0 - 38) {
    xf_route = 0;
    var xf_sk = "  not run: this host has no flock route: the lock rows (cxvm answers xflock -38)\n";
    sys_write(1, xf_sk, strlen(xf_sk));
}
#endif

if (xf_route == 1) {
    test_group("the filed repro: LOCK_EX on a freshly opened file is granted");
    assert_eq(xflock(a, XF_EX), 0, "A: LOCK_EX -> 0 (Windows: -1 before 6.7.12)");

    test_group("a second handle is refused while A holds LOCK_EX, and still reads and writes");
    var b = file_open(path, O_RDWR, 420);
    assert_eq(b >= 0, 1, "handle B opens");
    assert_eq(file_write(a, "data", 4), 4, "A writes 4 data bytes");
    assert_eq(xflock(b, XF_EX | XF_NB), 0 - XF_EAGAIN, "B: LOCK_EX|LOCK_NB -> -EAGAIN");
    assert_eq(xflock(b, XF_SH | XF_NB), 0 - XF_EAGAIN, "B: LOCK_SH|LOCK_NB -> -EAGAIN (A is exclusive)");
    var rb = alloc(16);
    assert_eq(xlseek(b, 0, 0), 0, "B seeks to 0");
    assert_eq(file_read(b, rb, 4), 4, "B reads the data bytes under A's lock (the lock is not on them)");
    store8(rb + 4, 0);
    assert_eq(streq(rb, "data"), 1, "B read back what A wrote");
    assert_eq(file_write(b, "more", 4), 4, "B writes 4 more bytes under A's lock");
    var ra = alloc(16);
    assert_eq(xlseek(a, 0, 0), 0, "A seeks to 0");
    assert_eq(file_read(a, ra, 8), 8, "A reads all 8 bytes back");
    store8(ra + 8, 0);
    assert_eq(streq(ra, "datamore"), 1, "A sees B's write");

    test_group("LOCK_UN releases it to the other handle");
    assert_eq(xflock(a, XF_UN), 0, "A: LOCK_UN -> 0");
    assert_eq(xflock(b, XF_EX | XF_NB), 0, "B: LOCK_EX|LOCK_NB -> 0 once A has unlocked");
    assert_eq(xflock(a, XF_EX | XF_NB), 0 - XF_EAGAIN, "A: LOCK_EX|LOCK_NB -> -EAGAIN (B holds it now)");
    assert_eq(xflock(b, XF_UN), 0, "B: LOCK_UN -> 0");
    assert_eq(xflock(b, XF_UN), 0, "B: LOCK_UN of a lock it no longer holds -> 0");

    test_group("two LOCK_SH are both granted, and both exclude LOCK_EX");
    var c = file_open(path, O_RDWR, 420);
    assert_eq(c >= 0, 1, "handle C opens");
    assert_eq(xflock(a, XF_SH | XF_NB), 0, "A: LOCK_SH|LOCK_NB -> 0");
    assert_eq(xflock(b, XF_SH | XF_NB), 0, "B: LOCK_SH|LOCK_NB -> 0 beside A's");
    assert_eq(xflock(c, XF_EX | XF_NB), 0 - XF_EAGAIN, "C: LOCK_EX|LOCK_NB -> -EAGAIN under two shared locks");
    assert_eq(xflock(a, XF_UN), 0, "A: LOCK_UN -> 0");
    assert_eq(xflock(c, XF_EX | XF_NB), 0 - XF_EAGAIN, "C: LOCK_EX|LOCK_NB -> -EAGAIN while B still shares");
    assert_eq(xflock(b, XF_UN), 0, "B: LOCK_UN -> 0");
    assert_eq(xflock(c, XF_EX | XF_NB), 0, "C: LOCK_EX|LOCK_NB -> 0 once both shared locks are gone");
    assert_eq(xflock(c, XF_UN), 0, "C: LOCK_UN -> 0");

    test_group("one handle converts its own lock without deadlocking itself");
    assert_eq(xflock(a, XF_SH), 0, "A: LOCK_SH -> 0");
    assert_eq(xflock(a, XF_EX | XF_NB), 0, "A: LOCK_SH -> LOCK_EX|LOCK_NB -> 0 (its own shared lock does not block)");
    assert_eq(xflock(b, XF_SH | XF_NB), 0 - XF_EAGAIN, "B: LOCK_SH|LOCK_NB -> -EAGAIN (A converted to exclusive)");
    assert_eq(xflock(a, XF_EX), 0, "A: LOCK_EX again on its own exclusive lock -> 0, no self-deadlock");
    assert_eq(xflock(a, XF_SH | XF_NB), 0, "A: LOCK_EX -> LOCK_SH|LOCK_NB -> 0");
    assert_eq(xflock(b, XF_SH | XF_NB), 0, "B: LOCK_SH|LOCK_NB -> 0 (A is shared again)");
    assert_eq(xflock(a, XF_UN), 0, "A: LOCK_UN -> 0");
    assert_eq(xflock(b, XF_UN), 0, "B: LOCK_UN -> 0");
    assert_eq(xflock(a, 0) < 0, 1, "an op that is none of LOCK_SH / LOCK_EX / LOCK_UN is refused");

    test_group("a bad op on an open fd is -EINVAL and changes no lock (6.7.17's D97)");
    var nolk = "  B: LOCK_EX|LOCK_NB -> 0 after it: A took no lock";
    xf_badop(a, b, 0, 0, "A: op 0 -> -22 (macOS -9)", nolk);
    xf_badop(a, b, 4, 0, "A: op 4 (LOCK_NB alone) -> -22 (macOS -9)", nolk);
    xf_badop(a, b, 16, 0, "A: op 16 (no lock bit) -> -22 (macOS -9)", nolk);
    xf_badop(a, b, 3, 0, "A: op 3 (LOCK_SH | LOCK_EX) -> -22 (macOS 0, locked exclusive)", nolk);
    xf_badop(a, b, 7, 0, "A: op 7 (LOCK_SH | LOCK_EX | LOCK_NB) -> -22 (macOS 0, locked exclusive)", nolk);
    xf_badop(a, b, 18, 0, "A: op 18 (LOCK_EX | 16) -> -22 (macOS 0, locked exclusive)", nolk);
    xf_badop(a, b, 17, 0, "A: op 17 (LOCK_SH | 16) -> -22 (macOS 0, locked shared)", nolk);
    assert_eq(xflock(a, XF_EX), 0, "A: LOCK_EX -> 0");
    var kept = "  B: LOCK_EX|LOCK_NB -> -EAGAIN after it: A kept its lock";
    xf_badop(a, b, 9, XF_EX, "A: op 9 (LOCK_UN | LOCK_SH) -> -22 (macOS 0, unlocked)", kept);
    xf_badop(a, b, 10, XF_EX, "A: op 10 (LOCK_UN | LOCK_EX) -> -22 (macOS 0, unlocked)", kept);
    xf_badop(a, b, 24, XF_EX, "A: op 24 (LOCK_UN | 16) -> -22 (macOS 0, unlocked)", kept);
    assert_eq(xflock(a, XF_UN | XF_NB), 0, "A: op 12 (LOCK_UN | LOCK_NB) is a good op -> 0, unlocked");
    assert_eq(xflock(b, XF_EX | XF_NB), 0, "B: LOCK_EX|LOCK_NB -> 0 once A let go");
    assert_eq(xflock(b, XF_UN), 0, "B: LOCK_UN -> 0");

    file_close(c);
    file_close(b);
}
file_close(a);
xunlink(path);
var r = assert_summary();
