# zone_struct_literal_value.tcyr — 6.7.15: a declaration-zone struct or tuple literal whose every element is a
# constant is its global's value from program start, with no startup stores
# (issues/archived/2026-10-16-zone-struct-literal-baked-and-stored.md).
#
# THE DEFECT (measured on 6.7.14, x86_64). `var p = P { 1, 2 };` put its bytes in the image (6.6.16's bake) AND
# stored every element again at startup — per field `mov eax, imm; push rax; movabs rcx, p; [add rcx, off;] pop rax;
# mov [rcx], rax` — the named form and a tuple literal alike. Every value was right; the code was redundant. THE FIX
# (6.7.14's scalar rule, its D11 (b): a constant initializer is the global's value from program start): the stores
# are dropped where the image's bytes are the literal's — no earlier writer of the global and no later literal
# baked over it, or an earlier literal of the same bytes. As with a scalar constant, a call in an earlier initializer
# that writes the global keeps its write (12, 13: through 6.7.14 the startup store reset it to the literal's 1).
#
# ⛔ 6.7.16 — A REDECLARED LITERAL OF CONSTANTS IS THE VALUE FROM PROGRAM START (the user's decision D14 (a),
# 2026-10-19; issues/archived/2026-10-18-struct-tuple-literal-redeclaration-order-vs-d2.md), as a scalar constant redeclaration
# is (6.7.15's D2 (a)): an earlier literal of the name leaves no startup store. A read between two literals of other
# bytes sees the later one (10: 13 -> 33; 15 - 20 every spelling: tuple, named, generic, wrapped, annotated tuple,
# enum leaves), a call between them keeps its write (14: 34 -> 94), an earlier computed initializer still runs, its
# result discarded (21, 24), a later computed one keeps its order (22), and a constant literal before a computed one
# leaves no store either (23: the call's write before it is kept, 15 -> 95).
#
# WHY A CROSS-HOST TEST: the bytes are the file image's on five targets and cx's .cyx var data on the sixth; this
# file runs every row on each host's own compiler. All declarations are in ONE declaration zone (every `var` and `fn`
# below comes before the first statement, the first assert_eq).
include "lib/assert.cyr"

enum ZE { ZA = 3; ZB = 4; }
struct ZP { a; b; }
struct ZI { x: i8; y: i32; }
struct ZO { a; i: ZI; c: u16; }
struct ZF { d: f64; g: f32; n; }
struct ZW<T> { v: T; n; }

# 1 — the filed repro
var p1 = ZP { 1, 2 };
# 2 — the named form
var p2 = ZP { b: 2, a: 1 };
# 3 — tuple literals, inferred and annotated
var t3 = (3, 4);
var u3: (i64, i64) = (5, 6);
# 4 — a nested struct of narrow fields
var o4 = ZO { 1, 0x7F, 0x11223344, 0xBEEF };
# 5 — float fields: an f64's binary64 bits, an f32's binary32 bits
var f5 = ZF { 1.5, 0.1, 7 };
# 6 — enum constants
var p6 = ZP { ZA, ZE.ZB + 1 };
# 7 — a generic struct's literal
var w7 = ZW<i32> { 5, 6 };
# 8 — a wrapped literal
var p8: ZP = (ZP { 7, 8 });
# 9 — an earlier initializer reads the global through a fn: the image's bytes
fn rd9(): i64 { return p9.b; }
var r9 = rd9();
var p9 = ZP { 5, 6 };
# 10 — a redeclared literal of other bytes keeps its place: a read between sees the first
var p10 = ZP { 1, 2 };
var b10 = p10.a;
var p10 = ZP { 3, 4 };
# 11 — a same-bytes redeclaration
var p11 = ZP { 1, 2 };
var b11 = p11.a;
var p11 = ZP { 1, 2 };
# 12 — a call in an earlier initializer that writes the global keeps its write
fn set12(): i64 { p12.a = 9; return 1; }
var r12 = set12();
var p12 = ZP { 1, 2 };
# 13 — ... and between two literals of the same bytes
var p13 = ZP { 1, 2 };
fn set13(): i64 { p13.a = 9; return 1; }
var r13 = set13();
var p13 = ZP { 1, 2 };
# 14 — between two literals of other bytes the call's write is kept (6.7.16, D14 (a); through 6.7.15 the later
# literal was stored at its place: 34)
var p14 = ZP { 1, 2 };
fn set14(): i64 { p14.a = 9; return 1; }
var r14 = set14();
var p14 = ZP { 3, 4 };
# 15 - 24 — 6.7.16 (D14 (a)): the later literal from program start, in every spelling
var t15 = (1, 2);
var b15 = t15.0;
var t15 = (3, 4);
var a15 = 1;
var c15 = a15;
var a15 = 2;
var p16 = ZP { b: 2, a: 1 };
var b16 = p16.a;
var p16 = ZP { b: 4, a: 3 };
var w17 = ZW<i32> { 1, 2 };
var b17 = w17.v;
var w17 = ZW<i32> { 3, 4 };
var p18: ZP = (ZP { 1, 2 });
var b18 = p18.a;
var p18: ZP = (ZP { 3, 4 });
var t19: (i64, i64) = (1, 2);
var b19 = t19.0;
var t19: (i64, i64) = (3, 4);
var p20 = ZP { 1, 2 };
var b20 = p20.a;
var p20 = ZP { ZE.ZA, ZB + 1 };
var n21 = 0;
fn f21(): i64 { n21 = n21 + 1; return 7; }
var p21 = ZP { f21(), 2 };
var b21 = p21.a;
var p21 = ZP { 3, 4 };
fn f22(): i64 { return 7; }
var p22 = ZP { 1, 2 };
var b22 = p22.a;
var p22 = ZP { f22(), 4 };
fn set23(): i64 { p23.a = 9; return 1; }
var r23 = set23();
var p23 = ZP { 1, 2 };
var b23 = p23.a;
var p23 = ZP { f22(), 2 };
struct ZQ { a; }
fn mk24(): ZQ { var t: ZQ = ZQ { 7 }; return t; }
var q24: ZQ = mk24();
var b24 = q24.a;
var q24 = ZQ { 3 };

assert_eq(p1.a * 10 + p1.b, 12, "1: P { 1, 2 }");
assert_eq(p2.a * 10 + p2.b, 12, "2: P { b: 2, a: 1 }");
assert_eq(t3.0 * 10 + t3.1, 34, "3: (3, 4)");
assert_eq(u3.0 * 10 + u3.1, 56, "3: (i64, i64) = (5, 6)");
assert_eq(o4.a + o4.i.x + o4.c, 1 + 0x7F + 0xBEEF, "4: nested narrow fields");
assert_eq(o4.i.y, 0x11223344, "4: the i32 field");
assert_eq(load64(&f5), 0x3FF8000000000000, "5: an f64 field's binary64 bits");
assert_eq(load32(&f5 + 8), 0x3DCCCCCD, "5: an f32 field's binary32 bits");
assert_eq(f5.n, 7, "5: the field after the f32");
assert_eq(p6.a * 10 + p6.b, 35, "6: P { A, E.B + 1 }");
assert_eq(w7.v * 10 + w7.n, 56, "7: W<i32> { 5, 6 }");
assert_eq(p8.a * 10 + p8.b, 78, "8: (P { 7, 8 })");
assert_eq(r9 * 10 + p9.b, 66, "9: an earlier read sees the image's bytes");
assert_eq(b10 * 10 + p10.a, 33, "10: a redeclared literal is the later one from program start (6.7.16; was 13)");
assert_eq(b11 * 10 + p11.a, 11, "11: a same-bytes redeclaration");
assert_eq(p12.a * 10 + p12.b, 92, "12: an earlier call's write is kept (was 12)");
assert_eq(p13.a * 10 + p13.b, 92, "13: a call between two same literals keeps its write (was 12)");
assert_eq(p14.a * 10 + p14.b, 94, "14: a call between two literals of other bytes keeps its write (6.7.16; was 34)");
assert_eq(b15 * 10 + c15, 32, "15: (1, 2); b = t.0; (3, 4) beside a scalar pair -> b 3 (was 12)");
assert_eq(b16 * 10 + p16.b, 34, "16: the named form -> b 3 (was 14)");
assert_eq(b17 * 10 + w17.n, 34, "17: a generic literal -> b 3 (was 14)");
assert_eq(b18 * 10 + p18.b, 34, "18: a wrapped literal -> b 3 (was 14)");
assert_eq(b19 * 10 + t19.1, 34, "19: an annotated tuple -> b 3 (was 14)");
assert_eq(b20 * 10 + p20.b, 35, "20: enum leaves -> b 3 (was 15)");
assert_eq(b21 * 10 + n21, 31, "21: an earlier computed literal runs once, its result discarded (was 71)");
assert_eq(b22 * 10 + p22.a, 17, "22: a later computed literal keeps its order");
assert_eq(b23 * 10 + p23.a, 97, "23: a constant literal before a computed one leaves no store: the call's write is read (was 17)");
assert_eq(b24 * 10 + q24.a, 33, "24: an earlier computed struct initializer runs into a sink (was 73)");
var r = assert_summary();
