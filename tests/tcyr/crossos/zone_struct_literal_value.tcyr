# zone_struct_literal_value.tcyr — 6.7.15: a declaration-zone struct or tuple literal whose every element is a
# constant is its global's value from program start, with no startup stores
# (issues/2026-10-16-zone-struct-literal-baked-and-stored.md).
#
# THE DEFECT (measured on 6.7.14, x86_64). `var p = P { 1, 2 };` put its bytes in the image (6.6.16's bake) AND
# stored every element again at startup — per field `mov eax, imm; push rax; movabs rcx, p; [add rcx, off;] pop rax;
# mov [rcx], rax` — the named form and a tuple literal alike. Every value was right; the code was redundant. THE FIX
# (6.7.14's scalar rule, its D11 (b): a constant initializer is the global's value from program start): the stores
# are dropped where the image's bytes are the literal's — no earlier writer of the global and no later literal
# baked over it, or an earlier literal of the same bytes. A redeclared literal of other bytes keeps its place (10,
# 14). As with a scalar constant, a call in an earlier initializer that writes the global keeps its write (12, 13:
# through 6.7.14 the startup store reset it to the literal's 1).
#
# WHY A CROSS-HOST TEST: the bytes are the file image's on five targets and cx's .cyx var data on the sixth; this
# file runs every row on each host's own compiler. All declarations are in ONE declaration zone (every `var` and `fn`
# below comes before the first statement, the first assert_eq).
include "lib/assert.cyr"

enum ZE { ZA = 3; ZB = 4; }
struct ZP { a; b; }
struct ZI { x: i8; y: i32; }
struct ZO { a; i: ZI; c: u16; }
struct ZF { d: f64; g: f32; n; }
struct ZW<T> { v: T; n; }

# 1 — the filed repro
var p1 = ZP { 1, 2 };
# 2 — the named form
var p2 = ZP { b: 2, a: 1 };
# 3 — tuple literals, inferred and annotated
var t3 = (3, 4);
var u3: (i64, i64) = (5, 6);
# 4 — a nested struct of narrow fields
var o4 = ZO { 1, 0x7F, 0x11223344, 0xBEEF };
# 5 — float fields: an f64's binary64 bits, an f32's binary32 bits
var f5 = ZF { 1.5, 0.1, 7 };
# 6 — enum constants
var p6 = ZP { ZA, ZE.ZB + 1 };
# 7 — a generic struct's literal
var w7 = ZW<i32> { 5, 6 };
# 8 — a wrapped literal
var p8: ZP = (ZP { 7, 8 });
# 9 — an earlier initializer reads the global through a fn: the image's bytes
fn rd9(): i64 { return p9.b; }
var r9 = rd9();
var p9 = ZP { 5, 6 };
# 10 — a redeclared literal of other bytes keeps its place: a read between sees the first
var p10 = ZP { 1, 2 };
var b10 = p10.a;
var p10 = ZP { 3, 4 };
# 11 — a same-bytes redeclaration
var p11 = ZP { 1, 2 };
var b11 = p11.a;
var p11 = ZP { 1, 2 };
# 12 — a call in an earlier initializer that writes the global keeps its write
fn set12(): i64 { p12.a = 9; return 1; }
var r12 = set12();
var p12 = ZP { 1, 2 };
# 13 — ... and between two literals of the same bytes
var p13 = ZP { 1, 2 };
fn set13(): i64 { p13.a = 9; return 1; }
var r13 = set13();
var p13 = ZP { 1, 2 };
# 14 — between two literals of other bytes the later one is stored at its place
var p14 = ZP { 1, 2 };
fn set14(): i64 { p14.a = 9; return 1; }
var r14 = set14();
var p14 = ZP { 3, 4 };

assert_eq(p1.a * 10 + p1.b, 12, "1: P { 1, 2 }");
assert_eq(p2.a * 10 + p2.b, 12, "2: P { b: 2, a: 1 }");
assert_eq(t3.0 * 10 + t3.1, 34, "3: (3, 4)");
assert_eq(u3.0 * 10 + u3.1, 56, "3: (i64, i64) = (5, 6)");
assert_eq(o4.a + o4.i.x + o4.c, 1 + 0x7F + 0xBEEF, "4: nested narrow fields");
assert_eq(o4.i.y, 0x11223344, "4: the i32 field");
assert_eq(load64(&f5), 0x3FF8000000000000, "5: an f64 field's binary64 bits");
assert_eq(load32(&f5 + 8), 0x3DCCCCCD, "5: an f32 field's binary32 bits");
assert_eq(f5.n, 7, "5: the field after the f32");
assert_eq(p6.a * 10 + p6.b, 35, "6: P { A, E.B + 1 }");
assert_eq(w7.v * 10 + w7.n, 56, "7: W<i32> { 5, 6 }");
assert_eq(p8.a * 10 + p8.b, 78, "8: (P { 7, 8 })");
assert_eq(r9 * 10 + p9.b, 66, "9: an earlier read sees the image's bytes");
assert_eq(b10 * 10 + p10.a, 13, "10: a redeclared literal keeps its place");
assert_eq(b11 * 10 + p11.a, 11, "11: a same-bytes redeclaration");
assert_eq(p12.a * 10 + p12.b, 92, "12: an earlier call's write is kept (was 12)");
assert_eq(p13.a * 10 + p13.b, 92, "13: a call between two same literals keeps its write (was 12)");
assert_eq(p14.a * 10 + p14.b, 34, "14: the later literal of other bytes is stored at its place");
var r = assert_summary();
