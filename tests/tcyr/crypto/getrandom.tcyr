# getrandom.tcyr — the cross-platform CSPRNG primitive (sys_getrandom).
# Covers the entropy contract every target must satisfy: returns the requested
# length, fills the buffer (nonzero), and yields unique bytes across draws.
# Per-target source: getrandom(318) on x86-Linux, getentropy on macOS (ESYSXLAT),
# getrandom(aarch64) on pi, getrandom(#45) on AGNOS, and — as of v6.2.12 —
# ProcessPrng (bcryptprimitives.dll, 0xF01A PE reroute) on Windows. This is the
# committed regression for the Windows half (issue 2026-06-11); it runs on cass
# via the cross-OS lib-test (no fork/socketpair → PE-safe).
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/assert.cyr"

fn main(): i64 {
    alloc_init();

    test_group("sys_getrandom — entropy primitive");
    var a = alloc(32);
    var b = alloc(32);
    memset(a, 0, 16);
    memset(b, 0, 16);

    var r1 = sys_getrandom(a, 16, 0);
    assert_eq(r1, 16, "sys_getrandom returns the requested length (16)");
    var r2 = sys_getrandom(b, 16, 0);
    assert_eq(r2, 16, "second draw also returns the length");

    # entropy present: an all-zero 16-byte draw is ~2^-128 — treat as failure.
    var nz = 0;
    var i = 0;
    while (i < 16) { if ((load8(a + i) & 0xFF) != 0) { nz = 1; } i = i + 1; }
    assert_eq(nz, 1, "buffer carries nonzero bytes (entropy present, not fail-closed)");

    # uniqueness: two independent draws must differ (a constant RNG is broken).
    var diff = 0;
    i = 0;
    while (i < 16) { if ((load8(a + i) & 0xFF) != (load8(b + i) & 0xFF)) { diff = 1; } i = i + 1; }
    assert_eq(diff, 1, "two draws differ (real CSPRNG, not a fixed buffer)");

    var r = assert_summary();
    return r;
}

var rc = main();
syscall(60, rc);
