# tls13_ch_conformance.tcyr — 6.7.15: the native TLS 1.3 server's ClientHello extension block fills
# the message, or the handshake is refused with decode_error.
#
# issues/archived/2026-10-17-tls-native-hello-bytes-after-extension-block-1-2-sh-and-server-ch.md, the 1.3
# server's arm. _tn_parse_client_hello checked `pos + ext_total > body_len`, so bytes after the block
# no structure names were accepted and the server answered with its ServerHello (RFC 8446 §4:
# decode_error) — the `>` 6.7.14 replaced in the 1.3 client's ServerHello and EncryptedExtensions.
# Now `!=`: the block fills the rest of the ClientHello.
#   T0-T2  the filed repro's `_ch13_trail` verbatim: 0 bytes after the block answered (the
#          ServerHello's length), 2 refused with decode_error; 1 byte refused too.
#   T3     a block claiming 2 bytes more than the message holds: refused, decode_error (a control —
#          refused before the fix as well).
#   W1     tls_native_accept over a socketpair, T1's ClientHello pre-written: the version sniffer
#          routes it to the 1.3 server, and the client end receives a fatal decode_error, in the
#          clear. A named SKIP where socketpair is refused.
# On the lib before the fix: T1, T2 and W1 fail.
#
# issues/archived/2026-10-19-tls-native-servers-clienthello-null-compression-repeated-ext-block-tail.md; the
# user's decision 6.7.16 D81 (2026-10-20): "Refuse with decode_error". The parse looked extensions
# up with _tn_find_ext, whose `pos + 4 <= ext_len` loop never reads 1-3 bytes after the block's last
# whole extension, so a block ending in a partial entry negotiated (the filed repro's row D). Now the
# block is walked once before any lookup (_tn_ch_ext_walk, shared with the 1.2 parse).
#   T4-T6  a 1 / 2 / 3-byte tail inside the block (the block's length and the message grown by it):
#          each refused, decode_error, the ctx failed. T5 is the filed repro's row D.
#   W2     T5's ClientHello through tls_native_accept over a socketpair: a fatal decode_error on the
#          wire. A named SKIP where socketpair is refused.
# On the lib before D81: T4-T6 and W2 fail (each negotiated).
#
# The same issue; the user's decision 6.7.16 D82 (2026-10-20): "Refuse with illegal_parameter".
# _tn_find_ext takes the first of a repeated type, so the server negotiated on it (the filed row G).
# RFC 8446 §4.2: no more than one extension of a type in a block — the 1.3 client already refuses a
# repeat with illegal_parameter (_tn_client_ext_walk, 6.7.14).
#   G1     the filed row G: the block's first extension (server_name) appended again — refused,
#          TLS_ERR_HANDSHAKE_FAILED, illegal_parameter, the ctx failed.
#   G2-G3  a repeat that is not the first entry: supported_versions appended again; the last entry
#          (key_share) twice, side by side.
#   G4-G6  a block of more than 32 entries (40 empty unassigned types appended; the walk's one-pass
#          map): no repeat is answered (G4); the last appended type again (G5) and 0xFFFF twice
#          (G6) are refused.
#   G7     framing first: G1's repeat with a 2-byte tail inside the block is decode_error.
#   W3     G1 through tls_native_accept: a fatal illegal_parameter on the wire. A named SKIP where
#          socketpair is refused.
# On the lib before D82: G1-G3, G5-G6 and W3 are answered with a ServerHello; G7 is refused by D81.
#
# The same issue; the user's decision 6.7.16 D83 (2026-10-20): "Refuse with illegal_parameter on both
# versions". The parse skipped legacy_compression_methods unread (`pos = pos + 1 + comp_len`), so
# any list was answered (the filed row E). RFC 8446 §4.1.2: exactly one byte, 0 — "any other value"
# is illegal_parameter.
#   E1     the filed row E: [1] — refused, TLS_ERR_HANDSHAKE_FAILED, illegal_parameter.
#   E2-E3  [0, 0] and [1, 0] (null, but not the single null method) — refused the same way.
#   E4     an empty list does not parse (<1..2^8-1>): decode_error, as the 1.2 parse's P6 (D32).
#   E5     framing first: [1] with T5's 2-byte tail inside the block is decode_error.
#   W4     E1 through tls_native_accept: a fatal illegal_parameter on the wire. A named SKIP where
#          socketpair is refused.
# On the lib before D83: E1-E4 and W4 are answered with a ServerHello; E5 is refused by D81.
#
# issues/archived/2026-10-21-tls13-server-key-share-scan-quadratic-in-peer-count.md (CYRIUS-2026-0037). The
# key_share loop checked each share against supported_groups with _tn_sg_has — a re-validation and
# a walk of the whole list per share, ~21 ms of CPU for a 16 KB hello (x86_64). Now the list is
# validated once and a list of more than 32 groups answers membership from a one-pass bitmap
# (_tn_sg_set / _tn_sg_member); the refusals are unchanged. The timing is
# tests/gates/platform/tls13_key_share_scan_linear.sh; these rows pin the answers on every target.
#   K1     the 16,166-byte hello (4,025 groups, 1,610 one-byte shares on the last of them, none of
#          ours): still refused, handshake_failure (no shared group).
#   K2     40 groups and a share for a group not on them: illegal_parameter (the bitmap's refusal).
#   K3     40 groups ending in x25519, an x25519 share: negotiates.
#   K4-K5  32 groups (the scan, no bitmap): an unlisted share refused; x25519 last negotiates.
#   K6     33 groups (the first list that takes the bitmap), x25519 last: negotiates.
#   K7-K8  the bitmap's edge bits — 40 groups 0xFFE0-0xFFFF, 0x0000-0x0006, x25519: shares on
#          0xFFFF and 0x0000 negotiate; one on 0x0007 (unlisted, the same byte as 0x0000-0x0006)
#          is illegal_parameter.
include "lib/str.cyr"
include "lib/chrono.cyr"
include "lib/random.cyr"
include "lib/tls_native.cyr"
include "lib/net.cyr"
include "lib/assert.cyr"

var CERT23 = "";
var KEY23 = "308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420b19108bb3950b49995a9c770e12613b12d96dc2409a464fdc43c63a41b1d4668a144034200049167a2981f570fdbd8d94bf20fb4f5c89d77aa5b58cf4ed416bafa0256a2561a04f1e71d57537fc532fc87ca980eb8ba1f8f8704fc7f6a793ba6598b97bb3275";

fn _h(s): i64 { return hex_decode(s, strlen(s)); }
fn _hn(s): i64 { return strlen(s) / 2; }

var G_CL = 0;    # the server of the last row (the filed repro's name for it)

fn _alert(): i64 { return load64(G_CL + TLS_CTX_OFF_HS_ALERT); }

# The filed repro's helper, verbatim: a client's own 1.3 ClientHello with n bytes after its block.
fn _ch13_trail(n): i64 {          # a client's own 1.3 ClientHello with n bytes after its block
    var srv = tls_native_new_server(_h(CERT23), _hn(CERT23), _h(KEY23), _hn(KEY23));
    tls_native_server_load_creds(srv);
    var cl = tls_native_new_client("localhost", 9);
    var ch = alloc(1024);
    var chn = tls_native_client_build_hello(cl, ch, 1024);
    memset(ch + chn, 0, n);
    tls_native_handshake_write_header(ch, 1, chn - 4 + n);
    var sh = alloc(1024);
    var r = tls_native_server_respond_hello(srv, ch, chn + n, sh, 1024);
    G_CL = srv;
    return r;
}

# The offset, in a ClientHello body, of the extension block's 2-byte length.
fn _ext_off(body): i64 {
    var pos = 2 + 32;
    pos = pos + 1 + (load8(body + pos) & 0xFF);       # session id
    pos = pos + 2 + _tn_be16_r(body + pos);           # cipher suites
    pos = pos + 1 + (load8(body + pos) & 0xFF);       # compression methods
    return pos;
}

# T3: the client's own 1.3 ClientHello with its block length raised by 2.
fn _ch13_overrun(): i64 {
    var srv = tls_native_new_server(_h(CERT23), _hn(CERT23), _h(KEY23), _hn(KEY23));
    tls_native_server_load_creds(srv);
    var cl = tls_native_new_client("localhost", 9);
    var ch = alloc(1024);
    var chn = tls_native_client_build_hello(cl, ch, 1024);
    var eo = _ext_off(ch + 4);
    _tn_be16_w(ch + 4 + eo, _tn_be16_r(ch + 4 + eo) + 2);
    var sh = alloc(1024);
    var r = tls_native_server_respond_hello(srv, ch, chn, sh, 1024);
    G_CL = srv;
    return r;
}

# Read exactly `n` bytes of `fd` into `buf`; the count read (short at EOF / error).
fn _read_n(fd, buf, n): i64 {
    var got = 0;
    while (got < n) {
        var r = sys_read(fd, buf + got, n - got);
        if (r <= 0) { return got; }
        got = got + r;
    }
    return got;
}

# W1: tls_native_accept over a socketpair, a 1.3 ClientHello with 2 bytes after its block written
# to the client end first (one plaintext handshake record). Returns accept's result; the alert
# record the server sent in G_W1 ((level << 8) | description, read in the clear), or -999 when
# socketpair is refused.
var G_W1 = 0;
fn _w1(): i64 {
    G_W1 = 0 - 1;
    var fds: i64[1];
    if (sys_socketpair(1, 1, 0, &fds) < 0) { return 0 - 999; }
    var fdp = load64(&fds);
    var sfd = fdp & 0xFFFFFFFF;
    var cfd = (fdp >> 32) & 0xFFFFFFFF;
    var cl = tls_native_new_client("localhost", 9);
    var rec = alloc(1100);
    memset(rec, 0, 1100);
    var chn = tls_native_client_build_hello(cl, rec + 5, 1024);
    tls_native_handshake_write_header(rec + 5, TLS_HS_CLIENT_HELLO, chn - 4 + 2);
    tls_native_record_write_header(rec, TLS_CT_HANDSHAKE, 0x0303, chn + 2);
    sys_write(cfd, rec, 5 + chn + 2);
    var srv = tls_native_new_server(_h(CERT23), _hn(CERT23), _h(KEY23), _hn(KEY23));
    tls_native_server_load_creds(srv);
    tls_native_set_deadline(srv, clock_now_ns() + 10000000000);
    var rc = tls_native_accept(srv, sfd);
    sys_close(sfd);
    var arec = alloc(16);
    if (_read_n(cfd, arec, 7) != 7) { sys_close(cfd); G_W1 = 0 - 2; return rc; }
    sys_close(cfd);
    if ((load8(arec) & 0xFF) != TLS_CT_ALERT) { G_W1 = 0 - 3; return rc; }
    if ((((load8(arec + 3) & 0xFF) << 8) | (load8(arec + 4) & 0xFF)) != 2) { G_W1 = 0 - 4; return rc; }
    G_W1 = ((load8(arec + 5) & 0xFF) << 8) | (load8(arec + 6) & 0xFF);
    return rc;
}

var G_CH = 0;    # a fresh client's 1.3 ClientHello, 4-byte header first, in a zeroed 1024-byte buffer
var G_CHN = 0;   # its length, header included

fn _ch13(): i64 {
    var cl = tls_native_new_client("localhost", 9);
    G_CH = alloc(1024);
    memset(G_CH, 0, 1024);
    G_CHN = tls_native_client_build_hello(cl, G_CH, 1024);
    return G_CHN;
}

# The 1.3 server's answer to G_CH's first `n` bytes (its header rewritten to match); the server in
# G_CL. tls_native_server_respond_hello's result: > 0 a ServerHello written, else the TLS_ERR_*.
fn _resp(n): i64 {
    tls_native_handshake_write_header(G_CH, TLS_HS_CLIENT_HELLO, n - 4);
    var srv = tls_native_new_server(_h(CERT23), _hn(CERT23), _h(KEY23), _hn(KEY23));
    tls_native_server_load_creds(srv);
    var sh = alloc(1024);
    var r = tls_native_server_respond_hello(srv, G_CH, n, sh, 1024);
    G_CL = srv;
    return r;
}

# T4-T6: a fresh G_CH with `n` bytes inside its block after the last whole extension (the block's
# length and the message grown by `n`; the tail's bytes start a supported_groups header, 00 0A 00).
# The ClientHello's length.
fn _tail13(n): i64 {
    _ch13();
    var eo = _ext_off(G_CH + 4);
    _tn_be16_w(G_CH + 4 + eo, _tn_be16_r(G_CH + 4 + eo) + n);
    store8(G_CH + G_CHN + 1, 0x0A);
    return G_CHN + n;
}

# W2: tls_native_accept over a socketpair, G_CH's first `n` bytes written to the client end first as
# one plaintext handshake record. Returns accept's result; the alert as _w1's, in G_W1.
fn _wire13(n): i64 {
    G_W1 = 0 - 1;
    var fds: i64[1];
    if (sys_socketpair(1, 1, 0, &fds) < 0) { return 0 - 999; }
    var fdp = load64(&fds);
    var sfd = fdp & 0xFFFFFFFF;
    var cfd = (fdp >> 32) & 0xFFFFFFFF;
    tls_native_handshake_write_header(G_CH, TLS_HS_CLIENT_HELLO, n - 4);
    var rec = alloc(1100);
    tls_native_record_write_header(rec, TLS_CT_HANDSHAKE, 0x0303, n);
    memcpy(rec + 5, G_CH, n);
    sys_write(cfd, rec, 5 + n);
    var srv = tls_native_new_server(_h(CERT23), _hn(CERT23), _h(KEY23), _hn(KEY23));
    tls_native_server_load_creds(srv);
    tls_native_set_deadline(srv, clock_now_ns() + 10000000000);
    var rc = tls_native_accept(srv, sfd);
    sys_close(sfd);
    var arec = alloc(16);
    if (_read_n(cfd, arec, 7) != 7) { sys_close(cfd); G_W1 = 0 - 2; return rc; }
    sys_close(cfd);
    if ((load8(arec) & 0xFF) != TLS_CT_ALERT) { G_W1 = 0 - 3; return rc; }
    if ((((load8(arec + 3) & 0xFF) << 8) | (load8(arec + 4) & 0xFF)) != 2) { G_W1 = 0 - 4; return rc; }
    G_W1 = ((load8(arec + 5) & 0xFF) << 8) | (load8(arec + 6) & 0xFF);
    return rc;
}

# Append an extension of type `et` with `el` zero bytes of data to G_CH's block, which ends a
# ClientHello of `n` bytes (header included); the block's length grown to match. The new length.
fn _app(n, et, el): i64 {
    var eo = _ext_off(G_CH + 4);
    _tn_be16_w(G_CH + n, et);
    _tn_be16_w(G_CH + n + 2, el);
    memset(G_CH + n + 4, 0, el);
    _tn_be16_w(G_CH + 4 + eo, _tn_be16_r(G_CH + 4 + eo) + 4 + el);
    return n + 4 + el;
}

# Append a copy of the block's `i`-th extension (0 the first) to its end, as _app. The new length.
fn _dup(n, i): i64 {
    var eo = _ext_off(G_CH + 4);
    var q = 4 + eo + 2;
    while (i > 0) {
        q = q + 4 + _tn_be16_r(G_CH + q + 2);
        i = i - 1;
    }
    var en = 4 + _tn_be16_r(G_CH + q + 2);
    memcpy(G_CH + n, G_CH + q, en);
    _tn_be16_w(G_CH + 4 + eo, _tn_be16_r(G_CH + 4 + eo) + en);
    return n + en;
}

# A fresh G_CH with 40 empty extensions of unassigned types 0x7A00-0x7A27 appended to its block
# (more than 32 entries in all). Its length.
fn _long13(): i64 {
    _ch13();
    var n = G_CHN;
    var i = 0;
    while (i < 40) {
        n = _app(n, 0x7A00 + i, 0);
        i = i + 1;
    }
    return n;
}

# A fresh G_CH whose legacy_compression_methods (the client's [0]) becomes [a] (`b` < 0), [a, b] (the
# rest moved up a byte) or, `a` < 0, the empty list (the rest moved down a byte). Its length.
fn _cm13(a, b): i64 {
    _ch13();
    var n = G_CHN;
    var ce = 4 + _ext_off(G_CH + 4) - 2;              # the list's length byte
    var tmp = alloc(1024);
    if (a < 0) {
        memcpy(tmp, G_CH + ce + 2, n - ce - 2);
        memcpy(G_CH + ce + 1, tmp, n - ce - 2);
        store8(G_CH + ce, 0);
        return n - 1;
    }
    if (b < 0) {
        store8(G_CH + ce + 1, a);
        return n;
    }
    memcpy(tmp, G_CH + ce + 2, n - ce - 2);
    memcpy(G_CH + ce + 3, tmp, n - ce - 2);
    store8(G_CH + ce, 2);
    store8(G_CH + ce + 1, a);
    store8(G_CH + ce + 2, b);
    return n + 1;
}

# The K rows' ClientHello: the groups K_G[0..K_GN) and the shares on K_S[0..K_SN) (a 32-byte x25519
# share — the base point, u = 9 — on TLS_GROUP_X25519, one byte on any other group).
var K_BUF = 0;
var K_G = 0;
var K_GN = 0;
var K_S = 0;
var K_SN = 0;

# K_G := `n` groups, (`base` + i) & 0xFFFF; no shares.
fn _kg_seq(base, n): i64 {
    if (K_G == 0) { K_G = alloc(8 * 4096); K_S = alloc(8 * 2048); K_BUF = alloc(17000); }
    var i = 0;
    while (i < n) {
        store64(K_G + 8 * i, (base + i) & 0xFFFF);
        i = i + 1;
    }
    K_GN = n;
    K_SN = 0;
    return n;
}

fn _ks_add(g): i64 {
    store64(K_S + 8 * K_SN, g);
    K_SN = K_SN + 1;
    return K_SN;
}

# K_G := `n` groups 0x1000 + i, the last replaced by x25519; one share, on x25519.
fn _kg_x25519(n): i64 {
    _kg_seq(0x1000, n);
    store64(K_G + 8 * (n - 1), TLS_GROUP_X25519);
    _ks_add(TLS_GROUP_X25519);
    return n;
}

# Build the K ClientHello in K_BUF (supported_versions [1.3], supported_groups K_G, key_share K_S;
# cipher TLS_AES_256_GCM_SHA384, the null compression method). Its length, header included.
fn _kch(): i64 {
    var p = K_BUF + 4;
    _tn_be16_w(p, 0x0303);
    memset(p + 2, 0x5A, 32);
    store8(p + 34, 0);                                # no legacy_session_id
    _tn_be16_w(p + 35, 2);
    _tn_be16_w(p + 37, TLS_AES_256_GCM_SHA384);
    store8(p + 39, 1);
    store8(p + 40, 0);
    var et = p + 41;
    p = p + 43;
    var e0 = p;
    _tn_be16_w(p, TLS_EXT_SUPPORTED_VERSIONS);
    _tn_be16_w(p + 2, 3);
    store8(p + 4, 2);
    _tn_be16_w(p + 5, 0x0304);
    p = p + 7;
    _tn_be16_w(p, TLS_EXT_SUPPORTED_GROUPS);
    _tn_be16_w(p + 2, 2 + 2 * K_GN);
    _tn_be16_w(p + 4, 2 * K_GN);
    p = p + 6;
    var i = 0;
    while (i < K_GN) {
        _tn_be16_w(p, load64(K_G + 8 * i));
        p = p + 2;
        i = i + 1;
    }
    var kh = p;
    _tn_be16_w(p, TLS_EXT_KEY_SHARE);
    p = p + 6;
    i = 0;
    while (i < K_SN) {
        var g = load64(K_S + 8 * i);
        var kl = 1;
        if (g == TLS_GROUP_X25519) { kl = 32; }
        _tn_be16_w(p, g);
        _tn_be16_w(p + 2, kl);
        memset(p + 4, 0, kl);
        store8(p + 4, 0x09);
        p = p + 4 + kl;
        i = i + 1;
    }
    _tn_be16_w(kh + 2, p - kh - 4);
    _tn_be16_w(kh + 4, p - kh - 6);
    _tn_be16_w(et, p - e0);
    var n = p - K_BUF;
    tls_native_handshake_write_header(K_BUF, TLS_HS_CLIENT_HELLO, n - 4);
    return n;
}

# The 1.3 server's answer to the K ClientHello (`n` bytes); the server in G_CL.
fn _kresp(n): i64 {
    var srv = tls_native_new_server(_h(CERT23), _hn(CERT23), _h(KEY23), _hn(KEY23));
    tls_native_server_load_creds(srv);
    var sh = alloc(1024);
    var r = tls_native_server_respond_hello(srv, K_BUF, n, sh, 1024);
    G_CL = srv;
    return r;
}

# Print a wire row's SKIP: a SKIP is never read as coverage (Windows refuses socketpair).
fn _skip(row): i64 {
    var a = "  SKIP: ";
    var b = " — socketpair refused on this target\n";
    print(a, strlen(a));
    print(row, strlen(row));
    print(b, strlen(b));
    return 0;
}

alloc_init();

test_group("T: the 1.3 server's ClientHello extension block fills the message");
assert_eq(_ch13_trail(0) > 0, 1, "T0: 0 bytes after the block: the ServerHello is written");
assert_eq(_alert(), 0, "T0: no alert recorded");
assert_eq(_ch13_trail(2), TLS_ERR_BAD_HANDSHAKE, "T1: 2 bytes after the block refused");
assert_eq(_alert(), TLS_AD_DECODE_ERROR, "T1: decode_error");
assert_eq(tls_native_get_state(G_CL), TLS_STATE_ERROR, "T1: the ctx failed");
assert_eq(_ch13_trail(1), TLS_ERR_BAD_HANDSHAKE, "T2: 1 byte after the block refused");
assert_eq(_alert(), TLS_AD_DECODE_ERROR, "T2: decode_error");
assert_eq(_ch13_overrun(), TLS_ERR_BAD_HANDSHAKE, "T3: a block claiming 2 bytes more than the message holds refused");
assert_eq(_alert(), TLS_AD_DECODE_ERROR, "T3: decode_error");

test_group("W1: the refusal's alert reaches the wire (tls_native_accept)");
var w = _w1();
if (w == 0 - 999) {
    assert_eq(1, 1, "W1: SKIP — socketpair refused on this target");
    _skip("W1");
} else {
    assert_eq(w, TLS_ERR_BAD_HANDSHAKE, "W1: accept refuses the ClientHello");
    assert_eq(G_W1, (TLS_ALERT_FATAL << 8) | TLS_AD_DECODE_ERROR,
      "W1: the server sent a fatal decode_error, in the clear");
}

test_group("T: a partial entry at the end of the block is decode_error (D81)");
_ch13();
assert_eq(_resp(G_CHN) > 0, 1, "control: the client's own ClientHello is answered");
assert_eq(_alert(), 0, "control: no alert recorded");
var tn = 1;
while (tn <= 3) {
    var tl = _tail13(tn);
    if (tn == 1) { assert_eq(_resp(tl), TLS_ERR_BAD_HANDSHAKE, "T4: a 1-byte tail inside the block refused"); }
    if (tn == 2) { assert_eq(_resp(tl), TLS_ERR_BAD_HANDSHAKE, "T5: a 2-byte tail inside the block refused (row D)"); }
    if (tn == 3) { assert_eq(_resp(tl), TLS_ERR_BAD_HANDSHAKE, "T6: a 3-byte tail inside the block refused"); }
    assert_eq(_alert(), TLS_AD_DECODE_ERROR, "  ... decode_error");
    assert_eq(tls_native_get_state(G_CL), TLS_STATE_ERROR, "  ... the ctx failed");
    tn = tn + 1;
}

test_group("W2: T5's refusal reaches the wire (tls_native_accept)");
w = _wire13(_tail13(2));
if (w == 0 - 999) {
    assert_eq(1, 1, "W2: SKIP — socketpair refused on this target");
    _skip("W2");
} else {
    assert_eq(w, TLS_ERR_BAD_HANDSHAKE, "W2: accept refuses the ClientHello");
    assert_eq(G_W1, (TLS_ALERT_FATAL << 8) | TLS_AD_DECODE_ERROR,
      "W2: the server sent a fatal decode_error, in the clear");
}

test_group("G: an extension type named twice is illegal_parameter (D82)");
var gl = 0;
var gn = 1;
var nm = 0;
while (gn <= 7) {
    if (gn == 1) { _ch13(); gl = _dup(G_CHN, 0); nm = "G1: server_name twice (row G)"; }
    if (gn == 2) { _ch13(); gl = _dup(G_CHN, 1); nm = "G2: supported_versions twice, the second appended"; }
    if (gn == 3) { _ch13(); gl = _dup(G_CHN, 4); nm = "G3: key_share twice, side by side"; }
    if (gn == 4) { gl = _long13(); nm = "G4: 45 entries, no type twice: answered"; }
    if (gn == 5) { gl = _app(_long13(), 0x7A27, 0); nm = "G5: 46 entries, the last type twice"; }
    if (gn == 6) { gl = _app(_app(_long13(), 0xFFFF, 0), 0xFFFF, 1); nm = "G6: 47 entries, type 0xFFFF twice"; }
    if (gn == 7) {
        _ch13();
        gl = _dup(G_CHN, 0);
        var e7 = _ext_off(G_CH + 4);
        _tn_be16_w(G_CH + 4 + e7, _tn_be16_r(G_CH + 4 + e7) + 2);
        gl = gl + 2;
        nm = "G7: server_name twice and a 2-byte tail inside the block";
    }
    if (gn == 4) {
        assert_eq(_resp(gl) > 0, 1, nm);
        assert_eq(_alert(), 0, "  ... no alert recorded");
    } else {
        if (gn == 7) {
            assert_eq(_resp(gl), TLS_ERR_BAD_HANDSHAKE, nm);
            assert_eq(_alert(), TLS_AD_DECODE_ERROR, "  ... decode_error: framing is refused first");
        } else {
            assert_eq(_resp(gl), TLS_ERR_HANDSHAKE_FAILED, nm);
            assert_eq(_alert(), TLS_AD_ILLEGAL_PARAMETER, "  ... illegal_parameter");
        }
        assert_eq(tls_native_get_state(G_CL), TLS_STATE_ERROR, "  ... the ctx failed");
    }
    gn = gn + 1;
}

test_group("W3: G1's refusal reaches the wire (tls_native_accept)");
_ch13();
w = _wire13(_dup(G_CHN, 0));
if (w == 0 - 999) {
    assert_eq(1, 1, "W3: SKIP — socketpair refused on this target");
    _skip("W3");
} else {
    assert_eq(w, TLS_ERR_HANDSHAKE_FAILED, "W3: accept refuses server_name twice");
    assert_eq(G_W1, (TLS_ALERT_FATAL << 8) | TLS_AD_ILLEGAL_PARAMETER,
      "W3: the server sent a fatal illegal_parameter, in the clear");
}

test_group("E: legacy_compression_methods other than the one null method is illegal_parameter (D83)");
var en = 1;
while (en <= 5) {
    if (en == 1) { gl = _cm13(1, 0 - 1); nm = "E1: [1] (row E)"; }
    if (en == 2) { gl = _cm13(0, 0); nm = "E2: [0, 0]"; }
    if (en == 3) { gl = _cm13(1, 0); nm = "E3: [1, 0]"; }
    if (en == 4) { gl = _cm13(0 - 1, 0); nm = "E4: an empty list"; }
    if (en == 5) {
        gl = _cm13(1, 0 - 1);
        var e5 = _ext_off(G_CH + 4);
        _tn_be16_w(G_CH + 4 + e5, _tn_be16_r(G_CH + 4 + e5) + 2);
        gl = gl + 2;
        nm = "E5: [1] and a 2-byte tail inside the block";
    }
    if (en >= 4) {
        assert_eq(_resp(gl), TLS_ERR_BAD_HANDSHAKE, nm);
        assert_eq(_alert(), TLS_AD_DECODE_ERROR, "  ... decode_error: it does not parse");
    } else {
        assert_eq(_resp(gl), TLS_ERR_HANDSHAKE_FAILED, nm);
        assert_eq(_alert(), TLS_AD_ILLEGAL_PARAMETER, "  ... illegal_parameter");
    }
    assert_eq(tls_native_get_state(G_CL), TLS_STATE_ERROR, "  ... the ctx failed");
    en = en + 1;
}

test_group("W4: E1's refusal reaches the wire (tls_native_accept)");
w = _wire13(_cm13(1, 0 - 1));
if (w == 0 - 999) {
    assert_eq(1, 1, "W4: SKIP — socketpair refused on this target");
    _skip("W4");
} else {
    assert_eq(w, TLS_ERR_HANDSHAKE_FAILED, "W4: accept refuses [1]");
    assert_eq(G_W1, (TLS_ALERT_FATAL << 8) | TLS_AD_ILLEGAL_PARAMETER,
      "W4: the server sent a fatal illegal_parameter, in the clear");
}

test_group("K: each key_share's group looked up in the validated supported_groups (CYRIUS-2026-0037)");
var kn = 1;
var kl = 0;
while (kn <= 8) {
    if (kn == 1) {
        _kg_seq(0x1000, 4025);
        var ki = 0;
        while (ki < 1610) { _ks_add(0x1000 + 4025 - 1610 + ki); ki = ki + 1; }
        nm = "K1: 4,025 groups, 1,610 one-byte shares on the last, none of ours";
    }
    if (kn == 2) {
        _kg_seq(0x1000, 40);
        _ks_add(0x1000);
        _ks_add(0x2000);
        nm = "K2: 40 groups, a share for one not on them";
    }
    if (kn == 3) { _kg_x25519(40); nm = "K3: 40 groups ending in x25519, an x25519 share"; }
    if (kn == 4) {
        _kg_seq(0x1000, 32);
        _ks_add(0x2000);
        nm = "K4: 32 groups (no bitmap), a share for one not on them";
    }
    if (kn == 5) { _kg_x25519(32); nm = "K5: 32 groups ending in x25519, an x25519 share"; }
    if (kn == 6) { _kg_x25519(33); nm = "K6: 33 groups (the first bitmap) ending in x25519, an x25519 share"; }
    if (kn == 7) {
        _kg_seq(0xFFE0, 40);
        store64(K_G + 8 * 39, TLS_GROUP_X25519);
        _ks_add(0xFFFF);
        _ks_add(0);
        _ks_add(TLS_GROUP_X25519);
        nm = "K7: shares on 0xFFFF and 0x0000 (the bitmap's last and first bits), then x25519";
    }
    if (kn == 8) {
        _kg_seq(0xFFE0, 40);
        store64(K_G + 8 * 39, TLS_GROUP_X25519);
        _ks_add(0xFFFF);
        _ks_add(7);
        nm = "K8: a share on 0x0007, not listed (0x0000-0x0006 are, the same byte)";
    }
    kl = _kch();
    if (kn == 1) { assert_eq(kl, 16166, "K1: the ClientHello is 16,166 bytes"); }
    var kr = _kresp(kl);
    if (kn == 1) {
        assert_eq(kr, TLS_ERR_HANDSHAKE_FAILED, nm);
        assert_eq(_alert(), TLS_AD_HANDSHAKE_FAILURE, "  ... handshake_failure: no shared group");
        assert_eq(tls_native_get_state(G_CL), TLS_STATE_ERROR, "  ... the ctx failed");
    }
    if (kn == 2 || kn == 4 || kn == 8) {
        assert_eq(kr, TLS_ERR_HANDSHAKE_FAILED, nm);
        assert_eq(_alert(), TLS_AD_ILLEGAL_PARAMETER, "  ... illegal_parameter");
        assert_eq(tls_native_get_state(G_CL), TLS_STATE_ERROR, "  ... the ctx failed");
    }
    if (kn == 3 || kn == 5 || kn == 6 || kn == 7) {
        assert_eq(kr > 0, 1, nm);
        assert_eq(_alert(), 0, "  ... no alert recorded");
        assert_eq(tls_native_get_group(G_CL), TLS_GROUP_X25519, "  ... on x25519");
    }
    kn = kn + 1;
}

var r = assert_summary();
