# tls_libssl_read_errors.tcyr — 6.6.13 (CYRIUS-2026-0016): the libssl backend's tls_read / tls_write
# return the native backend's codes, and never a zero-extended C int.
#
# ⛔ THE DEFECT. lib/tls.cyr's libssl branch returned SSL_read / SSL_write's raw `int`. fncall3 hands
# the whole register back and the int sits in it ZERO-extended, so SSL_read's -1 arrived as
# +4294967295: one bit flipped on the path (no key needed) made tls_read report ~4 GiB read, and a
# caller doing `total = total + n` indexed past its buffer. tls_write had the same return. And
# SSL_read's 0 is not only close_notify: a received fatal alert and a stream cut mid-record read 0
# too, so an attacked stream looked like a clean end. Now _tls_ssl_io_ret sign-extends the int and
# maps SSL_get_error + libcrypto's error queue to: > 0 bytes, 0 close_notify, TLS_ERR_WOULD_BLOCK,
# TLS_ERR_IO (socket error / EOF with no close_notify), TLS_ERR_ALERT (a received alert),
# TLS_ERR_PROTOCOL (any other libssl failure, a bad record MAC included).
#
# 6.6.14 — and a failed connection STAYS failed (CYRIUS-2026-0016's "Not covered"): after a fatal alert a
# second SSL_read reported SSL_ERROR_ZERO_RETURN (OpenSSL sets RECEIVED_SHUTDOWN, warn_alert 0 =
# close_notify), so the re-read was 0 — a clean end — where native keeps TLS_ERR_ALERT. The shim
# now keeps the first failure at +32: every later tls_read returns it, every later tls_write
# returns TLS_ERR_PROTOCOL (native's rule), neither calls SSL — counted here by spies interposed
# on the resolved SSL_read / SSL_write / SSL_shutdown pointers — and tls_close skips SSL_shutdown.
# Every row runs twice per protocol version: as is, and with a deadline set (tls_set_deadline), since
# a deadline routes tls_read / tls_write through their own branch (_tls_ssl_io, CYRIUS-2026-0017's loop) and
# the stored error must hold there too.
#
# 6.6.16 — and a failed HANDSHAKE stays failed. tls_connect_complete / tls_accept_complete returned 0
# and recorded nothing, and the deadline loop threw the failure's code away, so a later tls_read
# called SSL_read and OpenSSL's implicit handshake RESUMED the handshake: after a complete that
# failed on a non-blocking socket, tls_read returned the server's 21 bytes on a connection the
# caller had been told had failed (measured). Now the failure is kept at +32 like a failed read's
# (_tls_libssl_complete_fail): tls_read returns it, tls_write TLS_ERR_PROTOCOL, a second complete 0,
# none of them calls SSL (spies on SSL_connect / SSL_accept as well), and tls_close sends no
# SSL_shutdown. The rows (test_libssl_complete_final): a non-blocking socket with a delayed server;
# a deadline already passed, then cleared; a deadline that passes mid-handshake, then cleared;
# verification against the untrusted server; a libssl SERVER whose peer sends garbage — the last
# two with and without a deadline. Each server sends data once its handshake completes, so a
# re-driven handshake would hand that data to tls_read.
# MUTATION LEDGER (measured 6.6.16, x86_64 Linux, OpenSSL 3.6.5):
#   the 6.6.15 lib/ (slot open)                          -> 82 RED (reads "late-data", calls SSL_read,
#                                                           a second complete SUCCEEDS)
#   the store in _tls_libssl_complete_fail deleted       -> 72 RED
#   the up-front +32 refusal in _tls_libssl_complete gone -> 26 RED (the second complete re-drives,
#                                                           and on the late-server rows completes)
#   _tls_ssl_io collapsing CONNECT / ACCEPT to 1 / 0 again -> 16 RED (the deadline rows record
#                                                           HANDSHAKE_FAILED, not TIMEOUT / PROTOCOL)
#   the ERR_clear_error before the no-deadline handshake -> GREEN: OpenSSL 3.6.5's handshake state
#     machine clears the queue on entry, so the planted stale error cannot decide it there. Kept
#     for parity with tls_read / tls_write; the planted-error row still proves the outcome.
#
# A libssl-backend client (this process) against a forked native server that misbehaves on cue.
# A named SKIP when libssl.so.3 or the fdlopen helper is missing. SIGPIPE is ignored here: the
# tls_write row writes to a closed peer on purpose, and libssl's own SIGPIPE exposure is a separate
# backlog item, not this test's subject.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/io.cyr"
include "lib/net.cyr"
include "lib/chrono.cyr"
include "lib/tls.cyr"

#ifdef CYRIUS_TARGET_AGNOS
var _agnos_skip = "  SKIP (agnos): libssl is a Linux fdlopen bridge, and this is a socketpair + fork run\n";
sys_write(1, _agnos_skip, strlen(_agnos_skip));
#endif
#ifndef CYRIUS_TARGET_AGNOS

enum LibsslReadErr {
    LR_TIMEOUT_S = 10;
    LR_MAXLEN = 64;
}

# What the native server does after it reads the client's "g".
enum LibsslScript {
    LS_FATAL_ALERT = 1;      # sealed fatal bad_record_mac, then a sealed "late" record
    LS_CLOSE_NOTIFY = 2;     # sealed warning close_notify, then a sealed "late" record
    LS_BITFLIP = 3;          # a sealed "hello" with one ciphertext bit flipped
    LS_TRUNCATED = 4;        # a sealed "hello" short its last 3 bytes, then FIN
    LS_FIN = 5;              # FIN, no close_notify
    LS_CLOSE = 6;            # close the socket outright (the tls_write row)
}

var _lr_cert = 0;              # DER, self-signed P-256, CN = SAN DNS = localhost
var _lr_cert_len = 406;
var _lr_key = 0;
var _lr_key_len = 138;
var _lr_ver12 = 0;
var _lr_deadline = 0;          # 1 = every row's connection has a deadline 5 s out
var _lr_dl_rc = 0 - 99;        # what tls_set_deadline answered on the last row

fn _lr_write_all(fd, buf, n): i64 {
    var off = 0;
    while (off < n) {
        var w = sys_write(fd, buf + off, n - off);
        if (w <= 0) { return 0 - 1; }
        off = off + w;
    }
    return n;
}

fn _lr_hold(fd): i64 {
    var drain[64];
    while (sys_read(fd, &drain, 64) > 0) { }
    return 0;
}

# The forked native server. Exit 0 / the step that failed.
fn _lr_serve(sfd, script): i64 {
    var srv = tls_native_new_server(_lr_cert, _lr_cert_len, _lr_key, _lr_key_len);
    if (tls_native_server_load_creds(srv) != TLS_OK) { return 2; }
    if (_lr_ver12 == 1) { tls_native_set_version_range(srv, TLS_VERSION_1_2, TLS_VERSION_1_2); }
    if (tls_native_accept(srv, sfd) != TLS_OK) { return 3; }
    var g[8];
    if (tls_native_read(srv, &g, 1) != 1) { return 4; }   # the client's "go"
    var rec[128];
    var al[2];
    if (script == LS_FATAL_ALERT) {
        store8(&al, TLS_ALERT_FATAL);
        store8(&al + 1, TLS_AD_BAD_RECORD_MAC);
    } else {
        store8(&al, TLS_ALERT_WARNING);
        store8(&al + 1, TLS_AD_CLOSE_NOTIFY);
    }
    if (script <= LS_CLOSE_NOTIFY) {
        # The alert and the "late" record go out in ONE write: written apart, the client could read
        # the alert, fail and close before the second write, which then failed (child exit 6) —
        # 12 to 18 of 60 runs under load, the race 6.6.14 closed in tls_native_alert_mapping.tcyr.
        var an = _tn_seal_ct(srv, TLS_CT_ALERT, &al, 2, &rec, 128);
        if (an <= 0) { return 5; }
        var ln = tls_native_seal_app(srv, "late", 4, &rec + an, 128 - an);
        if (ln <= 0) { return 6; }
        if (_lr_write_all(sfd, &rec, an + ln) != an + ln) { return 5; }
    }
    if (script == LS_BITFLIP) {
        var bn = tls_native_seal_app(srv, "hello", 5, &rec, 128);
        store8(&rec + 8, load8(&rec + 8) ^ 1);
        if (_lr_write_all(sfd, &rec, bn) != bn) { return 7; }
    }
    if (script == LS_TRUNCATED) {
        var tn = tls_native_seal_app(srv, "hello", 5, &rec, 128);
        if (_lr_write_all(sfd, &rec, tn - 3) != tn - 3) { return 8; }
        sock_shutdown(sfd, 1);
    }
    if (script == LS_FIN) { sock_shutdown(sfd, 1); }
    if (script == LS_CLOSE) {
        sys_close(sfd);
        return 0;
    }
    _lr_hold(sfd);                 # keep the read side open: the client may answer with an alert
    return 0;
}

fn _lr_noverify(hctx, handle): i64 {
    tls_set_verify(handle, 0, 0);
    return 0;
}

# [r1, r2, write after, child status, connected, would-block read, stale errors planted,
#  r3, SSL_read + SSL_write calls after the first failure, SSL_shutdown calls in tls_close,
#  a second write (the closed-peer row), a read after the failed write (the closed-peer row)]
var _lr_obs: i64[12];

# Spies on the resolved libssl pointers: count the calls, then make the real one.
var _lr_real_read = 0;
var _lr_real_write = 0;
var _lr_real_shutdown = 0;
var _lr_n_io = 0;
var _lr_n_shut = 0;
fn _lr_spy_read(ssl, buf, n): i64 {
    _lr_n_io = _lr_n_io + 1;
    return fncall3(_lr_real_read, ssl, buf, n);
}
fn _lr_spy_write(ssl, buf, n): i64 {
    _lr_n_io = _lr_n_io + 1;
    return fncall3(_lr_real_write, ssl, buf, n);
}
fn _lr_spy_shutdown(ssl): i64 {
    _lr_n_shut = _lr_n_shut + 1;
    return fncall1(_lr_real_shutdown, ssl);
}
# 6.6.16: the handshake calls, counted the same way (SSL_connect + SSL_accept).
var _lr_real_connect = 0;
var _lr_real_accept = 0;
var _lr_n_hs = 0;
fn _lr_spy_connect(ssl): i64 {
    _lr_n_hs = _lr_n_hs + 1;
    return fncall1(_lr_real_connect, ssl);
}
fn _lr_spy_accept(ssl): i64 {
    _lr_n_hs = _lr_n_hs + 1;
    return fncall1(_lr_real_accept, ssl);
}
fn _lr_install_spies(): i64 {
    _lr_real_read = _fn_SSL_read;
    _lr_real_write = _fn_SSL_write;
    _lr_real_shutdown = _fn_SSL_shutdown;
    _fn_SSL_read = &_lr_spy_read;
    _fn_SSL_write = &_lr_spy_write;
    _fn_SSL_shutdown = &_lr_spy_shutdown;
    _lr_real_connect = _fn_SSL_connect;
    _fn_SSL_connect = &_lr_spy_connect;
    _lr_real_accept = _fn_SSL_accept;
    if (_lr_real_accept != 0) { _fn_SSL_accept = &_lr_spy_accept; }   # a client-only libssl keeps 0
    return 0;
}

# Leave a libcrypto error queued on this thread, as any earlier failed libssl call does — here one
# that reads as a received handshake_failure alert (lib SSL, reason 1000 + 40), pushed with
# ERR_new + ERR_vset_error (the non-variadic setter; fmt 0 leaves the va_list untouched).
# SSL_get_error and _tls_ssl_io_ret both read the queue, so tls_read / tls_write must clear it
# first or this stale entry decides their answer. Returns 1 when it is queued (anti-vacuity).
var _lr_err_new = 0;
var _lr_err_vset = 0;
var _lr_err_peek = 0;
fn _lr_plant_stale(): i64 {
    if (_lr_err_new == 0) { _lr_err_new = tls_dlsym("ERR_new"); }
    if (_lr_err_vset == 0) { _lr_err_vset = tls_dlsym("ERR_vset_error"); }
    if (_lr_err_peek == 0) { _lr_err_peek = tls_dlsym("ERR_peek_last_error"); }
    if (_lr_err_new == 0) { return 0; }
    if (_lr_err_vset == 0) { return 0; }
    if (_lr_err_peek == 0) { return 0; }
    fncall0(_lr_err_new);
    fncall4(_lr_err_vset, 20, 1040, 0, 0);
    if ((fncall0(_lr_err_peek) & 0x7FFFFF) != 1040) { return 0; }
    return 1;
}

fn _lr_row(script): i64 {
    var i = 0;
    while (i < 12) { _lr_obs[i] = 0 - 99; i = i + 1; }
    var fds[8];
    sys_socketpair(1, 1, 0, &fds);
    var fdp = load64(&fds);
    var sfd = fdp & 0xFFFFFFFF;
    var cfd = (fdp >> 32) & 0xFFFFFFFF;
    var pid = sys_fork();
    if (pid == 0) {
        sys_close(cfd);
        sys_exit(_lr_serve(sfd, script));
    }
    sys_close(sfd);
    sock_set_recv_timeout(cfd, LR_TIMEOUT_S, 0);
    var c = tls_connect_with_ctx_hook(cfd, "localhost", &_lr_noverify, 0);
    _lr_obs[4] = 0;
    if (c != 0) {
        _lr_obs[4] = 1;
        var b[64];
        # Nothing has been sent yet: a non-blocking read must say WOULD_BLOCK, not 4294967295.
        var saved = fd_set_nonblocking(cfd);
        _lr_obs[6] = _lr_plant_stale();
        _lr_obs[5] = tls_read(c, &b, LR_MAXLEN);
        fd_restore_flags(cfd, saved);
        # After the would-block row: under a deadline the loop waits where libssl would block.
        if (_lr_deadline == 1) { _lr_dl_rc = tls_set_deadline(c, clock_now_ns() + 5000000000); }
        if (tls_write(c, "g", 1) == 1) {
            if (script == LS_CLOSE) {
                var st0[4];
                sys_waitpid(pid, &st0, 0);       # the server has read "g" and closed
                _lr_obs[3] = load64(&st0) & 0xFFFF;
                pid = 0;
                _lr_obs[6] = _lr_obs[6] + _lr_plant_stale();
                _lr_obs[2] = tls_write(c, "x", 1);
                var w0 = _lr_n_io;
                _lr_obs[10] = tls_write(c, "y", 1);
                _lr_obs[11] = tls_read(c, &b, LR_MAXLEN);
                _lr_obs[8] = _lr_n_io - w0;
            } else {
                _lr_obs[0] = tls_read(c, &b, LR_MAXLEN);
                var n0 = _lr_n_io;
                _lr_obs[1] = tls_read(c, &b, LR_MAXLEN);
                _lr_obs[7] = tls_read(c, &b, LR_MAXLEN);
                _lr_obs[6] = _lr_obs[6] + _lr_plant_stale();
                _lr_obs[2] = tls_write(c, "x", 1);
                _lr_obs[8] = _lr_n_io - n0;
            }
        }
        var s0 = _lr_n_shut;
        tls_close(c);
        _lr_obs[9] = _lr_n_shut - s0;
    }
    sys_close(cfd);
    if (pid != 0) {
        var st[4];
        sys_waitpid(pid, &st, 0);
        _lr_obs[3] = load64(&st) & 0xFFFF;
    }
    return 0;
}

fn _lr_v(): i64 {
    if (_lr_ver12 == 1) { syscall(1, 1, "  (TLS 1.2", 10); } else { syscall(1, 1, "  (TLS 1.3", 10); }
    if (_lr_deadline == 1) { println(", under a deadline: _tls_ssl_io)"); return 0; }
    println(")");
    return 0;
}

fn test_libssl_reads(): i64 {
    test_group("tls_read / tls_write on the libssl backend: the native backend's codes");
    _lr_v();
    _lr_dl_rc = 0 - 99;
    _lr_row(LS_FATAL_ALERT);
    assert_eq(_lr_obs[4], 1, "the handshake completes");
    if (_lr_deadline == 1) { assert_eq(_lr_dl_rc, 0, "the deadline is set on the connection (tls_set_deadline -> 0)"); }
    assert_eq(_lr_obs[6], 2,
      "a stale libcrypto error (a handshake_failure alert) is queued before the read and the write");
    assert_eq(_lr_obs[5], TLS_ERR_WOULD_BLOCK,
      "a read with nothing to read on a non-blocking socket: TLS_ERR_WOULD_BLOCK, not the stale error");
    assert_eq(_lr_obs[0], TLS_ERR_ALERT, "a sealed fatal alert: TLS_ERR_ALERT (was 0, a clean EOF)");
    # libssl itself answers a read after a fatal alert with SSL_ERROR_ZERO_RETURN (it sets
    # RECEIVED_SHUTDOWN and leaves warn_alert at 0 = close_notify): the re-read was 0 until 6.6.14.
    assert_eq(_lr_obs[1], TLS_ERR_ALERT, "a re-read stays TLS_ERR_ALERT, as on native (was 0, a clean EOF)");
    assert_eq(_lr_obs[7], TLS_ERR_ALERT, "and the next one");
    assert_eq(_lr_obs[2], TLS_ERR_PROTOCOL,
      "tls_write after the fatal alert: TLS_ERR_PROTOCOL (was +4294967295; never 0)");
    assert_eq(_lr_obs[8], 0, "none of them called SSL_read / SSL_write");
    assert_eq(_lr_obs[9], 0, "tls_close sent no SSL_shutdown on the failed connection");
    assert_eq(_lr_obs[3], 0, "the server sent the row (child exit 0)");

    _lr_row(LS_CLOSE_NOTIFY);
    assert_eq(_lr_obs[0], 0, "close_notify: 0");
    assert_eq(_lr_obs[1], 0, "re-read with an app record behind it on the wire: still 0");
    assert_eq(_lr_obs[7], 0, "and again: close_notify is an end, not a failure");
    assert_eq(_lr_obs[2], 1, "tls_write after the peer's close_notify: libssl still sends (half-close)");
    assert_eq(_lr_obs[9], 1, "a connection that did not fail gets its SSL_shutdown");
    assert_eq(_lr_obs[3], 0, "the server sent the row (child exit 0)");

    _lr_row(LS_BITFLIP);
    assert_lt(_lr_obs[0], 0, "a tampered record: negative (was +4294967295)");
    assert_lte(_lr_obs[0], LR_MAXLEN, "never more than maxlen");
    assert_eq(_lr_obs[0], TLS_ERR_PROTOCOL, "TLS_ERR_PROTOCOL");
    assert_eq(_lr_obs[1], TLS_ERR_PROTOCOL, "the re-read stays TLS_ERR_PROTOCOL");
    assert_eq(_lr_obs[2], TLS_ERR_PROTOCOL, "a write after it: TLS_ERR_PROTOCOL");
    assert_eq(_lr_obs[8], 0, "without calling SSL_read / SSL_write");
    assert_eq(_lr_obs[9], 0, "and no SSL_shutdown at tls_close");
    assert_eq(_lr_obs[3], 0, "the server sent the row (child exit 0)");

    _lr_row(LS_TRUNCATED);
    assert_eq(_lr_obs[0], TLS_ERR_IO, "a record cut short, then FIN: TLS_ERR_IO (was 0, a clean EOF)");
    assert_eq(_lr_obs[1], TLS_ERR_IO, "the re-read stays TLS_ERR_IO");
    assert_eq(_lr_obs[8], 0, "without calling SSL_read / SSL_write");

    _lr_row(LS_FIN);
    assert_eq(_lr_obs[0], TLS_ERR_IO, "FIN with no close_notify: TLS_ERR_IO (was 0, a clean EOF)");
    assert_eq(_lr_obs[1], TLS_ERR_IO, "the re-read stays TLS_ERR_IO");
    assert_eq(_lr_obs[2], TLS_ERR_PROTOCOL, "a write after it: TLS_ERR_PROTOCOL");
    assert_eq(_lr_obs[8], 0, "without calling SSL_read / SSL_write");
    assert_eq(_lr_obs[9], 0, "and no SSL_shutdown at tls_close");

    _lr_row(LS_CLOSE);
    assert_eq(_lr_obs[3], 0, "the server read \"g\" and closed (child exit 0)");
    assert_eq(_lr_obs[6], 2, "stale libcrypto errors are queued before the read and the write");
    assert_eq(_lr_obs[2], TLS_ERR_IO, "tls_write to a closed peer: TLS_ERR_IO (was +4294967295)");
    assert_eq(_lr_obs[10], TLS_ERR_PROTOCOL, "the next write: TLS_ERR_PROTOCOL, the connection has failed");
    assert_eq(_lr_obs[11], TLS_ERR_IO, "a read after the failed write: the code that failed it");
    assert_eq(_lr_obs[8], 0, "neither called SSL_write / SSL_read");
    assert_eq(_lr_obs[9], 0, "and no SSL_shutdown at tls_close (it would write to the closed peer)");
    return 0;
}

# ---- 6.6.16: a failed *_complete is final -------------------------------------------------------

# The complete rows (_lc_row).
enum LibsslComplete {
    LC_NONBLOCK = 1;         # client: a non-blocking socket, the server 300 ms late
    LC_DL_PASSED = 2;        # client: a deadline already passed, cleared after the complete
    LC_DL_MIDWAY = 3;        # client: a 100 ms deadline, the server 600 ms late; then cleared
    LC_VERIFY = 4;           # client: verification on, the server's self-signed leaf untrusted
    LC_SERVER_GARBAGE = 5;   # libssl SERVER: the peer sends an HTTP request, not a ClientHello
}

# [built, complete, SSL_connect / SSL_accept calls in it, +32 after it, tls_read, the read buffer
#  untouched, tls_write, SSL_read + SSL_write calls in the two, a second complete, handshake calls
#  in it, SSL_shutdown calls in tls_close, the peer's wait status, stale error planted, the
#  tls_set_deadline answers (summed)]
var _lc_obs: i64[16];

# The client rows' native server: after `delay_ms`, accept, send "late-data" — what a re-driven
# handshake would hand to tls_read — and hold the socket until the client closes it. Exit 0, or the
# step that failed: 3 (the handshake never completed) is every row's outcome once the client
# refuses to finish it.
fn _lc_serve(sfd, delay_ms): i64 {
    if (delay_ms > 0) { sleep_ms(delay_ms); }
    var srv = tls_native_new_server(_lr_cert, _lr_cert_len, _lr_key, _lr_key_len);
    if (tls_native_server_load_creds(srv) != TLS_OK) { return 2; }
    if (_lr_ver12 == 1) { tls_native_set_version_range(srv, TLS_VERSION_1_2, TLS_VERSION_1_2); }
    if (tls_native_accept(srv, sfd) != TLS_OK) { return 3; }
    if (tls_native_write(srv, "late-data", 9) != 9) { return 4; }
    _lr_hold(sfd);
    return 0;
}

# The server row's peer: an HTTP request where a ClientHello belongs, then hold until EOF.
fn _lc_garbage(fd): i64 {
    var req = "GET / HTTP/1.0\r\n\r\n";
    if (_lr_write_all(fd, req, strlen(req)) < 0) { return 2; }
    _lr_hold(fd);
    return 0;
}

# The ctx under test: a libssl server for LC_SERVER_GARBAGE, else a libssl client (verifying for
# LC_VERIFY, not verifying otherwise).
fn _lc_alloc(kind, fd): i64 {
    if (kind == LC_SERVER_GARBAGE) {
        var creds: i64[4];
        creds[0] = _lr_cert;
        creds[1] = _lr_cert_len;
        creds[2] = _lr_key;
        creds[3] = _lr_key_len;
        return tls_accept_alloc(fd, &creds, 0, 0);
    }
    if (kind == LC_VERIFY) { return tls_connect_alloc(fd, "localhost", 0, 0); }   # the default: verify
    return tls_connect_alloc(fd, "localhost", &_lr_noverify, 0);
}

fn _lc_complete(kind, c): i64 {
    if (kind == LC_SERVER_GARBAGE) { return tls_accept_complete(c); }
    return tls_connect_complete(c);
}

# One row: build the ctx, fail its handshake, then try everything a caller might do next.
# `dl` = 1 puts a 5 s deadline on the connection (the _tls_ssl_io branch).
fn _lc_row(kind, dl): i64 {
    var i = 0;
    while (i < 16) { _lc_obs[i] = 0 - 99; i = i + 1; }
    var fds[8];
    sys_socketpair(1, 1, 0, &fds);
    var fdp = load64(&fds);
    var kfd = fdp & 0xFFFFFFFF;            # the child's end
    var cfd = (fdp >> 32) & 0xFFFFFFFF;    # this process's end
    var delay = 0;
    if (kind == LC_NONBLOCK) { delay = 300; }
    if (kind == LC_DL_MIDWAY) { delay = 600; }
    var pid = sys_fork();
    if (pid == 0) {
        sys_close(cfd);
        if (kind == LC_SERVER_GARBAGE) { sys_exit(_lc_garbage(kfd)); }
        sys_exit(_lc_serve(kfd, delay));
    }
    sys_close(kfd);
    sock_set_recv_timeout(cfd, LR_TIMEOUT_S, 0);
    var c = _lc_alloc(kind, cfd);
    _lc_obs[0] = 0;
    if (c != 0) {
        _lc_obs[0] = 1;
        _lc_obs[13] = 0;
        # 1 ns after the monotonic clock's epoch: long past.
        if (kind == LC_DL_PASSED) { _lc_obs[13] = tls_set_deadline(c, 1); }
        if (kind == LC_DL_MIDWAY) { _lc_obs[13] = tls_set_deadline(c, clock_now_ns() + 100000000); }
        if (dl == 1) { _lc_obs[13] = tls_set_deadline(c, clock_now_ns() + 5000000000); }
        var saved = 0 - 1;
        if (kind == LC_NONBLOCK) { saved = fd_set_nonblocking(cfd); }
        _lc_obs[12] = _lr_plant_stale();
        var h0 = _lr_n_hs;
        _lc_obs[1] = _lc_complete(kind, c);
        _lc_obs[2] = _lr_n_hs - h0;
        if (saved >= 0) { fd_restore_flags(cfd, saved); }
        _lc_obs[3] = load64(c + _TLS_SHIM_OFF_ERR);
        # With the deadline cleared, what is left is a blocking socket on which SSL_read WOULD finish
        # the handshake — the server is answering — unless the failure is final.
        if (kind == LC_DL_PASSED || kind == LC_DL_MIDWAY) {
            _lc_obs[13] = _lc_obs[13] + tls_set_deadline(c, 0);
        }
        var b[64];
        memset(&b, 0x5A, 64);
        var n0 = _lr_n_io;
        _lc_obs[4] = tls_read(c, &b, LR_MAXLEN);
        _lc_obs[5] = 0;
        if (load8(&b) == 0x5A) { _lc_obs[5] = 1; }
        _lc_obs[6] = tls_write(c, "x", 1);
        _lc_obs[7] = _lr_n_io - n0;
        var h1 = _lr_n_hs;
        _lc_obs[8] = _lc_complete(kind, c);
        _lc_obs[9] = _lr_n_hs - h1;
        var s0 = _lr_n_shut;
        tls_close(c);
        _lc_obs[10] = _lr_n_shut - s0;
    }
    sys_close(cfd);
    var st[4];
    sys_waitpid(pid, &st, 0);
    _lc_obs[11] = load64(&st) & 0xFFFF;
    return 0;
}

# What every failed row must show after its complete: `code` kept and returned, nothing re-driven.
# `peer` is the child's expected wait status (768 = exit 3: its handshake never completed).
fn _lc_final(code, peer): i64 {
    assert_eq(_lc_obs[13], 0, "  every tls_set_deadline on the row -> 0");
    assert_eq(_lc_obs[1], 0, "  the complete -> 0");
    assert_eq(_lc_obs[3], code, "  ... and it recorded its failure at +32 (6.6.15: nothing)");
    assert_eq(_lc_obs[4], code,
      "  tls_read -> the recorded code (6.6.15: SSL_read re-drove the handshake and read the server's data)");
    assert_eq(_lc_obs[5], 1, "  nothing was read into the caller's buffer");
    assert_eq(_lc_obs[6], TLS_ERR_PROTOCOL, "  tls_write -> TLS_ERR_PROTOCOL");
    assert_eq(_lc_obs[7], 0, "  neither called SSL_read / SSL_write");
    assert_eq(_lc_obs[8], 0, "  a second complete -> 0");
    assert_eq(_lc_obs[9], 0, "  ... without calling SSL_connect / SSL_accept again");
    assert_eq(_lc_obs[10], 0, "  tls_close sent no SSL_shutdown");
    assert_eq(_lc_obs[11], peer, "  the peer saw no completed handshake (its wait status)");
    return 0;
}

fn test_libssl_complete_final(): i64 {
    test_group("a failed tls_connect_complete / tls_accept_complete is FINAL on the libssl backend");
    _lr_v();
    _lc_row(LC_NONBLOCK, 0);
    println("  a non-blocking socket, the server 300 ms late:");
    assert_eq(_lc_obs[0], 1, "  the connection is built");
    assert_eq(_lc_obs[12], 1, "  a stale libcrypto error is queued before the complete");
    assert_gte(_lc_obs[2], 1, "  the complete ran SSL_connect");
    _lc_final(TLS_ERR_HANDSHAKE_FAILED, 768);

    _lc_row(LC_DL_PASSED, 0);
    println("  a deadline already passed, then cleared:");
    assert_eq(_lc_obs[0], 1, "  the connection is built");
    assert_eq(_lc_obs[2], 0, "  the complete did not reach SSL_connect (the deadline had passed)");
    _lc_final(TLS_ERR_TIMEOUT, 768);

    _lc_row(LC_DL_MIDWAY, 0);
    println("  a 100 ms deadline, the server 600 ms late, then cleared:");
    assert_eq(_lc_obs[0], 1, "  the connection is built");
    assert_gte(_lc_obs[2], 1, "  the complete ran SSL_connect");
    _lc_final(TLS_ERR_TIMEOUT, 768);

    var dl = 0;
    while (dl < 2) {
        _lc_row(LC_VERIFY, dl);
        if (dl == 1) { println("  verification on, the server untrusted (under a 5 s deadline):"); }
        else { println("  verification on, the server untrusted:"); }
        assert_eq(_lc_obs[0], 1, "  the connection is built");
        assert_gte(_lc_obs[2], 1, "  the complete ran SSL_connect");
        _lc_final(TLS_ERR_PROTOCOL, 768);

        _lc_row(LC_SERVER_GARBAGE, dl);
        if (dl == 1) { println("  a libssl server, its peer sending an HTTP request (under a 5 s deadline):"); }
        else { println("  a libssl server, its peer sending an HTTP request:"); }
        assert_eq(_lc_obs[0], 1, "  the server ctx is built (tls_accept_alloc)");
        assert_gte(_lc_obs[2], 1, "  tls_accept_complete ran SSL_accept");
        _lc_final(TLS_ERR_PROTOCOL, 0);
        dl = dl + 1;
    }
    return 0;
}

# Runs everywhere, libssl or not — and BEFORE the backend loads, so SSL_get_error is still
# unresolved and _tls_ssl_io_ret answers from the C int alone. That is the sign-extension half of
# the fix, and it needs no peer. Without this group the file had no assertion on a host (or in
# check.sh's empty environment, which has no $HOME and so no helper) where libssl is absent,
# and the corpus rule grades a 0-assertion summary as a failure.
fn test_int_sign_extension(): i64 {
    test_group("_tls_ssl_io_ret: SSL_read / SSL_write's C int is sign-extended first");
    assert_eq(_fn_SSL_get_error, 0, "precondition: libssl is unloaded here");
    assert_eq(_tls_ssl_io_ret(0, 5), 5, "a positive count passes through");
    assert_eq(_tls_ssl_io_ret(0, 0xDEAD00000005), 5, "the register's high half is not part of the int");
    assert_eq(_tls_ssl_io_ret(0, 0xFFFFFFFF), TLS_ERR_IO, "-1 zero-extended: an error, not +4294967295");
    assert_eq(_tls_ssl_io_ret(0, 0x80000000), TLS_ERR_IO, "INT_MIN: an error, not +2147483648");
    assert_eq(_tls_ssl_io_ret(0, 0x7FFFFFFF), 0x7FFFFFFF, "INT_MAX is still a count");
    return 0;
}

alloc_init();
test_int_sign_extension();
_lr_cert = hex_decode("", 812);
_lr_key = hex_decode("308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420666340f5e33734c31438ae0abd2370b72da193b44565625051bbc79a344535dda144034200040d7a46bc307511f24a53dcf973e0dfe2058db48d7db8b3941fa80176641ad78da12b801a12494d49312bf5b0ac312f3d50bca2282126fddd03652013bf8b49c5", 276);
tls_set_backend(TLS_BACKEND_LIBSSL);
if (tls_available() != 1) {
    var _skip = "  SKIP: libssl.so.3 or the fdlopen helper ($HOME/.cyrius/dlopen-helper) is not available here\n";
    sys_write(1, _skip, strlen(_skip));
} else {
    signal_ignore(SIGPIPE);
    _lr_install_spies();
    _lr_deadline = 0;
    while (_lr_deadline < 2) {
        _lr_ver12 = 0;
        test_libssl_reads();
        _lr_ver12 = 1;
        test_libssl_reads();
        _lr_deadline = _lr_deadline + 1;
    }
    _lr_deadline = 0;
    _lr_ver12 = 0;
    test_libssl_complete_final();
    _lr_ver12 = 1;
    test_libssl_complete_final();
}
#endif
var r = assert_summary();
