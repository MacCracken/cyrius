# tls_native_ca_eku.tcyr — 6.6.16 (CVE-TBD(N3)): the native chain verifier enforces a CA's
# extendedKeyUsage for the chain's purpose, on every intermediate AND on the trust anchor.
#
# THE DEFECT (premise-checked on the 6.6.15 lib): _tn_verify_chain (lib/tls_native_hs12.cyr) — the
# client's verifier of a server chain (_TN_PURPOSE_SERVER) and, since 6.6.14, the mTLS server's
# verifier of a client chain (_TN_PURPOSE_CLIENT, TLS 1.3 and 1.2) — applied the purpose to the
# LEAF only. A CA was checked for keyCertSign and pathLen (_tn_ca_signer_ok, CVE-17) and never for
# its extendedKeyUsage, so a CA confined to clientAuth, codeSigning or S/MIME could issue a leaf
# the native client accepted as a TLS server, and a serverAuth-only CA in an mTLS server's trust
# set could issue a client identity. OpenSSL refuses both (error 26, unsuitable certificate
# purpose). The fix (6.6.16): _tn_eku_purpose_ok(cert, purpose) is the one EKU rule — absent means
# unrestricted, SERVER needs serverAuth, CLIENT needs clientAuth, anyExtendedKeyUsage satisfies
# either — and _tn_ca_signer_ok applies it to every CA it vets, inside the conjunction that
# SELECTS a candidate: a wrongly-purposed CA is skipped and path building goes on to the next
# candidate, it is not fatal.
#
# THE FIXTURES (openssl 3.6.5, P-256, every certificate valid 2025-01-01 .. 2049-12-31, read at a
# pinned 2030-01-01, so no row is a time bomb). The ONLY variable in each family is the EKU:
#   roots  root_{none,server,client,code,any}: five self-signed certificates sharing ONE subject
#          (CN=eku-root) and ONE key, keyUsage keyCertSign|cRLSign, EKU absent / serverAuth /
#          clientAuth / codeSigning / anyExtendedKeyUsage;
#   ints   int_{none,server,client,code,any}: five CA certificates sharing one subject (CN=eku-int)
#          and one key, issued by that root key, the same five EKUs;
#   leaves leaf_r (issued by the root key) and leaf_i (by the intermediate key), CN=localhost,
#          keyUsage digitalSignature, EKU serverAuth + clientAuth — fit for BOTH purposes, so a
#          refusal below is the CA's.
# Because each family shares subject and key, any member signs for any other: leaf_i chains
# through whichever int_* the row passes, and leaf_r / int_* anchor at whichever root_* the row
# trusts — which is also what makes the duplicate-subject path-building rows possible.
#
# THE VERDICT TABLE, with `openssl verify -attime 1893456000 -purpose sslserver | sslclient`
# (OpenSSL 3.6.5) on the same files — S = server purpose, C = client purpose; ok / 26 = error 26:
#   row                                         native S / C      openssl S / C
#   anchor at depth 0: leaf_r <- root_none       ok / ok           ok / ok
#                               <- root_server   ok / REFUSED      ok / 26
#                               <- root_client   REFUSED / ok      26 / ok
#                               <- root_code     REFUSED / REFUSED 26 / 26
#                               <- root_any      ok / ok           26 / 26   (divergence A)
#   intermediate: leaf_i <- int_X <- root_none, X = none / server / client / code / any:
#                                                the same five verdicts as the roots, openssl the
#                                                same as for the roots (error 26 at depth 1)
#   anchor at depth 1: leaf_i <- int_none <- root_X: the same five verdicts again (openssl: error
#                                                26 at depth 2)
#   path building, two intermediates (duplicate subject and key):
#     [int_client, int_server]  S                ok                26        (divergence B)
#     [int_server, int_client]  C                ok                26        (divergence B)
#     [int_server, int_client]  S                ok                ok
#     [int_client, int_code]    S                REFUSED           26
#     [int_server, int_code]    C                REFUSED           26
#     [int_code, int_any]       S and C          ok / ok           26 / 26   (divergence A)
#   path building, several trust roots (a PEM bundle, in this order):
#     [root_client, root_code, root_server]  S / C   ok / ok       26 / ok   (divergence B)
#     [root_server, root_code, root_client]  S / C   ok / ok       ok / 26   (divergence B)
#     [root_client, root_code]               S / C   REFUSED / ok  26 / ok
#   the public verb tls_native_client_verify_chain (server purpose): leaf_i with [int_client] is
#   refused, with [int_server] verifies.
# DIVERGENCE A (the documented default): anyExtendedKeyUsage satisfies either purpose at every
#   depth, as RFC 5280 §4.2.1.12 reads and as cyrius's shipped LEAF rule already did (and still
#   does). OpenSSL 3.6.5 honours it at NO depth — an anyEKU-only leaf, intermediate or root fails
#   both purposes. Going OpenSSL-strict is one line in _tn_eku_purpose_ok, and moves the leaf rule
#   with it.
# DIVERGENCE B (path building): OpenSSL takes the FIRST issuer candidate that matches and signs,
#   and fails error 26 when that one is wrongly purposed — measured: with the rightly purposed
#   intermediate or root listed FIRST it verifies OK. The native verifier skips a wrongly purposed
#   candidate and keeps looking, so its verdict does not depend on the order a peer or a bundle
#   lists them in. It is more permissive only where a fully valid path (every CA rightly purposed)
#   exists.
#
# MUTATIONS (measured on this file, 82 assertions; the 6.6.15 lib — no CA EKU check, and no
# _tn_eku_purpose_ok, shimmed for the measurement — fails every one of the 16 chain refusals and
# none of the rest):
#   the EKU check in _tn_ca_signer_ok removed -> the 16 chain refusal rows (the three tables' 12,
#     the two intermediate-pair refusals, the root-bundle refusal, the public verb's refusal)
#   the anchor's check given the server purpose whatever the chain's -> 5 (the client-purpose
#     serverAuth / clientAuth anchor rows at depth 0 and 1, and the [root_client, root_code]
#     client row)
#   the intermediate's check given the server purpose -> 3 (the client-purpose serverAuth /
#     clientAuth intermediate rows, and [int_server, int_code] client)
#   a wrongly purposed intermediate made FATAL instead of skipped -> 4 (the [int_client,
#     int_server] / [int_server, int_client] skips and both [int_code, int_any] rows)
#   a wrongly purposed trust root made fatal -> 2 (the two bundles whose first root is wrong)
#   an ABSENT extension taken as restricting -> 26 (every row whose path holds a CA without EKU)
#   anyExtendedKeyUsage not honoured for the client purpose -> 5 (every anyEKU client row)
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/io.cyr"
include "lib/tls.cyr"

var EK_NOW = 1893456000;   # 2030-01-01 00:00 UTC

var _ek_root_none = 0;
var _ek_root_server = 0;
var _ek_root_client = 0;
var _ek_root_code = 0;
var _ek_root_any = 0;
var _ek_int_none = 0;
var _ek_int_server = 0;
var _ek_int_client = 0;
var _ek_int_code = 0;
var _ek_int_any = 0;
var _ek_leaf_r = 0;
var _ek_leaf_i = 0;

# A parsed certificate from its DER as hex (`hex_n` hex digits), or 0 when it does not parse.
fn _ek_cert(hex, hex_n): i64 {
    var der = hex_decode(hex, hex_n);
    var c = x509_cert_alloc();
    if (x509_parse(der, hex_n / 2, c) != 1) { return 0; }
    return c;
}

fn _ek_fixtures(): i64 {
    _ek_root_none = _ek_cert("", 696);
    _ek_root_server = _ek_cert("", 738);
    _ek_root_client = _ek_cert("", 738);
    _ek_root_code = _ek_cert("", 740);
    _ek_root_any = _ek_cert("", 730);
    _ek_int_none = _ek_cert("", 762);
    _ek_int_server = _ek_cert("", 804);
    _ek_int_client = _ek_cert("", 800);
    _ek_int_code = _ek_cert("", 802);
    _ek_int_any = _ek_cert("", 794);
    _ek_leaf_r = _ek_cert("", 864);
    _ek_leaf_i = _ek_cert("", 860);
    return 0;
}

# PEM bundles of several roots, in the order the row names.
