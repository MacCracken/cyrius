var _ek_b_cl_co = "-----BEGIN CERTIFICATE-----\nMIIBbTCCAROgAwIBAgICEAMwCgYIKoZIzj0EAwIwEzERMA8GA1UEAwwIZWt1LXJv\nb3QwHhcNMjUwMTAxMDAwMDAwWhcNNDkxMjMxMDAwMDAwWjATMREwDwYDVQQDDAhl\na3Utcm9vdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABBdjsHJIeFsn6cmvgMmE\niY+/C/JK+9sejVJpbluYv0qHgxuYffCujSWj6C50a6WKSA7h4cKbWex2+OC8Jr/v\nksCjVzBVMA8GA1UdEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgEGMBMGA1UdJQQM\nMAoGCCsGAQUFBwMCMB0GA1UdDgQWBBTscb7Qq8jmP5UpskhUwCgJcadxYTAKBggq\nhkjOPQQDAgNIADBFAiBAdteR7rWWZKgzKJXtDn721MRzsRHChM6sYPvh78cQ+wIh\nANVpeOpLLI8j9QrvTvxxI2etjT6uLtf1av9UanC8XAxr\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\nMIIBbjCCAROgAwIBAgICEAQwCgYIKoZIzj0EAwIwEzERMA8GA1UEAwwIZWt1LXJv\nb3QwHhcNMjUwMTAxMDAwMDAwWhcNNDkxMjMxMDAwMDAwWjATMREwDwYDVQQDDAhl\na3Utcm9vdDBZMBMGByqGSM49AgEGCCqGSM49AwEHA0IABBdjsHJIeFsn6cmvgMmE\niY+/C/JK+9sejVJpbluYv0qHgxuYffCujSWj6C50a6WKSA7h4cKbWex2+OC8Jr/v\nksCjVzBVMA8GA1UdEwEB/wQFMAMBAf8wDgYDVR0PAQH/BAQDAgEGMBMGA1UdJQQM\nMAoGCCsGAQUFBwMDMB0GA1UdDgQWBBTscb7Qq8jmP5UpskhUwCgJcadxYTAKBggq\nhkjOPQQDAgNJADBGAiEAoIPNMUfaFmZt23LNzPpdnxw3IJSNwBDSPoz22Ufz5MoC\nIQDpNX+rR/AkoaQa4M10qc6fk0fOOUpvkLC3ozPz5Nc7tw==\n-----END CERTIFICATE-----\n";

# The [count][cert ptrs] intermediates list _tn_verify_chain takes (TLS order), or 0 for none.
fn _ek_inters(a, b): i64 {
    if (a == 0) { return 0; }
    var n = 1;
    if (b != 0) { n = 2; }
    var l = alloc(8 + n * 8);
    store64(l, n);
    store64(l + 8, a);
    if (n == 2) { store64(l + 16, b); }
    return l;
}

# _tn_verify_chain on a fresh ctx trusting the one DER root `root`.
fn _ek_v(root, leaf, i1, i2, purpose): i64 {
    var ctx = tls_native_new_client("localhost", 9);
    if (tls_native_set_ca_bundle(ctx, load64(root), load64(root + 8), 1) != TLS_OK) { return 0 - 999; }
    return _tn_verify_chain(ctx, leaf, _ek_inters(i1, i2), EK_NOW, purpose);
}

# The same on a fresh ctx trusting the PEM bundle `pem` — the install path a system store takes,
# whose root DER lives in the set's pool (the client purpose reads it: sigil records serverAuth
# only, so clientAuth is read from the DER).
fn _ek_vb(pem, leaf, purpose): i64 {
    var ctx = tls_native_new_client("localhost", 9);
    if (tls_native_set_ca_bundle(ctx, pem, strlen(pem), 0) != TLS_OK) { return 0 - 999; }
    return _tn_verify_chain(ctx, leaf, 0, EK_NOW, purpose);
}

fn _ek_ok(r, label): i64 { return assert_eq(r, TLS_OK, label); }
fn _ek_no(r, label): i64 { return assert_eq(r, TLS_ERR_CERT_INVALID, label); }

fn test_fixtures(): i64 {
    test_group("the fixtures parse, and each carries the EKU its name says");
    assert(_ek_root_none != 0, "root_none parses");
    assert(_ek_root_server != 0, "root_server parses");
    assert(_ek_root_client != 0, "root_client parses");
    assert(_ek_root_code != 0, "root_code parses");
    assert(_ek_root_any != 0, "root_any parses");
    assert(_ek_int_none != 0, "int_none parses");
    assert(_ek_int_server != 0, "int_server parses");
    assert(_ek_int_client != 0, "int_client parses");
    assert(_ek_int_code != 0, "int_code parses");
    assert(_ek_int_any != 0, "int_any parses");
    assert(_ek_leaf_r != 0, "leaf_r parses");
    assert(_ek_leaf_i != 0, "leaf_i parses");
    assert_eq(x509_cert_eku(_ek_root_none), 0, "  root_none: no extendedKeyUsage (sigil 0 = absent)");
    assert_eq(x509_cert_eku(_ek_root_server), 0x101, "  root_server: serverAuth (0x101)");
    assert_eq(x509_cert_eku(_ek_root_client), 0x100, "  root_client: present, no serverAuth (0x100)");
    assert_eq(x509_cert_eku(_ek_root_code), 0x100, "  root_code: present, no serverAuth (0x100)");
    assert_eq(x509_cert_eku(_ek_root_any), 0x101, "  root_any: anyExtendedKeyUsage reads as serverAuth (0x101)");
    assert_eq(x509_cert_eku(_ek_int_client), 0x100, "  int_client: present, no serverAuth (0x100)");
    assert_eq(x509_cert_is_ca(_ek_root_client), 1, "  root_client is a CA");
    assert_eq(x509_cert_is_ca(_ek_int_code), 1, "  int_code is a CA");
    # Every row's only variable: the controls verify for both purposes.
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_r, 0, 0, _TN_PURPOSE_SERVER), "control: leaf_r <- root_none, server purpose");
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_r, 0, 0, _TN_PURPOSE_CLIENT), "control: leaf_r <- root_none, client purpose");
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_none, 0, _TN_PURPOSE_SERVER),
      "control: leaf_i <- int_none <- root_none, server purpose");
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_none, 0, _TN_PURPOSE_CLIENT),
      "control: leaf_i <- int_none <- root_none, client purpose");
    _ek_no(_ek_v(_ek_root_none, _ek_leaf_i, 0, 0, _TN_PURPOSE_SERVER),
      "control: leaf_i with no intermediate has no path (CERT_INVALID)");
    return 0;
}

# The one EKU rule, on each fixture: absent -> 1; SERVER -> serverAuth or anyEKU; CLIENT ->
# clientAuth or anyEKU.
fn test_rule(): i64 {
    test_group("_tn_eku_purpose_ok: the one EKU rule every depth applies");
    assert_eq(_tn_eku_purpose_ok(_ek_root_none, _TN_PURPOSE_SERVER), 1, "EKU absent, server purpose: 1 (unrestricted)");
    assert_eq(_tn_eku_purpose_ok(_ek_root_none, _TN_PURPOSE_CLIENT), 1, "EKU absent, client purpose: 1 (unrestricted)");
    assert_eq(_tn_eku_purpose_ok(_ek_root_server, _TN_PURPOSE_SERVER), 1, "serverAuth, server purpose: 1");
    assert_eq(_tn_eku_purpose_ok(_ek_root_server, _TN_PURPOSE_CLIENT), 0, "serverAuth, client purpose: 0");
    assert_eq(_tn_eku_purpose_ok(_ek_root_client, _TN_PURPOSE_SERVER), 0, "clientAuth, server purpose: 0");
    assert_eq(_tn_eku_purpose_ok(_ek_root_client, _TN_PURPOSE_CLIENT), 1, "clientAuth, client purpose: 1");
    assert_eq(_tn_eku_purpose_ok(_ek_root_code, _TN_PURPOSE_SERVER), 0, "codeSigning, server purpose: 0");
    assert_eq(_tn_eku_purpose_ok(_ek_root_code, _TN_PURPOSE_CLIENT), 0, "codeSigning, client purpose: 0");
    assert_eq(_tn_eku_purpose_ok(_ek_root_any, _TN_PURPOSE_SERVER), 1, "anyExtendedKeyUsage, server purpose: 1");
    assert_eq(_tn_eku_purpose_ok(_ek_root_any, _TN_PURPOSE_CLIENT), 1, "anyExtendedKeyUsage, client purpose: 1");
    assert_eq(_tn_eku_purpose_ok(_ek_leaf_r, _TN_PURPOSE_SERVER), 1, "serverAuth + clientAuth, server purpose: 1");
    assert_eq(_tn_eku_purpose_ok(_ek_leaf_r, _TN_PURPOSE_CLIENT), 1, "serverAuth + clientAuth, client purpose: 1");
    return 0;
}

# One CA family at one position: the trust anchor at depth 0 (`where` 0), the intermediate
# (`where` 1), or the anchor at depth 1, above int_none (`where` 2).
fn _ek_at(where, ca, purpose): i64 {
    if (where == 0) { return _ek_v(ca, _ek_leaf_r, 0, 0, purpose); }
    if (where == 1) { return _ek_v(_ek_root_none, _ek_leaf_i, ca, 0, purpose); }
    return _ek_v(ca, _ek_leaf_i, _ek_int_none, 0, purpose);
}

fn test_table(where, label, none, server, client, code, any): i64 {
    test_group(label);
    _ek_ok(_ek_at(where, none, _TN_PURPOSE_SERVER), "EKU absent, server purpose: verifies");
    _ek_ok(_ek_at(where, none, _TN_PURPOSE_CLIENT), "EKU absent, client purpose: verifies");
    _ek_ok(_ek_at(where, server, _TN_PURPOSE_SERVER), "serverAuth, server purpose: verifies");
    _ek_no(_ek_at(where, server, _TN_PURPOSE_CLIENT), "serverAuth, client purpose: REFUSED (openssl: error 26)");
    _ek_no(_ek_at(where, client, _TN_PURPOSE_SERVER), "clientAuth, server purpose: REFUSED (openssl: error 26)");
    _ek_ok(_ek_at(where, client, _TN_PURPOSE_CLIENT), "clientAuth, client purpose: verifies");
    _ek_no(_ek_at(where, code, _TN_PURPOSE_SERVER), "codeSigning, server purpose: REFUSED (openssl: error 26)");
    _ek_no(_ek_at(where, code, _TN_PURPOSE_CLIENT), "codeSigning, client purpose: REFUSED (openssl: error 26)");
    _ek_ok(_ek_at(where, any, _TN_PURPOSE_SERVER),
      "anyExtendedKeyUsage, server purpose: verifies (openssl 3.6.5: error 26 — divergence A)");
    _ek_ok(_ek_at(where, any, _TN_PURPOSE_CLIENT),
      "anyExtendedKeyUsage, client purpose: verifies (openssl 3.6.5: error 26 — divergence A)");
    return 0;
}

fn test_path_building(): i64 {
    test_group("path building: a wrongly purposed CA is SKIPPED, not fatal");
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_client, _ek_int_server, _TN_PURPOSE_SERVER),
      "[int_client, int_server], server purpose: int_client skipped, verifies through int_server");
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_server, _ek_int_client, _TN_PURPOSE_CLIENT),
      "[int_server, int_client], client purpose: int_server skipped, verifies through int_client");
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_server, _ek_int_client, _TN_PURPOSE_SERVER),
      "[int_server, int_client], server purpose: verifies through the first");
    _ek_no(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_client, _ek_int_code, _TN_PURPOSE_SERVER),
      "[int_client, int_code], server purpose: no rightly purposed intermediate, REFUSED");
    _ek_no(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_server, _ek_int_code, _TN_PURPOSE_CLIENT),
      "[int_server, int_code], client purpose: no rightly purposed intermediate, REFUSED");
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_code, _ek_int_any, _TN_PURPOSE_SERVER),
      "[int_code, int_any], server purpose: verifies through int_any (divergence A)");
    _ek_ok(_ek_v(_ek_root_none, _ek_leaf_i, _ek_int_code, _ek_int_any, _TN_PURPOSE_CLIENT),
      "[int_code, int_any], client purpose: verifies through int_any (divergence A)");

    test_group("path building: several trust roots, from a PEM bundle");
    _ek_ok(_ek_vb(_ek_b_cls, _ek_leaf_r, _TN_PURPOSE_SERVER),
      "[root_client, root_code, root_server], server purpose: anchors at root_server");
    _ek_ok(_ek_vb(_ek_b_cls, _ek_leaf_r, _TN_PURPOSE_CLIENT),
      "[root_client, root_code, root_server], client purpose: anchors at root_client");
    _ek_ok(_ek_vb(_ek_b_scl, _ek_leaf_r, _TN_PURPOSE_SERVER),
      "[root_server, root_code, root_client], server purpose: anchors at root_server");
    _ek_ok(_ek_vb(_ek_b_scl, _ek_leaf_r, _TN_PURPOSE_CLIENT),
      "[root_server, root_code, root_client], client purpose: anchors at root_client");
    _ek_no(_ek_vb(_ek_b_cl_co, _ek_leaf_r, _TN_PURPOSE_SERVER),
      "[root_client, root_code], server purpose: no rightly purposed root, REFUSED");
    _ek_ok(_ek_vb(_ek_b_cl_co, _ek_leaf_r, _TN_PURPOSE_CLIENT),
      "[root_client, root_code], client purpose: anchors at root_client");
    return 0;
}

# The client's public verb carries the server purpose to the CA check.
fn test_public_verb(): i64 {
    test_group("tls_native_client_verify_chain: a server chain through a clientAuth-only CA");
    var c = tls_native_new_client("localhost", 9);
    tls_native_set_ca_bundle(c, load64(_ek_root_none), load64(_ek_root_none + 8), 1);
    store64(c + TLS_CTX_OFF_SERVER_CERT, _ek_leaf_i);
    store64(c + TLS_CTX_OFF_SERVER_INTERS, _ek_inters(_ek_int_client, 0));
    _ek_no(tls_native_client_verify_chain(c, EK_NOW), "leaf_i <- int_client: REFUSED");
    var d = tls_native_new_client("localhost", 9);
    tls_native_set_ca_bundle(d, load64(_ek_root_none), load64(_ek_root_none + 8), 1);
    store64(d + TLS_CTX_OFF_SERVER_CERT, _ek_leaf_i);
    store64(d + TLS_CTX_OFF_SERVER_INTERS, _ek_inters(_ek_int_server, 0));
    _ek_ok(tls_native_client_verify_chain(d, EK_NOW), "leaf_i <- int_server: verifies");
    return 0;
}

fn _ek_all(): i64 {
    alloc_init();
    _ek_fixtures();
    test_fixtures();
    test_rule();
    test_table(0, "the trust anchor, signing the leaf (depth 0)", _ek_root_none, _ek_root_server,
      _ek_root_client, _ek_root_code, _ek_root_any);
    test_table(1, "the intermediate (under root_none)", _ek_int_none, _ek_int_server, _ek_int_client,
      _ek_int_code, _ek_int_any);
    test_table(2, "the trust anchor, above int_none (depth 1)", _ek_root_none, _ek_root_server,
      _ek_root_client, _ek_root_code, _ek_root_any);
    test_path_building();
    test_public_verb();
    return 0;
}

_ek_all();
var r = assert_summary();
