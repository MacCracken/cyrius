signal_ignore(SIGPIPE);
crypto_tls_main_init();
test_repro_cases();
test_tls13_client_window();
_cd_ver12 = 0;
test_deadline_native();
_cd_ver12 = 1;
test_deadline_native();
_cd_ver12 = 0;
