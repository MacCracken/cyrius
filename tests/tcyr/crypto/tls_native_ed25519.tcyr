# tls_native_ed25519.tcyr — v6.1.31
# Ed25519 SERVER cert end-to-end: our native client ↔ our native server over a
# socketpair, with an Ed25519 leaf cert (the server signs CertificateVerify with
# scheme ed25519 = 0x0807, PureEdDSA over the raw transcript content; the client
# verifies it). Mirrors tls_wrapper_native.tcyr (which uses ECDSA P-256). Filed
# from sit v0.8.8 (`sit serve --tls` with an Ed25519 cert failed the handshake);
# see issues/archived/2026-06-10-tls-native-ed25519-server-cert-accept-fails.md.
# Cert/key are openssl-generated Ed25519 (cert DER 320 B, PKCS#8 key DER 48 B).
#define CYRIUS_TLS_NATIVE
include "lib/fdlopen.cyr"
include "lib/str.cyr"
include "lib/chrono.cyr"
include "lib/random.cyr"
include "lib/dynlib.cyr"
include "lib/tls_native.cyr"
include "lib/tls.cyr"
include "lib/assert.cyr"

# Ed25519 self-signed leaf for CN=127.0.0.1 (cert DER 320 B; PKCS#8 key 48 B,
# OID 1.3.101.112 + 32-byte seed).
var cert = hex_decode("", 640);
var key = hex_decode("302e020100300506032b657004220420ea5da8171db67e4e169e246d8f7223ee88110129914478f8b49ffc898780df10", 96);

# ── 6.6.16: an Ed25519 handshake signature is exactly 64 bytes, from an Ed25519 leaf ──
# _tn_verify_sig_scheme's Ed25519 arm (the 1.3 server CertificateVerify and the 1.2
# ServerKeyExchange) called ed25519_verify, which reads a FIXED 64 bytes, without looking at
# sig_len or at the leaf's key type: a 65-byte field verified with its tail ignored, a 63- or
# 0-byte field borrowed its missing bytes from whatever followed it in the buffer, and a
# non-Ed25519 leaf had the first 32 bytes of its key slot decoded as an Ed25519 point. Each
# malformed row below was measured returning 1 / TLS_OK before the fix. Mutation: dropping the
# sig_len check reddens the 65/63/0 rows (both groups); dropping the curve check reddens the
# doctored P-256 leaf row. The 63-byte rows keep the genuine 64th byte right after the field,
# so the over-read would succeed. CHANGELOG [6.6.16]
test_group("Ed25519 signature: 64 bytes from an Ed25519 leaf (6.6.16)");

# A self-signed P-256 leaf (CN=localhost; the TLS 1.2 unit tests' CERT23).
var p256c = hex_decode("", 770);

var ed_leaf = x509_cert_alloc();
assert_eq(x509_parse(cert, 320, ed_leaf), 1, "the Ed25519 leaf parses");
assert_eq(x509_cert_curve(ed_leaf), X509_CURVE_ED25519, "  ...as an Ed25519 key");
var p256_leaf = x509_cert_alloc();
assert_eq(x509_parse(p256c, 385, p256_leaf), 1, "the P-256 leaf parses");
assert_eq(x509_cert_curve(p256_leaf), X509_CURVE_P256, "  ...as a P-256 key");

# The leaf's own key: the PKCS#8 seed is the last 32 bytes of `key`.
var ed_sk[64];
var ed_pk[32];
ed25519_keypair(key + 16, &ed_sk, &ed_pk);
assert_eq(memeq(&ed_pk, x509_cert_pubkey(ed_leaf), 32), 1, "the PKCS#8 seed derives the leaf's public key");

var vmsg = "TLS 1.3, server CertificateVerify content";
var vlen = strlen(vmsg);
var vsig = alloc(80);
memset(vsig, 0xAB, 80);                    # 0xAB follows the 64 signature bytes
ed25519_sign(&ed_sk, vmsg, vlen, vsig);
assert_eq(_tn_verify_sig_scheme(TLS_SIG_ED25519, ed_leaf, vmsg, vlen, vsig, 64), 1, "sig_len 64: valid");
assert_eq(_tn_verify_sig_scheme(TLS_SIG_ED25519, ed_leaf, vmsg, vlen, vsig, 65), 0,
  "sig_len 65 (the signature plus a trailing byte): invalid");
assert_eq(_tn_verify_sig_scheme(TLS_SIG_ED25519, ed_leaf, vmsg, vlen, vsig, 63), 0,
  "sig_len 63 (the 64th byte read from past the field): invalid");
assert_eq(_tn_verify_sig_scheme(TLS_SIG_ED25519, ed_leaf, vmsg, vlen, vsig, 0), 0,
  "sig_len 0 (all 64 bytes read from past the field): invalid");
assert_eq(_tn_verify_sig_scheme(TLS_SIG_ED25519, p256_leaf, vmsg, vlen, vsig, 64), 0,
  "Ed25519 scheme with a P-256 leaf: invalid");
# The curve check, isolated: a P-256 leaf whose key slot begins with the Ed25519 public key
# would verify if the slot were read as an Ed25519 point.
var dr_leaf = x509_cert_alloc();
x509_parse(p256c, 385, dr_leaf);
memcpy(x509_cert_pubkey(dr_leaf), &ed_pk, 32);
assert_eq(_tn_verify_sig_scheme(TLS_SIG_ED25519, dr_leaf, vmsg, vlen, vsig, 64), 0,
  "Ed25519 scheme with a P-256 leaf whose key slot starts with the Ed25519 key: invalid");

# Through _tn_12_parse_server_kex: an x25519 ServerKeyExchange signed by the Ed25519 leaf's key
# over client_random ‖ server_random ‖ params, with the sig field 64, 65 or 63 bytes long.
fn _ske_client(c_der, c_len, crand, srand): i64 {
    var c = tls_native_new_client(0, 0);
    store64(c + TLS_CTX_OFF_CLIENT_RANDOM, crand);
    store64(c + TLS_CTX_OFF_SERVER_RANDOM, srand);
    var body = alloc(6 + c_len);
    _tn_be24_w(body, 3 + c_len);
    _tn_be24_w(body + 3, c_len);
    memcpy(body + 6, c_der, c_len);
    if (_tn_parse_certificate_12(c, body, 6 + c_len) != TLS_OK) { return 0; }
    return c;
}

# The SKE body into `out` with a `field_len`-byte sig field; the full signature is always
# written, so a 63-byte field is followed by the signature's genuine 64th byte and a 65-byte
# field ends in it plus 0xAB. Returns the body length.
fn _ske_ed25519(sk, crand, srand, field_len, out): i64 {
    var plen = 4 + 32;
    store8(out, 3);
    _tn_be16_w(out + 1, TLS_GROUP_X25519);
    store8(out + 3, 32);
    var i = 0;
    while (i < 32) { store8(out + 4 + i, 0x09 + i); i = i + 1; }
    var content = alloc(64 + plen);
    memcpy(content, crand, 32);
    memcpy(content + 32, srand, 32);
    memcpy(content + 64, out, plen);
    _tn_be16_w(out + plen, TLS_SIG_ED25519);
    _tn_be16_w(out + plen + 2, field_len);
    memset(out + plen + 4, 0xAB, 72);
    ed25519_sign(sk, content, 64 + plen, out + plen + 4);
    return plen + 4 + field_len;
}

var ske_cr = alloc(32);
var ske_sr = alloc(32);
var ri = 0;
while (ri < 32) { store8(ske_cr + ri, ri); store8(ske_sr + ri, 0x20 + ri); ri = ri + 1; }
var ske = alloc(256);
var skc = _ske_client(cert, 320, ske_cr, ske_sr);
assert_neq(skc, 0, "1.2 client ctx with the Ed25519 server leaf");
var skn = _ske_ed25519(&ed_sk, ske_cr, ske_sr, 64, ske);
assert_eq(_tn_12_parse_server_kex(skc, ske, skn), TLS_OK, "SKE with a 64-byte Ed25519 signature: TLS_OK");
skc = _ske_client(cert, 320, ske_cr, ske_sr);
skn = _ske_ed25519(&ed_sk, ske_cr, ske_sr, 65, ske);
assert_eq(_tn_12_parse_server_kex(skc, ske, skn), TLS_ERR_AUTHN, "SKE with a 65-byte sig field: TLS_ERR_AUTHN");
skc = _ske_client(cert, 320, ske_cr, ske_sr);
skn = _ske_ed25519(&ed_sk, ske_cr, ske_sr, 63, ske);
assert_eq(_tn_12_parse_server_kex(skc, ske, skn), TLS_ERR_AUTHN, "SKE with a 63-byte sig field: TLS_ERR_AUTHN");

# Disable peer verification of the self-signed test cert (still exercises the
# full CertVerify SIGNATURE path on the server + signature VERIFY on the client;
# only the chain-trust step is skipped).
fn vhook(hctx, handle): i64 { tls_set_verify(handle, 0, 0); return 0; }

test_group("tls_native Ed25519 server cert (.31)");
#ifdef CYRIUS_TARGET_AGNOS
# 6.6.10: a named SKIP on agnos — the corpus cross-compile ratchet
# (tests/gates/toolchain/tcyr_corpus_cross_compiles.sh). This end-to-end run is a socketpair + fork +
# 3-arg waitpid; agnos has no socketpair (-ENOSYS) and its waitpid is the 1-arg #4 poll (own ABI, kept).
# CHANGELOG [6.6.10]
var _agnos_skip = "  SKIP (agnos): the socketpair + fork end-to-end run (no socketpair; 1-arg waitpid)\n";
sys_write(1, _agnos_skip, strlen(_agnos_skip));
#endif
#ifndef CYRIUS_TARGET_AGNOS
var fds[8];
sys_socketpair(1, 1, 0, &fds);
var fdp = load64(&fds);
var sfd = fdp & 0xFFFFFFFF;
var cfd = (fdp >> 32) & 0xFFFFFFFF;

var pid = sys_fork();
if (pid == 0) {
    sys_close(sfd);
    tls_set_backend(TLS_BACKEND_NATIVE);
    var ctx = tls_connect_with_ctx_hook(cfd, "localhost", &vhook, 0);
    if (ctx == 0) { sys_exit(10); }
    if (tls_write(ctx, "hello-ed25519", 13) != 13) { sys_exit(11); }
    var rb[64];
    if (tls_read(ctx, &rb, 64) != 9) { sys_exit(12); }
    if (_tn_ct_eq(&rb, "ack-nativ", 9) != 1) { sys_exit(13); }
    tls_close(ctx);
    sys_close(cfd);
    sys_exit(0);
}

sys_close(cfd);
var srv = tls_native_new_server(cert, 320, key, 48);
tls_native_server_load_creds(srv);
assert_eq(tls_native_accept(srv, sfd), TLS_OK, "native server accepts client with Ed25519 cert");
var sb[64];
assert_eq(tls_native_read(srv, &sb, 64), 13, "server reads app data (Ed25519 handshake completed)");
assert_eq(_tn_ct_eq(&sb, "hello-ed25519", 13), 1, "client write decrypts server-side");
assert_eq(tls_native_write(srv, "ack-nativ", 9), 9, "server responds");
var st[4];
sys_waitpid(pid, &st, 0);
assert_eq((load64(&st) >> 8) & 0xFF, 0, "client verified Ed25519 CertVerify + closed (child exit 0)");

#endif
var r = assert_summary();
