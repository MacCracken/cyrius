# tls_native_freestanding.tcyr — v6.3.4 bare-metal #7
#
# A full TLS 1.3 client <-> server handshake driven ENTIRELY over the pluggable
# transport vtable (v6.2.4) + entropy hook (v6.2.28) + clock hook — NO
# sys_socketpair, NO sys_getrandom, NO sys_read/sys_write/clock_gettime on the TLS
# path. This is the freestanding / in-kernel-TLS capability the libssl wrapper
# structurally cannot provide: a kernel installs its own transport (its net driver)
# + CSPRNG via these hooks and the native stack runs with zero host-OS coupling.
#
# The two endpoints run in separate address spaces (fork) so each keeps its own
# crypto state — the same isolation the socketpair e2e tests rely on, EXCEPT the
# channel here is an in-memory MAP_SHARED region the transport vtable reads/writes
# (memcpy), not a kernel socket. So the only thing crossing a syscall boundary is
# the harness (fork + the one mmap that sets up the shared page + waitpid); the TLS
# code path itself issues zero network / entropy / clock syscalls. The full 1.3
# handshake is strictly lock-step, so the directional byte streams are
# single-producer/single-consumer and need only a memory fence — the v6.3.3 #6
# mfence/dmb — for publish/acquire visibility across the shared page. cyrius
# re-reads memory every loop iteration (no register caching) so the blocking-read
# spin observes the peer's length bump.

include "lib/tls_native.cyr"
include "lib/str.cyr"
include "lib/chrono.cyr"
include "lib/random.cyr"
include "lib/assert.cyr"

# --- publish / acquire fence (the v6.3.3 #6 primitives; arch-conditional) ---
fn _lb_fence(): i64 {
#ifdef CYRIUS_ARCH_AARCH64
    asm { dmb }
#endif
#ifndef CYRIUS_ARCH_AARCH64
    asm { mfence }
#endif
    return 0;
}

# --- shared in-memory loopback (mmap MAP_SHARED, inherited across fork; NO socket) ---
# Layout in _shm: [0]=c2s_len  [8]=s2c_len  [16 .. 16+CAP)=c2s  [16+CAP .. )=s2c.
# c2s = client->server stream, s2c = server->client. handle 1 = client (parent),
# handle 2 = server (child). The read cursors are per-process (private after fork).
var LB_CAP = 65536;
var _shm = 0;
var _c2s_rd = 0;
var _s2c_rd = 0;

fn _lb_write(handle, buf, n): i64 {
    if (handle == 1) {
        var len = load64(_shm + 0);
        memcpy(_shm + 16 + len, buf, n);
        _lb_fence();
        store64(_shm + 0, len + n);
    } else {
        var len2 = load64(_shm + 8);
        memcpy(_shm + 16 + LB_CAP + len2, buf, n);
        _lb_fence();
        store64(_shm + 8, len2 + n);
    }
    return n;
}

# blocking read: spin until >=1 byte (lock-step → never deadlocks), fence (acquire),
# then copy up to n bytes. Matches the sys_read contract _tn_sock_read_full expects.
# ⛔ v6.5.25 — BOTH SPINS ARE NOW BOUNDED. They were bare `while (cond) { }` with no cap,
# no timeout, no syscall and no yield, so if the peer never appears this fn NEVER RETURNS.
# That is exactly what happened on cass: `sys_fork()` returns -1 on Windows
# (lib/syscalls_windows.cyr), the `pid == 0` test below is false, so no server endpoint was
# ever created and the client span here forever — the one undiagnosed
# `tls_native_freestanding` HANG in the ecb/cass full-corpus issue, killed only by the
# runner's `timeout 90`. A test that hangs costs the whole suite its wall-clock budget and
# tells you nothing about what failed.
#
# The bound is deliberately enormous (the handshake is strictly lock-step, so a correct run
# observes the peer's length bump within a handful of iterations) — large enough that it can
# never fire on a slow or loaded host, small enough to abort in well under the runner's
# deadline. Returning 0 surfaces as a read failure the TLS layer already reports, instead of
# a wedge. This is the same universal-bound reasoning as the v6.4.62 `PEEKT` watchdog:
# pick a ceiling far above any legal value so it cannot false-fire, and the spin stops
# being unbounded.
var LB_SPIN_MAX = 2000000000;

fn _lb_read(handle, buf, n): i64 {
    if (handle == 1) {                          # client reads s2c
        var spin = 0;
        while (load64(_shm + 8) <= _s2c_rd) {
            spin = spin + 1;
            if (spin > LB_SPIN_MAX) { return 0; }
        }
        _lb_fence();
        var avail = load64(_shm + 8) - _s2c_rd;
        var take = n; if (take > avail) { take = avail; }
        memcpy(buf, _shm + 16 + LB_CAP + _s2c_rd, take);
        _s2c_rd = _s2c_rd + take;
        return take;
    }
    var spin2 = 0;
    while (load64(_shm + 0) <= _c2s_rd) {        # server reads c2s
        spin2 = spin2 + 1;
        if (spin2 > LB_SPIN_MAX) { return 0; }
    }
    _lb_fence();
    var avail2 = load64(_shm + 0) - _c2s_rd;
    var take2 = n; if (take2 > avail2) { take2 = avail2; }
    memcpy(buf, _shm + 16 + _c2s_rd, take2);
    _c2s_rd = _c2s_rd + take2;
    return take2;
}

# fixed wall-clock (NO clock syscall). Cert validity isn't checked under
# TLS_VERIFY_NONE, but provide it so the now-hook is the only clock source.
fn _lb_now(): i64 { return 1781000000; }   # mid-2026, after the test cert notBefore

# --- deterministic entropy hook (NO getrandom) ---
# SplitMix64. Generates the client/server randoms + X25519 ephemeral privates. A
# real kernel installs a CSPRNG here; the point proven is that the HOOK is the only
# entropy source on the TLS path. The child reseeds after fork so the two endpoints
# get distinct randoms (independent ECDHE shares).
var _rng = 0x243F6A8885A308D3;
fn _lb_rand(buf, n): i64 {
    var i = 0;
    while (i < n) {
        _rng = _rng + 0x9E3779B97F4A7C15;
        var z = _rng;
        z = (z ^ ((z >> 30) & 0x3FFFFFFFF)) * 0xBF58476D1CE4E5B9;
        z = (z ^ ((z >> 27) & 0x1FFFFFFFFFF)) * 0x94D049BB133111EB;
        z = z ^ ((z >> 31) & 0x1FFFFFFFF);
        var j = 0;
        while (j < 8 && i < n) {
            store8(buf + i, (z >> (j * 8)) & 0xFF);
            i = i + 1; j = j + 1;
        }
    }
    return n;
}

# Ed25519 self-signed test cert (320 B) + PKCS#8 key (48 B) — from tls_native_alpn.
var fs_cert = hex_decode("", 640);
var fs_key = hex_decode("302e020100300506032b657004220420ea5da8171db67e4e169e246d8f7223ee88110129914478f8b49ffc898780df10", 96);

test_group("TLS 1.3 freestanding handshake over hooks (no socket / no getrandom / no clock)");

# shared loopback page (MAP_SHARED|MAP_ANONYMOUS, prot RW) — inherited by the fork.
# v6.5.16: the flags word was the literal 0x21 = MAP_SHARED(1) | Linux MAP_ANONYMOUS(0x20).
# Darwin's MAP_ANON is 0x1000, so on Intel-Mac 0x21 asked for a FILE mapping with fd -1 →
# -9 EBADF, and the test then dereferenced -9 and died with SIGSEGV. Exactly the divergence
# lib/mmap.cyr:57 documents (and the one v6.5.11 fixed for mmap_anon). Use the peer's own
# MAP_* constants rather than a literal so this cannot drift per platform again.
_shm = syscall(9, 0, 16 + 2 * LB_CAP, 3, MAP_SHARED | MAP_ANONYMOUS, 0 - 1, 0);
assert(_shm > 65536, "mmap MAP_SHARED loopback region");
assert_eq(tls_native_set_transport(&_lb_read, &_lb_write, &_lb_now), TLS_OK, "install in-memory transport (read/write/now hooks)");
assert_eq(tls_native_set_entropy(&_lb_rand), TLS_OK, "install deterministic entropy hook");

var pid = sys_fork();
# ⛔ v6.5.25 — CHECK THE FORK RETURN. `if (pid == 0)` alone treats a FAILED fork as "I am
# the parent", so on any platform without fork the client ran with no server on the other
# end of the shared page and the bounded-now spin in `_lb_read` was reached with nothing to
# read. On Windows `sys_fork()` returns -1 unconditionally
# (lib/syscalls_windows.cyr — Windows has no fork; the CLI spawns via CreateProcessW), and
# this test's whole premise is two address spaces sharing a MAP_SHARED page, which Windows
# offers no equivalent of (EMMAP_PE drops MAP_SHARED). So the honest outcome is a NAMED SKIP,
# not a fabricated pass and not a 90-second wedge.
#
# ⚠ Kept as a RUNTIME check on the return value rather than an `#ifdef CYRIUS_TARGET_WIN`
# on purpose: the defect is "fork failed", not "the target is Windows". A `#ifdef` would
# leave every other fork-less or fork-restricted environment (a sandbox denying clone, an
# exhausted process table) hanging in exactly the same way, and it would compile the code
# out on Windows so a future PE fork emulation would silently never be exercised.
if (pid < 0) {
    println("    SKIP: sys_fork() unavailable (returned < 0) — this test needs two address spaces sharing a MAP_SHARED page; no fork means no server endpoint. Not a TLS failure.");
    tls_native_set_transport(0, 0, 0);
    tls_native_set_entropy(0);
    var rskip = assert_summary();
    syscall(60, rskip);
}
if (pid == 0) {
    # CHILD: server — separate address space → isolated crypto state.
    _rng = 0x9E3779B97F4A7C15;                  # reseed so server randoms differ from client's
    var srv = tls_native_new_server(fs_cert, 320, fs_key, 48);
    tls_native_server_load_creds(srv);
    if (tls_native_accept(srv, 2) != TLS_OK) { sys_exit(20); }
    if (tls_native_get_state(srv) != TLS_STATE_CONNECTED) { sys_exit(21); }
    # v6.4.21: the 1.3 server ctx now records the negotiated version (the
    # get_version store added to respond_hello's ServerHello path) — assert it
    # directly, the way the client (line below) and the 1.2 server already do.
    # (Was a get_cipher==0x1302 1.3-only-AEAD workaround while issue
    # 2026-06-28-tls13-server-get-version-zero was open.)
    if (tls_native_get_version(srv) != TLS_VERSION_1_3) { sys_exit(22); }
    var sb[64];
    if (tls_native_read(srv, &sb, 64) != 17) { sys_exit(23); }
    if (_tn_ct_eq(&sb, "ping-freestanding", 17) != 1) { sys_exit(24); }
    if (tls_native_write(srv, "pong-freestanding", 17) != 17) { sys_exit(25); }
    sys_exit(0);
}

# PARENT: client, over handle 1.
var cli = tls_native_new_client("localhost", 9);
tls_native_set_verify(cli, TLS_VERIFY_NONE);    # self-signed test cert, no trust anchor
assert_eq(tls_native_connect(cli, 1), TLS_OK, "client connect() — full 1.3 handshake over the mmap loopback → TLS_OK");
assert_eq(tls_native_get_state(cli), TLS_STATE_CONNECTED, "client CONNECTED");
assert_eq(tls_native_get_version(cli), TLS_VERSION_1_3, "negotiated TLS 1.3");
assert_eq(tls_native_get_cipher(cli), TLS_AES_256_GCM_SHA384, "negotiated AES-256-GCM-SHA384 (1.3 AEAD over the hooks)");
assert_eq(tls_native_write(cli, "ping-freestanding", 17), 17, "client writes app data over the loopback");
var crb[64];
assert_eq(tls_native_read(cli, &crb, 64), 17, "client reads the server reply (17 B)");
assert_eq(_tn_ct_eq(&crb, "pong-freestanding", 17), 1, "server reply decrypts on the client");

var stbuf[4];
sys_waitpid(pid, &stbuf, 0);
var code = (load64(&stbuf) >> 8) & 0xFF;
assert_eq(code, 0, "server child: accept()+handshake+app-data over the loopback succeeded (exit 0)");

# restore the default transport/entropy — the corpus shares these module globals.
tls_native_set_transport(0, 0, 0);
tls_native_set_entropy(0);

var r = assert_summary();
