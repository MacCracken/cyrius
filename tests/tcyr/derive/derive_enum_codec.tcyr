# derive_enum_codec.tcyr — v6.5.31: `#derive(Serialize)` / `#derive(Deserialize)` on an ENUM
# generates a name-string codec pair.
#
# ⚖️ WIRE SHAPE — a bare NAME STRING (`"MULTIPLY"`), settled by the maintainer 2026-08-19 after
# the number form was rejected as ambiguous ("a JSON consumer cannot tell it from any other
# integer field"). Name-string matches what ranga's hand-written codecs already emit, keeps a
# derived struct flat — `{"fmt":"RGBA8"}` rather than `{"fmt":{"PixelFormat":"RGBA8"}}`, where
# the tag merely restates the field name — and is serde's representation for unit-variant
# enums, which is the Rust line the ranga port is measured against.
#
# ⚖️ PARSE FAILURE — `Result`, also the maintainer's call: `Ok(value)` / `Err(-1)`, composable
# with `?`. This DIFFERS from the struct deserializer, which returns a raw pointer, and the
# difference is deliberate: an enum parse can genuinely fail on an unrecognised name, where a
# struct decode yields a zeroed struct. Generated enum code therefore needs `lib/result.cyr`.
#
# ⭐ The generated code compares against the ENUM CONSTANTS, never against baked-in numbers, so
# renumbering a variant cannot desynchronise the codec from the enum. The `Sparse` enum below
# is the row that proves it: values 5 / 900 / 12345 are non-contiguous and far from any index,
# so a codec that assumed 0..n or carried its own literals would fail on it.
#
# ⚠ Negative enum values are NOT tested because the LANGUAGE does not accept them —
# `enum E { B = -1; }` is `error: expected number, got '-'`, and `0 - 1` is an expression an
# enum body will not take either. That is a pre-existing parser limit, unrelated to derive,
# and noted here so the omission does not read as an untested case.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/result.cyr"
include "lib/assert.cyr"

#derive(Serialize)
enum BlendMode { MULTIPLY = 0; SCREEN = 1; OVERLAY = 2; }

# Non-contiguous and negative values — nothing about the codec may assume 0..n.
#derive(Deserialize)
enum Sparse { LOW = 5; HIGH = 900; HIGHEST = 12345; }

fn json_of(v): i64 {
    var sb = str_builder_new();
    BlendMode_to_json(v, sb);
    return str_data(str_builder_build(sb));
}
fn sparse_json_of(v): i64 {
    var sb = str_builder_new();
    Sparse_to_json(v, sb);
    return str_data(str_builder_build(sb));
}

fn main(): i64 {
    alloc_init();
    test_group("derive enum codec (v6.5.31)");

    # --- to_json: a quoted variant NAME ---
    assert_eq(streq(json_of(MULTIPLY), "\"MULTIPLY\""), 1, "to_json emits the quoted name");
    assert_eq(streq(json_of(SCREEN), "\"SCREEN\""), 1, "to_json distinguishes variants");
    assert_eq(streq(json_of(OVERLAY), "\"OVERLAY\""), 1, "to_json handles the last variant");

    # An out-of-range value must stay VALID JSON. Writing a bogus name or crashing would
    # corrupt the surrounding document, and an out-of-range enum is reachable (a cast, or a
    # wire value from an older peer).
    assert_eq(streq(json_of(99), "null"), 1, "an unrecognised value emits null, not garbage");

    # --- from_json_str: Result, both directions ---
    var r = BlendMode_from_json_str("\"SCREEN\"");
    assert_eq(is_ok(r), 1, "from_json_str on a known name is Ok");
    assert_eq(result_unwrap(r), SCREEN, "from_json_str returns the variant's value");

    # A BARE name (no quotes) parses too, so the same fn works on a config string as well as
    # on a value lifted out of a JSON document.
    var rb = BlendMode_from_json_str("OVERLAY");
    assert_eq(is_ok(rb), 1, "a bare unquoted name also parses");
    assert_eq(result_unwrap(rb), OVERLAY, "the bare-name path returns the right value");

    var bad = BlendMode_from_json_str("\"NOPE\"");
    assert_eq(is_err_result(bad), 1, "an unrecognised name is Err, not a silent zero");

    # ⭐ ANTI-VACUOUS for the Err row: a PREFIX of a real name must NOT match. Without this a
    # comparison that stopped at the shorter string's end would pass every row above.
    var pre = BlendMode_from_json_str("\"SCRE\"");
    assert_eq(is_err_result(pre), 1, "a PREFIX of a variant name does not match");

    # ...and a name with a real variant as its prefix must not match either.
    var post = BlendMode_from_json_str("\"SCREENX\"");
    assert_eq(is_err_result(post), 1, "a variant name plus a suffix does not match");

    # --- round-trip over every variant ---
    var i = 0;
    var rt_ok = 1;
    while (i < 3) {
        var back = BlendMode_from_json_str(json_of(i));
        if (is_ok(back) == 0) { rt_ok = 0; }
        elif (result_unwrap(back) != i) { rt_ok = 0; }
        i = i + 1;
    }
    assert_eq(rt_ok, 1, "every variant round-trips to_json -> from_json_str");

    # --- non-contiguous and negative values, via a bare #derive(Deserialize) ---
    # The bare-Deserialize form emitted NOTHING before v6.5.31 — on structs as well as enums —
    # so this row also pins that fix.
    var s1 = Sparse_from_json_str("\"HIGH\"");
    assert_eq(is_ok(s1), 1, "bare #derive(Deserialize) generates a working codec");
    assert_eq(result_unwrap(s1), 900, "a non-contiguous value (900) survives");

    var s2 = Sparse_from_json_str("\"HIGHEST\"");
    assert_eq(is_ok(s2), 1, "a far-from-index variant parses");
    assert_eq(result_unwrap(s2), 12345, "value 12345 survives — the codec reads the constant, not an index");

    assert_eq(streq(sparse_json_of(5), "\"LOW\""), 1, "to_json maps a non-contiguous value back to its name");
    assert_eq(streq(sparse_json_of(900), "\"HIGH\""), 1, "to_json handles the middle of a sparse enum");

    var r2 = assert_summary();
    return r2;
}
var ec = main();
syscall(60, ec);
