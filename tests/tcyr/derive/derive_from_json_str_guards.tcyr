# `#derive(Serialize)`'s generated `X_from_json_str` refuses a null pointer and
# refuses input that is not a JSON object (v6.5.37).
#
# TWO DEFECTS IN ONE EMITTED BODY, filed by prani (2026-08-31) against five generated
# codecs at once. Neither was fixable by a consumer: the body is EMITTED by the
# preprocessor, so a project could only abandon the derive and hand-write every codec —
# exactly the duplication the derive exists to remove. prani's four HAND-written
# deserializers all carry `if (json == 0) { return ... }`, added deliberately in its
# ADR-0002 after a malformed document produced a fully-formed struct with every field
# zero; the generated codecs were never covered by that ADR *because they are generated*.
#
#   1. NULL DEREF — the first statement dereferenced `json`, so `X_from_json_str(0)`
#      segfaulted. Measured at 6.5.36: exit 139.
#   2. MALFORMED INPUT SCORED AS SUCCESS — `memset(ptr, 0, N)` ran first, the scan matched
#      nothing, and the zeroed struct came back as a valid pointer. Measured:
#      `X_from_json_str("not json at all")` returned NON-NULL with x == 0.
#
# ⚠ A NOTE ON THE FILING'S OTHER CLAIM, so nobody re-fixes a bug that does not exist: it
# also reported that `cyrius test` scores such a crash as `1 passed, 0 failed`. It does
# NOT. Measured at 6.5.36, a .tcyr that segfaults gives `cyrius test` exit 139 and the
# suite exit 1, with the failure counted. Reading `$?` through a pipe yields the LAST
# command's status, which is the likeliest source of that reading. The real defect there
# was SILENCE — a crashed test was counted but never NAMED — fixed separately at v6.5.37.
#
# ⛔ THIS TEST IS ALSO ITS OWN TRIPWIRE. If the null guard regresses, this file does not
# merely fail an assertion — it dies of SIGSEGV before reaching `assert_summary()`. That
# now surfaces as a named `FAIL: ... (killed by signal 11 SIGSEGV)` rather than a silent
# count, which is the only reason a crash-shaped regression is legible here at all.
#
# ⚠ Scope stops at "is this an object?". A well-formed document with the WRONG KEYS still
# yields a zeroed struct, deliberately: that is a schema question, not a parse one, and
# rejecting it would break round-tripping a legitimately all-default struct. Axis 4 pins
# that boundary so a later "stricter is better" change has to argue with it.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/io.cyr"
include "lib/fmt.cyr"
include "lib/tagged.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/bayan.cyr"
include "lib/assert.cyr"

#derive(Serialize)
struct dfjs_pt { x: i64; y: i64; }

fn main() {
    alloc_init();

    # ── axis 1: a NULL pointer returns 0 instead of dereferencing it ──────────────
    # Reaching the next line at all is half the assertion: pre-fix this crashed.
    var nullres = dfjs_pt_from_json_str(0);
    assert_eq(nullres, 0, "from_json_str(0) returns 0, not a dereference");

    # ── axis 2: input with no object at all is refused ────────────────────────────
    var garbage = dfjs_pt_from_json_str(str_data(str_from("not json at all")));
    assert_eq(garbage, 0, "from_json_str(garbage) returns 0, not a zeroed struct");

    # ── axis 3: the empty string is refused too (truncation shape) ────────────────
    var empty = dfjs_pt_from_json_str(str_data(str_from("")));
    assert_eq(empty, 0, "from_json_str(\"\") returns 0");

    # ── axis 4: ANTI-VACUOUS — a REAL document still decodes ──────────────────────
    # Without this, `return 0` unconditionally passes axes 1-3 and breaks every
    # consumer of the derive.
    var good = dfjs_pt_from_json_str(str_data(str_from("{\"x\":7,\"y\":9}")));
    assert_nonnull(good, "a well-formed document still decodes to a struct");
    assert_eq(load64(good), 7, "x decoded");
    assert_eq(load64(good + 8), 9, "y decoded");

    # ── axis 5: the documented boundary — right shape, wrong keys, still decodes ──
    # Pins the deliberate scope limit: this is a schema question, not a parse one, and
    # an all-default struct must stay round-trippable.
    var wrongkeys = dfjs_pt_from_json_str(str_data(str_from("{\"a\":1,\"b\":2}")));
    assert_nonnull(wrongkeys, "an object with unknown keys is still a parse success");
    assert_eq(load64(wrongkeys), 0, "unmatched fields stay zero");

    var r = assert_summary();
    return 0;
}
