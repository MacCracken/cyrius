# WS server handshake — reject-path regression (issue 2026-06-30
# stdlib-ws-server-http-find-header-dangling). Locks the
# http_find_header -> sandhi_server_find_header rename.
#
# cyrius shipped NO ws test before — ws_server.cyr was never compiled in-tree,
# so the dangling `http_find_header` (defined nowhere) slipped through here and
# only surfaced downstream in bote. This test compiles ws_server AND reaches
# ws_server_handshake, so a stale header-helper name is a REACHABLE-undefined
# hard error right here.
#
# ws_server_handshake calls sandhi_server_find_header, which lib/ws_server.cyr brings itself (its
# own `include "lib/sandhi.cyr"`, 6.6.19 R2), so this test runs sandhi's real fn — and a stale
# `http_find_header` call, defined nowhere, is still a reachable-undefined hard error here. (The
# test's own stand-in, from before that include, was a duplicate of it and is gone. CHANGELOG
# [6.7.14]) Run with:
#   cyrius test tests/tcyr/formats/ws_server_handshake.tcyr

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
# 6.6.9: bayan's sidecar leaf io.cyr (its file_* helpers). A bundle strips its own includes, so
# the consumer supplies it; without it those helpers compiled as ud2 stubs. CHANGELOG [6.6.9]
include "lib/io.cyr"
include "lib/bayan.cyr"

include "lib/ws_server.cyr"
include "lib/assert.cyr"

test_group("ws_server_handshake reject paths (rename regression)");

# Plain GET, no Upgrade header — the FIRST sandhi_server_find_header("Upgrade")
# returns 0 => handshake rejects immediately.
var r1 = "GET / HTTP/1.1\r\nHost: h\r\n\r\n";
assert_eq(ws_server_handshake(0 - 1, r1, strlen(r1)), 0, "non-upgrade rejected");

# All four WS headers present but Version != 13 — exercises all 4
# sandhi_server_find_header calls, then rejects on the version check.
var r2 = "GET /c HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 8\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n";
assert_eq(ws_server_handshake(0 - 1, r2, strlen(r2)), 0, "bad version rejected");

# Version 13 but no Sec-WebSocket-Key header => the key find returns 0 => reject.
var r3 = "GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\n\r\n";
assert_eq(ws_server_handshake(0 - 1, r3, strlen(r3)), 0, "missing key rejected");

# Version 13, all headers, but key is not the RFC-6455 24-char base64 => reject
# on the length guard, still before any socket send.
var r4 = "GET / HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: short\r\n\r\n";
assert_eq(ws_server_handshake(0 - 1, r4, strlen(r4)), 0, "bad key length rejected");

var _exit_code = assert_summary();
syscall(60, _exit_code);
