# string_literal_64k.tcyr — v6.6.4 — a string literal >= 65536 bytes reads back shifted.
#
# Filed by agnos/rekha (docs/development/issues/2026-09-13-agnos-large-string-literal-loses-first-byte.md):
# a 410 KB TrueType face embedded as literal data hashed wrong; the byte COUNT was intact, the
# CONTENT was the right bytes moved down by one. Root cause: src/frontend/lex.cyr packed the
# literal token as `(sstart << 16) | slen` — 16 bits for the length — so a length >= 65536 ORed
# its high bits into the LOW bits of the pool OFFSET. OR, not add: a literal whose pool offset
# already had bit 0 set (an ODD offset) was unaffected, one at an EVEN offset moved up by one —
# which is why the filing saw "alternate literals" shifted, and why the odd-length group below
# needs a 2-byte pad literal: odd-length entries have an even stride (len + NUL), so without the
# pad both 65537-byte literals share a parity and the group could be vacuous on the old compiler.
# Groups 1 and 2 therefore each contain at least one even-offset literal for ANY preceding pool.
# Lexer-level: every backend inherited the wrong offset through ESADDR (x86/aarch64/cx/PE/Mach-O).
#
# Mutation that reddens this file: `(sstart << 32)` -> `(sstart << 16)` in lex.cyr (HEAD 6.6.3).
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/assert.cyr"

fn l64k_0() { return ""; }
fn l64k_1() { return ""; }
fn l64k_2() { return ""; }
fn l64k1_0() { return ""; }
fn pad2() { return "pp"; }   # 3 pool bytes: flips the parity so that ONE of the two 65537-byte literals sits at an EVEN pool offset whatever the lib literals before it contribute
fn l64k1_1() { return ""; }
fn l128k() { return ""; }

fn tail_ok(p, n, fill): i64 {
    # every byte after the head must be the fill and byte n must be the NUL
    var i = 1;
    while (i < n) { if (load8(p + i) != fill) { return 0; } i = i + 1; }
    if (load8(p + n) != 0) { return 0; }
    return 1;
}

test_group("65536-byte literals (even length; the filed case)");
assert_eq(load8(l64k_0()), 65, "lit0 byte 0 == 'A'");
assert_eq(load8(l64k_1()), 88, "lit1 byte 0 == 'X'");
assert_eq(load8(l64k_2()), 89, "lit2 byte 0 == 'Y'");
assert_eq(tail_ok(l64k_0(), 65536, 97), 1, "lit0 tail + NUL");
assert_eq(tail_ok(l64k_1(), 65536, 98), 1, "lit1 tail + NUL");
assert_eq(tail_ok(l64k_2(), 65536, 99), 1, "lit2 tail + NUL");

test_group("65537-byte literals (odd length; the one at an EVEN pool offset shifts on HEAD)");
assert_eq(load8(l64k1_0()), 80, "byte 0 == 'P'");
assert_eq(load8(l64k1_1()), 81, "byte 0 == 'Q'");
assert_eq(tail_ok(l64k1_0(), 65537, 100), 1, "tail + NUL");
assert_eq(tail_ok(l64k1_1(), 65537, 101), 1, "tail + NUL");

test_group("131072-byte literal (bit 17 of the length lands in offset bit 1; HEAD read +2 at an offset with bit 1 clear)");
assert_eq(load8(l128k()), 82, "byte 0 == 'R'");
assert_eq(tail_ok(l128k(), 131072, 102), 1, "tail + NUL");

var r = assert_summary();

