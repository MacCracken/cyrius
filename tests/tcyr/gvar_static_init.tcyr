# v5.11.64 — top-level `var X = INT_LITERAL ;` static-init via
# file-image bytes (no runtime store).
# Filing: docs/development/issues/2026-05-18-gvar-init-order-zero-reads.md
# (agnos xHCI Attempt 64 QEMU root-cause).
#
# Pre-v5.11.64: `var X = N;` at module top emitted a runtime store
# sequence at the program entry. In kmode==1 the kernel's PARSE_PROG
# body ran BEFORE the EMIT_GVAR_INITS block, so any fn called from
# the kernel main body that read X saw 0 (the BSS default) instead
# of N. Two agnos load-bearing instances (XHCI_CMD_TIMEOUT_SPINS,
# XHCI_EVT_RING_SEGMENT_SIZE) ate ~10 iron-burn attempts before
# the root cause surfaced.
#
# Post-v5.11.64: PARSE_GVAR_REG detects the `= NUM ;` shape and
# records the literal in gvar_initval[vcnt]. FIXUP's emit paths
# write the literal value into the var area's file image instead
# of zero. No runtime store; the value is correct on first read,
# regardless of when (or whether) the post-PROG init block runs.
#
# Verifies:
# (1) Positive int literal reads back at module-top call site
#     (simulates kmode entry sequence).
# (2) Large 32-bit literal reads back (matches agnos's
#     XHCI_CMD_TIMEOUT_SPINS = 10000000).
# (3) Hex literal reads back at value.
# (4) `var X = 0;` falls through to BSS-zero path (no regression
#     for the zero-literal case which all-of-cc5 uses extensively).
# (5) Arithmetic RHS. UPDATED v6.4.74: this NO LONGER falls through to the
#     runtime-store path — `_CF_TRY` (parse_decl.cyr) const-folds it and it
#     takes the same static-init path as a literal. That is the whole point of
#     v6.4.74: in kmode the deferred block is unreachable for a kernel whose
#     top-level program never returns, so a computed initializer read 0 forever.
# (6) v6.4.74 fold correctness — PRECEDENCE IS THE RISK. A folder that disagrees
#     with PEXPR/PARSE_TERM would bake in a different value than the runtime
#     computes, which is the same silent-wrong-value class being fixed. These
#     asserts gate it directly: with the fold applied the static init writes
#     fold(expr), so a mis-folded value is read back verbatim and fails here.
#     Note cyrius is NOT C — `&`/`|`/`^` share precedence with `+`/`-`
#     (left-assoc), so `1 | 2 + 1` is `(1|2)+1` == 4, not `1|(2+1)` == 3.

include "lib/syscalls.cyr"
include "lib/assert.cyr"

# (1) Small positive literal.
var SMALL_LIT = 42;
# (2) Large literal (agnos's exact value).
var XHCI_CMD_TIMEOUT_SPINS = 10000000;
# (3) Hex literal (load-bearing register write in agnos's xhci_ring).
var XHCI_EVT_RING_SEGMENT_SIZE = 256;
var HEX_LIT = 0xDEADBEEF;
# (4) Zero literal — BSS-zero is already correct.
var ZERO_LIT = 0;
# (5) Arithmetic RHS — v6.4.74: const-folded into the static-init path.
var ARITH = 100 + 1;
# (6) v6.4.74 fold-correctness corpus. Each value is what the RUNTIME evaluator
# produces for the same expression (verified by a 42-expression differential at
# the .74 cut); a precedence or operator bug in _CF_EXPR/_CF_TERM/_CF_FACTOR
# changes these and fails the asserts below.
var F_MUL     = 512 * 2;          # 1024
var F_NEG     = -5;               # -5   (unary minus)
var F_SUB     = 0 - 61;           # -61
var F_SHL     = 1 << 4;           # 16
var F_SHR     = 16 >> 2;          # 4    (positive operand — does NOT distinguish >> from >>>)
# A NEGATIVE operand is what actually pins `>>` as LOGICAL. Without this the
# mutation `>>` -> arithmetic passes the whole suite (found by mutation testing
# at the .74 cut). (0-16) as u64 is 0xFFFFFFFFFFFFFFF0; >> 2 logical gives
# 0x3FFFFFFFFFFFFFFC. Arithmetic would give -4.
var F_SHRNEG  = (0 - 16) >> 2;    # 4611686018427387900, NOT -4
var F_ASR     = (0 - 16) >>> 2;   # -4   (ARITHMETIC — cybs can't lex >>>, see _CF_ASR)
var F_MOD     = 100 % 7;          # 2
var F_PRE1    = 2 + 3 * 4;        # 14   (* binds tighter)
var F_PRE2    = 1 | 2 + 1;        # 4    (NOT C: | same tier as +, left-assoc)
var F_PRE3    = 5 & 3 + 1;        # 2
var F_PAREN   = (2 + 3) * 4;      # 20
var F_CHAIN   = 100 - 10 - 5;     # 85   (left-assoc)
var F_XOR     = 255 ^ 15;         # 240
var F_HEXOR   = 0xDEADBEE0 | 0xF; # 0xDEADBEEF
var F_MIX     = 1 + 2 * 3 - 4 / 2;# 5
var F_UNARY2  = - -7;             # 7
var F_SHLCHN  = 1 << 2 << 3;      # 32

fn read_small(): i64 { return SMALL_LIT; }
fn read_spins(): i64 { return XHCI_CMD_TIMEOUT_SPINS; }
fn read_segsz(): i64 { return XHCI_EVT_RING_SEGMENT_SIZE; }
fn read_hex(): i64 { return HEX_LIT; }
fn read_zero(): i64 { return ZERO_LIT; }
fn read_arith(): i64 { return ARITH; }

# Top-level call site — runs BEFORE main() in the entry stream.
# Pre-fix in kmode: reads zero. Post-fix everywhere: reads literal.
# Executable mode (this tcyr's kmode) places EMIT_GVAR_INITS BEFORE
# top-level PARSE_PROG, so the runtime-store path also worked here
# pre-fix — the static-init path now removes the runtime store but
# the read still returns the correct value. The agnos kmode==1
# scenario (PARSE_PROG before EMIT_GVAR_INITS) is exercised by the
# `kmode emit order` gate in programs/checks/platform_efi.cyr, which compiles a
# minimal `kernel;` source against the same codegen path.
var _early_small = read_small();
var _early_spins = read_spins();
var _early_segsz = read_segsz();
var _early_hex   = read_hex();
var _early_zero  = read_zero();

assert_eq(_early_small, 42,        "(1) SMALL_LIT readable at top-level");
assert_eq(_early_spins, 10000000,  "(2) XHCI_CMD_TIMEOUT_SPINS = 10000000 (agnos repro value)");
assert_eq(_early_segsz, 256,       "(3a) XHCI_EVT_RING_SEGMENT_SIZE = 256 (agnos ring entry)");
assert_eq(_early_hex,   0xDEADBEEF, "(3b) HEX_LIT = 0xDEADBEEF (hex literal)");
assert_eq(_early_zero,  0,          "(4) ZERO_LIT = 0 (BSS-zero path)");

# Also read AFTER main entry — both paths must agree.
assert_eq(read_small(), 42,        "(1') SMALL_LIT consistent post-entry");
assert_eq(read_spins(), 10000000,  "(2') XHCI_CMD_TIMEOUT_SPINS consistent post-entry");
assert_eq(read_segsz(), 256,       "(3a') segsz consistent post-entry");
assert_eq(read_hex(),   0xDEADBEEF, "(3b') hex consistent post-entry");
assert_eq(read_zero(),  0,          "(4') zero consistent post-entry");
assert_eq(read_arith(), 101,        "(5) arithmetic RHS const-folded to static init");

# (6) v6.4.74 — fold correctness. These are read at module top, i.e. through the
# static-init image bytes, so a wrong fold surfaces here directly.
assert_eq(F_MUL,     1024,       "(6a) 512 * 2");
assert_eq(F_NEG,     0 - 5,      "(6b) unary minus -5");
assert_eq(F_SUB,     0 - 61,     "(6c) 0 - 61");
assert_eq(F_SHL,     16,         "(6d) 1 << 4");
assert_eq(F_SHR,     4,          "(6e) 16 >> 2");
assert_eq(F_SHRNEG,  4611686018427387900, "(6e2) (0-16) >> 2 is LOGICAL (not sign-filled)");
assert_eq(F_ASR,     0 - 4,      "(6f) (0-16) >>> 2 (arithmetic, sign-preserving)");
assert_eq(F_MOD,     2,          "(6g) 100 % 7");
assert_eq(F_PRE1,    14,         "(6h) 2 + 3 * 4 — * binds tighter");
assert_eq(F_PRE2,    4,          "(6i) 1 | 2 + 1 == (1|2)+1 — NOT C precedence");
assert_eq(F_PRE3,    2,          "(6j) 5 & 3 + 1 == (5&3)+1");
assert_eq(F_PAREN,   20,         "(6k) (2 + 3) * 4");
assert_eq(F_CHAIN,   85,         "(6l) 100 - 10 - 5 left-assoc");
assert_eq(F_XOR,     240,        "(6m) 255 ^ 15");
assert_eq(F_HEXOR,   0xDEADBEEF, "(6n) 0xDEADBEE0 | 0xF");
assert_eq(F_MIX,     5,          "(6o) 1 + 2 * 3 - 4 / 2");
assert_eq(F_UNARY2,  7,          "(6p) - -7 double unary");
assert_eq(F_SHLCHN,  32,         "(6q) 1 << 2 << 3 left-assoc");

var _exit_code = assert_summary();
syscall(60, _exit_code);
