# closures_capture.tcyr — v6.3.8 LEXICAL CAPTURE. A closure body that references
# an enclosing local (a free variable) captures it BY VALUE into a heap env object
# `[fn_ptr, cap0, …]` at construction; the closure value is that object, dispatched
# via `callptr` (auto: load fn_ptr from [obj], pass obj as the hidden env arg).
# Non-capturing closures stay bare fn pointers (see closures.tcyr).
#
# Requires lib/alloc.cyr (the env is heap-allocated) + alloc_init() before use.

include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

# ---- capturing-closure fns (decls before the top-level statements) ----
fn cap_one(): i64 {
    var base = 40;
    var f = |x| base + x;            # captures `base`
    return callptr(f, 2);            # 40 + 2
}

fn cap_two(): i64 {
    var a = 10;
    var b = 20;
    var f = |x| a + b + x;           # captures `a` and `b`
    return callptr(f, 12);           # 10 + 20 + 12
}

fn cap_param_mix(): i64 {
    var base = 30;
    var f = |x, y| base + x + y;     # 1 capture + 2 params
    return callptr(f, 5, 7);         # 30 + 5 + 7
}

# By value: mutating-after isn't possible, but the captured copy is independent —
# `base` keeps its value and the closure saw the value at construction.
fn cap_by_value(): i64 {
    var base = 40;
    var f = |x| base + x;
    var r = callptr(f, 2);           # 42
    return base + r - 40;            # base still 40 → 40 + 42 - 40 = 42
}

# Zero-param thunk that captures.
fn cap_thunk(): i64 {
    var k = 42;
    var f = || k;                    # captures `k`, no params
    return callptr(f);
}

# Capture inside a fn with locals before AND after (the enclosing fn auto-regalloc's;
# the capture object + the closure inline-emit must coexist with it).
fn cap_with_locals(): i64 {
    var a0 = 1;
    var base = 38;
    var f = |x| base + x;
    var b0 = 1;
    return a0 + b0 + callptr(f, 2);  # 1 + 1 + (38 + 2) = 42
}

# Two independent capturing closures with different captured values.
fn cap_two_closures(): i64 {
    var p = 30;
    var q = 8;
    var f = |x| p + x;
    var g = |x| q + x;
    return callptr(f, 0) + callptr(g, 4);   # (30+0) + (8+4) = 42
}

# v6.3.36 — a capturing closure COPIED to another local (`var g = f`) carries
# its CLOSURE_TYID tag, so callptr(g,…) still auto-dispatches (load fn_ptr from
# [g], pass g as env) instead of jumping into the heap object (which SIGSEGV'd
# pre-v6.3.36 because the copy landed as a plain i64). Both bindings alias the
# same env object, so calling either applies the same captured value.
fn cap_copy_to_local(): i64 {
    var base = 40;
    var f = |x| base + x;            # captures `base`; f tagged CLOSURE_TYID
    var g = f;                       # copy — g must inherit the tag
    return callptr(g, 2);            # 40 + 2 via the copied binding
}

fn cap_copy_both(): i64 {
    var base = 20;
    var f = |x| base + x;
    var g = f;                       # f and g alias the same env
    return callptr(f, 1) + callptr(g, 1);   # (20+1) + (20+1) == 42
}

# ---- 6.6.5: AGGREGATE CAPTURE ----------------------------------------------------------
# ⛔ A closure captured every free variable as ONE WORD. For a scalar that is right; for an
# enclosing STACK ARRAY or STRUCT LOCAL it is not, and the two shapes failed differently:
# `&buf` on an enclosing stack array reported "undefined variable 'buf'" (this ladder had no
# rung for the env object at all — the capture worked while arrays were globals and stopped
# at v6.3.13/15 when they became real locals), and `q.y` on an enclosing struct local reported
# the same. A struct LITERAL appeared to work only because it was secretly a global, so
# moving literals onto the frame in 6.6.5 would have broken that too. The env is now
# `1 + sum(widths)` words and each capture copies its own width.
#
# Mutation: make `_cl_cap_add` record width 1 unconditionally -> cap_struct_field reads the
# struct's FIRST word for its second field; drop the `&name` env rung -> cap_stack_array
# fails to compile with "undefined variable".
struct CapP { cx; cy; }

fn cap_stack_array(): i64 {
    var buf[16];
    store64(&buf, 40);
    var f = |a| a + load64(&buf);
    return callptr(f, 2);
}
fn cap_struct_field(): i64 {
    var q: CapP;
    q.cx = 40; q.cy = 2;
    var f = |a| a + q.cy;
    return callptr(f, 40);
}
fn cap_struct_literal(): i64 {
    var p = CapP { 40, 2 };
    var f = |a| a + p.cy;
    return callptr(f, 40);
}
# BY VALUE: mutating the enclosing aggregate AFTER construction must not change the closure.
fn cap_struct_by_value(): i64 {
    var q: CapP;
    q.cx = 1; q.cy = 2;
    var f = || q.cy;
    q.cy = 999;
    return callptr(f);
}
# A POINTER-mode capture stays one word and keeps pointing at the same heap struct.
fn cap_pointer_mode(): i64 {
    var h: CapP = alloc(16);
    h.cx = 40; h.cy = 2;
    var f = |a| a + h.cy;
    return callptr(f, 40);
}

# ⛔ 6.6.5 (review round 2) — A CAPTURED INLINE AGGREGATE DISPATCHES ITS OPERATOR OVERLOAD.
# Once `var a = CapS{..}` became a frame local, `|x| a + x` stopped reaching the enclosing-local
# rung (which sets the expression's struct type) and reached the CAPTURE rung, which did not —
# so it compiled to an INTEGER ADD of the captured word and answered 3 where 102 is right, and
# with the operator fn DELETED it compiled clean where 6.6.4 refused the program. The
# single-word capture is passed BY VALUE and the two-word one BY ADDRESS, matching what the
# enclosing-local and global rungs already do.
# ⚠ The expected values are built from the operands by the operator fns themselves, and each
# subject is asserted EQUAL to a non-closure control written the same way — a build that stops
# dispatching everywhere fails the control too, and cannot be mistaken for this fix.
struct CapS { sv; }
struct CapV { vx; vy; }
fn CapS_add(a, b) { return 100 + a + b; }
fn CapV_add(a, b) { return load64(a) * 10 + load64(a + 8) + load64(b) * 100 + load64(b + 8) * 1000; }
fn cap_op_small(): i64 {
    var a = CapS { 1 };
    var f = |x| a + x;
    return callptr(f, 1);
}
fn ctrl_op_small(): i64 {
    var a = CapS { 1 };
    return a + 1;
}
fn cap_op_multiword(): i64 {
    var p = CapV { 1, 2 };
    var q = CapV { 3, 4 };
    var f = || p + q;
    return callptr(f);
}
fn ctrl_op_multiword(): i64 {
    var p = CapV { 1, 2 };
    var q = CapV { 3, 4 };
    return p + q;
}

# ---- top-level statements ----
alloc_init();

test_group("lexical capture by value (single / multiple / with params)");
assert_eq(cap_one(), 42, "|x| base+x captures base=40, applied to 2 == 42");
assert_eq(cap_two(), 42, "|x| a+b+x captures a=10,b=20, applied to 12 == 42");
assert_eq(cap_param_mix(), 42, "|x,y| base+x+y: 1 capture + 2 params == 42");

test_group("capture semantics + edge forms");
assert_eq(cap_by_value(), 42, "captured value is an independent by-value copy");
assert_eq(cap_thunk(), 42, "|| k zero-param thunk captures k == 42");
assert_eq(cap_with_locals(), 42, "capture inside a fn with locals before+after == 42");
assert_eq(cap_two_closures(), 42, "two independent capturing closures == 42");

test_group("closure copied to another local (v6.3.36)");
assert_eq(cap_copy_to_local(), 42, "var g = f; callptr(g,2): copied closure dispatches == 42");
assert_eq(cap_copy_both(), 42, "f and g alias same env: callptr(f,1)+callptr(g,1) == 42");

test_group("aggregate capture by value (6.6.5)");
assert_eq(cap_stack_array(), 42, "&buf on an enclosing STACK ARRAY resolves through the env");
assert_eq(cap_struct_field(), 42, "q.cy on an enclosing typed struct local");
assert_eq(cap_struct_literal(), 42, "p.cy on an enclosing struct LITERAL local");
assert_eq(cap_struct_by_value(), 2, "the captured struct is a COPY: a later write does not reach it");
assert_eq(cap_pointer_mode(), 42, "a pointer-mode struct capture stays one word");
assert_eq(cap_struct_field(), cap_struct_literal(), "typed local and literal agree");

test_group("captured aggregate operator dispatch (6.6.5)");
assert_eq(cap_op_small(), 102, "|x| a + x on a captured 8 B struct calls CapS_add");
assert_eq(cap_op_small(), ctrl_op_small(), "captured and non-captured agree (single word)");
assert_eq(cap_op_multiword(), 4312, "|| p + q on two captured 16 B structs calls CapV_add");
assert_eq(cap_op_multiword(), ctrl_op_multiword(), "captured and non-captured agree (multi-word)");

var r = assert_summary();
