# v6.2.1: element-typed fixed arrays `var a: T[N]` = N elements of T.
# The unambiguous SLOT spelling — `var a: i64[N]` reserves N i64 slots
# (8N bytes) both in-fn and top-level, fixing the address-taken-local
# slot-idiom footgun (issue 2026-06-11, daimon: a per-slot
# `store64(&parts + i*8)` into a byte-sized `var parts[4]` ran off the
# 8-byte backing). Bare `var a[N]` keeps its documented behavior
# (in-fn: N bytes; top-level: N slots).
#
# Method (6.6.16): every in-fn row declares an address-taken sentinel
# BEFORE its array, so the sentinel sits ABOVE the array, and checks
# (1) the bytes between the array and the sentinel are at least the
# array's size — a LITERAL byte count (32, 16, 8, 16, 16, 24, 32), so the
# row does not depend on sizeof accepting a scalar type name — and only
# then (2) fills every element in-bounds, reads them back and checks the
# sentinel survived. A failed (1) skips (2), so an under-sized array reds
# its own row instead of smashing the frame.
#
# LAYOUT ASSUMPTION: in-fn array locals live on the per-thread stack,
# laid out DOWNWARD in declaration order, and an array indexes UPWARD —
# so a local declared before the array has the higher address, and an
# overrun of the array runs into it. This holds on both native backends,
# x86_64 and aarch64, and every ELF / PE / Mach-O target is one of them
# (measured: x86_64 gap +32 for i64[4]; aarch64 under qemu +40, an 8-byte
# pad between the two, which is why the gap assertion and not the
# sentinel alone is what catches a one-element under-allocation there).
# The same layout carries tests/tcyr/crossos/typed_array_elem_size.tcyr
# on every real host. The file is not run on cx. If the layout ever
# flips, the gap goes negative and (1) reds every row rather than letting
# them pass vacuously.
#
# The frame rounds each array up (to 8 or 16 bytes, per backend), so a
# shrink the rounding absorbs leaves every byte still owned by the array
# and is not detectable here — nor is it an overrun. A compiler that sized
# `T[N]` as N bytes (the daimon class) reds the i64 / i32 / u32 / u64 /
# daimon rows on both backends; the pre-6.6.16 file passed it on x86 and
# crashed on aarch64.
#
# Before 6.6.16 each sentinel was declared AFTER its array, so it sat
# BELOW it, where no overrun can reach: the "sentinel intact" check could
# not detect under-allocation. Top-level arrays still lay out
# sequentially in .bss, so their byte gap is checked directly.

include "lib/assert.cyr"

# Row step (1): the sentinel at `ps` lies at least `n` bytes above the
# array at `pa`. Returns 1 when it does, so the caller may go on to fill.
fn gap_ok(ps, pa, n, what): i64 {
    var ok = 0;
    if (ps - pa >= n) { ok = 1; }
    assert(ok, what);
    return ok;
}

# --- in-fn element-typed capacity: gap first, then write all N elements;
#     sentinel intact (999) proves no under-allocation, all elements
#     readable proves the reserved element count. A failed gap returns 0. ---
fn cap_i64(): i64 {
    var s: i64[1]; var a: i64[4]; store64(&s, 999);
    if (gap_ok(&s, &a, 32, "i64[4]: sentinel >= 32 B above the array") == 0) { return 0; }
    store64(&a, 1); store64(&a + 8, 2); store64(&a + 16, 3); store64(&a + 24, 4);
    return load64(&a) + load64(&a + 8) + load64(&a + 16) + load64(&a + 24) + load64(&s);  # 10+999
}
fn cap_i32(): i64 {
    var s: i64[1]; var a: i32[4]; store64(&s, 999);
    if (gap_ok(&s, &a, 16, "i32[4]: sentinel >= 16 B above the array") == 0) { return 0; }
    store32(&a, 1); store32(&a + 4, 2); store32(&a + 8, 3); store32(&a + 12, 4);
    return load32(&a) + load32(&a + 4) + load32(&a + 8) + load32(&a + 12) + load64(&s);  # 10+999
}
fn cap_i16(): i64 {
    var s: i64[1]; var a: i16[4]; store64(&s, 999);
    if (gap_ok(&s, &a, 8, "i16[4]: sentinel >= 8 B above the array") == 0) { return 0; }
    store16(&a, 1); store16(&a + 2, 2); store16(&a + 4, 3); store16(&a + 6, 4);
    return load16(&a) + load16(&a + 2) + load16(&a + 4) + load16(&a + 6) + load64(&s);  # 10+999
}
fn cap_u8(): i64 {
    var s: i64[1]; var a: u8[16]; store64(&s, 999);
    if (gap_ok(&s, &a, 16, "u8[16]: sentinel >= 16 B above the array") == 0) { return 0; }
    var i = 0; while (i < 16) { store8(&a + i, i + 1); i = i + 1; }        # 1..16
    var sum = 0; var j = 0; while (j < 16) { sum = sum + load8(&a + j); j = j + 1; }  # 136
    return sum + load64(&s);                                              # 136+999
}
fn cap_u32(): i64 {
    var s: i64[1]; var a: u32[4]; store64(&s, 999);
    if (gap_ok(&s, &a, 16, "u32[4]: sentinel >= 16 B above the array") == 0) { return 0; }
    store32(&a, 1); store32(&a + 4, 2); store32(&a + 8, 3); store32(&a + 12, 4);
    return load32(&a) + load32(&a + 4) + load32(&a + 8) + load32(&a + 12) + load64(&s);  # 10+999
}
fn cap_u64(): i64 {
    var s: i64[1]; var a: u64[3]; store64(&s, 999);
    if (gap_ok(&s, &a, 24, "u64[3]: sentinel >= 24 B above the array") == 0) { return 0; }
    store64(&a, 1); store64(&a + 8, 2); store64(&a + 16, 3);
    return load64(&a) + load64(&a + 8) + load64(&a + 16) + load64(&s);   # 6+999
}

# --- daimon class: all 4 slots of an i64[4] are in-bounds; a sentinel
#     declared immediately BEFORE it sits above it and must survive
#     every slot write ---
fn slot_roundtrip() {
    var sentinel: i64[1];
    var a: i64[4];
    store64(&sentinel, 999);
    if (gap_ok(&sentinel, &a, 32, "daimon i64[4]: sentinel >= 32 B above the array") == 0) { return 0; }
    store64(&a + 0, 11);
    store64(&a + 8, 22);
    store64(&a + 16, 33);
    store64(&a + 24, 44);          # 4th slot — in-bounds for i64[4]
    var got = load64(&a) + load64(&a + 8) + load64(&a + 16) + load64(&a + 24);
    return got + load64(&sentinel); # 110 + 999 = 1109 iff sentinel intact
}

# --- bare local byte buffer still works at byte granularity ---
fn byte_buffer() {
    var b[8];
    store8(&b + 0, 7);
    store8(&b + 7, 9);
    return load8(&b + 0) + load8(&b + 7);   # 16
}

# --- top-level element-typed arrays (still .bss-sequential; gap probe valid) ---
var g_i64: i64[4];
var g_i64_after = 55;
var g_u8: u8[16];
var g_u8_after = 66;

fn top_i64_gap() { return &g_i64_after - &g_i64; }   # 4 slots -> 32
fn top_u8_gap()  { return &g_u8_after - &g_u8; }      # 16 bytes -> 16

test_group("in-fn element-typed array capacity (gap, then write-all + sentinel roundtrip)");
assert_eq(cap_i64(), 1009, "i64[4]: 4 slots writable, sentinel intact");
assert_eq(cap_i32(), 1009, "i32[4]: 4 i32 elements writable, sentinel intact");
assert_eq(cap_i16(), 1009, "i16[4]: 4 i16 elements writable, sentinel intact");
assert_eq(cap_u8(), 1135, "u8[16]: 16 bytes writable, sentinel intact");
assert_eq(cap_u32(), 1009, "u32[4]: 4 u32 elements writable, sentinel intact");
assert_eq(cap_u64(), 1005, "u64[3]: 3 u64 elements writable, sentinel intact");

test_group("daimon class fixed via slot spelling");
assert_eq(slot_roundtrip(), 1109, "all 4 i64[4] slots in-bounds; neighbor intact");

test_group("bare local byte buffer unchanged");
assert_eq(byte_buffer(), 16, "byte-granularity buffer still works");

test_group("top-level element-typed arrays (.bss gap)");
assert_eq(top_i64_gap(), 32, "top-level i64[4] reserves 32 bytes");
assert_eq(top_u8_gap(), 16, "top-level u8[16] reserves 16 bytes");

var rc = assert_summary();
