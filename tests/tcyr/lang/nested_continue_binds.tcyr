# v6.6.3: `continue` binds to its OWN loop at every nesting level.
#
# THE DEFECT (two halves, one shared slot). `0x18F8A0` is ONE flat 8-entry patch array
# holding the forward jumps a C-style `for`'s `continue`s need, and `0x18F898` is the
# next-free index into it — 1-based, where 0 doubles as "while-mode: jump straight to
# loop top" rather than "forward-patch to the step".
#
#   1. ARRAY ALIASING. Every loop reset the index to 1 on entry, so a nested loop began
#      writing at index 0 again and OVERWROTE the enclosing loop's recorded jump. The
#      inner `continue` then got patched to the OUTER latch (abandoning the rest of the
#      outer body) and the outer `continue` was never patched at all (a no-op). Strictly
#      lexical: the outer `continue` had to appear BEFORE the nested loop to claim index
#      0 first and have it stolen. Filed by hisab building a 32x32 product table.
#
#   2. MODE INHERITANCE. `PARSE_WHILE` never wrote `0x18F898`, so a `while` nested in a
#      `for` saw the for's non-zero count and forward-patched its `continue` to the FOR's
#      step. Not in the original filing — found while fixing (1), same slot, opposite half.
#
# ⚠ Both are SILENT WRONG CODE: no diagnostic, no crash, correct-looking source. The
# filing's own first version mis-described the symptom as "the inner continue exits the
# outer loop"; instrumenting showed the outer loop runs its full trip count and it is the
# outer BODY AFTER the nested loop that is skipped. Counts here are measured, not inferred.
#
# Closes issues/2026-09-11-nested-continue-binds-to-wrong-loop.md.
#
# 6.6.20 — THE SAME DEFECT ONE LEVEL DEEPER: a `while` BETWEEN the two `for`s. `while` zeroed the
# next-free index (it was also the while-mode flag), so the inner `for` started over at entry 0
# and stole the outer one's pending jump — 30 where 26 is right on x86, a `b .` hang on aarch64
# and cx, a fault through a closure or a generic instance. Sections 8-12 TAKE the outer
# `continue`, which is the hang off x86, so they live here and not in crossos/: check.sh runs
# this file on x86, and CI's native-arm64 job runs the whole tests/tcyr corpus with no per-test
# timeout, so there a regression of these shapes (or of sections 1-7) shows as a HANG until the
# job's timeout, not a fast failure. tests/tcyr/crossos/continue_binds_across_while.tcyr carries
# the timeout-safe shapes the release gate runs on the real hosts.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/fnptr.cyr"
include "lib/assert.cyr"

# 6.6.20 helpers — a generic whose body is while { for { continue } }, and one whose body is a
# plain for { continue } (instantiated inside a `while` below). i32 so the instance is emitted
# at the call, inside the loop.
fn cnt_while_for<T>(x: T): i64 {
    var n = 0;
    var w = 0;
    while (w < 1) {
        w = w + 1;
        for (var j = 0; j < 4; j = j + 1) {
            if (j == 0) { continue; }
            n = n + 1;
        }
    }
    return n;
}
fn cnt_for<T>(x: T): i64 {
    var n = 0;
    for (var j = 0; j < 4; j = j + 1) {
        if (j == 0) { continue; }
        n = n + 1;
    }
    return n;
}

fn main(): i64 {
    alloc_init();

    # ---- 1. the filed reproducer: outer `continue` lexically BEFORE the inner loop ----
    # The outer continue is NEVER TAKEN (c == 99 is impossible for c in 0..2). Its mere
    # presence was enough to mis-patch the inner one — which is what rules out a
    # misreading of `continue` semantics.
    var o = 0;
    for (var c = 0; c < 3; c = c + 1) {
        if (c == 99) { continue; }
        for (var d = 0; d < 3; d = d + 1) {
            if (d == 0) { continue; }
            o = o + 1;
        }
    }
    assert_eq(o, 6, "for-in-for: inner continue skips only the inner iteration");

    # ---- 2. the outer body AFTER the nested loop must still run ----
    # Pre-fix this counter read 0: the inner continue jumped to the outer latch.
    var after = 0;
    var inner_hits = 0;
    for (var e = 0; e < 3; e = e + 1) {
        if (e == 99) { continue; }
        for (var f = 0; f < 3; f = f + 1) {
            if (f == 0) { continue; }
            inner_hits = inner_hits + 1;
        }
        after = after + 1;
    }
    assert_eq(inner_hits, 6, "inner body entered 6 times (was 3)");
    assert_eq(after, 3, "outer body AFTER the nested loop runs every trip (was 0)");

    # ---- 3. an outer `continue` that DOES fire must actually skip ----
    var skipped = 0;
    for (var g = 0; g < 4; g = g + 1) {
        if (g == 1) { continue; }
        for (var h = 0; h < 2; h = h + 1) {
            if (h == 0) { continue; }
        }
        skipped = skipped + 1;
    }
    assert_eq(skipped, 3, "outer continue skips its own iteration (was a no-op)");

    # ---- 4. while nested in for — mode inheritance (half 2) ----
    var w = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var j = 0;
        while (j < 3) {
            j = j + 1;
            if (j == 1) { continue; }
            w = w + 1;
        }
    }
    assert_eq(w, 6, "while-in-for: continue goes to the WHILE's top, not the for's step");

    # ---- 5. for nested in while — the reverse direction ----
    var v = 0;
    var k = 0;
    while (k < 3) {
        k = k + 1;
        for (var m = 0; m < 3; m = m + 1) {
            if (m == 0) { continue; }
            v = v + 1;
        }
    }
    assert_eq(v, 6, "for-in-while: inner for's continue reaches its own step");

    # ---- 6. three levels deep, a continue at every level ----
    var t = 0;
    for (var p = 0; p < 3; p = p + 1) {
        if (p == 99) { continue; }
        for (var q = 0; q < 3; q = q + 1) {
            if (q == 0) { continue; }
            for (var r = 0; r < 3; r = r + 1) {
                if (r == 0) { continue; }
                t = t + 1;
            }
        }
    }
    assert_eq(t, 12, "three levels: 3 * 2 * 2 = 12");

    # ---- 7. break still binds to its own loop (separate chain — must not regress) ----
    var b = 0;
    for (var x = 0; x < 3; x = x + 1) {
        if (x == 99) { continue; }
        for (var y = 0; y < 5; y = y + 1) {
            if (y == 2) { break; }
            b = b + 1;
        }
        b = b + 100;
    }
    assert_eq(b, 306, "break exits only the inner loop (2 per trip + 100) * 3");

    # ---- 8. (6.6.20) a `while` between the fors, the outer `continue` taken first ----
    # i == 1 skips one outer trip (a = 2); the inner continue skips j == 0 (b = 2 * 3).
    var a8 = 0;
    var b8 = 0;
    for (var i8 = 0; i8 < 3; i8 = i8 + 1) {
        if (i8 == 1) { continue; }
        a8 = a8 + 1;
        var w8 = 0;
        while (w8 < 1) {
            w8 = w8 + 1;
            for (var j8 = 0; j8 < 4; j8 = j8 + 1) {
                if (j8 == 0) { continue; }
                b8 = b8 + 1;
            }
        }
    }
    assert_eq(a8 * 10 + b8, 26, "for / while / for: both continues bind (was 30)");

    # ---- 9. the same through range fors ----
    var a9 = 0;
    var b9 = 0;
    for i9 in 0..3 {
        if (i9 == 1) { continue; }
        a9 = a9 + 1;
        var w9 = 0;
        while (w9 < 1) {
            w9 = w9 + 1;
            for j9 in 0..4 {
                if (j9 == 0) { continue; }
                b9 = b9 + 1;
            }
        }
    }
    assert_eq(a9 * 10 + b9, 26, "range for / while / range for (was 30)");

    # ---- 10. the same through collection for-ins ----
    var v10 = vec_new();
    vec_push(v10, 0); vec_push(v10, 1); vec_push(v10, 2);
    var u10 = vec_new();
    vec_push(u10, 0); vec_push(u10, 1); vec_push(u10, 2); vec_push(u10, 3);
    var a10 = 0;
    var b10 = 0;
    for i10 in v10 {
        if (i10 == 1) { continue; }
        a10 = a10 + 1;
        var w10 = 0;
        while (w10 < 1) {
            w10 = w10 + 1;
            for j10 in u10 {
                if (j10 == 0) { continue; }
                b10 = b10 + 1;
            }
        }
    }
    assert_eq(a10 * 10 + b10, 26, "for-in / while / for-in (was 30)");

    # ---- 11. a closure body's while / for, inside a for with a taken continue ----
    var a11 = 0;
    var b11 = 0;
    for (var i11 = 0; i11 < 3; i11 = i11 + 1) {
        if (i11 == 1) { continue; }
        a11 = a11 + 1;
        var f11 = |x| { var n = 0; var w = 0; while (w < 1) { w = w + 1; for (var j = 0; j < 4; j = j + 1) { if (j == 0) { continue; } n = n + 1; } } return n + x; };
        b11 = b11 + fncall1(f11, 0);
    }
    assert_eq(a11 * 10 + b11, 26, "closure: while / for in its body (was SIGSEGV)");

    # ---- 12. generic instances: while / for in the body, and a for instantiated in a while ----
    var a12 = 0;
    var b12 = 0;
    for (var i12 = 0; i12 < 3; i12 = i12 + 1) {
        if (i12 == 1) { continue; }
        a12 = a12 + 1;
        var v12: i32 = 5;
        b12 = b12 + cnt_while_for<i32>(v12);
    }
    assert_eq(a12 * 10 + b12, 26, "generic instance: while / for in its body (was SIGSEGV)");
    var a13 = 0;
    var b13 = 0;
    for (var i13 = 0; i13 < 3; i13 = i13 + 1) {
        if (i13 == 1) { continue; }
        a13 = a13 + 1;
        var w13 = 0;
        while (w13 < 1) {
            w13 = w13 + 1;
            var v13: i32 = 5;
            b13 = b13 + cnt_for<i32>(v13);
        }
    }
    assert_eq(a13 * 10 + b13, 26, "generic for instantiated in a while (was SIGSEGV)");

    var res = assert_summary();
    return res;
}
