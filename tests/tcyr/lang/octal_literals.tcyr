# Octal integer literals (0o755) — v6.0.62
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/assert.cyr"

alloc_init();

test_group("octal literals");
assert_eq(0o0, 0, "0o0 = 0");
assert_eq(0o17, 15, "0o17 = 15");
assert_eq(0o10, 8, "0o10 = 8");
assert_eq(0o755, 493, "0o755 = 493");
assert_eq(0o755, 0x1ED, "0o755 == 0x1ED (octal/hex agree)");
assert_eq(0o777, 511, "0o777 = 511");
assert_eq(0o644, 420, "0o644 = 420 (file mode)");

test_group("octal with underscores");
assert_eq(0o7_5_5, 493, "0o7_5_5 = 493");

test_group("octal in expressions");
var perms = 0o644;
assert_eq(perms + 1, 421, "0o644 + 1");
assert_eq(0o10 * 0o10, 64, "0o10 * 0o10 = 64");

var r = assert_summary();
