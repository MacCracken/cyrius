# pointer_field_return_types.tcyr — 6.6.17 — `name: *T` as a struct or union FIELD and `*T` as a
# fn RETURN type (and a multi-value return element) parse, as an 8-byte pointer, the way
# `var p: *T` and a `p: *T` parameter always have.
#
# Before 6.6.17 every one of these was a parse error — `struct PH { name: *Str; }` and
# `fn f(): *Str` both read `expected identifier, got '*'` (measured on the 6.6.17-open compiler
# for *Str, *Pt, *i32, *u8 and *i64 alike), and a missing `;` cascade followed the return-type
# case. A pointer field / return is a full 8-byte word, and the value it yields is a POINTER:
# `p + n` on it steps sizeof(T) elements (`*u8` 1, `*i32` 4, `*Pt` 16, `*Str` 16, `**T` 8),
# and binding it to a `*T` local does not warn (the warning half is pinned by
# tests/gates/diagnostics/typed_pointer_warn_sign.sh axis 9). `#derive(accessors)` takes such a
# field as an 8-byte word; before, its `*` stopped the derive walk and every later field lost
# its accessors.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/assert.cyr"

struct Pt { x; y; }
struct PH { name: *Str; n; }                     # the filed shape
struct Q { p: *Pt; b: *u8; w: *i32; pp: **Pt; tail; }
union U { p: *Pt; raw; }
#derive(accessors)
struct D { p: *Pt; w: i32; tail; }
# 6.6.17 (review): a pointer to the struct being declared, or to one declared below, is sized
# when it is used — `next + 1` stepped the struct's size SO FAR (8 for Node, 8 for N3), and
# `p: *Later` was refused "declared after its use".
struct Node { val; next: *Node; }
struct N3 { next: *N3; a; b; }
struct MA { p: *MB; n; }
struct MB { x; y; q: *MA; }

fn name_of(h: *PH): *Str { return h.name; }      # the filed shape
fn first(q: *Q): *Pt { return q.p; }
fn bytes_of(q: *Q): *u8 { return q.b; }
fn pair(a: *Pt): (*Pt, i64) { return (a, 9); }
impl Pts for Pt { fn me(self): *Pt { return self; } }

var buf[64];
var arr: Pt[4];

fn layout(): i64 {
    assert_eq(sizeof(PH), 16, "sizeof a struct with a *Str field");
    assert_eq(sizeof(Q), 40, "sizeof a struct of four pointer fields and a word");
    assert_eq(sizeof(U), 8, "sizeof a union with a *Pt field");
    var q = Q { &arr, &buf, &buf, &buf, 7 };
    assert_eq(q.tail, 7, "the field after four pointer fields");
    assert_eq(q.p == &arr, 1, "a *Pt field holds the address");
    return 0;
}

fn field_steps(): i64 {
    var q: Q;
    q.p = &arr; q.b = &buf; q.w = &buf; q.pp = &buf; q.tail = 0;
    assert_eq(q.p + 1 == &arr + 16, 1, "*Pt field + 1 steps sizeof(Pt)");
    assert_eq(q.b + 3 == &buf + 3, 1, "*u8 field + 3 steps 3 bytes");
    assert_eq(q.w + 2 == &buf + 8, 1, "*i32 field + 2 steps 8 bytes");
    assert_eq(q.pp + 1 == &buf + 8, 1, "**Pt field + 1 steps a pointer");
    var s: Str = str_from("abc");
    var h: PH;
    h.name = s; h.n = 3;
    assert_eq(h.name == s, 1, "a *Str field holds the address");
    assert_eq(h.name + 1 == s + 16, 1, "*Str field + 1 steps sizeof(Str)");
    var u: U;
    u.p = &arr;
    assert_eq(u.p + 2 == &arr + 32, 1, "a union's *Pt field steps sizeof(Pt)");
    var e: *Pt = q.p;
    assert_eq(e == &arr, 1, "a *Pt field binds to a *Pt local");
    return 0;
}

fn return_steps(): i64 {
    var q: Q;
    q.p = &arr; q.b = &buf; q.w = &buf; q.pp = 0; q.tail = 0;
    assert_eq(first(&q) == &arr, 1, "fn(): *Pt returns the address");
    assert_eq(first(&q) + 1 == &arr + 16, 1, "fn(): *Pt result + 1 steps sizeof(Pt)");
    assert_eq(bytes_of(&q) + 5 == &buf + 5, 1, "fn(): *u8 result + 5 steps 5 bytes");
    var s: Str = str_from("abcd");
    var h: PH;
    h.name = s; h.n = 4;
    assert_eq(name_of(&h) == s, 1, "fn(): *Str returns the address");
    var a = Pt { 5, 6 };
    var p, n = pair(&a);
    assert_eq(p == &a, 1, "a (*Pt, i64) return's pointer element");
    assert_eq(n, 9, "a (*Pt, i64) return's i64 element");
    assert_eq(a.me() == &a, 1, "a method returning *Pt");
    assert_eq(a.me() + 1 == &a + 16, 1, "a method's *Pt result steps sizeof(Pt)");
    return 0;
}

fn derived(): i64 {
    var d: D;
    d.p = &arr; d.w = 5; d.tail = 9;
    assert_eq(D_p(&d) == &arr, 1, "#derive(accessors) getter of a *Pt field");
    assert_eq(D_w(&d), 5, "#derive(accessors) getter of the field after it");
    assert_eq(D_tail(&d), 9, "#derive(accessors) getter of the last field");
    D_set_tail(&d, 11);
    assert_eq(d.tail, 11, "#derive(accessors) setter of the last field");
    return 0;
}

fn linked(): i64 {
    var n: Node;
    n.next = &arr;
    assert_eq(n.next + 1 == &arr + 16, 1, "a self-referential *Node field steps sizeof(Node)");
    var t: N3;
    t.next = &arr;
    assert_eq(t.next + 1 == &arr + 24, 1, "*N3 declared before N3's other fields steps 24");
    var a: MA;
    a.p = &arr;
    assert_eq(a.p + 1 == &arr + 24, 1, "a *MB field, MB declared below, steps sizeof(MB)");
    var b: MB;
    b.q = &arr;
    assert_eq(b.q + 1 == &arr + 16, 1, "mutually-referencing structs: *MA steps sizeof(MA)");
    return 0;
}

alloc_init();
layout();
linked();
derived();
field_steps();
return_steps();
var r = assert_summary();
