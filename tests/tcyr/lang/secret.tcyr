# Test: `secret var buf[N];` — zeroise-on-scope-exit for local arrays.
#
# v6.3.15: array locals (incl. `secret var`) now live on the per-thread
# STACK, not shared .bss. The old probe — return `&key` and read it after
# the function returned — is a use-after-return on the stack and no longer
# valid. We instead verify the security property by frame reuse: after a
# secret-var function returns, a sibling function allocates a large stack
# window over the same region and scans it for the distinctive secret
# pattern. If the epilogue zeroise ran, the pattern is GONE (found == 0).
# A plain-var control proves the scan can actually observe survival.
include "lib/string.cyr"
include "lib/assert.cyr"

# Distinctive 64-bit pattern (high bit clear so it stays a positive i64).
var SEC = 0x5EC5EC5EC5EC5EC5;

# Fills a `secret var` with the pattern, then returns. The secret machinery
# must zero every slot at the epilogue on EVERY return path.
fn write_secret(): i64 {
    secret var key: i64[8];
    var i = 0;
    while (i < 8) { store64(&key + i * 8, SEC); i = i + 1; }
    return 0;                       # zeroise runs here
}

# Control: a PLAIN var is NOT scrubbed — its pattern survives on the stack.
fn write_plain(): i64 {
    var buf: i64[8];
    var i = 0;
    while (i < 8) { store64(&buf + i * 8, SEC); i = i + 1; }
    return 0;
}

# Sibling with a large stack window covering the region the arrays used.
# Returns how many slots still hold the secret pattern.
fn scan_for_secret(): i64 {
    var window: i64[64];            # 512-byte window over the reused frame region
    var found = 0;
    var i = 0;
    while (i < 64) {
        if (load64(&window + i * 8) == SEC) { found = found + 1; }
        i = i + 1;
    }
    return found;
}

test_group("secret var scrubbed on scope exit (stack)");
write_secret();
assert_eq(scan_for_secret(), 0, "secret var: pattern GONE from the stack after return (zeroed)");

test_group("plain var control — pattern survives (scan can observe it)");
write_plain();
var survivors = scan_for_secret();
assert_eq(survivors > 0, 1, "plain var: pattern SURVIVES on the stack (proves the scan detects it)");

var r = assert_summary();
