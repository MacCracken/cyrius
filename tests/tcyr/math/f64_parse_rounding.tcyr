# f64_parse_rounding.tcyr — 6.6.13 (I4). f64_parse returns the CORRECTLY ROUNDED double.
#
# Until 6.6.13 lib/math.cyr's f64_parse accumulated digits in f64 and scaled by repeated
# *10 / /10, so every digit and every power-of-ten step rounded: 2,270 of the 10,000
# literals 0.00..99.99 came back 1 ulp off, `0.0001e310` overflowed to Inf, `123e-310`
# and `5e-324` flushed to 0, and DBL_MIN read 2 ulp high. It is now a port of bayan
# 1.5.10's three-tier parser (Clinger / cached-power DiyFp / exact decimal).
#
# ⭐ EVERY EXPECTED VALUE COMES FROM OUTSIDE THE CODE UNDER TEST:
#   * the corpora are bayan 1.5.10's tests/fixtures/numeric/{f64parse,f64}.vec, copied
#     verbatim to tests/data/f64parse/ — `<hexbits> <decimal text>` per line, bits from a
#     strtod-class oracle. The legacy parser got 6,285 of f64parse.vec and 253 of f64.vec
#     wrong; this file asserts 0.
#   * the 10,000 two-decimal literals "dd.dd" are checked against IEEE division: the literal
#     IS n / 100 exactly, n and 100 are exact doubles, and one IEEE divide is correctly
#     rounded, so f64_div(f64_from(n), 100.0) is the correctly rounded value whatever path
#     the parser takes. (Until 6.7.10 the oracle was bayan_f64_parse, a separate copy of
#     the algorithm; bayan 1.5.14 delegates to f64_parse_n, so that check compared the
#     stdlib with itself — CHANGELOG [6.7.10].)
#   * bayan_f64_parse is still run beside the stdlib on every corpus vector and row: since
#     bayan 1.5.14 it is bayan's lenient front over f64_parse_n, and those rows pin that the
#     delegation answers as the stdlib does (and that lib/bayan.cyr and lib/math.cyr coexist).
#   * the filed repro's rows and the front-matter cases carry hard-coded bits.
# 6.7.9: every vector also runs through the public length-bounded f64_parse_n (issue
# 2026-10-08) with its explicit length and two more digits written right after the span
# — any read past n changes the value — and the bounded rows run with the span ending
# at a PROT_NONE page, so a read of s[n] faults instead of passing unseen.
# A corpus COUNT FLOOR guards the read: an unreadable or truncated file fails here, it
# does not pass green with zero vectors checked.
#
# CWD = repo root (check.sh and `cyrius test` run there); the corpora are opened at the
# relative path tests/data/f64parse/.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/hashmap.cyr"
include "lib/result.cyr"
include "lib/fnptr.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/mmap.cyr"
include "lib/math.cyr"
include "lib/bayan.cyr"
include "lib/assert.cyr"

alloc_init();

fn _fpr_out(s) { syscall(SYS_WRITE, 1, s, strlen(s)); return 0; }

var _fpr_ok_mismatch = 0;
var _fpr_n_wrong = 0;

# Run one `<hexbits> <text>` corpus. Returns the number of vectors read; adds the
# wrong ones to the assertion tally (the first three are printed with their bits).
fn _fpr_corpus(path, floor) {
    var cap = 1 << 20;
    var buf = alloc(cap);
    var len = file_read_all(path, buf, cap);
    assert_gt(len, 0, path);
    if (len <= 0) { return 0; }
    assert_lt(len, cap, "corpus fits the read buffer");
    var tb = alloc(1040);
    var pos = 0;
    var cnt = 0;
    var bad = 0;
    var bay = 0;
    while (pos < len) {
        var bits = 0;
        while (pos < len) {
            var c = load8(buf + pos);
            var d = 0 - 1;
            if (c >= 48 && c <= 57)  { d = c - 48; }
            if (c >= 97 && c <= 102) { d = c - 87; }
            if (d < 0) { break; }
            bits = (bits << 4) | d;
            pos = pos + 1;
        }
        if (pos < len && load8(buf + pos) == 32) { pos = pos + 1; }
        var ts = pos;
        while (pos < len && load8(buf + pos) != 10) { pos = pos + 1; }
        var tlen = pos - ts;
        pos = pos + 1;
        if (tlen <= 0) { continue; }
        if (tlen >= 1024) { bad = bad + 1; continue; }
        memcpy(tb, buf + ts, tlen);
        store8(tb + tlen, 0);
        cnt = cnt + 1;
        var got = f64_parse(tb);
        var o = 0;
        if (f64_parse_ok(tb, &o) != 1 || o != got) { _fpr_ok_mismatch = _fpr_ok_mismatch + 1; }
        if (bayan_f64_parse(tb, tlen) != got) { bay = bay + 1; }
        # the span followed by digits: "77" continues the mantissa or the exponent
        store8(tb + tlen, 55); store8(tb + tlen + 1, 55); store8(tb + tlen + 2, 0);
        if (f64_parse_n(tb, tlen) != bits) {
            if (_fpr_n_wrong < 3) {
                store8(tb + tlen, 0);
                _fpr_out("  f64_parse_n WRONG "); _fpr_out(tb); _fpr_out(" got ");
                fmt_hex0x(f64_parse_n(tb, tlen)); _fpr_out("\n");
            }
            _fpr_n_wrong = _fpr_n_wrong + 1;
        }
        if (got != bits) {
            if (bad < 3) {
                _fpr_out("  WRONG "); _fpr_out(tb); _fpr_out(" got "); fmt_hex0x(got);
                _fpr_out(" want "); fmt_hex0x(bits); _fpr_out("\n");
            }
            bad = bad + 1;
        }
    }
    assert_eq(bad, 0, "corpus vectors wrong");
    assert_eq(bay, 0, "corpus vectors where f64_parse and bayan_f64_parse disagree");
    assert_gte(cnt, floor, "corpus vector count floor");
    return cnt;
}

test_group("bayan 1.5.10 corpora, bit-exact");
_fpr_corpus("tests/data/f64parse/f64parse.vec", 7700);
_fpr_corpus("tests/data/f64parse/f64.vec", 328);
assert_eq(_fpr_ok_mismatch, 0, "f64_parse_ok returns 1 and the f64_parse bits for every vector");
assert_eq(_fpr_n_wrong, 0, "corpus vectors f64_parse_n(span, len) gets wrong with digits after the span");

test_group("the 10,000 literals 0.00 .. 99.99 against IEEE division (n / 100)");
fn _fpr_two_decimals() {
    var tb = alloc(16);
    var bad = 0;
    var n = 0;
    while (n < 10000) {
        var ip = n / 100;
        var fp = n % 100;
        var w = 0;
        if (ip >= 10) { store8(tb + w, 48 + ip / 10); w = w + 1; }
        store8(tb + w, 48 + ip % 10); w = w + 1;
        store8(tb + w, 46); w = w + 1;
        store8(tb + w, 48 + fp / 10); w = w + 1;
        store8(tb + w, 48 + fp % 10); w = w + 1;
        store8(tb + w, 0);
        var got = f64_parse(tb);
        if (got != f64_div(f64_from(n), f64_from(100))) {
            if (bad < 3) { _fpr_out("  WRONG "); _fpr_out(tb); _fpr_out("\n"); }
            bad = bad + 1;
        }
        if (bayan_f64_parse(tb, w) != got) {
            if (bad < 3) { _fpr_out("  bayan_f64_parse disagrees "); _fpr_out(tb); _fpr_out("\n"); }
            bad = bad + 1;
        }
        store8(tb + w, 55); store8(tb + w + 1, 0);     # "12.347": the span is 5 bytes
        if (f64_parse_n(tb, w) != got) {
            if (bad < 3) { _fpr_out("  f64_parse_n WRONG "); _fpr_out(tb); _fpr_out("\n"); }
            bad = bad + 1;
        }
        n = n + 1;
    }
    assert_eq(bad, 0, "two-decimal literals that differ from n / 100 (or where f64_parse_n / bayan_f64_parse disagree)");
    assert_eq(n, 10000, "two-decimal literal count");
    return 0;
}
_fpr_two_decimals();

test_group("the filed repro's rows (issue 2026-09-30)");
fn _fpr_row(s, want) {
    assert_eq(f64_parse(s), want, s);
    assert_eq(f64_parse_n(s, strlen(s)), want, s);
    assert_eq(bayan_f64_parse(s, strlen(s)), want, s);
    return 0;
}
_fpr_row("0.3", 0x3FD3333333333333);
_fpr_row("0.12", 0x3FBEB851EB851EB8);
_fpr_row("0.15", 0x3FC3333333333333);
_fpr_row("9.95", 0x4023E66666666666);
_fpr_row("2.2250738585072014e-308", 0x0010000000000000);
_fpr_row("8.98846567431158e307", 0x7FE0000000000000);
_fpr_row("0.0001e310", 0x7F76C8E5CA239029);
_fpr_row("123e-310", 0x0008D83AFF3E96B1);
_fpr_row("5e-324", 0x0000000000000001);
_fpr_row("1.5", 0x3FF8000000000000);
_fpr_row("100", 0x4059000000000000);
_fpr_row("0.5", 0x3FE0000000000000);

test_group("front matter is unchanged");
assert_eq(f64_parse("nan"), 0x7FF8000000000000, "nan");
assert_eq(f64_parse("NaN"), 0x7FF8000000000000, "NaN");
assert_eq(f64_parse("-nan"), 0x7FF8000000000000, "-nan (sign ignored, as before)");
assert_eq(f64_parse("inf"), 0x7FF0000000000000, "inf");
assert_eq(f64_parse("Infinity"), 0x7FF0000000000000, "Infinity (3-letter prefix)");
assert_eq(f64_parse("-inf"), 0xFFF0000000000000, "-inf");
assert_eq(f64_parse("null"), 0, "null is not a NaN here (bayan's core says NaN)");
assert_eq(f64_parse("n"), 0, "n");
assert_eq(f64_parse("in"), 0, "in");
assert_eq(f64_parse("x"), 0, "x");
assert_eq(f64_parse(""), 0, "empty");
assert_eq(f64_parse("   "), 0, "whitespace only");
assert_eq(f64_parse("-"), 0, "a bare sign");
assert_eq(f64_parse("-."), 0, "a sign and a dot, no digits");
assert_eq(f64_parse("-0"), 0x8000000000000000, "-0");
assert_eq(f64_parse(" \t -1.5"), 0xBFF8000000000000, "leading spaces and tabs");
assert_eq(f64_parse("+2"), 0x4000000000000000, "+2");
assert_eq(f64_parse(".5"), 0x3FE0000000000000, ".5");
assert_eq(f64_parse("5."), 0x4014000000000000, "5.");
assert_eq(f64_parse("1e"), 0x3FF0000000000000, "1e (no exponent digits)");
assert_eq(f64_parse("1.5xyz"), 0x3FF8000000000000, "stops at the first non-number byte");
assert_eq(f64_parse("1e100000000"), 0x7FF0000000000000, "1e100000000 -> +Inf (saturated exponent)");
assert_eq(f64_parse("-1e100000000"), 0xFFF0000000000000, "-1e100000000 -> -Inf");
assert_eq(f64_parse("1e-100000000"), 0, "1e-100000000 -> 0");

test_group("f64_parse_ok gate is unchanged");
var _fpr_o = 7;
assert_eq(f64_parse_ok("", &_fpr_o), 0, "ok: empty");
assert_eq(f64_parse_ok("  \t", &_fpr_o), 0, "ok: whitespace only");
assert_eq(f64_parse_ok("x1", &_fpr_o), 0, "ok: non-numeric start");
assert_eq(f64_parse_ok("-x", &_fpr_o), 0, "ok: sign then non-numeric");
assert_eq(_fpr_o, 7, "ok: out untouched on failure");
assert_eq(f64_parse_ok("0.3", &_fpr_o), 1, "ok: 0.3");
assert_eq(_fpr_o, 0x3FD3333333333333, "ok: 0.3 bits");
assert_eq(f64_parse_ok("-inf", &_fpr_o), 1, "ok: -inf");
assert_eq(_fpr_o, 0xFFF0000000000000, "ok: -inf bits");

test_group("f64_parse_n: the span s[0..n) (issue 2026-10-08)");
# _fpn(text, n, want): f64_parse_n over the first n bytes of text.
fn _fpn(s, n, want) { return assert_eq(f64_parse_n(s, n), want, s); }
assert_eq(f64_parse("2.57,"), 0x40048F5C28F5C28F, "the filed repro: f64_parse reads past the field");
_fpn("2.57,", 3, 0x4004000000000000);              # the filed repro: the field "2.5"
_fpn("2.57,", 4, 0x40048F5C28F5C28F);
_fpn("2.57,", 5, 0x40048F5C28F5C28F);
_fpn("123456", 3, 0x405EC00000000000);
_fpn("0.30000000000000004", 3, 0x3FD3333333333333);
_fpn("1e57", 3, 0x40F86A0000000000);               # the exponent ends at n: 1e5
_fpn("1e57", 2, 0x3FF0000000000000);               # "1e": no exponent digits
_fpn("1e-3", 3, 0x3FF0000000000000);               # "1e-"
_fpn("1.5e+37", 6, 0x4097700000000000);            # 1.5e+3
_fpn("-0.5x", 4, 0xBFE0000000000000);
_fpn(" \t -1.5", 7, 0xBFF8000000000000);
_fpn("+2", 2, 0x4000000000000000);
_fpn(".5", 2, 0x3FE0000000000000);
_fpn(".5", 1, 0);                                  # "." alone: no digits
_fpn("5.", 2, 0x4014000000000000);
_fpn("-0", 2, 0x8000000000000000);
_fpn("-1.5", 1, 0);                                # a bare sign
_fpn("  1.5", 2, 0);                               # whitespace only
_fpn("1.5", 0, 0);
_fpn("1.5", 0 - 1, 0);
# The digits after the span decide a tie: in the span it is a tie (to even); read past
# n it is above the tie. Tier 2 / tier 3 (trunc) and the exact decimal see only s[0..n).
_fpn("90071992547409930001", 16, 0x4340000000000000);
_fpn("9007199254740993.0001", 16, 0x4340000000000000);
_fpn("9007199254740993.0001", 21, 0x4340000000000001);
_fpn("4503599627370496.50000000000000000001", 18, 0x4330000000000000);
_fpn("4503599627370496.50000000000000000001", 37, 0x4330000000000001);
_fpn("2.2250738585072011e-3087", 23, 0x000FFFFFFFFFFFFF);
_fpn("12345678901234567890123456", 23, 0x4484EA15B273B38A);
# A NUL inside the span ends the number, as any non-number byte does.
var _fpn_nul = alloc(8);
store8(_fpn_nul, 49); store8(_fpn_nul + 1, 46); store8(_fpn_nul + 2, 53);
store8(_fpn_nul + 3, 0); store8(_fpn_nul + 4, 57); store8(_fpn_nul + 5, 0);
assert_eq(f64_parse_n(_fpn_nul, 5), 0x3FF8000000000000, "1.5 NUL 9 at n = 5");

test_group("f64_parse_n: f64_parse's strict nan / inf, whole inside the span");
_fpn("nan", 3, 0x7FF8000000000000);
_fpn("NaN,", 3, 0x7FF8000000000000);
_fpn("-nan", 4, 0x7FF8000000000000);
_fpn("nan", 2, 0);                                 # "na"
_fpn("nan", 1, 0);
_fpn("inf", 3, 0x7FF0000000000000);
_fpn("Infinity", 3, 0x7FF0000000000000);
_fpn("-inf", 4, 0xFFF0000000000000);
_fpn("-inf", 3, 0);                                # "-in"
_fpn("inf", 1, 0);
_fpn("null", 4, 0);                                # strict: not a NaN ...
assert_eq(_f64_parse_n("null", 4), 0x7FF8000000000000, "... where the lenient core says NaN");
_fpn("i1", 2, 0);
_fpn("x1", 2, 0);

test_group("f64_parse_n never reads s[n]: each span ends at a PROT_NONE page");
# A 64 KiB guard (a whole page at 4 / 16 / 64 KiB) after 64 KiB of readable memory.
# 6.7.12: the flags are the named MAP_PRIVATE | MAP_ANONYMOUS. The literal 34 is Linux's value; on
# Darwin MAP_ANONYMOUS is 0x1000, so 34 asked for a FILE mapping of fd -1 (EBADF) and the rows
# below wrote through the failed mapping (SIGSEGV on ecb and ach). CHANGELOG [6.7.12]
var _fpg = cyr_mmap(0, 131072, 3, MAP_PRIVATE | MAP_ANONYMOUS, 0 - 1, 0);
assert_gt(_fpg, 0, "guard mapping");
#ifndef CYRIUS_TARGET_WIN
assert_eq(cyr_mprotect(_fpg + 65536, 65536, 0), 0, "guard page PROT_NONE");
#endif
#ifdef CYRIUS_TARGET_WIN
# No PROT_NONE page on Windows: cyr_mprotect is the documented -38 decline (VirtualProtect has no
# reroute — lib/mmap.cyr). The rows below still run, against readable memory past each span, so
# there they check the values, not the bound. CHANGELOG [6.7.12]
var _fpg_skip = "  SKIP (windows): no PROT_NONE guard page (cyr_mprotect declines): the rows check values only\n";
sys_write(1, _fpg_skip, strlen(_fpg_skip));
assert_eq(cyr_mprotect(_fpg + 65536, 65536, 0), 0 - 38, "cyr_mprotect declines on Windows (-38): why there is no guard page");
#endif
fn _fpg_row(s, want) {
    var n = strlen(s);
    var p = _fpg + 65536 - n;
    memcpy(p, s, n);
    return assert_eq(f64_parse_n(p, n), want, s);
}
_fpg_row("nan", 0x7FF8000000000000);
_fpg_row("na", 0);
_fpg_row("n", 0);
_fpg_row("-inf", 0xFFF0000000000000);
_fpg_row("in", 0);
_fpg_row("i", 0);
_fpg_row("-", 0);
_fpg_row(" ", 0);
_fpg_row("7", 0x401C000000000000);
_fpg_row("1.", 0x3FF0000000000000);
_fpg_row("1e", 0x3FF0000000000000);
_fpg_row("1e-", 0x3FF0000000000000);
_fpg_row("1.5e+3", 0x4097700000000000);
_fpg_row("9007199254740993", 0x4340000000000000);
_fpg_row("12345678901234567890123", 0x4484EA15B273B38A);
_fpg_row("2.2250738585072011e-308", 0x000FFFFFFFFFFFFF);
_fpg_row("2.225073858507201136057409796709131975934819546351645648e-308", 0x000FFFFFFFFFFFFF);

var r = assert_summary();
