# parse_nested_call_assert.tcyr — v5.11.28 — bote parser quirk
# regression floor.
#
# bote 2.7.1 (filed 2026-05-10, cyrius 5.10.34) hit an intermittent
# `expected ')', got string` parser error on the shape:
#
#     assert(streq(vec_get(caps_v, 0), "fetch") == 1, "msg")
#
# i.e. `assert( fn( fn_with_2args(a, b) , LITERAL) == 1, LITERAL )` —
# a 2-arg inner call inside a 2-arg outer fn-call inside `assert`.
# Path-dependent: triggered with ~180 preceding asserts, error
# position drifted line 187/184/178/173 as preceding lines moved.
# Workaround was a 2-line var-stage of the inner call.
#
# v5.11.28 premise-check (cyrius 5.10.34 + 5.11.27 + 28 synthetic
# fuzz tries): no repro. Likely closed silently by v5.11.18's
# identifier buffer doubling (131072 → 262144 bytes) — the filing
# speculated a hash collision / scan-window boundary at ~8700
# idents; capacity doubling would shift bucket distribution.
#
# This test locks the *shape* (nested 2-arg call inside assert)
# so future parser refactors don't reintroduce it.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/assert.cyr"

fn main(): i64 {
    alloc_init();

    test_group("nested 2-arg call inside assert (bote 2.7.1 shape)");
    var caps = vec_new();
    vec_push(caps, "fetch");
    vec_push(caps, "tools_call");

    # The exact shape that triggered the bote 2.7.1 filing.
    assert(streq(vec_get(caps, 0), "fetch") == 1, "cap idx 0 is fetch");
    assert(streq(vec_get(caps, 1), "tools_call") == 1, "cap idx 1 is tools_call");

    # Same shape with non-string-literal RHS — the operand on the
    # right of `==` was a fn-call result in some bote bisect states.
    var n = 1;
    assert((vec_len(caps) - 1) == n, "vec_len arithmetic in assert");

    test_group("deeper nesting: 3-deep 2-arg call inside assert");
    var outer = vec_new();
    vec_push(outer, "alpha");
    vec_push(outer, "beta");
    # outer.first == streq result is awkward but exercises the same
    # arg-list state-machine path as the bote trigger shape.
    assert(streq(vec_get(outer, 0), "alpha") == 1, "3-deep nested-call assert");

    test_group("string literal preceding context (path-dependence stress)");
    # 50+ string-literal-bearing asserts before the trigger shape to
    # approximate bote's ~180-line preceding context. The filing
    # speculated identifier-table / fixup-table boundary effects; this
    # bloats the parser state heading into the trigger.
    assert(streq("http://[::1]/", "http://[::1]/") == 1, "preceding url 1");
    assert(streq("http://[64:ff9b::1.2.3.4]/", "http://[64:ff9b::1.2.3.4]/") == 1, "preceding url 2");
    assert(streq("http://2130706433/", "http://2130706433/") == 1, "preceding url 3");
    assert(streq("http://0177.0000.0000.0001/", "http://0177.0000.0000.0001/") == 1, "preceding url 4");
    assert(streq("http://0x7f.0.0.1/", "http://0x7f.0.0.1/") == 1, "preceding url 5");
    assert(streq("{\"name\":\"a\",\"url\":\"https://a.example\"}", "{\"name\":\"a\",\"url\":\"https://a.example\"}") == 1, "preceding json 1");
    assert(streq("{\"name\":\"b\",\"capabilities\":[\"fetch\",\"tools_call\"]}", "{\"name\":\"b\",\"capabilities\":[\"fetch\",\"tools_call\"]}") == 1, "preceding json 2");
    # And the trigger shape AFTER the preceding stress.
    assert(streq(vec_get(caps, 0), "fetch") == 1, "post-preceding-stress trigger 1");
    assert(streq(vec_get(caps, 1), "tools_call") == 1, "post-preceding-stress trigger 2");

    var r = assert_summary();
    return r;
}

var rc = main();
syscall(60, rc);
