# Test: parser cosmetic limits closed at v5.10.48 defensive sweep.
# Closes `docs/development/issues/2026-05-03-parser-cosmetic-limits-
# bare-return-and-var-bracket.md` — both `bare_return_in_if_block_
# rejected` and `var_bracket_size_must_be_literal`.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/assert.cyr"

# ---- bare return; in if-block ----
fn taken_branch(x: i64): i64 {
    if (x > 0) { return; }   # x=1 → return 0
    return 42;
}

fn not_taken_branch(x: i64): i64 {
    if (x > 0) { return; }   # x=-1 → fall through to return 42
    return 42;
}

# ---- enum-named array size ----
enum BufSz { SMALL = 8; }
var small_buf[SMALL];      # top-level — PARSE_GVAR_ARR path

# In-fn array: write to slots [0..SMALL-1] and read back. If
# PARSE_ARRAY accepted the SMALL ident correctly, the array is
# the right size and all slots are addressable.
fn fn_local_buf(): i64 {
    var local_b[SMALL];
    var i = 0;
    while (i < 8) {
        store64(&local_b + i * 8, i + 100);
        i = i + 1;
    }
    var sum = 0;
    var j = 0;
    while (j < 8) {
        sum = sum + load64(&local_b + j * 8);
        j = j + 1;
    }
    return sum;     # 100+101+...+107 = 828
}

fn main(): i64 {
    alloc_init();

    test_group("bare `return;` synthesizes `return 0;`");
    assert_eq(taken_branch(1),     0,  "x>0 → bare return = 0");
    assert_eq(not_taken_branch(0 - 1), 42, "x<=0 → fall-through to return 42");

    test_group("enum-named array sizes (in-fn PARSE_ARRAY path)");
    # SMALL = 8 (8 i64 slots). Write 100..107 to slots; sum=828.
    assert_eq(fn_local_buf(), 828, "in-fn local_b SMALL → 8 slots writable+readable");

    test_group("enum-named array sizes (top-level PARSE_GVAR_ARR path)");
    store64(&small_buf + 0, 11);
    store64(&small_buf + 56, 77);   # slot 7 (last in SMALL=8 array)
    assert_eq(load64(&small_buf + 0),  11, "top-level array slot 0");
    assert_eq(load64(&small_buf + 56), 77, "top-level array slot 7 (last)");

    var r = assert_summary();
    return r;
}

var rc = main();
syscall(60, rc);
