# The assertion + allocator + fmt + string surface a .tcyr needs, with NO file
# I/O, threads, floats or syscalls beyond write/exit — so it runs on EVERY
# target INCLUDING the cyrius-x bytecode VM, whose guest can only reach
# read/write/open/close/lseek/exit through cxvm.
#
# WHY IT EXISTS (v6.6.6): before this release `include "lib/assert.cyr"` did
# not compile for cx at all. The cx driver predefined no CYRIUS_TARGET_* macro,
# so every per-target `#ifdef` arm in the stdlib matched nothing (`undefined
# function(s) called (cx backend): alloc, vec_get, alloc_reset, sys_exit`), and
# fmt.cyr's undeclared vec_get dependency hard-errors on a backend with no DCE.
# So NO .tcyr had ever run on cx, and the whole target's coverage was
# hand-written syscall-only programs. Pinned on cxvm by
# tests/gates/toolchain/cx_tcyr_runs.sh. See CHANGELOG [6.6.6].
#
# ⭐ vec AND the `>=`/`<=` asserts are covered here as of bite 21. Both were
# written around when this file was first added: `vec_get(v, 0)` on a populated
# vec aborted "index out of bounds" and assert_gte/assert_lte scored backwards,
# and both were the SAME cx defect — ESETCC synthesised `(a<b)|(a==b)` with the
# strict half emitted to the wrong destination register, so the `or` folded in
# whatever the last shift had parked in the scratch. Fixed in
# src/backend/cx/emit.cyr; the workarounds are gone, which is what makes this
# file a regression test for it. CHANGELOG [6.6.6].
include "lib/assert.cyr";

# --- allocator: a bump alloc that is 8-aligned and actually writable ---
var p = alloc(64);
assert_nonnull(p, "alloc(64) returns memory");
assert_eq(p & 7, 0, "alloc is 8-byte aligned");
store64(p, 0x5A5A5A5A);
store64(p + 56, 7);
assert_eq(load64(p), 0x5A5A5A5A, "first qword round-trips");
assert_eq(load64(p + 56), 7, "last qword round-trips");

var before = alloc_used();
var q = alloc(32);
assert_nonnull(q, "second alloc succeeds");
assert_neq(p, q, "two allocations do not overlap");
var after = alloc_used();
# assert_gte, deliberately: it evaluates `a >= b` in CALL-ARGUMENT position,
# which is exactly the shape bite 21a fixed on cx. Written as `> 31` before.
var grew = after - before;
assert_gte(grew, 32, "alloc_used advances by at least the request");
var pend = p + 63;
assert_gt(q, pend, "the second block starts past the first");

# --- fmt: integer formatting into a caller buffer ---
var buf[24];
var n = fmt_int_buf(0 - 4207, &buf);
assert_eq(n, 5, "fmt_int_buf writes 5 bytes for -4207");
assert_eq(load8(&buf), 45, "fmt_int_buf emits the minus sign");
assert_eq(load8(&buf + 4), 55, "fmt_int_buf emits the last digit");

# --- vec: the container whose vec_get aborted on cx until bite 21a ---
var v = vec_new();
vec_push(v, 11);
vec_push(v, 22);
assert_eq(vec_len(v), 2, "vec_len after two pushes");
assert_eq(vec_get(v, 0), 11, "vec_get reads element 0 (the shape that aborted on cx)");
assert_eq(vec_get(v, 1), 22, "vec_get reads the last element");

# --- string: strlen + the harness's own string comparison ---
var s = "cyrius-x";
assert_eq(strlen(s), 8, "strlen over a literal");
assert_streq(s, "cyrius-x", "assert_streq over equal literals");

var r = assert_summary();
