# Test: fdlopen_init_trusted (v6.1.29) — the setuid-safe helper trust check.
# fdlopen (foreign-dlopen) bootstraps host glibc, so it is x86_64-Linux only;
# everywhere else (AGNOS / macOS / Windows / aarch64) it returns -6 (unsupported).
# The full trust assertions are gated to x86-Linux; the off-platform behavior (-6)
# is asserted on its own path — the test asserts on every target.
#
# ROOT-SAFE: the x86-Linux block runs both as a normal user (local) and as ROOT
# (the CI "Test (AGNOS)" job runs x86-Linux binaries inside the agnosticos
# container with --user root). So rejection tests use mode/type checks (which a
# root-created temp file still fails), NOT ownership (a root-created file is uid 0
# and would be wrongly trusted), and the positive case manufactures a root-owned
# file when running as root / falls back to /etc/passwd otherwise.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/assert.cyr"
include "lib/fdlopen.cyr"
include "lib/mmap.cyr"
include "lib/dynlib.cyr"

# v6.6.6: a PER-PROCESS scratch name. This test used fixed /tmp names, shared by every concurrent
# run of the suite (two check.sh at once), so one run deleted or rewrote another's file
# mid-assert. The pid is taken once, so a forked child names the same files. CHANGELOG [6.6.6]
var _scratch_pid = 0;
fn _scratch(name, suffix): i64 {   # "/tmp/<name>.<pid><suffix>", NUL-terminated
    if (_scratch_pid == 0) { _scratch_pid = sys_getpid(); }
    var nl = strlen(name);
    var sl = strlen(suffix);
    var p = alloc(nl + sl + 32);
    memcpy(p, "/tmp/", 5);
    memcpy(p + 5, name, nl);
    var o = 5 + nl;
    store8(p + o, 46);
    o = o + 1;
    var d[24];
    var n = 0;
    var v = _scratch_pid;
    while (n == 0 || v > 0) {
        var q = v / 10;
        store8(&d + n, 48 + v - q * 10);
        n = n + 1;
        v = q;
    }
    while (n > 0) {
        n = n - 1;
        store8(p + o, load8(&d + n));
        o = o + 1;
    }
    memcpy(p + o, suffix, sl);
    store8(p + o + sl, 0);
    return p;
}

alloc_init();

var st[256];
var rc = fdlopen_init_trusted(&st);

#ifdef CYRIUS_TARGET_LINUX
#ifdef CYRIUS_ARCH_X86
# ── x86_64 Linux: full trust check ──

test_group("verify_trusted — accept a root-owned regular file");
var euid = sys_geteuid();
if (euid == 0) {
    # Running as root (CI agnos container): manufacture a root-owned 0644 file.
    var gfd = sys_open(_scratch("fdl_good_helper", ""), 0x41, 0x1A4);  # O_WRONLY|O_CREAT
    sys_write(gfd, "x", 1);
    sys_close(gfd);
    sys_chmod(_scratch("fdl_good_helper", ""), 0x1A4);                 # 0644 (defeat umask)
    var v_good = _fdlopen_verify_trusted(_scratch("fdl_good_helper", ""));
    assert_eq(v_good, 1, "root-owned 0644 regular file is trusted");
    sys_unlink(_scratch("fdl_good_helper", ""));
}
if (euid != 0) {
    # Non-root (local dev): /etc/passwd is root:root, regular, 644.
    var v_pw = _fdlopen_verify_trusted("/etc/passwd");
    assert_eq(v_pw, 1, "/etc/passwd is trusted (root:root regular, not world-writable)");
}

test_group("verify_trusted — reject untrusted (root-safe: mode/type, not uid)");
# Missing → lstat fails → rejected.
var v_miss = _fdlopen_verify_trusted("/nonexistent/cyrius/helper");
assert_eq(v_miss, 0, "missing path is not trusted");

# A directory → not a regular file (S_IFDIR) → rejected.
var v_dir = _fdlopen_verify_trusted("/tmp");
assert_eq(v_dir, 0, "a directory is not trusted (not a regular file)");

# A world/other-writable file → rejected by the mode check (a writable helper is
# replaceable, which is the whole threat). chmod 0666 AFTER create to defeat umask.
# Deterministic regardless of who owns it — so it holds as root in CI too.
var wfd = sys_open(_scratch("fdl_ww_helper", ""), 0x41, 0x1B6);  # O_WRONLY|O_CREAT
sys_write(wfd, "x", 1);
sys_close(wfd);
sys_chmod(_scratch("fdl_ww_helper", ""), 0x1B6);                 # 0666
var v_ww = _fdlopen_verify_trusted(_scratch("fdl_ww_helper", ""));
assert_eq(v_ww, 0, "world-writable file is not trusted (mode check)");

# A symlink → lstat sees S_IFLNK (not followed) → rejected, whatever it points at.
sys_unlink(_scratch("fdl_link_helper", ""));
sys_symlink(_scratch("fdl_ww_helper", ""), _scratch("fdl_link_helper", ""));
var v_link = _fdlopen_verify_trusted(_scratch("fdl_link_helper", ""));
assert_eq(v_link, 0, "symlink is not trusted (lstat, not followed)");

# cleanup
sys_unlink(_scratch("fdl_ww_helper", ""));
sys_unlink(_scratch("fdl_link_helper", ""));

test_group("init_trusted — fail closed");
# No /usr/lib/cyrius/dlopen-helper in the test env → -9 (UNTRUSTED), never falls
# back to the $HOME helper.
var rc_untrusted = (rc == 0 - 9);
assert_eq(rc_untrusted, 1, "x86-Linux: init_trusted returns -9 (fail closed) with no system helper");
#endif
#endif

# ── Off x86-Linux: foreign-dlopen is unsupported → -6 ──
#ifndef CYRIUS_TARGET_LINUX
test_group("init_trusted — unsupported off-Linux");
var rc_unsup1 = (rc == 0 - 6);
assert_eq(rc_unsup1, 1, "non-Linux (agnos/macOS/Windows): init_trusted is unsupported (-6)");
#endif
#ifdef CYRIUS_TARGET_LINUX
#ifndef CYRIUS_ARCH_X86
test_group("init_trusted — unsupported on non-x86");
var rc_unsup2 = (rc == 0 - 6);
assert_eq(rc_unsup2, 1, "aarch64-Linux: init_trusted is unsupported (-6)");
#endif
#endif

var r = assert_summary();
