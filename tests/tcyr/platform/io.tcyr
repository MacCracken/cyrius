# Test: io library
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/assert.cyr"

# v6.6.6: a PER-PROCESS scratch name. This test used fixed /tmp names, shared by every concurrent
# run of the suite (two check.sh at once), so one run deleted or rewrote another's file
# mid-assert. The pid is taken once, so a forked child names the same files. CHANGELOG [6.6.6]
var _scratch_pid = 0;
fn _scratch(name, suffix): i64 {   # "/tmp/<name>.<pid><suffix>", NUL-terminated
    if (_scratch_pid == 0) { _scratch_pid = sys_getpid(); }
    var nl = strlen(name);
    var sl = strlen(suffix);
    var p = alloc(nl + sl + 32);
    memcpy(p, "/tmp/", 5);
    memcpy(p + 5, name, nl);
    var o = 5 + nl;
    store8(p + o, 46);
    o = o + 1;
    var d[24];
    var n = 0;
    var v = _scratch_pid;
    while (n == 0 || v > 0) {
        var q = v / 10;
        store8(&d + n, 48 + v - q * 10);
        n = n + 1;
        v = q;
    }
    while (n > 0) {
        n = n - 1;
        store8(p + o, load8(&d + n));
        o = o + 1;
    }
    memcpy(p + o, suffix, sl);
    store8(p + o + sl, 0);
    return p;
}

alloc_init();

test_group("file_open / file_write / file_read / file_close");
var path = _scratch("cyrius_io_test", "");
# O_WRONLY|O_CREAT|O_TRUNC — use the symbols, NOT a hardcoded literal: the bits
# differ on Darwin (this gates the lib/io.cyr per-target O_* fix, issue 2026-06-17;
# the old literal 577 was Linux-only and the open failed on arm64-macOS).
var fd = file_open(path, O_WRONLY | O_CREAT | O_TRUNC, 0x1ED);
assert_eq(fd >= 0, 1, "open for write");
var n = file_write(fd, "test data", 9);
assert_eq(n, 9, "write 9");
file_close(fd);

var fd2 = file_open(path, 0, 0);
assert_eq(fd2 >= 0, 1, "open for read");
var buf = alloc(64);
var nr = file_read(fd2, buf, 63);
assert_eq(nr, 9, "read 9");
store8(buf + nr, 0);
assert_eq(streq(buf, "test data"), 1, "content");
file_close(fd2);

# v6.4.27: O_RDWR read-after-write round-trip. Gates the agnos `file_open` flag map
# (lib/io.cyr:80): it used to fold O_RDWR (2) → AO_WRONLY (0x1), so a reopened O_RDWR
# fd was write-only on agnos and every read failed (patra "cannot read header" under
# sit/mirshi). The access-mode bits are 1:1 Linux↔agnos (0/1/2), so they pass through.
# Runs everywhere; the agnos branch is separately mirshi-verified in io_rdwr_agnos.sh.
# See 2026-07-08-io-file-open-agnos-rdwr-downgraded-to-wronly.md.
test_group("O_RDWR read-after-write round-trip (agnos AO_RDWR flag-map, v6.4.27)");
var rwp = _scratch("cyrius_io_rdwr_test", "");
var rwfd = file_open(rwp, O_RDWR | O_CREAT | O_TRUNC, 0x1A4);
assert_eq(rwfd >= 0, 1, "open O_RDWR|O_CREAT|O_TRUNC");
assert_eq(file_write(rwfd, "rdwr-data", 9), 9, "write 9 on the O_RDWR fd");
file_close(rwfd);
var rwfd2 = file_open(rwp, O_RDWR, 0);            # reopen O_RDWR — the read that failed on agnos
assert_eq(rwfd2 >= 0, 1, "reopen O_RDWR");
var rwbuf = alloc(64);
assert_eq(file_read(rwfd2, rwbuf, 63), 9, "read 9 from reopened O_RDWR fd (agnos: was write-only)");
store8(rwbuf + 9, 0);
assert_eq(streq(rwbuf, "rdwr-data"), 1, "O_RDWR content round-trips");
file_close(rwfd2);
sys_unlink(rwp);

test_group("file_exists");
assert_eq(file_exists(path), 1, "exists");
assert_eq(file_exists(_scratch("cyrius_io_no_such", "")), 0, "not exists");

test_group("file_read_all / file_write_all");
var wn = file_write_all(path, "overwrite", 9);
assert_eq(wn, 9, "write_all");
var buf2 = alloc(64);
var rn = file_read_all(path, buf2, 63);
assert_eq(rn, 9, "read_all");

# flock (syscall 73) + the locked-append helpers are Linux-only: flock has a
# different BSD number on macOS that ESYSXLAT doesn't translate, so lib/io.cyr
# gates file_lock/unlock/trylock/append_locked behind #ifdef CYRIUS_TARGET_LINUX.
# Guard the same here so the rest of the io suite runs (and gates the O_* fix) on
# macOS/Windows too.
#ifdef CYRIUS_TARGET_LINUX
test_group("file_lock / file_unlock");
var lockpath = _scratch("cyrius_lock_test", "");
var lfd = file_open(lockpath, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
assert_eq(lfd >= 0, 1, "lock file open");
var lr = file_lock(lfd);
assert_eq(lr, 0, "lock acquired");
file_write(lfd, "locked", 6);
file_unlock(lfd);
file_close(lfd);
# Verify content survived lock/unlock
var lbuf = alloc(32);
var ln = file_read_all(lockpath, lbuf, 31);
store8(lbuf + ln, 0);
assert_eq(streq(lbuf, "locked"), 1, "locked content");

test_group("file_trylock");
var tfd = file_open(lockpath, O_RDONLY, 0);
var tr = file_trylock(tfd);
assert_eq(tr, 0, "trylock ok");
file_unlock(tfd);
file_close(tfd);

test_group("file_append_locked");
sys_unlink(lockpath);
file_append_locked(lockpath, "line1\n", 6);
file_append_locked(lockpath, "line2\n", 6);
var abuf = alloc(64);
var an = file_read_all(lockpath, abuf, 63);
assert_eq(an, 12, "append 12 bytes");
store8(abuf + an, 0);
assert_eq(streq(abuf, "line1\nline2\n"), 1, "append content");
sys_unlink(lockpath);
#endif

# Cleanup (portable — sys_unlink routes per-target)
sys_unlink(path);

var r = assert_summary();
