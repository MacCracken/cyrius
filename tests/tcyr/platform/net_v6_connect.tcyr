# net_v6_connect.tcyr — v6.2.10
# Darwin-IPv6 surface added to lib/net.cyr (issue 2026-06-15-cyrius-net-v6-darwin.md):
#   - sockaddr_in6 builder (28 B, per-target sin6_len/family)
#   - net_connect_sa_nb (generic, already-built sockaddr) + net_connect_nb6 (v6)
#   - sock_set_nonblocking / sock_clear_nonblocking (exported O_NONBLOCK toggles)
# Validated here on Linux (::1 loopback) + a v4 regression (the net_connect_nb
# refactor must be behaviour-identical). The macOS-specific constant values
# (AF_INET6=30, sin6_len) are exercised by the Mach-O compile gate + are
# symmetric with the macOS-verified sockaddr_in v4 path.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/tagged.cyr"
include "lib/net.cyr"
include "lib/assert.cyr"

fn main(): i64 {
    alloc_init();

    test_group("sockaddr_in6 layout");
    var loop6 = alloc(16);
    memset(loop6, 0, 16);
    store8(loop6 + 15, 1);                       # ::1 (network byte order)
    var sa6 = sockaddr_in6(loop6, 0x1234);
    # Darwin: sin6_len(28)@0 + sin6_family(30)@1. Linux: sin6_family(u16=10)@0.
    #ifdef CYRIUS_TARGET_MACOS
    assert_eq(load8(sa6) & 0xFF, 28, "sockaddr_in6 sin6_len (BSD) = 28");
    assert_eq(load8(sa6 + 1) & 0xFF, AF_INET6, "sockaddr_in6 sin6_family (Darwin u8) = 30");
    #else
    assert_eq(load8(sa6) & 0xFF, AF_INET6, "sockaddr_in6 sin6_family (Linux u16 low byte) = 10");
    #endif
    assert_eq((load8(sa6 + 2) << 8) | (load8(sa6 + 3) & 0xFF), 0x1234, "sockaddr_in6 port network-byte-order");
    assert_eq(load8(sa6 + 23) & 0xFF, 1, "sockaddr_in6 carries ::1 in the addr field @8 (byte 15 = 1)");

    test_group("sock_set_nonblocking / sock_clear_nonblocking");
    var s = sys_socket(AF_INET6, SOCK_STREAM, 0);
    assert(s >= 0, "v6 socket created");
    var saved = sock_set_nonblocking(s);
    assert(saved >= 0, "sock_set_nonblocking returns saved flags >= 0");
    var now = syscall(72, s, 3, 0);             # F_GETFL
    assert_eq(now & _NET_O_NONBLOCK, _NET_O_NONBLOCK, "O_NONBLOCK is set after sock_set_nonblocking");
    sock_clear_nonblocking(s, saved);
    assert_eq(syscall(72, s, 3, 0), saved, "sock_clear_nonblocking restores the saved flags");
    sys_close(s);

    # The connect-loopback below uses getsockname + bind/listen/accept directly
    # for an ephemeral-port server; that test scaffolding's Mach-O syscall
    # translation is orthogonal to the net.cyr v6 fix, so run it on Linux only.
    # On macOS the Darwin-specific correctness (AF_INET6=30 / sin6_len=28) is
    # covered by the target-aware sockaddr_in6 layout check above + the Mach-O
    # compile gate; the end-to-end macOS v6 connect is sandhi's acceptance.
    #ifndef CYRIUS_TARGET_MACOS
    test_group("net_connect_nb6 — ::1 loopback");
    var lfd = sys_socket(AF_INET6, SOCK_STREAM, 0);
    assert(lfd >= 0, "v6 listener socket");
    var lsa = sockaddr_in6(loop6, 0);            # port 0 = ephemeral
    assert_eq(syscall(SYS_BIND, lfd, lsa, 28), 0, "bind ::1:0 (ephemeral)");
    assert_eq(syscall(SYS_LISTEN, lfd, 4), 0, "listen on the v6 socket");
    # getsockname (x86_64 #51) to read the assigned ephemeral port.
    var gsa = alloc(28);
    var gslen = alloc(4);
    store32(gslen, 28);
    syscall(51, lfd, gsa, gslen);
    var port = ((load8(gsa + 2) & 0xFF) << 8) | (load8(gsa + 3) & 0xFF);
    assert(port > 0, "getsockname yielded an ephemeral v6 port");

    var pid = sys_fork();
    if (pid == 0) {
        var cfd = sys_socket(AF_INET6, SOCK_STREAM, 0);
        if (cfd < 0) { sys_exit(20); }
        var rc = net_connect_nb6(cfd, loop6, port, 2000);
        sys_close(cfd);
        if (rc == _NET_CONN_NB_OK) { sys_exit(0); }
        sys_exit(1);
    }
    var cli = syscall(SYS_ACCEPT, lfd, 0, 0);
    assert(cli >= 0, "server accepted the v6 client (net_connect_nb6 connected)");
    var cst[4];
    sys_waitpid(pid, &cst, 0);
    assert_eq((load64(&cst) >> 8) & 0xFF, 0, "net_connect_nb6 client returned _NET_CONN_NB_OK (child exit 0)");
    if (cli >= 0) { sys_close(cli); }
    sys_close(lfd);

    test_group("net_connect_nb — v4 regression (refactor delegates to net_connect_sa_nb)");
    var l4 = result_unwrap(tcp_socket());
    var l4sa = sockaddr_in(INADDR_LOOPBACK(), 0);
    assert_eq(syscall(SYS_BIND, l4, l4sa, 16), 0, "bind 127.0.0.1:0");
    assert_eq(syscall(SYS_LISTEN, l4, 4), 0, "listen v4");
    var g4 = alloc(16);
    var g4l = alloc(4);
    store32(g4l, 16);
    syscall(51, l4, g4, g4l);
    var p4 = ((load8(g4 + 2) & 0xFF) << 8) | (load8(g4 + 3) & 0xFF);
    var pid4 = sys_fork();
    if (pid4 == 0) {
        var c4 = result_unwrap(tcp_socket());
        var rc4 = net_connect_nb(c4, INADDR_LOOPBACK(), p4, 2000);
        sys_close(c4);
        if (rc4 == _NET_CONN_NB_OK) { sys_exit(0); }
        sys_exit(1);
    }
    var cli4 = syscall(SYS_ACCEPT, l4, 0, 0);
    assert(cli4 >= 0, "server accepted the v4 client (net_connect_nb still works)");
    var cst4[4];
    sys_waitpid(pid4, &cst4, 0);
    assert_eq((load64(&cst4) >> 8) & 0xFF, 0, "net_connect_nb v4 returned _NET_CONN_NB_OK (child exit 0)");
    if (cli4 >= 0) { sys_close(cli4); }
    sys_close(l4);
    #endif

    var r = assert_summary();
    return r;
}

var rc = main();
syscall(60, rc);
