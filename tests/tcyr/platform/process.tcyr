# Test: process library (fork/exec/waitpid)
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/syscalls.cyr"
include "lib/process.cyr"
include "lib/assert.cyr"

alloc_init();

#ifdef CYRIUS_TARGET_AGNOS
# 6.6.10: a named SKIP on agnos — the corpus cross-compile ratchet
# (tests/gates/toolchain/tcyr_corpus_cross_compiles.sh).
# Both groups use the 3-arg waitpid and read the pipe fds as u32; agnos's waitpid is the 1-arg
# #4 poll and its pipe#25 writes two u64 fds. agnos fork + pipe + wait is exercised by
# tests/gates/platform/agnos_async_process.sh (fake kernel) and on agnos-qemu.
# CHANGELOG [6.6.10]
var _agnos_skip = "  SKIP (agnos): POSIX fork + 3-arg waitpid + 32-bit pipe fds (agnos: 1-arg #4, u64 fds)\n";
sys_write(1, _agnos_skip, strlen(_agnos_skip));
#endif
#ifndef CYRIUS_TARGET_AGNOS
test_group("fork + waitpid");
var pid = sys_fork();
if (pid == 0) {
    # Child: exit with code 42
    sys_exit(42);
}
# Parent: wait for child
var status_buf[4];
sys_waitpid(pid, &status_buf, 0);
var status = load32(&status_buf);
assert_eq(WIFEXITED(status), 1, "child exited");
assert_eq(WEXITSTATUS(status), 42, "exit code 42");

test_group("fork + pipe");
var pipefd[8];
# v6.5.15: was a raw `syscall(22, &pipefd)`. 22 is the *x86* pipe number; on
# aarch64 (Linux and macOS alike) the peer issues SYS_PIPE2 = 59, so the raw
# form ran an unrelated syscall off-host and the two fds were never written —
# "pipe read 4 (got -9)". Go through the wrapper, which is the portable spelling
# on every target (x86 → syscall(22), aarch64 → syscall(59), and the Mach-O
# backend renumbers to Darwin `pipe` 42 + the x0/x1 → buffer fixup).
sys_pipe(&pipefd);
var rfd = load32(&pipefd);
var wfd = load32(&pipefd + 4);
var pid2 = sys_fork();
if (pid2 == 0) {
    sys_close(rfd);
    sys_write(wfd, "test", 4);
    sys_close(wfd);
    sys_exit(0);
}
sys_close(wfd);
var rbuf = alloc(16);
var n = sys_read(rfd, rbuf, 15);
sys_close(rfd);
store8(rbuf + n, 0);
sys_waitpid(pid2, &status_buf, 0);
assert_eq(n, 4, "pipe read 4");
assert_eq(streq(rbuf, "test"), 1, "pipe content");

#endif
var r = assert_summary();
