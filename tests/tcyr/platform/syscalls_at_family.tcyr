# v6.1.3 — POSIX *at() family + bare-name fs peers (kriya M2).
# Round-trips the new wrappers on Linux (x86_64 + aarch64; the bare-name
# peers route through the at-family on aarch64). Proposal:
# docs/development/proposals/2026-05-17-syscalls-at-family-stdlib.md
#
# Existence is checked via sys_access (portable — no arch-dependent
# struct stat offsets). Uses /tmp to avoid CWD pollution.

include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/fmt.cyr"
include "lib/assert.cyr"

# v6.6.6: a PER-PROCESS scratch name. This test used fixed /tmp names, shared by every concurrent
# run of the suite (two check.sh at once), so one run deleted or rewrote another's file
# mid-assert. The pid is taken once, so a forked child names the same files. CHANGELOG [6.6.6]
var _scratch_pid = 0;
fn _scratch(name, suffix): i64 {   # "/tmp/<name>.<pid><suffix>", NUL-terminated
    if (_scratch_pid == 0) { _scratch_pid = sys_getpid(); }
    var nl = strlen(name);
    var sl = strlen(suffix);
    var p = alloc(nl + sl + 32);
    memcpy(p, "/tmp/", 5);
    memcpy(p + 5, name, nl);
    var o = 5 + nl;
    store8(p + o, 46);
    o = o + 1;
    var d[24];
    var n = 0;
    var v = _scratch_pid;
    while (n == 0 || v > 0) {
        var q = v / 10;
        store8(&d + n, 48 + v - q * 10);
        n = n + 1;
        v = q;
    }
    while (n > 0) {
        n = n - 1;
        store8(p + o, load8(&d + n));
        o = o + 1;
    }
    memcpy(p + o, suffix, sl);
    store8(p + o + sl, 0);
    return p;
}

alloc_init();

var stbuf[160];

# Clean any leftovers from a prior run (ignore errors).
sys_unlinkat(AT_FDCWD, _scratch("cyr_at_a", ""), 0);
sys_unlinkat(AT_FDCWD, _scratch("cyr_at_b", ""), 0);
sys_unlinkat(AT_FDCWD, _scratch("cyr_at_c", ""), 0);
sys_unlinkat(AT_FDCWD, _scratch("cyr_at_d", ""), AT_REMOVEDIR);

# sys_openat(AT_FDCWD, ...) with O_CREAT creates the file. mode 0644 = 0x1A4.
# v6.5.15: was the literal 65 (Linux O_WRONLY|O_CREAT). Darwin's O_CREAT is 0x200,
# not 0x40 — 65 there means O_WRONLY|O_SHLOCK, so the file was never created and
# every later step in this chain failed. The named constants resolve per-target
# (syscalls_aarch64_linux.cyr:288 vs :306); on Linux they still compute 65.
var fd = sys_openat(AT_FDCWD, _scratch("cyr_at_a", ""), O_WRONLY | O_CREAT, 420);
assert_gte(fd, 0, "sys_openat(AT_FDCWD, O_CREAT) returns a fd");
sys_close(fd);
assert_eq(sys_access(_scratch("cyr_at_a", ""), 0), 0, "file exists after sys_openat");

# sys_lstat / sys_fstatat on the regular file succeed.
assert_eq(sys_lstat(_scratch("cyr_at_a", ""), &stbuf), 0, "sys_lstat regular file ok");
assert_eq(sys_fstatat(AT_FDCWD, _scratch("cyr_at_a", ""), &stbuf, 0), 0, "sys_fstatat ok");

# sys_link hard-links; both names resolve.
assert_eq(sys_link(_scratch("cyr_at_a", ""), _scratch("cyr_at_b", "")), 0, "sys_link hard link");
assert_eq(sys_access(_scratch("cyr_at_b", ""), 0), 0, "hard link exists");

# sys_rename moves b -> c.
assert_eq(sys_rename(_scratch("cyr_at_b", ""), _scratch("cyr_at_c", "")), 0, "sys_rename ok");
assert_neq(sys_access(_scratch("cyr_at_b", ""), 0), 0, "renamed-from path gone");
assert_eq(sys_access(_scratch("cyr_at_c", ""), 0), 0, "renamed-to path exists");

# sys_mkdirat + sys_unlinkat(AT_REMOVEDIR) create/remove a dir. 0755 = 493.
assert_eq(sys_mkdirat(AT_FDCWD, _scratch("cyr_at_d", ""), 493), 0, "sys_mkdirat creates dir");
assert_eq(sys_access(_scratch("cyr_at_d", ""), 0), 0, "dir exists after mkdirat");
assert_eq(sys_unlinkat(AT_FDCWD, _scratch("cyr_at_d", ""), AT_REMOVEDIR), 0, "sys_unlinkat AT_REMOVEDIR rmdir");
assert_neq(sys_access(_scratch("cyr_at_d", ""), 0), 0, "dir gone after unlinkat AT_REMOVEDIR");

# sys_utimensat with NULL times = set both to now. Darwin has NO utimensat syscall
# (absent from MacOSX.sdk sys/syscall.h), so the wrapper returns -ENOSYS there by
# design — assert that documented contract rather than dropping the call entirely.
# See syscalls_linux_common.cyr:105-113.
#ifndef CYRIUS_TARGET_MACOS
assert_eq(sys_utimensat(AT_FDCWD, _scratch("cyr_at_a", ""), 0, 0), 0, "sys_utimensat NULL times = now");
#endif
#ifdef CYRIUS_TARGET_MACOS
assert_eq(sys_utimensat(AT_FDCWD, _scratch("cyr_at_a", ""), 0, 0), 0 - 78, "sys_utimensat is -ENOSYS on Darwin");
#endif

# Cleanup: a and c are two names for the same inode (a, then hardlink->b, renamed->c).
assert_eq(sys_unlinkat(AT_FDCWD, _scratch("cyr_at_a", ""), 0), 0, "sys_unlinkat removes file");
assert_eq(sys_unlink(_scratch("cyr_at_c", "")), 0, "sys_unlink removes the hard-linked name");
assert_neq(sys_access(_scratch("cyr_at_a", ""), 0), 0, "a gone");
assert_neq(sys_access(_scratch("cyr_at_c", ""), 0), 0, "c gone");

var _exit_code = assert_summary();
syscall(60, _exit_code);
