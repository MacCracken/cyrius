# return_cap_removed.tcyr — v6.0.7 regression: fn with >256 returns compiles cleanly
#
# Pre-v6.0.7, the return-patch table was a fixed 256-slot array at
# S + 0x18DA20 with hard cap diagnostic 'too many return statements
# in function (max 256)'. v6.0.7 migrated storage to a vec; capacity
# grows on demand. This test compiles a fn with 260 returns to lock
# the new behavior — the pre-v6.0.7 compiler would reject this with
# the cap diagnostic. See CHANGELOG [6.0.7].

include "lib/assert.cyr"

fn many_returns(x): i64 {
