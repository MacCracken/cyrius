test_group("fn with 260 returns compiles + each return is reached");
assert_eq(many_returns(0), 0, "first return reached");
assert_eq(many_returns(127), 127, "mid return reached");
assert_eq(many_returns(255), 255, "old-cap-boundary return reached");
assert_eq(many_returns(256), 256, "first past-old-cap return reached");
assert_eq(many_returns(259), 259, "last return reached");
assert_eq(many_returns(999), 0 - 1, "fallthrough return");

var r = assert_summary();
