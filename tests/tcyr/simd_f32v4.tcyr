# simd_f32v4.tcyr — f32v4 (128-bit, 4 f32 lanes) — construct, packed addps/subps/mulps,
# fmadd + horizontal dot, VALUE + pointer dual-form, value-form params. **CROSS-ARCH as of
# SIMD Phase 5 (v6.4.28):** x86 emits SSE (Phase 1, v6.4.4); aarch64 emits NEON (Phase 5 —
# EMIT_F32V_LOOP/FMADD/DOT via .4s + faddp reduce). No longer XFAIL'd on ARM (was through
# v6.4.27) — the aarch64-native CI corpus runs it un-XFAIL'd. Stays a REGULAR tcyr (x86-Linux
# + aarch64), NOT vr01_, because it uses value-form f32v4 params/returns which Win64 PE does
# not yet support; the Win64-safe flat-array intrinsics are gated cross-OS by
# vr01_simd_f32v4_neon.tcyr (ecb/cass/pi in the release gate).
# f32 values are i32 bit patterns: 1.0f = 0x3F800000, 2.0f = 0x40000000, 3.0f = 0x40400000.
include "lib/assert.cyr"
include "lib/simd.cyr"
include "lib/syscalls.cyr"

# value-form param + return (exercises the 128-bit XMM param ABI, -2121 tag).
fn scale2(v: f32v4): f32v4 {
    return f32v4_add(v, v);   # v + v = 2v
}

fn main(): i64 {
    test_group("f32v4 construct + packed addps/mulps + dual-form (SIMD Phase 1)");
    var a: f32v4 = f32v4_make(0x40000000, 0x40000000, 0x40000000, 0x40000000);   # 2.0f x4
    var b: f32v4 = f32v4_splat(0x3F800000);                                        # 1.0f x4
    assert_eq(f32v4_lane0(a), 0x40000000, "f32v4_make lane 0 = 2.0f (value-form extract)");
    assert_eq(f32v4_lane3(&a), 0x40000000, "f32v4_make lane 3 = 2.0f (&-routed extract)");
    assert_eq(f32v4_lane0(b), 0x3F800000, "f32v4_splat lane 0 = 1.0f");

    var r: f32v4 = f32v4_add(a, b);                                                # 3.0f (value-form)
    assert_eq(f32v4_lane0(r), 0x40400000, "addps lane 0 = 3.0f");
    assert_eq(f32v4_lane3(r), 0x40400000, "addps lane 3 = 3.0f (all 4 lanes)");

    var m: f32v4 = f32v4_mul(&a, &b);                                              # 2.0f (&-routed)
    assert_eq(f32v4_lane2(m), 0x40000000, "mulps lane 2 = 2.0f");

    var s: f32v4 = f32v4_sub(r, b);                                                # 3.0-1.0 = 2.0f
    assert_eq(f32v4_lane1(s), 0x40000000, "subps lane 1 = 2.0f");

    var d: f32v4 = scale2(b);                                                      # 1.0+1.0 = 2.0f
    assert_eq(f32v4_lane0(d), 0x40000000, "value-form f32v4 param round-trip = 2.0f");

    # --- SIMD Phase 2: fused multiply-add + horizontal dot ---
    test_group("f32v4 fmadd + horizontal dot (SIMD Phase 2)");
    var fm: f32v4 = f32v4_fmadd(a, b, b);          # a*b + c = 2*1 + 1 = 3.0f
    assert_eq(f32v4_lane0(fm), 0x40400000, "fmadd lane 0 = 2*1+1 = 3.0f");
    assert_eq(f32v4_lane3(fm), 0x40400000, "fmadd lane 3 = 3.0f (all lanes)");
    var dt = f32v4_dot(a, b);                       # sum(2*1) x4 = 8.0f
    assert_eq(dt, 0x41000000, "f32v4_dot(2.0x4 · 1.0x4) = 8.0f (value-form)");
    var dt2 = f32v4_dot(&a, &b);                    # &-routed pointer form = 8.0f
    assert_eq(dt2, 0x41000000, "f32v4_dot(&a, &b) = 8.0f (pointer-form)");

    # raw flat-array f32v_dot over 8 lanes exercises 2 loop iterations
    var buf[32]; var one[32];
    var iw = 0;
    while (iw < 8) { store32(&buf + iw * 4, 0x40000000); store32(&one + iw * 4, 0x3F800000); iw = iw + 1; }
    var d8 = f32v_dot(&buf, &one, 8);               # sum(2*1) x8 = 16.0f
    assert_eq(d8, 0x41800000, "f32v_dot 8-lane (2 loop iters) = 16.0f");

    return assert_summary();
}
var ec = main();
syscall(60, ec);
