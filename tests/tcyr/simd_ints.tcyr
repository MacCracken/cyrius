# simd_ints.tcyr — integer vector types + packed add/sub/mul across two phases:
#   Phase 3a (v6.4.6): i8v16/i16v8/i32v4/i64v2 construct + pointer-form ops + flat-array iv_*.
#   Phase 3b (v6.4.7): value-form typed ops (i32v4_add(a,b) with i32v4 VALUE params) via the
#                      param-mask redesign (class 1 = any 16-byte vector routes through XMM).
# **CROSS-ARCH as of SIMD Phase 5 v6.4.30:** x86 SSE + aarch64 NEON (EMIT_IVEC_BINOP +
# EMIT_IVEC_DP8); no longer XFAIL'd on ARM. cx stubs it. **v6.4.31: value-form integer-vector
# params/returns now work on Win64 PE too** (MS x64 by-pointer param + retptr return); the
# cross-OS gate is vr01_simd_ints_neon.tcyr. Stays a regular tcyr (fuller corpus).
# Value-form SIMD args must be bare local IDENTs (not call temps).
include "lib/assert.cyr"
include "lib/simd.cyr"
include "lib/syscalls.cyr"
fn main(): i64 {
    test_group("integer vector types + packed ops (SIMD Phase 3a)");
    var a: i32v4 = i32v4_make(1, 2, 3, 4);
    var b: i32v4 = i32v4_splat(10);
    assert_eq(i32v4_lane0_ptr(&a), 1, "i32v4_make lane0 = 1");
    assert_eq(i32v4_lane3_ptr(&a), 4, "i32v4_make lane3 = 4");
    var s: i32v4 = i32v4_add_ptr(&a, &b);
    assert_eq(i32v4_lane0_ptr(&s), 11, "i32v4 paddd lane0 = 1+10 = 11");
    assert_eq(i32v4_lane3_ptr(&s), 14, "i32v4 paddd lane3 = 4+10 = 14");
    var d: i32v4 = i32v4_sub_ptr(&b, &a);
    assert_eq(i32v4_lane1_ptr(&d), 8, "i32v4 psubd lane1 = 10-2 = 8");
    var m: i32v4 = i32v4_mul_ptr(&a, &b);
    assert_eq(i32v4_lane2_ptr(&m), 30, "i32v4 pmulld lane2 = 3*10 = 30");
    var p16a: i16v8 = i16v8_splat(100);
    var p16b: i16v8 = i16v8_splat(23);
    var p16: i16v8 = i16v8_add_ptr(&p16a, &p16b);
    assert_eq(load16(&p16 + 0), 123, "i16v8 paddw lane0 = 123");
    var z8a: i8v16 = i8v16_splat(5);
    var z8b: i8v16 = i8v16_splat(7);
    var z8: i8v16 = i8v16_add_ptr(&z8a, &z8b);
    assert_eq(load8(&z8 + 3), 12, "i8v16 paddb lane3 = 12");
    var m64a: i64v2 = i64v2_make(1000000, 2000000);
    var m64b: i64v2 = i64v2_splat(5);
    var o64: i64v2 = i64v2_add_ptr(&m64a, &m64b);
    assert_eq(load64(&o64 + 0), 1000005, "i64v2 paddq lane0 = 1000005");
    var arr[32]; var brr[32]; var drr[32];
    var i = 0; while (i < 8) { store32(&arr + i * 4, i); store32(&brr + i * 4, 100); i = i + 1; }
    iv_add(&drr, &arr, &brr, 8, 4);
    assert_eq(load32(&drr + 0), 100, "iv_add i32 8-lane (2 iters) [0] = 100");
    assert_eq(load32(&drr + 28), 107, "iv_add i32 8-lane [7] = 107");
    # --- iv_dp8: int8 widening dot (u8 activations · i8 weights → i32), the b1.58 inner loop ---
    var au[16]; var bu[16];
    var q = 0; while (q < 16) { store8(&au + q, 2); store8(&bu + q, 3); q = q + 1; }
    assert_eq(iv_dp8(&au, &bu, 16), 96, "iv_dp8 u8*i8 16-lane = 2*3*16 = 96");
    q = 0; while (q < 16) { store8(&bu + q, 255); q = q + 1; }   # i8 weight = -1
    assert_eq(iv_dp8(&au, &bu, 16), 0 - 32, "iv_dp8 signed i8=-1 → -32 (movsxd sign-extend)");
    # --- value-form typed ops (Phase 3b): i32v4 value params route through XMM as 16 bytes ---
    var vs: i32v4 = i32v4_add(a, b);
    assert_eq(load32(&vs + 0), 11, "i32v4_add(value) lane0 = 11");
    assert_eq(load32(&vs + 12), 14, "i32v4_add(value) lane3 = 14 (all 16 bytes routed)");
    var vd: i32v4 = i32v4_sub(b, a);
    assert_eq(load32(&vd + 4), 8, "i32v4_sub(value) lane1 = 8");
    var vm: i32v4 = i32v4_mul(a, b);
    assert_eq(load32(&vm + 8), 30, "i32v4_mul(value) lane2 = 30");
    assert_eq(i32v4_lane3(a), 4, "i32v4_lane3(value) = 4");
    var v16: i16v8 = i16v8_add(p16a, p16b);
    assert_eq(load16(&v16 + 0), 123, "i16v8_add(value) lane0 = 123");
    var v8: i8v16 = i8v16_add(z8a, z8b);
    assert_eq(load8(&v8 + 3), 12, "i8v16_add(value) lane3 = 12");
    var v64: i64v2 = i64v2_add(m64a, m64b);
    assert_eq(load64(&v64 + 0), 1000005, "i64v2_add(value) lane0 = 1000005");
    return assert_summary();
}
var ec = main();
syscall(60, ec);
