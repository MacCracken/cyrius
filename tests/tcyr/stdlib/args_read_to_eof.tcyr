# args_read_to_eof.tcyr — lib/args.cyr's Linux read loop and its failure returns (6.7.12).
#
# issues/2026-10-14-args-init-truncates-argv-past-2-mib.md: args_init read /proc/self/cmdline
# with ONE sys_read into a 2,097,152-byte buffer, so a longer command line (ARG_MAX follows
# `ulimit -s`, up to 6 MiB) came back as its first 2 MiB with no error, and a failed open or
# alloc returned 0 — the same answer as success on macOS. Now `_args_read_all` reads to EOF,
# doubling the buffer when it fills, and every failure is a negative errno (D7, the user
# 2026-10-15). The command line itself is the gate's (tests/gates/platform/
# args_init_long_cmdline.sh runs the filed repro past 2 MiB); here the loop is driven from a
# pipe with a tiny first buffer, so each growth step and each failure path runs.
include "lib/assert.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/syscalls.cyr"
include "lib/args.cyr"

#ifdef CYRIUS_TARGET_LINUX
# Fill `buf` with `nargs` NUL-terminated args "<k mod 10 repeated k%7+1 times>"; returns the length.
fn _blob(buf, nargs): i64 {
    var o = 0;
    var k = 0;
    while (k < nargs) {
        var reps = (k % 7) + 1;
        var j = 0;
        while (j < reps) {
            store8(buf + o, 48 + (k % 10));
            o = o + 1;
            j = j + 1;
        }
        store8(buf + o, 0);
        o = o + 1;
        k = k + 1;
    }
    return o;
}

# A pipe holding `len` bytes of `src`, write end closed; returns the read end (or a negative errno).
fn _pipe_with(src, len): i64 {
    var fds: i64[2];
    var pr = sys_pipe(&fds);
    if (pr < 0) { return pr; }
    var rfd = load32(&fds) & 0xFFFFFFFF;
    var wfd = load32(&fds + 4) & 0xFFFFFFFF;
    var w = sys_write(wfd, src, len);
    sys_close(wfd);
    if (w != len) { sys_close(rfd); return 0 - 5; }
    return rfd;
}

fn main(): i64 {
    alloc_init();

    test_group("args_init: the real command line, a non-negative byte count");
    var ar = args_init();
    assert_eq(ar > 0, 1, "args_init returns the bytes it read (> 0)");
    assert_eq(ar, _args_len, "the return is the published length");
    assert_eq(argc() >= 1, 1, "argc() >= 1");

    test_group("the read loop: a first buffer of 5 bytes grows to hold the whole blob");
    var src = alloc(4096);
    var blen = _blob(src, 700);   # 700 args, 3,500 bytes: 5 -> 10 -> ... -> 5120 (10 growths)
    var rfd = _pipe_with(src, blen);
    assert_eq(rfd >= 0, 1, "pipe staged");
    var n = _args_read_all(rfd, 5);
    sys_close(rfd);
    assert_eq(n, blen, "every byte read, past the first buffer (no prefix)");
    assert_eq(_args_len, blen, "the published length is the whole blob");
    assert_eq(argc(), 700, "argc() counts all 700 args");
    assert_eq(memeq(_args_base, src, blen), 1, "the blob is byte-identical (qword copy + byte tail)");
    assert_eq(strlen(argv(699)), (699 % 7) + 1, "the last arg is whole");
    assert_eq(load8(argv(699)), 48 + 9, "the last arg's bytes are its own");

    test_group("an exact multiple of the first buffer reads to EOF");
    var blen2 = _blob(src, 4);    # "0\0" "11\0" "222\0" "3333\0" = 14 bytes
    var rfd2 = _pipe_with(src, blen2);
    var n2 = _args_read_all(rfd2, 7);   # fills 7, grows to 14, fills, grows to 28, reads 0
    sys_close(rfd2);
    assert_eq(n2, 14, "14 bytes through a 7-byte first buffer");
    assert_eq(argc(), 4, "argc() 4");

    test_group("failures are a negative errno and publish nothing (D7)");
    var before_base = _args_base;
    var before_len = _args_len;
    assert_eq(_args_read_all(0 - 1, 64), 0 - 9, "a bad fd: the read's -EBADF");
    var dfd = sys_open("/", O_RDONLY, 0);
    assert_eq(dfd >= 0, 1, "opened / for the read-error row");
    assert_eq(_args_read_all(dfd, 64), 0 - 21, "a directory: the read's -EISDIR");
    sys_close(dfd);
    var rfd3 = _pipe_with(src, blen);
    assert_eq(_args_read_all(rfd3, 0), 0 - 12, "the first buffer cannot be allocated: -12 (ENOMEM)");
    sys_close(rfd3);
    var saved_max = ALLOC_MAX;
    ALLOC_MAX = 16;               # alloc(8) and alloc(16) succeed, the third doubling (32) cannot
    var rfd4 = _pipe_with(src, blen);
    var n4 = _args_read_all(rfd4, 8);
    ALLOC_MAX = saved_max;
    sys_close(rfd4);
    assert_eq(n4, 0 - 12, "a growth that cannot be allocated: -12, never the prefix read so far");
    assert_eq(_args_base, before_base, "no failure published a blob");
    assert_eq(_args_len, before_len, "no failure published a length");
    assert_eq(argc(), 4, "argc() still describes the last successful read");

    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
#else
fn main(): i64 {
    test_group("args_read_to_eof — SKIP: the read loop is lib/args.cyr's Linux arm");
    assert_eq(1, 1, "not Linux: skipped by name");
    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
#endif
