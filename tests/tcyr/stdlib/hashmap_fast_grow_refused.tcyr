# hashmap_fast_grow_refused.tcyr — 6.6.7. A REFUSED GROW LEAVES THE MAP INTACT AND fhm_set
# SAYS SO (-1), instead of memset-ing a new table through address 0.
#
# ⛔ THE DEFECT (audit, 6.6.7 bite 8 — same class as file_read_whole / fl_alloc): `_fhm_grow`
# allocated three arrays unchecked and immediately `memset(new_meta, 0, new_cap)`, then
# installed them over the live table; `fhm_new` stored through its four allocations unchecked.
# A refused allocation was a SIGSEGV, never a return code.
#
# The refusal is forced DETERMINISTICALLY by lowering ALLOC_MAX while the map sits at its
# doubling trigger (56 live in 64 slots), so alloc() refuses with no memory pressure on every
# target; the map must still answer every key it held — the "unchanged" half. With the 6.6.6
# grow this file SIGSEGVs at the refused fhm_set.
# (Until 6.7.9 the refusal was forced by planting a 2^31 capacity in the header. Since 6.7.9
# fhm_set looks the key up before its trigger can rebuild — an overwrite never rebuilds — and a
# lookup in a header whose capacity is larger than its arrays reads past them. CHANGELOG [6.7.9])
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/hashmap_fast.cyr"
include "lib/assert.cyr"

fn main(): i64 {
    alloc_init();
    var m = fhm_new();
    assert(m != 0, "fhm_new returns a map");
    # ordinary growth still works: 16 -> 32 -> 64 over 56 keys, which leave the 64-slot table
    # exactly at its doubling trigger ((56 + 0) * 8 >= 64 * 7, and 56 * 16 >= 64 * 7)
    var keys = alloc(56 * 8);
    var i = 0;
    while (i < 56) {
        var k = alloc(8);
        store8(k, 97 + (i % 26));
        store8(k + 1, 65 + (i / 26));
        store8(k + 2, 0);
        store64(keys + i * 8, k);
        assert_eq(fhm_set(m, k, i + 100), 0, "fhm_set during ordinary growth returns 0");
        i = i + 1;
    }
    assert_eq(fhm_count(m), 56, "56 keys held");
    assert_eq(fhm_cap(m), 64, "the table grew to 64 slots and sits at its doubling trigger");
    var real_meta = load64(m);
    var real_keys = load64(m + 8);
    var saved = ALLOC_MAX;

    # every allocation refused: the doubling's first array (meta, 128 B) already fails
    ALLOC_MAX = 0;
    var r1 = fhm_set(m, "overflow-key", 7);
    ALLOC_MAX = saved;
    assert_eq(r1, 0 - 1, "a refused grow: fhm_set returns -1");
    assert_eq(load64(m), real_meta, "a refused grow: the live table was not replaced");
    assert_eq(fhm_cap(m), 64, "a refused grow: the header was not rewritten");
    assert_eq(fhm_count(m), 56, "a refused grow: the count was not rewritten");

    # the PARTIAL refusal: meta alloc(128) is served (it is not past ALLOC_MAX) and keys
    # alloc(1024) is refused — the realistic shape, where the first array succeeds and a later,
    # larger one does not. (Every check alone is pinned by per-call fault injection:
    # tests/gates/memory/alloc_failure_returns_zero.sh axis 5.)
    var u2 = alloc_used();
    ALLOC_MAX = 128;
    var r2 = fhm_set(m, "overflow-key", 7);
    ALLOC_MAX = saved;
    assert_eq(alloc_used() - u2, 128, "a partly-refused grow: the meta array WAS served (anti-vacuous)");
    assert_eq(r2, 0 - 1, "a partly-refused grow: fhm_set returns -1");
    assert_eq(load64(m), real_meta, "a partly-refused grow: the live table was not replaced");
    assert_eq(load64(m + 8), real_keys, "a partly-refused grow: the keys array was not replaced");
    assert_eq(fhm_cap(m), 64, "a partly-refused grow: the header was not rewritten");

    # and the map still answers every key it held
    var ok = 1;
    i = 0;
    while (i < 56) {
        if (fhm_get(m, load64(keys + i * 8)) != i + 100) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, "after the refused grow every key still maps to its value");
    assert_eq(fhm_has(m, "overflow-key"), 0, "the refused key was not half-inserted");
    var rc = assert_summary();
    return rc;
}
var ec = main();
syscall(60, ec);
