# result_allocator_via.tcyr — v6.5.41: Result boxes can be constructed from a CALLER-SUPPLIED
# allocator, so a long-running server stops leaking 16 B per socket call.
#
# THE DEFECT (sandhi, filed against 6.4.86, reproducing unchanged through 6.5.40). Every
# `Ok(v)` / `Err(e)` allocates a 16-byte box from the GLOBAL bump allocator, whose only reclaim
# is `alloc_reset()` — and that invalidates every pointer it has ever handed out, so a server
# can never call it. Measured: 100 × `sock_send` grows the global allocator by exactly 1600 B.
#
# ⭐ THE CAUSE IS NOT `Result` AND NOT net.cyr. The enum payload-variant constructor lowering
# (`src/frontend/parse_types.cyr:386`) unconditionally emits a call to the global `alloc` for
# ANY payload-carrying variant — a plain user `enum Color { Red(v); }` allocates the same 16 B —
# and the `: Result` return annotation is a codegen no-op. Fixing that properly means changing
# the representation across 24 enum declarations and 516 construction sites, which is a
# different size class. This gate pins the escape hatch, not the root cause.
#
# ⛔ EVERY ASSERTION HERE IS PAIRED WITH ITS CONTROL, and that is the point. On a machine where
# the allocator happened not to move, a bare "delta == 0" would pass while proving nothing. So
# each zero-growth claim is accompanied by an assertion that the OLD path still grows — if the
# global allocator ever stops moving for `Ok(...)`, these tests fail rather than silently
# becoming vacuous.
include "lib/assert.cyr"
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/fnptr.cyr"
include "lib/result.cyr"
include "lib/net.cyr"

var sv[2];

fn main(): i64 {
    alloc_init();
    var a = arena_allocator(65536);

    test_group("ok_via / err_via build a usable box without touching the global allocator");
    var r = ok_via(a, 7);
    assert_eq(is_ok(r), 1, "ok_via box reads as Ok");
    assert_eq(result_unwrap(r), 7, "ok_via payload round-trips through result_unwrap");
    var e = err_via(a, 5);
    assert_eq(is_err_result(e), 1, "err_via box reads as Err");
    assert_eq(is_ok(e), 0, "err_via box does not read as Ok");

    test_group("100 constructions: allocator-supplied vs global");
    var b1 = alloc_used();
    var i = 0;
    while (i < 100) { var x = ok_via(a, i); i = i + 1; }
    var d_via = alloc_used() - b1;
    var b2 = alloc_used();
    i = 0;
    while (i < 100) { var y = Ok(i); i = i + 1; }
    var d_global = alloc_used() - b2;
    assert_eq(d_via, 0, "100x ok_via grows the global allocator by 0 bytes");
    # The control. If this ever reads 0 the assertion above has become meaningless.
    assert_neq(d_global, 0, "CONTROL: 100x Ok() still grows the global allocator (else the test above is vacuous)");

    test_group("sock_send_a on a real socketpair — the filed measurement");
    # socketpair(AF_UNIX=1, SOCK_STREAM=1, 0, sv). Skipped rather than failed if unavailable,
    # so the Result half above still runs on a host without AF_UNIX.
    if (syscall(53, 1, 1, 0, &sv) >= 0) {
        var wfd = load64(&sv) & 0xFFFFFFFF;
        var b3 = alloc_used();
        i = 0;
        while (i < 100) { var s1 = sock_send_a(a, wfd, "hello", 5); i = i + 1; }
        var d_send_via = alloc_used() - b3;
        var b4 = alloc_used();
        i = 0;
        while (i < 100) { var s2 = sock_send(wfd, "hello", 5); i = i + 1; }
        var d_send_global = alloc_used() - b4;
        assert_eq(d_send_via, 0, "100x sock_send_a grows the global allocator by 0 bytes");
        assert_eq(d_send_global, 1600, "CONTROL: 100x sock_send still grows it by exactly 1600 B (16/call, the filed number)");
    }

    var rr = assert_summary();
    return rr;
}
var ec = main();
syscall(60, ec);
