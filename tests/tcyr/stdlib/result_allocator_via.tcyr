# result_allocator_via.tcyr — v6.6.0: Result construction allocates NOTHING, and the v6.5.41
# allocator escape hatch (`ok_via` / `err_via`) still works on top of that.
#
# ⛔ THIS FILE USED TO ASSERT THE OPPOSITE, and the inversion is the point of the release.
# Through v6.5.x every `Ok(v)` / `Err(e)` allocated a 16-byte box from the GLOBAL bump allocator,
# whose only reclaim is `alloc_reset()` — and that invalidates every pointer it has ever handed
# out, so a long-running server could never call it. sandhi filed it against 6.4.86 with the
# measurement `100 x sock_send` grows the global allocator by exactly 1600 B, unbounded, no
# workaround. v6.5.41 shipped `ok_via`/`err_via` as an escape hatch and THIS FILE PINNED IT,
# with controls asserting that the ordinary path STILL GREW:
#
#     assert_neq(d_global, 0, "CONTROL: 100x Ok() still grows the global allocator")
#     assert_eq(d_send_global, 1600, "CONTROL: 100x sock_send still grows it by exactly 1600 B")
#
# v6.6.0 made `Result`/`Option`/`Either` the value form — tag in rax, payload in rdx, no heap box
# at all — so those two controls now assert the defect is still present. They are inverted here:
# the ordinary path must grow by **0**.
#
# ⭐ THE ANTI-VACUOUS PROBLEM MOVED, IT DID NOT GO AWAY. When every number under test is 0, a
# broken measurement reads exactly like a fixed allocator. The old controls guarded that by
# asserting the OLD path still moved; there is no old path any more, so the control is now a
# genuine allocation of the same size — 100 x alloc(16) must still measure 1600 B. If THAT ever
# reads 0, `alloc_used()` is lying and every zero below is meaningless, so it fails loudly
# instead of passing quietly.
include "lib/assert.cyr"
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/fnptr.cyr"
include "lib/result.cyr"
include "lib/net.cyr"

var sv[2];

fn main(): i64 {
    alloc_init();
    var a = arena_allocator(65536);

    test_group("the value form: Ok/Err carry their payload with no box at all");
    var o_tag, o = Ok(7);
    assert_eq(is_ok(o_tag), 1, "Ok reads as Ok");
    assert_eq(result_unwrap(o_tag, o), 7, "Ok payload round-trips through result_unwrap");
    var x_tag, x = Err(5);
    assert_eq(is_err_result(x_tag), 1, "Err reads as Err");
    assert_eq(is_ok(x_tag), 0, "Err does not read as Ok");
    assert_eq(err_code_of(x_tag, x), 5, "Err carries its code");

    test_group("ok_via / err_via keep working — the hatch outlived its reason");
    var r_tag, r = ok_via(a, 7);
    assert_eq(is_ok(r_tag), 1, "ok_via reads as Ok");
    assert_eq(result_unwrap(r_tag, r), 7, "ok_via payload round-trips");
    var e_tag, e = err_via(a, 5);
    assert_eq(is_err_result(e_tag), 1, "err_via reads as Err");
    assert_eq(is_ok(e_tag), 0, "err_via does not read as Ok");

    test_group("100 constructions allocate ZERO — the headline of v6.6.0");
    var b1 = alloc_used();
    var i = 0;
    while (i < 100) { var xt, xv = ok_via(a, i); i = i + 1; }
    var d_via = alloc_used() - b1;
    var b2 = alloc_used();
    i = 0;
    while (i < 100) { var yt, yv = Ok(i); i = i + 1; }
    var d_global = alloc_used() - b2;
    assert_eq(d_via, 0, "100x ok_via grows the global allocator by 0 bytes");
    assert_eq(d_global, 0, "100x Ok() grows the global allocator by 0 bytes (was 1600 through 6.5.x)");

    # THE CONTROL. Every number above is 0, so this is what proves the measurement still works.
    var b0 = alloc_used();
    i = 0;
    while (i < 100) { var junk = alloc(16); i = i + 1; }
    var d_real = alloc_used() - b0;
    assert_eq(d_real, 1600, "CONTROL: 100x alloc(16) still measures 1600 B (else every 0 above is vacuous)");

    test_group("sock_send on a real socketpair — the filed measurement, now zero");
    # socketpair(AF_UNIX=1, SOCK_STREAM=1, 0, sv). Skipped rather than failed if unavailable,
    # so the Result half above still runs on a host without AF_UNIX.
    if (syscall(53, 1, 1, 0, &sv) >= 0) {
        var wfd = load64(&sv) & 0xFFFFFFFF;
        var b3 = alloc_used();
        i = 0;
        while (i < 100) { var s1t, s1 = sock_send_a(a, wfd, "hello", 5); i = i + 1; }
        var d_send_via = alloc_used() - b3;
        var b4 = alloc_used();
        i = 0;
        while (i < 100) { var s2t, s2 = sock_send(wfd, "hello", 5); i = i + 1; }
        var d_send_global = alloc_used() - b4;
        assert_eq(d_send_via, 0, "100x sock_send_a grows the global allocator by 0 bytes");
        assert_eq(d_send_global, 0, "100x sock_send grows it by 0 bytes — the filed 1600 B is GONE");
    }

    var rr = assert_summary();
    return rr;
}
var ec = main();
syscall(60, ec);
