# fmt_int_buf_bounded.tcyr — CVE-78: fmt_int_buf writes only its answer.
#
# ⛔ THE DEFECT. fmt_int_buf(n, buf) built its digits in place from buf+23 downward and then
# shifted them to buf+0, so EVERY call wrote 24 bytes at buf whatever the number's length.
# A `buf + pos` caller with less room overran: fmt_float_buf formats the integer and the
# fraction at `buf + pos` inside fmt_float's own 32-byte stack buffer, and heap callers
# (`alloc(32) + 10` in a TLS test, patra / bench / yantra's `buf + off`) wrote past their
# blocks. Each probe here fills a block with 0xEE and asserts the bytes past the answer
# (and its NUL) are untouched.
#
# ⛔ |val| >= 2^63 (6.6.20). Inside the bound, but the WRONG NUMBER: f64_to saturates past
# i64 range and the fraction's carry wrapped the integer negative, so 1e300 printed
# `-9131138316486228051.07` and -1e300 `--9131…`; only the length was asserted here, so it
# passed. Those rows now assert the text: the exact integer below 1e20, a bounded exponent
# form above it.
include "lib/syscalls.cyr"
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/vec.cyr"
include "lib/fmt.cyr"
include "lib/assert.cyr"

fn _fill(p, n, b): i64 {
    var i = 0;
    while (i < n) { store8(p + i, b); i = i + 1; }
    return 0;
}

# Count bytes in [p+from, p+to) that are not 0xEE.
fn _changed(p, from, to): i64 {
    var bad = 0;
    var i = from;
    while (i < to) { if (load8(p + i) != 0xEE) { bad = bad + 1; } i = i + 1; }
    return bad;
}

# fmt_float_buf(bits, d) into w; 1 when the text is `want`.
fn _ff(bits, d, w, want): i64 {
    var n = fmt_float_buf(bits, w, d);
    store8(w + n, 0);
    return streq(w, want);
}

# fmt_float(bits, d) to stdout, captured through a pipe; 1 when the text is `want`.
fn _ffout(bits, d, want): i64 {
    var fds[16];
    if (sys_pipe(&fds) != 0) { return 0; }
    var rd = load32(&fds);
    var wr = load32(&fds + 4);
    sys_dup2(1, 100);                # park the real stdout on a free fd
    sys_dup2(wr, 1);
    fmt_float(bits, d);
    sys_dup2(100, 1);
    sys_close(100);
    sys_close(wr);
    var got[128];
    var n = 0;
    var k = sys_read(rd, &got, 127);
    while (k > 0) {
        n = n + k;
        k = sys_read(rd, &got + n, 127 - n);
    }
    sys_close(rd);
    store8(&got + n, 0);
    return streq(&got, want);
}

fn main(): i64 {
    alloc_init();
    test_group("fmt_int_buf writes len + NUL only (CVE-78)");
    var b = alloc(64);
    if (b == 0) { return 1; }
    _fill(b, 64, 0xEE);
    var n = fmt_int_buf(47233, b);
    assert_eq(n, 5, "47233 -> 5 chars");
    assert_eq(streq(b, "47233"), 1, "47233 text unchanged");
    assert_eq(_changed(b, 6, 64), 0, "bytes 6..63 untouched");

    _fill(b, 64, 0xEE);
    n = fmt_int_buf(0, b);
    assert_eq(n, 1, "0 -> 1 char");
    assert_eq(streq(b, "0"), 1, "0 text");
    assert_eq(_changed(b, 2, 64), 0, "0: bytes 2..63 untouched");

    _fill(b, 64, 0xEE);
    n = fmt_int_buf(0 - 9223372036854775807 - 1, b);
    assert_eq(n, 20, "i64::MIN -> 20 chars");
    assert_eq(streq(b, "-9223372036854775808"), 1, "i64::MIN text");
    assert_eq(_changed(b, 21, 64), 0, "i64::MIN: bytes 21..63 untouched");

    # The `alloc(32) + 10` shape: 22 bytes of room is plenty for "12345" + NUL.
    var c = alloc(64);
    if (c == 0) { return 1; }
    _fill(c, 64, 0xEE);
    n = fmt_int_buf(12345, c + 10);
    assert_eq(streq(c + 10, "12345"), 1, "buf+pos text");
    assert_eq(_changed(c, 0, 10), 0, "buf+pos: bytes before untouched");
    assert_eq(_changed(c, 16, 64), 0, "buf+pos: bytes 16..63 untouched");

    test_group("fmt_float_buf stays inside its bound (CVE-78)");
    _fill(c, 64, 0xEE);
    n = fmt_float_buf(f64_from(1000000000000000), c, 2);
    store8(c + n, 0);
    assert_eq(streq(c, "1000000000000000.00"), 1, "1e15 text unchanged");
    # Old code: the fraction's fmt_int_buf at c+17 wrote scratch up to c+40.
    assert_eq(_changed(c, 32, 64), 0, "1e15: bytes 32..63 untouched");

    # A finite value past i64 range: the documented worst case, max(43, 22 + decimals).
    var big = f64_mul(f64_from(1000000000000000), f64_from(1000000000000000));
    big = f64_sub(f64_from(0), big);
    _fill(c, 64, 0xEE);
    n = fmt_float_buf(big, c, 2);
    assert_lte(n, 42, "-1e30 length within the bound");
    assert_eq(_changed(c, 43, 64), 0, "-1e30: bytes 43..63 untouched");
    store8(c + n, 0);
    assert_eq(streq(c, "-1.00e+30"), 1, "-1e30 text (was -9131138316486228051.07, wrong sign)");

    test_group("wide decimals: at most 18 computed, the rest '0' (6.6.18 review)");
    var w = alloc(128);
    if (w == 0) { return 1; }
    var half = f64_div(f64_from(7), f64_from(2));
    n = fmt_float_buf(half, w, 20);
    store8(w + n, 0);
    assert_eq(streq(w, "3.50000000000000000000"), 1, "3.5 at 20 decimals (10^20 overflowed i64)");
    n = fmt_float_buf(f64_from(3), w, 64);
    assert_eq(n, 66, "3 at 64 decimals: 66 chars (10^64 wrapped to 0: SIGFPE)");
    var zs = 0;
    var i = 2;
    while (i < 66) { if (load8(w + i) == 48) { zs = zs + 1; } i = i + 1; }
    assert_eq(zs, 64, "every fraction digit is '0'");
    n = fmt_float_buf(half, w, 18);
    store8(w + n, 0);
    assert_eq(streq(w, "3.500000000000000000"), 1, "18 decimals unchanged");

    test_group("|val| >= 2^63: exact integer, or bounded exponent form (6.6.20)");
    # f64_to saturates past i64 range and the fraction's carry then wrapped the integer
    # negative: 1e300 printed `-9131138316486228051.07`, -1e300 `--9131…`, every huge value
    # at 0 decimals `-2.0`, and 2^63 a plausible, off-by-one `…775807`.
    assert_eq(_ff(0x43E0000000000000, 2, w, "9223372036854775808.00"), 1, "2^63 exact (was …775807)");
    assert_eq(_ff(0xC3E0000000000000, 2, w, "-9223372036854775808.00"), 1, "-2^63 exact");
    assert_eq(_ff(0x43E158E460913D00, 3, w, "10000000000000000000.000"), 1, "1e19");
    assert_eq(_ff(0x43EFFFFFFFFFFFFF, 2, w, "18446744073709549568.00"), 1, "largest double below 2^64");
    assert_eq(_ff(0x43EFFFFFFFFFFFFF, 20, w, "18446744073709549568.00000000000000000000"), 1,
      "below 2^64 at 20 decimals");
    assert_eq(_ff(0x4415AF1D78B58C40, 2, w, "1.00e+20"), 1, "1e20: first 21-digit value, exponent form");
    assert_eq(_ff(0x7E37E43C8800759C, 0, w, "1.0e+300"), 1, "1e300 at 0 decimals (was -2.0)");
    assert_eq(_ff(0x7E37E43C8800759C, 2, w, "1.00e+300"), 1, "1e300 at 2 decimals");
    assert_eq(_ff(0x7E37E43C8800759C, 18, w, "1.000000000000000053e+300"), 1,
      "1e300 at 18 decimals: the exact binary value, rounded");
    assert_eq(_ff(0x7E37E43C8800759C, 20, w, "1.00000000000000005300e+300"), 1,
      "1e300 at 20 decimals: 18 computed, then '0'");
    assert_eq(_ff(0xFE37E43C8800759C, 2, w, "-1.00e+300"), 1, "-1e300: one sign (was --…)");
    assert_eq(_ff(0x7FEFFFFFFFFFFFFF, 2, w, "1.80e+308"), 1, "DBL_MAX");
    assert_eq(_ff(0x44B52D02C7E14AF6, 2, w, "1.00e+23"), 1, "9.99…e22 rounds up through the 9s");
    assert_eq(_ff(0x441B1AE4D6E2EF50, 1, w, "1.2e+20"), 1, "exact tie 1.25e20 -> even");
    assert_eq(_ff(0x442B1AE4D6E2EF50, 0, w, "2.0e+20"), 1, "exact tie 2.5e20 -> even");
    # fmt_float pads decimals past 18 INSIDE the mantissa, before the exponent.
    assert_eq(_ffout(0x7E37E43C8800759C, 2, "1.00e+300"), 1, "fmt_float(1e300, 2)");
    assert_eq(_ffout(0xFE37E43C8800759C, 2, "-1.00e+300"), 1, "fmt_float(-1e300, 2)");
    assert_eq(_ffout(0x7E37E43C8800759C, 20, "1.00000000000000005300e+300"), 1,
      "fmt_float(1e300, 20): padding before e+300");
    assert_eq(_ffout(0x43E0000000000000, 20, "9223372036854775808.00000000000000000000"), 1,
      "fmt_float(2^63, 20)");

    # fmt_float's own stack buffer: these overran `var buf[32]` (a smashed frame).
    fmt_float(big, 2);
    fmt_float(f64_from(3), 50);
    fmt_float(half, 20);
    fmt_float(f64_from(3), 64);
    syscall(1, 1, "\n", 1);
    assert(1, "fmt_float survives the worst case");

    var r = assert_summary();
    return r;
}
var r = main();
syscall(60, r);
