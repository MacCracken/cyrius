# tls12_ciphersuites.tcyr — v6.0.74 TLS 1.2 ciphersuite registry
#
# Mini-arc D step 3 (.74) registers the modern AEAD 1.2 ciphersuites
# (RFC 5289 §3.2 GCM + RFC 7905 ChaCha) and the wire-id lookups that
# bridge them onto the internal AEAD-identity (0x130x) the .72/.73
# record + PRF layer dispatches on. This asserts every wire id maps to
# the correct identity / auth algo / hash, the supported allowlist is
# exactly {0xC02C, 0xCCA9}, the reverse map, and unknown-id rejection.
# See CHANGELOG [6.0.74].

include "lib/tls_native.cyr"
include "lib/assert.cyr"

test_group("TLS 1.2 ciphersuite registry (.74)");

# --- wire -> AEAD identity (the 0x130x const all .72/.73 helpers want) ---
assert_eq(tls_native_12_cipher_aead_identity(TLS12_ECDHE_ECDSA_AES128_GCM_SHA256), TLS_AES_128_GCM_SHA256, "0xC02B -> AES-128-GCM identity");
assert_eq(tls_native_12_cipher_aead_identity(TLS12_ECDHE_RSA_AES128_GCM_SHA256),   TLS_AES_128_GCM_SHA256, "0xC02F -> AES-128-GCM identity");
assert_eq(tls_native_12_cipher_aead_identity(TLS12_ECDHE_ECDSA_AES256_GCM_SHA384), TLS_AES_256_GCM_SHA384, "0xC02C -> AES-256-GCM identity");
assert_eq(tls_native_12_cipher_aead_identity(TLS12_ECDHE_RSA_AES256_GCM_SHA384),   TLS_AES_256_GCM_SHA384, "0xC030 -> AES-256-GCM identity");
assert_eq(tls_native_12_cipher_aead_identity(TLS12_ECDHE_ECDSA_CHACHA20_SHA256),   TLS_CHACHA20_POLY1305_SHA256, "0xCCA9 -> ChaCha20 identity");
assert_eq(tls_native_12_cipher_aead_identity(TLS12_ECDHE_RSA_CHACHA20_SHA256),     TLS_CHACHA20_POLY1305_SHA256, "0xCCA8 -> ChaCha20 identity");
assert_eq(tls_native_12_cipher_aead_identity(0x0000), 0 - 1, "unknown wire id -> -1 identity");
assert_eq(tls_native_12_cipher_aead_identity(0x1302), 0 - 1, "a 1.3 wire id is NOT a 1.2 id -> -1");

# --- wire -> auth algo (collapse erases this; separate lookup) ---
assert_eq(tls_native_12_cipher_auth(TLS12_ECDHE_ECDSA_AES128_GCM_SHA256), TLS12_AUTH_ECDSA, "0xC02B auth = ECDSA");
assert_eq(tls_native_12_cipher_auth(TLS12_ECDHE_RSA_AES128_GCM_SHA256),   TLS12_AUTH_RSA,   "0xC02F auth = RSA (same identity, different auth)");
assert_eq(tls_native_12_cipher_auth(TLS12_ECDHE_ECDSA_CHACHA20_SHA256),   TLS12_AUTH_ECDSA, "0xCCA9 auth = ECDSA");
assert_eq(tls_native_12_cipher_auth(TLS12_ECDHE_RSA_CHACHA20_SHA256),     TLS12_AUTH_RSA,   "0xCCA8 auth = RSA");
assert_eq(tls_native_12_cipher_auth(0x0000), 0 - 1, "unknown wire id -> -1 auth");

# --- wire -> PRF/transcript hash (answers for all six, even unsupported) ---
assert_eq(tls_native_12_cipher_hash(TLS12_ECDHE_ECDSA_AES256_GCM_SHA384), TLS_HASH_SHA384, "0xC02C hash = SHA384");
assert_eq(tls_native_12_cipher_hash(TLS12_ECDHE_RSA_AES256_GCM_SHA384),   TLS_HASH_SHA384, "0xC030 hash = SHA384");
assert_eq(tls_native_12_cipher_hash(TLS12_ECDHE_ECDSA_AES128_GCM_SHA256), TLS_HASH_SHA256, "0xC02B hash = SHA256");
assert_eq(tls_native_12_cipher_hash(TLS12_ECDHE_ECDSA_CHACHA20_SHA256),   TLS_HASH_SHA256, "0xCCA9 hash = SHA256");
assert_eq(tls_native_12_cipher_hash(0x0000), 0 - 1, "unknown wire id -> -1 hash");

# --- supported allowlist (.83): ECDHE_ECDSA + ECDHE_RSA over AES-128/256-GCM + ChaCha ---
assert_eq(tls_native_12_cipher_supported(TLS12_ECDHE_ECDSA_AES256_GCM_SHA384), 1, "0xC02C supported");
assert_eq(tls_native_12_cipher_supported(TLS12_ECDHE_ECDSA_CHACHA20_SHA256),   1, "0xCCA9 supported");
assert_eq(tls_native_12_cipher_supported(TLS12_ECDHE_ECDSA_AES128_GCM_SHA256), 1, "0xC02B supported (.83 AES-128)");
assert_eq(tls_native_12_cipher_supported(TLS12_ECDHE_RSA_AES256_GCM_SHA384),   1, "0xC030 supported (.83 RSA-auth)");
assert_eq(tls_native_12_cipher_supported(TLS12_ECDHE_RSA_AES128_GCM_SHA256),   1, "0xC02F supported (.83 RSA+AES-128)");
assert_eq(tls_native_12_cipher_supported(TLS12_ECDHE_RSA_CHACHA20_SHA256),     1, "0xCCA8 supported (.83 RSA-auth)");
assert_eq(tls_native_12_cipher_supported(0x0000), 0, "unknown wire id NOT supported");

# --- reverse map (identity + auth -> wire id for ServerHello) ---
assert_eq(tls_native_aead_to_wire_12(TLS_AES_256_GCM_SHA384, TLS12_AUTH_ECDSA),       TLS12_ECDHE_ECDSA_AES256_GCM_SHA384, "AES-256-GCM + ECDSA -> 0xC02C");
assert_eq(tls_native_aead_to_wire_12(TLS_CHACHA20_POLY1305_SHA256, TLS12_AUTH_ECDSA), TLS12_ECDHE_ECDSA_CHACHA20_SHA256,   "ChaCha20 + ECDSA -> 0xCCA9");
assert_eq(tls_native_aead_to_wire_12(TLS_AES_256_GCM_SHA384, TLS12_AUTH_RSA), 0 - 1, "AES-256-GCM + RSA -> -1 (RSA not emitted)");
assert_eq(tls_native_aead_to_wire_12(TLS_AES_128_GCM_SHA256, TLS12_AUTH_ECDSA), 0 - 1, "AES-128 + ECDSA -> -1 (not emitted)");

var r = assert_summary();
