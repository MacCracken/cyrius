# tls12_keysched.tcyr — v6.0.73 TLS 1.2 PRF + key derivation KAT
#
# Known-answer vectors for the TLS 1.2 PRF / master-secret / key-block /
# Finished verify_data derivation (lib/tls_native.cyr, Mini-arc D .73),
# cross-checked against an independent RFC 5246 §5 P_hash reference
# (HMAC expansion) for BOTH ciphersuite hashes (SHA-384 + SHA-256). The
# expected bytes are embedded literals; deriving them wrong (e.g. swapping
# the client/server random order between master_secret and key_block) fails
# the KAT even though a seal/open round-trip would still pass. Also asserts
# key_block partitioning and that the derived material protects a .72 record.
# See CHANGELOG [6.0.73].

include "lib/tls_native.cyr"
include "lib/assert.cyr"

test_group("TLS 1.2 PRF + key derivation (.73)");

