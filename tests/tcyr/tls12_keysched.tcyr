# --- integration: derived client key/salt protect a .72 record ---
var wseq1[8]; tls_native_seq_init(&wseq1);
var rseq1[8]; tls_native_seq_init(&rseq1);
var rec1[128];
var pt1 = "derived-key record!!";
var n1 = tls_native_record_seal_12(TLS_AES_256_GCM_SHA384, &cwk1, &cwiv1, &wseq1, TLS_CT_APPLICATION_DATA, pt1, 20, &rec1, 128);
assert_eq(n1, 49, "GCM record sealed with derived key (49 bytes)");
var o1[128]; var ct1 = 0;
assert_eq(tls_native_record_open_12(TLS_AES_256_GCM_SHA384, &cwk1, &cwiv1, &rseq1, &rec1, n1, &o1, 128, &ct1), 20, "derived AES256-GCM key round-trips a record");
assert_eq(_tn_ct_eq(&o1, pt1, 20), 1, "derived-key record plaintext matches");

