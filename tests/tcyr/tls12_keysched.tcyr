var cwk1[32]; var swk1[32]; var cwiv1[4]; var swiv1[4];
assert_eq(tls_native_12_partition_keys(TLS_AES_256_GCM_SHA384, &kb1, &cwk1, &swk1, &cwiv1, &swiv1), TLS_OK, "partition OK");
assert_eq(_tn_ct_eq(&cwk1, &kb1, 32), 1, "client_write_key = key_block[0..32]");
assert_eq(_tn_ct_eq(&swk1, &kb1 + 32, 32), 1, "server_write_key = key_block[32..64]");
assert_eq(_tn_ct_eq(&cwiv1, &kb1 + 64, 4), 1, "client_write_IV(salt) = key_block[64..68]");
assert_eq(_tn_ct_eq(&swiv1, &kb1 + 68, 4), 1, "server_write_IV(salt) = key_block[68..72]");

