# --- integration: ChaCha derived key/IV protect a .72 record (no explicit nonce) ---
var wseq2[8]; tls_native_seq_init(&wseq2);
var rseq2[8]; tls_native_seq_init(&rseq2);
var rec2[128];
var n2 = tls_native_record_seal_12(TLS_CHACHA20_POLY1305_SHA256, &cwk2, &cwiv2, &wseq2, TLS_CT_HANDSHAKE, pt1, 20, &rec2, 128);
assert_eq(n2, 41, "ChaCha record sealed with derived key (41 bytes, no explicit nonce)");
var o2[128]; var ct2 = 0;
assert_eq(tls_native_record_open_12(TLS_CHACHA20_POLY1305_SHA256, &cwk2, &cwiv2, &rseq2, &rec2, n2, &o2, 128, &ct2), 20, "derived ChaCha key round-trips a record");
assert_eq(_tn_ct_eq(&o2, pt1, 20), 1, "ChaCha derived-key plaintext matches");

var r = assert_summary();
