# tls_native_alpn.tcyr — server-side ALPN negotiation (RFC 7301).
# Our native client ↔ our native server over a socketpair. The server is
# configured with an ALPN preference list (tls_native_set_alpn); the client
# offers its own list in the ClientHello; the server parses the offer, selects
# its first preference the client also offers (server-preference order, RFC 7301
# §3.2), and emits the choice in EncryptedExtensions (TLS 1.3). Both sides then
# read back the negotiated protocol via tls_native_get_alpn_selected. Covers the
# gap in docs/development/issues/2026-06-18-tls-native-server-alpn-not-negotiated.md
# (the server side previously ignored ALPN entirely — set_alpn was client-only).
# Self-signed Ed25519 leaf (CN=127.0.0.1) reused from tls_native_ed25519.tcyr;
# the client defaults to TLS_VERIFY_NONE so only the ALPN path is under test.
#define CYRIUS_TLS_NATIVE
include "lib/fdlopen.cyr"
include "lib/tls_native.cyr"
include "lib/tls.cyr"
include "lib/assert.cyr"

test_group("tls_native server ALPN (RFC 7301)");

var cert = hex_decode("", 640);
var key = hex_decode("302e020100300506032b657004220420ea5da8171db67e4e169e246d8f7223ee88110129914478f8b49ffc898780df10", 96);

# --- Positive: server prefers h2 then http/1.1; client offers http/1.1 then h2.
# Server preference wins → "h2". Both sides must see it. ---
var fds[8];
sys_socketpair(1, 1, 0, &fds);
var fdp = load64(&fds);
var sfd = fdp & 0xFFFFFFFF;
var cfd = (fdp >> 32) & 0xFFFFFFFF;

var pid = sys_fork();
if (pid == 0) {
    sys_close(sfd);
    var cli = tls_native_new_client("localhost", 9);
    if (cli == 0) { sys_exit(10); }
    tls_native_set_verify(cli, TLS_VERIFY_NONE);            # accept the self-signed test cert
    tls_native_set_alpn(cli, "\x08http/1.1\x02h2", 12);     # client: http/1.1, h2
    if (tls_native_connect(cli, cfd) != TLS_OK) { sys_exit(11); }
    var ab[64];
    if (tls_native_get_alpn_selected(cli, &ab, 64) != 2) { sys_exit(12); }
    if (_tn_ct_eq(&ab, "h2", 2) != 1) { sys_exit(13); }     # client saw the server's choice
    if (tls_native_write(cli, "hi", 2) != 2) { sys_exit(14); }
    tls_native_close(cli);
    sys_close(cfd);
    sys_exit(0);
}
sys_close(cfd);
var srv = tls_native_new_server(cert, 320, key, 48);
tls_native_set_alpn(srv, "\x02h2\x08http/1.1", 12);         # server prefers h2
tls_native_server_load_creds(srv);
assert_eq(tls_native_accept(srv, sfd), TLS_OK, "server accepts an ALPN-offering client");
var sab[64];
assert_eq(tls_native_get_alpn_selected(srv, &sab, 64), 2, "server selected a 2-byte protocol");
assert_eq(_tn_ct_eq(&sab, "h2", 2), 1, "server selected h2 (server preference wins, RFC 7301 §3.2)");
var sb[64];
assert_eq(tls_native_read(srv, &sb, 64), 2, "server reads app data (ALPN handshake completed)");
var st[4];
sys_waitpid(pid, &st, 0);
assert_eq((load64(&st) >> 8) & 0xFF, 0, "client read ALPN=h2 from server EncryptedExtensions (child exit 0)");

# --- No overlap: server offers only http/1.1, client offers only h2. No common
# protocol → no ALPN selected on EITHER side, handshake still succeeds. ---
var fds2[8];
sys_socketpair(1, 1, 0, &fds2);
var fdp2 = load64(&fds2);
var sfd2 = fdp2 & 0xFFFFFFFF;
var cfd2 = (fdp2 >> 32) & 0xFFFFFFFF;

var pid2 = sys_fork();
if (pid2 == 0) {
    sys_close(sfd2);
    var cli2 = tls_native_new_client("localhost", 9);
    if (cli2 == 0) { sys_exit(20); }
    tls_native_set_verify(cli2, TLS_VERIFY_NONE);           # accept the self-signed test cert
    tls_native_set_alpn(cli2, "\x02h2", 3);                 # client: h2 only
    if (tls_native_connect(cli2, cfd2) != TLS_OK) { sys_exit(21); }
    var ab2[64];
    if (tls_native_get_alpn_selected(cli2, &ab2, 64) != 0) { sys_exit(22); }
    if (tls_native_write(cli2, "hi", 2) != 2) { sys_exit(23); }
    tls_native_close(cli2);
    sys_close(cfd2);
    sys_exit(0);
}
sys_close(cfd2);
var srv2 = tls_native_new_server(cert, 320, key, 48);
tls_native_set_alpn(srv2, "\x08http/1.1", 9);               # server: http/1.1 only
tls_native_server_load_creds(srv2);
assert_eq(tls_native_accept(srv2, sfd2), TLS_OK, "server accepts (no ALPN overlap → handshake still succeeds)");
var sab2[64];
assert_eq(tls_native_get_alpn_selected(srv2, &sab2, 64), 0, "server selected nothing (no common protocol)");
var sb2[64];
assert_eq(tls_native_read(srv2, &sb2, 64), 2, "server reads app data (no-ALPN handshake completed)");
var st2[4];
sys_waitpid(pid2, &st2, 0);
assert_eq((load64(&st2) >> 8) & 0xFF, 0, "client saw no ALPN selected (child exit 0)");

var r = assert_summary();
