# tls_native_realpeer.tcyr — v6.0.81 (Mini-arc E Release B)
# LIVE real-peer HTTPS smoke. The sovereign native TLS client, driven through
# the stdlib lib/tls.cyr wrapper (native backend), completes a real TLS 1.3
# handshake with Cloudflare (1.1.1.1:443) — exercising server-flight
# reassembly (real servers fragment the EE/Cert/CertVerify/Finished flight),
# full cert-chain verification through the OS trust store (the chain roots at
# the SSL.com Root ECC, parseable since sigil 3.7.4), and SNI hostname
# verification — then sends an HTTP/1.1 GET and reads the response. Guarded:
# skips cleanly when there is no network (sys_connect fails). Robust to leaf
# rotation (verification roots at the stable OS-trusted root). See CHANGELOG [6.0.81].
#define CYRIUS_TLS_NATIVE
include "lib/fdlopen.cyr"
include "lib/tls_native.cyr"
include "lib/tls.cyr"
include "lib/assert.cyr"

test_group("v6.0.81 live real-peer HTTPS smoke (Cloudflare 1.1.1.1:443)");

var fd = sys_socket(2, 1, 0);
var sa[16];
var i = 0;
while (i < 16) { store8(&sa + i, 0); i = i + 1; }
store8(&sa, 2);                                   # AF_INET
store8(&sa + 2, 0x01); store8(&sa + 3, 0xBB);     # port 443
store8(&sa + 4, 1); store8(&sa + 5, 1); store8(&sa + 6, 1); store8(&sa + 7, 1);   # 1.1.1.1

# 10-second send/recv timeouts so a slow/unreachable peer can't hang the suite.
var tv[16];
store64(&tv, 10); store64(&tv + 8, 0);
sys_setsockopt(fd, 1, 20, &tv, 16);   # SOL_SOCKET, SO_RCVTIMEO
sys_setsockopt(fd, 1, 21, &tv, 16);   # SOL_SOCKET, SO_SNDTIMEO

if (sys_connect(fd, &sa, 16) != 0) {
    assert_eq(1, 1, "no network to 1.1.1.1:443 — live real-peer smoke skipped");
} else {
    tls_set_backend(TLS_BACKEND_NATIVE);
    # Native handshake + flight reassembly + verify_chain (OS trust store) + SNI.
    var ctx = tls_connect(fd, "one.one.one.one");
    assert_neq(ctx, 0, "live TLS 1.3 handshake + cert+hostname verification vs Cloudflare");
    if (ctx != 0) {
        var req = "GET / HTTP/1.1\r\nHost: one.one.one.one\r\nConnection: close\r\n\r\n";
        assert_gt(tls_write(ctx, req, strlen(req)), 0, "wrote HTTP request over native TLS");
        var resp = alloc(16384);
        var n = 0;
        var tries = 0;
        while (tries < 8) {                       # loop past NewSessionTicket records (return 0)
            n = tls_read(ctx, resp, 16384);
            if (n > 0) { tries = 8; }
            if (n < 0) { tries = 8; }
            tries = tries + 1;
        }
        assert_gt(n, 0, "read HTTP response over native TLS");
        assert_eq(_tn_ct_eq(resp, "HTTP/1.1 ", 9), 1, "response is a valid HTTP/1.1 status line");
        tls_close(ctx);
    }
}

var r = assert_summary();
