# tls_native_scaffold.tcyr — v6.0.10 API-surface lock
#
# Mini-arc A.1 (v6.0.10) shipped the lib/tls_native.cyr scaffold —
# public API, types, error codes, and stub implementations. No
# protocol logic yet (slots .11-.34 ship that). This test locks
# the public surface so a future slot can't accidentally rename a
# fn or drop a const without check.sh going red.
#
# Each stub fn is called with sentinel args and asserted to return
# the documented "not yet implemented" signal:
#   - tls_native_available() returns 0 (capability check; will
#     flip to 1 when .14 ciphersuite-negotiation lands).
#   - tls_native_new_client / new_server return 0 (alloc-failure
#     sentinel; will return real heap ctx handles later).
#   - All other stateful fns return TLS_ERR_NOT_IMPLEMENTED.
#   - Getters (get_alpn_selected, get_peer_cert_der, get_cipher,
#     get_version) return 0 (no handshake completed); get_state
#     returns TLS_STATE_INIT.
#
# When mini-arc A.2-D ship real implementations, this test gets
# updated in lockstep — the assertion changes from
# `assert_eq(..., TLS_ERR_NOT_IMPLEMENTED, ...)` to the real
# expected behavior.

include "lib/tls_native.cyr"
include "lib/assert.cyr"

test_group("tls_native v6.0.10 scaffold API surface");

# Capability check — flipped 0→1 at v6.0.14 (AES-256-GCM + ChaCha20-Poly1305 wired).
assert_eq(tls_native_available(), 1, "tls_native_available() = 1 at .14");

# new_client is live (.24) — returns a client ctx; new_server (.15)
# rejects null cert/key args with the 0 sentinel.
assert_nonnull(tls_native_new_client("example.com", 11), "new_client returns a ctx");
assert_eq(tls_native_new_server(0, 0, 0, 0), 0, "new_server rejects null cert (0)");

# Stateful fns not yet wired return TLS_ERR_NOT_IMPLEMENTED. ctx arg
# is 0 (invalid handle) — these stubs don't dereference yet.
assert_eq(tls_native_set_alpn(0, 0, 0), TLS_ERR_NOT_IMPLEMENTED, "set_alpn stub");
# set_verify is live (.15): null ctx → INVALID_PARAM, not NOT_IMPLEMENTED.
assert_eq(tls_native_set_verify(0, TLS_VERIFY_PEER), TLS_ERR_INVALID_PARAM, "set_verify null ctx");
assert_eq(tls_native_set_ca_bundle(0, 0, 0, 0), TLS_ERR_NOT_IMPLEMENTED, "set_ca_bundle stub");
assert_eq(tls_native_set_version_range(0, TLS_VERSION_1_2, TLS_VERSION_1_3), TLS_ERR_NOT_IMPLEMENTED, "set_version_range stub");
assert_eq(tls_native_connect(0, 0 - 1), TLS_ERR_NOT_IMPLEMENTED, "connect stub");
assert_eq(tls_native_accept(0, 0 - 1), TLS_ERR_INVALID_PARAM, "accept null ctx → INVALID_PARAM");
assert_eq(tls_native_write(0, 0, 0), TLS_ERR_NOT_IMPLEMENTED, "write stub");
assert_eq(tls_native_read(0, 0, 0), TLS_ERR_NOT_IMPLEMENTED, "read stub");
assert_eq(tls_native_close(0), TLS_ERR_NOT_IMPLEMENTED, "close stub");

# Getters return defaults
assert_eq(tls_native_get_alpn_selected(0, 0, 0), 0, "get_alpn_selected default 0");
assert_eq(tls_native_get_peer_cert_der(0, 0, 0), 0, "get_peer_cert_der default 0");
assert_eq(tls_native_get_state(0), TLS_STATE_ERROR, "get_state(null) = ERROR");
assert_eq(tls_native_get_cipher(0), 0, "get_cipher default 0");
assert_eq(tls_native_get_version(0), 0, "get_version default 0");

test_group("v6.0.10 enum / const sanity");

# Error code spread (negative ladder; catches accidental renumbering)
assert_eq(TLS_OK, 0, "TLS_OK = 0");
assert_eq(TLS_ERR_NOT_IMPLEMENTED, 0 - 1, "TLS_ERR_NOT_IMPLEMENTED = -1");
assert_eq(TLS_ERR_PROTOCOL, 0 - 19, "TLS_ERR_PROTOCOL = -19 (last in ladder)");

# Record-layer wire values per RFC 8446 §5.1
assert_eq(TLS_CT_CHANGE_CIPHER_SPEC, 20, "ContentType change_cipher_spec wire = 20");
assert_eq(TLS_CT_ALERT, 21, "ContentType alert wire = 21");
assert_eq(TLS_CT_HANDSHAKE, 22, "ContentType handshake wire = 22");
assert_eq(TLS_CT_APPLICATION_DATA, 23, "ContentType application_data wire = 23");

# Protocol versions per RFC 5246 / 8446
assert_eq(TLS_VERSION_1_2, 0x0303, "version 1.2 wire = 0x0303");
assert_eq(TLS_VERSION_1_3, 0x0304, "version 1.3 wire = 0x0304");

# Ciphersuites per RFC 8446 §B.4
assert_eq(TLS_AES_128_GCM_SHA256, 0x1301, "TLS_AES_128_GCM_SHA256 = 0x1301");
assert_eq(TLS_AES_256_GCM_SHA384, 0x1302, "TLS_AES_256_GCM_SHA384 = 0x1302");
assert_eq(TLS_CHACHA20_POLY1305_SHA256, 0x1303, "TLS_CHACHA20_POLY1305_SHA256 = 0x1303");

# Handshake types per RFC 8446 §4
assert_eq(TLS_HS_CLIENT_HELLO, 1, "HandshakeType ClientHello = 1");
assert_eq(TLS_HS_SERVER_HELLO, 2, "HandshakeType ServerHello = 2");
assert_eq(TLS_HS_FINISHED, 20, "HandshakeType Finished = 20");

# Named groups per IANA
assert_eq(TLS_GROUP_X25519, 0x001D, "X25519 group = 0x001D");
assert_eq(TLS_GROUP_SECP256R1, 0x0017, "secp256r1 group = 0x0017");

test_group("v6.0.11 record layer — constants + BE helpers");

# Record-layer caps (RFC 8446 §5.1, §5.2)
assert_eq(TLS_RECORD_HEADER_LEN, 5, "record header is 1+2+2 bytes");
assert_eq(TLS_RECORD_MAX_PLAINTEXT, 16384, "max plaintext fragment = 2^14");
assert_eq(TLS_RECORD_MAX_CIPHERTEXT, 16640, "max ciphertext fragment = 16384 + 256");
assert_eq(TLS_AEAD_NONCE_LEN, 12, "AEAD nonce = 96 bits");
assert_eq(TLS_AEAD_TAG_LEN, 16, "AEAD tag = 128 bits (Poly1305 / GCM-128)");
assert_eq(TLS_SEQ_NUM_LEN, 8, "sequence number = 64 bits");

# BE wire helpers — round-trip
var _be_buf[2];
_tn_be16_w(&_be_buf, 0x1303);  # TLS_CHACHA20_POLY1305_SHA256
assert_eq(load8(&_be_buf),     0x13, "be16_w MSB first");
assert_eq(load8(&_be_buf + 1), 0x03, "be16_w LSB second");
assert_eq(_tn_be16_r(&_be_buf), 0x1303, "be16_r round-trips");

var _be24[3];
_tn_be24_w(&_be24, 0xABCDEF);
assert_eq(load8(&_be24),     0xAB, "be24_w byte0");
assert_eq(load8(&_be24 + 1), 0xCD, "be24_w byte1");
assert_eq(load8(&_be24 + 2), 0xEF, "be24_w byte2");
assert_eq(_tn_be24_r(&_be24), 0xABCDEF, "be24_r round-trips (handshake length field)");

var _be64[8];
_tn_be64_w(&_be64, 0x0123456789ABCDEF);
assert_eq(_tn_be64_r(&_be64), 0x0123456789ABCDEF, "be64 round-trip");

test_group("v6.0.11 record layer — header encode/decode");

# Encode + decode a TLS 1.3 Application Data record header (the
# typical post-handshake shape: ct=23, version=0x0303 legacy,
# length=42 for a 42-byte ciphertext fragment).
var _hdr[5];
var n = tls_native_record_write_header(&_hdr, TLS_CT_APPLICATION_DATA, 0x0303, 42);
assert_eq(n, 5, "write_header returns 5");
assert_eq(load8(&_hdr),     23,   "header byte 0 = ContentType app_data (23)");
assert_eq(load8(&_hdr + 1), 0x03, "header byte 1 = version_hi (0x03)");
assert_eq(load8(&_hdr + 2), 0x03, "header byte 2 = version_lo (0x03)");
assert_eq(load8(&_hdr + 3), 0x00, "header byte 3 = length_hi (0)");
assert_eq(load8(&_hdr + 4), 42,   "header byte 4 = length_lo (42)");

# Decode the same header back.
var _ct_out[1];
var _ver_out[1];
var _len_out[1];
var rc = tls_native_record_read_header(&_hdr, 5, &_ct_out, &_ver_out, &_len_out);
assert_eq(rc, 5, "read_header returns 5");
assert_eq(load64(&_ct_out),  TLS_CT_APPLICATION_DATA, "decoded ct");
assert_eq(load64(&_ver_out), 0x0303,                  "decoded version");
assert_eq(load64(&_len_out), 42,                      "decoded length");

# Short-buffer rejection (RFC requires the full 5-byte header).
var _short[1];
assert_eq(tls_native_record_read_header(&_short, 4, &_ct_out, &_ver_out, &_len_out),
          TLS_ERR_BAD_RECORD, "read_header rejects buflen < 5");

# Length-cap rejection
assert_eq(tls_native_record_write_header(&_hdr, 23, 0x0303, 16641),
          TLS_ERR_INVALID_PARAM, "write_header rejects length > 16640");

# Fragmentation counts (RFC 8446 §5.1)
assert_eq(tls_native_record_fragment_count(0),     0, "empty payload → 0 records");
assert_eq(tls_native_record_fragment_count(1),     1, "1 byte → 1 record");
assert_eq(tls_native_record_fragment_count(16384), 1, "exactly cap → 1 record");
assert_eq(tls_native_record_fragment_count(16385), 2, "cap+1 → 2 records");
assert_eq(tls_native_record_fragment_count(32768), 2, "exactly 2× cap → 2 records");
assert_eq(tls_native_record_fragment_count(32769), 3, "2×cap+1 → 3 records");

test_group("v6.0.11 record layer — sequence numbers + AEAD nonce");

# Sequence init + increment
var _seq[1];
tls_native_seq_init(&_seq);
assert_eq(_tn_be64_r(&_seq), 0, "seq_init zeros the buffer");

tls_native_seq_increment(&_seq);
assert_eq(_tn_be64_r(&_seq), 1, "seq_increment: 0 → 1");
tls_native_seq_increment(&_seq);
tls_native_seq_increment(&_seq);
assert_eq(_tn_be64_r(&_seq), 3, "seq_increment: 1 → 2 → 3");

# Sequence-exhaustion guard: set to MAX and verify the next bump
# returns TLS_ERR_PROTOCOL. (Use _tn_be64_w to plant the sentinel
# value — increment-from-zero 2^64 times is not feasible.)
_tn_be64_w(&_seq, 0 - 1);  # all 64 bits set
assert_eq(tls_native_seq_increment(&_seq), TLS_ERR_PROTOCOL,
          "seq_increment refuses to wrap from all-ones");

# AEAD nonce derivation per RFC 8446 §5.3. Hand-crafted vector:
#   static_iv = 0x404142434445464748494A4B  (12 bytes; arbitrary)
#   seq       = 0x0000000000000007         (record #7)
#   expected  = static_iv XOR (4 zero bytes || seq)
#             = 0x40414243 4445464F 4E4D4C40
#                                  ^^ high 4 bytes copied
#                                              ^^ low 8 XOR'd
# NB cyrius `var x[N]` allocates N BYTES (rounded up to 8), not N
# slots — so we need [12] for the 12-byte IV, not [2]. Earlier draft
# used [2] (8 bytes), which overlapped with the next local and got
# clobbered by the seq write. Caught by the v6.0.11 .tcyr.
var _iv[12];
_tn_be32_w(&_iv,     0x40414243);
_tn_be32_w(&_iv + 4, 0x44454647);
_tn_be32_w(&_iv + 8, 0x48494A4B);

var _seq2[8];
_tn_be64_w(&_seq2, 7);  # record number 7

var _nonce[12];
tls_native_aead_nonce(&_iv, &_seq2, &_nonce);
# Expected: high 4 bytes copy IV; low 8 bytes = IV[4..12] XOR seq[0..8]
#   IV[4..12] = 44 45 46 47 48 49 4A 4B
#   seq[0..8] = 00 00 00 00 00 00 00 07
#   XOR       = 44 45 46 47 48 49 4A 4C
assert_eq(load8(&_nonce),     0x40, "nonce[0] = iv[0]");
assert_eq(load8(&_nonce + 3), 0x43, "nonce[3] = iv[3]");
assert_eq(load8(&_nonce + 4), 0x44, "nonce[4] = iv[4] XOR seq[0]=0");
assert_eq(load8(&_nonce + 10), 0x4A, "nonce[10] = iv[10] XOR seq[6]=0");
assert_eq(load8(&_nonce + 11), 0x4C, "nonce[11] = iv[11] XOR seq[7]=7 → 0x4B^0x07 = 0x4C");

# AAD construction: per RFC 8446 §5.2, the AAD for the AEAD is
# the 5-byte record header — so tls_native_record_aad should be
# byte-identical to tls_native_record_write_header.
var _aad[5];
tls_native_record_aad(TLS_CT_APPLICATION_DATA, 0x0303, 256, &_aad);
assert_eq(load8(&_aad),     23,   "aad[0] = ContentType");
assert_eq(load8(&_aad + 3), 0x01, "aad[3] = length_hi (256 >> 8 = 1)");
assert_eq(load8(&_aad + 4), 0x00, "aad[4] = length_lo (256 & 0xFF = 0)");

test_group("v6.0.12 handshake framing — header encode/decode");

assert_eq(TLS_HANDSHAKE_HEADER_LEN, 4, "handshake header is 1+3 bytes");

# Encode a ClientHello-sized handshake header:
#   hs_type = TLS_HS_CLIENT_HELLO (1)
#   body_len = 512 (0x200) — typical real-world ClientHello range
var _hsh[4];
var hn = tls_native_handshake_write_header(&_hsh, TLS_HS_CLIENT_HELLO, 512);
assert_eq(hn, 4, "write_handshake_header returns 4");
assert_eq(load8(&_hsh),     1,    "byte0 = msg_type (ClientHello = 1)");
assert_eq(load8(&_hsh + 1), 0x00, "byte1 = length_hi (uint24 MSB)");
assert_eq(load8(&_hsh + 2), 0x02, "byte2 = length_mid (512 >> 8 = 2)");
assert_eq(load8(&_hsh + 3), 0x00, "byte3 = length_lo (512 & 0xFF = 0)");

# Decode round-trip
var _ht_out[8];
var _hl_out[8];
var hr = tls_native_handshake_read_header(&_hsh, 4, &_ht_out, &_hl_out);
assert_eq(hr, 4, "read_handshake_header returns 4");
assert_eq(load64(&_ht_out), TLS_HS_CLIENT_HELLO, "decoded type = ClientHello");
assert_eq(load64(&_hl_out), 512,                 "decoded length = 512");

# Short-buffer rejection
assert_eq(tls_native_handshake_read_header(&_hsh, 3, &_ht_out, &_hl_out),
          TLS_ERR_BAD_HANDSHAKE, "read_handshake_header rejects buflen < 4");

# uint24 overflow rejection
assert_eq(tls_native_handshake_write_header(&_hsh, TLS_HS_CLIENT_HELLO, 16777216),
          TLS_ERR_INVALID_PARAM, "write_handshake_header rejects body_len >= 2^24");

# Max uint24 boundary (16777215 = 0xFFFFFF)
var hmax = tls_native_handshake_write_header(&_hsh, TLS_HS_CERTIFICATE, 16777215);
assert_eq(hmax, 4, "write_handshake_header accepts body_len = 2^24 - 1");
assert_eq(load8(&_hsh + 1), 0xFF, "max body_len byte1");
assert_eq(load8(&_hsh + 2), 0xFF, "max body_len byte2");
assert_eq(load8(&_hsh + 3), 0xFF, "max body_len byte3");

test_group("v6.0.12 transcript hash — algo constants + length");

assert_eq(TLS_HASH_SHA256, 0, "sha256 algo = 0");
assert_eq(TLS_HASH_SHA384, 1, "sha384 algo = 1");
assert_eq(TLS_HASH_SHA256_LEN, 32, "sha256 digest = 32 bytes");
assert_eq(TLS_HASH_SHA384_LEN, 48, "sha384 digest = 48 bytes");

test_group("v6.0.12 transcript hash — SHA-256 FIPS 180-4 vector");

# FIPS 180-4 §B.1: SHA-256("abc") =
#   ba7816bf 8f01cfea 414140de 5dae2223
#   b00361a3 96177a9c b410ff61 f20015ad
var ts256 = tls_native_transcript_init(TLS_HASH_SHA256);
assert(ts256 != 0, "transcript_init sha256 succeeds");
assert_eq(tls_native_transcript_digest_len(ts256), 32, "digest_len = 32");

tls_native_transcript_update(ts256, "abc", 3);
var _dig256[32];
var dlen = tls_native_transcript_digest(ts256, &_dig256);
assert_eq(dlen, 32, "digest returns 32 for sha256");
assert_eq(load8(&_dig256),      0xBA, "sha256(abc)[0] = 0xBA");
assert_eq(load8(&_dig256 + 1),  0x78, "sha256(abc)[1] = 0x78");
assert_eq(load8(&_dig256 + 2),  0x16, "sha256(abc)[2] = 0x16");
assert_eq(load8(&_dig256 + 3),  0xBF, "sha256(abc)[3] = 0xBF");
assert_eq(load8(&_dig256 + 15), 0x23, "sha256(abc)[15] = 0x23");
assert_eq(load8(&_dig256 + 31), 0xAD, "sha256(abc)[31] = 0xAD");

test_group("v6.0.12 transcript hash — snapshot semantics (digest preserves ctx)");

# After digest(), the running ctx must still be usable. Snapshot
# again with the same input — bytes must match. Then update with more
# bytes — digest changes to sha256("abc" + extras).
var _dig256b[32];
var dlen2 = tls_native_transcript_digest(ts256, &_dig256b);
assert_eq(dlen2, 32, "second digest still returns 32");
assert_eq(load8(&_dig256b),      0xBA, "snapshot-2: sha256(abc)[0] same");
assert_eq(load8(&_dig256b + 31), 0xAD, "snapshot-2: sha256(abc)[31] same");

# Feed more bytes; digest should change.
tls_native_transcript_update(ts256, "def", 3);
var _dig256c[32];
tls_native_transcript_digest(ts256, &_dig256c);
# sha256("abcdef") = bef57ec7 f53a6d40 beb640a7 80a639c8
#                   3bc29ac8 a9816f1f c6c5c6dc d93c4721
assert_eq(load8(&_dig256c),     0xBE, "sha256(abcdef)[0] = 0xBE");
assert_eq(load8(&_dig256c + 1), 0xF5, "sha256(abcdef)[1] = 0xF5");
assert_eq(load8(&_dig256c + 31), 0x21, "sha256(abcdef)[31] = 0x21");

test_group("v6.0.12 transcript hash — SHA-384 FIPS 180-4 vector");

# FIPS 180-4 §B.1: SHA-384("abc") =
#   cb00753f 45a35e8b b5a03d69 9ac65007
#   272c32ab 0eded163 1a8b605a 43ff5bed
#   8086072b a1e7cc23 58baeca1 34c825a7
var ts384 = tls_native_transcript_init(TLS_HASH_SHA384);
assert(ts384 != 0, "transcript_init sha384 succeeds");
assert_eq(tls_native_transcript_digest_len(ts384), 48, "digest_len = 48");

tls_native_transcript_update(ts384, "abc", 3);
var _dig384[48];
var dlen384 = tls_native_transcript_digest(ts384, &_dig384);
assert_eq(dlen384, 48, "digest returns 48 for sha384");
assert_eq(load8(&_dig384),      0xCB, "sha384(abc)[0] = 0xCB");
assert_eq(load8(&_dig384 + 1),  0x00, "sha384(abc)[1] = 0x00");
assert_eq(load8(&_dig384 + 2),  0x75, "sha384(abc)[2] = 0x75");
assert_eq(load8(&_dig384 + 23), 0x63, "sha384(abc)[23] = 0x63");
assert_eq(load8(&_dig384 + 47), 0xA7, "sha384(abc)[47] = 0xA7");

# Invalid algo rejection
assert_eq(tls_native_transcript_init(99), 0, "transcript_init rejects invalid algo");
assert_eq(tls_native_transcript_digest_len(0), 0 - 1, "digest_len returns -1 for null state");

test_group("v6.0.13 key schedule — early secret (no-PSK)");

# RFC 8448 §3 reference: HKDF-Extract(salt=0, IKM=0^32) for SHA-256:
#   33ad0a1c 607ec03b 09e6cd98 93680ce2
#   10adf300 aa1f2660 e1b22e10 f170f92a
var ks256 = tls_native_keysched_new(TLS_HASH_SHA256);
assert(ks256 != 0, "keysched_new sha256 succeeds");
assert_eq(tls_native_keysched_phase(ks256), TLS_KSP_EARLY, "phase = EARLY after new");

var _es[32];
var es_len = tls_native_keysched_get_secret(ks256, TLS_KS_EARLY, &_es);
assert_eq(es_len, 32, "early_secret sha256 is 32 bytes");
assert_eq(load8(&_es),      0x33, "early[0] = 0x33 (RFC 8448 §3)");
assert_eq(load8(&_es + 1),  0xAD, "early[1] = 0xAD");
assert_eq(load8(&_es + 4),  0x60, "early[4] = 0x60");
assert_eq(load8(&_es + 16), 0x10, "early[16] = 0x10");
assert_eq(load8(&_es + 31), 0x2A, "early[31] = 0x2A");

# SHA-384 early_secret (Python-derived hkdf_extract_sha384(0, 0^48)):
#   7ee8206f 5570023e 6dc7519e b1073bc4 e791ad37 b5c382aa
#   10ba18e2 357e7169 71f9362f 2c2fe2a7 6bfd78df ec4ea9b5
var ks384 = tls_native_keysched_new(TLS_HASH_SHA384);
assert(ks384 != 0, "keysched_new sha384 succeeds");
var _es384[48];
var es384_len = tls_native_keysched_get_secret(ks384, TLS_KS_EARLY, &_es384);
assert_eq(es384_len, 48, "early_secret sha384 is 48 bytes");
assert_eq(load8(&_es384),      0x7E, "early384[0] = 0x7E");
assert_eq(load8(&_es384 + 1),  0xE8, "early384[1] = 0xE8");
assert_eq(load8(&_es384 + 23), 0xAA, "early384[23] = 0xAA");
assert_eq(load8(&_es384 + 47), 0xB5, "early384[47] = 0xB5");

test_group("v6.0.13 key schedule — HKDF-Expand-Label + Derive-Secret");

# Derive-Secret(early, "derived", "") for the SHA-256 path. Expected
# (Python ref):
#   6f2615a1 08c702c5 678f54fc 9dbab697
#   16c07618 9c48250c ebeac357 6c3611ba
var derived[32];
var empty_th = tls_native_transcript_init(TLS_HASH_SHA256);
assert(empty_th != 0, "empty transcript init");
var rc_derived = tls_native_derive_secret(&_es, 32, "derived", 7, empty_th, &derived);
assert_eq(rc_derived, TLS_OK, "derive_secret OK");
assert_eq(load8(&derived),      0x6F, "derived[0] = 0x6F");
assert_eq(load8(&derived + 1),  0x26, "derived[1] = 0x26");
assert_eq(load8(&derived + 16), 0x16, "derived[16] = 0x16");
assert_eq(load8(&derived + 31), 0xBA, "derived[31] = 0xBA");

# SHA-384 Derive-Secret(early, "derived", ""):
#   1591dac5 cbbf0330 a4a84de9 c753330e 92d01f0a 88214b44
#   64972fd6 68049e93 e52f2b16 fad922fd c0584478 428f282b
var derived384[48];
var empty_th384 = tls_native_transcript_init(TLS_HASH_SHA384);
var rc_d384 = tls_native_derive_secret(&_es384, 48, "derived", 7, empty_th384, &derived384);
assert_eq(rc_d384, TLS_OK, "derive_secret sha384 OK");
assert_eq(load8(&derived384),      0x15, "derived384[0] = 0x15");
assert_eq(load8(&derived384 + 1),  0x91, "derived384[1] = 0x91");
assert_eq(load8(&derived384 + 47), 0x2B, "derived384[47] = 0x2B");

test_group("v6.0.13 key schedule — Key+IV derivation");

# From a known traffic secret, derive write_key + write_iv via
# HKDF-Expand-Label(., "key" | "iv", "", N). Test secret:
#   b3eddb12 6e067f35 a780b3ab f45e2d8f
#   3b1a9507 38f52e96 00746a0e 27a55a21
# Python-computed AES-128 key + 12-byte IV:
#   key = dbfaa693d1762c5b666af5d950258d01
#   iv  = 5bd3c71b836e0b76bb73265f
var traffic_secret[32];
_tn_be32_w(&traffic_secret,      0xB3EDDB12);
_tn_be32_w(&traffic_secret + 4,  0x6E067F35);
_tn_be32_w(&traffic_secret + 8,  0xA780B3AB);
_tn_be32_w(&traffic_secret + 12, 0xF45E2D8F);
_tn_be32_w(&traffic_secret + 16, 0x3B1A9507);
_tn_be32_w(&traffic_secret + 20, 0x38F52E96);
_tn_be32_w(&traffic_secret + 24, 0x00746A0E);
_tn_be32_w(&traffic_secret + 28, 0x27A55A21);

var write_key[16];
var rk = tls_native_derive_key(&traffic_secret, 32, TLS_HASH_SHA256, &write_key, 16);
assert_eq(rk, TLS_OK, "derive_key OK");
assert_eq(load8(&write_key),      0xDB, "key[0] = 0xDB");
assert_eq(load8(&write_key + 1),  0xFA, "key[1] = 0xFA");
assert_eq(load8(&write_key + 8),  0x66, "key[8] = 0x66");
assert_eq(load8(&write_key + 15), 0x01, "key[15] = 0x01");

var write_iv[12];
var ri = tls_native_derive_iv(&traffic_secret, 32, TLS_HASH_SHA256, &write_iv, 12);
assert_eq(ri, TLS_OK, "derive_iv OK");
assert_eq(load8(&write_iv),      0x5B, "iv[0] = 0x5B");
assert_eq(load8(&write_iv + 1),  0xD3, "iv[1] = 0xD3");
assert_eq(load8(&write_iv + 11), 0x5F, "iv[11] = 0x5F");

test_group("v6.0.13 key schedule — state machine + invalid args");

# Invalid algo at new
assert_eq(tls_native_keysched_new(99), 0, "keysched_new rejects invalid algo");

# Get secret before its phase is reached
var fresh = tls_native_keysched_new(TLS_HASH_SHA256);
var tmp[32];
assert_eq(tls_native_keysched_get_secret(fresh, TLS_KS_HANDSHAKE, &tmp),
          TLS_ERR_PROTOCOL, "get_secret HANDSHAKE before derivation = PROTOCOL err");
assert_eq(tls_native_keysched_get_secret(fresh, TLS_KS_MASTER, &tmp),
          TLS_ERR_PROTOCOL, "get_secret MASTER before derivation = PROTOCOL err");

# derive_master before derive_handshake = state error
var transcript = tls_native_transcript_init(TLS_HASH_SHA256);
assert_eq(tls_native_keysched_derive_master(fresh, transcript), TLS_ERR_PROTOCOL,
          "derive_master before derive_handshake = PROTOCOL err");

# HKDF-Expand-Label arg validation
var bogus_secret[32];
var out_short[8];
assert_eq(tls_native_hkdf_expand_label(&bogus_secret, 32, "x", 1, 0, 0,
                                       TLS_HASH_SHA256, &out_short, 0 - 1),
          TLS_ERR_INVALID_PARAM, "hkdf_expand_label rejects negative out_len");
# Label too long: 6 + 250 > 255
var big_label[256];
assert_eq(tls_native_hkdf_expand_label(&bogus_secret, 32, &big_label, 250, 0, 0,
                                       TLS_HASH_SHA256, &out_short, 8),
          TLS_ERR_INVALID_PARAM, "hkdf_expand_label rejects label_len + 6 > 255");

test_group("v6.0.14 ciphersuite registry");

# Hash algo per RFC 8446 §B.4
assert_eq(tls_native_cipher_hash_algo(TLS_AES_128_GCM_SHA256),       TLS_HASH_SHA256, "AES-128-GCM uses SHA-256");
assert_eq(tls_native_cipher_hash_algo(TLS_AES_256_GCM_SHA384),       TLS_HASH_SHA384, "AES-256-GCM uses SHA-384");
assert_eq(tls_native_cipher_hash_algo(TLS_CHACHA20_POLY1305_SHA256), TLS_HASH_SHA256, "ChaCha20-Poly1305 uses SHA-256");
assert_eq(tls_native_cipher_hash_algo(0x9999), 0 - 1, "unknown cipher → -1");

# Key length
assert_eq(tls_native_cipher_key_len(TLS_AES_128_GCM_SHA256),       16, "AES-128 key = 16 B");
assert_eq(tls_native_cipher_key_len(TLS_AES_256_GCM_SHA384),       32, "AES-256 key = 32 B");
assert_eq(tls_native_cipher_key_len(TLS_CHACHA20_POLY1305_SHA256), 32, "ChaCha20 key = 32 B");

# IV + tag always 12/16 for all TLS 1.3 AEADs
assert_eq(tls_native_cipher_iv_len(TLS_AES_256_GCM_SHA384),       12, "AES-256 IV = 12 B");
assert_eq(tls_native_cipher_iv_len(TLS_CHACHA20_POLY1305_SHA256), 12, "ChaCha20 IV = 12 B");
assert_eq(tls_native_cipher_tag_len(TLS_AES_256_GCM_SHA384),       16, "AES-256 tag = 16 B");
assert_eq(tls_native_cipher_tag_len(TLS_CHACHA20_POLY1305_SHA256), 16, "ChaCha20 tag = 16 B");

# Capability — AES-128 NOT supported until sigil ships it (see audit issue)
assert_eq(tls_native_cipher_supported(TLS_AES_128_GCM_SHA256),       0, "AES-128 NOT supported (sigil gap)");
assert_eq(tls_native_cipher_supported(TLS_AES_256_GCM_SHA384),       1, "AES-256 supported");
assert_eq(tls_native_cipher_supported(TLS_CHACHA20_POLY1305_SHA256), 1, "ChaCha20-Poly1305 supported");
assert_eq(tls_native_cipher_supported(0x9999), 0, "unknown cipher not supported");

test_group("v6.0.14 ciphersuite selection");

# Client offers all three; server prefers AES-256, ChaCha20, AES-128.
# Server's preference order picks the first one we support that's
# in client's offer list.
var client_offers[6];
_tn_be16_w(&client_offers,     TLS_AES_128_GCM_SHA256);
_tn_be16_w(&client_offers + 2, TLS_AES_256_GCM_SHA384);
_tn_be16_w(&client_offers + 4, TLS_CHACHA20_POLY1305_SHA256);

var server_prefs_aes_first[6];
_tn_be16_w(&server_prefs_aes_first,     TLS_AES_256_GCM_SHA384);
_tn_be16_w(&server_prefs_aes_first + 2, TLS_CHACHA20_POLY1305_SHA256);
_tn_be16_w(&server_prefs_aes_first + 4, TLS_AES_128_GCM_SHA256);
assert_eq(tls_native_cipher_select(&client_offers, 3, &server_prefs_aes_first, 3),
          TLS_AES_256_GCM_SHA384, "server-prefers-AES → picks AES-256");

# Flip preferences: ChaCha20 first
var server_prefs_chacha[6];
_tn_be16_w(&server_prefs_chacha,     TLS_CHACHA20_POLY1305_SHA256);
_tn_be16_w(&server_prefs_chacha + 2, TLS_AES_256_GCM_SHA384);
_tn_be16_w(&server_prefs_chacha + 4, TLS_AES_128_GCM_SHA256);
assert_eq(tls_native_cipher_select(&client_offers, 3, &server_prefs_chacha, 3),
          TLS_CHACHA20_POLY1305_SHA256, "server-prefers-ChaCha → picks ChaCha20");

# Server prefers ONLY AES-128 (unsupported by us); client offers
# all three. Selection skips AES-128 (not supported), so... no match.
var server_only_aes128[2];
_tn_be16_w(&server_only_aes128, TLS_AES_128_GCM_SHA256);
assert_eq(tls_native_cipher_select(&client_offers, 3, &server_only_aes128, 1),
          0, "server-prefers-only-AES-128 (unsupported) → no match");

# Client offers AES-128 only; server prefers AES-256 first then
# ChaCha20. No overlap → 0.
var client_aes128_only[2];
_tn_be16_w(&client_aes128_only, TLS_AES_128_GCM_SHA256);
assert_eq(tls_native_cipher_select(&client_aes128_only, 1, &server_prefs_aes_first, 3),
          0, "client offers AES-128 only → no match (we don't support)");

test_group("v6.0.14 AEAD encrypt/decrypt round-trip");

# AES-256-GCM round-trip — verify ciphertext + tag round-trip
# back to original plaintext. Inputs:
#   key  = 32 bytes (0x40 0x41 .. 0x5F)
#   iv   = 12 bytes (0xA0 0xA1 .. 0xAB)
#   aad  = 5-byte record header (TLS 1.3 §5.2)
#   pt   = "Hello, TLS!"
var key256[32];
var ki = 0;
while (ki < 32) { store8(&key256 + ki, 0x40 + ki); ki = ki + 1; }
var iv[12];
var ivi = 0;
while (ivi < 12) { store8(&iv + ivi, 0xA0 + ivi); ivi = ivi + 1; }
var aad[5];
tls_native_record_aad(TLS_CT_APPLICATION_DATA, 0x0303, 27, &aad);  # 11 pt + 16 tag = 27
var plaintext[11];
store8(&plaintext +  0, 72);   # 'H'
store8(&plaintext +  1, 101);  # 'e'
store8(&plaintext +  2, 108);  # 'l'
store8(&plaintext +  3, 108);  # 'l'
store8(&plaintext +  4, 111);  # 'o'
store8(&plaintext +  5, 44);   # ','
store8(&plaintext +  6, 32);   # ' '
store8(&plaintext +  7, 84);   # 'T'
store8(&plaintext +  8, 76);   # 'L'
store8(&plaintext +  9, 83);   # 'S'
store8(&plaintext + 10, 33);   # '!'

var ct_aes[11];
var tag_aes[16];
var rc_enc_aes = tls_native_aead_encrypt(TLS_AES_256_GCM_SHA384,
                                         &key256, &iv, &aad, 5,
                                         &plaintext, 11, &ct_aes, &tag_aes);
assert_eq(rc_enc_aes, TLS_OK, "AES-256-GCM encrypt OK");

var pt_dec_aes[11];
var rc_dec_aes = tls_native_aead_decrypt(TLS_AES_256_GCM_SHA384,
                                         &key256, &iv, &aad, 5,
                                         &ct_aes, 11, &tag_aes, &pt_dec_aes);
assert_eq(rc_dec_aes, TLS_OK, "AES-256-GCM decrypt OK");
assert_eq(load8(&pt_dec_aes),      72,  "AES decrypted byte 0 = 'H'");
assert_eq(load8(&pt_dec_aes + 7),  84,  "AES decrypted byte 7 = 'T'");
assert_eq(load8(&pt_dec_aes + 10), 33,  "AES decrypted byte 10 = '!'");

# Tag tamper → TLS_ERR_DECRYPT (flip the last byte of the tag).
store8(&tag_aes + 15, load8(&tag_aes + 15) ^ 1);
var pt_dec_bad[11];
assert_eq(tls_native_aead_decrypt(TLS_AES_256_GCM_SHA384,
                                  &key256, &iv, &aad, 5,
                                  &ct_aes, 11, &tag_aes, &pt_dec_bad),
          TLS_ERR_DECRYPT, "AES-256-GCM tamper detected");

# ChaCha20-Poly1305 round-trip — same shape, same key+iv+aad.
var ct_cc[11];
var tag_cc[16];
var rc_enc_cc = tls_native_aead_encrypt(TLS_CHACHA20_POLY1305_SHA256,
                                        &key256, &iv, &aad, 5,
                                        &plaintext, 11, &ct_cc, &tag_cc);
assert_eq(rc_enc_cc, TLS_OK, "ChaCha20-Poly1305 encrypt OK");

var pt_dec_cc[11];
var rc_dec_cc = tls_native_aead_decrypt(TLS_CHACHA20_POLY1305_SHA256,
                                        &key256, &iv, &aad, 5,
                                        &ct_cc, 11, &tag_cc, &pt_dec_cc);
assert_eq(rc_dec_cc, TLS_OK, "ChaCha20-Poly1305 decrypt OK");
assert_eq(load8(&pt_dec_cc),      72, "ChaCha decrypted byte 0 = 'H'");
assert_eq(load8(&pt_dec_cc + 10), 33, "ChaCha decrypted byte 10 = '!'");

# AES-128 (unsupported) → TLS_ERR_CIPHER_NOT_SUPPORTED
var ct_128[11];
var tag_128[16];
assert_eq(tls_native_aead_encrypt(TLS_AES_128_GCM_SHA256,
                                  &key256, &iv, &aad, 5,
                                  &plaintext, 11, &ct_128, &tag_128),
          TLS_ERR_CIPHER_NOT_SUPPORTED, "AES-128 encrypt → CIPHER_NOT_SUPPORTED");

# ================================================================
# v6.0.15 — server connection ctx + handshake state machine
# ================================================================
test_group("v6.0.15 server ctx + state machine");

# Dummy DER refs — .15 stores them opaque, doesn't parse (that's .16).
var dummy_cert[8];
var dummy_key[8];

var sctx = tls_native_new_server(&dummy_cert, 8, &dummy_key, 8);
assert_nonnull(sctx, "new_server returns a ctx handle");
assert_eq(tls_native_get_state(sctx), TLS_STATE_INIT, "fresh server ctx in INIT");
assert_eq(tls_native_get_cipher(sctx), 0, "no cipher negotiated yet");
assert_eq(tls_native_get_version(sctx), 0, "no version negotiated yet");
assert_eq(tls_native_get_last_error(sctx), TLS_OK, "no error recorded yet");

# Happy path, no client auth: INIT→WAIT_CH→WAIT_FINISHED→CONNECTED.
assert_eq(tls_native_server_transition(sctx, TLS_EV_START), TLS_OK, "START accepted");
assert_eq(tls_native_get_state(sctx), TLS_STATE_WAIT_CH, "→ WAIT_CH");
assert_eq(tls_native_server_transition(sctx, TLS_EV_RECV_CH), TLS_OK, "RECV_CH accepted");
assert_eq(tls_native_get_state(sctx), TLS_STATE_WAIT_FINISHED, "→ WAIT_FINISHED (no client auth)");
assert_eq(tls_native_server_transition(sctx, TLS_EV_RECV_FINISHED), TLS_OK, "RECV_FINISHED accepted");
assert_eq(tls_native_get_state(sctx), TLS_STATE_CONNECTED, "→ CONNECTED");

# Client-auth path: verify mode flips RECV_CH into WAIT_CLIENT_FLIGHT2.
var actx = tls_native_new_server(&dummy_cert, 8, &dummy_key, 8);
assert_nonnull(actx, "second server ctx");
assert_eq(tls_native_set_verify(actx, TLS_VERIFY_PEER), TLS_OK, "set_verify PEER OK");
assert_eq(tls_native_server_transition(actx, TLS_EV_START), TLS_OK, "START");
assert_eq(tls_native_server_transition(actx, TLS_EV_RECV_CH), TLS_OK, "RECV_CH");
assert_eq(tls_native_get_state(actx), TLS_STATE_WAIT_CLIENT_FLIGHT2, "→ WAIT_CLIENT_FLIGHT2 (client auth)");
assert_eq(tls_native_server_transition(actx, TLS_EV_RECV_CERT), TLS_OK, "client Cert accepted");
assert_eq(tls_native_server_transition(actx, TLS_EV_RECV_CV), TLS_OK, "client CertVerify accepted");
assert_eq(tls_native_server_transition(actx, TLS_EV_RECV_FINISHED), TLS_OK, "client Finished accepted");
assert_eq(tls_native_get_state(actx), TLS_STATE_CONNECTED, "→ CONNECTED (client auth)");

# Illegal: RECV_FINISHED while WAIT_CH → PROTOCOL + ERROR state.
var bctx = tls_native_new_server(&dummy_cert, 8, &dummy_key, 8);
assert_eq(tls_native_server_transition(bctx, TLS_EV_START), TLS_OK, "START");
assert_eq(tls_native_server_transition(bctx, TLS_EV_RECV_FINISHED), TLS_ERR_PROTOCOL, "Finished in WAIT_CH → PROTOCOL");
assert_eq(tls_native_get_state(bctx), TLS_STATE_ERROR, "illegal transition → ERROR state");
assert_eq(tls_native_get_last_error(bctx), TLS_ERR_PROTOCOL, "last_error records PROTOCOL");

# Double START illegal: START in WAIT_CH → PROTOCOL.
var cctx = tls_native_new_server(&dummy_cert, 8, &dummy_key, 8);
assert_eq(tls_native_server_transition(cctx, TLS_EV_START), TLS_OK, "START");
assert_eq(tls_native_server_transition(cctx, TLS_EV_START), TLS_ERR_PROTOCOL, "double START → PROTOCOL");

# RECV_CERT outside the client-auth flight illegal.
var dctx = tls_native_new_server(&dummy_cert, 8, &dummy_key, 8);
tls_native_server_transition(dctx, TLS_EV_START);
tls_native_server_transition(dctx, TLS_EV_RECV_CH);   # → WAIT_FINISHED (no auth)
assert_eq(tls_native_server_transition(dctx, TLS_EV_RECV_CERT), TLS_ERR_PROTOCOL, "Cert without client-auth → PROTOCOL");

# Null ctx guard on the transition driver.
assert_eq(tls_native_server_transition(0, TLS_EV_START), TLS_ERR_INVALID_PARAM, "null ctx → INVALID_PARAM");

# ================================================================
# v6.0.16 — server credential loading (cert + key via sigil 3.5.9)
# ================================================================
test_group("v6.0.16 server cred loading");

# Real vectors reused from sigil's privkey + x509 test suites.
# P-256 leaf cert DER (413 B); Ed25519 PKCS#8 DER (48 B); P-256
# PKCS#8 DER (138 B).
var leaf_cert = hex_decode("", 826);
var ed_key = hex_decode("302e020100300506032b657004220420399843cd6b8ea5ba0309fe5b38fe4dd271ee65f20f39a48efc7d7503c0775f12", 96);
var p256_key = hex_decode("308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b020101042057f0ea4e28fdc366606bbe091d7bba5d96f953ce0a16d9127676021989b4f3bca14403420004a065ea9bf5dbfec0421c2d494efa12a696c1bc3fcbb222d5cf118caeaaaaaf9b95f556a870683712899ddda5a65150e14f6f8544003e204cb2e6a0fc8a322db9", 276);

# Ed25519 private key (DER) + P-256 leaf cert → load OK, algo detected.
var s_ed = tls_native_new_server(leaf_cert, 413, ed_key, 48);
assert_nonnull(s_ed, "new_server (ed25519 key + p256 cert)");
assert_eq(tls_native_server_load_creds(s_ed), TLS_OK, "load_creds ed25519 OK");
assert_eq(tls_native_get_key_algo(s_ed), SIG_PRIVKEY_ED25519, "key algo detected = Ed25519");
assert_eq(tls_native_get_state(s_ed), TLS_STATE_INIT, "ctx still INIT after successful load");

# P-256 private key (DER) + same cert → algo P-256.
var s_p256 = tls_native_new_server(leaf_cert, 413, p256_key, 138);
assert_eq(tls_native_server_load_creds(s_p256), TLS_OK, "load_creds p256 OK");
assert_eq(tls_native_get_key_algo(s_p256), SIG_PRIVKEY_ECDSA_P256, "key algo detected = ECDSA P-256");

# PEM key path (0x2D dispatch → sigil pem_decode_privkey) — Ed25519.
var ed_pem = "-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIEIDmYQ81rjqW6Awn+Wzj+TdJx7mXyDzmkjvx9dQPAd18S\n-----END PRIVATE KEY-----\n";
var s_pem = tls_native_new_server(leaf_cert, 413, ed_pem, strlen(ed_pem));
assert_eq(tls_native_server_load_creds(s_pem), TLS_OK, "load_creds PEM ed25519 OK");
assert_eq(tls_native_get_key_algo(s_pem), SIG_PRIVKEY_ED25519, "PEM key algo = Ed25519");

# Negative: garbage DER key (0x30 lead, invalid body) → KEY_UNSUPPORTED + ERROR.
var bad_key = hex_decode("3005020100ff", 12);
var s_bad = tls_native_new_server(leaf_cert, 413, bad_key, 6);
assert_eq(tls_native_server_load_creds(s_bad), TLS_ERR_KEY_UNSUPPORTED, "garbage key → KEY_UNSUPPORTED");
assert_eq(tls_native_get_state(s_bad), TLS_STATE_ERROR, "bad creds → ctx ERROR");
assert_eq(tls_native_get_last_error(s_bad), TLS_ERR_KEY_UNSUPPORTED, "last_error = KEY_UNSUPPORTED");

# Negative: good key, unparseable cert → CERT_INVALID (key parsed first).
var s_badcert = tls_native_new_server(bad_key, 6, ed_key, 48);
assert_eq(tls_native_server_load_creds(s_badcert), TLS_ERR_CERT_INVALID, "bad cert → CERT_INVALID");

# Null-ctx guards.
assert_eq(tls_native_server_load_creds(0), TLS_ERR_INVALID_PARAM, "load_creds(null) → INVALID_PARAM");
assert_eq(tls_native_get_key_algo(0), SIG_PRIVKEY_UNKNOWN, "get_key_algo(null) → UNKNOWN");

# ================================================================
# v6.0.17 — ServerHello + key_share response (x25519 ECDHE)
# ================================================================
test_group("v6.0.17 ServerHello + key_share");

# Reuse the .16 leaf cert + Ed25519 key for new_server.
# --- Happy path: client offers an x25519 key_share ---
var cpriv[32];
sys_getrandom(&cpriv, 32, 0);
var cpub[32];
x25519_base(&cpriv, &cpub);

var ch[256];
var bp = &ch + 4;
_tn_be16_w(bp, 0x0303);                              # legacy_version
var q = bp + 2;
var i = 0;
while (i < 32) { store8(q + i, 0x41); i = i + 1; }   # client random (dummy)
q = q + 32;
store8(q, 0); q = q + 1;                             # session id len 0
_tn_be16_w(q, 4); q = q + 2;                         # cipher_suites len
_tn_be16_w(q, TLS_AES_256_GCM_SHA384); q = q + 2;
_tn_be16_w(q, TLS_CHACHA20_POLY1305_SHA256); q = q + 2;
store8(q, 1); q = q + 1; store8(q, 0); q = q + 1;    # compression: null
_tn_be16_w(q, 42); q = q + 2;                        # extensions length
_tn_be16_w(q, TLS_EXT_KEY_SHARE); q = q + 2;
_tn_be16_w(q, 38); q = q + 2;                        # ext_data len
_tn_be16_w(q, 36); q = q + 2;                        # client_shares len
_tn_be16_w(q, TLS_GROUP_X25519); q = q + 2;
_tn_be16_w(q, 32); q = q + 2;                        # key_exchange len
memcpy(q, &cpub, 32); q = q + 32;
var body_len = q - bp;
tls_native_handshake_write_header(&ch, TLS_HS_CLIENT_HELLO, body_len);
var ch_total = 4 + body_len;

var s_ch = tls_native_new_server(leaf_cert, 413, ed_key, 48);
var sh[256];
var shn = tls_native_server_respond_hello(s_ch, &ch, ch_total, &sh, 256);
assert_gt(shn, 0, "respond_hello → ServerHello length > 0");
assert_eq(tls_native_server_sent_hrr(s_ch), 0, "ServerHello (not HRR)");
assert_eq(tls_native_get_cipher(s_ch), TLS_AES_256_GCM_SHA384, "negotiated AES-256-GCM-SHA384");
assert_eq(tls_native_get_group(s_ch), TLS_GROUP_X25519, "negotiated group x25519");

# Response is a ServerHello handshake message.
var sht = 0; var shb = 0;
tls_native_handshake_read_header(&sh, shn, &sht, &shb);
assert_eq(sht, TLS_HS_SERVER_HELLO, "response msg type = ServerHello");

# ECDHE agreement: client derives the same secret from server_pub
# (last 32 bytes of the SH, key_share is the final extension).
var srvpub = &sh + shn - 32;
var cdhe[32];
x25519(&cpriv, srvpub, &cdhe);
var sdhe = load64(s_ch + TLS_CTX_OFF_SHARED);
assert_streq(hex_encode(&cdhe, 32), hex_encode(sdhe, 32), "ECDHE shared-secret agreement");

# --- HelloRetryRequest: empty key_share + supported_groups[x25519] ---
var ch2[128];
var bp2 = &ch2 + 4;
_tn_be16_w(bp2, 0x0303);
var r2 = bp2 + 2;
var k = 0;
while (k < 32) { store8(r2 + k, 0x42); k = k + 1; }
r2 = r2 + 32;
store8(r2, 0); r2 = r2 + 1;                          # session id len 0
_tn_be16_w(r2, 4); r2 = r2 + 2;                      # cipher_suites len
_tn_be16_w(r2, TLS_AES_256_GCM_SHA384); r2 = r2 + 2;
_tn_be16_w(r2, TLS_CHACHA20_POLY1305_SHA256); r2 = r2 + 2;
store8(r2, 1); r2 = r2 + 1; store8(r2, 0); r2 = r2 + 1;
_tn_be16_w(r2, 14); r2 = r2 + 2;                     # extensions length
_tn_be16_w(r2, TLS_EXT_KEY_SHARE); r2 = r2 + 2;
_tn_be16_w(r2, 2); r2 = r2 + 2;                      # ext_data len
_tn_be16_w(r2, 0); r2 = r2 + 2;                      # client_shares len 0 (empty)
_tn_be16_w(r2, TLS_EXT_SUPPORTED_GROUPS); r2 = r2 + 2;
_tn_be16_w(r2, 4); r2 = r2 + 2;                      # ext_data len
_tn_be16_w(r2, 2); r2 = r2 + 2;                      # group list len
_tn_be16_w(r2, TLS_GROUP_X25519); r2 = r2 + 2;
var body2 = r2 - bp2;
tls_native_handshake_write_header(&ch2, TLS_HS_CLIENT_HELLO, body2);

var s_hrr = tls_native_new_server(leaf_cert, 413, ed_key, 48);
var sh2[128];
var hrrn = tls_native_server_respond_hello(s_hrr, &ch2, 4 + body2, &sh2, 128);
assert_gt(hrrn, 0, "HRR length > 0");
assert_eq(tls_native_server_sent_hrr(s_hrr), 1, "sent HelloRetryRequest");
assert_streq(hex_encode(&sh2 + 6, 32), "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c", "HRR random = SHA256(HelloRetryRequest)");

# --- Negatives ---
assert_eq(tls_native_server_respond_hello(0, &ch, ch_total, &sh, 256), TLS_ERR_INVALID_PARAM, "respond_hello(null) → INVALID_PARAM");
var s_wt = tls_native_new_server(leaf_cert, 413, ed_key, 48);
var badch[8];
tls_native_handshake_write_header(&badch, TLS_HS_SERVER_HELLO, 100);
assert_eq(tls_native_server_respond_hello(s_wt, &badch, 8, &sh, 256), TLS_ERR_BAD_HANDSHAKE, "non-ClientHello → BAD_HANDSHAKE");
assert_eq(tls_native_get_state(s_wt), TLS_STATE_ERROR, "bad input → ctx ERROR");

# ================================================================
# v6.0.18 — server flight 2 (EE / Certificate / CertVerify / Finished)
# ================================================================
test_group("v6.0.18 server flight 2");

# Ed25519 key (so CertificateVerify is Ed25519) + the P-256 leaf cert
# (carried in the Certificate message). Reuses the .17 happy-path
# ClientHello (ch / ch_total / cpriv).
var s18 = tls_native_new_server(leaf_cert, 413, ed_key, 48);
assert_eq(tls_native_server_load_creds(s18), TLS_OK, "load creds (Ed25519 key)");
assert_eq(tls_native_get_key_algo(s18), SIG_PRIVKEY_ED25519, "signing key = Ed25519");
var sh18[256];
var shn18 = tls_native_server_respond_hello(s18, &ch, ch_total, &sh18, 256);
assert_gt(shn18, 0, "ServerHello built");
assert_eq(tls_native_get_cipher(s18), TLS_AES_256_GCM_SHA384, "cipher AES-256-GCM-SHA384 (SHA-384)");

var flight[2048];
var fl = tls_native_server_build_flight(s18, &flight, 2048);
assert_gt(fl, 0, "flight built");
assert_eq(tls_native_get_state(s18), TLS_STATE_INIT, "ctx not in ERROR after flight");

# Walk the flight: EE, Certificate, CertificateVerify, Finished.
var ha = tls_native_cipher_hash_algo(tls_native_get_cipher(s18));   # SHA-384
var hl = 48;
var et = 0; var el = 0;
tls_native_handshake_read_header(&flight, fl, &et, &el);
assert_eq(et, TLS_HS_ENCRYPTED_EXTENSIONS, "msg1 = EncryptedExtensions");
var ee_total = 4 + el;
var cert_off = ee_total;
tls_native_handshake_read_header(&flight + cert_off, fl - cert_off, &et, &el);
assert_eq(et, TLS_HS_CERTIFICATE, "msg2 = Certificate");
var cert_total = 4 + el;
# Certificate carries the leaf DER: context(1)=0, list_len(3), cert_len(3)=413.
assert_eq(load8(&flight + cert_off + 4), 0, "cert request context empty");
assert_eq(_tn_be24_r(&flight + cert_off + 4 + 1 + 3), 413, "cert_data length = 413");
var cv_off = cert_off + cert_total;
tls_native_handshake_read_header(&flight + cv_off, fl - cv_off, &et, &el);
assert_eq(et, TLS_HS_CERTIFICATE_VERIFY, "msg3 = CertificateVerify");
var cv_total = 4 + el;
assert_eq(_tn_be16_r(&flight + cv_off + 4), TLS_SIG_ED25519, "CV scheme = Ed25519");
var fin_off = cv_off + cv_total;
tls_native_handshake_read_header(&flight + fin_off, fl - fin_off, &et, &el);
assert_eq(et, TLS_HS_FINISHED, "msg4 = Finished");
assert_eq(el, hl, "Finished verify_data length = 48");

# --- CertificateVerify signature is valid over CH..Certificate. ---
var tr = tls_native_transcript_init(ha);
tls_native_transcript_update(tr, &ch, ch_total);
tls_native_transcript_update(tr, &sh18, shn18);
tls_native_transcript_update(tr, &flight, ee_total);
tls_native_transcript_update(tr, &flight + cert_off, cert_total);
var th18[48];
tls_native_transcript_digest(tr, &th18);
var content[146];
var ci = 0;
while (ci < 64) { store8(&content + ci, 0x20); ci = ci + 1; }
memcpy(&content + 64, "TLS 1.3, server CertificateVerify", 33);
store8(&content + 97, 0);
memcpy(&content + 98, &th18, 48);
# Ed25519 pubkey from the parsed seed (same KEY_MAT the server signed with).
var seed18 = load64(s18 + TLS_CTX_OFF_KEY_MAT);
var sk18[64]; var pk18[32];
ed25519_keypair(seed18, &sk18, &pk18);
var cv_sig = &flight + cv_off + 4 + 4;   # skip hdr(4) + scheme(2) + siglen(2)
assert_eq(ed25519_verify(&pk18, &content, 146, cv_sig), 1, "CertificateVerify signature verifies");

# --- Finished verify_data matches an independent recomputation. ---
var ks18 = load64(s18 + TLS_CTX_OFF_KEYSCHED);
var shs18[48];
tls_native_keysched_get_secret(ks18, TLS_KS_SERVER_HANDSHAKE, &shs18);
var fk18[48];
tls_native_hkdf_expand_label(&shs18, hl, "finished", 8, 0, 0, ha, &fk18, hl);
tls_native_transcript_update(tr, &flight + cv_off, cv_total);   # extend to CH..CV
var thcv[48];
tls_native_transcript_digest(tr, &thcv);
var vd18[48];
hmac_sha384(&fk18, hl, &thcv, hl, &vd18);
assert_streq(hex_encode(&vd18, 48), hex_encode(&flight + fin_off + 4, 48), "Finished verify_data matches");

# Null / role guards.
assert_eq(tls_native_server_build_flight(0, &flight, 2048), TLS_ERR_INVALID_PARAM, "build_flight(null) → INVALID_PARAM");

# ================================================================
# v6.0.19 — optional client authentication
# ================================================================
test_group("v6.0.19 client auth");

# --- CertificateRequest emission gated on verify mode. ---
# No client auth (verify NONE): flight is EE, Certificate, ...
var sN = tls_native_new_server(leaf_cert, 413, ed_key, 48);
tls_native_server_load_creds(sN);
var shN[256];
tls_native_server_respond_hello(sN, &ch, ch_total, &shN, 256);
var fN[2048];
var flN = tls_native_server_build_flight(sN, &fN, 2048);
var t = 0; var l = 0;
tls_native_handshake_read_header(&fN, flN, &t, &l);
assert_eq(t, TLS_HS_ENCRYPTED_EXTENSIONS, "no-auth flight msg1 = EE");
var offN = 4 + l;
tls_native_handshake_read_header(&fN + offN, flN - offN, &t, &l);
assert_eq(t, TLS_HS_CERTIFICATE, "no-auth flight msg2 = Certificate (no CertReq)");

# Client auth requested (verify PEER): CertificateRequest after EE.
var sP = tls_native_new_server(leaf_cert, 413, ed_key, 48);
tls_native_server_load_creds(sP);
tls_native_set_verify(sP, TLS_VERIFY_PEER);
var shP[256];
tls_native_server_respond_hello(sP, &ch, ch_total, &shP, 256);
var fP[2048];
var flP = tls_native_server_build_flight(sP, &fP, 2048);
tls_native_handshake_read_header(&fP, flP, &t, &l);
assert_eq(t, TLS_HS_ENCRYPTED_EXTENSIONS, "auth flight msg1 = EE");
var offP = 4 + l;
tls_native_handshake_read_header(&fP + offP, flP - offP, &t, &l);
assert_eq(t, TLS_HS_CERTIFICATE_REQUEST, "auth flight msg2 = CertificateRequest");

# --- Client Finished verification → CONNECTED (no-auth path). ---
tls_native_server_transition(sN, TLS_EV_START);
tls_native_server_transition(sN, TLS_EV_RECV_CH);
assert_eq(tls_native_get_state(sN), TLS_STATE_WAIT_FINISHED, "no-auth → WAIT_FINISHED");
var haN = tls_native_cipher_hash_algo(tls_native_get_cipher(sN));
var hlN = 48;
var ksN = load64(sN + TLS_CTX_OFF_KEYSCHED);
var tsN = load64(sN + TLS_CTX_OFF_TRANSCRIPT);
var chsN[48];
tls_native_keysched_get_secret(ksN, TLS_KS_CLIENT_HANDSHAKE, &chsN);
var fkN[48];
tls_native_hkdf_expand_label(&chsN, hlN, "finished", 8, 0, 0, haN, &fkN, hlN);
var thN[48];
tls_native_transcript_digest(tsN, &thN);
var vdN[48];
hmac_sha384(&fkN, hlN, &thN, hlN, &vdN);
var finN[64];
tls_native_handshake_write_header(&finN, TLS_HS_FINISHED, hlN);
memcpy(&finN + 4, &vdN, hlN);
assert_eq(tls_native_server_recv_client_finished(sN, &finN, 4 + hlN), TLS_OK, "client Finished verifies");
assert_eq(tls_native_get_state(sN), TLS_STATE_CONNECTED, "no-auth handshake → CONNECTED");

# A wrong client Finished is rejected (fresh server).
var sW = tls_native_new_server(leaf_cert, 413, ed_key, 48);
tls_native_server_load_creds(sW);
var shW[256];
tls_native_server_respond_hello(sW, &ch, ch_total, &shW, 256);
var fW[2048];
tls_native_server_build_flight(sW, &fW, 2048);
tls_native_server_transition(sW, TLS_EV_START);
tls_native_server_transition(sW, TLS_EV_RECV_CH);
var finW[64];
tls_native_handshake_write_header(&finW, TLS_HS_FINISHED, hlN);
var z = 0;
while (z < hlN) { store8(&finW + 4 + z, 0x00); z = z + 1; }   # wrong verify_data
assert_eq(tls_native_server_recv_client_finished(sW, &finW, 4 + hlN), TLS_ERR_AUTHN, "wrong client Finished → AUTHN");

# --- Client Certificate parse + CertVerify negative (auth path). ---
tls_native_server_transition(sP, TLS_EV_START);
tls_native_server_transition(sP, TLS_EV_RECV_CH);
assert_eq(tls_native_get_state(sP), TLS_STATE_WAIT_CLIENT_FLIGHT2, "auth → WAIT_CLIENT_FLIGHT2");
var ccert[512];
var cbody = &ccert + 4;
store8(cbody, 0);                                   # certificate_request_context<0>
var c_entry_len = 3 + 413 + 2;
_tn_be24_w(cbody + 1, c_entry_len);                 # certificate_list length
_tn_be24_w(cbody + 4, 413);                         # cert_data length
memcpy(cbody + 7, leaf_cert, 413);
_tn_be16_w(cbody + 7 + 413, 0);                     # entry extensions<0>
var cbody_len = 1 + 3 + c_entry_len;
tls_native_handshake_write_header(&ccert, TLS_HS_CERTIFICATE, cbody_len);
assert_eq(tls_native_server_recv_client_certificate(sP, &ccert, 4 + cbody_len), TLS_OK, "client Certificate parsed");
assert_eq(tls_native_get_state(sP), TLS_STATE_WAIT_CLIENT_FLIGHT2, "stays WAIT_CLIENT_FLIGHT2 after Cert");

var ccv[128];
var cvbody = &ccv + 4;
_tn_be16_w(cvbody, TLS_SIG_ECDSA_SECP256R1_SHA256); # scheme matching the P-256 leaf
_tn_be16_w(cvbody + 2, 64);                          # sig length
var g = 0;
while (g < 64) { store8(cvbody + 4 + g, 0xAA); g = g + 1; }   # garbage signature
tls_native_handshake_write_header(&ccv, TLS_HS_CERTIFICATE_VERIFY, 4 + 64);
assert_eq(tls_native_server_recv_client_certverify(sP, &ccv, 4 + 4 + 64), TLS_ERR_AUTHN, "garbage client CertVerify → AUTHN");
assert_eq(tls_native_get_state(sP), TLS_STATE_ERROR, "bad client CV → ctx ERROR");

# Null guards.
assert_eq(tls_native_server_recv_client_finished(0, &finN, 4 + hlN), TLS_ERR_INVALID_PARAM, "recv_client_finished(null)");

# ================================================================
# v6.0.20 — session ticket / PSK resumption
# ================================================================
test_group("v6.0.20 session ticket / PSK resumption");

# sN reached CONNECTED in the .19 no-auth path (transcript CH..clientFin,
# keysched at HANDSHAKE) — new_session_ticket auto-derives the master.
var nst[512];
var nstn = tls_native_server_new_session_ticket(sN, &nst, 512);
assert_gt(nstn, 0, "NewSessionTicket issued");
var nt = 0; var nl = 0;
tls_native_handshake_read_header(&nst, nstn, &nt, &nl);
assert_eq(nt, TLS_HS_NEW_SESSION_TICKET, "msg type = NewSessionTicket");

# Parse body: lifetime(4) age_add(4) nonce_len(1) nonce(8) ticket_len(2) ticket ext(2)
var nbody = &nst + 4;
assert_eq(load8(nbody + 8), 8, "ticket_nonce length = 8");
var nonce_p = nbody + 9;
var tklen = _tn_be16_r(nbody + 17);
var tk_p = nbody + 19;
assert_gt(tklen, 28, "ticket blob > AEAD overhead");

# Open the ticket → recovered PSK.
var rec_psk[48];
var rplen = tls_native_server_open_ticket(sN, tk_p, tklen, &rec_psk);
assert_eq(rplen, 48, "ticket opens → 48-byte PSK (SHA-384)");

# Independently derive PSK from resumption_master + nonce; must match.
var ks20 = load64(sN + TLS_CTX_OFF_KEYSCHED);
var rm20[48];
tls_native_keysched_get_secret(ks20, TLS_KS_RESUMPTION_MASTER, &rm20);
var ha20 = tls_native_cipher_hash_algo(tls_native_get_cipher(sN));
var psk20[48];
tls_native_hkdf_expand_label(&rm20, 48, "resumption", 10, nonce_p, 8, ha20, &psk20, 48);
assert_streq(hex_encode(&rec_psk, 48), hex_encode(&psk20, 48), "opened PSK == HKDF-derived PSK");

# PSK binder: deterministic, non-trivial transform of the PSK.
var dummy_th[48];
var di = 0;
while (di < 48) { store8(&dummy_th + di, 0x5A); di = di + 1; }
var bind1[48];
var bind2[48];
assert_eq(tls_native_psk_binder(&psk20, 48, ha20, &dummy_th, 48, &bind1), TLS_OK, "psk_binder OK");
tls_native_psk_binder(&psk20, 48, ha20, &dummy_th, 48, &bind2);
assert_streq(hex_encode(&bind1, 48), hex_encode(&bind2, 48), "psk_binder deterministic");
assert_eq(_tn_ct_eq(&bind1, &psk20, 48), 0, "binder != raw psk (transformed)");

# Tampered ticket → open fails (AEAD tag).
store8(tk_p + 28, load8(tk_p + 28) ^ 0xFF);
assert_eq(tls_native_server_open_ticket(sN, tk_p, tklen, &rec_psk), 0 - 1, "tampered ticket → open fails");

# ================================================================
# v6.0.21 — record-layer protection (AEAD seal/open)
# ================================================================
test_group("v6.0.21 record-layer protection");

# --- Generic seal/open round-trip (explicit key/iv/seq). ---
var rkey[32];
var riv[12];
var ki = 0;
while (ki < 32) { store8(&rkey + ki, ki); ki = ki + 1; }
var vi = 0;
while (vi < 12) { store8(&riv + vi, 0xB0 + vi); vi = vi + 1; }
var seqA[8];
var seqB[8];
tls_native_seq_init(&seqA);
tls_native_seq_init(&seqB);
var msg21 = "handshake-data!";
var rec[128];
var recn = tls_native_record_seal(TLS_AES_256_GCM_SHA384, &rkey, &riv, &seqA, TLS_CT_HANDSHAKE, msg21, 15, &rec, 128);
assert_gt(recn, 0, "record sealed");
assert_eq(load8(&rec) & 0xFF, TLS_CT_APPLICATION_DATA, "outer opaque_type = application_data(23)");
var dec[128];
var dct = 0;
var declen = tls_native_record_open(TLS_AES_256_GCM_SHA384, &rkey, &riv, &seqB, &rec, recn, &dec, 128, &dct);
assert_eq(declen, 15, "opened content length = 15");
assert_eq(dct, TLS_CT_HANDSHAKE, "recovered inner content type = handshake(22)");
assert_eq(_tn_ct_eq(&dec, msg21, 15), 1, "decrypted content matches plaintext");

# Re-opening the same record (seqB now advanced) → wrong nonce → DECRYPT.
var dec2[128];
var dct2 = 0;
assert_eq(tls_native_record_open(TLS_AES_256_GCM_SHA384, &rkey, &riv, &seqB, &rec, recn, &dec2, 128, &dct2), TLS_ERR_DECRYPT, "seq mismatch → DECRYPT");

# Tampered ciphertext (fresh seq) → DECRYPT.
var seqC[8];
tls_native_seq_init(&seqC);
store8(&rec + 6, load8(&rec + 6) ^ 0xFF);
var dec3[128];
var dct3 = 0;
assert_eq(tls_native_record_open(TLS_AES_256_GCM_SHA384, &rkey, &riv, &seqC, &rec, recn, &dec3, 128, &dct3), TLS_ERR_DECRYPT, "tampered record → DECRYPT");

# --- ctx-installed handshake keys + server seal round-trip. ---
var s21 = tls_native_new_server(leaf_cert, 413, ed_key, 48);
tls_native_server_load_creds(s21);
var sh21[256];
tls_native_server_respond_hello(s21, &ch, ch_total, &sh21, 256);
var fl21[2048];
tls_native_server_build_flight(s21, &fl21, 2048);
assert_eq(tls_native_server_install_handshake_keys(s21), TLS_OK, "install handshake keys");
var srec[256];
var srecn = tls_native_server_seal_handshake(s21, msg21, 15, &srec, 256);
assert_gt(srecn, 0, "server sealed a handshake record");
# Open with the server key from the peer's view (fresh read seq).
var skey21 = load64(s21 + TLS_CTX_OFF_SRV_HS_KEY);
var siv21 = load64(s21 + TLS_CTX_OFF_SRV_HS_IV);
var pseq[8];
tls_native_seq_init(&pseq);
var sdec[256];
var sdct = 0;
var sdlen = tls_native_record_open(tls_native_get_cipher(s21), skey21, siv21, &pseq, &srec, srecn, &sdec, 256, &sdct);
assert_eq(sdlen, 15, "server record opens to 15 bytes");
assert_eq(sdct, TLS_CT_HANDSHAKE, "server record inner type = handshake");
assert_eq(_tn_ct_eq(&sdec, msg21, 15), 1, "server-sealed content round-trips");

# ================================================================
# v6.0.22 — server accept() + cyrius-native loopback e2e
# ================================================================
test_group("v6.0.22 accept() loopback e2e");

# socketpair(AF_UNIX, SOCK_STREAM) → two connected fds. fork: parent
# runs the server accept(), child plays a minimal TLS 1.3 client built
# from the existing primitives.
var fds[8];
var spr = sys_socketpair(1, 1, 0, &fds);
assert_eq(spr, 0, "socketpair created");
var fdpair = load64(&fds);
var fd0 = fdpair & 0xFFFFFFFF;            # server end
var fd1 = (fdpair >> 32) & 0xFFFFFFFF;    # client end

var pid = sys_fork();
if (pid == 0) {
    # ---- CHILD: minimal TLS 1.3 client ----
    sys_close(fd0);
    var cpriv[32];
    sys_getrandom(&cpriv, 32, 0);
    var cpub[32];
    x25519_base(&cpriv, &cpub);
    # Build ClientHello (offers AES-256-GCM + ChaCha20, x25519 key_share).
    var cch[256];
    var cbp = &cch + 4;
    _tn_be16_w(cbp, 0x0303);
    var cq = cbp + 2;
    var ci2 = 0;
    while (ci2 < 32) { store8(cq + ci2, 0x33); ci2 = ci2 + 1; }
    cq = cq + 32;
    store8(cq, 0); cq = cq + 1;
    _tn_be16_w(cq, 4); cq = cq + 2;
    _tn_be16_w(cq, TLS_AES_256_GCM_SHA384); cq = cq + 2;
    _tn_be16_w(cq, TLS_CHACHA20_POLY1305_SHA256); cq = cq + 2;
    store8(cq, 1); cq = cq + 1; store8(cq, 0); cq = cq + 1;
    _tn_be16_w(cq, 42); cq = cq + 2;
    _tn_be16_w(cq, TLS_EXT_KEY_SHARE); cq = cq + 2;
    _tn_be16_w(cq, 38); cq = cq + 2;
    _tn_be16_w(cq, 36); cq = cq + 2;
    _tn_be16_w(cq, TLS_GROUP_X25519); cq = cq + 2;
    _tn_be16_w(cq, 32); cq = cq + 2;
    memcpy(cq, &cpub, 32); cq = cq + 32;
    var cbody = cq - cbp;
    tls_native_handshake_write_header(&cch, TLS_HS_CLIENT_HELLO, cbody);
    var cch_total = 4 + cbody;
    var ctr = tls_native_transcript_init(TLS_HASH_SHA384);
    var chrec[300];
    tls_native_record_write_header(&chrec, TLS_CT_HANDSHAKE, 0x0303, cch_total);
    memcpy(&chrec + 5, &cch, cch_total);
    _tn_sock_write_all(fd1, &chrec, 5 + cch_total);
    tls_native_transcript_update(ctr, &cch, cch_total);
    # Read ServerHello (plaintext record).
    var shbuf[1024];
    var shrl = _tn_sock_read_record(fd1, &shbuf, 1024);
    var sh_msg = &shbuf + 5;
    var sh_mlen = shrl - 5;
    tls_native_transcript_update(ctr, sh_msg, sh_mlen);
    var server_pub = sh_msg + sh_mlen - 32;
    var cdhe[32];
    x25519(&cpriv, server_pub, &cdhe);
    var cks = tls_native_keysched_new(TLS_HASH_SHA384);
    tls_native_keysched_derive_handshake(cks, &cdhe, 32, ctr);
    var c_shs[48];
    tls_native_keysched_get_secret(cks, TLS_KS_SERVER_HANDSHAKE, &c_shs);
    var c_chs[48];
    tls_native_keysched_get_secret(cks, TLS_KS_CLIENT_HANDSHAKE, &c_chs);
    var srvk[32];
    var srviv[12];
    tls_native_derive_key(&c_shs, 48, TLS_HASH_SHA384, &srvk, 32);
    tls_native_derive_iv(&c_shs, 48, TLS_HASH_SHA384, &srviv, 12);
    # Open the server's encrypted flight; transcript the decrypted bytes.
    var flbuf[4096];
    var flrl = _tn_sock_read_record(fd1, &flbuf, 4096);
    var flseq[8];
    tls_native_seq_init(&flseq);
    var flpl[4096];
    var flct2 = 0;
    var flinner = tls_native_record_open(TLS_AES_256_GCM_SHA384, &srvk, &srviv, &flseq, &flbuf, flrl, &flpl, 4096, &flct2);
    tls_native_transcript_update(ctr, &flpl, flinner);
    # Compute + send the client Finished (sealed under client_hs key).
    var cfk[48];
    tls_native_hkdf_expand_label(&c_chs, 48, "finished", 8, 0, 0, TLS_HASH_SHA384, &cfk, 48);
    var cth[48];
    tls_native_transcript_digest(ctr, &cth);
    var cvd[48];
    hmac_sha384(&cfk, 48, &cth, 48, &cvd);
    var cfin[64];
    tls_native_handshake_write_header(&cfin, TLS_HS_FINISHED, 48);
    memcpy(&cfin + 4, &cvd, 48);
    var clik[32];
    var cliiv[12];
    tls_native_derive_key(&c_chs, 48, TLS_HASH_SHA384, &clik, 32);
    tls_native_derive_iv(&c_chs, 48, TLS_HASH_SHA384, &cliiv, 12);
    var cliseq[8];
    tls_native_seq_init(&cliseq);
    var finrec[128];
    var finrl = tls_native_record_seal(TLS_AES_256_GCM_SHA384, &clik, &cliiv, &cliseq, TLS_CT_HANDSHAKE, &cfin, 52, &finrec, 128);
    _tn_sock_write_all(fd1, &finrec, finrl);
    sys_close(fd1);
    sys_exit(0);
}

# ---- PARENT: server ----
sys_close(fd1);
var s22 = tls_native_new_server(leaf_cert, 413, ed_key, 48);
tls_native_server_load_creds(s22);
var ar = tls_native_accept(s22, fd0);
assert_eq(ar, TLS_OK, "server accept() handshake completed over socket");
assert_eq(tls_native_get_state(s22), TLS_STATE_CONNECTED, "server reached CONNECTED via loopback");
sys_close(fd0);
var wstatus[4];
sys_waitpid(pid, &wstatus, 0);

# ================================================================
# v6.0.23 — OpenSSL s_client real-peer interop
# ================================================================
test_group("v6.0.23 OpenSSL s_client interop");

# Matching ECDSA-P256 cert + key (openssl-generated, DER). The key's
# public point appears in the cert SPKI — a genuine pair, so OpenSSL's
# CertificateVerify check passes.
var cert23 = hex_decode("", 770);
var key23 = hex_decode("308187020100301306072a8648ce3d020106082a8648ce3d030107046d306b0201010420b19108bb3950b49995a9c770e12613b12d96dc2409a464fdc43c63a41b1d4668a144034200049167a2981f570fdbd8d94bf20fb4f5c89d77aa5b58cf4ed416bafa0256a2561a04f1e71d57537fc532fc87ca980eb8ba1f8f8704fc7f6a793ba6598b97bb3275", 276);
var s23 = tls_native_new_server(cert23, 385, key23, 138);
assert_eq(tls_native_server_load_creds(s23), TLS_OK, "load openssl-generated cert+key");
assert_eq(tls_native_get_key_algo(s23), SIG_PRIVKEY_ECDSA_P256, "openssl key algo = ECDSA P-256");

# Real interop only when openssl is present (skip cleanly otherwise).
if (sys_access("/usr/bin/openssl", 0) == 0) {
    var lfd = sys_socket(2, 1, 0);                  # AF_INET, SOCK_STREAM
    var one23[4];
    store32(&one23, 1);
    sys_setsockopt(lfd, 1, 2, &one23, 4);           # SOL_SOCKET, SO_REUSEADDR
    var sa23[16];
    var z23 = 0;
    while (z23 < 16) { store8(&sa23 + z23, 0); z23 = z23 + 1; }
    store8(&sa23, 2);                               # AF_INET (host order)
    store8(&sa23 + 2, 0xAD); store8(&sa23 + 3, 0x23);   # port 44323 (BE)
    store8(&sa23 + 4, 127); store8(&sa23 + 7, 1);   # 127.0.0.1 (BE)
    assert_eq(sys_bind(lfd, &sa23, 16), 0, "bind 127.0.0.1:44323");
    sys_listen(lfd, 1);
    var pid23 = sys_fork();
    if (pid23 == 0) {
        # Child: exec `openssl s_client` (quiet, stdin = /dev/null).
        sys_close(lfd);
        var nf = sys_open("/dev/null", 2, 0);
        sys_dup2(nf, 0); sys_dup2(nf, 1); sys_dup2(nf, 2);
        var av[48];
        store64(&av + 0, "openssl");
        store64(&av + 8, "s_client");
        store64(&av + 16, "-connect");
        store64(&av + 24, "127.0.0.1:44323");
        store64(&av + 32, "-tls1_3");
        store64(&av + 40, 0);
        var ev[8];
        store64(&ev, 0);
        sys_execve("/usr/bin/openssl", &av, &ev);
        sys_exit(127);
    }
    var cfd23 = sys_accept4(lfd, 0, 0, 0);
    assert_gt(cfd23, 0, "accepted OpenSSL connection");
    var ar23 = tls_native_accept(s23, cfd23);
    assert_eq(ar23, TLS_OK, "TLS 1.3 handshake vs OpenSSL s_client → TLS_OK");
    assert_eq(tls_native_get_state(s23), TLS_STATE_CONNECTED, "server CONNECTED against OpenSSL");
    sys_close(cfd23);
    sys_close(lfd);
    var st23[4];
    sys_waitpid(pid23, &st23, 0);
} else {
    assert_eq(1, 1, "openssl absent — real-peer interop skipped");
}

# ================================================================
# v6.0.24 — TLS 1.3 client: ClientHello construction
# ================================================================
test_group("v6.0.24 ClientHello construction");

var c24 = tls_native_new_client("localhost", 9);
assert_nonnull(c24, "new_client returns a ctx");
assert_eq(tls_native_get_state(c24), TLS_STATE_INIT, "client ctx in INIT");

var chbuf24[512];
var chn24 = tls_native_client_build_hello(c24, &chbuf24, 512);
assert_gt(chn24, 0, "ClientHello built");
var cht24 = 0;
var chl24 = 0;
tls_native_handshake_read_header(&chbuf24, chn24, &cht24, &chl24);
assert_eq(cht24, TLS_HS_CLIENT_HELLO, "message type = ClientHello");
assert_eq(load64(c24 + TLS_CTX_OFF_CH_LEN), chn24, "ClientHello buffered for transcript");

# Interop cross-check: our own server parses our ClientHello + responds.
var srv24 = tls_native_new_server(leaf_cert, 413, ed_key, 48);
tls_native_server_load_creds(srv24);
var sh24[256];
var sh24n = tls_native_server_respond_hello(srv24, &chbuf24, chn24, &sh24, 256);
assert_gt(sh24n, 0, "server parsed our ClientHello + produced ServerHello");
assert_eq(tls_native_get_cipher(srv24), TLS_AES_256_GCM_SHA384, "server negotiated AES-256-GCM from our CH");
assert_eq(tls_native_get_group(srv24), TLS_GROUP_X25519, "server picked x25519 from our key_share");
assert_eq(tls_native_server_sent_hrr(srv24), 0, "no HRR (x25519 offered)");

# Null guard.
assert_eq(tls_native_client_build_hello(0, &chbuf24, 512), TLS_ERR_INVALID_PARAM, "build_hello(null) → INVALID_PARAM");

# ================================================================
# v6.0.25 — ServerHello parsing + client key derivation
# ================================================================
test_group("v6.0.25 ServerHello parse + client keys");

var cl25 = tls_native_new_client("localhost", 9);
var ch25[512];
var chn25 = tls_native_client_build_hello(cl25, &ch25, 512);
var srv25 = tls_native_new_server(leaf_cert, 413, ed_key, 48);
tls_native_server_load_creds(srv25);
var sh25[256];
var sh25n = tls_native_server_respond_hello(srv25, &ch25, chn25, &sh25, 256);
assert_gt(sh25n, 0, "server produced ServerHello");

# Client parses the ServerHello + derives its handshake keys.
assert_eq(tls_native_client_parse_server_hello(cl25, &sh25, sh25n), TLS_OK, "client parsed ServerHello");
assert_eq(tls_native_get_cipher(cl25), TLS_AES_256_GCM_SHA384, "client cipher matches server");
assert_eq(tls_native_get_group(cl25), TLS_GROUP_X25519, "client group x25519");
assert_eq(tls_native_get_version(cl25), TLS_VERSION_1_3, "client negotiated TLS 1.3");

# ECDHE agreement: client + server derive the same shared secret.
assert_streq(hex_encode(load64(cl25 + TLS_CTX_OFF_SHARED), 32),
             hex_encode(load64(srv25 + TLS_CTX_OFF_SHARED), 32),
             "client/server ECDHE shared secret agree");

# Handshake-secret agreement: derive the server side + compare the
# server_handshake_traffic secret on both peers.
tls_native_server_derive_handshake(srv25);
var c_shs25[48];
tls_native_keysched_get_secret(load64(cl25 + TLS_CTX_OFF_KEYSCHED), TLS_KS_SERVER_HANDSHAKE, &c_shs25);
var s_shs25[48];
tls_native_keysched_get_secret(load64(srv25 + TLS_CTX_OFF_KEYSCHED), TLS_KS_SERVER_HANDSHAKE, &s_shs25);
assert_streq(hex_encode(&c_shs25, 48), hex_encode(&s_shs25, 48), "client/server server_hs_traffic secret agree");

# Negatives.
var cl25b = tls_native_new_client("localhost", 9);
tls_native_client_build_hello(cl25b, &ch25, 512);
var notsh[8];
tls_native_handshake_write_header(&notsh, TLS_HS_CLIENT_HELLO, 100);
assert_eq(tls_native_client_parse_server_hello(cl25b, &notsh, 8), TLS_ERR_BAD_HANDSHAKE, "non-ServerHello → BAD_HANDSHAKE");
assert_eq(tls_native_client_parse_server_hello(0, &sh25, sh25n), TLS_ERR_INVALID_PARAM, "parse(null) → INVALID_PARAM");

var r = assert_summary();
