# e2e: file_write_atomic / file_rename / file_create_exclusive (v6.4.57). Cross-OS: the core
# crash-safe write + rename runs on x86/aarch64/macOS/Windows (Windows rename via MoveFileExW).
# Uses CWD-RELATIVE paths (not /tmp) and xunlink (not sys_unlink) so it is portable to Windows,
# whose CWD in the gate is C:\cyrius-tests. Two genuine Windows residuals are gated off under
# CYRIUS_TARGET_WIN (documented in issue 2026-07-12-windows-atomic-write-residuals): the on-failure
# temp unlink is a no-op (xunlink unwired on Win) and file_create_exclusive isn't yet atomic there.
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/io.cyr"
include "lib/assert.cyr"

alloc_init();

test_group("file_write_atomic: create + content round-trip");
var path = "cyrius_atomic_test.txt";
xunlink(path);
var rc = file_write_atomic(path, "hello atomic world", 18);
assert_eq(rc, 0, "atomic write returns 0");
var buf = alloc(64);
var nr = file_read_all(path, buf, 63);
assert_eq(nr, 18, "read back 18 bytes");
store8(buf + nr, 0);
assert_eq(streq(buf, "hello atomic world"), 1, "content matches");

test_group("file_write_atomic: overwrite existing (atomic replace)");
var rc2 = file_write_atomic(path, "second", 6);
assert_eq(rc2, 0, "second atomic write returns 0 (MoveFileEx REPLACE_EXISTING on Win)");
var buf2 = alloc(64);
var nr2 = file_read_all(path, buf2, 63);
assert_eq(nr2, 6, "read back 6 bytes after replace");
store8(buf2 + nr2, 0);
assert_eq(streq(buf2, "second"), 1, "replaced content matches");

test_group("file_write_atomic: repeated (unique temp each time)");
var i = 0;
while (i < 5) {
    var rr = file_write_atomic(path, "loopdata", 8);
    assert_eq(rr, 0, "repeated atomic write succeeds (unique temp each time)");
    i = i + 1;
}
var buf3 = alloc(64);
var nr3 = file_read_all(path, buf3, 63);
assert_eq(nr3, 8, "final content is 8 bytes");

test_group("file_rename: direct move");
var src = "cyrius_rename_src.txt";
var dst = "cyrius_rename_dst.txt";
xunlink(src);
xunlink(dst);
file_write_all(src, "movable", 7);
var mv = file_rename(src, dst);
assert_eq(mv, 0, "rename returns 0");
var bufd = alloc(32);
var nrd = file_read_all(dst, bufd, 31);
store8(bufd + nrd, 0);
assert_eq(streq(bufd, "movable"), 1, "renamed content intact at dest");

test_group("failed write leaves original intact");
var tgt = "cyrius_intact_test.txt";
xunlink(tgt);
file_write_all(tgt, "ORIGINAL-GOOD-DATA", 18);
var tmp = "cyrius_intact_test.txt.cyrtmp.sim";
var tfd = file_open(tmp, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4);
assert_eq(tfd >= 0, 1, "temp open ok");
file_write(tfd, "HALF", 4);     # a short/partial write, then simulated failure (no rename)
file_close(tfd);
xunlink(tmp);                    # failure path: drop temp, never rename over tgt
var bufo = alloc(64);
var nro = file_read_all(tgt, bufo, 63);
assert_eq(nro, 18, "original still 18 bytes (untouched by failed write)");
store8(bufo + nro, 0);
assert_eq(streq(bufo, "ORIGINAL-GOOD-DATA"), 1, "original content preserved");
#ifndef CYRIUS_TARGET_WIN
# xunlink is unwired on Windows (returns -1), so the sim temp lingers there — a documented
# residual, not a corruption. Only assert cleanup where xunlink is real.
assert_eq(file_exists(tmp), 0, "temp cleaned up (POSIX)");
#endif

#ifndef CYRIUS_TARGET_WIN
# file_create_exclusive is atomic (O_CREAT|O_EXCL) on POSIX; on Windows EOPEN_PE doesn't yet
# map O_EXCL→CREATE_NEW (filed residual), so the no-clobber guard is exercised off-Windows.
test_group("file_create_exclusive: no-clobber (POSIX/atomic)");
var ex = "cyrius_excl_test.txt";
xunlink(ex);
var efd = file_create_exclusive(ex, 0x1A4);
assert_eq(efd >= 0, 1, "exclusive create of absent path succeeds");
file_write(efd, "excl", 4);
file_close(efd);
var efd2 = file_create_exclusive(ex, 0x1A4);
assert_eq(efd2 < 0, 1, "exclusive create of existing path fails (negative)");
xunlink(ex);
#endif

xunlink(path);
xunlink(dst);
xunlink(tgt);
var r = assert_summary();
