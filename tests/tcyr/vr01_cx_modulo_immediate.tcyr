# vr01_cx_modulo_immediate.tcyr — v6.4.58 cx correctness: full 64-bit constant loads
# (CX_MOVI now emits the bits-48-63 chunk via cxvm opcode 253/movhk) + correct modulo
# (cx has no dual-output divide, so EIDIV stashes the dividend for EMOVDR — previously
# every cx `%` computed (n/d)%d). Exit-code-gated (cx main-return doesn't propagate to
# process exit) — returns 42 on success. Runs on all backends; exercises the cx fix.
include "lib/syscalls.cyr"
fn main(): i64 {
    var big = 0x4018000000000000;             # bits 48-63 set (f64 6.0) — loaded 0 on old cx
    if (big == 0) { return 1; }
    if (((big >> 56) & 0xFF) != 0x40) { return 2; }
    var neg = 0xC018000000000000;             # bit 63 set
    if (((neg >> 56) & 0xFF) != 0xC0) { return 3; }
    var full = 0xDEADBEEFCAFE1234;            # every 16-bit word populated
    if (((full >> 56) & 0xFF) != 0xDE) { return 4; }
    if ((full & 0xFF) != 0x34) { return 5; }
    if (12345 % 10 != 5) { return 6; }        # was 4 on old cx ((1234)%10)
    if (100 % 7 != 2) { return 7; }
    if (255 % 16 != 15) { return 8; }
    if (1000000 % 1000 != 0) { return 9; }
    return 42;
}
var e = main();
syscall(60, e);
