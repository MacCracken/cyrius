# f64 JSON round-trip (v6.4.69). Guards the bayan 1.2.1 fold: the Grisu2
# round-trip-correct formatter (bayan_f64_to_json) + the correctly-rounded,
# DoS-safe parser (bayan_f64_from_json) that #derive(Serialize) and bayan's
# JSON emit/parse now route through — replacing the 6-decimal fmt_float_buf(,6)
# (lossy on 1/3, flushed |x|<5e-7 to 0, emitted the non-JSON "-.00000-" for
# Inf/NaN/>=2^63) and the two divergent-by-1-ULP atofs. Runs on real hardware
# via the vr01_ glob. See issues 2026-07-19-f64-json-roundtrip-6-decimal-cap.md
# + -derive-serialize-f64-second-implementation.md.
include "lib/syscalls.cyr"
include "lib/string.cyr"
include "lib/alloc.cyr"
include "lib/str.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/io.cyr"
include "lib/result.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/fnptr.cyr"
include "lib/bayan.cyr"
include "lib/assert.cyr"

# format then parse == the original bits
fn _rt(bitv): i64 {
    var b[64];
    var n = bayan_f64_to_json(bitv, &b);
    store8(&b + n, 0);
    if (bayan_f64_from_json(&b) == bitv) { return 1; }
    return 0;
}
# non-finite -> the 4-byte token "null"
fn _isnull(bitv): i64 {
    var b[64];
    var n = bayan_f64_to_json(bitv, &b);
    if (n != 4) { return 0; }
    if (load8(&b) == 110 && load8(&b + 1) == 117) {
        if (load8(&b + 2) == 108 && load8(&b + 3) == 108) { return 1; }
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    # round-trip: the exact-value blocker (samay's utilization ratios) + the
    # flush-to-zero + the >=2^63 invalid-JSON cases + full-range extremes.
    assert_eq(_rt(0x3FD5555555555555), 1, "rt 1/3 exact (was 0.333333)");
    assert_eq(_rt(0x3FE5555555555555), 1, "rt 2/3 exact");
    assert_eq(_rt(0x3FB999999999999A), 1, "rt 0.1 exact");
    assert_eq(_rt(0x3E112E0BE826D695), 1, "rt 1e-9 exact (was flushed to 0)");
    assert_eq(_rt(0x43E0000000000000), 1, "rt 2^63 exact (was invalid -.00000-)");
    assert_eq(_rt(0x0000000000000001), 1, "rt min subnormal exact");
    assert_eq(_rt(0x7FEFFFFFFFFFFFFF), 1, "rt max double exact");
    assert_eq(_rt(0x8000000000000000), 1, "rt -0.0 exact");
    # correctly-rounded parse (0.333333 -> ...46; old math f64_parse gave ...47)
    assert_eq(bayan_f64_from_json("0.333333"), 0x3FD55553EF6B5D46, "parse 0.333333 correctly-rounded");
    assert_eq(bayan_f64_from_json("0.5"), 0x3FE0000000000000, "parse 0.5");
    # DoS clamp: a huge exponent returns instantly, saturating to +/-Inf / 0
    assert_eq(bayan_f64_from_json("1e100000000"), 0x7FF0000000000000, "1e100000000 -> +Inf, no DoS");
    assert_eq(bayan_f64_from_json("1e-100000000"), 0, "1e-100000000 -> 0, no DoS");
    # non-finite -> valid JSON null (was the non-JSON token -.00000-)
    assert_eq(_isnull(0x7FF0000000000000), 1, "+Inf emits null");
    assert_eq(_isnull(0x7FF8000000000000), 1, "NaN emits null");

    var r = assert_summary();
    return 0;
}

var ec = main();
syscall(60, ec);
