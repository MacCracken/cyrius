# vr01_f64v2_ctor.tcyr — VR-01: f64v2/f64v4 intrinsic constructor syntax + splat
# (v6.4.3, agnos FP issue §2). `f64v2(a,b)` / `f64v4(a,b,c,d)` resolve via the FINDFN
# sugar to the lib f64v2_make/f64v4_make constructors; f64v2_splat/f64v4_splat
# broadcast; value/pointer lane-extract round-trips.
#
# Runs on Linux + ecb (macOS) + pi (aarch64) — all define CYRIUS_HAS_VAL_SIMD_PARAMS.
# SKIPPED on cass (Win64 PE): value-form f64v2/f64v4 SIMD is non-PE by design (Win64's
# vector-return ABI differs — lib/simd.cyr gates the value-form fns on
# CYRIUS_HAS_VAL_SIMD_PARAMS, undefined on main_win.cyr). PE value-form SIMD is a
# pre-existing, separately-tracked limitation, out of scope for this constructor slot.
include "lib/assert.cyr"
include "lib/simd.cyr"
include "lib/syscalls.cyr"

fn main(): i64 {
#ifdef CYRIUS_HAS_VAL_SIMD_PARAMS
    test_group("f64v2/f64v4 intrinsic constructor syntax + splat (v6.4.3)");
    var v: f64v2 = f64v2(f64_from(3), f64_from(4));
    assert_eq(f64_to(f64v2_lo(&v)), 3, "f64v2(a,b) constructs lane 0");
    assert_eq(f64_to(f64v2_hi(&v)), 4, "f64v2(a,b) constructs lane 1");

    var w: f64v4 = f64v4(f64_from(10), f64_from(20), f64_from(30), f64_from(40));
    assert_eq(f64_to(f64v4_lane0(&w)), 10, "f64v4(...) constructs lane 0");
    assert_eq(f64_to(f64v4_lane3(&w)), 40, "f64v4(...) constructs lane 3");

    var s: f64v2 = f64v2_splat(f64_from(7));
    assert_eq(f64_to(f64v2_lo(&s)), 7, "f64v2_splat broadcasts lane 0");
    assert_eq(f64_to(f64v2_hi(&s)), 7, "f64v2_splat broadcasts lane 1");

    var s4: f64v4 = f64v4_splat(f64_from(9));
    assert_eq(f64_to(f64v4_lane2(&s4)), 9, "f64v4_splat broadcasts lane 2");

    return assert_summary();
#endif
    # PE (no value-form SIMD): skip cleanly — tracked separately.
    return 0;
}
var ec = main();
syscall(60, ec);
