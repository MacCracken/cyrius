# vr01_getpeername_xlat.tcyr — v6.4.64: getpeername/getsockname must reach the REAL syscall on
# every target. Runs on real hardware via the release gate's `vr01_` glob (cass/ecb/ach/pi) —
# the only place the per-target syscall translation is actually exercised.
#
# THE BUG THIS GUARDS (silent, and it fabricates data rather than failing):
# cyrius's stdlib uses x86_64-Linux syscall numbers everywhere; the backends translate them
# per target (ESYSXLAT on aarch64/Darwin, EMACHO_SYSXLAT on x86-macho). The socket band was
# translated — socket 41, connect 42, accept 43, bind 49, listen 50, setsockopt 54,
# getsockopt 55, socketpair 53 — but **getpeername (52) was missing from every table**, and
# **getsockname (51) from all but the aarch64-Linux one**. An untranslated number does not
# error: it passes through and invokes a DIFFERENT syscall on that target.
#   * aarch64-Linux: 52 -> #52 = fchmod(fd, mode), mode = low bits of the sockaddr POINTER.
#     VERIFIED on real pi pre-fix: it returned SUCCESS (0). So a caller believes it got the
#     peer address while its buffer is untouched garbage — worse than an error.
#   * Darwin (arm64 + Intel): 51/52 -> setpriority/sigpending. Same class.
# cyrius's own lib/net.cyr calls neither, which is exactly why this survived: no consumer.
# sandhi 1.9.0's peer-address API (sandhi_server_peer_ip, for per-IP rate limiting) is the
# first — and a rate limiter keyed on uninitialized stack is silently no rate limiter.
#
# HOW IT TESTS: getpeername on a fresh, UNCONNECTED socket has one correct answer —
# ENOTCONN. Any other result means the number reached something that is not getpeername.
# The errno differs per OS (Linux 107, Darwin 57), and Windows has no routable getpeername
# at all (documented degradation: the reroute is future work), so those are gated.
include "lib/assert.cyr"
include "lib/syscalls.cyr"

# x86-Linux numbers — the backends translate. AF_INET=2, SOCK_STREAM=1.
fn mk_sock(): i64 { return syscall(41, 2, 1, 0); }

# getpeername(fd, sockaddr, addrlen) on an unconnected socket -> -ENOTCONN.
fn peer_errno(fd): i64 {
    var out[16];
    var alen[8];
    store32(&alen, 16);
    var r = syscall(52, fd, &out, &alen);
    if (r >= 0) { return 0 - 1; }     # -1 => it SUCCEEDED: NOT getpeername (the pi failure)
    return 0 - r;
}

# getsockname on an unconnected socket SUCCEEDS (returns the unbound local addr) — a
# different oracle from getpeername, which pins that 51 and 52 are not swapped.
fn name_ok(fd): i64 {
    var out[16];
    var alen[8];
    store32(&alen, 16);
    var r = syscall(51, fd, &out, &alen);
    if (r == 0) { return 1; }
    return 0;
}

fn main(): i64 {
    test_group("getpeername/getsockname reach the real syscall on this target");
    var fd = mk_sock();
    assert_gte(fd, 0, "socket(41) — the translated socket band still works");

    # Windows: no ws2_32 getpeername reroute yet — the raw syscall is not routable and
    # returns -ENOSYS(-38). Documented gap, not this test's subject.
    #ifndef CYRIUS_TARGET_WIN
    var e = peer_errno(fd);
    assert_neq(e, 0 - 1, "getpeername did NOT silently SUCCEED (-1 = it hit fchmod/sigpending, not getpeername — the real pi pre-fix failure)");
    #ifdef CYRIUS_TARGET_MACOS
    assert_eq(e, 57, "getpeername on an unconnected socket = ENOTCONN (Darwin 57)");
    #endif
    #ifndef CYRIUS_TARGET_MACOS
    assert_eq(e, 107, "getpeername on an unconnected socket = ENOTCONN (Linux 107)");
    #endif
    assert_eq(name_ok(fd), 1, "getsockname on an unconnected socket succeeds (51 and 52 are not swapped)");
    #endif

    syscall(3, fd);
    return assert_summary();
}
var rc = main();
syscall(60, rc);
