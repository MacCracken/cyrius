# vr01_simd_f32v4_neon.tcyr — cross-OS gate for f32v4 packed ops via the RAW flat-array
# intrinsics (f32v_add/sub/mul/fmadd/dot over pointers + a lane count). This exercises the
# packed-op emitters directly — x86 SSE (addps/subps/mulps + haddps reduce) and aarch64 NEON
# (.4s fadd/fsub/fmul + faddp reduce, SIMD Phase 5 v6.4.28) — with NO f32v4 value-form params
# or returns, so it also runs on Win64 PE (which does not yet support value-form SIMD params).
# The value-form / dual-form surface is covered by simd_f32v4.tcyr (x86-Linux + aarch64 corpus).
# f32 bit patterns: 1.0f=0x3F800000, 2.0f=0x40000000, 3.0f=0x40400000, 8.0f=0x41000000.
include "lib/assert.cyr"
include "lib/simd.cyr"
include "lib/syscalls.cyr"

fn main(): i64 {
    test_group("f32v4 packed ops — raw flat-array intrinsics (x86 SSE / aarch64 NEON)");
    var a[16]; var b[16]; var r[16];   # 4 f32 lanes each (16 bytes)
    store32(&a + 0, 0x40000000); store32(&a + 4, 0x40000000);   # a = 2.0f x4
    store32(&a + 8, 0x40000000); store32(&a + 12, 0x40000000);
    store32(&b + 0, 0x3F800000); store32(&b + 4, 0x3F800000);   # b = 1.0f x4
    store32(&b + 8, 0x3F800000); store32(&b + 12, 0x3F800000);

    f32v_add(&r, &a, &b, 4);                                     # 2+1 = 3.0f
    assert_eq(load32(&r + 0),  0x40400000, "f32v_add lane0 = 3.0f");
    assert_eq(load32(&r + 12), 0x40400000, "f32v_add lane3 = 3.0f (all 4 lanes)");

    f32v_sub(&r, &a, &b, 4);                                     # 2-1 = 1.0f
    assert_eq(load32(&r + 4),  0x3F800000, "f32v_sub lane1 = 1.0f");

    f32v_mul(&r, &a, &b, 4);                                     # 2*1 = 2.0f
    assert_eq(load32(&r + 8),  0x40000000, "f32v_mul lane2 = 2.0f");

    f32v_fmadd(&r, &a, &b, &b, 4);                               # 2*1+1 = 3.0f
    assert_eq(load32(&r + 0),  0x40400000, "f32v_fmadd lane0 = 2*1+1 = 3.0f");
    assert_eq(load32(&r + 12), 0x40400000, "f32v_fmadd lane3 = 3.0f");

    var dt = f32v_dot(&a, &b, 4);                                # sum(2*1)x4 = 8.0f
    assert_eq(dt, 0x41000000, "f32v_dot(2.0x4 · 1.0x4) = 8.0f");

    # 8-lane dot exercises 2 loop iterations of the packed op.
    var a8[32]; var b8[32];
    var i = 0;
    while (i < 8) { store32(&a8 + i * 4, 0x40000000); store32(&b8 + i * 4, 0x3F800000); i = i + 1; }
    var dt8 = f32v_dot(&a8, &b8, 8);                             # sum(2*1)x8 = 16.0f
    assert_eq(dt8, 0x41800000, "f32v_dot over 8 lanes (2 iters) = 16.0f");

    var ec = assert_summary();
    return ec;
}
var rc = main();
syscall(60, rc);
